    if len(str_to_bytes(text))>MAX_BYTES { throw "editor byte limit exceeded"; }
    return text;
}
fn _index(value,maximum) {
    if type(value)!="number" or not (value>=0 and value<=maximum)
        or value!=num_floor(value) { throw "invalid editor position"; }
    return value;
}
fn selection(text,start=0,end=0) {
    _text(text); _index(start,len(text)); _index(end,len(text));
    if end<start { throw "editor selection must be ordered"; }
    return map{text:text,start:start,end:end};
}
fn _state(state) { return selection(state.text,state.start,state.end); }
fn replace(state,insert) {
    let s=_state(state); _text(insert);
    let text=_text(str_slice(s.text,0,s.start)+insert+str_slice(s.text,s.end,len(s.text)));
