        if units==offset { return scalar; }
        let width=1; if byte>=240 { width=2; }
        units=units+width;
        if units>offset { throw "position splits a UTF-16 surrogate pair"; }
        scalar=scalar+1;
        if byte>=240 { i=i+4; } elif byte>=224 { i=i+3; }
        elif byte>=192 { i=i+2; } else { i=i+1; }
    }
    if units==offset { return scalar; }
    throw "UTF-16 position exceeds text";
