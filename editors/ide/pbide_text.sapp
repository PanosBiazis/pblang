fn utf16_from_scalar(text,offset) {
    _text(text); _index(offset,len(text)); let units=0;
    let bytes=str_to_bytes(text); let i=0; let scalar=0;
    while i<len(bytes) and scalar<offset {
        let byte=bytes[i];
        units=units+1; if byte>=240 { units=units+1; }
