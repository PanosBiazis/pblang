// Bounded lexical preview. Original source is escaped; token values are never rendered.
let Tokens=import("stdlib:compiler/tokenizer.sapp");
let HTML=import("stdlib:html.sapp");
let MAX_BYTES=4096;
let MAX_TOKENS=512;
let MAX_RENDER_BYTES=32768;
let OPEN="<pre aria-label=\"Source preview\"><code>";
let CLOSE="</code></pre>";
fn _position(token,starts,size) {
    let line=token.line; let col=token.col;
    if type(line)!="number" or not (line>=1 and line<=len(starts))
        or line!=num_floor(line) or type(col)!="number"
        or not (col>=1 and col<=size+1) or col!=num_floor(col) {
        throw "invalid token position";
    }
    let offset=starts[line-1]+col-1;
    let end=size;
    if line<len(starts) { end=starts[line]-1; }
    if offset>end { throw "invalid token position"; }
    return offset;
}
fn _colored(source) {
    let lexed=Tokens.tokenize_bounded(source,MAX_TOKENS,false);
    if not lexed.ok { throw "preview token limit"; }
    let chars=str_split(source,""); let size=len(chars); let starts=[0];
    for i size { if chars[i]=="\n" { array_push(starts,i+1); } }
    let tokens=lexed.tokens;
    if len(tokens)<1 or tokens[len(tokens)-1].kind!="eof" {
        throw "missing token end";
    }
    let offsets=[]; let previous=0;
    for i len(tokens) {
        let token=tokens[i]; let offset=_position(token,starts,size);
        if offset<previous or (i<len(tokens)-1 and token.kind=="eof") {
            throw "invalid token order";
        }
        array_push(offsets,offset); previous=offset;
    }
    if previous!=size { throw "invalid token end"; }
    let classes=map{keyword:"kw",string:"str",number:"num",comment:"comment"};
    let parts=[OPEN,HTML.escape(str_join(slice(chars,0,offsets[0]),""))];
    let used=len(str_to_bytes(str_join(parts,"")))+len(CLOSE);
    for i len(tokens)-1 {
        if offsets[i]>=offsets[i+1] { throw "invalid token span"; }
        let original=str_join(slice(chars,offsets[i],offsets[i+1]),"");
        let piece=HTML.escape(original);
        let kind=tokens[i].kind;
        if map_has(classes,kind) {
            piece="<span class=\"syntax-"+classes[kind]+"\">"+piece+"</span>";
        } elif kind!="ident" and kind!="operator" and kind!="punct" {
            throw "invalid token kind";
        }
        used=used+len(str_to_bytes(piece));
        if used>MAX_RENDER_BYTES { throw "preview output limit"; }
        array_push(parts,piece);
    }
    array_push(parts,CLOSE);
    return str_join(parts,"");
}
fn render(source) {
    if type(source)!="string" or len(source)>MAX_BYTES
        or len(str_to_bytes(source))>MAX_BYTES
        or str_contains(source,"\r") or str_contains(source,strfromcharcode(0)) {
        throw "invalid preview source";
    }
    let colored=try _colored(source) catch nil;
    if colored!=nil { return map{html:colored,highlighted:true}; }
    return map{html:OPEN+HTML.escape(source)+CLOSE,highlighted:false};
}
export render,MAX_BYTES,MAX_TOKENS,MAX_RENDER_BYTES;
