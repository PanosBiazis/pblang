// Input-bounded analysis only. This module never evaluates submitted source.
let Tokens=import("stdlib:compiler/tokenizer.sapp");
let Frontend=import("stdlib:compiler/selfhost_frontend.sapp");
let HTML=import("stdlib:html.sapp");
let MAX_BYTES=4096;
let MAX_TOKENS=2048;
let MAX_DEPTH=64;
let MAX_DIAGNOSTICS=32;
let MAX_RENDER_BYTES=8192;
fn failure(message) {
    return map{ok:false,diagnostics:[map{kind:"error",message:message}],count:1};
}
fn check(source) {
    if type(source)!="string" or len(source)>MAX_BYTES
        or len(str_to_bytes(source))>MAX_BYTES {
        return failure("Source check limit exceeded.");
    }
    let lexed=Tokens.tokenize_bounded(source,MAX_TOKENS,false);
    if not lexed.ok { return failure("Source token limit exceeded."); }
    let depth=0;
    for token in lexed.tokens {
        if token.kind=="punct" {
            if token.text=="(" or token.text=="[" or token.text=="{" { depth=depth+1; }
            if token.text==")" or token.text=="]" or token.text=="}" { depth=depth-1; }
            if depth>MAX_DEPTH { return failure("Source nesting limit exceeded."); }
            // A malformed close must not subsidize deeper subsequent nesting.
            if depth<0 { return failure("Unbalanced source delimiters."); }
        }
    }
    return try Frontend.frontend_lint(source) catch failure("Source analysis could not complete.");
}
fn render(result) {
    let rows=try result.diagnostics catch nil;
    if type(rows)!="array" { return "<p>Source analysis could not complete.</p>"; }
    if len(rows)==0 and (try result.ok catch false)==true {
        return "<p>No issues found by the source checker. Code was not executed.</p>";
    }
    let out="<ul>"; let shown=0; let used=4;
    for row in rows {
        if shown>=MAX_DIAGNOSTICS { break; }
        let kind=try row.kind catch "error";
        if kind!="error" and kind!="warning" and kind!="info" { kind="info"; }
        let message=try row.message catch nil;
        if type(message)!="string" { message="Source diagnostic unavailable."; }
        message=str_slice(message,0,if len(message)>512 {512} else {len(message)});
        let item="<li>"+kind+": "+HTML.escape(message)+"</li>";
        let size=len(str_to_bytes(item));
        if used+size>MAX_RENDER_BYTES-128 { break; }
        out=out+item; used=used+size; shown=shown+1;
    }
    if shown<len(rows) { out=out+"<li>Additional diagnostics omitted by the display limit.</li>"; }
    return out+"</ul>";
}
export check,render,MAX_BYTES,MAX_TOKENS,MAX_DEPTH,MAX_DIAGNOSTICS,MAX_RENDER_BYTES;
