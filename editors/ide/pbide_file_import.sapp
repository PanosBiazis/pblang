// Strict, bounded browser upload envelope. No filesystem, execution or persistence.
let MAX_BODY=24576;
let MAX_FILE_BYTES=4096;
let MAX_HEADER_BYTES=512;
fn boundary(content_type) {
    let prefix="multipart/form-data; boundary=";
    if type(content_type)!="string" or len(content_type)>128
        or str_lower(str_slice(content_type,0,len(prefix)))!=prefix {
        throw "invalid upload content type";
    }
    let value=str_slice(content_type,len(prefix),len(content_type));
    if str_starts_with(value,"\"") and str_ends_with(value,"\"") and len(value)>=2 {
        value=str_slice(value,1,len(value)-1);
    }
    if not regex_match(value,"^[A-Za-z0-9_-]{1,70}$") { throw "invalid upload boundary"; }
    return value;
}
fn _part(part,file) {
    let split=str_index_of(part,"\r\n\r\n");
    if split<1 or split>MAX_HEADER_BYTES { throw "invalid upload headers"; }
    let block=str_slice(part,0,split);
    if len(str_to_bytes(block))>MAX_HEADER_BYTES { throw "upload headers too large"; }
    let lines=str_split(block,"\r\n");
    if len(lines)<1 or len(lines)>2 { throw "invalid upload header count"; }
    let headers=map{};
    for line in lines {
        for byte in str_to_bytes(line) {
            if byte<32 or byte==127 { throw "invalid upload header text"; }
        }
        let colon=str_index_of(line,":");
        if colon<1 { throw "invalid upload header"; }
        let name=str_lower(str_slice(line,0,colon));
        if (name!="content-disposition" and name!="content-type") or map_has(headers,name) {
            throw "invalid upload header name";
        }
        headers[name]=str_trim(str_slice(line,colon+1,len(line)));
    }
    let disposition=try headers["content-disposition"] catch "";
    if not file {
        if len(headers)!=1 or disposition!="form-data; name=\"workspace\"" {
            throw "invalid upload workspace part";
        }
    } else {
        let prefix="form-data; name=\"upload\"; filename=\"";
        if not str_starts_with(disposition,prefix) or not str_ends_with(disposition,"\"") {
            throw "invalid upload file part";
        }
        let filename=str_slice(disposition,len(prefix),len(disposition)-1);
        if len(filename)<1 or len(str_to_bytes(filename))>255 or str_contains(filename,"\"") {
            throw "invalid upload filename";
        }
        if map_has(headers,"content-type") and not regex_match(headers["content-type"],
            "^[A-Za-z0-9.+_-]{1,64}/[A-Za-z0-9.+_-]{1,64}$") {
            throw "invalid upload media type";
        }
    }
    return str_slice(part,split+4,len(part));
}
fn parse(body,content_type) {
    if type(body)!="string" or len(body)>MAX_BODY or len(str_to_bytes(body))>MAX_BODY {
        throw "upload body limit exceeded";
    }
    let b=boundary(content_type); let open="--"+b+"\r\n";
    let close="\r\n--"+b+"--";
    if str_ends_with(body,close+"\r\n") { body=str_slice(body,0,len(body)-2); }
    if not str_starts_with(body,open) or not str_ends_with(body,close)
        or len(body)<len(open)+len(close) { throw "invalid upload envelope"; }
    let payload=str_slice(body,len(open),len(body)-len(close));
    let separator="\r\n--"+b+"\r\n";
    let at=str_index_of(payload,separator);
    if at<0 { throw "missing upload part"; }
    let first=str_slice(payload,0,at);
    let second=str_slice(payload,at+len(separator),len(payload));
    // A second delimiter or any boundary-looking line is rejected in full;
    // never silently truncate a file or accept an early terminator.
    if str_contains(first,"\r\n--"+b) or str_contains(second,"\r\n--"+b) {
        throw "ambiguous upload framing";
    }
    let workspace=_part(first,false); let source=_part(second,true);
    if len(str_to_bytes(workspace))>17664 { throw "upload workspace too large"; }
    return map{workspace:workspace,source:source};
}
fn normalize(source) {
    if type(source)!="string" or len(source)>MAX_FILE_BYTES
        or len(str_to_bytes(source))>MAX_FILE_BYTES { throw "uploaded source too large"; }
    if str_starts_with(source,strfromcharcode(65279)) { source=str_slice(source,1,len(source)); }
    source=str_replace_all(source,"\r\n","\n");
    if str_contains(source,"\r") or str_contains(source,strfromcharcode(0)) {
        throw "invalid uploaded source";
    }
    return source;
}
export boundary,parse,normalize,MAX_BODY,MAX_FILE_BYTES,MAX_HEADER_BYTES;
