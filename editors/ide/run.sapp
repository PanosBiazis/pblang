//
// editors/ide/run.sapp — Cross-Platform Pure-PBLang Launcher for pbIDE (Linux / macOS / Windows)
//
// Usage:
//   ./pblang run editors/ide/run.sapp --allow-all
//   ./pblang run editors/ide/run.sapp --allow-all -- main.sapp
//   PBIDE_SCALE=2 ./pblang run editors/ide/run.sapp --allow-all

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _resolve_repo_root() {
    let cur = cwd();
    if fs_exists(cur + "/editors/ide/pbide.sapp") or fs_exists(cur + "/pblang.toml") {
        return cur;
    }
    if fs_exists(cur + "/../../editors/ide/pbide.sapp") {
        return cur + "/../..";
    }
    return cur;
}

fn _can_exec(bin: string) {
    let r = try proc_spawn_wait(bin, ["--version"]) catch map{ exit_code: 127 };
    return r.exit_code == 0;
}

fn _find_pblang_bin(root: string, is_win: bool) {
    let env_bin = env_get("PBLANG_BIN");
    if env_bin != nil and env_bin != "" {
        return env_bin;
    }
    let ext = if is_win { ".exe" } else { "" };
    let candidates = [
        root + "/pblang" + ext,
        root + "/target/debug/pblang" + ext,
        root + "/target/release/pblang" + ext
    ];
    let i = 0;
    while i < len(candidates) {
        if fs_exists(candidates[i]) {
            return candidates[i];
        }
        i = i + 1;
    }
    let fallback = "pblang" + ext;
    if _can_exec(fallback) {
        return fallback;
    }
    eprint("pblang binary not found. Build it first: ./pblang build or cargo build --bin pblang\n");
    os_exit(1);
    return fallback;
}

let is_win = env_get("OS") == "Windows_NT";
let root = _resolve_repo_root();
let pb_bin = _find_pblang_bin(root, is_win);

let gpu_build = env_get("PBIDE_GPU_BUILD");
if gpu_build == nil or gpu_build == "" { gpu_build = "1"; }
let explicit_bin = env_get("PBLANG_BIN");

if not is_win and gpu_build != "0" and (explicit_bin == nil or explicit_bin == "") and _can_exec("cargo") and fs_exists(root + "/Cargo.toml") {
    let probe = try proc_spawn_wait(pb_bin, ["eval", "let gfx = import(\"stdlib:graphics.sapp\"); let p = gfx.backend_profile(); print str(try p.compiled_sdl2 catch false);"]) catch map{ exit_code: 1, stdout: "" };
    if probe.exit_code == 0 and not str_contains(str(probe.stdout), "true") {
        eprint("pbIDE launcher: building SDL2 GPU-present binary (set PBIDE_GPU_BUILD=0 to skip)\n");
        let bld = try proc_spawn_wait("cargo", ["build", "-p", "pblang", "--features", "pblang-graphics/sdl2"]) catch map{ exit_code: 1, stdout: "", stderr: "" };
        if bld.exit_code == 0 and fs_exists(root + "/target/debug/pblang") {
            pb_bin = root + "/target/debug/pblang";
        } else {
            fs_write("/tmp/pbide-gpu-build.log", str(bld.stdout) + "\n" + str(bld.stderr));
            eprint("pbIDE launcher: SDL2 build unavailable, continuing with existing binary\n");
            eprint("pbIDE launcher: see /tmp/pbide-gpu-build.log for details\n");
        }
    }
}

let gfx_backend = env_get("PBLANG_GFX");
if gfx_backend == nil or gfx_backend == "" {
    gfx_backend = "sdl2";
    try env_set("PBLANG_GFX", gfx_backend) catch nil;
}
let scale_val = env_get("PBIDE_SCALE");
let scale_label = if scale_val != nil and scale_val != "" { scale_val } else { "auto" };
eprint("pbIDE launcher: " + pb_bin + "  (gfx=" + gfx_backend + " scale=" + scale_label + ")\n");

let cli_args = _collect_args();
let cmd = ["ide"];
let i = 0;
while i < len(cli_args) {
    array_push(cmd, cli_args[i]);
    i = i + 1;
}

let run_res = if not is_win and fs_exists("/usr/bin/env") {
    let env_cmd = ["PBLANG_GFX=" + gfx_backend, pb_bin];
    let k = 0;
    while k < len(cmd) {
        array_push(env_cmd, cmd[k]);
        k = k + 1;
    }
    proc_spawn_wait("/usr/bin/env", env_cmd)
} else {
    proc_spawn_wait(pb_bin, cmd)
};
if run_res.stdout != "" { print(run_res.stdout); }
if run_res.stderr != "" { eprint(run_res.stderr); }
os_exit(run_res.exit_code);
