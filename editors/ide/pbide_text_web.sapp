// Experimental server-rendered editor migration. No evaluator or persistence.
let Text=import("editors/ide/pbide_text.sapp");
let History=import("editors/ide/pbide_text_history.sapp");
let Wire=import("editors/ide/pbide_history_wire.sapp");
let HTML=import("stdlib:html.sapp");
let HTTP=import("stdlib:http_server.sapp");
let Check=import("editors/ide/pbide_source_check.sapp");
let Tabs=import("editors/ide/pbide_tabs_wire.sapp");
let Highlight=import("editors/ide/pbide_source_highlight.sapp");
let MAX_BODY=65536;
let MAX_RESPONSE=131072;
let WEB_BYTES=4096;
fn endpoint(port) {
    if type(port)!="number" or not (port>=1024 and port<=65535)
        or port!=num_floor(port) { throw "invalid editor port"; }
    return "127.0.0.1:"+str(port);
}
fn response(code,body) {
    return map{status:code,body:body,content_type:"text/html; charset=utf-8",headers:map{
        // no-referrer turns a browser navigation POST's Origin into null.
        // same-origin preserves the strict Origin gate without cross-site referrers.
        "Cache-Control":"no-store", "Pragma":"no-cache", "Referrer-Policy":"same-origin",
        "X-Content-Type-Options":"nosniff", "X-Frame-Options":"DENY",
        "Cross-Origin-Resource-Policy":"same-origin",
        "Permissions-Policy":"camera=(), microphone=(), geolocation=(), usb=(), payment=()",
        "Content-Security-Policy":"default-src 'none'; style-src 'unsafe-inline'; script-src 'none'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
    }};
}
fn _integer(text,maximum) {
    if type(text)!="string" or len(text)==0 or len(text)>6 { throw "invalid position"; }
    let i=0;
    while i<len(text) {
        if not str_contains("0123456789",str_slice(text,i,i+1)) { throw "invalid position"; }
        i=i+1;
    }
    let value=parse_number(text);
    if not (value>=0 and value<=maximum) { throw "invalid position"; }
    return value;
}
fn _allowed(req,port) {
    let host=endpoint(port); let allowed=false;
    let count=HTTP.req_header(req,"Content-Length");
    if count==nil { count="0"; }
    let size=_integer(count,MAX_BODY);
    if HTTP.req_header(req,"Host")==host {
        if req.method=="GET" and req.path=="/" and size==0 { allowed=true; }
        if req.method=="POST" and req.path=="/edit" and size>0
            and HTTP.req_header(req,"Origin")=="http://"+host
            and HTTP.req_header(req,"Content-Type")=="application/x-www-form-urlencoded" {
            allowed=true;
        }
    }
    return allowed;
}
fn preflight(req,port) {
    let allowed=try _allowed(req,port) catch false;
    return map{allowed:allowed,response:response(403,"Request rejected. Return to the local editor.")};
}
fn options(port) {
    endpoint(port);
    return map{request_timeout_ms:1000,write_timeout_ms:1000,accept_poll_ms:5,
        max_inflight:4,max_header_bytes:8192,max_body_bytes:MAX_BODY,max_response_bytes:MAX_RESPONSE,
        preflight:fn(req){return preflight(req,port);}};
}
fn _fields(body) {
    if type(body)!="string" or len(body)>MAX_BODY {
        throw "form limit exceeded";
    }
    let body_bytes=str_to_bytes(body);
    if len(body_bytes)>MAX_BODY { throw "form limit exceeded"; }
    let separators=0; let byte_index=0;
    while byte_index<len(body_bytes) {
        if body_bytes[byte_index]==38 { separators=separators+1; }
        if separators>7 { throw "invalid form fields"; }
        byte_index=byte_index+1;
    }
    let parts=str_split(body,"&");
    if len(parts)!=6 and len(parts)!=7 and len(parts)!=8 { throw "invalid form fields"; }
    let fields=map{}; let allowed=["source","start","end","insert","op","pair","history","workspace"];
    for part in parts {
        let equals=str_index_of(part,"=");
        if equals<1 { throw "invalid form field"; }
        let key=url_decode(str_slice(part,0,equals));
        let known=false;
        for name in allowed { if key==name { known=true; } }
        if not known or map_has(fields,key) { throw "invalid form fields"; }
        let value=url_decode(str_slice(part,equals+1,len(part)));
        if type(value)!="string" or str_contains(value,strfromcharcode(0)) { throw "invalid form text"; }
        fields[key]=value;
    }
    let required_index=0;
    while required_index<6 {
        if not map_has(fields,allowed[required_index]) { throw "missing form field"; }
        required_index=required_index+1;
    }
    if map_has(fields,"workspace") and (len(parts)!=8 or not map_has(fields,"history")) {
        throw "drafts require history";
    }
    // Browsers serialize textarea line breaks as CRLF. Positions are scalar
    // offsets in LF-normalized text, explicitly displayed in the form.
    fields.source=str_replace_all(fields.source,"\r\n","\n");
    fields.insert=str_replace_all(fields.insert,"\r\n","\n");
    for name in ["source","insert"] {
        if len(str_to_bytes(fields[name]))>WEB_BYTES or str_contains(fields[name],"\r") {
            throw "editor text limit exceeded";
        }
    }
    return fields;
}
fn _state(fields) {
    let state=Text.selection(fields.source,_integer(fields.start,Text.MAX_CHARS),_integer(fields.end,Text.MAX_CHARS));
    if not map_has(map{round:true,square:true,brace:true,double:true,single:true},fields.pair) {
        throw "unsupported pair";
    }
    return state;
}
fn _history(fields) {
    let state=_state(fields);
    let history=History.create(state,Wire.BUDGET);
    let has_history=map_has(fields,"history");
    if has_history { history=Wire.decode(fields.history); }
    // A manually typed draft normally differs from the previous hidden snapshot.
    history=History.commit(history,state);
    let pairs=map{round:"(",square:"[",brace:"{",double:"\"",single:"'"};
    if not map_has(pairs,fields.pair) { throw "unsupported pair"; }
    if fields.op=="undo" or fields.op=="redo" or fields.op=="clear-history" {
        if not has_history { throw "history is required"; }
        if fields.op=="undo" { return History.undo(history); }
        if fields.op=="redo" { return History.redo(history); }
        return History.create(state,Wire.BUDGET);
    }
    if fields.op=="tab" { state=Text.tab(state); }
    elif fields.op=="pair" { state=Text.pair(state,pairs[fields.pair]); }
    elif fields.op=="replace" { state=Text.replace(state,fields.insert); }
    elif fields.op!="status" and fields.op!="check" and fields.op!="highlight" { throw "unsupported operation"; }
    if len(str_to_bytes(state.text))>WEB_BYTES { throw "editor result limit exceeded"; }
    return History.commit(history,state);
}
fn _workspace_base(fields) {
    let workspace=nil;
    if map_has(fields,"workspace") { workspace=Tabs.decode(fields.workspace); }
    else {
        let initial=History.create(Text.selection(fields.source,_integer(fields.start,Text.MAX_CHARS),
            _integer(fields.end,Text.MAX_CHARS)),Wire.BUDGET);
        if map_has(fields,"history") { initial=Wire.decode(fields.history); }
        workspace=Tabs.create(initial);
    }
    if map_has(fields,"workspace") and Wire.encode(Tabs.current(workspace))!=Wire.encode(Wire.decode(fields.history)) {
        throw "draft history mismatch";
    }
    return workspace;
}
fn _workspace(fields) {
    let workspace=_workspace_base(fields);
    if fields.op=="discard-draft" {
        if not map_has(fields,"workspace") { throw "drafts required"; }
        return Tabs.discard(workspace);
    }
    let op=fields.op;
    let tab_action=op=="new-draft" or str_starts_with(op,"draft-");
    if tab_action { fields.op="status"; }
    let next=_history(fields);
    workspace=Tabs.replace(workspace,next);
    if op=="new-draft" { return Tabs.add(workspace); }
    if str_starts_with(op,"draft-") {
        let id=str_slice(op,6,len(op));
        if len(id)!=1 or not str_contains("1234",id) { throw "invalid draft selection"; }
        return Tabs.select(workspace,parse_number(id));
    }
    return workspace;
}
fn parse_workspace(body) { return _workspace(_fields(body)); }
fn parse_history(body) {
    let fields=_fields(body);
    if map_has(fields,"workspace") { return Tabs.current(_workspace(fields)); }
    return _history(fields);
}
fn parse_form(body) { return History.current(parse_history(body)); }
fn render(state,history=nil,diagnostics=nil,workspace=nil,highlight=false) {
    if type(highlight)!="bool" { throw "invalid preview request"; }
    let preview="";
    if highlight {
        let rendered=Highlight.render(state.text);
        preview="<section aria-label=\"Syntax preview\"><h2>Source preview</h2><p>"
            +(if rendered.highlighted { "Lexical colors for the submitted draft. This is not a syntax check." }
                else { "Plain preview: coloring is unavailable or its limit was reached. All source text is shown." })
            +"</p>"+rendered.html+"</section>";
    }
    if history==nil { history=History.create(state,Wire.BUDGET); }
    let encoded=Wire.encode(history); let current=History.current(history);
    if workspace==nil { workspace=Tabs.create(history); }
    if Wire.encode(Tabs.current(workspace))!=encoded { throw "rendered draft history differs"; }
    let workspace_wire=Tabs.encode(workspace);
    let tab_buttons="<div role=\"group\" aria-label=\"Drafts\">";
    for tab in workspace.tabs {
        tab_buttons=tab_buttons+"<button name=\"op\" value=\"draft-"+str(tab.id)+"\" aria-pressed=\""
            +(if tab.id==workspace.active { "true" } else { "false" })+"\">"+HTML.escape("Draft"+str(tab.id))+"</button>";
    }
    tab_buttons=tab_buttons+"<button name=\"op\" value=\"new-draft\""
        +(if len(workspace.tabs)>=Tabs.MAX_TABS { " disabled" } else { "" })+">New draft</button>"
        +"<button name=\"op\" value=\"discard-draft\""
        +(if len(workspace.tabs)==1 { " disabled" } else { "" })+">Discard "+HTML.escape("Draft"+str(workspace.active))+"</button></div>";
    if current.text!=state.text or current.start!=state.start or current.end!=state.end {
        throw "rendered history and editor differ";
    }
    let info=Text.status(state);
    let content="<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        +"<title>PBIDE — PBLang editor pilot</title><style>body{margin:0;background:#101726;color:#e8eef8;font:16px system-ui}main{max-width:960px;margin:auto;padding:24px}h1{margin-bottom:8px}p{line-height:1.5;color:#bac8df}label{display:block;margin:16px 0 6px}textarea,input,select,button{box-sizing:border-box;font:inherit;color:inherit;background:#1c2a42;border:1px solid #7386a6;border-radius:6px;padding:10px}textarea{width:100%;font:16px monospace;tab-size:4}pre{overflow:auto;padding:12px;background:#172238;tab-size:4;white-space:pre-wrap;overflow-wrap:anywhere}.syntax-kw{color:#d9b5ff}.syntax-str{color:#a3e2ac}.syntax-num{color:#ffc982}.syntax-comment{color:#adbdd4}input{max-width:130px}button{cursor:pointer;background:#285e9b;margin:12px 8px 0 0}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #ffc760;outline-offset:2px}.fields{display:flex;gap:20px;flex-wrap:wrap}output{display:block;padding:12px;background:#20334d;border-radius:6px}@media(max-width:480px){main{padding:12px}button{width:100%}}</style></head><body><main>"
        +"<h1>PBIDE · PBLang editor pilot</h1><p>Keep up to four drafts open, with independent Undo and Redo. Drafts are held in this page. Copy your work before closing.</p>"
        +"<output aria-live=\"polite\">Line "+str(info.line)+", column "+str(info.column)+" · "+str(info.characters)+" characters · "+str(info.selected)+" selected</output>"
        +"<form method=\"post\" action=\"/edit\" accept-charset=\"UTF-8\" autocomplete=\"off\"><input type=\"hidden\" name=\"history\" value=\""+HTML.escape(encoded)+"\"><input type=\"hidden\" name=\"workspace\" value=\""+HTML.escape(workspace_wire)+"\">"+tab_buttons+"<label for=\"source\">Source (maximum 4096 UTF-8 bytes)</label>"
        // The first LF after a textarea opening tag is consumed by HTML parsing.
        +"<textarea id=\"source\" name=\"source\" rows=\"12\" spellcheck=\"false\">\n"+HTML.escape(state.text)+"</textarea>"
        +"<p id=\"positions\">Enter zero-based character offsets below; emoji count as one character and line breaks as one. End is exclusive. Selecting text with the mouse does not update these fields in this no-script pilot.</p><div class=\"fields\"><div><label for=\"start\">Selection start</label><input id=\"start\" name=\"start\" type=\"number\" min=\"0\" max=\"8192\" required aria-describedby=\"positions\" value=\""+str(state.start)+"\"></div>"
        +"<div><label for=\"end\">Selection end</label><input id=\"end\" name=\"end\" type=\"number\" min=\"0\" max=\"8192\" required value=\""+str(state.end)+"\"></div>"
        +"<div><label for=\"pair\">Pair</label><select id=\"pair\" name=\"pair\"><option value=\"round\">( )</option><option value=\"square\">[ ]</option><option value=\"brace\">{ }</option><option value=\"double\">Double quotes</option><option value=\"single\">Single quotes</option></select></div></div>"
        +"<label for=\"insert\">Replacement text</label><textarea id=\"insert\" name=\"insert\" rows=\"2\" spellcheck=\"false\"></textarea>"
        +"<button name=\"op\" value=\"status\">Refresh status</button><button name=\"op\" value=\"tab\">Insert four spaces</button><button name=\"op\" value=\"pair\">Wrap in pair</button><button name=\"op\" value=\"replace\">Replace selection</button>"
        +"<button name=\"op\" value=\"undo\">Undo</button><button name=\"op\" value=\"redo\">Redo</button><button name=\"op\" value=\"clear-history\">Clear history</button><button name=\"op\" value=\"check\">Check source</button><button name=\"op\" value=\"highlight\">Highlight source</button><button name=\"op\" value=\"download\">Download .sapp</button></form><p>Download exports the visible text with LF line endings. It does not record a history step or save a server copy. Preview updates only when you submit Highlight source.</p>"
        +preview
        +(if diagnostics==nil { "" } else { "<section aria-label=\"Source check\" aria-live=\"polite\">"+Check.render(diagnostics)+"</section>" })
        +"<p>Draft"+str(workspace.active)+" history position "+str(history.cursor+1)+" of "+str(len(history.frames))+". Up to 9 snapshots per draft and 8192 total UTF-8 history bytes across all drafts. Old snapshots within an edited draft expire; combined overflow is rejected. Typing is recorded on submission. Undo records your draft then steps back; new text discards redo. At a history boundary nothing changes.</p>"
        +"<p>Drafts and history travel in this page (hex is not encryption). Discard removes the active draft without recording its submitted edits. Clear history keeps the current text only; it cannot erase older browser Back entries. Not yet the complete Web IDE: Designer, file import, automatic caret binding and Run are not connected. Copy your work before closing. Invalid input is rejected without echoing it. Use the editor Undo button; do not rely on browser Back for recovery.</p></main></body></html>";
    return content;
}
fn _post(req) {
    if len(str_to_bytes(req.body))!=_integer(HTTP.req_header(req,"Content-Length"),MAX_BODY) {
        throw "invalid body length";
    }
    let fields=_fields(req.body);
    if fields.op=="download" {
        let workspace=_workspace_base(fields); let state=_state(fields);
        let out=response(200,state.text);
        out.content_type="text/plain; charset=utf-8";
        out.headers["Content-Disposition"]="attachment; filename=\"Draft"+str(workspace.active)+".sapp\"";
        return out;
    }
    let highlighting=fields.op=="highlight";
    let checking=fields.op=="check";
    let workspace=_workspace(fields);
    let history=Tabs.current(workspace); let state=History.current(history);
    let diagnostics=if checking { Check.check(state.text) } else { nil };
    return response(200,render(state,history,diagnostics,workspace,highlighting));
}
fn handle(req,port) {
    let gate=preflight(req,port);
    if not gate.allowed { return gate.response; }
    if req.method=="GET" { return response(200,render(Text.selection("print \"Hello from PBLang\";",0,0))); }
    return try _post(req) catch response(400,"Editor input rejected: check the text size, operation and ordered character positions. No source was retained by the server.");
}
export MAX_BODY,MAX_RESPONSE,WEB_BYTES,endpoint,options,preflight,parse_form,parse_history,parse_workspace,render,handle;
