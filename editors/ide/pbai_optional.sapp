// editors/ide/pbai_optional.sapp — optional bridge from the IDE's AI panel to the external
// pbAI product (https://github.com/PanosBiazis/pbai).
//
// Since pblang 1.3.0, pbAI and pb-mcp-server are no longer embedded in pblang. The IDE works
// without them; the AI panel is enabled when a pbai checkout is found:
//   1. PBAI_HOME=<path to pbai checkout>, or
//   2. a sibling checkout ../pbai next to the current working directory (pblang checkout).
// The module exposes the same calls the IDE uses (respond, explain_line, model_status,
// analyze, generate) and degrades to a clear "not installed" message otherwise.

let _MISSING = "pbAI is not installed. Set PBAI_HOME to a pbai checkout (https://github.com/PanosBiazis/pbai) and restart the IDE.";

fn _env(name) {
    let v = try str_trim(str(env_get(name))) catch "";
    if v == "nil" { return ""; }
    return v;
}

fn _load() {
    let home = _env("PBAI_HOME");
    if home != "" {
        if home == "none" or home == "0" or home == "false" { return nil; }
        return try import(home + "/stdlib/pbai_lite.sapp") catch nil;
    }
    // Resolved relative to this module, then to the pblang manifest dir (sibling ../pbai).
    let m2 = try import("../pbai/stdlib/pbai_lite.sapp") catch nil;
    if m2 != nil { return m2; }
    return nil;
}

let _MOD = _load();

fn installed() { return _MOD != nil; }

fn module() { return _MOD; }

fn respond(prompt) {
    if _MOD == nil { return _MISSING; }
    return _MOD.respond(prompt);
}

fn explain_line(prompt) {
    if _MOD == nil { return nil; }
    return _MOD.explain_line(prompt);
}

fn model_status() {
    if _MOD == nil {
        return map{ family: "pbAI (not installed)", top: map{ router: "-", tools: "-" },
                    bottom: map{ lm: "-", tier: "-", format: "-", architecture: "-", learns: "-" },
                    installed: false, message: _MISSING };
    }
    return _MOD.model_status();
}

fn analyze(code) {
    if _MOD == nil { return _MISSING; }
    return _MOD.analyze(code);
}

fn generate(seed, n) {
    if _MOD == nil { return _MISSING; }
    return _MOD.generate(seed, n);
}

export installed, module, respond, explain_line, model_status, analyze, generate;
