// editors/ide/tools/check_html_lib.sapp — the PURE structural-validation logic behind check_html.sapp,
// split out so it can be unit-tested in isolation (the driver `check_html.sapp` reads a file and calls main;
// this module has no side effects, only string→count functions). Tokenizer-aware bracket balancing for JS
// embedded in the IDE bootstrap HTML: ignores braces inside strings, // and /* */ comments, `template ${…}`
// literals, and /regex/ literals.

fn _count(s, sub) { return len(str_split(s, sub)) - 1; }

// count_open_tag(s, tag) — number of `<tag …>` OPEN tags, requiring a tag-NAME BOUNDARY after the name so
// `<div` does not also match `<divider>` (the substring bug in a plain _count). The char after the name must
// be one of space > / tab NL CR — otherwise it's a longer, different tag name.
fn count_open_tag(s, tag) {
    let needle = "<" + tag;
    let nl = len(needle);
    let n = len(s);
    let cnt = 0;
    let i = 0;
    while i + nl <= n {
        if str_slice(s, i, i + nl) == needle {
            let after = 62;                                    // treat EOF as '>' (a bare `<div` at end)
            if i + nl < n { after = strcharcodeat(s, i + nl); }
            if after == 32 or after == 62 or after == 47 or after == 9 or after == 10 or after == 13 { cnt = cnt + 1; }
            i = i + nl;
        } else {
            i = i + 1;
        }
    }
    return cnt;
}

// skip a "…" or '…' string starting at i (i points just after the opening quote).
fn _skip_string(s, i, n, q) {
    while i < n {
        let d = strcharcodeat(s, i);
        if d == 92 { i = i + 2; }              // backslash escape
        else { if d == q { return i + 1; } i = i + 1; }
    }
    return i;
}

// skip a `…` template literal starting at i (just after the opening backtick),
// descending into ${ … } expression holes (which contain real code/braces/strings).
fn _skip_template(s, i, n) {
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 92 {
            i = i + 2;                                                 // escape
        } else if c == 96 {
            return i + 1;                                             // closing backtick
        } else if c == 36 and i + 1 < n and strcharcodeat(s, i + 1) == 123 {   // ${ … }
            i = i + 2;
            let depth = 1;
            while i < n and depth > 0 {
                let d = strcharcodeat(s, i);
                if d == 123 { depth = depth + 1; i = i + 1; }
                else if d == 125 { depth = depth - 1; i = i + 1; }
                else if d == 34 or d == 39 { i = _skip_string(s, i + 1, n, d); }
                else if d == 96 { i = _skip_template(s, i + 1, n); }
                else { i = i + 1; }
            }
        } else {
            i = i + 1;
        }
    }
    return i;
}

// a / starts a regex (not division) when the previous significant char is an operator,
// open bracket, comma, etc. — never after a value ( ) ] } identifier digit.
fn _regex_ok(prev) {
    if prev == 41 or prev == 93 or prev == 125 { return false; }   // ) ] }
    if prev >= 48 and prev <= 57 { return false; }                 // digit
    if prev >= 65 and prev <= 90 { return false; }                 // A-Z
    if prev >= 97 and prev <= 122 { return false; }                // a-z
    if prev == 95 or prev == 36 { return false; }                  // _ $
    return true;                                                   // start, operators, ( [ { , ; = …
}

// skip a /regex/flags literal from i (just after the opening /). `[ … ]` char classes
// hide a literal /, and \ escapes the next char.
fn _skip_regex(s, i, n) {
    let inclass = false;
    while i < n {
        let d = strcharcodeat(s, i);
        if d == 92 { i = i + 2; }
        else if d == 91 { inclass = true; i = i + 1; }
        else if d == 93 { inclass = false; i = i + 1; }
        else if d == 47 and not inclass { i = i + 1;
            while i < n and ((strcharcodeat(s, i) >= 97 and strcharcodeat(s, i) <= 122)) { i = i + 1; }  // flags
            return i;
        }
        else { i = i + 1; }
    }
    return i;
}

// _balance(js) -> map{ curly, paren, square } (all 0 = balanced). String/comment/
// template/regex-aware so braces inside those don't corrupt the count.
fn _balance(s) {
    let curly = 0; let paren = 0; let square = 0;
    let prev = 0;
    let i = 0; let n = len(s);
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 47 and i + 1 < n and strcharcodeat(s, i + 1) == 47 {           // // line comment
            i = i + 2;
            while i < n and strcharcodeat(s, i) != 10 { i = i + 1; }
        } else if c == 47 and i + 1 < n and strcharcodeat(s, i + 1) == 42 {    // /* block */
            i = i + 2;
            while i + 1 < n and not (strcharcodeat(s, i) == 42 and strcharcodeat(s, i + 1) == 47) { i = i + 1; }
            i = i + 2;
        } else if c == 47 and _regex_ok(prev) {                               // /regex/
            i = _skip_regex(s, i + 1, n);
            prev = 120;                                                       // a value follows
        } else if c == 34 or c == 39 {
            i = _skip_string(s, i + 1, n, c);
            prev = 120;
        } else if c == 96 {
            i = _skip_template(s, i + 1, n);
            prev = 120;
        } else {
            if c == 123 { curly = curly + 1; }
            if c == 125 { curly = curly - 1; }
            if c == 40 { paren = paren + 1; }
            if c == 41 { paren = paren - 1; }
            if c == 91 { square = square + 1; }
            if c == 93 { square = square - 1; }
            if c != 32 and c != 9 and c != 10 and c != 13 { prev = c; }       // last significant char
            i = i + 1;
        }
    }
    return map{ curly: curly, paren: paren, square: square };
}

// extract_scripts(s) — the inline JS of every <script …> block, REGARDLESS of attributes. The driver used
// str_split(s, "<script>") which only matches a bare `<script>` and silently skipped `<script type="module">`
// / `<script src=…>` blocks (leaving their braces unchecked). This finds `<script` + a name boundary, takes
// the content from the open tag's `>` up to `</script>`, and returns each block's inline source.
fn extract_scripts(s) {
    let out = [];
    let n = len(s);
    let i = 0;
    while i < n {
        if i + 7 <= n and str_slice(s, i, i + 7) == "<script" {
            let after = 62;
            if i + 7 < n { after = strcharcodeat(s, i + 7); }
            if after == 32 or after == 62 or after == 9 or after == 10 or after == 13 {
                let j = i + 7;
                while j < n and strcharcodeat(s, j) != 62 { j = j + 1; }   // end of the open tag
                let cstart = j + 1;
                let rest = str_slice(s, cstart, n);
                let rel = str_index_of(rest, "</script>");
                let clen = rel;
                if rel < 0 { clen = len(rest); }                          // unterminated <script>: take to EOF
                push(out, str_slice(rest, 0, clen));
                i = cstart + clen;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

// ── unterminated-construct detection ──────────────────────────────────────────────────────────────────
// _balance treats an unterminated string / template / /* comment as "everything to EOF is inside it", which
// silently HIDES all following braces — so genuinely broken code can report as balanced. These _end_* helpers
// return the index past the terminator, or -1 if the construct runs to EOF unterminated.
fn _end_string(s, i, n, q) {
    while i < n {
        let d = strcharcodeat(s, i);
        if d == 92 { i = i + 2; }
        else if d == q { return i + 1; }
        else { i = i + 1; }
    }
    return 0 - 1;
}
fn _end_block_comment(s, i, n) {   // i just after the /*
    while i + 1 < n {
        if strcharcodeat(s, i) == 42 and strcharcodeat(s, i + 1) == 47 { return i + 2; }
        i = i + 1;
    }
    return 0 - 1;
}
fn _end_template(s, i, n) {   // i just after the opening backtick; descends into ${…} holes
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 92 { i = i + 2; }
        else if c == 96 { return i + 1; }
        else if c == 36 and i + 1 < n and strcharcodeat(s, i + 1) == 123 {
            i = i + 2;
            let depth = 1;
            while i < n and depth > 0 {
                let d = strcharcodeat(s, i);
                if d == 123 { depth = depth + 1; i = i + 1; }
                else if d == 125 { depth = depth - 1; i = i + 1; }
                else if d == 34 or d == 39 { let e = _end_string(s, i + 1, n, d); if e < 0 { return 0 - 1; } i = e; }
                else if d == 96 { let e = _end_template(s, i + 1, n); if e < 0 { return 0 - 1; } i = e; }
                else { i = i + 1; }
            }
            if depth > 0 { return 0 - 1; }   // ${ hole never closed
        }
        else { i = i + 1; }
    }
    return 0 - 1;   // no closing backtick
}

// first_unterminated(s) -> map{ kind, pos } of the FIRST unterminated string/template/block-comment, or nil.
fn first_unterminated(s) {
    let i = 0; let n = len(s); let prev = 0;
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 47 and i + 1 < n and strcharcodeat(s, i + 1) == 47 {          // // line comment (EOF-terminates)
            i = i + 2;
            while i < n and strcharcodeat(s, i) != 10 { i = i + 1; }
        } else if c == 47 and i + 1 < n and strcharcodeat(s, i + 1) == 42 {   // /* block */
            let e = _end_block_comment(s, i + 2, n);
            if e < 0 { return map{ kind: "block comment", pos: i }; }
            i = e;
        } else if c == 47 and _regex_ok(prev) {                              // /regex/ — skip (rarely unterminated)
            i = _skip_regex(s, i + 1, n); prev = 120;
        } else if c == 34 or c == 39 {
            let e = _end_string(s, i + 1, n, c);
            if e < 0 { return map{ kind: "string", pos: i }; }
            i = e; prev = 120;
        } else if c == 96 {
            let e = _end_template(s, i + 1, n);
            if e < 0 { return map{ kind: "template literal", pos: i }; }
            i = e; prev = 120;
        } else {
            if c != 32 and c != 9 and c != 10 and c != 13 { prev = c; }
            i = i + 1;
        }
    }
    return nil;
}

export _count, count_open_tag, extract_scripts, _skip_string, _skip_template, _skip_regex, _regex_ok, _balance,
       _end_string, _end_block_comment, _end_template, first_unterminated;
