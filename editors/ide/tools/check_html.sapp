// editors/ide/tools/check_html.sapp — a structural validator for the IDE bootstrap,
// written in pblang (NO node, NO external tooling). Checks the HTML/JS file for:
//   • balanced <div>/<style>/<script> tags,
//   • per-<script> balance of {} () [] — with a tokenizer that ignores braces inside
//     strings, // and /* */ comments, and `template ${…}` literals.
// Run:  ./target/debug/pblang run editors/ide/tools/check_html.sapp <file>   (default: index.html)

// Pure validation logic lives in check_html_lib.sapp (unit-tested separately); this file is just the driver.
let L = import("editors/ide/tools/check_html_lib.sapp");
fn _count(s, sub) { return L._count(s, sub); }
fn _balance(s) { return L._balance(s); }

fn main() {
    let path = "editors/ide/index.html";
    let src = fs_read(path);
    let problems = 0;

    // 1) tag balance
    let pairs = ["div", "style", "script"];
    let p = 0;
    while p < len(pairs) {
        let o = L.count_open_tag(src, pairs[p]);   // boundary-aware: <div> but not <divider>
        let c = _count(src, "</" + pairs[p] + ">");
        if o != c { print "TAG MISMATCH <" + pairs[p] + ">: " + str(o) + " open vs " + str(c) + " close"; problems = problems + 1; }
        else { print "ok: <" + pairs[p] + "> balanced (" + str(c) + ")"; }
        p = p + 1;
    }

    // 2) per-<script> bracket balance — attribute-aware: <script type="module">, <script src=…> included
    let scripts = L.extract_scripts(src);
    let b = 0;
    while b < len(scripts) {
        let js = scripts[b];
        // An unterminated string/template/comment would make _balance UNDER-count (it swallows the rest as
        // string content), so a broken script could look "balanced". Report it before trusting the balance.
        let unterm = L.first_unterminated(js);
        if unterm != nil {
            print "SCRIPT " + str(b) + " UNTERMINATED " + str(unterm.kind) + " at offset " + str(unterm.pos);
            problems = problems + 1;
        }
        let bal = _balance(js);
        if bal.curly != 0 or bal.paren != 0 or bal.square != 0 {
            print "SCRIPT " + str(b) + " UNBALANCED: {}=" + str(bal.curly) + " ()=" + str(bal.paren) + " []=" + str(bal.square);
            problems = problems + 1;
        } else if unterm == nil {
            print "ok: <script> " + str(b) + " brackets balanced";
        }
        b = b + 1;
    }

    if problems == 0 { print "CHECK PASS"; } else { print "CHECK FAIL (" + str(problems) + " problem(s))"; }
}
main();
