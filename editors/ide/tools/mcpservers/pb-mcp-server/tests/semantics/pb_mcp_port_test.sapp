    let pbai_stdp = router.call("pbai_dopamine_hebbian_stdp_and_homeostasis", map{ pre_trace: 0.90, post_trace: 0.85, compiler_passed: true, tests_passed: true });
    assert_true(pbai_stdp.ok == true and pbai_stdp.value.ok == true and pbai_stdp.value.synaptic_potentiation_applied == true and pbai_stdp.value.homeostatic_firing_norm_bounded == true and pbai_stdp.value.ewc_catastrophic_forgetting_rate == 0.0, "pbai_dopamine_hebbian_stdp_and_homeostasis should wire live 3-factor Dopamine-STDP + Homeostasis + EWC");

    let pbai_rem = router.call("pbai_sleep_rem_consolidation_and_dream_synthesizer", map{ idle_state: "S3_DEEP_IDLE_EXPERT_EVICT", episodic_traces_count: 16, rem_dreams_count: 6 });
