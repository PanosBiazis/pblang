    let pbai_pre = router.call("pbai_markov_idle_prewarmer_and_ast_indexer", map{ is_system_idle: true, idle_budget_ms: 14 });
    assert_true(pbai_pre.ok == true and pbai_pre.value.ok == true and pbai_pre.value.prewarm_executed == true and pbai_pre.value.background_ast_indexed == true and pbai_pre.value.zero_foreground_stutter == true, "pbai_markov_idle_prewarmer_and_ast_indexer should prewarm next likely MoE expert and index AST in idle slice");

    let pbai_pre_busy = router.call("pbai_markov_idle_prewarmer_and_ast_indexer", map{ is_system_idle: false, idle_budget_ms: 14 });
