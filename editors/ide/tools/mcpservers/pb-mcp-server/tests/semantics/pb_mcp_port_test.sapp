let catalog = try import("src/catalog.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/catalog.sapp");
let core = try import("src/core_tools.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/core_tools.sapp");
let router = try import("src/router.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/router.sapp");

fn assert_true(cond, msg) {
    if not cond { throw msg; }
}

fn run_part_1() {
    let st = catalog.status();
    assert_true(st.generated_tool_count > 500, "catalog should contain the Rust tool surface");
    assert_true(st.native_catalog_tool_count == st.generated_tool_count, "all generated Rust catalog tools should be native pblang");
    assert_true(st.catalog_completion_percent == 100, "catalog completion should be 100 percent");
    assert_true(st.native_pblang_handler_count >= st.generated_tool_count, "native pblang handlers should cover the catalog");

    let all_tools = catalog.tool_catalog();
    for ti len(all_tools) {
        assert_true(all_tools[ti].native_pblang == true, "catalog-only tool left: " + all_tools[ti].name);
    }

    let ctx = core.workspace_context();
    assert_true(ctx.runtime == "pblang", "workspace context should be pblang-native");

    let stats = core.text_stats("one two\nthree");
    assert_true(stats.lines == 2, "text_stats line count");

    let call = router.call("text_stats", map{ text: "abc def" });
    assert_true(call.ok == true, "router text_stats call");
    assert_true(call.value.chars == 7, "router text_stats value");

    let known = router.call("pb_network_node_status", map{});
    assert_true(known.ok == false, "catalog-only tool should not pretend success");

    let plan = router.call("plan_work_buckets", map{ items: ["a", "b", "c"], buckets: 2 });
    assert_true(plan.ok == true, "plan_work_buckets should be native");

    let terms = router.call("summarize_top_terms", map{ text: "alpha beta alpha gamma beta alpha", top_n: 2 });
    assert_true(terms.ok == true, "summarize_top_terms should be native");
    assert_true(terms.value[0].term == "alpha", "top term should be alpha");

    let dist = router.call("text_levenshtein_distance", map{ a: "kitten", b: "sitting", max_len: 20 });
    assert_true(dist.ok == true, "text_levenshtein_distance should be native");
    assert_true(dist.value == 3, "levenshtein distance should be 3");

    let rt = router.call("pblang_runtime_status", map{});
    assert_true(rt.ok == true, "runtime status should be native");
    assert_true(rt.value.runtime == "pblang", "runtime status should identify pblang");

    let sorted = router.call("algo_sort", map{ items: [5, 1, 4, 2, 3] });
    assert_true(sorted.ok == true, "algo_sort should be native");
    assert_true(sorted.value.items[0] == 1 and sorted.value.items[4] == 5, "algo_sort should sort numbers");

    let found = router.call("algo_search", map{ items: [1, 2, 3, 4], target: 3, method: "binary" });
    assert_true(found.ok == true and found.value.found == true and found.value.index == 2, "algo_search binary");

    let bfs = router.call("algo_graph_bfs", map{ graph: map{ A: ["B", "C"], B: ["D"], C: [], D: [] }, start: "A" });
    assert_true(bfs.ok == true and bfs.value.count == 4, "algo_graph_bfs should visit four nodes");

    let desc = router.call("algo_stats_describe", map{ values: [1, 2, 3, 4, 5] });
    assert_true(desc.ok == true and desc.value.mean == 3, "algo_stats_describe mean");

    let det = router.call("algo_matrix_ops", map{ operation: "determinant", a: [[1, 2], [3, 4]] });
    assert_true(det.ok == true and det.value.result == -2, "algo_matrix_ops determinant");

    let paths = router.call("codebase_path_list", map{ dir: ".", max_entries: 80, max_depth: 2 });
    assert_true(paths.ok == true and len(paths.value) > 0, "codebase_path_list should return files");

    let idx = router.call("codebase_index", map{ dir: ".", max_entries: 40, max_depth: 2 });
    assert_true(idx.ok == true and idx.value.files > 0, "codebase_index should summarize files");

    let found_file = router.call("find_files_by_name", map{ query: "README", max_results: 10, max_depth: 2 });
    assert_true(found_file.ok == true and len(found_file.value) >= 1, "find_files_by_name should find README");

    let snippets = router.call("extract_snippets", map{ text: "alpha\nneedle\nomega", pattern: "needle", context: 1 });
    assert_true(snippets.ok == true and snippets.value[0].line == 2, "extract_snippets should locate match");

    let wrote = router.call("workspace_temp_write", map{ name: "pb-mcp-port-test.txt", text: "hello temp" });
    assert_true(wrote.ok == true and wrote.value.chars == 10, "workspace_temp_write should write");

    let read_temp = router.call("workspace_temp_read", map{ name: "pb-mcp-port-test.txt" });
    assert_true(read_temp.ok == true and read_temp.value.text == "hello temp", "workspace_temp_read should read");

    let deleted = router.call("workspace_temp_delete", map{ name: "pb-mcp-port-test.txt" });
    assert_true(deleted.ok == true and deleted.value.deleted == true, "workspace_temp_delete should delete");

    let gs = router.call("git_status", map{ max_chars: 2000 });
    assert_true(gs.ok == true and str_contains(gs.value.command, "git status"), "git_status should route to native read-only handler");

    let b64 = router.call("convert_format", map{ operation: "base64_encode", text: "hello" });
    assert_true(b64.ok == true and b64.value == "aGVsbG8=", "convert_format base64_encode");

    let flat = router.call("data_json_flatten", map{ text: "{\"a\":{\"b\":2},\"c\":[3]}" });
    assert_true(flat.ok == true and flat.value["a.b"] == 2, "data_json_flatten nested key");

    let q = router.call("db_json_query", map{ text: "{\"a\":{\"b\":2}}", query: "$.a.b" });
    assert_true(q.ok == true and q.value == 2, "db_json_query path");

    let wrote_log = router.call("workspace_temp_write", map{ name: "pb-mcp-log-test.log", text: "2026-01-01 INFO ok\n2026-01-01 ERROR failed\n" });
    assert_true(wrote_log.ok == true, "temp log write");

    let levels = router.call("log_level_summary", map{ path: ".mint-mcp/agent-temp/pb-mcp-log-test.log" });
    assert_true(levels.ok == true and levels.value.counts.ERROR == 1, "log_level_summary error count");

    let log_hits = router.call("log_search", map{ path: ".mint-mcp/agent-temp/pb-mcp-log-test.log", pattern: "failed" });
    assert_true(log_hits.ok == true and log_hits.value[0].level == "ERROR", "log_search finds failed line");

    let deleted_log = router.call("workspace_temp_delete", map{ name: "pb-mcp-log-test.log" });
    assert_true(deleted_log.ok == true, "temp log delete");

    let bar = router.call("chart_bar", map{ data: [map{ label: "a", value: 1 }, map{ label: "b", value: 2 }] });
    assert_true(bar.ok == true and str_contains(bar.value.svg, "<svg"), "chart_bar returns svg");

    let topic = "pb-mcp-port-test-topic";
    let sent = router.call("agent_send", map{ from_agent: "test-agent", to_agent: "receiver-agent", topic: topic, body: "hello bus" });
    assert_true(sent.ok == true and sent.value.topic == topic, "agent_send should append bus message");

    let thread = router.call("agent_thread", map{ topic: topic, limit: 10 });
    assert_true(thread.ok == true and len(thread.value) >= 1, "agent_thread should read topic");

    let inbox = router.call("agent_inbox", map{ for_agent: "receiver-agent", topic: topic, limit: 10 });
    assert_true(inbox.ok == true and len(inbox.value) >= 1, "agent_inbox should read DM");

    let search_bus = router.call("agent_bus_search", map{ needle: "hello bus", topic: topic, limit: 10 });
    assert_true(search_bus.ok == true and len(search_bus.value) >= 1, "agent_bus_search should find message");

    let replay = router.call("history_bus_replay", map{ path: ".mint-mcp/agent-bus.jsonl", agent: "test-agent", limit: 20 });
    assert_true(replay.ok == true and len(replay.value) >= 1, "history_bus_replay should read bus JSONL");

    let tmpl = router.call("mcp_prompt_template_validate", map{ template: "Hello {name}", variables: ["name"] });
    assert_true(tmpl.ok == true and tmpl.value.ok == true, "mcp_prompt_template_validate");

    let prop = router.call("consensus_propose", map{ from_agent: "test-agent", title: "port test", options: ["yes", "no"] });
    assert_true(prop.ok == true and prop.value.proposal_id != "", "consensus_propose should create proposal");

    let vote = router.call("consensus_vote", map{ proposal_id: prop.value.proposal_id, agent: "test-agent", option: "yes" });
    assert_true(vote.ok == true and vote.value.option == "yes", "consensus_vote should record vote");

    let tally = router.call("consensus_tally", map{ proposal_id: prop.value.proposal_id });
    assert_true(tally.ok == true and tally.value.votes.yes == 1, "consensus_tally should count yes vote");

    let path_env = router.call("system_env_get", map{ name: "PATH" });
    assert_true(path_env.ok == true and path_env.value.name == "PATH", "system_env_get should return named env result");

    let slash = router.call("app_slash_command_expand", map{ command: "/review security" });
    assert_true(slash.ok == true and slash.value.command == "/review", "app_slash_command_expand should expand review");

    let cap = router.call("app_capability_search", map{ query: "codex" });
    assert_true(cap.ok == true and cap.value.count >= 1, "app_capability_search should find codex-like entries");

    let wf = router.call("workflow_template_generate", map{ kind: "coding-ci" });
    assert_true(wf.ok == true and len(wf.value.nodes) == 3, "workflow_template_generate coding-ci");

    let wv = router.call("workflow_validate", map{ workflow: wf.value });
    assert_true(wv.ok == true and wv.value.ok == true, "workflow_validate generated workflow");

    let we = router.call("workflow_execution_plan", map{ workflow: wf.value });
    assert_true(we.ok == true and we.value.ok == true and we.value.ordered_count == 3, "workflow_execution_plan generated workflow");

    let diff_text = "diff --git a/src/lib.rs b/src/lib.rs\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@\n+fn new_secret() { let token = \"x\"; }\n";
    let rr = router.call("review_diff_risk", map{ diff: diff_text });
    assert_true(rr.ok == true and rr.value.risk != "low", "review_diff_risk should flag secret-like diff");

    let mt = router.call("review_missing_tests", map{ diff: diff_text });
    assert_true(mt.ok == true and mt.value.missing_tests_likely == true, "review_missing_tests should flag code without tests");

    let sleep = router.call("server_sleep", map{ duration_ms: 1 });
    assert_true(sleep.ok == true and sleep.value.slept_ms >= 0, "server_sleep should return bounded result");

    let wait_path = router.call("wait_for_path", map{ path: "README.md", timeout_ms: 5 });
    assert_true(wait_path.ok == true and wait_path.value.exists == true, "wait_for_path should find README");

    let finfo = router.call("file_info", map{ path: "README.md" });
    assert_true(finfo.ok == true and finfo.value.kind == "file", "file_info should identify README");

    let fstats = router.call("file_stats", map{ path: "README.md", max_chars: 2000 });
    assert_true(fstats.ok == true and fstats.value.lines > 1, "file_stats should count README lines");

    let batch = router.call("batch_file_info", map{ paths: ["README.md", "main.sapp"] });
    assert_true(batch.ok == true and len(batch.value) == 2, "batch_file_info should return two rows");

    let repo_file = router.call("repository_get_file_content", map{ path: "README.md", max_chars: 20 });
    assert_true(repo_file.ok == true and len(repo_file.value.content) > 5, "repository_get_file_content should read working tree file");

    let checksum = router.call("sandbox_checksum", map{ path: "README.md" });
    assert_true(checksum.ok == true and checksum.value.algorithm == "sha256" and len(checksum.value.hash) > 10, "sandbox_checksum sha256");

    let shell_safe = router.call("shell_command_safety_check", map{ command: "rm -rf /tmp/x && curl http://example.com" });
    assert_true(shell_safe.ok == true and shell_safe.value.risk == "high", "shell_command_safety_check should flag risky command");

    let shell_tx = router.call("shell_command_translate", map{ intent: "list files", target: "powershell" });
    assert_true(shell_tx.ok == true and shell_tx.value.shell == "powershell", "shell_command_translate powershell");

    let neural = router.call("neural_embed_cosine", map{ vec_a: [1, 0], vec_b: [1, 0] });
    assert_true(neural.ok == true and neural.value.similarity == 1, "neural_embed_cosine identical vectors");

    let tensor = router.call("neural_tensor_stats", map{ values: [1, 2, 3, 4] });
    assert_true(tensor.ok == true and tensor.value.stats.mean == 2.5, "neural_tensor_stats mean");

    let tok = router.call("ml_token_count", map{ text: "abcdefghijkl" });
    assert_true(tok.ok == true and tok.value.token_count >= 3, "ml_token_count fallback");

    let ds = router.call("ml_dataset_validate", map{ text: "{\"prompt\":\"hi\"}\n{\"bad\":true}\nnot-json\n" });
    assert_true(ds.ok == true and ds.value.ok == false and len(ds.value.issues) >= 2, "ml_dataset_validate should flag invalid records");

    let ppl = router.call("ml_perplexity_score", map{ text: "hello world. hello pblang." });
    assert_true(ppl.ok == true and ppl.value.lower_is_better == true, "ml_perplexity_score should return local estimate");

    let ft = router.call("ml_fine_tune_prep", map{ conversations: [map{ prompt: "hi", completion: "hello" }], format: "llama" });
    assert_true(ft.ok == true and ft.value.records == 1 and str_contains(ft.value.text, "hello"), "ml_fine_tune_prep should emit JSONL text");

    let bench = router.call("ml_benchmark_model", map{ model: "demo", prompt: "abc", iterations: 2 });
    assert_true(bench.ok == true and bench.value.executed == false and bench.value.iterations == 2, "ml_benchmark_model should return plan");

    let gguf = router.call("ml_convert_to_gguf", map{ model_path: "model.safetensors", output_path: "model.gguf" });
    assert_true(gguf.ok == true and gguf.value.executed == false and gguf.value.output_path == "model.gguf", "ml_convert_to_gguf should return plan");

    let infer = router.call("neural_inference", map{ model_path: "model.onnx", input_json: map{ input: [1, 2] } });
    assert_true(infer.ok == true and infer.value.executed == false and len(infer.value.input_keys) == 1, "neural_inference should return plan");

    let cargo_plan = router.call("project_cargo_test", map{ workspace: true, package: "pb-mcp-server", no_run: true });
    assert_true(cargo_plan.ok == true and cargo_plan.value.program == "cargo" and cargo_plan.value.executed == false, "project_cargo_test should return argv plan");

    let py_plan = router.call("project_pytest", map{ test_path: "tests", keyword: "smoke", maxfail: 1 });
    assert_true(py_plan.ok == true and py_plan.value.program == "pytest" and py_plan.value.argv[0] == "tests", "project_pytest should return argv plan");

    let api_private = router.call("web_api_call", map{ url: "http://127.0.0.1:8080/status" });
    assert_true(api_private.ok == true and api_private.value.ok == false and api_private.value.ssrf_private_host == true, "web_api_call should flag private host");

    let search_web = router.call("web_search", map{ query: "pblang pbai" });
    assert_true(search_web.ok == true and str_contains(search_web.value.url, "pblang+pbai"), "web_search should build search URL");

    let arxiv = router.call("research_arxiv_search", map{ query: "transformer", max_results: 5 });
    assert_true(arxiv.ok == true and str_contains(arxiv.value.url, "max_results=5"), "research_arxiv_search should build arXiv API URL");

    let arxiv_dl = router.call("research_arxiv_download", map{ id: "1706.03762" });
    assert_true(arxiv_dl.ok == true and str_contains(arxiv_dl.value.url, "1706.03762.pdf"), "research_arxiv_download should build PDF URL");

    let desktop = router.call("notify_desktop", map{ title: "pb", message: "done" });
    assert_true(desktop.ok == true and desktop.value.executed == false, "notify_desktop should return plan");

    let webhook = router.call("notify_webhook", map{ url: "https://example.com/hook", payload: map{ ok: true } });
    assert_true(webhook.ok == true and webhook.value.ssrf_private_host == false and len(webhook.value.payload_keys) == 1, "notify_webhook should validate payload");

    let audio = router.call("audio_info", map{ path: "README.md" });
    assert_true(audio.ok == true and audio.value.executed == false and audio.value.program == "ffprobe", "audio_info should return ffprobe plan");

    let trim = router.call("audio_trim", map{ path: "README.md", start: 2, duration: 5, output_path: "clip.wav" });
    assert_true(trim.ok == true and trim.value.output_path == "clip.wav" and trim.value.extra.duration == 5, "audio_trim should return bounded plan");

    let image = router.call("image_resize", map{ path: "README.md", width: 320, height: 240, output_path: "out.png" });
    assert_true(image.ok == true and image.value.program == "convert" and image.value.extra.geometry == "320x240", "image_resize should return ImageMagick plan");

    let exif = router.call("image_extract_exif", map{ path: "README.md" });
    assert_true(exif.ok == true and exif.value.extra.metadata_only == true, "image_extract_exif should be metadata plan");

    let langs = router.call("ocr_list_languages", map{});
    assert_true(langs.ok == true and langs.value.program == "tesseract", "ocr_list_languages should return tesseract plan");

    let ocr = router.call("ocr_with_confidence", map{ path: "README.md", lang: "eng" });
    assert_true(ocr.ok == true and ocr.value.extra.mode == "confidence-tsv", "ocr_with_confidence should request TSV confidence mode");

    let shot = router.call("screenshot_region", map{ x: 1, y: 2, width: 300, height: 200, output_path: ".mint-mcp/screenshots/test.png" });
    assert_true(shot.ok == true and shot.value.extra.geometry == "300x200+1+2", "screenshot_region should build geometry");

    let monitors = router.call("screenshot_monitor_info", map{});
    assert_true(monitors.ok == true and monitors.value.program == "xrandr", "screenshot_monitor_info should return xrandr plan");

    let speech_models = router.call("speech_list_models", map{});
    assert_true(speech_models.ok == true and speech_models.value.family == "speech", "speech_list_models should return speech plan");

    let tts = router.call("speech_text_to_speech", map{ text: "hello", output_path: "voice.wav" });
    assert_true(tts.ok == true and tts.value.output_path == "voice.wav" and tts.value.extra.voice == "default", "speech_text_to_speech should return TTS plan");

    let ping = router.call("net_ping", map{ host: "example.com", count: 2 });
    assert_true(ping.ok == true and ping.value.program == "ping" and ping.value.executed == false, "net_ping should return ping plan");

    let ports = router.call("net_port_scan", map{ host: "127.0.0.1", start_port: 20, end_port: 25 });
    assert_true(ports.ok == true and ports.value.extra.private_host == true and ports.value.extra.end_port == 25, "net_port_scan should flag private host");

    let mqtt = router.call("net_mqtt_publish", map{ broker: "mqtt.example.com", topic: "pb/test", message: "hello" });
    assert_true(mqtt.ok == true and mqtt.value.extra.topic == "pb/test" and mqtt.value.extra.payload_bytes == 5, "net_mqtt_publish should return MQTT plan");

    let i2c = router.call("iot_i2c_scan", map{ bus: 1 });
    assert_true(i2c.ok == true and i2c.value.program == "i2cdetect" and i2c.value.extra.bus == 1, "iot_i2c_scan should return i2cdetect plan");

    let gpio = router.call("iot_gpio_write", map{ pin: 17, value: 1 });
    assert_true(gpio.ok == true and gpio.value.extra.pin == 17 and gpio.value.extra.value == 1, "iot_gpio_write should return GPIO plan");

    let rentropy = router.call("re_entropy", map{ path: "README.md", max_chars: 1000 });
    assert_true(rentropy.ok == true and rentropy.value.entropy_bits_per_char > 0, "re_entropy should compute local entropy");

    let rstrings = router.call("re_strings", map{ path: "README.md", min_len: 6, limit: 5 });
    assert_true(rstrings.ok == true and len(rstrings.value.strings) >= 1, "re_strings should extract printable strings");

    let rpat = router.call("re_pattern_search", map{ path: "README.md", pattern: "pblang", limit: 10 });
    assert_true(rpat.ok == true and rpat.value.match_count >= 1, "re_pattern_search should find literal pattern");

    let rhex = router.call("re_hexdump", map{ path: "README.md", offset: 0, length: 16 });
    assert_true(rhex.ok == true and rhex.value.program == "xxd" and rhex.value.extra.length == 16, "re_hexdump should return xxd plan");

    let sx = router.call("sandbox_exec", map{ program: "python3", argv: ["--version"] });
    assert_true(sx.ok == true and sx.value.executed == false and sx.value.program == "python3", "sandbox_exec should return execution plan");

    let snet = router.call("sandbox_network_request", map{ url: "http://127.0.0.1:8000/" });
    assert_true(snet.ok == true and snet.value.ok == false and snet.value.ssrf_private_host == true, "sandbox_network_request should block private host");

    let trun = router.call("terminal_run", map{ program: "git", argv: ["status"] });
    assert_true(trun.ok == true and trun.value.executed == false and trun.value.blocked == true, "terminal_run should be planned/gated");

    let ollama = router.call("ollama_list_models", map{});
    assert_true(ollama.ok == true and ollama.value.executed == false and ollama.value.blocked == true, "ollama_list_models should be gated plan");

    let sdiff = router.call("sandbox_diff", map{ text_a: "a\nb", text_b: "a\nc" });
    assert_true(sdiff.ok == true and sdiff.value.change_count == 2, "sandbox_diff should report changed line");

    let secrets = router.call("protect_secret_scan", map{ text: "OPENAI_API_KEY=sk-test-secret" });
    assert_true(secrets.ok == true and secrets.value.ok == false and len(secrets.value.hits) >= 1, "protect_secret_scan should flag secret text");

    let reput = router.call("protect_file_reputation", map{ path: "README.md", known_bad_hashes: [] });
    assert_true(reput.ok == true and reput.value.external_lookup == false, "protect_file_reputation should be local-only");

    let integ = router.call("protect_integrity_check", map{ paths: ["README.md"] });
    assert_true(integ.ok == true and integ.value.mode == "manifest-generated", "protect_integrity_check should generate manifest");

    let yara = router.call("protect_yara_scan", map{ text: "hello suspicious marker", rules: [map{ name: "marker", pattern: "suspicious" }] });
    assert_true(yara.ok == true and yara.value.ok == false and len(yara.value.hits) == 1, "protect_yara_scan fallback should match string rule");

    let av = router.call("protect_scan_file", map{ text: "X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*" });
    assert_true(av.ok == true and av.value.ok == false, "protect_scan_file should flag EICAR marker");

    let term = router.call("terminal_which", map{ program: "git" });
    assert_true(term.ok == true and term.value.blocked == true, "terminal_which should be gated when terminal env is disabled");

    let mcp_src_dir = if fs_exists("editors/ide/tools/mcpservers/pb-mcp-server/src") { "editors/ide/tools/mcpservers/pb-mcp-server/src" } else { "src" };
    let cbuild = router.call("code_index_build", map{ dir: mcp_src_dir, max_entries: 80, max_depth: 1, sample_chars: 20000 });
    assert_true(cbuild.ok == true and cbuild.value.ok == true and cbuild.value.file_count > 0, "code_index_build should write pblang index");

    let cstatus = router.call("code_index_status", map{});
    assert_true(cstatus.ok == true and cstatus.value.exists == true and cstatus.value.ok == true, "code_index_status should see built index");

    let csearch = router.call("code_index_search", map{ query: "call_", limit: 20 });
    assert_true(csearch.ok == true and csearch.value.ok == true and len(csearch.value.matches) > 0, "code_index_search should find call symbols");

    let cpaths = router.call("code_index_path_substring", map{ query: "tools", limit: 20 });
    assert_true(cpaths.ok == true and len(cpaths.value) > 0, "code_index_path_substring should find tool files");

    let csym = router.call("code_index_symbol_prefix", map{ prefix: "call_" });
    assert_true(csym.ok == true and len(csym.value) > 0, "code_index_symbol_prefix should find call_ symbols");

    let cagg = router.call("code_index_aggregate_stats", map{ limit: 5 });
    assert_true(cagg.ok == true and cagg.value.ok == true and cagg.value.symbols > 0, "code_index_aggregate_stats should count symbols");

    let chist = router.call("code_index_extension_histogram", map{});
    assert_true(chist.ok == true and chist.value.sapp > 0, "code_index_extension_histogram should count sapp files");

    let manifest = router.call("codebase_manifest_write", map{ dir: mcp_src_dir, max_entries: 20, max_depth: 1 });
    assert_true(manifest.ok == true and manifest.value.ok == true and manifest.value.files > 0, "codebase_manifest_write should write manifest");

    let packed = router.call("pack_context", map{ segments: ["alpha", "beta"], segment_labels: ["A", "B"], max_chars: 200 });
    assert_true(packed.ok == true and packed.value.packed_segments == 2 and str_contains(packed.value.text, "## A"), "pack_context should label segments");

    let ask = router.call("ask_agents", map{ from_agent: "test-agent", question: "status?", topic: "pb-mcp-ask-test" });
    assert_true(ask.ok == true and ask.value.topic == "pb-mcp-ask-test", "ask_agents should post question to bus");

    let trace = router.call("debug_trace_run", map{ program: "pblang", argv: ["run"], output: "error: file not found", exit_code: 1 });
    assert_true(trace.ok == true and trace.value.status == "recorded", "debug_trace_run should record supplied output");

    let rootcause = router.call("debug_root_cause_report", map{ trace_id: trace.value.id });
    assert_true(rootcause.ok == true and rootcause.value.cluster == "not-found", "debug_root_cause_report should classify not-found");

    let clusters = router.call("debug_failure_cluster", map{});
    assert_true(clusters.ok == true and len(clusters.value) >= 1, "debug_failure_cluster should return clusters");

    let refs = router.call("ide_find_references", map{ symbol: "call", path: mcp_src_dir, max_matches: 10 });
    assert_true(refs.ok == true and refs.value.total_returned >= 1, "ide_find_references should use pblang grep");

    let defs = router.call("ide_goto_definition", map{ symbol: "call", path: mcp_src_dir, max_matches: 10 });
    assert_true(defs.ok == true and defs.value.total_returned >= 1, "ide_goto_definition should find router call");

    let open_plan = router.call("vscode_open_file", map{ path: "README.md", line: 2 });
    assert_true(open_plan.ok == true and open_plan.value.executed == false and open_plan.value.editor == "code", "vscode_open_file should return command plan");

    let zed_ctx = router.call("zed_context_attach", map{ path: "README.md" });
    assert_true(zed_ctx.ok == true and zed_ctx.value.context_reference == "@README.md", "zed_context_attach should return context reference");

    let jb = router.call("jetbrains_lsp_code_action", map{ path: "README.md", line: 1, action: "inspect" });
    assert_true(jb.ok == true and jb.value.executed == false, "jetbrains_lsp_code_action should be planned");

    let zc = router.call("ai_zero_shot_classify", map{ text: "fix a rust security bug", labels: ["security", "design"] });
    assert_true(zc.ok == true and zc.value.label == "security", "ai_zero_shot_classify should choose matching label");

    let fsclass = router.call("ai_few_shot_classify", map{ text: "panic in parser", examples: [map{ text: "panic crash bug", label: "bug" }, map{ text: "blue green palette", label: "design" }] });
    assert_true(fsclass.ok == true and fsclass.value.label == "bug", "ai_few_shot_classify should choose example label");

    let search = router.call("ai_semantic_search", map{ query: "pblang model", documents: ["rust server", "pblang model training"], limit: 1 });
    assert_true(search.ok == true and search.value[0].index == 1, "ai_semantic_search should rank lexical match");

    let extract = router.call("ai_structured_extract", map{ text: "name: pbAI\nkind: llm", fields: ["name", "kind"] });
    assert_true(extract.ok == true and extract.value.data.name == "pbAI", "ai_structured_extract should parse key value text");

    let verify = router.call("ai_verify_factual", map{ claim: "pbAI uses pblang", references: ["pbAI uses pblang for native tools"] });
    assert_true(verify.ok == true and verify.value.verdict == "supported", "ai_verify_factual should find supporting reference");

    let embed = router.call("ai_embed_text", map{ text: "alpha beta alpha", dimensions: 8 });
    assert_true(embed.ok == true and len(embed.value.embedding) == 8, "ai_embed_text should return fixed vector");

    let qsim = router.call("quantum_circuit_simulate", map{ qasm: "qreg q[1];\nh q[0];" });
    assert_true(qsim.ok == true and len(qsim.value.probabilities) == 2, "quantum_circuit_simulate should return probabilities");

    let grover = router.call("quantum_grover_search", map{ size: 4, marked_index: 2 });
    assert_true(grover.ok == true and grover.value.marked_index == 2, "quantum_grover_search should keep marked index");

    let shor = router.call("quantum_shor_factor", map{ n: 21 });
    assert_true(shor.ok == true and shor.value.factors[0] == 3, "quantum_shor_factor fallback should factor 21");
}

fn run_part_2() {
    let wait_plan = router.call("agent_inbox_wait", map{ for_agent: "receiver-agent", timeout_ms: 5 });
    assert_true(wait_plan.ok == true and wait_plan.value.executed == false, "agent_inbox_wait should be native planned wait");

    let sync_plan = router.call("agent_sync_all_tool", map{ mode: "test" });
    assert_true(sync_plan.ok == true and sync_plan.value.sync_id != "", "agent_sync_all_tool should record sync plan");

    let think_append = router.call("thinking_session_append", map{ text: "semantic test thought" });
    assert_true(think_append.ok == true and think_append.value.appended == true, "thinking_session_append should append log");

    let think_read = router.call("thinking_session_read", map{ limit: 5 });
    assert_true(think_read.ok == true and think_read.value.count >= 1, "thinking_session_read should read log");

    let ollama_gen = router.call("ai_ollama_generate", map{ model: "demo", prompt: "hello" });
    assert_true(ollama_gen.ok == true and ollama_gen.value.executed == false, "ai_ollama_generate should return plan");

    let roman = router.call("algo_roman_numeral", map{ value: 42 });
    assert_true(roman.ok == true and roman.value.roman == "XLII", "algo_roman_numeral should convert 42");

    let confusion = router.call("algo_confusion_matrix", map{ expected: ["a", "b"], predicted: ["a", "a"] });
    assert_true(confusion.ok == true and confusion.value.total == 2, "algo_confusion_matrix should summarize labels");

    let bloom = router.call("algo_bloom_filter", map{ items: ["alpha"], query: "alpha", size: 100 });
    assert_true(bloom.ok == true and bloom.value.probable_member == true, "algo_bloom_filter should query hash");

    let lang = router.call("code_detect_language", map{ path: "main.sapp" });
    assert_true(lang.ok == true and lang.value.language == "pblang", "code_detect_language should classify sapp");

    let cat_path = if fs_exists("src/catalog.sapp") { "src/catalog.sapp" } else { "editors/ide/tools/mcpservers/pb-mcp-server/src/catalog.sapp" };
    let imports = router.call("code_extract_imports", map{ path: cat_path });
    assert_true(imports.ok == true and imports.value.count >= 1, "code_extract_imports should find imports");

    let csv = router.call("data_csv_analyze", map{ text: "a,b\n1,2\n" });
    assert_true(csv.ok == true and csv.value.columns == 2, "data_csv_analyze should count header columns");

    let sqlite = router.call("db_sqlite_query", map{ path: "test.sqlite", query: "select 1" });
    assert_true(sqlite.ok == true and sqlite.value.executed == false, "db_sqlite_query should return sqlite plan");

    let dedupe = router.call("file_deduplicate", map{ paths: ["README.md", "README.md"] });
    assert_true(dedupe.ok == true and dedupe.value.duplicate_count >= 1, "file_deduplicate should find duplicate paths");

    let git_write = router.call("git_push", map{});
    assert_true(git_write.ok == true and git_write.value.executed == false and git_write.value.extra.remote_possible == true, "git_push should return gated plan");

    let sys_kill = router.call("sys_process_kill", map{ name: "demo" });
    assert_true(sys_kill.ok == true and sys_kill.value.executed == false, "sys_process_kill should return gated plan");

    let pbai_disp = router.call("pbai_intent_and_skill_dispatch", map{ prompt: "Explain fn add(a, b) { return a + b; }" });
    assert_true(pbai_disp.ok == true and pbai_disp.value.ok == true and pbai_disp.value.prompt_safe == true, "pbai_intent_and_skill_dispatch should run embedded pbAI MLP and skills");

    let dual_bridge = router.call("pbai_embedded_vs_standalone_bridge", map{});
    assert_true(dual_bridge.ok == true and dual_bridge.value.ok == true and dual_bridge.value.components.pbai.standalone_repository.sapp_modules == 309, "pbai_embedded_vs_standalone_bridge should report dual architecture");

    let pg_mig = router.call("pbai_polyglot_migrate", map{ lang: "python", code: "def add(a, b):\n    return a + b" });
    assert_true(pg_mig.ok == true and pg_mig.value.ok == true and pg_mig.value.sandbox_guarded == true, "pbai_polyglot_migrate should convert polyglot block");

    let sc_aud = router.call("pbai_supply_chain_and_taint_audit", map{ source: "let x = 10;\nprint x;", manifest_toml: "[package]\nname = \"clean_pkg\"\nversion = \"1.0.0\"\n" });
    assert_true(sc_aud.ok == true and sc_aud.value.ok == true and sc_aud.value.supply_chain_safe == true, "pbai_supply_chain_and_taint_audit should verify clean code and manifest");

    let ide_os = router.call("pbide_all_os_device_editions", map{ theme: "obsidian_aurora_glass" });
    assert_true(ide_os.ok == true and ide_os.value.ok == true and ide_os.value.os_target_count == 10 and ide_os.value.device_class_count == 8, "pbide_all_os_device_editions should return 10 OS targets and 8 device classes");

    let ide_pf = router.call("pbide_polyform_14target_designer", map{});
    assert_true(ide_pf.ok == true and ide_pf.value.ok == true and ide_pf.value.compiled_target_count >= 14, "pbide_polyform_14target_designer should compile 14+ targets");

    let ide_ma = router.call("pbide_multi_arch_matrix", map{});
    assert_true(ide_ma.ok == true and ide_ma.value.ok == true, "pbide_multi_arch_matrix should verify 8-bit to 64-bit matrix");

    let ide_sh = router.call("pbide_self_heal_and_rope_engine", map{});
    assert_true(ide_sh.ok == true and ide_sh.value.ok == true, "pbide_self_heal_and_rope_engine should verify rope, SMT contract, and e-graph");

    let pbai_bpv = router.call("pbai_brain_planner_verifier", map{ goal: "Compile and verify module", target_os: "linux", target_device: "desktop_workstation" });
    assert_true(pbai_bpv.ok == true and pbai_bpv.value.ok == true and pbai_bpv.value.dag_step_count == 4, "pbai_brain_planner_verifier should return 4-step verified DAG");

    let pbai_deq = router.call("pbai_deq_and_lora_trainer", map{ prompt: "optimize fixed-point pipeline", feedback_reward: 1.0, lora_rank: 8 });
    assert_true(pbai_deq.ok == true and pbai_deq.value.ok == true and pbai_deq.value.continual_online_lora.ewc_forgetting_shield_active == true, "pbai_deq_and_lora_trainer should run DEQ and continual LoRA");

    let pbai_rag = router.call("pbai_rag_memory_and_grounding", map{ query: "capability sandboxing", top_k: 3 });
    assert_true(pbai_rag.ok == true and pbai_rag.value.ok == true and pbai_rag.value.hallucination_rate == 0.0, "pbai_rag_memory_and_grounding should return 3-tier memory and 0 hallucination");

    let pbai_bpe = router.call("pbai_bpe_quant_and_tool_broker", map{ text: "fn add(a: int, b: int) -> int { return a + b; }", target_tool: "pbide_all_os_device_editions" });
    assert_true(pbai_bpe.ok == true and pbai_bpe.value.ok == true and pbai_bpe.value.compression_ratio_x == 4.0, "pbai_bpe_quant_and_tool_broker should quantize INT8 and broker tool");

    let mcp_lazy = router.call("pb_mcp_lazy_router_telemetry", map{});
    assert_true(mcp_lazy.ok == true and mcp_lazy.value.ok == true and mcp_lazy.value.total_registered_tools == 1184 and mcp_lazy.value.total_tool_modules == 98, "pb_mcp_lazy_router_telemetry should report 1184 registered tools across 98 modules");

    let mcp_148 = router.call("pb_mcp_sealed_offline_148_bridge", map{});
    assert_true(mcp_148.ok == true and mcp_148.value.ok == true and mcp_148.value.embedded_mcp_server.total_tools == 1184 and mcp_148.value.standalone_sealed_offline_server.sealed_offline_tools == 148, "pb_mcp_sealed_offline_148_bridge should bridge 1184 embedded tools with 148 sealed offline tools");

    let mcp_rea = router.call("pb_mcp_rea_and_cleanroom_suite", map{});
    assert_true(mcp_rea.ok == true and mcp_rea.value.ok == true, "pb_mcp_rea_and_cleanroom_suite should run REA binary audit and Cleanroom gate");

    let mcp_comp = router.call("pb_mcp_pblang_compiler_live_suite", map{});
    assert_true(mcp_comp.ok == true and mcp_comp.value.ok == true, "pb_mcp_pblang_compiler_live_suite should run self-healing advisor, Stage-2 emit, and HIL verifier");

    let rea_bin = router.call("rea_binary_audit", map{ spec_json: "{\"hex\":\"7f454c46020101000000000000000000\",\"name\":\"sample.elf\"}" });
    assert_true(rea_bin.ok == true and rea_bin.value.ok == true, "rea_binary_audit should run via embedded router");

    let omni_sup = router.call("pblang_omni_supremacy_engine", map{ spec_json: "{}" });
    assert_true(omni_sup.ok == true and omni_sup.value.ok == true, "pblang_omni_supremacy_engine should run via embedded router");

    // Autonomous PBAI v3.0.0-embedded suites
    let pbai_mtr = router.call("pbai_multi_tier_model_router", map{ prompt: "Synthesize formal contract and multi-file refactor", device_class: "desktop-workstation", latency_budget_ms: 45 });
    assert_true(pbai_mtr.ok == true and pbai_mtr.value.ok == true and pbai_mtr.value.moe_routing.active_experts_per_token == 2, "pbai_multi_tier_model_router should route top-2 out of 8 MoE experts");

    let pbai_dlp = router.call("pbai_ruler_immune_and_dlp_shield", map{ payload_text: "let token = \"ghp_secret123456\";" });
    assert_true(pbai_dlp.ok == true and pbai_dlp.value.ok == true and pbai_dlp.value.dlp_guard.raw_secrets_leaked == 0 and pbai_dlp.value.quarantined == false, "pbai_ruler_immune_and_dlp_shield should scrub secrets and pass clean code");

    let pbai_evo = router.call("pbai_self_evolution_proposal_bridge", map{ proposal_id: "evolve-lora-007", baseline_accuracy: 0.91, candidate_accuracy: 0.95, safety_regression_count: 0, latency_overhead_pct: 1.0 });
    assert_true(pbai_evo.ok == true and pbai_evo.value.ok == true and pbai_evo.value.admitted == true and pbai_evo.value.reversible_checkpoint.o1_instant_rollback_ready == true, "pbai_self_evolution_proposal_bridge should admit verified improvement with O(1) rollback");

    let pbai_ref = router.call("pbai_live_ide_refactor_and_codegen", map{ target_symbol: "compile_polyform_widget", refactor_kind: "extract_contract_guarded_function", files: ["src/ui.sapp", "tests/ui_test.sapp"] });
    assert_true(pbai_ref.ok == true and pbai_ref.value.ok == true and pbai_ref.value.affected_file_count == 2, "pbai_live_ide_refactor_and_codegen should plan rope refactor and synthesize tests");

    // Newly ported quantitative, data-table, neural, and connectivity tools
    let fin_res = router.call("fin_add", map{ a: "12.50", b: "7.25" });
    assert_true(fin_res.ok == true and fin_res.value.result == "19.75", "fin_add should compute exact decimal sum");

    let prob_res = router.call("prob_combinations", map{ n: 5, k: 2 });
    assert_true(prob_res.ok == true and prob_res.value.result == 10, "prob_combinations should compute 5C2 == 10");

    let ts_res = router.call("ts_cumsum", map{ data: [1, 2, 3, 4] });
    assert_true(ts_res.ok == true and len(ts_res.value.result) == 4, "ts_cumsum should compute cumulative sum");

    let csv_tbl = router.call("data_table_from_csv", map{ text: "name,score\nalpha,10\nbeta,20" });
    assert_true(csv_tbl.ok == true and csv_tbl.value.row_count == 3, "data_table_from_csv should parse CSV into sheet document");

    let nfc_enc = router.call("nfc_text_encode", map{ language: "en", text: "PBLang" });
    assert_true(nfc_enc.ok == true and nfc_enc.value.size_bytes > 0 and nfc_enc.value.device_accessed == false, "nfc_text_encode should encode NDEF text record");

    let mcu_cat = router.call("microcontroller_catalog", map{});
    assert_true(mcu_cat.ok == true and len(mcu_cat.value.boards) >= 1 and mcu_cat.value.device_opened == false, "microcontroller_catalog should list supported MCUs");

    let emb_feat = router.call("ai_embed_features", map{ text: "PBLang native IDE and MCP", dimensions: 16 });
    assert_true(emb_feat.ok == true and len(emb_feat.value.vector) == 16, "ai_embed_features should compute L2-normalized trigram vector");

    let smax = router.call("neural_softmax", map{ logits: [1.0, 2.0, 3.0] });
    assert_true(smax.ok == true and len(smax.value.probabilities) == 3, "neural_softmax should compute normalized probabilities");

    // Embedded PBAI v4.0.0 Multimodal, Swarm, Neuro-Symbolic & Federated suites
    let pbai_mm = router.call("pbai_multimodal_sketch_and_vision_bridge", map{ sketch: "[Header: Toolbar]\n[Sidebar: Tree] [Main: DataGrid | Chart]\n[Footer: Status]" });
    assert_true(pbai_mm.ok == true and pbai_mm.value.ok == true and pbai_mm.value.polyform_target_count == 14 and pbai_mm.value.wcag_aaa_verified == true, "pbai_multimodal_sketch_and_vision_bridge should synthesize 14-target PolyForm UI with WCAG AAA");

    let pbai_sw = router.call("pbai_multi_agent_swarm_orchestrator", map{ objective: "Verify embedded PBIDE + PBAI + PB-MCP integration", max_total_tokens: 8192 });
    assert_true(pbai_sw.ok == true and pbai_sw.value.ok == true and pbai_sw.value.consensus_reached == true and pbai_sw.value.deadlock_free == true, "pbai_multi_agent_swarm_orchestrator should reach quorum consensus without deadlock");

    let pbai_ns = router.call("pbai_neuro_symbolic_smt_and_egraph_prover", map{ expression: "((x * 2) / 2) + (y - y) + (z * 1) + 0" });
    assert_true(pbai_ns.ok == true and pbai_ns.value.ok == true and pbai_ns.value.smt_verification_status == "UNSAT_NEGATION_PROVED" and pbai_ns.value.egraph_rewrite_count >= 3, "pbai_neuro_symbolic_smt_and_egraph_prover should optimize expression via E-Graph and prove SMT invariants");

    let pbai_fed = router.call("pbai_offline_federated_and_checkpoint_sync", map{ dp_clip_norm: 1.0 });
    assert_true(pbai_fed.ok == true and pbai_fed.value.ok == true and pbai_fed.value.accepted_count == 3 and pbai_fed.value.stdlib_lock_preserved == true, "pbai_offline_federated_and_checkpoint_sync should merge federated deltas while preserving stdlib lock");

    let pbai_v4s = router.call("pbai_v4_capabilities_status", map{});
    assert_true(pbai_v4s.ok == true and pbai_v4s.value.ok == true and pbai_v4s.value.version == "4.0.0-embedded", "pbai_v4_capabilities_status should report 4.0.0-embedded");

    // Embedded PBAI v5.0.0 Specialist Taxonomy, 4-Axis Ideal-NN Regularizer, Hardware Accel & 44-Module Core Hub
    let pbai_inn = router.call("pbai_ideal_nn_4axis_regularizer", map{ steps: 4 });
    assert_true(pbai_inn.ok == true and pbai_inn.value.ok == true and pbai_inn.value.monotonically_converging == true and pbai_inn.value.axes.spectral_orthogonality_defect_after_ns < pbai_inn.value.axes.spectral_orthogonality_defect_before, "pbai_ideal_nn_4axis_regularizer should verify all 4 mathematical axes and Newton-Schulz improvement");

    let pbai_tax = router.call("pbai_specialist_taxonomy_and_catalog", map{ domain: "compiler-verification", task: "polyform-ast-synthesis" });
    assert_true(pbai_tax.ok == true and pbai_tax.value.ok == true and pbai_tax.value.training_team.distinct_principals_required == true and pbai_tax.value.taxonomy_status.arbitrary_nested_subcategories == true, "pbai_specialist_taxonomy_and_catalog should verify distinct principals and arbitrary depth taxonomy");

    let pbai_acc = router.call("pbai_hardware_accel_and_training_budget", map{ intensity: "balanced", examples: 256 });
    assert_true(pbai_acc.ok == true and pbai_acc.value.ok == true and pbai_acc.value.admitted == true and pbai_acc.value.worker_plan.workers >= 1, "pbai_hardware_accel_and_training_budget should allocate workers and admit training budget");

    let pbai_dist = router.call("pbai_curriculum_and_distillation_studio", map{ teacher_logits: [2.4, 1.1, 0.2, -0.8], student_logits: [2.1, 1.0, 0.3, -0.6], temperature: 2.0 });
    assert_true(pbai_dist.ok == true and pbai_dist.value.ok == true and pbai_dist.value.curriculum_stage_count == 4 and pbai_dist.value.temperature_scaled_distillation_loss >= 0.0, "pbai_curriculum_and_distillation_studio should run 4-stage curriculum and soft KL distillation");

    let pbai_44 = router.call("pbai_core_44module_inventory_and_health", map{});
    assert_true(pbai_44.ok == true and pbai_44.value.ok == true and pbai_44.value.embedded_core_module_count == 44 and pbai_44.value.stdlib_lock_preserved == true, "pbai_core_44module_inventory_and_health should confirm all 44 embedded PBAI core modules");

    // Newly ported Computer-Use (20 tools), Desktop/Device/Remote (30 tools), Security (7 tools), Documentation (2 tools), and 4 Sibling MCP Families (35 tools)
    let cu_prof = router.call("computer_use_profile", map{});
    assert_true(cu_prof.ok == true and cu_prof.value.effect_performed == false and cu_prof.value.native_pblang == true, "computer_use_profile should return read-only computer use profile");

    let dd_prof = router.call("desktop_platform_profile", map{});
    assert_true(dd_prof.ok == true and dd_prof.value.portable_contract == true and type(dd_prof.value.platform) == "string", "desktop_platform_profile should return host platform profile");

    let sec_red = router.call("sec_redact", map{ text: "token=sk-1234567890abcdefghijklmnop" });
    assert_true(sec_red.ok == true and type(sec_red.value.redacted) == "string", "sec_redact should redact sensitive token");

    let sec_ent = router.call("sec_entropy", map{ text: "PBLang deterministic entropy check" });
    assert_true(sec_ent.ok == true and sec_ent.value.entropy > 0, "sec_entropy should compute Shannon entropy");

    let doc_src = router.call("documentation_sources", map{});
    assert_true(doc_src.ok == true and len(doc_src.value.sources) >= 5 and doc_src.value.network_used == false, "documentation_sources should list fixed official documentation sources offline");

    let n8n_h = router.call("n8n_health", map{});
    assert_true(n8n_h.ok == true and n8n_h.value.ok == true and n8n_h.value.effect_performed == false, "n8n_health should validate contract via unified sibling MCP family");

    let ver_p = router.call("vercel_projects", map{});
