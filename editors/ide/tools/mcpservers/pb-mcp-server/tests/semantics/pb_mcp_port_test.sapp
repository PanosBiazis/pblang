    let pbai_4ax = router.call("pbai_four_axis_ideal_nn_joint_trainer", map{ newton_schulz_steps: 2 });
    assert_true(pbai_4ax.ok == true and pbai_4ax.value.ok == true and pbai_4ax.value.all_four_axes_improved == true and pbai_4ax.value.ideality_distance_after < pbai_4ax.value.ideality_distance_before and pbai_4ax.value.task_loss_after < pbai_4ax.value.task_loss_before, "pbai_four_axis_ideal_nn_joint_trainer should wire 4-Axis Ideal-NN joint training");

