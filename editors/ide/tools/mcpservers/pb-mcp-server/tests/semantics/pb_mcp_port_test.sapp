    assert_true(pbai_fsm.ok == true and pbai_fsm.value.ok == true and pbai_fsm.value.current_idle_state == "S2_MEDIUM_IDLE_KV_COMPACT" and pbai_fsm.value.total_idle_states == 5 and pbai_fsm.value.zero_idle_waste_guaranteed == true and pbai_fsm.value.compiler_verified == true, "pbai_smart_idle_state_machine_controller should transition 5-state Smart-Idle FSM cleanly");

