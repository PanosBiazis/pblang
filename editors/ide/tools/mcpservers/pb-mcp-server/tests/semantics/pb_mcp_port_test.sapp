    assert_true(pbai_bidir.ok == true and pbai_bidir.value.ok == true and pbai_bidir.value.deq_fixed_point_converged == true and pbai_bidir.value.predictive_coding_local_backprop_free_verified == true and pbai_bidir.value.cycle_consistency_error < 0.05, "pbai_bidirectional_feedback_deq_and_predictive_coding should run bi-directional cycle, DEQ fixed-point, and Rao-Ballard predictive coding");

    let pbai_12p = router.call("pbai_hybrid_12paradigm_training_combinator", map{});
    assert_true(pbai_12p.ok == true and pbai_12p.value.ok == true and pbai_12p.value.total_combined_paradigms == 12 and pbai_12p.value.relative_loss_reduction_pct > 80.0 and pbai_12p.value.zero_catastrophic_forgetting == true, "pbai_hybrid_12paradigm_training_combinator should combine all 12 training paradigms");

    let pbai_imm = router.call("pbai_pbruler_adaptive_immune_and_antibody_system", map{ payload: "clean_sapp_module" });
    assert_true(pbai_imm.ok == true and pbai_imm.value.ok == true and pbai_imm.value.innate_hard_rules_immutable == true and pbai_imm.value.b_cell_antibody_synthesized == true and pbai_imm.value.o1_antibody_memory_immunized == true and pbai_imm.value.hard_rules_weakened == false, "pbai_pbruler_adaptive_immune_and_antibody_system should verify innate rules and O(1) adaptive antibodies");

    let pbai_org = router.call("pbai_substrate_to_brain_organ_and_taxonomy_coordinator", map{});
    assert_true(pbai_org.ok == true and pbai_org.value.ok == true and pbai_org.value.agent_hierarchy_levels == 4 and pbai_org.value.specialist_organ_roles_count == 13 and pbai_org.value.catalog_model_descriptors_count == 58, "pbai_substrate_to_brain_organ_and_taxonomy_coordinator should verify 4-level hierarchy, 13 organs, and 58 specialist models");

    let pbai_5pr = router.call("pbai_five_principal_governed_training_team", map{});
    assert_true(pbai_5pr.ok == true and pbai_5pr.value.ok == true and pbai_5pr.value.principals_count == 5 and pbai_5pr.value.trainer_blind_to_sealed_test_escrow == true and pbai_5pr.value.self_promotion_blocked == true, "pbai_five_principal_governed_training_team should enforce 5 distinct principals and sealed test escrow");

    let pbai_fam = router.call("pbai_family_coevolution_and_reverse_distillation", map{});
    assert_true(pbai_fam.ok == true and pbai_fam.value.ok == true and pbai_fam.value.family_tiers_count == 4 and pbai_fam.value.top_down_max_to_students_distillation == true and pbai_fam.value.bottom_up_student_verified_discoveries_promoted_to_max == true, "pbai_family_coevolution_and_reverse_distillation should verify top-down and bottom-up reverse distillation across Max/Pro/Mini/Nano");

    let pbai_v13b = router.call("pbai_v13_biological_living_competitor_benchmark", map{});
    assert_true(pbai_v13b.ok == true and pbai_v13b.value.ok == true and pbai_v13b.value.total_tools == 1184 and pbai_v13b.value.lazy_modules == 98 and pbai_v13b.value.pbai_wins_all_biological_and_hybrid_training_dimensions == true, "pbai_v13_biological_living_competitor_benchmark should win all biological and hybrid training dimensions");

    let pbai_v13s = router.call("pbai_v13_biological_living_and_training_status", map{});
    assert_true(pbai_v13s.ok == true and pbai_v13s.value.ok == true and pbai_v13s.value.total_tools == 1184 and pbai_v13s.value.lazy_modules == 98 and pbai_v13s.value.biological_living_growth_active == true and pbai_v13s.value.hybrid_12paradigm_training_active == true and pbai_v13s.value.hallucination_rate == 0.0, "pbai_v13_biological_living_and_training_status should verify all v13 subsystems");

    let mcp_vit = router.call("pb_mcp_living_organism_vital_signs_monitor", map{});
    assert_true(mcp_vit.ok == true and mcp_vit.value.ok == true and mcp_vit.value.homeostasis_stable == true and mcp_vit.value.hallucination_rate == 0.0, "pb_mcp_living_organism_vital_signs_monitor should verify organism homeostasis");

    let mcp_bstatus = router.call("pb_mcp_biological_living_brain_suite_status", map{});
    assert_true(mcp_bstatus.ok == true and mcp_bstatus.value.ok == true and mcp_bstatus.value.total_tools == 1184, "pb_mcp_biological_living_brain_suite_status should report v13 status");

    let mcp_bandit = router.call("pb_mcp_fast_trial_error_bandit_and_hill_climber", map{});
    assert_true(mcp_bandit.ok == true and mcp_bandit.value.ok == true and mcp_bandit.value.epsilon_greedy_bandit_active == true and mcp_bandit.value.monotone_hill_climbing_reward_improved == true, "pb_mcp_fast_trial_error_bandit_and_hill_climber should verify fast trial-and-error bandit + hill-climbing + guess-feedback RL");

    let mcp_lora = router.call("pb_mcp_frozen_lora_and_binary_bit_adapter_trainer", map{});
    assert_true(mcp_lora.ok == true and mcp_lora.value.ok == true and mcp_lora.value.frozen_base_checkpoint_untouched == true and mcp_lora.value.low_rank_lora_delta_trained == true and mcp_lora.value.bit_level_binary_projection_updated == true, "pb_mcp_frozen_lora_and_binary_bit_adapter_trainer should verify frozen base + LoRA + binary bit adapter");

    let mcp_1184 = router.call("pb_mcp_v13_1184_router_telemetry", map{});
    assert_true(mcp_1184.ok == true and mcp_1184.value.ok == true and mcp_1184.value.total_tools == 1184 and mcp_1184.value.lazy_modules == 98 and mcp_1184.value.hallucination_rate == 0.0, "pb_mcp_v13_1184_router_telemetry should verify 1184 tools and 98 lazy modules");

    let rtel = router.router_telemetry();
    assert_true(rtel.ok == true and rtel.router_mode == "smart_on_demand_lazy_memoized" and rtel.total_available_modules == 98 and rtel.cached_dispatch_tool_count >= 95, "router_telemetry should report 98 total available modules and active dispatch cache");

    let pbai_eng = try import("editors/ide/tools/ai/pbai_embedded_engine.sapp") catch import("../../../ai/pbai_embedded_engine.sapp");
    let eng_st = pbai_eng.embedded_pbai_status();
    assert_true(eng_st.ok == true and eng_st.engine_version == "13.0.0-embedded" and eng_st.hallucination_rate == 0.0 and eng_st.zero_hallucination_enforced == true and eng_st.smart_idle_resource_governor_active == true and eng_st.biological_living_growth_active == true and eng_st.hybrid_12paradigm_training_active == true and eng_st.subsystems.biological_living_and_hybrid_training_v13 == true, "embedded_pbai_status should pass all v2..v13 subsystems with 0.0% hallucination, Smart-Idle Governor, and Biological Living + 12-Paradigm Hybrid Training");

    let pbai_auto = try import("editors/ide/tools/ai/pbai_autonomous_ide_suites.sapp") catch import("../../../ai/pbai_autonomous_ide_suites.sapp");
    let auto_st = pbai_auto.embedded_autonomous_suites_status();
    assert_true(auto_st.ok == true and auto_st.version == "3.0.0-embedded" and len(auto_st.suites) == 4, "embedded_autonomous_suites_status should report 4 autonomous suites");
}

fn main() {
    run_part_1();
    run_part_2();
    run_part_3();
    run_part_4();
    run_part_5();
    run_part_6();
    run_part_7();
    print "pb_mcp_pblang_port_pass";
}

main();



