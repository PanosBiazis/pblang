    let ide_web = router.call("pbide_web_and_multipart_import_gate", map{});
    assert_true(ide_web.ok == true and ide_web.value.ok == true and ide_web.value.max_file_bytes > 0, "pbide_web_and_multipart_import_gate should validate PBIDE web multipart import");
}

