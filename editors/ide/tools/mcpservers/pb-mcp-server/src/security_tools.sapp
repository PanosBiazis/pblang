// Native pblang defensive-security tools for pb-mcp-server.
//
// Exposes stdlib:secscan.sapp (threat detection, secret scanning, password
// strength, redaction) as MCP tools. DEFENSIVE + READ-ONLY: classify/scan/score
// only — no exploitation, no actuation. Secret VALUES are never echoed back over
// the wire (only type / preview / redacted form), so scanning a payload can't
// itself leak the credential.

let sec = import("stdlib:secscan.sapp");
let boundary = import("security.sapp");

let SEC_TOOLS = [
    "sec_scan_input", "sec_detect_secrets", "sec_redact",
    "sec_password_strength", "sec_scan", "sec_entropy", "sec_mask",
];

fn tool_list() { return SEC_TOOLS; }
fn implemented_tools() { return SEC_TOOLS; }

// Map detect_secrets rows to a wire-safe shape (drop the raw `value`).
fn _safe_secrets(rows) {
    let out = [];
    let i = 0;
    while i < len(rows) {
        push(out, map{ type: rows[i].type, preview: rows[i].preview, redacted: rows[i].redacted });
        i = i + 1;
    }
    return out;
}

fn call_security(tool, args) {
    if args == nil { args = map{}; }

    if tool == "sec_scan_input" {
        return sec.scan_input(str(try args.text catch ""));
    }
    if tool == "sec_detect_secrets" {
        let rows = sec.detect_secrets(str(try args.text catch ""));
        return map{ secrets: _safe_secrets(rows), count: len(rows) };
    }
    if tool == "sec_redact" {
        return map{ redacted: sec.redact(str(try args.text catch "")) };
    }
    if tool == "sec_password_strength" {
        return sec.password_strength(str(try args.password catch ""));
    }
    // sec_entropy: Shannon entropy (bits/char) + a "looks random/encoded" verdict
    // for triaging unknown blobs (high entropy over a meaningful length suggests
    // a key, token, or ciphertext rather than plain text).
    if tool == "sec_entropy" {
        let t = str(try args.text catch "");
        let e = sec.shannon_entropy(t);
        return map{ length: len(t), entropy: e, looks_random: (len(t) >= 16 and e >= 4.0) };
    }
    // sec_mask: PII/PAN masking for safe logging — replace all but the last
    // `keep_last` characters with '*' (e.g. a card number -> ************1234).
    if tool == "sec_mask" {
        let t = str(try args.text catch "");
        let keep = try args.keep_last catch 4;
        let n = len(t);
        if n <= keep { return map{ result: t }; }
        let masked = "";
        let i = 0;
        while i < n - keep { masked = masked + "*"; i = i + 1; }
        return map{ result: masked + str_slice(t, n - keep, n) };
    }
    // sec_scan: combined secret + threat scan of inline text or a file path.
    if tool == "sec_scan" {
        let text = nil;
        let path = try args.path catch nil;
        if path != nil { text = try boundary.read_project_text(path, boundary.MAX_READ_CHARS) catch nil; }
        else { text = str(try args.text catch ""); }
        if text == nil {
            return map{ ok: false, error: "sec_scan: cannot read " + str(path) };
        }
        let rows = sec.detect_secrets(text);
        let scan = sec.scan_input(text);
        return map{
            ok: true,
            secrets: _safe_secrets(rows),
            threats: scan.threats,
            risk: scan.risk,
            findings: len(rows) + len(scan.threats)
        };
    }
    return nil;
}

export call_security, tool_list, implemented_tools, SEC_TOOLS;
