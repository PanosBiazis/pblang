// Pure extraction of fixed, reviewed OS-boundary blocks. No foreign execution.
let PB = import("stdlib:polyglot_build.sapp");
let PROFILES = map{
    browser: ["browser_guard", "browser_scope", "browser_live", "browser_live_session", "browser_https", "browser_frontend", "browser_bootstrap", "browser_worker", "browser_engine", "stdio_guard", "documentation_child"],
    documentation: ["stdio_guard", "documentation_guard", "documentation_https", "documentation_child"],
    n8n: ["n8n_guard", "n8n_child", "n8n_http", "stdio_guard", "documentation_child"],
    services: ["services_guard", "services_child", "services_https", "services_setup", "documentation_https", "stdio_guard", "documentation_child"],
    offline: ["stdio_guard"],
    desktop_abi: ["operator_gtk_abi", "desktop_context_abi", "desktop_overlay_abi", "desktop_trust_abi"],
    desktop: ["desktop_launch", "desktop_guard", "desktop_enroll", "desktop_service"]
};
fn extract(sources, profile = "browser") {
    if type(profile) != "string" or not map_has(PROFILES, profile) { throw "unknown transport profile"; }
    let NAMES = PROFILES[profile];
    if type(sources) != "map" or len(map_keys(sources)) != len(NAMES) { throw "invalid transport boundary source set"; }
    let result = map{};
    for name in NAMES {
        let source = try sources[name] catch nil;
        if type(source) != "string" or len(str_to_bytes(source)) > 262144 { throw "transport boundary source bound"; }
        let blocks = PB.extract_blocks(source);
        if len(blocks) != 1 or blocks[0].language != (if profile == "desktop_abi" { "c" } else { "python" }) { throw "one expected-language boundary block required"; }
        result[name] = blocks[0].code + "\n";
    }
    return result;
}
export extract;
