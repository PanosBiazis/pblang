// Native pblang translations for deterministic ML/neural helper tools.
//
// No model runtime is invoked here. Provider/model-backed tools remain
// catalog-only until pblang has a matching native runtime or audited wrapper.

let FS = import("stdlib:fs.sapp");
let sec = import("security.sapp");
let algo = import("algorithm_tools.sapp");
let text = import("text_tools.sapp");

fn _values(items) {
    let out = [];
    let n = sec.clamp(len(items), 0, 200000);
    for i n { out[len(out)] = items[i] * 1.0; }
    return out;
}

fn _dot(a, b) {
    let n = len(a);
    if len(b) < n { n = len(b); }
    let s = 0.0;
    for i n { s = s + a[i] * b[i]; }
    return s;
}

fn _norm(a) {
    return num_sqrt(_dot(a, a));
}

fn neural_embed_cosine(args) {
    if args == nil { args = map{}; }
    let a = _values(try args.vec_a catch try args.a catch []);
    let b = _values(try args.vec_b catch try args.b catch []);
    if len(a) == 0 or len(b) == 0 or len(a) != len(b) {
        return map{ ok: false, error: "vec_a and vec_b must be non-empty arrays with equal length" };
    }
    let denom = _norm(a) * _norm(b);
    if denom == 0 { return map{ ok: false, error: "zero vector cannot be cosine-normalized" }; }
    return map{ ok: true, similarity: _dot(a, b) / denom, dimensions: len(a) };
}

fn neural_tensor_stats(args) {
    if args == nil { args = map{}; }
    let values = _values(try args.values catch try args.tensor catch []);
    if len(values) == 0 { return map{ ok: false, error: "values/tensor array is required" }; }
    let desc = algo.algo_stats_describe(map{ values: values });
    return map{ ok: true, count: len(values), stats: desc };
}

fn ml_token_count(args) {
    if args == nil { args = map{}; }
    let s = str(try args.text catch "");
    let est = text.summarize_token_estimate(s, try args.max_chars catch sec.MAX_READ_CHARS);
    return map{
        token_count: est.rough_tokens,
        chars: est.chars,
        estimation_method: "pblang-char-div-4-fallback",
        chars_per_token: if est.rough_tokens == 0 { 0 } else { est.chars / est.rough_tokens },
    };
}

fn ml_tokenize(args) {
    if args == nil { args = map{}; }
    let s = str(try args.text catch "");
    let max_tokens = sec.clamp(try args.max_tokens catch 2000, 1, 20000);
    let tokens = [];
    let i = 0;
    while i < len(s) and len(tokens) < max_tokens {
        let end = i + 4;
        if end > len(s) { end = len(s); }
        tokens[len(tokens)] = str_slice(s, i, end);
        i = end;
    }
    return map{ tokens: tokens, token_count: len(tokens), method: "fixed-4-char-fallback" };
}

fn ml_dataset_validate(args) {
    if args == nil { args = map{}; }
    let raw = try args.text catch nil;
    let path = try args.path catch "";
    if raw == nil and path != "" { raw = FS.read(sec.safe_rel_path(path, "")); }
    if raw == nil { raw = ""; }
    let lines = str_split(str(raw), "\n");
    let issues = [];
    let records = 0;
    let empty = 0;
    let max_lines = sec.clamp(try args.max_lines catch len(lines), 0, 100000);
    for i max_lines {
        let line = str_trim(lines[i]);
        if line == "" { empty = empty + 1; }
        else {
            records = records + 1;
            let parsed = try json_parse(line) catch nil;
            if parsed == nil {
                issues[len(issues)] = map{ line: i + 1, issue: "malformed JSONL record" };
            } else if type(parsed) == "map" {
                let has_messages = try parsed.messages catch nil;
                let has_prompt = try parsed.prompt catch nil;
                if has_messages == nil and has_prompt == nil {
                    issues[len(issues)] = map{ line: i + 1, issue: "missing messages or prompt field" };
                }
            }
        }
    }
    return map{ ok: len(issues) == 0, records: records, empty_lines: empty, issues: issues, scanned_lines: max_lines };
}

fn ml_model_info(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let lower = str_lower(path);
    let format = "unknown";
    if str_ends_with(lower, ".onnx") { format = "onnx"; }
    else if str_ends_with(lower, ".safetensors") { format = "safetensors"; }
    else if str_ends_with(lower, ".pt") or str_ends_with(lower, ".pth") { format = "pytorch"; }
    else if str_ends_with(lower, ".gguf") { format = "gguf"; }
    return map{ ok: true, path: path, format: format, bytes: try FS.size(path) catch nil, runtime_loaded: false };
}

fn neural_model_info(args) { return ml_model_info(args); }

fn neural_tokenize(args) { return ml_tokenize(args); }

fn _token_set_score(text) {
    let s = str_lower(str(text));
    let chars = len(s);
    if chars == 0 { return map{ chars: 0, words: 0, unique: 0, avg_word: 0, punctuation: 0 }; }
    let words = str_split(str_replace_all(str_replace_all(s, "\n", " "), "\t", " "), " ");
    let seen = map{};
    let count = 0;
    let unique = 0;
    let word_chars = 0;
    for i len(words) {
        let w = str_trim(words[i]);
        if w != "" {
            count = count + 1;
            word_chars = word_chars + len(w);
            let old = try seen[w] catch 0;
            if old == 0 { unique = unique + 1; }
            seen[w] = old + 1;
        }
    }
    let punct = 0;
    for i chars {
        let c = str_slice(s, i, i + 1);
        if c == "." or c == "," or c == ";" or c == ":" or c == "!" or c == "?" { punct = punct + 1; }
    }
    return map{ chars: chars, words: count, unique: unique, avg_word: if count == 0 { 0 } else { word_chars / count }, punctuation: punct };
}

fn ml_perplexity_score(args) {
    if args == nil { args = map{}; }
    let s = str(try args.text catch "");
    let st = _token_set_score(s);
    if st.words == 0 { return map{ ok: false, error: "text is required" }; }
    let diversity = st.unique / st.words;
    let repetition = 1.0 - diversity;
    let length_penalty = if st.avg_word > 14 { 8 } else { 0 };
    let punctuation_bonus = if st.punctuation > 0 { 2 } else { 0 };
    let score = 12.0 + repetition * 40.0 + length_penalty - punctuation_bonus;
    return map{
        ok: true,
        perplexity_estimate: score,
        method: "local lexical heuristic, not model logprob",
        words: st.words,
        unique_words: st.unique,
        lower_is_better: true,
    };
}

fn ml_benchmark_model(args) {
    if args == nil { args = map{}; }
    let prompt = str(try args.prompt catch "hello");
    let iterations = sec.clamp(try args.iterations catch 3, 1, 100);
    let tok = ml_token_count(map{ text: prompt });
    return map{
        ok: true,
        executed: false,
        model: str(try args.model catch "local-model"),
        prompt_tokens_estimate: tok.token_count,
        iterations: iterations,
        plan: ["load model runtime", "warm up once", "run bounded iterations", "measure latency and tokens/sec"],
        reason: "native pblang port does not invoke external model runtimes yet",
    };
}

fn ml_model_compare_benchmark(args) {
    if args == nil { args = map{}; }
    let models = try args.models catch [];
    let prompts = try args.prompts catch [try args.prompt catch "hello"];
    let max_models = sec.clamp(len(models), 0, 50);
    let rows = [];
    for i max_models {
        let prompt_chars = 0;
        for j sec.clamp(len(prompts), 0, 50) { prompt_chars = prompt_chars + len(str(prompts[j])); }
        rows[len(rows)] = map{ model: str(models[i]), prompts: len(prompts), prompt_chars: prompt_chars, executed: false };
    }
    return map{ ok: true, executed: false, comparisons: rows, reason: "benchmark plan generated without external runtime calls" };
}

fn ml_fine_tune_prep(args) {
    if args == nil { args = map{}; }
    let conversations = try args.conversations catch [];
    let format = str_lower(str(try args.format catch "openai"));
    let out = [];
    let max_rows = sec.clamp(try args.max_rows catch len(conversations), 0, 10000);
    for i max_rows {
        let c = conversations[i];
        if type(c) == "map" {
            if format == "openai" {
                out[len(out)] = json_stringify(map{ messages: try c.messages catch [map{ role: "user", content: str(try c.prompt catch "") }, map{ role: "assistant", content: str(try c.completion catch "") }] });
            } else {
                out[len(out)] = json_stringify(map{ prompt: str(try c.prompt catch ""), completion: str(try c.completion catch try c.response catch "") });
            }
        } else {
            out[len(out)] = json_stringify(map{ prompt: str(c), completion: "" });
        }
    }
    let text_out = str_join(out, "\n");
    let output_path = try args.output_path catch "";
    let wrote = false;
    if output_path != "" {
        let path = sec.safe_rel_path(output_path, "");
        FS.write(path, text_out + if len(out) == 0 { "" } else { "\n" });
        wrote = true;
    }
    return map{ ok: true, records: len(out), format: format, text: text_out, output_path: output_path, wrote: wrote };
}

fn ml_convert_to_gguf(args) {
    if args == nil { args = map{}; }
    let model_path = sec.safe_rel_path(try args.model_path catch try args.path catch "", "");
    let output_path = sec.safe_rel_path(try args.output_path catch "model.gguf", "model.gguf");
    return map{
        ok: true,
        executed: false,
        model_path: model_path,
        output_path: output_path,
        command_plan: ["python3", "convert.py", model_path, "--outfile", output_path],
        reason: "conversion requires llama.cpp convert.py; pblang port returns a bounded plan only",
    };
}

fn neural_inference(args) {
    if args == nil { args = map{}; }
    let model_path = sec.safe_rel_path(try args.model_path catch try args.path catch "", "");
    let input = try args.input_json catch try args.inputs catch map{};
    return map{
        ok: true,
        executed: false,
        model_path: model_path,
        input_keys: if type(input) == "map" { map_keys(input) } else { [] },
        reason: "ONNX/runtime inference is catalog-known but not executed by this pure pblang module yet",
    };
}

fn call_ml(tool, args) {
    if tool == "neural_embed_cosine" { return neural_embed_cosine(args); }
    if tool == "neural_tensor_stats" { return neural_tensor_stats(args); }
    if tool == "ml_token_count" { return ml_token_count(args); }
    if tool == "ml_tokenize" { return ml_tokenize(args); }
    if tool == "ml_dataset_validate" { return ml_dataset_validate(args); }
    if tool == "ml_model_info" { return ml_model_info(args); }
    if tool == "neural_model_info" { return neural_model_info(args); }
    if tool == "neural_tokenize" { return neural_tokenize(args); }
    if tool == "ml_perplexity_score" { return ml_perplexity_score(args); }
    if tool == "ml_benchmark_model" { return ml_benchmark_model(args); }
    if tool == "ml_model_compare_benchmark" { return ml_model_compare_benchmark(args); }
    if tool == "ml_fine_tune_prep" { return ml_fine_tune_prep(args); }
    if tool == "ml_convert_to_gguf" { return ml_convert_to_gguf(args); }
    if tool == "neural_inference" { return neural_inference(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "neural_embed_cosine",
        "neural_tensor_stats",
        "ml_token_count",
        "ml_tokenize",
        "ml_dataset_validate",
        "ml_model_info",
        "neural_model_info",
        "neural_tokenize",
        "ml_perplexity_score",
        "ml_benchmark_model",
        "ml_model_compare_benchmark",
        "ml_fine_tune_prep",
        "ml_convert_to_gguf",
        "neural_inference",
    ];
}

export implemented_tools, call_ml,
       neural_embed_cosine, neural_tensor_stats, ml_token_count, ml_tokenize,
       ml_dataset_validate, ml_model_info, neural_model_info, neural_tokenize,
       ml_perplexity_score, ml_benchmark_model, ml_model_compare_benchmark,
       ml_fine_tune_prep, ml_convert_to_gguf, neural_inference;
