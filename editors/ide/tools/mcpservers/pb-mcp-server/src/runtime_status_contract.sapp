// Public runtime metadata, health-evaluation and planning contracts.
fn _object(properties, required = nil) {if required == nil { required = []; } return map{type:"object",properties:properties,required:required,additionalProperties:false};}
fn _integer(high) {return map{type:"integer",minimum:1,maximum:high};}
fn names(){return ["pblang_runtime_status","pblang_machine_code_plan","pblang_product_health","pblang_execution_plan"];}
fn schemas() {
    let metric=map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z][A-Za-z0-9_]{0,63}$"};
    let values=map{type:"object",maxProperties:16,propertyNames:metric,
        additionalProperties:map{type:"number",minimum:0,maximum:1000000000000}};
    let budget=_object(map{metric:metric,max_regression_percent:map{type:"number",minimum:0,maximum:1000},lower_is_better:map{type:"boolean"}},["metric","max_regression_percent"]);
    let performance=_object(map{baseline:values,candidate:values,
        budgets:map{type:"array",minItems:1,maxItems:16,uniqueItems:true,items:budget},
        source:map{type:"string",maxLength:128}},["baseline","candidate","budgets"]);
    let options=_object(map{
        max_source_bytes:_integer(16777216),max_ir_instructions:_integer(1000000),
        max_artifact_bytes:_integer(67108864),max_eval_steps:_integer(100000000),
        max_frames:_integer(4096),max_stack:_integer(1048576),max_locals:_integer(1048576),
        max_output:_integer(1048576),max_value_items:_integer(16777216),
        max_modules:_integer(4096),max_module_depth:_integer(256),
        max_module_source_bytes:_integer(16777216),max_total_source_bytes:_integer(67108864),
        max_linked_source_bytes:_integer(134217728),max_path_bytes:_integer(4096),
        allow_syscalls:map{type:"boolean",enum:[false]},
        libc:map{type:"string",enum:["glibc","musl","none","bionic","libSystem","ucrt","freebsd-libc","openbsd-libc","netbsd-libc","solaris-libc","haiku-libroot","qnx-libc","newlib","aix-libc","hpux-libc","irix-libc"]}});
    return map{
        pblang_runtime_status:_object(map{}),pblang_machine_code_plan:_object(map{}),
        pblang_product_health:_object(map{performance:performance}),
        pblang_execution_plan:_object(map{
            os:map{type:"string",minLength:1,maxLength:32,pattern:"^[a-z0-9_-]+$",default:"linux"},
            version:map{type:"string",minLength:1,maxLength:27,pattern:"^[0-9]{1,6}(\\.[0-9]{1,6}){0,3}$",default:"2.6"},
            arch:map{type:"string",minLength:1,maxLength:32,pattern:"^[a-z0-9_-]+$",default:"x86_64"},options:options})};
}
fn functional_records() {
    let contracts=schemas();let out=[];
    for name in names() {
        let state="complete";let reason="scoped library metadata or caller-data health evaluation; not VM or deployment attestation";
        if name=="pblang_machine_code_plan" or name=="pblang_execution_plan" {state="plan-only";reason="verified bounded plan response; no compile, execution or benchmark";}
        push(out,map{name:name,status:state,public_mcp:true,
            input_schema:contracts[name],reason:reason,
            evidence_ids:["pb_mcp_runtime_contracts:dispatch","pb_mcp_runtime_contracts:refusal","pb_mcp_runtime_contracts:stdio"]});
    }
    return out;
}
export names,schemas,functional_records;
