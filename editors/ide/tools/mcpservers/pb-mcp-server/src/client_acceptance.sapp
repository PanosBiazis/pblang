// Compose bounded discovery and revision-bound caller observations. This is a
// source-library helper, not a transport client, public MCP tool or attestation.
let SNAPSHOT=import("catalog_snapshot.sapp");
let ACCEPTANCE=import("agent_acceptance.sapp");
fn _object(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) {throw "client acceptance: invalid input";}
    for key in keys {if map_has(value,key) {continue;}throw "client acceptance: invalid input";}
}
fn review(args) {
    _object(args,["revision","discovery","observations"]);
    _object(args.discovery,["revision","transcript"]);
    // Reuse all snapshot pagination, correlation and metadata limits; never
    // evaluate a tool schema or return its descriptions/cursors to the caller.
    let catalog=SNAPSHOT.review(args.discovery.transcript);
    if catalog.required_count<1 {throw "client acceptance: required tools missing";}
    if type(args.observations)!="array" or len(args.observations)>255 {
        throw "client acceptance: invalid observations";
    }
    let observations=[];for item in args.observations {array_push(observations,item);}
    // Reserve this observation for discovery. A caller-supplied duplicate,
    // even at another revision, is rejected by the shared acceptance contract.
    array_push(observations,map{check:"catalog",revision:args.discovery.revision,
        status:if catalog.compatible {"passed"} else {"failed"}});
    let result=ACCEPTANCE.call_acceptance("ai_acceptance_check",map{
        revision:args.revision,
        required:["catalog","initialize","successful_call","malformed_call","connection_closed"],
        observations:observations});
    result.format="pb_mcp.client_acceptance.v1";
    result.catalog_complete=catalog.complete;result.catalog_compatible=catalog.compatible;
    result.catalog_required_count=catalog.required_count;
    result.catalog_missing_required=catalog.missing_required;
    result.catalog_tool_count=catalog.tool_count;
    result.schemas_evaluated=false;result.tools_executed=false;
    result.client_integration_verified=false;result.package_identity_authenticated=false;
    return result;
}
export review;
