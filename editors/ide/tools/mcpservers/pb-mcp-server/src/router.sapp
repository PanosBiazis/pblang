// Tool router for the pblang pb-mcp-server port (Smart On-Demand Lazy Memoized Router).

let _ROUTER_MODS = map{};

fn _mod(file_name) {
    if map_has(_ROUTER_MODS, file_name) { return _ROUTER_MODS[file_name]; }
    let m = try import("src/" + file_name) catch nil;
    if m == nil { m = try import("editors/ide/tools/mcpservers/pb-mcp-server/src/" + file_name) catch nil; }
    if m == nil { m = import(file_name); }
    _ROUTER_MODS[file_name] = m;
    return m;
}

fn router_telemetry() {
    let loaded_keys = map_keys(_ROUTER_MODS);
    return map{
        ok: true,
        router_mode: "smart_on_demand_lazy_memoized",
        loaded_module_count: len(loaded_keys),
        loaded_modules: loaded_keys,
        total_available_modules: 41
    };
}

fn ok(tool, value) {
    return map{ ok: true, tool: tool, value: value };
}

fn err(tool, message) {
    return map{ ok: false, tool: tool, error: message };
}

fn call(tool, args = nil) {
    if args == nil { args = map{}; }

    if tool == "tools_runtime_status" or tool == "tool_status" {
        return ok(tool, _mod("catalog.sapp").status());
    }
    if tool == "tool_catalog" or tool == "tools_catalog" {
        return ok(tool, _mod("catalog.sapp").tool_catalog());
    }
    if tool == "tool_search" or tool == "tools_search" {
        return ok(tool, _mod("catalog.sapp").search_tools(try args.query catch ""));
    }
    if tool == "implemented_catalog" {
        return ok(tool, _mod("catalog.sapp").implemented_catalog());
    }

    // Fast prefix dispatch for LLM Cognition (Wave 1..12) and Reverse-Engineering (REA) suites
    if str_starts_with(tool, "llm_") or str_starts_with(tool, "pblang_") {
        let llmv = try _mod("llm_cognition_tools.sapp").call_llm_cognition(tool, args) catch nil;
        if llmv != nil { return ok(tool, llmv); }
    }
    if str_starts_with(tool, "rea_") {
        let reav = try _mod("rea_tools.sapp").call_rea(tool, args) catch nil;
        if reav != nil { return ok(tool, reav); }
    }

    let v = _mod("core_tools.sapp").call_core(tool, args);
    if v != nil { return ok(tool, v); }

    let tv = _mod("thinking_tools.sapp").call_thinking(tool, args);
    if tv != nil { return ok(tool, tv); }

    let xv = _mod("text_tools.sapp").call_text(tool, args);
    if xv != nil { return ok(tool, xv); }

    let rv = _mod("runtime_tools.sapp").call_runtime(tool, args);
    if rv != nil { return ok(tool, rv); }

    let av = _mod("algorithm_tools.sapp").call_algorithm(tool, args);
    if av != nil { return ok(tool, av); }

    let cv = _mod("codebase_tools.sapp").call_codebase(tool, args);
    if cv != nil { return ok(tool, cv); }

    let wv = _mod("workspace_tools.sapp").call_workspace(tool, args);
    if wv != nil { return ok(tool, wv); }

    let gv = _mod("git_tools.sapp").call_git(tool, args);
    if gv != nil { return ok(tool, gv); }

    let conv = _mod("convert_tools.sapp").call_convert(tool, args);
    if conv != nil { return ok(tool, conv); }

    let lv = _mod("log_tools.sapp").call_log(tool, args);
    if lv != nil { return ok(tool, lv); }

    let chv = _mod("chart_tools.sapp").call_chart(tool, args);
    if chv != nil { return ok(tool, chv); }

    let agv = _mod("agent_tools.sapp").call_agent(tool, args);
    if agv != nil { return ok(tool, agv); }

    let mcpv = _mod("mcp_tools.sapp").call_mcp(tool, args);
    if mcpv != nil { return ok(tool, mcpv); }

    let hv = _mod("history_tools.sapp").call_history(tool, args);
    if hv != nil { return ok(tool, hv); }

    let cov = _mod("consensus_tools.sapp").call_consensus(tool, args);
    if cov != nil { return ok(tool, cov); }

    let syv = _mod("system_tools.sapp").call_system(tool, args);
    if syv != nil { return ok(tool, syv); }

    let apv = _mod("app_tools.sapp").call_app(tool, args);
    if apv != nil { return ok(tool, apv); }

    let rev = _mod("review_tools.sapp").call_review(tool, args);
    if rev != nil { return ok(tool, rev); }

    let wav = _mod("wait_tools.sapp").call_wait(tool, args);
    if wav != nil { return ok(tool, wav); }

    let fiv = _mod("file_tools.sapp").call_file(tool, args);
    if fiv != nil { return ok(tool, fiv); }

    let shv = _mod("shell_tools.sapp").call_shell(tool, args);
    if shv != nil { return ok(tool, shv); }

    let mlv = _mod("ml_tools.sapp").call_ml(tool, args);
    if mlv != nil { return ok(tool, mlv); }

    let prv = _mod("protect_tools.sapp").call_protect(tool, args);
    if prv != nil { return ok(tool, prv); }

    let tev = _mod("terminal_tools.sapp").call_terminal(tool, args);
    if tev != nil { return ok(tool, tev); }

    let cix = _mod("code_index_tools.sapp").call_code_index(tool, args);
    if cix != nil { return ok(tool, cix); }

    let ctxv = _mod("context_tools.sapp").call_context(tool, args);
    if ctxv != nil { return ok(tool, ctxv); }

    let dbv = _mod("debug_tools.sapp").call_debug(tool, args);
    if dbv != nil { return ok(tool, dbv); }

    let idv = _mod("ide_tools.sapp").call_ide(tool, args);
    if idv != nil { return ok(tool, idv); }

    let aiv = _mod("ai_tools.sapp").call_ai(tool, args);
    if aiv != nil { return ok(tool, aiv); }

    let qv = _mod("quantum_tools.sapp").call_quantum(tool, args);
    if qv != nil { return ok(tool, qv); }

    let pjv = _mod("project_tools.sapp").call_project(tool, args);
    if pjv != nil { return ok(tool, pjv); }

    let wbv = _mod("web_tools.sapp").call_web(tool, args);
    if wbv != nil { return ok(tool, wbv); }

    let mdv = _mod("media_tools.sapp").call_media(tool, args);
    if mdv != nil { return ok(tool, mdv); }

    let niv = _mod("net_iot_tools.sapp").call_net_iot(tool, args);
    if niv != nil { return ok(tool, niv); }

    let rev2 = _mod("re_tools.sapp").call_re(tool, args);
    if rev2 != nil { return ok(tool, rev2); }

    let sbv = _mod("sandbox_tools.sapp").call_sandbox(tool, args);
    if sbv != nil { return ok(tool, sbv); }

    let cmv = _mod("completion_tools.sapp").call_completion(tool, args);
    if cmv != nil { return ok(tool, cmv); }

    let wtv2 = _mod("watcher_tools.sapp").call_watch(tool, args);
    if wtv2 != nil { return ok(tool, wtv2); }

    let meta = _mod("catalog.sapp").find_tool(tool);
    if meta != nil {
        return err(tool, "tool is known from the Rust pb-mcp-server catalog but is not yet natively implemented in pblang; port module '" + meta.source + "' next");
    }
    return err(tool, "unknown tool: " + str(tool));
}

export call, ok, err, router_telemetry;
