// Tool router for the pblang pb-mcp-server port (Smart On-Demand Lazy Memoized Router).

let _ROUTER_MODS = map{};

fn _mod(file_name) {
    if map_has(_ROUTER_MODS, file_name) { return _ROUTER_MODS[file_name]; }
    let m = try import("src/" + file_name) catch nil;
    if m == nil { m = try import("tools/mcp-servers/pb-mcp-server/src/" + file_name) catch nil; }
    if m == nil { m = try import("editors/ide/tools/mcpservers/pb-mcp-server/src/" + file_name) catch nil; }
    if m == nil { m = import(file_name); }
    _ROUTER_MODS[file_name] = m;
    return m;
}

let _DISPATCH_CACHE = map{};

fn router_telemetry() {
    let loaded_keys = map_keys(_ROUTER_MODS);
    let cached_tools = map_keys(_DISPATCH_CACHE);
    return map{
        ok: true,
        router_mode: "smart_on_demand_lazy_memoized",
        loaded_module_count: len(loaded_keys),
        loaded_modules: loaded_keys,
        cached_dispatch_tool_count: len(cached_tools),
        total_available_modules: 120
    };
}

fn ok(tool, value) {
    _DISPATCH_CACHE[tool] = true;
    return map{ ok: true, tool: tool, value: value };
}

fn err(tool, message) {
    return map{ ok: false, tool: tool, error: message };
}

fn _try_call(hv, tool) {
    if hv == "@@handler_threw@@" {
        return err(tool, "tool '" + str(tool) + "' raised an error while handling the request (check arguments)");
    }
    if hv != nil { return ok(tool, hv); }
    return nil;
}

fn call(tool, args = nil) {
    if args == nil { args = map{}; }

    if tool == "tools_runtime_status" or tool == "tool_status" {
        return ok(tool, _mod("catalog.sapp").status());
    }
    if tool == "tool_catalog" or tool == "tools_catalog" {
        return ok(tool, _mod("catalog.sapp").tool_catalog());
    }
    if tool == "tool_search" or tool == "tools_search" {
        return ok(tool, _mod("catalog.sapp").search_tools(try args.query catch ""));
    }
    if tool == "implemented_catalog" {
        return ok(tool, _mod("catalog.sapp").implemented_catalog());
    }

    // Fast prefix dispatch for Embedded PBAI (pbai_*) tools
    if str_starts_with(tool, "pbai_") {
        let pbaiv = _mod("ai_tools.sapp").call_ai(tool, args);
        if pbaiv != nil { return ok(tool, pbaiv); }
    }

    // Fast prefix dispatch for PB Cleanroom (content_signal_*) and Multi-Tenant IAM / Quarantine
    if str_starts_with(tool, "content_signal_") {
        let csgv = _try_call(try _mod("content_signal_tools.sapp").call_content_signal(tool, args) catch "@@handler_threw@@", tool);
        if csgv != nil { return csgv; }
    }
    if str_starts_with(tool, "identity_") or str_starts_with(tool, "user_") or str_starts_with(tool, "organization_") or
       tool == "system_admin_set" or tool == "protect_quarantine_list" or tool == "protect_quarantine_restore" or tool == "protect_quarantine_delete" {
        let iamqv = _try_call(try _mod("iam_and_quarantine_tools.sapp").call_iam_and_quarantine(tool, args) catch "@@handler_threw@@", tool);
        if iamqv != nil { return iamqv; }
    }

    // Fast prefix dispatch for LLM Cognition (Wave 1..12) and Reverse-Engineering (REA) suites
    if str_starts_with(tool, "llm_") or str_starts_with(tool, "pblang_") {
        let llmv = try _mod("llm_cognition_tools.sapp").call_llm_cognition(tool, args) catch nil;
        if llmv != nil { return ok(tool, llmv); }
    }
    if str_starts_with(tool, "rea_") {
        let reav = try _mod("rea_tools.sapp").call_rea(tool, args) catch nil;
        if reav != nil { return ok(tool, reav); }
    }

    // Fast prefix dispatch for Sibling PB-MCP Server Families (n8n, services, pbremote desktop, browser)
    if str_starts_with(tool, "n8n_") or str_starts_with(tool, "supabase_") or str_starts_with(tool, "vercel_") or
       str_starts_with(tool, "pbremote_") or tool == "browser_inspect_html" or str_starts_with(tool, "browser_session_") or tool == "browser_visit_url" {
        let sibv = _try_call(try _mod("sibling_mcp_family_tools.sapp").call_sibling_mcp(tool, args) catch "@@handler_threw@@", tool);
        if sibv != nil { return sibv; }
