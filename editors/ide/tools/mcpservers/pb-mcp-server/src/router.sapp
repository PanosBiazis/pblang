// Tool router for the pblang pb-mcp-server port.

let catalog = import("src/catalog.sapp");
let core = import("src/core_tools.sapp");
let thinking = import("src/thinking_tools.sapp");
let text = import("src/text_tools.sapp");
let runtime = import("src/runtime_tools.sapp");
let algorithm = import("src/algorithm_tools.sapp");
let codebase = import("src/codebase_tools.sapp");
let workspace = import("src/workspace_tools.sapp");
let git = import("src/git_tools.sapp");
let convert = import("src/convert_tools.sapp");
let logtools = import("src/log_tools.sapp");
let chart = import("src/chart_tools.sapp");
let agent = import("src/agent_tools.sapp");
let mcp = import("src/mcp_tools.sapp");
let history = import("src/history_tools.sapp");
let consensus = import("src/consensus_tools.sapp");
let system = import("src/system_tools.sapp");
let app = import("src/app_tools.sapp");
let review = import("src/review_tools.sapp");
let wait = import("src/wait_tools.sapp");
let filetools = import("src/file_tools.sapp");
let shelltools = import("src/shell_tools.sapp");
let mltools = import("src/ml_tools.sapp");
let protect = import("src/protect_tools.sapp");
let terminal = import("src/terminal_tools.sapp");
let codeindex = import("src/code_index_tools.sapp");
let context = import("src/context_tools.sapp");
let debug = import("src/debug_tools.sapp");
let ide = import("src/ide_tools.sapp");
let aitools = import("src/ai_tools.sapp");
let quantum = import("src/quantum_tools.sapp");
let projecttools = import("src/project_tools.sapp");
let webtools = import("src/web_tools.sapp");
let mediatools = import("src/media_tools.sapp");
let netiot = import("src/net_iot_tools.sapp");
let retools = import("src/re_tools.sapp");
let sandboxtools = import("src/sandbox_tools.sapp");
let completion = import("src/completion_tools.sapp");

fn ok(tool, value) {
    return map{ ok: true, tool: tool, value: value };
}

fn err(tool, message) {
    return map{ ok: false, tool: tool, error: message };
}

fn call(tool, args = nil) {
    if args == nil { args = map{}; }

    if tool == "tools_runtime_status" or tool == "tool_status" {
        return ok(tool, catalog.status());
    }
    if tool == "tool_catalog" or tool == "tools_catalog" {
        return ok(tool, catalog.tool_catalog());
    }
    if tool == "tool_search" or tool == "tools_search" {
        return ok(tool, catalog.search_tools(try args.query catch ""));
    }
    if tool == "implemented_catalog" {
        return ok(tool, catalog.implemented_catalog());
    }

    let v = core.call_core(tool, args);
    if v != nil { return ok(tool, v); }

    let tv = thinking.call_thinking(tool, args);
    if tv != nil { return ok(tool, tv); }

    let xv = text.call_text(tool, args);
    if xv != nil { return ok(tool, xv); }

    let rv = runtime.call_runtime(tool, args);
    if rv != nil { return ok(tool, rv); }

    let av = algorithm.call_algorithm(tool, args);
    if av != nil { return ok(tool, av); }

    let cv = codebase.call_codebase(tool, args);
    if cv != nil { return ok(tool, cv); }

    let wv = workspace.call_workspace(tool, args);
    if wv != nil { return ok(tool, wv); }

    let gv = git.call_git(tool, args);
    if gv != nil { return ok(tool, gv); }

    let conv = convert.call_convert(tool, args);
    if conv != nil { return ok(tool, conv); }

    let lv = logtools.call_log(tool, args);
    if lv != nil { return ok(tool, lv); }

    let chv = chart.call_chart(tool, args);
    if chv != nil { return ok(tool, chv); }

    let agv = agent.call_agent(tool, args);
    if agv != nil { return ok(tool, agv); }

    let mcpv = mcp.call_mcp(tool, args);
    if mcpv != nil { return ok(tool, mcpv); }

    let hv = history.call_history(tool, args);
    if hv != nil { return ok(tool, hv); }

    let cov = consensus.call_consensus(tool, args);
    if cov != nil { return ok(tool, cov); }

    let syv = system.call_system(tool, args);
    if syv != nil { return ok(tool, syv); }

    let apv = app.call_app(tool, args);
    if apv != nil { return ok(tool, apv); }

    let rev = review.call_review(tool, args);
    if rev != nil { return ok(tool, rev); }

    let wav = wait.call_wait(tool, args);
    if wav != nil { return ok(tool, wav); }

    let fiv = filetools.call_file(tool, args);
    if fiv != nil { return ok(tool, fiv); }

    let shv = shelltools.call_shell(tool, args);
    if shv != nil { return ok(tool, shv); }

    let mlv = mltools.call_ml(tool, args);
    if mlv != nil { return ok(tool, mlv); }

    let prv = protect.call_protect(tool, args);
    if prv != nil { return ok(tool, prv); }

    let tev = terminal.call_terminal(tool, args);
    if tev != nil { return ok(tool, tev); }

    let cix = codeindex.call_code_index(tool, args);
    if cix != nil { return ok(tool, cix); }

    let ctxv = context.call_context(tool, args);
    if ctxv != nil { return ok(tool, ctxv); }

    let dbv = debug.call_debug(tool, args);
    if dbv != nil { return ok(tool, dbv); }

    let idv = ide.call_ide(tool, args);
    if idv != nil { return ok(tool, idv); }

    let aiv = aitools.call_ai(tool, args);
    if aiv != nil { return ok(tool, aiv); }

    let qv = quantum.call_quantum(tool, args);
    if qv != nil { return ok(tool, qv); }

    let pjv = projecttools.call_project(tool, args);
    if pjv != nil { return ok(tool, pjv); }

    let wbv = webtools.call_web(tool, args);
    if wbv != nil { return ok(tool, wbv); }

    let mdv = mediatools.call_media(tool, args);
    if mdv != nil { return ok(tool, mdv); }

    let niv = netiot.call_net_iot(tool, args);
    if niv != nil { return ok(tool, niv); }

    let rev2 = retools.call_re(tool, args);
    if rev2 != nil { return ok(tool, rev2); }

    let sbv = sandboxtools.call_sandbox(tool, args);
    if sbv != nil { return ok(tool, sbv); }

    let cmv = completion.call_completion(tool, args);
    if cmv != nil { return ok(tool, cmv); }

    let meta = catalog.find_tool(tool);
    if meta != nil {
        return err(tool, "tool is known from the Rust pb-mcp-server catalog but is not yet natively implemented in pblang; port module '" + meta.source + "' next");
    }
    return err(tool, "unknown tool: " + str(tool));
}

export call, ok, err;
