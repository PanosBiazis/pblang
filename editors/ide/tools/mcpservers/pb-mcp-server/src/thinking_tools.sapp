// Native pblang translations of deterministic planning/reasoning tools.

fn _clip(s, max_chars) {
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated";
}

fn _lines(items, prefix) {
    let out = "";
    for i len(items) {
        if i > 0 { out = out + "\n"; }
        out = out + prefix + str(items[i]);
    }
    return out;
}

fn thinking_plan_skeleton(goal, constraints, max_chars) {
    let out = "Goal: " + str(goal) + "\n";
    out = out + "Constraints:\n" + _lines(constraints, "- ") + "\n";
    out = out + "Plan:\n";
    out = out + "1. Clarify success criteria\n";
    out = out + "2. Inspect current state\n";
    out = out + "3. Make the smallest useful change\n";
    out = out + "4. Verify behavior\n";
    out = out + "5. Record remaining gaps";
    return _clip(out, max_chars);
}

fn thinking_step_back(problem, max_chars) {
    let out = "Step back from: " + str(problem) + "\n";
    out = out + "- What invariant must stay true?\n";
    out = out + "- What evidence do we already have?\n";
    out = out + "- What is the cheapest verification step?\n";
    out = out + "- What would make the current approach wrong?";
    return _clip(out, max_chars);
}

fn thinking_assumption_audit(claims, max_chars) {
    let out = "Assumption audit:\n";
    for i len(claims) {
        out = out + "- claim: " + str(claims[i]) + "\n";
        out = out + "  evidence_needed: direct test, source read, or reproducible command\n";
    }
    return _clip(out, max_chars);
}

fn plan_execution_checklist(milestones, max_chars) {
    let out = "Execution checklist:\n";
    for i len(milestones) {
        out = out + "- [ ] " + str(milestones[i]) + "\n";
    }
    out = out + "- [ ] run verification\n- [ ] update docs/status if behavior changed";
    return _clip(out, max_chars);
}

fn plan_handoff_brief(goal, current_state, next_steps, blockers, max_chars) {
    let out = "Goal:\n" + str(goal) + "\n\n";
    out = out + "Current state:\n" + str(current_state) + "\n\n";
    out = out + "Next steps:\n" + _lines(next_steps, "- ") + "\n\n";
    out = out + "Blockers:\n" + _lines(blockers, "- ");
    return _clip(out, max_chars);
}

fn plan_work_buckets(items, buckets, max_chars) {
    if buckets < 1 { buckets = 1; }
    if buckets > 12 { buckets = 12; }
    let groups = [];
    for b buckets { groups[b] = []; }
    for i len(items) {
        let b = i % buckets;
        groups[b][len(groups[b])] = items[i];
    }
    let out = "";
    for b buckets {
        if b > 0 { out = out + "\n"; }
        out = out + "Bucket " + str(b + 1) + ":\n" + _lines(groups[b], "- ");
    }
    return _clip(out, max_chars);
}

fn plan_risk_register(risks, max_chars) {
    let out = "Risk register:\n";
    for i len(risks) {
        out = out + "- risk: " + str(risks[i]) + "\n";
        out = out + "  mitigation: add a guard, test, or rollback path\n";
        out = out + "  owner: current operator\n";
    }
    return _clip(out, max_chars);
}

fn plan_definition_of_done(outcomes, max_chars) {
    let out = "Definition of done:\n";
    for i len(outcomes) {
        out = out + "- observable outcome: " + str(outcomes[i]) + "\n";
    }
    out = out + "- verification is recorded\n- known limitations are explicit";
    return _clip(out, max_chars);
}

fn reasoning_premortem(project, timeframe, max_chars) {
    let out = "Premortem for " + str(project) + " over " + str(timeframe) + ":\n";
    out = out + "- likely failure: unclear scope\n";
    out = out + "- likely failure: tests do not cover the changed behavior\n";
    out = out + "- likely failure: hidden dependency or environment assumption\n";
    out = out + "- prevention: shrink the next step and verify it";
    return _clip(out, max_chars);
}

fn reasoning_five_whys(seed_problem, max_chars) {
    let out = "Five whys for: " + str(seed_problem) + "\n";
    let current = str(seed_problem);
    for i 5 {
        out = out + str(i + 1) + ". Why? because this needs evidence: " + current + "\n";
        current = "previous answer requires validation";
    }
    return _clip(out, max_chars);
}

fn reasoning_chain(question, facts, max_chars) {
    let out = "Question: " + str(question) + "\nFacts:\n" + _lines(facts, "- ") + "\nReasoning:\n";
    out = out + "1. Separate facts from assumptions\n2. Compare alternatives\n3. Choose the smallest verifiable answer";
    return _clip(out, max_chars);
}

fn reasoning_devils_advocate(claim, context, max_chars) {
    let out = "Claim: " + str(claim) + "\nContext: " + str(context) + "\nCounterpoints:\n";
    out = out + "- What evidence would disprove this?\n";
    out = out + "- Is there a simpler explanation?\n";
    out = out + "- Does the claim depend on stale state?";
    return _clip(out, max_chars);
}

fn reasoning_evidence_matrix(claims, max_chars) {
    let out = "Evidence matrix:\n";
    for i len(claims) {
        out = out + "- claim: " + str(claims[i]) + "\n";
        out = out + "  supporting: pending\n";
        out = out + "  contradicting: pending\n";
        out = out + "  confidence: low until verified\n";
    }
    return _clip(out, max_chars);
}

fn plan_test_strategy(scope, risks, max_chars) {
    let out = "Test strategy for " + str(scope) + ":\n";
    out = out + "- unit tests for pure functions\n";
    out = out + "- integration tests for tool routing\n";
    out = out + "- regression prompts for previous bugs\n";
    out = out + "Risks:\n" + _lines(risks, "- ");
    return _clip(out, max_chars);
}

fn plan_retrospective(iteration, max_chars) {
    let out = "Retrospective: " + str(iteration) + "\n";
    out = out + "- keep: verified changes\n";
    out = out + "- improve: slow or unclear steps\n";
    out = out + "- stop: work without tests\n";
    out = out + "- next: one measurable improvement";
    return _clip(out, max_chars);
}

fn call_thinking(tool, args = nil) {
    if args == nil { args = map{}; }
    if tool == "thinking_plan_skeleton" { return thinking_plan_skeleton(try args.goal catch "", try args.constraints catch [], try args.max_chars catch 4000); }
    if tool == "thinking_step_back" { return thinking_step_back(try args.problem catch "", try args.max_chars catch 4000); }
    if tool == "thinking_assumption_audit" { return thinking_assumption_audit(try args.claims catch [], try args.max_chars catch 4000); }
    if tool == "plan_execution_checklist" { return plan_execution_checklist(try args.milestones catch [], try args.max_chars catch 4000); }
    if tool == "plan_handoff_brief" { return plan_handoff_brief(try args.goal catch "", try args.current_state catch "", try args.next_steps catch [], try args.blockers catch [], try args.max_chars catch 4000); }
    if tool == "plan_work_buckets" { return plan_work_buckets(try args.items catch [], try args.buckets catch 3, try args.max_chars catch 4000); }
    if tool == "plan_risk_register" { return plan_risk_register(try args.risks catch [], try args.max_chars catch 4000); }
    if tool == "plan_definition_of_done" { return plan_definition_of_done(try args.outcomes catch [], try args.max_chars catch 4000); }
    if tool == "reasoning_premortem" { return reasoning_premortem(try args.project catch "", try args.timeframe catch "next iteration", try args.max_chars catch 4000); }
    if tool == "reasoning_five_whys" { return reasoning_five_whys(try args.seed_problem catch "", try args.max_chars catch 4000); }
    if tool == "reasoning_chain" { return reasoning_chain(try args.question catch "", try args.facts catch [], try args.max_chars catch 4000); }
    if tool == "reasoning_devils_advocate" { return reasoning_devils_advocate(try args.claim catch "", try args.context catch "", try args.max_chars catch 4000); }
    if tool == "reasoning_evidence_matrix" { return reasoning_evidence_matrix(try args.claims catch [], try args.max_chars catch 4000); }
    if tool == "plan_test_strategy" { return plan_test_strategy(try args.scope catch "", try args.risks catch [], try args.max_chars catch 4000); }
    if tool == "plan_retrospective" { return plan_retrospective(try args.iteration catch "", try args.max_chars catch 4000); }
    return nil;
}

fn implemented_tools() {
    return [
        "thinking_plan_skeleton",
        "thinking_step_back",
        "thinking_assumption_audit",
        "plan_execution_checklist",
        "plan_handoff_brief",
        "plan_work_buckets",
        "plan_risk_register",
        "plan_definition_of_done",
        "reasoning_premortem",
        "reasoning_five_whys",
        "reasoning_chain",
        "reasoning_devils_advocate",
        "reasoning_evidence_matrix",
        "plan_test_strategy",
        "plan_retrospective",
    ];
}

export implemented_tools, call_thinking,
       thinking_plan_skeleton, thinking_step_back, thinking_assumption_audit,
       plan_execution_checklist, plan_handoff_brief, plan_work_buckets,
       plan_risk_register, plan_definition_of_done, reasoning_premortem,
       reasoning_five_whys, reasoning_chain, reasoning_devils_advocate,
       reasoning_evidence_matrix, plan_test_strategy, plan_retrospective;
