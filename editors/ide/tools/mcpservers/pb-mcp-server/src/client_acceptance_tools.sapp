// Public metadata/dispatch for the pure caller-declaration review.
let CLIENT=import("client_acceptance.sapp");
let SNAPSHOT=import("catalog_snapshot_tools.sapp");
let ACCEPTANCE=import("agent_acceptance.sapp");
fn catalog_entries() {
    // These factories return fresh schemas; tightening this tool must never
    // mutate the contracts of the existing snapshot or acceptance tools.
    let snapshot=SNAPSHOT.catalog_entries()[0].input_schema;
    snapshot.required=["protocol_version","pages","required_tools"];
    snapshot.properties.required_tools.minItems=1;
    let acceptance=ACCEPTANCE.catalog_entries()[0].input_schema;
    let observations=acceptance.properties.observations;observations.maxItems=255;
    let revision=acceptance.properties.revision;
    let schema=map{type:"object",additionalProperties:false,
        required:["revision","discovery","observations"],properties:map{
            revision:revision,observations:observations,
            discovery:map{type:"object",additionalProperties:false,required:["revision","transcript"],
                properties:map{revision:revision,transcript:snapshot}}}};
    return [map{name:"mcp_client_acceptance_review",category:"mcp",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/client_acceptance_tools.sapp",
        description:"Review caller-supplied complete MCP discovery and declared initialize/successful_call/malformed_call/connection_closed checks for the same opaque revision. At least one required tool; up to16 pages,256 tools,128 required names and255 observations. The catalog observation is generated internally; a duplicate is refused. Ready only when all five checks pass for the target revision. No live client connection, tool execution, authenticated evidence, package authentication, client-integration verification or permission grant. Returns counts/statuses and missing names, never descriptions/schemas/cursors/result bodies. Caller data remains untrusted; safe_to_log:false.",
        input_schema:schema}];
}
fn implemented_tools(){return ["mcp_client_acceptance_review"];}
fn call_client(name,args) {
    if name=="mcp_client_acceptance_review" {return CLIENT.review(args);}
    return nil;
}
fn call_client_acceptance(name,args) { return call_client(name,args); }
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded discovery and revision-bound caller declarations; no execution or attestation",
        evidence_ids:["pb_mcp_client_acceptance:core","pb_mcp_client_acceptance:dispatch","pb_mcp_client_acceptance:transport"]}];
}
export catalog_entries, implemented_tools, call_client, call_client_acceptance, functional_records;
