// Native pblang translations for read-only codebase/find/extract tools.

let FS = import("stdlib:fs.sapp");
let sec = import("security.sapp");
let core = import("core_tools.sapp");
let text_tools = import("text_tools.sapp");

fn _clamp_files(n) {
    return sec.clamp(n, 1, sec.MAX_LIST_ENTRIES);
}

fn _is_file(path) {
    let raw = try FS.read(path) catch nil;
    return type(raw) == "string";
}

fn _basename(path) {
    let parts = str_split(str_replace_all(str(path), "\\", "/"), "/");
    if len(parts) == 0 { return str(path); }
    return parts[len(parts) - 1];
}

fn _extension(path) {
    let base = _basename(path);
    let parts = str_split(base, ".");
    if len(parts) <= 1 { return ""; }
    return parts[len(parts) - 1];
}

fn _lines(text) {
    return str_split(str(text), "\n");
}

fn _words(text) {
    let s = str_lower(str(text));
    let out_text = "";
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if str_contains(allowed, ch) { out_text = out_text + ch; }
        else { out_text = out_text + " "; }
    }
    let raw = str_split(out_text, " ");
    let out = [];
    for i len(raw) {
        let w = str_trim(raw[i]);
        if w != "" { out[len(out)] = w; }
    }
    return out;
}

fn _top_counts(counts, limit) {
    let keys = map_keys(counts);
    let used = map{};
    let out = [];
    let n = sec.clamp(limit, 1, 500);
    for rank n {
        let best = nil;
        let best_count = -1;
        for i len(keys) {
            let k = keys[i];
            if (try used[k] catch false) != true and counts[k] > best_count {
                best = k;
                best_count = counts[k];
            }
        }
        if best != nil {
            used[best] = true;
            out[len(out)] = map{ term: best, count: best_count };
        }
    }
    return out;
}

fn _inc_count(counts, key, amount) {
    let cur = try counts[key] catch 0;
    counts[key] = cur + amount;
    return counts;
}

fn _path_list(dir, max_entries, max_depth) {
    return core.list_files(
        sec.safe_rel_path(dir, "."),
        _clamp_files(max_entries),
        sec.clamp(max_depth, 0, sec.MAX_DEPTH)
    );
}

fn _wildcard_match(pattern, text) {
    pattern = str(pattern);
    text = str(text);
    if pattern == "" or pattern == "*" or pattern == "**/*" { return true; }
    if not str_contains(pattern, "*") { return pattern == text; }
    let parts = str_split(pattern, "*");
    let pos = 0;
    for i len(parts) {
        let part = parts[i];
        if part != "" {
            let rest = str_slice(text, pos, len(text));
            let idx = str_index_of(rest, part);
            if idx < 0 { return false; }
            pos = pos + idx + len(part);
        }
    }
    if not str_starts_with(pattern, "*") and not str_starts_with(text, parts[0]) { return false; }
    if not str_ends_with(pattern, "*") and len(parts) > 0 and not str_ends_with(text, parts[len(parts) - 1]) { return false; }
    return true;
}

fn codebase_path_list(args) {
    let dir = try args.dir catch try args.path catch ".";
    let paths = _path_list(dir, try args.max_entries catch sec.MAX_LIST_ENTRIES, try args.max_depth catch sec.MAX_DEPTH);
    let out = [];
    for i len(paths) {
        if _is_file(paths[i]) { out[len(out)] = paths[i]; }
    }
    return out;
}

fn find_files(args) {
    let pattern = try args.pattern catch try args.glob catch "*";
    let paths = codebase_path_list(args);
    let out = [];
    let limit = _clamp_files(try args.max_results catch try args.max_entries catch 500);
    for i len(paths) {
        if len(out) >= limit { return out; }
        if _wildcard_match(pattern, paths[i]) { out[len(out)] = paths[i]; }
    }
    return out;
}

fn find_files_by_name(args) {
    let query = str_lower(str(try args.query catch try args.name catch ""));
    let paths = codebase_path_list(args);
    let out = [];
    let limit = _clamp_files(try args.max_results catch 500);
    for i len(paths) {
        if len(out) >= limit { return out; }
        if query == "" or str_contains(str_lower(paths[i]), query) { out[len(out)] = paths[i]; }
    }
    return out;
}

fn codebase_largest_files(args) {
    let paths = codebase_path_list(args);
    let rows = [];
    for i len(paths) {
        let size = try FS.size(paths[i]) catch 0;
        rows[len(rows)] = map{ path: paths[i], bytes: size };
    }
    let out = [];
    let used = map{};
    let limit = sec.clamp(try args.limit catch 25, 1, 200);
    for rank limit {
        let best = -1;
        let best_i = -1;
        for i len(rows) {
            if (try used[str(i)] catch false) != true and rows[i].bytes > best {
                best = rows[i].bytes;
                best_i = i;
            }
        }
        if best_i >= 0 {
            used[str(best_i)] = true;
            out[len(out)] = rows[best_i];
        }
    }
    return out;
}

fn codebase_duplicate_basenames(args) {
    let paths = codebase_path_list(args);
    let groups = map{};
    for i len(paths) {
        let b = _basename(paths[i]);
        let arr = try groups[b] catch [];
        arr[len(arr)] = paths[i];
        groups[b] = arr;
    }
    let out = [];
    let keys = map_keys(groups);
    for i len(keys) {
        let arr = groups[keys[i]];
        if len(arr) > 1 { out[len(out)] = map{ basename: keys[i], paths: arr, count: len(arr) }; }
    }
    return out;
}

fn codebase_index(args) {
    let paths = codebase_path_list(args);
    let ext_counts = map{};
    let ext_bytes = map{};
    let symbols = [];
    let sketch = try args.symbol_sketch catch true;
    let total_bytes = 0;
    for i len(paths) {
        let ext = _extension(paths[i]);
        if ext == "" { ext = "[none]"; }
        _inc_count(ext_counts, ext, 1);
        let size = try FS.size(paths[i]) catch 0;
        _inc_count(ext_bytes, ext, size);
        total_bytes = total_bytes + size;
        if sketch == true and len(symbols) < 300 {
            let raw = try FS.read(paths[i]) catch "";
            let lines = _lines(raw);
            for j len(lines) {
                let t = str_trim(lines[j]);
                if str_starts_with(t, "fn ") or str_starts_with(t, "class ") or str_starts_with(t, "def ") or str_starts_with(t, "struct ") {
                    symbols[len(symbols)] = map{ path: paths[i], line: j + 1, text: t };
                }
                if len(symbols) >= 300 { break; }
            }
        }
    }
    return map{ files: len(paths), bytes: total_bytes, extensions: ext_counts, extension_bytes: ext_bytes, symbols: symbols };
}

fn codebase_word_index(args) {
    let paths = codebase_path_list(args);
    let counts = map{};
    let max_files = sec.clamp(try args.max_files catch 200, 1, sec.MAX_LIST_ENTRIES);
    let sample_chars = sec.clamp(try args.sample_chars catch 8192, 128, 65536);
    let used = 0;
    for i len(paths) {
        if used >= max_files { break; }
        let raw = try FS.read(paths[i]) catch "";
        if len(raw) > sample_chars { raw = str_slice(raw, 0, sample_chars); }
        let words = _words(raw);
        for j len(words) {
            let w = words[j];
            if len(w) >= 2 { counts[w] = (try counts[w] catch 0) + 1; }
        }
        used = used + 1;
    }
    return map{ files_sampled: used, top_terms: _top_counts(counts, try args.limit catch 50) };
}

fn codebase_cargo_dependency_names(args) {
    let path = try args.path catch "Cargo.toml";
    let raw = try core.read_file(path, nil, nil, sec.MAX_READ_CHARS) catch "";
    let lines = _lines(raw);
    let in_deps = false;
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_starts_with(t, "[") {
            in_deps = t == "[dependencies]" or t == "[dev-dependencies]" or t == "[build-dependencies]";
        } else if in_deps and t != "" and not str_starts_with(t, "#") {
            let parts = str_split(t, "=");
            let name = str_trim(parts[0]);
            if name != "" { out[len(out)] = name; }
        }
    }
    return out;
}

fn codebase_shallow_hash(args) {
    let paths = codebase_path_list(args);
    let max_bytes = sec.clamp(try args.max_bytes_per_file catch 4096, 16, 65536);
    let acc = "";
    for i len(paths) {
        let raw = try FS.read(paths[i]) catch "";
        if len(raw) > max_bytes { raw = str_slice(raw, 0, max_bytes); }
        acc = acc + paths[i] + ":" + text_tools.text_djb2_hash(raw) + "\n";
    }
    return map{ algorithm: "path-plus-djb2-sample-pblang", files: len(paths), hash: text_tools.text_djb2_hash(acc) };
}

fn _snippet_from_lines(lines, path, line_idx, context) {
    let start = line_idx - context;
    if start < 0 { start = 0; }
    let end = line_idx + context;
    let rows = [];
    let i = start;
    while i <= end and i < len(lines) {
        rows[len(rows)] = map{ line: i + 1, text: lines[i] };
        i = i + 1;
    }
    return map{ path: path, line: line_idx + 1, rows: rows };
}

fn extract_snippets(args) {
    let text = try args.text catch "";
    let pattern = try args.pattern catch "";
    let context = sec.clamp(try args.context catch 2, 0, 20);
    let max_matches = sec.clamp(try args.max_matches catch 50, 1, 200);
    let lines = _lines(text);
    let out = [];
    for i len(lines) {
        if len(out) >= max_matches { return out; }
        if pattern == "" or str_contains(lines[i], pattern) {
            out[len(out)] = _snippet_from_lines(lines, try args.path catch "[text]", i, context);
        }
    }
    return out;
}

fn extract_snippets_from_file(args) {
    let path = sec.safe_rel_path(try args.path catch "", ".");
    let raw = core.read_file(path, nil, nil, try args.max_chars catch sec.MAX_READ_CHARS);
    args.text = raw;
    args.path = path;
    return extract_snippets(args);
}

fn grep_snippets(args) {
    let matches = core.grep_code(try args.pattern catch "", try args.dir catch try args.path catch ".", try args.max_matches catch 50);
    let out = [];
    let context = sec.clamp(try args.context catch 2, 0, 20);
    for i len(matches) {
        let raw = try FS.read(matches[i].path) catch "";
        let lines = _lines(raw);
        out[len(out)] = _snippet_from_lines(lines, matches[i].path, matches[i].line - 1, context);
    }
    return out;
}

fn call_codebase(tool, args) {
    if args == nil { args = map{}; }
    if tool == "codebase_path_list" { return codebase_path_list(args); }
    if tool == "find_files" { return find_files(args); }
    if tool == "find_files_by_name" { return find_files_by_name(args); }
    if tool == "codebase_largest_files" { return codebase_largest_files(args); }
    if tool == "codebase_duplicate_basenames" { return codebase_duplicate_basenames(args); }
    if tool == "codebase_index" { return codebase_index(args); }
    if tool == "codebase_word_index" { return codebase_word_index(args); }
    if tool == "codebase_cargo_dependency_names" { return codebase_cargo_dependency_names(args); }
    if tool == "codebase_shallow_hash" { return codebase_shallow_hash(args); }
    if tool == "extract_snippets" { return extract_snippets(args); }
    if tool == "extract_snippets_from_file" { return extract_snippets_from_file(args); }
    if tool == "grep_snippets" { return grep_snippets(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "codebase_path_list",
        "find_files",
        "find_files_by_name",
        "codebase_largest_files",
        "codebase_duplicate_basenames",
        "codebase_index",
        "codebase_word_index",
        "codebase_cargo_dependency_names",
        "codebase_shallow_hash",
        "extract_snippets",
        "extract_snippets_from_file",
        "grep_snippets",
    ];
}

export implemented_tools, call_codebase,
       codebase_path_list, find_files, find_files_by_name,
       codebase_largest_files, codebase_duplicate_basenames,
       codebase_index, codebase_word_index, codebase_cargo_dependency_names,
       codebase_shallow_hash, extract_snippets, extract_snippets_from_file,
       grep_snippets;
