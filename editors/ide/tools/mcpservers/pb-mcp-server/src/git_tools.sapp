// Native pblang translations for read-only local git tools.

let sec = import("src/security.sapp");
let codebase = import("src/codebase_tools.sapp");

fn _clip(s, max_chars) {
    max_chars = sec.clamp(max_chars, 1, 200000);
    s = str(s);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _safe_arg(value, fallback) {
    if value == nil or value == "" { return fallback; }
    let s = str(value);
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/@:{}^~+-";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if not str_contains(allowed, ch) { throw "unsafe git argument: " + s; }
    }
    return s;
}

fn _safe_path_arg(value) {
    if value == nil or value == "" { return ""; }
    let p = sec.safe_rel_path(str(value), "");
    return _safe_arg(p, "");
}

fn _run(cmd, max_chars) {
    let out = try exec(cmd) catch nil;
    if out == nil {
        return map{ ok: false, command: cmd, stdout: "", error: "git command failed or git is unavailable" };
    }
    return map{ ok: true, command: cmd, stdout: _clip(out, max_chars) };
}

fn git_status(args) {
    return _run("git status --short --branch", try args.max_chars catch 40000);
}

fn git_remote_list(args) {
    return _run("git remote -v", try args.max_chars catch 40000);
}

fn git_branches(args) {
    return _run("git branch -a -v", try args.max_chars catch 80000);
}

fn git_tag_list(args) {
    let pattern = _safe_arg(try args.pattern catch "", "");
    let cmd = "git tag -l";
    if pattern != "" { cmd = cmd + " " + pattern; }
    return _run(cmd, try args.max_chars catch 80000);
}

fn git_worktree_list(args) {
    return _run("git worktree list", try args.max_chars catch 40000);
}

fn git_describe(args) {
    return _run("git describe --tags --always --dirty", try args.max_chars catch 40000);
}

fn git_last_commit(args) {
    let mode = try args.mode catch "medium";
    let fmt = "--pretty=medium";
    if mode == "oneline" { fmt = "--oneline"; }
    if mode == "subject" { fmt = "--pretty=%s"; }
    return _run("git log -1 " + fmt, try args.max_chars catch 40000);
}

fn git_log(args) {
    let n = sec.clamp(try args.max_count catch try args.limit catch 20, 1, 200);
    let path = _safe_path_arg(try args.path catch "");
    let cmd = "git log --oneline -n " + str(n);
    if path != "" { cmd = cmd + " -- " + path; }
    return _run(cmd, try args.max_chars catch 80000);
}

fn git_reflog(args) {
    let n = sec.clamp(try args.max_count catch try args.limit catch 30, 1, 200);
    return _run("git reflog -n " + str(n), try args.max_chars catch 80000);
}

fn git_shortlog(args) {
    return _run("git shortlog -sn HEAD", try args.max_chars catch 80000);
}

fn git_ls_files(args) {
    let mode = try args.mode catch "tracked";
    let cmd = "git ls-files";
    if mode == "untracked" { cmd = "git ls-files -o --exclude-standard"; }
    if mode == "all" { cmd = "git ls-files -co --exclude-standard"; }
    return _run(cmd, try args.max_chars catch 120000);
}

fn git_diff_stat(args) {
    let staged = try args.staged catch false;
    let rev = _safe_arg(try args.revision_range catch "", "");
    let cmd = "git diff --stat";
    if staged == true { cmd = cmd + " --cached"; }
    else if rev != "" { cmd = cmd + " " + rev; }
    return _run(cmd, try args.max_chars catch 80000);
}

fn git_diff(args) {
    let staged = try args.staged catch false;
    let path = _safe_path_arg(try args.path catch "");
    let cmd = "git diff --no-color";
    if staged == true { cmd = cmd + " --cached"; }
    if path != "" { cmd = cmd + " -- " + path; }
    return _run(cmd, try args.max_chars catch 120000);
}

fn git_show(args) {
    let rev = _safe_arg(try args.rev catch try args.revision catch "HEAD", "HEAD");
    let patch = try args.patch catch false;
    let cmd = "git show --no-color";
    if patch != true { cmd = cmd + " --stat"; }
    return _run(cmd + " " + rev, try args.max_chars catch 120000);
}

fn git_rev_parse(args) {
    let refs = try args.refs catch nil;
    if refs == nil { refs = [try args.rev catch try args.ref catch "HEAD"]; }
    let out = [];
    for i len(refs) {
        let r = _safe_arg(refs[i], "HEAD");
        out[len(out)] = map{ ref: r, result: _run("git rev-parse " + r, 40000) };
    }
    return out;
}

fn git_merge_base(args) {
    let a = _safe_arg(try args.a catch "HEAD", "HEAD");
    let b = _safe_arg(try args.b catch "main", "main");
    return _run("git merge-base " + a + " " + b, try args.max_chars catch 40000);
}

fn git_log_or_diff(args) {
    let mode = try args.mode catch "log";
    if mode == "diff" { return git_diff(args); }
    return git_log(args);
}

fn git_diff_snippets(args) {
    let diff = git_diff(args);
    if diff.ok != true { return diff; }
    return codebase.extract_snippets(map{
        text: diff.stdout,
        pattern: try args.pattern catch "",
        context: try args.context catch 2,
        max_matches: try args.max_matches catch 50,
        path: "[git diff]"
    });
}

fn git_blame(args) {
    let path = _safe_path_arg(try args.path catch try args.file catch "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let start = sec.clamp(try args.start_line catch 1, 1, 1000000);
    let end = sec.clamp(try args.end_line catch start + 40, start, start + 400);
    return _run("git blame -L " + str(start) + "," + str(end) + " -- " + path, try args.max_chars catch 120000);
}

fn call_git(tool, args) {
    if args == nil { args = map{}; }
    if tool == "git_status" or tool == "gk_git_status" { return git_status(args); }
    if tool == "git_remote_list" { return git_remote_list(args); }
    if tool == "git_branches" { return git_branches(args); }
    if tool == "git_tag_list" { return git_tag_list(args); }
    if tool == "git_worktree_list" { return git_worktree_list(args); }
    if tool == "git_describe" { return git_describe(args); }
    if tool == "git_last_commit" { return git_last_commit(args); }
    if tool == "git_log" { return git_log(args); }
    if tool == "git_reflog" { return git_reflog(args); }
    if tool == "git_shortlog" { return git_shortlog(args); }
    if tool == "git_ls_files" { return git_ls_files(args); }
    if tool == "git_diff_stat" { return git_diff_stat(args); }
    if tool == "git_diff" { return git_diff(args); }
    if tool == "git_show" { return git_show(args); }
    if tool == "git_rev_parse" { return git_rev_parse(args); }
    if tool == "git_merge_base" { return git_merge_base(args); }
    if tool == "git_log_or_diff" or tool == "gk_git_log_or_diff" { return git_log_or_diff(args); }
    if tool == "git_diff_snippets" { return git_diff_snippets(args); }
    if tool == "git_blame" or tool == "gk_git_blame" { return git_blame(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "git_status",
        "gk_git_status",
        "git_remote_list",
        "git_branches",
        "git_tag_list",
        "git_worktree_list",
        "git_describe",
        "git_last_commit",
        "git_log",
        "git_reflog",
        "git_shortlog",
        "git_ls_files",
        "git_diff_stat",
        "git_diff",
        "git_show",
        "git_rev_parse",
        "git_merge_base",
        "git_log_or_diff",
        "gk_git_log_or_diff",
        "git_diff_snippets",
        "git_blame",
        "gk_git_blame",
    ];
}

export implemented_tools, call_git,
       git_status, git_remote_list, git_branches, git_tag_list,
       git_worktree_list, git_describe, git_last_commit, git_log, git_reflog,
       git_shortlog, git_ls_files, git_diff_stat, git_diff, git_show,
       git_rev_parse, git_merge_base, git_log_or_diff, git_diff_snippets,
       git_blame;
