// Pure caller-data review. Catalog descriptions and schemas never authorize calls.
let SNAPSHOT = import("catalog_snapshot.sapp");
let CHANGES = import("catalog_changes.sapp");
fn _object(properties, required) {
    return map{type:"object",properties:properties,required:required,additionalProperties:false};
}
fn _schema() {
    let id=map{description:"String IDs use at most 128 UTF-8 bytes and no C0/DEL controls; empty is valid. Numeric IDs are exact safe integers.",anyOf:[map{type:"string",maxLength:128},
        map{type:"integer",minimum:-9007199254740991,maximum:9007199254740991}]};
    let name=map{type:"string",minLength:1,maxLength:128,
        description:"1..128 UTF-8 bytes, no C0/DEL controls. Names do not grant access."};
    let cursor=map{type:"string",maxLength:1024,
        description:"Opaque UTF-8 cursor, at most 1024 bytes. Empty string is valid; omission is distinct from null."};
    let schema=map{type:"object",properties:map{type:map{type:"string",enum:["object"]}},required:["type"]};
    let annotations=_object(map{title:map{type:"string"},readOnlyHint:map{type:"boolean"},
        destructiveHint:map{type:"boolean"},idempotentHint:map{type:"boolean"},openWorldHint:map{type:"boolean"}},[]);
    let descriptor=_object(map{name:name,title:map{type:"string"},description:map{type:"string"},
        inputSchema:schema,outputSchema:schema,annotations:annotations,_meta:map{type:"object"}},
        ["name","inputSchema"]);
    let request=_object(map{jsonrpc:map{type:"string",enum:["2.0"]},id:id,
        method:map{type:"string",enum:["tools/list"]},
        params:_object(map{cursor:cursor,_meta:map{type:"object"}},[])},["jsonrpc","id","method"]);
    let result=_object(map{tools:map{type:"array",maxItems:256,items:descriptor},
        nextCursor:cursor,_meta:map{type:"object"}},["tools"]);
    let response=_object(map{jsonrpc:map{type:"string",enum:["2.0"]},id:id,result:result},
        ["jsonrpc","id","result"]);
    return _object(map{protocol_version:map{type:"string",enum:["2025-06-18"]},
        pages:map{type:"array",minItems:1,maxItems:16,
            items:_object(map{request:request,response:response},["request","response"])},
        required_tools:map{type:"array",maxItems:128,uniqueItems:true,items:name}},
        ["protocol_version","pages"]);
}
fn catalog_entries() {
    return [map{name:"mcp_catalog_snapshot_review",category:"mcp",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/catalog_snapshot_tools.sapp",
        description:"Review a caller-supplied complete MCP 2025-06-18 tools/list transcript. Check opaque cursor continuity, unique request IDs/tool names and required-tool coverage. At most 16 pages, 256 tools, 128 required names; bounded JSON metadata. Return names/counts only, never descriptions, schemas or cursors. No server connection, schema evaluation, tool execution, authentication or permission grant. Caller data remains untrusted and may be private; safe_to_log:false. Incomplete/unsupported transcripts are rejected.",
        input_schema:_schema()},
        map{name:"mcp_catalog_changes_review",category:"mcp",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/catalog_snapshot_tools.sapp",
        description:"Compare two caller-supplied complete MCP 2025-06-18 tools/list transcripts. Report added/removed tool names and changed descriptor field labels, never field values. Each transcript has independent bounded snapshot limits: 16 pages, 256 tools, 128 required names. Map key order and catalog/page order are ignored; array order and omission are significant. Structural changes only: semantic compatibility is not evaluated. No server connection, schema evaluation, tool execution, authentication or permission grant. Metadata and names may be private; safe_to_log:false.",
        input_schema:_object(map{before:_schema(),after:_schema()},["before","after"])}];
}
fn implemented_tools() {
    return ["mcp_catalog_snapshot_review", "mcp_catalog_changes_review"];
}
fn call_snapshot(name,args) {
    if name=="mcp_catalog_snapshot_review" {return SNAPSHOT.review(args);}
    if name=="mcp_catalog_changes_review" {return CHANGES.review(args);}
    return nil;
}
fn call_catalog_snapshot(name,args) { return call_snapshot(name,args); }
export catalog_entries, implemented_tools, call_snapshot, call_catalog_snapshot;
