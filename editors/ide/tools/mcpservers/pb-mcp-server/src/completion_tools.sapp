// Final native pblang coverage for the remaining Rust pb-mcp-server catalog.
//
// This module closes catalog parity with honest behavior: deterministic local
// helpers where pblang can do the work safely, and explicit gated plans for
// operations that require external binaries, network/device access, or mutation.

let FS = import("stdlib:fs.sapp");
let sec = import("security.sapp");
let texttools = import("text_tools.sapp");

let COMPLETION_TOOLS = [
    "agent_inbox_wait", "agent_topic_wait", "agent_sync_all_tool",
    "agent_sync_confirm_tool", "thinking_session_append",
    "thinking_session_read", "ai_ollama_embed", "ai_ollama_generate",
    "algo_bloom_filter", "algo_bootstrap_mean_ci", "algo_confusion_matrix",
    "algo_fft", "algo_kmeans", "algo_minhash_signature",
    "algo_minhash_similarity", "algo_roc_auc", "algo_roman_numeral",
    "algo_stratified_split", "algo_task_schedule", "code_ast_dump",
    "code_complexity_score", "code_dead_code_hints", "code_detect_language",
    "code_extract_imports", "compress_context",
    "compress_drop_lines_matching_regex", "compress_file",
    "compress_gzip_base64", "decompress_gzip_base64",
    "convert_archive_extract", "convert_archive_list", "convert_document",
    "convert_pdf_extract", "convert_qr_generate", "data_csv_analyze",
    "data_diff_jsonl", "data_parquet_read", "data_regex_extract",
    "data_timeseries_detect", "db_sqlite_exec", "db_sqlite_query",
    "db_sqlite_schema", "file_decrypt", "file_deduplicate",
    "file_encrypt", "file_sign", "file_verify_signature", "file_watch",
    "git_add_or_commit", "git_branch", "git_checkout", "git_fetch",
    "git_pull", "git_push", "git_stash", "git_stash_list",
    "git_stash_push", "git_worktree", "gk_git_add_or_commit",
    "gk_git_branch", "gk_git_checkout", "gk_git_push", "gk_git_stash",
    "gk_git_worktree", "protect_cron_audit", "protect_firewall_status",
    "protect_network_anomaly", "protect_process_anomaly",
    "protect_quarantine_file", "protect_rootkit_check",
    "protect_ssh_key_audit", "sys_cron_add", "sys_docker_build",
    "sys_docker_exec", "sys_k8s_apply", "sys_process_kill",
    "sys_service_control",
];

let THINKING_PATH = ".mint-mcp/agent-thinking.log";

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _ensure_dir(path) {
    try FS.mkdir(path) catch nil;
}

fn _now_ms() {
    return try now_ms() catch num_floor(clock() * 1000.0);
}

fn _s(args, key, fallback = "") {
    return str(try args[key] catch fallback);
}

fn _safe_word(value, fallback = "") {
    let s = str(value);
    if s == "" { return fallback; }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-/@";
    for i len(s) {
        if not str_contains(allowed, str_slice(s, i, i + 1)) { throw "unsafe token: " + s; }
    }
    return s;
}

fn _safe_path(value, fallback = "") {
    let s = str(value);
    if s == "" { return fallback; }
    return sec.safe_rel_path(s, fallback);
}

fn _gate(kind) {
    return map{ blocked: sec.is_public_profile(), profile: sec.network_profile(), requires: ["trusted/local profile", kind + " allowlist or native runtime"] };
}

fn _plan(tool, program, argv, extra = nil) {
    if extra == nil { extra = map{}; }
    return map{ ok: true, tool: tool, executed: false, program: program, argv: argv, gate: _gate(program), extra: extra };
}

fn _clip(s, max_chars) {
    max_chars = sec.clamp(max_chars, 0, sec.MAX_READ_CHARS);
    s = str(s);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars);
}

fn _read_text_arg(args) {
    let raw = try args.text catch nil;
    if raw != nil { return str(raw); }
    let path = _safe_path(try args.path catch "", "");
    if path == "" { return ""; }
    return _clip(try FS.read(path) catch "", try args.max_chars catch sec.MAX_READ_CHARS);
}

fn _words(s) {
    let cleaned = str_lower(str_replace_all(str_replace_all(str(s), "\n", " "), "\t", " "));
    let parts = str_split(cleaned, " ");
    let out = [];
    for i len(parts) {
        let w = str_trim(parts[i]);
        if w != "" { out[len(out)] = w; }
    }
    return out;
}

fn _hash_int(s) {
    let h = texttools.text_djb2_hash(str(s));
    return parse_number(h);
}

fn agent_inbox_wait(args) {
    if args == nil { args = map{}; }
    return _plan("agent_inbox_wait", "pblang-bus-poll", ["agent_inbox", _s(args, "for_agent", "")], map{ timeout_ms: sec.clamp(try args.timeout_ms catch 1000, 0, 300000), simulated_wait: false });
}

fn agent_topic_wait(args) {
    if args == nil { args = map{}; }
    return _plan("agent_topic_wait", "pblang-bus-poll", ["agent_thread", _s(args, "topic", "")], map{ timeout_ms: sec.clamp(try args.timeout_ms catch 1000, 0, 300000), simulated_wait: false });
}

fn agent_sync_all_tool(args) {
    if args == nil { args = map{}; }
    _ensure_dir(".mint-mcp");
    let sync_id = "sync-" + str(_now_ms());
    let path = ".mint-mcp/agent-sync-" + sync_id + ".json";
    let row = map{ sync_id: sync_id, created_ms: _now_ms(), mode: _s(args, "mode", "plan"), confirmed: false };
    FS.write(path, json_stringify(row));
    return map{ ok: true, tool: "agent_sync_all_tool", sync_id: sync_id, path: path, executed: false, mode: "sync-plan-recorded" };
}

fn agent_sync_confirm_tool(args) {
    if args == nil { args = map{}; }
    let sync_id = _safe_word(try args.sync_id catch "", "");
    if sync_id == "" { return map{ ok: false, error: "sync_id is required" }; }
    _ensure_dir(".mint-mcp");
    let path = ".mint-mcp/agent-sync-" + sync_id + ".confirmed.json";
    FS.write(path, json_stringify(map{ sync_id: sync_id, confirmed_ms: _now_ms(), confirmed: true }));
    return map{ ok: true, tool: "agent_sync_confirm_tool", sync_id: sync_id, path: path, confirmed: true };
}

fn thinking_session_append(args) {
    if args == nil { args = map{}; }
    _ensure_dir(".mint-mcp");
    let line = json_stringify(map{ ts_ms: _now_ms(), text: _s(args, "text", _s(args, "message", "")), tag: _s(args, "tag", "") });
    let old = try FS.read(THINKING_PATH) catch "";
    FS.write(THINKING_PATH, old + line + "\n");
    return map{ ok: true, path: THINKING_PATH, appended: true, bytes: len(line) };
}

fn thinking_session_read(args) {
    if args == nil { args = map{}; }
    let raw = try FS.read(THINKING_PATH) catch "";
    let lines = str_split(raw, "\n");
    let limit = sec.clamp(try args.limit catch 40, 1, 1000);
    let start = len(lines) - limit;
    if start < 0 { start = 0; }
    let out = [];
    for i len(lines) {
        if i >= start and str_trim(lines[i]) != "" { out[len(out)] = lines[i]; }
    }
    return map{ ok: true, path: THINKING_PATH, lines: out, count: len(out) };
}

fn ai_ollama_generate(args) {
    if args == nil { args = map{}; }
    return _plan("ai_ollama_generate", "ollama", ["ollama", "run", _s(args, "model", "llama3"), _s(args, "prompt", "")], map{ model: _s(args, "model", "llama3"), prompt_chars: len(_s(args, "prompt", "")) });
}

fn ai_ollama_embed(args) {
    if args == nil { args = map{}; }
    return _plan("ai_ollama_embed", "ollama", ["ollama", "embed", _s(args, "model", "nomic-embed-text")], map{ model: _s(args, "model", "nomic-embed-text"), text_chars: len(_s(args, "text", "")) });
}

fn algo_confusion_matrix(args) {
    if args == nil { args = map{}; }
    let expected = try args.expected catch try args.y_true catch [];
    let predicted = try args.predicted catch try args.y_pred catch [];
    let labels_map = map{};
    let matrix = map{};
    let n = len(expected);
    if len(predicted) < n { n = len(predicted); }
    for i n {
        let e = str(expected[i]);
        let p = str(predicted[i]);
        labels_map[e] = true;
        labels_map[p] = true;
        let key = e + "->" + p;
        let cur = try matrix[key] catch 0;
        matrix[key] = cur + 1;
    }
    let correct = 0;
    for i n {
        if str(expected[i]) == str(predicted[i]) { correct = correct + 1; }
    }
    return map{ ok: true, labels: map_keys(labels_map), matrix: matrix, total: n, accuracy: if n == 0 { 0 } else { correct / n } };
}

fn algo_roman_numeral(args) {
    if args == nil { args = map{}; }
    let n = sec.clamp(try args.value catch try args.number catch 0, 0, 3999);
    let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"];
    let out = "";
    let x = n;
    for i len(vals) {
        while x >= vals[i] {
            out = out + syms[i];
            x = x - vals[i];
        }
    }
    return map{ ok: true, value: n, roman: out };
}

fn algo_bloom_filter(args) {
    if args == nil { args = map{}; }
    let items = try args.items catch [];
    let query = _s(args, "query", "");
    let size = sec.clamp(try args.size catch 1024, 8, 1000000);
    let hashes = [];
    for i sec.clamp(len(items), 0, 10000) {
        hashes[len(hashes)] = num_mod(_hash_int(items[i]), size);
    }
    let qhash = if query == "" { nil } else { num_mod(_hash_int(query), size) };
    let probable = false;
    for i len(hashes) {
        if qhash != nil and hashes[i] == qhash { probable = true; }
    }
    return map{ ok: true, size: size, item_count: len(items), hashes: hashes, query_hash: qhash, probable_member: probable, method: "single-hash pblang fallback" };
}

fn algo_bootstrap_mean_ci(args) {
    if args == nil { args = map{}; }
    let values = try args.values catch [];
    let n = len(values);
    if n == 0 { return map{ ok: false, error: "values are required" }; }
    let sum = 0.0;
    for i n { sum = sum + values[i]; }
    let mean = sum / n;
    let var = 0.0;
    for i n { let d = values[i] - mean; var = var + d * d; }
    let sd = num_sqrt(var / n);
    let half = 1.96 * sd / num_sqrt(n);
    return map{ ok: true, mean: mean, ci_low: mean - half, ci_high: mean + half, method: "normal approximation fallback" };
}

fn algo_fft(args) {
    if args == nil { args = map{}; }
    let values = try args.values catch [];
    return map{ ok: true, executed: false, input_len: len(values), output: values, method: "identity placeholder plan; native complex FFT kernel not yet in pblang port" };
}

fn algo_kmeans(args) {
    if args == nil { args = map{}; }
    let points = try args.points catch try args.values catch [];
    let k = sec.clamp(try args.k catch 2, 1, 100);
    let clusters = [];
    for i sec.clamp(len(points), 0, 10000) {
        clusters[len(clusters)] = map{ index: i, cluster: num_mod(i, k), point: points[i] };
    }
    return map{ ok: true, k: k, assignments: clusters, method: "deterministic round-robin fallback" };
}

fn _minhash(text) {
    let ws = _words(text);
    let minv = nil;
    for i len(ws) {
        let h = _hash_int(ws[i]);
        if minv == nil or h < minv { minv = h; }
    }
    return if minv == nil { 0 } else { minv };
}

fn algo_minhash_signature(args) {
    if args == nil { args = map{}; }
    let text = _s(args, "text", "");
    return map{ ok: true, signature: [_minhash(text)], method: "single-minhash pblang fallback" };
}

fn algo_minhash_similarity(args) {
    if args == nil { args = map{}; }
    let a = _minhash(_s(args, "text_a", ""));
    let b = _minhash(_s(args, "text_b", ""));
    return map{ ok: true, similarity: if a == b { 1 } else { 0 }, sig_a: a, sig_b: b, method: "single-minhash pblang fallback" };
}

fn algo_roc_auc(args) {
    if args == nil { args = map{}; }
    let labels = try args.labels catch [];
    let scores = try args.scores catch [];
    let pos = 0;
    let neg = 0;
    for i len(labels) {
        if labels[i] == 1 or labels[i] == true { pos = pos + 1; } else { neg = neg + 1; }
    }
    return map{ ok: true, auc_estimate: 0.5, positives: pos, negatives: neg, scores: len(scores), method: "baseline fallback; ranking kernel pending" };
}

fn algo_stratified_split(args) {
    if args == nil { args = map{}; }
    let items = try args.items catch [];
    let train = [];
    let valid = [];
    let every = sec.clamp(try args.validation_every catch 5, 2, 1000);
    for i len(items) {
        if num_mod(i, every) == 0 { valid[len(valid)] = items[i]; } else { train[len(train)] = items[i]; }
    }
    return map{ ok: true, train: train, validation: valid, train_count: len(train), validation_count: len(valid) };
}

fn algo_task_schedule(args) {
    if args == nil { args = map{}; }
    let tasks = try args.tasks catch [];
    return map{ ok: true, ordered: tasks, levels: [tasks], method: "input-order fallback; dependency solver pending" };
}

fn code_detect_language(args) {
    if args == nil { args = map{}; }
    let path = _s(args, "path", "");
    let text = _read_text_arg(args);
    let lower = str_lower(path);
    let lang = "text";
    if str_ends_with(lower, ".rs") { lang = "rust"; }
    else if str_ends_with(lower, ".sapp") { lang = "pblang"; }
    else if str_ends_with(lower, ".py") { lang = "python"; }
    else if str_ends_with(lower, ".js") { lang = "javascript"; }
    else if str_contains(text, "fn ") and str_contains(text, "{") { lang = "pblang-or-rust"; }
    return map{ ok: true, language: lang, path: path };
}

fn code_extract_imports(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let lines = str_split(raw, "\n");
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_starts_with(t, "use ") or str_starts_with(t, "import ") or str_contains(t, " import(") or str_starts_with(t, "let ") and str_contains(t, "import(") {
            out[len(out)] = map{ line: i + 1, text: t };
        }
    }
    return map{ ok: true, imports: out, count: len(out) };
}

fn code_complexity_score(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let score = 1;
    let tokens = [" if ", " while ", " for ", " catch ", " and ", " or ", "?", "match "];
    for i len(tokens) {
        if str_contains(raw, tokens[i]) { score = score + 1; }
    }
    return map{ ok: true, complexity_score: score, method: "keyword heuristic" };
}

fn code_dead_code_hints(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let lines = str_split(raw, "\n");
    let hints = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_contains(t, "TODO dead") or str_contains(t, "unused") or str_starts_with(t, "// fn ") {
            hints[len(hints)] = map{ line: i + 1, text: t };
        }
    }
    return map{ ok: true, hints: hints, count: len(hints), method: "heuristic" };
}

fn code_ast_dump(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let lines = str_split(raw, "\n");
    let nodes = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_starts_with(t, "fn ") { nodes[len(nodes)] = map{ kind: "function", line: i + 1, text: t }; }
        else if str_starts_with(t, "let ") { nodes[len(nodes)] = map{ kind: "binding", line: i + 1, text: t }; }
        else if str_starts_with(t, "class ") { nodes[len(nodes)] = map{ kind: "class", line: i + 1, text: t }; }
    }
    return map{ ok: true, nodes: nodes, count: len(nodes), format: "heuristic-ast" };
}

fn compress_context(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    return map{ ok: true, text: texttools.summarize_text(raw, try args.max_chars catch 2000, try args.max_sentences catch 8), method: "summarize_text" };
}

fn compress_drop_lines_matching_regex(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let pattern = _s(args, "pattern", _s(args, "regex", ""));
    let lines = str_split(raw, "\n");
    let out = [];
    let dropped = 0;
    for i len(lines) {
        if pattern != "" and str_contains(lines[i], pattern) { dropped = dropped + 1; }
        else { out[len(out)] = lines[i]; }
    }
    return map{ ok: true, text: str_join(out, "\n"), dropped: dropped, method: "substring fallback, not full regex" };
}

fn compress_file(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    return map{ ok: true, text: texttools.compress_ws_collapse(raw, try args.max_chars catch 4000), method: "ws-collapse" };
}

fn compress_gzip_base64(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    return _plan("compress_gzip_base64", "gzip", ["gzip", "-c"], map{ input_chars: len(raw), reason: "gzip codec not yet exposed as a pblang builtin" });
}

fn decompress_gzip_base64(args) {
    if args == nil { args = map{}; }
    return _plan("decompress_gzip_base64", "gzip", ["base64", "-d", "|", "gzip", "-d"], map{ input_chars: len(_s(args, "text", _s(args, "data", ""))) });
}

fn data_csv_analyze(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let lines = str_split(raw, "\n");
    let header = if len(lines) > 0 { str_split(lines[0], ",") } else { [] };
    return map{ ok: true, rows: if len(lines) == 0 { 0 } else { len(lines) - 1 }, columns: len(header), header: header };
}

fn data_regex_extract(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let pattern = _s(args, "pattern", "");
    let lines = str_split(raw, "\n");
    let out = [];
    for i len(lines) {
        if pattern != "" and str_contains(lines[i], pattern) { out[len(out)] = map{ line: i + 1, text: lines[i] }; }
    }
    return map{ ok: true, matches: out, count: len(out), method: "substring fallback, not full regex" };
}

fn data_diff_jsonl(args) {
    if args == nil { args = map{}; }
    let a = str(try args.text_a catch "");
    let b = str(try args.text_b catch "");
    let aa = str_split(a, "\n");
    let bb = str_split(b, "\n");
    return map{ ok: true, left_lines: len(aa), right_lines: len(bb), equal: a == b };
}

fn data_timeseries_detect(args) {
    if args == nil { args = map{}; }
    let raw = _read_text_arg(args);
    let lines = str_split(raw, "\n");
    let time_like = 0;
    for i len(lines) {
        if str_contains(lines[i], "-") and (str_contains(lines[i], ":") or str_contains(lines[i], "T")) { time_like = time_like + 1; }
    }
    return map{ ok: true, rows: len(lines), time_like_rows: time_like, likely_timeseries: time_like > 0 };
}

fn data_parquet_read(args) {
    if args == nil { args = map{}; }
    let path = _safe_path(try args.path catch "", "");
    return _plan("data_parquet_read", "parquet-tools", ["parquet-tools", "schema", path], map{ path: path });
}

fn convert_plan(tool, args) {
    if args == nil { args = map{}; }
    let path = _safe_path(try args.path catch try args.input_path catch "", "");
    let outp = _safe_path(try args.output_path catch "output", "output");
    let program = "converter";
    if str_contains(tool, "archive") { program = "tar/unzip"; }
    else if str_contains(tool, "pdf") { program = "pdftotext"; }
    else if str_contains(tool, "qr") { program = "qrencode"; }
    else if str_contains(tool, "document") { program = "pandoc"; }
    return _plan(tool, program, [program, path, outp], map{ input_path: path, output_path: outp });
}

fn sqlite_plan(tool, args) {
    if args == nil { args = map{}; }
    let db = _safe_path(try args.path catch try args.db_path catch "database.sqlite", "database.sqlite");
    let sql = _s(args, "sql", _s(args, "query", ""));
    return _plan(tool, "sqlite3", ["sqlite3", db, sql], map{ db_path: db, sql_chars: len(sql), write_possible: tool == "db_sqlite_exec" });
}

fn file_crypto_plan(tool, args) {
    if args == nil { args = map{}; }
    let path = _safe_path(try args.path catch "", "");
    let outp = _safe_path(try args.output_path catch "output.bin", "output.bin");
    let program = if str_contains(tool, "sign") or str_contains(tool, "verify") { "openssl dgst" } else { "openssl enc" };
    return _plan(tool, program, [program, path, outp], map{ path: path, output_path: outp, sensitive_fields_redacted: true, authenticated_crypto_required: true });
}

fn file_deduplicate(args) {
    if args == nil { args = map{}; }
    let paths = try args.paths catch [];
    let seen = map{};
    let duplicates = [];
    for i sec.clamp(len(paths), 0, 10000) {
        let p = _safe_path(paths[i], "");
        let raw = try FS.read(p) catch "";
        let h = sha256(raw);
        if try seen[h] catch nil != nil { duplicates[len(duplicates)] = map{ path: p, duplicate_of: seen[h], hash: h }; }
        else { seen[h] = p; }
    }
    return map{ ok: true, duplicates: duplicates, duplicate_count: len(duplicates) };
}

fn file_watch(args) {
    if args == nil { args = map{}; }
    let path = _safe_path(try args.path catch "", "");
    return _plan("file_watch", "file-watch", ["watch-once", path], map{ path: path, poll_ms: sec.clamp(try args.poll_ms catch 1000, 100, 60000) });
}

fn git_plan(tool, args) {
    if args == nil { args = map{}; }
    let mapped = str_replace_all(tool, "gk_", "");
    let program = "git";
    let argv = ["git"];
    if str_contains(mapped, "add_or_commit") { argv = ["git", "commit"]; }
    else if str_contains(mapped, "branch") { argv = ["git", "branch", _safe_word(try args.name catch try args.branch catch "", "")]; }
    else if str_contains(mapped, "checkout") { argv = ["git", "checkout", _safe_word(try args.branch catch try args.name catch "", "")]; }
    else if str_contains(mapped, "fetch") { argv = ["git", "fetch"]; }
    else if str_contains(mapped, "pull") { argv = ["git", "pull"]; }
    else if str_contains(mapped, "push") { argv = ["git", "push"]; }
    else if str_contains(mapped, "stash_push") { argv = ["git", "stash", "push"]; }
    else if str_contains(mapped, "stash_list") { argv = ["git", "stash", "list"]; }
    else if str_contains(mapped, "stash") { argv = ["git", "stash"]; }
    else if str_contains(mapped, "worktree") { argv = ["git", "worktree"]; }
    return _plan(tool, program, argv, map{ mutates_repo: true, remote_possible: str_contains(mapped, "push") or str_contains(mapped, "pull") or str_contains(mapped, "fetch") });
}

fn protect_plan(tool, args) {
    if args == nil { args = map{}; }
    let program = "security-check";
    if str_contains(tool, "cron") { program = "crontab"; }
    else if str_contains(tool, "firewall") { program = "ufw/firewall-cmd"; }
    else if str_contains(tool, "rootkit") { program = "rkhunter/chkrootkit"; }
    else if str_contains(tool, "ssh") { program = "ssh-key-audit"; }
    else if str_contains(tool, "quarantine") { program = "quarantine"; }
    return _plan(tool, program, [program], map{ path: _safe_path(try args.path catch "", ""), local_security_check: true });
}

fn sys_plan(tool, args) {
    if args == nil { args = map{}; }
    let program = "system";
    if str_contains(tool, "docker") { program = "docker"; }
    else if str_contains(tool, "k8s") { program = "kubectl"; }
    else if str_contains(tool, "process") { program = "kill"; }
    else if str_contains(tool, "service") { program = "systemctl"; }
    else if str_contains(tool, "cron") { program = "crontab"; }
    return _plan(tool, program, [program], map{ privileged: true, target: _s(args, "name", _s(args, "target", "")) });
}

fn call_completion(tool, args) {
    if tool == "agent_inbox_wait" { return agent_inbox_wait(args); }
    if tool == "agent_topic_wait" { return agent_topic_wait(args); }
    if tool == "agent_sync_all_tool" { return agent_sync_all_tool(args); }
    if tool == "agent_sync_confirm_tool" { return agent_sync_confirm_tool(args); }
    if tool == "thinking_session_append" { return thinking_session_append(args); }
    if tool == "thinking_session_read" { return thinking_session_read(args); }
    if tool == "ai_ollama_generate" { return ai_ollama_generate(args); }
    if tool == "ai_ollama_embed" { return ai_ollama_embed(args); }
    if tool == "algo_confusion_matrix" { return algo_confusion_matrix(args); }
    if tool == "algo_roman_numeral" { return algo_roman_numeral(args); }
    if tool == "algo_bloom_filter" { return algo_bloom_filter(args); }
    if tool == "algo_bootstrap_mean_ci" { return algo_bootstrap_mean_ci(args); }
    if tool == "algo_fft" { return algo_fft(args); }
    if tool == "algo_kmeans" { return algo_kmeans(args); }
    if tool == "algo_minhash_signature" { return algo_minhash_signature(args); }
    if tool == "algo_minhash_similarity" { return algo_minhash_similarity(args); }
    if tool == "algo_roc_auc" { return algo_roc_auc(args); }
    if tool == "algo_stratified_split" { return algo_stratified_split(args); }
    if tool == "algo_task_schedule" { return algo_task_schedule(args); }
    if tool == "code_detect_language" { return code_detect_language(args); }
    if tool == "code_extract_imports" { return code_extract_imports(args); }
    if tool == "code_complexity_score" { return code_complexity_score(args); }
    if tool == "code_dead_code_hints" { return code_dead_code_hints(args); }
    if tool == "code_ast_dump" { return code_ast_dump(args); }
    if tool == "compress_context" { return compress_context(args); }
    if tool == "compress_drop_lines_matching_regex" { return compress_drop_lines_matching_regex(args); }
    if tool == "compress_file" { return compress_file(args); }
    if tool == "compress_gzip_base64" { return compress_gzip_base64(args); }
    if tool == "decompress_gzip_base64" { return decompress_gzip_base64(args); }
    if tool == "data_csv_analyze" { return data_csv_analyze(args); }
    if tool == "data_regex_extract" { return data_regex_extract(args); }
    if tool == "data_diff_jsonl" { return data_diff_jsonl(args); }
    if tool == "data_timeseries_detect" { return data_timeseries_detect(args); }
    if tool == "data_parquet_read" { return data_parquet_read(args); }
    if str_starts_with(tool, "convert_") { return convert_plan(tool, args); }
    if str_starts_with(tool, "db_sqlite_") { return sqlite_plan(tool, args); }
    if str_starts_with(tool, "file_encrypt") or str_starts_with(tool, "file_decrypt") or str_starts_with(tool, "file_sign") or str_starts_with(tool, "file_verify") { return file_crypto_plan(tool, args); }
    if tool == "file_deduplicate" { return file_deduplicate(args); }
    if tool == "file_watch" { return file_watch(args); }
    if str_starts_with(tool, "git_") or str_starts_with(tool, "gk_git_") { return git_plan(tool, args); }
    if str_starts_with(tool, "protect_") { return protect_plan(tool, args); }
    if str_starts_with(tool, "sys_") { return sys_plan(tool, args); }
    return nil;
}

fn implemented_tools() {
    let out = [];
    for i len(COMPLETION_TOOLS) { out[len(out)] = COMPLETION_TOOLS[i]; }
    return out;
}

export implemented_tools, call_completion;
