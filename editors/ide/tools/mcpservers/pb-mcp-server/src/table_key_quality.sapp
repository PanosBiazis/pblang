// Bounded literal Sheet key-column quality review via stdlib:table_key_quality.sapp.
let KeyQuality = import("stdlib:table_key_quality.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table key quality arguments"; }
fn implemented_tools() { return ["data_table_key_quality"]; }

fn call_key_quality(name, args) {
    if name != "data_table_key_quality" { return nil; }
    if type(args) != "map" or len(args) < 2 or len(args) > 3
       or not map_has(args, "document") or not map_has(args, "key_column") {
        _fail();
    }
    if len(args) == 3 and not map_has(args, "header") {
        _fail();
    }
    for key in map_keys(args) {
        if key != "document" and key != "key_column" and key != "header" {
            _fail();
        }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let header = false;
    if map_has(args, "header") {
        header = args.header;
    }
    if type(header) != "bool" { _fail(); }
    let col = args.key_column;
    if type(col) != "number" or col != num_floor(col) or col < 0 or col >= Sheet.MAX_COLUMNS {
        _fail();
    }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil or col >= size.columns { _fail(); }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let report = try KeyQuality.inspect(args.document, col, header) catch nil;
    if report == nil { _fail(); }
    let out_rows = [];
    for r_entry in report.rows {
        push(out_rows, map{
            row: r_entry.row,
            missing_key: r_entry.missing_key,
            duplicate_of: r_entry.duplicate_of
        });
    }
    let out_indices = [];
    for idx in report.review_indices {
        push(out_indices, idx);
    }
    let result = map{
        format: "pb_mcp.data_table_key_quality.v1",
        source_rows: size.rows,
        column_count: size.columns,
        input_text_bytes: size.text_bytes,
        header: report.header,
        key_column: report.key_column,
        rows_checked: report.rows_checked,
        flagged_rows: report.flagged_rows,
        missing_keys: report.missing_keys,
        duplicate_keys: report.duplicate_keys,
        rows: out_rows,
        review_indices: out_indices,
        review_rows: report.review_rows,
        index_base: 0,
        blank_rule: "str_trim_empty",
        comparison: "exact_utf8_codepoint",
        types_inferred: false,
        formulas_evaluated: false,
        contains_cell_text: false,
        contains_headers: false,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows and 1..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL."
    };
    return [map{
        name: "data_table_key_quality",
        category: "table-review",
        profile: "core-code",
        source: "src/table_key_quality.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document", "key_column"],
            additionalProperties: false,
            properties: map{
                document: document,
                key_column: map{
                    type: "integer",
                    minimum: 0,
                    maximum: 7,
                    description: "Zero-based key column index within 0..columns-1."
                },
                header: map{
                    type: "boolean",
                    default: false,
                    description: "When true, row 0 is treated as a header row and excluded from key inspection."
                }
            }
        },
        description: "Inspect a single zero-based key column of a caller-supplied literal pblang.sheet-document.v1 for blank (trimmed-empty) keys and exact literal duplicate keys. With header=true, row 0 is excluded from key checks. Returns zero-based flagged row records (row, missing_key, duplicate_of) and sorted review_indices (including first occurrences of duplicated keys) suitable for data_table_select_rows. No cell text or header strings are returned; coordinates remain caller-private (safe_to_log:false). Serialized arguments and result each <=65536 UTF8bytes. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet single-column key quality inspection with zero-text coordinate diagnostics and pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_table_key_quality:missing_and_duplicate_keys",
                "pb_mcp_table_key_quality:header_and_column_bounds",
                "pb_mcp_table_key_quality:detached_results",
                "pb_mcp_table_key_quality:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_key_quality, catalog_entries, functional_records;
