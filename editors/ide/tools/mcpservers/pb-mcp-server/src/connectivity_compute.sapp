// Bounded offline GPS and microcontroller metadata; no device is opened.
let NMEA=import("stdlib:nmea.sapp");
let TARGETS=import("stdlib:embedded_targets.sapp");
fn _args(value,allowed){
    if type(value)!="map"{throw "connectivity: expected object";}
    for key in map_keys(value){let found=false;for i len(allowed){if key==allowed[i]{found=true;}}if not found{throw "connectivity: unknown argument";}}
}
fn _text(value,limit){if type(value)!="string" or len(value)<1 or len(value)>limit{throw "connectivity: invalid text";}return value;}
fn call_connectivity(tool,args){
    let out:any=nil;
    if tool=="gps_nmea_summary"{
        _args(args,["sentences","include_location","coordinate_decimals"]);
        let sentences=try args.sentences catch nil;
        if type(sentences)!="array" or len(sentences)>32{throw "connectivity: invalid batch";}
        let location_enabled=try args.include_location catch false;
        let decimals=try args.coordinate_decimals catch 2;
        if type(location_enabled)!="bool" or type(decimals)!="number" or decimals!=num_floor(decimals) or decimals<0 or decimals>4{throw "connectivity: invalid location policy";}
        let rows=[];let valid=0;
        for i len(sentences){
            _text(sentences[i],84);let record=NMEA.parse(sentences[i]);
            let row=map{ok:record.ok};
            if record.ok{
                valid=valid+1;row.sentence_type=record.sentence_type;row.fix_valid=record.fix.valid;
                // Invalid/stale fixes never return coordinates, even when supplied.
                if location_enabled and record.fix.valid{row.location=NMEA.privacy_view(record,decimals).location;}
            }
            if not record.ok {row.code=record.code;}
            rows[len(rows)]=row;
        }
        out=map{records:rows,count:len(rows),valid:valid,location_requested:location_enabled,
            coordinate_decimals:decimals,raw_sentence_included:false,device_opened:false};
    }
    if tool=="microcontroller_catalog"{
        _args(args,[]);out=map{boards:TARGETS.boards(),coverage:TARGETS.coverage(),device_opened:false};
    }
    if tool=="microcontroller_inspect"{
        _args(args,["board","pin"]);let board=_text(try args.board catch nil,64);
        let pin=try args.pin catch nil;if pin!=nil{_text(pin,32);}
        out=TARGETS.inspect_pin(board,pin);out.device_opened=false;
    }
    if out==nil{return nil;}
    out.effects_performed=false;out.native_pblang=true;out.instructions_from_data=false;
    out.hardware_presence_verified=false;return out;
}
fn implemented_tools(){return ["gps_nmea_summary","microcontroller_catalog","microcontroller_inspect"];}
fn catalog_entries(){
    let empty=map{type:"object",properties:map{},required:[],additionalProperties:false};
    let schemas=[map{type:"object",properties:map{
        sentences:map{type:"array",maxItems:32,items:map{type:"string",minLength:1,maxLength:84}},
        include_location:map{type:"boolean",default:false},coordinate_decimals:map{type:"integer",minimum:0,maximum:4,default:2}},required:["sentences"],additionalProperties:false},empty,
        map{type:"object",properties:map{board:map{type:"string",minLength:1,maxLength:64},pin:map{type:"string",minLength:1,maxLength:32}},required:["board"],additionalProperties:false}];
    let descriptions=["Validate up to32 caller-supplied GGA/RMC GPS sentences. No receiver access. Coordinates omitted by default; opt-in rounded0..4 decimals only for valid fixes. No raw sentences/timestamps/identifiers returned.",
        "List PBLang microcontroller board descriptors and compiler coverage. Offline metadata only, not connected hardware discovery or proof of flashing support.",
        "Inspect a known board/pin and warnings using the shared PBLang embedded registry. Physical capabilities and implemented compiler operations are distinct. No port opening, reset or flashing."];
    let names=implemented_tools();let out=[];
    for i len(names){out[len(out)]=map{name:names[i],category:"connectivity",profile:"core-code",read_only:true,destructive:false,open_world:false,source:"src/connectivity_compute.sapp",description:descriptions[i],input_schema:schemas[i]};}return out;
}
fn functional_records(){let out=[];let entries=catalog_entries();for i len(entries){out[len(out)]=map{name:entries[i].name,status:"complete",public_mcp:true,input_schema:entries[i].input_schema,reason:"bounded offline computation; no device effects",evidence_ids:["pb_mcp_connectivity:bounded","pb_mcp_connectivity:privacy"]};}return out;}
export call_connectivity,implemented_tools,catalog_entries,functional_records;
