fn catalog_entries() {
    let names = implemented_tools();
    let out = [];
    for i len(names) {
        out[len(out)] = map{
            name: names[i],
            category: "omni_960_gap_zero_v30",
            profile: "core-ai",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/omni_960_gap_zero_tools.sapp",
