// Bounded declaration planning only; no provider discovery or execution.
let MODULARITY=import("stdlib:controlled_modularity.sapp");

fn call_modularity(tool,args) {
    if tool!="module_contract_plan" {return nil;}
    if type(args)!="map" or len(args)>3 {throw "modularity: invalid arguments";}
    for key in map_keys(args) {
        if key!="contract_json" and key!="root" and key!="available" {throw "modularity: unknown argument";}
    }
    let text=try args.contract_json catch nil;
    let root=try args.root catch nil;
    let available=try args.available catch [];
    if type(text)!="string" or len(text)>MODULARITY.MAX_BYTES
        or type(root)!="string" or len(root)<1 or len(root)>64
        or type(available)!="array" or len(available)>64 {throw "modularity: invalid arguments";}
    // Shared strict parsing also enforces the UTF-8 byte limit, depth, item
    // count, duplicate JSON keys and the closed contract schema. The resolver
    // validates identifier characters and unique bounded capability claims.
    let parsed=MODULARITY.parse(text);
    let plan=MODULARITY.resolve(if parsed.ok {parsed.document} else {map{}},root,available);
    plan.plan_only=true;
    plan.capability_source="caller_claims";
    plan.permission_granted=false;
    return plan;
}

fn implemented_tools() {return ["module_contract_plan"];}

fn catalog_entries() {
    let identifier=map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z0-9_.-]+$"};
    let schema=map{type:"object",properties:map{
        contract_json:map{type:"string",maxLength:262144},root:identifier,
        available:map{type:"array",maxItems:64,uniqueItems:true,items:identifier,default:[]}},
        required:["contract_json","root"],additionalProperties:false};
    return [map{name:"module_contract_plan",category:"modularity",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/modularity_tools.sapp",
        description:"Plan a caller-supplied controlled-modularity v1 JSON contract up to262144 UTF-8 bytes. Resolve the selected root with exact package/interface pins, required dependencies, optional absence/fallback and cycle checks. Available capability IDs are unverified caller claims, omitted means none. Returns static plan metadata only; no provider discovery, file access, module execution or permission grant.",
        input_schema:schema}];
}

fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"complete bounded static planner; availability is caller-declared and no runtime authority is granted",
        evidence_ids:["pb_mcp_modularity:positive","pb_mcp_modularity:negative","pb_mcp_modularity:schema-privacy"]}];
}

export call_modularity,implemented_tools,catalog_entries,functional_records;
