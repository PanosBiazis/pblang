// Compare bounded caller declarations only; never run a compiler or infer authority.
fn _object(value,fields) {
    if type(value)!="map" {throw "diagnostics: invalid object";}
    if len(value)!=len(fields) {throw "diagnostics: invalid properties";}
    for field in fields {
        if map_has(value,field) {continue;}
        throw "diagnostics: invalid properties";
    }
}
fn _id(value) {
    if type(value)!="string" {throw "diagnostics: invalid identifier";}
    if len(value)<1 or len(value)>64 {throw "diagnostics: invalid identifier";}
    // ASCII admission makes Unicode scalar and UTF-8 byte limits identical.
    if not regex_match(value,"^[A-Za-z0-9_.:-]+$") {throw "diagnostics: invalid identifier";}
}
fn _snapshot(rows) {
    if type(rows)!="array" {throw "diagnostics: invalid snapshot";}
    if len(rows)>512 {throw "diagnostics: snapshot limit exceeded";}
    let index=map{};
    for row in rows {
        _object(row,["id","module","code","severity"]);
        _id(row.id);_id(row.module);_id(row.code);
        if type(row.severity)!="string" {throw "diagnostics: invalid severity";}
        if row.severity!="error" and row.severity!="warning"
            and row.severity!="info" and row.severity!="hint" {throw "diagnostics: invalid severity";}
        if map_has(index,row.id) {throw "diagnostics: duplicate identifier";}
        index[row.id]=row;
    }
    return index;
}
fn _copy(row) {
    // Every leaf is a validated immutable string; never return caller maps.
    return map{id:row.id,module:row.module,code:row.code,severity:row.severity};
}
fn compare(args) {
    _object(args,["baseline","current"]);
    let baseline=_snapshot(args.baseline);let current=_snapshot(args.current);
    let added=[];let resolved=[];let changed=[];let unchanged=[];
    // Complete validation precedes output; baseline order defines these three lists.
    for before in args.baseline {
        if not map_has(current,before.id) {
            resolved[len(resolved)]=_copy(before);
            continue;
        }
        let after=current[before.id];
        // Unchanged rows need no temporary changed-fields arrays. Both snapshots
        // were fully validated above; this branch does not skip admission checks.
        if before.module==after.module and before.code==after.code and before.severity==after.severity {
            unchanged[len(unchanged)]=before.id;
            continue;
        }
        let fields=[];
        if before.module!=after.module {fields[len(fields)]="module";}
        if before.code!=after.code {fields[len(fields)]="code";}
        if before.severity!=after.severity {fields[len(fields)]="severity";}
        changed[len(changed)]=map{id:before.id,before:_copy(before),after:_copy(after),changed_fields:fields};
    }
    for after in args.current {
        if not map_has(baseline,after.id) {added[len(added)]=_copy(after);}
    }
    return map{format:"pb_mcp.diagnostics_compare.v1",new:added,resolved:resolved,
        changed:changed,unchanged_ids:unchanged,baseline_count:len(args.baseline),current_count:len(args.current),
        counts:map{new:len(added),resolved:len(resolved),changed:len(changed),unchanged:len(unchanged)},
        identity_rule:"exact_case_sensitive_caller_id",resolved_meaning:"absent_from_supplied_current_snapshot",
        native_pblang:true,data_source:"caller_supplied",data_provenance:"untrusted_caller_supplied",
        id_stability_verified:false,snapshot_completeness_verified:false,compiler_executed:false,
        checks_executed:false,evidence_authenticated:false,independently_verified:false,regression_verified:false,
        effects_performed:false,permission_granted:false,instructions_from_data:false,safe_to_log:false,
        network_used:false,model_loaded:false};
}
fn call_diagnostics(name,args) {if name=="diagnostics_compare" {return compare(args);}return nil;}
fn implemented_tools() {return ["diagnostics_compare"];}
fn catalog_entries() {
    let id=map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z0-9_.:-]+$"};
    let record=map{type:"object",required:["id","module","code","severity"],additionalProperties:false,
        properties:map{id:id,module:id,code:id,severity:map{type:"string",enum:["error","warning","info","hint"]}}};
    let snapshot=map{type:"array",minItems:0,maxItems:512,items:record,
        description:"Caller-declared records with unique case-sensitive IDs within this snapshot; duplicate IDs are rejected even when records agree."};
    return [map{name:"diagnostics_compare",category:"agent-assistance",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/agent_diagnostics.sapp",
        description:"Compare two caller-declared diagnostic snapshots of up to512 exact id/module/code/severity records each. Correlate exact case-sensitive IDs only; new follows current order, resolved/changed/unchanged_ids follow baseline order. Changed fields use module/code/severity order. Resolved means absent from supplied current, not proved fixed. Caller ID stability and snapshot completeness are unverified; ID churn can produce new/resolved pairs and reused IDs can miscorrelate. No messages, paths, compilation, readiness, regression attestation or permission grant. IDs may be private: safe_to_log:false.",
        input_schema:map{type:"object",required:["baseline","current"],additionalProperties:false,
            properties:map{baseline:snapshot,current:snapshot}}}];
}
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded exact-ID comparison of caller-declared diagnostic metadata; no compilation or attestation",
        evidence_ids:["pb_mcp_agent_diagnostics:states","pb_mcp_agent_diagnostics:identity",
            "pb_mcp_agent_diagnostics:bounds","pb_mcp_agent_diagnostics:privacy","pb_mcp_agent_diagnostics:mutation"]}];
}
export compare,call_diagnostics,implemented_tools,catalog_entries,functional_records;
