// Single-request process-isolated HTTP worker. It accepts one bounded JSON
// envelope on stdin and emits exactly one JSON response frame on stdout.

let SERVER = import("server.sapp");
let JSON = import("stdlib:json.sapp");

let MAX_ENVELOPE_CHARS = 2097152;

fn response(ok, output = nil) {
    let value = map{ format: "pb_mcp.http-worker.response.v1", ok: ok };
    if ok { value.output = output; }
    else { value.error = "isolated HTTP worker refused or failed the request"; }
    return value;
}

fn execute() {
    let line = read_line();
    if type(line) != "string" or len(line) < 2 or len(line) > MAX_ENVELOPE_CHARS {
        return response(false);
    }
    // stdin is a regular private file. A second non-empty line would be an
    // ambiguous multi-frame protocol and is rejected.
    let extra = read_line();
    if extra != nil and str_trim(str(extra)) != "" { return response(false); }
    let envelope = try JSON.parse(line) catch nil;
    if type(envelope) != "map" { return response(false); }
    let expected = try env_get("PB_MCP_WORKER_FINGERPRINT") catch "";
    let supplied = try envelope.worker_fingerprint catch "";
    if type(expected) != "string" or len(expected) != 64
       or type(supplied) != "string" or len(supplied) != 64
       or not constant_time_eq(expected, supplied) {
        return response(false);
    }
    let output = try SERVER.worker_handle(envelope) catch nil;
    if type(output) != "map" { return response(false); }
    return response(true, output);
}

print JSON.stringify(execute());
