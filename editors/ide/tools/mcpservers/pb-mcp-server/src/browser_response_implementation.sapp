// Trusted composition seam. The retained bridge is injected lazily by its owner.
// No foreign implementation, process or network connection is started on import.
let Switch=import("implementation_switch.sapp");
fn open(enabled,selected="pblang",retained_factory=nil) {
    return Switch.open(enabled,selected,map{
        pblang:fn() { return import("browser_response_policy.sapp"); },
        polyglot:retained_factory
    });
}
export open;
