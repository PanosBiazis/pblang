// Pure offline Reverse Engineering, Decompilation, DOM Scraping & Architecture (REA) tools
// backed by stdlib:rea_suite.sapp. Replaces external Ghidra, IDA Pro, Capstone, BeautifulSoup,
// Scrapy, and REA tools in 100% pure offline PBLang.
// Zero target execution, zero shell invocation, zero network access, and explicit prompt-injection guard.
let REA = import("stdlib:rea_suite.sapp");
let SERIAL = import("stdlib:serialization.sapp");
let MAX_BYTES = 131072;

fn _parse_spec(args, ctx) {
    if type(args) != "map" or len(args) != 1 or not map_has(args, "spec_json") {
        throw ctx + ": invalid arguments";
    }
    let text = args.spec_json;
    if type(text) != "string" or len(text) < 2 or len(text) > MAX_BYTES {
        throw ctx + ": invalid arguments";
    }
    let parsed = SERIAL.parse_safe(text, "json", map{
        max_input_bytes: MAX_BYTES,
        max_output_bytes: MAX_BYTES,
        max_depth: 8,
        max_items: 4096,
        max_lines: 4096,
        max_line_bytes: MAX_BYTES,
        strict: true,
        reject_duplicate_keys: true
    });
    if not parsed.ok or type(parsed.value) != "map" {
        throw ctx + ": invalid document";
    }
    return parsed.value;
}

fn call_rea(tool, args) {
    if tool == "rea_binary_audit" {
        let doc = _parse_spec(args, "rea_binary_audit");
        let out = try REA.inspect_binary_artifact(doc) catch nil;
        if out == nil { throw "rea_binary_audit: invalid artifact specification"; }
        return out;
    }
    if tool == "rea_decompile_cfg" {
        let doc = _parse_spec(args, "rea_decompile_cfg");
        let out = try REA.decompile_and_cfg_artifact(doc) catch nil;
        if out == nil { throw "rea_decompile_cfg: invalid decompilation specification"; }
        return out;
    }
    if tool == "rea_application_graph" {
        let doc = _parse_spec(args, "rea_application_graph");
        let out = try REA.analyze_application_surface(doc) catch nil;
        if out == nil { throw "rea_application_graph: invalid application specification"; }
        return out;
    }
    if tool == "rea_protocol_reconstruct" {
        let doc = _parse_spec(args, "rea_protocol_reconstruct");
        let out = try REA.reconstruct_protocol_surface(doc) catch nil;
        if out == nil { throw "rea_protocol_reconstruct: invalid protocol specification"; }
        return out;
    }
    if tool == "rea_dom_scrape_extract" {
        let doc = _parse_spec(args, "rea_dom_scrape_extract");
        let out = try REA.extract_structured_dom(doc) catch nil;
        if out == nil { throw "rea_dom_scrape_extract: invalid DOM scraping specification"; }
        return out;
    }
    if tool == "rea_evidence_ledger" {
        let doc = _parse_spec(args, "rea_evidence_ledger");
        let out = try REA.evaluate_evidence_ledger(doc) catch nil;
        if out == nil { throw "rea_evidence_ledger: invalid ledger specification"; }
        return out;
    }
    return nil;
}

fn implemented_tools() {
    return [
        "rea_binary_audit",
        "rea_decompile_cfg",
        "rea_application_graph",
        "rea_protocol_reconstruct",
        "rea_dom_scrape_extract",
        "rea_evidence_ledger"
    ];
}

fn catalog_entries() {
    return [
        map{
            name: "rea_binary_audit",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Inspect caller-supplied binary bytes or hex in pure offline PBLang: ELF/PE/.NET CIL/Mach-O/WASM/Android DEX/SQLite3/EVM bytecode format & architecture detection, Go/Rust/.NET/Flutter compiler provenance, static mitigations (PIE/ASLR, NX, RELRO, Stack Canary, FORTIFY, CET endbr64), Shannon entropy & AES/SHA-256/ChaCha20/UPX signatures, and prompt-injection screening. Never executes target code.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with bytes (array of 0..255) or hex (hex string), optional name, strings, symbols, sections, imports."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        },
        map{
            name: "rea_decompile_cfg",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Sovereign PBLang replacement for Ghidra, IDA Pro, and Capstone: decode machine code (x86_64, aarch64, evm, wasm) from bytes or hex, recover basic-block Control-Flow Graph (CFG), cyclomatic complexity, stack frame size, call/jump cross-references (xrefs), and synthesize structured high-level pseudocode without executing target binaries.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with bytes (array of 0..255) or hex (hex string), optional function_name, arch ('x86_64'|'aarch64'|'evm'|'wasm'), and base_address."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        },
        map{
            name: "rea_application_graph",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Analyze caller-supplied JavaScript/TypeScript/Electron/multi-language modules to extract module imports/exports, Electron IPC channels, HTTP routes, native bridges (.node/DllImport/FFI/WASM), storage entities, feature-seed slice traces, Electron security posture scores, and copyright-safe cleanroom blueprints.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with modules ([{path, source, kind}]), optional app_name, feature_seed, and electron_config ({node_integration, context_isolation, sandbox, web_security})."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        },
        map{
            name: "rea_protocol_reconstruct",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Reconstruct normalized HTTP/REST API endpoint templates (/{id}, /{uuid}, derivation_kind, status codes, auth schemes, field contracts) and binary wire protocol framing (common magic prefix, fixed vs variable length, u16be/u16le/u8 length field candidates) from caller-supplied exchanges or hex frames.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with exchanges ([{method, path, status, auth_scheme, request_fields, response_fields}]) and/or wire_frames ([hex strings])."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        },
        map{
            name: "rea_dom_scrape_extract",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Sovereign PBLang replacement for BeautifulSoup4, Scrapy, lxml, and Cheerio: parse soup-tolerant HTML/XML documents, query DOM nodes by #id, .class, or tag selectors, extract structured tables, forms, links, and JSON-LD blocks, run declarative item_schema pipelines, and filter/deduplicate crawl frontier URLs.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with html (string), optional base_url, selectors ([string]), crawl_rules ({allow_patterns, deny_patterns}), and item_schema ({field: selector})."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        },
        map{
            name: "rea_evidence_ledger",
            category: "reverse-engineering",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/rea_tools.sapp",
            description: "Perform facet-aware function/artifact dossier comparison (pseudocode, assembly, comments, callers, callees, references, strings_names, cfg — keeping unavailable facets 'unknown' rather than falsely 'equal') and evaluate cleanroom reconstruction readiness against open/blocking unknowns and verification obligations.",
            input_schema: map{
                type: "object",
                properties: map{
                    spec_json: map{
                        type: "string",
                        maxLength: MAX_BYTES,
                        description: "Strict JSON object with optional target_name, left_dossier, right_dossier, observations, unknowns ([{id, question, status, blocking}]), and obligations ([{id, requirement, verified}])."
                    }
                },
                required: ["spec_json"],
                additionalProperties: false
            }
        }
    ];
}

fn functional_records() {
    let entries = catalog_entries();
    let out = [];
    for entry in entries {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "pure offline PBLang reverse-engineering, decompilation, DOM scraping and cleanroom architecture analysis; zero target execution",
            evidence_ids: [
                "pb_mcp_rea:binary-audit",
                "pb_mcp_rea:decompile-cfg",
                "pb_mcp_rea:application-graph",
                "pb_mcp_rea:protocol-reconstruct",
                "pb_mcp_rea:dom-scrape-extract",
                "pb_mcp_rea:evidence-ledger"
            ]
        });
    }
    return out;
}

export call_rea, implemented_tools, catalog_entries, functional_records;
