// Bounded literal table review; existing shared library owns table semantics.
let Sheet=import("stdlib:sheet_document.sapp");
let Quality=import("stdlib:table_quality.sapp");
let Selection=import("stdlib:table_row_selection.sapp");
fn _fail(){throw "Invalid table arguments";}
fn implemented_tools(){return ["data_table_quality","data_table_select_rows"];}
fn call_table(name,args){
 if name!="data_table_quality" and name!="data_table_select_rows" {return nil;}
 if type(args)!="map" or not map_has(args,"document") {_fail();}
 for key in map_keys(args) {if key!="document" and key!="header" and not(name=="data_table_select_rows" and key=="indices") {_fail();}}
 let header=try args.header catch false;
 if type(header)!="bool" {_fail();}
 let size=try Sheet.validate(args.document) catch nil;if size==nil {_fail();}
 let result:any=nil;
 if name=="data_table_quality" {
  result=try Quality.inspect(args.document,header) catch nil;
 } else {
  if not map_has(args,"indices") {_fail();}
  let selected=try Selection.select(args.document,args.indices,header) catch nil;
  if selected==nil {_fail();}
  let indices=[];for index in args.indices {push(indices,index);}
  result=map{format:"pb_mcp.data_table_select_rows.v1",document:selected,
   source_rows:size.rows,selected_data_rows:len(args.indices),header:header,
   source_indices:indices,index_base:0,contains_cell_text:true,contains_headers:header};
 }
 if result==nil {_fail();}
 if len(str_to_bytes(json_stringify(args)))>65536 {_fail();}
 result.native_pblang=true;result.data_source="caller_supplied";result.safe_to_log=false;
 result.effects_performed=false;result.network_used=false;result.model_loaded=false;
 result.automatic_deletion=false;result.formulas_evaluated=false;
 if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}
 return result;
}
fn catalog_entries(){
 let doc=map{type:"object",required:["format","cells"],additionalProperties:false,
  properties:map{format:map{type:"string",enum:["pblang.sheet-document.v1"]},
   cells:map{type:"array",minItems:1,maxItems:32,items:map{type:"array",minItems:1,maxItems:8,items:map{type:"string",maxLength:256}}}},
  description:"Rectangular literal string cells, 1..32 rows,1..8 columns, max256 UTF8bytes/cell and8192 total; no NUL. Runtime verifies byte limits and rectangular shape."};
 let names=implemented_tools();let out=[];
 for i len(names){
  let fields=map{document:doc,header:map{type:"boolean",default:false}};let required=["document"];
  if i==1 {fields.indices=map{type:"array",minItems:1,maxItems:32,uniqueItems:true,items:map{type:"integer",minimum:0,maximum:31},description:"Strictly increasing source row indices; with header=true index0 is reserved and copied once."};push(required,"indices");}
  let description=if i==0 {"Inspect blank (trimmed empty), padded and exact duplicate data rows. Header=true excludes row0. Return complete counts and zero-based coordinates, duplicate_of references the first matching data row. No cell text or headers returned; coordinates still private. Advisory only, no corrections or type inference."} else {"Copy explicitly selected source rows into a detached literal table preview in source order. Header=true retains row0 exactly once. Indices must be strictly increasing unique in-range data rows; no sorting, filtering inference or silent truncation. Returns literal caller cells, including formulas as text."};
  push(out,map{name:names[i],category:"table-review",profile:"core-code",source:"src/table_review.sapp",read_only:true,destructive:false,open_world:false,
   description:description+" Arguments/output<=65536 serialized UTF8bytes. safe_to_log:false. No file/network/model/storage/automatic collection or deletion.",
   input_schema:map{type:"object",required:required,additionalProperties:false,properties:fields}});
 }
 return out;
}
fn functional_records(){let out=[];for entry in catalog_entries(){push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,reason:"Bounded literal table review using existing PBLang shared libraries",evidence_ids:["pb_mcp_table_review:quality","pb_mcp_table_review:selection","pb_mcp_table_review:bounds","pb_mcp_table_review:parity"]});}return out;}
export implemented_tools,call_table,catalog_entries,functional_records;
