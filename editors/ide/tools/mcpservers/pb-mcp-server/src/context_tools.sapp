// Native pblang translations for context packing helpers.

let sec = import("security.sapp");
let texttools = import("text_tools.sapp");

fn _clip(s, max_chars) {
    s = str(s);
    max_chars = sec.clamp(max_chars, 1, sec.MAX_READ_CHARS);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn pack_context(args) {
    if args == nil { args = map{}; }
    let segments = try args.segments catch try args.items catch [];
    let labels = try args.segment_labels catch try args.labels catch [];
    let max_chars = sec.clamp(try args.max_chars catch 12000, 256, sec.MAX_READ_CHARS);
    let out = "";
    let used = 0;
    let packed = 0;
    for i len(segments) {
        let label = if i < len(labels) { str(labels[i]) } else { "segment-" + str(i + 1) };
        let body = str(segments[i]);
        let block = "## " + label + "\n" + body + "\n";
        if used + len(block) > max_chars {
            let remaining = max_chars - used;
            if remaining > 32 {
                out = out + _clip(block, remaining);
                packed = packed + 1;
                used = max_chars;
            }
            break;
        }
        out = out + block;
        used = used + len(block);
        packed = packed + 1;
    }
    let compressed = try args.compress catch false;
    if compressed == true { out = texttools.compress_simplify_whitespace(out, max_chars); }
    return map{ text: out, chars: len(out), packed_segments: packed, total_segments: len(segments), truncated: packed < len(segments) };
}

fn call_context(tool, args) {
    if tool == "pack_context" { return pack_context(args); }
    return nil;
}

fn implemented_tools() {
    return ["pack_context"];
}

export implemented_tools, call_context, pack_context;
