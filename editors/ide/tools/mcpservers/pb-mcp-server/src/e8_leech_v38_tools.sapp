    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_e8_leech_v38.sapp") catch nil; }
    if m == nil { m = try import("../../pblang/editors/ide/tools/ai/pbai_e8_leech_v38.sapp") catch nil; }
    if m == nil { m = try import("../../../pblang/editors/ide/tools/ai/pbai_e8_leech_v38.sapp") catch nil; }
    _V38_CACHE["M"] = m;
    return m;
}

