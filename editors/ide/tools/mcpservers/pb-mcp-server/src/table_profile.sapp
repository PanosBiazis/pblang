// Bounded literal Sheet column profiling and literal substring row-index filtering via stdlib:table_profile.sapp.
let Profile = import("stdlib:table_profile.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table profile arguments"; }
fn implemented_tools() { return ["data_table_profile"]; }

fn call_profile(name, args) {
    if name != "data_table_profile" { return nil; }
    if type(args) != "map" or len(args) < 1 or len(args) > 4
       or not map_has(args, "document") {
        _fail();
    }
    let has_fcol = map_has(args, "filter_column");
    let has_fquery = map_has(args, "filter_query");
    if has_fcol != has_fquery { _fail(); }
    for key in map_keys(args) {
        if key != "document" and key != "header"
           and key != "filter_column" and key != "filter_query" {
            _fail();
        }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let header = false;
    if map_has(args, "header") {
        header = args.header;
    }
    if type(header) != "bool" { _fail(); }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil { _fail(); }
    let filter_col: any = nil;
    let filter_query: any = nil;
    if has_fcol {
        filter_col = args.filter_column;
        filter_query = args.filter_query;
        if type(filter_col) != "number" or filter_col != num_floor(filter_col)
           or filter_col < 0 or filter_col >= size.columns
           or type(filter_query) != "string" or len(filter_query) > 256
           or len(str_to_bytes(filter_query)) > 256
           or str_contains(filter_query, "\u0000") {
            _fail();
        }
    }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let desc = try Profile.describe(args.document, header) catch nil;
    if desc == nil { _fail(); }
    let out_cols = [];
    for c_entry in desc.columns {
        push(out_cols, map{
            index: c_entry.index,
            empty: c_entry.empty,
            numeric: c_entry.numeric,
            text: c_entry.text,
            distinct_nonempty: c_entry.distinct_nonempty,
            sum: c_entry.sum,
            mean: c_entry.mean,
            min: c_entry.min,
            max: c_entry.max,
            population_variance: c_entry.population_variance
        });
    }
    let out_indices: any = nil;
    let matching_rows: any = nil;
    if has_fcol {
        let matched = try Profile.select_rows(args.document, filter_col, filter_query, header) catch nil;
        if matched == nil { _fail(); }
        let idx_list = [];
        for idx in matched {
            push(idx_list, idx);
        }
        out_indices = idx_list;
        matching_rows = len(idx_list);
    }
    let result = map{
        format: "pb_mcp.data_table_profile.v1",
        profile_format: desc.format,
        source_rows: size.rows,
        column_count: size.columns,
        input_text_bytes: size.text_bytes,
        header: desc.header,
        data_rows: desc.rows,
        duplicate_rows: desc.duplicate_rows,
        columns: out_cols,
        filtered: has_fcol,
        filter_column: filter_col,
        matching_indices: out_indices,
        matching_rows: matching_rows,
        index_base: 0,
        formulas_evaluated: false,
        contains_cell_text: false,
        contains_headers: false,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows and 1..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL."
    };
    return [map{
        name: "data_table_profile",
        category: "table-review",
        profile: "core-code",
        source: "src/table_profile.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document"],
            additionalProperties: false,
            properties: map{
                document: document,
                header: map{
                    type: "boolean",
                    default: false,
                    description: "When true, row 0 is treated as a header row and excluded from data row profiling and filtering."
                },
                filter_column: map{
                    type: "integer",
                    minimum: 0,
                    maximum: 7,
                    description: "Optional zero-based column index for case-sensitive literal substring row-index selection (requires filter_query)."
                },
                filter_query: map{
                    type: "string",
                    maxLength: 256,
                    description: "Optional literal substring query (<=256 UTF8bytes, no NUL) matched against filter_column (requires filter_column)."
                }
            }
        },
        description: "Profile every column of a caller-supplied literal pblang.sheet-document.v1 (empty, numeric, text, distinct_nonempty, sum, mean, min, max, population_variance, and exact duplicate data rows) and optionally return zero-based row indices matching a case-sensitive literal substring query on filter_column. No cell text or header strings are returned; coordinates and statistics remain caller-private (safe_to_log:false). Serialized arguments and result each <=65536 UTF8bytes. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet column profiling and literal substring row-index selection with pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_table_profile:column_stats_and_filter",
                "pb_mcp_table_profile:header_and_bounds",
                "pb_mcp_table_profile:detached_results",
                "pb_mcp_table_profile:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_profile, catalog_entries, functional_records;
