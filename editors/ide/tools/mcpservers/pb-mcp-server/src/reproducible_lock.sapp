// Reusable validation for portable, content-addressed PBLang lockfiles.

fn _absolute_path(value) {
    let path = str_trim(value);
    if str_starts_with(path, "/") or str_starts_with(path, "\\\\") or
       str_starts_with(path, "~/") or str_starts_with(path, "~\\") {
        return true;
    }
    return regex_match(path, "^[A-Za-z]:[\\\\/]");
}

fn inspect_lock(text) {
    let lines = str_split(text, "\n");
    let dependency_count = 0;
    let digest_count = 0;
    let violations = [];
    let dependency_digests = map{};
    let dependency_paths = map{};
    let section = "";
    for i len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "[dependencies.") and str_ends_with(line, "]") {
            section = str_slice(line, 14, len(line) - 1);
            dependency_count = dependency_count + 1;
            if section == "" or map_has(dependency_digests, section) or map_has(dependency_paths, section) {
                array_push(violations, map{ line: i + 1, reason: "invalid-or-duplicate-dependency-section" });
            }
        } elif str_starts_with(line, "[") {
            section = "";
        }
        if str_starts_with(line, "sha256 = \"") and str_ends_with(line, "\"") {
            digest_count = digest_count + 1;
            let value = str_slice(line, 10, len(line) - 1);
            if section == "" or not regex_match(value, "^[0-9a-f]{64}$") {
                array_push(violations, map{ line: i + 1, reason: "invalid-dependency-sha256" });
            } else {
                dependency_digests[section] = value;
            }
        }
        if str_starts_with(line, "path = \"") and str_ends_with(line, "\"") {
            let value = str_slice(line, 8, len(line) - 1);
            if section != "" { dependency_paths[section] = value; }
            if _absolute_path(value) {
                array_push(violations, map{ line: i + 1, reason: "absolute-dependency-path" });
            }
        }
    }
    return map{
        ok: len(violations) == 0 and dependency_count == digest_count,
        format: "pb_mcp.reproducible-lock-check.v1",
        dependency_count: dependency_count, digest_count: digest_count,
        dependency_digests: dependency_digests,
        dependency_paths: dependency_paths,
        violations: violations
    };
}

export inspect_lock;
