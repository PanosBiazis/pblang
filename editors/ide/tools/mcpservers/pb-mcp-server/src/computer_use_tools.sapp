let _schemas_cache = map{}; let _schemas_ready = false;
fn _schemas() {
    if _schemas_ready { return _schemas_cache; }
    let rect = _schema(map{ x: _n(-1048576, 1048576, true), y: _n(-1048576, 1048576, true), width: _n(1, 65536, true), height: _n(1, 65536, true) }, ["x", "y", "width", "height"]);
    _schemas_cache = map{
