// Portable computer-use contracts inspired by common Windows, macOS and MCP
// automation surfaces. These tools validate, normalize and plan actions. They
// never capture content or actuate input; platform effects remain separately
// capability-gated and human-approved.

let FORMAT = "pb_mcp.computer-use.v1";
let NAMES = [
    "computer_use_profile", "computer_capability_pack",
    "computer_display_layout_validate", "computer_region_normalize",
    "computer_region_intersection", "computer_click_validate",
    "computer_move_validate", "computer_drag_plan", "computer_scroll_normalize",
    "computer_type_validate", "computer_shortcut_validate",
    "computer_wait_for_policy", "computer_ui_query_validate",
    "computer_ui_snapshot_budget", "computer_screenshot_budget",
    "computer_frame_pacing_plan", "computer_action_batch_validate",
    "computer_permission_intersection", "computer_sensitive_action_policy",
    "computer_tool_pack_select"
];

fn _contains(values, wanted) {
    for i len(values) { if values[i] == wanted { return true; } }
    return false;
}
fn _strict(args, allowed, label) {
    if args == nil { args = map{}; }
    if type(args) != "map" { throw label + " arguments must be an object"; }
    let keys = map_keys(args);
    let i = 0;
    while i < len(keys) {
        if not _contains(allowed, keys[i]) { throw label + " unknown argument: " + str(keys[i]); }
        i = i + 1;
    }
    return args;
}
fn _number(value, label, minimum, maximum) {
    if type(value) != "number" or str_lower(str(value)) == "nan" or value < minimum or value > maximum {
        throw label + " must be a finite number in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}
fn _integer(value, label, minimum, maximum) {
    let out = _number(value, label, minimum, maximum);
    if out != num_floor(out) { throw label + " must be an integer"; }
    return out;
}
fn _text(value, label, minimum, maximum) {
    if type(value) != "string" or len(value) < minimum or len(value) > maximum {
        throw label + " must be a bounded string";
    }
    return value;
}
fn _bool(value, label) {
    if type(value) != "bool" { throw label + " must be boolean"; }
    return value;
}
fn _enum(value, label, allowed) {
    let out = _text(value, label, 1, 64);
    if not _contains(allowed, out) { throw label + " is not an allowed value"; }
    return out;
}
fn _optional(args, key, fallback) { return if map_has(args, key) { args[key] } else { fallback }; }
fn _base(tool) {
    return map{ ok: true, executed: true, tool: tool, format: FORMAT,
        native_pblang: true, deterministic: true, effect_performed: false,
        shell_used: false, external_process: false, content_captured: false };
}
fn _unique_strings(value, label, maximum) {
    if type(value) != "array" or len(value) > maximum { throw label + " must be a bounded array"; }
    let seen = map{}; let out = [];
    for i len(value) {
        let item = _text(value[i], label + " item", 1, 128);
        if map_has(seen, item) { throw label + " contains duplicate: " + item; }
        seen[item] = true; array_push(out, item);
    }
    return out;
}
fn _rect(value, label) {
    if type(value) != "map" { throw label + " must be an object"; }
    let keys = map_keys(value); let i = 0;
    while i < len(keys) { if not _contains(["x", "y", "width", "height"], keys[i]) { throw label + " unknown field: " + keys[i]; } i = i + 1; }
    return map{
        x: _integer(try value.x catch nil, label + ".x", -1048576, 1048576),
        y: _integer(try value.y catch nil, label + ".y", -1048576, 1048576),
        width: _integer(try value.width catch nil, label + ".width", 1, 65536),
        height: _integer(try value.height catch nil, label + ".height", 1, 65536)
    };
}
fn _overlap(a, b) {
    let x1 = num_max(a.x, b.x); let y1 = num_max(a.y, b.y);
    let x2 = num_min(a.x + a.width, b.x + b.width);
    let y2 = num_min(a.y + a.height, b.y + b.height);
    if x2 <= x1 or y2 <= y1 { return map{ intersects: false, x: x1, y: y1, width: 0, height: 0, area: 0 }; }
    return map{ intersects: true, x: x1, y: y1, width: x2 - x1,
        height: y2 - y1, area: (x2 - x1) * (y2 - y1) };
}
fn _schema(properties, required = nil) {
    return map{ type: "object", properties: properties,
        required: if required == nil { [] } else { required }, additionalProperties: false };
}
fn _s(options = nil) { let out = map{ type: "string" }; if options != nil { let keys = map_keys(options); let i = 0; while i < len(keys) { out[keys[i]] = options[keys[i]]; i = i + 1; } } return out; }
fn _n(minimum, maximum, integer = false) { return map{ type: if integer { "integer" } else { "number" }, minimum: minimum, maximum: maximum }; }
fn _b() { return map{ type: "boolean" }; }
fn _a(items, minimum, maximum) { return map{ type: "array", items: items, minItems: minimum, maxItems: maximum }; }
fn _open_object() { return map{ type: "object", properties: map{}, required: [], additionalProperties: true }; }

let DESCRIPTIONS = map{
    computer_use_profile: "Describe the portable computer-use contract and its explicit no-effect boundary.",
    computer_capability_pack: "Select a least-capability tool pack for one bounded computer-use workload.",
    computer_display_layout_validate: "Validate up to sixteen displays and compute deterministic virtual desktop bounds.",
    computer_region_normalize: "Clip one region to a display and report exact visible geometry.",
    computer_region_intersection: "Compute the exact intersection of two bounded rectangles.",
    computer_click_validate: "Validate an in-bounds click gesture, button and bounded click count.",
    computer_move_validate: "Validate an absolute pointer move and duration against display bounds.",
    computer_drag_plan: "Generate a bounded linear drag path with stable integer coordinates.",
    computer_scroll_normalize: "Normalize pixel, line or page scrolling to bounded pixel deltas.",
    computer_type_validate: "Validate bounded Unicode text and reject unsafe control characters unless explicitly allowed.",
    computer_shortcut_validate: "Normalize and validate a bounded keyboard chord without pressing it.",
    computer_wait_for_policy: "Create a bounded polling policy for text, window, element, focus or disappearance conditions.",
    computer_ui_query_validate: "Validate a bounded role/name/automation-id UI query without inspecting an accessibility tree.",
    computer_ui_snapshot_budget: "Evaluate bounded accessibility-tree node, depth and text budgets.",
    computer_screenshot_budget: "Estimate raw screenshot memory and validate display/frame limits without capturing content.",
    computer_frame_pacing_plan: "Select deterministic capture cadence from refresh rate, latency and frame-change ratio.",
    computer_action_batch_validate: "Validate an ordered bounded computer-use action batch and identify consent requirements.",
    computer_permission_intersection: "Intersect requested and granted capabilities without broadening either set.",
    computer_sensitive_action_policy: "Require attended explicit consent and trusted targets for sensitive desktop actions.",
    computer_tool_pack_select: "Filter a caller-provided tool inventory to one least-capability computer-use pack."
};

fn call_computer_use(tool, args) {
    if not _contains(NAMES, tool) { return nil; }
    let out = _base(tool);
