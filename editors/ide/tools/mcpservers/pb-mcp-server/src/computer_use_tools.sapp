        let displays = args.displays;
        if type(displays) != "array" or len(displays) < 1 or len(displays) > 16 { throw "displays must contain 1..16 records"; }
        let ids = map{}; let normalized = []; let primary_count = 0;
        let left = 1048576; let top = 1048576; let right = -1048576; let bottom = -1048576;
        for i len(displays) {
