        let unit = _enum(args.unit, "unit", ["pixel", "line", "page"]); let dx = _integer(args.dx, "dx", -10000, 10000); let dy = _integer(args.dy, "dy", -10000, 10000);
        let factor_x = 1; let factor_y = 1;
