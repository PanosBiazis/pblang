        out.x = _integer(args.x, "x", 0, width - 1); out.y = _integer(args.y, "y", 0, height - 1);
        out.button = _enum(_optional(args, "button", "left"), "button", ["left", "middle", "right", "back", "forward"]);
        out.clicks = _integer(_optional(args, "clicks", 1), "clicks", 1, 3); out.valid = true; return out;
    }
    if tool == "computer_move_validate" {
        _strict(args, ["x", "y", "width", "height", "duration_ms"], tool);
        let width = _integer(args.width, "width", 1, 65536); let height = _integer(args.height, "height", 1, 65536);
        out.x = _integer(args.x, "x", 0, width - 1); out.y = _integer(args.y, "y", 0, height - 1);
