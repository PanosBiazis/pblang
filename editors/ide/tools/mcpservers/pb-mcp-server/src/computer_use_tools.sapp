        let width = _integer(args.width, "width", 1, 65536); let height = _integer(args.height, "height", 1, 65536);
        let sx = _integer(args.start_x, "start_x", 0, width - 1); let sy = _integer(args.start_y, "start_y", 0, height - 1);
        let ex = _integer(args.end_x, "end_x", 0, width - 1); let ey = _integer(args.end_y, "end_y", 0, height - 1);
        let steps = _integer(_optional(args, "steps", 12), "steps", 2, 120); let points = [];
