        if selectors < 1 { throw "at least one UI selector is required"; }
        out.role = _optional(args, "role", nil); out.name = _optional(args, "name", nil); out.automation_id = _optional(args, "automation_id", nil);
        out.limit = _integer(_optional(args, "limit", 20), "limit", 1, 200); out.selector_count = selectors; return out;
    }
    if tool == "computer_ui_snapshot_budget" {
        _strict(args, ["nodes", "depth", "text_bytes"], tool); let nodes = _integer(args.nodes, "nodes", 0, 1000000); let depth = _integer(args.depth, "depth", 0, 1000); let bytes = _integer(args.text_bytes, "text_bytes", 0, 1073741824);
        out.allowed = nodes <= 10000 and depth <= 64 and bytes <= 1048576; out.max_nodes = 10000; out.max_depth = 64; out.max_text_bytes = 1048576; out.truncate = not out.allowed; return out;
