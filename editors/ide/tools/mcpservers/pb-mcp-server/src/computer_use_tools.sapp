        elif unit == "page" { factor_x = _integer(args.viewport_width, "viewport_width", 1, 65536); factor_y = _integer(args.viewport_height, "viewport_height", 1, 65536); }
        out.dx_px = num_max(-65536, num_min(65536, dx * factor_x)); out.dy_px = num_max(-65536, num_min(65536, dy * factor_y)); out.unit = unit; return out;
    }
    if tool == "computer_type_validate" {
        _strict(args, ["text", "allow_controls"], tool); let text = _text(args.text, "text", 1, 8192);
        let controls = []; let scalar_count = 0; let i = 0;
        while i < len(text) { let cp = strcharcodeat(text, i); scalar_count = scalar_count + 1; if cp < 32 and cp != 9 and cp != 10 and cp != 13 { array_push(controls, cp); } i = i + 1; }
        if len(controls) > 0 and not _bool(_optional(args, "allow_controls", false), "allow_controls") { throw "text contains disallowed control characters"; }
        out.text_bytes = len(text); out.unicode_scalars = scalar_count; out.control_codepoints = controls; out.valid = true; return out;
    }
