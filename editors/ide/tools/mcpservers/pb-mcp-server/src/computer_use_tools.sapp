        _strict(args, ["keys"], tool); let keys = _unique_strings(args.keys, "keys", 6); if len(keys) < 1 { throw "keys must not be empty"; }
        let normalized = []; let seen = map{};
        for i len(keys) {
            let key = str_lower(keys[i]);
            if len(key) == 1 and not regex_match(key, "^[a-z0-9]$") { throw "unsupported shortcut key: " + key; }
            if len(key) > 1 and not _contains(["ctrl", "alt", "shift", "meta", "cmd", "super", "option"], key) and not regex_match(key, "^(f([1-9]|1[0-2])|enter|escape|tab|space|backspace|delete|home|end|pageup|pagedown|left|right|up|down)$") { throw "unsupported shortcut key: " + key; }
            if map_has(seen, key) { throw "shortcut contains duplicate normalized key: " + key; }
            seen[key] = true; array_push(normalized, key);
        }
        out.keys = normalized; out.chord = str_join(normalized, "+"); out.valid = true; return out;
    }
    if tool == "computer_wait_for_policy" {
        _strict(args, ["condition", "timeout_ms", "poll_ms"], tool);
        out.condition = _enum(args.condition, "condition", ["text", "window", "element", "focus", "disappear"]);
        out.timeout_ms = _integer(_optional(args, "timeout_ms", 10000), "timeout_ms", 0, 120000);
        out.poll_ms = _integer(_optional(args, "poll_ms", 250), "poll_ms", 25, 5000);
        out.max_attempts = if out.timeout_ms == 0 { 1 } else { num_floor((out.timeout_ms + out.poll_ms - 1) / out.poll_ms) + 1 };
        out.capture_each_poll = false; return out;
    }
    if tool == "computer_ui_query_validate" {
