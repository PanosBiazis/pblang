        let displays = _integer(_optional(args, "displays", 1), "displays", 1, 16); let fps = _integer(_optional(args, "fps", 1), "fps", 1, 240);
        let format = _enum(_optional(args, "pixel_format", "rgba8"), "pixel_format", ["rgb8", "rgba8", "bgra8", "gray8"]);
