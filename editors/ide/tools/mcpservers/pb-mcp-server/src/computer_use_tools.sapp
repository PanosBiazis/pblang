            let display_keys = map_keys(d);
            let k = 0;
            while k < len(display_keys) { if not _contains(["id", "x", "y", "width", "height", "scale", "primary"], display_keys[k]) { throw "display unknown field: " + display_keys[k]; } k = k + 1; }
            let id = _text(try d.id catch nil, "display.id", 1, 64); if map_has(ids, id) { throw "duplicate display id: " + id; } ids[id] = true;
            let r = map{
                x: _integer(try d.x catch nil, "display.x", -1048576, 1048576),
                y: _integer(try d.y catch nil, "display.y", -1048576, 1048576),
                width: _integer(try d.width catch nil, "display.width", 1, 65536),
                height: _integer(try d.height catch nil, "display.height", 1, 65536)
            };
            let scale = _number(_optional(d, "scale", 1), "display.scale", 0.5, 8);
            let primary = _bool(_optional(d, "primary", false), "display.primary");
            if primary { primary_count = primary_count + 1; }
            array_push(normalized, map{ id: id, x: r.x, y: r.y, width: r.width, height: r.height, scale: scale, primary: primary });
            left = num_min(left, r.x); top = num_min(top, r.y); right = num_max(right, r.x + r.width); bottom = num_max(bottom, r.y + r.height);
        }
        if primary_count > 1 { throw "display layout contains more than one primary display"; }
        out.displays = normalized; out.display_count = len(normalized);
        out.primary_count = primary_count;
        out.bounds = map{ x: left, y: top, width: right - left, height: bottom - top }; return out;
    }
    if tool == "computer_region_normalize" {
