            visual_inspection: ["computer_screenshot_budget", "computer_region_normalize", "computer_frame_pacing_plan", "computer_ui_query_validate"],
            accessibility_audit: ["computer_ui_query_validate", "computer_ui_snapshot_budget", "desktop_color_contrast", "desktop_accessibility_profile"],
