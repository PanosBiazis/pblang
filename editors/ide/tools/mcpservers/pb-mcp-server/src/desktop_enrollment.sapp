// Local enrollment only. This module has no desktop-control or MCP capability.
fn validate(first, second) {
    if type(first) != "string" or type(second) != "string" { return "Enter the code twice."; }
    if first != second { return "The two codes do not match."; }
    let bytes = str_to_bytes(first);
    if len(first) < 8 or len(bytes) > 256 { return "Use at least 8 characters, within 256 UTF-8 bytes."; }
    if str_trim(first) != first { return "Do not start or end the code with whitespace."; }
    for byte in bytes { if byte < 32 or byte == 127 { return "Control characters are not allowed."; } }
    return "";
}
fn new(send) {
    let state = map{ ready: false, waiting: false, done: false, stopped: false,
        status: "Connecting to local enrollment…" };
    fn deliver(message) { send(message); return true; }
    fn cancel() {
        if not state.stopped and not state.done {
            state.stopped = true; state.ready = false;
            try send(map{ action: "cancel" }) catch nil;
        }
    }
    fn receive(message) {
        if state.stopped or state.done { return; }
        if type(message) != "map" or len(map_keys(message)) != 1 { cancel(); return; }
        let event = try message.event catch "";
        if event == "ready" and not state.waiting { state.ready = true; state.status = "Create a code used only for local control."; }
        elif event == "enrolled" and state.waiting { state.done = true; state.ready = false; state.status = "Local code saved."; }
        else { cancel(); }
    }
    fn submit(first, second, foreground) {
        if not state.ready or state.waiting or state.done or state.stopped
            or type(foreground) != "bool" or not foreground { return false; }
        let error = validate(first, second);
        if error != "" { state.status = error; return false; }
        state.waiting = true; state.ready = false; state.status = "Saving locally…";
        if not (try deliver(map{ action: "enroll", secret: first, foreground: true }) catch false) {
            cancel(); return false;
        }
        return true;
    }
    fn snapshot() {
        return map{ can_submit: state.ready and not state.waiting and not state.stopped and not state.done,
            done: state.done, stopped: state.stopped, status: state.status };
    }
    return map{ submit: submit, cancel: cancel, receive: receive, snapshot: snapshot };
}
export new, validate;
