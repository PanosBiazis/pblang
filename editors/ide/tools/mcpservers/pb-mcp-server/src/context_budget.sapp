// Select identifiers without copying prompt/document bodies or estimating tokens.
// Input order is caller priority. Required items reserve their cost first.
fn select(args) {
    if type(args) != "map" or len(map_keys(args)) != 3 or not map_has(args,"items")
        or not map_has(args,"budget") or not map_has(args,"reserve") { throw "invalid context budget request"; }
    for value in [args.budget,args.reserve] {
        if type(value) != "number" or not (value >= 0 and value <= 1000000)
            or value != num_floor(value) { throw "invalid context cost"; }
    }
    if args.reserve > args.budget { throw "reserve exceeds context budget"; }
    if type(args.items) != "array" or len(args.items) > 4096 { throw "invalid context items"; }
    let seen = map{}; let required_cost = 0;
    for item in args.items {
        if type(item) != "map" or len(map_keys(item)) != 3 or not map_has(item,"id")
            or not map_has(item,"cost") or not map_has(item,"required") { throw "invalid context item"; }
        if type(item.id) != "string" or len(item.id) < 1 or len(item.id) > 128
            or map_has(seen,item.id) or type(item.required) != "bool" { throw "invalid context identity"; }
        if type(item.cost) != "number" or not (item.cost >= 0 and item.cost <= 1000000)
            or item.cost != num_floor(item.cost) { throw "invalid context item cost"; }
        seen[item.id] = true;
        if item.required { required_cost = required_cost + item.cost; }
    }
    let available = args.budget - args.reserve;
    if required_cost > available { throw "required context does not fit"; }
    let left = available - required_cost; let selected = []; let skipped = [];
    for item in args.items {
        if item.required { array_push(selected,item.id); }
        elif item.cost <= left { array_push(selected,item.id); left = left - item.cost; }
        else { array_push(skipped,item.id); }
    }
    return map{ ok: true, native_pblang: true, effect_performed: false, network_used: false,
        model_loaded: false, data_provenance: "untrusted_caller_supplied", instructions_from_data: false,
        format: "pb_mcp.context-budget.v1", selected_ids: selected,
        skipped_ids: skipped, used_cost: available-left, remaining_cost: left,
        reserve: args.reserve, cost_source: "caller_supplied", tokenizer_used: false,
        optimal_selection_claimed: false, persisted: false, network_accessed: false };
}
// Paginated scalar-offset planning. No document is accepted or copied. The
// caller owns text/version binding and uses str_slice(text, start, end).
fn chunks(args) {
    let keys = ["length", "chunk_size", "overlap", "start_chunk", "limit"];
    if type(args) != "map" or len(map_keys(args)) != len(keys) { throw "invalid chunk request"; }
    for key in keys {
        if not map_has(args,key) { throw "invalid chunk request"; }
        let value = args[key];
        if type(value) != "number" or not (value >= 0 and value <= 1000000000000)
            or value != num_floor(value) { throw "invalid chunk integer"; }
    }
    if args.chunk_size < 1 or args.chunk_size > 65536 or args.overlap >= args.chunk_size
        or args.limit < 1 or args.limit > 4096 { throw "invalid chunk bounds"; }
    let step = args.chunk_size - args.overlap;
    let count = 0;
    if args.length > 0 {
        count = 1;
        if args.length > args.chunk_size {
            count = count + num_ceil((args.length - args.chunk_size) / step);
        }
    }
    if args.start_chunk > count { throw "chunk cursor exceeds result"; }
    let stop = num_min(count, args.start_chunk + args.limit);
    let spans = []; let index = args.start_chunk;
    while index < stop {
        let start = index * step;
        array_push(spans,map{index:index,start:start,end:num_min(args.length,start+args.chunk_size)});
        index = index + 1;
    }
    return map{format:"pb_mcp.document-chunks.v1",ok:true,native_pblang:true,
        effect_performed:false,network_used:false,model_loaded:false,persisted:false,
        data_provenance:"untrusted_caller_supplied",instructions_from_data:false,
        offset_unit:"unicode_scalar",end_exclusive:true,tokenizer_used:false,
        grapheme_aligned:false,content_received:false,source_verified:false,
        length:args.length,chunk_size:args.chunk_size,overlap:args.overlap,
        total_chunks:count,spans:spans,next_chunk:if stop < count { stop } else { nil }};
}
export select, chunks;
