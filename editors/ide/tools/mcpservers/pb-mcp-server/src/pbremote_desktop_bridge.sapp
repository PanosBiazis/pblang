// Local composition boundary. Only the trusted host supplies the PBRemote API
// and providers. Keep .local in the operator UI; expose only .call to MCP.
let FORMAT = "pb_mcp.pbremote_desktop.v1";
let DesktopPNG = import("desktop_png.sapp");
let Context = import("desktop_context.sapp");
let Budget = import("desktop_budget.sapp");
let Streams = import("desktop_stream.sapp");
let NAMES = ["pbremote_desktop_status", "pbremote_desktop_capture",
    "pbremote_control_request", "pbremote_control_status",
    "pbremote_desktop_input", "pbremote_desktop_stop", "pbremote_desktop_context",
    "pbremote_stream_open", "pbremote_stream_next", "pbremote_stream_feedback", "pbremote_stream_close"];

fn _contains(values, value) {
    for i len(values) { if values[i] == value { return true; } }
    return false;
}
fn _strict(value, keys) {
    if type(value) != "map" { throw "invalid arguments"; }
    let actual = map_keys(value);
    for i len(actual) { if not _contains(keys, actual[i]) { throw "unexpected argument"; } }
}
fn _integer(value, low, high) {
    if type(value) != "number" or value < low or value > high
        or value != num_floor(value) { throw "invalid integer"; }
    return value;
}
fn _failure(message) {
    return map{ ok: false, format: FORMAT, error: message };
}
fn _schema(properties, required = nil) {
    return map{ type: "object", properties: properties,
        required: if required == nil { [] } else { required }, additionalProperties: false };
}
fn catalog() {
    let entries = [];
    let schemas = [
        _schema(map{}), _schema(map{}),
        _schema(map{
            scopes: map{ type: "array", minItems: 1, maxItems: 2, uniqueItems: true,
                items: map{ type: "string", enum: ["pointer", "keyboard"] } },
            ttl_ms: map{ type: "integer", minimum: 5000, maximum: 120000 },
            max_events: map{ type: "integer", minimum: 1, maximum: 512 }
        }, ["scopes"]),
        _schema(map{}),
        _schema(map{
            kind: map{ type: "string", enum: ["key", "pointer", "pointer_relative", "click"] },
            payload: map{ type: "object", properties: map{
                text: map{ type: "string", minLength: 1, maxLength: 4096 },
                key: map{ type: "string", minLength: 1, maxLength: 64 },
                x: map{ type: "integer", minimum: 0, maximum: 16383 },
                y: map{ type: "integer", minimum: 0, maximum: 16383 },
                dx: map{ type: "integer", minimum: -32768, maximum: 32768 },
                dy: map{ type: "integer", minimum: -32768, maximum: 32768 },
                button: map{ type: "integer", minimum: 1, maximum: 3 }
            }, additionalProperties: false }
        }, ["kind", "payload"]),
        _schema(map{}), _schema(map{}),
        _schema(map{ fps: map{ type: "integer", minimum: 1, maximum: 10 },
            max_frames: map{ type: "integer", minimum: 1, maximum: 3600 } }),
        _schema(map{}),
        _schema(map{ decode_ms: map{ type: "integer", minimum: 0, maximum: 60000 },
            network_ms: map{ type: "integer", minimum: 0, maximum: 60000 },
            dropped_frames: map{ type: "integer", minimum: 0, maximum: 10000 },
            queue_depth: map{ type: "integer", minimum: 0, maximum: 1024 },
            power_save: map{ type: "boolean" } }), _schema(map{})
    ];
    let descriptions = [
        "Read this bridge's consent and lease state without paths, credentials or screen content.",
        "Capture one bounded PNG through PBRemote after local screen-sharing consent.",
        "Request a bounded input lease. Only the local operator can approve it.",
        "Read the state of this bridge's own input lease.",
        "Execute one validated input operation under this bridge's exact active PBRemote lease.",
        "Latch this bridge closed, revoke screen sharing and pending/active input authority. No automatic restart.",
        "Read sampled monitor geometry and the focused application's declared class after local screen-sharing consent. This does not restrict input to an application or authenticate its identity.",
        "Open one consent-gated pull stream. No frame is captured until next is called. Defaults: 2 fps, 120 frames; no input authority.",
        "Poll one stream frame. Obey retry_after_ms/next_frame_in_ms; unchanged means the previous image still applies. No capture queue or background recorder.",
        "Report bounded client playback pressure; PBRemote may reduce quality/rate and recover within the originally requested limits.",
        "Close this connection's stream and discard its cached frame without revoking separately approved input."
    ];
    for i len(NAMES) {
        array_push(entries, map{ name: NAMES[i], description: descriptions[i],
            inputSchema: schemas[i], annotations: map{
                readOnlyHint: i == 0 or i == 1 or i == 3 or i == 6 or i == 8,
                destructiveHint: i == 4, openWorldHint: i == 1 or i == 4 or i == 6 or i == 8,
                idempotentHint: i == 0 or i == 3 or i == 5 or i == 6 or i == 10
            } });
    }
    return entries;
}

fn _input(args) {
    _strict(args, ["kind", "payload"]);
    let kind = try args.kind catch nil;
    let payload = try args.payload catch nil;
    if kind == "key" {
        _strict(payload, ["text", "key"]);
        if map_has(payload, "text") == map_has(payload, "key") { throw "ambiguous key input"; }
        let value = if map_has(payload, "text") { payload.text } else { payload.key };
        let limit = if map_has(payload, "text") { 4096 } else { 64 };
        if type(value) != "string" or len(value) < 1 or len(value) > limit
            or str_contains(value, strfromcharcode(0)) { throw "invalid key input"; }
    } elif kind == "pointer" {
        _strict(payload, ["x", "y", "button"]);
        _integer(payload.x, 0, 16383); _integer(payload.y, 0, 16383);
        if map_has(payload, "button") { _integer(payload.button, 1, 3); }
    } elif kind == "pointer_relative" {
        _strict(payload, ["dx", "dy"]);
        _integer(payload.dx, -32768, 32768); _integer(payload.dy, -32768, 32768);
    } elif kind == "click" {
        _strict(payload, ["button"]); _integer(payload.button, 1, 3);
    } else { throw "unsupported input kind"; }
}

fn new(desktop, options = nil) {
    // These are local constructor values, never deserialized MCP arguments.
    if options == nil { options = map{}; }
    _strict(options, ["capture_provider", "input_executor", "input_cleanup", "context_provider"]);
    let input_cleanup = try options.input_cleanup catch nil;
    if input_cleanup != nil and type(input_cleanup) != "closure" and type(input_cleanup) != "function" and type(input_cleanup) != "builtin" {
        throw "Input cleanup must be a local function";
    }
    // Module exports use member access; modules are not dynamically keyed maps.
    let required = try [desktop.new, desktop.status, desktop.request_control,
        desktop.control_status, desktop.input_leased, desktop.capture_preview,
        desktop.set_capture_enabled, desktop.lock_local, desktop.approve_control,
        desktop.close_control, desktop.png_dimensions, desktop.stream_open, desktop.stream_next,
        desktop.stream_feedback, desktop.stream_close] catch [];
    if len(required) != 15 { throw "PBRemote desktop API is incomplete"; }
    for i len(required) {
        let kind = type(required[i]);
        if kind != "closure" and kind != "function" and kind != "builtin" {
            throw "PBRemote desktop API is incomplete";
        }
    }
    let config = map{ input_enabled: true, capture_enabled: false,
        control_lease_ttl_ms: 120000, control_lease_max_events: 512,
        max_pending_leases: 1, max_pending_input: 1,
        max_streams: 1, max_frame_bytes: 4194304 };
    let keys = map_keys(options);
    for i len(keys) { if keys[i] != "context_provider" and keys[i] != "input_cleanup" { config[keys[i]] = options[keys[i]]; } }
    let context_provider = try options.context_provider catch Context.read;
    let service = desktop.new(config);
    let owner = base64_encode_bytes(random_bytes(32));
    let stream = Streams.new(desktop, service, owner);
    let state = map{ stopped: false, busy: false, lease_id: "", cleanup_ok: true,
        cleanup_base_ok: false, cleanup_attempted: false,
        frame_key: "", frame: nil, frame_size: 0, review: "", requested_ttl: 0,
        context: nil, context_attempt_ms: -1000, sustained: nil };

    fn refresh_context() {
        if state.stopped { return nil; }
        let now = now_ms();
        if now >= state.context_attempt_ms and now - state.context_attempt_ms < 1000 {
            return json_parse(json_stringify(state.context));
        }
        state.context_attempt_ms = now; state.context = nil;
        let observed = try context_provider() catch nil;
        if state.stopped or not (try Context.valid(observed) catch false) { return nil; }
        if observed.observed_at_ms > now_ms() or now_ms() - observed.observed_at_ms > 3000 { return nil; }
        state.context = json_parse(json_stringify(observed));
        return json_parse(json_stringify(state.context));
    }

    fn clear_frame() {
        state.frame_key = ""; state.frame = nil; state.frame_size = 0;
    }

    fn finish_cleanup() {
        // Never free an executor's resources while its synchronous call is on
        // the stack. A blocked call is terminated by the independent guard.
        if not state.stopped or state.busy or state.cleanup_attempted { return; }
        state.cleanup_attempted = true;
        let backend_ok = true;
        if input_cleanup != nil { backend_ok = (try input_cleanup() catch false) == true; }
        state.cleanup_ok = state.cleanup_base_ok and backend_ok;
    }
    fn stopped_result() {
        return map{ ok: state.cleanup_ok, format: FORMAT, stopped: true,
            cleanup_confirmed: state.cleanup_ok, in_flight: state.busy,
            restart_requires_new_bridge: true };
    }
    fn stop() {
        if state.stopped { return stopped_result(); }
        // Latch before any callback: nested Stop cannot re-enter cleanup or
        // report it complete while it is still running. Never retry cleanup.
        state.stopped = true; state.sustained = nil;
        state.cleanup_ok = false;
        state.context = nil;
        stream.reset();
        clear_frame();
        // Deny new admission before backend cleanup, including re-entrant calls.
        service.input_enabled = false;
        let capture = try desktop.set_capture_enabled(service, false) catch map{ ok: false };
        let input = try desktop.lock_local(service) catch map{ ok: false };
        state.lease_id = "";
        state.review = "";
        state.cleanup_base_ok = (try capture.ok catch false) == true and (try input.ok catch false) == true;
        finish_cleanup();
        return stopped_result();
    }
    fn deny() {
        state.sustained = nil;
        if state.lease_id == "" { return _failure("No local request is available"); }
        state.review = "";
        let id = state.lease_id; state.lease_id = "";
        let closed = try desktop.close_control(service, map{ request_id: id }, owner) catch nil;
        if closed == nil or not closed.ok { return stop(); }
        return map{ ok: true, format: FORMAT, state: "closed" };
    }
    fn expire_budget() {
        if state.sustained != nil and not state.busy
            and not Budget.refresh(state.sustained.budget, num_floor(now_ms())) { deny(); }
    }
    fn status() {
        expire_budget();
        let s = desktop.status(service);
        if s.active_streams == 0 { stream.reset(); }
        let budget = nil;
        if state.sustained != nil { budget = Budget.snapshot(state.sustained.budget); }
        return map{ ok: true, format: FORMAT, stopped: state.stopped,
            busy: state.busy, input_budget: budget, remembered_input: state.sustained != nil, capture_enabled: s.capture_enabled,
            local_capture_consent: s.capture_local_consent_active,
            input_enabled: s.input_enabled, pending_control: s.pending_control_leases,
            active_control: s.active_control_leases, active_streams: s.active_streams, cleanup_confirmed: state.cleanup_ok };
    }
    fn lease_status() {
        expire_budget();
        if state.lease_id == "" { return _failure("No control request belongs to this bridge"); }
        let out = desktop.control_status(service,
            map{ request_id: state.lease_id }, owner);
        if not out.ok { state.lease_id = ""; return _failure("Control lease is unavailable or expired"); }
        return map{ ok: true, format: FORMAT, state: out.state,
            expires_at: out.expires_at, remaining_events: out.remaining_events,
            scopes: out.scopes };
    }
    fn renewed_lease(required_events = 1) {
        let allowed = state.sustained;
        if allowed == nil or state.stopped { return false; }
        if not Budget.refresh(allowed.budget, num_floor(now_ms())) { deny(); return false; }
        let current = lease_status();
        if current.ok and current.state == "active" {
            if current.remaining_events >= required_events { return true; }
            if not desktop.close_control(service, map{ request_id: state.lease_id }, owner).ok { return false; }
            state.lease_id = "";
        } elif current.ok { return false; }
        let request = desktop.request_control(service,
            map{ scopes: allowed.scopes, ttl_ms: 120000, max_events: 512 }, owner);
        if not request.ok { return false; }
        state.lease_id = request.request_id; state.requested_ttl = 120000; state.review = "";
        let result = desktop.approve_control(service, state.lease_id, allowed.nonce);
        if not result.ok or result.state != "active" { return false; }
        // PBRemote holds the rolling text policy on its lease. Retain the
        // exact private object across expiry/quota renewal so split text cannot
        // reset that policy at an automatic renewal boundary.
        let next = nil;
        for key in map_keys(service.control_leases) {
            let candidate = service.control_leases[key];
            if candidate.request_id == state.lease_id { next = candidate; }
        }
        if next == nil { return false; }
        if allowed.previous_lease != nil { next.typed_context = allowed.previous_lease.typed_context; }
        allowed.previous_lease = next;
        return true;
    }
    fn image_result(frame, consent_revision) {
        if frame.encoding != "png" or type(frame.data_b64) != "string"
            or len(frame.data_b64) > 131072 { throw "invalid frame"; }
        _integer(frame.size, 24, 98304);
        let identity = sha256(frame.data_b64);
        if identity != frame.sha256 {
            throw "invalid frame identity";
        }
        let sanitized = state.frame;
        if state.frame_key != identity or state.frame_size != frame.size or sanitized == nil {
            let bytes = base64_decode_bytes(frame.data_b64);
            if len(bytes) != frame.size { throw "invalid frame size"; }
            let checked = DesktopPNG.sanitize(bytes);
            if not checked.ok { throw "invalid desktop PNG"; }
            sanitized = map{ data: base64_encode_bytes(checked.bytes),
                width: checked.width, height: checked.height,
                color_profile_removed: checked.color_profile_removed };
        }
        // Consent changes during capture/validation invalidate the result,
        // including a revoke followed by a new approval before completion.
        if state.stopped or not service.capture_enabled
            or service.capture_consent_revision != consent_revision {
            clear_frame(); throw "capture consent changed";
        }
        state.frame_key = identity; state.frame_size = frame.size; state.frame = sanitized;
        return map{ ok: true, format: FORMAT, content_captured: true,
            mime_type: "image/png", data_b64: sanitized.data,
            color_profile_removed: sanitized.color_profile_removed,
            width: sanitized.width, height: sanitized.height };
    }
    fn dispatch(name, args) {
        if name == "pbremote_stream_close" {
            _strict(args, []); let closed = stream.close(); clear_frame(); return closed;
        }
        if name == "pbremote_stream_open" or name == "pbremote_stream_next" or name == "pbremote_stream_feedback" {
            let revision = service.capture_consent_revision;
            if not service.capture_enabled or not status().local_capture_consent { return _failure("Local screen-sharing consent is required"); }
            let result = nil;
            if name == "pbremote_stream_open" { result = stream.open(args); }
            elif name == "pbremote_stream_feedback" { result = stream.feedback(args); }
            else { result = stream.next(args); }
            if state.stopped or not service.capture_enabled or service.capture_consent_revision != revision {
                stream.reset(); clear_frame(); throw "stream consent changed";
            }
            if not result.ok { return _failure("Desktop stream is unavailable or request was rejected"); }
            if map_has(result, "frame") {
                let image = image_result(result.frame, revision);
                if result.metadata.remaining_frames == 0 { clear_frame(); }
                image.stream = result.metadata; return image;
            }
            if (try result.remaining_frames catch -1) == 0 { clear_frame(); }
            return result;
        }
        if name == "pbremote_desktop_context" {
            _strict(args, []);
            let consent_revision = service.capture_consent_revision;
            if not service.capture_enabled or not status().local_capture_consent { return _failure("Local screen-sharing consent is required"); }
            let observed = refresh_context();
            if state.stopped or not service.capture_enabled or service.capture_consent_revision != consent_revision
                or not status().local_capture_consent { return _failure("Desktop context consent changed"); }
            if observed == nil { return _failure("Desktop context is unavailable"); }
            return map{ ok: true, format: FORMAT, context: observed };
        }
        if name == "pbremote_control_request" {
            _strict(args, ["scopes", "ttl_ms", "max_events"]);
            let scopes = try args.scopes catch nil;
            if type(scopes) != "array" or len(scopes) < 1 or len(scopes) > 2 { throw "invalid scopes"; }
            for i len(scopes) {
                if not _contains(["pointer", "keyboard"], scopes[i]) { throw "invalid scope"; }
            }
            if len(scopes) == 2 and scopes[0] == scopes[1] { throw "duplicate scope"; }
            let ttl = _integer(try args.ttl_ms catch 30000, 5000, 120000);
            let count = _integer(try args.max_events catch 64, 1, 512);
            if state.sustained != nil {
                for scope in scopes { if not _contains(state.sustained.scopes, scope) { return _failure("Scope exceeds remembered local approval"); } }
                if not renewed_lease() {
                    if state.sustained != nil { stop(); }
                    return _failure("Local input allowance ended; new local approval required");
                }
                return lease_status();
            }
            if state.lease_id != "" and lease_status().ok { return _failure("A control request already exists"); }
            let requested = desktop.request_control(service,
                map{ scopes: scopes, ttl_ms: ttl, max_events: count }, owner);
            if not requested.ok { return _failure("PBRemote rejected the control request"); }
            state.lease_id = requested.request_id;
            state.review = base64_encode_bytes(random_bytes(32));
            state.requested_ttl = ttl;
            return lease_status();
        }
        if name == "pbremote_control_status" { _strict(args, []); return lease_status(); }
        if name == "pbremote_desktop_input" {
            _input(args);
            if state.sustained != nil {
                let scope = if args.kind == "key" { "keyboard" } else { "pointer" };
                if not _contains(state.sustained.scopes, scope) { return _failure("Input exceeds remembered local approval"); }
                let cost = if args.kind == "pointer" and map_has(args.payload, "button") { 2 } else { 1 };
                if not renewed_lease(cost) {
                    if state.sustained != nil { stop(); }
                    return _failure("Local input allowance ended; new local approval required");
                }
                if not Budget.reserve(state.sustained.budget, cost, num_floor(now_ms())) {
                    deny(); return _failure("Local input allowance is insufficient; new local approval required");
                }
            }
            if state.lease_id == "" { return _failure("Local control approval is required"); }
            let applied = desktop.input_leased(service, args.kind, args.payload,
                state.lease_id, owner);
            if not applied.ok { stop(); return _failure("PBRemote rejected the input operation; bridge stopped"); }
            if applied.state != "executed_under_control_lease" { stop(); return _failure("Unexpected input state; bridge stopped"); }
            let budget = nil;
            if state.sustained != nil { budget = Budget.snapshot(state.sustained.budget); }
            return map{ ok: true, format: FORMAT, effect_performed: true,
                remaining_events: applied.remaining_events, input_budget: budget };
        }
        if name == "pbremote_desktop_capture" {
            _strict(args, []);
            let consent_revision = service.capture_consent_revision;
            let frame = desktop.capture_preview(service, map{
                encoding: "png", max_width: 1280, max_height: 720, max_bytes: 98304 });
            if not frame.ok { return _failure("PBRemote capture is unavailable or not locally approved"); }
            return image_result(frame, consent_revision);
        }
        return _failure("Unknown desktop tool");
    }
    fn call(name, args = nil) {
        if args == nil { args = map{}; }
        if not _contains(NAMES, name) { return _failure("Unknown desktop tool"); }
        if name == "pbremote_desktop_stop" {
            if not (try { _strict(args, []); true } catch false) { return _failure("Invalid desktop arguments"); }
            return stop();
        }
        if name == "pbremote_desktop_status" {
            if not (try { _strict(args, []); true } catch false) { return _failure("Invalid desktop arguments"); }
            let current = try status() catch nil;
            if current == nil { stop(); return _failure("Desktop status failed; bridge stopped"); }
            return current;
        }
        if state.stopped { return _failure("Desktop bridge is stopped"); }
        if state.busy { return _failure("Desktop bridge is busy"); }
        state.busy = true;
        let result = try dispatch(name, args) catch nil;
        if result == nil {
            stop(); result = _failure("Desktop operation failed or arguments are invalid; bridge stopped");
        }
        state.busy = false;
        // Never publish a frame or successful action result after local Stop.
        if state.stopped { finish_cleanup();return _failure("Desktop bridge stopped during operation"); }
        return result;
    }
    fn share(enabled, context = nil) {
        clear_frame();
        state.context = nil; state.context_attempt_ms = -1000;
        stream.close();
        if state.stopped { return _failure("Desktop bridge is stopped"); }
        return desktop.set_capture_enabled(service, enabled, context);
    }
    fn approve(nonce) {
        if state.stopped or state.busy or state.lease_id == "" { return _failure("No local approval is available"); }
        let approved = try desktop.approve_control(service, state.lease_id, nonce) catch nil;
        if approved == nil or not approved.ok {
            // Invalid nonces need not consume PBRemote's pending request.
            // Close it explicitly before dropping the private identifier.
            deny(); return _failure("Local approval failed");
        }
        return lease_status();
    }
    fn review() {
        let view = status();
        view.desktop_context = json_parse(json_stringify(state.context));
        view.review_token = "";
        view.control = nil;
        if not state.stopped and state.lease_id != "" {
            let lease = lease_status();
            if lease.ok {
                // The display receives a detached snapshot, never the live
                // scopes array owned by the service's lease policy.
                view.control = json_parse(json_stringify(lease));
                view.control.requested_ttl_ms = state.requested_ttl;
                if lease.state == "pending_local_approval" {
                    view.review_token = state.review;
                }
            }
        }
        return view;
    }
    fn authorize_session(scopes, nonce, limits = nil) {
        // Only the private local channel calls this. No name/model is trusted.
        if limits == nil { limits = Budget.unlimited(); }
        if not Budget.valid(limits) { return _failure("Invalid local input limits"); }
        if state.stopped or state.busy or type(scopes) != "array" or len(scopes) < 1 or len(scopes) > 2
            or type(nonce) != "string" or len(nonce) < 8 or len(nonce) > 256 { return _failure("Invalid local session approval"); }
        for scope in scopes { if not _contains(["keyboard", "pointer"], scope) { return _failure("Invalid local scope"); } }
        if len(scopes) == 2 and scopes[0] == scopes[1] { return _failure("Duplicate local scope"); }
        if state.lease_id != "" { deny(); }
        state.sustained = map{ scopes: json_parse(json_stringify(scopes)), nonce: nonce, previous_lease: nil, budget: Budget.new(limits, num_floor(now_ms())) };
        if not renewed_lease() { stop(); return _failure("Local session approval failed"); }
        return map{ ok: true, remembered_input: true };
    }
    fn approve_review(token, nonce, limits = nil) {
        if type(token) != "string" or token == "" or token != state.review {
            return _failure("The displayed control request is no longer current");
        }
        let current = review();
        if current.review_token != token { return _failure("The displayed control request expired"); }
        state.review = "";
        if limits != nil { return authorize_session(current.control.scopes, nonce, limits); }
        return approve(nonce);
    }
    return map{ call: call, catalog: catalog,
        local: map{ authorize_session: authorize_session, share: share, approve: approve, approve_review: approve_review,
            review: review, refresh_context: refresh_context, deny: deny, stop: stop, status: status } };
}

export new, catalog, FORMAT;
