fn can_handle(tool) {
    if tool == "omni_v32_pcc_1500_full_status" { return true; }
    let names = implemented_tools();
    for i len(names) {
        if names[i] == tool { return true; }
    }
    return false;
}

fn handle(tool, req) {
    let m = _v32();
    if m != nil {
        if tool == "medusa_jacobi_1500toks_decode" or tool == "medusa_jacobi_24head_34tok_verify" or tool == "zero_ram_11_6mb_active_0_58mb_idle_check" {
