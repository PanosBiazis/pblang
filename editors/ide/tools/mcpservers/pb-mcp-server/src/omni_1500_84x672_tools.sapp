        if tool == "omni_v32_pcc_8m_84x672x6400_full_status" or tool == "omni_v32_pcc_1500_full_status" {
            let r7 = m.evaluate_v32_0_pcc_omni_8m_and_84x672x6400_status(req);
            r7.tool = tool;
