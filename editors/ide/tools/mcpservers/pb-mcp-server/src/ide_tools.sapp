// Native pblang translations for IDE/editor planning and local symbol search.

let sec = import("security.sapp");
let core = import("core_tools.sapp");

fn _clip(s, max_chars) {
    s = str(s);
    max_chars = sec.clamp(max_chars, 1, 120000);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _safe_path(path) {
    return sec.safe_rel_path(path, "");
}

fn _open_plan(editor, path, line) {
    path = _safe_path(path);
    line = sec.clamp(line, 1, 1000000);
    let target = path + ":" + str(line);
    let cmd = [editor, target];
    if editor == "code" { cmd = ["code", "--goto", target]; }
    if editor == "zed" { cmd = ["zed", target]; }
    if editor == "cursor" { cmd = ["cursor", target]; }
    return map{ ok: true, executed: false, editor: editor, command: cmd, path: path, line: line, message: "pblang port returns an editor command plan; use terminal_run with an allowlisted editor to execute" };
}

fn _diff_plan(editor, left, right) {
    left = _safe_path(left);
    right = _safe_path(right);
    if editor == "code" { return map{ ok: true, executed: false, command: ["code", "--diff", left, right], left: left, right: right }; }
    return map{ ok: true, executed: false, command: [editor, left, right], left: left, right: right };
}

fn ide_find_references(args) {
    if args == nil { args = map{}; }
    let symbol = str(try args.symbol catch try args.query catch "");
    let dir = try args.path catch try args.dir catch ".";
    let matches = core.grep_code(symbol, dir, try args.max_matches catch 50);
    return map{ symbol: symbol, references: matches, total_returned: len(matches), engine: "pblang-grep" };
}

fn ide_goto_definition(args) {
    if args == nil { args = map{}; }
    let symbol = str(try args.symbol catch try args.query catch "");
    let dir = try args.path catch try args.dir catch ".";
    let patterns = ["fn " + symbol, "def " + symbol, "class " + symbol, "struct " + symbol, "function " + symbol, "const " + symbol];
    let out = [];
    for i len(patterns) {
        let hits = core.grep_code(patterns[i], dir, try args.max_matches catch 50);
        for j len(hits) { out[len(out)] = hits[j]; }
    }
    return map{ symbol: symbol, definitions: out, total_returned: len(out), engine: "pblang-grep" };
}

fn ide_detect(args) {
    let out = [];
    let raw = try exec("ps -eo pid,comm,args") catch "";
    let lines = str_split(raw, "\n");
    let names = ["code", "cursor", "zed", "idea", "pycharm", "clion", "rustrover", "android-studio", "vim", "nvim", "emacs"];
    for i len(lines) {
        let l = str_lower(lines[i]);
        for j len(names) {
            if str_contains(l, names[j]) { out[len(out)] = map{ name: names[j], line: lines[i] }; }
        }
    }
    return map{ detected: out, engine: "ps-scan", trusted_profile: not sec.is_public_profile() };
}

fn ide_format_document(args) {
    let path = _safe_path(try args.path catch "");
    let formatter = str(try args.formatter catch "auto");
    return map{ ok: true, executed: false, path: path, formatter: formatter, message: "formatting is planned only in the pblang port; use terminal_run/project tools with explicit allowlist to execute" };
}

fn ide_run_test(args) {
    let path = _safe_path(try args.path catch try args.test_path catch ".");
    let kind = str(try args.kind catch "auto");
    return map{ ok: true, executed: false, path: path, kind: kind, message: "test run is planned only; project_cargo_test/project_pytest remain catalog-only until full argv policy is ported" };
}

fn vscode_open_file(args) { return _open_plan("code", try args.path catch "", try args.line catch 1); }
fn cursor_open_file(args) { return _open_plan("cursor", try args.path catch "", try args.line catch 1); }
fn zed_open_file(args) { return _open_plan("zed", try args.path catch "", try args.line catch 1); }
fn jetbrains_open_file(args) { return _open_plan(str(try args.ide catch "idea"), try args.path catch "", try args.line catch 1); }

fn vscode_open_diff(args) { return _diff_plan("code", try args.left catch try args.path_a catch "", try args.right catch try args.path_b catch ""); }

fn cursor_composer_send(args) {
    let path = _safe_path(try args.path catch "");
    return map{ ok: true, executed: false, path: path, prompt: str(try args.prompt catch try args.content catch ""), instructions: "Open Cursor Composer and paste the prompt; command execution is intentionally not automatic in pblang port" };
}

fn zed_context_attach(args) {
    let path = _safe_path(try args.path catch "");
    return map{ ok: true, executed: false, path: path, context_reference: "@" + path, instructions: "Use the context reference in Zed Assistant" };
}

fn zed_search_workspace(args) {
    return map{ ok: true, executed: false, query: str(try args.query catch ""), command: ["zed", "--search", str(try args.query catch "")] };
}

fn vscode_get_diagnostics(args) {
    return map{ ok: true, diagnostics: [], available_live: false, guidance: "VS Code diagnostics are not exposed through a portable pblang API; use Problems panel or an LSP bridge" };
}

fn zed_get_diagnostics(args) {
    return map{ ok: true, diagnostics: [], available_live: false, guidance: "Zed diagnostics are not exposed through a portable pblang API; use the editor UI or LSP bridge" };
}

fn vscode_list_extensions(args) {
    return map{ ok: false, blocked: true, command: ["code", "--list-extensions", "--show-names"], message: "requires terminal allowlist; pblang port does not auto-run editor CLI" };
}

fn vscode_install_extension(args) {
    return map{ ok: false, blocked: true, extension: str(try args.extension catch try args.id catch ""), command: ["code", "--install-extension", str(try args.extension catch try args.id catch "")], message: "installing extensions is a write action and remains gated" };
}

fn jetbrains_device_list(args) {
    return map{ ok: false, blocked: true, command: ["adb", "devices", "-l"], message: "ADB device listing requires terminal allowlist and is not auto-run by pblang port" };
}

fn jetbrains_logcat_tail(args) {
    return map{ ok: false, blocked: true, command: ["adb", "logcat", "-d", "-t", str(try args.lines catch 100)], message: "logcat requires terminal allowlist and is not auto-run by pblang port" };
}

fn jetbrains_adb_shell(args) {
    return map{ ok: false, blocked: true, command: ["adb", "shell", str(try args.command catch "")], message: "ADB shell is an external command and remains gated" };
}

fn jetbrains_lsp_code_action(args) {
    return map{ ok: true, executed: false, path: _safe_path(try args.path catch ""), line: try args.line catch 1, action: str(try args.action catch ""), message: "LSP code action planned only; no IDE REST call is made" };
}

fn jetbrains_run_configuration(args) {
    return map{ ok: false, blocked: true, configuration: str(try args.name catch try args.configuration catch ""), message: "running IDE configurations is a write/execute action and remains gated" };
}

let _IDE_LAZY = map{};
fn _ide_wave() {
    if map_has(_IDE_LAZY, "Wave") { return _IDE_LAZY["Wave"]; }
    let w = import("stdlib:backlog_completion_wave.sapp");
    _IDE_LAZY["Wave"] = w;
    return w;
}

fn pbide_all_os_device_editions(args) {
    if args == nil { args = map{}; }
    let W = _ide_wave();
    let theme = str(try args.theme catch "obsidian_aurora_glass");
    let os_targets = [
        map{ id: "linux", archs: ["x64", "x86_32bit", "arm64"], renderer: "X11/Wayland/SDL2/WGPU + TUI", package: "pblang-linux-x64.tar.gz / pblang-linux-x86.tar.gz / pblang-linux-arm64.tar.gz", status: "implemented" },
        map{ id: "windows", archs: ["x64", "x86_32bit"], renderer: "Win32/Direct2D/WGPU", package: "pblang-windows-x64.zip / pblang-windows-x86.zip", status: "implemented" },
        map{ id: "macos", archs: ["universal_arm64_x64"], renderer: "Cocoa/Metal/CoreText", package: "pblang-macos.tar.gz", status: "implemented" },
        map{ id: "freebsd", archs: ["x64"], renderer: "X11/Wayland Workstation", package: "pblang-freebsd-x64.tar.gz", status: "implemented" },
        map{ id: "android", archs: ["arm64", "x86_64"], renderer: "ModernUI Android APK + Touch/Stylus/D-Pad", package: "pblang-android-arm64.tar.gz", status: "preview" },
        map{ id: "ios_ipados", archs: ["arm64"], renderer: "ModernUI iOS/iPadOS Safe-Area + Stage Manager + Pencil", package: "pbide-ios-bundle", status: "contract" },
        map{ id: "web_pwa_wasm32", archs: ["wasm32", "zero_js_csp_html"], renderer: "CSP-Locked Zero-JS HTTP + Offline WASM32 PWA", package: "pblang-wasm32.tar.gz", status: "preview" },
        map{ id: "baremetal_pbos", archs: ["arm_cortex_m", "riscv32", "x64_uefi"], renderer: "Direct Framebuffer HMI (320x240..1920x1080)", package: "pblang-baremetal.tar.gz", status: "implemented" },
        map{ id: "terminal_tui_ssh", archs: ["any_posix_vt100"], renderer: "Zero-X11 ANSI/VT100 Split-Pane TUI", package: "built-in CLI/TUI", status: "implemented" },
        map{ id: "retro_8bit_16bit", archs: ["dos_16bit_8086", "cpm80_8bit", "avr8_atmega328p"], renderer: "80x25 Text / Serial Monitor & Cycle-Accurate Emulator Bridge", package: "pblang-legacy-8bit-16bit.zip", status: "implemented" }
    ];
    let device_classes = [
        map{ id: "desktop_4k_hidpi", resolution: "3840x2160", scale: 2.0, input: ["keyboard", "mouse", "multi_monitor"], active_panels: 11 },
        map{ id: "laptop_1080p", resolution: "1920x1080", scale: 1.25, input: ["keyboard", "trackpad"], active_panels: 11 },
        map{ id: "tablet_foldable", resolution: "2208x1768", scale: 1.5, input: ["touch", "stylus_pen", "virtual_or_bt_keyboard"], active_panels: 6 },
        map{ id: "mobile_phone_portrait_landscape", resolution: "1080x2400", scale: 1.0, input: ["touch", "swipe_nav", "symbol_bar"], active_panels: 4 },
        map{ id: "smart_tv_dpad_10ft", resolution: "1920x1080", scale: 1.75, input: ["dpad_remote", "media_keys"], active_panels: 4 },
        map{ id: "embedded_touch_panel", resolution: "800x480", scale: 1.0, input: ["capacitive_touch", "hardware_buttons"], active_panels: 3 },
        map{ id: "terminal_tui_ssh", resolution: "120x40_cells", scale: 1.0, input: ["keyboard_chords"], active_panels: 5 },
        map{ id: "retro_8bit_16bit_console", resolution: "80x25_cells", scale: 1.0, input: ["serial_tty", "keyboard"], active_panels: 2 }
    ];
    let flagship_ui = W.build_flagship_showcase_screen(theme);
    return map{
        ok: flagship_ui.ok,
        product: "pbide",
        theme: theme,
        os_target_count: len(os_targets),
        device_class_count: len(device_classes),
        os_targets: os_targets,
        device_classes: device_classes,
        flagship_ui_ready: flagship_ui.ok,
        embedded_pbai_connected: true,
        embedded_pb_mcp_connected: true
    };
}

fn pbide_polyform_14target_designer(args) {
    if args == nil { args = map{}; }
    let W = _ide_wave();
    let suite = W.run_visual_sketch_and_polyform_wave6_suite(nil);
    return map{
        ok: suite.ok,
        sketch_widgets: suite.sketch_to_ui.widgets_count,
        compiled_target_count: suite.emitted_targets_count,
        ingested_external_frameworks_count: suite.ingested_external_frameworks_count,
        suite: suite
    };
}

fn pbide_multi_arch_matrix(args) {
    if args == nil { args = map{}; }
    let W = _ide_wave();
    let matrix = W.evaluate_multi_arch_and_mode_matrix(map{});
    let stage2 = W.execute_stage2_selfhost_bootstrap_and_binary_emit(map{});
    return map{
        ok: matrix.ok and stage2.ok,
        multi_arch: matrix,
        stage2_binary_emit: stage2
    };
}

fn pbide_self_heal_and_rope_engine(args) {
    if args == nil { args = map{}; }
    let W = _ide_wave();
    let rope = W.evaluate_ide_rope_and_symbol_engine(nil);
    let contract = W.verify_formal_contract("ide_buffer_commit", "len(buf) >= 0", "result.digest != ''", "true");
    let egraph = W.run_egraph_superoptimizer("(x * 2) / 2", 2);
    return map{
        ok: rope.ok and contract.ok and egraph.ok,
        rope_and_symbols: rope,
        formal_contract: contract,
        egraph_superoptimizer: egraph
    };
}

fn call_ide(tool, args) {
    if args == nil { args = map{}; }
    if tool == "ide_detect" { return ide_detect(args); }
    if tool == "ide_find_references" { return ide_find_references(args); }
    if tool == "ide_goto_definition" { return ide_goto_definition(args); }
    if tool == "ide_format_document" { return ide_format_document(args); }
    if tool == "ide_run_test" { return ide_run_test(args); }
    if tool == "vscode_open_file" { return vscode_open_file(args); }
    if tool == "vscode_open_diff" { return vscode_open_diff(args); }
    if tool == "vscode_get_diagnostics" { return vscode_get_diagnostics(args); }
    if tool == "vscode_list_extensions" { return vscode_list_extensions(args); }
    if tool == "vscode_install_extension" { return vscode_install_extension(args); }
    if tool == "cursor_open_file" { return cursor_open_file(args); }
    if tool == "cursor_composer_send" { return cursor_composer_send(args); }
    if tool == "zed_open_file" { return zed_open_file(args); }
    if tool == "zed_context_attach" { return zed_context_attach(args); }
    if tool == "zed_search_workspace" { return zed_search_workspace(args); }
    if tool == "zed_get_diagnostics" { return zed_get_diagnostics(args); }
    if tool == "jetbrains_open_file" { return jetbrains_open_file(args); }
    if tool == "jetbrains_device_list" { return jetbrains_device_list(args); }
    if tool == "jetbrains_logcat_tail" { return jetbrains_logcat_tail(args); }
    if tool == "jetbrains_adb_shell" { return jetbrains_adb_shell(args); }
    if tool == "jetbrains_lsp_code_action" { return jetbrains_lsp_code_action(args); }
    if tool == "jetbrains_run_configuration" { return jetbrains_run_configuration(args); }
    if tool == "pbide_all_os_device_editions" { return pbide_all_os_device_editions(args); }
    if tool == "pbide_polyform_14target_designer" { return pbide_polyform_14target_designer(args); }
    if tool == "pbide_multi_arch_matrix" { return pbide_multi_arch_matrix(args); }
    if tool == "pbide_self_heal_and_rope_engine" { return pbide_self_heal_and_rope_engine(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "ide_detect",
        "ide_find_references",
        "ide_goto_definition",
        "ide_format_document",
        "ide_run_test",
        "vscode_open_file",
        "vscode_open_diff",
        "vscode_get_diagnostics",
        "vscode_list_extensions",
        "vscode_install_extension",
        "cursor_open_file",
        "cursor_composer_send",
        "zed_open_file",
        "zed_context_attach",
        "zed_search_workspace",
        "zed_get_diagnostics",
        "jetbrains_open_file",
        "jetbrains_device_list",
        "jetbrains_logcat_tail",
        "jetbrains_adb_shell",
        "jetbrains_lsp_code_action",
        "jetbrains_run_configuration",
        "pbide_all_os_device_editions",
        "pbide_polyform_14target_designer",
        "pbide_multi_arch_matrix",
        "pbide_self_heal_and_rope_engine",
    ];
}

export implemented_tools, call_ide,
       ide_detect, ide_find_references, ide_goto_definition,
       ide_format_document, ide_run_test, vscode_open_file, vscode_open_diff,
       vscode_get_diagnostics, vscode_list_extensions,
       vscode_install_extension, cursor_open_file, cursor_composer_send,
       zed_open_file, zed_context_attach, zed_search_workspace,
       zed_get_diagnostics, jetbrains_open_file, jetbrains_device_list,
       jetbrains_logcat_tail, jetbrains_adb_shell, jetbrains_lsp_code_action,
       jetbrains_run_configuration, pbide_all_os_device_editions,
       pbide_polyform_14target_designer, pbide_multi_arch_matrix,
       pbide_self_heal_and_rope_engine;

