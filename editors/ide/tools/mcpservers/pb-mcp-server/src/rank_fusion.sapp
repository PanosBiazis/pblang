// Original identifier-only reciprocal rank fusion. No source scores, text,
// model files or executable expressions are accepted.
fn fuse(args) {
    if type(args) != "map" or len(map_keys(args)) != 3 or not map_has(args,"rankings")
        or not map_has(args,"rank_constant") or not map_has(args,"top_k") { throw "invalid rank fusion request"; }
    if type(args.rankings) != "array" or len(args.rankings) < 1 or len(args.rankings) > 16 { throw "invalid ranking sources"; }
    if type(args.rank_constant) != "number" or not (args.rank_constant >= 1 and args.rank_constant <= 10000)
        or args.rank_constant != num_floor(args.rank_constant) { throw "invalid rank constant"; }
    if type(args.top_k) != "number" or not (args.top_k >= 1 and args.top_k <= 100)
        or args.top_k != num_floor(args.top_k) { throw "invalid fusion result count"; }
    // Validate every source before allocating score records. A repeated ID in
    // one source is ambiguous and must not manufacture additional votes.
    let total = 0; let longest = 0;
    for ranking in args.rankings {
        if type(ranking) != "array" or len(ranking) > 4096 { throw "invalid ranking list"; }
        total = total+len(ranking);
        if len(ranking)>longest { longest=len(ranking); }
        if total > 16384 { throw "rank fusion work budget exceeded"; }
        let seen = map{};
        for id in ranking {
            if type(id) != "string" or len(id) < 1 or len(id) > 128 or map_has(seen,id) { throw "invalid ranked identity"; }
            seen[id] = true;
        }
    }
    let scores = map{}; let counts = map{}; let order = [];
    for ranking in args.rankings {
        for i len(ranking) {
            let id = ranking[i];
            if not map_has(scores,id) { scores[id] = 0.0; counts[id] = 0; array_push(order,id); }
            counts[id] = counts[id]+1;
        }
    }
    // Accumulate in increasing rank order, independent of source-list order.
    // Equal rank multisets now receive exactly equal floating scores; no epsilon
    // merges distinct scores. Preserve source-order first-seen ties above.
    // At most 4096 ranks * 16 sources; no per-ID contribution arrays are needed.
    for i longest {
        let contribution=1.0/(args.rank_constant+i+1);
        for ranking in args.rankings {
            if i<len(ranking) {
                let id=ranking[i];scores[id]=scores[id]+contribution;
            }
        }
    }
    // Iterate explicit first-seen order; map enumeration order is irrelevant.
    // Only retain k output records, rather than sorting/copying all candidates.
    let best = [];
    for id in order {
        let score = scores[id]; let at = 0;
        while at < len(best) and best[at].score >= score { at = at+1; }
        if at < args.top_k {
            if len(best) < args.top_k { array_push(best,nil); }
            let j = len(best)-1;
            while j > at { best[j] = best[j-1]; j = j-1; }
            best[at] = map{id:id,score:score,source_count:counts[id]};
        }
    }
    return map{format:"pb_mcp.rank-fusion.v1",ok:true,native_pblang:true,
        effect_performed:false,network_used:false,model_loaded:false,persisted:false,
        data_provenance:"untrusted_caller_supplied",instructions_from_data:false,
        method:"reciprocal_rank_fusion",rank_constant:args.rank_constant,
        tie_break:"first_seen",score_is_probability:false,source_count:len(args.rankings),
        evaluated:len(order),ranked_entries:total,results:best};
}
export fuse;
