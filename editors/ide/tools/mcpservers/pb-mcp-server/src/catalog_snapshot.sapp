// A caller-supplied discovery transcript is data, never authority or execution.
// This module has no imports, transport, persistence, or host-effect boundary.
fn _fail() { throw "catalog snapshot: invalid or unsupported transcript"; }

fn limits() {
    return map{pages:16, tools:256, required_tools:128, name_bytes:128,
        cursor_bytes:1024, id_bytes:128, depth:32, nodes:16384, entries:8192,
        aggregate_string_bytes:262144};
}

fn _has(items, value) {
    for item in items { if item == value { return true; } }
    return false;
}

fn _exact(value, allowed, required) {
    if type(value) != "map" or len(value) > len(allowed) { _fail(); }
    for key in map_keys(value) { if not _has(allowed,key) { _fail(); } }
    for key in required { if not map_has(value,key) { _fail(); } }
}

fn _bytes(value, maximum) {
    // Scalar length is a cheap precheck before the bounded UTF-8 conversion.
    if type(value) != "string" or len(value) > maximum { _fail(); }
    let size=len(str_to_bytes(value));
    if size > maximum { _fail(); }
    return size;
}

fn _walk(value, depth, budget) {
    budget.nodes=budget.nodes+1;
    if depth>32 or budget.nodes>16384 { _fail(); }
    let kind=type(value);
    // Comparing an unvalidated map with nil may dispatch its __eq__ hook.
    // Inspect the builtin kind instead; metadata must never execute operators.
    if kind=="nil" or kind=="bool" { return; }
    if kind=="number" {
        if value!=value or value-value!=0 { _fail(); }
        return;
    }
    if kind=="string" {
        budget.bytes=budget.bytes+_bytes(value,262144-budget.bytes);
        return;
    }
    if kind!="array" and kind!="map" { _fail(); }
    budget.entries=budget.entries+len(value);
    if budget.entries>8192 { _fail(); }
    if kind=="array" {
        for item in value { _walk(item,depth+1,budget); }
    } else {
        for key in map_keys(value) {
            budget.bytes=budget.bytes+_bytes(key,262144-budget.bytes);
            _walk(value[key],depth+1,budget);
        }
    }
}

fn _name(value) {
    if _bytes(value,128)<1 { _fail(); }
    for i len(value) {
        let code=strcharcodeat(value,i);
        if code<32 or code==127 { _fail(); }
    }
    return value;
}

fn _id(value) {
    if type(value)=="string" {
        _bytes(value,128);
        for i len(value) {
            let code=strcharcodeat(value,i);
            if code<32 or code==127 { _fail(); }
        }
        return "s:"+value;
    }
    if type(value)!="number" or value!=value or value-value!=0
        or value!=num_floor(value) or value < -9007199254740991
        or value > 9007199254740991 { _fail(); }
    return "n:"+str(if value==0 {0} else {value});
}

fn _meta(value) { if type(value)!="map" { _fail(); } }

fn _schema(value) {
    // Schema bodies are bounded JSON metadata. No JSON Schema evaluation,
    // reference resolution, property coercion, or execution is performed.
    if type(value)!="map" or (try value.type catch nil)!="object" { _fail(); }
}

fn _descriptor(value) {
    _exact(value,["name","title","description","inputSchema","outputSchema","annotations","_meta"],
        ["name","inputSchema"]);
    let name=_name(value.name);
    _schema(value.inputSchema);
    if map_has(value,"outputSchema") { _schema(value.outputSchema); }
    for field in ["title","description"] {
        if map_has(value,field) and type(value[field])!="string" { _fail(); }
    }
    if map_has(value,"_meta") { _meta(value._meta); }
    if map_has(value,"annotations") {
        let a=value.annotations;
        _exact(a,["title","readOnlyHint","destructiveHint","idempotentHint","openWorldHint"],[]);
        if map_has(a,"title") and type(a.title)!="string" { _fail(); }
        for field in ["readOnlyHint","destructiveHint","idempotentHint","openWorldHint"] {
            if map_has(a,field) and type(a[field])!="bool" { _fail(); }
        }
    }
    return name;
}

fn review(args) {
    _exact(args,["protocol_version","pages","required_tools"],["protocol_version","pages"]);
    if type(args.protocol_version)!="string" or args.protocol_version!="2025-06-18" or type(args.pages)!="array"
        or len(args.pages)<1 or len(args.pages)>16 { _fail(); }
    let required=try args.required_tools catch [];
    if type(required)!="array" or len(required)>128 { _fail(); }
    // Validate the entire bounded JSON graph before copying projected names.
    // Cycles and repeated aliases terminate by depth/node budgets.
    _walk(args,0,map{nodes:0,entries:0,bytes:0});
    let wanted=map{};
    for name in required {
        _name(name);
        if map_has(wanted,name) { _fail(); }
        wanted[name]=true;
    }
    let names=[];let found=map{};let ids=map{};let cursors=map{};
    let next="";let has_next=false;
    for index len(args.pages) {
        let page=args.pages[index];
        _exact(page,["request","response"],["request","response"]);
        let request=page.request;let response=page.response;
        _exact(request,["jsonrpc","id","method","params"],["jsonrpc","id","method"]);
        if request.jsonrpc!="2.0" or request.method!="tools/list" { _fail(); }
        let id=_id(request.id);
        if map_has(ids,id) { _fail(); }
        ids[id]=true;
        let params=try request.params catch map{};
        _exact(params,["cursor","_meta"],[]);
        if map_has(params,"_meta") { _meta(params._meta); }
        if index==0 {
            if map_has(params,"cursor") { _fail(); }
        } else {
            if not has_next or not map_has(params,"cursor") { _fail(); }
            _bytes(params.cursor,1024);
            if params.cursor!=next { _fail(); }
        }
        _exact(response,["jsonrpc","id","result"],["jsonrpc","id","result"]);
        if response.jsonrpc!="2.0" or _id(response.id)!=id { _fail(); }
        let result=response.result;
        _exact(result,["tools","nextCursor","_meta"],["tools"]);
        if map_has(result,"_meta") { _meta(result._meta); }
        if type(result.tools)!="array" or len(result.tools)>256-len(names) { _fail(); }
        for tool in result.tools {
            let name=_descriptor(tool);
            if map_has(found,name) { _fail(); }
            found[name]=true;array_push(names,name);
        }
        has_next=map_has(result,"nextCursor");
        if has_next {
            _bytes(result.nextCursor,1024);next=result.nextCursor;
            if map_has(cursors,next) { _fail(); }
            cursors[next]=true;
        }
    }
    if has_next { _fail(); }
    let present=[];let missing=[];
    for name in required {
        if map_has(found,name) { array_push(present,name); }
        else { array_push(missing,name); }
    }
    return map{format:"pb_mcp.catalog_snapshot.v1",protocol_version:"2025-06-18",
        complete:true,compatible:len(missing)==0,page_count:len(args.pages),
        tool_count:len(names),tool_names:names,required_count:len(required),
        present_required:present,missing_required:missing,
        provenance:"caller-supplied-unverified",safe_to_log:false,metadata_only:true,
        external_calls:false,authentication_performed:false,tools_executed:false,
        schemas_evaluated:false};
}

export review, limits;
