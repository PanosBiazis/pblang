// Native pblang translations for read-only system/sys tools.

let sec = import("security.sapp");

fn _clip(s, max_chars) {
    max_chars = sec.clamp(max_chars, 1, 200000);
    s = str(s);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _safe_word(value, fallback) {
    if value == nil or value == "" { return fallback; }
    let s = str(value);
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-:/";
    for i len(s) {
        if not str_contains(allowed, str_slice(s, i, i + 1)) { throw "unsafe argument: " + s; }
    }
    return s;
}

fn _run(cmd, max_chars) {
    sec.require_trusted("system read-only command");
    let out = try exec(cmd) catch nil;
    if out == nil { return map{ ok: false, command: cmd, stdout: "", error: "command failed or unavailable" }; }
    return map{ ok: true, command: cmd, stdout: _clip(out, max_chars) };
}

fn system_env_get(args) {
    sec.require_trusted("system_env_get");
    let name = str(try args.name catch try args.key catch "");
    if name == "" { return map{ ok: false, error: "name is required" }; }
    let v = try env_get(name) catch nil;
    return map{ ok: v != nil, name: name, value: if v == nil { nil } else { sec.redact_env(name, v) } };
}

fn system_process_list(args) {
    return _run("ps -eo pid,ppid,stat,comm,args", try args.max_chars catch 120000);
}

fn system_disk_usage(args) {
    let path = _safe_word(try args.path catch ".", ".");
    return _run("df -h " + path, try args.max_chars catch 40000);
}

fn system_network_interfaces(args) {
    let r = _run("ip addr", try args.max_chars catch 80000);
    if r.ok == true { return r; }
    return _run("ifconfig -a", try args.max_chars catch 80000);
}

fn sys_hardware_info(args) {
    let uname = _run("uname -a", 40000);
    let cpu = _run("lscpu", 80000);
    let mem = _run("free -h", 40000);
    return map{ uname: uname, cpu: cpu, memory: mem };
}

fn sys_cron_list(args) {
    return _run("crontab -l", try args.max_chars catch 80000);
}

fn sys_docker_ps(args) {
    return _run("docker ps --format json", try args.max_chars catch 120000);
}

fn sys_docker_logs(args) {
    let container = _safe_word(try args.container catch try args.name catch "", "");
    if container == "" { return map{ ok: false, error: "container is required" }; }
    let tail = sec.clamp(try args.tail catch 100, 1, 5000);
    return _run("docker logs --tail " + str(tail) + " " + container, try args.max_chars catch 120000);
}

fn sys_journal_tail(args) {
    let unit = _safe_word(try args.unit catch try args.service catch "", "");
    let n = sec.clamp(try args.lines catch try args.n catch 100, 1, 5000);
    let cmd = "journalctl -n " + str(n) + " --no-pager";
    if unit != "" { cmd = cmd + " -u " + unit; }
    return _run(cmd, try args.max_chars catch 120000);
}

fn sys_k8s_pods(args) {
    let ns = _safe_word(try args.namespace catch "", "");
    let cmd = "kubectl get pods";
    if ns != "" { cmd = cmd + " -n " + ns; }
    return _run(cmd, try args.max_chars catch 120000);
}

fn sys_k8s_logs(args) {
    let pod = _safe_word(try args.pod catch "", "");
    if pod == "" { return map{ ok: false, error: "pod is required" }; }
    let ns = _safe_word(try args.namespace catch "", "");
    let tail = sec.clamp(try args.tail catch 100, 1, 5000);
    let cmd = "kubectl logs --tail " + str(tail) + " " + pod;
    if ns != "" { cmd = cmd + " -n " + ns; }
    return _run(cmd, try args.max_chars catch 120000);
}

fn call_system(tool, args) {
    if args == nil { args = map{}; }
    if tool == "system_env_get" { return system_env_get(args); }
    if tool == "system_process_list" { return system_process_list(args); }
    if tool == "system_disk_usage" { return system_disk_usage(args); }
    if tool == "system_network_interfaces" { return system_network_interfaces(args); }
    if tool == "sys_hardware_info" { return sys_hardware_info(args); }
    if tool == "sys_cron_list" { return sys_cron_list(args); }
    if tool == "sys_docker_ps" { return sys_docker_ps(args); }
    if tool == "sys_docker_logs" { return sys_docker_logs(args); }
    if tool == "sys_journal_tail" { return sys_journal_tail(args); }
    if tool == "sys_k8s_pods" { return sys_k8s_pods(args); }
    if tool == "sys_k8s_logs" { return sys_k8s_logs(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "system_env_get",
        "system_process_list",
        "system_disk_usage",
        "system_network_interfaces",
        "sys_hardware_info",
        "sys_cron_list",
        "sys_docker_ps",
        "sys_docker_logs",
        "sys_journal_tail",
        "sys_k8s_pods",
        "sys_k8s_logs",
    ];
}

export implemented_tools, call_system,
       system_env_get, system_process_list, system_disk_usage,
       system_network_interfaces, sys_hardware_info, sys_cron_list,
       sys_docker_ps, sys_docker_logs, sys_journal_tail,
       sys_k8s_pods, sys_k8s_logs;
