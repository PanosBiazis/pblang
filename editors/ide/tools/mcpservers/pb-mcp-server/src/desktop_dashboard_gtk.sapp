// Local read-only dashboard. Reuses the operator snapshot; no extra polling,
// network listeners, logs, permissions, model inference or simulated metrics.
fn new(native, parent) {
    let g = native.g;
    let state = map{ window: 0, text: 0, stop: 0, tabs: [], selected: "Overview", rendered: "", visible: false, rendered_at: -1000 };
    fn open() {
        if state.window == 0 {
            state.window = g("gtk_window_new", "->ptr", []);
            g("gtk_window_set_title", "ptr,string->void", [state.window, "PB-MCP Dashboard"]);
            g("gtk_window_set_default_size", "ptr,i32,i32->void", [state.window, 720, 440]);
            g("gtk_window_set_hide_on_close", "ptr,bool->void", [state.window, true]);
            g("gtk_window_set_transient_for", "ptr,ptr->void", [state.window, parent]);
            let body = g("gtk_box_new", "i32,i32->ptr", [1, 14]);
            for side in ["top", "bottom", "start", "end"] { g("gtk_widget_set_margin_" + side, "ptr,i32->void", [body, 16]); }
            let row = g("gtk_box_new", "i32,i32->ptr", [0, 6]);
            for title in ["Overview", "Agents", "Bus", "Tools", "Security", "Metrics"] {
                let button = g("gtk_toggle_button_new_with_label", "string->ptr", [title]);
                g("gtk_box_append", "ptr,ptr->void", [row, button]);
                array_push(state.tabs, map{ title: title, widget: button });
            }
            state.text = g("gtk_label_new", "string->ptr", [""]);
            g("gtk_label_set_wrap", "ptr,bool->void", [state.text, true]);
            g("gtk_widget_set_vexpand", "ptr,bool->void", [state.text, true]);
            state.stop = g("gtk_toggle_button_new_with_label", "string->ptr", ["STOP — disconnect immediately"]);
            for widget in [row, state.text, state.stop] { g("gtk_box_append", "ptr,ptr->void", [body, widget]); }
            g("gtk_window_set_child", "ptr,ptr->void", [state.window, body]);
        }
        state.visible = true;
        state.rendered_at = -1000;
        g("gtk_window_present", "ptr->void", [state.window]);
    }
    fn poll(view) {
        if not state.visible { return false; }
        state.visible = g("gtk_widget_get_visible", "ptr->bool", [state.window]);
        if not state.visible { return false; }
        if g("gtk_toggle_button_get_active", "ptr->bool", [state.stop]) { return true; }
        for tab in state.tabs {
            if g("gtk_toggle_button_get_active", "ptr->bool", [tab.widget]) {
                state.selected = tab.title;
                state.rendered_at = -1000;
                g("gtk_toggle_button_set_active", "ptr,bool->void", [tab.widget, false]);
            }
        }
        // Stop and buttons stay responsive; text needs no 40 Hz recomputation.
        let now = now_ms();
        if now >= state.rendered_at and now - state.rendered_at < 250 { return false; }
        state.rendered_at = now;
        let text = state.selected + "\n\n";
        if state.selected == "Overview" { text = text + view.status + "\n\n" + view.context; }
        elif state.selected == "Agents" {
            text = text + view.identity + "\n\nOne local connection. Other agents and the actual model cannot be independently identified here.";
        } elif state.selected == "Bus" {
            text = text + view.activity + "\n\nArguments, typed text and screen images are not retained in this dashboard. Multi-agent bus is not connected.";
        } elif state.selected == "Tools" {
            text = text + "Desktop profile: status, capture, context, control request/status, input, Stop, stream open/next/feedback/close.\n\nAvailability is subject to current local approval. This panel does not execute or enable tools.";
        } elif state.selected == "Security" {
            text = text + view.status + "\n\n" + view.details + "\n\nIdentity labels are client declarations. Approval and revocation remain in Local Control. STOP ends this connection.";
        } else {
            text = text + view.activity + "\n\nCPU/GPU/RAM, tokens and cost of the AI provider: unavailable. These durations measure local MCP requests, not model generation. No persistent history is written.";
        }
        if text != state.rendered {
            g("gtk_label_set_text", "ptr,string->void", [state.text, text]); state.rendered = text;
        }
        return false;
    }
    fn close() {
        if state.window != 0 { g("gtk_window_destroy", "ptr->void", [state.window]); state.window = 0; }
        state.visible = false;
    }
    return map{ open: open, poll: poll, close: close };
}
export new;
