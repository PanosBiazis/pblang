let NFC=import("stdlib:nfc_text.sapp");
fn call_nfc(tool,args){
    if tool!="nfc_text_encode" and tool!="nfc_text_inspect"{return nil;}
    if type(args)!="map"{throw "NFC: invalid arguments";}
    let fields=if tool=="nfc_text_encode"{["text","language"]}else{["data_base64","include_text"]};
    for key in map_keys(args){let found=false;for name in fields{if key==name{found=true;}}if not found{throw "NFC: unknown argument";}}
    if tool=="nfc_text_encode"{
        let bytes=NFC.encode(try args.text catch nil,try args.language catch "en");
        return map{data_base64:base64_encode_bytes(bytes),size_bytes:len(bytes),device_accessed:false,tag_written:false};
    }
    let encoded=try args.data_base64 catch nil;
    if type(encoded)!="string" or len(encoded)>5464 {throw "NFC: invalid encoded message";}
    let bytes=try base64_decode_bytes(encoded) catch nil;
    if type(bytes)!="array" or len(bytes)>4096 or base64_encode_bytes(bytes)!=encoded {throw "NFC: invalid encoded message";}
    return NFC.inspect(bytes,try args.include_text catch false);
}
fn implemented_tools(){return ["nfc_text_encode","nfc_text_inspect"];}
fn catalog_entries(){
    let schemas=[map{type:"object",properties:map{text:map{type:"string",maxLength:4000},language:map{type:"string",minLength:1,maxLength:15}},required:["text"],additionalProperties:false},
        map{type:"object",properties:map{data_base64:map{type:"string",maxLength:5464},include_text:map{type:"boolean",default:false}},required:["data_base64"],additionalProperties:false}];
    let descriptions=["Encode caller-supplied UTF-8 text as a bounded single-record NDEF Text message. Returns bytes only; no NFC reader, physical tag write or hardware detection.",
        "Inspect a single NDEF UTF-8 Text record up to4096bytes; text omitted unless include_text is true. Chunked, URI, ID-bearing, UTF-16 and multiple records rejected. No links opened, tags accessed, ownership or location inferred."];
    let out=[];let names=implemented_tools();for i len(names){out[len(out)]=map{name:names[i],category:"nfc",profile:"core-code",read_only:true,destructive:false,open_world:false,source:"src/nfc_tools.sapp",description:descriptions[i],input_schema:schemas[i]};}return out;
}
fn functional_records(){let out=[];for e in catalog_entries(){out[len(out)]=map{name:e.name,status:"complete",public_mcp:true,input_schema:e.input_schema,reason:"offline NDEF Text subset only; no device authority",evidence_ids:["nfc_text:known-vector","nfc_text:malformed-privacy"]};}return out;}
export call_nfc,implemented_tools,catalog_entries,functional_records;
