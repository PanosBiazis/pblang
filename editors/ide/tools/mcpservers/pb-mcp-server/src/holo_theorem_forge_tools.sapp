    let m = try import("editors/ide/tools/ai/pbai_sovereign_apex_v27.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_sovereign_apex_v27.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_sovereign_apex_v27.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_sovereign_apex_v27.sapp") catch nil; }
    _V27_CACHE["m"] = m;
    return m;
}

