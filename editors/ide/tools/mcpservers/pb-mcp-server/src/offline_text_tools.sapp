    if name=="compress_simplify_whitespace" {result=TEXT.compress_simplify_whitespace(args.text,maximum);}
    if name=="compress_markdown_links" {result=TEXT.compress_markdown_links(args.text,maximum);}
    if name=="compress_unified_diff_stats" {result=TEXT.compress_unified_diff_stats(args.text,maximum);}
