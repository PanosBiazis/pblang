    if name=="compress_lines_tail" {result=TEXT.compress_lines_tail(args.text,try args.tail_lines catch 80,maximum);}
    if name=="compress_collapse_blank_lines" {result=TEXT.compress_collapse_blank_lines(args.text,maximum);}
    if name=="compress_dedent" {result=TEXT.compress_dedent(args.text,maximum);}
    if name=="summarize_headings" {result=TEXT.summarize_headings(args.text,try args.max_headings catch 40,maximum);}
    if name=="summarize_markdown_toc" {result=TEXT.summarize_markdown_toc(args.text,try args.max_entries catch 40,maximum);}
    if name=="summarize_token_estimate" {result=TEXT.summarize_token_estimate(args.text,maximum);}
    // Match the generic MCP structured-content projection for non-map values.
    let structured=if type(result)=="map" {result} else {map{value:result}};
    if len(str_to_bytes(json_stringify(structured)))>65536 {throw "offline text result limit";}
    return structured;
}
fn catalog_entries() {
    let entries=[];
    for spec in _specs() {
        let props=map{text:map{type:"string",maxLength:16384,description:"At most 16384 UTF-8 bytes and 2048 LF-separated logical lines; empty input is allowed."},
