// Narrow offline surface over existing, shared PBLang text implementations.
let TEXT=import("text_compute.sapp");
fn _integer(value,low,high) {
    if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value) {throw "invalid offline text bound";}
}
fn _specs() {
    return [
        map{name:"summarize_rank_lines_by_keywords",detail:"Select lines by counts of whole ASCII keyword tokens, case-insensitive, descending score with source-order ties. Duplicate/case-equivalent keywords do not multiply scores. max_chars clips the input prefix before scoring and may cut a token/line; line numbers are one-based. Not semantic retrieval or factual validation.",options:map{top_lines:map{type:"integer",minimum:1,maximum:200,default:40}}},
        map{name:"compress_ws_collapse",detail:"Collapse spaces/tabs/CR and trim each line while preserving LF line structure.",options:map{}},
        map{name:"compress_simplify_whitespace",detail:"Collapse spaces/tabs/CR/LF to single spaces and trim the result.",options:map{}},
        map{name:"compress_markdown_links",detail:"Replace simple Markdown image/link syntax with visible labels using fixed patterns; not a full Markdown parser.",options:map{}},
        map{name:"compress_unified_diff_stats",detail:"Count added/removed lines and hunks and return unique raw diff header paths within the character budget; paths are never opened.",options:map{}},
        map{name:"compress_truncate_lines",detail:"Shorten each long line with an ellipsis before applying the total character budget.",options:map{max_line_chars:map{type:"integer",minimum:16,maximum:512,default:120}}},
        map{name:"summarize_diff_file_list",detail:"Return sorted unique diff header paths, removing a/ and b/ prefixes and excluding /dev/null; no filesystem lookup.",options:map{max_paths:map{type:"integer",minimum:4,maximum:500,default:200}}},
        map{name:"compress_fenced_code_blocks",detail:"Replace triple-backtick fenced regions with an omission marker; an unclosed fence omits the remaining lines. Not a full Markdown parser.",options:map{}},
        map{name:"compress_markdown_frontmatter",detail:"Remove a closed leading --- frontmatter block; preserve an unclosed block. No YAML parsing.",options:map{}},
        map{name:"compress_unique_lines",detail:"Keep first occurrences of exact nonblank lines in input order.",options:map{max_lines:map{type:"integer",minimum:1,maximum:10000,default:200}}},
        map{name:"compress_lines_head",detail:"Keep the first logical LF-separated lines, including blank lines.",options:map{head_lines:map{type:"integer",minimum:1,maximum:10000,default:80}}},
        map{name:"compress_lines_tail",detail:"Keep the last logical LF-separated lines, including a trailing empty line when present.",options:map{tail_lines:map{type:"integer",minimum:1,maximum:10000,default:80}}},
        map{name:"compress_collapse_blank_lines",detail:"Collapse each run of whitespace-only lines to one empty line.",options:map{}},
        map{name:"compress_dedent",detail:"Remove the minimum common leading space/tab scalar count from nonblank lines; tabs count as one scalar.",options:map{}},
        map{name:"summarize_headings",detail:"Extract one-based line numbers, levels and titles of simple ATX headings; does not exclude fenced regions.",options:map{max_headings:map{type:"integer",minimum:1,maximum:200,default:40}}},
        map{name:"summarize_markdown_toc",detail:"Build an indented bullet table of contents from the same simple ATX heading scan; not a full Markdown parser.",options:map{max_entries:map{type:"integer",minimum:1,maximum:200,default:40}}},
        map{name:"summarize_token_estimate",detail:"Return word, Unicode scalar, UTF-8 byte and line counts plus max(word count, floor(scalars/4)) token estimate; a heuristic, not a tokenizer.",options:map{}}
