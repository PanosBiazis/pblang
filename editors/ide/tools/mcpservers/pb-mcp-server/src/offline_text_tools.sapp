            props.keywords=map{type:"array",minItems:1,maxItems:100,items:map{type:"string",minLength:1,maxLength:128,pattern:"^[A-Za-z0-9_]+$"},description:"Whole ASCII tokens only; no whitespace, punctuation or controls. Duplicates are allowed and do not increase scores."};
            push(required,"keywords");
