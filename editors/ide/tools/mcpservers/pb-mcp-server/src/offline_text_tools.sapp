fn implemented_tools() {let names=[];for spec in _specs() {push(names,spec.name);}return names;}
fn _admit(args,spec) {
    if type(args)!="map" or not map_has(args,"text") {throw "invalid offline text arguments";}
    for key in map_keys(args) {
        if key=="text" or key=="max_chars" or (spec.name=="summarize_rank_lines_by_keywords" and key=="keywords") or map_has(spec.options,key) {continue;}
        throw "invalid offline text arguments";
    }
    if type(args.text)!="string" or len(args.text)>16384 or len(str_to_bytes(args.text))>16384 {throw "offline text input limit";}
    if len(str_split(args.text,"\n"))>2048 {throw "offline text line limit";}
    if spec.name=="summarize_rank_lines_by_keywords" {
        let keywords=try args.keywords catch nil;
        if type(keywords)!="array" or len(keywords)<1 or len(keywords)>100 {throw "invalid offline keywords";}
        for keyword in keywords {
            if type(keyword)!="string" or len(keyword)<1 or len(keyword)>128 {throw "invalid offline keyword";}
