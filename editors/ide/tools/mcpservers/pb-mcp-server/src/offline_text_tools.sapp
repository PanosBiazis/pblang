    if name=="compress_fenced_code_blocks" {result=TEXT.compress_fenced_code_blocks(args.text,maximum);}
    if name=="compress_markdown_frontmatter" {result=TEXT.compress_markdown_frontmatter(args.text,maximum);}
    if name=="compress_unique_lines" {result=TEXT.compress_unique_lines(args.text,try args.max_lines catch 200,maximum);}
