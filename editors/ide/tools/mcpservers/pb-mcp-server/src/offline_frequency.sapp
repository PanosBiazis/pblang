// Bounded lexical frequency routes; shared full-server computation stays unchanged.
let TEXT=import("text_compute.sapp");
fn _specs(){return [
    map{name:"summarize_top_terms",pattern:"[A-Za-z0-9_]+",detail:"Count lowercase ASCII [A-Za-z0-9_]+ tokens, excluding the fixed English stopword set and tokens shorter than min_token_len. Rank by decreasing count then lexical token order. This is lexical frequency, not semantic importance.",options:map{min_token_len:map{type:"integer",minimum:2,maximum:32,default:2},max_terms:map{type:"integer",minimum:1,maximum:80,default:20}}},
    map{name:"summarize_identifier_frequency",pattern:"[A-Za-z_][A-Za-z0-9_]*",detail:"Count ASCII identifier-shaped runs starting with [A-Za-z_] and continuing with [A-Za-z0-9_]. Leading digits are skipped, so123foo yields foo. Strings/comments are included; not a parser or symbol-reference analysis. Optional fold_case defaults false. Rank by decreasing count then lexical identifier order.",options:map{min_len:map{type:"integer",minimum:1,maximum:64,default:1},max_identifiers:map{type:"integer",minimum:1,maximum:120,default:20},fold_case:map{type:"boolean",default:false}}}
];}
fn implemented_tools(){let out=[];for spec in _specs(){push(out,spec.name);}return out;}
fn _integer(value,low,high){if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value){throw "invalid frequency bound";}}
fn call_frequency(name,args){
    let selected:any=nil;for spec in _specs(){if spec.name==name{selected=spec;}}
    if selected==nil{return nil;}
    if type(args)!="map" or not map_has(args,"text"){throw "invalid frequency arguments";}
    for key in map_keys(args){if key!="text" and key!="max_chars" and not map_has(selected.options,key){throw "invalid frequency arguments";}}
    if type(args.text)!="string" or len(args.text)>8192 or len(str_to_bytes(args.text))>8192{throw "frequency input limit";}
    let maximum=if map_has(args,"max_chars"){args.max_chars}else{4000};_integer(maximum,1,4096);
    for key in map_keys(selected.options){if map_has(args,key){
        if key=="fold_case" and type(args[key])!="bool"{throw "invalid case option";}
        if key!="fold_case"{_integer(args[key],selected.options[key].minimum,selected.options[key].maximum);}
    }}
    let terms=name=="summarize_top_terms";let folded=if terms{true}else{try args.fold_case catch false};
    let value:any=nil;
    if terms {value=TEXT.summarize_top_terms(args.text,try args.min_token_len catch 2,try args.max_terms catch 20,maximum);} else {value=TEXT.summarize_identifier_frequency(args.text,try args.min_len catch 1,try args.max_identifiers catch 20,maximum,folded);}
    let result=map{value:value,token_coverage:"ascii_only",ascii_tokens_present:len(regex_find_all(str_slice(args.text,0,maximum),selected.pattern))>0,
        input_truncated:len(args.text)>maximum,case_folded:folded,stop_words_excluded:terms,
        semantic_analysis:false,safe_to_log:false,automatic_deletion:false};
    if len(str_to_bytes(json_stringify(result)))>65536{throw "frequency output limit";}
    return result;
}
fn catalog_entries(){let out=[];for spec in _specs(){
    let props=map{text:map{type:"string",maxLength:8192,description:"At most8192 UTF-8 bytes; empty allowed."},max_chars:map{type:"integer",minimum:1,maximum:4096,default:4000}};
    for key in map_keys(spec.options){props[key]=spec.options[key];}
    push(out,map{name:spec.name,category:"offline-text",profile:"core-code",read_only:true,destructive:false,open_world:false,source:"src/text_compute.sapp",
        description:spec.detail+" max_chars clips a Unicode-scalar input prefix before scanning and can cut a token. Non-ASCII letters are ignored or split ASCII runs. Returns value plus ascii_only token coverage, ASCII presence before filters, input_truncated, case_folded, stop_words_excluded and false semantic_analysis/safe_to_log/automatic_deletion. Empty results may mean no ASCII tokens or filtering. Returned caller tokens may be private. <=8192 UTF-8 input bytes; max_chars1..4096 default4000; <=65536 serialized output bytes. No file/network/model/execution/storage or trust grant.",input_schema:map{type:"object",required:["text"],additionalProperties:false,properties:props}});
}return out;}
export implemented_tools,call_frequency,catalog_entries;
