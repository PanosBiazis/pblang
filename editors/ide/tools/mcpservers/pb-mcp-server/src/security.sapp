// pblang pb-mcp-server security helpers.
//
// This is intentionally stricter than normal filesystem helpers: by default it
// accepts only project-relative paths and rejects traversal, absolute paths,
// Windows drive roots, NUL bytes, and hidden control paths.

let MAX_READ_CHARS = 200000;
let MAX_LIST_ENTRIES = 2000;
let MAX_GREP_MATCHES = 400;
let MAX_DEPTH = 12;

fn bool_env(name, fallback = false) {
    let v = try env_get(name) catch nil;
    if v == nil { return fallback; }
    let s = str_lower(str_trim(str(v)));
    if s == "1" or s == "true" or s == "yes" or s == "on" { return true; }
    if s == "0" or s == "false" or s == "no" or s == "off" { return false; }
    return fallback;
}

fn network_profile() {
    let v = try env_get("PB_NETWORK_PROFILE") catch nil;
    if v == nil { v = try env_get("MINT_NETWORK_PROFILE") catch nil; }
    if v == nil { return "local"; }
    return str_lower(str_trim(str(v)));
}

fn is_public_profile() {
    let p = network_profile();
    return p == "public" or p == "internet" or p == "wan";
}

fn clamp(n, lo, hi) {
    if n == nil { return lo; }
    if n < lo { return lo; }
    if n > hi { return hi; }
    return n;
}

fn safe_rel_path(path, fallback = ".") {
    if path == nil or path == "" { return fallback; }
    if type(path) != "string" { throw "path must be a string"; }
    if str_contains(path, "\x00") { throw "NUL byte in path"; }
    if str_starts_with(path, "/") or str_starts_with(path, "\\") {
        throw "absolute paths are refused by default: " + path;
    }
    if len(path) >= 3 and str_slice(path, 1, 3) == ":\\" {
        throw "Windows absolute paths are refused by default: " + path;
    }
    let norm = str_replace_all(path, "\\", "/");
    let parts = str_split(norm, "/");
    for i len(parts) {
        let p = parts[i];
        if p == ".." {
            throw "parent traversal refused: " + path;
        }
    }
    return norm;
}

fn join_path(a, b) {
    if a == nil or a == "" or a == "." { return safe_rel_path(b, "."); }
    if b == nil or b == "" { return safe_rel_path(a, "."); }
    let aa = safe_rel_path(a, ".");
    let bb = safe_rel_path(b, ".");
    if str_ends_with(aa, "/") { return aa + bb; }
    return aa + "/" + bb;
}

fn is_sensitive_env_name(name) {
    let n = str_upper(str(name));
    if str_contains(n, "TOKEN") { return true; }
    if str_contains(n, "SECRET") { return true; }
    if str_contains(n, "PASSWORD") { return true; }
    if str_contains(n, "PASSWD") { return true; }
    if str_contains(n, "PRIVATE") { return true; }
    if str_contains(n, "KEY") { return true; }
    if str_contains(n, "CREDENTIAL") { return true; }
    return false;
}

fn redact_env(name, value) {
    if is_sensitive_env_name(name) { return "[redacted]"; }
    let s = str(value);
    if str_contains(s, "sk-") or str_contains(s, "ghp_") or str_contains(s, "BEGIN PRIVATE KEY") {
        return "[redacted]";
    }
    return s;
}

fn require_trusted(action) {
    if is_public_profile() {
        throw "tool blocked on public network profile: " + action;
    }
    return true;
}

export MAX_READ_CHARS, MAX_LIST_ENTRIES, MAX_GREP_MATCHES, MAX_DEPTH,
       bool_env, network_profile, is_public_profile, clamp, safe_rel_path,
       join_path, is_sensitive_env_name, redact_env, require_trusted;
