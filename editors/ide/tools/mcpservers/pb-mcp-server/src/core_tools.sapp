// Native pblang implementation of the safe pb-mcp core tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let sec = import("src/security.sapp");

fn _truncate(s, max_chars = nil) {
    if max_chars == nil { max_chars = sec.MAX_READ_CHARS; }
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _is_dir(path) {
    let items = try FS.listdir(path) catch nil;
    return items != nil and type(items) == "array";
}

fn _is_file(path) {
    let text = try FS.read(path) catch nil;
    return type(text) == "string";
}

fn _skip_name(name) {
    if name == ".git" or name == "target" or name == ".mint-mcp" { return true; }
    if name == "node_modules" or name == "__pycache__" { return true; }
    return false;
}

fn _walk(out, dir, depth, max_depth, max_entries) {
    if len(out) >= max_entries { return out; }
    if depth > max_depth { return out; }
    let items = try FS.listdir(dir) catch [];
    for i len(items) {
        if len(out) >= max_entries { return out; }
        let name = items[i];
        if _skip_name(name) {
            // skip heavy/private generated folders
        } else {
            let p = sec.join_path(dir, name);
            out[len(out)] = p;
            if _is_dir(p) {
                _walk(out, p, depth + 1, max_depth, max_entries);
            }
        }
    }
    return out;
}

fn workspace_context() {
    let root = try cwd() catch ".";
    let top = try FS.listdir(".") catch [];
    return map{
        name: "pb-mcp-server-pblang",
        runtime: "pblang",
        root: root,
        network_profile: sec.network_profile(),
        public_profile: sec.is_public_profile(),
        top_level: top,
        limits: map{
            max_read_chars: sec.MAX_READ_CHARS,
            max_list_entries: sec.MAX_LIST_ENTRIES,
            max_grep_matches: sec.MAX_GREP_MATCHES,
            max_depth: sec.MAX_DEPTH,
        },
    };
}

fn read_file(path, start_line = nil, end_line = nil, max_chars = nil) {
    let p = sec.safe_rel_path(path, ".");
    let raw = FS.read(p);
    if start_line == nil and end_line == nil {
        return _truncate(raw, max_chars);
    }
    let lines = str_split(raw, "\n");
    if start_line == nil { start_line = 1; }
    if end_line == nil or end_line > len(lines) { end_line = len(lines); }
    if start_line < 1 { start_line = 1; }
    let out = "";
    let i = start_line;
    while i <= end_line and i <= len(lines) {
        if out != "" { out = out + "\n"; }
        out = out + lines[i - 1];
        i = i + 1;
    }
    return _truncate(out, max_chars);
}

fn read_file_tail(path, n = 40, max_chars = nil) {
    let p = sec.safe_rel_path(path, ".");
    let raw = FS.read(p);
    let lines = str_split(raw, "\n");
    let nn = sec.clamp(n, 1, 1000);
    let start = len(lines) - nn + 1;
    if start < 1 { start = 1; }
    return read_file(p, start, len(lines), max_chars);
}

fn list_files(dir = ".", max_entries = nil, max_depth = nil) {
    let d = sec.safe_rel_path(dir, ".");
    if max_entries == nil { max_entries = sec.MAX_LIST_ENTRIES; }
    if max_depth == nil { max_depth = sec.MAX_DEPTH; }
    max_entries = sec.clamp(max_entries, 1, sec.MAX_LIST_ENTRIES);
    max_depth = sec.clamp(max_depth, 0, sec.MAX_DEPTH);
    let out = [];
    _walk(out, d, 0, max_depth, max_entries);
    return out;
}

fn project_tree(dir = ".", max_depth = 3, max_entries = 200) {
    let paths = list_files(dir, max_entries, max_depth);
    let out = "";
    for i len(paths) {
        if i > 0 { out = out + "\n"; }
        out = out + paths[i];
    }
    return out;
}

fn grep_code(pattern, dir = ".", max_matches = nil) {
    if pattern == nil or pattern == "" { return []; }
    if max_matches == nil { max_matches = sec.MAX_GREP_MATCHES; }
    max_matches = sec.clamp(max_matches, 1, sec.MAX_GREP_MATCHES);
    let files = list_files(dir, sec.MAX_LIST_ENTRIES, sec.MAX_DEPTH);
    let out = [];
    for i len(files) {
        if len(out) >= max_matches { return out; }
        let p = files[i];
        if _is_file(p) {
            let raw = try FS.read(p) catch "";
            let lines = str_split(raw, "\n");
            for j len(lines) {
                if len(out) >= max_matches { return out; }
                if str_contains(lines[j], pattern) {
                    out[len(out)] = map{ path: p, line: j + 1, text: lines[j] };
                }
            }
        }
    }
    return out;
}

fn text_stats(text) {
    let lines = str_split(text, "\n");
    let words = str_split(str_trim(text), " ");
    let non_empty = 0;
    for i len(lines) {
        if str_trim(lines[i]) != "" { non_empty = non_empty + 1; }
    }
    return map{
        chars: len(text),
        lines: len(lines),
        non_empty_lines: non_empty,
        rough_words: len(words),
        rough_tokens: num_floor(len(text) / 4) + 1,
    };
}

fn compress_ws_collapse(text, max_chars = nil) {
    let s = str_trim(text);
    let parts = str_split(s, " ");
    let out = "";
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" {
            if out != "" { out = out + " "; }
            out = out + p;
        }
    }
    return _truncate(out, max_chars);
}

fn compress_simplify_whitespace(text, max_chars = nil) {
    return compress_ws_collapse(str_replace_all(text, "\n", " "), max_chars);
}

fn summarize_text(text, max_chars = 1200, max_sentences = 6) {
    let normalized = str_replace_all(text, "\n", " ");
    let sentences = str_split(normalized, ".");
    let out = "";
    let used = 0;
    for i len(sentences) {
        if used >= max_sentences { return _truncate(out, max_chars); }
        let s = str_trim(sentences[i]);
        if s != "" {
            if out != "" { out = out + ". "; }
            out = out + s;
            used = used + 1;
        }
    }
    if out != "" { out = out + "."; }
    return _truncate(out, max_chars);
}

fn format_prefix_lines(text, prefix = "> ", max_chars = nil) {
    let lines = str_split(text, "\n");
    let out = "";
    for i len(lines) {
        if i > 0 { out = out + "\n"; }
        out = out + prefix + lines[i];
    }
    return _truncate(out, max_chars);
}

fn json_validate_file(path) {
    let raw = read_file(path, nil, nil, sec.MAX_READ_CHARS);
    let parsed = JSON.try_parse(raw);
    if parsed == nil {
        return map{ ok: false, path: path, error: "invalid JSON or parse failed" };
    }
    return map{ ok: true, path: path, kind: type(parsed), value: parsed };
}

fn call_core(tool, args = nil) {
    if args == nil { args = map{}; }
    if tool == "workspace_context" { return workspace_context(); }
    if tool == "read_file" { return read_file(try args.path catch ".", try args.start_line catch nil, try args.end_line catch nil, try args.max_chars catch nil); }
    if tool == "read_file_tail" { return read_file_tail(try args.path catch ".", try args.n catch 40, try args.max_chars catch nil); }
    if tool == "list_files" { return list_files(try args.dir catch ".", try args.max_entries catch nil, try args.max_depth catch nil); }
    if tool == "project_tree" { return project_tree(try args.dir catch ".", try args.max_depth catch 3, try args.max_entries catch 200); }
    if tool == "grep_code" { return grep_code(try args.pattern catch "", try args.dir catch ".", try args.max_matches catch nil); }
    if tool == "text_stats" { return text_stats(try args.text catch ""); }
    if tool == "compress_ws_collapse" { return compress_ws_collapse(try args.text catch "", try args.max_chars catch nil); }
    if tool == "compress_simplify_whitespace" { return compress_simplify_whitespace(try args.text catch "", try args.max_chars catch nil); }
    if tool == "summarize_text" { return summarize_text(try args.text catch "", try args.max_chars catch 1200, try args.max_sentences catch 6); }
    if tool == "format_prefix_lines" { return format_prefix_lines(try args.text catch "", try args.prefix catch "> ", try args.max_chars catch nil); }
    if tool == "json_validate_file" { return json_validate_file(try args.path catch ""); }
    return nil;
}

fn implemented_tools() {
    return [
        "workspace_context",
        "read_file",
        "read_file_tail",
        "list_files",
        "project_tree",
        "grep_code",
        "text_stats",
        "compress_ws_collapse",
        "compress_simplify_whitespace",
        "summarize_text",
        "format_prefix_lines",
        "json_validate_file",
    ];
}

export workspace_context, read_file, read_file_tail, list_files, project_tree,
       grep_code, text_stats, compress_ws_collapse, compress_simplify_whitespace,
       summarize_text, format_prefix_lines, json_validate_file, call_core,
       implemented_tools;
