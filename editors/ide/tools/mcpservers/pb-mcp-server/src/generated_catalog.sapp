        map{ name: "codebase_index", category: "codebase", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Bounded codebase scan: file counts and bytes per extension, optional heuristic symbol sketch (definition-like lines). One pass; respects .gitignore. Pair with grep_code for exact matches." },
