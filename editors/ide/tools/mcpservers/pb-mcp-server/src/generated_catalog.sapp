        map{ name: "code_index_symbol_prefix", category: "code", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Unique indexed symbols whose names start with prefix (case option)âlighter than full code_index_search when exploring APIs." },
