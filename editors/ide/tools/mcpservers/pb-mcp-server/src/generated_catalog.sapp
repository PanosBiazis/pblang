        map{ name: "convert_format", category: "convert", profile: "local-power", read_only: false, destructive: false, open_world: false, source: "src/main.rs", description: "Safe format helpers: JSON pretty/minify/top-level keys; TOMLâJSON and JSONâTOML (null-free); yaml_top_level_keys heuristic for quick config skims; base64/hex encode/decode; sha256_hex; utf8_bom_strip; line endings; tabs/spaces; strip_ansi; blank line ops; slugify; sort/reverse/trim lines; percent_encode/decode; html_escape. Max 256 KiB/file. output_path disallowed when MINT_NETWORK_PROFILE=public." },
