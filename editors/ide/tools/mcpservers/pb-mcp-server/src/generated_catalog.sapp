        map{ name: "terminal_program_version", category: "terminal", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Run `program --version`, then `-V`, then `version` subcommand (first output). Same MINT_TERMINAL_ENABLE + MINT_TERMINAL_ALLOW as terminal_which; safe on public profile." },
        map{ name: "terminal_run", category: "terminal", profile: "local-power", read_only: false, destructive: false, open_world: false, source: "src/main.rs", description: "Run one allowlisted program with explicit argv (no shell). Blocked when MINT_NETWORK_PROFILE=public. Requires MINT_TERMINAL_ENABLE=1; program must appear in MINT_TERMINAL_ALLOW (comma-separated bare names). cwd must stay under project root; stdout/stderr capped. The subprocess can read/write per argvâuse only on trusted local/LAN hosts." },
