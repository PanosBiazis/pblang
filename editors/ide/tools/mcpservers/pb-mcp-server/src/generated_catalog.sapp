        map{ name: "terminal_which", category: "terminal", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Resolve an allowlisted program on PATH (which / where). Read-only; uses the same MINT_TERMINAL_ENABLE + MINT_TERMINAL_ALLOW gates as terminal_run. Does not require MINT_NETWORK_PROFILE=local." },
        map{ name: "text_djb2_hash", category: "text", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "DJB2 hash (32-bit) over UTF-8 bytesâcheap fingerprint for caching, dedupe hints, or comparing blobs without storing full text." },
        map{ name: "text_levenshtein_distance", category: "text", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Levenshtein edit distance on Unicode characters (bounded nÃm for CPU safety). Compare agent drafts, filenames, or test output." },
        map{ name: "text_longest_common_substring", category: "text", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Longest contiguous substring common to two texts (Unicode scalar match). CPU-bounded via max_len_each and nÃm capâpair with text_levenshtein_distance for edit distance vs shared spans." },
        map{ name: "text_stats", category: "text", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Fast UTF-8 stats (bytes, chars, lines, words, paragraph-like blocks, rough token estimates chars/4 and chars/1.3) for prompt sizing; use summarize_token_estimate for a focused report." },
