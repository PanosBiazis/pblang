        map{ name: "summarize_line_prefix_groups", category: "summarize", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Group lines by first N characters (Unicode scalars); lists top prefixes by frequency. Useful for loggers that prefix timestamps or levels." },
