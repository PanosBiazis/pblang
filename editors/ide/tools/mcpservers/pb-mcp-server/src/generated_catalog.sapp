        map{ name: "codebase_word_index", category: "codebase", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Lightweight code-database hint: sample up to N files (8 KiB each), count identifier-like tokens, return top frequencies. Read-only; complements codebase_index and grep_code." },
        map{ name: "coding_agent_toolchains_catalog", category: "coding", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Read-only index of coding-agent CLIs (OpenClaw, Claude Code, Codex-class tools, Aider, â¦) and how they combine with this MCPâs bus, git, OCR, and deterministic text tools. No subprocesses; safe on public profile." },
        map{ name: "compress_collapse_blank_lines", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Collapse runs of blank lines to a single blank line, then cap by characters (same transform as convert_format collapse_blank_lines)." },
        map{ name: "compress_context", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Deterministically compress text for prompt budgeting (truncate, head_tail, lines_only, dense). Combine with pack_context and summarize_* for layered context shaping. No external models." },
        map{ name: "compress_dedent", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Remove common leading space/tab prefix from non-empty lines (dedent pasted code blocks)." },
        map{ name: "compress_double_slash_line_comments", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Remove lines where the first non-whitespace characters are // (full-line C/JS/Rust comments). Inline code on the same line is kept. Optional drop_blank_lines. Safe on public profile." },
        map{ name: "compress_drop_lines_matching_regex", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Remove lines that match a regex (per-line is_match). Inverse of keeping grep hits; useful log noise stripping." },
        map{ name: "compress_fenced_code_blocks", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Replace ```â¦``` fenced code blocks with a placeholder line (keeps structure outside fences). Shrinks pasted logs before bus or pack_context." },
        map{ name: "compress_file", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Read a file (optional line slice) then compress with the same modes as compress_context (head_tail, truncate, lines_only, dense)." },
        map{ name: "compress_gzip_base64", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Gzip UTF-8 bytes (from text or input_path under root, max 256 KiB) and return standard base64âcompact payloads for agent handoffs or bus posts. Pure Rust; safe on public profile." },
        map{ name: "compress_lines_head", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Keep the first N lines in order (no deduplication), then cap by characters. Use compress_unique_lines for repetitive logs." },
        map{ name: "compress_lines_tail", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Keep the last N lines (e.g. build / test log tails), then cap by characters." },
        map{ name: "compress_markdown_frontmatter", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Strip leading YAML-style markdown frontmatter (first line --- through closing ---). If no frontmatter, returns original text." },
        map{ name: "compress_markdown_links", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Heuristic: replace ![alt](url) with alt and [text](url) with text (nested brackets may truncate). Shrinks markdown before bus posts." },
        map{ name: "compress_paragraphs", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Keep the first N non-empty paragraphs (blank-line separated), then cap by characters. Good for long markdown or multi-section logs." },
        map{ name: "compress_redact_emails", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Replace email-shaped tokens with [email] (privacy). Does not understand quoted names or obfuscated addresses." },
        map{ name: "compress_redact_urls", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Replace http(s) URLs with [url] placeholders (safer log sharing). Deterministic regex; pair with compress_redact_emails." },
        map{ name: "compress_sentences", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Keep the first N sentences (split after . ? ! + whitespace), then cap by characters. Complements compress_paragraphs and compress_context." },
        map{ name: "compress_simplify_whitespace", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Per line: join whitespace-separated tokens with single spaces (stronger simplification than compress_ws_collapse). Good before summarize_* on noisy logs." },
        map{ name: "compress_strip_tags", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Heuristic strip of HTML/XML-like tags (does not parse full markup; preserves `<` that are not tag starts)." },
        map{ name: "compress_truncate_lines", category: "compress", profile: "local-power", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Truncate each line to max_line_chars Unicode scalars (suffix â¦). Tames wide logs and TSV before pack_context or bus posts." },
        map{ name: "compress_truncate_middle", category: "compress", profile: "local-power", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "When text exceeds max_chars, keep margin_chars at start and end and omit the middle (Unicode-aware)." },
        map{ name: "compress_unified_diff_stats", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Count hunks and +/- lines in unified diff text (e.g. paste git diff). Ignores +++ --- headers. Safe on public profile." },
        map{ name: "compress_unique_lines", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Deterministic line dedupe: keep first occurrence of each unique line in order, then cap by max_lines and max_chars. Shrinks repetitive logs and diffs." },
        map{ name: "compress_ws_collapse", category: "compress", profile: "core-code", read_only: true, destructive: false, open_world: false, source: "src/main.rs", description: "Collapse internal whitespace on each line (lines preserved). Complements compress_unique_lines for log cleanup." },
        map{ name: "consensus_close", category: "consensus", profile: "local-power", read_only: false, destructive: false, open_world: false, source: "src/main.rs", description: "Close a proposal, tally the final results, and persist the outcome. No further votes will be accepted." },
