// Internal bounded cosine kernel. Callers validate equal widths, finite values,
// a positive scale and work limits before entry. No input copies or I/O.
// Neumaier compensation retains small products across cancellation; this is
// floating-point arithmetic, not an exact dot product or underflow guarantee.
fn scaled(left,right,right_scale=1) {
    let total=0.0;let correction=0.0;
    for i len(left) {
        let product=left[i]*(right[i]/right_scale);
        let next=total+product;
        if num_abs(total)>=num_abs(product) {correction=correction+((total-next)+product);}
        else {correction=correction+((product-next)+total);}
        total=next;
    }
    return total+correction;
}
// MMR inputs are already normalized. Preserve the compensated accumulation
// order while omitting a redundant division by one for every component.
fn unit(left,right) {
    let total=0.0;let correction=0.0;
    for i len(left) {
        let product=left[i]*right[i];
        let next=total+product;
        if num_abs(total)>=num_abs(product) {correction=correction+((total-next)+product);}
        else {correction=correction+((product-next)+total);}
        total=next;
    }
    return total+correction;
}
// Fused search path: scale each right component once for both dot and norm.
// Keep operation order identical to scaled() plus the caller's square loop.
fn cosine(left,left_norm,right,right_scale) {
    let total=0.0;let correction=0.0;let square=0.0;
    for i len(left) {
        let x=right[i]/right_scale;let product=left[i]*x;
        square=square+x*x;
        let next=total+product;
        if num_abs(total)>=num_abs(product) {correction=correction+((total-next)+product);}
        else {correction=correction+((product-next)+total);}
        total=next;
    }
    return ((total+correction)/left_norm)/num_sqrt(square);
}
export scaled,unit,cosine;
