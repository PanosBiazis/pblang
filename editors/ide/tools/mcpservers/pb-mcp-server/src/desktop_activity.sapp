// Local transport observations, not model inference or authenticated identity.
fn normalize(value) {
    if type(value) != "map" { return nil; }
    let name = try value.operation catch nil;
    let phase = try value.phase catch nil;
    if type(name) != "string" or len(name) < 1 or len(name) > 80 { return nil; }
    for c in str_to_bytes(name) {
        if not ((c >= 97 and c <= 122) or c == 95 or c == 47) { return nil; }
    }
    if phase != "idle" and phase != "running" and phase != "completed" and phase != "failed" { return nil; }
    for key in ["elapsed_ms", "completed", "failed"] {
        let n = try value[key] catch nil;
        if type(n) != "number" or not (n >= 0 and n <= 9007199254740991) or n != num_floor(n) { return nil; }
    }
    if value.failed > value.completed { return nil; }
    return map{ operation: name, phase: phase, elapsed_ms: value.elapsed_ms,
        completed: value.completed, failed: value.failed };
}
fn describe(value, stopped = false) {
    if stopped { return "Connection stopped · No live activity"; }
    if value == nil { return "Live activity unavailable on this connection"; }
    return "PB-MCP activity: " + value.phase + " · " + value.operation
        + "\nObserved duration: " + str(value.elapsed_ms) + " ms · Completed: " + str(value.completed)
        + " · Failed: " + str(value.failed)
        + "\nConnection calls only; model thinking, tokens and remote GPU are unavailable.";
}
export normalize, describe;
