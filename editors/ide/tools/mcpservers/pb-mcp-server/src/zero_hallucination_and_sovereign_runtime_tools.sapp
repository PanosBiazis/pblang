    for name in implemented_tools() {
        array_push(out, map{
            name: name,
            category: "zero-hallucination-runtime",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/zero_hallucination_and_sovereign_runtime_tools.sapp",
            description: "Native Pure-PBLang v11.0 Zero-Hallucination Epistemic Shield & Sovereign Runtime tool: " + name,
            input_schema: map{ type: "object", properties: map{} }
        });
    }
    return out;
}

export call_zero_hallucination_and_sovereign_runtime, implemented_tools, catalog_entries;
