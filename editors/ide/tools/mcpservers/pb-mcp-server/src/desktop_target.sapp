// Trusted-local window binding. Never expose bind/close as public MCP tools.
// This executor is composed only behind PBRemote's exact approved input lease.
let Implementations = import("implementation_switch.sapp");
let KEYS = ["Enter", "Backspace", "Delete", "Tab", "Escape", "Left", "Right", "Up", "Down", "Home", "End", "Space", "PageUp", "PageDown"];
fn new(native) {
    let state = map{ selected: false, closed: false, window: 0 };
    fn close() {
        if not state.closed { state.closed = true;state.selected = false;try native.close() catch nil; }
        return map{ ok: true, closed: true };
    }
    fn bind(window) {
        if state.closed or state.selected or type(window) != "number" or not (window >= 2 and window <= 4294967295)
            or window != num_floor(window) { return false; }
        if (try native.bind(window) catch false) != true { close();return false; }
        state.window = window;state.selected = true;return true;
    }
    fn status() {
        if state.selected and (try native.status() catch false) != true { close(); }
        return map{ bound: state.selected and not state.closed, window: state.window,
            closed: state.closed, scope: "directed-window-keyboard", identity_verified: false,
            delivery_guaranteed: false, capture_restricted: false, pointer_supported: false };
    }
    fn apply(action) {
        if not state.selected or state.closed { return false; }
        if type(action) != "map" or (try action.format catch nil) != "pblang.input.event.v1" { return false; }
        for name in map_keys(action) { if name != "format" and name != "kind" and name != "text" and name != "key" { return false; } }
        if action.kind == "type" {
            if map_has(action,"key") or type(action.text) != "string" { return false; }
            let bytes = str_to_bytes(action.text);
            if len(bytes) < 1 or len(bytes) > 256 { return false; }
            for byte in bytes { if byte < 32 or byte > 126 { return false; } }
            return native.text(action.text) == true;
        }
        if action.kind == "key" and not map_has(action,"text") {
            for i len(KEYS) { if action.key == KEYS[i] { return native.key(i) == true; } }
        }
        return false;
    }
    fn execute(action) {
        let ok = try apply(action) catch false;
        if ok != true { close();return map{ ok: false, error: "Window target unavailable or input unsupported; no global fallback" }; }
        return map{ ok: true, result: map{ backend: "directed-window-keyboard", window: state.window,
            submitted: true, application_consumption_verified: false } };
    }
    return map{ bind: bind, status: status, execute: execute, close: close };
}
fn open_native() {
    if platform() != "linux" { throw "window target backend unavailable"; }
    let abi = ffi_load(cwd() + "/transport/desktop_target_abi.so");let state = map{ closed: false };
    let owner = ffi_call_typed(abi,"pbtarget_acquire","->i32",[]);
    if owner == 0 { ffi_close(abi);throw "window target backend already owned"; }
    fn close() {
        if not state.closed {
            state.closed = true;
            try ffi_call_typed(abi,"pbtarget_close","i32->i32",[owner]) catch nil;
            ffi_close(abi);
        }
    }
    let native = map{
        bind: fn(w) { return not state.closed and ffi_call_typed(abi,"pbtarget_bind","i32,i64->i32",[owner,w]) == 1; },
        status: fn() { return not state.closed and ffi_call_typed(abi,"pbtarget_status","i32->i32",[owner]) == 1; },
        text: fn(t) { return not state.closed and ffi_call_typed(abi,"pbtarget_text","i32,string->i32",[owner,t]) == 1; },
        key: fn(k) { return not state.closed and ffi_call_typed(abi,"pbtarget_key","i32,i32->i32",[owner,k]) == 1; }, close: close };
    return new(native);
}
fn open(enabled = false) {
    // The compatibility gate is incomplete; explicit experimental opt-in only.
    return Implementations.open(enabled,"x11_core",map{ x11_core: open_native });
}
export new, open;
