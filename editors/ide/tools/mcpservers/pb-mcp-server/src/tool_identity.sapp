// Canonical byte-exact identity for every dispatchable PB-MCP tool.

fn parse(value) {
    if type(value) != "string" {
        return map{ ok: false, error: "tool name must be a string" };
    }
    if len(value) < 1 or len(value) > 256 or
       not regex_match(value, "^[a-z][a-z0-9_]{0,255}$") {
        return map{ ok: false,
            error: "tool name must be canonical lowercase ASCII snake_case" };
    }
    return map{ ok: true, name: value };
}

fn is_canonical(value) { return parse(value).ok; }

export parse, is_canonical;
