// Presentation only: no authorization, credentials, capture or input effects.
fn presentation(view, now) {
    let mode = 0;
    let label = "";
    if view != nil and not view.stopped {
        if view.capture_enabled { mode = 1; }
        let c = view.control;
        if view.input_enabled and view.active_control == 1 and c != nil
            and c.state == "active" and c.remaining_events > 0 and c.expires_at > now { mode = 2; }
        if (try view.remembered_input catch false) { mode = 2; }
        if mode != 0 {
            let client = "Not supplied"; let model = "Not supplied";
            if map_has(view, "connection_identity") {
                client = view.connection_identity.client; model = view.connection_identity.model;
            }
            label = if mode == 2 { "INPUT CONTROL" } else { "SCREEN SHARING" };
            label = label + " | Client: " + client + " | Model: " + model + " | identity unverified";
        }
    }
    // Smooth 2.4-second pulse. Never disappear; border remains steady.
    let phase = (now % 2400) / 1200;
    if phase > 1 { phase = 2 - phase; }
    let alpha = num_floor(680 + 200 * phase * phase * (3 - 2 * phase));
    return map{ mode: mode, label: label, alpha: alpha };
}
fn open() {
    let abi = ffi_load(cwd() + "/transport/desktop_overlay_abi.so");
    let state = map{ closed: false, mode: -1, label: "", layout_at: -1000, tick_at: -1000 };
    fn call(name, signature, args) { return ffi_call_typed(abi, "pbo_" + name, signature, args); }
    fn update(p, now) {
        if state.closed { throw "overlay closed"; }
        if p.mode == 0 {
            if state.mode != 0 and call("hide", "->i64", []) != 1 { throw "overlay hide failed"; }
            state.mode = 0; return;
        }
        if state.mode == 0 or state.mode == -1 or now < state.layout_at or now - state.layout_at >= 1000 {
            if call("layout", "->i64", []) != 1 { throw "overlay layout failed"; }
            state.layout_at = now;
        }
        if p.label != state.label {
            if call("label", "string->i64", [p.label]) != 1 { throw "overlay label failed"; }
            state.label = p.label;
        }
        if p.mode != state.mode {
            if call("mode", "i64->i64", [p.mode]) != 1 { throw "overlay mode failed"; }
            state.mode = p.mode;
        }
        if now < state.tick_at or now - state.tick_at >= 75 {
            if call("tick", "i64->i64", [p.alpha]) != 1 { throw "overlay rendering failed"; }
            state.tick_at = now;
        }
    }
    fn close() {
        if not state.closed { try call("close", "->i64", []) catch nil; ffi_close(abi); state.closed = true; }
    }
    return map{ update: update, close: close };
}
export presentation;
export open;
