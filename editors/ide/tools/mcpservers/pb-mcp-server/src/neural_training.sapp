// One explicit mini-batch SGD update. Pure data in/out; no persistent learner.
fn _object(value, allowed, required) {
    if type(value) != "map" { throw "expected training object"; }
    let keys = map_keys(value);
    for i len(keys) {
        let found = false;
        for j len(allowed) { if keys[i] == allowed[j] { found = true; } }
        if not found { throw "unsupported training property"; }
    }
    for i len(required) { if not map_has(value, required[i]) { throw "missing training property"; } }
}
fn _number(value, low, high) {
    if type(value) != "number" or not (value >= low and value <= high) { throw "training number outside finite bounds"; }
    return value;
}
fn _array(value, maximum) {
    if type(value) != "array" or len(value) < 1 or len(value) > maximum { throw "training array outside batch bounds"; }
    return value;
}
fn _output(input, weights, bias, activation) {
    let output = [];
    for o len(weights) {
        let value = bias[o];
        for j len(input) { value = value + input[j] * weights[o][j]; }
        if activation == "relu" and value < 0 { value = 0; }
        if activation == "sigmoid" {
            if value >= 0 { value = 1 / (1 + num_exp(0 - value)); }
            else { let e = num_exp(value); value = e / (1 + e); }
        }
        output[o] = value;
    }
    return output;
}
fn dense_train_step(args) {
    _object(args, ["samples", "targets", "weights", "bias", "activation", "learning_rate"],
        ["samples", "targets", "weights", "bias", "learning_rate"]);
    let samples = _array(args.samples, 4096); let targets = _array(args.targets, 4096);
    let weights = _array(args.weights, 1024); let bias = _array(args.bias, 1024);
