    if len(targets) != count or len(bias) != outputs or count * width * outputs > 65536 { throw "training shape or work budget mismatch"; }
    let rate = _number(args.learning_rate, 0.000000000001, 1000000);
    let activation = try args.activation catch "linear";
    if activation != "linear" and activation != "relu" and activation != "sigmoid" { throw "unsupported training activation"; }
    // Complete validation precedes arithmetic and construction of new weights.
    for n count {
        _array(samples[n], 1024); _array(targets[n], 1024);
        if len(samples[n]) != width or len(targets[n]) != outputs { throw "training row width mismatch"; }
        for j width { _number(samples[n][j], -1000000, 1000000); }
        for o outputs { _number(targets[n][o], -1000000000000, 1000000000000); }
    }
    let gradients = []; let bias_gradients = [];
    for o outputs {
        _array(weights[o], 1024);
        if len(weights[o]) != width { throw "training weight width mismatch"; }
        _number(bias[o], -1000000000000, 1000000000000);
        let row = [];
        for j width { _number(weights[o][j], -1000000, 1000000); row[j] = 0.0; }
        gradients[o] = row; bias_gradients[o] = 0.0;
    }
    let loss_before = 0.0; let scale = 1.0 / (count * outputs);
    for n count {
        let prediction = _output(samples[n], weights, bias, activation);
        for o outputs {
            let error = prediction[o] - targets[n][o];
            loss_before = loss_before + 0.5 * error * error * scale;
            let slope = 1.0;
            if activation == "relu" and prediction[o] <= 0 { slope = 0.0; }
            if activation == "sigmoid" { slope = prediction[o] * (1 - prediction[o]); }
            let delta = error * slope * scale;
            bias_gradients[o] = bias_gradients[o] + delta;
            let row = gradients[o];
            for j width { row[j] = row[j] + delta * samples[n][j]; }
            gradients[o] = row;
        }
    }
    let next_weights = []; let next_bias = [];
    for o outputs {
        let row = [];
        // Keep returned parameters compatible with dense_forward and future
        // train_step calls. Refuse overflow/range escape; never silently clip.
        for j width { row[j] = _number(weights[o][j] - rate * gradients[o][j], -1000000, 1000000); }
        next_weights[o] = row;
        next_bias[o] = _number(bias[o] - rate * bias_gradients[o], -1000000000000, 1000000000000);
    }
    let loss_after = 0.0;
    for n count {
        let prediction = _output(samples[n], next_weights, next_bias, activation);
        for o outputs {
            let error = prediction[o] - targets[n][o];
            loss_after = loss_after + 0.5 * error * error * scale;
        }
    }
    return map{ format: "pb_mcp.neural_dense_train_step.v1", native_pblang: true,
        effect_performed: false, network_used: false, model_loaded: false,
