// Optional process-bound tool/target restrictions. These only subtract authority.
let CONFIG = import("app_access_config.sapp");
fn _contains(values,value){for i len(values){if values[i]==value{return true;}}return false;}
fn _fields(value,allowed){
    if type(value)!="map"{throw "invalid app access policy";}
    for key in map_keys(value){if not _contains(allowed,key){throw "invalid app access policy";}}
}
fn _name(value){
    if type(value)!="string" or len(value)<1 or len(value)>128{return false;}
    let alphabet="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-";
    for i len(value){if not str_contains(alphabet,str_slice(value,i,i+1)){return false;}}
    return true;
}
fn compile(config){
    _fields(config,["enabled","app_id","allow_tools","target_rules"]);
    if type(try config.enabled catch nil)!="bool"{throw "invalid app access policy";}
    if not config.enabled{return map{enabled:false,app_id:"",tools:[],rules:[]};}
    if not _name(try config.app_id catch nil){throw "invalid app access policy";}
    let names=try config.allow_tools catch nil;let rules=try config.target_rules catch nil;
    if type(names)!="array" or len(names)>256 or type(rules)!="array" or len(rules)>64{throw "invalid app access policy";}
    let copied=[];let out=[];
    for i len(names){if not _name(names[i]) or _contains(copied,names[i]){throw "invalid app access policy";}copied[len(copied)]=names[i];}
    for i len(rules){
        let rule=rules[i];_fields(rule,["tool","argument","values"]);
        if not _contains(copied,try rule.tool catch nil) or not _name(try rule.argument catch nil){throw "invalid app access policy";}
        let values=try rule.values catch nil;
        if type(values)!="array" or len(values)<1 or len(values)>64{throw "invalid app access policy";}
        let approved=[];
        for j len(values){
            if type(values[j])!="string" or len(values[j])<1 or len(values[j])>256{throw "invalid app access policy";}
            for k len(values[j]){let c=strcharcodeat(values[j],k);if c<32 or c==127{throw "invalid app access policy";}}
            if _contains(approved,values[j]){throw "invalid app access policy";}approved[len(approved)]=values[j];
        }
        for j len(out){if out[j].tool==rule.tool and out[j].argument==rule.argument{throw "invalid app access policy";}}
        out[len(out)]=map{tool:rule.tool,argument:rule.argument,values:approved};
    }
    return map{enabled:true,app_id:config.app_id,tools:copied,rules:out};
}
fn visible(policy,tool){
    if policy==nil or not _name(tool){return false;}
    return not policy.enabled or _contains(policy.tools,tool);
}
fn permits(policy,tool,args){
    if not visible(policy,tool) or type(args)!="map"{return false;}
    if not policy.enabled{return true;}
    for i len(policy.rules){let rule=policy.rules[i];if rule.tool==tool{
        if not map_has(args,rule.argument) or type(args[rule.argument])!="string" or not _contains(rule.values,args[rule.argument]){return false;}
    }}
    return true;
}
// An invalid enabled configuration denies everything; it never falls back to disabled.
let _active=try compile(CONFIG.configuration()) catch nil;
fn available(tool){return visible(_active,tool);}
fn allowed(tool,args){return permits(_active,tool,args);}
fn status(){return map{valid:_active!=nil,enabled:if _active==nil{true}else{_active.enabled},
    binding:"operator-owned-process",client_asserted_identity_accepted:false,
    target_matching:"exact-argument-only",os_sandbox:false};}
export compile, visible, permits, available, allowed, status;
