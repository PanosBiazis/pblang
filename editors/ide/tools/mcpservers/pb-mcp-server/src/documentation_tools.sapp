// Effectful adapter for the general authenticated/capability-gated router.
// The local documentation MCP profile imports only the pure core below.
let CORE = import("documentation_core.sapp");
let documentation_sources = CORE.documentation_sources;
let implemented_tools = CORE.implemented_tools;
let catalog_entries = CORE.catalog_entries;
let functional_records = CORE.functional_records;
let _fetch_with = CORE._fetch_with;

fn documentation_fetch(args) {
    // Validate before importing the effectful executor or consulting capability.
    CORE._selection(args);
    let SEC = import("security.sapp");
    SEC.require_trusted("fetch fixed official documentation");
    if platform() != "linux" { throw "documentation HTTPS boundary requires Linux"; }
    return CORE._fetch_with(args, fn(request) {
        // Public fixed source ID only. Empty environment, isolated Python,
        // independent timeout, bounded response. No shell or credentials.
        let ran = try proc_spawn_wait("/usr/bin/env", ["-i", "/usr/bin/timeout", "--kill-after=1s", "20s",
            "/usr/bin/python3", "-I", "-B", "transport/documentation_https.py", args.source_id]) catch nil;
        if ran == nil or ran.exit_code != 0 or len(ran.stdout) > 800000 { throw "documentation retrieval failed"; }
        return try json_parse(ran.stdout) catch nil;
    });
}
fn call_documentation(tool, args) {
    if tool == "documentation_sources" { return documentation_sources(args); }
    if tool == "documentation_fetch" { return documentation_fetch(args); }
    return nil;
}
export documentation_sources, documentation_fetch, implemented_tools, catalog_entries,
    functional_records, call_documentation, _fetch_with;
