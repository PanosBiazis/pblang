// Shared PBLang PNG integrity checks; image bytes stay in memory.
let PNG = import("desktop_png.sapp");
fn validate(response, width, height) {
    let encoded = try response.data catch nil;
    if type(encoded) != "string" or len(encoded) < 76 or len(encoded) > 1398104 {
        throw "browser screenshot exceeds image budget";
    }
    let bytes = base64_decode_bytes(encoded);
    if len(bytes) > 1048576 or base64_encode_bytes(bytes) != encoded { throw "invalid canonical screenshot encoding"; }
    let checked = PNG.sanitize(bytes, map{ max_input_bytes: 1048576, max_width: width, max_height: height,
        max_decoded_bytes: (width * 4 + 1) * height, max_chunks: 1024 });
    if not checked.ok or checked.width != width or checked.height != height { throw "invalid browser screenshot"; }
    return map{ data: base64_encode_bytes(checked.bytes), metadata: map{ mime_type: "image/png", width: width,
        height: height, bytes: len(checked.bytes), metadata_removed: true,
        color_profile_removed: checked.color_profile_removed, contains_visible_page_content: true } };
}
export validate;
