// Public contracts for two existing deterministic caller-data computations.
// These records do not authorize allocation, execution, retries or host probing.
fn _object(properties) {return map{type:"object",properties:properties,required:[],additionalProperties:false};}
fn _integer(low,high) {return map{type:"integer",minimum:low,maximum:high};}
fn schemas() {
    let profile=map{type:"string",enum:["interactive","batch","server","untrusted","micro"],default:"untrusted"};
    let quantities=map{};
    for name in ["elapsed_ms","memory_bytes","storage_bytes","network_bytes","output_bytes","items","workers","allocations","locations","frames","frame_ms","tokens","restarts"] {
        quantities[name]=map{type:"number",minimum:0,maximum:1000000000000000};
    }
    let options=_object(map{
        max_attempts:_integer(1,100),base_delay_ms:_integer(0,60000),
        multiplier:_integer(1,16),max_delay_ms:_integer(0,300000),
        timeout_ms:_integer(1,3600000),failure_threshold:_integer(1,100),
        recovery_ms:_integer(1,3600000),jitter_percent:_integer(0,50)});
    return map{
        pblang_resource_budget:_object(map{profile:profile,usage:_object(quantities)}),
        pblang_resilience_policy:_object(map{profile:profile,options:options,started_ms:_integer(0,1000000000000000)})};
}
fn functional_records() {
    let contracts=schemas();let out=[];
    for name in ["pblang_resource_budget","pblang_resilience_policy"] {
        push(out,map{name:name,status:"complete",public_mcp:true,input_schema:contracts[name],
            reason:"bounded deterministic evaluation of supplied quantities or initial retry policy; no resource enforcement or work execution",
            evidence_ids:["pb_mcp_runtime_policy:full_dispatch","pb_mcp_runtime_policy:input_refusal","pb_mcp_runtime_policy:wire"]});
    }
    return out;
}
export schemas,functional_records;
