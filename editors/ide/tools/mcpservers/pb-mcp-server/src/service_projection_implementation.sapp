// Local lazy selection, never an MCP authorization or caller-selected process.
let Switch=import("implementation_switch.sapp");
fn open(enabled,selected="pblang",retained_factory=nil) {
    return Switch.open(enabled,selected,map{
        pblang:fn() { return import("service_projection.sapp"); },
        polyglot:retained_factory
    });
}
export open;
