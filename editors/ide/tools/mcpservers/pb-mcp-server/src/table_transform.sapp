// Bounded literal Sheet multi-step transformation pipeline via stdlib:table_transform.sapp.
let Transform = import("stdlib:table_transform.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table transform arguments"; }
fn implemented_tools() { return ["data_table_transform"]; }

fn call_transform(name, args) {
    if name != "data_table_transform" { return nil; }
    if type(args) != "map" or len(args) < 2 or len(args) > 3
       or not map_has(args, "document") or not map_has(args, "steps") {
        _fail();
    }
    for key in map_keys(args) {
        if key != "document" and key != "steps" and key != "header" {
            _fail();
        }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let header = false;
    if map_has(args, "header") {
        header = args.header;
    }
    if type(header) != "bool" { _fail(); }
    let steps = args.steps;
    if type(steps) != "array" or len(steps) < 1 or len(steps) > 16 { _fail(); }
    let operations = [];
    for step in steps {
        if type(step) != "map" or len(step) < 1 or len(step) > 3 or not map_has(step, "op") {
            _fail();
        }
        let op = step.op;
        if type(op) != "string" { _fail(); }
        if op != "trim" and op != "deduplicate" and op != "filter" and op != "select" and op != "sort" {
            _fail();
        }
        push(operations, "" + op);
    }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil { _fail(); }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let out_doc = try Transform.apply(args.document, steps, header) catch nil;
    if out_doc == nil { _fail(); }
    let out_size = try Sheet.validate(out_doc) catch nil;
    if out_size == nil { _fail(); }
    let out_cells = [];
    for row in out_doc.cells {
        let cloned_row = [];
        for cell in row {
            push(cloned_row, "" + cell);
        }
        push(out_cells, cloned_row);
    }
    let result = map{
        format: "pb_mcp.data_table_transform.v1",
        document: map{
            format: out_doc.format,
            cells: out_cells
        },
        source_rows: size.rows,
        source_columns: size.columns,
        input_text_bytes: size.text_bytes,
        output_rows: out_size.rows,
        output_columns: out_size.columns,
        output_text_bytes: out_size.text_bytes,
        header: header,
        step_count: len(operations),
        operations: operations,
        index_base: 0,
        formulas_evaluated: false,
        contains_cell_text: true,
        contains_headers: header,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows and 1..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL."
    };
    let step_schema = map{
        type: "object",
        required: ["op"],
        additionalProperties: false,
        properties: map{
            op: map{ type: "string", enum: ["trim", "deduplicate", "filter", "select", "sort"] },
            column: map{ type: "integer", minimum: 0, maximum: 7, description: "Zero-based column index for filter or sort steps." },
            query: map{ type: "string", minLength: 1, maxLength: 256, description: "Case-sensitive substring query for filter steps." },
            columns: map{ type: "array", minItems: 1, maxItems: 8, items: map{ type: "integer", minimum: 0, maximum: 7 }, description: "Distinct zero-based column indices for select steps." },
            descending: map{ type: "boolean", description: "Sort direction for sort steps." }
        }
    };
    return [map{
        name: "data_table_transform",
        category: "table-transform",
        profile: "core-code",
        source: "src/table_transform.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document", "steps"],
            additionalProperties: false,
            properties: map{
                document: document,
                steps: map{
                    type: "array",
                    minItems: 1,
                    maxItems: 16,
                    items: step_schema,
                    description: "1..16 atomic literal Sheet steps (trim, deduplicate, filter, select, sort)."
                },
                header: map{
                    type: "boolean",
                    default: false,
                    description: "When true, row 0 is preserved as a header row across trim, deduplicate, filter, and sort steps."
                }
            }
        },
        description: "Apply an all-or-nothing pipeline of 1..16 literal pblang.sheet-document.v1 transformation steps (trim, deduplicate, filter, select, sort) via stdlib:table_transform.sapp. Preserves header row 0 when header=true, uses stable UTF-8 byte ordering for sort, and never evaluates formulas (contains_cell_text:true, safe_to_log:false). Serialized arguments and result each <=65536 UTF8bytes."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet multi-step atomic transformation pipeline with pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_table_transform:pipeline_steps_and_header",
                "pb_mcp_table_transform:all_or_nothing_bounds",
                "pb_mcp_table_transform:detached_results",
                "pb_mcp_table_transform:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_transform, catalog_entries, functional_records;
