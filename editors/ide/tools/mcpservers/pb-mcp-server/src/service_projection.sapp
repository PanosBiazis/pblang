// Pure provider-data projection. This API consumes decoded, caller-owned data;
// it is not a wire decoder, authentication check or transport attestation.
// Unknown fields are omitted without traversing or copying their contents.
fn _definition(operation) {
    if operation=="supabase_projects" {
        return map{provider:"supabase",fields:["id","name","organization_id","region","created_at","status"]};
    }
    if operation=="supabase_organizations" { return map{provider:"supabase",fields:["id","name"]}; }
    if operation=="vercel_projects" { return map{provider:"vercel",fields:["id","name"]}; }
    if operation=="vercel_deployments" { return map{provider:"vercel",fields:["id","name","project_id","state","created_ms"]}; }
    throw "unsupported provider projection";
}
fn _integer(value) {
    // PBLang numbers are f64. Wire-level integer spelling must be checked by
    // the decoder; 1, 1.0 and 1e0 are indistinguishable after decoding.
    if type(value)!="number" or value!=value or value<0 or value>9007199254740991
        or value!=num_floor(value) { throw "invalid provider integer"; }
    return value;
}
fn _cursor(value,deployments) {
    if value==nil { return nil; }
    if type(value)=="number" { return str(_integer(value)); }
    if deployments or type(value)!="string" or len(value)<1 or len(value)>1024 {
        throw "invalid provider continuation";
    }
    let digits=true;let base32=true;
    for i len(value) {
        let ch=strcharcodeat(value,i);
        if ch<48 or ch>57 { digits=false; }
        if not ((ch>=65 and ch<=90) or (ch>=50 and ch<=55)) { base32=false; }
    }
    if not digits and not base32 { throw "invalid provider continuation"; }
    return value;
}
fn _project(value) {
    if type(value)!="string" or len(value)<1 or len(value)>128 { throw "invalid provider project"; }
    for i len(value) {
        let ch=strcharcodeat(value,i);
        if not ((ch>=48 and ch<=57) or (ch>=65 and ch<=90) or (ch>=97 and ch<=122) or ch==45 or ch==95) {
            throw "invalid provider project";
        }
    }
    return value;
}
fn _state(value) {
    for name in ["BLOCKED","BUILDING","CANCELED","DELETED","ERROR","INITIALIZING","QUEUED","READY"] {
        if value==name { return value; }
    }
    throw "invalid provider state";
}
fn _text_size(value) {
    // At most 512 scalar values, checked by the caller. Count UTF-8 bytes
    // without building a byte array or requiring the host-only str_to_bytes.
    let bytes=0;
    for i len(value) {
        let cp=strcharcodeat(value,i);
        if cp<128 { bytes=bytes+1; }
        elif cp<2048 { bytes=bytes+2; }
        elif cp<65536 { bytes=bytes+3; }
        else { bytes=bytes+4; }
        if bytes>512 { throw "provider field bound"; }
    }
    return bytes;
}
fn project(operation,value) {
    let definition=_definition(operation);
    let paged=definition.provider=="vercel";
    let deployments=operation=="vercel_deployments";
    let rows=value;let pagination:any=nil;
    if paged and type(value)=="map" {
        pagination=try value.pagination catch nil;
        if type(pagination)!="map" or not map_has(pagination,"count") or not map_has(pagination,"next") {
            throw "missing provider pagination";
        }
        rows=if deployments { try value.deployments catch nil } else { try value.projects catch nil };
    }
    if deployments and pagination==nil { throw "deployment pagination required"; }
    if type(rows)!="array" or len(rows)>500 or (paged and len(rows)>100) { throw "provider row bound"; }
    let next:any=nil;
    if pagination!=nil {
        if _integer(pagination.count)!=len(rows) { throw "invalid provider page count"; }
        next=_cursor(pagination.next,deployments);
    }
    let out=[];let identities=map{};let text_bytes=0;
    for row in rows {
        if type(row)!="map" { throw "invalid provider row"; }
        let item=map{};
        for field in definition.fields {
            let text:any=nil;
            if deployments {
                if field=="id" { text=try row.uid catch nil; }
                elif field=="project_id" { text=_project(try row.projectId catch nil); }
                elif field=="state" { text=_state(try row.readyState catch nil); }
                elif field=="created_ms" { text=str(_integer(try row.created catch nil)); }
                else { text=try row[field] catch nil; }
            } else { text=try row[field] catch nil; }
            if type(text)!="string" or len(text)<1 or len(text)>512 { throw "invalid provider metadata"; }
            let size=_text_size(text);
            text_bytes=text_bytes+size;
            if text_bytes>262144 { throw "provider text bound"; }
            item[field]=text;
        }
        if map_has(identities,item.id) { throw "duplicate provider identity"; }
        identities[item.id]=true;array_push(out,item);
    }
    let result=map{format:"pb_mcp.provider_projection.v1",provider:definition.provider,operation:operation,
        items:out,count:len(out),source:"untrusted_provider_metadata",transport_verified:false};
    if paged {
        result.pagination_supported=pagination!=nil;result.next_cursor=next;
        result.pagination_exhausted=pagination!=nil and next==nil;
    }
    return result;
}
export project;
