// Native pblang translations for durable JSONL agent-bus tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let sec = import("src/security.sapp");

let BUS_PATH = ".mint-mcp/agent-bus.jsonl";

fn _now_ms() {
    return try now_ms() catch try clock() catch 0;
}

fn _ensure_bus_dir() {
    sec.require_trusted("agent bus write");
    FS.mkdirs(".mint-mcp");
    return true;
}

fn _line_count(text) {
    if text == "" { return 0; }
    return len(str_split(text, "\n"));
}

fn _bus_text() {
    return try FS.read(BUS_PATH) catch "";
}

fn _messages() {
    let raw = _bus_text();
    let lines = str_split(raw, "\n");
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if t != "" {
            let v = try JSON.parse(t) catch nil;
            if v != nil { out[len(out)] = v; }
        }
    }
    return out;
}

fn _clip(s, max_chars) {
    max_chars = sec.clamp(max_chars, 1, 200000);
    s = str(s);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _id(prefix) {
    return prefix + "-" + str(_now_ms()) + "-" + str(len(_messages()) + 1);
}

fn _append_message(msg) {
    _ensure_bus_dir();
    FS.append(BUS_PATH, JSON.stringify(msg) + "\n");
    return msg;
}

fn _msg(from_agent, to_agent, kind, topic, body, extra) {
    if extra == nil { extra = map{}; }
    let msg = map{
        id: _id("msg"),
        ts_ms: _now_ms(),
        from_agent: str(from_agent),
        to_agent: if to_agent == nil { "" } else { str(to_agent) },
        kind: str(kind),
        topic: if topic == nil { "" } else { str(topic) },
        body: str(body),
    };
    let keys = map_keys(extra);
    for i len(keys) { msg[keys[i]] = extra[keys[i]]; }
    return msg;
}

fn _matches(m, args) {
    let since = try args.since_ts_ms catch nil;
    if since != nil and (try m.ts_ms catch 0) < since { return false; }
    let from_agent = try args.from_agent catch nil;
    if from_agent != nil and str(try m.from_agent catch "") != str(from_agent) { return false; }
    let to_agent = try args.to_agent catch nil;
    if to_agent != nil and str(try m.to_agent catch "") != str(to_agent) { return false; }
    let kind = try args.kind catch nil;
    if kind != nil and str(try m.kind catch "") != str(kind) { return false; }
    let topic = try args.topic catch nil;
    if topic != nil and str(try m.topic catch "") != str(topic) { return false; }
    return true;
}

fn _tail(arr, limit) {
    limit = sec.clamp(limit, 1, 1000);
    let out = [];
    let start = len(arr) - limit;
    if start < 0 { start = 0; }
    for i in start to len(arr) - 1 { out[len(out)] = arr[i]; }
    return out;
}

fn agent_ping(args) {
    return map{
        ok: true,
        runtime: "pblang",
        ts_ms: _now_ms(),
        bus_path: BUS_PATH,
        bus_exists: try FS.exists(BUS_PATH) catch false,
        network_profile: sec.network_profile(),
        public_profile: sec.is_public_profile(),
    };
}

fn agent_bus_status(args) {
    let raw = _bus_text();
    return map{ path: BUS_PATH, exists: raw != "", bytes: len(raw), approx_lines: _line_count(raw), messages: len(_messages()) };
}

fn agent_recent(args) {
    let msgs = _messages();
    let filtered = [];
    for i len(msgs) {
        if _matches(msgs[i], args) { filtered[len(filtered)] = msgs[i]; }
    }
    return _tail(filtered, try args.limit catch try args.max_messages catch 25);
}

fn agent_get_message(args) {
    let id = str(try args.id catch "");
    let msgs = _messages();
    for i len(msgs) {
        if str(try msgs[i].id catch "") == id { return msgs[i]; }
    }
    return nil;
}

fn agent_bus_search(args) {
    let needle = str_lower(str(try args.needle catch try args.query catch ""));
    let msgs = _messages();
    let out = [];
    let limit = sec.clamp(try args.limit catch 100, 1, 1000);
    for i len(msgs) {
        if len(out) >= limit { return out; }
        if _matches(msgs[i], args) {
            let hay = str_lower(JSON.stringify(msgs[i]));
            if needle == "" or str_contains(hay, needle) { out[len(out)] = msgs[i]; }
        }
    }
    return out;
}

fn agent_inbox(args) {
    let who = str(try args.for_agent catch try args.agent catch "");
    let include_self_broadcasts = try args.include_self_broadcasts catch false;
    let msgs = _messages();
    let out = [];
    for i len(msgs) {
        if _matches(msgs[i], args) {
            let to = str(try msgs[i].to_agent catch "");
            let from = str(try msgs[i].from_agent catch "");
            if to == who or to == "" {
                if include_self_broadcasts == true or not (to == "" and from == who) {
                    out[len(out)] = msgs[i];
                }
            }
        }
    }
    return _tail(out, try args.limit catch 100);
}

fn agent_multi_inbox(args) {
    let agents = try args.for_agents catch try args.agents catch [];
    let out = map{};
    let limit = sec.clamp(try args.limit catch 100, 1, 1000);
    for i len(agents) {
        out[str(agents[i])] = agent_inbox(map{ for_agent: agents[i], limit: limit, since_ts_ms: try args.since_ts_ms catch nil });
    }
    return out;
}

fn agent_thread(args) {
    let topic = str(try args.topic catch "");
    let msgs = _messages();
    let out = [];
    for i len(msgs) {
        if str(try msgs[i].topic catch "") == topic and _matches(msgs[i], args) {
            out[len(out)] = msgs[i];
        }
    }
    return _tail(out, try args.limit catch 200);
}

fn agent_list_topics(args) {
    let msgs = _messages();
    let stats = map{};
    for i len(msgs) {
        let topic = str(try msgs[i].topic catch "");
        if topic != "" {
            let cur = try stats[topic] catch map{ topic: topic, count: 0, first_ts_ms: try msgs[i].ts_ms catch 0, last_ts_ms: 0 };
            cur.count = cur.count + 1;
            cur.last_ts_ms = try msgs[i].ts_ms catch cur.last_ts_ms;
            stats[topic] = cur;
        }
    }
    let keys = map_keys(stats);
    let out = [];
    for i len(keys) { out[len(out)] = stats[keys[i]]; }
    return out;
}

fn _inc_map(counts, key) {
    let cur = try counts[key] catch 0;
    counts[key] = cur + 1;
    return counts;
}

fn agent_roster(args) {
    let msgs = _messages();
    let senders = map{};
    let receivers = map{};
    let kinds = map{};
    for i len(msgs) {
        _inc_map(senders, str(try msgs[i].from_agent catch ""));
        let to = str(try msgs[i].to_agent catch "");
        if to != "" { _inc_map(receivers, to); }
        _inc_map(kinds, str(try msgs[i].kind catch ""));
    }
    return map{ senders: senders, receivers: receivers, kinds: kinds, messages: len(msgs) };
}

fn agent_bus_compact(args) {
    let msgs = _messages();
    return map{
        status: agent_bus_status(args),
        roster: agent_roster(args),
        topics: agent_list_topics(args),
        recent: _tail(msgs, try args.recent_limit catch 10),
    };
}

fn agent_coordination_snapshot(args) {
    return agent_bus_compact(args);
}

fn agent_coordination_playbook(args) {
    return map{
        async: "Use agent_send with a topic, then poll agent_thread or agent_inbox with since_ts_ms.",
        fan_out: "Use agent_fan_out to send the same body to several agents.",
        serial: "Use agent_send_pipeline for ordered multi-step handoffs.",
        subagents: "Use agent_subagent_task and agent_subagent_done with the same topic/correlation_id.",
        public_profile: "Write tools are blocked on public/internet/wan profile.",
    };
}

fn agent_send(args) {
    let msg = _msg(
        try args.from_agent catch "pblang-agent",
        try args.to_agent catch nil,
        try args.kind catch "message",
        try args.topic catch "",
        try args.body catch try args.message catch "",
        try args.extra catch map{}
    );
    return _append_message(msg);
}

fn agent_handoff(args) {
    args.kind = "handoff";
    args.body = (try args.headline catch "") + "\n" + (try args.body catch try args.message catch "");
    return agent_send(args);
}

fn agent_subagent_task(args) {
    args.kind = "subagent_task";
    args.to_agent = try args.sub_agent catch try args.to_agent catch "";
    args.body = (try args.title catch "subagent task") + "\n" + (try args.task_body catch try args.body catch "");
    return agent_send(args);
}

fn agent_subagent_done(args) {
    args.kind = "subagent_done";
    args.to_agent = try args.parent_agent catch try args.to_agent catch "";
    args.body = (try args.summary catch "") + "\n" + (try args.result catch "");
    return agent_send(args);
}

fn agent_fan_out(args) {
    let to_agents = try args.to_agents catch [];
    let out = [];
    for i len(to_agents) {
        let one = args;
        one.to_agent = to_agents[i];
        out[len(out)] = agent_send(one);
    }
    return map{ sent: len(out), messages: out };
}

fn agent_send_pipeline(args) {
    let steps = try args.steps catch try args.messages catch [];
    let out = [];
    for i len(steps) {
        let one = steps[i];
        if type(one) != "map" { one = map{ body: str(one) }; }
        one.from_agent = try one.from_agent catch try args.from_agent catch "pblang-agent";
        one.topic = try one.topic catch try args.topic catch "";
        out[len(out)] = agent_send(one);
    }
    return map{ sent: len(out), messages: out };
}

fn agent_patch_plan(args) {
    let files = try args.files catch [];
    let changes = try args.changes catch [];
    let verification = try args.verification catch [];
    let risks = [];
    if len(files) == 0 { risks[len(risks)] = "no files listed"; }
    if len(verification) == 0 { risks[len(risks)] = "no verification listed"; }
    return map{ goal: try args.goal catch "", files: files, changes: changes, verification: verification, risks: risks, ok: len(risks) == 0 };
}

fn agent_prompt_pack(args) {
    return "Goal:\n" + str(try args.goal catch "") + "\n\nContext:\n" + str(try args.context catch "") + "\n\nFiles:\n" + JSON.stringify(try args.files catch []) + "\n\nConstraints:\n" + JSON.stringify(try args.constraints catch []) + "\n\nVerification:\n" + JSON.stringify(try args.verification catch []);
}

fn agent_task_packet(args) {
    return map{
        kind: "agent_task_packet",
        goal: try args.goal catch "",
        context: try args.context catch "",
        files: try args.files catch [],
        constraints: try args.constraints catch [],
        steps: try args.steps catch [],
        verification: try args.verification catch [],
    };
}

fn agent_session_summary(args) {
    let messages = try args.messages catch try args.events catch [];
    let decisions = [];
    let actions = [];
    let risks = [];
    let verification = [];
    for i len(messages) {
        let text = str_lower(str(try messages[i].text catch try messages[i].body catch messages[i]));
        if str_contains(text, "decid") { decisions[len(decisions)] = messages[i]; }
        if str_contains(text, "todo") or str_contains(text, "action") { actions[len(actions)] = messages[i]; }
        if str_contains(text, "risk") or str_contains(text, "block") { risks[len(risks)] = messages[i]; }
        if str_contains(text, "test") or str_contains(text, "verify") or str_contains(text, "pass") { verification[len(verification)] = messages[i]; }
    }
    return map{ messages: len(messages), decisions: decisions, actions: actions, risks: risks, verification: verification };
}

fn ask_agents(args) {
    if args == nil { args = map{}; }
    let question = str(try args.question catch try args.body catch "");
    let from_agent = str(try args.from_agent catch "pblang-agent");
    let topic = str(try args.topic catch _id("ask"));
    let targets = try args.to_agents catch try args.agents catch [];
    if len(targets) == 0 {
        agent_send(map{ from_agent: from_agent, to_agent: "", topic: topic, kind: "question", body: question });
    } else {
        for i len(targets) {
            agent_send(map{ from_agent: from_agent, to_agent: str(targets[i]), topic: topic, kind: "question", body: question });
        }
    }
    let replies = agent_thread(map{ topic: topic, limit: try args.limit catch 100 });
    return map{
        topic: topic,
        question: question,
        target_count: len(targets),
        replies: replies,
        message: "question posted to durable pblang agent bus; agents answer with agent_send using the same topic",
    };
}

fn call_agent(tool, args) {
    if args == nil { args = map{}; }
    if tool == "agent_ping" { return agent_ping(args); }
    if tool == "agent_bus_status" { return agent_bus_status(args); }
    if tool == "agent_recent" { return agent_recent(args); }
    if tool == "agent_get_message" { return agent_get_message(args); }
    if tool == "agent_bus_search" { return agent_bus_search(args); }
    if tool == "agent_inbox" { return agent_inbox(args); }
    if tool == "agent_multi_inbox" { return agent_multi_inbox(args); }
    if tool == "agent_thread" { return agent_thread(args); }
    if tool == "agent_list_topics" { return agent_list_topics(args); }
    if tool == "agent_roster" { return agent_roster(args); }
    if tool == "agent_bus_compact" { return agent_bus_compact(args); }
    if tool == "agent_coordination_snapshot" { return agent_coordination_snapshot(args); }
    if tool == "agent_coordination_playbook" { return agent_coordination_playbook(args); }
    if tool == "agent_send" { return agent_send(args); }
    if tool == "agent_handoff" { return agent_handoff(args); }
    if tool == "agent_subagent_task" { return agent_subagent_task(args); }
    if tool == "agent_subagent_done" { return agent_subagent_done(args); }
    if tool == "agent_fan_out" { return agent_fan_out(args); }
    if tool == "agent_send_pipeline" { return agent_send_pipeline(args); }
    if tool == "agent_patch_plan" { return agent_patch_plan(args); }
    if tool == "agent_prompt_pack" { return agent_prompt_pack(args); }
    if tool == "agent_task_packet" { return agent_task_packet(args); }
    if tool == "agent_session_summary" { return agent_session_summary(args); }
    if tool == "ask_agents" { return ask_agents(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "agent_ping",
        "agent_bus_status",
        "agent_recent",
        "agent_get_message",
        "agent_bus_search",
        "agent_inbox",
        "agent_multi_inbox",
        "agent_thread",
        "agent_list_topics",
        "agent_roster",
        "agent_bus_compact",
        "agent_coordination_snapshot",
        "agent_coordination_playbook",
        "agent_send",
        "agent_handoff",
        "agent_subagent_task",
        "agent_subagent_done",
        "agent_fan_out",
        "agent_send_pipeline",
        "agent_patch_plan",
        "agent_prompt_pack",
        "agent_task_packet",
        "agent_session_summary",
        "ask_agents",
    ];
}

export implemented_tools, call_agent,
       agent_ping, agent_bus_status, agent_recent, agent_get_message,
       agent_bus_search, agent_inbox, agent_multi_inbox, agent_thread,
       agent_list_topics, agent_roster, agent_bus_compact,
       agent_coordination_snapshot, agent_coordination_playbook,
       agent_send, agent_handoff, agent_subagent_task, agent_subagent_done,
       agent_fan_out, agent_send_pipeline, agent_patch_plan, agent_prompt_pack,
       agent_task_packet, agent_session_summary, ask_agents;
