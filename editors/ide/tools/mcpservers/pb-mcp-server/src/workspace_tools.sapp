// Native pblang translations for bounded workspace scratch tools.

let FS = import("stdlib:fs.sapp");
let sec = import("src/security.sapp");

let TEMP_DIR = ".mint-mcp/agent-temp";
let MAX_TEMP_CHARS = 524288;

fn _valid_name(name) {
    name = str(name);
    if name == "" or len(name) > 120 { return false; }
    if str_contains(name, "/") or str_contains(name, "\\") or str_contains(name, "..") { return false; }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-";
    for i len(name) {
        let ch = str_slice(name, i, i + 1);
        if not str_contains(allowed, ch) { return false; }
    }
    return true;
}

fn _temp_path(name) {
    if not _valid_name(name) { throw "invalid temp filename: use ASCII letters, numbers, dot, dash, underscore"; }
    return sec.join_path(TEMP_DIR, name);
}

fn _ensure_dir() {
    sec.require_trusted("workspace temp write/delete");
    FS.mkdirs(TEMP_DIR);
    return true;
}

fn workspace_temp_write(args) {
    _ensure_dir();
    let name = try args.name catch try args.path catch "scratch.txt";
    let text = str(try args.text catch try args.contents catch "");
    if len(text) > MAX_TEMP_CHARS {
        text = str_slice(text, 0, MAX_TEMP_CHARS);
    }
    let path = _temp_path(name);
    FS.write(path, text);
    return map{ path: path, name: name, chars: len(text), truncated: len(str(try args.text catch try args.contents catch "")) > MAX_TEMP_CHARS };
}

fn workspace_temp_read(args) {
    let name = try args.name catch try args.path catch "";
    let path = _temp_path(name);
    let raw = FS.read(path);
    let max_chars = sec.clamp(try args.max_chars catch MAX_TEMP_CHARS, 1, MAX_TEMP_CHARS);
    if len(raw) > max_chars { raw = str_slice(raw, 0, max_chars); }
    return map{ path: path, name: name, text: raw, chars: len(raw) };
}

fn workspace_temp_list(args) {
    let items = try FS.listdir(TEMP_DIR) catch [];
    let out = [];
    let limit = sec.clamp(try args.max_entries catch 200, 1, 1000);
    for i len(items) {
        if len(out) >= limit { return out; }
        if _valid_name(items[i]) {
            let path = _temp_path(items[i]);
            out[len(out)] = map{ name: items[i], path: path, bytes: try FS.size(path) catch 0 };
        }
    }
    return out;
}

fn workspace_temp_delete(args) {
    sec.require_trusted("workspace temp delete");
    let name = try args.name catch try args.path catch "";
    let path = _temp_path(name);
    let existed = try FS.exists(path) catch false;
    if existed == true { FS.remove(path); }
    return map{ path: path, name: name, deleted: existed };
}

fn call_workspace(tool, args) {
    if args == nil { args = map{}; }
    if tool == "workspace_temp_write" { return workspace_temp_write(args); }
    if tool == "workspace_temp_read" { return workspace_temp_read(args); }
    if tool == "workspace_temp_list" { return workspace_temp_list(args); }
    if tool == "workspace_temp_delete" { return workspace_temp_delete(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "workspace_temp_write",
        "workspace_temp_read",
        "workspace_temp_list",
        "workspace_temp_delete",
    ];
}

export implemented_tools, call_workspace,
       workspace_temp_write, workspace_temp_read, workspace_temp_list,
       workspace_temp_delete;
