// Native pblang translations for pure SVG/DOT chart tools.

let sec = import("src/security.sapp");
let algo = import("src/algorithm_tools.sapp");

fn _esc(s) {
    s = str_replace_all(str(s), "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    return str_replace_all(s, "\"", "&quot;");
}

fn _max_value(data) {
    let m = 0.0;
    for i len(data) {
        let v = try data[i].value catch try data[i].y catch 0;
        if v > m { m = v; }
    }
    if m <= 0 { return 1.0; }
    return m;
}

fn _svg_open(w, h) {
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\">";
}

fn chart_bar(args) {
    let data = try args.data catch try args.items catch [];
    let w = sec.clamp(try args.width catch 720, 200, 2400);
    let h = sec.clamp(try args.height catch 360, 160, 1600);
    let maxv = _max_value(data);
    let pad = 40;
    let bar_w = if len(data) == 0 { 1 } else { (w - pad * 2) / len(data) };
    let svg = _svg_open(w, h) + "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>";
    for i len(data) {
        let label = _esc(try data[i].label catch str(i));
        let v = try data[i].value catch 0;
        let bh = ((h - pad * 2) * v) / maxv;
        let x = pad + i * bar_w;
        let y = h - pad - bh;
        svg = svg + "<rect x=\"" + str(x + 2) + "\" y=\"" + str(y) + "\" width=\"" + str(bar_w - 4) + "\" height=\"" + str(bh) + "\" fill=\"#2563eb\"/>";
        svg = svg + "<text x=\"" + str(x + bar_w / 2) + "\" y=\"" + str(h - 14) + "\" font-size=\"11\" text-anchor=\"middle\">" + label + "</text>";
    }
    svg = svg + "</svg>";
    return map{ svg: svg, count: len(data) };
}

fn chart_histogram(args) {
    let values = try args.values catch [];
    let bins = sec.clamp(try args.bins catch 10, 1, 100);
    let hist = algo.algo_numeric_histogram(map{ values: values, bins: bins });
    let data = [];
    for i len(hist.bins) {
        data[len(data)] = map{ label: str(i), value: hist.bins[i].count };
    }
    let r = chart_bar(map{ data: data, width: try args.width catch 720, height: try args.height catch 360 });
    r.bin_edges = hist.bins;
    return r;
}

fn chart_line(args) {
    let series = try args.series catch [];
    if len(series) == 0 { series = [map{ label: "series", values: try args.values catch [] }]; }
    let w = sec.clamp(try args.width catch 720, 200, 2400);
    let h = sec.clamp(try args.height catch 360, 160, 1600);
    let pad = 40;
    let maxy = 1.0;
    let maxn = 1;
    for si len(series) {
        let vals = try series[si].values catch [];
        if len(vals) > maxn { maxn = len(vals); }
        for i len(vals) {
            let yv = try vals[i].y catch vals[i];
            if yv > maxy { maxy = yv; }
        }
    }
    let svg = _svg_open(w, h) + "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>";
    let colors = ["#2563eb", "#dc2626", "#16a34a", "#9333ea"];
    for si len(series) {
        let vals = try series[si].values catch [];
        let pts = "";
        for i len(vals) {
            let yv = try vals[i].y catch vals[i];
            let x = pad + ((w - pad * 2) * i) / _max(1, maxn - 1);
            let y = h - pad - ((h - pad * 2) * yv) / maxy;
            pts = pts + str(x) + "," + str(y) + " ";
        }
        svg = svg + "<polyline points=\"" + pts + "\" fill=\"none\" stroke=\"" + colors[si % len(colors)] + "\" stroke-width=\"2\"/>";
    }
    svg = svg + "</svg>";
    return map{ svg: svg, series: len(series) };
}

fn _max(a, b) { if a > b { return a; } return b; }

fn chart_scatter(args) {
    let points = try args.points catch try args.data catch [];
    let w = sec.clamp(try args.width catch 720, 200, 2400);
    let h = sec.clamp(try args.height catch 360, 160, 1600);
    let pad = 40;
    let maxx = 1.0;
    let maxy = 1.0;
    for i len(points) {
        if points[i].x > maxx { maxx = points[i].x; }
        if points[i].y > maxy { maxy = points[i].y; }
    }
    let svg = _svg_open(w, h) + "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>";
    for i len(points) {
        let x = pad + ((w - pad * 2) * points[i].x) / maxx;
        let y = h - pad - ((h - pad * 2) * points[i].y) / maxy;
        svg = svg + "<circle cx=\"" + str(x) + "\" cy=\"" + str(y) + "\" r=\"4\" fill=\"#2563eb\"/>";
    }
    svg = svg + "</svg>";
    return map{ svg: svg, count: len(points) };
}

fn chart_timeseries(args) {
    let data = try args.data catch [];
    let vals = [];
    for i len(data) { vals[len(vals)] = map{ x: i, y: try data[i].value catch 0 }; }
    return chart_line(map{ series: [map{ label: "time", values: vals }], width: try args.width catch 720, height: try args.height catch 360 });
}

fn chart_pie(args) {
    let data = try args.data catch try args.items catch [];
    let total = 0.0;
    for i len(data) { total = total + (try data[i].value catch 0); }
    if total <= 0 { total = 1.0; }
    let y = 20;
    let svg = _svg_open(520, 40 + len(data) * 26) + "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>";
    let colors = ["#2563eb", "#dc2626", "#16a34a", "#9333ea", "#ea580c", "#0891b2"];
    for i len(data) {
        let v = try data[i].value catch 0;
        let pct = (v * 100) / total;
        svg = svg + "<rect x=\"20\" y=\"" + str(y) + "\" width=\"" + str(pct * 3) + "\" height=\"18\" fill=\"" + colors[i % len(colors)] + "\"/>";
        svg = svg + "<text x=\"340\" y=\"" + str(y + 14) + "\" font-size=\"12\">" + _esc(try data[i].label catch str(i)) + " " + str(num_floor(pct)) + "%</text>";
        y = y + 26;
    }
    svg = svg + "</svg>";
    return map{ svg: svg, total: total, note: "pblang port renders pie data as proportional SVG legend bars" };
}

fn chart_gantt(args) {
    let tasks = try args.tasks catch [];
    let data = [];
    for i len(tasks) {
        let start = try tasks[i].start_time catch try tasks[i].start catch 0;
        let end = try tasks[i].end_time catch try tasks[i].end catch start + 1;
        data[len(data)] = map{ label: try tasks[i].name catch str(i), value: end - start };
    }
    return chart_bar(map{ data: data, width: try args.width catch 720, height: try args.height catch 360 });
}

fn chart_dependency_graph(args) {
    let nodes = try args.nodes catch [];
    let edges = try args.edges catch [];
    let dot = "digraph dependencies {\n";
    for i len(nodes) { dot = dot + "  \"" + _esc(nodes[i]) + "\";\n"; }
    for i len(edges) {
        dot = dot + "  \"" + _esc(edges[i].from) + "\" -> \"" + _esc(edges[i].to) + "\"";
        let label = try edges[i].label catch "";
        if label != "" { dot = dot + " [label=\"" + _esc(label) + "\"]"; }
        dot = dot + ";\n";
    }
    dot = dot + "}\n";
    return map{ dot: dot, nodes: len(nodes), edges: len(edges) };
}

fn call_chart(tool, args) {
    if args == nil { args = map{}; }
    if tool == "chart_bar" { return chart_bar(args); }
    if tool == "chart_histogram" { return chart_histogram(args); }
    if tool == "chart_line" { return chart_line(args); }
    if tool == "chart_scatter" { return chart_scatter(args); }
    if tool == "chart_timeseries" { return chart_timeseries(args); }
    if tool == "chart_pie" { return chart_pie(args); }
    if tool == "chart_gantt" { return chart_gantt(args); }
    if tool == "chart_dependency_graph" { return chart_dependency_graph(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "chart_bar",
        "chart_histogram",
        "chart_line",
        "chart_scatter",
        "chart_timeseries",
        "chart_pie",
        "chart_gantt",
        "chart_dependency_graph",
    ];
}

export implemented_tools, call_chart,
       chart_bar, chart_histogram, chart_line, chart_scatter,
       chart_timeseries, chart_pie, chart_gantt, chart_dependency_graph;
