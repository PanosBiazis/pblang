let _V30_CACHE = map{};

fn _v30() {
    if map_has(_V30_CACHE, "m") { return _V30_CACHE["m"]; }
    let m = try import("editors/ide/tools/ai/pbai_gap_closer_2m_v30.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_gap_closer_2m_v30.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_gap_closer_2m_v30.sapp") catch nil; }
    if m == nil { m = try import("../../pblang/editors/ide/tools/ai/pbai_gap_closer_2m_v30.sapp") catch nil; }
    if m == nil { m = try import("../../../pblang/editors/ide/tools/ai/pbai_gap_closer_2m_v30.sapp") catch nil; }
    _V30_CACHE["m"] = m;
    return m;
}

fn implemented_tools() {
    return [
        "mmap_2m_encyclopedia_theorem_lookup",
        "mmap_2m_32_oss_teacher_absorb",
        "mmap_2m_192x_mdl_128lang_pack",
        "fleet_4node_orchestrator_status",
