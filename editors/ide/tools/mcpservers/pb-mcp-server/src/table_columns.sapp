// Named column projection with simultaneous renaming over bounded literal Sheets.
let Sheet=import("stdlib:sheet_document.sapp");
fn _fail(){throw "Invalid named column projection arguments";}
fn implemented_tools(){return ["data_table_project_columns"];}
fn _name(text){
 if type(text)!="string" or len(text)<1 or len(text)>256 {_fail();}
 let bytes=len(str_to_bytes(text));
 if bytes>256 or str_contains(text,"\u0000") {_fail();}
 return bytes;
}
fn call_columns(name,args){
 if name!="data_table_project_columns" {return nil;}
 if type(args)!="map" or len(map_keys(args))!=2 or not map_has(args,"document") or not map_has(args,"columns") {_fail();}
 let size=try Sheet.validate(args.document) catch nil;if size==nil {_fail();}
 if type(args.columns)!="array" or len(args.columns)<1 or len(args.columns)>size.columns {_fail();}
 // Resolve against the complete original header, never against renamed entries.
 let source_names=map{};let source_column=0;
 for heading in args.document.cells[0]{
  _name(heading);if map_has(source_names,heading) {_fail();}
  source_names[heading]=source_column;source_column=source_column+1;
 }
 let selected=map{};let output_names=map{};let indices=[];let header=[];
 let renamed=0;let output_bytes=0;
 for selection in args.columns{
  if type(selection)!="map" or not map_has(selection,"name") or len(map_keys(selection))<1 or len(map_keys(selection))>2 {_fail();}
  for field in map_keys(selection){if field!="name" and field!="rename" {_fail();}}
  _name(selection.name);
  if not map_has(source_names,selection.name) or map_has(selected,selection.name) {_fail();}
  let output_name=selection.name;
  if map_has(selection,"rename") {output_name=selection.rename;}
  let name_bytes=_name(output_name);
  if map_has(output_names,output_name) {_fail();}
  selected[selection.name]=true;output_names[output_name]=true;
  push(indices,source_names[selection.name]);push(header,output_name);
  output_bytes=output_bytes+name_bytes;
  if output_name!=selection.name {renamed=renamed+1;}
 }
 // All argument shapes, strings and selectors are bounded before serialization.
 if len(str_to_bytes(json_stringify(args)))>65536 {_fail();}
 // Renamed headers can grow even when projection removes no data columns.
 for row in range(1,size.rows){for column in indices{
  output_bytes=output_bytes+len(str_to_bytes(args.document.cells[row][column]));
  if output_bytes>8192 {_fail();}
 }}
 if output_bytes>8192 {_fail();}
 let cells=[header];
 for row in range(1,size.rows){
  let projected=[];for column in indices {push(projected,args.document.cells[row][column]);}
  push(cells,projected);
 }
 let document=map{format:Sheet.FORMAT,cells:cells};
 let validated=try Sheet.validate(document) catch nil;if validated==nil {_fail();}
 let result=map{format:"pb_mcp.data_table_project_columns.v1",document:document,source_column_indices:indices,
  source_rows:size.rows,source_column_count:size.columns,selected_column_count:len(indices),data_rows:size.rows-1,
  renamed_columns:renamed,header:true,index_base:0,matching:"exact_header_name",normalization:"none",
  contains_cell_text:true,contains_headers:true,safe_to_log:false,native_pblang:true,data_source:"caller_supplied",
  effects_performed:false,network_used:false,model_loaded:false,automatic_deletion:false,formulas_evaluated:false};
 if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}
 return result;
}
fn catalog_entries(){
 let document=map{type:"object",required:["format","cells"],additionalProperties:false,
  properties:map{format:map{type:"string",enum:["pblang.sheet-document.v1"]},
   cells:map{type:"array",minItems:1,maxItems:32,items:map{type:"array",minItems:1,maxItems:8,items:map{type:"string",maxLength:256}}}},
  description:"Rectangular literal Sheet,1..32 rows and1..8 columns; max256 UTF8bytes/cell,8192 total, no NUL. Row0 is the required header; all source header names must be nonempty and exactly unique, including unselected names."};
 let name=map{type:"string",minLength:1,maxLength:256,description:"Literal nonempty name, at most256 UTF8bytes and no NUL. Spaces are significant; whitespace-only names are allowed. No normalization."};
 let columns=map{type:"array",minItems:1,maxItems:8,items:map{type:"object",required:["name"],additionalProperties:false,properties:map{name:name,rename:name}},
  description:"Select distinct existing original header names in output order. Omitted rename preserves the name. Final output names must be unique. Simultaneous swaps and identity renames are allowed; no missing-name fallback."};
 return [map{name:"data_table_project_columns",category:"table-columns",profile:"core-code",source:"src/table_columns.sapp",read_only:true,destructive:false,open_world:false,
  input_schema:map{type:"object",required:["document","columns"],additionalProperties:false,properties:map{document:document,columns:columns}},
  description:"Project and reorder columns by exact original header names with simultaneous optional renaming. Return a detached literal document, zero-based source_column_indices and actual renamed_columns count. Preserve every source row; header-only tables are valid. Reject empty/duplicate source headers, unknown/repeated selected names and duplicate final names. Matching is exact Unicode/case/space equality; no trimming, inference or formula evaluation. Validate final Sheet byte limits before constructing data rows. Arguments/output<=65536 serialized UTF8bytes. Returned cells and headers are private; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."}];
}
fn functional_records(){let out=[];for entry in catalog_entries(){push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
 reason:"Bounded exact header-name projection and simultaneous renaming using shared Sheet admission",
 evidence_ids:["pb_mcp_table_columns:named_projection","pb_mcp_table_columns:simultaneous_rename","pb_mcp_table_columns:bounds","pb_mcp_table_columns:privacy_parity"]});}return out;}
export implemented_tools,call_columns,catalog_entries,functional_records;
