// Offline caller-priced arithmetic. No balance, provider or execution authority.
let Budget=import("stdlib:ai_turn_budget.sapp");

fn _object(args,keys) {
    if type(args)!="map" or len(args)!=len(keys) {throw "invalid turn budget arguments";}
    for key in keys {if not map_has(args,key) {throw "invalid turn budget arguments";}}
}
fn call_budget(tool,args) {
    if tool!="ai_turn_budget" {return nil;}
    if type(args)!="map" {throw "invalid turn budget arguments";}
    let operation=try args.operation catch nil;
    if type(operation)!="string" or len(operation)>32 {throw "invalid turn budget operation";}
    let value:any=nil;
    if operation=="cost" {
        _object(args,["operation","prices","tokens"]);
        value=Budget.cost(args.prices,args.tokens);
    } elif operation=="forecast" {
        _object(args,["operation","prices","tokens","remaining_units"]);
        value=Budget.forecast(args.prices,args.tokens,args.remaining_units);
    } elif operation=="affordable_output" {
        _object(args,["operation","prices","tokens","remaining_units","output_cap"]);
        value=Budget.affordable_output(args.prices,args.tokens,args.remaining_units,args.output_cap);
    } elif operation=="account" {
        _object(args,["operation","prices","tokens","budget_units","spent_units"]);
        value=Budget.account(args.prices,args.tokens,args.budget_units,args.spent_units);
    } else {throw "invalid turn budget operation";}
    return map{format:"pb_mcp.ai-turn-budget.v1",operation:operation,result:value,
        native_pblang:true,offline:true,effect_performed:false,network_used:false,
        model_loaded:false,persisted:false,tokenizer_used:false,
        pricing_source:"caller_supplied_integer_units_per_token",
        usage_source:"caller_supplied_disjoint_token_counts",
        billing_enforced:false,provider_verified:false,reservation_created:false,
        data_provenance:"untrusted_caller_supplied",instructions_from_data:false,safe_to_log:false};
}
fn _integer(maximum) {return map{type:"integer",minimum:0,maximum:maximum};}
fn _object_schema(properties,required) {return map{type:"object",properties:properties,required:required,additionalProperties:false};}
fn _categories() {
    return _object_schema(map{input:_integer(1000000000),output:_integer(1000000000),
        cache_read:_integer(1000000000),cache_write:_integer(1000000000)},
        ["input","output","cache_read","cache_write"]);
}
fn catalog_entries() {
    let variants=[];
    for operation in ["cost","forecast","affordable_output","account"] {
        let properties=map{operation:map{type:"string",enum:[operation]},prices:_categories(),tokens:_categories()};
        let required=["operation","prices","tokens"];
        if operation=="forecast" or operation=="affordable_output" {
            properties.remaining_units=_integer(9007199254740991);array_push(required,"remaining_units");
        }
        if operation=="affordable_output" {properties.output_cap=_integer(1000000000);array_push(required,"output_cap");}
        if operation=="account" {
            properties.budget_units=_integer(9007199254740991);properties.spent_units=_integer(9007199254740991);
            array_push(required,"budget_units");array_push(required,"spent_units");
        }
        array_push(variants,_object_schema(properties,required));
    }
    return [map{name:"ai_turn_budget",category:"agent-budget",profile:"core-code",read_only:true,
        destructive:false,open_world:false,source:"src/agent_budget.sapp",
        description:"Offline caller-priced integer arithmetic: cost, forecast, affordable_output or account. Prices are caller-defined units per token; four disjoint counts are input (excluding caches), output, cache_read and cache_write. Counts/rates 0..1e9, totals/balances 0..2^53-1; overflow is refused. affordable_output requires tokens.output=0 and an explicit output_cap, including free output. account records full overspend using explicit caller-owned spent_units. No tokenizer/provider verification, billing enforcement, reservation, execution, persistence or deduplication. Distinct from ai_context_budget item selection.",
        input_schema:map{type:"object",oneOf:variants}}];
}
fn implemented_tools() {return ["ai_turn_budget"];}
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded stateless caller-priced arithmetic; no external billing authority",
        evidence_ids:["pb_mcp_turn_budget:arithmetic","pb_mcp_turn_budget:invalid-overflow",
            "pb_mcp_turn_budget:protocol","pb_mcp_turn_budget:source-hidden"]}];
}
export call_budget,catalog_entries,implemented_tools,functional_records;
