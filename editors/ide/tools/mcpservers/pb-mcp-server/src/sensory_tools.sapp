// Strict, content-free errors around the bounded sensory computation.
let Sensory=import("sensory_series.sapp");
let Serial=import("stdlib:serialization.sapp");
let MAX_BYTES=65536;
fn call_sensory(tool,args) {
    if tool!="sensory_series_review" {return nil;}
    if type(args)!="map" or len(args)!=1 or not map_has(args,"series_json") {throw "sensory: invalid arguments";}
    let text=args.series_json;
    if type(text)!="string" or len(text)>MAX_BYTES {throw "sensory: invalid arguments";}
    let parsed=Serial.parse_safe(text,"json",map{max_input_bytes:MAX_BYTES,max_output_bytes:MAX_BYTES,
        max_depth:6,max_items:4096,max_lines:4096,max_line_bytes:MAX_BYTES,
        strict:true,reject_duplicate_keys:true});
    if not parsed.ok {throw "sensory: invalid document";}
    let result=try Sensory.review(parsed.value) catch nil;
    if result==nil {throw "sensory: invalid series";}return result;
}
fn implemented_tools() {return ["sensory_series_review"];}
fn catalog_entries() {
    return [map{name:"sensory_series_review",category:"sensory",profile:"core-code",read_only:true,
        destructive:false,open_world:false,source:"src/sensory_tools.sapp",
        description:"Validate 2..256 caller-supplied sensory samples and replay a prefix into unit-converted statistics. Checks exact relative microsecond cadence and sequence; applies supplied affine calibration. Synthetic/imported/measured provenance is unverified. No raw samples or identifiers returned; aggregates remain sensitive (safe_to_log:false). No acquisition, device/network/model access, persistence, perception or diagnosis.",
        input_schema:map{type:"object",properties:map{series_json:map{type:"string",maxLength:MAX_BYTES,
            description:"Strict JSON with exact modality,unit,summary_unit,provenance,sample_rate_hz,calibration:{scale,offset},range:{minimum,maximum},samples:[{sequence,time_us,value}],replay_count. Modalities temperature,pressure,gas_resistance,taste_voltage,eeg_voltage,emg_voltage. Provenance synthetic/imported/measured. Rate integer1..10000 must divide1e6; sequence starts0 and time_us=sequence*1e6/rate. Replay1..N; all N validate. See SENSORY_SERIES.md for unit and numeric bounds."}},
            required:["series_json"],additionalProperties:false}}];
}
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded stateless supplied sensory envelope computation; no acquisition or interpretation",
        evidence_ids:["pb_mcp_sensory:numerical","pb_mcp_sensory:bounds-privacy","pb_mcp_sensory:protocol-parity","pb_mcp_sensory:source-hidden"]}];
}
export call_sensory,implemented_tools,catalog_entries,functional_records;
