// Technical-indicator tools for pb-mcp-server — exposes stdlib:indicators.sapp.
//
// RSI (momentum), Bollinger Bands (volatility), and MACD (trend) over MCP, built
// on the time-series smoothers. Plain numbers/arrays (JSON-clean).

let ind = import("stdlib:indicators.sapp");

let IND_TOOLS = ["ind_rsi", "ind_bollinger", "ind_macd"];

fn tool_list() { return IND_TOOLS; }
fn implemented_tools() { return IND_TOOLS; }

fn call_indicators(tool, args) {
    if args == nil { args = map{}; }

    if tool == "ind_rsi" {
        let prices = try args.prices catch [];
        let period = try args.period catch 14;
        if period <= 0 or period >= len(prices) { return map{ ok: false, error: "ind_rsi: period must be in 1..len(prices)-1" }; }
        return map{ result: ind.rsi(prices, period) };
    }
    if tool == "ind_bollinger" {
        let prices = try args.prices catch [];
        let period = try args.period catch 20;
        let num_std = try args.num_std catch 2;
        if period <= 1 or period > len(prices) { return map{ ok: false, error: "ind_bollinger: period must be in 2..len(prices)" }; }
        return ind.bollinger_bands(prices, period, num_std);
    }
    if tool == "ind_macd" {
        let prices = try args.prices catch [];
        let fast = try args.fast catch 12;
        let slow = try args.slow catch 26;
        let signal = try args.signal catch 9;
        if len(prices) == 0 { return map{ ok: false, error: "ind_macd: prices must be non-empty" }; }
        if fast <= 0 or slow <= 0 or signal <= 0 { return map{ ok: false, error: "ind_macd: fast/slow/signal must be positive" }; }
        return ind.macd(prices, fast, slow, signal);
    }
    return nil;
}

export call_indicators, tool_list, implemented_tools, IND_TOOLS;
