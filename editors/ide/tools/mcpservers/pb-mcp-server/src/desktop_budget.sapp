// Total local approval limits, independent of the renewable PBRemote lease.
// Zero is the explicit unlimited sentinel; counters never grow without bound.
fn integer(value, maximum) {
    return type(value) == "number" and value >= 0 and value <= maximum and value == num_floor(value);
}
fn valid(limits) {
    return type(limits) == "map" and len(map_keys(limits)) == 2
        and integer(try limits.duration_ms catch nil, 9007199254740000)
        and integer(try limits.max_events catch nil, 9007199254740991);
}
fn unlimited() { return map{ duration_ms: 0, max_events: 0 }; }
fn finite(limits) { return limits.duration_ms != 0 or limits.max_events != 0; }
fn parse(text, maximum) {
    if type(text) != "string" or len(text) < 1 or len(text) > 16 { throw "Enter a positive whole number"; }
    let result = 0;
    for i len(text) {
        let digit = str_index_of("0123456789", str_slice(text, i, i + 1));
        if digit < 0 or result > num_floor((maximum - digit) / 10) { throw "Value is outside the supported range"; }
        result = result * 10 + digit;
    }
    if result < 1 { throw "Use the No limit checkbox for unlimited access"; }
    return result;
}
fn describe(limits) {
    let time = "No time limit (until revoked)";
    let events = "No event limit (until revoked)";
    if limits.duration_ms != 0 { time = str(limits.duration_ms / 1000) + " seconds"; }
    if limits.max_events != 0 { events = str(limits.max_events) + " input events"; }
    return time + " · " + events;
}
fn new(limits, now) {
    if not valid(limits) or not integer(now, 9007199254740991) { throw "Invalid local input limits"; }
    return map{ limits: json_parse(json_stringify(limits)), last_ms: now,
        remaining_ms: limits.duration_ms, remaining_events: limits.max_events, ended: false };
}
fn refresh(state, now) {
    if state.ended { return false; }
    // A backward/invalid host clock cannot extend a finite grant.
    if not integer(now, 9007199254740991) or now < state.last_ms { state.ended = true; return false; }
    if state.limits.duration_ms != 0 {
        state.remaining_ms = num_max(0, state.remaining_ms - (now - state.last_ms));
        if state.remaining_ms == 0 { state.ended = true; }
    }
    state.last_ms = now;
    if state.limits.max_events != 0 and state.remaining_events == 0 { state.ended = true; }
    return not state.ended;
}
fn reserve(state, cost, now) {
    if not integer(cost, 2) or cost < 1 or not refresh(state, now) { return false; }
    if state.limits.max_events != 0 {
        if state.remaining_events < cost { return false; }
        state.remaining_events = state.remaining_events - cost;
    }
    return true;
}
fn snapshot(state) {
    return map{ duration_ms: state.limits.duration_ms, max_events: state.limits.max_events,
        remaining_ms: state.remaining_ms, remaining_events: state.remaining_events };
}
export valid, unlimited, finite, parse, describe, new, refresh, reserve, snapshot;
