// Cross-platform desktop and device contracts implemented in native PBLang.
// These tools perform deterministic validation, geometry and policy decisions.
// They never actuate input, capture content, inspect identities, or claim that
// an OS backend exists when it has not been verified.

let FORMAT = "pb_mcp.desktop-device.v1";
let NAMES = [
    "desktop_platform_profile", "desktop_backend_capabilities", "desktop_target_matrix",
    "desktop_display_fit", "desktop_display_scale", "desktop_density_class",
    "desktop_responsive_mode", "desktop_safe_area", "desktop_pointer_transform",
    "desktop_pointer_clamp", "desktop_keyboard_event_validate", "desktop_unicode_scalar_validate",
    "desktop_shortcut_normalize", "desktop_input_rate_policy", "desktop_clipboard_policy",
    "desktop_notification_policy", "desktop_screen_capture_policy", "desktop_window_action_policy",
    "device_power_policy", "device_thermal_policy", "device_resource_budget",
    "desktop_accessibility_profile", "desktop_color_contrast", "desktop_responsive_breakpoint",
    "desktop_animation_policy", "remote_transport_policy", "remote_session_policy",
    "remote_file_transfer_policy", "remote_audio_stream_policy", "remote_video_stream_policy"
];

fn _contains(values,wanted){for i len(values){if values[i]==wanted{return true;}}return false;}
fn _strict(args,allowed,label){if args==nil{args=map{};}if type(args)!="map"{throw label+" arguments must be an object";}
    let keys=map_keys(args);for i len(keys){if not _contains(allowed,keys[i]){throw label+" unknown argument: "+str(keys[i]);}}return args;}
fn _num(args,key,minimum,maximum){if not map_has(args,key) or type(args[key])!="number" or
    str_lower(str(args[key]))=="nan" or args[key]<minimum or args[key]>maximum{throw key+" must be a finite number in "+str(minimum)+".."+str(maximum);}return args[key];}
fn _int(args,key,minimum,maximum){let value=_num(args,key,minimum,maximum);if value!=num_floor(value){throw key+" must be an integer";}return value;}
fn _bool(args,key,fallback){if not map_has(args,key){return fallback;}if type(args[key])!="bool"{throw key+" must be boolean";}return args[key];}
fn _text(args,key,maximum){if not map_has(args,key) or type(args[key])!="string" or len(args[key])<1 or len(args[key])>maximum{throw key+" must be a bounded string";}return args[key];}
fn _enum(args,key,values){let value=_text(args,key,64);if not _contains(values,value){throw key+" is not an allowed value";}return value;}
fn _base(tool){return map{ok:true,executed:true,tool:tool,format:FORMAT,native_pblang:true,
    deterministic:true,shell_used:false,external_process:false,content_captured:false};}
fn _fit(sw,sh,tw,th){let scale=num_min(tw/sw,th/sh);return map{scale:scale,width:num_floor(sw*scale),height:num_floor(sh*scale),
    offset_x:num_floor((tw-sw*scale)/2),offset_y:num_floor((th-sh*scale)/2)};}
fn _linear(channel){let value=channel/255;if value<=0.03928{return value/12.92;}return num_pow((value+0.055)/1.055,2.4);}
fn _luminance(r,g,b){return 0.2126*_linear(r)+0.7152*_linear(g)+0.0722*_linear(b);}
fn _schema(properties,required=nil){return map{type:"object",properties:properties,required:if required==nil{[]}else{required},additionalProperties:false};}
fn _s(options=nil){let out=map{type:"string"};if options!=nil{for key in map_keys(options){out[key]=options[key];}}return out;}
fn _n(minimum,maximum,integer=false){return map{type:if integer{"integer"}else{"number"},minimum:minimum,maximum:maximum};}
fn _b(){return map{type:"boolean"};}
let DESCRIPTIONS=map{
        desktop_platform_profile:"Report the current PBLang platform label without probing user or device identity.",
        desktop_backend_capabilities:"Report fail-closed desktop effect backend readiness; policy availability is not actuation readiness.",
        desktop_target_matrix:"Evaluate whether a named OS target has only the shared contract or still requires a live effect backend.",
        desktop_display_fit:"Fit a source display inside a target display while preserving aspect ratio and deterministic letterboxing.",
        desktop_display_scale:"Compute physical-to-logical display scale from bounded dimensions.",
        desktop_density_class:"Classify a bounded display DPI into a portable density tier.",
        desktop_responsive_mode:"Select compact, medium, or expanded responsive mode plus orientation.",
        desktop_safe_area:"Compute usable display geometry after validated platform insets.",
        desktop_pointer_transform:"Transform an in-bounds pointer coordinate between source and target display spaces.",
        desktop_pointer_clamp:"Clamp an arbitrary pointer coordinate to validated display bounds.",
        desktop_keyboard_event_validate:"Validate one bounded key press or release event without actuating it.",
        desktop_unicode_scalar_validate:"Validate one Unicode scalar and reject UTF surrogate code points.",
        desktop_shortcut_normalize:"Normalize a bounded key and modifier tuple without invoking the OS.",
        desktop_input_rate_policy:"Select batching and stale-event behavior from bounded input rate and latency.",
        desktop_clipboard_policy:"Approve only bounded non-secret clipboard metadata without reading clipboard content.",
        desktop_notification_policy:"Validate bounded notification metadata without publishing a notification.",
        desktop_screen_capture_policy:"Validate display dimensions and frame rate without capturing screen content.",
        desktop_window_action_policy:"Require attended consent for effectful window actions; no action is performed.",
        device_power_policy:"Select performance, balanced, or battery-saver behavior from bounded power state.",
        device_thermal_policy:"Fail closed on severe thermal pressure or unsafe temperature.",
        device_resource_budget:"Evaluate bounded memory, storage, and CPU budgets without allocating resources.",
        desktop_accessibility_profile:"Normalize text scale, contrast, reduced-motion, and minimum touch-target policy.",
        desktop_color_contrast:"Calculate WCAG relative contrast and AA eligibility for bounded RGB colors.",
        desktop_responsive_breakpoint:"Select a responsive breakpoint and column count from logical width.",
        desktop_animation_policy:"Choose a bounded frame-rate policy respecting battery saver and reduced motion.",
        remote_transport_policy:"Approve a transport only with encryption, authentication, verified peer identity, and replay protection.",
        remote_session_policy:"Require authenticated encrypted attended or trusted-device sessions with bounded capabilities.",
        remote_file_transfer_policy:"Validate bounded no-overwrite file-transfer metadata and require chunk hashes.",
        remote_audio_stream_policy:"Validate bounded low-latency audio stream parameters without opening media devices.",
        remote_video_stream_policy:"Validate bounded adaptive video stream parameters without capture or encoding."
};
let _schemas_cache=map{};let _schemas_ready=false;
let _catalog_cache=[];let _catalog_ready=false;
let _functional_cache=[];let _functional_ready=false;
fn _description(name){return DESCRIPTIONS[name];}

fn call_desktop_device(tool,args){if not _contains(NAMES,tool){return nil;}let out=_base(tool);
    if tool=="desktop_platform_profile"{_strict(args,[],tool);out.platform=platform();out.portable_contract=true;return out;}
    if tool=="desktop_backend_capabilities"{_strict(args,[],tool);let p=platform();out.platform=p;
        out.platform_candidate=p=="linux" or p=="windows" or p=="macos";out.native_window_backend=false;out.policy_only=true;
        out.input_actuation=false;out.screen_capture=false;out.fail_closed_unverified=true;return out;}
    if tool=="desktop_target_matrix"{_strict(args,["target"],tool);let target=_enum(args,"target",["linux","windows","macos","android","ios","web"]);
        out.target=target;out.shared_contract=true;out.policy_verified=true;out.effect_backend_verified=false;out.backend_required=true;return out;}
    if tool=="desktop_display_fit"{_strict(args,["source_width","source_height","target_width","target_height"],tool);
        out.fit=_fit(_num(args,"source_width",1,32768),_num(args,"source_height",1,32768),_num(args,"target_width",1,32768),_num(args,"target_height",1,32768));return out;}
    if tool=="desktop_display_scale"{_strict(args,["logical_width","physical_width"],tool);let logical=_num(args,"logical_width",1,32768);
        out.scale=_num(args,"physical_width",1,65536)/logical;out.logical_width=logical;return out;}
    if tool=="desktop_density_class"{_strict(args,["dpi"],tool);let dpi=_num(args,"dpi",36,1200);out.dpi=dpi;
        out.class="ultra";if dpi<140{out.class="low";}elif dpi<200{out.class="medium";}elif dpi<280{out.class="high";}elif dpi<400{out.class="xhigh";}return out;}
    if tool=="desktop_responsive_mode"{_strict(args,["width","height"],tool);let w=_num(args,"width",1,32768);let h=_num(args,"height",1,32768);
        out.mode="expanded";if w<600{out.mode="compact";}elif w<1024{out.mode="medium";}
        out.orientation="portrait";if w>=h{out.orientation="landscape";}return out;}
    if tool=="desktop_safe_area"{_strict(args,["width","height","left","top","right","bottom"],tool);let w=_num(args,"width",1,32768);let h=_num(args,"height",1,32768);
        let l=_num(args,"left",0,w);let t=_num(args,"top",0,h);let r=_num(args,"right",0,w);let b=_num(args,"bottom",0,h);
        if l+r>=w or t+b>=h{throw "safe-area insets leave no usable area";}out.x=l;out.y=t;out.width=w-l-r;out.height=h-t;return out;}
    if tool=="desktop_pointer_transform"{_strict(args,["x","y","source_width","source_height","target_width","target_height"],tool);
        let sw=_num(args,"source_width",1,32768);let sh=_num(args,"source_height",1,32768);let tw=_num(args,"target_width",1,32768);let th=_num(args,"target_height",1,32768);
        let x=_num(args,"x",0,32768);let y=_num(args,"y",0,32768);if x>=sw or y>=sh{throw "pointer coordinate is outside the source display";}
        out.x=num_floor(x*tw/sw);out.y=num_floor(y*th/sh);out.width=tw;out.height=th;return out;}
    if tool=="desktop_pointer_clamp"{_strict(args,["x","y","width","height"],tool);let w=_int(args,"width",1,32768);let h=_int(args,"height",1,32768);
        out.x=num_max(0,num_min(w-1,num_floor(_num(args,"x",-1048576,1048576))));out.y=num_max(0,num_min(h-1,num_floor(_num(args,"y",-1048576,1048576))));return out;}
    if tool=="desktop_keyboard_event_validate"{_strict(args,["key","action","repeat"],tool);out.key=_text(args,"key",64);out.action=_enum(args,"action",["press","release"]);
        out.repeat=_bool(args,"repeat",false);out.valid=true;out.layout_independent=false;return out;}
    if tool=="desktop_unicode_scalar_validate"{_strict(args,["codepoint"],tool);let cp=_int(args,"codepoint",0,1114111);out.codepoint=cp;
        out.valid=not (cp>=55296 and cp<=57343);out.encoding="unicode-scalar";return out;}
    if tool=="desktop_shortcut_normalize"{_strict(args,["key","ctrl","alt","shift","meta"],tool);out.key=str_lower(_text(args,"key",64));
        out.ctrl=_bool(args,"ctrl",false);out.alt=_bool(args,"alt",false);out.shift=_bool(args,"shift",false);out.meta=_bool(args,"meta",false);return out;}
    if tool=="desktop_input_rate_policy"{_strict(args,["events_per_second","latency_ms"],tool);let rate=_num(args,"events_per_second",1,10000);let latency=_num(args,"latency_ms",0,60000);
        out.allowed=rate<=1000 and latency<=1000;out.batch_ms=0;if rate>240{out.batch_ms=8;}elif rate>60{out.batch_ms=16;}out.drop_stale=latency>250;return out;}
    if tool=="desktop_clipboard_policy"{_strict(args,["bytes","mime","contains_secret"],tool);let bytes=_int(args,"bytes",0,16777216);let mime=_enum(args,"mime",["text/plain","text/html","image/png","application/octet-stream"]);
        let secret=_bool(args,"contains_secret",false);out.allowed=bytes<=1048576 and not secret;out.mime=mime;out.max_bytes=1048576;out.content_exposed=false;return out;}
    if tool=="desktop_notification_policy"{_strict(args,["title_chars","body_chars","urgency"],tool);let title=_int(args,"title_chars",0,4096);let body=_int(args,"body_chars",0,65536);
        out.allowed=title<=256 and body<=4096;out.urgency=_enum(args,"urgency",["low","normal","critical"]);out.content_exposed=false;return out;}
    if tool=="desktop_screen_capture_policy"{_strict(args,["width","height","fps"],tool);let w=_int(args,"width",1,16384);let h=_int(args,"height",1,16384);let fps=_int(args,"fps",1,240);
        out.allowed=w*h<=33177600 and fps<=120;out.pixels=w*h;out.max_fps=120;out.capture_performed=false;return out;}
    if tool=="desktop_window_action_policy"{_strict(args,["action","attended"],tool);let action=_enum(args,"action",["list","focus","move","resize","minimize","maximize","close"]);
        let attended=_bool(args,"attended",false);out.action=action;out.allowed=(action=="list") or attended;out.action_performed=false;return out;}
    if tool=="device_power_policy"{_strict(args,["battery_percent","plugged"],tool);let level=_num(args,"battery_percent",0,100);let plugged=_bool(args,"plugged",false);
        out.mode="battery-saver";if plugged or level>=50{out.mode="performance";}elif level>=20{out.mode="balanced";}out.background_allowed=plugged or level>=15;return out;}
    if tool=="device_thermal_policy"{_strict(args,["temperature_c","pressure"],tool);let temp=_num(args,"temperature_c",-50,200);let pressure=_enum(args,"pressure",["none","light","moderate","severe","critical"]);
        out.allowed=temp<85 and pressure!="severe" and pressure!="critical";out.mode=if out.allowed{"normal"}else{"cooldown"};return out;}
    if tool=="device_resource_budget"{_strict(args,["memory_mib","storage_mib","cpu_percent"],tool);let memory=_int(args,"memory_mib",1,1048576);let storage=_int(args,"storage_mib",1,16777216);let cpu=_num(args,"cpu_percent",0,100);
        out.allowed=memory<=4096 and storage<=8192 and cpu<=90;out.pressure="low";if not out.allowed{out.pressure="high";}elif cpu>70 or memory>2048{out.pressure="medium";}return out;}
    if tool=="desktop_accessibility_profile"{_strict(args,["text_scale","contrast","reduce_motion"],tool);let scale=_num(args,"text_scale",0.5,4);let contrast=_enum(args,"contrast",["normal","high"]);
        out.text_scale=scale;out.contrast=contrast;out.reduce_motion=_bool(args,"reduce_motion",false);out.touch_target_min_dp=48;return out;}
    if tool=="desktop_color_contrast"{_strict(args,["foreground_r","foreground_g","foreground_b","background_r","background_g","background_b","large_text"],tool);
        let l1=_luminance(_int(args,"foreground_r",0,255),_int(args,"foreground_g",0,255),_int(args,"foreground_b",0,255));
        let l2=_luminance(_int(args,"background_r",0,255),_int(args,"background_g",0,255),_int(args,"background_b",0,255));let ratio=(num_max(l1,l2)+0.05)/(num_min(l1,l2)+0.05);
        out.ratio=ratio;out.wcag_aa=ratio>=if _bool(args,"large_text",false){3}else{4.5};return out;}
    if tool=="desktop_responsive_breakpoint"{_strict(args,["width_dp"],tool);let width=_num(args,"width_dp",1,10000);
        out.breakpoint="expanded";out.columns=3;if width<600{out.breakpoint="compact";out.columns=1;}elif width<840{out.breakpoint="medium";out.columns=2;}return out;}
    if tool=="desktop_animation_policy"{_strict(args,["refresh_hz","battery_saver","reduce_motion"],tool);let hz=_num(args,"refresh_hz",1,1000);let saver=_bool(args,"battery_saver",false);let reduced=_bool(args,"reduce_motion",false);
        out.enabled=not reduced;out.target_fps=num_min(60,hz);if reduced{out.target_fps=0;}elif saver{out.target_fps=num_min(30,hz);}return out;}
    if tool=="remote_transport_policy"{_strict(args,["transport","encrypted","authenticated","peer_identity_verified","replay_protected"],tool);let transport=_enum(args,"transport",["usb","lan","wifi","bluetooth","vpn","tor","relay"]);
        let encrypted=_bool(args,"encrypted",false);let authenticated=_bool(args,"authenticated",false);
        let identity=_bool(args,"peer_identity_verified",false);let replay=_bool(args,"replay_protected",false);
        out.transport=transport;out.allowed=encrypted and authenticated and identity and replay;
        out.mitm_resistant=out.allowed;out.identity_bound=identity;out.replay_protected=replay;return out;}
    if tool=="remote_session_policy"{_strict(args,["trusted_device","attended","authenticated","encrypted","capability_count"],tool);let trusted=_bool(args,"trusted_device",false);let attended=_bool(args,"attended",false);let count=_int(args,"capability_count",0,64);
        out.allowed=(trusted or attended) and _bool(args,"authenticated",false) and _bool(args,"encrypted",false) and count<=16;
        out.requires_pin=not trusted;out.max_capabilities=16;return out;}
    if tool=="remote_file_transfer_policy"{_strict(args,["bytes","files","overwrite"],tool);let bytes=_int(args,"bytes",0,1099511627776);let files=_int(args,"files",0,1000000);let overwrite=_bool(args,"overwrite",false);
        out.allowed=bytes<=10737418240 and files<=10000 and not overwrite;out.chunk_bytes=1048576;out.hash_required=true;return out;}
    if tool=="remote_audio_stream_policy"{_strict(args,["sample_rate","channels","bitrate_kbps"],tool);let rate=_int(args,"sample_rate",8000,192000);let channels=_int(args,"channels",1,8);let bitrate=_int(args,"bitrate_kbps",8,4096);
        out.allowed=rate<=48000 and channels<=2 and bitrate<=512;out.frame_ms=20;out.jitter_buffer_ms=60;return out;}
    if tool=="remote_video_stream_policy"{_strict(args,["width","height","fps","bitrate_kbps"],tool);let w=_int(args,"width",1,16384);let h=_int(args,"height",1,16384);let fps=_int(args,"fps",1,240);let bitrate=_int(args,"bitrate_kbps",16,1000000);
        out.allowed=w*h<=33177600 and fps<=120 and bitrate<=100000;out.keyframe_seconds=2;out.adaptive=true;return out;}
    throw "unhandled desktop/device tool";
}

fn _schemas(){if _schemas_ready{return _schemas_cache;}let empty=_schema(map{});_schemas_cache=map{
    desktop_platform_profile:empty,desktop_backend_capabilities:empty,
    desktop_target_matrix:_schema(map{target:_s(map{enum:["linux","windows","macos","android","ios","web"]})},["target"]),
    desktop_display_fit:_schema(map{source_width:_n(1,32768),source_height:_n(1,32768),target_width:_n(1,32768),target_height:_n(1,32768)},["source_width","source_height","target_width","target_height"]),
    desktop_display_scale:_schema(map{logical_width:_n(1,32768),physical_width:_n(1,65536)},["logical_width","physical_width"]),
    desktop_density_class:_schema(map{dpi:_n(36,1200)},["dpi"]),desktop_responsive_mode:_schema(map{width:_n(1,32768),height:_n(1,32768)},["width","height"]),
    desktop_safe_area:_schema(map{width:_n(1,32768),height:_n(1,32768),left:_n(0,32768),top:_n(0,32768),right:_n(0,32768),bottom:_n(0,32768)},["width","height","left","top","right","bottom"]),
    desktop_pointer_transform:_schema(map{x:_n(0,32768),y:_n(0,32768),source_width:_n(1,32768),source_height:_n(1,32768),target_width:_n(1,32768),target_height:_n(1,32768)},["x","y","source_width","source_height","target_width","target_height"]),
    desktop_pointer_clamp:_schema(map{x:_n(-1048576,1048576),y:_n(-1048576,1048576),width:_n(1,32768,true),height:_n(1,32768,true)},["x","y","width","height"]),
    desktop_keyboard_event_validate:_schema(map{key:_s(map{minLength:1,maxLength:64}),action:_s(map{enum:["press","release"]}),repeat:_b()},["key","action"]),
    desktop_unicode_scalar_validate:_schema(map{codepoint:_n(0,1114111,true)},["codepoint"]),desktop_shortcut_normalize:_schema(map{key:_s(map{minLength:1,maxLength:64}),ctrl:_b(),alt:_b(),shift:_b(),meta:_b()},["key"]),
    desktop_input_rate_policy:_schema(map{events_per_second:_n(1,10000),latency_ms:_n(0,60000)},["events_per_second","latency_ms"]),
    desktop_clipboard_policy:_schema(map{bytes:_n(0,16777216,true),mime:_s(map{enum:["text/plain","text/html","image/png","application/octet-stream"]}),contains_secret:_b()},["bytes","mime"]),
    desktop_notification_policy:_schema(map{title_chars:_n(0,4096,true),body_chars:_n(0,65536,true),urgency:_s(map{enum:["low","normal","critical"]})},["title_chars","body_chars","urgency"]),
    desktop_screen_capture_policy:_schema(map{width:_n(1,16384,true),height:_n(1,16384,true),fps:_n(1,240,true)},["width","height","fps"]),
    desktop_window_action_policy:_schema(map{action:_s(map{enum:["list","focus","move","resize","minimize","maximize","close"]}),attended:_b()},["action"]),
    device_power_policy:_schema(map{battery_percent:_n(0,100),plugged:_b()},["battery_percent","plugged"]),device_thermal_policy:_schema(map{temperature_c:_n(-50,200),pressure:_s(map{enum:["none","light","moderate","severe","critical"]})},["temperature_c","pressure"]),
    device_resource_budget:_schema(map{memory_mib:_n(1,1048576,true),storage_mib:_n(1,16777216,true),cpu_percent:_n(0,100)},["memory_mib","storage_mib","cpu_percent"]),
    desktop_accessibility_profile:_schema(map{text_scale:_n(0.5,4),contrast:_s(map{enum:["normal","high"]}),reduce_motion:_b()},["text_scale","contrast"]),
    desktop_color_contrast:_schema(map{foreground_r:_n(0,255,true),foreground_g:_n(0,255,true),foreground_b:_n(0,255,true),background_r:_n(0,255,true),background_g:_n(0,255,true),background_b:_n(0,255,true),large_text:_b()},["foreground_r","foreground_g","foreground_b","background_r","background_g","background_b"]),
    desktop_responsive_breakpoint:_schema(map{width_dp:_n(1,10000)},["width_dp"]),desktop_animation_policy:_schema(map{refresh_hz:_n(1,1000),battery_saver:_b(),reduce_motion:_b()},["refresh_hz"]),
    remote_transport_policy:_schema(map{transport:_s(map{enum:["usb","lan","wifi","bluetooth","vpn","tor","relay"]}),encrypted:_b(),authenticated:_b(),peer_identity_verified:_b(),replay_protected:_b()},["transport","encrypted","authenticated","peer_identity_verified","replay_protected"]),
    remote_session_policy:_schema(map{trusted_device:_b(),attended:_b(),authenticated:_b(),encrypted:_b(),capability_count:_n(0,64,true)},["trusted_device","attended","authenticated","encrypted","capability_count"]),
    remote_file_transfer_policy:_schema(map{bytes:_n(0,1099511627776,true),files:_n(0,1000000,true),overwrite:_b()},["bytes","files","overwrite"]),
    remote_audio_stream_policy:_schema(map{sample_rate:_n(8000,192000,true),channels:_n(1,8,true),bitrate_kbps:_n(8,4096,true)},["sample_rate","channels","bitrate_kbps"]),
    remote_video_stream_policy:_schema(map{width:_n(1,16384,true),height:_n(1,16384,true),fps:_n(1,240,true),bitrate_kbps:_n(16,1000000,true)},["width","height","fps","bitrate_kbps"])
};_schemas_ready=true;return _schemas_cache;}
fn catalog_entries(){
    if _catalog_ready{return _catalog_cache;}
    let schemas=_schemas();let out=[];
    for i len(NAMES){
        let category="desktop";
        if str_starts_with(NAMES[i],"device_"){category="device";}
        elif str_starts_with(NAMES[i],"remote_"){category="remote";}
        array_push(out,map{name:NAMES[i],category:category,profile:"core-code",
            read_only:true,destructive:false,open_world:false,
            source:"src/desktop_device_tools.sapp",
            description:_description(NAMES[i]),
            input_schema:schemas[NAMES[i]]});
    }
    _catalog_cache=out;_catalog_ready=true;return _catalog_cache;
}
fn functional_records(){
    if _functional_ready{return _functional_cache;}
    let schemas=_schemas();let out=[];
    for i len(NAMES){
        array_push(out,map{name:NAMES[i],status:"complete",input_schema:schemas[NAMES[i]],
            evidence_ids:["pb_mcp_desktop_device_contract:all_tools_execute",
                "pb_mcp_desktop_device_contract:exact_schemas_and_invalid_denial",
                "pb_mcp_desktop_device_contract:no_external_effect_or_content_disclosure"],
            public_mcp:true,
            reason:"bounded deterministic native PBLang desktop/device contract with no external effect"});
    }
    _functional_cache=out;_functional_ready=true;return _functional_cache;
}
fn implemented_tools(){return NAMES;}

export call_desktop_device,catalog_entries,functional_records,implemented_tools,FORMAT;
