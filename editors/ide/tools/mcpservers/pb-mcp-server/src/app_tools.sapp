// Native pblang translations for app/workflow/toolchain planning tools.
//
// These handlers are deterministic control-plane helpers. They do not call
// external apps, providers, CLIs, or networks.

let JSON = import("stdlib:json.sapp");
let sec = import("security.sapp");
let text = import("text_tools.sapp");

fn _lower(v) { return str_lower(str(v)); }

fn _contains(hay, needle) {
    return str_contains(_lower(hay), _lower(needle));
}

fn _join(items, sep) {
    let out = "";
    for i len(items) {
        if i > 0 { out = out + sep; }
        out = out + str(items[i]);
    }
    return out;
}

fn _as_map(value) {
    if value == nil { return map{}; }
    if type(value) == "map" { return value; }
    if type(value) == "string" {
        return try JSON.parse(value) catch try json_parse(value) catch map{};
    }
    return map{};
}

fn _as_array(value) {
    if value == nil { return []; }
    if type(value) == "array" { return value; }
    return [value];
}

fn _tokens(s) {
    let est = text.summarize_token_estimate(str(s), 20000);
    return est.rough_tokens;
}

fn _capabilities() {
    return [
        map{ id: "codex", kind: "coding-agent", commands: ["/ask", "/edit", "/review", "/test"], tools: ["read_file", "grep_code", "git_diff", "review_pr_packet", "workspace_temp_write"], details: "local coding loop with git/read/search/review helpers" },
        map{ id: "claude-code", kind: "coding-agent", commands: ["/init", "/review", "/compact"], tools: ["project_tree", "summarize_multi_file", "review_focused_review", "plan_execution_checklist"], details: "planning and review style command surface" },
        map{ id: "opencode", kind: "coding-agent", commands: ["/session", "/models", "/agents"], tools: ["agent_send", "agent_thread", "app_model_profile_select", "app_agent_mode_plan"], details: "session and agent orchestration style surface" },
        map{ id: "openclaw", kind: "coding-agent", commands: ["/plan", "/run", "/verify"], tools: ["plan_work_buckets", "workflow_execution_plan", "git_diff_snippets"], details: "task breakdown and verification loop" },
        map{ id: "hermes", kind: "agent-runtime", commands: ["/handoff", "/consensus", "/memory"], tools: ["agent_handoff", "consensus_propose", "history_search_past_calls"], details: "multi-agent bus and consensus surface" },
        map{ id: "n8n", kind: "workflow", commands: ["manual trigger", "webhook", "approval"], tools: ["workflow_template_generate", "workflow_validate", "workflow_execution_plan"], details: "workflow graph planning without controlling n8n" },
        map{ id: "gitkraken", kind: "hosted-git", commands: ["launchpad", "pull requests", "issues"], tools: ["gitkraken_cloud_catalog", "gitkraken_hosted_tool_redirect", "git_status"], details: "hosted calls require official GitLens/GitKraken MCP auth; local git tools stay native" },
        map{ id: "pb-mcp", kind: "mcp-server", commands: ["tool search", "catalog", "call"], tools: ["tool_catalog", "tool_search", "mcp_tool_spec_generate", "mcp_manifest_validate"], details: "pblang-native server/tool metadata surface" },
    ];
}

fn app_capability_catalog(args) {
    return map{
        format: "pb-mcp.app.capability_catalog.v1",
        external_control: false,
        capabilities: _capabilities(),
    };
}

fn app_capability_search(args) {
    let q = _lower(try args.query catch try args.q catch "");
    let all = _capabilities();
    let out = [];
    for i len(all) {
        let c = all[i];
        let hay = c.id + " " + c.kind + " " + _join(c.commands, " ") + " " + _join(c.tools, " ") + " " + c.details;
        if q == "" or _contains(hay, q) { out[len(out)] = c; }
    }
    return map{ query: q, count: len(out), matches: out };
}

fn coding_agent_toolchains_catalog(args) {
    return map{
        format: "pb-mcp.coding_agent_toolchains.v1",
        safe_mode: "read-only catalog; no subprocesses",
        toolchains: _capabilities(),
        pairings: [
            map{ goal: "code review", sequence: ["git_diff", "review_pr_packet", "review_focused_review", "review_missing_tests"] },
            map{ goal: "implementation session", sequence: ["project_tree", "grep_code", "plan_execution_checklist", "workspace_temp_write"] },
            map{ goal: "agent coordination", sequence: ["agent_send", "agent_thread", "consensus_propose", "history_bus_replay"] },
            map{ goal: "workflow design", sequence: ["workflow_template_generate", "workflow_validate", "workflow_execution_plan"] },
        ],
    };
}

fn ai_inference_integration_guide(args) {
    return map{
        format: "pb-mcp.ai_inference_integration_guide.v1",
        boundary: "pb-mcp-server coordinates local tools; it does not ship neural weights or call providers from this guide.",
        local_first: ["OCR via tesseract wrappers", "Ollama or local model CLIs behind explicit gates", "pblang-native deterministic text and review tools"],
        gates: ["PB_NETWORK_PROFILE/MINT_NETWORK_PROFILE", "tool-specific trust checks", "redaction for env/secrets", "catalog-only status for unported heavy tools"],
        recommended_flow: ["classify input", "retrieve bounded context", "call local model/tool only when enabled", "verify output", "write audit or agent-bus event"],
    };
}

fn gitkraken_cloud_catalog(args) {
    return map{
        format: "pb-mcp.gitkraken_cloud_catalog.v1",
        native_boundary: "This pblang server implements local git/status/review helpers; hosted GitKraken/GitLens tools require official provider auth.",
        hosted_tools: [
            "pull_request_list", "pull_request_view", "pull_request_create", "pull_request_review",
            "issues_list", "issues_view", "issues_create", "gitkraken_workspace_list",
            "gitlens_launchpad", "gitlens_start_work", "gitlens_review",
        ],
    };
}

fn gitkraken_hosted_tool_redirect(args) {
    let name = str(try args.name catch try args.tool catch "");
    let hosted = gitkraken_cloud_catalog(map{}).hosted_tools;
    for i len(hosted) {
        if hosted[i] == name {
            return map{
                known: true,
                tool: name,
                redirect: "Use the official GitLens/GitKraken MCP with provider sign-in for hosted PR/issue/workspace operations.",
                local_alternatives: ["git_status", "git_log", "git_diff", "review_pr_packet"],
            };
        }
    }
    return map{ known: false, tool: name, error: "unknown hosted GitKraken/GitLens tool name" };
}

fn app_command_palette(args) {
    let q = _lower(try args.query catch "");
    let cmds = [
        map{ command: "/ask", label: "Ask about code", tools: ["read_file", "grep_code", "summarize_text"] },
        map{ command: "/edit", label: "Plan an edit", tools: ["project_tree", "grep_code", "plan_execution_checklist"] },
        map{ command: "/review", label: "Review diff", tools: ["git_diff", "review_pr_packet", "review_missing_tests"] },
        map{ command: "/test", label: "Plan verification", tools: ["plan_test_strategy", "git_diff_stat"] },
        map{ command: "/workflow", label: "Design workflow", tools: ["workflow_template_generate", "workflow_validate", "workflow_execution_plan"] },
        map{ command: "/mcp", label: "Inspect MCP tools", tools: ["tool_search", "mcp_tool_spec_generate", "mcp_manifest_validate"] },
        map{ command: "/skill", label: "Create skill skeleton", tools: ["app_skill_template_generate", "app_skill_manifest_validate"] },
        map{ command: "/plugin", label: "Validate plugin route", tools: ["app_plugin_manifest_validate", "app_plugin_route_plan"] },
    ];
    if q == "" { return cmds; }
    let out = [];
    for i len(cmds) {
        let c = cmds[i];
        let hay = c.command + " " + c.label + " " + _join(c.tools, " ");
        if _contains(hay, q) { out[len(out)] = c; }
    }
    return out;
}

fn app_command_registry_generate(args) {
    let palette = app_command_palette(map{});
    let registry = map{};
    for i len(palette) {
        let c = palette[i];
        registry[c.command] = map{ label: c.label, expands_to: c.tools, read_only: true };
    }
    return map{ format: "pb-mcp.app.command_registry.v1", commands: registry };
}

fn app_slash_command_expand(args) {
    let cmd = _lower(try args.command catch try args.text catch "");
    let parts = str_split(cmd, " ");
    let head = if len(parts) > 0 { parts[0] } else { cmd };
    let palette = app_command_palette(map{});
    for i len(palette) {
        if palette[i].command == head {
            return map{ command: head, label: palette[i].label, steps: palette[i].tools, original: cmd };
        }
    }
    return map{ command: head, steps: ["tool_search", "plan_execution_checklist"], message: "unknown slash command; fallback to search and plan" };
}

fn app_tool_recipe(args) {
    let intent = _lower(try args.intent catch try args.query catch "");
    if _contains(intent, "review") or _contains(intent, "bug") {
        return map{ intent: intent, sequence: ["git_diff", "review_diff_risk", "review_focused_review", "review_missing_tests"], reason: "review/bug intent" };
    }
    if _contains(intent, "workflow") or _contains(intent, "n8n") {
        return map{ intent: intent, sequence: ["workflow_template_generate", "workflow_validate", "workflow_execution_plan"], reason: "workflow intent" };
    }
    if _contains(intent, "agent") or _contains(intent, "handoff") {
        return map{ intent: intent, sequence: ["agent_coordination_playbook", "agent_send", "agent_thread"], reason: "agent coordination intent" };
    }
    if _contains(intent, "skill") {
        return map{ intent: intent, sequence: ["app_skill_template_generate", "app_skill_manifest_validate", "app_skill_route_match"], reason: "skill intent" };
    }
    if _contains(intent, "plugin") {
        return map{ intent: intent, sequence: ["app_plugin_manifest_validate", "app_plugin_capability_matrix", "app_plugin_route_plan"], reason: "plugin intent" };
    }
    return map{ intent: intent, sequence: ["workspace_context", "tool_search", "plan_execution_checklist"], reason: "general coding intent" };
}

fn app_agent_mode_plan(args) {
    let mode = _lower(try args.mode catch try args.intent catch "ask");
    let recipe = app_tool_recipe(map{ intent: mode });
    return map{
        mode: mode,
        stages: ["orient", "gather_context", "act_or_answer", "verify", "summarize"],
        tool_sequence: recipe.sequence,
        writes_allowed: _contains(mode, "edit") or _contains(mode, "fix"),
    };
}

fn app_context_budget_plan(args) {
    let items = _as_array(try args.items catch []);
    let budget = sec.clamp(try args.token_budget catch try args.budget catch 4000, 128, 200000);
    let candidates = [];
    for i len(items) {
        let it = items[i];
        let txt = if type(it) == "map" { str(try it.text catch try it.content catch try it.path catch "") } else { str(it) };
        let priority = if type(it) == "map" { try it.priority catch 1 } else { 1 };
        candidates[len(candidates)] = map{ index: i, priority: priority, rough_tokens: _tokens(txt), text: txt };
    }
    let packed = [];
    let used = 0;
    let chosen = map{};
    for round len(candidates) {
        let best = -1;
        let best_score = -999999;
        for i len(candidates) {
            if (try chosen[str(i)] catch false) != true {
                let c = candidates[i];
                let score = c.priority * 100000 - c.rough_tokens;
                if score > best_score {
                    best = i;
                    best_score = score;
                }
            }
        }
        if best >= 0 {
            chosen[str(best)] = true;
            let c = candidates[best];
            if used + c.rough_tokens <= budget {
                packed[len(packed)] = c;
                used = used + c.rough_tokens;
            }
        }
    }
    return map{ token_budget: budget, used_tokens: used, packed_count: len(packed), packed: packed };
}

fn app_eval_prompt_pack(args) {
    let prompts = _as_array(try args.prompts catch []);
    let out = [];
    for i len(prompts) {
        let p = prompts[i];
        let txt = if type(p) == "map" { str(try p.prompt catch try p.text catch "") } else { str(p) };
        out[len(out)] = map{ id: "eval-" + str(i + 1), prompt: txt, rough_tokens: _tokens(txt), expected_signals: if type(p) == "map" { try p.expected_signals catch [] } else { [] } };
    }
    return map{ format: "pb-mcp.app.eval_prompt_pack.v1", count: len(out), prompts: out };
}

fn app_hooks_policy_validate(args) {
    let hooks = _as_array(try args.hooks catch try args.manifest.hooks catch []);
    let issues = [];
    for i len(hooks) {
        let h = _as_map(hooks[i]);
        let event = str(try h.event catch "");
        let action = str(try h.action catch try h.command catch "");
        if event == "" { issues[len(issues)] = "hook " + str(i) + " missing event"; }
        if action == "" { issues[len(issues)] = "hook " + str(i) + " missing action"; }
        if str_contains(action, ";") or str_contains(action, "&&") or str_contains(action, "|") {
            issues[len(issues)] = "hook " + str(i) + " action looks command-shaped and needs explicit approval";
        }
    }
    return map{ ok: len(issues) == 0, hooks: len(hooks), issues: issues };
}

fn app_model_profile_select(args) {
    let privacy = _lower(try args.privacy catch "local");
    let latency = _lower(try args.latency catch "");
    let task = _lower(try args.task catch try args.intent catch "");
    let profile = "local-deterministic";
    let reason = "privacy-first default";
    if _contains(task, "large") or _contains(task, "vision") {
        return map{ profile: "external-or-local-large-model-when-enabled", reason: "task may need model capabilities outside deterministic pblang tools", network_allowed: privacy != "local" };
    }
    if _contains(latency, "low") or _contains(latency, "fast") {
        return map{ profile: "pblang-fast-local-tools", reason: "low-latency local deterministic path", network_allowed: false };
    }
    return map{ profile: profile, reason: reason, network_allowed: false };
}

fn app_node_suggest(args) {
    let q = _lower(try args.query catch try args.intent catch "");
    let nodes = [];
    if _contains(q, "webhook") { nodes[len(nodes)] = map{ node: "webhook", tools: ["workflow_template_generate", "workflow_validate"] }; }
    if _contains(q, "approval") { nodes[len(nodes)] = map{ node: "approval-gate", tools: ["app_permission_policy_evaluate", "workflow_execution_plan"] }; }
    if _contains(q, "git") or _contains(q, "code") { nodes[len(nodes)] = map{ node: "code-review", tools: ["git_diff", "review_pr_packet"] }; }
    if _contains(q, "agent") { nodes[len(nodes)] = map{ node: "agent-bus", tools: ["agent_send", "agent_thread"] }; }
    if len(nodes) == 0 { nodes[len(nodes)] = map{ node: "manual", tools: ["plan_execution_checklist", "tool_search"] }; }
    return map{ query: q, suggestions: nodes };
}

fn app_permission_policy_evaluate(args) {
    let action = _lower(try args.action catch try args.command catch "");
    let profile = _lower(try args.profile catch sec.network_profile());
    let issues = [];
    let needs = false;
    if str_contains(action, " rm ") or str_contains(action, "delete") { needs = true; issues[len(issues)] = "destructive action"; }
    if str_contains(action, "curl") or str_contains(action, "http") or str_contains(action, "ssh") { needs = true; issues[len(issues)] = "network action"; }
    if profile == "public" or profile == "internet" or profile == "wan" {
        if needs == true { return map{ allow: false, approval_needed: true, issues: issues, profile: profile }; }
    }
    return map{ allow: not needs, approval_needed: needs, issues: issues, profile: profile };
}

fn app_plugin_capability_matrix(args) {
    let plugins = _as_array(try args.plugins catch try args.manifests catch []);
    let rows = [];
    for i len(plugins) {
        let p = _as_map(plugins[i]);
        rows[len(rows)] = map{
            name: str(try p.name catch "plugin-" + str(i + 1)),
            tools: len(_as_array(try p.tools catch [])),
            skills: len(_as_array(try p.skills catch [])),
            commands: len(_as_array(try p.commands catch [])),
            permissions: len(_as_array(try p.permissions catch [])),
        };
    }
    return map{ count: len(rows), matrix: rows };
}

fn app_plugin_manifest_validate(args) {
    let m = _as_map(try args.manifest catch args);
    let issues = [];
    if str(try m.name catch "") == "" { issues[len(issues)] = "missing plugin name"; }
    if len(_as_array(try m.tools catch [])) == 0 and len(_as_array(try m.skills catch [])) == 0 and len(_as_array(try m.commands catch [])) == 0 {
        issues[len(issues)] = "plugin should declare at least one tool, skill, or command";
    }
    return map{ ok: len(issues) == 0, issues: issues, manifest_name: try m.name catch "" };
}

fn app_plugin_route_plan(args) {
    let intent = _lower(try args.intent catch try args.query catch "");
    let m = _as_map(try args.manifest catch map{});
    return map{
        intent: intent,
        plugin: try m.name catch "local-plugin",
        route: app_tool_recipe(map{ intent: intent }).sequence,
        validation: app_plugin_manifest_validate(map{ manifest: m }),
    };
}

fn app_skill_manifest_validate(args) {
    let m = _as_map(try args.manifest catch args);
    let issues = [];
    if str(try m.name catch "") == "" { issues[len(issues)] = "missing skill name"; }
    if str(try m.description catch "") == "" { issues[len(issues)] = "missing description"; }
    if str(try m.instructions catch try m.body catch "") == "" { issues[len(issues)] = "missing instructions/body"; }
    return map{ ok: len(issues) == 0, issues: issues, skill_name: try m.name catch "" };
}

fn app_skill_route_match(args) {
    let q = _lower(try args.query catch try args.request catch "");
    let skills = _as_array(try args.skills catch []);
    let matches = [];
    for i len(skills) {
        let s = _as_map(skills[i]);
        let hay = str(try s.name catch "") + " " + str(try s.description catch "") + " " + _join(_as_array(try s.triggers catch []), " ");
        if q == "" or _contains(hay, q) { matches[len(matches)] = s; }
    }
    return map{ query: q, count: len(matches), matches: matches };
}

fn app_skill_template_generate(args) {
    let kind = _lower(try args.kind catch try args.type catch "coding");
    let name = str(try args.name catch kind + "-skill");
    let tools = app_tool_recipe(map{ intent: kind }).sequence;
    return map{
        name: name,
        description: "Local " + kind + " skill for pb-mcp-server pblang.",
        instructions: "Use local context first, keep actions bounded, verify before final output.",
        tools: tools,
        triggers: [kind, name],
    };
}

fn app_task_queue_plan(args) {
    let tasks = _as_array(try args.tasks catch []);
    let remaining = [];
    for i len(tasks) { remaining[len(remaining)] = _as_map(tasks[i]); }
    let done = map{};
    let levels = [];
    for round len(remaining) {
        let level = [];
        for i len(remaining) {
            let t = remaining[i];
            let id = str(try t.id catch "task-" + str(i + 1));
            if (try done[id] catch false) != true {
                let deps = _as_array(try t.deps catch try t.depends_on catch []);
                let ok = true;
                for d len(deps) {
                    if (try done[str(deps[d])] catch false) != true { ok = false; }
                }
                if ok == true { level[len(level)] = t; }
            }
        }
        if len(level) == 0 { break; }
        for j len(level) {
            let id = str(try level[j].id catch "task-" + str(j + 1));
            done[id] = true;
        }
        levels[len(levels)] = level;
    }
    let done_count = len(map_keys(done));
    return map{ levels: levels, completed: done_count, blocked: len(tasks) - done_count };
}

fn app_worktree_session_plan(args) {
    let goal = str(try args.goal catch try args.task catch "");
    let branch = str_replace_all(str_lower(goal), " ", "-");
    if branch == "" { branch = "pb-mcp-session"; }
    return map{
        goal: goal,
        branch_suggestion: "work/" + str_slice(branch, 0, if len(branch) > 48 { 48 } else { len(branch) }),
        steps: ["git_status", "git_branches", "plan_execution_checklist", "make scoped edits", "run focused tests", "review_pr_packet"],
        creates_worktree: false,
    };
}

fn workflow_template_generate(args) {
    let kind = _lower(try args.kind catch try args.template catch "manual-code-review");
    if kind == "webhook-approval" {
        return map{ nodes: [map{ id: "webhook", type: "webhook" }, map{ id: "propose", type: "function" }, map{ id: "approval", type: "approval" }], connections: [map{ from: "webhook", to: "propose" }, map{ from: "propose", to: "approval" }] };
    }
    if kind == "schedule-report" {
        return map{ nodes: [map{ id: "schedule", type: "schedule" }, map{ id: "collect", type: "tool" }, map{ id: "report", type: "message" }], connections: [map{ from: "schedule", to: "collect" }, map{ from: "collect", to: "report" }] };
    }
    if kind == "coding-ci" {
        return map{ nodes: [map{ id: "diff", type: "git" }, map{ id: "test", type: "test" }, map{ id: "review", type: "review" }], connections: [map{ from: "diff", to: "test" }, map{ from: "test", to: "review" }] };
    }
    return map{ nodes: [map{ id: "manual", type: "manual" }, map{ id: "diff", type: "git" }, map{ id: "review", type: "review" }], connections: [map{ from: "manual", to: "diff" }, map{ from: "diff", to: "review" }] };
}

fn workflow_validate(args) {
    let wf = _as_map(try args.workflow catch args);
    let nodes = _as_array(try wf.nodes catch []);
    let conns = _as_array(try wf.connections catch []);
    let ids = map{};
    let issues = [];
    for i len(nodes) {
        let n = _as_map(nodes[i]);
        let id = str(try n.id catch "");
        if id == "" { issues[len(issues)] = "node " + str(i) + " missing id"; }
        else { ids[id] = true; }
        if str(try n.type catch "") == "" { issues[len(issues)] = "node " + str(i) + " missing type"; }
    }
    for i len(conns) {
        let c = _as_map(conns[i]);
        let from = str(try c.from catch "");
        let to = str(try c.to catch "");
        if (try ids[from] catch false) != true { issues[len(issues)] = "connection " + str(i) + " unknown from: " + from; }
        if (try ids[to] catch false) != true { issues[len(issues)] = "connection " + str(i) + " unknown to: " + to; }
        if from == to and from != "" { issues[len(issues)] = "connection " + str(i) + " self-cycle"; }
    }
    return map{ ok: len(issues) == 0, nodes: len(nodes), connections: len(conns), issues: issues };
}

fn workflow_execution_plan(args) {
    let wf = _as_map(try args.workflow catch args);
    let valid = workflow_validate(map{ workflow: wf });
    if valid.ok != true { return map{ ok: false, validation: valid }; }
    let nodes = _as_array(try wf.nodes catch []);
    let conns = _as_array(try wf.connections catch []);
    let done = map{};
    let levels = [];
    for round len(nodes) {
        let level = [];
        for i len(nodes) {
            let n = _as_map(nodes[i]);
            let id = str(n.id);
            if (try done[id] catch false) != true {
                let ready = true;
                for cidx len(conns) {
                    let c = _as_map(conns[cidx]);
                    if str(c.to) == id and (try done[str(c.from)] catch false) != true { ready = false; }
                }
                if ready == true { level[len(level)] = n; }
            }
        }
        if len(level) == 0 { break; }
        for j len(level) { done[str(level[j].id)] = true; }
        levels[len(levels)] = level;
    }
    return map{ ok: len(map_keys(done)) == len(nodes), levels: levels, ordered_count: len(map_keys(done)), validation: valid };
}

fn call_app(tool, args) {
    if args == nil { args = map{}; }
    if tool == "ai_inference_integration_guide" { return ai_inference_integration_guide(args); }
    if tool == "coding_agent_toolchains_catalog" { return coding_agent_toolchains_catalog(args); }
    if tool == "gitkraken_cloud_catalog" { return gitkraken_cloud_catalog(args); }
