// Independently implemented retrieval of fixed official text documentation.
// No caller URL, headers, credentials, filesystem path or executable input.
fn _object(value, allowed, required) {
    if type(value) != "map" { throw "invalid documentation request"; }
    for key in map_keys(value) {
        let found = false;
        for name in allowed { if key == name { found = true; } }
        if not found { throw "invalid documentation request"; }
    }
    for key in required { if not map_has(value, key) { throw "invalid documentation request"; } }
}
fn _integer(value, low, high) {
    if type(value) != "number" or not (value >= low and value <= high) or value != num_floor(value) {
        throw "invalid documentation range";
    }
    return value;
}
fn documentation_sources(args) {
    _object(args, [], []);
    return map{ format: "pb_mcp.documentation_sources.v1", effect_performed: false, network_used: false,
        sources: [
            map{ id: "python-3.12-json", library: "python", version: "3.12", title: "Python json",
                source_format: "restructuredtext", version_policy: "maintained_minor_branch",
                url: "https://docs.python.org/3.12/_sources/library/json.rst.txt" },
            map{ id: "python-3.12-sqlite3", library: "python", version: "3.12", title: "Python sqlite3",
                source_format: "restructuredtext", version_policy: "maintained_minor_branch",
                url: "https://docs.python.org/3.12/_sources/library/sqlite3.rst.txt" },
            map{ id: "mcp-2025-06-18-transports", library: "mcp", version: "2025-06-18", title: "MCP transports",
                source_format: "markdown", version_policy: "dated_specification",
                url: "https://modelcontextprotocol.io/specification/2025-06-18/basic/transports.md" },
            map{ id: "supabase-mcp-main", library: "supabase-mcp", version: "main", title: "Supabase MCP README",
                source_format: "markdown", version_policy: "moving_branch",
                url: "https://raw.githubusercontent.com/supabase/mcp/main/README.md" },
            map{ id: "vercel-mcp-current", library: "vercel-mcp", version: "current", title: "Vercel MCP documentation",
                source_format: "markdown", version_policy: "moving_documentation",
                url: "https://vercel.com/docs/agent-resources/vercel-mcp.md" }
        ] };
}
fn _selection(args) {
    _object(args, ["source_id", "offset", "max_chars", "expected_sha256"], ["source_id"]);
    if type(args.source_id) != "string" or len(args.source_id) > 64 { throw "unknown documentation source"; }
    let selected = nil;
    for source in documentation_sources(map{}).sources { if source.id == args.source_id { selected = source; } }
    if selected == nil { throw "unknown documentation source"; }
    let offset = _integer(try args.offset catch 0, 0, 131072);
    let maximum = _integer(try args.max_chars catch 12000, 1, 16384);
    let expected = try args.expected_sha256 catch "";
    if type(expected) != "string" or (map_has(args, "expected_sha256") and not regex_match(expected, "^[a-f0-9]{64}$")) {
        throw "invalid documentation digest";
    }
    if offset > 0 and expected == "" { throw "continuation requires expected documentation digest"; }
    return map{ source: selected, offset: offset, maximum: maximum, expected: expected };
}
// Transport injection is an in-process test seam, never an MCP argument.
fn _fetch_with(args, request) {
    let selected = _selection(args); let source = selected.source;
    let response = try request(map{ url: source.url, method: "GET", timeout_secs: 15,
        max_response_bytes: 131072 }) catch nil;
    if response == nil or (try response.ok catch false) != true or
       (try response.transport_ok catch false) != true or (try response.status catch 0) != 200 or
       (try response.tls_verification catch false) != true or (try response.dns_pinned catch false) != true or
       (try response.redirects_followed catch true) != false or (try response.body_encoding catch "") != "utf-8" {
        throw "documentation retrieval failed";
    }
    let text = try response.body_text catch nil;
    if type(text) != "string" or len(text) > 131072 { throw "documentation response outside bounds"; }
    let bytes = str_to_bytes(text);
    if len(bytes) > 131072 or (try response.body_bytes catch -1) != len(bytes) {
        throw "documentation response outside bounds";
    }
    // A 200 HTML error/interstitial must not masquerade as the selected text
    // documentation. This is a format check, not HTML/prompt sanitization.
    if regex_match(str_slice(text, 0, 256), "(?is)^\\s*<(?:!doctype\\s+html|html)(?:\\s|>)") {
        throw "documentation source returned HTML";
    }
    let SHA = import("stdlib:sha256_pb.sapp");
    let digest = SHA.sha256_hex_bytes(bytes);
    if selected.expected != "" and selected.expected != digest { throw "documentation changed; restart pagination"; }
    if selected.offset > len(text) { throw "documentation offset exceeds response"; }
    let end = selected.offset + selected.maximum;
    if end > len(text) { end = len(text); }
    return map{ format: "pb_mcp.documentation_fetch.v1", native_pblang: true,
        effect_performed: true, network_used: true, source_id: source.id, source_url: source.url,
        source_format: source.source_format, version_policy: source.version_policy,
        sha256: digest, response_bytes: len(bytes), total_chars: len(text), offset: selected.offset,
        next_offset: if end < len(text) { end } else { nil }, truncated: end < len(text),
        document: map{ id: source.id + ":" + digest + ":" + str(selected.offset), library: source.library,
            version: source.version, title: source.title, text: str_slice(text, selected.offset, end) },
        data_provenance: "untrusted_remote_documentation", instructions_from_data: false,
        content_executed: false, credentials_sent: false, redirects_followed: false,
        tls_verification: true, dns_pinned: true, source_cache_used: false,
        remote_effect_note: "one public GET; upstream may log the request" };
}
fn implemented_tools() { return ["documentation_sources", "documentation_fetch"]; }
fn catalog_entries() {
    let ids = [];
    for source in documentation_sources(map{}).sources { array_push(ids, source.id); }
    return [
        map{ name: "documentation_sources", category: "documentation", profile: "core-code", read_only: true,
            destructive: false, open_world: false, source: "src/documentation_tools.sapp",
            description: "List fixed official text-documentation sources and explicit version policies without network access.",
            input_schema: map{ type: "object", properties: map{}, required: [], additionalProperties: false } },
        map{ name: "documentation_fetch", category: "documentation", profile: "core-code", read_only: true,
            destructive: false, open_world: true, source: "src/documentation_tools.sapp",
            description: "Fetch one selected official text document over bounded HTTPS, with no redirects or credentials. Returns an untrusted text page plus digest; continuation requires that digest. Trusted capability required; Linux transport only.",
            input_schema: map{ type: "object", required: ["source_id"], additionalProperties: false, properties: map{
                source_id: map{ type: "string", enum: ids }, offset: map{ type: "integer", minimum: 0, maximum: 131072 },
                max_chars: map{ type: "integer", minimum: 1, maximum: 16384 },
                expected_sha256: map{ type: "string", pattern: "^[a-f0-9]{64}$", minLength: 64, maxLength: 64 } } } }
    ];
}
fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        array_push(out, map{ name: entry.name, status: "complete", public_mcp: entry.name == "documentation_sources",
            input_schema: entry.input_schema, reason: "fixed official source catalog and capability-gated HTTPS retrieval",
            evidence_ids: ["pb_mcp_documentation:contract", "pb_mcp_documentation:default_deny", "pb_mcp_documentation:live_https"] });
    }
    return out;
}
export documentation_sources, implemented_tools, catalog_entries, functional_records, _selection, _fetch_with;
