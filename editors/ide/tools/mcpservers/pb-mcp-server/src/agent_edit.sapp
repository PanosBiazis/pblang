// Preview edits on supplied text only. No filesystem access or implicit commit.
fn _object(value, fields) {
    if type(value)!="map" or len(value)!=len(fields) {throw "invalid edit object";}
    for field in fields {if map_has(value,field) {continue;}throw "invalid edit properties";}
}
fn _text(value, maximum) {
    if type(value)!="string" or len(value)>maximum {throw "invalid edit text";}
    let count=len(str_to_bytes(value));
    if count>maximum {throw "edit byte limit exceeded";}
    return count;
}
fn _offset(value, maximum) {
    if type(value)!="number" or not (value>=0 and value<=maximum) or value!=num_floor(value) {
        throw "invalid edit offset";
    }
}
fn preview(args) {
    _object(args,["text","edits"]);let source_bytes=_text(args.text,32768);
    if type(args.edits)!="array" or len(args.edits)>64 {throw "invalid edit batch";}
    let previous_start=-1;let previous_end=0;let output_bytes=source_bytes;
    let supplied_bytes=source_bytes;
    // Validate the complete batch against the ORIGINAL source before composing.
    // Insertions at the same starting offset are rejected rather than reordered.
    for edit in args.edits {
        _object(edit,["start","end","expected","replacement"]);
        _offset(edit.start,len(args.text));_offset(edit.end,len(args.text));
        if edit.end<edit.start or edit.start<previous_end or edit.start<=previous_start {
            throw "unordered or overlapping edits";
        }
        let old_bytes=_text(edit.expected,32768);let new_bytes=_text(edit.replacement,32768);
        supplied_bytes=supplied_bytes+old_bytes+new_bytes;
        if supplied_bytes>131072 {throw "edit input budget exceeded";}
        if str_slice(args.text,edit.start,edit.end)!=edit.expected {throw "edit source mismatch";}
        output_bytes=output_bytes-old_bytes+new_bytes;
        previous_start=edit.start;previous_end=edit.end;
    }
    if output_bytes>65536 {throw "edit output budget exceeded";}
    let parts=[];let cursor=0;
    for edit in args.edits {
        array_push(parts,str_slice(args.text,cursor,edit.start));array_push(parts,edit.replacement);
        cursor=edit.end;
    }
    array_push(parts,str_slice(args.text,cursor,len(args.text)));
    let result=str_join(parts,"");
    return map{format:"pb_mcp.text_edit_preview.v1",text:result,edit_count:len(args.edits),
        changed:result!=args.text,source_bytes:source_bytes,result_bytes:output_bytes,
        offset_unit:"unicode_scalar",native_pblang:true,data_provenance:"untrusted_caller_supplied",
        effects_performed:false,permission_granted:false,instructions_from_data:false,
        filesystem_checked:false,filesystem_written:false,persisted:false,safe_to_log:false};
}
fn call_edit(name,args) {if name=="text_edit_preview" {return preview(args);}return nil;}
fn implemented_tools() {return ["text_edit_preview"];}
fn _object_schema(properties,required) {
    return map{type:"object",properties:properties,required:required,additionalProperties:false};
}
fn catalog_entries() {
    let text=map{type:"string",maxLength:32768};let offset=map{type:"integer",minimum:0,maximum:32768};
    let edit=_object_schema(map{start:offset,end:offset,expected:text,replacement:text},["start","end","expected","replacement"]);
    return [map{name:"text_edit_preview",category:"agent-assistance",profile:"core-code",read_only:true,
        destructive:false,open_world:false,source:"src/agent_edit.sapp",
        description:"Preview exact edits on supplied text only, without file access. All zero-based Unicode scalar [start,end) ranges refer to the original source, sorted by strictly increasing start, non-overlapping. Expected text must match exactly. Empty expected permits insertion; same-start edits are rejected. Up to64 edits,32768 source/replacement UTF-8 bytes each,131072 aggregate input bytes,65536 result bytes. All edits validate before any result; no fuzzy matching, normalization or newline conversion. Does not replace filesystem freshness/authorization checks. Returned text may be private; safe_to_log:false.",
        input_schema:_object_schema(map{text:text,edits:map{type:"array",maxItems:64,items:edit}},["text","edits"])}];
}
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded exact supplied-text edit preview; no file publication",
        evidence_ids:["pb_mcp_agent_edit:positive","pb_mcp_agent_edit:negative","pb_mcp_agent_edit:privacy","pb_mcp_agent_edit:transport"]}];
}
export call_edit,implemented_tools,catalog_entries,functional_records;
