let _V33_CACHE = map{};

fn _v33() {
    if map_has(_V33_CACHE, "m") { return _V33_CACHE["m"]; }
    let m = try import("editors/ide/tools/ai/pbai_bio_org_flywheel_v33.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_bio_org_flywheel_v33.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_bio_org_flywheel_v33.sapp") catch nil; }
    if m == nil { m = try import("../../pblang/editors/ide/tools/ai/pbai_bio_org_flywheel_v33.sapp") catch nil; }
    if m == nil { m = try import("../../../pblang/editors/ide/tools/ai/pbai_bio_org_flywheel_v33.sapp") catch nil; }
    _V33_CACHE["m"] = m;
    return m;
}

