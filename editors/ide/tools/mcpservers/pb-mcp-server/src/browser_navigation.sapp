// Pure origin admission for the future mediated browser network route.
// A plan is not an OS/network grant. The owner supplies approved origins and
// must independently pin public DNS answers, verify TLS and bound the fetch.
fn _letter(code) { return (code >= 65 and code <= 90) or (code >= 97 and code <= 122); }
fn _digit(code) { return code >= 48 and code <= 57; }
fn _hex(code) { return _digit(code) or (code >= 65 and code <= 70) or (code >= 97 and code <= 102); }
fn _url(value) {
    if type(value) != "string" or len(value) < 9 or len(value) > 8192 { throw "invalid browser HTTPS URL"; }
    let bytes = str_to_bytes(value);
    if len(bytes) > 8192 { throw "browser URL exceeds request budget"; }
    for i len(bytes) {
        let code = bytes[i];
        if code < 33 or code > 126 or code == 34 or code == 60 or code == 62 or code == 92
            or code == 94 or code == 96 or code == 123 or code == 124 or code == 125 {
            throw "browser URL must use explicit ASCII percent encoding";
        }
        if code == 37 and (i + 2 >= len(bytes) or not _hex(bytes[i + 1]) or not _hex(bytes[i + 2])) {
            throw "invalid browser URL escape";
        }
    }
    if str_lower(str_slice(value, 0, 8)) != "https://" { throw "browser requires HTTPS"; }
    let end = len(value);
    for separator in ["/", "?", "#"] {
        let at = str_index_of(str_slice(value, 8, len(value)), separator);
        if at >= 0 and at + 8 < end { end = at + 8; }
    }
    let host = str_lower(str_slice(value, 8, end));
    let colon = str_index_of(host, ":");
    if colon >= 0 {
        if str_slice(host, colon, len(host)) != ":443" { throw "browser requires the default HTTPS port"; }
        host = str_slice(host, 0, colon);
    }
    if len(host) < 3 or len(host) > 253 { throw "invalid browser host"; }
    let labels = str_split(host, ".");
    if len(labels) < 2 { throw "fully qualified browser host required"; }
    for label in labels {
        let codes = str_to_bytes(label);
        if len(codes) < 1 or len(codes) > 63 or codes[0] == 45 or codes[len(codes) - 1] == 45 {
            throw "invalid browser host label";
        }
        for code in codes { if not (_letter(code) or _digit(code) or code == 45) { throw "invalid browser host label"; } }
    }
    let suffix = labels[len(labels) - 1];
    if not _letter(str_to_bytes(suffix)[0]) { throw "literal or ambiguous numeric browser host refused"; }
    for local in ["localhost", "local", "internal", "home", "test", "invalid", "onion"] {
        if suffix == local { throw "nonpublic browser host refused"; }
    }
    let origin = "https://" + host;
    let target = str_slice(value, end, len(value));
    if target == "" or not str_starts_with(target, "/") { target = "/" + target; }
    let fragment = str_index_of(target, "#");
    let path = if fragment >= 0 { str_slice(target, 0, fragment) } else { target };
    return map{ origin: origin, host: host, path: path, url: origin + path, navigation_url: origin + target };
}
fn plan(url, method, approved_origins) {
    if method != "GET" and method != "HEAD" { throw "browser network method is not approved"; }
    if type(approved_origins) != "array" or len(approved_origins) < 1 or len(approved_origins) > 16 {
        throw "explicit browser origins required";
    }
    let allowed = map{};
    for entry in approved_origins {
        let parsed = _url(entry);
        if parsed.navigation_url != parsed.origin + "/" { throw "browser grant must be an origin"; }
        if map_has(allowed, parsed.origin) { throw "duplicate browser origin grant"; }
        allowed[parsed.origin] = true;
    }
    let request = _url(url);
    if not map_has(allowed, request.origin) { throw "browser origin is not approved"; }
    request.method = method;
    return request;
}
export plan;
