// Bounded caller-data checks only. IDs are opaque; never resolve or execute them.
fn _missing(values, id) {
    if map_has(values,id) {return false;}
    return true;
}
fn _object(value, fields) {
    if type(value)!="map" {throw "assistance: invalid object";}
    if len(value)!=len(fields) {throw "assistance: invalid properties";}
    for field in fields {if _missing(value,field) {throw "assistance: invalid properties";}}
}
fn _array(value, maximum) {
    if type(value)!="array" {throw "assistance: invalid array";}
    if len(value)>maximum {throw "assistance: array limit exceeded";}
}
fn _id(value) {
    if type(value)!="string" {throw "assistance: invalid identifier";}
    if len(value)<1 or len(value)>64 {throw "assistance: invalid identifier";}
    if not regex_match(value,"^[A-Za-z0-9_.:-]+$") {throw "assistance: invalid identifier";}
}
fn _ids(values, maximum) {
    _array(values,maximum);let seen=map{};
    for value in values {
        _id(value);
        if map_has(seen,value) {throw "assistance: duplicate identifier";}
        seen[value]=true;
    }
    return seen;
}
fn _result(kind) {
    return map{format:"pb_mcp."+kind+".v1",native_pblang:true,
        data_source:"caller_supplied",data_provenance:"untrusted_caller_supplied",
        effects_performed:false,permission_granted:false,instructions_from_data:false,
        safe_to_log:false,network_used:false,model_loaded:false};
}
fn _workflow(args) {
    _object(args,["steps","completed"]);_array(args.steps,64);
    let complete=_ids(args.completed,64);let known=map{};let edges=0;
    for step in args.steps {
        _object(step,["id","requires"]);_id(step.id);_ids(step.requires,64);
        if map_has(known,step.id) {throw "assistance: duplicate step";}
        known[step.id]=true;edges=edges+len(step.requires);
        if edges>256 {throw "assistance: edge limit exceeded";}
    }
    for step in args.steps {
        for dependency in step.requires {
            if dependency==step.id {throw "assistance: self dependency";}
            if _missing(known,dependency) {throw "assistance: missing dependency";}
        }
    }
    for id in args.completed {
        if _missing(known,id) {throw "assistance: unknown completed step";}
    }
    // Bounded topological closure validates the whole graph, including completed
    // components; a valid completion list cannot conceal a cycle.
    let visited=map{};let progress=true;
    while progress {
        progress=false;
        for step in args.steps {
            if _missing(visited,step.id) {
                let available=true;
                for dependency in step.requires {if _missing(visited,dependency) {available=false;}}
                if available {visited[step.id]=true;progress=true;}
            }
        }
    }
    if len(visited)!=len(args.steps) {throw "assistance: cyclic dependencies";}
    let ready=[];let pending=[];let completed=[];
    for step in args.steps {
        let available=true;
        for dependency in step.requires {if _missing(complete,dependency) {available=false;}}
        if map_has(complete,step.id) {
            if not available {throw "assistance: incomplete prerequisites";}
            completed[len(completed)]=step.id;
        } else {
            if available {ready[len(ready)]=step.id;} else {pending[len(pending)]=step.id;}
        }
    }
    let out=_result("ai_workflow_check");out.ready=ready;out.pending=pending;
    out.completed=completed;out.finished=len(completed)==len(args.steps);
    out.execution_performed=false;out.completion_verified=false;
    return out;
}
fn _evidence(args) {
    _object(args,["sources","claims"]);let known=_ids(args.sources,128);
    _array(args.claims,128);let claims=map{};let links=0;
    // Validate every record before producing results.
    for claim in args.claims {
        _object(claim,["id","sources"]);_id(claim.id);_ids(claim.sources,128);
        if map_has(claims,claim.id) {throw "assistance: duplicate claim";}
        claims[claim.id]=true;links=links+len(claim.sources);
        if links>1024 {throw "assistance: link limit exceeded";}
    }
    let rows=[];let missing=[];let seen=map{};
    for claim in args.claims {
        let absent=[];
        for source in claim.sources {
            if _missing(known,source) {
                absent[len(absent)]=source;
                if _missing(seen,source) {seen[source]=true;missing[len(missing)]=source;}
            }
        }
        let status=if len(claim.sources)==0 {"uncited"} else {"cited"};
        if len(absent)>0 {status="unknown_source";}
        rows[len(rows)]=map{id:claim.id,status:status,missing_sources:absent};
    }
    let out=_result("ai_evidence_check");out.claims=rows;out.missing_sources=missing;
    out.truth_verified=false;out.source_contents_checked=false;
    return out;
}
fn call_assistance(name,args) {
    if name=="ai_workflow_check" {return _workflow(args);}
    if name=="ai_evidence_check" {return _evidence(args);}
    return nil;
}
fn implemented_tools() {return ["ai_workflow_check","ai_evidence_check"];}
fn _schema_object(properties, required) {
    return map{type:"object",properties:properties,required:required,additionalProperties:false};
}
fn _schema_ids(maximum) {
    return map{type:"array",minItems:0,maxItems:maximum,uniqueItems:true,
        items:map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z0-9_.:-]+$"}};
}
fn catalog_entries() {
    let id=map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z0-9_.:-]+$"};
    let schemas=[
        _schema_object(map{steps:map{type:"array",minItems:0,maxItems:64,
            description:"Unique step IDs; at most 256 dependency edges across all steps; no self, missing or cyclic dependencies.",
            items:_schema_object(map{id:id,requires:_schema_ids(64)},["id","requires"])},
            completed:_schema_ids(64)},["steps","completed"]),
        _schema_object(map{sources:_schema_ids(128),claims:map{type:"array",minItems:0,maxItems:128,
            description:"Unique claim IDs; at most 1024 source links across all claims.",
            items:_schema_object(map{id:id,sources:_schema_ids(128)},["id","sources"])}},["sources","claims"])
    ];
    let descriptions=[
        "Check caller-supplied workflow dependencies and declared completion. Return ready, pending and completed IDs in step input order. At most 64 steps, 256 edges; completion must include prerequisites. No execution or completion verification; identifiers may be sensitive, safe_to_log:false.",
        "Check citation identifier presence for caller-supplied claims against supplied source IDs. Return cited, uncited or unknown_source and missing IDs. At most 128 sources, 128 claims, 1024 links. Does not read sources or verify truth, relevance, credibility or support; truth_verified:false, safe_to_log:false."
    ];
    let names=implemented_tools();let entries=[];
    for i len(names) {
        entries[len(entries)]=map{name:names[i],category:"agent-assistance",profile:"core-code",
            read_only:true,destructive:false,open_world:false,source:"src/agent_assistance.sapp",
            description:descriptions[i],input_schema:schemas[i]};
    }
    return entries;
}
fn functional_records() {
    let records=[];
    for entry in catalog_entries() {
        records[len(records)]=map{name:entry.name,status:"complete",public_mcp:true,
            input_schema:entry.input_schema,
            reason:"bounded deterministic caller-data checking; no execution, source retrieval or authority grant",
            evidence_ids:["pb_mcp_agent_assistance:positive","pb_mcp_agent_assistance:bounds",
                "pb_mcp_agent_assistance:negative","pb_mcp_agent_assistance:privacy"]};
    }
    return records;
}
export call_assistance,catalog_entries,functional_records,implemented_tools;
