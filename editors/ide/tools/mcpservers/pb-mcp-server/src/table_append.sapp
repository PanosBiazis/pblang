// Append two bounded caller-supplied literal Sheets; no I/O or normalization.
let Sheet=import("stdlib:sheet_document.sapp");

fn _fail(){throw "Invalid table append arguments";}
fn implemented_tools(){return ["data_table_append_rows"];}

fn call_append(name,args){
    if name!="data_table_append_rows" {return nil;}
    if type(args)!="map" or len(map_keys(args))!=2 or
       not map_has(args,"left") or not map_has(args,"right") {_fail();}
    let left=try Sheet.validate(args.left) catch nil;
    let right=try Sheet.validate(args.right) catch nil;
    if left==nil or right==nil {_fail();}
    let rows=left.rows+right.rows-1;
    let input_bytes=left.text_bytes+right.text_bytes;
    if left.columns!=right.columns or rows>32 or input_bytes>8192 {_fail();}

    // Charge both input headers; retain just one in the output. Exact equality
    // also proves that the right header is nonempty and unique once left is.
    let names=map{};let header_bytes=0;
    for column in range(0,left.columns){
        let heading=args.left.cells[0][column];
        if heading=="" or map_has(names,heading) or
           heading!=args.right.cells[0][column] {_fail();}
        names[heading]=true;header_bytes=header_bytes+len(str_to_bytes(heading));
    }
    let output_bytes=input_bytes-header_bytes;
    if output_bytes>8192 or len(str_to_bytes(json_stringify(args)))>65536 {_fail();}

    // Allocate only after admission. Never reuse either input's row containers,
    // including when the caller passes the same document for both operands.
    let cells=[];
    for source in args.left.cells {
        let row=[];for value in source {push(row,value);}push(cells,row);
    }
    for index in range(1,right.rows){
        let row=[];for value in args.right.cells[index] {push(row,value);}push(cells,row);
    }
    let document=map{format:Sheet.FORMAT,cells:cells};
    let checked=try Sheet.validate(document) catch nil;
    if checked==nil or checked.rows!=rows or checked.text_bytes!=output_bytes {_fail();}
    let result=map{format:"pb_mcp.data_table_append_rows.v1",document:document,
        left_data_rows:left.rows-1,right_data_rows:right.rows-1,data_rows:rows-1,
        column_count:left.columns,input_text_bytes:input_bytes,output_text_bytes:output_bytes,
        header:true,row_order:"left_then_right",matching:"exact_ordered_headers",normalization:"none",
        contains_cell_text:true,contains_headers:true,safe_to_log:false,native_pblang:true,
        data_source:"caller_supplied",effects_performed:false,network_used:false,model_loaded:false,
        automatic_deletion:false,formulas_evaluated:false};
    if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}
    return result;
}

fn catalog_entries(){
    let document=map{type:"object",required:["format","cells"],additionalProperties:false,
        properties:map{format:map{type:"string",enum:["pblang.sheet-document.v1"]},
            cells:map{type:"array",minItems:1,maxItems:32,items:map{type:"array",minItems:1,maxItems:8,
                items:map{type:"string",maxLength:256}}}},
        description:"Rectangular literal Sheet,1..32 rows including header,1..8 columns,256 UTF8bytes/cell,no NUL. Row0 names must be nonempty and exactly unique. Whitespace-only names are valid; no normalization."};
    return [map{name:"data_table_append_rows",category:"table-append",profile:"core-code",
        source:"src/table_append.sapp",read_only:true,destructive:false,open_world:false,
        input_schema:map{type:"object",required:["left","right"],additionalProperties:false,
            properties:map{left:document,right:document}},
        description:"Append literal data rows from two caller Sheets with exactly equal headers in the same order. Keep one header, then all left rows and all right rows, preserving duplicates and literal formulas. Header-only tables are valid. Return a detached document and row/UTF8byte counts. Reject mismatched/reordered/empty/duplicate headers; no automatic column alignment. Combined input cells including BOTH headers<=8192 UTF8bytes; combined output<=32rows including one header and8192bytes. Validate bounds before output allocation. Arguments/result<=65536 serialized UTF8bytes. Exact case/space/Unicode equality; no trimming,inference,normalization or formula evaluation. Caller-private cells/headers returned; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."}];
}

fn functional_records(){
    let out=[];
    for entry in catalog_entries(){
        push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
            reason:"Bounded exact-header append of two caller-supplied literal Sheets",
            evidence_ids:["pb_mcp_table_append:exact_headers","pb_mcp_table_append:combined_bounds",
                "pb_mcp_table_append:detached_rows","pb_mcp_table_append:privacy_parity"]});
    }
    return out;
}
export implemented_tools,call_append,catalog_entries,functional_records;
