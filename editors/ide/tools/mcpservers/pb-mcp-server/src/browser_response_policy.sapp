    "content-security-policy-report-only":true,"referrer-policy":true,"permissions-policy":true,
    "cross-origin-resource-policy":true,"cross-origin-opener-policy":true,"cross-origin-embedder-policy":true,
    "access-control-allow-origin":true,"access-control-expose-headers":true,"vary":true,"x-content-type-options":true};
fn integer(value,low,high) {
    return type(value)=="number" and value>=low and value<=high and value==num_floor(value);
}
// One immutable lookup per module instead of a function call for every byte.
let TOKEN=[];for i 128 { array_push(TOKEN,false); }
for code in str_to_bytes("!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz") { TOKEN[code]=true; }
fn plan(method,status,headers,max_bytes=2097152) {
    if method!="GET" and method!="HEAD" { throw "unsupported response method"; }
    if not integer(status,200,599) { throw "unsupported browser response"; }
    if not integer(max_bytes,1,2097152) { throw "invalid resource budget"; }
    if type(headers)!="array" or len(headers)>100 { throw "resource header count bound"; }
    let has_body=method!="HEAD" and status!=204 and status!=304;
    let encoding="identity";let expected=0;let length_value=nil;let transfer_value=nil;let encoding_value=nil;let kept=[];let metadata=0;
    for pair in headers {
        if type(pair)!="array" or len(pair)!=2 or type(pair[0])!="string" or type(pair[1])!="string" {
            throw "invalid resource header pair";
        }
        let name=pair[0];let value=pair[1];
        // Check scalar lengths before allocating UTF-8 arrays. Non-ASCII then fails.
        if len(name)==0 or len(name)+len(value)+4>8192 { throw "resource header line bound"; }
        metadata=metadata+len(name)+len(value)+4;
        if metadata>65536 { throw "resource header metadata bound"; }
        for code in str_to_bytes(name) { if code>=128 or not TOKEN[code] { throw "invalid resource header name"; } }
        for code in str_to_bytes(value) { if code<32 or code>126 { throw "invalid resource header"; } }
        name=str_lower(name);
        if name=="content-length" {
            if length_value!=nil { throw "duplicate resource framing header"; }
            length_value=value;
        }
        if name=="transfer-encoding" {
            if transfer_value!=nil { throw "duplicate resource framing header"; }
            transfer_value=value;
        }
        if name=="content-encoding" {
            if encoding_value!=nil { throw "duplicate resource framing header"; }
            encoding_value=value;
        }
        if map_has(KEEP,name) { array_push(kept,map{name:name,value:value}); }
    }
    if length_value!=nil and transfer_value!=nil { throw "ambiguous resource framing"; }
    if transfer_value!=nil and str_lower(str_trim(transfer_value))!="chunked" {
        throw "unsupported resource transfer";
    }
    if encoding_value!=nil {
        encoding=str_lower(str_trim(encoding_value));
        if encoding=="" { encoding="identity"; }
    }
    if encoding!="identity" and encoding!="gzip" and encoding!="x-gzip" and encoding!="deflate" {
        throw "unsupported resource encoding";
    }
    if length_value!=nil {
        let value=length_value;
        if len(value)==0 { throw "invalid resource length"; }
        let number=0;
        for digit in str_to_bytes(value) {
            if digit<48 or digit>57 { throw "invalid resource length"; }
            if has_body {
