fn _append_names(target, names) {
    for i len(names) { target[str(names[i])] = true; }
}

fn _plan_only_names() {
    let out = map{};
    _append_names(out, WEB_TOOLS.implemented_tools());
    _append_names(out, MEDIA_TOOLS.implemented_tools());
    _append_names(out, NET_IOT_TOOLS.implemented_tools());
    _append_names(out, SANDBOX_TOOLS.implemented_tools());
    _append_names(out, IDE_TOOLS.implemented_tools());
    _append_names(out, PROJECT_TOOLS.implemented_tools());
    return out;
}

fn _blocked_names() {
    let out = map{};
    // These groups can execute subprocesses, inspect host processes, or expose
    // environment data. Keep them off the public protocol until each command
    // has a strict schema, capability policy, and dedicated regression evidence.
    _append_names(out, SYSTEM_TOOLS.implemented_tools());
    return out;
}

let _verified_cache = map{};
let _plan_cache = map{};
let _blocked_cache = map{};
let _verified_ready = false;
let _plan_ready = false;
let _blocked_ready = false;

fn _verified_map() {
    if _verified_ready { return _verified_cache; }
    let out = map{};
    for entry in RUNTIME_STATUS.functional_records(){out[entry.name]=entry;}
    for entry in RUNTIME_POLICY.functional_records(){out[entry.name]=entry;}
    for entry in agent_knowledge.functional_records(){out[entry.name]=entry;}
    for entry in agent_memory.functional_records(){out[entry.name]=entry;}
    for entry in agent_diagnostics.functional_records(){out[entry.name]=entry;}
    for entry in CATALOG_REVIEW.catalog_entries(){
        out[entry.name]=map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
            reason:"bounded caller-supplied catalog review; no execution or attestation",
            evidence_ids:["pb_mcp_catalog_full_surface:dispatch","pb_mcp_catalog_snapshot_tools:core","pb_mcp_catalog_changes_tools:core"]};
    }
    for entry in CLIENT_ACCEPTANCE.functional_records(){out[entry.name]=entry;}
    for entry in agent_acceptance.functional_records(){out[entry.name]=entry;}
    for entry in agent_edit.functional_records(){out[entry.name]=entry;}
    for entry in GROUPS.functional_records(){out[entry.name]=entry;}
    for entry in COLUMNS.functional_records(){out[entry.name]=entry;}
    for entry in BROWSER_DOC.functional_records(){out[entry.name]=entry;}
    for entry in REA.functional_records(){out[entry.name]=entry;}
    for entry in LLM_COG.functional_records(){out[entry.name]=entry;}
    for entry in TRANSFORM.functional_records(){out[entry.name]=entry;}
    for entry in GROUP_TOTALS.functional_records(){out[entry.name]=entry;}
    for entry in PROFILE.functional_records(){out[entry.name]=entry;}
    for entry in KEY_QUALITY.functional_records(){out[entry.name]=entry;}
    for entry in TRANSPOSE.functional_records(){out[entry.name]=entry;}
    for entry in LOOKUP.functional_records(){out[entry.name]=entry;}
    for entry in UNPIVOT.functional_records(){out[entry.name]=entry;}
    for entry in CSVTOOLS.functional_records(){out[entry.name]=entry;}
    for entry in APPEND.functional_records(){out[entry.name]=entry;}
    for entry in ORDER.functional_records(){out[entry.name]=entry;}
    for entry in TABLE.functional_records(){out[entry.name]=entry;}
    for entry in COMPARISON.functional_records(){out[entry.name]=entry;}
    for entry in agent_assistance.functional_records(){out[entry.name]=entry;}
    for entry in agent_budget.functional_records(){out[entry.name]=entry;}
    for entry in sensory.functional_records(){out[entry.name]=entry;}
    for entry in research.functional_records(){out[entry.name]=entry;}
    for entry in modularity.functional_records(){out[entry.name]=entry;}
    for entry in nfc.functional_records(){out[entry.name]=entry;}
    for entry in inputs.functional_records(){out[entry.name]=entry;}
    let live_entries=connectivity_live.functional_records();
    for i len(live_entries){out[live_entries[i].name]=live_entries[i];}
    let connectivity_entries=connectivity.functional_records();
    for i len(connectivity_entries){out[connectivity_entries[i].name]=connectivity_entries[i];}
    let archive_entries = ARCHIVE_TOOLS.functional_records();
    for i len(archive_entries) { out[archive_entries[i].name] = archive_entries[i]; }
    let entries = _verified();
    for i len(entries) { out[entries[i].name] = entries[i]; }
    let native_desktop_device = DESKTOP_DEVICE_TOOLS.functional_records();
    for i len(native_desktop_device) { out[native_desktop_device[i].name] = native_desktop_device[i]; }
    let native_computer_use = COMPUTER_USE_TOOLS.functional_records();
    for i len(native_computer_use) { out[native_computer_use[i].name] = native_computer_use[i]; }
    let native_knowledge = KNOWLEDGE_TOOLS.functional_records();
    for i len(native_knowledge) { out[native_knowledge[i].name] = native_knowledge[i]; }
    let native_documentation = DOCUMENTATION_TOOLS.functional_records();
    for i len(native_documentation) { out[native_documentation[i].name] = native_documentation[i]; }
    let native_mcp = MCP_TOOLS.functional_records();
    for i len(native_mcp) { out[native_mcp[i].name] = native_mcp[i]; }
    _verified_cache = out;
    _verified_ready = true;
    return _verified_cache;
}

fn classify(name, routed = false) {
    let verified = _verified_map();
    if map_has(verified, name) {
        if (name == "identity_bootstrap" or name == "identity_self" or
            name == "identity_status" or name == "user_create" or name == "user_get" or
            name == "user_update" or name == "user_status_set" or name == "system_admin_set" or
            name == "user_list" or
            name == "organization_create" or name == "organization_get" or
            name == "organization_update" or name == "organization_status_set" or
            name == "organization_list" or
            name == "organization_metrics" or name == "organization_members" or name == "organization_member_set" or
            name == "organization_member_remove" or name == "organization_authorize" or
            name == "identity_credential_create" or name == "identity_credential_list" or
            name == "identity_credential_revoke") and platform() != "linux" {
            return map{
                name: name, status: "blocked", input_schema: verified[name].input_schema,
                evidence_ids: ["policy:private-identity-mode-verification-backend-pending"],
                public_mcp: false,
                reason: "private IAM persistence requires descriptor-held mode 0700/0600 verification, currently complete on Linux only"
            };
        }
        if name == "compress_gzip_base64" and platform() != "linux" {
            return map{
                name: name, status: "complete",
                input_schema: _object(map{
                    text: _string(map{ minLength: 1, maxLength: 262144 })
                }, ["text"]),
                evidence_ids: verified[name].evidence_ids,
                public_mcp: true,
                reason: "complete portable text compression; descriptor-confined input_path is exposed only on Linux"
            };
        }
        if (name == "read_file" or name == "read_file_tail" or name == "wait_for_path" or
            name == "list_files" or name == "find_files" or name == "find_files_by_name" or
            name == "grep_code" or name == "extract_snippets_from_file" or
            name == "grep_snippets" or name == "json_validate_file" or
            name == "ide_find_references" or name == "ide_goto_definition" or
            name == "pblang_format_preview" or name == "pblang_source_diagnostics" or
            name == "vscode_get_diagnostics" or name == "zed_get_diagnostics" or
            name == "ide_format_document" or name == "ide_run_test" or
            name == "project_cargo_check" or name == "project_cargo_test" or
            name == "project_pytest" or name == "project_pblang_test" or
            name == "image_info" or name == "audio_info" or name == "audio_convert" or
            name == "audio_extract_from_video" or name == "audio_extract_segment" or
            name == "audio_merge" or name == "audio_mix" or name == "audio_normalize" or
            name == "audio_reverse" or name == "audio_silence_detect" or name == "audio_speed" or
            name == "audio_split" or name == "audio_trim" or name == "audio_volume" or
            name == "audio_waveform" or name == "media_info" or
            name == "image_extract_exif" or name == "image_resize" or name == "image_convert" or
            name == "image_grayscale" or name == "image_crop" or name == "image_rotate" or
            name == "image_flip" or name == "image_thumbnail" or name == "image_histogram" or
            name == "image_compare" or name == "image_watermark" or name == "db_json_query" or
            name == "screenshot_capture" or name == "screenshot_region" or
            name == "screenshot_window" or name == "screenshot_monitor_info" or
            name == "screenshot_color_pick" or name == "screenshot_compare" or
            name == "screenshot_annotate" or name == "screenshot_ocr" or
            name == "screenshot_record" or name == "screenshot_timelapse" or
            name == "convert_binary_hexdump" or name == "convert_archive_list" or
            name == "re_binary_info" or name == "re_hexdump" or name == "re_entropy" or
            name == "re_strings" or name == "re_pattern_search" or name == "re_diff_binary" or
            name == "re_carve" or
            name == "re_struct_parse" or name == "re_strace" or
            name == "identity_bootstrap" or name == "identity_self" or
            name == "identity_status" or name == "user_create" or name == "user_get" or
            name == "user_update" or name == "user_status_set" or name == "system_admin_set" or
            name == "user_list" or
            name == "organization_create" or name == "organization_get" or
            name == "organization_update" or name == "organization_status_set" or
            name == "organization_list" or name == "organization_metrics" or name == "organization_members" or
            name == "organization_member_set" or name == "organization_member_remove" or
            name == "organization_authorize" or
            name == "history_bus_replay" or name == "history_tool_calls" or
            name == "history_search_past_calls" or name == "history_diff_timeline" or
            name == "consensus_propose" or name == "consensus_vote" or
            name == "consensus_tally" or name == "consensus_list" or
            name == "consensus_close" or name == "thinking_session_append" or
            name == "thinking_session_read" or name == "workspace_temp_write" or
            name == "workspace_temp_read" or name == "workspace_temp_list" or
            name == "workspace_temp_delete") and
            platform() != "linux" and platform() != "macos" {
            return map{
                name: name, status: "blocked", input_schema: verified[name].input_schema,
                evidence_ids: ["policy:non-linux-directory-handle-backend-pending"],
                public_mcp: false,
                reason: "race-resistant bounded project reads require the Linux or macOS directory-handle backend"
            };
        }
        if (name == "ocr_file" or name == "ocr_tesseract" or name == "ocr_with_confidence" or
            name == "ocr_table" or name == "ocr_detect_text_regions" or name == "ocr_batch" or
            name == "ocr_list_languages" or name == "ocr_from_clipboard" or
            name == "ocr_screen_region" or name == "ocr_pdf") and platform() != "linux" {
            return map{
                name: name, status: "blocked", input_schema: verified[name].input_schema,
                evidence_ids: ["policy:non-linux-bounded-process-backend-pending"],
                public_mcp: false,
                reason: "descriptor-held bounded OCR adapters currently require the Linux process backend"
            };
        }
        return verified[name];
    }
    if not _blocked_ready { _blocked_cache = _blocked_names(); _blocked_ready = true; }
    if map_has(_blocked_cache, name) {
        return map{
            name: name, status: "blocked", input_schema: _object(map{}, [], true),
            evidence_ids: ["policy:privileged-effect-default-deny"], public_mcp: false,
            reason: "privileged or destructive effect is disabled on the public MCP surface"
        };
    }
    if not _plan_ready { _plan_cache = _plan_only_names(); _plan_ready = true; }
    if map_has(_plan_cache, name) {
        return map{
            name: name, status: "plan-only", input_schema: _object(map{}, [], true),
            evidence_ids: ["source:explicit-plan-handler"], public_mcp: true,
            reason: "validates input or returns a bounded plan; advertised external effect is not executed"
        };
    }
    return map{
        name: name, status: "missing", input_schema: _object(map{}, [], false),
        evidence_ids: [], public_mcp: false,
        reason: if routed { "route exists but functional behavior has not been verified" }
                else { "no native PBLang route" }
    };
}

fn _same_type(value, wanted) {
    if wanted == "integer" { return type(value) == "number" and num_floor(value) == value; }
    if wanted == "object" { return type(value) == "map"; }
    if wanted == "boolean" { return type(value) == "bool"; }
    return type(value) == wanted;
}

fn _validate_value(value, schema, path) {
    let wanted = try schema.type catch nil;
    if wanted != nil and not _same_type(value, wanted) {
        return map{ ok: false, error: path + " must be " + wanted };
    }
    if wanted == "string" {
        if map_has(schema, "minLength") and len(value) < schema.minLength { return map{ ok: false, error: path + " is too short" }; }
        if map_has(schema, "maxLength") and len(value) > schema.maxLength { return map{ ok: false, error: path + " exceeds maxLength" }; }
        if map_has(schema, "pattern") {
            let matched = try regex_match(value, schema.pattern) catch nil;
            if matched == nil { return map{ ok: false, error: path + " has an invalid schema pattern" }; }
            if not matched { return map{ ok: false, error: path + " does not match required pattern" }; }
        }
        if (try schema.format catch "") == "project-relative-path" {
            let normalized = try SECURITY.safe_rel_path(value, "") catch nil;
            if normalized == nil or normalized == "" {
                return map{ ok: false, error: path + " must be a project-relative path without traversal" };
            }
        }
    }
    if wanted == "number" or wanted == "integer" {
        let numeric_text = str_lower(str(value));
        if numeric_text == "nan" or numeric_text == "+nan" or numeric_text == "-nan" or
           numeric_text == "inf" or numeric_text == "+inf" or numeric_text == "-inf" or
           numeric_text == "infinity" or numeric_text == "+infinity" or numeric_text == "-infinity" {
            return map{ ok: false, error: path + " must be finite" };
        }
        if map_has(schema, "minimum") and value < schema.minimum { return map{ ok: false, error: path + " is below minimum" }; }
        if map_has(schema, "maximum") and value > schema.maximum { return map{ ok: false, error: path + " exceeds maximum" }; }
    }
    let choices = try schema.enum catch nil;
    if choices != nil {
        let found = false;
        for i len(choices) { if value == choices[i] { found = true; } }
        if not found { return map{ ok: false, error: path + " is not an allowed enum value" }; }
    }
    if wanted == "array" {
        if map_has(schema, "minItems") and len(value) < schema.minItems { return map{ ok: false, error: path + " has too few items" }; }
        if map_has(schema, "maxItems") and len(value) > schema.maxItems { return map{ ok: false, error: path + " has too many items" }; }
        if try schema.uniqueItems catch false {
            for i len(value) { for j i {
                if value[i] == value[j] { return map{ ok: false, error: path + " must contain unique items" }; }
            } }
        }
        let item_schema = try schema.items catch map{};
        for i len(value) {
            let checked = _validate_value(value[i], item_schema, path + "[" + str(i) + "]");
            if not checked.ok { return checked; }
        }
    }
    if wanted == "object" {
        let props = try schema.properties catch map{};
        let required = try schema.required catch [];
        let keys = map_keys(value);
        if map_has(schema, "maxProperties") and len(keys) > schema.maxProperties {
            return map{ ok: false, error: path + " has too many properties" };
        }
        if map_has(schema, "propertyNames") {
            for ki len(keys) {
                let key_checked = _validate_value(str(keys[ki]), schema.propertyNames, path + " property name");
                if not key_checked.ok { return key_checked; }
            }
        }
        for i len(required) {
            if not map_has(value, required[i]) { return map{ ok: false, error: path + "." + required[i] + " is required" }; }
        }
        let at_most_one = try schema.atMostOne catch nil;
        if at_most_one != nil {
            let present = 0;
            for at_index len(at_most_one) {
                if map_has(value, at_most_one[at_index]) { present = present + 1; }
            }
            if present > 1 { return map{ ok: false, error: path + " contains mutually exclusive properties" }; }
        }
        let exclusive_groups = try schema.mutuallyExclusiveGroups catch nil;
        if exclusive_groups != nil {
            for gi len(exclusive_groups) {
                let present = 0;
                for gj len(exclusive_groups[gi]) {
                    if map_has(value, exclusive_groups[gi][gj]) { present = present + 1; }
                }
                if present > 1 {
                    return map{ ok: false, error: path + " contains mutually exclusive properties" };
                }
            }
        }
        for i len(keys) {
            let key = keys[i];
            if map_has(props, key) {
                let checked = _validate_value(value[key], props[key], path + "." + key);
                if not checked.ok { return checked; }
            } else {
                let additional = try schema.additionalProperties catch true;
                if type(additional) == "bool" and not additional {
                    return map{ ok: false, error: path + "." + key + " is not allowed" };
                }
                if type(additional) == "map" {
                    let checked = _validate_value(value[key], additional, path + "." + key);
                    if not checked.ok { return checked; }
                }
            }
        }
    }
    let alternatives = try schema.oneOf catch nil;
    if alternatives != nil {
        let matches = 0;
        for i len(alternatives) {
            let candidate = _validate_value(value, alternatives[i], path);
            if candidate.ok { matches = matches + 1; }
        }
        if matches != 1 {
            return map{ ok: false, error: path + " must match exactly one oneOf alternative" };
        }
    }
    return map{ ok: true };
}

fn validate_arguments(name, args) {
    let record = classify(name, true);
    if record.status == "blocked" or record.status == "missing" {
        return map{ ok: false, status: record.status, error: record.reason };
    }
    let checked = _validate_value(args, record.input_schema, "arguments");
    if (name=="pblang_runtime_status" or name=="pblang_machine_code_plan" or name=="pblang_product_health" or name=="pblang_execution_plan") and not checked.ok {checked.error="Invalid runtime status arguments";}
    if (name=="pblang_resource_budget" or name=="pblang_resilience_policy") and not checked.ok {checked.error="Invalid runtime policy arguments";}
    if (name=="mcp_catalog_snapshot_review" or name=="mcp_catalog_changes_review" or name=="mcp_client_acceptance_review" or name=="diagnostics_compare" or name=="ai_acceptance_check" or name=="text_edit_preview" or str_starts_with(name,"ai_memory_") or name=="ai_embed_features" or name=="ai_rag_context" or name=="ai_skill_inspect" or name=="ai_workflow_check" or name=="ai_evidence_check" or name=="ai_turn_budget") and not checked.ok {
        checked.error="Invalid agent tool arguments";
    }
    if (name=="data_table_duplicate_groups" or name=="data_table_group_counts") and not checked.ok {checked.error="Invalid table grouping arguments";}
    if (name=="data_table_sort_rows" or name=="data_table_group_integer_stats") and not checked.ok {checked.error="Invalid table ordering or integer aggregation arguments";}
    if (name=="data_table_quality" or name=="data_table_select_rows") and not checked.ok {checked.error="Invalid table arguments";}
    if (name=="data_compare_json" or name=="data_compare_numeric") and not checked.ok {checked.error="Invalid comparison arguments";}
    if name == "sensory_series_review" and not checked.ok { checked.error="Invalid sensory series arguments"; }
    if name == "research_windows_review" and not checked.ok {
        checked.error = "Invalid research review arguments";
    }
    if name=="data_table_project_columns" and not checked.ok {checked.error="Invalid named column projection arguments";}
    if name=="data_table_append_rows" and not checked.ok {checked.error="Invalid table append arguments";}
    if name=="data_table_from_csv" and not checked.ok {checked.error="Invalid literal CSV import arguments";}
    if name=="data_table_unpivot" and not checked.ok {checked.error="Invalid table unpivot arguments";}
    if name=="data_table_lookup" and not checked.ok {checked.error="Invalid table lookup arguments";}
    if name=="data_table_transpose" and not checked.ok {checked.error="Invalid table transpose arguments";}
    if name=="data_table_key_quality" and not checked.ok {checked.error="Invalid table key quality arguments";}
    if name=="data_table_profile" and not checked.ok {checked.error="Invalid table profile arguments";}
    if name=="browser_document_review" and not checked.ok {checked.error="Invalid browser document review arguments";}
    if name=="data_table_transform" and not checked.ok {checked.error="Invalid table transform arguments";}
    if name=="data_table_group_totals" and not checked.ok {checked.error="Invalid table group totals arguments";}
    checked.status = record.status;
    return checked;
}

fn summarize(names, routed_names) {
    let routed = map{};
    for i len(routed_names) { routed[routed_names[i]] = true; }
    let counts = map{ complete: 0, "plan-only": 0, blocked: 0, missing: 0 };
    let records = [];
    for i len(names) {
        let record = classify(names[i], try routed[names[i]] catch false);
        counts[record.status] = counts[record.status] + 1;
        records[len(records)] = record;
    }
    let total = len(names);
    return map{
        format: "pb_mcp.functional_registry.v1",
        total: total, counts: counts,
        classification_coverage_percent: if total == 0 { 100 } else { 100 },
        functional_completion_percent: if total == 0 { 0 } else { counts.complete * 100 / total },
        production_ready: counts["plan-only"] == 0 and counts.blocked == 0 and counts.missing == 0,
        records: records
    };
}

fn states() { return STATES; }

export classify, validate_arguments, summarize, states;
