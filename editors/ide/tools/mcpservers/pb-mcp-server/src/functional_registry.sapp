let MCP_TOOLS = import("mcp_tools.sapp");
let KNOWLEDGE_TOOLS = import("knowledge_compute_tools.sapp");
let DOCUMENTATION_TOOLS = import("documentation_tools.sapp");

let STATES = ["complete", "plan-only", "blocked", "missing"];

fn _string(options = nil) {
    let out = map{ type: "string" };
    if options != nil {
        if map_has(options, "minLength") { out.minLength = options.minLength; }
        if map_has(options, "maxLength") { out.maxLength = options.maxLength; }
        if map_has(options, "enum") { out.enum = options.enum; }
        if map_has(options, "pattern") { out.pattern = options.pattern; }
        if map_has(options, "format") { out.format = options.format; }
    }
    return out;
}

fn _number(options = nil) {
    let out = map{ type: "number" };
    if options != nil {
        if map_has(options, "minimum") { out.minimum = options.minimum; }
        if map_has(options, "maximum") { out.maximum = options.maximum; }
        if map_has(options, "enum") { out.enum = options.enum; }
    }
    return out;
}

fn _integer(options = nil) {
    let out = _number(options);
    out.type = "integer";
    return out;
}

fn _boolean(options = nil) {
    let out = map{ type: "boolean" };
    if options != nil and map_has(options, "enum") { out.enum = options.enum; }
    return out;
}

fn _array(items, options = nil) {
    let out = map{ type: "array", items: items };
    if options != nil {
        if map_has(options, "minItems") { out.minItems = options.minItems; }
        if map_has(options, "maxItems") { out.maxItems = options.maxItems; }
        if map_has(options, "uniqueItems") { out.uniqueItems = options.uniqueItems; }
    }
    return out;
}

fn _object(properties, required = nil, additional = false) {
    return map{
        type: "object",
        properties: properties,
        required: if required == nil { [] } else { required },
        additionalProperties: additional
    };
}

fn _app_named_manifest_entry_schema() {
    return _at_most_one(_object(map{
        name: _string(map{ minLength: 1, maxLength: 128 }),
        id: _string(map{ minLength: 1, maxLength: 128 }),
        description: _string(map{ maxLength: 4096 })
    }), ["name", "id"]);
}

fn _app_plugin_manifest_schema() {
    return _object(map{
        name: _string(map{ minLength: 1, maxLength: 128 }),
        version: _string(map{ maxLength: 64 }),
        description: _string(map{ maxLength: 4096 }),
        tools: _array(_app_named_manifest_entry_schema(), map{ maxItems: 256 }),
        skills: _array(_app_named_manifest_entry_schema(), map{ maxItems: 256 }),
        commands: _array(_app_named_manifest_entry_schema(), map{ maxItems: 256 }),
        hooks: _array(map{}, map{ maxItems: 256 }),
        permissions: _object(map{}, [], true)
    });
}

fn _app_skill_manifest_schema() {
    return _mutually_exclusive(_object(map{
        name: _string(map{ minLength: 1, maxLength: 128 }),
        description: _string(map{ maxLength: 4096 }),
        instructions: map{ oneOf: [
            _string(map{ minLength: 1, maxLength: 100000 }),
            _array(_string(map{ minLength: 1, maxLength: 4096 }), map{ minItems: 1, maxItems: 200 })
        ] },
        body: map{ oneOf: [
            _string(map{ minLength: 1, maxLength: 100000 }),
            _array(_string(map{ minLength: 1, maxLength: 4096 }), map{ minItems: 1, maxItems: 200 })
        ] },
        tools: _array(_string(map{ minLength: 1, maxLength: 128 }), map{ maxItems: 128 }),
        triggers: _array(_string(map{ minLength: 1, maxLength: 256 }), map{ maxItems: 128 })
    }), [["instructions", "body"]]);
}

fn _app_skill_document_schema() {
    return _object(map{
        document: _string(map{ minLength: 1, maxLength: 131072 }),
        directory_name: _string(map{ maxLength: 64,
            pattern: "^[a-z0-9]+(-[a-z0-9]+)*$" })
    }, ["document"]);
}

fn _app_portable_skill_manifest_schema() {
    return _object(map{
        name: _string(map{ minLength: 1, maxLength: 64,
            pattern: "^[a-z0-9]+(-[a-z0-9]+)*$" }),
        description: _string(map{ minLength: 1, maxLength: 1024 }),
        license: _string(map{ maxLength: 256 }),
        compatibility: _string(map{ maxLength: 500 }),
        metadata: _object(map{}, [], true),
        "allowed-tools": map{ oneOf: [
            _string(map{ maxLength: 65536 }),
            _array(_string(map{ minLength: 1, maxLength: 512 }), map{ maxItems: 128 })
        ] }
    }, ["name", "description"]);
}

fn _app_manifest_input_schema(manifest_schema) {
    let properties = map{}; let groups = [];
    let source = manifest_schema.properties; let keys = map_keys(source);
    for i len(keys) {
        properties[keys[i]] = source[keys[i]];
        groups[len(groups)] = ["manifest", keys[i]];
    }
    properties.manifest = manifest_schema;
    return _mutually_exclusive(_object(properties), groups);
}

fn _exactly_one_required(schema, names) {
    let choices = [];
    for i len(names) {
        choices[len(choices)] = _object(map{}, [names[i]], true);
    }
    schema.oneOf = choices;
    return schema;
}

fn _exactly_one_required_set(schema, sets) {
    let choices = [];
    for i len(sets) { choices[len(choices)] = _object(map{}, sets[i], true); }
    schema.oneOf = choices;
    return schema;
}

fn _at_most_one(schema, names) {
    schema.atMostOne = names;
    return schema;
}

fn _mutually_exclusive(schema, groups) {
    // Older registry declarations used both ["a","b"] and [["a","b"]].
    // Normalize the shorthand so validation and emitted schemas agree.
    if type(groups) == "array" and len(groups) > 0 and type(groups[0]) == "string" {
        schema.mutuallyExclusiveGroups = [groups];
    } else { schema.mutuallyExclusiveGroups = groups; }
    return schema;
}

fn _terminal_program_schema(extra = nil) {
    let props = map{
        program: _string(map{ minLength: 1, maxLength: 255, pattern: "^[A-Za-z0-9_.-]+$" }),
        name: _string(map{ minLength: 1, maxLength: 255, pattern: "^[A-Za-z0-9_.-]+$" })
    };
    if extra != nil {
        let keys = map_keys(extra);
        for i len(keys) { props[keys[i]] = extra[keys[i]]; }
    }
    return _exactly_one_required(_object(props), ["program", "name"]);
}

fn _terminal_run_schema(with_stdin = false) {
    let props = map{
        program: _string(map{ minLength: 1, maxLength: 255, pattern: "^[A-Za-z0-9_.-]+$" }),
        cmd: _string(map{ minLength: 1, maxLength: 255, pattern: "^[A-Za-z0-9_.-]+$" }),
        argv: _array(_string(map{ maxLength: 4096 }), map{ maxItems: 100 }),
        args: _array(_string(map{ maxLength: 4096 }), map{ maxItems: 100 }),
        cwd: _string(map{ minLength: 1, maxLength: 4096 }),
        timeout_ms: _integer(map{ minimum: 1, maximum: 120000 }),
        max_output_bytes: _integer(map{ minimum: 1, maximum: 120000 }),
        max_chars: _integer(map{ minimum: 1, maximum: 120000 })
    };
    let schema = _object(props);
    if with_stdin {
        props.stdin_text = _string(map{ maxLength: 524288 });
        props.stdin_path = _string(map{ minLength: 1, maxLength: 4096 });
        schema = _exactly_one_required_set(schema, [
            ["program", "stdin_text"], ["program", "stdin_path"],
            ["cmd", "stdin_text"], ["cmd", "stdin_path"]
        ]);
    } else {
        schema = _exactly_one_required(schema, ["program", "cmd"]);
    }
    return _mutually_exclusive(schema, [
        ["program", "cmd"], ["argv", "args"], ["max_output_bytes", "max_chars"],
        ["stdin_text", "stdin_path"]
    ]);
}

fn _terminal_list_schema() {
    return _at_most_one(_object(map{
        cwd: _string(map{ minLength: 1, maxLength: 4096 }),
        limit: _integer(map{ minimum: 1, maximum: 100 }),
        max_output_bytes: _integer(map{ minimum: 1, maximum: 120000 }),
        max_chars: _integer(map{ minimum: 1, maximum: 120000 })
    }), ["max_output_bytes", "max_chars"]);
}

fn _terminal_view_schema(first, second) {
    let schema = _object(map{
        cwd: _string(map{ minLength: 1, maxLength: 4096 }),
        max_output_bytes: _integer(map{ minimum: 1, maximum: 120000 }),
        max_chars: _integer(map{ minimum: 1, maximum: 120000 })
    });
    schema.properties[first] = _integer(map{ minimum: 1, maximum: 1000000 });
    schema.properties[second] = _integer(map{ minimum: 1, maximum: 1000000 });
    schema = _exactly_one_required(schema, [first, second]);
    return _mutually_exclusive(schema, [[first, second], ["max_output_bytes", "max_chars"]]);
}

fn _git_schema(properties = nil, required = nil) {
    let props = map{
        cwd: _string(map{ minLength: 1, maxLength: 4096 }),
        directory: _string(map{ maxLength: 4096 }),
        path: _string(map{ maxLength: 4096 }),
        max_output_bytes: _integer(map{ minimum: 1, maximum: 120000 }),
        max_chars: _integer(map{ minimum: 1, maximum: 120000 })
    };
    if properties != nil {
        let keys = map_keys(properties);
        for i len(keys) { props[keys[i]] = properties[keys[i]]; }
    }
    return _mutually_exclusive(_object(props, required), [
        ["cwd", "directory", "path"], ["max_output_bytes", "max_chars"]
    ]);
}

fn _git_complete(name, schema, evidence = nil) {
    let ids = ["pb_mcp_git_readonly:bounded_clean_executor",
        "pb_mcp_git_readonly:environment_poisoning",
        "pb_mcp_git_readonly:literal_argv"];
    if evidence != nil { array_push(ids, evidence); }
    return _complete_private(name, schema, ids,
        "complete local read-only Git operation; repository metadata remains absent from public MCP discovery");
}

fn _adjacency_graph() {
    let out = _object(map{}, [], _array(
        _string(map{ maxLength: 256 }), map{ maxItems: 256 }
    ));
    out.maxProperties = 256;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 256 });
    return out;
}

fn _weighted_adjacency_graph() {
    let edges = _object(map{}, [], _number(map{ minimum: 0, maximum: 1000000000000 }));
    edges.maxProperties = 256;
    edges.propertyNames = _string(map{ minLength: 1, maxLength: 256 });
    let out = _object(map{}, [], edges);
    out.maxProperties = 256;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 256 });
    return out;
}

fn _numeric_matrix() {
    return _array(
        _array(_number(map{ minimum: -1000000000, maximum: 1000000000 }),
            map{ minItems: 1, maxItems: 64 }),
        map{ minItems: 1, maxItems: 64 }
    );
}

fn _network_header_map() {
    let out = _object(map{}, [], _string(map{ maxLength: 4096 }));
    out.maxProperties = 32;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 128 });
    return out;
}

fn _bounded_property_map(maximum) {
    let out = _object(map{}, [], true);
    out.maxProperties = maximum;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 256 });
    return out;
}

fn _bounded_string_map(maximum, value_maximum) {
    let out = _object(map{}, [], _string(map{ maxLength: value_maximum }));
    out.maxProperties = maximum;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 256 });
    return out;
}

fn _sha256_manifest_schema() {
    let out = _object(map{}, [], _string(map{ pattern: "^[0-9A-Fa-f]{64}$" }));
    out.maxProperties = 1000;
    out.propertyNames = _string(map{ minLength: 1, maxLength: 4096 });
    return out;
}

fn _workflow_node_schema() {
    return _exactly_one_required(_mutually_exclusive(_object(map{
        id: _string(map{ minLength: 1, maxLength: 256 }),
        name: _string(map{ minLength: 1, maxLength: 256 }),
        type: _string(map{ maxLength: 256 }),
        purpose: _string(map{ maxLength: 4096 })
    }, [], true), [["id", "name"]]), ["id", "name"]);
}

fn _workflow_edge_schema() {
    return _exactly_one_required_set(_mutually_exclusive(_object(map{
        from: _string(map{ minLength: 1, maxLength: 256 }),
        to: _string(map{ minLength: 1, maxLength: 256 }),
        source: _string(map{ minLength: 1, maxLength: 256 }),
        target: _string(map{ minLength: 1, maxLength: 256 })
    }), [["from", "source"], ["to", "target"]]), [
        ["from", "to"], ["source", "target"]
    ]);
}

fn _workflow_schema() {
    return _object(map{
        nodes: _array(_workflow_node_schema(), map{ maxItems: 1000 }),
        connections: _array(_workflow_edge_schema(), map{ maxItems: 10000 })
    }, ["nodes"]);
}

fn _project_audit_record() {
    return _object(map{
        path: _string(map{ maxLength: 4096 }),
        text: _string(map{ maxLength: 200000 })
    });
}

fn _chart_number() {
    return _number(map{ minimum: -1000000000000, maximum: 1000000000000 });
}

fn _chart_common(properties = nil) {
    let props = map{
        title: _string(map{ maxLength: 256 }),
        width: _integer(map{ minimum: 320, maximum: 2400 }),
        height: _integer(map{ minimum: 200, maximum: 1600 })
    };
    if properties != nil {
        let keys = map_keys(properties);
        for i len(keys) { props[keys[i]] = properties[keys[i]]; }
    }
    return props;
}

fn _chart_label_value() {
    return _object(map{
        label: _string(map{ maxLength: 256 }), value: _chart_number()
    }, ["label", "value"]);
}

fn _chart_point(with_label = false) {
    let props = map{ x: _chart_number(), y: _chart_number() };
    if with_label { props.label = _string(map{ maxLength: 64 }); }
    return _object(props, ["x", "y"]);
}

fn _chart_series() {
    return _object(map{
        label: _string(map{ maxLength: 256 }),
        values: _array(_chart_point(false), map{ minItems: 1, maxItems: 5000 })
    }, ["values"]);
}

fn _chart_time_value() {
    return _object(map{
        timestamp: _string(map{ minLength: 1, maxLength: 64 }), value: _chart_number()
    }, ["timestamp", "value"]);
}

fn _chart_time() {
    return map{ oneOf: [
        _string(map{ minLength: 1, maxLength: 256 }), _chart_number()
    ] };
}

fn _chart_edge() {
    return _object(map{
        from: _string(map{ minLength: 1, maxLength: 256 }),
        to: _string(map{ minLength: 1, maxLength: 256 }),
        label: _string(map{ maxLength: 256 })
    }, ["from", "to"]);
}

fn _chart_task() {
    let schema = _object(map{
        name: _string(map{ minLength: 1, maxLength: 256 }),
        start_time: _chart_time(), end_time: _chart_time(),
        start: _chart_time(), end: _chart_time(),
        color: _string(map{ pattern: "^#[0-9A-Fa-f]{6}$" })
    }, ["name"]);
    return _exactly_one_required_set(_mutually_exclusive(schema, [
        ["start_time", "start"], ["end_time", "end"]
    ]), [
        ["name", "start_time", "end_time"], ["name", "start_time", "end"],
        ["name", "start", "end_time"], ["name", "start", "end"]
    ]);
}

fn _log_path_props(extra = nil) {
    let props = map{
        path: _string(map{ minLength: 1, maxLength: 4096, format: "project-relative-path" }),
        file: _string(map{ minLength: 1, maxLength: 4096, format: "project-relative-path" }),
        max_chars: _integer(map{ minimum: 1, maximum: 200000 })
    };
    if extra != nil {
        let keys = map_keys(extra);
        for i len(keys) { props[keys[i]] = extra[keys[i]]; }
    }
    return props;
}

fn _log_path_schema(extra = nil) {
    return _exactly_one_required(_object(_log_path_props(extra)), ["path", "file"]);
}

fn _log_filter_map() {
