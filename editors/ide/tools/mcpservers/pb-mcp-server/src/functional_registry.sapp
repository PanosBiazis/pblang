// Canonical functional-completion and MCP schema registry.
//
// Routing is not implementation. Every catalog entry receives exactly one
// fail-closed state: complete, plan-only, blocked, or missing. A complete entry
// must carry an exact schema and test evidence. Unknown entries are missing.

let ARCHIVE_TOOLS = import("archive_tools.sapp");
let WEB_TOOLS = import("web_tools.sapp");
let MEDIA_TOOLS = import("media_tools.sapp");
let NET_IOT_TOOLS = import("net_iot_tools.sapp");
