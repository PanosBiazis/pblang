fn _agent_id_schema() {
    return _string(map{ minLength: 1, maxLength: 128, pattern: "^[A-Za-z0-9_.-]+$" });
}

fn _agent_body_alias_schema(extra, required) {
    let props = map{
        from_agent: _agent_id_schema(),
        message: _string(map{ minLength: 1, maxLength: 24000 }),
        body: _string(map{ minLength: 1, maxLength: 24000 }),
        to_agent: _agent_id_schema(),
        topic: _string(map{ minLength: 1, maxLength: 120 }),
        kind: _string(map{ minLength: 1, maxLength: 24, pattern: "^[A-Za-z0-9_]+$" })
    };
    if extra != nil {
        let keys = map_keys(extra);
        for i len(keys) { props[keys[i]] = extra[keys[i]]; }
    }
    return _mutually_exclusive(_exactly_one_required(_object(props, required),
        ["message", "body"]), [["message", "body"]]);
}

fn _agent_pipeline_step_schema() {
    return _agent_body_alias_schema(nil, []);
}

fn _complete(name, schema, evidence) {
    return map{
        name: name, status: "complete", input_schema: schema,
        evidence_ids: evidence, public_mcp: true,
        reason: "bounded native behavior with schema and regression evidence"
    };
}

fn _complete_private(name, schema, evidence, reason) {
    let out = _complete(name, schema, evidence);
    out.public_mcp = false;
    out.reason = reason;
    return out;
}

fn _text_complete(name, schema) {
    return _complete(name, schema, [
        "pb_mcp_deterministic_text_contract:canonical_behavior",
        "pb_mcp_deterministic_text_contract:exact_resource_bounds",
        "pb_mcp_deterministic_text_contract:deterministic_order"
    ]);
}

fn _text_props(extra = nil) {
    let props = map{
        text: _string(map{ maxLength: 200000 }),
        max_chars: _integer(map{ minimum: 1, maximum: 200000 })
    };
    if extra != nil {
        let keys = map_keys(extra);
        for i len(keys) { props[keys[i]] = extra[keys[i]]; }
    }
    return props;
}

fn _serial_baud_schema() {
    return _integer(map{ enum: [50,75,110,134,150,200,300,600,1200,1800,
        2400,4800,9600,19200,38400,57600,115200,230400,460800,500000,
        576000,921600,1000000,1152000,1500000,2000000,2500000,3000000,
        3500000,4000000] });
}

fn _content_options(properties) { return _object(properties); }
fn _content_source(properties=nil,required_extra=nil) {
    let props=map{
        filename:_string(map{minLength:1,maxLength:255,pattern:"^[^/\\\\]+$"}),
        data_base64:_string(map{maxLength:11184812})
    };
    if properties!=nil { for key in map_keys(properties) { props[key]=properties[key]; } }
    let required=["filename","data_base64"];
    if required_extra!=nil { for key in required_extra { array_push(required,key); } }
    return _object(props,required);
}
fn _content_clean_options() {
    return _content_options(map{
        mode:_string(map{enum:["inspect","conservative","privacy"]}),
        max_findings:_integer(map{minimum:1,maximum:2048}),
        aggressive_confusables:_boolean(),normalize_spaces:_boolean(),
        strip_private_use:_boolean(),strip_emoji_glue:_boolean(),
        pdf_password:_string(map{maxLength:127})
    });
}
fn _content_mask_options() {
    let region=_object(map{x:_integer(map{minimum:0,maximum:4095}),y:_integer(map{minimum:0,maximum:4095}),
        width:_integer(map{minimum:1,maximum:4096}),height:_integer(map{minimum:1,maximum:4096})},
        ["x","y","width","height"]);
    return _content_options(map{
        mode:_string(map{enum:["regions","luminance","color","alpha"]}),region:region,
        regions:_array(region,map{minItems:1,maxItems:64}),minimum:_integer(map{minimum:0,maximum:255}),
        maximum:_integer(map{minimum:0,maximum:255}),color:_array(_integer(map{minimum:0,maximum:255}),map{minItems:3,maxItems:3}),
        tolerance:_integer(map{minimum:0,maximum:255}),dilate_radius:_integer(map{minimum:0,maximum:4}),
        max_pixels:_integer(map{minimum:1,maximum:4194304}),max_mask_fraction:_number(map{minimum:0,maximum:0.9})
    });
}
fn _content_inpaint_options() {
    return _content_options(map{threshold:_integer(map{minimum:0,maximum:255}),
        max_pixels:_integer(map{minimum:1,maximum:4194304}),max_iterations:_integer(map{minimum:1,maximum:8192}),
        max_mask_fraction:_number(map{minimum:0,maximum:0.9})});
}
fn _content_private(name,schema,evidence) {
    return _complete_private(name,schema,evidence,
        "private authenticated in-memory content processing; payloads and credentials are never public MCP data");
}

fn _verified() {
    return [
        _complete("content_signal_capabilities",_object(map{}),[
            "pb_mcp_content_signal:capability_contract","pb_mcp_content_signal:no_effects"
        ]),
        _content_private("content_signal_inspect",_content_source(map{options:_content_clean_options()}),[
            "pb_mcp_content_signal:bounded_inspection","pb_mcp_content_signal:credential_redaction"
