export implemented_tools, call_ai,
       ai_zero_shot_classify, ai_few_shot_classify, ai_semantic_search,
       ai_cluster_texts, ai_embed_text, ai_structured_extract,
       ai_verify_factual, ai_rewrite_style, ai_self_critique,
       ai_chain_of_thought, ai_debate, ai_multi_model_compare,
