                },
                standalone_repository: map{
                    repo_path: "products/pbai",
                    sapp_modules: 309,
                    role: "Sovereign multi-tier LLM stack (Nano -> Mini -> Pro -> Max), cognitive brain loop (pbai_brain.sapp), BPE tokenizer, f8/f16/bf16 quantization, MoE shard streaming, PBRuler immune system, ClamAV/DLP ingestion, and Joint/DEQ trainer",
                    shared_with_embedded: ["stdlib/pbai_dispatch.sapp", "stdlib/pbai_ensemble.sapp", "stdlib/pbai_feedback.sapp", "stdlib/pbai_optimization.sapp"],
                    distinct_from_embedded: ["stdlib/pbai_brain.sapp", "stdlib/pbai_max.sapp", "stdlib/pbai_ruler.sapp", "stdlib/pbai_tool_broker.sapp", "stdlib/pbai_streaming.sapp", "stdlib/pbai_verifier.sapp"]
                }
            },
            pb_mcp_server: map{
                embedded_in_pblang: map{
                    core_bridge: "stdlib/pb_mcp.sapp",
                    ide_server: "editors/ide/tools/mcpservers/pb-mcp-server/main.sapp",
                    role: "In-process 39-tool compiler/watcher/codegraph bridge + 564-tool 100%-Rust-catalog-compatible local IDE MCP server",
                    rust_catalog_coverage_percent: 100
                },
                standalone_repository: map{
                    repo_path: "products/pb-mcp-server",
                    sapp_modules: 1006,
                    version: "0.41.0",
                    role: "Sealed offline capability-gated MCP daemon (148 cryptographically bounded offline tools + 51 LLM/ecosystem truth gates, literal table pipelines, archive/REA/Cleanroom forensics, quarantine & rollback)",
                    shared_with_embedded: ["workspace_context", "read_file", "grep_code", "summarize_top_terms", "text_levenshtein_distance"],
                    distinct_from_embedded: ["148-tool sealed SHA-256 offline release", "tenant role access control", "descriptor-bound SQLite & quarantine rollback", "51 epistemic/topology/dualstack LLM truth gates"]
                }
            },
            pbide: map{
                embedded_in_pblang: map{
                    native_ide: "editors/ide/pbide.sapp",
                    surface_shell: "editors/ide/pbide_surface.sapp",
                    web_zero_js: "editors/ide/pbide_text_web.sapp",
                    product_contract: "stdlib/pbide_product.sapp",
                    role: "Single-binary self-hosted 11-panel graphical IDE, bounded workspace document, and renderer-neutral surface preview"
                },
                standalone_repository: map{
                    repo_path: "products/pbide",
                    role: "Multi-OS (10 OS targets) & Multi-Device (8 form-factor classes) IDE studio orchestrator, DevOps DAG/timing inspector, 20-format UI/Form interchange hub, and 10-edition Polyglot coordinator"
                }
            }
        }
    };
}

fn pbai_polyglot_migrate(args) {
    if args == nil { args = map{}; }
    let lang = str_lower(str(try args.lang catch "python"));
    let code = str(try args.code catch "def compute(items):\n    return [x * 2 for x in items]");
    let PG = _pbai_mod("polyglot", "stdlib:polyglot.sapp");
    let Wave = _pbai_mod("wave", "stdlib:backlog_completion_wave.sapp");
    let supported = PG.is_supported(lang);
    let total_langs = PG.language_count();
    let migration = Wave.manage_polyglot_to_pblang_replacement(map{
        module_name: "pbide_polyglot_block",
        legacy_language: lang,
        legacy_source_code: code
    });
    return map{
        ok: migration.ok,
        source_language: lang,
        language_supported: supported,
        supported_language_count: total_langs,
        sandbox_guarded: true,
        migration: migration
    };
}

fn pbai_supply_chain_and_taint_audit(args) {
    if args == nil { args = map{}; }
    let source = str(try args.source catch "let q = 21;\nlet r = q * 2;\nprint r;");
    let manifest_toml = str(try args.manifest_toml catch "[package]\nname = \"demo_app\"\nversion = \"1.0.0\"\n");
    let Sec = _pbai_mod("sec_analysis", "stdlib:security_analysis.sapp");
    let Manifest = _pbai_mod("manifest_val", "stdlib:manifest_validate.sapp");
    let Safety = _pbai_mod("safety_guard", "stdlib:safety_guard.sapp");
    let PBAI = _pbai_mod("pbai", "stdlib:pbai.sapp");
    let Wave = _pbai_mod("wave", "stdlib:backlog_completion_wave.sapp");
    let taint_report = Sec.analyze(source, "[pbide_buffer]");
    let shield_report = PBAI.assess_prompt(source);
    let conf_report = Wave.enforce_strict_confidentiality_and_redaction(nil);
    let manifest_report = Manifest.validate_manifest_text(manifest_toml);
    let supply_chain = Safety.verify_supply_chain_and_toolchain_security(nil);
    return map{
        ok: taint_report.passed and shield_report.safe and conf_report.ok and manifest_report.ok and supply_chain.ok,
        taint_safe: taint_report.passed,
        taint_findings: taint_report.findings,
        parseltongue_and_prompt_safe: shield_report.safe,
        strict_confidentiality: conf_report.ok,
        manifest_valid: manifest_report.ok,
        supply_chain_safe: supply_chain.ok,
        supply_chain_report: supply_chain
    };
}

fn _embedded_pbai_engine() {
    if map_has(_PBAI_LAZY, "embedded_engine") { return _PBAI_LAZY["embedded_engine"]; }
    let m = try import("../../../ai/pbai_embedded_engine.sapp") catch nil;
    if m == nil { m = import("editors/ide/tools/ai/pbai_embedded_engine.sapp"); }
    _PBAI_LAZY["embedded_engine"] = m;
    return m;
}

