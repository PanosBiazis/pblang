    let res = _eng().evaluate_58family_specialist_and_training_model_team(args);
    return map{
        ok: res.ok,
        engine: "pb_mcp_8stage_multiprincipal_training_team_coordinator_v15",
        training_team_stages_count: res.training_team_stages_count,
        training_team_stages: res.training_team_stages,
        distinct_principals_enforced: res.distinct_principals_enforced,
        trainer_can_access_sealed_test: res.trainer_can_access_sealed_test,
        promotion_authority: res.promotion_authority
    };
}

fn pb_mcp_teacher_student_4tier_distillation_router(args) {
    return _eng().evaluate_teacher_student_family_distillation_router(args);
}

