        routed_student_tier: res.routed_student_tier,
        top_down_kl_distillation_active: res.top_down_kl_distillation_active,
        bottom_up_verified_reverse_distillation_active: res.bottom_up_verified_reverse_distillation_active,
        benchmark_acceptance_gate_enforced: res.benchmark_acceptance_gate_enforced
    };
}

fn pb_mcp_per_submodel_working_episodic_semantic_profiler(args) {
    return _eng().evaluate_per_submodel_brain_inspired_learning_profiles(args);
}

fn pb_mcp_lineage_propagated_forgetting_and_quarantine_guard(args) {
    let res = _eng().evaluate_per_submodel_brain_inspired_learning_profiles(args);
    return map{
        ok: res.ok,
        engine: "pb_mcp_lineage_propagated_forgetting_and_quarantine_guard_v15",
        model_id: res.model_id,
        ordinary_chat_trains_or_persists: res.ordinary_chat_trains_or_persists,
        caller_claims_treated_as_truth: res.caller_claims_treated_as_truth,
        forgetting_lineage_propagation_enforced: res.forgetting_lineage_propagation_enforced,
        immutable_audit_and_rules_erasable: res.immutable_audit_and_rules_erasable
    };
