// Native pblang translations for deterministic convert/data JSON tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let ser = import("stdlib:serialization.sapp");
let sec = import("security.sapp");
let core = import("core_tools.sapp");

fn _input(args) {
    let text = try args.text catch try args.input catch nil;
    if text != nil { return str(text); }
    let path = try args.path catch try args.input_path catch nil;
    if path != nil { return core.read_file(path, nil, nil, sec.MAX_READ_CHARS); }
    return "";
}

fn _maybe_write(args, value) {
    let out = try args.output_path catch nil;
    if out == nil or out == "" { return value; }
    sec.require_trusted("convert output write");
    let path = sec.safe_rel_path(out, "");
    FS.write(path, str(value));
    return map{ output_path: path, chars: len(str(value)), text: value };
}

fn _json_pretty_text(s) {
    let v = JSON.parse(s);
    let min = JSON.stringify(v);
    let out = "";
    let indent = 0;
    let in_string = false;
    for i len(min) {
        let ch = str_slice(min, i, i + 1);
        if ch == "\"" {
            out = out + ch;
            in_string = not in_string;
        } else if in_string {
            out = out + ch;
        } else if ch == "{" or ch == "[" {
            out = out + ch + "\n";
            indent = indent + 1;
            out = out + _spaces(indent * 2);
        } else if ch == "}" or ch == "]" {
            indent = indent - 1;
            if indent < 0 { indent = 0; }
            out = out + "\n" + _spaces(indent * 2) + ch;
        } else if ch == "," {
            out = out + ch + "\n" + _spaces(indent * 2);
        } else if ch == ":" {
            out = out + ": ";
        } else {
            out = out + ch;
        }
    }
    return out;
}

fn _spaces(n) {
    let out = "";
    for i n { out = out + " "; }
    return out;
}

fn _top_level_keys_from_text(text, kind) {
    let v = nil;
    if kind == "toml" { v = ser.toml_parse(text); }
    else if kind == "yaml" { v = ser.yaml_parse(text); }
    else { v = JSON.parse(text); }
    if type(v) == "map" { return map_keys(v); }
    if type(v) == "array" { return map{ kind: "array", len: len(v) }; }
    return map{ kind: type(v) };
}

fn _html_escape(s) {
    s = str_replace_all(str(s), "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    s = str_replace_all(s, "\"", "&quot;");
    return str_replace_all(s, "'", "&#39;");
}

fn _c_escape(s) {
    s = str_replace_all(str(s), "\\", "\\\\");
    s = str_replace_all(s, "\n", "\\n");
    s = str_replace_all(s, "\r", "\\r");
    s = str_replace_all(s, "\t", "\\t");
    return str_replace_all(s, "\"", "\\\"");
}

fn _slugify(s) {
    s = str_lower(str(s));
    let out = "";
    let prev_dash = false;
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if str_contains(allowed, ch) {
            out = out + ch;
            prev_dash = false;
        } else if prev_dash != true {
            out = out + "-";
            prev_dash = true;
        }
    }
    while str_starts_with(out, "-") { out = str_slice(out, 1, len(out)); }
    while str_ends_with(out, "-") { out = str_slice(out, 0, len(out) - 1); }
    return out;
}

fn _collapse_blank_lines(text) {
    let lines = str_split(str(text), "\n");
    let out = [];
    let blank = false;
    for i len(lines) {
        if str_trim(lines[i]) == "" {
            if blank != true { out[len(out)] = ""; }
            blank = true;
        } else {
            out[len(out)] = lines[i];
            blank = false;
        }
    }
    return _join(out, "\n");
}

fn _join(items, sep) {
    let out = "";
    for i len(items) {
        if i > 0 { out = out + sep; }
        out = out + str(items[i]);
    }
    return out;
}

fn _sort_lines(text, reverse) {
    let lines = str_split(str(text), "\n");
    for i len(lines) {
        let j = i;
        while j > 0 {
            let swap = false;
            if reverse == true { swap = lines[j - 1] < lines[j]; }
            else { swap = lines[j - 1] > lines[j]; }
            if swap != true { break; }
            let t = lines[j - 1];
            lines[j - 1] = lines[j];
            lines[j] = t;
            j = j - 1;
        }
    }
    return _join(lines, "\n");
}

fn _reverse_lines(text) {
    let lines = str_split(str(text), "\n");
    let out = [];
    let i = len(lines) - 1;
    while i >= 0 {
        out[len(out)] = lines[i];
        i = i - 1;
    }
    return _join(out, "\n");
}

fn _trim_lines(text) {
    let lines = str_split(str(text), "\n");
    for i len(lines) { lines[i] = str_trim(lines[i]); }
    return _join(lines, "\n");
}

fn _remove_empty_lines(text) {
    let lines = str_split(str(text), "\n");
    let out = [];
    for i len(lines) {
        if str_trim(lines[i]) != "" { out[len(out)] = lines[i]; }
    }
    return _join(out, "\n");
}

fn _dedupe_adjacent_lines(text) {
    let lines = str_split(str(text), "\n");
    let out = [];
    let last = nil;
    for i len(lines) {
        if last == nil or lines[i] != last {
            out[len(out)] = lines[i];
        }
        last = lines[i];
    }
    return _join(out, "\n");
}

fn convert_format(args) {
    let op = str_lower(str(try args.operation catch try args.format catch try args.mode catch "json_pretty"));
    let input = _input(args);
    let value = nil;

    if op == "json_pretty" or op == "json_prettify" { value = _json_pretty_text(input); }
    else if op == "json_minify" { value = JSON.stringify(JSON.parse(input)); }
    else if op == "json_top_level_keys" { value = _top_level_keys_from_text(input, "json"); }
    else if op == "toml_to_json" { value = JSON.stringify(ser.toml_parse(input)); }
    else if op == "json_to_toml" { value = ser.toml_stringify(JSON.parse(input)); }
    else if op == "toml_top_level_keys" { value = _top_level_keys_from_text(input, "toml"); }
    else if op == "yaml_to_json" { value = JSON.stringify(ser.yaml_parse(input)); }
    else if op == "yaml_top_level_keys" { value = _top_level_keys_from_text(input, "yaml"); }
    else if op == "base64_encode" { value = base64_encode(input); }
    else if op == "base64_decode" { value = base64_decode(input); }
    else if op == "hex_encode" { value = hex_encode(input); }
    else if op == "hex_decode" { value = hex_decode(input); }
    else if op == "sha256_hex" { value = sha256(input); }
    else if op == "utf8_bom_strip" { value = if str_starts_with(input, "\xef\xbb\xbf") { str_slice(input, 3, len(input)) } else { input }; }
    else if op == "line_endings_lf" { value = str_replace_all(input, "\r\n", "\n"); }
    else if op == "line_endings_crlf" { value = str_replace_all(str_replace_all(input, "\r\n", "\n"), "\n", "\r\n"); }
    else if op == "tabs_to_spaces" { value = str_replace_all(input, "\t", _spaces(sec.clamp(try args.tab_width catch 4, 1, 16))); }
    else if op == "spaces_to_tabs" { value = str_replace_all(input, _spaces(sec.clamp(try args.tab_width catch 4, 1, 16)), "\t"); }
    else if op == "collapse_blank_lines" { value = _collapse_blank_lines(input); }
    else if op == "remove_empty_lines" { value = _remove_empty_lines(input); }
    else if op == "dedupe_adjacent_lines" { value = _dedupe_adjacent_lines(input); }
    else if op == "slugify" { value = _slugify(input); }
    else if op == "sort_lines" { value = _sort_lines(input, false); }
    else if op == "reverse_sort_lines" { value = _sort_lines(input, true); }
    else if op == "reverse_lines" { value = _reverse_lines(input); }
    else if op == "trim_lines" { value = _trim_lines(input); }
    else if op == "percent_encode" { value = url_encode(input); }
    else if op == "percent_decode" { value = url_decode(input); }
    else if op == "html_escape" { value = _html_escape(input); }
    else if op == "c_string_escape" { value = _c_escape(input); }
    else { value = map{ error: "unsupported convert_format operation in pblang port", operation: op }; }

    return _maybe_write(args, value);
}

fn convert_encoding(args) {
    return map{ encoding: try args.to_encoding catch "utf-8", text: _input(args), note: "pblang port currently returns UTF-8 text; legacy transcoding remains catalog-only" };
}

fn convert_binary_hexdump(args) {
    let input = _input(args);
    let hex = hex_encode(input);
    let width = sec.clamp(try args.width catch 16, 1, 64);
    let out = [];
    let pos = 0;
    while pos < len(hex) {
        let end = pos + width * 2;
        if end > len(hex) { end = len(hex); }
        out[len(out)] = map{ offset: pos / 2, hex: str_slice(hex, pos, end) };
        pos = end;
    }
    return out;
}

fn _flatten(prefix, value, out) {
    if type(value) == "map" {
        let keys = map_keys(value);
        for i len(keys) {
            let next = if prefix == "" { keys[i] } else { prefix + "." + keys[i] };
            _flatten(next, value[keys[i]], out);
        }
    } else if type(value) == "array" {
        for i len(value) {
            _flatten(prefix + "[" + str(i) + "]", value[i], out);
        }
    } else {
        out[prefix] = value;
    }
    return out;
}

fn data_json_flatten(args) {
    let v = JSON.parse(_input(args));
    return _flatten("", v, map{});
}

fn _query_step(cur, part) {
    if cur == nil { return nil; }
    if type(cur) == "map" { return try cur[part] catch nil; }
    if type(cur) == "array" {
        let idx = try parse_number(part) catch -1;
        if idx >= 0 and idx < len(cur) { return cur[idx]; }
    }
    return nil;
}

fn db_json_query(args) {
    let v = JSON.parse(_input(args));
    let expr = str(try args.query catch try args.path_expr catch try args.path catch "");
    if str_starts_with(expr, "$.") { expr = str_slice(expr, 2, len(expr)); }
    if str_starts_with(expr, ".") { expr = str_slice(expr, 1, len(expr)); }
    if expr == "" or expr == "$" { return v; }
    let parts = str_split(expr, ".");
    let cur = v;
    for i len(parts) { cur = _query_step(cur, parts[i]); }
    return cur;
}

fn call_convert(tool, args) {
    if args == nil { args = map{}; }
    if tool == "convert_format" { return convert_format(args); }
    if tool == "convert_encoding" { return convert_encoding(args); }
    if tool == "convert_binary_hexdump" { return convert_binary_hexdump(args); }
    if tool == "data_json_flatten" { return data_json_flatten(args); }
    if tool == "db_json_query" { return db_json_query(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "convert_format",
        "convert_encoding",
        "convert_binary_hexdump",
        "data_json_flatten",
        "db_json_query",
    ];
}

export implemented_tools, call_convert,
       convert_format, convert_encoding, convert_binary_hexdump,
       data_json_flatten, db_json_query;
