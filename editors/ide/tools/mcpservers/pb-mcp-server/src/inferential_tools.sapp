// Inferential-statistics tools for pb-mcp-server — exposes stdlib:inferential.sapp.
//
// Hypothesis tests (one-sample & Welch t-tests, chi-square goodness-of-fit) and
// OLS linear regression over MCP. Each returns its statistic, degrees of
// freedom, and a p-value, so a client can decide on real significance. Inputs
// and outputs are plain numbers (JSON-clean).

let inf = import("stdlib:inferential.sapp");

let INFER_TOOLS = ["infer_regression", "infer_t_test_one",
                   "infer_t_test_welch", "infer_chi_square",
                   "infer_anova", "infer_confidence_interval"];

fn tool_list() { return INFER_TOOLS; }
fn implemented_tools() { return INFER_TOOLS; }

fn call_inferential(tool, args) {
    if args == nil { args = map{}; }

    // infer_regression: OLS fit -> {slope, intercept, r2, n}
    if tool == "infer_regression" {
        let x = try args.x catch [];
        let y = try args.y catch [];
        if len(x) != len(y) or len(x) < 2 { return map{ ok: false, error: "infer_regression: x and y must have equal length >= 2" }; }
        return inf.linear_regression(x, y);
    }
    // infer_t_test_one: one-sample t-test of the mean against mu0.
    if tool == "infer_t_test_one" {
        let data = try args.data catch [];
        let mu0 = try args.mu0 catch 0;
        if len(data) < 2 { return map{ ok: false, error: "infer_t_test_one: need at least 2 observations" }; }
        return inf.t_test_one_sample(data, mu0);
    }
    // infer_t_test_welch: two-sample Welch (unequal-variance) t-test.
    if tool == "infer_t_test_welch" {
        let a = try args.a catch [];
        let b = try args.b catch [];
        if len(a) < 2 or len(b) < 2 { return map{ ok: false, error: "infer_t_test_welch: each group needs at least 2 observations" }; }
        return inf.t_test_welch(a, b);
    }
    // infer_chi_square: Pearson goodness-of-fit test.
    if tool == "infer_chi_square" {
        let observed = try args.observed catch [];
        let expected = try args.expected catch [];
        if len(observed) != len(expected) or len(observed) < 2 { return map{ ok: false, error: "infer_chi_square: observed and expected must have equal length >= 2" }; }
        return inf.chi_square_gof(observed, expected);
    }
    // infer_anova: one-way ANOVA across >=2 numeric groups.
    if tool == "infer_anova" {
        let groups = try args.groups catch [];
        if len(groups) < 2 { return map{ ok: false, error: "infer_anova: need at least 2 groups" }; }
        return inf.one_way_anova(groups);
    }
    // infer_confidence_interval: t-based CI for the population mean.
    if tool == "infer_confidence_interval" {
        let data = try args.data catch [];
        let confidence = try args.confidence catch 0.95;
        if len(data) < 2 { return map{ ok: false, error: "infer_confidence_interval: need at least 2 observations" }; }
        if confidence <= 0 or confidence >= 1 { return map{ ok: false, error: "infer_confidence_interval: confidence must be in (0,1)" }; }
        return inf.confidence_interval_mean(data, confidence);
    }
    return nil;
}

export call_inferential, tool_list, implemented_tools, INFER_TOOLS;
