// Evaluate caller declarations only; never execute checks or authenticate evidence.
fn _missing(values,key) {
    if map_has(values,key) {return false;}
    return true;
}
fn _object(value,fields) {
    if type(value)!="map" {throw "acceptance: invalid object";}
    if len(value)!=len(fields) {throw "acceptance: invalid properties";}
    for field in fields {if _missing(value,field) {throw "acceptance: invalid properties";}}
}
fn _array(value,minimum,maximum) {
    if type(value)!="array" {throw "acceptance: invalid array";}
    if len(value)<minimum or len(value)>maximum {throw "acceptance: array limit exceeded";}
}
fn _id(value) {
    if type(value)!="string" {throw "acceptance: invalid identifier";}
    if len(value)<1 or len(value)>64 {throw "acceptance: invalid identifier";}
    // ASCII-only admission makes the character and UTF-8 byte bounds identical.
    if not regex_match(value,"^[A-Za-z0-9_.:-]+$") {throw "acceptance: invalid identifier";}
}
fn _check(args) {
    _object(args,["revision","required","observations"]);_id(args.revision);
    _array(args.required,1,64);_array(args.observations,0,256);
    let required=map{};
    for id in args.required {
        _id(id);
        if map_has(required,id) {throw "acceptance: duplicate required check";}
        required[id]=true;
    }
    let observations=map{};let ignored=0;
    // Validate unrelated and stale records as strictly as current required ones.
    // More than one observation per check is ambiguous, including across revisions.
    for observation in args.observations {
        _object(observation,["check","revision","status"]);
        _id(observation.check);_id(observation.revision);
        if type(observation.status)!="string" {throw "acceptance: invalid status";}
        if observation.status!="passed" and observation.status!="failed"
            and observation.status!="inconclusive" {throw "acceptance: invalid status";}
        if map_has(observations,observation.check) {throw "acceptance: duplicate observation";}
        observations[observation.check]=observation;
        if _missing(required,observation.check) {ignored=ignored+1;}
    }
    let checks=[];let counts=map{passed:0,failed:0,missing:0,stale:0,inconclusive:0};
    for id in args.required {
        let status="missing";
        if map_has(observations,id) {
            let observation=observations[id];
            status=if observation.revision==args.revision {observation.status} else {"stale"};
        }
        counts[status]=counts[status]+1;
        checks[len(checks)]=map{check:id,status:status};
    }
    return map{format:"pb_mcp.ai_acceptance_check.v1",revision:args.revision,
        checks:checks,counts:counts,ready:counts.passed==len(args.required),
        required_count:len(args.required),observation_count:len(args.observations),
        ignored_observations:ignored,native_pblang:true,data_source:"caller_supplied",
        data_provenance:"untrusted_caller_supplied",checks_executed:false,
        evidence_authenticated:false,independently_verified:false,effects_performed:false,
        permission_granted:false,instructions_from_data:false,safe_to_log:false,
        network_used:false,model_loaded:false};
}
fn call_acceptance(name,args) {
    if name=="ai_acceptance_check" {return _check(args);}
    return nil;
}
fn implemented_tools() {return ["ai_acceptance_check"];}
fn catalog_entries() {
    let id=map{type:"string",minLength:1,maxLength:64,pattern:"^[A-Za-z0-9_.:-]+$"};
    let schema=map{type:"object",required:["revision","required","observations"],
        additionalProperties:false,properties:map{
            revision:id,required:map{type:"array",minItems:1,maxItems:64,uniqueItems:true,items:id},
            observations:map{type:"array",minItems:0,maxItems:256,
                description:"At most one observation per check ID, including across revisions and unrelated checks; every record validates.",
                items:map{type:"object",required:["check","revision","status"],additionalProperties:false,
                    properties:map{check:id,revision:id,status:map{type:"string",
                        enum:["passed","failed","inconclusive"]}}}}}};
    return [map{name:"ai_acceptance_check",category:"agent-assistance",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/agent_acceptance.sapp",
        description:"Compare 1..64 required check IDs with up to256 caller-declared observations for an exact opaque revision. Return passed/failed/missing/stale/inconclusive in required order; ready only when all required checks are declared passed for that revision. Reject duplicate observations across revisions. No test execution, evidence authentication, independent verification or permission grant. IDs may be private: safe_to_log:false.",
        input_schema:schema}];
}
fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded comparison of caller-declared check outcomes and exact revision IDs; no execution or attestation",
        evidence_ids:["pb_mcp_agent_acceptance:states","pb_mcp_agent_acceptance:revision",
            "pb_mcp_agent_acceptance:bounds","pb_mcp_agent_acceptance:privacy"]}];
}
export call_acceptance,implemented_tools,catalog_entries,functional_records;
