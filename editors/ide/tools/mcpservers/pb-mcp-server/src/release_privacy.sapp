// Length-preserving release-byte redaction for verified bootstrap artifacts.

fn replace_exact(bytes, private_value, public_prefix, maximum_replacements = 16) {
    if type(bytes) != "array" or type(private_value) != "string" or
       type(public_prefix) != "string" or private_value == "" or
       not str_starts_with(private_value, "/") or
       not str_starts_with(public_prefix, "/") or
       len(private_value) > 4096 or len(public_prefix) > len(private_value) or
       type(maximum_replacements) != "number" or
       maximum_replacements != num_floor(maximum_replacements) or
       maximum_replacements < 1 or maximum_replacements > 256 {
        return map{ ok: false, error: "release privacy replacement policy is invalid" };
    }
    let needle = str_to_bytes(private_value);
    let replacement_text = public_prefix;
    while len(replacement_text) < len(private_value) {
        replacement_text = replacement_text + "_";
    }
    let replacement = str_to_bytes(replacement_text);
    // Count first so every policy failure leaves the caller's byte array
    // untouched. The second pass performs exactly the admitted replacements.
    let count = 0; let i = 0;
    while i + len(needle) <= len(bytes) {
        let matched = true; let j = 0;
        while j < len(needle) {
            if bytes[i + j] != needle[j] { matched = false; j = len(needle); }
            else { j = j + 1; }
        }
        if matched {
            count = count + 1;
            if count > maximum_replacements {
                return map{ ok: false,
                    error: "release privacy replacement count exceeds policy" };
            }
            i = i + len(needle);
        } else { i = i + 1; }
    }
    if count < 1 {
        return map{ ok: false, error: "private build prefix was not present" };
    }
    i = 0;
    while i + len(needle) <= len(bytes) {
        let matched = true; let j = 0;
        while j < len(needle) {
            if bytes[i + j] != needle[j] { matched = false; j = len(needle); }
            else { j = j + 1; }
        }
        if matched {
            j = 0;
            while j < len(replacement) {
                bytes[i + j] = replacement[j]; j = j + 1;
            }
            i = i + len(needle);
        } else { i = i + 1; }
    }
    return map{ ok: true, bytes: bytes, replacements: count,
        length_preserved: len(needle) == len(replacement),
        replacement: replacement_text };
}

export replace_exact;
