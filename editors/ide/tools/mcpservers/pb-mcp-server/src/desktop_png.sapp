    }
}
// For direct-color/full-palette images only filter bytes need inspection.
// Callback state is local and provisional; no image escapes before checksum.
fn _visit_scanlines(compressed,layout) {
    let state = map{pass:0,row:0,next:0};
    fn inspect(chunk,offset) {
        let end = offset+len(chunk);
        while state.pass < len(layout.passes) and state.next < end {
            if state.next < offset or chunk[state.next-offset] > 4 { throw "invalid PNG scanline filter"; }
            let pass = layout.passes[state.pass];
            state.next = state.next+pass.stride+1; state.row = state.row+1;
            if state.row == pass.height { state.pass = state.pass+1; state.row = 0; }
        }
    }
    let decoded = Flate.zlib_visit(compressed,inspect,layout.total,true);
    if decoded.decoded_bytes != layout.total or state.pass != len(layout.passes)
        or state.next != layout.total { throw "PNG scanline length mismatch"; }
    return decoded.decoded_bytes;
}
// Indexed PNG filters depend only on the current and preceding pass row.
// Keep those rows across visitor chunks; never retain the decoded image.
fn _visit_palette(compressed,layout,depth,palette) {
    let state = map{pass:0,row_number:0,column:-1,filter:0,row:[],previous:[],offset:0};
    let per_byte = 8/depth; let mask = bit_shl(1,depth)-1;
    fn inspect(chunk,offset) {
        if offset != state.offset { throw "PNG scanline offset mismatch"; }
        let pi = state.pass; let rn = state.row_number; let col = state.column;
        let filter = state.filter; let row = state.row; let previous = state.previous;
        let at = 0;
        while at < len(chunk) {
            if pi >= len(layout.passes) { throw "PNG scanline length mismatch"; }
            let pass = layout.passes[pi];
            if col == -1 {
                filter = chunk[at]; at = at+1; col = 0;
                if filter > 4 { throw "invalid PNG scanline filter"; }
            }
            let count = num_min(len(chunk)-at,pass.stride-col);
            for i count {
                let x = col+i; let v = chunk[at+i];
                if filter != 0 {
                    let left = if x == 0 { 0 } else { row[x-1] };
                    let up = if rn == 0 { 0 } else { previous[x] };
                    if filter == 1 { v = v+left; }
                    elif filter == 2 { v = v+up; }
                    elif filter == 3 { v = v+num_floor((left+up)/2); }
                    else {
                        let upper_left = if rn == 0 or x == 0 { 0 } else { previous[x-1] };
                        v = v+_paeth(left,up,upper_left);
                    }
                    v = bit_and(v,255);
