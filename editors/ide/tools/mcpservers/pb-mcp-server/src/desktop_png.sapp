    } elif partial_palette {
        decoded_bytes = _visit_palette(compressed,layout,depth,palette);
    } else { decoded_bytes = _visit_scanlines(compressed,layout); }
    return map{ ok: true, bytes: out, width: width, height: height,
        decoded_bytes: decoded_bytes, removed_bytes: removed,
        crc_verified: true, checksum_verified: true, metadata_removed: true,
        color_profile_removed: color_profile_removed };
}
fn sanitize(bytes, options = nil) {
    if options == nil { options = map{}; }
    let result = try _sanitize(bytes, options) catch nil;
    if result == nil { return map{ ok: false, error: "Invalid or unsupported bounded desktop PNG" }; }
    return result;
}
export sanitize;
