}
fn _channels(color, depth) {
    if color == 0 and (depth == 1 or depth == 2 or depth == 4 or depth == 8 or depth == 16) { return 1; }
    if color == 3 and (depth == 1 or depth == 2 or depth == 4 or depth == 8) { return 1; }
    if depth != 8 and depth != 16 { throw "unsupported PNG depth"; }
    if color == 2 { return 3; }
    if color == 4 { return 2; }
    if color == 6 { return 4; }
    throw "invalid PNG color type";
}
fn _passes(width, height, bits, interlace) {
    let layout = if interlace == 0 { [[0, 0, 1, 1]] } else {
        [[0, 0, 8, 8], [4, 0, 8, 8], [0, 4, 4, 8], [2, 0, 4, 4],
            [0, 2, 2, 4], [1, 0, 2, 2], [0, 1, 1, 2]]
