        }
        state.pass = pi; state.row_number = rn; state.column = col;
        state.filter = filter; state.row = row; state.previous = previous;
        state.offset = offset+len(chunk);
    }
    let decoded = Flate.zlib_visit(compressed,inspect,layout.total,true);
    if decoded.decoded_bytes != layout.total or state.pass != len(layout.passes)
