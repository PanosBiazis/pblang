// Desktop transport PNG validation. Preserve compressed pixels and transparency;
// omit optional metadata without decoding a second RGBA image or recompressing.
let Flate = import("stdlib:flate.sapp");
let SIGNATURE = [137, 80, 78, 71, 13, 10, 26, 10];

fn _u32(bytes, at) {
    return bytes[at] * 16777216 + bytes[at + 1] * 65536
