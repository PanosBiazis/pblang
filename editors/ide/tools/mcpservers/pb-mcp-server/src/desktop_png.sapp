}
fn _sanitize(bytes, options) {
    if type(options) != "map" { throw "invalid PNG options"; }
    for key in map_keys(options) {
        if key != "max_input_bytes" and key != "max_width" and key != "max_height"
            and key != "max_decoded_bytes" and key != "max_chunks" and key != "streaming" { throw "unknown PNG option"; }
    }
    let streaming = if map_has(options,"streaming") { options.streaming } else { true };
    if type(streaming) != "bool" { throw "invalid PNG streaming selection"; }
    let input_limit = _bound(options, "max_input_bytes", 98304, 64, 16777216);
    let width_limit = _bound(options, "max_width", 1280, 1, 16384);
    let height_limit = _bound(options, "max_height", 720, 1, 16384);
    let raw_limit = _bound(options, "max_decoded_bytes", 8388608, 1, 67108864);
    let chunk_limit = _bound(options, "max_chunks", 1024, 3, 65536);
    if type(bytes) != "array" or len(bytes) < 57 or len(bytes) > input_limit { throw "invalid PNG input size"; }
    for byte in bytes {
        if type(byte) != "number" or byte != num_floor(byte) or byte < 0 or byte > 255 { throw "invalid PNG byte"; }
    }
    for i 8 { if bytes[i] != SIGNATURE[i] { throw "invalid PNG signature"; } }
    let out = slice(bytes, 0, 8); let compressed = [];
    let at = 8; let chunks = 0; let width = 0; let height = 0; let depth = 0;
    let color = -1; let palette = 0; let seen_palette = false; let transparency = false;
    let seen_data = false; let closed_data = false; let ended = false;
    let layout = nil; let removed = 0; let color_chunks = map{}; let color_profile_removed = false;
    while at < len(bytes) {
        chunks = chunks + 1;
        if chunks > chunk_limit or at + 12 > len(bytes) { throw "PNG chunk bound exceeded"; }
        let size = _u32(bytes, at);
        if size > len(bytes) - at - 12 { throw "truncated PNG chunk"; }
        let data = at + 8;
        let name = "";
        for i 4 {
            let c = bytes[at + 4 + i];
            if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122)) { throw "invalid PNG chunk name"; }
            name = name + strfromcharcode(c);
        }
        if bit_and(bytes[at + 6], 32) != 0 { throw "reserved PNG chunk bit"; }
        if Flate.crc32_range(bytes, at + 4, size + 4) != _u32(bytes, data + size) { throw "PNG chunk CRC mismatch"; }
        if width == 0 and name != "IHDR" { throw "PNG must start with IHDR"; }
        let keep = false;
        if name == "IHDR" {
            if at != 8 or size != 13 { throw "invalid PNG header"; }
            width = _u32(bytes, data); height = _u32(bytes, data + 4);
            depth = bytes[data + 8]; color = bytes[data + 9];
            let channels = _channels(color, depth);
            if width < 1 or height < 1 or width > width_limit or height > height_limit
                or bytes[data + 10] != 0 or bytes[data + 11] != 0 or bytes[data + 12] > 1 { throw "unsupported PNG header"; }
            layout = _passes(width, height, channels * depth, bytes[data + 12]);
            if layout.total > raw_limit { throw "PNG decoded size exceeds quota"; }
            keep = true;
        } elif name == "PLTE" {
            if seen_palette or seen_data or transparency or color == 0 or color == 4
                or size < 3 or size > 768 or size % 3 != 0 { throw "invalid PNG palette"; }
            palette = size / 3; seen_palette = true;
            if color == 3 and palette > bit_shl(1, depth) { throw "oversized indexed palette"; }
            keep = true;
        } elif name == "tRNS" {
            if transparency or seen_data { throw "invalid PNG transparency order"; }
            if color == 3 {
                if not seen_palette or size < 1 or size > palette { throw "invalid palette transparency"; }
            } elif color == 0 or color == 2 {
                let samples = if color == 0 { 1 } else { 3 };
                if size != samples * 2 { throw "invalid transparency length"; }
                for i samples {
                    if bytes[data + 2 * i] * 256 + bytes[data + 2 * i + 1] >= bit_shl(1, depth) { throw "invalid transparent sample"; }
                }
            } else { throw "unexpected PNG transparency"; }
            transparency = true; keep = true;
        } elif name == "gAMA" or name == "cHRM" or name == "sRGB" {
            if seen_palette or seen_data or map_has(color_chunks, name) { throw "invalid PNG color metadata order"; }
            if name == "gAMA" and (size != 4 or _u32(bytes, data) == 0) { throw "invalid gamma"; }
            if name == "cHRM" and size != 32 { throw "invalid chromaticities"; }
            if name == "sRGB" and (size != 1 or bytes[data] > 3) { throw "invalid rendering intent"; }
            color_chunks[name] = true; keep = true;
        } elif name == "IDAT" {
            if closed_data or (color == 3 and not seen_palette) { throw "invalid PNG data order"; }
            _append(compressed, bytes, data, size);
            seen_data = true; keep = true;
        } elif name == "IEND" {
            if size != 0 or not seen_data or at + 12 != len(bytes) { throw "invalid PNG end"; }
            ended = true; keep = true;
