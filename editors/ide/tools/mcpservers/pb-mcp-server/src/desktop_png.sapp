            array_push(passes, map{ width: w, height: h, stride: stride });
            total = total + (stride + 1) * h;
        }
    }
    return map{ passes: passes, total: total };
}
fn _paeth(a, b, c) {
    let p = a + b - c;
    let pa = num_abs(p - a); let pb = num_abs(p - b); let pc = num_abs(p - c);
    if pa <= pb and pa <= pc { return a; }
    if pb <= pc { return b; }
    return c;
}
fn _scanlines(raw, passes, color, depth, palette_size) {
    let at = 0;
    let check_indices = color == 3 and palette_size < bit_shl(1, depth);
    for pass in passes {
        let previous = [];
        for row_index pass.height {
            let filter = raw[at]; at = at + 1;
            if filter > 4 { throw "invalid PNG scanline filter"; }
            // Non-indexed sample values are valid by construction at every bit
            // depth. Only palette indices require reconstructing a scanline.
            if check_indices {
                let row = [];
                for x pass.stride {
                    let left = if x == 0 { 0 } else { row[x - 1] };
                    let up = if row_index == 0 { 0 } else { previous[x] };
                    let upper_left = if row_index == 0 or x == 0 { 0 } else { previous[x - 1] };
                    let v = raw[at + x];
                    if filter == 1 { v = v + left; }
                    elif filter == 2 { v = v + up; }
                    elif filter == 3 { v = v + num_floor((left + up) / 2); }
                    elif filter == 4 { v = v + _paeth(left, up, upper_left); }
                    array_push(row, bit_and(v, 255));
                }
                let mask = bit_shl(1, depth) - 1;
                for x pass.width {
                    let bit_offset = x * depth;
                    let index = bit_and(bit_shr(row[num_floor(bit_offset / 8)],
