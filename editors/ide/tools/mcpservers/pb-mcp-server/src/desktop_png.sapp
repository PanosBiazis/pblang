            removed = removed + size + 12;
        }
        if seen_data and name != "IDAT" { closed_data = true; }
        if keep { _append(out, bytes, at, size + 12); }
        at = at + size + 12;
    }
    if not ended or len(compressed) < 6 or bit_shr(compressed[0], 4) > 7 { throw "incomplete PNG data"; }
    // The exact, dimension-derived ceiling is applied during inflation, before
    // growth. No independent pixel matrix or second compressed copy is built.
    let decoded_bytes = 0;
    let partial_palette = color == 3 and palette < bit_shl(1,depth);
    // Below two decode windows, visitor copies can cost more than a raw array.
    // This selects an implementation; it does not reject or cap image sizes.
    if not streaming or type(_visit_scanlines) == "map"
