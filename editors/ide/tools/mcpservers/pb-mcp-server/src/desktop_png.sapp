    let passes = []; let total = 0;
    for p in layout {
        if width > p[0] and height > p[1] {
            let w = num_floor((width - p[0] + p[2] - 1) / p[2]);
            let h = num_floor((height - p[1] + p[3] - 1) / p[3]);
