                        }
                    }
                }
                array_push(row,v);
            }
            at = at+count; col = col+count;
            if col == pass.stride {
                previous = row; row = []; col = -1; rn = rn+1;
                if rn == pass.height { pi = pi+1; rn = 0; previous = []; }
