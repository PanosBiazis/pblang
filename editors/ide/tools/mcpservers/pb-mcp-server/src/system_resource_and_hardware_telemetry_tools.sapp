fn pb_mcp_mobile_tv_thermal_frame_governor(args) {
    let e = _eng();
    let gov = e.evaluate_universal_system_resource_governor(map{
        total_ram_mb: 4096,
        available_ram_mb: 1400,
        cpu_cores: 8,
        current_cpu_load_pct: 45,
        vram_mb: 0,
        has_npu: true,
        is_on_battery: true,
        battery_pct: 65,
        thermal_c: 58,
        os_family: "android_ios_mobile_tv"
    });
    let frame = e.evaluate_cooperative_frame_budget_scheduler(map{ target_fps: 120 });
    return map{
        ok: gov.ok and frame.ok,
        engine: "pb_mcp_mobile_tv_thermal_frame_governor_v12",
        governor: gov,
        frame_scheduler: frame
    };
}

