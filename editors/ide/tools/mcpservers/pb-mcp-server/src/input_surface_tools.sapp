// Offline pointer-data processing shared with PBLang applications.
let INPUT=import("stdlib:input_surface.sapp");
fn call_input_surface(tool,args) {
    if tool!="input_surface_transform" and tool!="input_trace_analyze" {return nil;}
    if type(args)!="map" {throw "input surface: expected arguments";}
    let names=if tool=="input_surface_transform"{["surface","points"]}else{["events"]};
    for key in map_keys(args){let found=false;for name in names{if key==name{found=true;}}if not found{throw "input surface: unknown argument";}}
    if tool=="input_surface_transform" {return INPUT.transform(try args.surface catch nil,try args.points catch nil);}
    return INPUT.analyze(try args.events catch nil);
}
fn implemented_tools(){return ["input_surface_transform","input_trace_analyze"];}
fn catalog_entries(){
    let coordinate=map{type:"number",minimum:0,maximum:1048576};
    let point=map{type:"object",properties:map{x:coordinate,y:coordinate},required:["x","y"],additionalProperties:false};
    let unit=map{type:"number",minimum:0,maximum:1};
    let tilt=map{type:"number",minimum:-90,maximum:90};
    let event=map{type:"object",properties:map{
        contact_id:map{type:"integer",minimum:0,maximum:31},kind:map{type:"string",enum:["touch","pen","mouse"]},
        phase:map{type:"string",enum:["start","move","end","cancel"]},time_ms:map{type:"number",minimum:0,maximum:86400000},
        x:unit,y:unit,pressure:unit,tilt_x:tilt,tilt_y:tilt},required:["contact_id","kind","phase","time_ms","x","y"],additionalProperties:false};
    let schemas=[map{type:"object",properties:map{surface:map{type:"object",properties:map{
        width:map{type:"number",minimum:1,maximum:1048576},height:map{type:"number",minimum:1,maximum:1048576},
        rotation:map{type:"integer",enum:[0,90,180,270]},mirror_x:map{type:"boolean"},mirror_y:map{type:"boolean"}},
        required:["width","height"],additionalProperties:false},points:map{type:"array",maxItems:256,items:point}},required:["surface","points"],additionalProperties:false},
        map{type:"object",properties:map{events:map{type:"array",maxItems:256,items:event}},required:["events"],additionalProperties:false}];
    let descriptions=["Transform up to256 caller-supplied touch/pen/interactive-board coordinates to normalized0..1 with reflection and quarter-turn rotation. No screen/device access, calibration write or input injection.",
        "Validate up to256 ordered caller-supplied touch/pen/mouse events with32 contact slots; summarize contact phases, pressure and tilt. No raw coordinates or contact IDs returned. Open contacts reported as incomplete; no device access, biometric identity or handwriting recognition."];
    let names=implemented_tools();let out=[];for i len(names){out[len(out)]=map{name:names[i],category:"input-surfaces",profile:"core-code",read_only:true,destructive:false,open_world:false,source:"src/input_surface_tools.sapp",description:descriptions[i],input_schema:schemas[i]};}return out;
}
fn functional_records(){let out=[];for entry in catalog_entries(){out[len(out)]=map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,reason:"bounded offline input-data processing; no hardware access",evidence_ids:["pb_mcp_input_surface:positive","pb_mcp_input_surface:negative"]};}return out;}
export call_input_surface,implemented_tools,catalog_entries,functional_records;
