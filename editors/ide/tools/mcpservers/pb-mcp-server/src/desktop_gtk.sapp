// Fixed native GTK/libc ABI facade for trusted local PBLang windows.
let Libraries=import("src/desktop_native_libraries.sapp");
let Switch=import("src/implementation_switch.sapp");
fn _library(name) {
    for arch in ["x86_64-linux-gnu", "aarch64-linux-gnu"] {
        for prefix in ["/usr/lib/", "/lib/"] {
            let path = prefix + arch + "/" + name;
            if fs_exists(path) { return ffi_load(path); }
        }
    }
    throw "required system UI library is unavailable";
}
// disabled: Retained legacy polyglot C-wrapper path preserved in source without deletion.
// Disabled via ImplementationSwitch (enabled = false -> throws "implementation disabled").
fn open_disabled_polyglot() {
    return Switch.open(false, "polyglot_c_abi", map{
        polyglot_c_abi: fn() {
            // disabled polyglot C/GTK wrapper implementation (preserved, never executed):
            // return ffi_load(cwd()+"/transport/operator_gtk_abi.so");
            return nil;
        }
    });
}
/* disabled (polyglot pblang live-view block preserved in comments without deletion):
fn _polyglot_legacy_void_call(abi, name, native_signature, native_args) {
    return ffi_call_typed(abi, "pbui_" + name, str_replace_all(native_signature, "->void", "->i32"), native_args);
}
*/
fn _open_pure_pblang() {
    if platform() != "linux" { throw "verified operator backend requires Linux"; }
    fn load(name) {
        if name=="operator_gtk_abi" {return ffi_load(cwd()+"/transport/operator_gtk_abi.so");}
        return _library(name);
    }
    let libraries=Libraries.acquire(load,fn(handle){ffi_close(handle);});
    let gtk=libraries.gtk;let glib=libraries.glib;let libc=libraries.libc;let abi=libraries.abi;
    fn g(name, signature, args) {
        // Frequent getters need no argument normalization. GTK gboolean is
        // still read as a C int and converted to a PBLang bool, not C _Bool.
        if signature == "ptr->bool" { return ffi_call_typed(gtk, name, "ptr->i32", args) != 0; }
        if signature == "->bool" { return ffi_call_typed(gtk, name, "->i32", args) != 0; }
        if not str_ends_with(signature, "->void") and not str_ends_with(signature, "->bool") {
            return ffi_call_typed(gtk, name, signature, args);
        }
        // PBLang now calls the supported one-pointer void ABI directly.
        // The legacy C wrappers remain in source and in older releases, but
        // are inactive (disabled) for these symbols. Never retry through another backend.
        if signature == "ptr->void" and (name == "gtk_window_present" or name == "gtk_window_destroy") {
            return ffi_call_typed(gtk, name, signature, args);
        }
        // GTK gboolean is a C int, not the C _Bool ABI used by the host's bool.
        let native_args = [];
        for arg in args {
            if type(arg) == "bool" {
                if arg { array_push(native_args, 1); } else { array_push(native_args, 0); }
            } else { array_push(native_args, arg); }
        }
        let native_signature = str_replace_all(signature, "bool", "i32");
        if str_ends_with(signature, "->void") {
            return ffi_call_typed(abi, "pbui_" + name, str_replace_all(native_signature, "->void", "->i32"), native_args);
        }
        if str_ends_with(signature, "->bool") { return ffi_call_typed(gtk, name, native_signature, native_args) != 0; }
        return ffi_call_typed(gtk, name, signature, args);
    }
    fn c(name, signature, args) { return ffi_call_typed(libc, name, signature, args); }
    fn iterate() { return ffi_call_typed(glib, "g_main_context_iteration", "ptr,i32->i32", [0, 0]); }
    fn receive(buffer) { return ffi_call_typed(abi, "pbui_receive", "ptr->i64", [buffer]); }
    fn text(buffer) { return ffi_call_typed(abi, "pbui_text", "ptr->string", [buffer]); }
    fn send_bytes(value) { return ffi_call_typed(abi, "pbui_send", "string->i64", [value]); }
    fn viewer_receive(buffer) { return ffi_call_typed(abi, "pbui_viewer_receive", "ptr->i64", [buffer]); }
    fn viewer_send(value) { return ffi_call_typed(abi, "pbui_viewer_send", "string->i64", [value]); }
    fn viewer_image(picture, value) { return ffi_call_typed(abi, "pbui_viewer_image", "ptr,string->i32", [picture,value]) == 1; }
    fn close() { libraries.close(); }
    return map{ g: g, c: c, iterate: iterate, receive: receive, text: text, send_bytes: send_bytes,
        viewer_receive: viewer_receive, viewer_send: viewer_send, viewer_image: viewer_image, close: close };
}
fn open() {
    return Switch.open(true, "pure_pblang", map{
        pure_pblang: _open_pure_pblang,
        disabled_polyglot_c_abi: open_disabled_polyglot
    });
}
export open, open_disabled_polyglot;
