fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _dedupe(arr) {
    let out = [];
    for i len(arr) {
        if not _contains(out, arr[i]) { out[len(out)] = arr[i]; }
    }
    return out;
}

fn _entry_with_status(e, impls) {
    let native = _contains(impls, e.name);
    e.native_pblang = native;
    if native {
        e.port_status = "implemented";
    } else {
        e.port_status = "catalog-only";
    }
    return e;
}

fn tool_catalog() {
    let raw = gen.generated_tool_catalog();
    let impls = implemented_tool_names();
    let out = [];
    for i len(raw) {
        out[len(out)] = _entry_with_status(raw[i], impls);
    }
    return out;
}

fn implemented_catalog() {
    let all = tool_catalog();
    let out = [];
    for i len(all) {
        if all[i].native_pblang == true { out[len(out)] = all[i]; }
    }
    return _dedupe(out);
}

fn find_tool(name) {
    let all = tool_catalog();
    for i len(all) {
        if all[i].name == name { return all[i]; }
    }
    return nil;
}

fn search_tools(query) {
    let q = str_lower(str(query));
    let all = tool_catalog();
    let out = [];
    for i len(all) {
        let e = all[i];
        let hay = str_lower(e.name + " " + e.category + " " + e.profile + " " + e.description);
        if q == "" or str_contains(hay, q) { out[len(out)] = e; }
    }
    return out;
}

fn category_counts() {
    let all = tool_catalog();
    let counts = map{};
    for i len(all) {
        let c = all[i].category;
        let n = try counts[c] catch 0;
        counts[c] = n + 1;
    }
    return counts;
}

fn native_catalog_tool_count() {
    return len(implemented_catalog());
}

fn status() {
    let total = gen.generated_tool_count();
    let impls = implemented_tool_names();
    let native_catalog = native_catalog_tool_count();
    return map{
        name: "pb-mcp-server-pblang",
        runtime: "pblang",
        source_project: "tools/rust/pb-mcp-server",
        generated_tool_count: total,
        native_catalog_tool_count: native_catalog,
        catalog_completion_percent: if total == 0 { 0 } else { native_catalog * 100 / total },
        native_pblang_handler_count: len(impls),
        native_pblang_handlers: impls,
        category_counts: category_counts(),
        network_profile: sec.network_profile(),
        public_profile: sec.is_public_profile(),
        boundary: "This folder is a pblang port with 100% generated Rust catalog coverage. Some handlers are full local pblang implementations; external-binary, network, hardware, privileged, and provider-backed actions return validated gated plans until matching pblang runtime primitives are available.",
    };
}

fn implemented_tool_names() {
    let out = [];
    let groups = [
        core.implemented_tools(),
        thinking.implemented_tools(),
        text.implemented_tools(),
        runtime.implemented_tools(),
        algorithm.implemented_tools(),
        codebase.implemented_tools(),
        workspace.implemented_tools(),
        git.implemented_tools(),
        convert.implemented_tools(),
        logtools.implemented_tools(),
        chart.implemented_tools(),
        agent.implemented_tools(),
        mcp.implemented_tools(),
        history.implemented_tools(),
        consensus.implemented_tools(),
        system.implemented_tools(),
        app.implemented_tools(),
        review.implemented_tools(),
        wait.implemented_tools(),
        filetools.implemented_tools(),
        shelltools.implemented_tools(),
        mltools.implemented_tools(),
        protect.implemented_tools(),
        terminal.implemented_tools(),
        codeindex.implemented_tools(),
        context.implemented_tools(),
        debug.implemented_tools(),
        ide.implemented_tools(),
        aitools.implemented_tools(),
        quantum.implemented_tools(),
        projecttools.implemented_tools(),
        webtools.implemented_tools(),
        mediatools.implemented_tools(),
        netiot.implemented_tools(),
        retools.implemented_tools(),
        sandboxtools.implemented_tools(),
        completion.implemented_tools(),
        llmcog.implemented_tools(),
        reatools.implemented_tools(),
        archtools.implemented_tools(),
        bdoctools.implemented_tools(),
        inpstools.implemented_tools(),
        modutools.implemented_tools(),
        nfctools.implemented_tools(),
        restools.implemented_tools(),
        senstools.implemented_tools(),
        kcomptools.implemented_tools(),
        ttranstools.implemented_tools(),
        tgtottools.implemented_tools(),
        tproftools.implemented_tools(),
        tkeyqtools.implemented_tools(),
        ttrptools.implemented_tools(),
        tlkptools.implemented_tools(),
        tunptools.implemented_tools(),
        tcsvtools.implemented_tools(),
        tapptools.implemented_tools(),
        tcoltools.implemented_tools(),
        tordtools.implemented_tools(),
        tgrptools.implemented_tools(),
        trevtools.implemented_tools(),
        dcmptools.implemented_tools(),
        conntools.implemented_tools(),
        abudtools.implemented_tools(),
        adiagtools.implemented_tools(),
        aacctools.implemented_tools(),
        aedittools.implemented_tools(),
        aknowtools.implemented_tools(),
        amemtools.implemented_tools(),
        aasstools.implemented_tools(),
        fintools.implemented_tools(),
        indtools.implemented_tools(),
        inftools.implemented_tools(),
        probtools.implemented_tools(),
        tstools.implemented_tools()
    ];
    for gi len(groups) {
        let g = groups[gi];
        for ti len(g) {
            out[len(out)] = g[ti];
        }
    }
    out[len(out)] = "tool_catalog";
    out[len(out)] = "tools_catalog";
    out[len(out)] = "tool_search";
    out[len(out)] = "tools_search";
    out[len(out)] = "implemented_catalog";
    out[len(out)] = "tools_runtime_status";
    out[len(out)] = "tool_status";
    return _dedupe(out);
}

export tool_catalog, implemented_catalog, find_tool, search_tools, category_counts,
       status, implemented_tool_names, native_catalog_tool_count;
