// Native pblang translations for deterministic text/compress/summarize tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let sec = import("src/security.sapp");
let core = import("src/core_tools.sapp");

fn _max(max_chars) {
    if max_chars == nil { return 4000; }
    if max_chars < 1 { return 1; }
    if max_chars > sec.MAX_READ_CHARS { return sec.MAX_READ_CHARS; }
    return max_chars;
}

fn _clip(text, max_chars) {
    let m = _max(max_chars);
    let s = str(text);
    if len(s) <= m { return s; }
    return str_slice(s, 0, m) + "\n... truncated at " + str(m) + " chars";
}

fn _lines(text) {
    return str_split(str(text), "\n");
}

fn _join(items, sep) {
    let out = "";
    for i len(items) {
        if i > 0 { out = out + sep; }
        out = out + str(items[i]);
    }
    return out;
}

fn _line_join(items) {
    return _join(items, "\n");
}

fn _starts_any(s, prefixes) {
    for i len(prefixes) {
        if str_starts_with(s, prefixes[i]) { return true; }
    }
    return false;
}

fn _clean_token(w) {
    let s = str_lower(str(w));
    let out = "";
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if str_contains(allowed, ch) {
            out = out + ch;
        }
    }
    return out;
}

fn _words(text) {
    let s = str_replace_all(str(text), "\n", " ");
    s = str_replace_all(s, "\t", " ");
    s = str_replace_all(s, ".", " ");
    s = str_replace_all(s, ",", " ");
    s = str_replace_all(s, ":", " ");
    s = str_replace_all(s, ";", " ");
    s = str_replace_all(s, "(", " ");
    s = str_replace_all(s, ")", " ");
    s = str_replace_all(s, "[", " ");
    s = str_replace_all(s, "]", " ");
    s = str_replace_all(s, "{", " ");
    s = str_replace_all(s, "}", " ");
    let raw = str_split(s, " ");
    let out = [];
    for i len(raw) {
        let w = _clean_token(raw[i]);
        if w != "" { out[len(out)] = w; }
    }
    return out;
}

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _unique_push(arr, value) {
    if value == nil or value == "" { return arr; }
    if not _contains(arr, value) { arr[len(arr)] = value; }
    return arr;
}

fn _top_counts(counts, limit) {
    let keys = map_keys(counts);
    let out = [];
    let used = map{};
    let n = sec.clamp(limit, 1, 200);
    for k n {
        let best = nil;
        let best_count = -1;
        for i len(keys) {
            let key = keys[i];
            let already = try used[key] catch false;
            if already != true {
                let c = counts[key];
                if c > best_count {
                    best = key;
                    best_count = c;
                }
            }
        }
        if best != nil {
            used[best] = true;
            out[len(out)] = map{ term: best, count: best_count };
        }
    }
    return out;
}

fn summarize_token_estimate(text, max_chars) {
    let s = _clip(text, max_chars);
    return map{
        chars: len(s),
        rough_tokens: num_floor(len(s) / 4) + 1,
        rough_words: len(_words(s)),
    };
}

fn compress_markdown_links(text, max_chars) {
    let words = str_split(str(text), " ");
    let out = [];
    for i len(words) {
        let w = words[i];
        if str_starts_with(w, "http://") or str_starts_with(w, "https://") {
            out[len(out)] = "[link]";
        } else {
            out[len(out)] = w;
        }
    }
    return _clip(_join(out, " "), max_chars);
}

fn compress_unified_diff_stats(text, max_chars) {
    let lines = _lines(text);
    let added = 0;
    let removed = 0;
    let files = [];
    let hunks = 0;
    for i len(lines) {
        let line = lines[i];
        if str_starts_with(line, "@@") { hunks = hunks + 1; }
        if str_starts_with(line, "+++ ") or str_starts_with(line, "--- ") {
            files = _unique_push(files, line);
        } else if str_starts_with(line, "+") {
            added = added + 1;
        } else if str_starts_with(line, "-") {
            removed = removed + 1;
        }
    }
    return map{ lines: len(lines), hunks: hunks, added: added, removed: removed, file_headers: files };
}

fn compress_truncate_lines(text, max_lines, max_chars) {
    let lines = _lines(text);
    let n = sec.clamp(max_lines, 1, 2000);
    let out = [];
    let lim = n;
    if lim > len(lines) { lim = len(lines); }
    for i lim { out[len(out)] = lines[i]; }
    return _clip(_line_join(out), max_chars);
}

fn summarize_diff_file_list(text, max_files) {
    let lines = _lines(text);
    let files = [];
    let n = sec.clamp(max_files, 1, 1000);
    for i len(lines) {
        if len(files) >= n { return files; }
        let line = lines[i];
        if str_starts_with(line, "+++ ") or str_starts_with(line, "--- ") {
            let p = str_trim(str_slice(line, 4, len(line)));
            if str_starts_with(p, "a/") or str_starts_with(p, "b/") {
                p = str_slice(p, 2, len(p));
            }
            if p != "/dev/null" { files = _unique_push(files, p); }
        }
    }
    return files;
}

fn summarize_top_terms(text, top_n, max_chars) {
    let words = _words(_clip(text, max_chars));
    let counts = map{};
    for i len(words) {
        let w = words[i];
        if len(w) >= 2 {
            if map_has(counts, w) { counts[w] = counts[w] + 1; }
            else { counts[w] = 1; }
        }
    }
    return _top_counts(counts, top_n);
}

fn summarize_identifier_frequency(text, top_n, max_chars) {
    let words = _words(_clip(text, max_chars));
    let counts = map{};
    for i len(words) {
        let w = words[i];
        if str_contains(w, "_") or len(w) >= 4 {
            if map_has(counts, w) { counts[w] = counts[w] + 1; }
            else { counts[w] = 1; }
        }
    }
    return _top_counts(counts, top_n);
}

fn compress_strip_tags(text, max_chars) {
    let out = "";
    let in_tag = false;
    let s = str(text);
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if ch == "<" {
            in_tag = true;
        } else if ch == ">" {
            in_tag = false;
        } else if not in_tag {
            out = out + ch;
        }
    }
    return _clip(out, max_chars);
}

fn compress_fenced_code_blocks(text, max_chars) {
    let lines = _lines(text);
    let out = [];
    let in_block = false;
    for i len(lines) {
        let line = lines[i];
        if str_starts_with(str_trim(line), "```") {
            if not in_block {
                out[len(out)] = "[fenced code block omitted]";
                in_block = true;
            } else {
                in_block = false;
            }
        } else if not in_block {
            out[len(out)] = line;
        }
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_double_slash_line_comments(text, max_chars, drop_blank_lines) {
    let lines = _lines(text);
    let out = [];
    for i len(lines) {
        let line = lines[i];
        let idx = str_index_of(line, "//");
        if idx >= 0 {
            line = str_slice(line, 0, idx);
        }
        if drop_blank_lines == true {
            if str_trim(line) != "" { out[len(out)] = line; }
        } else {
            out[len(out)] = line;
        }
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_redact_urls(text, max_chars) {
    let words = str_split(str(text), " ");
    for i len(words) {
        if str_starts_with(words[i], "http://") or str_starts_with(words[i], "https://") {
            words[i] = "[redacted-url]";
        }
    }
    return _clip(_join(words, " "), max_chars);
}

fn compress_redact_emails(text, max_chars) {
    let words = str_split(str(text), " ");
    for i len(words) {
        if str_contains(words[i], "@") and str_contains(words[i], ".") {
            words[i] = "[redacted-email]";
        }
    }
    return _clip(_join(words, " "), max_chars);
}

fn compress_markdown_frontmatter(text, max_chars) {
    let lines = _lines(text);
    if len(lines) == 0 { return ""; }
    if str_trim(lines[0]) != "---" { return _clip(text, max_chars); }
    let out = [];
    let in_front = true;
    for i len(lines) {
        if i == 0 {
            // first delimiter
        } else if in_front and str_trim(lines[i]) == "---" {
            in_front = false;
        } else if not in_front {
            out[len(out)] = lines[i];
        }
    }
    return _clip(_line_join(out), max_chars);
}

fn summarize_duplicate_lines(text, min_count, max_items) {
    let lines = _lines(text);
    let counts = map{};
    for i len(lines) {
        let l = str_trim(lines[i]);
        if l != "" {
            if map_has(counts, l) { counts[l] = counts[l] + 1; }
            else { counts[l] = 1; }
        }
    }
    let keys = map_keys(counts);
    let out = [];
    let n = sec.clamp(max_items, 1, 200);
    for i len(keys) {
        if len(out) >= n { return out; }
        let k = keys[i];
        if counts[k] >= min_count {
            out[len(out)] = map{ line: k, count: counts[k] };
        }
    }
    return out;
}

fn summarize_line_histogram(text, max_chars) {
    let lines = _lines(_clip(text, max_chars));
    let buckets = map{ empty: 0, short: 0, medium: 0, long: 0 };
    for i len(lines) {
        let n = len(lines[i]);
        if n == 0 { buckets.empty = buckets.empty + 1; }
        else if n < 40 { buckets.short = buckets.short + 1; }
        else if n < 120 { buckets.medium = buckets.medium + 1; }
        else { buckets.long = buckets.long + 1; }
    }
    return buckets;
}

fn summarize_line_prefix_groups(text, prefix_len, max_items) {
    let lines = _lines(text);
    let counts = map{};
    let n = sec.clamp(prefix_len, 1, 80);
    for i len(lines) {
        let l = lines[i];
        let end = n;
        if end > len(l) { end = len(l); }
        let p = str_slice(l, 0, end);
        if map_has(counts, p) { counts[p] = counts[p] + 1; }
        else { counts[p] = 1; }
    }
    return _top_counts(counts, max_items);
}

fn summarize_rank_lines_by_keywords(text, keywords, max_items, max_chars) {
    let lines = _lines(_clip(text, max_chars));
    let out = [];
    let n = sec.clamp(max_items, 1, 200);
    for i len(lines) {
        let score = 0;
        let l = str_lower(lines[i]);
        for k len(keywords) {
            if str_contains(l, str_lower(str(keywords[k]))) { score = score + 1; }
        }
        if score > 0 {
            out[len(out)] = map{ line: i + 1, score: score, text: lines[i] };
        }
        if len(out) >= n { return out; }
    }
    return out;
}

fn compress_paragraphs(text, max_paragraphs, max_chars) {
    let parts = str_split(str(text), "\n\n");
    let out = [];
    let n = sec.clamp(max_paragraphs, 1, 200);
    for i len(parts) {
        if len(out) >= n { return _clip(_join(out, "\n\n"), max_chars); }
        let p = str_trim(parts[i]);
        if p != "" { out[len(out)] = p; }
    }
    return _clip(_join(out, "\n\n"), max_chars);
}

fn compress_unique_lines(text, max_lines, max_chars) {
    let lines = _lines(text);
    let out = [];
    let n = sec.clamp(max_lines, 1, 2000);
    for i len(lines) {
        if len(out) >= n { return _clip(_line_join(out), max_chars); }
        if not _contains(out, lines[i]) { out[len(out)] = lines[i]; }
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_lines_head(text, head_lines, max_chars) {
    return compress_truncate_lines(text, head_lines, max_chars);
}

fn compress_lines_tail(text, tail_lines, max_chars) {
    let lines = _lines(text);
    let n = sec.clamp(tail_lines, 1, 2000);
    let start = len(lines) - n;
    if start < 0 { start = 0; }
    let out = [];
    let i = start;
    while i < len(lines) {
        out[len(out)] = lines[i];
        i = i + 1;
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_collapse_blank_lines(text, max_chars) {
    let lines = _lines(text);
    let out = [];
    let last_blank = false;
    for i len(lines) {
        let blank = str_trim(lines[i]) == "";
        if blank {
            if not last_blank { out[len(out)] = ""; }
        } else {
            out[len(out)] = lines[i];
        }
        last_blank = blank;
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_truncate_middle(text, head_chars, tail_chars, max_chars) {
    let s = str(text);
    let h = sec.clamp(head_chars, 0, max_chars);
    let t = sec.clamp(tail_chars, 0, max_chars);
    if len(s) <= max_chars { return s; }
    let tail_start = len(s) - t;
    if tail_start < h { tail_start = h; }
    return str_slice(s, 0, h) + "\n... middle truncated ...\n" + str_slice(s, tail_start, len(s));
}

fn compress_dedent(text, max_chars) {
    let lines = _lines(text);
    let min_indent = nil;
    for i len(lines) {
        let l = lines[i];
        if str_trim(l) != "" {
            let count = 0;
            while count < len(l) and str_slice(l, count, count + 1) == " " {
                count = count + 1;
            }
            if min_indent == nil or count < min_indent { min_indent = count; }
        }
    }
    if min_indent == nil { min_indent = 0; }
    let out = [];
    for i len(lines) {
        let l = lines[i];
        if len(l) >= min_indent { out[len(out)] = str_slice(l, min_indent, len(l)); }
        else { out[len(out)] = l; }
    }
    return _clip(_line_join(out), max_chars);
}

fn compress_sentences(text, max_sentences, max_chars) {
    let parts = str_split(str_replace_all(str(text), "\n", " "), ".");
    let out = [];
    let n = sec.clamp(max_sentences, 1, 200);
    for i len(parts) {
        if len(out) >= n { return _clip(_join(out, ". ") + ".", max_chars); }
        let p = str_trim(parts[i]);
        if p != "" { out[len(out)] = p; }
    }
    if len(out) == 0 { return ""; }
    return _clip(_join(out, ". ") + ".", max_chars);
}

fn summarize_bullets(text, max_items, max_chars) {
    let lines = _lines(text);
    let out = [];
    let n = sec.clamp(max_items, 1, 200);
    for i len(lines) {
        if len(out) >= n { return out; }
        let l = str_trim(lines[i]);
        if str_starts_with(l, "- ") or str_starts_with(l, "* ") or str_starts_with(l, "+ ") {
            out[len(out)] = _clip(l, max_chars);
        }
    }
    return out;
}

fn summarize_headings(text, max_headings, max_chars) {
    let lines = _lines(text);
    let out = [];
    let n = sec.clamp(max_headings, 1, 200);
    for i len(lines) {
        if len(out) >= n { return out; }
        let l = str_trim(lines[i]);
        if str_starts_with(l, "#") {
            out[len(out)] = map{ line: i + 1, heading: _clip(l, max_chars) };
        }
    }
    return out;
}

fn summarize_markdown_toc(text, max_headings, max_chars) {
    let hs = summarize_headings(text, max_headings, max_chars);
    let out = "";
    for i len(hs) {
        let h = hs[i].heading;
        let level = 0;
        while level < len(h) and str_slice(h, level, level + 1) == "#" {
            level = level + 1;
        }
        let title = str_trim(str_slice(h, level, len(h)));
        let indent = "";
        for j level { if j > 1 { indent = indent + "  "; } }
        out = out + indent + "- " + title + "\n";
    }
    return _clip(out, max_chars);
}

fn _json_shape(v, depth) {
    if depth <= 0 { return type(v); }
    let t = type(v);
    if t == "map" {
        let keys = map_keys(v);
        let out = map{};
        for i len(keys) {
            out[keys[i]] = _json_shape(v[keys[i]], depth - 1);
        }
        return out;
    }
    if t == "array" {
        if len(v) == 0 { return []; }
        return [_json_shape(v[0], depth - 1)];
    }
    return t;
}

fn summarize_json_structure(text, max_chars) {
    let raw = _clip(text, max_chars);
    let v = JSON.try_parse(raw);
    if v == nil { return map{ ok: false, error: "invalid JSON" }; }
    return map{ ok: true, root_type: type(v), shape: _json_shape(v, 4) };
}

fn summarize_delimited_header(text, delimiter, max_columns) {
    let first = try _lines(text)[0] catch "";
    let cols = str_split(first, delimiter);
    let out = [];
    let n = sec.clamp(max_columns, 1, 1000);
    for i len(cols) {
        if len(out) >= n { return out; }
        out[len(out)] = str_trim(cols[i]);
    }
    return out;
}

fn text_levenshtein_distance(a, b, max_len) {
    a = _clip(a, max_len);
    b = _clip(b, max_len);
    let prev = [];
    for j len(b) + 1 { prev[j] = j; }
    for i len(a) {
        let curr = [];
        curr[0] = i + 1;
        for j len(b) {
            let cost = 1;
            if str_slice(a, i, i + 1) == str_slice(b, j, j + 1) { cost = 0; }
            let del = prev[j + 1] + 1;
            let ins = curr[j] + 1;
            let sub = prev[j] + cost;
            let best = del;
            if ins < best { best = ins; }
            if sub < best { best = sub; }
            curr[j + 1] = best;
        }
        prev = curr;
    }
    return prev[len(b)];
}

fn text_token_jaccard(a, b, max_len) {
    let wa = _words(_clip(a, max_len));
    let wb = _words(_clip(b, max_len));
    let set = map{};
    let inter = 0;
    for i len(wa) { set[wa[i]] = true; }
    let union = map{};
    for i len(wa) { union[wa[i]] = true; }
    for i len(wb) {
        if (try set[wb[i]] catch false) == true { inter = inter + 1; }
        union[wb[i]] = true;
    }
    let uk = map_keys(union);
    if len(uk) == 0 { return 1.0; }
    return inter / len(uk);
}

fn text_longest_common_substring(a, b, max_len_each) {
    a = _clip(a, max_len_each);
    b = _clip(b, max_len_each);
    let best = "";
    for i len(a) {
        for j len(b) {
            let k = 0;
            while i + k < len(a) and j + k < len(b) and str_slice(a, i + k, i + k + 1) == str_slice(b, j + k, j + k + 1) {
                k = k + 1;
            }
            if k > len(best) {
                best = str_slice(a, i, i + k);
            }
        }
    }
    return map{ length: len(best), text: best };
}

fn text_djb2_hash(text) {
    let hash = 5381;
    let s = str(text);
    let alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        // pblang does not expose char-code in every runtime build; use byte-ish
        // length of the character plus first-character equality buckets.
        let code = str_index_of(alphabet, ch);
        if code < 0 { code = len(ch); }
        else { code = code + 1; }
        hash = ((hash * 33) + code) % 4294967296;
    }
    return str(hash);
}

fn summarize_first_lines(text, line_count, max_chars) {
    return compress_lines_head(text, line_count, max_chars);
}

fn summarize_segments(text, segment_chars, max_segments, max_chars) {
    let s = _clip(text, max_chars);
    let size = sec.clamp(segment_chars, 20, 4000);
    let n = sec.clamp(max_segments, 1, 100);
    let out = [];
    let i = 0;
    while i < len(s) and len(out) < n {
        let end = i + size;
        if end > len(s) { end = len(s); }
        out[len(out)] = map{ start: i, end: end, text: str_slice(s, i, end) };
        i = end;
    }
    return out;
}

fn summarize_file(path, max_chars) {
    let text = core.read_file(path, nil, nil, max_chars);
    return summarize_text(text, max_chars, 6);
}

fn summarize_multi_file(paths, max_chars_each) {
    let out = [];
    for i len(paths) {
        out[len(out)] = map{ path: paths[i], summary: summarize_file(paths[i], max_chars_each) };
    }
    return out;
}

fn summarize_text(text, max_chars, max_sentences) {
    return compress_sentences(text, max_sentences, max_chars);
}

fn call_text(tool, args) {
    if args == nil { args = map{}; }
    if tool == "summarize_token_estimate" { return summarize_token_estimate(try args.text catch "", try args.max_chars catch 4000); }
    if tool == "compress_markdown_links" { return compress_markdown_links(try args.text catch "", try args.max_chars catch 4000); }
    if tool == "compress_unified_diff_stats" { return compress_unified_diff_stats(try args.text catch "", try args.max_chars catch 4000); }
    if tool == "compress_truncate_lines" { return compress_truncate_lines(try args.text catch "", try args.max_lines catch 80, try args.max_chars catch 4000); }
    if tool == "summarize_diff_file_list" { return summarize_diff_file_list(try args.text catch "", try args.max_files catch 200); }
    if tool == "summarize_top_terms" { return summarize_top_terms(try args.text catch "", try args.top_n catch 20, try args.max_chars catch 4000); }
    if tool == "summarize_identifier_frequency" { return summarize_identifier_frequency(try args.text catch "", try args.top_n catch 20, try args.max_chars catch 4000); }
    if tool == "compress_strip_tags" { return compress_strip_tags(try args.text catch "", try args.max_chars catch 4000); }
    if tool == "compress_fenced_code_blocks" { return compress_fenced_code_blocks(try args.text catch "", try args.max_chars catch 4000); }
    if tool == "compress_double_slash_line_comments" { return compress_double_slash_line_comments(try args.text catch "", try args.max_chars catch 4000, try args.drop_blank_lines catch true); }
    if tool == "compress_redact_urls" { return compress_redact_urls(try args.text catch "", try args.max_chars catch 4000); }
