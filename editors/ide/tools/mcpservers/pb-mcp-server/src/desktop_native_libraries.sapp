// Trusted local native-library lifetime. No MCP-controlled loader or names.
fn acquire(load, release) {
    let state=map{handles:[],closed:false};
    fn close() {
        if state.closed {return;}
        state.closed=true;
        let failed=false;
        // Remove before attempting release: a failed release must not be retried.
        while len(state.handles)>0 {
            let handle=array_pop(state.handles);
            let ok=try [true,release(handle)] catch [false,nil];
            if not ok[0] {failed=true;}
        }
        if failed {throw "native UI library cleanup failed";}
    }
    fn load_all() {
        for name in ["libgtk-4.so.1","libglib-2.0.so.0","libc.so.6","operator_gtk_abi"] {
            let handle=load(name);
            array_push(state.handles,handle);
        }
        return true;
    }
    let loaded=try load_all() catch false;
    if not loaded {
        let cleaned=try [true,close()] catch [false,nil];
        if not cleaned[0] {throw "native UI library acquisition and cleanup failed";}
        throw "native UI library acquisition failed";
    }
    return map{gtk:state.handles[0],glib:state.handles[1],libc:state.handles[2],abi:state.handles[3],close:close};
}
export acquire;
