// Bounded typed table ordering and exact integer aggregation; no I/O.
let Sheet=import("stdlib:sheet_document.sapp");
let Groups=import("table_groups.sapp");
fn _fail(){throw "Invalid table ordering or integer aggregation arguments";}
fn implemented_tools(){return ["data_table_sort_rows","data_table_group_integer_stats"];}
fn _column(value,columns){return type(value)=="number" and value>=0 and value<columns and value==num_floor(value);}
fn _integer(text){
 let bytes=str_to_bytes(text);let size=len(bytes);if size<1 or size>11 {_fail();}
 let start=0;let negative=bytes[0]==45;if negative {start=1;}
 if start==size or (size-start>1 and bytes[start]==48) {_fail();}
 let value=0;
 for i in range(start,size){if bytes[i]<48 or bytes[i]>57 {_fail();}value=value*10+bytes[i]-48;if value>1000000000 {_fail();}}
 if value==0 {return 0;}return if negative {-value} else {value};
}
fn _text_compare(a,b){
 let count=len(a);if len(b)<count {count=len(b);}
 for i count {if a[i]<b[i] {return -1;}if a[i]>b[i] {return 1;}}
 if len(a)<len(b) {return -1;}if len(a)>len(b) {return 1;}return 0;
}
fn _before(a,b,keys){
 for k len(keys){
  let comparison=0;
  if keys[k].type=="text" {comparison=_text_compare(a[k],b[k]);} else {if a[k]<b[k] {comparison=-1;}if a[k]>b[k] {comparison=1;}}
  if comparison!=0 {return if keys[k].descending {comparison>0} else {comparison<0};}
 }
 return false;
}
fn _sort(doc,keys,header,size){
 if type(keys)!="array" or len(keys)<1 or len(keys)>size.columns {_fail();}
 let normalized=[];let seen=[];
 for key in keys {
  if type(key)!="map" or not map_has(key,"column") or not map_has(key,"type") {_fail();}
  for field in map_keys(key){if field!="column" and field!="type" and field!="descending" {_fail();}}
  if not _column(key.column,size.columns) or (key.type!="text" and key.type!="integer") {_fail();}
  let descending=try key.descending catch false;if type(descending)!="bool" {_fail();}
  for column in seen {if column==key.column {_fail();}}push(seen,key.column);
  push(normalized,map{column:key.column,type:key.type,descending:descending});
 }
 let start=if header {1} else {0};let values=[];let indices=[];
 // Prevalidate every numeric key before comparing, even for a singleton table.
 for row in range(start,size.rows){
  let value=[];for key in normalized {push(value,if key.type=="text" {str_to_bytes(doc.cells[row][key.column])} else {_integer(doc.cells[row][key.column])});}
  push(values,value);push(indices,row);
 }
 // At most32 rows. Moving only strictly smaller rows preserves all ties.
 for i in range(1,len(indices)){
  let row=indices[i];let j=i;
  while j>0 and _before(values[row-start],values[indices[j-1]-start],normalized){indices[j]=indices[j-1];j=j-1;}
  indices[j]=row;
 }
 let detached=Sheet.copy(doc);let cells=[];if header {push(cells,detached.cells[0]);}
 for row in indices {push(cells,detached.cells[row]);}detached.cells=cells;
 return map{document:detached,source_indices:indices,keys:normalized,rows_checked:size.rows-start,stable:true,text_order:"unicode_scalar",contains_headers:header};
}
fn _stats(args,header,size){
 if not map_has(args,"key_columns") or not map_has(args,"value_column") or not _column(args.value_column,size.columns) {_fail();}
 let counted=try Groups.call_groups("data_table_group_counts",map{document:args.document,key_columns:args.key_columns,header:header}) catch nil;
 if counted==nil {_fail();}
 let groups=[];let positions=map{};
 for group in counted.groups {positions[json_stringify(group.key)]=len(groups);push(groups,map{key:group.key,count:group.count,sum:0,min:nil,max:nil});}
 let start=if header {1} else {0};
 for row in range(start,size.rows){
  let key=[];for column in args.key_columns {push(key,args.document.cells[row][column]);}
  let group=groups[positions[json_stringify(key)]];let value=_integer(args.document.cells[row][args.value_column]);
  group.sum=group.sum+value;if group.min==nil or value<group.min {group.min=value;}if group.max==nil or value>group.max {group.max=value;}
 }
 return map{groups:groups,key_columns:counted.key_columns,value_column:args.value_column,rows_checked:size.rows-start,returned_group_count:len(groups),group_order:"first_occurrence",matching:"exact_string_tuple",contains_headers:false};
}
fn call_order(name,args){
 if name!="data_table_sort_rows" and name!="data_table_group_integer_stats" {return nil;}
 if type(args)!="map" or not map_has(args,"document") {_fail();}
 let sorting=name=="data_table_sort_rows";
 for field in map_keys(args){if field!="document" and field!="header" and not(sorting and field=="keys") and not(not sorting and (field=="key_columns" or field=="value_column")) {_fail();}}
 let size=try Sheet.validate(args.document) catch nil;if size==nil {_fail();}
 let header=try args.header catch false;if type(header)!="bool" {_fail();}
 if len(str_to_bytes(json_stringify(args)))>65536 {_fail();}
 let result:any=nil;
 if sorting {if not map_has(args,"keys") {_fail();}result=_sort(args.document,args.keys,header,size);} else {result=_stats(args,header,size);}
 result.format="pb_mcp."+name+".v1";result.header=header;result.index_base=0;result.numeric_format="signed_integer_1e9";
 result.normalization="none";result.contains_cell_text=true;result.safe_to_log=false;result.native_pblang=true;result.data_source="caller_supplied";
 result.effects_performed=false;result.network_used=false;result.model_loaded=false;result.automatic_deletion=false;result.formulas_evaluated=false;
 if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}return result;
}
fn catalog_entries(){
 let document=map{type:"object",required:["format","cells"],additionalProperties:false,properties:map{format:map{type:"string",enum:["pblang.sheet-document.v1"]},cells:map{type:"array",minItems:1,maxItems:32,items:map{type:"array",minItems:1,maxItems:8,items:map{type:"string",maxLength:256}}}},description:"Rectangular literal strings1..32rows x1..8columns; max256UTF8bytes/cell,8192total, no NUL. Runtime verifies bytes and shape."};
 let column=map{type:"integer",minimum:0,maximum:7};let names=implemented_tools();let out=[];
 for i len(names){
  let fields=map{document:document,header:map{type:"boolean",default:false}};let required=["document"];let description="";
  if i==0 {
   fields.keys=map{type:"array",minItems:1,maxItems:8,items:map{type:"object",required:["column","type"],additionalProperties:false,properties:map{column:column,type:map{type:"string",enum:["text","integer"]},descending:map{type:"boolean",default:false}}},description:"Distinct in-range columns in priority order. Explicit type; optional independent descending direction."};push(required,"keys");
   description="Stable multi-key row sort; return detached literal table and absolute source data-row indices. Text uses Unicode scalar lexicographic order (equivalent UTF8byte order), no locale. Empty text first ascending. Equal keys preserve source order even descending. Header retained once and excluded from comparisons.";
  } else {
   fields.key_columns=map{type:"array",minItems:1,maxItems:8,uniqueItems:true,items:column};fields.value_column=column;push(required,"key_columns");push(required,"value_column");
   description="Count, sum, min and max of integer cells per exact composite literal key, up to32groups in first-occurrence order. key_columns unique in-range, caller order preserved; overlap with value_column allowed. Exact JSON tuple identity; no key coercion. No mean/rounding. Sums bounded by32000000000. Header excluded.";
  }
  push(out,map{name:names[i],category:"table-order",profile:"core-code",source:"src/table_order.sapp",read_only:true,destructive:false,open_world:false,input_schema:map{type:"object",required:required,additionalProperties:false,properties:fields},description:description+" Numeric cells must be ASCII -?(0|[1-9][0-9]*) with absolute value<=1000000000; -0 equals0. Empty, padding, plus, leading zeros, decimals, exponents, formulas and nonfinite names refuse the whole operation. Every selected numeric data cell validated. Header-only valid empty data. Literal text unchanged: no trimming/casefold/Unicode normalization. Arguments/output<=65536serializedUTF8bytes. Caller-private cell text returned; safe_to_log:false. No file/network/model/storage/formula execution/automatic collection or deletion."});
 }
 return out;
}
fn functional_records(){let out=[];for entry in catalog_entries(){push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,reason:"Bounded typed multikey ordering and exact integer group aggregates",evidence_ids:["pb_mcp_table_order:stable_sort","pb_mcp_table_order:integer_groups","pb_mcp_table_order:bounds","pb_mcp_table_order:privacy_parity"]});}return out;}
export implemented_tools,call_order,catalog_entries,functional_records;
