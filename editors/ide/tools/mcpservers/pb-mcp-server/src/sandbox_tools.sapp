// Native pblang sandbox execution planners.
//
// Read-only sandbox helpers live in file_tools.sapp. These handlers cover the
// execution/network/watch sandbox catalog entries as gated plans only.

let sec = import("security.sapp");

let SANDBOX_TOOLS = [
    "sandbox_docker_run", "sandbox_eval_code", "sandbox_exec",
    "sandbox_file_watch", "sandbox_network_request", "sandbox_script",
];

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _safe_word(value, fallback = "") {
    let s = str(value);
    if s == "" { return fallback; }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-";
    for i len(s) {
        if not str_contains(allowed, str_slice(s, i, i + 1)) { throw "unsafe bare word: " + s; }
    }
    return s;
}

fn _interpreter(value) {
    let p = _safe_word(value, "python3");
    if p == "python3" or p == "node" or p == "bash" or p == "ruby" or p == "perl" { return p; }
    throw "unsupported sandbox interpreter: " + p;
}

fn _gate(kind) {
    return map{ blocked: sec.is_public_profile(), profile: sec.network_profile(), requires: ["trusted profile", "sandbox executor", kind + " allowlist"] };
}

fn _url_private(url) {
    let u = str_lower(str(url));
    if str_contains(u, "localhost") or str_contains(u, "127.0.0.1") { return true; }
    if str_contains(u, "://10.") or str_contains(u, "://192.168.") or str_contains(u, "://169.254.") { return true; }
    return false;
}

fn _plan(tool, program, argv, extra = nil) {
    if extra == nil { extra = map{}; }
    return map{ ok: true, tool: tool, executed: false, program: program, argv: argv, gate: _gate(program), extra: extra };
}

fn sandbox_docker_run(args) {
    if args == nil { args = map{}; }
    let image = str(try args.image catch "debian:stable-slim");
    let mem = sec.clamp(try args.memory_mb catch 256, 32, 8192);
    let argv = ["docker", "run", "--rm", "--network=none", "--cpus=1", "--memory=" + str(mem) + "m", "-v", "$PWD:/workspace:ro", image];
    return _plan("sandbox_docker_run", "docker", argv, map{ image: image, memory_mb: mem });
}

fn sandbox_eval_code(args) {
    if args == nil { args = map{}; }
    let lang = _interpreter(try args.language catch try args.interpreter catch "python3");
    let code = str(try args.code catch "");
    return _plan("sandbox_eval_code", lang, [lang, "<inline>"], map{ code_chars: len(code), stdin_bytes: len(str(try args.stdin catch try args.stdin_text catch "")) });
}

fn sandbox_exec(args) {
    if args == nil { args = map{}; }
    let program = _safe_word(try args.program catch try args.command catch "");
    let argv = try args.argv catch [];
    let safe = [program];
    for i sec.clamp(len(argv), 0, 100) { safe[len(safe)] = str(argv[i]); }
    return _plan("sandbox_exec", program, safe, map{ cwd: sec.safe_rel_path(try args.cwd catch ".", ".") });
}

fn sandbox_file_watch(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    let command = _safe_word(try args.program catch try args.command catch "", "");
    return _plan("sandbox_file_watch", "watcher", ["watch-once", path, command], map{ path: path, poll_ms: sec.clamp(try args.poll_ms catch 1000, 100, 60000) });
}

fn sandbox_network_request(args) {
    if args == nil { args = map{}; }
    let url = str(try args.url catch "");
    let method = str_upper(str(try args.method catch "GET"));
    let ok_url = str_starts_with(str_lower(url), "http://") or str_starts_with(str_lower(url), "https://");
    return map{ ok: ok_url and not _url_private(url), tool: "sandbox_network_request", executed: false, method: method, url: url, ssrf_private_host: _url_private(url), program: "curl", argv: ["curl", "-X", method, url], gate: _gate("curl") };
}

fn sandbox_script(args) {
    if args == nil { args = map{}; }
    let lang = _interpreter(try args.language catch try args.interpreter catch "python3");
    let script = str(try args.script catch try args.source catch "");
    return _plan("sandbox_script", lang, [lang, ".mint-mcp/agent-temp/script"], map{ script_chars: len(script), temp_dir: ".mint-mcp/agent-temp" });
}

fn call_sandbox(tool, args) {
    if tool == "sandbox_docker_run" { return sandbox_docker_run(args); }
    if tool == "sandbox_eval_code" { return sandbox_eval_code(args); }
    if tool == "sandbox_exec" { return sandbox_exec(args); }
    if tool == "sandbox_file_watch" { return sandbox_file_watch(args); }
    if tool == "sandbox_network_request" { return sandbox_network_request(args); }
    if tool == "sandbox_script" { return sandbox_script(args); }
    return nil;
}

fn implemented_tools() {
    let out = [];
    for i len(SANDBOX_TOOLS) { out[len(out)] = SANDBOX_TOOLS[i]; }
    return out;
}

export implemented_tools, call_sandbox, sandbox_docker_run, sandbox_eval_code,
       sandbox_exec, sandbox_file_watch, sandbox_network_request,
       sandbox_script;
