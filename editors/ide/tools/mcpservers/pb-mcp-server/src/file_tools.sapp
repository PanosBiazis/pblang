// Native pblang translations for lightweight file metadata/stat tools.

let FS = import("stdlib:fs.sapp");
let sec = import("security.sapp");
let core = import("core_tools.sapp");

fn _kind(path) {
    let items = try FS.listdir(path) catch nil;
    if type(items) == "array" { return "dir"; }
    let raw = try FS.read(path) catch nil;
    if type(raw) == "string" { return "file"; }
    return "missing";
}

fn _preview(raw, max_chars) {
    max_chars = sec.clamp(max_chars, 0, 4000);
    if len(raw) <= max_chars { return raw; }
    return str_slice(raw, 0, max_chars);
}

fn file_info(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let k = _kind(path);
    let size = try FS.size(path) catch nil;
    return map{
        ok: k != "missing",
        path: path,
        kind: k,
        bytes: size,
        mtime_ms: nil,
        boundary: "pblang fallback reports kind and size; mtime requires a future stat builtin",
    };
}

fn file_stats(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let max_chars = sec.clamp(try args.max_chars catch 8000, 1, sec.MAX_READ_CHARS);
    let raw = try FS.read(path) catch nil;
    if type(raw) != "string" { return map{ ok: false, path: path, error: "file is not readable as text" }; }
    let scan = _preview(raw, max_chars);
    let lines = str_split(scan, "\n");
    let nul = str_contains(scan, "\x00");
    return map{
        ok: true,
        path: path,
        bytes: try FS.size(path) catch len(raw),
        scanned_chars: len(scan),
        truncated: len(raw) > len(scan),
        lines: len(lines),
        newline_count: len(lines) - 1,
        contains_nul: nul,
        preview: _preview(scan, try args.preview_chars catch 240),
    };
}

fn batch_file_info(args) {
    if args == nil { args = map{}; }
    let paths = try args.paths catch [];
    let out = [];
    let n = sec.clamp(len(paths), 0, 30);
    for i n {
        out[len(out)] = file_info(map{ path: paths[i] });
    }
    return out;
}

fn repository_get_file_content(args) {
    if args == nil { args = map{}; }
    let path = try args.path catch try args.file_path catch "";
    let refname = try args.ref catch try args.revision catch "";
    if refname != "" {
        return map{
            ok: false,
            path: path,
            ref: refname,
            error: "revision-backed repository reads are catalog-only in the pblang port; omit ref to read the working tree",
        };
    }
    return map{ ok: true, path: sec.safe_rel_path(path, ""), content: core.read_file(path, try args.start_line catch nil, try args.end_line catch nil, try args.max_chars catch sec.MAX_READ_CHARS) };
}

fn sandbox_checksum(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let algorithm = str_lower(str(try args.algorithm catch "sha256"));
    if algorithm != "sha256" {
        return map{ ok: false, path: path, algorithm: algorithm, error: "pblang native checksum currently supports sha256 only" };
    }
    let raw = FS.read(path);
    return map{ ok: true, path: path, algorithm: "sha256", hash: sha256(raw), bytes: len(raw) };
}

fn _line_diff(a, b) {
    let aa = str_split(str(a), "\n");
    let bb = str_split(str(b), "\n");
    let out = [];
    let maxn = len(aa);
    if len(bb) > maxn { maxn = len(bb); }
    maxn = sec.clamp(maxn, 0, 10000);
    for i maxn {
        let av = if i < len(aa) { aa[i] } else { nil };
        let bv = if i < len(bb) { bb[i] } else { nil };
        if av != bv {
            if av != nil { out[len(out)] = map{ line: i + 1, kind: "remove", text: av }; }
            if bv != nil { out[len(out)] = map{ line: i + 1, kind: "add", text: bv }; }
        }
    }
    return out;
}

fn sandbox_diff(args) {
    if args == nil { args = map{}; }
    let a = try args.text_a catch nil;
    let b = try args.text_b catch nil;
    let path_a = try args.path_a catch try args.from catch "";
    let path_b = try args.path_b catch try args.to catch "";
    if a == nil {
        if path_a == "" { return map{ ok: false, error: "text_a or path_a is required" }; }
        a = FS.read(sec.safe_rel_path(path_a, ""));
    }
    if b == nil {
        if path_b == "" { return map{ ok: false, error: "text_b or path_b is required" }; }
        b = FS.read(sec.safe_rel_path(path_b, ""));
    }
    let changes = _line_diff(a, b);
    return map{ ok: true, changes: changes, change_count: len(changes), format: "pblang-line-diff" };
}

fn call_file(tool, args) {
    if tool == "file_info" { return file_info(args); }
    if tool == "file_stats" { return file_stats(args); }
    if tool == "batch_file_info" { return batch_file_info(args); }
    if tool == "repository_get_file_content" { return repository_get_file_content(args); }
    if tool == "sandbox_checksum" { return sandbox_checksum(args); }
    if tool == "sandbox_diff" { return sandbox_diff(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "file_info",
        "file_stats",
        "batch_file_info",
        "repository_get_file_content",
        "sandbox_checksum",
        "sandbox_diff",
    ];
}

export implemented_tools, call_file,
       file_info, file_stats, batch_file_info, repository_get_file_content,
       sandbox_checksum, sandbox_diff;
