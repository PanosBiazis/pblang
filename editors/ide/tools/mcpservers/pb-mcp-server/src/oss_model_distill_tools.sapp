let _OSSD_MOD_CACHE = map{};

fn _ossd_eng() {
    if map_has(_OSSD_MOD_CACHE, "ossd") { return _OSSD_MOD_CACHE["ossd"]; }
    let m = try import("editors/ide/tools/ai/pbai_web_oss_trainer_v23.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_web_oss_trainer_v23.sapp") catch nil; }
    if m == nil { m = try import("../../ai/pbai_web_oss_trainer_v23.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_web_oss_trainer_v23.sapp") catch nil; }
    if m == nil { m = import("../pblang/editors/ide/tools/ai/pbai_web_oss_trainer_v23.sapp"); }
    _OSSD_MOD_CACHE["ossd"] = m;
    return m;
}

fn mcp_open_source_model_live_quality_trainer(args) { return _ossd_eng().evaluate_open_source_and_external_model_live_trainer(args); }
