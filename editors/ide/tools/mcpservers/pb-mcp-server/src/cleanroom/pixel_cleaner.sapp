// Pure-PBLang bounded PNG inpainting and local pixel regeneration.
// Inpainting requires an explicit mask; no automatic copyright-mark detector is
// implied. Regeneration is deterministic local reconstruction, not diffusion.

let Pipeline = import("stdlib:image_pipeline.sapp");
let Bytes = (try import("./bytekit.sapp") catch (try import("cleanroom/bytekit.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/bytekit.sapp")));

let FORMAT = "pbwatermarks.pixel.v1";
let DEFAULT_MAX_PIXELS = 1048576;
let MAX_PIXELS = 4194304;

fn _error(message) { return map{ ok: false, format: FORMAT, error: message }; }

fn _integer(value, fallback, minimum, maximum) {
    if value == nil { value = fallback; }
    if type(value) != "number" or num_floor(value) != value or value < minimum or value > maximum { return nil; }
    return value;
}

fn _finite(value) {
    if type(value) != "number" { return false; }
    let text = str_lower(str(value)); return not str_contains(text, "inf") and text != "nan";
}

fn _copy(image) {
    let out = [];
    for row in image {
        let next = []; for pixel in row { array_push(next, slice(pixel, 0, 4)); }
        array_push(out, next);
    }
    return out;
}

fn _mask_on(pixel, threshold) {
    let luminance = pixel[0] * 0.299 + pixel[1] * 0.587 + pixel[2] * 0.114;
    return pixel[3] > 0 and luminance >= threshold;
}

fn _average_known(image, unknown, x, y, width, height) {
    let sums = [0, 0, 0, 0]; let count = 0;
    let yy = num_max(0, y - 1);
    while yy <= num_min(height - 1, y + 1) {
        let xx = num_max(0, x - 1);
        while xx <= num_min(width - 1, x + 1) {
            if not (xx == x and yy == y) and not unknown[yy][xx] {
                let channel = 0;
                while channel < 4 { sums[channel] = sums[channel] + image[yy][xx][channel]; channel = channel + 1; }
                count = count + 1;
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    if count == 0 { return nil; }
    return [num_floor(sums[0] / count), num_floor(sums[1] / count),
        num_floor(sums[2] / count), num_floor(sums[3] / count)];
}

fn inpaint_png(image_bytes, mask_bytes, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { return _error("inpainting options must be a map"); }
    let threshold = _integer(try options.threshold catch nil, 128, 0, 255);
    let max_pixels = _integer(try options.max_pixels catch nil, DEFAULT_MAX_PIXELS, 1, MAX_PIXELS);
    let max_iterations = _integer(try options.max_iterations catch nil, 4096, 1, 8192);
    let max_fraction = try options.max_mask_fraction catch 0.50;
    if threshold == nil or max_pixels == nil or max_iterations == nil or not _finite(max_fraction)
        or max_fraction <= 0 or max_fraction > 0.90 {
        return _error("invalid inpainting resource limits");
    }
    let image = try Pipeline.decode_png(image_bytes) catch nil;
    let mask = try Pipeline.decode_png(mask_bytes) catch nil;
    if image == nil or mask == nil { return _error("image and mask must be valid bounded RGBA PNG files"); }
    if image.width != mask.width or image.height != mask.height { return _error("mask dimensions must match the image"); }
    if image.width * image.height > max_pixels { return _error("image exceeds configured pixel budget"); }
    let output = _copy(image.image); let original = _copy(image.image);
    let unknown = []; let queued = [];
    let masked = 0; let y = 0;
    while y < image.height {
        let row = []; let queued_row = []; let x = 0;
        while x < image.width {
            let value = _mask_on(mask.image[y][x], threshold); array_push(row, value);
            array_push(queued_row, false);
            if value { masked = masked + 1; }
            x = x + 1;
        }
        array_push(unknown, row); array_push(queued, queued_row); y = y + 1;
    }
    if masked == 0 { return _error("mask does not select any pixels"); }
    if masked / (image.width * image.height) > max_fraction { return _error("mask exceeds configured area fraction"); }
    let frontier = []; y = 0;
    while y < image.height {
        let x = 0;
        while x < image.width {
            if unknown[y][x]
                and _average_known(output, unknown, x, y, image.width, image.height) != nil {
                array_push(frontier, map{ x: x, y: y }); queued[y][x] = true;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let remaining = masked; let iteration = 0; let processed = 0;
    while remaining > 0 and len(frontier) > 0 and iteration < max_iterations {
        let updates = [];
        for point in frontier {
            if unknown[point.y][point.x] {
                let pixel = _average_known(output, unknown, point.x, point.y,
                    image.width, image.height);
                if pixel != nil { array_push(updates, map{ x: point.x, y: point.y, pixel: pixel }); }
            }
        }
        if len(updates) == 0 { break; }
        for update in updates {
            output[update.y][update.x] = update.pixel;
            unknown[update.y][update.x] = false;
            remaining = remaining - 1; processed = processed + 1;
        }
        let next = [];
        for update in updates {
            let yy = num_max(0, update.y - 1);
            while yy <= num_min(image.height - 1, update.y + 1) {
                let xx = num_max(0, update.x - 1);
                while xx <= num_min(image.width - 1, update.x + 1) {
                    if unknown[yy][xx] and not queued[yy][xx] {
                        array_push(next, map{ x: xx, y: yy }); queued[yy][xx] = true;
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
        }
        frontier = next; iteration = iteration + 1;
    }
    if remaining != 0 { return _error("inpainting could not reach every selected pixel within the iteration budget"); }
    y = 0;
    while y < image.height {
        let x = 0;
        while x < image.width {
            if not _mask_on(mask.image[y][x], threshold) and output[y][x] != original[y][x] {
                return _error("internal inpainting verification found an unmasked pixel mutation");
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let encoded = try Pipeline.encode_png(output) catch nil;
    if encoded == nil { return _error("inpainted image encoding failed"); }
    let verified = try Pipeline.decode_png(encoded) catch nil;
    if verified == nil or verified.width != image.width or verified.height != image.height {
        return _error("inpainted image verification failed");
    }
    return map{ ok: true, format: FORMAT, operation: "inpaint", bytes: encoded,
        changed: Bytes.digest(encoded) != Bytes.digest(image_bytes), width: image.width,
        height: image.height, masked_pixels: masked,
        mask_fraction: masked / (image.width * image.height), iterations: iteration,
        processed_pixels: processed, linear_frontier: true,
        unmasked_pixels_preserved: true, structure_verified: true,
        watermark_removal_guaranteed: false };
}

fn _reconstruct(image, strength) {
    let size = Pipeline.dimensions(image); let out = _copy(image);
    let y = 0;
    while y < size.height {
        let x = 0;
        while x < size.width {
            let sums = [0, 0, 0]; let count = 0;
            let yy = num_max(0, y - 1);
            while yy <= num_min(size.height - 1, y + 1) {
                let xx = num_max(0, x - 1);
                while xx <= num_min(size.width - 1, x + 1) {
                    if not (xx == x and yy == y) {
                        let channel = 0; while channel < 3 { sums[channel] = sums[channel] + image[yy][xx][channel]; channel = channel + 1; }
                        count = count + 1;
                    }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            let channel = 0;
            while channel < 3 {
                let average = if count == 0 { image[y][x][channel] } else { sums[channel] / count };
                out[y][x][channel] = num_floor(image[y][x][channel] * (1.0 - strength) + average * strength);
                channel = channel + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

fn regenerate_png(image_bytes, options = nil) {
    if options == nil { options = map{}; }
    let strength = try options.strength catch 0.20;
    let passes = _integer(try options.passes catch nil, 1, 1, 3);
    let max_pixels = _integer(try options.max_pixels catch nil, DEFAULT_MAX_PIXELS, 1, MAX_PIXELS);
    if not _finite(strength) or strength <= 0 or strength > 0.75 or passes == nil or max_pixels == nil {
        return _error("strength must be in (0, 0.75], passes in 1..3, and max_pixels bounded");
    }
    let decoded = try Pipeline.decode_png(image_bytes) catch nil;
    if decoded == nil { return _error("input must be a valid bounded RGBA PNG"); }
    if decoded.width * decoded.height > max_pixels { return _error("image exceeds configured pixel budget"); }
    let output = decoded.image; let pass = 0;
    while pass < passes { output = _reconstruct(output, strength); pass = pass + 1; }
    let encoded = try Pipeline.encode_png(output) catch nil;
    let verified = if encoded == nil { nil } else { try Pipeline.decode_png(encoded) catch nil };
    if verified == nil or verified.width != decoded.width or verified.height != decoded.height {
        return _error("regenerated image verification failed");
    }
    return map{ ok: true, format: FORMAT, operation: "local-regeneration", bytes: encoded,
        changed: Bytes.digest(encoded) != Bytes.digest(image_bytes), width: decoded.width,
        height: decoded.height, strength: strength, passes: passes,
        structure_verified: true, diffusion_model_used: false,
        watermark_removal_guaranteed: false };
}

fn select_regeneration_candidates(image_bytes, candidates, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { return _error("candidate verification options must be a map"); }
    let allowed = ["max_pixels", "minimum_changed_fraction", "maximum_changed_fraction",
        "maximum_mean_absolute_error", "preserve_alpha"];
    for key in map_keys(options) {
        let known = false; for item in allowed { if key == item { known = true; } }
        if not known { return _error("unknown candidate verification option: " + str(key)); }
    }
    if type(candidates) != "array" or len(candidates) < 1 or len(candidates) > 8 {
        return _error("regeneration candidates must contain 1..8 PNG byte arrays");
    }
    let source = try Pipeline.decode_png(image_bytes) catch nil;
    let max_pixels = _integer(try options.max_pixels catch nil, DEFAULT_MAX_PIXELS, 1, MAX_PIXELS);
    let minimum_changed = try options.minimum_changed_fraction catch 0.000001;
    let maximum_changed = try options.maximum_changed_fraction catch 1.0;
    let maximum_error = try options.maximum_mean_absolute_error catch 96.0;
    let preserve_alpha = try options.preserve_alpha catch true;
    if source == nil or max_pixels == nil or source.width * source.height > max_pixels
        or type(preserve_alpha) != "bool"
        or not _finite(minimum_changed) or not _finite(maximum_changed) or not _finite(maximum_error)
        or minimum_changed < 0 or maximum_changed > 1 or minimum_changed > maximum_changed
        or maximum_error < 0 or maximum_error > 255 {
        return _error("invalid source image or candidate verification limits");
    }
    let evidence = []; let accepted = []; let total_candidate_bytes = 0; let index = 0;
    while index < len(candidates) {
        let bytes = candidates[index];
        if type(bytes) != "array" { return _error("every regeneration candidate must be PNG bytes"); }
        total_candidate_bytes = total_candidate_bytes + len(bytes);
        if total_candidate_bytes > 33554432 { return _error("combined regeneration candidates exceed 32 MiB"); }
        let decoded = try Pipeline.decode_png(bytes) catch nil;
        if decoded == nil or decoded.width != source.width or decoded.height != source.height {
            array_push(evidence, map{ index: index, accepted: false, error: "candidate dimensions or PNG structure differ" });
        } else {
            let changed = 0; let alpha_changed = 0; let absolute_error = 0; let y = 0;
            while y < source.height {
                let x = 0;
                while x < source.width {
                    let different = false; let channel = 0;
                    while channel < 3 {
                        let delta = num_abs(decoded.image[y][x][channel] - source.image[y][x][channel]);
                        absolute_error = absolute_error + delta; if delta != 0 { different = true; }
                        channel = channel + 1;
                    }
                    if decoded.image[y][x][3] != source.image[y][x][3] { alpha_changed = alpha_changed + 1; different = true; }
                    if different { changed = changed + 1; }
                    x = x + 1;
                }
                y = y + 1;
            }
            let pixels = source.width * source.height;
            let changed_fraction = changed / pixels;
            let mean_error = absolute_error / (pixels * 3);
            let valid = changed_fraction >= minimum_changed and changed_fraction <= maximum_changed
                and mean_error <= maximum_error and (not preserve_alpha or alpha_changed == 0);
            let item = map{ index: index, accepted: valid, changed_pixels: changed,
                changed_fraction: changed_fraction, mean_absolute_error: mean_error,
                alpha_changed_pixels: alpha_changed,
                score: 1.0 - mean_error / 255.0, bytes: bytes };
            array_push(evidence, item); if valid { array_push(accepted, item); }
        }
        index = index + 1;
    }
    if len(accepted) == 0 {
        for item in evidence { if map_has(item, "bytes") { map_remove(item, "bytes"); } }
        return map{ ok: false, format: FORMAT,
            error: "no regeneration candidate passed bounded visual-integrity checks",
            evidence: evidence };
    }
    let best = accepted[0]; index = 1;
    while index < len(accepted) { if accepted[index].score > best.score { best = accepted[index]; } index = index + 1; }
    let selected_bytes = best.bytes;
    for item in evidence { if map_has(item, "bytes") { map_remove(item, "bytes"); } }
    map_remove(best, "bytes");
    return map{ ok: true, format: FORMAT, operation: "verified-external-regeneration",
        bytes: selected_bytes, changed: true, width: source.width, height: source.height,
        selected: best, evidence: evidence, candidates_evaluated: len(candidates),
        structure_verified: true, provider_independent: true,
        diffusion_candidate_supported: true, diffusion_model_verified: false,
        semantic_visual_equivalence_guaranteed: false, watermark_removal_guaranteed: false };
}

export FORMAT, DEFAULT_MAX_PIXELS, MAX_PIXELS, inpaint_png, regenerate_png;
export select_regeneration_candidates;
