let Image = (try import("./image_cleaner.sapp") catch (try import("cleanroom/image_cleaner.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/image_cleaner.sapp")));
let Container = (try import("./container_cleaner.sapp") catch (try import("cleanroom/container_cleaner.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/container_cleaner.sapp")));
let Bytes = (try import("./bytekit.sapp") catch (try import("cleanroom/bytekit.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/bytekit.sapp")));

let FORMAT = "pbwatermarks.dispatch.v1";

fn _suffix(filename) {
    let name = str_lower(str(filename));
    let at = -1;
    let i = 0;
    while i < len(name) {
        if str_slice(name, i, i + 1) == "." { at = i; }
        i = i + 1;
    }
    if at < 0 { return ""; }
    return str_slice(name, at, len(name));
}

fn _in(values, value) {
    for item in values { if item == value { return true; } }
    return false;
}

fn _expected(ext) {
    if _in([".png", ".jpg", ".jpeg", ".webp"], ext) { return "image"; }
    if _in([".svg", ".pdf", ".docx", ".odt", ".html", ".htm",
        ".md", ".markdown", ".mdx"], ext) { return "container"; }
    if _in([".txt", ".text", ".css", ".js", ".ts", ".py", ".rs",
        ".go", ".sapp", ".sap", ".json", ".yaml", ".yml", ".toml",
        ".csv", ".xml", ".ini", ".conf", ".log"], ext) { return "text"; }
    return "unknown";
}

fn _binary_signature(bytes) {
    let signatures = [
        map{ bytes: [80, 75, 3, 4], label: "zip" },
        map{ bytes: [37, 80, 68, 70, 45], label: "pdf" },
        map{ bytes: [137, 80, 78, 71, 13, 10, 26, 10], label: "png" },
        map{ bytes: [255, 216, 255], label: "jpeg" },
        map{ bytes: [71, 73, 70, 56], label: "gif" },
        map{ bytes: [127, 69, 76, 70], label: "elf" },
        map{ bytes: [31, 139], label: "gzip" },
        map{ bytes: [55, 122, 188, 175, 39, 28], label: "7zip" },
        map{ bytes: [83, 81, 76, 105, 116, 101, 32, 102, 111, 114, 109, 97, 116, 32, 51, 0], label: "sqlite" }
    ];
    for signature in signatures {
        if Bytes.equals_at(bytes, 0, signature.bytes) { return signature.label; }
    }
    if len(bytes) >= 12 and Bytes.ascii(bytes, 0, 4) == "RIFF" { return "riff"; }
    return "";
}

fn _looks_text(bytes) {
    let text = try bytes_to_str(bytes) catch nil;
    if text == nil { return false; }
    let sample = num_min(len(bytes), 8192);
    let controls = 0;
    let i = 0;
    while i < sample {
        let value = bytes[i];
        if value == 0 { return false; }
        if value < 32 and value != 9 and value != 10 and value != 11
            and value != 12 and value != 13 and value != 27 {
            controls = controls + 1;
        }
        i = i + 1;
    }
    return sample == 0 or controls / sample <= 0.05;
}

fn classify(bytes, filename, options) {
    if type(bytes) != "array" { return map{ ok: false, format: FORMAT, error: "input must be bytes" }; }
    if len(bytes) > options.max_input_bytes {
        return map{ ok: false, format: FORMAT, error: "input exceeds configured byte limit" };
    }
    let ext = _suffix(filename);
    let expected = _expected(ext);
    let image_format = Image.detect(bytes);
    let container_format = Container.detect(bytes, filename, options);
    let kind = "unknown";
    let detected = "unknown";
    if image_format != "unknown" { kind = "image"; detected = image_format; }
    elif container_format != "unknown" { kind = "container"; detected = container_format; }
    elif _looks_text(bytes) { kind = "text"; detected = "utf8"; }
    let mismatch = expected != "unknown" and expected != kind;
    let binary = _binary_signature(bytes);
    if kind == "text" and binary != "" {
        return map{
            ok: false, format: FORMAT,
            error: "binary signature " + binary + " cannot be handled as text",
            expected_kind: expected, detected_kind: "unknown"
        };
    }
    if kind == "unknown" {
        return map{
            ok: false, format: FORMAT,
            error: "unsupported or unrecognized binary input",
            expected_kind: expected, extension: ext,
            binary_signature: binary
        };
    }
    return map{
        ok: true, format: FORMAT, kind: kind, detected_format: detected,
        extension: ext, expected_kind: expected,
        extension_mismatch: mismatch,
        confidence: if mismatch { "magic-over-extension" } else { "verified" },
        bytes: len(bytes)
    };
}

export FORMAT, classify;
