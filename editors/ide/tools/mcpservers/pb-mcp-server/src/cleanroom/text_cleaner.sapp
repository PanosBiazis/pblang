let Unicode = import("stdlib:unicode.sapp");

let FORMAT = "pbwatermarks.text.v1";

fn _in(values, value) {
    for item in values { if item == value { return true; } }
    return false;
}

fn _is_private(cp) {
    return (cp >= 57344 and cp <= 63743)
        or (cp >= 983040 and cp <= 1048573)
        or (cp >= 1048576 and cp <= 1114109);
}

fn _is_emoji(cp) {
    return Unicode.is_emoji(cp) or (cp >= 127744 and cp <= 129791)
        or (cp >= 9728 and cp <= 10175)
        or cp == 169 or cp == 174 or cp == 8482;
}

fn _script_family(cp) {
    if (cp >= 1536 and cp <= 1791) or (cp >= 1872 and cp <= 2303) { return "arabic"; }
    if cp >= 2304 and cp <= 2431 { return "devanagari"; }
    if cp >= 2432 and cp <= 2559 { return "bengali"; }
    if cp >= 2560 and cp <= 2687 { return "gurmukhi"; }
    if cp >= 2688 and cp <= 2815 { return "gujarati"; }
    if cp >= 2816 and cp <= 2943 { return "oriya"; }
    if cp >= 2944 and cp <= 3071 { return "tamil"; }
    if cp >= 3072 and cp <= 3199 { return "telugu"; }
    if cp >= 3200 and cp <= 3327 { return "kannada"; }
    if cp >= 3328 and cp <= 3455 { return "malayalam"; }
    if cp >= 3456 and cp <= 3583 { return "sinhala"; }
    if cp >= 6016 and cp <= 6143 { return "khmer"; }
    if cp >= 6144 and cp <= 6319 { return "mongolian"; }
    if (cp >= 4352 and cp <= 4607) or (cp >= 43360 and cp <= 43391)
        or (cp >= 55216 and cp <= 55295) { return "hangul"; }
    return "";
}

fn _is_bidi(cp) {
    return cp == 1564 or cp == 8206 or cp == 8207
        or (cp >= 8234 and cp <= 8238) or (cp >= 8294 and cp <= 8297);
}

fn _is_space(cp) {
    return cp == 160 or cp == 5760 or (cp >= 8192 and cp <= 8202)
        or cp == 8239 or cp == 8287 or cp == 12288;
}

fn _is_variation(cp) {
    return (cp >= 65024 and cp <= 65039)
        or (cp >= 917760 and cp <= 917999)
        or (cp >= 6155 and cp <= 6157);
}

fn _is_tag(cp) { return cp >= 917505 and cp <= 917631; }

fn _is_zero_width(cp) {
    return _in([6158, 8203, 8204, 8205, 8288, 65279], cp);
}

fn _is_always_strip(cp) {
    return _in([
        173, 847, 1564, 4447, 4448, 6068, 6069, 6158,
        8203, 8204, 8205, 8206, 8207,
        8234, 8235, 8236, 8237, 8238,
        8288, 8289, 8290, 8291, 8292, 8294, 8295, 8296, 8297,
        8298, 8299, 8300, 8301, 8302, 8303,
        65279, 65529, 65530, 65531
    ], cp) or _is_variation(cp) or _is_tag(cp);
}

fn _confusable(cp) {
    let cyrillic = map{
        "1040": "A", "1042": "B", "1045": "E", "1050": "K",
        "1052": "M", "1053": "H", "1054": "O", "1056": "P",
        "1057": "C", "1058": "T", "1061": "X", "1072": "a",
        "1077": "e", "1086": "o", "1088": "p", "1089": "c",
        "1091": "y", "1093": "x", "1110": "i"
    };
    let key = str(cp);
    if map_has(cyrillic, key) { return cyrillic[key]; }
    if cp >= 65313 and cp <= 65338 { return strfromcharcode(65 + cp - 65313); }
    if cp >= 65345 and cp <= 65370 { return strfromcharcode(97 + cp - 65345); }
    return nil;
}

fn _previous_base(text, index) {
    let i = index - 1;
    while i >= 0 {
        let cp = strcharcodeat(text, i);
        if not _is_tag(cp) and cp != 65038 and cp != 65039 { return cp; }
        i = i - 1;
    }
    return nil;
}

fn _next_cp(text, index) {
    if index + 1 >= len(text) { return nil; }
    return strcharcodeat(text, index + 1);
}

fn _valid_glue(text, index, cp, options) {
    if options.strip_emoji_glue { return false; }
    let prev = _previous_base(text, index);
    let next = _next_cp(text, index);
    if (cp == 65038 or cp == 65039) and prev != nil and _is_emoji(prev) { return true; }
    if cp == 8205 and prev != nil and next != nil and _is_emoji(prev) and _is_emoji(next) {
        return true;
    }
    if cp == 8204 or cp == 8205 {
        let before_family = if prev == nil { "" } else { _script_family(prev) };
        let after_family = if next == nil { "" } else { _script_family(next) };
        return before_family != "" and before_family == after_family;
    }
    if _is_tag(cp) and prev != nil and _is_emoji(prev) { return true; }
    if cp >= 6155 and cp <= 6157 and prev != nil and _script_family(prev) == "mongolian" {
        return true;
    }
    if (cp == 6068 or cp == 6069) and prev != nil and _script_family(prev) == "khmer" {
        return true;
    }
    if (cp == 4447 or cp == 4448) and next != nil and _script_family(next) == "hangul" {
        return true;
    }
    return false;
}

fn _decision(text, index, options) {
    let cp = strcharcodeat(text, index);
    let ch = str_slice(text, index, index + 1);
    if _is_private(cp) {
        return map{
            action: if options.strip_private_use { "strip" } else { "keep" },
            output: if options.strip_private_use { "" } else { ch },
            kind: "private_use",
            confidence: "informational"
        };
    }
    if _is_space(cp) and options.normalize_spaces {
        return map{ action: "replace", output: " ", kind: "space", confidence: "informational" };
    }
    if _is_always_strip(cp) {
        if _valid_glue(text, index, cp, options) {
            return map{ action: "keep", output: ch, kind: "", confidence: "none" };
        }
        let kind = "format_control";
        if _is_bidi(cp) { kind = "bidi"; }
        elif _is_tag(cp) { kind = "tag"; }
        elif _is_variation(cp) { kind = "variation_selector"; }
        elif _is_zero_width(cp) { kind = "zero_width"; }
        return map{ action: "strip", output: "", kind: kind, confidence: "probable" };
    }
    if options.aggressive_confusables {
        let replacement = _confusable(cp);
        if replacement != nil {
            return map{
                action: "replace", output: replacement,
                kind: "confusable", confidence: "probable"
            };
        }
    }
    return map{ action: "keep", output: ch, kind: "", confidence: "none" };
}

fn _add_hit(state, cp, kind, action, confidence, index, max_findings) {
    let key = str(cp) + ":" + kind + ":" + action;
    let hit = try state.by_key[key] catch nil;
    if hit == nil {
        hit = map{
            codepoint: "U+" + Unicode.hex_codepoint(cp),
            value: cp,
            kind: kind,
            action: action,
            confidence: confidence,
            count: 0,
            sample_offsets: []
        };
        state.by_key[key] = hit;
        if len(state.hits) < max_findings { array_push(state.hits, hit); }
        else { state.truncated = true; }
    }
    hit.count = hit.count + 1;
    if len(hit.sample_offsets) < 8 { array_push(hit.sample_offsets, index); }
    state.total = state.total + 1;
}

fn process(text, options) {
    if type(text) != "string" { return map{ ok: false, format: FORMAT, error: "text must be UTF-8" }; }
    let state = map{ hits: [], by_key: map{}, total: 0, truncated: false };
    let output = "";
    let removed = 0;
    let replaced = 0;
    let i = 0;
    while i < len(text) {
        let decision = _decision(text, i, options);
        if decision.kind != "" {
            _add_hit(state, strcharcodeat(text, i), decision.kind,
                decision.action, decision.confidence, i, options.max_findings);
        }
        if decision.action == "strip" { removed = removed + 1; }
        else {
            output = output + decision.output;
            if decision.action == "replace" { replaced = replaced + 1; }
        }
        i = i + 1;
    }
    return map{
        ok: true,
        format: FORMAT,
        input_chars: len(text),
        output_chars: len(output),
        suspicious_total: state.total,
        removed_count: removed,
        replaced_count: replaced,
        hits: state.hits,
        truncated: state.truncated,
        cleaned: output,
        changed: output != text,
        deterministic: true,
        lossless_when_unchanged: true
    };
}

fn inspect(text, options) { return process(text, options); }

fn clean(text, options) {
    let report = process(text, options);
    if not report.ok { return report; }
    report.operation = "clean";
    return report;
}

export FORMAT, inspect, clean, process;
