let SHA = import("stdlib:sha256_pb.sapp");

fn u16be(bytes, at) {
    if at < 0 or at + 2 > len(bytes) { return nil; }
    return bytes[at] * 256 + bytes[at + 1];
}

fn u32be(bytes, at) {
    if at < 0 or at + 4 > len(bytes) { return nil; }
    return bytes[at] * 16777216 + bytes[at + 1] * 65536
        + bytes[at + 2] * 256 + bytes[at + 3];
}

fn u32le(bytes, at) {
    if at < 0 or at + 4 > len(bytes) { return nil; }
    return bytes[at] + bytes[at + 1] * 256
        + bytes[at + 2] * 65536 + bytes[at + 3] * 16777216;
}

fn push_u16be(out, value) {
    array_push(out, bit_and(bit_shr(value, 8), 255));
    array_push(out, bit_and(value, 255));
}

fn push_u32be(out, value) {
    array_push(out, bit_and(bit_shr(value, 24), 255));
    array_push(out, bit_and(bit_shr(value, 16), 255));
    array_push(out, bit_and(bit_shr(value, 8), 255));
    array_push(out, bit_and(value, 255));
}

fn push_u32le(out, value) {
    array_push(out, bit_and(value, 255));
    array_push(out, bit_and(bit_shr(value, 8), 255));
    array_push(out, bit_and(bit_shr(value, 16), 255));
    array_push(out, bit_and(bit_shr(value, 24), 255));
}

fn append(out, bytes, start = 0, count = nil) {
    if count == nil { count = len(bytes) - start; }
    if start < 0 or count < 0 or start + count > len(bytes) {
        throw "bytekit append range is invalid";
    }
    let i = 0;
    while i < count {
        array_push(out, bytes[start + i]);
        i = i + 1;
    }
    return out;
}

fn equals_at(bytes, at, expected) {
    if at < 0 or at + len(expected) > len(bytes) { return false; }
    let i = 0;
    while i < len(expected) {
        if bytes[at + i] != expected[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn ascii_lower_byte(value) {
    if value >= 65 and value <= 90 { return value + 32; }
    return value;
}

fn contains_ascii(bytes, needle) {
    let wanted = str_to_bytes(str_lower(str(needle)));
    if len(wanted) == 0 { return true; }
    if len(wanted) > len(bytes) { return false; }
    let at = 0;
    while at + len(wanted) <= len(bytes) {
        let matches = true;
        let i = 0;
        while i < len(wanted) {
            if ascii_lower_byte(bytes[at + i]) != ascii_lower_byte(wanted[i]) {
                matches = false;
                break;
            }
            i = i + 1;
        }
        if matches { return true; }
        at = at + 1;
    }
    return false;
}

fn ascii(bytes, at, count) {
    if at < 0 or count < 0 or at + count > len(bytes) { return ""; }
    let out = "";
    let i = 0;
    while i < count {
        let value = bytes[at + i];
        if value < 0 or value > 127 { return ""; }
        out = out + strfromcharcode(value);
        i = i + 1;
    }
    return out;
}

fn digest(bytes) { return SHA.sha256_hex_bytes(bytes); }

export u16be, u32be, u32le, push_u16be, push_u32be, push_u32le;
export append, equals_at, ascii_lower_byte, contains_ascii, ascii, digest;
