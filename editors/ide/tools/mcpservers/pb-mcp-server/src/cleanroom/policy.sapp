let FORMAT = "pbwatermarks.policy.v1";
let DEFAULT_MAX_INPUT_BYTES = 33554432;
let MAX_INPUT_BYTES = 268435456;
let DEFAULT_MAX_FINDINGS = 256;
let MAX_FINDINGS = 2048;
let DEFAULT_MAX_ZIP_ENTRIES = 2048;
let MAX_ZIP_ENTRIES = 8192;
let DEFAULT_MAX_ZIP_ENTRY_BYTES = 16777216;
let MAX_ZIP_ENTRY_BYTES = 67108864;

fn _integer(value, fallback, minimum, maximum) {
    let out = value;
    if out == nil { out = fallback; }
    if type(out) != "number" or num_floor(out) != out
        or out < minimum or out > maximum {
        return nil;
    }
    return out;
}

fn normalize(options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { return map{ ok: false, error: "options must be a map" }; }
    let mode = str_lower(str(try options.mode catch "conservative"));
    if mode != "inspect" and mode != "conservative" and mode != "privacy" {
        return map{ ok: false, error: "mode must be inspect, conservative, or privacy" };
    }
    let max_input = _integer(try options.max_input_bytes catch nil,
        DEFAULT_MAX_INPUT_BYTES, 1, MAX_INPUT_BYTES);
    let max_findings = _integer(try options.max_findings catch nil,
        DEFAULT_MAX_FINDINGS, 1, MAX_FINDINGS);
    let max_zip_entries = _integer(try options.max_zip_entries catch nil,
        DEFAULT_MAX_ZIP_ENTRIES, 1, MAX_ZIP_ENTRIES);
    let max_zip_entry = _integer(try options.max_zip_entry_bytes catch nil,
        DEFAULT_MAX_ZIP_ENTRY_BYTES, 1, MAX_ZIP_ENTRY_BYTES);
    if max_input == nil or max_findings == nil or max_zip_entries == nil
        or max_zip_entry == nil {
        return map{ ok: false, error: "one or more resource limits are invalid" };
    }
    let pdf_password = try options.pdf_password catch nil;
    if pdf_password != nil and ((type(pdf_password) != "string" and type(pdf_password) != "array")
        or len(pdf_password) > 127) {
        return map{ ok: false, error: "pdf_password must contain at most 127 bytes" };
    }
    return map{
        ok: true,
        format: FORMAT,
        mode: mode,
        max_input_bytes: max_input,
        max_findings: max_findings,
        max_zip_entries: max_zip_entries,
        max_zip_entry_bytes: max_zip_entry,
        aggressive_confusables: try options.aggressive_confusables catch false,
        normalize_spaces: try options.normalize_spaces catch true,
        strip_private_use: try options.strip_private_use catch false,
        strip_emoji_glue: try options.strip_emoji_glue catch false,
        pdf_password: pdf_password,
        pdf_decrypt_requested: pdf_password != nil,
        preserve_attribution: true,
        external_commands: false,
        network_access: false,
        overwrite_input: false
    };
}

fn capabilities() {
    return map{
        format: "pbwatermarks.capabilities.v1",
        implementation: "pblang",
        inspect: ["text", "png", "jpeg", "webp", "markdown", "html", "svg", "docx", "odt", "pdf"],
        clean: ["text", "png", "jpeg", "webp", "markdown", "html", "svg", "docx", "odt", "pdf"],
        clean_fail_closed: ["pdf-unsupported-security-handler", "pdf-unsupported-crypt-filter",
            "pdf-malformed-revision-chain", "unknown-binary"],
        modes: ["inspect", "conservative", "privacy"],
        structural_pdf_cleaning: true,
        pdf_indirect_stream_lengths: true,
        pdf_incremental_normalization: true,
        pdf_object_stream_expansion: true,
        pdf_xref_stream_normalization: true,
        pdf_standard_security_revisions: [2, 3, 4, 5, 6],
        pdf_password_required_for_encrypted_input: true,
        pdf_output_encrypted: false,
        pixel_data_reencoded: false,
        statistical_text_rewrite: true,
        statistical_text_rewrite_default: false,
        statistical_text_rewrite_transports: ["local-only-ollama", "manual-trusted-codex-session"],
        statistical_text_hook_credentials_required: false,
        statistical_text_hook_privacy_modes: ["block", "redact"],
        statistical_text_external_candidates: true,
        statistical_text_external_candidates_network: false,
        visible_mark_inpainting: true,
        visible_mark_inpainting_requires_mask: true,
        bounded_mask_generation: ["regions", "luminance-roi", "color-roi", "alpha-roi"],
        local_pixel_regeneration: true,
        verified_external_regeneration_candidates: true,
        external_regeneration_provider_independent: true,
        diffusion_regeneration: false,
        secure_defaults: map{
            bounded_memory: true,
            crc_validation: true,
            magic_validation: true,
            atomic_output: true,
            loopback_http: true,
            auth_required_http: true,
            external_commands: false,
            network_access: false,
            credentials_in_reports: false,
            absolute_paths_in_reports: false,
            sensitive_values_in_reports: false,
            preserve_attribution: true
        },
        aap_wave_capabilities: map{
            flagship_default_ui: true,
            smart_lazy_idle_optimizer: true,
            omni_supremacy_engine: true,
            aap_unified_fabric: true,
            deep_domain_engines_wave12: true,
            multipass_ocr_monotonic_reader: true,
            template_transpiler_16lang_i18n: true,
            sovereign_file_explorer_cleanroom: true,
            strict_confidentiality: true
        }
    };
}

export FORMAT, DEFAULT_MAX_INPUT_BYTES, MAX_INPUT_BYTES;
export DEFAULT_MAX_FINDINGS, MAX_FINDINGS, normalize, capabilities;
