let Bytes = (try import("./bytekit.sapp") catch (try import("cleanroom/bytekit.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/bytekit.sapp")));
let Flate = import("stdlib:flate.sapp");

let FORMAT = "pbwatermarks.image.v1";
let PNG_SIGNATURE = [137, 80, 78, 71, 13, 10, 26, 10];

fn _error(message) { return map{ ok: false, format: FORMAT, error: message }; }

fn detect(bytes) {
    if type(bytes) != "array" { return "unknown"; }
    if Bytes.equals_at(bytes, 0, PNG_SIGNATURE) { return "png"; }
    if Bytes.equals_at(bytes, 0, [255, 216]) { return "jpeg"; }
    if len(bytes) >= 12 and Bytes.ascii(bytes, 0, 4) == "RIFF"
        and Bytes.ascii(bytes, 8, 4) == "WEBP" { return "webp"; }
    return "unknown";
}

fn _markers() {
    return [
        "c2pa", "jumb", "contentcredentials", "content credentials",
        "contentauth", "digitalSourceType", "trainedAlgorithmicMedia",
        "compositeWithTrainedAlgorithmicMedia", "algorithmicMedia",
        "aigc", "ai generated", "generated by ai", "synthid",
        "dcterms:provenance"
    ];
}

fn _marker_hits(bytes) {
    let hits = [];
    for marker in _markers() {
        if Bytes.contains_ascii(bytes, marker) { array_push(hits, marker); }
    }
    return hits;
}

fn _has_c2pa(hits) {
    for hit in hits {
        let name = str_lower(hit);
        if name == "c2pa" or name == "jumb"
            or name == "contentcredentials" or name == "content credentials"
            or name == "contentauth" { return true; }
    }
    return false;
}

fn _finding(state, kind, confidence, detail, offset, max_findings) {
    state.total = state.total + 1;
    if len(state.findings) >= max_findings {
        state.truncated = true;
        return;
    }
    array_push(state.findings, map{
        kind: kind, confidence: confidence,
        detail: detail, offset: offset
    });
}

fn _png_chunks(bytes, options) {
    if not Bytes.equals_at(bytes, 0, PNG_SIGNATURE) { return _error("invalid PNG signature"); }
    let chunks = [];
    let at = 8;
    let seen_ihdr = false;
    let seen_idat = false;
    let seen_iend = false;
    let pixel_payload = [];
    while at < len(bytes) {
        if at + 12 > len(bytes) { return _error("truncated PNG chunk header"); }
        let size = Bytes.u32be(bytes, at);
        if size == nil or size > options.max_input_bytes
            or at + 12 + size > len(bytes) {
            return _error("PNG chunk exceeds bounded input");
        }
        let type_at = at + 4;
        let data_at = at + 8;
        let name = Bytes.ascii(bytes, type_at, 4);
        let expected_crc = Bytes.u32be(bytes, data_at + size);
        let actual_crc = Flate.crc32_range(bytes, type_at, size + 4);
        if expected_crc != actual_crc { return _error("PNG CRC mismatch in " + name); }
        if name == "IHDR" {
            if seen_ihdr or at != 8 or size != 13 { return _error("invalid PNG IHDR"); }
            seen_ihdr = true;
        } elif name == "IDAT" {
            if not seen_ihdr or seen_iend { return _error("PNG IDAT outside image body"); }
            seen_idat = true;
            Bytes.append(pixel_payload, bytes, data_at, size);
        } elif name == "IEND" {
            if not seen_ihdr or not seen_idat or size != 0 or seen_iend {
                return _error("invalid PNG IEND");
            }
            seen_iend = true;
        }
        array_push(chunks, map{
            name: name, offset: at, size: size,
            type_at: type_at, data_at: data_at,
            end: data_at + size + 4
        });
        at = data_at + size + 4;
        if seen_iend { break; }
    }
    if not seen_iend or at != len(bytes) { return _error("PNG missing IEND or has trailing bytes"); }
    return map{
        ok: true, chunks: chunks,
        pixel_digest: Bytes.digest(pixel_payload)
    };
}

fn inspect_png(bytes, options) {
    let parsed = _png_chunks(bytes, options);
    if not parsed.ok { return parsed; }
    let state = map{ findings: [], total: 0, truncated: false };
    let has_ai = false;
    let has_c2pa = false;
    for chunk in parsed.chunks {
        let name_lower = str_lower(chunk.name);
        let metadata = chunk.name == "tEXt" or chunk.name == "zTXt"
            or chunk.name == "iTXt" or chunk.name == "eXIf"
            or chunk.name == "caBX" or str_starts_with(name_lower, "c2");
        if metadata {
            let payload = slice(bytes, chunk.data_at, chunk.data_at + chunk.size);
            let hits = _marker_hits(payload);
            if chunk.name == "caBX" or str_starts_with(name_lower, "c2") {
                has_c2pa = true;
                has_ai = true;
                _finding(state, "c2pa-container", "confirmed",
                    "PNG " + chunk.name + " provenance container", chunk.offset,
                    options.max_findings);
            } elif len(hits) > 0 {
                has_ai = true;
                if _has_c2pa(hits) { has_c2pa = true; }
                _finding(state, "metadata-marker", "probable",
                    "PNG " + chunk.name + " markers: " + str_join(hits, ", "),
                    chunk.offset, options.max_findings);
            } else {
                _finding(state, "metadata", "informational",
                    "PNG " + chunk.name + " metadata present", chunk.offset,
                    options.max_findings);
            }
        }
    }
    return map{
        ok: true, format: FORMAT, image_format: "png",
        has_c2pa: has_c2pa, has_ai_metadata: has_ai,
        findings: state.findings, finding_count: state.total,
        truncated: state.truncated, pixel_digest: parsed.pixel_digest,
        structure_verified: true, crc_verified: true
    };
}

fn clean_png(bytes, options) {
    let parsed = _png_chunks(bytes, options);
    if not parsed.ok { return parsed; }
    let out = [];
    Bytes.append(out, PNG_SIGNATURE);
    let actions = [];
    for chunk in parsed.chunks {
        let lower = str_lower(chunk.name);
        let payload = slice(bytes, chunk.data_at, chunk.data_at + chunk.size);
        let hits = _marker_hits(payload);
        let drop = chunk.name == "caBX" or str_starts_with(lower, "c2");
        if chunk.name == "eXIf" {
            drop = options.mode == "privacy" or len(hits) > 0;
        }
        if chunk.name == "tEXt" or chunk.name == "zTXt" or chunk.name == "iTXt" {
            drop = options.mode == "privacy" or len(hits) > 0;
        }
        if drop {
            array_push(actions, "drop PNG " + chunk.name);
        } else {
            Bytes.append(out, bytes, chunk.offset, chunk.end - chunk.offset);
        }
    }
    let after = _png_chunks(out, options);
    if not after.ok { return _error("internal PNG rewrite verification failed: " + after.error); }
    if after.pixel_digest != parsed.pixel_digest {
        return _error("PNG pixel payload changed during metadata cleaning");
    }
    return map{
        ok: true, format: FORMAT, image_format: "png",
        bytes: out, actions: actions, changed: Bytes.digest(out) != Bytes.digest(bytes),
        input_digest: Bytes.digest(bytes), output_digest: Bytes.digest(out),
        pixel_digest: parsed.pixel_digest, pixel_payload_preserved: true,
        structure_verified: true, crc_verified: true
    };
}

fn _jpeg_segments(bytes, options) {
    if not Bytes.equals_at(bytes, 0, [255, 216]) { return _error("invalid JPEG signature"); }
    let segments = [];
    let at = 2;
    let scan_at = -1;
    while at < len(bytes) {
        if bytes[at] != 255 { return _error("JPEG marker prefix expected"); }
        let marker_at = at;
        while at < len(bytes) and bytes[at] == 255 { at = at + 1; }
        if at >= len(bytes) { return _error("truncated JPEG marker"); }
        let marker = bytes[at];
        at = at + 1;
        if marker == 217 {
            array_push(segments, map{ marker: marker, offset: marker_at, end: at });
            if at != len(bytes) { return _error("JPEG has trailing bytes after EOI"); }
            break;
        }
        if marker == 216 or (marker >= 208 and marker <= 215) or marker == 1 {
            array_push(segments, map{ marker: marker, offset: marker_at, end: at });
            continue;
        }
        if at + 2 > len(bytes) { return _error("truncated JPEG segment length"); }
        let size = Bytes.u16be(bytes, at);
        if size == nil or size < 2 or at + size > len(bytes)
            or size > options.max_input_bytes {
            return _error("invalid JPEG segment length");
        }
        let data_at = at + 2;
        let end = at + size;
        array_push(segments, map{
            marker: marker, offset: marker_at,
            data_at: data_at, size: size - 2, end: end
        });
        if marker == 218 {
            scan_at = marker_at;
            break;
        }
        at = end;
    }
    if scan_at < 0 { return _error("JPEG is missing start-of-scan"); }
    if len(bytes) < scan_at + 4 or bytes[len(bytes) - 2] != 255
        or bytes[len(bytes) - 1] != 217 {
        return _error("JPEG scan is truncated or missing EOI");
    }
    return map{
        ok: true, segments: segments, scan_at: scan_at,
        pixel_digest: Bytes.digest(slice(bytes, scan_at, len(bytes)))
    };
}

fn inspect_jpeg(bytes, options) {
    let parsed = _jpeg_segments(bytes, options);
    if not parsed.ok { return parsed; }
    let state = map{ findings: [], total: 0, truncated: false };
    let has_ai = false;
    let has_c2pa = false;
    for segment in parsed.segments {
        let marker = segment.marker;
        if marker >= 224 and marker <= 239 {
            let payload = slice(bytes, segment.data_at, segment.data_at + segment.size);
            let hits = _marker_hits(payload);
            if marker == 235 and (Bytes.contains_ascii(payload, "jumb")
                or Bytes.contains_ascii(payload, "c2pa")) {
                has_c2pa = true;
                has_ai = true;
                _finding(state, "c2pa-container", "confirmed",
                    "JPEG APP11 JUMBF/C2PA container", segment.offset,
                    options.max_findings);
            } elif len(hits) > 0 {
                has_ai = true;
                if _has_c2pa(hits) { has_c2pa = true; }
                _finding(state, "metadata-marker", "probable",
                    "JPEG APP" + str(marker - 224) + " markers: " + str_join(hits, ", "),
                    segment.offset, options.max_findings);
            } elif marker == 225 or marker == 237 or marker == 235 {
                _finding(state, "metadata", "informational",
                    "JPEG APP" + str(marker - 224) + " metadata present",
                    segment.offset, options.max_findings);
            }
        } elif marker == 254 {
            _finding(state, "comment", "informational", "JPEG comment present",
                segment.offset, options.max_findings);
        }
    }
    return map{
        ok: true, format: FORMAT, image_format: "jpeg",
        has_c2pa: has_c2pa, has_ai_metadata: has_ai,
        findings: state.findings, finding_count: state.total,
        truncated: state.truncated, pixel_digest: parsed.pixel_digest,
        structure_verified: true, crc_verified: false
    };
}

fn clean_jpeg(bytes, options) {
    let parsed = _jpeg_segments(bytes, options);
    if not parsed.ok { return parsed; }
    let out = [255, 216];
    let actions = [];
    for segment in parsed.segments {
        if segment.offset >= parsed.scan_at { break; }
        let marker = segment.marker;
        let drop = false;
        if marker >= 224 and marker <= 239 {
            let payload = slice(bytes, segment.data_at, segment.data_at + segment.size);
            let hits = _marker_hits(payload);
            if marker == 235 and (Bytes.contains_ascii(payload, "jumb")
                or Bytes.contains_ascii(payload, "c2pa")) { drop = true; }
            elif len(hits) > 0 { drop = true; }
            elif options.mode == "privacy" and (marker == 225 or marker == 237) {
                drop = true;
            }
        } elif marker == 254 and options.mode == "privacy" { drop = true; }
        if drop { array_push(actions, "drop JPEG marker 0x" + str(marker)); }
        else { Bytes.append(out, bytes, segment.offset, segment.end - segment.offset); }
    }
    Bytes.append(out, bytes, parsed.scan_at, len(bytes) - parsed.scan_at);
    let after = _jpeg_segments(out, options);
    if not after.ok { return _error("internal JPEG rewrite verification failed: " + after.error); }
    if after.pixel_digest != parsed.pixel_digest {
        return _error("JPEG entropy-coded scan changed during metadata cleaning");
    }
    return map{
        ok: true, format: FORMAT, image_format: "jpeg",
        bytes: out, actions: actions, changed: Bytes.digest(out) != Bytes.digest(bytes),
        input_digest: Bytes.digest(bytes), output_digest: Bytes.digest(out),
        pixel_digest: parsed.pixel_digest, pixel_payload_preserved: true,
        structure_verified: true, crc_verified: false
    };
}

fn _webp_chunks(bytes, options) {
    if detect(bytes) != "webp" { return _error("invalid WebP signature"); }
    let declared = Bytes.u32le(bytes, 4);
    if declared == nil or declared + 8 != len(bytes) {
        return _error("WebP RIFF size mismatch");
    }
    let chunks = [];
    let pixel_payload = [];
    let at = 12;
    while at < len(bytes) {
        if at + 8 > len(bytes) { return _error("truncated WebP chunk header"); }
        let name = Bytes.ascii(bytes, at, 4);
        let size = Bytes.u32le(bytes, at + 4);
        let data_at = at + 8;
        let padded_end = data_at + size + num_mod(size, 2);
        if size == nil or size > options.max_input_bytes or padded_end > len(bytes) {
            return _error("WebP chunk exceeds bounded input");
        }
        if name == "VP8 " or name == "VP8L" or name == "ANMF" {
            Bytes.append(pixel_payload, bytes, data_at, size);
        }
        array_push(chunks, map{
            name: name, offset: at, data_at: data_at,
            size: size, end: padded_end
        });
        at = padded_end;
    }
    if at != len(bytes) { return _error("WebP trailing bytes"); }
    return map{
        ok: true, chunks: chunks,
        pixel_digest: Bytes.digest(pixel_payload)
    };
}

fn inspect_webp(bytes, options) {
    let parsed = _webp_chunks(bytes, options);
    if not parsed.ok { return parsed; }
    let state = map{ findings: [], total: 0, truncated: false };
    let has_ai = false;
    let has_c2pa = false;
    for chunk in parsed.chunks {
        if str_lower(chunk.name) == "c2pa" {
            has_ai = true;
            has_c2pa = true;
            _finding(state, "c2pa-container", "confirmed", "WebP C2PA chunk",
                chunk.offset, options.max_findings);
        } elif chunk.name == "EXIF" or chunk.name == "XMP " or chunk.name == "ICCP" {
            let payload = slice(bytes, chunk.data_at, chunk.data_at + chunk.size);
            let hits = _marker_hits(payload);
            if len(hits) > 0 {
                has_ai = true;
                if _has_c2pa(hits) { has_c2pa = true; }
                _finding(state, "metadata-marker", "probable",
                    "WebP " + chunk.name + " markers: " + str_join(hits, ", "),
                    chunk.offset, options.max_findings);
            } else {
                _finding(state, "metadata", "informational",
                    "WebP " + chunk.name + " metadata present", chunk.offset,
                    options.max_findings);
            }
        }
    }
    return map{
        ok: true, format: FORMAT, image_format: "webp",
        has_c2pa: has_c2pa, has_ai_metadata: has_ai,
        findings: state.findings, finding_count: state.total,
        truncated: state.truncated, pixel_digest: parsed.pixel_digest,
        structure_verified: true, crc_verified: false
    };
}

fn clean_webp(bytes, options) {
    let parsed = _webp_chunks(bytes, options);
    if not parsed.ok { return parsed; }
    let body = str_to_bytes("WEBP");
    let actions = [];
    let removed_flags = 0;
    for chunk in parsed.chunks {
        let payload = slice(bytes, chunk.data_at, chunk.data_at + chunk.size);
        let hits = _marker_hits(payload);
        let drop = str_lower(chunk.name) == "c2pa" or len(hits) > 0;
        if options.mode == "privacy" and (chunk.name == "EXIF" or chunk.name == "XMP ") {
            drop = true;
        }
        if drop {
            if chunk.name == "ICCP" { removed_flags = bit_or(removed_flags, 32); }
            if chunk.name == "EXIF" { removed_flags = bit_or(removed_flags, 8); }
            if chunk.name == "XMP " { removed_flags = bit_or(removed_flags, 4); }
        }
    }
    for chunk in parsed.chunks {
        let payload = slice(bytes, chunk.data_at, chunk.data_at + chunk.size);
        let hits = _marker_hits(payload);
        let drop = str_lower(chunk.name) == "c2pa" or len(hits) > 0;
        if options.mode == "privacy" and (chunk.name == "EXIF" or chunk.name == "XMP ") {
            drop = true;
        }
        if drop {
            array_push(actions, "drop WebP " + chunk.name);
        } else {
            let kept_payload = payload;
            if chunk.name == "VP8X" and len(payload) > 0 and removed_flags != 0 {
                kept_payload = slice(payload, 0, len(payload));
                kept_payload[0] = bit_and(kept_payload[0], bit_not(removed_flags));
            }
            Bytes.append(body, str_to_bytes(chunk.name));
            Bytes.push_u32le(body, len(kept_payload));
            Bytes.append(body, kept_payload);
            if num_mod(len(kept_payload), 2) == 1 { array_push(body, 0); }
        }
    }
    let out = str_to_bytes("RIFF");
    Bytes.push_u32le(out, len(body));
    Bytes.append(out, body);
    let after = _webp_chunks(out, options);
    if not after.ok { return _error("internal WebP rewrite verification failed: " + after.error); }
    if after.pixel_digest != parsed.pixel_digest {
        return _error("WebP pixel payload changed during metadata cleaning");
    }
    return map{
        ok: true, format: FORMAT, image_format: "webp",
        bytes: out, actions: actions, changed: Bytes.digest(out) != Bytes.digest(bytes),
        input_digest: Bytes.digest(bytes), output_digest: Bytes.digest(out),
        pixel_digest: parsed.pixel_digest, pixel_payload_preserved: true,
        structure_verified: true, crc_verified: false
    };
}

fn inspect(bytes, options) {
    let kind = detect(bytes);
    if kind == "png" { return inspect_png(bytes, options); }
    if kind == "jpeg" { return inspect_jpeg(bytes, options); }
    if kind == "webp" { return inspect_webp(bytes, options); }
    return _error("unsupported image format");
}

fn clean(bytes, options) {
    let kind = detect(bytes);
    if kind == "png" { return clean_png(bytes, options); }
    if kind == "jpeg" { return clean_jpeg(bytes, options); }
    if kind == "webp" { return clean_webp(bytes, options); }
    return _error("unsupported image format");
}

export FORMAT, detect, inspect, clean;
export inspect_png, inspect_jpeg, inspect_webp;
export clean_png, clean_jpeg, clean_webp;
