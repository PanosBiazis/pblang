let Policy = (try import("./policy.sapp") catch (try import("cleanroom/policy.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/policy.sapp")));
let Dispatch = (try import("./dispatch.sapp") catch (try import("cleanroom/dispatch.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/dispatch.sapp")));
let Text = (try import("./text_cleaner.sapp") catch (try import("cleanroom/text_cleaner.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/text_cleaner.sapp")));
let Image = (try import("./image_cleaner.sapp") catch (try import("cleanroom/image_cleaner.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/image_cleaner.sapp")));
let Container = (try import("./container_cleaner.sapp") catch (try import("cleanroom/container_cleaner.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/container_cleaner.sapp")));
let Bytes = (try import("./bytekit.sapp") catch (try import("cleanroom/bytekit.sapp") catch import("editors/ide/tools/mcpservers/pb-mcp-server/src/cleanroom/bytekit.sapp")));

let FORMAT = "pbwatermarks.engine.v1";

fn _error(stage, message) {
    return map{ ok: false, format: FORMAT, stage: stage, error: message };
}

fn capabilities() { return Policy.capabilities(); }

fn _public_policy(policy) {
    return map{ format:policy.format,mode:policy.mode,max_input_bytes:policy.max_input_bytes,
        max_findings:policy.max_findings,max_zip_entries:policy.max_zip_entries,
        max_zip_entry_bytes:policy.max_zip_entry_bytes,
        aggressive_confusables:policy.aggressive_confusables,normalize_spaces:policy.normalize_spaces,
        strip_private_use:policy.strip_private_use,strip_emoji_glue:policy.strip_emoji_glue,
        pdf_decrypt_requested:policy.pdf_decrypt_requested,pdf_password_redacted:policy.pdf_decrypt_requested,
        preserve_attribution:policy.preserve_attribution,external_commands:policy.external_commands,
        network_access:policy.network_access,overwrite_input:policy.overwrite_input,
        credentials_exposed:false,absolute_paths_exposed:false };
}

fn _public_filename(filename) {
    let value=try path_basename(str(filename)) catch "input";
    if value=="" or len(value)>255 { return "input"; }
    return value;
}

fn _policy_valid(policy) {
    return type(policy) == "map" and (try policy.ok catch false)
        and (try policy.format catch "") == Policy.FORMAT;
}

fn inspect_with_policy(bytes, filename, policy) {
    if not _policy_valid(policy) { return _error("policy", "normalized policy is invalid"); }
    let route = Dispatch.classify(bytes, filename, policy);
    if not route.ok { return _error("dispatch", route.error); }
    let report = nil;
    if route.kind == "text" {
        let text = try bytes_to_str(bytes) catch nil;
        if text == nil { return _error("decode", "text input must be valid UTF-8"); }
        report = Text.inspect(text, policy);
        report.has_c2pa = false;
        report.has_ai_metadata = report.suspicious_total > 0;
        report.findings = report.hits;
        report.finding_count = report.suspicious_total;
    } elif route.kind == "image" { report = Image.inspect(bytes, policy); }
    else { report = Container.inspect(bytes, filename, policy); }
    if not report.ok { return _error("inspect", report.error); }
    return map{
        ok: true, format: FORMAT, operation: "inspect",
        filename: _public_filename(filename), bytes: len(bytes), digest: Bytes.digest(bytes),
        route: route, policy: _public_policy(policy), report: report,
        suspicious: report.has_c2pa or report.has_ai_metadata,
        mutation_performed: false
    };
}

fn inspect_bytes(bytes, filename, options = nil) {
    let policy = Policy.normalize(options);
    if not policy.ok { return _error("policy", policy.error); }
    return inspect_with_policy(bytes, filename, policy);
}

fn clean_with_policy(bytes, filename, policy) {
    if not _policy_valid(policy) { return _error("policy", "normalized policy is invalid"); }
    if policy.mode == "inspect" { return _error("policy", "inspect mode does not permit mutation"); }
    let before = inspect_with_policy(bytes, filename, policy);
    if not before.ok { return before; }
    let cleaned = map{};
    if before.route.kind == "text" {
        let text = bytes_to_str(bytes);
        let result = Text.clean(text, policy);
        cleaned = map{
            ok: result.ok, bytes: str_to_bytes(result.cleaned),
            actions: [
                "strip " + str(result.removed_count) + " format controls",
                "replace " + str(result.replaced_count) + " confusable spaces or characters"
            ],
            changed: result.changed,
            text_report: result
        };
    } elif before.route.kind == "image" { cleaned = Image.clean(bytes, policy); }
    else { cleaned = Container.clean(bytes, filename, policy); }
    if not cleaned.ok { return _error("clean", cleaned.error); }
    if len(cleaned.bytes) > policy.max_input_bytes {
        return _error("verify", "cleaned output exceeds configured byte limit");
    }
    let after = inspect_with_policy(cleaned.bytes, filename, policy);
    if not after.ok { return _error("verify", "cleaned output failed reinspection: " + after.error); }
    let residual = after.suspicious;
    return map{
        ok: true, format: FORMAT, operation: "clean",
        filename: _public_filename(filename), route: before.route, policy: _public_policy(policy),
        before: before.report, after: after.report,
        bytes: cleaned.bytes, bytes_in: len(bytes), bytes_out: len(cleaned.bytes),
        input_digest: before.digest, output_digest: after.digest,
        changed: cleaned.changed, actions: cleaned.actions,
        residual_signals: residual,
        verified: true,
        pixel_payload_preserved: try cleaned.pixel_payload_preserved catch nil,
        mutation_performed: cleaned.changed
    };
}

fn clean_bytes(bytes, filename, options = nil) {
    let policy = Policy.normalize(options);
    if not policy.ok { return _error("policy", policy.error); }
    return clean_with_policy(bytes, filename, policy);
}

export FORMAT, capabilities, inspect_bytes, clean_bytes, inspect_with_policy, clean_with_policy;
