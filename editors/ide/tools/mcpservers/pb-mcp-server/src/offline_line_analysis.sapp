// Bounded inline line-analysis family over the unchanged shared text core.
let TEXT=import("text_compute.sapp");
fn _specs() {
    return [
        map{name:"summarize_duplicate_lines",scope:"returned_line_text",detail:"Count exact nonblank LF-separated lines over the entire admitted input. Ignore whitespace-only lines. Sort descending count then lexical line order. max_chars limits cumulative returned line scalars, stopping before the first row that does not fit; it does not clip input. No normalization or automatic deduplication.",options:map{min_occurrences:map{type:"integer",minimum:2,maximum:2048,default:2},max_entries:map{type:"integer",minimum:1,maximum:200,default:40}}},
        map{name:"summarize_line_histogram",scope:"input_prefix",detail:"Count LF-separated lines by Unicode-scalar length: empty=0, short=1..40, medium=41..120, long>120. max_chars clips the input prefix, possibly cutting a line. Empty input and a trailing LF each yield an empty logical line; CR remains a scalar.",options:map{}},
        map{name:"summarize_line_prefix_groups",scope:"input_prefix",detail:"Count exact Unicode-scalar prefixes of each LF-separated line, including empty lines. Sort descending count then lexical prefix order. max_chars clips the input prefix, possibly cutting a line. max_groups truncates the ranked groups. No case folding or normalization.",options:map{prefix_len:map{type:"integer",minimum:1,maximum:96,default:12},max_groups:map{type:"integer",minimum:1,maximum:200,default:40}}}
    ];
}
fn implemented_tools(){let names=[];for spec in _specs(){push(names,spec.name);}return names;}
fn _integer(value,low,high){if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value){throw "invalid line analysis bound";}}
fn call_lines(name,args){
    let selected:any=nil;for spec in _specs(){if spec.name==name {selected=spec;}}
    if selected==nil{return nil;}
    if type(args)!="map" or not map_has(args,"text"){throw "invalid line analysis arguments";}
    for key in map_keys(args){if key!="text" and key!="max_chars" and not map_has(selected.options,key){throw "invalid line analysis arguments";}}
    if type(args.text)!="string" or len(args.text)>16384 or len(str_to_bytes(args.text))>16384 {throw "line analysis byte limit";}
    if len(str_split(args.text,"\n"))>2048 {throw "line analysis count limit";}
    let maximum=if map_has(args,"max_chars"){args.max_chars}else{4000};_integer(maximum,1,8192);
    for key in map_keys(selected.options){if map_has(args,key){_integer(args[key],selected.options[key].minimum,selected.options[key].maximum);}}
    let value:any=nil;
    if name=="summarize_duplicate_lines" {value=TEXT.summarize_duplicate_lines(args.text,try args.min_occurrences catch 2,try args.max_entries catch 40,maximum);}
    if name=="summarize_line_histogram" {value=TEXT.summarize_line_histogram(args.text,maximum);}
    if name=="summarize_line_prefix_groups" {value=TEXT.summarize_line_prefix_groups(args.text,try args.prefix_len catch 12,try args.max_groups catch 40,maximum);}
    let result=map{value:value,budget_scope:selected.scope,input_truncated:selected.scope=="input_prefix" and len(args.text)>maximum,safe_to_log:false,automatic_deletion:false};
    if len(str_to_bytes(json_stringify(result)))>65536 {throw "line analysis output limit";}
    return result;
}
fn catalog_entries(){
    let entries=[];for spec in _specs(){
        let props=map{text:map{type:"string",maxLength:16384,description:"At most16384 UTF-8 bytes and2048 LF-separated logical lines; empty allowed."},max_chars:map{type:"integer",minimum:1,maximum:8192,default:4000}};
        for key in map_keys(spec.options){props[key]=spec.options[key];}
        push(entries,map{name:spec.name,category:"offline-text",profile:"core-code",read_only:true,destructive:false,open_world:false,source:"src/text_compute.sapp",
            description:spec.detail+" Returns shared computation under value plus budget_scope/input_truncated/safe_to_log:false/automatic_deletion:false. Results may contain private input lines or prefixes; not safe for logs or automatic context deletion. Inline caller data only; <=16384 UTF-8 bytes/2048 logical lines; output <=65536 serialized UTF-8 bytes. No files, network, model, execution, storage or trust grant.",input_schema:map{type:"object",required:["text"],additionalProperties:false,properties:props}});
    }return entries;
}
export implemented_tools,call_lines,catalog_entries;
