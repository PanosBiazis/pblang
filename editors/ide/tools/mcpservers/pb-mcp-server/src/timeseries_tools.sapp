// Time-series tools for pb-mcp-server — exposes stdlib:timeseries.sapp over MCP.
//
// Smoothing (SMA/EMA), differencing, autocorrelation, rolling stats, and
// RiskMetrics EWMA volatility. All inputs and outputs are plain numbers / arrays
// (JSON-clean). Pairs with the probability + inferential tool groups.

let ts = import("stdlib:timeseries.sapp");

let TS_TOOLS = ["ts_sma", "ts_ema", "ts_diff", "ts_cumsum",
                "ts_autocorr", "ts_rolling_std", "ts_ewma_vol"];

fn tool_list() { return TS_TOOLS; }
fn implemented_tools() { return TS_TOOLS; }

fn call_timeseries(tool, args) {
    if args == nil { args = map{}; }

    if tool == "ts_sma" {
        let data = try args.data catch [];
        let window = try args.window catch 1;
        if window <= 0 or window > len(data) { return map{ ok: false, error: "ts_sma: window must be in 1..len(data)" }; }
        return map{ result: ts.sma(data, window) };
    }
    if tool == "ts_ema" {
        let data = try args.data catch [];
        let alpha = try args.alpha catch 0.5;
        if alpha <= 0 or alpha > 1 { return map{ ok: false, error: "ts_ema: alpha must be in (0,1]" }; }
        return map{ result: ts.ema(data, alpha) };
    }
    if tool == "ts_diff" {
        let data = try args.data catch [];
        return map{ result: ts.diff(data) };
    }
    if tool == "ts_cumsum" {
        let data = try args.data catch [];
        return map{ result: ts.cumsum(data) };
    }
    if tool == "ts_autocorr" {
        let data = try args.data catch [];
        let lag = try args.lag catch 1;
        if lag < 0 or lag >= len(data) { return map{ ok: false, error: "ts_autocorr: lag must be in 0..len(data)-1" }; }
        return map{ result: ts.autocorr(data, lag) };
    }
    if tool == "ts_rolling_std" {
        let data = try args.data catch [];
        let window = try args.window catch 2;
        if window <= 1 or window > len(data) { return map{ ok: false, error: "ts_rolling_std: window must be in 2..len(data)" }; }
        return map{ result: ts.rolling_std(data, window) };
    }
    if tool == "ts_ewma_vol" {
        let returns = try args.returns catch [];
        let lambda = try args.lambda catch 0.94;
        if lambda <= 0 or lambda >= 1 { return map{ ok: false, error: "ts_ewma_vol: lambda must be in (0,1)" }; }
        if len(returns) == 0 { return map{ ok: false, error: "ts_ewma_vol: returns must be non-empty" }; }
        return map{ result: ts.ewma_vol(returns, lambda) };
    }
    return nil;
}

export call_timeseries, tool_list, implemented_tools, TS_TOOLS;
