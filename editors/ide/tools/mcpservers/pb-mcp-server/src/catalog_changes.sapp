// Review changes in two complete caller-supplied catalogs; never grant authority.
let SNAPSHOT=import("catalog_snapshot.sapp");
fn _fail(){throw "catalog changes: invalid or unsupported snapshots";}

fn limits(){
    return map{snapshots:2,per_snapshot:SNAPSHOT.limits(),comparison_depth:32,
        classification_names:512,required_names:256};
}

// The general JSON.equal helper can dispatch a map's __eq__ for mixed kinds.
// Only compare primitive values after kind checks; arbitrary map keys are data.
// Both complete graphs are admitted by Snapshot.review before this is called.
fn _same(a,b,depth){
    if depth>32 {_fail();}
    let kind=type(a);
    if kind!=type(b){return false;}
    if kind=="map" {
        if len(a)!=len(b){return false;}
        for key in map_keys(a){
            if not map_has(b,key){return false;}
            if not _same(a[key],b[key],depth+1){return false;}
        }
        return true;
    }
    if kind=="array" {
        if len(a)!=len(b){return false;}
        for i len(a){if not _same(a[i],b[i],depth+1){return false;}}
        return true;
    }
    if kind=="nil" {return true;}
    if kind=="string" or kind=="number" or kind=="bool" {return a==b;}
    _fail();
}

fn _index(snapshot){
    let out=map{};
    for page in snapshot.pages {
        for descriptor in page.response.result.tools {out[descriptor.name]=descriptor;}
    }
    return out;
}
fn _coverage(result){
    return map{page_count:result.page_count,tool_count:result.tool_count,
        required_count:result.required_count,present_required:result.present_required,
        missing_required:result.missing_required};
}

fn review(args){
    if type(args)!="map" or len(args)!=2 {_fail();}
    if not map_has(args,"before") or not map_has(args,"after") {_fail();}
    // Validation completes on BOTH sides before extracting or comparing values.
    // Do not accept a names-only summary as a substitute for either transcript.
    let before=try SNAPSHOT.review(args.before) catch _fail();
    let after=try SNAPSHOT.review(args.after) catch _fail();
    let left=_index(args.before);let right=_index(args.after);
    let added=[];let removed=[];let changed=[];let unchanged=[];
    let fields=["inputSchema","outputSchema","title","description","annotations","_meta"];
    for name in after.tool_names {
        if not map_has(left,name){array_push(added,name);continue;}
        let labels=[];
        for field in fields {
            let has_left=map_has(left[name],field);let has_right=map_has(right[name],field);
            if has_left!=has_right {array_push(labels,field);}
            elif has_left and not _same(left[name][field],right[name][field],0) {
                array_push(labels,field);
            }
        }
        if len(labels)>0 {array_push(changed,map{name:name,fields:labels});}
        else {array_push(unchanged,name);}
    }
    for name in before.tool_names {if not map_has(right,name){array_push(removed,name);}}
    return map{format:"pb_mcp.catalog_changes.v1",before:_coverage(before),after:_coverage(after),
        added:added,removed:removed,changed:changed,unchanged:unchanged,
        changes_detected:len(added)+len(removed)+len(changed)>0,
        compatibility:"not_evaluated",provenance:"caller-supplied-unverified",
        safe_to_log:false,metadata_only:true,external_calls:false,
        authentication_performed:false,tools_executed:false,schemas_evaluated:false,
        authorization_granted:false};
}
export review,limits;
