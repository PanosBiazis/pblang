// Native pblang translations for small deterministic quantum simulations.
//
// This is an educational simulator and analytic fallback, not a hardware or
// high-performance quantum runtime.

let sec = import("src/security.sapp");

fn _pow2(n) {
    let v = 1;
    for i n { v = v * 2; }
    return v;
}

fn _abs(x) {
    if x < 0 { return 0 - x; }
    return x;
}

fn _basis_state(n, index) {
    let out = [];
    let size = _pow2(n);
    for i size {
        if i == index { out[len(out)] = 1.0; }
        else { out[len(out)] = 0.0; }
    }
    return out;
}

fn _parse_qubits(qasm) {
    let lines = str_split(str(qasm), "\n");
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_starts_with(t, "qreg ") {
            let lb = str_index_of(t, "[");
            let rb = str_index_of(t, "]");
            if lb >= 0 and rb > lb { return try parse_number(str_slice(t, lb + 1, rb)) catch 1; }
        }
    }
    return 1;
}

fn _target(line) {
    let lb = str_index_of(line, "[");
    let rb = str_index_of(line, "]");
    if lb >= 0 and rb > lb { return try parse_number(str_slice(line, lb + 1, rb)) catch 0; }
    return 0;
}

fn _apply_x(state, n, target) {
    let out = [];
    let mask = _pow2(target);
    for i len(state) { out[len(out)] = 0.0; }
    for i len(state) {
        let j = i ^ mask;
        out[j] = state[i];
    }
    return out;
}

fn _apply_h_prob(state, n, target) {
    // Probability-only Hadamard fallback: distributes probability mass between
    // paired states. This ignores phase but is useful for small educational runs.
    let out = [];
    for i len(state) { out[len(out)] = 0.0; }
    let mask = _pow2(target);
    for i len(state) {
        let j = i ^ mask;
        let mass = state[i] * state[i];
        out[i] = out[i] + mass / 2.0;
        out[j] = out[j] + mass / 2.0;
    }
    for i len(out) { out[i] = num_sqrt(out[i]); }
    return out;
}

fn _probabilities(state) {
    let out = [];
    for i len(state) { out[len(out)] = map{ state: i, probability: state[i] * state[i] }; }
    return out;
}

fn quantum_circuit_simulate(args) {
    if args == nil { args = map{}; }
    let qasm = str(try args.qasm catch try args.program catch "");
    let n = sec.clamp(try args.qubits catch _parse_qubits(qasm), 1, 8);
    let state = _basis_state(n, 0);
    let lines = str_split(qasm, "\n");
    for i len(lines) {
        let t = str_trim(lines[i]);
        if str_starts_with(t, "x ") { state = _apply_x(state, n, _target(t)); }
        if str_starts_with(t, "h ") { state = _apply_h_prob(state, n, _target(t)); }
    }
    return map{ qubits: n, probabilities: _probabilities(state), simulator: "pblang-probability-fallback", phase_accurate: false };
}

fn quantum_grover_search(args) {
    if args == nil { args = map{}; }
    let items = try args.items catch [];
    let marked = try args.marked_index catch try args.target_index catch 0;
    let n = len(items);
    if n == 0 { n = try args.size catch 4; }
    marked = sec.clamp(marked, 0, n - 1);
    let iterations = try args.iterations catch num_floor(num_sqrt(n));
    let probabilities = [];
    for i n {
        let p = if i == marked { 1.0 } else { 0.0 };
        probabilities[len(probabilities)] = map{ index: i, probability: p };
    }
    return map{ size: n, marked_index: marked, iterations: iterations, probabilities: probabilities, analytic_fallback: true };
}

fn quantum_shor_factor(args) {
    if args == nil { args = map{}; }
    let n = sec.clamp(try args.n catch try args.number catch 15, 2, 1000000);
    let factor = 0;
    let d = 2;
    while d * d <= n and factor == 0 {
        if n % d == 0 { factor = d; }
        d = d + 1;
    }
    if factor == 0 { return map{ n: n, factors: [1, n], prime: true, method: "pblang-classical-factor-fallback" }; }
    return map{ n: n, factors: [factor, n / factor], prime: false, method: "pblang-classical-factor-fallback" };
}

fn call_quantum(tool, args) {
    if tool == "quantum_circuit_simulate" { return quantum_circuit_simulate(args); }
    if tool == "quantum_grover_search" { return quantum_grover_search(args); }
    if tool == "quantum_shor_factor" { return quantum_shor_factor(args); }
    return nil;
}

fn implemented_tools() {
    return ["quantum_circuit_simulate", "quantum_grover_search", "quantum_shor_factor"];
}

export implemented_tools, call_quantum,
       quantum_circuit_simulate, quantum_grover_search, quantum_shor_factor;
