let _V19_MOD_CACHE = map{};

fn _v19_eng() {
    if map_has(_V19_MOD_CACHE, "v19") { return _V19_MOD_CACHE["v19"]; }
    let m = try import("editors/ide/tools/ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch nil; }
    if m == nil { m = try import("../../ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch try import("../../pblang/editors/ide/tools/ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp") catch import("../../../pblang/editors/ide/tools/ai/pbai_predictive_future_time_travel_and_omniscience_v19.sapp"); }
    _V19_MOD_CACHE["v19"] = m;
    return m;
}

