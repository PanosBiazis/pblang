// Bounded structural previews of caller-supplied text; no file or model access.
let TEXT = import("text_compute.sapp");

fn _specs() {
    return [
        map{name:"summarize_json_structure", required:["text"], detail:"Parse JSON and return root_type plus a bounded shape. Object keys are sorted and limited per level; arrays expose their length and first item only. Scalars become type labels, not values. Duplicate keys use last-wins parsing. An omitted-key count uses the first unused dot-only key starting with ...; genuine dot keys are preserved. This is a structural preview, not JSON Schema inference or validation of all array item types.", options:map{
            max_depth:map{type:"integer",minimum:0,maximum:8,default:4},
            max_keys_per_level:map{type:"integer",minimum:1,maximum:40,default:40}}},
        map{name:"summarize_delimited_header", required:["text","delimiter"], detail:"Split only the first LF-separated line literally, trim each label, and preserve order, duplicate and empty labels. This is not a CSV parser: quoting and escaped delimiters are not interpreted. max_chars budgets cumulative returned label scalars; a label that does not fit is skipped while later labels may fit. Later lines are ignored.", options:map{
            delimiter:map{type:"string",enum:["comma","tab","pipe","semicolon"]},
            max_columns:map{type:"integer",minimum:1,maximum:200,default:200},
            max_chars:map{type:"integer",minimum:1,maximum:4096,default:4000}}}
    ];
}
fn implemented_tools() {
    let out = [];
    for spec in _specs() { push(out, spec.name); }
    return out;
}
fn _integer(value, low, high) {
    if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value) {
        throw "invalid structure bound";
    }
}
fn _json_depth(text) {
    // Admission only; the shared JSON parser still owns complete grammar checks.
    let depth = 0; let quoted = false; let escaped = false;
    for i len(text) {
        let code = strcharcodeat(text, i);
        if quoted {
            if escaped { escaped=false; }
            elif code==92 { escaped=true; }
            elif code==34 { quoted=false; }
        } elif code==34 { quoted=true; }
        elif code==123 or code==91 {
            depth=depth+1;
            if depth>16 { throw "JSON nesting limit"; }
        } elif code==125 or code==93 {
            depth=depth-1;
            if depth<0 { throw "invalid JSON nesting"; }
        }
    }
    if quoted or depth!=0 { throw "invalid JSON nesting"; }
}
fn call_structure(name, args) {
    let selected:any = nil;
    for spec in _specs() { if spec.name==name { selected=spec; } }
    if selected==nil { return nil; }
    if type(args)!="map" { throw "invalid structure arguments"; }
    for key in selected.required { if not map_has(args,key) { throw "missing structure argument"; } }
    for key in map_keys(args) {
        if key!="text" and not map_has(selected.options,key) { throw "unknown structure argument"; }
    }
    if type(args.text)!="string" or len(args.text)>8192 or len(str_to_bytes(args.text))>8192 {
        throw "structure input limit";
    }
    for key in map_keys(selected.options) {
        if map_has(args,key) and key!="delimiter" {
            _integer(args[key],selected.options[key].minimum,selected.options[key].maximum);
        }
    }
    let result:any = nil;
    if name=="summarize_json_structure" {
        _json_depth(args.text);
        let depth=try args.max_depth catch 4;
        let keys=try args.max_keys_per_level catch 40;
        let shared=TEXT.summarize_json_structure(args.text,depth,keys);
        if not shared.ok { throw "invalid JSON structure"; }
        // Legacy max_lines/max_chars fields are metadata, not enforced budgets.
        result=map{value:map{root_type:shared.root_type,shape:shared.shape},
            budget_scope:"structure_depth_and_keys",max_depth:depth,max_keys_per_level:keys,
            array_items:"first_only",duplicate_keys:"last_wins",omission_markers:"first_unused_dot_key",
            scalar_values_included:false,safe_to_log:false,automatic_deletion:false};
    } else {
        let delimiters=map{comma:",",tab:"\t",pipe:"|",semicolon:";"};
        if type(args.delimiter)!="string" or not map_has(delimiters,args.delimiter) {
            throw "invalid header delimiter";
        }
        let lines=str_split(args.text,"\n");
        let columns=len(str_split(lines[0],delimiters[args.delimiter]));
        if columns>1024 { throw "header column limit"; }
        let value=TEXT.summarize_delimited_header(args.text,args.delimiter,
            try args.max_columns catch 200,try args.max_chars catch 4000);
        result=map{value:value,budget_scope:"returned_header_text",columns_seen:columns,
            columns_omitted:columns-len(value),additional_lines_ignored:len(lines)>1,
            csv_quoting:false,safe_to_log:false,automatic_deletion:false};
    }
    if len(str_to_bytes(json_stringify(result)))>65536 { throw "structure output limit"; }
    return result;
}
fn catalog_entries() {
    let out=[];
    for spec in _specs() {
        let props=map{text:map{type:"string",maxLength:8192,
            description:"At most 8192 UTF-8 bytes. JSON nesting <=16 before parsing; header first line <=1024 literal columns."}};
        for key in map_keys(spec.options) { props[key]=spec.options[key]; }
        push(out,map{name:spec.name,category:"offline-text",profile:"core-code",read_only:true,
            destructive:false,open_world:false,source:"src/text_compute.sapp",
            description:spec.detail+" Output <=65536 serialized UTF-8 bytes. Returned keys/labels may be private: safe_to_log:false and automatic_deletion:false. Unicode keys/labels are preserved without normalization. No file, network, model, execution or storage access.",
            input_schema:map{type:"object",required:spec.required,additionalProperties:false,properties:props}});
    }
    return out;
}
export implemented_tools,call_structure,catalog_entries;
