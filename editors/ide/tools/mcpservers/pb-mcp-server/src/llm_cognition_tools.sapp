        _check_wave4_keys(doc, ["viewport_width", "viewport_height", "dirty_rect_coalescing", "unsafe_skip_present", "primary_error"], "pblang_native_ui_small_screen_and_callback_gate");
        let out = try WAVE4.qualify_product_native_ui_and_small_screen_matrix(doc) catch nil;
        if out == nil or not out.ok { throw "pblang_native_ui_small_screen_and_callback_gate: invalid native UI/callback specification"; }
