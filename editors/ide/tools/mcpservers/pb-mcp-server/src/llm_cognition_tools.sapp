        _check_wave4_keys(doc, ["theme_name", "custom_tokens", "screen_schema"], "pblang_flagship_default_ui_engine");
        let w7 = _wave_mod("WAVE7");
        let out = try w7.run_flagship_default_ui_wave7_suite() catch nil;
        if out == nil or not out.ok { throw "pblang_flagship_default_ui_engine: invalid flagship UI specification"; }
        if map_has(doc, "custom_tokens") and type(doc.custom_tokens) == "map" {
            out.synthesized_custom_theme = w7.synthesize_custom_theme(doc.custom_tokens);
        }
        if map_has(doc, "screen_schema") and type(doc.screen_schema) == "map" {
            out.dynamic_screen = w7.build_dynamic_screen_from_schema(doc.screen_schema);
