    if tool == "pblang_universal_profession_app_suite" {
        let doc = _parse_spec(args, "pblang_universal_profession_app_suite");
        _check_wave4_keys(doc, ["profession_id", "edition_target", "theme_override"], "pblang_universal_profession_app_suite");
        let w8 = _wave_mod("WAVE8");
        let prof_id = if map_has(doc, "profession_id") and type(doc.profession_id) == "string" and len(doc.profession_id) > 0 { doc.profession_id } else { "general_practitioner_md" };
        let ed_target = if map_has(doc, "edition_target") and type(doc.edition_target) == "string" and len(doc.edition_target) > 0 { doc.edition_target } else { "all_editions" };
        let th_override = if map_has(doc, "theme_override") and type(doc.theme_override) == "string" { doc.theme_override } else { "" };
        let app_inst = try w8.instantiate_profession_app(prof_id, ed_target, th_override) catch nil;
        let suite = try w8.run_universal_profession_suite_wave8() catch nil;
        if app_inst == nil or not app_inst.ok or suite == nil or not suite.ok {
            throw "pblang_universal_profession_app_suite: invalid profession suite specification";
        }
        suite.requested_profession_instance = app_inst;
        return suite;
    }
    if tool == "pblang_smart_lazy_idle_optimizer" {
        let doc = _parse_spec(args, "pblang_smart_lazy_idle_optimizer");
        _check_wave4_keys(doc, ["app_name", "modules_list", "routing_graph", "active_command", "idle_budget_ms"], "pblang_smart_lazy_idle_optimizer");
        let w9 = _wave_mod("WAVE9");
        let out = try w9.run_smart_lazy_idle_optimizer_wave9_suite() catch nil;
        if out == nil or not out.ok { throw "pblang_smart_lazy_idle_optimizer: invalid lazy optimizer specification"; }
        if map_has(doc, "app_name") and type(doc.app_name) == "string" and map_has(doc, "modules_list") and type(doc.modules_list) == "array" {
            let r_graph = if map_has(doc, "routing_graph") and type(doc.routing_graph) == "map" { doc.routing_graph } else { map{} };
            let act_cmd = if map_has(doc, "active_command") and type(doc.active_command) == "string" { doc.active_command } else { "help" };
            let budget = if map_has(doc, "idle_budget_ms") and type(doc.idle_budget_ms) == "number" { doc.idle_budget_ms } else { 15 };
            out.custom_graph_analysis = w9.analyze_arbitrary_module_graph(doc.app_name, doc.modules_list, r_graph, act_cmd, budget);
        }
        return out;
    }
    if tool == "pblang_omni_supremacy_engine" {
        let doc = _parse_spec(args, "pblang_omni_supremacy_engine");
        _check_wave4_keys(doc, ["expression_ir", "loop_depth", "symbol_name", "has_cycles", "escapes_thread", "byte_size", "precondition", "postcondition", "qubits", "spiking_neurons", "tensor_flops_giga"], "pblang_omni_supremacy_engine");
        let w10 = _wave_mod("WAVE10");
        let out = try w10.run_pblang_omni_supremacy_wave10_suite() catch nil;
        if out == nil or not out.ok { throw "pblang_omni_supremacy_engine: invalid omni-supremacy specification"; }
        if map_has(doc, "expression_ir") and type(doc.expression_ir) == "string" {
            let ldepth = if map_has(doc, "loop_depth") and type(doc.loop_depth) == "number" { doc.loop_depth } else { 1 };
            out.custom_egraph = w10.run_egraph_superoptimizer(doc.expression_ir, ldepth);
        }
        return out;
    }
    if tool == "pblang_aap_ecosystem_unified_fabric" {
        let doc = _parse_spec(args, "pblang_aap_ecosystem_unified_fabric");
        _check_wave4_keys(doc, ["value_a", "value_b", "abs_tolerance", "rel_tolerance", "allocation_total_units", "allocation_weights", "r_source_ohms", "r_load_min_ohms", "r_load_max_ohms", "repo_visibility", "scan_payload"], "pblang_aap_ecosystem_unified_fabric");
        let out = try _wave_mod("WAVE11").run_aap_ecosystem_unified_fabric_suite(doc) catch nil;
        if out == nil or not out.ok { throw "pblang_aap_ecosystem_unified_fabric: invalid AAP unified fabric specification"; }
        return out;
    }
    if tool == "pblang_aap_deep_domain_engines_wave12" {
        let doc = _parse_spec(args, "pblang_aap_deep_domain_engines_wave12");
        _check_wave4_keys(doc, ["source_text", "query_byte_offset", "num_a", "den_a", "num_b", "den_b", "samples", "x0", "y0", "x1", "y1", "xq", "dur_a", "dur_b", "dur_c", "dur_d", "sheet_w", "sheet_h", "tile_w", "tile_h", "unit_cost_eur", "unit_price_eur", "qty", "min_margin_pct", "untrusted_html"], "pblang_aap_deep_domain_engines_wave12");
        let out = try _wave_mod("WAVE12").run_aap_deep_domain_engines_wave12_suite(doc) catch nil;
        if out == nil or not out.ok { throw "pblang_aap_deep_domain_engines_wave12: invalid AAP deep domain engines specification"; }
        return out;
    }
    return nil;
}

