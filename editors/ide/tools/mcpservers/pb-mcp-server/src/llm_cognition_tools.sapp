        _check_wave4_keys(doc, ["title", "strokes", "source_framework", "form_payload", "requested_targets", "allow_custom_targets", "hotspot_spec", "ai_provider", "os_level", "erp_role", "email_trust"], "pblang_visual_sketch_and_polyform_studio");
        let out = try _wave_mod("WAVE6").run_visual_sketch_and_polyform_wave6_suite(doc) catch nil;
