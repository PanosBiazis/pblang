        let doc = _parse_spec(args, "pblang_netvis_portions_reshape_qualifier");
        _check_wave4_keys(doc, ["target_os", "initial_nodes", "added_nodes", "greek_ime_sample"], "pblang_netvis_portions_reshape_qualifier");
        let out = try WAVE4.qualify_pbportions_pbreshape_pbworkdays_and_netvis(doc) catch nil;
        if out == nil or not out.ok { throw "pblang_netvis_portions_reshape_qualifier: invalid NetVis/Portions/Reshape specification"; }
