        _check_wave4_keys(doc, ["product", "version", "native_input_us", "runtime_compute_us", "harness_overhead_us", "dirty_worktree_preserved"], "pblang_reconcile_loadlab_packager");
        let out = try WAVE4.qualify_pbreconcile_pbloadlab_and_versioned_packaging(doc) catch nil;
