// Pure offline LLM Cognition, Idiom Mentor, Orientation Brief, L1..L4 Topology Sync,
// Epistemic Claim Gate, Dual-Stack & Commercial Contract Verifier, and GUI Viewport & DAG tools
// backed by stdlib:llm_cognition_suite.sapp.
// Solves Large Language Model (MMTN) limitations in 100% pure offline PBLang with 0 lint warnings.
let LLM = import("stdlib:llm_cognition_suite.sapp");
let WAVE2 = import("stdlib:compiler_and_ecosystem_wave2.sapp");
let WAVE3 = import("stdlib:handoff_and_historical_jobs_wave3.sapp");
let WAVE4 = import("stdlib:stage2_bootstrap_and_hil_wave4.sapp");
let WAVE5 = import("stdlib:remaining_partial_closure_wave5.sapp");
let SERIAL = import("stdlib:serialization.sapp");
let MAX_BYTES = 131072;
let _WAVE_MOD_CACHE = map{};

fn _wave_mod(key) {
    if map_has(_WAVE_MOD_CACHE, key) { return _WAVE_MOD_CACHE[key]; }
    let m = nil;
    if key == "WAVE6" { m = import("stdlib:visual_sketch_and_polyform_studio.sapp"); }
    elif key == "WAVE7" { m = import("stdlib:flagship_default_ui_engine.sapp"); }
    elif key == "WAVE8" { m = import("stdlib:universal_profession_app_suite.sapp"); }
    elif key == "WAVE9" { m = import("stdlib:smart_lazy_idle_optimizer.sapp"); }
    elif key == "WAVE10" { m = import("stdlib:pblang_omni_supremacy_engine.sapp"); }
    elif key == "WAVE11" { m = import("stdlib:aap_ecosystem_unified_fabric.sapp"); }
    elif key == "WAVE12" { m = import("stdlib:aap_deep_domain_engines_wave12.sapp"); }
    _WAVE_MOD_CACHE[key] = m;
    return m;
}


fn _parse_spec(args, ctx) {
    if type(args) != "map" or len(args) != 1 or not map_has(args, "spec_json") {
        throw ctx + ": invalid arguments";
    }
    let text = args.spec_json;
    if type(text) != "string" or len(text) < 2 or len(text) > MAX_BYTES {
        throw ctx + ": invalid arguments";
    }
    let parsed = SERIAL.parse_safe(text, "json", map{
        max_input_bytes: MAX_BYTES,
        max_output_bytes: MAX_BYTES,
        max_depth: 8,
        max_items: 4096,
        max_lines: 4096,
        max_line_bytes: MAX_BYTES,
        strict: true,
        reject_duplicate_keys: true
    });
    if not parsed.ok or type(parsed.value) != "map" {
        throw ctx + ": invalid document";
    }
    return parsed.value;
}

fn _check_wave4_keys(doc, allowed, ctx) {
    if type(doc) != "map" or len(doc) > len(allowed) {
        throw ctx + ": invalid specification keys";
    }
    let matched = 0;
    for k in allowed {
        if map_has(doc, k) { matched = matched + 1; }
    }
    if matched != len(doc) {
        throw ctx + ": unknown specification keys";
    }
    return true;
}

fn call_llm_cognition(tool, args) {
    if tool == "llm_idiom_mentor" {
        let doc = _parse_spec(args, "llm_idiom_mentor");
        let out = try LLM.inspect_pblang_idioms(doc) catch nil;
        if out == nil { throw "llm_idiom_mentor: invalid idiom specification"; }
        return out;
    }
    if tool == "llm_orientation_brief" {
        let doc = _parse_spec(args, "llm_orientation_brief");
        let out = try LLM.compile_orientation_brief(doc) catch nil;
        if out == nil { throw "llm_orientation_brief: invalid orientation specification"; }
        return out;
    }
    if tool == "llm_topology_truth_gate" {
        let doc = _parse_spec(args, "llm_topology_truth_gate");
        let out = try LLM.audit_ecosystem_topology(doc) catch nil;
        if out == nil { throw "llm_topology_truth_gate: invalid topology specification"; }
        return out;
    }
    if tool == "llm_epistemic_claim_gate" {
        let doc = _parse_spec(args, "llm_epistemic_claim_gate");
        let out = try LLM.evaluate_epistemic_claims(doc) catch nil;
        if out == nil { throw "llm_epistemic_claim_gate: invalid epistemic claim specification"; }
