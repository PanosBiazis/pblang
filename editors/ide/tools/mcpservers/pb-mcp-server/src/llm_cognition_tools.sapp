    }
    if tool == "llm_delphi_blazor_migrator" {
        let doc = _parse_spec(args, "llm_delphi_blazor_migrator");
        let out = try LLM.migrate_delphi_to_blazor(doc) catch nil;
        if out == nil { throw "llm_delphi_blazor_migrator: invalid Delphi/Blazor specification"; }
