    if tool == "pblang_pbai_joint_and_deq_trainer" {
        let doc = _parse_spec(args, "pblang_pbai_joint_and_deq_trainer");
        let out = try WAVE3.train_joint_autoencoder_and_deq_step(doc) catch nil;
        if out == nil { throw "pblang_pbai_joint_and_deq_trainer: invalid pbAI joint/DEQ specification"; }
        return out;
    }
    if tool == "pblang_resource_p95_and_recovery_audit" {
        let doc = _parse_spec(args, "pblang_resource_p95_and_recovery_audit");
        let out = try WAVE3.evaluate_resource_p95_and_recovery_audit(doc) catch nil;
        if out == nil { throw "pblang_resource_p95_and_recovery_audit: invalid resource p95/recovery specification"; }
        return out;
    }
    if tool == "pblang_stage2_bootstrap_and_binary_emit" {
        let doc = _parse_spec(args, "pblang_stage2_bootstrap_and_binary_emit");
        _check_wave4_keys(doc, ["source", "expected_output"], "pblang_stage2_bootstrap_and_binary_emit");
        let clean_doc = map{
            source: try doc.source catch "fn add2(a, b) { return a + b; }\nfn main_calc(x) { return add2(add2(x, 10), add2(5, 7)); }\nprint main_calc(20);",
            expected_output: try doc.expected_output catch 42
        };
        let out = try WAVE4.execute_stage2_selfhost_bootstrap_and_binary_emit(clean_doc) catch nil;
        if out == nil or not out.ok { throw "pblang_stage2_bootstrap_and_binary_emit: invalid stage2 bootstrap specification"; }
        return out;
    }
    if tool == "pblang_hil_mcu_cnc_and_bme688_verifier" {
        let doc = _parse_spec(args, "pblang_hil_mcu_cnc_and_bme688_verifier");
        _check_wave4_keys(doc, ["board", "clock_mhz", "uart_baud", "i2c_khz", "i2c_rise_ns", "i2c_setup_ns", "step_pulse_us", "gcode_program", "probe_live_host_sysfs"], "pblang_hil_mcu_cnc_and_bme688_verifier");
        doc["probe_live_host_sysfs"] = false;
        let out = try WAVE4.execute_hil_mcu_cnc_and_bme688_verifier(doc) catch nil;
