        let out = try WAVE4.qualify_pbcleanroom_zip_font_and_x11_ownership(doc) catch nil;
        if out == nil or not out.ok { throw "pblang_cleanroom_zip_font_x11_gate: invalid Cleanroom ZIP/font/X11 specification"; }
        return out;
