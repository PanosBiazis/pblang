// Offline admission and interpretation around the shared full-server computation.
let TEXT=import("text_compute.sapp");
fn call_distance(name,args) {
    if name!="text_levenshtein_distance" {return nil;}
    if type(args)!="map" or not map_has(args,"a") or not map_has(args,"b") {throw "invalid distance arguments";}
    for key in map_keys(args) {
        if key!="a" and key!="b" and key!="max_len" {throw "invalid distance arguments";}
    }
    for value in [args.a,args.b] {
        if type(value)!="string" or len(value)>512 or len(str_to_bytes(value))>512 {throw "distance input limit";}
    }
    let limit=if map_has(args,"max_len") {args.max_len} else {128};
    if type(limit)!="number" or not (limit>=1 and limit<=128) or limit!=num_floor(limit) {throw "invalid distance bound";}
    let a_len=len(args.a);let b_len=len(args.b);
    return map{value:TEXT.text_levenshtein_distance(args.a,args.b,limit),
        unit:"unicode_scalar",normalization:"none",case_sensitive:true,
        compared_length_a:if a_len>limit {limit} else {a_len},
        compared_length_b:if b_len>limit {limit} else {b_len},
        truncated_a:a_len>limit,truncated_b:b_len>limit,
        semantic_similarity:false,source_identity_verified:false};
}
fn catalog_entries() {
    let text=map{type:"string",maxLength:512,description:"At most512 UTF-8 bytes; empty text allowed."};
    return [map{name:"text_levenshtein_distance",category:"offline-text",profile:"core-code",read_only:true,destructive:false,open_world:false,
        source:"src/text_compute.sapp",description:"Count minimum single Unicode-scalar insertions, deletions and substitutions between supplied a and b prefixes. Case-sensitive; no Unicode normalization, grapheme segmentation or transposition operation. Each input at most512 UTF-8 bytes. max_len clips each prefix to1..128 scalars (default128); returns numeric value, compared lengths and truncation flags without input text. Zero on clipped prefixes does not prove whole-input equality. NOT semantic similarity or source identity. No model, file, network, persistence, edits or deletion.",
        input_schema:map{type:"object",required:["a","b"],additionalProperties:false,properties:map{
            a:text,b:text,max_len:map{type:"integer",minimum:1,maximum:128,default:128}}}}];
}
export call_distance,catalog_entries;
