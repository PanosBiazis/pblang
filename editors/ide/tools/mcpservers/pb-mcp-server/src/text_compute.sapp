// Deterministic, bounded text/compress/summarize tools implemented in pblang.

let JSON = import("stdlib:json.sapp");

let MAX_TEXT_CHARS = 500000;

fn _input(value) {
    if type(value) != "string" { throw "text must be a string"; }
    if len(value) > MAX_TEXT_CHARS { throw "text exceeds 500000 characters"; }
    return value;
}

fn _max(value, fallback = 4000) {
    if value == nil { value = fallback; }
    if type(value) != "number" or value != num_floor(value) or value < 1 or value > MAX_TEXT_CHARS {
        throw "max_chars must be an integer from 1 to 200000";
    }
    return value;
}

fn _bounded_int(value, fallback, low, high, name) {
    if value == nil { value = fallback; }
    if type(value) != "number" or value != num_floor(value) or value < low or value > high {
        throw name + " must be an integer from " + str(low) + " to " + str(high);
    }
    return value;
}

fn _clip(value, max_chars, suffix = "...[truncated]") {
    let s = str(value);
    let m = _max(max_chars);
    if len(s) <= m { return s; }
    if len(suffix) >= m { return str_slice(s, 0, m); }
    return str_slice(s, 0, m - len(suffix)) + suffix;
}

fn _lines(value) { return str_split(_input(value), "\n"); }

fn _join(items, separator) {
    let out = "";
    for i len(items) {
        if i > 0 { out = out + separator; }
        out = out + str(items[i]);
    }
    return out;
}

fn _contains(items, value) {
    for i len(items) { if items[i] == value { return true; } }
    return false;
}

fn _ascii_identifier_start(code) {
    return code == 95 or (code >= 65 and code <= 90) or (code >= 97 and code <= 122);
}

fn _ascii_identifier_continue(code) {
    return _ascii_identifier_start(code) or (code >= 48 and code <= 57);
}

fn _identifier_tokens(text, fold_case = false) {
    let s = _input(text);
    let out = [];
    let i = 0;
    while i < len(s) {
        if _ascii_identifier_start(strcharcodeat(s, i)) {
            let j = i + 1;
            while j < len(s) and _ascii_identifier_continue(strcharcodeat(s, j)) { j = j + 1; }
            let token = str_slice(s, i, j);
            if fold_case { token = str_lower(token); }
            array_push(out, token);
            i = j;
        } else { i = i + 1; }
    }
    return out;
}

fn _word_tokens(text, fold_case = true, max_tokens = 200000) {
    let s = _input(text);
    let tokens = regex_find_all(s, "[A-Za-z0-9_]+");
    let out = [];
    let limit = max_tokens;
    if limit > len(tokens) { limit = len(tokens); }
    for i limit {
        let token = tokens[i];
        if fold_case { token = str_lower(token); }
        array_push(out, token);
    }
    return out;
}

fn _count_tokens(tokens, min_len = 1, skip_stopwords = false) {
    let stop = map{
        a: true, an: true, and: true, are: true, as: true, at: true,
        be: true, by: true, for: true, from: true, in: true, is: true,
        it: true, of: true, on: true, or: true, that: true, the: true,
        this: true, to: true, was: true, were: true, with: true
    };
    let counts = map{};
    for i len(tokens) {
        let token = tokens[i];
        if len(token) >= min_len and (not skip_stopwords or not (try stop[token] catch false)) {
            counts[token] = (try counts[token] catch 0) + 1;
        }
    }
    return counts;
}

fn _top_counts(counts, limit, label = "term") {
    let keys = array_sort(map_keys(counts));
    let used = map{};
    let out = [];
    let n = _bounded_int(limit, 20, 1, 200, "limit");
    for _round n {
        let best = nil;
        let best_count = -1;
        for i len(keys) {
            let key = keys[i];
            if not (try used[key] catch false) and counts[key] > best_count {
                best = key;
                best_count = counts[key];
            }
        }
        if best == nil { return out; }
        used[best] = true;
        let row = map{};
        row.count = best_count; row[label] = best;
        array_push(out, row);
    }
    return out;
}

fn _sentence_records(text) {
    let s = _input(text);
    let out = [];
    let current = "";
    let index = 0;
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        current = current + ch;
        if ch == "." or ch == "!" or ch == "?" {
            let clean = str_trim(regex_replace_all(current, "[ \\t\\n\\r]+", " "));
            if clean != "" { array_push(out, map{ index: index, text: clean }); index = index + 1; }
            current = "";
        }
    }
    let clean = str_trim(regex_replace_all(current, "[ \\t\\n\\r]+", " "));
    if clean != "" { array_push(out, map{ index: index, text: clean }); }
    return out;
}

fn _heading(line) {
    let value = str_trim(line);
    let level = 0;
    while level < len(value) and level < 7 and str_slice(value, level, level + 1) == "#" { level = level + 1; }
    if level < 1 or level > 6 or level >= len(value) or str_slice(value, level, level + 1) != " " { return nil; }
    let title = str_trim(str_slice(value, level, len(value)));
    if title == "" { return nil; }
    return map{ level: level, title: title };
}

fn compress_ws_collapse(text, max_chars = 4000) {
    let lines = _lines(text);
    let out = [];
    for i len(lines) { array_push(out, str_trim(regex_replace_all(lines[i], "[ \\t\\r]+", " "))); }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_simplify_whitespace(text, max_chars = 4000) {
    return _clip(str_trim(regex_replace_all(_input(text), "[ \\t\\n\\r]+", " ")), max_chars);
}

fn summarize_token_estimate(text, max_chars = 4000) {
    let s = _input(text);
    let words = regex_find_all(s, "[^ \\t\\n\\r]+");
    return map{
        estimated_tokens: if len(words) > num_floor(len(s) / 4) { len(words) } else { num_floor(len(s) / 4) },
        word_count: len(words), character_count: len(s), byte_count: len(str_to_bytes(s)),
        line_count: len(str_split(s, "\n")), max_output_chars: _max(max_chars),
        note: "deterministic heuristic, not a tokenizer"
    };
}

fn compress_markdown_links(text, max_chars = 4000) {
    let out = regex_replace_all(_input(text), "!\\[([^]]*)\\]\\([^)]+\\)", "$1");
    out = regex_replace_all(out, "\\[([^]]+)\\]\\([^)]+\\)", "$1");
    return _clip(out, max_chars);
}

fn compress_unified_diff_stats(text, max_chars = 4000) {
    let lines = _lines(text);
    let added = 0; let removed = 0; let hunks = 0; let files = [];
    let seen = map{}; let budget = 0; let m = _max(max_chars);
    for i len(lines) {
        let line = lines[i];
        if str_starts_with(line, "@@") { hunks = hunks + 1; }
        if str_starts_with(line, "+++ ") or str_starts_with(line, "--- ") {
            let path = str_trim(str_slice(line, 4, len(line)));
            if path != "/dev/null" and not (try seen[path] catch false) and budget + len(path) <= m {
                seen[path] = true; array_push(files, path); budget = budget + len(path);
            }
        } elif str_starts_with(line, "+") { added = added + 1; }
        elif str_starts_with(line, "-") { removed = removed + 1; }
    }
    return map{ lines: len(lines), hunks: hunks, added: added, removed: removed, file_headers: files };
}

fn compress_truncate_lines(text, max_line_chars = 120, max_chars = 4000) {
    let lines = _lines(text);
    let width = _bounded_int(max_line_chars, 120, 16, 512, "max_line_chars");
    let out = [];
    for i len(lines) {
        let line = lines[i];
        if len(line) > width {
            if width <= 3 { line = str_slice(line, 0, width); }
            else { line = str_slice(line, 0, width - 3) + "..."; }
        }
        array_push(out, line);
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn summarize_diff_file_list(text, max_paths = 200, max_chars = 4000) {
    let lines = _lines(text); let set = map{};
    for i len(lines) {
        let line = lines[i];
        if str_starts_with(line, "+++ ") or str_starts_with(line, "--- ") {
            let path = str_trim(str_slice(line, 4, len(line)));
            if str_starts_with(path, "a/") or str_starts_with(path, "b/") { path = str_slice(path, 2, len(path)); }
            if path != "/dev/null" and path != "" { set[path] = true; }
        }
    }
    let keys = array_sort(map_keys(set)); let out = []; let used = 0;
    let n = _bounded_int(max_paths, 200, 4, 500, "max_paths"); let m = _max(max_chars);
    for i len(keys) {
        if len(out) >= n or used + len(keys[i]) > m { return out; }
        array_push(out, keys[i]); used = used + len(keys[i]);
    }
    return out;
}

fn summarize_top_terms(text, min_token_len = 2, max_terms = 20, max_chars = 4000) {
    let s = _clip(_input(text), max_chars, "");
    let min_len = _bounded_int(min_token_len, 2, 2, 32, "min_token_len");
    return _top_counts(_count_tokens(_word_tokens(s), min_len, true),
        _bounded_int(max_terms, 20, 1, 80, "max_terms"));
}

fn summarize_identifier_frequency(text, min_len = 1, max_identifiers = 20, max_chars = 4000, fold_case = false) {
    let s = _clip(_input(text), max_chars, "");
    let minimum = _bounded_int(min_len, 1, 1, 64, "min_len");
    let tokens = _identifier_tokens(s, fold_case); let counts = map{};
    for i len(tokens) { if len(tokens[i]) >= minimum { counts[tokens[i]] = (try counts[tokens[i]] catch 0) + 1; } }
    return _top_counts(counts, _bounded_int(max_identifiers, 20, 1, 120, "max_identifiers"), "identifier");
}

fn compress_strip_tags(text, max_chars = 4000) {
    return _clip(regex_replace_all(_input(text), "<(!|[?]|/|[A-Za-z])[^>]*>", ""), max_chars);
}

fn compress_fenced_code_blocks(text, max_chars = 4000) {
    let lines = _lines(text); let out = []; let inside = false;
    for i len(lines) {
        if str_starts_with(str_trim(lines[i]), "```") {
            if not inside { array_push(out, "[fenced code block omitted]"); }
            inside = not inside;
        } elif not inside { array_push(out, lines[i]); }
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_double_slash_line_comments(text, max_chars = 4000, drop_blank_lines = true) {
    let lines = _lines(text); let out = [];
    for i len(lines) {
        let line = lines[i]; let trimmed = str_trim(line);
        if str_starts_with(trimmed, "//") { line = ""; }
        if not drop_blank_lines or str_trim(line) != "" { array_push(out, line); }
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_redact_urls(text, max_chars = 4000) {
    return _clip(regex_replace_all(_input(text), "https?://[^ \\t\\n\\r]+", "[url]"), max_chars);
}

fn compress_redact_emails(text, max_chars = 4000) {
    return _clip(regex_replace_all(_input(text), "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}", "[email]"), max_chars);
}

fn compress_markdown_frontmatter(text, max_chars = 4000) {
    let s = _input(text); let lines = str_split(s, "\n");
    if len(lines) == 0 or str_trim(lines[0]) != "---" { return _clip(s, max_chars); }
    let close = -1;
    let i = 1;
    while i < len(lines) { if str_trim(lines[i]) == "---" { close = i; i = len(lines); } else { i = i + 1; } }
    if close < 0 { return _clip(s, max_chars); }
    let out = [];
    for j len(lines) { if j > close { array_push(out, lines[j]); } }
    return _clip(_join(out, "\n"), max_chars);
}

fn summarize_duplicate_lines(text, min_occurrences = 2, max_entries = 40, max_chars = 4000) {
    let counts = map{}; let lines = _lines(text);
    for i len(lines) {
        let line = lines[i];
        if str_trim(line) != "" { counts[line] = (try counts[line] catch 0) + 1; }
    }
    let minimum = _bounded_int(min_occurrences, 2, 2, 1000000, "min_occurrences");
    let filtered = map{}; let keys = map_keys(counts);
    for i len(keys) { if counts[keys[i]] >= minimum { filtered[keys[i]] = counts[keys[i]]; } }
    let rows = _top_counts(filtered, _bounded_int(max_entries, 40, 1, 200, "max_entries"), "line");
    let out = []; let used = 0; let m = _max(max_chars);
    for i len(rows) {
        if used + len(rows[i].line) > m { return out; }
        array_push(out, rows[i]); used = used + len(rows[i].line);
    }
    return out;
}

fn summarize_line_histogram(text, max_chars = 4000) {
    let lines = _lines(_clip(_input(text), max_chars, ""));
    let out = map{ empty: 0, short: 0, medium: 0, long: 0 };
    for i len(lines) {
        let n = len(lines[i]);
        if n == 0 { out.empty = out.empty + 1; }
        elif n <= 40 { out.short = out.short + 1; }
        elif n <= 120 { out.medium = out.medium + 1; }
        else { out.long = out.long + 1; }
    }
    return out;
}

fn summarize_line_prefix_groups(text, prefix_len = 12, max_groups = 40, max_chars = 4000) {
    let lines = _lines(_clip(_input(text), max_chars, ""));
    let width = _bounded_int(prefix_len, 12, 1, 96, "prefix_len"); let counts = map{};
    for i len(lines) {
        let end = width; if end > len(lines[i]) { end = len(lines[i]); }
        let prefix = str_slice(lines[i], 0, end);
        counts[prefix] = (try counts[prefix] catch 0) + 1;
    }
    return _top_counts(counts, _bounded_int(max_groups, 40, 1, 200, "max_groups"), "prefix");
}

fn summarize_rank_lines_by_keywords(text, keywords, top_lines = 40, max_chars = 4000) {
    if type(keywords) != "array" or len(keywords) < 1 or len(keywords) > 100 { throw "keywords must contain 1 to 100 values"; }
    let wanted = map{};
    for i len(keywords) {
        let key = str_lower(str(keywords[i]));
        if not regex_match(key, "^[A-Za-z0-9_]+$") { throw "keywords must be whole tokens"; }
        wanted[key] = true;
    }
    let lines = _lines(_clip(_input(text), max_chars, "")); let candidates = [];
    for i len(lines) {
        let words = _word_tokens(lines[i]); let score = 0;
        for j len(words) { if try wanted[words[j]] catch false { score = score + 1; } }
        if score > 0 { array_push(candidates, map{ line: i + 1, score: score, text: lines[i] }); }
    }
    let out = []; let used = map{}; let n = _bounded_int(top_lines, 40, 1, 200, "top_lines");
    for _round n {
        let best = -1; let best_score = -1;
        for i len(candidates) {
            if not (try used[str(i)] catch false) and candidates[i].score > best_score {
                best = i; best_score = candidates[i].score;
            }
        }
        if best < 0 { return out; }
        used[str(best)] = true; array_push(out, candidates[best]);
    }
    return out;
}

fn compress_paragraphs(text, max_paragraphs = 8, max_chars = 4000) {
    let parts = regex_split(_input(text), "\\n[ \\t]*\\n+"); let out = [];
    let n = _bounded_int(max_paragraphs, 8, 1, 200, "max_paragraphs");
    for i len(parts) { if len(out) < n and str_trim(parts[i]) != "" { array_push(out, str_trim(parts[i])); } }
    return _clip(_join(out, "\n\n"), max_chars);
}

fn compress_unique_lines(text, max_lines = 200, max_chars = 4000) {
    let lines = _lines(text); let seen = map{}; let out = [];
    let n = _bounded_int(max_lines, 200, 1, 10000, "max_lines");
    for i len(lines) {
        let key = lines[i];
        if str_trim(key) != "" and not (try seen[key] catch false) and len(out) < n {
            seen[key] = true; array_push(out, key);
        }
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_lines_head(text, head_lines = 80, max_chars = 4000) {
    let lines = _lines(text); let out = [];
    let n = _bounded_int(head_lines, 80, 1, 10000, "head_lines"); let limit = n;
    if limit > len(lines) { limit = len(lines); }
    for i limit { array_push(out, lines[i]); }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_lines_tail(text, tail_lines = 80, max_chars = 4000) {
    let lines = _lines(text); let out = [];
    let n = _bounded_int(tail_lines, 80, 1, 10000, "tail_lines"); let start = len(lines) - n;
    if start < 0 { start = 0; }
    let i = start; while i < len(lines) { array_push(out, lines[i]); i = i + 1; }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_collapse_blank_lines(text, max_chars = 4000) {
    let lines = _lines(text); let out = []; let blank = false;
    for i len(lines) {
        let next_blank = str_trim(lines[i]) == "";
        if not next_blank { array_push(out, lines[i]); }
        elif not blank { array_push(out, ""); }
        blank = next_blank;
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_truncate_middle(text, max_chars = 3000, margin_chars = 1200) {
    let s = _input(text); let m = _max(max_chars, 3000);
    let margin = _bounded_int(margin_chars, 1200, 0, m, "margin_chars");
    if len(s) <= m { return s; }
    let marker = "...";
    if m <= len(marker) or margin * 2 + len(marker) > m { return _clip(s, m); }
    return str_slice(s, 0, margin) + marker + str_slice(s, len(s) - margin, len(s));
}

fn compress_dedent(text, max_chars = 4000) {
    let lines = _lines(text); let minimum = 0; let found = false;
    for i len(lines) {
        if str_trim(lines[i]) != "" {
            let count = 0;
            while count < len(lines[i]) {
                let ch = str_slice(lines[i], count, count + 1);
                if ch == " " or ch == "\t" { count = count + 1; } else { break; }
            }
            if not found or count < minimum { minimum = count; found = true; }
        }
    }
    let out = [];
    for i len(lines) {
        let start = minimum; if start > len(lines[i]) { start = len(lines[i]); }
        array_push(out, str_slice(lines[i], start, len(lines[i])));
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn compress_sentences(text, max_sentences = 6, max_chars = 4000) {
    let records = _sentence_records(text); let out = [];
    let n = _bounded_int(max_sentences, 6, 1, 200, "max_sentences"); let limit = n;
    if limit > len(records) { limit = len(records); }
    for i limit { array_push(out, records[i].text); }
    return _clip(_join(out, " "), max_chars);
}

fn summarize_bullets(text, max_items = 20, max_chars = 4000) {
    let lines = _lines(text); let out = []; let used = 0; let m = _max(max_chars);
    let n = _bounded_int(max_items, 20, 1, 200, "max_items");
    for i len(lines) {
        let line = str_trim(lines[i]);
        let bullet = str_starts_with(line, "- ") or str_starts_with(line, "* ") or
            str_starts_with(line, "+ ") or regex_match(line, "^[0-9]+[.)][ \\t]+.+$");
        if bullet and len(out) < n and used + len(line) <= m { array_push(out, line); used = used + len(line); }
    }
    return out;
}

fn summarize_headings(text, max_headings = 40, max_chars = 4000) {
    let lines = _lines(text); let out = []; let used = 0; let m = _max(max_chars);
    let n = _bounded_int(max_headings, 40, 1, 200, "max_headings");
    for i len(lines) {
        let heading = _heading(lines[i]);
        if heading != nil and len(out) < n and used + len(heading.title) <= m {
            array_push(out, map{ line: i + 1, level: heading.level, heading: heading.title });
            used = used + len(heading.title);
        }
    }
    return out;
}

fn summarize_markdown_toc(text, max_entries = 40, max_chars = 4000) {
    let headings = summarize_headings(text, max_entries, max_chars); let out = [];
    for i len(headings) {
        let indent = "";
        for _j headings[i].level - 1 { indent = indent + "  "; }
        array_push(out, indent + "- " + headings[i].heading);
    }
    return _clip(_join(out, "\n"), max_chars);
}

fn _json_shape(value, depth, max_depth, max_keys) {
    let kind = type(value);
    if depth >= max_depth { return kind; }
    if kind == "map" {
        let out = map{}; let keys = array_sort(map_keys(value)); let limit = max_keys;
        if limit > len(keys) { limit = len(keys); }
        for i limit { out[keys[i]] = _json_shape(value[keys[i]], depth + 1, max_depth, max_keys); }
        if len(keys) > limit {
            // The marker must not replace a real key, including an omitted key.
            let marker = "...";
            while map_has(value, marker) { marker = marker + "."; }
            out[marker] = str(len(keys) - limit) + " more keys";
        }
        return out;
    }
    if kind == "array" { return map{ type: "array", length: len(value), items: if len(value) == 0 { nil } else { _json_shape(value[0], depth + 1, max_depth, max_keys) } }; }
    return kind;
}

fn summarize_json_structure(text, max_depth = 4, max_keys_per_level = 40, max_lines = 200, max_chars = 4000) {
    let raw = _input(text);
    if not JSON.is_valid(raw) { return map{ ok: false, error: "invalid JSON" }; }
    let value = JSON.parse(raw);
    return map{ ok: true, root_type: type(value), max_lines: _bounded_int(max_lines, 200, 1, 2000, "max_lines"),
        max_chars: _max(max_chars), shape: _json_shape(value, 0,
            _bounded_int(max_depth, 4, 0, 32, "max_depth"),
            _bounded_int(max_keys_per_level, 40, 1, 200, "max_keys_per_level")) };
}

fn _delimiter(value) {
    if value == "comma" or value == "," { return ","; }
    if value == "tab" or value == "\t" { return "\t"; }
    if value == "pipe" or value == "|" { return "|"; }
    if value == "semicolon" or value == ";" { return ";"; }
    throw "delimiter must be comma, tab, pipe, or semicolon";
}

fn summarize_delimited_header(text, delimiter = "comma", max_columns = 200, max_chars = 4000) {
    let lines = _lines(text); let first = if len(lines) == 0 { "" } else { lines[0] };
    let columns = str_split(first, _delimiter(delimiter)); let out = []; let used = 0; let m = _max(max_chars);
    let n = _bounded_int(max_columns, 200, 1, 1000, "max_columns");
    for i len(columns) {
        let column = str_trim(columns[i]);
        if len(out) < n and used + len(column) <= m { array_push(out, column); used = used + len(column); }
    }
    return out;
}

fn text_levenshtein_distance(a, b, max_len_each = 1000) {
    let max_len = _bounded_int(max_len_each, 1000, 1, 2500, "max_len_each");
    a = _input(a); b = _input(b);
    if len(a) > max_len { a = str_slice(a, 0, max_len); }
    if len(b) > max_len { b = str_slice(b, 0, max_len); }
    let previous = []; for j len(b) + 1 { previous[j] = j; }
    for i len(a) {
        let current = [i + 1];
        for j len(b) {
            let cost = if str_slice(a, i, i + 1) == str_slice(b, j, j + 1) { 0 } else { 1 };
            let best = previous[j + 1] + 1;
            if current[j] + 1 < best { best = current[j] + 1; }
            if previous[j] + cost < best { best = previous[j] + cost; }
            current[j + 1] = best;
        }
        previous = current;
    }
    return previous[len(b)];
}

fn text_token_jaccard(text_a, text_b, fold_case = true, max_chars_each = 500000, max_tokens_scanned_per_text = 200000) {
    let cap = _bounded_int(max_chars_each, 500000, 256, 500000, "max_chars_each");
    let token_cap = _bounded_int(max_tokens_scanned_per_text, 200000, 50, 200000, "max_tokens_scanned_per_text");
    let a = _input(text_a); let b = _input(text_b);
    if len(a) > cap { a = str_slice(a, 0, cap); }
    if len(b) > cap { b = str_slice(b, 0, cap); }
    let wa = _word_tokens(a, fold_case, token_cap); let wb = _word_tokens(b, fold_case, token_cap);
    let set_a = map{}; let union = map{};
    for i len(wa) { set_a[wa[i]] = true; union[wa[i]] = true; }
    for i len(wb) { union[wb[i]] = true; }
    let intersection = 0; let b_unique = map{};
    for i len(wb) {
        if not (try b_unique[wb[i]] catch false) {
            b_unique[wb[i]] = true;
            if try set_a[wb[i]] catch false { intersection = intersection + 1; }
        }
    }
    let union_count = len(map_keys(union));
    return if union_count == 0 { 1.0 } else { intersection / union_count };
}

fn text_longest_common_substring(a, b, max_len_each = 400) {
    let cap = _bounded_int(max_len_each, 400, 32, 4000, "max_len_each");
    a = _input(a); b = _input(b);
    if len(a) > cap { a = str_slice(a, 0, cap); }
    if len(b) > cap { b = str_slice(b, 0, cap); }
    let previous = []; let best_len = 0; let best_end = 0;
    for i len(a) {
        let current = [];
        for j len(b) {
            if str_slice(a, i, i + 1) == str_slice(b, j, j + 1) {
                current[j] = (if j == 0 { 0 } else { try previous[j - 1] catch 0 }) + 1;
                if current[j] > best_len { best_len = current[j]; best_end = i + 1; }
            } else { current[j] = 0; }
        }
        previous = current;
    }
    return map{ length: best_len, text: str_slice(a, best_end - best_len, best_end) };
}

fn text_djb2_hash(text) {
    let bytes = str_to_bytes(_input(text)); let hash = 5381;
    for i len(bytes) { hash = bit_and(hash * 33 + bytes[i], 4294967295); }
    return str(hash);
}

fn summarize_first_lines(text, line_count = 20, max_chars = 4000) {
    let lines = _lines(text); let out = [];
    let n = _bounded_int(line_count, 20, 1, 10000, "line_count");
    for i len(lines) { if len(out) < n and str_trim(lines[i]) != "" { array_push(out, lines[i]); } }
    return _clip(_join(out, "\n"), max_chars);
}

fn summarize_text(text, max_chars = 1200, max_sentences = 6) {
    let sentences = _sentence_records(text);
    let all_counts = map{};
    for i len(sentences) {
        let words = _word_tokens(sentences[i].text);
        for j len(words) { all_counts[words[j]] = (try all_counts[words[j]] catch 0) + 1; }
    }
    let candidates = [];
    for i len(sentences) {
        let words = _word_tokens(sentences[i].text); let unique = map{}; let score = 0;
        for j len(words) {
            if not (try unique[words[j]] catch false) { unique[words[j]] = true; score = score + (try all_counts[words[j]] catch 0); }
        }
        array_push(candidates, map{ index: i, score: score, text: sentences[i].text });
    }
    let selected = []; let used = map{};
    let n = _bounded_int(max_sentences, 6, 1, 200, "max_sentences");
    for _round n {
        let best = -1; let best_score = -1;
        for i len(candidates) {
            if not (try used[str(i)] catch false) and candidates[i].score > best_score {
                best = i; best_score = candidates[i].score;
            }
        }
        if best < 0 { break; }
        used[str(best)] = true; array_push(selected, candidates[best].text);
    }
    return _clip(_join(selected, " "), max_chars);
}

fn summarize_segments(segments, max_chars = 1200, max_sentences = 6) {
    if type(segments) != "array" or len(segments) < 1 or len(segments) > 24 { throw "segments must contain 1 to 24 strings"; }
    let merged = [];
    for i len(segments) { array_push(merged, _input(segments[i])); }
    let combined = _join(merged, "\n\n---\n\n");
    if len(combined) > 200000 { throw "combined segments exceed 200000 characters"; }
    return summarize_text(combined, max_chars, max_sentences);
}

