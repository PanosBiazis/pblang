fn catalog_entries() {
    let names = implemented_tools();
    let out = [];
    for i len(names) {
        out[len(out)] = map{
            name: names[i],
            category: "graph_jacobi_omni_v28",
            profile: "core-code",
            read_only: true,
            destructive: false,
            open_world: false,
            source: "src/graph_jacobi_760_tools.sapp",
