    }
    return out;
}

fn can_handle(tool) {
    let names = implemented_tools();
    for i len(names) {
        if names[i] == tool { return true; }
    }
    return false;
}

fn handle(tool, req) {
    let m = _v28();
    if m != nil {
        if tool == "mcp_graph_jacobi_medusa_760toks_speculative_reasoner" or tool == "mcp_lyapunov_brent_floyd_zero_loop_guard_v28" or tool == "mcp_monotonic_pareto_self_correction_v28" {
