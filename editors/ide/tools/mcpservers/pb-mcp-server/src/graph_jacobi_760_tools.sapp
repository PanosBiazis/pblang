        if tool == "mcp_frontier_2026_gemini4_gpt61_claude55_v28_eval" or tool == "mcp_frontier_2026_gpt6_fable51_grok47_oss_v28_eval" {
            let r6 = m.evaluate_frontier_2026_head_to_head_v28_matrix(req);
            r6.tool = tool;
            return r6;
