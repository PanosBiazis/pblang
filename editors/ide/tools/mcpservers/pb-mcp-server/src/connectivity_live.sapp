// Read-only Linux snapshots through fixed supervised commands; no radio changes.
let SEC=import("security.sapp");
let PROCESS=import("stdlib:linux_process.sapp");
let ACCESS=import("app_access.sapp");
fn _strict(args){if type(args)!="map" or len(map_keys(args))!=0{throw "connectivity: no arguments accepted";}}
fn _run(paths,argv){
    if platform()!="linux" or not PROCESS.status().available{return map{ok:false,error:"bounded Linux backend unavailable"};}
    let result=try PROCESS.run_fixed(paths,argv,map{timeout_secs:5,startup_timeout_ms:2000,
        max_output_bytes:32768,max_memory_bytes:134217728,inherit_environment:false,
        environment:map{LC_ALL:"C"}}) catch nil;
    if result==nil or not result.ok or not result.command_ok or result.output_truncated{
        return map{ok:false,error:"bounded local snapshot unavailable"};
    }
    return map{ok:true,text:result.stdout};
}
fn _text(value){if type(value)!="string" or len(value)>32768{throw "connectivity: oversized snapshot";}}
fn parse_usb(text){
    _text(text);let out=[];
    for line in str_split(text,"\n"){
        if str_trim(line)==""{continue;}
        let start=str_index_of(line," ID ");
        if start<0 or start+14>len(line){throw "connectivity: invalid USB snapshot";}
        let id=str_lower(str_slice(line,start+4,start+13));
        if not regex_match(id,"^[0-9a-f]{4}:[0-9a-f]{4}$"){throw "connectivity: invalid USB identifier";}
        if len(out)>=256{throw "connectivity: USB count exceeded";}
        // Device-supplied product strings and serials are deliberately excluded.
        out[len(out)]=map{vendor_id:str_slice(id,0,4),product_id:str_slice(id,5,9)};
    }
    return map{devices:out,count:len(out),serials_included:false,product_strings_included:false,board_identity_verified:false};
}
fn parse_radio(text){
    _text(text);let fields=map{};
    for line in str_split(text,"\n"){
        if str_trim(line)==""{continue;}
        let colon=str_index_of(line,":");if colon<1{throw "connectivity: invalid radio snapshot";}
        let key=str_lower(str_trim(str_slice(line,0,colon)));let value=str_trim(str_slice(line,colon+1,len(line)));
        if key!="wifi-hw" and key!="wifi" and key!="wwan-hw" and key!="wwan"{throw "connectivity: unexpected radio field";}
        if map_has(fields,key) or (value!="enabled" and value!="disabled" and value!="unknown"){throw "connectivity: invalid radio state";}
        fields[key]=value;
    }
    if not map_has(fields,"wifi"){throw "connectivity: incomplete radio snapshot";}
    return fields;
}
fn parse_hotspot(text){
    _text(text);let rows=[];let kind="";
    for line in str_split(text,"\n"){
        let colon=str_index_of(line,":");if colon<1{continue;}
        let key=str_trim(str_slice(line,0,colon));let value=str_trim(str_slice(line,colon+1,len(line)));
        if key=="GENERAL.TYPE"{kind=value;}
        if key=="WIFI-PROPERTIES.AP"{
            if value!="yes" and value!="no"{throw "connectivity: invalid AP capability";}
            if kind!="wifi"{throw "connectivity: unexpected AP capability";}
            if len(rows)>=64{throw "connectivity: radio count exceeded";}
            rows[len(rows)]=map{adapter_index:len(rows),ap_supported:value=="yes"};
        }
    }
    return map{adapters:rows,count:len(rows),hotspot_started:false,active_hotspot_state:"not-inspected"};
}
fn call_live(tool,args){
    if tool!="device_usb_inventory" and tool!="net_radio_status" and tool!="net_hotspot_capabilities"{return nil;}
    _strict(args);if not ACCESS.allowed(tool,args){throw "application access denied";}
    SEC.require_trusted("read local connectivity snapshot","PB_CONNECTIVITY_INVENTORY_ENABLE");
    let raw=map{};let out=map{};
    if tool=="device_usb_inventory"{
        raw=_run(["/usr/bin/lsusb","/bin/lsusb"],[]);
        if not raw.ok{return raw;}out=parse_usb(raw.text);
    }
    if tool=="net_radio_status"{
        raw=_run(["/usr/bin/nmcli"],["-m","multiline","--escape","yes","radio","all"]);
        if not raw.ok{return raw;}out=map{radios:parse_radio(raw.text)};
    }
    if tool=="net_hotspot_capabilities"{
        raw=_run(["/usr/bin/nmcli"],["-m","multiline","--escape","yes","-f","GENERAL.TYPE,WIFI-PROPERTIES.AP","device","show"]);
        if not raw.ok{return raw;}out=parse_hotspot(raw.text);
    }
    out.ok=true;out.tool=tool;out.snapshot_only=true;out.active_scan=false;out.network_changed=false;
    out.shell_used=false;out.credentials_included=false;out.instructions_from_data=false;return out;
}
fn implemented_tools(){return ["device_usb_inventory","net_radio_status","net_hotspot_capabilities"];}
fn catalog_entries(){
    let names=implemented_tools();let descriptions=[
        "Read local USB vendor/product IDs through a bounded Linux lsusb snapshot. Excludes serial/product strings. Requires local connectivity inventory grant; no ports opened or firmware reset.",
        "Read NetworkManager Wi-Fi/WWAN hardware/software radio enable state. No SSIDs, addresses, passwords, active scanning or connection changes. Requires local connectivity inventory grant.",
        "Read NetworkManager Wi-Fi AP support per anonymous adapter index. Does not report an active hotspot or create one. Requires local connectivity inventory grant."];
    let out=[];for i len(names){out[len(out)]=map{name:names[i],category:"connectivity",profile:"local-power",read_only:true,destructive:false,open_world:false,source:"src/connectivity_live.sapp",description:descriptions[i],input_schema:map{type:"object",properties:map{},required:[],additionalProperties:false}};}return out;
}
fn functional_records(){let out=[];let entries=catalog_entries();for i len(entries){out[len(out)]=map{name:entries[i].name,status:"blocked",public_mcp:false,input_schema:entries[i].input_schema,reason:"requires verified bounded process FFI contract; currently unavailable, parsers tested independently",evidence_ids:["pb_mcp_connectivity_live:parsers","pb_mcp_connectivity_live:default-deny"]};}return out;}
export call_live,implemented_tools,catalog_entries,functional_records,parse_usb,parse_radio,parse_hotspot;
