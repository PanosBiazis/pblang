// Pure local n8n contract. HTTP and account grants live in the owned boundary.
fn _id(v) {
    if type(v)!="string" or len(v)<1 or len(v)>128 { throw "invalid n8n identifier"; }
    for c in str_to_bytes(v) {
        if not ((c>=48 and c<=57) or (c>=65 and c<=90) or (c>=97 and c<=122) or c==45 or c==95) { throw "invalid n8n identifier"; }
    }
    return v;
}
fn _schema(props, needed) { return map{type:"object",properties:props,required:needed,additionalProperties:false}; }
fn catalog_entries() {
    let entries=[];
    let id=map{type:"string",minLength:1,maxLength:128,pattern:"^[A-Za-z0-9_-]+$"};
    let confirm=map{type:"boolean",enum:[true]};
    let page=_schema(map{cursor:map{type:"string",maxLength:1024}},[]);
    let definitions=[
        ["n8n_health","Check local n8n health on the fixed loopback endpoint.",_schema(map{},[]),true],
        ["n8n_workflows","Read one page of allowed workflow metadata; pass next_cursor unchanged.",page,true],
        ["n8n_workflow","Read allowed workflow metadata and node types, without parameters or credentials.",_schema(map{id:id},["id"]),true],
        ["n8n_workflow_create","Create an inactive workflow from reviewed JSON. Requires a local create grant; no automatic activation.",_schema(map{workflow:map{type:"object"},confirm:confirm},["workflow","confirm"]),false],
        ["n8n_workflow_update","Update an allowed inactive workflow. Requires reviewed JSON, observed updatedAt and explicit local write grant.",_schema(map{id:id,workflow:map{type:"object"},expected_updated_at:map{type:"string",maxLength:64},confirm:confirm},["id","workflow","expected_updated_at","confirm"]),false],
        ["n8n_workflow_activate","Activate an allowed workflow; schedules and external effects can start immediately.",_schema(map{id:id,confirm:confirm},["id","confirm"]),false],
        ["n8n_workflow_deactivate","Deactivate an allowed workflow; already running executions may continue.",_schema(map{id:id,confirm:confirm},["id","confirm"]),false],
        ["n8n_executions","Read one page of execution metadata belonging to allowed workflows; no execution data.",page,true],
        ["n8n_execution","Read execution metadata after checking its workflow grant; no execution data.",_schema(map{id:id},["id"]),true],
        ["n8n_execution_stop","Stop an execution after checking its workflow grant. Earlier external effects are not undone.",_schema(map{id:id,confirm:confirm},["id","confirm"]),false],
        ["n8n_webhook_run","POST JSON to a local operator-granted webhook alias. Can cause external effects; no automatic retry.",_schema(map{alias:id,payload:map{type:"object"},confirm:confirm},["alias","payload","confirm"]),false],
        ["n8n_runtime_status","Read state and resource limits of the locally configured n8n container. Requires existing Docker access.",_schema(map{},[]),true],
        ["n8n_runtime_start","Start the configured n8n container. Published schedules may execute. Never uses sudo.",_schema(map{confirm:confirm},["confirm"]),false],
        ["n8n_runtime_stop","Stop the configured n8n container. Workflows are interrupted; never uses sudo.",_schema(map{confirm:confirm},["confirm"]),false]
    ];
    for d in definitions { array_push(entries,map{name:d[0],description:d[1],input_schema:d[2],read_only:d[3],open_world:true}); }
    return entries;
}
fn validate(name,args) {
    if type(args)!="map" { throw "n8n arguments object required"; }
    let entry=nil;
    for e in catalog_entries() { if e.name==name { entry=e; } }
    if entry==nil { throw "unsupported n8n operation"; }
    for key in map_keys(args) { if not map_has(entry.input_schema.properties,key) { throw "unexpected n8n argument"; } }
    for key in entry.input_schema.required { if not map_has(args,key) { throw "missing n8n argument"; } }
    if not entry.read_only and (try args.confirm catch nil)!=true { throw "explicit confirmation required"; }
    if map_has(args,"id") { _id(args.id); }
    if map_has(args,"alias") { _id(args.alias); }
    if map_has(args,"cursor") {
        if type(args.cursor)!="string" or len(args.cursor)>1024 { throw "invalid cursor"; }
        for c in str_to_bytes(args.cursor) { if c<33 or c>126 { throw "invalid cursor"; } }
    }
    if map_has(args,"expected_updated_at") {
        if type(args.expected_updated_at)!="string" or len(args.expected_updated_at)<1 or len(args.expected_updated_at)>64 { throw "invalid revision"; }
    }
    for key in ["workflow","payload"] {
        if map_has(args,key) {
            if type(args[key])!="map" or len(str_to_bytes(json_stringify(args[key])))>262144 { throw "n8n payload bound"; }
        }
    }
    return map{operation:name,arguments:args};
}
fn call(name,args,exchange) {
    let result=exchange(validate(name,args));
    if type(result)!="map" or (try result.ok catch false)!=true or
       (try result.operation catch nil)!=name or (try result.format catch nil)!="pb_mcp.n8n.v1" {
        throw "n8n operation unavailable or refused";
    }
    return result;
}
export validate,call,catalog_entries;
