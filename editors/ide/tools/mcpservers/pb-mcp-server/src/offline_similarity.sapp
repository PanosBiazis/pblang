// Bounded offline adapter; the full server shares the unchanged text computation.
let TEXT=import("text_compute.sapp");
fn _integer(value,low,high) {
    if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value) {throw "invalid similarity bound";}
}
fn call_similarity(name,args) {
    if name!="text_token_jaccard" {return nil;}
    if type(args)!="map" or not map_has(args,"text_a") or not map_has(args,"text_b") {throw "invalid similarity arguments";}
    for key in map_keys(args) {
        if key!="text_a" and key!="text_b" and key!="fold_case" and key!="max_chars_each" and key!="max_tokens_scanned_per_text" {throw "invalid similarity arguments";}
    }
    for value in [args.text_a,args.text_b] {
        if type(value)!="string" or len(value)>16384 or len(str_to_bytes(value))>16384 {throw "similarity text limit";}
    }
    let fold=if map_has(args,"fold_case") {args.fold_case} else {true};
    if type(fold)!="bool" {throw "invalid case option";}
    let chars=if map_has(args,"max_chars_each") {args.max_chars_each} else {16384};
    let tokens=if map_has(args,"max_tokens_scanned_per_text") {args.max_tokens_scanned_per_text} else {8192};
    _integer(chars,256,16384);_integer(tokens,50,8192);
    // Presence refers to the same clipped prefixes as the shared numeric computation.
    // Positive token limits cannot turn a nonempty token sequence into an empty set.
    let a_present=len(regex_find_all(str_slice(args.text_a,0,chars),"[A-Za-z0-9_]+"))>0;
    let b_present=len(regex_find_all(str_slice(args.text_b,0,chars),"[A-Za-z0-9_]+"))>0;
    return map{value:TEXT.text_token_jaccard(args.text_a,args.text_b,fold,chars,tokens),
        token_coverage:"ascii_only",ascii_tokens_present_a:a_present,ascii_tokens_present_b:b_present,
        both_token_sets_empty:not a_present and not b_present,
        semantic_similarity:false,source_identity_verified:false};
}
fn catalog_entries() {
    let text=map{type:"string",maxLength:16384,description:"At most16384 UTF-8 bytes; empty text allowed. Unicode non-ASCII letters do not become tokens."};
    return [map{name:"text_token_jaccard",category:"offline-text",profile:"core-code",read_only:true,destructive:false,open_world:false,
        source:"src/text_compute.sapp",description:"Compute set Jaccard overlap of ASCII [A-Za-z0-9_]+ tokens in two supplied texts. Ignore token order and repetitions; fold_case defaults true. Clip each Unicode-scalar prefix before tokenization, then retain the first token occurrences before deduplication. Both empty token sets return1, even for different non-ASCII-only texts; one empty set returns0. NOT semantic similarity, factual agreement, confidence or evidence of identical source. Each text at most16384 UTF-8 bytes; Returns numeric value and machine-readable ASCII token presence/empty-set flags, never source text/tokens. No model, file, network, persistence or permission grant.",
        input_schema:map{type:"object",required:["text_a","text_b"],additionalProperties:false,properties:map{
            text_a:text,text_b:text,fold_case:map{type:"boolean",default:true},
            max_chars_each:map{type:"integer",minimum:256,maximum:16384,default:16384},
            max_tokens_scanned_per_text:map{type:"integer",minimum:50,maximum:8192,default:8192}}}}];
}
export call_similarity,catalog_entries;
