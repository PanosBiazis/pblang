    }
    fn select(pid,path) {
        if s.closed or s.bound or not integer(pid,1,2147483647) or type(path)!="array" or len(path)<1 or len(path)>16 { return false; }
        for index in path { if not integer(index,0,255) { return false; } }
        let root=own(native.root());let count=native.count(root);
        if not integer(count,0,64) { return false; }
        for i count {
            let app=own(native.child(root,i));let found=native.pid(app);
            if not integer(found,1,2147483647) { return false; }
            if found==pid {
                if s.app!=0 { return false; }
                s.app=app;
            } else { release_last(); }
        }
        if s.app==0 { return false; }
        s.pid=pid;let current=s.app;array_push(s.watched,s.app);
