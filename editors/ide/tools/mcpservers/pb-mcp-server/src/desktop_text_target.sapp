}
fn open_native() {
    if platform()!="linux" { throw "text accessibility backend unavailable"; }
    if not valid_bus_address(env_get("AT_SPI_BUS_ADDRESS")) { throw "one explicit local accessibility bus required"; }
    if native_lifetime.attempted { throw "text backend requires a fresh worker"; }
    native_lifetime.attempted=true;
