    }
    fn status() {
        if s.bound and (try valid_target() catch false)!=true { close(); }
        return map{bound:s.bound,closed:s.closed,cleanup_confirmed:s.closed and s.cleanup_ok,scope:"selected-editable-text",capture_restricted:false,
            pointer_supported:false,password_detection_guaranteed:false,lifetime_event_latching:true,
