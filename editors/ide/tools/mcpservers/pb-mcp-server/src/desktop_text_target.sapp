    for c in str_to_bytes(path) {
        if not ((c>=65 and c<=90) or (c>=97 and c<=122) or (c>=48 and c<=57) or c==47 or c==95 or c==45 or c==46) { return false; }
    }
    if len(fields)==2 {
        if len(fields[1])!=37 or not str_starts_with(fields[1],"guid=") { return false; }
        for c in str_to_bytes(str_slice(fields[1],5,37)) {
            if not ((c>=48 and c<=57) or (c>=97 and c<=102)) { return false; }
        }
    }
    return true;
}
fn new(native) {
    let s=map{ closed:false,bound:false,cleanup_ok:true,pid:0,app:0,target:0,refs:[],chain:[],path:[],watched:[] };
