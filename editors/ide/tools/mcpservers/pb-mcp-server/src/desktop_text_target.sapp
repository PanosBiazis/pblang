            array_push(s.chain,current);array_push(s.path,index);
            array_push(s.watched,current);
        }
        s.target=current;if not valid_target() { return false; }
        s.bound=true;return true;
    }
    fn bind(pid,path) {
        if s.closed or s.bound { return false; }
