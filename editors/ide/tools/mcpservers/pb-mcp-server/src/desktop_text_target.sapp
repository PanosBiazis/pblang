let native_lifetime=map{attempted:false,library:nil};
fn integer(v,low,high) { return type(v)=="number" and v>=low and v<=high and v==num_floor(v); }
fn valid_bus_address(value) {
    if type(value)!="string" or len(value)<12 or len(value)>4096 or not str_starts_with(value,"unix:path=/") { return false; }
