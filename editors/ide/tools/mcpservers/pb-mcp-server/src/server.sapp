// HTTP API for the pblang pb-mcp-server port.

let http = import("stdlib:http_server.sapp");
let JSON = import("stdlib:json.sapp");
let catalog = import("src/catalog.sapp");
let router = import("src/router.sapp");

fn _json(status, value) {
    return map{
        status: status,
        json: value,
        headers: map{
            "Cache-Control": "no-store",
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "Content-Type",
            "Access-Control-Allow-Methods": "GET,POST,OPTIONS"
        }
    };
}

fn _request_json(req) {
    let body = try req.body catch "";
    if str_trim(body) == "" { return map{}; }
    return try JSON.parse(body) catch map{};
}

fn _path_only(p) {
    return str_split(p, "?")[0];
}

fn handler(req) {
    let method = try req.method catch "GET";
    let path = _path_only(try req.path catch "/");

    if method == "OPTIONS" { return _json(200, map{ ok: true }); }
    if path == "/" {
        return _json(200, map{
            name: "pb-mcp-server-pblang",
            endpoints: ["/health", "/tools", "/tools/search?q=...", "/call"],
            status: catalog.status(),
        });
    }
    if path == "/health" {
        return _json(200, map{ ok: true, status: catalog.status() });
    }
    if path == "/tools" {
        return _json(200, map{ ok: true, tools: catalog.tool_catalog() });
    }
    if path == "/tools/implemented" {
        return _json(200, map{ ok: true, tools: catalog.implemented_catalog() });
    }
    if path == "/tools/search" {
        let q = try req.query.q catch "";
        return _json(200, map{ ok: true, query: q, tools: catalog.search_tools(q) });
    }
    if path == "/call" {
        if method != "POST" { return _json(405, map{ ok: false, error: "POST required" }); }
        let body = _request_json(req);
        let tool = try body.tool catch "";
        let args = try body.args catch map{};
        return _json(200, router.call(tool, args));
    }
    return _json(404, map{ ok: false, error: "not found" });
}

fn serve(addr) {
    print "pb-mcp-server pblang API: http://" + addr + "/";
    http.serve_forever(addr, handler);
}

export handler, serve;
