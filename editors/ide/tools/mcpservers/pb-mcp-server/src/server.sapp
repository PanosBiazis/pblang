// HTTP API for the pblang pb-mcp-server port.

let http = import("stdlib:http_server.sapp");
let JSON = import("stdlib:json.sapp");
let catalog = import("src/catalog.sapp");
let router = import("src/router.sapp");

fn _configured_origin_allowed(origin) {
    let raw = try env_get("PB_MCP_ALLOWED_ORIGINS") catch "";
    let parts = str_split(str(raw ?? ""), ",");
    let i = 0;
    while i < len(parts) {
        if str_trim(parts[i]) == origin { return true; }
        i = i + 1;
    }
    return false;
}

fn _origin_allowed(origin) {
    if origin == nil or origin == "" { return true; }
    let o = str(origin);
    if o == "null" { return true; }
    if str_starts_with(o, "http://127.0.0.1:") or str_starts_with(o, "http://localhost:") or str_starts_with(o, "http://[::1]:") { return true; }
    if str_starts_with(o, "https://127.0.0.1:") or str_starts_with(o, "https://localhost:") or str_starts_with(o, "https://[::1]:") { return true; }
    return _configured_origin_allowed(o);
}

fn _cors_headers(req = nil) {
    let origin = http.req_header(req, "Origin");
    let h = map{
        "Cache-Control": "no-store",
        "Access-Control-Allow-Headers": "Content-Type",
        "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
        "Vary": "Origin"
    };
    if origin != nil and origin != "" and _origin_allowed(origin) {
        h["Access-Control-Allow-Origin"] = str(origin);
    }
    return h;
}

fn _json(status, value, req = nil) {
    return map{
        status: status,
        json: value,
        headers: _cors_headers(req)
    };
}

fn _request_json(req) {
    let body = try req.body catch "";
    if str_trim(body) == "" { return map{}; }
    return try JSON.parse(body) catch map{};
}

fn _path_only(p) {
    return str_split(p, "?")[0];
}

fn handler(req) {
    let method = try req.method catch "GET";
    let path = _path_only(try req.path catch "/");
    let origin = http.req_header(req, "Origin");
    if origin != nil and origin != "" and not _origin_allowed(origin) {
        return _json(403, map{ ok: false, error: "origin not allowed" }, nil);
    }

    if method == "OPTIONS" { return _json(200, map{ ok: true }, req); }
    if path == "/" {
        return _json(200, map{
            name: "pb-mcp-server-pblang",
            endpoints: ["/health", "/tools", "/tools/search?q=...", "/call"],
            status: catalog.status(),
        }, req);
    }
    if path == "/health" {
        return _json(200, map{ ok: true, status: catalog.status() }, req);
    }
    if path == "/tools" {
        return _json(200, map{ ok: true, tools: catalog.tool_catalog() }, req);
    }
    if path == "/tools/implemented" {
        return _json(200, map{ ok: true, tools: catalog.implemented_catalog() }, req);
    }
    if path == "/tools/search" {
        let q = try req.query.q catch "";
        return _json(200, map{ ok: true, query: q, tools: catalog.search_tools(q) }, req);
    }
    if path == "/call" {
        if method != "POST" { return _json(405, map{ ok: false, error: "POST required" }, req); }
        let body = _request_json(req);
        let tool = try body.tool catch "";
        let args = try body.args catch map{};
        return _json(200, router.call(tool, args), req);
    }
    return _json(404, map{ ok: false, error: "not found" }, req);
}

fn serve(addr) {
    throw "embedded pb-mcp-server HTTP is disabled: run the canonical products/pb-mcp-server service with its identity and admission layer";
}

export handler, serve;
