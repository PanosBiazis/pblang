// Read-only local context. Metadata describes a sample, never an input grant.
fn integer(value, low, high) {
    if type(value) != "number" or not (value >= low and value <= high) or value != num_floor(value) { throw "invalid desktop geometry"; }
    return value;
}
fn normalize(raw, observed_at) {
    if type(raw) != "map" { throw "invalid desktop context"; }
    let width = integer(raw.root_width, 1, 32768); let height = integer(raw.root_height, 1, 32768);
    if raw.monitor_source != "randr" and raw.monitor_source != "root" { throw "unknown monitor source"; }
    if type(raw.monitors) != "array" or len(raw.monitors) < 1 or len(raw.monitors) > 16 { throw "invalid monitor count"; }
    let monitors = []; let seen = map{};
    for m in raw.monitors {
        let id = integer(m.id, 0, 4294967295); let key = str(id);
        if map_has(seen, key) or type(m.primary) != "bool" { throw "invalid monitor identity"; }
        seen[key] = true;
        array_push(monitors, map{ id: id, x: integer(m.x, -32768, 32767), y: integer(m.y, -32768, 32767),
            width: integer(m.width, 1, 32768), height: integer(m.height, 1, 32768), primary: m.primary });
    }
    if raw.monitor_source == "root" and (len(monitors) != 1 or monitors[0].id != 0
        or monitors[0].x != 0 or monitors[0].y != 0 or monitors[0].width != width or monitors[0].height != height) { throw "invalid virtual root monitor"; }
    let hex = raw.application_hex;
    if type(hex) != "string" or len(hex) > 160 or len(hex) % 2 != 0 { throw "invalid application label"; }
    let label = ""; let supported = true; let i = 0;
    while i < len(hex) {
        let a = str_index_of("0123456789abcdef", str_slice(hex, i, i + 1));
        let b = str_index_of("0123456789abcdef", str_slice(hex, i + 1, i + 2));
        if a < 0 or b < 0 { throw "invalid application bytes"; }
        let c = a * 16 + b;
        if c < 32 or c > 126 { supported = false; } else { label = label + strfromcharcode(c); }
        i = i + 2;
    }
    if not supported { label = "Unsupported application label"; }
    if label == "" { label = "Unknown application"; }
    return map{ available: true, format: "pb_mcp.desktop-context.v1", observed_at_ms: integer(observed_at, 0, 9007199254740991),
        root_width: width, root_height: height, monitor_source: raw.monitor_source, monitors: monitors,
        focus_window: integer(raw.focus_window, 0, 4294967295), application_window: integer(raw.application_window, 0, 4294967295),
        application: label, application_identity_verified: false, target_restriction: false };
}
fn read() {
    if platform() != "linux" { throw "desktop context backend unavailable"; }
    let display = env_get("DISPLAY");
    if type(display) != "string" or len(display) < 2 or len(display) > 24 or str_slice(display, 0, 1) != ":" { throw "local X11 display required"; }
    let parts = str_split(str_slice(display, 1, len(display)), ".");
    if len(parts) > 2 { throw "invalid local display"; }
    for part in parts {
        if len(part) < 1 { throw "invalid local display"; }
        for c in str_to_bytes(part) { if c < 48 or c > 57 { throw "invalid local display"; } }
    }
    let native = ffi_load(cwd() + "/transport/desktop_context_abi.so");
    let raw = try ffi_call_typed(native, "pbdesktop_context", "->string", []) catch "";
    ffi_close(native);
    if len(str_to_bytes(raw)) > 4096 { throw "desktop context bound"; }
    return normalize(json_parse(raw), num_floor(now_ms()));
}
fn valid(value) {
    if type(value) != "map" or (try value.available catch nil) != true { return false; }
    if value.format != "pb_mcp.desktop-context.v1" or value.application_identity_verified != false or value.target_restriction != false { return false; }
    if type(value.application) != "string" or len(value.application) < 1 or len(value.application) > 80 { return false; }
    let hex = "";
    for c in str_to_bytes(value.application) {
        if c < 32 or c > 126 { return false; }
        hex = hex + str_slice("0123456789abcdef", num_floor(c / 16), num_floor(c / 16) + 1) + str_slice("0123456789abcdef", c % 16, c % 16 + 1);
    }
    let raw = map{ root_width: value.root_width, root_height: value.root_height, monitor_source: value.monitor_source,
        monitors: value.monitors, focus_window: value.focus_window, application_window: value.application_window, application_hex: hex };
    return try { normalize(raw, value.observed_at_ms); true } catch false;
}
export normalize, read, valid;
