// Pure PBLang constructor switch. Retained implementations remain in source;
// only the explicitly selected lazy factory runs. No retry or implicit fallback.
// This is a local composition API, not an MCP configuration/permission surface.
fn open(enabled, selected, factories) {
    if type(enabled) != "bool" { throw "implementation enablement must be boolean"; }
    if not enabled { throw "implementation disabled"; }
    if type(selected) != "string" or len(selected) < 1 or len(selected) > 64 {
        throw "invalid implementation selection";
    }
    for ch in str_to_bytes(selected) {
        if not ((ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95) {
            throw "invalid implementation selection";
        }
    }
    if type(factories) != "map" or not map_has(factories,selected) { throw "selected implementation unavailable"; }
    let factory = factories[selected];let kind = type(factory);
    if kind != "closure" and kind != "function" and kind != "builtin" {
        throw "selected implementation must be a lazy factory";
    }
    return factory();
}
export open;
