// Bounded literal Sheet transpose via stdlib:table_reshape.sapp.
let Reshape = import("stdlib:table_reshape.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table transpose arguments"; }
fn implemented_tools() { return ["data_table_transpose"]; }

fn call_transpose(name, args) {
    if name != "data_table_transpose" { return nil; }
    if type(args) != "map" or len(args) != 1 or not map_has(args, "document") {
        _fail();
    }
    for key in map_keys(args) {
        if key != "document" { _fail(); }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil or size.rows > Sheet.MAX_COLUMNS { _fail(); }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let reshaped = try Reshape.transpose(args.document) catch nil;
    if reshaped == nil { _fail(); }
    let checked = try Sheet.validate(reshaped) catch nil;
    if checked == nil or checked.rows != size.columns
       or checked.columns != size.rows
       or checked.text_bytes != size.text_bytes {
        _fail();
    }
    let result = map{
        format: "pb_mcp.data_table_transpose.v1",
        document: reshaped,
        source_rows: size.rows,
        source_column_count: size.columns,
        row_count: checked.rows,
        column_count: checked.columns,
        input_text_bytes: size.text_bytes,
        output_text_bytes: checked.text_bytes,
        index_base: 0,
        normalization: "none",
        types_inferred: false,
        formulas_evaluated: false,
        contains_cell_text: true,
        contains_headers: true,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 8,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..8 rows and 1..8 columns so the transposed Sheet remains within Sheet column limits (<=8 columns, <=32 rows), 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL."
    };
    return [map{
        name: "data_table_transpose",
        category: "table-reshape",
        profile: "core-code",
        source: "src/table_transpose.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document"],
            additionalProperties: false,
            properties: map{ document: document }
        },
        description: "Transpose rows and columns of a caller-supplied literal pblang.sheet-document.v1 (cell[r][c] becomes output cell[c][r]). Source tables must have 1..8 rows and 1..8 columns so the transposed output fits within the 8-column Sheet ceiling. Preserves exact literal UTF8 strings, leading zeros, whitespace, and formula text without evaluation or type inference. Serialized arguments and result each <=65536 UTF8bytes. Caller-private cells/headers returned; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet transpose with exact dimension/byte preservation and pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_table_transpose:exact_transpose",
                "pb_mcp_table_transpose:dimension_bounds",
                "pb_mcp_table_transpose:detached_results",
                "pb_mcp_table_transpose:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_transpose, catalog_entries, functional_records;
