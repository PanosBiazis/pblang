// Pure policy for bounded native event snapshots. The caller latches rejection
// by closing its binding. This does not authenticate an application or toolkit.
fn integer(v,low,high) { return type(v)=="number" and v>=low and v<=high and v==num_floor(v); }
fn permits(snapshot,handles) {
    if type(snapshot)!="map" or type(handles)!="array" or len(handles)<2 or len(handles)>17 { return false; }
    for handle in handles { if not integer(handle,1,9007199254740991) { return false; } }
    for key in map_keys(snapshot) { if key!="format" and key!="overflow" and key!="events" { return false; } }
    if (try snapshot.format catch nil)!="pb_mcp.target-events.v2" or (try snapshot.overflow catch nil)!=false { return false; }
    let events=try snapshot.events catch nil;
    if type(events)!="array" or len(events)>128 { return false; }
    for event in events {
        if type(event)!="array" or len(event)!=3 or not integer(event[0],1,9007199254740991)
            or not integer(event[1],1,12) or not integer(event[2],-2147483648,2147483647) { return false; }
        if ((event[1]>=2 and event[1]<=4) or event[1]>=7) and event[2]!=0 and event[2]!=1 { return false; }
        let selected=false;
        for handle in handles { if handle==event[0] { selected=true; } }
        if selected {
            let kind=event[1];let value=event[2];
            // 1 children, 2 defunct, 3 showing, 4 focused, 5 parent, 6 role.
            if kind==1 or kind==5 or kind==6 { return false; }
            if kind==2 and value!=0 { return false; }
            if kind==3 and value==0 { return false; }
            if kind==4 and value==0 and event[0]==handles[len(handles)-1] { return false; }
            // 7 editable, 8 sensitive, 9 visible, 10 read-only, 11 busy, 12 stale.
            if kind==7 and value==0 and event[0]==handles[len(handles)-1] { return false; }
            if (kind==8 or kind==9) and value==0 { return false; }
            if kind>=10 and value==1 { return false; }
        }
    }
    return true;
}
export permits;
