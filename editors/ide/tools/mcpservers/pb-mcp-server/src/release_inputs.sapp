// Deterministic identity for every PBLang source that the semantic matrix
// certifies. Old reports become stale after any source, test, or lock change.

let SEC = import("security.sapp");

fn _files(directory, limit) {
    let names = SEC.list_project_dir(directory, limit);
    let out = [];
    for i len(names) {
        if str_ends_with(names[i], ".sapp") { array_push(out, directory + "/" + names[i]); }
    }
    return array_sort(out);
}

fn current() {
    let paths = _files("src", 500);
    let tests = _files("tests/semantics", 1000);
    for i len(tests) { array_push(paths, tests[i]); }
    let fixtures = _files("tests/fixtures", 1000);
    for i len(fixtures) { array_push(paths, fixtures[i]); }
    let tools = _files("tools", 500);
    for i len(tools) { array_push(paths, tools[i]); }
    array_push(paths, "pblang.lock");
    paths = array_sort(paths);
    let identity = "pb_mcp.release-inputs.v1\n";
    for i len(paths) {
        let text = SEC.read_project_text(paths[i], 4194304);
        identity = identity + paths[i] + "\x00" + sha256(text) + "\n";
    }
    return map{ format: "pb_mcp.release-inputs.v1", file_count: len(paths),
        sha256: sha256(identity), paths: paths };
}

export current;
