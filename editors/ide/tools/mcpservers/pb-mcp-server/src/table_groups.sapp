// Exact composite-key review of bounded caller tables; no inference or I/O.
let Sheet=import("stdlib:sheet_document.sapp");
fn _fail(){throw "Invalid table grouping arguments";}
fn implemented_tools(){return ["data_table_duplicate_groups","data_table_group_counts"];}
fn _admit(args){
 if type(args)!="map" or not map_has(args,"document") or not map_has(args,"key_columns") {_fail();}
 for key in map_keys(args){if key!="document" and key!="key_columns" and key!="header" {_fail();}}
 let size=try Sheet.validate(args.document) catch nil;if size==nil {_fail();}
 let header=try args.header catch false;if type(header)!="bool" {_fail();}
 if type(args.key_columns)!="array" or len(args.key_columns)<1 or len(args.key_columns)>size.columns {_fail();}
 let seen=[];
 for column in args.key_columns{
  if type(column)!="number" or not(column>=0 and column<size.columns) or column!=num_floor(column) {_fail();}
  for previous in seen{if previous==column{_fail();}}push(seen,column);
 }
 if len(str_to_bytes(json_stringify(args)))>65536 {_fail();}
 return size;
}
fn _groups(doc,columns,header){
 let groups=[];let positions=map{};let start=if header {1} else {0};
 for row in range(start,len(doc.cells)){
  let key=[];for column in columns{push(key,doc.cells[row][column]);}
  // An encoded array preserves component boundaries, including control separators.
  let encoded=json_stringify(key);
  if map_has(positions,encoded){let g=groups[positions[encoded]];push(g.rows,row);g.count=g.count+1;} else {positions[encoded]=len(groups);push(groups,map{key:key,rows:[row],count:1});}
 }
 return groups;
}
fn call_groups(name,args){
 if name!="data_table_duplicate_groups" and name!="data_table_group_counts" {return nil;}
 let size=_admit(args);let header=try args.header catch false;
 let groups=_groups(args.document,args.key_columns,header);let out=[];let duplicates=0;let duplicate_groups=0;let grouped=0;
 let counts=name=="data_table_group_counts";
 for group in groups{
  if group.count>1{duplicates=duplicates+group.count-1;duplicate_groups=duplicate_groups+1;grouped=grouped+group.count;}
  if counts{push(out,map{key:group.key,count:group.count});} elif group.count>1{push(out,map{rows:group.rows,count:group.count});}
 }
 let columns=[];for column in args.key_columns{push(columns,column);}
 let start=if header {1} else {0};
 let result=map{format:"pb_mcp."+name+".v1",groups:out,key_columns:columns,header:header,index_base:0,
  rows_checked:size.rows-start,distinct_key_count:len(groups),returned_group_count:len(out),
  duplicate_group_count:duplicate_groups,duplicate_rows:duplicates,rows_in_duplicate_groups:grouped,
  group_order:"first_occurrence",matching:"exact_string_tuple",normalization:"none",
  contains_cell_text:counts,contains_headers:false,safe_to_log:false,native_pblang:true,
  data_source:"caller_supplied",effects_performed:false,network_used:false,model_loaded:false,
  automatic_deletion:false,formulas_evaluated:false};
 if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}
 return result;
}
fn catalog_entries(){
 let document=map{type:"object",required:["format","cells"],additionalProperties:false,
  properties:map{format:map{type:"string",enum:["pblang.sheet-document.v1"]},
   cells:map{type:"array",minItems:1,maxItems:32,items:map{type:"array",minItems:1,maxItems:8,items:map{type:"string",maxLength:256}}}},
  description:"Rectangular1..32 by1..8 literal string cells; max256 UTF8bytes/cell,8192total, no NUL. Missing/null cells invalid, empty strings valid. Runtime verifies byte limits and shape."};
 let schema=map{type:"object",required:["document","key_columns"],additionalProperties:false,
  properties:map{document:document,header:map{type:"boolean",default:false},
   key_columns:map{type:"array",minItems:1,maxItems:8,uniqueItems:true,items:map{type:"integer",minimum:0,maximum:7},description:"Distinct zero-based in-range source columns; caller order preserved, no sorting."}}};
 let descriptions=["Find duplicate groups by exact selected-column composite keys. Return only groups with count>=2, all absolute zero-based source rows including first occurrence, complete counts, and no cell values. duplicate_rows counts occurrences after the first; rows_in_duplicate_groups counts all members. Coordinates remain private.",
  "Count every exact selected-column composite key, returning literal key arrays in caller column order and integer counts, up to32 groups. Key values are intentionally private. No synthetic table header consumes a group slot."];
 let names=implemented_tools();let out=[];
 for i len(names){push(out,map{name:names[i],category:"table-groups",profile:"core-code",source:"src/table_groups.sapp",
  read_only:true,destructive:false,open_world:false,input_schema:schema,
  description:descriptions[i]+" Stable first-occurrence group order. Optional header excludes row0; header-only returns empty groups. Exact strings: no trimming, case folding, Unicode normalization, numeric coercion or formula execution. Arguments/output<=65536 serialized UTF8bytes; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."});}
 return out;
}
fn functional_records(){let out=[];for entry in catalog_entries(){push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,reason:"Bounded exact composite-key groups using shared Sheet admission",evidence_ids:["pb_mcp_table_groups:composite_identity","pb_mcp_table_groups:counts","pb_mcp_table_groups:bounds","pb_mcp_table_groups:privacy_parity"]});}return out;}
export implemented_tools,call_groups,catalog_entries,functional_records;
