// Presentation metadata only. A client name or model claim grants no authority.
fn label(value) {
    if type(value) != "string" or len(value) < 1 or len(value) > 80 { return "Not supplied"; }
    // Reject control, bidirectional and markup ambiguity in the local indicator.
    for character in str_to_bytes(value) {
        if character < 32 or character > 126 { return "Unsupported label"; }
    }
    return value;
}
fn from_initialize(params) {
    return map{ client: label(try params.clientInfo.name catch nil),
        model: label(try params._meta["pb-mcp/model"] catch nil), verified: false };
}
fn valid(value) {
    if type(value) != "map" or (try value.verified catch nil) != false { return false; }
    for key in ["client", "model"] {
        let text = try value[key] catch nil;
        if type(text) != "string" or len(text) < 1 or len(text) > 80 { return false; }
        for character in str_to_bytes(text) { if character < 32 or character > 126 { return false; } }
    }
    return true;
}
export from_initialize, valid;
