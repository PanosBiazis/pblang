// Bounded literal Sheet unpivot over explicit measure columns via stdlib:table_reshape.sapp.
let Reshape = import("stdlib:table_reshape.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table unpivot arguments"; }
fn implemented_tools() { return ["data_table_unpivot"]; }

fn call_unpivot(name, args) {
    if name != "data_table_unpivot" { return nil; }
    if type(args) != "map" or len(args) != 2
       or not map_has(args, "document") or not map_has(args, "columns") {
        _fail();
    }
    for key in map_keys(args) {
        if key != "document" and key != "columns" { _fail(); }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil { _fail(); }
    if type(args.columns) != "array" or len(args.columns) < 1 or len(args.columns) >= size.columns {
        _fail();
    }
    let selected = map{};
    let measures = [];
    for c in args.columns {
        if type(c) != "number" or not (c >= 0 and c < size.columns)
           or c != num_floor(c) or map_has(selected, str(c)) {
            _fail();
        }
        selected[str(c)] = true;
        push(measures, c);
    }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let reshaped = try Reshape.unpivot(args.document, measures) catch nil;
    if reshaped == nil { _fail(); }
    let checked = try Sheet.validate(reshaped) catch nil;
    if checked == nil { _fail(); }
    let ids = [];
    for col in range(0, size.columns) {
        if not map_has(selected, str(col)) { push(ids, col); }
    }
    let result = map{
        format: "pb_mcp.data_table_unpivot.v1",
        document: reshaped,
        source_rows: size.rows,
        source_column_count: size.columns,
        identifier_column_indices: ids,
        measure_column_indices: measures,
        row_count: checked.rows,
        column_count: checked.columns,
        data_rows: checked.rows - 1,
        input_text_bytes: size.text_bytes,
        output_text_bytes: checked.text_bytes,
        variable_column: "Variable",
        value_column: "Value",
        header: true,
        index_base: 0,
        normalization: "none",
        types_inferred: false,
        formulas_evaluated: false,
        contains_cell_text: true,
        contains_headers: true,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 2, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows including header, 2..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL. Row 0 headers must be nonblank after trimming and unique; retained identifier headers must not equal Variable or Value."
    };
    let columns = map{
        type: "array",
        minItems: 1,
        maxItems: 7,
        uniqueItems: true,
        items: map{ type: "integer", minimum: 0, maximum: 7 },
        description: "Distinct zero-based measure column indices to unpivot in caller order. At least one unselected identifier column must remain."
    };
    return [map{
        name: "data_table_unpivot",
        category: "table-reshape",
        profile: "core-code",
        source: "src/table_unpivot.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document", "columns"],
            additionalProperties: false,
            properties: map{ document: document, columns: columns }
        },
        description: "Unpivot selected zero-based measure columns of a caller-supplied literal pblang.sheet-document.v1 into Variable/Value rows while retaining unselected columns as identifiers in source order. Header row is required with unique nonblank names; identifier headers cannot be Variable or Value. Selected measure columns expand in caller order for each data row; header-only tables produce one header row ending in Variable and Value. Preflight output row/column limits (<=32 rows, <=8 columns) and repeated identifier/measure UTF8 bytes (<=8192 bytes) before materializing expanded rows. Serialized arguments and result each <=65536 UTF8bytes. No type inference, trimming of cell values, or formula evaluation. Caller-private cells/headers returned; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet unpivot with explicit measure columns and preflight byte/dimension admission",
            evidence_ids: [
                "pb_mcp_table_unpivot:explicit_measures",
                "pb_mcp_table_unpivot:expansion_bounds",
                "pb_mcp_table_unpivot:detached_results",
                "pb_mcp_table_unpivot:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_unpivot, catalog_entries, functional_records;
