// Bounded literal Sheet category count totals and 2D cross-tabulation margins via stdlib:table_group_totals.sapp.
let Totals = import("stdlib:table_group_totals.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table group totals arguments"; }
fn implemented_tools() { return ["data_table_group_totals"]; }

fn _is_false(v) {
    if v { return false; }
    return true;
}

fn call_group_totals(name, args) {
    if name != "data_table_group_totals" { return nil; }
    if type(args) != "map" or len(args) < 2 or len(args) > 4
       or not map_has(args, "document") or not map_has(args, "column") {
        _fail();
    }
    let has_cross = map_has(args, "column_column");
    for key in map_keys(args) {
        if key != "document" and key != "column"
           and key != "column_column" and key != "header" {
            _fail();
        }
    }
    if type(args.document) != "map" or len(args.document) != 2 { _fail(); }
    let header = false;
    if map_has(args, "header") {
        header = args.header;
    }
    if type(header) != "bool" { _fail(); }
    let size = try Sheet.validate(args.document) catch nil;
    if size == nil { _fail(); }
    let col = args.column;
    if type(col) != "number" or col != num_floor(col)
       or col < 0 or col >= size.columns {
        _fail();
    }
    let col_col: any = nil;
    if has_cross {
        col_col = args.column_column;
        if type(col_col) != "number" or col_col != num_floor(col_col)
           or col_col < 0 or col_col >= size.columns {
            _fail();
        }
    }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let out_doc: any = nil;
    let mode = "counts";
    if _is_false(has_cross) {
        out_doc = try Totals.counts(args.document, col, header) catch nil;
    } else {
        mode = "cross";
        out_doc = try Totals.cross(args.document, col, col_col, header) catch nil;
    }
    if out_doc == nil { _fail(); }
    let out_size = try Sheet.validate(out_doc) catch nil;
    if out_size == nil { _fail(); }
    let out_cells = [];
    for row in out_doc.cells {
        let cloned_row = [];
        for cell in row {
            push(cloned_row, "" + cell);
        }
        push(out_cells, cloned_row);
    }
    let last_r = len(out_cells) - 1;
    let last_c = len(out_cells[0]) - 1;
    let row_categories = len(out_cells) - 2;
    let column_categories: any = nil;
    let total_label_row = out_cells[last_r][0];
    let total_label_column: any = nil;
    let grand_total = parse_number(out_cells[last_r][last_c]);
    if not _is_false(has_cross) {
        column_categories = len(out_cells[0]) - 2;
        total_label_column = out_cells[0][last_c];
    }
    let result = map{
        format: "pb_mcp.data_table_group_totals.v1",
        mode: mode,
        document: map{
            format: out_doc.format,
            cells: out_cells
        },
        source_rows: size.rows,
        source_columns: size.columns,
        input_text_bytes: size.text_bytes,
        output_rows: out_size.rows,
        output_columns: out_size.columns,
        output_text_bytes: out_size.text_bytes,
        column: col,
        column_column: col_col,
        header: header,
        data_rows: grand_total,
        row_categories: row_categories,
        column_categories: column_categories,
        total_label_row: total_label_row,
        total_label_column: total_label_column,
        grand_total: grand_total,
        index_base: 0,
        formulas_evaluated: false,
        contains_cell_text: true,
        contains_headers: false,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows and 1..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL."
    };
    return [map{
        name: "data_table_group_totals",
        category: "table-groups",
        profile: "core-code",
        source: "src/table_group_totals.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["document", "column"],
            additionalProperties: false,
            properties: map{
                document: document,
                column: map{
                    type: "integer",
                    minimum: 0,
                    maximum: 7,
                    description: "Zero-based source column index for 1D category counts or 2D cross-tabulation row axis (<=30 distinct categories)."
                },
                column_column: map{
                    type: "integer",
                    minimum: 0,
                    maximum: 7,
                    description: "Optional zero-based source column index for 2D cross-tabulation column axis (<=6 distinct categories)."
                },
                header: map{
                    type: "boolean",
                    default: false,
                    description: "When true, row 0 is treated as a header row and excluded from category counts and totals."
                }
            }
        },
        description: "Build a literal pblang.sheet-document.v1 category count table with a collision-free Total row (counts mode, <=30 categories) or a 2D cross-tabulation with collision-free row, column, and grand total margins (cross mode when column_column is supplied, <=30 row categories by <=6 column categories). Preserves first-appearance category order without trimming, case folding, or formula execution (contains_cell_text:true, contains_headers:false, safe_to_log:false). Serialized arguments and result each <=65536 UTF8bytes. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded literal Sheet category count totals and 2D cross-tabulation margins with collision-free Total labels and pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_table_group_totals:counts_and_cross_margins",
                "pb_mcp_table_group_totals:label_collision_and_bounds",
                "pb_mcp_table_group_totals:detached_results",
                "pb_mcp_table_group_totals:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_group_totals, catalog_entries, functional_records;
