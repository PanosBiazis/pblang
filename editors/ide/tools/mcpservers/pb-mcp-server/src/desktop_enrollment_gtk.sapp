let GTK = import("desktop_gtk.sapp");
let Enrollment = import("desktop_enrollment.sapp");
fn run() {
    let native = GTK.open(); let g = native.g; let c = native.c;
    fn send(message) {
        let text = json_stringify(message) + "\n"; let bytes = len(str_to_bytes(text));
        if bytes > 4096 or native.send_bytes(text) != bytes { throw "private enrollment channel unavailable"; }
    }
    let model = Enrollment.new(send);
    let resources = map{ window: 0, buffer: 0 };
    fn render() {
        if not g("gtk_init_check", "->bool", []) { throw "display unavailable"; }
        let window = g("gtk_window_new", "->ptr", []); resources.window = window;
        g("gtk_window_set_title", "ptr,string->void", [window, "PB-MCP Create Local Code"]);
        g("gtk_window_set_hide_on_close", "ptr,bool->void", [window, true]);
        g("gtk_window_set_default_size", "ptr,i32,i32->void", [window, 520, 360]);
        let box = g("gtk_box_new", "i32,i32->ptr", [1, 12]);
        for side in ["top", "bottom", "start", "end"] { g("gtk_widget_set_margin_" + side, "ptr,i32->void", [box, 18]); }
        fn label(text) {
            let widget = g("gtk_label_new", "string->ptr", [text]);
            g("gtk_label_set_wrap", "ptr,bool->void", [widget, true]);
            g("gtk_box_append", "ptr,ptr->void", [box, widget]); return widget;
        }
        label("Use a new PB-MCP code; do not reuse other passwords.\nKeep it local. Saving does not grant desktop control.");
        let fields = [];
        for prompt in ["New local code", "Repeat local code"] {
            let entry = g("gtk_entry_new", "->ptr", []);
            g("gtk_entry_set_visibility", "ptr,bool->void", [entry, false]);
            g("gtk_entry_set_max_length", "ptr,i32->void", [entry, 256]);
            g("gtk_entry_set_placeholder_text", "ptr,string->void", [entry, prompt]);
            g("gtk_box_append", "ptr,ptr->void", [box, entry]); array_push(fields, entry);
        }
        let save = g("gtk_toggle_button_new_with_label", "string->ptr", ["Save local code"]);
        let cancel = g("gtk_toggle_button_new_with_label", "string->ptr", ["Cancel"]);
        g("gtk_box_append", "ptr,ptr->void", [box, save]);
        g("gtk_box_append", "ptr,ptr->void", [box, cancel]);
        let status = label("Connecting to local enrollment…");
        g("gtk_window_set_child", "ptr,ptr->void", [window, box]);
        g("gtk_window_present", "ptr->void", [window]);
        let buffer = c("calloc", "i64,i64->ptr", [4097, 1]); resources.buffer = buffer;
        if buffer == 0 { throw "enrollment buffer unavailable"; }
        let pending = ""; let seen = false; let beat = 0;
        while not model.snapshot().stopped and not model.snapshot().done {
            for iteration 16 { if native.iterate() == 0 { break; } }
            let surface = g("gtk_native_get_surface", "ptr->ptr", [window]);
            let flags = 1;
            if surface != 0 { flags = g("gdk_toplevel_get_state", "ptr->i32", [surface]); }
            let shown = g("gtk_widget_get_visible", "ptr->bool", [window]) and surface != 0
                and bit_and(flags, 65537) == 0 and g("gdk_surface_get_mapped", "ptr->bool", [surface]);
            if shown { seen = true; } elif seen { model.cancel(); break; }
            let foreground = shown and g("gtk_window_is_active", "ptr->bool", [window]);
            c("memset", "ptr,i32,i64->ptr", [buffer, 0, 4097]);
            let count = native.receive(buffer);
            if count == 0 { model.cancel(); break; }
            if count > 0 {
                let chunk = native.text(buffer);
                if count > 4096 or len(str_to_bytes(chunk)) != count or len(pending) + len(chunk) > 4096 { throw "invalid enrollment frame"; }
                pending = pending + chunk; let newline = str_index_of(pending, "\n");
                while newline >= 0 {
                    model.receive(json_parse(str_slice(pending, 0, newline)));
                    pending = str_slice(pending, newline + 1, len(pending)); newline = str_index_of(pending, "\n");
                }
            }
            if g("gtk_toggle_button_get_active", "ptr->bool", [cancel]) { model.cancel(); break; }
            if g("gtk_toggle_button_get_active", "ptr->bool", [save]) {
                g("gtk_toggle_button_set_active", "ptr,bool->void", [save, false]);
                let first = g("gtk_editable_get_text", "ptr->string", [fields[0]]);
                let second = g("gtk_editable_get_text", "ptr->string", [fields[1]]);
                for entry in fields { g("gtk_editable_set_text", "ptr,string->void", [entry, ""]); }
                model.submit(first, second, foreground);
            }
            let enabled = model.snapshot().can_submit and foreground;
            for entry in fields { g("gtk_widget_set_sensitive", "ptr,bool->void", [entry, enabled]); }
            g("gtk_widget_set_sensitive", "ptr,bool->void", [save, enabled]);
            g("gtk_label_set_text", "ptr,string->void", [status, model.snapshot().status]);
            if shown and not model.snapshot().stopped and now_ms() - beat >= 200 {
                send(map{ action: "heartbeat" }); beat = now_ms();
            }
            sleep_ms(25);
        }
        return true;
    }
    let ok = try render() catch false;
    model.cancel();
    if resources.window != 0 { try g("gtk_window_destroy", "ptr->void", [resources.window]) catch nil; }
    if resources.buffer != 0 { try c("free", "ptr->void", [resources.buffer]) catch nil; }
    native.close();
    if not ok { throw "local enrollment closed after a UI or channel failure"; }
}
export run;
