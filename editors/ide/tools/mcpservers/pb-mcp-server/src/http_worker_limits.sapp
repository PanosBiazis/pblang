// Shared worker-artifact limits used by publication, recovery and execution.

let MAX_INDEX_BYTES = 1048576;
let MAX_LAUNCHER_BYTES = 268435456;
let MAX_PAYLOAD_BYTES = 67108864;
let MAX_WORKER_OUTPUT_BYTES = 1048576;

fn status() {
    return map{format:"pb_mcp.http-worker-limits.v1",
        max_index_bytes:MAX_INDEX_BYTES,
        max_launcher_bytes:MAX_LAUNCHER_BYTES,
        max_payload_bytes:MAX_PAYLOAD_BYTES,
        max_worker_output_bytes:MAX_WORKER_OUTPUT_BYTES,
        shared_by_publisher_recovery_executor:true};
}

export MAX_INDEX_BYTES, MAX_LAUNCHER_BYTES, MAX_PAYLOAD_BYTES,
       MAX_WORKER_OUTPUT_BYTES, status;
