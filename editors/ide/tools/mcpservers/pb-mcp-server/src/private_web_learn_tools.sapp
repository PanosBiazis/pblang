fn call_private_web_learn(tool, args) {
    if args == nil { args = map{}; }
    if tool == "mcp_private_blind_web_search_via_mcp" { return mcp_private_blind_web_search_via_mcp(args); }
    if tool == "mcp_outbound_query_pii_secret_redactor" { return mcp_outbound_query_pii_secret_redactor(args); }
