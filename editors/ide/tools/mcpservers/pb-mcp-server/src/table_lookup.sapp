// Bounded literal many-to-one Sheet enrichment via stdlib:table_lookup.sapp.
let Lookup = import("stdlib:table_lookup.sapp");
let Sheet = import("stdlib:sheet_document.sapp");

fn _fail() { throw "Invalid table lookup arguments"; }
fn implemented_tools() { return ["data_table_lookup"]; }

fn call_lookup(name, args) {
    if name != "data_table_lookup" { return nil; }
    if type(args) != "map" or (len(args) != 5 and len(args) != 6)
       or not map_has(args, "left") or not map_has(args, "right")
       or not map_has(args, "left_key") or not map_has(args, "right_key")
       or not map_has(args, "columns") {
        _fail();
    }
    if len(args) == 6 and not map_has(args, "mode") { _fail(); }
    for key in map_keys(args) {
        if key != "left" and key != "right" and key != "left_key"
           and key != "right_key" and key != "columns" and key != "mode" {
            _fail();
        }
    }
    if type(args.left) != "map" or len(args.left) != 2
       or type(args.right) != "map" or len(args.right) != 2 {
        _fail();
    }
    let left_size = try Sheet.validate(args.left) catch nil;
    let right_size = try Sheet.validate(args.right) catch nil;
    if left_size == nil or right_size == nil { _fail(); }
    if type(args.left_key) != "number" or not (args.left_key >= 0 and args.left_key < left_size.columns)
       or args.left_key != num_floor(args.left_key) {
        _fail();
    }
    if type(args.right_key) != "number" or not (args.right_key >= 0 and args.right_key < right_size.columns)
       or args.right_key != num_floor(args.right_key) {
        _fail();
    }
    let mode = if map_has(args, "mode") { args.mode } else { "left" };
    if type(mode) != "string" or (mode != "left" and mode != "inner") { _fail(); }
    if type(args.columns) != "array" or len(args.columns) < 1 or len(args.columns) > right_size.columns
       or left_size.columns + len(args.columns) > 8 {
        _fail();
    }
    let seen_cols = map{};
    let lookup_cols = [];
    for c in args.columns {
        if type(c) != "number" or not (c >= 0 and c < right_size.columns)
           or c != num_floor(c) or map_has(seen_cols, str(c)) {
            _fail();
        }
        seen_cols[str(c)] = true;
        push(lookup_cols, c);
    }
    let left_headers = map{};
    let output_bytes = 0;
    for lh in args.left.cells[0] {
        if str_trim(lh) == "" or map_has(left_headers, lh) { _fail(); }
        left_headers[lh] = true;
        output_bytes = output_bytes + len(str_to_bytes(lh));
    }
    let right_headers = map{};
    for rh in args.right.cells[0] {
        if str_trim(rh) == "" or map_has(right_headers, rh) { _fail(); }
        right_headers[rh] = true;
    }
    for col in lookup_cols {
        let sel_h = args.right.cells[0][col];
        if map_has(left_headers, sel_h) { _fail(); }
        output_bytes = output_bytes + len(str_to_bytes(sel_h));
    }
    if output_bytes > 8192 { _fail(); }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let right_index = map{};
    let right_selected_bytes = map{};
    for r in range(1, right_size.rows) {
        let rkey = args.right.cells[r][args.right_key];
        if str_trim(rkey) == "" or map_has(right_index, rkey) { _fail(); }
        right_index[rkey] = r;
        let rbytes = 0;
        for col in lookup_cols {
            rbytes = rbytes + len(str_to_bytes(args.right.cells[r][col]));
        }
        right_selected_bytes[str(r)] = rbytes;
    }
    let reference_rows = [];
    let unmatched_source_rows = [];
    for r in range(1, left_size.rows) {
        let lkey = args.left.cells[r][args.left_key];
        if str_trim(lkey) == "" { _fail(); }
        let found = map_has(right_index, lkey);
        if not found { push(unmatched_source_rows, r); }
        if found or mode == "left" {
            for lcell in args.left.cells[r] {
                output_bytes = output_bytes + len(str_to_bytes(lcell));
            }
            if found {
                let ref_r = right_index[lkey];
                output_bytes = output_bytes + right_selected_bytes[str(ref_r)];
                push(reference_rows, ref_r);
            } else {
                push(reference_rows, nil);
            }
            if output_bytes > 8192 { _fail(); }
        }
    }
    let joined = try Lookup.join(args.left, args.right, args.left_key, args.right_key, lookup_cols, mode) catch nil;
    if joined == nil { _fail(); }
    let checked = try Sheet.validate(joined.document) catch nil;
    if checked == nil or checked.text_bytes != output_bytes { _fail(); }
    let result = map{
        format: "pb_mcp.data_table_lookup.v1",
        document: joined.document,
        mode: joined.mode,
        left_key: args.left_key,
        right_key: args.right_key,
        lookup_column_indices: lookup_cols,
        left_rows: left_size.rows,
        left_data_rows: left_size.rows - 1,
        right_rows: right_size.rows,
        right_data_rows: right_size.rows - 1,
        row_count: checked.rows,
        column_count: checked.columns,
        data_rows: checked.rows - 1,
        matched: joined.matched,
        unmatched: joined.unmatched,
        row_matches: joined.row_matches,
        source_rows: joined.source_rows,
        reference_rows: reference_rows,
        unmatched_source_rows: unmatched_source_rows,
        input_text_bytes: left_size.text_bytes + right_size.text_bytes,
        output_text_bytes: checked.text_bytes,
        header: true,
        index_base: 0,
        row_index_base: 1,
        matching: "exact_string_key",
        normalization: "none",
        types_inferred: false,
        formulas_evaluated: false,
        contains_cell_text: true,
        contains_headers: true,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let document = map{
        type: "object",
        required: ["format", "cells"],
        additionalProperties: false,
        properties: map{
            format: map{ type: "string", enum: ["pblang.sheet-document.v1"] },
            cells: map{
                type: "array", minItems: 1, maxItems: 32,
                items: map{
                    type: "array", minItems: 1, maxItems: 8,
                    items: map{ type: "string", maxLength: 256 }
                }
            }
        },
        description: "Rectangular literal Sheet, 1..32 rows including header, 1..8 columns, 256 UTF8bytes/cell, 8192 aggregate bytes, no NUL. Row 0 headers must be nonblank after trimming and unique."
    };
    let column_index = map{ type: "integer", minimum: 0, maximum: 7 };
    let columns = map{
        type: "array",
        minItems: 1,
        maxItems: 7,
        uniqueItems: true,
        items: column_index,
        description: "Distinct zero-based reference column indices to append in caller order; combined output columns must not exceed 8 and selected reference headers must not collide with left headers."
    };
    return [map{
        name: "data_table_lookup",
        category: "table-lookup",
        profile: "core-code",
        source: "src/table_lookup.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            required: ["left", "right", "left_key", "right_key", "columns"],
            additionalProperties: false,
            properties: map{
                left: document,
                right: document,
                left_key: column_index,
                right_key: column_index,
                columns: columns,
                mode: map{ type: "string", enum: ["left", "inner"], default: "left" }
            }
        },
        description: "Enrich a caller-supplied left pblang.sheet-document.v1 with selected columns from a reference right pblang.sheet-document.v1 by exact literal string key matching. Right data keys must be unique and nonblank after trimming; left data keys must be nonblank after trimming. Mode is left (default, retains unmatched left rows with empty strings and records row_matches/reference_rows/unmatched_source_rows to distinguish missing keys from matched empty cells) or inner (retains only matched left rows). Row 0 headers in both tables must be unique and nonblank after trimming, and selected right headers must not collide with left headers. Preflight combined column count (<=8) and repeated-left-key output UTF8 bytes (<=8192) before materializing joined rows. Serialized arguments and result each <=65536 UTF8bytes. No fuzzy/numeric tolerance, many-to-many multiplication, type inference, or formula evaluation. Caller-private cells/headers returned; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded exact many-to-one literal Sheet lookup with explicit provenance and preflight byte admission",
            evidence_ids: [
                "pb_mcp_table_lookup:exact_many_to_one",
                "pb_mcp_table_lookup:repeated_key_bounds",
                "pb_mcp_table_lookup:detached_results",
                "pb_mcp_table_lookup:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_lookup, catalog_entries, functional_records;
