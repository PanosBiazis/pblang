// Operator-only account policy. Never imported by the public MCP dispatcher.
fn _keys(value, allowed, required) {
    if type(value) != "map" { throw "invalid account object"; }
    for key in map_keys(value) {
        let found = false;
        for name in allowed { if key == name { found = true; } }
        if not found { throw "unexpected account property"; }
    }
    for name in required { if not map_has(value, name) { throw "missing account property"; } }
}
fn _provider(name) {
    if name != "supabase" and name != "vercel" { throw "unsupported account provider"; }
}
fn _ascii(value, low, high, token) {
    if type(value) != "string" { return false; }
    let bytes = str_to_bytes(value);
    if len(bytes) < low or len(bytes) > high { return false; }
    for n in bytes {
        if not ((n >= 48 and n <= 57) or (n >= 65 and n <= 90) or (n >= 97 and n <= 122)
            or (token and (n == 46 or n == 95 or n == 126 or n == 61 or n == 45))) { return false; }
    }
    return true;
}
fn _account(name, value) {
    _provider(name);
    let allowed = ["token", "operations"];
    if name == "vercel" { array_push(allowed, "team_id"); }
    _keys(value, allowed, ["token", "operations"]);
    if not _ascii(value.token, 16, 4096, true) { throw "invalid bearer credential"; }
    if type(value.operations) != "array" or len(value.operations) < 1 or len(value.operations) > 2 { throw "invalid account grants"; }
    let operations = [];
    for operation in value.operations {
        if (name == "vercel" and operation != "vercel_projects" and operation != "vercel_deployments") or
           (name == "supabase" and operation != "supabase_projects" and operation != "supabase_organizations") { throw "invalid provider grant"; }
        for previous in operations { if previous == operation { throw "duplicate account grant"; } }
        array_push(operations, operation);
    }
    let result = map{ token: value.token, operations: operations };
    if map_has(value, "team_id") {
        let team = value.team_id;
        if type(team) != "string" or not str_starts_with(team, "team_")
            or not _ascii(str_slice(team, 5, len(team)), 1, 128, false) { throw "invalid account team"; }
        result.team_id = team;
    }
    return result;
}
fn _accounts(document) {
    if document == nil { return map{}; }
    if type(document) != "map" { throw "invalid account document"; }
    let format = try document.format catch nil;
    if format == "pb_mcp.supabase-account.v1" {
        _keys(document, ["format", "token", "operations"], ["format", "token", "operations"]);
        return map{ supabase: _account("supabase", map{ token: document.token, operations: document.operations }) };
    }
    if format != "pb_mcp.service-accounts.v2" { throw "unsupported account document"; }
    _keys(document, ["format", "accounts"], ["format", "accounts"]);
    _keys(document.accounts, ["supabase", "vercel"], []);
    if len(map_keys(document.accounts)) < 1 { throw "empty account document"; }
    let accounts = map{};
    for name in map_keys(document.accounts) { accounts[name] = _account(name, document.accounts[name]); }
    return accounts;
}
fn _summary(accounts) {
    let providers = [];
    for name in ["supabase", "vercel"] {
        if map_has(accounts, name) {
            array_push(providers, map{ provider: name, operations: accounts[name].operations,
                team_scoped: map_has(accounts[name], "team_id") });
        }
    }
    return map{ configured: len(providers) > 0, providers: providers };
}
fn plan(request) {
    _keys(request, ["action", "provider", "document", "account", "clear_team"], ["action", "document"]);
    let accounts = _accounts(request.document);
    if request.action == "status" {
        _keys(request, ["action", "document"], ["action", "document"]);
        return map{ ok: true, status: _summary(accounts) };
    }
    let name = try request.provider catch nil;
    _provider(name);
    let clear = try request.clear_team catch false;
    if type(clear) != "bool" or (clear and name != "vercel") { throw "invalid team removal"; }
    if request.action == "set" {
        let account = _account(name, try request.account catch nil);
        if clear and map_has(account, "team_id") { throw "conflicting team selection"; }
        // Token rotation keeps the old operator team unless explicitly changed.
        if not clear and name == "vercel" and not map_has(account, "team_id")
            and map_has(accounts, name) and map_has(accounts[name], "team_id") {
            account.team_id = accounts[name].team_id;
        }
        accounts[name] = account;
    } elif request.action == "remove" {
        if map_has(request, "account") or map_has(request, "clear_team") { throw "invalid removal request"; }
        if not map_has(accounts, name) { throw "provider is not configured"; }
        let remaining = map{};
        for other in map_keys(accounts) { if other != name { remaining[other] = accounts[other]; } }
        accounts = remaining;
    } else { throw "invalid account action"; }
    if len(map_keys(accounts)) == 0 { return map{ ok: true, document: nil, status: _summary(accounts) }; }
    let document = map{ format: "pb_mcp.service-accounts.v2", accounts: accounts };
    if len(str_to_bytes(json_stringify(document))) > 8192 { throw "account file size exceeded"; }
    return map{ ok: true, document: document, status: _summary(accounts) };
}
export plan;
