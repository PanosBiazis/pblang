// Statically linked read-only core worker shard.

let RUNTIME = import("http_worker_shard_runtime.sapp");
let CORE = import("core_tools.sapp");

let SHARD_ID = "core-read-v1";
let OWNED_TOOLS = CORE.implemented_tools();
let GENERATION_DIGEST = sha256("pb_mcp.worker-shard.v1\n" + SHARD_ID + "\n" +
    str_join(OWNED_TOOLS, "\n"));

RUNTIME.run(SHARD_ID, GENERATION_DIGEST, OWNED_TOOLS, "tools.read",
    CORE.call_core);
