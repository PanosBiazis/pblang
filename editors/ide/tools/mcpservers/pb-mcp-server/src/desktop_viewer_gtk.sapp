}
fn _run_pure_pblang() {
    let outcome=run_with(GTK.open());
    if outcome.body_status!="returned" {
        throw "local viewer closed after rendering or connection failure";
    }
    if not outcome.cleanup_ok {throw "local viewer resource cleanup failed";}
}
fn run() {
    return Switch.open(true, "pure_pblang", map{
        pure_pblang: _run_pure_pblang,
        disabled_polyglot_live_viewer: run_disabled_polyglot
    });
}
export run, run_with, run_disabled_polyglot;
