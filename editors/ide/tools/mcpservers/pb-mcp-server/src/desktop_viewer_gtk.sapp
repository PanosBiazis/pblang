            sleep_ms(25);
        }
        return true;
    }
    // Define callbacks here to avoid the retained compiler's transitive capture
    // limitation for callbacks nested inside the scope body.
    fn close_native() { native.close(); return map{ok:true,value:nil}; }
    fn free_buffer() {
