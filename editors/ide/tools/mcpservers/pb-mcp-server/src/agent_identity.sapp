// Stable, non-secret agent attribution for authenticated multi-user requests.

fn _identity_id(value, name) {
    if type(value) != "string" or not regex_match(value, "^[a-z][a-z0-9_-]{2,63}$") {
        throw name + " must be a canonical identity id";
    }
    return value;
}

fn derive(principal, organization_id) {
    principal = _identity_id(principal, "authenticated principal");
    organization_id = _identity_id(organization_id, "authenticated organization");
    return "agent-" + str_slice(sha256(
        "pb_mcp.authenticated-agent.v1\n" + organization_id + "\n" + principal), 0, 32);
}

export derive;
