// Fail-closed classifier for physical Windows filesystem evidence.

let ABI = import("stdlib:windows_native_abi.sapp");

let REQUIRED = ["binary_roundtrip", "bounded_exact_read", "bounded_prefix_read",
    "bounded_range_read",
    "exclusive_collision", "atomic_replacement", "metadata_and_listing",
    "descriptor_lock", "path_confinement", "reparse_refusal", "handle_remove"];
let CONTRACT_REVISION = 3;
let EXPECTED_TEST_SOURCE_SHA256 = "39c80b18bc3127870db688035db0cb60383f99a31b7140f220630cb337704d25";

fn verify(report, expected_stdlib_sha256 = nil, expected_test_source_sha256 = nil) {
    let errors = [];
    if type(report) != "map" { return map{ ok: false, errors: ["report is not a map"] }; }
    if (try report.format catch "") != "pb_mcp.windows-dirfs-physical-matrix.v1" { array_push(errors, "invalid format"); }
    if (try report.platform catch "") != "windows" or (try report.architecture catch "") != "x86_64" {
        array_push(errors, "evidence is not from Windows x86-64");
    }
    if not (try report.physical_host catch false) { array_push(errors, "physical host marker is absent"); }
    if (try report.contract_revision catch -1) != CONTRACT_REVISION { array_push(errors, "unsupported evidence contract revision"); }
    if (try report.bridge_sha256 catch "") != ABI.expected_sha256() { array_push(errors, "bridge digest differs from this PBLang release"); }
    let stdlib_sha256 = try report.stdlib_sha256 catch "";
    if not regex_match(stdlib_sha256, "^[0-9a-f]{64}$") { array_push(errors, "stdlib identity is absent or invalid"); }
    elif expected_stdlib_sha256 != nil and stdlib_sha256 != expected_stdlib_sha256 {
        array_push(errors, "stdlib digest differs from the current lock");
    }
    let runtime_sha256 = try report.runtime_sha256 catch "";
    if not regex_match(runtime_sha256, "^[0-9a-f]{64}$") { array_push(errors, "runtime binary identity is absent or invalid"); }
    if not (try report.complete catch false) or (try report.failed catch -1) != 0
        or (try report.passed catch -1) != len(REQUIRED) { array_push(errors, "physical matrix is incomplete"); }
    for i len(REQUIRED) { if not (try report.checks[REQUIRED[i]] catch false) { array_push(errors, "missing check: " + REQUIRED[i]); } }
    if not (try report.root_relative_ntcreatefile catch false)
        or not (try report.obj_dont_reparse catch false)
        or (try report.pathname_fallback catch true) { array_push(errors, "filesystem security contract is incomplete"); }
    let test_source_sha256 = try report.test_source_sha256 catch "";
    if not regex_match(test_source_sha256, "^[0-9a-f]{64}$") or (try report.runtime_version catch "") == "" {
        array_push(errors, "runtime or test-source identity is absent");
    } elif test_source_sha256 != EXPECTED_TEST_SOURCE_SHA256 {
        array_push(errors, "test-source digest differs from the canonical Windows release test");
    } elif expected_test_source_sha256 != nil and test_source_sha256 != expected_test_source_sha256 {
        array_push(errors, "test-source digest differs from the current release test");
    }
    return map{ ok: len(errors) == 0, format: "pb_mcp.windows-dirfs-evidence.v1",
        contract_revision: CONTRACT_REVISION, errors: errors, required_checks: REQUIRED,
        bridge_sha256: ABI.expected_sha256(), stdlib_sha256: stdlib_sha256,
        test_source_sha256: test_source_sha256, runtime_sha256: runtime_sha256 };
}

export verify, CONTRACT_REVISION, EXPECTED_TEST_SOURCE_SHA256;
