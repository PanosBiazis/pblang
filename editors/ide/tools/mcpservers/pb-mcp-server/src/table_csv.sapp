// Strict caller-supplied CSV to a literal Sheet; the shared parser owns dialect rules.
let CSV=import("stdlib:sheet_csv.sapp");
let Sheet=import("stdlib:sheet_document.sapp");

fn _fail(){throw "Invalid literal CSV import arguments";}
fn implemented_tools(){return ["data_table_from_csv"];}
fn call_csv(name,args){
    if name!="data_table_from_csv" {return nil;}
    if type(args)!="map" or len(args)>2 or not map_has(args,"text") {_fail();}
    for key in map_keys(args){if key!="text" and key!="delimiter" {_fail();}}
    // Bound raw values before serializing caller arguments or invoking the parser.
    if type(args.text)!="string" or len(args.text)==0 or len(args.text)>65536 {_fail();}
    if len(str_to_bytes(args.text))>65536 {_fail();}
    let delimiter=if map_has(args,"delimiter"){args.delimiter} else {","};
    if type(delimiter)!="string" or (delimiter!="," and delimiter!=";" and delimiter!="\t") {_fail();}
    if len(str_to_bytes(json_stringify(args)))>65536 {_fail();}
    let document=try CSV.decode(args.text,delimiter) catch nil;
    if document==nil {_fail();}
    let checked=try Sheet.validate(document) catch nil;
    if checked==nil {_fail();}
    let result=map{format:"pb_mcp.data_table_from_csv.v1",document:document,
        row_count:checked.rows,column_count:checked.columns,output_text_bytes:checked.text_bytes,delimiter:delimiter,
        header_inferred:false,types_inferred:false,formulas_evaluated:false,normalization:"none",
        contains_cell_text:true,safe_to_log:false,native_pblang:true,data_source:"caller_supplied",
        effects_performed:false,network_used:false,model_loaded:false,automatic_deletion:false};
    if len(str_to_bytes(json_stringify(result)))>65536 {_fail();}
    return result;
}
fn catalog_entries(){
    return [map{name:"data_table_from_csv",category:"table-csv",profile:"core-code",
        source:"src/table_csv.sapp",read_only:true,destructive:false,open_world:false,
        input_schema:map{type:"object",required:["text"],additionalProperties:false,
            properties:map{text:map{type:"string",minLength:1,maxLength:65536,
                description:"Caller-supplied CSV text; at most65536 UTF8bytes, not characters."},
                delimiter:map{type:"string",enum:[",",";","\t"],default:","}}},
        description:"Decode caller-supplied CSV into a detached literal pblang.sheet-document.v1. Delimiter is comma(default), semicolon or tab. Strict quoting and escaped double quotes; embedded line endings inside quotes preserved; outside quotes accept LF/CRLF, reject bare CR. Remove only one initial BOM. No trimming, normalization, header/type inference or formula evaluation. Preserve empty cells, blank records and literal zeros/formulas; terminal record separator adds no phantom row. Empty/BOM-only, NUL, malformed quoting, uneven rows and overflows fail. Output1..32rows,1..8columns,256 UTF8bytes/cell,8192 aggregate cell bytes. Raw text and serialized arguments/result each<=65536 UTF8bytes. Headers are ordinary cells; downstream tools apply their own header rules. Caller-private cells returned; safe_to_log:false. No file/network/model/storage/automatic collection or deletion."}];
}
fn functional_records(){
    let out=[];
    for entry in catalog_entries(){
        push(out,map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
            reason:"Strict bounded caller-supplied CSV import preserving literal Sheet cells",
            evidence_ids:["pb_mcp_table_csv:literal_dialect","pb_mcp_table_csv:utf8_bounds",
                "pb_mcp_table_csv:detached_results","pb_mcp_table_csv:privacy_parity"]});
    }
    return out;
}
export implemented_tools,call_csv,catalog_entries,functional_records;
