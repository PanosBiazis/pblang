        "stiefel_33m_mmap_cartridge_lookup",
        "tensor_train_mps_400x_mdl_packet",
        "semver_v34_and_32char_name_verify",
        "fleet_5node_ml_kem_768_personal_guard",
        "compiler_ast_80lang_28target_synth",
        "angstrom_08nm_silicon_d47_qec",
