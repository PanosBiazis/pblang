let _V34_CACHE = map{};

fn _v34() {
    if map_has(_V34_CACHE, "m") { return _V34_CACHE["m"]; }
    let m = try import("editors/ide/tools/ai/pbai_topo_noise_v34.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_topo_noise_v34.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_topo_noise_v34.sapp") catch nil; }
    if m == nil { m = try import("../../pblang/editors/ide/tools/ai/pbai_topo_noise_v34.sapp") catch nil; }
    if m == nil { m = try import("../../../pblang/editors/ide/tools/ai/pbai_topo_noise_v34.sapp") catch nil; }
    _V34_CACHE["m"] = m;
    return m;
}

fn implemented_tools() {
    return [
        "fisher_rao_geodesic_simplex_eval",
        "stiefel_newton_schulz_project",
        "complex_plane_1plus0i_ideality",
        "pareto_front_consensus_gate",
