// PB-MCP Lazy Module #102: Category & Subcategory Sub-Model Swarm v15 Tools (14 Tools)
// Exposes PBAI v15.0.0 Arbitrary-Depth Category/Subcategory Taxonomy (Up to 32 Edges / 1,024 Nodes),
// Exact-Leaf Sub-Model Routing, Leaf Refinement (refine_leaf & extend_path), Dynamic Micro-Specialist
// LoRA Spawning, Cross-Category Polymath Synthesis, and 4-Pillar 2026 Competitor Supremacy Evaluator.

let _ENG = map{};
fn _eng() {
    if map_has(_ENG, "v15") { return _ENG["v15"]; }
    let m = try import("editors/ide/tools/ai/pbai_hierarchical_multimodel_orchestrator_and_taxonomy_v15.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_hierarchical_multimodel_orchestrator_and_taxonomy_v15.sapp") catch nil; }
    if m == nil { m = import("../../ai/pbai_hierarchical_multimodel_orchestrator_and_taxonomy_v15.sapp"); }
    _ENG["v15"] = m;
    return m;
}

fn pb_mcp_arbitrary_depth_32edge_taxonomy_resolver(args) {
    return _eng().evaluate_arbitrary_depth_category_subcategory_taxonomy(args);
}

fn pb_mcp_exact_leaf_only_submodel_router(args) {
    let res = _eng().evaluate_arbitrary_depth_category_subcategory_taxonomy(args);
    return map{
        ok: res.ok,
        engine: "pb_mcp_exact_leaf_only_submodel_router_v15",
        resolved_leaf_node: res.resolved_leaf_node,
        resolved_depth: res.resolved_depth,
        exact_leaf_routing_only: res.exact_leaf_routing_only,
        routing_inheritance: res.routing_inheritance,
        taxonomy_digest: res.taxonomy_digest
    };
}

