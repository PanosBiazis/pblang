// Bounded offline browser document creation, strict inert HTML import/export, and CSP-locked page rendering via stdlib:browser_document.sapp.
let BrowserDoc = import("stdlib:browser_document.sapp");

fn _fail() { throw "Invalid browser document review arguments"; }
fn implemented_tools() { return ["browser_document_review"]; }

fn _is_true(v) {
    if v { return true; }
    return false;
}

fn _clone_widget(w) {
    let props = map{
        tag: "" + w.props.tag,
        text: "" + w.props.text
    };
    if map_has(w.props, "href") {
        props.href = "" + w.props.href;
    }
    return map{
        format: "" + w.format,
        id: "" + w.id,
        kind: "" + w.kind,
        parent: "" + w.parent,
        x: w.x,
        y: w.y,
        w: w.w,
        h: w.h,
        props: props,
        events: map{},
        bind: "" + w.bind
    };
}

fn _clone_document(doc) {
    let widgets = [];
    for w in doc.widgets {
        push(widgets, _clone_widget(w));
    }
    return map{
        ok: true,
        format: "" + doc.format,
        source_format: "" + doc.source_format,
        form: map{
            format: "" + doc.form.format,
            id: "" + doc.form.id,
            title: "" + doc.form.title,
            w: doc.form.w,
            h: doc.form.h
        },
        widgets: widgets,
        model: map{},
        widget_count: doc.widget_count,
        value_node_count: doc.value_node_count,
        embedded_code: false,
        direct_effects: false,
        handlers_executed: false,
        renderer_bound: false,
        external_sdk_required: false
    };
}

fn call_browser_document(name, args) {
    if name != "browser_document_review" { return nil; }
    if type(args) != "map" or len(args) < 1 or len(args) > 4 {
        _fail();
    }
    let has_source = map_has(args, "source");
    let has_title = map_has(args, "title");
    let has_blocks = map_has(args, "blocks");
    let has_document = map_has(args, "document");
    let has_targets = map_has(args, "targets");
    let has_include_page = map_has(args, "include_page");
    for key in map_keys(args) {
        if key != "source" and key != "title" and key != "blocks"
           and key != "document" and key != "targets" and key != "include_page" {
            _fail();
        }
    }
    let mode = "";
    if _is_true(has_source) {
        if _is_true(has_title) or _is_true(has_blocks) or _is_true(has_document) { _fail(); }
        mode = "import_html";
    } elif _is_true(has_title) or _is_true(has_blocks) {
        if not _is_true(has_title) or not _is_true(has_blocks) or _is_true(has_document) { _fail(); }
        mode = "create";
    } elif _is_true(has_document) {
        mode = "inspect";
    } else {
        _fail();
    }
    let include_page = false;
    if _is_true(has_include_page) {
        include_page = args.include_page;
        if type(include_page) != "bool" { _fail(); }
    }
    let targets: any = nil;
    if _is_true(has_targets) {
        targets = args.targets;
        if type(targets) != "map" or len(targets) > 16 { _fail(); }
    }
    if len(str_to_bytes(json_stringify(args))) > 65536 { _fail(); }
    let raw_doc: any = nil;
    if mode == "import_html" {
        raw_doc = try BrowserDoc.import_html(args.source) catch nil;
    } elif mode == "create" {
        raw_doc = try BrowserDoc.create(args.title, args.blocks) catch nil;
    } else {
        raw_doc = args.document;
    }
    if raw_doc == nil { _fail(); }
    let inspected = try BrowserDoc.inspect(raw_doc) catch nil;
    if inspected == nil { _fail(); }
    let article_html = try BrowserDoc.export_html(inspected.document) catch nil;
    if article_html == nil { _fail(); }
    let page_rendered = _is_true(include_page) or _is_true(has_targets);
    let page_html: any = nil;
    let page_bytes: any = nil;
    if _is_true(page_rendered) {
        page_html = try BrowserDoc.page(inspected.document, targets) catch nil;
        if page_html == nil { _fail(); }
        page_bytes = len(str_to_bytes(page_html));
    }
    let out_blocks = [];
    let links = [];
    let heading_count = 0;
    let paragraph_count = 0;
    let link_count = 0;
    let exported_link_count = 0;
    for b in inspected.blocks {
        let cloned_block = map{
            tag: "" + b.tag,
            text: "" + b.text
        };
        if b.tag == "h2" {
            heading_count = heading_count + 1;
        } elif b.tag == "p" {
            paragraph_count = paragraph_count + 1;
        } elif b.tag == "a" {
            let href = "" + b.href;
            cloned_block.href = href;
            link_count = link_count + 1;
            push(links, href);
            if targets != nil and map_has(targets, href) {
                exported_link_count = exported_link_count + 1;
            }
        }
        push(out_blocks, cloned_block);
    }
    let result = map{
        format: "pb_mcp.browser_document_review.v1",
        mode: mode,
        title: "" + inspected.title,
        blocks: out_blocks,
        block_count: len(out_blocks),
        heading_count: heading_count,
        paragraph_count: paragraph_count,
        link_count: link_count,
        exported_link_count: exported_link_count,
        links: links,
        document: _clone_document(inspected.document),
        article_html: article_html,
        article_bytes: len(str_to_bytes(article_html)),
        page_rendered: page_rendered,
        page_html: page_html,
        page_bytes: page_bytes,
        csp_locked: page_rendered,
        scripts_executed: false,
        contains_document_text: true,
        safe_to_log: false,
        native_pblang: true,
        data_source: "caller_supplied",
        effects_performed: false,
        network_used: false,
        model_loaded: false,
        automatic_deletion: false
    };
    if len(str_to_bytes(json_stringify(result))) > 65536 { _fail(); }
    return result;
}

fn catalog_entries() {
    let block_schema = map{
        type: "object",
        required: ["tag", "text"],
        additionalProperties: false,
        properties: map{
            tag: map{ type: "string", enum: ["h2", "p", "a"] },
            text: map{ type: "string", minLength: 1, maxLength: 256 },
            href: map{ type: "string", minLength: 6, maxLength: 37, description: "Local pb://slug destination required when tag is 'a' and forbidden otherwise." }
        }
    };
    return [map{
        name: "browser_document_review",
        category: "browser",
        profile: "core-code",
        source: "src/browser_document_tools.sapp",
        read_only: true,
        destructive: false,
        open_world: false,
        input_schema: map{
            type: "object",
            additionalProperties: false,
            properties: map{
                source: map{
                    type: "string",
                    minLength: 24,
                    maxLength: 16384,
                    description: "Strict inert <article><h1>...</h1>...</article> HTML source (<=16384 UTF8bytes) for import_html mode."
                },
                title: map{
                    type: "string",
                    minLength: 1,
                    maxLength: 80,
                    description: "Document title (1..80 printable characters, no control/bidi characters) for create mode."
                },
                blocks: map{
                    type: "array",
                    maxItems: 8,
                    items: block_schema,
                    description: "Up to 8 blocks (h2, p, or a with pb:// local address) for create mode."
                },
                document: map{
                    type: "object",
                    description: "Canonical pblang.ui-document.v1 (pblang-browser-document, 800x816 form, <=8 blocks) for inspect mode."
                },
                targets: map{
                    type: "object",
                    description: "Optional map of pb://slug addresses to local [a-z][a-z0-9-]{0,31}.html filenames (<=16 entries) for standalone CSP-locked HTML page rendering."
                },
                include_page: map{
                    type: "boolean",
                    default: false,
                    description: "When true (or when targets is supplied), render standalone CSP-locked offline HTML page in page_html."
                }
            }
        },
        description: "Create, inspect, or import/export a canonical pblang-browser-document (pblang.ui-document.v1, <=8 blocks of h2/p/a with local pb:// destinations) and strict inert <article><h1>...</h1>...</article> HTML (<=16384 UTF8bytes), with optional standalone CSP-locked (default-src 'none') offline HTML page rendering via stdlib:browser_document.sapp. Never executes scripts, opens sockets, or invokes OS protocol handlers (scripts_executed:false, safe_to_log:false). Serialized arguments and result each <=65536 UTF8bytes."
    }];
}

fn functional_records() {
    let out = [];
    for entry in catalog_entries() {
        push(out, map{
            name: entry.name,
            status: "complete",
            public_mcp: true,
            input_schema: entry.input_schema,
            reason: "Bounded offline browser document creation, strict inert HTML import/export, and CSP-locked page rendering with pre-enumeration cardinality guard",
            evidence_ids: [
                "pb_mcp_browser_document:create_inspect_import_export",
                "pb_mcp_browser_document:csp_page_and_bounds",
                "pb_mcp_browser_document:detached_results",
                "pb_mcp_browser_document:privacy_parity"
            ]
        });
    }
    return out;
}

export implemented_tools, call_browser_document, catalog_entries, functional_records;
