    if map_has(_V32_CACHE, "m") { return _V32_CACHE["m"]; }
    let m = try import("editors/ide/tools/ai/pbai_pcc_omni_8m_v32.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_pcc_omni_8m_v32.sapp") catch nil; }
