// Native pblang network and IoT tool plans.
//
// These handlers validate inputs and return bounded command/protocol plans.
// They do not open sockets, scan networks, write serial/GPIO state, or touch
// hardware directly.

let sec = import("security.sapp");

let NET_TOOLS = [
    "net_arp_scan", "net_bandwidth_test", "net_bluetooth_scan",
    "net_dns_lookup", "net_dns_zone_transfer", "net_http_benchmark",
    "net_modbus_read", "net_mqtt_publish", "net_mqtt_subscribe",
    "net_nmap_quick", "net_packet_capture", "net_ping", "net_port_scan",
    "net_serial_list", "net_serial_read", "net_serial_send",
    "net_sftp_download", "net_sftp_upload", "net_ssh_exec",
    "net_ssl_grade", "net_tls_inspect", "net_traceroute",
    "net_vpn_status", "net_wake_on_lan", "net_whois", "net_wifi_scan",
];

let IOT_TOOLS = [
    "iot_can_bus_read", "iot_device_inventory", "iot_gpio_read",
    "iot_gpio_write", "iot_i2c_scan", "iot_serial_read",
    "iot_serial_write", "iot_sms_send",
];

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _s(args, key, fallback = "") {
    return str(try args[key] catch fallback);
}

fn _safe_word(value, fallback = "") {
    let s = str(value);
    if s == "" { return fallback; }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-/@";
    for i len(s) {
        if not str_contains(allowed, str_slice(s, i, i + 1)) { throw "unsafe token: " + s; }
    }
    return s;
}

fn _safe_host(value) {
    let host = _safe_word(value, "");
    if host == "" { return ""; }
    let h = str_lower(host);
    return h;
}

fn _private_host(host) {
    let h = str_lower(str(host));
    if h == "localhost" or h == "127.0.0.1" or h == "::1" { return true; }
    if str_starts_with(h, "10.") { return true; }
    if str_starts_with(h, "192.168.") { return true; }
    if str_starts_with(h, "169.254.") { return true; }
    if str_starts_with(h, "172.") {
        let parts = str_split(h, ".");
        if len(parts) >= 2 {
            let n = parse_number(parts[1]);
            if n >= 16 and n <= 31 { return true; }
        }
    }
    return false;
}

fn _gate(kind) {
    return map{
        blocked: sec.is_public_profile(),
        profile: sec.network_profile(),
        requires: ["trusted/local-power profile", "terminal or native protocol executor", kind + " allowlist"],
    };
}

fn _result(tool, family, target, program, argv, extra = nil) {
    if extra == nil { extra = map{}; }
    return map{
        ok: true,
        tool: tool,
        family: family,
        executed: false,
        target: target,
        program: program,
        argv: argv,
        gate: _gate(program),
        extra: extra,
    };
}

fn net_tool(tool, args) {
    if args == nil { args = map{}; }
    let host = _safe_host(_s(args, "host", _s(args, "target", _s(args, "domain", ""))));
    let iface = _safe_word(_s(args, "interface", _s(args, "iface", "")), "");
    if tool == "net_ping" {
        return _result(tool, "net", host, "ping", ["ping", "-c", str(sec.clamp(try args.count catch 4, 1, 20)), host], map{ private_host: _private_host(host) });
    }
    if tool == "net_dns_lookup" {
        return _result(tool, "net", host, "dig", ["dig", host], map{ record_types: try args.record_types catch ["A", "AAAA"] });
    }
    if tool == "net_dns_zone_transfer" {
        return _result(tool, "net", host, "dig", ["dig", "AXFR", host], map{ high_risk: true, reason: "AXFR should only be attempted against domains you control" });
    }
    if tool == "net_tls_inspect" or tool == "net_ssl_grade" {
        let port = sec.clamp(try args.port catch 443, 1, 65535);
        return _result(tool, "net", host, "openssl", ["openssl", "s_client", "-connect", host + ":" + str(port), "-servername", host], map{ port: port });
    }
    if tool == "net_whois" {
        return _result(tool, "net", host, "whois", ["whois", host], map{});
    }
    if tool == "net_traceroute" {
        return _result(tool, "net", host, "traceroute", ["traceroute", host], map{});
    }
    if tool == "net_port_scan" or tool == "net_nmap_quick" {
        let start_port = sec.clamp(try args.start_port catch 1, 1, 65535);
        let end_port = sec.clamp(try args.end_port catch try args.port catch 1024, 1, 65535);
        return _result(tool, "net", host, "nmap", ["nmap", "-T3", "-p", str(start_port) + "-" + str(end_port), host], map{ start_port: start_port, end_port: end_port, private_host: _private_host(host) });
    }
    if tool == "net_http_benchmark" {
        let url = _s(args, "url", "");
        return _result(tool, "net", url, "wrk", ["wrk", "-t", "1", "-c", str(sec.clamp(try args.connections catch 10, 1, 1000)), "-d", str(sec.clamp(try args.seconds catch 10, 1, 300)) + "s", url], map{ load_test: true });
    }
    if tool == "net_bandwidth_test" {
        return _result(tool, "net", host, "iperf3", ["iperf3", "-c", host], map{});
    }
    if tool == "net_arp_scan" {
        return _result(tool, "net", iface, "arp-scan", ["arp-scan", if iface == "" { "--localnet" } else { "--interface=" + iface }], map{ local_network_only: true });
    }
    if tool == "net_wifi_scan" {
        return _result(tool, "net", iface, "nmcli", ["nmcli", "dev", "wifi", "list"], map{});
    }
    if tool == "net_bluetooth_scan" {
        return _result(tool, "net", "", "bluetoothctl", ["bluetoothctl", "scan", "on"], map{});
    }
    if tool == "net_packet_capture" {
        return _result(tool, "net", iface, "tcpdump", ["tcpdump", "-i", iface, "-c", str(sec.clamp(try args.count catch 100, 1, 100000))], map{ packet_count: sec.clamp(try args.count catch 100, 1, 100000) });
    }
    if tool == "net_vpn_status" {
        return _result(tool, "net", "", "ip", ["ip", "addr"], map{ heuristic: "look for tun/wg/proton/tailscale interfaces" });
    }
    if tool == "net_wake_on_lan" {
        return _result(tool, "net", _s(args, "mac", ""), "wakeonlan", ["wakeonlan", _safe_word(_s(args, "mac", ""), "")], map{ broadcast: _s(args, "broadcast", "") });
    }
    if tool == "net_mqtt_publish" or tool == "net_mqtt_subscribe" {
        let topic = _safe_word(_s(args, "topic", ""), "");
        let broker = _safe_host(_s(args, "broker", host));
        let action = if tool == "net_mqtt_publish" { "pub" } else { "sub" };
        return _result(tool, "net", broker, "mosquitto_" + action, ["mosquitto_" + action, "-h", broker, "-t", topic], map{ topic: topic, payload_bytes: len(_s(args, "message", _s(args, "payload", ""))) });
    }
    if tool == "net_modbus_read" {
        return _result(tool, "net", host, "modpoll", ["modpoll", "-m", "tcp", host], map{ register: sec.clamp(try args.register catch 0, 0, 65535), count: sec.clamp(try args.count catch 1, 1, 2000) });
    }
    if tool == "net_serial_list" {
        return _result(tool, "net", "", "serial-enumeration", ["ls", "/dev/tty*"], map{ windows_hint: "COM* ports" });
    }
    if tool == "net_serial_read" or tool == "net_serial_send" {
        let port = _safe_word(_s(args, "port", ""), "");
        return _result(tool, "net", port, "serial", ["serial", port], map{ baud: sec.clamp(try args.baud catch 115200, 300, 4000000), bytes: len(_s(args, "data", "")) });
    }
    if tool == "net_sftp_download" or tool == "net_sftp_upload" {
        let remote = _s(args, "remote_path", "");
        let local = sec.safe_rel_path(_s(args, "local_path", "download.bin"), "download.bin");
        return _result(tool, "net", host, "sftp", ["sftp", host], map{ remote_path: remote, local_path: local, transfer: tool });
    }
    if tool == "net_ssh_exec" {
        return _result(tool, "net", host, "ssh", ["ssh", host, _s(args, "command", "")], map{ command_chars: len(_s(args, "command", "")), remote_execution: true });
    }
    return nil;
}

fn iot_tool(tool, args) {
    if args == nil { args = map{}; }
    if tool == "iot_device_inventory" {
        return _result(tool, "iot", "", "inventory", ["lsusb", "&&", "ls", "/dev/tty*"], map{ buses: ["usb", "serial", "i2c", "gpio"] });
    }
    if tool == "iot_i2c_scan" {
        let bus = sec.clamp(try args.bus catch 1, 0, 255);
        return _result(tool, "iot", "i2c-" + str(bus), "i2cdetect", ["i2cdetect", "-y", str(bus)], map{ bus: bus });
    }
    if tool == "iot_can_bus_read" {
        let iface = _safe_word(_s(args, "interface", "can0"), "can0");
        return _result(tool, "iot", iface, "candump", ["candump", "-n", str(sec.clamp(try args.count catch 20, 1, 10000)), iface], map{ count: sec.clamp(try args.count catch 20, 1, 10000) });
    }
    if tool == "iot_gpio_read" or tool == "iot_gpio_write" {
        let pin = sec.clamp(try args.pin catch 0, 0, 10000);
        return _result(tool, "iot", "gpio" + str(pin), "gpio", ["gpio", if tool == "iot_gpio_read" { "read" } else { "write" }, str(pin)], map{ pin: pin, value: try args.value catch nil });
    }
    if tool == "iot_serial_read" or tool == "iot_serial_write" {
        let port = _safe_word(_s(args, "port", ""), "");
        return _result(tool, "iot", port, "serial", ["serial", port], map{ baud: sec.clamp(try args.baud catch 115200, 300, 4000000), bytes: len(_s(args, "data", "")) });
    }
    if tool == "iot_sms_send" {
        let port = _safe_word(_s(args, "port", ""), "");
        return _result(tool, "iot", port, "gammu", ["gammu", "--sendsms", "TEXT", _s(args, "to", "")], map{ to: _s(args, "to", ""), message_bytes: len(_s(args, "message", "")) });
    }
    return nil;
}

fn call_net_iot(tool, args) {
    if _contains(NET_TOOLS, tool) { return net_tool(tool, args); }
    if _contains(IOT_TOOLS, tool) { return iot_tool(tool, args); }
    return nil;
}

fn implemented_tools() {
    let out = [];
    for i len(NET_TOOLS) { out[len(out)] = NET_TOOLS[i]; }
    for i len(IOT_TOOLS) { out[len(out)] = IOT_TOOLS[i]; }
    return out;
}

export implemented_tools, call_net_iot, net_tool, iot_tool;
