// Native pblang translations for simple consensus proposal tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let sec = import("src/security.sapp");

let CONSENSUS_PATH = ".mint-mcp/consensus.jsonl";

fn _now_ms() { return try now_ms() catch try clock() catch 0; }

fn _rows() {
    let raw = try FS.read(CONSENSUS_PATH) catch "";
    let lines = str_split(raw, "\n");
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if t != "" {
            let v = try JSON.parse(t) catch nil;
            if v != nil { out[len(out)] = v; }
        }
    }
    return out;
}

fn _append(row) {
    sec.require_trusted("consensus write");
    FS.mkdirs(".mint-mcp");
    FS.append(CONSENSUS_PATH, JSON.stringify(row) + "\n");
    return row;
}

fn _proposal(id) {
    let rows = _rows();
    let p = nil;
    for i len(rows) {
        if str(try rows[i].proposal_id catch "") == str(id) {
            if (try rows[i].event catch "") == "proposal" { p = rows[i]; }
            if (try rows[i].event catch "") == "close" and p != nil { p.closed = true; }
        }
    }
    return p;
}

fn consensus_propose(args) {
    let id = "proposal-" + str(_now_ms()) + "-" + str(len(_rows()) + 1);
    let row = map{
        event: "proposal",
        proposal_id: id,
        ts_ms: _now_ms(),
        from_agent: try args.from_agent catch "pblang-agent",
        title: try args.title catch try args.question catch "proposal",
        body: try args.body catch "",
        options: try args.options catch ["yes", "no"],
        closed: false,
    };
    return _append(row);
}

fn consensus_vote(args) {
    let id = str(try args.proposal_id catch try args.id catch "");
    let p = _proposal(id);
    if p == nil { return map{ ok: false, error: "proposal not found", proposal_id: id }; }
    if (try p.closed catch false) == true { return map{ ok: false, error: "proposal is closed", proposal_id: id }; }
    let row = map{
        event: "vote",
        proposal_id: id,
        ts_ms: _now_ms(),
        agent: try args.agent catch try args.from_agent catch "pblang-agent",
        option: try args.option catch try args.vote catch "",
        reason: try args.reason catch "",
    };
    return _append(row);
}

fn consensus_tally(args) {
    let id = str(try args.proposal_id catch try args.id catch "");
    let rows = _rows();
    let votes_by_agent = map{};
    let closed = false;
    let proposal = nil;
    for i len(rows) {
        if str(try rows[i].proposal_id catch "") == id {
            if (try rows[i].event catch "") == "proposal" { proposal = rows[i]; }
            if (try rows[i].event catch "") == "close" { closed = true; }
            if (try rows[i].event catch "") == "vote" {
                votes_by_agent[str(try rows[i].agent catch "")] = rows[i].option;
            }
        }
    }
    let counts = map{};
    let agents = map_keys(votes_by_agent);
    for i len(agents) {
        let opt = str(votes_by_agent[agents[i]]);
        let cur = try counts[opt] catch 0;
        counts[opt] = cur + 1;
    }
    return map{ proposal_id: id, proposal: proposal, closed: closed, votes: counts, participants: len(agents) };
}

fn consensus_list(args) {
    let rows = _rows();
    let proposals = [];
    for i len(rows) {
        if (try rows[i].event catch "") == "proposal" {
            let t = consensus_tally(map{ proposal_id: rows[i].proposal_id });
            if t.closed != true { proposals[len(proposals)] = t; }
        }
    }
    return proposals;
}

fn consensus_close(args) {
    let id = str(try args.proposal_id catch try args.id catch "");
    let row = map{ event: "close", proposal_id: id, ts_ms: _now_ms(), by: try args.by catch try args.from_agent catch "pblang-agent" };
    _append(row);
    return consensus_tally(map{ proposal_id: id });
}

fn call_consensus(tool, args) {
    if args == nil { args = map{}; }
    if tool == "consensus_propose" { return consensus_propose(args); }
    if tool == "consensus_vote" { return consensus_vote(args); }
    if tool == "consensus_tally" { return consensus_tally(args); }
    if tool == "consensus_list" { return consensus_list(args); }
    if tool == "consensus_close" { return consensus_close(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "consensus_propose",
        "consensus_vote",
        "consensus_tally",
        "consensus_list",
        "consensus_close",
    ];
}

export implemented_tools, call_consensus,
       consensus_propose, consensus_vote, consensus_tally,
       consensus_list, consensus_close;
