// Session-local maintenance for the retained VM: reference counting releases
// values, but its weak container registry is pruned only by gc_collect().
// Run at completed loop/request boundaries, never inside a native input effect.
fn new() {
    let state = map{ remaining: 256 };
    fn step() {
        state.remaining = state.remaining - 1;
        if state.remaining > 0 { return false; }
        gc_collect();
        state.remaining = 256;
        return true;
    }
    return map{ step: step };
}
export new;
