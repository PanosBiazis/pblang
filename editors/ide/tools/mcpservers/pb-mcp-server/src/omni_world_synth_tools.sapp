let _V25_CACHE = map{};

fn _v25() {
    if map_has(_V25_CACHE, "m") { return _V25_CACHE["m"]; }
    let m = try import("editors/ide/tools/ai/pbai_omni_supremacy_v25.sapp") catch nil;
    if m == nil { m = try import("../../../ai/pbai_omni_supremacy_v25.sapp") catch nil; }
    if m == nil { m = try import("../pblang/editors/ide/tools/ai/pbai_omni_supremacy_v25.sapp") catch nil; }
    if m == nil { m = try import("../../pblang/editors/ide/tools/ai/pbai_omni_supremacy_v25.sapp") catch nil; }
    _V25_CACHE["m"] = m;
    return m;
}

fn implemented_tools() {
    return [
        "mcp_open_world_65536_theorem_hypergraph_atlas",
        "mcp_whitebox_12model_oss_procrustes_absorber",
        "mcp_streaming_24gbs_mdl_50x_info_extractor",
