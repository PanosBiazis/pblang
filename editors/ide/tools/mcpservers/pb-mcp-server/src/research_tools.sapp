// Review caller-supplied observations; shared PBLang owns all mathematics.
let WINDOWS=import("stdlib:research_windows.sapp");
let SERIAL=import("stdlib:serialization.sapp");
let MAX_BYTES=262144;

fn call_research(tool,args) {
    if tool!="research_windows_review" {return nil;}
    if type(args)!="map" or len(args)!=1 or not map_has(args,"review_json") {
        throw "research review: invalid arguments";
    }
    let text=args.review_json;
    if type(text)!="string" or len(text)>MAX_BYTES {throw "research review: invalid arguments";}
    let parsed=SERIAL.parse_safe(text,"json",map{max_input_bytes:MAX_BYTES,max_output_bytes:MAX_BYTES,
        max_depth:8,max_items:4096,max_lines:8192,max_line_bytes:MAX_BYTES,
        strict:true,reject_duplicate_keys:true});
    if not parsed.ok {throw "research review: invalid document";}
    let document=parsed.value;
    if type(document)!="map" or len(document)!=3 or not map_has(document,"spec")
        or not map_has(document,"rows") or not map_has(document,"grid") {
        throw "research review: invalid document";
    }
    // All rows validate before partitioning, even outside the grid. Replace
    // shared validation errors with a fixed diagnostic; never return input.
    let out=try WINDOWS.review(document.spec,document.rows,document.grid) catch nil;
    if out==nil {throw "research review: invalid observations or grid";}
    out.data_source="caller_supplied";
    out.authoritative=false;
    out.effects_performed=false;
    out.permission_granted=false;
    out.native_pblang=true;
    return out;
}

fn implemented_tools() {return ["research_windows_review"];}

fn catalog_entries() {
    let schema=map{type:"object",properties:map{
        review_json:map{type:"string",maxLength:MAX_BYTES,
            description:"Strict JSON object with exactly spec, rows, grid. spec: value_unit, summary_unit, value_mode (absolute/difference), time_unit, timebase (relative). rows: up to256 exact {subject:integer1..64,time:finite0..1e9,value:null|finite+/-1e9}. grid: exact {start:finite0..1e9,duration:finite>0..1e9,count:integer1..32}. Time is in spec.time_unit; strictly increasing per subject."}},
        required:["review_json"],additionalProperties:false};
    return [map{name:"research_windows_review",category:"research",profile:"core-code",
        read_only:true,destructive:false,open_world:false,source:"src/research_tools.sapp",
        description:"Review caller-supplied one-variable research observations in up to32 contiguous relative-time windows using shared PBLang validation, unit conversion and summaries. Strict JSON up to262144 UTF-8 bytes, at most256 rows. Returns aggregate statistics, relative grid boundaries and empty/all_missing/partial/observed states; no raw rows, subject IDs or individual observation times. Aggregates may be sensitive: safe_to_log:false. No acquisition, file/network/device/model access, monitoring, scientific-validity claim or permission grant.",
        input_schema:schema}];
}

fn functional_records() {
    let entry=catalog_entries()[0];
    return [map{name:entry.name,status:"complete",public_mcp:true,input_schema:entry.input_schema,
        reason:"bounded caller-supplied window statistics through the canonical shared PBLang review; no acquisition or scientific authority",
        evidence_ids:["pb_mcp_research:canonical","pb_mcp_research:bounds-privacy","pb_mcp_research:protocol-parity","pb_mcp_research:source-hidden-transport"]}];
}

export call_research,implemented_tools,catalog_entries,functional_records;
