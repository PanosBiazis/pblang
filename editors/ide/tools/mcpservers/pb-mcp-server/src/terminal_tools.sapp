// Native pblang translations for tightly-gated terminal/GitHub/GitLab helpers.

let sec = import("security.sapp");

fn _clip(s, max_chars) {
    max_chars = sec.clamp(max_chars, 1, 120000);
    s = str(s);
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _safe_word(value) {
    let s = str(value);
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-";
    if s == "" { throw "program is required"; }
    for i len(s) {
        if not str_contains(allowed, str_slice(s, i, i + 1)) { throw "unsafe program name: " + s; }
    }
    return s;
}

fn _enabled() {
    return sec.bool_env("MINT_TERMINAL_ENABLE", false) or sec.bool_env("PB_TERMINAL_ENABLE", false);
}

fn _allowlist() {
    let raw = try env_get("MINT_TERMINAL_ALLOW") catch try env_get("PB_TERMINAL_ALLOW") catch "";
    return str_split(str(raw), ",");
}

fn _allowed(program) {
    let allow = _allowlist();
    for i len(allow) {
        if str_trim(allow[i]) == program { return true; }
    }
    return false;
}

fn _guard(program) {
    program = _safe_word(program);
    if not _enabled() { return map{ ok: false, blocked: true, error: "terminal tools require MINT_TERMINAL_ENABLE=1 or PB_TERMINAL_ENABLE=1", program: program }; }
    if not _allowed(program) { return map{ ok: false, blocked: true, error: "program is not in MINT_TERMINAL_ALLOW/PB_TERMINAL_ALLOW", program: program }; }
    return map{ ok: true, program: program };
}

fn _run(cmd, max_chars) {
    let out = try exec(cmd) catch nil;
    if out == nil { return map{ ok: false, command: cmd, stdout: "", error: "command failed or unavailable" }; }
    return map{ ok: true, command: cmd, stdout: _clip(out, max_chars) };
}

fn terminal_which(args) {
    if args == nil { args = map{}; }
    let program = _safe_word(try args.program catch try args.name catch "");
    let g = _guard(program);
    if g.ok != true { return g; }
    return _run("command -v " + program, try args.max_chars catch 40000);
}

fn terminal_program_version(args) {
    if args == nil { args = map{}; }
    let program = _safe_word(try args.program catch try args.name catch "");
    let g = _guard(program);
    if g.ok != true { return g; }
    let r = _run(program + " --version", try args.max_chars catch 40000);
    if r.ok == true and str_trim(r.stdout) != "" { return r; }
    r = _run(program + " -V", try args.max_chars catch 40000);
    if r.ok == true and str_trim(r.stdout) != "" { return r; }
    return _run(program + " version", try args.max_chars catch 40000);
}

fn gh_pr_list(args) {
    if args == nil { args = map{}; }
    let g = _guard("gh");
    if g.ok != true { return g; }
    let limit = sec.clamp(try args.limit catch 20, 1, 100);
    return _run("gh pr list --limit " + str(limit), try args.max_chars catch 80000);
}

fn gh_pr_view(args) {
    if args == nil { args = map{}; }
    let g = _guard("gh");
    if g.ok != true { return g; }
    let number = sec.clamp(try args.number catch try args.pr catch 0, 1, 1000000);
    return _run("gh pr view " + str(number), try args.max_chars catch 80000);
}

fn glab_mr_list(args) {
    if args == nil { args = map{}; }
    let g = _guard("glab");
    if g.ok != true { return g; }
    let limit = sec.clamp(try args.limit catch 20, 1, 100);
    return _run("glab mr list --per-page " + str(limit), try args.max_chars catch 80000);
}

fn glab_mr_show(args) {
    if args == nil { args = map{}; }
    let g = _guard("glab");
    if g.ok != true { return g; }
    let iid = sec.clamp(try args.iid catch try args.number catch 0, 1, 1000000);
    return _run("glab mr view " + str(iid), try args.max_chars catch 80000);
}

fn _argv(args) {
    let arr = try args.argv catch try args.args catch [];
    let out = [];
    for i sec.clamp(len(arr), 0, 100) { out[len(out)] = str(arr[i]); }
    return out;
}

fn terminal_run(args) {
    if args == nil { args = map{}; }
    let program = _safe_word(try args.program catch try args.cmd catch "");
    let g = _guard(program);
    let argv = _argv(args);
    if g.ok != true {
        return map{ ok: true, executed: false, blocked: true, program: program, argv: argv, gate: g };
    }
    return map{
        ok: true,
        executed: false,
        blocked: false,
        program: program,
        argv: argv,
        cwd: sec.safe_rel_path(try args.cwd catch ".", "."),
        reason: "terminal_run execution remains a planned pblang port step; terminal_which/version are the only native exec probes",
    };
}

fn terminal_run_stdin(args) {
    if args == nil { args = map{}; }
    let base = terminal_run(args);
    base.stdin_bytes = len(str(try args.stdin_text catch ""));
    base.stdin_path = sec.safe_rel_path(try args.stdin_path catch "", "");
    base.tool = "terminal_run_stdin";
    return base;
}

fn ollama_list_models(args) {
    if args == nil { args = map{}; }
    let g = _guard("ollama");
    if g.ok != true {
        return map{ ok: true, executed: false, blocked: true, program: "ollama", argv: ["list"], gate: g, models: [] };
    }
    return map{ ok: true, executed: false, blocked: false, program: "ollama", argv: ["list"], models: [], reason: "model listing is planned until terminal_run output parsing is ported" };
}

fn call_terminal(tool, args) {
    if tool == "terminal_which" { return terminal_which(args); }
    if tool == "terminal_program_version" { return terminal_program_version(args); }
    if tool == "terminal_run" { return terminal_run(args); }
    if tool == "terminal_run_stdin" { return terminal_run_stdin(args); }
    if tool == "ollama_list_models" { return ollama_list_models(args); }
    if tool == "gh_pr_list" { return gh_pr_list(args); }
    if tool == "gh_pr_view" { return gh_pr_view(args); }
    if tool == "glab_mr_list" { return glab_mr_list(args); }
    if tool == "glab_mr_show" { return glab_mr_show(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "terminal_which",
        "terminal_program_version",
        "terminal_run",
        "terminal_run_stdin",
        "ollama_list_models",
        "gh_pr_list",
        "gh_pr_view",
        "glab_mr_list",
        "glab_mr_show",
    ];
}

export implemented_tools, call_terminal,
       terminal_which, terminal_program_version, terminal_run,
       terminal_run_stdin, ollama_list_models, gh_pr_list, gh_pr_view,
       glab_mr_list, glab_mr_show;
