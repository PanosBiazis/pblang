// pblang-native pb-mcp-server entrypoint.
//
// Examples:
//   pblang run main.sapp -- status
//   pblang run main.sapp -- tools
//   pblang run main.sapp -- call read_file request.json
//   pblang run main.sapp -- serve 8090

let JSON = import("stdlib:json.sapp");
let _MAIN_MODS = map{};

fn _main_mod(name) {
    if map_has(_MAIN_MODS, name) { return _MAIN_MODS[name]; }
    let m = try import("src/" + name) catch nil;
    if m == nil { m = import("editors/ide/tools/mcpservers/pb-mcp-server/src/" + name); }
    _MAIN_MODS[name] = m;
    return m;
}

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _read_json(path) {
    if path == nil or path == "" { return map{}; }
    return try JSON.parse(fs_read(path)) catch map{};
}

fn _print_json(v) {
    print JSON.stringify(v);
}

fn main() {
    let cmd = _arg(0, "status");
    if cmd == "status" {
        _print_json(_main_mod("catalog.sapp").status());
        return;
    }
    if cmd == "tools" {
        _print_json(_main_mod("catalog.sapp").tool_catalog());
        return;
    }
    if cmd == "implemented" {
        _print_json(_main_mod("catalog.sapp").implemented_catalog());
        return;
    }
    if cmd == "search" {
        _print_json(_main_mod("catalog.sapp").search_tools(_arg(1, "")));
        return;
    }
    if cmd == "call" {
        let tool = _arg(1, "");
        let req = _read_json(_arg(2, ""));
        _print_json(_main_mod("router.sapp").call(tool, req));
        return;
    }
    if cmd == "telemetry" {
        _print_json(_main_mod("router.sapp").router_telemetry());
        return;
    }
    if cmd == "selftest" {
        let r = _main_mod("router.sapp");
        let st = _main_mod("catalog.sapp").status();
        let pbai_v5 = r.call("pbai_core_44module_inventory_and_health", map{});
        let pbai_v6 = r.call("pbai_v6_full_ecosystem_status", map{});
        let pbai_v7 = r.call("pbai_v7_unified_ide_ai_mcp_status", map{});
        let pbai_v8 = r.call("pbai_v8_omnimodal_frontier_status", map{});
        let pbai_v9 = r.call("pbai_v9_supremacy_status", map{});
        let pbai_v10 = r.call("pbai_v10_quantum_leap_status", map{});
        _print_json(map{
            ok: st.generated_tool_count == 1064 and st.native_catalog_tool_count == 1064 and pbai_v5.ok == true and pbai_v6.ok == true and pbai_v7.ok == true and pbai_v8.ok == true and pbai_v9.ok == true and pbai_v10.ok == true,
            generated_tool_count: st.generated_tool_count,
            native_catalog_tool_count: st.native_catalog_tool_count,
            catalog_completion_percent: st.catalog_completion_percent,
            pbai_v5_ok: pbai_v5.ok,
            pbai_v6_ok: pbai_v6.ok,
            pbai_v7_ok: pbai_v7.ok,
            pbai_v8_ok: pbai_v8.ok,
            pbai_v9_ok: pbai_v9.ok,
            pbai_v10_ok: pbai_v10.ok,
            router_telemetry: r.router_telemetry()
        });
        return;
    }
    if cmd == "serve" {
        let port = _arg(1, "8090");
        _main_mod("server.sapp").serve("127.0.0.1:" + str(port));
        return;
    }
    _print_json(map{
        ok: false,
        error: "unknown command: " + cmd,
        commands: ["status", "tools", "implemented", "search", "call", "telemetry", "selftest", "serve"],
    });
}

main();
