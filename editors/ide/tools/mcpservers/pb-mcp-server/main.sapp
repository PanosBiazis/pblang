// pblang-native pb-mcp-server entrypoint.
//
// Examples:
//   pblang run main.sapp -- status
//   pblang run main.sapp -- tools
//   pblang run main.sapp -- call read_file request.json
//   pblang run main.sapp -- serve 8090

let JSON = import("stdlib:json.sapp");
let _MAIN_MODS = map{};

fn _main_mod(name) {
    if map_has(_MAIN_MODS, name) { return _MAIN_MODS[name]; }
    let m = try import("src/" + name) catch nil;
    if m == nil { m = try import("tools/mcp-servers/pb-mcp-server/src/" + name) catch nil; }
    if m == nil { m = import("editors/ide/tools/mcpservers/pb-mcp-server/src/" + name); }
    _MAIN_MODS[name] = m;
    return m;
}

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _read_json(path) {
    if path == nil or path == "" { return map{}; }
    return try JSON.parse(fs_read(path)) catch map{};
}

fn _print_json(v) {
    print JSON.stringify(v);
}

fn main() {
    let cmd = _arg(0, "status");
    if cmd == "status" {
        _print_json(_main_mod("catalog.sapp").status());
        return;
    }
    if cmd == "tools" {
        _print_json(_main_mod("catalog.sapp").tool_catalog());
        return;
    }
    if cmd == "implemented" {
        _print_json(_main_mod("catalog.sapp").implemented_catalog());
        return;
    }
    if cmd == "search" {
        _print_json(_main_mod("catalog.sapp").search_tools(_arg(1, "")));
        return;
    }
    if cmd == "call" {
        let tool = _arg(1, "");
        let req = _read_json(_arg(2, ""));
        _print_json(_main_mod("router.sapp").call(tool, req));
        return;
    }
    if cmd == "telemetry" {
        _print_json(_main_mod("router.sapp").router_telemetry());
        return;
    }
    if cmd == "selftest" {
        let r = _main_mod("router.sapp");
        let st = _main_mod("catalog.sapp").status();
        let pbai_v5 = r.call("pbai_core_44module_inventory_and_health", map{});
        let pbai_v6 = r.call("pbai_v6_full_ecosystem_status", map{});
        let pbai_v7 = r.call("pbai_v7_unified_ide_ai_mcp_status", map{});
        let pbai_v8 = r.call("pbai_v8_omnimodal_frontier_status", map{});
        let pbai_v9 = r.call("pbai_v9_supremacy_status", map{});
        let pbai_v10 = r.call("pbai_v10_quantum_leap_status", map{});
        let pbai_v11 = r.call("pbai_v11_hyper_autonomous_status", map{});
        let zh_shield = r.call("pbai_zero_hallucination_epistemic_truth_shield", map{});
        let pbai_v12 = r.call("pbai_v12_smart_idle_resource_status", map{});
        let idle_fsm = r.call("pbai_smart_idle_state_machine_controller", map{});
        let pbai_v13 = r.call("pbai_v13_biological_living_and_training_status", map{});
        let bio_growth = r.call("pbai_ontogenetic_biological_growth_and_neurogenesis", map{});
        let pbai_v14 = r.call("pbai_v14_quad_ecosystem_and_meta_evolution_status", map{});
        let quad_parity = r.call("pbai_quad_ecosystem_parity_and_sync", map{});
        let pbai_v15 = r.call("pbai_v15_hierarchical_multimodel_and_quad_status", map{});
        let tax_v15 = r.call("pbai_arbitrary_depth_category_subcategory_taxonomy", map{});
        let pbai_v16 = r.call("pbai_v16_unified_mcp_and_quad_status", map{});
        let tri_sync = r.call("mcp_tri_instance_convergence_verifier", map{});
        _print_json(map{
            ok: st.generated_tool_count == 1304 and st.native_catalog_tool_count == 1304 and pbai_v5.ok == true and pbai_v6.ok == true and pbai_v7.ok == true and pbai_v8.ok == true and pbai_v9.ok == true and pbai_v10.ok == true and pbai_v11.ok == true and zh_shield.ok == true and pbai_v12.ok == true and idle_fsm.ok == true and pbai_v13.ok == true and bio_growth.ok == true and pbai_v14.ok == true and quad_parity.ok == true and pbai_v15.ok == true and tax_v15.ok == true and pbai_v16.ok == true and tri_sync.ok == true,
            generated_tool_count: st.generated_tool_count,
            native_catalog_tool_count: st.native_catalog_tool_count,
            catalog_completion_percent: st.catalog_completion_percent,
            pbai_v5_ok: pbai_v5.ok,
            pbai_v6_ok: pbai_v6.ok,
            pbai_v7_ok: pbai_v7.ok,
            pbai_v8_ok: pbai_v8.ok,
            pbai_v9_ok: pbai_v9.ok,
            pbai_v10_ok: pbai_v10.ok,
            pbai_v11_ok: pbai_v11.ok,
            zero_hallucination_ok: zh_shield.ok,
            pbai_v12_ok: pbai_v12.ok,
            smart_idle_governor_ok: idle_fsm.ok,
            pbai_v13_ok: pbai_v13.ok,
            biological_living_and_hybrid_training_ok: bio_growth.ok,
            pbai_v14_ok: pbai_v14.ok,
            quad_ecosystem_parity_ok: quad_parity.ok,
            pbai_v15_ok: pbai_v15.ok,
            category_subcategory_taxonomy_v15_ok: tax_v15.ok,
            pbai_v16_ok: pbai_v16.ok,
            tri_instance_mcp_sync_v16_ok: tri_sync.ok,
            router_telemetry: r.router_telemetry()
        });
        return;
    }
    if cmd == "serve" {
        let port = _arg(1, "8090");
        _main_mod("server.sapp").serve("127.0.0.1:" + str(port));
        return;
    }
    _print_json(map{
        ok: false,
        error: "unknown command: " + cmd,
        commands: ["status", "tools", "implemented", "search", "call", "telemetry", "selftest", "serve"],
    });
}

main();
