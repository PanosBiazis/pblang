// pblang-native pb-mcp-server entrypoint.
//
// Examples:
//   pblang run main.sapp -- status
//   pblang run main.sapp -- tools
//   pblang run main.sapp -- call read_file request.json
//   pblang run main.sapp -- serve 8090

let JSON = import("stdlib:json.sapp");
let catalog = import("src/catalog.sapp");
let router = import("src/router.sapp");
let server = import("src/server.sapp");

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _read_json(path) {
    if path == nil or path == "" { return map{}; }
    return try JSON.parse(fs_read(path)) catch map{};
}

fn _print_json(v) {
    print JSON.stringify(v);
}

fn main() {
    let cmd = _arg(0, "status");
    if cmd == "status" {
        _print_json(catalog.status());
        return;
    }
    if cmd == "tools" {
        _print_json(catalog.tool_catalog());
        return;
    }
    if cmd == "implemented" {
        _print_json(catalog.implemented_catalog());
        return;
    }
    if cmd == "search" {
        _print_json(catalog.search_tools(_arg(1, "")));
        return;
    }
    if cmd == "call" {
        let tool = _arg(1, "");
        let req = _read_json(_arg(2, ""));
        _print_json(router.call(tool, req));
        return;
    }
    if cmd == "serve" {
        let port = _arg(1, "8090");
        server.serve("127.0.0.1:" + str(port));
        return;
    }
    _print_json(map{
        ok: false,
        error: "unknown command: " + cmd,
        commands: ["status", "tools", "implemented", "search", "call", "serve"],
    });
}

main();
