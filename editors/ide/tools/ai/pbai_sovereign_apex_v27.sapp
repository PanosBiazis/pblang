        map{ name: "pbai_sovereign_apex_v27.sapp", chars: 28, within_32_char_limit: true },
        map{ name: "holo_theorem_forge_tools.sapp", chars: 29, within_32_char_limit: true },
        map{ name: "tree_jacobi_omni_tools.sapp", chars: 27, within_32_char_limit: true }
