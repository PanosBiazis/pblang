fn _opt_str(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and spec[key] != nil {
        return str(spec[key]);
    }
    return fallback;
}

fn _opt_int(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and spec[key] != nil {
        return int(spec[key]);
    }
    return fallback;
}

fn _opt_float(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and spec[key] != nil {
        return float(spec[key]);
    }
    return fallback;
}

// ----------------------------------------------------------------------------
// 1. SemVer v29.0.0 Governor & Concise Naming Enforcer (<= 32 chars)
// ----------------------------------------------------------------------------
fn evaluate_semver_v29_0_and_concise_naming_governor(spec = nil) {
    let prev_semver = _opt_str(spec, "previous_semver", "28.0.0");
    let curr_semver = _opt_str(spec, "current_semver", "29.0.0");
    let max_len = _opt_int(spec, "max_filename_chars", 32);

    let v29_files = [
        "pbai_tensor_jacobi_1m_v29.sapp",
        "holo_1m_asic_qec_tools.sapp",
        "tensor_jacobi_850_tools.sapp"
    ];

    let all_within_budget = true;
    let longest_len = 0;
    for f in v29_files {
        let l = len(f);
        if l > longest_len {
            longest_len = l;
        }
        if l > max_len {
            all_within_budget = false;
        }
    }

    return map{
        ok: all_within_budget and curr_semver == "29.0.0",
        version: "29.0.0",
        previous_semver: prev_semver,
        current_semver: curr_semver,
        bump_classification: "MAJOR",
        max_filename_chars_budget: max_len,
        longest_v29_filename_chars: longest_len,
        all_v29_filenames_within_budget: all_within_budget,
        synchronized_repositories: ["pblang", "pb-mcp-server", "pbai"],
        v29_module_filenames: v29_files
    };
}

