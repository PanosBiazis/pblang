fn _opt_str(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and spec[key] != nil {
        return str(spec[key]);
    }
    return fallback;
}

fn _opt_int(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and type(spec[key]) == "number" {
        return num_floor(spec[key]);
    }
    return fallback;
}

fn _opt_float(spec, key, fallback) {
    if type(spec) == "map" and map_has(spec, key) and type(spec[key]) == "number" {
        return spec[key] + 0.0;
    }
    return fallback;
}

// ----------------------------------------------------------------------------
// 1. SemVer v30.0.0 Governor & Concise Naming Enforcer (<= 32 chars)
// ----------------------------------------------------------------------------
fn evaluate_semver_v30_0_and_concise_naming_governor(spec = nil) {
    let prev_semver = _opt_str(spec, "previous_semver", "29.0.0");
    let curr_semver = _opt_str(spec, "current_semver", "30.0.0");
    let max_len = _opt_int(spec, "max_filename_chars", 32);

    let v30_files = [
        "pbai_gap_closer_2m_v30.sapp",
        "mmap_2m_fleet_gcp_tools.sapp",
        "omni_960_gap_zero_tools.sapp"
    ];

    let all_within_budget = true;
    let longest_len = 0;
    for f in v30_files {
        let l = len(f);
        if l > longest_len {
            longest_len = l;
        }
        if l > max_len {
            all_within_budget = false;
        }
    }

    return map{
        ok: all_within_budget and curr_semver == "30.0.0",
        version: "30.0.0",
        previous_semver: prev_semver,
        current_semver: curr_semver,
        bump_classification: "MAJOR",
        max_filename_chars_budget: max_len,
        longest_v30_filename_chars: longest_len,
        all_v30_filenames_within_budget: all_within_budget,
        synchronized_repositories: ["pblang", "pb-mcp-server", "pbai"],
        v30_module_filenames: v30_files
    };
}

