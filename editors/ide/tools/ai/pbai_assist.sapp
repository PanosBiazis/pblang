// ============================================================================
// PBAI v38.5.0 — ERGONOMIC DEVELOPER ASSISTANT & AUTONOMOUS AGENT CLI (Pure PBLang)
// Embedded PBLang Edition: Strictly English-Only ("en") + Pure PBLang Code
// Standalone pbAI Edition (--standalone-polyglot): Greek + All 188 Human Languages
// ============================================================================
// Quick CLI Usage:
//   pblang ai "Write a sorting algorithm in PBLang"
//   pblang agent "Build and verify an autonomous data pipeline"
//   pblang ai --code="function sum(arr) { let s = 0; return null; }" "Fix bug"
//   pbai "Γράψε έναν αλγόριθμο ταξινόμησης σε PBLang"
//   pbai --agent "Φτιάξε και επαλήθευσε μια αυτόνομη ροή εργασίας"

let EMB = try import("editors/ide/tools/ai/pbai_embedded_engine.sapp")
    catch (try import("pbai_embedded_engine.sapp")
    catch (try import("../pblang/editors/ide/tools/ai/pbai_embedded_engine.sapp")
    catch import("/media/panosboy/ExtHD/panag/Documents/projects/AAP/products/pblang/editors/ide/tools/ai/pbai_embedded_engine.sapp")));

fn _print_cli_help() {
    print "╭──────────────────────────────────────────────────────────────────────────────────╮";
    print "│ pbAI v38.5.0 · CLI Assistant & 6-Stage Autonomous Agent (100% Pure PBLang)       │";
    print "╰──────────────────────────────────────────────────────────────────────────────────╯";
    print "Embedded PBLang CLI (Strictly English-Only + Pure PBLang):";
    print "  pblang ai \"Write a quicksort and binary search in PBLang\"";
    print "  pblang ai --code=\"function sum(arr) { let s = 0; return null; }\" \"Fix bug\"";
    print "  pblang agent \"Build and verify a fault-tolerant HTTP API service\"";
    print "";
    print "Standalone Polyglot pbAI CLI (Ελληνικά + 188 Human Languages + 24 World Spheres):";
    print "  pbai \"Γεια σου pbAI, εξήγησε τη νευρογένεση και γράψε κώδικα PBLang\"";
    print "  pbai --agent \"Σχεδίασε και επαλήθευσε αυτόνομη ροή επεξεργασίας πινάκων\"";
    print "";
    print "Flags:";
    print "  --agent, -a               Run full 6-Stage Autonomous Agentic Workflow Loop";
    print "  --code=\"...\"              Refactor/repair code snippet into idiomatic Pure PBLang";
    print "  --json, -j                Output raw JSON instead of formatted Terminal UI";
    print "  --embedded-english-only   Force Embedded PBLang mode (Strictly English-Only)";
    print "  --standalone-polyglot     Force Standalone Polyglot mode (Greek + 188 languages)";
    print "  --status                  Print full embedded_pbai_status() JSON";
    print "  --readiness               Print frontier_readiness_assessment() JSON";
}

fn _extract_cli_spec() {
    let a = os_args();
    let start = -1;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    if start < 0 {
        return map{
            mode: "assist",
            edition: "embedded_pblang",
            agent_mode: false,
            json_output: false,
            prompt: "",
            code: ""
        };
    }
    let prompt_parts = [];
    let code_val = "";
    let mode = "assist";
    let edition = "embedded_pblang";
    let agent_mode = false;
    let json_output = false;
    let j = start;
    while j < len(a) {
        let arg = str(a[j]);
        if arg == "--help" or arg == "-h" {
            mode = "help";
        } elif arg == "--readiness" or arg == "--assessment" {
            mode = "readiness";
        } elif arg == "--status" {
            mode = "status";
        } elif arg == "--agent" or arg == "-a" or (j == start and arg == "agent") {
            agent_mode = true;
        } elif arg == "--json" or arg == "-j" {
            json_output = true;
        } elif arg == "--ui" or arg == "--pretty" {
            json_output = false;
        } elif arg == "--standalone-polyglot" or arg == "--polyglot" {
            edition = "standalone_polyglot";
        } elif arg == "--embedded-english-only" or arg == "--embedded" {
            edition = "embedded_pblang";
        } elif str_starts_with(arg, "--code=") {
            code_val = str_slice(arg, len("--code="), len(arg));
        } elif str_starts_with(arg, "--prompt=") {
            prompt_parts[len(prompt_parts)] = str_slice(arg, len("--prompt="), len(arg));
        } else {
            prompt_parts[len(prompt_parts)] = arg;
        }
        j = j + 1;
    }
    let joined_prompt = "";
    let k = 0;
    while k < len(prompt_parts) {
        if k > 0 { joined_prompt = joined_prompt + " "; }
        joined_prompt = joined_prompt + prompt_parts[k];
        k = k + 1;
    }
    return map{
        mode: mode,
        edition: edition,
        agent_mode: agent_mode,
        json_output: json_output,
        prompt: joined_prompt,
        code: code_val
    };
}

fn main() {
    let spec = _extract_cli_spec();
    if spec.mode == "help" {
        _print_cli_help();
        return 0;
    }
    if spec.mode == "readiness" {
        print json_stringify(EMB.frontier_readiness_assessment());
        return 0;
    }
    if spec.mode == "status" {
        print json_stringify(EMB.embedded_pbai_status());
        return 0;
    }
    let res = EMB.assist_developer_interactive(map{
        edition: spec.edition,
        agent_mode: spec.agent_mode,
        prompt: spec.prompt,
        code: spec.code,
        persist_turn: true
    });
    if spec.json_output {
        print json_stringify(res);
    } else {
        print EMB.format_cli_ux_report(res);
    }
    return 0;
}

main();


