// ============================================================================
// PBAI v38.0.0-embedded — ERGONOMIC DEVELOPER ASSISTANT CLI (100% Pure PBLang)
// ============================================================================
// Usage:
//   pblang run editors/ide/tools/ai/pbai_assist.sapp --allow-all -- "Γράψε μου μια συνάρτηση Fibonacci σε PBLang"
//   pblang run editors/ide/tools/ai/pbai_assist.sapp --allow-all -- --code="function f(x) { var y = null; return x; }"
//   pblang run editors/ide/tools/ai/pbai_assist.sapp --allow-all -- --readiness

let EMB = try import("editors/ide/tools/ai/pbai_embedded_engine.sapp")
    catch (try import("pbai_embedded_engine.sapp")
    catch import("../pblang/editors/ide/tools/ai/pbai_embedded_engine.sapp"));

fn _extract_cli_spec() {
    let a = os_args();
    let start = -1;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    if start < 0 {
        return map{ mode: "assist", prompt: "", code: "" };
    }
    let prompt_parts = [];
    let code_val = "";
    let mode = "assist";
    let j = start;
    while j < len(a) {
        let arg = str(a[j]);
        if arg == "--readiness" or arg == "--assessment" {
            mode = "readiness";
        } elif arg == "--status" {
            mode = "status";
        } elif str_starts_with(arg, "--code=") {
            code_val = str_slice(arg, len("--code="), len(arg));
        } elif str_starts_with(arg, "--prompt=") {
            prompt_parts[len(prompt_parts)] = str_slice(arg, len("--prompt="), len(arg));
        } else {
            prompt_parts[len(prompt_parts)] = arg;
        }
        j = j + 1;
    }
    let joined_prompt = "";
    let k = 0;
    while k < len(prompt_parts) {
        if k > 0 { joined_prompt = joined_prompt + " "; }
        joined_prompt = joined_prompt + prompt_parts[k];
        k = k + 1;
    }
    return map{
        mode: mode,
        prompt: joined_prompt,
        code: code_val
    };
}

fn main() {
    let spec = _extract_cli_spec();
    if spec.mode == "readiness" {
        print json_stringify(EMB.frontier_readiness_assessment());
        return 0;
    }
    if spec.mode == "status" {
        print json_stringify(EMB.embedded_pbai_status());
        return 0;
    }
    let res = EMB.assist_developer_interactive(map{
        prompt: spec.prompt,
        code: spec.code,
        persist_turn: true
    });
    print json_stringify(res);
    return 0;
}

main();
