// ============================================================================
// PBAI v38.5.0 — ERGONOMIC DEVELOPER ASSISTANT & AUTONOMOUS AGENT CLI (Pure PBLang)
// Embedded PBLang Edition: Strictly English-Only ("en") + Pure PBLang Code
// Standalone pbAI Edition (--standalone-polyglot): Greek + All 188 Human Languages
// ============================================================================
// Quick CLI Usage:
//   pblang ai "Write a sorting algorithm in PBLang"
//   pblang agent "Build and verify an autonomous data pipeline"
//   pblang ai --code="function sum(arr) { let s = 0; return null; }" "Fix bug"
//   pbai "Γράψε έναν αλγόριθμο ταξινόμησης σε PBLang"
//   pbai --agent "Φτιάξε και επαλήθευσε μια αυτόνομη ροή εργασίας"

let EMB = try import("editors/ide/tools/ai/pbai_embedded_engine.sapp")
    catch (try import("pbai_embedded_engine.sapp")
    catch (try import("../pblang/editors/ide/tools/ai/pbai_embedded_engine.sapp")
    catch import("/media/panosboy/ExtHD/panag/Documents/projects/AAP/products/pblang/editors/ide/tools/ai/pbai_embedded_engine.sapp")));

fn _print_cli_help() {
    print "╭──────────────────────────────────────────────────────────────────────────────────╮";
    print "│ pbAI v38.5.0 · CLI Assistant & 6-Stage Autonomous Agent (100% Pure PBLang)       │";
    print "╰──────────────────────────────────────────────────────────────────────────────────╯";
    print "Embedded PBLang CLI (Strictly English-Only + Pure PBLang):";
    print "  pblang ai \"Write a quicksort and binary search in PBLang\"";
    print "  pblang ai --code=\"function sum(arr) { let s = 0; return null; }\" \"Fix bug\"";
    print "  pblang agent \"Build and verify a fault-tolerant HTTP API service\"";
    print "";
    print "Standalone Organic AI-User Polyglot pbAI CLI (Boot: EN · Unrestricted 188 Languages + 24 World Spheres):";
    print "  pbai                                             # Boots in English (\"en\") Organic AI-User mode";
    print "  pbai \"Explain Shannon entropy in French\"         # Communicates in any language the user wants";
    print "  pbai \"Speak any language you want about physics\" # AI free-choice polyglot expression";
    print "  pbai \"Γεια σου pbAI, εξήγησε τη νευρογένεση και γράψε κώδικα PBLang\"";
    print "  pbai --agent \"Σχεδίασε και επαλήθευσε αυτόνομη ροή επεξεργασίας πινάκων\"";
    print "";
    print "Flags:";
    print "  --build-app=<dir>         Materialize & live-verify a complete 5-file PBLang project on disk (Zero External LLM)";
    print "  --file=<path.sapp>        Read & refactor/fix an existing source file directly from disk";
    print "  --agent, -a               Run full 6-Stage Autonomous Agentic Workflow Loop";
    print "  --lang=<code>             Explicit language selection (en, el, fr, de, es, it, ja, zh, ru, ar, polyglot_free, ...)";
    print "  --polyglot-free           Let Standalone pbAI freely express itself across world languages";
    print "  --code=\"...\"              Refactor/repair code snippet into idiomatic Pure PBLang";
    print "  --json, -j                Output raw JSON instead of formatted Terminal UI";
    print "  --embedded-english-only   Force Embedded PBLang mode (Strictly English-Only)";
    print "  --standalone-polyglot     Force Standalone Polyglot mode (Boot: EN · 188 Unrestricted Languages)";
    print "  --status                  Print full embedded_pbai_status() JSON";
    print "  --readiness               Print frontier_readiness_assessment() JSON";
    print "  --benchmarks              Run & print all 24 Global AI Industry Benchmarks across 9 families";
}

fn _extract_cli_spec() {
    let a = os_args();
    let start = -1;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    if start < 0 {
        return map{
            mode: "assist",
            edition: "embedded_pblang",
            agent_mode: false,
            json_output: false,
            build_app_dir: "",
            file_path: "",
            project_dir: "",
            remove_target: "",
            in_place: false,
            language: "",
            prompt: "",
            code: ""
        };
    }
    let prompt_parts = [];
    let code_val = "";
    let lang_val = "";
    let build_app_dir = "";
    let file_path = "";
    let project_dir = "";
    let remove_target = "";
    let in_place = false;
    let mode = "assist";
    let edition = "embedded_pblang";
    let agent_mode = false;
    let json_output = false;
    let j = start;
    while j < len(a) {
        let arg = str(a[j]);
        if arg == "--help" or arg == "-h" {
            mode = "help";
        } elif arg == "--readiness" or arg == "--assessment" {
            mode = "readiness";
        } elif arg == "--benchmarks" or arg == "--industry-benchmarks" or arg == "--benchmark" {
            mode = "benchmarks";
        } elif arg == "--status" {
            mode = "status";
        } elif arg == "--agent" or arg == "-a" or (j == start and arg == "agent") {
            agent_mode = true;
        } elif arg == "--json" or arg == "-j" {
            json_output = true;
        } elif arg == "--ui" or arg == "--pretty" {
            json_output = false;
        } elif arg == "--in-place" or arg == "-i" {
            in_place = true;
        } elif arg == "--standalone-polyglot" or arg == "--polyglot" {
            edition = "standalone_polyglot";
        } elif arg == "--embedded-english-only" or arg == "--embedded" or arg == "--embedded-pblang" {
            edition = "embedded_pblang";
        } elif arg == "--polyglot-free" or arg == "--free-lang" {
            lang_val = "polyglot_free";
        } elif str_starts_with(arg, "--build-app=") {
            build_app_dir = str_slice(arg, len("--build-app="), len(arg));
            mode = "build_app";
        } elif str_starts_with(arg, "--create-app=") {
            build_app_dir = str_slice(arg, len("--create-app="), len(arg));
            mode = "build_app";
        } elif str_starts_with(arg, "--write-project=") {
            build_app_dir = str_slice(arg, len("--write-project="), len(arg));
            mode = "build_app";
        } elif str_starts_with(arg, "--inspect=") {
            project_dir = str_slice(arg, len("--inspect="), len(arg));
            mode = "inspect_app";
        } elif str_starts_with(arg, "--project=") {
            project_dir = str_slice(arg, len("--project="), len(arg));
            mode = "inspect_app";
        } elif str_starts_with(arg, "--remove=") {
            remove_target = str_slice(arg, len("--remove="), len(arg));
        } elif str_starts_with(arg, "--file=") {
            let fpath = str_slice(arg, len("--file="), len(arg));
            file_path = fpath;
            if not str_contains(fpath, "..") and fs_exists(fpath) {
                code_val = try fs_read(fpath) catch "";
            }
        } elif str_starts_with(arg, "--fix-file=") {
            let fpath2 = str_slice(arg, len("--fix-file="), len(arg));
            file_path = fpath2;
            if not str_contains(fpath2, "..") and fs_exists(fpath2) {
                code_val = try fs_read(fpath2) catch "";
            }
        } elif str_starts_with(arg, "--lang=") {
            lang_val = str_slice(arg, len("--lang="), len(arg));
        } elif str_starts_with(arg, "--language=") {
            lang_val = str_slice(arg, len("--language="), len(arg));
        } elif str_starts_with(arg, "--learn=") {
            mode = "learn";
            prompt_parts[len(prompt_parts)] = str_slice(arg, len("--learn="), len(arg));
        } elif str_starts_with(arg, "--code=") {
            code_val = str_slice(arg, len("--code="), len(arg));
        } elif str_starts_with(arg, "--prompt=") {
            prompt_parts[len(prompt_parts)] = str_slice(arg, len("--prompt="), len(arg));
        } else {
            prompt_parts[len(prompt_parts)] = arg;
        }
        j = j + 1;
    }
    let joined_prompt = "";
    let k = 0;
    while k < len(prompt_parts) {
        if k > 0 { joined_prompt = joined_prompt + " "; }
        joined_prompt = joined_prompt + prompt_parts[k];
        k = k + 1;
    }
    if remove_target != "" {
        if joined_prompt == "" {
            joined_prompt = "remove " + remove_target;
        } else {
            joined_prompt = joined_prompt + " remove " + remove_target;
        }
    }
    return map{
        mode: mode,
        edition: edition,
        agent_mode: agent_mode,
        json_output: json_output,
        build_app_dir: build_app_dir,
        file_path: file_path,
        project_dir: project_dir,
        remove_target: remove_target,
        in_place: in_place,
        language: lang_val,
        prompt: joined_prompt,
        code: code_val
    };
}

fn main() {
    let spec = _extract_cli_spec();
    if spec.mode == "help" {
        _print_cli_help();
        return 0;
    }
    if spec.mode == "readiness" {
        print json_stringify(EMB.frontier_readiness_assessment());
        return 0;
    }
    if spec.mode == "benchmarks" {
        print json_stringify(EMB.run_global_ai_industry_benchmarks());
        return 0;
    }
    if spec.mode == "status" {
        print json_stringify(EMB.embedded_pbai_status());
        return 0;
    }
    if spec.mode == "learn" {
        print json_stringify(EMB.learn_reviewed_lesson_interactive(spec.prompt));
        return 0;
    }
    if spec.mode == "inspect_app" or (spec.file_path != "" and spec.in_place) {
        let insp = EMB.inspect_and_transform_custom_pblang_app(map{
            prompt: spec.prompt,
            code: spec.code,
            file_path: spec.file_path,
            project_dir: spec.project_dir,
            remove_target: spec.remove_target,
            in_place: spec.in_place,
            edition: spec.edition,
            verify_live_run: true
        });
        print json_stringify(insp);
        return 0;
    }
    if spec.mode == "build_app" {
        let proj = EMB.build_and_verify_complete_pblang_project(map{
            prompt: spec.prompt,
            target_dir: spec.build_app_dir,
            write_to_disk: true,
            verify_live_run: true,
            edition: spec.edition
        });
        if spec.json_output {
            print json_stringify(proj);
        } else {
            print EMB.format_cli_ux_report(proj.assistant_result);
            print "┌─ [6] COMPLETE 5-FILE PURE-PBLANG PROJECT MATERIALIZED & LIVE-VERIFIED ON DISK ──";
            print "  ✓ Project Directory : " + proj.target_dir + " (App: " + proj.app_name + ")";
            print "  ✓ Files Materialized: " + json_stringify(proj.files_written);
            print "  ✓ Live Unit Tests   : " + (if proj.live_test_passed { "PASS (" + proj.live_test_stdout + ")" } else { "FAIL" });
            print "  ✓ Live Entrypoint   : " + (if proj.live_main_passed { "PASS (main.sapp exit_code=0)" } else { "FAIL" });
            print "  ✓ External LLM Used : FALSE (100% Zero-External-LLM Pure-PBLang Synthesis)";
        }
        return 0;
    }
    let res = EMB.assist_developer_interactive(map{
        edition: spec.edition,
        agent_mode: spec.agent_mode,
        language: spec.language,
        prompt: spec.prompt,
        code: spec.code,
        persist_turn: true
    });
    if spec.json_output {
        print json_stringify(res);
    } else {
        print EMB.format_cli_ux_report(res);
    }
    return 0;
}

main();


