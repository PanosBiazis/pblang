        ],
        physical_device_transducer_bridges: [
            "Audio_Codec_I2S_ALSA_PipeWire_32bit_384kHz_DAC_ADC",
            "MCU_HIL_Hardware_PWM_R2R_SigmaDelta_DAC_and_16bit_SAR_ADC",
            "SDR_RF_Quadrature_IQ_Modulator_Demodulator_Bridge",
            "Optical_Camera_Photodiode_and_Piezo_Ultrasonic_Sensor_ADC"
