fn evaluate_384khz_digital_analog_and_16_info_control_theorems(spec = nil) {
    let s = if type(spec) == "map" { spec } else { map{} };
    let sample_rate_hz = _num(try s.sample_rate_hz catch nil, 384000.0);
    let bit_depth = _num(try s.bit_depth catch nil, 24);
    let signal_bw_hz = _num(try s.signal_bandwidth_hz catch nil, 96000.0);
    let nyquist_ok = sample_rate_hz >= (2.0 * signal_bw_hz);
    let sqnr_db = 6.02 * bit_depth + 1.76;
    return map{
        ok: nyquist_ok and sqnr_db > 145.0,
        feature_id: "pbai_384khz_digital_analog_and_16_info_control_theorems_v25",
