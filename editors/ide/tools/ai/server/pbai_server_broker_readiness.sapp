// Pure structural projection for the future fixed-method worker broker.
// Caller-provided maps are never treated as trusted runtime evidence.

let FORMAT = "pbai.server.broker-readiness.v1";

fn evaluate(ffi_registry, closure_bundle) {
    let ffi_valid = type(ffi_registry) == "map"
        and (try ffi_registry.ok catch false)
        and (try ffi_registry.format catch "") == "pblang.ffi-tuple-registry.v1"
        and type(try ffi_registry.registry_sha256 catch nil) == "string"
        and regex_match(ffi_registry.registry_sha256, "^[0-9a-f]{64}$")
        and not (try ffi_registry.grants_capability catch true)
        and not (try ffi_registry.loads_libraries catch true)
        and not (try ffi_registry.calls_symbols catch true)
        and not (try ffi_registry.runtime_signature_tuple_enforced catch true)
        and not (try ffi_registry.production_execution_ready catch true);
    let closure_valid = type(closure_bundle) == "map"
        and (try closure_bundle.ok catch false)
        and (try closure_bundle.format catch "") == "pblang.immutable-broker-bundle.v1"
        and type(try closure_bundle.closure_sha256 catch nil) == "string"
        and regex_match(closure_bundle.closure_sha256, "^[0-9a-f]{64}$")
        and (try closure_bundle.lock_verified catch false)
        and (try closure_bundle.immutable_snapshot catch false)
        and (try closure_bundle.descriptor_confined_snapshot catch false)
        and (try closure_bundle.content_hash_algorithm_verified catch false)
        and (try closure_bundle.content_hash_algorithm catch "") == "pblang-package-tree-v2"
        and (try closure_bundle.in_memory_only catch false)
        and not (try closure_bundle.executable catch true)
        and not (try closure_bundle.immutable_runtime_handoff_verified catch true)
        and not (try closure_bundle.runtime_identity_verified catch true)
        and not (try closure_bundle.production_execution_ready catch true);
    return map{ format: FORMAT,
        ffi_contract_structurally_valid: ffi_valid,
        closure_bundle_structurally_valid: closure_valid,
        caller_evidence_trusted: false,
        runtime_signature_tuple_enforced: false,
        immutable_runtime_handoff_verified: false,
        runtime_identity_verified: false,
        hostile_code_sandbox_verified: false,
        authorizes_execution: false,
        production_execution_ready: false,
        server_action_status: 503,
        reason: "trusted-runtime-binder-unavailable" };
}

fn status() { return evaluate(map{}, map{}); }

export FORMAT, evaluate, status;
