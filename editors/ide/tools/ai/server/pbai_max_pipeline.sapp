// tools/pbai_max_pipeline.sapp -- one-command pbAI-Max workflow runner.
//
// Default practical run:
//   pblang run tools/pbai_max_pipeline.sapp
//
// Optional JSON request:
//   pblang run tools/pbai_max_pipeline.sapp -- /tmp/pbai-max-pipeline.json
//
// Request fields:
//   mode: "quick" | "full"
//   output_dir: "checkpoints/pbai-max/students"
//   teacher_path: "checkpoints/pbai-max"
//   train_max: true|false
//   epochs, lr, max_records, n, max_examples, prompt, report_path

let pbai = import("stdlib/pbai.sapp");

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _request(path) {
    if path == "" { return map{}; }
    return try json_parse(fs_read(path)) catch map{};
}

fn _s(req, key, fallback = "") {
    if key == "mode" { return try str(req.mode) catch fallback; }
    if key == "output_dir" { return try str(req.output_dir) catch fallback; }
    if key == "teacher_path" { return try str(req.teacher_path) catch fallback; }
    if key == "prompt" { return try str(req.prompt) catch fallback; }
    if key == "report_path" { return try str(req.report_path) catch fallback; }
    return fallback;
}

fn _num(req, key, fallback) {
    if key == "epochs" { return try req.epochs catch fallback; }
    if key == "lr" { return try req.lr catch fallback; }
    if key == "max_records" { return try req.max_records catch fallback; }
    if key == "n" { return try req.n catch fallback; }
    if key == "max_examples" { return try req.max_examples catch fallback; }
    return fallback;
}

fn _bool(req, key, fallback = false) {
    if key == "train_max" { return try req.train_max catch fallback; }
    return fallback;
}

fn _clamp_int(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _pipeline(req) {
    let mode = _s(req, "mode", "quick");
    let output_dir = _s(req, "output_dir", "checkpoints/pbai-max/students");
    let teacher_path = _s(req, "teacher_path", "");
    let prompt = _s(req, "prompt", "Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }");
    let report_path = _s(req, "report_path", "");
    let epochs = _clamp_int(_num(req, "epochs", 1), 1, 4);
    let lr = _num(req, "lr", 0.01);
    if lr <= 0 { lr = 0.01; }
    if lr > 0.05 { lr = 0.05; }
    let max_records = _clamp_int(_num(req, "max_records", 8), 1, 16);
    let n = _clamp_int(_num(req, "n", 8), 1, 24);
    let max_examples = _clamp_int(_num(req, "max_examples", 256), 16, 1280);
    let train_max = _bool(req, "train_max", mode == "full");

    let active_teacher = teacher_path;
    let max_save = nil;
    if train_max {
        if active_teacher == "" { active_teacher = "checkpoints/pbai-max"; }
        max_save = pbai.max_save_checkpoint(active_teacher, 1, 0.02, max_examples);
    }

    let status = pbai.max_status();
    let benchmark = pbai.max_benchmark(active_teacher, n);
    let preview = pbai.max_distillation_preview(active_teacher, max_records, n);
    let saved_family = pbai.max_distill_save_family(output_dir, active_teacher, epochs, lr, max_records, n);
    let summary = pbai.max_distill_family_summary(output_dir);
    let mini_eval = pbai.max_distill_student_eval(output_dir, "pbAI-Mini", max_examples);
    let family_eval = pbai.max_distill_family_eval(output_dir, max_examples);
    let route = pbai.max_distill_route(prompt, output_dir);
    let routed_generation = pbai.max_distill_route_generate(prompt, n, output_dir, [prompt], ["undefined", "nan", "<unk>"]);
    let routed_eval = pbai.max_distill_route_eval(prompt, output_dir, max_examples);

    let curated_teacher_source = try preview.dataset.records[0].teacher_text_source catch "";
    let avg_teacher_chars = try preview.dataset.avg_teacher_chars catch 0.0;
    let checks = map{
        format: "pbai.max.pipeline_checks.v1",
        benchmark_passed: try benchmark.threshold_report.passed catch false,
        saved_family_ok: try saved_family.ok catch false,
        saved_students: try saved_family.student_count catch 0,
        summary_students: try summary.student_count catch 0,
        family_eval_students: try family_eval.student_count catch 0,
        routed_tier_available: try route.available catch false,
        generated_text_nonempty: len(try routed_generation.text catch "") > 0,
        curated_teacher_records: curated_teacher_source == "curated",
        avg_teacher_chars: avg_teacher_chars,
        rich_teacher_data: avg_teacher_chars >= 40,
        teacher_quality_passed: try preview.dataset.teacher_quality.passed catch false,
        teacher_quality_score: try preview.dataset.teacher_quality.avg_score catch 0.0
    };
    checks.ok = checks.benchmark_passed
        and checks.saved_family_ok
        and checks.saved_students == 3
        and checks.summary_students == 3
        and checks.family_eval_students == 3
        and checks.routed_tier_available
        and checks.generated_text_nonempty
        and checks.curated_teacher_records
        and checks.rich_teacher_data
        and checks.teacher_quality_passed;

    let report = map{
        format: "pbai.max.pipeline.v1",
        mode: mode,
        train_max: train_max,
        active_teacher: active_teacher,
        output_dir: output_dir,
        prompt: prompt,
        settings: map{ epochs: epochs, lr: lr, max_records: max_records, n: n, max_examples: max_examples },
        max_save: max_save,
        status: map{
            tier: status.tier,
            params: status.params,
            distillation: status.distillation.implementation_status,
            checkpoint_dir: status.checkpoint_dir
        },
        benchmark: benchmark,
        preview: preview,
        saved_family: saved_family,
        summary: summary,
        mini_eval: mini_eval,
        family_eval: family_eval,
        route: route,
        routed_generation: routed_generation,
        routed_eval: routed_eval,
        checks: checks
    };
    if report_path != "" {
        fs_write(report_path, json_stringify(report));
        report.report_path = report_path;
    }
    return report;
}

fn main() {
    let req = _request(_arg(0, ""));
    print json_stringify(_pipeline(req));
}

main();
