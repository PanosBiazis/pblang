// tools/pbai_api.sapp -- one-shot JSON API bridge for tests/tools.
//
//   pblang run tools/pbai_api.sapp -- respond /tmp/request.json

let REQUEST = import("pbai_api_request.sapp");
let pbai = nil;
let tokmod = nil;
let brain = nil;

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}


fn _prompt(req) { return try str(req.prompt) catch ""; }
fn _text(req) { return try str(req.text) catch _prompt(req); }
fn _expected(req) { return try req.expected catch []; }
fn _forbidden(req) { return try req.forbidden catch ["undefined", "nan", "<unk>"]; }
fn _observed(req) { return try str(req.observed_output) catch ""; }
fn _epochs(req) { return try req.epochs catch 8; }
fn _distill_epochs(req) { return try req.epochs catch 1; }
fn _lr(req) { return try req.lr catch 0.05; }
fn _continue_lr(req) { return try req.lr catch 0.01; }
fn _n(req) { return try req.n catch 80; }
fn _top_k(req) { return try req.top_k catch 3; }
fn _path(req) { return try str(req.path) catch ""; }
fn _source(req) { return try req.source catch nil; }
fn _dataset_options(req) { return try req.dataset_options catch nil; }
fn _teacher_path(req) { return try str(req.teacher_path) catch ""; }
fn _kind(req) { return try str(req.kind) catch ""; }
fn _tier(req) { return try str(req.tier) catch "pbAI-Mini"; }
fn _max_files(req) { return try req.max_files catch 80; }
fn _max_depth(req) { return try req.max_depth catch 4; }
fn _max_examples(req) { return try req.max_examples catch 1280; }

fn _tokenize(prompt) {
    let tok = tokmod.train_default();
    return map{ description: tokmod.describe(tok), ids: tokmod.encode(tok, prompt, true, true), tokens: tokmod.tokenize(tok, prompt, true, true), decoded: tokmod.decode(tok, tokmod.encode(tok, prompt, true, true)) };
}

fn _ok(action, value) { return map{ ok: true, action: action, value: value }; }

// Error envelope: keeps the existing `action`/`value` fields (backward compatible) and
// ADDS `ok: false`, an `error` message, and the `command` that failed so callers get
// request context. No timestamp is added because this file uses no time builtin.
fn _fail(action, message, value) {
    return map{ ok: false, action: action, command: action, error: message, value: value };
}

fn _smart_response(prompt, req) {
    // Request JSON is untrusted. Routing task, capabilities, approval and
    // verifier rules must be derived by the local policy, not supplied by it.
    let smart = pbai.respond_smart(prompt, nil);
    return map{
        format: smart.format, ok: smart.ok,
        response: smart.text, thought: smart.thought, routing: smart.plan,
        evidence: smart.evidence, grounding: smart.grounding,
        expert_plan: smart.expert_plan, verification: smart.verification,
        authorized_for_action: smart.authorized_for_action,
        human_review_required: smart.human_review_required
    };
}

fn main() {
    let action = _arg(0, "status");
    let admission = REQUEST.read_request(_arg(1, ""));
    if not admission.ok {
        // Never echo an untrusted/unknown action or any request field on rejection.
        print json_stringify(map{ok:false,action:"request",command:"request",
            error:admission.error,value:nil});
        return;
    }
    let req = admission.value;
    pbai = import("stdlib/pbai.sapp");
    tokmod = import("../core/pbai_tokenizer.sapp");
    brain = import("../core/pbai_brain.sapp");
    let prompt = _prompt(req);
    let value: any = nil;
    if action == "respond" { value = _smart_response(prompt, req);
    } else if action == "analyze" { value = pbai.analyze(prompt);
    } else if action == "self_eval" { value = pbai.self_eval(prompt);
    } else if action == "verify" { value = pbai.verify_candidate(_kind(req), prompt, _text(req), try req.verification catch nil);
    } else if action == "think" { value = pbai.think(prompt, _observed(req));
    } else if action == "generate" { value = pbai.generate(prompt, _n(req));
    } else if action == "tokenize" { value = _tokenize(prompt);
    } else if action == "learn" { value = pbai.learn(prompt, _epochs(req));
    } else if action == "ingest_path" { value = pbai.ingest_path(_path(req), _max_files(req), _max_depth(req), _epochs(req), _source(req), _dataset_options(req));
    } else if action == "dataset_policy_status" { value = pbai.dataset_policy_status();
    } else if action == "dataset_admission" { value = pbai.dataset_admission(try req.sources catch [], try req.records catch [], _dataset_options(req));
    } else if action == "grounding_status" { value = pbai.grounding_status();
    } else if action == "ruler_status" { value = pbai.ruler_status();
    } else if action == "ecosystem_status" { value = pbai.ecosystem_status();
    } else if action == "optimization_status" { value = pbai.optimization_status();
    } else if action == "tool_broker_status" { value = pbai.tool_broker_status();
    } else if action == "security_status" { value = pbai.security_status();
    } else if action == "security_scan" { value = pbai.security_scan(_text(req), try str(req.purpose) catch "api-input");
    } else if action == "isolation_status" { value = pbai.isolation_status();
    } else if action == "product_health" { value = pbai.product_health();
    } else if action == "max_status" { value = pbai.max_status();
    } else if action == "max_rl_status" { value = pbai.max_rl_status();
    } else if action == "max_memory_status" { value = pbai.max_memory_status(_max_examples(req));
    } else if action == "max_memory" { value = pbai.max_memory_retrieve(prompt, _top_k(req), _max_examples(req));
    } else if action == "max_adapter_status" { value = pbai.max_adapter_status();
    } else if action == "max_train_adapter" { value = pbai.max_train_adapter(_epochs(req), _continue_lr(req), _max_examples(req));
    } else if action == "max_train_live_adapter" { value = pbai.max_train_live_adapter(_epochs(req), _continue_lr(req), _max_examples(req));
    } else if action == "max_teach_adapter" { value = pbai.max_teach_adapter(prompt, _epochs(req), _continue_lr(req), _max_examples(req));
    } else if action == "max_train" { value = pbai.max_train_checkpoint(_epochs(req), _lr(req), _max_examples(req));
    } else if action == "max_save" { value = pbai.max_save_checkpoint(_path(req), _epochs(req), _lr(req), _max_examples(req));
    } else if action == "max_load" { value = pbai.max_load_checkpoint(_path(req));
    } else if action == "max_summary" { value = pbai.max_checkpoint_summary(_path(req));
    } else if action == "max_continue" { value = pbai.max_continue_training(_path(req), _epochs(req), _continue_lr(req), _max_examples(req));
    } else if action == "max_teach" { value = pbai.max_teach(_path(req), prompt, _epochs(req), _continue_lr(req), _max_examples(req));
    } else if action == "max_generate" { value = pbai.max_generate(prompt, _n(req), _path(req));
    } else if action == "max_generate_ranked" { value = pbai.max_generate_ranked(prompt, _n(req), _path(req));
    } else if action == "max_verify_generation" { value = pbai.max_verify_generation(_text(req), prompt, _expected(req), _forbidden(req));
    } else if action == "max_generate_verified" { value = pbai.max_generate_verified(prompt, _n(req), _path(req), _expected(req), _forbidden(req));
    } else if action == "max_eval" { value = pbai.max_eval(_path(req));
    } else if action == "max_regression" { value = pbai.max_regression(_path(req), _n(req));
    } else if action == "max_benchmark" { value = pbai.max_benchmark(_path(req), _n(req));
    } else if action == "max_distill_preview" { value = pbai.max_distillation_preview(_path(req), _max_examples(req), _n(req));
    } else if action == "max_distill_train" { value = pbai.max_distill_train(_path(req), _tier(req), _distill_epochs(req), _continue_lr(req), _max_examples(req), _n(req));
    } else if action == "max_distill_family" { value = pbai.max_distill_family(_path(req), _distill_epochs(req), _continue_lr(req), _max_examples(req), _n(req));
    } else if action == "max_distill_save_family" { value = pbai.max_distill_save_family(_path(req), _teacher_path(req), _distill_epochs(req), _continue_lr(req), _max_examples(req), _n(req));
    } else if action == "max_distill_family_summary" { value = pbai.max_distill_family_summary(_path(req));
    } else if action == "max_distill_student_eval" { value = pbai.max_distill_student_eval(_path(req), _tier(req), _max_examples(req));
    } else if action == "max_distill_family_eval" { value = pbai.max_distill_family_eval(_path(req), _max_examples(req));
    } else if action == "max_distill_student_generate" { value = pbai.max_distill_student_generate(prompt, _n(req), _path(req), _tier(req));
    } else if action == "max_distill_student_generate_ranked" { value = pbai.max_distill_student_generate_ranked(prompt, _n(req), _path(req), _tier(req), _expected(req), _forbidden(req));
    } else if action == "max_distill_route" { value = pbai.max_distill_route(prompt, _path(req));
    } else if action == "max_distill_route_generate" { value = pbai.max_distill_route_generate(prompt, _n(req), _path(req), _expected(req), _forbidden(req));
    } else if action == "max_distill_route_eval" { value = pbai.max_distill_route_eval(prompt, _path(req), _max_examples(req));
    } else if action == "cache_status" { value = pbai.cache_status();
    } else if action == "cache_clear" { value = pbai.cache_clear(_kind(req));
    } else if action == "status" { value = pbai.model_status();
    } else if action == "brain" { value = brain.run(prompt, _observed(req));
    } else if action == "tool_catalog" { value = pbai.tool_catalog();
    } else if action == "tool_call" {
        // Policy context, approvals, prior decisions and roots in request JSON are
        // ignored. The facade constructs its own fresh, digest-bound broker check.
        value = pbai.tool_call(try str(req.tool) catch "", try req.args catch nil);
    } else {
        print json_stringify(_fail(action, "unknown action", map{ error: "unknown action", action: action }));
        return;
    }
    if action == "tool_call" and type(value) == "map" and not (try value.ok catch false) {
        print json_stringify(_fail(action, str(try value.error_code catch "tool-call-denied"), value));
        return;
    }
    print json_stringify(_ok(action, value));
}

main();
