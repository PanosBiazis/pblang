// tools/pbai_feed.sapp -- feed local data into pbAI from pblang.
//
// Run from ai/pbai:
//   pblang run tools/pbai_feed.sapp -- quick
//   pblang run tools/pbai_feed.sapp -- catalog
//   pblang run tools/pbai_feed.sapp -- path tests/fixtures source-manifest.json 10 2
//   pblang run tools/pbai_feed.sapp -- lesson "project rule: ..."
//   pblang run tools/pbai_feed.sapp -- drives_survey
//   pblang run tools/pbai_feed.sapp -- drives 10 2
//
// Optional:
//   PBAI_FEED_ROOTS="/home/me/data;/mnt/shared;/run/user/.../mtp:host=..." pblang run ...
// Roots are separated with semicolons because MTP paths can contain colons.

let pbai = import("stdlib/pbai.sapp");
let assets = import("../core/pbai_assets.sapp");
let source_catalog = import("../core/pbai_source_catalog.sapp");
let secure_file = import("stdlib:secure_file.sapp");

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _int_arg(idx, fallback) {
    let raw = _arg(idx, "");
    if raw == "" { return fallback; }
    let n = 0;
    let i = 0;
    while i < len(raw) {
        let c = strcharcodeat(raw, i);
        if c < 48 or c > 57 { return fallback; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn _print_json(value) {
    print json_stringify(value);
}

fn _source_manifest(path) {
    let loaded = secure_file.read_text(path, 16384, false);
    if not loaded.ok { return nil; }
    return try json_parse(loaded.text) catch nil;
}

fn _feed_path(path, source, max_files = 20, max_depth = 3, epochs = 3) {
    return pbai.ingest_path(path, max_files, max_depth, epochs, source);
}

fn _env_roots() {
    let raw = try env_get("PBAI_FEED_ROOTS") catch nil;
    let roots = [];
    if raw == nil or raw == "" { return roots; }
    let parts = str_split(raw, ";");
    for p in parts {
        let t = str_trim(p);
        if t != "" { push(roots, t); }
    }
    return roots;
}

fn _drive_roots() {
    let roots = _env_roots();
    if len(roots) > 0 { return roots; }
    return [
        ".",
        "../..",
        "/mnt/win"
    ];
}

fn _survey_drives() {
    let roots = _drive_roots();
    return map{ format: "pbai.drive_survey.v3", ok: false,
        status: "disabled-until-bounded-root-descriptor-walker",
        requested_roots: len(roots), survey: [],
        discovery_mode: "metadata-only", content_read: false,
        training_performed: false, persisted: false,
        authorizes_ingest: false, authorizes_training: false };
}

fn _catalog_cli_error(status, roots_read, observations_read) {
    return map{ format: "pbai.source-catalog.cli.v2", ok: false,
        complete: false, partial_catalog_available: false, status: status,
        roots_metadata_read: roots_read,
        observations_metadata_read: observations_read,
        input_metadata_read: roots_read or observations_read,
        candidate_content_read: false, training_performed: false,
        persisted: false, authorizes_ingest: false,
        authorizes_retrieval: false, authorizes_training: false,
        catalog: nil };
}

fn _catalog_cli_result(catalog) {
    let complete = try catalog.complete catch false;
    let catalog_ok = try catalog.ok catch false;
    let status = "rejected";
    if catalog_ok and complete { status = "complete"; }
    elif catalog_ok { status = "partial"; }
    return map{ format: "pbai.source-catalog.cli.v2",
        ok: catalog_ok and complete, complete: complete,
        partial_catalog_available: catalog_ok and not complete,
        status: status,
        roots_metadata_read: true, observations_metadata_read: true,
        input_metadata_read: true, candidate_content_read: false,
        training_performed: false, persisted: false,
        authorizes_ingest: false, authorizes_retrieval: false,
        authorizes_training: false, catalog: catalog };
}

fn _catalog_from_files(root_manifest_path, observations_path) {
    let roots_loaded = secure_file.read_text(root_manifest_path, 262144, false);
    if not roots_loaded.ok {
        return _catalog_cli_error("root-metadata-unavailable", false, false);
    }
    let observations_loaded = secure_file.read_text(observations_path, 1000000, false);
    if not observations_loaded.ok {
        return _catalog_cli_error("observation-metadata-unavailable", true, false);
    }
    let roots = try json_parse(roots_loaded.text) catch nil;
    let observations = try json_parse(observations_loaded.text) catch nil;
    if type(roots) != "array" or type(observations) != "array" {
        return _catalog_cli_error("invalid-catalog-metadata", true, true);
    }
    return _catalog_cli_result(source_catalog.catalog_observations(roots, observations));
}

fn _feed_drives(max_files = 10, max_depth = 2) {
    return map{ format: "pbai.feed.v2", mode: "drives", ok: false,
        status: "one-source-manifest-required-per-root", max_files_per_root: max_files,
        max_depth: max_depth, content_read: false, training_performed: false };
}

fn _quick_paths() {
    return [
        "tests/fixtures",
        "docs",
        "stdlib",
        "../pblang/stdlib",
        "../pblang/docs",
        "../../library/datasets/data",
        "../../training/ai",
        "../../training/html",
        "../../training/cpp",
        "../../projects/ai/max",
        "../../projects/ai/aipy"
    ];
}

fn _feed_quick() {
    return map{ format: "pbai.feed.v2", mode: "quick", sources: assets.aap_ai_source_summary(),
        candidate_roots: len(_quick_paths()), discovery_mode: "metadata-only",
        content_read: false, training_performed: false };
}

fn _feed_envelope(mode, result) {
    return map{ ok: try result.ok catch false, mode: mode, result: result };
}

fn main() {
    let mode = _arg(0, "help");
    if mode == "lesson" {
        let lesson = _arg(1, "");
        if lesson == "" { _print_json(map{ ok: false, error: "lesson text required" }); return; }
        _print_json(map{ ok: true, mode: mode, result: pbai.learn(lesson, _int_arg(2, 4)) });
        return;
    }
    if mode == "path" {
        let path = _arg(1, "");
        let source = if _arg(2, "") == "" { nil } else { _source_manifest(_arg(2, "")) };
        if path == "" or source == nil {
            _print_json(map{ ok: false, error: "path and a valid bounded source manifest are required",
                content_read: false, training_performed: false }); return;
        }
        _print_json(_feed_envelope(mode,
            _feed_path(path, source, _int_arg(3, 40), _int_arg(4, 3), _int_arg(5, 3))));
        return;
    }
    if mode == "quick" {
        _print_json(map{ ok: true, mode: mode, result: _feed_quick() });
        return;
    }
    if mode == "catalog" {
        _print_json(map{ ok: true, mode: mode, result: assets.aap_ai_source_summary() });
        return;
    }
    if mode == "catalog_observations" {
        let roots_path = _arg(1, "");
        let observations_path = _arg(2, "");
        if roots_path == "" or observations_path == "" {
            _print_json(_catalog_cli_error("catalog-metadata-paths-required", false, false));
            return;
        }
        let catalog_result = _catalog_from_files(roots_path, observations_path);
        _print_json(map{ format: "pbai.feed.cli.v2", mode: mode,
            ok: catalog_result.ok, complete: catalog_result.complete,
            partial_catalog_available: catalog_result.partial_catalog_available,
            result: catalog_result });
        return;
    }
    if mode == "drives_survey" {
        _print_json(_feed_envelope(mode, _survey_drives()));
        return;
    }
    if mode == "drives" {
        _print_json(_feed_envelope(mode, _feed_drives(_int_arg(1, 10), _int_arg(2, 2))));
        return;
    }
    _print_json(map{
        ok: true,
        usage: [
            "pblang run tools/pbai_feed.sapp -- lesson \"project rule: ...\"",
            "pblang run tools/pbai_feed.sapp -- path tests/fixtures source-manifest.json 10 2",
            "pblang run tools/pbai_feed.sapp -- quick",
            "pblang run tools/pbai_feed.sapp -- catalog",
            "pblang run tools/pbai_feed.sapp -- catalog_observations roots.json observations.json",
            "pblang run tools/pbai_feed.sapp -- drives_survey",
            "pblang run tools/pbai_feed.sapp -- drives 10 2"
        ]
    });
}

main();
