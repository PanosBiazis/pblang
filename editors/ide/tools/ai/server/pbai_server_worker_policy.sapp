// Pure fail-closed projection of bounded-worker terminal evidence.

fn disposition(result) {
    if type(result) != "map" or not (try result.bounded catch false) {
        return map{ accept_output: false, quarantine: false, status: 503,
            error: "bounded worker backend is unavailable" };
    }
    let terminal = (try result.completed catch false)
    and (try result.process_group_terminated catch false)
    and not (try result.cleanup_deferred catch false)
    and not (try result.requires_recovery catch false);
    if not terminal {
        return map{ accept_output: false, quarantine: true, status: 503,
            error: "bounded worker teardown was not proven; heavy actions are quarantined" };
    }
    if try result.timed_out catch false {
        return map{ accept_output: false, quarantine: false, status: 504,
            error: "pbAI worker exceeded its hard wall-time deadline" };
    }
    if not (try result.command_ok catch false) {
        return map{ accept_output: false, quarantine: false, status: 500,
            error: "bounded pbAI worker terminated without a valid result" };
    }
    return map{ accept_output: true, quarantine: false, status: 200, error: "" };
}

export disposition;
