// Pure routing policy for the local HTTP surface. It grants no effect authority.

let BROKER_READINESS = import("pbai_server_broker_readiness.sapp");

fn route(action) {
    if type(action) != "string" or action == "" or len(action) > 64 {
        return map{ format: "pbai.server.action-route.v1", mode: "disabled",
            status: 400, reason: "invalid-action" };
    }
    if action == "ingest_path" {
        return map{ format: "pbai.server.action-route.v1", mode: "disabled",
            status: 403, reason: "operator-owned-root-ids-required" };
    }
    if action == "respond" or action == "analyze" or action == "think"
    or action == "generate" or action == "tokenize" or action == "self_eval"
    or action == "verify" or action == "learn" or action == "dataset_admission"
    or action == "security_scan" or action == "brain" {
        return map{ format: "pbai.server.action-route.v1", mode: "broker-required",
            status: 503, reason: "attested-fixed-method-broker-required" };
    }
    if action == "dataset_policy_status" or action == "grounding_status"
    or action == "ruler_status" or action == "ecosystem_status"
    or action == "optimization_status" or action == "tool_broker_status"
    or action == "security_status" or action == "isolation_status"
    or action == "product_health" or action == "status"
    or action == "tool_catalog" or action == "dataset_policy" {
        return map{ format: "pbai.server.action-route.v1", mode: "local-read-only",
            status: 200, reason: "exact-read-only-allowlist" };
    }
    if action == "tool_call" {
        return map{ format: "pbai.server.action-route.v1", mode: "mediated",
            status: 200, reason: "tool-broker-policy-required" };
    }
    return map{ format: "pbai.server.action-route.v1", mode: "disabled",
        status: 404, reason: "unknown-action" };
}

fn status() {
    let broker = BROKER_READINESS.status();
    return map{ format: "pbai.server.action-policy.v1", ok: true,
        local_path_ingestion: false, fixed_method_broker_implemented: false,
        ffi_tuple_contract_foundation: true,
        immutable_closure_bundle_foundation: true,
        runtime_signature_tuple_enforced: broker.runtime_signature_tuple_enforced,
        immutable_runtime_handoff_verified: broker.immutable_runtime_handoff_verified,
        hostile_code_sandbox_verified: broker.hostile_code_sandbox_verified,
        broker_authorizes_execution: broker.authorizes_execution,
        bounded_pure_evaluator_local_only: true,
        bounded_pure_evaluator_http_exposed: false,
        exact_read_only_allowlist: true, default_unknown_disabled: true,
        mediated_tool_call: true, mutable_worker_entrypoint: false,
        grants_authority: false };
}

export route, status;
