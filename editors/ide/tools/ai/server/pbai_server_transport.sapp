// Bounded transport policy for the local pbAI website/API server.
// Limits are enforced before application routing and cannot be expanded by callers.

let HTTP = import("stdlib:http_server.sapp");

let REQUEST_TIMEOUT_MS = 60000;
let WRITE_TIMEOUT_MS = 5000;
let MAX_INFLIGHT = 16;
let MAX_HEADER_BYTES = 32768;
// NativeTcp bounds header + body together to one MiB. Keep explicit headroom
// instead of allowing the two independent limits to overcommit that envelope.
let MAX_BODY_BYTES = 983040;
let MAX_RESPONSE_BYTES = 1048576;

fn policy(preflight = nil) {
    let options = map{
        request_timeout_ms:REQUEST_TIMEOUT_MS,
        write_timeout_ms:WRITE_TIMEOUT_MS,
        accept_poll_ms:5,
        max_inflight:MAX_INFLIGHT,
        max_header_bytes:MAX_HEADER_BYTES,
        max_body_bytes:MAX_BODY_BYTES,
        max_response_bytes:MAX_RESPONSE_BYTES
    };
    if preflight != nil {
        if not is_fn(preflight) { throw "pbAI server preflight must be callable"; }
        options.preflight = preflight;
    }
    // serve_forever_timeout owns normalization immediately before binding.
    return options;
}

fn status() {
    // Status performs the same validation without opening a listener.
    let p = HTTP.bounded_server_policy(policy());
    return map{
        ok:true, format:"pbai.server.transport.v1",
        loopback_only:true, absolute_request_deadline:p.absolute_request_deadline,
        request_timeout_ms:p.request_timeout_ms, write_timeout_ms:p.write_timeout_ms,
        max_inflight:p.max_inflight, max_header_bytes:p.max_header_bytes,
        max_body_bytes:p.max_body_bytes, max_response_bytes:p.max_response_bytes,
        chunked_requests:p.chunked_requests, production_ready:false
    };
}

export REQUEST_TIMEOUT_MS, WRITE_TIMEOUT_MS, MAX_INFLIGHT;
export MAX_HEADER_BYTES, MAX_BODY_BYTES, MAX_RESPONSE_BYTES;
export policy, status;
