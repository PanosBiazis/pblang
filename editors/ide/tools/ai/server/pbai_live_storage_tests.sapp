// Run state-mutating pbAI tests with separate operator-injected roots. The
// tests themselves reject every non-test namespace, and cleanup happens before
// this runner reports a child failure.

let PBLANG = "../pblang/target/release/pblang";
let CASES = [
    map{ name: "lm", file: "tests/semantics/pbai_lm_test.sapp" },
    map{ name: "ingest", file: "tests/semantics/pbai_ingest_test.sapp" },
    map{ name: "facade", file: "tests/semantics/pbai_test.sapp" }
];

fn test_root(name) {
    return "/tmp/pbai-test-" + name + "-" +
        str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
}

let failures = [];
let i = 0;
while i < len(CASES) {
    let item = CASES[i]; let root = test_root(item.name);
    let result = try proc_spawn_wait("/usr/bin/env", [
        "PBAI_STATE_ROOT=" + root, PBLANG, "run", item.file, "--allow-all"
    ]) catch nil;
    let cleaned = try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
    if result == nil or result.exit_code != 0 or cleaned == nil or cleaned.exit_code != 0 {
        push(failures, map{ name: item.name,
            exit_code: try result.exit_code catch -1,
            stderr: try result.stderr catch "runner failure",
            cleanup_verified: cleaned != nil and cleaned.exit_code == 0 });
    }
    i = i + 1;
}

if len(failures) > 0 { throw "pbAI isolated live-storage tests failed: " + str(failures); }
print "pbai_live_storage_tests_pass";
