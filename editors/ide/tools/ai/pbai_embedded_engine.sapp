    let profiles = [
        map{
            sphere: "Μαθηματικά, Άλγεβρα, Διαφορική Γεωμετρία, Λογική & Θεωρία Αριθμών",
            rule_cat: "math_geometry_number_theory",
            sub_prefix_a: "submodel_diff_geometry_",
            sub_prefix_b: "submodel_number_logic_",
            cats: ["Διαφορική Γεωμετρία & Πολλαπλότητες", "Αλγεβρική Τοπολογία & Ομολογία", "Αναλυτική Θεωρία Αριθμών", "Μαθηματική Λογική & Επαλήθευση SMT", "Φασματική Θεωρία Πινάκων", "Συμπλεκτική Δυναμική & Ιδιοτιμές"],
            subcats: ["Γεωδαισιακή Καμπυλότητα Riemann", "Ορθογωνιότητα Μετασχηματισμού Cayley", "Κατανομή Πρώτων Αριθμών & Ζήτα", "Κατασκευαστική Απόδειξη Σταθερού Σημείου", "Αποσύνθεση Ιδιάζουσας Τιμής (SVD)", "Ολοκλήρωση 6ης Τάξης Διατήρησης Δράσης", "Δυαδικότητα Συνομολογίας de Rham", "Ισομετρική Εμβάπτιση Πολλαπλοτήτων"],
            questions: [
                "Πώς διατηρείται η ακριβής ορθογωνιότητα πινάκων κατά τη συνεχή γεωδαισιακή ενημέρωση χωρίς συσσώρευση σφάλματος κινητής υποδιαστολής;",
                "Ποια ικανή και αναγκαία συνθήκη φασματικής ακτίνας εγγυάται μοναδικό ελκυστή σε μη-γραμμικά συστήματα μερικών διαφορικών εξισώσεων;",
                "Πώς ελαχιστοποιείται το αριθμητικό σφάλμα προσέγγισης σε σειρά εναλλασσόμενων όρων μεγάλης κλίμακας;",
                "Με ποιον τρόπο μεταφράζεται μια τυπική λογική πρόταση πρώτης τάξης σε επαληθεύσιμο αναλλοίωτο βρόχου (loop invariant);",
                "Πώς διαχωρίζονται οι πραγματικές δομικές ιδιοτιμές ενός συστήματος από τον τυχαίο γκαουσιανό θόρυβο;",
                "Πώς επιτυγχάνεται ισομετρική συμπίεση διαστάσεων με μηδενική απώλεια τοπολογικής πληροφορίας;"
            ]
        },
        map{
            sphere: "Βιολογία, Γενετική, Οικολογία, Βιοποικιλότητα & Εξέλιξη της Ζωής",
            rule_cat: "biology_genetics_ecology",
            sub_prefix_a: "submodel_eco_population_",
            sub_prefix_b: "submodel_genomic_folding_",
            cats: ["Πληθυσμιακή Οικολογία & Ισορροπία", "Μοριακή Γενετική & Μεταγραφή", "Εξελικτική Δυναμική & Προσαρμογή", "Κυτταρική Ομοιόσταση & Μεταβολισμός", "Θαλάσσια & Δασική Βιοποικιλότητα", "Συστημική Βιοπληροφορική"],
            subcats: ["Δυναμική Θηρευτή-Θηράματος Lotka-Volterra", "Επιδιόρθωση Ακολουθιών Γονιδιώματος", "Φέρουσα Ικανότητα Οικοσυστήματος", "Κινητική Ενζυμικής Κατάλυσης Michaelis-Menten", "Δείκτης Βιοποικιλότητας Shannon-Wiener", "Ομοιοστατική Ρύθμιση Κυτταρικής Μίτωσης", "Φυλογενετική Σύγκλιση Ειδών", "Ενεργειακό Ισοζύγιο Φωτοσύνθεσης"],
