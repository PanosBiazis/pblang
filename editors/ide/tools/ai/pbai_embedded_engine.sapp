            code: "// Pure-PBLang Kahan Compensated Summation & Vector Dot Product\nfn kahan_compensated_sum(values) {\n    let sum = 0.0;\n    let c = 0.0;\n    for v in values {\n        let y = v - c;\n        let t = sum + y;\n        c = (t - sum) - y;\n        sum = t;\n    }\n    return sum;\n}\n\nfn dot_product(vec_a, vec_b) {\n    if len(vec_a) != len(vec_b) { return 0.0; }\n    let acc = 0.0;\n    let i = 0;\n    while i < len(vec_a) {\n        acc = acc + (vec_a[i] * vec_b[i]);\n        i = i + 1;\n    }\n    return acc;\n}\n\nexport kahan_compensated_sum, dot_product;\n",
            test_code: "// Verification Test for Kahan Sum & Dot Product\nassert(kahan_compensated_sum([10.5, 20.25, 9.25]) == 40.0);\nassert(dot_product([1, 2, 3], [4, 5, 6]) == 32.0);\nprint \"Numerical analysis Kahan & dot product test: PASS\";\n"
