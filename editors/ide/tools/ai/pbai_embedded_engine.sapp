        let ans_en = "1) [DIRECT VERIFIED ANSWER]: A body traveling **" + str(dist_km) + " km** in **" + str(time_h) + " hours** has an average speed of **" + str(v_kmh) + " km/h**, which equals **" + str(v_ms) + " m/s** in SI units.\n"
