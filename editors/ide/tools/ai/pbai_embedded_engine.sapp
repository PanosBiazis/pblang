    // X. Physics Kinematics (Speed/Distance/Time) & Thermodynamic Temperature Converter
    if str_contains(low, "average speed") or str_contains(low, "km/h") or str_contains(low, "celsius") or str_contains(low, "fahrenheit") or str_contains(low, "kelvin") or str_contains(low, "μέση ταχύτητα") or str_contains(low, "κελσίου") {
