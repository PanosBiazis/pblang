        + "<span id=\"trace-dnc-badge\" style=\"background:#064e3b;color:#a7f3d0;border:1px solid #10b981;border-radius:999px;padding:2px 8px;font-size:.7rem;font-weight:700\">✓ Ενεργό σε Όλα τα 69 Προϊόντα &amp; Όλες τις Σελίδες</span></div>"
        + "<div id=\"trace-dnc-live-out\" style=\"padding:6px 8px;border-radius:6px;background:#040c1a;border:1px solid #1e3a8a;color:#cbd5e1;line-height:1.45\">"
        + "✓ <strong>Καθολική Εφαρμογή (Universal Enforcement):</strong> Κάθε αίτημα διέρχεται αυτόματα από <strong>32 Μοντέλα → 384 Υπομοντέλα → 4.608 Μικρο → 55.296 Νανο → 663.552 Πικο-Σμήνη (723.872 Μονάδες)</strong>, επιλύεται με <strong>24 Αλγορίθμους</strong> (D&amp;C, DP, B&amp;B, MCTS, Greedy/A*, CSP/SMT, Annealing, NSGA-II, Decrease &amp; Conquer, FFT/SVD, KKT/ADMM, Dinic Flow, FPT, Las Vegas/MC, HyperLogLog, E-Graph, Swarm CMA-ES, Tabu/VNS, Quantum MPS, Betti Homology, Do-Calculus, CFR+/Nash, zk-STARK/FHE, Portfolio Meta-Solver) και προστατεύεται από την <strong>Ασπίδα Πιστοποιητικών 2026 (Anti-k=4 &amp; Synaptic BBB)</strong>."
        + "</div>"
        + "<svg id=\"trace-dnc-svg\" viewBox=\"0 0 820 74\" style=\"width:100%;max-width:100%;height:auto;display:block;background:#081528;border:1px solid #1e3a8a;border-radius:7px;padding:4px;box-sizing:border-box\" role=\"img\" aria-label=\"5-Scale 24-Algorithm &amp; Security Live Telemetry\">"
        + "<text x=\"12\" y=\"20\" fill=\"#6ee7b7\" font-size=\"10\" font-weight=\"bold\">1. 5 Κλίμακες (723.872 Μονάδες)</text><rect x=\"210\" y=\"10\" width=\"480\" height=\"12\" rx=\"4\" fill=\"#112240\"/><rect id=\"trace-dnc-bar1\" x=\"210\" y=\"10\" width=\"465\" height=\"12\" rx=\"4\" fill=\"#10b981\"/><text x=\"700\" y=\"20\" fill=\"#a7f3d0\" font-size=\"9.8\" font-weight=\"bold\">723.872 Active</text>"
        + "<text x=\"12\" y=\"42\" fill=\"#93c5fd\" font-size=\"10\" font-weight=\"bold\">2. 24 Αλγόριθμοι Επίλυσης</text><rect x=\"210\" y=\"32\" width=\"480\" height=\"12\" rx=\"4\" fill=\"#112240\"/><rect id=\"trace-dnc-bar2\" x=\"210\" y=\"32\" width=\"472\" height=\"12\" rx=\"4\" fill=\"#38bdf8\"/><text x=\"700\" y=\"42\" fill=\"#bae6fd\" font-size=\"9.8\" font-weight=\"bold\">24/24 PASS</text>"
        + "<text x=\"12\" y=\"64\" fill=\"#fde047\" font-size=\"10\" font-weight=\"bold\">3. Ασπίδα Πιστοποιητικών 2026</text><rect x=\"210\" y=\"54\" width=\"480\" height=\"12\" rx=\"4\" fill=\"#112240\"/><rect id=\"trace-dnc-bar3\" x=\"210\" y=\"54\" width=\"480\" height=\"12\" rx=\"4\" fill=\"#f59e0b\"/><text x=\"700\" y=\"64\" fill=\"#fef08a\" font-size=\"9.8\" font-weight=\"bold\">k≠4 · 144-bit</text>"
        + "</svg>"
        + "<div style=\"display:flex;flex-wrap:wrap;gap:6px\">"
        + "<button type=\"button\" onclick=\"" + inspector_action_fn + "('alg24')\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #38bdf8;background:#0f2942;color:#bae6fd;cursor:pointer;font-weight:700;font-size:.73rem\">⚡ Εκτέλεση &amp; Δοκιμή 24 Αλγορίθμων (Divide &amp; Conquer)</button>"
        + "<button type=\"button\" onclick=\"" + inspector_action_fn + "('cert2026')\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #f59e0b;background:#271a05;color:#fde047;cursor:pointer;font-weight:700;font-size:.73rem\">🛡️ Έλεγχος Πιστοποιητικών 2026 (Anti-k=4 &amp; CSPRNG 144-bit)</button>"
        + "<button type=\"button\" onclick=\"" + inspector_action_fn + "('hierarchy')\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #10b981;background:#064e3b;color:#a7f3d0;cursor:pointer;font-weight:700;font-size:.73rem\">🧠 Επιθεώρηση 723.872 Υπομοντέλων &amp; Synaptic BBB</button>"
        + "</div></div>";

    let interactive_widgets_html = "<div style=\"display:grid;grid-template-columns:minmax(0,1fr);gap:8px;margin-top:4px;width:100%;max-width:100%;box-sizing:border-box\">"
        + "<details open style=\"min-width:0;max-width:100%;box-sizing:border-box;border:1px solid #10b981;border-radius:10px;background:#09182c;padding:9px 10px\">"
        + "<summary style=\"cursor:pointer;font-weight:700;color:#6ee7b7;font-size:.85rem\">🛡️ 1. Διαδραστικός Επιθεωρητής 5 Κλιμάκων (723.872 Υπομοντέλα), 24 Αλγορίθμων Επίλυσης &amp; Ασπίδας Πιστοποιητικών 2026 (Anti-k=4 &amp; Synaptic BBB)</summary>"
        + "<div style=\"margin-top:6px;min-width:0;max-width:100%\">" + inspector_deck_html + "</div></details>"
        + "<details open style=\"min-width:0;max-width:100%;box-sizing:border-box;border:1px solid #2d806e;border-radius:10px;background:#0b192e;padding:9px 10px\">"
        + "<summary style=\"cursor:pointer;font-weight:700;color:#66e3c4;font-size:.84rem\">2. Ζωντανό Αρχείο Εντολών, Εργαλείων PB-MCP &amp; Αλλαγών Κώδικα (Live Commands, Tools &amp; Diff Trace · 84 Γλώσσες Κώδικα)</summary>"
        + "<div style=\"margin-top:6px;min-width:0;max-width:100%\">" + table_html
        + "<pre id=\"trace-diff-pre\" style=\"margin:6px 0 0;padding:7px 9px;background:#071020;border:1px solid #24385b;border-radius:8px;font-size:.73rem;line-height:1.4;color:#66e3c4;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;max-width:100%;box-sizing:border-box\">" + diff_preview + "</pre></div></details>"
        + "<details open style=\"min-width:0;max-width:100%;box-sizing:border-box;border:1px solid #3b4f74;border-radius:10px;background:#0b192e;padding:9px 10px\">"
        + "<summary style=\"cursor:pointer;font-weight:700;color:#7aa2ff;font-size:.84rem\">3. Διαδραστικό Διάγραμμα Ροής Εκτέλεσης (Interactive Execution Flowchart DAG) &amp; Γράφημα Μετρικών</summary>"
        + "<div style=\"margin-top:6px;display:grid;grid-template-columns:minmax(0,1fr);gap:7px;min-width:0;max-width:100%\">" + flowchart_svg + chart_svg + "</div></details>"
        + "<details open style=\"min-width:0;max-width:100%;box-sizing:border-box;border:1px solid #5e4380;border-radius:10px;background:#0b192e;padding:9px 10px\">"
        + "<summary style=\"cursor:pointer;font-weight:700;color:#ffd479;font-size:.84rem\">4. Έξυπνη Λεπτομερής Επεξήγηση, Κατανόηση Αδόμητου Κειμένου &amp; Λογοτεχνική Σύνθεση</summary>"
        + "<div style=\"margin-top:6px;font-size:.78rem;line-height:1.46;color:#eef4ff;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere\">"
        + "<strong>Συνοπτική Επεξήγηση:</strong> <span id=\"trace-concise-el\">" + smart_explanatory_narrative.concise_summary_el + "</span>\n\n"
        + "<strong>Λεπτομερής Τεχνική &amp; Αιτιακή Ανάλυση:</strong>\n" + smart_explanatory_narrative.detailed_deep_dive_el + "\n\n"
        + "<strong>Πλούσια Λογοτεχνική &amp; Ποιητική Σύνθεση:</strong>\n" + smart_explanatory_narrative.rich_literary_commentary_el
        + "</div></details></div>";

    return map{
        ok: true,
        unstructured_and_literary_discourse: disc,
        live_execution_trace: live_execution_trace,
        smart_explanatory_narrative: smart_explanatory_narrative,
