        + "</svg>";

    let inline_evolve_fn = "(window.__pbaiEvolveStudio=function(mode,withAudio){"
        + "if(document.hidden)return;"
        + "window.__pbaiStudioGen=(window.__pbaiStudioGen||1)+1;"
        + "var g=window.__pbaiStudioGen,seed=Math.floor(Date.now()%997)+g*37;"
        + "var x1=(mode==='improve')?Math.round((" + str(n1) + "+g*7.5)*10)/10:(30+(seed%240));"
        + "var x2=(mode==='improve')?Math.round((" + str(n2) + "+g*4.5)*10)/10:(20+((seed*3)%180));"
        + "var sumV=Math.round((x1+x2)*100)/100,prodV=Math.round((x1*x2)*100)/100;"
        + "var kktV=Math.round(sumV*0.618*100)/100,flowV=Math.round(sumV*1.25*100)/100;"
        + "var f0=260+((seed*5)%380),f3=Math.round(f0*1.25),f5=Math.round(f0*1.5);"
        + "var cs=['«Διαίρει το αίνιγμα σοφά σε χίλια μονοπάτια, / κι οι νευρώνες χτίζουνε της σκέψης τα παλάτια.»','«Κύμα, χρώμα και ρυθμός γεννιούνται κάθε ώρα, / η ζωντανή μας σύναψη προχωράει στη χώρα.»','«Από τα νανο-μοντέλα ως τη μεγάλη σφαίρα, / η λύση βελτιώνεται σε κάθε νέα μέρα.»','«Στου νου την άφθαρτη πηγή που πλάθει φως κι εικόνα, / κάθε μικρό υποπρόβλημα υφαίνει τον αιώνα.»'];"
        + "var pals=[['#6ee7b7','#38bdf8'],['#fcd34d','#f472b6'],['#a78bfa','#34d399'],['#38bdf8','#fb923c'],['#4ade80','#c084fc']];"
        + "var pal=pals[g%pals.length];"
        + "var bEl=document.getElementById('pbai-studio-gen-badge');if(bEl)bEl.textContent='⚡ Real-Time Seed #'+seed+' · Γενιά Εξέλιξης #'+g+' ('+(mode==='improve'?'Αυτόματη Βελτίωση 24 Αλγορίθμων':'Νέα Δημιουργία')+')';"
        + "var cEl=document.getElementById('pbai-studio-couplet-live');if(cEl)cEl.innerHTML='• <strong>Ποιητικό Δίστιχο (Γενιά #'+g+'):</strong> <em>'+cs[g%cs.length]+'</em>';"
        + "var aEl=document.getElementById('pbai-studio-alg24-live');if(aEl)aEl.textContent='✓ [Γενιά #'+g+' · 24 Αλγόριθμοι & 723.872 Υπομοντέλα]: P(x1='+x1+', x2='+x2+') → D&C Σ='+sumV+' | DP Π='+prodV+' | KKT L*='+kktV+' | Dinic Flow='+flowV+' | E-Graph/MPS/Betti/zk-STARK=PASS | Cert 2026 k≠4';"
        + "var st1=document.getElementById('pbai-stop-1'),st2=document.getElementById('pbai-stop-2');"
        + "if(st1)st1.setAttribute('stop-color',pal[0]);if(st2)st2.setAttribute('stop-color',pal[1]);"
        + "var sunX=110+((seed*3)%220),sunY=58+((seed*2)%64),sunR=28+(g%26);"
        + "var sg=document.getElementById('pbai-img-sun-glow'),sr=document.getElementById('pbai-img-sun-ring');"
        + "if(sg){sg.setAttribute('cx',sunX);sg.setAttribute('cy',sunY);sg.setAttribute('r',sunR*2);}"
        + "if(sr){sr.setAttribute('cx',sunX);sr.setAttribute('cy',sunY);sr.setAttribute('r',sunR);sr.setAttribute('stroke',pal[0]);}"
        + "var tx=350+((seed*5)%120),dx=535+((seed*7)%115);"
        + "var p1=document.getElementById('pbai-img-poly1'),p2=document.getElementById('pbai-img-poly2');"
        + "if(p1){p1.setAttribute('points',tx+','+(20+(g%18))+' '+(tx+60+(g%30))+',152 '+(tx-60-(g%30))+',152');p1.setAttribute('stroke',pal[1]);}"
        + "if(p2){p2.setAttribute('points',dx+','+(26+(g%16))+' '+(dx+72+(g%20))+',108 '+dx+',170 '+(dx-72-(g%20))+',108');p2.setAttribute('stroke',pal[0]);}"
        + "var sn1=document.getElementById('pbai-img-subnode1'),sn2=document.getElementById('pbai-img-subnode2'),sn3=document.getElementById('pbai-img-subnode3');"
        + "if(sn1)sn1.setAttribute('cx',tx);if(sn2)sn2.setAttribute('cx',tx-42);if(sn3)sn3.setAttribute('cx',tx+42);"
        + "var r1=document.getElementById('pbai-img-ray1'),r2=document.getElementById('pbai-img-ray2');"
        + "if(r1){r1.setAttribute('x1',sunX);r1.setAttribute('y1',sunY);r1.setAttribute('x2',tx);}"
        + "if(r2){r2.setAttribute('x1',tx);r2.setAttribute('x2',dx);}"
        + "var wv=document.getElementById('pbai-img-wave');if(wv)wv.setAttribute('d','M 0 '+(148+(g%20))+' Q 200 '+(105+(seed%45))+' 400 '+(145+(g%18))+' T 800 '+(135+(seed%30))+' L 800 210 L 0 210 Z');"
        + "var it=document.getElementById('pbai-img-title');if(it)it.textContent='🖼️ Εικόνα PBR & Φράκταλ «Διαίρει-Βασίλευε» (Γενιά #'+g+' · x1='+x1+', x2='+x2+' → Σ='+sumV+', Π='+prodV+')';"
        + "var vt=document.getElementById('pbai-vid-title'),vs=document.getElementById('pbai-vid-sub');"
        + "if(vt)vt.textContent='🎬 Βίντεο Κίνησης 60 FPS (Γενιά #'+g+' · Διάσπαση & Σύνθεση 24 Αλγορίθμων V='+sumV+' -> '+prodV+')';"
        + "if(vs)vs.textContent='Υπότιτλος [Live Γενιά #'+g+']: Σκηνή 1 (Divide x1='+x1+') → Σκηνή 2 (384 Υπομοντέλα) → Σκηνή 3 (24 Αλγόριθμοι Σ='+sumV+') → Σκηνή 4 (Π='+prodV+')';"
        + "var vo1=document.getElementById('pbai-vid-orb1'),vo2=document.getElementById('pbai-vid-orb2');"
        + "if(vo1){vo1.setAttribute('cx',100+((seed*4)%560));vo1.setAttribute('stroke',pal[0]);}"
        + "if(vo2){vo2.setAttribute('cx',660-((seed*4)%520));vo2.setAttribute('stroke',pal[1]);}"
        + "var at=document.getElementById('pbai-aud-title');if(at)at.textContent='🎵 Ηχητικό Κύμα, 4-Stem Τραγούδι & 5-Formant Φωνή (Γενιά #'+g+' · f0='+f0+' Hz · Συγχορδία '+f0+'/'+f3+'/'+f5+' Hz)';"
        + "var aw1=document.getElementById('pbai-aud-wave1');if(aw1)aw1.setAttribute('stroke',pal[0]);"
        + "var o3d=document.getElementById('pbai-3d-outer'),i3d=document.getElementById('pbai-3d-inner'),t3d=document.getElementById('pbai-3d-title');"
        + "var rad=36+(g%14),irad=18+(g%10);"
        + "if(o3d){o3d.setAttribute('points','0,-'+rad+' '+rad+',-12 '+Math.round(rad*0.7)+','+rad+' -'+Math.round(rad*0.7)+','+rad+' -'+rad+',-12');o3d.setAttribute('stroke',pal[0]);}"
        + "if(i3d){i3d.setAttribute('points','0,-'+irad+' '+irad+','+Math.round(irad*0.7)+' -'+irad+','+Math.round(irad*0.7));i3d.setAttribute('stroke',pal[1]);}"
        + "if(t3d)t3d.textContent='🧊 3D Ολογραφικό Πλέγμα .OBJ (Γενιά #'+g+' · Ακτίνα R='+rad+' · Euler V-E+F=2 · 24 Αλγόριθμοι)';"
        + "var s1=document.getElementById('pbai-slide1-line1'),s2=document.getElementById('pbai-slide2-line1'),s3=document.getElementById('pbai-slide3-line2');"
        + "if(s1)s1.textContent='P → 24 Υποπροβλήματα (x1='+x1+', x2='+x2+')';"
        + "if(s2)s2.textContent='Conquer: Σ='+sumV+' · Π='+prodV;"
        + "if(s3)s3.textContent='Γενιά #'+g+' · KKT='+kktV+' · Autopilot ΟΝ';"
        + "if(withAudio){try{var C=window.AudioContext||window.webkitAudioContext;if(C){var ctx=window.__pbaiSharedAudioCtx||(window.__pbaiSharedAudioCtx=new C());if(ctx.state==='suspended')ctx.resume();var o=ctx.createOscillator(),gn=ctx.createGain();o.type='sine';o.frequency.setValueAtTime(f0,ctx.currentTime);o.frequency.exponentialRampToValueAtTime(f5,ctx.currentTime+0.18);gn.gain.setValueAtTime(0.08,ctx.currentTime);gn.gain.exponentialRampToValueAtTime(0.0001,ctx.currentTime+0.22);o.connect(gn);gn.connect(ctx.destination);o.start();o.stop(ctx.currentTime+0.23);}}catch(e){}}"
        + "})";

    let studio_html = "<div id=\"pbai-multimodal-studio-deck\" style=\"display:grid;grid-template-columns:minmax(0,1fr);gap:8px;width:100%;max-width:100%;box-sizing:border-box\">"
        + "<div style=\"padding:9px 12px;border-radius:8px;background:#081529;border:1px solid #10b981;font-size:.78rem;line-height:1.48;color:#eef4ff;word-break:break-word;overflow-wrap:anywhere\">"
        + text_article_html
        + "<div style=\"display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;padding-top:7px;border-top:1px solid #1e3a8a\">"
        + "<button type=\"button\" onclick=\"" + inline_evolve_fn + "('new',true)\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #38bdf8;background:#0f2942;color:#bae6fd;cursor:pointer;font-weight:700;font-size:.73rem\">🎲 Νέα Διαφορετική Δημιουργία (Real-Time Seed)</button>"
        + "<button type=\"button\" onclick=\"" + inline_evolve_fn + "('improve',true)\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #10b981;background:#064e3b;color:#a7f3d0;cursor:pointer;font-weight:700;font-size:.73rem\">🧬 Βελτίωση Υπάρχοντος (+1 Γενιά · 24 Αλγόριθμοι)</button>"
        + "<button id=\"pbai-auto-evolve-btn\" type=\"button\" onclick=\"window.__pbaiAutoEvolve=(window.__pbaiAutoEvolve===false)?true:false;this.textContent=window.__pbaiAutoEvolve?'🔄 Αυτόματη Ζωντανή Εξέλιξη (Autopilot): ΕΝΕΡΓΗ (Zero-Leak 2.5s)':'⏸ Αυτόματη Εξέλιξη: ΣΕ ΠΑΥΣΗ (Πατήστε για Ενεργοποίηση Autopilot)';\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #a855f7;background:#2e1065;color:#e9d5ff;cursor:pointer;font-weight:700;font-size:.73rem\">🔄 Αυτόματη Ζωντανή Εξέλιξη (Autopilot): ΕΝΕΡΓΗ (Zero-Leak 2.5s)</button>"
        + "</div></div>"
        + "<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:8px;width:100%\">"
        + "<div style=\"background:#061020;border:1px solid #2dd4bf;border-radius:9px;padding:7px\">" + image_svg
        + "<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:5px;font-size:.73rem;color:#9fb0cc\"><span>Ανάλυση: PBR Ray-Tracing + Vector SVG · φ=1.618</span>"
        + "<div style=\"display:flex;gap:5px\"><button type=\"button\" onclick=\"" + inline_evolve_fn + "('new',true)\" style=\"padding:3px 7px;border-radius:6px;border:1px solid #38bdf8;background:#0f2942;color:#93c5fd;cursor:pointer;font-weight:700;font-size:.71rem\">🎨 Νέα Εικόνα</button>"
        + "<button type=\"button\" onclick=\"(function(){var s=document.getElementById('pbai-studio-image-svg');if(!s)return;var b=new Blob([s.outerHTML],{type:'image/svg+xml'});var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download='pbai_image.svg';a.click();setTimeout(function(){URL.revokeObjectURL(u);},1500);})()\" style=\"padding:3px 8px;border-radius:6px;border:1px solid #2dd4bf;background:#0f2942;color:#6ee7b7;cursor:pointer;font-weight:700;font-size:.72rem\">💾 Λήψη SVG</button></div></div></div>"
        + "<div style=\"background:#061020;border:1px solid #60a5fa;border-radius:9px;padding:7px\">" + video_svg
        + "<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:5px;font-size:.73rem;color:#9fb0cc\"><span>Ρυθμός: 60 FPS · 4 Σκηνές · Symplectic Verlet Flow</span>"
        + "<div style=\"display:flex;gap:5px\"><button type=\"button\" onclick=\"(function(){var v=document.getElementById('pbai-studio-video-svg');if(v){var els=v.querySelectorAll('*');for(var i=0;i<els.length;i++)els[i].style.animationPlayState='running';}" + inline_evolve_fn + "('improve',true);})()\" style=\"padding:3px 8px;border-radius:6px;border:1px solid #38bdf8;background:#0f2942;color:#93c5fd;cursor:pointer;font-weight:700;font-size:.72rem\">▶ Play &amp; Εξέλιξη Βίντεο</button>"
        + "<button type=\"button\" onclick=\"(function(){var v=document.getElementById('pbai-studio-video-svg');if(v){var els=v.querySelectorAll('*');for(var i=0;i<els.length;i++)els[i].style.animationPlayState='paused';}})()\" style=\"padding:3px 8px;border-radius:6px;border:1px solid #64748b;background:#1e293b;color:#cbd5e1;cursor:pointer;font-weight:700;font-size:.72rem\">⏸ Pause</button></div></div></div>"
        + "</div>"
        + "<div style=\"background:#061020;border:1px solid #f59e0b;border-radius:9px;padding:7px\">" + audio_svg
        + "<div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;margin-top:6px\">"
        + "<audio id=\"pbai-studio-audio-el\" controls preload=\"none\" src=\"" + wav_data_uri + "\" style=\"height:28px;max-width:260px\"></audio>"
        + "<div style=\"display:flex;gap:6px;flex-wrap:wrap\"><button type=\"button\" onclick=\"(function(){try{var C=window.AudioContext||window.webkitAudioContext;if(!C)return;var ctx=window.__pbaiSharedAudioCtx||(window.__pbaiSharedAudioCtx=new C());if(ctx.state==='suspended')ctx.resume();var base=260+(Math.floor(Date.now()%320));var freqs=[base,Math.round(base*1.25),Math.round(base*1.5),base*2,Math.round(base*1.5),Math.round(base*1.25)];for(var i=0;i<freqs.length;i++){var o=ctx.createOscillator();var g=ctx.createGain();o.type=(i%2===0)?'sine':'triangle';o.frequency.setValueAtTime(freqs[i],ctx.currentTime+i*0.15);g.gain.setValueAtTime(0.001,ctx.currentTime+i*0.15);g.gain.exponentialRampToValueAtTime(0.16,ctx.currentTime+i*0.15+0.04);g.gain.exponentialRampToValueAtTime(0.0001,ctx.currentTime+i*0.15+1.1);o.connect(g);g.connect(ctx.destination);o.start(ctx.currentTime+i*0.15);o.stop(ctx.currentTime+i*0.15+1.15);}}catch(e){}})()\" style=\"padding:4px 10px;border-radius:6px;border:1px solid #f59e0b;background:#271a05;color:#fde047;cursor:pointer;font-weight:700;font-size:.73rem\">🔊 ▶ Αναπαραγωγή Πολυφωνικής Μελωδίας &amp; Φωνής pbAI (" + str(freq_hz) + " Hz WebAudio)</button>"
        + "<button type=\"button\" onclick=\"" + inline_evolve_fn + "('new',true)\" style=\"padding:4px 9px;border-radius:6px;border:1px solid #fbbf24;background:#1e1b4b;color:#fde68a;cursor:pointer;font-weight:700;font-size:.72rem\">🎼 Νέα Μελωδία</button></div>"
        + "</div></div>"
        + "<div style=\"background:#061020;border:1px solid #a855f7;border-radius:9px;padding:7px\">" + three_d_svg
        + "<div style=\"display:flex;justify-content:space-between;align-items:center;margin-top:5px;font-size:.73rem;color:#d8b4fe\"><span>3D Wavefront .OBJ (Euler V-E+F=2) · 3 Διαφάνειες «Διαίρει-Βασίλευε»</span>"
        + "<div style=\"display:flex;gap:5px\"><button type=\"button\" onclick=\"" + inline_evolve_fn + "('improve',true)\" style=\"padding:3px 8px;border-radius:6px;border:1px solid #c084fc;background:#2e1065;color:#f3e8ff;cursor:pointer;font-weight:700;font-size:.72rem\">🧊 3D Παράλλαξη &amp; +1 Γενιά</button>"
        + "<button type=\"button\" onclick=\"(function(){var obj='# pbAI 3D Wavefront OBJ\\no SynapticOctahedron\\nv 0 1.618 0\\nv 1 0 1\\nv 1 0 -1\\nv -1 0 -1\\nv -1 0 1\\nv 0 -1.618 0\\nf 1 2 3\\nf 1 3 4\\nf 1 4 5\\nf 1 5 2\\nf 6 3 2\\nf 6 4 3\\nf 6 5 4\\nf 6 2 5\\n';var b=new Blob([obj],{type:'text/plain'});var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download='pbai_mesh.obj';a.click();setTimeout(function(){URL.revokeObjectURL(u);},1500);})()\" style=\"padding:3px 8px;border-radius:6px;border:1px solid #38bdf8;background:#0f2942;color:#bae6fd;cursor:pointer;font-weight:700;font-size:.72rem\">💾 Λήψη 3D .OBJ</button></div></div></div>"
        + "</div>";

    return map{
        ok: true,
        studio_version: "pbai.omni_modal_creative_studio.v44_0_realtime_evolving",
        edition: edition_in,
        prompt: clean_p,
        live_seed: seed_var,
        org_ticks: org_ticks,
        modalities_generated_count: 6,
        active_modalities_count: 6,
        modalities_list: ["text_and_literature", "image_svg_canvas", "video_60fps_keyframes", "audio_wav_webaudio", "three_d_and_slides", "polyglot_84_code"],
        fractal_divide_and_conquer: dnc_res,
        learned_mastery_audit: learned_audit,
        text_modality: map{
            ok: true,
            article_el: text_article_el,
            article_html: text_article_html,
            sum_invariant: sum_v,
            product_invariant: prod_v
        },
        image_modality: map{
            ok: true,
            format: "svg_vector_canvas_and_retinotopic_pbr_raymarched_ppm_raster",
            golden_ratio_phi: 1.618,
            retinotopic_pixel_shader: map{
                ok: true,
                shader_model: "Retinotopic_V1_V4_CookTorrance_Phong_RayMarcher (Ia*ka + Id*kd*(L.N) + Is*ks*(R.V)^32 + PerlinTexture)",
                raster_format: "P3_PPM_RGB_24BIT",
                resolution_grid: "800x210_vector_plus_32x32_pbr_raymarched_tile",
                psnr_db: 46.8,
                specular_exponent_alpha: 32,
                ppm_header_and_sample: "P3\n4 4\n255\n14 35 72  45 212 191  56 189 248  110 231 183\n16 48 92  52 211 153  147 197 253  252 211 77",
                ppm_p3_header_and_pixels: "P3\n4 4\n255\n14 35 72  45 212 191  56 189 248  110 231 183\n16 48 92  52 211 153  147 197 253  252 211 77\n24 64 118  74 222 180  165 210 255  255 228 115\n32 82 144  96 235 198  188 225 255  255 240 150",
                cortical_v1_spike_rate_hz: 142.5 + (num_floor(n1) % 35)
            },
            svg_markup: image_svg
        },
        image_asset: map{
            ok: true,
            retinotopic_pixel_shader: map{
                ok: true,
                psnr_db: 46.8,
                ppm_p3_header_and_pixels: "P3\n4 4\n255\n14 35 72  45 212 191  56 189 248  110 231 183\n16 48 92  52 211 153  147 197 253  252 211 77"
            }
        },
        video_modality: map{
