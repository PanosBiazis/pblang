    let table_html = "<table style=\"width:100%;max-width:100%;table-layout:fixed;border-collapse:collapse;font-size:.75rem;color:#eef4ff;background:#0a1426;border:1px solid #29436b;border-radius:8px;word-break:break-word;overflow-wrap:anywhere\">"
