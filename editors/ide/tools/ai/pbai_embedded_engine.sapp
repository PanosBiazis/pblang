    let flowchart_svg = "<svg viewBox=\"0 0 860 118\" style=\"width:100%;max-width:100%;height:auto;display:block;background:#091326;border:1px solid #29436b;border-radius:10px;padding:6px;box-sizing:border-box\" role=\"img\" aria-label=\"Interactive Execution Flowchart DAG\">"
