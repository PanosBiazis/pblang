        },
        audio_speech_asset: map{
            ok: true,
            tonotopic_formant_speech: map{
                ok: true,
                mos_naturalness_score: 4.88,
                vowel_formant_table_hz: [
                    map{ vowel: "a", f1_hz: 730, f2_hz: 1090, f3_hz: 2440 },
                    map{ vowel: "e", f1_hz: 530, f2_hz: 1840, f3_hz: 2480 },
                    map{ vowel: "i", f1_hz: 270, f2_hz: 2290, f3_hz: 3010 },
                    map{ vowel: "o", f1_hz: 570, f2_hz: 840, f3_hz: 2410 },
