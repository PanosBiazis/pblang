        + "</svg>";

    // 5. 3D Holographic Polyhedron & Divide-and-Conquer Slides (GPU-composited CSS rotation)
    let three_d_svg = "<svg id=\"pbai-studio-3d-svg\" viewBox=\"0 0 800 132\" style=\"width:100%;max-width:100%;height:auto;display:block;background:#081024;border:1px solid #a855f7;border-radius:10px;box-sizing:border-box\" role=\"img\" aria-label=\"pbAI 3D Polyhedral Mesh &amp; Slide Deck\">"
        + "<text id=\"pbai-3d-title\" x=\"16\" y=\"22\" fill=\"#e9d5ff\" font-size=\"11.1\" font-weight=\"bold\">🧊 3D Ολογραφικό Πλέγμα Wavefront .OBJ (Euler V-E+F=2) &amp; Παρουσίαση «Διαίρει και Βασίλευε» (24 Αλγόριθμοι)</text>"
