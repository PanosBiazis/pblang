        + "<g transform=\"translate(400,88)\"><polygon id=\"pbai-vid-rotor\" class=\"pb-spin-slow\" points=\"0,-28 26,18 -26,18\" fill=\"rgba(56,189,248,0.28)\" stroke=\"#38bdf8\" stroke-width=\"2\"/></g>"
