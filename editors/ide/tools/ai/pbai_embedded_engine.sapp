            code: "// Pure-PBLang Smart Lazy-Idle Cache & Memory Evictor\nfn create_lazy_cache() {\n    return map{ store: map{}, hits: 0, evicted: 0 };\n}\n\nfn cache_put(cache, key, val) {\n    cache.store[str(key)] = val;\n    return cache;\n}\n\nfn evict_on_idle(cache) {\n    cache.store = map{};\n    cache.evicted = cache.evicted + 1;\n    return cache;\n}\n\nexport create_lazy_cache, cache_put, evict_on_idle;\n",
