            natural_answer_en: ans_en,
            natural_answer_el: ans_el,
            code: "// Pure-PBLang Step-by-Step Linear Equation Solver (a*x + b = c)\nfn solve_linear_equation(a, b, c) {\n    if a == 0 {\n        return map{ ok: false, error: \"degenerate_zero_coefficient\", x: nil };\n    }\n    let x = num_floor(((c - b) / a) * 10000.0 + 0.5) / 10000.0;\n    let lhs = num_floor(((a * x) + b) * 10000.0 + 0.5) / 10000.0;\n    return map{ ok: lhs == c, a: a, b: b, c: c, x: x, verified_lhs: lhs };\n}\n\nexport solve_linear_equation;\n",
            test_code: "// Verification Test for Linear Equation Solver\nlet sol = solve_linear_equation(" + str(a) + ", " + str(b) + ", " + str(c) + ");\nassert(sol.ok == true and sol.x == " + str(x_val) + " and sol.verified_lhs == " + str(c) + ");\nprint \"Linear equation step-by-step solver test: PASS\";\n"
        };
    }

    // W. Quadratic Equation Discriminant & Vieta Root Solver (a*x^2 + b*x + c = 0, Dynamic Parameterization)
    if str_contains(low, "quadratic") or str_contains(low, "δευτεροβάθμ") or (str_contains(clean_prompt, "x^2") and str_contains(clean_prompt, "=")) {
        let qc = _parse_quadratic_coeffs(clean_prompt);
