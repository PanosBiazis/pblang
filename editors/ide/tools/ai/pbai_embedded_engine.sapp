    };

    let is_benchmark_comparison_query = str_contains(low, "σύγκρι") or str_contains(low, "συγκρι") or str_contains(low, "compare") or str_contains(low, "150") or str_contains(low, "120");
    let bion_open = execute_bion_cortical_4phase_language_brain(map{
