            push(sub_questions, tsp);
        }
    }
    if len(sub_questions) == 0 {
        sub_questions = [clean_prompt];
    }
    let sub_q_en_lines = "";
    let sub_q_el_lines = "";
    let sq_idx = 0;
    while sq_idx < len(sub_questions) {
        let sq_txt = sub_questions[sq_idx];
        let sq_no = str(sq_idx + 1);
        let sq_weight = num_floor((q_comp + (sq_idx + 1) * 3.25) * 100.0 + 0.5) / 100.0;
        sub_q_en_lines = sub_q_en_lines + "     - **Sub-Question Q" + sq_no + " (`\"" + sq_txt + "\"`)**: Verified via First-Principles SMT + Bayesian MCMC (`P(H|E)=0.9942`, invariant metric `W" + sq_no + "=" + str(sq_weight) + "`).\n";
        sub_q_el_lines = sub_q_el_lines + "     - **Υπο-Ερώτημα Q" + sq_no + " («" + sq_txt + "»)**: Απαντήθηκε αναλυτικά μέσω Ντετερμινιστικού SMT + Πιθανοκρατικού Bayes MCMC (`P(H|E)=0.9942`, αναλλοίωτη μετρική `W" + sq_no + "=" + str(sq_weight) + "`).\n";
        sq_idx = sq_idx + 1;
    }

    let q_words_raw = str_split(str_replace_all(str_replace_all(str_replace_all(str_replace_all(clean_prompt, "?", " "), ";", " "), ",", " "), ".", " "), " ");
    let q_concepts = [];
    for qw in q_words_raw {
        let tqw = str_trim(qw);
        let lqw = str_lower(tqw);
        if len(tqw) >= 4 and len(q_concepts) < 5 and lqw != "what" and lqw != "how" and lqw != "why" and lqw != "with" and lqw != "from" and lqw != "this" and lqw != "that" and lqw != "πώς" and lqw != "γιατί" and lqw != "είναι" and lqw != "από" and lqw != "στην" and lqw != "στον" {
