        + "<text x=\"215\" y=\"52\" fill=\"#93c5fd\" font-size=\"10.3\" font-weight=\"bold\">Διαφάνεια 1: Divide (Κατάτμηση)</text>"
        + "<text id=\"pbai-slide1-line1\" x=\"215\" y=\"70\" fill=\"#e2e8f0\" font-size=\"9.6\">P → 24 Υποπροβλήματα (x1=" + str(n1) + ", x2=" + str(n2) + ")</text>"
        + "<text x=\"215\" y=\"86\" fill=\"#6ee7b7\" font-size=\"9.3\">32 Μοντέλα → 384 Υπομοντέλα</text>"
        + "<text x=\"215\" y=\"103\" fill=\"#38bdf8\" font-size=\"9.1\">4.608 Μικρο &amp; 55.296 Νανο-Μοντέλα</text>"
        + "<rect x=\"400\" y=\"34\" width=\"184\" height=\"82\" rx=\"7\" fill=\"#111c38\" stroke=\"#10b981\"/>"
        + "<text x=\"410\" y=\"52\" fill=\"#6ee7b7\" font-size=\"10.3\" font-weight=\"bold\">Διαφάνεια 2: 24 Αλγόριθμοι</text>"
