        + "<circle id=\"pbai-img-sun-ring\" class=\"pb-spin-slow\" cx=\"" + str(cx1) + "\" cy=\"" + str(cy1) + "\" r=\"" + str(r_orb) + "\" fill=\"none\" stroke=\"#6ee7b7\" stroke-width=\"2\" stroke-dasharray=\"6,4\"/>"
        + "<g id=\"pbai-img-dnc-tree\">"
        + "<polygon id=\"pbai-img-poly1\" points=\"" + str(tx_mid) + ",26 " + str(tx_mid + 75) + ",148 " + str(tx_mid - 75) + ",148\" fill=\"rgba(56,189,248,0.18)\" stroke=\"#38bdf8\" stroke-width=\"1.8\"/>"
        + "<polygon id=\"pbai-img-poly2\" points=\"" + str(dx_mid) + ",34 " + str(dx_mid + 82) + ",108 " + str(dx_mid) + ",164 " + str(dx_mid - 82) + ",108\" fill=\"rgba(168,85,247,0.18)\" stroke=\"#c084fc\" stroke-width=\"1.8\"/>"
        + "<circle id=\"pbai-img-subnode1\" cx=\"" + str(tx_mid) + "\" cy=\"68\" r=\"9\" fill=\"#fcd34d\"/>"
        + "<circle id=\"pbai-img-subnode2\" cx=\"" + str(tx_mid - 42) + "\" cy=\"125\" r=\"7\" fill=\"#38bdf8\"/>"
