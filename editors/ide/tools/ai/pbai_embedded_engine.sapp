        delphi_snippet = "function SolveDomain_Pharmacokinetics(const C0, KeHours: Double): Double; begin Result := C0 * Exp(-0.15 * KeHours); end;";
        csharp_snippet = "public readonly record struct ClinicalBiomarker(double InitialDoseMg, double HalfLifeHours, double SteadyStateConc);";
        sql_snippet = "SELECT patient_id, ROUND((dose_mg * EXP(-ke_rate * elapsed_h))::numeric, 4) AS plasma_conc FROM clinical_pk_trials;";
    } elif str_contains(low, "quantum") or str_contains(low, "relativ") or str_contains(low, "shannon") or str_contains(low, "thermodynam") or str_contains(low, "entropy") or str_contains(low, "κβαντ") or str_contains(low, "θερμοδυναμ") or str_contains(low, "φυσικ") {
        dom_focus_en = "Hamiltonian Action Conservation, Friston Variational Free-Energy F = D_KL(q||p) - ln Z, and Shannon Capacity C = B*log2(1 + S/N)";
        dom_focus_el = "Διατήρηση Ενέργειας Hamiltonian, Ελαχιστοποίηση Ελεύθερης Ενέργειας Friston F = D_KL(q||p) - ln Z & Χωρητικότητα Shannon C = B*log2(1 + S/N)";
        delphi_snippet = "function SolveDomain_HamiltonianFreeEnergy(const EnergyH, EntropyS: Double): Double; begin Result := EnergyH - (0.5 * EntropyS); end;";
        csharp_snippet = "public readonly record struct QuantumObservable(double HamiltonianH, double VariationalFreeEnergy, int SurfaceCodeD);";
        sql_snippet = "SELECT run_id, ROUND((energy_h - temp_k * entropy_s)::numeric, 6) AS helmholtz_free_energy FROM quantum_lattice_runs;";
    } elif str_contains(low, "econom") or str_contains(low, "financ") or str_contains(low, "market") or str_contains(low, "game theory") or str_contains(low, "nash") or str_contains(low, "οικονομ") or str_contains(low, "αγορ") or str_contains(low, "επιτόκ") or str_contains(low, "κόστος") {
        dom_focus_en = "Pareto-Nash Strategic Equilibrium, Convex Risk-Return Optimization, and Exact Fixed-Point Monetary Conservation";
        dom_focus_el = "Στρατηγική Ισορροπία Pareto-Nash, Κυρτή Βελτιστοποίηση Κινδύνου-Απόδοσης & Νομισματική Ακρίβεια Σταθερής Υποδιαστολής";
        delphi_snippet = "function SolveDomain_FixedPointLedger(const Principal, YieldBps: Currency): Currency; begin Result := Principal + (Principal * YieldBps / 10000); end;";
