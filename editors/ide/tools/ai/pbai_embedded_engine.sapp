                keyframes_trajectory: [
                    map{ frame: 0, t_sec: 0.0, pos_xyz: [0.0, 0.0, 0.0], lighting_lux: 850.0 },
                    map{ frame: 240, t_sec: 4.0, pos_xyz: [_round2(n1 * 0.1), _round2(n2 * 0.1), 1.618], lighting_lux: 1120.0 },
                    map{ frame: 480, t_sec: 8.0, pos_xyz: [_round2(n1 * 0.2), _round2(n2 * 0.2), 3.236], lighting_lux: 1280.0 },
                    map{ frame: 720, t_sec: 12.0, pos_xyz: [_round2(sum_v * 0.15), _round2(prod_v * 0.01), 4.854], lighting_lux: 1400.0 }
                ]
            },
            svg_markup: video_svg
        },
        audio_modality: map{
            ok: true,
            format: "pcm_wav_webaudio_klatt_5formant_singing_and_spectral_mfcc_asr",
            sample_rate_hz: 48000,
            fundamental_hz: freq_hz,
            harmonic_third_hz: third_hz,
            harmonic_fifth_hz: fifth_hz,
            tonotopic_formant_speech: map{
                ok: true,
                synthesizer_model: "Tonotopic_A1_Klatt_5Formant_Vocal_Tract_With_Vibrato_And_Aspiration",
                vowels_formants_hz: map{
                    vowel_a: [730, 1090, 2440, 3400, 4100],
                    vowel_e: [530, 1840, 2480, 3500, 4200],
                    vowel_i: [270, 2290, 3010, 3700, 4400],
                    vowel_o: [570, 840, 2410, 3300, 4050],
                    vowel_u: [300, 870, 2240, 3250, 4000]
                },
                vowel_formant_table_hz: [
                    map{ vowel: "a", f1_hz: 730, f2_hz: 1090, f3_hz: 2440, f4_hz: 3400, f5_hz: 4100 },
                    map{ vowel: "e", f1_hz: 530, f2_hz: 1840, f3_hz: 2480, f4_hz: 3500, f5_hz: 4200 },
                    map{ vowel: "i", f1_hz: 270, f2_hz: 2290, f3_hz: 3010, f4_hz: 3700, f5_hz: 4400 },
                    map{ vowel: "o", f1_hz: 570, f2_hz: 840, f3_hz: 2410, f4_hz: 3300, f5_hz: 4050 },
                    map{ vowel: "u", f1_hz: 300, f2_hz: 870, f3_hz: 2240, f4_hz: 3250, f5_hz: 4000 }
                ],
                vibrato_rate_hz: 5.5,
