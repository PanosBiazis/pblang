            natural_answer_en: ans_en,
            natural_answer_el: ans_el,
            code: "// Pure-PBLang Bayesian Posterior & Binomial Combinations C(n, k) Solver\nfn bayesian_posterior_pct(sens, spec, prev) {\n    let tp = sens * prev;\n    let fp = (1.0 - spec) * (1.0 - prev);\n    if (tp + fp) <= 0.0 { return 0.0; }\n    return num_floor(((tp / (tp + fp)) * 100.0) * 100.0 + 0.5) / 100.0;\n}\n\nfn combinations_ncr(n, k) {\n    if k < 0 or k > n { return 0; }\n    if k == 0 or k == n { return 1; }\n    let res = 1;\n    let i = 1;\n    while i <= k {\n        res = num_floor((res * (n - i + 1)) / i);\n        i = i + 1;\n    }\n    return res;\n}\n\nexport bayesian_posterior_pct, combinations_ncr;\n",
            test_code: "// Verification Test for Bayes' Theorem & Combinatorics\nassert(bayesian_posterior_pct(0.95, 0.90, 0.10) == 51.35);\nassert(combinations_ncr(" + str(n_comb) + ", " + str(k_comb) + ") == " + str(c_val) + " and combinations_ncr(10, 3) == 120);\nprint \"Bayesian posterior & combinatorics C(n,k) test: PASS\";\n"
        };
    }

    // Z1. Deep PBLang Compiler Diagnostics, Data Structures (Array vs Map), Closures & Lockfile Encyclopedia
    if str_contains(low, "undefined global") or str_contains(low, "lockfile") or str_contains(low, "pblang.lock") or str_contains(low, "arrays and maps") or str_contains(low, "array vs map") or str_contains(low, "closures in pblang") or str_contains(low, "higher-order") or ((str_contains(low, "how does") or str_contains(low, "what is the difference")) and str_contains(low, "pblang")) {
        let ans_en = "1) [DIRECT VERIFIED ANSWER — PBLANG COMPILER & LANGUAGE ARCHITECTURE]:\n"
            + "   • Arrays vs Maps: `array` (`[a, b, c]`) provides O(1) contiguous indexed access and sequential iteration (`for x in arr`), whereas `map` (`map{ key: val }`) provides structured key-value lookup verified with `map_has(m, \"key\")`.\n"
            + "   • Compiler Diagnostics (`undefined global` & `elif`): In PBLang, top-level variables/functions must be declared before use; `if ... { ... } else { ... }` works as both an expression and a statement, while `elif` is strictly a statement-level branch.\n"
            + "   • Cryptographic Lockfile (`pblang.lock`): Every project pins the exact SHA-256 digest of `stdlib` so unauthorized stdlib drift fails closed before execution.\n"
            + "2) [ANALYTICAL COMPILER & VM INTERNALS]: PBLang compiles source ASTs into deterministic register/stack bytecode with lexical closures (first-class `fn(x) { ... }` values), zero-idle lazy module caching (`_MOD_CACHE`), and explicit `export sym1, sym2;` module boundaries.\n"
            + "3) [FORMAL EVIDENCE & COMPLEXITY INVARIANTS]: Array index: O(1); `push`/`pop`: amortized O(1); `try expr catch fallback`: zero-cost recovery on happy path.\n"
            + "4) [EXECUTABLE PURE-PBLANG VERIFICATION]: `verify_pblang_language_semantics()` demonstrates closures, arrays, maps, and `try/catch` below.";
        let ans_el = "1) [ΑΜΕΣΗ ΕΠΑΛΗΘΕΥΜΕΝΗ ΑΠΑΝΤΗΣΗ — ΑΡΧΙΤΕΚΤΟΝΙΚΗ PBLANG]:\n"
            + "   • Arrays vs Maps: Τα `array` (`[a, b, c]`) προσφέρουν O(1) σειριακή προσπέλαση, ενώ τα `map` (`map{ key: val }`) προσφέρουν δομημένη αναζήτηση κλειδιού-τιμής με `map_has(m, \"key\")`.\n"
            + "   • Διαγνωστικά Μεταγλωττιστή (`undefined global` & `elif`): Κάθε σύμβολο δηλώνεται πριν τη χρήση του, ενώ το `elif` χρησιμοποιείται σε εντολές `if`.\n"
            + "   • Κρυπτογραφικό `pblang.lock`: Επαληθεύει το SHA-256 της `stdlib` πριν την εκτέλεση.\n"
            + "2) [ΤΕΚΜΗΡΙΩΣΗ & ΠΟΛΥΠΛΟΚΟΤΗΤΑ]: Υποστηρίζονται closures πρώτης τάξης (`fn(x) { ... }`), lazy φόρτωση αρθρωμάτων και `try ... catch`.\n"
            + "3) [ΕΚΤΕΛΕΣΙΜΗ ΕΠΑΛΗΘΕΥΣΗ ΣΕ PURE PBLANG]: Η συνάρτηση `verify_pblang_language_semantics()` ελέγχει όλες τις δομές στην πράξη.";
        return map{
            domain: "pblang_compiler_and_language_encyclopedia",
            natural_answer: _localize_answer(edition, lang, ans_en, ans_el),
            natural_answer_en: ans_en,
            natural_answer_el: ans_el,
            code: "// Pure-PBLang Language Semantics: Higher-Order Closures, Arrays, Maps & Try/Catch\nfn make_multiplier_closure(factor) {\n    return fn(x) { return x * factor; };\n}\n\nfn verify_pblang_language_semantics() {\n    let triple = make_multiplier_closure(3);\n    let arr = [10, 20, 30];\n    let transformed = [];\n    for v in arr { push(transformed, triple(v)); }\n    let meta = map{ lang: \"PBLang\", pure: true, count: len(transformed) };\n    let safe_parse = try json_parse(\"{invalid\") catch map{ recovered: true };\n    return map{\n        ok: meta.pure and safe_parse.recovered and transformed[2] == 90,\n        transformed: transformed,\n        meta: meta\n    };\n}\n\nexport make_multiplier_closure, verify_pblang_language_semantics;\n",
            test_code: "// Verification Test for PBLang Language Semantics & Closures\nlet sem = verify_pblang_language_semantics();\nassert(sem.ok == true and sem.transformed[0] == 30 and sem.transformed[2] == 90);\nprint \"PBLang compiler & language semantics encyclopedia test: PASS\";\n"
        };
