        }
        let sq = num_sqrt(disc);
        let r1 = num_floor((((0.0 - qb) - sq) / (2.0 * qa)) * 10000.0 + 0.5) / 10000.0;
        let r2 = num_floor((((0.0 - qb) + sq) / (2.0 * qa)) * 10000.0 + 0.5) / 10000.0;
