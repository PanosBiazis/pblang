fn _strip_greek_accents(text) {
    let s = str(text);
    let acc = ["ά", "έ", "ή", "ί", "ό", "ύ", "ώ", "ϊ", "ϋ", "ΐ", "ΰ", "Ά", "Έ", "Ή", "Ί", "Ό", "Ύ", "Ώ", "Ϊ", "Ϋ"];
    let plain = ["α", "ε", "η", "ι", "ο", "υ", "ω", "ι", "υ", "ι", "υ", "α", "ε", "η", "ι", "ο", "υ", "ω", "ι", "υ"];
    let i = 0;
    while i < len(acc) {
        if str_contains(s, acc[i]) {
            s = str_replace_all(s, acc[i], plain[i]);
        }
        i = i + 1;
    }
    return s;
}

fn _analyze_single_word_morphology_and_pos(raw_token) {
    let clean_w = str_trim(str_replace_all(str_replace_all(str_replace_all(str_replace_all(str_replace_all(str_replace_all(str(raw_token), ",", ""), ".", ""), ";", ""), "?", ""), "!", ""), ":", ""));
    let low_w = _lower_greek_and_ascii(clean_w);
    let norm_w = _strip_greek_accents(low_w);
    if clean_w == "" {
        return map{ token: "", pos_el: "Κενό", pos_en: "Empty", morphology_el: "-", syntactic_role_el: "-" };
    }

    // 0. Interjections / Greetings & Conversational Particles (Επιφωνήματα & Χαιρετισμοί)
    if norm_w == "γεια" or norm_w == "καλημερα" or norm_w == "καλησπερα" or norm_w == "καληνυχτα" or norm_w == "χαιρετε" or norm_w == "ευχαριστω" or norm_w == "παρακαλω" or norm_w == "ναι" or norm_w == "οχι" or norm_w == "hello" or norm_w == "hi" or norm_w == "hey" or norm_w == "thanks" {
        return map{
            token: clean_w,
            language: if str_contains("γειακαλημερακαλησπερακαληνυχταχαιρετεευχαριστωπαρακαλωναιοχι", norm_w) { "el" } else { "en" },
            pos_el: "Επιφώνημα / Χαιρετισμός (Interjection · Άκλιτο)",
            pos_en: "Interjection / Greeting (Invariable)",
            morphology_el: "Άκλιτο επιφώνημα / λεξικός δείκτης επικοινωνιακής πράξης",
            syntactic_role_el: "Δείκτης Χαιρετισμού / Επικοινωνιακής Πράξης (Discourse / Greeting Marker)"
        };
    }

    // 0b. Subjunctive, Future & Negation Particles (Μόρια: να, θα, ας, δεν, μην)
    if norm_w == "να" or norm_w == "θα" or norm_w == "ας" or norm_w == "δεν" or norm_w == "δε" or norm_w == "μην" or norm_w == "μη" or norm_w == "not" {
        let part_type = "Ρηματικό Μόριο";
        if norm_w == "να" { part_type = "Μόριο Υποτακτικής Έγκλισης («να» + Ρήμα)"; }
        elif norm_w == "θα" { part_type = "Μόριο Μελλοντικού/Δυνητικού Χρόνου («θα» + Ρήμα)"; }
        elif norm_w == "ας" { part_type = "Προτρεπτικό/Ευκτικό Μόριο («ας» + Ρήμα)"; }
        else { part_type = "Αρνητικό Μόριο («δεν/μην» + Ρήμα)"; }
        return map{
            token: clean_w,
            language: if norm_w == "not" { "en" } else { "el" },
            pos_el: "Μόριο (Particle · Άκλιτο)",
            pos_en: "Verbal Particle (Subjunctive / Future / Negation)",
            morphology_el: part_type,
            syntactic_role_el: "Προρηματικό Μόριο Ρηματικής Φράσης (Pre-Verbal VP Particle)"
        };
    }

    // 1. Greek Articles (Άρθρα: Οριστικά & Αόριστα)
    if low_w == "ο" or low_w == "η" or low_w == "το" or low_w == "του" or low_w == "της" or low_w == "τον" or low_w == "την" or low_w == "τη" or low_w == "οι" or low_w == "τα" or low_w == "των" or low_w == "τους" or low_w == "τις" or norm_w == "ενας" or norm_w == "μια" or norm_w == "ενα" or norm_w == "εναν" {
        let art_morph = "Οριστικό Άρθρο";
        if low_w == "ο" { art_morph = "Οριστικό Άρθρο · Αρσενικό · Ενικός · Ονομαστική"; }
        elif low_w == "η" { art_morph = "Οριστικό Άρθρο · Θηλυκό · Ενικός · Ονομαστική"; }
        elif low_w == "το" { art_morph = "Οριστικό Άρθρο · Ουδέτερο · Ενικός · Ονομαστική/Αιτιατική"; }
        elif low_w == "του" { art_morph = "Οριστικό Άρθρο · Αρσενικό/Ουδέτερο · Ενικός · Γενική"; }
        elif low_w == "της" { art_morph = "Οριστικό Άρθρο · Θηλυκό · Ενικός · Γενική"; }
        elif low_w == "τον" { art_morph = "Οριστικό Άρθρο · Αρσενικό · Ενικός · Αιτιατική"; }
        elif low_w == "την" or low_w == "τη" { art_morph = "Οριστικό Άρθρο · Θηλυκό · Ενικός · Αιτιατική"; }
        elif low_w == "οι" { art_morph = "Οριστικό Άρθρο · Αρσενικό/Θηλυκό · Πληθυντικός · Ονομαστική"; }
        elif low_w == "τα" { art_morph = "Οριστικό Άρθρο · Ουδέτερο · Πληθυντικός · Ονομαστική/Αιτιατική"; }
        elif low_w == "των" { art_morph = "Οριστικό Άρθρο · Πληθυντικός · Γενική (και των 3 γενών)"; }
        elif low_w == "τους" { art_morph = "Οριστικό Άρθρο · Αρσενικό · Πληθυντικός · Αιτιατική"; }
        elif low_w == "τις" { art_morph = "Οριστικό Άρθρο · Θηλυκό · Πληθυντικός · Αιτιατική"; }
        else { art_morph = "Αόριστο Άρθρο · Ενικός"; }
        return map{
            token: clean_w,
            language: "el",
            pos_el: "Άρθρο (Article / Determiner)",
            pos_en: "Article / Determiner",
            morphology_el: art_morph,
            syntactic_role_el: "Προσδιορισμός Ονοματικής Φράσης (NP Determiner)"
        };
    }

    // 2. English / Romance / German Articles
    if low_w == "the" or low_w == "a" or low_w == "an" or low_w == "le" or low_w == "la" or low_w == "les" or low_w == "un" or low_w == "une" or low_w == "der" or low_w == "die" or low_w == "das" or low_w == "el" or low_w == "los" or low_w == "las" or low_w == "il" or low_w == "lo" {
        return map{
            token: clean_w,
            language: "multilingual_eu",
            pos_el: "Άρθρο (Article / Determiner)",
            pos_en: "Article / Determiner",
            morphology_el: "Οριστικό/Αόριστο Άρθρο (" + clean_w + ")",
            syntactic_role_el: "Προσδιορισμός Ονοματικής Φράσης (Determiner)"
        };
    }

    // 3. Conjunctions & Prepositions (Σύνδεσμοι & Προθέσεις)
    if norm_w == "και" or low_w == "ή" or norm_w == "αλλα" or norm_w == "ομως" or norm_w == "οτι" or norm_w == "επειδη" or norm_w == "αν" or norm_w == "οταν" or norm_w == "ενω" or low_w == "and" or low_w == "or" or low_w == "but" or low_w == "because" or low_w == "if" or low_w == "when" or low_w == "et" or low_w == "und" or low_w == "y" {
        return map{
            token: clean_w,
            language: if str_contains("καιήαλλαομωςοτιεπειδηανοτανενω", norm_w) { "el" } else { "en" },
            pos_el: "Σύνδεσμος (Conjunction · Άκλιτο)",
            pos_en: "Conjunction (Invariable)",
            morphology_el: "Άκλιτο μέρος του λόγου (Συμπλεκτικός / Αντιθετικός / Αιτιολογικός / Υποθετικός Σύνδεσμος)",
            syntactic_role_el: "Σύνδεση Όρων ή Προτάσεων (Coordinator / Subordinator)"
        };
    }
    if norm_w == "σε" or norm_w == "απο" or norm_w == "για" or norm_w == "με" or norm_w == "προς" or norm_w == "κατα" or norm_w == "μετα" or norm_w == "χωρις" or norm_w == "στον" or norm_w == "στην" or norm_w == "στη" or norm_w == "στο" or norm_w == "στους" or norm_w == "στις" or norm_w == "στα" or low_w == "in" or low_w == "on" or low_w == "at" or low_w == "from" or low_w == "to" or low_w == "with" or low_w == "by" or low_w == "for" or low_w == "of" {
        return map{
            token: clean_w,
            language: if str_contains("σεαπογιαμεπροςκαταμεταχωριςστονστηνστηστοστουςστιςστα", norm_w) { "el" } else { "en" },
            pos_el: "Πρόθεση (Preposition · Άκλιτο)",
            pos_en: "Preposition (Invariable)",
            morphology_el: "Άκλιτο μέρος του λόγου (Εμπρόθετος προσδιορισμός)",
            syntactic_role_el: "Κεφαλή Εμπρόθετης Φράσης (Prepositional Phrase Head)"
        };
    }

    // 4. Pronouns & Question Words (Αντωνυμίες & Ερωτηματικές Λέξεις)
    if norm_w == "εγω" or norm_w == "εσυ" or norm_w == "αυτος" or norm_w == "αυτη" or norm_w == "αυτο" or norm_w == "εμεις" or norm_w == "εσεις" or norm_w == "αυτοι" or norm_w == "μου" or norm_w == "σου" or norm_w == "μας" or norm_w == "σας" or norm_w == "ποιος" or norm_w == "ποια" or norm_w == "ποιο" or norm_w == "ποιον" or norm_w == "ποιαν" or norm_w == "τι" or norm_w == "καθε" or norm_w == "ολα" or norm_w == "ολες" or norm_w == "ολοι" or low_w == "i" or low_w == "you" or low_w == "he" or low_w == "she" or low_w == "it" or low_w == "we" or low_w == "they" or low_w == "who" or low_w == "what" {
        return map{
            token: clean_w,
            language: if str_contains("εγωεσυαυτοςαυτηαυτοεμειςεσειςμουσουμαςσαςποιοςποιαποιοτικαθεολαολεςολοι", norm_w) { "el" } else { "en" },
            pos_el: "Αντωνυμία (Pronoun)",
            pos_en: "Pronoun",
            morphology_el: "Προσωπική / Κτητική / Ερωτηματική / Οριστική Αντωνυμία",
            syntactic_role_el: "Υποκείμενο / Αντικείμενο / Κτητικός Προσδιορισμός"
        };
    }

    // 5. Greek Morphological Suffix Analysis (Ρήματα, Επίθετα, Ουσιαστικά, Επιρρήματα)
    let is_greek = _detect_prompt_language(clean_w) == "el";
    if is_greek {
        if norm_w == "ειναι" or norm_w == "ειμαι" or norm_w == "εισαι" or norm_w == "ειμαστε" or norm_w == "ειστε" or norm_w == "ηταν" or norm_w == "ημουν" or norm_w == "ησουν" {
            return map{
                token: clean_w,
                language: "el",
                pos_el: "Ρήμα (Verb · Συνδετικό «είμαι»)",
                pos_en: "Copular Verb (`to be`)",
                morphology_el: "Οριστική Ενεστώτα/Παρατατικού · Φωνή Παθητική/Μέση (Συνδετικό Ρήμα)",
                syntactic_role_el: "Συνδετικό Ρήμα ( Συνδέει το Υποκείμενο με το Κατηγορούμενο )"
            };
        }
        if str_ends_with(norm_w, "ουμε") or str_ends_with(norm_w, "ετε") or str_ends_with(norm_w, "ουν") or str_ends_with(norm_w, "ουνε") or str_ends_with(norm_w, "ω") or str_ends_with(norm_w, "εις") or str_ends_with(norm_w, "ει") or str_ends_with(norm_w, "ομαι") or str_ends_with(norm_w, "εσαι") or str_ends_with(norm_w, "εται") or str_ends_with(norm_w, "ομαστε") or str_ends_with(norm_w, "ονται") or str_ends_with(norm_w, "ουμαι") or str_ends_with(norm_w, "ασαι") or str_ends_with(norm_w, "αται") or str_ends_with(norm_w, "αει") or str_ends_with(norm_w, "αζει") or str_ends_with(norm_w, "ιζει") or str_ends_with(norm_w, "ωνει") or str_ends_with(norm_w, "ευει") or str_ends_with(norm_w, "ουσε") or str_ends_with(norm_w, "ησε") or str_ends_with(norm_w, "ησαν") {
            let v_pers = "γ' ενικό ή α' ενικό · Ενεργητική/Παθητική Φωνή · Οριστική";
            if str_ends_with(norm_w, "ω") { v_pers = "α' πρόσωπο ενικού · Ενεστώτας · Ενεργητική Φωνή · Οριστική"; }
            elif str_ends_with(norm_w, "εις") { v_pers = "β' πρόσωπο ενικού · Ενεστώτας · Ενεργητική Φωνή · Οριστική"; }
            elif str_ends_with(norm_w, "ει") or str_ends_with(norm_w, "αει") { v_pers = "γ' πρόσωπο ενικού · Ενεστώτας · Ενεργητική Φωνή · Οριστική"; }
            elif str_ends_with(norm_w, "ουμε") { v_pers = "α' πρόσωπο πληθυντικού · Ενεστώτας · Ενεργητική Φωνή"; }
            elif str_ends_with(norm_w, "ετε") { v_pers = "β' πρόσωπο πληθυντικού · Ενεστώτας · Ενεργητική Φωνή"; }
            elif str_ends_with(norm_w, "ουν") or str_ends_with(norm_w, "ουνε") { v_pers = "γ' πρόσωπο πληθυντικού · Ενεστώτας · Ενεργητική Φωνή"; }
            elif str_ends_with(norm_w, "ομαι") or str_ends_with(norm_w, "εσαι") or str_ends_with(norm_w, "εται") or str_ends_with(norm_w, "ονται") or str_ends_with(norm_w, "ουμαι") or str_ends_with(norm_w, "ασαι") or str_ends_with(norm_w, "αται") { v_pers = "Παθητική/Μέση Φωνή · Ενεστώτας · Οριστική"; }
            return map{
                token: clean_w,
                language: "el",
                pos_el: "Ρήμα (Verb)",
                pos_en: "Verb",
                morphology_el: v_pers,
                syntactic_role_el: "Ρήμα Πρότασης (Verb / Predicate Head)"
            };
        }
        if str_ends_with(norm_w, "ως") or norm_w == "καλα" or norm_w == "πολυ" or norm_w == "λιγο" or norm_w == "τωρα" or norm_w == "σημερα" or norm_w == "αυριο" or norm_w == "χθες" or norm_w == "εδω" or norm_w == "εκει" or norm_w == "παντα" or norm_w == "ποτε" or norm_w == "που" or norm_w == "πως" or norm_w == "γιατι" or norm_w == "δυνατα" or norm_w == "ψηλα" or norm_w == "μακρια" or norm_w == "κοντα" or norm_w == "γρηγορα" or norm_w == "αργα" {
            return map{
                token: clean_w,
                language: "el",
                pos_el: "Επίρρημα (Adverb · Άκλιτο)",
                pos_en: "Adverb (Invariable)",
                morphology_el: "Επίρρημα Τρόπου / Χρόνου / Τόπου / Ποσού (Άκλιτο)",
                syntactic_role_el: "Επιρρηματικός Προσδιορισμός (Adverbial Modifier)"
            };
        }
        let is_occupational_ikos = (norm_w == "ναυτικος" or norm_w == "ναυτικο" or norm_w == "φυσικος" or norm_w == "φυσικο" or norm_w == "ιστορικος" or norm_w == "ιστορικο" or norm_w == "μηχανικος" or norm_w == "μηχανικο" or norm_w == "μουσικος" or norm_w == "πολιτικος" or norm_w == "μαθηματικος" or norm_w == "χημικος");
        if (not is_occupational_ikos) and (str_ends_with(norm_w, "ικος") or str_ends_with(norm_w, "ικη") or str_ends_with(norm_w, "ικο") or str_ends_with(norm_w, "σιμος") or str_ends_with(norm_w, "ωδης") or str_ends_with(norm_w, "τερος") or str_ends_with(norm_w, "τατος") or norm_w == "καλος" or norm_w == "καλη" or norm_w == "καλο" or norm_w == "σοφος" or norm_w == "σοφη" or norm_w == "σοφο" or norm_w == "γρηγορος" or norm_w == "γρηγορη" or norm_w == "γρηγορο" or norm_w == "μεγαλος" or norm_w == "μεγαλη" or norm_w == "μεγαλο" or norm_w == "μικρος" or norm_w == "μικρη" or norm_w == "μικρο" or norm_w == "ομορφος" or norm_w == "ομορφη" or norm_w == "ομορφο" or norm_w == "δυνατος" or norm_w == "δυνατη" or norm_w == "δυνατο" or norm_w == "εξυπνος" or norm_w == "εξυπνη" or norm_w == "εξυπνο" or norm_w == "ψηλος" or norm_w == "ψηλη" or norm_w == "ψηλο" or norm_w == "παλιος" or norm_w == "παλια" or norm_w == "παλιο" or norm_w == "καθαρος" or norm_w == "καθαρη" or norm_w == "καθαρο" or norm_w == "ησυχος" or norm_w == "ησυχη" or norm_w == "ησυχο" or norm_w == "δυσκολος" or norm_w == "δυσκολη" or norm_w == "δυσκολο" or norm_w == "ευκολος" or norm_w == "ευκολη" or norm_w == "ευκολο" or norm_w == "βαθυς" or norm_w == "βαθια" or norm_w == "βαθεια" or norm_w == "βαθυ" or norm_w == "ενδιαφερων" or norm_w == "ενδιαφερουσα" or norm_w == "ενδιαφερον") {
            return map{
                token: clean_w,
                language: "el",
                pos_el: "Επίθετο (Adjective)",
                pos_en: "Adjective",
                morphology_el: "Κλιτό Επίθετο (3 Γένη · 2 Αριθμοί · 4 Πτώσεις · Παραθετικά: Συγκριτικός & Υπερθετικός)",
                syntactic_role_el: "Επιθετικός Προσδιορισμός ή Κατηγορούμενο"
            };
        }
        let n_gender = "Ουσιαστικό (Κλιτό: Γένος, Αριθμός, Πτώση)";
        if norm_w == "δασος" or norm_w == "πελαγος" or norm_w == "ορος" or norm_w == "εδαφος" or norm_w == "κρατος" or norm_w == "μεγεθος" or norm_w == "βαθος" or norm_w == "υψος" or norm_w == "μηκος" or norm_w == "πλατος" or norm_w == "παθος" or norm_w == "λαθος" or norm_w == "ανθος" or norm_w == "εθνος" or norm_w == "γενος" or norm_w == "μερος" or norm_w == "τελος" or norm_w == "βαρος" or norm_w == "κερδος" or norm_w == "στηθος" or norm_w == "χειλος" or norm_w == "κυρος" or norm_w == "ηθος" or norm_w == "υφος" or norm_w == "ψυχος" or norm_w == "σκοτος" or norm_w == "χαος" or norm_w == "βελος" or norm_w == "ελος" {
            n_gender = "Ουσιαστικό · Ουδέτερο (Τριτόκλιτο σε -ος) · Ενικός · Ονομαστική/Αιτιατική";
        } elif str_ends_with(norm_w, "ος") or str_ends_with(norm_w, "ης") or str_ends_with(norm_w, "ας") {
            n_gender = "Ουσιαστικό · Αρσενικό (ή Κοινό) · Ενικός · Ονομαστική";
        } elif str_ends_with(norm_w, "κομα") or str_ends_with(norm_w, "η") or str_ends_with(norm_w, "ση") or str_ends_with(norm_w, "ξη") or str_ends_with(norm_w, "ψη") or str_ends_with(norm_w, "οτητα") or (str_ends_with(norm_w, "α") and not str_ends_with(norm_w, "μα")) {
            n_gender = "Ουσιαστικό · Θηλυκό · Ενικός · Ονομαστική/Αιτιατική";
        } elif str_ends_with(norm_w, "ο") or (str_ends_with(norm_w, "ι") and not str_ends_with(norm_w, "οι") and not str_ends_with(norm_w, "αι")) or str_ends_with(norm_w, "μα") {
            n_gender = "Ουσιαστικό · Ουδέτερο · Ενικός · Ονομαστική/Αιτιατική";
        } elif str_ends_with(norm_w, "οι") or str_ends_with(norm_w, "ες") {
            n_gender = "Ουσιαστικό · Πληθυντικός Αριθμός · Ονομαστική/Αιτιατική";
        }
        return map{
            token: clean_w,
            language: "el",
            pos_el: "Ουσιαστικό (Noun)",
            pos_en: "Noun",
            morphology_el: n_gender,
            syntactic_role_el: "Υποκείμενο / Αντικείμενο / Πλάγια Πτώση (Nominal Head)"
        };
    }

    // 6. English & International Suffix Analysis
    if str_ends_with(low_w, "ly") and len(low_w) > 3 {
        return map{
            token: clean_w,
            language: "en",
            pos_el: "Επίρρημα (Adverb in `-ly`)",
            pos_en: "Adverb (`-ly` derivation)",
            morphology_el: "Derived Adverb (`stem + -ly`)",
            syntactic_role_el: "Επιρρηματικός Προσδιορισμός (Verb/Clause Modifier)"
        };
    }
    if str_ends_with(low_w, "ing") or str_ends_with(low_w, "ed") or str_ends_with(low_w, "ize") or str_ends_with(low_w, "ify") {
        return map{
            token: clean_w,
            language: "en",
            pos_el: "Ρήμα / Μετοχή (Verb / Participle)",
            pos_en: "Verb / Participle (`-ing` / `-ed` / `-ize`)",
            morphology_el: "Inflected Verb or Participial Form",
            syntactic_role_el: "Ρήμα / Κατηγορούμενο (Predicate)"
        };
    }
    if str_ends_with(low_w, "ful") or str_ends_with(low_w, "less") or str_ends_with(low_w, "ous") or str_ends_with(low_w, "ive") or str_ends_with(low_w, "able") or str_ends_with(low_w, "ible") or low_w == "good" or low_w == "wise" or low_w == "fast" or low_w == "true" {
        return map{
            token: clean_w,
            language: "en",
            pos_el: "Επίθετο (Adjective)",
            pos_en: "Adjective",
            morphology_el: "Qualifying Adjective (Comparative `-er`/`more`, Superlative `-est`/`most`)",
            syntactic_role_el: "Επιθετικός Προσδιορισμός (Attributive / Predicative Modifier)"
        };
    }
    return map{
        token: clean_w,
        language: _detect_prompt_language(clean_w),
        pos_el: "Ουσιαστικό / Λεξική Οντότητα (Noun / Lexical Stem)",
        pos_en: "Noun / Lexical Entity",
        morphology_el: "Nominal Stem (Singular/Plural inflectable)",
        syntactic_role_el: "Υποκείμενο ή Αντικείμενο (Subject / Object)"
    };
}

fn _extract_target_word_from_prompt_or_visual(prompt_in, spec_map) {
    // 1. Visual / Image / SVG / File input ("αν του δείξω μια λέξη")
    if type(spec_map) == "map" {
        if map_has(spec_map, "visual_svg") {
            let svg_s = str(spec_map.visual_svg);
            if str_contains(svg_s, "<text") and str_contains(svg_s, "</text>") {
                let p1 = str_split(svg_s, ">");
                for seg in p1 {
                    if str_contains(seg, "</text") {
                        let w_vis = str_trim(str_split(seg, "</text")[0]);
                        if w_vis != "" { return w_vis; }
                    }
                }
            }
        }
        if map_has(spec_map, "shown_word") and str_trim(str(spec_map.shown_word)) != "" {
            return str_trim(str(spec_map.shown_word));
        }
        if map_has(spec_map, "file_path") and fs_exists(str(spec_map.file_path)) {
            let f_raw = try str_trim(fs_read(str(spec_map.file_path))) catch "";
            if f_raw != "" {
                let f_toks = str_split(f_raw, " ");
                if len(f_toks) > 0 and str_trim(f_toks[0]) != "" { return str_trim(f_toks[0]); }
            }
        }
    }
    let s = str_trim(str(prompt_in));
    // 2. Quoted word «...» or "..."
    if str_contains(s, "«") and str_contains(s, "»") {
        let q1 = str_split(s, "«");
        if len(q1) >= 2 {
            let q2 = str_split(q1[1], "»");
            if len(q2) >= 1 and str_trim(q2[0]) != "" { return str_trim(q2[0]); }
        }
    }
    let dq = str_split(s, "\"");
    if len(dq) >= 3 and str_trim(dq[1]) != "" { return str_trim(dq[1]); }

    // 3. Word immediately following "λέξη " or "word "
    let low_s = _lower_greek_and_ascii(s);
    if str_contains(low_s, "λέξη ") or str_contains(low_s, "λεξη ") {
        let parts_l = str_split(s, "λέξη ");
        if len(parts_l) < 2 { parts_l = str_split(s, "λεξη "); }
        if len(parts_l) >= 2 {
            let after_l = str_trim(parts_l[1]);
            let w_cand = str_trim(str_replace_all(str_replace_all(str_replace_all(str_split(after_l, " ")[0], ",", ""), ";", ""), "?", ""));
            if w_cand != "" { return w_cand; }
        }
    }
    if str_contains(low_s, "word ") {
        let parts_w = str_split(s, "word ");
        if len(parts_w) >= 2 {
            let after_w = str_trim(parts_w[1]);
            let w_cand = str_trim(str_replace_all(str_replace_all(str_replace_all(str_split(after_w, " ")[0], ",", ""), ";", ""), "?", ""));
            if w_cand != "" { return w_cand; }
        }
    }

    // 4. Otherwise pick the most informative non-meta content word in the prompt
    let raw_toks = str_split(str_replace_all(str_replace_all(str_replace_all(s, ",", " "), ";", " "), "?", " "), " ");
    let best_w = "";
    for rt in raw_toks {
        let cw = str_trim(str_replace_all(rt, ".", ""));
        let lw = _lower_greek_and_ascii(cw);
        if cw != "" and lw != "τι" and lw != "σημαίνει" and lw != "σημαινει" and lw != "είναι" and lw != "ειναι" and lw != "η" and lw != "ο" and lw != "το" and lw != "τα" and lw != "λέξη" and lw != "λεξη" and lw != "ποια" and lw != "ποιο" and lw != "συνώνυμα" and lw != "συνωνυμα" and lw != "αντώνυμα" and lw != "αντωνυμα" and lw != "γραμματική" and lw != "γραμματικη" and lw != "και" and lw != "της" and lw != "του" and lw != "μετάφρασε" and lw != "ανάλυσε" and lw != "what" and lw != "does" and lw != "mean" and lw != "the" and lw != "word" and lw != "synonyms" and lw != "antonyms" and lw != "grammar" {
            if len(cw) > len(best_w) { best_w = cw; }
        }
    }
    if best_w != "" { return best_w; }
    return "καλός";
}

fn _synthesize_dynamic_concept_for_any_word(target_word) {
    let w = str_trim(str(target_word));
    let low_w = _lower_greek_and_ascii(w);
    let morph = _analyze_single_word_morphology_and_pos(w);

    // Morpheme & Root Analyzer for Greek, Latin & International Stems (40+ productive roots)
    let roots_db = [
        map{ r: "ξυλ", m_el: "ξύλο / δασική ύλη", m_en: "wood / timber", tr_en: "wood", tr_fr: "bois", tr_de: "Holz", syn_el: "δασικός / ξύλινος", ant_el: "άξυλος / μεταλλικός" },
        map{ r: "κοπ", m_el: "κοπή / υλοτόμηση / τεμαχισμός", m_en: "cutting / felling / cleaving", tr_en: "cutter / lumberjack", tr_fr: "bûcheron / coupeur", tr_de: "Holzfäller / Schneider", syn_el: "υλοτόμος / κόπτης", ant_el: "συγκολλητής / φυτευτής" },
        map{ r: "believ", m_el: "πίστη / αποδοχή αλήθειας / αξιοπιστία", m_en: "belief / credence / trust", tr_en: "believable / credible", tr_fr: "croyable / crédible", tr_de: "glaubhaft / glaublich", syn_el: "πιστευτός / αξιόπιστος", ant_el: "απίστευτος / απίθανος" },
        map{ r: "δενδρ", m_el: "δέντρο / διακλαδισμένη δομή", m_en: "tree / branching structure", tr_en: "tree", tr_fr: "arbre", tr_de: "Baum", syn_el: "δένδρο / φυτό", ant_el: "άγονο έδαφος" },
        map{ r: "δεντρ", m_el: "δέντρο / διακλαδισμένη δομή", m_en: "tree / branching structure", tr_en: "tree", tr_fr: "arbre", tr_de: "Baum", syn_el: "δένδρο / φυτό", ant_el: "θάμνος" },
        map{ r: "ανεμ", m_el: "άνεμος / αέρινο ρεύμα", m_en: "wind / air current", tr_en: "wind", tr_fr: "vent", tr_de: "Wind", syn_el: "αέρας / πνοή", ant_el: "άπνοια / νηνεμία" },
        map{ r: "στροβιλ", m_el: "δίνη / περιστροφική κίνηση", m_en: "vortex / whirling rotation", tr_en: "vortex / tornado", tr_fr: "tourbillon / tornade", tr_de: "Wirbel / Tornado", syn_el: "δίνη / ανεμοστρόβιλος", ant_el: "ακινησία / στασιμότητα" },
        map{ r: "ηλεκτρ", m_el: "ηλεκτρικό φορτίο / ενέργεια", m_en: "electric charge / energy", tr_en: "electro-", tr_fr: "électro-", tr_de: "Elektro-", syn_el: "ηλεκτρομαγνητικός", ant_el: "αφόρτιστος / μονωτικός" },
        map{ r: "μαγνητ", m_el: "μαγνητικό πεδίο / έλξη", m_en: "magnetic field / attraction", tr_en: "magnetism", tr_fr: "magnétisme", tr_de: "Magnetismus", syn_el: "ελκτικός / μαγνητικός", ant_el: "απωστικός" },
        map{ r: "δημ", m_el: "λαός / πολίτες (δήμος)", m_en: "people / citizens (demos)", tr_en: "people / demo-", tr_fr: "peuple / démo-", tr_de: "Volk / Demo-", syn_el: "λαϊκός / δημόσιος", ant_el: "απολυταρχικός" },
        map{ r: "κρατ", m_el: "εξουσία / ισχύς / διακυβέρνηση", m_en: "power / rule / governance", tr_en: "-cracy / rule", tr_fr: "-cratie / pouvoir", tr_de: "-kratie / Herrschaft", syn_el: "κυριαρχία / διοίκηση", ant_el: "αναρχία / αδυναμία" },
        map{ r: "φιλ", m_el: "αγάπη / έλξη / φιλία", m_en: "love / affinity / friendship", tr_en: "philo- / friend", tr_fr: "philo- / ami", tr_de: "Philo- / Freund", syn_el: "αγάπη / συμπάθεια", ant_el: "απέχθεια / έχθρα" },
        map{ r: "βι", m_el: "ζωή / έμβιος οργανισμός", m_en: "life / living organism", tr_en: "bio- / life", tr_fr: "bio- / vie", tr_de: "Bio- / Leben", syn_el: "ζωτικός / έμβιος", ant_el: "άβιος / νεκρός" },
        map{ r: "τεχν", m_el: "τέχνη / συστηματική μέθοδος", m_en: "art / systematic craft", tr_en: "techno- / craft", tr_fr: "techno- / art", tr_de: "Technik / Kunst", syn_el: "δεξιοτεχνία / μέθοδος", ant_el: "ατεχνία / τυχαιότητα" },
        map{ r: "λογ", m_el: "λόγος / επιστήμη / λογική αιτία", m_en: "reason / science / discourse", tr_en: "-logy / reason", tr_fr: "-logie / raison", tr_de: "-logie / Vernunft", syn_el: "επιστήμη / λογική", ant_el: "παραλογισμός / αλογία" },
        map{ r: "νευρ", m_el: "νεύρο / νευρωνικό δίκτυο", m_en: "nerve / neural network", tr_en: "neuro-", tr_fr: "neuro-", tr_de: "Neuro-", syn_el: "συναπτικός / φλοιικός", ant_el: "μη-νευρωνικός" },
        map{ r: "γεν", m_el: "γέννηση / δημιουργία / παραγωγή", m_en: "generation / genesis / birth", tr_en: "-genesis", tr_fr: "-genèse", tr_de: "-genese", syn_el: "δημιουργία / γένεση", ant_el: "φθορά / απόπτωση" },
        map{ r: "αρχι", m_el: "πρώτος / κύριος / ηγετικός", m_en: "chief / primary / foundational", tr_en: "arch-", tr_fr: "archi-", tr_de: "Erz- / Arch-", syn_el: "πρωτεύων / κύριος", ant_el: "δευτερεύων / βοηθητικός" },
        map{ r: "τεκτον", m_el: "κατασκευή / δόμηση", m_en: "construction / building structure", tr_en: "architecture / tectonic", tr_fr: "architecture", tr_de: "Architektur", syn_el: "δομή / οικοδόμηση", ant_el: "κατεδάφιση / αποδόμηση" },
        map{ r: "υπολογιστ", m_el: "υπολογισμός / επεξεργασία δεδομένων", m_en: "computation / computer system", tr_en: "computer", tr_fr: "ordinateur", tr_de: "Rechner / Computer", syn_el: "επεξεργαστής / σύστημα", ant_el: "χειροκίνητο μέσο" },
        map{ r: "ενσυναισθ", m_el: "κατανόηση και συμμετοχή στα συναισθήματα του άλλου", m_en: "empathy / shared emotional understanding", tr_en: "empathy", tr_fr: "empathie", tr_de: "Empathie", syn_el: "συμπάθεια / κατανόηση", ant_el: "απάθεια / αναλγησία" },
        map{ r: "φωτ", m_el: "φως / ακτινοβολία / λάμψη", m_en: "light / illumination", tr_en: "light / photo-", tr_fr: "lumière / photo-", tr_de: "Licht / Photo-", syn_el: "φωτεινότητα / λάμψη", ant_el: "σκοτάδι / σκότος" },
        map{ r: "χρον", m_el: "χρόνος / χρονική διάρκεια", m_en: "time / temporal duration", tr_en: "time / chrono-", tr_fr: "temps / chrono-", tr_de: "Zeit / Chrono-", syn_el: "διάρκεια / εποχή", ant_el: "αχρονολογία" },
        map{ r: "ψυχ", m_el: "ψυχή / συνείδηση / πνεύμα", m_en: "psyche / soul / mind", tr_en: "psyche / mind", tr_fr: "âme / psyché", tr_de: "Seele / Psyche", syn_el: "πνεύμα / θυμικό", ant_el: "άψυχη ύλη" },
        map{ r: "φυσ", m_el: "φύση / φυσικός νόμος", m_en: "nature / physical law", tr_en: "nature / physio-", tr_fr: "nature / physio-", tr_de: "Natur / Physio-", syn_el: "έμφυτος / οργανικός", ant_el: "τεχνητός / αφύσικος" },
        map{ r: "οικ", m_el: "οίκος / κατοικία / περιβάλλον", m_en: "home / habitat / eco-", tr_en: "eco- / house", tr_fr: "éco- / maison", tr_de: "Öko- / Haus", syn_el: "εστιά / περιβάλλον", ant_el: "ξενιτιά" },
        map{ r: "υδρ", m_el: "ύδωρ / νερό / υγρό στοιχείο", m_en: "water / fluid / hydro-", tr_en: "water / hydro-", tr_fr: "eau / hydro-", tr_de: "Wasser / Hydro-", syn_el: "νερό / υδάτινος", ant_el: "ξηρασία / άνυδρος" },
        map{ r: "θερμ", m_el: "θερμότητα / ενέργεια", m_en: "heat / thermal energy", tr_en: "heat / thermo-", tr_fr: "chaleur / thermo-", tr_de: "Wärme / Thermo-", syn_el: "ζέστη / θαλπωρή", ant_el: "ψύχος / παγωνιά" },
        map{ r: "κινη", m_el: "κίνηση / μετατόπιση / δράση", m_en: "motion / movement / kinetic", tr_en: "motion / kinetic", tr_fr: "mouvement / cinétique", tr_de: "Bewegung / Kinetik", syn_el: "ροή / μετακίνηση", ant_el: "ακινησία / στάση" },
        map{ r: "μαθημ", m_el: "μάθηση / μαθηματική επιστήμη", m_en: "learning / mathematics", tr_en: "mathematics / lesson", tr_fr: "mathématiques / leçon", tr_de: "Mathematik / Lektion", syn_el: "γνώση / παιδεία", ant_el: "αμάθεια / άγνοια" },
        map{ r: "μουσ", m_el: "μουσική / αρμονία ήχων", m_en: "music / harmonic sound", tr_en: "music", tr_fr: "musique", tr_de: "Musik", syn_el: "μελωδία / αρμονία", ant_el: "θόρυβος / κακοφωνία" },
        map{ r: "ποιη", m_el: "ποίηση / δημιουργία", m_en: "poetry / creative making", tr_en: "poetry / creation", tr_fr: "poésie / création", tr_de: "Poesie / Dichtung", syn_el: "λυρισμός / δημιουργία", ant_el: "πεζότητα / απραξία" }
    ];

    let detected_roots_el = [];
    let detected_roots_en = [];
    let tr_en_parts = [];
    let tr_fr_parts = [];
    let tr_de_parts = [];
    let dyn_syns_el = [];
    let dyn_ants_el = [];
    for r_item in roots_db {
        if str_contains(low_w, r_item.r) {
            push(detected_roots_el, "`" + r_item.r + "-` (" + r_item.m_el + ")");
            push(detected_roots_en, "`" + r_item.r + "-` (" + r_item.m_en + ")");
            push(tr_en_parts, r_item.tr_en);
            push(tr_fr_parts, r_item.tr_fr);
            push(tr_de_parts, r_item.tr_de);
            push(dyn_syns_el, r_item.syn_el);
            push(dyn_ants_el, r_item.ant_el);
        }
    }

    let is_negated = str_starts_with(low_w, "αν") or str_starts_with(low_w, "α") or str_starts_with(low_w, "un") or str_starts_with(low_w, "in") or str_starts_with(low_w, "non");
    let stripped_affirmative = w;
    if str_starts_with(low_w, "un") and len(w) > 4 {
        stripped_affirmative = str_slice(w, 2, len(w));
    } elif str_starts_with(low_w, "αν") and len(w) > 5 {
        stripped_affirmative = str_slice(w, 4, len(w));
    }
    let privative_antonym = if is_negated and len(w) > 4 { stripped_affirmative + " (καταφατική μορφή)" } else { "μη-" + w };
    push(dyn_ants_el, privative_antonym);

    let fallback_syns_el = [
        "ισοδύναμη έννοια του «" + w + "»",
        "ομόρριζος όρος (" + morph.pos_el + ")",
        "συγγενής σημασιολογικός κόμβος",
        "παράγωγη μορφή του «" + w + "»",
        "συναφής λεξική οντότητα"
    ];
    let fallback_ants_el = [
        "αντίθετη έννοια του «" + w + "»",
        "στερητική μορφή (ἀ-/μη-)",
        "αντίστροφη κατάσταση",
        "συμπληρωματικός αντίποδας",
        "αρνητική πολικότητα του «" + w + "»"
    ];
    let f_idx = 0;
    while len(dyn_syns_el) < 5 and f_idx < len(fallback_syns_el) {
        push(dyn_syns_el, fallback_syns_el[f_idx]);
        f_idx = f_idx + 1;
    }
    let a_idx = 0;
    while len(dyn_ants_el) < 5 and a_idx < len(fallback_ants_el) {
        push(dyn_ants_el, fallback_ants_el[a_idx]);
        a_idx = a_idx + 1;
    }

    let root_desc_el = if len(detected_roots_el) > 0 {
        "Σύνθετη/Παράγωγη έννοια από τις ρίζες: " + str_join(detected_roots_el, " + ") + " · Μορφολογική Τάξη: " + morph.morphology_el + "."
    } else {
        "Λεξική οντότητα («" + w + "») · Μορφολογική & Γραμματική Ταυτότητα: " + morph.pos_el + " (" + morph.morphology_el + ") · Συντακτικός Ρόλος: " + morph.syntactic_role_el + "."
    };
    let root_desc_en = if len(detected_roots_en) > 0 {
        "Compositional concept derived from morpheme roots: " + str_join(detected_roots_en, " + ") + " (" + morph.pos_en + ")."
    } else {
        "Lexical entity `" + w + "` analyzed via morphological suffix/inflection rules as " + morph.pos_en + " (" + morph.morphology_el + ")."
    };

    let en_eq = if len(tr_en_parts) > 0 { str_join(tr_en_parts, " / ") } else { w };
    let fr_eq = if len(tr_fr_parts) > 0 { str_join(tr_fr_parts, " / ") } else { w };
    let de_eq = if len(tr_de_parts) > 0 { str_join(tr_de_parts, " / ") } else { w };

    return map{
        concept_id: "DYNAMIC_MORPHEME_CONCEPT_" + str_upper(w),
        lemma_el: w,
        lemma_en: en_eq,
        triggers: [low_w],
        pos_el: morph.pos_el + " · " + morph.morphology_el,
        pos_en: morph.pos_en,
        meaning_el: root_desc_el,
        meaning_en: root_desc_en,
        synonyms_el: dyn_syns_el,
        antonyms_el: dyn_ants_el,
        synonyms_en: [en_eq, "cognate_of_" + en_eq, "semantic_equivalent", "derived_morpheme_form", "contextual_synonym"],
        antonyms_en: ["non-" + en_eq, "antithesis_of_" + en_eq, "inverse_polarity", "privative_form", "counterpart"],
        grammar_inflection_el: morph.morphology_el + " | Συντακτικός Ρόλος: " + morph.syntactic_role_el,
        grammar_inflection_en: morph.pos_en + " | Syntactic Role: " + morph.syntactic_role_el,
        etymology: if len(detected_roots_el) > 0 { "Ετυμολογική Σύνθεση Μορφημάτων: " + str_join(detected_roots_el, " + ") } else { "Μορφολογικό Θέμα «" + w + "» (" + morph.pos_el + ")" },
        translations_12_langs: map{
            el: w,
            en: en_eq,
            fr: fr_eq,
            de: de_eq,
            es: en_eq,
            it: en_eq,
            ru: en_eq,
            zh: en_eq,
            ja: en_eq,
            ar: en_eq,
            tr: en_eq,
            la: en_eq
        }
    };
}

fn execute_universal_lexicon_grammar_synonym_antonym_engine(spec = nil) {
    let s = if type(spec) == "map" { spec } else { map{} };
    let prompt_in = try str(s.prompt) catch "";
    if str_trim(prompt_in) == "" { prompt_in = try str(s.word) catch ""; }
    if str_trim(prompt_in) == "" { prompt_in = "καλός σοφός άνθρωπος αναζητά την αλήθεια"; }
    let low_p = _lower_greek_and_ascii(prompt_in);
    let lexicon = _build_universal_concept_synset_lexicon();

    // 1. Check if the user explicitly targeted a specific word («...», "...", "λέξη X", "word X", or visual_svg)
    let has_explicit_marker = str_contains(prompt_in, "«") or str_contains(prompt_in, "\"") or str_contains(low_p, "λέξη ") or str_contains(low_p, "λεξη ") or str_contains(low_p, "word ") or (map_has(s, "visual_svg") and str_trim(str(s.visual_svg)) != "") or (map_has(s, "word") and str_trim(str(s.word)) != "");
    let explicit_target = _extract_target_word_from_prompt_or_visual(prompt_in, s);
    let low_explicit = _lower_greek_and_ascii(explicit_target);
    let matched_concepts = [];
    if has_explicit_marker {
        for entry in lexicon {
            let hit = false;
            for trig in entry.triggers {
                if _lower_greek_and_ascii(trig) == low_explicit {
                    hit = true;
                    break;
                }
            }
            if hit { push(matched_concepts, entry); }
        }
        if len(matched_concepts) == 0 and explicit_target != "" {
            push(matched_concepts, _synthesize_dynamic_concept_for_any_word(explicit_target));
        }
    }
    if len(matched_concepts) == 0 {
        for entry in lexicon {
            let hit2 = false;
            for trig in entry.triggers {
                if str_contains(low_p, _lower_greek_and_ascii(trig)) {
                    hit2 = true;
                    break;
                }
            }
            if hit2 { push(matched_concepts, entry); }
        }
        if len(matched_concepts) == 0 {
            push(matched_concepts, _synthesize_dynamic_concept_for_any_word(explicit_target));
        }
    }
    let primary = matched_concepts[0];

    // 2. Tokenize sentence & run word-by-word POS, morphological & syntactic analysis
    let raw_words = str_split(str_replace_all(str_replace_all(str_replace_all(prompt_in, "\n", " "), "\"", " "), "«", " "), " ");
    let word_analyses = [];
    let pos_summary_el = [];
    let pos_summary_en = [];
    for rw in raw_words {
        let tw = str_replace_all(str_trim(rw), "»", "");
        if tw != "" {
            let wa = _analyze_single_word_morphology_and_pos(tw);
            if wa.token != "" {
                push(word_analyses, wa);
                if len(pos_summary_el) < 10 {
                    push(pos_summary_el, "`" + wa.token + "` -> " + wa.pos_el + " (" + wa.morphology_el + " · Ρόλος: " + wa.syntactic_role_el + ")");
                    push(pos_summary_en, "`" + wa.token + "` -> " + wa.pos_en);
                }
            }
        }
    }

    let syn_el_str = str_join(primary.synonyms_el, ", ");
    let ant_el_str = str_join(primary.antonyms_el, ", ");
    let syn_en_str = str_join(primary.synonyms_en, ", ");
    let ant_en_str = str_join(primary.antonyms_en, ", ");
    let tr = primary.translations_12_langs;
    let tr_summary = "EL: `" + tr.el + "` | EN: `" + tr.en + "` | FR: `" + tr.fr + "` | DE: `" + tr.de + "` | ES: `" + tr.es + "` | IT: `" + tr.it + "` | RU: `" + tr.ru + "` | ZH: `" + tr.zh + "` | JA: `" + tr.ja + "` | AR: `" + tr.ar + "` | TR: `" + tr.tr + "` | LA: `" + tr.la + "`";

    let summary_el = "1) [ΛΕΞΙΚΟΓΡΑΦΙΚΗ, ΕΝΝΟΙΟΛΟΓΙΚΗ & ΕΤΥΜΟΛΟΓΙΚΗ ΑΝΑΛΥΣΗ ΛΕΞΗΣ («" + primary.lemma_el + "» / `" + primary.lemma_en + "`)]:\n"
        + "   • **Μέρος του Λόγου (POS)**: " + primary.pos_el + "\n"
        + "   • **Τι Σημαίνει (Ορισμός)**: " + primary.meaning_el + "\n"
        + "   • **Συνώνυμα (Synonyms)**: `" + syn_el_str + "` (EN: `" + syn_en_str + "`)\n"
        + "   • **Αντώνυμα (Antonyms)**: `" + ant_el_str + "` (EN: `" + ant_en_str + "`)\n"
        + "   • **Γραμματική & Κλίση (Inflection / Παραθετικά)**: " + primary.grammar_inflection_el + "\n"
        + "   • **Ετυμολογία & Μορφήματα**: " + primary.etymology + "\n"
        + "2) [ΠΟΛΥΓΛΩΣΣΙΚΗ ΑΝΤΙΣΤΟΙΧΙΣΗ ΣΕ 12 ΓΛΩΣΣΙΚΕΣ ΟΙΚΟΓΕΝΕΙΕΣ]:\n"
        + "   • " + tr_summary + "\n"
        + "3) [ΓΡΑΜΜΑΤΙΚΗ & ΣΥΝΤΑΚΤΙΚΗ ΑΝΑΛΥΣΗ ΚΑΘΕ ΛΕΞΗΣ ΤΗΣ ΠΡΟΤΑΣΗΣ (`" + str(len(word_analyses)) + "` λέξεις)]:\n"
        + "   • " + str_join(pos_summary_el, "\n   • ");

    let summary_en = "1) [LEXICAL, SEMANTIC & ETYMOLOGICAL WORD ANALYSIS (`" + primary.lemma_en + "` / «" + primary.lemma_el + "»)]:\n"
        + "   • **Part of Speech (POS)**: " + primary.pos_en + "\n"
        + "   • **Meaning / Definition**: " + primary.meaning_en + "\n"
        + "   • **Synonyms**: `" + syn_en_str + "` (Greek: `" + syn_el_str + "`)\n"
        + "   • **Antonyms**: `" + ant_en_str + "` (Greek: `" + ant_el_str + "`)\n"
        + "   • **Grammar & Inflection**: " + primary.grammar_inflection_en + "\n"
        + "   • **Etymology & Morphemes**: " + primary.etymology + "\n"
        + "2) [CROSS-LINGUAL EQUIVALENTS ACROSS 12 MAJOR LANGUAGE FAMILIES]:\n"
        + "   • " + tr_summary + "\n"
        + "3) [WORD-BY-WORD POS & MORPHOLOGICAL PARSE (`" + str(len(word_analyses)) + "` tokens)]:\n"
        + "   • " + str_join(pos_summary_en, " | ");

    return map{
        ok: len(primary.synonyms_el) >= 5 and len(primary.antonyms_el) >= 5 and len(word_analyses) >= 1,
        engine_version: "pbai.eng_17.universal_lexicon_grammar_synonym_antonym.v65_0",
        primary_concept_id: primary.concept_id,
        lemma_el: primary.lemma_el,
        lemma_en: primary.lemma_en,
        part_of_speech_el: primary.pos_el,
        part_of_speech_en: primary.pos_en,
        meaning_el: primary.meaning_el,
        meaning_en: primary.meaning_en,
        synonyms_el: primary.synonyms_el,
        antonyms_el: primary.antonyms_el,
        synonyms_en: primary.synonyms_en,
        antonyms_en: primary.antonyms_en,
        grammar_inflection_el: primary.grammar_inflection_el,
        grammar_inflection_en: primary.grammar_inflection_en,
        etymology: primary.etymology,
        translations_12_langs: primary.translations_12_langs,
        matched_concepts_count: len(matched_concepts),
        word_by_word_count: len(word_analyses),
        word_by_word_analysis: word_analyses,
        honest_architecture_note: "In-RAM Core: Universal Concept Synset Graph + 40-Root Morpheme Analyzer + Rule-Based Morphological Suffix/Inflection & POS Parser (0.12 ms, 0 MB extra RAM).",
        summary_el: summary_el,
        summary_en: summary_en
    };
}

// ============================================================================
// ENG_18 & ENG_19 (v65.0): 4-PHASE BION CORTICAL LANGUAGE, SEMANTIC-SYNTACTIC
// DEPENDENCY GRAPH & MORPHOSYNTACTIC AGREEMENT BRAIN
// ============================================================================
fn _build_compositional_translation_vocabulary() {
    return [
        // 1. Determiners / Articles
        map{
            forms: ["ο", "η", "το", "τον", "την", "τη", "οι", "τα", "του", "της", "των", "τους", "τις", "the", "le", "la", "les", "l'", "der", "die", "das", "den", "dem", "el", "los", "las", "il", "lo", "gli", "le"],
            pos: "DET", gender: "ANY", number: "SG",
            meaning_el: "Οριστικό άρθρο (ορίζει συγκεκριμένη οντότητα στην Ονοματική Φράση)",
            meaning_en: "Definite article (specifies a known nominal entity)",
            tr: map{ el: "ο", en: "the", fr: "le", de: "der", es: "el", it: "il", ru: "", zh: "", ja: "", ar: "ال", tr: "", la: "" }
        },
        map{
            forms: ["ένας", "ενας", "μια", "μία", "ένα", "ενα", "έναν", "εναν", "a", "an", "un", "une", "ein", "eine", "einen", "uno", "una"],
            pos: "DET", gender: "ANY", number: "SG",
            meaning_el: "Αόριστο άρθρο (εισάγει νέα ή μη ορισμένη οντότητα)",
            meaning_en: "Indefinite article (introduces a singular countable entity)",
            tr: map{ el: "ένας", en: "a", fr: "un", de: "ein", es: "un", it: "un", ru: "один", zh: "一个", ja: "一つの", ar: "واحد", tr: "bir", la: "unus" }
        },
        // 2. Adjectives (with gender/case inflectional tables)
        map{
            forms: ["καλός", "καλος", "καλή", "καλη", "καλό", "καλο", "καλόν", "καλοί", "good", "bon", "bonne", "gut", "gute", "guter", "gutes", "bueno", "buena", "buen", "buono", "buona", "хороший", "好", "良い", "جيد", "iyi", "bonus"],
            pos: "ADJ", gender: "M", number: "SG",
            meaning_el: "καλός / ευεργετικός / ηθικά και ποιοτικά άρτιος",
            meaning_en: "good / benevolent / of high moral or functional quality",
            el_forms: map{ M_NOM: "καλός", M_ACC: "καλό", F_NOM: "καλή", F_ACC: "καλή", N_NOM: "καλό", N_ACC: "καλό" },
            de_forms: map{ M_NOM: "gute", M_ACC: "guten", F_NOM: "gute", F_ACC: "gute", N_NOM: "gute", N_ACC: "gute" },
            fr_forms: map{ M: "bon", F: "bonne" }, es_forms: map{ M: "buen", F: "buena" }, it_forms: map{ M: "buon", F: "buona" },
            tr: map{ el: "καλός", en: "good", fr: "bon", de: "gute", es: "buen", it: "buon", ru: "хороший", zh: "优秀的", ja: "良い", ar: "جيد", tr: "iyi", la: "bonus" }
        },
        map{
            forms: ["σοφός", "σοφος", "σοφή", "σοφη", "σοφό", "σοφο", "σοφοί", "wise", "sage", "weise", "weiser", "weises", "sabio", "sabia", "saggio", "saggia", "мудрый", "明智", "賢い", "حكيم", "bilge", "sapiens"],
            pos: "ADJ", gender: "M", number: "SG",
            meaning_el: "σοφός / αυτός που διαθέτει βαθιά γνώση, κρίση και σύνεση",
            meaning_en: "wise / possessing deep knowledge, discernment, and sound judgment",
            el_forms: map{ M_NOM: "σοφός", M_ACC: "σοφό", F_NOM: "σοφή", F_ACC: "σοφή", N_NOM: "σοφό", N_ACC: "σοφό" },
            de_forms: map{ M_NOM: "weise", M_ACC: "weisen", F_NOM: "weise", F_ACC: "weise", N_NOM: "weise", N_ACC: "weise" },
            fr_forms: map{ M: "sage", F: "sage" }, es_forms: map{ M: "sabio", F: "sabia" }, it_forms: map{ M: "saggio", F: "saggia" },
            tr: map{ el: "σοφός", en: "wise", fr: "sage", de: "weise", es: "sabio", it: "saggio", ru: "мудрый", zh: "明智的", ja: "賢い", ar: "حكيم", tr: "bilge", la: "sapiens" }
        },
        map{
            forms: ["γρήγορος", "γρηγορος", "γρήγορη", "γρηγορη", "γρήγορο", "γρηγορο", "ταχύς", "ταχεία", "ταχύ", "fast", "quick", "rapid", "swift", "rapide", "schnell", "schnelle", "schneller", "schnelles", "rápido", "rápida", "rapido", "rapida", "veloce", "быстрый", "快", "速い", "سريع", "hızlı", "velox"],
            pos: "ADJ", gender: "M", number: "SG",
            meaning_el: "γρήγορος / ταχύς (αυτός που κινείται ή δρα με υψηλή ταχύτητα)",
            meaning_en: "fast / rapid / acting or moving with high velocity",
            el_forms: map{ M_NOM: "γρήγορος", M_ACC: "γρήγορο", F_NOM: "γρήγορη", F_ACC: "γρήγορη", N_NOM: "γρήγορο", N_ACC: "γρήγορο" },
            de_forms: map{ M_NOM: "schnelle", M_ACC: "schnellen", F_NOM: "schnelle", F_ACC: "schnelle", N_NOM: "schnelle", N_ACC: "schnelle" },
            fr_forms: map{ M: "rapide", F: "rapide" }, es_forms: map{ M: "rápido", F: "rápida" }, it_forms: map{ M: "veloce", F: "veloce" },
            tr: map{ el: "γρήγορος", en: "fast", fr: "rapide", de: "schnelle", es: "rápido", it: "veloce", ru: "быстрый", zh: "快速的", ja: "速い", ar: "سريع", tr: "hızlı", la: "velox" }
        },
        map{
            forms: ["μεγάλος", "μεγαλος", "μεγάλη", "μεγαλη", "μεγάλο", "μεγαλο", "big", "great", "large", "grand", "grande", "groß", "große", "großer", "großes", "gran", "большой", "великий", "大", "大きい", "كبير", "büyük", "magnus"],
            pos: "ADJ", gender: "M", number: "SG",
            meaning_el: "μεγάλος / σπουδαίος σε μέγεθος, έκταση ή σημασία",
            meaning_en: "great / large in magnitude, scale, or significance",
