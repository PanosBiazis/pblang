        + "if(dEl)dEl.textContent='+++ b/hierarchy/fractal_723872_units_step_'+st+'.sapp\\n+ dispatch_5_scales(models=32, sub=384, micro=4608, nano=55296, pico=663552, bbb_redacted=true) -> PASS';"
        + "}"
        + "})";

    let inspector_deck_html = "<div id=\"trace-dnc-live-panel\" style=\"display:grid;gap:7px;padding:8px 10px;border-radius:8px;background:#061224;border:1px solid #10b981;font-size:.77rem;color:#eef4ff\">"
