        let b = if len(nums) >= 2 { nums[1] } else { 7.0 };
        let c = if len(nums) >= 3 { nums[2] } else { 22.0 };
        if b > 0 and str_contains(clean_prompt, "- " + str(b)) {
            b = 0.0 - b;
        }
        let x_val = num_floor(((c - b) / a) * 10000.0 + 0.5) / 10000.0;
