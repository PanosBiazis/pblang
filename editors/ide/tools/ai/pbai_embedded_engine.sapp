fn evaluate_universal_all_models_comparison_arena(spec = nil) {
    let org = _read_org_state_cached();
    let dlg = read_inter_model_mcp_dialogue_fast();
    if type(spec) == "map" {
        if map_has(spec, "org_state") and type(spec.org_state) == "map" {
            org = spec.org_state;
        }
        if map_has(spec, "dlg_state") and type(spec.dlg_state) == "map" {
            dlg = spec.dlg_state;
        }
    }
    let tick_no = try int(org.session_ticks) catch 9888;
    let neurons_n = try int(org.cortical_neurons) catch 66850;
    let synapses_s = try int(org.active_synapses) catch 3369000;
    let skills_k = try int(org.verified_functional_skills) catch 10380;
    let fitness_v = try float(org.monotonic_fitness_score) catch 99.9995;
    let round_no = try int(dlg.dialogue_round) catch 9888;
    let evo = try dlg.emergent_evolution catch map{};
    let total_models_n = try int(evo.total_models) catch 64;
    let spheres_n = try int(evo.total_spheres) catch 32;
    let categories_n = try int(evo.total_categories) catch 210;
    let subcats_n = try int(evo.total_subcategories) catch 1680;
    let sections_n = try int(evo.total_sections) catch 20160;
    let themes_n = try int(evo.emergent_thematics) catch 198;

    let categories_matrix = [
        map{
