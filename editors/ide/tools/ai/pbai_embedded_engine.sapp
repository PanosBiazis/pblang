        + "<line x1=\"" + str(tx_mid) + "\" y1=\"68\" x2=\"" + str(tx_mid - 42) + "\" y2=\"125\" stroke=\"#fcd34d\" stroke-width=\"1.4\"/>"
        + "<line x1=\"" + str(tx_mid) + "\" y1=\"68\" x2=\"" + str(tx_mid + 42) + "\" y2=\"125\" stroke=\"#fcd34d\" stroke-width=\"1.4\"/>"
