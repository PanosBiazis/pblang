// editors/ide/tools/ai/pbai_embedded_engine.sapp
//
// Embedded pbAI Cognitive, Agentic, DEQ/LoRA, 3-Tier Memory RAG & Tool-Broker Engine
// inside PBLang (`editors/ide/tools/ai/`).

let _MOD_CACHE = map{};
let _CACHED_PBAI_MOD = nil;
let _CACHED_WAVE_MOD = nil;
let _CACHED_LLM_MOD = nil;
let _CACHED_V35_MOD = nil;
let _CACHED_V38_MOD = nil;

fn _pbai() {
    if _CACHED_PBAI_MOD != nil { return _CACHED_PBAI_MOD; }
    let m = try import("stdlib:pbai.sapp") catch nil;
    if m == nil { m = import("../../../../stdlib/pbai.sapp"); }
    _CACHED_PBAI_MOD = m;
    return m;
}

