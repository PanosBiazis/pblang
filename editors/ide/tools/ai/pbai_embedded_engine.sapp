    // 3. Playable Keyframe Video Player (GPU-composited CSS animations + Play on demand)
    let video_svg = "<svg id=\"pbai-studio-video-svg\" viewBox=\"0 0 800 195\" style=\"width:100%;max-width:100%;height:auto;display:block;background:linear-gradient(180deg,#040914,#0b1933);border:1px solid #60a5fa;border-radius:10px;box-sizing:border-box\" role=\"img\" aria-label=\"pbAI Keyframe Video\">"
