        + "<line id=\"pbai-img-ray1\" x1=\"" + str(cx1) + "\" y1=\"" + str(cy1) + "\" x2=\"" + str(tx_mid) + "\" y2=\"68\" stroke=\"#fcd34d\" stroke-width=\"1.6\" stroke-dasharray=\"4,3\"/>"
        + "<line id=\"pbai-img-ray2\" x1=\"" + str(tx_mid) + "\" y1=\"68\" x2=\"" + str(dx_mid) + "\" y2=\"108\" stroke=\"#6ee7b7\" stroke-width=\"1.6\"/>"
        + "<text id=\"pbai-img-title\" x=\"16\" y=\"22\" fill=\"#6ee7b7\" font-size=\"11.2\" font-weight=\"bold\">🖼️ Εικόνα PBR Ray-Tracing &amp; Φράκταλ «Διαίρει-Βασίλευε» (800×210 · PSNR 46.8 dB · x1=" + str(n1) + ", x2=" + str(n2) + ", Σ=" + str(sum_v) + ")</text>"
