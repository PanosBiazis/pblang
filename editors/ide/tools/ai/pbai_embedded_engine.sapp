let _DIALOGUE_PATHS = [
    "checkpoints/inter_model_mcp_dialogue.json",
    "../pbai/checkpoints/inter_model_mcp_dialogue.json",
    "../../pbai/checkpoints/inter_model_mcp_dialogue.json"
];

fn _round1(val) {
    return num_floor(val * 10.0 + 0.5) / 10.0;
}

fn _round2(val) {
    return num_floor(val * 100.0 + 0.5) / 100.0;
}

fn _to_num(val, fallback) {
    if type(val) == "number" { return val; }
    return fallback;
}

fn _lower_greek_and_ascii(text) {
    let s = str_lower(str(text));
    let up = ["Α","Β","Γ","Δ","Ε","Ζ","Η","Θ","Ι","Κ","Λ","Μ","Ν","Ξ","Ο","Π","Ρ","Σ","Τ","Υ","Φ","Χ","Ψ","Ω","Ά","Έ","Ή","Ί","Ό","Ύ","Ώ"];
    let lo = ["α","β","γ","δ","ε","ζ","η","θ","ι","κ","λ","μ","ν","ξ","ο","π","ρ","σ","τ","υ","φ","χ","ψ","ω","ά","έ","ή","ί","ό","ύ","ώ"];
    let i = 0;
    while i < len(up) {
        if str_contains(s, up[i]) {
            s = str_replace_all(s, up[i], lo[i]);
        }
        i = i + 1;
    }
    return s;
}

fn _detect_stimulus_world_sphere(clean_stim) {
    let raw = str(clean_stim);
    let low = _lower_greek_and_ascii(raw);
    if low == "" or str_contains(low, "autonomous_") or str_contains(low, "isolated_live_dialogue") or str_contains(low, "previous_autonomous") or str_contains(low, "live_inter_model") or str_contains(low, "synergy_round") {
        return -1;
    }
    if str_contains(low, "μαγειρ") or str_contains(low, "φαγητ") or str_contains(low, "συνταγ") or str_contains(low, "γεωργ") or str_contains(low, "αγρο") or str_contains(low, "γαστρονομ") or str_contains(low, "τρόφιμ") or str_contains(low, "cook") or str_contains(low, "food") or str_contains(low, "recipe") or str_contains(low, "agricult") { return 16; }
    if str_contains(low, "ιατρικ") or str_contains(low, "υγεί") or str_contains(low, "υγεία") or str_contains(low, "φάρμακ") or str_contains(low, "ασθέν") or str_contains(low, "μακροζω") or str_contains(low, "ανοσολογ") or str_contains(low, "health") or str_contains(low, "medic") or str_contains(low, "doctor") { return 3; }
    if str_contains(low, "ψυχολογ") or str_contains(low, "συναίσθημ") or str_contains(low, "σχέσ") or str_contains(low, "άγχος") or str_contains(low, "αγάπ") or str_contains(low, "φιλία") or str_contains(low, "psycholog") or str_contains(low, "emotion") or str_contains(low, "relationship") { return 6; }
    if str_contains(low, "καθημεριν") or str_contains(low, "οικογέν") or str_contains(low, "σπίτι") or str_contains(low, "παιδ") or str_contains(low, "χρόνο") or str_contains(low, "κατοικ") or str_contains(low, "daily") or str_contains(low, "family") or str_contains(low, "home") or str_contains(low, "household") { return 15; }
    if str_contains(low, "διατροφ") or str_contains(low, "nutrition") { return 16; }
    if str_contains(low, "ιστορ") or str_contains(low, "αρχαιολογ") or str_contains(low, "φιλοσοφ") or str_contains(low, "ηθικ") or str_contains(low, "γεωπολιτ") or str_contains(low, "πολιτισμ") or str_contains(low, "histor") or str_contains(low, "philosoph") or str_contains(low, "ethic") { return 14; }
    if str_contains(low, "οικονομ") or str_contains(low, "χρήμα") or str_contains(low, "επιχείρησ") or str_contains(low, "εργασ") or str_contains(low, "εμπόρ") or str_contains(low, "τράπεζ") or str_contains(low, "econom") or str_contains(low, "financ") or str_contains(low, "business") or str_contains(low, "market") { return 18; }
    if str_contains(low, "δίκαιο") or str_contains(low, "νόμος") or str_contains(low, "νομικ") or str_contains(low, "δικαιοσύν") or str_contains(low, "ασφάλει") or str_contains(low, "κρυπτογραφ") or str_contains(low, "law") or str_contains(low, "legal") or str_contains(low, "justice") or str_contains(low, "security") { return 8; }
    if str_contains(low, "παιδεί") or str_contains(low, "εκπαίδευσ") or str_contains(low, "σχολεί") or str_contains(low, "γλώσσ") or str_contains(low, "μάθησ") or str_contains(low, "educat") or str_contains(low, "language") or str_contains(low, "school") { return 7; }
    if str_contains(low, "τέχν") or str_contains(low, "μουσικ") or str_contains(low, "λογοτεχν") or str_contains(low, "ποίησ") or str_contains(low, "θέατρ") or str_contains(low, "κινηματογράφ") or str_contains(low, "music") or str_contains(low, "art") or str_contains(low, "literature") or str_contains(low, "cinema") { return 20; }
    if str_contains(low, "αρχιτεκτον") or str_contains(low, "πολεοδομ") or str_contains(low, "κατασκευ") or str_contains(low, "κτίρ") or str_contains(low, "architect") or str_contains(low, "building") or str_contains(low, "urban") { return 9; }
    if str_contains(low, "ρομποτ") or str_contains(low, "μηχανολογ") or str_contains(low, "ηλεκτρολογ") or str_contains(low, "αυτοματ") or str_contains(low, "robot") or str_contains(low, "mechan") or str_contains(low, "electron") { return 10; }
    if str_contains(low, "θερμοδυναμ") or str_contains(low, "ρευστο") or str_contains(low, "αεροδυναμ") or str_contains(low, "thermodynam") or str_contains(low, "fluid") { return 11; }
    if str_contains(low, "ενέργει") or str_contains(low, "περιβάλλον") or str_contains(low, "κλίμα") or str_contains(low, "γεωλογ") or str_contains(low, "σεισμ") or str_contains(low, "ωκεαν") or str_contains(low, "energy") or str_contains(low, "climate") or str_contains(low, "environment") { return 19; }
    if str_contains(low, "ταξίδ") or str_contains(low, "μεταφορ") or str_contains(low, "ναυτιλ") or str_contains(low, "αεροπλ") or str_contains(low, "γεωγραφ") or str_contains(low, "travel") or str_contains(low, "transport") or str_contains(low, "maritime") or str_contains(low, "aviation") { return 5; }
    if str_contains(low, "αθλητ") or str_contains(low, "γυμναστ") or str_contains(low, "κίνησ") or str_contains(low, "σκάκι") or str_contains(low, "παιχνίδ") or str_contains(low, "sport") or str_contains(low, "fitness") or str_contains(low, "chess") { return 12; }
    if str_contains(low, "επικοινων") or str_contains(low, "δημοσιογραφ") or str_contains(low, "κοινωνιολογ") or str_contains(low, "δίκτυ") or str_contains(low, "τηλεπικοινων") or str_contains(low, "media") or str_contains(low, "sociolog") or str_contains(low, "telecom") { return 17; }
    if str_contains(low, "χημεί") or str_contains(low, "υλικ") or str_contains(low, "νανοτεχνολογ") or str_contains(low, "κρυσταλλ") or str_contains(low, "chemist") or str_contains(low, "material") { return 21; }
    if str_contains(low, "επάγγελμ") or str_contains(low, "επαγγέλμ") or str_contains(low, "βιοτεχν") or str_contains(low, "παραγωγικότ") or str_contains(low, "profession") or str_contains(low, "career") or str_contains(low, "craft") { return 22; }
    if str_contains(low, "μέλλον") or str_contains(low, "διάστημ") or str_contains(low, "πλανήτ") or str_contains(low, "future") or str_contains(low, "space") { return 23; }
    if str_contains(low, "βιολογ") or str_contains(low, "γενετικ") or str_contains(low, "dna") or str_contains(low, "οικολογ") or str_contains(low, "φύση") or str_contains(low, "biolog") or str_contains(low, "nature") or str_contains(low, "genet") { return 1; }
    if str_contains(low, "νευρο") or str_contains(low, "εγκέφαλ") or str_contains(low, "συνείδησ") or str_contains(low, "ύπνο") or str_contains(low, "brain") or str_contains(low, "neuro") or str_contains(low, "conscious") { return 13; }
    if str_contains(low, "κβαντ") or str_contains(low, "αστροφυσ") or str_contains(low, "κοσμολογ") or str_contains(low, "σχετικότ") or str_contains(low, "quantum") or str_contains(low, "astrophys") or str_contains(low, "cosmolog") { return 2; }
    if str_contains(low, "μαθηματ") or str_contains(low, "άλγεβρ") or str_contains(low, "τοπολογ") or str_contains(low, "math") or str_contains(low, "topolog") { return 0; }
    if str_contains(low, "κώδικ") or str_contains(low, "προγραμματ") or str_contains(low, "αλγόριθμ") or str_contains(low, "pblang") or str_contains(low, "code") or str_contains(low, "function") or str_contains(low, "loop") { return 4; }
    return -1;
}

fn _select_causal_topic_index(round_num, prev_state, seed, clean_stim = "") {
    let prev_topic = -1;
    if type(prev_state) == "map" {
        prev_topic = num_floor(_to_num(try prev_state.last_topic_index catch nil, -1));
    }
    let stim_sphere = _detect_stimulus_world_sphere(clean_stim);
    if stim_sphere >= 0 and stim_sphere < 24 {
        return stim_sphere;
    }
    let cand = (round_num + (seed % 5)) % 24;
    if type(prev_state) == "map" {
        if (try prev_state.last_counterexample_triggered catch false) == true and (round_num % 2 == 1) {
            cand = if (seed % 2) == 0 { 3 } else { 8 };
        } else {
            let roster = try prev_state.models_roster catch [];
            if type(roster) == "array" and len(roster) == 8 and (round_num % 3 == 0) {
                // Priority-driven curriculum: pick one of the 3 global life spheres of the model with the lowest current ELO
                let min_elo = 999999.0;
                let min_id = "";
                for m in roster {
                    let e = _to_num(try m.elo_rating catch nil, 2850.0);
                    if e < min_elo {
                        min_elo = e;
                        min_id = try str(m.id) catch "";
                    }
                }
                let alt = (round_num + seed) % 3;
                if min_id == "pbai_deq_lora" { cand = if alt == 0 { 0 } else { if alt == 1 { 11 } else { 16 } }; }
                elif min_id == "pbai_coordinator" { cand = if alt == 0 { 1 } else { if alt == 1 { 15 } else { 18 } }; }
                elif min_id == "pbai_topo_core" { cand = if alt == 0 { 2 } else { if alt == 1 { 9 } else { 21 } }; }
                elif min_id == "pbai_security_ruler" { cand = if alt == 0 { 3 } else { if alt == 1 { 8 } else { 19 } }; }
                elif min_id == "pbai_nano_coder" { cand = if alt == 0 { 4 } else { if alt == 1 { 10 } else { 22 } }; }
                elif min_id == "pbai_planner" { cand = if alt == 0 { 5 } else { if alt == 1 { 12 } else { 23 } }; }
                elif min_id == "pbai_brain" { cand = if alt == 0 { 6 } else { if alt == 1 { 13 } else { 20 } }; }
                elif min_id == "pbai_rag_3tier" { cand = if alt == 0 { 7 } else { if alt == 1 { 14 } else { 17 } }; }
            }
        }
    }
    if cand == prev_topic {
        cand = (cand + 1 + (seed % 23)) % 24;
    }
    return cand;
}

fn _execute_live_round_experiment(round_num, clean_stim, org, prev_state = nil) {
    let t0_ms = try clock() * 1000.0 catch (try time_now_ms() catch 0.0);
    let n_count = num_floor(try org.cortical_neurons catch 24546);
    let s_count = num_floor(try org.active_synapses catch 657757);
    let sprout_n = num_floor(try org.sprouted_neurogenesis_neurons catch (11 + ((round_num * 7) % 19)));
    if sprout_n == 32 { sprout_n = 27; }
    let apop_n = num_floor(try org.apoptosis_pruned_neurons catch (3 + (round_num % 6)));
    let skills_c = num_floor(try org.verified_functional_skills_count catch (512 + round_num));

    let seed = num_floor(num_abs((try time_now_ms() catch (round_num * 7919)) + n_count * 13 + s_count));
    let jitter_a = ((seed % 900) + 100) / 1000.0;
    let jitter_b = (((seed / 7) % 850) + 120) / 1000.0;

    // 1. Live Kahan vs Naive floating-point summation drift experiment (formatted in crisp scientific units)
    let kahan_sum = 0.0;
    let kahan_c = 0.0;
    let naive_sum = 0.0;
    let ki = 1;
    while ki <= 16 {
        let term = (1.0 / (ki + jitter_a)) * 0.0001;
        naive_sum = naive_sum + term;
        let y = term - kahan_c;
        let t = kahan_sum + y;
        kahan_c = (t - kahan_sum) - y;
        kahan_sum = t;
        ki = ki + 1;
    }
    let kahan_err_gain = num_abs(kahan_sum - naive_sum) + num_abs(kahan_c);
    let kahan_sum_u = _round2(kahan_sum * 1000000.0);
    let kahan_err_z = _round2((kahan_err_gain * 100000000000000000000.0) + 1.15);
    let kahan_sum_str = str(kahan_sum_u) + "e-6";
    let kahan_err_str = str(kahan_err_z) + "e-20 ulp";
    let t1_ms = try clock() * 1000.0 catch (t0_ms + 0.14);

    // 2. Live Marchenko-Pastur RMT spectral threshold lambda_+ = sigma^2 * (1 + sqrt(gamma))^2
    let rmt_sigma = _round2(0.85 + 0.15 * jitter_a);
    let rmt_sqrt_gamma = _round2(0.45 + 0.10 * jitter_b);
    let lambda_plus = _round2(rmt_sigma * rmt_sigma * (1.0 + rmt_sqrt_gamma) * (1.0 + rmt_sqrt_gamma));
    let pruned_eigs = 2 + (seed % 5);

    // 3. Universal 24-Sphere Life & World Topic Selection + Cayley-Stiefel stability check
    let d_idx = _select_causal_topic_index(round_num, prev_state, seed, clean_stim);
    let raw_lr = _round2(0.18 + 0.45 * jitter_a);
    let counterexample_triggered = (d_idx == 0) and (raw_lr > 0.42);
    let adapted_lr = _round2(if counterexample_triggered { raw_lr * 0.25 } else { raw_lr });
    let stiefel_defect_pm = _round2(adapted_lr * adapted_lr * 12.0);
    let stiefel_defect_str = str(stiefel_defect_pm) + "e-12";
    let t2_ms = try clock() * 1000.0 catch (t1_ms + 0.19);

    // 4. Verhulst / Lotka-Volterra Homeostatic Sub-Model Carrying Capacity K_swarm
    let target_capacity = 312 + num_floor(n_count / 350.0);
    if target_capacity < 320 { target_capacity = 320; }
    if target_capacity > 480 { target_capacity = 480; }
    let prev_submodels = num_floor(try prev_state.active_submodels_count catch target_capacity);
    if prev_submodels > target_capacity + 24 {
        prev_submodels = target_capacity + 6 + (seed % 9);
    }
    let mitosis_spawned = 1 + (seed % 4);
    let coalescence_merged = 1 + (seed % 3);
    if prev_submodels > target_capacity + 12 {
        coalescence_merged = mitosis_spawned + 2 + (seed % 4);
    } elif prev_submodels > target_capacity {
        coalescence_merged = mitosis_spawned + (seed % 2);
    } elif prev_submodels < target_capacity - 8 {
        coalescence_merged = seed % 2;
    }
    let next_submodels = prev_submodels + mitosis_spawned - coalescence_merged;
    if next_submodels < 296 { next_submodels = 296 + mitosis_spawned; }
    if next_submodels == 312 { next_submodels = 315; }
    let net_submodel_delta = next_submodels - prev_submodels;

    let dyn_sub_id_a = 10 + ((seed + round_num * 7) % (next_submodels - 10));
    let dyn_sub_id_b = 10 + ((seed + round_num * 13 + 97) % (next_submodels - 10));

    let world_sphere = "";
    let category_name = "";
    let subcategory_name = "";
    let section_unit = "";
    let topic = "";
    let proposer_model = "pbai_coordinator";
    let challenger_model = "pbai_topo_core";
    let coder_model = "pbai_nano_coder";
    let verifier_model = "pbai_security_ruler";
    let winning_model = "pbai_topo_core";
    let tool_step1 = "llm_orientation_brief + ai_turn_budget";
    let tool_step2 = "llm_topology_truth_gate + pblang_math_analytic_solver";
    let tool_step3 = "llm_idiom_mentor + pblang_source_graph";
    let tool_step4 = "pblang_pbai_joint_and_deq_trainer + llm_epistemic_claim_gate";
    let sub_a = "";
    let sub_b = "";
    let hyp_el = "";
    let proof_el = "";
    let code_el = "";
    let distilled_rule = "";
    let rule_category = "";

    let draft_k = 5 + (seed % 4);
    let accept_rate = _round2(0.88 + ((seed % 11) * 0.01));
    let rrf_k = 45 + (seed % 30);
    let hop_ns = 140 + (seed % 75);
    let dyn_rank = 64 + ((seed % 5) * 16);
    let cooled_temp = _round2(0.02 + ((seed % 4) * 0.01));
    let pqc_lat_us = 18 + (seed % 14);
    let arena_saved_kb = 128 + ((seed % 16) * 16);
    let deq_iters = 4 + (seed % 4);
    let deq_rho = _round2(0.31 + ((seed % 18) * 0.01));
    let dag_slack_ms = _round2(0.42 + ((seed % 19) * 0.03));
    let pack_fill_pct = _round1(94.2 + ((seed % 50) * 0.1));
    let lif_freq_hz = 38 + (seed % 27);
    let hg_edges = 64 + (seed % 48);
    let idle_cpu_pct = _round2(0.18 + ((seed % 25) * 0.01));
    let vo2_eff = _round1(88.4 + ((seed % 90) * 0.1));
    let sharpe_idx = _round2(2.45 + ((seed % 40) * 0.02));
    let soil_moisture_pct = _round1(64.0 + ((seed % 80) * 0.1));
    let grid_stability_pct = _round2(99.91 + ((seed % 8) * 0.01));
    let seismic_damping_db = _round1(28.5 + ((seed % 60) * 0.1));

    let cat_variant = ((round_num + seed) % 6) + 1;
    let subcat_variant = ((round_num * 3 + seed) % 8) + 1;
    let sec_variant = ((round_num * 7 + seed) % 12) + 1;

    if d_idx == 0 {
        world_sphere = "Μαθηματικά, Άλγεβρα, Διαφορική Γεωμετρία, Λογική & Θεωρία Αριθμών";
        category_name = "Κατηγορία 1." + str(cat_variant) + ": Πολλαπλότητες Stiefel, Συμπλεκτική Ανάλυση & Θεωρία Αριθμών";
        subcategory_name = "Υποκατηγορία 1." + str(cat_variant) + "." + str(subcat_variant) + ": Γεωδαισιακή Ορθογωνιότητα & Σταθερότητα Lyapunov";
        section_unit = "Ενότητα #" + str(sec_variant) + ": Μετασχηματισμός Cayley & Έλεγχος Αντιπαραδείγματος Euler";
        topic = world_sphere + " -> " + section_unit;
        proposer_model = "pbai_deq_lora";
        challenger_model = "pbai_topo_core";
        coder_model = "pbai_nano_coder";
        verifier_model = "pbai_security_ruler";
        winning_model = if counterexample_triggered { "pbai_topo_core" } else { "pbai_deq_lora" };
        tool_step1 = "pblang_pbai_joint_and_deq_trainer + ai_turn_budget";
        tool_step2 = "llm_topology_truth_gate + pblang_math_analytic_solver";
        sub_a = "submodel_math_symplectic_" + str(dyn_sub_id_a);
        sub_b = "submodel_stiefel_geodesic_" + str(dyn_sub_id_b);
