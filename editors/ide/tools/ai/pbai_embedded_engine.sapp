            code: "// Pure-PBLang ARC-AGI-2 2D Grid Transformer & Olympiad Geometry/Topology Prover\nfn rotate_grid_90_cw(grid_2x2) {\n    // Rotates [[a, b], [c, d]] -> [[c, a], [d, b]]\n    return [[grid_2x2[1][0], grid_2x2[0][0]], [grid_2x2[1][1], grid_2x2[0][1]]];\n}\n\nfn verify_euler_polyhedron_characteristic(vertices, edges, faces, genus = 0) {\n    let chi = vertices - edges + faces;\n    let expected = 2 - (2 * genus);\n    return map{ ok: chi == expected, euler_chi: chi, expected_chi: expected };\n}\n\nfn compute_triangle_area_shoelace(x1, y1, x2, y2, x3, y3) {\n    let signed2 = (x1 * (y2 - y3)) + (x2 * (y3 - y1)) + (x3 * (y1 - y2));\n    let abs2 = if signed2 < 0 { 0 - signed2 } else { signed2 };\n    return abs2 / 2.0;\n}\n\nexport rotate_grid_90_cw, verify_euler_polyhedron_characteristic, compute_triangle_area_shoelace;\n",
