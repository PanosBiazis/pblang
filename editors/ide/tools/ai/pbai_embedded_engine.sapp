    if (str_contains(low, "bayes") or str_contains(low, "posterior") or str_contains(low, "sensitivity") or str_contains(low, "combinations") or str_contains(low, "choose ") or str_contains(low, "ncr") or str_contains(low, "συνδυασμ")) and not str_contains(low, "hybrid") and not str_contains(low, "ντετερμινιστικ") and not str_contains(low, "πιθανοκρατικ") and not str_contains(low, "πειθανοκρατικ") and not str_contains(low, "boltzmann") and not str_contains(low, "langevin") {
