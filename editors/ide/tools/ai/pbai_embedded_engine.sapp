        + "<polygon id=\"pbai-3d-outer\" class=\"pb-spin-slow\" points=\"0,-42 40,-14 26,34 -26,34 -40,-14\" fill=\"rgba(168,85,247,0.22)\" stroke=\"#c084fc\" stroke-width=\"1.8\"/>"
        + "<polygon id=\"pbai-3d-inner\" class=\"pb-spin-rev\" points=\"0,-22 22,14 -22,14\" fill=\"rgba(56,189,248,0.20)\" stroke=\"#38bdf8\" stroke-width=\"1.4\"/>"
        + "<circle cx=\"0\" cy=\"0\" r=\"4\" fill=\"#fde047\"/>"
        + "</g>"
