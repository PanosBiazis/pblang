    }

    // V. Step-by-Step Linear Equation Solver (ax + b = c)
    if (str_contains(low, "linear") or str_contains(low, "find x") or str_contains(low, "πρωτοβάθμ") or (str_contains(low, "solve") and str_contains(low, "x") and str_contains(clean_prompt, "="))) and not str_contains(low, "quadratic") and not str_contains(clean_prompt, "^2") and not str_contains(clean_prompt, "!=") {
        let nums = _extract_numbers_from_text(clean_prompt);
