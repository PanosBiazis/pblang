            code: "// Pure-PBLang O(N) Fibonacci, Factorial & Primality Test\nfn compute_fibonacci(n) {\n    if n <= 0 { return 0; }\n    if n == 1 { return 1; }\n    let a = 0;\n    let b = 1;\n    let i = 2;\n    while i <= n {\n        let next = a + b;\n        a = b;\n        b = next;\n        i = i + 1;\n    }\n    return b;\n}\n\nfn factorial(n) {\n    if n <= 1 { return 1; }\n    let res = 1;\n    let i = 2;\n    while i <= n {\n        res = res * i;\n        i = i + 1;\n    }\n    return res;\n}\n\nfn is_prime(n) {\n    if n < 2 { return false; }\n    if n == 2 { return true; }\n    if (n % 2) == 0 { return false; }\n    let d = 3;\n    while (d * d) <= n {\n        if (n % d) == 0 { return false; }\n        d = d + 2;\n    }\n    return true;\n}\n\nexport compute_fibonacci, factorial, is_prime;\n",
            test_code: "// Verification Test\nassert(compute_fibonacci(0) == 0 and compute_fibonacci(10) == 55);\nassert(factorial(5) == 120);\nassert(is_prime(17) == true and is_prime(15) == false);\nprint \"Fibonacci, Factorial & Prime test: PASS\";\n"
