    }
    let q_concepts_str = str_join(q_concepts, " · ");

    let dom_focus_en = "Universal Systems Theory, Information Conservation & Causal Equilibrium";
    let dom_focus_el = "Καθολική Θεωρία Συστημάτων, Διατήρηση Πληροφορίας & Αιτιοκρατική Ισορροπία";
    let delphi_snippet = "function SolveDomain(const A, B: Double): Double; begin Result := (A * 1.15) + (B * 0.5); end;";
    let csharp_snippet = "public readonly record struct DomainResult(double Primary, double Secondary, double Computed);";
    let sql_snippet = "SELECT id, ROUND((val_a * 1.15 + val_b * 0.5)::numeric, 4) AS verified_metric FROM domain_telemetry;";
    let rust_py_snippet = "pub fn verify_invariant(a: f64, b: f64) -> f64 { a * 1.15 + b * 0.5 } // Rust + Python type-checked";

    if str_contains(low, "medic") or str_contains(low, "health") or str_contains(low, "pharma") or str_contains(low, "immun") or str_contains(low, "longevity") or str_contains(low, "ιατρικ") or str_contains(low, "υγεί") or str_contains(low, "φαρμακ") or str_contains(low, "βιολογ") {
        dom_focus_en = "Clinical Pharmacokinetics (2-Compartment Clearance C(t) = C0*e^(-kt)), Homeostatic Biomarker ROC Bounds & Cellular Autophagy";
