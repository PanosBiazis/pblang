                test_code: "// Verification Test for Thermodynamic Temperature Scales\nlet t = convert_temperature_scales(" + str(c_val) + ");\nassert(t.ok == true and t.fahrenheit == " + str(f_val) + " and t.kelvin == " + str(k_val) + ");\nprint \"Thermodynamic temperature converter test: PASS\";\n"
            };
        }
        let dist_km = if len(nums) >= 1 { nums[0] } else { 180.0 };
