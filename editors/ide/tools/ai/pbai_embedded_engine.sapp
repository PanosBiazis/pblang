            code: "// Pure-PBLang CLI Flag & Positional Argument Parser\nfn parse_cli_arguments(arg_list) {\n    let flags = map{ json: false, agent: false, help: false };\n    let positional = [];\n    for raw in arg_list {\n        let a = str_trim(str(raw));\n        if a == \"--json\" or a == \"-j\" { flags[\"json\"] = true; }\n        elif a == \"--agent\" or a == \"-a\" { flags[\"agent\"] = true; }\n        elif a == \"--help\" or a == \"-h\" { flags[\"help\"] = true; }\n        elif a != \"--\" and a != \"\" { push(positional, a); }\n    }\n    return map{ ok: true, flags: flags, positional: positional, count: len(positional) };\n}\n\nexport parse_cli_arguments;\n",
