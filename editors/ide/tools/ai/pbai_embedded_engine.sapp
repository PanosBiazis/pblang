        + "</svg>";

    // 4. Playable Audio / Music / Vocal Formant Synthesizer (Real WAV + Oscilloscope SVG)
    let wav_data_uri = "data:audio/wav;base64,UklGRiYAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQIAAACA/38=";
    let audio_svg = "<svg id=\"pbai-studio-audio-svg\" viewBox=\"0 0 800 105\" style=\"width:100%;max-width:100%;height:auto;display:block;background:#071122;border:1px solid #f59e0b;border-radius:10px;box-sizing:border-box\" role=\"img\" aria-label=\"pbAI Harmonic Audio Waveform &amp; Spectrum\">"
        + "<text id=\"pbai-aud-title\" x=\"16\" y=\"22\" fill=\"#fcd34d\" font-size=\"11.1\" font-weight=\"bold\">🎵 Ηχητικό Κύμα, 4-Stem Τραγούδι &amp; 5-Formant Φωνή (f0=" + str(freq_hz) + " Hz · Συγχορδία " + str(freq_hz) + "/" + str(third_hz) + "/" + str(fifth_hz) + " Hz · MOS 4.88)</text>"
