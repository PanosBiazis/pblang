// Χτίζει το λεξικό έγκυρων ελληνικών μορφών (do-no-harm) από το FrequencyWords el_full
// (hermitdave, CC BY-SA 4.0, OpenSubtitles 2018). Αναπαραγώγιμο, χωρίς Python.
//
// Χρήση:
//   PBAI_WORDFREQ_SRC=/path/el_full.txt [PBAI_WORDFREQ_MIN=10] \
//   pblang run editors/ide/tools/ai/data/build_el_wordforms.sapp
//
// Φίλτρα (γενικοί κανόνες ορθογραφίας, όχι λίστες εξαιρέσεων):
//  1. συχνότητα >= PBAI_WORDFREQ_MIN
//  2. μόνο ελληνικά γράμματα (+ απόστροφος)
//  3. λέξη χωρίς τόνο κρατιέται ΜΟΝΟ αν είναι μονοσύλλαβη (μια ομάδα φωνηέντων·
//     δίψηφα αι/ει/οι/ου/υι/αυ/ευ/ηυ και συνίζηση ια/ιο/ιε/ιου μετράνε ως μία).
//     Έτσι αποκλείονται άτονες ανορθογραφίες υποτίτλων («καλα», «εισαι», «ποτε»).

fn _chars(s) { let out = []; let i = 0; let n = len(s); while i < n { push(out, str_slice(s, i, i + 1)); i = i + 1; } return out; }

let OUT = "editors/ide/tools/ai/data/el_wordforms_opensubtitles_full_min10.txt";

fn _is_greek_lower_letter(ch) {
    return str_contains("αβγδεζηθικλμνξοπρστυφχψωςάέήίόύώϊϋΐΰ'", ch);
}

fn _is_vowel(ch) { return str_contains("αεηιουωάέήίόύώϊϋΐΰ", ch); }
fn _has_accent(w) {
    for ch in _chars(w) { if str_contains("άέήίόύώΐΰ", ch) { return true; } }
    return false;
}

fn _vowel_groups(w) {
    let cs = _chars(w);
    let n = len(cs);
    let i = 0;
    let groups = 0;
    while i < n {
        if _is_vowel(cs[i]) {
            groups = groups + 1;
            let j = i + 1;
            while j < n and _is_vowel(cs[j]) { j = j + 1; }
            // ομάδα φωνηέντων cs[i..j): μετρά ως 1 αν είναι δίψηφο/συνίζηση, αλλιώς κάθε φωνήεν χωριστά
            let grp = str_join(str_slice_list(cs, i, j), "");
            let ok_one = grp == "αι" or grp == "ει" or grp == "οι" or grp == "ου" or grp == "υι" or grp == "αυ" or grp == "ευ" or grp == "ηυ" or grp == "ια" or grp == "ιο" or grp == "ιε" or grp == "ιου" or grp == "ιαι" or len(grp) == 1;
            if not ok_one { groups = groups + (j - i) - 1; }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return groups;
}

fn str_slice_list(arr, a, b) {
    let out = [];
    let k = a;
    while k < b { push(out, arr[k]); k = k + 1; }
    return out;
}

let src = str_trim(str(env_get("PBAI_WORDFREQ_SRC")));
let min_env = try str_trim(str(env_get("PBAI_WORDFREQ_MIN"))) catch "";
let min_f = if min_env != "" and min_env != "nil" { json_parse(min_env) } else { 10 };
let raw = fs_read(src);
print "πηγή: " + src + " sha256 " + sha256(raw);
let kept = [];
let seen = map{};
let dropped_unaccented = 0;
for ln in str_split(raw, "\n") {
    let parts = str_split(str_trim(ln), " ");
    if len(parts) == 2 {
        let f = json_parse(parts[1]);
        if f < min_f { break; }
        let w = parts[0];
        let ok = len(w) > 0;
        if ok { for ch in _chars(w) { if not _is_greek_lower_letter(ch) { ok = false; break; } } }
        if ok and not _has_accent(w) and _vowel_groups(w) > 1 { ok = false; dropped_unaccented = dropped_unaccented + 1; }
        if ok and not map_has(seen, w) { seen[w] = true; push(kept, w); }
    }
}
fs_write(OUT, str_join(kept, "\n") + "\n");
print "κρατήθηκαν: " + str(len(kept)) + "  απορρίφθηκαν άτονες πολυσύλλαβες: " + str(dropped_unaccented);
print "έξοδος: " + OUT + " sha256 " + sha256(fs_read(OUT));
