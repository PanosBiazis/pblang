let _TOPO_EVAL_CACHE = map{};

fn render_living_organism_pure_pblang_html_dashboard(spec = nil) {
    let s = if type(spec) == "map" { spec } else { map{} };
    let st = if map_has(s, "organism_state") and type(s["organism_state"]) == "map" {
        _normalize_org_state(s["organism_state"])
    } else {
        read_living_organism_state_fast()
    };
    let ctl = read_control_state_fast();
    let topo = if map_has(_TOPO_EVAL_CACHE, "v35_topo") {
        _TOPO_EVAL_CACHE["v35_topo"]
    } else {
        let t = evaluate_klein_bottle_mobius_trefoil_and_nd_tesseract(s);
        _TOPO_EVAL_CACHE["v35_topo"] = t;
        t
    };
    let svgs = render_topology_and_organism_svg_panels(st);

    let hist_rows = "";
    for h in st.recent_history {
        hist_rows = hist_rows + "<tr><td>Tick #" + str(h.tick) + "</td><td>" + _escape_html(h.stage) + "</td><td>" + str(h.neurons) + "</td><td>" + str(h.synapses) + "</td><td>" + str(h.axons) + "</td><td>" + str(h.fitness) + "</td><td>" + _escape_html(_redact_text(h.stimulus)) + "</td></tr>";
    }

    let ctl_mode = if map_has(ctl, "mode") { str(ctl["mode"]) } else { "autonomous_running" };
    let ctl_focus = if map_has(ctl, "focus_domain") { str(ctl["focus_domain"]) } else { "all_108x864x10240_categories_e8_leech_moonshine" };
    let css_inline = observatory_stylesheet();

    let html = "<!doctype html>\n<html lang=\"el\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'\">\n<title>pbAI v38.0.0 — Ζωντανός Οργανισμός &amp; Τοπολογικό Παρατηρητήριο (E8 · Leech 24D · Moonshine · 100% PBLang)</title>\n<link rel=\"stylesheet\" href=\"/website/observatory.css\">\n<style>" + css_inline + "</style>\n</head>\n<body>\n"
        + "<nav class=\"topnav\" aria-label=\"Πλοήγηση pbAI\">\n"
        + "  <div><strong>pbAI v38.0.0 Observatory</strong> · <span class=\"badge ctrl\">Κατάσταση: " + _escape_html(ctl_mode) + "</span> <span class=\"badge\">Εστίαση: " + _escape_html(ctl_focus) + "</span></div>\n"
        + "  <div class=\"topnav-links\">\n"
        + "    <a class=\"navbtn active\" href=\"/observatory\">Ζωντανό Παρατηρητήριο</a>\n"
        + "    <a class=\"navbtn\" href=\"/observatory?refresh=15\">Αυτόματη Ανανέωση (15s)</a>\n"
        + "    <a class=\"navbtn\" href=\"/website/\">Κονσόλα Ελέγχου &amp; Επικοινωνίας (/website/)</a>\n"
        + "    <a class=\"navbtn\" href=\"/api/health\">API Health</a>\n"
        + "  </div>\n"
        + "</nav>\n"
        + "<header>\n  <h1>pbAI v38.0.0 — Ζωντανός Οργανισμός &amp; Τοπολογικό Παρατηρητήριο (8D E8 Gosset · 24D Leech · Monster Moonshine · Hopf · Octonion · Klein · Möbius · 4D Tesseract)</h1>\n  <div>\n    <span class=\"badge\">100% Pure PBLang</span>\n    <span class=\"badge\">Zero Python</span>\n    <span class=\"badge\">Zero JavaScript</span>\n    <span class=\"badge\">Zero Hardcoded Paths</span>\n    <span class=\"badge\">Boot Autostart: systemd + cron</span>\n    <span class=\"badge\">Privacy: [REDACTED] / Private / Loopback 127.0.0.1</span>\n  </div>\n</header>\n<section class=\"kpi-grid\">\n  <div class=\"kpi\"><div class=\"label\">Στάδιο Οντογένεσης</div><div class=\"val\">" + _escape_html(st.ontogenesis_stage) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">Ticks Αυτόνομης Εξέλιξης</div><div class=\"val\">#" + str(st.session_ticks) + " (Live)</div></div>\n  <div class=\"kpi\"><div class=\"label\">Φλοιώδεις Νευρώνες</div><div class=\"val\">" + str(st.cortical_neurons) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">Ενεργές Συνάψεις</div><div class=\"val\">" + str(st.active_synapses) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">Μυελινωμένοι Άξονες</div><div class=\"val\">" + str(st.myelinated_fast_path_axons) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">Stiefel-LoRA / Αντισώματα</div><div class=\"val\">" + str(st.stiefel_lora_cartridges) + " / " + str(st.immune_antibodies_synthesized) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">Μονοτονικό Fitness V(S)</div><div class=\"val\">" + str(st.monotonic_fitness_score) + "</div></div>\n  <div class=\"kpi\"><div class=\"label\">8D E8 Roots / 24D Leech</div><div class=\"val\">240 / 196,560</div></div>\n  <div class=\"kpi\"><div class=\"label\">Monster Moonshine c1</div><div class=\"val\">196,884 = 1+196,883</div></div>\n  <div class=\"kpi\"><div class=\"label\">PCC Θεωρήματα / Ταχύτητα / MCP</div><div class=\"val\">536.87M · 3,500 tok/s · 2,304</div></div>\n</section>\n<section class=\"svg-grid\">\n  " + svgs.mobius_klein_svg + "\n  " + svgs.tesseract_trefoil_svg + "\n  " + svgs.galaxy_lightcone_svg + "\n  " + svgs.organism_growth_svg + "\n  " + svgs.e8_fano_svg + "\n  " + svgs.leech_hopf_moonshine_svg + "\n</section>\n<section class=\"card\">\n  <h2>Ιστορικό Αυτόνομης Ανάπτυξης &amp; Νευρογένεσης (Living-Organism Checkpoint Log)</h2>\n  <table>\n    <thead><tr><th>Tick</th><th>Στάδιο Οντογένεσης</th><th>Νευρώνες</th><th>Συνάψεις</th><th>Μυελίνωση</th><th>Fitness</th><th>Ερέθισμα (Redacted)</th></tr></thead>\n    <tbody>" + hist_rows + "</tbody>\n  </table>\n</section>\n<section class=\"card\">\n  <h2>Τοπολογικές &amp; Πολυδιάστατες Δομές PBLang (E8 · Leech 24D · Moonshine · Hopf · Octonion · Klein · Möbius · Tesseract)</h2>\n  <p>Möbius Strip Walk States: <strong>" + str(topo.mobius_strip.total_walk_states) + "</strong> (Lap-1 Flip: <strong>" + str(topo.mobius_strip.lap1_orientation_flipped) + "</strong>) | Klein Bottle Twist Verified: <strong>" + str(topo.klein_bottle.antipodal_twist_verified) + "</strong> | 4D Tesseract: <strong>" + str(topo.tesseract_and_nd_hypercube.tesseract_4d_vertices) + "V / " + str(topo.tesseract_and_nd_hypercube.tesseract_4d_edges) + "E</strong> | 5D Hypercube: <strong>" + str(topo.tesseract_and_nd_hypercube.hypercube_5d_vertices) + "V / " + str(topo.tesseract_and_nd_hypercube.hypercube_5d_edges) + "E</strong> | 8D E8 Gosset Lattice: <strong>240 Roots (dim=248)</strong> | 24D Leech Lattice: <strong>196,560 Kissing Number (759 Golay G24 Octads)</strong> | Monster Moonshine: <strong>196,884</strong> | 100-Site SPT String Order: <strong>" + str(topo.spt_quantum_spin_chain.non_local_string_order_parameter) + "</strong></p>\n</section>\n</body>\n</html>\n";

    let persist_html = if map_has(s, "persist_html") { s["persist_html"] } else { true };
    let targets = _resolve_dashboard_paths();
    let written = false;
    if persist_html {
        for target_p in targets {
            try {
                fs_write(target_p, html);
                written = true;
            } catch err {
            }
        }
    }

    return map{
        ok: str_contains(html, "<svg") and not str_contains(html, "<script"),
        engine: "living_organism_pure_pblang_html_dashboard_v35",
        html_length_bytes: len(html),
        contains_svg: str_contains(html, "<svg"),
        javascript_required: false,
        csp_hardened: true,
        zero_hardcoded_paths: true,
        persisted_to_checkpoints: written,
        relative_checkpoint: "checkpoints/living_organism_live_dashboard.html",
        dashboard_html: html
    };
}

