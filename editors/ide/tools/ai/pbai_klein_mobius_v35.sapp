// ============================================================================
fn advance_and_persist_living_organism_session_tick_v35(spec = nil) {
    let s = if type(spec) == "map" { spec } else { map{} };
    let do_persist = if map_has(s, "persist") { s["persist"] } else { true };
    let raw_tick = V34.advance_and_persist_living_organism_session_tick_v34(map{
        persist_to_disk: do_persist
    });
    let norm = _normalize_org_state(raw_tick);
    let dash = render_living_organism_pure_pblang_html_dashboard(map{
        organism_state: norm,
        persist_html: do_persist
    });
    return map{
        ok: raw_tick.ok and dash.ok,
        engine: "living_organism_session_tick_and_live_dashboard_v35",
        organism_growth: norm,
        live_html_dashboard: map{
            ok: dash.ok,
            html_length_bytes: dash.html_length_bytes,
            contains_svg: dash.contains_svg,
            javascript_required: dash.javascript_required,
            persisted_to_checkpoints: dash.persisted_to_checkpoints,
            relative_checkpoint: dash.relative_checkpoint
        }
    };
}

