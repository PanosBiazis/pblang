// ============================================================================
let _CACHED_SVG_KEY = "";
let _CACHED_SVG_PANELS = nil;
let _CACHED_TOPO_EPOCH = -1;
let _CACHED_TOPO_FIVE = nil;
let _MEM_ORG_STATE = nil;

fn read_living_organism_state_fast() {
    let candidates = [
        "checkpoints/living_organism_state.json",
        "../pbai/checkpoints/living_organism_state.json",
        "../../pbai/checkpoints/living_organism_state.json",
        "editors/ide/tools/ai/checkpoints/living_organism_state.json"
    ];
    let best_norm = nil;
    let best_ticks = -1;
    if _MEM_ORG_STATE != nil {
        let mem_t = try _MEM_ORG_STATE.session_ticks catch -1;
        best_ticks = num_floor(mem_t);
    }
    for p in candidates {
        if fs_exists(p) {
            let txt = try fs_read(p) catch "";
            if len(txt) > 10 {
                let parsed = try json_parse(txt) catch nil;
                if type(parsed) == "map" {
                    let norm = _normalize_org_state(parsed);
                    let raw_tv = try norm.session_ticks catch 0;
                    let t_val = num_floor(raw_tv);
                    if t_val >= best_ticks {
                        best_ticks = t_val;
                        best_norm = norm;
                    }
                }
            }
        }
    }
    if best_norm != nil {
        _MEM_ORG_STATE = best_norm;
        return best_norm;
    }
    if _MEM_ORG_STATE != nil {
        return _MEM_ORG_STATE;
    }
    let raw = _v34().advance_and_persist_living_organism_session_tick_v34(map{ persist_to_disk: false });
    let norm2 = _normalize_org_state(raw);
    _MEM_ORG_STATE = norm2;
    return norm2;
}

fn read_control_state_fast() {
    let candidates = [
        "checkpoints/living_organism_control.json",
        "../pbai/checkpoints/living_organism_control.json",
        "../../pbai/checkpoints/living_organism_control.json"
    ];
    for p in candidates {
        if fs_exists(p) {
            let txt = try fs_read(p) catch "";
            if len(txt) > 5 {
                let parsed = try json_parse(txt) catch nil;
                if type(parsed) == "map" {
                    return parsed;
                }
            }
        }
    }
    return map{
        mode: "autonomous_running",
        focus_domain: "all_24x144x1152x13824_categories_e8_leech_moonshine",
        custom_stimulus: "os_systemd_laptop_boot_e8_leech_moonshine_tick_v38",
        boot_autostart_enabled: true,
        release: "v38.5.0"
    };
}

fn advance_natural_live_tick(stimulus = "autonomous_live_stream_tick") {
    let cur = read_living_organism_state_fast();
    let prev_ticks = num_floor(cur.session_ticks);
    let prev_neurons = num_floor(cur.cortical_neurons);
    let prev_synapses = num_floor(cur.active_synapses);
    let prev_axons = num_floor(cur.myelinated_fast_path_axons);
    let prev_lora = num_floor(cur.stiefel_lora_cartridges);
    let prev_anti = num_floor(cur.immune_antibodies_synthesized);
    let prev_fit = cur.monotonic_fitness_score;
    let prev_skills = num_floor(try cur.verified_functional_skills_count catch (512 + prev_ticks));
    let prev_w_eff = try cur.mean_synaptic_efficacy_w catch 0.9924;

    let next_ticks = prev_ticks + 1;
    let real_ms = try now_ms() catch (next_ticks * 104729);
    let h_hex = try sha256(str(real_ms) + "|" + str(next_ticks) + "|" + str(prev_neurons) + "|" + str(prev_synapses) + "|" + str(stimulus)) catch "a37f91c24b8e60d5192f47a83c5d6e1098b7a6f5e4d3c2b1a09f8e7d6c5b4a3f";
    let b0 = _hash_byte(h_hex, 0);
    let b1 = _hash_byte(h_hex, 2);
    let b2 = _hash_byte(h_hex, 4);
    let b3 = _hash_byte(h_hex, 6);
    let b4 = _hash_byte(h_hex, 8);
    let b5 = _hash_byte(h_hex, 10);

    let u1 = 0.02 + 0.96 * ((b0 * 256 + b1) / 65535.0);
    let u2 = (b2 * 256 + b3) / 65535.0;
    let u3 = (b4 * 256 + b5) / 65535.0;
    let t_ln = (1.0 - u1) / (1.0 + u1);
    let t_ln2 = t_ln * t_ln;
    let neg_ln_u1 = 2.0 * t_ln * (1.0 + (t_ln2 / 3.0) + ((t_ln2 * t_ln2) / 5.0));
    let rad_v = 2.0 * neg_ln_u1;
    let sq_g = if rad_v > 1.0 { rad_v * 0.5 } else { 1.0 };
    sq_g = 0.5 * (sq_g + (rad_v / sq_g));
    sq_g = 0.5 * (sq_g + (rad_v / sq_g));
    sq_g = 0.5 * (sq_g + (rad_v / sq_g));
    sq_g = 0.5 * (sq_g + (rad_v / sq_g));
    let box_muller_z = sq_g * Math.cos(6.283185307 * u2);

    let phase_rad = next_ticks * 0.5235987756 + u2 * 1.5707963268;
    let det_wave_a = Math.sin(phase_rad);
    let det_wave_b = Math.cos(phase_rad * 1.6180339887);
    let free_energy_surprise = 1.0 + 0.48 * det_wave_a + 0.32 * det_wave_b;

    // 4 Long-Horizon Physiological Regimes of the Cortical Brain Network (K_adult = 68,000):
    // 1. EXPLORATION_LTP_BURST: Active neurogenesis & dendritic spine sprouting (+born > -pruned)
    // 2. HEBBIAN_MYELIN_CONSOLIDATION: Balanced neurogenesis + rapid oligodendrocyte myelination
    // 3. REM_MICROGLIA_PRUNING: Synaptic & neuronal microglia pruning (-pruned > +born, so net ΔN < 0 while efficacy w_ij increases!)
    // 4. CRITICAL_ATTRACTOR_EQUILIBRIUM: Homeostatic criticality (σ ≈ 1.000) near K_adult = 68,000
    let adult_carrying_cap = 68000.0;
    let cap_ratio = prev_neurons / adult_carrying_cap;
    let cycle_pos = (next_ticks + (b0 % 5)) % 16;
    let regime = "CRITICAL_ATTRACTOR_EQUILIBRIUM";
    if cap_ratio >= 0.965 {
        if cycle_pos < 6 { regime = "REM_MICROGLIA_PRUNING"; }
    } elif cycle_pos == 5 or cycle_pos == 11 or cycle_pos == 15 {
        regime = "REM_MICROGLIA_PRUNING";
    } elif cycle_pos < 7 {
        regime = "EXPLORATION_LTP_BURST";
    } elif cycle_pos < 13 {
        regime = "HEBBIAN_MYELIN_CONSOLIDATION";
    }

    let raw_maturation = 0.12;
    if prev_neurons < 40000 {
        raw_maturation = 1.0;
    } elif prev_neurons < adult_carrying_cap {
        raw_maturation = 0.25 + 0.75 * ((adult_carrying_cap - prev_neurons) / 28000.0);
    }

    let sprouted_born = 8;
    let apoptosis_pruned = 4;
    if regime == "EXPLORATION_LTP_BURST" {
        sprouted_born = num_floor((14.0 * free_energy_surprise + 6.0 * num_abs(box_muller_z)) * raw_maturation) + 6 + (b1 % 7);
        apoptosis_pruned = 2 + (b2 % 5);
        if sprouted_born <= apoptosis_pruned { sprouted_born = apoptosis_pruned + 4 + (b3 % 6); }
    } elif regime == "HEBBIAN_MYELIN_CONSOLIDATION" {
        sprouted_born = num_floor((9.0 * free_energy_surprise + 3.5 * num_abs(box_muller_z)) * raw_maturation) + 4 + (b1 % 5);
        apoptosis_pruned = 3 + (b2 % 5);
        if sprouted_born <= apoptosis_pruned { sprouted_born = apoptosis_pruned + 1 + (b3 % 4); }
    } elif regime == "REM_MICROGLIA_PRUNING" {
        sprouted_born = 2 + (b1 % 5);
        let high_cap_prune = if prev_neurons > 66500 { 8 } else { 0 };
        apoptosis_pruned = sprouted_born + 2 + (b2 % 7) + high_cap_prune;
    } else {
        // CRITICAL_ATTRACTOR_EQUILIBRIUM
        sprouted_born = 4 + (b1 % 6);
        apoptosis_pruned = 3 + (b2 % 6);
    }

    // mathematically exact net_neuron_delta = sprouted_born - apoptosis_pruned
    let net_neuron_delta = sprouted_born - apoptosis_pruned;
    let next_neurons = prev_neurons + net_neuron_delta;
    if next_neurons > 68000 {
        let excess = next_neurons - 68000;
        apoptosis_pruned = apoptosis_pruned + excess + (1 + (b3 % 4));
        net_neuron_delta = sprouted_born - apoptosis_pruned;
        next_neurons = prev_neurons + net_neuron_delta;
    }
    if next_neurons < 16384 {
        sprouted_born = apoptosis_pruned + 6;
        net_neuron_delta = 6;
        next_neurons = 16390;
    }

    // 1. Small-World Hebbian Synaptic Plasticity & Microglia Spine Pruning
    let deg_add = if next_neurons > 16000 { (next_neurons - 16000) / 3600.0 } else { 0.0 };
    let target_syn_degree = 34.0 + deg_add;
    if target_syn_degree > 46.8 { target_syn_degree = 46.8; }
    let fanout = 36 + (b3 % 14);
    let new_syn = sprouted_born * fanout + 45 + (b4 % 60);
    let pruned_syn = apoptosis_pruned * 24 + 18 + (b5 % 35);
    if regime == "REM_MICROGLIA_PRUNING" {
        pruned_syn = apoptosis_pruned * 32 + 25 + (b5 % 40);
    }
    let net_syn = new_syn - pruned_syn;
    let next_synapses = prev_synapses + net_syn;
    let min_realistic_syn = num_floor(next_neurons * 34.2);
    if next_synapses < min_realistic_syn {
        net_syn = min_realistic_syn - prev_synapses;
        next_synapses = min_realistic_syn;
    }

    // Mean synaptic efficacy w_ij strengthens during REM pruning and Hebbian consolidation
    let w_step = if regime == "REM_MICROGLIA_PRUNING" { 0.000018 } else { 0.000007 };
    let next_w_eff = prev_w_eff + (0.99995 - prev_w_eff) * w_step;
    next_w_eff = num_floor(next_w_eff * 1000000.0 + 0.5) / 1000000.0;

    // 2. White-Matter Oligodendrocyte Myelination Homeostasis (~34.2% - 35.8% fast axons)
    let target_axons = num_floor(next_neurons * 0.344);
    let axon_step = (b3 % 4) - 1;
    if next_axons_target_low(prev_axons, target_axons) {
        axon_step = 2 + (b1 % 5);
    } elif prev_axons > num_floor(next_neurons * 0.358) {
        axon_step = -1 - (b2 % 3);
    }
    let next_axons = prev_axons + axon_step;
    if next_axons < num_floor(next_neurons * 0.332) {
        next_axons = target_axons;
    }

    // 3. Stiefel-SVD Orthogonal Cartridge Consolidation (smoothly tracks 820..2048 without abrupt resets)
    let target_lora = 820 + num_floor(next_neurons * 0.0168);
    if target_lora > 2048 { target_lora = 2048; }
    let lora_delta = 0;
    if prev_lora < target_lora - 8 {
        lora_delta = 1 + (b4 % 2);
    } elif prev_lora > target_lora + 12 {
        lora_delta = -1;
    } elif (next_ticks % 3) == 0 {
        lora_delta = 1;
    }
    let next_lora = prev_lora + lora_delta;
    if next_lora > 2048 { next_lora = 2048; }
    if next_lora < 816 { next_lora = 816; }

    // 4. PBRuler Antibody Affinity Maturation
    let target_anti = 8400 + num_floor(next_neurons * 0.132);
    let anti_delta = (b1 % 3) - 1;
    if prev_anti < target_anti - 20 {
        anti_delta = 2 + (b5 % 4);
    } elif prev_anti > target_anti + 40 {
        anti_delta = -1 - (b0 % 2);
    }
    let next_anti = prev_anti + anti_delta;

    // 5. Non-linear Verified Skill Crystallization (monotonically grows through consolidation & REM pruning)
    let u3_bonus = if u3 > 0.45 { 1 } else { 0 };
    let skill_delta = if u1 > 0.30 { 1 } else { 0 };
    if regime == "REM_MICROGLIA_PRUNING" or regime == "HEBBIAN_MYELIN_CONSOLIDATION" {
        skill_delta = 1 + u3_bonus;
    }
    let next_skills = prev_skills + skill_delta;

    // 6. Live Asymptotic Lyapunov Monotonic Fitness Score V(S) -> 100.0 (never drops even when REM prunes redundant neurons)
    let fit_gap = 100.0 - prev_fit;
    let next_fit = if fit_gap > 0.000002 {
        prev_fit + fit_gap * 0.0018
    } else {
        prev_fit + 0.000001
    };
    if next_fit > 99.999999 { next_fit = 99.999999; }
    let rounded_fit = num_floor(next_fit * 1000000.0 + 0.5) / 1000000.0;

    let skill_domains = [
        "symplectic_rk4_integrator",
        "stiefel_cayley_retraction",
        "klein_mobius_geodesic_router",
        "marchenko_pastur_spectral_filter",
        "open_world_epistemic_synthesizer",
        "kahan_compensated_rational_series",
        "post_quantum_lattice_syndrome_decoder",
        "fano_octonion_triad_associator",
        "cross_sphere_combinatorial_bridge",
        "byzantine_counterfactual_stress_gate"
    ];
    let latest_skill = skill_domains[(next_ticks + b2) % len(skill_domains)];

    // 7. Sparse-to-Dense Effective Parameter Equivalence (in Billions) incorporates synaptic efficacy & skills
    let eff_dense_b = num_floor(((next_lora * 1.45) + (next_neurons * 0.038 * next_w_eff) + (next_skills * 0.42)) * 100.0 + 0.5) / 100.0;

    // 8. Persistent rolling 6-point history so charts show real historical trajectory
    let prev_hist = try cur.recent_history catch [];
    let new_hist = [];
    let start_idx = if type(prev_hist) == "array" and len(prev_hist) >= 6 { len(prev_hist) - 5 } else { 0 };
    if type(prev_hist) == "array" {
        let hi = start_idx;
        while hi < len(prev_hist) {
            push(new_hist, prev_hist[hi]);
            hi = hi + 1;
        }
    }
    push(new_hist, map{
        tick: next_ticks,
        neurons: next_neurons,
        synapses: next_synapses,
        net_delta: net_neuron_delta,
        sprouted_born: sprouted_born,
        apoptosis_pruned: apoptosis_pruned,
        regime: regime
    });

    let raw_state = map{
        session_growth_ticks: next_ticks,
        ontogenetic_stage_name: cur.ontogenesis_stage,
        maturation_law: "Gompertz_Logistic_Adult_Brain_Plasticity",
        physiological_regime: regime,
        active_cortical_neurons: next_neurons,
        sprouted_neurogenesis_neurons: sprouted_born,
        apoptosis_pruned_neurons: apoptosis_pruned,
        net_neuron_delta: net_neuron_delta,
        synaptic_connections_count: next_synapses,
        net_synapse_delta: net_syn,
        mean_synaptic_efficacy_w: next_w_eff,
        myelinated_fast_axons_count: next_axons,
        stiefel_lora_domain_cartridges_count: next_lora,
        pbruler_antibody_memory_count: next_anti,
        lyapunov_monotonic_fitness_score: rounded_fit,
        verified_functional_skills_count: next_skills,
        latest_synthesized_skill: latest_skill,
        effective_dense_parameter_equivalence_billions: eff_dense_b,
        recent_history: new_hist,
        last_stimulus: str(stimulus)
    };
    let norm_out = _normalize_org_state(raw_state);
    _MEM_ORG_STATE = norm_out;
    let enc = try json_stringify(raw_state) catch "";
    if len(enc) > 20 {
        let write_paths = [
            "checkpoints/living_organism_state.json",
            "../pbai/checkpoints/living_organism_state.json",
            "editors/ide/tools/ai/checkpoints/living_organism_state.json",
            "../pblang/editors/ide/tools/ai/checkpoints/living_organism_state.json"
        ];
        for wp in write_paths {
            let dir_part = str_slice(wp, 0, len(wp) - len("/living_organism_state.json"));
            if fs_exists(dir_part) {
                try fs_write(wp, enc) catch nil;
            }
        }
    }
    return norm_out;
}

fn next_axons_target_low(prev_axons, target_axons) {
    return prev_axons < target_axons - 10;
}

fn _render_growth_chart_svg(st) {
    let org_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"Living Organism Ontogenesis Curve\">";
    org_svg = org_svg + "<defs><linearGradient id=\"bgGrad4\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0a1122\"/><stop offset=\"100%\" stop-color=\"#0f1b33\"/></linearGradient><linearGradient id=\"orgArea4\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#22c55e\" stop-opacity=\"0.42\"/><stop offset=\"100%\" stop-color=\"#22c55e\" stop-opacity=\"0.03\"/></linearGradient></defs>";
    org_svg = org_svg + "<rect x=\"0\" y=\"0\" width=\"360\" height=\"210\" rx=\"12\" fill=\"url(#bgGrad4)\" stroke=\"#293d5e\" stroke-width=\"1.2\"/>";
    org_svg = org_svg + "<text x=\"12\" y=\"20\" fill=\"#4ade80\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\">4. BRAIN CELL PLASTICITY (" + str(try st.physiological_regime catch "HOMEOSTASIS") + ")</text>";
    org_svg = org_svg + "<line x1=\"34\" y1=\"52\" x2=\"336\" y2=\"52\" stroke=\"#1e293b\" stroke-width=\"1\" stroke-dasharray=\"3,3\"/>";
    org_svg = org_svg + "<line x1=\"34\" y1=\"88\" x2=\"336\" y2=\"88\" stroke=\"#1e293b\" stroke-width=\"1\" stroke-dasharray=\"3,3\"/>";
    org_svg = org_svg + "<line x1=\"34\" y1=\"124\" x2=\"336\" y2=\"124\" stroke=\"#1e293b\" stroke-width=\"1\" stroke-dasharray=\"3,3\"/>";
    org_svg = org_svg + "<line x1=\"34\" y1=\"160\" x2=\"336\" y2=\"160\" stroke=\"#334155\" stroke-width=\"1.2\"/>";
    let hist = st.recent_history;
    let hlen = len(hist);
    if hlen > 0 {
        let min_n = hist[0].neurons;
        let max_n = hist[0].neurons;
        let scan_i = 1;
        while scan_i < hlen {
            if hist[scan_i].neurons < min_n { min_n = hist[scan_i].neurons; }
            if hist[scan_i].neurons > max_n { max_n = hist[scan_i].neurons; }
            scan_i = scan_i + 1;
        }
        let span_n = if max_n > min_n + 10 { max_n - min_n } else { 40 };
        let hi = 0;
        let last_px = 38;
        let last_py = 152;
        let hdiv = if hlen > 1 { hlen - 1 } else { 1 };
        let poly_pts = "38,160 ";
        while hi < hlen {
            let item = hist[hi];
            let px = num_floor(38.0 + (hi * 288.0) / hdiv);
            let rel_n = ((item.neurons - min_n) * 90.0) / span_n;
            let py = num_floor(148.0 - rel_n);
            poly_pts = poly_pts + str(px) + "," + str(py) + " ";
            hi = hi + 1;
        }
        poly_pts = poly_pts + "326,160";
        org_svg = org_svg + "<polygon points=\"" + poly_pts + "\" fill=\"url(#orgArea4)\"/>";
        hi = 0;
        while hi < hlen {
            let item = hist[hi];
            let px = num_floor(38.0 + (hi * 288.0) / hdiv);
            let rel_n = ((item.neurons - min_n) * 90.0) / span_n;
            let py = num_floor(148.0 - rel_n);
            if hi > 0 {
                org_svg = org_svg + "<line x1=\"" + str(last_px) + "\" y1=\"" + str(last_py) + "\" x2=\"" + str(px) + "\" y2=\"" + str(py) + "\" stroke=\"#4ade80\" stroke-width=\"2.6\"/>";
            }
            if hi == hlen - 1 {
                org_svg = org_svg + "<circle cx=\"" + str(px) + "\" cy=\"" + str(py) + "\" r=\"5\" fill=\"#4ade80\"><animate attributeName=\"r\" values=\"4;11;4\" dur=\"1.8s\" repeatCount=\"indefinite\"/><animate attributeName=\"opacity\" values=\"0.95;0.25;0.95\" dur=\"1.8s\" repeatCount=\"indefinite\"/></circle>";
            }
            org_svg = org_svg + "<circle cx=\"" + str(px) + "\" cy=\"" + str(py) + "\" r=\"4\" fill=\"#22c55e\" stroke=\"#052e16\" stroke-width=\"1.2\"/>";
            let fb_nd = try item.net_delta catch 0;
            let d_val = if hi > 0 { item.neurons - hist[hi - 1].neurons } else { fb_nd };
            let signed_d = if d_val >= 0 { "+" + str(d_val) } else { str(d_val) };
            let delta_lbl = if hi > 0 { signed_d } else { "#" + str(item.tick) };
            org_svg = org_svg + "<text x=\"" + str(px - 12) + "\" y=\"" + str(py - 9) + "\" fill=\"#bbf7d0\" font-size=\"8.5\" font-family=\"monospace\" font-weight=\"bold\">" + delta_lbl + "</text>";
            org_svg = org_svg + "<text x=\"" + str(px - 14) + "\" y=\"174\" fill=\"#94a3b8\" font-size=\"8\" font-family=\"monospace\">" + str(item.neurons) + "N</text>";
            last_px = px;
            last_py = py;
            hi = hi + 1;
        }
    }
    let net_d = try st.net_neuron_delta catch (st.sprouted_neurogenesis_neurons - st.apoptosis_pruned_neurons);
    let net_str = if net_d >= 0 { "+" + str(net_d) } else { str(net_d) };
    org_svg = org_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"8.8\" font-family=\"monospace\">T#" + str(st.session_ticks) + " (+" + str(st.sprouted_neurogenesis_neurons) + "/-" + str(st.apoptosis_pruned_neurons) + " Δ" + net_str + ") | E/I:4.0 | Skills:" + str(st.verified_functional_skills_count) + "</text></svg>";
    return org_svg;
}

fn render_topology_and_organism_svg_panels(state = nil) {
    let st = if type(state) == "map" { _normalize_org_state(state) } else { read_living_organism_state_fast() };
    let cache_key = "tick_v5_" + str(st.session_ticks) + "_" + str(st.cortical_neurons);
    if _CACHED_SVG_KEY == cache_key and _CACHED_SVG_PANELS != nil {
        return _CACHED_SVG_PANELS;
    }

    // Fast path: reuse the 5 SMIL-animated topological SVG panels across 20-tick epochs, updating only Panel 4 (live neuron chart)
    let topo_epoch = num_floor(st.session_ticks / 20.0);
    if _CACHED_TOPO_FIVE != nil and _CACHED_TOPO_EPOCH == topo_epoch {
        let fast_org_svg = _render_growth_chart_svg(st);
        let fast_panels = map{
            ok: true,
            cache_key: cache_key,
            mobius_klein_svg: _CACHED_TOPO_FIVE.mobius_klein_svg,
            tesseract_trefoil_svg: _CACHED_TOPO_FIVE.tesseract_trefoil_svg,
            galaxy_lightcone_svg: _CACHED_TOPO_FIVE.galaxy_lightcone_svg,
            organism_growth_svg: fast_org_svg,
            e8_fano_svg: _CACHED_TOPO_FIVE.e8_fano_svg,
            leech_hopf_moonshine_svg: _CACHED_TOPO_FIVE.leech_hopf_moonshine_svg
        };
        _CACHED_SVG_KEY = cache_key;
        _CACHED_SVG_PANELS = fast_panels;
        return fast_panels;
    }

    let tick_phase = (st.session_ticks % 360) * 0.1745329; // Live geometric phase evolution per epoch

    let common_defs = "<defs>"
        + "<linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#0a1122\"/><stop offset=\"100%\" stop-color=\"#0f1b33\"/></linearGradient>"
        + "<linearGradient id=\"orgArea\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#22c55e\" stop-opacity=\"0.38\"/><stop offset=\"100%\" stop-color=\"#22c55e\" stop-opacity=\"0.02\"/></linearGradient>"
        + "<radialGradient id=\"coreGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0%\" stop-color=\"#38bdf8\" stop-opacity=\"0.28\"/><stop offset=\"100%\" stop-color=\"#0a1122\" stop-opacity=\"0\"/></radialGradient>"
        + "</defs>"
        + "<rect x=\"0\" y=\"0\" width=\"360\" height=\"210\" rx=\"12\" fill=\"url(#bgGrad)\" stroke=\"#293d5e\" stroke-width=\"1.2\"/>"
        + "<line x1=\"180\" y1=\"32\" x2=\"180\" y2=\"182\" stroke=\"#1e293b\" stroke-width=\"1\" stroke-dasharray=\"3,3\"/>";

    // 1. Mobius Strip (2-Lap Involution) & Klein Bottle (Antipodal Twist)
    let mobius_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"Mobius Strip and Klein Bottle Topology\">" + common_defs;
    mobius_svg = mobius_svg + "<text x=\"12\" y=\"20\" fill=\"#64ffda\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">1. MOBIUS STRIP (2-Lap) &amp; KLEIN BOTTLE (χ=0)</text>";
    mobius_svg = mobius_svg + "<circle cx=\"92\" cy=\"110\" r=\"54\" fill=\"url(#coreGlow)\"/>";
    mobius_svg = mobius_svg + "<g>";
    mobius_svg = mobius_svg + "<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 92 110\" to=\"360 92 110\" dur=\"22s\" repeatCount=\"indefinite\"/>";
    let m_steps = 24;
    let m_walk = Topo.mobius_walk(m_steps);
    let prev_x = 0;
    let prev_y = 0;
    let idx = 0;
    for step in m_walk {
        let angle = (step.cell * 6.2831853) / m_steps + tick_phase;
        let twist_r = if step.side == 0 { 48.0 } else { 28.0 };
        let cx = num_floor(92.0 + twist_r * Math.cos(angle));
        let cy = num_floor(110.0 + (twist_r * 0.72) * Math.sin(angle));
        let col = if step.side == 0 { "#38bdf8" } else { "#f472b6" };
        if idx > 0 {
            mobius_svg = mobius_svg + "<line x1=\"" + str(prev_x) + "\" y1=\"" + str(prev_y) + "\" x2=\"" + str(cx) + "\" y2=\"" + str(cy) + "\" stroke=\"" + col + "\" stroke-width=\"2.2\" stroke-opacity=\"0.88\"/>";
        }
        mobius_svg = mobius_svg + "<circle cx=\"" + str(cx) + "\" cy=\"" + str(cy) + "\" r=\"2.7\" fill=\"" + col + "\"/>";
        prev_x = cx;
        prev_y = cy;
        idx = idx + 1;
    }
    let walker_ang = tick_phase * 1.5;
    let wx = num_floor(92.0 + 48.0 * Math.cos(walker_ang));
    let wy = num_floor(110.0 + 34.5 * Math.sin(walker_ang));
    mobius_svg = mobius_svg + "<circle cx=\"" + str(wx) + "\" cy=\"" + str(wy) + "\" r=\"4.5\" fill=\"#fde047\" stroke=\"#0a1122\" stroke-width=\"1.2\"/>";
    mobius_svg = mobius_svg + "</g>";
    let gx = 0;
    while gx < 6 {
        let gy = 0;
        while gy < 6 {
            let wrapped = Topo.klein_wrap(gx + 1, gy, 6, 6);
            let px = 205 + gx * 24;
            let py = 50 + gy * 22;
            let ccol = if gx == 5 { "#fbbf24" } else { "#818cf8" };
            mobius_svg = mobius_svg + "<circle cx=\"" + str(px) + "\" cy=\"" + str(py) + "\" r=\"3\" fill=\"" + ccol + "\"/>";
            if gx == 5 {
                let target_py = 50 + wrapped.y * 22;
                mobius_svg = mobius_svg + "<line x1=\"" + str(px) + "\" y1=\"" + str(py) + "\" x2=\"205\" y2=\"" + str(target_py) + "\" stroke=\"#fbbf24\" stroke-width=\"1.3\" stroke-dasharray=\"4,4\"><animate attributeName=\"stroke-dashoffset\" from=\"16\" to=\"0\" dur=\"1.8s\" repeatCount=\"indefinite\"/></line>";
            }
            gy = gy + 1;
        }
        gx = gx + 1;
    }
    mobius_svg = mobius_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\">Side0(Cyan)/Side1(Pink) | Klein Gluing: y-&gt;h-1-y (T#" + str(st.session_ticks) + ")</text></svg>";

    // 2. 4D Tesseract (16V/32E) & Chiral Trefoil Knot Braid
    let tess_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"4D Tesseract and Trefoil Knot\">" + common_defs;
    tess_svg = tess_svg + "<text x=\"12\" y=\"20\" fill=\"#a78bfa\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">2. 4D TESSERACT (16V/32E) &amp; TREFOIL KNOT BRAID</text>";
    tess_svg = tess_svg + "<circle cx=\"92\" cy=\"112\" r=\"52\" fill=\"url(#coreGlow)\"/>";
    tess_svg = tess_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" values=\"-8 92 112; 8 92 112; -8 92 112\" dur=\"9s\" repeatCount=\"indefinite\"/>";
    let raw_4d = GpuND.hypercube(4);
    let ang_a = 24 + ((st.session_ticks * 7) % 45);
    let ang_b = 18 + ((st.session_ticks * 11) % 40);
    let rot_4d = GpuND.rotate_cube(raw_4d, 0, 3, GpuND.deg(ang_a));
    let rot_4d_b = GpuND.rotate_cube(rot_4d, 1, 2, GpuND.deg(ang_b));
    let pts_2d = [];
    for pt4 in rot_4d_b.vertices {
        let p2 = GpuND.project_to_2d(pt4, [3.6, 3.6]);
        let sx = num_floor(92.0 + p2.x * 48.0);
        let sy = num_floor(112.0 + p2.y * 48.0);
        push(pts_2d, [sx, sy]);
    }
    let edges_4d = Topo.tesseract_edges();
    let e_idx = 0;
    for edge in edges_4d {
        let a = pts_2d[edge[0]];
        let b = pts_2d[edge[1]];
        let ecol = if e_idx < 16 { "#38bdf8" } else { "#c084fc" };
        tess_svg = tess_svg + "<line x1=\"" + str(a[0]) + "\" y1=\"" + str(a[1]) + "\" x2=\"" + str(b[0]) + "\" y2=\"" + str(b[1]) + "\" stroke=\"" + ecol + "\" stroke-width=\"1.35\" stroke-opacity=\"0.85\"/>";
        e_idx = e_idx + 1;
    }
    let v_idx = 0;
    for p in pts_2d {
        let vcol = if v_idx < 8 { "#64ffda" } else { "#f472b6" };
        tess_svg = tess_svg + "<circle cx=\"" + str(p[0]) + "\" cy=\"" + str(p[1]) + "\" r=\"2.8\" fill=\"" + vcol + "\"/>";
        v_idx = v_idx + 1;
    }
    tess_svg = tess_svg + "</g>";
    tess_svg = tess_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 270 112\" to=\"360 270 112\" dur=\"15s\" repeatCount=\"indefinite\"/>";
    let trefoil = Topo.trefoil_curve(42);
    let ti = 0;
    while ti < len(trefoil) {
        let cur = trefoil[ti];
        let nxt = trefoil[(ti + 1) % len(trefoil)];
        let x1 = num_floor(270.0 + cur.x * 17.5);
        let y1 = num_floor(112.0 + cur.y * 17.5);
        let x2 = num_floor(270.0 + nxt.x * 17.5);
        let y2 = num_floor(112.0 + nxt.y * 17.5);
        let tcol = "#fbbf24";
        if (ti + st.session_ticks) % 3 == 0 { tcol = "#34d399"; }
        elif (ti + st.session_ticks) % 3 == 1 { tcol = "#38bdf8"; }
        tess_svg = tess_svg + "<line x1=\"" + str(x1) + "\" y1=\"" + str(y1) + "\" x2=\"" + str(x2) + "\" y2=\"" + str(y2) + "\" stroke=\"" + tcol + "\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>";
        ti = ti + 1;
    }
    tess_svg = tess_svg + "</g>";
    tess_svg = tess_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\">Left: 4D Hypercube (θ=" + str(ang_a) + "°/" + str(ang_b) + "°) | Right: (2,3)-Torus Braid</text></svg>";

    // 3. Galaxy Spiral & Minkowski Causal Light-Cone
    let gal_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"Galaxy Spiral and Causal Light Cone\">" + common_defs;
    gal_svg = gal_svg + "<text x=\"12\" y=\"20\" fill=\"#fbbf24\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">3. GALAXY SPIRAL &amp; MINKOWSKI CAUSAL LIGHT-CONE</text>";
    gal_svg = gal_svg + "<circle cx=\"92\" cy=\"112\" r=\"54\" fill=\"url(#coreGlow)\"/>";
    gal_svg = gal_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 92 112\" to=\"360 92 112\" dur=\"16s\" repeatCount=\"indefinite\"/>";
    let g_pts = Topo.galaxy_spiral(52, 4, 2, 4.0);
    let gi = 0;
    for gp in g_pts {
        let gx_p = num_floor(92.0 + gp.x);
        let gy_p = num_floor(112.0 + gp.y);
        let gcol = "#34d399";
        if (gi + st.session_ticks) % 4 == 0 { gcol = "#fde047"; }
        elif (gi + st.session_ticks) % 4 == 1 { gcol = "#60a5fa"; }
        elif (gi + st.session_ticks) % 4 == 2 { gcol = "#f472b6"; }
        gal_svg = gal_svg + "<circle cx=\"" + str(gx_p) + "\" cy=\"" + str(gy_p) + "\" r=\"2.4\" fill=\"" + gcol + "\"/>";
        gi = gi + 1;
    }
    gal_svg = gal_svg + "<circle cx=\"92\" cy=\"112\" r=\"5\" fill=\"#fef08a\"/></g>";
    gal_svg = gal_svg + "<line x1=\"202\" y1=\"110\" x2=\"338\" y2=\"110\" stroke=\"#475569\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>";
    gal_svg = gal_svg + "<line x1=\"270\" y1=\"38\" x2=\"270\" y2=\"182\" stroke=\"#475569\" stroke-width=\"1\" stroke-dasharray=\"2,2\"/>";
    gal_svg = gal_svg + "<polygon points=\"270,110 216,44 324,44\" fill=\"#38bdf8\" fill-opacity=\"0.22\" stroke=\"#38bdf8\" stroke-width=\"1.6\"/>";
    gal_svg = gal_svg + "<polygon points=\"270,110 216,176 324,176\" fill=\"#a78bfa\" fill-opacity=\"0.22\" stroke=\"#a78bfa\" stroke-width=\"1.6\"/>";
    gal_svg = gal_svg + "<ellipse cx=\"270\" cy=\"44\" rx=\"54\" ry=\"7\" fill=\"none\" stroke=\"#7dd3fc\" stroke-width=\"1.2\" stroke-dasharray=\"3,2\"/>";
    gal_svg = gal_svg + "<ellipse cx=\"270\" cy=\"176\" rx=\"54\" ry=\"7\" fill=\"none\" stroke=\"#c4b5fd\" stroke-width=\"1.2\" stroke-dasharray=\"3,2\"/>";
    gal_svg = gal_svg + "<circle cx=\"270\" cy=\"110\" r=\"4\" fill=\"#fbbf24\"><animate attributeName=\"r\" values=\"3;16;3\" dur=\"3s\" repeatCount=\"indefinite\"/><animate attributeName=\"opacity\" values=\"1;0.2;1\" dur=\"3s\" repeatCount=\"indefinite\"/></circle>";
    gal_svg = gal_svg + "<circle cx=\"270\" cy=\"110\" r=\"4\" fill=\"#fef08a\"/>";
    gal_svg = gal_svg + "<text x=\"246\" y=\"62\" fill=\"#bae6fd\" font-size=\"8.5\" font-family=\"monospace\">Future t&gt;0</text>";
    gal_svg = gal_svg + "<text x=\"250\" y=\"166\" fill=\"#ddd6fe\" font-size=\"8.5\" font-family=\"monospace\">Past t&lt;0</text>";
    gal_svg = gal_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\">Left: 4-Arm Spiral | Right: ds^2 = -c^2dt^2 + dx^2 &lt;= 0</text></svg>";

    // 4. Living Organism Ontogenesis & Non-Linear Neurogenesis Curve
    let org_svg = _render_growth_chart_svg(st);

    // 5. 8D E8 Gosset Root Lattice & Octonion Fano Plane
    let e8_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"8D E8 Gosset Root Lattice and Octonion Fano Plane\">" + common_defs;
    e8_svg = e8_svg + "<text x=\"12\" y=\"20\" fill=\"#38bdf8\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">5. 8D E8 GOSSET (240 ROOTS) &amp; OCTONION FANO PLANE</text>";
    e8_svg = e8_svg + "<circle cx=\"92\" cy=\"112\" r=\"54\" fill=\"url(#coreGlow)\"/>";
    e8_svg = e8_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 92 112\" to=\"360 92 112\" dur=\"24s\" repeatCount=\"indefinite\"/>";
    let c_idx = 0;
    let ring_pts = [];
    while c_idx < 15 {
        let ang = (c_idx * 6.2831853) / 15.0 + tick_phase * 0.5;
        let rx1 = num_floor(92.0 + 50.0 * Math.cos(ang));
        let ry1 = num_floor(112.0 + 50.0 * Math.sin(ang));
        let rx2 = num_floor(92.0 + 29.0 * Math.cos(ang + 0.21));
        let ry2 = num_floor(112.0 + 29.0 * Math.sin(ang + 0.21));
        push(ring_pts, [rx1, ry1, rx2, ry2]);
        c_idx = c_idx + 1;
    }
    let ri = 0;
    while ri < 15 {
        let cur_r = ring_pts[ri];
        let nxt_r = ring_pts[(ri + 1) % 15];
        let diag_r = ring_pts[(ri + 4) % 15];
        e8_svg = e8_svg + "<line x1=\"" + str(cur_r[0]) + "\" y1=\"" + str(cur_r[1]) + "\" x2=\"" + str(nxt_r[0]) + "\" y2=\"" + str(nxt_r[1]) + "\" stroke=\"#38bdf8\" stroke-width=\"1.2\" stroke-opacity=\"0.78\"/>";
        e8_svg = e8_svg + "<line x1=\"" + str(cur_r[0]) + "\" y1=\"" + str(cur_r[1]) + "\" x2=\"" + str(cur_r[2]) + "\" y2=\"" + str(cur_r[3]) + "\" stroke=\"#c084fc\" stroke-width=\"1.1\" stroke-opacity=\"0.72\"/>";
        e8_svg = e8_svg + "<line x1=\"" + str(cur_r[2]) + "\" y1=\"" + str(cur_r[3]) + "\" x2=\"" + str(diag_r[2]) + "\" y2=\"" + str(diag_r[3]) + "\" stroke=\"#64ffda\" stroke-width=\"1.0\" stroke-opacity=\"0.62\"/>";
        e8_svg = e8_svg + "<circle cx=\"" + str(cur_r[0]) + "\" cy=\"" + str(cur_r[1]) + "\" r=\"2.6\" fill=\"#38bdf8\"/>";
        e8_svg = e8_svg + "<circle cx=\"" + str(cur_r[2]) + "\" cy=\"" + str(cur_r[3]) + "\" r=\"2.2\" fill=\"#f472b6\"/>";
        ri = ri + 1;
    }
    e8_svg = e8_svg + "</g>";
    e8_svg = e8_svg + "<circle cx=\"270\" cy=\"118\" r=\"28\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"1.8\"><animate attributeName=\"stroke-opacity\" values=\"1;0.4;1\" dur=\"3s\" repeatCount=\"indefinite\"/></circle>";
    e8_svg = e8_svg + "<polygon points=\"270,54 216,148 324,148\" fill=\"#1e293b\" fill-opacity=\"0.35\" stroke=\"#34d399\" stroke-width=\"1.8\"/>";
    e8_svg = e8_svg + "<line x1=\"270\" y1=\"54\" x2=\"270\" y2=\"148\" stroke=\"#60a5fa\" stroke-width=\"1.4\"/>";
    e8_svg = e8_svg + "<line x1=\"216\" y1=\"148\" x2=\"297\" y2=\"101\" stroke=\"#60a5fa\" stroke-width=\"1.4\"/>";
    e8_svg = e8_svg + "<line x1=\"324\" y1=\"148\" x2=\"243\" y2=\"101\" stroke=\"#60a5fa\" stroke-width=\"1.4\"/>";
    let fano_nodes = [[270,54,"e1"],[216,148,"e2"],[324,148,"e3"],[270,148,"e4"],[243,101,"e5"],[297,101,"e6"],[270,118,"e7"]];
    let fn_i = 0;
    for fn_pt in fano_nodes {
        let fn_col = if (fn_i == (st.session_ticks % 7)) { "#34d399" } else { "#fde047" };
        e8_svg = e8_svg + "<circle cx=\"" + str(fn_pt[0]) + "\" cy=\"" + str(fn_pt[1]) + "\" r=\"4.4\" fill=\"" + fn_col + "\" stroke=\"#0b1324\" stroke-width=\"1.2\"/>";
        e8_svg = e8_svg + "<text x=\"" + str(fn_pt[0] + 6) + "\" y=\"" + str(fn_pt[1] + 3) + "\" fill=\"#e2e8f0\" font-size=\"8\" font-family=\"monospace\">" + str(fn_pt[2]) + "</text>";
        fn_i = fn_i + 1;
    }
    e8_svg = e8_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\">Left: E8 Coxeter 240 Roots (248D) | Right: Octonion Fano G2</text></svg>";

    // 6. 24D Leech Lattice Lambda_24 (196,560) · Hopf Fibration S^3->S^2 · Monster Moonshine (196,884)
    let leech_svg = "<svg viewBox=\"0 0 360 210\" width=\"100%\" height=\"205\" role=\"img\" aria-label=\"24D Leech Lattice, Hopf Fibration, and Monster Moonshine\">" + common_defs;
    leech_svg = leech_svg + "<text x=\"12\" y=\"20\" fill=\"#f472b6\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">6. 24D LEECH (196,560) · HOPF S3-&gt;S2 · MOONSHINE</text>";
    leech_svg = leech_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" values=\"-10 92 112; 10 92 112; -10 92 112\" dur=\"7s\" repeatCount=\"indefinite\"/>";
    leech_svg = leech_svg + "<ellipse cx=\"80\" cy=\"112\" rx=\"37\" ry=\"21\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.4\" transform=\"rotate(-24 80 112)\"/>";
    leech_svg = leech_svg + "<ellipse cx=\"106\" cy=\"112\" rx=\"37\" ry=\"21\" fill=\"none\" stroke=\"#f472b6\" stroke-width=\"2.4\" transform=\"rotate(24 106 112)\"/>";
    leech_svg = leech_svg + "<ellipse cx=\"93\" cy=\"112\" rx=\"25\" ry=\"42\" fill=\"none\" stroke=\"#a78bfa\" stroke-width=\"1.8\" stroke-dasharray=\"4,3\"/>";
    leech_svg = leech_svg + "<circle cx=\"93\" cy=\"112\" r=\"3.5\" fill=\"#64ffda\"/></g>";
    leech_svg = leech_svg + "<g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"360 270 112\" to=\"0 270 112\" dur=\"18s\" repeatCount=\"indefinite\"/>";
    leech_svg = leech_svg + "<circle cx=\"270\" cy=\"112\" r=\"50\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"1.5\" stroke-dasharray=\"3,2\"/>";
    leech_svg = leech_svg + "<circle cx=\"270\" cy=\"112\" r=\"34\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"1.5\"/>";
    let li = 0;
    while li < 12 {
        let lang = (li * 6.2831853) / 12.0 + tick_phase * 0.4;
        let lx = num_floor(270.0 + 50.0 * Math.cos(lang));
        let ly = num_floor(112.0 + 50.0 * Math.sin(lang));
        let mx = num_floor(270.0 + 34.0 * Math.cos(lang + 0.26));
        let my = num_floor(112.0 + 34.0 * Math.sin(lang + 0.26));
        leech_svg = leech_svg + "<line x1=\"270\" y1=\"112\" x2=\"" + str(lx) + "\" y2=\"" + str(ly) + "\" stroke=\"#334155\" stroke-width=\"1\"/>";
        leech_svg = leech_svg + "<circle cx=\"" + str(lx) + "\" cy=\"" + str(ly) + "\" r=\"2.8\" fill=\"#34d399\"/>";
        leech_svg = leech_svg + "<circle cx=\"" + str(mx) + "\" cy=\"" + str(my) + "\" r=\"2.4\" fill=\"#fbbf24\"/>";
        li = li + 1;
    }
    leech_svg = leech_svg + "</g>";
    leech_svg = leech_svg + "<circle cx=\"270\" cy=\"112\" r=\"17\" fill=\"#0f172a\" stroke=\"#64ffda\" stroke-width=\"2\"/>";
    leech_svg = leech_svg + "<text x=\"256\" y=\"116\" fill=\"#64ffda\" font-size=\"9.5\" font-family=\"monospace\" font-weight=\"bold\">24D</text>";
    leech_svg = leech_svg + "<text x=\"12\" y=\"198\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\">Hopf Lk=1 | Leech Kissing=196,560 | Moonshine c1=196,884</text></svg>";

    let out_panels = map{
        ok: true,
        cache_key: cache_key,
        mobius_klein_svg: mobius_svg,
        tesseract_trefoil_svg: tess_svg,
        galaxy_lightcone_svg: gal_svg,
        organism_growth_svg: org_svg,
        e8_fano_svg: e8_svg,
        leech_hopf_moonshine_svg: leech_svg
    };
    _CACHED_TOPO_EPOCH = topo_epoch;
    _CACHED_TOPO_FIVE = out_panels;
    _CACHED_SVG_KEY = cache_key;
    _CACHED_SVG_PANELS = out_panels;
    return out_panels;
}

let _CACHED_OBS_CSS = ":root{color-scheme:dark;background:#060a12;color:#e2e8f0;font-family:Inter,system-ui,-apple-system,sans-serif}"
    + "*,*::before,*::after{box-sizing:border-box}"
    + "body{max-width:1440px;margin:0 auto;padding:clamp(14px,2.2vw,28px);background:radial-gradient(circle at 15% 0,#112240 0,transparent 38rem),radial-gradient(circle at 85% 10%,#1e1b4b 0,transparent 34rem),#060a12}"
    + ".topnav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;background:rgba(15,23,42,.92);border:1px solid #233554;border-radius:14px;padding:12px 18px;margin-bottom:16px;box-shadow:0 12px 32px rgba(0,0,0,.35)}"
    + ".topnav-links{display:flex;flex-wrap:wrap;gap:10px}"
    + ".navbtn{display:inline-flex;align-items:center;padding:7px 13px;border-radius:9px;border:1px solid #334155;background:#131f36;color:#e2e8f0;text-decoration:none;font-size:.83rem;font-weight:650}"
    + ".navbtn:hover{border-color:#64ffda;color:#64ffda}"
    + ".navbtn.active{border-color:#38bdf8;background:#0c2d48;color:#7dd3fc}"
    + "header{background:linear-gradient(135deg,rgba(15,23,42,.96),rgba(11,19,36,.96));border:1px solid #233554;border-radius:16px;padding:20px 24px;margin-bottom:18px;box-shadow:0 16px 40px rgba(0,0,0,.32)}"
    + "h1{margin:0 0 8px 0;font-size:clamp(1.25rem,2.4vw,1.65rem);color:#38bdf8;line-height:1.25}"
    + "h2{margin:0 0 10px 0;font-size:1.1rem;color:#64ffda}"
    + ".badge{display:inline-block;background:#111c33;color:#64ffda;border:1px solid #2d4a77;border-radius:999px;padding:4px 11px;font-size:.76rem;margin:3px 5px 3px 0;font-family:monospace;font-weight:600}"
    + ".badge.ctrl{color:#fde047;border-color:#854d0e;background:#261c0a}"
    + ".kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:12px;margin-bottom:18px}"
    + ".kpi{background:rgba(15,23,42,.94);border:1px solid #1e293b;border-radius:12px;padding:13px 15px;box-shadow:0 8px 20px rgba(0,0,0,.22)}"
    + ".kpi .label{font-size:.74rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em}"
    + ".kpi .val{font-size:1.12rem;font-weight:750;color:#f8fafc;font-family:monospace;margin-top:5px;overflow-wrap:anywhere}"
    + ".svg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px;margin-bottom:18px}"
    + ".card{background:rgba(15,23,42,.94);border:1px solid #1e293b;border-radius:14px;padding:16px 18px;margin-bottom:16px;box-shadow:0 10px 28px rgba(0,0,0,.25)}"
    + "table{width:100%;border-collapse:collapse;font-size:.84rem;font-family:monospace}"
    + "th,td{border-bottom:1px solid #1e293b;padding:8px 10px;text-align:left}"
    + "th{color:#38bdf8;background:#0b1120}";

fn observatory_stylesheet() {
    return _CACHED_OBS_CSS;
}

// ============================================================================
// 4. COMPLETE PURE-PBLANG HTML5 OBSERVATORY GENERATOR & ATOMIC PERSISTENCE
// ============================================================================
let _TOPO_EVAL_CACHE = map{};

fn render_living_organism_pure_pblang_html_dashboard(spec = nil) {
    let s = if type(spec) == "map" { spec } else { map{} };
    let st = if map_has(s, "organism_state") and type(s["organism_state"]) == "map" {
        _normalize_org_state(s["organism_state"])
    } else {
        read_living_organism_state_fast()
    };
    let ctl = read_control_state_fast();
    let topo = if map_has(_TOPO_EVAL_CACHE, "v35_topo") {
        _TOPO_EVAL_CACHE["v35_topo"]
    } else {
        let t = evaluate_klein_bottle_mobius_trefoil_and_nd_tesseract(s);
        _TOPO_EVAL_CACHE["v35_topo"] = t;
        t
    };
    let svgs = render_topology_and_organism_svg_panels(st);

    let hist_rows = "";
    for h in st.recent_history {
        hist_rows = hist_rows + "<tr><td>Tick #" + str(h.tick) + "</td><td>" + _escape_html(h.stage) + "</td><td>" + str(h.neurons) + "</td><td>" + str(h.synapses) + "</td><td>" + str(h.axons) + "</td><td>" + str(h.fitness) + "</td><td>" + _escape_html(_redact_text(h.stimulus)) + "</td></tr>";
    }

    let ctl_mode = if map_has(ctl, "mode") { str(ctl["mode"]) } else { "autonomous_running" };
    let ctl_focus = if map_has(ctl, "focus_domain") { str(ctl["focus_domain"]) } else { "all_108x864x10240_categories_e8_leech_moonshine" };
    let css_inline = observatory_stylesheet();

    let html = "<!doctype html>\n<html lang=\"el\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'\">\n<title>pbAI v38.0.0 — Ζωντανός Οργανισμός &amp; Τοπολογικό Παρατηρητήριο (E8 · Leech 24D · Moonshine · 100% PBLang)</title>\n<link rel=\"stylesheet\" href=\"/website/observatory.css\">\n<style>" + css_inline + "</style>\n</head>\n<body>\n"
        + "<nav class=\"topnav\" aria-label=\"Πλοήγηση pbAI\">\n"
        + "  <div><strong>pbAI v38.0.0 Observatory</strong> · <span class=\"badge ctrl\">Κατάσταση: " + _escape_html(ctl_mode) + "</span> <span class=\"badge\">Εστίαση: " + _escape_html(ctl_focus) + "</span></div>\n"
        + "  <div class=\"topnav-links\">\n"
        + "    <a class=\"navbtn active\" href=\"/observatory\">Ζωντανό Παρατηρητήριο</a>\n"
        + "    <a class=\"navbtn\" href=\"/observatory?refresh=15\">Αυτόματη Ανανέωση (15s)</a>\n"
        + "    <a class=\"navbtn\" href=\"/website/\">Κονσόλα Ελέγχου &amp; Επικοινωνίας (/website/)</a>\n"
        + "    <a class=\"navbtn\" href=\"/api/health\">API Health</a>\n"
        + "  </div>\n"
        + "</nav>\n"
