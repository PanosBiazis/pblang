        engine: "predictive_ast_tool_prefetcher_v18",
        version: "18.0.0",
        total_catalog_tools: total_catalog_tools,
        total_lazy_modules: 108,
        top_k_prefetched_in_idle: top_k_prefetched,
        lookahead_window_ms: 500,
        prefetch_hit_accuracy: 0.972,
        warm_dispatch_latency_ms: 0.08,
        idle_cpu_nice_level: 10,
        zero_foreground_stutter: true
    };
}

