// Exact, effect-free bridge from canonical PBLang proposal reviews to pbAI.
//
// A recognized digest is definition integrity, not authenticity. This module
// only creates an opaque quarantine token. It cannot call proposal admission,
// authenticate evidence, read content, train, build, create repositories, or
// perform any external effect.

let BOUNDED = import("stdlib:validate.sapp");

let FORMAT = "pbai.pblang-proposal-quarantine.v1";
let REVIEW_FORMAT = "pblang.project_survey.proposal_review.v1";
let KEYS = ["ok","format","proposal_id","decision","destination","rationale",
    "proposal_definition_sha256","proposal_definition_algorithm","definition_bound",
    "proposal_definition_authenticated","publisher_authenticated",
    "repository_creation_allowed","implementation_allowed",
    "independent_review_verified","requires_private_scope","exit_gates"];
let EXIT_GATES = ["independent lifecycle proven","stable public contract",
    "owned code and tests","privacy and license provenance",
    "explicit repository approval"];
let BOUNDS = map{max_depth:3,max_nodes:96,max_map_entries:24,max_array_items:8,
    max_string_chars:512,max_string_bytes:1024,max_total_string_bytes:4096,
    max_key_chars:64,max_key_bytes:64};

fn _base(reason) {
    return map{format:FORMAT,ok:false,disposition:"quarantine",reason:reason,
        quarantine_token:"",target_project_token:"",
        canonical_definition_recognized:false,pblang_review_authenticated:false,
        publisher_authenticated:false,replay_protection_verified:false,
        external_replay_ledger_required:true,ready_for_existing_admission:false,
        content_read:false,executes:false,persists:false,trains:false,builds:false,
        creates_repository:false,commits:false,publishes:false,
        authorizes_action:false,authorizes_ingest:false,authorizes_retrieval:false,
        authorizes_training:false,authorizes_execution:false,
        authorizes_build:false,authorizes_repository_creation:false,
        authorizes_git:false,authorizes_publication:false,safe_to_log:false};
}

fn _same_array(left,right) {
    if type(left)!="array" or len(left)!=len(right) { return false; }
    let i=0;
    while i<len(left) {
        if type(left[i])!="string" or left[i]!=right[i] { return false; }
        i=i+1;
    }
    return true;
}

fn _known(id) {
    if id=="forms-ir" {
        return map{binding:"7efe1bb99a4db98e267509cbdf9d172cd15c519e68eb25e00cb59704cce9612a",
            destination:"pblang+pbide",
            rationale:"Extend the existing typed Forms IR module."};
    }
    if id=="runtime-evidence" {
        return map{binding:"8046682b6fc50503d124f80ac36945ba04f04f1f72e8b68f5bf2f917489b2b5c",
            destination:"pblang",
            rationale:"Extend the existing runtime-evidence broker module."};
    }
    if id=="pbknowledge" {
        return map{binding:"0734af8da0fb2672b8d538dc2e3559479c2cfa15678ae0870e3dcdc275f3a8a1",
            destination:"pbai",
            rationale:"Start as a private pbAI provenance, corpus-admission and graph-memory module; defer a repository until independent lifecycle and ownership are demonstrated."};
    }
    if id=="pbdevice-lab" {
        return map{binding:"023f497c53cdf607635b16226ea5499d33fa186b370fb6000b72aefb1de5f52a",
            destination:"pblang+pbremote+pbspotit",
            rationale:"Start as a shared PBLang device-evidence contract with product adapters; defer a repository until the interface and cross-repository ownership are stable."};
    }
    return nil;
}

fn quarantine(review) {
    let out=_base("invalid-bounded-pblang-review");
    if not BOUNDED.exact_map_bounded(review,KEYS,BOUNDS).ok { return out; }
    for field in ["ok","definition_bound","proposal_definition_authenticated",
        "publisher_authenticated","repository_creation_allowed",
        "implementation_allowed","independent_review_verified",
        "requires_private_scope"] {
        if type(review[field])!="bool" { return out; }
    }
    if review.ok!=true or review.format!=REVIEW_FORMAT
       or review.decision!="recommended-existing-module-first"
       or review.proposal_definition_algorithm!="sha256-pblang-project-proposal-v1"
       or review.definition_bound!=true
       or review.proposal_definition_authenticated!=false
       or review.publisher_authenticated!=false
       or review.repository_creation_allowed!=false
       or review.implementation_allowed!=false
       or review.independent_review_verified!=false
       or review.requires_private_scope!=true
       or not _same_array(review.exit_gates,EXIT_GATES) { return out; }
    let known=_known(review.proposal_id);
    if known==nil or review.proposal_definition_sha256!=known.binding
       or review.destination!=known.destination or review.rationale!=known.rationale {
        return out;
    }
    out.ok=true;
    out.reason="canonical-definition-bound-not-authenticated";
    out.canonical_definition_recognized=true;
    out.quarantine_token="proposal-quarantine-"+str_slice(sha256(
        "pbai-pblang-proposal-quarantine-v1\x00"+known.binding+"\x00"+review.proposal_id),0,32);
    out.target_project_token="project-"+str_slice(sha256(
        "pbai-pblang-proposal-target-v1\x00"+known.destination),0,24);
    return out;
}

fn status() {
    let out=_base("status");
    out.ok=true; out.implementation_language="pblang";
    out.pure_metadata_only=true; out.exact_bounded_schema=true;
    out.fixed_cross_repository_bindings=4;
    out.review_authentication_available=false;
    out.proposal_admission_called=false;
    return out;
}

export FORMAT, REVIEW_FORMAT, quarantine, status;
