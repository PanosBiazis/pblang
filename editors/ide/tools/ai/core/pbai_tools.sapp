// stdlib/pbai_tools.sapp -- audited local tool/data substrate for pbAI.
//
// This is not an executor. It is pbAI's native capability map: the concrete local
// pblang stdlib, pblang compiler/IDE, pb-mcp-server, and AAP dataset sources that
// can become real pbAI tools behind explicit capability gates.

fn _cap(name, source, status, items, use_for) {
    return map{
        name: name,
        source: source,
        status: status,
        items: items,
        use_for: use_for
    };
}

fn catalog() {
    return [
        _cap("pblang data readers", "products/pblang/stdlib", "native pblang modules",
            ["json.sapp", "csv.sapp", "dataframe.sapp", "serialization.sapp", "encoding.sapp", "regex.sapp"],
            "understand structured text, tables, records, and serialized data"),
        _cap("pblang neural/math substrate", "products/pblang/stdlib", "native pblang modules",
            ["nn.sapp", "ml.sapp", "machine_learning.sapp", "tensor.sapp", "matrix.sapp", "vector.sapp", "stat.sapp"],
            "portable model layers, features, training loops, tensors, scoring, and evaluation"),
        _cap("pblang code intelligence", "products/pblang/stdlib/compiler + src/cli", "native/compiler-backed",
            ["compiler/tokenizer.sapp", "compiler/parser.sapp", "compiler/typeck.sapp", "compiler/optimizer.sapp", "cli/dataflow.rs", "cli/call_graph.rs"],
            "parse pblang, inspect symbols, reason about dataflow, optimize, lint, and explain code"),
        _cap("pblang runtime/server tools", "products/pblang/stdlib", "native pblang modules",
            ["http.sapp", "http_server.sapp", "web_framework.sapp", "pb_mcp.sapp", "fs.sapp", "process.sapp", "thread_pool.sapp", "async.sapp"],
            "serve pbAI locally, read workspace files, call safe tools, and coordinate concurrent work"),
        _cap("pblang multimodal hooks", "products/pblang/stdlib", "native modules plus roadmap backends",
            ["image_processing.sapp", "graphics.sapp", "audio hooks via pb-mcp-server", "ocr hooks via pb-mcp-server"],
            "route images, screenshots, OCR, audio, and visual data into normalized evidence"),
        _cap("pb-mcp-server core", "products/pb-mcp-server", "companion MCP server",
            ["workspace_context", "read_file", "grep_code", "code_index_build", "code_index_search", "git_diff", "terminal_run"],
            "observe, search, edit, run, and verify real projects under security profiles"),
        _cap("pb-mcp-server agents", "products/pb-mcp-server/src", "companion MCP server",
            ["agent_send", "ask_agents", "agent_fan_out", "consensus_propose", "consensus_vote", "agent_handoff"],
            "sub-agent coordination, consensus, handoffs, and long-running work distribution"),
        _cap("pb-mcp-server AI/data/media", "products/pb-mcp-server/src", "companion MCP server",
            ["ai_structured_extract", "ai_semantic_search", "neural_inference", "ocr_tesseract", "screenshot_capture", "chart_timeseries", "log_error_cluster"],
            "advanced extraction, embeddings, OCR, charts, logs, neural inference, and media analysis"),
        _cap("AAP corpora", "library/datasets/data", "local training/reference data",
            ["tinystories", "books", "pg19", "bookcorpus_clean", "combined_books_text", "glove embeddings", "tokenizer.json", "datasets/models/ai_model.joblib"],
            "curriculum learning, tokenizer training, retrieval, embeddings, classical ML baselines, and language-model benchmarks"),
        _cap("AAP domain corpus", "AAP domain folders", "reference and evaluation data",
            ["training/* language examples", "cyber-security/*", "data-science/*", "robotics/*", "quantum/*", "web/job-tracker docs", "system-tools/*"],
            "teach pbAI code patterns, domain vocabulary, tool use, tests, and cross-language reasoning"),
        _cap("AAP AI references", "projects/ai/", "reference only, not pbAI core",
            ["projects/ai/max tokenizer/config", "projects/ai/max artifacts", "Delphi/C# AIChatService", "UniversalFileParserUnit", "FinancialRAG", "aipy scripts", "Sp_AIModel", "takisbot"],
            "mine parser, chat history, RAG, file ingestion, provider, tokenizer/training, and visualizer ideas without replacing pbAI"),
        _cap("AAP business/reporting systems", "projects/ai/WEB + projects/web", "reference/evaluation corpus",
            ["projects/ai/WEB/FinSystem", "projects/ai/WEB/Sales", "EnterpriseOrg reporting abstractions", "Enterprise.FinanMigrator", "financial Delphi systems", "web application docs"],
            "teach pbAI real application architecture, reporting, financial data models, migrations, search, auth, and legacy modernization"),
        _cap("nearby project references", "../projects", "reference only, outside AAP",
            ["Sp_AIModel", "aipy", "max", "chatbot", "TesterStudio", "WordDetect", "progrCS/RealAIVisualizer", "Laravel/Django/Blazor examples", "games/SFML/OpenGL/Pong"],
            "mine examples, visualizer ideas, app patterns, and evaluation prompts without making them pbAI core"),
        _cap("secret-sensitive exclusions", "all roots", "never blindly ingest",
            ["credentials.json", "credentialsgd.json", "appsettings*.json", "openrouter.txt", "id_ed25519*", ".ssh", ".config", ".env", "*password*", "*secret*", "*token*"],
            "protect secrets and accounts while still learning public code, docs, schemas, and safe examples"),
        _cap("local source discovery", "operator-authorized root descriptors", "metadata catalog only",
            ["tools/pbai_feed.sapp catalog", "tools/pbai_feed.sapp catalog_observations roots.json observations.json", "broad drive walker disabled"],
            "classify bounded relative metadata into opaque per-scan leads without exposing locators, reading candidate content, or authorizing training")
    ];
}

fn short_summary() {
    return "pbAI tool substrate: pblang stdlib readers/neural/compiler/server modules, pb_mcp bridge, pb-mcp-server 500+ tool families, agent bus/consensus, OCR/media/data/neural ops, and AAP datasets for learning.";
}

fn answer() {
    return "pbAI tools/data I found locally:\n"
        + "- pblang stdlib: JSON/CSV/dataframe, nn/ml/tensor/matrix/stat, compiler tokenizer/parser/typeck/optimizer, HTTP/server/fs/process/async, image/graphics hooks.\n"
        + "- pb_mcp bridge: native safe core tools such as workspace_context/read_file/list_files/project_tree/grep_code.\n"
        + "- pb-mcp-server: code_index/search, git, terminal/test runners, reasoning, multi-agent bus, consensus, OCR, screenshots, charts/logs, neural inference, embeddings, web/data/media tools.\n"
        + "- AAP datasets: TinyStories/books/PG19/bookcorpus/combined_books_text/GloVe/tokenizer assets for curriculum, retrieval, and benchmarks.\n"
        + "- AAP domain folders: training language examples, cyber-security, data-science, robotics, quantum, web docs, and system-tools for domain learning and evaluation.\n"
        + "- AAP AI references: Delphi/C# chat services, UniversalFileParser, FinancialRAG, aipy scripts, max tokenizer/artifacts, Sp_AIModel, and takisbot for design lessons only.\n"
        + "- AAP business/reporting systems: FinSystem, Sales, EnterpriseOrg reporting/migration, and Delphi financial systems for real application architecture.\n"
        + "- nearby projects outside AAP: Sp_AIModel/aipy/max/chatbot/visualizer/web/game projects are reference-only sources for examples and tests.\n"
        + "- exclusions: credentials, tokens, appsettings, ssh keys, password/secret files, caches, and build outputs should not be blindly learned.\n"
        + "- local drives/devices: broad walking remains disabled; `catalog_observations` accepts bounded descriptor-backed metadata and returns opaque per-scan leads only.\n"
        + "Next real step: port the highest-value MCP tools into pblang wrappers, then let pbAI plan -> call tool -> observe -> verify -> learn.";
}

fn names() {
    let out = [];
    for c in catalog() { push(out, c.name); }
    return out;
}

export catalog, short_summary, answer, names;
