// pbai_isolation.sapp -- honest pbAI view of bounded process/isolation evidence.
//
// The fixed self-test executes no caller code.  It verifies the currently
// available PBLang Linux worker controls while preserving the upstream
// distinction between a trusted bounded worker and a production hostile-code
// sandbox.

let PROCESS = import("stdlib:process.sapp");
let ISOLATE = import("stdlib:polyglot_isolate.sapp");
let PREEMPTION_TIMEOUT_SECS = 1;
let PREEMPTION_KILL_GRACE_MS = 1000;

fn _forced_preemption_probe() {
    if platform() != "linux" or not PROCESS.bounded_status().available {
        return map{ ok: false, timeout_observed: false,
            process_group_terminated: false, term_resistant_fixture: true };
    }
    // This is fixed trusted probe code, never caller input.  It ignores TERM so
    // the bounded backend must advance to its hard-kill and group-absence path.
    let result = PROCESS.run_fixed_bounded(["/usr/bin/dash", "/bin/dash"],
        ["-c", "trap '' TERM; while :; do /usr/bin/sleep 1; done"], map{
            timeout_secs: PREEMPTION_TIMEOUT_SECS, startup_timeout_ms: 2000,
            max_output_bytes: 4096, max_file_bytes: 4096,
            max_memory_bytes: 67108864,
            max_open_files: 32, max_processes: 2048,
            inherit_environment: false,
            environment: map{ PATH: "/usr/bin:/bin", HOME: "/nonexistent",
                TMPDIR: "/tmp", LANG: "C.UTF-8", LC_ALL: "C.UTF-8" }
        });
    let timed_out = try result.timed_out catch false;
    let terminated = try result.process_group_terminated catch false;
    let elapsed = try result.elapsed_ms catch 0;
    // GNU timeout returns 137, not 124, when --kill-after must follow an
    // ignored TERM.  The low-CPU fixture and non-explicit CPU backstop keep
    // that terminal state attributable to the wall deadline plus kill grace.
    let kill_after_deadline = (try result.exit_code catch -1) == 137
        and not (try result.cpu_limit_explicit catch true)
        and elapsed >= PREEMPTION_TIMEOUT_SECS * 1000
            + PREEMPTION_KILL_GRACE_MS - 250;
    let preempted = (timed_out or kill_after_deadline) and terminated;
    return map{ ok: (try result.bounded catch false) and preempted,
        timeout_observed: preempted,
        backend_timeout_exit_observed: timed_out,
        kill_after_deadline_observed: kill_after_deadline,
        process_group_terminated: terminated,
        term_resistant_fixture: true,
        bounded_backend: try result.bounded catch false,
        raw_output_returned: false };
}

fn status() {
    let process = PROCESS.bounded_status();
    let isolate = ISOLATE.status();
    return map{
        format: "pbai.isolation.status.v1", ok: true,
        platform: platform(),
        trusted_worker_timeout_available: try process.available catch false,
        bounded_process_backend: process,
        namespace_worker_available: try isolate.available catch false,
        namespace_configuration_requested: try isolate.network_namespace_configured catch false,
        read_only_runtime_configured: try isolate.runtime_root_read_only_configured catch false,
        host_workspace_mount_configured: try isolate.host_workspace_mount_configured catch true,
        capabilities_drop_configured: try isolate.capabilities_drop_configured catch false,
        no_new_privileges_configured: try isolate.no_new_privileges_configured catch false,
        forced_preemption_probe_available: platform() == "linux"
            and (try process.available catch false),
        seccomp_filtered: try isolate.seccomp_filtered catch false,
        cgroup_enforced: try isolate.cgroup_enforced catch false,
        runtime_identity_verified: try isolate.runtime_identity_verified catch false,
        full_sandbox_verified: false,
        production_untrusted_ready: false,
        arbitrary_caller_code_enabled: false
    };
}

fn selftest() {
    if not (try PROCESS.bounded_status().available catch false)
        or not (try ISOLATE.status().available catch false) {
        return map{ format: "pbai.isolation.selftest.v1", ok: false,
            completed: false, disposition: "unavailable",
            trusted_worker_timeout_enforced: false,
            full_sandbox_verified: false, production_untrusted_ready: false,
            arbitrary_caller_code_enabled: false };
    }
    let evidence = ISOLATE.isolation_selftest();
    let preemption = _forced_preemption_probe();
    let namespace_passed = try evidence.ok catch false;
    let passed = namespace_passed and preemption.ok;
    return map{
        format: "pbai.isolation.selftest.v1", ok: passed,
        completed: try evidence.selftest_complete catch false,
        disposition: if passed { "bounded-namespace-worker-evidence" }
            else { "quarantine" },
        trusted_worker_timeout_enforced:
            try evidence.detail.process_group_terminated catch false,
        trusted_worker_normal_completion_cleanup_verified:
            try evidence.detail.process_group_terminated catch false,
        trusted_worker_forced_preemption_verified: preemption.ok,
        forced_timeout_observed: preemption.timeout_observed,
        forced_timeout_backend_124_observed:
            try preemption.backend_timeout_exit_observed catch false,
        forced_timeout_kill_after_deadline_observed:
            try preemption.kill_after_deadline_observed catch false,
        forced_timeout_process_group_terminated: preemption.process_group_terminated,
        forced_timeout_term_resistant_fixture: preemption.term_resistant_fixture,
        private_uid_gid_observed: try evidence.private_uid_gid_observed catch false,
        private_tmp_observed: try evidence.tmp_path_write_observed catch false,
        host_paths_absent_observed: try evidence.home_and_media_paths_absent_observed catch false,
        selected_host_fds_absent_observed:
            try evidence.selected_host_path_descriptors_absent_observed catch false,
        unprivileged_usr_write_denied_observed:
            try evidence.usr_write_denied_as_nobody_observed catch false,
        read_only_runtime_observed: false,
        read_only_runtime_verified: false,
        loopback_only_observed: try evidence.network_only_loopback_observed catch false,
        environment_allowlist_observed: try evidence.environment_allowlist_exact_observed catch false,
        empty_capabilities_observed: try evidence.capability_sets_empty_observed catch false,
        no_new_privileges_observed: try evidence.no_new_privileges_observed catch false,
        source_absent_from_runtime_argv_observed:
            try evidence.source_absent_from_runtime_argv_observed catch false,
        seccomp_filtered: false, cgroup_enforced: false,
        runtime_identity_verified: false,
        full_sandbox_verified: false, production_untrusted_ready: false,
        arbitrary_caller_code_enabled: false,
        raw_probe_output_returned: false
    };
}

export status, selftest;
