// pbai_ecosystem.sapp -- bounded role-registry and message-envelope contracts.
//
// Registration is metadata only. It never loads, activates, trains, unloads, or
// executes a model. Dynamic roles remain disabled until future verified adapters
// provide lifecycle and isolation enforcement.

let RULER = (try import("pbai_ruler.sapp") catch import("editors/ide/tools/ai/core/pbai_ruler.sapp"));

let REGISTRY_FORMAT = "pbai.role.registry.v1";
let ROLE_FORMAT = "pbai.role.descriptor.v1";
let ENVELOPE_FORMAT = "pbai.role.envelope.v1";
let MAX_ROLES = 64;
let MAX_ID_CHARS = 64;
let MAX_MESSAGE_CHARS = 262144;

fn _in(items, value) {
    if type(items) != "array" { return false; }
    let i = 0;
    while i < len(items) { if items[i] == value { return true; } i = i + 1; }
    return false;
}

fn _token(value) {
    let text = str(value);
    if text == "" or len(text) > MAX_ID_CHARS { return false; }
    let i = 0;
    while i < len(text) {
        let c = strcharcodeat(text, i);
        let ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90)
            or (c >= 97 and c <= 122) or c == 45 or c == 95 or c == 58;
        if not ok { return false; }
        i = i + 1;
    }
    return true;
}

fn _role(id, category, status, module, protected_role, message_enabled) {
    return map{
        format: ROLE_FORMAT,
        id: id,
        category: category,
        implementation_status: status,
        module: module,
        input_format: "pbai.role.envelope.v1",
        output_format: "pbai.role.envelope.v1",
        requested_capabilities: ["ai:infer"],
        protected: protected_role,
        dynamically_registered: false,
        message_enabled: message_enabled,
        model_artifact_verified: false,
        sandbox_required: false,
        sandbox_enforced: false
    };
}

fn base_registry() {
    return map{
        format: REGISTRY_FORMAT,
        ok: true,
        revision: 1,
        max_roles: MAX_ROLES,
        roles: [
            _role("orchestrator", "coordination", "implemented-policy", "stdlib/pbai_coordinator.sapp", true, true),
            _role("planner", "coordination", "implemented-policy", "stdlib/pbai_planner.sapp", false, true),
            _role("producer", "generation", "implemented-foundation", "stdlib/pbai.sapp", false, true),
            _role("verifier", "verification", "implemented-policy", "stdlib/pbai_verifier.sapp", true, true),
            _role("searcher", "retrieval", "implemented-foundation", "stdlib/pbai_grounding.sapp", false, true),
            _role("identifier", "classification", "implemented-foundation", "stdlib/pbai.sapp", false, true),
            _role("memory-curator", "memory", "partial", "stdlib/pbai_dataset_policy.sapp", false, false),
            _role("trainer", "learning", "partial", "stdlib/pbai_lm.sapp", false, false),
            _role("error-corrector", "correction", "roadmap", "", false, false),
            _role("translator", "translation", "roadmap", "", false, false),
            _role("sandbox-executor", "execution", "roadmap", "", false, false),
            _role("tool-broker", "tools", "partial", "stdlib/pb_mcp.sapp", false, false),
            _role("pbruler", "policy", "implemented-evaluator", "stdlib/pbai_ruler.sapp", true, true)
        ],
        metadata_only: true,
        activates_models: false,
        unloads_models: false,
        authorizes_actions: false
    };
}

fn _copy_registry(registry) {
    let roles_copy = [];
    let i = 0;
    while i < len(registry.roles) { push(roles_copy, registry.roles[i]); i = i + 1; }
    return map{
        format: REGISTRY_FORMAT,
        ok: true,
        revision: try registry.revision catch 0,
        max_roles: MAX_ROLES,
        roles: roles_copy,
        metadata_only: true,
        activates_models: false,
        unloads_models: false,
        authorizes_actions: false
    };
}

fn _find(registry, id) {
    if type(registry) != "map" or type(try registry.roles catch nil) != "array" { return -1; }
    let i = 0;
    while i < len(registry.roles) {
        let current_id = try registry.roles[i].id catch "";
        if current_id == id { return i; }
        i = i + 1;
    }
    return -1;
}

fn _valid_caps(items) {
    if type(items) != "array" or len(items) > 16 { return false; }
    let i = 0;
    while i < len(items) {
        if type(items[i]) != "string" or not _in(RULER.capabilities(), items[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn register_role(registry, descriptor) {
    if type(registry) != "map" or (try registry.format catch "") != REGISTRY_FORMAT
        or type(try registry.roles catch nil) != "array" {
        return map{ format: "pbai.role.change.v1", ok: false, error: "invalid-registry", registry: registry };
    }
    if len(registry.roles) >= MAX_ROLES {
        return map{ format: "pbai.role.change.v1", ok: false, error: "registry-full", registry: registry };
    }
    if type(descriptor) != "map" or (try descriptor.format catch "") != ROLE_FORMAT {
        return map{ format: "pbai.role.change.v1", ok: false, error: "invalid-role-descriptor", registry: registry };
    }
    let id = try str(descriptor.id) catch "";
    let category = try str(descriptor.category) catch "";
    if not _token(id) or not _token(category) or _find(registry, id) >= 0 {
        return map{ format: "pbai.role.change.v1", ok: false, error: "invalid-or-duplicate-role", registry: registry };
    }
    if try descriptor.protected catch false {
        return map{ format: "pbai.role.change.v1", ok: false, error: "dynamic-role-cannot-be-protected", registry: registry };
    }
    if not _valid_caps(try descriptor.requested_capabilities catch []) {
        return map{ format: "pbai.role.change.v1", ok: false, error: "invalid-capabilities", registry: registry };
    }
    let updated = _copy_registry(registry);
    push(updated.roles, map{
        format: ROLE_FORMAT,
        id: id,
        category: category,
        implementation_status: "registered-disabled",
        module: "",
        input_format: "pbai.role.envelope.v1",
        output_format: "pbai.role.envelope.v1",
        requested_capabilities: try descriptor.requested_capabilities catch [],
        protected: false,
        dynamically_registered: true,
        message_enabled: false,
        model_artifact_verified: false,
        sandbox_required: try descriptor.sandbox_required catch true,
        sandbox_enforced: false
    });
    updated.revision = updated.revision + 1;
    return map{
        format: "pbai.role.change.v1", ok: true, action: "registered-disabled",
        role_id: id, registry: updated, activates_model: false, authorizes_action: false
    };
}

fn remove_role(registry, id) {
    let index = _find(registry, str(id));
    if index < 0 {
        return map{ format: "pbai.role.change.v1", ok: false, error: "role-not-found", registry: registry };
    }
    if try registry.roles[index].protected catch true {
        return map{ format: "pbai.role.change.v1", ok: false, error: "protected-role", registry: registry };
    }
    let updated = _copy_registry(registry);
    let kept = [];
    let i = 0;
    while i < len(updated.roles) { if i != index { push(kept, updated.roles[i]); } i = i + 1; }
    updated.roles = kept;
    updated.revision = updated.revision + 1;
    return map{
        format: "pbai.role.change.v1", ok: true, action: "removed-metadata",
        role_id: str(id), registry: updated, unloaded_model: false, authorizes_action: false
    };
}

fn envelope(registry, value) {
    if type(value) != "map" {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "malformed-envelope", authorizes_action: false };
    }
    let sender = try str(value.sender) catch "";
    let recipient = try str(value.recipient) catch "";
    let sender_index = _find(registry, sender);
    let recipient_index = _find(registry, recipient);
    if sender_index < 0 or recipient_index < 0 {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "unknown-role", authorizes_action: false };
    }
    if not (try registry.roles[sender_index].message_enabled catch false)
        or not (try registry.roles[recipient_index].message_enabled catch false) {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "role-not-active-for-messages", authorizes_action: false };
    }
    if not _token(try value.task_id catch "") or not _token(try value.kind catch "") {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "invalid-message-identity", authorizes_action: false };
    }
    let chars = try value.payload_chars catch nil;
    let digest = try str(value.payload_digest) catch "";
    if type(chars) != "number" or chars < 0 or chars > MAX_MESSAGE_CHARS or len(digest) != 64 {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "invalid-message-payload-metadata", authorizes_action: false };
    }
    if not _valid_caps(try value.requested_capabilities catch []) {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "invalid-capabilities", authorizes_action: false };
    }
    let budgets = try value.budgets catch nil;
    if type(budgets) != "map" or type(try budgets.tokens catch nil) != "number"
        or type(try budgets.time_ms catch nil) != "number" or budgets.tokens < 0
        or budgets.tokens > 65536 or budgets.time_ms < 0 or budgets.time_ms > 60000 {
        return map{ format: ENVELOPE_FORMAT, ok: false, error: "invalid-message-budget", authorizes_action: false };
    }
    return map{
        format: ENVELOPE_FORMAT,
        ok: true,
        task_id: value.task_id,
        sender: sender,
        recipient: recipient,
        kind: value.kind,
        payload_chars: chars,
        payload_digest: digest,
        requested_capabilities: try value.requested_capabilities catch [],
        budgets: budgets,
        requires_ruler_check: true,
        authorizes_action: false,
        contains_raw_payload: false
    };
}

fn status() {
    let registry = base_registry();
    return map{
        format: "pbai.ecosystem.status.v1",
        ok: true,
        registry_format: REGISTRY_FORMAT,
        role_format: ROLE_FORMAT,
        envelope_format: ENVELOPE_FORMAT,
        base_roles: len(registry.roles),
        dynamic_metadata_registration: true,
        dynamic_model_activation: false,
        dynamic_model_unloading: false,
        inter_model_transport: false,
        message_contract: true,
        envelopes_authorize_actions: false,
        pbruler_check_required: true,
        sandbox_enforced: false
    };
}

export REGISTRY_FORMAT, ROLE_FORMAT, ENVELOPE_FORMAT, MAX_ROLES, MAX_MESSAGE_CHARS;
export base_registry, register_role, remove_role, envelope, status;
