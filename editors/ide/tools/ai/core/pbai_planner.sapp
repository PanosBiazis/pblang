// stdlib/pbai_planner.sapp — bounded typed planner for serial pbAI execution.
//
// The planner is pure policy: it does not load models, call tools, access files,
// or persist memory. It turns a dispatch decision into a short auditable plan.

let MAX_GOAL_CHARS = 65536;
let MAX_STEPS = 8;

fn _opt(options, key, fallback) {
    if options == nil { return fallback; }
    return try options[key] catch fallback;
}

fn _push_unique(items, value) {
    let i = 0;
    while i < len(items) { if items[i] == value { return nil; } i = i + 1; }
    push(items, value);
    return nil;
}

fn _bounded_steps(steps, limit) {
    let out = [];
    let i = 0;
    while i < len(steps) and i < limit { push(out, steps[i]); i = i + 1; }
    return out;
}

fn plan(goal, routing, options = nil) {
    let text = str(goal);
    if len(text) > MAX_GOAL_CHARS {
        return map{
            format: "pbai.expert.plan.v1", ok: false,
            error: "goal exceeds planner character limit", steps: [],
            parallel: false, max_active_experts: 0
        };
    }
    if not is_map(routing) or not (try routing.admitted catch false) {
        return map{
            format: "pbai.expert.plan.v1", ok: false,
            error: "routing decision is missing or not admitted", steps: [],
            parallel: false, max_active_experts: 0
        };
    }

    let limit = _opt(options, "max_plan_steps", 6);
    if limit < 2 { limit = 2; }
    if limit > MAX_STEPS { limit = MAX_STEPS; }
    let task = try routing.task catch "grounded";
    let lane = try routing.selected_lane catch "embedded";
    let steps = [];
    _push_unique(steps, "validate bounded input and preserve the caller capability set");
    _push_unique(steps, "run only the selected '" + lane + "' producer lane");
    if task == "retrieval" { _push_unique(steps, "retrieve only provenance-linked local evidence"); }
    if task == "generation" { _push_unique(steps, "parse-check generated PBLang before display or execution"); }
    if task == "security" { _push_unique(steps, "treat the candidate as advisory and retain independent review"); }
    if task == "tool" { _push_unique(steps, "require a named tool and separately scoped arguments"); }
    if task == "learning" { _push_unique(steps, "require explicit approval before persistent learning"); }
    if try routing.requires_independent_verifier catch false {
        _push_unique(steps, "run the independent verifier after the producer completes");
    }
    _push_unique(steps, "return routing, verification, and authority metadata");

    let bounded = _bounded_steps(steps, limit);
    return map{
        format: "pbai.expert.plan.v1", ok: true,
        task: task, lane: lane, goal_chars: len(text),
        steps: bounded, step_count: len(bounded), max_steps: limit,
        truncated: len(steps) > len(bounded),
        required_capabilities: try routing.required_capabilities catch ["ai:infer"],
        verification_required: try routing.requires_independent_verifier catch false,
        advisory_only: try routing.advisory_only catch false,
        parallel: false, max_active_experts: 1,
        producer_hidden_state_shared_with_verifier: false
    };
}

export plan, MAX_GOAL_CHARS, MAX_STEPS;
