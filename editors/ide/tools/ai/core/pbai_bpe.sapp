// stdlib/pbai_bpe.sapp -- pbAI's byte-pair-encoding (BPE) subword tokenizer.
//
// A versioned, fully pblang-native BPE tokenizer that keeps the same public contract as
// the char tokenizer (train -> encode -> decode -> metadata), so it is a drop-in upgrade
// of `pbai.tokenizer.char.v1`. BPE starts from characters and repeatedly merges the most
// frequent adjacent token pair, learning subword units. The payoff: far shorter token
// sequences on repetitive text/code (so a fixed-context model sees more), and a vocab
// that captures common substrings like `fn `, `return`, `()`, `; }`.
//
//   let bpe = (try import("pbai_bpe.sapp") catch import("editors/ide/tools/ai/core/pbai_bpe.sapp"));
//   let tok = bpe.train(corpus, 200);            // learn up to 200 merges
//   let ids = bpe.encode(tok, "fn main()", true, true);
//   print bpe.decode(tok, ids);                  // "fn main()"
//
// Deterministic: ties for "most frequent pair" are broken by earliest occurrence in the
// sequence, so training the same corpus always yields the same merges.

let FORMAT = "pbai.tokenizer.bpe.v1";
let KIND = "byte-pair-encoding";
let DEFAULT_SPECIALS = ["<pad>", "<bos>", "<eos>", "<unk>"];
let SEP = strfromcharcode(1);            // pair-key separator (control char absent in text)

let DEFAULT_CORPUS =
    "fn main() { print \"hello\"; }\n"
    + "fn add(a, b) { return a + b; }\n"
    + "let m = map{ ok: true, value: 42 };\n"
    + "if map_has(m, \"value\") { print m[\"value\"]; }\n"
    + "while false { break; }\n"
    + "for i 10 { print i; }\n"
    + "fn fact(n) { if n <= 1 { return 1; } return n * fact(n - 1); }\n";

fn _copy_array(a) {
    let out = [];
    let i = 0;
    while i < len(a) { push(out, a[i]); i = i + 1; }
    return out;
}

fn _chars(text) {
    let seq = [];
    let i = 0;
    while i < len(text) {
        push(seq, strfromcharcode(strcharcodeat(text, i)));
        i = i + 1;
    }
    return seq;
}

fn _add_token(state, token, kind) {
    if map_has(state.token_to_id, token) { return state.token_to_id[token]; }
    let id = len(state.id_to_token);
    state.token_to_id[token] = id;
    push(state.id_to_token, token);
    state.token_kind[token] = kind;
    return id;
}

// Replace every adjacent (a, b) in seq with the merged token a+b.
fn _apply_merge(seq, a, b) {
    let merged = a + b;
    let out = [];
    let i = 0;
    let n = len(seq);
    while i < n {
        if i < n - 1 and seq[i] == a and seq[i + 1] == b {
            push(out, merged);
            i = i + 2;
        } else {
            push(out, seq[i]);
            i = i + 1;
        }
    }
    return out;
}

// Find the most frequent adjacent pair; ties broken by earliest occurrence (deterministic).
// Returns map{ found, a, b, count }.
fn _best_pair(seq) {
    let counts = map{};
    let i = 0;
    let n = len(seq);
    while i < n - 1 {
        let key = seq[i] + SEP + seq[i + 1];
        if map_has(counts, key) { counts[key] = counts[key] + 1; }
        else { counts[key] = 1; }
        i = i + 1;
    }
    let maxc = 0;
    let keys = map_keys(counts);
    let k = 0;
    while k < len(keys) {
        if counts[keys[k]] > maxc { maxc = counts[keys[k]]; }
        k = k + 1;
    }
    if maxc < 2 { return map{ found: false, a: "", b: "", count: 0 }; }
    // earliest pair achieving maxc
    let j = 0;
    while j < n - 1 {
        let key = seq[j] + SEP + seq[j + 1];
        if counts[key] == maxc {
            return map{ found: true, a: seq[j], b: seq[j + 1], count: maxc };
        }
        j = j + 1;
    }
    return map{ found: false, a: "", b: "", count: 0 };
}

fn train(corpus, num_merges = 200, max_vocab = 0) {
    let state = map{ token_to_id: map{}, id_to_token: [], token_kind: map{} };
    let i = 0;
    while i < len(DEFAULT_SPECIALS) {
        _add_token(state, DEFAULT_SPECIALS[i], "special");
        i = i + 1;
    }
    // base character vocabulary
    let seq = _chars(corpus);
    let c = 0;
    while c < len(seq) { _add_token(state, seq[c], "char"); c = c + 1; }

    let merges = [];
    let step = 0;
    let max_iters = num_merges;
    if len(seq) < max_iters { max_iters = len(seq); }
    while step < max_iters {
        if max_vocab > 0 and len(state.id_to_token) >= max_vocab { break; }
        let best = _best_pair(seq);
        if not best.found { break; }
        push(merges, [best.a, best.b]);
        _add_token(state, best.a + best.b, "merge");
        seq = _apply_merge(seq, best.a, best.b);
        step = step + 1;
    }

    return map{
        format: FORMAT,
        kind: KIND,
        source: "pblang-native byte-pair-encoding tokenizer",
        token_to_id: state.token_to_id,
        id_to_token: state.id_to_token,
        token_kind: state.token_kind,
        merges: merges,
        special: map{
            pad: state.token_to_id["<pad>"],
            bos: state.token_to_id["<bos>"],
            eos: state.token_to_id["<eos>"],
            unk: state.token_to_id["<unk>"]
        },
        vocab_size: len(state.id_to_token),
        num_merges: len(merges),
        max_vocab: max_vocab
    };
}

fn train_default(num_merges = 200, max_vocab = 0) {
    return train(DEFAULT_CORPUS, num_merges, max_vocab);
}

// Greedy encode: start from characters, apply the learned merges in order, then map
// each resulting token to its id (unknown tokens -> <unk>).
fn encode(tok, text, add_bos = false, add_eos = false) {
    let seq = _chars(text);
    let i = 0;
    while i < len(tok.merges) {
        let pair = tok.merges[i];
        seq = _apply_merge(seq, pair[0], pair[1]);
        i = i + 1;
    }
    let ids = [];
    if add_bos { push(ids, tok.special.bos); }
    let s = 0;
    while s < len(seq) {
        if map_has(tok.token_to_id, seq[s]) { push(ids, tok.token_to_id[seq[s]]); }
        else { push(ids, tok.special.unk); }
        s = s + 1;
    }
    if add_eos { push(ids, tok.special.eos); }
    return ids;
}

// Encoding independent documents is safe to parallelize because encode() reads the
// immutable tokenizer and returns a fresh id array. Small batches remain sequential so
// worker startup never dominates the useful work.
let ENCODE_BATCH_PARALLEL_THRESHOLD = 8;

fn _encode_chunk(tok, texts, start, end, add_bos, add_eos) {
    let out = [];
    let i = start;
    while i < end {
        push(out, encode(tok, texts[i], add_bos, add_eos));
        i = i + 1;
    }
    return out;
}

fn _encode_chunk_worker(tok, texts, start, end, add_bos, add_eos) {
    return fn() {
        return _encode_chunk(tok, texts, start, end, add_bos, add_eos);
    };
}

fn encode_batch(tok, texts, add_bos = false, add_eos = false, workers = 4) {
    let n = len(texts);
    if n == 0 { return []; }
    if workers < 2 or n < ENCODE_BATCH_PARALLEL_THRESHOLD {
        return _encode_chunk(tok, texts, 0, n, add_bos, add_eos);
    }

    let worker_count = workers;
    if worker_count > n { worker_count = n; }
    let base = num_floor(n / worker_count);
    let remainder = n % worker_count;
    let handles = [];
    let start = 0;
    let worker = 0;
    while worker < worker_count {
        let size = base;
        if worker < remainder { size = size + 1; }
        let end = start + size;
        if size > 0 {
            push(handles, spawn(_encode_chunk_worker(
                tok, texts, start, end, add_bos, add_eos)));
        }
        start = end;
        worker = worker + 1;
    }

    let parts = join_all(handles);
    let out = [];
    for part in parts {
        for ids in part { push(out, ids); }
    }
    return out;
}

fn decode(tok, ids, skip_special = true) {
    let out = "";
    let i = 0;
    while i < len(ids) {
        let id = ids[i];
        if id >= 0 and id < len(tok.id_to_token) {
            let t = tok.id_to_token[id];
            let is_special = map_has(tok.token_kind, t) and tok.token_kind[t] == "special";
            if not (skip_special and is_special) { out = out + t; }
        }
        i = i + 1;
    }
    return out;
}

fn tokenize(tok, text, add_bos = false, add_eos = false) {
    let ids = encode(tok, text, add_bos, add_eos);
    let tokens = [];
    let i = 0;
    while i < len(ids) {
        push(tokens, tok.id_to_token[ids[i]]);
        i = i + 1;
    }
    return tokens;
}

fn metadata(tok) {
    return map{
        format: tok.format,
        kind: tok.kind,
        source: tok.source,
        vocab_size: tok.vocab_size,
        num_merges: tok.num_merges,
        max_vocab: tok.max_vocab,
        specials: _copy_array(DEFAULT_SPECIALS),
        ids: tok.special
    };
}

fn model_io(tok) {
    return map{
        token_format: tok.format,
        input: "array<number> token ids",
        output: "array<number> token ids",
        pad_id: tok.special.pad,
        bos_id: tok.special.bos,
        eos_id: tok.special.eos,
        unk_id: tok.special.unk,
        vocab_size: tok.vocab_size
    };
}

fn describe(tok = nil) {
    if tok == nil { tok = train_default(); }
    return "pbAI tokenizer: " + tok.format + " (" + tok.kind + "), vocab="
        + str(tok.vocab_size) + ", merges=" + str(tok.num_merges)
        + ", specials=<pad>/<bos>/<eos>/<unk>, all pblang-native.";
}

export train, train_default, encode, encode_batch, decode, tokenize, metadata, model_io, describe;
