// pbai_web.sapp -- PBLang-authored, server-rendered pbAI website.
//
// The browser receives HTML and CSS because those are browser protocols, but
// the maintained source, rendering, validation, and actions are PBLang.  No
// JavaScript runtime or browser-side model is required.

let Encoding = import("stdlib:encoding.sapp");

let FORMAT = "pbai.web.view.v1";
let MAX_PROMPT_CHARS = 65536;
let MAX_LESSON_CHARS = 65536;

fn html_escape(value) {
    let out = str(value);
    out = str_replace_all(out, "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    out = str_replace_all(out, "'", "&#39;");
    return out;
}

fn decode_form(body) {
    if type(body) != "string" or len(body) > 140000 { return nil; }
    let decoded = try Encoding.query_decode(body) catch nil;
    if type(decoded) != "map" { return nil; }
    return decoded;
}

fn _text(value, fallback = "") {
    if value == nil { return fallback; }
    return try str(value) catch fallback;
}

fn _view_text(view, key, fallback = "") {
    if type(view) != "map" { return fallback; }
    return try _text(view[key], fallback) catch fallback;
}

fn _view_value(view, key, fallback = nil) {
    if type(view) != "map" { return fallback; }
    return try view[key] catch fallback;
}

fn _map_text(value, key, fallback) {
    if type(value) != "map" { return fallback; }
    return try _text(value[key], fallback) catch fallback;
}

fn _map_bool(value, key, fallback = false) {
    if type(value) != "map" { return fallback; }
    let current = try value[key] catch fallback;
    if type(current) != "bool" { return fallback; }
    return current;
}

fn _pretty(value) {
    if value == nil { return "Choose an action to run the real PBLang pbAI model."; }
    if type(value) == "string" { return value; }
    return try json_stringify(value) catch _text(value, "No serializable result.");
}

fn _status_card(label, value, detail) {
    return "<article class=\"status-card\"><span>" + html_escape(label) + "</span>"
        + "<strong>" + html_escape(value) + "</strong><small>" + html_escape(detail)
        + "</small></article>";
}

fn _action_button(action, label, kind = "") {
    let cls = "action";
    if kind != "" { cls = cls + " " + kind; }
    return "<button class=\"" + cls + "\" type=\"submit\" name=\"action\" value=\""
        + html_escape(action) + "\">" + html_escape(label) + "</button>";
}

fn stylesheet() {
    return "*,*::before,*::after{box-sizing:border-box}"
    + ":root{color-scheme:dark;--bg:#080b12;--panel:#111827;--panel2:#172033;--line:#2d3a54;"
    + "--text:#eef4ff;--muted:#9fb0cc;--accent:#66e3c4;--accent2:#7aa2ff;--warn:#ffd479;"
    + "--bad:#ff8c9b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}"
    + "html,body{margin:0;min-width:0;min-height:100%;background:radial-gradient(circle at 15% 0,#14213b 0,transparent 34rem),var(--bg);color:var(--text)}"
    + "body{min-height:100vh;line-height:1.5;-webkit-text-size-adjust:100%}button,textarea,input{font:inherit}"
    + ".shell{width:min(1480px,100%);margin:0 auto;padding:clamp(14px,2.5vw,34px);display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:20px}"
    + ".sidebar,.card{border:1px solid var(--line);border-radius:18px;background:rgba(17,24,39,.94);box-shadow:0 18px 55px rgba(0,0,0,.28)}"
    + ".sidebar{position:sticky;top:18px;align-self:start;padding:22px;display:flex;flex-direction:column;gap:18px}"
    + ".brand{display:flex;align-items:center;gap:13px}.mark{display:grid;width:54px;height:54px;place-items:center;border-radius:16px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#071018;font-weight:900;font-size:1.25rem}"
    + "h1,h2,h3,p{margin-top:0}.brand h1{margin:0;font-size:1.65rem}.brand p{margin:2px 0 0;color:var(--muted);font-size:.88rem}"
    + ".badge{display:inline-flex;width:max-content;max-width:100%;padding:6px 10px;border:1px solid #2d806e;border-radius:999px;color:var(--accent);font-size:.78rem;font-weight:750;letter-spacing:.04em;text-transform:uppercase}"
    + ".status-list{display:grid;gap:10px}.status-card{display:grid;gap:2px;padding:11px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}"
    + ".status-card span,.eyebrow{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em}.status-card strong{overflow-wrap:anywhere}.status-card small{color:var(--muted)}"
    + ".truth{padding:12px;border-left:3px solid var(--accent);background:#0c1d1b;color:#c9f9ec;font-size:.88rem}.workspace{min-width:0;display:flex;flex-direction:column;gap:18px}"
    + ".hero{padding:clamp(20px,4vw,38px);background:linear-gradient(135deg,rgba(23,32,51,.98),rgba(12,27,42,.98))}.hero h2{max-width:900px;margin-bottom:10px;font-size:clamp(1.7rem,4vw,3.15rem);line-height:1.08}.hero p{max-width:900px;color:var(--muted)}"
    + ".card{padding:clamp(16px,2.5vw,26px)}.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}"
    + "label{display:block;margin-bottom:7px;color:var(--muted);font-weight:700}textarea,input[type=password]{width:100%;border:1px solid var(--line);border-radius:12px;background:#090e19;color:var(--text);padding:13px}"
    + "textarea{min-height:230px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.55}textarea:focus,input:focus,button:focus-visible{outline:3px solid var(--accent2);outline-offset:2px}"
    + ".actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:13px}.action{min-height:44px;padding:9px 14px;border:1px solid #4c648f;border-radius:11px;background:#1b2941;color:var(--text);font-weight:750;cursor:pointer}.action:hover{border-color:var(--accent);transform:translateY(-1px)}"
    + ".action.primary{border-color:#43b99c;background:#166e5c}.action.learn{border-color:#9b7937;background:#5e481a}.action:active{transform:none}"
    + ".output{min-height:230px;margin:0;padding:14px;border:1px solid var(--line);border-radius:12px;background:#090e19;color:#dbe8ff;white-space:pre-wrap;overflow-wrap:anywhere;overflow:auto;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}"
    + ".output.ok{border-color:#2f806f}.output.error{border-color:#a84c5c}.notice{margin:0 0 12px;padding:10px 12px;border-radius:10px;background:#202b3e;color:var(--muted)}"
    + ".notice.error{background:#3a1921;color:#ffc4cc}.learn-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.45fr);gap:16px}.learn-grid textarea{min-height:145px}"
    + ".policy{padding:14px;border:1px solid #7a6232;border-radius:12px;background:#211b0e;color:#ffe7aa}.policy strong{color:var(--warn)}"
    + ".architecture{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:12px;perspective:900px}.node{min-height:116px;padding:14px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,#1d2a43,#101725);transform:rotateX(2deg);box-shadow:0 10px 22px rgba(0,0,0,.24)}"
    + ".node strong{display:block;color:var(--accent);margin-bottom:5px}.node span{color:var(--muted);font-size:.86rem}.node.active{border-color:var(--accent2);background:linear-gradient(145deg,#263c67,#111a2c)}"
    + ".limits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.limit{padding:13px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}.limit strong{display:block;margin-bottom:4px}.limit span{color:var(--muted);font-size:.88rem}"
    + ".footer{padding:6px 4px;color:var(--muted);font-size:.82rem;text-align:center}"
    + "@media(max-width:1050px){.shell{grid-template-columns:1fr}.sidebar{position:static}.status-list{grid-template-columns:repeat(4,minmax(0,1fr))}.architecture{grid-template-columns:repeat(3,minmax(0,1fr))}}"
    + "@media(max-width:760px){.editor-grid,.learn-grid{grid-template-columns:1fr}.status-list,.limits{grid-template-columns:repeat(2,minmax(0,1fr))}.architecture{grid-template-columns:repeat(2,minmax(0,1fr))}}"
    + "@media(max-width:460px){.shell{padding:10px}.card,.sidebar{border-radius:13px}.status-list,.limits,.architecture{grid-template-columns:1fr}.action{width:100%}}"
    + "@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}.action:hover{transform:none}}";
}

fn render(view) {
    let prompt = _view_text(view, "prompt", "Explain how pbAI plans and verifies a PBLang task.");
    let lesson = _view_text(view, "lesson", "");
    let title = _view_text(view, "title", "Ready");
    let notice = _view_text(view, "notice", "The real local PBLang model will handle each submitted action.");
    let result = _view_value(view, "result", nil);
    let result_ok = _view_value(view, "result_ok", true);
    if type(result_ok) != "bool" { result_ok = false; }
    let model = _view_value(view, "model", map{});
    let policy = _view_value(view, "policy", map{});
    let token_required = _view_value(view, "token_required", false);
    if type(token_required) != "bool" { token_required = false; }

    let family = _map_text(model, "family", "pbAI");
    let model_name = _map_text(model, "model", _map_text(model, "name", "local"));
    let backend = _map_text(model, "backend", "PBLang");
    let health = if _map_bool(model, "ok", true) { "ready" } else { "limited" };
    let policy_version = _map_text(policy, "policy_version", _map_text(policy, "format", "admission required"));
    let raw_locators = _map_bool(policy, "raw_locators_persisted", false);
    let token_field = "";
    if token_required {
        token_field = "<div class=\"token\"><label for=\"token\">Local server token</label>"
            + "<input id=\"token\" name=\"token\" type=\"password\" maxlength=\"4096\" autocomplete=\"off\" required>"
            + "</div>";
    }

    let output_text = if result == nil and not result_ok { "No result was produced. Review the message above." } else { _pretty(result) };
    let result_class = if result_ok { "ok" } else { "error" };
    let notice_class = if result_ok { "notice" } else { "notice error" };
    let html = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
        + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        + "<meta name=\"description\" content=\"Local PBLang-native pbAI console\">"
        + "<title>pbAI · PBLang-native console</title>"
        + "<link rel=\"stylesheet\" href=\"/website/pbai.css\"></head><body>"
        + "<div class=\"shell\"><aside class=\"sidebar\" aria-label=\"pbAI status\">"
        + "<div class=\"brand\"><div class=\"mark\" aria-hidden=\"true\">pb</div><div><h1>pbAI</h1>"
        + "<p>PBLang-native model console</p></div></div><span class=\"badge\">PBLang source only</span>"
        + "<div class=\"status-list\">"
        + _status_card("Family", family, model_name)
        + _status_card("Runtime", "PBLang", backend)
        + _status_card("Model", health, "current local status")
        + _status_card("Dataset", "fail closed", policy_version)
        + "</div><p class=\"truth\">This page runs the real local pbAI. It has no browser-side fallback model and no JavaScript runtime.</p>"
        + "</aside><main class=\"workspace\"><section class=\"card hero\"><span class=\"eyebrow\">Local · inspectable · explicit learning</span>"
        + "<h2>Think, verify and learn through one PBLang implementation.</h2>"
        + "<p>The browser is only a document viewer and form client. Planning, model execution, verification, privacy decisions and rendering originate in PBLang.</p></section>"
        + "<form class=\"card\" method=\"post\" action=\"/website/action\" accept-charset=\"UTF-8\" autocomplete=\"off\">"
        + token_field + "<div class=\"editor-grid\"><section><label for=\"prompt\">Prompt or PBLang code</label>"
        + "<textarea id=\"prompt\" name=\"prompt\" maxlength=\"" + str(MAX_PROMPT_CHARS)
        + "\" spellcheck=\"false\">" + html_escape(prompt) + "</textarea>"
        + "<div class=\"actions\">" + _action_button("respond", "Respond", "primary")
        + _action_button("analyze", "Analyze") + _action_button("think", "Think")
        + _action_button("generate", "Generate") + _action_button("tokenize", "Tokenize")
        + _action_button("self_eval", "Self-evaluate") + _action_button("brain", "Brain loop")
        + _action_button("status", "Refresh status") + _action_button("product_health", "Product health")
        + _action_button("grounding_status", "Grounding contract")
        + _action_button("ruler_status", "PBRuler status")
        + _action_button("ecosystem_status", "Specialist ecosystem")
        + _action_button("optimization_status", "Optimization contract") + "</div></section>"
        + "<section aria-labelledby=\"result-title\"><label id=\"result-title\">" + html_escape(title) + "</label>"
        + "<p class=\"" + notice_class + "\" role=\"status\">" + html_escape(notice) + "</p>"
        + "<pre class=\"output " + result_class + "\" tabindex=\"0\">" + html_escape(output_text) + "</pre></section></div>"
        + "<hr><div class=\"learn-grid\"><section><label for=\"lesson\">Reviewed lesson</label>"
        + "<textarea id=\"lesson\" name=\"lesson\" maxlength=\"" + str(MAX_LESSON_CHARS)
        + "\" spellcheck=\"false\" placeholder=\"A correction, rule, example or PBLang fact you reviewed\">"
        + html_escape(lesson) + "</textarea><div class=\"actions\">" + _action_button("learn", "Learn reviewed text", "learn")
        + _action_button("dataset_policy", "Dataset policy") + "</div></section>"
        + "<aside class=\"policy\"><strong>External sources are not auto-trained.</strong><p>Files, folders, disks, phones, scanned books and web pages remain discovery-only until provenance, training rights, consent, privacy scans, deduplication and split isolation pass admission.</p>"
        + "<p>Raw device paths retained: <strong>" + (if raw_locators { "yes" } else { "no" }) + "</strong></p></aside></div></form>"
        + "<section class=\"card\"><span class=\"eyebrow\">Architecture</span><h2>Grounded pbAI execution path</h2>"
        + "<div class=\"architecture\" role=\"list\">"
        + "<div class=\"node active\" role=\"listitem\"><strong>Input</strong><span>Bounded prompt or reviewed lesson</span></div>"
        + "<div class=\"node\" role=\"listitem\"><strong>Coordinator</strong><span>Selects the smallest useful expert set</span></div>"
        + "<div class=\"node\" role=\"listitem\"><strong>Planner</strong><span>Builds explicit steps and constraints</span></div>"
        + "<div class=\"node\" role=\"listitem\"><strong>Nano / experts</strong><span>Runs grounded local skills and model paths</span></div>"
        + "<div class=\"node active\" role=\"listitem\"><strong>Verifier</strong><span>Checks evidence, risk and action authority</span></div>"
        + "</div></section><section class=\"card\"><span class=\"eyebrow\">Honest boundaries</span><h2>What this console proves</h2>"
        + "<div class=\"limits\"><div class=\"limit\"><strong>Real local execution</strong><span>No simulated browser answer.</span></div>"
        + "<div class=\"limit\"><strong>Explicit learning</strong><span>No silent chat training or automatic disk ingestion.</span></div>"
        + "<div class=\"limit\"><strong>Current milestone</strong><span>A tested foundation, not a frontier-scale pretrained model.</span></div></div></section>"
        + "<footer class=\"footer\">pbAI web console · rendered and handled by PBLang · no JavaScript required</footer>"
        + "</main></div></body></html>";
    return html;
}

fn source_contract() {
    return map{
        ok: true,
        format: FORMAT,
        source_language: "pblang",
        browser_protocols: ["html", "css", "forms"],
        javascript_required: false,
        browser_model_fallback: false,
        max_prompt_chars: MAX_PROMPT_CHARS,
        max_lesson_chars: MAX_LESSON_CHARS
    };
}

export FORMAT, MAX_PROMPT_CHARS, MAX_LESSON_CHARS;
export html_escape, decode_form, stylesheet, render, source_contract;
