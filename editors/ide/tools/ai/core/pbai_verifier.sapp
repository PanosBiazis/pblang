// stdlib/pbai_verifier.sapp — independent post-producer verification policy.
//
// Verification is deliberately separate from generation. It receives only the
// typed task, prompt, candidate, and explicit evidence/options; no producer
// hidden state is shared. It never executes generated code or grants authority.

let MAX_PROMPT_CHARS = 65536;
let MAX_CANDIDATE_CHARS = 262144;
let MAX = (try import("pbai_max.sapp") catch import("editors/ide/tools/ai/core/pbai_max.sapp"));

fn _opt(options, key, fallback) {
    if options == nil { return fallback; }
    return try options[key] catch fallback;
}

fn _contains_any(text, values) {
    let low = str_lower(str(text));
    let hits = [];
    let i = 0;
    while i < len(values) {
        if str_contains(low, str_lower(str(values[i]))) { push(hits, str(values[i])); }
        i = i + 1;
    }
    return hits;
}

fn _looks_like_code(prompt, candidate) {
    let text = str_lower(str(prompt) + "\n" + str(candidate));
    return str_contains(text, "pblang") or str_contains(text, "fn ") or
        str_contains(text, "let ") or str_contains(text, "print ") or
        str_contains(text, "import(");
}

fn verify(task, prompt, candidate, options = nil) {
    let kind = str_lower(str_trim(str(task)));
    let input = str(prompt);
    let text = str(candidate);
    let findings = [];
    if len(input) > MAX_PROMPT_CHARS { push(findings, "prompt exceeds verifier limit"); }
    if str_trim(text) == "" { push(findings, "candidate is empty"); }
    if len(text) > MAX_CANDIDATE_CHARS { push(findings, "candidate exceeds verifier limit"); }

    let forbidden = _opt(options, "forbidden", ["<unk>", "undefined", "nan"]);
    let forbidden_hits = _contains_any(text, forbidden);
    if len(forbidden_hits) > 0 { push(findings, "candidate contains forbidden output tokens"); }

    let authoritative = _contains_any(text, [
        "guaranteed safe", "definitely no malware", "100% secure",
        "automatically approved", "permission granted"
    ]);
    let high_risk = kind == "security" or kind == "tool" or kind == "system";
    if high_risk and len(authoritative) > 0 {
        push(findings, "high-risk answer makes an unsupported authority claim");
    }

    let code_verification = nil;
    if kind == "generation" and _looks_like_code(input, text) {
        code_verification = MAX.strict_verify_generation(
            text, input, _opt(options, "expected", []), forbidden
        );
        if not code_verification.passed { push(findings, "generated PBLang failed strict verification"); }
    }

    let content_safe = len(findings) == 0;
    let suitable_for_display = content_safe;
    // Verification may approve bounded display, never an external effect.
    // Parsing, confidence, or a clean heuristic scan is not an authority grant.
    let authorized_for_action = false;
    let score = 1.0;
    if str_trim(text) == "" { score = score - 0.5; }
    if len(forbidden_hits) > 0 { score = score - 0.2; }
    if len(authoritative) > 0 { score = score - 0.2; }
    if code_verification != nil and not code_verification.passed { score = score - 0.4; }
    if score < 0 { score = 0; }

    return map{
        format: "pbai.expert.verification.v1",
        task: kind,
        passed: content_safe,
        score: score,
        suitable_for_display: suitable_for_display,
        authorized_for_action: authorized_for_action,
        human_review_required: high_risk or not content_safe,
        independent: true,
        producer_hidden_state_received: false,
        executed_candidate: false,
        findings: findings,
        forbidden_hits: forbidden_hits,
        authority_claim_hits: authoritative,
        code_verification: code_verification
    };
}

export verify, MAX_PROMPT_CHARS, MAX_CANDIDATE_CHARS;
