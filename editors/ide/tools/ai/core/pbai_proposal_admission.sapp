// Metadata-only admission for ideas and clean-room implementation proposals.
//
// This module intentionally has no filesystem, network, process, Git, model,
// memory, ingest, retrieval, or training imports. Caller receipts are claims,
// never authentication. A successful result is still quarantined pending an
// independent verifier and grants no capability or external effect.

let BOUNDED = import("stdlib:validate.sapp");

let FORMAT = "pbai.proposal-admission.v1";
let POLICY_VERSION = "pbai-proposal-policy-2026-08-30-v1";
let SCAN_POLICY_VERSION = "pbai-scan-evidence-2026-08-30-v1";
let SCAN_LEAD_FORMAT = "pbai.scan-lead.v1";
let MAX_CONTENT_BYTES = 1073741824;
let MAX_RECEIPT_LIFETIME = 604800;

let BOUNDS = map{
    max_depth: 4, max_nodes: 1024, max_map_entries: 48, max_array_items: 64,
    max_string_chars: 256, max_string_bytes: 256,
    max_total_string_bytes: 32768, max_key_chars: 64, max_key_bytes: 64
};

let ENTRY_KEYS = [
    "candidate_token", "source_id", "migration_class", "classification_evidence",
    "recommended_action", "required_gate", "review_queue", "priority_rank",
    "input_authenticated", "conversion_eligible", "excluded_from_migration",
    "advisory_only", "content_read", "executes", "persists",
    "publication_authorized", "authorizes_action", "authorizes_conversion",
    "authorizes_ingest", "authorizes_retrieval", "authorizes_training",
    "auto_conversion", "human_review_required", "clean_room_required"
];

let RECEIPT_KEYS = [
    "format", "receipt_id", "candidate_token", "source_id", "content_sha256",
    "content_bytes", "media_type", "policy_version", "operator_grant_id",
    "purpose", "audience", "owner_scope", "rights_status", "license_id",
    "consent_status", "consent_scope", "antivirus_status", "archive_coverage",
    "secret_scan", "pii_scan", "immutable_snapshot", "no_follow",
    "issued_epoch", "expires_epoch", "revoked"
];

let REVIEW_KEYS = [
    "format", "review_id", "candidate_token", "source_id",
    "receipt_binding_sha256", "target_project", "intent_summary_sha256",
    "behavior_contract_sha256", "acceptance_tests_sha256", "clean_room_required",
    "human_reviewed", "operator_grant_id", "purpose", "audience"
];

let SCAN_VALIDATION_KEYS = [
    "format", "policy_version", "ok", "state", "disposition", "reason",
    "reasons", "plan_id", "target_token", "check_kind", "shard_index",
    "receipt_claim_sha256", "known_match", "complete_claimed",
    "signature_fresh_claimed", "receipt_authenticated",
    "scanner_attestation_verified", "coverage_verified", "cleanup_verified",
    "malware_free_claimed", "raw_log_returned", "path_returned",
    "identifier_returned", "content_returned", "authorizes_action",
    "authorizes_scan", "authorizes_execution", "authorizes_network",
    "authorizes_memory_read", "authorizes_ingest", "authorizes_training",
    "authorizes_build", "authorizes_git", "authorizes_publication"
];

let SCAN_LEAD_KEYS = [
    "format", "lead_id", "candidate_token", "source_id", "content_sha256",
    "proposal_receipt_binding_sha256", "scan_plan_id", "scan_target_token",
    "scan_check_kind", "scan_shard_index", "scan_receipt_claim_sha256",
    "scan_policy_version", "locator_token", "rights_status", "license_id",
    "consent_status", "consent_scope", "privacy_decision", "reviewer_role",
    "separation_of_duties", "replay_nonce", "issued_epoch", "expires_epoch",
    "revoked", "authorizes_action", "authorizes_ingest", "authorizes_training",
    "authorizes_build", "authorizes_repository_creation", "authorizes_git",
    "authorizes_publication"
];

fn _base(reason) {
    return map{
        format: FORMAT, policy_version: POLICY_VERSION, ok: false,
        disposition: "quarantine", reason: reason, reasons: [reason],
        proposal_id: "", receipt_binding_sha256: "", review_binding_sha256: "",
        scan_lead_binding_sha256: "",
        target_project_token: "",
        claimed_gates_complete: false, independent_verification_required: true,
        scan_lead_claimed_complete: false,
        scan_evidence_authenticated: false,
        separation_of_duties_verified: false,
        replay_protection_verified: false, external_replay_ledger_required: true,
        receipt_authenticated: false, trust_anchor_verified: false,
        signature_verified: false, scanner_attestation_verified: false,
        consent_receipt_verified: false, rights_receipt_verified: false,
        descriptor_binding_verified: false, input_authenticated: false,
        content_read: false, content_returned: false, locator_returned: false,
        executes: false, persists: false, builds: false, commits: false,
        publishes: false, training_performed: false, automatic_conversion: false,
        creates_repository: false, accepted: false,
        authorizes_action: false, authorizes_conversion: false,
        authorizes_ingest: false, authorizes_retrieval: false,
        authorizes_training: false, authorizes_execution: false,
        authorizes_build: false,
        authorizes_repository_creation: false, authorizes_git: false,
        authorizes_publication: false,
        safe_for_public_logging: false
    };
}

fn _exact(value, keys) {
    return BOUNDED.exact_map_bounded(value, keys, BOUNDS).ok;
}

fn _hex(value, count) {
    if type(value) != "string" or len(value) != count { return false; }
    let i = 0;
    while i < count {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

fn _safe_id(value, maximum = 128) {
    if type(value) != "string" or value == "" or len(value) > maximum
        or len(str_to_bytes(value)) > maximum or str_trim(value) != value
        or str_contains(value, "..") { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90)
            or (c >= 97 and c <= 122) or c == 45 or c == 46
            or c == 58 or c == 95) { return false; }
        i = i + 1;
    }
    return true;
}

fn _safe_text(value, maximum = 128) {
    if type(value) != "string" or len(value) > maximum
        or len(str_to_bytes(value)) > maximum or str_trim(value) != value {
        return false;
    }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if c < 32 or (c >= 127 and c <= 159)
            or c == 1564 or (c >= 8203 and c <= 8207)
            or (c >= 8234 and c <= 8238) or c == 8288
            or (c >= 8294 and c <= 8297) or c == 65279 { return false; }
        i = i + 1;
    }
    return true;
}

fn _one_of(value, allowed) {
    let i = 0;
    while i < len(allowed) {
        if value == allowed[i] { return true; }
        i = i + 1;
    }
    return false;
}

fn _integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}

fn _push_if(reasons, condition, reason) {
    if not condition { push(reasons, reason); }
}

fn _entry_safe(entry) {
    if not _exact(entry, ENTRY_KEYS) or not _hex(entry.candidate_token, 64)
        or not (str_starts_with(entry.source_id, "src-")
            and _hex(str_slice(entry.source_id, 4, len(entry.source_id)), 24))
        or not _one_of(entry.migration_class,
            ["implementation", "idea", "reference", "dataset", "vendor", "generated", "archive", "unknown"])
        or not _integer(entry.priority_rank, 0, 6) { return false; }
    return entry.input_authenticated == false and entry.conversion_eligible == false
        and entry.advisory_only == true and entry.content_read == false
        and entry.executes == false and entry.persists == false
        and entry.publication_authorized == false and entry.authorizes_action == false
        and entry.authorizes_conversion == false and entry.authorizes_ingest == false
        and entry.authorizes_retrieval == false and entry.authorizes_training == false
        and entry.auto_conversion == false and entry.human_review_required == true
        and entry.clean_room_required == true;
}

fn _receipt_shape(receipt) {
    return _exact(receipt, RECEIPT_KEYS)
        and receipt.format == "pbai.discovery-receipt.v1"
        and receipt.policy_version == POLICY_VERSION
        and _safe_id(receipt.receipt_id) and _safe_id(receipt.operator_grant_id)
        and _hex(receipt.candidate_token, 64) and _hex(receipt.content_sha256, 64)
        and str_starts_with(receipt.source_id, "src-")
        and _hex(str_slice(receipt.source_id, 4, len(receipt.source_id)), 24)
        and _integer(receipt.content_bytes, 0, MAX_CONTENT_BYTES)
        and _one_of(receipt.media_type,
            ["pblang-source", "foreign-source", "document", "web", "notebook", "data", "model", "archive"])
        and _one_of(receipt.purpose,
            ["pblang-clean-room", "project-improvement", "new-project-proposal", "reference-review"])
        and receipt.audience == "local-private"
        and _one_of(receipt.owner_scope,
            ["self", "household-third-party", "public", "organization"])
        and _one_of(receipt.rights_status,
            ["owned", "licensed", "public-domain", "permission-granted", "unknown", "incompatible"])
        and _safe_text(receipt.license_id)
        and _one_of(receipt.consent_status, ["granted", "not-required", "unknown", "denied"])
        and _one_of(receipt.consent_scope, ["none", "review", "both"])
        and _one_of(receipt.antivirus_status,
            ["passed-current", "matched", "stale", "unavailable", "incomplete"])
        and _one_of(receipt.archive_coverage,
            ["not-archive", "complete", "incomplete", "unknown"])
        and _one_of(receipt.secret_scan, ["passed", "matched", "unavailable"])
        and _one_of(receipt.pii_scan, ["passed", "matched", "unavailable"])
        and ((receipt.rights_status == "licensed" and _safe_id(receipt.license_id))
            or (receipt.rights_status != "licensed" and receipt.license_id == ""))
        and type(receipt.immutable_snapshot) == "bool" and type(receipt.no_follow) == "bool"
        and type(receipt.revoked) == "bool"
        and _integer(receipt.issued_epoch, 0, 9007199254740991)
        and _integer(receipt.expires_epoch, 0, 9007199254740991);
}

fn _review_shape(review) {
    return _exact(review, REVIEW_KEYS)
        and review.format == "pbai.proposal-review.v1"
        and _safe_id(review.review_id) and _safe_id(review.target_project)
        and _safe_id(review.operator_grant_id)
        and _hex(review.candidate_token, 64)
        and str_starts_with(review.source_id, "src-")
        and _hex(str_slice(review.source_id, 4, len(review.source_id)), 24)
        and _hex(review.receipt_binding_sha256, 64)
        and _hex(review.intent_summary_sha256, 64)
        and _hex(review.behavior_contract_sha256, 64)
        and _hex(review.acceptance_tests_sha256, 64)
        and type(review.clean_room_required) == "bool"
        and type(review.human_reviewed) == "bool"
        and _one_of(review.purpose,
            ["pblang-clean-room", "project-improvement", "new-project-proposal", "reference-review"])
        and review.audience == "local-private";
}

fn _scan_validation_shape(scan) {
    if not _exact(scan, SCAN_VALIDATION_KEYS)
        or scan.format != "pbai.scan-evidence.validation.v1"
        or scan.policy_version != SCAN_POLICY_VERSION
        or not _hex(scan.plan_id, 64) or not _hex(scan.target_token, 64)
        or scan.check_kind != "antivirus-static"
        or not _integer(scan.shard_index, 0, 63)
        or not _hex(scan.receipt_claim_sha256, 64)
        or not _one_of(scan.state,
            ["invalid", "requested", "started", "unavailable", "partial", "complete-claim"])
        or not _one_of(scan.disposition, ["quarantine", "deny"])
        or not _safe_text(scan.reason, 128)
        or type(scan.reasons) != "array" or len(scan.reasons) > 32 { return false; }
    let i = 0;
    while i < len(scan.reasons) {
        if not _safe_text(scan.reasons[i], 128) { return false; }
        i = i + 1;
    }
    return type(scan.ok) == "bool" and type(scan.known_match) == "bool"
        and type(scan.complete_claimed) == "bool"
        and type(scan.signature_fresh_claimed) == "bool"
        and scan.receipt_authenticated == false
        and scan.scanner_attestation_verified == false
        and scan.coverage_verified == false and scan.cleanup_verified == false
        and scan.malware_free_claimed == false and scan.raw_log_returned == false
        and scan.path_returned == false and scan.identifier_returned == false
        and scan.content_returned == false and scan.authorizes_action == false
        and scan.authorizes_scan == false and scan.authorizes_execution == false
        and scan.authorizes_network == false and scan.authorizes_memory_read == false
        and scan.authorizes_ingest == false and scan.authorizes_training == false
        and scan.authorizes_build == false and scan.authorizes_git == false
        and scan.authorizes_publication == false;
}

fn _scan_lead_shape(lead) {
    return _exact(lead, SCAN_LEAD_KEYS) and lead.format == SCAN_LEAD_FORMAT
        and _safe_id(lead.lead_id) and _hex(lead.candidate_token, 64)
        and str_starts_with(lead.source_id, "src-")
        and _hex(str_slice(lead.source_id, 4, len(lead.source_id)), 24)
        and _hex(lead.content_sha256, 64)
        and _hex(lead.proposal_receipt_binding_sha256, 64)
        and _hex(lead.scan_plan_id, 64) and _hex(lead.scan_target_token, 64)
        and lead.scan_check_kind == "antivirus-static"
        and _integer(lead.scan_shard_index, 0, 63)
        and _hex(lead.scan_receipt_claim_sha256, 64)
        and lead.scan_policy_version == SCAN_POLICY_VERSION
        and _hex(lead.locator_token, 64) and _hex(lead.replay_nonce, 64)
        and _one_of(lead.rights_status,
            ["owned", "licensed", "public-domain", "permission-granted", "unknown", "incompatible"])
        and _safe_text(lead.license_id)
        and _one_of(lead.consent_status, ["granted", "not-required", "unknown", "denied"])
        and _one_of(lead.consent_scope, ["none", "review", "both"])
        and lead.privacy_decision == "quarantine"
        and lead.reviewer_role == "security-reviewer"
        and type(lead.separation_of_duties) == "bool" and lead.separation_of_duties
        and _integer(lead.issued_epoch, 0, 9007199254740991)
        and _integer(lead.expires_epoch, 0, 9007199254740991)
        and type(lead.revoked) == "bool"
        and lead.authorizes_action == false and lead.authorizes_ingest == false
        and lead.authorizes_training == false and lead.authorizes_build == false
        and lead.authorizes_repository_creation == false
        and lead.authorizes_git == false and lead.authorizes_publication == false
        and ((lead.rights_status == "licensed" and _safe_id(lead.license_id))
            or (lead.rights_status != "licensed" and lead.license_id == ""));
}

fn _framed(value) {
    let text = str(value);
    return str(len(str_to_bytes(text))) + ":" + text;
}

fn _typed_framed(value) {
    return _framed(type(value)) + _framed(value);
}

fn _canonical_fields(value, keys) {
    let framed = [];
    let i = 0;
    while i < len(keys) {
        let field_value = value[keys[i]];
        let encoded = if type(field_value) == "array"
            { json_stringify(field_value) } else { field_value };
        push(framed, _framed(keys[i]) + _typed_framed(encoded));
        i = i + 1;
    }
    return str_join(framed, "");
}

fn _canonical_receipt(receipt) {
    let fields = [
        receipt.format, receipt.receipt_id, receipt.candidate_token, receipt.source_id,
        receipt.content_sha256, str(receipt.content_bytes), receipt.media_type,
        receipt.policy_version, receipt.operator_grant_id, receipt.purpose,
        receipt.audience, receipt.owner_scope, receipt.rights_status, receipt.license_id,
        receipt.consent_status, receipt.consent_scope, receipt.antivirus_status,
        receipt.archive_coverage, receipt.secret_scan, receipt.pii_scan,
        str(receipt.immutable_snapshot), str(receipt.no_follow),
        str(receipt.issued_epoch), str(receipt.expires_epoch), str(receipt.revoked)
    ];
    let framed = [];
    let i = 0;
    while i < len(fields) { push(framed, _framed(fields[i])); i = i + 1; }
    return str_join(framed, "");
}

fn _canonical_review(review) {
    let fields = [
        review.format, review.review_id, review.candidate_token, review.source_id,
        review.receipt_binding_sha256, review.target_project,
        review.intent_summary_sha256, review.behavior_contract_sha256,
        review.acceptance_tests_sha256, str(review.clean_room_required),
        str(review.human_reviewed), review.operator_grant_id,
        review.purpose, review.audience
    ];
    let framed = [];
    let i = 0;
    while i < len(fields) { push(framed, _framed(fields[i])); i = i + 1; }
    return str_join(framed, "");
}

fn _scan_lead_binding(receipt_binding, scan, lead) {
    return sha256("pbai-scan-lead-v1\x00" + _framed(receipt_binding)
        + _framed(_canonical_fields(scan, SCAN_VALIDATION_KEYS))
        + _framed(_canonical_fields(lead, SCAN_LEAD_KEYS)));
}

fn bind_receipt(receipt) {
    let out = _base("invalid-receipt");
    out.format = "pbai.proposal-receipt-binding.v1";
    if not _receipt_shape(receipt) { return out; }
    out.ok = true;
    out.reason = "receipt-claim-bound-not-authenticated";
    out.reasons = [out.reason];
    out.receipt_binding_sha256 = sha256("pbai-proposal-receipt-v1\x00" + _canonical_receipt(receipt));
    return out;
}

fn prepare(entry, receipt, review, evaluation_epoch) {
    let out = _base("invalid-bounded-input");
    if not _entry_safe(entry) or not _receipt_shape(receipt)
        or not _review_shape(review)
        or not _integer(evaluation_epoch, 0, 9007199254740991) { return out; }

    let binding = sha256("pbai-proposal-receipt-v1\x00" + _canonical_receipt(receipt));
    let review_binding = sha256("pbai-proposal-review-v1\x00" + _canonical_review(review));
    let reasons = [];
    _push_if(reasons, entry.candidate_token == receipt.candidate_token
        and receipt.candidate_token == review.candidate_token, "candidate-token-mismatch");
    _push_if(reasons, entry.source_id == receipt.source_id
        and receipt.source_id == review.source_id, "source-id-mismatch");
    _push_if(reasons, review.receipt_binding_sha256 == binding, "receipt-binding-mismatch");
    _push_if(reasons, receipt.operator_grant_id == review.operator_grant_id,
        "operator-grant-mismatch");
    _push_if(reasons, receipt.purpose == review.purpose, "purpose-mismatch");
    _push_if(reasons, receipt.audience == review.audience, "audience-mismatch");
    _push_if(reasons, receipt.issued_epoch <= evaluation_epoch
        and evaluation_epoch < receipt.expires_epoch
        and receipt.expires_epoch - receipt.issued_epoch <= MAX_RECEIPT_LIFETIME,
        "receipt-expired-or-invalid-lifetime");
    _push_if(reasons, not receipt.revoked, "receipt-revoked");
    _push_if(reasons, receipt.antivirus_status == "passed-current", "antivirus-not-currently-passed");
    _push_if(reasons, receipt.archive_coverage == "not-archive"
        or receipt.archive_coverage == "complete", "archive-coverage-incomplete");
    _push_if(reasons, receipt.secret_scan == "passed", "secret-scan-not-passed");
    _push_if(reasons, receipt.pii_scan == "passed", "pii-scan-not-passed");
    _push_if(reasons, receipt.immutable_snapshot and receipt.no_follow,
        "immutable-no-follow-evidence-missing");
    _push_if(reasons, _one_of(receipt.rights_status,
        ["owned", "licensed", "public-domain", "permission-granted"]),
        "rights-not-established");
    if receipt.rights_status == "licensed" {
        _push_if(reasons, _safe_id(receipt.license_id), "license-id-missing");
    }
    let third_party = receipt.owner_scope == "household-third-party"
        or receipt.owner_scope == "organization";
    if third_party {
        _push_if(reasons, receipt.consent_status == "granted", "explicit-consent-required");
        _push_if(reasons, receipt.consent_scope == "review"
            or receipt.consent_scope == "both", "review-consent-scope-required");
    } else {
        _push_if(reasons, receipt.consent_status == "not-required"
            or receipt.consent_status == "granted", "consent-status-unresolved");
    }
    _push_if(reasons, review.clean_room_required and review.human_reviewed,
        "human-clean-room-review-required");
    _push_if(reasons, not entry.excluded_from_migration, "catalog-entry-excluded");

    out.receipt_binding_sha256 = binding;
    out.review_binding_sha256 = review_binding;
    out.proposal_id = "proposal-" + str_slice(sha256("pbai-proposal-v1\x00"
        + _framed(binding) + _framed(review_binding)), 0, 24);
    out.target_project_token = "project-" + str_slice(sha256(review.target_project), 0, 24);
    out.reasons = reasons;
    out.reason = if len(reasons) == 0
        { "awaiting-independent-authentication" } else { reasons[0] };
    out.claimed_gates_complete = len(reasons) == 0;
    out.disposition = if len(reasons) == 0
        { "quarantine-awaiting-independent-verifier" } else { "quarantine" };
    out.ok = len(reasons) == 0;
    return out;
}

fn prepare_scan_lead(entry, receipt, scan, lead, review, evaluation_epoch) {
    let out = _base("invalid-bounded-scan-lead");
    if not _entry_safe(entry) or not _receipt_shape(receipt)
        or not _scan_validation_shape(scan) or not _scan_lead_shape(lead)
        or not _review_shape(review)
        or not _integer(evaluation_epoch, 0, 9007199254740991) { return out; }

    let base_proposal = prepare(entry, receipt, review, evaluation_epoch);
    let receipt_binding = sha256("pbai-proposal-receipt-v1\x00"
        + _canonical_receipt(receipt));
    let lead_binding = _scan_lead_binding(receipt_binding, scan, lead);
    let reasons = [];
    _push_if(reasons, base_proposal.ok, base_proposal.reason);
    _push_if(reasons, lead.candidate_token == entry.candidate_token
        and lead.candidate_token == receipt.candidate_token
        and lead.candidate_token == review.candidate_token,
        "lead-candidate-token-mismatch");
    _push_if(reasons, lead.source_id == entry.source_id
        and lead.source_id == receipt.source_id and lead.source_id == review.source_id,
        "lead-source-id-mismatch");
    _push_if(reasons, lead.content_sha256 == receipt.content_sha256,
        "lead-content-provenance-mismatch");
    _push_if(reasons, lead.proposal_receipt_binding_sha256 == receipt_binding,
        "lead-proposal-receipt-binding-mismatch");
    _push_if(reasons, lead.scan_plan_id == scan.plan_id
        and lead.scan_target_token == scan.target_token
        and lead.scan_check_kind == scan.check_kind
        and lead.scan_shard_index == scan.shard_index
        and lead.scan_receipt_claim_sha256 == scan.receipt_claim_sha256
        and lead.scan_policy_version == scan.policy_version,
        "lead-scan-binding-mismatch");
    _push_if(reasons, lead.rights_status == receipt.rights_status
        and lead.license_id == receipt.license_id
        and lead.consent_status == receipt.consent_status
        and lead.consent_scope == receipt.consent_scope,
        "lead-rights-or-consent-mismatch");
    _push_if(reasons, lead.issued_epoch <= evaluation_epoch
        and evaluation_epoch < lead.expires_epoch
        and lead.expires_epoch - lead.issued_epoch <= MAX_RECEIPT_LIFETIME,
        "lead-expired-or-invalid-lifetime");
    _push_if(reasons, not lead.revoked, "lead-revoked");
    _push_if(reasons, lead.lead_id != review.review_id,
        "reviewer-separation-identifier-required");

    let known_match = scan.known_match or scan.disposition == "deny";
    let complete_fresh_claim = scan.ok and scan.state == "complete-claim"
        and scan.complete_claimed and scan.signature_fresh_claimed
        and not known_match;
    if not known_match {
        _push_if(reasons, complete_fresh_claim, "scan-claim-partial-stale-or-unavailable");
    }

    out.receipt_binding_sha256 = receipt_binding;
    out.review_binding_sha256 = base_proposal.review_binding_sha256;
    out.scan_lead_binding_sha256 = lead_binding;
    out.proposal_id = "proposal-" + str_slice(sha256("pbai-scan-proposal-v1\x00"
        + _framed(base_proposal.proposal_id) + _framed(lead_binding)), 0, 24);
    out.target_project_token = base_proposal.target_project_token;
    out.scan_lead_claimed_complete = complete_fresh_claim;
    out.reasons = reasons;
    out.claimed_gates_complete = len(reasons) == 0 and complete_fresh_claim;
    out.ok = out.claimed_gates_complete;
    if known_match {
        out.disposition = "deny"; out.reason = "known-match"; out.ok = false;
        out.claimed_gates_complete = false;
    } elif out.ok {
        out.disposition = "quarantine-awaiting-independent-verifier";
        out.reason = "scan-lead-claim-bound-not-authenticated";
    } else {
        out.disposition = "quarantine";
        out.reason = if len(reasons) > 0 { reasons[0] }
            else { "scan-lead-not-admitted" };
    }
    return out;
}

fn status() {
    let out = _base("status");
    out.format = "pbai.proposal-admission.status.v1";
    out.ok = true;
    out.implementation_language = "pblang";
    out.pure_metadata_only = true;
    out.exact_bounded_schemas = true;
    out.receipt_claims_authenticated = false;
    out.runtime_enforcement_available = false;
    out.scan_lead_adapter_available = true;
    out.scan_lead_acceptance_available = false;
    out.repository_creation_available = false;
    return out;
}

export FORMAT, POLICY_VERSION, SCAN_LEAD_FORMAT,
       bind_receipt, prepare, prepare_scan_lead, status;
