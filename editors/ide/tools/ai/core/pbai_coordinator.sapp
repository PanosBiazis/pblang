// stdlib/pbai_coordinator.sapp — serial planner/producer/verifier composition.
//
// The producer runs outside this pure coordinator. begin() prepares the typed
// plan; finish() receives its candidate and conditionally invokes the independent
// verifier. At no point are two experts active together.

let PLANNER = (try import("pbai_planner.sapp") catch import("editors/ide/tools/ai/core/pbai_planner.sapp"));
let VERIFIER = (try import("pbai_verifier.sapp") catch import("editors/ide/tools/ai/core/pbai_verifier.sapp"));

fn _opt(options, key, fallback) {
    if options == nil { return fallback; }
    return try options[key] catch fallback;
}

fn begin(prompt, routing, options = nil) {
    let plan = PLANNER.plan(prompt, routing, options);
    return map{
        format: "pbai.expert.serial.begin.v1",
        ok: plan.ok,
        prompt: str(prompt),
        routing: routing,
        plan: plan,
        parallel: false,
        max_active_experts: if plan.ok { 1 } else { 0 },
        stages_completed: if plan.ok { ["planner"] } else { [] }
    };
}

fn finish(prepared, candidate, options = nil) {
    if not is_map(prepared) or not (try prepared.ok catch false) {
        return map{
            format: "pbai.expert.serial.result.v1", ok: false,
            error: "invalid or failed prepared expert plan",
            text: "", verification: nil,
            parallel: false, max_active_experts: 0, stages: []
        };
    }
    let routing = prepared.routing;
    let required = try routing.requires_independent_verifier catch false;
    if _opt(options, "verify", false) { required = true; }
    let verification = nil;
    let stages = ["planner", "producer"];
    if required {
        verification = VERIFIER.verify(try routing.task catch "grounded", prepared.prompt, candidate, options);
        push(stages, "verifier");
    }
    let display = true;
    // A model/coordinator result is never an execution capability. A future
    // effect adapter must obtain a fresh, exact PBRuler decision immediately
    // before the effect.
    let action = false;
    if verification != nil {
        display = verification.suitable_for_display;
    }
    return map{
        format: "pbai.expert.serial.result.v1",
        ok: display,
        text: if display { str(candidate) } else { "pbAI withheld a candidate that failed independent verification." },
        candidate_withheld: not display,
        verification: verification,
        authorized_for_action: action,
        human_review_required: if verification == nil { false } else { verification.human_review_required },
        parallel: false,
        max_active_experts: 1,
        stages: stages,
        producer_hidden_state_shared_with_verifier: false
    };
}

export begin, finish;
