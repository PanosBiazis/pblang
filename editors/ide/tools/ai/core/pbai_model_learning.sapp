// pbai_model_learning.sapp -- brain-inspired, governed per-model learning policy.
//
// This slice is pure metadata. It never accepts raw content, persists memory,
// trains weights, promotes candidates, activates artifacts, or grants authority.

let BOUNDED = import("stdlib:validate.sapp");
let CATALOG = (try import("pbai_model_catalog.sapp") catch import("editors/ide/tools/ai/core/pbai_model_catalog.sapp"));

let PROFILE_FORMAT = "pbai.model.learning-profile.v1";
let OBSERVATION_FORMAT = "pbai.model.working-observation-plan.v1";
let DURABLE_PLAN_FORMAT = "pbai.model.durable-learning-plan.v1";
let PROPOSAL_FORMAT = "pbai.model.learning-proposal.v1";
let SCHEMA_VERSION = "1.0.0";
let POLICY_VERSION = "1.0.0";

let PROFILE_KEYS = ["format", "schema_version", "profile_id", "policy_version",
    "catalog_revision", "model_id", "model_kind", "model_descriptor_digest",
    "tiers", "signals", "rehearsal", "consolidation", "plasticity", "forgetting",
    "budgets", "gates", "lifecycle_state", "metadata_only", "persists", "trains",
    "promotes", "activates", "authorizes_action", "profile_digest"];
let PROPOSAL_KEYS = ["format", "schema_version", "proposal_id", "source_kind",
    "source_manifest_digest", "owner_scope", "purpose", "audience"];
let SMALL_BOUNDS = map{ max_depth: 8, max_nodes: 4096, max_map_entries: 32,
    max_array_items: 32, max_string_chars: 128, max_string_bytes: 128,
    max_total_string_bytes: 131072, max_key_chars: 64, max_key_bytes: 64 };

fn _in(items, value) {
    if type(items) != "array" { return false; }
    for item in items { if item == value { return true; } }
    return false;
}

fn _exact_keys(value, allowed) {
    if type(value) != "map" { return false; }
    let keys = map_keys(value);
    if len(keys) != len(allowed) { return false; }
    for key in keys { if not _in(allowed, key) { return false; } }
    return true;
}

fn _integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}

fn _slug(value) {
    if type(value) != "string" or value == "" or len(value) > 64
        or len(str_to_bytes(value)) != len(value) { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if i == 0 and not (c >= 97 and c <= 122) { return false; }
        if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45) { return false; }
        if c == 45 and (i == len(value) - 1 or (i > 0 and strcharcodeat(value, i - 1) == 45)) { return false; }
        i = i + 1;
    }
    return true;
}

fn _digest(value) {
    if type(value) != "string" or len(value) != 64 { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

fn _find_model(catalog, model_id) {
    let i = 0;
    while i < len(catalog.models) {
        if catalog.models[i].model_id == model_id { return i; }
        i = i + 1;
    }
    return -1;
}

fn _tiers() {
    return map{
        working: map{ scope: "task-owner-model", ttl_ms: 300000,
            max_items: 64, max_bytes: 262144, persists: false, trains: false },
        episodic: map{ scope: "owner-purpose-model", ttl_ms: 0,
            max_items: 0, max_bytes: 0, persists: false, trains: false },
        semantic: map{ scope: "owner-purpose-model", ttl_ms: 0,
            max_items: 0, max_bytes: 0, persists: false, trains: false }
    };
}

fn _signals() {
    return map{ allowed_kinds: ["novelty", "prediction-error", "operator-correction",
        "verifier-feedback", "chat", "retrieval", "tool-output", "mcp-output"],
        max_per_task: 64, minimum_confidence_bp: 8000,
        caller_claims_are_truth: false, corrections_are_truth: false };
}

fn _rehearsal() {
    return map{ admitted_sources_only: true, dedup_required: true,
        cluster_separation_required: true, sealed_evaluation_excluded: true,
        max_samples: 0, max_steps: 0, max_source_ratio_bp: 2500,
        max_synthetic_ratio_bp: 1000 };
}

fn _consolidation() {
    return map{ minimum_evidence_items: 3, minimum_source_groups: 2,
        shadow_candidate_only: true, automatic: false, in_place: false };
}

fn _plasticity() {
    return map{ per_update_drift_bp: 0, cumulative_drift_bp: 0,
        online_weight_mutation: false, profile_self_modification: false };
}

fn _forgetting() {
    return map{ operator_deletion_receipt_required: true,
        lineage_propagation_required: true, model_signal_has_effect: false,
        immutable_rules_erasable: false, audit_erasable: false,
        provenance_erasable: false, sealed_evaluation_erasable: false,
        revocation_records_erasable: false, rollback_anchor_erasable: false };
}

fn _budgets() {
    return map{ max_signals: 64, max_input_bytes: 262144, max_records: 64,
        max_samples: 0, max_epochs: 0, max_steps: 0, max_tokens: 0,
        max_ram_bytes: 0, max_temp_storage_bytes: 0, max_wall_time_ms: 0,
        max_retries: 0, max_candidates: 0, max_evaluations: 0,
        max_concurrency: 0 };
}

fn _gates() {
    return map{ operator_approval_authenticated: false,
        dataset_receipts_authenticated: false, provenance_verified: false,
        rights_and_consent_verified: false, privacy_verified: false,
        poisoning_and_backdoor_tests_passed: false, replay_enforced: false,
        shadow_candidate_created: false, quarantine_enforced: false,
        hidden_evaluation_enforced: false, independent_verification_complete: false,
        benchmark_and_regression_complete: false, promotion_cas_available: false,
        rollback_target_authenticated: false };
}

fn _payload(profile) {
    return map{ format: PROFILE_FORMAT, schema_version: SCHEMA_VERSION,
        profile_id: profile.profile_id, policy_version: POLICY_VERSION,
        catalog_revision: profile.catalog_revision, model_id: profile.model_id,
        model_kind: profile.model_kind,
        model_descriptor_digest: profile.model_descriptor_digest,
        tiers: profile.tiers, signals: profile.signals, rehearsal: profile.rehearsal,
        consolidation: profile.consolidation, plasticity: profile.plasticity,
        forgetting: profile.forgetting, budgets: profile.budgets, gates: profile.gates,
        lifecycle_state: "registered-disabled", metadata_only: true,
        persists: false, trains: false, promotes: false, activates: false,
        authorizes_action: false };
}

fn learning_profile(catalog, model_id) {
    if not CATALOG.validate_catalog(catalog).ok or type(model_id) != "string" {
        return map{ ok: false, reason: "invalid-catalog-or-model", metadata_only: true,
            persists: false, trains: false, promotes: false, activates: false,
            authorizes_action: false };
    }
    let index = _find_model(catalog, model_id);
    if index < 0 { return map{ ok: false, reason: "unknown-model", metadata_only: true,
        persists: false, trains: false, promotes: false, activates: false,
        authorizes_action: false }; }
    let model = catalog.models[index];
    let profile = map{ format: PROFILE_FORMAT, schema_version: SCHEMA_VERSION,
        profile_id: "learning-" + str_slice(sha256(model.model_id + "\x00"
            + model.descriptor_digest), 0, 32), policy_version: POLICY_VERSION,
        catalog_revision: catalog.revision, model_id: model.model_id,
        model_kind: model.kind, model_descriptor_digest: model.descriptor_digest,
        tiers: _tiers(), signals: _signals(), rehearsal: _rehearsal(),
        consolidation: _consolidation(), plasticity: _plasticity(),
        forgetting: _forgetting(), budgets: _budgets(), gates: _gates(),
        lifecycle_state: "registered-disabled", metadata_only: true,
        persists: false, trains: false, promotes: false, activates: false,
        authorizes_action: false };
    profile.profile_digest = sha256(json_stringify(_payload(profile)));
    return profile;
}

fn validate_profile(catalog, profile) {
    if not BOUNDED.inspect_bounded(profile, SMALL_BOUNDS).ok
        or not _exact_keys(profile, PROFILE_KEYS) or profile.format != PROFILE_FORMAT
        or profile.schema_version != SCHEMA_VERSION or profile.policy_version != POLICY_VERSION
        or not _slug(profile.profile_id) or type(profile.model_id) != "string"
        or not _integer(profile.catalog_revision, 1, 9007199254740991)
        or not _digest(profile.model_descriptor_digest) or not _digest(profile.profile_digest)
        or profile.lifecycle_state != "registered-disabled" or profile.metadata_only != true
        or profile.persists != false or profile.trains != false or profile.promotes != false
        or profile.activates != false or profile.authorizes_action != false {
        return map{ ok: false, reason: "invalid-learning-profile", authenticated: false };
    }
    if not CATALOG.validate_catalog(catalog).ok or profile.catalog_revision != catalog.revision {
        return map{ ok: false, reason: "stale-or-invalid-catalog-binding", authenticated: false };
    }
    let expected = learning_profile(catalog, profile.model_id);
    if not (try expected.format == PROFILE_FORMAT catch false)
        or expected.model_kind != profile.model_kind
        or expected.model_descriptor_digest != profile.model_descriptor_digest
        or expected.profile_digest != profile.profile_digest
        or json_stringify(_payload(expected)) != json_stringify(_payload(profile)) {
        return map{ ok: false, reason: "learning-profile-binding-mismatch", authenticated: false };
    }
    return map{ ok: true, reason: "valid-disabled-learning-profile",
        catalog_revision: catalog.revision, model_id: profile.model_id,
        authenticated: false, metadata_only: true, persists: false, trains: false,
        promotes: false, activates: false, authorizes_action: false };
}

fn working_observation_plan(catalog, model_id, source_kind, task_scope, owner_scope) {
    let profile = learning_profile(catalog, model_id);
    if not (try profile.format == PROFILE_FORMAT catch false)
        or not _in(profile.signals.allowed_kinds, source_kind)
        or not _slug(task_scope) or not _slug(owner_scope) {
        return map{ format: OBSERVATION_FORMAT, ok: false, reason: "invalid-model-or-source-kind",
            tier: "none", metadata_only: true, persists: false, trains: false,
            promotes: false, activates: false, authorizes_action: false };
    }
    return map{ format: OBSERVATION_FORMAT, ok: true,
        reason: "ephemeral-working-memory-only", model_id: profile.model_id,
        model_descriptor_digest: profile.model_descriptor_digest,
        profile_digest: profile.profile_digest, source_kind: source_kind,
        task_scope: task_scope, owner_scope: owner_scope, scope_bound: true,
        tier: "working", ttl_ms: profile.tiers.working.ttl_ms,
        max_items: profile.tiers.working.max_items,
        max_bytes: profile.tiers.working.max_bytes,
        caller_claims_are_truth: false, retrieval_grants_training: false,
        raw_content_accepted: false, metadata_only: true, persists: false,
        trains: false, promotes: false, activates: false, authorizes_action: false };
}

fn _proposal_valid(proposal) {
    return _exact_keys(proposal, PROPOSAL_KEYS) and proposal.format == PROPOSAL_FORMAT
        and proposal.schema_version == SCHEMA_VERSION and _slug(proposal.proposal_id)
        and _in(["operator-curriculum", "admitted-dataset", "verified-feedback"], proposal.source_kind)
        and _digest(proposal.source_manifest_digest) and _slug(proposal.owner_scope)
        and _slug(proposal.purpose) and _slug(proposal.audience);
}

fn _proposal_payload(proposal) {
    return map{ format: PROPOSAL_FORMAT, schema_version: SCHEMA_VERSION,
        proposal_id: proposal.proposal_id, source_kind: proposal.source_kind,
        source_manifest_digest: proposal.source_manifest_digest,
        owner_scope: proposal.owner_scope, purpose: proposal.purpose,
        audience: proposal.audience };
}

fn durable_learning_plan(catalog, profile, proposal) {
    let profile_check = validate_profile(catalog, profile);
    if not profile_check.ok or not BOUNDED.inspect_bounded(proposal, SMALL_BOUNDS).ok
        or not _proposal_valid(proposal) {
        return map{ format: DURABLE_PLAN_FORMAT, ok: false,
            reason: "invalid-profile-or-proposal", decision: "quarantine",
            metadata_only: true, persists: false, trains: false, promotes: false,
            activates: false, authorizes_action: false };
    }
    let proposal_digest = sha256(json_stringify(_proposal_payload(proposal)));
    let plan_binding = map{ format: DURABLE_PLAN_FORMAT,
        catalog_revision: catalog.revision, model_id: profile.model_id,
        model_descriptor_digest: profile.model_descriptor_digest,
        profile_digest: profile.profile_digest, proposal_digest: proposal_digest,
        proposal_id: proposal.proposal_id,
        source_manifest_digest: proposal.source_manifest_digest,
        owner_scope: proposal.owner_scope, purpose: proposal.purpose,
        audience: proposal.audience, decision: "quarantine" };
    let plan_digest = sha256(json_stringify(plan_binding));
    return map{ format: DURABLE_PLAN_FORMAT, ok: true,
        reason: "authenticated-learning-gates-unavailable", decision: "quarantine",
        model_id: profile.model_id, catalog_revision: catalog.revision,
        model_descriptor_digest: profile.model_descriptor_digest,
        profile_digest: profile.profile_digest, proposal_id: proposal.proposal_id,
        proposal_digest: proposal_digest,
        source_manifest_digest: proposal.source_manifest_digest,
        owner_scope: proposal.owner_scope, purpose: proposal.purpose,
        audience: proposal.audience, plan_digest: plan_digest,
        scope_bound: true, shadow_candidate_only: true,
        in_place_update: false, ordinary_chat_eligible: false,
        dataset_receipt_validator_implemented: false,
        replay_enforcement_implemented: false, hidden_evaluation_enforced: false,
        trainer_can_evaluate: false, trainer_can_verify: false,
        trainer_can_promote: false, model_can_edit_profile: false,
        pbruler_advice_is_authority: false, hard_rules_learnable: false,
        promotable: false, promotion_available: false,
        rollback_executed: false, activation_available: false,
        metadata_only: true, persists: false, trains: false, promotes: false,
        activates: false, authorizes_action: false };
}

fn status() {
    return map{ format: "pbai.model.learning-status.v1", ok: true,
        implementation_language: "pblang", per_model_profiles: true,
        working_episodic_semantic_tiers: true, novelty_and_error_signals: true,
        rehearsal_and_consolidation_policy: true, bounded_plasticity_policy: true,
        controlled_forgetting_policy: true, shadow_candidate_required: true,
        brain_inspired_analogy: true, biological_brain_simulation: false,
        consciousness_claimed: false, ordinary_chat_persists: false,
        ordinary_chat_trains: false, live_weight_mutation: false,
        dataset_receipt_validator_implemented: false,
        replay_enforcement_implemented: false, promotion_available: false,
        activation_available: false, metadata_only: true, persists: false,
        trains: false, promotes: false, activates: false, authorizes_action: false };
}

export PROFILE_FORMAT, OBSERVATION_FORMAT, DURABLE_PLAN_FORMAT, PROPOSAL_FORMAT;
export SCHEMA_VERSION, POLICY_VERSION;
export learning_profile, validate_profile, working_observation_plan, durable_learning_plan, status;
