// stdlib/pbai_migration_policy.sapp
//
// Pure advisory triage for privacy-safe source-catalog observations. This
// module never opens candidate content, executes discovered code, persists,
// trains, publishes, or grants a conversion capability.

let CATALOG = (try import("pbai_source_catalog.sapp") catch import("editors/ide/tools/ai/core/pbai_source_catalog.sapp"));
let BOUNDED = import("stdlib:validate.sapp");

let FORMAT = "pbai.migration-policy.v1";
let MAX_ENTRIES = 512;
let MAX_OUTPUT_BYTES = 262144;

let INPUT_BOUNDS = map{
    max_depth: 4, max_nodes: 49152, max_map_entries: 8, max_array_items: 4096,
    max_string_chars: 4096, max_string_bytes: 4096,
    max_total_string_bytes: 2097152, max_key_chars: 64, max_key_bytes: 64
};
let CATALOG_BOUNDS = map{
    max_depth: 6, max_nodes: 65536, max_map_entries: 32, max_array_items: 4096,
    max_string_chars: 4096, max_string_bytes: 4096,
    max_total_string_bytes: 2097152, max_key_chars: 64, max_key_bytes: 64
};
let OPTIONS_BOUNDS = map{
    max_depth: 2, max_nodes: 12, max_map_entries: 2, max_array_items: 2,
    max_string_chars: 32, max_string_bytes: 32,
    max_total_string_bytes: 256, max_key_chars: 32, max_key_bytes: 32
};

fn _base(ok, reason) {
    return map{
        format:FORMAT, policy_version:"pbai-migration-policy-2026-08-28-v1",
        ok:ok, complete:false, reason:reason, plan_id:"", catalog_scan_id:"",
        catalog_format:"pbai.source-catalog.v2", input_authenticated:false,
        descriptor_binding_verified:false, publisher_attestation:false,
        advisory_only:true, entries:[], counts:map{}, output_truncated:false,
        content_read:false, executes:false, persists:false, training_performed:false,
        publication_authorized:false, authorizes_action:false,
        authorizes_conversion:false, authorizes_ingest:false,
        authorizes_retrieval:false, authorizes_training:false,
        auto_conversion:false, human_review_required:true, clean_room_required:true
    };
}

fn _fail(reason) { return _base(false, reason); }

fn _exact(value, keys, bounds = nil) {
    let report = BOUNDED.exact_map_bounded(value, keys, bounds);
    return report.ok;
}

fn _integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}

fn _limits(options) {
    if options == nil { options = map{}; }
    if not BOUNDED.inspect_bounded(options, OPTIONS_BOUNDS).ok {
        return map{ ok:false };
    }
    let keys = map_keys(options);
    let i = 0;
    while i < len(keys) {
        if keys[i] != "max_entries" and keys[i] != "max_output_bytes" {
            return map{ ok:false };
        }
        i = i + 1;
    }
    let maximum = try options.max_entries catch 128;
    let output = try options.max_output_bytes catch 131072;
    return map{ ok:_integer(maximum, 1, MAX_ENTRIES)
            and _integer(output, 4096, MAX_OUTPUT_BYTES),
        max_entries:maximum, max_output_bytes:output };
}

fn _root_shape(value) {
    return _exact(value, ["root_id", "locator", "owner_scope", "consent_status",
        "consent_scope", "discovery_grant_id", "discovery_allowed"], INPUT_BOUNDS);
}

fn _observation_shape(value) {
    return _exact(value, ["root_id", "relative_locator", "kind", "size_bytes",
        "depth", "metadata_evidence"], INPUT_BOUNDS);
}

fn _inputs(root_manifests, observations) {
    if not BOUNDED.inspect_bounded(root_manifests, INPUT_BOUNDS).ok
        or not BOUNDED.inspect_bounded(observations, INPUT_BOUNDS).ok
        or type(root_manifests) != "array" or type(observations) != "array" {
        return false;
    }
    let i = 0;
    while i < len(root_manifests) {
        if not _root_shape(root_manifests[i]) { return false; }
        i = i + 1;
    }
    i = 0;
    while i < len(observations) {
        if not _observation_shape(observations[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn _hex(value, count) {
    if type(value) != "string" or len(value) != count { return false; }
    let i = 0;
    while i < count {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

fn _source_id(value) {
    return type(value) == "string" and str_starts_with(value, "src-")
        and _hex(str_slice(value, 4, len(value)), 24);
}

fn _scan_id(value) {
    return type(value) == "string" and str_starts_with(value, "scan-")
        and _hex(str_slice(value, 5, len(value)), 24);
}

fn _contains(values, wanted) {
    let i = 0;
    while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _candidate_shape(row) {
    return _exact(row, ["source_id", "candidate_token", "kind", "media_family",
        "size_bucket", "depth", "signals", "metadata_evidence",
        "metadata_claim_validated", "descriptor_binding_verified", "signal_strength",
        "migration_class", "classification_evidence", "excluded_from_migration",
        "automatic_conversion", "human_review_required", "locator_dedupe_status",
        "content_copy_dedupe_status", "discovery_only", "content_read", "persisted",
        "authorizes_ingest", "authorizes_retrieval", "authorizes_training"], CATALOG_BOUNDS);
}

fn _catalog_root_shape(row) {
    return _exact(row, ["source_id", "root_token", "discovery_allowed",
        "discovery_only", "authorizes_ingest", "authorizes_retrieval",
        "authorizes_training", "reasons"], CATALOG_BOUNDS);
}

fn _catalog_shape(value) {
    return _exact(value, ["format", "scan_id", "ok", "complete", "errors",
        "roots", "candidates", "accepted_roots", "rejected_roots",
        "observations_seen", "malformed_observations", "non_candidate_observations",
        "rejected_observations", "duplicate_locators_suppressed", "output_truncated",
        "roots_truncated", "output_fit_strategy", "discovery_only", "content_read",
        "training_performed", "persisted", "admission_attempted", "authorizes_ingest",
        "authorizes_retrieval", "authorizes_training"], CATALOG_BOUNDS);
}

fn _action(row) {
    let class = row.migration_class;
    if class == "vendor" or class == "generated" or class == "archive" {
        return map{ rank:5, action:"exclude-generated-or-duplicate-tree",
            gate:"operator-confirms-source-of-truth", review:"quarantine" };
    }
    if class == "dataset" {
        return map{ rank:4, action:"queue-dataset-policy-review",
            gate:"rights-consent-privacy-poisoning-dedupe-split", review:"dataset" };
    }
    if class == "implementation" {
        if _contains(row.signals, "pblang") {
            return map{ rank:0, action:"review-existing-pblang-implementation",
                gate:"owning-module-tests-and-current-artifact", review:"native-pblang" };
        }
        return map{ rank:1, action:"inspect-behavior-then-clean-room-reimplement",
            gate:"human-language-identification-contract-and-tests", review:"clean-room-code" };
    }
    if class == "idea" {
        return map{ rank:2, action:"write-pblang-contract-and-exit-test",
            gate:"human-validates-intent-and-current-vs-roadmap", review:"idea" };
    }
    if class == "reference" {
        return map{ rank:3, action:"review-reference-behavior-only",
            gate:"provenance-and-non-copying-review", review:"reference" };
    }
    return map{ rank:6, action:"manual-triage",
        gate:"insufficient-authenticated-metadata", review:"unknown" };
}

fn _entry(row) {
    let action = _action(row);
    return map{
        candidate_token:row.candidate_token, source_id:row.source_id,
        migration_class:row.migration_class,
        classification_evidence:row.classification_evidence,
        recommended_action:action.action, required_gate:action.gate,
        review_queue:action.review, priority_rank:action.rank,
        input_authenticated:false, conversion_eligible:false,
        excluded_from_migration:row.excluded_from_migration,
        advisory_only:true, content_read:false, executes:false, persists:false,
        publication_authorized:false, authorizes_action:false,
        authorizes_conversion:false, authorizes_ingest:false,
        authorizes_retrieval:false, authorizes_training:false,
        auto_conversion:false, human_review_required:true, clean_room_required:true
    };
}

fn _increment(counts, key) {
    counts[key] = (try counts[key] catch 0) + 1;
}

fn _fit(result, maximum) {
    if len(str_to_bytes(json_stringify(result))) <= maximum { return result; }
    result.complete = false;
    result.output_truncated = true;
    result.reason = "output-cap-reached";
    let all = result.entries;
    let low = 0;
    let high = len(all);
    while low < high {
        let mid = num_floor((low + high + 1) / 2);
        result.entries = array_take(all, mid);
        if len(str_to_bytes(json_stringify(result))) <= maximum { low = mid; }
        else { high = mid - 1; }
    }
    result.entries = array_take(all, low);
    if len(str_to_bytes(json_stringify(result))) <= maximum { return result; }
    return _fail("output-cap-reached");
}

fn plan_observations(root_manifests, observations, options = nil) {
    let limits = _limits(options);
    if not limits.ok { return _fail("invalid-options"); }
    if not _inputs(root_manifests, observations) { return _fail("invalid-bounded-input"); }
    let catalog = CATALOG.catalog_observations(root_manifests, observations, map{
        max_observations:if len(observations) < 1 { 1 } else { len(observations) },
        max_candidates:limits.max_entries,
        max_output_bytes:MAX_OUTPUT_BYTES
    });
    if not _catalog_shape(catalog) or not (try catalog.ok catch false)
        or not (try catalog.complete catch false)
        or (try catalog.output_truncated catch true) or (try catalog.roots_truncated catch true)
        or len(try catalog.errors catch ["invalid"]) != 0
        or not _scan_id(try catalog.scan_id catch "") {
        return _fail("catalog-incomplete-or-untrusted");
    }
    let accepted_sources = map{};
    let i = 0;
    while i < len(catalog.roots) {
        let source_id = try catalog.roots[i].source_id catch "";
        if not _catalog_root_shape(catalog.roots[i]) or not _source_id(source_id)
            or map_has(accepted_sources, source_id)
            or catalog.roots[i].discovery_allowed != true
            or catalog.roots[i].discovery_only != true
            or catalog.roots[i].authorizes_ingest != false
            or catalog.roots[i].authorizes_retrieval != false
            or catalog.roots[i].authorizes_training != false
            or len(catalog.roots[i].reasons) != 0 {
            return _fail("invalid-or-duplicate-source-reference");
        }
        accepted_sources[source_id] = true;
        i = i + 1;
    }
    let keyed = map{};
    let keys = [];
    let seen = map{};
    let counts = map{};
    i = 0;
    while i < len(catalog.candidates) {
        let row = catalog.candidates[i];
        if not _candidate_shape(row) or not _source_id(row.source_id)
            or not map_has(accepted_sources, row.source_id)
            or not _hex(row.candidate_token, 64) or map_has(seen, row.candidate_token)
            or row.discovery_only != true or row.content_read != false
            or row.persisted != false or row.authorizes_ingest != false
            or row.authorizes_retrieval != false or row.authorizes_training != false
            or row.automatic_conversion != false or row.human_review_required != true {
            return _fail("invalid-catalog-candidate");
        }
        let entry = _entry(row);
        let key = str(entry.priority_rank) + "|" + row.candidate_token;
        keyed[key] = entry; push(keys, key); seen[row.candidate_token] = true;
        _increment(counts, row.migration_class);
        i = i + 1;
    }
    keys = array_sort(keys);
    let entries = [];
    i = 0;
    while i < len(keys) { push(entries, keyed[keys[i]]); i = i + 1; }
    let result = _base(true, "advisory-plan-ready");
    result.complete = true;
    result.plan_id = "plan-" + str_slice(sha256(base64_encode_bytes(random_bytes(32))), 0, 24);
    result.catalog_scan_id = catalog.scan_id;
    result.entries = entries;
    result.counts = counts;
    return _fit(result, limits.max_output_bytes);
}

fn status() {
    let out = _base(true, "status");
    out.format = "pbai.migration-policy.status.v1";
    out.implementation_language = "pblang";
    out.catalog_classification_only = true;
    out.exact_input_schemas = true;
    out.pre_traversal_bounded_guard = true;
    out.caller_categories_trusted = false;
    out.catalog_authenticated = false;
    out.remote_exposure_ready = false;
    return out;
}

export FORMAT, MAX_ENTRIES, MAX_OUTPUT_BYTES, plan_observations, status;
