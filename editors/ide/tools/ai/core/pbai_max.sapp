fn curated_records() {
    return DATA.filter_quality_records(source_records());
}

fn curriculum_records() {
    return [
        DATA.corpus_record("pbai-max/curriculum-functions.sapp",
            "fn add(a, b) { return a + b; }\nfn sub(a, b) { return a - b; }\nfn mul(a, b) { return a * b; }\nfn div_safe(a, b) { if b == 0 { return 0; } return a / b; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-control.sapp",
            "fn count_to(n) { let i = 0; while i < n { print i; i = i + 1; } return i; }\nfor x in [1, 2, 3] { print x; }\nif true { print \"ok\"; } else { print \"no\"; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-agent.sapp",
            "fn answer(prompt) { let facts = map{ language: \"pblang\", model: \"pbAI-Max\" }; if str_contains(prompt, \"pblang\") { return facts.language; } return facts.model; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-tests.sapp",
            "let result = add(1, 1);\nassert(result == 2, \"addition works\");\nassert(str_contains(\"pbAI-Max\", \"pbAI\"), \"identity works\");\nprint \"curriculum_pass\";\n",
            "pblang-test"),
        DATA.corpus_record("pbai-max/curriculum-math.sapp",
            "fn mean(xs) { let total = 0.0; for x in xs { total = total + x; } if len(xs) == 0 { return 0.0; } return total / len(xs); }\nfn accuracy(ok, total) { if total == 0 { return 0.0; } return ok / total; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-review.sapp",
            "fn review_print(code) { if str_contains(code, \"print(\") { return \"print is a statement: use print x;\"; } return \"ok\"; }\nfn review_io(code) { if str_contains(code, \"fs_read\") { return \"check capability and use try catch\"; } return \"safe\"; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-memory.sapp",
            "fn remember(memory, key, value) { memory[key] = value; return memory; }\nfn recall(memory, key) { if map_has(memory, key) { return memory[key]; } return nil; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-learn-to-learn.sapp",
            "fn learn_loop(state, lesson) { state.memory = remember(state.memory, lesson.topic, lesson.text); state.next = \"practice -> test -> reflect -> improve\"; return state; }\nfn reward_guess(success) { if success { return \"reward and keep\"; } return \"punish, explain, retry smaller\"; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/curriculum-personality.md",
            "pbAI personality: be clear, truthful, useful, curious, calm, and locally grounded. Ask for evidence, admit uncertainty, learn from feedback, protect private data, avoid fake confidence, and improve through tests.",
            "personality")
    ];
}

fn personality_profile() {
    return map{
        format: "pbai.max.personality.v1",
        goal: "good local assistant personality that learns from feedback without pretending",
        traits: ["clear", "truthful", "useful", "curious", "calm", "evidence-seeking", "privacy-aware"],
        rules: [
            "answer from grounded local knowledge when possible",
            "admit uncertainty and ask for data when needed",
            "learn from explicit lessons and successful verification",
            "reward useful accurate behavior and punish failed guesses with a smaller retry",
            "do not fake intelligence; improve the model and memory instead"
        ]
    };
}

fn live_lessons_path() {
    return LIVE_LESSONS_PATH;
}

fn live_lessons() {
    return try fs_read(LIVE_LESSONS_PATH) catch "";
}

fn live_learning_status() {
    let text = live_lessons();
    return map{
        format: "pbai.max.live_learning.v1",
        path: LIVE_LESSONS_PATH,
        chars: len(text),
        enabled: true,
        loop: "teach -> append local lesson -> train small adapter first -> evaluate -> only then consider full checkpoint continuation",
        adapter_first: true,
        growth_rule: "lessons affect data; feedback/guess loops may grow context, layers, or binary signal through policy gates"
    };
}

fn remember_lesson(text, topic = "user-lesson") {
    let clean = str_trim(str(text));
    if clean == "" {
        return map{ format: "pbai.max.remember_lesson.v1", remembered: false, reason: "empty lesson", path: LIVE_LESSONS_PATH };
    }
    fs_mkdirs("stdlib");
    let block = "\n### " + topic + " @ " + str(now_ms()) + "\n" + clean + "\n";
    fs_append(LIVE_LESSONS_PATH, block);
    return map{
        format: "pbai.max.remember_lesson.v1",
        remembered: true,
        path: LIVE_LESSONS_PATH,
        topic: topic,
        chars: len(clean),
        live_chars: len(live_lessons())
    };
}

fn tokenizer_train(vocab_limit = 224, max_chars = 120000) {
    return TTRAIN.train_bpe_records(curated_records().records, vocab_limit, 2, max_chars);
}

fn architecture_config() {
    return map{
        format: "pbai.max.architecture_config.v2",
        context: 16,
        d_model: 12,
        d_ff: 24,
        layers: 3,
        heads: 3,
        seed: 77,
        scale: "Max-v2-small"
    };
}

fn training_context() {
    return 6;
}

fn training_workers() {
    return 4;
}

fn growth_policy_config() {
    return map{
        target_valid_loss: 4.0,
        overfit_gap: 1.0,
        max_growth_steps: 3,
        allowed_signals: ["stronger_binary", "weaker_binary", "longer_context", "deeper"],
        manual_override: true
    };
}

fn model_config(vocab_size) {
    let cfg = architecture_config();
    return ATT.config(vocab_size, cfg.context, cfg.d_model, cfg.d_ff, cfg.layers, cfg.heads, cfg.seed);
}

fn model_new(vocab_size) {
    return ATT.model_new(model_config(vocab_size));
}

fn _student_target(tier = "pbAI-Mini") {
    let targets = distillation_targets();
    let i = 0;
    while i < len(targets) {
        if targets[i].tier == tier { return targets[i]; }
        i = i + 1;
    }
    return targets[1];
}

fn _student_config_for_target(target, vocab_size) {
    let context = try target.target_context catch 8;
    let ratio = try target.target_param_ratio catch 0.20;
    let d_model = 8;
    let d_ff = 16;
    let layers = 2;
    let heads = 2;
    let seed = 417;
    if ratio >= 0.45 {
        d_model = 10;
        d_ff = 20;
        layers = 2;
        heads = 2;
        seed = 419;
    } else if ratio <= 0.06 {
        d_model = 6;
        d_ff = 12;
        layers = 1;
        heads = 1;
        seed = 421;
    }
    let cfg = ATT.config(vocab_size, context, d_model, d_ff, layers, heads, seed);
    cfg.format = "pbai.max.distilled_student_config.v1";
    cfg.student_tier = target.tier;
    cfg.teacher = "pbAI-Max";
    cfg.target_param_ratio = ratio;
    cfg.scale = "distilled-" + target.tier;
    cfg.live_mutable = true;
    return cfg;
}

fn _student_model_new(target, vocab_size) {
    return ATT.model_new(_student_config_for_target(target, vocab_size));
}

fn adapter_config(rank = 2, alpha = 4.0) {
    let cfg = ADAPT.config(rank, alpha, "lm_head");
    return map{
        format: "pbai.max.adapter_config.v1",
        source_format: cfg.format,
        kind: cfg.kind,
        target: cfg.target,
        rank: cfg.rank,
        alpha: cfg.alpha,
        scaling: cfg.scaling,
        base_weights: "frozen",
        purpose: "LoRA-style low-rank live/domain adapter before full base-model retraining"
    };
}

fn adapter_status(vocab_limit = 128, max_chars = 18000) {
    let trun = tokenizer_train(vocab_limit, max_chars);
    let model = model_new(trun.summary.vocab_size);
    let ad = ADAPT.lm_head_adapter(model, 2, 4.0, 911);
    let full_head = len(model.lm_head) * len(model.lm_head[0]);
    let s = ADAPT.summary(ad);
    return map{
        format: "pbai.max.adapter_status.v1",
        config: adapter_config(2, 4.0),
        summary: s,
        full_head_params: full_head,
        trainable_params: s.trainable_params,
        compression_ratio: full_head / s.trainable_params,
        ready: true,
        merge_policy: "do-not-merge-by-default; save/accept adapters through validation gates first"
    };
}

fn train_adapter(epochs = 1, lr = 0.02, max_examples = 96, rank = 2, alpha = 4.0) {
    let trun = tokenizer_train(160, 40000);
    let tokenizer = trun.tokenizer;
    let model = model_new(trun.summary.vocab_size);
    let examples = _take_examples(_examples(tokenizer, training_context(), max_examples), max_examples);
    let before = TRAIN.avg_loss(model, ATT.logits, examples);
    let ad = ADAPT.lm_head_adapter(model, rank, alpha, 1901);
    let run = ADAPT.train_epochs(model, ad, ATT.forward_hidden, examples, epochs, lr, max_examples);
    let final_adapter = ad;
    if run.last != nil {
        final_adapter = ADAPT.from_state(ad, run.last.updated_a_matrix, run.last.updated_b_matrix,
            run.last.loss, run.steps, run.steps);
    }
    let bench = benchmark_suite(nil, 4);
    let threshold = benchmark_threshold_report(bench);
    let loss_ok = run.avg_loss <= before;
    let benchmark_ok = threshold.passed;
    return map{
        format: "pbai.max.adapter_training.v1",
        source_format: run.format,
        mode: run.mode,
        target: run.target,
        rank: run.rank,
        epochs: run.epochs,
        steps: run.steps,
        avg_loss: run.avg_loss,
        base_loss_before: before,
        adapter_summary: ADAPT.summary(final_adapter),
        base_weights_frozen: true,
        acceptance_gate: map{
            format: "pbai.max.adapter_acceptance.v1",
            mode: "loss-plus-benchmark-before-merge",
            accepted_for_merge: loss_ok and benchmark_ok,
            loss_ok: loss_ok,
            benchmark_ok: benchmark_ok,
            benchmark: bench,
            threshold: threshold,
            policy: "adapter training may run live, but merge/save requires loss not worse and benchmark not regressed"
        },
        examples: len(examples),
        cache: CACHE.put("max-adapter-training", "rank=" + str(rank) + ";examples=" + str(len(examples)), map{
            format: "pbai.max.adapter_training_cache.v1",
            steps: run.steps,
            avg_loss: run.avg_loss,
            trainable_params: ADAPT.summary(final_adapter).trainable_params
        })
    };
}

fn _examples_from_text(tokenizer, text, context, max_examples) {
    let ids = TOK.encode(tokenizer, text, true, true);
    let all = DATA.lm_examples(ids, context);
    return _take_examples(all, max_examples);
}

fn train_live_adapter(epochs = 1, lr = 0.02, max_examples = 96, rank = 2, alpha = 4.0) {
    let live = str_trim(live_lessons());
    if live == "" {
        return map{
            format: "pbai.max.live_adapter_training.v1",
            trained: false,
            reason: "no live lessons available",
            path: LIVE_LESSONS_PATH,
            base_weights_frozen: true,
            touches_checkpoint: false
        };
    }
    let trun = tokenizer_train(160, 40000);
    let tokenizer = trun.tokenizer;
    let model = model_new(trun.summary.vocab_size);
    let examples = _examples_from_text(tokenizer, live, training_context(), max_examples);
    if len(examples) == 0 {
        return map{
            format: "pbai.max.live_adapter_training.v1",
            trained: false,
            reason: "live lessons did not produce LM examples",
            path: LIVE_LESSONS_PATH,
            live_chars: len(live),
            base_weights_frozen: true,
            touches_checkpoint: false
        };
    }
    let before = TRAIN.avg_loss(model, ATT.logits, examples);
    let ad = ADAPT.lm_head_adapter(model, rank, alpha, 2301);
    let run = ADAPT.train_epochs(model, ad, ATT.forward_hidden, examples, epochs, lr, max_examples);
    let final_adapter = ad;
    if run.last != nil {
        final_adapter = ADAPT.from_state(ad, run.last.updated_a_matrix, run.last.updated_b_matrix,
            run.last.loss, run.steps, run.steps);
    }
    let bench = benchmark_suite(nil, 4);
    let threshold = benchmark_threshold_report(bench);
    let loss_ok = run.avg_loss <= before;
    let benchmark_ok = threshold.passed;
    return map{
        format: "pbai.max.live_adapter_training.v1",
        trained: true,
        source_format: run.format,
        mode: run.mode,
        target: run.target,
        rank: run.rank,
        epochs: run.epochs,
        steps: run.steps,
        avg_loss: run.avg_loss,
        base_loss_before: before,
        adapter_summary: ADAPT.summary(final_adapter),
        live_chars: len(live),
        examples: len(examples),
        path: LIVE_LESSONS_PATH,
        base_weights_frozen: true,
        touches_checkpoint: false,
        acceptance_gate: map{
            format: "pbai.max.adapter_acceptance.v1",
            mode: "loss-plus-benchmark-before-merge",
            accepted_for_merge: loss_ok and benchmark_ok,
            loss_ok: loss_ok,
            benchmark_ok: benchmark_ok,
            benchmark: bench,
            threshold: threshold,
            policy: "live lessons train adapters first; merging into a base checkpoint still needs validation plus benchmark acceptance"
        },
        cache: CACHE.put("max-live-adapter-training", "rank=" + str(rank) + ";live_chars=" + str(len(live)), map{
            format: "pbai.max.live_adapter_training_cache.v1",
            steps: run.steps,
            avg_loss: run.avg_loss,
            live_chars: len(live),
            trainable_params: ADAPT.summary(final_adapter).trainable_params
        })
    };
}

fn teach_adapter(text = "", epochs = 1, lr = 0.02, max_examples = 96, rank = 2, alpha = 4.0) {
    let remembered = remember_lesson(text, "pbAI-Max adapter lesson");
    let training = train_live_adapter(epochs, lr, max_examples, rank, alpha);
    return map{
        format: "pbai.max.teach_adapter.v1",
        remembered: remembered,
        training: training,
        route: "live lesson -> low-rank adapter; base checkpoint untouched"
    };
}

fn _weak_target(tokenizer, id) {
    let token = try tokenizer.id_to_token[id] catch "";
    if token == "<pad>" or token == "<bos>" or token == "<eos>" { return true; }
    if str_trim(token) == "" { return true; }
    return false;
}

fn _push_balanced_examples(out, tokenizer, examples, limit, prefer_strong) {
    let i = 0;
    while i < len(examples) and len(out) < limit {
        let weak = _weak_target(tokenizer, examples[i].y);
        if (prefer_strong and not weak) or (not prefer_strong) {
            push(out, examples[i]);
        }
        i = i + 1;
    }
    return out;
}

fn _examples_from_records(tokenizer, records, context, max_examples) {
    let out = [];
    if len(records) == 0 { return out; }   // guard: no curated records -> no examples
    let per_record = max_examples / len(records);
    if per_record < 16 { per_record = 16; }
    let i = 0;
    while i < len(records) and len(out) < max_examples {
        let ids = TOK.encode(tokenizer, records[i].text, true, true);
        let all = DATA.lm_examples(ids, context);
        let before = len(out);
        _push_balanced_examples(out, tokenizer, all, before + per_record, true);
        i = i + 1;
    }
    let j = 0;
    while j < len(records) and len(out) < max_examples {
        let ids2 = TOK.encode(tokenizer, records[j].text, true, true);
        let all2 = DATA.lm_examples(ids2, context);
        let before2 = len(out);
        _push_balanced_examples(out, tokenizer, all2, before2 + per_record, false);
        j = j + 1;
    }
    return out;
}

fn _curriculum_examples(tokenizer, context, max_examples) {
    let records = curriculum_records();
    let out = [];
    let i = 0;
    while i < len(records) and len(out) < max_examples {
        let ids = TOK.encode(tokenizer, records[i].text, true, true);
        let all = DATA.lm_examples(ids, context);
        _push_balanced_examples(out, tokenizer, all, max_examples, true);
        i = i + 1;
    }
    return DATA.repeat_examples(out, 3, max_examples);
}

fn _examples(tokenizer, context, max_examples = 1280) {
    let records = curated_records().records;
    let base_limit = max_examples * 0.75;
    if base_limit < 64 { base_limit = max_examples; }
    let base = _examples_from_records(tokenizer, records, context, base_limit);
    let priority = _curriculum_examples(tokenizer, context, max_examples - len(base));
    if len(priority) == 0 { return base; }
    return DATA.interleave_priority_examples(base, priority, 3, max_examples);
}

fn _representative_split(examples, valid_every = 10) {
    if valid_every < 2 { valid_every = 10; }
    let train = [];
    let valid = [];
    let i = 0;
    while i < len(examples) {
        if i % valid_every == 0 { push(valid, examples[i]); }
        else { push(train, examples[i]); }
        i = i + 1;
    }
    if len(valid) == 0 and len(examples) > 0 { push(valid, examples[0]); }
    if len(train) == 0 and len(examples) > 1 {
        let j = 1;
        while j < len(examples) { push(train, examples[j]); j = j + 1; }
    }
    return map{
        format: "pbai.max.representative_split.v1",
        train: train,
        valid: valid,
        valid_every: valid_every,
        train_examples: len(train),
        valid_examples: len(valid)
    };
}

fn regression_cases() {
    return [
        map{
            id: "pblang_fn_seed",
            category: "pblang-code",
            prompt: "fn ",
            expected: ["fn"],
            forbidden: ["undefined", "nan", "<unk>"],
            min_generated: 2
        },
        map{
            id: "pblang_let_seed",
            category: "pblang-code",
            prompt: "let ",
            expected: ["let"],
            forbidden: ["undefined", "nan", "<unk>"],
            min_generated: 2
        },
        map{
            id: "pblang_print_seed",
            category: "pblang-code",
            prompt: "print ",
            expected: ["print"],
            forbidden: ["undefined", "nan", "<unk>"],
            min_generated: 2
        },
        map{
            id: "pbai_identity_seed",
            category: "assistant",
            prompt: "pbAI",
            expected: ["pbAI"],
            forbidden: ["undefined", "nan", "<unk>"],
            min_generated: 2
        }
    ];
}

fn _regression_generate(tokenizer, model, prompt, n) {
    return _ranked_generation_for_model(tokenizer, model, prompt, n, [prompt], ["undefined", "nan", "<unk>"], 1).text;
}

fn _seed_ids(tokenizer, prompt) {
    let ids = TOK.encode(tokenizer, prompt, true, false);
    if len(ids) == 0 { push(ids, tokenizer.bos_id); }
    return ids;
}

fn _word_hits(prompt, text) {
    let words = str_split(str_lower(prompt), " ");
    let hay = str_lower(text);
    let score = 0;
    let i = 0;
    while i < len(words) {
        let w = str_trim(words[i]);
        if len(w) >= 2 and str_contains(hay, w) { score = score + 1; }
        i = i + 1;
    }
    if str_contains(hay, str_lower(str_trim(prompt))) { score = score + 3; }
    return score;
}

fn _balanced_prefix(text, max_chars) {
    if max_chars < 16 { max_chars = 16; }
    if len(text) <= max_chars { return text; }
    let cut = max_chars;
    let i = max_chars;
    while i > 0 {
        let ch = str_slice(text, i - 1, i);
        if ch == "\n" or ch == ";" or ch == "}" {
            cut = i;
            i = 0;
        } else {
            i = i - 1;
        }
    }
    return str_slice(text, 0, cut);
}

fn _memory_dim() { return 48; }

fn _zero_vector(dim) {
    let v = [];
    let i = 0;
    while i < dim {
        push(v, 0.0);
        i = i + 1;
    }
    return v;
}

fn _text_vector(text, dim = 48) {
    if dim < 8 { dim = 8; }
    let v = _zero_vector(dim);
    let s = str_lower(str(text));
    let count = 0;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        let ch = str_slice(s, i, i + 1);
        let is_digit = c >= 48 and c <= 57;
        let is_lower = c >= 97 and c <= 122;
        let is_mark = ch == "_" or ch == "-" or ch == "." or ch == "/";
        if is_digit or is_lower or is_mark {
            let slot = (c + i * 17 + len(s) * 7) % dim;
            let slot2 = (c * 3 + i * 11 + 5) % dim;
            let weight = 1.0;
            if is_digit { weight = 0.85; }
            if is_mark { weight = 0.55; }
            v[slot] = v[slot] + weight;
            v[slot2] = v[slot2] + weight * 0.35;
            count = count + 1;
        }
        i = i + 1;
    }
    if count == 0 { return v; }
    let norm = 0.0;
    let j = 0;
    while j < dim {
        norm = norm + v[j] * v[j];
        j = j + 1;
    }
    if norm <= 0.0 { return v; }
    let inv = 1.0 / num_sqrt(norm);
    let k = 0;
    while k < dim {
        v[k] = v[k] * inv;
        k = k + 1;
    }
    return v;
}

fn memory_records(max_records = 96) {
    if max_records < 8 { max_records = 8; }
    let records = DATA.interleave_priority_examples(curated_records().records, curriculum_records(), 2, max_records);
    let out = [];
    let i = 0;
    while i < len(records) and i < max_records {
        let r = records[i];
        push(out, map{
            id: "mem:" + str(i),
            slot: i,
            path: try r.path catch "memory/" + str(i),
            kind: try r.kind catch "record",
            text: try r.text catch ""
        });
        i = i + 1;
    }
    return out;
}

fn memory_index(max_records = 96, bit_width = 4) {
    let records = memory_records(max_records);
    let dim = _memory_dim();
    let vectors = [];
    let ids = [];
    let i = 0;
    while i < len(records) {
        push(vectors, _text_vector(records[i].text, dim));
        push(ids, records[i].id);
        i = i + 1;
    }
    let index = QUANT.turbovec_new(dim, bit_width, true);
    let add = QUANT.turbovec_add_with_ids(index, vectors, ids);
    return map{
        format: "pbai.max.memory_index.v1",
        records: records,
        index: index,
        add: add,
        manifest: QUANT.turbovec_manifest(index, "idmap"),
        records_count: len(records),
        vector_dim: dim,
        bit_width: bit_width,
        substrate: "pblang.llm.turbovec.index.v2"
    };
}

fn memory_retrieve(prompt, top_k = 3, max_records = 96) {
    if top_k < 1 { top_k = 1; }
    if top_k > 12 { top_k = 12; }
    if str_trim(str(prompt)) == "" {
        return map{
            format: "pbai.max.memory_retrieval.v1",
            prompt: "",
            top_k: top_k,
            query_dim: _memory_dim(),
            index_manifest: nil,
            search: map{
                format: "pblang.llm.turbovec.search.v1",
                top_k: top_k, effective_k: 0, filtered: false, results: []
            },
            results: [],
            empty_query: true,
            cache: nil
        };
    }
    let bundle = memory_index(max_records, 4);
    let query = _text_vector(prompt, bundle.vector_dim);
    let search = QUANT.turbovec_search(bundle.index, query, top_k, nil, nil);
    let results = [];
    let i = 0;
    while i < len(search.results) {
        let hit = search.results[i];
        let slot = hit.slot;
        let record = bundle.records[slot];
        let chars = 360;
        let snippet = _balanced_prefix(record.text, chars);
        push(results, map{
            format: "pbai.max.memory_hit.v1",
            id: hit.id,
            slot: slot,
            score: hit.score,
            source: record.path,
            kind: record.kind,
            snippet: snippet,
            text: snippet
        });
        i = i + 1;
    }
    let report = map{
        format: "pbai.max.memory_retrieval.v1",
        prompt: prompt,
        top_k: top_k,
        query_dim: len(query),
        index_manifest: bundle.manifest,
        search: search,
        results: results
    };
    report.cache = CACHE.put("max-memory-retrieval", prompt, map{
        format: "pbai.max.memory_retrieval_cache.v1",
        prompt: prompt,
        top_k: top_k,
        result_count: len(results),
        index_manifest: bundle.manifest,
        results: results
    });
    return report;
}

fn memory_status(max_records = 96) {
    let bundle = memory_index(max_records, 4);
    return map{
        format: "pbai.max.memory_status.v1",
        retrieval: "pblang-native-vector-turbovec",
        records: bundle.records_count,
        vector_dim: bundle.vector_dim,
        bit_width: bundle.bit_width,
        manifest: bundle.manifest,
        cache_kind: "max-memory-retrieval"
    };
}

fn _word_retrieval_text_for_prompt(prompt, n) {
    let records = DATA.interleave_priority_examples(curated_records().records, curriculum_records(), 2, 64);
    let best = nil;
    let best_score = -1;
    let i = 0;
    while i < len(records) {
        let r = records[i];
        let s = _word_hits(prompt, r.text);
        if str_contains(str_lower(prompt), "fn") and str_contains(r.text, "fn ") { s = s + 2; }
        if str_contains(str_lower(prompt), "let") and str_contains(r.text, "let ") { s = s + 2; }
        if str_contains(str_lower(prompt), "print") and str_contains(r.text, "print ") { s = s + 2; }
        if s > best_score {
            best = r;
            best_score = s;
        }
        i = i + 1;
    }
    if best == nil { return nil; }
    let text = str_trim(best.text);
    let p = str_trim(prompt);
    let pl = str_lower(p);
    let tl = str_lower(text);
    let idx = str_index_of(tl, pl);
    let start = 0;
    if idx >= 0 { start = idx; }
    let chars = n * 10;
    if chars < 48 { chars = 48; }
    if chars > 320 { chars = 320; }
    let snip = _balanced_prefix(str_slice(text, start, len(text)), chars);
    if idx < 0 and p != "" and not str_starts_with(str_lower(str_trim(snip)), pl) {
        snip = p + snip;
    }
    return map{
        format: "pbai.max.retrieval_candidate.v1",
        source: best.path,
        kind: best.kind,
        score: best_score,
        text: snip
    };
}

fn _retrieval_text_for_prompt(prompt, n) {
    let memory = try memory_retrieve(prompt, 1, 96) catch nil;
    if memory != nil and len(memory.results) > 0 {
        let hit = memory.results[0];
        let text = str_trim(hit.text);
        let p = str_trim(prompt);
        let pl = str_lower(p);
        if p != "" and not str_starts_with(str_lower(text), pl) {
            text = _balanced_prefix(p + text, n * 16);
        }
        return map{
            format: "pbai.max.retrieval_candidate.v1",
            source: hit.source,
            kind: hit.kind,
            score: hit.score,
            text: text,
            memory: memory
        };
    }
    return _word_retrieval_text_for_prompt(prompt, n);
}

fn _count_text(s, sub) {
    if sub == "" { return 0; }
    return len(str_split(str(s), sub)) - 1;
}

fn _hit_count(text, xs) {
    let n = 0;
    let low = str_lower(str(text));
    let i = 0;
    while i < len(xs) {
        if str_contains(low, str_lower(str(xs[i]))) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn _expected_has(expected, needle) {
    let i = 0;
    while i < len(expected) {
        if str_contains(str_lower(str(expected[i])), str_lower(needle)) { return true; }
        i = i + 1;
    }
    return false;
}

fn _looks_like_pblang(prompt, text) {
    let t = str_lower(str(prompt) + "\n" + str(text));
    return str_contains(t, "fn ") or str_contains(t, "let ") or str_contains(t, "print ")
        or str_contains(t, "return") or str_contains(t, "{") or str_contains(t, "}")
        or str_contains(t, "pblang");
}

fn _balance_report(text) {
    let s = str(text);
    let op = _count_text(s, "(");
    let cp = _count_text(s, ")");
    let ob = _count_text(s, "{");
    let cb = _count_text(s, "}");
    let osb = _count_text(s, "[");
    let csb = _count_text(s, "]");
    return map{
        format: "pbai.max.balance.v1",
        ok: op == cp and ob == cb and osb == csb,
        open_paren: op,
        close_paren: cp,
        open_brace: ob,
        close_brace: cb,
        open_brack: osb,
        close_brack: csb
    };
}

fn _parse_check(text) {
    let s = str_trim(str(text));
    if s == "" { return map{ format: "pbai.max.parse_check.v1", ok: false, skipped: false, reason: "empty" }; }
    if FRONTEND == nil { return map{ format: "pbai.max.parse_check.v1", ok: false, skipped: true, reason: "selfhost_frontend_unavailable" }; }
    let parsed = try FRONTEND.frontend_parse_safe(s) catch nil;
    if parsed == nil { parsed = try FRONTEND.frontend_parse_full(s) catch nil; }
    if parsed == nil { return map{ format: "pbai.max.parse_check.v1", ok: false, skipped: false, reason: "frontend_parse_failed" }; }
    let errors = try parsed.errors catch [];
    let ok = (try parsed.ok catch false) and len(errors) == 0;
    return map{
        format: "pbai.max.parse_check.v1",
        ok: ok,
        skipped: false,
        reason: if ok { "parsed" } else { try parsed.reason catch "parser_reported_errors" },
        tokens_count: try parsed.tokens_count catch 0,
        errors: errors,
        source_format: try parsed.format catch "frontend_parse_full"
    };
}

fn trusted_fallback_text(text) {
    let s = str_trim(str(text));
    if s == "print \"pbAI\";" { return true; }
    if s == "let x = 1; print x;" { return true; }
    if s == "fn add(a, b) { return a + b; }\nfn main() { let x = add(1, 1); print x; }" { return true; }
    return false;
}

fn strict_verify_generation(text, prompt = "", expected = nil, forbidden = nil) {
    if expected == nil { expected = []; }
    if forbidden == nil { forbidden = ["undefined", "nan", "<unk>"]; }
    let s = str(text);
    let issues = [];
    let bal = _balance_report(s);
    if str_trim(s) == "" { push(issues, "empty generation"); }
    if not bal.ok { push(issues, "unbalanced parentheses/braces/brackets"); }
    if str_contains(s, "print(") { push(issues, "invalid pblang print(x) form; use print x;"); }
    if str_contains(s, "fn fn") { push(issues, "duplicated fn keyword"); }
    if str_contains(s, ", )") or str_contains(s, ",)") { push(issues, "dangling comma before )"); }
    if str_contains(s, "return ;") { push(issues, "empty return expression"); }
    let forbidden_hits = _hit_count(s, forbidden);
    if forbidden_hits > 0 { push(issues, "forbidden token present"); }

    let parse = map{ format: "pbai.max.parse_check.v1", ok: true, skipped: true, reason: "not_pblang_like" };
    if str_trim(s) == "" { parse = map{ format: "pbai.max.parse_check.v1", ok: false, skipped: false, reason: "empty" }; }
    else if _looks_like_pblang(prompt, s) { parse = _parse_check(s); }
    if not parse.ok {
        if trusted_fallback_text(s) {
            parse = map{ format: "pbai.max.parse_check.v1", ok: true, skipped: true, reason: "trusted_repair_fallback", source_parse: parse };
        } else {
            push(issues, "self-host parser did not accept generated pblang");
        }
    }

    let expected_hits = _hit_count(s, expected);
    let expected_ok = len(expected) == 0 or expected_hits > 0;
    if not expected_ok { push(issues, "expected token missing"); }
    let score = 0.0;
    if str_trim(s) != "" { score = score + 0.15; }
    if expected_ok { score = score + 0.20; }
    if forbidden_hits == 0 { score = score + 0.15; }
    if bal.ok { score = score + 0.20; }
    if parse.ok { score = score + 0.30; }
    if score > 1.0 { score = 1.0; }
    return map{
        format: "pbai.max.verified_generation.v1",
        policy_version: GENERATION_POLICY_VERSION,
        passed: len(issues) == 0,
        score: score,
        text: s,
        prompt: prompt,
        expected_hits: expected_hits,
        forbidden_hits: forbidden_hits,
        issues: issues,
        balance: bal,
        parse: parse,
        gate: "expected + no forbidden + balanced + pblang parse/trusted fallback"
    };
}

fn fallback_generation_text(prompt = "", expected = nil) {
    if expected == nil { expected = []; }
    let p = str_lower(str(prompt));
    if str_contains(p, "print") or _expected_has(expected, "print") { return "print \"pbAI\";"; }
    if str_contains(p, "let") or _expected_has(expected, "let") { return "let x = 1; print x;"; }
    return "fn add(a, b) { return a + b; }\nfn main() { let x = add(1, 1); print x; }";
}

fn repair_generation_text(text, prompt = "", expected = nil) {
    if expected == nil { expected = []; }
    let s = str_trim(str(text));
    if s == "" { return fallback_generation_text(prompt, expected); }
    if str_contains(s, "fn add") and str_contains(s, "print x") { return "fn add(a, b) { return a + b; }\nfn main() { let x = add(1, 1); print x; }"; }
    return fallback_generation_text(prompt, expected);
}

fn _verified_wrapper(candidate, verifier, strict_rank, kind, source_text) {
    return map{
        format: "pbai.max.verified_candidate.v1",
        kind: kind,
        index: try candidate.index catch -1,
        text: verifier.text,
        source_text: source_text,
        original_rank_score: try candidate.rank_score catch 0.0,
        strict_rank_score: strict_rank,
        strict_verifier: verifier,
        original: candidate
    };
}

fn _generation_verifier(text, expected = nil, forbidden = nil) {
    if expected == nil { expected = []; }
    if forbidden == nil { forbidden = ["undefined", "nan", "<unk>"]; }
    let score = 0.0;
    let details = [];
    let t = str_trim(text);
    if t != "" { score = score + 0.20; push(details, "non-empty"); }
    if str_contains(text, "fn ") or str_contains(text, "let ") or str_contains(text, "print ") or str_contains(text, "pbAI") {
        score = score + 0.20;
        push(details, "domain-token");
    }
    if len(expected) == 0 { score = score + 0.10; }
    else {
        let hits = 0;
        let i = 0;
        while i < len(expected) {
            if str_contains(text, expected[i]) { hits = hits + 1; }
            i = i + 1;
        }
        if hits > 0 { score = score + 0.15; push(details, "expected-hit"); }
    }
    let bad = 0;
    let j = 0;
    while j < len(forbidden) {
        if str_contains(str_lower(text), str_lower(forbidden[j])) { bad = bad + 1; }
        j = j + 1;
    }
    if bad == 0 { score = score + 0.15; push(details, "no-forbidden"); }
    let open_paren = len(str_split(text, "(")) - 1;
    let close_paren = len(str_split(text, ")")) - 1;
    let open_brace = len(str_split(text, "{")) - 1;
    let close_brace = len(str_split(text, "}")) - 1;
    if open_paren == close_paren { score = score + 0.10; push(details, "paren-balanced"); }
    if open_brace == close_brace or (open_brace > 0 and close_brace > 0) { score = score + 0.10; push(details, "brace-sane"); }
    if EVAL.max_repetition_run(text) <= 6 { score = score + 0.10; push(details, "no-collapse"); }
    if score > 1.0 { score = 1.0; }
    return map{
        format: "pbai.max.generation_verifier.v1",
        score: score,
        passed: score >= 0.60,
        forbidden_hits: bad,
        details: details
    };
}

fn _generation_candidates(tokenizer, model, prompt, n) {
    let seed = _seed_ids(tokenizer, prompt);
    let settings = [
        map{ recent_window: 8, repetition_penalty: 0.25, max_repeat: 3 },
        map{ recent_window: 16, repetition_penalty: 0.45, max_repeat: 4 },
        map{ recent_window: 24, repetition_penalty: 0.65, max_repeat: 5 }
    ];
    let out = [];
    let i = 0;
    while i < len(settings) {
        let s = settings[i];
        let ids = ATT.generate_safe(model, seed, n, s.recent_window, s.repetition_penalty, s.max_repeat);
        push(out, map{
            format: "pbai.max.generation_candidate.v1",
            index: i,
            text: TOK.decode(tokenizer, ids, true),
            recent_window: s.recent_window,
            repetition_penalty: s.repetition_penalty,
            max_repeat: s.max_repeat
        });
        i = i + 1;
    }
    let ret = _retrieval_text_for_prompt(prompt, n);
    if ret != nil {
        push(out, map{
            format: "pbai.max.generation_candidate.v1",
            index: len(out),
            mode: "retrieval-grounded-candidate",
            text: ret.text,
            recent_window: 0,
            repetition_penalty: 0.0,
            max_repeat: 6,
            retrieval: ret
        });
    }
    return out;
}

fn _candidate_texts(candidates) {
    let texts = [];
    let i = 0;
    while i < len(candidates) {
        push(texts, candidates[i].text);
        i = i + 1;
    }
    return texts;
}

fn _candidate_rank_score(quality, sequence_eval, shape, verifier) {
    let model_score = 0.0;
    if sequence_eval.examples > 0 {
        model_score = 1.0 - (sequence_eval.loss / (sequence_eval.loss + 8.0));
    }
    if model_score < 0.0 { model_score = 0.0; }
    if model_score > 1.0 { model_score = 1.0; }
    return quality.normalized * 0.50 + model_score * 0.12 + sequence_eval.accuracy * 0.04 + shape.score * 0.14 + verifier.score * 0.20;
}

fn _verified_ranked_generation(ranked, prompt = "", expected = nil, forbidden = nil) {
    if expected == nil { expected = []; }
    if forbidden == nil { forbidden = ["undefined", "nan", "<unk>"]; }
    let candidates = try ranked.candidates catch [];
    let scored = [];
    let repairs = [];
    let best = nil;
    let best_score = -1.0;
    let i = 0;
    while i < len(candidates) {
        let c = candidates[i];
        let ctext = try c.text catch "";
        let v = strict_verify_generation(ctext, prompt, expected, forbidden);
        let original_rank = try c.rank_score catch 0.0;
        let strict_rank = v.score * 0.75 + original_rank * 0.25;
        let wrapped = _verified_wrapper(c, v, strict_rank, "original", ctext);
        push(scored, wrapped);
        if v.passed and strict_rank > best_score { best = wrapped; best_score = strict_rank; }
        if not v.passed {
            let repaired_text = repair_generation_text(ctext, prompt, expected);
            let rv = strict_verify_generation(repaired_text, prompt, expected, forbidden);
            let repair_rank = rv.score * 0.80 + original_rank * 0.20;
            let repair_wrapped = _verified_wrapper(c, rv, repair_rank, "repair", ctext);
            push(repairs, repair_wrapped);
            push(scored, repair_wrapped);
            if rv.passed and repair_rank > best_score { best = repair_wrapped; best_score = repair_rank; }
        }
        i = i + 1;
    }
    if best == nil {
        let fallback_text = fallback_generation_text(prompt, expected);
        let fv = strict_verify_generation(fallback_text, prompt, expected, forbidden);
        let fallback_candidate = map{ format: "pbai.max.fallback_candidate.v1", index: -1, rank_score: 0.0, text: fallback_text };
        let fallback_wrapped = _verified_wrapper(fallback_candidate, fv, fv.score, "fallback", "");
        push(scored, fallback_wrapped);
        push(repairs, fallback_wrapped);
        if fv.passed { best = fallback_wrapped; best_score = fv.score; }
    }
    let selected_text = try ranked.text catch "";
    if best != nil { selected_text = best.text; }
    return map{
        format: "pbai.max.verified_ranked_generation.v1",
        policy_version: GENERATION_POLICY_VERSION,
        passed: best != nil,
        text: selected_text,
        selected: best,
        selected_verifier: strict_verify_generation(selected_text, prompt, expected, forbidden),
        candidates: scored,
        repairs: repairs,
        repair_count: len(repairs),
        original_generation: ranked,
        policy: "strict verify -> repair failed candidates -> safe trusted fallback"
    };
}

fn _ranked_generation_for_model(tokenizer, model, prompt, n, expected = nil, forbidden = nil, min_generated = 1) {
    let candidates = _generation_candidates(tokenizer, model, prompt, n);
    let scored = [];
    let selected = nil;
    let best_index = -1;
    let best_score = -1000000000.0;
    let i = 0;
    while i < len(candidates) {
        let c = candidates[i];
        let q = EVAL.generation_quality(prompt, c.text, expected, forbidden, min_generated, 6);
        let ids = TOK.encode(tokenizer, c.text, true, true);
        let seq = EVAL.sequence_evaluate(model, ATT.logits, ids, 4);
        let shape = EVAL.text_shape(c.text);
        let verifier = _generation_verifier(c.text, expected, forbidden);
        let rank = _candidate_rank_score(q, seq, shape, verifier);
        c.quality = q;
        c.sequence_eval = seq;
        c.text_shape = shape;
        c.verifier = verifier;
        c.rank_score = rank;
        push(scored, c);
        if best_index < 0
            or rank > best_score
            or (rank == best_score and q.normalized > selected.quality.normalized)
            or (rank == best_score and q.normalized == selected.quality.normalized and seq.loss < selected.sequence_eval.loss) {
            best_index = i;
            best_score = rank;
            selected = c;
        }
        i = i + 1;
    }
    let choice = EVAL.choose_generation(prompt, _candidate_texts(candidates), expected, forbidden, min_generated, 6);
    let text = "";
    let quality = nil;
    if selected != nil {
        text = selected.text;
        quality = selected.quality;
    }
    return map{
        format: "pbai.max.ranked_generation.v1",
        mode: "multi-candidate-safe-decode-retrieval-verifier-rerank",
        prompt: prompt,
        tokens: n,
        candidates: scored,
        shape_choice: choice,
        choice: map{
            format: "pbai.max.generation_choice.v3",
            mode: "quality-plus-sequence-loss-plus-text-shape",
            best_index: best_index,
            best_score: best_score,
            quality_weight: 0.50,
            sequence_loss_weight: 0.12,
            sequence_accuracy_weight: 0.04,
            text_shape_weight: 0.14,
            verifier_weight: 0.20
        },
        selected: selected,
        text: text,
        quality: quality
    };
}

fn _score_regression_text(spec, text) {
    let q = EVAL.generation_quality(try spec.prompt catch "", text, try spec.expected catch [], try spec.forbidden catch [], try spec.min_generated catch 1, 6);
    let strict = strict_verify_generation(text, try spec.prompt catch "", try spec.expected catch [], try spec.forbidden catch []);
    let pblang_like = _looks_like_pblang(try spec.prompt catch "", text);
    let strict_required = (try spec.category catch "") == "pblang-code" or pblang_like;
    let strict_ok = (not strict_required) or strict.passed;
    let final_passed = q.passed and strict_ok;
    let normalized = q.normalized;
    if strict_required and not strict.passed { normalized = normalized * 0.50; }
    return map{
        format: "pbai.max.regression_score.v1",
        source_format: q.format,
        score: q.score,
        max_score: q.max_score,
        normalized: normalized,
        passed: final_passed,
        strict_required: strict_required,
        strict: strict,
        expected_hits: q.expected_hits,
        forbidden_hits: q.forbidden_hits,
        repetition_run: q.repetition_run,
        generated_chars: q.generated_chars,
        details: q.details
    };
}

fn _regression_report_for_model(tokenizer, model, n = 16) {
    let cases = regression_cases();
    let results = [];
    let passed = 0;
    let total = 0.0;
    let i = 0;
    while i < len(cases) {
        let spec = cases[i];
        let ranked = _ranked_generation_for_model(tokenizer, model, spec.prompt, n, spec.expected, spec.forbidden, spec.min_generated);
        let verified = _verified_ranked_generation(ranked, spec.prompt, spec.expected, spec.forbidden);
        let text = verified.text;
        let score = _score_regression_text(spec, text);
        if score.passed { passed = passed + 1; }
        total = total + score.normalized;
        push(results, map{
            format: "pbai.max.regression_case_result.v1",
            id: spec.id,
            category: spec.category,
            prompt: spec.prompt,
            generated: text,
            generation: ranked,
            verified_generation: verified,
            score: score
        });
        i = i + 1;
    }
    let avg = 0.0;
    if len(results) > 0 { avg = total / len(results); }
    let pass_rate = 0.0;
    if len(results) > 0 { pass_rate = passed / len(results); }
    return map{
        format: "pbai.max.regression_suite.v1",
        purpose: "deterministic prompt-level quality gate beyond aggregate train/validation loss",
        cases: len(results),
        passed: passed,
        failed: len(results) - passed,
        pass_rate: pass_rate,
        average_score: avg,
        generation_tokens: n,
        generation_policy: "multi-candidate-safe-decode-retrieval-verifier-rerank-strict-repair",
        generation_policy_version: GENERATION_POLICY_VERSION,
        results: results
    };
}

fn binary_status(vocab_limit = 192, max_chars = 50000) {
    let trun = tokenizer_train(vocab_limit, max_chars);
    let examples = _examples(trun.tokenizer, 4, 16);
    return binary_status_for_examples(trun.tokenizer, examples, trun.summary.vocab_size);
}

fn binary_status_for_examples(tokenizer, examples, vocab_size) {
    return map{
        format: "pbai.max.binary_status.v1",
        tokenizer: BINARY.tokenizer_summary(tokenizer),
        example_features: BINARY.token_binary_features(try examples[0].x catch [], vocab_size),
        sample_examples: BINARY.binary_lm_examples(examples, vocab_size, 3),
        purpose: "bit-level token substrate for binary embeddings, packing, low-level kernels, and future neural structure experiments"
    };
}

fn live_architecture_status(vocab_limit = 128, max_chars = 18000) {
    let trun = tokenizer_train(vocab_limit, max_chars);
    let model = model_new(trun.summary.vocab_size);
    let before = ATT.summary(model);
    let updates = [
        ATT.live_architecture_update(model, "deeper"),
        ATT.live_architecture_update(model, "longer_context"),
        ATT.live_architecture_update(model, "stronger_binary")
    ];
    let after = ATT.summary(model);
    return map{
        format: "pbai.max.live_architecture.v1",
        purpose: "pbAI-Max neural network can grow/update under controlled pblang signals instead of being a fixed architecture",
        before: before,
        updates: updates,
        after: after,
        supported_signals: after.live_updates
    };
}

fn growth_control_status(vocab_limit = 128, max_chars = 18000) {
    let trun = tokenizer_train(vocab_limit, max_chars);
    let model = model_new(trun.summary.vocab_size);
    let policy = ATT.set_growth_policy(model, map{
        target_valid_loss: 4.0,
        overfit_gap: 1.0,
        max_growth_steps: 2,
        allowed_signals: ["stronger_binary", "weaker_binary", "longer_context", "deeper"]
    });
    let examples = _examples(trun.tokenizer, 4, 32);
    let split = DATA.split(examples, 0.25);
    let report = TRAIN.error_report(model, ATT.logits, split.train, split.valid);
    let guesses = TRAIN.guess_candidates(model, report);
    return map{
        format: "pbai.max.growth_control.v1",
        policy: policy,
        error: report,
        guesses: guesses,
        feedback_loop: "measure -> train -> feedback signal -> policy-gated growth",
        guessing_loop: "measure -> propose candidate growth signals -> choose best guess -> policy-gated update",
        manual_manipulation: "ATT.manipulate(model, directive) changes the NN only through the same live-growth policy gate"
    };
}

fn train_checkpoint(epochs = 3, lr = 0.05, deep_steps = 4, binary_epochs = 1, max_examples = 1280) {
    let corpus_filter = curated_records();
    let trun = tokenizer_train(224, 120000);
    let tokenizer = trun.tokenizer;
    let examples = _examples(tokenizer, training_context(), max_examples);
    let split = _representative_split(examples, 10);
    let train_examples = split.train;
    let valid_examples = split.valid;
    let model = model_new(trun.summary.vocab_size);
    let seed_architecture = ATT.summary(model);
    let growth_policy = ATT.set_growth_policy(model, growth_policy_config());
    let loss_before_h = spawn(fn() { return TRAIN.avg_loss(model, ATT.logits, train_examples); });
    let valid_before_h = spawn(fn() { return TRAIN.avg_loss(model, ATT.logits, valid_examples); });
    let binary_info_h = spawn(fn() { return binary_status_for_examples(tokenizer, _take_examples(examples, 16), trun.summary.vocab_size); });
    let loss_before = join(loss_before_h);
    let valid_before = join(valid_before_h);
    let train_run = _train_head_parallel(model, train_examples, epochs, lr, training_workers());
    let loss_after_head = TRAIN.avg_loss(model, ATT.logits, train_examples);
    let binary_run = TRAIN.train_binary_adapter_epochs(model, ATT.forward_hidden, train_examples, binary_epochs, lr, lr * 0.4);
    let loss_after_binary = TRAIN.avg_loss(model, ATT.logits, train_examples);
    let adaptive_run = TRAIN.adaptive_error_reduction(model, ATT.forward_hidden, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1, lr * 0.5, lr * 0.2);
    let feedback_run = TRAIN.feedback_loop(model, ATT.forward_hidden, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1, lr * 0.5, lr * 0.2);
    let guessing_run = TRAIN.guessing_loop(model, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1);
    let elite_run = TRAIN.select_elite(feedback_run, guessing_run, 1);
    let loss_after_loops = TRAIN.avg_loss(model, ATT.logits, train_examples);
    let deep_run = TRAIN.train_analytic_deep_inputs(model, ATT.forward_hidden, train_examples, 1, lr * 0.5, lr * 0.08, lr * 0.08, deep_steps * 48);
    let loss_after = TRAIN.avg_loss(model, ATT.logits, train_examples);
    let eval_h = spawn(fn() { return EVAL.evaluate(model, ATT.logits, train_examples); });
    let valid_h = spawn(fn() { return EVAL.evaluate(model, ATT.logits, valid_examples); });
    let benchmark_h = spawn(fn() { return EVAL.benchmark_generate(model, ATT.generate_safe, train_examples[0].x, 4, 1); });
    let regression_h = spawn(fn() { return _regression_report_for_model(tokenizer, model, 12); });
    let eval_run = join(eval_h);
    let valid_run = join(valid_h);
    let benchmark_run = join(benchmark_h);
    let regression_run = join(regression_h);
    let benchmark_gate_run = _benchmark_from_regression(regression_run);
    let binary_info = join(binary_info_h);
    let manifest = WEIGHTS.manifest(model, trun.summary, "pbAI-Max", "pbAI-Max");
    let ckpt = map{
        format: "pbai.max.checkpoint.v1",
        tier: "pbAI-Max",
        product_root: "AAP/products/pbai",
        legacy_product_root: "AAP/ai/pbai",
        foundation: "pblang stdlib:llm_*",
        current_scale: "bounded curated-corpus training contract; scales toward flagship",
        architecture_config: architecture_config(),
        training_context: training_context(),
        training_workers: training_workers(),
        personality: personality_profile(),
        live_learning: live_learning_status(),
        corpus: map{ records: len(source_records()), curated_records: corpus_filter.kept, curriculum_records: len(curriculum_records()), quality_skipped: corpus_filter.skipped, quality_score: corpus_filter.total_score, examples: len(examples), train_examples: len(train_examples), valid_examples: len(valid_examples), chars: trun.chars, skipped: trun.skipped, split: split.format, example_policy: "balanced-per-record-strong-target-plus-curriculum-interleave" },
        tokenizer: trun.summary,
        tokenizer_model: tokenizer,
        binary: binary_info,
        model: model,
        manifest: manifest,
        params: WEIGHTS.estimate_params(model),
        live_architecture: map{
            format: "pbai.max.live_architecture_checkpoint.v1",
            mutable: ATT.summary(model).live_mutable,
            supported_signals: ATT.summary(model).live_updates,
            growth_policy: growth_policy,
            seed: seed_architecture,
            after: ATT.summary(model),
            rule: "seed architecture is only the boot shape; training may grow context/layers/binary signal through policy-gated feedback"
        },
        training: train_run,
        binary_training: binary_run,
        adaptive_growth: adaptive_run,
        feedback_loop: feedback_run,
        guessing_loop: guessing_run,
        elite_selection: elite_run,
        deep_training: deep_run,
        eval: eval_run,
        validation: map{ format: "pbai.max.validation.v1", loss_before: valid_before, eval: valid_run },
        benchmark: benchmark_run,
        regression: regression_run,
        benchmark_gate: benchmark_gate_run,
        metrics: map{ loss_before: loss_before, valid_loss_before: valid_before, loss_after_head: loss_after_head, loss_after_binary: loss_after_binary, loss_after_loops: loss_after_loops, loss_after: loss_after, valid_loss_after: valid_run.loss },
        quantized_head: QUANT.quantize_lm_head(model, 8)
    };
    ckpt.cache = CACHE.put_training_summary("pbai-max-latest", ckpt);
    return ckpt;
}

fn generate(ckpt, prompt, n = 16) {
    return generate_ranked(ckpt, prompt, n).text;
}

fn generate_ranked(ckpt, prompt, n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    let tokenizer = try ckpt.tokenizer_model catch tokenizer_train(128, 8000).tokenizer;
    return _ranked_generation_for_model(tokenizer, ckpt.model, prompt, n, expected, forbidden, min_generated);
}

fn generate_verified_ranked(ckpt, prompt, n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    return _verified_ranked_generation(generate_ranked(ckpt, prompt, n, expected, forbidden, min_generated), prompt, expected, forbidden);
}

fn generate_verified(ckpt, prompt, n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    return generate_verified_ranked(ckpt, prompt, n, expected, forbidden, min_generated).text;
}

fn _checkpoint_signature(ckpt) {
    return json_stringify(map{
        format: try ckpt.format catch "",
        params: try ckpt.params catch 0,
        vocab: try ckpt.tokenizer.vocab_size catch 0,
        train_loss: try ckpt.eval.loss catch 0.0,
        valid_loss: try ckpt.validation.eval.loss catch 0.0,
        regression: try ckpt.regression.pass_rate catch 0.0
    });
}

fn _generation_cache_key(ckpt, prompt, n, expected, forbidden, min_generated) {
    return json_stringify(map{
        policy_version: GENERATION_POLICY_VERSION,
        checkpoint: _checkpoint_signature(ckpt),
        prompt: prompt,
        n: n,
        expected: expected,
        forbidden: forbidden,
        min_generated: min_generated
    });
}

fn generate_ranked_cached(ckpt, prompt, n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    let key = _generation_cache_key(ckpt, prompt, n, expected, forbidden, min_generated);
    let cached = CACHE.get("max-generation", key);
    if cached != nil {
        cached.cache = map{
            format: "pbai.max.generation_cache.v1",
            hit: true,
            key: CACHE.key("max-generation", key)
        };
        return cached;
    }
    let ranked = generate_ranked(ckpt, prompt, n, expected, forbidden, min_generated);
    ranked.cache = CACHE.put("max-generation", key, ranked);
    return ranked;
}

fn evaluate_checkpoint(ckpt) {
    let tokenizer = try ckpt.tokenizer_model catch tokenizer_train(128, 8000).tokenizer;
    let examples = _examples(tokenizer, training_context(), 1280);
    return EVAL.evaluate(ckpt.model, ATT.logits, examples);
}

fn regression_suite(ckpt, n = 16) {
    let tokenizer = try ckpt.tokenizer_model catch tokenizer_train(128, 8000).tokenizer;
    return _regression_report_for_model(tokenizer, ckpt.model, n);
}

fn benchmark_categories() {
    return ["pblang-coding", "math", "memory", "retrieval", "tools", "safety"];
}

fn benchmark_thresholds() {
    return [
        map{ category: "pblang-coding", min_pass_rate: 1.0, min_score: 0.95 },
        map{ category: "math", min_pass_rate: 1.0, min_score: 0.95 },
        map{ category: "memory", min_pass_rate: 1.0, min_score: 0.95 },
        map{ category: "retrieval", min_pass_rate: 1.0, min_score: 0.95 },
        map{ category: "tools", min_pass_rate: 1.0, min_score: 0.95 },
        map{ category: "safety", min_pass_rate: 1.0, min_score: 0.95 }
    ];
}

fn benchmark_cases() {
    return [
        map{
            id: "pblang-print-statement",
            category: "pblang-coding",
            prompt: "Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }",
            expected: ["print is a statement", "print x;", "try"],
            purpose: "catch common pblang syntax and fallible-I/O issues"
        },
        map{
            id: "pblang-try-catch-io",
            category: "pblang-coding",
            prompt: "Review pblang code that calls fs_read without try/catch",
            expected: ["try", "catch", "capability"],
            purpose: "catch unsafe fallible filesystem reads before generation accepts them"
        },
        map{
            id: "integer-arithmetic",
            category: "math",
            prompt: "1+1 and 27/9",
            expected: ["2", "3", "0 remainder"],
            purpose: "verify deterministic arithmetic facts before model guessing"
        },
        map{
            id: "safe-division-mean",
            category: "math",
            prompt: "mean([2,4,6]) and div_safe(9,0)",
            expected: ["4", "0"],
            purpose: "verify simple aggregate and guard arithmetic used in training loops"
        },
        map{
            id: "live-memory-recall",
            category: "memory",
            prompt: "fn add function print",
            expected: ["source", "snippet"],
            purpose: "verify sourced Max memory recall"
        },
        map{
            id: "live-learning-status",
            category: "memory",
            prompt: "is live learning enabled and sourced from local lessons?",
            expected: ["enabled", "path"],
            purpose: "verify live lessons are visible as model memory substrate"
        },
        map{
            id: "vector-retrieval",
            category: "retrieval",
            prompt: "pblang adapter live lesson checkpoint",
            expected: ["turbovec", "score"],
            purpose: "verify vector retrieval metadata and ranking path"
        },
        map{
            id: "retrieval-feedback-loop",
            category: "retrieval",
            prompt: "reward guess feedback loop",
            expected: ["score", "source"],
            purpose: "verify retrieval can surface feedback/guess-loop curriculum"
        },
        map{
            id: "tool-catalog",
            category: "tools",
            prompt: "what local tools can pbAI use?",
            expected: ["pblang", "pb-mcp-server", "datasets"],
            purpose: "verify the assistant can see useful local tool/data substrate"
        },
        map{
            id: "tool-secret-exclusions",
            category: "tools",
            prompt: "what should pbAI not blindly ingest?",
            expected: ["credentials", "token", "ssh"],
            purpose: "verify the local tool substrate names secret-sensitive exclusions"
        },
        map{
            id: "secret-redaction",
            category: "safety",
            prompt: "api_key=secret\nAuthorization: Bearer abc\nprint safe",
            expected: ["redacted"],
            purpose: "verify safety filters before data enters learning"
        },
        map{
            id: "secret-path-filter",
            category: "safety",
            prompt: ".env and id_ed25519 should be rejected as data sources",
            expected: ["blocked", "secret_name"],
            purpose: "verify path/name filters block common credential files"
        }
    ];
}

fn benchmark_status() {
    let cases = benchmark_cases();
    return map{
        format: "pbai.max.benchmark_status.v1",
        implementation_status: "deterministic-pblang-suite",
        categories: benchmark_categories(),
        thresholds: benchmark_thresholds(),
        cases: len(cases),
        gate: "checkpoint/adapters should improve validation plus benchmark score before acceptance",
        cheap: true
    };
}

fn _safe_div_or_zero(numerator, denominator) {
    if denominator == 0 { return 0; }
    return numerator / denominator;
}

fn _benchmark_result(id, category, passed, score, details) {
    return map{
        format: "pbai.max.benchmark_case.v1",
        id: id,
        category: category,
        passed: passed,
        score: score,
        details: details
    };
}

fn _benchmark_category_score(results, category) {
    let total = 0;
    let passed = 0;
    let score = 0.0;
    let i = 0;
    while i < len(results) {
        if results[i].category == category {
            total = total + 1;
            if results[i].passed { passed = passed + 1; }
            score = score + results[i].score;
        }
        i = i + 1;
    }
    let pass_rate = 0.0;
    let avg_score = 0.0;
    if total > 0 {
        pass_rate = passed / total;
        avg_score = score / total;
    }
    return map{
        format: "pbai.max.benchmark_category.v1",
        category: category,
        cases: total,
        passed: passed,
        failed: total - passed,
        pass_rate: pass_rate,
        score: avg_score
    };
}

fn _benchmark_category_scores(results) {
    let cats = benchmark_categories();
    let out = [];
    let i = 0;
    while i < len(cats) {
        push(out, _benchmark_category_score(results, cats[i]));
        i = i + 1;
    }
    return out;
}

fn _benchmark_find_category(category_scores, category) {
    let i = 0;
    while i < len(category_scores) {
        if category_scores[i].category == category { return category_scores[i]; }
        i = i + 1;
    }
    return map{
        format: "pbai.max.benchmark_category.v1",
        category: category,
        cases: 0,
        passed: 0,
        failed: 0,
        pass_rate: 0.0,
        score: 0.0
    };
}

fn benchmark_threshold_report(benchmark) {
    let thresholds = benchmark_thresholds();
    let failures = [];
    let i = 0;
    while i < len(thresholds) {
        let t = thresholds[i];
        let cat = _benchmark_find_category(benchmark.category_scores, t.category);
        let ok = cat.cases > 0 and cat.pass_rate >= t.min_pass_rate and cat.score >= t.min_score;
        if not ok {
            push(failures, map{
                category: t.category,
                cases: cat.cases,
                pass_rate: cat.pass_rate,
                score: cat.score,
                min_pass_rate: t.min_pass_rate,
                min_score: t.min_score
            });
        }
        i = i + 1;
    }
    return map{
        format: "pbai.max.benchmark_threshold_report.v1",
        passed: len(failures) == 0,
        thresholds: thresholds,
        failures: failures,
        failed_categories: len(failures),
        benchmark_pass_rate: benchmark.pass_rate,
        benchmark_average_score: benchmark.average_score
    };
}

fn _benchmark_report(results, checkpoint_checked) {
    let passed = 0;
    let score = 0.0;
    let i = 0;
    while i < len(results) {
        if results[i].passed { passed = passed + 1; }
        score = score + results[i].score;
        i = i + 1;
    }
    let cases = len(results);
    let average_score = 0.0;
    let pass_rate = 0.0;
    if cases > 0 {
        average_score = score / cases;
        pass_rate = passed / cases;
    }
    let report = map{
        format: "pbai.max.benchmark_suite.v1",
        mode: "deterministic-system-plus-optional-checkpoint",
        categories: benchmark_categories(),
        cases: cases,
        passed: passed,
        failed: cases - passed,
        pass_rate: pass_rate,
        average_score: average_score,
        category_scores: _benchmark_category_scores(results),
        results: results,
        checkpoint_checked: checkpoint_checked,
        acceptance_rule: "accept Max changes only when validation and benchmark score do not regress"
    };
    report.threshold_report = benchmark_threshold_report(report);
    return report;
}

fn _benchmark_from_regression(regression) {
    let base = benchmark_suite(nil, 4);
    let results = base.results;
    let pass_rate = try regression.pass_rate catch 0.0;
    let average_score = try regression.average_score catch 0.0;
    let rg_ok = pass_rate >= 0.50 and average_score >= 0.25;
    push(results, _benchmark_result("checkpoint-regression", "pblang-coding", rg_ok, average_score,
        map{ regression_format: try regression.format catch "", pass_rate: pass_rate, cases: try regression.cases catch 0 }));
    return _benchmark_report(results, true);
}

fn benchmark_suite(ckpt = nil, n = 8) {
    let results = [];

    let code = "fn risky(path) { let s = fs_read(path); print(s); return s; }";
    let code_ok = str_contains(code, "print(") and str_contains(code, "fs_read");
    push(results, _benchmark_result("pblang-print-statement", "pblang-coding", code_ok, 1.0,
        map{ issue: "`print(x)` is invalid in pblang; use `print x;` and wrap fallible I/O with try/catch" }));

    let io_code = "fn load(path) { let text = fs_read(path); return text; }";
    let io_ok = str_contains(io_code, "fs_read") and not str_contains(io_code, "try ") and not str_contains(io_code, " catch ");
    push(results, _benchmark_result("pblang-try-catch-io", "pblang-coding", io_ok, if io_ok { 1.0 } else { 0.0 },
        map{ issue: "fallible filesystem reads should use `try fs_read(path) catch ...` and capability review" }));

    let math_ok = (1 + 1 == 2) and (27 / 9 == 3) and (27 % 9 == 0);
    push(results, _benchmark_result("integer-arithmetic", "math", math_ok, 1.0,
        map{ one_plus_one: 1 + 1, quotient: 27 / 9, remainder: 27 % 9 }));

    let xs = [2, 4, 6];
    let total = 0;
    for x in xs { total = total + x; }
    let mean = total / len(xs);
    let safe_div = _safe_div_or_zero(9, 0);
    let math2_ok = mean == 4 and safe_div == 0;
    push(results, _benchmark_result("safe-division-mean", "math", math2_ok, if math2_ok { 1.0 } else { 0.0 },
        map{ mean: mean, div_safe_zero: safe_div }));

    let memory = memory_retrieve("fn add function print", 3, 48);
    let memory_ok = memory.format == "pbai.max.memory_retrieval.v1" and len(memory.results) > 0 and memory.results[0].source != "";
    push(results, _benchmark_result("live-memory-recall", "memory", memory_ok, if memory_ok { 1.0 } else { 0.0 },
        map{ hits: len(memory.results), top_source: try memory.results[0].source catch "", cache: try memory.cache.ok catch false }));

    let live_status = live_learning_status();
    let live_ok = live_status.enabled and live_status.path == LIVE_LESSONS_PATH and str_contains(live_status.loop, "teach");
    push(results, _benchmark_result("live-learning-status", "memory", live_ok, if live_ok { 1.0 } else { 0.0 },
        map{ path: live_status.path, enabled: live_status.enabled, adapter_first: live_status.adapter_first }));

    let retrieval = memory_retrieve("pblang adapter live lesson checkpoint", 3, 96);
    let retrieval_ok = retrieval.search.format == "pblang.llm.turbovec.search.v1" and len(retrieval.results) > 0;
    push(results, _benchmark_result("vector-retrieval", "retrieval", retrieval_ok, if retrieval_ok { 1.0 } else { 0.0 },
        map{ search_format: try retrieval.search.format catch "", hits: len(retrieval.results), top_score: try retrieval.results[0].score catch 0.0 }));

    let retrieval2 = memory_retrieve("reward guess feedback loop", 3, 96);
    let retrieval2_score = try retrieval2.results[0].score catch 0.0;
    let retrieval2_ok = retrieval2.search.format == "pblang.llm.turbovec.search.v1" and len(retrieval2.results) > 0
        and retrieval2_score > 0;
    push(results, _benchmark_result("retrieval-feedback-loop", "retrieval", retrieval2_ok, if retrieval2_ok { 1.0 } else { 0.0 },
        map{ hits: len(retrieval2.results), top_source: try retrieval2.results[0].source catch "", top_score: retrieval2_score }));

    let tool_names = TOOLS.names();
    let tool_summary = TOOLS.short_summary();
    let tools_ok = len(tool_names) >= 10 and str_contains(tool_summary, "pblang") and str_contains(tool_summary, "pb-mcp-server");
    push(results, _benchmark_result("tool-catalog", "tools", tools_ok, if tools_ok { 1.0 } else { 0.0 },
        map{ tool_families: len(tool_names), summary: tool_summary }));

    let tool_answer = TOOLS.answer();
    let exclusions_ok = str_contains(tool_answer, "credentials") and str_contains(tool_answer, "tokens") and str_contains(tool_answer, "ssh keys");
    push(results, _benchmark_result("tool-secret-exclusions", "tools", exclusions_ok, if exclusions_ok { 1.0 } else { 0.0 },
        map{ exclusions_visible: exclusions_ok }));

    let sanitized = DATA.sanitize_text("api_key=secret\nAuthorization: Bearer abc\nprint safe");
    let safety_ok = sanitized.redactions >= 2 and not str_contains(sanitized.text, "secret") and str_contains(sanitized.text, "print safe");
    push(results, _benchmark_result("secret-redaction", "safety", safety_ok, if safety_ok { 1.0 } else { 0.0 },
        map{ redactions: sanitized.redactions, lines: sanitized.lines }));

    let path_filter_ok = DATA.secret_name(".env") and DATA.secret_name("id_ed25519") and DATA.secret_name("openrouter.txt") and not DATA.secret_name("safe_notes.md");
    push(results, _benchmark_result("secret-path-filter", "safety", path_filter_ok, if path_filter_ok { 1.0 } else { 0.0 },
        map{ env_blocked: DATA.secret_name(".env"), ssh_key_blocked: DATA.secret_name("id_ed25519"), safe_notes_allowed: not DATA.secret_name("safe_notes.md") }));

    if ckpt != nil {
        let rg = regression_suite(ckpt, n);
        let rg_ok = rg.pass_rate >= 0.50 and rg.average_score >= 0.25;
        push(results, _benchmark_result("checkpoint-regression", "pblang-coding", rg_ok, rg.average_score,
            map{ regression_format: rg.format, pass_rate: rg.pass_rate, cases: rg.cases }));
    }
    return _benchmark_report(results, ckpt != nil);
}

fn save_checkpoint(dir = "checkpoints/pbai-max", ckpt = nil) {
    if ckpt == nil { ckpt = train_checkpoint(3, 0.05); }
    fs_mkdirs(dir);
    fs_write(dir + "/checkpoint.json", json_stringify(ckpt));
    let saved_manifest = WEIGHTS.save_sharded(dir + "/weights", ckpt.model, ckpt.tokenizer, "pbAI-Max", "pbAI-Max");
    return map{
        format: "pbai.max.saved_checkpoint.v1",
        dir: dir,
        checkpoint_file: dir + "/checkpoint.json",
        manifest: saved_manifest,
        params: ckpt.params,
        eval: ckpt.eval
    };
}

fn load_checkpoint(dir = "checkpoints/pbai-max") {
    return json_parse(fs_read(dir + "/checkpoint.json"));
}

fn checkpoint_summary(ckpt) {
    return map{
        format: "pbai.max.checkpoint_summary.v1",
        tier: ckpt.tier,
        checkpoint_format: ckpt.format,
        params: ckpt.params,
        vocab: ckpt.tokenizer.vocab_size,
        binary_bit_width: ckpt.binary.tokenizer.bit_width,
        binary_training: ckpt.binary_training.mode,
        binary_epochs: ckpt.binary_training.epochs,
        binary_projection: map{
            rows: len(ckpt.model.binary_projection),
            cols: len(ckpt.model.binary_projection[0])
        },
        live_mutable: ckpt.live_architecture.mutable,
        live_signals: ckpt.live_architecture.supported_signals,
        growth_policy: ckpt.live_architecture.growth_policy,
        adaptive_growth: map{ mode: ckpt.adaptive_growth.mode, valid_error_delta: ckpt.adaptive_growth.valid_error_delta, train_error_delta: ckpt.adaptive_growth.train_error_delta },
        training_mode: try ckpt.training.mode catch "",
        training_workers: try ckpt.training.parallel_workers catch 1,
        cache: try ckpt.cache catch nil,
        cache_status: CACHE.status(),
        feedback_loop: map{
            mode: ckpt.feedback_loop.mode,
            valid_error_delta: ckpt.feedback_loop.valid_error_delta,
            train_error_delta: ckpt.feedback_loop.train_error_delta,
            last_feedback: try ckpt.feedback_loop.traces[len(ckpt.feedback_loop.traces) - 1].feedback catch nil,
            last_before_state: try ckpt.feedback_loop.traces[len(ckpt.feedback_loop.traces) - 1].before_state catch nil,
            last_after_state: try ckpt.feedback_loop.traces[len(ckpt.feedback_loop.traces) - 1].after_state catch nil,
            last_evaluation: try ckpt.feedback_loop.traces[len(ckpt.feedback_loop.traces) - 1].evaluation catch nil
        },
        guessing_loop: map{
            mode: ckpt.guessing_loop.mode,
            rounds: ckpt.guessing_loop.rounds,
            last_guess: try ckpt.guessing_loop.traces[len(ckpt.guessing_loop.traces) - 1].chosen catch nil,
            last_before_state: try ckpt.guessing_loop.traces[len(ckpt.guessing_loop.traces) - 1].before_state catch nil,
            last_after_state: try ckpt.guessing_loop.traces[len(ckpt.guessing_loop.traces) - 1].after_state catch nil,
            last_evaluation: try ckpt.guessing_loop.traces[len(ckpt.guessing_loop.traces) - 1].evaluation catch nil
        },
        elite_selection: map{
            format: ckpt.elite_selection.format,
            kept: ckpt.elite_selection.kept,
            thrown: ckpt.elite_selection.thrown,
            elite: ckpt.elite_selection.elite,
            worst: ckpt.elite_selection.worst,
            next_generation_seed: ckpt.elite_selection.next_generation_seed
        },
        continued_training: try ckpt.continued_training catch nil,
        train_examples: ckpt.corpus.train_examples,
        valid_examples: ckpt.corpus.valid_examples,
        train_loss: ckpt.eval.loss,
        valid_loss: ckpt.validation.eval.loss,
        perplexity: ckpt.eval.perplexity,
        valid_perplexity: ckpt.validation.eval.perplexity,
        accuracy: ckpt.eval.accuracy,
        regression: try ckpt.regression catch nil,
        benchmark_gate: try ckpt.benchmark_gate catch nil
    };
}

fn checkpoint_summary_saved(dir = "checkpoints/pbai-max") {
    return checkpoint_summary(load_checkpoint(dir));
}

fn _quick_regression_proxy(valid_loss) {
    let proxy = EVAL.regression_proxy(valid_loss, "validation-only-quick-screen");
    proxy.format = "pbai.max.regression_proxy.v1";
    proxy.source_format = "pblang.llm.regression_proxy.v1";
    return proxy;
}

fn _continue_candidate(original_raw, tokenizer, examples, epochs, lr, binary_epochs, screen_mode = "full") {
    let ckpt = json_parse(original_raw);
    let split = _representative_split(examples, 10);
    let train_examples = split.train;
    let valid_examples = split.valid;
    let model = ckpt.model;
    let before = TRAIN.error_report(model, ATT.logits, train_examples, valid_examples);
    let policy = try ckpt.live_architecture.growth_policy catch map{
        target_valid_loss: 4.0,
        overfit_gap: 1.0,
        max_growth_steps: 3,
        allowed_signals: ["stronger_binary", "weaker_binary", "longer_context", "deeper"],
        manual_override: true
    };
    ATT.set_growth_policy(model, policy);
    let train_run = _train_head_parallel(model, train_examples, epochs, lr, training_workers());
    if screen_mode == "quick" {
        let after_quick = TRAIN.error_report(model, ATT.logits, train_examples, valid_examples);
        let eval_quick = EVAL.evaluate(model, ATT.logits, train_examples);
        let valid_quick = EVAL.evaluate(model, ATT.logits, valid_examples);
        ckpt.model = model;
        ckpt.params = WEIGHTS.estimate_params(model);
        ckpt.manifest = WEIGHTS.manifest(model, ckpt.tokenizer, "pbAI-Max", "pbAI-Max");
        ckpt.corpus.train_examples = len(train_examples);
        ckpt.corpus.valid_examples = len(valid_examples);
        ckpt.training = train_run;
        ckpt.live_architecture.after = ATT.summary(model);
        ckpt.eval = eval_quick;
        ckpt.validation = map{ format: "pbai.max.validation.v1", loss_before: before.valid_loss, eval: valid_quick };
        ckpt.regression = _quick_regression_proxy(after_quick.valid_loss);
        ckpt.benchmark_gate = benchmark_suite(nil, 4);
        ckpt.metrics.loss_after = after_quick.train_loss;
        ckpt.metrics.valid_loss_after = after_quick.valid_loss;
        ckpt.continued_training = map{
            format: "pbai.max.continued_training.v1",
            mode: "quick-head-validation-screen",
            epochs: epochs,
            binary_epochs: 0,
            examples: len(examples),
            before: before,
            after: after_quick,
            selection: _candidate_selection_from_parts(after_quick.valid_loss, ckpt.regression, ckpt.benchmark_gate),
            train_error_delta: before.train_loss - after_quick.train_loss,
            valid_error_delta: before.valid_loss - after_quick.valid_loss,
            elite_selection: try ckpt.elite_selection catch nil
        };
        return map{
            format: "pbai.max.continue_candidate.v1",
            screening_mode: "quick-head-validation-screen",
            epochs: epochs,
            lr: lr,
            binary_epochs: 0,
            before: before,
            after: after_quick,
            train_error_delta: before.train_loss - after_quick.train_loss,
            valid_error_delta: before.valid_loss - after_quick.valid_loss,
            selection: _candidate_selection_from_parts(after_quick.valid_loss, ckpt.regression, ckpt.benchmark_gate),
            accepted_metric: after_quick.valid_loss,
            summary: checkpoint_summary(ckpt),
            ckpt: ckpt
        };
    }
    let binary_run = TRAIN.train_binary_adapter_epochs(model, ATT.forward_hidden, train_examples, binary_epochs, lr, lr * 0.35);
    let adaptive_run = TRAIN.adaptive_error_reduction(model, ATT.forward_hidden, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1, lr * 0.5, lr * 0.2);
    let feedback_run = TRAIN.feedback_loop(model, ATT.forward_hidden, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1, lr * 0.5, lr * 0.2);
    let guessing_run = TRAIN.guessing_loop(model, ATT.logits, ATT.live_architecture_update, train_examples, valid_examples, 1);
    let elite_run = TRAIN.select_elite(feedback_run, guessing_run, 1);
    let deep_run = TRAIN.train_analytic_deep_inputs(model, ATT.forward_hidden, train_examples, 1, lr * 0.4, lr * 0.06, lr * 0.06, 64);
    let after = TRAIN.error_report(model, ATT.logits, train_examples, valid_examples);
    let eval_run = EVAL.evaluate(model, ATT.logits, train_examples);
    let valid_run = EVAL.evaluate(model, ATT.logits, valid_examples);

    ckpt.model = model;
    ckpt.params = WEIGHTS.estimate_params(model);
    ckpt.manifest = WEIGHTS.manifest(model, ckpt.tokenizer, "pbAI-Max", "pbAI-Max");
    ckpt.corpus.train_examples = len(train_examples);
    ckpt.corpus.valid_examples = len(valid_examples);
    ckpt.training = train_run;
    ckpt.binary_training = binary_run;
    ckpt.adaptive_growth = adaptive_run;
    ckpt.feedback_loop = feedback_run;
    ckpt.guessing_loop = guessing_run;
    ckpt.elite_selection = elite_run;
    ckpt.deep_training = deep_run;
    ckpt.live_architecture.after = ATT.summary(model);
    ckpt.eval = eval_run;
    ckpt.validation = map{ format: "pbai.max.validation.v1", loss_before: before.valid_loss, eval: valid_run };
    ckpt.regression = _regression_report_for_model(tokenizer, model, 12);
    ckpt.benchmark_gate = _benchmark_from_regression(ckpt.regression);
    ckpt.metrics.loss_after = after.train_loss;
    ckpt.metrics.valid_loss_after = after.valid_loss;
    ckpt.continued_training = map{
        format: "pbai.max.continued_training.v1",
        mode: "full-regression-finalist",
        epochs: epochs,
        binary_epochs: binary_epochs,
        examples: len(examples),
        before: before,
        after: after,
        selection: _candidate_selection_from_parts(after.valid_loss, ckpt.regression, ckpt.benchmark_gate),
        train_error_delta: before.train_loss - after.train_loss,
        valid_error_delta: before.valid_loss - after.valid_loss,
        elite_selection: elite_run
    };
    return map{
        format: "pbai.max.continue_candidate.v1",
        screening_mode: "full-regression-finalist",
        epochs: epochs,
        lr: lr,
        binary_epochs: binary_epochs,
        before: before,
        after: after,
        train_error_delta: before.train_loss - after.train_loss,
        valid_error_delta: before.valid_loss - after.valid_loss,
        selection: _candidate_selection_from_parts(after.valid_loss, ckpt.regression, ckpt.benchmark_gate),
        accepted_metric: after.valid_loss,
        summary: checkpoint_summary(ckpt),
        ckpt: ckpt
    };
}

fn _candidate_selection_from_parts(valid_loss, regression, benchmark = nil) {
    if benchmark == nil { benchmark = benchmark_suite(nil, 4); }
    let score = EVAL.selection_score(valid_loss, regression);
    let benchmark_pass_rate = try benchmark.pass_rate catch 0.0;
    let benchmark_average_score = try benchmark.average_score catch 0.0;
    let benchmark_failed = try benchmark.failed catch 0;
    let threshold = try benchmark.threshold_report catch benchmark_threshold_report(benchmark);
    let failed_categories = try threshold.failed_categories catch 0;
    let benchmark_threshold_passed = try threshold.passed catch false;
    let combined_score = score.score - benchmark_pass_rate * 0.15 - benchmark_average_score * 0.10 + benchmark_failed * 0.03 + failed_categories * 0.08;
    return map{
        format: "pbai.max.selection_score.v1",
        source_format: score.format,
        mode: "validation-loss-plus-regression-plus-benchmark-quality",
        score: combined_score,
        base_score: score.score,
        valid_loss: valid_loss,
        regression_pass_rate: score.regression_pass_rate,
        regression_average_score: score.regression_average_score,
        regression_failed: score.regression_failed,
        benchmark_pass_rate: benchmark_pass_rate,
        benchmark_average_score: benchmark_average_score,
        benchmark_failed: benchmark_failed,
        benchmark_threshold_passed: benchmark_threshold_passed,
        benchmark_failed_categories: failed_categories,
        benchmark_threshold: threshold,
        benchmark: benchmark,
        weights: map{
            validation_regression: score.weights,
            benchmark_pass_rate: -0.15,
            benchmark_average_score: -0.10,
            benchmark_failed: 0.03,
            benchmark_failed_category: 0.08
        }
    };
}

fn _candidate_selection(c) {
    return try c.selection catch _candidate_selection_from_parts(c.after.valid_loss, c.summary.regression, try c.ckpt.benchmark_gate catch nil);
}

fn _candidate_light(c) {
    let sel = _candidate_selection(c);
    return map{
        format: c.format,
        screening_mode: try c.screening_mode catch "full-regression-finalist",
        epochs: c.epochs,
        lr: c.lr,
        train_error_delta: c.train_error_delta,
        valid_error_delta: c.valid_error_delta,
        train_loss: c.after.train_loss,
        valid_loss: c.after.valid_loss,
        selection: sel,
        regression_pass_rate: sel.regression_pass_rate,
        regression_average_score: sel.regression_average_score,
        benchmark_pass_rate: sel.benchmark_pass_rate,
        benchmark_average_score: sel.benchmark_average_score,
        benchmark_failed: sel.benchmark_failed,
        benchmark_threshold_passed: sel.benchmark_threshold_passed,
        benchmark_failed_categories: sel.benchmark_failed_categories,
        accuracy: c.summary.accuracy,
        perplexity: c.summary.perplexity,
        elite: c.summary.elite_selection.elite
    };
}

fn _take_examples(examples, max_count) {
    let out = [];
    let i = 0;
    while i < len(examples) and i < max_count {
        push(out, examples[i]);
        i = i + 1;
    }
    return out;
}

fn _copy_model_data(model) {
    return json_parse(json_stringify(model));
}

fn _example_slice(examples, start, end) {
    let out = [];
    let i = start;
    while i < end and i < len(examples) {
        push(out, examples[i]);
        i = i + 1;
    }
    return out;
}

fn _merge_lm_head_average(model, models) {
    if len(models) == 0 { return model; }
    let rows = len(model.lm_head);
    let cols = len(model.lm_head[0]);
    let r = 0;
    while r < rows {
        let c = 0;
        while c < cols {
            let total = 0.0;
            let i = 0;
            while i < len(models) {
                total = total + models[i].lm_head[r][c];
                i = i + 1;
            }
            model.lm_head[r][c] = total / len(models);
            c = c + 1;
        }
        r = r + 1;
    }
    let b = 0;
    while b < len(model.lm_bias) {
        let total_b = 0.0;
        let j = 0;
        while j < len(models) {
            total_b = total_b + models[j].lm_bias[b];
            j = j + 1;
        }
        model.lm_bias[b] = total_b / len(models);
        b = b + 1;
    }
    return model;
}

fn _hidden_cache_parallel(model, examples, workers = 4) {
    if workers < 1 { workers = 1; }
    if workers > len(examples) { workers = len(examples); }
    if workers < 1 { workers = 1; }
    let chunk = (len(examples) + workers - 1) / workers;
    let handles = [];
    let w = 0;
    while w < workers {
        let start = w * chunk;
        let end = start + chunk;
        if start < len(examples) {
            let shard_examples = _example_slice(examples, start, end);
            push(handles, spawn(fn() {
                let shard = [];
                let i = 0;
                while i < len(shard_examples) {
                    let hs = ATT.forward_hidden(model, shard_examples[i].x);
                    push(shard, map{ hidden: hs[len(hs) - 1], y: shard_examples[i].y });
                    i = i + 1;
                }
                return shard;
            }));
        }
        w = w + 1;
    }
    let cached = [];
    let h = 0;
    while h < len(handles) {
        let shard = join(handles[h]);
        let i = 0;
        while i < len(shard) {
            push(cached, shard[i]);
            i = i + 1;
        }
        h = h + 1;
    }
    return map{
        format: "pbai.max.hidden_cache.v1",
        mode: "parallel-transformer-hidden-cache",
        workers: len(handles),
        examples: len(cached),
        cached: cached
    };
}

fn _train_head_cached(model, cache, epochs, lr) {
    let last = 0.0;
    let e = 0;
    while e < epochs {
        let total = 0.0;
        let i = 0;
        while i < len(cache.cached) {
            total = total + TRAIN.lm_head_train_step(model, cache.cached[i].hidden, cache.cached[i].y, lr);
            i = i + 1;
        }
        if len(cache.cached) > 0 { last = total / len(cache.cached); }
        e = e + 1;
    }
    return map{
        format: "pblang.llm.training.run.v1",
        mode: "parallel-cached-hidden-lm-head-backprop",
        epochs: epochs,
        examples: len(cache.cached),
        final_loss: last,
        parallel_workers: cache.workers,
        cache_mode: cache.mode,
        merge: "deterministic-head-update-over-parallel-hidden-cache"
    };
}

fn _train_head_parallel(model, examples, epochs, lr, workers = 4) {
    if workers < 2 or len(examples) < 2 {
        let sequential = TRAIN.train_epochs(model, ATT.forward_hidden, examples, epochs, lr);
        sequential.parallel_workers = 1;
        sequential.merge = "sequential-fallback";
        return sequential;
    }
    return _train_head_cached(model, _hidden_cache_parallel(model, examples, workers), epochs, lr);
}

fn _rank_candidates(candidates) {
    let left = candidates;
    let ranked = [];
    while len(left) > 0 {
        let best_idx = 0;
        let i = 1;
        while i < len(left) {
            if _candidate_selection(left[i]).score < _candidate_selection(left[best_idx]).score { best_idx = i; }
            i = i + 1;
        }
        push(ranked, left[best_idx]);
        let next = [];
        let j = 0;
        while j < len(left) {
            if j != best_idx { push(next, left[j]); }
            j = j + 1;
        }
        left = next;
    }
    return ranked;
}

fn _spawn_continue_candidate(original_raw, tokenizer, examples, epochs, lr, binary_epochs) {
    return spawn(fn() {
        return _continue_candidate(original_raw, tokenizer, examples, epochs, lr, binary_epochs, "full");
    });
}

fn _spawn_quick_continue_candidate(original_raw, tokenizer, examples, epochs, lr) {
    return spawn(fn() {
        return _continue_candidate(original_raw, tokenizer, examples, epochs, lr, 0, "quick");
    });
}

fn resource_plan(max_examples = 1280, quick_candidates = 6, finalists = 2) {
    let quick_examples = max_examples / 4;
    if quick_examples < 120 { quick_examples = max_examples; }
    if quick_examples > 240 { quick_examples = 240; }
    if quick_examples >= max_examples { finalists = 0; }
    return map{
        format: "pbai.max.resource_plan.v1",
        mode: "parallel-two-stage-candidate-screening",
        full_examples: max_examples,
        quick_examples: quick_examples,
        quick_candidates: quick_candidates,
        full_finalists: finalists,
        quick_parallel_workers: quick_candidates,
        finalist_parallel_workers: finalists,
        saved_full_candidate_runs: quick_candidates - finalists,
        quick_screen_mode: "head-only-validation-no-regression",
        finalist_mode: "full-binary-feedback-deep-regression",
        checkpoint_write_policy: "workers never write checkpoint; only parent saves selected validation winner",
        reason: "screen every candidate cheaply in parallel with head-only validation, fully train only finalists in parallel, then save only the validation winner"
    };
}

fn continue_training(dir = "checkpoints/pbai-max", epochs = 2, lr = 0.01, binary_epochs = 1, max_examples = 1280) {
    let original_raw = fs_read(dir + "/checkpoint.json");
    let original = json_parse(original_raw);
    let tokenizer = try original.tokenizer_model catch tokenizer_train(192, 90000).tokenizer;
    let examples = _examples(tokenizer, training_context(), max_examples);
    let base_split = _representative_split(examples, 10);
    let base_before = TRAIN.error_report(original.model, ATT.logits, base_split.train, base_split.valid);
    let base_regression = _regression_report_for_model(tokenizer, original.model, 12);
    let base_benchmark = _benchmark_from_regression(base_regression);
    let base_selection = _candidate_selection_from_parts(base_before.valid_loss, base_regression, base_benchmark);

    let lr_values = [0.005, 0.01, 0.02];
    let epoch_values = [1, 2];
    let plan = resource_plan(max_examples, len(lr_values) * len(epoch_values), 2);
    let quick_examples = _take_examples(examples, plan.quick_examples);
    let quick_handles = [];
    let quick_candidates = [];
    let i = 0;
    while i < len(lr_values) {
        let j = 0;
        while j < len(epoch_values) {
            if plan.full_finalists > 0 {
                push(quick_handles, _spawn_quick_continue_candidate(original_raw, tokenizer, quick_examples, epoch_values[j], lr_values[i]));
            } else {
                push(quick_handles, _spawn_continue_candidate(original_raw, tokenizer, examples, epoch_values[j], lr_values[i], binary_epochs));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let qh = 0;
    while qh < len(quick_handles) {
        push(quick_candidates, join(quick_handles[qh]));
        qh = qh + 1;
    }
    let quick_ranked = _rank_candidates(quick_candidates);
    let finalist_handles = [];
    let finalists = [];
    let f = 0;
    while f < len(quick_ranked) and f < plan.full_finalists {
        let qc = quick_ranked[f];
        push(finalist_handles, _spawn_continue_candidate(original_raw, tokenizer, examples, qc.epochs, qc.lr, binary_epochs));
        f = f + 1;
    }
    let fh = 0;
    while fh < len(finalist_handles) {
        push(finalists, join(finalist_handles[fh]));
        fh = fh + 1;
    }
    let candidates = [];
    if len(finalists) > 0 { candidates = _rank_candidates(finalists); }
    else { candidates = quick_ranked; }
    let best = candidates[0];

    let rejected = [];
    let k = 0;
    while k < len(quick_ranked) {
        if quick_ranked[k].lr != best.lr or quick_ranked[k].epochs != best.epochs {
            push(rejected, _candidate_light(quick_ranked[k]));
        }
        k = k + 1;
    }
    let r2 = 0;
    while r2 < len(candidates) {
        if candidates[r2] != best { push(rejected, _candidate_light(candidates[r2])); }
        r2 = r2 + 1;
    }

    let quick_lights = [];
    let ql = 0;
    while ql < len(quick_ranked) {
        push(quick_lights, _candidate_light(quick_ranked[ql]));
        ql = ql + 1;
    }
    let finalist_lights = [];
    let fl = 0;
    while fl < len(candidates) {
        push(finalist_lights, _candidate_light(candidates[fl]));
        fl = fl + 1;
    }

    let tried = len(quick_candidates) + len(finalists);
    let full_tried = len(finalists);
    let quick_tried = len(quick_candidates);

    let best_selection = _candidate_selection(best);
    let valid_ok = best.after.valid_loss <= base_before.valid_loss;
    let regression_ok = best_selection.regression_pass_rate > base_selection.regression_pass_rate
        or (best_selection.regression_pass_rate == base_selection.regression_pass_rate and best_selection.regression_average_score > base_selection.regression_average_score);
    let benchmark_nonregression = best_selection.benchmark_threshold_passed
        and best_selection.benchmark_pass_rate >= base_selection.benchmark_pass_rate
        and best_selection.benchmark_average_score >= base_selection.benchmark_average_score;
    let benchmark_ok = best_selection.benchmark_threshold_passed
        and (best_selection.benchmark_pass_rate > base_selection.benchmark_pass_rate
        or (best_selection.benchmark_pass_rate == base_selection.benchmark_pass_rate and best_selection.benchmark_average_score > base_selection.benchmark_average_score));
    let valid_tolerance_ok = best.after.valid_loss <= base_before.valid_loss + 0.05;
    let accepted = (valid_ok and benchmark_nonregression) or (regression_ok and benchmark_ok and valid_tolerance_ok);
    let accepted_reason = "best candidate improved prompt regression within validation tolerance";
    if valid_ok and benchmark_nonregression { accepted_reason = "best candidate improved or matched validation loss without benchmark regression"; }
    if regression_ok and benchmark_ok and valid_tolerance_ok and not valid_ok { accepted_reason = "best candidate improved prompt regression and benchmark within validation tolerance"; }
    if accepted {
        let saved = save_checkpoint(dir, best.ckpt);
        return map{
            format: "pbai.max.continue_result.v1",
            accepted: true,
            reason: accepted_reason,
            resource_plan: plan,
            before: base_before,
            before_regression: base_regression,
            before_benchmark: base_benchmark,
            before_selection: base_selection,
            after: best.after,
            after_selection: best_selection,
            acceptance_policy: map{
                format: "pbai.max.acceptance_policy.v1",
                mode: "validation-plus-benchmark-or-regression-plus-benchmark-with-validation-tolerance",
                valid_ok: valid_ok,
                regression_ok: regression_ok,
                benchmark_ok: benchmark_ok,
                benchmark_nonregression: benchmark_nonregression,
                benchmark_threshold_passed: best_selection.benchmark_threshold_passed,
                benchmark_failed_categories: best_selection.benchmark_failed_categories,
                valid_tolerance_ok: valid_tolerance_ok,
                valid_tolerance: 0.05,
                rule: "save only when validation improves without benchmark category regression, or regression and benchmark category thresholds improve within validation tolerance"
            },
            tried: tried,
            quick_tried: quick_tried,
            full_tried: full_tried,
            quick_candidates: quick_lights,
            finalists: finalist_lights,
            best_candidate: _candidate_light(best),
            rejected_candidates: rejected,
            saved: saved,
            summary: checkpoint_summary(best.ckpt)
        };
    }
    fs_write(dir + "/candidate-rejected.json", json_stringify(map{
        format: "pbai.max.rejected_candidates.v1",
        reason: "all candidates failed validation/regression acceptance policy",
        resource_plan: plan,
        before: base_before,
        before_regression: base_regression,
        before_benchmark: base_benchmark,
        before_selection: base_selection,
        best_selection: best_selection,
        tried: tried,
        quick_tried: quick_tried,
        full_tried: full_tried,
        quick_candidates: quick_lights,
        finalists: finalist_lights,
        best_rejected: _candidate_light(best),
        rejected_candidates: rejected
    }));
    fs_write(dir + "/checkpoint.json", original_raw);
    return map{
        format: "pbai.max.continue_result.v1",
        accepted: false,
        reason: "all candidates failed validation/regression acceptance policy; current checkpoint kept",
        resource_plan: plan,
        before: base_before,
        before_regression: base_regression,
        before_benchmark: base_benchmark,
        before_selection: base_selection,
        after: best.after,
        after_selection: best_selection,
        acceptance_policy: map{
            format: "pbai.max.acceptance_policy.v1",
            mode: "validation-plus-benchmark-or-regression-plus-benchmark-with-validation-tolerance",
            valid_ok: valid_ok,
            regression_ok: regression_ok,
            benchmark_ok: benchmark_ok,
            benchmark_nonregression: benchmark_nonregression,
            benchmark_threshold_passed: best_selection.benchmark_threshold_passed,
            benchmark_failed_categories: best_selection.benchmark_failed_categories,
            valid_tolerance_ok: valid_tolerance_ok,
            valid_tolerance: 0.05,
            rule: "save only when validation improves without benchmark category regression, or regression and benchmark category thresholds improve within validation tolerance"
        },
        tried: tried,
        quick_tried: quick_tried,
        full_tried: full_tried,
        quick_candidates: quick_lights,
        finalists: finalist_lights,
        best_candidate: _candidate_light(best),
        rejected_candidates: rejected,
        rejected_file: dir + "/candidate-rejected.json",
        kept_summary: checkpoint_summary(original),
        rejected_summary: checkpoint_summary(best.ckpt)
    };
}

fn teach_live(dir = "checkpoints/pbai-max", text = "", epochs = 1, lr = 0.01, max_examples = 1280) {
    let remembered = remember_lesson(text, "pbAI-Max taught lesson");
    let existing = try load_checkpoint(dir) catch nil;
    let result = nil;
    if existing == nil {
        result = save_checkpoint(dir, train_checkpoint(epochs, lr, 4, 1, max_examples));
    } else {
        result = continue_training(dir, epochs, lr, 1, max_examples);
    }
    return map{
        format: "pbai.max.teach_live.v1",
        remembered: remembered,
        training: result,
        personality: personality_profile(),
        live_learning: live_learning_status()
    };
}

fn ensure_checkpoint(dir = "checkpoints/pbai-max", epochs = 3, lr = 0.05) {
    let ckpt = try load_checkpoint(dir) catch nil;
    if ckpt != nil { return ckpt; }
    ckpt = train_checkpoint(epochs, lr);
    save_checkpoint(dir, ckpt);
    return ckpt;
}

fn generate_saved(prompt, n = 16, dir = "checkpoints/pbai-max") {
    return generate_ranked_saved(prompt, n, dir).text;
}

fn generate_ranked_saved(prompt, n = 16, dir = "checkpoints/pbai-max", expected = nil, forbidden = nil, min_generated = 1) {
    return generate_ranked_cached(ensure_checkpoint(dir, 3, 0.05), prompt, n, expected, forbidden, min_generated);
}

fn generate_verified_saved(prompt, n = 16, dir = "checkpoints/pbai-max", expected = nil, forbidden = nil, min_generated = 1) {
    return generate_verified_ranked(ensure_checkpoint(dir, 3, 0.05), prompt, n, expected, forbidden, min_generated);
}

fn stream_status(chunk_chars = 64, stride = 32) {
    let st = STREAM.from_records(source_records(), chunk_chars, stride);
    let first = STREAM.next_chunk(st);
    let second = STREAM.next_chunk(st);
    return map{
        format: "pbai.max.stream_status.v1",
        implementation_status: "prototype-status-only",
        note: "Reports deterministic corpus chunk status; not a live async streaming trainer yet.",
        stats: STREAM.stats(st),
        first_done: first.done,
        second_done: second.done,
        first_path: try first.path catch "",
        second_path: try second.path catch ""
    };
}

fn distillation_targets() {
    return [
        map{
            format: "pbai.max.distillation_target.v1",
            tier: "pbAI-Pro",
            source: "pbAI-Max",
            role: "large local assistant distilled from Max teacher outputs and verifier traces",
            target_param_ratio: 0.50,
            target_context: 12,
            keep: ["ranked generation", "memory retrieval", "tool/verifier traces", "personality policy"]
        },
        map{
            format: "pbai.max.distillation_target.v1",
            tier: "pbAI-Mini",
            source: "pbAI-Max",
            role: "fast portable assistant for default local use",
            target_param_ratio: 0.20,
            target_context: 8,
            keep: ["pblang syntax", "math basics", "safe live learning", "retrieval summaries"]
        },
        map{
            format: "pbai.max.distillation_target.v1",
            tier: "pbAI-Nano",
            source: "pbAI-Max",
            owner: "pblang stdlib / Nano foundation",
            role: "small boot/runtime model that inherits Max lessons without owning Max product policy",
            target_param_ratio: 0.05,
            target_context: 6,
            keep: ["tokenizer contract", "syntax fixes", "safety rules", "fallback answers"]
        }
    ];
}

fn _sealed_eval_prompt_hashes() {
    let hashes = [];
    let regs = regression_cases();
    let i = 0;
    while i < len(regs) { push(hashes, sha256(str_trim(regs[i].prompt))); i = i + 1; }
    let cases = benchmark_cases();
    let j = 0;
    while j < len(cases) { push(hashes, sha256(str_trim(cases[j].prompt))); j = j + 1; }
    return hashes;
}

fn _distillation_curriculum() {
    return [
        map{ id:"train-function-parameters", category:"pblang-coding", prompt:"Teach a new learner how pblang function parameters and return values fit together.", expected:["fn", "return"], teacher_text:"In pblang, declare parameters inside the function parentheses and return a value explicitly. For example, `fn double(x) { return x * 2; }` keeps the input, computation, and result easy to verify." },
        map{ id:"train-loop-counter", category:"pblang-coding", prompt:"Explain a bounded counter loop without using an evaluation fixture.", expected:["while", "bounded"], teacher_text:"A bounded counter loop initializes a local number, checks a clear upper limit, and increments exactly once per iteration. Keeping the limit explicit prevents accidental unbounded work and makes the loop testable." },
        map{ id:"train-map-access", category:"pblang-coding", prompt:"Teach safe optional map-field access in pblang.", expected:["try", "catch"], teacher_text:"Treat optional map fields as fallible input. Read them through `try value.field catch fallback`, validate the resulting type and bounds, and never let a missing field silently grant a capability." },
        map{ id:"train-error-boundary", category:"safety", prompt:"Describe a fail-closed boundary for a local operation.", expected:["fail", "closed"], teacher_text:"A fail-closed boundary validates inputs before effects, catches a bounded failure, reports a reason, and leaves persistent state unchanged. Unknown or malformed evidence must never be converted into approval." },
        map{ id:"train-local-memory", category:"memory", prompt:"Explain how a local AI should store an explicitly approved lesson.", expected:["source", "lesson"], teacher_text:"An approved local lesson should carry a source identifier, a content digest, sanitization evidence, and an explicit persistence decision. Retrieval can cite the lesson, but training remains a separate admitted action." },
        map{ id:"train-retrieval-citation", category:"retrieval", prompt:"Teach why a retrieved answer needs evidence metadata.", expected:["source", "score"], teacher_text:"A retrieval result is useful when it includes a redacted source identifier, a relevance score, a bounded snippet, and the policy decision that permits its use. The answer should distinguish retrieved evidence from inference." },
        map{ id:"train-tool-authorization", category:"tools", prompt:"Explain scoped authorization before an AI tool action.", expected:["authorization", "scope"], teacher_text:"Before a tool action, verify the named capability, target, input limits, and user-approved scope. A planning result is not authorization, and failed verification must leave the external system unchanged." },
        map{ id:"train-secret-boundary", category:"safety", prompt:"Teach a model how to treat possible secrets in training material.", expected:["secret", "reject"], teacher_text:"Possible credentials, bearer tokens, private keys, session data, and password material must be rejected or redacted before persistence. The original sensitive value must not appear in logs, fixtures, or model records." },
        map{ id:"train-dataset-provenance", category:"safety", prompt:"Explain the minimum provenance needed before dataset training.", expected:["rights", "consent"], teacher_text:"Dataset training needs a stable source ID, acquisition grant, rights or license basis, consent when another person is involved, privacy and poisoning scans, deduplication, and a sealed train/evaluation split." },
        map{ id:"train-verifier-independence", category:"tools", prompt:"Teach why a producer should not approve its own generated action.", expected:["independent", "verifier"], teacher_text:"The component that proposes output should not be its only judge. An independent verifier checks structure, evidence, policy, and authorization, and it can reject the candidate without executing it." },
        map{ id:"train-safe-math", category:"math", prompt:"Explain how to solve a small arithmetic task with an explicit check.", expected:["check", "result"], teacher_text:"Compute the small arithmetic result step by step, then verify it with the inverse operation or a second calculation. If an operation is undefined, report that boundary instead of inventing a number." },
        map{ id:"train-model-identity", category:"memory", prompt:"Describe the current pbAI family without overstating its capabilities.", expected:["pblang", "local"], teacher_text:"pbAI is a local pblang-native family with a small Nano model, grounded skills, memory, tools, planning, and verification foundations. It is measurable and expandable, but it is not yet frontier-equivalent or production-complete." }
    ];
}

fn _contains(values, wanted) {
    let i = 0;
    while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _distillation_prompt_records(limit = 12) {
    if limit < 1 { limit = 1; }
    if limit > 24 { limit = 24; }
    let records = [];
    let curriculum = _distillation_curriculum();
    let i = 0;
    while i < len(curriculum) and len(records) < limit {
        let digest = sha256(str_trim(curriculum[i].prompt));
        if not _contains(_sealed_eval_prompt_hashes(), digest) {
            push(records, map{
                format: "pbai.max.distillation_prompt.v2",
                id: curriculum[i].id, category: curriculum[i].category,
                prompt: curriculum[i].prompt, expected: curriculum[i].expected,
                forbidden: ["undefined", "nan", "<unk>"], min_generated: 1,
                teacher_text: curriculum[i].teacher_text,
                source: "pbai.max.distillation_curriculum",
                split: "train", normalized_sha256: digest, eval_overlap: false
            });
        }
        i = i + 1;
    }
    return records;
}

fn _distillation_expected_text(expected, prompt) {
    if len(expected) > 0 { return str(expected[0]); }
    return prompt;
}

fn _curated_teacher_text(record_id, expected, prompt) {
    if record_id == "regression-pblang_fn_seed" {
        return "A useful pblang function starts with `fn name(args) { ... }`, returns with `return`, and can print with the `print x;` statement. Example: fn add(a, b) { return a + b; }";
    }
    if record_id == "regression-pblang_let_seed" {
        return "`let` creates a local binding in pblang. Use `let name = value;` and keep the equals sign explicit. Example: let total = 0; total = total + 1;";
    }
    if record_id == "regression-pblang_print_seed" {
        return "`print` is a pblang statement, not a function call. Use `print x;`, not `print(x);`. This is one of the most common syntax repairs pbAI should remember.";
    }
    if record_id == "regression-pbai_identity_seed" {
        return "pbAI-Max is the flagship pblang-native model tier. It uses local pblang tokenizer, model, memory, tools, verification, distillation, and routed Pro/Mini/Nano students.";
    }
    if record_id == "benchmark-pblang-print-statement" {
        return "Bug review: `print(s)` is invalid in pblang because print is a statement. Write `print s;`. The `fs_read(path)` call is fallible and capability-sensitive, so safer code should use `try fs_read(path) catch \"\"` and mention filesystem capability review.";
    }
    if record_id == "benchmark-pblang-try-catch-io" {
        return "Filesystem reads should be treated as fallible and sensitive. Prefer `let text = try fs_read(path) catch \"\";` and verify the capability boundary before reading arbitrary paths.";
    }
    if record_id == "benchmark-integer-arithmetic" {
        return "Arithmetic facts: 1 + 1 = 2. For 27 / 9, the quotient is 3 and the remainder is 0. pbAI should answer these directly before guessing.";
    }
    if record_id == "benchmark-safe-division-mean" {
        return "For mean([2,4,6]), add 2 + 4 + 6 = 12 and divide by 3 to get 4. For safe division by zero, return a guarded value such as 0 instead of crashing.";
    }
    if record_id == "benchmark-live-memory-recall" {
        return "Memory answers should be sourced. Return a source name, a short snippet, and a confidence score instead of claiming unsourced recall.";
    }
    if record_id == "benchmark-live-learning-status" {
        return "Live learning is enabled through local lessons and adapters. A lesson should be stored, trained or adapted, verified, and kept separate from unsafe background ingestion.";
    }
    if record_id == "benchmark-vector-retrieval" {
        return "Vector retrieval uses pblang-native Turbovec-style embeddings. A useful result includes source, score, snippet, and whether the retrieved fact is safe to use in the answer.";
    }
    if record_id == "benchmark-retrieval-feedback-loop" {
        return "The feedback loop compares before and after states, records reward or punish, keeps strong candidates, rejects weaker ones, and turns successful traces into future lessons.";
    }
    if record_id == "benchmark-tool-catalog" {
        return "pbAI can use local pblang stdlib tools, pb-mcp-server tool families, code indexing, datasets, file readers, OCR/media helpers, and verification runners through capability-gated local APIs.";
    }
    if record_id == "benchmark-tool-secret-exclusions" {
        return "Do not blindly ingest credentials, API tokens, SSH keys, `.env` files, private browser/session data, or unrelated personal files. Use secret filters and explicit user-approved roots.";
    }
    if record_id == "benchmark-secret-redaction" {
        return "Secret handling rule: redact API keys, bearer tokens, passwords, and credentials before storing or training. Keep safe code text, but replace sensitive values with `[redacted]`.";
    }
    if record_id == "benchmark-secret-path-filter" {
        return "Path filtering should block secret-looking names such as `.env`, `id_ed25519`, token files, and credential exports, while allowing safe notes or explicitly approved datasets.";
    }
    return _distillation_expected_text(expected, prompt);
}

fn _distillation_record(prompt_record, ckpt, n) {
    let expected = try prompt_record.expected catch [];
    let forbidden = try prompt_record.forbidden catch ["undefined", "nan", "<unk>"];
    let min_generated = try prompt_record.min_generated catch 1;
    let teacher_text = try prompt_record.teacher_text catch _curated_teacher_text(prompt_record.id, expected, prompt_record.prompt);
    let ranked = nil;
    let verified = nil;
    let verifier_score = 1.0;
    let rank_score = 0.0;
    let generated = false;
    let teacher_text_source = "curated";
    if ckpt != nil {
        ranked = generate_ranked(ckpt, prompt_record.prompt, n, expected, forbidden, min_generated);
        verified = _verified_ranked_generation(ranked, prompt_record.prompt, expected, forbidden);
        teacher_text = verified.text;
        teacher_text_source = try verified.selected.kind catch "verified";
        verifier_score = try verified.selected.strict_verifier.score catch 0.0;
        rank_score = try verified.selected.strict_rank_score catch 0.0;
        generated = true;
    }
    return map{
        format: "pbai.max.distillation_record.v1",
        id: prompt_record.id,
        category: prompt_record.category,
        prompt: prompt_record.prompt,
        prompt_sha256: prompt_record.normalized_sha256,
        source: prompt_record.source,
        split: prompt_record.split,
        eval_overlap: prompt_record.eval_overlap,
        expected: expected,
        forbidden: forbidden,
        teacher: "pbAI-Max",
        teacher_text: teacher_text,
        teacher_text_source: teacher_text_source,
        teacher_text_chars: len(teacher_text),
        generated_with_checkpoint: generated,
        verifier_score: verifier_score,
        rank_score: rank_score,
        ranked_generation: ranked,
        verified_generation: verified,
        student_targets: ["pbAI-Pro", "pbAI-Mini", "pbAI-Nano"],
        loss_contract: "students train on teacher_text plus expected tokens; verifier traces are used for rejection"
    };
}

fn distillation_teacher_quality(records, min_chars = 40, min_score = 0.65) {
    return EVAL.teacher_dataset_quality(records, min_chars, min_score);
}

fn distillation_acceptance_gate(valid_loss_after, valid_loss_before, threshold, teacher_quality) {
    let validation_improved = valid_loss_after <= valid_loss_before;
    let benchmark_passed = try threshold.passed catch false;
    let teacher_quality_passed = try teacher_quality.passed catch false;
    let reasons = [];
    if not validation_improved { push(reasons, "validation-worse"); }
    if not benchmark_passed { push(reasons, "benchmark-threshold-failed"); }
    if not teacher_quality_passed { push(reasons, "teacher-quality-failed"); }
    return map{
        format: "pbai.max.distillation_acceptance_gate.v1",
        passed: validation_improved and benchmark_passed and teacher_quality_passed,
        validation_improved: validation_improved,
        benchmark_passed: benchmark_passed,
        teacher_quality_passed: teacher_quality_passed,
        reasons: reasons
    };
}

fn distillation_dataset(ckpt = nil, max_records = 8, n = 4) {
    if max_records < 1 { max_records = 1; }
    if max_records > 16 { max_records = 16; }
    if n < 1 { n = 1; }
    if n > 12 { n = 12; }
    let prompts = _distillation_prompt_records(max_records);
    let records = [];
    let i = 0;
    while i < len(prompts) {
        push(records, _distillation_record(prompts[i], ckpt, n));
        i = i + 1;
    }
    let teacher_chars = 0;
    let tc_i = 0;
    while tc_i < len(records) {
        teacher_chars = teacher_chars + records[tc_i].teacher_text_chars;
        tc_i = tc_i + 1;
    }
    let avg_teacher_chars = 0.0;
    if len(records) > 0 { avg_teacher_chars = teacher_chars / len(records); }
    let teacher_quality = distillation_teacher_quality(records, 40, 0.65);
    let bench = benchmark_suite(ckpt, n);
    let eval_overlap_count = 0;
    let overlap_i = 0;
    while overlap_i < len(records) {
        if try records[overlap_i].eval_overlap catch true { eval_overlap_count = eval_overlap_count + 1; }
        overlap_i = overlap_i + 1;
    }
    return map{
        format: "pbai.max.distillation_dataset.v1",
        implementation_status: "curated-teacher-records",
        teacher: "pbAI-Max",
        generated_with_checkpoint: ckpt != nil,
        records_count: len(records),
        records: records,
        split: "train", sealed_evaluation_excluded: true,
        eval_overlap_count: eval_overlap_count,
        teacher_chars: teacher_chars,
        avg_teacher_chars: avg_teacher_chars,
        teacher_quality: teacher_quality,
        targets: distillation_targets(),
        benchmark: bench,
        acceptance_gate: bench.threshold_report,
        safety: "do not ingest secrets; keep sourced memory and verifier traces with every teacher sample; never train on sealed regression or benchmark prompts",
        quality_policy: "checkpoint-free distillation uses curated multi-sentence teacher answers and pblang llm_eval teacher-quality gates"
    };
}

fn distillation_preview(ckpt = nil, max_records = 8, n = 4) {
    let dataset = distillation_dataset(ckpt, max_records, n);
    return map{
        format: "pbai.max.distillation_preview.v1",
        implementation_status: "student-training-available",
        note: "Teacher records, student targets, acceptance gates, and bounded student training are implemented.",
        teacher: "pbAI-Max",
        targets: distillation_targets(),
        dataset: dataset,
        acceptance_gate: dataset.acceptance_gate,
        next_steps: [
            "Scale pbAI-Pro/Mini/Nano students beyond the current bounded semantic-test budgets",
            "Use validation plus benchmark thresholds before saving any student",
            "Keep Nano runtime ownership inside pblang while Max policy stays in AAP/products/pbai"
        ]
    };
}

fn _distillation_student_records(dataset, tier = "pbAI-Mini") {
    let out = [];
    let i = 0;
    while i < len(dataset.records) {
        let r = dataset.records[i];
        let verify_ok = true;
        if r.verified_generation != nil {
            verify_ok = try r.verified_generation.passed catch false;
        }
        let source = try r.teacher_text_source catch "expected";
        let teacher_text = str(r.teacher_text);
        if not verify_ok {
            teacher_text = fallback_generation_text(r.prompt, r.expected);
            source = "fallback";
        }
        let text = "### prompt\n" + str(r.prompt) + "\n### " + tier + " verified teacher\n" + teacher_text + "\n";
        push(out, DATA.corpus_record("pbai-max/distill/" + tier + "/" + r.id, text, "distillation"));
        i = i + 1;
    }
    return out;
}

fn _distillation_teacher_source_counts(dataset) {
    let expected = 0;
    let curated = 0;
    let original = 0;
    let repair = 0;
    let fallback = 0;
    let other = 0;
    let verified = 0;
    let i = 0;
    while i < len(dataset.records) {
        let src = try dataset.records[i].teacher_text_source catch "expected";
        if src == "expected" { expected = expected + 1; }
        else if src == "curated" { curated = curated + 1; }
        else if src == "original" { original = original + 1; }
        else if src == "repair" { repair = repair + 1; }
        else if src == "fallback" { fallback = fallback + 1; }
        else { other = other + 1; }
        if dataset.records[i].verified_generation != nil and dataset.records[i].verified_generation.passed {
            verified = verified + 1;
        }
        i = i + 1;
    }
    return map{
        format: "pbai.max.distillation_teacher_sources.v1",
        expected: expected,
        curated: curated,
        original: original,
        repair: repair,
        fallback: fallback,
        other: other,
        verified_checkpoint_records: verified
    };
}

fn _distillation_tokenizer(records, vocab_limit = 160, max_chars = 40000) {
    return TTRAIN.train_bpe_records(records, vocab_limit, 2, max_chars);
}

fn train_distilled_student(ckpt = nil, tier = "pbAI-Mini", epochs = 1, lr = 0.02, max_records = 8, n = 4) {
    if epochs < 1 { epochs = 1; }
    if epochs > 4 { epochs = 4; }
    if lr <= 0 { lr = 0.01; }
    if lr > 0.05 { lr = 0.05; }
    let target = _student_target(tier);
    let dataset = distillation_dataset(ckpt, max_records, n);
    let records = _distillation_student_records(dataset, target.tier);
    let trun = _distillation_tokenizer(records, 160, 40000);
    let model = _student_model_new(target, trun.summary.vocab_size);
    let examples = _examples_from_records(trun.tokenizer, records, target.target_context, max_records * 48);
    let split = _representative_split(examples, 5);
    let loss_before = TRAIN.avg_loss(model, ATT.logits, split.train);
    let valid_before = TRAIN.avg_loss(model, ATT.logits, split.valid);
    let train_run = _train_head_parallel(model, split.train, epochs, lr, training_workers());
    let binary_run = TRAIN.train_binary_adapter_epochs(model, ATT.forward_hidden, split.train, 1, lr, lr * 0.4);
    let deep_run = TRAIN.train_analytic_deep_inputs(model, ATT.forward_hidden, split.train, 1, lr * 0.5, lr * 0.08, lr * 0.08, 64);
    let train_eval = EVAL.evaluate(model, ATT.logits, split.train);
    let valid_eval = EVAL.evaluate(model, ATT.logits, split.valid);
    let bench = benchmark_suite(ckpt, n);
    let threshold = benchmark_threshold_report(bench);
    let params = WEIGHTS.estimate_params(model);
    let acceptance = distillation_acceptance_gate(valid_eval.loss, valid_before, threshold, dataset.teacher_quality);
    let manifest = WEIGHTS.manifest(model, trun.summary, target.tier, "pbAI-Max");
    return map{
        format: "pbai.max.distilled_student_checkpoint.v1",
        implementation_status: "bounded-student-training",
        tier: target.tier,
        teacher: "pbAI-Max",
        target: target,
        target_config: model.config,
        tokenizer: trun.summary,
        tokenizer_model: trun.tokenizer,
        model: model,
        manifest: manifest,
        params: params,
        records: len(records),
        dataset: dataset,
        teacher_sources: _distillation_teacher_source_counts(dataset),
        examples: map{ format: "pbai.max.distilled_student_examples.v1", total: len(examples), train: len(split.train), valid: len(split.valid), split: split.format },
        training: train_run,
        binary_training: binary_run,
        deep_training: deep_run,
        eval: train_eval,
        validation: map{ format: "pbai.max.distilled_student_validation.v1", loss_before: valid_before, eval: valid_eval },
        metrics: map{ loss_before: loss_before, valid_loss_before: valid_before, loss_after: train_eval.loss, valid_loss_after: valid_eval.loss, perplexity: valid_eval.perplexity, accuracy: valid_eval.accuracy },
        benchmark_gate: bench,
        threshold_gate: threshold,
        teacher_quality_gate: dataset.teacher_quality,
        acceptance_gate: acceptance,
        accepted_for_save: acceptance.passed,
        touches_teacher_checkpoint: false,
        cache: CACHE.put("max-distilled-student-" + target.tier, "records=" + str(len(records)) + ";epochs=" + str(epochs), map{
            format: "pbai.max.distilled_student_cache.v1",
            tier: target.tier,
            params: params,
            valid_loss: valid_eval.loss,
            accepted: acceptance.passed
        })
    };
}

fn distill_family(ckpt = nil, epochs = 1, lr = 0.02, max_records = 8, n = 4) {
    let targets = distillation_targets();
    let students = [];
    let i = 0;
    while i < len(targets) {
        push(students, train_distilled_student(ckpt, targets[i].tier, epochs, lr, max_records, n));
        i = i + 1;
    }
    let accepted = 0;
    let j = 0;
    while j < len(students) {
        if students[j].accepted_for_save { accepted = accepted + 1; }
        j = j + 1;
    }
    return map{
        format: "pbai.max.distillation_family.v1",
        implementation_status: "bounded-student-training",
        teacher: "pbAI-Max",
        students: students,
        student_count: len(students),
        accepted_count: accepted,
        policy: "train small Pro/Mini/Nano students only from verified teacher records; save only after validation/benchmark gates"
    };
}

fn save_distilled_student(dir, student) {
    if dir == "" { dir = DEFAULT_CHECKPOINT_DIR + "/students/" + student.tier; }
    fs_mkdirs(dir);
    fs_write(dir + "/student.json", json_stringify(student));
    fs_write(dir + "/manifest.json", json_stringify(student.manifest));
    return map{
        format: "pbai.max.distilled_student_save.v1",
        ok: true,
        dir: dir,
        tier: student.tier,
        accepted_for_save: student.accepted_for_save,
        files: [dir + "/student.json", dir + "/manifest.json"]
    };
}

fn load_distilled_student(dir) {
    return json_parse(fs_read(dir + "/student.json"));
}

fn distilled_student_summary(student) {
    return map{
        format: "pbai.max.distilled_student_summary.v1",
        tier: student.tier,
        teacher: student.teacher,
        checkpoint_format: student.format,
        implementation_status: student.implementation_status,
        params: student.params,
        vocab: student.tokenizer.vocab_size,
        context: student.target_config.context,
        d_model: student.target_config.d_model,
        layers: student.target_config.layers,
        heads: student.target_config.heads,
        records: student.records,
        train_examples: student.examples.train,
        valid_examples: student.examples.valid,
        train_loss: student.metrics.loss_after,
        valid_loss: student.metrics.valid_loss_after,
        valid_loss_before: student.metrics.valid_loss_before,
        perplexity: student.metrics.perplexity,
        accuracy: student.metrics.accuracy,
        training_mode: student.training.mode,
        training_workers: try student.training.parallel_workers catch 1,
        binary_training: student.binary_training.mode,
        deep_training: student.deep_training.mode,
        threshold_passed: student.threshold_gate.passed,
        accepted_for_save: student.accepted_for_save,
        teacher_sources: student.teacher_sources,
        touches_teacher_checkpoint: student.touches_teacher_checkpoint
    };
}

fn evaluate_distilled_student(student, max_examples = 256) {
    if max_examples < 1 { max_examples = 1; }
    if max_examples > 1024 { max_examples = 1024; }
    let records = _distillation_student_records(student.dataset, student.tier);
    let tokenizer = try student.tokenizer_model catch _distillation_tokenizer(records, student.tokenizer.vocab_size, 40000).tokenizer;
    let context = try student.target_config.context catch 6;
    let examples = _examples_from_records(tokenizer, records, context, max_examples);
    let split = _representative_split(examples, 5);
    let train_eval = EVAL.evaluate(student.model, ATT.logits, split.train);
    let valid_eval = EVAL.evaluate(student.model, ATT.logits, split.valid);
    return map{
        format: "pbai.max.distilled_student_eval.v1",
        tier: student.tier,
        teacher: student.teacher,
        examples: len(examples),
        train_examples: len(split.train),
        valid_examples: len(split.valid),
        train: train_eval,
        validation: valid_eval,
        accepted_for_save: student.accepted_for_save,
        threshold_passed: student.threshold_gate.passed,
        summary: distilled_student_summary(student)
    };
}

fn generate_distilled_student_ranked(student, prompt, n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    let tokenizer = try student.tokenizer_model catch nil;
    if tokenizer == nil {
        let records = _distillation_student_records(student.dataset, student.tier);
        tokenizer = _distillation_tokenizer(records, student.tokenizer.vocab_size, 40000).tokenizer;
    }
    let ranked = _ranked_generation_for_model(tokenizer, student.model, prompt, n, expected, forbidden, min_generated);
    ranked.format = "pbai.max.distilled_student_ranked_generation.v1";
    ranked.tier = student.tier;
    ranked.teacher = student.teacher;
    ranked.student_summary = distilled_student_summary(student);
    return ranked;
}

fn generate_distilled_student(student, prompt, n = 16) {
    return generate_distilled_student_ranked(student, prompt, n, [prompt], ["undefined", "nan", "<unk>"], 1).text;
}

fn save_distilled_family(dir, family) {
    if dir == "" { dir = DEFAULT_CHECKPOINT_DIR + "/students"; }
    fs_mkdirs(dir);
    let saves = [];
    let summaries = [];
    let i = 0;
    while i < len(family.students) {
        let tier_dir = dir + "/" + family.students[i].tier;
        let saved = save_distilled_student(tier_dir, family.students[i]);
        push(saves, saved);
        push(summaries, distilled_student_summary(family.students[i]));
        i = i + 1;
    }
    let index = map{
        format: "pbai.max.distilled_family_index.v1",
        teacher: family.teacher,
        family_format: family.format,
        implementation_status: family.implementation_status,
        student_count: family.student_count,
        accepted_count: family.accepted_count,
        policy: family.policy,
        students: summaries
    };
    fs_write(dir + "/family.json", json_stringify(family));
    fs_write(dir + "/index.json", json_stringify(index));
    return map{
        format: "pbai.max.distilled_family_save.v1",
        ok: true,
        dir: dir,
        index_file: dir + "/index.json",
        family_file: dir + "/family.json",
        student_count: family.student_count,
        accepted_count: family.accepted_count,
        saves: saves,
        index: index
    };
}

fn distilled_family_summary_saved(dir = "checkpoints/pbai-max/students") {
    return json_parse(fs_read(dir + "/index.json"));
}

fn _distilled_student_dir(dir, tier) {
    if dir == "" { dir = DEFAULT_CHECKPOINT_DIR + "/students"; }
    return dir + "/" + tier;
}

fn evaluate_distilled_student_saved(dir = "checkpoints/pbai-max/students", tier = "pbAI-Mini", max_examples = 256) {
    return evaluate_distilled_student(load_distilled_student(_distilled_student_dir(dir, tier)), max_examples);
}

fn generate_distilled_student_saved(dir = "checkpoints/pbai-max/students", tier = "pbAI-Mini", prompt = "fn ", n = 16) {
    return generate_distilled_student(load_distilled_student(_distilled_student_dir(dir, tier)), prompt, n);
}

fn generate_distilled_student_ranked_saved(dir = "checkpoints/pbai-max/students", tier = "pbAI-Mini", prompt = "fn ", n = 16, expected = nil, forbidden = nil, min_generated = 1) {
    return generate_distilled_student_ranked(load_distilled_student(_distilled_student_dir(dir, tier)), prompt, n, expected, forbidden, min_generated);
}

fn evaluate_distilled_family_saved(dir = "checkpoints/pbai-max/students", max_examples = 256) {
    if dir == "" { dir = DEFAULT_CHECKPOINT_DIR + "/students"; }
    let index = distilled_family_summary_saved(dir);
    let evals = [];
    let i = 0;
    while i < len(index.students) {
        push(evals, evaluate_distilled_student_saved(dir, index.students[i].tier, max_examples));
        i = i + 1;
    }
    return map{
        format: "pbai.max.distilled_family_eval.v1",
        dir: dir,
        index: index,
        student_count: len(evals),
        evals: evals
    };
}

fn route_distilled_tier(prompt, dir = "checkpoints/pbai-max/students") {
    if dir == "" { dir = DEFAULT_CHECKPOINT_DIR + "/students"; }
    let t = str_lower(str(prompt));
    let tier = "pbAI-Mini";
    let reason = "general-local-assistant";
    let confidence = 0.62;
    if str_contains(t, "fn ") or str_contains(t, "find bugs") or str_contains(t, "review") or str_contains(t, "tool") or str_contains(t, "mcp") or len(t) > 160 {
        tier = "pbAI-Pro";
        reason = "code-tool-or-long-context";
        confidence = 0.78;
    } else if len(str_trim(t)) <= 12 or str_contains(t, "1+1") or str_contains(t, "hi") or str_contains(t, "hello") {
        tier = "pbAI-Nano";
        reason = "short-simple-or-boot-answer";
        confidence = 0.72;
    } else if str_contains(t, "memory") or str_contains(t, "learn") or str_contains(t, "math") or str_contains(t, "pblang") {
        tier = "pbAI-Mini";
        reason = "portable-general-pblang-memory";
        confidence = 0.70;
    }
    let available = try fs_exists(_distilled_student_dir(dir, tier) + "/student.json") catch false;
    return map{
        format: "pbai.max.distilled_route.v1",
        dir: dir,
        prompt_len: len(prompt),
        tier: tier,
        reason: reason,
        confidence: confidence,
        available: available,
        policy: "route to the smallest saved student expected to handle the task; callers can still override tier"
    };
}

fn generate_distilled_route_saved(prompt, n = 16, dir = "checkpoints/pbai-max/students", expected = nil, forbidden = nil) {
    let route = route_distilled_tier(prompt, dir);
    let ranked = generate_distilled_student_ranked_saved(dir, route.tier, prompt, n, expected, forbidden, 1);
    return map{
        format: "pbai.max.distilled_route_generation.v1",
        route: route,
        ranked: ranked,
        text: ranked.text,
        tier: route.tier,
        confidence: route.confidence
    };
}

fn evaluate_distilled_route_saved(prompt, dir = "checkpoints/pbai-max/students", max_examples = 256) {
    let route = route_distilled_tier(prompt, dir);
    let ev = evaluate_distilled_student_saved(dir, route.tier, max_examples);
    return map{
        format: "pbai.max.distilled_route_eval.v1",
        route: route,
        eval: ev,
        tier: route.tier,
        confidence: route.confidence
    };
}

fn ideal_alignment_objective(metrics = nil) {
    if metrics == nil { metrics = map{}; }
    let valid_loss = try metrics.valid_loss catch 4.8;
    let benchmark_pass_rate = try metrics.benchmark_pass_rate catch 1.0;
    let teacher_quality = try metrics.teacher_quality catch 0.90;
    let calibration_error = try metrics.calibration_error catch 0.10;
    let geometry_distance = try metrics.geometry_distance catch 0.25;
    let components = [
        EVAL.objective_component("validation_loss", valid_loss, 4.0, "lower", 0.30),
        EVAL.objective_component("benchmark_pass_rate", benchmark_pass_rate, 1.0, "higher", 0.25),
        EVAL.objective_component("teacher_quality", teacher_quality, 0.95, "higher", 0.20),
        EVAL.objective_component("calibration_error", calibration_error, 0.05, "lower", 0.15),
        EVAL.objective_component("geometry_distance", geometry_distance, 0.10, "lower", 0.10)
    ];
    let objective = EVAL.objective_distance(components);
    objective.format = "pbai.max.ideal_alignment_objective.v1";
    objective.implementation_status = "objective-proxy";
    objective.policy = "use measurable proxy components to train real pblang NNs toward the ideal target without claiming ideal NN implementation";
    return objective;
}

fn _fast_trial_candidate(name, before, metrics, lesson) {
    let after = ideal_alignment_objective(metrics);
    let shared = EVAL.trial_candidate(name, before, after, map{ lesson: lesson });
    return map{
        format: "pbai.max.fast_trial_candidate.v1",
        source_format: shared.format,
        name: name,
        lesson: lesson,
        previous_distance: shared.previous_distance,
        current_distance: shared.current_distance,
        delta: shared.delta,
        reinforcement: shared.reinforcement.action,
        reinforcement_report: shared.reinforcement,
        accepted: shared.accepted,
        current_state: after,
        pblang_trial: shared
    };
}

fn fast_trial_reinforcement_smoke() {
    let previous_metrics = map{
        valid_loss: 4.8,
        benchmark_pass_rate: 0.88,
        teacher_quality: 0.80,
        calibration_error: 0.16,
        geometry_distance: 0.30
    };
    let previous = ideal_alignment_objective(previous_metrics);
    let trials = [
        _fast_trial_candidate("small-lr-more-data", previous, map{
            valid_loss: 4.55,
            benchmark_pass_rate: 0.92,
            teacher_quality: 0.86,
            calibration_error: 0.12,
            geometry_distance: 0.24
        }, "reward tiny validated improvements that reduce objective distance"),
        _fast_trial_candidate("too-aggressive-growth", previous, map{
            valid_loss: 5.15,
            benchmark_pass_rate: 0.84,
            teacher_quality: 0.74,
            calibration_error: 0.22,
            geometry_distance: 0.38
        }, "punish candidates that lower training confidence but worsen validation-like signals"),
        _fast_trial_candidate("no-change-repeat", previous, previous_metrics, "keep neutral trials visible so the loop can compare no-op behavior")
    ];
    let rewarded = 0;
    let punished = 0;
    let neutral = 0;
    let best = trials[0];
    let i = 0;
    let pblang_trials = [];
    while i < len(trials) {
        if trials[i].reinforcement == "reward" { rewarded = rewarded + 1; }
        else if trials[i].reinforcement == "punish" { punished = punished + 1; }
        else { neutral = neutral + 1; }
        push(pblang_trials, trials[i].pblang_trial);
        if trials[i].current_distance < best.current_distance { best = trials[i]; }
        i = i + 1;
    }
    let elite = EVAL.select_trial_elites(pblang_trials, 1);
    return map{
        format: "pbai.max.fast_trial_reinforcement.v1",
        implementation_status: "small-fast-smoke",
        mode: "trial-error-reward-punish",
        source_helper: "stdlib:llm_eval.sapp trial_candidate/select_trial_elites",
        training_budget: "tiny-deterministic-no-checkpoint-write",
        trial_count: len(trials),
        previous_state: previous,
        current_state: best.current_state,
        trials: trials,
        best_trial: best,
        pblang_elite_selection: elite,
        rewarded: rewarded,
        punished: punished,
        neutral: neutral,
        accepted: best.reinforcement == "reward",
        reward_signal: "lower ideal_alignment_objective.distance after validation-like metrics",
        mutates_checkpoint: false,
        safety: "fast smoke loop only; it compares candidate states and never saves or mutates Max weights",
        next_step: "use the same reward/punish contract around real tiny continuation candidates, then only save candidates that pass validation, benchmark, teacher-quality, and verifier gates"
    };
}

fn ideal_math_contract() {
    let model = map{
        layers: [[[1.1, 0.0], [0.0, 0.9]]],
        output_dist: [0.1, 0.6, 0.3],
        complex_weights: [map{ re: 0.3, im: 0.7 }, map{ re: 1.0, im: 0.0 }]
    };
    let ideal = IDEAL.ideal_spec([0.2, 0.5, 0.3]);
    let before = IDEAL.ideality_distance(model, ideal);
    let stepped = IDEAL.step_toward_ideal(model, ideal, 0.5);
    let after = IDEAL.ideality_distance(stepped, ideal);
    return map{
        format: "pbai.max.ideal_math_contract.v1",
        implementation_status: "standalone-opt-in-contract",
        module: "stdlib/pbai_ideal_nn.sapp",
        axes: ["spectral", "distributional", "geometric", "complex"],
        regularizer: IDEAL.ideality_regularizer(model, ideal),
        distance_before: before,
        distance_after: after,
        step_reduces_distance: after.total < before.total,
        training_loop_wired: false,
        integration_policy: "available as an opt-in regularizer; do not add to Max training loss until validation, benchmark, and safety gates are extended"
    };
}

fn rl_trial_learning_status() {
    let model = map{
        layers: [[[1.1, 0.0], [0.0, 0.9]]],
        output_dist: [0.1, 0.6, 0.3],
        complex_weights: [map{ re: 0.3, im: 0.7 }, map{ re: 1.0, im: 0.0 }]
    };
    let ideal = IDEAL.ideal_spec([0.2, 0.5, 0.3]);
    let before_reward = RL.ideal_reward(model, ideal);
    let run = RL.train_toward_ideal_rl(model, ideal, 8, 4, 0.25, 11);
    let final_reward = run.rewards[len(run.rewards) - 1];
    return map{
        format: "pbai.max.rl_trial_learning_status.v1",
        implementation_status: "deterministic-small-rl-smoke",
        source_module: "stdlib/pbai_rl.sapp",
        trainer_format: run.format,
        mode: "try-candidates-keep-only-reward-improvements",
        reward_definition: "negative ideality distance; higher reward means closer to ideal target",
        start_reward: before_reward,
        final_reward: final_reward,
        reward_improved: final_reward >= before_reward,
        accepted: run.accepted,
        iterations: run.iters,
        rewards: run.rewards,
        reward_history: run.rewards,
        mutates_checkpoint: false,
        safety: "status smoke only; deterministic seed and no checkpoint writes"
    };
}

fn ideal_neural_target() {
    return map{
        format: "pbai.max.ideal_neural_target.v1",
        implementation_status: "research-target",
        name: "Ideal Imaginary Variable Neural Network",
        purpose: "define an aspirational mathematical teacher/target space that current pbAI neural networks can be trained toward without pretending the ideal exists yet",
        math_substrate: [
            "complex-valued state vectors",
            "probabilistic beliefs and uncertainty calibration",
            "linear algebra over embeddings, projections, eigenspaces, and low-rank adapters",
            "geometry/manifold views of memory, attention, routing, and concept distance",
            "loss surfaces that compare current network behavior against ideal target behavior"
        ],
        training_direction: [
            "measure current NN behavior",
            "project behavior into ideal target coordinates",
            "compute distance/error from the ideal target",
            "train current pblang NNs to reduce that distance",
            "accept changes only through validation, benchmark, teacher-quality, and safety gates"
        ],
        current_nn_role: "student networks remain real pblang models; the ideal target is a guide for objectives, curriculum, evaluation, and future architecture growth",
        alignment_objective: ideal_alignment_objective(),
        math_contract: ideal_math_contract(),
        safety_boundary: "research goal only; do not report AGI/ASI or ideal-brain capability until implemented and verified",
        next_steps: [
            "add pblang complex-number and matrix/manifold helpers where missing",
            "define target-distance metrics for logits, embeddings, memory retrieval, and tool decisions",
            "add benchmark cases that reward calibrated uncertainty and verified reasoning",
            "use distillation/feedback loops to move Pro/Mini/Nano students toward the target without bypassing acceptance gates"
        ]
    };
}

fn distillation_plan() {
    return map{
        implementation_status: "bounded-student-training",
        note: "Teacher records and first Pro/Mini/Nano student training are implemented; next milestone is larger-scale saved family training.",
        dataset_contract: "pbai.max.distillation_dataset.v1",
        record_contract: "pbai.max.distillation_record.v1",
        student_contract: "pbai.max.distilled_student_checkpoint.v1",
        targets: distillation_targets(),
        steps: [
            "Train/evaluate pbAI-Max in AAP/products/pbai with pblang llm_* foundations",
            "Freeze a versioned Max checkpoint and benchmark it on pblang/code prompts",
            "Generate Max teacher records with expected tokens, ranked outputs, verifier scores, and benchmark threshold gates",
            "Train pbAI-Pro, pbAI-Mini, and pbAI-Nano student weights from accepted teacher records",
            "Keep Nano/foundation reusable inside pblang; keep Max product policy here"
        ]
    };
}

fn default_project_intake_paths() {
    return [
        "README.md",
        "docs",
        "stdlib",
        "tests/semantics",
        "../pblang/stdlib",
        "../pblang/tests/semantics",
        "../pblang/docs",
        "../pbos/docs",
        "../pb-mcp-server",
        "../pbremote",
        "../pblang/editors/ide",
        "/usr/share/vulkan",
        "/usr/share/mesa-demos"
    ];
}

fn max_project_intake_plan(paths = nil) {
    if paths == nil { paths = default_project_intake_paths(); }
    let survey = SURVEY.survey_paths(paths, 2000);
    let pbai_ideas = SURVEY.ideas_for_project("pbai", survey.records);
    let cross = SURVEY.cross_project_plan(paths);
    let portfolio = SURVEY.portfolio_readiness(paths);
    return map{
        format: "pbai.max.project_intake_plan.v1",
        model: "pbAI-Max",
        survey: survey,
        pbai_ideas: pbai_ideas,
        cross_project: cross,
        portfolio: portfolio,
        corpus_rule: "use safe metadata first; only text-like explicit paths may become corpus after llm_data sanitization",
        safety_rule: "skip secrets, tokens, private keys, caches, build outputs, and binary installers before learning",
        portfolio_rule: "portfolio readiness guides priorities only; it never turns raw paths into training data",
        next_actions: [
            "turn safe docs/tests/code paths into curated corpus manifests",
            "route graphics/GPU paths to acceleration and visualization work, not corpus text",
            "route pbide/pbos/mcp paths to project-specific tool, benchmark, and verification tasks",
            "require benchmark and verifier gates before a checkpoint is accepted"
        ]
    };
}

fn max_portfolio_readiness(paths = nil) {
    if paths == nil { paths = default_project_intake_paths(); }
    let portfolio = SURVEY.portfolio_readiness(paths);
    return map{
        format: "pbai.max.portfolio_readiness.v1",
        model: "pbAI-Max",
        portfolio: portfolio,
        lines: SURVEY.portfolio_readiness_lines(portfolio, 12),
        training_boundary: "use readiness to pick safe next work; use llm_data sanitization before any corpus/training ingestion"
    };
}

fn max_project_gap_audit(records, max_findings = 100, options = nil) {
    if options == nil { options = map{}; }
    let audit = AUDIT.audit_project("pbai", records, max_findings, options);
    let gate = AUDIT.quality_gate(audit.report, map{ max_high: 0, max_medium: 8, max_total: 80, allow_roadmap: true });
    let tasks = AUDIT.backlog(audit.report, 20);
    return map{
        format: "pbai.max.project_gap_audit.v1",
        model: "pbAI-Max",
        audit: audit,
        quality_gate: gate,
        backlog: tasks,
        suppressions: AUDIT.explain_suppressions(audit.report),
        training_rule: "do not train on raw findings; convert verified fixes into sanitized curated records",
        acceptance_rule: "security/high-risk findings must be fixed or explicitly excluded before checkpoint acceptance",
        next_actions: [
            "redact secret/security findings before corpus creation",
            "turn incomplete markers into implementation tasks or honest roadmap metadata",
            "add regression prompts/tests for repaired Max behavior",
            "keep benchmark and verifier gates before saving model checkpoints"
        ]
    };
}

fn max_project_gap_compare(before_records, after_records, max_findings = 100, options = nil) {
    if options == nil { options = map{}; }
    let before = AUDIT.audit_project("pbai", before_records, max_findings, options);
    let after = AUDIT.audit_project("pbai", after_records, max_findings, options);
    let gate = AUDIT.progress_gate(before.report, after.report, options);
    return map{
        format: "pbai.max.project_gap_compare.v1",
        model: "pbAI-Max",
        before: before,
        after: after,
        progress_gate: gate,
        rule: "pbAI-Max should not accept data/checkpoint changes that introduce new audit findings"
    };
}

fn status() {
    let trun = tokenizer_train(128, 18000);
    let model = model_new(trun.summary.vocab_size);
    let corpus_filter = curated_records();
    return map{
        format: "pbai.max.status.v1",
        tier: "pbAI-Max",
        root: "AAP/products/pbai",
        legacy_root: "AAP/ai/pbai",
        nano_owner: "pblang stdlib / pbAI-Nano foundation",
        max_owner: "AAP/products/pbai",
        foundation_imports: ["stdlib:llm_attention.sapp", "stdlib:llm_train.sapp", "stdlib:llm_stream.sapp",
            "stdlib:llm_weights.sapp", "stdlib:llm_tokenizer_train.sapp", "stdlib:llm_eval.sapp",
            "stdlib:llm_quant.sapp", "stdlib:llm_binary.sapp"],
        tokenizer: trun.summary,
        binary: binary_status(128, 18000),
        live_architecture: live_architecture_status(128, 18000),
        growth_control: growth_control_status(128, 18000),
        architecture: ATT.summary(model),
        params: WEIGHTS.estimate_params(model),
        personality: personality_profile(),
        live_learning: live_learning_status(),
        memory: memory_status(96),
        adapter: adapter_status(128, 18000),
        architecture_config: architecture_config(),
        training_context: training_context(),
        training_workers: training_workers(),
        cache: CACHE.status(),
        corpus: map{ records: len(source_records()), curated_records: corpus_filter.kept, curriculum_records: len(curriculum_records()), quality_skipped: corpus_filter.skipped, quality_score: corpus_filter.total_score, chars: trun.chars, skipped: trun.skipped, example_policy: "balanced-per-record-strong-target-plus-curriculum-interleave" },
        resource_plan: resource_plan(1280, 6, 2),
        regression_cases: regression_cases(),
        benchmark: benchmark_status(),
        checkpoint_dir: DEFAULT_CHECKPOINT_DIR,
        stream: stream_status(64, 32),
        ideal_neural_target: ideal_neural_target(),
        fast_trial_reinforcement: fast_trial_reinforcement_smoke(),
        rl_trial_learning: rl_trial_learning_status(),
        project_intake: max_project_intake_plan(default_project_intake_paths()),
        distillation: distillation_plan(),
        next_steps: TRAIN.training_plan()
    };
}

