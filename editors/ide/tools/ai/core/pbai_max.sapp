        DATA.corpus_record("pbai-max/pblang-clean-generations.sapp",
            "fn add(a, b) { return a + b; }\nfn double(x) { return x * 2; }\nfn main() { let value = add(1, 2); print value; return value; }\nlet user = map{ name: \"Ada\", score: 99 };\nif user.score > 90 { print user.name; }\nwhile value < 10 { value = value + 1; }\nfor item in [1, 2, 3] { print item; }\n",
            "pblang-code"),
        DATA.corpus_record("pbai-max/assistant.md",
            "pbAI-Max is the flagship local pblang LLM tier. It uses tokenizer, data, transformer, training, eval, weights, quantization, memory, tools, and verifier modules.",
            "docs"),
        DATA.corpus_record("pbai-max/review.sapp",
            "fn risky(path){let s=try fs_read(path) catch \"\"; print s; return s;} // print is a statement in pblang",
            "pblang-code"),
        _file_record(LIVE_LESSONS_PATH, "live-lessons", 12000),
        _file_record("README.md", "docs", 3000),
        _file_record("docs/pbAI.md", "docs", 9000),
        _file_record("docs/pbAI_source_audit.md", "docs", 5000),
        _file_record("stdlib/pbai.sapp", "pblang-code", 9000),
        _file_record("stdlib/pbai_max.sapp", "pblang-code", 9000),
        _file_record("stdlib/pbai_brain.sapp", "pblang-code", 7000),
        _file_record("stdlib/pbai_tools.sapp", "pblang-code", 5000),
        _file_record("tests/semantics/pbai_max_test.sapp", "pblang-test", 5000),
        _file_record("tests/semantics/pbai_test.sapp", "pblang-test", 5000),
        _file_record("../pblang/docs/pbAI.md", "pblang-docs", 10000),
        _file_record("../pblang/docs/CURRENT_STATUS.md", "pblang-docs", 7000),
        _file_record("../pblang/stdlib/llm_train.sapp", "pblang-code", 9000),
        _file_record("../pblang/stdlib/llm_attention.sapp", "pblang-code", 9000),
