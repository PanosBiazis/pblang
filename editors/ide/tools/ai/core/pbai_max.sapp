// stdlib/pbai_max.sapp -- pbAI-Max product tier, implemented in pblang.
//
// Ownership boundary:
// - pblang stdlib owns generic/Nano LLM primitives (`stdlib:llm_*`).
// - this repository owns pbAI-Max tier policy, corpora, metadata, checkpoints,
//   evaluation, and the route toward the real flagship model.

let TOK = import("stdlib:llm_tokenizer.sapp");
let DATA = import("stdlib:llm_data.sapp");
let TTRAIN = import("stdlib:llm_tokenizer_train.sapp");
let ATT = import("stdlib:llm_attention.sapp");
let TRAIN = import("stdlib:llm_train.sapp");
let EVAL = import("stdlib:llm_eval.sapp");
let WEIGHTS = import("stdlib:llm_weights.sapp");
let QUANT = import("stdlib:llm_quant.sapp");
let STREAM = import("stdlib:llm_stream.sapp");
let BINARY = import("stdlib:llm_binary.sapp");
let ADAPT = import("stdlib:llm_adapters.sapp");
let SURVEY = import("stdlib:project_survey.sapp");
let AUDIT = import("stdlib:project_audit.sapp");
let CACHE = (try import("pbai_cache.sapp") catch import("editors/ide/tools/ai/core/pbai_cache.sapp"));
let TOOLS = (try import("pbai_tools.sapp") catch import("editors/ide/tools/ai/core/pbai_tools.sapp"));
let IDEAL = (try import("pbai_ideal_nn.sapp") catch import("editors/ide/tools/ai/core/pbai_ideal_nn.sapp"));
let RL = (try import("pbai_rl.sapp") catch import("editors/ide/tools/ai/core/pbai_rl.sapp"));
let FRONTEND = try import("stdlib:compiler/selfhost_frontend.sapp") catch nil;

let DEFAULT_CHECKPOINT_DIR = "checkpoints/pbai-max";
let LIVE_LESSONS_PATH = "editors/ide/tools/ai/core/pbai_max_live_lessons.txt";
let GENERATION_POLICY_VERSION = "verified-repair-v1";

fn _read_slice(path, max_chars) {
    let raw = try fs_read(path) catch "";
    if len(raw) > max_chars { return str_slice(raw, 0, max_chars); }
    return raw;
}

fn _file_record(path, kind, max_chars) {
    return DATA.corpus_record(path, _read_slice(path, max_chars), kind);
}

fn source_records() {
    return [
        DATA.corpus_record("pbai-max/pblang-core.sapp",
            "fn add(a,b){return a+b;} fn main(){let x=add(1,1); print x;} try fs_read(\"x\") catch \"\";",
            "pblang-code"),
        DATA.corpus_record("pbai-max/pblang-functions.sapp",
            "fn square(x) { return x * x; }\nfn sum(arr) { let total = 0; for v in arr { total = total + v; } return total; }\nfn main() { let xs = [1,2,3,4]; print sum(xs); print square(5); }",
            "pblang-code"),
        DATA.corpus_record("pbai-max/pblang-errors.sapp",
            "fn read_or_empty(path) { let text = try fs_read(path) catch \"\"; return text; }\nfn safe_print(path) { let text = read_or_empty(path); if text != \"\" { print text; } return len(text); }",
            "pblang-code"),
        DATA.corpus_record("pbai-max/pblang-tests.sapp",
            "let m = map{ name: \"pbAI\", tier: \"Max\" };\nassert(map_has(m, \"name\"), \"map has key\");\nassert(m.name == \"pbAI\", \"map value works\");\nprint \"pbai_max_pass\";",
            "pblang-test"),
        DATA.corpus_record("pbai-max/pblang-agent-loop.sapp",
            "fn perceive(text) { if str_contains(text, \"fn \") { return \"code\"; } return \"text\"; }\nfn verify(ok) { if ok { return \"reward\"; } return \"punish\"; }\nfn loop(prompt) { let kind = perceive(prompt); return map{ kind: kind, action: verify(kind == \"code\") }; }",
            "pblang-code"),
        DATA.corpus_record("pbai-max/pblang-tokenizer.sapp",
            "fn encode_chars(text) { let ids = []; let i = 0; while i < len(text) { push(ids, strcharcodeat(text, i)); i = i + 1; } return ids; }\nfn decode_len(ids) { let n = 0; for id in ids { n = n + 1; } return n; }",
