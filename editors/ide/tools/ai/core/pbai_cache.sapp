// stdlib/pbai_cache.sapp -- pblang-only persistent cache helpers for pbAI.
//
// This cache stores derived artifacts and summaries, not source-of-truth model
// weights. It is safe to clear: checkpoints and live lessons remain elsewhere.

let CACHE_ROOT = "target/pbai-cache";

// TTL / eviction policy. Entries already carry `created_ms` (a wall-clock
// millisecond stamp from the `now_ms()` builtin, written by `put` below), so
// staleness is measured against that. `DEFAULT_TTL_MS` is the age past which
// `prune` / `prune_all` treat an entry as expired when no explicit ttl is given
// (7 days). Lookups (`get`/`has`) do NOT expire by default -- callers opt in by
// passing a `ttl_ms` so existing positional call sites keep working unchanged.
let DEFAULT_TTL_MS = 604800000;
// Per-kind soft cap on stored entries. `put` evicts the oldest entries in the
// same kind (by `created_ms`, oldest first) once this many would be exceeded, so
// a single kind cannot accumulate unbounded derived-data files.
let MAX_ENTRIES = 512;

fn root() {
    return CACHE_ROOT;
}

fn default_ttl_ms() {
    return DEFAULT_TTL_MS;
}

fn max_entries() {
    return MAX_ENTRIES;
}

fn _now() {
    return now_ms();
}

fn _safe_kind(kind) {
    let raw = str(kind);
    let out = "";
    let i = 0;
    while i < len(raw) {
        let c = strcharcodeat(raw, i);
        let ch = str_slice(raw, i, i + 1);
        let is_digit = c >= 48 and c <= 57;
        let is_upper = c >= 65 and c <= 90;
        let is_lower = c >= 97 and c <= 122;
        let is_mark = ch == "_" or ch == "-";
        if is_digit or is_upper or is_lower or is_mark {
            out = out + ch;
        }
        i = i + 1;
    }
    if out == "" { return "general"; }
    return out;
}

fn _hash(text) {
    let h = 5381;
    let i = 0;
    while i < len(text) {
        h = (h * 33 + strcharcodeat(text, i)) % 2147483647;
        i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return str(h);
}

fn key(kind, text) {
    kind = _safe_kind(kind);
    return kind + "-" + _hash(str(text));
}

fn _kind_dir(kind) {
    kind = _safe_kind(kind);
    return CACHE_ROOT + "/" + kind;
}

fn path(kind, text) {
    kind = _safe_kind(kind);
    return _kind_dir(kind) + "/" + key(kind, text) + ".json";
}

// Parse a full stored entry (format, kind, key, created_ms, value) or nil.
fn _read_entry(p) {
    return try json_parse(fs_read(p)) catch nil;
}

// List the JSON entry files in a kind dir as { path, created_ms } records.
// A missing/unreadable created_ms sorts as 0 (oldest), so malformed entries are
// evicted first. Reuses only helpers already used here (fs_listdir/_read_entry).
fn _kind_entries(kind) {
    let dir = _kind_dir(kind);
    let files = try fs_listdir(dir) catch [];
    let out = [];
    let i = 0;
    while i < len(files) {
        let p = dir + "/" + files[i];
        let entry = _read_entry(p);
        let created = 0;
        if entry != nil {
            let c = try entry.created_ms catch nil;
            if c != nil { created = c; }
        }
        push(out, map{ path: p, created_ms: created });
        i = i + 1;
    }
    return out;
}

// Oldest-first eviction so a single kind never exceeds `keep` stored entries.
// Called by `put` before writing a new entry (with keep = MAX_ENTRIES - 1 so the
// incoming entry fits). Returns the number of files removed. Simple selection of
// the minimum created_ms per pass; MAX_ENTRIES is small so this stays cheap.
fn _evict_oldest(kind, keep) {
    let entries = _kind_entries(kind);
    let removed = 0;
    while len(entries) > keep {
        let oldest = 0;
        let i = 1;
        while i < len(entries) {
            if entries[i].created_ms < entries[oldest].created_ms { oldest = i; }
            i = i + 1;
        }
        try fs_remove(entries[oldest].path) catch false;
        removed = removed + 1;
        let rebuilt = [];
        let j = 0;
        while j < len(entries) {
            if j != oldest { push(rebuilt, entries[j]); }
            j = j + 1;
        }
        entries = rebuilt;
    }
    return removed;
}

fn put(kind, text, value) {
    kind = _safe_kind(kind);
    let dir = _kind_dir(kind);
    fs_mkdirs(dir);
    let p = path(kind, text);
    let existed = try fs_exists(p) catch false;
    let evicted = 0;
    // Only enforce the cap when adding a genuinely new key; overwriting an
    // existing key does not grow the entry count.
    if not existed {
        evicted = _evict_oldest(kind, MAX_ENTRIES - 1);
    }
    let entry = map{
        format: "pbai.cache.entry.v1",
        kind: kind,
        key: key(kind, text),
        created_ms: now_ms(),
        value: value
    };
    fs_write(p, json_stringify(entry));
    return map{ format: "pbai.cache.write.v1", ok: true, kind: kind, key: entry.key, path: p, evicted: evicted };
}

// True when `entry` has a `created_ms` stamp older than `ttl_ms` at `now`.
// A nil ttl_ms means "never expire"; a missing/invalid created_ms is treated as
// not expired so legacy entries without a stamp are never silently dropped.
fn _is_expired(entry, ttl_ms, now) {
    if ttl_ms == nil { return false; }
    if entry == nil { return false; }
    let created = try entry.created_ms catch nil;
    if created == nil { return false; }
    return (now - created) > ttl_ms;
}

// ttl_ms (optional): when provided, an entry older than ttl_ms is treated as a
// miss (returns nil). Existing 2-arg call sites are unaffected -- they never
// expire. `now` defaults to the current clock; pass it for deterministic tests.
fn get(kind, text, ttl_ms = nil, now = nil) {
    kind = _safe_kind(kind);
    let p = path(kind, text);
    let entry = _read_entry(p);
    if entry == nil { return nil; }
    if now == nil { now = _now(); }
    if _is_expired(entry, ttl_ms, now) { return nil; }
    return try entry.value catch nil;
}

fn has(kind, text, ttl_ms = nil, now = nil) {
    kind = _safe_kind(kind);
    return get(kind, text, ttl_ms, now) != nil;
}

fn remove(kind, text) {
    kind = _safe_kind(kind);
    let p = path(kind, text);
    let ok = try fs_remove(p) catch false;
    return map{ format: "pbai.cache.remove.v1", ok: ok, kind: kind, path: p };
}

fn clear_kind(kind) {
    kind = _safe_kind(kind);
    let dir = _kind_dir(kind);
    let files = try fs_listdir(dir) catch [];
    let removed = 0;
    let i = 0;
    while i < len(files) {
        let p = dir + "/" + files[i];
        try fs_remove(p) catch false;
        removed = removed + 1;
        i = i + 1;
    }
    return map{ format: "pbai.cache.clear.v1", kind: kind, removed: removed };
}

fn clear_all() {
    let kinds = try fs_listdir(CACHE_ROOT) catch [];
    let removed = 0;
    let i = 0;
    while i < len(kinds) {
        let r = clear_kind(kinds[i]);
        removed = removed + r.removed;
        i = i + 1;
    }
    return map{ format: "pbai.cache.clear_all.v1", root: CACHE_ROOT, removed: removed };
}

// Remove entries in `kind` older than `ttl_ms` (defaults to DEFAULT_TTL_MS).
// `now` defaults to the current clock; pass it for deterministic tests. Returns
// a versioned map with the eviction count. Additive -- no existing call site
// depended on any pruning behavior.
fn prune(kind, ttl_ms = nil, now = nil) {
    kind = _safe_kind(kind);
    if ttl_ms == nil { ttl_ms = DEFAULT_TTL_MS; }
    if now == nil { now = _now(); }
    let entries = _kind_entries(kind);
    let evicted = 0;
    let i = 0;
    while i < len(entries) {
        if (now - entries[i].created_ms) > ttl_ms {
            try fs_remove(entries[i].path) catch false;
            evicted = evicted + 1;
        }
        i = i + 1;
    }
    return map{ format: "pbai.cache.prune.v1", kind: kind, ttl_ms: ttl_ms, evicted: evicted };
}

// Prune every kind under the cache root and report the total evicted.
fn prune_all(ttl_ms = nil, now = nil) {
    if ttl_ms == nil { ttl_ms = DEFAULT_TTL_MS; }
    if now == nil { now = _now(); }
    let kinds = try fs_listdir(CACHE_ROOT) catch [];
    let evicted = 0;
    let i = 0;
    while i < len(kinds) {
        let r = prune(kinds[i], ttl_ms, now);
        evicted = evicted + r.evicted;
        i = i + 1;
    }
    return map{ format: "pbai.cache.prune_all.v1", root: CACHE_ROOT, ttl_ms: ttl_ms, evicted: evicted };
}

fn status() {
    let kinds = try fs_listdir(CACHE_ROOT) catch [];
    let entries = [];
    let total = 0;
    let i = 0;
    while i < len(kinds) {
        let files = try fs_listdir(CACHE_ROOT + "/" + kinds[i]) catch [];
        total = total + len(files);
        push(entries, map{ kind: kinds[i], entries: len(files) });
        i = i + 1;
    }
    return map{
        format: "pbai.cache.status.v1",
        root: CACHE_ROOT,
        kinds: entries,
        total_entries: total,
        purpose: "cache derived pbAI data such as training summaries, eval reports, tokenization, retrieval, and generation metadata"
    };
}

fn put_training_summary(name, ckpt) {
    return put("training-summary", name, map{
        format: "pbai.cache.training_summary.v1",
        params: ckpt.params,
        training_mode: try ckpt.training.mode catch "",
        training_workers: try ckpt.training.parallel_workers catch 1,
        train_loss: ckpt.eval.loss,
        valid_loss: ckpt.validation.eval.loss,
        accuracy: ckpt.eval.accuracy,
        regression_pass_rate: try ckpt.regression.pass_rate catch 0.0,
        live_mutable: try ckpt.live_architecture.mutable catch false
    });
}

export root, key, path, put, get, has, remove, clear_kind, clear_all, status;
export prune, prune_all, default_ttl_ms, max_entries;
export put_training_summary;
