// pbai_batch_context.sapp -- serial, exception-safe broker batch provenance.
//
// This module owns the transient parent binding used while one bounded batch is
// executing.  The callback result is returned only after the binding has been
// cleared, including when the callback throws.  It provides no concurrency or
// authorization primitive; the broker remains deliberately serial.

let FORMAT = "pbai.batch.context.v1";
let _DEPTH = 0;
let _PARENT_DIGEST = "";

fn run(parent_digest, callback) {
    if _DEPTH != 0 {
        return map{ format: FORMAT, ok: false, error_code: "nested-batch-denied" };
    }
    if type(parent_digest) != "string" or len(parent_digest) != 64
        or type(callback) != "closure" {
        return map{ format: FORMAT, ok: false, error_code: "invalid-batch-context" };
    }

    _DEPTH = 1;
    _PARENT_DIGEST = parent_digest;
    let value = nil;
    let failed = false;
    try { value = callback(); } catch { failed = true; }

    // Clear provenance before returning either success or failure.  A later
    // direct tool call must never inherit a stale batch parent.
    _DEPTH = 0;
    _PARENT_DIGEST = "";
    if failed {
        return map{ format: FORMAT, ok: false, error_code: "batch-callback-failed" };
    }
    return map{ format: FORMAT, ok: true, value: value };
}

fn parent_digest() { return _PARENT_DIGEST; }

fn status() {
    return map{ format: FORMAT, ok: true, active: _DEPTH != 0,
        parent_binding_active: _PARENT_DIGEST != "", serial_only: true,
        nested_batches_allowed: false, exception_safe_cleanup: true };
}

export FORMAT, run, parent_digest, status;
