// Pure, bounded PBLang-only document extraction for admitted pbAI text.
//
// This module accepts in-memory content only. Its sole dependency is PBLang's
// pure serialization library; it has no filesystem, model, tool, persistence,
// or training effects. Returned chunks contain the caller's content and are
// never safe for public logging by themselves.

let SERIAL = import("stdlib:serialization.sapp");

let FORMAT = "pbai.document-extraction.v1";
let MAX_INPUT_BYTES = 24000;
let MAX_INPUT_CHARS = 24000;
let MAX_LINES = 2048;
let MAX_LINE_BYTES = 4096;
let MAX_SECTIONS = 64;
let MAX_CHUNKS = 16;
let MIN_CHUNK_CHARS = 512;
let MAX_CHUNK_CHARS = 6000;
let MAX_OUTPUT_BYTES = 120000;
let MAX_JSON_DEPTH = 16;
let MAX_JSON_TOKENS = 4096;
let MAX_JSON_STRING_BYTES = 4096;
let MAX_CSV_ROWS = 512;
let MAX_CSV_COLUMNS = 64;
let MAX_CSV_CELLS = 8192;
let MAX_CSV_CELL_BYTES = 2048;

fn _allowed_format(value) {
    return value == "plain" or value == "markdown" or value == "json"
        or value == "csv" or value == "pblang-source";
}

fn _forbidden_codepoint(c) {
    if c == 9 or c == 10 or c == 13 { return false; }
    return c < 32 or (c >= 127 and c <= 159)
        or c == 1564 or c == 8203 or c == 8204 or c == 8205
        or c == 8206 or c == 8207 or (c >= 8234 and c <= 8238)
        or c == 8288 or (c >= 8294 and c <= 8297) or c == 65279;
}

fn _negative_flags(out) {
    out.safe_for_public_logging = false;
    out.sanitization_performed = false;
    out.secret_scan_performed = false;
    out.pii_scan_performed = false;
    out.poisoning_scan_performed = false;
    out.rights_verified = false;
    out.admitted = false;
    out.persisted = false;
    out.training_performed = false;
    out.executed = false;
    out.links_followed = false;
    out.imports_resolved = false;
    out.authorizes_action = false;
    return out;
}

fn _error(code, declared_format = "") {
    let public_format = if _allowed_format(declared_format) { declared_format } else { "" };
    let out = map{ format: FORMAT, ok: false, complete: false,
        error_code: code, declared_format: public_format,
        extractor: "pblang-native-document-extractor-v1",
        sections: [], chunks: [], section_count: 0, chunk_count: 0,
        contains_content: false, output_bounded: true };
    return _negative_flags(out);
}

fn _options(options) {
    if options == nil or type(options) != "map" { options = map{}; }
    let target = try options.chunk_target_chars catch 4000;
    if type(target) != "number" or target != num_floor(target)
        or target < MIN_CHUNK_CHARS or target > MAX_CHUNK_CHARS {
        return map{ valid: false, target: 0 };
    }
    return map{ valid: true, target: target };
}

fn _validated_input(text, declared_format, options) {
    if type(declared_format) != "string" or not _allowed_format(declared_format) {
        return map{ valid: false, error_code: "unsupported-declared-format" };
    }
    if type(text) != "string" or text == "" { return map{
        valid: false, error_code: "invalid-or-empty-input" };
    }
    if len(text) > MAX_INPUT_CHARS or len(text) > MAX_INPUT_BYTES {
        return map{ valid: false, error_code: "input-cap-reached" };
    }
    let input_bytes = str_to_bytes(text);
    if len(input_bytes) > MAX_INPUT_BYTES {
        return map{ valid: false, error_code: "input-cap-reached" };
    }
    let i = 0;
    while i < len(text) {
        if _forbidden_codepoint(strcharcodeat(text, i)) {
            return map{ valid: false, error_code: "forbidden-control-character" };
        }
        i = i + 1;
    }
    let config = _options(options);
    if not config.valid { return map{ valid: false, error_code: "invalid-extraction-limits" }; }
    let normalized = str_replace_all(str_replace_all(text, "\r\n", "\n"), "\r", "\n");
    let lines = str_split(normalized, "\n");
    if len(lines) > MAX_LINES { return map{ valid: false, error_code: "line-cap-reached" }; }
    i = 0;
    while i < len(lines) {
        if len(lines[i]) > MAX_LINE_BYTES
            or len(str_to_bytes(lines[i])) > MAX_LINE_BYTES {
            return map{ valid: false, error_code: "line-byte-cap-reached" };
        }
        i = i + 1;
    }
    let transforms = [];
    if normalized != text { push(transforms, "crlf-cr-to-lf"); }
    return map{ valid: true, text: normalized, lines: lines,
        target: config.target, transforms: transforms,
        input_chars: len(text), input_bytes: len(input_bytes),
        input_digest: sha256(text) };
}

fn _section(text, index, kind, start, finish, level = 0) {
    let content = str_slice(text, start, finish);
    return map{ index: index, kind: kind, level: level,
        start_char: start, end_char: finish,
        char_count: finish - start,
        content_digest: sha256(content), title_returned: false };
}

fn _single_section(text, kind) {
    return [_section(text, 0, kind, 0, len(text), 0)];
}

fn _paragraph_sections(text, lines) {
    let sections = [];
    let offset = 0;
    let start = -1;
    let i = 0;
    while i < len(lines) {
        let line = lines[i];
        let blank = str_trim(line) == "";
        if not blank and start < 0 { start = offset; }
        if blank and start >= 0 {
            push(sections, _section(text, len(sections), "paragraph", start, offset, 0));
            start = -1;
            if len(sections) > MAX_SECTIONS { return nil; }
        }
        offset = offset + len(line);
        if i + 1 < len(lines) { offset = offset + 1; }
        i = i + 1;
    }
    if start >= 0 { push(sections, _section(text, len(sections), "paragraph", start, len(text), 0)); }
    if len(sections) < 1 { return _single_section(text, "plain-document"); }
    if len(sections) > MAX_SECTIONS { return nil; }
    return sections;
}

fn _markdown_heading_level(line) {
    let trimmed = str_trim(line);
    let level = 0;
    while level < len(trimmed) and level < 6
        and strcharcodeat(trimmed, level) == 35 { level = level + 1; }
    if level < 1 or level >= len(trimmed) or strcharcodeat(trimmed, level) != 32 { return 0; }
    return level;
}

fn _markdown_sections(text, lines) {
    let sections = [];
    let starts = [0];
    let levels = [0];
    let kinds = ["markdown-preamble"];
    let offset = 0;
    let fence = "";
    let i = 0;
    while i < len(lines) {
        let trimmed = str_trim(lines[i]);
        let marker = "";
        if str_starts_with(trimmed, "```") { marker = "```"; }
        elif str_starts_with(trimmed, "~~~") { marker = "~~~"; }
        if marker != "" {
            if fence == "" { fence = marker; }
            elif fence == marker { fence = ""; }
        } elif fence == "" {
            let level = _markdown_heading_level(lines[i]);
            if level > 0 {
                if offset == 0 {
                    levels[0] = level; kinds[0] = "markdown-heading";
                } else {
                    push(starts, offset); push(levels, level); push(kinds, "markdown-heading");
                    if len(starts) > MAX_SECTIONS { return map{ valid: false, error: "section-cap-reached" }; }
                }
            }
        }
        offset = offset + len(lines[i]);
        if i + 1 < len(lines) { offset = offset + 1; }
        i = i + 1;
    }
    if fence != "" { return map{ valid: false, error: "unclosed-markdown-fence" }; }
    i = 0;
    while i < len(starts) {
        let finish = if i + 1 < len(starts) { starts[i + 1] } else { len(text) };
        push(sections, _section(text, i, kinds[i], starts[i], finish, levels[i]));
        i = i + 1;
    }
    return map{ valid: true, sections: sections };
}

fn _pblang_declaration(line) {
    return str_starts_with(line, "fn ") or str_starts_with(line, "export ")
        or str_starts_with(line, "type ") or str_starts_with(line, "struct ")
        or str_starts_with(line, "enum ");
}

fn _pblang_sections(text, lines) {
    let starts = [0];
    let offset = 0;
    let i = 0;
    while i < len(lines) {
        if offset > 0 and _pblang_declaration(lines[i]) {
            push(starts, offset);
            if len(starts) > MAX_SECTIONS { return nil; }
        }
        offset = offset + len(lines[i]);
        if i + 1 < len(lines) { offset = offset + 1; }
        i = i + 1;
    }
    let sections = [];
    i = 0;
    while i < len(starts) {
        let finish = if i + 1 < len(starts) { starts[i + 1] } else { len(text) };
        push(sections, _section(text, i, "pblang-lexical-region", starts[i], finish, 0));
        i = i + 1;
    }
    return sections;
}

fn _json_profile(text) {
    let stack = [];
    let in_string = false;
    let escaped = false;
    let string_start = -1;
    let tokens = 0;
    let top_sections = 1;
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        if in_string and escaped { escaped = false; }
        elif in_string and ch == "\\" { escaped = true; }
        elif in_string and ch == "\"" {
            let content = str_slice(text, string_start, i);
            if len(content) > MAX_JSON_STRING_BYTES
                or len(str_to_bytes(content)) > MAX_JSON_STRING_BYTES {
                return map{ valid: false, error: "json-string-cap-reached" };
            }
            in_string = false;
        } elif in_string { }
        elif ch == "\"" { in_string = true; string_start = i + 1; tokens = tokens + 1; }
        elif ch == "{" or ch == "[" {
            push(stack, ch); tokens = tokens + 1;
            if len(stack) > MAX_JSON_DEPTH { return map{ valid: false, error: "json-depth-cap-reached" }; }
        } elif ch == "}" or ch == "]" {
            if len(stack) < 1 { return map{ valid: false, error: "invalid-json-structure" }; }
            let open = pop(stack);
            if (ch == "}" and open != "{") or (ch == "]" and open != "[") {
                return map{ valid: false, error: "invalid-json-structure" };
            }
            tokens = tokens + 1;
        } elif ch == "," or ch == ":" {
            tokens = tokens + 1;
            if ch == "," and len(stack) == 1 { top_sections = top_sections + 1; }
        } elif ch != " " and ch != "\n" and ch != "\t" {
            if i == 0 or str_contains(" [{,:\n\t", str_slice(text, i - 1, i)) { tokens = tokens + 1; }
        }
        if tokens > MAX_JSON_TOKENS { return map{ valid: false, error: "json-token-cap-reached" }; }
        if top_sections > MAX_SECTIONS { return map{ valid: false, error: "section-cap-reached" }; }
        i = i + 1;
    }
    if in_string or len(stack) != 0 { return map{ valid: false, error: "invalid-json-structure" }; }
    return map{ valid: true, tokens: tokens, top_sections: top_sections };
}

fn _strict_json_error(result) {
    let code = try result.diagnostics[0].code catch "invalid_json";
    if code == "duplicate_key" { return "duplicate-json-key"; }
    if code == "depth_limit" { return "json-depth-cap-reached"; }
    if code == "item_limit" { return "json-token-cap-reached"; }
    if code == "input_limit" { return "input-cap-reached"; }
    if code == "line_limit" { return "line-cap-reached"; }
    if code == "line_size_limit" or code == "scalar_limit" {
        return "line-byte-cap-reached";
    }
    if code == "duplicate_scan_limit" { return "json-duplicate-scan-cap-reached"; }
    return "invalid-json-syntax";
}

fn _csv_profile(text) {
    let in_quotes = false;
    let after_quote = false;
    let cell_chars = 0;
    let cell_bytes = 0;
    let first = "";
    let row_columns = 0;
    let expected_columns = -1;
    let rows = 0;
    let cells = 0;
    let formulas = 0;
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        if in_quotes {
            if ch == "\"" {
                if i + 1 < len(text) and str_slice(text, i + 1, i + 2) == "\"" {
                    cell_chars = cell_chars + 1; cell_bytes = cell_bytes + 1; i = i + 1;
                } else { in_quotes = false; after_quote = true; }
            } else {
                cell_chars = cell_chars + 1; cell_bytes = cell_bytes + len(str_to_bytes(ch));
                if first == "" and str_trim(ch) != "" { first = ch; }
            }
        } elif after_quote and ch != "," and ch != "\n" {
            return map{ valid: false, error: "invalid-csv-trailing-data" };
        } elif ch == "\"" {
            if cell_chars != 0 { return map{ valid: false, error: "invalid-csv-quote" }; }
            in_quotes = true;
        } elif ch == "," or ch == "\n" {
            cells = cells + 1; row_columns = row_columns + 1;
            if first == "=" or first == "+" or first == "-" or first == "@" { formulas = formulas + 1; }
            cell_chars = 0; cell_bytes = 0; first = "";
            after_quote = false;
            if ch == "\n" {
                rows = rows + 1;
                if expected_columns < 0 { expected_columns = row_columns; }
                elif row_columns != expected_columns { return map{ valid: false, error: "ragged-csv-row" }; }
                row_columns = 0;
            }
        } else {
            cell_chars = cell_chars + 1; cell_bytes = cell_bytes + len(str_to_bytes(ch));
            if first == "" and str_trim(ch) != "" { first = ch; }
        }
        if cell_chars > MAX_CSV_CELL_BYTES or cell_bytes > MAX_CSV_CELL_BYTES {
            return map{ valid: false, error: "csv-cell-cap-reached" };
        }
        if cells > MAX_CSV_CELLS { return map{ valid: false, error: "csv-cell-count-cap-reached" }; }
        i = i + 1;
    }
    if in_quotes { return map{ valid: false, error: "unclosed-csv-quote" }; }
    if not str_ends_with(text, "\n") {
        cells = cells + 1; row_columns = row_columns + 1; rows = rows + 1;
        if first == "=" or first == "+" or first == "-" or first == "@" { formulas = formulas + 1; }
        if expected_columns < 0 { expected_columns = row_columns; }
        elif row_columns != expected_columns { return map{ valid: false, error: "ragged-csv-row" }; }
    }
    if rows < 1 or rows > MAX_CSV_ROWS or expected_columns < 1
        or expected_columns > MAX_CSV_COLUMNS or cells > MAX_CSV_CELLS {
        return map{ valid: false, error: "csv-shape-cap-reached" };
    }
    let section_count = num_floor((rows + 7) / 8);
    if section_count > MAX_SECTIONS { return map{ valid: false, error: "section-cap-reached" }; }
    return map{ valid: true, rows: rows, columns: expected_columns,
        cells: cells, formula_like_cells: formulas, section_count: section_count };
}

fn _csv_sections(text, count) {
    let sections = [];
    let i = 0;
    while i < count {
        // CSV row-group sections are metadata hints only. Chunks still provide
        // the exact ordered content partition below.
        push(sections, _section(text, i, "csv-row-group", 0, len(text), 0));
        i = i + 1;
    }
    return sections;
}

fn _chunks(text, target) {
    let chunks = [];
    let start = 0;
    while start < len(text) {
        let finish = start + target;
        if finish > len(text) { finish = len(text); }
        if finish < len(text) {
            let minimum = start + num_floor(target / 2);
            let probe = finish;
            while probe > minimum {
                let c = str_slice(text, probe - 1, probe);
                if c == "\n" or c == " " or c == "\t" { finish = probe; break; }
                probe = probe - 1;
            }
        }
        while finish > start and len(str_to_bytes(str_slice(text, start, finish))) > MAX_CHUNK_CHARS {
            finish = finish - 1;
        }
        if finish <= start { return nil; }
        let content = str_slice(text, start, finish);
        push(chunks, map{ index: len(chunks), text: content,
            start_char: start, end_char: finish,
            char_count: len(content), byte_count: len(str_to_bytes(content)),
            content_digest: sha256(content) });
        if len(chunks) > MAX_CHUNKS { return nil; }
        start = finish;
    }
    return chunks;
}

fn extract(text, declared_format, options = nil) {
    let input = _validated_input(text, declared_format, options);
    if not input.valid { return _error(input.error_code, declared_format); }

    let sections = [];
    let validation = map{};
    if declared_format == "plain" {
        sections = _paragraph_sections(input.text, input.lines);
        if sections == nil { return _error("section-cap-reached", declared_format); }
        validation.plain_structure_validated = true;
    } elif declared_format == "markdown" {
        let profile = _markdown_sections(input.text, input.lines);
        if not profile.valid { return _error(profile.error, declared_format); }
        sections = profile.sections;
        validation.markdown_structure_validated = true;
        validation.markdown_rendered = false;
    } elif declared_format == "json" {
        let strict_json = SERIAL.parse_safe(input.text, "json", map{
            max_input_bytes: MAX_INPUT_BYTES,
            max_output_bytes: MAX_OUTPUT_BYTES,
            max_lines: MAX_LINES,
            max_line_bytes: MAX_LINE_BYTES,
            max_depth: MAX_JSON_DEPTH,
            max_items: MAX_JSON_TOKENS,
            reject_duplicate_keys: true,
        });
        if not strict_json.ok {
            return _error(_strict_json_error(strict_json), declared_format);
        }
        let profile = _json_profile(input.text);
        if not profile.valid { return _error(profile.error, declared_format); }
        sections = _single_section(input.text, "json-document");
        validation.json_syntax_validated = true;
        validation.json_schema_validated = false;
        validation.json_tokens = profile.tokens;
        validation.top_level_sections = profile.top_sections;
        validation.duplicate_keys_checked = strict_json.duplicate_keys_checked;
    } elif declared_format == "csv" {
        let profile = _csv_profile(input.text);
        if not profile.valid { return _error(profile.error, declared_format); }
        sections = _csv_sections(input.text, profile.section_count);
        validation.csv_structure_validated = true;
        validation.rows = profile.rows; validation.columns = profile.columns;
        validation.cells = profile.cells;
        validation.formula_like_cells = profile.formula_like_cells;
        validation.spreadsheet_formulas_evaluated = false;
    } else {
        sections = _pblang_sections(input.text, input.lines);
        if sections == nil { return _error("section-cap-reached", declared_format); }
        validation.declaration_hints_only = true;
        validation.syntax_validated = false;
    }

    let chunks = _chunks(input.text, input.target);
    if chunks == nil or len(chunks) < 1 { return _error("chunk-cap-reached", declared_format); }
    let out = map{};
    out.format = FORMAT; out.ok = true; out.complete = true;
    out.declared_format = declared_format;
    out.extractor = "pblang-native-document-extractor-v1";
    out.input_chars = input.input_chars; out.input_bytes = input.input_bytes;
    out.input_digest = input.input_digest;
    out.normalized_chars = len(input.text);
    out.normalized_bytes = len(str_to_bytes(input.text));
    out.normalized_digest = sha256(input.text);
    out.normalizations = input.transforms;
    out.sections = sections; out.section_count = len(sections);
    out.chunks = chunks; out.chunk_count = len(chunks);
    out.validation = validation; out.contains_content = true;
    out.output_bounded = true;
    out = _negative_flags(out);
    if len(str_to_bytes(json_stringify(out))) > MAX_OUTPUT_BYTES {
        return _error("output-cap-reached", declared_format);
    }
    return out;
}

fn status() {
    return map{ format: "pbai.document-extraction.status.v1", ok: true,
        implementation_language: "pblang", foreign_runtime_required: false,
        pure_in_memory: true, supported_formats:
            ["plain", "markdown", "json", "csv", "pblang-source"],
        max_input_bytes: MAX_INPUT_BYTES, max_input_chars: MAX_INPUT_CHARS,
        max_lines: MAX_LINES, max_sections: MAX_SECTIONS, max_chunks: MAX_CHUNKS,
        opens_files: false, follows_links: false, resolves_imports: false,
        persists: false, trains: false, executes: false,
        sanitizes: false, scans_secrets: false, verifies_rights: false,
        shared_pblang_serialization: true, strict_json_duplicate_keys: true };
}

export FORMAT, MAX_INPUT_BYTES, MAX_INPUT_CHARS, MAX_LINES, MAX_SECTIONS, MAX_CHUNKS;
export extract, status;
