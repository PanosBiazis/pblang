}

fn base_taxonomy() { return _finish(1, "root", _base_nodes()); }

// Builds indexes and traverses each edge once. Cycles and disconnected islands
// cannot hide behind a valid-looking parent ID.
fn validate_taxonomy(taxonomy) {
    if not BOUNDED.inspect_bounded(taxonomy, TAXONOMY_BOUNDS).ok {
        return map{ ok: false, reason: "taxonomy-outside-bounds", authenticated: false };
    }
    if not _exact_keys(taxonomy, TAXONOMY_KEYS) or taxonomy.format != TAXONOMY_FORMAT
        or taxonomy.schema_version != SCHEMA_VERSION {
        return map{ ok: false, reason: "invalid-taxonomy-schema", authenticated: false };
    }
    if not _integer(taxonomy.revision, 1, 9007199254740991)
        or not _slug(taxonomy.root_id) or not _digest(taxonomy.taxonomy_digest) {
        return map{ ok: false, reason: "invalid-taxonomy-identity", authenticated: false };
    }
    if type(taxonomy.nodes) != "array" or len(taxonomy.nodes) < 1 or len(taxonomy.nodes) > MAX_NODES {
        return map{ ok: false, reason: "invalid-taxonomy-node-count", authenticated: false };
    }
    if taxonomy.metadata_only != true or taxonomy.activates_models != false
        or taxonomy.trains_models != false or taxonomy.authorizes_action != false {
        return map{ ok: false, reason: "invalid-taxonomy-safety-flags", authenticated: false };
    }
    let indexes = map{};
    let children = map{};
    let siblings = map{};
    let routes = map{};
    let roots = 0;
    let i = 0;
    while i < len(taxonomy.nodes) {
        let node = taxonomy.nodes[i];
        if not _node_valid(node) or map_has(indexes, node.node_id) {
            return map{ ok: false, reason: "invalid-or-duplicate-node", authenticated: false };
        }
        indexes[node.node_id] = i;
        children[node.node_id] = [];
        if node.node_type == "root" { roots = roots + 1; }
        if node.node_type == "task" or node.node_type == "training-stage" {
            let claim = node.routing_kind + "\x00" + node.routing_domain + "\x00" + node.routing_task
                + "\x00" + node.input_contract + "\x00" + node.output_contract;
            if map_has(routes, claim) { return map{ ok: false, reason: "ambiguous-route-claim", authenticated: false }; }
            routes[claim] = node.node_id;
        }
        i = i + 1;
    }
    if roots != 1 or not map_has(indexes, taxonomy.root_id)
        or taxonomy.nodes[indexes[taxonomy.root_id]].node_type != "root" {
        return map{ ok: false, reason: "invalid-root", authenticated: false };
    }
    i = 0;
    while i < len(taxonomy.nodes) {
        let node = taxonomy.nodes[i];
        if node.node_type != "root" {
            if not map_has(indexes, node.parent_id) or node.parent_id == node.node_id {
                return map{ ok: false, reason: "orphan-or-self-parent", authenticated: false };
            }
            let claim = node.parent_id + "\x00" + node.segment;
            if map_has(siblings, claim) { return map{ ok: false, reason: "duplicate-sibling-segment", authenticated: false }; }
            siblings[claim] = node.node_id;
            let bucket = children[node.parent_id];
            push(bucket, node.node_id);
            if len(bucket) > MAX_CHILDREN { return map{ ok: false, reason: "too-many-children", authenticated: false }; }
        }
        i = i + 1;
    }
    let queue = [taxonomy.root_id];
    let depths = map{};
    depths[taxonomy.root_id] = 0;
    let cursor = 0;
    while cursor < len(queue) {
        let current = queue[cursor];
        let current_node = taxonomy.nodes[indexes[current]];
        if current_node.node_type != "root" and current_node.node_type != "category"
            and len(children[current]) > 0 {
            return map{ ok: false, reason: "routeable-node-must-be-leaf", authenticated: false };
        }
        for child in children[current] {
            if map_has(depths, child) { return map{ ok: false, reason: "cycle-or-duplicate-edge", authenticated: false }; }
            let depth = depths[current] + 1;
            if depth > MAX_DEPTH { return map{ ok: false, reason: "maximum-depth-exceeded", authenticated: false }; }
            depths[child] = depth;
            push(queue, child);
        }
        cursor = cursor + 1;
    }
    if len(queue) != len(taxonomy.nodes) { return map{ ok: false, reason: "cycle-or-disconnected-tree", authenticated: false }; }
    let expected = sha256(json_stringify(_taxonomy_payload(taxonomy.revision, taxonomy.root_id, taxonomy.nodes)));
    if expected != taxonomy.taxonomy_digest { return map{ ok: false, reason: "taxonomy-digest-mismatch", authenticated: false }; }
    return map{ ok: true, reason: "valid-metadata-taxonomy", revision: taxonomy.revision,
        node_count: len(taxonomy.nodes), route_count: len(map_keys(routes)), authenticated: false,
        activates_models: false, trains_models: false, authorizes_action: false };
}

fn _find(taxonomy, node_id) {
    let i = 0;
    while i < len(taxonomy.nodes) { if taxonomy.nodes[i].node_id == node_id { return i; } i = i + 1; }
    return -1;
}

fn _request_valid(request) {
    if not _exact_keys(request, REQUEST_KEYS) or request.format != REQUEST_FORMAT
        or request.schema_version != SCHEMA_VERSION or not _slug(request.node_id)
        or not _slug(request.segment) or not _in(["category", "task", "training-stage"], request.node_type) { return false; }
    if request.node_type == "category" {
        return request.routing_kind == "" and request.routing_domain == "" and request.routing_task == ""
            and request.input_contract == "" and request.output_contract == "";
    }
    if request.node_type == "task" and request.routing_kind != "inference" { return false; }
    if request.node_type == "training-stage" and request.routing_kind == "inference" { return false; }
    return _kind(request.routing_kind) and _slug(request.routing_domain) and _slug(request.routing_task)
        and _contract(request.input_contract) and _contract(request.output_contract);
}

fn register_disabled_node(taxonomy, parent_id, request) {
    if not validate_taxonomy(taxonomy).ok {
        return map{ ok: false, reason: "invalid-taxonomy", revision: 0 };
    }
    if not _slug(parent_id) or not BOUNDED.inspect_bounded(request, REQUEST_BOUNDS).ok or not _request_valid(request) {
        return map{ ok: false, reason: "invalid-registration-request", revision: taxonomy.revision };
    }
    let parent_index = _find(taxonomy, parent_id);
    if parent_index < 0 or _find(taxonomy, request.node_id) >= 0 {
        return map{ ok: false, reason: "missing-parent-or-duplicate-node", revision: taxonomy.revision };
    }
    let parent_type = taxonomy.nodes[parent_index].node_type;
    if parent_type != "root" and parent_type != "category" {
        return map{ ok: false, reason: "routeable-parent-forbidden", revision: taxonomy.revision };
    }
    let updated = json_parse(json_stringify(taxonomy));
    let added = _node(request.node_id, request.segment, parent_id, request.node_type,
        request.routing_kind, request.routing_domain, request.routing_task,
        request.input_contract, request.output_contract, false, true);
    push(updated.nodes, added);
    updated.revision = updated.revision + 1;
    updated.taxonomy_digest = sha256(json_stringify(_taxonomy_payload(updated.revision, updated.root_id, updated.nodes)));
    let checked = validate_taxonomy(updated);
    if not checked.ok { return map{ ok: false, reason: checked.reason, revision: taxonomy.revision }; }
    return map{ ok: true, action: "registered-disabled", node_id: added.node_id,
        revision: updated.revision, taxonomy: updated, activates_model: false,
        trains_model: false, authorizes_action: false };
}

fn extend_path(taxonomy, parent_id, requests) {
    if not validate_taxonomy(taxonomy).ok {
        return map{ ok: false, reason: "invalid-taxonomy", revision: 0 };
    }
    let parent_index = _find(taxonomy, parent_id);
    if not _slug(parent_id) or parent_index < 0
        or not BOUNDED.inspect_bounded(requests, REQUEST_BOUNDS).ok or type(requests) != "array"
        or len(requests) < 1 or len(requests) > MAX_PATH_SEGMENTS {
        return map{ ok: false, reason: "invalid-path-extension", revision: taxonomy.revision };
    }
    let parent_type = taxonomy.nodes[parent_index].node_type;
    if parent_type != "root" and parent_type != "category" {
        return map{ ok: false, reason: "routeable-parent-forbidden", revision: taxonomy.revision };
    }
    let updated = json_parse(json_stringify(taxonomy));
    let current = parent_id;
    for request in requests {
        if not _request_valid(request) or _find(updated, request.node_id) >= 0 {
            return map{ ok: false, reason: "invalid-or-conflicting-path-segment", revision: taxonomy.revision };
        }
        push(updated.nodes, _node(request.node_id, request.segment, current, request.node_type,
            request.routing_kind, request.routing_domain, request.routing_task,
            request.input_contract, request.output_contract, false, true));
        current = request.node_id;
    }
    updated.revision = updated.revision + 1;
    updated.taxonomy_digest = sha256(json_stringify(_taxonomy_payload(updated.revision, updated.root_id, updated.nodes)));
    let checked = validate_taxonomy(updated);
    if not checked.ok { return map{ ok: false, reason: checked.reason, revision: taxonomy.revision }; }
    return map{ ok: true, action: "path-extended-disabled", leaf_node_id: current,
        added_nodes: len(requests), revision: updated.revision, taxonomy: updated,
        activates_model: false, trains_model: false, authorizes_action: false };
}

// Turns an exact routeable leaf into a category and preserves its former route
// under a new `general` child. The old broad path then resolves only as a
// non-routeable category, allowing arbitrarily finer siblings to be added safely.
fn refine_leaf(taxonomy, node_id, general_node_id) {
    if not validate_taxonomy(taxonomy).ok {
        return map{ ok: false, reason: "invalid-taxonomy", revision: 0 };
    }
    if not _slug(node_id) or not _slug(general_node_id) or _find(taxonomy, general_node_id) >= 0 {
        return map{ ok: false, reason: "invalid-or-duplicate-refinement-id", revision: taxonomy.revision };
    }
    let node_index = _find(taxonomy, node_id);
    if node_index < 0 {
        return map{ ok: false, reason: "missing-refinement-leaf", revision: taxonomy.revision };
    }
    let source = taxonomy.nodes[node_index];
    if source.node_type != "task" and source.node_type != "training-stage" {
        return map{ ok: false, reason: "refinement-target-must-be-routeable-leaf", revision: taxonomy.revision };
    }
    let updated = json_parse(json_stringify(taxonomy));
    updated.nodes[node_index] = _node(source.node_id, source.segment, source.parent_id,
        "category", "", "", "", "", "", source.protected,
        source.dynamically_registered);
    push(updated.nodes, _node(general_node_id, "general", source.node_id,
        source.node_type, source.routing_kind, source.routing_domain, source.routing_task,
        source.input_contract, source.output_contract, source.protected,
        source.dynamically_registered));
    updated.revision = updated.revision + 1;
    updated.taxonomy_digest = sha256(json_stringify(_taxonomy_payload(
        updated.revision, updated.root_id, updated.nodes)));
    let checked = validate_taxonomy(updated);
    if not checked.ok { return map{ ok: false, reason: checked.reason, revision: taxonomy.revision }; }
    return map{ ok: true, action: "routeable-leaf-refined", category_node_id: node_id,
        general_node_id: general_node_id, revision: updated.revision, taxonomy: updated,
        previous_path_now_routeable: false, activates_model: false,
        trains_model: false, authorizes_action: false };
}

fn resolve_path(taxonomy, segments) {
    if not validate_taxonomy(taxonomy).ok or type(segments) != "array"
        or len(segments) < 1 or len(segments) > MAX_DEPTH + 1 {
        return map{ ok: false, decision: "abstain", reason: "invalid-taxonomy-or-path", may_route: false };
    }
    for segment in segments { if not _slug(segment) { return map{ ok: false,
        decision: "abstain", reason: "invalid-path-segment", may_route: false }; } }
    let indexes = map{};
    let child_claims = map{};
    for node in taxonomy.nodes {
        indexes[node.node_id] = node;
        if node.parent_id != "" { child_claims[node.parent_id + "\x00" + node.segment] = node.node_id; }
    }
    let root = indexes[taxonomy.root_id];
    if segments[0] != root.segment { return map{ ok: false, decision: "abstain",
        reason: "path-must-start-at-root", may_route: false }; }
    let current = taxonomy.root_id;
    let i = 1;
    while i < len(segments) {
        let claim = current + "\x00" + segments[i];
        if not map_has(child_claims, claim) { return map{ ok: false, decision: "abstain",
            reason: "exact-path-not-found", may_route: false }; }
        current = child_claims[claim];
        i = i + 1;
    }
    return map{ ok: true, decision: "abstain", reason: "exact-node-resolved",
        node: json_parse(json_stringify(indexes[current])),
        taxonomy_revision: taxonomy.revision, taxonomy_digest: taxonomy.taxonomy_digest,
        may_route: false, activates_model: false, trains_model: false, authorizes_action: false };
}

fn descendants(taxonomy, parent_id, max_results = 64) {
    if not validate_taxonomy(taxonomy).ok or not _slug(parent_id) or _find(taxonomy, parent_id) < 0
        or not _integer(max_results, 1, MAX_NODES) { return map{ ok: false,
        reason: "invalid-taxonomy-or-request", nodes: [], truncated: false, complete: false }; }
    let adjacency = map{};
    for node in taxonomy.nodes { adjacency[node.node_id] = []; }
    for node in taxonomy.nodes {
        if node.parent_id != "" { let bucket = adjacency[node.parent_id]; push(bucket, node); }
    }
    let queue = [parent_id];
    let output = [];
    let discovered = 0;
    let cursor = 0;
    while cursor < len(queue) {
        let current = queue[cursor];
        for node in adjacency[current] {
            discovered = discovered + 1;
            push(queue, node.node_id);
            if len(output) < max_results { push(output, json_parse(json_stringify(node))); }
        }
        cursor = cursor + 1;
    }
    return map{ ok: true, nodes: output, returned: len(output), discovered: discovered,
        truncated: discovered > len(output), complete: discovered <= len(output),
        activates_model: false, authorizes_action: false };
}

fn ancestors(taxonomy, node_id) {
    if not validate_taxonomy(taxonomy).ok or not _slug(node_id) or _find(taxonomy, node_id) < 0 {
        return map{ ok: false, reason: "invalid-taxonomy-or-node", nodes: [], complete: false };
    }
    let indexes = map{};
    for node in taxonomy.nodes { indexes[node.node_id] = node; }
    let output = [];
    let current = indexes[node_id];
    let steps = 0;
    while current.parent_id != "" and steps <= MAX_DEPTH {
        current = indexes[current.parent_id];
        push(output, json_parse(json_stringify(current)));
        steps = steps + 1;
    }
    return map{ ok: true, nodes: output, returned: len(output), complete: true,
        activates_model: false, authorizes_action: false };
}

fn route_path(taxonomy, catalog, segments) {
    let fail = map{ format: ROUTE_FORMAT, ok: false, decision: "abstain", may_route: false,
        reason: "invalid-taxonomy-catalog-or-path", artifact_verified: false,
        activates_model: false, training_started: false, authorizes_action: false };
    if not validate_taxonomy(taxonomy).ok or not CATALOG.validate_catalog(catalog).ok { return fail; }
    let resolved = resolve_path(taxonomy, segments);
    if not resolved.ok { fail.reason = resolved.reason; return fail; }
    let node = resolved.node;
    if node.node_type != "task" and node.node_type != "training-stage" {
        fail.reason = "category-is-not-routeable"; return fail;
    }
    let plan = CATALOG.exact_coverage_plan(catalog, node.routing_kind, node.routing_domain,
        node.routing_task, node.input_contract, node.output_contract);
    return map{ format: ROUTE_FORMAT, ok: plan.ok, decision: "abstain", may_route: false,
        reason: plan.reason, taxonomy_revision: taxonomy.revision,
        taxonomy_digest: taxonomy.taxonomy_digest, node_id: node.node_id,
        node_digest: node.descriptor_digest, catalog_revision: catalog.revision,
        catalog_plan: plan, artifact_verified: false, activates_model: false,
        training_started: false, authorizes_action: false };
}

fn status() {
    let taxonomy = base_taxonomy();
    return map{ format: "pbai.model.taxonomy-status.v1", ok: validate_taxonomy(taxonomy).ok,
        implementation_language: "pblang", base_nodes: len(taxonomy.nodes),
        arbitrary_nested_subcategories: true, maximum_edges_per_path: MAX_DEPTH,
        extensible_in_bounded_atomic_slices: true, maximum_segments_per_extension: MAX_PATH_SEGMENTS,
        exact_leaf_routing_only: true, routing_inheritance: false, metadata_only: true,
        dynamic_model_activation: false, model_training_available: false,
        taxonomy_authenticated: false, authorizes_action: false };
}

export TAXONOMY_FORMAT, NODE_FORMAT, REQUEST_FORMAT, ROUTE_FORMAT, SCHEMA_VERSION;
export MAX_NODES, MAX_DEPTH, MAX_CHILDREN, MAX_PATH_SEGMENTS;
export base_taxonomy, validate_taxonomy, register_disabled_node, extend_path, refine_leaf;
export resolve_path, ancestors, descendants, route_path, status;
