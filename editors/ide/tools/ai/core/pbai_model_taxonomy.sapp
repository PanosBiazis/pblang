// pbai_model_taxonomy.sapp -- bounded arbitrary-depth specialist taxonomy.
// Metadata only: never loads, trains, activates, or authorizes a model.

let BOUNDED = import("stdlib:validate.sapp");
let CATALOG = (try import("pbai_model_catalog.sapp") catch import("editors/ide/tools/ai/core/pbai_model_catalog.sapp"));

let TAXONOMY_FORMAT = "pbai.model.taxonomy.v1";
let NODE_FORMAT = "pbai.model.taxonomy-node.v1";
let REQUEST_FORMAT = "pbai.model.taxonomy-registration.v1";
let ROUTE_FORMAT = "pbai.model.taxonomy-route.v1";
let SCHEMA_VERSION = "1.0.0";
let MAX_NODES = 1024;
let MAX_DEPTH = 32;
let MAX_CHILDREN = 64;
let MAX_PATH_SEGMENTS = 16;

let TAXONOMY_KEYS = ["format", "schema_version", "revision", "root_id",
    "taxonomy_digest", "nodes", "metadata_only", "activates_models",
    "trains_models", "authorizes_action"];
let NODE_KEYS = ["format", "schema_version", "node_id", "segment", "parent_id",
    "node_type", "routing_kind", "routing_domain", "routing_task",
    "input_contract", "output_contract", "lifecycle_state", "protected",
    "dynamically_registered", "active", "authorizes_action", "descriptor_digest"];
let REQUEST_KEYS = ["format", "schema_version", "node_id", "segment", "node_type",
    "routing_kind", "routing_domain", "routing_task", "input_contract", "output_contract"];
let TAXONOMY_BOUNDS = map{ max_depth: 8, max_nodes: 65536, max_map_entries: 24,
    max_array_items: MAX_NODES, max_string_chars: 128, max_string_bytes: 128,
    max_total_string_bytes: 2097152, max_key_chars: 64, max_key_bytes: 64 };
let REQUEST_BOUNDS = map{ max_depth: 6, max_nodes: 4096, max_map_entries: 16,
    max_array_items: MAX_PATH_SEGMENTS, max_string_chars: 128, max_string_bytes: 128,
    max_total_string_bytes: 131072, max_key_chars: 64, max_key_bytes: 64 };

fn _in(items, value) {
    if type(items) != "array" { return false; }
    let i = 0;
    while i < len(items) { if items[i] == value { return true; } i = i + 1; }
    return false;
}

fn _exact_keys(value, allowed) {
    if type(value) != "map" { return false; }
    let keys = map_keys(value);
    if len(keys) != len(allowed) { return false; }
    for key in keys { if not _in(allowed, key) { return false; } }
    return true;
}

fn _integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}

// Lowercase ASCII slugs remove Unicode-confusable and delimiter ambiguity.
fn _slug(value) {
    if type(value) != "string" or value == "" or len(value) > 64
        or len(str_to_bytes(value)) != len(value) { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if i == 0 and not (c >= 97 and c <= 122) { return false; }
        if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45) { return false; }
        if c == 45 and (i == 0 or i == len(value) - 1
            or strcharcodeat(value, i - 1) == 45) { return false; }
        i = i + 1;
    }
    return not _in(["nil", "null", "true", "false"], value);
}

fn _contract(value) {
    if type(value) != "string" or value == "" or len(value) > 128
        or len(str_to_bytes(value)) != len(value) { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57)
            or c == 45 or c == 46) { return false; }
        i = i + 1;
    }
    return true;
}

fn _kind(value) {
    return _in(["inference", "curator", "trainer", "evaluator", "verifier", "governance"], value);
}

fn _digest(value) {
    if type(value) != "string" or len(value) != 64 { return false; }
    let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

fn _node_payload(node) {
    return map{ format: NODE_FORMAT, schema_version: SCHEMA_VERSION,
        node_id: node.node_id, segment: node.segment, parent_id: node.parent_id,
        node_type: node.node_type, routing_kind: node.routing_kind,
        routing_domain: node.routing_domain, routing_task: node.routing_task,
        input_contract: node.input_contract, output_contract: node.output_contract,
        lifecycle_state: "registered-disabled", protected: node.protected,
        dynamically_registered: node.dynamically_registered,
        active: false, authorizes_action: false };
}

fn _node(id, segment, parent, node_type, kind = "", domain = "", task = "",
    input_contract = "", output_contract = "", protected = true, dynamic = false) {
    let node = map{ format: NODE_FORMAT, schema_version: SCHEMA_VERSION,
        node_id: id, segment: segment, parent_id: parent, node_type: node_type,
        routing_kind: kind, routing_domain: domain, routing_task: task,
        input_contract: input_contract, output_contract: output_contract,
        lifecycle_state: "registered-disabled", protected: protected,
        dynamically_registered: dynamic, active: false, authorizes_action: false };
    node.descriptor_digest = sha256(json_stringify(_node_payload(node)));
    return node;
}

fn _node_valid(node) {
    if not _exact_keys(node, NODE_KEYS) or node.format != NODE_FORMAT
        or node.schema_version != SCHEMA_VERSION or not _slug(node.node_id)
        or not _slug(node.segment) or not _in(["root", "category", "task", "training-stage"], node.node_type)
        or node.lifecycle_state != "registered-disabled" or type(node.protected) != "bool"
        or type(node.dynamically_registered) != "bool" or node.active != false
        or node.authorizes_action != false or not _digest(node.descriptor_digest) { return false; }
    if node.node_type == "root" {
        if node.parent_id != "" or node.routing_kind != "" or node.routing_domain != ""
            or node.routing_task != "" or node.input_contract != "" or node.output_contract != ""
            or not node.protected or node.dynamically_registered { return false; }
    } else {
        if not _slug(node.parent_id) { return false; }
        if node.node_type == "category" {
            if node.routing_kind != "" or node.routing_domain != "" or node.routing_task != ""
                or node.input_contract != "" or node.output_contract != "" { return false; }
        } else if (node.node_type == "task" and node.routing_kind != "inference")
            or (node.node_type == "training-stage" and node.routing_kind == "inference")
            or not _kind(node.routing_kind) or not _slug(node.routing_domain)
            or not _slug(node.routing_task) or not _contract(node.input_contract)
            or not _contract(node.output_contract) { return false; }
    }
    return sha256(json_stringify(_node_payload(node))) == node.descriptor_digest;
}

fn _taxonomy_payload(revision, root_id, nodes) {
    let ids = [];
    let by_id = map{};
    for node in nodes { push(ids, node.node_id); by_id[node.node_id] = node.descriptor_digest; }
    ids = array_sort(ids);
    let claims = [];
    for id in ids { push(claims, id + ":" + by_id[id]); }
    return map{ format: TAXONOMY_FORMAT, schema_version: SCHEMA_VERSION,
        revision: revision, root_id: root_id, node_claims: claims,
        metadata_only: true, activates_models: false, trains_models: false,
        authorizes_action: false };
}

fn _finish(revision, root_id, nodes) {
    let taxonomy = map{ format: TAXONOMY_FORMAT, schema_version: SCHEMA_VERSION,
        revision: revision, root_id: root_id, taxonomy_digest: "", nodes: nodes,
        metadata_only: true, activates_models: false, trains_models: false,
        authorizes_action: false };
    taxonomy.taxonomy_digest = sha256(json_stringify(_taxonomy_payload(revision, root_id, nodes)));
    return taxonomy;
}

fn _route(id, segment, parent, kind, domain, task) {
    return _node(id, segment, parent, if kind == "inference" { "task" } else { "training-stage" },
        kind, domain, task, "pbai.model.input.v1", "pbai.model.output.v1");
}

