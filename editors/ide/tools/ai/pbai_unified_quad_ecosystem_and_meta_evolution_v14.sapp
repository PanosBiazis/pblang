fn _num(v, fallback = 0.0) {
    if v == nil { return fallback; }
    if type(v) == "number" { return v * 1.0; }
    return fallback;
}

fn _int(v, fallback = 0) {
    if v == nil { return fallback; }
    if type(v) == "number" { return num_floor(v); }
    return fallback;
}

fn _str(v, fallback = "") {
    if v == nil { return fallback; }
    if type(v) == "string" { return v; }
    return str(v);
}

fn _bool(v, fallback = false) {
    if v == nil { return fallback; }
    if type(v) == "bool" { return v; }
    return fallback;
}

fn _get_num(s, k, fallback = 0.0) {
    if type(s) == "map" and map_has(s, k) { return _num(s[k], fallback); }
    return fallback;
}

fn _get_int(s, k, fallback = 0) {
    if type(s) == "map" and map_has(s, k) { return _int(s[k], fallback); }
    return fallback;
}

fn _get_str(s, k, fallback = "") {
    if type(s) == "map" and map_has(s, k) { return _str(s[k], fallback); }
    return fallback;
}

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

