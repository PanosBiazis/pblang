            path: "pblang/editors/ide/tools/mcpservers/pb-mcp-server",
            total_tools: embedded_mcp_tools,
            lazy_modules: embedded_lazy_modules,
            boot_eager_modules: 0,
            parity_score: 1.0,
            smart_idle_compliant: true,
            zero_hallucination_verified: true
        },
        map{
            id: "standalone_pb_mcp_server",
            name: "Standalone PB-MCP-Server Product",
            version: target_version,
            path: "pb-mcp-server",
            total_tools: standalone_mcp_tools,
            llm_cognition_tools_count: 25,
            offline_sealed_protocol: true,
