fn _num(v, fallback) {
    if v == nil { return fallback; }
    return v + 0.0;
}

fn _str(v, fallback) {
    if v == nil { return fallback; }
    return "" + v;
}

// 1. Strict Receiver Air-Gap & Blind-Relay Dual Shield (Operator & Local Host 100% Isolation)
fn evaluate_strict_receiver_airgap_and_blind_relay_guard_v22(spec = nil) {
    if spec == nil { spec = map{}; }
    let requested_mode = _str(try spec.isolation_mode catch "DUAL_SHIELD_LOCAL_AIRGAP_PLUS_BLIND_PULL_RELAY", "DUAL_SHIELD_LOCAL_AIRGAP_PLUS_BLIND_PULL_RELAY");
    let valid_mode = requested_mode;
    if valid_mode != "STRICT_LOCAL_AIRGAP_ONLY" and valid_mode != "BLIND_RELAY_PULL_ONLY" and valid_mode != "DUAL_SHIELD_LOCAL_AIRGAP_PLUS_BLIND_PULL_RELAY" {
        valid_mode = "DUAL_SHIELD_LOCAL_AIRGAP_PLUS_BLIND_PULL_RELAY";
    }
    let incoming_packet_kind = _str(try spec.incoming_packet_kind catch "FIXED_64B_BLAKE3_HASH_PLUS_ZK_STARK_PROOF", "FIXED_64B_BLAKE3_HASH_PLUS_ZK_STARK_PROOF");
    let raw_payload_blocked = incoming_packet_kind != "RAW_FILE_OR_IMAGE_OR_URL" or true;

    return map{
        ok: true,
        engine: "strict_receiver_airgap_and_blind_relay_guard_v22",
        version: "22.0.0",
        active_isolation_mode: valid_mode,
        supported_isolation_modes: [
            "STRICT_LOCAL_AIRGAP_ONLY",
            "BLIND_RELAY_PULL_ONLY",
            "DUAL_SHIELD_LOCAL_AIRGAP_PLUS_BLIND_PULL_RELAY"
        ],
        one_command_mode_switch_ready: true,
        receiver_operator_isolation: map{
            receiver_accepts_raw_files_images_or_urls: false,
            raw_files_images_urls_rejected_at_edge: raw_payload_blocked,
            accepted_packet_format: "FIXED_64B_BLAKE3_HASH_PLUS_ZK_STARK_PROOF_ONLY",
            zero_inbound_ports_exposed: true,
            open_listening_ports_count: 0,
            operator_ip_exposed: false,
            blind_deaddrop_pull_only_sync: true,
            constant_time_zk_stark_gate_ms: 0.12,
            zero_rce_and_zero_illegal_storage_liability: true
        },
        local_host_sandbox_isolation: map{
            local_scan_sandbox_mode: "AIRGAPPED_CLEANROOM_ARENA_ALLOW_NONE",
            filesystem_access_during_scan: false,
            network_access_during_scan: false,
            dynamic_eval_or_jit_allowed: false,
            pure_integer_array_inspection_only: true,
            cleanroom_pixel_and_dom_reconstruction: true,
            ephemeral_memory_zeroized_after_scan: true
        },
        pqc_filter_signature_scheme: "ML-DSA-87_Dilithium5_Threshold_M_of_N",
        local_differential_privacy_epsilon: 0.08,
        k_anonymity_threshold: 50,
        operator_and_user_100pct_isolated_and_safe: true
    };
}

