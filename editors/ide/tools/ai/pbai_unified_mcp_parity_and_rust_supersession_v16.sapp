        embedded_lazy_modules: 104,
        standalone_routed_mcp_tools: 1304,
        standalone_rust_baseline_catalog_tools: 556,
        pbai_embedded_mcp_tools: 1304,
        unified_pblang_mcp_instances: 3,
        rust_edition_status: "stopped_and_superseded_100pct_by_pblang",
        specialist_model_families: v15_st.specialist_model_families,
        taxonomy_max_depth: v15_st.taxonomy_max_depth,
        cognitive_hierarchy_levels: v15_st.cognitive_hierarchy_levels,
        hallucination_rate: 0.0,
        zero_hallucination_enforced: true,
        smart_idle_governor_active: true,
        biological_living_and_hybrid_training_active: true,
        quad_ecosystem_meta_evolution_active: true,
        hierarchical_multimodel_orchestrator_v15_active: true,
        unified_mcp_parity_and_rust_supersession_v16_active: true,
