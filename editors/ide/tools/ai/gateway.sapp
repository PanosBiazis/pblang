// editors/ide/tools/ai/gateway.sapp — the AI gateway for the IDE's 🤖 AI panel.
//
// Written in pblang and backed by **pbAI** — pblang's OWN model (`stdlib/pbai.sapp`).
// NO Ollama, NO external model, NO outbound network: the intelligence is pblang's own.
// It exposes exactly the contract the IDE AI panel speaks:
//
//   GET  /health      -> "ok"                  (the panel's online/offline indicator)
//   OPTIONS *         -> 204 + CORS            (browser preflight)
//   POST /mcp/tool    -> { tool, arguments:{ prompt, language } }
//                        routed to pbAI (`respond_tool`) and returned as
//                        { result, tool, model:"pbAI" }.
//   POST /browse      -> 503 until post-DNS destination pinning is available.
//   POST /submit      -> 503 until post-DNS destination pinning is available.
//   POST /parse-ui    -> { code } -> { ok, tree }            (designer web round-trip, D1)
//   POST /parse-gui   -> { code } -> { ok, form, widgets }   (designer desktop round-trip, D3)
//
// CORS defaults to exact loopback IDE origins only. Add explicit comma-separated
// origins with PB_AI_GATEWAY_ALLOWED_ORIGINS when embedding the gateway elsewhere.
//
// Create a random token inside a current-user-owned mode-0700 directory, then run:
//   PB_AI_GATEWAY_MODE=developer-loopback \
//   PB_AI_GATEWAY_TOKEN_FILE=/private/dir/token \
//   ./target/release/pblang run editors/ide/tools/ai/gateway.sapp \
//     --allow-import --allow-env --allow-fs --allow-net \
//     --io-timeout-ms=1000 \
//     --deny-http --deny-exec --deny-ffi --deny-sqlite --deny-spawn --deny-process-exit
//
// Then set the IDE AI panel endpoint to http://127.0.0.1:8080 (the default).

fn _require_developer_mode() {
    let mode = try env_get("PB_AI_GATEWAY_MODE") catch "";
    if mode != "developer-loopback" {
        throw "PBIDE AI gateway is developer-only until portable pre-auth connection isolation is available";
    }
}

// Fail before importing the model, parsers or server and before any bind.
_require_developer_mode();

let pbai = import("stdlib/pbai.sapp");
let uiparse = import("stdlib/ui_parse.sapp");
let guiparse = import("stdlib/gui_parse.sapp");
let server = import("stdlib/http_server.sapp");

// NativeTcp's 1 MiB text envelope also carries up to 16 KiB of headers.
let MAX_BODY_CHARS = 1000000;
let MAX_PROMPT_CHARS = 65536;
let MAX_SOURCE_CHARS = 262144;
