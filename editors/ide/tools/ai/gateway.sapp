// editors/ide/tools/ai/gateway.sapp — the AI gateway for the IDE's 🤖 AI panel.
//
// Written in pblang and backed by **pbAI** — pblang's OWN model (`stdlib/pbai.sapp`).
// NO Ollama, NO external model, NO outbound network: the intelligence is pblang's own.
// It exposes exactly the contract the IDE AI panel speaks:
//
//   GET  /health      -> "ok"                  (the panel's online/offline indicator)
//   OPTIONS *         -> 204 + CORS            (browser preflight)
//   POST /mcp/tool    -> { tool, arguments:{ prompt, language } }
//                        routed to pbAI (`respond_tool`) and returned as
//                        { result, tool, model:"pbAI" }.
//   POST /browse      -> { url }  ->  the pblang web browser engine (browser.sapp)
//                        fetches + parses the page: { url, ok, title, text, links, forms, html }.
//   POST /submit      -> { action, method, fields } -> submit a form (GET query / POST body)
//                        via the pblang browser engine; returns the resulting page record.
//   POST /parse-ui    -> { code } -> { ok, tree }            (designer web round-trip, D1)
//   POST /parse-gui   -> { code } -> { ok, form, widgets }   (designer desktop round-trip, D3)
//
// CORS is open ("*") so the browser IDE (file:// or :8090) can call it cross-origin.
//
// Run from the repo root (imports resolve from the working directory):
//   ./target/debug/pblang run editors/ide/tools/ai/gateway.sapp --allow-all
//   # optional env: PB_AI_GATEWAY_BIND (default 127.0.0.1:8080).
//
// Then set the IDE AI panel endpoint to http://127.0.0.1:8080 (the default).

let pbai = import("stdlib/pbai.sapp");
let browser = import("stdlib/browser.sapp");
let uiparse = import("stdlib/ui_parse.sapp");
let guiparse = import("stdlib/gui_parse.sapp");
let server = import("stdlib/http_server.sapp");

// Open CORS so the browser IDE may call the gateway from another origin.
fn cors() {
    return map{
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
    };
}

fn json_resp(status, obj) {
    return map{ status: status, body: json_stringify(obj), content_type: "application/json", headers: cors() };
}

fn handle(req) {
    let method = try req.method catch "GET";
    let path = try req.path catch "/";

    // CORS preflight
    if method == "OPTIONS" {
        return map{ status: 204, body: "", content_type: "text/plain", headers: cors() };
    }

    // Health — drives the panel's live status indicator.
    if path == "/health" {
        return map{ status: 200, body: "ok", content_type: "text/plain", headers: cors() };
    }

    // Tool call — answered by pbAI, entirely in-process.
    if path == "/mcp/tool" and method == "POST" {
        let body = try req.body catch "";
        let payload = try json_parse(body) catch nil;
        if payload == nil { return json_resp(400, map{ error: "invalid JSON body" }); }

        let tool = try payload.tool catch "ai_ollama_generate";
        let args = try payload.arguments catch map{};
        let prompt = try args.prompt catch "";
        if prompt == "" { return json_resp(400, map{ error: "missing arguments.prompt" }); }

        let text = try pbai.respond_tool(tool, prompt) catch nil;
        if text == nil { return json_resp(500, map{ error: "pbAI failed to produce a response" }); }
        return json_resp(200, map{ result: text, tool: tool, model: "pbAI" });
    }

    // Browser — the IDE's pblang web browser fetches + parses a page via browser.sapp.
    if path == "/browse" and method == "POST" {
        let payload = try json_parse(try req.body catch "") catch nil;
        if payload == nil { return json_resp(400, map{ error: "invalid JSON body" }); }
        let url = try payload.url catch "";
        if url == "" { return json_resp(400, map{ error: "missing url" }); }
        let tor = try payload.tor catch false;          // opt-in Tor routing (default off)
        let page = try browser.fetch_page(url, tor) catch nil;
        if page == nil { return json_resp(502, map{ error: "browser engine failed" }); }
        return json_resp(200, page);
    }

    // Form submission — the pblang browser submits a form (GET query or POST body).
    if path == "/submit" and method == "POST" {
        let payload = try json_parse(try req.body catch "") catch nil;
        if payload == nil { return json_resp(400, map{ error: "invalid JSON body" }); }
        let action = try payload.action catch "";
        if action == "" { return json_resp(400, map{ error: "missing action" }); }
        let fmethod = try payload.method catch "get";
        let fields = try payload.fields catch map{};
        let tor = try payload.tor catch false;          // opt-in Tor routing (default off)
        let page = try browser.submit(action, fmethod, fields, tor) catch nil;
        if page == nil { return json_resp(502, map{ error: "form submit failed" }); }
        return json_resp(200, page);
    }

    // Designer round-trip — parse generated pblang web code back into a component tree.
    if path == "/parse-ui" and method == "POST" {
        let payload = try json_parse(try req.body catch "") catch nil;
        if payload == nil { return json_resp(400, map{ error: "invalid JSON body" }); }
        let code = try payload.code catch "";
        let tree = try uiparse.parse(code) catch nil;
        if tree == nil { return json_resp(502, map{ error: "ui parse failed" }); }
        return json_resp(200, map{ ok: true, tree: tree });
    }

    // Designer round-trip (desktop, D3) — parse generated gui.sapp code back into a
    // form + widget list (the D1 analogue for the desktop GUI kind).
    if path == "/parse-gui" and method == "POST" {
        let payload = try json_parse(try req.body catch "") catch nil;
        if payload == nil { return json_resp(400, map{ error: "invalid JSON body" }); }
        let code = try payload.code catch "";
        let design = try guiparse.parse(code) catch nil;
        if design == nil { return json_resp(502, map{ error: "gui parse failed" }); }
        return json_resp(200, map{ ok: true, form: design.form, widgets: design.widgets, model: design.model });
    }

    return json_resp(404, map{ error: "not found: " + method + " " + path });
}

let bind = try env_get("PB_AI_GATEWAY_BIND") catch nil;
if bind == nil { bind = "127.0.0.1:8080"; }
print "pblang AI gateway — backed by pbAI (stdlib/pbai.sapp), no external model";
print "endpoints: GET /health, OPTIONS *, POST /mcp/tool";
print "set the IDE AI panel endpoint to http://" + bind;
server.serve_forever(bind, handle);
