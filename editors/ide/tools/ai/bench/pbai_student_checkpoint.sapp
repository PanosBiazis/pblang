let AI=import("stdlib/pbai.sapp");
let training=[];let validation=[];let examples=[];let test=[];
for i 4 {
 push(training,map{x:[i],y:i+4});push(validation,map{x:[7,i],y:i+4});
 for prefix in [[6],[5],[4,6],[6,5]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(examples,map{x:ids,y:i+4});}
 for prefix in [[1,6],[2,5],[3,4],[7,6]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(test,map{x:ids,y:i+4});}
}
let teacher=AI.neural_specialist_train(training,validation);
fn stats(xs) {let ordered=array_sort(xs);return map{samples_ms:xs,median_ms:ordered[3],p95_sample_ms:ordered[6]};}
let cases=[];
for weight in [0,0.5,1] {
 let student=AI.neural_specialist_distill_supervised(teacher.artifact,examples,validation,
  map{epochs:64,lr:0.1,temperature:2,hard_weight:weight,max_grad_norm:1});
 let before=student.evaluate(test);let encoded=AI.neural_specialist_student_encode(student.checkpoint());
 let warm=AI.neural_specialist_student_load(AI.neural_specialist_student_decode(encoded));warm.evaluate(test);
 let times=[];let evaluation_times=[];let expected="";let after=nil;let max_delta=0;let changed=0;
 for _sample 7 {
  let start=now_ms();let restored=AI.neural_specialist_student_load(AI.neural_specialist_student_decode(encoded));push(times,now_ms()-start);
  start=now_ms();after=restored.evaluate(test);push(evaluation_times,now_ms()-start);
  assert(AI.neural_specialist_student_encode(restored.checkpoint())==encoded,"checkpoint reload idempotence");
  let serialized=json_stringify(after);if expected=="" {expected=serialized;} else {assert(expected==serialized,"repeatable loaded quality");}
  assert(restored.close(),"release measured reload outside timed sections");
 }
 for ex in test {
  let old=student.predict(ex.x);let new=warm.predict(ex.x);
  if old.token!=new.token {changed=changed+1;}
  for i len(old.logits) {let d=old.logits[i]-new.logits[i];if d<0 {d=0-d;}if d>max_delta {max_delta=d;}}
 }
 push(cases,map{hard_weight:weight,checkpoint_bytes:len(str_to_bytes(encoded)),artifact_digest:student.checkpoint().digest,
  before:before.student,after:after.student,changed_predictions:changed,max_absolute_logit_delta:max_delta,
  decode_and_load:stats(times),evaluation:stats(evaluation_times),loaded_holdout_verified:after.exact_student_input_disjointness_checked});
 assert(warm.close() and student.close(),"release warmup and student after final comparisons");
}
print json_stringify(map{format:"pbai.student.checkpoint.benchmark.v1",cases:cases,warmups:1,samples:7,test_examples:16,
 fixed_point_scale:1000000,repeatable:true,timing_scope:"shared desktop; codec/load only; training excluded; no speed claim",
 quality_scope:"synthetic token mapping; checkpoint precision experiment",agi_status:"not-demonstrated",asi_status:"not-demonstrated"});
