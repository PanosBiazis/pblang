// Same loaded prediction workload before/after: setup and close excluded.
let N=import("../core/pbai_neural_adapter.sapp");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1}).checkpoint();
let loaded=N.student_load(artifact);let predict=loaded.predict;
let reference_prediction=predict([6,0]);assert(reference_prediction.token==5,"synthetic learned target");
let expected=json_stringify(reference_prediction);let samples=[];let operations=100;
for sample 8 {
 let start=now_ms();
 for repeat operations {
  assert(json_stringify(predict([6,0]))==expected,"identical hot prediction "+str(repeat));
 }
 let elapsed=now_ms()-start;if sample>0 {push(samples,elapsed);}
}
assert(loaded.close() and not loaded.close(),"close semantics retained after timing");
let blocked=try {predict([6,0]);false} catch true;assert(blocked,"saved alias rejects after close");
print json_stringify(map{format:"pbai.loaded-prediction.bench.v1",samples_ms:samples,
 warmups:1,operations_per_sample:operations,checkpoint_digest:artifact.digest,
 encoded_bytes:len(str_to_bytes(N.student_encode(artifact))),prediction:reference_prediction.token,
 includes_inference:true,includes_file_read:false,includes_close:false,
 includes_training:false,includes_import_startup:false,
 globally_activated:false});
