let AI=import("stdlib/pbai.sapp");
let teacher_train=[];let valid=[];let original=[];let training=[];let test=[];
for i 4 {
 push(teacher_train,map{x:[i],y:i+4});push(valid,map{x:[7,i],y:i+4});
 for prefix in [[6],[5],[4,6],[6,5]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(original,ids);}
 for prefix in [[0,7],[1,7],[2,7],[3,7]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(training,map{x:ids,y:i+4});}
 for prefix in [[1,6],[2,5],[3,4],[7,6]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(test,map{x:ids,y:i+4});}
}
let teacher=AI.neural_specialist_train(teacher_train,valid);
let seed=AI.neural_specialist_distill(teacher.artifact,original,valid);
let parent=seed.checkpoint();assert(seed.close(),"release checkpoint seed");
let parent_encoded=AI.neural_specialist_student_encode(parent);
fn create() {return AI.neural_specialist_student_continue(parent,training,valid);}
fn stats(xs) {let ordered=array_sort(xs);return map{samples_ms:xs,median_ms:ordered[2],p95_sample_ms:ordered[4]};}
let warm=create();warm.evaluate(test);assert(warm.close(),"release warmup");
let times=[];let evaluation_times=[];let expected="";let report=nil;let evaluated=nil;let loaded=nil;
for _sample 5 {
 let start=now_ms();let candidate=create();push(times,now_ms()-start);
 start=now_ms();evaluated=candidate.evaluate(test);push(evaluation_times,now_ms()-start);
 report=candidate.report;let restored=AI.neural_specialist_student_load(candidate.checkpoint());
 loaded=restored.evaluate(test);assert(restored.close(),"release reload after evaluation");
 let result=json_stringify([report,evaluated,loaded]);
 if expected=="" {expected=result;} else {assert(expected==result,"repeatable continuation and serialized quality");}
 assert(AI.neural_specialist_student_encode(parent)==parent_encoded,"baseline checkpoint unchanged");
 assert(candidate.close(),"release measured candidate outside timed sections");
}
print json_stringify(map{format:"pbai.student.continuation.benchmark.v1",warmups:1,samples:5,
 teacher_examples:4,original_student_contexts:16,new_training_examples:16,validation_examples:4,test_examples:16,
 training:stats(times),evaluation:stats(evaluation_times),report:report,test:evaluated,reloaded:loaded,
 original_checkpoint_unchanged:true,repeatable:true,hyperparameter_search:false,
 timing_scope:"shared desktop wall time; parent training excluded; continuation includes train/validation diagnostics",
 quality_scope:"fixed synthetic token mapping; prior provenance not authenticated by API",
 agi_status:"not-demonstrated",asi_status:"not-demonstrated"});
