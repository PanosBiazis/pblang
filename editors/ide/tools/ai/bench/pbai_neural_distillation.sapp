// Fixed diagnostic workload; no tuning or activation based on these test labels.
let AI=import("stdlib/pbai.sapp");
let training=[];let validation=[];let contexts=[];let test=[];
for i 4 {
 push(training,map{x:[i],y:i+4});push(validation,map{x:[7,i],y:i+4});
 for prefix in [[6],[5],[4,6],[6,5]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(contexts,ids);}
 for prefix in [[1,6],[2,5],[3,4],[7,6]] {let ids=[];for p in prefix {push(ids,p);}push(ids,i);push(test,map{x:ids,y:i+4});}
}
let teacher=AI.neural_specialist_train(training,validation);
fn create() {return AI.neural_specialist_distill(teacher.artifact,contexts,validation);}
fn stats(samples) {let sorted=array_sort(samples);return map{samples_ms:samples,median_ms:sorted[3],p95_sample_ms:sorted[6]};}
let warm=create();warm.evaluate(test);warm.predict([1,6,0]);
let train_times=[];let eval_times=[];let inference_times=[];let metrics=nil;let report=nil;let expected="";
for _sample 7 {
 let start=now_ms();let student=create();push(train_times,now_ms()-start);
 start=now_ms();metrics=student.evaluate(test);push(eval_times,now_ms()-start);
 start=now_ms();for _call 10 {student.predict([1,6,0]);}push(inference_times,(now_ms()-start)/10);
 report=student.report;let measured=json_stringify([report,metrics]);
 if expected=="" {expected=measured;} else {assert(expected==measured,"repeatable weights and quality metrics");}
}
print json_stringify(map{format:"pbai.neural.distillation.benchmark.v1",teacher_training_examples:4,
 student_training_contexts:16,validation_examples:4,test_examples:16,warmups:1,samples:7,
 student_training:stats(train_times),evaluation:stats(eval_times),student_inference:stats(inference_times),
 inference_calls_per_sample:10,training_report:report,test:metrics,repeatable:true,
 timing_scope:"CPU wall time; teacher training excluded; training includes validation",
 quality_scope:"fixed synthetic token mapping; teacher training provenance not verified by distillation API",
 agi_status:"not-demonstrated",asi_status:"not-demonstrated",globally_activated:false});
