let AI=import("stdlib/pbai.sapp");
let previous_training=[map{x:[0],y:4},map{x:[1,0],y:4}];let previous_holdout=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([previous_training[0]],previous_holdout);
let seed=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],previous_holdout);
let parent=seed.checkpoint();assert(seed.close(),"release checkpoint seed");
let history=AI.neural_specialist_student_history(parent,previous_training,previous_holdout);
let parent_text=AI.neural_specialist_student_encode(parent);
let history_text=AI.neural_specialist_student_history_encode(parent,history);
fn run(label) {
    return AI.neural_specialist_student_continue_reviewed(parent,history,
        [map{x:[2,0],y:label},map{x:[3,0],y:label}],[map{x:[4,0],y:label}],
        map{epochs:64,lr:0.1,max_grad_norm:1});
}
let results=[];
for label in [4,5] {
    let warm=run(label);assert(warm.close(),"release warmup");let samples=[];let expected="";let report=nil;
    for _sample 5 {
        let start=now_ms();let review=run(label);push(samples,now_ms()-start);
        report=review.report();let text=json_stringify(report);
        if expected=="" {expected=text;} else {assert(expected==text,"repeatable review");}
        assert(report.passed==(label==4),"fixed positive and forgetting cases");
        if report.passed {
            review.accept();assert(review.checkpoint().digest==report.candidate_digest,"accept serialized candidate");
            review.rollback();
        }
        assert(review.checkpoint().digest==parent.digest,"parent retained or restored");
        assert(AI.neural_specialist_student_encode(parent)==parent_text,"source checkpoint unchanged");
        assert(AI.neural_specialist_student_history_encode(parent,history)==history_text,"source history unchanged");
        assert(review.close(),"release measured review outside timed sections");
    }
    let sorted=array_sort(samples);
    push(results,map{label:label,samples_ms:samples,median_ms:sorted[2],p95_sample_ms:sorted[4],report:report});
}
print json_stringify(map{format:"pbai.student.review.benchmark.v1",warmups:1,samples:5,cases:results,
    timing_scope:"shared desktop wall time; parent setup excluded; training and serialized review included",
    quality_scope:"fixed synthetic positive and forgetting fixtures; no hyperparameter search",
    parent_unchanged:true,history_unchanged:true,independent_test:false,
    agi_status:"not-demonstrated",asi_status:"not-demonstrated"});
