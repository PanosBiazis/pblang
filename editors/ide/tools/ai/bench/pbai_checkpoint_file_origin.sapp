// Same explicit private-file workload for baseline/candidate dependency-origin checks.
let N=import("../core/pbai_neural_adapter.sapp");
let IO=import("../core/pbai_student_checkpoint_io.sapp");
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");
assert(type(directory)=="string" and directory!="","fresh private benchmark directory required");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1}).checkpoint();
let path=path_join(directory,"student.json");IO.save_new(path,artifact);
let expected=json_stringify(N.student_load(artifact).predict([6,0]));
let samples=[];let operations=5;
for sample 8 {
 let start=now_ms();
 for repeat operations {
  let loaded=IO.load_file(path);
  assert(json_stringify(loaded.predict([6,0]))==expected,"identical checkpoint inference "+str(repeat));
 }
 let elapsed=now_ms()-start;if sample>0 {push(samples,elapsed);}
}
print json_stringify(map{format:"pbai.checkpoint-file-origin.bench.v1",samples_ms:samples,
 warmups:1,operations_per_sample:operations,checkpoint_digest:artifact.digest,
 encoded_bytes:len(str_to_bytes(N.student_encode(artifact))),prediction:5,
 includes_inference:true,includes_file_read:true,includes_import_startup:false,
 globally_activated:false});
