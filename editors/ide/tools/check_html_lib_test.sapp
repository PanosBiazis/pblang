// Test: editors/ide/tools/check_html_lib.sapp — the IDE's tokenizer-aware bracket balancer.
// Verifies braces are counted in code but IGNORED inside strings, // and /* */ comments, `template ${…}`
// literals, and /regex/ literals — the exact confusions that would give the HTML validator false alarms.
// Run:  pblang run editors/ide/tools/check_html_lib_test.sapp   (from the pblang project root)

let L = import("editors/ide/tools/check_html_lib.sapp");

fn fail(m) { throw "FAIL " + m; }
fn bal(s, cu, pa, sq, m) {
    let b = L._balance(s);
    if b.curly != cu or b.paren != pa or b.square != sq {
        fail(m + ": got {}=" + str(b.curly) + " ()=" + str(b.paren) + " []=" + str(b.square)
             + " want {}=" + str(cu) + " ()=" + str(pa) + " []=" + str(sq));
    }
}

// ── plain code ──
bal("{ ( [ ] ) }", 0, 0, 0, "balanced mix");
bal("function f() { return [1,2]; }", 0, 0, 0, "real function");
bal("{ {", 2, 0, 0, "two unclosed curlies");
bal("(()", 0, 1, 0, "one unclosed paren (two opens, one close)");
bal("]", 0, 0, -1, "extra close square goes negative");

// ── strings hide braces ──
bal("\"{ { {\"", 0, 0, 0, "double-quoted string braces ignored");
bal("'([{'", 0, 0, 0, "single-quoted string brackets ignored");
bal("\"a\\\"{\" + x", 0, 0, 0, "escaped quote inside string");   // \" does not end the string

// ── comments hide braces ──
bal("// { { {\n", 0, 0, 0, "line comment braces ignored");
bal("/* } ) ] */", 0, 0, 0, "block comment braces ignored");
bal("x /* { */ = { }", 0, 0, 0, "code after block comment still counts (balanced)");
bal("a = 1 // {\nb = { }", 0, 0, 0, "line comment then balanced block");

// ── template literals hide braces, but ${…} holes contain real code ──
bal("`text { } [ ]`", 0, 0, 0, "plain template text braces ignored");
bal("`${ {a:1} }`", 0, 0, 0, "template hole with a balanced object literal");
bal("`${ f({x:1}) }`", 0, 0, 0, "template hole with a call + object");
bal("`a ${ \"}\" } b`", 0, 0, 0, "brace inside a string inside a hole is ignored");

// ── regex vs division ──
bal("x = /a{2}/g;", 0, 0, 0, "regex after '=' — braces inside regex ignored");
bal("if (ok) { y = a / b; }", 0, 0, 0, "division after identifier is not a regex");
bal("var re = /[{(]/;", 0, 0, 0, "regex char class hides open brackets");

// ── a genuinely unbalanced script (what the validator should FLAG) ──
bal("function g() { if (x) { return; }", 1, 0, 0, "missing one closing brace is detected");

// ── unterminated-construct detection ──
fn unterm(s, kind, m) {
    let u = L.first_unterminated(s);
    if u == nil { fail(m + ": expected unterminated " + kind + ", got nil"); }
    if u.kind != kind { fail(m + ": expected kind '" + kind + "' got '" + str(u.kind) + "'"); }
}
fn clean(s, m) {
    let u = L.first_unterminated(s);
    if u != nil { fail(m + ": expected no unterminated, got " + str(u.kind) + " at " + str(u.pos)); }
}

// terminated / harmless — nil
clean("var x = { a: \"hi\", b: `t${1}` };", "fully terminated code");
clean("/* a block */ x = 1;", "closed block comment");
clean("// unterminated-looking but a line comment\n", "line comment ends at newline");
clean("var re = /ab{c/;", "closed regex is fine");

// the bugs this catches (previously reported as 'balanced')
unterm("var s = \"oops { { {", "string", "unterminated double-quoted string");
unterm("x = 'still open", "string", "unterminated single-quoted string");
unterm("/* never closed ) } ]", "block comment", "unterminated block comment");
unterm("var t = `template ${ x } more", "template literal", "unterminated template");
unterm("var t = `hole ${ \"unterminated", "template literal", "unterminated string inside a hole");

// ── boundary-aware open-tag counting: <div> must not match <divider> ──
fn tagcount(s, tag, want, m) {
    let got = L.count_open_tag(s, tag);
    if got != want { fail(m + ": count_open_tag('" + tag + "') got " + str(got) + " want " + str(want)); }
}
tagcount("<div></div>", "div", 1, "one plain div");
tagcount("<div class=\"x\"></div>", "div", 1, "div with attributes");
tagcount("<div/>", "div", 1, "self-closing div");
tagcount("<div>\n<div>", "div", 2, "two opens (newline/eof boundaries)");
tagcount("<divider></divider>", "div", 0, "divider is NOT a div (the bug this fixes)");
tagcount("<div><divider></divider></div>", "div", 1, "div + divider counts one div");
tagcount("<section></section>", "div", 0, "unrelated tag");

// ── attribute-aware <script> extraction (the driver's str_split("<script>") missed attributed scripts) ──
fn scripts_eq(html, wantCount, m) {
    let s = L.extract_scripts(html);
    if len(s) != wantCount { fail(m + ": got " + str(len(s)) + " scripts want " + str(wantCount)); }
    return s;
}
scripts_eq("<script>var x=1;</script>", 1, "bare script");
let s2 = scripts_eq("<script type=\"module\">let y={a:1};</script>", 1, "script WITH attributes (the fix)");
if str_trim(s2[0]) != "let y={a:1};" { fail("attributed-script content extracted correctly"); }
scripts_eq("<script src=\"app.js\"></script>", 1, "external script (empty inline content)");
scripts_eq("<head></head><body>no scripts</body>", 0, "no scripts");
scripts_eq("<script>a</script><script defer>b</script>", 2, "two scripts, one attributed");
// a script name-prefix must not match (<scripting> is not <script>)
scripts_eq("<scripting>not a script</scripting>", 0, "scripting is not script");
// extracted content is what _balance sees — an attributed script with an imbalance is now caught
let bad = L.extract_scripts("<script type=\"x\">function f() { </script>");
let bal = L._balance(bad[0]);
if bal.curly == 0 { fail("attributed script's imbalance is now visible to _balance"); }

print "check_html_lib: all balance + unterminated + tag-count + script-extract cases passed";
