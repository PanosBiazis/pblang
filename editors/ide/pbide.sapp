fn _starter_code() {
    return EXAMPLES[0].code;
}

fn _file_tab_title(path) {
    let p = str(try path catch "");
    if str_trim(p) == "" { return "untitled.sapp"; }
    let b = try path_basename(p) catch p;
    if b == nil or str(b) == "" { return p; }
    return str(b);
}

fn _array_has_text(xs, value) {
    let v = str(value);
    let i = 0;
    while xs != nil and i < len(xs) {
        if str(xs[i]) == v { return true; }
        i = i + 1;
    }
    return false;
}

fn _example_main_path(ex) {
    let p = str(try ex.main_path catch "");
    if p == "" { p = str(try ex.run_path catch ""); }
    return p;
}

fn _example_project_files(ex) {
    let out = [];
    let files = try ex.files catch [];
    let i = 0;
    while files != nil and i < len(files) {
        let p = str(files[i]);
        if p != "" and not _array_has_text(out, p) { array_push(out, p); }
        i = i + 1;
    }
    let main = _example_main_path(ex);
    if main != "" and not _array_has_text(out, main) { array_push(out, main); }
    return out;
}

fn _project_files_text(files) {
    if files == nil or len(files) == 0 { return ""; }
    let out = "project files (" + str(len(files)) + "):";
    let i = 0;
    while i < len(files) and i < 18 {
        out = out + "\n- " + str(files[i]);
        i = i + 1;
    }
    if len(files) > 18 { out = out + "\n- ... +" + str(len(files) - 18) + " more"; }
    return out;
}

fn _example_code(ex) {
    let p = _example_main_path(ex);
    if p != "" {
        let raw = try fs_read(p) catch nil;
        if raw != nil { return raw; }
    }
    return str(try ex.code catch "");
}

fn _current_file_tab(state) {
    let p = str(try state.path catch "");
    return map{
        title: _file_tab_title(p),
        path: p,
        code: E.text(state.ed),
        dirty: try state.dirty catch false,
        file_profile: try state.file_profile catch IDE.editor_asset_profile(p),
        preview_mode: str(try state.preview_mode catch "text"),
        project_root: str(try state.project_root catch ""),
        project_files: try state.project_files catch [],
        example_run_path: str(try state.example_run_path catch ""),
        example_app_kind: str(try state.example_app_kind catch ""),
        example_title: str(try state.example_title catch "")
    };
}

fn _file_tab_for_path(path, fallback_code, dirty, project_root, project_files, ex) {
    let p = str(path);
    let profile = IDE.editor_asset_profile(p);
    let text = str(fallback_code);
    if p != "" {
        let loaded = try fs_read(p) catch nil;
        if loaded != nil { text = str(loaded); }
    }
    let mode = str(try profile.preview catch "text");
    return map{
        title: _file_tab_title(p),
        path: p,
        code: text,
        dirty: dirty,
        file_profile: profile,
        preview_mode: mode,
        project_root: str(project_root),
        project_files: project_files,
        example_run_path: str(try ex.run_path catch ""),
        example_app_kind: str(try ex.app_kind catch ""),
        example_title: str(try ex.title catch "")
    };
}

fn _file_tabs_sync_current(state) {
    let tabs = try state.file_tabs catch [];
    if tabs == nil or len(tabs) == 0 { return 0; }
    let sel = try state.file_tab_sel catch 0;
    if sel < 0 { sel = 0; }
    if sel >= len(tabs) { sel = len(tabs) - 1; }
    tabs[sel] = _current_file_tab(state);
    state.file_tabs = tabs;
    state.file_tab_sel = sel;
    return 0;
}

fn _file_tabs_add_current(state) {
    let tabs = try state.file_tabs catch [];
    if tabs == nil { tabs = []; }
    let cur = _current_file_tab(state);
    let p = str(try cur.path catch "");
    let found = 0 - 1;
    let i = 0;
    while i < len(tabs) {
        if p != "" and str(try tabs[i].path catch "") == p { found = i; }
        i = i + 1;
    }
    if found >= 0 {
        tabs[found] = cur;
        state.file_tab_sel = found;
    } else {
        array_push(tabs, cur);
        state.file_tab_sel = len(tabs) - 1;
    }
    state.file_tabs = tabs;
    return 0;
}

fn _file_tabs_load(state, idx) {
    let tabs = try state.file_tabs catch [];
    if tabs == nil or idx < 0 or idx >= len(tabs) { return false; }
    _file_tabs_sync_current(state);
    tabs = state.file_tabs;
    let tab = tabs[idx];
    state.ed = E.new(str(try tab.code catch ""));
    state.path = str(try tab.path catch "");
    state.dirty = try tab.dirty catch false;
    state.file_profile = try tab.file_profile catch IDE.editor_asset_profile(state.path);
    state.preview_mode = str(try tab.preview_mode catch try state.file_profile.preview catch "text");
    state.preview_path = "";
    state.tokens = nil;
    state.token_lines = nil;
    state.syntax_hash = "";
    state.syntax_rev = 0 - 1;
    state.syntax_status = "";
    state.last = "other";
    state.project_root = str(try tab.project_root catch "");
    state.project_files = try tab.project_files catch [];
    state.example_run_path = str(try tab.example_run_path catch "");
    state.example_app_kind = str(try tab.example_app_kind catch "");
    state.example_title = str(try tab.example_title catch "");
    state.file_tab_sel = idx;
    state.panel = "code";
    _refresh_watcher(state, "file-tab");
    state.output = "tab: " + _file_tab_title(state.path);
    let listing = _project_files_text(try state.project_files catch []);
    if listing != "" { state.output = state.output + "\n" + listing; }
    return true;
}

fn _file_tabs_reset_for_example(state, ex, main_code) {
    let files = _example_project_files(ex);
    let root = str(try ex.project_root catch "");
    let tabs = [];
    let main = _example_main_path(ex);
    let selected = 0;
    if len(files) == 0 {
        state.project_root = root;
        state.project_files = [];
        _file_tabs_add_current(state);
        return 0;
    }
    let i = 0;
    while i < len(files) {
        let p = str(files[i]);
        let fallback = "";
        if p == main { fallback = main_code; }
        let tab = _file_tab_for_path(p, fallback, false, root, files, ex);
        array_push(tabs, tab);
        if p == main { selected = i; }
        i = i + 1;
    }
    state.file_tabs = tabs;
    state.file_tab_sel = selected;
    state.project_root = root;
    state.project_files = files;
    if selected >= 0 and selected < len(tabs) {
        let tab = tabs[selected];
        state.ed = E.new(str(try tab.code catch main_code));
        state.path = str(try tab.path catch main);
        state.file_profile = try tab.file_profile catch IDE.editor_asset_profile(state.path);
        state.preview_mode = str(try tab.preview_mode catch try state.file_profile.preview catch "text");
        state.dirty = false;
        state.tokens = nil;
        state.token_lines = nil;
        state.syntax_hash = "";
        state.syntax_rev = 0 - 1;
    }
    return 0;
}

fn _file_tabs_height(state) {
    let tabs = try state.file_tabs catch [];
    if tabs == nil or len(tabs) == 0 { return 0; }
    return CH + PAD;
}

fn _code_content_top(state) {
    return TOP + _file_tabs_height(state);
}

fn _style_name(state) {
    let s = try state.style catch "web";
    if s == nil { return "web"; }
    return s;
}

fn _style_next(s) {
    return IDE.ide_visual_style_next(s);
}

fn _theme_name(state) {
    let t = try state.theme catch "dark";
    if t == nil or t == "" { return "dark"; }
    return str_lower(str(t));
}

fn _theme_is_light(state) {
    return _theme_name(state) == "light";
}

fn _theme_label(state) {
    if _theme_is_light(state) { return "Light"; }
    return "Dark";
}

fn _theme_toggle(state) {
    if _theme_is_light(state) { state.theme = "dark"; }
    else { state.theme = "light"; }
    state.output = "theme: " + state.theme;
    _ui_event(state, "theme " + state.theme);
    return 0;
}

fn _visual_tokens(state) {
    return IDE.ide_visual_tokens(_style_name(state), _theme_name(state));
}

fn _visual_chrome(state) {
    return IDE.ide_visual_chrome(_style_name(state), _theme_name(state));
}

fn _style_bg(state) {
    if _theme_is_light(state) { return gfx.rgb(246, 248, 252); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(9, 13, 20); }
    if s == "smooth" { return gfx.rgb(11, 18, 30); }
    if s == "crystal" { return gfx.rgb(7, 15, 26); }
    if s == "contrast" { return gfx.rgb(2, 5, 10); }
    return BG;
}

fn _style_surface(state) {
    if _theme_is_light(state) { return gfx.rgb(235, 240, 248); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(18, 24, 34); }
    if s == "smooth" { return gfx.rgb(22, 33, 50); }
    if s == "crystal" { return gfx.rgb(18, 35, 50); }
    if s == "contrast" { return gfx.rgb(12, 17, 27); }
    return SURFACE;
}

fn _style_surface2(state) {
    if _theme_is_light(state) { return gfx.rgb(246, 249, 253); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(28, 36, 48); }
    if s == "smooth" { return gfx.rgb(32, 48, 70); }
    if s == "crystal" { return gfx.rgb(30, 58, 78); }
    if s == "contrast" { return gfx.rgb(27, 35, 54); }
    return SURFACE2;
}

fn _style_panel(state) {
    if _theme_is_light(state) { return gfx.rgb(252, 253, 255); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(11, 16, 24); }
    if s == "smooth" { return gfx.rgb(8, 15, 25); }
    if s == "crystal" { return gfx.rgb(10, 22, 34); }
    if s == "contrast" { return gfx.rgb(2, 6, 12); }
    return PANEBG;
}

fn _style_gutter(state) {
    if _theme_is_light(state) { return gfx.rgb(225, 232, 244); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(8, 12, 18); }
    if s == "smooth" { return gfx.rgb(10, 17, 28); }
    if s == "crystal" { return gfx.rgb(8, 19, 30); }
    if s == "contrast" { return gfx.rgb(4, 7, 13); }
    return GUTTERBG;
}

fn _style_accent(state) {
    if _theme_is_light(state) { return gfx.rgb(24, 96, 216); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(80, 190, 255); }
    if s == "smooth" { return gfx.rgb(64, 220, 190); }
    if s == "crystal" { return gfx.rgb(125, 225, 255); }
    if s == "contrast" { return gfx.rgb(245, 158, 11); }
    return TABACT;
}

fn _style_border(state) {
    if _theme_is_light(state) { return gfx.rgb(205, 216, 232); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(45, 55, 72); }
    if s == "smooth" { return gfx.rgb(44, 62, 86); }
    if s == "crystal" { return gfx.rgb(56, 82, 104); }
    return BORDER;
}

fn _style_muted(state) {
    if _theme_is_light(state) { return gfx.rgb(72, 84, 104); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(148, 163, 184); }
    if s == "smooth" { return gfx.rgb(156, 176, 196); }
    if s == "crystal" { return gfx.rgb(172, 202, 218); }
    return GUTTER;
}

fn _style_text(state) {
    if _theme_is_light(state) { return gfx.rgb(21, 30, 44); }
    let s = _style_name(state);
    if s == "web" { return gfx.rgb(225, 232, 242); }
    if s == "smooth" { return gfx.rgb(230, 240, 248); }
    if s == "crystal" { return gfx.rgb(235, 250, 255); }
    return FG;
}

fn _style_pane_text(state) {
    if _theme_is_light(state) { return gfx.rgb(24, 95, 84); }
    return PANEFG;
}

fn _style_currow(state) {
    if _theme_is_light(state) { return gfx.rgb(235, 241, 252); }
    if _style_name(state) == "smooth" { return gfx.rgb(17, 29, 46); }
    if _style_name(state) == "crystal" { return gfx.rgb(14, 34, 50); }
    return CURROW;
}

fn _style_hilite(state) {
    if _theme_is_light(state) { return gfx.rgb(216, 231, 252); }
    if _style_name(state) == "smooth" { return gfx.rgb(34, 64, 88); }
    if _style_name(state) == "crystal" { return gfx.rgb(34, 86, 104); }
    return HILITE;
}

fn _style_row_rule(state) {
    if _theme_is_light(state) { return gfx.rgb(235, 241, 250); }
    if _style_name(state) == "smooth" { return gfx.rgb(21, 32, 48); }
    if _style_name(state) == "crystal" { return gfx.rgb(16, 37, 54); }
    return gfx.rgb(15, 23, 34);
}

fn _style_modal_backdrop(state) {
    if _theme_is_light(state) { return gfx.rgb(226, 234, 245); }
    return gfx.rgb(6, 9, 16);
}

fn _style_info(state) {
    if _theme_is_light(state) { return gfx.rgb(28, 96, 160); }
    return gfx.rgb(102, 194, 255);
}

fn _style_warning(state) {
    if _theme_is_light(state) { return gfx.rgb(150, 96, 18); }
    return gfx.rgb(255, 204, 102);
}

fn _style_success(state) {
    if _theme_is_light(state) { return gfx.rgb(20, 128, 96); }
    return gfx.rgb(46, 224, 189);
}

fn _style_error(state) {
    if _theme_is_light(state) { return gfx.rgb(190, 64, 74); }
    return TERMERR;
}

fn _style_purple(state) {
    if _theme_is_light(state) { return gfx.rgb(104, 82, 165); }
    return gfx.rgb(180, 170, 255);
}

fn _style_splitter(state) {
    if _theme_is_light(state) { return gfx.rgb(202, 214, 232); }
    return gfx.rgb(18, 30, 48);
}

fn _style_focus(state) {
    if _theme_is_light(state) { return gfx.rgb(42, 145, 245); }
    if _style_name(state) == "contrast" { return gfx.rgb(255, 198, 92); }
    if _style_name(state) == "crystal" { return gfx.rgb(132, 245, 255); }
    return gfx.rgb(68, 226, 198);
}

fn _style_shadow(state) {
    if _theme_is_light(state) { return gfx.rgb(214, 224, 238); }
    if _style_name(state) == "crystal" { return gfx.rgb(1, 12, 22); }
    return gfx.rgb(3, 7, 13);
}

fn _style_rail(state) {
    if _theme_is_light(state) { return gfx.rgb(218, 230, 247); }
    if _style_name(state) == "crystal" { return gfx.rgb(4, 14, 24); }
    return gfx.rgb(6, 11, 20);
}

fn _design_canvas_bg(state) {
    if _theme_is_light(state) { return gfx.rgb(242, 246, 252); }
    return gfx.rgb(24, 28, 42);
}

fn _design_grid_dot(state) {
    if _theme_is_light(state) { return gfx.rgb(214, 224, 240); }
    return gfx.rgb(40, 46, 66);
}

fn _design_palette_action_bg(state) {
    if _theme_is_light(state) { return gfx.rgb(232, 239, 250); }
    return gfx.rgb(46, 40, 64);
}

fn _design_palette_app_bg(state) {
    if _theme_is_light(state) { return gfx.rgb(216, 235, 249); }
    return gfx.rgb(36, 72, 104);
}

fn _toolbar_panel_bg(state, active) {
    if active {
        if _theme_is_light(state) { return gfx.rgb(30, 107, 222); }
        if _style_name(state) == "smooth" { return gfx.rgb(28, 150, 136); }
        if _style_name(state) == "crystal" { return gfx.rgb(28, 145, 190); }
        return gfx.rgb(47, 115, 218);
    }
    if _theme_is_light(state) { return gfx.rgb(238, 244, 252); }
    if _style_name(state) == "smooth" { return gfx.rgb(23, 36, 55); }
    if _style_name(state) == "crystal" { return gfx.rgb(18, 41, 58); }
    return gfx.rgb(24, 34, 50);
}

fn _toolbar_panel_fg(state, active) {
    if active { return gfx.rgb(245, 248, 255); }
    return _style_muted(state);
}

fn _toolbar_action_bg(state, id) {
    if id == "run" { return gfx.rgb(0, 184, 148); }
    if id == "mode" {
        if _theme_is_light(state) { return gfx.rgb(224, 239, 252); }
        return gfx.rgb(31, 72, 105);
    }
    if id == "watch" {
        if _theme_is_light(state) { return gfx.rgb(220, 244, 237); }
        return gfx.rgb(27, 82, 68);
    }
    if id == "style" {
        if _theme_is_light(state) { return gfx.rgb(239, 234, 252); }
        if _style_name(state) == "crystal" { return gfx.rgb(28, 82, 104); }
        return gfx.rgb(51, 45, 74);
    }
    if id == "theme" {
        if _theme_is_light(state) { return gfx.rgb(224, 232, 244); }
        return gfx.rgb(34, 45, 62);
    }
    return _style_surface2(state);
}

fn _toolbar_watch_state_bg(state, badge) {
    if badge == "watch stale" {
        if _theme_is_light(state) { return gfx.rgb(250, 232, 204); }
        return gfx.rgb(116, 82, 24);
    }
    if str_contains(badge, "watch err ") {
        if _theme_is_light(state) { return gfx.rgb(252, 220, 225); }
        return gfx.rgb(116, 38, 48);
    }
    if str_contains(badge, "watch ui ") {
        if _theme_is_light(state) { return gfx.rgb(250, 232, 204); }
        return gfx.rgb(116, 82, 24);
    }
    return _toolbar_action_bg(state, "watch");
}

fn _toolbar_action_fg(state, id) {
    if id == "run" { return gfx.rgb(4, 35, 29); }
    if _theme_is_light(state) { return _style_text(state); }
    if id == "theme" { return FG; }
    return _style_text(state);
}

fn _toolbar_brand_subtitle(state) {
    let v = _visual_tokens(state);
    return str(try v.density catch "clean") + " / " + str(try v.motion catch "fast");
}

fn _toolbar_brand_w(sz) {
    let ww = try sz.w catch 1280;
    if ww < 760 { return 9 * CW; }
    if ww < 1100 { return 12 * CW; }
    return 18 * CW;
}

fn _toolbar_action_start(sz) {
    return PAD + _toolbar_brand_w(sz) + PAD;
}

fn _toolbar_rows(sz) {
    if sz == nil { return 1; }
    let one = _toolbar_brand_w(sz) + PAD + _actions_linear_w(sz) + PAD + _panel_total_w_mode(true) + 2 * PAD;
    if one > (try sz.w catch 1280) { return 2; }
    return 1;
}

fn _toolbar_height_for(sz) {
    if _toolbar_rows(sz) > 1 { return CH * 2 + 5 * PAD; }
    return CH + 3 * PAD;
}

fn _apply_toolbar_metrics(sz) {
    let h = _toolbar_height_for(sz);
    if h != TBH {
        TBH = h;
        TOP = TBH + PAD;
        STATUSH = CH + 2 * PAD;
        PANEH = STATUSH;
        return true;
    }
    return false;
}

fn _actions_linear_w(sz) {
    let w = 0;
    let i = 0;
    let gap = _toolbar_gap(sz);
    while i < len(ACTIONS) {
        w = w + _action_w(i);
        if i + 1 < len(ACTIONS) { w = w + gap; }
        i = i + 1;
    }
    return w;
}

fn _design_badge_color(state, kind) {
    if kind == "nditem" or kind == "light" or kind == "particles" { return _style_warning(state); }
    if kind == "scan3d" or kind == "terrain" or kind == "backend" { return _style_success(state); }
    if kind == "custom" or kind == "material" or kind == "prefab" { return _style_purple(state); }
    if kind == "webcomp" or kind == "camera" or kind == "physics" { return _style_info(state); }
    return _style_accent(state);
}

// x/width of action `idx` (cumulative — same math in draw + hit-test).

fn _action_bounds_for(idx, sz) {
    let x = _toolbar_action_start(sz);
    if _toolbar_rows(sz) > 1 { x = PAD; }
    let gap = _toolbar_gap(sz);
    let i = 0;
    while i < idx { x = x + _action_w(i) + gap; i = i + 1; }
    return map{ x: x, w: _action_w(idx) };
}

fn _action_bounds(idx) {
    return _action_bounds_for(idx, map{ w: 1280, h: 760 });
}

fn _action_w(idx) {
    let label = ACTIONS[idx].label;
    let id = ACTIONS[idx].id;
    if id == "mode" { label = "Release"; }
    if id == "watch" { label = "Watcher"; }
    if id == "style" { label = "Contrast"; }
    if id == "theme" { label = "Light"; }
    return (len(label) + 2) * CW;
}

fn _toolbar_gap(sz) {
    let gap = PAD;
    let ww = try sz.w catch 1280;
    if ww < 980 {
        gap = PAD / 2;
        if gap < 2 { gap = 2; }
    }
    return gap;
}

fn _actions_total_w_for(sz) {
    if len(ACTIONS) == 0 { return PAD; }
    let b = _action_bounds_for(len(ACTIONS) - 1, sz);
    return b.x + b.w + 2 * PAD;
}

fn _actions_total_w() {
    return _actions_total_w_for(map{ w: 1280, h: 760 });
}

fn _panel_label_full(idx) {
    return str(idx + 1) + " " + PANELS[idx].label;
}

fn _panel_label_compact(idx) {
    let id = PANELS[idx].id;
    let tag = str_slice(PANELS[idx].label, 0, 1);
    if id == "term" { tag = "T"; }
    if id == "ai" { tag = "A"; }
    if id == "design" { tag = "D"; }
    if id == "web" { tag = "B"; }
    if id == "files" { tag = "F"; }
    if id == "outline" { tag = "O"; }
    if id == "problems" { tag = "P"; }
    if id == "hist" { tag = "H"; }
    if id == "manage" { tag = "M"; }
    return str(idx + 1) + tag;
}

fn _panel_total_w_mode(compact) {
    let w = 0;
    let i = 0;
    while i < len(PANELS) {
        let label = _panel_label_full(i);
        if compact { label = _panel_label_compact(i); }
        w = w + (len(label) + 2) * CW + PAD;
        i = i + 1;
    }
    return w;
}

fn _panel_compact(sz) {
    if sz == nil { return false; }
    let action_space = _toolbar_brand_w(sz) + PAD + _actions_linear_w(sz) + 3 * PAD;
    if _toolbar_rows(sz) > 1 { action_space = 2 * PAD; }
    let avail = sz.w - action_space;
    if avail < 0 { avail = 0; }
    return _panel_total_w_mode(false) > avail;
}

fn _panel_total_w_for(sz) {
    return _panel_total_w_mode(_panel_compact(sz));
}

fn _panel_label_for(idx, sz) {
    if _panel_compact(sz) { return _panel_label_compact(idx); }
    return _panel_label_full(idx);
}

fn _panel_bounds(idx, sz) {
    let compact = _panel_compact(sz);
    let x = sz.w - PAD - _panel_total_w_for(sz);
    if x < PAD { x = PAD; }
    let i = 0;
    while i < idx {
        let prev = _panel_label_full(i);
        if compact { prev = _panel_label_compact(i); }
        x = x + (len(prev) + 2) * CW + PAD;
        i = i + 1;
    }
    let label = _panel_label_full(idx);
    if compact { label = _panel_label_compact(idx); }
    return map{ x: x, w: (len(label) + 2) * CW };
}

fn _toolbar_layout_sig(sz) {
    if sz == nil { return "nil"; }
    return str(try sz.w catch 0) + "x" + str(try sz.h catch 0) + "@" + str(SCALE) + ":" + str(CW) + ":" + str(CH);
}

fn _toolbar_layout(state, sz) {
    let sig = _toolbar_layout_sig(sz);
    let cached = try state.toolbar_layout catch nil;
    if cached != nil and (try cached.sig catch "") == sig { return cached; }
    _apply_toolbar_metrics(sz);
    let rows = _toolbar_rows(sz);
    let actionY = PAD;
    if rows > 1 { actionY = PAD + CH + 2 * PAD; }
    let panelY = PAD;
    let panelStart = sz.w - PAD - _panel_total_w_for(sz);
    if panelStart < PAD { panelStart = PAD; }
    let actions = [];
    let i = 0;
    while i < len(ACTIONS) {
        let b = _action_bounds_for(i, sz);
        let visible = rows > 1 or b.x + b.w + PAD < panelStart;
        array_push(actions, map{ id: ACTIONS[i].id, index: i, x: b.x, y: actionY, w: b.w, h: CH + PAD, visible: visible });
        i = i + 1;
    }
    let panels = [];
    i = 0;
    while i < len(PANELS) {
        let b = _panel_bounds(i, sz);
        array_push(panels, map{ id: PANELS[i].id, index: i, x: b.x, y: panelY, w: b.w, h: CH + PAD, label: _panel_label_for(i, sz) });
        i = i + 1;
    }
    let out = map{ format: "pbide.toolbar.layout.v1", sig: sig, rows: rows, panel_start: panelStart, action_y: actionY, panel_y: panelY, actions: actions, panels: panels };
    if state != nil { state.toolbar_layout = out; }
    return out;
}

fn _panel_by_index(state, idx) {
    if idx < 0 or idx >= len(PANELS) { return false; }
    let id = PANELS[idx].id;
    state.panel = id;
    if id == "files" { _files_refresh(state); }
    _ui_event(state, "panel " + id);
    state.output = "panel: " + str(PANELS[idx].label);
    return true;
}

fn _panel_digit_key(key) {
    if key == "1" or key == "Digit1" or key == "Key1" or key == "Num1" or key == "Numpad1" { return 1; }
    if key == "2" or key == "Digit2" or key == "Key2" or key == "Num2" or key == "Numpad2" { return 2; }
    if key == "3" or key == "Digit3" or key == "Key3" or key == "Num3" or key == "Numpad3" { return 3; }
    if key == "4" or key == "Digit4" or key == "Key4" or key == "Num4" or key == "Numpad4" { return 4; }
    if key == "5" or key == "Digit5" or key == "Key5" or key == "Num5" or key == "Numpad5" { return 5; }
    if key == "6" or key == "Digit6" or key == "Key6" or key == "Num6" or key == "Numpad6" { return 6; }
    if key == "7" or key == "Digit7" or key == "Key7" or key == "Num7" or key == "Numpad7" { return 7; }
    if key == "8" or key == "Digit8" or key == "Key8" or key == "Num8" or key == "Numpad8" { return 8; }
    if key == "9" or key == "Digit9" or key == "Key9" or key == "Num9" or key == "Numpad9" { return 9; }
    if key == "0" or key == "Digit0" or key == "Key0" or key == "Num0" or key == "Numpad0" { return 10; }
    return 0;
}

fn _panel_shortcut(state, key) {
    let n = _panel_digit_key(key);
    if n <= 0 { return false; }
    return _panel_by_index(state, n - 1);
}

fn _panel_index(id) {
    let i = 0;
    while i < len(PANELS) {
        if PANELS[i].id == id { return i; }
        i = i + 1;
    }
    return 0;
}

fn _panel_step(state, dir) {
    let idx = _panel_index(state.panel);
    let next = idx + dir;
    while next < 0 { next = next + len(PANELS); }
    while next >= len(PANELS) { next = next - len(PANELS); }
    return _panel_by_index(state, next);
}

fn _fallback_path() {
    let c = try cwd() catch ".";
    if c == nil { c = "."; }
    return c + "/.pbide_buffer.sapp";
}

fn _new_buffer_path() {
    let c = try cwd() catch ".";
    if c == nil { c = "."; }
    let base = c + "/untitled.sapp";
    if not (try fs_exists(base) catch false) { return base; }
    let i = 2;
    while i < 1000 {
        let p = c + "/untitled-" + str(i) + ".sapp";
        if not (try fs_exists(p) catch false) { return p; }
        i = i + 1;
    }
    return c + "/.pbide_untitled.sapp";
}

fn _new_buffer(state) {
    _file_tabs_sync_current(state);
    let p = _new_buffer_path();
    state.panel = "code";
    state.path = p;
    state.ed = E.new("");
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.syntax_status = "";
    state.last = "other";
    state.diagnostics = [];
    state.diag_index = 0 - 1;
    state.nav_back = [];
    state.nav_forward = [];
    state.find_mode = false;
    state.replace_mode = false;
    state.goto_line_mode = false;
    state.open_mode = false;
    state.quick_open_mode = false;
    state.examples_mode = false;
    state.project_root = "";
    state.project_files = [];
    state.example_run_path = "";
    state.example_app_kind = "";
    state.example_title = "";
    state.design = _design_blank(p);
    state.design_tabs = [];
    _design_tabs_reset_for_project(state);
    state.file_profile = IDE.editor_asset_profile(p);
    state.preview_path = "";
    state.preview_mode = str(try state.file_profile.preview catch "text");
    _file_tabs_add_current(state);
    state.watch = IDE.watcher_new(p, E.text(state.ed));
    _refresh_watcher(state, "new");
    state.output = "new buffer: " + p;
    return state.output;
}

// F5 — compile + run the buffer through the self-hosted pipeline and surface what
// the program PRINTED (one printed value per line, "> " prefixed). frontend_run now
// captures print output (vm.sapp), so this shows real results instead of a raw map.

fn _run(ed) {
    let r = try FE.frontend_run(E.text(ed)) catch nil;
    if r == nil { return "run: error — relaunch the IDE from the repo root (imports are CWD-relative)"; }
    if not r.ok { return "run: compile error — " + str(try r.error catch "see F6 check"); }
    let out = r.output;
    if len(out) == 0 { return "run: ok · (no output)"; }
    let s = "";
    let i = 0;
    while i < len(out) {
        if i > 0 { s = s + "
            "; }
        s = s + "> " + str(out[i]);
        i = i + 1;
    }
    return s;
}

fn _pblang_bin() {
    if try fs_exists("./target/debug/pblang") catch false { return "./target/debug/pblang"; }
    return "pblang";
}

fn _app_profile_for_state(state) {
    let p = IDE.app_run_profile(E.text(state.ed), try state.path catch "");
    let ex_kind = str(try state.example_app_kind catch "");
    if ex_kind != "" and (try p.kind catch "cli") == "cli" {
        p.kind = ex_kind;
        if ex_kind == "gui" {
            p.has_gui = true;
            p.can_native_run = true;
            p.run_method = "pblang-native-gui";
            p.preview_method = "designer/native GUI preview";
            if not str_contains(str_join(try p.requires catch [], "\n"), "display") {
                array_push(p.requires, "display and graphics backend");
            }
        } elif ex_kind == "web" {
            p.has_web = true;
            p.run_method = "preview-only-web-metadata";
        }
    }
    return p;
}

fn _app_launcher_source(source, profile) {
    let src = str(source);
    let low = str_lower(src);
    if (try profile.has_gui catch false) and str_contains(low, "fn run_gui(") and not str_contains(low, "\nrun_gui();") {
        src = src + "\n// pbide native app launcher\nrun_gui();\n";
    }
    return src;
}

fn _native_app_result_text(r, cmd, args) {
    if r == nil { return "native app run failed: process launch unavailable. Relaunch PBIDE with --allow-exec or --allow-all."; }
    let out = "native app command: " + cmd + " " + str_join(args, " ") + "\nexit: " + str(try r.exit_code catch "?");
    let so = str(try r.stdout catch "");
    let se = str(try r.stderr catch "");
    if str_trim(so) != "" { out = out + "\nstdout:\n" + so; }
    if str_trim(se) != "" { out = out + "\nstderr:\n" + se; }
    if str_trim(so) == "" and str_trim(se) == "" { out = out + "\n(no process output; GUI apps usually show their result in the window)"; }
    return out;
}

fn _pbide_app_limit_ms() {
    let raw = try env_get("PBIDE_APP_MAX_MS") catch "";
    let n = try parse_number(str(raw)) catch 120000;
    if n == nil or n <= 0 { n = 120000; }
    if n < 5000 { n = 5000; }
    if n > 3600000 { n = 3600000; }
    return num_floor(n);
}

fn _pbide_temp_dir() {
    let d = try env_get("TMPDIR") catch "";
    if d == nil or str(d) == "" { d = try env_get("TEMP") catch ""; }
    if d == nil or str(d) == "" { d = try env_get("TMP") catch ""; }
    if d == nil or str(d) == "" { d = "/tmp"; }
    return str(d);
}

fn _pbide_log_path(tag) {
    return _pbide_temp_dir() + "/pbide_" + str(tag) + "_" + str(try now_ms() catch 0) + ".log";
}

fn _psq(s) {
    return "'" + str_replace_all(str(s), "'", "''") + "'";
}

fn _ps_args(args) {
    let parts = [];
    let i = 0;
    while i < len(args) {
        array_push(parts, _psq(args[i]));
        i = i + 1;
    }
    return "@(" + str_join(parts, ",") + ")";
}

fn _argv_shell(args) {
    let out = "";
    let i = 0;
    while i < len(args) {
        out = out + " " + _shq(args[i]);
        i = i + 1;
    }
    return out;
}

fn _detached_native_app_result(r, cmd, args, log_path, err_path, limit_ms) {
    if r == nil { return "native app launch blocked: process launch unavailable. Relaunch PBIDE with --allow-exec or --allow-all."; }
    let out = "native app launched detached and guarded\n" +
    "command: " + cmd + " " + str_join(args, " ") + "\n" +
    "max runtime: " + str(limit_ms) + "ms\n" +
    "stdout log: " + log_path;
    if err_path != "" { out = out + "\nstderr log: " + err_path; }
    let so = str_trim(str(try r.stdout catch ""));
    let se = str_trim(str(try r.stderr catch ""));
    if so != "" { out = out + "\nlauncher stdout: " + so; }
    if se != "" { out = out + "\nlauncher stderr: " + se; }
    if (try r.exit_code catch 0) != 0 {
        out = out + "\nlauncher exit: " + str(try r.exit_code catch "?");
    }
    out = out + "\nPBIDE stays interactive; close the child app normally or wait for the guard.";
    return out;
}

fn _run_detached_native_app(cmd, args, profile) {
    let limit_ms = _pbide_app_limit_ms();
    let safety = try IDE.app_run_safety_profile(profile, map{ timeout_ms: limit_ms }) catch map{ timeout_ms: limit_ms, max_frames: num_floor(limit_ms / 16), target_fps: 30 };
    limit_ms = try safety.timeout_ms catch limit_ms;
    let max_frames = try safety.max_frames catch num_floor(limit_ms / 16);
    if max_frames < 60 { max_frames = 60; }
    let target_fps = try safety.target_fps catch 30;
    let cap_env = _native_app_cap_env(profile);
    let child_caps = _native_app_env_value(cap_env, "PBIDE_CHILD_CAPS", "least-privilege");
    let allow_all = _native_app_env_value(cap_env, "PBLANG_ALLOW_ALL", "0");
    let allow_exec = _native_app_env_value(cap_env, "PBLANG_ALLOW_EXEC", "0");
    let allow_ffi = _native_app_env_value(cap_env, "PBLANG_ALLOW_FFI", "0");
    let log_path = _pbide_log_path("app");
    let os = try platform() catch "unknown";
    if os == "windows" {
        let err_path = log_path + ".err";
        let cwd0 = try cwd() catch ".";
        let ps = "$env:PBIDE_CHILD_APP='1'; " +
        "$env:PBIDE_CHILD_CAPS=" + _psq(child_caps) + "; " +
        "$env:PBLANG_ALLOW_ALL=" + _psq(allow_all) + "; " +
        "$env:PBLANG_ALLOW_EXEC=" + _psq(allow_exec) + "; " +
        "$env:PBLANG_ALLOW_FFI=" + _psq(allow_ffi) + "; " +
        "$env:PBLANG_GRAPHICS_MAX_MS=" + _psq(str(limit_ms)) + "; " +
        "$env:PBLANG_GRAPHICS_MAX_FRAMES=" + _psq(str(max_frames)) + "; " +
        "$env:PBLANG_GRAPHICS_TARGET_FPS=" + _psq(str(target_fps)) + "; " +
        "Start-Process -FilePath " + _psq(cmd) +
        " -ArgumentList " + _ps_args(args) +
        " -WorkingDirectory " + _psq(cwd0) +
        " -RedirectStandardOutput " + _psq(log_path) +
        " -RedirectStandardError " + _psq(err_path) +
        "; Write-Output 'started'";
        let r = try proc_spawn_wait("powershell", ["-NoProfile", "-Command", ps]) catch nil;
        return IDE.app_run_profile_summary(profile) + "\n" + _detached_native_app_result(r, cmd, args, log_path, err_path, limit_ms);
    }
    let cwd0 = try cwd() catch ".";
    let limit_s = num_floor(limit_ms / 1000);
    if limit_s < 1 { limit_s = 1; }
    let envp = "env PBIDE_CHILD_APP=1 PBIDE_CHILD_CAPS=" + _shq(child_caps) +
    " PBLANG_ALLOW_ALL=" + _shq(allow_all) +
    " PBLANG_ALLOW_EXEC=" + _shq(allow_exec) +
    " PBLANG_ALLOW_FFI=" + _shq(allow_ffi) +
    " PBLANG_GRAPHICS_MAX_MS=" + str(limit_ms) +
    " PBLANG_GRAPHICS_MAX_FRAMES=" + str(max_frames) +
    " PBLANG_GRAPHICS_TARGET_FPS=" + str(target_fps);
    let run_cmd = envp + " " + _shq(cmd) + _argv_shell(args);
    let guarded = "if command -v timeout >/dev/null 2>&1; then timeout -k 2s " + str(limit_s) + "s " + run_cmd + "; else " + run_cmd + "; fi";
    let script = "cd " + _shq(cwd0) + " 2>/dev/null || exit 1; (" + guarded + ") > " + _shq(log_path) + " 2>&1 < /dev/null & echo $!";
    let r = try proc_spawn_wait("bash", ["-lc", script]) catch nil;
    return IDE.app_run_profile_summary(profile) + "\n" + _detached_native_app_result(r, cmd, args, log_path, "", limit_ms);
}

fn _native_app_cap_env(profile) {
    let plan = try IDE.app_run_capability_plan(profile) catch map{ env_overrides: map{} };
    return try plan.env_overrides catch map{};
}

fn _native_app_env_value(env, key, fallback) {
    return str(try env[str(key)] catch fallback);
}

fn _native_app_cap_args(profile) {
    let plan = try IDE.app_run_capability_plan(profile) catch map{ cli_args: [] };
    return try plan.cli_args catch [];
}

fn _native_app_run_args(path, profile) {
    let args = ["run", str(path)];
    let caps = _native_app_cap_args(profile);
    let i = 0;
    while i < len(caps) {
        array_push(args, caps[i]);
        i = i + 1;
    }
    return args;
}

fn _run_native_app_source(state, profile) {
    let run_path = str(try state.example_run_path catch "");
    let cmd = _pblang_bin();
    let args = [];
    if run_path != "" {
        args = _native_app_run_args(run_path, profile);
    } else {
        let tmp = "/tmp/pbide_app_" + str(try now_ms() catch 0) + ".sapp";
        let src = _app_launcher_source(E.text(state.ed), profile);
        let ok = try fs_write(tmp, src) catch false;
        if ok == false or ok == nil { return "native app run failed: could not write temp launcher " + tmp; }
        args = _native_app_run_args(tmp, profile);
    }
    if (try profile.has_gui catch false) or (try profile.has_web_runtime catch false) or str(try profile.kind catch "") == "web" {
        return _run_detached_native_app(cmd, args, profile);
    }
    let r = try proc_spawn_wait(cmd, args) catch nil;
    return IDE.app_run_profile_summary(profile) + "\n" + _native_app_result_text(r, cmd, args);
}
// F6 — static lint via the self-hosted analyzer: undefined names, unreachable code,
// undeclared assignment. Lists up to 6 problems, one per line.

fn _check_result(ed) {
    let r = try FE.frontend_lint(E.text(ed)) catch nil;
    return r;
}

fn _check_text(r) {
    if r == nil { return "check: error — relaunch the IDE from the repo root (imports are CWD-relative)"; }
    if r.count == 0 { return "check: OK — no problems found"; }
    let s = "check: " + str(r.count) + " problem(s)";
    let i = 0;
    while i < len(r.diagnostics) and i < 6 {
        let d = r.diagnostics[i];
        s = s + "
        " + str(try d.kind catch "?") + ": " + str(try d.message catch "?");
        i = i + 1;
    }
    return s;
}

fn _check(ed) { return _check_text(_check_result(ed)); }

fn _save(state) {
    let effect_block = _effect_block("save");
    if effect_block != nil { return effect_block; }
    let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
    if try profile.binary catch false {
        let plan = IDE.asset_action_plan("save", profile, str(try state.path catch ""));
        return "save blocked: " + str(try state.path catch "") + " is a binary document/media preview.\n" +
        str(try plan.reason catch IDE.asset_backend_summary(profile)) + "\n" +
        "required: " + str_join(try plan.requires catch [], ", ");
    }
    let ok = try fs_write(state.path, E.text(state.ed)) catch nil;
    if ok == nil {
        let fb = _fallback_path();
        let ok2 = try fs_write(fb, E.text(state.ed)) catch nil;
        if ok2 == nil { return "save FAILED: " + state.path + " and " + fb; }
        state.path = fb;
        state.dirty = false;
        state.file_profile = IDE.editor_asset_profile(fb);
        state.preview_path = "";
        state.preview_mode = str(try state.file_profile.preview catch "text");
        _file_tabs_add_current(state);
        _refresh_watcher(state, "save");
        return "saved fallback " + fb;
    }
    state.dirty = false;
    _file_tabs_add_current(state);
    _refresh_watcher(state, "save");
    return "saved " + state.path;
}

fn _save_as_path(state, path) {
    let effect_block = _effect_block("save");
    if effect_block != nil { return effect_block; }
    let p = str_trim(str(path));
    if p == "" { return "save as cancelled: empty path"; }
    let ok = try fs_write(p, E.text(state.ed)) catch nil;
    if ok == nil { return "save as FAILED: " + p; }
    if p != str(try state.path catch "") {
        state.nav_back = [];
        state.nav_forward = [];
    }
    state.path = p;
    state.dirty = false;
    state.panel = "code";
    state.recent_files = IDE.recent_files_push(try state.recent_files catch [], p, 40);
    state.file_profile = IDE.editor_asset_profile(p);
    state.preview_path = "";
    state.preview_mode = str(try state.file_profile.preview catch "text");
    _file_tabs_add_current(state);
    _refresh_watcher(state, "save-as");
    return "saved as " + p;
}

fn _open_save_as(state) {
    state.panel = "code";
    state.save_as_mode = true;
    state.save_as_path = str(try state.path catch _new_buffer_path());
    state.output = "save as: edit path, Enter=save, Esc=cancel";
    return state.output;
}

fn _revert_buffer(state) {
    let effect_block = _effect_block("open");
    if effect_block != nil { return effect_block; }
    let p = str(try state.path catch "");
    if str_trim(p) == "" { return "revert FAILED: no current path"; }
    let raw = try fs_read(p) catch nil;
    if raw == nil { return "revert FAILED: cannot read " + p; }
    _replace_editor(state, raw);
    state.dirty = false;
    state.panel = "code";
    state.diagnostics = [];
    state.diag_index = 0 - 1;
    state.nav_back = [];
    state.nav_forward = [];
    state.find_mode = false;
    state.replace_mode = false;
    state.goto_line_mode = false;
    state.open_mode = false;
    state.save_as_mode = false;
    state.quick_open_mode = false;
    state.examples_mode = false;
    _refresh_watcher(state, "revert");
    state.output = "reverted from disk: " + p;
    return state.output;
}

fn _profile_preview_text(profile, text, mode) {
    let lines = IDE.preview_lines_for_asset(profile, text, mode, 18);
    return str_join(lines, "\n");
}

fn _preview_current_app(state) {
    let profile = _app_profile_for_state(state);
    let run_path = str(try state.example_run_path catch "");
    let design_active = (try state.panel catch "") == "design" and len(try state.design.widgets catch []) > 0;
    if (try profile.kind catch "cli") == "cli" and run_path == "" and not design_active {
        return nil;
    }
    let lines = [IDE.app_run_profile_summary(profile)];
    if run_path != "" {
        array_push(lines, "Run path: " + run_path);
    }
    if len(try state.design.widgets catch []) > 0 {
        state.panel = "design";
        array_push(lines, "Designer form: " + str(len(state.design.widgets)) + " item(s), target=" + str(try state.design.target catch "gui"));
        array_push(lines, "Preview mode: live Designer canvas. Press Run to launch the native GUI app.");
    } else {
        state.panel = "code";
    }
    if try profile.has_preview catch false {
        let effect_block = _effect_block("run");
        if effect_block != nil {
            array_push(lines, effect_block);
            state.output = str_join(lines, "\n");
            return state.output;
        }
        let headless = _run(state.ed);
        array_push(lines, "Headless preview output:");
        array_push(lines, headless);
    } elif (try profile.has_web_runtime catch false) {
        array_push(lines, "Web preview: Press Run to start the guarded detached pblang web process.");
    } elif (try profile.can_native_run catch false) {
        array_push(lines, "Native preview: Press Run to open the guarded detached app window.");
    }
    state.output = str_join(lines, "\n");
    return state.output;
}

fn _preview_current_file(state) {
    let app = _preview_current_app(state);
    if app != nil { return app; }
    let profile = IDE.editor_asset_profile(try state.path catch "");
    let current = str(try state.preview_mode catch "");
    if str(try state.preview_path catch "") == str(try state.path catch "") and current != "" {
        current = IDE.preview_mode_next(current, profile);
    } else {
        current = str(try profile.preview catch "text");
    }
    state.file_profile = profile;
    state.preview_path = str(try state.path catch "");
    state.preview_mode = current;
    state.panel = "code";
    state.output = _profile_preview_text(profile, E.text(state.ed), current);
    return state.output;
}

fn _open_binary_asset_preview(state, path, target, profile) {
    _file_tabs_sync_current(state);
    if path != str(try state.path catch "") {
        state.nav_back = [];
        state.nav_forward = [];
    }
    state.path = path;
    state.file_profile = profile;
    state.preview_path = "";
    state.preview_mode = str(try profile.preview catch "metadata");
    state.dirty = false;
    state.panel = "code";
    state.recent_files = IDE.recent_files_push(try state.recent_files catch [], path, 40);
    let previewText = _profile_preview_text(profile, "", state.preview_mode);
    _replace_editor(state, previewText);
    state.dirty = false;
    state.project_root = "";
    state.project_files = [path];
    state.design = _design_blank(path);
    state.design_tabs = [];
    _design_tabs_reset_for_project(state);
    _file_tabs_add_current(state);
    _refresh_watcher(state, "open-preview");
    let opened = "opened preview " + IDE.open_path_target_status(target);
    state.output = opened + "\n" + previewText;
    return state.output;
}

fn _open_path(state, path) {
    let effect_block = _effect_block("open");
    if effect_block != nil { return effect_block; }
    _file_tabs_sync_current(state);
    let target = IDE.open_path_target(path);
    let p = str_trim(str(try target.path catch path));
    if p == "" { p = state.path; }
    let profile = IDE.editor_asset_profile(p);
    if try profile.binary catch false {
        return _open_binary_asset_preview(state, p, target, profile);
    }
    let raw = try fs_read(p) catch nil;
    if raw == nil { return "open FAILED: cannot read " + p; }
    _replace_editor(state, raw);
    if try target.has_line catch false {
        let lineTarget = IDE.goto_line_target(str(try target.line catch 1), E.line_count(state.ed));
        let col = try target.col catch 1;
        if col == nil or col < 1 { col = 1; }
        col = num_floor(col) - 1;
        E.set_cursor(state.ed, lineTarget.row, col);
    }
    if p != str(try state.path catch "") {
        state.nav_back = [];
        state.nav_forward = [];
    }
    state.path = p;
    state.file_profile = profile;
    state.preview_path = "";
    state.preview_mode = str(try profile.preview catch "text");
    state.dirty = false;
    state.panel = "code";
    state.project_root = "";
    state.project_files = [p];
    state.design = _design_blank(p);
    state.design_tabs = [];
    _design_tabs_reset_for_project(state);
    state.recent_files = IDE.recent_files_push(try state.recent_files catch [], p, 40);
    _file_tabs_add_current(state);
    _refresh_watcher(state, "open");
    let opened = "opened " + IDE.open_path_target_status(target);
    if str(try profile.family catch "code") != "code" {
        state.output = opened + "\n" + _profile_preview_text(profile, raw, state.preview_mode);
        return state.output;
    }
    return opened;
}

fn _refresh_watcher(state, event) {
    if not (try state.watch_enabled catch true) { return 0; }
    state.watch = IDE.watcher_update(state.watch, state.path, E.text(state.ed), state.dirty, state.diagnostics, event);
    let snap = try state.ui_snapshot catch nil;
    if snap != nil {
        state.watch.ui_snapshot = snap;
        state.watch.ui_lines = UIO.snapshot_lines(snap, 4);
    }
    return 0;
}

fn _refresh_watcher_draw(state) {
    let now = try now_ms() catch 0;
    let last = try state.watch_draw_last_ms catch 0;
    if now > 0 and last > 0 and now - last < 1000 { return 0; }
    state.watch_draw_last_ms = now;
    _refresh_watcher(state, "draw");
    return 0;
}

fn _modal_region_name(state) {
    if state.help { return "help"; }
    if try state.command_mode catch false { return "command-palette"; }
    if try state.quick_open_mode catch false { return "quick-open"; }
    if try state.goto_line_mode catch false { return "go-to-line"; }
    if try state.examples_mode catch false { return "examples"; }
    if try state.save_as_mode catch false { return "save-as"; }
    if try state.open_mode catch false { return "open-path"; }
    return "";
}

fn _ui_event(state, text) {
    let old = try state.ui_events catch [];
    let next = [str(text)];
    let i = 0;
    while old != nil and i < len(old) and len(next) < 8 {
        if str(old[i]) != str(text) { array_push(next, old[i]); }
        i = i + 1;
    }
    state.ui_events = next;
    return 0;
}

fn _ui_action_ids(items, prefix) {
    let out = [];
    let i = 0;
    while items != nil and i < len(items) {
        let id = str(try items[i].id catch "");
        if id != "" { array_push(out, prefix + id); }
        i = i + 1;
    }
    return out;
}

fn _ui_action_records(items, prefix) {
    let out = [];
    let i = 0;
    while items != nil and i < len(items) {
        let id = str(try items[i].id catch "");
        if id != "" {
            array_push(out, map{
                id: prefix + id,
                label: str(try items[i].label catch id),
                visible: true
            });
        }
        i = i + 1;
    }
    return out;
}

fn _ui_regions(state, sz) {
    let toolbarText = "pbIDE " + str(state.panel) + " Run Check Format Fix Examples Save Open Preview Mode Watch Style Theme";
    let statusText = _code_status_line(state);
    let modal = _modal_region_name(state);
    let mainFocused = modal == "";
    let regions = [
    UIO.region("toolbar", 0, 0, sz.w, TBH, "toolbar", map{
        panel: state.panel,
        actions: _ui_action_records(ACTIONS, ""),
        panel_actions: _ui_action_records(PANELS, "panel_"),
        text: toolbarText,
        char_w: CW,
        pad: PAD * 2,
        min_action_w: CW * 7,
        visible: true,
        visibility_required: true
    }),
    UIO.region("status", 0, sz.h - STATUSH, sz.w, STATUSH, "statusbar", map{
        watch: _watch_badge(state),
        text: statusText,
        char_w: CW,
        pad: PAD * 2,
        visible: true,
        visibility_required: true
    })
    ];
    let bodyH = sz.h - TOP - STATUSH;
    if bodyH < 1 { bodyH = 1; }
    if state.panel == "code" {
        let outw = _code_output_w_state(state, sz);
        let splitw = SCALE * 3;
        let editorW = sz.w - outw - splitw;
        if editorW < GUTTERX + 4 * CW { editorW = GUTTERX + 4 * CW; }
        array_push(regions, UIO.region("code-editor", 0, TOP, editorW, bodyH, "editor", map{
            file: state.path,
            dirty: state.dirty,
            line: state.ed.row + 1,
            col: state.ed.col + 1,
            focused: mainFocused,
            focus_required: mainFocused,
            visible: true,
            visibility_required: true
        }));
        array_push(regions, UIO.region("code-sidepane", editorW + splitw, TOP, outw, bodyH, "sidepane", map{
            diagnostics: len(try state.diagnostics catch []),
            watcher: _watch_badge(state),
            visible: true,
            visibility_required: true
        }));
    } else {
        array_push(regions, UIO.region("panel-" + str(state.panel), 0, TOP, sz.w, bodyH, "panel", map{
            panel: state.panel,
            focused: mainFocused,
            focus_required: mainFocused,
            visible: true,
            visibility_required: true
        }));
    }
    if modal != "" {
        array_push(regions, UIO.region("modal-" + modal, PAD * 2, TOP + PAD * 2, sz.w - PAD * 4, bodyH - PAD * 4, "modal", map{
            overlay: true,
            name: modal,
            focused: true,
            focus_required: true,
            visible: true,
            visibility_required: true
        }));
    }
    return regions;
}

fn _ui_required_regions(state) {
    let out = ["toolbar", "status"];
    if state.panel == "code" {
        array_push(out, "code-editor");
        array_push(out, "code-sidepane");
    } else {
        array_push(out, "panel-" + str(state.panel));
    }
    return out;
}

fn _ui_required_actions(state) {
    let out = _ui_action_ids(ACTIONS, "");
    let panels = _ui_action_ids(PANELS, "panel_");
    let i = 0;
    while i < len(panels) {
        array_push(out, panels[i]);
        i = i + 1;
    }
    return out;
}

fn _ui_snapshot(state, sz) {
    let signals = [
    "panel=" + str(state.panel),
    "style=" + str(try state.style catch "web"),
    "theme=" + _theme_name(state),
    "dirty=" + str(try state.dirty catch false),
    "watch=" + _watch_badge(state),
    "build=" + str(try state.build_mode catch "debug")
    ];
    let events = try state.ui_events catch [];
    let i = 0;
    while events != nil and i < len(events) and i < 4 {
        array_push(signals, "event=" + str(events[i]));
        i = i + 1;
    }
    return UIO.surface_snapshot_contract("pbide", "pblang native IDE", sz, state.panel, _ui_regions(state, sz), signals, _ui_required_regions(state), _ui_required_actions(state));
}

fn _ui_snapshot_sig(state, sz) {
    let modal = _modal_region_name(state);
    return str(state.panel) + "|" +
    str(try sz.w catch 0) + "x" + str(try sz.h catch 0) + "|" +
    str(try state.theme catch "") + "|" +
    str(try state.style catch "") + "|" +
    str(try state.density_scale catch 0) + "|" +
    str(modal) + "|" +
    str(try state.dirty catch false) + "|" +
    str(_watch_badge(state)) + "|" +
    str(try state.build_mode catch "debug") + "|" +
    str(try state.hover_tab catch "") + "|" +
    str(try state.event_count catch 0);
}

fn _ui_snapshot_cached(state, sz) {
    let sig = _ui_snapshot_sig(state, sz);
    let snap = try state.ui_snapshot catch nil;
    if snap != nil and (try state.ui_snapshot_sig catch "") == sig {
        return snap;
    }
    let fresh = _ui_snapshot(state, sz);
    state.ui_snapshot = fresh;
    state.ui_snapshot_sig = sig;
    return fresh;
}

fn _ui_snapshot_report(state, limit) {
    let sz = try state.winsz catch map{ w: 0, h: 0 };
    let snap = _ui_snapshot_cached(state, sz);
    return str_join(UIO.snapshot_lines(snap, limit), "\n");
}

fn _show_ui_snapshot(state) {
    _ui_event(state, "ui snapshot report");
    let sz = try state.winsz catch map{ w: 0, h: 0 };
    let snap = _ui_snapshot_cached(state, sz);
    state.panel = "code";
    state.output = str_join(UIO.snapshot_lines(snap, 12), "\n");
    return 0;
}

fn _watch_summary(state) {
    if not (try state.watch_enabled catch true) { return "watch: off"; }
    return IDE.watcher_summary(state.watch);
}

fn _watch_badge(state) {
    if not (try state.watch_enabled catch true) { return "watch off"; }
    return IDE.watcher_badge(state.watch);
}

fn _toolchain_lines() {
    return [
    "frontend: pblang self-hosted compiler",
    "run/check: stdlib/compiler/selfhost_frontend.sapp",
    "native kernel: Rust VM executes chunks/.pbck fallback"
    ];
}

fn _code_status_line(state) {
    let ed = state.ed;
    let code = E.text(ed);
    let selected = 0;
    if E.has_selection(ed) { selected = len(E.selection_text(ed)); }
    let watch = nil;
    if try state.watch_enabled catch true { watch = state.watch; }
    let base = IDE.status_text(map{
        path: state.path,
        modified: state.dirty,
        line: ed.row + 1,
        col: ed.col + 1,
        lines: E.line_count(ed),
        chars: len(code),
        diagnostics: len(try state.diagnostics catch []),
        selection_chars: selected,
        lang: "pblang"
    });
    let lineDiag = IDE.diagnostic_line_status(try state.diagnostics catch [], ed.row + 1);
    let lineDiagText = "";
    if lineDiag != "" { lineDiagText = "  |  " + lineDiag; }
    let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
    let mode = try state.preview_mode catch "";
    if mode == "" { mode = try profile.preview catch "text"; }
    let asset = str(try profile.editor catch "text") + "/" + str(try profile.family catch "text") + ":" + str(mode);
    return base
    + "  |  asset " + asset
    + "  |  " + IDE.ide_health_line(watch, try state.build_mode catch "debug", try state.ui_snapshot catch nil)
    + "  |  scope " + str(try IDE.current_symbol(code, ed.row + 1).label catch "top-level")
    + lineDiagText
    + "  |  sym " + str(len(IDE.outline(code)))
    + "  |  tabs " + str(len(try state.file_tabs catch []))
    + " files " + str(len(try state.project_files catch []))
    + "  |  nav " + str(len(try state.nav_back catch [])) + "/" + str(len(try state.nav_forward catch []))
    + "  |  self-host"
    + "  |  F5 Run  F6 Check  F11 Mode  F12 Watch";
}

fn _watch_toolbar_label(state) {
    return IDE.watcher_toolbar_label(state.watch, try state.watch_enabled catch true);
}

fn _mode_label(state) {
    let p = IDE.build_profile(try state.build_mode catch "debug");
    return p.label;
}

fn _mode_toggle(state) {
    state.build_mode = IDE.next_build_mode(try state.build_mode catch "debug");
    state.output = IDE.build_mode_summary(state.build_mode);
    return 0;
}

fn _watch_toggle(state) {
    state.watch_enabled = not (try state.watch_enabled catch true);
    _refresh_watcher(state, "toggle");
    state.output = _watch_summary(state);
    return 0;
}

fn _watch_action(state) {
    if not (try state.watch_enabled catch true) {
        state.output = "watcher off - press F12 Watch";
        return state.output;
    }
    let action = IDE.watcher_action(state.watch);
    let cmd = str(try action.command catch "none");
    if cmd == "check" {
        return _check_action(state);
    }
    if cmd == "diagnostic_next" {
        _diagnostic_goto(state, 1);
        return state.output;
    }
    if cmd == "save" {
        state.output = _save(state);
        return state.output;
    }
    if cmd == "ui_snapshot" {
        _show_ui_snapshot(state);
        return state.output;
    }
    state.output = str(try action.message catch _watch_summary(state));
    return state.output;
}

fn _duplicate_line_action(state) {
    E.snapshot(state.ed);
    E.duplicate_line(state.ed);
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.output = "duplicated current line";
    return state.output;
}

fn _delete_line_action(state) {
    E.snapshot(state.ed);
    E.delete_line(state.ed);
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.output = "deleted current line";
    return state.output;
}

fn _move_line_action(state, dir) {
    let ed = state.ed;
    if dir < 0 and ed.row <= 0 {
        state.output = "line already at top";
        return state.output;
    }
    if dir > 0 and ed.row >= len(ed.lines) - 1 {
        state.output = "line already at bottom";
        return state.output;
    }
    E.snapshot(state.ed);
    let moved = false;
    if dir < 0 { moved = E.move_line_up(state.ed); }
    else { moved = E.move_line_down(state.ed); }
    if not moved {
        if dir < 0 { state.output = "line already at top"; }
        else { state.output = "line already at bottom"; }
        return state.output;
    }
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    if dir < 0 { state.output = "moved current line up"; }
    else { state.output = "moved current line down"; }
    return state.output;
}

fn _toggle_line_comment_action(state) {
    E.snapshot(state.ed);
    let r = E.toggle_line_comment(state.ed, "//");
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    if try r.commented catch false { state.output = "commented " + str(try r.lines catch 1) + " line(s)"; }
    else { state.output = "uncommented " + str(try r.lines catch 1) + " line(s)"; }
    return state.output;
}

fn _indent_lines_action(state) {
    E.snapshot(state.ed);
    let r = E.indent_lines(state.ed, "    ");
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.output = "indented " + str(try r.lines catch 1) + " line(s)";
    return state.output;
}

fn _outdent_lines_action(state) {
    E.snapshot(state.ed);
    let r = E.outdent_lines(state.ed, "    ");
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.output = "outdented " + str(try r.changed catch 0) + "/" + str(try r.lines catch 1) + " line(s)";
    return state.output;
}

fn _trim_trailing_ws_action(state) {
    E.snapshot(state.ed);
    let r = E.trim_trailing_whitespace(state.ed);
    let changed = try r.lines catch 0;
    if changed == 0 {
        E.undo(state.ed);
        state.output = "trim whitespace: already clean";
        return state.output;
    }
    state.last = "other";
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.output = "trimmed trailing whitespace on " + str(changed) + " line(s), removed " + str(try r.removed catch 0) + " char(s)";
    return state.output;
}

// Enter/Return is named differently per backend: minifb → "Enter"/"NumPadEnter",
// SDL2 → "Return". Accept all so Enter works everywhere (editor newline, terminal/AI
// submit, find-next). This was the "Enter broken on all tabs" bug.

fn _is_enter(key) { return key == "Return" or key == "Enter" or key == "NumPadEnter"; }

fn _moveN(ed, dir, n) {
    let i = 0;
    while i < n { if dir == "up" { E.move_up(ed); } else { E.move_down(ed); } i = i + 1; }
    return 0;
}
// _move(ed, key, shift, rows, fast). `fast` (Ctrl held) jumps by word horizontally and
// by 5 lines / to document edges vertically — VS Code-style accelerated movement.

fn _move(ed, key, shift, rows, fast) {
    if shift { if ed.anchor == nil { E.set_anchor(ed); } } else { E.clear_selection(ed); }
    if key == "Left" { if fast { E.move_word_left(ed); } else { E.move_left(ed); } }
    if key == "Right" { if fast { E.move_word_right(ed); } else { E.move_right(ed); } }
    if key == "Up" { if fast { _moveN(ed, "up", 5); } else { E.move_up(ed); } }
    if key == "Down" { if fast { _moveN(ed, "down", 5); } else { E.move_down(ed); } }
    if key == "Home" { if fast { ed.row = 0; } E.home(ed); }
    if key == "End" { if fast { ed.row = len(ed.lines) - 1; } E.end(ed); }
    if key == "PageUp" { E.page_up(ed, rows); }
    if key == "PageDown" { E.page_down(ed, rows); }
}

fn _is_move(key) {
    return key == "Left" or key == "Right" or key == "Up" or key == "Down"
    or key == "Home" or key == "End" or key == "PageUp" or key == "PageDown";
}

fn _is_sym_token_char(c) {
    if c == 92 { return true; }                     // backslash
    if c >= 48 and c <= 57 { return true; }
    if c >= 65 and c <= 90 { return true; }
    if c >= 97 and c <= 122 { return true; }
    return c == 95;                                 // underscore
}

fn _compose_symbol_at_cursor(state) {
    let ed = state.ed;
    if ed.row < 0 or ed.row >= len(ed.lines) { return false; }
    let line = ed.lines[ed.row];
    if ed.col <= 0 or ed.col > len(line) { return false; }
    let start = ed.col - 1;
    while start >= 0 and _is_sym_token_char(strcharcodeat(line, start)) { start = start - 1; }
    start = start + 1;
    if start >= ed.col { return false; }
    let token = str_slice(line, start, ed.col);
    if not str_starts_with(token, "\\") { return false; }
    let repl = MSYM.expand_shortcut(token);
    if repl == nil { return false; }
    let n = len(token);
    while n > 0 { E.backspace(ed); n = n - 1; }
    E.insert_text(ed, repl);
    state.last = "other";
    state.dirty = true;
    return true;
}

fn _pair_close(ch) {
    if ch == "(" { return ")"; }
    if ch == "[" { return "]"; }
    if ch == "{" { return "}"; }
    if ch == "\"" { return "\""; }
    if ch == "'" { return "'"; }
    return "";
}

fn _is_pair_close(ch) {
    return ch == ")" or ch == "]" or ch == "}" or ch == "\"" or ch == "'";
}

fn _next_char(ed) {
    if ed.row < 0 or ed.row >= len(ed.lines) { return ""; }
    let line = ed.lines[ed.row];
    if ed.col < 0 or ed.col >= len(line) { return ""; }
    return str_slice(line, ed.col, ed.col + 1);
}

fn _insert_code_char(state, ch) {
    let ed = state.ed;
    let close = _pair_close(ch);
    if close != "" {
        E.insert_text(ed, ch + close);
        E.move_left(ed);
        return true;
    }
    if _is_pair_close(ch) and _next_char(ed) == ch {
        E.move_right(ed);
        return true;
    }
    E.insert_char(ed, ch);
    return true;
}

// status line for the find / find&replace overlay.

fn _find_status(state) {
    let ed = state.ed;
    let line = ed.row + 1;
    let col = ed.col + 1;
    if E.has_selection(ed) {
        let r = E.selection_range(ed);
        line = r.start.row + 1;
        col = r.start.col + 1;
    }
    let base = IDE.find_status(E.text(ed), try state.query catch "",
    try state.replace_mode catch false,
    try state.replace_focus catch "find",
    try state.replace_text catch "");
    if str_trim(try state.query catch "") == "" { return base; }
    return base + "  " + IDE.find_position_status(E.text(ed), try state.query catch "", line, col);
}

fn _open_find(state) {
    state.panel = "code";
    state.find_mode = true;
    state.replace_mode = false;
    state.query = "";
    state.replace_focus = "find";
    return _find_status(state);
}

fn _open_replace(state) {
    state.panel = "code";
    state.find_mode = true;
    state.replace_mode = true;
    state.query = "";
    state.replace_text = "";
    state.replace_focus = "find";
    return "REPLACE: type find, Tab to replace field, Enter=replace-all, Esc=close";
}

// handle a keydown; returns a status string ("" keeps the current one).

fn _key(state, key) {
    let ed = state.ed;
    if try state.save_as_mode catch false {
        if _is_enter(key) {
            state.save_as_mode = false;
            let p = state.save_as_path;
            state.save_as_path = "";
            return _save_as_path(state, p);
        }
        if key == "Escape" { state.save_as_mode = false; state.save_as_path = ""; return "save as cancelled"; }
        if key == "Backspace" {
            if len(state.save_as_path) > 0 { state.save_as_path = str_slice(state.save_as_path, 0, len(state.save_as_path) - 1); }
            return "save as: " + state.save_as_path;
        }
        if state.ctrl and key == "V" {
            state.save_as_path = state.save_as_path + state.ed.clipboard;
            return "save as: " + state.save_as_path;
        }
        let chs = K.key_to_char(key, state.shift);
        if chs != "" { state.save_as_path = state.save_as_path + chs; return "save as: " + state.save_as_path; }
        return "";
    }
    if try state.open_mode catch false {
        if _is_enter(key) {
            state.open_mode = false;
            let p = state.open_path;
            state.open_path = "";
            return _open_path(state, p);
        }
        if key == "Escape" { state.open_mode = false; state.open_path = ""; return "open cancelled"; }
        if key == "Backspace" {
            if len(state.open_path) > 0 { state.open_path = str_slice(state.open_path, 0, len(state.open_path) - 1); }
            return "open path: " + state.open_path;
        }
        if state.ctrl and key == "V" {
            state.open_path = state.open_path + state.ed.clipboard;
            return "open path: " + state.open_path;
        }
        let ch0 = K.key_to_char(key, state.shift);
        if ch0 != "" { state.open_path = state.open_path + ch0; return "open path: " + state.open_path; }
        return "";
    }
    if state.find_mode {
        let replacing = try state.replace_mode catch false;
        if key == "Escape" { state.find_mode = false; state.replace_mode = false; return "find closed"; }
        if replacing and key == "Tab" {
            if state.replace_focus == "find" { state.replace_focus = "replace"; } else { state.replace_focus = "find"; }
            return _find_status(state);
        }
        if _is_enter(key) {
            if replacing {
                let res = IDE.replace_all(E.text(ed), state.query, state.replace_text);
                if res.count > 0 { E.snapshot(ed); _replace_editor(state, res.code); state.dirty = true; }
                return "replaced " + str(res.count) + " of '" + state.query + "'";
            }
            if E.find_next(ed, state.query) { return _find_status(state); }
            return "no match: " + state.query;
        }
        let editing_replace = replacing and state.replace_focus == "replace";
        if key == "Backspace" {
            if editing_replace {
                if len(state.replace_text) > 0 { state.replace_text = str_slice(state.replace_text, 0, len(state.replace_text) - 1); }
            } else {
                if len(state.query) > 0 { state.query = str_slice(state.query, 0, len(state.query) - 1); }
            }
            return _find_status(state);
        }
        let ch = K.key_to_char(key, state.shift);
        if ch != "" {
            if editing_replace { state.replace_text = state.replace_text + ch; }
            else { state.query = state.query + ch; }
            return _find_status(state);
        }
        return "";
    }
    // Movement first — so Ctrl+arrow accelerates (word / 5-line / doc-edge) instead of
    // being swallowed by the Ctrl-shortcut block. Shift extends the selection.
    if state.alt and key == "Up" { return _move_line_action(state, 0 - 1); }
    if state.alt and key == "Down" { return _move_line_action(state, 1); }
    if _is_move(key) { _move(ed, key, state.shift, state.rows, state.ctrl); return ""; }
    if state.ctrl {
        if _is_enter(key) {
            if state.shift { return _check_action(state); }
            return _run_action(state);
        }
        if key == "N" { return _new_buffer(state); }
        if key == "C" {
            if E.has_selection(ed) { E.copy(ed); return "copied"; }
            E.copy_line(ed);
            return "copied current line";
        }
        if key == "X" {
            E.snapshot(ed);
            if E.has_selection(ed) { E.cut(ed); state.output = "cut"; }
            else { E.cut_line(ed); state.output = "cut current line"; }
            state.last = "other"; state.dirty = true; state.tokens = nil; state.syntax_hash = ""; return state.output;
        }
        if key == "V" { E.snapshot(ed); E.paste(ed); state.last = "other"; state.dirty = true; return "pasted"; }
        if key == "Z" { E.undo(ed); state.last = "other"; state.dirty = true; return "undo"; }
        if key == "Y" { E.redo(ed); state.last = "other"; state.dirty = true; return "redo"; }
        if key == "A" { E.select_all(ed); return "select all"; }
        if key == "D" and state.shift { return _duplicate_line_action(state); }
        if key == "K" and state.shift { return _delete_line_action(state); }
        if key == "/" or key == "Slash" or key == "NumpadDivide" { return _toggle_line_comment_action(state); }
        if key == "S" and state.shift { return _open_save_as(state); }
        if key == "S" { return _save(state); }
        if key == "O" { return _open_buffer(state); }
        if key == "F" { return _open_find(state); }
        if key == "G" { _open_goto_line(state); return state.output; }
        if key == "D" { state.panel = "design"; return "designer"; }
        if key == "B" { state.panel = "web"; return "browser"; }
        if key == "I" { state.panel = "ai"; return "ai"; }
        if key == "H" { return _open_replace(state); }
        return "";
    }
    if key == "F5" { return _run_action(state); }
    if key == "F6" { return _check_action(state); }
    if key == "F11" { _mode_toggle(state); return state.output; }
    if key == "F12" { _watch_toggle(state); return state.output; }
    if key == "Backspace" { E.snapshot(ed); E.backspace(ed); state.last = "other"; state.dirty = true; return ""; }
    if _is_enter(key) { E.snapshot(ed); E.newline(ed); state.last = "other"; state.dirty = true; return ""; }
    if key == "BackTab" { return _outdent_lines_action(state); }
    if key == "Tab" {
        if state.shift { return _outdent_lines_action(state); }
        if E.has_selection(ed) { return _indent_lines_action(state); }
        E.snapshot(ed);
        if _compose_symbol_at_cursor(state) { return "expanded symbol shortcut"; }
        E.insert_text(ed, "    "); state.last = "other"; state.dirty = true; return "";
    }
    let ch = K.key_to_char(key, state.shift);
    if ch != "" {
        if ch == " " {
            E.snapshot(ed);
            if _compose_symbol_at_cursor(state) { return "expanded symbol shortcut"; }
        }
        if state.last != "type" { E.snapshot(ed); }     // coalesce consecutive typing into one undo
        state.last = "type"; state.dirty = true;
        _insert_code_char(state, ch);
        return "";
    }
    return "";
}

fn _line_tokens(toks, lineno) {
    if toks == nil { return nil; }
    let out = [];
    let i = 0;
    while i < len(toks) { if toks[i].line == lineno { push(out, toks[i]); } i = i + 1; }
    return out;
}

fn _token_lines_index(toks) {
    let out = map{};
    let i = 0;
    while toks != nil and i < len(toks) {
        let t = toks[i];
        let key = str(try t.line catch 0);
        let row = [];
        if map_has(out, key) { row = out[key]; }
        array_push(row, t);
        out[key] = row;
        i = i + 1;
    }
    return out;
}

fn _code_diag_y() { return TOP + CH * 14 + PAD; }

fn _code_tool_y() { return _code_diag_y() + CH * 6 + PAD; }

fn _code_watch_y() { return _code_tool_y() + CH * 5; }

fn _code_ui_y() { return _code_watch_y() + CH * 5; }

fn _code_hist_y() { return _code_ui_y() + CH * 4; }

fn _code_output_w_state(state, sz) {
    if try state.compact catch false { return 22 * CW; }
    let vp = try state.viewport_layout catch _viewport_layout_for(sz);
    let baseChars = try vp.side_chars catch 30;
    let baseW = baseChars * CW;
    let w = try state.outw catch baseW;
    if w == nil or w <= 0 { w = baseW; }
    if w > sz.w * 7 / 10 { w = sz.w * 7 / 10; }
    let minW = 18 * CW;
    if baseChars <= 22 { minW = 16 * CW; }
    if w < minW { w = minW; }
    return w;
}

fn _splitter_hit(state, mx, my) {
    if state.panel != "code" or state.winsz == nil { return false; }
    if my < TOP or my >= state.winsz.h - STATUSH { return false; }
    let outw = _code_output_w_state(state, state.winsz);
    let splitw = SCALE * 3;
    let sx = state.winsz.w - outw - splitw;
    return mx >= sx - SCALE and mx < sx + splitw + SCALE;
}

fn _resize_output_pane(state, mx) {
    if state.winsz == nil { return 0; }
    let splitw = SCALE * 3;
    let w = state.winsz.w - mx - splitw;
    state.outw = w;
    // Reuse the normal output-width clamp immediately, so state stores a sane value.
    state.outw = _code_output_w_state(state, state.winsz);
    return 0;
}

// The 5×7 font is compact but now includes common math/Greek/symbol glyphs. Keep those
// real symbols when a glyph exists; fold only unsupported punctuation/text to readable
// ASCII fallbacks. Unknown non-ASCII stays as its real codepoint so the renderer draws
// a visible missing-glyph box instead of collapsing different symbols/emojis to '?'.

fn _fold(code) {
    if code == 160 { return 32; }                       // nbsp → space
    if F.glyph(code) != nil { return code; }
    if code == 8226 { return 42; }                      // • → *
    if code == 183 { return 45; }                       // · → -
    if code == 8211 or code == 8212 { return 45; }      // – — → -
    if code == 8216 or code == 8217 { return 39; }      // ‘ ’ → '
    if code == 8220 or code == 8221 { return 34; }      // “ ” → "
    if code == 8249 { return 60; }                      // ‹ → <
    if code == 8250 { return 62; }                      // › → >
    if code == 169 { return 99; }                       // © → c
    if code == 8230 { return 46; }                      // … → .
    // Greek letters not covered by the compact symbol glyph set are transliterated.
    if code == 913 { return 65; } if code == 945 { return 97; }          // Alpha/alpha
    if code == 914 { return 66; } if code == 946 { return 98; }          // Beta/beta
    if code == 915 { return 71; } if code == 947 { return 103; }         // Gamma/gamma
    if code == 916 { return 68; } if code == 948 { return 100; }         // Delta/delta
    if code == 917 { return 69; } if code == 949 { return 101; }         // Epsilon/epsilon
    if code == 918 { return 90; } if code == 950 { return 122; }         // Zeta/zeta
    if code == 919 { return 72; } if code == 951 { return 104; }         // Eta/eta
    if code == 920 { return 84; } if code == 952 { return 116; }         // Theta/theta
    if code == 921 { return 73; } if code == 953 or code == 970 { return 105; }
    if code == 922 { return 75; } if code == 954 { return 107; }         // Kappa/kappa
    if code == 923 { return 76; } if code == 955 { return 108; }         // Lambda/lambda
    if code == 924 { return 77; } if code == 956 { return 109; }         // Mu/mu
    if code == 925 { return 78; } if code == 957 { return 110; }         // Nu/nu
    if code == 926 { return 88; } if code == 958 { return 120; }         // Xi/xi
    if code == 927 { return 79; } if code == 959 or code == 972 { return 111; }
    if code == 928 { return 80; } if code == 960 { return 112; }         // Pi/pi
    if code == 929 { return 82; } if code == 961 { return 114; }         // Rho/rho
    if code == 931 { return 83; } if code == 962 or code == 963 { return 115; }
    if code == 932 { return 84; } if code == 964 { return 116; }         // Tau/tau
    if code == 933 { return 89; } if code == 965 or code == 973 or code == 971 { return 121; }
    if code == 934 { return 70; } if code == 966 { return 102; }         // Phi/phi
    if code == 935 { return 88; } if code == 967 { return 120; }         // Chi/chi
    if code == 936 { return 80; } if code == 968 { return 112; }         // Psi/psi
    if code == 937 { return 79; } if code == 969 or code == 974 { return 111; }
    return code;
}

fn _dt_bitmap(win, x, y, s, color) {
    let cx = x;
    let i = 0;
    while i < len(s) {
        let code = _fold(strcharcodeat(s, i));
        if code != 32 {
            let g = F.glyph(code);
            if g == nil { g = [31, 17, 17, 17, 17, 17, 31]; }
            let r = 0;
            while r < 7 {
                let row = g[r];
                let c = 0;
                while c < 5 {
                    if bit_and(bit_shr(row, 4 - c), 1) == 1 {
                        win.rect(cx + c * SCALE, y + r * SCALE, SCALE, SCALE, color);
                    }
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        cx = cx + CW;
        i = i + 1;
    }
    return 0;
}

fn _shape_text_cached(s) {
    let raw = str(s);
    if not _text_needs_shape(raw) { return raw; }
    if map_has(TEXT_SHAPE_CACHE, raw) { return TEXT_SHAPE_CACHE[raw]; }
    if len(TEXT_SHAPE_CACHE_KEYS) >= TEXT_SHAPE_CACHE_LIMIT {
        TEXT_SHAPE_CACHE = map{};
        TEXT_SHAPE_CACHE_KEYS = [];
    }
    let shown = try TL.visual_text(raw, map{ mode: "code" }) catch raw;
    TEXT_SHAPE_CACHE[raw] = shown;
    array_push(TEXT_SHAPE_CACHE_KEYS, raw);
    return shown;
}

fn _text_needs_shape(raw) {
    if str_contains(raw, "->") or str_contains(raw, "=>") or str_contains(raw, "<-") { return true; }
    if str_contains(raw, "<=") or str_contains(raw, ">=") or str_contains(raw, "!=") { return true; }
    if str_contains(raw, "==") or str_contains(raw, "::") or str_contains(raw, "...") { return true; }
    let i = 0;
    while i < len(raw) {
        let cp = strcharcodeat(raw, i);
        if cp > 126 { return true; }
        i = i + 1;
    }
    return false;
}

fn _text_is_blank(raw) {
    if len(raw) == 0 { return true; }
    let i = 0;
    while i < len(raw) {
        let cp = strcharcodeat(raw, i);
        if cp > 32 { return false; }
        i = i + 1;
    }
    return true;
}

// Smooth text uses the native fontdue-backed renderer in pblang-graphics. It keeps the
// same fixed cell advance as the bitmap path, so cursor positioning, hit testing, and
// responsive panel layout stay unchanged. PBIDE_TEXT_RENDER=bitmap restores the old path.

fn _dt(win, x, y, s, color) {
    TEXT_FRAME_CALLS = TEXT_FRAME_CALLS + 1;
    let raw = str(s);
    if _text_is_blank(raw) {
        TEXT_FRAME_SKIPS = TEXT_FRAME_SKIPS + 1;
        return 0;
    }
    let shown = _shape_text_cached(raw);
    if TEXT_AA_READY {
        let r = try win.textAA(x, y - SCALE, shown, color, CH + SCALE, CW) catch nil;
        if r != nil and (try r.ok catch false) {
            TEXT_FRAME_AA = TEXT_FRAME_AA + 1;
            return 0;
        }
    }
    TEXT_FRAME_BITMAP = TEXT_FRAME_BITMAP + 1;
    return _dt_bitmap(win, x, y, shown, color);
}

// ── modern UI primitives (rounded chips/cards/elevation) via stdlib/ui_kit.sapp ───
// A rounded filled rect — corners beveled by radius r so chrome looks contemporary.

fn _round_rect_key(w, h, r) {
    return str(num_floor(w)) + "x" + str(num_floor(h)) + "r" + str(num_floor(r));
}

fn _round_rect_cached(x, y, w, h, r) {
    if w <= 0 or h <= 0 { return []; }
    if r <= 0 { return [map{ x: x, y: y, w: w, h: h }]; }
    w = num_floor(w);
    h = num_floor(h);
    r = num_floor(r);
    let key = _round_rect_key(w, h, r);
    if not map_has(ROUND_RECT_CACHE, key) {
        if len(ROUND_RECT_CACHE_KEYS) >= ROUND_RECT_CACHE_LIMIT {
            ROUND_RECT_CACHE = map{};
            ROUND_RECT_CACHE_KEYS = [];
        }
        ROUND_RECT_CACHE[key] = UIK.rounded_rect(0, 0, w, h, r);
        array_push(ROUND_RECT_CACHE_KEYS, key);
    }
    let base = ROUND_RECT_CACHE[key];
    let out = [];
    let i = 0;
    while i < len(base) {
        let b = base[i];
        array_push(out, map{ x: x + b.x, y: y + b.y, w: b.w, h: b.h });
        i = i + 1;
    }
    return out;
}

fn _elevation_key(w, h, t) {
    return str(num_floor(w)) + "x" + str(num_floor(h)) + "t" + str(num_floor(t));
}

fn _elevation_cached(x, y, w, h, t) {
    if w <= 0 or h <= 0 or t <= 0 { return []; }
    w = num_floor(w);
    h = num_floor(h);
    t = num_floor(t);
    let key = _elevation_key(w, h, t);
    if not map_has(ELEVATION_CACHE, key) {
        if len(ELEVATION_CACHE_KEYS) >= ELEVATION_CACHE_LIMIT {
            ELEVATION_CACHE = map{};
            ELEVATION_CACHE_KEYS = [];
        }
        ELEVATION_CACHE[key] = UIK.elevation(0, 0, w, h, t);
        array_push(ELEVATION_CACHE_KEYS, key);
    }
    let base = ELEVATION_CACHE[key];
    let out = [];
    let i = 0;
    while i < len(base) {
        let b = base[i];
        array_push(out, map{ x: x + b.x, y: y + b.y, w: b.w, h: b.h });
        i = i + 1;
    }
    return out;
}

fn _design_grid_key(sz_w, canvTop, canvBot) {
    return str(num_floor(sz_w)) + "x" + str(num_floor(canvTop)) + "-" + str(num_floor(canvBot)) + "@" + str(SCALE) + "/" + str(CW) + "/" + str(CH);
}

fn _design_grid_rects(sz_w, canvTop, canvBot) {
    if sz_w <= 0 or canvBot <= canvTop { return []; }
    let key = _design_grid_key(sz_w, canvTop, canvBot);
    if not map_has(DESIGN_GRID_CACHE, key) {
        if len(DESIGN_GRID_CACHE_KEYS) >= DESIGN_GRID_CACHE_LIMIT {
            DESIGN_GRID_CACHE = map{};
            DESIGN_GRID_CACHE_KEYS = [];
        }
        let rs = [];
        let gx = PAD;
        while gx < sz_w {
            let gy = canvTop;
            while gy < canvBot {
                array_push(rs, map{ x: gx, y: gy, w: SCALE, h: SCALE });
                gy = gy + CH * 2;
            }
            gx = gx + CW * 4;
        }
        DESIGN_GRID_CACHE[key] = rs;
        array_push(DESIGN_GRID_CACHE_KEYS, key);
    }
    return DESIGN_GRID_CACHE[key];
}

fn _fill_round(win, x, y, w, h, color, r) {
    let rs = _round_rect_cached(x, y, w, h, r);
    _draw_rects(win, rs, color);
    return 0;
}
// A rounded card: soft drop shadow + border ring + inset fill (elevated panel look).

fn _card(win, x, y, w, h, fill, border, r) {
    let sh = _elevation_cached(x, y, w, h, SCALE);
    _draw_rects(win, sh, GUTTERBG);
    _fill_round(win, x, y, w, h, border, r);
    _fill_round(win, x + SCALE, y + SCALE, w - 2 * SCALE, h - 2 * SCALE, fill, r);
    return 0;
}

fn _card_state(state, win, x, y, w, h, fill, border, r) {
    if w <= 0 or h <= 0 { return 0; }
    let sh = _elevation_cached(x, y, w, h, SCALE);
    _draw_rects(win, sh, _style_shadow(state));
    _draw_rects(win, _round_rect_cached(x, y, w, h, r), border);
    _draw_rects(win, _round_rect_cached(x + SCALE, y + SCALE, w - 2 * SCALE, h - 2 * SCALE, r - SCALE), fill);
    return 0;
}

fn _button_face(state, win, x, y, w, h, fill, active) {
    if w <= 0 or h <= 0 { return 0; }
    let r = RAD;
    if active { r = RAD_LG; }
    _fill_round(win, x, y + SCALE, w, h, _style_shadow(state), r);
    _fill_round(win, x, y, w, h, _style_border(state), r);
    _fill_round(win, x + SCALE, y + SCALE, w - 2 * SCALE, h - 2 * SCALE, fill, r);
    if w > 4 * SCALE and h > 3 * SCALE {
        let hi = _style_surface2(state);
        if active { hi = _style_focus(state); }
        win.rect(x + r, y + SCALE, w - 2 * r, SCALE, hi);
    }
    return 0;
}

fn _button_label(state, win, x, y, w, h, label, fg, fill, active) {
    _button_face(state, win, x, y, w, h, fill, active);
    let chars = num_floor((w - 2 * CW) / CW);
    if chars < 1 { return 0; }
    _dt(win, x + CW, y + PAD / 2, str_slice(str(label), 0, chars), fg);
    return 0;
}
// A thin accent bar across the top of a widget (active-tab / active-section marker).

fn _accent_bar(win, x, y, w, color) {
    win.rect(x, y, w, num_floor(SCALE * 3 / 2) + 1, color);
    return 0;
}
// Unified panel section header: a surface strip with a rounded accent spine on the left
// and a hairline bottom border. Returns the x where the panel's header TEXT should start
// (past the spine), so every panel reads with the same modern, consistent rhythm.

fn _panel_head(state, win, sz, y) {
    win.rect(0, y, sz.w, CH + PAD, _style_surface(state));
    win.rect(0, y + CH + PAD, sz.w, SCALE, _style_border(state));
    _fill_round(win, PAD, y + PAD, 2 * SCALE, CH - PAD, _style_accent(state), SCALE);
    return PAD + 3 * SCALE + PAD;
}
// Reusable list-panel chrome components: ONE source for the header bar (surface +
// accent rail + bottom rule) and footer bar (surface + top rule) that all five list
// panels (files/outline/problems/history/manage) share — keeps them pixel-identical
// and makes restyling a one-line change.

fn _panel_header_chrome(state, win, sz, m) {
    let headerH = try m.header_h catch CH + 3 * PAD;
    let bottom = try m.body_top catch TOP + headerH + CH + 2 * PAD;
    if bottom < TOP + headerH { bottom = TOP + headerH; }
    win.rect(0, TOP, sz.w, bottom - TOP, _style_bg(state));
    win.rect(0, TOP, sz.w, headerH, _style_surface(state));
    win.rect(0, TOP + headerH, sz.w, SCALE, _style_border(state));
    _fill_round(win, PAD, TOP + PAD, 2 * SCALE, CH - PAD, _style_accent(state), SCALE);
    return 0;
}

fn _panel_footer_chrome(state, win, sz, footerY) {
    let fy = try parse_number(str(footerY)) catch sz.h - STATUSH;
    if fy == nil { fy = sz.h - STATUSH; }
    if fy < TOP { fy = TOP; }
    let fh = sz.h - fy;
    if fh <= 0 { return 0; }
    win.rect(0, fy, sz.w, fh, _style_surface(state));
    win.rect(0, fy, sz.w, SCALE, _style_border(state));
    return 0;
}

fn _panel_metrics(sz, kind) {
    if sz == nil { sz = map{ w: 1280, h: 760 }; }
    return IDE.ide_panel_metrics(sz.w, sz.h, SCALE, CW, CH, PAD, TOP, STATUSH, kind);
}

fn _list_start_for(sel, total, rows) {
    let s = try parse_number(str(sel)) catch 0;
    let n = try parse_number(str(total)) catch 0;
    let r = try parse_number(str(rows)) catch 1;
    if s == nil { s = 0; }
    if n == nil { n = 0; }
    if r == nil or r < 1 { r = 1; }
    s = num_floor(s);
    n = num_floor(n);
    r = num_floor(r);
    if n <= r { return 0; }
    if s < 0 { s = 0; }
    if s >= n { s = n - 1; }
    let start = s - r + 1;
    if start < 0 { start = 0; }
    if start > n - r { start = n - r; }
    return start;
}

fn _draw_panel_scrollbar(state, win, sz, m, total, rows, offset) {
    if total <= rows { return 0; }
    let h = m.footer_y - m.body_top - PAD;
    if h <= CH { return 0; }
    let thick = _scrollbar_thickness();
    let sb = UIK.scrollbar(sz.w - PAD - thick, m.body_top, h, total, rows, offset, thick);
    _fill_round(win, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _style_surface(state), thick / 2);
    _fill_round(win, sb.thumb.x, sb.thumb.y, sb.thumb.w, sb.thumb.h, _style_focus(state), thick / 2);
    return 0;
}

fn _scrollbar_hit_index(mx, my, x, y, h, total, rows, offset, thick) {
    if total <= rows or rows < 1 or total < 1 { return -1; }
    if h <= CH { return -1; }
    let sb = UIK.scrollbar(x, y, h, total, rows, offset, thick);
    if not _hit_rect(mx, my, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _button_hit_slop() / 2) { return -1; }
    if my < sb.thumb.y { return _list_start_for(offset - rows, total, rows); }
    if my > sb.thumb.y + sb.thumb.h { return _list_start_for(offset + rows, total, rows); }
    let maxoff = total - rows;
    if maxoff <= 0 { return 0; }
    let span = h - sb.thumb.h;
    if span <= 0 { return _list_start_for(offset, total, rows); }
    let rel = my - y - sb.thumb.h / 2;
    if rel < 0 { rel = 0; }
    if rel > span { rel = span; }
    let target = num_floor(rel * maxoff / span);
    return _list_start_for(target, total, rows);
}

fn _panel_scrollbar_hit_index(state, m, total, rows, offset, mx, my) {
    if state.winsz == nil { return -1; }
    let h = m.footer_y - m.body_top - PAD;
    let thick = _scrollbar_thickness();
    return _scrollbar_hit_index(mx, my, state.winsz.w - PAD - thick, m.body_top, h, total, rows, offset, thick);
}

fn _scroll_event_delta(e) {
    let dy = try parse_number(str(try e.dy catch 0)) catch 0;
    if dy == nil or dy == 0 { return 0; }
    if dy > 0 {
        let n = num_floor(dy);
        if n < 1 { n = 1; }
        return 0 - n * 3;
    }
    let n = num_floor(0 - dy);
    if n < 1 { n = 1; }
    return n * 3;
}

fn _clamp_index(v, total) {
    if total <= 0 { return 0; }
    v = num_floor(v);
    if v < 0 { return 0; }
    if v >= total { return total - 1; }
    return v;
}

fn _clamp_scroll(v, total, rows) {
    if rows < 1 { rows = 1; }
    if total <= rows { return 0; }
    v = num_floor(v);
    if v < 0 { return 0; }
    let maxv = total - rows;
    if v > maxv { return maxv; }
    return v;
}

fn _scrollbar_thickness() {
    let thick = 3 * SCALE;
    if thick < 6 { thick = 6; }
    if thick > 14 { thick = 14; }
    return thick;
}

fn _hit_rect(mx, my, x, y, w, h, slop) {
    let s = try parse_number(str(slop)) catch 0;
    if s == nil { s = 0; }
    if w < 1 { w = 1; }
    if h < 1 { h = 1; }
    return mx >= x - s and mx <= x + w + s and my >= y - s and my <= y + h + s;
}

fn _hit_slop() {
    let s = PAD * 2;
    if s < 12 { s = 12; }
    if s > 24 { s = 24; }
    return s;
}

fn _button_hit_slop() {
    let s = _hit_slop() + 2 * SCALE;
    if s < 16 { s = 16; }
    if s > 30 { s = 30; }
    return s;
}

fn _hit_button(mx, my, x, y, w, h) {
    return _hit_rect(mx, my, x, y, w, h, _button_hit_slop());
}

fn _hit_row(my, y, h) {
    let s = _hit_slop() / 2;
    return my >= y - s and my < y + h + s;
}

fn _toolbar_hit_best(items, mx, my, slop) {
    let best = nil;
    let best_score = 999999999;
    let i = 0;
    while i < len(items) {
        let b = items[i];
        if (try b.visible catch true) and _hit_rect(mx, my, b.x, b.y, b.w, b.h, slop) {
            let cx = b.x + b.w / 2;
            let cy = b.y + b.h / 2;
            let dx = mx - cx;
            if dx < 0 { dx = 0 - dx; }
            let dy = my - cy;
            if dy < 0 { dy = 0 - dy; }
            let score = dx + dy;
            if score < best_score {
                best_score = score;
                best = b;
            }
        }
        i = i + 1;
    }
    if best == nil { return nil; }
    return try best.id catch nil;
}

fn _panel_search_box(state, win, m) {
    _fill_round(win, PAD, m.search_y, m.content_w, m.search_h, _style_surface2(state), RAD);
    win.rect(PAD + RAD, m.search_y, m.content_w - 2 * RAD, SCALE, _style_border(state));
    return 0;
}
// Draw a list of ui_kit rects in one color (small convenience for cards/segments/bars).

fn _draw_rects(win, rs, color) {
    if len(rs) > 1 {
        let batched = try win.rects(rs, color) catch nil;
        if batched != nil { return 0; }
    }
    let i = 0;
    while i < len(rs) { let b = rs[i]; win.rect(b.x, b.y, b.w, b.h, color); i = i + 1; }
    return 0;
}

fn _side_section(state, win, x, y, w, h, title, accent, title_color) {
    if h <= CH + PAD { return 0; }
    // The new chrome owns this whole section. Clear it first so old flat-panel
    // layers from previous designs cannot show through rounded-card gaps.
    win.rect(x, y, w, h, _style_bg(state));
    let sx = x + PAD / 2;
    let sy = y + PAD / 2;
    let sw = w - PAD;
    let sh = h - PAD;
    if sw <= 0 or sh <= 0 { return 0; }
    _card_state(state, win, sx, sy, sw, sh, _style_panel(state), _style_border(state), RAD_LG);
    _fill_round(win, sx + SCALE, sy + SCALE, sw - 2 * SCALE, CH + PAD, _style_surface(state), RAD);
    _fill_round(win, sx + SCALE, sy + PAD, 2 * SCALE, CH - PAD / 2, accent, SCALE);
    _dt(win, sx + PAD, sy + PAD / 2, title, title_color);
    return 0;
}

fn _side_content_x(px) { return px + 2 * PAD; }

fn _side_content_y(y) { return y + CH + PAD; }

fn _draw_file_tabs(state, win, editorW) {
    _file_tabs_sync_current(state);
    let tabs = try state.file_tabs catch [];
    if tabs == nil or len(tabs) == 0 { state.file_tab_layout = []; return 0; }
    let h = _file_tabs_height(state);
    if h <= 0 { state.file_tab_layout = []; return 0; }
    win.rect(0, TOP, editorW, h, _style_bg(state));
    win.rect(0, TOP + h - SCALE, editorW, SCALE, _style_border(state));
    let x = PAD;
    let maxX = editorW - PAD;
    let layout = [];
    let i = try state.file_tab_scroll catch 0;
    if i < 0 { i = 0; }
    while i < len(tabs) and x < maxX - 8 * CW {
        let tab = tabs[i];
        let title = str(try tab.title catch _file_tab_title(try tab.path catch ""));
        if try tab.dirty catch false { title = "* " + title; }
        let tw = len(title) * CW + 3 * PAD;
        let minW = 14 * CW;
        let maxW = 28 * CW;
        if tw < minW { tw = minW; }
        if tw > maxW { tw = maxW; }
        if x + tw > maxX { break; }
        let active = i == (try state.file_tab_sel catch 0);
        let fill = _style_surface(state);
        let txt = _style_muted(state);
        if active {
            fill = _style_panel(state);
            txt = _style_text(state);
        }
        _button_face(state, win, x, TOP + PAD / 2, tw, CH + PAD / 2, fill, active);
        if active { _fill_round(win, x + PAD / 2, TOP + h - 2 * SCALE, tw - PAD, 2 * SCALE, _style_accent(state), SCALE); }
        let shown = str_slice(title, 0, (tw - 2 * PAD) / CW);
        _dt(win, x + PAD, TOP + PAD, shown, txt);
        array_push(layout, map{ index: i, x: x, y: TOP, w: tw, h: h });
        x = x + tw + SCALE;
        i = i + 1;
    }
    let files = try state.project_files catch [];
    if files != nil and len(files) > 1 and maxX - x > 16 * CW {
        let badge = str(len(files)) + " files";
        _fill_round(win, maxX - 12 * CW, TOP + PAD / 2, 11 * CW, CH + PAD / 2, _style_surface2(state), RAD);
        _dt(win, maxX - 11 * CW, TOP + PAD, badge, _style_focus(state));
    }
    state.file_tab_layout = layout;
    return 0;
}

fn _file_tab_click(state, mx, my) {
    if (try state.panel catch "") != "code" { return false; }
    let h = _file_tabs_height(state);
    if h <= 0 { return false; }
    if my < TOP - _button_hit_slop() or my > TOP + h + _button_hit_slop() { return false; }
    let layout = try state.file_tab_layout catch [];
    let i = 0;
    while layout != nil and i < len(layout) {
        let b = layout[i];
        if _hit_rect(mx, my, b.x, b.y, b.w, b.h, _button_hit_slop()) {
            _file_tabs_load(state, b.index);
            return true;
        }
        i = i + 1;
    }
    return my >= TOP and my < TOP + h;
}

fn _draw_code(state, win, sz) {
    let ed = state.ed;
    let outw = _code_output_w_state(state, sz);
    let splitw = SCALE * 3;
    let editorW = sz.w - outw - splitw;
    _draw_file_tabs(state, win, editorW);
    let codeTop = _code_content_top(state);
    let rows = num_floor((sz.h - STATUSH - codeTop) / CH);
    state.rows = rows;
    ed.row = num_floor(ed.row);
    ed.col = num_floor(ed.col);
    ed.scroll = num_floor(ed.scroll);
    E.ensure_visible(ed, rows);

    // Re-tokenize only when the editor revision changes. Older PBIDE builds
    // hashed the whole buffer every repaint; the editor model now bumps `rev`
    // on text mutations, so idle redraws do not need full-buffer work.
    let syntax_rev = try ed.rev catch 0;
    if (try state.syntax_rev catch (0 - 1)) != syntax_rev or (try state.syntax_hash catch "") == "" {
        let src_now = E.text(ed);
        if len(src_now) > TOKEN_CHAR_LIMIT {
            state.tokens = nil;
            state.token_lines = nil;
            state.syntax_status = "syntax paused: large file";
        } else {
            state.tokens = try H.tokens(src_now) catch nil;
            state.token_lines = _token_lines_index(state.tokens);
            state.syntax_status = "";
        }
        state.syntax_rev = syntax_rev;
        state.syntax_hash = "rev:" + str(syntax_rev);
    }
    let toks = state.tokens;
    let selr = E.selection_range(ed);
    let scr = ed.scroll;

    // gutter background strip
    win.rect(0, codeTop, GUTTERX - SCALE, sz.h - STATUSH - codeTop, _style_gutter(state));

    let vr = 0;
    while vr < rows {
        let r = scr + vr;
        if r < E.line_count(ed) {
            let y = codeTop + vr * CH;
            // current-line highlight (behind the text, across the editor area)
            if r == ed.row { win.rect(GUTTERX - SCALE, y - SCALE, editorW - GUTTERX + SCALE, CH, _style_currow(state)); }
            // selection highlight (behind the text)
            if selr != nil and r >= selr.start.row and r <= selr.end.row {
                let sc = 0;
                if r == selr.start.row { sc = selr.start.col; }
                let ec = len(ed.lines[r]);
                if r == selr.end.row { ec = selr.end.col; }
                if ec < sc { ec = sc; }
                win.rect(GUTTERX + sc * CW, y, (ec - sc) * CW + SCALE, CH, _style_hilite(state));
            }
            _dt(win, PAD, y, str(r + 1), _style_muted(state));
            let marker = IDE.diagnostic_line_marker(try state.diagnostics catch [], r + 1);
            if (try marker.marker catch "") != "" {
                let mc = _style_info(state);
                if (try marker.severity catch "") == "error" { mc = _style_error(state); }
                if (try marker.severity catch "") == "warning" { mc = _style_warning(state); }
                _dt(win, GUTTERX - CW, y, try marker.marker catch "", mc);
            }
            if toks == nil { _dt(win, GUTTERX, y, ed.lines[r], _style_text(state)); }
        }
        vr = vr + 1;
    }

    // Syntax tokens are indexed by line when tokenized. Drawing now visits only visible
    // rows instead of scanning the whole token array every repaint.
    if toks != nil {
        let indexed = try state.token_lines catch nil;
        let vr2 = 0;
        while vr2 < rows {
            let line_no = scr + vr2 + 1;
            let row_toks = [];
            if indexed != nil and map_has(indexed, str(line_no)) { row_toks = indexed[str(line_no)]; }
            let ti = 0;
            while ti < len(row_toks) {
                let t = row_toks[ti];
                let y = codeTop + vr2 * CH;
                let rgb = H.kind_color_theme(t.kind, _theme_name(state));
                _dt(win, GUTTERX + (t.col - 1) * CW, y, t.text, gfx.rgb(rgb[0], rgb[1], rgb[2]));
                ti = ti + 1;
            }
            vr2 = vr2 + 1;
        }
    }

    let curscreen = ed.row - scr;
    if curscreen >= 0 and curscreen < rows {
        let visible_cols = (editorW - GUTTERX - PAD) / CW;
        if visible_cols < 1 { visible_cols = 1; }
        let cur_col = ed.col;
        if cur_col > visible_cols { cur_col = visible_cols; }
        win.rect(GUTTERX + cur_col * CW, codeTop + curscreen * CH, SCALE, CH - SCALE, CURSOR);
    }

    // editor scrollbar (drawn over the content, at the right edge of the code area)
    let edTotal = E.line_count(ed);
    if edTotal > rows {
        let sbH = sz.h - STATUSH - codeTop;
        let thick = _scrollbar_thickness();
        let sb = UIK.scrollbar(editorW - PAD - thick, codeTop, sbH, edTotal, rows, scr, thick);
        _fill_round(win, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _style_surface2(state), thick / 2);
        _fill_round(win, sb.thumb.x, sb.thumb.y, sb.thumb.w, sb.thumb.h, _style_accent(state), thick / 2);
    }

    // web IDE output side pane
    let ox = editorW;
    win.rect(ox, TOP, splitw, sz.h - TOP - STATUSH, _style_splitter(state));
    win.rect(ox + splitw, TOP, outw, sz.h - TOP - STATUSH, _style_bg(state));
    let px = ox + splitw;
    let stdinY = TOP + CH + PAD;
    let outHeadY = stdinY + CH * 3;
    let diagY = _code_diag_y();
    let toolY = _code_tool_y();
    let watchY = _code_watch_y();
    let uiY = _code_ui_y();
    let histY = _code_hist_y();
    _side_section(state, win, px, TOP, outw, outHeadY - TOP - PAD / 2, "INPUT FOR read_line()", _style_warning(state), _style_warning(state));
    _fill_round(win, px + PAD, stdinY, outw - 2 * PAD, CH * 2 + PAD, _style_surface2(state), RAD);
    _dt(win, _side_content_x(px), stdinY + PAD / 2, "one input per line", _style_muted(state));
    let output_head = "OUTPUT   LN " + str(ed.row + 1) + " COL " + str(ed.col + 1);
    if (try state.syntax_status catch "") != "" { output_head = output_head + "   " + state.syntax_status; }
    let maxchars = (outw - 4 * PAD) / CW;
    _side_section(state, win, px, outHeadY, outw, diagY - outHeadY - PAD / 2, str_slice(output_head, 0, maxchars), _style_success(state), _style_success(state));
    let outlines = str_split(state.output, "
    ");
    let oi = 0;
    while oi < len(outlines) and oi < 7 {
        _dt(win, _side_content_x(px), _side_content_y(outHeadY) + oi * CH, str_slice(outlines[oi], 0, maxchars), _style_pane_text(state));
        oi = oi + 1;
    }
    _side_section(state, win, px, diagY, outw, toolY - diagY - PAD / 2, str_slice("DIAGNOSTICS  " + IDE.diagnostic_counts_label(state.diagnostics), 0, maxchars), _style_warning(state), _style_warning(state));
    let dl = IDE.diagnostic_summary(state.diagnostics, 4);
    let di = 0;
    while di < len(dl) and di < 4 {
        let rowY = _side_content_y(diagY) + di * CH;
        if di == state.diag_index { win.rect(px + SCALE, rowY, outw - 2 * SCALE, CH, _style_hilite(state)); }
        let dc = _style_muted(state);
        if str_contains(dl[di], "ERROR") { dc = _style_error(state); }
        if str_contains(dl[di], "WARNING") { dc = _style_warning(state); }
        _dt(win, _side_content_x(px), rowY, str_slice(dl[di], 0, maxchars), dc);
        di = di + 1;
    }
    _side_section(state, win, px, toolY, outw, watchY - toolY - PAD / 2, "TOOLCHAIN", _style_purple(state), _style_purple(state));
    let tl = _toolchain_lines();
    let ti = 0;
    while ti < len(tl) and ti < 3 {
        _dt(win, _side_content_x(px), _side_content_y(toolY) + ti * CH, str_slice(tl[ti], 0, maxchars), _style_muted(state));
        ti = ti + 1;
    }
    _side_section(state, win, px, watchY, outw, uiY - watchY - PAD / 2, "WATCHER", _style_success(state), _style_success(state));
    let wl = ["watch: off"];
    if try state.watch_enabled catch true { wl = IDE.watcher_lines(state.watch, 4); }
    let wi = 0;
    while wi < len(wl) and wi < 4 {
        let wc = _style_muted(state);
        if str_contains(wl[wi], "diagnostics stale") { wc = _style_warning(state); }
        _dt(win, _side_content_x(px), _side_content_y(watchY) + wi * CH, str_slice(wl[wi], 0, maxchars), wc);
        wi = wi + 1;
    }
    _side_section(state, win, px, uiY, outw, histY - uiY - PAD / 2, "UI OBSERVER", _style_purple(state), _style_purple(state));
    let ul = UIO.snapshot_lines(try state.ui_snapshot catch nil, 3);
    let ui = 0;
    while ui < len(ul) and ui < 3 {
        let uc = _style_muted(state);
        if str_contains(ul[ui], "issue:") { uc = _style_warning(state); }
        _dt(win, _side_content_x(px), _side_content_y(uiY) + ui * CH, str_slice(ul[ui], 0, maxchars), uc);
        ui = ui + 1;
    }
    _side_section(state, win, px, histY, outw, sz.h - STATUSH - histY - PAD / 2, "HISTORY", _style_info(state), _style_info(state));
    let hs = _wrap("Last action: " + state.output, maxchars);
    let hi = 0;
    while hi < len(hs) and hi < 4 {
        _dt(win, _side_content_x(px), _side_content_y(histY) + hi * CH, hs[hi], _style_muted(state));
        hi = hi + 1;
    }

    // bottom status bar — surface strip, hairline top border, accent status LED
    let sy = sz.h - STATUSH;
    win.rect(0, sy, sz.w, STATUSH, _style_surface(state));
    win.rect(0, sy, sz.w, SCALE, _style_border(state));
    _fill_round(win, PAD, sy + PAD, 2 * SCALE, CH - PAD, _style_accent(state), SCALE);
    let statusX = PAD + 3 * SCALE + PAD;
    let status = _code_status_line(state);
    if try state.save_as_mode catch false { status = "SAVE AS  " + state.save_as_path + "  Enter=save  Esc=cancel"; }
    if try state.open_mode catch false { status = "OPEN  " + state.open_path + "  Enter=open  Esc=cancel"; }
    if state.find_mode { status = _find_status(state); }
    status = status + _debug_status_suffix(state);
    let rightReserve = PAD;
    if sz.w > 1040 {
        let chip = _style_name(state) + "/" + _theme_name(state) + " · " + _window_probe_status(state) + _event_status(state);
        if sz.w > 1500 { chip = chip + " · " + _graphics_status(); }
        else { chip = chip + " · " + _graphics_short_status(); }
        if len(chip) * CW > sz.w / 2 { chip = str_slice(chip, 0, (sz.w / 2) / CW); }
        let chipW = len(chip) * CW + 2 * PAD;
        _fill_round(win, sz.w - chipW - PAD, sy + PAD / 2, chipW, CH + PAD / 2, _style_panel(state), RAD);
        _dt(win, sz.w - chipW, sy + PAD / 2, chip, _style_focus(state));
        rightReserve = chipW + 3 * PAD;
    }
    _dt(win, statusX, sy + PAD / 2, str_slice(status, 0, (sz.w - statusX - rightReserve) / CW), _style_muted(state));
}

// ── toolbar (top tab strip) ──────────────────────────────────────────────────────

fn _draw_toolbar(state, win, sz) {
    let layout = _toolbar_layout(state, sz);
    win.rect(0, 0, sz.w, TBH, _style_rail(state));
    win.rect(0, 0, sz.w, SCALE, _style_focus(state));
    win.rect(0, TBH - SCALE, sz.w, SCALE, _style_border(state));
    if sz.w > 320 {
        win.rect(0, SCALE, sz.w, SCALE, _style_shadow(state));
        win.rect(0, TBH - 2 * SCALE, sz.w, SCALE, _style_surface2(state));
    }
    // Brand block: compact, readable, and futuristic without adding new hit zones.
    let brandW = _toolbar_brand_w(sz);
    _button_face(state, win, PAD, PAD, brandW, CH + PAD, _style_panel(state), false);
    _fill_round(win, PAD + SCALE, PAD + SCALE, 3 * SCALE, CH + PAD - 2 * SCALE, _style_focus(state), SCALE);
    _dt(win, PAD + CW + SCALE, PAD + SCALE, "pbIDE", _style_focus(state));
    if brandW >= 18 * CW and sz.w > 900 {
        _dt(win, PAD + 7 * CW, PAD + SCALE, "native studio", _style_muted(state));
    }
    let rows = try layout.rows catch _toolbar_rows(sz);
    let actionY = try layout.action_y catch PAD;
    let panelY = try layout.panel_y catch PAD;
    let i = 0;
    let panelStart = try layout.panel_start catch sz.w - PAD - _panel_total_w_for(sz);
    while i < len(ACTIONS) {
        let b = layout.actions[i];
        let id = ACTIONS[i].id;
        if try b.visible catch true {
            let bg = _toolbar_action_bg(state, id);
            if id == "watch" { bg = _toolbar_watch_state_bg(state, _watch_badge(state)); }
            if id == (try state.hover_tab catch nil) { bg = _style_surface2(state); }
            _button_face(state, win, b.x, b.y, b.w, b.h, bg, id == "run");
            let fg = _toolbar_action_fg(state, id);
            let label = ACTIONS[i].label;
            if id == "mode" { label = _mode_label(state); }
            if id == "watch" { label = _watch_toolbar_label(state); }
            if id == "style" { label = str_upper(str_slice(_style_name(state), 0, 1)) + str_slice(_style_name(state), 1, len(_style_name(state))); }
            if id == "theme" { label = _theme_label(state); }
            _dt(win, b.x + CW, b.y + PAD / 2, label, fg);
            if id == "run" { win.rect(b.x + RAD, b.y + CH + PAD - SCALE, b.w - 2 * RAD, SCALE, _style_focus(state)); }
        }
        i = i + 1;
    }
    i = 0;
    while i < len(PANELS) {
        let b = layout.panels[i];
        let id = PANELS[i].id;
        let active = id == state.panel;
        let bg = _toolbar_panel_bg(state, active);
        let hovered = not active and id == (try state.hover_tab catch nil);
        if hovered { bg = _style_surface2(state); }
        _button_face(state, win, b.x, b.y, b.w, b.h, bg, active);
        // hovered tab: a soft accent underline hints "clickable" before commit
        if hovered { win.rect(b.x + RAD, TBH - SCALE, b.w - 2 * RAD, SCALE, _style_surface2(state)); }
        // active panel tab: an accent underline at the toolbar baseline (modern tab cue)
        if active {
            win.rect(b.x + RAD, panelY, b.w - 2 * RAD, SCALE, _style_focus(state));
            win.rect(b.x + RAD, TBH - 2 * SCALE, b.w - 2 * RAD, 2 * SCALE, _style_focus(state));
        }
        let fg = _toolbar_panel_fg(state, active);
        _dt(win, b.x + CW, b.y + PAD / 2, b.label, fg);
        i = i + 1;
    }
    if sz.w > 1180 and rows == 1 {
        let visual = _toolbar_brand_subtitle(state);
        let vx = panelStart - (len(visual) + 2) * CW;
        if vx > PAD + 84 * CW {
            _dt(win, vx, PAD + PAD / 2, visual, _style_muted(state));
        }
    }
}
// toolbar hit-test: pixel → tab id (nil if not on the toolbar).

fn _toolbar_hit(state, mx, my, sz) {
    if sz == nil { return nil; }
    let layout = _toolbar_layout(state, sz);
    let rows = try layout.rows catch _toolbar_rows(sz);
    let slop = _button_hit_slop();
    let panelY = try layout.panel_y catch PAD;
    let actionY = try layout.action_y catch PAD;
    if my >= panelY - slop and my < panelY + CH + PAD + slop {
        let p = _toolbar_hit_best(try layout.panels catch [], mx, my, slop);
        if p != nil { return p; }
    }
    if my >= actionY - slop and my < actionY + CH + PAD + slop {
        let a = _toolbar_hit_best(try layout.actions catch [], mx, my, slop);
        if a != nil { return a; }
    }
    return nil;
}

fn _replace_editor(state, code) {
    state.ed = E.new(code);
    state.dirty = true;
    state.tokens = nil;
    state.syntax_hash = "";
    state.last = "other";
    state.example_run_path = "";
    state.example_app_kind = "";
    state.example_title = "";
}

fn _apply_example_metadata(state, ex) {
    state.example_title = str(try ex.title catch "");
    state.example_run_path = str(try ex.run_path catch "");
    state.example_app_kind = str(try ex.app_kind catch "");
    let preset_id = str(try ex.design_preset catch "");
    let loaded = "";
    if preset_id != "" {
        let target = str(try ex.design_target catch "gui");
        state.design.target = target;
        state.design.widgets = [];
        state.design.sel = 0 - 1;
        state.design.counter = 0;
        let preset = IDE.designer_component_preset(preset_id, PAD * 2, _design_content_top(state) + PAD);
        if try preset.ok catch false {
            let items = try preset.items catch [];
            let i = 0;
            while i < len(items) {
                let w = _design_apply_preset_item(state, items[i]);
                if w != nil {
                    array_push(state.design.widgets, w);
                    state.design.sel = len(state.design.widgets) - 1;
                }
                i = i + 1;
            }
            _design_apply_layout(state);
            loaded = "designer form: " + str(try preset.title catch preset_id) + " (" + str(len(state.design.widgets)) + " item(s))";
        } else {
            loaded = "designer form unavailable: " + str(try preset.summary catch preset_id);
        }
    }
    let browser_urls = try ex.browser_urls catch [];
    if browser_urls != nil and len(browser_urls) > 0 {
        _web_tabs_set_from_urls(state, browser_urls);
        let msg = "browser tabs: " + str(len(browser_urls)) + " URL(s)";
        if loaded == "" { loaded = msg; }
        else { loaded = loaded + "\n" + msg; }
    }
    let open_panel = str(try ex.open_panel catch "");
    if open_panel == "design" or open_panel == "code" or open_panel == "web" or open_panel == "term" {
        state.panel = open_panel;
    }
    return loaded;
}

fn _format_editor(state) {
    let code = E.text(state.ed);
    let formatted = try FMT.format_source(code, 100) catch nil;
    if formatted == nil { return "format: failed"; }
    let after_parse = FE.frontend_parse_safe(formatted);
    if not (try after_parse.ok catch false) {
        return "format blocked: formatted code did not parse, buffer left unchanged";
    }
    let before_lint = try FE.frontend_lint(code) catch nil;
    let after_lint = try FE.frontend_lint(formatted) catch nil;
    let before_count = try before_lint.count catch 0;
    let after_count = try after_lint.count catch before_count;
    if after_count > before_count {
        return "format blocked: diagnostics would increase from " + str(before_count) + " to " + str(after_count);
    }
    _replace_editor(state, formatted);
    return "formatted via pblang formatter; parse/lint guard passed";
}

fn _line_needs_semicolon(t) {
    if t == "" { return false; }
    if str_ends_with(t, ";") or str_ends_with(t, "{") or str_ends_with(t, "}") { return false; }
    return str_starts_with(t, "print ") or str_starts_with(t, "let ")
    or str_starts_with(t, "const ") or str_starts_with(t, "return ")
    or str_starts_with(t, "throw ");
}

fn _fix_print_call(line) {
    let out = "";
    let i = 0;
    while i < len(line) {
        if i + 6 <= len(line) and str_slice(line, i, i + 6) == "print(" {
            let prev_ok = i == 0;
            if i > 0 {
                let pc = strcharcodeat(line, i - 1);
                prev_ok = not ((pc >= 48 and pc <= 57) or (pc >= 65 and pc <= 90) or (pc >= 97 and pc <= 122) or pc == 95);
            }
            if prev_ok {
                let j = i + 6;
                let depth = 1;
                while j < len(line) and depth > 0 {
                    let c = str_slice(line, j, j + 1);
                    if c == "(" { depth = depth + 1; }
                    else if c == ")" { depth = depth - 1; }
                    if depth == 0 { break; }
                    j = j + 1;
                }
                if depth == 0 and j + 1 < len(line) and str_slice(line, j + 1, j + 2) == ";" {
                    out = out + "print " + str_slice(line, i + 6, j);
                    i = j + 1;
                } else {
                    out = out + str_slice(line, i, i + 1);
                }
            } else {
                out = out + str_slice(line, i, i + 1);
            }
        } else {
            out = out + str_slice(line, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn _auto_fix_editor(state) {
    let code = E.text(state.ed);
    code = str_replace_all(code, strfromcharcode(8216), "'");
    code = str_replace_all(code, strfromcharcode(8217), "'");
    code = str_replace_all(code, strfromcharcode(8220), "\"");
    code = str_replace_all(code, strfromcharcode(8221), "\"");
    code = str_replace_all(code, strfromcharcode(8211), "-");
    code = str_replace_all(code, strfromcharcode(8212), "-");
    code = str_replace_all(code, "fs read(", "fs_read(");
    code = str_replace_all(code, "fs write(", "fs_write(");
    code = MSYM.normalize_code(code);
    let lines = str_split(code, "\n");
    let out = "";
    let changed = false;
    for i len(lines) {
        let line = _fix_print_call(lines[i]);
        if line != lines[i] { changed = true; }
        let t = str_trim(line);
        if _line_needs_semicolon(t) {
            line = line + ";";
            changed = true;
        }
        if i > 0 { out = out + "\n"; }
        out = out + line;
    }
    if changed or out != E.text(state.ed) {
        _replace_editor(state, out);
        return "auto-fix applied: normalized math symbols, print calls, smart punctuation, simple semicolons";
    }
    return "auto-fix: no safe deterministic fixes found";
}

fn _history_ok(action, text) {
    let t = str_lower(str(text));
    if action == "run" {
        return not str_contains(t, "compile error") and not str_contains(t, "run: error");
    }
    if action == "check" {
        return str_contains(t, "ok") and not str_contains(t, "problem");
    }
    return not str_contains(t, "error");
}

fn _history_push(state, action, text) {
    state.history = IDE.push_history_with_mode(state.history, action, _history_ok(action, text), text, E.text(state.ed), 60, try state.history_mode catch "temporary");
    state.history_stored = false;
    if str(try state.history_mode catch "temporary") == "permanent" {
        _history_save_persistent(state);
    }
    return 0;
}

fn _run_action(state) {
    let effect_block = _effect_block("run");
    if effect_block != nil {
        state.output = effect_block;
        return effect_block;
    }
    let prof = IDE.build_profile(try state.build_mode catch "debug");
    if prof.lint_before_run {
        let r = _check_result(state.ed);
        if r == nil {
            state.output = "debug run blocked: check failed before run";
            _history_push(state, "run", state.output);
            _refresh_watcher(state, "debug-run-blocked");
            return state.output;
        }
        state.diagnostics = IDE.normalize_diagnostics(E.text(state.ed), r.diagnostics);
        if len(state.diagnostics) > 0 { state.diag_index = 0; } else { state.diag_index = 0 - 1; }
        if r.count > 0 {
            let blocked = "debug run blocked by " + str(r.count) + " diagnostic(s)\n" + _check_text(r);
            state.output = blocked;
            _history_push(state, "run", blocked);
            _refresh_watcher(state, "debug-run-blocked");
            return blocked;
        }
    }
    let app_profile = _app_profile_for_state(state);
    let out = "";
    if (try app_profile.can_native_run catch false) or str(try state.example_run_path catch "") != "" {
        out = _run_native_app_source(state, app_profile);
    } else {
        out = _run(state.ed);
    }
    let tagged = _mode_label(state) + " run\n" + out;
    state.output = tagged;
    _history_push(state, "run", tagged);
    _refresh_watcher(state, "run");
    return tagged;
}

fn _check_action(state) {
    let r = _check_result(state.ed);
    let out = _check_text(r);
    state.output = out;
    if r == nil {
        state.diagnostics = [];
        state.diag_index = 0 - 1;
    } else {
        state.diagnostics = IDE.normalize_diagnostics(E.text(state.ed), r.diagnostics);
        if len(state.diagnostics) > 0 { state.diag_index = 0; } else { state.diag_index = 0 - 1; }
    }
    _history_push(state, "check", out);
    _refresh_watcher(state, "check");
    return out;
}

fn _diagnostic_goto(state, delta) {
    if len(state.diagnostics) == 0 {
        state.output = "diagnostics: none yet — press F6 Check first";
        return 0;
    }
    let n = len(state.diagnostics);
    let idx = state.diag_index;
    if idx < 0 or idx >= n { idx = 0; }
    else {
        idx = idx + delta;
        if idx < 0 { idx = n - 1; }
        if idx >= n { idx = 0; }
    }
    state.diag_index = idx;
    let d = state.diagnostics[idx];
    let row = (try d.line catch 1) - 1;
    let col = (try d.col catch 1) - 1;
    _nav_record_if_changed(state, row, col, "before diagnostic");
    E.clear_selection(state.ed);
    E.set_cursor(state.ed, row, col);
    state.panel = "code";
    state.output = "diagnostic " + str(idx + 1) + "/" + str(n) + ": " +
    str(try d.kind catch "info") + " at L" + str(try d.line catch 1) +
    ":C" + str(try d.col catch 1) + " - " + str(try d.message catch "diagnostic");
    return 0;
}

fn _nav_current(state, label) {
    return map{
        path: str(try state.path catch ""),
        line: (try state.ed.row catch 0) + 1,
        col: (try state.ed.col catch 0) + 1,
        label: str(label)
    };
}

fn _nav_record(state, label) {
    state.nav_back = IDE.navigation_push(try state.nav_back catch [], _nav_current(state, label), 80);
    state.nav_forward = [];
    return 0;
}

fn _nav_record_if_changed(state, row, col, label) {
    if (try state.ed.row catch 0) != row or (try state.ed.col catch 0) != col {
        _nav_record(state, label);
    }
    return 0;
}

fn _nav_apply_location(state, loc, label) {
    if loc == nil { return 0; }
    let p = str(try loc.path catch try state.path catch "");
    if p != "" and p != str(try state.path catch "") {
        state.output = "navigation target is in another file: " + p;
        return 0;
    }
    E.clear_selection(state.ed);
    E.set_cursor(state.ed, (try loc.line catch 1) - 1, (try loc.col catch 1) - 1);
    state.panel = "code";
    state.output = str(label) + ": L" + str(try loc.line catch 1) + ":C" + str(try loc.col catch 1);
    return 0;
}

fn _nav_back(state) {
    let step = IDE.navigation_step(try state.nav_back catch [], try state.nav_forward catch [], _nav_current(state, "current"), 80);
    if not (try step.ok catch false) { state.output = "navigation: no previous location"; return 0; }
    state.nav_back = step.source;
    state.nav_forward = step.other;
    _nav_apply_location(state, step.target, "navigation back");
    return 0;
}

fn _nav_forward(state) {
    let step = IDE.navigation_step(try state.nav_forward catch [], try state.nav_back catch [], _nav_current(state, "current"), 80);
    if not (try step.ok catch false) { state.output = "navigation: no next location"; return 0; }
    state.nav_forward = step.source;
    state.nav_back = step.other;
    _nav_apply_location(state, step.target, "navigation forward");
    return 0;
}

fn _diagnostic_click(state, mx, my) {
    if len(state.diagnostics) == 0 or state.winsz == nil { return false; }
    let sz = state.winsz;
    let outw = _code_output_w_state(state, sz);
    let px = sz.w - outw;
    let slop = _button_hit_slop();
    if mx < px - slop { return false; }
    let diagY = _code_diag_y();
    let rowTop = diagY + CH + PAD;
    if my < rowTop - slop or my >= rowTop + 4 * CH + slop { return false; }
    let idx = num_floor((my - rowTop) / CH);
    if idx < 0 or idx >= len(state.diagnostics) { return false; }
    state.diag_index = idx;
    _diagnostic_goto(state, 0);
    return true;
}

fn _watcher_click(state, mx, my) {
    if state.winsz == nil { return false; }
    let sz = state.winsz;
    let outw = _code_output_w_state(state, sz);
    let px = sz.w - outw;
    let slop = _button_hit_slop();
    if mx < px - slop { return false; }
    let watchY = _code_watch_y();
    let rowTop = watchY + CH + PAD;
    if my < rowTop - slop or my >= rowTop + 4 * CH + slop { return false; }
    let idx = num_floor((my - rowTop) / CH);
    if idx != 1 { return false; }
    state.panel = "code";
    _watch_action(state);
    return true;
}

fn _ui_observer_click(state, mx, my) {
    if state.winsz == nil { return false; }
    let sz = state.winsz;
    let outw = _code_output_w_state(state, sz);
    let px = sz.w - outw;
    let slop = _button_hit_slop();
    if mx < px - slop { return false; }
    let uiY = _code_ui_y();
    let blockH = CH * 4 + PAD;
    if my < uiY - slop or my >= uiY + blockH + slop { return false; }
    _show_ui_snapshot(state);
    return true;
}

fn _problems_action(state) {
    state.panel = "problems";
    let action = IDE.watcher_action(state.watch);
    let cmd = str(try action.command catch "none");
    if cmd == "check" {
        return _check_action(state);
    }
    if len(state.diagnostics) > 0 {
        state.problems.sel = 1;
        state.output = "problems: " + str(len(state.diagnostics)) + " diagnostic(s)";
        return state.output;
    }
    state.output = "problems: none - diagnostics fresh";
    return state.output;
}

fn _load_next_example(state) {
    let effect_block = _effect_block("open");
    if effect_block != nil { state.output = effect_block; return effect_block; }
    let idx = try state.example_idx catch 0;
    if idx < 0 or idx >= len(EXAMPLES) { idx = 0; }
    let ex = EXAMPLES[idx];
    _file_tabs_sync_current(state);
    let code = _example_code(ex);
    _replace_editor(state, code);
    state.panel = "code";
    let meta = _apply_example_metadata(state, ex);
    _file_tabs_reset_for_example(state, ex, code);
    _design_tabs_reset_for_project(state);
    _refresh_watcher(state, "example");
    state.example_idx = idx + 1;
    if state.example_idx >= len(EXAMPLES) { state.example_idx = 0; }
    let msg = "loaded example: " + ex.title + " (" + str(idx + 1) + "/" + str(len(EXAMPLES)) + ")";
    if meta != "" { msg = msg + "\n" + meta; }
    let listing = _project_files_text(try state.project_files catch []);
    if listing != "" { msg = msg + "\n" + listing; }
    state.output = msg;
    return msg;
}

fn _example_hits(state) {
    return IDE.filter_examples(EXAMPLES, try state.example_query catch "", 10000);
}

fn _load_example_index(state, idx) {
    let effect_block = _effect_block("open");
    if effect_block != nil { state.output = effect_block; return effect_block; }
    if idx < 0 or idx >= len(EXAMPLES) { return "example: invalid selection"; }
    let ex = EXAMPLES[idx];
    _file_tabs_sync_current(state);
    let code = _example_code(ex);
    _replace_editor(state, code);
    state.panel = "code";
    let meta = _apply_example_metadata(state, ex);
    _file_tabs_reset_for_example(state, ex, code);
    _design_tabs_reset_for_project(state);
    _refresh_watcher(state, "example");
    state.examples_mode = false;
    state.output = "loaded example: " + ex.title + " (" + str(idx + 1) + "/" + str(len(EXAMPLES)) + ")";
    if meta != "" { state.output = state.output + "\n" + meta; }
    let listing = _project_files_text(try state.project_files catch []);
    if listing != "" { state.output = state.output + "\n" + listing; }
    return state.output;
}

fn _open_examples(state) {
    state.examples_mode = true;
    state.example_query = "";
    state.example_sel = 0;
    state.output = "examples: type to filter, Enter loads, Esc closes";
    return state.output;
}

fn _example_clamp(state) {
    let hits = _example_hits(state);
    if len(hits) == 0 { state.example_sel = 0; return hits; }
    if state.example_sel < 0 { state.example_sel = 0; }
    if state.example_sel >= len(hits) { state.example_sel = len(hits) - 1; }
    return hits;
}

fn _examples_key(state, key, shift) {
    if key == "Escape" { state.examples_mode = false; state.output = "examples closed"; return 0; }
    let n = len(_example_hits(state));
    let page = 10;
    if state.winsz != nil { page = _examples_visible_rows(_example_box(state.winsz)); }
    if key == "Home" { state.example_sel = IDE.selection_move(state.example_sel, n, "home", page); return 0; }
    if key == "End" { state.example_sel = IDE.selection_move(state.example_sel, n, "end", page); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.example_sel = IDE.selection_move(state.example_sel, n, "next", page); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.example_sel = IDE.selection_move(state.example_sel, n, "previous", page); return 0; }
    if key == "Down" { state.example_sel = IDE.selection_move(state.example_sel, n, "down", page); return 0; }
    if key == "Up" { state.example_sel = IDE.selection_move(state.example_sel, n, "up", page); return 0; }
    if key == "PageDown" { state.example_sel = IDE.selection_move(state.example_sel, n, "page_down", page); return 0; }
    if key == "PageUp" { state.example_sel = IDE.selection_move(state.example_sel, n, "page_up", page); return 0; }
    if key == "Delete" { state.example_query = ""; state.example_sel = 0; return 0; }
    if key == "Backspace" {
        if len(state.example_query) > 0 { state.example_query = str_slice(state.example_query, 0, len(state.example_query) - 1); }
        state.example_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _example_clamp(state);
        if len(hits) > 0 { _load_example_index(state, hits[state.example_sel].index); }
        else { state.output = "examples: no match"; }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.example_query = state.example_query + ch;
        state.example_sel = 0;
    }
    return 0;
}

fn _open_buffer(state) {
    let effect_block = _effect_block("open");
    if effect_block != nil { state.output = effect_block; return effect_block; }
    state.panel = "code";
    state.quick_open_mode = true;
    state.quick_query = "";
    state.quick_sel = 0;
    state.quick_dir = try path_dirname(state.path) catch ".";
    if state.quick_dir == "" { state.quick_dir = "."; }
    _quick_open_refresh(state);
    return "quick open: " + state.quick_dir + "  (type to filter, Enter=open, Esc=cancel)";
}

fn _toolbar_click(state, id) {
    _ui_event(state, "toolbar " + str(id));
    if id == "code" or id == "ai" or id == "design" or id == "web" or id == "term" or id == "hist" or id == "manage" or id == "settings" or id == "outline" or id == "files" or id == "problems" {
        state.panel = id;
        if id == "files" { _files_refresh(state); }
        if id == "design" { _design_tabs_focus_path(state, try state.path catch ""); }
        return 0;
    }
    if id == "run" { state.panel = "code"; _run_action(state); return 0; }
    if id == "check" { state.panel = "code"; _check_action(state); return 0; }
    if id == "save" { state.panel = "code"; state.output = _save(state); return 0; }
    if id == "clear" { state.output = ""; state.term.lines = []; state.ai.lines = []; return 0; }
    if id == "restore" {
        state.panel = "code";
        state.ed = E.new(_starter_code());
        state.dirty = true; state.tokens = nil; state.syntax_hash = ""; state.output = "restored web IDE starter example";
        return 0;
    }
    if id == "format" { state.panel = "code"; state.output = _format_editor(state); return 0; }
    if id == "fix" { state.panel = "code"; state.output = _auto_fix_editor(state); return 0; }
    if id == "examples" { state.panel = "code"; state.output = _open_examples(state); return 0; }
    if id == "open" { state.output = _open_buffer(state); return 0; }
    if id == "preview" { _preview_current_file(state); return 0; }
    if id == "mode" { _mode_toggle(state); return 0; }
    if id == "watch" { _watch_toggle(state); return 0; }
    if id == "watch_action" { state.panel = "code"; _watch_action(state); return 0; }
    if id == "style" {
        state.style = _style_next(_style_name(state));
        state.output = "style: " + state.style + " (Web/Smooth/Crystal/Contrast; PBIDE_SCALE=1..4 overrides live density)";
        return 0;
    }
    if id == "density_smaller" { _density_delta(state, 0 - 1); return 0; }
    if id == "density_larger" { _density_delta(state, 1); return 0; }
    if id == "density_auto" { _density_auto(state); return 0; }
    if id == "density_refresh" { _density_refresh(state); return 0; }
    if id == "theme" { _theme_toggle(state); return 0; }
    if id == "help" { state.help = not state.help; return 0; }
    return 0;
}

fn _open_command_palette(state) {
    state.command_mode = true;
    state.command_query = "";
    state.command_sel = 0;
    state.output = "command palette: type a command, Enter runs, Esc closes";
    return 0;
}

fn _command_hits(state) {
    return IDE.filter_commands(try state.command_query catch "", 200);
}

fn _command_clamp(state) {
    let hits = _command_hits(state);
    if state.command_sel < 0 { state.command_sel = 0; }
    if len(hits) == 0 { state.command_sel = 0; return hits; }
    if state.command_sel >= len(hits) { state.command_sel = len(hits) - 1; }
    return hits;
}

fn _command_execute(state, id) {
    state.command_mode = false;
    _ui_event(state, "command " + str(id));
    if id == "panel_code" { _panel_by_index(state, 0); return 0; }
    if id == "panel_term" { _panel_by_index(state, 1); return 0; }
    if id == "terminal_clear" { state.term.lines = []; state.panel = "term"; state.output = "terminal output cleared"; return 0; }
    if id == "panel_ai" { _panel_by_index(state, 2); return 0; }
    if str_starts_with(str(id), "ai_") {
        state.panel = "ai";
        let aid = str_slice(str(id), 3, len(str(id)));
        _ai_action(state, aid);
        return 0;
    }
    if id == "panel_design" { _panel_by_index(state, 3); return 0; }
    if str_starts_with(str(id), "design_") {
        state.panel = "design";
        _design_command(state, str_slice(str(id), 7, len(str(id))));
        return 0;
    }
    if id == "panel_web" { _panel_by_index(state, 4); return 0; }
    if id == "panel_files" { _panel_by_index(state, 5); return 0; }
    if id == "files_flat" { _files_set_mode(state, "flat"); return 0; }
    if id == "files_tree" { _files_set_mode(state, "tree"); return 0; }
    if id == "files_recent" { _files_set_mode(state, "recent"); return 0; }
    if id == "files_reveal" { _files_reveal_current(state); return 0; }
    if id == "files_preview_selected" { state.panel = "files"; _files_preview_selected(state); return 0; }
    if id == "files_inspect" { state.panel = "files"; _files_inspect_selected(state); return 0; }
    if id == "files_copy" { state.panel = "files"; _files_copy_selected(state); return 0; }
    if id == "files_cut" { state.panel = "files"; _files_cut_selected(state); return 0; }
    if id == "files_paste_plan" { state.panel = "files"; _files_paste_plan(state); return 0; }
    if id == "files_delete_plan" { state.panel = "files"; _files_delete_plan_selected(state); return 0; }
    if id == "files_rename_plan" { state.panel = "files"; _files_rename_plan_selected(state); return 0; }
    if id == "files_new_folder_plan" { state.panel = "files"; _files_new_folder_plan(state); return 0; }
    if id == "files_remote_profile" { state.panel = "files"; _files_remote_profile(state); return 0; }
    if id == "files_transfer_plan" { state.panel = "files"; _files_transfer_plan_selected(state); return 0; }
    if id == "files_root_label" { state.panel = "files"; _files_root_label_from_query(state); return 0; }
    if id == "files_root_group_next" { state.panel = "files"; _files_root_group_next(state); return 0; }
    if id == "files_clear_recent" { _files_clear_recent(state); return 0; }
    if id == "panel_outline" { _panel_by_index(state, 6); return 0; }
    if id == "panel_problems" { _panel_by_index(state, 7); return 0; }
    if id == "panel_hist" { _panel_by_index(state, 8); return 0; }
    if id == "panel_manage" { _panel_by_index(state, 9); return 0; }
    if id == "panel_settings" { _panel_by_index(state, 10); return 0; }
    if id == "panel_next" { _panel_step(state, 1); return 0; }
    if id == "panel_prev" { _panel_step(state, 0 - 1); return 0; }
    if id == "new" { _new_buffer(state); return 0; }
    if id == "save_as" { _open_save_as(state); return 0; }
    if id == "revert" { _revert_buffer(state); return 0; }
    if id == "preview_file" { _preview_current_file(state); return 0; }
    if id == "line_duplicate" { state.panel = "code"; _duplicate_line_action(state); return 0; }
    if id == "line_delete" { state.panel = "code"; _delete_line_action(state); return 0; }
    if id == "line_move_up" { state.panel = "code"; _move_line_action(state, 0 - 1); return 0; }
    if id == "line_move_down" { state.panel = "code"; _move_line_action(state, 1); return 0; }
    if id == "line_comment_toggle" { state.panel = "code"; _toggle_line_comment_action(state); return 0; }
    if id == "line_indent" { state.panel = "code"; _indent_lines_action(state); return 0; }
    if id == "line_outdent" { state.panel = "code"; _outdent_lines_action(state); return 0; }
    if id == "trim_trailing_ws" { state.panel = "code"; _trim_trailing_ws_action(state); return 0; }
    if id == "problems" { _problems_action(state); return 0; }
    if id == "find" { state.output = _open_find(state); return 0; }
    if id == "replace" { state.output = _open_replace(state); return 0; }
    if id == "goto_line" { _open_goto_line(state); return 0; }
    if id == "navigate_back" { _nav_back(state); return 0; }
    if id == "navigate_forward" { _nav_forward(state); return 0; }
    if id == "history_clear" { _history_clear(state); return 0; }
    if id == "history_delete_selected" { state.panel = "hist"; _history_delete_selected(state); return 0; }
    if id == "history_toggle_store" { _history_toggle_store(state); return 0; }
    if id == "history_save" { _history_save_persistent(state); return 0; }
    if id == "density_smaller" { _density_delta(state, 0 - 1); return 0; }
    if id == "density_larger" { _density_delta(state, 1); return 0; }
    if id == "density_auto" { _density_auto(state); return 0; }
    if id == "density_refresh" { _density_refresh(state); return 0; }
    if id == "diagnostic_next" { state.panel = "code"; _diagnostic_goto(state, 1); return 0; }
    if id == "diagnostic_prev" { state.panel = "code"; _diagnostic_goto(state, 0 - 1); return 0; }
    if id == "browser_load" { state.panel = "web"; _web_load(state); return 0; }
    if id == "browser_back" { state.panel = "web"; _web_back(state); return 0; }
    if id == "browser_forward" { state.panel = "web"; _web_forward(state); return 0; }
    if id == "browser_home" { state.panel = "web"; _web_home(state); return 0; }
    if id == "browser_live" { state.panel = "web"; state.web.mode = "live"; state.web.scroll = 0; state.output = "browser view: Live"; return 0; }
    if id == "browser_reader" { state.panel = "web"; state.web.mode = "reader"; state.web.scroll = 0; state.output = "browser view: Reader"; return 0; }
    if id == "browser_links" { state.panel = "web"; state.web.mode = "links"; state.web.scroll = 0; state.output = "browser view: Links"; return 0; }
    if id == "browser_forms" { state.panel = "web"; state.web.mode = "forms"; state.web.scroll = 0; state.output = "browser view: Forms"; return 0; }
    if id == "browser_bookmarks" { state.panel = "web"; _web_show_bookmarks(state); return 0; }
    if id == "browser_bookmark" { state.panel = "web"; _web_bookmark_current(state); return 0; }
    if id == "browser_bookmark_remove" { state.panel = "web"; _web_bookmark_remove_newest(state); return 0; }
    if id == "browser_find" { state.panel = "web"; _web_find_open(state); return 0; }
    if id == "browser_stats" { state.panel = "web"; _web_stats(state); return 0; }
    if id == "browser_search_next" { state.panel = "web"; _web_search_next(state); return 0; }
    if id == "browser_download_plan" { state.panel = "web"; _web_download_plan(state); return 0; }
    if id == "browser_source" { state.panel = "web"; state.web.mode = "source"; state.web.scroll = 0; state.output = "browser view: Source"; return 0; }
    if id == "browser_inspect" { state.panel = "web"; state.web.mode = "inspect"; state.web.scroll = 0; state.output = "browser view: Inspect"; return 0; }
    if id == "browser_host" { state.panel = "web"; _web_render(state); return 0; }
    if id == "browser_security_next" {
        state.panel = "web";
        state.web.security = B.next_security_mode(try state.web.security catch "safe");
        let secn = B.security_profile(state.web.security);
        state.web.status = "security " + str(try secn.label catch state.web.security);
        state.output = state.web.status;
        return 0;
    }
    if id == "browser_security_safe" or id == "browser_security_live" or id == "browser_security_jsdom" or id == "browser_security_trusted" or id == "browser_security_tor" {
        state.panel = "web";
        let mode = "safe";
        if id == "browser_security_live" { mode = "live"; }
        if id == "browser_security_jsdom" { mode = "jsdom"; }
        if id == "browser_security_trusted" { mode = "trusted"; }
        if id == "browser_security_tor" { mode = "tor"; }
        state.web.security = mode;
        let secm = B.security_profile(mode);
        state.web.status = "security " + str(try secm.label catch mode);
        state.output = state.web.status;
        return 0;
    }
    if id == "browser_tor_toggle" {
        state.panel = "web";
        state.web.tor = not (try state.web.tor catch false);
        if state.web.tor { state.web.status = "Tor enabled"; }
        else { state.web.status = "Tor disabled"; }
        state.output = state.web.status;
        return 0;
    }
    if id == "ui_snapshot" { _show_ui_snapshot(state); return 0; }
    _toolbar_click(state, id);
    return 0;
}

fn _command_key(state, key, shift) {
    if key == "Escape" { state.command_mode = false; state.output = "command palette closed"; return 0; }
    if key == "Home" { state.command_sel = 0; _command_clamp(state); return 0; }
    if key == "End" {
        let hits = _command_clamp(state);
        if len(hits) > 0 { state.command_sel = len(hits) - 1; }
        return 0;
    }
    if key == "PageDown" { state.command_sel = state.command_sel + 8; _command_clamp(state); return 0; }
    if key == "PageUp" { state.command_sel = state.command_sel - 8; _command_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.command_sel = state.command_sel + 1; _command_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.command_sel = state.command_sel - 1; _command_clamp(state); return 0; }
    if key == "Down" { state.command_sel = state.command_sel + 1; _command_clamp(state); return 0; }
    if key == "Up" { state.command_sel = state.command_sel - 1; _command_clamp(state); return 0; }
    if key == "Delete" { state.command_query = ""; state.command_sel = 0; return 0; }
    if key == "Backspace" {
        if len(state.command_query) > 0 { state.command_query = str_slice(state.command_query, 0, len(state.command_query) - 1); }
        state.command_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _command_clamp(state);
        if len(hits) > 0 { _command_execute(state, hits[state.command_sel].id); }
        else { state.output = "command palette: no match"; }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.command_query = state.command_query + ch;
        state.command_sel = 0;
    }
    return 0;
}

fn _open_goto_line(state) {
    state.panel = "code";
    state.goto_line_mode = true;
    state.goto_line_input = str((try state.ed.row catch 0) + 1);
    state.output = "go to line: type a line number, Enter jumps, Esc closes";
    return 0;
}

fn _goto_line_apply(state) {
    let target = IDE.goto_line_target(try state.goto_line_input catch "", E.line_count(state.ed));
    _nav_record_if_changed(state, target.row, target.col, "before go to line");
    E.set_cursor(state.ed, target.row, target.col);
    state.goto_line_mode = false;
    state.output = "go to line: " + str(target.line) + "/" + str(target.total);
    return 0;
}

fn _is_digit_char(ch) {
    if ch == "" { return false; }
    let c = strcharcodeat(ch, 0);
    return c >= 48 and c <= 57;
}

fn _goto_line_key(state, key, shift) {
    if key == "Escape" { state.goto_line_mode = false; state.output = "go to line closed"; return 0; }
    if key == "Backspace" {
        if len(state.goto_line_input) > 0 { state.goto_line_input = str_slice(state.goto_line_input, 0, len(state.goto_line_input) - 1); }
        return 0;
    }
    if _is_enter(key) { _goto_line_apply(state); return 0; }
    let ch = K.key_to_char(key, shift);
    if _is_digit_char(ch) { state.goto_line_input = state.goto_line_input + ch; }
    return 0;
}

// _modal_box(sz, want_w, want_h, top_pad) — the shared modal geometry every picker uses:
// clamp the desired size to the window (leaving a 2·PAD margin), center horizontally, sit
// top_pad·PAD below the toolbar, and re-center vertically if it would overflow the status
// bar. Returns { x, y, w, h }; callers add view-specific fields (e.g. list_y).

fn _modal_box(sz, want_w, want_h, top_pad) {
    let bw = want_w;
    if bw > sz.w - 4 * PAD { bw = sz.w - 4 * PAD; }
    let bh = want_h;
    if bh > sz.h - 4 * PAD { bh = sz.h - 4 * PAD; }
    let bx = (sz.w - bw) / 2;
    let by = TOP + top_pad * PAD;
    if by + bh > sz.h - STATUSH { by = (sz.h - bh) / 2; }
    return map{ x: bx, y: by, w: bw, h: bh };
}

fn _goto_line_box(sz) {
    return _modal_box(sz, 54 * CW, CH * 7 + 6 * PAD, 5);
}

fn _draw_goto_line(state, win, sz) {
    let b = _goto_line_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    _card_state(state, win, b.x, b.y, b.w, b.h, _style_panel(state), _style_border(state), RAD_LG);
    _accent_bar(win, b.x + RAD_LG, b.y, b.w - 2 * RAD_LG, _style_accent(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Go To Line", _style_accent(state));
    _dt(win, b.x + 2 * PAD, b.y + CH + 3 * PAD, "Line 1.." + str(E.line_count(state.ed)) + "   Enter jump   Esc close", _style_muted(state));
    let qy = b.y + CH * 3 + 4 * PAD;
    _fill_round(win, b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state), RAD);
    let prompt = "Line: " + str(try state.goto_line_input catch "");
    let shown = str_slice(prompt, 0, (b.w - 6 * PAD) / CW);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shown, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);
    return 0;
}

// ── terminal panel (real PC commands via proc_spawn_wait — needs --allow-exec) ────
// Shell-quote a path for a single-quoted bash context.

fn _shq(s) { return "'" + str_replace_all(s, "'", "'\\''") + "'"; }

fn _term_push(state, line) {
    array_push(state.term.lines, line);
    // cap scrollback so a chatty command can't grow the buffer without bound
    if len(state.term.lines) > 600 {
        let out = [];
        let i = len(state.term.lines) - 400;
        while i < len(state.term.lines) { push(out, state.term.lines[i]); i = i + 1; }
        state.term.lines = out;
    }
}

fn _term_run(state) {
    let t = state.term;
    let cmd = str_trim(t.input);
    _term_push(state, "$ " + cmd);
    t.input = "";
    if cmd == "" { return 0; }
    if cmd == "clear" { state.term.lines = []; return 0; }
    let effect_block = _effect_block("terminal");
    if effect_block != nil {
        _term_push(state, "[" + effect_block + "]");
        return 0;
    }
    t.cmd_history = IDE.terminal_history_push(try t.cmd_history catch [], cmd, 80);
    t.hist_pos = len(t.cmd_history);
    t.hist_draft = "";
    // Run inside the tracked cwd; a trailing `pwd` reports the directory AFTER the
    // command (so `cd subdir` persists across commands like a real shell). stdout's
    // last line is that pwd; everything above it is the command's own output.
    let full = "cd " + _shq(t.cwd) + " 2>/dev/null; " + cmd + "\nprintf '%s' \"$(pwd)\"";
    let r = try proc_spawn_wait("bash", ["-c", full]) catch nil;
    if r == nil {
        _term_push(state, "[terminal needs exec — relaunch with --allow-exec or --allow-all]");
        return 0;
    }
    let outlines = str_split(r.stdout, "
    ");
    let n = len(outlines);
    if n > 0 { state.term.cwd = outlines[n - 1]; }      // last line = resulting pwd
    let i = 0;
    while i < n - 1 { _term_push(state, outlines[i]); i = i + 1; }
    let errl = str_split(r.stderr, "
    ");
    let j = 0;
    while j < len(errl) { if str_trim(errl[j]) != "" { _term_push(state, "! " + errl[j]); } j = j + 1; }
    return 0;
}

fn _term_key(state, key, shift) {
    let t = state.term;
    if key == "Up" {
        let m = IDE.terminal_history_move(try t.cmd_history catch [], try t.hist_pos catch len(try t.cmd_history catch []), "up", try t.hist_draft catch "", try t.input catch "");
        t.hist_pos = m.pos;
        t.hist_draft = m.draft;
        t.input = m.input;
        return 0;
    }
    if key == "Down" {
        let m = IDE.terminal_history_move(try t.cmd_history catch [], try t.hist_pos catch len(try t.cmd_history catch []), "down", try t.hist_draft catch "", try t.input catch "");
        t.hist_pos = m.pos;
        t.hist_draft = m.draft;
        t.input = m.input;
        return 0;
    }
    if _is_enter(key) {
        if shift { t.input = t.input + "
            "; return 0; }                  // Shift+Enter = newline (compose a multi-line command)
        _term_run(state); return 0;
    }
    if key == "Backspace" {
        if len(t.input) > 0 { t.input = str_slice(t.input, 0, len(t.input) - 1); }
        t.hist_pos = len(try t.cmd_history catch []);
        t.hist_draft = "";
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        t.input = t.input + ch;
        t.hist_pos = len(try t.cmd_history catch []);
        t.hist_draft = "";
    }
    return 0;
}
// draw a (possibly multi-line) input box pinned to the window bottom; the first visual
// line carries `prefix`. Multi-line because Shift+Enter inserts "\n" into `input`. Returns
// the Y where the box starts, so the scrollback above can size itself to fit.

fn _draw_input(state, win, sz, prefix, input, maxchars) {
    let inlines = str_split(input, "
    ");
    let nl = len(inlines);
    let boxTop = sz.h - CH * nl - 2 * PAD;
    win.rect(0, boxTop - PAD, sz.w, CH * nl + 3 * PAD, _style_bg(state));
    _card_state(state, win, PAD, boxTop - PAD / 2, sz.w - 2 * PAD, CH * nl + 2 * PAD, _style_panel(state), _style_border(state), RAD_LG);
    _fill_round(win, PAD + SCALE, boxTop, 2 * SCALE, CH * nl, _style_focus(state), SCALE);
    let i = 0;
    while i < nl {
        let txt = inlines[i];
        if i == 0 { txt = prefix + txt; }
        _dt(win, 2 * PAD, boxTop + i * CH, str_slice(txt, 0, maxchars), _style_text(state));
        i = i + 1;
    }
    let lastlen = len(inlines[nl - 1]);
    if nl == 1 { lastlen = lastlen + len(prefix); }
    if lastlen > maxchars { lastlen = maxchars; }
    win.rect(2 * PAD + lastlen * CW, boxTop + (nl - 1) * CH, SCALE, CH - SCALE, CURSOR);
    return boxTop - PAD;
}

fn _draw_term(state, win, sz) {
    let t = state.term;
    let maxchars = (sz.w - 2 * PAD) / CW;
    let promptTop = _draw_input(state, win, sz, t.cwd + " $ ", t.input, maxchars);
    let hx = _panel_head(state, win, sz, TOP);
    let header = IDE.terminal_history_status(try t.cmd_history catch [], try t.hist_pos catch len(try t.cmd_history catch [])) +
    " · Up/Down recall · Shift+Enter newline · clear clears output";
    _dt(win, hx, TOP + PAD / 2, str_slice(header, 0, maxchars), _style_muted(state));
    let scrollTop = TOP + CH + 2 * PAD;
    let areaRows = (promptTop - scrollTop) / CH;
    let total = len(t.lines);
    let start = 0;
    if total > areaRows { start = total - areaRows; }    // tail the scrollback
    let vr = 0;
    while start + vr < total and vr < areaRows {
        let ln = t.lines[start + vr];
        let col = _style_success(state);
        if len(ln) > 0 and strcharcodeat(ln, 0) == 33 { col = _style_error(state); }   // '!' = stderr line
        _dt(win, PAD, scrollTop + vr * CH, str_slice(ln, 0, maxchars), col);
        vr = vr + 1;
    }
}

// ── placeholder panels (next milestones — reachable, honest about status) ─────────

fn _draw_stub(state, win, sz, title, lines) {
    _dt(win, PAD, TOP, title, _style_accent(state));
    let i = 0;
    while i < len(lines) {
        _dt(win, PAD, TOP + CH * 2 + i * CH, lines[i], _style_pane_text(state));
        i = i + 1;
    }
}

// ── Visual Designer panel ─────────────────────────────────────────────────────────
// A drag-and-drop form builder: a palette of widget kinds + a canvas you click to
// place widgets + an inspector, generating real stdlib/gui.sapp code. Placed widgets
// ARE gui widget maps (built by the G.* constructors), so →CODE round-trips to source.
let DPAL = [
map{ id: "label",    label: "LABEL",  act: false },
map{ id: "button",   label: "BUTTON", act: false },
map{ id: "textbox",  label: "TEXT",   act: false },
map{ id: "checkbox", label: "CHECK",  act: false },
map{ id: "radio",    label: "RADIO",  act: false },
map{ id: "select",   label: "SELECT", act: false },
map{ id: "slider",   label: "SLIDER", act: false },
map{ id: "panel",    label: "PANEL",  act: false },
map{ id: "docpage",  label: "PAGE",   act: false },
map{ id: "doctext",  label: "RICH",   act: false },
map{ id: "docimage", label: "IMAGE",  act: false },
map{ id: "doctable", label: "TABLE",  act: false },
map{ id: "docmedia", label: "MEDIA",  act: false },
map{ id: "cube3d",   label: "CUBE3D", act: false },
map{ id: "sphere3d", label: "BALL3D", act: false },
map{ id: "chart2d",  label: "CHART",  act: false },
map{ id: "nditem",   label: "ND",     act: false },
map{ id: "custom",   label: "CUSTOM", act: false },
map{ id: "webcomp",  label: "WEB",    act: false },
map{ id: "scan3d",   label: "SCAN3D", act: false },
map{ id: "camera",   label: "CAM",    act: false },
map{ id: "light",    label: "LIGHT",  act: false },
map{ id: "material", label: "MAT",    act: false },
map{ id: "terrain",  label: "TERR",   act: false },
map{ id: "particles", label: "PART",   act: false },
map{ id: "physics",  label: "PHYS",   act: false },
map{ id: "prefab",   label: "PREFAB", act: false },
map{ id: "backend",  label: "VK/GL",  act: false },
map{ id: "apptype",  label: "APP:both", act: true },
map{ id: "layout",   label: "LAYOUT", act: true },
map{ id: "fromcode", label: "<-CODE", act: true },
map{ id: "gencode",  label: "->CODE", act: true },
map{ id: "clear",    label: "CLEAR",  act: true },
];

fn _design_tabs_height() {
    return CH + PAD;
}

fn _design_palette_top() {
    return TOP + _design_tabs_height();
}
// x/y/width of palette chip `idx` (wrapped — same math in draw + hit-test).

fn _pal_bounds(idx, sz = nil) {
    let maxx = 10000000;
    if sz != nil { maxx = sz.w - PAD; }
    let x = PAD;
    let y = _design_palette_top();
    let i = 0;
    while i < idx {
        let bw = (len(DPAL[i].label) + 2) * CW;
        if x + bw > maxx { x = PAD; y = y + CH + PAD; }
        x = x + bw + PAD;
        i = i + 1;
    }
    let w = (len(DPAL[idx].label) + 2) * CW;
    if x + w > maxx { x = PAD; y = y + CH + PAD; }
    return map{ x: x, y: y, w: w };
}

fn _pal_height(sz) {
    if len(DPAL) == 0 { return CH; }
    let b = _pal_bounds(len(DPAL) - 1, sz);
    return (b.y - TOP) + CH;
}
// palette hit-test → chip id (nil if the click isn't on the palette row).

fn _pal_hit(mx, my, sz) {
    if my < TOP - _hit_slop() or my >= TOP + _pal_height(sz) + _hit_slop() { return nil; }
    let i = 0;
    while i < len(DPAL) {
        let b = _pal_bounds(i, sz);
        if _hit_button(mx, my, b.x, b.y, b.w, CH + SCALE) { return DPAL[i].id; }
        i = i + 1;
    }
    return nil;
}
// rectangle outline (the toolkit only fills rects, so a border is four thin rects).

fn _box(win, x, y, w, h, c) {
    if w <= 0 or h <= 0 { return 0; }
    _draw_rects(win, [
    map{ x: x, y: y, w: w, h: SCALE },
    map{ x: x, y: y + h - SCALE, w: w, h: SCALE },
    map{ x: x, y: y, w: SCALE, h: h },
    map{ x: x + w - SCALE, y: y, w: SCALE, h: h }
    ], c);
    return 0;
}
// which widget property holds its editable label (so typing edits the right field).

fn _w_textkey(w) {
    if w.kind == "textbox" { return "value"; }
    if w.kind == "panel" { return "title"; }
    if w.kind == "slider" { return ""; }
    if w.kind == "select" { return ""; }
    if w.kind == "chart2d" or w.kind == "nditem" or w.kind == "custom" or w.kind == "webcomp" or w.kind == "scan3d" { return "text"; }
    if w.kind == "docpage" or w.kind == "doctext" or w.kind == "docimage" or w.kind == "doctable" or w.kind == "docmedia" { return "text"; }
    if w.kind == "camera" or w.kind == "light" or w.kind == "material" or w.kind == "terrain" or w.kind == "particles" or w.kind == "physics" or w.kind == "prefab" or w.kind == "backend" { return "text"; }
    return "text";
}
// build a new widget of `kind` at (x,y) via the gui.sapp constructors (auto-named).

fn _make_widget(state, kind, x, y) {
    state.design.counter = state.design.counter + 1;
    let n = state.design.counter;
    if kind == "label" { return G.label("lbl" + str(n), x, y, "Label"); }
    if kind == "button" { return G.button("btn" + str(n), x, y, 120, 32, "Button", nil); }
    if kind == "textbox" { return G.textbox("txt" + str(n), x, y, 160, 28, ""); }
    if kind == "checkbox" { return G.checkbox("chk" + str(n), x, y, "Check", false, nil); }
    if kind == "radio" { return G.radio("rad" + str(n), x, y, "Radio", "group1", false, nil); }
    if kind == "select" { return G.select("sel" + str(n), x, y, 160, 28, ["One", "Two", "Three"], 0, nil); }
    if kind == "slider" { return G.slider("sld" + str(n), x, y, 180, 28, 50, 0, 100, nil); }
    if kind == "panel" { return G.panel("pnl" + str(n), x, y, 200, 120, "Panel"); }
    if kind == "docpage" {
        let w = DE.item2d("docpage", "page" + str(n), x, y, 260, 340);
        w.text = "Document page";
        w.component = VE.custom_component(w.name, "page", x, y, w.w, w.h, map{ document_role: "page", export: "docx/pdf/odt" });
        return w;
    }
    if kind == "doctext" {
        let w = DE.item2d("doctext", "rich" + str(n), x, y, 220, 72);
        w.text = "Rich text paragraph";
        w.component = VE.custom_component(w.name, w.text, x, y, w.w, w.h, map{ document_role: "rich_text", editable: true });
        return w;
    }
    if kind == "docimage" {
        let w = DE.item2d("docimage", "image" + str(n), x, y, 180, 120);
        w.text = "Image placeholder";
        w.component = VE.custom_component(w.name, w.text, x, y, w.w, w.h, map{ document_role: "image", source: "drop-or-scan" });
        return w;
    }
    if kind == "doctable" {
        let w = DE.item2d("doctable", "table" + str(n), x, y, 220, 120);
        w.text = "Table 3x3";
        w.component = VE.custom_component(w.name, w.text, x, y, w.w, w.h, map{ document_role: "table", rows: 3, cols: 3 });
        return w;
    }
    if kind == "docmedia" {
        let w = DE.item2d("docmedia", "media" + str(n), x, y, 210, 110);
        w.text = "Audio/video placeholder";
        w.component = VE.custom_component(w.name, w.text, x, y, w.w, w.h, map{ document_role: "media", source: "drop-or-scan" });
        return w;
    }
    if kind == "chart2d" {
        let w = DE.item2d("chart2d", "chart" + str(n), x, y, 200, 120);
        w.text = "Line chart";
        w.component = VE.line_chart(w.name, [[0, 3], [1, 2], [2, 4]], map{ title: w.text });
        return w;
    }
    if kind == "nditem" {
        let w = DE.item2d("nditem", "nd" + str(n), x, y, 180, 90);
        w.text = "N-dimensional item";
        w.component = VE.item_nd(w.name, [1, 2, 3, 4, 5], "pca-preview", map{ label: w.text });
        return w;
    }
    if kind == "custom" {
        let w = DE.item2d("custom", "custom" + str(n), x, y, 180, 90);
        w.text = "Custom component";
        w.component = VE.custom_component(w.name, w.text, x, y, w.w, w.h, map{ source: "native-designer" });
        return w;
    }
    if kind == "webcomp" {
        let w = DE.item2d("webcomp", "web" + str(n), x, y, 220, 110);
        w.text = "HTML/CSS/JS component";
        w.component = VE.web_component(w.name, "<div>component</div>", "", "", x, y, w.w, w.h);
        return w;
    }
    if kind == "scan3d" {
        let w = DE.item3d("scan3d", "scan" + str(n), x, y, 0, 180, 110, 80);
        w.text = "3D scanner asset";
        w.component = VE.scanned_component(w.name, "3d-scan", "scanner://pending", x, y, w.w, w.h, map{ format_hint: "obj/ply/stl/point-cloud" });
        return w;
    }
    if kind == "camera" {
        let w = DE.item3d("camera", "cam" + str(n), x, y, 64, 150, 90, 40);
        w.text = "Camera";
        w.component = VE.camera3d(w.name, x, y, 64, [0, 0, 0]);
        return w;
    }
    if kind == "light" {
        let w = DE.item3d("light", "light" + str(n), x, y, 64, 150, 90, 40);
        w.text = "Directional light";
        w.component = VE.light3d(w.name, "directional", x, y, 64);
        return w;
    }
    if kind == "material" {
        let w = DE.item2d("material", "mat" + str(n), x, y, 170, 88);
        w.text = "PBR material";
        w.component = VE.material(w.name, "pbr-lite", [108, 92, 231, 255], map{ roughness: 0.4 });
        return w;
    }
    if kind == "terrain" {
        let w = DE.item3d("terrain", "terrain" + str(n), x, y, 0, 220, 120, 32);
        w.text = "Terrain";
        w.component = VE.terrain(w.name, 64, 64, []);
        return w;
    }
    if kind == "particles" {
        let w = DE.item3d("particles", "particles" + str(n), x, y, 0, 190, 100, 64);
        w.text = "Particle system";
        w.component = VE.particle_system(w.name, x, y, 0, 128);
        return w;
    }
    if kind == "physics" {
        let w = DE.item2d("physics", "body" + str(n), x, y, 180, 90);
        w.text = "Physics body";
        w.component = VE.physics_body(w.name, "dynamic", "box", 1);
        return w;
    }
    if kind == "prefab" {
        let w = DE.item2d("prefab", "prefab" + str(n), x, y, 190, 100);
        w.text = "Prefab";
        w.component = VE.prefab(w.name, w.text, [], map{ engine_hint: "generic" });
        return w;
    }
    if kind == "backend" {
        let w = DE.item2d("backend", "backend" + str(n), x, y, 190, 90);
        w.text = "Vulkan/OpenGL target";
        w.component = VE.render_backend(w.name, "vulkan", map{ target: "plan-only" });
        return w;
    }
    if kind == "cube3d" {
        let w = DE.item3d("cube", "cube" + str(n), x, y, 12, 72, 72, 72);
        w.text = "Cube";
        return w;
    }
    if kind == "sphere3d" {
        let w = DE.item3d("sphere", "ball" + str(n), x, y, 8, 72, 72, 72);
        w.text = "Ball";
        return w;
    }
    return nil;
}
// topmost placed widget containing (x,y), or -1. Last-added wins (drawn on top).

fn _design_widget_at(state, x, y) {
    return DE.hit_test(state.design.widgets, x, y);
}

fn _draw_cube3d(state, win, w, sel) {
    let off = 10 * SCALE;
    let face = gfx.rgb(79, 70, 229);
    let side = gfx.rgb(49, 46, 129);
    let top = gfx.rgb(99, 102, 241);
    win.rect(w.x + off, w.y, w.w, w.h, top);
    win.rect(w.x, w.y + off, w.w, w.h, face);
    win.rect(w.x + w.w, w.y + off, off, w.h, side);
    _box(win, w.x, w.y + off, w.w, w.h, _style_text(state));
    _box(win, w.x + off, w.y, w.w, w.h, _style_muted(state));
    _dt(win, w.x + PAD, w.y + w.h + off + PAD, w.text, _style_text(state));
    if sel { _box(win, w.x - SCALE, w.y - SCALE, w.w + off + 2 * SCALE, w.h + off + 2 * SCALE, CURSOR); }
}

fn _draw_sphere3d(state, win, w, sel) {
    let r = w.w / 2;
    let steps = 6;
    let i = 0;
    while i < steps {
        let inset = i * SCALE * 3;
        let shade = gfx.rgb(46 + i * 12, 224 - i * 18, 189 - i * 12);
        win.rect(w.x + inset, w.y + inset, w.w - inset * 2, w.h - inset * 2, shade);
        i = i + 1;
    }
    _box(win, w.x, w.y, w.w, w.h, _style_muted(state));
    _dt(win, w.x + PAD, w.y + w.h + PAD, w.text, _style_text(state));
    if sel { _box(win, w.x - SCALE, w.y - SCALE, w.w + 2 * SCALE, w.h + 2 * SCALE, CURSOR); }
}
// Badge-card Designer widgets: caption + subtitle on the shared card chrome. This
// is a stable table, not a per-widget allocation during every Designer repaint.
let BADGE_CARD_SPECS = map{
    docmedia:  map{ caption: "MEDIA",         sub: "audio/video player",      sub_style: "text", accent_line: true },
    webcomp:   map{ caption: "WEB component", sub: "HTML/CSS/JS metadata",    sub_style: "muted" },
    scan3d:    map{ caption: "SCAN 3D",       sub: "obj/ply/stl/point cloud", sub_style: "muted" },
    camera:    map{ caption: "CAMERA",        sub: "fov 60  perspective",     sub_style: "muted" },
    light:     map{ caption: "LIGHT",         sub: "directional / point",     sub_style: "muted" },
    material:  map{ caption: "MATERIAL",      sub: "pbr-lite roughness",      sub_style: "muted" },
    terrain:   map{ caption: "TERRAIN",       sub: "heightfield / LOD",       sub_style: "muted" },
    particles: map{ caption: "PARTICLES",     sub: "emitter rate lifetime",   sub_style: "muted" },
    physics:   map{ caption: "PHYSICS",       sub: "body collider mass",      sub_style: "muted" },
    prefab:    map{ caption: "PREFAB",        sub: "entity/component asset",  sub_style: "muted" },
    backend:   map{ caption: "VK/GL TARGET",  sub: "plan-only renderer",      sub_style: "muted" },
    // body:"slice_text" -> the subtitle is the widget's own text, clipped to width
    doctext:   map{ caption: "RICH TEXT",     sub: "", body: "slice_text" },
    custom:    map{ caption: "CUSTOM",        sub: "", body: "slice_text" },
};

fn _badge_card_specs() { return BADGE_CARD_SPECS; }

fn _designer_chart_bar_rects(w) {
    return [
    map{ x: w.x + 3 * PAD, y: w.y + w.h - 5 * CH, w: SCALE, h: 3 * CH },
    map{ x: w.x + 8 * PAD, y: w.y + w.h - 7 * CH, w: SCALE, h: 5 * CH },
    map{ x: w.x + 13 * PAD, y: w.y + w.h - 6 * CH, w: SCALE, h: 4 * CH }
    ];
}

fn _designer_docpage_line_rects(w, shrink) {
    return [map{ x: w.x + 2 * PAD, y: w.y + shrink, w: w.w - 4 * PAD, h: SCALE }];
}

fn _designer_table_grid_rects(w) {
    let rs = [];
    let tx = w.x + PAD;
    while tx < w.x + w.w - PAD {
        array_push(rs, map{ x: tx, y: w.y + 3 * CH, w: SCALE, h: w.h - 4 * CH });
        tx = tx + (w.w - 2 * PAD) / 3;
    }
    let ty = w.y + 3 * CH;
    while ty < w.y + w.h - PAD {
        array_push(rs, map{ x: w.x + PAD, y: ty, w: w.w - 2 * PAD, h: SCALE });
        ty = ty + CH * 2;
    }
    return rs;
}

fn _draw_dwidget(state, win, w, sel) {
    let k = w.kind;
    let bd = _style_muted(state);
    if sel { bd = CURSOR; }
    let text = _style_text(state);
    let muted = _style_muted(state);
    let accent = _style_accent(state);
    let panel = _style_panel(state);
    let card = _style_surface2(state);
    let badge = _design_badge_color(state, k);
    let specs = _badge_card_specs();
    if map_has(specs, k) {
        let sp = specs[k];
        win.rect(w.x, w.y, w.w, w.h, card);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, sp.caption, badge);
        let subtext = sp.sub;
        let subc = muted;
        if sp.sub_style == "text" { subc = text; }
        if (try sp.body catch "") == "slice_text" {
            subtext = str_slice(w.text, 0, (w.w - 2 * PAD) / CW);
            subc = text;
        }
        _dt(win, w.x + PAD, w.y + 3 * CH, subtext, subc);
        if (try sp.accent_line catch false) { win.rect(w.x + PAD, w.y + w.h - 2 * CH, w.w - 2 * PAD, SCALE, accent); }
        return 0;
    }
    if k == "cube" {
        _draw_cube3d(state, win, w, sel);
    } else if k == "sphere" {
        _draw_sphere3d(state, win, w, sel);
    } else if k == "panel" {
        win.rect(w.x, w.y, w.w, w.h, _style_hilite(state));
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, w.title, text);
    } else if k == "button" {
        win.rect(w.x, w.y, w.w, w.h, accent);
        _dt(win, w.x + (w.w - len(w.text) * CW) / 2, w.y + (w.h - 7 * SCALE) / 2, w.text, text);
        if sel { _box(win, w.x, w.y, w.w, w.h, CURSOR); }
    } else if k == "textbox" {
        win.rect(w.x, w.y, w.w, w.h, panel);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + (w.h - 7 * SCALE) / 2, w.value, text);
    } else if k == "checkbox" {
        let bs = 5 * SCALE;
        _box(win, w.x, w.y + (CH - bs) / 2, bs, bs, bd);
        if w.checked { win.rect(w.x + SCALE, w.y + (CH - bs) / 2 + SCALE, bs - 2 * SCALE, bs - 2 * SCALE, accent); }
        _dt(win, w.x + bs + PAD, w.y, w.text, text);
    } else if k == "radio" {
        let bs = 5 * SCALE;
        _box(win, w.x, w.y + (CH - bs) / 2, bs, bs, bd);
        if w.selected { win.rect(w.x + 2 * SCALE, w.y + (CH - bs) / 2 + 2 * SCALE, bs - 4 * SCALE, bs - 4 * SCALE, accent); }
        _dt(win, w.x + bs + PAD, w.y, w.text, text);
    } else if k == "select" {
        win.rect(w.x, w.y, w.w, w.h, panel);
        _box(win, w.x, w.y, w.w, w.h, bd);
        let opt = "";
        if len(w.options) > 0 and w.selected >= 0 and w.selected < len(w.options) { opt = w.options[w.selected]; }
        _dt(win, w.x + PAD, w.y + (w.h - 7 * SCALE) / 2, opt + " v", text);
    } else if k == "slider" {
        let cy = w.y + w.h / 2;
        win.rect(w.x, cy, w.w, SCALE, bd);
        let span = w.max - w.min; if span == 0 { span = 1; }
        let t = (w.value - w.min) / span;
        if t < 0 { t = 0; } if t > 1 { t = 1; }
        let kx = w.x + t * w.w;
        win.rect(kx - 2 * SCALE, w.y + 2 * SCALE, 4 * SCALE, w.h - 4 * SCALE, accent);
    } else if k == "chart2d" {
        win.rect(w.x, w.y, w.w, w.h, _style_row_rule(state));
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, w.text, text);
        win.rect(w.x + 2 * PAD, w.y + w.h - 4 * CH, w.w - 4 * PAD, SCALE, muted);
        _draw_rects(win, _designer_chart_bar_rects(w), accent);
    } else if k == "docpage" {
        win.rect(w.x, w.y, w.w, w.h, gfx.rgb(250, 250, 248));
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, "PAGE", gfx.rgb(30, 36, 52));
        _draw_rects(win, _designer_docpage_line_rects(w, 4 * CH), gfx.rgb(200, 205, 216));
        _draw_rects(win, [
        map{ x: w.x + 2 * PAD, y: w.y + 6 * CH, w: w.w - 8 * PAD, h: SCALE },
        map{ x: w.x + 2 * PAD, y: w.y + 8 * CH, w: w.w - 6 * PAD, h: SCALE }
        ], gfx.rgb(210, 215, 226));
    } else if k == "docimage" {
        win.rect(w.x, w.y, w.w, w.h, card);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _box(win, w.x + PAD, w.y + 2 * CH, w.w - 2 * PAD, w.h - 3 * CH, muted);
        _dt(win, w.x + PAD, w.y + PAD, "IMAGE", badge);
        _dt(win, w.x + PAD, w.y + w.h - CH, "drop/scan asset", muted);
    } else if k == "doctable" {
        win.rect(w.x, w.y, w.w, w.h, card);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, "TABLE", badge);
        _draw_rects(win, _designer_table_grid_rects(w), muted);
    } else if k == "nditem" {
        win.rect(w.x, w.y, w.w, w.h, card);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, "ND", badge);
        _dt(win, w.x + 5 * CW, w.y + PAD, w.text, text);
        _dt(win, w.x + PAD, w.y + 3 * CH, "dims: 5  projection: pca", muted);
    } else if k == "label" {
        _dt(win, w.x, w.y, w.text, text);
        if sel { _box(win, w.x, w.y, w.w, w.h, CURSOR); }
    }
}

fn _draw_design(state, win, sz) {
    _draw_design_tabs(state, win, sz);
    let d = state.design;
    let layout = try d.layout catch "free";
    let target = try d.target catch "gui";
    // palette row
    let i = 0;
    while i < len(DPAL) {
        let b = _pal_bounds(i, sz);
        let on = ((not DPAL[i].act) and DPAL[i].id == d.tool) or (DPAL[i].id == "layout" and layout != "free") or DPAL[i].id == "apptype";
        let bg = _style_panel(state);
        if DPAL[i].act { bg = _design_palette_action_bg(state); } else if on { bg = _style_accent(state); }
        if DPAL[i].id == "layout" and layout != "free" { bg = gfx.rgb(0, 184, 148); }
        if DPAL[i].id == "apptype" { bg = _design_palette_app_bg(state); }
        let fg = _style_muted(state); if on { fg = _style_text(state); }
        let label = DPAL[i].label;
        if DPAL[i].id == "apptype" { label = "APP:" + target; }
        _button_label(state, win, b.x, b.y, b.w, CH + SCALE, label, fg, bg, on);
        i = i + 1;
    }
    // canvas with a faint dot grid
    let canvTop = TOP + _pal_height(sz) + PAD;
    let inspectH = CH * 7 + 2 * PAD;
    let canvBot = sz.h - inspectH;
    win.rect(0, canvTop, sz.w, canvBot - canvTop, _design_canvas_bg(state));
    let grid_rs = _design_grid_rects(sz.w, canvTop, canvBot);
    _draw_rects(win, grid_rs, _design_grid_dot(state));
    if layout != "free" {
        _dt(win, PAD, canvTop + PAD, "responsive layout: " + layout + "  (LAYOUT cycles free/grid/stack)", _style_text(state));
    }
    _dt(win, PAD, canvTop + CH + PAD,
    "app target: " + target + "  (APP cycles gui/modern/android/web/both/doc)",
    _style_muted(state));
    // placed widgets
    let wi = 0;
    while wi < len(d.widgets) { _draw_dwidget(state, win, d.widgets[wi], wi == d.sel); wi = wi + 1; }
    // property inspector + reusable component library
    let iy = sz.h - inspectH;
    win.rect(0, iy, sz.w, inspectH, _style_panel(state));
    win.rect(0, iy, sz.w, SCALE, _style_accent(state));
    let info = IDE.designer_status(d);
    if d.sel >= 0 {
        info = info + " · Tab select · Insert dup · Ctrl+[] layer";
    }
    _dt(win, PAD, iy + 2 * SCALE, str_slice(info, 0, (sz.w - 2 * PAD) / CW), _style_text(state));
    let leftW = sz.w / 2 - PAD * 2;
    let rightX = sz.w / 2 + PAD;
    _dt(win, PAD, iy + CH + PAD, "Inspector", _style_accent(state));
    let fields = IDE.designer_property_fields(nil);
    if d.sel >= 0 and d.sel < len(d.widgets) { fields = IDE.designer_property_fields(d.widgets[d.sel]); }
    let fi = 0;
    while fi < len(fields) and fi < 5 {
        let f = fields[fi];
        let line = str(try f.name catch "?") + ": " + str(try f.value catch "");
        _dt(win, PAD, iy + (fi + 2) * CH + PAD, str_slice(line, 0, leftW / CW), _style_muted(state));
        fi = fi + 1;
    }
    _dt(win, rightX, iy + CH + PAD, "Components", _style_accent(state));
    let compLines = IDE.designer_component_lines(IDE.filter_designer_components(try d.tool catch "", 4), 4);
    let ci = 0;
    while ci < len(compLines) and ci < 4 {
        _dt(win, rightX, iy + (ci + 2) * CH + PAD, str_slice(compLines[ci], 0, (sz.w - rightX - PAD) / CW), _style_muted(state));
        ci = ci + 1;
    }
}
// codegen: placed widgets → runnable stdlib/gui.sapp source.

fn _q(s) {
    let out = str(s);
    out = str_replace_all(out, "\\", "\\\\");
    out = str_replace_all(out, "\"", "\\\"");
    out = str_replace_all(out, strfromcharcode(13), "\\n");
    out = str_replace_all(out, strfromcharcode(10), "\\n");
    return "\"" + out + "\"";
}

fn _arr_strings(xs) {
    let s = "[";
    let i = 0;
    while i < len(xs) {
        if i > 0 { s = s + ", "; }
        s = s + _q(xs[i]);
        i = i + 1;
    }
    return s + "]";
}

fn _w_ctor(w) {
    let k = w.kind;
    let h = _q(w.name) + ", " + str(w.x) + ", " + str(w.y);
    if k == "label" { return "gui.label(" + h + ", " + _q(w.text) + ")"; }
    if k == "button" { return "gui.button(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.text) + ", nil)"; }
    if k == "textbox" { return "gui.textbox(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.value) + ")"; }
    if k == "checkbox" { return "gui.checkbox(" + h + ", " + _q(w.text) + ", " + str(try w.checked catch false) + ", nil)"; }
    if k == "radio" { return "gui.radio(" + h + ", " + _q(w.text) + ", " + _q(try w.group catch "group1") + ", " + str(try w.selected catch false) + ", nil)"; }
    if k == "select" { return "gui.select(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _arr_strings(try w.options catch []) + ", " + str(try w.selected catch 0) + ", nil)"; }
    if k == "slider" { return "gui.slider(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + str(try w.value catch 0) + ", " + str(try w.min catch 0) + ", " + str(try w.max catch 100) + ", nil)"; }
    if k == "panel" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.title) + ")"; }
    if k == "chart2d" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("CHART: " + str(try w.text catch w.name)) + ")"; }
    if k == "docpage" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("DOCUMENT PAGE: " + str(try w.text catch w.name)) + ")"; }
    if k == "doctext" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("RICH TEXT: " + str(try w.text catch w.name)) + ")"; }
    if k == "docimage" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("IMAGE PLACEHOLDER: " + str(try w.text catch w.name)) + ")"; }
    if k == "doctable" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("TABLE PLACEHOLDER: " + str(try w.text catch w.name)) + ")"; }
    if k == "docmedia" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("MEDIA PLACEHOLDER: " + str(try w.text catch w.name)) + ")"; }
    if k == "nditem" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("ND ITEM: " + str(try w.text catch w.name)) + ")"; }
    if k == "custom" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("CUSTOM COMPONENT: " + str(try w.text catch w.name)) + ")"; }
    if k == "webcomp" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("WEB COMPONENT metadata: " + str(try w.text catch w.name)) + ")"; }
    if k == "scan3d" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("SCANNER ASSET placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "camera" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("CAMERA placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "light" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("LIGHT placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "material" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("MATERIAL placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "terrain" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("TERRAIN placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "particles" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("PARTICLES placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "physics" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("PHYSICS placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "prefab" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("PREFAB placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "backend" { return "gui.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q("RENDER BACKEND placeholder: " + str(try w.text catch w.name)) + ")"; }
    if k == "cube" { return "gui.cube3d(" + h + ", " + str(w.w + 12 * SCALE) + ", " + str(w.h + 24 * SCALE) + ", " + _q(str(try w.text catch w.name)) + ")"; }
    if k == "sphere" { return "gui.sphere3d(" + h + ", " + str(w.w + 12 * SCALE) + ", " + str(w.h + 24 * SCALE) + ", " + _q(str(try w.text catch w.name)) + ")"; }
    return "nil";
}

fn _w_bound_ctor(w) {
    let ctor = _w_ctor(w);
    let binding = str(try w.bind catch "");
    if binding != "" { return "gui.bind(" + ctor + ", " + _q(binding) + ")"; }
    return ctor;
}

fn _w_preview_line(w) {
    let k = str(try w.kind catch "?");
    let label = str(try w.text catch try w.title catch try w.name catch "?");
    let prefix = "widget";
    if k == "cube" or k == "sphere" or k == "scan3d" or k == "camera" or k == "light" or k == "terrain" or k == "particles" {
        prefix = "3d";
    } else if k == "chart2d" {
        prefix = "2d";
    } else if k == "docpage" or k == "doctext" or k == "docimage" or k == "doctable" or k == "docmedia" {
        prefix = "doc";
    } else if k == "nditem" {
        prefix = "nd";
    }
    return prefix + ": " + k + " " + str(try w.name catch "?") + " @ " + str(try w.x catch 0) + "," + str(try w.y catch 0) + " " + label;
}

fn _modern_options(w) {
    return "map{ name: " + _q(str(try w.name catch "widget")) + " }";
}

fn _modern_ctor(w) {
    let k = str(try w.kind catch "");
    let options = _modern_options(w);
    if k == "label" {
        return "ui.text(" + _q(str(try w.text catch "Label")) + ", " + options + ")";
    }
    if k == "button" {
        return "ui.button(" + _q(str(try w.text catch "Button"))
        + ", ui.action_message(" + _q(str(try w.text catch "Button") + " pressed")
        + "), " + options + ")";
    }
    if k == "textbox" {
        return "ui.input(" + _q(str(try w.value catch "")) + ", " + options + ")";
    }
    if k == "checkbox" {
        return "ui.toggle(" + _q(str(try w.text catch "Check")) + ", "
        + str(try w.checked catch false) + ", nil, " + options + ")";
    }
    if k == "radio" {
        return "ui.choice([" + _q(str(try w.text catch "Radio"))
        + "], 0, nil, " + options + ")";
    }
    if k == "select" {
        return "ui.choice(" + _arr_strings(try w.options catch []) + ", "
        + str(try w.selected catch 0) + ", nil, " + options + ")";
    }
    if k == "slider" {
        return "ui.slider(" + str(try w.value catch 0) + ", "
        + str(try w.min catch 0) + ", " + str(try w.max catch 100)
        + ", nil, " + options + ")";
    }
    if k == "panel" {
        return "ui.card([ui.heading(" + _q(str(try w.title catch "Panel"))
        + ")], map{ name: " + _q(str(try w.name catch "panel"))
        + ", title: " + _q(str(try w.title catch "Panel")) + " })";
    }
    if k == "docimage" {
        return "ui.image(nil, map{ name: " + _q(str(try w.name catch "image"))
        + ", accessibility_label: " + _q(str(try w.text catch "Image")) + " })";
    }
    let label = str(try w.text catch try w.title catch try w.name catch "Component");
    return "ui.card([ui.text(" + _q(label) + ")], map{ name: "
    + _q(str(try w.name catch "component")) + ", title: " + _q(k) + " })";
}

fn _design_modern_code(state, target) {
    let layout = str(try state.design.layout catch "responsive");
    let container = if layout == "grid" { "grid" } else { "column" };
    let s = "// generated by pblang native IDE Designer - modern target: " + target + "
    let app = import(\"stdlib/app.sapp\");
    let ui = import(\"stdlib/modern_ui.sapp\");

    fn view() {
    return ui.screen([
    ui." + container + "([
    ";
    let i = 0;
    while i < len(state.design.widgets) {
        s = s + "            " + _modern_ctor(state.design.widgets[i]);
        if i + 1 < len(state.design.widgets) { s = s + ","; }
        s = s + "
        ";
        i = i + 1;
    }
    let container_options = "map{ gap: 12, responsive: true }";
    if container == "grid" {
        container_options = "map{ columns: 2, gap: 12, responsive: true }";
    }
    s = s + "        ], " + container_options + ")
    ], map{ padding: 16, gap: 12 });
}

    fn preview() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"desktop\", operation: \"preview\",
    width: 900, height: 640, theme: \"dark\"
});
}

    fn run_gui() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"desktop\", operation: \"run\",
    width: 900, height: 640, theme: \"dark\"
});
}

    fn build_android() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"android\", operation: \"build\",
    package: \"org.pblang.designedapp\",
    min_sdk: 21,
    target_sdk: 34,
    theme: \"dark\",
    width: 412,
    height: 915,
    output: \"release/Designed-UI-debug.apk\"
});
}

    fn preview_web() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"web\", operation: \"preview\",
    host: \"127.0.0.1\",
    port: 8080,
    theme: \"dark\",
    width: 900,
    height: 640
});
}

    fn run_web() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"web\", operation: \"run\",
    host: \"127.0.0.1\",
    port: 8080,
    theme: \"dark\",
    width: 900,
    height: 640
});
}

    fn export_web() {
    return app.surface(\"Designed UI\", view(), map{
    mode: \"web\", operation: \"export\",
    output: \"release/designed-ui-web\",
    theme: \"dark\",
    width: 900,
    height: 640
});
}

    fn main() {
    ";
    if target == "android" {
        s = s + "    let result = build_android();
        if not result.ok { throw \"Android build failed: \" + result.error; }
        print \"apk=\" + result.output;
        print \"sha256=\" + result.sha256;
        ";
    } else if target == "web" {
        s = s + "    let result = preview_web();
        if result.response.status != 200 { throw \"Web preview failed\"; }
        print \"web bytes=\" + str(len(result.response.body));
        ";
    } else {
        s = s + "    let result = preview();
        print \"modern widgets=\" + str(result.widgets);
        ";
    }
    return s + "}
    main();
    ";
}

fn _design_code(state) {
    let target = try state.design.target catch "gui";
    if target == "modern" or target == "android" or target == "web" {
        return _design_modern_code(state, target);
    }
    let formw = try state.design.form_width catch 800;
    let formh = try state.design.form_height catch 600;
    if formw < 64 or formw > 16384 { formw = 800; }
    if formh < 64 or formh > 16384 { formh = 600; }
    let bi = 0;
    while bi < len(state.design.widgets) {
        let bw = state.design.widgets[bi];
        let rx = (try bw.x catch 0) + (try bw.w catch 80) + 80;
        let by = (try bw.y catch 0) + (try bw.h catch 40) + 100;
        if rx > formw { formw = rx; }
        if by > formh { formh = by; }
        bi = bi + 1;
    }
    let s = "// generated by pblang native IDE Designer - app target: " + target + "
    let gui = import(\"stdlib/gui.sapp\");

    fn app_target() {
    return " + _q(target) + ";
}

    fn build() {
    let form = gui.form(" + _q(str(try state.design.form_title catch "Designed UI")) + ", " + str(formw) + ", " + str(formh) + ");
    ";
    let i = 0;
    let preview = [];
    while i < len(state.design.widgets) {
        let w = state.design.widgets[i];
        s = s + "    gui.add(form, " + _w_bound_ctor(w) + ");
        ";
        push(preview, _w_preview_line(w));
        i = i + 1;
    }
    s = s + "    gui.fit_form(form, 800, 600, 80);
    return form;
}

    fn preview() {
    print \"Designer app target: \" + app_target();
    print \"Designer preview: \" + str(" + str(len(state.design.widgets)) + ") + \" item(s)\";
    ";
    i = 0;
    while i < len(preview) {
        s = s + "    print " + _q(preview[i]) + ";
        ";
        i = i + 1;
    }
    if target == "web" {
        s = s + "    print \"Web target is stored as safe metadata; browser/html export is planned separately.\";
        ";
    } else if target == "both" {
        s = s + "    print \"Both target keeps GUI runnable now and carries web metadata for export.\";
        ";
    } else if target == "doc" {
        let docplan = IDE.designer_document_plan(state.design);
        let pi = 0;
        while pi < len(docplan) {
            s = s + "    print " + _q(docplan[pi]) + ";
            ";
            pi = pi + 1;
        }
        s = s + "    print \"Document export engines attach here: txt/doc/docx/odt/rtf/pdf/ppt/pptx/xls/xlsx/csv.\";
        ";
    }
    s = s + "    print \"To open the real GUI window, call run_gui() from this file.\";
}

    fn run_gui() {
    gui.run(build());
}

    fn main() {
    preview();
}
    main();
    ";
    return s;
}

fn _app_target_next(mode) {
    if mode == "gui" { return "modern"; }
    if mode == "modern" { return "android"; }
    if mode == "android" { return "web"; }
    if mode == "web" { return "both"; }
    if mode == "both" { return "doc"; }
    return "gui";
}

fn _layout_next(mode) {
    if mode == "free" { return "responsive"; }
    if mode == "responsive" { return "grid"; }
    if mode == "grid" { return "stack-y"; }
    return "free";
}

fn _design_apply_layout(state) {
    let mode = try state.design.layout catch "free";
    if mode == "free" { return 0; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    let contentTop = top + 2 * CH + PAD;
    let bottom = state.winsz.h - (CH + PAD);
    let vp = DE.viewport(state.winsz.w, bottom - contentTop);
    let i = 0;
    while i < len(state.design.widgets) {
        if state.design.widgets[i].y >= contentTop { state.design.widgets[i].y = state.design.widgets[i].y - contentTop; }
        i = i + 1;
    }
    DE.apply_layout(state.design.widgets, vp, mode);
    i = 0;
    while i < len(state.design.widgets) {
        state.design.widgets[i].y = state.design.widgets[i].y + contentTop + PAD;
        _design_snap_widget(state, state.design.widgets[i], true);
        _design_clamp_widget(state, state.design.widgets[i]);
        i = i + 1;
    }
    return 0;
}

fn _design_content_top(state) {
    if state.winsz == nil { return TOP + CH + PAD; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    return top + 2 * CH + PAD;
}

fn _design_snap_widget(state, w, include_size) {
    if state.winsz == nil { return 0; }
    let ox = PAD;
    let oy = _design_content_top(state) + PAD;
    w.x = ox + DE.snap_value((try w.x catch ox) - ox, DESIGN_GRID);
    w.y = oy + DE.snap_value((try w.y catch oy) - oy, DESIGN_GRID);
    if include_size {
        let minw = _design_min_w(w);
        let minh = _design_min_h(w);
        w.w = DE.snap_value(try w.w catch minw, DESIGN_GRID);
        w.h = DE.snap_value(try w.h catch minh, DESIGN_GRID);
        if w.w < minw { w.w = minw; }
        if w.h < minh { w.h = minh; }
    }
    return 0;
}

fn _design_min_w(w) {
    let k = str(try w.kind catch "");
    if k == "label" { return 4 * CW; }
    if k == "checkbox" or k == "radio" { return 8 * CW; }
    if k == "slider" { return 10 * CW; }
    if k == "cube" or k == "sphere" { return 8 * CW; }
    if k == "chart2d" or k == "nditem" { return 10 * CW; }
    if k == "camera" or k == "light" or k == "material" or k == "terrain" or k == "particles" or k == "physics" or k == "prefab" or k == "backend" { return 12 * CW; }
    return 6 * CW;
}

fn _design_min_h(w) {
    let k = str(try w.kind catch "");
    if k == "label" or k == "checkbox" or k == "radio" { return CH; }
    if k == "cube" or k == "sphere" { return 6 * CH; }
    if k == "chart2d" or k == "nditem" { return 4 * CH; }
    if k == "camera" or k == "light" or k == "material" or k == "terrain" or k == "particles" or k == "physics" or k == "prefab" or k == "backend" { return 4 * CH; }
    return CH + PAD;
}

fn _design_clamp_widget(state, w) {
    if state.winsz == nil { return 0; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    let contentTop = _design_content_top(state);
    let bottom = state.winsz.h - (CH + PAD);
    let maxx = state.winsz.w - (try w.w catch 24) - PAD;
    let maxy = bottom - (try w.h catch 18) - PAD;
    if maxx < PAD { maxx = PAD; }
    if maxy < contentTop + PAD { maxy = contentTop + PAD; }
    if w.x < PAD { w.x = PAD; }
    if w.y < contentTop + PAD { w.y = contentTop + PAD; }
    if w.x > maxx { w.x = maxx; }
    if w.y > maxy { w.y = maxy; }
    return 0;
}

fn _design_refresh_widget(w) {
    if w.kind == "custom" and (try w.component catch nil) != nil { w.component.name = w.text; }
    else if w.kind == "prefab" and (try w.component catch nil) != nil { w.component.name = w.text; }
    if try w.manual_size catch false { return 0; }
    if w.kind == "label" { w.w = len(w.text) * CW; if w.w < CW { w.w = CW; } w.h = CH; }
    else if w.kind == "checkbox" { w.w = 5 * SCALE + PAD + len(w.text) * CW; w.h = CH; }
    else if w.kind == "radio" { w.w = 5 * SCALE + PAD + len(w.text) * CW; w.h = CH; }
    return 0;
}

fn _design_resize_selected(state, dw, dh) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = d.widgets[d.sel];
    w.w = (try w.w catch 80) + dw;
    w.h = (try w.h catch 28) + dh;
    let minw = _design_min_w(w);
    let minh = _design_min_h(w);
    if w.w < minw { w.w = minw; }
    if w.h < minh { w.h = minh; }
    w.manual_size = true;
    _design_snap_widget(state, w, true);
    _design_clamp_widget(state, w);
    state.output = "designer resized " + str(try w.name catch "?") + " to " + str(w.w) + "x" + str(w.h) + " (snap " + str(DESIGN_GRID) + ")";
    return 0;
}

fn _design_move_selected(state, dx, dy) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = d.widgets[d.sel];
    w.x = (try w.x catch PAD) + dx;
    w.y = (try w.y catch PAD) + dy;
    _design_snap_widget(state, w, false);
    _design_clamp_widget(state, w);
    state.output = "designer moved " + str(try w.name catch "?") + " to " + str(w.x) + "," + str(w.y) + " (snap " + str(DESIGN_GRID) + ")";
    return 0;
}

fn _design_copy_value(v) {
    if type(v) == "array" {
        let out = [];
        let i = 0;
        while i < len(v) { push(out, _design_copy_value(v[i])); i = i + 1; }
        return out;
    }
    if type(v) == "map" {
        let out = map{};
        let ks = map_keys(v);
        let i = 0;
        while i < len(ks) {
            out[ks[i]] = _design_copy_value(v[ks[i]]);
            i = i + 1;
        }
        return out;
    }
    return v;
}

fn _design_blank(path) {
    return map{
        tool: "button",
        target: "gui",
        layout: "free",
        widgets: [],
        sel: 0 - 1,
        drag: false,
        dx: 0,
        dy: 0,
        counter: 0,
        form_title: "Designed UI",
        form_width: 800,
        form_height: 600,
        model: map{},
        path: str(try path catch ""),
        title: _file_tab_title(str(try path catch ""))
    };
}

fn _design_tab_record(path, design) {
    let d = design;
    if d == nil { d = _design_blank(path); }
    d.path = str(try path catch try d.path catch "");
    d.title = _file_tab_title(str(try d.path catch ""));
    d.drag = false;
    d.dx = 0;
    d.dy = 0;
    return map{
        title: str(try d.title catch _file_tab_title(path)),
        path: str(try d.path catch path),
        design: _design_copy_value(d),
        dirty: len(try d.widgets catch []) > 0,
        kind: IDE.designer_screen_kind(str(try d.path catch path))
    };
}

fn _design_tabs_store_current(state) {
    let tabs = try state.design_tabs catch [];
    if tabs == nil or len(tabs) == 0 { return 0; }
    let sel = try state.design_tab_sel catch 0;
    if sel < 0 { sel = 0; }
    if sel >= len(tabs) { sel = len(tabs) - 1; }
    let p = str(try tabs[sel].path catch try state.design.path catch try state.path catch "");
    tabs[sel] = _design_tab_record(p, state.design);
    state.design_tabs = tabs;
    state.design_tab_sel = sel;
    return 0;
}

fn _design_tabs_ensure(state) {
    let candidates = IDE.designer_screen_tabs_from_files(try state.project_files catch [], try state.path catch "");
    let tabs = try state.design_tabs catch [];
    if tabs == nil { tabs = []; }
    if len(tabs) == 0 {
        let i = 0;
        while i < len(candidates) {
            let c = candidates[i];
            let p = str(try c.path catch "");
            let d = _design_blank(p);
            if i == 0 {
                d = _design_copy_value(state.design);
                d.path = p;
                d.title = _file_tab_title(p);
            }
            array_push(tabs, _design_tab_record(p, d));
            i = i + 1;
        }
        state.design_tabs = tabs;
        state.design_tab_sel = 0;
        if len(tabs) > 0 { state.design = _design_copy_value(tabs[0].design); }
        return 0;
    }
    _design_tabs_store_current(state);
    tabs = state.design_tabs;
    let ci = 0;
    while ci < len(candidates) {
        let p = str(try candidates[ci].path catch "");
        let found = false;
        let ti = 0;
        while ti < len(tabs) {
            if str(try tabs[ti].path catch "") == p { found = true; }
            ti = ti + 1;
        }
        if not found { array_push(tabs, _design_tab_record(p, _design_blank(p))); }
        ci = ci + 1;
    }
    state.design_tabs = tabs;
    let sel = try state.design_tab_sel catch 0;
    if sel < 0 { sel = 0; }
    if sel >= len(tabs) { sel = len(tabs) - 1; }
    state.design_tab_sel = sel;
    return 0;
}

fn _design_tabs_reset_for_project(state) {
    let current = _design_copy_value(state.design);
    let candidates = IDE.designer_screen_tabs_from_files(try state.project_files catch [], try state.path catch "");
    let preferred = str(try current.path catch "");
    let runp = str(try state.example_run_path catch "");
    if len(try current.widgets catch []) > 0 and runp != "" { preferred = runp; }
    if preferred == "" { preferred = str(try state.path catch ""); }
    let tabs = [];
    let selected = 0;
    let used_current = false;
    let i = 0;
    while i < len(candidates) {
        let p = str(try candidates[i].path catch "");
        let d = _design_blank(p);
        if p == preferred {
            d = current;
            d.path = p;
            d.title = _file_tab_title(p);
            selected = len(tabs);
            used_current = true;
        }
        array_push(tabs, _design_tab_record(p, d));
        i = i + 1;
    }
    if len(tabs) == 0 { array_push(tabs, _design_tab_record(str(try state.path catch ""), current)); }
    if not used_current and len(tabs) > 0 {
        current.path = str(try tabs[0].path catch try state.path catch "");
        current.title = _file_tab_title(current.path);
        tabs[0] = _design_tab_record(current.path, current);
        selected = 0;
    }
    state.design_tabs = tabs;
    if selected < 0 or selected >= len(tabs) { selected = 0; }
    state.design_tab_sel = selected;
    state.design_tab_scroll = 0;
    state.design_tab_layout = [];
    state.design = _design_copy_value(tabs[selected].design);
    return 0;
}

fn _design_tabs_activate(state, idx) {
    _design_tabs_ensure(state);
    let tabs = try state.design_tabs catch [];
    if tabs == nil or idx < 0 or idx >= len(tabs) { return false; }
    _design_tabs_store_current(state);
    tabs = state.design_tabs;
    state.design = _design_copy_value(tabs[idx].design);
    state.design.drag = false;
    state.design_tab_sel = idx;
    state.panel = "design";
    state.output = "designer tab: " + str(try tabs[idx].title catch _file_tab_title(try tabs[idx].path catch "")) + " (" + str(idx + 1) + "/" + str(len(tabs)) + ")";
    return true;
}

fn _design_tabs_focus_path(state, path) {
    let p = str(try path catch "");
    if p == "" { return false; }
    _design_tabs_ensure(state);
    let tabs = try state.design_tabs catch [];
    let i = 0;
    while tabs != nil and i < len(tabs) {
        if str(try tabs[i].path catch "") == p { return _design_tabs_activate(state, i); }
        i = i + 1;
    }
    return false;
}

fn _design_tab_step(state, delta) {
    _design_tabs_ensure(state);
    let tabs = try state.design_tabs catch [];
    let n = len(try tabs catch []);
    if n <= 1 { state.output = "designer tabs: " + str(n) + " screen"; return 0; }
    let sel = try state.design_tab_sel catch 0;
    sel = num_mod(sel + delta + n, n);
    _design_tabs_activate(state, sel);
    return 0;
}

fn _draw_design_tabs(state, win, sz) {
    _design_tabs_ensure(state);
    let tabs = try state.design_tabs catch [];
    let h = _design_tabs_height();
    win.rect(0, TOP, sz.w, h, _style_bg(state));
    win.rect(0, TOP + h - SCALE, sz.w, SCALE, _style_border(state));
    let x = PAD;
    let maxX = sz.w - PAD;
    let layout = [];
    let i = try state.design_tab_scroll catch 0;
    if i < 0 { i = 0; }
    while i < len(tabs) and x < maxX - 8 * CW {
        let tab = tabs[i];
        let title = str(try tab.title catch _file_tab_title(try tab.path catch ""));
        if try tab.dirty catch false { title = "* " + title; }
        let tw = len(title) * CW + 3 * PAD;
        let minW = 12 * CW;
        let maxW = 26 * CW;
        if tw < minW { tw = minW; }
        if tw > maxW { tw = maxW; }
        if x + tw > maxX { break; }
        let active = i == (try state.design_tab_sel catch 0);
        let fill = _style_surface(state);
        let txt = _style_muted(state);
        if active { fill = _style_panel(state); txt = _style_text(state); }
        _button_face(state, win, x, TOP + PAD / 2, tw, CH + PAD / 2, fill, active);
        if active { _fill_round(win, x + PAD / 2, TOP + h - 2 * SCALE, tw - PAD, 2 * SCALE, _style_accent(state), SCALE); }
        _dt(win, x + PAD, TOP + PAD, str_slice(title, 0, (tw - 2 * PAD) / CW), txt);
        array_push(layout, map{ index: i, x: x, y: TOP, w: tw, h: h });
        x = x + tw + SCALE;
        i = i + 1;
    }
    if len(tabs) > 1 and maxX - x > 16 * CW {
        let badge = str(len(tabs)) + " screens";
        _fill_round(win, maxX - 14 * CW, TOP + PAD / 2, 13 * CW, CH + PAD / 2, _style_surface2(state), RAD);
        _dt(win, maxX - 13 * CW, TOP + PAD, badge, _style_focus(state));
    }
    state.design_tab_layout = layout;
    return 0;
}

fn _design_tab_click(state, mx, my) {
    _design_tabs_ensure(state);
    let h = _design_tabs_height();
    if my < TOP - _button_hit_slop() or my > TOP + h + _button_hit_slop() { return false; }
    let layout = try state.design_tab_layout catch [];
    let i = 0;
    while layout != nil and i < len(layout) {
        let b = layout[i];
        if _hit_rect(mx, my, b.x, b.y, b.w, b.h, _button_hit_slop()) {
            _design_tabs_activate(state, b.index);
            return true;
        }
        i = i + 1;
    }
    return my >= TOP and my < TOP + h;
}

fn _design_select_delta(state, delta) {
    let d = state.design;
    let n = len(d.widgets);
    if n <= 0 { d.sel = 0 - 1; state.output = "designer: no items"; return 0; }
    let s = try d.sel catch 0 - 1;
    if s < 0 { if delta < 0 { s = n - 1; } else { s = 0; } }
    else { s = num_mod(s + delta + n, n); }
    d.sel = s;
    let w = d.widgets[d.sel];
    state.output = "designer selected " + str(d.sel + 1) + "/" + str(n) + ": " + str(try w.name catch try w.kind catch "?");
    return 0;
}

fn _design_duplicate_selected(state) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = _design_copy_value(d.widgets[d.sel]);
    d.counter = (try d.counter catch 0) + 1;
    w.name = str(try w.name catch try w.kind catch "item") + "_copy" + str(d.counter);
    w.x = (try w.x catch PAD) + DESIGN_GRID * 2;
    w.y = (try w.y catch _design_content_top(state)) + DESIGN_GRID * 2;
    _design_snap_widget(state, w, false);
    _design_clamp_widget(state, w);
    _design_refresh_widget(w);
    push(d.widgets, w);
    d.sel = len(d.widgets) - 1;
    state.output = "designer duplicated " + str(w.name);
    return 0;
}

fn _design_layer_selected(state, dir, extreme) {
    let d = state.design;
    let n = len(d.widgets);
    if d.sel < 0 or d.sel >= n { return 0; }
    let old = d.sel;
    let target = old + dir;
    if extreme {
        if dir < 0 { target = 0; }
        else { target = n - 1; }
    }
    if target < 0 { target = 0; }
    if target >= n { target = n - 1; }
    if target == old { return 0; }
    let w = d.widgets[old];
    let out = [];
    let i = 0;
    while i < n {
        if i != old { push(out, d.widgets[i]); }
        i = i + 1;
    }
    if target > len(out) { target = len(out); }
    let final = [];
    i = 0;
    while i < len(out) {
        if i == target { push(final, w); }
        push(final, out[i]);
        i = i + 1;
    }
    if target == len(out) { push(final, w); }
    d.widgets = final;
    d.sel = target;
    state.output = "designer layer " + str(try w.name catch "?") + " -> " + str(d.sel + 1) + "/" + str(n);
    return 0;
}

fn _design_delete_selected(state) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { state.output = "designer: no selected item"; return 0; }
    let old = try d.widgets[d.sel].name catch try d.widgets[d.sel].kind catch "item";
    let out = [];
    let i = 0;
    while i < len(d.widgets) { if i != d.sel { push(out, d.widgets[i]); } i = i + 1; }
    d.widgets = out;
    if len(d.widgets) == 0 { d.sel = 0 - 1; }
    else if d.sel >= len(d.widgets) { d.sel = len(d.widgets) - 1; }
    state.output = "designer deleted " + str(old);
    return 0;
}

fn _design_clear(state) {
    state.design.widgets = [];
    state.design.sel = 0 - 1;
    state.output = "designer canvas cleared";
    return 0;
}

fn _design_generate_to_editor(state) {
    _design_tabs_store_current(state);
    let code = _design_code(state);
    let parsed = FE.frontend_parse_safe(code);
    if not parsed.ok {
        state.output = "designer codegen blocked: generated source did not parse";
        return 0;
    }
    state.ed = E.new(code);
    state.dirty = true; state.tokens = nil; state.syntax_hash = ""; state.last = "other";
    state.panel = "code";
    state.output = "designer -> generated " + str(len(state.design.widgets)) + " widget(s) into the editor (F5 to run)";
    return 0;
}

fn _design_import_widget(state, parsed) {
    let kind = str(try parsed.kind catch "");
    let widget = _make_widget(state, kind, try parsed.x catch 0, try parsed.y catch 0);
    if widget == nil { return nil; }
    widget.name = str(try parsed.name catch widget.name);
    widget.x = try parsed.x catch widget.x; widget.y = try parsed.y catch widget.y;
    widget.w = try parsed.w catch widget.w; widget.h = try parsed.h catch widget.h;
    widget.manual_size = true;
    let props = try parsed.props catch map{};
    if kind == "label" or kind == "button" or kind == "checkbox" or kind == "radio"
        or kind == "cube3d" or kind == "sphere3d" {
        widget.text = str(try props.text catch try widget.text catch "");
    } else if kind == "textbox" {
        widget.value = str(try props.value catch "");
    } else if kind == "panel" {
        widget.title = str(try props.title catch "Panel");
    } else if kind == "select" {
        widget.options = try props.options catch [];
        widget.selected = try props.selected catch 0;
    } else if kind == "slider" {
        widget.value = try props.value catch 0;
        widget.min = try props.min catch 0;
        widget.max = try props.max catch 100;
    }
    if kind == "checkbox" { widget.checked = try props.checked catch false; }
    if kind == "radio" {
        widget.group = str(try props.group catch "group1");
        widget.selected = try props.selected catch false;
    }
    if (try parsed.bind catch nil) != nil { widget.bind = str(parsed.bind); }
    if (try parsed.events catch nil) != nil { widget.events = _design_copy_value(parsed.events); }
    return widget;
}

// Desktop From Code parity with the web Studio. Parsing and validation happen
// completely before the active canvas is replaced, so malformed or unsupported
// source cannot partially erase the user's current design.
fn _design_import_from_editor(state) {
    let imported = GP.parse_strict(E.text(state.ed));
    if not imported.ok {
        state.output = "designer <- code blocked: " + str(try imported.error catch "invalid source")
            + " · " + str_join(try imported.diagnostics catch [], "; ");
        return 0;
    }
    let next = _design_blank(try state.path catch "");
    next.target = "gui";
    next.form_title = str(try imported.form.title catch "Designed UI");
    next.form_width = try imported.form.w catch 800;
    next.form_height = try imported.form.h catch 600;
    next.model = _design_copy_value(try imported.model catch map{});
    let scratch = map{ design:next, winsz:try state.winsz catch nil };
    let parsed_widgets = try imported.widgets catch [];
    let converted = [];
    let i = 0;
    while i < len(parsed_widgets) {
        let widget = _design_import_widget(scratch, parsed_widgets[i]);
        if widget == nil {
            state.output = "designer <- code blocked: unsupported normalized widget "
                + str(try parsed_widgets[i].kind catch "unknown");
            return 0;
        }
        array_push(converted, widget);
        i = i + 1;
    }
    next.widgets = converted;
    if len(converted) > 0 { next.sel = 0; }
    state.design = next;
    _design_tabs_store_current(state);
    state.panel = "design";
    state.output = "designer <- imported " + str(len(converted))
        + " desktop widget(s) atomically from code";
    return 0;
}

fn _design_component_default_id(state) {
    let q = str(try state.design.tool catch "");
    let hits = IDE.filter_designer_components(q, 1);
    if len(hits) > 0 { return str(try hits[0].id catch "app_shell"); }
    return "app_shell";
}

fn _design_apply_preset_item(state, item) {
    let kind = str(try item.kind catch "panel");
    let x = try item.x catch PAD * 2;
    let y = try item.y catch _design_content_top(state) + PAD;
    let w = _make_widget(state, kind, x, y);
    if w == nil { return nil; }
    if (try item.name catch "") != "" { w.name = str(item.name); }
    if (try item.w catch nil) != nil { w.w = item.w; w.manual_size = true; }
    if (try item.h catch nil) != nil { w.h = item.h; w.manual_size = true; }
    let text = try item.text catch nil;
    if text != nil {
        let fk = _w_textkey(w);
        if fk != "" { w[fk] = str(text); }
        if (try w.title catch nil) != nil { w.title = str(text); }
    }
    if (try item.title catch nil) != nil { w.title = str(item.title); }
    _design_refresh_widget(w);
    _design_snap_widget(state, w, true);
    _design_clamp_widget(state, w);
    return w;
}

fn _design_insert_component_preset(state) {
    let id = _design_component_default_id(state);
    let preset = IDE.designer_component_preset(id, PAD * 2, _design_content_top(state) + PAD);
    if not (try preset.ok catch false) {
        state.output = str(try preset.summary catch "component preset unavailable");
        return 0;
    }
    let items = try preset.items catch [];
    let added = 0;
    let i = 0;
    while i < len(items) {
        let w = _design_apply_preset_item(state, items[i]);
        if w != nil {
            array_push(state.design.widgets, w);
            state.design.sel = len(state.design.widgets) - 1;
            added = added + 1;
        }
        i = i + 1;
    }
    _design_apply_layout(state);
    state.output = "designer inserted component preset: " + str(try preset.title catch id) + " (" + str(added) + " item(s))";
    return 0;
}

fn _design_command(state, action) {
    let d = state.design;
    if action == "codegen" { _design_generate_to_editor(state); return 0; }
    if action == "from_code" { _design_import_from_editor(state); return 0; }
    if action == "clear" { _design_clear(state); return 0; }
    if action == "layout_next" {
        d.layout = _layout_next(try d.layout catch "free");
        _design_apply_layout(state);
        state.output = "designer layout: " + d.layout;
        return 0;
    }
    if action == "target_next" {
        d.target = _app_target_next(try d.target catch "gui");
        state.output = "designer app target: " + d.target;
        return 0;
    }
    if action == "select_next" { _design_select_delta(state, 1); return 0; }
    if action == "select_prev" { _design_select_delta(state, 0 - 1); return 0; }
    if action == "duplicate" { _design_duplicate_selected(state); return 0; }
    if action == "delete" { _design_delete_selected(state); return 0; }
    if action == "layer_back" { _design_layer_selected(state, 0 - 1, false); return 0; }
    if action == "layer_forward" { _design_layer_selected(state, 1, false); return 0; }
    if action == "layer_bottom" { _design_layer_selected(state, 0 - 1, true); return 0; }
    if action == "layer_top" { _design_layer_selected(state, 1, true); return 0; }
    if action == "component_library" {
        let lines = IDE.designer_component_lines(IDE.filter_designer_components("", 12), 12);
        state.output = "Designer component library\n" + str_join(lines, "\n");
        return 0;
    }
    if action == "component_insert" { _design_insert_component_preset(state); return 0; }
    state.output = "designer command not handled: " + str(action);
    return 0;
}
// a click in the Designer: palette action, select+drag an existing widget, or place one.

fn _design_click(state, mx, my) {
    if _design_tab_click(state, mx, my) { return 0; }
    let d = state.design;
    let p = _pal_hit(mx, my, state.winsz);
    if p != nil {
        if p == "apptype" {
            d.target = _app_target_next(try d.target catch "gui");
            state.output = "designer app target: " + d.target;
            return 0;
        }
        if p == "layout" {
            d.layout = _layout_next(try d.layout catch "free");
            _design_apply_layout(state);
            state.output = "designer layout: " + d.layout;
            return 0;
        }
        if p == "gencode" {
            _design_generate_to_editor(state);
            return 0;
        }
        if p == "fromcode" { _design_import_from_editor(state); return 0; }
        if p == "clear" { _design_clear(state); return 0; }
        d.tool = p; return 0;
    }
    let canvTop = TOP + _pal_height(state.winsz) + PAD;
    let canvBot = state.winsz.h - (CH + PAD);
    if my < canvTop or my >= canvBot { return 0; }
    let hi = _design_widget_at(state, mx, my);
    if hi >= 0 {
        d.sel = hi; d.drag = true;
        d.dx = mx - d.widgets[hi].x; d.dy = my - d.widgets[hi].y;
        return 0;
    }
    let w = _make_widget(state, d.tool, mx, my);
    if w != nil {
        _design_snap_widget(state, w, false);
        _design_clamp_widget(state, w);
        array_push(d.widgets, w);
        d.sel = len(d.widgets) - 1;
        _design_apply_layout(state);
    }
    return 0;
}

fn _design_key(state, key, shift) {
    let d = state.design;
    if try state.ctrl catch false {
        if key == "PageDown" { _design_tab_step(state, 1); return 0; }
        if key == "PageUp" { _design_tab_step(state, 0 - 1); return 0; }
    }
    if key == "Tab" { if shift { _design_select_delta(state, 0 - 1); } else { _design_select_delta(state, 1); } return 0; }
    if d.sel < 0 { return 0; }
    let w = d.widgets[d.sel];
    if key == "Delete" {
        _design_delete_selected(state);
        return 0;
    }
    if key == "Insert" { _design_duplicate_selected(state); return 0; }
    if try state.ctrl catch false {
        if key == "[" or key == "LeftBracket" { _design_layer_selected(state, 0 - 1, shift); return 0; }
        if key == "]" or key == "RightBracket" { _design_layer_selected(state, 1, shift); return 0; }
    }
    if key == "Left" or key == "Right" or key == "Up" or key == "Down" {
        let step = 4 * SCALE;
        if shift { step = 12 * SCALE; }
        let dx = 0;
        let dy = 0;
        if key == "Left" { dx = 0 - step; }
        if key == "Right" { dx = step; }
        if key == "Up" { dy = 0 - step; }
        if key == "Down" { dy = step; }
        if try state.ctrl catch false { _design_resize_selected(state, dx, dy); }
        else { _design_move_selected(state, dx, dy); }
        return 0;
    }
    let fk = _w_textkey(w);
    if fk == "" { return 0; }
    if key == "Backspace" { let v = w[fk]; if len(v) > 0 { w[fk] = str_slice(v, 0, len(v) - 1); _design_refresh_widget(w); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w[fk] = w[fk] + ch; _design_refresh_widget(w); }
    return 0;
}

// ── AI panel (pbAI — stdlib/pbai.sapp) ────────────────────────────────────────────
// A chat against pblang's own assistant: a free-text question box plus quick-action
// chips that run pbAI on whatever is in the CODE editor. This native panel mirrors the
// pbAI web test console (stdlib/ai/pbai/website): Respond (type + Enter), ANALYZE,
// GENERATE, and a STATUS view (the console's Family/Bottom/Tokenizer/Brain status grid +
// LLM family map) — brought into the IDE, no browser. Every answer carries a decision cue
// (intent, confidence, and why it would ask you to confirm). pbAI grounds on code wrapped
// in a `--- pblang code ---` marker; the last raw answer can be inserted into the editor.
let AIPAL = [
map{ id: "explain", label: "EXPLAIN" },
map{ id: "bugs",    label: "BUGS" },
map{ id: "improve", label: "IMPROVE" },
map{ id: "quality", label: "QUALITY" },
map{ id: "comment", label: "COMMENT" },
map{ id: "analyze", label: "ANALYZE" },
map{ id: "generate", label: "GENERATE" },
map{ id: "diag",    label: "DIAG" },
map{ id: "status",  label: "STATUS" },
map{ id: "insert",  label: "INSERT" },
map{ id: "clear",   label: "CLEAR" },
];

fn _ai_bounds(idx) {
    let x = PAD;
    let i = 0;
    while i < idx { x = x + (len(AIPAL[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(AIPAL[idx].label) + 2) * CW };
}

fn _ai_hit(mx, my) {
    if my < TOP - _hit_slop() or my >= TOP + CH + _hit_slop() { return nil; }
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        if _hit_button(mx, my, b.x, TOP, b.w, CH) { return AIPAL[i].id; }
        i = i + 1;
    }
    return nil;
}

fn _ai_push(state, line) {
    array_push(state.ai.lines, line);
    if len(state.ai.lines) > 600 {
        let out = []; let i = len(state.ai.lines) - 400;
        while i < len(state.ai.lines) { push(out, state.ai.lines[i]); i = i + 1; }
        state.ai.lines = out;
    }
    return 0;
}
// send `prompt` to pbAI; `echo` is the user-visible line shown above the answer.

fn _ai_send(state, prompt, echo) {
    _ai_push(state, "> " + echo);
    let reply = try AI.respond(prompt) catch "pbAI error — could not produce a response";
    state.ai.last_response = reply;
    let rl = str_split(reply, "
    ");
    let i = 0;
    while i < len(rl) { _ai_push(state, "  " + rl[i]); i = i + 1; }
    // Decision cue: pbAI's intent + confidence and, when the ensemble is unsure, WHY it
    // would ask you to confirm (low_confidence vs uncertain). Defensive — never breaks the
    // panel if the ensemble isn't configured.
    let cue = try AI.explain_line(prompt) catch nil;
    if cue != nil {
        _ai_push(state, "  · pbAI: " + str(cue));
        state.ai.last_cue = str(cue);
    }
    _ai_push(state, "");
    return 0;
}

fn _ai_diag_prompt(state, code) {
    let dl = IDE.diagnostic_summary(try state.diagnostics catch [], 20);
    let diag = "";
    let i = 0;
    while i < len(dl) {
        if i > 0 { diag = diag + "
            "; }
        diag = diag + dl[i];
        i = i + 1;
    }
    if str_trim(diag) == "" { diag = "(no diagnostics - press F6 Check first)"; }
    return "Explain these pblang compiler diagnostics and how to fix them:

    " + diag + "

    - - - pblang code - - -
    " + code;
}

fn _ai_insert_last_response(state) {
    let reply = str(try state.ai.last_response catch "");
    if str_trim(reply) == "" {
        _ai_push(state, "  no AI response to insert yet");
        return 0;
    }
    E.snapshot(state.ed);
    E.insert_text(state.ed, reply);
    state.dirty = true;
    state.panel = "code";
    state.output = "inserted last pbAI response into editor";
    _refresh_watcher(state, "ai_insert");
    return 0;
}
// _ai_render_reply(state, reply, echo) — push a structured (already-produced) answer with
// the same framing as _ai_send but WITHOUT re-running respond (for analyze/generate/status
// which call a specific pbAI entry point directly, like the web console's action buttons).

fn _ai_render_reply(state, reply, echo) {
    _ai_push(state, "> " + echo);
    let s = str(reply);
    state.ai.last_response = s;
    let rl = str_split(s, "
    ");
    let i = 0;
    while i < len(rl) { _ai_push(state, "  " + rl[i]); i = i + 1; }
    _ai_push(state, "");
    return 0;
}
// _ai_status_report(state) — the web console's status grid + LLM family map, natively.

fn _ai_status_report(state) {
    let st = try AI.model_status() catch nil;
    _ai_push(state, "> pbAI status");
    if st == nil { _ai_push(state, "  (status unavailable)"); _ai_push(state, ""); return 0; }
    _ai_push(state, "  Family:    " + str(try st.family catch "?"));
    _ai_push(state, "  Router:    " + str(try st.top.router catch "?"));
    _ai_push(state, "  Bottom:    " + str(try st.bottom.lm catch "?") + " (" + str(try st.bottom.tier catch "?") + ")");
    _ai_push(state, "  Format:    " + str(try st.bottom.format catch "?"));
    _ai_push(state, "  Arch:      " + str(try st.bottom.architecture catch "?"));
    _ai_push(state, "  Learns:    " + str(try st.bottom.learns catch "?"));
    _ai_push(state, "  Tools:     " + str(try st.top.tools catch "?"));
    _ai_push(state, "");
    return 0;
}
// quick action: run a pbAI skill on the current editor buffer (or CLEAR the chat).

fn _ai_action(state, id) {
    if id == "clear" { state.ai.lines = []; state.ai.last_response = ""; state.ai.last_cue = ""; return 0; }
    if id == "insert" { _ai_insert_last_response(state); return 0; }
    if id == "status" { _ai_status_report(state); return 0; }
    let code = E.text(state.ed);
    if id == "diag" {
        _ai_send(state, _ai_diag_prompt(state, code), "explain diagnostics");
        return 0;
    }
    if id == "analyze" {
        let a = try AI.analyze(code) catch "pbAI error — analyze failed";
        _ai_render_reply(state, a, "analyze (on editor buffer)");
        return 0;
    }
    if id == "generate" {
        let seed = code;
        if str_trim(seed) == "" { seed = str_trim(try state.ai.input catch ""); }
        let g = try AI.generate(seed, 80) catch "pbAI error — generate failed";
        _ai_render_reply(state, g, "generate (from buffer/prompt)");
        return 0;
    }
    let verb = "explain what this code does";
    if id == "bugs" { verb = "find the bugs and errors in this code"; }
    else if id == "improve" { verb = "improve and optimize this code"; }
    else if id == "quality" { verb = "improve quality, security, performance, and maintainability of this code"; }
    else if id == "comment" { verb = "add comments documenting this code"; }
    let prompt = verb + ":

    - - - pblang code - - -
    " + code;
    _ai_send(state, prompt, id + " (on editor buffer)");
    return 0;
}

fn _ai_key(state, key, shift) {
    let a = state.ai;
    if key == "Up" {
        let m = IDE.ai_prompt_history_move(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch []), "up", try a.hist_draft catch "", try a.input catch "");
        a.hist_pos = m.pos;
        a.hist_draft = m.draft;
        a.input = m.input;
        return 0;
    }
    if key == "Down" {
        let m = IDE.ai_prompt_history_move(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch []), "down", try a.hist_draft catch "", try a.input catch "");
        a.hist_pos = m.pos;
        a.hist_draft = m.draft;
        a.input = m.input;
        return 0;
    }
    if _is_enter(key) {
        if shift { a.input = a.input + "
            "; return 0; }                  // Shift+Enter = newline (compose a multi-line question)
        let q = str_trim(a.input);
        a.input = "";
        if q != "" {
            a.prompt_history = IDE.ai_prompt_history_push(try a.prompt_history catch [], q, 80);
            a.hist_pos = len(a.prompt_history);
            a.hist_draft = "";
            _ai_send(state, q, q);
        }
        return 0;
    }
    if key == "Backspace" {
        if len(a.input) > 0 { a.input = str_slice(a.input, 0, len(a.input) - 1); }
        a.hist_pos = len(try a.prompt_history catch []);
        a.hist_draft = "";
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        a.input = a.input + ch;
        a.hist_pos = len(try a.prompt_history catch []);
        a.hist_draft = "";
    }
    return 0;
}

fn _draw_ai(state, win, sz) {
    let a = state.ai;
    // quick-action palette
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        let bg = _style_panel(state); if AIPAL[i].id == "clear" { bg = gfx.rgb(46, 40, 64); }
        if AIPAL[i].id == "clear" and _theme_is_light(state) { bg = gfx.rgb(228, 220, 245); }
        _fill_round(win, b.x, TOP, b.w, CH, bg, RAD);
        _dt(win, b.x + CW, TOP + SCALE, AIPAL[i].label, _style_muted(state));
        i = i + 1;
    }
    // chat scrollback (tail), hard-wrapped to fit width
    let maxchars = (sz.w - 2 * PAD) / CW;
    let statusY = TOP + CH + PAD;
    win.rect(0, statusY, sz.w, CH + PAD, _style_surface(state));
    win.rect(0, statusY, 2 * SCALE, CH + PAD, _style_accent(state));
    win.rect(0, statusY + CH + PAD, sz.w, SCALE, _style_border(state));
    let aiStatus = IDE.ai_prompt_history_status(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch [])) +
    " · Up/Down recall · Shift+Enter newline · INSERT last answer";
    _dt(win, PAD, statusY + PAD / 2, str_slice(aiStatus, 0, maxchars), _style_muted(state));
    let chatTop = statusY + CH + 2 * PAD;
    let promptTop = _draw_input(state, win, sz, "ask pbAI > ", a.input, maxchars);
    let rows = (promptTop - chatTop) / CH;
    let visual = [];
    let li = 0;
    while li < len(a.lines) {
        let wl = _wrap(a.lines[li], maxchars);
        if len(wl) == 0 { push(visual, ""); }
        let wi = 0;
        while wi < len(wl) { push(visual, wl[wi]); wi = wi + 1; }
        li = li + 1;
    }
    let total = len(visual);
    let start = 0;
    if total > rows { start = total - rows; }
    let vr = 0;
    while start + vr < total and vr < rows {
        let ln = visual[start + vr];
        let col = _style_pane_text(state);
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = _style_accent(state); }   // '>' = user line, accent
        _dt(win, PAD, chatTop + vr * CH, str_slice(ln, 0, maxchars), col);
        vr = vr + 1;
    }
}

// ── Browser panel (stdlib/browser.sapp) ───────────────────────────────────────────

fn _push_wrapped(lines, text, width) {
    if width < 1 { width = 1; }
    let rest = text;
    while len(rest) > width {
        push(lines, str_slice(rest, 0, width));
        rest = str_slice(rest, width, len(rest));
    }
    if rest != "" { push(lines, rest); }
    return 0;
}

// word-wrap plain text into lines no wider than `width` chars.

fn _wrap(text, width) {
    if width < 1 { width = 1; }
    let words = str_split(str_replace_all(text, "
    ", " "), " ");
    let lines = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = words[i];
        if w != "" {
            if len(w) > width {
                if cur != "" { push(lines, cur); cur = ""; }
                _push_wrapped(lines, w, width);
            }
            else if cur == "" { cur = w; }
            else if len(cur) + len(w) + 1 > width { push(lines, cur); cur = w; }
            else { cur = cur + " " + w; }
        }
        i = i + 1;
    }
    if cur != "" { push(lines, cur); }
    return lines;
}

fn _wrap_with_prefix(prefix, text, width) {
    let lines = [];
    if width <= len(prefix) + 1 {
        push(lines, str_slice(prefix, 0, width));
        return lines;
    }
    let chunks = _wrap(text, width - len(prefix));
    if len(chunks) == 0 { push(lines, prefix); return lines; }
    let i = 0;
    while i < len(chunks) {
        let p = prefix;
        if i > 0 { p = str_repeat(" ", len(prefix)); }
        push(lines, p + chunks[i]);
        i = i + 1;
    }
    return lines;
}

fn _is_noise_line(line) {
    let t = str_lower(str_trim(line));
    if t == "" { return true; }
    if t == "menu" or t == "items" or t == "scroll to top" { return true; }
    if str_contains(t, "cookies") or str_contains(t, "privacy policy") { return true; }
    if str_contains(t, "newsletter") or str_contains(t, "facebook") or str_contains(t, "linkedin") { return true; }
    return false;
}

fn _reader_lines(text, cols) {
    let raw = _wrap(text, cols);
    let out = [];
    let seen = map{};
    let i = 0;
    while i < len(raw) and len(out) < 900 {
        let line = str_trim(raw[i]);
        if not _is_noise_line(line) {
            let key = str_lower(line);
            if map_has(seen, key) == false {
                seen[key] = true;
                push(out, line);
            }
        }
        i = i + 1;
    }
    if len(out) == 0 { return ["No readable text extracted from this page. Try Links or Forms."]; }
    return out;
}

fn _forms_lines(forms, cols) {
    let out = [];
    if forms == nil or len(forms) == 0 {
        return ["No forms found on this page."];
    }
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let head = str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        let j = 0;
        while j < len(wh) { push(out, wh[j]); j = j + 1; }
        let fields = try f.fields catch [];
        if len(fields) == 0 { push(out, "   fields: none"); }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            push(out, "   - " + str(try fld.name catch "?") + " : " + str(try fld.type catch "text"));
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _web_forms_current(state) {
    let page = try state.web.page_obj catch nil;
    if page == nil { return []; }
    return try page.forms catch [];
}

fn _web_form_clamp(state) {
    let fs = _web_forms_current(state);
    if len(fs) == 0 {
        state.web.form_sel = 0;
        state.web.form_field_sel = 0;
        state.web.form_values = map{};
        return fs;
    }
    if try state.web.form_sel catch nil == nil { state.web.form_sel = 0; }
    if state.web.form_sel < 0 { state.web.form_sel = 0; }
    if state.web.form_sel >= len(fs) { state.web.form_sel = len(fs) - 1; }
    let fields = try fs[state.web.form_sel].fields catch [];
    if try state.web.form_field_sel catch nil == nil { state.web.form_field_sel = 0; }
    if state.web.form_field_sel < 0 { state.web.form_field_sel = 0; }
    if len(fields) == 0 { state.web.form_field_sel = 0; }
    else if state.web.form_field_sel >= len(fields) { state.web.form_field_sel = len(fields) - 1; }
    return fs;
}

fn _web_form_values(state) {
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { return map{}; }
    let vals = try state.web.form_values catch nil;
    if vals == nil { vals = B.form_values(fs[state.web.form_sel]); }
    let fields = try fs[state.web.form_sel].fields catch [];
    let i = 0;
    while i < len(fields) {
        let name = str(try fields[i].name catch "");
        if name != "" and not map_has(vals, name) {
            vals[name] = str(try fields[i].value catch "");
        }
        i = i + 1;
    }
    state.web.form_values = vals;
    return vals;
}

fn _forms_lines_state(state, cols) {
    let forms = _web_forms_current(state);
    if forms == nil or len(forms) == 0 { return ["No forms found on this page."]; }
    _web_form_clamp(state);
    let vals = _web_form_values(state);
    let out = [
    "Forms mode: Tab/Shift+Tab select field, type edits value, Enter submits.",
    "Use Ctrl+N/Ctrl+P to switch forms. Submit is allowed only in Live/Trusted profiles.",
    ""
    ];
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let selected = i == state.web.form_sel;
        let mark = "  ";
        if selected { mark = "> "; }
        let head = mark + str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        let j = 0;
        while j < len(wh) { push(out, wh[j]); j = j + 1; }
        let fields = try f.fields catch [];
        if len(fields) == 0 { push(out, "     fields: none"); }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            let row = B.form_field_display(fld, vals, selected and k == state.web.form_field_sel);
            let rw = _wrap(row, cols);
            let rwi = 0;
            while rwi < len(rw) { push(out, rw[rwi]); rwi = rwi + 1; }
            k = k + 1;
        }
        if selected {
            let preview = B.form_preview_url(f, vals);
            let pw = _wrap("   submit preview: " + preview, cols);
            let pi = 0;
            while pi < len(pw) { push(out, pw[pi]); pi = pi + 1; }
        }
        push(out, "");
        i = i + 1;
    }
    return out;
}

fn _web_form_hit_row(state, row, cols) {
    let forms = _web_forms_current(state);
    if forms == nil or len(forms) == 0 { return nil; }
    _web_form_clamp(state);
    if row < 3 { return nil; }
    let line = 3;
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let selected = i == state.web.form_sel;
        let mark = "  ";
        if selected { mark = "> "; }
        let head = mark + str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        if row >= line and row < line + len(wh) { return map{ kind: "form", form: i }; }
        line = line + len(wh);
        let fields = try f.fields catch [];
        if len(fields) == 0 {
            if row == line { return map{ kind: "form", form: i }; }
            line = line + 1;
        }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            let vals = _web_form_values(state);
            let rw = _wrap(B.form_field_display(fld, vals, selected and k == state.web.form_field_sel), cols);
            if row >= line and row < line + len(rw) { return map{ kind: "field", form: i, field: k }; }
            line = line + len(rw);
            k = k + 1;
        }
        if selected {
            let preview = B.form_preview_url(f, _web_form_values(state));
            let pw = _wrap("   submit preview: " + preview, cols);
            if row >= line and row < line + len(pw) { return map{ kind: "submit", form: i }; }
            line = line + len(pw);
        }
        if row == line { return map{ kind: "form", form: i }; }
        line = line + 1;
        i = i + 1;
    }
    return nil;
}

fn _source_lines(page, cols) {
    return B.source_lines(page, cols, 700);
}

fn _inspect_lines(page, cols) {
    return B.inspector_lines(page, cols);
}

fn _page_lines(page, cols) {
    let out = B.page_layout_lines(page, cols, 900);
    if len(out) == 0 { return ["No page structure extracted. Try Reader, Links, or Forms."]; }
    return out;
}

fn _web_default_page_lines(input) {
    let u = str(input);
    if str_trim(u) == "" { u = "example.com"; }
    return [
    "Browser tab ready: " + u,
    "Press Enter or Reload to load this tab through the current security profile.",
    "Use Ctrl+PageDown / Ctrl+PageUp to switch browser tabs, Ctrl+T for a new tab."
    ];
}

fn _web_tab_title(tab) {
    let t = str_trim(str(try tab.title catch ""));
    if t == "" or str_starts_with(t, "loading ") { t = str_trim(str(try tab.input catch "")); }
    if t == "" { t = str_trim(str(try tab.url catch "")); }
    if t == "" { t = "new tab"; }
    if len(t) > 22 { t = str_slice(t, 0, 19) + "..."; }
    return t;
}

fn _web_tab_snapshot(state) {
    let w = state.web;
    return map{
        title: str(try w.title catch ""),
        input: str(try w.input catch ""),
        url: str(try w.url catch ""),
        mode: str(try w.mode catch "live"),
        security: str(try w.security catch "safe"),
        tor: try w.tor catch false,
        status: str(try w.status catch "safe"),
        scroll: try w.scroll catch 0,
        history: try w.history catch [],
        forward: try w.forward catch [],
        bookmarks: try w.bookmarks catch [],
        download_plans: try w.download_plans catch [],
        search_engine: str(try w.search_engine catch "duckduckgo"),
        home: str(try w.home catch "example.com"),
        find_query: str(try w.find_query catch ""),
        page_obj: try w.page_obj catch nil,
        page: try w.page catch _web_default_page_lines(try w.input catch "example.com"),
        reader: try w.reader catch _web_default_page_lines(try w.input catch "example.com"),
        links: try w.links catch [],
        forms: try w.forms catch ["No forms loaded."],
        form_sel: try w.form_sel catch 0,
        form_field_sel: try w.form_field_sel catch 0,
        form_values: try w.form_values catch map{},
        source: try w.source catch ["No source loaded."],
        inspect: try w.inspect catch ["No inspector details loaded."],
        render_img: try w.render_img catch nil,
        render_path: str(try w.render_path catch ""),
        render_lines: try w.render_lines catch ["Host mode: switch security to Trusted or JS/DOM, enter a URL, click Host."],
        lines: try w.lines catch _web_default_page_lines(try w.input catch "example.com")
    };
}

fn _web_tab_blank(input) {
    let u = str(input);
    if str_trim(u) == "" { u = "example.com"; }
    let lines = _web_default_page_lines(u);
    return map{
        title: "",
        input: u,
        url: u,
        mode: "live",
        security: "safe",
        tor: false,
        status: "ready",
        scroll: 0,
        history: [],
        forward: [],
        bookmarks: [],
        download_plans: [],
        search_engine: "duckduckgo",
        home: "example.com",
        find_query: "",
        page_obj: nil,
        page: lines,
        reader: lines,
        links: [],
        forms: ["No forms loaded."],
        form_sel: 0,
        form_field_sel: 0,
        form_values: map{},
        source: ["No source loaded."],
        inspect: ["No inspector details loaded."],
        render_img: nil,
        render_path: "",
        render_lines: ["Host mode: switch security to Trusted or JS/DOM, enter a URL, click Host. Needs --allow-exec and chromium/google-chrome/brave/firefox."],
        lines: lines
    };
}

fn _web_apply_tab(state, tab) {
    let w = state.web;
    w.title = str(try tab.title catch "");
    w.input = str(try tab.input catch "example.com");
    w.url = str(try tab.url catch "");
    w.mode = str(try tab.mode catch "live");
    w.security = str(try tab.security catch "safe");
    w.tor = try tab.tor catch false;
    w.status = str(try tab.status catch "ready");
    w.scroll = try tab.scroll catch 0;
    w.history = try tab.history catch [];
    w.forward = try tab.forward catch [];
    w.bookmarks = try tab.bookmarks catch [];
    w.download_plans = try tab.download_plans catch [];
    w.search_engine = str(try tab.search_engine catch "duckduckgo");
    w.home = str(try tab.home catch "example.com");
    w.find_query = str(try tab.find_query catch "");
    w.page_obj = try tab.page_obj catch nil;
    w.page = try tab.page catch _web_default_page_lines(w.input);
    w.reader = try tab.reader catch _web_default_page_lines(w.input);
    w.links = try tab.links catch [];
    w.forms = try tab.forms catch ["No forms loaded."];
    w.form_sel = try tab.form_sel catch 0;
    w.form_field_sel = try tab.form_field_sel catch 0;
    w.form_values = try tab.form_values catch map{};
    w.source = try tab.source catch ["No source loaded."];
    w.inspect = try tab.inspect catch ["No inspector details loaded."];
    w.render_img = try tab.render_img catch nil;
    w.render_path = str(try tab.render_path catch "");
    w.render_lines = try tab.render_lines catch ["Host mode: switch security to Trusted or JS/DOM, enter a URL, click Host."];
    w.lines = try tab.lines catch _web_default_page_lines(w.input);
    state.web = w;
    return 0;
}

fn _web_tabs_ensure(state) {
    let tabs = try state.web.tabs catch nil;
    if tabs == nil { tabs = []; }
    if len(tabs) == 0 {
        array_push(tabs, _web_tab_snapshot(state));
        state.web.tabs = tabs;
        state.web.tab_sel = 0;
    }
    if (try state.web.tab_sel catch 0) < 0 { state.web.tab_sel = 0; }
    if state.web.tab_sel >= len(tabs) { state.web.tab_sel = len(tabs) - 1; }
    return tabs;
}

fn _web_tabs_store_current(state) {
    let tabs = _web_tabs_ensure(state);
    let sel = try state.web.tab_sel catch 0;
    if sel < 0 { sel = 0; }
    if sel >= len(tabs) { sel = len(tabs) - 1; }
    tabs[sel] = _web_tab_snapshot(state);
    state.web.tabs = tabs;
    state.web.tab_sel = sel;
    return 0;
}

fn _web_tabs_activate(state, idx) {
    let tabs = _web_tabs_ensure(state);
    if idx < 0 or idx >= len(tabs) { return false; }
    _web_tabs_store_current(state);
    tabs = state.web.tabs;
    state.web.tab_sel = idx;
    _web_apply_tab(state, tabs[idx]);
    state.web.tab_sel = idx;
    state.web.tabs = tabs;
    state.web.status = "tab " + str(idx + 1) + "/" + str(len(tabs));
    return true;
}

fn _web_tabs_new(state, input) {
    _web_tabs_store_current(state);
    let tabs = try state.web.tabs catch [];
    array_push(tabs, _web_tab_blank(input));
    state.web.tabs = tabs;
    _web_tabs_activate(state, len(tabs) - 1);
    return 0;
}

fn _web_tabs_step(state, delta) {
    let tabs = _web_tabs_ensure(state);
    if len(tabs) == 0 { return 0; }
    let idx = (try state.web.tab_sel catch 0) + delta;
    while idx < 0 { idx = idx + len(tabs); }
    while idx >= len(tabs) { idx = idx - len(tabs); }
    _web_tabs_activate(state, idx);
    return 0;
}

fn _web_tabs_set_from_urls(state, urls) {
    let tabs = [];
    let i = 0;
    while urls != nil and i < len(urls) {
        let u = str(urls[i]);
        if str_trim(u) != "" { array_push(tabs, _web_tab_blank(u)); }
        i = i + 1;
    }
    if len(tabs) == 0 { return 0; }
    state.web.tabs = tabs;
    state.web.tab_sel = 0;
    state.web.tab_scroll = 0;
    state.web.tab_layout = [];
    _web_apply_tab(state, tabs[0]);
    state.web.tabs = tabs;
    state.web.tab_sel = 0;
    state.web.status = "browser tabs ready " + str(len(tabs));
    return 0;
}

fn _web_load_url(state, url, push_history) {
    _web_tabs_ensure(state);
    let resolved = B.browser_input_url(url, try state.web.search_engine catch "duckduckgo");
    if not (try resolved.ok catch false) {
        state.web.status = str(try resolved.reason catch "empty input");
        _web_tabs_store_current(state);
        return 0;
    }
    url = str(try resolved.url catch str_trim(url));
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    state.web.input = url;
    state.web.scroll = 0;
    state.web.title = "loading " + url + " ...";
    state.web.status = str(try sec.label catch "Safe");
    if str(try resolved.kind catch "url") == "search" {
        state.web.status = "search " + str(try resolved.label catch "Search");
    }
    state.web.lines = [];
    let page = try B.fetch_page_mode(url, try sec.mode catch "safe") catch nil;
    if page == nil or not page.ok {
        state.web.title = "load failed";
        let why = "could not load (needs network + http; try a reachable http/https URL)";
        if page != nil { why = try page.error catch why; }
        state.web.lines = [why];
        _web_tabs_store_current(state);
        return 0;
    }
    let current = try state.web.url catch "";
    if push_history and current != "" and current != page.url {
        push(state.web.history, current);
        if len(state.web.history) > 50 { state.web.history = slice(state.web.history, len(state.web.history) - 50, len(state.web.history)); }
        state.web.forward = [];
    }
    state.web.url = page.url;
    state.web.title = page.title;
    state.web.status = "loaded " + str(try sec.label catch "Safe");
    if str(try resolved.kind catch "url") == "search" {
        state.web.status = "loaded search " + str(try resolved.label catch "Search");
    }
    state.web.page_obj = page;
    let cols = 116;
    let pagelines = _page_lines(page, cols);
    let reader = _reader_lines(page.text, cols);
    let links = [];
    let i = 0;
    while i < len(page.links) and i < 40 {
        let wl = _wrap_with_prefix("> ", page.links[i], cols);
        let j = 0;
        while j < len(wl) { push(links, wl[j]); j = j + 1; }
        i = i + 1;
    }
    state.web.page = pagelines;
    state.web.reader = reader;
    state.web.links = links;
    state.web.forms = _forms_lines(try page.forms catch [], cols);
    state.web.form_sel = 0;
    state.web.form_field_sel = 0;
    let fs0 = try page.forms catch [];
    if len(fs0) > 0 { state.web.form_values = B.form_values(fs0[0]); }
    else { state.web.form_values = map{}; }
    state.web.source = _source_lines(page, cols);
    state.web.inspect = _inspect_lines(page, cols);
    state.web.lines = pagelines;
    _web_tabs_store_current(state);
    return 0;
}

fn _web_apply_page(state, page, status) {
    let cols = 116;
    state.web.url = page.url;
    state.web.title = page.title;
    state.web.status = status;
    state.web.page_obj = page;
    state.web.page = _page_lines(page, cols);
    state.web.reader = _reader_lines(page.text, cols);
    let links = [];
    let i = 0;
    while i < len(page.links) and i < 40 {
        let wl = _wrap_with_prefix("> ", page.links[i], cols);
        let j = 0;
        while j < len(wl) { push(links, wl[j]); j = j + 1; }
        i = i + 1;
    }
    state.web.links = links;
    state.web.forms = _forms_lines(try page.forms catch [], cols);
    state.web.form_sel = 0;
    state.web.form_field_sel = 0;
    let fs0 = try page.forms catch [];
    if len(fs0) > 0 { state.web.form_values = B.form_values(fs0[0]); }
    else { state.web.form_values = map{}; }
    state.web.source = _source_lines(page, cols);
    state.web.inspect = _inspect_lines(page, cols);
    state.web.lines = state.web.page;
    state.web.scroll = 0;
    _web_tabs_store_current(state);
    return 0;
}

fn _web_form_submit(state) {
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { state.web.status = "no form"; return 0; }
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    let f = fs[state.web.form_sel];
    let vals = _web_form_values(state);
    let r = try B.form_submit_mode(f, vals, try sec.mode catch "safe") catch nil;
    if r == nil {
        state.web.status = "form submit failed";
        state.output = "browser form submit failed";
        return 0;
    }
    if not (try r.ok catch false) {
        state.web.status = "form blocked";
        state.output = str(try r.error catch "form submit blocked");
        return 0;
    }
    _web_apply_page(state, r, "form submitted");
    state.web.mode = "live";
    state.output = "browser form submitted";
    return 0;
}

fn _web_select_form(state, idx) {
    let fs = _web_forms_current(state);
    if len(fs) == 0 { return 0; }
    if idx < 0 { idx = 0; }
    if idx >= len(fs) { idx = len(fs) - 1; }
    if idx != (try state.web.form_sel catch 0) {
        state.web.form_sel = idx;
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[idx]);
    } else {
        state.web.form_sel = idx;
    }
    return 0;
}

fn _web_forms_click(state, mx, my) {
    if (try state.web.mode catch "") != "forms" { return false; }
    let sz = state.winsz;
    if sz == nil { return false; }
    let bodyTop = _web_content_top(state);
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    if (try state.web.title catch "") != "" { bodyTop = bodyTop + CH + 3 * PAD; }
    if my < bodyTop or mx < colX - PAD or mx > colX + colW + PAD { return false; }
    let row = num_floor((my - bodyTop) / CH) + (try state.web.scroll catch 0);
    let hit = _web_form_hit_row(state, row, colW / CW);
    if hit == nil { return false; }
    _web_select_form(state, try hit.form catch 0);
    if (try hit.kind catch "") == "submit" {
        _web_form_submit(state);
        return true;
    }
    if (try hit.kind catch "") == "field" {
        state.web.form_field_sel = try hit.field catch 0;
        _web_form_clamp(state);
        let fs = _web_forms_current(state);
        let fields = try fs[state.web.form_sel].fields catch [];
        if len(fields) > 0 {
            let fld = fields[state.web.form_field_sel];
            let typ = str_lower(str(try fld.type catch "text"));
            if typ == "checkbox" or typ == "radio" or typ == "select" {
                let vals = _web_form_values(state);
                state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, str(try fld.name catch ""), 1);
                state.web.status = "form value changed";
            } else {
                state.web.status = "field selected";
            }
        }
        return true;
    }
    state.web.status = "form selected";
    return true;
}

fn _web_live_click(state, mx, my) {
    let mode = try state.web.mode catch "live";
    if not (mode == "live" or mode == "page") { return false; }
    let page = try state.web.page_obj catch nil;
    if page == nil { return false; }
    let sz = state.winsz;
    if sz == nil { return false; }
    let bodyTop = _web_content_top(state);
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    if (try state.web.title catch "") != "" { bodyTop = bodyTop + CH + 3 * PAD; }
    if my < bodyTop or mx < colX - PAD or mx > colX + colW + PAD { return false; }
    let col = num_floor((mx - colX) / CW);
    let row = num_floor((my - bodyTop) / CH) + (try state.web.scroll catch 0);
    let layout = B.page_layout(page, colW / CW);
    let hit = B.page_layout_hit(layout, col, row);
    if hit == nil { return false; }
    let kind = str(try hit.kind catch "");
    if kind == "link" {
        let href = str(try hit.href catch try hit.action catch try hit.text catch "");
        if href == "" { return false; }
        state.output = "browser live click link: " + href;
        _web_load_url(state, href, true);
        return true;
    }
    if kind == "form" {
        _web_select_form(state, try hit.form_index catch 0);
        state.web.mode = "forms";
        state.web.scroll = 0;
        state.web.status = "form selected";
        state.output = "browser live click form: switched to Forms mode";
        return true;
    }
    if kind == "img" {
        let src = str(try hit.src catch "");
        state.web.status = "image selected";
        state.output = "browser image: " + src;
        return true;
    }
    state.web.status = "selected " + kind;
    state.output = "browser live selected " + kind + ": " + str_slice(str(try hit.text catch ""), 0, 120);
    return true;
}

fn _web_form_key(state, key, shift) {
    if (try state.web.mode catch "") != "forms" { return false; }
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { return false; }
    let fields = try fs[state.web.form_sel].fields catch [];
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") {
        state.web.form_sel = state.web.form_sel + 1;
        if state.web.form_sel >= len(fs) { state.web.form_sel = 0; }
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[state.web.form_sel]);
        return true;
    }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") {
        state.web.form_sel = state.web.form_sel - 1;
        if state.web.form_sel < 0 { state.web.form_sel = len(fs) - 1; }
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[state.web.form_sel]);
        return true;
    }
    if key == "Tab" {
        if len(fields) > 0 {
            if shift { state.web.form_field_sel = state.web.form_field_sel - 1; }
            else { state.web.form_field_sel = state.web.form_field_sel + 1; }
            while state.web.form_field_sel < 0 { state.web.form_field_sel = state.web.form_field_sel + len(fields); }
            while state.web.form_field_sel >= len(fields) { state.web.form_field_sel = state.web.form_field_sel - len(fields); }
        }
        return true;
    }
    if _is_enter(key) { _web_form_submit(state); return true; }
    if len(fields) == 0 { return false; }
    let fld = fields[state.web.form_field_sel];
    let name = str(try fld.name catch "");
    if name == "" { return false; }
    let vals = _web_form_values(state);
    let typ = str_lower(str(try fld.type catch "text"));
    if key == "Space" or key == "Left" or key == "Right" {
        let dir = 1;
        if key == "Left" { dir = 0 - 1; }
        if typ == "checkbox" or typ == "radio" or typ == "select" {
            state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, name, dir);
            return true;
        }
    }
    let cur = str(try vals[name] catch "");
    if key == "Backspace" {
        if len(cur) > 0 { vals = B.form_update_value(vals, name, str_slice(cur, 0, len(cur) - 1)); }
        state.web.form_values = vals;
        return true;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        if typ == "checkbox" or typ == "radio" or typ == "select" {
            if ch == " " {
                state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, name, 1);
            }
            return true;
        }
        state.web.form_values = B.form_update_value(vals, name, cur + ch);
        return true;
    }
    return false;
}

fn _web_load(state) {
    return _web_load_url(state, state.web.input, true);
}

fn _web_back(state) {
    let hist = try state.web.history catch [];
    if len(hist) == 0 { state.web.status = "no back history"; return 0; }
    let url = hist[len(hist) - 1];
    state.web.history = slice(hist, 0, len(hist) - 1);
    let current = str(try state.web.url catch "");
    if current != "" {
        let fw0 = try state.web.forward catch nil;
        if fw0 == nil { state.web.forward = []; }
        push(state.web.forward, current);
        if len(state.web.forward) > 50 { state.web.forward = slice(state.web.forward, len(state.web.forward) - 50, len(state.web.forward)); }
    }
    _web_load_url(state, url, false);
    state.web.status = "back";
    return 0;
}

fn _web_forward(state) {
    let fwd = try state.web.forward catch [];
    if len(fwd) == 0 { state.web.status = "no forward history"; return 0; }
    let url = fwd[len(fwd) - 1];
    state.web.forward = slice(fwd, 0, len(fwd) - 1);
    let current = str(try state.web.url catch "");
    if current != "" {
        push(state.web.history, current);
        if len(state.web.history) > 50 { state.web.history = slice(state.web.history, len(state.web.history) - 50, len(state.web.history)); }
    }
    _web_load_url(state, url, false);
    state.web.status = "forward";
    return 0;
}

fn _web_home(state) {
    let home = str(try state.web.home catch "example.com");
    if str_trim(home) == "" { home = "example.com"; }
    state.web.input = home;
    _web_load_url(state, home, true);
    state.web.status = "home";
    return 0;
}

fn _web_current_page_for_bookmark(state) {
    let page = try state.web.page_obj catch nil;
    if page != nil and str(try page.url catch "") != "" { return page; }
    let u = str(try state.web.url catch try state.web.input catch "");
    if str_trim(u) == "" { return nil; }
    return map{ title: str(try state.web.title catch u), url: u };
}

fn _web_bookmark_current(state) {
    let page = _web_current_page_for_bookmark(state);
    if page == nil {
        state.web.status = "nothing to bookmark";
        state.output = state.web.status;
        return 0;
    }
    state.web.bookmarks = B.bookmark_push(try state.web.bookmarks catch [], page, 80);
    state.web.status = "bookmarked";
    state.output = "browser bookmark: " + str(try page.url catch "");
    return 0;
}

fn _web_bookmark_remove_newest(state) {
    let old = try state.web.bookmarks catch [];
    if len(old) == 0 {
        state.web.status = "no bookmarks";
        state.output = "browser bookmarks empty";
        return 0;
    }
    let removed = old[0];
    state.web.bookmarks = B.bookmark_remove(old, 0);
    state.web.mode = "bookmarks";
    state.web.status = "bookmark removed";
    state.output = "removed bookmark: " + str(try removed.url catch "");
    return 0;
}

fn _web_show_bookmarks(state) {
    state.web.mode = "bookmarks";
    state.web.scroll = 0;
    state.web.status = "bookmarks";
    state.output = "browser view: Bookmarks";
    return 0;
}

fn _web_search_next(state) {
    state.web.search_engine = B.next_search_engine(try state.web.search_engine catch "duckduckgo");
    let prof = B.search_engine_profile(state.web.search_engine);
    state.web.status = "search " + str(try prof.label catch state.web.search_engine);
    state.output = "browser search engine: " + str(try prof.label catch state.web.search_engine);
    return 0;
}

fn _web_download_plan(state) {
    let url = str(try state.web.url catch "");
    if str_trim(url) == "" { url = str(try state.web.input catch ""); }
    let mode = str(try state.web.security catch "safe");
    if try state.web.tor catch false { mode = "tor"; }
    let plan = B.download_plan(url, mode);
    state.web.status = "download blocked";
    if try plan.ok catch false {
        state.web.status = "download planned";
        let next = [plan];
        let old = try state.web.download_plans catch [];
        let i = 0;
        while old != nil and i < len(old) and len(next) < 40 {
            array_push(next, old[i]);
            i = i + 1;
        }
        state.web.download_plans = next;
    }
    state.output = str(try plan.summary catch state.web.status);
    return 0;
}

fn _web_stats(state) {
    state.web.mode = "stats";
    state.web.scroll = 0;
    state.web.status = "page stats";
    let page = try state.web.page_obj catch nil;
    if page == nil {
        state.output = "browser stats: no page loaded";
    } else {
        state.output = str_join(B.page_stats_lines(page), "\n");
    }
    return 0;
}

fn _web_find_open(state) {
    state.web.mode = "find";
    state.web.scroll = 0;
    state.web.status = "find in page";
    state.output = "browser find: type query, Backspace edits, Esc returns to Live";
    return 0;
}

fn _render_lines_from_result(r, path) {
    if r == nil { return ["Render failed: no renderer result."]; }
    if not r.ok {
        return [
        "Render failed: " + str(try r.error catch "unknown error"),
        "This mode needs --allow-exec and chromium/google-chrome/brave/firefox on PATH.",
        "The safe Page/Reader browser modes still work without a host DOM engine.",
        ];
    }
    return [
    "Rendered by host browser snapshot (" + str(try r.cmd catch "renderer") + ").",
    "PNG: " + path,
    "Security: URL policy checked first; Page/Reader remains the no-JS default.",
    ];
}

fn _web_render(state) {
    let resolved = B.browser_input_url(state.web.input, try state.web.search_engine catch "duckduckgo");
    if not (try resolved.ok catch false) { state.web.status = str(try resolved.reason catch "empty input"); return 0; }
    let url = str(try resolved.url catch state.web.input);
    state.web.input = url;
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    if not (try sec.host_render catch false) {
        state.web.mode = "render";
        state.web.scroll = 0;
        state.web.status = "blocked by " + str(try sec.label catch "Safe");
        state.web.title = "Host render blocked by browser security mode";
        state.web.render_img = nil;
        state.web.render_lines = [
        "Host rendering uses an external browser process.",
        "Switch Browser security to JS/DOM or Trusted before Host render.",
        "Live/Reader/Source/Inspect stay pblang-native and no-JS."
        ];
        return 0;
    }
    state.web.mode = "render";
    state.web.scroll = 0;
    state.web.status = "rendering";
    state.web.title = "rendering " + url + " ...";
    state.web.render_img = nil;
    let path = "/tmp/pbide_browser_" + str(now_ms()) + ".png";
    state.web.render_path = path;
    let r = try BR.render_snapshot(url, path, 1280, 800) catch nil;
    state.web.render_lines = _render_lines_from_result(r, path);
    if r != nil and r.ok {
        let img = try IMG.to_thumbnail(path, 420, 260) catch nil;
        state.web.render_img = img;
        state.web.status = "rendered";
        state.web.title = "host render: " + url;
        if img == nil {
            state.web.render_lines = [
            "Rendered PNG: " + path,
            "Thumbnail unavailable: install ImageMagick convert or open the PNG directly.",
            ];
        }
    } else {
        state.web.status = "render failed";
        state.web.title = "host render unavailable";
    }
    return 0;
}

fn _web_key(state, key, shift) {
    let w = state.web;
    if _web_form_key(state, key, shift) { return 0; }
    if (try w.mode catch "") == "find" {
        if key == "Escape" { w.mode = "live"; w.status = "find closed"; return 0; }
        if key == "Backspace" {
            if len(try w.find_query catch "") > 0 { w.find_query = str_slice(w.find_query, 0, len(w.find_query) - 1); }
            w.status = "find " + str(try w.find_query catch "");
            return 0;
        }
        if _is_enter(key) { w.status = "find " + str(try w.find_query catch ""); return 0; }
        let fch = K.key_to_char(key, shift);
        if fch != "" {
            w.find_query = str(try w.find_query catch "") + fch;
            w.status = "find " + str(try w.find_query catch "");
            return 0;
        }
        return 0;
    }
    if _is_enter(key) { _web_load(state); return 0; }
    if key == "F12" { w.security = B.next_security_mode(try w.security catch "safe"); w.status = "security " + str(try B.security_profile(w.security).label catch w.security); return 0; }
    if (try state.ctrl catch false) and (key == "F" or key == "KeyF") { _web_find_open(state); return 0; }
    if (try state.ctrl catch false) and (key == "K" or key == "KeyK") { _web_search_next(state); return 0; }
    if (try state.ctrl catch false) and (key == "D" or key == "KeyD") { _web_bookmark_current(state); return 0; }
    if (try state.ctrl catch false) and (key == "J" or key == "KeyJ") { _web_download_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "Right" or key == "PageRight") { _web_forward(state); return 0; }
    if (try state.ctrl catch false) and (key == "Left" or key == "PageLeft") { _web_back(state); return 0; }
    if (try state.ctrl catch false) and (key == "Home") { _web_home(state); return 0; }
    if (try state.ctrl catch false) and (key == "PageDown") { _web_tabs_step(state, 1); return 0; }
    if (try state.ctrl catch false) and (key == "PageUp") { _web_tabs_step(state, 0 - 1); return 0; }
    if (try state.ctrl catch false) and (key == "T" or key == "KeyT") { _web_tabs_new(state, try w.home catch "example.com"); return 0; }
    if (try state.ctrl catch false) and (key == "I" or key == "KeyI") { _web_stats(state); return 0; }
    if key == "Down" { w.scroll = w.scroll + 3; return 0; }
    if key == "PageDown" { w.scroll = w.scroll + 12; return 0; }
    if key == "Up" { w.scroll = w.scroll - 3; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "PageUp" { w.scroll = w.scroll - 12; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "Backspace" { if len(w.input) > 0 { w.input = str_slice(w.input, 0, len(w.input) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w.input = w.input + ch; }
    return 0;
}

fn _web_button_row_h() {
    return IDE.browser_bar_metrics(CH, PAD).button_h;
}

fn _web_bar_h() {
    return IDE.browser_bar_metrics(CH, PAD).total_h;
}

fn _web_button_fg(state, active) {
    if active { return gfx.rgb(245, 248, 255); }
    return _style_text(state);
}

fn _web_tabs_h(state) {
    let tabs = try state.web.tabs catch [];
    if tabs == nil or len(tabs) == 0 { return 0; }
    return CH + PAD;
}

fn _web_content_top(state) {
    return TOP + _web_bar_h() + _web_tabs_h(state) + 2 * PAD;
}

fn _draw_web_tabs(state, win, sz) {
    let tabs = _web_tabs_ensure(state);
    let h = _web_tabs_h(state);
    if h <= 0 { state.web.tab_layout = []; return 0; }
    let y = TOP + _web_bar_h();
    win.rect(0, y, sz.w, h, _style_surface(state));
    win.rect(0, y + h - SCALE, sz.w, SCALE, _style_border(state));
    let layout = [];
    let addW = 5 * CW;
    let right = sz.w - PAD - addW - PAD;
    let x = PAD;
    let start = try state.web.tab_scroll catch 0;
    if start < 0 { start = 0; }
    if start >= len(tabs) { start = 0; }
    let i = start;
    while i < len(tabs) and x < right {
        let title = _web_tab_title(tabs[i]);
        let tw = (len(title) + 4) * CW;
        if tw < 12 * CW { tw = 12 * CW; }
        if tw > 28 * CW { tw = 28 * CW; }
        if x + tw > right { break; }
        let active = i == (try state.web.tab_sel catch 0);
        let fill = _style_surface2(state);
        if active { fill = _style_accent(state); }
        _button_label(state, win, x, y + PAD / 2, tw, CH + PAD / 2, title, _web_button_fg(state, active), fill, active);
        if active { win.rect(x + RAD, y + h - 2 * SCALE, tw - 2 * RAD, 2 * SCALE, _style_focus(state)); }
        array_push(layout, map{ index: i, x: x, y: y + PAD / 2, w: tw, h: CH + PAD / 2 });
        x = x + tw + PAD;
        i = i + 1;
    }
    let addX = sz.w - PAD - addW;
    _button_label(state, win, addX, y + PAD / 2, addW, CH + PAD / 2, "+", _style_text(state), _style_surface2(state), false);
    state.web.tab_layout = layout;
    state.web.tab_add_rect = map{ x: addX, y: y + PAD / 2, w: addW, h: CH + PAD / 2 };
    return h;
}

fn _web_tabs_click(state, mx, my) {
    let h = _web_tabs_h(state);
    if h <= 0 { return false; }
    let y = TOP + _web_bar_h();
    if my < y or my > y + h { return false; }
    let add = try state.web.tab_add_rect catch nil;
    if add != nil and _hit_button(mx, my, add.x, add.y, add.w, add.h) {
        _web_tabs_new(state, try state.web.home catch "example.com");
        return true;
    }
    let layout = try state.web.tab_layout catch [];
    let i = 0;
    while layout != nil and i < len(layout) {
        let b = layout[i];
        if _hit_button(mx, my, b.x, b.y, b.w, b.h) {
            _web_tabs_activate(state, try b.index catch i);
            return true;
        }
        i = i + 1;
    }
    return true;
}

fn _web_body_geometry(state) {
    let sz = try state.winsz catch nil;
    if sz == nil { return nil; }
    let bodyTop = _web_content_top(state);
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    if (try state.web.title catch "") != "" { bodyTop = bodyTop + CH + 3 * PAD; }
    let rows = num_floor((sz.h - bodyTop - PAD) / CH);
    return map{ body_top: bodyTop, col_x: colX, col_w: colW, rows: rows };
}

fn _web_text_source_for(state, colW) {
    let w = state.web;
    let source = try w.page catch w.reader;
    if w.mode == "reader" { source = w.reader; }
    if w.mode == "links" { source = w.links; }
    if w.mode == "forms" { source = _forms_lines_state(state, colW / CW); }
    if w.mode == "bookmarks" { source = B.bookmark_lines(try w.bookmarks catch [], 80); }
    if w.mode == "stats" { source = B.page_stats_lines(try w.page_obj catch map{ title: "", url: "", text: "", links: [], images: [], forms: [] }); }
    if w.mode == "find" { source = B.page_find_lines(try w.page_obj catch map{ text: "" }, try w.find_query catch "", 80); }
    if w.mode == "source" { source = try w.source catch ["No source loaded."]; }
    if w.mode == "inspect" { source = try w.inspect catch ["No inspector details loaded."]; }
    if w.mode == "render" {
        source = try w.render_lines catch ["Render mode needs --allow-exec and a Chromium-compatible browser."];
    }
    if source == nil { source = w.lines; }
    return source;
}

fn _web_scrollbar_click(state, mx, my) {
    let mode = try state.web.mode catch "live";
    if mode == "live" or mode == "page" { return false; }
    if mode == "render" and (try state.web.render_img catch nil) != nil { return false; }
    let g = _web_body_geometry(state);
    if g == nil { return false; }
    let rows = try g.rows catch 0;
    if rows < 1 { rows = 1; }
    let source = _web_text_source_for(state, try g.col_w catch 80 * CW);
    let sm = map{ body_top: try g.body_top catch TOP, footer_y: state.winsz.h - PAD, row_h: CH };
    let scrollHit = _panel_scrollbar_hit_index(state, sm, len(source), rows, try state.web.scroll catch 0, mx, my);
    if scrollHit < 0 { return false; }
    state.web.scroll = scrollHit;
    state.web.status = "scroll " + str(scrollHit + 1) + "/" + str(len(source));
    return true;
}

fn _web_scroll_by(state, delta) {
    let g = _web_body_geometry(state);
    if g == nil { return false; }
    let rows = try g.rows catch 0;
    if rows < 1 { rows = 1; }
    let mode = try state.web.mode catch "live";
    let total = 0;
    if mode == "live" or mode == "page" {
        let page = try state.web.page_obj catch nil;
        if page == nil { return false; }
        let layout = B.page_layout(page, (try g.col_w catch 80 * CW) / CW);
        total = try layout.height catch 0;
    } else {
        let source = _web_text_source_for(state, try g.col_w catch 80 * CW);
        total = len(source);
    }
    state.web.scroll = _clamp_scroll((try state.web.scroll catch 0) + delta, total, rows);
    state.web.status = "scroll " + str(state.web.scroll + 1) + "/" + str(total);
    return true;
}

fn _web_click(state, mx, my) {
    if _web_tabs_click(state, mx, my) { return 0; }
    let zone = IDE.browser_bar_zone(my, TOP, CH, PAD);
    if zone == "above" { return 0; }
    if zone == "body" {
        if _web_scrollbar_click(state, mx, my) { return 0; }
        if not _web_live_click(state, mx, my) { _web_forms_click(state, mx, my); }
        return 0;
    }
    if zone == "summary" { return 0; }
    let bl = IDE.browser_header_layout(state.winsz.w, CW, PAD);
    if _hit_button(mx, my, bl.back.x, TOP + PAD, bl.back.w, CH + PAD) { _web_back(state); return 0; }
    if _hit_button(mx, my, bl.reload.x, TOP + PAD, bl.reload.w, CH + PAD) { _web_load(state); return 0; }
    let modes = bl.modes;
    let mi = 0;
    while mi < len(modes) {
        let b = modes[mi];
        if _hit_button(mx, my, b.x, TOP + PAD, b.w, CH + PAD) {
            if mi == 0 { state.web.mode = "live"; state.web.scroll = 0; return 0; }
            if mi == 1 { state.web.mode = "reader"; state.web.scroll = 0; return 0; }
            if mi == 2 { state.web.mode = "links"; state.web.scroll = 0; return 0; }
            if mi == 3 { state.web.mode = "forms"; state.web.scroll = 0; return 0; }
            if mi == 4 { state.web.mode = "source"; state.web.scroll = 0; return 0; }
            if mi == 5 { state.web.mode = "inspect"; state.web.scroll = 0; return 0; }
            if mi == 6 { _web_render(state); return 0; }
        }
        mi = mi + 1;
    }
    if _hit_button(mx, my, bl.security.x, TOP + PAD, bl.security.w, CH + PAD) {
        state.web.security = B.next_security_mode(try state.web.security catch "safe");
        let sec = B.security_profile(state.web.security);
        state.web.status = "security " + str(try sec.label catch state.web.security);
        return 0;
    }
    if _hit_button(mx, my, bl.tor.x, TOP + PAD, bl.tor.w, CH + PAD) {
        state.web.tor = not (try state.web.tor catch false);
        if state.web.tor { state.web.status = "Tor enabled"; }
        else { state.web.status = "Tor disabled"; }
        return 0;
    }
    return 0;
}

fn _draw_pixel_image(win, img, x, y, maxw, maxh) {
    if img == nil { return 0; }
    let yy = 0;
    while yy < len(img) and yy < maxh {
        let row = img[yy];
        let xx = 0;
        while xx < len(row) and xx < maxw {
            win.rect(x + xx, y + yy, 1, 1, row[xx]);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return yy;
}

fn _draw_live_block(state, win, x, y, w, kind, text, extra) {
    let bg = _style_surface2(state);
    let fg = _style_pane_text(state);
    let accent = _style_accent(state);
    if kind == "title" { bg = gfx.rgb(35, 47, 78); fg = gfx.rgb(245, 248, 255); }
    else if kind == "h1" { bg = gfx.rgb(30, 58, 90); fg = gfx.rgb(245, 248, 255); }
    else if kind == "h2" { bg = gfx.rgb(28, 50, 74); fg = gfx.rgb(220, 235, 255); }
    else if kind == "img" { bg = gfx.rgb(42, 32, 66); fg = gfx.rgb(230, 210, 255); }
    else if kind == "form" { bg = gfx.rgb(32, 60, 54); fg = gfx.rgb(218, 248, 238); }
    else if kind == "link" { bg = gfx.rgb(28, 54, 84); fg = gfx.rgb(186, 224, 255); }
    if _theme_is_light(state) {
        if kind == "title" { bg = gfx.rgb(220, 232, 250); fg = gfx.rgb(20, 40, 72); }
        else if kind == "h1" { bg = gfx.rgb(228, 238, 252); fg = gfx.rgb(20, 55, 95); }
        else if kind == "h2" { bg = gfx.rgb(235, 243, 252); fg = gfx.rgb(36, 66, 100); }
        else if kind == "img" { bg = gfx.rgb(239, 232, 250); fg = gfx.rgb(74, 50, 112); }
        else if kind == "form" { bg = gfx.rgb(224, 245, 237); fg = gfx.rgb(28, 94, 72); }
        else if kind == "link" { bg = gfx.rgb(224, 238, 252); fg = gfx.rgb(24, 78, 130); }
    }
    let maxchars = (w - 4 * PAD) / CW;
    let prefix = "";
    if kind == "img" { prefix = "[image] "; }
    if kind == "form" { prefix = "[form] "; }
    if kind == "link" { prefix = "[link] "; }
    let lines = _wrap_with_prefix(prefix, text, maxchars);
    let h = (len(lines) + 2) * CH;
    if h < 4 * CH { h = 4 * CH; }
    _card_state(state, win, x, y, w, h, bg, _style_border(state), RAD);
    win.rect(x, y, SCALE * 2, h, accent);
    let label = str_upper(kind);
    _dt(win, x + 2 * PAD, y + PAD / 2, label, _style_muted(state));
    let i = 0;
    while i < len(lines) and i < 12 {
        _dt(win, x + 2 * PAD, y + CH + PAD + i * CH, str_slice(lines[i], 0, maxchars), fg);
        i = i + 1;
    }
    if extra != "" {
        _dt(win, x + 2 * PAD, y + h - CH - PAD / 2, str_slice(extra, 0, maxchars), _style_muted(state));
    }
    return h;
}

fn _draw_web_live(state, win, sz, colX, bodyTop, colW) {
    let page = try state.web.page_obj catch nil;
    if page == nil {
        _dt(win, colX, bodyTop, "Load a page to use pblang Live renderer.", _style_pane_text(state));
        return 0;
    }
    let layout = B.page_layout(page, colW / CW);
    let blocks = try layout.boxes catch [];
    let i = 0;
    while i < len(blocks) and i < 120 {
        let b = blocks[i];
        let kind = str(try b.kind catch "p");
        let txt = str(try b.text catch "");
        let extra = "";
        if kind == "img" { extra = str(try b.src catch ""); }
        if kind == "form" { extra = str(try b.action catch ""); }
        let bx = colX + (try b.x catch 0) * CW;
        let bw = (try b.w catch (colW / CW)) * CW;
        if bw > colW { bw = colW; }
        let by = bodyTop + (try b.y catch 0) * CH - state.web.scroll * CH;
        _draw_live_block(state, win, bx, by, bw, kind, txt, extra);
        i = i + 1;
    }
    if len(blocks) == 0 {
        _dt(win, colX, bodyTop, "No native page blocks extracted. Try Reader or Source.", _style_pane_text(state));
    }
    return 0;
}

fn _draw_web(state, win, sz) {
    let w = state.web;
    let maxchars = (sz.w - 2 * PAD) / CW;
    // web IDE browser bar
    let barh = _web_bar_h();
    win.rect(0, TOP, sz.w, barh, _style_surface(state));
    win.rect(0, TOP, 2 * SCALE, barh, _style_accent(state));
    win.rect(0, TOP + barh, sz.w, SCALE, _style_border(state));
    let bl = IDE.browser_header_layout(sz.w, CW, PAD);
    _button_label(state, win, bl.back.x, TOP + PAD, bl.back.w, CH + PAD, bl.back.label, _style_text(state), _style_surface2(state), false);
    _button_label(state, win, bl.reload.x, TOP + PAD, bl.reload.w, CH + PAD, bl.reload.label, _style_text(state), _style_surface2(state), false);
    let mbg = _style_surface2(state);
    let abg = _style_accent(state);
    let a0 = w.mode == "live" or w.mode == "page";
    let a1 = w.mode == "reader";
    let a2 = w.mode == "links";
    let a3 = w.mode == "forms";
    let a4 = w.mode == "source";
    let a5 = w.mode == "inspect";
    let a6 = w.mode == "render";
    let bg0 = mbg; if a0 { bg0 = abg; }
    let bg1 = mbg; if a1 { bg1 = abg; }
    let bg2 = mbg; if a2 { bg2 = abg; }
    let bg3 = mbg; if a3 { bg3 = abg; }
    let bg4 = mbg; if a4 { bg4 = abg; }
    let bg5 = mbg; if a5 { bg5 = abg; }
    let bg6 = mbg; if a6 { bg6 = abg; }
    let modeRects = bl.modes;
    let active = [a0, a1, a2, a3, a4, a5, a6];
    let fills = [bg0, bg1, bg2, bg3, bg4, bg5, bg6];
    let mi = 0;
    while mi < len(modeRects) {
        let mb = modeRects[mi];
        _button_label(state, win, mb.x, TOP + PAD, mb.w, CH + PAD, mb.label, _web_button_fg(state, active[mi]), fills[mi], active[mi]);
        mi = mi + 1;
    }
    let sec = B.security_profile(try w.security catch "safe");
    let secLabel = "Sec:" + str(try sec.label catch "Safe");
    let secBg = _style_surface2(state);
    let secMode = try sec.mode catch "safe";
    if secMode == "live" {
        secBg = gfx.rgb(30, 80, 72);
        if _theme_is_light(state) { secBg = gfx.rgb(214, 241, 232); }
    }
    if secMode == "jsdom" {
        secBg = gfx.rgb(44, 74, 104);
        if _theme_is_light(state) { secBg = gfx.rgb(218, 235, 250); }
    }
    if secMode == "trusted" {
        secBg = gfx.rgb(90, 64, 34);
        if _theme_is_light(state) { secBg = gfx.rgb(250, 232, 204); }
    }
    if secMode == "tor" {
        secBg = gfx.rgb(58, 47, 91);
        if _theme_is_light(state) { secBg = gfx.rgb(232, 224, 247); }
    }
    let secActive = (try sec.mode catch "safe") != "safe";
    _button_label(state, win, bl.security.x, TOP + PAD, bl.security.w, CH + PAD, str_slice(secLabel, 0, 12), _web_button_fg(state, secActive), secBg, secActive);
    let torBg = _style_surface2(state);
    let torText = "Tor:off";
    if try w.tor catch false { torBg = gfx.rgb(58, 47, 91); torText = "Tor:on"; }
    _button_label(state, win, bl.tor.x, TOP + PAD, bl.tor.w, CH + PAD, torText, _web_button_fg(state, try w.tor catch false), torBg, try w.tor catch false);
    let urlX = bl.url_x;
    let urlW = bl.url_w;
    if urlW > 10 * CW {
        _button_face(state, win, urlX, TOP + PAD, urlW, CH + PAD, _style_surface2(state), false);
    }
    let searchProf = B.search_engine_profile(try w.search_engine catch "duckduckgo");
    let addr = "URL › [" + str(try searchProf.label catch "Search") + "] " + w.input;
    let urlChars = urlW / CW - 2;
    if urlChars > 4 { _dt(win, urlX + CW, TOP + PAD + PAD / 2, str_slice(addr, 0, urlChars), _style_text(state)); }
    let cursorCol = len(addr);
    let cur = cursorCol; if cur > urlChars { cur = urlChars; }
    if urlChars > 4 { win.rect(urlX + CW + cur * CW, TOP + PAD + PAD / 2, SCALE, CH - SCALE, CURSOR); }
    if not (try bl.compact catch false) {
        _dt(win, bl.status_x, TOP + PAD + PAD / 2, try w.status catch "ready", _style_muted(state));
    }
    let summaryMode = try w.security catch "safe";
    if try w.tor catch false { summaryMode = "tor"; }
    let secSummary = B.security_summary(summaryMode);
    let nativeSummary = B.native_interaction_summary(summaryMode);
    let sumY = TOP + CH + 2 * PAD;
    let sumH = 2 * (CH + PAD);
    win.rect(PAD, sumY, sz.w - 2 * PAD, sumH, _style_panel(state));
    win.rect(PAD, sumY, SCALE * 2, sumH, secBg);
    _dt(win, PAD + CW, sumY + PAD / 2, str_slice(secSummary, 0, maxchars - 2), _style_muted(state));
    _dt(win, PAD + CW, sumY + CH + PAD, str_slice(nativeSummary, 0, maxchars - 2), _style_info(state));

    _draw_web_tabs(state, win, sz);
    let bodyTop = _web_content_top(state);
    win.rect(0, bodyTop - PAD, sz.w, sz.h - bodyTop + PAD, _style_bg(state));
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    win.rect(colX - PAD, bodyTop, colW + 2 * PAD, sz.h - bodyTop - PAD, _style_panel(state));
    if w.title != "" { _dt(win, colX, bodyTop + PAD, str_slice(w.title, 0, colW / CW), _style_accent(state)); bodyTop = bodyTop + CH + 3 * PAD; }
    if w.mode == "live" or w.mode == "page" {
        _draw_web_live(state, win, sz, colX, bodyTop, colW);
        return 0;
    }
    let source = try w.page catch w.reader;
    if w.mode == "reader" { source = w.reader; }
    if w.mode == "links" { source = w.links; }
    if w.mode == "forms" { source = _forms_lines_state(state, colW / CW); }
    if w.mode == "bookmarks" { source = B.bookmark_lines(try w.bookmarks catch [], 80); }
    if w.mode == "stats" { source = B.page_stats_lines(try w.page_obj catch map{ title: "", url: "", text: "", links: [], images: [], forms: [] }); }
    if w.mode == "find" { source = B.page_find_lines(try w.page_obj catch map{ text: "" }, try w.find_query catch "", 80); }
    if w.mode == "source" { source = try w.source catch ["No source loaded."]; }
    if w.mode == "inspect" { source = try w.inspect catch ["No inspector details loaded."]; }
    if w.mode == "render" {
        let img = try w.render_img catch nil;
        if img != nil {
            let used = _draw_pixel_image(win, img, colX, bodyTop, colW, 320);
            bodyTop = bodyTop + used + 2 * PAD;
        }
        source = try w.render_lines catch ["Render mode needs --allow-exec and a Chromium-compatible browser."];
    }
    if source == nil { source = w.lines; }
    let rows = (sz.h - bodyTop - PAD) / CH;
    if w.scroll > len(source) - 1 { if len(source) > 0 { w.scroll = len(source) - 1; } else { w.scroll = 0; } }
    let vr = 0;
    while w.scroll + vr < len(source) and vr < rows {
        let ln = source[w.scroll + vr];
        let col = _style_pane_text(state);
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = _style_accent(state); }     // '>' link line
        if str_starts_with(ln, "#") { col = _style_accent(state); }
        if str_starts_with(ln, "[image]") {
            col = gfx.rgb(210, 168, 255);
            if _theme_is_light(state) { col = gfx.rgb(108, 72, 150); }
        }
        _dt(win, colX, bodyTop + vr * CH, str_slice(ln, 0, colW / CW), col);
        vr = vr + 1;
    }
    let sm = map{ body_top: bodyTop, footer_y: sz.h - PAD };
    _draw_panel_scrollbar(state, win, sz, sm, len(source), rows, w.scroll);
}

// ── History panel: web-IDE-style run/check snapshots with click-to-restore ─────────

fn _history_storage_dir() {
    let home = try env_get("HOME") catch "";
    if home == nil or str(home) == "" { return ".pblang"; }
    return str(home) + "/.pblang";
}

fn _history_storage_path() {
    return _history_storage_dir() + "/pbide-history.json";
}

fn _history_load_persistent() {
    let raw = try fs_read(_history_storage_path()) catch "";
    if raw == nil or str_trim(str(raw)) == "" { return []; }
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil { return []; }
    if type(parsed) != "array" { return []; }
    return parsed;
}

fn _history_save_persistent(state) {
    state.history_mode = "permanent";
    let dir = _history_storage_dir();
    try fs_mkdirs(dir) catch nil;
    let path = _history_storage_path();
    let payload = json_stringify(try state.history catch []);
    let ok = try fs_write(path, payload) catch false;
    if ok == nil { ok = false; }
    if ok {
        state.history = IDE.history_mark_stored(try state.history catch [], true);
        state.history_stored = true;
        state.output = "history saved: " + path;
    } else {
        state.history_stored = false;
        state.output = "history save FAILED: " + path;
    }
    return state.output;
}

fn _history_toggle_store(state) {
    state.history_mode = IDE.history_mode_next(try state.history_mode catch "temporary");
    if state.history_mode == "permanent" {
        _history_save_persistent(state);
    } else {
        state.history_stored = false;
        state.output = "history mode: Temporary (memory only)";
    }
    return state.output;
}

fn _history_storage_summary(state) {
    return IDE.history_storage_summary(try state.history catch [], try state.history_mode catch "temporary", try state.history_stored catch false, _history_storage_path());
}

fn _history_clear(state) {
    state.history = [];
    state.history_query = "";
    state.history_sel = 0;
    state.output = "history cleared";
    if str(try state.history_mode catch "temporary") == "permanent" {
        _history_save_persistent(state);
        state.output = "history cleared and saved";
    }
    return 0;
}

fn _history_delete_selected(state) {
    let hits = _history_clamp(state);
    if len(hits) == 0 {
        state.output = "history delete: no selected snapshot";
        return 0;
    }
    let sel = try state.history_sel catch 0;
    let result = IDE.history_delete_selected(try state.history catch [], hits, sel);
    if not (try result.ok catch false) {
        state.output = "history delete: no selected snapshot";
        return 0;
    }
    let removed = try result.removed catch map{};
    state.history = try result.history catch [];
    state.history_sel = IDE.selection_move(sel, len(_history_hits(state)), "down", 10);
    state.history_stored = false;
    let msg = "history deleted #" + str((try result.removed_index catch 0) + 1) + " " + str_upper(str(try removed.action catch "?"));
    state.output = msg;
    if str(try state.history_mode catch "temporary") == "permanent" {
        _history_save_persistent(state);
        state.output = msg + " and saved";
    }
    return 0;
}

fn _history_hits(state) {
    return IDE.filter_history(try state.history catch [], try state.history_query catch "", 200);
}

fn _history_clamp(state) {
    let hits = _history_hits(state);
    if (try state.history_sel catch 0) < 0 { state.history_sel = 0; }
    if len(hits) == 0 { state.history_sel = 0; return hits; }
    if (try state.history_sel catch 0) >= len(hits) { state.history_sel = len(hits) - 1; }
    return hits;
}

fn _history_restore(state, hit) {
    _replace_editor(state, try hit.code catch E.text(state.ed));
    state.panel = "code";
    state.output = "loaded history snapshot #" + str((try hit.index catch 0) + 1) + " (" + str(try hit.action catch "?") + ")";
    return 0;
}

fn _history_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if (try state.ctrl catch false) and (key == "S" or key == "KeyS") { _history_save_persistent(state); return 0; }
    if key == "S" or key == "s" or key == "KeyS" { _history_toggle_store(state); return 0; }
    if key == "C" or key == "c" or key == "KeyC" or ((try state.ctrl catch false) and key == "Delete") {
        _history_clear(state);
        return 0;
    }
    if shift and key == "Delete" { _history_delete_selected(state); return 0; }
    let n = len(_history_hits(state));
    if key == "Home" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "home", 10); return 0; }
    if key == "End" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "previous", 10); return 0; }
    if key == "Down" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "down", 10); return 0; }
    if key == "Up" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "up", 10); return 0; }
    if key == "PageDown" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "page_up", 10); return 0; }
    if key == "Delete" { state.history_query = ""; state.history_sel = 0; return 0; }
    if key == "Backspace" {
        if len(try state.history_query catch "") > 0 { state.history_query = str_slice(state.history_query, 0, len(state.history_query) - 1); }
        state.history_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _history_clamp(state);
        if len(hits) > 0 { _history_restore(state, hits[try state.history_sel catch 0]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.history_query = (try state.history_query catch "") + ch;
        state.history_sel = 0;
    }
    return 0;
}

fn _history_buttons(sz) {
    let y = TOP + CH + 4 * PAD + PAD / 2;
    let h = CH + PAD;
    let clearW = 11 * CW;
    let delW = 14 * CW;
    let clearX = sz.w - PAD - clearW;
    let delX = clearX - PAD - delW;
    return [
    map{ id: "delete", label: "Delete Sel", x: delX, y: y, w: delW, h: h },
    map{ id: "clear", label: "Clear All", x: clearX, y: y, w: clearW, h: h }
    ];
}

fn _history_button_hit(state, mx, my) {
    let buttons = _history_buttons(state.winsz);
    let i = 0;
    while i < len(buttons) {
        let b = buttons[i];
        if _hit_button(mx, my, b.x, b.y, b.w, b.h) { return b.id; }
        i = i + 1;
    }
    return "";
}

fn _draw_history(state, win, sz) {
    let m = _panel_metrics(sz, "history");
    let maxchars = m.max_chars;
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Run / Check History", _style_accent(state));
    if m.hint_mode == "full" {
        _dt(win, PAD + 24 * CW, TOP + PAD, "type filter · S temp/permanent · Ctrl+S save · Enter load", _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let q = "Search: " + (try state.history_query catch "") + "   " +
    IDE.history_filter_status(try state.history catch [], try state.history_query catch "", try state.history_sel catch 0) +
    "   " + _history_storage_summary(state);
    let shown = str_slice(q, 0, maxchars - 32);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);
    let buttons = _history_buttons(sz);
    let bi = 0;
    while bi < len(buttons) {
        let b = buttons[bi];
        let fill = _style_panel(state);
        if b.id == "clear" { fill = gfx.rgb(72, 44, 52); }
        if b.id == "clear" and _theme_is_light(state) { fill = gfx.rgb(248, 226, 226); }
        if b.id == "delete" { fill = _style_surface(state); }
        _button_label(state, win, b.x, b.y, b.w, b.h, b.label, _style_text(state), fill, b.id == "delete");
        bi = bi + 1;
    }

    let bodyTop = m.body_top;
    let hits = _history_clamp(state);
    let i = 0;
    if len(hits) == 0 {
        let msg = "No run/check history yet.";
        if len(try state.history catch []) > 0 { msg = "No history snapshots match the filter."; }
        _dt(win, PAD, bodyTop, msg, _style_error(state));
    }
    let start = _list_start_for(try state.history_sel catch 0, len(hits), m.rows);
    i = 0;
    while start + i < len(hits) and i < m.rows {
        let y = bodyTop + i * m.row_h;
        let actual = start + i;
        if actual == (try state.history_sel catch 0) { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
        if i % 2 == 0 { win.rect(0, y, sz.w, CH, _style_row_rule(state)); }
        let h = hits[actual];
        let badge = "FAIL";
        if try h.ok catch false { badge = "OK"; }
        let line = str((try h.index catch actual) + 1) + ". " + str_upper(str(try h.action catch "?")) +
        " " + badge + "  " + str(try h.summary catch try h.output catch "");
        let col = _style_pane_text(state);
        if badge == "FAIL" { col = _style_error(state); }
        if badge == "OK" { col = _style_success(state); }
        _dt(win, PAD, y, str_slice(line, 0, maxchars), col);
        i = i + 1;
    }
    _draw_panel_scrollbar(state, win, sz, m, len(hits), m.rows, start);

    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    _dt(win, PAD, footerY + PAD / 2, "History: Enter restore. Shift+Delete/Delete Sel removes selected. C/Clear All removes all. Delete clears filter.", _style_muted(state));
}

fn _history_click(state, mx, my) {
    let bid = _history_button_hit(state, mx, my);
    if bid == "delete" { _history_delete_selected(state); return 0; }
    if bid == "clear" { _history_clear(state); return 0; }
    if state.winsz != nil and my >= state.winsz.h - STATUSH {
        _history_clear(state);
        return 0;
    }
    let m = _panel_metrics(state.winsz, "history");
    let bodyTop = m.body_top;
    if my < bodyTop { return 0; }
    let hits = _history_clamp(state);
    let start = _list_start_for(try state.history_sel catch 0, len(hits), m.rows);
    let scrollHit = _panel_scrollbar_hit_index(state, m, len(hits), m.rows, start, mx, my);
    if scrollHit >= 0 {
        state.history_sel = scrollHit;
        return 0;
    }
    let idx = num_floor((my - bodyTop) / m.row_h);
    idx = idx + _list_start_for(try state.history_sel catch 0, len(hits), m.rows);
    if idx < 0 or idx >= len(hits) { return 0; }
    state.history_sel = idx;
    _history_restore(state, hits[idx]);
    return 0;
}

// ── Management panel: database/storage/project management dashboard ─────────

fn _project_portfolio_paths(state) {
    let paths = [
    ".",
    "editors/ide",
    "stdlib",
    "tests/semantics",
    "../../ai/pbai",
    "../../os-dev/pbos",
    "../../tools/pblang/pb-mcp-server",
    "../../tools/rust/pb-mcp-server",
    "/usr/share/vulkan",
    "/usr/share/mesa-demos"
    ];
    let roots = try state.files.roots catch [];
    let i = 0;
    while i < len(roots) {
        array_push(paths, roots[i]);
        i = i + 1;
    }
    return paths;
}

fn _manage_records(state) {
    let hstate = IDE.history_storage_state(try state.history catch [], try state.history_mode catch "temporary", try state.history_stored catch false, _history_storage_path());
    let bstate = IDE.browser_management_state(try state.web.bookmarks catch [], try state.web.download_plans catch [], try state.web.security catch "safe", try state.web.tor catch false, try state.web.search_engine catch "duckduckgo");
    let dstate = IDE.database_management_state(try state.database.profiles catch [], try state.database.migrations catch [], try state.database.backups catch []);
    let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
    let ab = IDE.asset_backend_status(profile);
    let gp = try gfx.backend_profile() catch map{ backend: "unknown", present: "unknown", gpu_present: false, compiled_sdl2: false, note: "graphics profile unavailable" };
    let route = try gfx.render_route_status(gp) catch "";
    let accel = try gfx.render_acceleration_plan(gp) catch map{ parallel_safe_path: "unknown", polyglot_safe_path: "unknown" };
    let frame_plan = try _frame_schedule_for_state(state, gp) catch nil;
    let device_policy = try gfx.render_device_policy(gp, map{ target_fps: 60, pressure: try frame_plan.quality_pressure catch "ok" }) catch map{ summary: "device-policy unavailable" };
    let startup_profile = try gfx.render_startup_profile("fast", gp, map{ target_fps: 60, pressure: try frame_plan.quality_pressure catch "ok" }) catch map{ summary: "startup-profile unavailable" };
    let frame_status = "";
    if frame_plan != nil { frame_status = " · " + str(try frame_plan.summary catch "frame schedule unknown"); }
    let quality_status = "";
    if frame_plan != nil { quality_status = " · " + str(try frame_plan.quality_policy.summary catch "render quality unknown"); }
    let runtime_status = "";
    if frame_plan != nil { runtime_status = " · " + str(try frame_plan.runtime_plan.summary catch "render runtime unknown"); }
    let text_status = _text_render_status_for_state(state);
    let portfolio = IDE.project_portfolio_board(_project_portfolio_paths(state));
    let product_health = IDE.project_product_health_board(_project_portfolio_paths(state));
    let action = IDE.project_action_board(_project_portfolio_paths(state));
    let category_health = IDE.project_category_health_board(_project_portfolio_paths(state));
    return IDE.management_records(map{
        database_status: str(try dstate.status catch "empty"),
        database_detail: IDE.database_management_state(try state.database.profiles catch [], try state.database.migrations catch [], try state.database.backups catch []).summary + " · actions are gated plans",
        history_status: str(try hstate.status catch "temporary"),
        history_detail: _history_storage_summary(state),
        files_status: "active",
        browser_status: str(try bstate.route catch try state.web.security catch "safe"),
        browser_detail: IDE.browser_management_summary(bstate),
        browser_data_status: str(try bstate.status catch "empty"),
        browser_data_detail: "bookmarks " + str(try bstate.bookmarks catch 0) + " · download plans " + str(try bstate.downloads catch 0) + " · search " + str(try bstate.search_engine catch "duckduckgo"),
        asset_status: str(try ab.decode_status catch "planned") + "/" + str(try ab.export_status catch "planned"),
        asset_detail: IDE.asset_backend_summary(profile) + " · " + str_join(try ab.actions catch [], ", "),
        ai_status: "local",
        backup_status: "planned",
        graphics_status: str(try gp.backend catch "unknown") + "/" + str(try gp.present catch "unknown"),
        graphics_detail: _graphics_status() + " · " + text_status + " · " + _graphics_event_status() + " · " + (try gfx.cpu_render_status(gp) catch "cpu-render unknown") + " · " + route + " · " + (try gfx.render_device_policy_status(device_policy) catch str(try device_policy.summary catch "device-policy unknown")) + " · " + (try gfx.render_startup_profile_status(startup_profile) catch str(try startup_profile.summary catch "startup-profile unknown")) + frame_status + quality_status + runtime_status + " · " + _perf_summary(state) + " · parallel=" + str(try accel.parallel_safe_path catch "unknown") + " · polyglot=" + str(try accel.polyglot_safe_path catch "unknown") + " · compiled_sdl2=" + str(try gp.compiled_sdl2 catch false) + " · " + str(try gp.note catch ""),
        runtime_budget: map{
            status: "active",
            detail: "child apps use bounded resources plus attempts/backoff/deadline/cancellation/circuit policy before preview or run"
        },
        project_portfolio: portfolio,
        project_product_health: product_health,
        project_action: action,
        project_category_health: category_health,
        project_aap_status: map{
            status: "on-demand",
            detail: "press Enter to run a bounded AAP source/docs status pass"
        }
    });
}

fn _manage_hits(state) {
    return IDE.filter_management_records(_manage_records(state), try state.manage.query catch "", 200);
}

fn _manage_clamp(state) {
    let hits = _manage_hits(state);
    if (try state.manage.sel catch 0) < 0 { state.manage.sel = 0; }
    if len(hits) == 0 { state.manage.sel = 0; return hits; }
    if (try state.manage.sel catch 0) >= len(hits) { state.manage.sel = len(hits) - 1; }
    return hits;
}

fn _manage_open(state, hit) {
    let id = str(try hit.id catch "");
    if id == "database" {
        let profiles = try state.database.profiles catch [];
        let profile = IDE.database_profile("local", "sqlite", "", "readonly");
        if len(profiles) > 0 { profile = profiles[0]; }
        let plan = IDE.database_action_plan("backup", profile, "choose-output-path");
        state.output = "management -> database\n" +
        str(try hit.detail catch "") + "\n" +
        "plan: " + str(try plan.action catch "backup") + " " + str(try plan.profile catch "database") +
        " · executable=" + str(try plan.executable catch false) +
        " · requires: " + str_join(try plan.requires catch [], ", ");
        return 0;
    }
    if id == "history" {
        state.panel = "hist";
        state.output = _history_storage_summary(state);
        return 0;
    }
    if id == "files" {
        state.panel = "files";
        state.output = "management -> files";
        return 0;
    }
    if id == "browser" {
        state.panel = "web";
        state.output = "management -> browser security";
        return 0;
    }
    if id == "browser_data" {
        state.panel = "web";
        state.web.mode = "bookmarks";
        state.web.status = "browser data";
        let bstate = IDE.browser_management_state(try state.web.bookmarks catch [], try state.web.download_plans catch [], try state.web.security catch "safe", try state.web.tor catch false, try state.web.search_engine catch "duckduckgo");
        state.output = "management -> browser data: " + IDE.browser_management_summary(bstate);
        return 0;
    }
    if id == "asset_backends" {
        let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
        let plan = IDE.asset_action_plan("decode", profile, str(try state.path catch ""));
        state.output = "management -> document/media backends\n" +
        IDE.asset_backend_summary(profile) + "\n" +
        "decode executable: " + str(try plan.executable catch false) +
        " · requires: " + str_join(try plan.requires catch [], ", ");
        return 0;
    }
    if id == "models" {
        state.panel = "ai";
        state.output = "management -> local AI";
        return 0;
    }
    if id == "graphics" {
        let gp = try gfx.backend_profile() catch nil;
        let accel = try gfx.render_acceleration_plan(gp) catch nil;
        let frame_plan = try _frame_schedule_for_state(state, gp) catch nil;
        let device_policy = try gfx.render_device_policy(gp, map{ target_fps: 60, pressure: try frame_plan.quality_pressure catch "ok" }) catch nil;
        let startup_profile = try gfx.render_startup_profile("fast", gp, map{ target_fps: 60, pressure: try frame_plan.quality_pressure catch "ok" }) catch nil;
        let steps = [];
        if accel != nil { steps = try accel.steps catch []; }
        let frame_lines = [];
        if frame_plan != nil { frame_lines = IDE.ide_render_frame_lines(frame_plan, 6); }
        let quality_lines = [];
        if frame_plan != nil { quality_lines = IDE.ide_render_quality_policy_lines(try frame_plan.quality_policy catch nil, 6); }
        let runtime_lines = [];
        if frame_plan != nil { runtime_lines = IDE.ide_render_runtime_plan_lines(try frame_plan.runtime_plan catch nil, 6); }
        let device_steps = [];
        if device_policy != nil { device_steps = try device_policy.steps catch []; }
        state.output = "management -> graphics runtime\n" + _graphics_status() + "\n" + _text_render_status_for_state(state) + "\n" + _graphics_event_status() + "\n" + (try gfx.cpu_render_status(gp) catch "cpu-render unknown") + "\n" + (try gfx.render_route_status(gp) catch "route unknown") + "\n" + (try gfx.render_device_policy_status(device_policy) catch "device-policy unknown") + "\nlaunch env: " + str(try device_policy.env catch map{}) + "\nstartup profile: " + (try gfx.render_startup_profile_status(startup_profile) catch "startup-profile unknown") + "\nstartup env: " + str_join(try gfx.render_startup_env_lines(startup_profile) catch [], " ") + "\n" + _perf_summary(state) + "\nparallel: " + str(try accel.parallel_safe_path catch "unknown") + "\npolyglot: " + str(try accel.polyglot_safe_path catch "unknown") + "\nnext: " + str_join(steps, " | ");
        if len(device_steps) > 0 { state.output = state.output + "\ndevice next: " + str_join(device_steps, " | "); }
        if len(frame_lines) > 0 { state.output = state.output + "\n" + str_join(frame_lines, "\n"); }
        if len(quality_lines) > 0 { state.output = state.output + "\n" + str_join(quality_lines, "\n"); }
        if len(runtime_lines) > 0 { state.output = state.output + "\n" + str_join(runtime_lines, "\n"); }
        return 0;
    }
    if id == "project_portfolio" {
        let board = IDE.project_portfolio_board(_project_portfolio_paths(state));
        state.output = str_join(IDE.project_portfolio_lines(board, 14), "\n");
        return 0;
    }
    if id == "project_product_health" {
        let board = IDE.project_product_health_board(_project_portfolio_paths(state));
        state.output = str_join(IDE.project_product_health_lines(board, 14), "\n");
        return 0;
    }
    if id == "runtime_budget" {
        let profile = IDE.app_run_profile(E.text(state.ed), str(try state.path catch "main.sapp"));
        let safety = IDE.app_run_safety_profile(profile, nil);
        let report = IDE.app_run_resource_report(safety, map{});
        state.output = "Runtime safety\n" + str(try hit.detail catch "") + "\n" +
        "timeout=" + str(safety.timeout_ms) + "ms workers=" + str(safety.resource_budget.limits.workers) +
        " frames=" + str(try safety.resource_budget.limits.frames catch 0) + "\n" + str(report.summary) + "\n" +
        "resilience attempts=" + str(safety.resilience_policy.max_attempts) +
        " backoff=" + str(safety.resilience_policy.base_delay_ms) + ".." + str(safety.resilience_policy.max_delay_ms) + "ms" +
        " circuit=" + str(safety.resilience_policy.failure_threshold) + "/" + str(safety.resilience_policy.recovery_ms) + "ms";
        return 0;
    }
    if id == "project_action" {
        let board = IDE.project_action_board(_project_portfolio_paths(state));
        state.output = str_join(IDE.project_action_lines(board, 16), "\n");
        return 0;
    }
    if id == "project_category_health" {
        let board = IDE.project_category_health_board(_project_portfolio_paths(state));
        state.output = str_join(IDE.project_category_health_lines(board, 18), "\n");
        return 0;
    }
    if id == "project_aap_status" {
        let board = IDE.project_aap_status_board(nil, map{
            max_depth: 2,
            max_entries: 120,
            max_children_per_dir: 80,
            max_files: 10,
            max_file_bytes: 10000,
            max_findings: 40,
            include_portfolio: false,
            focus_detail_lines: 8,
            require_allocation_bounded: true
        });
        state.output = str_join(IDE.project_aap_status_lines(board, 14), "\n") +
        "\n\n" + str_join(IDE.project_aap_focus_lines(board, 10), "\n");
        return 0;
    }
    state.output = "management: " + str(try hit.title catch id) + " · " + str(try hit.detail catch "");
    return 0;
}

fn _manage_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    let n = len(_manage_hits(state));
    if key == "Home" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "home", 10); return 0; }
    if key == "End" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "previous", 10); return 0; }
    if key == "Down" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "down", 10); return 0; }
    if key == "Up" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "up", 10); return 0; }
    if key == "PageDown" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "page_up", 10); return 0; }
    if key == "Delete" { state.manage.query = ""; state.manage.sel = 0; return 0; }
    if key == "Backspace" {
        if len(try state.manage.query catch "") > 0 { state.manage.query = str_slice(state.manage.query, 0, len(state.manage.query) - 1); }
        state.manage.sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _manage_clamp(state);
        if len(hits) > 0 { _manage_open(state, hits[try state.manage.sel catch 0]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.manage.query = (try state.manage.query catch "") + ch;
        state.manage.sel = 0;
    }
    return 0;
}

fn _draw_manage(state, win, sz) {
    let m = _panel_metrics(sz, "manage");
    let maxchars = m.max_chars;
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Management / Databases", _style_accent(state));
    if m.hint_mode == "full" {
        _dt(win, PAD + 28 * CW, TOP + PAD, "database · storage · files · browser · AI · backups", _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let records = _manage_records(state);
    let q = "Search: " + (try state.manage.query catch "") + "   " +
    IDE.management_filter_status(records, try state.manage.query catch "", try state.manage.sel catch 0);
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = m.body_top;
    let hits = _manage_clamp(state);
    let i = 0;
    if len(hits) == 0 {
        _dt(win, PAD, bodyTop, "No management areas match the filter.", _style_error(state));
    }
    let start = _list_start_for(try state.manage.sel catch 0, len(hits), m.rows);
    while start + i < len(hits) and i < m.rows {
        let y = bodyTop + i * m.row_h;
        let actual = start + i;
        if actual == (try state.manage.sel catch 0) { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
        let h = hits[actual];
        let head = str((try h.index catch actual) + 1) + ". [" + str(try h.group catch "?") + "] " + str(try h.title catch "?") +
        " · " + str(try h.status catch "");
        _dt(win, PAD, y, str_slice(head, 0, maxchars), _style_pane_text(state));
        _dt(win, PAD + 2 * CW, y + CH, str_slice(str(try h.detail catch ""), 0, maxchars - 2), _style_muted(state));
        i = i + 1;
    }
    _draw_panel_scrollbar(state, win, sz, m, len(hits), m.rows, start);

    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    _dt(win, PAD, footerY + PAD / 2, "Management: Enter opens selected area. Database management is planned; History storage is active now.", _style_muted(state));
}

fn _manage_click(state, mx, my) {
    let m = _panel_metrics(state.winsz, "manage");
    let bodyTop = m.body_top;
    if my < bodyTop { return 0; }
    let hits = _manage_clamp(state);
    let start = _list_start_for(try state.manage.sel catch 0, len(hits), m.rows);
    let scrollHit = _panel_scrollbar_hit_index(state, m, len(hits), m.rows, start, mx, my);
    if scrollHit >= 0 {
        state.manage.sel = scrollHit;
        return 0;
    }
    let idx = num_floor((my - bodyTop) / m.row_h);
    idx = idx + _list_start_for(try state.manage.sel catch 0, len(hits), m.rows);
    if idx < 0 or idx >= len(hits) { return 0; }
    state.manage.sel = idx;
    _manage_open(state, hits[idx]);
    return 0;
}

// ── Settings panel: searchable native IDE preferences dashboard ─────────────

fn _settings_ensure(state) {
    if (try state.settings catch nil) == nil { state.settings = map{ query: "", sel: 0 }; }
    return state.settings;
}

fn _settings_density_status(state) {
    let manual = try state.density_manual catch nil;
    if manual != nil { return "manual " + str(manual) + "x"; }
    return "auto " + str(try state.density_scale catch SCALE) + "x · " + _window_probe_status(state);
}

fn _settings_records(state) {
    let gp = try gfx.backend_profile() catch map{ backend: "unknown", present: "unknown", gpu_present: false };
    let device_policy = try gfx.render_device_policy(gp, map{ target_fps: 60, pressure: try state.render_runtime.pressure catch "ok" }) catch nil;
    let startup_profile = try gfx.render_startup_profile("fast", gp, map{ target_fps: 60, pressure: try state.render_runtime.pressure catch "ok" }) catch nil;
    let browser_route = str(try state.web.security catch "safe") + " / " + str(try state.web.search_engine catch "duckduckgo");
    let text_status = _text_render_status_for_state(state);
    return [
    map{ id: "theme", group: "Appearance", title: "Theme", status: _theme_label(state), detail: "Click/Enter toggles Light/Dark using the same command as the toolbar Theme button." },
    map{ id: "style", group: "Appearance", title: "Visual style", status: _style_name(state), detail: "Click/Enter cycles Web, Smooth, Crystal, and Contrast without changing the active panel." },
    map{ id: "density_auto", group: "Display", title: "Responsive density", status: _settings_density_status(state), detail: "Click/Enter resets density to auto. Ctrl+- / Ctrl+= still adjust manual density." },
    map{ id: "density_refresh", group: "Display", title: "Refresh window scale", status: str(try state.live_winsz.w catch "?") + "x" + str(try state.live_winsz.h catch "?"), detail: "Click/Enter reprobes the visible window/display size and reapplies responsive scaling." },
    map{ id: "build", group: "Build", title: "Debug / Release mode", status: str(try state.build_mode catch "debug"), detail: "Click/Enter toggles the same build mode as F11. Debug checks before running; Release runs directly." },
    map{ id: "watcher", group: "Safety", title: "Watcher", status: _watch_badge(state), detail: "Click/Enter toggles the same watcher as F12. It tracks dirty state, diagnostics, revision, and safety actions." },
    map{ id: "browser", group: "Browser", title: "Browser security and search", status: browser_route, detail: "Opens Browser. Use command palette or Browser controls for Safe/Live/JS-DOM/Trusted/Tor and search-engine cycling." },
    map{ id: "files", group: "Workspace", title: "Files and project roots", status: str(try state.files.mode catch "flat"), detail: "Opens Files. It manages roots, recent files, previews, transfer plans, and safe operation plans." },
    map{ id: "history", group: "Storage", title: "History storage", status: str(try state.history_mode catch "temporary"), detail: _history_storage_summary(state) },
    map{ id: "font", group: "Text", title: "Font and text renderer", status: str(try TEXT_PROFILE.renderer catch TEXT_MODE), detail: text_status },
    map{ id: "graphics", group: "Runtime", title: "Graphics / GPU route", status: str(try gp.backend catch "unknown") + "/" + str(try gp.present catch "unknown"), detail: _graphics_status() + " · " + (try gfx.cpu_render_status(gp) catch "cpu-render unknown") + " · " + (try gfx.render_device_policy_status(device_policy) catch "device-policy unknown") + " · " + (try gfx.render_startup_profile_status(startup_profile) catch "startup-profile unknown") + " · " + _graphics_event_status() + " · " + str(try state.render_runtime.summary catch "runtime steady") },
    map{ id: "commands", group: "Control", title: "Command palette", status: "Ctrl+P", detail: "Opens the searchable command palette for every IDE action." }
    ];
}

fn _settings_hits(state) {
    _settings_ensure(state);
    return IDE.filter_management_records(_settings_records(state), try state.settings.query catch "", 200);
}

fn _settings_clamp(state) {
    _settings_ensure(state);
    let hits = _settings_hits(state);
    if (try state.settings.sel catch 0) < 0 { state.settings.sel = 0; }
    if len(hits) == 0 { state.settings.sel = 0; return hits; }
    if (try state.settings.sel catch 0) >= len(hits) { state.settings.sel = len(hits) - 1; }
    return hits;
}

fn _settings_open(state, hit) {
    let id = str(try hit.id catch "");
    if id == "theme" { _theme_toggle(state); state.panel = "settings"; return 0; }
    if id == "style" {
        state.style = _style_next(_style_name(state));
        state.output = "style: " + state.style + " (Web/Smooth/Crystal/Contrast)";
        state.panel = "settings";
        return 0;
    }
    if id == "density_auto" { _density_auto(state); state.panel = "settings"; return 0; }
    if id == "density_refresh" { _density_refresh(state); state.panel = "settings"; return 0; }
    if id == "build" { _mode_toggle(state); state.panel = "settings"; return 0; }
    if id == "watcher" { _watch_toggle(state); state.panel = "settings"; return 0; }
    if id == "browser" { state.panel = "web"; state.output = "settings -> browser security and search"; return 0; }
    if id == "files" { state.panel = "files"; _files_refresh(state); state.output = "settings -> files and project roots"; return 0; }
    if id == "history" { state.panel = "hist"; state.output = _history_storage_summary(state); return 0; }
    if id == "font" { state.output = "settings -> font/text\n" + _text_render_status_for_state(state); return 0; }
    if id == "graphics" {
        let gp = try gfx.backend_profile() catch nil;
        let policy = try gfx.render_device_policy(gp, map{ target_fps: 60, pressure: try state.render_runtime.pressure catch "ok" }) catch nil;
        let startup_profile = try gfx.render_startup_profile("fast", gp, map{ target_fps: 60, pressure: try state.render_runtime.pressure catch "ok" }) catch nil;
        state.output = "settings -> graphics/runtime\n" + _graphics_status() + "\n" + (try gfx.cpu_render_status(gp) catch "cpu-render unknown") + "\n" + (try gfx.render_device_policy_status(policy) catch "device-policy unknown") + "\nlaunch env: " + str(try policy.env catch map{}) + "\nstartup profile: " + (try gfx.render_startup_profile_status(startup_profile) catch "startup-profile unknown") + "\nstartup env: " + str_join(try gfx.render_startup_env_lines(startup_profile) catch [], " ") + "\n" + _graphics_event_status() + "\n" + str(try state.render_runtime.summary catch "runtime steady");
        return 0;
    }
    if id == "commands" { _open_command_palette(state); return 0; }
    state.output = "settings: " + str(try hit.title catch id) + " · " + str(try hit.detail catch "");
    return 0;
}

fn _settings_key(state, key, shift) {
    _settings_ensure(state);
    if key == "Escape" { state.panel = "code"; return 0; }
    let n = len(_settings_hits(state));
    if key == "Home" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "home", 10); return 0; }
    if key == "End" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "previous", 10); return 0; }
    if key == "Down" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "down", 10); return 0; }
    if key == "Up" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "up", 10); return 0; }
    if key == "PageDown" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.settings.sel = IDE.selection_move(try state.settings.sel catch 0, n, "page_up", 10); return 0; }
    if key == "Delete" { state.settings.query = ""; state.settings.sel = 0; return 0; }
    if key == "Backspace" {
        if len(try state.settings.query catch "") > 0 { state.settings.query = str_slice(state.settings.query, 0, len(state.settings.query) - 1); }
        state.settings.sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _settings_clamp(state);
        if len(hits) > 0 { _settings_open(state, hits[try state.settings.sel catch 0]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.settings.query = (try state.settings.query catch "") + ch;
        state.settings.sel = 0;
    }
    return 0;
}

fn _settings_metrics(sz) {
    let m = _panel_metrics(sz, "settings");
    m.header_h = CH * 2 + 4 * PAD;
    m.search_y = TOP + m.header_h + PAD;
    m.search_h = CH + PAD;
    m.body_top = m.search_y + m.search_h + 2 * PAD;
    m.row_h = CH * 3 + PAD;
    let rows_area = m.footer_y - m.body_top - PAD;
    let rows = num_floor(rows_area / m.row_h);
    if rows < 1 { rows = 1; }
    m.rows = rows;
    return m;
}

fn _settings_detail_lines(text, maxchars) {
    let s = str(text);
    let cap = try parse_number(str(maxchars)) catch 24;
    if cap == nil or cap < 12 { cap = 12; }
    cap = num_floor(cap);
    if len(s) <= cap { return [s]; }
    let first = str_slice(s, 0, cap);
    let rest = str_trim(str_slice(s, cap, len(s)));
    if len(rest) <= cap { return [first, rest]; }
    return [first, str_slice(rest, 0, cap - 3) + "..."];
}

fn _draw_settings(state, win, sz) {
    _settings_ensure(state);
    let m = _settings_metrics(sz);
    let maxchars = m.max_chars;
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Settings", _style_accent(state));
    if m.hint_mode == "full" {
        _dt(win, PAD, TOP + PAD + CH + PAD / 2, "theme · style · density · build · watcher · browser · graphics", _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let records = _settings_records(state);
    let q = "Search: " + (try state.settings.query catch "") + "   " +
    IDE.management_filter_status(records, try state.settings.query catch "", try state.settings.sel catch 0);
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = m.body_top;
    let hits = _settings_clamp(state);
    let i = 0;
    if len(hits) == 0 {
        _dt(win, PAD, bodyTop, "No settings match the filter.", _style_error(state));
    }
    let start = _list_start_for(try state.settings.sel catch 0, len(hits), m.rows);
    while start + i < len(hits) and i < m.rows {
        let y = bodyTop + i * m.row_h;
        let actual = start + i;
        if actual == (try state.settings.sel catch 0) { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
        let h = hits[actual];
        let head = str((try h.index catch actual) + 1) + ". [" + str(try h.group catch "?") + "] " + str(try h.title catch "?") +
        " · " + str(try h.status catch "");
        _dt(win, PAD, y + PAD / 2, str_slice(head, 0, maxchars), _style_pane_text(state));
        let detail = _settings_detail_lines(try h.detail catch "", maxchars - 4);
        let di = 0;
        while di < len(detail) and di < 2 {
            _dt(win, PAD + 2 * CW, y + CH + PAD / 2 + di * CH, str_slice(detail[di], 0, maxchars - 2), _style_muted(state));
            di = di + 1;
        }
        i = i + 1;
    }
    _draw_panel_scrollbar(state, win, sz, m, len(hits), m.rows, start);

    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    _dt(win, PAD, footerY + PAD / 2, "Settings: type to filter. Enter/click applies selected setting or opens its owning panel.", _style_muted(state));
}

fn _settings_click(state, mx, my) {
    _settings_ensure(state);
    let m = _settings_metrics(state.winsz);
    let bodyTop = m.body_top;
    if my < bodyTop { return 0; }
    let hits = _settings_clamp(state);
    let start = _list_start_for(try state.settings.sel catch 0, len(hits), m.rows);
    let scrollHit = _panel_scrollbar_hit_index(state, m, len(hits), m.rows, start, mx, my);
    if scrollHit >= 0 {
        state.settings.sel = scrollHit;
        return 0;
    }
    let idx = num_floor((my - bodyTop) / m.row_h);
    idx = idx + _list_start_for(try state.settings.sel catch 0, len(hits), m.rows);
    if idx < 0 or idx >= len(hits) { return 0; }
    state.settings.sel = idx;
    _settings_open(state, hits[idx]);
    return 0;
}

// ── Files panel: project directory browser with filter/open/navigate ─────────

fn _files_refresh(state) {
    let dir = str(try state.files.dir catch ".");
    state.files.root_index = IDE.project_root_index(try state.files.roots catch [dir], dir);
    let settings = IDE.project_tree_settings(try state.files.tree_depth catch 3, try state.files.tree_max catch 600);
    state.files.tree_depth = settings.depth;
    state.files.tree_max = settings.max_items;
    let mode = str(try state.files.mode catch "flat");
    if mode == "recent" {
        state.files.entries = IDE.recent_files_entries(try state.recent_files catch [], 80);
    } else if mode == "tree" {
        state.files.entries = _tree_entries(dir, settings.depth, settings.max_items);
    } else {
        state.files.entries = _dir_entries(dir);
    }
    return state.files.entries;
}

fn _files_set_dir(state, dir) {
    state.files.dir = str(dir);
    state.files.query = "";
    state.files.sel = 0;
    state.files.root_index = IDE.project_root_index(try state.files.roots catch [state.files.dir], state.files.dir);
    _files_refresh(state);
    state.output = "files: " + state.files.dir;
    return 0;
}

fn _files_cycle_root(state, dir) {
    let roots = try state.files.roots catch [try state.files.dir catch "."];
    let cur = try state.files.dir catch ".";
    let next = IDE.project_root_cycle(roots, cur, dir);
    state.files.root_index = next.index;
    _files_set_dir(state, next.path);
    state.output = "files " + IDE.project_root_status_with_meta(roots, next.path, try state.files.root_meta catch []);
    return 0;
}

fn _files_roots_path() {
    let home = try env_get("HOME") catch "";
    if home != nil and str(home) != "" {
        return _path_join2(str(home), ".pblang_pbide_roots.txt");
    }
    return ".pblang_pbide_roots.txt";
}

fn _files_load_saved_roots(cwd, file_path) {
    let raw = try fs_read(_files_roots_path()) catch "";
    return IDE.project_roots_merge_saved(cwd, file_path, raw);
}

fn _files_load_saved_root_meta() {
    let raw = try fs_read(_files_roots_path()) catch "";
    return IDE.project_root_meta_from_text(raw);
}

fn _files_save_roots(state) {
    let roots = try state.files.roots catch [];
    let text = IDE.project_roots_file_to_text(roots, try state.files.root_meta catch []);
    let ok = try fs_write(_files_roots_path(), text) catch false;
    return ok;
}

fn _files_bookmark_current_root(state) {
    let roots = try state.files.roots catch [];
    roots = IDE.project_roots("", "", roots);
    let dir = str(try state.files.dir catch ".");
    roots = IDE.project_roots("", "", roots + [dir]);
    state.files.roots = roots;
    state.files.root_index = IDE.project_root_index(roots, dir);
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = "files root bookmarked " + IDE.project_root_status_with_meta(roots, dir, try state.files.root_meta catch []) + suffix;
    return 0;
}

fn _files_root_label_from_query(state) {
    let path = str(try state.files.dir catch ".");
    let label = str_trim(str(try state.files.query catch ""));
    if label == "" {
        state.output = "files root rename: type a label in the Files filter, then use Ctrl+Shift+B";
        return 0;
    }
    let cur = IDE.project_root_meta_get(try state.files.root_meta catch [], path);
    state.files.root_meta = IDE.project_root_meta_set(try state.files.root_meta catch [], path, label, try cur.group catch IDE.project_root_group(path));
    state.files.query = "";
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = IDE.project_root_edit_summary(try state.files.root_meta catch [], path) + suffix;
    return 0;
}

fn _files_root_group_next(state) {
    let path = str(try state.files.dir catch ".");
    state.files.root_meta = IDE.project_root_meta_next_group(try state.files.root_meta catch [], path);
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = IDE.project_root_edit_summary(try state.files.root_meta catch [], path) + suffix;
    return 0;
}

fn _files_set_mode(state, mode) {
    state.panel = "files";
    state.files.mode = str(mode);
    state.files.sel = 0;
    _files_refresh(state);
    state.output = "files mode: " + str(state.files.mode);
    return 0;
}

fn _files_reveal_current(state) {
    let p = str(try state.path catch "");
    let dir = try path_dirname(p) catch ".";
    if dir == "" { dir = "."; }
    state.panel = "files";
    state.files.dir = dir;
    state.files.mode = "flat";
    state.files.query = _path_base2(p);
    state.files.sel = 0;
    _files_refresh(state);
    _files_clamp(state);
    state.output = "files reveal: " + p;
    return 0;
}

fn _files_clear_recent(state) {
    state.recent_files = [];
    state.panel = "files";
    if str(try state.files.mode catch "flat") == "recent" { _files_refresh(state); }
    state.files.sel = 0;
    state.output = "recent files cleared";
    return 0;
}

fn _files_remove_selected_recent(state) {
    if str(try state.files.mode catch "flat") != "recent" { return 0; }
    let hits = _files_clamp(state);
    if len(hits) == 0 { state.output = "recent files empty"; return 0; }
    let hit = hits[state.files.sel];
    let p = str(try hit.path catch "");
    state.recent_files = IDE.recent_files_remove(try state.recent_files catch [], p);
    _files_refresh(state);
    _files_clamp(state);
    state.output = "removed recent file: " + p;
    return 0;
}

fn _files_hits(state) {
    let entries = try state.files.entries catch [];
    if len(entries) == 0 { entries = _files_refresh(state); }
    return IDE.quick_open_candidates(entries, try state.files.query catch "", 300);
}

fn _files_clamp(state) {
    let hits = _files_hits(state);
    if state.files.sel < 0 { state.files.sel = 0; }
    if len(hits) == 0 { state.files.sel = 0; return hits; }
    if state.files.sel >= len(hits) { state.files.sel = len(hits) - 1; }
    return hits;
}

fn _files_accept(state, hit) {
    if hit == nil { return 0; }
    if (try hit.kind catch "file") == "dir" {
        _files_set_dir(state, hit.path);
        return 0;
    }
    state.output = _open_path(state, hit.path);
    return 0;
}

fn _files_selected_hit(state) {
    let hits = _files_clamp(state);
    if len(hits) == 0 { return nil; }
    return hits[state.files.sel];
}

fn _files_inspect_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files inspect: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let profile = IDE.editor_asset_profile(p);
    let plan = IDE.file_explorer_operation_plan("inspect", p, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
    str_join(IDE.file_explorer_selection_detail_lines(hit, try state.files.dir catch "."), "\n") + "\n" +
    "profile: " + str(try profile.editor catch "?") + "/" + str(try profile.family catch "?");
    return 0;
}

fn _files_preview_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files preview: no selection"; return 0; }
    if (try hit.kind catch "file") == "dir" { _files_inspect_selected(state); return 0; }
    state.output = _open_path(state, try hit.path catch "");
    return 0;
}

fn _files_transfer_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files transfer: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let remote = try state.files.remote catch IDE.file_transfer_profile("remote", "", "", "sftp");
    let target = "remote://" + str(try remote.name catch "remote") + "/" + str(try hit.name catch _path_base2(p));
    let plan = IDE.file_explorer_operation_plan("upload", p, target);
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
    IDE.file_transfer_profile_summary(remote) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_copy_selected(state) {
    let hit = _files_selected_hit(state);
    state.files.clipboard = IDE.file_explorer_clipboard_record("copy", hit);
    state.output = IDE.file_explorer_clipboard_summary(state.files.clipboard);
    return 0;
}

fn _files_cut_selected(state) {
    let hit = _files_selected_hit(state);
    state.files.clipboard = IDE.file_explorer_clipboard_record("cut", hit);
    state.output = IDE.file_explorer_clipboard_summary(state.files.clipboard);
    return 0;
}

fn _files_paste_plan(state) {
    let plan = IDE.file_explorer_paste_plan(try state.files.clipboard catch nil, try state.files.dir catch ".");
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
    IDE.file_explorer_clipboard_summary(try state.files.clipboard catch nil) + "\nrequires: " +
    str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_delete_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files delete: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let plan = IDE.file_explorer_operation_plan("delete", p, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_rename_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files rename: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let target = p + ".renamed";
    let plan = IDE.file_explorer_operation_plan("rename", p, target);
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_new_folder_plan(state) {
    let dir = str(try state.files.dir catch ".");
    let target = dir;
    if not str_ends_with(target, "/") { target = target + "/"; }
    target = target + "new-folder";
    let plan = IDE.file_explorer_operation_plan("mkdir", target, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_remote_profile(state) {
    let remote = try state.files.remote catch IDE.file_transfer_profile("remote", "", "", "sftp");
    state.files.remote = remote;
    state.output = IDE.file_transfer_profile_summary(remote) + "\nremote transfers are planned only; credentials stay outside PBIDE.";
    return 0;
}

fn _files_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if key == "Home" { state.files.sel = 0; _files_clamp(state); return 0; }
    if key == "End" {
        let hits = _files_clamp(state);
        if len(hits) > 0 { state.files.sel = len(hits) - 1; }
        return 0;
    }
    if key == "Down" { state.files.sel = state.files.sel + 1; _files_clamp(state); return 0; }
    if key == "Up" { state.files.sel = state.files.sel - 1; _files_clamp(state); return 0; }
    if key == "PageDown" { state.files.sel = state.files.sel + 10; _files_clamp(state); return 0; }
    if key == "PageUp" { state.files.sel = state.files.sel - 10; _files_clamp(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "N" or key == "KeyN") { _files_new_folder_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.files.sel = state.files.sel + 1; _files_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.files.sel = state.files.sel - 1; _files_clamp(state); return 0; }
    if str(try state.files.mode catch "flat") == "recent" and (try state.ctrl catch false) and key == "Delete" { _files_clear_recent(state); return 0; }
    if str(try state.files.mode catch "flat") == "recent" and key == "Delete" { _files_remove_selected_recent(state); return 0; }
    if key == "Delete" { _files_delete_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "B" or key == "KeyB") { _files_root_label_from_query(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "G" or key == "KeyG") { _files_root_group_next(state); return 0; }
    if (try state.ctrl catch false) and (key == "B" or key == "KeyB") { _files_bookmark_current_root(state); return 0; }
    if (try state.ctrl catch false) and (key == "C" or key == "KeyC") { _files_copy_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "X" or key == "KeyX") { _files_cut_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "V" or key == "KeyV") { _files_paste_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "I" or key == "KeyI") { _files_inspect_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "U" or key == "KeyU") { _files_transfer_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "M" or key == "KeyM") { _files_remote_profile(state); return 0; }
    if key == "F2" { _files_rename_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "Right" or key == "PageRight" or key == "L") { _files_cycle_root(state, 1); return 0; }
    if (try state.ctrl catch false) and (key == "Left" or key == "PageLeft" or key == "H") { _files_cycle_root(state, 0 - 1); return 0; }
    if (try state.ctrl catch false) and (key == "Equals" or key == "Plus" or key == "NumpadAdd" or key == "=" or key == "+") {
        state.files.tree_depth = IDE.project_tree_depth_delta(try state.files.tree_depth catch 3, 1);
        state.files.mode = "tree";
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files tree depth: " + str(state.files.tree_depth);
        return 0;
    }
    if (try state.ctrl catch false) and (key == "Minus" or key == "NumpadSubtract" or key == "-") {
        state.files.tree_depth = IDE.project_tree_depth_delta(try state.files.tree_depth catch 3, 0 - 1);
        state.files.mode = "tree";
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files tree depth: " + str(state.files.tree_depth);
        return 0;
    }
    if key == "Tab" {
        let mode = str(try state.files.mode catch "flat");
        if mode == "flat" {
            state.files.mode = "tree";
        } else if mode == "tree" {
            state.files.mode = "recent";
        } else {
            state.files.mode = "flat";
        }
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files mode: " + str(state.files.mode);
        return 0;
    }
    if key == "Backspace" {
        if len(state.files.query) > 0 {
            state.files.query = str_slice(state.files.query, 0, len(state.files.query) - 1);
            state.files.sel = 0;
        } else {
            _files_set_dir(state, try path_dirname(state.files.dir) catch ".");
        }
        return 0;
    }
    if key == "R" and state.ctrl { _files_refresh(state); state.output = "files refreshed"; return 0; }
    if _is_enter(key) {
        let hits = _files_clamp(state);
        if len(hits) > 0 { _files_accept(state, hits[state.files.sel]); }
        return 0;
    }
    if key == "Space" { _files_preview_selected(state); return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.files.query = state.files.query + ch;
        state.files.sel = 0;
    }
    return 0;
}

fn _draw_files(state, win, sz) {
    let m = _panel_metrics(sz, "files");
    let maxchars = m.max_chars;
    let entries = try state.files.entries catch [];
    if len(entries) == 0 { _files_refresh(state); }
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Files / Project", _style_accent(state));
    let mode = str(try state.files.mode catch "flat");
    let roots = try state.files.roots catch [try state.files.dir catch "."];
    let ridx = IDE.project_root_index(roots, try state.files.dir catch ".");
    state.files.root_index = ridx;
    let settings = IDE.project_tree_settings(try state.files.tree_depth catch 3, try state.files.tree_max catch 600);
    state.files.tree_depth = settings.depth;
    state.files.tree_max = settings.max_items;
    let rootText = IDE.project_root_status_with_meta(roots, try state.files.dir catch ".", try state.files.root_meta catch []);
    let treeText = "depth " + str(settings.depth);
    if mode != "tree" { treeText = "flat"; }
    if mode == "recent" { treeText = "recent " + str(len(try state.recent_files catch [])); }
    if m.hint_mode == "full" {
        _dt(win, PAD + 19 * CW, TOP + PAD, mode + " · " + treeText + " · " + rootText + " · Ctrl+Shift+B label · Ctrl+Shift+G group", _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let q = rootText + "  " + mode + "  " + treeText + "  > " + str(try state.files.query catch "");
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let statusY = qy + CH + PAD;
    let fileStatus = IDE.file_explorer_status_line(
    try state.files.dir catch ".",
    try state.files.clipboard catch nil,
    try state.files.remote catch nil
    );
    _dt(win, PAD, statusY, str_slice(fileStatus, 0, maxchars), _style_muted(state));

    let bodyTop = m.body_top;
    let hits = _files_clamp(state);
    let countText = str(len(hits)) + " result";
    if len(hits) != 1 { countText = countText + "s"; }
    _dt(win, sz.w - 20 * CW, qy + PAD / 2, str_slice(countText, 0, 18), _style_muted(state));
    if len(hits) == 0 {
        let miss = IDE.files_panel_empty_message(try state.files.query catch "", mode);
        _dt(win, PAD, bodyTop, str_slice(miss, 0, maxchars), _style_error(state));
    } else {
        let detail = IDE.files_panel_status(try state.files.query catch "", state.files.sel, hits, try state.files.dir catch ".", mode);
        _dt(win, PAD, bodyTop - CH - PAD / 2, str_slice(detail, 0, maxchars), _style_accent(state));
        let hint = IDE.files_panel_hint(try state.files.query catch "");
        let actionHint = IDE.file_explorer_action_line(hits[state.files.sel]);
        _dt(win, PAD, bodyTop - CH * 2 - PAD / 2, str_slice(hint + " · " + actionHint, 0, maxchars), _style_muted(state));
        _dt(win, PAD, bodyTop - SCALE, "NAME", _style_muted(state));
        _dt(win, PAD + 34 * CW, bodyTop - SCALE, "PATH", _style_muted(state));
        let rows = m.rows;
        let start = _list_start_for(try state.files.sel catch 0, len(hits), rows);
        let i = 0;
        while start + i < len(hits) and i < rows {
            let y = bodyTop + i * m.row_h;
            let actual = start + i;
            if actual == state.files.sel { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let h = hits[actual];
            let col = _style_pane_text(state);
            if (try h.kind catch "file") == "dir" { col = _style_info(state); }
            let nameW = 32 * CW;
            if m.viewport_class == "small" { nameW = 22 * CW; }
            let pathX = PAD + nameW + CW;
            let pathMax = (sz.w - PAD - pathX) / CW;
            let name = str(actual + 1) + ". " + h.label;
            _dt(win, PAD, y, str_slice(name, 0, nameW / CW), col);
            _dt(win, pathX, y, str_slice(h.path, 0, pathMax), _style_muted(state));
            i = i + 1;
        }
        _draw_panel_scrollbar(state, win, sz, m, len(hits), rows, start);
    }
    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    let footer = "Files: Tab flat/tree/recent, Ctrl+/- depth, Ctrl+Left/Right roots, Ctrl+B bookmark, Ctrl+Shift+B label, Ctrl+Shift+G group";
    if mode == "recent" { footer = "Files recent: Enter open, Delete removes selected, Ctrl+Delete clears, Tab leaves recent."; }
    _dt(win, PAD, footerY + PAD / 2, footer, _style_muted(state));
}

fn _files_click(state, mx, my) {
    let m = _panel_metrics(state.winsz, "files");
    let bodyTop = m.body_top;
    if my < bodyTop { return 0; }
    let hits = _files_clamp(state);
    let start = _list_start_for(try state.files.sel catch 0, len(hits), m.rows);
    let scrollHit = _panel_scrollbar_hit_index(state, m, len(hits), m.rows, start, mx, my);
    if scrollHit >= 0 {
        state.files.sel = scrollHit;
        return 0;
    }
    let row = num_floor((my - bodyTop) / m.row_h);
    row = row + _list_start_for(try state.files.sel catch 0, len(hits), m.rows);
    if row >= 0 and row < len(hits) {
        state.files.sel = row;
        _files_accept(state, hits[row]);
    }
    return 0;
}

// ── Outline panel: searchable symbols with click/Enter jump ─────────────────

fn _outline_hits(state) {
    return IDE.filter_outline(E.text(state.ed), try state.outline.query catch "", 200);
}

fn _outline_clamp(state) {
    let hits = _outline_hits(state);
    if state.outline.sel < 0 { state.outline.sel = 0; }
    if len(hits) == 0 { state.outline.sel = 0; return hits; }
    if state.outline.sel >= len(hits) { state.outline.sel = len(hits) - 1; }
    return hits;
}

fn _outline_jump(state, hit) {
    let line = try hit.line catch 1;
    if line < 1 { line = 1; }
    _nav_record_if_changed(state, line - 1, 0, "before outline");
    E.set_cursor(state.ed, line - 1, 0);
    state.panel = "code";
    state.output = "outline jump: " + str(try hit.kind catch "?") + " " + str(try hit.name catch "?") + " at line " + str(line);
    return 0;
}

fn _outline_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    let n = len(_outline_hits(state));
    if key == "Home" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "home", 10); return 0; }
    if key == "End" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.outline.sel = IDE.selection_move(state.outline.sel, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.outline.sel = IDE.selection_move(state.outline.sel, n, "previous", 10); return 0; }
    if key == "Down" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "down", 10); return 0; }
    if key == "Up" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "up", 10); return 0; }
    if key == "PageDown" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "page_up", 10); return 0; }
    if key == "Delete" { state.outline.query = ""; state.outline.sel = 0; return 0; }
    if key == "Backspace" {
        if len(state.outline.query) > 0 { state.outline.query = str_slice(state.outline.query, 0, len(state.outline.query) - 1); }
        state.outline.sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _outline_clamp(state);
        if len(hits) > 0 { _outline_jump(state, hits[state.outline.sel]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.outline.query = state.outline.query + ch;
        state.outline.sel = 0;
    }
    return 0;
}

fn _draw_outline(state, win, sz) {
    let m = _panel_metrics(sz, "outline");
    let maxchars = m.max_chars;
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Outline / Symbols", _style_accent(state));
    if m.hint_mode == "full" {
        _dt(win, PAD + 22 * CW, TOP + PAD, "type filter · Home/End/Pg/Ctrl+N/P select · Delete clear · Enter jump", _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let q = "Search: " + (try state.outline.query catch "") + "   " +
    IDE.outline_filter_status(E.text(state.ed), try state.outline.query catch "", try state.outline.sel catch 0) +
    "   Delete clears";
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = m.body_top;
    let hits = _outline_clamp(state);
    if len(hits) == 0 {
        _dt(win, PAD, bodyTop, "No symbols found.", _style_error(state));
    } else {
        let rows = m.rows;
        let start = _list_start_for(try state.outline.sel catch 0, len(hits), rows);
        let i = 0;
        while start + i < len(hits) and i < rows {
            let y = bodyTop + i * m.row_h;
            let actual = start + i;
            if actual == state.outline.sel { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let h = hits[actual];
            let span = "L" + str(try h.line catch 1);
            let endLine = try h.end_line catch try h.line catch 1;
            if endLine != (try h.line catch 1) { span = span + "-L" + str(endLine); }
            let txt = str(try h.kind catch "?") + "  " + str(try h.name catch "?") + "   " + span + "   " + str(try h.lines catch 1) + " line(s)";
            let col = _style_pane_text(state);
            if (try h.kind catch "") == "fn" { col = _style_info(state); }
            if (try h.kind catch "") == "const" { col = _style_warning(state); }
            _dt(win, PAD, y, str_slice(txt, 0, maxchars), col);
            i = i + 1;
        }
        _draw_panel_scrollbar(state, win, sz, m, len(hits), rows, start);
    }
    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    _dt(win, PAD, footerY + PAD / 2, "Outline shows top-level fn/let/const/export from the current buffer.", _style_muted(state));
}

fn _outline_click(state, mx, my) {
    let m = _panel_metrics(state.winsz, "outline");
    let bodyTop = m.body_top;
    if my < bodyTop { return 0; }
    let hits = _outline_clamp(state);
    let start = _list_start_for(try state.outline.sel catch 0, len(hits), m.rows);
    let scrollHit = _panel_scrollbar_hit_index(state, m, len(hits), m.rows, start, mx, my);
    if scrollHit >= 0 {
        state.outline.sel = scrollHit;
        return 0;
    }
    let row = num_floor((my - bodyTop) / m.row_h);
    row = row + _list_start_for(try state.outline.sel catch 0, len(hits), m.rows);
    if row >= 0 and row < len(hits) {
        state.outline.sel = row;
        _outline_jump(state, hits[row]);
    }
    return 0;
}

// ── Problems panel: dedicated diagnostics list + watcher action ──────────────

fn _problems_hits(state) {
    return IDE.filter_diagnostics(try state.diagnostics catch [], try state.problems.query catch "", 1000);
}

fn _problems_count(state) {
    return 1 + len(_problems_hits(state));
}

fn _problems_clamp(state) {
    let n = _problems_count(state);
    if state.problems.sel < 0 { state.problems.sel = 0; }
    if state.problems.sel >= n { state.problems.sel = n - 1; }
    return n;
}

fn _problems_accept(state) {
    let n = _problems_clamp(state);
    if n < 1 { return 0; }
    if state.problems.sel == 0 {
        _watch_action(state);
        state.panel = "problems";
        return 0;
    }
    let idx = state.problems.sel - 1;
    let hits = _problems_hits(state);
    if idx >= 0 and idx < len(hits) {
        state.diag_index = try hits[idx].index catch idx;
        _diagnostic_goto(state, 0);
    }
    return 0;
}

fn _problems_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if key == "Delete" {
        state.problems.query = "";
        state.problems.sel = 0;
        return 0;
    }
    if key == "Backspace" {
        if len(try state.problems.query catch "") > 0 { state.problems.query = str_slice(state.problems.query, 0, len(state.problems.query) - 1); }
        state.problems.sel = 0;
        return 0;
    }
    if key == "Home" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "home", 10); return 0; }
    if key == "End" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "previous", 10); return 0; }
    if key == "Down" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "down", 10); return 0; }
    if key == "Up" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "up", 10); return 0; }
    if key == "PageDown" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "page_down", 10); return 0; }
    if key == "PageUp" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "page_up", 10); return 0; }
    if _is_enter(key) { _problems_accept(state); return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.problems.query = str(try state.problems.query catch "") + ch;
        state.problems.sel = 0;
    }
    return 0;
}

fn _draw_problems(state, win, sz) {
    let m = _panel_metrics(sz, "problems");
    let maxchars = m.max_chars;
    _panel_header_chrome(state, win, sz, m);
    _dt(win, PAD, TOP + PAD, "Problems / Diagnostics", _style_accent(state));
    if m.hint_mode == "full" {
        _dt(win, PAD + 27 * CW, TOP + PAD, str_slice(IDE.diagnostic_counts_label(state.diagnostics) + " · Enter/click action or jump · F6 refresh", 0, maxchars - 28), _style_muted(state));
    }

    let qy = m.search_y;
    _panel_search_box(state, win, m);
    let q = "Filter: " + str(try state.problems.query catch "") + "   " +
    IDE.diagnostic_filter_status(state.diagnostics, try state.problems.query catch "", (try state.problems.sel catch 1) - 1) +
    "   Delete clears";
    let qshown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, qshown, _style_text(state));
    win.rect(PAD + CW + len(qshown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = m.body_top;
    _problems_clamp(state);
    let action = IDE.watcher_action(state.watch);
    let actionText = "action: " + str(try action.message catch "watcher unavailable");
    if state.problems.sel == 0 { _fill_round(win, SCALE, bodyTop, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
    let ac = _style_muted(state);
    if (try action.severity catch "") == "warn" { ac = _style_warning(state); }
    if (try action.severity catch "") == "error" { ac = _style_error(state); }
    if (try action.severity catch "") == "ok" { ac = _style_success(state); }
    _dt(win, PAD, bodyTop, str_slice(actionText, 0, maxchars), ac);

    let hits = _problems_hits(state);
    let dl = IDE.diagnostic_summary(hits, 1000);
    let startY = bodyTop + CH + PAD;
    let detailH = m.detail_h;
    let detailY = m.detail_y;
    if len(try state.diagnostics catch []) == 0 {
        _dt(win, PAD, startY, str_slice(dl[0], 0, maxchars), _style_muted(state));
    } else if len(hits) == 0 {
        _dt(win, PAD, startY, str_slice("No diagnostics match filter: " + str(try state.problems.query catch ""), 0, maxchars), _style_warning(state));
    } else {
        let rows = m.rows;
        if rows < 1 { rows = 1; }
        let diagSel = state.problems.sel - 1;
        if diagSel < 0 { diagSel = 0; }
        let start = _list_start_for(diagSel, len(dl), rows);
        let i = 0;
        while start + i < len(dl) and i < rows {
            let y = startY + i * m.row_h;
            let actual = start + i;
            if state.problems.sel == actual + 1 { _fill_round(win, SCALE, y, sz.w - 2 * SCALE, m.row_h, _style_hilite(state), RAD); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let col = _style_muted(state);
            if str_contains(dl[actual], "ERROR") { col = _style_error(state); }
            if str_contains(dl[actual], "WARNING") { col = _style_warning(state); }
            _dt(win, PAD, y, str_slice(dl[actual], 0, maxchars), col);
            i = i + 1;
        }
        let sm = map{ body_top: startY, footer_y: detailY, row_h: m.row_h };
        _draw_panel_scrollbar(state, win, sz, sm, len(dl), rows, start);
    }
    win.rect(0, detailY, sz.w, detailH, _style_panel(state));
    win.rect(0, detailY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, detailY + PAD / 2, "Selected diagnostic detail", _style_accent(state));
    let selectedDiag = nil;
    let selectedIdx = (try state.problems.sel catch 0) - 1;
    if selectedIdx >= 0 and selectedIdx < len(hits) { selectedDiag = hits[selectedIdx]; }
    let detail = IDE.diagnostic_detail_lines(selectedDiag, 3);
    let dd = 0;
    while dd < len(detail) and dd < 3 {
        let col = _style_muted(state);
        if dd == 0 and str_contains(detail[dd], "ERROR") { col = _style_error(state); }
        if dd == 0 and str_contains(detail[dd], "WARNING") { col = _style_warning(state); }
        _dt(win, PAD, detailY + CH + PAD + dd * CH, str_slice(detail[dd], 0, maxchars), col);
        dd = dd + 1;
    }
    let footerY = m.footer_y;
    _panel_footer_chrome(state, win, sz, footerY);
    _dt(win, PAD, footerY + PAD / 2, "Problems uses current diagnostics; stale/unchecked action row runs Check.", _style_muted(state));
}

fn _problems_click(state, mx, my) {
    let sz = try state.winsz catch nil;
    let m = _panel_metrics(sz, "problems");
    let bodyTop = m.body_top;
    if sz != nil {
        let detailY = m.detail_y;
        if my >= detailY { return false; }
    }
    let hits = _problems_hits(state);
    if len(hits) > 0 {
        let rows = m.rows;
        if rows < 1 { rows = 1; }
        let diagSel = state.problems.sel - 1;
        if diagSel < 0 { diagSel = 0; }
        let start = _list_start_for(diagSel, len(hits), rows);
        let sm = map{ body_top: bodyTop + CH + PAD, footer_y: m.detail_y, row_h: m.row_h };
        let scrollHit = _panel_scrollbar_hit_index(state, sm, len(hits), rows, start, mx, my);
        if scrollHit >= 0 {
            state.problems.sel = scrollHit + 1;
            return 0;
        }
    }
    let hit = IDE.problems_panel_hit(my, bodyTop, m.row_h, PAD, len(_problems_hits(state)));
    if (try hit.kind catch "") == "action" {
        state.problems.sel = 0;
        _problems_accept(state);
        return 0;
    }
    if (try hit.kind catch "") == "diagnostic" {
        let hits = _problems_hits(state);
        let rows = m.rows;
        if rows < 1 { rows = 1; }
        let diagSel = state.problems.sel - 1;
        if diagSel < 0 { diagSel = 0; }
        let start = _list_start_for(diagSel, len(hits), rows);
        state.problems.sel = start + (try hit.index catch 0) + 1;
        _problems_accept(state);
    }
    return 0;
}

// ── searchable examples picker: native equivalent of the web IDE examples list ─────

fn _example_box(sz) {
    let b = _modal_box(sz, 72 * CW, CH * 17 + 6 * PAD, 2);
    return map{ x: b.x, y: b.y, w: b.w, h: b.h, list_y: b.y + CH * 4 + 4 * PAD };
}

fn _examples_visible_rows(b) {
    let rows = num_floor((b.y + b.h - b.list_y - 2 * PAD) / CH);
    if rows < 1 { rows = 1; }
    return rows;
}

fn _examples_start(state, hits, rows) {
    return _list_start_for(try state.example_sel catch 0, len(hits), rows);
}

fn _draw_examples(state, win, sz) {
    let b = _example_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    _card_state(state, win, b.x, b.y, b.w, b.h, _style_panel(state), _style_border(state), RAD_LG);
    _accent_bar(win, b.x + RAD_LG, b.y, b.w - 2 * RAD_LG, _style_accent(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Examples", _style_accent(state));
    _dt(win, b.x + 15 * CW, b.y + 2 * PAD, "type filter  Pg/Home/End/Ctrl+N/P select  Delete clear  Enter load", _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    _fill_round(win, b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state), RAD);
    let q = "Search: " + state.example_query + "   " +
    IDE.examples_filter_status(EXAMPLES, try state.example_query catch "", try state.example_sel catch 0) +
    "   Esc closes";
    let shown = str_slice(q, 0, (b.w - 6 * PAD) / CW);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shown, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _example_clamp(state);
    if len(hits) == 0 {
        _dt(win, b.x + 2 * PAD, b.list_y, "No matching examples.", _style_error(state));
        return 0;
    }
    let rows = _examples_visible_rows(b);
    let start = _examples_start(state, hits, rows);
    let i = 0;
    while i < rows and start + i < len(hits) {
        let actual = start + i;
        let y = b.list_y + i * CH;
        if actual == state.example_sel { _fill_round(win, b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state), RAD); }
        let ex = EXAMPLES[hits[actual].index];
        let mainp = _example_main_path(ex);
        let files = _example_project_files(ex);
        let line = str(actual + 1) + ". " + hits[actual].title + "   #" + str(hits[actual].index + 1) +
        "   " + str(len(files)) + " file(s)   " + mainp;
        _dt(win, b.x + 2 * PAD, y, str_slice(line, 0, (b.w - 6 * PAD) / CW), _style_pane_text(state));
        i = i + 1;
    }
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let sb = UIK.scrollbar(b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        _fill_round(win, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _style_surface(state), thick / 2);
        _fill_round(win, sb.thumb.x, sb.thumb.y, sb.thumb.w, sb.thumb.h, _style_focus(state), thick / 2);
    }
    return 0;
}

fn _examples_click(state, mx, my) {
    if not (try state.examples_mode catch false) or state.winsz == nil { return false; }
    let b = _example_box(state.winsz);
    if not _hit_rect(mx, my, b.x, b.y, b.w, b.h, _button_hit_slop()) { return false; }
    if my < b.list_y { return true; }
    let hits = _example_clamp(state);
    let rows = _examples_visible_rows(b);
    let start = _examples_start(state, hits, rows);
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let scrollHit = _scrollbar_hit_index(mx, my, b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        if scrollHit >= 0 {
            state.example_sel = scrollHit;
            return true;
        }
    }
    let row = num_floor((my - b.list_y) / CH);
    let actual = start + row;
    if row >= 0 and row < rows and actual < len(hits) {
        state.example_sel = actual;
        _load_example_index(state, hits[actual].index);
    }
    return true;
}

// ── command palette: keyboard route to all main IDE actions ─────────────────

fn _command_box(sz) {
    let b = _modal_box(sz, 84 * CW, CH * 16 + 6 * PAD, 2);
    return map{ x: b.x, y: b.y, w: b.w, h: b.h, list_y: b.y + CH * 4 + 4 * PAD };
}

fn _command_visible_rows(b) {
    let rows = num_floor((b.y + b.h - b.list_y - 2 * PAD) / CH);
    if rows < 1 { rows = 1; }
    if rows > 12 { rows = 12; }
    return rows;
}

fn _draw_command_palette(state, win, sz) {
    let b = _command_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    _card_state(state, win, b.x, b.y, b.w, b.h, _style_panel(state), _style_border(state), RAD_LG);
    _accent_bar(win, b.x + RAD_LG, b.y, b.w - 2 * RAD_LG, _style_accent(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Command Palette", _style_accent(state));
    let head = IDE.command_catalog_summary(nil) + "  ·  " + IDE.command_filter_examples_line(6) + "  Pg/Home/End/Ctrl+N/P select  Delete clear  Enter run";
    _dt(win, b.x + 22 * CW, b.y + 2 * PAD, str_slice(head, 0, (b.w - 24 * CW) / CW), _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    _fill_round(win, b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state), RAD);
    let q = "> " + (try state.command_query catch "") + "   " +
    IDE.command_filter_status(try state.command_query catch "", try state.command_sel catch 0);
    let shown = str_slice(q, 0, (b.w - 6 * PAD) / CW);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shown, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _command_clamp(state);
    if len(hits) == 0 {
        let miss = IDE.command_empty_message(try state.command_query catch "");
        _dt(win, b.x + 2 * PAD, b.list_y, str_slice(miss, 0, (b.w - 4 * PAD) / CW), _style_error(state));
        return 0;
    }
    let selected = hits[state.command_sel];
    let detail = str(state.command_sel + 1) + "/" + str(len(hits)) + "  " + selected.group + " / " + selected.title + " / " + selected.shortcut;
    _dt(win, b.x + 2 * PAD, b.list_y - CH - PAD / 2, str_slice(detail, 0, (b.w - 4 * PAD) / CW), _style_accent(state));
    let hint = IDE.command_filter_hint(try state.command_query catch "");
    _dt(win, b.x + 2 * PAD, b.list_y - CH * 2 - PAD / 2, str_slice(hint, 0, (b.w - 4 * PAD) / CW), _style_muted(state));
    _dt(win, b.x + 2 * PAD, b.list_y - SCALE, "GROUP", _style_muted(state));
    _dt(win, b.x + 13 * CW, b.list_y - SCALE, "COMMAND", _style_muted(state));
    _dt(win, b.x + b.w - 28 * CW, b.list_y - SCALE, "SHORTCUT", _style_muted(state));
    let rows = _command_visible_rows(b);
    let start = _list_start_for(try state.command_sel catch 0, len(hits), rows);
    let i = 0;
    while i < rows and start + i < len(hits) {
        let actual = start + i;
        let y = b.list_y + i * CH;
        if actual == state.command_sel { _fill_round(win, b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state), RAD); }
        let c = hits[actual];
        let groupW = 11 * CW;
        let shortcutW = 26 * CW;
        let titleX = b.x + 2 * PAD + groupW;
        let shortcutX = b.x + b.w - 2 * PAD - shortcutW;
        let titleMax = (shortcutX - titleX - CW) / CW;
        if titleMax < 8 { titleMax = 8; }
        _dt(win, b.x + 2 * PAD, y, str_slice(c.group, 0, 10), _style_muted(state));
        _dt(win, titleX, y, str_slice(c.title, 0, titleMax), _style_pane_text(state));
        _dt(win, shortcutX, y, str_slice(c.shortcut, 0, shortcutW / CW), _style_accent(state));
        i = i + 1;
    }
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let sb = UIK.scrollbar(b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        _fill_round(win, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _style_surface(state), thick / 2);
        _fill_round(win, sb.thumb.x, sb.thumb.y, sb.thumb.w, sb.thumb.h, _style_focus(state), thick / 2);
    }
    return 0;
}

fn _command_click(state, mx, my) {
    if not (try state.command_mode catch false) or state.winsz == nil { return false; }
    let b = _command_box(state.winsz);
    if not _hit_rect(mx, my, b.x, b.y, b.w, b.h, _button_hit_slop()) { return false; }
    if my < b.list_y { return true; }
    let hits = _command_clamp(state);
    let rows = _command_visible_rows(b);
    let start = _list_start_for(try state.command_sel catch 0, len(hits), rows);
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let scrollHit = _scrollbar_hit_index(mx, my, b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        if scrollHit >= 0 {
            state.command_sel = scrollHit;
            return true;
        }
    }
    let row = num_floor((my - b.list_y) / CH);
    let actual = start + row;
    if row >= 0 and row < rows and actual < len(hits) {
        state.command_sel = actual;
        _command_execute(state, hits[actual].id);
    }
    return true;
}

// ── Quick Open: native file picker for Open / Ctrl+O ─────────────────────────

fn _path_join2(a, b) {
    return try path_join(a, b) catch (str(a) + "/" + str(b));
}

fn _path_base2(path) {
    let p = str(path);
    let last = 0 - 1;
    let i = 0;
    while i < len(p) {
        if strcharcodeat(p, i) == 47 or strcharcodeat(p, i) == 92 { last = i; }
        i = i + 1;
    }
    if last < 0 { return p; }
    if last >= len(p) - 1 { return p; }
    return str_slice(p, last + 1, len(p));
}

fn _dir_entries(dir) {
    dir = str(dir);
    let names = try fs_listdir(dir) catch [];
    let entries = [map{ name: "..", path: try path_dirname(dir) catch ".", kind: "dir" }];
    let i = 0;
    while i < len(names) and i < 400 {
        let name = str(names[i]);
        let full = _path_join2(dir, name);
        let kind = "file";
        let sub = try fs_listdir(full) catch nil;
        if sub != nil { kind = "dir"; }
        array_push(entries, map{ name: name, path: full, kind: kind });
        i = i + 1;
    }
    return entries;
}

fn _tree_indent(depth) {
    let s = "";
    let i = 0;
    while i < depth {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

fn _tree_skip_dir(name) {
    name = str(name);
    return name == ".git" or name == "target" or name == "node_modules" or name == ".cache" or name == ".mint-mcp";
}

fn _tree_push_dir(out, dir, depth, max_depth, max_items) {
    if len(out) >= max_items or depth >= max_depth { return 0; }
    let names = try fs_listdir(dir) catch [];
    let i = 0;
    while i < len(names) and len(out) < max_items {
        let name = str(names[i]);
        let full = _path_join2(dir, name);
        let kind = "file";
        let sub = try fs_listdir(full) catch nil;
        if sub != nil { kind = "dir"; }
        array_push(out, map{ name: name, path: full, kind: kind, depth: depth, display: _tree_indent(depth) + name, tree: true });
        if kind == "dir" and not _tree_skip_dir(name) {
            _tree_push_dir(out, full, depth + 1, max_depth, max_items);
        }
        i = i + 1;
    }
    return len(out);
}

fn _tree_entries(dir, max_depth, max_items) {
    dir = str(dir);
    if max_depth == nil or max_depth < 1 { max_depth = 2; }
    if max_items == nil or max_items < 20 { max_items = 200; }
    let entries = [map{ name: "..", path: try path_dirname(dir) catch ".", kind: "dir", depth: 0, display: "..", tree: true }];
    _tree_push_dir(entries, dir, 0, max_depth, max_items);
    return entries;
}

fn _quick_open_refresh(state) {
    let dir = str(try state.quick_dir catch ".");
    let entries = _dir_entries(dir);
    state.quick_entries = entries;
    return entries;
}

fn _quick_open_hits(state) {
    let search = IDE.quick_open_search_query(try state.quick_query catch "");
    return IDE.quick_open_with_recent(try state.quick_entries catch [], try state.recent_files catch [], search, 300);
}

fn _quick_open_clamp(state) {
    let hits = _quick_open_hits(state);
    if state.quick_sel < 0 { state.quick_sel = 0; }
    if len(hits) == 0 { state.quick_sel = 0; return hits; }
    if state.quick_sel >= len(hits) { state.quick_sel = len(hits) - 1; }
    return hits;
}

fn _quick_open_accept(state, hit) {
    if hit == nil {
        let raw = str_trim(try state.quick_query catch "");
        if raw == "" { return 0; }
        state.quick_open_mode = false;
        state.output = _open_path(state, raw);
        return 0;
    }
    if (try hit.kind catch "file") == "dir" {
        state.quick_dir = hit.path;
        state.quick_query = "";
        state.quick_sel = 0;
        _quick_open_refresh(state);
        state.output = "quick open: " + state.quick_dir;
        return 0;
    }
    state.quick_open_mode = false;
    let targetPath = IDE.quick_open_apply_target(hit.path, try state.quick_query catch "");
    state.quick_query = "";
    state.output = _open_path(state, targetPath);
    return 0;
}

fn _quick_open_key(state, key, shift) {
    if key == "Escape" { state.quick_open_mode = false; state.output = "quick open closed"; return 0; }
    if key == "Home" { state.quick_sel = 0; _quick_open_clamp(state); return 0; }
    if key == "End" {
        let hits = _quick_open_clamp(state);
        if len(hits) > 0 { state.quick_sel = len(hits) - 1; }
        return 0;
    }
    if key == "Down" { state.quick_sel = state.quick_sel + 1; _quick_open_clamp(state); return 0; }
    if key == "Up" { state.quick_sel = state.quick_sel - 1; _quick_open_clamp(state); return 0; }
    if key == "PageDown" { state.quick_sel = state.quick_sel + 10; _quick_open_clamp(state); return 0; }
    if key == "PageUp" { state.quick_sel = state.quick_sel - 10; _quick_open_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.quick_sel = state.quick_sel + 1; _quick_open_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.quick_sel = state.quick_sel - 1; _quick_open_clamp(state); return 0; }
    if key == "Backspace" {
        if len(state.quick_query) > 0 { state.quick_query = str_slice(state.quick_query, 0, len(state.quick_query) - 1); }
        state.quick_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _quick_open_clamp(state);
        if len(hits) > 0 { _quick_open_accept(state, hits[state.quick_sel]); }
        else { _quick_open_accept(state, nil); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.quick_query = state.quick_query + ch;
        state.quick_sel = 0;
    }
    return 0;
}

fn _quick_open_box(sz) {
    let b = _modal_box(sz, 92 * CW, CH * 18 + 6 * PAD, 2);
    return map{ x: b.x, y: b.y, w: b.w, h: b.h, list_y: b.y + CH * 4 + 4 * PAD };
}

fn _quick_open_visible_rows(b) {
    let rows = num_floor((b.y + b.h - b.list_y - 2 * PAD) / CH);
    if rows < 1 { rows = 1; }
    if rows > 14 { rows = 14; }
    return rows;
}

fn _draw_quick_open(state, win, sz) {
    let b = _quick_open_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    _card_state(state, win, b.x, b.y, b.w, b.h, _style_panel(state), _style_border(state), RAD_LG);
    _accent_bar(win, b.x + RAD_LG, b.y, b.w - 2 * RAD_LG, _style_accent(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Quick Open", _style_accent(state));
    let recentCount = len(try state.recent_files catch []);
    let quickHead = "recent " + str(recentCount) + "  " + IDE.file_filter_examples_line(6) + "  path:line:col or line:120 col:4  Up/Down/Pg/Home/End  Enter open  Esc close";
    _dt(win, b.x + 17 * CW, b.y + 2 * PAD, str_slice(quickHead, 0, (b.w - 19 * CW) / CW), _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    _fill_round(win, b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state), RAD);
    let q = str(try state.quick_query catch "");
    let prompt = str(try state.quick_dir catch ".") + "  recent+" + str(recentCount) + "  > " + q;
    let maxPrompt = (b.w - 6 * PAD) / CW;
    let shownPrompt = str_slice(prompt, 0, maxPrompt);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shownPrompt, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shownPrompt) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _quick_open_clamp(state);
    let countText = str(len(hits)) + " result";
    if len(hits) != 1 { countText = countText + "s"; }
    _dt(win, b.x + b.w - 18 * CW, qy + PAD / 2, str_slice(countText, 0, 16), _style_muted(state));
    if len(hits) == 0 {
        let miss = IDE.quick_open_empty_message(q);
        _dt(win, b.x + 2 * PAD, b.list_y, str_slice(miss, 0, (b.w - 4 * PAD) / CW), _style_error(state));
        return 0;
    }
    let detail = IDE.quick_open_status(q, state.quick_sel, hits, try state.quick_dir catch ".", recentCount);
    _dt(win, b.x + 2 * PAD, b.list_y - CH - PAD / 2, str_slice(detail, 0, (b.w - 4 * PAD) / CW), _style_accent(state));
    let hint = IDE.quick_open_hint(q);
    _dt(win, b.x + 2 * PAD, b.list_y - CH * 2 - PAD / 2, str_slice(hint, 0, (b.w - 4 * PAD) / CW), _style_muted(state));
    _dt(win, b.x + 2 * PAD, b.list_y - SCALE, "NAME", _style_muted(state));
    _dt(win, b.x + 33 * CW, b.list_y - SCALE, "PATH", _style_muted(state));
    let rows = _quick_open_visible_rows(b);
    let start = _list_start_for(try state.quick_sel catch 0, len(hits), rows);
    let i = 0;
    while i < rows and start + i < len(hits) {
        let actual = start + i;
        let y = b.list_y + i * CH;
        if actual == state.quick_sel { _fill_round(win, b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state), RAD); }
        let h = hits[actual];
        let nameW = 30 * CW;
        let pathX = b.x + 2 * PAD + nameW + CW;
        let pathMax = (b.x + b.w - 2 * PAD - pathX) / CW;
        let name = str(actual + 1) + ". " + h.label;
        _dt(win, b.x + 2 * PAD, y, str_slice(name, 0, nameW / CW), _style_pane_text(state));
        _dt(win, pathX, y, str_slice(h.path, 0, pathMax), _style_muted(state));
        i = i + 1;
    }
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let sb = UIK.scrollbar(b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        _fill_round(win, sb.track.x, sb.track.y, sb.track.w, sb.track.h, _style_surface(state), thick / 2);
        _fill_round(win, sb.thumb.x, sb.thumb.y, sb.thumb.w, sb.thumb.h, _style_focus(state), thick / 2);
    }
    return 0;
}

fn _quick_open_click(state, mx, my) {
    if not (try state.quick_open_mode catch false) or state.winsz == nil { return false; }
    let b = _quick_open_box(state.winsz);
    if not _hit_rect(mx, my, b.x, b.y, b.w, b.h, _button_hit_slop()) { return false; }
    if my < b.list_y { return true; }
    let hits = _quick_open_clamp(state);
    let rows = _quick_open_visible_rows(b);
    let start = _list_start_for(try state.quick_sel catch 0, len(hits), rows);
    if len(hits) > rows {
        let thick = _scrollbar_thickness();
        let scrollHit = _scrollbar_hit_index(mx, my, b.x + b.w - 2 * PAD - thick, b.list_y, rows * CH, len(hits), rows, start, thick);
        if scrollHit >= 0 {
            state.quick_sel = scrollHit;
            return true;
        }
    }
    let row = num_floor((my - b.list_y) / CH);
    let actual = start + row;
    if row >= 0 and row < rows and actual < len(hits) {
        state.quick_sel = actual;
        _quick_open_accept(state, hits[actual]);
    }
    return true;
}

fn _point_in_box(mx, my, b) {
    return mx >= b.x and mx < b.x + b.w and my >= b.y and my < b.y + b.h;
}

fn _modal_mouse_capture(state, mx, my) {
    if state.help {
        state.help = false;
        state.output = "help closed";
        return true;
    }
    if try state.goto_line_mode catch false {
        let b = _goto_line_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.goto_line_mode = false;
            state.output = "go to line closed";
        }
        return true;
    }
    if try state.open_mode catch false {
        state.open_mode = false;
        state.open_path = "";
        state.output = "open cancelled";
        return true;
    }
    if try state.save_as_mode catch false {
        state.save_as_mode = false;
        state.save_as_path = "";
        state.output = "save as cancelled";
        return true;
    }
    return false;
}

fn _any_modal_open(state) {
    if state.help { return true; }
    if try state.goto_line_mode catch false { return true; }
    if try state.open_mode catch false { return true; }
    if try state.save_as_mode catch false { return true; }
    if try state.quick_open_mode catch false { return true; }
    if try state.command_mode catch false { return true; }
    if try state.examples_mode catch false { return true; }
    return false;
}

fn _modal_backdrop_click(state, mx, my) {
    if try state.quick_open_mode catch false {
        let b = _quick_open_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.quick_open_mode = false;
            state.output = "quick open closed";
        }
        return true;
    }
    if try state.command_mode catch false {
        let b = _command_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.command_mode = false;
            state.output = "command palette closed";
        }
        return true;
    }
    if try state.examples_mode catch false {
        let b = _example_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.examples_mode = false;
            state.output = "examples closed";
        }
        return true;
    }
    return _modal_mouse_capture(state, mx, my);
}

fn _apply_event_modifiers(state, e) {
    let v = try e.shift catch nil;
    if v != nil { state.shift = v; }
    v = try e.ctrl catch nil;
    if v != nil { state.ctrl = v; }
    v = try e.alt catch nil;
    if v != nil { state.alt = v; }
    v = try e.meta catch nil;
    if v != nil { state.meta = v; }
    return 0;
}

// ── shortcuts overlay (F1) — ported from the web IDE's #shortcuts-overlay ─────────
let HELP = [
"pblang IDE  -  KEYBOARD SHORTCUTS            F1 or Esc to close",
"",
"GLOBAL    click Code/Term/AI/Designer/Browser/Files/Out/Prob/Hist/Manage/Settings to switch panels",
"          F2 Code   F3 Terminal   F4 Designer   F7 AI   F9 History   F10 Browser",
"          Ctrl+1..9/Ctrl+0 switch panel strip left-to-right",
"          tabs compact to 1C/2T/3A... when needed to keep actions usable",
"          Ctrl+Tab / Ctrl+Shift+Tab cycle panels; Ctrl+PgDn / Ctrl+PgUp too",
"          Ctrl+P command palette     F1 toggle this help",
"",
"CODE      F5 run    F6 check    Ctrl+G go to line    F8 next diagnostic",
"          Shift+F8 previous diagnostic",
"          file tabs show every project/example file; click a tab to switch buffers",
"          Alt+Left / Alt+Right navigate jump history",
"          Ctrl+N new buffer    Ctrl+S save    Ctrl+Shift+S Save As",
"          Ctrl+O Quick Open    Ctrl+F find",
"          Tab indent selection or insert spaces    Shift+Tab outdent",
"          Ctrl+Shift+D duplicate line    Ctrl+Shift+K delete line",
"          Alt+Up / Alt+Down move current line",
"          Ctrl+/ toggle line comment",
"          F11 toggle Debug/Release mode    F12 toggle watcher",
"          Ex opens searchable examples picker",
"          Quick Open: recent files first, type filter, Enter open/enter-dir, Esc close",
"          Ctrl+Z / Ctrl+Y  undo / redo     Ctrl+C/X/V  copy/cut/paste",
"          Ctrl+C/X without selection copies/cuts the current line",
"          Ctrl+A select all     arrows move     hold a key to repeat",
"          Ctrl+Left/Right word jump    Ctrl+Up/Down 5 lines",
"          Ctrl+Home/End document edge   Shift+arrow select   PgUp/PgDn",
"",
"TERMINAL  type + Enter run a command    Shift+Enter newline    'clear'",
"",
"DESIGN    pick a palette tool   click canvas to place   drag/arrows move on grid",
"          Ctrl+arrows resize   Tab/Shift+Tab select   Insert duplicate",
"          Ctrl+[ / Ctrl+] layer   Shift sends back/front   type edit text   Del delete",
"",
"AI        type + Enter ask pbAI    Shift+Enter newline",
"          EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT / DIAG run pbAI",
"          INSERT places the last pbAI answer into the code editor",
"",
"BROWSER   URL + Enter load    Live/Reader/Source/Inspect are pblang-native",
"          Up/Down/PgUp/PgDn scroll; Host is optional external screenshot fallback",
"",
"HISTORY   run/check snapshots mirror the web IDE; click a row to restore code",
"          S toggles Temporary/Permanent; Ctrl+S saves; C/footer clears history",
"MANAGE    database/storage/files/browser/AI/backups dashboard; Enter opens area",
"SETTINGS  theme/style/density/build/watcher/browser/font/graphics; Enter applies",
"FILES     type filter   Tab flat/tree/recent   Ctrl+/- tree depth   Enter open/dir",
"          Backspace up   Ctrl+R refresh",
"          Ctrl+Left/Right roots   Ctrl+H/L roots   Ctrl+B bookmark current dir",
"          Ctrl+Shift+B labels current root from filter; Ctrl+Shift+G cycles root group",
"          Recent mode: Delete remove selected   Ctrl+Delete clear recent",
"          Ctrl+P exposes Files Flat/Tree/Recent and Reveal current file",
"OUTLINE   type to filter symbols   Up/Down select   Enter/click jump",
"PROBLEMS  Enter/click action or diagnostic   F6 refresh   Esc code",
"",
"MODE      Debug checks before run; Release runs directly. Watcher tracks rev/dirty/diags.",
"UI        Ctrl+P -> UI snapshot prints structured layout/UX observer lines.",
"          Ctrl+- / Ctrl+= adjust native UI density outside Files; Ctrl+P density auto/refresh.",
"STYLE     click Style to cycle Web / Smooth / Crystal / Contrast palettes.",
"THEME     click Theme or Ctrl+P Theme to toggle Light / Dark.",
"          Crystal + Dark is default; Light matches the web IDE preference control.",
"",
"Launch from a shell with:   pblang ide   (or ./editors/ide/run.sh ; Windows: run.bat)",
"UI density uses the pblang window probe when available; PBIDE_SCALE=1..4 overrides.",
"Set PBIDE_WINDOW_PROBE=0 to disable probing or PBIDE_WINDOW_PROBE_MS=1200 to tune it.",
"Renderer: Settings -> Graphics shows startup env; fast profile uses PBLANG_GFX=sdl2.",
];

fn _draw_help(state, win, sz) {
    win.clear(_style_modal_backdrop(state));                  // modal backdrop
    let maxw = 0;
    let i = 0;
    while i < len(HELP) { if len(HELP[i]) > maxw { maxw = len(HELP[i]); } i = i + 1; }
    let bw = maxw * CW + 4 * PAD;
    let bh = len(HELP) * CH + 4 * PAD;
    let bx = (sz.w - bw) / 2; if bx < 0 { bx = 0; }
    let by = (sz.h - bh) / 2; if by < 0 { by = 0; }
    _card_state(state, win, bx, by, bw, bh, _style_panel(state), _style_accent(state), RAD_LG);
    _accent_bar(win, bx + RAD_LG, by, bw - 2 * RAD_LG, _style_accent(state));
    let r = 0;
    while r < len(HELP) {
        let col = _style_pane_text(state);
        if r == 0 { col = _style_accent(state); }
        _dt(win, bx + 2 * PAD, by + 2 * PAD + r * CH, HELP[r], col);
        r = r + 1;
    }
}

// top-level draw: clear, toolbar, then the active panel.

fn _draw(state, win) {
    TEXT_FRAME_CALLS = 0;
    TEXT_FRAME_SKIPS = 0;
    TEXT_FRAME_AA = 0;
    TEXT_FRAME_BITMAP = 0;
    let frame = win.size();
    let live = try state.live_winsz catch frame;
    _apply_live_density(state, live);
    _apply_toolbar_metrics(frame);
    win.clear(_style_bg(state));
    let sz = frame;
    state.winsz = sz;                 // cached for mouse → buffer-position mapping
    state.window_size = live;
    state.viewport_layout = _viewport_layout_for(live);
    _ui_snapshot_cached(state, sz);
    _refresh_watcher_draw(state);
    _draw_toolbar(state, win, sz);
    if state.panel == "code" { _draw_code(state, win, sz); }
    else if state.panel == "term" { _draw_term(state, win, sz); }
    else if state.panel == "design" { _draw_design(state, win, sz); }
    else if state.panel == "ai" { _draw_ai(state, win, sz); }
    else if state.panel == "web" { _draw_web(state, win, sz); }
    else if state.panel == "files" { _draw_files(state, win, sz); }
    else if state.panel == "outline" { _draw_outline(state, win, sz); }
    else if state.panel == "problems" { _draw_problems(state, win, sz); }
    else if state.panel == "hist" { _draw_history(state, win, sz); }
    else if state.panel == "manage" { _draw_manage(state, win, sz); }
    else if state.panel == "settings" { _draw_settings(state, win, sz); }
    if try state.examples_mode catch false { _draw_examples(state, win, sz); }
    if try state.command_mode catch false { _draw_command_palette(state, win, sz); }
    if try state.quick_open_mode catch false { _draw_quick_open(state, win, sz); }
    if try state.goto_line_mode catch false { _draw_goto_line(state, win, sz); }
    if state.help { _draw_help(state, win, sz); }     // modal overlay, drawn last (on top)
    if (try state.perf catch nil) == nil { state.perf = map{}; }
    state.perf.text_calls = TEXT_FRAME_CALLS;
    state.perf.text_skips = TEXT_FRAME_SKIPS;
    state.perf.text_aa = TEXT_FRAME_AA;
    state.perf.text_bitmap = TEXT_FRAME_BITMAP;
    return true;
}

// mouse → buffer position. Maps a pixel (mx,my) in the editor area to (row,col), using the
// SAME layout math as _draw: row r sits under the file tab strip, text starts at GUTTERX.
// Returns nil for clicks outside the editor area (e.g. on the output pane).

fn _mouse_pos(state, mx, my) {
    let ed = state.ed;
    let sz = state.winsz;
    let codeTop = _code_content_top(state);
    if sz != nil {
        if my >= sz.h - STATUSH { return nil; }
        let editorW = sz.w - _code_output_w_state(state, sz) - SCALE * 3;
        if mx >= editorW { return nil; }
    }
    if my < codeTop { return nil; }
    let vr = (my - codeTop) / CH;
    vr = num_floor(vr);
    if vr < 0 { vr = 0; }
    let row = ed.scroll + vr;
    let col = 0;
    if mx > GUTTERX { col = num_floor((mx - GUTTERX + CW / 2) / CW); }  // round to nearest gap
    return map{ row: row, col: col };
}

fn _editor_scrollbar_click(state, mx, my) {
    let sz = try state.winsz catch nil;
    if sz == nil { return false; }
    let ed = state.ed;
    let outw = _code_output_w_state(state, sz);
    let editorW = sz.w - outw - SCALE * 3;
    let codeTop = _code_content_top(state);
    let rows = num_floor((sz.h - STATUSH - codeTop) / CH);
    if rows < 1 { return false; }
    let total = E.line_count(ed);
    let thick = _scrollbar_thickness();
    let hit = _scrollbar_hit_index(mx, my, editorW - PAD - thick, codeTop, sz.h - STATUSH - codeTop, total, rows, try ed.scroll catch 0, thick);
    if hit < 0 { return false; }
    ed.scroll = hit;
    if ed.row < ed.scroll { ed.row = ed.scroll; }
    if ed.row >= ed.scroll + rows { ed.row = ed.scroll + rows - 1; }
    if ed.row >= total { ed.row = total - 1; }
    if ed.row < 0 { ed.row = 0; }
    if ed.col < 0 { ed.col = 0; }
    state.output = "editor scroll " + str(ed.scroll + 1) + "/" + str(total);
    return true;
}

fn _editor_scroll_by(state, delta) {
    let sz = try state.winsz catch nil;
    if sz == nil { return false; }
    let ed = state.ed;
    let rows = num_floor((sz.h - STATUSH - _code_content_top(state)) / CH);
    if rows < 1 { return false; }
    let total = E.line_count(ed);
    ed.scroll = _clamp_scroll((try ed.scroll catch 0) + delta, total, rows);
    if ed.row < ed.scroll { ed.row = ed.scroll; }
    if ed.row >= ed.scroll + rows { ed.row = ed.scroll + rows - 1; }
    if ed.row >= total { ed.row = total - 1; }
    if ed.row < 0 { ed.row = 0; }
    state.output = "editor scroll " + str(ed.scroll + 1) + "/" + str(total);
    return true;
}

fn _scroll_active_surface(state, e) {
    let delta = _scroll_event_delta(e);
    if delta == 0 { return false; }
    if try state.examples_mode catch false {
        let hits = _example_clamp(state);
        state.example_sel = _clamp_index((try state.example_sel catch 0) + delta, len(hits));
        return true;
    }
    if try state.command_mode catch false {
        let hits = _command_clamp(state);
        state.command_sel = _clamp_index((try state.command_sel catch 0) + delta, len(hits));
        return true;
    }
    if try state.quick_open_mode catch false {
        let hits = _quick_open_clamp(state);
        state.quick_sel = _clamp_index((try state.quick_sel catch 0) + delta, len(hits));
        return true;
    }
    if state.panel == "code" { return _editor_scroll_by(state, delta); }
    if state.panel == "web" { return _web_scroll_by(state, delta); }
    if state.panel == "files" {
        let hits = _files_clamp(state);
        state.files.sel = _clamp_index((try state.files.sel catch 0) + delta, len(hits));
        return true;
    }
    if state.panel == "outline" {
        let hits = _outline_clamp(state);
        state.outline.sel = _clamp_index((try state.outline.sel catch 0) + delta, len(hits));
        return true;
    }
    if state.panel == "problems" {
        state.problems.sel = _clamp_index((try state.problems.sel catch 0) + delta, _problems_count(state));
        return true;
    }
    if state.panel == "hist" {
        let hits = _history_clamp(state);
        state.history_sel = _clamp_index((try state.history_sel catch 0) + delta, len(hits));
        return true;
    }
    if state.panel == "manage" {
        let hits = _manage_clamp(state);
        state.manage.sel = _clamp_index((try state.manage.sel catch 0) + delta, len(hits));
        return true;
    }
    if state.panel == "settings" {
        let hits = _settings_clamp(state);
        state.settings.sel = _clamp_index((try state.settings.sel catch 0) + delta, len(hits));
        return true;
    }
    return false;
}

// place the caret at the mouse, optionally extending the selection (drag).

fn _mouse_place(state, mx, my, extend) {
    let p = _mouse_pos(state, mx, my);
    if p == nil { return false; }
    let ed = state.ed;
    let old_row = try ed.row catch 0;
    let old_col = try ed.col catch 0;
    let old_anchor = try ed.anchor catch nil;
    if extend { if ed.anchor == nil { E.set_anchor(ed); } } else { E.clear_selection(ed); }
    E.set_cursor(ed, p.row, p.col);
    let next_anchor = try ed.anchor catch nil;
    return old_row != ed.row or old_col != ed.col or str(old_anchor) != str(next_anchor);
}

fn main() {
    // Window is glyph-aware but has web-IDE-like minimum dimensions. With SCALE=1 the
    // UI is cleaner/less blocky; users can raise PBIDE_SCALE without getting a tiny
    // viewport.
    let winw = GUTTERX + 5 * CW + 100 * CW + PAD;
    let winh = TOP + 46 * CH + PANEH;
    if winw < 1280 { winw = 1280; }
    if winh < 860 { winh = 860; }
    // Cap to ~94% of the detected display so the auto-scaled window always fits on
    // screen (and leaves room for the OS taskbar/dock); never below the minimums.
    if DISPLAY != nil {
        let dw = try DISPLAY.w catch 0;
        let dh = try DISPLAY.h catch 0;
        if dw != nil and dw >= 800 {
            let maxw = num_floor(dw * 94 / 100);
            if winw > maxw { winw = maxw; }
        }
        if dh != nil and dh >= 600 {
            let maxh = num_floor(dh * 94 / 100);
            if winh > maxh { winh = maxh; }
        }
    }
    let win = gfx.Window(winw, winh, "pblang IDE - Smart Code Editor");
    let cwd0 = try env_get("PWD") catch ".";
    if cwd0 == nil { cwd0 = "."; }
    let ed0 = E.new(_starter_code());
    let path0 = _fallback_path();
    let roots0 = _files_load_saved_roots(cwd0, path0);
    let rootMeta0 = _files_load_saved_root_meta();
    let hist0 = _history_load_persistent();
    let histMode0 = "temporary";
    if len(hist0) > 0 { histMode0 = "permanent"; }
    let initialFrame = map{ w: winw, h: winh };
    let state = map{
        panel: "code",                                   // active toolbar tab
        ed: ed0,
        shift: false, ctrl: false, alt: false, meta: false, find_mode: false, query: "", goto_line_mode: false, goto_line_input: "",
        replace_mode: false, replace_text: "", replace_focus: "find",
        rows: 40, path: path0, last: "other",
        file_profile: IDE.editor_asset_profile(path0), preview_mode: "syntax", preview_path: "",
        tokens: nil, token_lines: nil, syntax_rev: 0 - 1, syntax_hash: "", dirty: true, redraw: true, syntax_status: "",
        project_root: "", project_files: [path0],
        file_tabs: [map{ title: _file_tab_title(path0), path: path0, code: E.text(ed0), dirty: true, file_profile: IDE.editor_asset_profile(path0), preview_mode: "syntax", project_root: "", project_files: [path0], example_run_path: "", example_app_kind: "", example_title: "" }],
        file_tab_sel: 0, file_tab_scroll: 0, file_tab_layout: [],
        build_mode: "debug", watch_enabled: true, watch: IDE.watcher_new(path0, E.text(ed0)),
        open_mode: false, open_path: "", save_as_mode: false, save_as_path: "",
        quick_open_mode: false, quick_query: "", quick_sel: 0, quick_dir: cwd0, quick_entries: [],
        recent_files: [],
        files: map{ dir: cwd0, roots: roots0, root_meta: rootMeta0, root_index: IDE.project_root_index(roots0, cwd0), query: "", sel: 0, mode: "flat", tree_depth: 3, tree_max: 600, entries: [], clipboard: nil, remote: IDE.file_transfer_profile("remote", "", "", "sftp") },
        database: map{ profiles: [], migrations: [], backups: [] },
        outline: map{ query: "", sel: 0 },
        problems: map{ sel: 0, query: "" },
        manage: map{ query: "", sel: 0 },
        settings: map{ query: "", sel: 0 },
        examples_mode: false, example_query: "", example_sel: 0, example_run_path: "", example_app_kind: "", example_title: "",
        command_mode: false, command_query: "", command_sel: 0,
        mx: 0, my: 0, mdown: false, split_drag: false, code_scroll_drag: false, winsz: nil, outw: 30 * CW, ui_snapshot: nil, ui_snapshot_sig: "", ui_events: [], hover_tab: nil, toolbar_layout: nil,
        style: "crystal", theme: "dark", density_scale: SCALE, window_size: initialFrame,
        live_winsz: initialFrame, display_winsz: DISPLAY, viewport_layout: _viewport_layout_for(initialFrame),
        window_probe_enabled: _window_probe_default(), monitor_probe_enabled: _monitor_probe_default(),
        window_probe_last_ms: 0, window_monitor_probe_last_ms: 0,
        event_count: 0, last_event: "none", last_input_ms: 0, last_present_ms: 0, last_frame_sig: nil, watch_draw_last_ms: 0,
        render_runtime: map{ format: "pbide.render.runtime_plan.v1", pressure: "ok", throttle: "none", idle_ms: 500, min_draw_gap_ms: 0, input_grace_ms: 60, summary: "runtime none idle 500ms min-gap 0ms fps 60" },
        render_runtime_last_ms: 0, render_runtime_last_draws: 0, render_runtime_refreshes: 0, render_runtime_cache: nil,
        perf: map{ draws: 0, skips: 0, last_draw_ms: 0, avg_draw_ms: 0 },
        term: map{ cwd: cwd0, input: "", lines: ["pblang terminal — runs real PC commands (needs --allow-exec). Try: ls, pwd, cd .."], cmd_history: [], hist_pos: 0, hist_draft: "" },
        design: map{ tool: "button", target: "gui", layout: "free", widgets: [], sel: 0 - 1, drag: false, dx: 0, dy: 0, counter: 0, path: path0, title: _file_tab_title(path0) },
        design_tabs: [], design_tab_sel: 0, design_tab_scroll: 0, design_tab_layout: [],
        ai: map{ input: "", last_response: "", last_cue: "", prompt_history: [], hist_pos: 0, hist_draft: "", lines: ["pbAI — pblang's own assistant (no network, no Ollama). Type a question + Enter,", "or use EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT / DIAG, then INSERT the last answer."] },
        web: map{ input: "example.com", url: "", title: "", mode: "live", security: "safe", tor: false, status: "safe", scroll: 0, history: [], forward: [], bookmarks: [], download_plans: [], search_engine: "duckduckgo", home: "example.com", find_query: "", tabs: [], tab_sel: 0, tab_scroll: 0, tab_layout: [], tab_add_rect: nil, page_obj: nil, page: ["pblang browser - type a URL + Enter to load. Live/Reader/Links/Forms/Source/Inspect/Host modes."], reader: ["pblang browser - type a URL + Enter to load. Up/Down scroll."], links: [], forms: ["No forms loaded."], form_sel: 0, form_field_sel: 0, form_values: map{}, source: ["No source loaded."], inspect: ["No inspector details loaded."], render_img: nil, render_path: "", render_lines: ["Host mode: switch security to Trusted or JS/DOM, enter a URL, click Host. Needs --allow-exec and chromium/google-chrome/brave/firefox."], lines: ["pblang browser - type a URL + Enter to load. Up/Down scroll."] },
        diagnostics: [],
        diag_index: 0 - 1,
        nav_back: [], nav_forward: [],
        history: hist0,
        history_mode: histMode0,
        history_stored: len(hist0) > 0,
        help: false,                                     // F1 shortcuts overlay
        output: "ready · effects=" + PBIDE_EFFECT_MODE + " · click to place cursor · drag to select · F5 run · F6 check · F1 help"
    };
    gfx.run(win, state,
    fn(s, events) {
        _maybe_probe_window(s);
        if len(events) > 0 { _debug_event("events=" + str(len(events))); }
        let i = 0;
        while i < len(events) {
            let e = events[i];
            if e.type == "keydown" {
                _record_input_event(s, "keydown " + str(try e.key catch "?"));
                s.redraw = true;            // any keypress means the view may have changed
                _apply_event_modifiers(s, e);
                if e.key == "F1" { s.help = not s.help; }                          // toggle the shortcuts overlay
                else if s.help { if e.key == "Escape" { s.help = false; } }         // while open, only Esc/F1 act
                else if K.is_shift(e.key) { s.shift = true; }
                else if K.is_ctrl(e.key) { s.ctrl = true; }
                else if K.is_alt(e.key) { s.alt = true; }
                else if K.is_meta(e.key) { s.meta = true; }
                else if try s.open_mode catch false { let st = _key(s, e.key); if st != "" { s.output = st; } }
                else if try s.save_as_mode catch false { let st = _key(s, e.key); if st != "" { s.output = st; } }
                else if try s.quick_open_mode catch false { _quick_open_key(s, e.key, s.shift); }
                else if try s.goto_line_mode catch false { _goto_line_key(s, e.key, s.shift); }
                else if try s.command_mode catch false { _command_key(s, e.key, s.shift); }
                else if try s.examples_mode catch false { _examples_key(s, e.key, s.shift); }
                else if s.alt and e.key == "Left" { _nav_back(s); }
                else if s.alt and e.key == "Right" { _nav_forward(s); }
                else if s.ctrl and e.key == "G" { _open_goto_line(s); }
                else if s.ctrl and e.key == "P" { _open_command_palette(s); }
                else if s.ctrl and s.panel != "files" and (e.key == "Minus" or e.key == "NumpadSubtract" or e.key == "-") { _density_delta(s, 0 - 1); }
                else if s.ctrl and s.panel != "files" and (e.key == "Equals" or e.key == "Plus" or e.key == "NumpadAdd" or e.key == "=" or e.key == "+") { _density_delta(s, 1); }
                else if s.ctrl and _panel_shortcut(s, e.key) { }
                else if s.ctrl and s.shift and e.key == "Tab" { _panel_step(s, 0 - 1); }
                else if s.ctrl and (e.key == "Tab" or e.key == "PageDown") { _panel_step(s, 1); }
                else if s.ctrl and (e.key == "PageUp" or e.key == "BackTab") { _panel_step(s, 0 - 1); }
                else if e.key == "F5" { s.panel = "code"; _run_action(s); }
                else if e.key == "F6" { s.panel = "code"; _check_action(s); }
                else if e.key == "F11" { _mode_toggle(s); }
                else if e.key == "F12" { _watch_toggle(s); }
                else if e.key == "F2" { s.panel = "code"; }
                else if e.key == "F3" { s.panel = "term"; }
                else if e.key == "F4" { s.panel = "design"; _design_tabs_focus_path(s, try s.path catch ""); }
                else if e.key == "F7" { s.panel = "ai"; }
                else if e.key == "F8" {
                    let dd = 1;
                    if s.shift { dd = 0 - 1; }
                    _diagnostic_goto(s, dd);
                }
                else if e.key == "F10" { s.panel = "web"; }
                else if e.key == "F9" { s.panel = "hist"; }
                else if s.panel == "term" { _term_key(s, e.key, s.shift); }        // terminal owns its input line
                else if s.panel == "design" { _design_key(s, e.key, s.shift); }    // designer: edit/delete selected widget
                else if s.panel == "ai" { _ai_key(s, e.key, s.shift); }            // AI panel owns its question box
                else if s.panel == "web" { _web_key(s, e.key, s.shift); }          // browser owns its address bar
                else if s.panel == "files" { _files_key(s, e.key, s.shift); }
                else if s.panel == "outline" { _outline_key(s, e.key, s.shift); }
                else if s.panel == "problems" { _problems_key(s, e.key, s.shift); }
                else if s.panel == "hist" { _history_key(s, e.key, s.shift); }
                else if s.panel == "manage" { _manage_key(s, e.key, s.shift); }
                else if s.panel == "settings" { _settings_key(s, e.key, s.shift); }
                else if s.panel == "code" { let st = _key(s, e.key); if st != "" { s.output = st; } }
            }
            if e.type == "keyup" {
                _record_input_event(s, "keyup " + str(try e.key catch "?"));
                _apply_event_modifiers(s, e);
                if K.is_shift(e.key) { s.shift = false; }
                if K.is_ctrl(e.key) { s.ctrl = false; }
                if K.is_alt(e.key) { s.alt = false; }
                if K.is_meta(e.key) { s.meta = false; }
            }
            if e.type == "resize" {
                let nw = try e.w catch try s.winsz.w catch 0;
                let nh = try e.h catch try s.winsz.h catch 0;
                if nw > 0 and nh > 0 {
                    s.live_winsz = map{ w: nw, h: nh };
                    s.window_size = s.live_winsz;
                    _apply_display_event(s, e);
                    s.viewport_layout = _viewport_layout_for(s.live_winsz);
                    _apply_toolbar_metrics(s.live_winsz);
                    _apply_live_density(s, _density_basis_for_state(s, s.live_winsz));
                    _record_input_event(s, "resize " + str(nw) + "x" + str(nh));
                    s.redraw = true;
                }
            }
            // LIVE cross-screen autoscale: the SDL2 backend reports window moves with
            // the size of the display under the window, so density updates the moment
            // the window is dragged onto another monitor — no shell probe, no delay.
            if e.type == "moved" {
                if _apply_display_event(s, e) {
                    _apply_live_density(s, _density_basis_for_state(s, try s.live_winsz catch s.winsz));
                    s.viewport_layout = _viewport_layout_for(try s.live_winsz catch map{ w: 1280, h: 760 });
                    _record_input_event(s, "moved to display " + str(try s.display_winsz.w catch "?") + "x" + str(try s.display_winsz.h catch "?"));
                    s.redraw = true;
                }
            }
            if e.type == "scroll" {
                if _debug_events_enabled() { _record_input_event(s, "scroll dx=" + str(try e.dx catch 0) + " dy=" + str(try e.dy catch 0)); }
                if _scroll_active_surface(s, e) { s.redraw = true; }
            }
            // mousedown carries no coords (like gui.sapp) — use the tracked cursor.
            if e.type == "mousemove" {
                if _debug_events_enabled() { _record_input_event(s, "mousemove " + str(try e.x catch "?") + "," + str(try e.y catch "?")); }
                s.mx = e.x; s.my = e.y;
                // hover feedback: highlight the toolbar button under the cursor (redraw
                // only when the hovered target changes, so idle mouse motion stays free)
                let hov = nil;
                if e.y < TBH + CH { hov = _toolbar_hit(s, e.x, e.y, s.winsz); }
                if hov != (try s.hover_tab catch nil) { s.hover_tab = hov; s.redraw = true; }
                if s.split_drag {
                    _resize_output_pane(s, e.x);
                    s.redraw = true;
                }
                if s.mdown and s.panel == "code" and not (try s.code_scroll_drag catch false) {
                    if _mouse_place(s, e.x, e.y, true) { s.redraw = true; }
                }  // drag = extend selection
                if s.panel == "design" and s.design.drag and s.design.sel >= 0 {                       // drag = move widget
                    let w = s.design.widgets[s.design.sel];
                    w.x = e.x - s.design.dx; w.y = e.y - s.design.dy;
                    _design_snap_widget(s, w, false);
                    _design_clamp_widget(s, w);
                    s.redraw = true;
                }
            }
            if e.type == "mousedown" and (try e.button catch "Left") == "Left" {
                // Prefer the click's OWN coordinates (the host now attaches x/y to
                // mousedown); fall back to the tracked cursor only if absent. Using a
                // stale tracked position is what made tab clicks land on random tabs.
                let dx = try e.x catch s.mx;
                let dy = try e.y catch s.my;
                _record_input_event(s, "mousedown " + str(dx) + "," + str(dy) + " button=" + str(try e.button catch "?"));
                s.mx = dx; s.my = dy;
                _ui_event(s, "mouse " + str(dx) + "," + str(dy) + " panel=" + str(s.panel));
                let captured = false;
                if _modal_mouse_capture(s, dx, dy) { captured = true; }
                if not captured and try s.quick_open_mode catch false { captured = _quick_open_click(s, dx, dy); }
                if not captured and try s.command_mode catch false { captured = _command_click(s, dx, dy); }
                if not captured and try s.examples_mode catch false { captured = _examples_click(s, dx, dy); }
                if not captured and _any_modal_open(s) { captured = _modal_backdrop_click(s, dx, dy); }
                if captured { s.redraw = true; }
                else {
                    let tab = _toolbar_hit(s, dx, dy, s.winsz);
                    if tab != nil { _record_input_event(s, "toolbar " + str(tab)); _toolbar_click(s, tab); s.redraw = true; }         // web-style toolbar action
                    else if _splitter_hit(s, dx, dy) {
                        s.split_drag = true;
                        _resize_output_pane(s, dx);
                        s.redraw = true;
                    }
                    else {
                        s.mdown = true;
                        s.code_scroll_drag = false;
                        if s.panel == "code" {
                            if _file_tab_click(s, dx, dy) { s.mdown = false; }
                            else if _editor_scrollbar_click(s, dx, dy) { s.code_scroll_drag = true; }
                            else if not _diagnostic_click(s, dx, dy) and not _watcher_click(s, dx, dy) and not _ui_observer_click(s, dx, dy) { _mouse_place(s, dx, dy, false); }
                        }       // click = place caret, diagnostic, or watcher action
                        else if s.panel == "design" { _design_click(s, dx, dy); }      // place/select a widget
                        else if s.panel == "ai" { let act = _ai_hit(dx, dy); if act != nil { _ai_action(s, act); } }  // quick action
                        else if s.panel == "web" { _web_click(s, dx, dy); }
                        else if s.panel == "files" { _files_click(s, dx, dy); }
                        else if s.panel == "outline" { _outline_click(s, dx, dy); }
                        else if s.panel == "problems" { _problems_click(s, dx, dy); }
                        else if s.panel == "hist" { _history_click(s, dx, dy); }
                        else if s.panel == "manage" { _manage_click(s, dx, dy); }
                        else if s.panel == "settings" { _settings_click(s, dx, dy); }
                        s.redraw = true;
                    }
                }
            }
            if e.type == "mouseup" {
                _record_input_event(s, "mouseup " + str(try e.x catch "?") + "," + str(try e.y catch "?"));
                let had_capture = s.mdown or s.split_drag or s.design.drag or (try s.code_scroll_drag catch false);
                s.mdown = false; s.split_drag = false; s.design.drag = false; s.code_scroll_drag = false;
                if had_capture { s.redraw = true; }
            }
            i = i + 1;
        }
    },
    // Only repaint when something changed (idle frames are nearly free). The first
    // frame draws because redraw starts true. A low-rate idle redraw keeps live
    // density/window-probe changes visible even when the backend misses a resize
    // event; PBIDE_IDLE_REDRAW_MS=0 disables it.
    fn(s, w) {
        // Repaint policy lives in the tested stdlib/frame_gate.sapp: an input event
        // (s.redraw) always paints; otherwise we only paint at the idle cadence AND
        // only when the visible-state signature actually changed. That kills the old
        // "full redraw every idle interval even when idle" CPU burn — an untouched
        // window now does ZERO rasterization and ZERO GPU texture uploads per tick.
        let now = try now_ms() catch 0;
        // The adaptive runtime plan is cached. Rebuilding the old synthetic
        // frame plan here allocated dozens of maps on every 60 Hz idle tick.
        let runtime = try _render_runtime_current(s) catch map{ idle_ms: _idle_redraw_interval_ms(), min_draw_gap_ms: 0, input_grace_ms: 60, summary: "runtime steady" };
        let idle_ms = _adaptive_idle_redraw_interval_ms(s);
        if not s.redraw and not GATE.due(now, idle_ms, (try s.last_present_ms catch 0)) {
            return false;
        }
        if _defer_non_input_redraw(s, now, runtime) {
            return false;
        }
        let sig = _frame_sig(s);
        let dec = GATE.decide(s.redraw, now, idle_ms,
        (try s.last_present_ms catch 0), sig, (try s.last_frame_sig catch nil));
        if dec.draw {
            let draw0 = try now_ms() catch now;
            _draw(s, w);
            let draw1 = try now_ms() catch draw0;
            _perf_record_draw(s, draw1 - draw0);
            _render_runtime_refresh(s, draw1, false);
            s.redraw = false;
            s.last_present_ms = now;
            s.last_frame_sig = sig;
            return true;
        }
        _perf_record_skip(s);
        return false;
    },
    // 60 Hz event loop: input latency drops from ~50ms (20fps) to ~16ms so clicks,
    // hover, and typing feel immediate. Idle frames skip present (drawFn returns
    // false), so the higher rate costs almost nothing when nothing changes.
    60);
}
main();
