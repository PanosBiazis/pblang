map{
    title: "Safe calculator",
    app_kind: "gui",
    project_root: "examples/safe_calculator",
    main_path: "examples/safe_calculator/main.sapp",
    design_preset: "safe_calculator",
    design_target: "gui",
    open_panel: "design",
    run_path: "examples/safe_calculator/gui.sapp",
    files: [
    "examples/safe_calculator/main.sapp",
    "examples/safe_calculator/lib.sapp",
    "examples/safe_calculator/gui.sapp",
    "examples/safe_calculator/README.md"
    ],
    code: "// Safe calculator core inspired by PyCalculator, but pblang-native and no eval()\nfn ok(value) { return map{ ok: true, value: value, message: \"\" }; }\nfn fail(message) { return map{ ok: false, value: 0, message: message }; }\n\nfn calc(a, symbol, b) {\n    if symbol == \"+\" { return ok(a + b); }\n    if symbol == \"-\" { return ok(a - b); }\n    if symbol == \"*\" { return ok(a * b); }\n    if symbol == \"/\" {\n        if b == 0 { return fail(\"division by zero\"); }\n        return ok(a / b);\n    }\n    return fail(\"unknown operator: \" + symbol);\n}\n\nlet keypad = [[\"7\", \"8\", \"9\", \"/\"], [\"4\", \"5\", \"6\", \"*\"], [\"1\", \"2\", \"3\", \"-\"], [\"0\", \".\", \"=\", \"+\"]];\nlet history = [];\nlet jobs = [\n    map{ a: 1, symbol: \"+\", b: 1 },\n    map{ a: 7, symbol: \"*\", b: 3 },\n    map{ a: 27, symbol: \"/\", b: 9 },\n    map{ a: 8, symbol: \"/\", b: 0 }\n];\n\nfor job in jobs {\n    let r = calc(job.a, job.symbol, job.b);\n    let expr = str(job.a) + \" \" + job.symbol + \" \" + str(job.b);\n    if r.ok {\n        let line = expr + \" = \" + str(r.value);\n        push(history, line);\n        print line;\n    } else {\n        print expr + \" -> Error: \" + r.message;\n    }\n}\n\nprint \"keypad rows=\" + str(len(keypad));\nprint \"history_count=\" + str(len(history));\n"
},
