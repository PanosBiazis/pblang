fn _app_target_next(mode) {
    if mode == "gui" { return "web"; }
    if mode == "web" { return "both"; }
    if mode == "both" { return "doc"; }
    return "gui";
}
fn _layout_next(mode) {
    if mode == "free" { return "responsive"; }
    if mode == "responsive" { return "grid"; }
    if mode == "grid" { return "stack-y"; }
    return "free";
}
fn _design_apply_layout(state) {
    let mode = try state.design.layout catch "free";
    if mode == "free" { return 0; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    let contentTop = top + 2 * CH + PAD;
    let bottom = state.winsz.h - (CH + PAD);
    let vp = DE.viewport(state.winsz.w, bottom - contentTop);
    let i = 0;
    while i < len(state.design.widgets) {
        if state.design.widgets[i].y >= contentTop { state.design.widgets[i].y = state.design.widgets[i].y - contentTop; }
        i = i + 1;
    }
    DE.apply_layout(state.design.widgets, vp, mode);
    i = 0;
    while i < len(state.design.widgets) {
        state.design.widgets[i].y = state.design.widgets[i].y + contentTop + PAD;
        _design_snap_widget(state, state.design.widgets[i], true);
        _design_clamp_widget(state, state.design.widgets[i]);
        i = i + 1;
    }
    return 0;
}
fn _design_content_top(state) {
    if state.winsz == nil { return TOP + CH + PAD; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    return top + 2 * CH + PAD;
}
fn _design_snap_widget(state, w, include_size) {
    if state.winsz == nil { return 0; }
    let ox = PAD;
    let oy = _design_content_top(state) + PAD;
    w.x = ox + DE.snap_value((try w.x catch ox) - ox, DESIGN_GRID);
    w.y = oy + DE.snap_value((try w.y catch oy) - oy, DESIGN_GRID);
    if include_size {
        let minw = _design_min_w(w);
        let minh = _design_min_h(w);
        w.w = DE.snap_value(try w.w catch minw, DESIGN_GRID);
        w.h = DE.snap_value(try w.h catch minh, DESIGN_GRID);
        if w.w < minw { w.w = minw; }
        if w.h < minh { w.h = minh; }
    }
    return 0;
}
fn _design_min_w(w) {
    let k = str(try w.kind catch "");
    if k == "label" { return 4 * CW; }
    if k == "checkbox" or k == "radio" { return 8 * CW; }
    if k == "slider" { return 10 * CW; }
    if k == "cube" or k == "sphere" { return 8 * CW; }
    if k == "chart2d" or k == "nditem" { return 10 * CW; }
    if k == "camera" or k == "light" or k == "material" or k == "terrain" or k == "particles" or k == "physics" or k == "prefab" or k == "backend" { return 12 * CW; }
    return 6 * CW;
}
fn _design_min_h(w) {
    let k = str(try w.kind catch "");
    if k == "label" or k == "checkbox" or k == "radio" { return CH; }
    if k == "cube" or k == "sphere" { return 6 * CH; }
    if k == "chart2d" or k == "nditem" { return 4 * CH; }
    if k == "camera" or k == "light" or k == "material" or k == "terrain" or k == "particles" or k == "physics" or k == "prefab" or k == "backend" { return 4 * CH; }
    return CH + PAD;
}
fn _design_clamp_widget(state, w) {
    if state.winsz == nil { return 0; }
    let top = TOP + _pal_height(state.winsz) + PAD;
    let contentTop = _design_content_top(state);
    let bottom = state.winsz.h - (CH + PAD);
    let maxx = state.winsz.w - (try w.w catch 24) - PAD;
    let maxy = bottom - (try w.h catch 18) - PAD;
    if maxx < PAD { maxx = PAD; }
    if maxy < contentTop + PAD { maxy = contentTop + PAD; }
    if w.x < PAD { w.x = PAD; }
    if w.y < contentTop + PAD { w.y = contentTop + PAD; }
    if w.x > maxx { w.x = maxx; }
    if w.y > maxy { w.y = maxy; }
    return 0;
}
fn _design_refresh_widget(w) {
    if w.kind == "custom" and (try w.component catch nil) != nil { w.component.name = w.text; }
    else if w.kind == "prefab" and (try w.component catch nil) != nil { w.component.name = w.text; }
    if try w.manual_size catch false { return 0; }
    if w.kind == "label" { w.w = len(w.text) * CW; if w.w < CW { w.w = CW; } w.h = CH; }
    else if w.kind == "checkbox" { w.w = 5 * SCALE + PAD + len(w.text) * CW; w.h = CH; }
    else if w.kind == "radio" { w.w = 5 * SCALE + PAD + len(w.text) * CW; w.h = CH; }
    return 0;
}
fn _design_resize_selected(state, dw, dh) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = d.widgets[d.sel];
    w.w = (try w.w catch 80) + dw;
    w.h = (try w.h catch 28) + dh;
    let minw = _design_min_w(w);
    let minh = _design_min_h(w);
    if w.w < minw { w.w = minw; }
    if w.h < minh { w.h = minh; }
    w.manual_size = true;
    _design_snap_widget(state, w, true);
    _design_clamp_widget(state, w);
    state.output = "designer resized " + str(try w.name catch "?") + " to " + str(w.w) + "x" + str(w.h) + " (snap " + str(DESIGN_GRID) + ")";
    return 0;
}
fn _design_move_selected(state, dx, dy) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = d.widgets[d.sel];
    w.x = (try w.x catch PAD) + dx;
    w.y = (try w.y catch PAD) + dy;
    _design_snap_widget(state, w, false);
    _design_clamp_widget(state, w);
