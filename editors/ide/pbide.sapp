}
fn _design_copy_value(v) {
    if type(v) == "array" {
        let out = [];
        let i = 0;
        while i < len(v) { push(out, _design_copy_value(v[i])); i = i + 1; }
        return out;
    }
    if type(v) == "map" {
        let out = map{};
        let ks = map_keys(v);
        let i = 0;
        while i < len(ks) {
            out[ks[i]] = _design_copy_value(v[ks[i]]);
            i = i + 1;
        }
        return out;
    }
    return v;
}
fn _design_select_delta(state, delta) {
    let d = state.design;
    let n = len(d.widgets);
    if n <= 0 { d.sel = 0 - 1; state.output = "designer: no items"; return 0; }
    let s = try d.sel catch 0 - 1;
    if s < 0 { if delta < 0 { s = n - 1; } else { s = 0; } }
    else { s = num_mod(s + delta + n, n); }
    d.sel = s;
    let w = d.widgets[d.sel];
    state.output = "designer selected " + str(d.sel + 1) + "/" + str(n) + ": " + str(try w.name catch try w.kind catch "?");
    return 0;
}
fn _design_duplicate_selected(state) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { return 0; }
    let w = _design_copy_value(d.widgets[d.sel]);
    d.counter = (try d.counter catch 0) + 1;
    w.name = str(try w.name catch try w.kind catch "item") + "_copy" + str(d.counter);
    w.x = (try w.x catch PAD) + DESIGN_GRID * 2;
    w.y = (try w.y catch _design_content_top(state)) + DESIGN_GRID * 2;
    _design_snap_widget(state, w, false);
    _design_clamp_widget(state, w);
    _design_refresh_widget(w);
    push(d.widgets, w);
    d.sel = len(d.widgets) - 1;
    state.output = "designer duplicated " + str(w.name);
    return 0;
}
fn _design_layer_selected(state, dir, extreme) {
    let d = state.design;
    let n = len(d.widgets);
    if d.sel < 0 or d.sel >= n { return 0; }
    let old = d.sel;
    let target = old + dir;
    if extreme {
        if dir < 0 { target = 0; }
        else { target = n - 1; }
    }
    if target < 0 { target = 0; }
    if target >= n { target = n - 1; }
    if target == old { return 0; }
    let w = d.widgets[old];
    let out = [];
    let i = 0;
    while i < n {
        if i != old { push(out, d.widgets[i]); }
        i = i + 1;
    }
    if target > len(out) { target = len(out); }
    let final = [];
    i = 0;
    while i < len(out) {
        if i == target { push(final, w); }
        push(final, out[i]);
        i = i + 1;
    }
    if target == len(out) { push(final, w); }
    d.widgets = final;
    d.sel = target;
    state.output = "designer layer " + str(try w.name catch "?") + " -> " + str(d.sel + 1) + "/" + str(n);
    return 0;
}
fn _design_delete_selected(state) {
    let d = state.design;
    if d.sel < 0 or d.sel >= len(d.widgets) { state.output = "designer: no selected item"; return 0; }
    let old = try d.widgets[d.sel].name catch try d.widgets[d.sel].kind catch "item";
    let out = [];
    let i = 0;
    while i < len(d.widgets) { if i != d.sel { push(out, d.widgets[i]); } i = i + 1; }
    d.widgets = out;
    if len(d.widgets) == 0 { d.sel = 0 - 1; }
    else if d.sel >= len(d.widgets) { d.sel = len(d.widgets) - 1; }
    state.output = "designer deleted " + str(old);
    return 0;
}
fn _design_clear(state) {
    state.design.widgets = [];
    state.design.sel = 0 - 1;
    state.output = "designer canvas cleared";
    return 0;
}
fn _design_generate_to_editor(state) {
    let code = _design_code(state);
    let parsed = FE.frontend_parse_safe(code);
    if not parsed.ok {
        state.output = "designer codegen blocked: generated source did not parse";
        return 0;
    }
    state.ed = E.new(code);
    state.dirty = true; state.tokens = nil; state.syntax_hash = ""; state.last = "other";
    state.panel = "code";
    state.output = "designer -> generated " + str(len(state.design.widgets)) + " widget(s) into the editor (F5 to run)";
    return 0;
}
fn _design_component_default_id(state) {
    let q = str(try state.design.tool catch "");
    let hits = IDE.filter_designer_components(q, 1);
    if len(hits) > 0 { return str(try hits[0].id catch "app_shell"); }
    return "app_shell";
}
fn _design_apply_preset_item(state, item) {
    let kind = str(try item.kind catch "panel");
    let x = try item.x catch PAD * 2;
    let y = try item.y catch _design_content_top(state) + PAD;
    let w = _make_widget(state, kind, x, y);
    if w == nil { return nil; }
    if (try item.name catch "") != "" { w.name = str(item.name); }
    if (try item.w catch nil) != nil { w.w = item.w; w.manual_size = true; }
    if (try item.h catch nil) != nil { w.h = item.h; w.manual_size = true; }
    let text = try item.text catch nil;
    if text != nil {
        let fk = _w_textkey(w);
        if fk != "" { w[fk] = str(text); }
        if (try w.title catch nil) != nil { w.title = str(text); }
    }
    if (try item.title catch nil) != nil { w.title = str(item.title); }
    _design_refresh_widget(w);
    _design_snap_widget(state, w, true);
    _design_clamp_widget(state, w);
    return w;
}
fn _design_insert_component_preset(state) {
    let id = _design_component_default_id(state);
    let preset = IDE.designer_component_preset(id, PAD * 2, _design_content_top(state) + PAD);
    if not (try preset.ok catch false) {
        state.output = str(try preset.summary catch "component preset unavailable");
        return 0;
    }
    let items = try preset.items catch [];
    let added = 0;
    let i = 0;
    while i < len(items) {
        let w = _design_apply_preset_item(state, items[i]);
        if w != nil {
            array_push(state.design.widgets, w);
            state.design.sel = len(state.design.widgets) - 1;
            added = added + 1;
        }
        i = i + 1;
    }
    _design_apply_layout(state);
    state.output = "designer inserted component preset: " + str(try preset.title catch id) + " (" + str(added) + " item(s))";
    return 0;
}
fn _design_command(state, action) {
    let d = state.design;
    if action == "codegen" { _design_generate_to_editor(state); return 0; }
    if action == "clear" { _design_clear(state); return 0; }
    if action == "layout_next" {
        d.layout = _layout_next(try d.layout catch "free");
        _design_apply_layout(state);
        state.output = "designer layout: " + d.layout;
        return 0;
    }
    if action == "target_next" {
        d.target = _app_target_next(try d.target catch "gui");
        state.output = "designer app target: " + d.target;
        return 0;
    }
    if action == "select_next" { _design_select_delta(state, 1); return 0; }
    if action == "select_prev" { _design_select_delta(state, 0 - 1); return 0; }
    if action == "duplicate" { _design_duplicate_selected(state); return 0; }
    if action == "delete" { _design_delete_selected(state); return 0; }
    if action == "layer_back" { _design_layer_selected(state, 0 - 1, false); return 0; }
    if action == "layer_forward" { _design_layer_selected(state, 1, false); return 0; }
    if action == "layer_bottom" { _design_layer_selected(state, 0 - 1, true); return 0; }
    if action == "layer_top" { _design_layer_selected(state, 1, true); return 0; }
    if action == "component_library" {
        let lines = IDE.designer_component_lines(IDE.filter_designer_components("", 12), 12);
        state.output = "Designer component library\n" + str_join(lines, "\n");
        return 0;
    }
    if action == "component_insert" { _design_insert_component_preset(state); return 0; }
    state.output = "designer command not handled: " + str(action);
    return 0;
}
// a click in the Designer: palette action, select+drag an existing widget, or place one.
fn _design_click(state, mx, my) {
    let d = state.design;
    let p = _pal_hit(mx, my, state.winsz);
        if p != nil {
        if p == "apptype" {
            d.target = _app_target_next(try d.target catch "gui");
            state.output = "designer app target: " + d.target;
            return 0;
        }
        if p == "layout" {
            d.layout = _layout_next(try d.layout catch "free");
            _design_apply_layout(state);
            state.output = "designer layout: " + d.layout;
            return 0;
        }
        if p == "gencode" {
            _design_generate_to_editor(state);
            return 0;
        }
        if p == "clear" { _design_clear(state); return 0; }
        d.tool = p; return 0;
    }
    let canvTop = TOP + _pal_height(state.winsz) + PAD;
    let canvBot = state.winsz.h - (CH + PAD);
    if my < canvTop or my >= canvBot { return 0; }
    let hi = _design_widget_at(state, mx, my);
    if hi >= 0 {
        d.sel = hi; d.drag = true;
        d.dx = mx - d.widgets[hi].x; d.dy = my - d.widgets[hi].y;
        return 0;
    }
    let w = _make_widget(state, d.tool, mx, my);
    if w != nil {
        _design_snap_widget(state, w, false);
        _design_clamp_widget(state, w);
        array_push(d.widgets, w);
        d.sel = len(d.widgets) - 1;
        _design_apply_layout(state);
    }
    return 0;
}
fn _design_key(state, key, shift) {
    let d = state.design;
    if key == "Tab" { if shift { _design_select_delta(state, 0 - 1); } else { _design_select_delta(state, 1); } return 0; }
    if d.sel < 0 { return 0; }
    let w = d.widgets[d.sel];
    if key == "Delete" {
        _design_delete_selected(state);
        return 0;
    }
    if key == "Insert" { _design_duplicate_selected(state); return 0; }
    if try state.ctrl catch false {
        if key == "[" or key == "LeftBracket" { _design_layer_selected(state, 0 - 1, shift); return 0; }
        if key == "]" or key == "RightBracket" { _design_layer_selected(state, 1, shift); return 0; }
    }
    if key == "Left" or key == "Right" or key == "Up" or key == "Down" {
        let step = 4 * SCALE;
        if shift { step = 12 * SCALE; }
        let dx = 0;
        let dy = 0;
        if key == "Left" { dx = 0 - step; }
        if key == "Right" { dx = step; }
        if key == "Up" { dy = 0 - step; }
        if key == "Down" { dy = step; }
        if try state.ctrl catch false { _design_resize_selected(state, dx, dy); }
        else { _design_move_selected(state, dx, dy); }
        return 0;
    }
    let fk = _w_textkey(w);
    if fk == "" { return 0; }
    if key == "Backspace" { let v = w[fk]; if len(v) > 0 { w[fk] = str_slice(v, 0, len(v) - 1); _design_refresh_widget(w); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w[fk] = w[fk] + ch; _design_refresh_widget(w); }
    return 0;
}

// ── AI panel (pbAI — stdlib/pbai.sapp) ────────────────────────────────────────────
// A chat against pblang's own assistant: a free-text question box plus quick-action
// chips that run pbAI on whatever is in the CODE editor (explain / find bugs / improve
// / comment / explain diagnostics). pbAI grounds on code wrapped in a
// `--- pblang code ---` marker. The last raw answer can be inserted into the editor.
let AIPAL = [
    map{ id: "explain", label: "EXPLAIN" },
    map{ id: "bugs",    label: "BUGS" },
    map{ id: "improve", label: "IMPROVE" },
    map{ id: "quality", label: "QUALITY" },
    map{ id: "comment", label: "COMMENT" },
    map{ id: "diag",    label: "DIAG" },
    map{ id: "insert",  label: "INSERT" },
    map{ id: "clear",   label: "CLEAR" },
];
fn _ai_bounds(idx) {
    let x = PAD;
    let i = 0;
    while i < idx { x = x + (len(AIPAL[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(AIPAL[idx].label) + 2) * CW };
}
fn _ai_hit(mx, my) {
    if my < TOP or my >= TOP + CH { return nil; }
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        if mx >= b.x and mx < b.x + b.w { return AIPAL[i].id; }
        i = i + 1;
    }
    return nil;
}
fn _ai_push(state, line) {
    array_push(state.ai.lines, line);
    if len(state.ai.lines) > 600 {
        let out = []; let i = len(state.ai.lines) - 400;
        while i < len(state.ai.lines) { push(out, state.ai.lines[i]); i = i + 1; }
        state.ai.lines = out;
    }
    return 0;
}
// send `prompt` to pbAI; `echo` is the user-visible line shown above the answer.
fn _ai_send(state, prompt, echo) {
    _ai_push(state, "> " + echo);
    let reply = try AI.respond(prompt) catch "pbAI error — could not produce a response";
    state.ai.last_response = reply;
    let rl = str_split(reply, "
");
    let i = 0;
    while i < len(rl) { _ai_push(state, "  " + rl[i]); i = i + 1; }
    _ai_push(state, "");
    return 0;
}
fn _ai_diag_prompt(state, code) {
    let dl = IDE.diagnostic_summary(try state.diagnostics catch [], 20);
    let diag = "";
    let i = 0;
    while i < len(dl) {
        if i > 0 { diag = diag + "
"; }
        diag = diag + dl[i];
        i = i + 1;
    }
    if str_trim(diag) == "" { diag = "(no diagnostics - press F6 Check first)"; }
    return "Explain these pblang compiler diagnostics and how to fix them:

" + diag + "

--- pblang code ---
" + code;
}
fn _ai_insert_last_response(state) {
    let reply = str(try state.ai.last_response catch "");
    if str_trim(reply) == "" {
        _ai_push(state, "  no AI response to insert yet");
        return 0;
    }
    E.snapshot(state.ed);
    E.insert_text(state.ed, reply);
    state.dirty = true;
    state.panel = "code";
    state.output = "inserted last pbAI response into editor";
    _refresh_watcher(state, "ai_insert");
    return 0;
}
// quick action: run a pbAI skill on the current editor buffer (or CLEAR the chat).
fn _ai_action(state, id) {
    if id == "clear" { state.ai.lines = []; state.ai.last_response = ""; return 0; }
    if id == "insert" { _ai_insert_last_response(state); return 0; }
    let code = E.text(state.ed);
    if id == "diag" {
        _ai_send(state, _ai_diag_prompt(state, code), "explain diagnostics");
        return 0;
    }
    let verb = "explain what this code does";
    if id == "bugs" { verb = "find the bugs and errors in this code"; }
    else if id == "improve" { verb = "improve and optimize this code"; }
    else if id == "quality" { verb = "improve quality, security, performance, and maintainability of this code"; }
    else if id == "comment" { verb = "add comments documenting this code"; }
    let prompt = verb + ":

--- pblang code ---
" + code;
    _ai_send(state, prompt, id + " (on editor buffer)");
    return 0;
}
fn _ai_key(state, key, shift) {
    let a = state.ai;
    if key == "Up" {
        let m = IDE.ai_prompt_history_move(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch []), "up", try a.hist_draft catch "", try a.input catch "");
        a.hist_pos = m.pos;
        a.hist_draft = m.draft;
        a.input = m.input;
        return 0;
    }
    if key == "Down" {
        let m = IDE.ai_prompt_history_move(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch []), "down", try a.hist_draft catch "", try a.input catch "");
        a.hist_pos = m.pos;
        a.hist_draft = m.draft;
        a.input = m.input;
        return 0;
    }
    if _is_enter(key) {
        if shift { a.input = a.input + "
"; return 0; }                  // Shift+Enter = newline (compose a multi-line question)
        let q = str_trim(a.input);
        a.input = "";
        if q != "" {
            a.prompt_history = IDE.ai_prompt_history_push(try a.prompt_history catch [], q, 80);
            a.hist_pos = len(a.prompt_history);
            a.hist_draft = "";
            _ai_send(state, q, q);
        }
        return 0;
    }
    if key == "Backspace" {
        if len(a.input) > 0 { a.input = str_slice(a.input, 0, len(a.input) - 1); }
        a.hist_pos = len(try a.prompt_history catch []);
        a.hist_draft = "";
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        a.input = a.input + ch;
        a.hist_pos = len(try a.prompt_history catch []);
        a.hist_draft = "";
    }
    return 0;
}
fn _draw_ai(state, win, sz) {
    let a = state.ai;
    // quick-action palette
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        let bg = _style_panel(state); if AIPAL[i].id == "clear" { bg = gfx.rgb(46, 40, 64); }
        if AIPAL[i].id == "clear" and _theme_is_light(state) { bg = gfx.rgb(228, 220, 245); }
        win.rect(b.x, TOP, b.w, CH, bg);
        _dt(win, b.x + CW, TOP + SCALE, AIPAL[i].label, _style_muted(state));
        i = i + 1;
    }
    // chat scrollback (tail), hard-wrapped to fit width
    let maxchars = (sz.w - 2 * PAD) / CW;
    let statusY = TOP + CH + PAD;
    win.rect(0, statusY, sz.w, CH + PAD, _style_surface(state));
    win.rect(0, statusY + CH + PAD, sz.w, SCALE, _style_border(state));
    let aiStatus = IDE.ai_prompt_history_status(try a.prompt_history catch [], try a.hist_pos catch len(try a.prompt_history catch [])) +
        " · Up/Down recall · Shift+Enter newline · INSERT last answer";
    _dt(win, PAD, statusY + PAD / 2, str_slice(aiStatus, 0, maxchars), _style_muted(state));
    let chatTop = statusY + CH + 2 * PAD;
    let promptTop = _draw_input(state, win, sz, "ask pbAI > ", a.input, maxchars);
    let rows = (promptTop - chatTop) / CH;
    let visual = [];
    let li = 0;
    while li < len(a.lines) {
        let wl = _wrap(a.lines[li], maxchars);
        if len(wl) == 0 { push(visual, ""); }
        let wi = 0;
        while wi < len(wl) { push(visual, wl[wi]); wi = wi + 1; }
        li = li + 1;
    }
    let total = len(visual);
    let start = 0;
    if total > rows { start = total - rows; }
    let vr = 0;
    while start + vr < total and vr < rows {
        let ln = visual[start + vr];
        let col = _style_pane_text(state);
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = _style_accent(state); }   // '>' = user line, accent
        _dt(win, PAD, chatTop + vr * CH, str_slice(ln, 0, maxchars), col);
        vr = vr + 1;
    }
}

// ── Browser panel (stdlib/browser.sapp) ───────────────────────────────────────────
fn _push_wrapped(lines, text, width) {
    if width < 1 { width = 1; }
    let rest = text;
    while len(rest) > width {
        push(lines, str_slice(rest, 0, width));
        rest = str_slice(rest, width, len(rest));
    }
    if rest != "" { push(lines, rest); }
    return 0;
}

// word-wrap plain text into lines no wider than `width` chars.
fn _wrap(text, width) {
    if width < 1 { width = 1; }
    let words = str_split(str_replace_all(text, "
", " "), " ");
    let lines = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = words[i];
        if w != "" {
            if len(w) > width {
                if cur != "" { push(lines, cur); cur = ""; }
                _push_wrapped(lines, w, width);
            }
            else if cur == "" { cur = w; }
            else if len(cur) + len(w) + 1 > width { push(lines, cur); cur = w; }
            else { cur = cur + " " + w; }
        }
        i = i + 1;
    }
    if cur != "" { push(lines, cur); }
    return lines;
}

fn _wrap_with_prefix(prefix, text, width) {
    let lines = [];
    if width <= len(prefix) + 1 {
        push(lines, str_slice(prefix, 0, width));
        return lines;
    }
    let chunks = _wrap(text, width - len(prefix));
    if len(chunks) == 0 { push(lines, prefix); return lines; }
    let i = 0;
    while i < len(chunks) {
        let p = prefix;
        if i > 0 { p = str_repeat(" ", len(prefix)); }
        push(lines, p + chunks[i]);
        i = i + 1;
    }
    return lines;
}

fn _is_noise_line(line) {
    let t = str_lower(str_trim(line));
    if t == "" { return true; }
    if t == "menu" or t == "items" or t == "scroll to top" { return true; }
    if str_contains(t, "cookies") or str_contains(t, "privacy policy") { return true; }
    if str_contains(t, "newsletter") or str_contains(t, "facebook") or str_contains(t, "linkedin") { return true; }
    return false;
}

fn _reader_lines(text, cols) {
    let raw = _wrap(text, cols);
    let out = [];
    let seen = map{};
    let i = 0;
    while i < len(raw) and len(out) < 900 {
        let line = str_trim(raw[i]);
        if not _is_noise_line(line) {
            let key = str_lower(line);
            if map_has(seen, key) == false {
                seen[key] = true;
                push(out, line);
            }
        }
        i = i + 1;
    }
    if len(out) == 0 { return ["No readable text extracted from this page. Try Links or Forms."]; }
    return out;
}

fn _forms_lines(forms, cols) {
    let out = [];
    if forms == nil or len(forms) == 0 {
        return ["No forms found on this page."];
    }
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let head = str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        let j = 0;
        while j < len(wh) { push(out, wh[j]); j = j + 1; }
        let fields = try f.fields catch [];
        if len(fields) == 0 { push(out, "   fields: none"); }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            push(out, "   - " + str(try fld.name catch "?") + " : " + str(try fld.type catch "text"));
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _web_forms_current(state) {
    let page = try state.web.page_obj catch nil;
    if page == nil { return []; }
    return try page.forms catch [];
}

fn _web_form_clamp(state) {
    let fs = _web_forms_current(state);
    if len(fs) == 0 {
        state.web.form_sel = 0;
        state.web.form_field_sel = 0;
        state.web.form_values = map{};
        return fs;
    }
    if try state.web.form_sel catch nil == nil { state.web.form_sel = 0; }
    if state.web.form_sel < 0 { state.web.form_sel = 0; }
    if state.web.form_sel >= len(fs) { state.web.form_sel = len(fs) - 1; }
    let fields = try fs[state.web.form_sel].fields catch [];
    if try state.web.form_field_sel catch nil == nil { state.web.form_field_sel = 0; }
    if state.web.form_field_sel < 0 { state.web.form_field_sel = 0; }
    if len(fields) == 0 { state.web.form_field_sel = 0; }
    else if state.web.form_field_sel >= len(fields) { state.web.form_field_sel = len(fields) - 1; }
    return fs;
}

fn _web_form_values(state) {
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { return map{}; }
    let vals = try state.web.form_values catch nil;
    if vals == nil { vals = B.form_values(fs[state.web.form_sel]); }
    let fields = try fs[state.web.form_sel].fields catch [];
    let i = 0;
    while i < len(fields) {
        let name = str(try fields[i].name catch "");
        if name != "" and not map_has(vals, name) {
            vals[name] = str(try fields[i].value catch "");
        }
        i = i + 1;
    }
    state.web.form_values = vals;
    return vals;
}

fn _forms_lines_state(state, cols) {
    let forms = _web_forms_current(state);
    if forms == nil or len(forms) == 0 { return ["No forms found on this page."]; }
    _web_form_clamp(state);
    let vals = _web_form_values(state);
    let out = [
        "Forms mode: Tab/Shift+Tab select field, type edits value, Enter submits.",
        "Use Ctrl+N/Ctrl+P to switch forms. Submit is allowed only in Live/Trusted profiles.",
        ""
    ];
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let selected = i == state.web.form_sel;
        let mark = "  ";
        if selected { mark = "> "; }
        let head = mark + str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        let j = 0;
        while j < len(wh) { push(out, wh[j]); j = j + 1; }
        let fields = try f.fields catch [];
        if len(fields) == 0 { push(out, "     fields: none"); }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            let row = B.form_field_display(fld, vals, selected and k == state.web.form_field_sel);
            let rw = _wrap(row, cols);
            let rwi = 0;
            while rwi < len(rw) { push(out, rw[rwi]); rwi = rwi + 1; }
            k = k + 1;
        }
        if selected {
            let preview = B.form_preview_url(f, vals);
            let pw = _wrap("   submit preview: " + preview, cols);
            let pi = 0;
            while pi < len(pw) { push(out, pw[pi]); pi = pi + 1; }
        }
        push(out, "");
        i = i + 1;
    }
    return out;
}

fn _web_form_hit_row(state, row, cols) {
    let forms = _web_forms_current(state);
    if forms == nil or len(forms) == 0 { return nil; }
    _web_form_clamp(state);
    if row < 3 { return nil; }
    let line = 3;
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let selected = i == state.web.form_sel;
        let mark = "  ";
        if selected { mark = "> "; }
        let head = mark + str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        if row >= line and row < line + len(wh) { return map{ kind: "form", form: i }; }
        line = line + len(wh);
        let fields = try f.fields catch [];
        if len(fields) == 0 {
            if row == line { return map{ kind: "form", form: i }; }
            line = line + 1;
        }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            let vals = _web_form_values(state);
            let rw = _wrap(B.form_field_display(fld, vals, selected and k == state.web.form_field_sel), cols);
            if row >= line and row < line + len(rw) { return map{ kind: "field", form: i, field: k }; }
            line = line + len(rw);
            k = k + 1;
        }
        if selected {
            let preview = B.form_preview_url(f, _web_form_values(state));
            let pw = _wrap("   submit preview: " + preview, cols);
            if row >= line and row < line + len(pw) { return map{ kind: "submit", form: i }; }
            line = line + len(pw);
        }
        if row == line { return map{ kind: "form", form: i }; }
        line = line + 1;
        i = i + 1;
    }
    return nil;
}

fn _source_lines(page, cols) {
    return B.source_lines(page, cols, 700);
}

fn _inspect_lines(page, cols) {
    return B.inspector_lines(page, cols);
}

fn _page_lines(page, cols) {
    let out = B.page_layout_lines(page, cols, 900);
    if len(out) == 0 { return ["No page structure extracted. Try Reader, Links, or Forms."]; }
    return out;
}

fn _web_load_url(state, url, push_history) {
    let resolved = B.browser_input_url(url, try state.web.search_engine catch "duckduckgo");
    if not (try resolved.ok catch false) { state.web.status = str(try resolved.reason catch "empty input"); return 0; }
    url = str(try resolved.url catch str_trim(url));
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    state.web.input = url;
    state.web.scroll = 0;
    state.web.title = "loading " + url + " ...";
    state.web.status = str(try sec.label catch "Safe");
    if str(try resolved.kind catch "url") == "search" {
        state.web.status = "search " + str(try resolved.label catch "Search");
    }
    state.web.lines = [];
    let page = try B.fetch_page_mode(url, try sec.mode catch "safe") catch nil;
    if page == nil or not page.ok {
        state.web.title = "load failed";
        let why = "could not load (needs network + http; try a reachable http/https URL)";
        if page != nil { why = try page.error catch why; }
        state.web.lines = [why];
        return 0;
    }
    let current = try state.web.url catch "";
    if push_history and current != "" and current != page.url {
        push(state.web.history, current);
        if len(state.web.history) > 50 { state.web.history = slice(state.web.history, len(state.web.history) - 50, len(state.web.history)); }
        state.web.forward = [];
    }
    state.web.url = page.url;
    state.web.title = page.title;
    state.web.status = "loaded " + str(try sec.label catch "Safe");
    if str(try resolved.kind catch "url") == "search" {
        state.web.status = "loaded search " + str(try resolved.label catch "Search");
    }
    state.web.page_obj = page;
    let cols = 116;
    let pagelines = _page_lines(page, cols);
    let reader = _reader_lines(page.text, cols);
    let links = [];
    let i = 0;
    while i < len(page.links) and i < 40 {
        let wl = _wrap_with_prefix("> ", page.links[i], cols);
        let j = 0;
        while j < len(wl) { push(links, wl[j]); j = j + 1; }
        i = i + 1;
    }
    state.web.page = pagelines;
    state.web.reader = reader;
    state.web.links = links;
    state.web.forms = _forms_lines(try page.forms catch [], cols);
    state.web.form_sel = 0;
    state.web.form_field_sel = 0;
    let fs0 = try page.forms catch [];
    if len(fs0) > 0 { state.web.form_values = B.form_values(fs0[0]); }
    else { state.web.form_values = map{}; }
    state.web.source = _source_lines(page, cols);
    state.web.inspect = _inspect_lines(page, cols);
    state.web.lines = pagelines;
    return 0;
}

fn _web_apply_page(state, page, status) {
    let cols = 116;
    state.web.url = page.url;
    state.web.title = page.title;
    state.web.status = status;
    state.web.page_obj = page;
    state.web.page = _page_lines(page, cols);
    state.web.reader = _reader_lines(page.text, cols);
    let links = [];
    let i = 0;
    while i < len(page.links) and i < 40 {
        let wl = _wrap_with_prefix("> ", page.links[i], cols);
        let j = 0;
        while j < len(wl) { push(links, wl[j]); j = j + 1; }
        i = i + 1;
    }
    state.web.links = links;
    state.web.forms = _forms_lines(try page.forms catch [], cols);
    state.web.form_sel = 0;
    state.web.form_field_sel = 0;
    let fs0 = try page.forms catch [];
    if len(fs0) > 0 { state.web.form_values = B.form_values(fs0[0]); }
    else { state.web.form_values = map{}; }
    state.web.source = _source_lines(page, cols);
    state.web.inspect = _inspect_lines(page, cols);
    state.web.lines = state.web.page;
    state.web.scroll = 0;
    return 0;
}

fn _web_form_submit(state) {
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { state.web.status = "no form"; return 0; }
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    let f = fs[state.web.form_sel];
    let vals = _web_form_values(state);
    let r = try B.form_submit_mode(f, vals, try sec.mode catch "safe") catch nil;
    if r == nil {
        state.web.status = "form submit failed";
        state.output = "browser form submit failed";
        return 0;
    }
    if not (try r.ok catch false) {
        state.web.status = "form blocked";
        state.output = str(try r.error catch "form submit blocked");
        return 0;
    }
    _web_apply_page(state, r, "form submitted");
    state.web.mode = "live";
    state.output = "browser form submitted";
    return 0;
}

fn _web_select_form(state, idx) {
    let fs = _web_forms_current(state);
    if len(fs) == 0 { return 0; }
    if idx < 0 { idx = 0; }
    if idx >= len(fs) { idx = len(fs) - 1; }
    if idx != (try state.web.form_sel catch 0) {
        state.web.form_sel = idx;
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[idx]);
    } else {
        state.web.form_sel = idx;
    }
    return 0;
}

fn _web_forms_click(state, mx, my) {
    if (try state.web.mode catch "") != "forms" { return false; }
    let sz = state.winsz;
    if sz == nil { return false; }
    let barh = _web_bar_h();
    let bodyTop = TOP + barh + 2 * PAD;
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    if (try state.web.title catch "") != "" { bodyTop = bodyTop + CH + 3 * PAD; }
    if my < bodyTop or mx < colX - PAD or mx > colX + colW + PAD { return false; }
    let row = num_floor((my - bodyTop) / CH) + (try state.web.scroll catch 0);
    let hit = _web_form_hit_row(state, row, colW / CW);
    if hit == nil { return false; }
    _web_select_form(state, try hit.form catch 0);
    if (try hit.kind catch "") == "submit" {
        _web_form_submit(state);
        return true;
    }
    if (try hit.kind catch "") == "field" {
        state.web.form_field_sel = try hit.field catch 0;
        _web_form_clamp(state);
        let fs = _web_forms_current(state);
        let fields = try fs[state.web.form_sel].fields catch [];
        if len(fields) > 0 {
            let fld = fields[state.web.form_field_sel];
            let typ = str_lower(str(try fld.type catch "text"));
            if typ == "checkbox" or typ == "radio" or typ == "select" {
                let vals = _web_form_values(state);
                state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, str(try fld.name catch ""), 1);
                state.web.status = "form value changed";
            } else {
                state.web.status = "field selected";
            }
        }
        return true;
    }
    state.web.status = "form selected";
    return true;
}

fn _web_live_click(state, mx, my) {
    let mode = try state.web.mode catch "live";
    if not (mode == "live" or mode == "page") { return false; }
    let page = try state.web.page_obj catch nil;
    if page == nil { return false; }
    let sz = state.winsz;
    if sz == nil { return false; }
    let barh = _web_bar_h();
    let bodyTop = TOP + barh + 2 * PAD;
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    if (try state.web.title catch "") != "" { bodyTop = bodyTop + CH + 3 * PAD; }
    if my < bodyTop or mx < colX - PAD or mx > colX + colW + PAD { return false; }
    let col = num_floor((mx - colX) / CW);
    let row = num_floor((my - bodyTop) / CH) + (try state.web.scroll catch 0);
    let layout = B.page_layout(page, colW / CW);
    let hit = B.page_layout_hit(layout, col, row);
    if hit == nil { return false; }
    let kind = str(try hit.kind catch "");
    if kind == "link" {
        let href = str(try hit.href catch try hit.action catch try hit.text catch "");
        if href == "" { return false; }
        state.output = "browser live click link: " + href;
        _web_load_url(state, href, true);
        return true;
    }
    if kind == "form" {
        _web_select_form(state, try hit.form_index catch 0);
        state.web.mode = "forms";
        state.web.scroll = 0;
        state.web.status = "form selected";
        state.output = "browser live click form: switched to Forms mode";
        return true;
    }
    if kind == "img" {
        let src = str(try hit.src catch "");
        state.web.status = "image selected";
        state.output = "browser image: " + src;
        return true;
    }
    state.web.status = "selected " + kind;
    state.output = "browser live selected " + kind + ": " + str_slice(str(try hit.text catch ""), 0, 120);
    return true;
}

fn _web_form_key(state, key, shift) {
    if (try state.web.mode catch "") != "forms" { return false; }
    let fs = _web_form_clamp(state);
    if len(fs) == 0 { return false; }
    let fields = try fs[state.web.form_sel].fields catch [];
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") {
        state.web.form_sel = state.web.form_sel + 1;
        if state.web.form_sel >= len(fs) { state.web.form_sel = 0; }
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[state.web.form_sel]);
        return true;
    }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") {
        state.web.form_sel = state.web.form_sel - 1;
        if state.web.form_sel < 0 { state.web.form_sel = len(fs) - 1; }
        state.web.form_field_sel = 0;
        state.web.form_values = B.form_values(fs[state.web.form_sel]);
        return true;
    }
    if key == "Tab" {
        if len(fields) > 0 {
            if shift { state.web.form_field_sel = state.web.form_field_sel - 1; }
            else { state.web.form_field_sel = state.web.form_field_sel + 1; }
            while state.web.form_field_sel < 0 { state.web.form_field_sel = state.web.form_field_sel + len(fields); }
            while state.web.form_field_sel >= len(fields) { state.web.form_field_sel = state.web.form_field_sel - len(fields); }
        }
        return true;
    }
    if _is_enter(key) { _web_form_submit(state); return true; }
    if len(fields) == 0 { return false; }
    let fld = fields[state.web.form_field_sel];
    let name = str(try fld.name catch "");
    if name == "" { return false; }
    let vals = _web_form_values(state);
    let typ = str_lower(str(try fld.type catch "text"));
    if key == "Space" or key == "Left" or key == "Right" {
        let dir = 1;
        if key == "Left" { dir = 0 - 1; }
        if typ == "checkbox" or typ == "radio" or typ == "select" {
            state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, name, dir);
            return true;
        }
    }
    let cur = str(try vals[name] catch "");
    if key == "Backspace" {
        if len(cur) > 0 { vals = B.form_update_value(vals, name, str_slice(cur, 0, len(cur) - 1)); }
        state.web.form_values = vals;
        return true;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        if typ == "checkbox" or typ == "radio" or typ == "select" {
            if ch == " " {
                state.web.form_values = B.form_cycle_value(fs[state.web.form_sel], vals, name, 1);
            }
            return true;
        }
        state.web.form_values = B.form_update_value(vals, name, cur + ch);
        return true;
    }
    return false;
}

fn _web_load(state) {
    return _web_load_url(state, state.web.input, true);
}

fn _web_back(state) {
    let hist = try state.web.history catch [];
    if len(hist) == 0 { state.web.status = "no back history"; return 0; }
    let url = hist[len(hist) - 1];
    state.web.history = slice(hist, 0, len(hist) - 1);
    let current = str(try state.web.url catch "");
    if current != "" {
        let fw0 = try state.web.forward catch nil;
        if fw0 == nil { state.web.forward = []; }
        push(state.web.forward, current);
        if len(state.web.forward) > 50 { state.web.forward = slice(state.web.forward, len(state.web.forward) - 50, len(state.web.forward)); }
    }
    _web_load_url(state, url, false);
    state.web.status = "back";
    return 0;
}

fn _web_forward(state) {
    let fwd = try state.web.forward catch [];
    if len(fwd) == 0 { state.web.status = "no forward history"; return 0; }
    let url = fwd[len(fwd) - 1];
    state.web.forward = slice(fwd, 0, len(fwd) - 1);
    let current = str(try state.web.url catch "");
    if current != "" {
        push(state.web.history, current);
        if len(state.web.history) > 50 { state.web.history = slice(state.web.history, len(state.web.history) - 50, len(state.web.history)); }
    }
    _web_load_url(state, url, false);
    state.web.status = "forward";
    return 0;
}

fn _web_home(state) {
    let home = str(try state.web.home catch "example.com");
    if str_trim(home) == "" { home = "example.com"; }
    state.web.input = home;
    _web_load_url(state, home, true);
    state.web.status = "home";
    return 0;
}

fn _web_current_page_for_bookmark(state) {
    let page = try state.web.page_obj catch nil;
    if page != nil and str(try page.url catch "") != "" { return page; }
    let u = str(try state.web.url catch try state.web.input catch "");
    if str_trim(u) == "" { return nil; }
    return map{ title: str(try state.web.title catch u), url: u };
}

fn _web_bookmark_current(state) {
    let page = _web_current_page_for_bookmark(state);
    if page == nil {
        state.web.status = "nothing to bookmark";
        state.output = state.web.status;
        return 0;
    }
    state.web.bookmarks = B.bookmark_push(try state.web.bookmarks catch [], page, 80);
    state.web.status = "bookmarked";
    state.output = "browser bookmark: " + str(try page.url catch "");
    return 0;
}

fn _web_bookmark_remove_newest(state) {
    let old = try state.web.bookmarks catch [];
    if len(old) == 0 {
        state.web.status = "no bookmarks";
        state.output = "browser bookmarks empty";
        return 0;
    }
    let removed = old[0];
    state.web.bookmarks = B.bookmark_remove(old, 0);
    state.web.mode = "bookmarks";
    state.web.status = "bookmark removed";
    state.output = "removed bookmark: " + str(try removed.url catch "");
    return 0;
}

fn _web_show_bookmarks(state) {
    state.web.mode = "bookmarks";
    state.web.scroll = 0;
    state.web.status = "bookmarks";
    state.output = "browser view: Bookmarks";
    return 0;
}

fn _web_search_next(state) {
    state.web.search_engine = B.next_search_engine(try state.web.search_engine catch "duckduckgo");
    let prof = B.search_engine_profile(state.web.search_engine);
    state.web.status = "search " + str(try prof.label catch state.web.search_engine);
    state.output = "browser search engine: " + str(try prof.label catch state.web.search_engine);
    return 0;
}

fn _web_download_plan(state) {
    let url = str(try state.web.url catch "");
    if str_trim(url) == "" { url = str(try state.web.input catch ""); }
    let mode = str(try state.web.security catch "safe");
    if try state.web.tor catch false { mode = "tor"; }
    let plan = B.download_plan(url, mode);
    state.web.status = "download blocked";
    if try plan.ok catch false {
        state.web.status = "download planned";
        let next = [plan];
        let old = try state.web.download_plans catch [];
        let i = 0;
        while old != nil and i < len(old) and len(next) < 40 {
            array_push(next, old[i]);
            i = i + 1;
        }
        state.web.download_plans = next;
    }
    state.output = str(try plan.summary catch state.web.status);
    return 0;
}

fn _web_stats(state) {
    state.web.mode = "stats";
    state.web.scroll = 0;
    state.web.status = "page stats";
    let page = try state.web.page_obj catch nil;
    if page == nil {
        state.output = "browser stats: no page loaded";
    } else {
        state.output = str_join(B.page_stats_lines(page), "\n");
    }
    return 0;
}

fn _web_find_open(state) {
    state.web.mode = "find";
    state.web.scroll = 0;
    state.web.status = "find in page";
    state.output = "browser find: type query, Backspace edits, Esc returns to Live";
    return 0;
}

fn _render_lines_from_result(r, path) {
    if r == nil { return ["Render failed: no renderer result."]; }
    if not r.ok {
        return [
            "Render failed: " + str(try r.error catch "unknown error"),
            "This mode needs --allow-exec and chromium/google-chrome/brave/firefox on PATH.",
            "The safe Page/Reader browser modes still work without a host DOM engine.",
        ];
    }
    return [
        "Rendered by host browser snapshot (" + str(try r.cmd catch "renderer") + ").",
        "PNG: " + path,
        "Security: URL policy checked first; Page/Reader remains the no-JS default.",
    ];
}

fn _web_render(state) {
    let resolved = B.browser_input_url(state.web.input, try state.web.search_engine catch "duckduckgo");
    if not (try resolved.ok catch false) { state.web.status = str(try resolved.reason catch "empty input"); return 0; }
    let url = str(try resolved.url catch state.web.input);
    state.web.input = url;
    let sec = B.security_profile(try state.web.security catch "safe");
    if try state.web.tor catch false { sec = B.security_profile("tor"); }
    if not (try sec.host_render catch false) {
        state.web.mode = "render";
        state.web.scroll = 0;
        state.web.status = "blocked by " + str(try sec.label catch "Safe");
        state.web.title = "Host render blocked by browser security mode";
        state.web.render_img = nil;
        state.web.render_lines = [
            "Host rendering uses an external browser process.",
            "Switch Browser security to JS/DOM or Trusted before Host render.",
            "Live/Reader/Source/Inspect stay pblang-native and no-JS."
        ];
        return 0;
    }
    state.web.mode = "render";
    state.web.scroll = 0;
    state.web.status = "rendering";
    state.web.title = "rendering " + url + " ...";
    state.web.render_img = nil;
    let path = "/tmp/pbide_browser_" + str(now_ms()) + ".png";
    state.web.render_path = path;
    let r = try BR.render_snapshot(url, path, 1280, 800) catch nil;
    state.web.render_lines = _render_lines_from_result(r, path);
    if r != nil and r.ok {
        let img = try IMG.to_thumbnail(path, 420, 260) catch nil;
        state.web.render_img = img;
        state.web.status = "rendered";
        state.web.title = "host render: " + url;
        if img == nil {
            state.web.render_lines = [
                "Rendered PNG: " + path,
                "Thumbnail unavailable: install ImageMagick convert or open the PNG directly.",
            ];
        }
    } else {
        state.web.status = "render failed";
        state.web.title = "host render unavailable";
    }
    return 0;
}

fn _web_key(state, key, shift) {
    let w = state.web;
    if _web_form_key(state, key, shift) { return 0; }
    if (try w.mode catch "") == "find" {
        if key == "Escape" { w.mode = "live"; w.status = "find closed"; return 0; }
        if key == "Backspace" {
            if len(try w.find_query catch "") > 0 { w.find_query = str_slice(w.find_query, 0, len(w.find_query) - 1); }
            w.status = "find " + str(try w.find_query catch "");
            return 0;
        }
        if _is_enter(key) { w.status = "find " + str(try w.find_query catch ""); return 0; }
        let fch = K.key_to_char(key, shift);
        if fch != "" {
            w.find_query = str(try w.find_query catch "") + fch;
            w.status = "find " + str(try w.find_query catch "");
            return 0;
        }
        return 0;
    }
    if _is_enter(key) { _web_load(state); return 0; }
    if key == "F12" { w.security = B.next_security_mode(try w.security catch "safe"); w.status = "security " + str(try B.security_profile(w.security).label catch w.security); return 0; }
    if (try state.ctrl catch false) and (key == "F" or key == "KeyF") { _web_find_open(state); return 0; }
    if (try state.ctrl catch false) and (key == "K" or key == "KeyK") { _web_search_next(state); return 0; }
    if (try state.ctrl catch false) and (key == "D" or key == "KeyD") { _web_bookmark_current(state); return 0; }
    if (try state.ctrl catch false) and (key == "J" or key == "KeyJ") { _web_download_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "Right" or key == "PageRight") { _web_forward(state); return 0; }
    if (try state.ctrl catch false) and (key == "Left" or key == "PageLeft") { _web_back(state); return 0; }
    if (try state.ctrl catch false) and (key == "Home") { _web_home(state); return 0; }
    if (try state.ctrl catch false) and (key == "I" or key == "KeyI") { _web_stats(state); return 0; }
    if key == "Down" { w.scroll = w.scroll + 3; return 0; }
    if key == "PageDown" { w.scroll = w.scroll + 12; return 0; }
    if key == "Up" { w.scroll = w.scroll - 3; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "PageUp" { w.scroll = w.scroll - 12; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "Backspace" { if len(w.input) > 0 { w.input = str_slice(w.input, 0, len(w.input) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w.input = w.input + ch; }
    return 0;
}
fn _web_button_row_h() {
    return IDE.browser_bar_metrics(CH, PAD).button_h;
}
fn _web_bar_h() {
    return IDE.browser_bar_metrics(CH, PAD).total_h;
}
fn _web_button_fg(state, active) {
    if active { return gfx.rgb(245, 248, 255); }
    return _style_text(state);
}
fn _web_click(state, mx, my) {
    let zone = IDE.browser_bar_zone(my, TOP, CH, PAD);
    if zone == "above" { return 0; }
    if zone == "body" {
        if not _web_live_click(state, mx, my) { _web_forms_click(state, mx, my); }
        return 0;
    }
    if zone == "summary" { return 0; }
    if mx >= PAD and mx < PAD + 6 * CW { _web_back(state); return 0; }
    if mx >= PAD + 7 * CW and mx < PAD + 15 * CW { _web_load(state); return 0; }
    let modeX = PAD + 16 * CW;
    if mx >= modeX and mx < modeX + 6 * CW { state.web.mode = "live"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 6 * CW and mx < modeX + 14 * CW { state.web.mode = "reader"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 14 * CW and mx < modeX + 21 * CW { state.web.mode = "links"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 21 * CW and mx < modeX + 28 * CW { state.web.mode = "forms"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 28 * CW and mx < modeX + 36 * CW { state.web.mode = "source"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 36 * CW and mx < modeX + 45 * CW { state.web.mode = "inspect"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 45 * CW and mx < modeX + 51 * CW { _web_render(state); return 0; }
    if mx >= modeX + 52 * CW and mx < modeX + 66 * CW {
        state.web.security = B.next_security_mode(try state.web.security catch "safe");
        let sec = B.security_profile(state.web.security);
        state.web.status = "security " + str(try sec.label catch state.web.security);
        return 0;
    }
    if mx >= modeX + 67 * CW and mx < modeX + 76 * CW {
        state.web.tor = not (try state.web.tor catch false);
        if state.web.tor { state.web.status = "Tor enabled"; }
        else { state.web.status = "Tor disabled"; }
        return 0;
    }
    return 0;
}

fn _draw_pixel_image(win, img, x, y, maxw, maxh) {
    if img == nil { return 0; }
    let yy = 0;
    while yy < len(img) and yy < maxh {
        let row = img[yy];
        let xx = 0;
        while xx < len(row) and xx < maxw {
            win.rect(x + xx, y + yy, 1, 1, row[xx]);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return yy;
}

fn _draw_live_block(state, win, x, y, w, kind, text, extra) {
    let bg = _style_surface2(state);
    let fg = _style_pane_text(state);
    let accent = _style_accent(state);
    if kind == "title" { bg = gfx.rgb(35, 47, 78); fg = gfx.rgb(245, 248, 255); }
    else if kind == "h1" { bg = gfx.rgb(30, 58, 90); fg = gfx.rgb(245, 248, 255); }
    else if kind == "h2" { bg = gfx.rgb(28, 50, 74); fg = gfx.rgb(220, 235, 255); }
    else if kind == "img" { bg = gfx.rgb(42, 32, 66); fg = gfx.rgb(230, 210, 255); }
    else if kind == "form" { bg = gfx.rgb(32, 60, 54); fg = gfx.rgb(218, 248, 238); }
    else if kind == "link" { bg = gfx.rgb(28, 54, 84); fg = gfx.rgb(186, 224, 255); }
    if _theme_is_light(state) {
        if kind == "title" { bg = gfx.rgb(220, 232, 250); fg = gfx.rgb(20, 40, 72); }
        else if kind == "h1" { bg = gfx.rgb(228, 238, 252); fg = gfx.rgb(20, 55, 95); }
        else if kind == "h2" { bg = gfx.rgb(235, 243, 252); fg = gfx.rgb(36, 66, 100); }
        else if kind == "img" { bg = gfx.rgb(239, 232, 250); fg = gfx.rgb(74, 50, 112); }
        else if kind == "form" { bg = gfx.rgb(224, 245, 237); fg = gfx.rgb(28, 94, 72); }
        else if kind == "link" { bg = gfx.rgb(224, 238, 252); fg = gfx.rgb(24, 78, 130); }
    }
    let maxchars = (w - 4 * PAD) / CW;
    let prefix = "";
    if kind == "img" { prefix = "[image] "; }
    if kind == "form" { prefix = "[form] "; }
    if kind == "link" { prefix = "[link] "; }
    let lines = _wrap_with_prefix(prefix, text, maxchars);
    let h = (len(lines) + 2) * CH;
    if h < 4 * CH { h = 4 * CH; }
    win.rect(x, y, w, h, bg);
    win.rect(x, y, SCALE * 2, h, accent);
    let label = str_upper(kind);
    _dt(win, x + 2 * PAD, y + PAD / 2, label, _style_muted(state));
    let i = 0;
    while i < len(lines) and i < 12 {
        _dt(win, x + 2 * PAD, y + CH + PAD + i * CH, str_slice(lines[i], 0, maxchars), fg);
        i = i + 1;
    }
    if extra != "" {
        _dt(win, x + 2 * PAD, y + h - CH - PAD / 2, str_slice(extra, 0, maxchars), _style_muted(state));
    }
    return h;
}

fn _draw_web_live(state, win, sz, colX, bodyTop, colW) {
    let page = try state.web.page_obj catch nil;
    if page == nil {
        _dt(win, colX, bodyTop, "Load a page to use pblang Live renderer.", _style_pane_text(state));
        return 0;
    }
    let layout = B.page_layout(page, colW / CW);
    let blocks = try layout.boxes catch [];
    let i = 0;
    while i < len(blocks) and i < 120 {
        let b = blocks[i];
        let kind = str(try b.kind catch "p");
        let txt = str(try b.text catch "");
        let extra = "";
        if kind == "img" { extra = str(try b.src catch ""); }
        if kind == "form" { extra = str(try b.action catch ""); }
        let bx = colX + (try b.x catch 0) * CW;
        let bw = (try b.w catch (colW / CW)) * CW;
        if bw > colW { bw = colW; }
        let by = bodyTop + (try b.y catch 0) * CH - state.web.scroll * CH;
        _draw_live_block(state, win, bx, by, bw, kind, txt, extra);
        i = i + 1;
    }
    if len(blocks) == 0 {
        _dt(win, colX, bodyTop, "No native page blocks extracted. Try Reader or Source.", _style_pane_text(state));
    }
    return 0;
}

fn _draw_web(state, win, sz) {
    let w = state.web;
    let maxchars = (sz.w - 2 * PAD) / CW;
    // web IDE browser bar
    let barh = _web_bar_h();
    win.rect(0, TOP, sz.w, barh, _style_surface(state));
    win.rect(0, TOP + barh, sz.w, SCALE, _style_border(state));
    let bx = PAD;
    win.rect(bx, TOP + PAD, 6 * CW, CH + PAD, _style_surface2(state));
    _dt(win, bx + CW, TOP + PAD + PAD / 2, "Back", _style_text(state));
    win.rect(bx + 7 * CW, TOP + PAD, 8 * CW, CH + PAD, _style_surface2(state));
    _dt(win, bx + 8 * CW, TOP + PAD + PAD / 2, "Reload", _style_text(state));
    let modeX = bx + 16 * CW;
    let m0 = "Live";
    let m1 = "Reader";
    let m2 = "Links";
    let m3 = "Forms";
    let m4 = "Source";
    let m5 = "Inspect";
    let m6 = "Host";
    let mbg = _style_surface2(state);
    let abg = _style_accent(state);
    let a0 = w.mode == "live" or w.mode == "page";
    let a1 = w.mode == "reader";
    let a2 = w.mode == "links";
    let a3 = w.mode == "forms";
    let a4 = w.mode == "source";
    let a5 = w.mode == "inspect";
    let a6 = w.mode == "render";
    let bg0 = mbg; if a0 { bg0 = abg; }
    let bg1 = mbg; if a1 { bg1 = abg; }
    let bg2 = mbg; if a2 { bg2 = abg; }
    let bg3 = mbg; if a3 { bg3 = abg; }
    let bg4 = mbg; if a4 { bg4 = abg; }
    let bg5 = mbg; if a5 { bg5 = abg; }
    let bg6 = mbg; if a6 { bg6 = abg; }
    win.rect(modeX, TOP + PAD, 6 * CW, CH + PAD, bg0); _dt(win, modeX + CW, TOP + PAD + PAD / 2, m0, _web_button_fg(state, a0));
    win.rect(modeX + 6 * CW, TOP + PAD, 8 * CW, CH + PAD, bg1); _dt(win, modeX + 7 * CW, TOP + PAD + PAD / 2, m1, _web_button_fg(state, a1));
    win.rect(modeX + 14 * CW, TOP + PAD, 7 * CW, CH + PAD, bg2); _dt(win, modeX + 15 * CW, TOP + PAD + PAD / 2, m2, _web_button_fg(state, a2));
    win.rect(modeX + 21 * CW, TOP + PAD, 7 * CW, CH + PAD, bg3); _dt(win, modeX + 22 * CW, TOP + PAD + PAD / 2, m3, _web_button_fg(state, a3));
    win.rect(modeX + 28 * CW, TOP + PAD, 8 * CW, CH + PAD, bg4); _dt(win, modeX + 29 * CW, TOP + PAD + PAD / 2, m4, _web_button_fg(state, a4));
    win.rect(modeX + 36 * CW, TOP + PAD, 9 * CW, CH + PAD, bg5); _dt(win, modeX + 37 * CW, TOP + PAD + PAD / 2, m5, _web_button_fg(state, a5));
    win.rect(modeX + 45 * CW, TOP + PAD, 6 * CW, CH + PAD, bg6); _dt(win, modeX + 46 * CW, TOP + PAD + PAD / 2, m6, _web_button_fg(state, a6));
    let sec = B.security_profile(try w.security catch "safe");
    let secLabel = "Sec:" + str(try sec.label catch "Safe");
    let secBg = _style_surface2(state);
    let secMode = try sec.mode catch "safe";
    if secMode == "live" {
        secBg = gfx.rgb(30, 80, 72);
        if _theme_is_light(state) { secBg = gfx.rgb(214, 241, 232); }
    }
    if secMode == "jsdom" {
        secBg = gfx.rgb(44, 74, 104);
        if _theme_is_light(state) { secBg = gfx.rgb(218, 235, 250); }
    }
    if secMode == "trusted" {
        secBg = gfx.rgb(90, 64, 34);
        if _theme_is_light(state) { secBg = gfx.rgb(250, 232, 204); }
    }
    if secMode == "tor" {
        secBg = gfx.rgb(58, 47, 91);
        if _theme_is_light(state) { secBg = gfx.rgb(232, 224, 247); }
    }
    let secActive = (try sec.mode catch "safe") != "safe";
    win.rect(modeX + 52 * CW, TOP + PAD, 14 * CW, CH + PAD, secBg);
    _dt(win, modeX + 53 * CW, TOP + PAD + PAD / 2, str_slice(secLabel, 0, 12), _web_button_fg(state, secActive));
    let torBg = _style_surface2(state);
    let torText = "Tor:off";
    if try w.tor catch false { torBg = gfx.rgb(58, 47, 91); torText = "Tor:on"; }
    win.rect(modeX + 67 * CW, TOP + PAD, 9 * CW, CH + PAD, torBg);
    _dt(win, modeX + 68 * CW, TOP + PAD + PAD / 2, torText, _web_button_fg(state, try w.tor catch false));
    let urlX = modeX + 77 * CW;
    let urlW = sz.w - urlX - 14 * CW;
    if urlW > 10 * CW {
        win.rect(urlX, TOP + PAD, urlW, CH + PAD, _style_surface2(state));
        win.rect(urlX, TOP + PAD, urlW, SCALE, _style_border(state));
    }
    let searchProf = B.search_engine_profile(try w.search_engine catch "duckduckgo");
    let addr = "URL › [" + str(try searchProf.label catch "Search") + "] " + w.input;
    let urlChars = urlW / CW - 2;
    if urlChars > 4 { _dt(win, urlX + CW, TOP + PAD + PAD / 2, str_slice(addr, 0, urlChars), _style_text(state)); }
    let cursorCol = len(addr);
    let cur = cursorCol; if cur > urlChars { cur = urlChars; }
    if urlChars > 4 { win.rect(urlX + CW + cur * CW, TOP + PAD + PAD / 2, SCALE, CH - SCALE, CURSOR); }
    _dt(win, sz.w - 12 * CW, TOP + PAD + PAD / 2, try w.status catch "ready", _style_muted(state));
    let summaryMode = try w.security catch "safe";
    if try w.tor catch false { summaryMode = "tor"; }
    let secSummary = B.security_summary(summaryMode);
    let nativeSummary = B.native_interaction_summary(summaryMode);
    let sumY = TOP + CH + 2 * PAD;
    let sumH = 2 * (CH + PAD);
    win.rect(PAD, sumY, sz.w - 2 * PAD, sumH, _style_panel(state));
    win.rect(PAD, sumY, SCALE * 2, sumH, secBg);
    _dt(win, PAD + CW, sumY + PAD / 2, str_slice(secSummary, 0, maxchars - 2), _style_muted(state));
    _dt(win, PAD + CW, sumY + CH + PAD, str_slice(nativeSummary, 0, maxchars - 2), _style_info(state));

    let bodyTop = TOP + barh + 2 * PAD;
    win.rect(0, bodyTop - PAD, sz.w, sz.h - bodyTop + PAD, _style_bg(state));
    let colW = sz.w - 8 * PAD;
    if colW > 132 * CW { colW = 132 * CW; }
    if colW < 48 * CW { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    win.rect(colX - PAD, bodyTop, colW + 2 * PAD, sz.h - bodyTop - PAD, _style_panel(state));
    if w.title != "" { _dt(win, colX, bodyTop + PAD, str_slice(w.title, 0, colW / CW), _style_accent(state)); bodyTop = bodyTop + CH + 3 * PAD; }
    if w.mode == "live" or w.mode == "page" {
        _draw_web_live(state, win, sz, colX, bodyTop, colW);
        return 0;
    }
    let source = try w.page catch w.reader;
    if w.mode == "reader" { source = w.reader; }
    if w.mode == "links" { source = w.links; }
    if w.mode == "forms" { source = _forms_lines_state(state, colW / CW); }
    if w.mode == "bookmarks" { source = B.bookmark_lines(try w.bookmarks catch [], 80); }
    if w.mode == "stats" { source = B.page_stats_lines(try w.page_obj catch map{ title: "", url: "", text: "", links: [], images: [], forms: [] }); }
    if w.mode == "find" { source = B.page_find_lines(try w.page_obj catch map{ text: "" }, try w.find_query catch "", 80); }
    if w.mode == "source" { source = try w.source catch ["No source loaded."]; }
    if w.mode == "inspect" { source = try w.inspect catch ["No inspector details loaded."]; }
    if w.mode == "render" {
        let img = try w.render_img catch nil;
        if img != nil {
            let used = _draw_pixel_image(win, img, colX, bodyTop, colW, 320);
            bodyTop = bodyTop + used + 2 * PAD;
        }
        source = try w.render_lines catch ["Render mode needs --allow-exec and a Chromium-compatible browser."];
    }
    if source == nil { source = w.lines; }
    let rows = (sz.h - bodyTop - PAD) / CH;
    if w.scroll > len(source) - 1 { if len(source) > 0 { w.scroll = len(source) - 1; } else { w.scroll = 0; } }
    let vr = 0;
    while w.scroll + vr < len(source) and vr < rows {
        let ln = source[w.scroll + vr];
        let col = _style_pane_text(state);
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = _style_accent(state); }     // '>' link line
        if str_starts_with(ln, "#") { col = _style_accent(state); }
        if str_starts_with(ln, "[image]") {
            col = gfx.rgb(210, 168, 255);
            if _theme_is_light(state) { col = gfx.rgb(108, 72, 150); }
        }
        _dt(win, colX, bodyTop + vr * CH, str_slice(ln, 0, colW / CW), col);
        vr = vr + 1;
    }
}

// ── History panel: web-IDE-style run/check snapshots with click-to-restore ─────────
fn _history_storage_dir() {
    let home = try env_get("HOME") catch "";
    if home == nil or str(home) == "" { return ".pblang"; }
    return str(home) + "/.pblang";
}

fn _history_storage_path() {
    return _history_storage_dir() + "/pbide-history.json";
}

fn _history_load_persistent() {
    let raw = try fs_read(_history_storage_path()) catch "";
    if raw == nil or str_trim(str(raw)) == "" { return []; }
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil { return []; }
    if type(parsed) != "array" { return []; }
    return parsed;
}

fn _history_save_persistent(state) {
    state.history_mode = "permanent";
    let dir = _history_storage_dir();
    try fs_mkdirs(dir) catch nil;
    let path = _history_storage_path();
    let payload = json_stringify(try state.history catch []);
    let ok = try fs_write(path, payload) catch false;
    if ok == nil { ok = false; }
    if ok {
        state.history = IDE.history_mark_stored(try state.history catch [], true);
        state.history_stored = true;
        state.output = "history saved: " + path;
    } else {
        state.history_stored = false;
        state.output = "history save FAILED: " + path;
    }
    return state.output;
}

fn _history_toggle_store(state) {
    state.history_mode = IDE.history_mode_next(try state.history_mode catch "temporary");
    if state.history_mode == "permanent" {
        _history_save_persistent(state);
    } else {
        state.history_stored = false;
        state.output = "history mode: Temporary (memory only)";
    }
    return state.output;
}

fn _history_storage_summary(state) {
    return IDE.history_storage_summary(try state.history catch [], try state.history_mode catch "temporary", try state.history_stored catch false, _history_storage_path());
}

fn _history_clear(state) {
    state.history = [];
    state.history_query = "";
    state.history_sel = 0;
    state.output = "history cleared";
    if str(try state.history_mode catch "temporary") == "permanent" {
        _history_save_persistent(state);
        state.output = "history cleared and saved";
    }
    return 0;
}

fn _history_delete_selected(state) {
    let hits = _history_clamp(state);
    if len(hits) == 0 {
        state.output = "history delete: no selected snapshot";
        return 0;
    }
    let sel = try state.history_sel catch 0;
    let result = IDE.history_delete_selected(try state.history catch [], hits, sel);
    if not (try result.ok catch false) {
        state.output = "history delete: no selected snapshot";
        return 0;
    }
    let removed = try result.removed catch map{};
    state.history = try result.history catch [];
    state.history_sel = IDE.selection_move(sel, len(_history_hits(state)), "down", 10);
    state.history_stored = false;
    let msg = "history deleted #" + str((try result.removed_index catch 0) + 1) + " " + str_upper(str(try removed.action catch "?"));
    state.output = msg;
    if str(try state.history_mode catch "temporary") == "permanent" {
        _history_save_persistent(state);
        state.output = msg + " and saved";
    }
    return 0;
}

fn _history_hits(state) {
    return IDE.filter_history(try state.history catch [], try state.history_query catch "", 200);
}

fn _history_clamp(state) {
    let hits = _history_hits(state);
    if (try state.history_sel catch 0) < 0 { state.history_sel = 0; }
    if len(hits) == 0 { state.history_sel = 0; return hits; }
    if (try state.history_sel catch 0) >= len(hits) { state.history_sel = len(hits) - 1; }
    return hits;
}

fn _history_restore(state, hit) {
    _replace_editor(state, try hit.code catch E.text(state.ed));
    state.panel = "code";
    state.output = "loaded history snapshot #" + str((try hit.index catch 0) + 1) + " (" + str(try hit.action catch "?") + ")";
    return 0;
}

fn _history_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if (try state.ctrl catch false) and (key == "S" or key == "KeyS") { _history_save_persistent(state); return 0; }
    if key == "S" or key == "s" or key == "KeyS" { _history_toggle_store(state); return 0; }
    if key == "C" or key == "c" or key == "KeyC" or ((try state.ctrl catch false) and key == "Delete") {
        _history_clear(state);
        return 0;
    }
    if shift and key == "Delete" { _history_delete_selected(state); return 0; }
    let n = len(_history_hits(state));
    if key == "Home" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "home", 10); return 0; }
    if key == "End" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "previous", 10); return 0; }
    if key == "Down" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "down", 10); return 0; }
    if key == "Up" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "up", 10); return 0; }
    if key == "PageDown" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.history_sel = IDE.selection_move(try state.history_sel catch 0, n, "page_up", 10); return 0; }
    if key == "Delete" { state.history_query = ""; state.history_sel = 0; return 0; }
    if key == "Backspace" {
        if len(try state.history_query catch "") > 0 { state.history_query = str_slice(state.history_query, 0, len(state.history_query) - 1); }
        state.history_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _history_clamp(state);
        if len(hits) > 0 { _history_restore(state, hits[try state.history_sel catch 0]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.history_query = (try state.history_query catch "") + ch;
        state.history_sel = 0;
    }
    return 0;
}

fn _history_buttons(sz) {
    let y = TOP + CH + 4 * PAD + PAD / 2;
    let h = CH + PAD;
    let clearW = 11 * CW;
    let delW = 14 * CW;
    let clearX = sz.w - PAD - clearW;
    let delX = clearX - PAD - delW;
    return [
        map{ id: "delete", label: "Delete Sel", x: delX, y: y, w: delW, h: h },
        map{ id: "clear", label: "Clear All", x: clearX, y: y, w: clearW, h: h }
    ];
}

fn _history_button_hit(state, mx, my) {
    let buttons = _history_buttons(state.winsz);
    let i = 0;
    while i < len(buttons) {
        let b = buttons[i];
        if mx >= b.x and mx <= b.x + b.w and my >= b.y and my <= b.y + b.h { return b.id; }
        i = i + 1;
    }
    return "";
}

fn _draw_history(state, win, sz) {
    let maxchars = (sz.w - 2 * PAD) / CW;
    win.rect(0, TOP, sz.w, CH + 3 * PAD, _style_surface(state));
    win.rect(0, TOP + CH + 3 * PAD, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, TOP + PAD, "Run / Check History", _style_accent(state));
    _dt(win, PAD + 24 * CW, TOP + PAD, "type filter · S temp/permanent · Ctrl+S save · Enter load", _style_muted(state));

    let qy = TOP + CH + 4 * PAD;
    win.rect(PAD, qy, sz.w - 2 * PAD, CH + PAD, _style_surface2(state));
    win.rect(PAD, qy, sz.w - 2 * PAD, SCALE, _style_border(state));
    let q = "Search: " + (try state.history_query catch "") + "   " +
        IDE.history_filter_status(try state.history catch [], try state.history_query catch "", try state.history_sel catch 0) +
        "   " + _history_storage_summary(state);
    let shown = str_slice(q, 0, maxchars - 32);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);
    let buttons = _history_buttons(sz);
    let bi = 0;
    while bi < len(buttons) {
        let b = buttons[bi];
        let fill = _style_panel(state);
        if b.id == "clear" { fill = gfx.rgb(72, 44, 52); }
        if b.id == "clear" and _theme_is_light(state) { fill = gfx.rgb(248, 226, 226); }
        if b.id == "delete" { fill = _style_surface(state); }
        win.rect(b.x, b.y, b.w, b.h, fill);
        win.rect(b.x, b.y, b.w, SCALE, _style_border(state));
        win.rect(b.x, b.y + b.h - SCALE, b.w, SCALE, _style_border(state));
        win.rect(b.x, b.y, SCALE, b.h, _style_border(state));
        win.rect(b.x + b.w - SCALE, b.y, SCALE, b.h, _style_border(state));
        _dt(win, b.x + CW, b.y + PAD / 2, b.label, _style_text(state));
        bi = bi + 1;
    }

    let bodyTop = qy + CH + 2 * PAD;
    let hits = _history_clamp(state);
    let i = 0;
    if len(hits) == 0 {
        let msg = "No run/check history yet.";
        if len(try state.history catch []) > 0 { msg = "No history snapshots match the filter."; }
        _dt(win, PAD, bodyTop, msg, _style_error(state));
    }
    while i < len(hits) {
        let y = bodyTop + i * CH;
        if i == (try state.history_sel catch 0) { win.rect(0, y, sz.w, CH, _style_hilite(state)); }
        if i % 2 == 0 { win.rect(0, y, sz.w, CH, _style_row_rule(state)); }
        let h = hits[i];
        let badge = "FAIL";
        if try h.ok catch false { badge = "OK"; }
        let line = str((try h.index catch i) + 1) + ". " + str_upper(str(try h.action catch "?")) +
            " " + badge + "  " + str(try h.summary catch try h.output catch "");
        let col = _style_pane_text(state);
        if badge == "FAIL" { col = _style_error(state); }
        if badge == "OK" { col = _style_success(state); }
        _dt(win, PAD, y, str_slice(line, 0, maxchars), col);
        i = i + 1;
    }

    let footerY = sz.h - STATUSH;
    win.rect(0, footerY, sz.w, STATUSH, _style_surface(state));
    win.rect(0, footerY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, footerY + PAD / 2, "History: Enter restore. Shift+Delete/Delete Sel removes selected. C/Clear All removes all. Delete clears filter.", _style_muted(state));
}

fn _history_click(state, mx, my) {
    let bid = _history_button_hit(state, mx, my);
    if bid == "delete" { _history_delete_selected(state); return 0; }
    if bid == "clear" { _history_clear(state); return 0; }
    if state.winsz != nil and my >= state.winsz.h - STATUSH {
        _history_clear(state);
        return 0;
    }
    let qy = TOP + CH + 4 * PAD;
    let bodyTop = qy + CH + 2 * PAD;
    if my < bodyTop { return 0; }
    let idx = num_floor((my - bodyTop) / CH);
    let hits = _history_clamp(state);
    if idx < 0 or idx >= len(hits) { return 0; }
    state.history_sel = idx;
    _history_restore(state, hits[idx]);
    return 0;
}

// ── Management panel: database/storage/project management dashboard ─────────
fn _manage_records(state) {
    let hstate = IDE.history_storage_state(try state.history catch [], try state.history_mode catch "temporary", try state.history_stored catch false, _history_storage_path());
    let bstate = IDE.browser_management_state(try state.web.bookmarks catch [], try state.web.download_plans catch [], try state.web.security catch "safe", try state.web.tor catch false, try state.web.search_engine catch "duckduckgo");
    let dstate = IDE.database_management_state(try state.database.profiles catch [], try state.database.migrations catch [], try state.database.backups catch []);
    let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
    let ab = IDE.asset_backend_status(profile);
    return IDE.management_records(map{
        database_status: str(try dstate.status catch "empty"),
        database_detail: IDE.database_management_state(try state.database.profiles catch [], try state.database.migrations catch [], try state.database.backups catch []).summary + " · actions are gated plans",
        history_status: str(try hstate.status catch "temporary"),
        history_detail: _history_storage_summary(state),
        files_status: "active",
        browser_status: str(try bstate.route catch try state.web.security catch "safe"),
        browser_detail: IDE.browser_management_summary(bstate),
        browser_data_status: str(try bstate.status catch "empty"),
        browser_data_detail: "bookmarks " + str(try bstate.bookmarks catch 0) + " · download plans " + str(try bstate.downloads catch 0) + " · search " + str(try bstate.search_engine catch "duckduckgo"),
        asset_status: str(try ab.decode_status catch "planned") + "/" + str(try ab.export_status catch "planned"),
        asset_detail: IDE.asset_backend_summary(profile) + " · " + str_join(try ab.actions catch [], ", "),
        ai_status: "local",
        backup_status: "planned"
    });
}

fn _manage_hits(state) {
    return IDE.filter_management_records(_manage_records(state), try state.manage.query catch "", 200);
}

fn _manage_clamp(state) {
    let hits = _manage_hits(state);
    if (try state.manage.sel catch 0) < 0 { state.manage.sel = 0; }
    if len(hits) == 0 { state.manage.sel = 0; return hits; }
    if (try state.manage.sel catch 0) >= len(hits) { state.manage.sel = len(hits) - 1; }
    return hits;
}

fn _manage_open(state, hit) {
    let id = str(try hit.id catch "");
    if id == "database" {
        let profiles = try state.database.profiles catch [];
        let profile = IDE.database_profile("local", "sqlite", "", "readonly");
        if len(profiles) > 0 { profile = profiles[0]; }
        let plan = IDE.database_action_plan("backup", profile, "choose-output-path");
        state.output = "management -> database\n" +
            str(try hit.detail catch "") + "\n" +
            "plan: " + str(try plan.action catch "backup") + " " + str(try plan.profile catch "database") +
            " · executable=" + str(try plan.executable catch false) +
            " · requires: " + str_join(try plan.requires catch [], ", ");
        return 0;
    }
    if id == "history" {
        state.panel = "hist";
        state.output = _history_storage_summary(state);
        return 0;
    }
    if id == "files" {
        state.panel = "files";
        state.output = "management -> files";
        return 0;
    }
    if id == "browser" {
        state.panel = "web";
        state.output = "management -> browser security";
        return 0;
    }
    if id == "browser_data" {
        state.panel = "web";
        state.web.mode = "bookmarks";
        state.web.status = "browser data";
        let bstate = IDE.browser_management_state(try state.web.bookmarks catch [], try state.web.download_plans catch [], try state.web.security catch "safe", try state.web.tor catch false, try state.web.search_engine catch "duckduckgo");
        state.output = "management -> browser data: " + IDE.browser_management_summary(bstate);
        return 0;
    }
    if id == "asset_backends" {
        let profile = try state.file_profile catch IDE.editor_asset_profile(try state.path catch "");
        let plan = IDE.asset_action_plan("decode", profile, str(try state.path catch ""));
        state.output = "management -> document/media backends\n" +
            IDE.asset_backend_summary(profile) + "\n" +
            "decode executable: " + str(try plan.executable catch false) +
            " · requires: " + str_join(try plan.requires catch [], ", ");
        return 0;
    }
    if id == "models" {
        state.panel = "ai";
        state.output = "management -> local AI";
        return 0;
    }
    state.output = "management: " + str(try hit.title catch id) + " · " + str(try hit.detail catch "");
    return 0;
}

fn _manage_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    let n = len(_manage_hits(state));
    if key == "Home" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "home", 10); return 0; }
    if key == "End" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "previous", 10); return 0; }
    if key == "Down" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "down", 10); return 0; }
    if key == "Up" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "up", 10); return 0; }
    if key == "PageDown" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.manage.sel = IDE.selection_move(try state.manage.sel catch 0, n, "page_up", 10); return 0; }
    if key == "Delete" { state.manage.query = ""; state.manage.sel = 0; return 0; }
    if key == "Backspace" {
        if len(try state.manage.query catch "") > 0 { state.manage.query = str_slice(state.manage.query, 0, len(state.manage.query) - 1); }
        state.manage.sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _manage_clamp(state);
        if len(hits) > 0 { _manage_open(state, hits[try state.manage.sel catch 0]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.manage.query = (try state.manage.query catch "") + ch;
        state.manage.sel = 0;
    }
    return 0;
}

fn _draw_manage(state, win, sz) {
    let maxchars = (sz.w - 2 * PAD) / CW;
    win.rect(0, TOP, sz.w, CH + 3 * PAD, _style_surface(state));
    win.rect(0, TOP + CH + 3 * PAD, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, TOP + PAD, "Management / Databases", _style_accent(state));
    _dt(win, PAD + 28 * CW, TOP + PAD, "database · storage · files · browser · AI · backups", _style_muted(state));

    let qy = TOP + CH + 4 * PAD;
    win.rect(PAD, qy, sz.w - 2 * PAD, CH + PAD, _style_surface2(state));
    win.rect(PAD, qy, sz.w - 2 * PAD, SCALE, _style_border(state));
    let records = _manage_records(state);
    let q = "Search: " + (try state.manage.query catch "") + "   " +
        IDE.management_filter_status(records, try state.manage.query catch "", try state.manage.sel catch 0);
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = qy + CH + 2 * PAD;
    let hits = _manage_clamp(state);
    let i = 0;
    if len(hits) == 0 {
        _dt(win, PAD, bodyTop, "No management areas match the filter.", _style_error(state));
    }
    while i < len(hits) {
        let y = bodyTop + i * (CH * 2);
        if i == (try state.manage.sel catch 0) { win.rect(0, y, sz.w, CH * 2, _style_hilite(state)); }
        let h = hits[i];
        let head = str((try h.index catch i) + 1) + ". [" + str(try h.group catch "?") + "] " + str(try h.title catch "?") +
            " · " + str(try h.status catch "");
        _dt(win, PAD, y, str_slice(head, 0, maxchars), _style_pane_text(state));
        _dt(win, PAD + 2 * CW, y + CH, str_slice(str(try h.detail catch ""), 0, maxchars - 2), _style_muted(state));
        i = i + 1;
    }

    let footerY = sz.h - STATUSH;
    win.rect(0, footerY, sz.w, STATUSH, _style_surface(state));
    win.rect(0, footerY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, footerY + PAD / 2, "Management: Enter opens selected area. Database management is planned; History storage is active now.", _style_muted(state));
}

fn _manage_click(state, mx, my) {
    let qy = TOP + CH + 4 * PAD;
    let bodyTop = qy + CH + 2 * PAD;
    if my < bodyTop { return 0; }
    let idx = num_floor((my - bodyTop) / (CH * 2));
    let hits = _manage_clamp(state);
    if idx < 0 or idx >= len(hits) { return 0; }
    state.manage.sel = idx;
    _manage_open(state, hits[idx]);
    return 0;
}

// ── Files panel: project directory browser with filter/open/navigate ─────────
fn _files_refresh(state) {
    let dir = str(try state.files.dir catch ".");
    state.files.root_index = IDE.project_root_index(try state.files.roots catch [dir], dir);
    let settings = IDE.project_tree_settings(try state.files.tree_depth catch 3, try state.files.tree_max catch 600);
    state.files.tree_depth = settings.depth;
    state.files.tree_max = settings.max_items;
    let mode = str(try state.files.mode catch "flat");
    if mode == "recent" {
        state.files.entries = IDE.recent_files_entries(try state.recent_files catch [], 80);
    } else if mode == "tree" {
        state.files.entries = _tree_entries(dir, settings.depth, settings.max_items);
    } else {
        state.files.entries = _dir_entries(dir);
    }
    return state.files.entries;
}

fn _files_set_dir(state, dir) {
    state.files.dir = str(dir);
    state.files.query = "";
    state.files.sel = 0;
    state.files.root_index = IDE.project_root_index(try state.files.roots catch [state.files.dir], state.files.dir);
    _files_refresh(state);
    state.output = "files: " + state.files.dir;
    return 0;
}

fn _files_cycle_root(state, dir) {
    let roots = try state.files.roots catch [try state.files.dir catch "."];
    let cur = try state.files.dir catch ".";
    let next = IDE.project_root_cycle(roots, cur, dir);
    state.files.root_index = next.index;
    _files_set_dir(state, next.path);
    state.output = "files " + IDE.project_root_status_with_meta(roots, next.path, try state.files.root_meta catch []);
    return 0;
}

fn _files_roots_path() {
    let home = try env_get("HOME") catch "";
    if home != nil and str(home) != "" {
        return _path_join2(str(home), ".pblang_pbide_roots.txt");
    }
    return ".pblang_pbide_roots.txt";
}

fn _files_load_saved_roots(cwd, file_path) {
    let raw = try fs_read(_files_roots_path()) catch "";
    return IDE.project_roots_merge_saved(cwd, file_path, raw);
}

fn _files_load_saved_root_meta() {
    let raw = try fs_read(_files_roots_path()) catch "";
    return IDE.project_root_meta_from_text(raw);
}

fn _files_save_roots(state) {
    let roots = try state.files.roots catch [];
    let text = IDE.project_roots_file_to_text(roots, try state.files.root_meta catch []);
    let ok = try fs_write(_files_roots_path(), text) catch false;
    return ok;
}

fn _files_bookmark_current_root(state) {
    let roots = try state.files.roots catch [];
    roots = IDE.project_roots("", "", roots);
    let dir = str(try state.files.dir catch ".");
    roots = IDE.project_roots("", "", roots + [dir]);
    state.files.roots = roots;
    state.files.root_index = IDE.project_root_index(roots, dir);
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = "files root bookmarked " + IDE.project_root_status_with_meta(roots, dir, try state.files.root_meta catch []) + suffix;
    return 0;
}

fn _files_root_label_from_query(state) {
    let path = str(try state.files.dir catch ".");
    let label = str_trim(str(try state.files.query catch ""));
    if label == "" {
        state.output = "files root rename: type a label in the Files filter, then use Ctrl+Shift+B";
        return 0;
    }
    let cur = IDE.project_root_meta_get(try state.files.root_meta catch [], path);
    state.files.root_meta = IDE.project_root_meta_set(try state.files.root_meta catch [], path, label, try cur.group catch IDE.project_root_group(path));
    state.files.query = "";
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = IDE.project_root_edit_summary(try state.files.root_meta catch [], path) + suffix;
    return 0;
}

fn _files_root_group_next(state) {
    let path = str(try state.files.dir catch ".");
    state.files.root_meta = IDE.project_root_meta_next_group(try state.files.root_meta catch [], path);
    let saved = _files_save_roots(state);
    let suffix = " session only";
    if saved { suffix = " saved"; }
    state.output = IDE.project_root_edit_summary(try state.files.root_meta catch [], path) + suffix;
    return 0;
}

fn _files_set_mode(state, mode) {
    state.panel = "files";
    state.files.mode = str(mode);
    state.files.sel = 0;
    _files_refresh(state);
    state.output = "files mode: " + str(state.files.mode);
    return 0;
}

fn _files_reveal_current(state) {
    let p = str(try state.path catch "");
    let dir = try path_dirname(p) catch ".";
    if dir == "" { dir = "."; }
    state.panel = "files";
    state.files.dir = dir;
    state.files.mode = "flat";
    state.files.query = _path_base2(p);
    state.files.sel = 0;
    _files_refresh(state);
    _files_clamp(state);
    state.output = "files reveal: " + p;
    return 0;
}

fn _files_clear_recent(state) {
    state.recent_files = [];
    state.panel = "files";
    if str(try state.files.mode catch "flat") == "recent" { _files_refresh(state); }
    state.files.sel = 0;
    state.output = "recent files cleared";
    return 0;
}

fn _files_remove_selected_recent(state) {
    if str(try state.files.mode catch "flat") != "recent" { return 0; }
    let hits = _files_clamp(state);
    if len(hits) == 0 { state.output = "recent files empty"; return 0; }
    let hit = hits[state.files.sel];
    let p = str(try hit.path catch "");
    state.recent_files = IDE.recent_files_remove(try state.recent_files catch [], p);
    _files_refresh(state);
    _files_clamp(state);
    state.output = "removed recent file: " + p;
    return 0;
}

fn _files_hits(state) {
    let entries = try state.files.entries catch [];
    if len(entries) == 0 { entries = _files_refresh(state); }
    return IDE.quick_open_candidates(entries, try state.files.query catch "", 300);
}

fn _files_clamp(state) {
    let hits = _files_hits(state);
    if state.files.sel < 0 { state.files.sel = 0; }
    if len(hits) == 0 { state.files.sel = 0; return hits; }
    if state.files.sel >= len(hits) { state.files.sel = len(hits) - 1; }
    return hits;
}

fn _files_accept(state, hit) {
    if hit == nil { return 0; }
    if (try hit.kind catch "file") == "dir" {
        _files_set_dir(state, hit.path);
        return 0;
    }
    state.output = _open_path(state, hit.path);
    return 0;
}

fn _files_selected_hit(state) {
    let hits = _files_clamp(state);
    if len(hits) == 0 { return nil; }
    return hits[state.files.sel];
}

fn _files_inspect_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files inspect: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let profile = IDE.editor_asset_profile(p);
    let plan = IDE.file_explorer_operation_plan("inspect", p, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
        str_join(IDE.file_explorer_selection_detail_lines(hit, try state.files.dir catch "."), "\n") + "\n" +
        "profile: " + str(try profile.editor catch "?") + "/" + str(try profile.family catch "?");
    return 0;
}

fn _files_preview_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files preview: no selection"; return 0; }
    if (try hit.kind catch "file") == "dir" { _files_inspect_selected(state); return 0; }
    state.output = _open_path(state, try hit.path catch "");
    return 0;
}

fn _files_transfer_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files transfer: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let remote = try state.files.remote catch IDE.file_transfer_profile("remote", "", "", "sftp");
    let target = "remote://" + str(try remote.name catch "remote") + "/" + str(try hit.name catch _path_base2(p));
    let plan = IDE.file_explorer_operation_plan("upload", p, target);
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
        IDE.file_transfer_profile_summary(remote) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_copy_selected(state) {
    let hit = _files_selected_hit(state);
    state.files.clipboard = IDE.file_explorer_clipboard_record("copy", hit);
    state.output = IDE.file_explorer_clipboard_summary(state.files.clipboard);
    return 0;
}

fn _files_cut_selected(state) {
    let hit = _files_selected_hit(state);
    state.files.clipboard = IDE.file_explorer_clipboard_record("cut", hit);
    state.output = IDE.file_explorer_clipboard_summary(state.files.clipboard);
    return 0;
}

fn _files_paste_plan(state) {
    let plan = IDE.file_explorer_paste_plan(try state.files.clipboard catch nil, try state.files.dir catch ".");
    state.output = IDE.file_explorer_operation_summary(plan) + "\n" +
        IDE.file_explorer_clipboard_summary(try state.files.clipboard catch nil) + "\nrequires: " +
        str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_delete_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files delete: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let plan = IDE.file_explorer_operation_plan("delete", p, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_rename_plan_selected(state) {
    let hit = _files_selected_hit(state);
    if hit == nil { state.output = "files rename: no selection"; return 0; }
    let p = str(try hit.path catch try hit.name catch "");
    let target = p + ".renamed";
    let plan = IDE.file_explorer_operation_plan("rename", p, target);
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_new_folder_plan(state) {
    let dir = str(try state.files.dir catch ".");
    let target = dir;
    if not str_ends_with(target, "/") { target = target + "/"; }
    target = target + "new-folder";
    let plan = IDE.file_explorer_operation_plan("mkdir", target, "");
    state.output = IDE.file_explorer_operation_summary(plan) + "\nrequires: " + str_join(try plan.requires catch [], ", ");
    return 0;
}

fn _files_remote_profile(state) {
    let remote = try state.files.remote catch IDE.file_transfer_profile("remote", "", "", "sftp");
    state.files.remote = remote;
    state.output = IDE.file_transfer_profile_summary(remote) + "\nremote transfers are planned only; credentials stay outside PBIDE.";
    return 0;
}

fn _files_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if key == "Home" { state.files.sel = 0; _files_clamp(state); return 0; }
    if key == "End" {
        let hits = _files_clamp(state);
        if len(hits) > 0 { state.files.sel = len(hits) - 1; }
        return 0;
    }
    if key == "Down" { state.files.sel = state.files.sel + 1; _files_clamp(state); return 0; }
    if key == "Up" { state.files.sel = state.files.sel - 1; _files_clamp(state); return 0; }
    if key == "PageDown" { state.files.sel = state.files.sel + 10; _files_clamp(state); return 0; }
    if key == "PageUp" { state.files.sel = state.files.sel - 10; _files_clamp(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "N" or key == "KeyN") { _files_new_folder_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.files.sel = state.files.sel + 1; _files_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.files.sel = state.files.sel - 1; _files_clamp(state); return 0; }
    if str(try state.files.mode catch "flat") == "recent" and (try state.ctrl catch false) and key == "Delete" { _files_clear_recent(state); return 0; }
    if str(try state.files.mode catch "flat") == "recent" and key == "Delete" { _files_remove_selected_recent(state); return 0; }
    if key == "Delete" { _files_delete_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "B" or key == "KeyB") { _files_root_label_from_query(state); return 0; }
    if (try state.ctrl catch false) and shift and (key == "G" or key == "KeyG") { _files_root_group_next(state); return 0; }
    if (try state.ctrl catch false) and (key == "B" or key == "KeyB") { _files_bookmark_current_root(state); return 0; }
    if (try state.ctrl catch false) and (key == "C" or key == "KeyC") { _files_copy_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "X" or key == "KeyX") { _files_cut_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "V" or key == "KeyV") { _files_paste_plan(state); return 0; }
    if (try state.ctrl catch false) and (key == "I" or key == "KeyI") { _files_inspect_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "U" or key == "KeyU") { _files_transfer_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "M" or key == "KeyM") { _files_remote_profile(state); return 0; }
    if key == "F2" { _files_rename_plan_selected(state); return 0; }
    if (try state.ctrl catch false) and (key == "Right" or key == "PageRight" or key == "L") { _files_cycle_root(state, 1); return 0; }
    if (try state.ctrl catch false) and (key == "Left" or key == "PageLeft" or key == "H") { _files_cycle_root(state, 0 - 1); return 0; }
    if (try state.ctrl catch false) and (key == "Equals" or key == "Plus" or key == "NumpadAdd" or key == "=" or key == "+") {
        state.files.tree_depth = IDE.project_tree_depth_delta(try state.files.tree_depth catch 3, 1);
        state.files.mode = "tree";
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files tree depth: " + str(state.files.tree_depth);
        return 0;
    }
    if (try state.ctrl catch false) and (key == "Minus" or key == "NumpadSubtract" or key == "-") {
        state.files.tree_depth = IDE.project_tree_depth_delta(try state.files.tree_depth catch 3, 0 - 1);
        state.files.mode = "tree";
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files tree depth: " + str(state.files.tree_depth);
        return 0;
    }
    if key == "Tab" {
        let mode = str(try state.files.mode catch "flat");
        if mode == "flat" {
            state.files.mode = "tree";
        } else if mode == "tree" {
            state.files.mode = "recent";
        } else {
            state.files.mode = "flat";
        }
        state.files.sel = 0;
        _files_refresh(state);
        state.output = "files mode: " + str(state.files.mode);
        return 0;
    }
    if key == "Backspace" {
        if len(state.files.query) > 0 {
            state.files.query = str_slice(state.files.query, 0, len(state.files.query) - 1);
            state.files.sel = 0;
        } else {
            _files_set_dir(state, try path_dirname(state.files.dir) catch ".");
        }
        return 0;
    }
    if key == "R" and state.ctrl { _files_refresh(state); state.output = "files refreshed"; return 0; }
    if _is_enter(key) {
        let hits = _files_clamp(state);
        if len(hits) > 0 { _files_accept(state, hits[state.files.sel]); }
        return 0;
    }
    if key == "Space" { _files_preview_selected(state); return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.files.query = state.files.query + ch;
        state.files.sel = 0;
    }
    return 0;
}

fn _draw_files(state, win, sz) {
    let maxchars = (sz.w - 2 * PAD) / CW;
    let entries = try state.files.entries catch [];
    if len(entries) == 0 { _files_refresh(state); }
    win.rect(0, TOP, sz.w, CH + 3 * PAD, _style_surface(state));
    win.rect(0, TOP + CH + 3 * PAD, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, TOP + PAD, "Files / Project", _style_accent(state));
    let mode = str(try state.files.mode catch "flat");
    let roots = try state.files.roots catch [try state.files.dir catch "."];
    let ridx = IDE.project_root_index(roots, try state.files.dir catch ".");
    state.files.root_index = ridx;
    let settings = IDE.project_tree_settings(try state.files.tree_depth catch 3, try state.files.tree_max catch 600);
    state.files.tree_depth = settings.depth;
    state.files.tree_max = settings.max_items;
    let rootText = IDE.project_root_status_with_meta(roots, try state.files.dir catch ".", try state.files.root_meta catch []);
    let treeText = "depth " + str(settings.depth);
    if mode != "tree" { treeText = "flat"; }
    if mode == "recent" { treeText = "recent " + str(len(try state.recent_files catch [])); }
    _dt(win, PAD + 19 * CW, TOP + PAD, mode + " · " + treeText + " · " + rootText + " · Ctrl+Shift+B label · Ctrl+Shift+G group", _style_muted(state));

    let qy = TOP + CH + 4 * PAD;
    win.rect(PAD, qy, sz.w - 2 * PAD, CH + PAD, _style_surface2(state));
    win.rect(PAD, qy, sz.w - 2 * PAD, SCALE, _style_border(state));
    let q = rootText + "  " + mode + "  " + treeText + "  > " + str(try state.files.query catch "");
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let statusY = qy + CH + PAD;
    let fileStatus = IDE.file_explorer_status_line(
        try state.files.dir catch ".",
        try state.files.clipboard catch nil,
        try state.files.remote catch nil
    );
    _dt(win, PAD, statusY, str_slice(fileStatus, 0, maxchars), _style_muted(state));

    let bodyTop = qy + CH * 3 + 3 * PAD;
    let hits = _files_clamp(state);
    let countText = str(len(hits)) + " result";
    if len(hits) != 1 { countText = countText + "s"; }
    _dt(win, sz.w - 20 * CW, qy + PAD / 2, str_slice(countText, 0, 18), _style_muted(state));
    if len(hits) == 0 {
        let miss = IDE.files_panel_empty_message(try state.files.query catch "", mode);
        _dt(win, PAD, bodyTop, str_slice(miss, 0, maxchars), _style_error(state));
    } else {
        let detail = IDE.files_panel_status(try state.files.query catch "", state.files.sel, hits, try state.files.dir catch ".", mode);
        _dt(win, PAD, bodyTop - CH - PAD / 2, str_slice(detail, 0, maxchars), _style_accent(state));
        let hint = IDE.files_panel_hint(try state.files.query catch "");
        let actionHint = IDE.file_explorer_action_line(hits[state.files.sel]);
        _dt(win, PAD, bodyTop - CH * 2 - PAD / 2, str_slice(hint + " · " + actionHint, 0, maxchars), _style_muted(state));
        _dt(win, PAD, bodyTop - SCALE, "NAME", _style_muted(state));
        _dt(win, PAD + 34 * CW, bodyTop - SCALE, "PATH", _style_muted(state));
        let rows = (sz.h - bodyTop - STATUSH - PAD) / CH;
        let i = 0;
        while i < len(hits) and i < rows {
            let y = bodyTop + i * CH;
            if i == state.files.sel { win.rect(0, y, sz.w, CH, _style_hilite(state)); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let h = hits[i];
            let col = _style_pane_text(state);
            if (try h.kind catch "file") == "dir" { col = _style_info(state); }
            let nameW = 32 * CW;
            let pathX = PAD + nameW + CW;
            let pathMax = (sz.w - PAD - pathX) / CW;
            let name = str(i + 1) + ". " + h.label;
            _dt(win, PAD, y, str_slice(name, 0, nameW / CW), col);
            _dt(win, pathX, y, str_slice(h.path, 0, pathMax), _style_muted(state));
            i = i + 1;
        }
    }
    let footerY = sz.h - STATUSH;
    win.rect(0, footerY, sz.w, STATUSH, _style_surface(state));
    win.rect(0, footerY, sz.w, SCALE, _style_border(state));
    let footer = "Files: Tab flat/tree/recent, Ctrl+/- depth, Ctrl+Left/Right roots, Ctrl+B bookmark, Ctrl+Shift+B label, Ctrl+Shift+G group";
    if mode == "recent" { footer = "Files recent: Enter open, Delete removes selected, Ctrl+Delete clears, Tab leaves recent."; }
    _dt(win, PAD, footerY + PAD / 2, footer, _style_muted(state));
}

fn _files_click(state, mx, my) {
    let qy = TOP + CH + 4 * PAD;
    let bodyTop = qy + CH + 2 * PAD;
    if my < bodyTop { return 0; }
    let row = num_floor((my - bodyTop) / CH);
    let hits = _files_clamp(state);
    if row >= 0 and row < len(hits) {
        state.files.sel = row;
        _files_accept(state, hits[row]);
    }
    return 0;
}

// ── Outline panel: searchable symbols with click/Enter jump ─────────────────
fn _outline_hits(state) {
    return IDE.filter_outline(E.text(state.ed), try state.outline.query catch "", 200);
}

fn _outline_clamp(state) {
    let hits = _outline_hits(state);
    if state.outline.sel < 0 { state.outline.sel = 0; }
    if len(hits) == 0 { state.outline.sel = 0; return hits; }
    if state.outline.sel >= len(hits) { state.outline.sel = len(hits) - 1; }
    return hits;
}

fn _outline_jump(state, hit) {
    let line = try hit.line catch 1;
    if line < 1 { line = 1; }
    _nav_record_if_changed(state, line - 1, 0, "before outline");
    E.set_cursor(state.ed, line - 1, 0);
    state.panel = "code";
    state.output = "outline jump: " + str(try hit.kind catch "?") + " " + str(try hit.name catch "?") + " at line " + str(line);
    return 0;
}

fn _outline_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    let n = len(_outline_hits(state));
    if key == "Home" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "home", 10); return 0; }
    if key == "End" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.outline.sel = IDE.selection_move(state.outline.sel, n, "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.outline.sel = IDE.selection_move(state.outline.sel, n, "previous", 10); return 0; }
    if key == "Down" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "down", 10); return 0; }
    if key == "Up" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "up", 10); return 0; }
    if key == "PageDown" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "page_down", 10); return 0; }
    if key == "PageUp" { state.outline.sel = IDE.selection_move(state.outline.sel, n, "page_up", 10); return 0; }
    if key == "Delete" { state.outline.query = ""; state.outline.sel = 0; return 0; }
    if key == "Backspace" {
        if len(state.outline.query) > 0 { state.outline.query = str_slice(state.outline.query, 0, len(state.outline.query) - 1); }
        state.outline.sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _outline_clamp(state);
        if len(hits) > 0 { _outline_jump(state, hits[state.outline.sel]); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.outline.query = state.outline.query + ch;
        state.outline.sel = 0;
    }
    return 0;
}

fn _draw_outline(state, win, sz) {
    let maxchars = (sz.w - 2 * PAD) / CW;
    win.rect(0, TOP, sz.w, CH + 3 * PAD, _style_surface(state));
    win.rect(0, TOP + CH + 3 * PAD, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, TOP + PAD, "Outline / Symbols", _style_accent(state));
    _dt(win, PAD + 22 * CW, TOP + PAD, "type filter · Home/End/Pg/Ctrl+N/P select · Delete clear · Enter jump", _style_muted(state));

    let qy = TOP + CH + 4 * PAD;
    win.rect(PAD, qy, sz.w - 2 * PAD, CH + PAD, _style_surface2(state));
    win.rect(PAD, qy, sz.w - 2 * PAD, SCALE, _style_border(state));
    let q = "Search: " + (try state.outline.query catch "") + "   " +
        IDE.outline_filter_status(E.text(state.ed), try state.outline.query catch "", try state.outline.sel catch 0) +
        "   Delete clears";
    let shown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, shown, _style_text(state));
    win.rect(PAD + CW + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = qy + CH + 2 * PAD;
    let hits = _outline_clamp(state);
    if len(hits) == 0 {
        _dt(win, PAD, bodyTop, "No symbols found.", _style_error(state));
    } else {
        let rows = (sz.h - bodyTop - STATUSH - PAD) / CH;
        let i = 0;
        while i < len(hits) and i < rows {
            let y = bodyTop + i * CH;
            if i == state.outline.sel { win.rect(0, y, sz.w, CH, _style_hilite(state)); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let h = hits[i];
            let span = "L" + str(try h.line catch 1);
            let endLine = try h.end_line catch try h.line catch 1;
            if endLine != (try h.line catch 1) { span = span + "-L" + str(endLine); }
            let txt = str(try h.kind catch "?") + "  " + str(try h.name catch "?") + "   " + span + "   " + str(try h.lines catch 1) + " line(s)";
            let col = _style_pane_text(state);
            if (try h.kind catch "") == "fn" { col = _style_info(state); }
            if (try h.kind catch "") == "const" { col = _style_warning(state); }
            _dt(win, PAD, y, str_slice(txt, 0, maxchars), col);
            i = i + 1;
        }
    }
    let footerY = sz.h - STATUSH;
    win.rect(0, footerY, sz.w, STATUSH, _style_surface(state));
    win.rect(0, footerY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, footerY + PAD / 2, "Outline shows top-level fn/let/const/export from the current buffer.", _style_muted(state));
}

fn _outline_click(state, mx, my) {
    let qy = TOP + CH + 4 * PAD;
    let bodyTop = qy + CH + 2 * PAD;
    if my < bodyTop { return 0; }
    let row = num_floor((my - bodyTop) / CH);
    let hits = _outline_clamp(state);
    if row >= 0 and row < len(hits) {
        state.outline.sel = row;
        _outline_jump(state, hits[row]);
    }
    return 0;
}

// ── Problems panel: dedicated diagnostics list + watcher action ──────────────
fn _problems_hits(state) {
    return IDE.filter_diagnostics(try state.diagnostics catch [], try state.problems.query catch "", 1000);
}

fn _problems_count(state) {
    return 1 + len(_problems_hits(state));
}

fn _problems_clamp(state) {
    let n = _problems_count(state);
    if state.problems.sel < 0 { state.problems.sel = 0; }
    if state.problems.sel >= n { state.problems.sel = n - 1; }
    return n;
}

fn _problems_accept(state) {
    let n = _problems_clamp(state);
    if n < 1 { return 0; }
    if state.problems.sel == 0 {
        _watch_action(state);
        state.panel = "problems";
        return 0;
    }
    let idx = state.problems.sel - 1;
    let hits = _problems_hits(state);
    if idx >= 0 and idx < len(hits) {
        state.diag_index = try hits[idx].index catch idx;
        _diagnostic_goto(state, 0);
    }
    return 0;
}

fn _problems_key(state, key, shift) {
    if key == "Escape" { state.panel = "code"; return 0; }
    if key == "Delete" {
        state.problems.query = "";
        state.problems.sel = 0;
        return 0;
    }
    if key == "Backspace" {
        if len(try state.problems.query catch "") > 0 { state.problems.query = str_slice(state.problems.query, 0, len(state.problems.query) - 1); }
        state.problems.sel = 0;
        return 0;
    }
    if key == "Home" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "home", 10); return 0; }
    if key == "End" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "end", 10); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "next", 10); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "previous", 10); return 0; }
    if key == "Down" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "down", 10); return 0; }
    if key == "Up" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "up", 10); return 0; }
    if key == "PageDown" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "page_down", 10); return 0; }
    if key == "PageUp" { state.problems.sel = IDE.selection_move(state.problems.sel, _problems_count(state), "page_up", 10); return 0; }
    if _is_enter(key) { _problems_accept(state); return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.problems.query = str(try state.problems.query catch "") + ch;
        state.problems.sel = 0;
    }
    return 0;
}

fn _draw_problems(state, win, sz) {
    let maxchars = (sz.w - 2 * PAD) / CW;
    win.rect(0, TOP, sz.w, CH + 3 * PAD, _style_surface(state));
    win.rect(0, TOP + CH + 3 * PAD, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, TOP + PAD, "Problems / Diagnostics", _style_accent(state));
    _dt(win, PAD + 27 * CW, TOP + PAD, str_slice(IDE.diagnostic_counts_label(state.diagnostics) + " · Enter/click action or jump · F6 refresh", 0, maxchars - 28), _style_muted(state));

    let qy = TOP + CH + 4 * PAD;
    win.rect(PAD, qy, sz.w - 2 * PAD, CH + PAD, _style_surface2(state));
    win.rect(PAD, qy, sz.w - 2 * PAD, SCALE, _style_border(state));
    let q = "Filter: " + str(try state.problems.query catch "") + "   " +
        IDE.diagnostic_filter_status(state.diagnostics, try state.problems.query catch "", (try state.problems.sel catch 1) - 1) +
        "   Delete clears";
    let qshown = str_slice(q, 0, maxchars - 4);
    _dt(win, PAD + CW, qy + PAD / 2, qshown, _style_text(state));
    win.rect(PAD + CW + len(qshown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let bodyTop = qy + CH + 2 * PAD;
    _problems_clamp(state);
    let action = IDE.watcher_action(state.watch);
    let actionText = "action: " + str(try action.message catch "watcher unavailable");
    if state.problems.sel == 0 { win.rect(0, bodyTop, sz.w, CH, _style_hilite(state)); }
    let ac = _style_muted(state);
    if (try action.severity catch "") == "warn" { ac = _style_warning(state); }
    if (try action.severity catch "") == "error" { ac = _style_error(state); }
    if (try action.severity catch "") == "ok" { ac = _style_success(state); }
    _dt(win, PAD, bodyTop, str_slice(actionText, 0, maxchars), ac);

    let hits = _problems_hits(state);
    let dl = IDE.diagnostic_summary(hits, 1000);
    let startY = bodyTop + CH + PAD;
    let detailH = CH * 4 + PAD;
    let detailY = sz.h - STATUSH - detailH;
    if len(try state.diagnostics catch []) == 0 {
        _dt(win, PAD, startY, str_slice(dl[0], 0, maxchars), _style_muted(state));
    } else if len(hits) == 0 {
        _dt(win, PAD, startY, str_slice("No diagnostics match filter: " + str(try state.problems.query catch ""), 0, maxchars), _style_warning(state));
    } else {
        let rows = (detailY - startY - PAD) / CH;
        if rows < 1 { rows = 1; }
        let i = 0;
        while i < len(dl) and i < rows {
            let y = startY + i * CH;
            if state.problems.sel == i + 1 { win.rect(0, y, sz.w, CH, _style_hilite(state)); }
            if i % 2 == 0 { win.rect(0, y, sz.w, SCALE, _style_row_rule(state)); }
            let col = _style_muted(state);
            if str_contains(dl[i], "ERROR") { col = _style_error(state); }
            if str_contains(dl[i], "WARNING") { col = _style_warning(state); }
            _dt(win, PAD, y, str_slice(dl[i], 0, maxchars), col);
            i = i + 1;
        }
    }
    win.rect(0, detailY, sz.w, detailH, _style_panel(state));
    win.rect(0, detailY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, detailY + PAD / 2, "Selected diagnostic detail", _style_accent(state));
    let selectedDiag = nil;
    let selectedIdx = (try state.problems.sel catch 0) - 1;
    if selectedIdx >= 0 and selectedIdx < len(hits) { selectedDiag = hits[selectedIdx]; }
    let detail = IDE.diagnostic_detail_lines(selectedDiag, 3);
    let dd = 0;
    while dd < len(detail) and dd < 3 {
        let col = _style_muted(state);
        if dd == 0 and str_contains(detail[dd], "ERROR") { col = _style_error(state); }
        if dd == 0 and str_contains(detail[dd], "WARNING") { col = _style_warning(state); }
        _dt(win, PAD, detailY + CH + PAD + dd * CH, str_slice(detail[dd], 0, maxchars), col);
        dd = dd + 1;
    }
    let footerY = sz.h - STATUSH;
    win.rect(0, footerY, sz.w, STATUSH, _style_surface(state));
    win.rect(0, footerY, sz.w, SCALE, _style_border(state));
    _dt(win, PAD, footerY + PAD / 2, "Problems uses current diagnostics; stale/unchecked action row runs Check.", _style_muted(state));
}

fn _problems_click(state, mx, my) {
    let qy = TOP + CH + 4 * PAD;
    let bodyTop = qy + CH + 2 * PAD;
    let sz = try state.winsz catch nil;
    if sz != nil {
        let detailY = sz.h - STATUSH - (CH * 4 + PAD);
        if my >= detailY { return false; }
    }
    let hit = IDE.problems_panel_hit(my, bodyTop, CH, PAD, len(_problems_hits(state)));
    if (try hit.kind catch "") == "action" {
        state.problems.sel = 0;
        _problems_accept(state);
        return 0;
    }
    if (try hit.kind catch "") == "diagnostic" {
        state.problems.sel = (try hit.index catch 0) + 1;
        _problems_accept(state);
    }
    return 0;
}

// ── searchable examples picker: native equivalent of the web IDE examples list ─────
fn _example_box(sz) {
    let bw = 72 * CW;
    if bw > sz.w - 4 * PAD { bw = sz.w - 4 * PAD; }
    let bh = CH * 17 + 6 * PAD;
    if bh > sz.h - 4 * PAD { bh = sz.h - 4 * PAD; }
    let bx = (sz.w - bw) / 2;
    let by = TOP + 2 * PAD;
    if by + bh > sz.h - STATUSH { by = (sz.h - bh) / 2; }
    return map{ x: bx, y: by, w: bw, h: bh, list_y: by + CH * 4 + 4 * PAD };
}

fn _draw_examples(state, win, sz) {
    let b = _example_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    win.rect(b.x, b.y, b.w, b.h, _style_panel(state));
    win.rect(b.x, b.y, b.w, SCALE, _style_accent(state));
    win.rect(b.x, b.y + b.h - SCALE, b.w, SCALE, _style_border(state));
    win.rect(b.x, b.y, SCALE, b.h, _style_border(state));
    win.rect(b.x + b.w - SCALE, b.y, SCALE, b.h, _style_border(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Examples", _style_accent(state));
    _dt(win, b.x + 15 * CW, b.y + 2 * PAD, "type filter  Pg/Home/End/Ctrl+N/P select  Delete clear  Enter load", _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state));
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, SCALE, _style_border(state));
    let q = "Search: " + state.example_query + "   " +
        IDE.examples_filter_status(EXAMPLES, try state.example_query catch "", try state.example_sel catch 0) +
        "   Esc closes";
    let shown = str_slice(q, 0, (b.w - 6 * PAD) / CW);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shown, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _example_clamp(state);
    if len(hits) == 0 {
        _dt(win, b.x + 2 * PAD, b.list_y, "No matching examples.", _style_error(state));
        return 0;
    }
    let i = 0;
    while i < len(hits) and i < 12 {
        let y = b.list_y + i * CH;
        if i == state.example_sel { win.rect(b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state)); }
        let ex = EXAMPLES[hits[i].index];
        let line = str(i + 1) + ". " + hits[i].title + "   #" + str(hits[i].index + 1);
        _dt(win, b.x + 2 * PAD, y, str_slice(line, 0, (b.w - 4 * PAD) / CW), _style_pane_text(state));
        i = i + 1;
    }
    return 0;
}

fn _examples_click(state, mx, my) {
    if not (try state.examples_mode catch false) or state.winsz == nil { return false; }
    let b = _example_box(state.winsz);
    if mx < b.x or mx >= b.x + b.w or my < b.y or my >= b.y + b.h { return false; }
    if my < b.list_y { return true; }
    let row = num_floor((my - b.list_y) / CH);
    let hits = _example_clamp(state);
    if row >= 0 and row < len(hits) {
        state.example_sel = row;
        _load_example_index(state, hits[row].index);
    }
    return true;
}

// ── command palette: keyboard route to all main IDE actions ─────────────────
fn _command_box(sz) {
    let bw = 84 * CW;
    if bw > sz.w - 4 * PAD { bw = sz.w - 4 * PAD; }
    let bh = CH * 16 + 6 * PAD;
    if bh > sz.h - 4 * PAD { bh = sz.h - 4 * PAD; }
    let bx = (sz.w - bw) / 2;
    let by = TOP + 2 * PAD;
    if by + bh > sz.h - STATUSH { by = (sz.h - bh) / 2; }
    return map{ x: bx, y: by, w: bw, h: bh, list_y: by + CH * 4 + 4 * PAD };
}

fn _draw_command_palette(state, win, sz) {
    let b = _command_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    win.rect(b.x, b.y, b.w, b.h, _style_panel(state));
    win.rect(b.x, b.y, b.w, SCALE, _style_accent(state));
    win.rect(b.x, b.y + b.h - SCALE, b.w, SCALE, _style_border(state));
    win.rect(b.x, b.y, SCALE, b.h, _style_border(state));
    win.rect(b.x + b.w - SCALE, b.y, SCALE, b.h, _style_border(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Command Palette", _style_accent(state));
    let head = IDE.command_catalog_summary(nil) + "  ·  " + IDE.command_filter_examples_line(6) + "  Pg/Home/End/Ctrl+N/P select  Delete clear  Enter run";
    _dt(win, b.x + 22 * CW, b.y + 2 * PAD, str_slice(head, 0, (b.w - 24 * CW) / CW), _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state));
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, SCALE, _style_border(state));
    let q = "> " + (try state.command_query catch "") + "   " +
        IDE.command_filter_status(try state.command_query catch "", try state.command_sel catch 0);
    let shown = str_slice(q, 0, (b.w - 6 * PAD) / CW);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shown, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shown) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _command_clamp(state);
    if len(hits) == 0 {
        let miss = IDE.command_empty_message(try state.command_query catch "");
        _dt(win, b.x + 2 * PAD, b.list_y, str_slice(miss, 0, (b.w - 4 * PAD) / CW), _style_error(state));
        return 0;
    }
    let selected = hits[state.command_sel];
    let detail = str(state.command_sel + 1) + "/" + str(len(hits)) + "  " + selected.group + " / " + selected.title + " / " + selected.shortcut;
    _dt(win, b.x + 2 * PAD, b.list_y - CH - PAD / 2, str_slice(detail, 0, (b.w - 4 * PAD) / CW), _style_accent(state));
    let hint = IDE.command_filter_hint(try state.command_query catch "");
    _dt(win, b.x + 2 * PAD, b.list_y - CH * 2 - PAD / 2, str_slice(hint, 0, (b.w - 4 * PAD) / CW), _style_muted(state));
    _dt(win, b.x + 2 * PAD, b.list_y - SCALE, "GROUP", _style_muted(state));
    _dt(win, b.x + 13 * CW, b.list_y - SCALE, "COMMAND", _style_muted(state));
    _dt(win, b.x + b.w - 28 * CW, b.list_y - SCALE, "SHORTCUT", _style_muted(state));
    let i = 0;
    while i < len(hits) and i < 12 {
        let y = b.list_y + i * CH;
        if i == state.command_sel { win.rect(b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state)); }
        let c = hits[i];
        let groupW = 11 * CW;
        let shortcutW = 26 * CW;
        let titleX = b.x + 2 * PAD + groupW;
        let shortcutX = b.x + b.w - 2 * PAD - shortcutW;
        let titleMax = (shortcutX - titleX - CW) / CW;
        if titleMax < 8 { titleMax = 8; }
        _dt(win, b.x + 2 * PAD, y, str_slice(c.group, 0, 10), _style_muted(state));
        _dt(win, titleX, y, str_slice(c.title, 0, titleMax), _style_pane_text(state));
        _dt(win, shortcutX, y, str_slice(c.shortcut, 0, shortcutW / CW), _style_accent(state));
        i = i + 1;
    }
    return 0;
}

fn _command_click(state, mx, my) {
    if not (try state.command_mode catch false) or state.winsz == nil { return false; }
    let b = _command_box(state.winsz);
    if mx < b.x or mx >= b.x + b.w or my < b.y or my >= b.y + b.h { return false; }
    if my < b.list_y { return true; }
    let row = num_floor((my - b.list_y) / CH);
    let hits = _command_clamp(state);
    if row >= 0 and row < len(hits) {
        state.command_sel = row;
        _command_execute(state, hits[row].id);
    }
    return true;
}

// ── Quick Open: native file picker for Open / Ctrl+O ─────────────────────────
fn _path_join2(a, b) {
    return try path_join(a, b) catch (str(a) + "/" + str(b));
}

fn _path_base2(path) {
    let p = str(path);
    let last = 0 - 1;
    let i = 0;
    while i < len(p) {
        if strcharcodeat(p, i) == 47 or strcharcodeat(p, i) == 92 { last = i; }
        i = i + 1;
    }
    if last < 0 { return p; }
    if last >= len(p) - 1 { return p; }
    return str_slice(p, last + 1, len(p));
}

fn _dir_entries(dir) {
    dir = str(dir);
    let names = try fs_listdir(dir) catch [];
    let entries = [map{ name: "..", path: try path_dirname(dir) catch ".", kind: "dir" }];
    let i = 0;
    while i < len(names) and i < 400 {
        let name = str(names[i]);
        let full = _path_join2(dir, name);
        let kind = "file";
        let sub = try fs_listdir(full) catch nil;
        if sub != nil { kind = "dir"; }
        array_push(entries, map{ name: name, path: full, kind: kind });
        i = i + 1;
    }
    return entries;
}

fn _tree_indent(depth) {
    let s = "";
    let i = 0;
    while i < depth {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

fn _tree_skip_dir(name) {
    name = str(name);
    return name == ".git" or name == "target" or name == "node_modules" or name == ".cache" or name == ".mint-mcp";
}

fn _tree_push_dir(out, dir, depth, max_depth, max_items) {
    if len(out) >= max_items or depth >= max_depth { return 0; }
    let names = try fs_listdir(dir) catch [];
    let i = 0;
    while i < len(names) and len(out) < max_items {
        let name = str(names[i]);
        let full = _path_join2(dir, name);
        let kind = "file";
        let sub = try fs_listdir(full) catch nil;
        if sub != nil { kind = "dir"; }
        array_push(out, map{ name: name, path: full, kind: kind, depth: depth, display: _tree_indent(depth) + name, tree: true });
        if kind == "dir" and not _tree_skip_dir(name) {
            _tree_push_dir(out, full, depth + 1, max_depth, max_items);
        }
        i = i + 1;
    }
    return len(out);
}

fn _tree_entries(dir, max_depth, max_items) {
    dir = str(dir);
    if max_depth == nil or max_depth < 1 { max_depth = 2; }
    if max_items == nil or max_items < 20 { max_items = 200; }
    let entries = [map{ name: "..", path: try path_dirname(dir) catch ".", kind: "dir", depth: 0, display: "..", tree: true }];
    _tree_push_dir(entries, dir, 0, max_depth, max_items);
    return entries;
}

fn _quick_open_refresh(state) {
    let dir = str(try state.quick_dir catch ".");
    let entries = _dir_entries(dir);
    state.quick_entries = entries;
    return entries;
}

fn _quick_open_hits(state) {
    let search = IDE.quick_open_search_query(try state.quick_query catch "");
    return IDE.quick_open_with_recent(try state.quick_entries catch [], try state.recent_files catch [], search, 14);
}

fn _quick_open_clamp(state) {
    let hits = _quick_open_hits(state);
    if state.quick_sel < 0 { state.quick_sel = 0; }
    if len(hits) == 0 { state.quick_sel = 0; return hits; }
    if state.quick_sel >= len(hits) { state.quick_sel = len(hits) - 1; }
    return hits;
}

fn _quick_open_accept(state, hit) {
    if hit == nil {
        let raw = str_trim(try state.quick_query catch "");
        if raw == "" { return 0; }
        state.quick_open_mode = false;
        state.output = _open_path(state, raw);
        return 0;
    }
    if (try hit.kind catch "file") == "dir" {
        state.quick_dir = hit.path;
        state.quick_query = "";
        state.quick_sel = 0;
        _quick_open_refresh(state);
        state.output = "quick open: " + state.quick_dir;
        return 0;
    }
    state.quick_open_mode = false;
    let targetPath = IDE.quick_open_apply_target(hit.path, try state.quick_query catch "");
    state.quick_query = "";
    state.output = _open_path(state, targetPath);
    return 0;
}

fn _quick_open_key(state, key, shift) {
    if key == "Escape" { state.quick_open_mode = false; state.output = "quick open closed"; return 0; }
    if key == "Home" { state.quick_sel = 0; _quick_open_clamp(state); return 0; }
    if key == "End" {
        let hits = _quick_open_clamp(state);
        if len(hits) > 0 { state.quick_sel = len(hits) - 1; }
        return 0;
    }
    if key == "Down" { state.quick_sel = state.quick_sel + 1; _quick_open_clamp(state); return 0; }
    if key == "Up" { state.quick_sel = state.quick_sel - 1; _quick_open_clamp(state); return 0; }
    if key == "PageDown" { state.quick_sel = state.quick_sel + 10; _quick_open_clamp(state); return 0; }
    if key == "PageUp" { state.quick_sel = state.quick_sel - 10; _quick_open_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "N" or key == "KeyN") { state.quick_sel = state.quick_sel + 1; _quick_open_clamp(state); return 0; }
    if (try state.ctrl catch false) and (key == "P" or key == "KeyP") { state.quick_sel = state.quick_sel - 1; _quick_open_clamp(state); return 0; }
    if key == "Backspace" {
        if len(state.quick_query) > 0 { state.quick_query = str_slice(state.quick_query, 0, len(state.quick_query) - 1); }
        state.quick_sel = 0;
        return 0;
    }
    if _is_enter(key) {
        let hits = _quick_open_clamp(state);
        if len(hits) > 0 { _quick_open_accept(state, hits[state.quick_sel]); }
        else { _quick_open_accept(state, nil); }
        return 0;
    }
    let ch = K.key_to_char(key, shift);
    if ch != "" {
        state.quick_query = state.quick_query + ch;
        state.quick_sel = 0;
    }
    return 0;
}

fn _quick_open_box(sz) {
    let bw = 92 * CW;
    if bw > sz.w - 4 * PAD { bw = sz.w - 4 * PAD; }
    let bh = CH * 18 + 6 * PAD;
    if bh > sz.h - 4 * PAD { bh = sz.h - 4 * PAD; }
    let bx = (sz.w - bw) / 2;
    let by = TOP + 2 * PAD;
    if by + bh > sz.h - STATUSH { by = (sz.h - bh) / 2; }
    return map{ x: bx, y: by, w: bw, h: bh, list_y: by + CH * 4 + 4 * PAD };
}

fn _draw_quick_open(state, win, sz) {
    let b = _quick_open_box(sz);
    win.rect(0, TOP, sz.w, sz.h - TOP, _style_modal_backdrop(state));
    win.rect(b.x, b.y, b.w, b.h, _style_panel(state));
    win.rect(b.x, b.y, b.w, SCALE, _style_accent(state));
    win.rect(b.x, b.y + b.h - SCALE, b.w, SCALE, _style_border(state));
    win.rect(b.x, b.y, SCALE, b.h, _style_border(state));
    win.rect(b.x + b.w - SCALE, b.y, SCALE, b.h, _style_border(state));
    _dt(win, b.x + 2 * PAD, b.y + 2 * PAD, "Quick Open", _style_accent(state));
    let recentCount = len(try state.recent_files catch []);
    let quickHead = "recent " + str(recentCount) + "  " + IDE.file_filter_examples_line(6) + "  path:line:col or line:120 col:4  Up/Down/Pg/Home/End  Enter open  Esc close";
    _dt(win, b.x + 17 * CW, b.y + 2 * PAD, str_slice(quickHead, 0, (b.w - 19 * CW) / CW), _style_muted(state));

    let qy = b.y + CH * 2 + 3 * PAD;
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, CH + PAD, _style_surface2(state));
    win.rect(b.x + 2 * PAD, qy, b.w - 4 * PAD, SCALE, _style_border(state));
    let q = str(try state.quick_query catch "");
    let prompt = str(try state.quick_dir catch ".") + "  recent+" + str(recentCount) + "  > " + q;
    let maxPrompt = (b.w - 6 * PAD) / CW;
    let shownPrompt = str_slice(prompt, 0, maxPrompt);
    _dt(win, b.x + 3 * PAD, qy + PAD / 2, shownPrompt, _style_text(state));
    win.rect(b.x + 3 * PAD + len(shownPrompt) * CW, qy + PAD / 2, SCALE, CH - SCALE, CURSOR);

    let hits = _quick_open_clamp(state);
    let countText = str(len(hits)) + " result";
    if len(hits) != 1 { countText = countText + "s"; }
    _dt(win, b.x + b.w - 18 * CW, qy + PAD / 2, str_slice(countText, 0, 16), _style_muted(state));
    if len(hits) == 0 {
        let miss = IDE.quick_open_empty_message(q);
        _dt(win, b.x + 2 * PAD, b.list_y, str_slice(miss, 0, (b.w - 4 * PAD) / CW), _style_error(state));
        return 0;
    }
    let detail = IDE.quick_open_status(q, state.quick_sel, hits, try state.quick_dir catch ".", recentCount);
    _dt(win, b.x + 2 * PAD, b.list_y - CH - PAD / 2, str_slice(detail, 0, (b.w - 4 * PAD) / CW), _style_accent(state));
    let hint = IDE.quick_open_hint(q);
    _dt(win, b.x + 2 * PAD, b.list_y - CH * 2 - PAD / 2, str_slice(hint, 0, (b.w - 4 * PAD) / CW), _style_muted(state));
    _dt(win, b.x + 2 * PAD, b.list_y - SCALE, "NAME", _style_muted(state));
    _dt(win, b.x + 33 * CW, b.list_y - SCALE, "PATH", _style_muted(state));
    let i = 0;
    while i < len(hits) and i < 14 {
        let y = b.list_y + i * CH;
        if i == state.quick_sel { win.rect(b.x + PAD, y - SCALE, b.w - 2 * PAD, CH, _style_hilite(state)); }
        let h = hits[i];
        let nameW = 30 * CW;
        let pathX = b.x + 2 * PAD + nameW + CW;
        let pathMax = (b.x + b.w - 2 * PAD - pathX) / CW;
        let name = str(i + 1) + ". " + h.label;
        _dt(win, b.x + 2 * PAD, y, str_slice(name, 0, nameW / CW), _style_pane_text(state));
        _dt(win, pathX, y, str_slice(h.path, 0, pathMax), _style_muted(state));
        i = i + 1;
    }
    return 0;
}

fn _quick_open_click(state, mx, my) {
    if not (try state.quick_open_mode catch false) or state.winsz == nil { return false; }
    let b = _quick_open_box(state.winsz);
    if mx < b.x or mx >= b.x + b.w or my < b.y or my >= b.y + b.h { return false; }
    if my < b.list_y { return true; }
    let row = num_floor((my - b.list_y) / CH);
    let hits = _quick_open_clamp(state);
    if row >= 0 and row < len(hits) {
        state.quick_sel = row;
        _quick_open_accept(state, hits[row]);
    }
    return true;
}

fn _point_in_box(mx, my, b) {
    return mx >= b.x and mx < b.x + b.w and my >= b.y and my < b.y + b.h;
}

fn _modal_mouse_capture(state, mx, my) {
    if state.help {
        state.help = false;
        state.output = "help closed";
        return true;
    }
    if try state.goto_line_mode catch false {
        let b = _goto_line_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.goto_line_mode = false;
            state.output = "go to line closed";
        }
        return true;
    }
    if try state.open_mode catch false {
        state.open_mode = false;
        state.open_path = "";
        state.output = "open cancelled";
        return true;
    }
    if try state.save_as_mode catch false {
        state.save_as_mode = false;
        state.save_as_path = "";
        state.output = "save as cancelled";
        return true;
    }
    return false;
}

fn _any_modal_open(state) {
    if state.help { return true; }
    if try state.goto_line_mode catch false { return true; }
    if try state.open_mode catch false { return true; }
    if try state.save_as_mode catch false { return true; }
    if try state.quick_open_mode catch false { return true; }
    if try state.command_mode catch false { return true; }
    if try state.examples_mode catch false { return true; }
    return false;
}

fn _modal_backdrop_click(state, mx, my) {
    if try state.quick_open_mode catch false {
        let b = _quick_open_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.quick_open_mode = false;
            state.output = "quick open closed";
        }
        return true;
    }
    if try state.command_mode catch false {
        let b = _command_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.command_mode = false;
            state.output = "command palette closed";
        }
        return true;
    }
    if try state.examples_mode catch false {
        let b = _example_box(state.winsz);
        if not _point_in_box(mx, my, b) {
            state.examples_mode = false;
            state.output = "examples closed";
        }
        return true;
    }
    return _modal_mouse_capture(state, mx, my);
}

fn _apply_event_modifiers(state, e) {
    let v = try e.shift catch nil;
    if v != nil { state.shift = v; }
    v = try e.ctrl catch nil;
    if v != nil { state.ctrl = v; }
    v = try e.alt catch nil;
    if v != nil { state.alt = v; }
    v = try e.meta catch nil;
    if v != nil { state.meta = v; }
    return 0;
}

// ── shortcuts overlay (F1) — ported from the web IDE's #shortcuts-overlay ─────────
let HELP = [
    "pblang IDE  -  KEYBOARD SHORTCUTS            F1 or Esc to close",
    "",
    "GLOBAL    click Code/Term/AI/Designer/Browser/Files/Out/Prob/Hist/Manage to switch panels",
    "          F2 Code   F3 Terminal   F4 Designer   F7 AI   F9 History   F10 Browser",
    "          Ctrl+1..9/Ctrl+0 switch panel strip left-to-right",
    "          tabs compact to 1C/2T/3A... when needed to keep actions usable",
    "          Ctrl+Tab / Ctrl+Shift+Tab cycle panels; Ctrl+PgDn / Ctrl+PgUp too",
    "          Ctrl+P command palette     F1 toggle this help",
    "",
    "CODE      F5 run    F6 check    Ctrl+G go to line    F8 next diagnostic",
    "          Shift+F8 previous diagnostic",
    "          Alt+Left / Alt+Right navigate jump history",
    "          Ctrl+N new buffer    Ctrl+S save    Ctrl+Shift+S Save As",
    "          Ctrl+O Quick Open    Ctrl+F find",
    "          Tab indent selection or insert spaces    Shift+Tab outdent",
    "          Ctrl+Shift+D duplicate line    Ctrl+Shift+K delete line",
    "          Alt+Up / Alt+Down move current line",
    "          Ctrl+/ toggle line comment",
    "          F11 toggle Debug/Release mode    F12 toggle watcher",
    "          Ex opens searchable examples picker",
    "          Quick Open: recent files first, type filter, Enter open/enter-dir, Esc close",
    "          Ctrl+Z / Ctrl+Y  undo / redo     Ctrl+C/X/V  copy/cut/paste",
    "          Ctrl+C/X without selection copies/cuts the current line",
    "          Ctrl+A select all     arrows move     hold a key to repeat",
    "          Ctrl+Left/Right word jump    Ctrl+Up/Down 5 lines",
    "          Ctrl+Home/End document edge   Shift+arrow select   PgUp/PgDn",
    "",
    "TERMINAL  type + Enter run a command    Shift+Enter newline    'clear'",
    "",
    "DESIGN    pick a palette tool   click canvas to place   drag/arrows move on grid",
    "          Ctrl+arrows resize   Tab/Shift+Tab select   Insert duplicate",
    "          Ctrl+[ / Ctrl+] layer   Shift sends back/front   type edit text   Del delete",
    "",
    "AI        type + Enter ask pbAI    Shift+Enter newline",
    "          EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT / DIAG run pbAI",
    "          INSERT places the last pbAI answer into the code editor",
    "",
    "BROWSER   URL + Enter load    Live/Reader/Source/Inspect are pblang-native",
    "          Up/Down/PgUp/PgDn scroll; Host is optional external screenshot fallback",
    "",
    "HISTORY   run/check snapshots mirror the web IDE; click a row to restore code",
    "          S toggles Temporary/Permanent; Ctrl+S saves; C/footer clears history",
    "MANAGE    database/storage/files/browser/AI/backups dashboard; Enter opens area",
    "FILES     type filter   Tab flat/tree/recent   Ctrl+/- tree depth   Enter open/dir",
    "          Backspace up   Ctrl+R refresh",
    "          Ctrl+Left/Right roots   Ctrl+H/L roots   Ctrl+B bookmark current dir",
    "          Ctrl+Shift+B labels current root from filter; Ctrl+Shift+G cycles root group",
    "          Recent mode: Delete remove selected   Ctrl+Delete clear recent",
    "          Ctrl+P exposes Files Flat/Tree/Recent and Reveal current file",
    "OUTLINE   type to filter symbols   Up/Down select   Enter/click jump",
    "PROBLEMS  Enter/click action or diagnostic   F6 refresh   Esc code",
    "",
    "MODE      Debug checks before run; Release runs directly. Watcher tracks rev/dirty/diags.",
    "UI        Ctrl+P -> UI snapshot prints structured layout/UX observer lines.",
    "STYLE     click Style to cycle Web / Smooth / Contrast / Pixel palettes.",
    "THEME     click Theme or Ctrl+P Theme to toggle Light / Dark.",
    "          Web + Dark is default; Light matches the web IDE preference control.",
    "",
    "Launch from a shell with:   pblang --ide",
];
fn _draw_help(state, win, sz) {
    win.clear(_style_modal_backdrop(state));                  // modal backdrop
    let maxw = 0;
    let i = 0;
    while i < len(HELP) { if len(HELP[i]) > maxw { maxw = len(HELP[i]); } i = i + 1; }
    let bw = maxw * CW + 4 * PAD;
    let bh = len(HELP) * CH + 4 * PAD;
    let bx = (sz.w - bw) / 2; if bx < 0 { bx = 0; }
    let by = (sz.h - bh) / 2; if by < 0 { by = 0; }
    win.rect(bx, by, bw, bh, _style_panel(state));
    win.rect(bx, by, bw, SCALE, _style_accent(state));
    win.rect(bx, by + bh - SCALE, bw, SCALE, _style_accent(state));
    win.rect(bx, by, SCALE, bh, _style_accent(state));
    win.rect(bx + bw - SCALE, by, SCALE, bh, _style_accent(state));
    let r = 0;
    while r < len(HELP) {
        let col = _style_pane_text(state);
        if r == 0 { col = _style_accent(state); }
        _dt(win, bx + 2 * PAD, by + 2 * PAD + r * CH, HELP[r], col);
        r = r + 1;
    }
}

// top-level draw: clear, toolbar, then the active panel.
fn _draw(state, win) {
    win.clear(_style_bg(state));
    let sz = win.size();
    state.winsz = sz;                 // cached for mouse → buffer-position mapping
    state.ui_snapshot = _ui_snapshot(state, sz);
    _refresh_watcher(state, "draw");
    _draw_toolbar(state, win, sz);
    if state.panel == "code" { _draw_code(state, win, sz); }
    else if state.panel == "term" { _draw_term(state, win, sz); }
    else if state.panel == "design" { _draw_design(state, win, sz); }
    else if state.panel == "ai" { _draw_ai(state, win, sz); }
    else if state.panel == "web" { _draw_web(state, win, sz); }
    else if state.panel == "files" { _draw_files(state, win, sz); }
    else if state.panel == "outline" { _draw_outline(state, win, sz); }
    else if state.panel == "problems" { _draw_problems(state, win, sz); }
    else if state.panel == "hist" { _draw_history(state, win, sz); }
    else if state.panel == "manage" { _draw_manage(state, win, sz); }
    if try state.examples_mode catch false { _draw_examples(state, win, sz); }
    if try state.command_mode catch false { _draw_command_palette(state, win, sz); }
    if try state.quick_open_mode catch false { _draw_quick_open(state, win, sz); }
    if try state.goto_line_mode catch false { _draw_goto_line(state, win, sz); }
    if state.help { _draw_help(state, win, sz); }     // modal overlay, drawn last (on top)
    win.present();
}

// mouse → buffer position. Maps a pixel (mx,my) in the editor area to (row,col), using the
// SAME layout math as _draw: row r sits at y = TOP + (r - scroll)*CH, text starts at GUTTERX.
// Returns nil for clicks outside the editor area (e.g. on the output pane).
fn _mouse_pos(state, mx, my) {
    let ed = state.ed;
    let sz = state.winsz;
    if sz != nil {
        if my >= sz.h - STATUSH { return nil; }
        let editorW = sz.w - _code_output_w_state(state, sz) - SCALE * 3;
        if mx >= editorW { return nil; }
    }
    let vr = (my - TOP) / CH;
    vr = num_floor(vr);
    if vr < 0 { vr = 0; }
    let row = ed.scroll + vr;
    let col = 0;
    if mx > GUTTERX { col = num_floor((mx - GUTTERX + CW / 2) / CW); }  // round to nearest gap
    return map{ row: row, col: col };
}

// place the caret at the mouse, optionally extending the selection (drag).
fn _mouse_place(state, mx, my, extend) {
    let p = _mouse_pos(state, mx, my);
    if p == nil { return 0; }
    let ed = state.ed;
    if extend { if ed.anchor == nil { E.set_anchor(ed); } } else { E.clear_selection(ed); }
    E.set_cursor(ed, p.row, p.col);
    return 0;
}

fn main() {
    // Window is glyph-aware but has web-IDE-like minimum dimensions. With SCALE=1 the
    // UI is cleaner/less blocky; users can raise PBIDE_SCALE without getting a tiny
    // viewport.
    let winw = GUTTERX + 5 * CW + 100 * CW + PAD;
    let winh = TOP + 40 * CH + PANEH;
    if winw < 1280 { winw = 1280; }
    if winh < 760 { winh = 760; }
    let win = gfx.Window(winw, winh, "pblang IDE - Smart Code Editor");
    let cwd0 = try env_get("PWD") catch ".";
    if cwd0 == nil { cwd0 = "."; }
    let ed0 = E.new(_starter_code());
    let path0 = _fallback_path();
    let roots0 = _files_load_saved_roots(cwd0, path0);
    let rootMeta0 = _files_load_saved_root_meta();
    let hist0 = _history_load_persistent();
    let histMode0 = "temporary";
    if len(hist0) > 0 { histMode0 = "permanent"; }
    let state = map{
        panel: "code",                                   // active toolbar tab
        ed: ed0,
        shift: false, ctrl: false, alt: false, meta: false, find_mode: false, query: "", goto_line_mode: false, goto_line_input: "",
        replace_mode: false, replace_text: "", replace_focus: "find",
        rows: 40, path: path0, last: "other",
        file_profile: IDE.editor_asset_profile(path0), preview_mode: "syntax", preview_path: "",
        tokens: nil, syntax_hash: "", dirty: true, redraw: true, syntax_status: "",
        build_mode: "debug", watch_enabled: true, watch: IDE.watcher_new(path0, E.text(ed0)),
        open_mode: false, open_path: "", save_as_mode: false, save_as_path: "",
        quick_open_mode: false, quick_query: "", quick_sel: 0, quick_dir: cwd0, quick_entries: [],
        recent_files: [],
        files: map{ dir: cwd0, roots: roots0, root_meta: rootMeta0, root_index: IDE.project_root_index(roots0, cwd0), query: "", sel: 0, mode: "flat", tree_depth: 3, tree_max: 600, entries: [], clipboard: nil, remote: IDE.file_transfer_profile("remote", "", "", "sftp") },
        database: map{ profiles: [], migrations: [], backups: [] },
        outline: map{ query: "", sel: 0 },
        problems: map{ sel: 0, query: "" },
        manage: map{ query: "", sel: 0 },
        examples_mode: false, example_query: "", example_sel: 0,
        command_mode: false, command_query: "", command_sel: 0,
        mx: 0, my: 0, mdown: false, split_drag: false, winsz: nil, outw: 34 * CW, ui_snapshot: nil, ui_events: [],
        style: "web", theme: "dark",
        term: map{ cwd: cwd0, input: "", lines: ["pblang terminal — runs real PC commands (needs --allow-exec). Try: ls, pwd, cd .."], cmd_history: [], hist_pos: 0, hist_draft: "" },
        design: map{ tool: "button", target: "gui", layout: "free", widgets: [], sel: 0 - 1, drag: false, dx: 0, dy: 0, counter: 0 },
        ai: map{ input: "", last_response: "", prompt_history: [], hist_pos: 0, hist_draft: "", lines: ["pbAI — pblang's own assistant (no network, no Ollama). Type a question + Enter,", "or use EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT / DIAG, then INSERT the last answer."] },
        web: map{ input: "example.com", url: "", title: "", mode: "live", security: "safe", tor: false, status: "safe", scroll: 0, history: [], forward: [], bookmarks: [], download_plans: [], search_engine: "duckduckgo", home: "example.com", find_query: "", page_obj: nil, page: ["pblang browser - type a URL + Enter to load. Live/Reader/Links/Forms/Source/Inspect/Host modes."], reader: ["pblang browser - type a URL + Enter to load. Up/Down scroll."], links: [], forms: ["No forms loaded."], form_sel: 0, form_field_sel: 0, form_values: map{}, source: ["No source loaded."], inspect: ["No inspector details loaded."], render_img: nil, render_path: "", render_lines: ["Host mode: switch security to Trusted or JS/DOM, enter a URL, click Host. Needs --allow-exec and chromium/google-chrome/brave/firefox."], lines: ["pblang browser - type a URL + Enter to load. Up/Down scroll."] },
        diagnostics: [],
        diag_index: 0 - 1,
        nav_back: [], nav_forward: [],
        history: hist0,
        history_mode: histMode0,
        history_stored: len(hist0) > 0,
        help: false,                                     // F1 shortcuts overlay
        output: "ready · click to place cursor · drag to select · F5 run · F6 check · F1 help"
    };
    gfx.run(win, state,
        fn(s, events) {
            let i = 0;
            while i < len(events) {
                let e = events[i];
                if e.type == "keydown" {
                    s.redraw = true;            // any keypress means the view may have changed
                    _apply_event_modifiers(s, e);
                    if e.key == "F1" { s.help = not s.help; }                          // toggle the shortcuts overlay
                    else if s.help { if e.key == "Escape" { s.help = false; } }         // while open, only Esc/F1 act
                    else if K.is_shift(e.key) { s.shift = true; }
                    else if K.is_ctrl(e.key) { s.ctrl = true; }
                    else if K.is_alt(e.key) { s.alt = true; }
                    else if K.is_meta(e.key) { s.meta = true; }
                    else if try s.open_mode catch false { let st = _key(s, e.key); if st != "" { s.output = st; } }
                    else if try s.save_as_mode catch false { let st = _key(s, e.key); if st != "" { s.output = st; } }
                    else if try s.quick_open_mode catch false { _quick_open_key(s, e.key, s.shift); }
                    else if try s.goto_line_mode catch false { _goto_line_key(s, e.key, s.shift); }
                    else if try s.command_mode catch false { _command_key(s, e.key, s.shift); }
                    else if try s.examples_mode catch false { _examples_key(s, e.key, s.shift); }
                    else if s.alt and e.key == "Left" { _nav_back(s); }
                    else if s.alt and e.key == "Right" { _nav_forward(s); }
                    else if s.ctrl and e.key == "G" { _open_goto_line(s); }
                    else if s.ctrl and e.key == "P" { _open_command_palette(s); }
                    else if s.ctrl and _panel_shortcut(s, e.key) { }
                    else if s.ctrl and s.shift and e.key == "Tab" { _panel_step(s, 0 - 1); }
                    else if s.ctrl and (e.key == "Tab" or e.key == "PageDown") { _panel_step(s, 1); }
                    else if s.ctrl and (e.key == "PageUp" or e.key == "BackTab") { _panel_step(s, 0 - 1); }
                    else if e.key == "F5" { s.panel = "code"; _run_action(s); }
                    else if e.key == "F6" { s.panel = "code"; _check_action(s); }
                    else if e.key == "F11" { _mode_toggle(s); }
                    else if e.key == "F12" { _watch_toggle(s); }
                    else if e.key == "F2" { s.panel = "code"; }
                    else if e.key == "F3" { s.panel = "term"; }
                    else if e.key == "F4" { s.panel = "design"; }
                    else if e.key == "F7" { s.panel = "ai"; }
                    else if e.key == "F8" {
                        let dd = 1;
                        if s.shift { dd = 0 - 1; }
                        _diagnostic_goto(s, dd);
                    }
                    else if e.key == "F10" { s.panel = "web"; }
                    else if e.key == "F9" { s.panel = "hist"; }
                    else if s.panel == "term" { _term_key(s, e.key, s.shift); }        // terminal owns its input line
                    else if s.panel == "design" { _design_key(s, e.key, s.shift); }    // designer: edit/delete selected widget
                    else if s.panel == "ai" { _ai_key(s, e.key, s.shift); }            // AI panel owns its question box
                    else if s.panel == "web" { _web_key(s, e.key, s.shift); }          // browser owns its address bar
                    else if s.panel == "files" { _files_key(s, e.key, s.shift); }
                    else if s.panel == "outline" { _outline_key(s, e.key, s.shift); }
                    else if s.panel == "problems" { _problems_key(s, e.key, s.shift); }
                    else if s.panel == "hist" { _history_key(s, e.key, s.shift); }
                    else if s.panel == "manage" { _manage_key(s, e.key, s.shift); }
                    else if s.panel == "code" { let st = _key(s, e.key); if st != "" { s.output = st; } }
                }
                if e.type == "keyup" {
                    _apply_event_modifiers(s, e);
                    if K.is_shift(e.key) { s.shift = false; }
                    if K.is_ctrl(e.key) { s.ctrl = false; }
                    if K.is_alt(e.key) { s.alt = false; }
                    if K.is_meta(e.key) { s.meta = false; }
                }
                // mousedown carries no coords (like gui.sapp) — use the tracked cursor.
                if e.type == "mousemove" {
                    s.mx = e.x; s.my = e.y;
                    if s.split_drag {
                        _resize_output_pane(s, e.x);
                        s.redraw = true;
                    }
                    if s.mdown and s.panel == "code" { _mouse_place(s, e.x, e.y, true); s.redraw = true; }  // drag = extend selection
                    if s.panel == "design" and s.design.drag and s.design.sel >= 0 {                       // drag = move widget
                        let w = s.design.widgets[s.design.sel];
                        w.x = e.x - s.design.dx; w.y = e.y - s.design.dy;
                        _design_snap_widget(s, w, false);
                        _design_clamp_widget(s, w);
                        s.redraw = true;
                    }
                }
                if e.type == "mousedown" and (try e.button catch "Left") == "Left" {
                    // Prefer the click's OWN coordinates (the host now attaches x/y to
                    // mousedown); fall back to the tracked cursor only if absent. Using a
                    // stale tracked position is what made tab clicks land on random tabs.
                    let dx = try e.x catch s.mx;
                    let dy = try e.y catch s.my;
                    s.mx = dx; s.my = dy;
                    _ui_event(s, "mouse " + str(dx) + "," + str(dy) + " panel=" + str(s.panel));
                    let captured = false;
                    if _modal_mouse_capture(s, dx, dy) { captured = true; }
                    if not captured and try s.quick_open_mode catch false { captured = _quick_open_click(s, dx, dy); }
                    if not captured and try s.command_mode catch false { captured = _command_click(s, dx, dy); }
                    if not captured and try s.examples_mode catch false { captured = _examples_click(s, dx, dy); }
                    if not captured and _any_modal_open(s) { captured = _modal_backdrop_click(s, dx, dy); }
                    if captured { s.redraw = true; }
                    else {
                    let tab = _toolbar_hit(dx, dy, s.winsz);
                    if tab != nil { _toolbar_click(s, tab); s.redraw = true; }         // web-style toolbar action
                    else if _splitter_hit(s, dx, dy) {
                        s.split_drag = true;
                        _resize_output_pane(s, dx);
                        s.redraw = true;
                    }
                    else {
                        s.mdown = true;
                        if s.panel == "code" {
                            if not _diagnostic_click(s, dx, dy) and not _watcher_click(s, dx, dy) and not _ui_observer_click(s, dx, dy) { _mouse_place(s, dx, dy, false); }
                        }       // click = place caret, diagnostic, or watcher action
                        else if s.panel == "design" { _design_click(s, dx, dy); }      // place/select a widget
                        else if s.panel == "ai" { let act = _ai_hit(dx, dy); if act != nil { _ai_action(s, act); } }  // quick action
                        else if s.panel == "web" { _web_click(s, dx, dy); }
                        else if s.panel == "files" { _files_click(s, dx, dy); }
                        else if s.panel == "outline" { _outline_click(s, dx, dy); }
                        else if s.panel == "problems" { _problems_click(s, dx, dy); }
                        else if s.panel == "hist" { _history_click(s, dx, dy); }
                        else if s.panel == "manage" { _manage_click(s, dx, dy); }
                        s.redraw = true;
                    }
                    }
                }
                if e.type == "mouseup" { s.mdown = false; s.split_drag = false; s.design.drag = false; }
                i = i + 1;
            }
        },
        // Only repaint when something changed (idle frames are nearly free). The first
        // frame draws because redraw starts true.
        fn(s, w) { if s.redraw { _draw(s, w); s.redraw = false; } },
        20);
}
main();
