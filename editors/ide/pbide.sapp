// editors/ide/pbide.sapp — the pblang-NATIVE IDE (no HTML / CSS / JS).
//
// A code editor drawn entirely by pblang: a native window (graphics.sapp → minifb/SDL2),
// the editor model (editor_model.sapp), native anti-aliased text with bitmap fallback, shift/
// ctrl-aware input (keymap.sapp), syntax highlighting via the self-hosted tokenizer
// (syntax_hl.sapp), a scrolling viewport, selection, clipboard, undo/redo, find, save,
// run/check, and an output pane. No browser, no DOM, no JS engine — the "total security"
// point (docs/PB_IDE.md, docs/PrjAnalysis.md §90/§91).
//
// Run (needs a display):  ./target/debug/pblang run editors/ide/pbide.sapp --allow-all
// Keys: type to edit · arrows/Home/End/PgUp/PgDn (Shift = select) · Enter/Backspace/Tab
//       Ctrl+C/X/V copy/cut/paste · Ctrl+Z/Y undo/redo · Ctrl+A select-all · Ctrl+S save
//       Ctrl+F find (type, Enter=next, Esc=close) · F5 run · F6 check.
//
// The editor model, font, keymap, and highlighting are tested in the VM. All pblang.

let gfx = import("stdlib/graphics.sapp");
let E = import("stdlib/editor_model.sapp");
let F = import("stdlib/bitmap_font.sapp");
let TL = import("stdlib/text_layout.sapp");
let K = import("stdlib/keymap.sapp");
let H = import("stdlib/syntax_hl.sapp");
let FMT = import("stdlib/compiler/formatter.sapp");
let MSYM = import("stdlib/math_symbols.sapp");
let IDE = import("stdlib/ide_features.sapp");   // web-IDE features: outline / find-replace / status
let PRODUCT = import("stdlib/pbide_product.sapp"); // shared identity, actions, panels and edition evidence
let UIO = import("stdlib/ui_observer.sapp");    // structured UI snapshots for watcher/agent debugging
// The self-hosted frontend (F5 run / F6 check) is imported at TOP LEVEL on purpose:
// top-level imports resolve relative to this script's project root, so they work no
// matter the CWD. A *lazy* import() inside a function resolves relative to the CWD and
// fails unless launched from the repo root — which is what used to crash F5/F6.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
// The Visual Designer panel reuses the pblang GUI toolkit's widget constructors and
// hit-testing (stdlib/gui.sapp) — placed widgets ARE gui widget maps, so the generated
// code is real gui.sapp calls (a true design↔code round-trip, all pblang).
let G = import("stdlib/gui.sapp");
let GP = import("stdlib/gui_parse.sapp");
let DE = import("stdlib/design_engine.sapp");
let VE = import("stdlib/visual_engine.sapp");
// The AI panel is backed by pbAI — pblang's own assistant (stdlib/pbai.sapp): a neural
// intent classifier + pblang-grounded skills. No external model, no network, no Ollama.
let AI = import("stdlib/pbai.sapp");
// The Browser panel renders web pages with the pblang-native browser (stdlib/browser.sapp):
// http_get → strip tags → text + links, drawn with the bitmap font. No HTML engine.
let B = import("stdlib/browser.sapp");
// Optional exact visual snapshots use an installed Chromium/Chrome-like renderer through
// stdlib/browser_render.sapp. It is explicit (Render tab), policy-checked, and needs
// --allow-exec; the safe pblang reader remains the default browser path.
let BR = import("stdlib/browser_render.sapp");
let IMG = import("stdlib/img_load.sapp");
// New pblang-native UI/graphics libraries this IDE now builds on:
let TH = import("stdlib/theme.sapp");       // role-based color themes (dark/light, WCAG)
let WEB = import("stdlib/web_engine.sapp"); // fetch->parse->layout->paint web engine
let FLEX = import("stdlib/flexbox.sapp");   // row/column layout (toolbars, status bar)
let CANVAS = import("stdlib/canvas.sapp");  // renderer-agnostic draw-command buffer
let DOCX = import("stdlib/doc_export.sapp");// page -> markdown/text/html exporter
let UIK = import("stdlib/ui_kit.sapp");     // modern widget geometry: rounded cards/pills/elevation
let WP = import("stdlib/window_probe.sapp");// pblang-only live OS window size probe (X11 tools)
let GATE = import("stdlib/frame_gate.sapp");// pure repaint policy: skip idle/no-change frames (CPU saver)
let EFFECTS = import("stdlib/pbide_effect_admission.sapp"); // fail-closed Open/Save/Run/Terminal gate

let PBIDE_TITLE = "pblang IDE - Smart Code Editor";

// Direct effects are a compatibility path, never authentication or a sandbox.
// The canonical `pblang ide` launcher denies environment access, so it remains
// untrusted by default. A local operator running the source directly must opt in
// with both environment capability and PBIDE_UNSAFE_LOCAL_EFFECTS=1.
fn _effect_mode_from_environment() {
    let selected = try env_get("PBIDE_UNSAFE_LOCAL_EFFECTS") catch "";
    if str(selected) == "1" { return EFFECTS.UNSAFE_COMPAT_MODE; }
    return EFFECTS.UNTRUSTED_MODE;
}

let PBIDE_EFFECT_MODE = _effect_mode_from_environment();

fn _effect_gate(operation) {
    return EFFECTS.gate(PBIDE_EFFECT_MODE, operation);
}

fn _effect_block(operation) {
    let decision = _effect_gate(operation);
    if try decision.allowed catch false { return nil; }
    return str(operation) + " blocked: broker_required (PBIDE untrusted mode; "
        + "direct local compatibility requires PBIDE_UNSAFE_LOCAL_EFFECTS=1 and remains unsafe)";
}

// ── Palette — DATA-DRIVEN from stdlib:theme.sapp (modern, futuristic dark) ─────────
// Every color is derived from one THEME object via its semantic roles, so the whole
// scheme can be swapped (theme.dark()/light()) from a single place. Constant NAMES are
// unchanged, so every existing draw call-site keeps working.
let THEME = TH.dark();
fn _trole(name) { let c = TH.role(THEME, name); return gfx.rgb(c.r, c.g, c.b); }
let BG = _trole("bg");              // main editor background (deep blue-black)
let FG = _trole("fg");              // primary text (soft white)
let CURSOR = _trole("cursor");      // caret (electric violet accent)
let GUTTER = _trole("gutter");      // line numbers (muted)
let HILITE = _trole("selection");   // selection / search highlight
let PANEBG = _trole("panel_bg");    // side/bottom panels (near-black)
let PANEL2 = _trole("panel_2");     // secondary panel fill
let SURFACE = _trole("surface");    // elevated surface (cards/inputs)
let SURFACE2 = _trole("surface2");  // hovered / raised surface
let BORDER = _trole("border");      // hairline borders
let PANEFG = _trole("panel_fg");    // panel accent text (mint/cyan)
let GUTTERBG = _trole("gutter_bg"); // gutter background
let CURROW = _trole("current_line");// current-line highlight

// ── Auto-scaling: fit the UI to whatever display the IDE is launched on ───────────
// At a fixed scale of 1 the bitmap font is ~7px tall — fine on a 768p laptop, but
// microscopic on a 4K panel. So we detect the screen resolution once at startup and
// pick a scale that keeps text comfortable everywhere. PBIDE_SCALE always overrides.

// _parse_wh(text) — first "<W>x<H>" pixel pair in text (tolerates spaces and 'X'),
// e.g. xrandr's "3840x2160" or macOS's "3840 x 2160". Returns {w,h} or nil.

fn _parse_wh(text) {
    let DIG = "0123456789";
    let n = len(text);
    let i = 0;
    while i < n {
        let j = i;
        let a = "";
        while j < n and str_index_of(DIG, str_slice(text, j, j + 1)) >= 0 {
            a = a + str_slice(text, j, j + 1); j = j + 1;
        }
        if len(a) >= 3 {
            let k = j;
            while k < n and str_slice(text, k, k + 1) == " " { k = k + 1; }
            let xch = "";
            if k < n { xch = str_slice(text, k, k + 1); }
            if xch == "x" or xch == "X" {
                k = k + 1;
                while k < n and str_slice(text, k, k + 1) == " " { k = k + 1; }
                let b = "";
                while k < n and str_index_of(DIG, str_slice(text, k, k + 1)) >= 0 {
                    b = b + str_slice(text, k, k + 1); k = k + 1;
                }
                if len(b) >= 3 { return map{ w: parse_number(a), h: parse_number(b) }; }
            }
        }
        i = i + 1;
    }
    return nil;
}

// _detect_wh() — best-effort current display resolution via an OS query (the IDE runs
// with --allow-all, so exec is available). X11/Wayland: xrandr/xdpyinfo; macOS:
// system_profiler; Windows: PowerShell + WMI. Returns {w,h} or nil on any failure.

fn _detect_wh() {
    let os = try platform() catch "unknown";
    let cmd = "bash";
    let argv = ["-c", "xrandr 2>/dev/null | grep -E '\\*' | head -1; xdpyinfo 2>/dev/null | grep -i dimensions | head -1"];
    if os == "windows" {
        cmd = "powershell";
        argv = ["-NoProfile", "-Command", "$v=Get-CimInstance Win32_VideoController | Where-Object { $_.CurrentHorizontalResolution } | Select-Object -First 1; if ($v) { Write-Output ($v.CurrentHorizontalResolution.ToString()+'x'+$v.CurrentVerticalResolution.ToString()) }"];
    }
    if os == "macos" {
        argv = ["-c", "system_profiler SPDisplaysDataType 2>/dev/null | grep -i Resolution | head -1"];
    }
    let r = try proc_spawn_wait(cmd, argv) catch nil;
    if r == nil { return nil; }
    let out = try r.stdout catch "";
    if out == nil { out = ""; }
    return _parse_wh(out);
}

// _scale_for(wh) — choose a compact modern UI scale from the display/window HEIGHT.
// 1080p/1440p-class screens now stay at 1 so PBIDE feels less pixelated; 4K-class
// screens use 2, and very large/5K+ displays can use 3. PBIDE_SCALE still overrides.

fn _scale_for(wh) {
    if wh == nil { return 1; }
    let h = try wh.h catch 0;
    if h == nil { h = 0; }
    if h >= 3000 { return 3; }
    if h >= 1900 { return 2; }
    return 1;
}

// The detected display (queried once at startup) and the auto-chosen UI scale.
let DISPLAY = _detect_wh();

// _scale() — PBIDE_SCALE wins (1..8); otherwise auto-fit to the current display so the
// IDE is never microscopic on a 4K panel nor oversized on a small laptop.

fn _scale() {
    let s = try parse_number(env_get("PBIDE_SCALE")) catch 0;
    if s != nil and s >= 1 {
        if s > 8 { return 8; }
        return num_floor(s);
    }
    return _scale_for(DISPLAY);
}
let SCALE = _scale();
let CW = 6 * SCALE;                  // glyph advance  (font is 5 wide + 1 space)
let CH = 8 * SCALE;                  // line height    (font is 7 tall + 1 gap)
let PAD = 3 * SCALE;                 // compact chrome padding (denser modern layout)
let GUTTERX = PAD + 5 * CW;          // source text starts here (5-char line-number gutter)
let TBH = CH + 3 * PAD;              // web-IDE-style action toolbar height
let TOP = TBH + PAD;                 // editor/content area starts BELOW the toolbar
let STATUSH = CH + 2 * PAD;          // bottom status bar
let PANEH = STATUSH;                 // kept for old mouse/layout call-sites
let TOKEN_CHAR_LIMIT = 80000;        // keep huge buffers responsive: plain text past this
let DESIGN_GRID = 4 * SCALE;         // Designer snap unit for clean mouse/key layout edits

let RAD = 3 * SCALE;                 // corner radius for rounded chips/cards/buttons
let RAD_LG = 5 * SCALE;              // larger radius for panels/cards (matches _set_density)

fn _set_density(scale) {
    let s = try parse_number(str(scale)) catch 1;
    if s == nil { s = 1; }
    s = num_floor(s);
    if s < 1 { s = 1; }
    if s > 4 { s = 4; }
    SCALE = s;
    CW = 6 * SCALE;
    CH = 8 * SCALE;
    PAD = 3 * SCALE;
    GUTTERX = PAD + 5 * CW;
    TBH = CH + 3 * PAD;
    TOP = TBH + PAD;
    STATUSH = CH + 2 * PAD;
    PANEH = STATUSH;
    DESIGN_GRID = 4 * SCALE;
    RAD = 3 * SCALE;
    RAD_LG = 5 * SCALE;
    return SCALE;
}

fn _scale_override() {
    let s = try parse_number(env_get("PBIDE_SCALE")) catch 0;
    if s != nil and s >= 1 {
        if s > 8 { return 8; }
        return num_floor(s);
    }
    return nil;
}

fn _density_for_size(sz) {
    let forced = _scale_override();
    let d = IDE.ide_responsive_density(try sz.w catch 0, try sz.h catch 0, forced);
    return try d.scale catch 1;
}

fn _density_for_state_size(state, sz) {
    let forced = try state.density_manual catch nil;
    if forced == nil { forced = _scale_override(); }
    let d = IDE.ide_responsive_density(try sz.w catch 0, try sz.h catch 0, forced);
    return try d.scale catch 1;
}

fn _density_basis_for_state(state, fallback) {
    let win = try state.live_winsz catch fallback;
    let mon = try state.display_winsz catch nil;
    return WP.display_size_for_window(win, mon);
}

fn _apply_live_density(state, sz) {
    let next = _density_for_state_size(state, sz);
    if next != SCALE {
        _set_density(next);
        if state != nil {
            state.density_scale = SCALE;
            state.output = "ui density: live scale " + str(SCALE) + " for " + str(try sz.w catch "?") + "x" + str(try sz.h catch "?");
        }
        return true;
    }
    return false;
}
_set_density(SCALE);

fn _text_mode() {
    let v = try env_get("PBIDE_TEXT_RENDER") catch "";
    if v == nil { return "smooth"; }
    v = str_lower(str(v));
    if v == "bitmap" or v == "pixel" or v == "off" { return "bitmap"; }
    return "smooth";
}
let TEXT_MODE = _text_mode();
let TEXT_PROFILE = try gfx.text_profile() catch map{ renderer: "bitmap-font", antialias: false, available: false, font: "" };
let TEXT_AA_READY = TEXT_MODE != "bitmap" and (try TEXT_PROFILE.available catch false);
let TEXT_SHAPE_CACHE = map{};
let TEXT_SHAPE_CACHE_KEYS = [];
let TEXT_SHAPE_CACHE_LIMIT = 512;
let TEXT_FRAME_CALLS = 0;
let TEXT_FRAME_SKIPS = 0;
let TEXT_FRAME_AA = 0;
let TEXT_FRAME_BITMAP = 0;
let ROUND_RECT_CACHE = map{};
let ROUND_RECT_CACHE_KEYS = [];
let ROUND_RECT_CACHE_LIMIT = 256;
let ELEVATION_CACHE = map{};
let ELEVATION_CACHE_KEYS = [];
let ELEVATION_CACHE_LIMIT = 128;
let DESIGN_GRID_CACHE = map{};
let DESIGN_GRID_CACHE_KEYS = [];
let DESIGN_GRID_CACHE_LIMIT = 64;

fn _density_status(sz, manual) {
    let d = IDE.ide_responsive_density(try sz.w catch 0, try sz.h catch 0, manual);
    return "ui density " + str(try d.scale catch SCALE) + "x " + str(try d.density catch "?") + " (" + str(try d.source catch "?") + ": " + str(try d.reason catch "?") + ")";
}

fn _window_probe_status(state) {
    if try state.window_probe_enabled catch false {
        let sz = try state.live_winsz catch nil;
        let mon = try state.display_winsz catch nil;
        if sz != nil {
            let out = "probe on " + str(try sz.w catch "?") + "x" + str(try sz.h catch "?");
            if mon != nil and (try state.monitor_probe_enabled catch false) { out = out + " @" + str(try mon.w catch "?") + "x" + str(try mon.h catch "?"); }
            return out;
        }
        return "probe on";
    }
    return "probe off";
}

fn _graphics_status() {
    let s = try gfx.backend_status() catch "gfx unknown";
    let tr = try TEXT_PROFILE.renderer catch "bitmap-font";
    if TEXT_MODE == "bitmap" { tr = "bitmap-font"; }
    return s + " · text " + str(tr) + "+pblang-shape cache " + str(len(TEXT_SHAPE_CACHE_KEYS));
}

fn _graphics_event_status() {
    let s = try gfx.backend_event_status() catch nil;
    if s != nil { return str(s); }
    let p = try gfx.backend_profile() catch nil;
    if p == nil { return "events unknown"; }
    let items = [];
    if try p.resize_events catch false { array_push(items, "resize"); }
    if try p.mouse_xy_events catch false { array_push(items, "mouse-xy"); }
    if try p.scroll_events catch false { array_push(items, str(try p.scroll_event catch "scroll")); }
    let body = "none";
    if len(items) > 0 { body = str_join(items, ","); }
    return "events " + str(try p.event_contract catch "unknown") + " [" + body + "]";
}

fn _graphics_short_status() {
    let p = try gfx.backend_profile() catch nil;
    if p == nil { return "gfx ?"; }
    let gpu = "cpu";
    if try p.gpu_present catch false { gpu = "gpu"; }
    return "gfx " + str(try p.backend catch "?") + "/" + gpu;
}

fn _text_render_plan_for_state(state) {
    let p = try state.perf catch map{};
    return try gfx.text_render_plan(TEXT_PROFILE, p, map{
        mode: TEXT_MODE,
        target_fps: 60,
        shape_cache: len(TEXT_SHAPE_CACHE_KEYS)
    }) catch map{ decision: "unknown", renderer: "unknown", warnings: [] };
}

fn _text_render_status_for_state(state) {
    return try gfx.text_render_status(_text_render_plan_for_state(state)) catch "text unknown";
}

fn _perf_record_draw(state, ms) {
    if (try state.perf catch nil) == nil {
        state.perf = map{ draws: 0, skips: 0, last_draw_ms: 0, avg_draw_ms: 0 };
    }
    state.perf.draws = (try state.perf.draws catch 0) + 1;
    state.perf.last_draw_ms = ms;
    let avg = try state.perf.avg_draw_ms catch ms;
    state.perf.avg_draw_ms = avg * 0.8 + ms * 0.2;
    return 0;
}

fn _perf_record_skip(state) {
    if (try state.perf catch nil) == nil {
        state.perf = map{ draws: 0, skips: 0, last_draw_ms: 0, avg_draw_ms: 0 };
    }
    state.perf.skips = (try state.perf.skips catch 0) + 1;
    return 0;
}

fn _perf_ms(v) {
    return num_floor(v * 10 + 0.5) / 10;
}

fn _perf_summary(state) {
    let p = try state.perf catch map{};
    let runtime_cache = try state.render_runtime_cache catch map{ reason: "uninitialized" };
    return "frames draw=" + str(try p.draws catch 0) +
    " skip=" + str(try p.skips catch 0) +
    " last=" + str(_perf_ms(try p.last_draw_ms catch 0)) + "ms" +
    " avg=" + str(_perf_ms(try p.avg_draw_ms catch 0)) + "ms" +
    " text=" + str(try p.text_calls catch 0) +
    "/" + str(try p.text_skips catch 0) +
    " policy=" + str(try state.render_runtime_refreshes catch 0) +
    "/" + str(try runtime_cache.reason catch "uninitialized");
}

fn _frame_command_estimate(state) {
    let cmds = [
    map{ op: "box", x: 0, y: 0, w: 1280, h: TBH },
    map{ op: "text", x: PAD, y: PAD, text: str(try state.panel catch "code") }
    ];
    let rows = try state.rows catch 40;
    if state.panel == "code" {
        let n = rows;
        if n > 80 { n = 80; }
        let i = 0;
        while i < n {
            array_push(cmds, map{ op: "text", x: GUTTERX, y: TOP + i * CH, text: "code-row" });
            i = i + 1;
        }
    } else if state.panel == "web" or state.panel == "files" or state.panel == "hist" or state.panel == "manage" or state.panel == "settings" {
        let i = 0;
        while i < 32 {
            array_push(cmds, map{ op: "box", x: PAD, y: TOP + i * CH, w: 360, h: CH });
            array_push(cmds, map{ op: "text", x: PAD * 2, y: TOP + i * CH, text: "row" });
            i = i + 1;
        }
    } else {
        array_push(cmds, map{ op: "box", x: PAD, y: TOP, w: 320, h: 220 });
        array_push(cmds, map{ op: "text", x: PAD * 2, y: TOP + PAD, text: "panel" });
    }
    return cmds;
}

fn _frame_schedule_for_state(state, gp) {
    let sz = try state.winsz catch try state.live_winsz catch map{ w: 1280, h: 860 };
    let dirty = [];
    if try state.redraw catch true {
        array_push(dirty, map{ x: 0, y: 0, w: try sz.w catch 1280, h: try sz.h catch 860 });
    }
    return IDE.ide_render_frame_plan(try sz.w catch 1280, try sz.h catch 860, gp, dirty, _frame_command_estimate(state), map{ target_fps: 60, parallel: true, perf: try state.perf catch map{} });
}

fn _render_runtime_for_state(state, gp = nil) {
    // Runtime throttling depends on measured draw/text performance, not on a
    // synthetic frame command list. Keep the full frame scheduler on the
    // on-demand Graphics panel and use the smaller quality path here.
    let perf = try state.perf catch map{};
    let quality = IDE.ide_render_quality_policy(perf, perf, map{ target_fps: 60 });
    return IDE.ide_render_runtime_plan(quality, map{ target_fps: 60, idle_ms: _idle_redraw_interval_ms() });
}

fn _render_runtime_refresh_interval_ms() {
    let raw = try env_get("PBIDE_RENDER_POLICY_MS") catch "";
    let n = try parse_number(raw) catch 1000;
    if n == nil { n = 1000; }
    n = num_floor(n);
    if n < 100 { return 100; }
    if n > 5000 { return 5000; }
    return n;
}

fn _render_runtime_current(state) {
    let current = try state.render_runtime catch nil;
    if current != nil { return current; }
    return IDE.ide_render_runtime_plan(nil, map{ target_fps: 60, idle_ms: _idle_redraw_interval_ms() });
}

fn _render_runtime_refresh(state, now, force = false) {
    let perf = try state.perf catch map{};
    let decision = IDE.ide_render_runtime_cache_policy(
    try state.render_runtime_last_ms catch 0,
    now,
    try state.render_runtime_last_draws catch 0,
    try perf.draws catch 0,
    map{
        interval_ms: _render_runtime_refresh_interval_ms(),
        initialized: (try state.render_runtime_refreshes catch 0) > 0,
        force: force
    }
    );
    state.render_runtime_cache = decision;
    if not decision.refresh { return _render_runtime_current(state); }
    let runtime = _render_runtime_for_state(state);
    runtime.cache_reason = decision.reason;
    runtime.cache_interval_ms = decision.interval_ms;
    state.render_runtime = runtime;
    state.render_runtime_last_ms = now;
    state.render_runtime_last_draws = try perf.draws catch 0;
    state.render_runtime_refreshes = (try state.render_runtime_refreshes catch 0) + 1;
    return runtime;
}

fn _adaptive_idle_redraw_interval_ms(state) {
    let base = _idle_redraw_interval_ms();
    let rt = try state.render_runtime catch nil;
    if rt == nil { return base; }
    let n = try rt.idle_ms catch base;
    if n == nil { return base; }
    n = num_floor(n);
    if n < 0 { return 0; }
    if n > 5000 { return 5000; }
    return n;
}

fn _defer_non_input_redraw(state, now, runtime) {
    if not (try state.redraw catch false) { return false; }
    if now == 0 { return false; }
    let gap = try runtime.min_draw_gap_ms catch 0;
    if gap == nil or gap <= 0 { return false; }
    let last_input = try state.last_input_ms catch 0;
    let grace = try runtime.input_grace_ms catch 60;
    if last_input != 0 and now - last_input <= grace { return false; }
    let last_present = try state.last_present_ms catch 0;
    if last_present != 0 and now - last_present < gap { return true; }
    return false;
}

fn _debug_events_enabled() {
    let v = try env_get("PBIDE_DEBUG_EVENTS") catch "";
    return v == "1" or v == "true" or v == "on";
}

fn _debug_event(text) {
    if not _debug_events_enabled() { return 0; }
    try fs_append("/tmp/pbide-events.log", str(try now_ms() catch 0) + " " + str(text) + "\n") catch nil;
    return 0;
}

fn _record_input_event(state, text) {
    state.event_count = (try state.event_count catch 0) + 1;
    state.last_event = str(text);
    state.last_input_ms = try now_ms() catch try state.last_input_ms catch 0;
    _debug_event(text);
    return 0;
}

fn _event_status(state) {
    if not _debug_events_enabled() { return ""; }
    return " · ev " + str(try state.event_count catch 0) + " " + str(try state.last_event catch "none");
}

fn _debug_status_suffix(state) {
    if not _debug_events_enabled() { return ""; }
    return "  [" + str(try state.event_count catch 0) + " " + str(try state.last_event catch "none") + "]";
}

fn _idle_redraw_interval_ms() {
    let raw = try env_get("PBIDE_IDLE_REDRAW_MS") catch "";
    let n = try parse_number(raw) catch 500;
    if n == nil { n = 500; }
    n = num_floor(n);
    if n < 0 { return 0; }
    if n > 5000 { return 5000; }
    return n;
}

// _frame_sig(state) — a compact signature of everything currently VISIBLE, so the frame
// gate (stdlib/frame_gate.sapp) can skip a repaint when the picture would be identical.
// Cheap: only scalars + already-cached content hashes (never re-hashes the document).
// Event-driven changes still force a repaint regardless (see the loop's draw callback),
// so this only needs to catch state that changes WITHOUT an input event — chiefly a live
// window resize / density-probe update — but it lists the visible fields generously.

fn _frame_sig(state) {
    let ed = state.ed;
    let ws = try state.window_size catch map{ w: 0, h: 0 };
    let lw = try state.live_winsz catch ws;
    let parts = [
    str(state.panel),
    str(try ed.row catch 0), str(try ed.col catch 0), str(try ed.scroll catch 0),
    str((try ed.anchor catch nil) != nil),
    str(try state.syntax_hash catch ""),
    str(try state.hover_tab catch ""),
    str(try state.theme catch ""), str(try state.style catch ""), str(try state.density_scale catch 0),
    str(try ws.w catch 0), str(try ws.h catch 0), str(try lw.w catch 0), str(try lw.h catch 0),
    str(try state.help catch false),
    str(try state.examples_mode catch false), str(try state.command_mode catch false),
    str(try state.quick_open_mode catch false), str(try state.goto_line_mode catch false),
    str(try state.find_mode catch false), str(try state.replace_mode catch false),
    str(try state.open_mode catch false), str(try state.save_as_mode catch false),
    str(try state.output catch ""),
    str(len(try state.diagnostics catch [])), str(try state.diag_index catch 0),
    str(try state.term.input catch ""), str(len(try state.term.lines catch [])),
    str(try state.ai.input catch ""), str(len(try state.ai.lines catch [])), str(try state.ai.last_cue catch ""),
    str(try state.web.url catch ""), str(try state.web.mode catch ""), str(try state.web.scroll catch 0),
    str(try state.design.sel catch 0), str(try state.design.counter catch 0), str(len(try state.design.widgets catch [])),
    str(try state.design_tab_sel catch 0), str(len(try state.design_tabs catch [])),
    str(try state.files.sel catch 0), str(try state.files.query catch ""),
    str(try state.outline.sel catch 0), str(try state.problems.sel catch 0), str(try state.manage.sel catch 0),
    str(try state.settings.sel catch 0), str(try state.settings.query catch ""),
    str(try state.command_query catch ""), str(try state.command_sel catch 0),
    str(try state.quick_query catch ""), str(try state.quick_sel catch 0),
    str(try state.query catch ""),
    ];
    return str_join(parts, "|");
}

fn _density_set_manual(state, scale) {
    let s = try parse_number(str(scale)) catch SCALE;
    if s == nil { s = SCALE; }
    s = num_floor(s);
    if s < 1 { s = 1; }
    if s > 4 { s = 4; }
    state.density_manual = s;
    _set_density(s);
    state.density_scale = SCALE;
    state.output = "ui density: manual " + str(SCALE) + "x";
    _ui_event(state, "density manual " + str(SCALE));
    return 0;
}

fn _density_auto(state) {
    state.density_manual = nil;
    let sz = _density_basis_for_state(state, try state.winsz catch map{ w: 1280, h: 760 });
    let s = _density_for_size(sz);
    _set_density(s);
    state.density_scale = SCALE;
    state.output = _density_status(sz, nil);
    _ui_event(state, "density auto " + str(SCALE));
    return 0;
}

fn _density_refresh(state) {
    let sz = _density_basis_for_state(state, try state.winsz catch map{ w: 1280, h: 760 });
    let changed = _apply_live_density(state, sz);
    state.density_scale = SCALE;
    if not changed {
        state.output = _density_status(sz, try state.density_manual catch nil);
    }
    _ui_event(state, "density refresh " + str(SCALE));
    return 0;
}

fn _viewport_layout_for(sz) {
    return IDE.ide_viewport_layout(try sz.w catch 1280, try sz.h catch 760, SCALE);
}

fn _window_probe_default() {
    let off = try env_get("PBIDE_WINDOW_PROBE") catch "";
    if off == "0" or off == "false" or off == "off" { return false; }
    return try WP.available() catch false;
}

fn _window_probe_interval_ms() {
    let n = try parse_number(env_get("PBIDE_WINDOW_PROBE_MS")) catch 1200;
    if n == nil or n < 300 { return 300; }
    if n > 10000 { return 10000; }
    return num_floor(n);
}

fn _monitor_probe_default() {
    let off = try env_get("PBIDE_MONITOR_PROBE") catch "";
    if off == "0" or off == "false" or off == "off" { return false; }
    return try WP.monitor_available() catch false;
}

fn _monitor_probe_interval_ms() {
    let n = try parse_number(env_get("PBIDE_MONITOR_PROBE_MS")) catch 5000;
    if n == nil or n < 1200 { return 1200; }
    if n > 30000 { return 30000; }
    return num_floor(n);
}

fn _maybe_probe_window(state) {
    if not (try state.window_probe_enabled catch false) { return 0; }
    let now = try now_ms() catch 0;
    let last = try state.window_probe_last_ms catch 0;
    if now > 0 and last > 0 and now - last < _window_probe_interval_ms() { return 0; }
    state.window_probe_last_ms = now;
    let live = try WP.size_by_title(PBIDE_TITLE) catch nil;
    if live == nil { return 0; }
    let display = try state.display_winsz catch nil;
    if try state.monitor_probe_enabled catch false {
        let mlast = try state.window_monitor_probe_last_ms catch 0;
        if now == 0 or mlast == 0 or now - mlast >= _monitor_probe_interval_ms() {
            state.window_monitor_probe_last_ms = now;
            display = try WP.monitor_size_by_title(PBIDE_TITLE) catch display;
        }
    }
    let prev = try state.live_winsz catch nil;
    let prevDisplay = try state.display_winsz catch nil;
    if WP.changed(prev, live) or WP.changed(prevDisplay, display) {
        state.live_winsz = live;
        state.display_winsz = display;
        state.window_size = live;
        let basis = WP.display_size_for_window(live, display);
        _apply_live_density(state, basis);
        state.viewport_layout = _viewport_layout_for(live);
        state.redraw = true;
        let screen = "";
        if display != nil { screen = " on " + str(display.w) + "x" + str(display.h); }
        state.output = "window probe: " + str(live.w) + "x" + str(live.h) + screen + " · " + _density_status(basis, try state.density_manual catch nil);
        _ui_event(state, "window probe " + str(live.w) + "x" + str(live.h));
    }
    return 0;
}

// _apply_display_event(state, e) — pick up display_w/display_h attached to SDL2
// "moved"/"resize" events. Returns true when the display under the window changed
// (the caller then re-applies live density). Events without display info are ignored,
// so the minifb backend and older binaries keep working via the shell probe fallback.

fn _apply_display_event(state, e) {
    let dw = try e.display_w catch nil;
    let dh = try e.display_h catch nil;
    if dw == nil or dh == nil { return false; }
    if dw <= 0 or dh <= 0 { return false; }
    let mon = map{ w: dw, h: dh };
    if not WP.changed(try state.display_winsz catch nil, mon) { return false; }
    state.display_winsz = mon;
    return true;
}

fn _density_delta(state, delta) {
    let cur = try state.density_manual catch nil;
    if cur == nil { cur = SCALE; }
    _density_set_manual(state, cur + delta);
    return 0;
}

let TABBG = _trole("tab_bg");     // inactive tab strip (near-black)
let TABACT = _trole("tab_active"); // active-tab fill (electric-violet accent)
let TERMFG = _trole("term_fg");   // terminal text (neon green)
let TERMERR = _trole("term_err"); // terminal stderr (soft red)

// Web-IDE-style top toolbar. Actions live on the left; panel tabs are pinned on the
// right so AI/Designer/Browser/Terminal stay reachable at normal laptop widths.
let ACTIONS = PRODUCT.actions();
let PANELS = PRODUCT.panels();

