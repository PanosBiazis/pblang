// editors/ide/pbide.sapp — the pblang-NATIVE IDE (no HTML / CSS / JS).
//
// A code editor drawn entirely by pblang: a native window (graphics.sapp → minifb/SDL2),
// the editor model (editor_model.sapp), pblang-rendered text (bitmap_font.sapp), shift/
// ctrl-aware input (keymap.sapp), syntax highlighting via the self-hosted tokenizer
// (syntax_hl.sapp), a scrolling viewport, selection, clipboard, undo/redo, find, save,
// run/check, and an output pane. No browser, no DOM, no JS engine — the "total security"
// point (docs/PB_IDE.md, docs/PrjAnalysis.md §90/§91).
//
// Run (needs a display):  ./target/debug/pblang run editors/ide/pbide.sapp --allow-all
// Keys: type to edit · arrows/Home/End/PgUp/PgDn (Shift = select) · Enter/Backspace/Tab
//       Ctrl+C/X/V copy/cut/paste · Ctrl+Z/Y undo/redo · Ctrl+A select-all · Ctrl+S save
//       Ctrl+F find (type, Enter=next, Esc=close) · F5 run · F6 check.
//
// The editor model, font, keymap, and highlighting are tested in the VM. All pblang.

let gfx = import("stdlib/graphics.sapp");
let E = import("stdlib/editor_model.sapp");
let F = import("stdlib/bitmap_font.sapp");
let K = import("stdlib/keymap.sapp");
let H = import("stdlib/syntax_hl.sapp");
let FMT = import("stdlib/compiler/formatter.sapp");
let IDE = import("stdlib/ide_features.sapp");   // web-IDE features: outline / find-replace / status
// The self-hosted frontend (F5 run / F6 check) is imported at TOP LEVEL on purpose:
// top-level imports resolve relative to this script's project root, so they work no
// matter the CWD. A *lazy* import() inside a function resolves relative to the CWD and
// fails unless launched from the repo root — which is what used to crash F5/F6.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
// The Visual Designer panel reuses the pblang GUI toolkit's widget constructors and
// hit-testing (stdlib/gui.sapp) — placed widgets ARE gui widget maps, so the generated
// code is real gui.sapp calls (a true design↔code round-trip, all pblang).
let G = import("stdlib/gui.sapp");
let DE = import("stdlib/design_engine.sapp");
// The AI panel is backed by pbAI — pblang's own assistant (stdlib/pbai.sapp): a neural
// intent classifier + pblang-grounded skills. No external model, no network, no Ollama.
let AI = import("stdlib/pbai.sapp");
// The Browser panel renders web pages with the pblang-native browser (stdlib/browser.sapp):
// http_get → strip tags → text + links, drawn with the bitmap font. No HTML engine.
let B = import("stdlib/browser.sapp");

let BG = gfx.rgb(20, 24, 38);
let FG = gfx.rgb(220, 228, 240);
let CURSOR = gfx.rgb(108, 92, 231);
let GUTTER = gfx.rgb(120, 140, 170);
let HILITE = gfx.rgb(40, 52, 86);
let PANEBG = gfx.rgb(13, 17, 23);
let PANEL2 = gfx.rgb(17, 26, 43);
let SURFACE = gfx.rgb(22, 33, 62);
let SURFACE2 = gfx.rgb(27, 39, 66);
let BORDER = gfx.rgb(36, 51, 82);
let PANEFG = gfx.rgb(150, 220, 200);
let GUTTERBG = gfx.rgb(16, 20, 32);
let CURROW = gfx.rgb(28, 33, 52);

// HiDPI scale — the 5x7 bitmap font is drawn at SCALE× so glyphs are crisp (and large
// enough) on high-resolution displays. Override with PBIDE_SCALE (e.g. 3 or 4 on 4K).
fn _scale() {
    let s = try parse_number(env_get("PBIDE_SCALE")) catch 0;
    if s == nil or s < 1 { return 2; }
    if s > 8 { return 8; }
    return s;
}
let SCALE = _scale();
let CW = 6 * SCALE;                  // glyph advance  (font is 5 wide + 1 space)
let CH = 8 * SCALE;                  // line height    (font is 7 tall + 1 gap)
let PAD = 4 * SCALE;
let GUTTERX = PAD + 5 * CW;          // source text starts here (5-char line-number gutter)
let TBH = CH + 3 * PAD;              // web-IDE-style action toolbar height
let TOP = TBH + PAD;                 // editor/content area starts BELOW the toolbar
let STATUSH = CH + 2 * PAD;          // bottom status bar
let PANEH = STATUSH;                 // kept for old mouse/layout call-sites

let TABBG = gfx.rgb(16, 20, 32);
let TABACT = gfx.rgb(108, 92, 231);  // active-tab fill (accent)
let TERMFG = gfx.rgb(170, 240, 180); // terminal text (green-ish)
let TERMERR = gfx.rgb(255, 150, 150); // terminal stderr

// Web-IDE-style top toolbar. Actions live on the left; panel tabs are pinned on the
// right so AI/Designer/Browser/Terminal stay reachable at normal laptop widths.
let ACTIONS = [
    map{ id: "run",     label: "Run" },
    map{ id: "check",   label: "Check" },
    map{ id: "format",  label: "Fmt" },
    map{ id: "fix",     label: "Fix" },
    map{ id: "examples",label: "Ex" },
    map{ id: "save",    label: "Save" },
    map{ id: "open",    label: "Open" },
    map{ id: "style",   label: "Style" },
];

let PANELS = [
    map{ id: "code",    label: "Code" },
    map{ id: "term",    label: "Term" },
    map{ id: "ai",      label: "AI" },
    map{ id: "design",  label: "Designer" },
    map{ id: "web",     label: "Browser" },
];

let EXAMPLES = [
    map{
        title: "Hello + math",
        code: "// pblang IDE - Smart Code Editor\n// One programming language to create anything\n\nfn greet(name) {\n    return \"Hello, \" + name + \"! Welcome to pblang!\";\n}\n\nprint greet(\"Developer\");\nprint \"2^10 = \" + str(2 ** 10);\n"
    },
    map{
        title: "Arrays + loops",
        code: "// Arrays, loops, and functions\nfn sum(xs) {\n    let total = 0;\n    for x in xs {\n        total = total + x;\n    }\n    return total;\n}\n\nlet nums = [1, 2, 3, 4, 5];\nprint \"sum = \" + str(sum(nums));\n"
    },
    map{
        title: "Maps + branches",
        code: "// Maps and if expressions\nlet user = map{ name: \"Ada\", score: 98 };\nlet grade = if user.score >= 90 { \"A\" } else { \"B\" };\nprint user.name + \" grade \" + grade;\n"
    },
    map{
        title: "Strings + bigint",
        code: "// Strings and exact big integers\nlet words = str_split(\"pblang native ide\", \" \");\nlet title = str_upper(str_join(words, \"-\"));\nlet big = bigint(\"12345678901234567890\") + bigint(\"10\");\nprint title;\nprint str(big);\n"
    },
    map{
        title: "While loop",
        code: "// While loop and map updates\nlet stats = map{ total: 0, count: 0 };\nlet i = 1;\nwhile i <= 5 {\n    stats.total = stats.total + i;\n    stats.count = stats.count + 1;\n    i = i + 1;\n}\nprint \"count = \" + str(stats.count);\nprint \"total = \" + str(stats.total);\n"
    },
];
fn _starter_code() {
    return EXAMPLES[0].code;
}

fn _style_name(state) {
    let s = try state.style catch "pixel";
    if s == nil { return "pixel"; }
    return s;
}
fn _style_next(s) {
    if s == "pixel" { return "smooth"; }
    if s == "smooth" { return "contrast"; }
    return "pixel";
}
fn _style_bg(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(15, 23, 42); }
    if s == "contrast" { return gfx.rgb(6, 8, 14); }
    return BG;
}
fn _style_surface(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(24, 34, 55); }
    if s == "contrast" { return gfx.rgb(13, 18, 30); }
    return SURFACE;
}
fn _style_surface2(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(35, 48, 75); }
    if s == "contrast" { return gfx.rgb(26, 33, 52); }
    return SURFACE2;
}
fn _style_panel(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(10, 16, 26); }
    if s == "contrast" { return gfx.rgb(2, 6, 12); }
    return PANEBG;
}
fn _style_gutter(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(12, 19, 31); }
    if s == "contrast" { return gfx.rgb(4, 7, 13); }
    return GUTTERBG;
}
fn _style_accent(state) {
    let s = _style_name(state);
    if s == "smooth" { return gfx.rgb(56, 189, 248); }
    if s == "contrast" { return gfx.rgb(245, 158, 11); }
    return TABACT;
}

// x/width of action `idx` (cumulative — same math in draw + hit-test).
fn _action_bounds(idx) {
    let x = PAD + 20 * CW;
    let i = 0;
    while i < idx { x = x + (len(ACTIONS[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(ACTIONS[idx].label) + 2) * CW };
}

fn _panel_total_w() {
    let w = 0;
    let i = 0;
    while i < len(PANELS) {
        w = w + (len(PANELS[i].label) + 2) * CW + PAD;
        i = i + 1;
    }
    return w;
}

fn _panel_bounds(idx, sz) {
    let x = sz.w - PAD - _panel_total_w();
    if x < PAD { x = PAD; }
    let i = 0;
    while i < idx { x = x + (len(PANELS[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(PANELS[idx].label) + 2) * CW };
}

fn _fallback_path() {
    let c = try cwd() catch ".";
    if c == nil { c = "."; }
    return c + "/.pbide_buffer.sapp";
}

// F5 — compile + run the buffer through the self-hosted pipeline and surface what
// the program PRINTED (one printed value per line, "> " prefixed). frontend_run now
// captures print output (vm.sapp), so this shows real results instead of a raw map.
fn _run(ed) {
    let r = try FE.frontend_run(E.text(ed)) catch nil;
    if r == nil { return "run: error — relaunch the IDE from the repo root (imports are CWD-relative)"; }
    if not r.ok { return "run: compile error — " + str(try r.error catch "see F6 check"); }
    let out = r.output;
    if len(out) == 0 { return "run: ok · (no output)"; }
    let s = "";
    let i = 0;
    while i < len(out) {
        if i > 0 { s = s + "
"; }
        s = s + "> " + str(out[i]);
        i = i + 1;
    }
    return s;
}
// F6 — static lint via the self-hosted analyzer: undefined names, unreachable code,
// undeclared assignment. Lists up to 6 problems, one per line.
fn _check(ed) {
    let r = try FE.frontend_lint(E.text(ed)) catch nil;
    if r == nil { return "check: error — relaunch the IDE from the repo root (imports are CWD-relative)"; }
    if r.count == 0 { return "check: OK — no problems found"; }
    let s = "check: " + str(r.count) + " problem(s)";
    let i = 0;
    while i < len(r.diagnostics) and i < 6 {
        let d = r.diagnostics[i];
        s = s + "
  " + str(try d.kind catch "?") + ": " + str(try d.message catch "?");
        i = i + 1;
    }
    return s;
}
fn _save(state) {
    let ok = try fs_write(state.path, E.text(state.ed)) catch nil;
    if ok == nil {
        let fb = _fallback_path();
        let ok2 = try fs_write(fb, E.text(state.ed)) catch nil;
        if ok2 == nil { return "save FAILED: " + state.path + " and " + fb; }
        state.path = fb;
        state.dirty = false;
        return "saved fallback " + fb;
    }
    state.dirty = false;
    return "saved " + state.path;
}

fn _open_path(state, path) {
    let p = str_trim(path);
    if p == "" { p = state.path; }
    let raw = try fs_read(p) catch nil;
    if raw == nil { return "open FAILED: cannot read " + p; }
    _replace_editor(state, raw);
    state.path = p;
    state.panel = "code";
    return "opened " + p;
}

// Enter/Return is named differently per backend: minifb → "Enter"/"NumPadEnter",
// SDL2 → "Return". Accept all so Enter works everywhere (editor newline, terminal/AI
// submit, find-next). This was the "Enter broken on all tabs" bug.
fn _is_enter(key) { return key == "Return" or key == "Enter" or key == "NumPadEnter"; }

fn _moveN(ed, dir, n) {
    let i = 0;
    while i < n { if dir == "up" { E.move_up(ed); } else { E.move_down(ed); } i = i + 1; }
    return 0;
}
// _move(ed, key, shift, rows, fast). `fast` (Ctrl held) jumps by word horizontally and
// by 5 lines / to document edges vertically — VS Code-style accelerated movement.
fn _move(ed, key, shift, rows, fast) {
    if shift { if ed.anchor == nil { E.set_anchor(ed); } } else { E.clear_selection(ed); }
    if key == "Left" { if fast { E.move_word_left(ed); } else { E.move_left(ed); } }
    if key == "Right" { if fast { E.move_word_right(ed); } else { E.move_right(ed); } }
    if key == "Up" { if fast { _moveN(ed, "up", 5); } else { E.move_up(ed); } }
    if key == "Down" { if fast { _moveN(ed, "down", 5); } else { E.move_down(ed); } }
    if key == "Home" { if fast { ed.row = 0; } E.home(ed); }
    if key == "End" { if fast { ed.row = len(ed.lines) - 1; } E.end(ed); }
    if key == "PageUp" { E.page_up(ed, rows); }
    if key == "PageDown" { E.page_down(ed, rows); }
}
fn _is_move(key) {
    return key == "Left" or key == "Right" or key == "Up" or key == "Down"
        or key == "Home" or key == "End" or key == "PageUp" or key == "PageDown";
}

// handle a keydown; returns a status string ("" keeps the current one).
fn _key(state, key) {
    let ed = state.ed;
    if try state.open_mode catch false {
        if _is_enter(key) {
            state.open_mode = false;
            let p = state.open_path;
            state.open_path = "";
            return _open_path(state, p);
        }
        if key == "Escape" { state.open_mode = false; state.open_path = ""; return "open cancelled"; }
        if key == "Backspace" {
            if len(state.open_path) > 0 { state.open_path = str_slice(state.open_path, 0, len(state.open_path) - 1); }
            return "open path: " + state.open_path;
        }
        if state.ctrl and key == "V" {
            state.open_path = state.open_path + state.ed.clipboard;
            return "open path: " + state.open_path;
        }
        let ch0 = K.key_to_char(key, state.shift);
        if ch0 != "" { state.open_path = state.open_path + ch0; return "open path: " + state.open_path; }
        return "";
    }
    if state.find_mode {
        if _is_enter(key) { if E.find_next(ed, state.query) { return "find: " + state.query; } return "no match: " + state.query; }
        if key == "Escape" { state.find_mode = false; return "find closed"; }
        if key == "Backspace" { if len(state.query) > 0 { state.query = str_slice(state.query, 0, len(state.query) - 1); } return "find: " + state.query; }
        let ch = K.key_to_char(key, state.shift);
        if ch != "" { state.query = state.query + ch; return "find: " + state.query; }
        return "";
    }
    // Movement first — so Ctrl+arrow accelerates (word / 5-line / doc-edge) instead of
    // being swallowed by the Ctrl-shortcut block. Shift extends the selection.
    if _is_move(key) { _move(ed, key, state.shift, state.rows, state.ctrl); return ""; }
    if state.ctrl {
        if key == "C" { E.copy(ed); return "copied"; }
        if key == "X" { E.snapshot(ed); E.cut(ed); state.last = "other"; state.dirty = true; return "cut"; }
        if key == "V" { E.snapshot(ed); E.paste(ed); state.last = "other"; state.dirty = true; return "pasted"; }
        if key == "Z" { E.undo(ed); state.last = "other"; state.dirty = true; return "undo"; }
        if key == "Y" { E.redo(ed); state.last = "other"; state.dirty = true; return "redo"; }
        if key == "A" { E.select_all(ed); return "select all"; }
        if key == "S" { return _save(state); }
        if key == "O" {
            state.open_mode = true;
            state.open_path = state.path;
            return "open path: " + state.open_path + "  (Enter=open, Esc=cancel)";
        }
        if key == "F" { state.find_mode = true; state.query = ""; return "find: "; }
        return "";
    }
    if key == "F5" { return _run(ed); }
    if key == "F6" { return _check(ed); }
    if key == "Backspace" { E.snapshot(ed); E.backspace(ed); state.last = "other"; state.dirty = true; return ""; }
    if _is_enter(key) { E.snapshot(ed); E.newline(ed); state.last = "other"; state.dirty = true; return ""; }
    if key == "Tab" { E.snapshot(ed); E.insert_text(ed, "    "); state.last = "other"; state.dirty = true; return ""; }
    let ch = K.key_to_char(key, state.shift);
    if ch != "" {
        if state.last != "type" { E.snapshot(ed); }     // coalesce consecutive typing into one undo
        state.last = "type"; state.dirty = true;
        E.insert_char(ed, ch);
        return "";
    }
    return "";
}

fn _line_tokens(toks, lineno) {
    if toks == nil { return nil; }
    let out = [];
    let i = 0;
    while i < len(toks) { if toks[i].line == lineno { push(out, toks[i]); } i = i + 1; }
    return out;
}

fn _code_output_w_state(state, sz) {
    if try state.compact catch false { return 22 * CW; }
    let w = 34 * CW;
    if w > sz.w * 7 / 10 { w = sz.w * 7 / 10; }
    if w < 18 * CW { w = 18 * CW; }
    return w;
}

// The 5×7 font is ASCII-only. Fold common Unicode punctuation to a sensible ASCII glyph
// (so web/AI text shows '-' '*' '"' instead of "missing-glyph" boxes), and render any
// other non-ASCII code as '?' rather than a box. This keeps the reader views legible.
fn _fold(code) {
    if code == 160 { return 32; }                       // nbsp → space
    if code == 8226 { return 42; }                      // • → *
    if code == 183 { return 45; }                       // · → -
    if code == 8211 or code == 8212 { return 45; }      // – — → -
    if code == 8216 or code == 8217 { return 39; }      // ‘ ’ → '
    if code == 8220 or code == 8221 { return 34; }      // “ ” → "
    if code == 8249 { return 60; }                      // ‹ → <
    if code == 8250 { return 62; }                      // › → >
    if code == 169 { return 99; }                       // © → c
    if code == 8230 { return 46; }                      // … → .
    // Greek letters: the bitmap font is ASCII-only, so transliterate common Greek
    // text instead of turning every character into '?' in the browser/AI panels.
    if code == 913 { return 65; } if code == 945 { return 97; }          // Alpha/alpha
    if code == 914 { return 66; } if code == 946 { return 98; }          // Beta/beta
    if code == 915 { return 71; } if code == 947 { return 103; }         // Gamma/gamma
    if code == 916 { return 68; } if code == 948 { return 100; }         // Delta/delta
    if code == 917 { return 69; } if code == 949 { return 101; }         // Epsilon/epsilon
    if code == 918 { return 90; } if code == 950 { return 122; }         // Zeta/zeta
    if code == 919 { return 72; } if code == 951 { return 104; }         // Eta/eta
    if code == 920 { return 84; } if code == 952 { return 116; }         // Theta/theta
    if code == 921 { return 73; } if code == 953 or code == 970 { return 105; }
    if code == 922 { return 75; } if code == 954 { return 107; }         // Kappa/kappa
    if code == 923 { return 76; } if code == 955 { return 108; }         // Lambda/lambda
    if code == 924 { return 77; } if code == 956 { return 109; }         // Mu/mu
    if code == 925 { return 78; } if code == 957 { return 110; }         // Nu/nu
    if code == 926 { return 88; } if code == 958 { return 120; }         // Xi/xi
    if code == 927 { return 79; } if code == 959 or code == 972 { return 111; }
    if code == 928 { return 80; } if code == 960 { return 112; }         // Pi/pi
    if code == 929 { return 82; } if code == 961 { return 114; }         // Rho/rho
    if code == 931 { return 83; } if code == 962 or code == 963 { return 115; }
    if code == 932 { return 84; } if code == 964 { return 116; }         // Tau/tau
    if code == 933 { return 89; } if code == 965 or code == 973 or code == 971 { return 121; }
    if code == 934 { return 70; } if code == 966 { return 102; }         // Phi/phi
    if code == 935 { return 88; } if code == 967 { return 120; }         // Chi/chi
    if code == 936 { return 80; } if code == 968 { return 112; }         // Psi/psi
    if code == 937 { return 79; } if code == 969 or code == 974 { return 111; }
    if code > 126 { return 63; }                        // any other non-ASCII → ?
    return code;
}
// scaled text: each lit 5x7 font pixel becomes one SCALE×SCALE FILLED RECT — crisp on
// HiDPI and fewer ops than SCALE² per-pixel points. Spaces advance without drawing.
fn _dt(win, x, y, s, color) {
    let cx = x;
    let i = 0;
    while i < len(s) {
        let code = _fold(strcharcodeat(s, i));
        if code != 32 {
            let g = F.glyph(code);
            if g == nil { g = [31, 17, 17, 17, 17, 17, 31]; }
            let r = 0;
            while r < 7 {
                let row = g[r];
                let c = 0;
                while c < 5 {
                    if bit_and(bit_shr(row, 4 - c), 1) == 1 {
                        win.rect(cx + c * SCALE, y + r * SCALE, SCALE, SCALE, color);
                    }
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        cx = cx + CW;
        i = i + 1;
    }
    return 0;
}

fn _draw_code(state, win, sz) {
    let ed = state.ed;
    let outw = _code_output_w_state(state, sz);
    let splitw = SCALE * 3;
    let editorW = sz.w - outw - splitw;
    let rows = num_floor((sz.h - STATUSH - TOP) / CH);
    state.rows = rows;
    ed.row = num_floor(ed.row);
    ed.col = num_floor(ed.col);
    ed.scroll = num_floor(ed.scroll);
    E.ensure_visible(ed, rows);

    // re-tokenize only when the buffer changed (cached across frames — the editor
    // redraws at 30 fps but the syntax tokens rarely change)
    if state.dirty { state.tokens = try H.tokens(E.text(ed)) catch nil; state.dirty = false; }
    let toks = state.tokens;
    let selr = E.selection_range(ed);
    let scr = ed.scroll;

    // gutter background strip
    win.rect(0, TOP, GUTTERX - SCALE, sz.h - STATUSH - TOP, _style_gutter(state));

    let vr = 0;
    while vr < rows {
        let r = scr + vr;
        if r < E.line_count(ed) {
            let y = TOP + vr * CH;
            // current-line highlight (behind the text, across the editor area)
            if r == ed.row { win.rect(GUTTERX - SCALE, y - SCALE, editorW - GUTTERX + SCALE, CH, CURROW); }
            // selection highlight (behind the text)
            if selr != nil and r >= selr.start.row and r <= selr.end.row {
                let sc = 0;
                if r == selr.start.row { sc = selr.start.col; }
                let ec = len(ed.lines[r]);
                if r == selr.end.row { ec = selr.end.col; }
                if ec < sc { ec = sc; }
                win.rect(GUTTERX + sc * CW, y, (ec - sc) * CW + SCALE, CH, HILITE);
            }
            _dt(win, PAD, y, str(r + 1), GUTTER);
            let lt = _line_tokens(toks, r + 1);
            if lt == nil {
                _dt(win, GUTTERX, y, ed.lines[r], FG);
            } else {
                let i = 0;
                while i < len(lt) {
                    let t = lt[i];
                    let rgb = H.kind_color(t.kind);
                    _dt(win, GUTTERX + (t.col - 1) * CW, y, t.text, gfx.rgb(rgb[0], rgb[1], rgb[2]));
                    i = i + 1;
                }
            }
        }
        vr = vr + 1;
    }

    let curscreen = ed.row - scr;
    if curscreen >= 0 and curscreen < rows {
        win.rect(GUTTERX + ed.col * CW, TOP + curscreen * CH, SCALE, CH - SCALE, CURSOR);
    }

    // web IDE output side pane
    let ox = editorW;
    win.rect(ox, TOP, splitw, sz.h - TOP - STATUSH, gfx.rgb(19, 29, 51));
    win.rect(ox + splitw, TOP, outw, sz.h - TOP - STATUSH, _style_panel(state));
    let px = ox + splitw;
    win.rect(px, TOP, outw, CH + PAD, _style_surface(state));
    win.rect(px, TOP, SCALE * 2, CH + PAD, gfx.rgb(255, 204, 102));
    _dt(win, px + PAD, TOP + PAD / 2, "INPUT FOR read_line()", gfx.rgb(255, 213, 122));
    let stdinY = TOP + CH + PAD;
    win.rect(px, stdinY, outw, CH * 3, _style_surface2(state));
    _dt(win, px + PAD, stdinY + PAD / 2, "one input per line", GUTTER);
    let outHeadY = stdinY + CH * 3;
    win.rect(px, outHeadY, outw, CH + PAD, _style_surface(state));
    win.rect(px, outHeadY, SCALE * 2, CH + PAD, gfx.rgb(0, 184, 148));
    _dt(win, px + PAD, outHeadY + PAD / 2, "OUTPUT", gfx.rgb(46, 224, 189));
    let head = "OUTPUT   LN " + str(ed.row + 1) + " COL " + str(ed.col + 1);
    let maxchars = (outw - 2 * PAD) / CW;
    let outlines = str_split(state.output, "
");
    let oi = 0;
    while oi < len(outlines) and oi < 8 {
        _dt(win, px + PAD, outHeadY + CH + PAD + oi * CH, str_slice(outlines[oi], 0, maxchars), PANEFG);
        oi = oi + 1;
    }
    let diagY = outHeadY + CH * 10;
    win.rect(px, diagY, outw, CH + PAD, _style_surface(state));
    win.rect(px, diagY, SCALE * 2, CH + PAD, gfx.rgb(255, 204, 102));
    _dt(win, px + PAD, diagY + PAD / 2, "DIAGNOSTICS", gfx.rgb(255, 204, 102));
    let diagText = "F6 Check: self-hosted lint for undefined names, unreachable code, assignment errors.";
    let dl = _wrap(diagText, maxchars);
    let di = 0;
    while di < len(dl) and di < 2 {
        _dt(win, px + PAD, diagY + CH + PAD + di * CH, dl[di], GUTTER);
        di = di + 1;
    }
    let histY = diagY + CH * 4;
    win.rect(px, histY, outw, CH + PAD, _style_surface(state));
    win.rect(px, histY, SCALE * 2, CH + PAD, gfx.rgb(102, 194, 255));
    _dt(win, px + PAD, histY + PAD / 2, "HISTORY", gfx.rgb(159, 216, 255));
    let hs = _wrap("Last action: " + state.output, maxchars);
    let hi = 0;
    while hi < len(hs) and hi < 4 {
        _dt(win, px + PAD, histY + CH + PAD + hi * CH, hs[hi], GUTTER);
        hi = hi + 1;
    }

    // bottom status bar
    let sy = sz.h - STATUSH;
    win.rect(0, sy, sz.w, STATUSH, _style_surface(state));
    win.rect(0, sy, sz.w, SCALE, BORDER);
    if ed.anchor != nil { head = head + " [SEL]"; }
    head = head + "   SYM " + str(len(IDE.outline(E.text(ed))));
    head = head + "   F5 Run   F6 Check   Ctrl+S Save   Ctrl+F Find";
    if try state.open_mode catch false { head = "OPEN  " + state.open_path + "  Enter=open  Esc=cancel"; }
    if state.find_mode { head = "FIND  " + state.query + "  Enter=next  Esc=cancel"; }
    _dt(win, PAD, sy + PAD / 2, str_slice(head, 0, (sz.w - 2 * PAD) / CW), GUTTER);
}

// ── toolbar (top tab strip) ──────────────────────────────────────────────────────
fn _draw_toolbar(state, win, sz) {
    win.rect(0, 0, sz.w, TBH, _style_surface(state));
    win.rect(0, TBH - SCALE, sz.w, SCALE, BORDER);
    win.rect(PAD, PAD, 18 * CW, CH + PAD, _style_panel(state));
    win.rect(PAD, PAD, SCALE * 2, CH + PAD, _style_accent(state));
    _dt(win, PAD + CW, PAD + SCALE, "pblang IDE v0.5.7", _style_accent(state));
    let i = 0;
    let panelStart = sz.w - PAD - _panel_total_w();
    if panelStart < PAD { panelStart = PAD; }
    while i < len(ACTIONS) {
        let b = _action_bounds(i);
        let id = ACTIONS[i].id;
        if b.x + b.w + PAD < panelStart {
            let bg = _style_surface2(state);
            if id == "run" { bg = gfx.rgb(0, 184, 148); }
            if id == "style" { bg = gfx.rgb(46, 40, 64); }
            win.rect(b.x, PAD, b.w, CH + PAD, bg);
            win.rect(b.x, PAD, b.w, SCALE, gfx.rgb(52, 65, 105));
            let fg = FG;
            if id == "run" { fg = gfx.rgb(4, 35, 29); }
            _dt(win, b.x + CW, PAD + PAD / 2, ACTIONS[i].label, fg);
        }
        i = i + 1;
    }
    i = 0;
    while i < len(PANELS) {
        let b = _panel_bounds(i, sz);
        let id = PANELS[i].id;
        let active = id == state.panel;
        let bg = gfx.rgb(38, 52, 86);
        if active { bg = gfx.rgb(79, 70, 229); }
        win.rect(b.x, PAD, b.w, CH + PAD, bg);
        win.rect(b.x, PAD, b.w, SCALE, gfx.rgb(52, 65, 105));
        if active { win.rect(b.x, TBH - 2 * SCALE, b.w, 2 * SCALE, _style_accent(state)); }
        let fg = GUTTER;
        if active { fg = gfx.rgb(245, 248, 255); }
        _dt(win, b.x + CW, PAD + PAD / 2, PANELS[i].label, fg);
        i = i + 1;
    }
}
// toolbar hit-test: pixel → tab id (nil if not on the toolbar).
fn _toolbar_hit(mx, my, sz) {
    if my >= TBH { return nil; }
    if sz == nil { return nil; }
    let i = 0;
    while i < len(PANELS) {
        let b = _panel_bounds(i, sz);
        if mx >= b.x and mx < b.x + b.w { return PANELS[i].id; }
        i = i + 1;
    }
    let panelStart = sz.w - PAD - _panel_total_w();
    if panelStart < PAD { panelStart = PAD; }
    i = 0;
    while i < len(ACTIONS) {
        let b = _action_bounds(i);
        if b.x + b.w + PAD < panelStart and mx >= b.x and mx < b.x + b.w { return ACTIONS[i].id; }
        i = i + 1;
    }
    return nil;
}

fn _replace_editor(state, code) {
    state.ed = E.new(code);
    state.dirty = true;
    state.tokens = nil;
    state.last = "other";
}

fn _format_editor(state) {
    let code = E.text(state.ed);
    let formatted = try FMT.format_source(code, 100) catch nil;
    if formatted == nil { return "format: failed"; }
    _replace_editor(state, formatted);
    return "formatted via pblang formatter";
}

fn _line_needs_semicolon(t) {
    if t == "" { return false; }
    if str_ends_with(t, ";") or str_ends_with(t, "{") or str_ends_with(t, "}") { return false; }
    return str_starts_with(t, "print ") or str_starts_with(t, "let ")
        or str_starts_with(t, "const ") or str_starts_with(t, "return ")
        or str_starts_with(t, "throw ");
}

fn _fix_print_call(line) {
    let t = str_trim(line);
    if str_starts_with(t, "print(") and str_ends_with(t, ");") {
        let before = str_slice(line, 0, str_index_of(line, "print("));
        let inner = str_slice(t, 6, len(t) - 2);
        return before + "print " + inner + ";";
    }
    return line;
}

fn _auto_fix_editor(state) {
    let code = E.text(state.ed);
    code = str_replace_all(code, strfromcharcode(8216), "'");
    code = str_replace_all(code, strfromcharcode(8217), "'");
    code = str_replace_all(code, strfromcharcode(8220), "\"");
    code = str_replace_all(code, strfromcharcode(8221), "\"");
    code = str_replace_all(code, strfromcharcode(8211), "-");
    code = str_replace_all(code, strfromcharcode(8212), "-");
    let lines = str_split(code, "\n");
    let out = "";
    let changed = false;
    for i len(lines) {
        let line = _fix_print_call(lines[i]);
        if line != lines[i] { changed = true; }
        let t = str_trim(line);
        if _line_needs_semicolon(t) {
            line = line + ";";
            changed = true;
        }
        if i > 0 { out = out + "\n"; }
        out = out + line;
    }
    if changed or out != E.text(state.ed) {
        _replace_editor(state, out);
        return "auto-fix applied: normalized print calls, smart punctuation, simple semicolons";
    }
    return "auto-fix: no safe deterministic fixes found";
}

fn _load_next_example(state) {
    let idx = try state.example_idx catch 0;
    if idx < 0 or idx >= len(EXAMPLES) { idx = 0; }
    let ex = EXAMPLES[idx];
    _replace_editor(state, ex.code);
    state.panel = "code";
    state.example_idx = idx + 1;
    if state.example_idx >= len(EXAMPLES) { state.example_idx = 0; }
    return "loaded example: " + ex.title + " (" + str(idx + 1) + "/" + str(len(EXAMPLES)) + ")";
}

fn _open_buffer(state) {
    state.open_mode = true;
    state.open_path = state.path;
    return "open path: " + state.open_path + "  (type path, Enter=open, Esc=cancel)";
}

fn _toolbar_click(state, id) {
    if id == "code" or id == "ai" or id == "design" or id == "web" or id == "term" { state.panel = id; return 0; }
    if id == "run" { state.panel = "code"; state.output = _run(state.ed); return 0; }
    if id == "check" { state.panel = "code"; state.output = _check(state.ed); return 0; }
    if id == "save" { state.panel = "code"; state.output = _save(state); return 0; }
    if id == "clear" { state.output = ""; state.term.lines = []; state.ai.lines = []; return 0; }
    if id == "restore" {
        state.panel = "code";
        state.ed = E.new(_starter_code());
        state.dirty = true; state.tokens = nil; state.output = "restored web IDE starter example";
        return 0;
    }
    if id == "format" { state.panel = "code"; state.output = _format_editor(state); return 0; }
    if id == "fix" { state.panel = "code"; state.output = _auto_fix_editor(state); return 0; }
    if id == "examples" { state.output = _load_next_example(state); return 0; }
    if id == "open" { state.output = _open_buffer(state); return 0; }
    if id == "style" {
        state.style = _style_next(_style_name(state));
        state.output = "style: " + state.style + " (click Style to cycle; set PBIDE_SCALE=1 for smaller text)";
        return 0;
    }
    if id == "help" { state.help = not state.help; return 0; }
    return 0;
}

// ── terminal panel (real PC commands via proc_spawn_wait — needs --allow-exec) ────
// Shell-quote a path for a single-quoted bash context.
fn _shq(s) { return "'" + str_replace_all(s, "'", "'\\''") + "'"; }

fn _term_push(state, line) {
    array_push(state.term.lines, line);
    // cap scrollback so a chatty command can't grow the buffer without bound
    if len(state.term.lines) > 600 {
        let out = [];
        let i = len(state.term.lines) - 400;
        while i < len(state.term.lines) { push(out, state.term.lines[i]); i = i + 1; }
        state.term.lines = out;
    }
}
fn _term_run(state) {
    let t = state.term;
    let cmd = str_trim(t.input);
    _term_push(state, "$ " + cmd);
    t.input = "";
    if cmd == "" { return 0; }
    if cmd == "clear" { state.term.lines = []; return 0; }
    // Run inside the tracked cwd; a trailing `pwd` reports the directory AFTER the
    // command (so `cd subdir` persists across commands like a real shell). stdout's
    // last line is that pwd; everything above it is the command's own output.
    let full = "cd " + _shq(t.cwd) + " 2>/dev/null; " + cmd + "\nprintf '%s' \"$(pwd)\"";
    let r = try proc_spawn_wait("bash", ["-c", full]) catch nil;
    if r == nil {
        _term_push(state, "[terminal needs exec — relaunch with --allow-exec or --allow-all]");
        return 0;
    }
    let outlines = str_split(r.stdout, "
");
    let n = len(outlines);
    if n > 0 { state.term.cwd = outlines[n - 1]; }      // last line = resulting pwd
    let i = 0;
    while i < n - 1 { _term_push(state, outlines[i]); i = i + 1; }
    let errl = str_split(r.stderr, "
");
    let j = 0;
    while j < len(errl) { if str_trim(errl[j]) != "" { _term_push(state, "! " + errl[j]); } j = j + 1; }
    return 0;
}
fn _term_key(state, key, shift) {
    let t = state.term;
    if _is_enter(key) {
        if shift { t.input = t.input + "
"; return 0; }                  // Shift+Enter = newline (compose a multi-line command)
        _term_run(state); return 0;
    }
    if key == "Backspace" { if len(t.input) > 0 { t.input = str_slice(t.input, 0, len(t.input) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { t.input = t.input + ch; }
    return 0;
}
// draw a (possibly multi-line) input box pinned to the window bottom; the first visual
// line carries `prefix`. Multi-line because Shift+Enter inserts "\n" into `input`. Returns
// the Y where the box starts, so the scrollback above can size itself to fit.
fn _draw_input(win, sz, prefix, input, maxchars) {
    let inlines = str_split(input, "
");
    let nl = len(inlines);
    let boxTop = sz.h - CH * nl - 2 * PAD;
    win.rect(0, boxTop - PAD, sz.w, CH * nl + 3 * PAD, PANEBG);
    win.rect(0, boxTop - PAD, sz.w, SCALE, TABACT);
    let i = 0;
    while i < nl {
        let txt = inlines[i];
        if i == 0 { txt = prefix + txt; }
        _dt(win, PAD, boxTop + i * CH, str_slice(txt, 0, maxchars), FG);
        i = i + 1;
    }
    let lastlen = len(inlines[nl - 1]);
    if nl == 1 { lastlen = lastlen + len(prefix); }
    if lastlen > maxchars { lastlen = maxchars; }
    win.rect(PAD + lastlen * CW, boxTop + (nl - 1) * CH, SCALE, CH - SCALE, CURSOR);
    return boxTop - PAD;
}
fn _draw_term(state, win, sz) {
    let t = state.term;
    let maxchars = (sz.w - 2 * PAD) / CW;
    let promptTop = _draw_input(win, sz, t.cwd + " $ ", t.input, maxchars);
    let areaRows = (promptTop - TOP) / CH;
    let total = len(t.lines);
    let start = 0;
    if total > areaRows { start = total - areaRows; }    // tail the scrollback
    let vr = 0;
    while start + vr < total and vr < areaRows {
        let ln = t.lines[start + vr];
        let col = TERMFG;
        if len(ln) > 0 and strcharcodeat(ln, 0) == 33 { col = TERMERR; }   // '!' = stderr line
        _dt(win, PAD, TOP + vr * CH, str_slice(ln, 0, maxchars), col);
        vr = vr + 1;
    }
}

// ── placeholder panels (next milestones — reachable, honest about status) ─────────
fn _draw_stub(win, sz, title, lines) {
    _dt(win, PAD, TOP, title, TABACT);
    let i = 0;
    while i < len(lines) {
        _dt(win, PAD, TOP + CH * 2 + i * CH, lines[i], PANEFG);
        i = i + 1;
    }
}

// ── Visual Designer panel ─────────────────────────────────────────────────────────
// A drag-and-drop form builder: a palette of widget kinds + a canvas you click to
// place widgets + an inspector, generating real stdlib/gui.sapp code. Placed widgets
// ARE gui widget maps (built by the G.* constructors), so →CODE round-trips to source.
let DPAL = [
    map{ id: "label",    label: "LABEL",  act: false },
    map{ id: "button",   label: "BUTTON", act: false },
    map{ id: "textbox",  label: "TEXT",   act: false },
    map{ id: "checkbox", label: "CHECK",  act: false },
    map{ id: "panel",    label: "PANEL",  act: false },
    map{ id: "cube3d",   label: "CUBE3D", act: false },
    map{ id: "sphere3d", label: "BALL3D", act: false },
    map{ id: "layout",   label: "LAYOUT", act: true },
    map{ id: "gencode",  label: "->CODE", act: true },
    map{ id: "clear",    label: "CLEAR",  act: true },
];
// x/width of palette chip `idx` (cumulative — same math in draw + hit-test).
fn _pal_bounds(idx) {
    let x = PAD;
    let i = 0;
    while i < idx { x = x + (len(DPAL[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(DPAL[idx].label) + 2) * CW };
}
// palette hit-test → chip id (nil if the click isn't on the palette row).
fn _pal_hit(mx, my) {
    if my < TOP or my >= TOP + CH { return nil; }
    let i = 0;
    while i < len(DPAL) {
        let b = _pal_bounds(i);
        if mx >= b.x and mx < b.x + b.w { return DPAL[i].id; }
        i = i + 1;
    }
    return nil;
}
// rectangle outline (the toolkit only fills rects, so a border is four thin rects).
fn _box(win, x, y, w, h, c) {
    win.rect(x, y, w, SCALE, c);
    win.rect(x, y + h - SCALE, w, SCALE, c);
    win.rect(x, y, SCALE, h, c);
    win.rect(x + w - SCALE, y, SCALE, h, c);
}
// which widget property holds its editable label (so typing edits the right field).
fn _w_textkey(w) {
    if w.kind == "textbox" { return "value"; }
    if w.kind == "panel" { return "title"; }
    return "text";
}
// build a new widget of `kind` at (x,y) via the gui.sapp constructors (auto-named).
fn _make_widget(state, kind, x, y) {
    state.design.counter = state.design.counter + 1;
    let n = state.design.counter;
    if kind == "label" { return G.label("lbl" + str(n), x, y, "Label"); }
    if kind == "button" { return G.button("btn" + str(n), x, y, 120, 32, "Button", nil); }
    if kind == "textbox" { return G.textbox("txt" + str(n), x, y, 160, 28, ""); }
    if kind == "checkbox" { return G.checkbox("chk" + str(n), x, y, "Check", false, nil); }
    if kind == "panel" { return G.panel("pnl" + str(n), x, y, 200, 120, "Panel"); }
    if kind == "cube3d" {
        let w = DE.item3d("cube", "cube" + str(n), x, y, 12, 72, 72, 72);
        w.text = "Cube";
        return w;
    }
    if kind == "sphere3d" {
        let w = DE.item3d("sphere", "ball" + str(n), x, y, 8, 72, 72, 72);
        w.text = "Ball";
        return w;
    }
    return nil;
}
// topmost placed widget containing (x,y), or -1. Last-added wins (drawn on top).
fn _design_widget_at(state, x, y) {
    return DE.hit_test(state.design.widgets, x, y);
}
fn _draw_cube3d(win, w, sel) {
    let off = 10 * SCALE;
    let face = gfx.rgb(79, 70, 229);
    let side = gfx.rgb(49, 46, 129);
    let top = gfx.rgb(99, 102, 241);
    win.rect(w.x + off, w.y, w.w, w.h, top);
    win.rect(w.x, w.y + off, w.w, w.h, face);
    win.rect(w.x + w.w, w.y + off, off, w.h, side);
    _box(win, w.x, w.y + off, w.w, w.h, FG);
    _box(win, w.x + off, w.y, w.w, w.h, GUTTER);
    _dt(win, w.x + PAD, w.y + w.h + off + PAD, w.text, FG);
    if sel { _box(win, w.x - SCALE, w.y - SCALE, w.w + off + 2 * SCALE, w.h + off + 2 * SCALE, CURSOR); }
}
fn _draw_sphere3d(win, w, sel) {
    let r = w.w / 2;
    let steps = 6;
    let i = 0;
    while i < steps {
        let inset = i * SCALE * 3;
        let shade = gfx.rgb(46 + i * 12, 224 - i * 18, 189 - i * 12);
        win.rect(w.x + inset, w.y + inset, w.w - inset * 2, w.h - inset * 2, shade);
        i = i + 1;
    }
    _box(win, w.x, w.y, w.w, w.h, GUTTER);
    _dt(win, w.x + PAD, w.y + w.h + PAD, w.text, FG);
    if sel { _box(win, w.x - SCALE, w.y - SCALE, w.w + 2 * SCALE, w.h + 2 * SCALE, CURSOR); }
}
fn _draw_dwidget(win, w, sel) {
    let bd = GUTTER;
    if sel { bd = CURSOR; }
    let k = w.kind;
    if k == "cube" {
        _draw_cube3d(win, w, sel);
    } else if k == "sphere" {
        _draw_sphere3d(win, w, sel);
    } else if k == "panel" {
        win.rect(w.x, w.y, w.w, w.h, HILITE);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + PAD, w.title, FG);
    } else if k == "button" {
        win.rect(w.x, w.y, w.w, w.h, TABACT);
        _dt(win, w.x + (w.w - len(w.text) * CW) / 2, w.y + (w.h - 7 * SCALE) / 2, w.text, FG);
        if sel { _box(win, w.x, w.y, w.w, w.h, CURSOR); }
    } else if k == "textbox" {
        win.rect(w.x, w.y, w.w, w.h, PANEBG);
        _box(win, w.x, w.y, w.w, w.h, bd);
        _dt(win, w.x + PAD, w.y + (w.h - 7 * SCALE) / 2, w.value, FG);
    } else if k == "checkbox" {
        let bs = 5 * SCALE;
        _box(win, w.x, w.y + (CH - bs) / 2, bs, bs, bd);
        if w.checked { win.rect(w.x + SCALE, w.y + (CH - bs) / 2 + SCALE, bs - 2 * SCALE, bs - 2 * SCALE, TABACT); }
        _dt(win, w.x + bs + PAD, w.y, w.text, FG);
    } else if k == "label" {
        _dt(win, w.x, w.y, w.text, FG);
        if sel { _box(win, w.x, w.y, w.w, w.h, CURSOR); }
    }
}
fn _draw_design(state, win, sz) {
    let d = state.design;
    let layout = try d.layout catch "free";
    // palette row
    let i = 0;
    while i < len(DPAL) {
        let b = _pal_bounds(i);
        let on = ((not DPAL[i].act) and DPAL[i].id == d.tool) or (DPAL[i].id == "layout" and layout != "free");
        let bg = PANEBG;
        if DPAL[i].act { bg = gfx.rgb(46, 40, 64); } else if on { bg = TABACT; }
        if DPAL[i].id == "layout" and layout != "free" { bg = gfx.rgb(0, 184, 148); }
        win.rect(b.x, TOP, b.w, CH, bg);
        let fg = GUTTER; if on { fg = FG; }
        _dt(win, b.x + CW, TOP + SCALE, DPAL[i].label, fg);
        i = i + 1;
    }
    // canvas with a faint dot grid
    let canvTop = TOP + CH + PAD;
    let canvBot = sz.h - (CH + PAD);
    win.rect(0, canvTop, sz.w, canvBot - canvTop, gfx.rgb(24, 28, 42));
    let gx = PAD;
    while gx < sz.w {
        let gy = canvTop;
        while gy < canvBot { win.rect(gx, gy, SCALE, SCALE, gfx.rgb(40, 46, 66)); gy = gy + CH * 2; }
        gx = gx + CW * 4;
    }
    if layout != "free" {
        _dt(win, PAD, canvTop + PAD, "responsive layout: " + layout + "  (LAYOUT cycles free/grid/stack)", TERMFG);
    }
    // placed widgets
    let wi = 0;
    while wi < len(d.widgets) { _draw_dwidget(win, d.widgets[wi], wi == d.sel); wi = wi + 1; }
    // inspector strip
    let iy = sz.h - (CH + PAD);
    win.rect(0, iy, sz.w, CH + PAD, PANEBG);
    win.rect(0, iy, sz.w, SCALE, TABACT);
    let info = "tool: " + d.tool + " · layout: " + layout + " · click canvas to place · drag to move · type to edit · 3D items supported";
    if d.sel >= 0 {
        let w = d.widgets[d.sel];
        info = "SEL " + w.kind + " '" + w.name + "' @ " + str(w.x) + "," + str(w.y) + " · type to rename · Del to delete";
    }
    _dt(win, PAD, iy + 2 * SCALE, str_slice(info, 0, (sz.w - 2 * PAD) / CW), TERMFG);
}
// codegen: placed widgets → runnable stdlib/gui.sapp source.
fn _q(s) { return "\"" + str_replace_all(s, "\"", "\\\"") + "\""; }
fn _w_ctor(w) {
    let k = w.kind;
    let h = _q(w.name) + ", " + str(w.x) + ", " + str(w.y);
    if k == "label" { return "G.label(" + h + ", " + _q(w.text) + ")"; }
    if k == "button" { return "G.button(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.text) + ", nil)"; }
    if k == "textbox" { return "G.textbox(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.value) + ")"; }
    if k == "checkbox" { return "G.checkbox(" + h + ", " + _q(w.text) + ", false, nil)"; }
    if k == "panel" { return "G.panel(" + h + ", " + str(w.w) + ", " + str(w.h) + ", " + _q(w.title) + ")"; }
    return "nil";
}
fn _design_code(state) {
    let s = "let G = import(\"stdlib/gui.sapp\");
let f = G.form(\"Designed UI\", 800, 600);
";
    let i = 0;
    while i < len(state.design.widgets) {
        let w = state.design.widgets[i];
        if (try w.space catch "2d") == "3d" {
            s = s + "// 3D design item " + w.name + " (" + w.kind + ") at x=" + str(w.x) + ", y=" + str(w.y) + ", z=" + str(try w.z catch 0) + "
";
        } else {
            s = s + "G.add(f, " + _w_ctor(w) + ");
";
        }
        i = i + 1;
    }
    s = s + "G.run(f);
";
    return s;
}
fn _layout_next(mode) {
    if mode == "free" { return "responsive"; }
    if mode == "responsive" { return "grid"; }
    if mode == "grid" { return "stack-y"; }
    return "free";
}
fn _design_apply_layout(state) {
    let mode = try state.design.layout catch "free";
    if mode == "free" { return 0; }
    let top = TOP + CH + PAD;
    let bottom = state.winsz.h - (CH + PAD);
    let vp = DE.viewport(state.winsz.w, bottom - top);
    let i = 0;
    while i < len(state.design.widgets) {
        if state.design.widgets[i].y >= top { state.design.widgets[i].y = state.design.widgets[i].y - top; }
        i = i + 1;
    }
    DE.apply_layout(state.design.widgets, vp, mode);
    i = 0;
    while i < len(state.design.widgets) {
        state.design.widgets[i].y = state.design.widgets[i].y + top + PAD;
        i = i + 1;
    }
    return 0;
}
// a click in the Designer: palette action, select+drag an existing widget, or place one.
fn _design_click(state, mx, my) {
    let d = state.design;
    let p = _pal_hit(mx, my);
    if p != nil {
        if p == "layout" {
            d.layout = _layout_next(try d.layout catch "free");
            _design_apply_layout(state);
            state.output = "designer layout: " + d.layout;
            return 0;
        }
        if p == "gencode" {
            state.ed = E.new(_design_code(state));
            state.dirty = true; state.tokens = nil; state.last = "other";
            state.panel = "code";
            state.output = "designer → generated " + str(len(d.widgets)) + " widget(s) into the editor (F5 to run)";
            return 0;
        }
        if p == "clear" { d.widgets = []; d.sel = 0 - 1; return 0; }
        d.tool = p; return 0;
    }
    let canvTop = TOP + CH + PAD;
    let canvBot = state.winsz.h - (CH + PAD);
    if my < canvTop or my >= canvBot { return 0; }
    let hi = _design_widget_at(state, mx, my);
    if hi >= 0 {
        d.sel = hi; d.drag = true;
        d.dx = mx - d.widgets[hi].x; d.dy = my - d.widgets[hi].y;
        return 0;
    }
    let w = _make_widget(state, d.tool, mx, my);
    if w != nil {
        array_push(d.widgets, w);
        d.sel = len(d.widgets) - 1;
        _design_apply_layout(state);
    }
    return 0;
}
fn _design_key(state, key, shift) {
    let d = state.design;
    if d.sel < 0 { return 0; }
    let w = d.widgets[d.sel];
    if key == "Delete" {
        let out = []; let i = 0;
        while i < len(d.widgets) { if i != d.sel { push(out, d.widgets[i]); } i = i + 1; }
        d.widgets = out; d.sel = 0 - 1;
        return 0;
    }
    let fk = _w_textkey(w);
    if key == "Backspace" { let v = w[fk]; if len(v) > 0 { w[fk] = str_slice(v, 0, len(v) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w[fk] = w[fk] + ch; }
    return 0;
}

// ── AI panel (pbAI — stdlib/pbai.sapp) ────────────────────────────────────────────
// A chat against pblang's own assistant: a free-text question box plus quick-action
// chips that run pbAI on whatever is in the CODE editor (explain / find bugs / improve
// / comment). pbAI grounds on code wrapped in a `--- pblang code ---` marker.
let AIPAL = [
    map{ id: "explain", label: "EXPLAIN" },
    map{ id: "bugs",    label: "BUGS" },
    map{ id: "improve", label: "IMPROVE" },
    map{ id: "quality", label: "QUALITY" },
    map{ id: "comment", label: "COMMENT" },
    map{ id: "clear",   label: "CLEAR" },
];
fn _ai_bounds(idx) {
    let x = PAD;
    let i = 0;
    while i < idx { x = x + (len(AIPAL[i].label) + 2) * CW + PAD; i = i + 1; }
    return map{ x: x, w: (len(AIPAL[idx].label) + 2) * CW };
}
fn _ai_hit(mx, my) {
    if my < TOP or my >= TOP + CH { return nil; }
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        if mx >= b.x and mx < b.x + b.w { return AIPAL[i].id; }
        i = i + 1;
    }
    return nil;
}
fn _ai_push(state, line) {
    array_push(state.ai.lines, line);
    if len(state.ai.lines) > 600 {
        let out = []; let i = len(state.ai.lines) - 400;
        while i < len(state.ai.lines) { push(out, state.ai.lines[i]); i = i + 1; }
        state.ai.lines = out;
    }
    return 0;
}
// send `prompt` to pbAI; `echo` is the user-visible line shown above the answer.
fn _ai_send(state, prompt, echo) {
    _ai_push(state, "> " + echo);
    let reply = try AI.respond(prompt) catch "pbAI error — could not produce a response";
    let rl = str_split(reply, "
");
    let i = 0;
    while i < len(rl) { _ai_push(state, "  " + rl[i]); i = i + 1; }
    _ai_push(state, "");
    return 0;
}
// quick action: run a pbAI skill on the current editor buffer (or CLEAR the chat).
fn _ai_action(state, id) {
    if id == "clear" { state.ai.lines = []; return 0; }
    let code = E.text(state.ed);
    let verb = "explain what this code does";
    if id == "bugs" { verb = "find the bugs and errors in this code"; }
    else if id == "improve" { verb = "improve and optimize this code"; }
    else if id == "quality" { verb = "improve quality, security, performance, and maintainability of this code"; }
    else if id == "comment" { verb = "add comments documenting this code"; }
    let prompt = verb + ":

--- pblang code ---
" + code;
    _ai_send(state, prompt, id + " (on editor buffer)");
    return 0;
}
fn _ai_key(state, key, shift) {
    let a = state.ai;
    if _is_enter(key) {
        if shift { a.input = a.input + "
"; return 0; }                  // Shift+Enter = newline (compose a multi-line question)
        let q = str_trim(a.input);
        a.input = "";
        if q != "" { _ai_send(state, q, q); }
        return 0;
    }
    if key == "Backspace" { if len(a.input) > 0 { a.input = str_slice(a.input, 0, len(a.input) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { a.input = a.input + ch; }
    return 0;
}
fn _draw_ai(state, win, sz) {
    let a = state.ai;
    // quick-action palette
    let i = 0;
    while i < len(AIPAL) {
        let b = _ai_bounds(i);
        let bg = PANEBG; if AIPAL[i].id == "clear" { bg = gfx.rgb(46, 40, 64); }
        win.rect(b.x, TOP, b.w, CH, bg);
        _dt(win, b.x + CW, TOP + SCALE, AIPAL[i].label, GUTTER);
        i = i + 1;
    }
    // chat scrollback (tail), hard-wrapped to fit width
    let maxchars = (sz.w - 2 * PAD) / CW;
    let chatTop = TOP + CH + PAD;
    let promptTop = _draw_input(win, sz, "ask pbAI > ", a.input, maxchars);
    let rows = (promptTop - chatTop) / CH;
    let visual = [];
    let li = 0;
    while li < len(a.lines) {
        let wl = _wrap(a.lines[li], maxchars);
        if len(wl) == 0 { push(visual, ""); }
        let wi = 0;
        while wi < len(wl) { push(visual, wl[wi]); wi = wi + 1; }
        li = li + 1;
    }
    let total = len(visual);
    let start = 0;
    if total > rows { start = total - rows; }
    let vr = 0;
    while start + vr < total and vr < rows {
        let ln = visual[start + vr];
        let col = PANEFG;
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = TABACT; }   // '>' = user line, accent
        _dt(win, PAD, chatTop + vr * CH, str_slice(ln, 0, maxchars), col);
        vr = vr + 1;
    }
}

// ── Browser panel (stdlib/browser.sapp) ───────────────────────────────────────────
fn _push_wrapped(lines, text, width) {
    if width < 1 { width = 1; }
    let rest = text;
    while len(rest) > width {
        push(lines, str_slice(rest, 0, width));
        rest = str_slice(rest, width, len(rest));
    }
    if rest != "" { push(lines, rest); }
    return 0;
}

// word-wrap plain text into lines no wider than `width` chars.
fn _wrap(text, width) {
    if width < 1 { width = 1; }
    let words = str_split(str_replace_all(text, "
", " "), " ");
    let lines = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = words[i];
        if w != "" {
            if len(w) > width {
                if cur != "" { push(lines, cur); cur = ""; }
                _push_wrapped(lines, w, width);
            }
            else if cur == "" { cur = w; }
            else if len(cur) + len(w) + 1 > width { push(lines, cur); cur = w; }
            else { cur = cur + " " + w; }
        }
        i = i + 1;
    }
    if cur != "" { push(lines, cur); }
    return lines;
}

fn _wrap_with_prefix(prefix, text, width) {
    let lines = [];
    if width <= len(prefix) + 1 {
        push(lines, str_slice(prefix, 0, width));
        return lines;
    }
    let chunks = _wrap(text, width - len(prefix));
    if len(chunks) == 0 { push(lines, prefix); return lines; }
    let i = 0;
    while i < len(chunks) {
        let p = prefix;
        if i > 0 { p = str_repeat(" ", len(prefix)); }
        push(lines, p + chunks[i]);
        i = i + 1;
    }
    return lines;
}

fn _is_noise_line(line) {
    let t = str_lower(str_trim(line));
    if t == "" { return true; }
    if t == "menu" or t == "items" or t == "scroll to top" { return true; }
    if str_contains(t, "cookies") or str_contains(t, "privacy policy") { return true; }
    if str_contains(t, "newsletter") or str_contains(t, "facebook") or str_contains(t, "linkedin") { return true; }
    return false;
}

fn _reader_lines(text, cols) {
    let raw = _wrap(text, cols);
    let out = [];
    let seen = map{};
    let i = 0;
    while i < len(raw) and len(out) < 900 {
        let line = str_trim(raw[i]);
        if not _is_noise_line(line) {
            let key = str_lower(line);
            if map_has(seen, key) == false {
                seen[key] = true;
                push(out, line);
            }
        }
        i = i + 1;
    }
    if len(out) == 0 { return ["No readable text extracted from this page. Try Links or Forms."]; }
    return out;
}

fn _forms_lines(forms, cols) {
    let out = [];
    if forms == nil or len(forms) == 0 {
        return ["No forms found on this page."];
    }
    let i = 0;
    while i < len(forms) {
        let f = forms[i];
        let head = str(i + 1) + ". " + str_upper(try f.method catch "get") + " " + str(try f.action catch "");
        let wh = _wrap(head, cols);
        let j = 0;
        while j < len(wh) { push(out, wh[j]); j = j + 1; }
        let fields = try f.fields catch [];
        if len(fields) == 0 { push(out, "   fields: none"); }
        let k = 0;
        while k < len(fields) {
            let fld = fields[k];
            push(out, "   - " + str(try fld.name catch "?") + " : " + str(try fld.type catch "text"));
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}
fn _web_load(state) {
    let url = str_trim(state.web.input);
    if url == "" { return 0; }
    if not str_starts_with(url, "http") { url = "https://" + url; state.web.input = url; }
    state.web.scroll = 0;
    state.web.title = "loading " + url + " …";
    state.web.lines = [];
    let page = try B.fetch_page(url) catch nil;
    if page == nil or not page.ok {
        state.web.title = "load failed";
        let why = "could not load (needs network + http; try a reachable http/https URL)";
        if page != nil { why = try page.error catch why; }
        state.web.lines = [why];
        return 0;
    }
    state.web.url = page.url;
    state.web.title = page.title;
    state.web.status = "loaded";
    let cols = 92;
    let reader = _reader_lines(page.text, cols);
    let links = [];
    let i = 0;
    while i < len(page.links) and i < 40 {
        let wl = _wrap_with_prefix("> ", page.links[i], cols);
        let j = 0;
        while j < len(wl) { push(links, wl[j]); j = j + 1; }
        i = i + 1;
    }
    state.web.reader = reader;
    state.web.links = links;
    state.web.forms = _forms_lines(try page.forms catch [], cols);
    state.web.lines = reader;
    return 0;
}
fn _web_key(state, key, shift) {
    let w = state.web;
    if _is_enter(key) { _web_load(state); return 0; }
    if key == "Down" { w.scroll = w.scroll + 3; return 0; }
    if key == "PageDown" { w.scroll = w.scroll + 12; return 0; }
    if key == "Up" { w.scroll = w.scroll - 3; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "PageUp" { w.scroll = w.scroll - 12; if w.scroll < 0 { w.scroll = 0; } return 0; }
    if key == "Backspace" { if len(w.input) > 0 { w.input = str_slice(w.input, 0, len(w.input) - 1); } return 0; }
    let ch = K.key_to_char(key, shift);
    if ch != "" { w.input = w.input + ch; }
    return 0;
}
fn _web_click(state, mx, my) {
    if my < TOP or my >= TOP + CH + 3 * PAD { return 0; }
    let modeX = PAD + 16 * CW;
    if mx >= modeX and mx < modeX + 8 * CW { state.web.mode = "reader"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 8 * CW and mx < modeX + 15 * CW { state.web.mode = "links"; state.web.scroll = 0; return 0; }
    if mx >= modeX + 15 * CW and mx < modeX + 22 * CW { state.web.mode = "forms"; state.web.scroll = 0; return 0; }
    if mx >= PAD + 7 * CW and mx < PAD + 15 * CW { _web_load(state); return 0; }
    return 0;
}
fn _draw_web(state, win, sz) {
    let w = state.web;
    let maxchars = (sz.w - 2 * PAD) / CW;
    // web IDE browser bar
    let barh = CH + 3 * PAD;
    win.rect(0, TOP, sz.w, barh, _style_surface(state));
    win.rect(0, TOP + barh, sz.w, SCALE, BORDER);
    let bx = PAD;
    win.rect(bx, TOP + PAD, 6 * CW, CH + PAD, _style_surface2(state));
    _dt(win, bx + CW, TOP + PAD + PAD / 2, "Back", GUTTER);
    win.rect(bx + 7 * CW, TOP + PAD, 8 * CW, CH + PAD, _style_surface2(state));
    _dt(win, bx + 8 * CW, TOP + PAD + PAD / 2, "Reload", GUTTER);
    let modeX = bx + 16 * CW;
    let m1 = "Reader";
    let m2 = "Links";
    let m3 = "Forms";
    let mbg = _style_surface2(state);
    let abg = _style_accent(state);
    let bg1 = mbg; if w.mode == "reader" { bg1 = abg; }
    let bg2 = mbg; if w.mode == "links" { bg2 = abg; }
    let bg3 = mbg; if w.mode == "forms" { bg3 = abg; }
    win.rect(modeX, TOP + PAD, 8 * CW, CH + PAD, bg1); _dt(win, modeX + CW, TOP + PAD + PAD / 2, m1, FG);
    win.rect(modeX + 8 * CW, TOP + PAD, 7 * CW, CH + PAD, bg2); _dt(win, modeX + 9 * CW, TOP + PAD + PAD / 2, m2, FG);
    win.rect(modeX + 15 * CW, TOP + PAD, 7 * CW, CH + PAD, bg3); _dt(win, modeX + 16 * CW, TOP + PAD + PAD / 2, m3, FG);
    let urlX = modeX + 23 * CW;
    let urlW = sz.w - urlX - 14 * CW;
    if urlW > 10 * CW {
        win.rect(urlX, TOP + PAD, urlW, CH + PAD, _style_surface2(state));
        win.rect(urlX, TOP + PAD, urlW, SCALE, BORDER);
    }
    let addr = "URL › " + w.input;
    let urlChars = urlW / CW - 2;
    if urlChars > 4 { _dt(win, urlX + CW, TOP + PAD + PAD / 2, str_slice(addr, 0, urlChars), FG); }
    let cursorCol = len(addr);
    let cur = cursorCol; if cur > urlChars { cur = urlChars; }
    if urlChars > 4 { win.rect(urlX + CW + cur * CW, TOP + PAD + PAD / 2, SCALE, CH - SCALE, CURSOR); }
    _dt(win, sz.w - 12 * CW, TOP + PAD + PAD / 2, try w.status catch "ready", GUTTER);

    let bodyTop = TOP + barh + 2 * PAD;
    win.rect(0, bodyTop - PAD, sz.w, sz.h - bodyTop + PAD, _style_bg(state));
    let colW = 78 * CW;
    if colW > sz.w - 4 * PAD { colW = sz.w - 4 * PAD; }
    let colX = (sz.w - colW) / 2;
    win.rect(colX - PAD, bodyTop, colW + 2 * PAD, sz.h - bodyTop - PAD, _style_panel(state));
    if w.title != "" { _dt(win, colX, bodyTop + PAD, str_slice(w.title, 0, colW / CW), _style_accent(state)); bodyTop = bodyTop + CH + 3 * PAD; }
    let source = w.reader;
    if w.mode == "links" { source = w.links; }
    if w.mode == "forms" { source = try w.forms catch ["No forms found on this page."]; }
    if source == nil { source = w.lines; }
    let rows = (sz.h - bodyTop - PAD) / CH;
    if w.scroll > len(source) - 1 { if len(source) > 0 { w.scroll = len(source) - 1; } else { w.scroll = 0; } }
    let vr = 0;
    while w.scroll + vr < len(source) and vr < rows {
        let ln = source[w.scroll + vr];
        let col = PANEFG;
        if len(ln) > 0 and strcharcodeat(ln, 0) == 62 { col = TABACT; }     // '>' link line
        _dt(win, colX, bodyTop + vr * CH, str_slice(ln, 0, colW / CW), col);
        vr = vr + 1;
    }
}

// ── shortcuts overlay (F1) — ported from the web IDE's #shortcuts-overlay ─────────
let HELP = [
    "pblang IDE  -  KEYBOARD SHORTCUTS            F1 or Esc to close",
    "",
    "GLOBAL    click Code/Term/AI/Designer/Browser to switch panels",
    "          F2 Code   F3 Terminal   F4 Designer   F7 AI   F8 Browser",
    "          F1 toggle this help",
    "",
    "CODE      F5 run    F6 check    Ctrl+S save    Ctrl+O open    Ctrl+F find",
    "          Ctrl+Z / Ctrl+Y  undo / redo     Ctrl+C/X/V  copy/cut/paste",
    "          Ctrl+A select all     arrows move     hold a key to repeat",
    "          Ctrl+Left/Right word jump    Ctrl+Up/Down 5 lines",
    "          Ctrl+Home/End document edge   Shift+arrow select   PgUp/PgDn",
    "",
    "TERMINAL  type + Enter run a command    Shift+Enter newline    'clear'",
    "",
    "DESIGN    pick a palette tool   click canvas to place   drag to move",
    "          type to edit text     Del delete     ->CODE generate source",
    "",
    "AI        type + Enter ask pbAI    Shift+Enter newline",
    "          EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT  run pbAI on editor code",
    "",
    "BROWSER   URL + Enter load    Up/Down/PgUp/PgDn scroll",
    "",
    "STYLE     click Style to cycle Pixel / Smooth / Contrast palettes.",
    "          Set PBIDE_SCALE=1 before launch for smaller less-pixelated text.",
    "",
    "Launch from a shell with:   pblang --ide",
];
fn _draw_help(win, sz) {
    win.clear(gfx.rgb(10, 12, 20));                  // modal backdrop
    let maxw = 0;
    let i = 0;
    while i < len(HELP) { if len(HELP[i]) > maxw { maxw = len(HELP[i]); } i = i + 1; }
    let bw = maxw * CW + 4 * PAD;
    let bh = len(HELP) * CH + 4 * PAD;
    let bx = (sz.w - bw) / 2; if bx < 0 { bx = 0; }
    let by = (sz.h - bh) / 2; if by < 0 { by = 0; }
    win.rect(bx, by, bw, bh, PANEBG);
    win.rect(bx, by, bw, SCALE, TABACT);
    win.rect(bx, by + bh - SCALE, bw, SCALE, TABACT);
    win.rect(bx, by, SCALE, bh, TABACT);
    win.rect(bx + bw - SCALE, by, SCALE, bh, TABACT);
    let r = 0;
    while r < len(HELP) {
        let col = PANEFG;
        if r == 0 { col = TABACT; }
        _dt(win, bx + 2 * PAD, by + 2 * PAD + r * CH, HELP[r], col);
        r = r + 1;
    }
}

// top-level draw: clear, toolbar, then the active panel.
fn _draw(state, win) {
    win.clear(_style_bg(state));
    let sz = win.size();
    state.winsz = sz;                 // cached for mouse → buffer-position mapping
    _draw_toolbar(state, win, sz);
    if state.panel == "code" { _draw_code(state, win, sz); }
    else if state.panel == "term" { _draw_term(state, win, sz); }
    else if state.panel == "design" { _draw_design(state, win, sz); }
    else if state.panel == "ai" { _draw_ai(state, win, sz); }
    else if state.panel == "web" { _draw_web(state, win, sz); }
    if state.help { _draw_help(win, sz); }     // modal overlay, drawn last (on top)
    win.present();
}

// mouse → buffer position. Maps a pixel (mx,my) in the editor area to (row,col), using the
// SAME layout math as _draw: row r sits at y = TOP + (r - scroll)*CH, text starts at GUTTERX.
// Returns nil for clicks outside the editor area (e.g. on the output pane).
fn _mouse_pos(state, mx, my) {
    let ed = state.ed;
    let sz = state.winsz;
    if sz != nil {
        if my >= sz.h - STATUSH { return nil; }
        let editorW = sz.w - _code_output_w_state(state, sz) - SCALE * 3;
        if mx >= editorW { return nil; }
    }
    let vr = (my - TOP) / CH;
    vr = num_floor(vr);
    if vr < 0 { vr = 0; }
    let row = ed.scroll + vr;
    let col = 0;
    if mx > GUTTERX { col = num_floor((mx - GUTTERX + CW / 2) / CW); }  // round to nearest gap
    return map{ row: row, col: col };
}

// place the caret at the mouse, optionally extending the selection (drag).
fn _mouse_place(state, mx, my, extend) {
    let p = _mouse_pos(state, mx, my);
    if p == nil { return 0; }
    let ed = state.ed;
    if extend { if ed.anchor == nil { E.set_anchor(ed); } } else { E.clear_selection(ed); }
    E.set_cursor(ed, p.row, p.col);
    return 0;
}

fn main() {
    // Window sized in glyph cells so it scales with SCALE (≈100 cols × 40 rows).
    let winw = GUTTERX + 5 * CW + 100 * CW + PAD;
    let winh = TOP + 40 * CH + PANEH;
    let win = gfx.Window(winw, winh, "pblang IDE - Smart Code Editor");
    let cwd0 = try env_get("PWD") catch ".";
    if cwd0 == nil { cwd0 = "."; }
    let state = map{
        panel: "code",                                   // active toolbar tab
        ed: E.new(_starter_code()),
        shift: false, ctrl: false, find_mode: false, query: "",
        rows: 40, path: _fallback_path(), last: "other",
        tokens: nil, dirty: true, redraw: true,
        open_mode: false, open_path: "",
        mx: 0, my: 0, mdown: false, winsz: nil,
        style: "pixel",
        term: map{ cwd: cwd0, input: "", lines: ["pblang terminal — runs real PC commands (needs --allow-exec). Try: ls, pwd, cd .."] },
        design: map{ tool: "button", layout: "free", widgets: [], sel: 0 - 1, drag: false, dx: 0, dy: 0, counter: 0 },
        ai: map{ input: "", lines: ["pbAI — pblang's own assistant (no network, no Ollama). Type a question + Enter,", "or use EXPLAIN / BUGS / IMPROVE / QUALITY / COMMENT on the editor buffer."] },
        web: map{ input: "example.com", url: "", title: "", mode: "reader", status: "ready", scroll: 0, reader: ["pblang browser - type a URL + Enter to load. Up/Down scroll."], links: [], forms: ["No forms loaded."], lines: ["pblang browser - type a URL + Enter to load. Up/Down scroll."] },
        help: false,                                     // F1 shortcuts overlay
        output: "ready · click to place cursor · drag to select · F5 run · F6 check · F1 help"
    };
    gfx.run(win, state,
        fn(s, events) {
            let i = 0;
            while i < len(events) {
                let e = events[i];
                if e.type == "keydown" {
                    s.redraw = true;            // any keypress means the view may have changed
                    if e.key == "F1" { s.help = not s.help; }                          // toggle the shortcuts overlay
                    else if s.help { if e.key == "Escape" { s.help = false; } }         // while open, only Esc/F1 act
                    else if K.is_shift(e.key) { s.shift = true; }
                    else if e.key == "LCtrl" or e.key == "RCtrl" { s.ctrl = true; }
                    else if e.key == "F2" { s.panel = "code"; }
                    else if e.key == "F3" { s.panel = "term"; }
                    else if e.key == "F4" { s.panel = "design"; }
                    else if e.key == "F7" { s.panel = "ai"; }
                    else if e.key == "F8" { s.panel = "web"; }
                    else if s.panel == "term" { _term_key(s, e.key, s.shift); }        // terminal owns its input line
                    else if s.panel == "design" { _design_key(s, e.key, s.shift); }    // designer: edit/delete selected widget
                    else if s.panel == "ai" { _ai_key(s, e.key, s.shift); }            // AI panel owns its question box
                    else if s.panel == "web" { _web_key(s, e.key, s.shift); }          // browser owns its address bar
                    else if s.panel == "code" { let st = _key(s, e.key); if st != "" { s.output = st; } }
                }
                if e.type == "keyup" {
                    if K.is_shift(e.key) { s.shift = false; }
                    if e.key == "LCtrl" or e.key == "RCtrl" { s.ctrl = false; }
                }
                // mousedown carries no coords (like gui.sapp) — use the tracked cursor.
                if e.type == "mousemove" {
                    s.mx = e.x; s.my = e.y;
                    if s.mdown and s.panel == "code" { _mouse_place(s, e.x, e.y, true); s.redraw = true; }  // drag = extend selection
                    if s.panel == "design" and s.design.drag and s.design.sel >= 0 {                       // drag = move widget
                        let w = s.design.widgets[s.design.sel];
                        w.x = e.x - s.design.dx; w.y = e.y - s.design.dy;
                        s.redraw = true;
                    }
                }
                if e.type == "mousedown" and (try e.button catch "Left") == "Left" {
                    // Prefer the click's OWN coordinates (the host now attaches x/y to
                    // mousedown); fall back to the tracked cursor only if absent. Using a
                    // stale tracked position is what made tab clicks land on random tabs.
                    let dx = try e.x catch s.mx;
                    let dy = try e.y catch s.my;
                    s.mx = dx; s.my = dy;
                    let tab = _toolbar_hit(dx, dy, s.winsz);
                    if tab != nil { _toolbar_click(s, tab); s.redraw = true; }         // web-style toolbar action
                    else {
                        s.mdown = true;
                        if s.panel == "code" { _mouse_place(s, dx, dy, false); }       // click = place caret
                        else if s.panel == "design" { _design_click(s, dx, dy); }      // place/select a widget
                        else if s.panel == "ai" { let act = _ai_hit(dx, dy); if act != nil { _ai_action(s, act); } }  // quick action
                        else if s.panel == "web" { _web_click(s, dx, dy); }
                        s.redraw = true;
                    }
                }
                if e.type == "mouseup" { s.mdown = false; s.design.drag = false; }
                i = i + 1;
            }
        },
        // Only repaint when something changed (idle frames are nearly free). The first
        // frame draws because redraw starts true.
        fn(s, w) { if s.redraw { _draw(s, w); s.redraw = false; } },
        20);
}
main();
