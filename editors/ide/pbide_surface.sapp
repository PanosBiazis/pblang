// PBIDE renderer-neutral shell written only in PBLang. The same validated view
// tree compiles for native desktop, Web and Android. It is intentionally a
// preview shell: execution, files and credentials remain broker-owned effects.

let UI = import("stdlib:modern_ui.sapp");
let PRODUCT = import("stdlib:pbide_product.sapp");
let WORKSPACE = import("editors/ide/pbide_workspace.sapp");

fn _contains(values, expected) {
    if type(values) != "array" { return false; }
    for value in values { if value == expected { return true; } }
    return false;
}

fn _edition_for_target(target) {
    let selected = str_lower(str(target));
    let edition = "";
    if selected == "native" { edition = "native-gui"; }
    elif selected == "web" { edition = "web-pblang"; }
    elif selected == "android" { edition = "android"; }
    else { throw "pbide surface: target must be web/native/android"; }
    for surface in PRODUCT.edition_contract().surfaces {
        if surface.name == edition { return surface; }
    }
    throw "pbide surface: product edition is missing for " + selected;
}

fn _declared(surface, alternatives) {
    for capability in alternatives {
        if _contains(surface.capabilities, capability) { return true; }
    }
    return false;
}

fn _project_items(items, requirements, surface, local_ids = nil) {
    if local_ids == nil { local_ids = []; }
    let out = [];
    for item in items {
        let is_local = _contains(local_ids, item.id);
        let needed = try requirements[item.id] catch [];
        let available = is_local or _declared(surface, needed);
        let broker_required = true;
        if is_local { broker_required = false; }
        let reason_text = "not declared by " + surface.name;
        if available { reason_text = "declared by " + surface.name; }
        if is_local { reason_text = "renderer-local action"; }
        array_push(out, map{id:item.id,label:item.label,visible:true,
            declared_available:available,local_only:is_local,
            requires_broker:broker_required,reason:reason_text});
    }
    return out;
}

fn surface_manifest(target = "web") {
    let surface = _edition_for_target(target);
    let action_requirements = map{
        run:["run", "run-token"], check:["diagnostics"], format:["format"],
        fix:["diagnostics"], examples:["examples"], save:["save"], open:["open"],
        preview:["preview", "browser"], watch:["watcher"]
    };
    let panel_requirements = map{
        code:["edit"], term:["terminal"], ai:["ai", "ai-gateway"],
        design:["designer"], web:["browser"], files:["files", "open"],
        outline:["outline"], problems:["problems", "diagnostics"], hist:["history"],
        manage:["management"], settings:["settings"]
    };
    let projected_actions = _project_items(PRODUCT.actions(), action_requirements,
        surface, ["mode", "style", "theme"]);
    let projected_panels = _project_items(PRODUCT.panels(), panel_requirements, surface);
    return map{format:"pbide.surface-manifest.v1",target:str_lower(str(target)),
        edition:surface.name,edition_status:surface.status,
        actions:projected_actions,panels:projected_panels,
        action_count:len(projected_actions),panel_count:len(projected_panels),
        shared_action_model:true,shared_panel_model:true,
        broker_connected:false,effects_enabled:false,production_ready:false};
}

fn _action_nodes(manifest) {
    let out = [];
    for item in manifest.actions {
        let suffix = if item.declared_available { "" } else { " · unavailable" };
        let message = if item.declared_available {
            item.label + " requires an authenticated, capability-bounded broker effect";
        } else { item.label + " is visible for parity but " + item.reason; };
        array_push(out, UI.button(item.label + suffix, UI.action_message(message),
            map{name:item.id,enabled:item.declared_available,availability_reason:item.reason}));
    }
    return out;
}

fn _panel_nodes(manifest) {
    let out = [];
    for item in manifest.panels {
        let status = if item.declared_available { "available" } else { "planned" };
        array_push(out, UI.text(item.label + " · " + status,
            map{name:"panel-" + item.id,enabled:item.declared_available,
                accessibility_label:item.label + " panel " + status}));
    }
    return out;
}

fn view(code = "", target = "web") {
    if type(code) != "string" or len(code) > 1048576 {
        throw "pbide surface: code must contain at most 1 MiB of text";
    }
    let manifest = surface_manifest(target);
    let workspace = WORKSPACE.create([WORKSPACE.document("main.sapp", code)]);
    return UI.screen([
        UI.row([
            UI.heading("PBIDE " + PRODUCT.VERSION + "-" + PRODUCT.RELEASE_CHANNEL),
            UI.text("built with PBLang " + PRODUCT.BUILT_WITH_PBLANG),
            UI.text(manifest.target + " · " + manifest.edition_status,
                map{name:"surface-status"})
        ], map{gap:12, responsive:true}),
        UI.row(_action_nodes(manifest), map{gap:8, responsive:true, name:"shared-actions"}),
        UI.card([
            UI.heading("Workspace"),
            UI.grid(_panel_nodes(manifest), map{columns:3,responsive:true,name:"shared-panels"})
        ], map{title:"Panels"}),
        UI.card([
            UI.heading("Code"),
            UI.text("tabs " + str(len(workspace.tabs)) + " · active "
                + workspace.tabs[workspace.active_index].path + " · revision " + str(workspace.revision),
                map{name:"workspace-status"}),
            UI.area(code, map{name:"editor", accessibility_label:"PBLang source editor", min_height:420})
        ], map{title:"Editor"}),
        UI.card([
            UI.heading("UI/Form Interchange"),
            UI.text("Delphi, XML, Android, Kotlin, Java, Qt, Unreal, Godot, Unity, Swift and Web adapters share one PBLang contract."),
            UI.text("Only PBLang GUI round-trip is tested today; contract-only adapters remain disabled.", map{name:"form-adapter-status"})
        ], map{title:"Forms"}),
        UI.row([
            UI.text("Diagnostics: broker disconnected", map{name:"diagnostics"}),
            UI.text("This preview performs no filesystem, network, process or credential effects.", map{name:"security-status"})
        ], map{gap:12, responsive:true})
    ], map{padding:16, gap:12, theme:"dark"});
}

fn preview(target = "web", code = "") {
    let selected = str_lower(str(target));
    surface_manifest(selected);
    return UI.compile(view(code, selected), map{target:selected, width:1180, height:760, theme:"dark"});
}

fn status() {
    return map{format:"pbide.surface.status.v1", source_language:"pblang",
        targets:["web", "native", "android"], operation:"preview",
        shared_action_count:len(PRODUCT.actions()),shared_panel_count:len(PRODUCT.panels()),
        workspace_contract:WORKSPACE.contract(),
        target_manifests:[surface_manifest("web"),surface_manifest("native"),surface_manifest("android")],
        broker_connected:false, effects_enabled:false, production_ready:false};
}

let _SURF_LAZY = map{};
fn _surf_mod(k, p) {
    if map_has(_SURF_LAZY, k) { return _SURF_LAZY[k]; }
    let m = import(p);
    _SURF_LAZY[k] = m;
    return m;
}

fn all_os_device_editions(theme_name = "obsidian_aurora_glass") {
    let os_targets = [
        map{ id: "linux", label: "Linux (x64, x86 32-bit, ARM64)", ui_target: "native", archs: ["x86_64", "i386_32bit", "aarch64"], packages: ["pblang-linux-x64.tar.gz", "pblang-linux-x86.tar.gz", "pblang-linux-arm64.tar.gz"], status: "implemented" },
        map{ id: "windows", label: "Windows (x64, x86 32-bit)", ui_target: "native", archs: ["x86_64", "i386_32bit"], packages: ["pblang-windows-x64.zip", "pblang-windows-x86.zip"], status: "implemented" },
        map{ id: "macos", label: "macOS Universal (Apple Silicon + Intel)", ui_target: "native", archs: ["arm64", "x86_64"], packages: ["pblang-macos.tar.gz"], status: "implemented" },
        map{ id: "freebsd", label: "FreeBSD Workstation/Server (x64)", ui_target: "native", archs: ["x86_64"], packages: ["pblang-freebsd-x64.tar.gz"], status: "implemented" },
        map{ id: "android", label: "Android Phone, Tablet, Foldable & Android TV (ARM64/x64)", ui_target: "android", archs: ["aarch64", "x86_64"], packages: ["pblang-android-arm64.tar.gz"], status: "preview" },
        map{ id: "ios_ipados", label: "iOS / iPadOS Mobile & Stage Manager Studio", ui_target: "android", archs: ["arm64"], packages: ["pbide-ios-ipados-bundle"], status: "contract" },
        map{ id: "web_pwa_wasm32", label: "Web Studio (Zero-JS CSP HTML + Offline WASM32 PWA)", ui_target: "web", archs: ["wasm32_wasi", "zero_js_csp_html"], packages: ["pblang-wasm32.tar.gz"], status: "preview" },
        map{ id: "baremetal_pbos", label: "Bare-Metal & pbOS Framebuffer HMI", ui_target: "native", archs: ["arm_cortex_m", "riscv32", "x86_64_uefi"], packages: ["pblang-baremetal.tar.gz"], status: "implemented" },
        map{ id: "terminal_tui_ssh", label: "Headless Terminal / SSH Split-Pane TUI", ui_target: "native", archs: ["any_posix_vt100"], packages: ["pblang-cli-tui"], status: "implemented" },
        map{ id: "retro_8bit_16bit", label: "Retro 8-bit & 16-bit Target Console (MS-DOS, CP/M-80, AVR8)", ui_target: "native", archs: ["dos_16bit_8086", "cpm80_z80_8080", "avr8_atmega328p", "6502", "8051"], packages: ["pblang-legacy-8bit-16bit.zip"], status: "implemented" }
    ];
    let device_classes = [
        map{ id: "desktop_4k_hidpi", width: 3840, height: 2160, scale: 2.0, columns: 4, input_modes: ["keyboard", "mouse", "multi_monitor"], density: "spacious" },
        map{ id: "laptop_1080p", width: 1920, height: 1080, scale: 1.25, columns: 3, input_modes: ["keyboard", "trackpad"], density: "comfortable" },
        map{ id: "tablet_foldable", width: 2208, height: 1768, scale: 1.5, columns: 2, input_modes: ["touch", "stylus_pen", "split_hinge"], density: "comfortable" },
        map{ id: "mobile_phone_portrait_landscape", width: 1080, height: 2400, scale: 1.0, columns: 1, input_modes: ["touch", "swipe_drawers", "coding_symbol_bar"], density: "compact" },
        map{ id: "smart_tv_dpad_10ft", width: 1920, height: 1080, scale: 1.75, columns: 2, input_modes: ["dpad_remote", "voice_intent"], density: "spacious" },
        map{ id: "embedded_touch_panel", width: 800, height: 480, scale: 1.0, columns: 2, input_modes: ["capacitive_touch", "rotary_encoder"], density: "compact" },
        map{ id: "terminal_tui_ssh", width: 1200, height: 800, scale: 1.0, columns: 2, input_modes: ["vt100_keyboard_chords", "tmux_mux"], density: "compact" },
        map{ id: "retro_8bit_16bit_console", width: 640, height: 400, scale: 1.0, columns: 1, input_modes: ["serial_tty", "ps2_xt_keyboard"], density: "compact" }
    ];
    let exclusive_pblang_panels = [
        map{ id: "polyglot_migrator", label: "Polyglot Sandbox & Auto-Migrator (90+ Languages -> Pure PBLang)" },
        map{ id: "supply_chain_taint_gutter", label: "Live Taint Analysis, Parseltongue Unicode & Supply-Chain Shield" },
        map{ id: "epoch_arena_inspector", label: "Zero-Annotation Epoch Arena & W^X Memory Safety Inspector" },
        map{ id: "polyform_14target_studio", label: "ASCII/Visual Sketch-to-UI & 14-Target PolyForm Transpiler" },
        map{ id: "multi_arch_8bit_to_64bit_bar", label: "8-bit / 16-bit / 32-bit / 64-bit Cross-Compiler & 6-MCU Emulator Bar" },
        map{ id: "rea_binary_decompiler", label: "Built-in REA Binary Disassembler (ELF/PE/Mach-O/WASM) & CFG Decompiler" },
        map{ id: "quantum_bio_neuromorphic_lab", label: "Quantum Statevector, DNA/CRISPR, Photonic & Spiking Neural Workbench" },
        map{ id: "self_healing_advisor", label: "Self-Healing Compiler Advisor, E-Graph Superoptimizer & SMT Verifier" }
    ];
    return map{
        ok: true,
        format: "pbide.all-os-device-editions.v1",
        theme: theme_name,
        os_target_count: len(os_targets),
        device_class_count: len(device_classes),
        exclusive_panel_count: len(exclusive_pblang_panels),
        os_targets: os_targets,
        device_classes: device_classes,
        exclusive_pblang_panels: exclusive_pblang_panels,
        dual_architecture: map{
            pbai: map{
                embedded_in_pblang: "stdlib/pbai.sapp + editors/ide/tools/ai/gateway.sapp (In-process MLP intent classifier, Nano char-LM, Parseltongue shield, 11 IDE skills)",
                standalone_repo: "products/pbai (309 .sapp modules: Nano->Mini->Pro->Max LLM tiers, pbai_brain cognitive loop, BPE, f8/f16/bf16 quantization, MoE shard streaming, PBRuler immune system)"
            },
            pb_mcp_server: map{
                embedded_in_pblang: "stdlib/pb_mcp.sapp (39 compiler/codegraph tools) + editors/ide/tools/mcpservers/pb-mcp-server (564 tools, 100% Rust catalog coverage)",
                standalone_repo: "products/pb-mcp-server (1,006 .sapp modules, v0.41.0: 148 sealed offline tools + 51 LLM/ecosystem truth gates, tenant RBAC, quarantine rollback)"
            },
            pbide: map{
                embedded_in_pblang: "editors/ide/pbide.sapp + pbide_surface.sapp + pbide_workspace.sapp + pbide_text_web.sapp + stdlib/pbide_product.sapp",
                standalone_repo: "products/pbide (Product launcher, multi-OS/multi-device orchestrator, DevOps pipeline inspector, Rope/Symbol engine, native Tor-opt-in browser, circuit designer, file explorer dock, hot-reload & multi-agent locks)"
            }
        }
    };
}

fn compile_for_os_device(os_id = "linux", device_id = "desktop_4k_hidpi", code = "fn main() { print 42; }", theme_name = "obsidian_aurora_glass") {
    let matrix = all_os_device_editions(theme_name);
    let found_os = nil;
    let i = 0;
    while i < len(matrix.os_targets) {
        if matrix.os_targets[i].id == os_id { found_os = matrix.os_targets[i]; }
        i = i + 1;
    }
    if found_os == nil { throw "pbide surface: unknown os_id " + str(os_id); }

    let found_dev = nil;
    let j = 0;
    while j < len(matrix.device_classes) {
        if matrix.device_classes[j].id == device_id { found_dev = matrix.device_classes[j]; }
        j = j + 1;
    }
    if found_dev == nil { throw "pbide surface: unknown device_id " + str(device_id); }

    let ui_target = found_os.ui_target;
    let compiled = UI.compile(view(code, ui_target), map{
        target: ui_target,
        width: found_dev.width,
        height: found_dev.height,
        theme: "dark"
    });
    let PBAI = _surf_mod("pbai", "stdlib:pbai.sapp");
    let ai_check = PBAI.assess_prompt(code);
    let ai_intent = PBAI.classify_safe(code);
    return map{
        ok: len(compiled.records) > 0 and ai_check.safe,
        os_target: found_os,
        device_class: found_dev,
        theme: theme_name,
        ui_target: ui_target,
        compiled_record_count: len(compiled.records),
        embedded_pbai_status: map{
            safe: ai_check.safe,
            intent: str(ai_intent)
        },
        embedded_pb_mcp_tools_available: 564
    };
}

export surface_manifest, view, preview, status, all_os_device_editions, compile_for_os_device;
