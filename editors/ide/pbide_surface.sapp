// PBIDE renderer-neutral shell written only in PBLang. The same validated view
// tree compiles for native desktop, Web and Android. It is intentionally a
// preview shell: execution, files and credentials remain broker-owned effects.

let UI = import("stdlib:modern_ui.sapp");
let PRODUCT = import("stdlib:pbide_product.sapp");

fn view(code = "") {
    if type(code) != "string" or len(code) > 1048576 {
        throw "pbide surface: code must contain at most 1 MiB of text";
    }
    return UI.screen([
        UI.row([
            UI.heading("PBIDE " + PRODUCT.VERSION + "-" + PRODUCT.RELEASE_CHANNEL),
            UI.text("built with PBLang " + PRODUCT.BUILT_WITH_PBLANG)
        ], map{gap:12, responsive:true}),
        UI.row([
            UI.button("Run", UI.action_message("Run requires the authenticated bounded execution broker"), map{name:"run"}),
            UI.button("Check", UI.action_message("Check requires the bounded compiler worker"), map{name:"check"}),
            UI.button("Format", UI.action_message("Format requires an explicit editor action"), map{name:"format"}),
            UI.button("Open", UI.action_message("Open requires a user-selected file capability"), map{name:"open"}),
            UI.button("Save", UI.action_message("Save requires a scoped write capability"), map{name:"save"})
        ], map{gap:8, responsive:true}),
        UI.card([
            UI.heading("Code"),
            UI.area(code, map{name:"editor", accessibility_label:"PBLang source editor", min_height:420})
        ], map{title:"Editor"}),
        UI.card([
            UI.heading("UI/Form Interchange"),
            UI.text("Delphi, XML, Android, Kotlin, Java, Qt, Unreal, Godot, Unity, Swift and Web adapters share one PBLang contract."),
            UI.text("Only PBLang GUI round-trip is tested today; contract-only adapters remain disabled.", map{name:"form-adapter-status"})
        ], map{title:"Forms"}),
        UI.row([
            UI.text("Diagnostics: broker disconnected", map{name:"diagnostics"}),
            UI.text("This preview performs no filesystem, network, process or credential effects.", map{name:"security-status"})
        ], map{gap:12, responsive:true})
    ], map{padding:16, gap:12, theme:"dark"});
}

fn preview(target = "web", code = "") {
    let selected = str_lower(str(target));
    if selected != "web" and selected != "native" and selected != "android" {
        throw "pbide surface: target must be web/native/android";
    }
    return UI.compile(view(code), map{target:selected, width:1180, height:760, theme:"dark"});
}

fn status() {
    return map{format:"pbide.surface.status.v1", source_language:"pblang",
        targets:["web", "native", "android"], operation:"preview",
        broker_connected:false, effects_enabled:false, production_ready:false};
}

export view, preview, status;
