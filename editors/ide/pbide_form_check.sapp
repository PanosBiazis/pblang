// Selected-buffer analysis. No file access, imported handlers or source evaluation.
let Forms=import("stdlib:ui_form_check.sapp");
let MAX_BYTES=65536;
fn check(source) {
    let report=nil;
    if type(source)=="string" and len(source)<=MAX_BYTES and len(str_to_bytes(source))<=MAX_BYTES {
        report=try Forms.analyze_dfm(source) catch nil;
    }
    let message="Form preflight unavailable: use a supported text DFM within the analysis budget.";
    let ok=report!=nil and report.ok;
    if ok {
        message="Web structure supported: "+str(report.widgets)+" controls, "+str(report.input_fields)+" editable fields. "
            +"Unmapped properties: "+str(report.unmapped_properties)+"; unmapped events: "+str(report.unmapped_events)+". "
            +"Imported handlers are inactive; application conversion is incomplete.";
    }
    return map{format:"pbide.form-check.v1",ok:ok,count:1,
        diagnostics:[map{kind:if ok {"info"} else {"error"},message:message}],report:report};
}
export check,MAX_BYTES;
