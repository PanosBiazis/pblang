// Flat browser-carried snapshots, not authentication or encrypted storage.
// No recursive parser, budget fields, paths, commands or external effects.
let History=import("editors/ide/pbide_text_history.sapp");
let Text=import("editors/ide/pbide_text.sapp");
let BUDGET=8192;
let FRAME_BYTES=4096;
let MAX_ENCODED=16640;
fn _number(text,maximum) {
    if len(text)<1 or len(text)>4 { throw "invalid history number"; }
    let i=0;
    while i<len(text) {
        if not str_contains("0123456789",str_slice(text,i,i+1)) { throw "invalid history number"; }
        i=i+1;
    }
    let value=parse_number(text);
    if value>maximum or str(value)!=text { throw "noncanonical history number"; }
    return value;
}
fn _source(text) {
    if type(text)!="string" or len(str_to_bytes(text))>FRAME_BYTES
        or str_contains(text,strfromcharcode(0)) or str_contains(text,"\r") {
        throw "invalid history text";
    }
    return text;
}
fn encode(history) {
    if history.format!=History.FORMAT or history.budget!=BUDGET { throw "invalid web history"; }
    let h=History.restore(history.frames,history.cursor,BUDGET);
    let parts=[History.FORMAT,str(h.cursor),str(len(h.frames))];
    for frame in h.frames {
        push(parts,str(frame.start)); push(parts,str(frame.end)); push(parts,hex_encode(_source(frame.text)));
    }
    let encoded=str_join(parts,"|");
    if len(encoded)>MAX_ENCODED { throw "history wire limit exceeded"; }
    return encoded;
}
fn decode(encoded) {
    if type(encoded)!="string" or len(encoded)>MAX_ENCODED { throw "history wire limit exceeded"; }
    // Convert once: indexed Unicode string slicing in the retained VM rebuilds
    // a character vector. Byte-array scanning avoids quadratic full-string work.
    let encoded_bytes=str_to_bytes(encoded);
    if len(encoded_bytes)>MAX_ENCODED { throw "history wire limit exceeded"; }
    // Bound the number of split tokens before allocating the token array.
    let separators=0; let i=0;
    while i<len(encoded_bytes) {
        if encoded_bytes[i]==124 { separators=separators+1; }
        if separators>29 { throw "history field limit exceeded"; }
        i=i+1;
    }
    let parts=str_split(encoded,"|");
    if len(parts)<6 or parts[0]!=History.FORMAT { throw "invalid history format"; }
    let count=_number(parts[2],History.MAX_FRAMES);
    if count<1 or len(parts)!=3+3*count { throw "invalid history field count"; }
    let cursor=_number(parts[1],count-1); let frames=[]; let total=0;
    for n in range(0,count) {
        let start=_number(parts[3+n*3],Text.MAX_CHARS);
        let end=_number(parts[4+n*3],Text.MAX_CHARS);
        let hex=parts[5+n*3]; let hex_bytes=str_to_bytes(hex); let size=len(hex_bytes)/2;
        if num_floor(size)!=size or size>FRAME_BYTES or total+size>BUDGET {
            throw "history byte limit exceeded";
        }
        let j=0;
        while j<len(hex_bytes) {
            let byte=hex_bytes[j];
            if not ((byte>=48 and byte<=57) or (byte>=97 and byte<=102)) { throw "invalid history hex"; }
            j=j+1;
        }
        let text=_source(hex_decode(hex));
        push(frames,Text.selection(text,start,end)); total=total+size;
    }
    return History.restore(frames,cursor,BUDGET);
}
export BUDGET,FRAME_BYTES,MAX_ENCODED,encode,decode;
