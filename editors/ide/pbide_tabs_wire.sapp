// Bounded browser-carried drafts. No files, evaluator or server persistence.
let H=import("editors/ide/pbide_text_history.sapp");
let W=import("editors/ide/pbide_history_wire.sapp");
let T=import("editors/ide/pbide_text.sapp");
let FORMAT="pbide.web-drafts.v1";
let MAX_TABS=4;
let MAX_ENCODED=17664;
fn _id(value) {
    if type(value)!="number" or not (value>=1 and value<=MAX_TABS)
        or value!=num_floor(value) { throw "invalid draft id"; }
    return value;
}
fn _number(text) {
    if type(text)!="string" or len(text)!=1 or not str_contains("1234",text) {
        throw "invalid draft number";
    }
    return parse_number(text);
}
fn restore(active,tabs) {
    _id(active);
    if type(tabs)!="array" or len(tabs)<1 or len(tabs)>MAX_TABS { throw "draft count exceeded"; }
    let copies=[]; let seen=map{}; let found=false; let total=0;
    for tab in tabs {
        let id=_id(tab.id);
        if map_has(seen,str(id)) { throw "duplicate draft id"; }
        seen[str(id)]=true;
        let history=W.decode(W.encode(tab.history));
        for frame in history.frames {
            total=total+len(str_to_bytes(frame.text));
            if total>W.BUDGET { throw "combined draft history limit exceeded"; }
        }
        if id==active { found=true; }
        push(copies,map{id:id,history:history});
    }
    if not found { throw "active draft missing"; }
    return map{format:FORMAT,active:active,tabs:copies};
}
fn _copy(state) {
    if state.format!=FORMAT { throw "unsupported drafts format"; }
    return restore(state.active,state.tabs);
}
fn create(history) { return restore(1,[map{id:1,history:history}]); }
fn current(state) {
    let copy=_copy(state);
    for tab in copy.tabs { if tab.id==copy.active { return tab.history; } }
    throw "active draft missing";
}
fn replace(state,history) {
    let copy=_copy(state);
    for tab in copy.tabs { if tab.id==copy.active { tab.history=history; } }
    return restore(copy.active,copy.tabs);
}
fn select(state,id) { let copy=_copy(state); return restore(_id(id),copy.tabs); }
fn add(state) {
    let copy=_copy(state);
    if len(copy.tabs)>=MAX_TABS { throw "draft count exceeded"; }
    let id=1; let used=map{};
    for tab in copy.tabs { used[str(tab.id)]=true; }
    while map_has(used,str(id)) { id=id+1; }
    push(copy.tabs,map{id:id,history:H.create(T.selection(""),W.BUDGET)});
    return restore(id,copy.tabs);
}
fn discard(state) {
    let copy=_copy(state);
    if len(copy.tabs)==1 { throw "cannot discard final draft"; }
    let kept=[];
    for tab in copy.tabs { if tab.id!=copy.active { push(kept,tab); } }
    return restore(kept[0].id,kept);
}
fn encode(state) {
    let copy=_copy(state); let parts=[FORMAT,str(copy.active),str(len(copy.tabs))];
    for tab in copy.tabs { push(parts,str(tab.id)); push(parts,W.encode(tab.history)); }
    let out=str_join(parts,"~");
    if len(str_to_bytes(out))>MAX_ENCODED { throw "draft wire limit exceeded"; }
    return out;
}
fn decode(encoded) {
    if type(encoded)!="string" or len(encoded)>MAX_ENCODED { throw "draft wire limit exceeded"; }
    let bytes=str_to_bytes(encoded);
    if len(bytes)>MAX_ENCODED { throw "draft wire limit exceeded"; }
    let separators=0;
    for byte in bytes {
        if byte==126 { separators=separators+1; }
        if separators>10 { throw "draft field limit exceeded"; }
    }
    let parts=str_split(encoded,"~");
    if len(parts)<5 or parts[0]!=FORMAT { throw "invalid draft format"; }
    let active=_number(parts[1]); let count=_number(parts[2]);
    if len(parts)!=3+2*count { throw "invalid draft field count"; }
    let tabs=[]; let total=0;
    for i count {
        let history=W.decode(parts[4+2*i]);
        for frame in history.frames {
            total=total+len(str_to_bytes(frame.text));
            if total>W.BUDGET { throw "combined draft history limit exceeded"; }
        }
        push(tabs,map{id:_number(parts[3+2*i]),history:history});
    }
    return restore(active,tabs);
}
export FORMAT,MAX_TABS,MAX_ENCODED,restore,create,current,replace,select,add,discard,encode,decode;
