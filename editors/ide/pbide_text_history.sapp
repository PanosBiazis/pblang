// Renderer-neutral, detached undo/redo values. No storage or execution effects.
let Text=import("editors/ide/pbide_text.sapp");
let FORMAT="pbide.text-history.v1";
let MAX_FRAMES=9;
let MAX_BYTES=32768;
fn _integer(value,maximum) {
    if type(value)!="number" or not (value>=0 and value<=maximum)
        or value!=num_floor(value) { throw "invalid history position"; }
    return value;
}
fn _frame(value) { return Text.selection(value.text,value.start,value.end); }
fn restore(frames,cursor,budget=nil) {
    if budget==nil { budget=MAX_BYTES; }
    _integer(budget,MAX_BYTES);
    if budget<1 or type(frames)!="array" or len(frames)<1 or len(frames)>MAX_FRAMES {
        throw "history limit exceeded";
    }
    _integer(cursor,len(frames)-1);
    let copies=[]; let bytes=0;
    for frame in frames {
        let copy=_frame(frame);
        bytes=bytes+len(str_to_bytes(copy.text));
        if bytes>budget { throw "history byte limit exceeded"; }
        push(copies,copy);
    }
    return map{format:FORMAT,frames:copies,cursor:cursor,budget:budget};
}
fn _copy(history) {
    if history.format!=FORMAT { throw "unsupported history"; }
    return restore(history.frames,history.cursor,history.budget);
}
fn create(state,budget=nil) { return restore([state],0,budget); }
fn current(history) { let h=_copy(history); return h.frames[h.cursor]; }
fn commit(history,state) {
    let h=_copy(history); let next=_frame(state);
    if len(str_to_bytes(next.text))>h.budget { throw "history frame exceeds budget"; }
    if next.text==h.frames[h.cursor].text {
        // Selection changes do not add undo steps or invalidate redo.
        h.frames[h.cursor]=next; return h;
    }
    let frames=slice(h.frames,0,h.cursor+1); push(frames,next);
    let total=0; for frame in frames { total=total+len(str_to_bytes(frame.text)); }
    while len(frames)>MAX_FRAMES or total>h.budget {
        total=total-len(str_to_bytes(frames[0].text));
        frames=slice(frames,1,len(frames));
    }
    return restore(frames,len(frames)-1,h.budget);
}
fn undo(history) { let h=_copy(history); if h.cursor>0 { h.cursor=h.cursor-1; } return h; }
fn redo(history) { let h=_copy(history); if h.cursor+1<len(h.frames) { h.cursor=h.cursor+1; } return h; }
fn availability(history) {
    let h=_copy(history);
    return map{undo:h.cursor>0,redo:h.cursor+1<len(h.frames),frames:len(h.frames)};
}
export FORMAT,MAX_FRAMES,MAX_BYTES,restore,create,current,commit,undo,redo,availability;
