// Explicit local launch only. Unsupported bounded transports fail closed.
let Web=import("editors/ide/pbide_text_web.sapp");
let HTTP=import("stdlib:http_server.sapp");
let TCP=import("stdlib:native_tcp.sapp");
HTTP.bounded_server_policy(Web.options(1024));
let listener=TCP.listen_ipv4("127.0.0.1",0,8);
if not listener.ok { throw "PBIDE editor could not bind loopback"; }
let port=listener.port;
print "http://"+Web.endpoint(port)+"/";
let served=try HTTP.serve_bounded_listener(listener,fn(req){return Web.handle(req,port);},Web.options(port)) catch nil;
TCP.close(listener);
if served==nil { throw "PBIDE editor server stopped with an error"; }
