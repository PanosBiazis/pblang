{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pblang",
  "scopeName": "source.pblang",
  "patterns": [
    {"include": "#comments"},
    {"include": "#keywords"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#functions"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pblang",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pblang",
          "match": "\\b(if|else|while|for|return|fn|let|import|export|class|match|case|try|catch|defer|print|nil|true|false|and|or|not|in)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.pblang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.pblang",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.pblang",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.pblang",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
