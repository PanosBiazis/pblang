{
  "name": "pblang",
  "displayName": "pblang Language Support",
  "description": "Language support for pblang (.sapp/.sap files) - syntax highlighting, LSP integration",
  "version": "0.1.0",
  "publisher": "pblang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "activationEvents": [
    "onLanguage:pblang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pblang",
        "aliases": ["pblang", "Sapphire"],
        "extensions": [".sapp", ".sap"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pblang",
        "scopeName": "source.pblang",
        "path": "./syntaxes/pblang.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "pblang.run",
        "title": "pblang: Run current file"
      },
      {
        "command": "pblang.check",
        "title": "pblang: Check current file"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
