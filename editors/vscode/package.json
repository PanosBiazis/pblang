{
  "name": "pblang",
  "displayName": "PBLang Language Support",
  "description": "Language support for PBLang 3.0.0 (.sapp/.sap files) — 9D SI/EUR dimensional types, CAD/Presburger proof-carrying contracts, Markdown hover cards, quick-fix code actions, formatting, and LSP 3.17 integration",
  "version": "3.0.0",
  "publisher": "pblang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "activationEvents": [
    "onLanguage:pblang"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pblang",
        "aliases": ["pblang", "PBLang"],
        "extensions": [".sapp", ".sap"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pblang",
        "scopeName": "source.pblang",
        "path": "./syntaxes/pblang.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "pblang.run",
        "title": "PBLang: Run Current File"
      },
      {
        "command": "pblang.check",
        "title": "PBLang: Check Current File (SI Units & Contracts)"
      },
      {
        "command": "pblang.format",
        "title": "PBLang: Format Document"
      },
      {
        "command": "pblang.doc",
        "title": "PBLang: Generate Markdown Documentation"
      },
      {
        "command": "pblang.repl",
        "title": "PBLang: Open Interactive REPL"
      }
    ],
    "configuration": {
      "title": "PBLang 3.0.0",
      "properties": {
        "pblang.serverPath": {
          "type": "string",
          "default": "pblang",
          "description": "Executable path for the PBLang 3.0.0 runtime and LSP server."
        },
        "pblang.strictMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable strict gradual type checking alongside 9D SI/Currency dimensional analysis."
        },
        "pblang.verifyContracts": {
          "type": "boolean",
          "default": true,
          "description": "Prove or refute requires/ensures contracts at compile time using Tarski CAD and Cooper-Presburger."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
