  "method": {
    "initial_warmups": 2,
    "initial_samples": 15,
    "confirmation_warmups": 2,
    "confirmation_samples": 9,
    "order": "alternating before/after",
    "timing": "GNU time user+system seconds; peak QEMU RSS KiB; nearest-rank p95",
    "compile": "gcc -m32 -O2 -march=i386 -fno-toplevel-reorder -ffreestanding -nostdlib -fno-pie -mgeneral-regs-only",
    "link": "ld -m elf_i386; emitted linker script with ALIGN(4096) before .bss",
    "emitter": "compiler/ctranspile.transpile_kernel_int(heap + gc + interrupts + timer + gc_low_memory + fixture)",
    "qemu": "i386 pc TCG, qemu64, 1 vCPU, 32MiB; no disk/NIC/display/monitor; isa-debug-exit 0xf4, required exit 85",
    "host": "Linux laptop, not CPU-isolated. No other owned tests, builds or analyzers during timed samples.",
    "toolchain": {
      "gcc": "gcc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0",
      "ld": "GNU ld (GNU Binutils for Ubuntu) 2.42",
      "qemu-system-i386": "QEMU emulator version 8.2.2 (Debian 1:8.2.2+ds-0ubuntu1.18)"
    },
    "scope": "QEMU process throughput and RSS, not individual pause, physical-device, energy, GPU/NPU or PB-MCP streaming measurements"
  },
  "workload_sources": {
    "recovery": "// pblang:target=kernel\n// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_alloc gc_set_child gc_add_root gc_live gc_collections gc_alloc_low_memory\n// Same pressure cycle before/after: keep a 130-node rooted ring, reclaim 200\n// leaves from an exhausted arena, allocate one replacement, then 199 leaves.\n// The old retry may perform two collections; the new retry performs one.\nfn check(ok) { if not ok { outb(244,1); while 1>0 { hlt(); } } }\nfn kmain() {\n    let h=kmalloc(8);let region=kmalloc(16384);heap_init(h,region,16384);\n    let g=gc_new(h);check(g!=0);gc_set_auto(g,0);\n    let first=gc_alloc(g,1);check(first!=0);let last=first;let i=1;\n    while i<130 {let next=gc_alloc(g,1);check(next!=0);gc_set_child(last,0,next);last=next;i=i+1;}\n    gc_set_child(last,0,first);check(gc_add_root(g,first)==1);\n    i=0;while i<200 {check(gc_alloc(g,0)!=0);i=i+1;}\n    let filler=heap_alloc(h,8);while filler!=0 {filler=heap_alloc(h,8);}\n    gc_set_threshold(g,0);let pass=0;\n    while pass<10000 {\n        check(peek32(h)==0 and gc_live(g)==330);gc_set_auto(g,1);\n        check(gc_alloc_low_memory(g,0)!=0 and gc_live(g)==131 and peek32(g+4)==1);\n        gc_set_auto(g,0);i=0;while i<199 {check(gc_alloc(g,0)!=0);i=i+1;}\n        pass=pass+1;\n    }\n    check(gc_live(g)==330 and peek32(h)==0 and peek32(last+8)==first);\n    let count=gc_collections(g);check(count==10000 or count==20000);\n    outb(244,42);while 1>0 {hlt();}\n}\n",
    "ring129": "// pblang:target=kernel\n// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_collections gc_live gc_set_child gc_add_root gc_remove_root gc_alloc kernel_gc_collect_low_memory\n// Kernel-only, identical before/after workload within the old table capacities.\n// Prepend heap.sapp and the selected gc.sapp; success is QEMU exit code 85.\nfn kmain() {\n    let h = kmalloc(8); let region = kmalloc(131072); heap_init(h, region, 131072);\n    let g = gc_new(h); gc_set_auto(g, 0);\n    let first = gc_alloc(g, 1); let prev = first; let i = 1;\n    while i < 129 { let next = gc_alloc(g, 1); gc_set_child(prev, 0, next); prev = next; i = i + 1; }\n    gc_set_child(prev, 0, first); gc_add_root(g, first);\n    i = 0; while i < 500000 { kernel_gc_collect_low_memory(g); i = i + 1; }\n    if gc_live(g) != 129 or gc_collections(g) != 500000 { outb(244, 1); }\n    else { outb(244, 42); }\n    while 1 > 0 { hlt(); }\n}\n",
    "mixed": "// pblang:target=kernel\n// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_add_root kernel_gc_collect_low_memory gc_live gc_collections\n// Fixed mixed workload: a 128-object live ring and 16 garbage leaves per pass.\n// Prepend heap.sapp + the selected gc.sapp. QEMU exit 85 means all checks passed.\nfn kmain() {\n    let h=kmalloc(8);let region=kmalloc(131072);heap_init(h,region,131072);\n    let g=gc_new(h);gc_set_auto(g,0);\n    let first=gc_alloc(g,1);let prev=first;let i=1;\n    while i<128 {let next=gc_alloc(g,1);gc_set_child(prev,0,next);prev=next;i=i+1;}\n    gc_set_child(prev,0,first);gc_add_root(g,first);\n    let rounds=0;\n    while rounds<100000 {\n        i=0;while i<16 {\n            if gc_alloc(g,0)==0 {outb(244,1);while 1>0 {hlt();}}\n            i=i+1;\n        }\n        if kernel_gc_collect_low_memory(g)!=0 or gc_live(g)!=128 {outb(244,1);while 1>0 {hlt();}}\n        rounds=rounds+1;\n    }\n    if gc_collections(g)!=100000 {outb(244,1);} else {outb(244,42);}\n    while 1>0 {hlt();}\n}\n"
  },
  "confirmation_workload": "// pblang:target=kernel\n// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_alloc gc_set_child gc_add_root gc_live gc_collections gc_alloc_low_memory\n// Same pressure cycle before/after: keep a 130-node rooted ring, reclaim 200\n// leaves from an exhausted arena, allocate one replacement, then 199 leaves.\n// The old retry may perform two collections; the new retry performs one.\nfn check(ok) { if not ok { outb(244,1); while 1>0 { hlt(); } } }\nfn kmain() {\n    let h=kmalloc(8);let region=kmalloc(16384);heap_init(h,region,16384);\n    let g=gc_new(h);check(g!=0);gc_set_auto(g,0);\n    let first=gc_alloc(g,1);check(first!=0);let last=first;let i=1;\n    while i<130 {let next=gc_alloc(g,1);check(next!=0);gc_set_child(last,0,next);last=next;i=i+1;}\n    gc_set_child(last,0,first);check(gc_add_root(g,first)==1);\n    i=0;while i<200 {check(gc_alloc(g,0)!=0);i=i+1;}\n    let filler=heap_alloc(h,8);while filler!=0 {filler=heap_alloc(h,8);}\n    gc_set_threshold(g,0);let pass=0;\n    while pass<50000 {\n        check(peek32(h)==0 and gc_live(g)==330);gc_set_auto(g,1);\n        check(gc_alloc_low_memory(g,0)!=0 and gc_live(g)==131 and peek32(g+4)==1);\n        gc_set_auto(g,0);i=0;while i<199 {check(gc_alloc(g,0)!=0);i=i+1;}\n        pass=pass+1;\n    }\n    check(gc_live(g)==330 and peek32(h)==0 and peek32(last+8)==first);\n    let count=gc_collections(g);check(count==50000 or count==100000);\n    outb(244,42);while 1>0 {hlt();}\n}\n",
