// Binary64 JSON decoding without the retained JSON number-conversion loss.
// Original host grammar/range admission remains authoritative, including
// overwritten duplicate values. Accepted numeric lexemes use parse_number.
// Fixed token grammar: encode each string as "payload," and each number as
// ",lexeme" before host structural validation. Strings end with a comma;
// JSON numbers never do. Keys use the same injective string encoding.
let _TOKENS = "\"((?:[^\"\\\\]|\\\\.)*)\"|(-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)";

let _STRINGS = "\"(?:[^\"\\\\]|\\\\.)*\"";

fn _number(text, state) {
    let value=try parse_number(text) catch {state.range_error=true;0};
    if value-value != 0 { state.range_error=true;return 0; }
    if state.exact {
        // Separate opt-in mathematical exactness, never transport defaults.
        if len(text)>1024 { state.precision_error="numeric token exceeds 1024 characters";return value; }
        let parts=str_split(str_lower(text),"e");
        let exponent=0;
        if len(parts)==2 { exponent=parse_number(parts[1]); }
        if exponent < -4096 or exponent > 4096 { state.precision_error="exponent outside -4096..4096";return value; }
        let intended=rational(parts[0]);
        if exponent>0 { intended=intended*num_pow(bigint("10"),exponent); }
        // BigInt / BigInt truncates: construct the exact scale fraction explicitly.
        if exponent<0 { intended=intended*rational(1,num_pow(bigint("10"),-exponent)); }
        if intended != rational(value) { state.precision_error="number is not exactly representable as binary64"; }
    }
    return value;
}

fn _restore(value,state) {
    let kind=type(value);
    if kind=="string" {
        let size=len(value);
        if str_ends_with(value,",") { return str_slice(value,0,size-1); }
        return _number(str_slice(value,1,size),state);
    }
    if kind=="array" {
        let i=0;
        while i<len(value) { value[i]=_restore(value[i],state);i=i+1; }
        return value;
    }
    if kind=="map" {
        let result=map{};
        for key in map_keys(value) {
            // Quoting a numeric token must NOT admit a numeric object key.
            if not str_ends_with(key,",") { state.syntax_error=true; }
            else { result[str_slice(key,0,len(key)-1)]=_restore(value[key],state); }
        }
        return result;
    }
    return value; // Native JSON bool/null. Tagged keys cannot invoke operators.
}

fn _parse(text,exact) {
    // Validate every original token first: malformed/overflowing duplicate
    // values must not disappear through native last-key-wins construction.
    let original=json_parse(text);
    if not exact {
        // <=15 digit integer tokens are exactly represented by the retained
        // decoder. Inspect only text OUTSIDE complete strings/escaped keys.
        // Leave decimals, exponents, >=16 digit integers and negative zero on
        // the lexical conversion path; no assumption about their rounding.
        let numeric_text=regex_replace_all(text,_STRINGS,"");
        if not regex_match(numeric_text,"[0-9][.eE]|[0-9]{16}|-0") { return original; }
        numeric_text="";
    }
    original=nil; // Do not retain a second tree on the lexical conversion path.
    let tagged=regex_replace_all(text,_TOKENS,"\"${1},${2}\"");
    let value=json_parse(tagged);
    let state=map{exact:exact,range_error:false,syntax_error:false,precision_error:""};
    let result=_restore(value,state);
    if state.range_error or state.syntax_error {
        throw "json.parse: number outside finite binary64 range or invalid key";
    }
    if state.precision_error!="" { throw "json.parse_exact: "+state.precision_error; }
    return result;
}

// Ordinary finite binary64, including signed zero and underflow to zero.
// Correct rounding is not arbitrary-precision decimal preservation.
fn parse(text) { return _parse(text,false); }
// Reject surviving numeric values requiring rounding. Duplicate keys retain
// native last-wins behavior before this bounded exact-arithmetic value walk.
fn parse_exact(text) { return _parse(text,true); }
export parse, parse_exact;
