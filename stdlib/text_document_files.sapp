// Canonical Writer file adapter; compatibility facades import this implementation.
let Sheet=import("stdlib:text_document.sapp");
let File=import("stdlib:secure_file.sapp");

fn _path(path,extension=".pbtext") {
    if type(path)!="string" or len(path)<=len(extension) or len(path)>4096
        or len(str_to_bytes(path))>4096 or not str_ends_with(str_lower(path),extension) {
        return false;
    }
    for i in range(0,len(path)) {
        let ch=strcharcodeat(path,i);
        if ch<32 or ch==127 { return false; }
    }
    return true;
}
fn open_document(path) {
    if not _path(path) { return map{ok:false,error:"Choose a .pbtext file path."}; }
    let read=try File.read_text(path,Sheet.MAX_FILE_BYTES,false) catch nil;
    if read==nil or not read.ok { return map{ok:false,error:"Could not read the document; current work retained."}; }
    let doc=try Sheet.decode(read.text) catch nil;
    if doc==nil { return map{ok:false,error:"Invalid or unsupported document; current work retained."}; }
    return map{ok:true,document:doc};
}
fn save_copy(path,doc) {
    if not _path(path) { return map{ok:false,error:"Choose a new .pbtext file path."}; }
    let text=try Sheet.encode(doc) catch nil;
    if text==nil { return map{ok:false,error:"Document validation failed; no file written."}; }
    let written=try File.write_text_new_exclusive(path,text,false,false) catch nil;
    if written==nil or not written.ok {
        return map{ok:false,error:"Copy not confirmed. Use a new filename in an existing folder; a failed copy may be incomplete."};
    }
    return map{ok:true,atomic_visibility:false};
}
export open_document,save_copy;
