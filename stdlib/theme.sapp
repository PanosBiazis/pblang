// stdlib/theme.sapp — editor/UI color themes with named roles (pblang-native).
//
// A theme centralizes the colors a UI/editor needs behind semantic ROLES (bg, fg,
// accent, cursor, error, ...) plus per-kind SYNTAX TOKEN colors, instead of scattering
// raw rgb constants. Colors are {r,g,b} maps (use gfx.rgb(c.r,c.g,c.b) to draw). Ships
// dark + light presets, immutable overrides, and WCAG contrast checks (via colors.sapp)
// so a UI can verify text stays readable.
//
//   let theme = import("stdlib:theme.sapp");
//   let t = theme.dark();
//   let bg = theme.role(t, "bg");      // {r,g,b}
//   let kw = theme.token(t, "keyword");
//   if theme.contrast(t, "fg", "bg") < 4.5 { /* warn: low contrast */ }

let C = import("stdlib:colors.sapp");

fn _rgb(r, g, b) { return map{ r: r, g: g, b: b }; }

// Dark = a modern, futuristic palette (deep OLED blacks, electric-violet accent,
// cyan-mint UI text). Includes IDE-specific roles (panel/tab/term/gutter) so an editor
// can derive its entire color scheme from one theme object.
fn _dark_roles() {
    return map{
        bg: _rgb(13, 15, 23), fg: _rgb(229, 234, 245),
        accent: _rgb(138, 124, 255), cursor: _rgb(138, 124, 255),
        gutter: _rgb(98, 114, 152), gutter_bg: _rgb(10, 12, 19),
        // Layered surfaces (bg < surface < surface2) give the UI a modern, elevated,
        // "stacked panels" depth instead of one flat dark slab.
        surface: _rgb(22, 28, 48), surface2: _rgb(30, 38, 64),
        border: _rgb(46, 60, 96), selection: _rgb(48, 58, 96),
        current_line: _rgb(26, 33, 56), muted: _rgb(126, 138, 160),
        error: _rgb(255, 116, 124), warning: _rgb(255, 199, 120),
        success: _rgb(122, 244, 176), info: _rgb(120, 190, 255),
        panel_bg: _rgb(9, 11, 18), panel_2: _rgb(16, 20, 34), panel_fg: _rgb(126, 244, 214),
        tab_bg: _rgb(12, 14, 22), tab_active: _rgb(138, 124, 255),
        term_fg: _rgb(122, 244, 176), term_err: _rgb(255, 116, 124),
    };
}
fn _light_roles() {
    return map{
        bg: _rgb(250, 250, 252), fg: _rgb(28, 30, 38),
        accent: _rgb(90, 60, 200), cursor: _rgb(90, 60, 200),
        gutter: _rgb(140, 150, 165), gutter_bg: _rgb(238, 240, 244),
        surface: _rgb(240, 242, 247), surface2: _rgb(232, 235, 242),
        border: _rgb(205, 210, 220), selection: _rgb(208, 220, 250),
        current_line: _rgb(238, 241, 248), muted: _rgb(120, 128, 140),
        error: _rgb(190, 30, 40), warning: _rgb(160, 110, 20),
        success: _rgb(28, 120, 70), info: _rgb(30, 90, 170),
        panel_bg: _rgb(238, 240, 244), panel_2: _rgb(232, 235, 242), panel_fg: _rgb(28, 120, 110),
        tab_bg: _rgb(232, 235, 242), tab_active: _rgb(90, 60, 200),
        term_fg: _rgb(28, 120, 70), term_err: _rgb(190, 30, 40),
    };
}
fn _dark_tokens() {
    return map{
        keyword: _rgb(201, 132, 252), string: _rgb(162, 242, 211),
        number: _rgb(255, 184, 107), comment: _rgb(107, 122, 153),
        punct: _rgb(255, 121, 198), bool: _rgb(246, 193, 119),
        identifier: _rgb(220, 228, 240),
    };
}
fn _light_tokens() {
    return map{
        keyword: _rgb(110, 64, 180), string: _rgb(28, 116, 78),
        number: _rgb(160, 92, 24), comment: _rgb(92, 105, 125),
        punct: _rgb(170, 54, 112), bool: _rgb(154, 92, 18),
        identifier: _rgb(25, 33, 46),
    };
}

fn dark() { return map{ name: "dark", roles: _dark_roles(), tokens: _dark_tokens() }; }
fn light() { return map{ name: "light", roles: _light_roles(), tokens: _light_tokens() }; }

// role(theme, name) — the color for a role; falls back to fg (then a neutral) if absent.
fn role(theme, name) {
    if map_has(theme.roles, name) { return theme.roles[name]; }
    if map_has(theme.roles, "fg") { return theme.roles["fg"]; }
    return _rgb(200, 200, 200);
}

// token(theme, kind) — syntax token color for a kind; falls back to the fg role.
fn token(theme, kind) {
    if map_has(theme.tokens, kind) { return theme.tokens[kind]; }
    return role(theme, "fg");
}

fn _clone_map(m) {
    let out = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) { out[ks[i]] = m[ks[i]]; i = i + 1; }
    return out;
}

// with_role(theme, name, color) — a NEW theme with one role overridden (original intact).
fn with_role(theme, name, color) {
    let roles = _clone_map(theme.roles);
    roles[name] = color;
    return map{ name: theme.name, roles: roles, tokens: theme.tokens };
}

// with_token(theme, kind, color) — a NEW theme with one syntax token overridden.
fn with_token(theme, kind, color) {
    let tokens = _clone_map(theme.tokens);
    tokens[kind] = color;
    return map{ name: theme.name, roles: theme.roles, tokens: tokens };
}

// is_dark(theme) — is the background a dark color (pick light text over it)?
fn is_dark(theme) { return C.is_dark(role(theme, "bg")); }

// contrast(theme, role_a, role_b) — WCAG contrast ratio (1..21) between two roles.
fn contrast(theme, role_a, role_b) { return C.contrast_ratio(role(theme, role_a), role(theme, role_b)); }

// names() / preset(name) — the built-in theme registry.
fn names() { return ["dark", "light"]; }
fn preset(name) {
    if name == "light" { return light(); }
    return dark();
}

export dark, light, role, token, with_role, with_token, is_dark, contrast, names, preset;
