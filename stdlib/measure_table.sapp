// Literal input-table interchange. Results are always derived from source fields.
let M=import("stdlib:measure_document.sapp");let S=import("stdlib:sheet_document.sapp");
fn _digit(ch) {return len(ch)==1 and str_index_of("0123456789",ch)>=0;}
fn parse_value(text) {
    if type(text)!="string" or len(text)==0 or len(text)>64 {throw "measure table: decimal value required";}
    let i=0;let digits=0;let nonzero=false;
    if str_slice(text,0,1)=="+" or str_slice(text,0,1)=="-" {i=1;}
    while i<len(text) and _digit(str_slice(text,i,i+1)) {if str_slice(text,i,i+1)!="0" {nonzero=true;}i=i+1;digits=digits+1;}
    if str_slice(text,i,i+1)=="." {
        i=i+1;
        while i<len(text) and _digit(str_slice(text,i,i+1)) {if str_slice(text,i,i+1)!="0" {nonzero=true;}i=i+1;digits=digits+1;}
    }
    if digits==0 {throw "measure table: decimal digits required";}
    if str_slice(text,i,i+1)=="e" or str_slice(text,i,i+1)=="E" {
        i=i+1;if str_slice(text,i,i+1)=="+" or str_slice(text,i,i+1)=="-" {i=i+1;}
        let start=i;while i<len(text) and _digit(str_slice(text,i,i+1)) {i=i+1;}
        if i==start {throw "measure table: exponent digits required";}
    }
    if i!=len(text) {throw "measure table: unsupported numeric spelling";}
    let value=parse_number(text);
    if type(value)!="number" or not (value>= -1000000000000 and value<=1000000000000) or (value==0 and nonzero) {throw "measure table: numeric range";}
    return value;
}
fn from_sheet(sheet,title="Imported measurements") {
    let size=S.validate(sheet);
    if size.rows<2 or (size.columns!=5 and size.columns!=6) {throw "measure table: header and 1-31 data rows required";}
    let allowed=map{Label:true,Value:true,From:true,To:true,Mode:true,Result:true};let columns=map{};
    for i in range(0,size.columns) {
        let key=sheet.cells[0][i];
        if not map_has(allowed,key) or map_has(columns,key) {throw "measure table: unexpected or duplicate header";}
        columns[key]=i;
    }
    for key in ["Label","Value","From","To","Mode"] {if not map_has(columns,key) {throw "measure table: missing input column";}}
    let rows=[];
    for i in range(1,size.rows) {
        let row=sheet.cells[i];array_push(rows,map{label:row[columns.Label],value:parse_value(row[columns.Value]),from:row[columns.From],to:row[columns.To],mode:row[columns.Mode]});
    }
    let doc=map{format:M.FORMAT,title:title,rows:rows};M.validate(doc);return doc;
}
fn to_input_sheet(doc) {
    M.validate(doc);let sheet=S.create(len(doc.rows)+1,5);sheet.cells[0]=["Label","Value","From","To","Mode"];
    for i in range(0,len(doc.rows)) {let r=doc.rows[i];sheet.cells[i+1]=[r.label,str(r.value),r.from,r.to,r.mode];}
    S.validate(sheet);return sheet;
}
export from_sheet,to_input_sheet,parse_value;
