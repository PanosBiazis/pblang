// stdlib/middleware_chain.sapp — Generic middleware/pipeline pattern.
//
// Not HTTP-specific — works for any request/response processing pipeline.
//
// Usage:
//   let mw = import("stdlib:middleware_chain.sapp");
//   let pipeline = mw.create();
//   mw.add(pipeline, fn(ctx, next) { ctx.start_time = clock(); return next(ctx); });
//   mw.add(pipeline, fn(ctx, next) { print ctx.data; return next(ctx); });
//   let result = mw.run(pipeline, map{ data: "hello" });

fn create() {
    return map{ _handlers: [] };
}

fn add(pipeline, handler) {
    pipeline._handlers[len(pipeline._handlers)] = handler;
    return pipeline;
}

// use(pipeline, handler) — readable alias for add.
fn use(pipeline, handler) { return add(pipeline, handler); }

// add_all(pipeline, handlers) — append several handlers at once.
fn add_all(pipeline, handlers) {
    let i = 0;
    while i < len(handlers) { add(pipeline, handlers[i]); i = i + 1; }
    return pipeline;
}

// length(pipeline) — number of registered handlers.
fn length(pipeline) { return len(pipeline._handlers); }

// Module-level recursive driver. (It was a NESTED fn inside run(); a nested fn's
// self-call resolves as an undefined GLOBAL in pblang, so run() threw "undefined
// global '_next'" on any onion-style chain — the whole point of the module.)
fn _run_from(handlers, idx, context) {
    if idx >= len(handlers) { return context; }
    let handler = handlers[idx];
    return handler(context, fn(ctx2) {
        return _run_from(handlers, idx + 1, ctx2);
    });
}

fn run(pipeline, ctx) {
    return _run_from(pipeline._handlers, 0, ctx);
}

// run_safe(pipeline, ctx) — like run, but never throws: a handler error is reported
// as { ok: false } instead of propagating. (pblang `catch` doesn't bind the error,
// so no message is available.)
fn run_safe(pipeline, ctx) {
    // Out-of-band throw detection: wrap the result in a fresh map the catch path
    // (nil) can never produce, so ANY handler result — including nil or a string
    // that a value-sentinel would collide with — round-trips faithfully.
    let wrapped = try map{ v: _run_from(pipeline._handlers, 0, ctx) } catch nil;
    if wrapped == nil { return map{ ok: false, error: "middleware handler error" }; }
    return map{ ok: true, result: wrapped.v };
}

fn compose(fns) {
    // Compose an array of transform functions: fn(val) -> val
    return fn(val) {
        let result = val;
        for i len(fns) { result = fns[i](result); }
        return result;
    };
}

export create, add, use, add_all, length, run, run_safe, compose;
