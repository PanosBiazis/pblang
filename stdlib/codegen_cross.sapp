// stdlib/codegen_cross.sapp — cross-platform codegen: the SAME x86-64 machine code wrapped in
// the right OS executable container — ELF (Linux), Mach-O (macOS), PE (Windows).
//
// The instruction bytes are OS-independent; what changes across platforms is (a) the container
// format and (b) the OS exit convention. This module owns the containers and dispatches.
//
// VERIFICATION HONESTY (on a Linux host):
//   * Linux/ELF   — RUN-verified (executes here).
//   * macOS/Mach-O — FORMAT-verified (valid mach_header_64 + LC_SEGMENT_64 + LC_UNIXTHREAD,
//                    correct x86_64 exit syscall). NOT executed here; modern macOS also
//                    REQUIRES CODE-SIGNING, so a hand-built binary needs signing to run.
//   * Windows/PE  — FORMAT- and IMPORT-verified for i386 PE32 and x86-64 PE32+;
//                    both carry a real kernel32!ExitProcess import table. NOT executed here.
//
//   let c = import("stdlib/codegen_cross.sapp");
//   fs_write_bytes("app",     c.build("linux",   "x86_64", ir));
//   fs_write_bytes("app.mac", c.build("macos",   "x86_64", ir));
//   fs_write_bytes("app.exe", c.build("windows", "x86_64", ir));

let X = import("stdlib:codegen_x64.sapp");
let X86 = import("stdlib:codegen_x86.sapp");
let A64 = import("stdlib:codegen_arm64.sapp");
let IR = import("stdlib:codegen_ir.sapp");   // shared IR validator (safety gate)

fn _app(dst, src) { let i = 0; while i < len(src) { array_push(dst, src[i]); i = i + 1; } return dst; }
fn _zeros(n) { let a = []; let i = 0; while i < n { array_push(a, 0); i = i + 1; } return a; }
fn _round4k(n) { let p = num_floor((n + 4095) / 4096); return p * 4096; }

// ── Mach-O 64 (macOS, x86_64) ─────────────────────────────────────────────────────────
fn _segname(s) {
    let out = str_to_bytes(s);
    while len(out) < 16 { array_push(out, 0); }
    return out;
}
// macOS exit epilogue: exit(rax) via BSD syscall 0x2000001 (class 2 | 1).
fn _macos_exit() {
    let c = [0x48, 0x89, 0xC7];          // mov rdi, rax (exit code = result)
    _app(c, X.mov_imm32_r(0, 0x2000001)); // mov rax, 0x2000001 (SYS_exit, BSD)
    _app(c, X.syscall());
    return c;
}
fn macho64_exec(code) {
    let HDR = 32; let SEG = 72; let THR = 184;
    let hcmds = SEG + THR;
    let headers = HDR + hcmds;            // 288
    let total = headers + len(code);
    let vmaddr = 4294967296;              // 0x100000000
    let entry = vmaddr + headers;
    let out = [];
    // mach_header_64
    _app(out, [0xCF, 0xFA, 0xED, 0xFE]);  // magic 0xFEEDFACF (LE)
    _app(out, X.le32(0x01000007));        // cputype  CPU_TYPE_X86_64
    _app(out, X.le32(0x80000003));        // cpusubtype  LIB64 | X86_64_ALL
    _app(out, X.le32(2));                 // filetype MH_EXECUTE
    _app(out, X.le32(2));                 // ncmds
    _app(out, X.le32(hcmds));             // sizeofcmds
    _app(out, X.le32(1));                 // flags MH_NOUNDEFS
    _app(out, X.le32(0));                 // reserved
    // LC_SEGMENT_64 (__TEXT, maps the whole file)
    _app(out, X.le32(0x19));              // cmd LC_SEGMENT_64
    _app(out, X.le32(SEG));               // cmdsize
    _app(out, _segname("__TEXT"));
    _app(out, X.le64(vmaddr));            // vmaddr
    _app(out, X.le64(_round4k(total)));   // vmsize
    _app(out, X.le64(0));                 // fileoff
    _app(out, X.le64(total));             // filesize
    _app(out, X.le32(7));                 // maxprot rwx
    _app(out, X.le32(5));                 // initprot r-x
    _app(out, X.le32(0));                 // nsects
    _app(out, X.le32(0));                 // flags
    // LC_UNIXTHREAD (x86_THREAD_STATE64) — sets the entry rip
    _app(out, X.le32(5));                 // cmd LC_UNIXTHREAD
    _app(out, X.le32(THR));               // cmdsize
    _app(out, X.le32(4));                 // flavor x86_THREAD_STATE64
    _app(out, X.le32(42));                // count
    let i = 0;                            // 21 u64 regs; rip is index 16
    while i < 21 { if i == 16 { _app(out, X.le64(entry)); } else { _app(out, X.le64(0)); } i = i + 1; }
    _app(out, code);
    return out;
}

// ── PE32+ (Windows, x86_64) — RUNNABLE, with a kernel32!ExitProcess import table ─────
fn _setle(arr, off, bytes) { let i = 0; while i < len(bytes) { arr[off + i] = bytes[i]; i = i + 1; } return arr; }
fn _round_to(n, a) { return num_floor((n + a - 1) / a) * a; }

// ── PE32 (Windows, i386) ─────────────────────────────────────────────────────────────
// PE32 differs structurally from PE32+: 32-bit image/stack fields, a BaseOfData
// field, 4-byte import thunks, and IMAGE_FILE_32BIT_MACHINE in the COFF header.
fn _pe32_headers(code_len, data_len, entry_rva, idt_rva, idt_size, iat_rva, iat_size) {
    let TEXT_RVA = 0x1000; let DATA_RVA = 0x2000; let FILE_ALIGN = 0x200;
    let text_raw = _round_to(code_len, FILE_ALIGN); let data_raw = _round_to(data_len, FILE_ALIGN);
    let out = [];
    _app(out, [0x4D, 0x5A]); _app(out, _zeros(0x3C - 2)); _app(out, X.le32(0x40));
    _app(out, [0x50, 0x45, 0, 0]);
    _app(out, X.le16(0x014C)); _app(out, X.le16(2)); _app(out, X.le32(0)); _app(out, X.le32(0));
    _app(out, X.le32(0)); _app(out, X.le16(224)); _app(out, X.le16(0x0102));
    let opt = _zeros(224);
    _setle(opt, 0, X.le16(0x10B)); _setle(opt, 4, X.le32(text_raw));
    _setle(opt, 8, X.le32(data_raw)); _setle(opt, 16, X.le32(entry_rva));
    _setle(opt, 20, X.le32(TEXT_RVA)); _setle(opt, 24, X.le32(DATA_RVA));
    _setle(opt, 28, X.le32(0x00400000));
    _setle(opt, 32, X.le32(0x1000)); _setle(opt, 36, X.le32(FILE_ALIGN));
    _setle(opt, 40, X.le16(5)); _setle(opt, 42, X.le16(1));
    _setle(opt, 48, X.le16(5)); _setle(opt, 50, X.le16(1));
    _setle(opt, 56, X.le32(DATA_RVA + _round_to(data_len, 0x1000)));
    _setle(opt, 60, X.le32(0x200)); _setle(opt, 68, X.le16(3));
    _setle(opt, 72, X.le32(0x100000)); _setle(opt, 76, X.le32(0x1000));
    _setle(opt, 80, X.le32(0x100000)); _setle(opt, 84, X.le32(0x1000));
    _setle(opt, 92, X.le32(16));
    _setle(opt, 104, X.le32(idt_rva)); _setle(opt, 108, X.le32(idt_size));
    _setle(opt, 192, X.le32(iat_rva)); _setle(opt, 196, X.le32(iat_size));
    _app(out, opt);
    let text = _zeros(40); _setle(text, 0, str_to_bytes(".text"));
    _setle(text, 8, X.le32(code_len)); _setle(text, 12, X.le32(TEXT_RVA));
    _setle(text, 16, X.le32(text_raw)); _setle(text, 20, X.le32(0x200));
    _setle(text, 36, X.le32(0x60000020));
    _app(out, text);
    let data = _zeros(40); _setle(data, 0, str_to_bytes(".idata"));
    _setle(data, 8, X.le32(data_len)); _setle(data, 12, X.le32(DATA_RVA));
    _setle(data, 16, X.le32(data_raw)); _setle(data, 20, X.le32(0x200 + text_raw));
    _setle(data, 36, X.le32(0xC0000040));
    _app(out, data);
    while len(out) < 0x200 { array_push(out, 0); }
    return map{ bytes: out, text_raw: text_raw, data_raw: data_raw };
}

fn pe32_exe(ir) {
    let IMAGE_BASE = 0x00400000; let TEXT_RVA = 0x1000; let DATA_RVA = 0x2000;
    let cp = X86.compile_ir(ir); let cplen = len(cp);
    let off_idt = 0; let off_ilt = 40; let off_iat = 48; let off_hn = 56; let off_dll = 70;
    let data_len = 84;
    let rva_idt = DATA_RVA + off_idt; let rva_ilt = DATA_RVA + off_ilt;
    let rva_iat = DATA_RVA + off_iat; let rva_hn = DATA_RVA + off_hn;
    let rva_dll = DATA_RVA + off_dll;

    let code = []; _app(code, cp);
    array_push(code, 0x50);                              // push eax (ExitProcess uExitCode)
    _app(code, [0xFF, 0x15]); _app(code, X.le32(IMAGE_BASE + rva_iat));

    let idata = [];
    _app(idata, X.le32(rva_ilt)); _app(idata, X.le32(0)); _app(idata, X.le32(0));
    _app(idata, X.le32(rva_dll)); _app(idata, X.le32(rva_iat)); _app(idata, _zeros(20));
    _app(idata, X.le32(rva_hn)); _app(idata, X.le32(0));
    _app(idata, X.le32(rva_hn)); _app(idata, X.le32(0));
    _app(idata, X.le16(0)); _app(idata, str_to_bytes("ExitProcess")); array_push(idata, 0);
    _app(idata, str_to_bytes("kernel32.dll")); array_push(idata, 0); array_push(idata, 0);
    if len(idata) != data_len { throw "codegen_cross: PE32 import layout mismatch"; }

    let headers = _pe32_headers(len(code), data_len, TEXT_RVA, rva_idt, 40, rva_iat, 8);
    let out = headers.bytes; _app(out, code);
    while len(out) < 0x200 + headers.text_raw { array_push(out, 0); }
    _app(out, idata);
    while len(out) < 0x200 + headers.text_raw + headers.data_raw { array_push(out, 0); }
    return out;
}

// Two-section PE header: executable code is RX and imports/IAT/data are RW.
// This enforces W^X while still allowing the Windows loader to bind the IAT.
fn _pe_headers(code_len, data_len, entry_rva, idt_rva, idt_size, iat_rva, iat_size) {
    let TEXT_RVA = 0x1000; let DATA_RVA = 0x2000; let FILE_ALIGN = 0x200;
    let text_raw = _round_to(code_len, FILE_ALIGN); let data_raw = _round_to(data_len, FILE_ALIGN);
    let out = [];
    _app(out, [0x4D, 0x5A]); _app(out, _zeros(0x3C - 2)); _app(out, X.le32(0x40));
    _app(out, [0x50, 0x45, 0, 0]);
    _app(out, X.le16(0x8664)); _app(out, X.le16(2)); _app(out, X.le32(0)); _app(out, X.le32(0));
    _app(out, X.le32(0)); _app(out, X.le16(240)); _app(out, X.le16(0x22));
    let opt = _zeros(240);
    _setle(opt, 0, X.le16(0x20B)); _setle(opt, 4, X.le32(text_raw));
    _setle(opt, 8, X.le32(data_raw)); _setle(opt, 16, X.le32(entry_rva));
    _setle(opt, 20, X.le32(TEXT_RVA)); _setle(opt, 24, X.le64(5368709120));
    _setle(opt, 32, X.le32(0x1000)); _setle(opt, 36, X.le32(FILE_ALIGN));
    _setle(opt, 40, X.le16(5)); _setle(opt, 42, X.le16(2));
    _setle(opt, 48, X.le16(5)); _setle(opt, 50, X.le16(2));
    _setle(opt, 56, X.le32(DATA_RVA + _round_to(data_len, 0x1000)));
    _setle(opt, 60, X.le32(0x200)); _setle(opt, 68, X.le16(3));
    _setle(opt, 72, X.le64(0x100000)); _setle(opt, 80, X.le64(0x1000));
    _setle(opt, 88, X.le64(0x100000)); _setle(opt, 96, X.le64(0x1000));
    _setle(opt, 108, X.le32(16));
    _setle(opt, 120, X.le32(idt_rva)); _setle(opt, 124, X.le32(idt_size));
    _setle(opt, 208, X.le32(iat_rva)); _setle(opt, 212, X.le32(iat_size));
    _app(out, opt);
    let text = _zeros(40); _setle(text, 0, str_to_bytes(".text"));
    _setle(text, 8, X.le32(code_len)); _setle(text, 12, X.le32(TEXT_RVA));
    _setle(text, 16, X.le32(text_raw)); _setle(text, 20, X.le32(0x200));
    _setle(text, 36, X.le32(0x60000020));       // CODE | EXECUTE | READ
    _app(out, text);
    let data = _zeros(40); _setle(data, 0, str_to_bytes(".idata"));
    _setle(data, 8, X.le32(data_len)); _setle(data, 12, X.le32(DATA_RVA));
    _setle(data, 16, X.le32(data_raw)); _setle(data, 20, X.le32(0x200 + text_raw));
    _setle(data, 36, X.le32(0xC0000040));       // INITIALIZED_DATA | READ | WRITE
    _app(out, data);
    while len(out) < 0x200 { array_push(out, 0); }
    return map{ bytes: out, text_raw: text_raw, data_raw: data_raw };
}

// pe64_exe(ir) — a real Windows PE: runs the IR (result in eax) and calls ExitProcess(result)
// via a proper import table, so it actually exits with the computed value on Windows.
fn pe64_exe(ir) {
    let TEXT_RVA = 0x1000; let DATA_RVA = 0x2000;

    // --- code: <ir>; mov ecx, eax; mov rax,[rip+disp]; call rax  (disp -> IAT entry) ---
    let cp = X.compile_ir(ir);
    let cplen = len(cp);
    let code_len = cplen + 2 + 7 + 2;       // +mov ecx,eax(2) +mov rax,[rip](7) +call rax(2)
    // Import data occupies a separate non-executable section.
    let off_idt = 0;
    let off_ilt = off_idt + 40;             // import descriptor + null descriptor
    let off_iat = off_ilt + 16;             // one thunk + null
    let off_hn = off_iat + 16;
    let off_dll = off_hn + 14;              // hint(2)+"ExitProcess\0"(12) = 14
    let data_len = off_dll + 14;            // "kernel32.dll\0"(13) padded to 14
    let rva_idt = DATA_RVA + off_idt;
    let rva_ilt = DATA_RVA + off_ilt;
    let rva_iat = DATA_RVA + off_iat;
    let rva_hn = DATA_RVA + off_hn;
    let rva_dll = DATA_RVA + off_dll;
    let rva_after_mov = TEXT_RVA + cplen + 9;   // rip after the `mov rax,[rip+disp]`
    let disp = rva_iat - rva_after_mov;

    let code = [];
    _app(code, cp);
    _app(code, [0x89, 0xC1]);               // mov ecx, eax  (ExitProcess arg: uCode)
    _app(code, [0x48, 0x8B, 0x05]); _app(code, X.le32(disp));   // mov rax, [rip+disp] -> &ExitProcess
    _app(code, [0xFF, 0xD0]);               // call rax

    let idata = [];
    // IMAGE_IMPORT_DESCRIPTOR + null
    _app(idata, X.le32(rva_ilt)); _app(idata, X.le32(0)); _app(idata, X.le32(0)); _app(idata, X.le32(rva_dll)); _app(idata, X.le32(rva_iat));
    _app(idata, _zeros(20));
    // ILT: thunk -> hint/name, then null
    _app(idata, X.le64(rva_hn)); _app(idata, X.le64(0));
    // IAT: thunk -> hint/name, then null (loader binds this to ExitProcess at load time)
    _app(idata, X.le64(rva_hn)); _app(idata, X.le64(0));
    // hint/name: hint(0) + "ExitProcess\0"
    _app(idata, X.le16(0)); _app(idata, str_to_bytes("ExitProcess")); array_push(idata, 0);
    // dll name: "kernel32.dll\0" (+pad to 14)
    _app(idata, str_to_bytes("kernel32.dll")); array_push(idata, 0); array_push(idata, 0);
    if len(idata) != data_len { throw "codegen_cross: PE import layout mismatch"; }
    let headers = _pe_headers(code_len, data_len, TEXT_RVA, rva_idt, 40, rva_iat, 16);
    let out = headers.bytes; _app(out, code);
    while len(out) < 0x200 + headers.text_raw { array_push(out, 0); }
    _app(out, idata);
    while len(out) < 0x200 + headers.text_raw + headers.data_raw { array_push(out, 0); }
    return out;
}

// ── multi-import PE that PRINTS (GetStdHandle + WriteFile + ExitProcess) ──────────────
fn _pad_even(arr) { if num_mod(len(arr), 2) == 1 { array_push(arr, 0); } return arr; }

// _imptab(names, sect_rva, start_off) — build a kernel32 import table for `names` placed at
// section offset start_off. Returns { bytes, iat_rva, iat_size, idt_rva, idt_size, name_rva[] }.
fn _imptab(names, sect_rva, start_off) {
    let n = len(names);
    let idt_off = start_off;
    let ilt_off = idt_off + 40;            // one descriptor + null descriptor
    let iat_off = ilt_off + 8 * (n + 1);
    let hn_off = iat_off + 8 * (n + 1);
    // lay out hint/name entries, recording each RVA
    let name_rva = [];
    let cur = hn_off;
    let i = 0;
    while i < n {
        array_push(name_rva, sect_rva + cur);
        let e = [0, 0]; _app(e, str_to_bytes(names[i])); array_push(e, 0); _pad_even(e);
        cur = cur + len(e);
        i = i + 1;
    }
    let dll_off = cur;
    let dll = str_to_bytes("kernel32.dll"); array_push(dll, 0); _pad_even(dll);
    let end = dll_off + len(dll);

    let b = [];
    // IMAGE_IMPORT_DESCRIPTOR + null
    _app(b, X.le32(sect_rva + ilt_off)); _app(b, X.le32(0)); _app(b, X.le32(0));
    _app(b, X.le32(sect_rva + dll_off)); _app(b, X.le32(sect_rva + iat_off));
    _app(b, _zeros(20));
    // ILT then IAT (identical: each thunk -> the hint/name RVA, terminated by a null thunk)
    let pass = 0;
    while pass < 2 {
        let j = 0;
        while j < n { _app(b, X.le64(name_rva[j])); j = j + 1; }
        _app(b, X.le64(0));
        pass = pass + 1;
    }
    // hint/name entries
    i = 0;
    while i < n {
        let e = [0, 0]; _app(e, str_to_bytes(names[i])); array_push(e, 0); _pad_even(e);
        _app(b, e);
        i = i + 1;
    }
    _app(b, dll);
    return map{ bytes: b, iat_rva: sect_rva + iat_off, iat_size: 8 * (n + 1),
               idt_rva: sect_rva + idt_off, idt_size: 40, name_rva: name_rva, len: end - start_off };
}

// pe64_print(msg) — a Windows PE that calls GetStdHandle(STD_OUTPUT), WriteFile(msg), and
// ExitProcess(0). Win64 ABI (rcx,rdx,r8,r9 + 32B shadow + 16B alignment). Imports + call
// wiring are objdump-verifiable here; the program prints on Windows.
fn pe64_print(msg) {
    let IMAGE_BASE = 5368709120;
    let TEXT_RVA = 0x1000; let DATA_RVA = 0x2000;
    let mb = str_to_bytes(msg); let mlen = len(mb);
    let names = ["GetStdHandle", "WriteFile", "ExitProcess"];
    let it = _imptab(names, DATA_RVA, 0);
    let iat = it.iat_rva;
    let msg_off = it.len;
    let msg_va = IMAGE_BASE + DATA_RVA + msg_off;
    // rel32 disps (call qword [rip+disp]) to each IAT slot, from the byte after each call
    let d0 = iat + 0 - (TEXT_RVA + 15);      // after instr3 (GetStdHandle)
    let d1 = iat + 8 - (TEXT_RVA + 57);      // after instr10 (WriteFile)
    let d2 = iat + 16 - (TEXT_RVA + 65);     // after instr12 (ExitProcess)

    let code = [];
    _app(code, [0x48, 0x83, 0xEC, 0x38]);                 // sub rsp, 0x38
    _app(code, [0xB9, 0xF5, 0xFF, 0xFF, 0xFF]);          // mov ecx, -11 (STD_OUTPUT_HANDLE)
    _app(code, [0xFF, 0x15]); _app(code, X.le32(d0));    // call [GetStdHandle]
    _app(code, [0x48, 0x89, 0xC6]);                      // mov rsi, rax (save handle)
    _app(code, [0x48, 0x89, 0xF1]);                      // mov rcx, rsi
    _app(code, [0x48, 0xBA]); _app(code, X.le64(msg_va));// movabs rdx, msg
    _app(code, [0x41, 0xB8]); _app(code, X.le32(mlen));  // mov r8d, mlen
    _app(code, [0x4C, 0x8D, 0x4C, 0x24, 0x28]);          // lea r9, [rsp+0x28] (&bytesWritten)
    _app(code, [0x48, 0xC7, 0x44, 0x24, 0x20, 0, 0, 0, 0]); // mov qword [rsp+0x20], 0 (lpOverlapped)
    _app(code, [0xFF, 0x15]); _app(code, X.le32(d1));    // call [WriteFile]
    _app(code, [0x31, 0xC9]);                            // xor ecx, ecx (exit 0)
    _app(code, [0xFF, 0x15]); _app(code, X.le32(d2));    // call [ExitProcess]

    let data = []; _app(data, it.bytes); _app(data, mb);
    let headers = _pe_headers(len(code), len(data), TEXT_RVA, it.idt_rva, it.idt_size, it.iat_rva, it.iat_size);
    let out = headers.bytes; _app(out, code);
    while len(out) < 0x200 + headers.text_raw { array_push(out, 0); }
    _app(out, data);
    while len(out) < 0x200 + headers.text_raw + headers.data_raw { array_push(out, 0); }
    return out;
}

// ── format detection ──────────────────────────────────────────────────────────────────
fn format_of(b) {
    if len(b) < 4 { return "unknown"; }
    if b[0] == 0x7F and b[1] == 0x45 and b[2] == 0x4C and b[3] == 0x46 { return "elf"; }
    if b[0] == 0xCF and b[1] == 0xFA and b[2] == 0xED and b[3] == 0xFE { return "macho"; }
    if b[0] == 0x4D and b[1] == 0x5A { return "pe"; }
    return "unknown";
}

// FreeBSD/amd64 uses ELF64 but a different syscall ABI from Linux. The shared
// IR leaves the result in RAX; exit(2) expects it in RDI and SYS_exit is 1.
fn freebsd_elf64_exec(ir) {
    IR.assert_valid(ir);
    let code = X.compile_ir(ir);
    _app(code, [0x48, 0x89, 0xC7]);                 // mov rdi,rax
    _app(code, [0xB8, 0x01, 0x00, 0x00, 0x00]);   // mov eax,1 (SYS_exit)
    _app(code, [0x0F, 0x05]);                       // syscall
    let elf = X.elf64_exec_rx(code, []);
    elf[7] = 9;                                      // ELFOSABI_FREEBSD
    return elf;
}

// ── dispatcher ────────────────────────────────────────────────────────────────────────
// build(os, arch, ir) — wrap the IR's machine code in the container for (os, arch).
fn build(os, arch, ir) {
    IR.assert_valid(ir);
    if arch == "x64" or arch == "amd64" { arch = "x86_64"; }
    if arch == "x86" or arch == "i486" or arch == "i586" or arch == "i686" { arch = "i386"; }
    if arch == "aarch64" { arch = "arm64"; }
    if os == "linux" {
        if arch == "x86_64" { return X.compile_program(ir); }
        if arch == "i386" { return X86.compile_program(ir); }
        if arch == "arm64" { return A64.compile_program(ir); }
        throw "codegen_cross: no linux backend for arch " + arch;
    }
    if os == "freebsd" {
        if arch == "x86_64" { return freebsd_elf64_exec(ir); }
        throw "codegen_cross: freebsd backend currently x86_64 only";
    }
    if os == "macos" {
        if arch == "x86_64" {
            let code = X.compile_ir(ir);
            _app(code, _macos_exit());
            return macho64_exec(code);
        }
        throw "codegen_cross: macos backend currently x86_64 only";
    }
    if os == "windows" {
        if arch == "i386" { return pe32_exe(ir); }
        if arch == "x86_64" { return pe64_exe(ir); }   // runnable: calls ExitProcess via import table
        throw "codegen_cross: no windows backend for arch " + arch;
    }
    throw "codegen_cross: unknown os " + os;
}

// platforms() — every (os, arch, format) the codegen can emit, with honest run-status.
fn platforms() {
    return [
        map{ os: "linux", arch: "x86_64", format: "elf", status: "run-verified", runs: "yes (verified here)" },
        map{ os: "linux", arch: "x86", format: "elf", status: "run-verified", runs: "yes (verified here)" },
        map{ os: "linux", arch: "arm64", format: "elf", status: "execution-model-verified", runs: "on arm64 hardware" },
        map{ os: "freebsd", arch: "x86_64", format: "elf", status: "format-and-syscall-abi-verified", runs: "requires target-host verification" },
        map{ os: "macos", arch: "x86_64", format: "macho", status: "format-verified", runs: "requires target-host signing and verification" },
        map{ os: "windows", arch: "x86", format: "pe", status: "format-and-import-verified", runs: "requires target-host verification" },
        map{ os: "windows", arch: "x86_64", format: "pe", status: "format-and-import-verified", runs: "requires target-host verification" }
    ];
}

export macho64_exec, pe32_exe, pe64_exe, pe64_print, freebsd_elf64_exec, format_of, build, platforms;
