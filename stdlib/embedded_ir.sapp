// Portable, bounded embedded IR shared by every MCU backend.

let Targets = import("stdlib:embedded_targets.sapp");
let FORMAT = "pblang.embedded-ir.v1";

fn pin_mode(pin, mode) {
    let normalized = str_lower(str(mode));
    if normalized != "input" and normalized != "output" and normalized != "input-pullup" {
        throw "embedded_ir: pin mode must be input, output, or input-pullup";
    }
    return map{ kind:"pin-mode", pin:str(pin), mode:normalized };
}

fn digital_write(pin, value) {
    if not ((type(value) == "number" and (value == 0 or value == 1)) or type(value) == "bool") {
        throw "embedded_ir: digital value must be 0/1 or bool";
    }
    return map{ kind:"digital-write", pin:str(pin),
        value:if (type(value) == "bool" and value) or (type(value) == "number" and value == 1) { 1 } else { 0 } };
}

fn digital_read(pin) { return map{ kind:"digital-read", pin:str(pin) }; }

fn analog_read(pin) { return map{ kind:"analog-read", pin:str(pin) }; }

fn analog_write(pin, value) {
    if type(value) != "number" or value != num_floor(value) or value < 0 or value > 255 {
        throw "embedded_ir: analog value must be a whole 0..255";
    }
    return map{ kind:"analog-write", pin:str(pin), value:value };
}

fn pwm_write(pin, value) {
    if type(value) != "number" or value != num_floor(value) or value < 0 or value > 255 {
        throw "embedded_ir: PWM duty must be a whole 0..255";
    }
    return map{ kind:"pwm-write", pin:str(pin), value:value };
}

fn delay_ms(value) {
    if type(value) != "number" or value != num_floor(value) or value < 1 or value > 60000 {
        throw "embedded_ir: delay must be a whole 1..60000 milliseconds";
    }
    return map{ kind:"delay-ms", value:value };
}

fn forever(operations) {
    if type(operations) != "array" or len(operations) == 0 {
        throw "embedded_ir: forever requires at least one operation";
    }
    let out = [map{kind:"loop-begin"}];
    for i len(operations) { array_push(out, operations[i]); }
    array_push(out, map{kind:"loop-end"});
    return out;
}

fn program(setup, loop, metadata = nil) {
    if type(setup) != "array" or type(loop) != "array" {
        throw "embedded_ir: setup and loop must be arrays";
    }
    let operations = [];
    for i len(setup) { array_push(operations, setup[i]); }
    let repeated = forever(loop);
    for i len(repeated) { array_push(operations, repeated[i]); }
    return map{ format:FORMAT, operations:operations,
        metadata:if metadata == nil { map{} } else { metadata } };
}

fn blink(pin = "status-led-test", interval_ms = 500) {
    return program([pin_mode(pin, "output")],
        [digital_write(pin, 1), delay_ms(interval_ms),
         digital_write(pin, 0), delay_ms(interval_ms)],
        map{ kind:"blink", portable:true, interval_ms:interval_ms });
}

fn validate(value, board_value) {
    if value == nil or not is_map(value) or (try value.format catch "") != FORMAT {
        return map{ ok:false, format:FORMAT,
            errors:[map{severity:"error",code:"invalid-ir",message:"invalid embedded IR",operation:-1}], warnings:[] };
    }
    return Targets.validate_program(value, board_value);
}

fn lower(value, board_value) {
    let checked = validate(value, board_value);
    if not checked.ok { return checked; }
    let operations = [];
    for i len(value.operations) {
        let op = value.operations[i]; let lowered = map{ kind:op.kind };
        if op.kind == "pin-mode" or op.kind == "digital-write" or op.kind == "digital-read"
           or op.kind == "analog-read" or op.kind == "analog-write" or op.kind == "pwm-write" {
            let selected = Targets.pin(board_value, op.pin);
            lowered.pin_alias = op.pin; lowered.pin = selected;
            if op.kind == "pin-mode" { lowered.mode = op.mode; }
            if op.kind == "digital-write" or op.kind == "analog-write" or op.kind == "pwm-write" {
                lowered.value = op.value;
            }
        } elif op.kind == "delay-ms" { lowered.value = op.value; }
        array_push(operations, lowered);
    }
    return map{ ok:true, format:FORMAT, board:board_value, operations:operations,
        warnings:checked.warnings, metadata:value.metadata };
}

export FORMAT, pin_mode, digital_write, digital_read, analog_read, analog_write, pwm_write;
export delay_ms, forever, program, blink;
export validate, lower;
