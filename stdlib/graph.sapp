// stdlib/graph.sapp — Graph data structure with BFS, DFS, Dijkstra, Topo Sort.
//
// Usage:
//   let graph = import("stdlib:graph.sapp");
//   let g = graph.new(false);  // undirected
//   graph.add_node(g, "A", map{ label: "Node A" });
//   graph.add_node(g, "B", map{ label: "Node B" });
//   graph.add_edge(g, "A", "B", 1.0);
//   let path = graph.dijkstra(g, "A");
//   print path.B;  // 1

fn new(directed) {
    if directed == nil { directed = true; }
    return map{
        directed: directed,
        nodes: map{},
        edges: map{},
        _edge_list: []
    };
}

fn add_node(g, id, data) {
    if data == nil { data = map{}; }
    g.nodes[str(id)] = map{ id: str(id), data: data };
    if map_has(g.edges, str(id)) == false {
        g.edges[str(id)] = [];
    }
    return g;
}

fn add_edge(g, from, to, weight) {
    let f = str(from);
    let t = str(to);
    if weight == nil { weight = 1.0; }

    // Auto-add nodes if not present
    if map_has(g.nodes, f) == false { add_node(g, f, map{}); }
    if map_has(g.nodes, t) == false { add_node(g, t, map{}); }

    // Add edge from→to
    if map_has(g.edges, f) == false { g.edges[f] = []; }
    let e_arr = g.edges[f];
    e_arr[len(e_arr)] = map{ to: t, weight: weight };
    g.edges[f] = e_arr;

    // For undirected: also add reverse edge
    if g.directed == false {
        if map_has(g.edges, t) == false { g.edges[t] = []; }
        let e_arr2 = g.edges[t];
        e_arr2[len(e_arr2)] = map{ to: f, weight: weight };
        g.edges[t] = e_arr2;
    }

    g._edge_list[len(g._edge_list)] = map{ from: f, to: t, weight: weight };
    return g;
}

fn neighbors(g, node_id) {
    let id = str(node_id);
    let edges = try g.edges[id] catch [];
    let result = [];
    for i len(edges) {
        result[i] = edges[i].to;
    }
    return result;
}

fn has_node(g, id) {
    return map_has(g.nodes, str(id));
}

fn node_count(g) {
    return len(map_keys(g.nodes));
}

fn edge_count(g) {
    return len(g._edge_list);
}

// BFS — breadth-first search, returns visited node ids in order
fn bfs(g, start) {
    let visited_map = map{};
    let visited_list = [];
    let queue = [str(start)];
    visited_map[str(start)] = true;

    while len(queue) > 0 {
        // Dequeue front (array as queue: shift from front)
        let current = queue[0];
        let new_queue = [];
        for i len(queue) {
            if i > 0 { new_queue[len(new_queue)] = queue[i]; }
        }
        queue = new_queue;

        visited_list[len(visited_list)] = current;

        let edges = try g.edges[current] catch [];
        for i len(edges) {
            let neighbor = edges[i].to;
            if map_has(visited_map, neighbor) == false {
                visited_map[neighbor] = true;
                queue[len(queue)] = neighbor;
            }
        }
    }
    return visited_list;
}

// DFS — depth-first search, returns visited node ids in order
fn dfs(g, start) {
    let visited_map = map{};
    let visited_list = [];
    let stack = [str(start)];

    while len(stack) > 0 {
        // Pop from top of stack
        let top = stack[len(stack) - 1];
        let new_stack = [];
        for i len(stack) - 1 { new_stack[i] = stack[i]; }
        stack = new_stack;

        if map_has(visited_map, top) == false {
            visited_map[top] = true;
            visited_list[len(visited_list)] = top;

            let edges = try g.edges[top] catch [];
            for i len(edges) {
                let neighbor = edges[i].to;
                if map_has(visited_map, neighbor) == false {
                    stack[len(stack)] = neighbor;
                }
            }
        }
    }
    return visited_list;
}

// Dijkstra shortest paths from start — returns map of node_id → distance
fn dijkstra(g, start) {
    let dist = map{};
    let unvisited = map{};
    let node_ids = map_keys(g.nodes);

    // Initialize distances
    for i len(node_ids) {
        dist[node_ids[i]] = 999999999.0;
        unvisited[node_ids[i]] = true;
    }
    dist[str(start)] = 0.0;

    while len(map_keys(unvisited)) > 0 {
        // Find unvisited node with minimum distance
        let ukeys = map_keys(unvisited);
        let current = ukeys[0];
        let current_dist = dist[current];
        for i len(ukeys) {
            let d = try dist[ukeys[i]] catch 999999999.0;
            if d < current_dist {
                current_dist = d;
                current = ukeys[i];
            }
        }

        if current_dist >= 999999999.0 { break; } // remaining nodes unreachable

        map_remove(unvisited, current);

        let edges = try g.edges[current] catch [];
        for i len(edges) {
            let neighbor = edges[i].to;
            if map_has(unvisited, neighbor) {
                let new_dist = current_dist + edges[i].weight;
                let old_dist = try dist[neighbor] catch 999999999.0;
                if new_dist < old_dist {
                    dist[neighbor] = new_dist;
                }
            }
        }
    }
    return dist;
}

// topological_sort(g) — Kahn's algorithm, returns sorted array or nil if cycle detected
fn topological_sort(g) {
    let node_ids = map_keys(g.nodes);
    let in_degree = map{};
    for i len(node_ids) { in_degree[node_ids[i]] = 0; }

    // Count in-degrees
    for i len(node_ids) {
        let edges = try g.edges[node_ids[i]] catch [];
        for j len(edges) {
            let t = edges[j].to;
            let cur = try in_degree[t] catch 0;
            in_degree[t] = cur + 1;
        }
    }

    // Queue nodes with in_degree 0
    let queue = [];
    let ik = map_keys(in_degree);
    for i len(ik) {
        if in_degree[ik[i]] == 0 { queue[len(queue)] = ik[i]; }
    }

    let result = [];
    while len(queue) > 0 {
        let current = queue[0];
        let new_queue = [];
        for i len(queue) { if i > 0 { new_queue[len(new_queue)] = queue[i]; } }
        queue = new_queue;

        result[len(result)] = current;

        let edges = try g.edges[current] catch [];
        for i len(edges) {
            let neighbor = edges[i].to;
            let new_deg = in_degree[neighbor] - 1;
            in_degree[neighbor] = new_deg;
            if new_deg == 0 { queue[len(queue)] = neighbor; }
        }
    }

    if len(result) != len(node_ids) { return nil; } // cycle detected
    return result;
}

// has_cycle(g) — true if graph contains a cycle
fn has_cycle(g) {
    if g.directed {
        return topological_sort(g) == nil;
    }
    // For undirected: use DFS with parent tracking
    let visited = map{};
    let node_ids = map_keys(g.nodes);

    fn _dfs_cycle(g, node, parent_node, visited_map) {
        visited_map[node] = true;
        let edges = try g.edges[node] catch [];
        for i len(edges) {
            let neighbor = edges[i].to;
            if map_has(visited_map, neighbor) == false {
                if _dfs_cycle(g, neighbor, node, visited_map) { return true; }
            } else if neighbor != parent_node {
                return true;
            }
        }
        return false;
    }

    for i len(node_ids) {
        if map_has(visited, node_ids[i]) == false {
            if _dfs_cycle(g, node_ids[i], nil, visited) { return true; }
        }
    }
    return false;
}

export new, add_node, add_edge, neighbors, has_node, node_count, edge_count,
       bfs, dfs, dijkstra, topological_sort, has_cycle;
