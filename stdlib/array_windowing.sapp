// PBLang validation/iteration with bounded-index bulk slice primitives.
// No local slice declaration: slice below is the existing runtime primitive.
fn _positive_count(value,label) {
    if type(value)!="number" {throw label+": expected a positive finite integer";}
    if value!=value or value-value!=0 {throw label+": expected a positive finite integer";}
    if value<=0 or value!=num_floor(value) {throw label+": expected a positive finite integer";}
}

fn chunk(a,size) {
    if type(a)!="array" {throw "array.chunk: expected an array";}
    _positive_count(size,"array.chunk size");
    let result=[];let n=len(a);let i=0;
    while i<n {
        let count=n-i;
        if size<count {count=size;}
        let end=i+count;
        array_push(result,slice(a,i,end));
        i=end;
    }
    return result;
}

// Required step here; the public array.windows wrapper owns its default.
fn windows(a,size,step) {
    if type(a)!="array" {throw "array.windows: expected an array";}
    _positive_count(size,"array.windows size");
    _positive_count(step,"array.windows step");
    let result=[];let n=len(a);
    if size>n {return result;}
    let last_start=n-size;let i=0;
    while i<=last_start {
        array_push(result,slice(a,i,i+size));
        if step>last_start-i {break;}
        i=i+step;
    }
    return result;
}

export chunk,windows;
