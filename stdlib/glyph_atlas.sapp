// stdlib/glyph_atlas.sapp — shelf/next-fit rectangle packer for a texture atlas.
//
// Part of pblang's GPU 2D stack (see gpu2d.sapp): a GPU text renderer uploads all glyph
// bitmaps into ONE atlas texture and draws each glyph as a quad sampling its sub-rect, so
// text costs one draw call, not one-per-glyph. A parallel CPU rasterizer reuses the same
// packing. This is pblang's answer to stb_rect_pack / etagere / the atlas in glyphon.
// Pure + deterministic — geometry only, no pixels, no GPU.
//
//   let A = import("stdlib/glyph_atlas.sapp");
//   let at = A.new(512, 512);
//   let r  = A.pack(at, "A", 12, 16);   // {id,x,y,w,h} or nil if it doesn't fit
//   let uv = A.uv(at, "A");             // {u0,v0,u1,v1} normalized 0..1 for the shader
//
// Shelf packing: rows ("shelves") grow top-to-bottom; each glyph goes on the first shelf
// whose height fits and that has room, else a new shelf opens below.

// new(w, h, pad=0) — an empty atlas. `pad` inserts a gap between packed rects (avoids
// bilinear-filter bleed between neighbouring glyphs on the GPU).
fn new(w, h, pad = 0) {
    return map{ w: w, h: h, pad: pad, shelves: [], rects: map{}, used: 0 };
}

// pack(atlas, id, gw, gh) — place a wxh rect; returns {id,x,y,w,h} or nil on overflow.
fn pack(atlas, id, gw, gh) {
    let p = atlas.pad;
    let aw = atlas.w;
    let ah = atlas.h;
    // 1) try to reuse an existing shelf (first that fits in height and has horizontal room)
    let i = 0;
    while i < len(atlas.shelves) {
        let sh = atlas.shelves[i];
        if gh <= sh.h and sh.x + gw <= aw {
            let r = map{ id: id, x: sh.x, y: sh.y, w: gw, h: gh };
            sh.x = sh.x + gw + p;
            atlas.rects[id] = r;
            atlas.used = atlas.used + gw * gh;
            return r;
        }
        i = i + 1;
    }
    // 2) open a new shelf directly below the last one
    let top = 0;
    if len(atlas.shelves) > 0 {
        let last = atlas.shelves[len(atlas.shelves) - 1];
        top = last.y + last.h + p;
    }
    if top + gh > ah or gw > aw { return nil; }   // doesn't fit the atlas at all
    let shelf = map{ y: top, h: gh, x: gw + p };
    array_push(atlas.shelves, shelf);
    let r = map{ id: id, x: 0, y: top, w: gw, h: gh };
    atlas.rects[id] = r;
    atlas.used = atlas.used + gw * gh;
    return r;
}

// pack_all(atlas, glyphs) — glyphs = [{id,w,h}]. Returns {placed:[rect...], overflow:[id...]}.
fn pack_all(atlas, glyphs) {
    let placed = [];
    let overflow = [];
    let i = 0;
    while i < len(glyphs) {
        let g = glyphs[i];
        let r = pack(atlas, g.id, g.w, g.h);
        if r == nil { array_push(overflow, g.id); } else { array_push(placed, r); }
        i = i + 1;
    }
    return map{ placed: placed, overflow: overflow };
}

// rect_for(atlas, id) — the packed pixel rect, or nil if unknown.
fn rect_for(atlas, id) {
    if map_has(atlas.rects, id) { return atlas.rects[id]; }
    return nil;
}

// uv(atlas, id) — normalized texture coordinates {u0,v0,u1,v1} for the shader, or nil.
fn uv(atlas, id) {
    let r = rect_for(atlas, id);
    if r == nil { return nil; }
    let w = atlas.w * 1.0;
    let h = atlas.h * 1.0;
    return map{ u0: r.x / w, v0: r.y / h, u1: (r.x + r.w) / w, v1: (r.y + r.h) / h };
}

// occupancy(atlas) — packed area / atlas area (0..1); a packing-efficiency signal.
fn occupancy(atlas) { return atlas.used / (atlas.w * 1.0 * atlas.h); }
fn count(atlas) { return len(map_keys(atlas.rects)); }

export new, pack, pack_all, rect_for, uv, occupancy, count;
