// Calendar-day dependency plans. Estimates only; no execution, clock or resource allocation.
let Date=import("stdlib:civil_date.sapp");let Window=import("stdlib:date_window.sapp");let Ops=import("stdlib:devops_pipeline.sapp");let S=import("stdlib:serialization.sapp");
let FORMAT="pblang.task-plan.v1";let MAX_FILE_BYTES=32768;
fn _keys(v,keys) {if type(v)!="map" or len(v)!=len(keys) {return false;}for key in keys {if not map_has(v,key) {return false;}}return true;}
fn _text(s) {if type(s)!="string" or len(s)<1 or len(s)>80 or len(str_to_bytes(s))>256 or str_trim(s)=="" {return false;}for i in range(0,len(s)) {let c=strcharcodeat(s,i);if c<32 or c==127 {return false;}}return true;}
fn _prepare(doc) {
    if not _keys(doc,["format","title","start","tasks"]) or doc.format!=FORMAT or not _text(doc.title) or type(doc.tasks)!="array" or len(doc.tasks)<1 or len(doc.tasks)>32 {throw "invalid task plan";}
    let first=Date.ordinal(doc.start);let jobs=[];let tasks=map{};
    for task in doc.tasks {
        if not _keys(task,["id","label","days","needs","done"]) or not _text(task.label) or type(task.days)!="number" or not (task.days>=1 and task.days<=365) or task.days!=num_floor(task.days) or type(task.done)!="bool" {throw "invalid plan task";}
        array_push(jobs,map{id:task.id,needs:task.needs});
    }
    let order=Ops.order(jobs);for task in doc.tasks {tasks[task.id]=task;}
    let starts=map{};let finishes=map{};let total=0;
    for id in order {
        let task=tasks[id];let begin=0;
        for parent in task.needs {begin=num_max(begin,finishes[parent]);if task.done and not tasks[parent].done {throw "completed task has incomplete prerequisite";}}
        starts[id]=begin;finishes[id]=begin+task.days;total=num_max(total,finishes[id]);
    }
    if first+total-1>3652058 {throw "plan exceeds civil date range";}
    return map{first:first,tasks:tasks,order:order,starts:starts,finishes:finishes,days:total};
}
fn validate(doc) {_prepare(doc);return true;}
fn create(title="New plan",start="2026-01-01") {let doc=map{format:FORMAT,title:title,start:start,tasks:[map{id:"task_1",label:"First task",days:1,needs:[],done:false}]};validate(doc);return doc;}
fn copy(doc) {validate(doc);let tasks=[];for t in doc.tasks {let needs=[];for id in t.needs {array_push(needs,id);}array_push(tasks,map{id:t.id,label:t.label,days:t.days,needs:needs,done:t.done});}return map{format:FORMAT,title:doc.title,start:doc.start,tasks:tasks};}
fn _index(doc,id) {for i in range(0,len(doc.tasks)) {if doc.tasks[i].id==id {return i;}}throw "unknown task id";}
fn edit(doc,id,label,days,needs) {let out=copy(doc);let index=_index(out,id);if type(needs)!="array" or len(needs)>16 {throw "invalid prerequisites";}let parents=[];for parent in needs {array_push(parents,parent);}out.tasks[index].label=label;out.tasks[index].days=days;out.tasks[index].needs=parents;validate(out);return out;}
fn metadata(doc,title,start) {let out=copy(doc);out.title=title;out.start=start;validate(out);return out;}
fn append(doc) {let out=copy(doc);let used=map{};for task in out.tasks {used[task.id]=true;}let n=1;while map_has(used,"task_"+str(n)) {n=n+1;}array_push(out.tasks,map{id:"task_"+str(n),label:"New task",days:1,needs:[],done:false});validate(out);return out;}
fn remove(doc,id) {let out=copy(doc);_index(out,id);let tasks=[];for task in out.tasks {if task.id!=id {array_push(tasks,task);}}out.tasks=tasks;validate(out);return out;}
fn complete(doc,id,done=true) {if type(done)!="bool" {throw "completion must be Boolean";}let out=copy(doc);out.tasks[_index(out,id)].done=done;validate(out);return out;}
fn schedule(doc) {
    let plan=_prepare(doc);let rows=[];let done=0;
    for id in plan.order {let task=plan.tasks[id];let ready=true;for parent in task.needs {if not plan.tasks[parent].done {ready=false;}}
        let status="blocked";if ready {status="ready";}if task.done {done=done+1;status="done";}
        array_push(rows,map{id:id,label:task.label,days:task.days,start:Date.from_ordinal(plan.first+plan.starts[id]),due:Date.from_ordinal(plan.first+plan.finishes[id]-1),status:status});
    }
    return map{format:"pblang.task-schedule.v1",title:doc.title,start:doc.start,due:Date.from_ordinal(plan.first+plan.days-1),days:plan.days,completed:done,total:len(rows),tasks:rows,assumptions:"calendar-days-unlimited-workers-fixed-durations",execution_performed:false};
}
fn window(doc,start,days=7) {let dates=[];for task in schedule(doc).tasks {if task.status!="done" {array_push(dates,task.due);}}return Window.summarize(dates,start,days);}
fn _limits() {return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:2500,strict:true,reject_duplicate_keys:true};}
fn encode(doc) {let r=S.stringify_safe(copy(doc),"json",_limits());if not r.ok {throw "plan encoding failed";}return r.value;}
fn decode(text) {let r=S.parse_safe(text,"json",_limits());if not r.ok or r.duplicate_keys_checked!=true {throw "invalid plan file";}return copy(r.value);}
export FORMAT,MAX_FILE_BYTES,validate,create,copy,edit,metadata,append,remove,complete,schedule,window,encode,decode;
