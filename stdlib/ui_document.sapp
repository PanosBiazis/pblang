// Canonical, renderer-neutral UI document shared by PBLang and inert form importers.
// Handler names are metadata only; this module never parses or executes embedded code.

let FORMAT = "pblang.ui-document.v1";
let MAX_WIDGETS = 512;
let MAX_VALUE_DEPTH = 8;
let MAX_VALUE_NODES = 4096;
let MAX_COLLECTION_ITEMS = 256;

fn _text(value, name, maximum) {
    if type(value) != "string" or value == "" or len(value) > maximum {
        throw "ui_document: invalid " + name;
    }
    return value;
}

fn _token(value, name) {
    let text = _text(value, name, 128);
    if not regex_match(text, "^[A-Za-z_][A-Za-z0-9_.:-]*$") {
        throw "ui_document: invalid " + name;
    }
    return text;
}

fn _geometry_range(value, name, minimum, maximum) {
    if type(value) != "number" or str_lower(str(value)) == "nan"
       or str_contains(str_lower(str(value)), "inf") or value < minimum or value > maximum {
        throw "ui_document: invalid " + name;
    }
    return value;
}

fn _geometry(value, name) { return _geometry_range(value, name, 0 - 1000000, 1000000); }

fn _copy_value(value, depth, state) {
    if depth > MAX_VALUE_DEPTH { throw "ui_document: value nesting exceeds limit"; }
    state.nodes = state.nodes + 1;
    if state.nodes > MAX_VALUE_NODES { throw "ui_document: value node limit exceeded"; }
    if value == nil or type(value) == "bool" { return value; }
    if type(value) == "number" {
        if str_lower(str(value)) == "nan" or str_contains(str_lower(str(value)), "inf")
           or value < -1000000000000 or value > 1000000000000 {
            throw "ui_document: invalid numeric property";
        }
        return value;
    }
    if type(value) == "string" {
        if len(value) > 8192 { throw "ui_document: property text exceeds limit"; }
        return value;
    }
    if type(value) == "array" {
        if len(value) > MAX_COLLECTION_ITEMS { throw "ui_document: property array exceeds limit"; }
        let out = [];
        for item in value { array_push(out, _copy_value(item, depth + 1, state)); }
        return out;
    }
    if type(value) == "map" {
        let keys = map_keys(value);
        if len(keys) > MAX_COLLECTION_ITEMS { throw "ui_document: property map exceeds limit"; }
        let out = map{}; let index = 0;
        while index < len(keys) {
            let key = _token(str(keys[index]), "property key");
            out[key] = _copy_value(value[keys[index]], depth + 1, state);
            index = index + 1;
        }
        return out;
    }
    throw "ui_document: unsupported property value type";
}

fn _events(value) {
    if value == nil { return map{}; }
    if type(value) != "map" or len(map_keys(value)) > 32 { throw "ui_document: invalid events"; }
    let out = map{};
    for name in map_keys(value) {
        let event_name = _token(str(name), "event name");
        let handler = _text(value[name], "handler name", 128);
        if not regex_match(handler, "^[A-Za-z_][A-Za-z0-9_]*$") {
            throw "ui_document: handlers must be inert identifiers";
        }
        out[event_name] = handler;
    }
    return out;
}

fn _widget(value, state) {
    if type(value) != "map" { throw "ui_document: invalid widget"; }
    let width = _geometry_range(try value.w catch nil, "widget width", 0, 1000000);
    let height = _geometry_range(try value.h catch nil, "widget height", 0, 1000000);
    let parent = try value.parent catch "root";
    let bind = try value.bind catch "";
    if bind != "" { bind = _token(bind, "binding name"); }
    return map{format:"pblang.ui-widget.v1", id:_token(try value.name catch "", "widget id"),
        kind:_token(try value.kind catch "", "widget kind"),
        parent:_token(parent, "widget parent"),
        x:_geometry(try value.x catch nil, "widget x"),
        y:_geometry(try value.y catch nil, "widget y"), w:width, h:height,
        props:_copy_value(try value.props catch map{}, 0, state),
        events:_events(try value.events catch nil), bind:bind};
}

fn from_design(design, source_format = "pblang-gui") {
    if type(design) != "map" or type(try design.form catch nil) != "map"
       or type(try design.widgets catch nil) != "array" or len(design.widgets) > MAX_WIDGETS
       or type(try design.model catch nil) != "map" {
        throw "ui_document: invalid design tree";
    }
    let form = design.form;
    let canonical_form = map{format:"pblang.ui-form.v1", id:"root",
        title:_text(try form.title catch "", "form title", 256),
        w:_geometry_range(try form.w catch nil, "form width", 64, 16384),
        h:_geometry_range(try form.h catch nil, "form height", 64, 16384)};
    let state = map{nodes:0}; let widgets = []; let ids = map{root:true};
    for value in design.widgets {
        let widget = _widget(value, state);
        if map_has(ids, widget.id) { throw "ui_document: duplicate widget id " + widget.id; }
        ids[widget.id] = true; array_push(widgets, widget);
    }
    for widget in widgets {
        if not map_has(ids, widget.parent) { throw "ui_document: missing widget parent " + widget.parent; }
        if widget.parent == widget.id { throw "ui_document: widget cannot parent itself"; }
    }
    return map{ok:true, format:FORMAT, source_format:_token(source_format, "source format"),
        form:canonical_form, widgets:widgets, model:_copy_value(design.model, 0, state),
        widget_count:len(widgets), value_node_count:state.nodes,
        embedded_code:false, direct_effects:false, handlers_executed:false,
        renderer_bound:false, external_sdk_required:false};
}

fn validate(document) {
    if type(document) != "map" or (try document.format catch "") != FORMAT {
        return map{ok:false, format:"pblang.ui-document.validation.v1", error:"invalid-format"};
    }
    let design = map{form:document.form, widgets:[], model:document.model};
    for widget in document.widgets {
        array_push(design.widgets, map{name:widget.id, kind:widget.kind, parent:widget.parent,
            x:widget.x, y:widget.y, w:widget.w, h:widget.h, props:widget.props,
            events:widget.events, bind:widget.bind});
    }
    let canonical = try from_design(design, document.source_format) catch nil;
    if canonical == nil { return map{ok:false, format:"pblang.ui-document.validation.v1", error:"invalid-document"}; }
    return map{ok:true, format:"pblang.ui-document.validation.v1", document:canonical};
}

fn status() {
    return map{ok:true, format:"pblang.ui-document.status.v1", canonical_format:FORMAT,
        max_widgets:MAX_WIDGETS, max_value_depth:MAX_VALUE_DEPTH,
        max_value_nodes:MAX_VALUE_NODES, flat_parent_graph:true,
        embedded_code:false, direct_effects:false, executes_handlers:false,
        renderer_neutral:true, production_ready:false};
}

export FORMAT, MAX_WIDGETS, MAX_VALUE_DEPTH, MAX_VALUE_NODES;
export from_design, validate, status;
