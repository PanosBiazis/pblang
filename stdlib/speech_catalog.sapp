// Deterministic bounded inventory of locally installed speech assets.
// Fixed system roots are held component-by-component; caller paths, model
// contents and absolute host paths are never returned.

let DIRFS=import("stdlib:linux_dirfs.sapp");
let PROCESS=import("stdlib:linux_process.sapp");
let FORMAT="pblang.speech-catalog.v1";let MAX_ENTRIES=512;

fn _safe(value){return type(value)=="string" and regex_match(value,"^[A-Za-z0-9_.!+-]{1,128}$");}
fn _fixed_version(candidates){let run=PROCESS.run_fixed(candidates,["--version"],map{
    timeout_secs:3,startup_timeout_ms:3000,max_output_bytes:4096,max_memory_bytes:67108864,
    inherit_environment:false,environment:map{LC_ALL:"C",HOME:"/nonexistent"}});
    return map{callable:run.ok and run.command_ok,process_group_terminated:try run.process_group_terminated catch false};}
fn _list(path,maximum=nil){if maximum==nil{maximum=MAX_ENTRIES;}let root=DIRFS.open_absolute(path,false,false);
    if not root.ok{return map{ok:false,entries:[]};}let listed=DIRFS.list(root,"root",maximum);
    let closed=DIRFS.close(root);if not listed.ok or not closed{return map{ok:false,entries:[]};}
    return map{ok:true,entries:array_sort(listed.entries),truncated:listed.truncated};}

fn _espeak_root(){let roots=["/usr/lib/x86_64-linux-gnu/espeak-ng-data",
    "/usr/lib/aarch64-linux-gnu/espeak-ng-data","/usr/lib/i386-linux-gnu/espeak-ng-data",
    "/usr/share/espeak-ng-data","/usr/share/espeak-data"];
    for i len(roots){let listed=_list(roots[i],8);if listed.ok{return roots[i];}}return nil;}

fn list_voices(){let root=_espeak_root();let records=map{};let truncated=false;
    if root!=nil {
        let variants=_list(root+"/voices/!v",MAX_ENTRIES);
        if variants.ok {for i len(variants.entries){let id=variants.entries[i];if _safe(id) and len(map_keys(records))<MAX_ENTRIES{
            let key="!v/"+id;if not map_has(records,key) and len(map_keys(records))<MAX_ENTRIES{
                records[key]=map{id:key,kind:"variant",engine:"espeak-ng",installed:true};}}}
            truncated=truncated or variants.truncated;}
        let families=_list(root+"/lang",256);
        if families.ok {for i len(families.entries){let family=families.entries[i];if _safe(family){
            let languages=_list(root+"/lang/"+family,256);if languages.ok{for j len(languages.entries){
                let id=languages.entries[j];if _safe(id) and len(map_keys(records))<MAX_ENTRIES and not map_has(records,id){
                    records[id]=map{id:id,kind:"language",family:family,engine:"espeak-ng",installed:true};}}
                truncated=truncated or languages.truncated;}}}truncated=truncated or families.truncated;}
    }
    let voices=[];let ids=array_sort(map_keys(records));for i len(ids){array_push(voices,records[ids[i]]);}
    let engine=_fixed_version(["/usr/bin/espeak-ng","/usr/bin/espeak"]);
    return map{ok:true,executed:true,format:FORMAT,voices:voices,count:len(voices),truncated:truncated,
        engine:"espeak-ng",engine_callable:engine.callable,voice_data_installed:root!=nil,
        data_only:root!=nil and not engine.callable,absolute_paths_exposed:false,
        file_contents_exposed:false,descriptor_held_inventory:true,
        process_group_terminated:engine.process_group_terminated};}

fn _model_name(filename){let lower=str_lower(filename);let known=["tiny","base","small","medium","large"];
    for i len(known){if str_contains(lower,known[i]){return known[i];}}return nil;}
fn list_models(){let known=["tiny","base","small","medium","large"];let installed=map{};
    let roots=["/usr/share/whisper","/usr/local/share/whisper"];let scanned=0;let truncated=false;
    for i len(roots){let files=_list(roots[i],MAX_ENTRIES);if files.ok{scanned=scanned+1;
        for j len(files.entries){let file=files.entries[j];let lower=str_lower(file);
            if _safe(file) and (str_ends_with(lower,".pt") or str_ends_with(lower,".bin") or str_ends_with(lower,".gguf")){
                let model=_model_name(file);if model!=nil and not map_has(installed,model){installed[model]=file;}}}
        truncated=truncated or files.truncated;}}
    let models=[];for i len(known){let name=known[i];array_push(models,map{name:name,installed:map_has(installed,name),
        artifact:try installed[name] catch nil,engine:"whisper"});}
    let engine=_fixed_version(["/usr/bin/whisper","/usr/local/bin/whisper",
        "/usr/bin/whisper-cli","/usr/local/bin/whisper-cli"]);
    let count=0;for i len(models){if models[i].installed{count=count+1;}}
    return map{ok:true,executed:true,format:FORMAT,models:models,known_count:len(models),
        installed_count:count,roots_present:scanned,entries_truncated:truncated,
        engine:"whisper",engine_callable:engine.callable,model_contents_exposed:false,
        absolute_paths_exposed:false,descriptor_held_inventory:true,
        process_group_terminated:engine.process_group_terminated};}

export list_voices,list_models,FORMAT,MAX_ENTRIES;
