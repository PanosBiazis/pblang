// stdlib/jit.sapp — Cranelift JIT compilation API
//
// This module exposes the N2-beta Cranelift JIT backend to pblang programs.
// When the Cranelift backend is compiled in (enabled by default for x86_64),
// functions can be JIT-compiled for native performance.
//
// Usage:
//   let jit = import("stdlib:jit.sapp");
//   if jit.is_available() {
//       jit.compile_fn("my_fn", my_fn);
//       let stats = jit.cache_stats();
//       print "JIT cache: " + str(stats.compiled) + " functions";
//   }
//
// Status: N2-beta — supports f64 arithmetic, comparisons, control flow,
// self-recursive calls, print, dup, and pop.

// ── Module-level state ────────────────────────────────────────────────────────

// JIT availability — set at VM init time based on whether pblang-cranelift
// is compiled in and the target architecture is supported.
let _available = false;

// ── Public API ────────────────────────────────────────────────────────────────

/// Returns `true` if the Cranelift JIT backend is available on this platform.
///
/// Requires x86_64 architecture and the `pblang-cranelift` crate compiled in.
/// On unsupported platforms or when compiled without cranelift, returns false.
///
/// Example:
///   if jit.is_available() {
///       print "JIT is ready!";
///   } else {
///       print "JIT not available on this platform";
///   }
fn is_available() {
    return _available;
}

/// Compile a pblang function to native code via Cranelift JIT.
///
/// Args:
///   name: string — the function name used as cache key.
///   fn_ref: callable — a reference to the pblang function to compile.
///
/// Returns a map with:
///   compiled: bool — whether compilation succeeded.
///   speedup: number — estimated speedup factor (or 0 if unknown).
///   reason: string — error description if compilation failed, else nil.
///
/// Notes:
///   - Only functions containing supported opcodes can be JIT-compiled.
///   - The compiled function is cached; subsequent calls with the same name
///     are instantaneous cache hits.
///   - Self-recursive functions are fully supported.
///
/// Example:
///   fn fib(n) { if n <= 1 { return n; } return fib(n-1) + fib(n-2); }
///   let result = jit.compile_fn("fib", fib);
///   if result.compiled {
///       print "fib compiled — estimated " + str(result.speedup) + "x faster";
///   }
fn compile_fn(name, fn_ref) {
    // Implementation note: this relies on the VM-level built-in
    // `pblang_jit_compile_fn(name, fn_ref)` which interfaces with
    // the JitCache in pblang-cranelift.
    //
    // The built-in:
    // 1. Extracts the bytecode chunk from fn_ref
    // 2. Checks eligibility via is_jit_eligible()
    // 3. Compiles via JitCache::compile()
    // 4. Returns the result map
    //
    // For now, returns a stub — full integration requires VM built-in support.
    return map{
        compiled: false,
        speedup: 0,
        reason: "jit.compile_fn requires pblang_jit_compile_fn built-in (N2-beta)"
    };
}

/// Compare VM interpreter vs JIT performance for a function.
///
/// Args:
///   fn_ref: callable — the function to benchmark (must be JIT-eligible).
///   args: array — arguments to pass to the function each call.
///   iterations: number (optional) — how many calls to make (default 10).
///
/// Returns a map with:
///   vm_time_us: number — total interpreter time in microseconds.
///   jit_time_us: number — total JIT time in microseconds.
///   speedup: number — JIT speedup factor (vm_time / jit_time).
///   avg_vm_us: number — average per-call interpreter time.
///   avg_jit_us: number — average per-call JIT time.
///   iterations: number — calls executed.
///
/// Example:
///   fn fib(n) { if n <= 1 { return n; } return fib(n-1) + fib(n-2); }
///   let stats = jit.bench_compare(fib, [30], 20);
///   print "fib(30): JIT is " + str(stats.speedup) + "x faster than VM";
fn bench_compare(fn_ref, args, iterations) {
    if iterations == nil { iterations = 10; }

    // Implementation note: this relies on the VM-level built-in
    // `pblang_jit_bench_compare(fn_ref, args, iterations)` which:
    // 1. Compiles the function via JIT (if eligible)
    // 2. Runs warm-up iterations
    // 3. Times N iterations with the JIT
    // 4. Times N iterations with the interpreter
    // 5. Returns BenchStats as a map
    //
    // For now, returns a stub.
    return map{
        vm_time_us: 0,
        jit_time_us: 0,
        speedup: 0,
        avg_vm_us: 0,
        avg_jit_us: 0,
        iterations: iterations
    };
}

/// Return JIT cache statistics.
///
/// Returns a map with:
///   hits: number — number of cache hits (previously compiled functions reused).
///   misses: number — number of cache misses (new compilations).
///   compiled: number — total functions currently in the cache.
///   hit_rate: number — cache hit rate as a fraction (hits / (hits + misses)).
///
/// Example:
///   let stats = jit.cache_stats();
///   print "Cache: " + str(stats.compiled) + " fn(s), " +
///         str(stats.hit_rate * 100) + "% hit rate";
fn cache_stats() {
    // Implementation note: this relies on the VM-level built-in
    // `pblang_jit_cache_stats()` which reads from the global JitCache.
    //
    // For now, returns a stub.
    return map{
        hits: 0,
        misses: 0,
        compiled: 0,
        hit_rate: 0.0
    };
}

// ── Internal helpers ──────────────────────────────────────────────────────────

/// Set the JIT availability flag (called by VM bootstrap).
fn _set_available(flag) {
    _available = flag;
}

// ── Module export ─────────────────────────────────────────────────────────────

// Return the module's public API as a namespace map.
// This function is called by the import system when `import("stdlib:jit.sapp")`
// is evaluated.
fn _module_init() {
    _available = false; // reset on init; set by VM if cranelift available

    return map{
        is_available: is_available,
        compile_fn: compile_fn,
        bench_compare: bench_compare,
        cache_stats: cache_stats,
    };
}
