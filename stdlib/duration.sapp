// stdlib/duration.sapp — time spans (durations) for pblang.
//
// A Duration is represented as a plain number of SECONDS (may be fractional),
// so it composes directly with unix timestamps and with `stdlib/date.sapp`
// (which also works in seconds) and `clock()`.
//
// Usage:
//   let d = import("stdlib:duration.sapp");
//   let span = d.add(d.hours(1), d.minutes(30));   // 5400 seconds
//   print d.humanize(span);                         // "1h 30m"
//   print d.parse("1h30m") == span;                 // true

// ── Constructors (unit → seconds) ────────────────────────────────────────────
fn millis(n)  { return n / 1000.0; }
fn seconds(n) { return n; }
fn minutes(n) { return n * 60.0; }
fn hours(n)   { return n * 3600.0; }
fn days(n)    { return n * 86400.0; }
fn weeks(n)   { return n * 604800.0; }

// ── Arithmetic ───────────────────────────────────────────────────────────────
fn add(a, b)     { return a + b; }
fn sub(a, b)     { return a - b; }
fn scale(d, k)   { return d * k; }
fn negate(d)     { return 0 - d; }
fn abs_dur(d)    { if d < 0 { return 0 - d; } return d; }

// ── Comparison ───────────────────────────────────────────────────────────────
// -1 if a<b, 0 if equal, 1 if a>b.
fn compare(a, b) {
    if a < b { return 0 - 1; }
    if a > b { return 1; }
    return 0;
}
fn eq(a, b) { return a == b; }
fn lt(a, b) { return a < b; }
fn gt(a, b) { return a > b; }

// ── Conversions (seconds → unit) ─────────────────────────────────────────────
fn as_millis(d)  { return d * 1000.0; }
fn as_seconds(d) { return d; }
fn as_minutes(d) { return d / 60.0; }
fn as_hours(d)   { return d / 3600.0; }
fn as_days(d)    { return d / 86400.0; }

// between(ts1, ts2) → duration in seconds from ts1 to ts2.
fn between(ts1, ts2) { return ts2 - ts1; }

// ── Decomposition ────────────────────────────────────────────────────────────
// parts(d) → map{ negative, days, hours, minutes, seconds, millis }
// where seconds is the whole-second remainder (0..59) and millis is 0..999.
fn parts(d) {
    let neg = d < 0;
    let total = d;
    if neg { total = 0 - d; }
    let total_ms = num_floor(total * 1000.0 + 0.5);  // round to nearest ms
    let ms = num_mod(total_ms, 1000);
    let total_s = num_floor(total_ms / 1000.0);
    let s = num_mod(total_s, 60);
    let total_m = num_floor(total_s / 60.0);
    let m = num_mod(total_m, 60);
    let total_h = num_floor(total_m / 60.0);
    let h = num_mod(total_h, 24);
    let days_part = num_floor(total_h / 24.0);
    return map{
        negative: neg,
        days: days_part,
        hours: h,
        minutes: m,
        seconds: s,
        millis: ms
    };
}

// humanize(d) → compact human string, e.g. "1d 2h 3m 4s" / "500ms" / "-2m 5s".
// Largest non-zero unit leads; trailing zero units are dropped.
fn humanize(d) {
    if d == 0 { return "0s"; }
    let p = parts(d);
    let out = "";
    if p.days > 0    { out = out + str(p.days) + "d "; }
    if p.hours > 0   { out = out + str(p.hours) + "h "; }
    if p.minutes > 0 { out = out + str(p.minutes) + "m "; }
    if p.seconds > 0 { out = out + str(p.seconds) + "s "; }
    // Only show milliseconds when there is no larger unit (sub-second span).
    if out == "" and p.millis > 0 { out = str(p.millis) + "ms "; }
    out = str_trim(out);
    if p.negative { return "-" + out; }
    return out;
}

fn _pad2(n) {
    if n < 10 { return "0" + str(n); }
    return str(n);
}

// format_clock(d) → "HH:MM:SS", prefixed with "D:" when the span is >= 1 day.
fn format_clock(d) {
    let p = parts(d);
    let body = _pad2(p.hours) + ":" + _pad2(p.minutes) + ":" + _pad2(p.seconds);
    let out = body;
    if p.days > 0 { out = str(p.days) + ":" + body; }
    if p.negative { return "-" + out; }
    return out;
}

fn _is_digit_char(c) {
    return c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
        or c == "5" or c == "6" or c == "7" or c == "8" or c == "9";
}

// parse(s) → seconds, or nil on malformed input.
// Accepts a sequence of `<number><unit>` tokens (optional whitespace between),
// units: ms, s, m, h, d, w. Examples: "1h30m", "90s", "2d 4h", "500ms".
fn parse(s) {
    let total = 0.0;
    let i = 0;
    let n = len(s);
    let saw_token = false;
    while i < n {
        let c = s[i];
        if c == " " or c == "\t" {
            i = i + 1;
        } else if _is_digit_char(c) or c == "." {
            // read number
            let num_str = "";
            while i < n and (_is_digit_char(s[i]) or s[i] == ".") {
                num_str = num_str + s[i];
                i = i + 1;
            }
            // read unit (longest match: "ms" before "m")
            let unit = "";
            while i < n and not _is_digit_char(s[i]) and s[i] != " " and s[i] != "\t" and s[i] != "." {
                unit = unit + s[i];
                i = i + 1;
            }
            let value = parse_number(num_str);
            if value == nil { return nil; }
            if unit == "ms" {
                total = total + value / 1000.0;
            } else if unit == "s" {
                total = total + value;
            } else if unit == "m" {
                total = total + value * 60.0;
            } else if unit == "h" {
                total = total + value * 3600.0;
            } else if unit == "d" {
                total = total + value * 86400.0;
            } else if unit == "w" {
                total = total + value * 604800.0;
            } else {
                return nil;  // unknown unit
            }
            saw_token = true;
        } else {
            return nil;  // unexpected character
        }
    }
    if saw_token == false { return nil; }
    return total;
}

// ── extras ─────────────────────────────────────────────────────────────────────
fn as_weeks(d) { return d / 604800.0; }
fn is_zero(d) { return d == 0; }
fn min_dur(a, b) { if a < b { return a; } return b; }
fn max_dur(a, b) { if a > b { return a; } return b; }
fn clamp(d, lo, hi) { if d < lo { return lo; } if d > hi { return hi; } return d; }

// round_to(d, unit_secs) — round a duration to the nearest multiple of unit_secs.
fn round_to(d, unit_secs) {
    if unit_secs <= 0 { return d; }
    return num_floor(d / unit_secs + 0.5) * unit_secs;
}

// from_parts(days, h, m, s) — build a duration (seconds) from components.
fn from_parts(d, h, m, s) { return d * 86400.0 + h * 3600.0 + m * 60.0 + s; }

export millis, seconds, minutes, hours, days, weeks;
export add, sub, scale, negate, abs_dur, compare, eq, lt, gt;
export as_millis, as_seconds, as_minutes, as_hours, as_days, between;
export parts, humanize, format_clock, parse;
export as_weeks, is_zero, min_dur, max_dur, clamp, round_to, from_parts;
