// stdlib/nn_curiosity.sapp — curiosity-driven & developmental learning for nn.sapp MLPs.
//
// The model learns most from what SURPRISES it. "Curiosity" is the prediction error on a
// sample; the trainer spends extra effort where surprise is highest (active learning),
// can order a curriculum easy→hard, and DEVELOPS — growing its own capacity (densify)
// when learning plateaus, i.e. when it stays curious about things it can't yet fit. This
// makes learning faster and self-extending without manual resizing.
//
//   let cur = import("stdlib:nn_curiosity.sapp");
//   cur.curious_train(net, data, 500, 0.3, 3);     // focus on the 3 most surprising
//   let g = cur.develop(net, data, 6, 100, 0.3, 0.001);  // grows capacity when stuck

let nn = import("stdlib:nn.sapp");

// curiosity(net, sample) — surprise = prediction error on one sample (high = novel).
fn curiosity(net, sample) { return nn.mse_loss(nn.predict(net, sample.x), sample.y); }

// surprise_scores(net, data) — curiosity per sample.
fn surprise_scores(net, data) {
    let out = [];
    let i = 0;
    while i < len(data) { push(out, curiosity(net, data[i])); i = i + 1; }
    return out;
}

// most_curious(net, data, k) — indices of the k most surprising samples (what to explore).
fn most_curious(net, data, k) {
    let sc = surprise_scores(net, data);
    let idx = [];
    let i = 0;
    while i < len(sc) { push(idx, i); i = i + 1; }
    let a = 1;                                   // insertion sort descending by score
    while a < len(idx) {
        let ki = idx[a];
        let b = a - 1;
        while b >= 0 and sc[idx[b]] < sc[ki] { idx[b + 1] = idx[b]; b = b - 1; }
        idx[b + 1] = ki;
        a = a + 1;
    }
    let out = [];
    let j = 0;
    while j < k and j < len(idx) { push(out, idx[j]); j = j + 1; }
    return out;
}

// curriculum_order(net, data) — samples reordered easy → hard (ascending surprise), the
// developmental "learn to walk before you run" schedule.
fn curriculum_order(net, data) {
    let sc = surprise_scores(net, data);
    let idx = [];
    let i = 0;
    while i < len(sc) { push(idx, i); i = i + 1; }
    let a = 1;                                   // insertion sort ascending by score
    while a < len(idx) {
        let ki = idx[a];
        let b = a - 1;
        while b >= 0 and sc[idx[b]] > sc[ki] { idx[b + 1] = idx[b]; b = b - 1; }
        idx[b + 1] = ki;
        a = a + 1;
    }
    let out = [];
    let j = 0;
    while j < len(idx) { push(out, data[idx[j]]); j = j + 1; }
    return out;
}

// curious_train(net, data, epochs, lr, focus) — each epoch trains the whole set, then
// takes EXTRA gradient steps on the `focus` most surprising samples (curiosity emphasis),
// which accelerates learning of the hard cases. Mutates net; returns the final loss.
fn curious_train(net, data, epochs, lr, focus) {
    let e = 0;
    let last = 0;
    while e < epochs {
        let total = 0;
        let d = 0;
        while d < len(data) { total = total + nn.train_sample(net, data[d].x, data[d].y, lr); d = d + 1; }
        let mc = most_curious(net, data, focus);
        let m = 0;
        while m < len(mc) { nn.train_sample(net, data[mc[m]].x, data[mc[m]].y, lr); m = m + 1; }
        last = total;
        e = e + 1;
    }
    return last;
}

// develop(net, data, rounds, epochs, lr, plateau_tol) — a developmental loop: train a
// round; if the loss barely improved (the model is stuck / persistently curious), GROW
// capacity by one neuron (function-preserving densify) and keep going. Returns
// { net, grew (times grown), loss }. Works on a clone — the input net is untouched.
fn develop(net, data, rounds, epochs, lr, plateau_tol) {
    let work = nn.clone(net);
    let prev = nn.loss(work, data);
    let grew = 0;
    let r = 0;
    while r < rounds {
        nn.train(work, data, epochs, lr);
        let cur_loss = nn.loss(work, data);
        if prev - cur_loss < plateau_tol { work = nn.densify(work, 1); grew = grew + 1; }
        prev = cur_loss;
        r = r + 1;
    }
    return map{ net: work, grew: grew, loss: nn.loss(work, data) };
}

export curiosity, surprise_scores, most_curious, curriculum_order, curious_train, develop;
