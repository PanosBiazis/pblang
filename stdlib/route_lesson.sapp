// Bounded directed graph lessons. Uses existing Dijkstra; no network or file I/O.
let Algorithms=import("stdlib:algorithms_advanced.sapp");
fn _id(id) {
    if type(id)!="string" or len(id)<1 or len(id)>16 {throw "invalid node id";}
    for i in range(0,len(id)) {if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",str_slice(id,i,i+1))<0 {throw "invalid node id";}}
}
fn _graph(spec) {
    if type(spec)!="map" or len(spec)!=2 or not map_has(spec,"nodes") or not map_has(spec,"edges") {throw "invalid graph shape";}
    if type(spec.nodes)!="array" or len(spec.nodes)<1 or len(spec.nodes)>32 or type(spec.edges)!="array" or len(spec.edges)>128 {throw "graph size limit";}
    let graph=map{};let seen=map{};
    for id in spec.nodes {_id(id);if map_has(graph,id) {throw "duplicate node";}graph[id]=[];}
    for edge in spec.edges {
        if type(edge)!="map" or len(edge)!=3 or not map_has(edge,"from") or not map_has(edge,"to") or not map_has(edge,"cost") {throw "invalid edge";}
        _id(edge.from);_id(edge.to);
        if edge.from==edge.to or not map_has(graph,edge.from) or not map_has(graph,edge.to) {throw "invalid edge endpoints";}
        if type(edge.cost)!="number" or edge.cost<1 or edge.cost>1000000 or edge.cost!=num_floor(edge.cost) {throw "cost must be an integer from 1 to 1000000";}
        let key=edge.from+">"+edge.to;if map_has(seen,key) {throw "duplicate directed edge";}seen[key]=true;
        array_push(graph[edge.from],map{to:edge.to,weight:edge.cost});
    }return graph;
}
fn analyze(spec,source,target) {
    let graph=_graph(spec);_id(source);_id(target);
    if not map_has(graph,source) or not map_has(graph,target) {throw "unknown endpoint";}
    let distances=Algorithms.dijkstra(graph,source);let reachable=map_has(distances,target);let path=[];let selected=map{};
    if reachable {
        let reversed=[target];let current=target;
        while current!=source {
            let previous="";
            // Declaration order breaks ties; positive costs strictly decrease distance.
            for edge in spec.edges {
                if edge.to==current and map_has(distances,edge.from) and distances[edge.from]+edge.cost==distances[current] {previous=edge.from;break;}
            }
            if previous=="" or len(reversed)>=len(spec.nodes) {throw "inconsistent shortest path";}
            selected[previous+">"+current]=true;array_push(reversed,previous);current=previous;
        }
        for i in range(0,len(reversed)) {array_push(path,reversed[len(reversed)-1-i]);}
    }
    let nodes=[];let edges=[];
    for id in spec.nodes {
        let on_path=false;for item in path {if item==id {on_path=true;}}
        array_push(nodes,map{id:id,reachable:map_has(distances,id),distance:if map_has(distances,id) {distances[id]} else {nil},on_path:on_path});
    }
    for edge in spec.edges {array_push(edges,map{from:edge.from,to:edge.to,cost:edge.cost,on_path:map_has(selected,edge.from+">"+edge.to)});}
    return map{format:"pblang.route-lesson.v1",source:source,target:target,reachable:reachable,path:path,
        cost:if reachable {distances[target]} else {nil},nodes:nodes,edges:edges,
        network_access_performed:false,contains_input_labels:true};
}
// SVG and the numeric report always derive from the same validated graph.
fn diagram(spec,source,target) {
    let report=analyze(spec,source,target);let positions=map{};
    for i in range(0,len(report.nodes)) {positions[report.nodes[i].id]=map{x:80+(i%4)*170,y:75+num_floor(i/4)*120};}
    let height=80+num_floor((len(report.nodes)-1)/4+1)*120;
    let svg="<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 680 "+str(height)+"\" role=\"img\" aria-label=\"Directed route lesson\"><title>Directed route lesson</title><desc>Green marks the selected minimum-cost path. Red marks unreachable nodes. This is a supplied graph, not a network scan.</desc><defs><marker id=\"arrow\" markerWidth=\"7\" markerHeight=\"7\" refX=\"7\" refY=\"3.5\" orient=\"auto\"><path d=\"M0,0 L7,3.5 L0,7 Z\" fill=\"context-stroke\"/></marker></defs><rect width=\"100%\" height=\"100%\" fill=\"#111827\"/>";
    for edge in report.edges {
        let a=positions[edge.from];let b=positions[edge.to];let color=if edge.on_path {"#4ade80"} else {"#94a3b8"};
        let dx=b.x-a.x;let dy=b.y-a.y;let length=num_sqrt(dx*dx+dy*dy);let ux=dx/length;let uy=dy/length;
        let bend=if length>200 {70} else {40};let cx=(a.x+b.x)/2+uy*bend;let cy=(a.y+b.y)/2-ux*bend;
        svg=svg+"<path d=\"M "+str(a.x+25*ux)+" "+str(a.y+25*uy)+" Q "+str(cx)+" "+str(cy)+" "+str(b.x-27*ux)+" "+str(b.y-27*uy)+"\" fill=\"none\" stroke=\""+color+"\" stroke-width=\"3\" marker-end=\"url(#arrow)\"/><text x=\""+str((a.x+b.x+2*cx)/4)+"\" y=\""+str((a.y+b.y+2*cy)/4-7)+"\" fill=\"#f8fafc\" text-anchor=\"middle\" font-size=\"12\">"+str(edge.cost)+"</text>";
    }
    for node in report.nodes {
        let p=positions[node.id];let color="#94a3b8";if not node.reachable {color="#fb7185";} elif node.on_path {color="#4ade80";}
        let distance=if node.reachable {"distance "+str(node.distance)} else {"unreachable"};
        svg=svg+"<circle cx=\""+str(p.x)+"\" cy=\""+str(p.y)+"\" r=\"24\" fill=\"#1e293b\" stroke=\""+color+"\" stroke-width=\"3\"/><text x=\""+str(p.x)+"\" y=\""+str(p.y+44)+"\" fill=\"#f8fafc\" text-anchor=\"middle\" font-size=\"12\">"+node.id+"</text><text x=\""+str(p.x)+"\" y=\""+str(p.y+61)+"\" fill=\""+color+"\" text-anchor=\"middle\" font-size=\"11\">"+distance+"</text>";
    }
    svg=svg+"</svg>";return map{report:report,svg:svg};
}
export analyze,diagram;
