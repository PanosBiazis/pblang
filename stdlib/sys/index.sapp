// stdlib/sys/index.sapp — Unified Sovereign Pure-PBLang OS Syscall & Kernel ABI Facade (v4.2.0)
//
// Exposes all 100% pure-PBLang OS kernel syscalls across Linux (`x86_64` & `aarch64`),
// macOS (`libSystem.B.dylib`), and Windows (`ws2_32.dll` + `kernel32.dll` + `msvcrt.dll`)
// with strict SSRF defense, `W^X` machine-code execution, `memfd_create` RAM buffers,
// HTTP/1.1 Keep-Alive connection pooling, and deterministic sandbox fallback.

let SYS = import("stdlib:sys/pure_os_syscalls.sapp");
let HOR = import("stdlib:sys/universal_adaptive_horizon.sapp");

let PURE_SYS_VERSION = SYS.PURE_SYS_VERSION;
let HORIZON_VERSION = HOR.HORIZON_VERSION;
let AF_INET = SYS.AF_INET;
let SOCK_STREAM = SYS.SOCK_STREAM;
let SOCK_DGRAM = SYS.SOCK_DGRAM;
let PROT_NONE = SYS.PROT_NONE;
let PROT_READ = SYS.PROT_READ;
let PROT_WRITE = SYS.PROT_WRITE;
let PROT_EXEC = SYS.PROT_EXEC;
let POLLIN = SYS.POLLIN;
let POLLOUT = SYS.POLLOUT;
let POLLERR = SYS.POLLERR;
let POLLHUP = SYS.POLLHUP;
let POLLNVAL = SYS.POLLNVAL;
let MFD_CLOEXEC = SYS.MFD_CLOEXEC;
let MFD_ALLOW_SEALING = SYS.MFD_ALLOW_SEALING;

// ── Capability & SSRF Guards ─────────────────────────────────────────────────

fn pure_os_capabilities(opts = nil) { return SYS.pure_os_capabilities(opts); }
fn pure_parse_ipv4(host_str) { return SYS.pure_parse_ipv4(host_str); }
fn pure_check_ssrf_ip(host_str, opts = nil) { return SYS.pure_check_ssrf_ip(host_str, opts); }

// ── 1. Direct Kernel UDP Datagram Sockets ────────────────────────────────────

fn pure_pack_sockaddr_in(ip_str, port_num, is_bsd_override = nil) {
    return SYS.pure_pack_sockaddr_in(ip_str, port_num, is_bsd_override);
}
fn pure_unpack_sockaddr_in(sockaddr_buf, is_bsd_override = nil) {
    return SYS.pure_unpack_sockaddr_in(sockaddr_buf, is_bsd_override);
}
fn pure_udp_bind(host_or_addr = "127.0.0.1", port_arg = nil, opts = nil) {
    return SYS.pure_udp_bind(host_or_addr, port_arg, opts);
}
fn pure_udp_local_addr(sock) { return SYS.pure_udp_local_addr(sock); }
fn pure_udp_set_timeout(sock, timeout_ms) { return SYS.pure_udp_set_timeout(sock, timeout_ms); }
fn pure_udp_sendto(sock, payload, dst_host_or_addr, dst_port_arg = nil, opts = nil) {
    return SYS.pure_udp_sendto(sock, payload, dst_host_or_addr, dst_port_arg, opts);
}
fn pure_udp_recvfrom(sock, max_len = 2048, timeout_override_ms = nil) {
    return SYS.pure_udp_recvfrom(sock, max_len, timeout_override_ms);
}
fn pure_udp_close(sock) { return SYS.pure_udp_close(sock); }

// ── 2. Kernel TCP Liveness Peek & HTTP/1.1 Keep-Alive Framing Engine ─────────

fn pure_socket_alive_poll(sock_or_fd) { return SYS.pure_socket_alive_poll(sock_or_fd); }
fn pure_encode_chunked_body(chunks_arr) { return SYS.pure_encode_chunked_body(chunks_arr); }
fn pure_decode_chunked_bytes(raw_str_or_bytes) { return SYS.pure_decode_chunked_bytes(raw_str_or_bytes); }
fn pure_build_multipart_chunks(parts_arr, boundary_str = nil, max_chunk = 16384) {
    return SYS.pure_build_multipart_chunks(parts_arr, boundary_str, max_chunk);
}
fn pure_http11_keepalive_client(opts = nil) { return SYS.pure_http11_keepalive_client(opts); }
fn pure_http11_request(client, method_str, url_str, headers = nil, body = nil, req_opts = nil) {
    return SYS.pure_http11_request(client, method_str, url_str, headers, body, req_opts);
}
fn pure_http11_close_all(client) { return SYS.pure_http11_close_all(client); }

// ── 3. Direct Pure-PBLang `W^X` Executable Memory & Live JIT Runner ──────────

fn pure_wx_alloc(code_or_size, opts = nil) { return SYS.pure_wx_alloc(code_or_size, opts); }
fn pure_wx_write(wx_block, code_bytes_or_arr, offset = 0) { return SYS.pure_wx_write(wx_block, code_bytes_or_arr, offset); }
fn pure_wx_protect_rx(wx_block) { return SYS.pure_wx_protect_rx(wx_block); }
fn pure_wx_exec_i64(wx_block, arg0_or_arr = nil, arg1 = 0, arg2 = 0, arg3 = 0) {
    return SYS.pure_wx_exec_i64(wx_block, arg0_or_arr, arg1, arg2, arg3);
}
fn pure_wx_free(wx_block) { return SYS.pure_wx_free(wx_block); }
fn pure_wx_verify_unmapped(ptr_addr) { return SYS.pure_wx_verify_unmapped(ptr_addr); }

// ── 4. Linux `memfd_create` Shared Memory & Monotonic Nanosecond Clock ───────

fn pure_monotonic_ns() { return SYS.pure_monotonic_ns(); }
fn pure_memfd_create(name_str = "pblang_shm", size_bytes = 4096, opts = nil) {
    return SYS.pure_memfd_create(name_str, size_bytes, opts);
}
fn pure_memfd_write(mfd, offset, payload) { return SYS.pure_memfd_write(mfd, offset, payload); }
fn pure_memfd_read(mfd, offset, count) { return SYS.pure_memfd_read(mfd, offset, count); }
fn pure_memfd_close(mfd) { return SYS.pure_memfd_close(mfd); }
fn pure_chmod_exec(file_path) { return SYS.pure_chmod_exec(file_path); }
fn pure_apply_oom_shield(max_bytes = 2684354560, oom_score_adj = 850) {
    return SYS.pure_apply_oom_shield(max_bytes, oom_score_adj);
}

let RLIMIT_AS_LINUX = SYS.RLIMIT_AS_LINUX;
let RLIMIT_AS_BSD = SYS.RLIMIT_AS_BSD;
let OOM_SHIELD_DEFAULT_BYTES = SYS.OOM_SHIELD_DEFAULT_BYTES;
let OOM_SHIELD_DEFAULT_SCORE_ADJ = SYS.OOM_SHIELD_DEFAULT_SCORE_ADJ;

// ── Grouped Sub-Namespaces ───────────────────────────────────────────────────

let ssrf = map{
    parse_ipv4: pure_parse_ipv4,
    check_ip: pure_check_ssrf_ip
};

let udp = map{
    pack_sockaddr_in: pure_pack_sockaddr_in,
    unpack_sockaddr_in: pure_unpack_sockaddr_in,
    bind: pure_udp_bind,
    local_addr: pure_udp_local_addr,
    set_timeout: pure_udp_set_timeout,
    sendto: pure_udp_sendto,
    recvfrom: pure_udp_recvfrom,
    close: pure_udp_close
};

let http = map{
    alive_poll: pure_socket_alive_poll,
    encode_chunked: pure_encode_chunked_body,
    decode_chunked: pure_decode_chunked_bytes,
    build_multipart: pure_build_multipart_chunks,
    keepalive_client: pure_http11_keepalive_client,
    request: pure_http11_request,
    close_all: pure_http11_close_all
};

let wx = map{
    alloc: pure_wx_alloc,
    write: pure_wx_write,
    protect_rx: pure_wx_protect_rx,
    exec_i64: pure_wx_exec_i64,
    free: pure_wx_free,
    verify_unmapped: pure_wx_verify_unmapped
};

let memfd = map{
    create: pure_memfd_create,
    write: pure_memfd_write,
    read: pure_memfd_read,
    close: pure_memfd_close
};

let clock = map{
    monotonic_ns: pure_monotonic_ns
};

fn probe_universal_system_horizon(overrides = nil) {
    return HOR.probe_universal_system_horizon(overrides);
}

fn select_adaptive_stack(opts = nil) {
    return HOR.select_adaptive_stack(opts);
}

fn verify_no_protocol_downgrade(scheme, chosen_proto, fallback_chain, opts = nil) {
    return HOR.verify_no_protocol_downgrade(scheme, chosen_proto, fallback_chain, opts);
}

fn validate_alt_svc_target(origin_host, alt_host, alt_port, opts = nil) {
    return HOR.validate_alt_svc_target(origin_host, alt_host, alt_port, opts);
}

fn harvest_hybrid_entropy_seed(context_tag = "") {
    return HOR.harvest_hybrid_entropy_seed(context_tag);
}

fn seal_legacy_transport_envelope(payload, shared_secret, seq_num = 1, aad = "") {
    return HOR.seal_legacy_transport_envelope(payload, shared_secret, seq_num, aad);
}

fn open_legacy_transport_envelope(envelope_str, shared_secret, min_seq_num = 1, aad = "") {
    return HOR.open_legacy_transport_envelope(envelope_str, shared_secret, min_seq_num, aad);
}

fn render_adaptive_beautiful_surface(model, target_mode = "auto") {
    return HOR.render_adaptive_beautiful_surface(model, target_mode);
}

let oom = map{
    apply_shield: pure_apply_oom_shield,
    default_bytes: OOM_SHIELD_DEFAULT_BYTES,
    default_score_adj: OOM_SHIELD_DEFAULT_SCORE_ADJ
};

let horizon = map{
    version: HORIZON_VERSION,
    probe: probe_universal_system_horizon,
    select_stack: select_adaptive_stack,
    verify_no_downgrade: verify_no_protocol_downgrade,
    validate_alt_svc: validate_alt_svc_target,
    harvest_entropy: harvest_hybrid_entropy_seed,
    seal_legacy_envelope: seal_legacy_transport_envelope,
    open_legacy_envelope: open_legacy_transport_envelope,
    render_surface: render_adaptive_beautiful_surface
};

export PURE_SYS_VERSION, HORIZON_VERSION,
       AF_INET, SOCK_STREAM, SOCK_DGRAM,
       PROT_NONE, PROT_READ, PROT_WRITE, PROT_EXEC,
       POLLIN, POLLOUT, POLLERR, POLLHUP, POLLNVAL,
       MFD_CLOEXEC, MFD_ALLOW_SEALING,
       RLIMIT_AS_LINUX, RLIMIT_AS_BSD,
       OOM_SHIELD_DEFAULT_BYTES, OOM_SHIELD_DEFAULT_SCORE_ADJ,
       ssrf, udp, http, wx, memfd, clock, oom, horizon,
       pure_os_capabilities,
       pure_parse_ipv4,
       pure_check_ssrf_ip,
       pure_pack_sockaddr_in,
       pure_unpack_sockaddr_in,
       pure_udp_bind,
       pure_udp_local_addr,
       pure_udp_set_timeout,
       pure_udp_sendto,
       pure_udp_recvfrom,
       pure_udp_close,
       pure_socket_alive_poll,
       pure_encode_chunked_body,
       pure_decode_chunked_bytes,
       pure_build_multipart_chunks,
       pure_http11_keepalive_client,
       pure_http11_request,
       pure_http11_close_all,
       pure_wx_alloc,
       pure_wx_write,
       pure_wx_protect_rx,
       pure_wx_exec_i64,
       pure_wx_free,
       pure_wx_verify_unmapped,
       pure_monotonic_ns,
       pure_memfd_create,
       pure_memfd_write,
       pure_memfd_read,
       pure_memfd_close,
       pure_chmod_exec,
       pure_apply_oom_shield,
       probe_universal_system_horizon,
       select_adaptive_stack,
       verify_no_protocol_downgrade,
       validate_alt_svc_target,
       harvest_hybrid_entropy_seed,
       seal_legacy_transport_envelope,
       open_legacy_transport_envelope,
       render_adaptive_beautiful_surface;
