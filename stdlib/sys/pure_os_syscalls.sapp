// stdlib/sys/pure_os_syscalls.sapp — 100% Pure-PBLang Sovereign OS Syscall & Kernel ABI Engine (v4.2.0)
//
// Implements low-level OS kernel primitives directly in 100% pure `.sapp` PBLang across:
//   - Linux (`x86_64` & `aarch64` via `libc.so.6`)
//   - macOS (`x86_64` & `arm64` via `libSystem.B.dylib`)
//   - Windows (`x86_64` via `ws2_32.dll` + `kernel32.dll` + `msvcrt.dll`)
//   - Deterministic virtual sandbox fallback when FFI capabilities are restricted or on WASM/WASI.
//
// Subsystems:
//   1. Kernel UDP Datagram Sockets (`pure_udp_bind`, `pure_udp_local_addr`, `pure_udp_set_timeout`,
//      `pure_udp_sendto`, `pure_udp_recvfrom`, `pure_udp_close`) + Strict SSRF Guard.
//   2. Kernel TCP Non-Blocking Liveness Peek (`pure_socket_alive_poll`) & Pure-PBLang HTTP/1.1
//      Keep-Alive Pool (8 idle sockets), Incremental `Content-Length` + `Transfer-Encoding: chunked`
//      Parser & Bounded-Chunk `multipart/form-data` Streaming (`pure_http11_keepalive_client`).
//   3. Strict `W^X` (`Write XOR Execute`) Executable Memory & Live CPU Machine-Code JIT Runner
//      (`pure_wx_alloc`, `pure_wx_write`, `pure_wx_protect_rx`, `pure_wx_exec_i64`, `pure_wx_free`).
//   4. Linux `memfd_create` Zero-Disk Shared Memory (`pure_memfd_create`, `pure_memfd_write`,
//      `pure_memfd_read`, `pure_memfd_close`) & True Monotonic Nanosecond Clock (`pure_monotonic_ns`).

let PURE_SYS_VERSION = "4.2.0";

let AF_INET = 2;
let SOCK_STREAM = 1;
let SOCK_DGRAM = 2;
let IPPROTO_UDP = 17;

let PROT_NONE = 0;
let PROT_READ = 1;
let PROT_WRITE = 2;
let PROT_EXEC = 4;

let MAP_PRIVATE_ANON_LINUX = 34;     // MAP_PRIVATE(0x02) | MAP_ANONYMOUS(0x20)
let MAP_PRIVATE_ANON_MACOS = 4098;   // MAP_PRIVATE(0x02) | MAP_ANON(0x1000)

let WIN_MEM_COMMIT_RESERVE = 12288;  // MEM_COMMIT(0x1000) | MEM_RESERVE(0x2000)
let WIN_MEM_RELEASE = 32768;         // MEM_RELEASE(0x8000)
let WIN_PAGE_READWRITE = 4;          // PAGE_READWRITE(0x04)
let WIN_PAGE_EXECUTE_READ = 32;      // PAGE_EXECUTE_READ(0x20)

let POLLIN = 1;
let POLLOUT = 4;
let POLLERR = 8;
let POLLHUP = 16;
let POLLNVAL = 32;

let MFD_CLOEXEC = 1;
let MFD_ALLOW_SEALING = 2;

// Cached native ABI state and deterministic sandbox state
let _SYS_STATE = map{
    initialized: false,
    virt_next_port: 49152,
    virt_next_fd: 1000,
    virt_next_ptr: 268435456,
    virt_mono_last: 0,
    virt_mono_seq: 0,
    virt_udp_sockets: map{},
    virt_udp_by_addr: map{},
    virt_wx_blocks: map{},
    virt_memfds: map{},
    win_qpc_freq: 0,
    win_qpc_base: 0,
    posix_sec_base: -1
};

// ── General Helpers ──────────────────────────────────────────────────────────

fn _opt(m, key, fallback) {
    if is_map(m) and map_has(m, key) and m[key] != nil {
        return m[key];
    }
    return fallback;
}

fn _align_up(val, align_step) {
    if align_step <= 1 { return val; }
    let rem = val % align_step;
    if rem == 0 { return val; }
    return val + (align_step - rem);
}

fn _to_bytes_buf(payload) {
    if payload == nil { return bytes_new(0); }
    if is_bytes(payload) { return payload; }
    if is_string(payload) { return bytes_from_str(payload); }
    if is_array(payload) { return bytes_new(payload); }
    return bytes_from_str(str(payload));
}

fn _bytes_to_array(b) {
    if is_array(b) { return b; }
    let buf = _to_bytes_buf(b);
    let n = len(buf);
    let out = [];
    let i = 0;
    while i < n {
        array_push(out, bytes_get(buf, i));
        i = i + 1;
    }
    return out;
}

fn _u32_le_bytes(val) {
    let u = num_floor(val);
    if u < 0 { u = 4294967296 + u; }
    let b0 = bit_and(u, 255);
    let b1 = bit_and(num_floor(u / 256), 255);
    let b2 = bit_and(num_floor(u / 65536), 255);
    let b3 = bit_and(num_floor(u / 16777216), 255);
    return [b0, b1, b2, b3];
}

fn _put_u16_le(buf, off, val) {
    let u = num_floor(val);
    if u < 0 { u = 65536 + u; }
    bytes_set(buf, off, bit_and(u, 255));
    bytes_set(buf, off + 1, bit_and(num_floor(u / 256), 255));
}

fn _get_u16_le(buf, off) {
    return bytes_get(buf, off) + bytes_get(buf, off + 1) * 256;
}

fn _put_i32_le(buf, off, val) {
    let bs = _u32_le_bytes(val);
    bytes_set(buf, off, bs[0]);
    bytes_set(buf, off + 1, bs[1]);
    bytes_set(buf, off + 2, bs[2]);
    bytes_set(buf, off + 3, bs[3]);
}

fn _pack_u32_le_buf(val) {
    let b = bytes_new(4);
    _put_i32_le(b, 0, val);
    return b;
}

fn _put_i64_le(buf, off, val) {
    let v = num_floor(val);
    let hi = num_floor(v / 4294967296.0);
    let lo = v - hi * 4294967296.0;
    if lo < 0 {
        lo = lo + 4294967296.0;
        hi = hi - 1;
    }
    if hi < 0 {
        hi = hi + 4294967296.0;
    }
    _put_i32_le(buf, off, lo);
    _put_i32_le(buf, off + 4, hi);
}

fn _get_i64_le(buf, off) {
    let lo = bytes_get(buf, off)
        + bytes_get(buf, off + 1) * 256
        + bytes_get(buf, off + 2) * 65536
        + bytes_get(buf, off + 3) * 16777216;
    let hi_u = bytes_get(buf, off + 4)
        + bytes_get(buf, off + 5) * 256
        + bytes_get(buf, off + 6) * 65536
        + bytes_get(buf, off + 7) * 16777216;
    if hi_u >= 2147483648 {
        return (hi_u - 4294967296) * 4294967296 + lo;
    }
    return hi_u * 4294967296 + lo;
}

fn _pack_pollfd_buf(fd, events) {
    let b = bytes_new(8);
    _put_i32_le(b, 0, fd);
    _put_u16_le(b, 4, events);
    _put_u16_le(b, 6, 0);
    return b;
}

fn _try_load_first(candidates) {
    let i = 0;
    while i < len(candidates) {
        let h = try ffi_load(candidates[i]) catch nil;
        if h != nil {
            return map{ handle: h, name: candidates[i] };
        }
        i = i + 1;
    }
    return nil;
}

fn _init_sys_abi() {
    if _SYS_STATE["initialized"] == true {
        return _SYS_STATE;
    }
    let plat_raw = try platform() catch "unknown";
    let arch_raw = try os_arch() catch "unknown";
    let plat = str_lower(str(plat_raw));
    let arch = str_lower(str(arch_raw));

    let is_linux = (plat == "linux");
    let is_macos = (plat == "macos" or plat == "darwin");
    let is_win = (plat == "windows" or plat == "win32" or plat == "win64");
    let is_x64 = (arch == "x86_64" or arch == "amd64" or arch == "x64");
    let is_arm64 = (arch == "aarch64" or arch == "arm64");

    let libc_h = nil;
    let libc_name = "";
    let ws2_h = nil;
    let k32_h = nil;
    let msvcrt_h = nil;
    let native_ffi = false;
    let page_sz = 4096;

    if is_linux {
        let loaded = _try_load_first([
            "libc.so.6",
            "/lib/x86_64-linux-gnu/libc.so.6",
            "/usr/lib/x86_64-linux-gnu/libc.so.6",
            "/lib/aarch64-linux-gnu/libc.so.6",
            "/usr/lib/aarch64-linux-gnu/libc.so.6",
            "libc",
            "self"
        ]);
        if loaded != nil {
            libc_h = loaded["handle"];
            libc_name = loaded["name"];
            native_ffi = true;
            let sc_pg = try ffi_call_typed(libc_h, "sysconf", "i32->i64", [30]) catch 4096;
            if is_number(sc_pg) and sc_pg >= 4096 and sc_pg <= 65536 {
                page_sz = sc_pg;
            }
        }
    } elif is_macos {
        let loaded_m = _try_load_first(["libSystem.B.dylib", "libc.dylib", "self"]);
        if loaded_m != nil {
            libc_h = loaded_m["handle"];
            libc_name = loaded_m["name"];
            native_ffi = true;
            let sc_pg_m = try ffi_call_typed(libc_h, "sysconf", "i32->i64", [29]) catch 16384;
            if is_number(sc_pg_m) and sc_pg_m >= 4096 and sc_pg_m <= 65536 {
                page_sz = sc_pg_m;
            }
        }
    } elif is_win {
        let lk = _try_load_first(["kernel32.dll", "KERNEL32.DLL"]);
        let lw = _try_load_first(["ws2_32.dll", "WS2_32.DLL"]);
        let lm = _try_load_first(["msvcrt.dll", "ucrtbase.dll"]);
        if lk != nil { k32_h = lk["handle"]; }
        if lw != nil { ws2_h = lw["handle"]; }
        if lm != nil { msvcrt_h = lm["handle"]; }
        if k32_h != nil and ws2_h != nil {
            native_ffi = true;
            libc_name = "kernel32.dll+ws2_32.dll";
            let wsa_buf = bytes_new(512);
            try ffi_call_typed(ws2_h, "WSAStartup", "u16,ptr->i32", [514, wsa_buf]) catch 0;
            let freq_b = bytes_new(8);
            let ok_f = try ffi_call_typed(k32_h, "QueryPerformanceFrequency", "ptr->i32", [freq_b]) catch 0;
            if ok_f != 0 {
                _SYS_STATE["win_qpc_freq"] = _get_i64_le(freq_b, 0);
            }
            let base_b = bytes_new(8);
            let ok_c = try ffi_call_typed(k32_h, "QueryPerformanceCounter", "ptr->i32", [base_b]) catch 0;
            if ok_c != 0 {
                _SYS_STATE["win_qpc_base"] = _get_i64_le(base_b, 0);
            }
        }
    }

    _SYS_STATE["platform"] = plat;
    _SYS_STATE["arch"] = arch;
    _SYS_STATE["is_linux"] = is_linux;
    _SYS_STATE["is_macos"] = is_macos;
    _SYS_STATE["is_bsd"] = is_macos;
    _SYS_STATE["is_win"] = is_win;
    _SYS_STATE["is_x64"] = is_x64;
    _SYS_STATE["is_arm64"] = is_arm64;
    _SYS_STATE["libc"] = libc_h;
    _SYS_STATE["libc_name"] = libc_name;
    _SYS_STATE["ws2"] = ws2_h;
    _SYS_STATE["k32"] = k32_h;
    _SYS_STATE["msvcrt"] = msvcrt_h;
    _SYS_STATE["native_ffi"] = native_ffi;
    _SYS_STATE["page_size"] = page_sz;
    _SYS_STATE["initialized"] = true;
    return _SYS_STATE;
}

fn pure_os_capabilities(opts = nil) {
    let st = _init_sys_abi();
    let req_native = _opt(opts, "require_native", false);
    if req_native and not st["native_ffi"] {
        return map{
            ok: false,
            version: PURE_SYS_VERSION,
            error: "Native FFI syscalls unavailable (pass --allow-ffi or --allow-all)",
            platform: st["platform"],
            arch: st["arch"],
            native_ffi_active: false,
            sandbox_virtual: true
        };
    }
    let direct_cpu = st["native_ffi"] and (st["is_x64"] or st["is_arm64"]);
    return map{
        ok: true,
        version: PURE_SYS_VERSION,
        platform: st["platform"],
        arch: st["arch"],
        libc_provider: st["libc_name"],
        page_size: st["page_size"],
        native_ffi_active: st["native_ffi"],
        sandbox_virtual: not st["native_ffi"],
        udp_kernel_sockets: st["native_ffi"],
        tcp_keepalive_engine: true,
        wx_jit_runner: true,
        wx_direct_cpu_exec: direct_cpu,
        memfd_supported: st["native_ffi"] and st["is_linux"],
        monotonic_clock_ns: true,
        ssrf_guard_active: true
    };
}

// ── Strict IPv4 Parser & SSRF Policy Guard ───────────────────────────────────

fn pure_parse_ipv4(host_str) {
    let h = str_trim(str(host_str));
    if str_lower(h) == "localhost" {
        return [127, 0, 0, 1];
    }
    let parts = str_split(h, ".");
    if len(parts) != 4 { return nil; }
    let octs = [];
    let i = 0;
    while i < 4 {
        let p = parts[i];
        if p == "" or len(p) > 3 { return nil; }
        let bs = str_to_bytes(p);
        let j = 0;
        let v = 0;
        while j < len(bs) {
            let c = bs[j];
            if c < 48 or c > 57 { return nil; }
            v = v * 10 + (c - 48);
            j = j + 1;
        }
        if v < 0 or v > 255 { return nil; }
        array_push(octs, v);
        i = i + 1;
    }
    return octs;
}

fn pure_check_ssrf_ip(host_str, opts = nil) {
    let h_raw = str_trim(str(host_str));
    let h = str_lower(h_raw);
    if str_starts_with(h, "[") and str_ends_with(h, "]") {
        h = str_slice(h, 1, len(h) - 1);
    }
    let allow_loopback = _opt(opts, "allow_loopback", true);
    let allow_private = _opt(opts, "allow_private", false);
    let allow_metadata = _opt(opts, "allow_metadata", false);
    let is_bind = _opt(opts, "for_bind", false);

    // IPv6 loopback / link-local / ULA checks
    if h == "::1" or h == "0:0:0:0:0:0:0:1" {
        if allow_loopback {
            return map{ ok: true, host: h_raw, category: "loopback" };
        }
        return map{ ok: false, host: h_raw, category: "loopback", code: "SSRF_LOOPBACK_BLOCKED", error: "SSRF policy blocked loopback target: " + h_raw };
    }
    if str_starts_with(h, "fe80:") {
        if allow_metadata { return map{ ok: true, host: h_raw, category: "link_local" }; }
        return map{ ok: false, host: h_raw, category: "metadata_link_local", code: "SSRF_METADATA_BLOCKED", error: "SSRF policy blocked IPv6 link-local target: " + h_raw };
    }
    if str_starts_with(h, "fc") or str_starts_with(h, "fd") {
        if h != "localhost" and str_contains(h, ":") {
            if allow_private { return map{ ok: true, host: h_raw, category: "private_ipv6" }; }
            return map{ ok: false, host: h_raw, category: "private_ipv6", code: "SSRF_PRIVATE_BLOCKED", error: "SSRF policy blocked IPv6 ULA private target: " + h_raw };
        }
    }

    if h == "metadata.google.internal" or h == "metadata" or h == "instance-data" {
        if allow_metadata { return map{ ok: true, host: h_raw, category: "cloud_metadata" }; }
        return map{ ok: false, host: h_raw, category: "cloud_metadata", code: "SSRF_METADATA_BLOCKED", error: "SSRF policy blocked cloud metadata endpoint: " + h_raw };
    }

    let octs = pure_parse_ipv4(h);
    if octs == nil {
        if h == "localhost" or str_ends_with(h, ".localhost") {
            if allow_loopback { return map{ ok: true, host: h_raw, category: "loopback" }; }
            return map{ ok: false, host: h_raw, category: "loopback", code: "SSRF_LOOPBACK_BLOCKED", error: "SSRF policy blocked localhost target" };
        }
        return map{ ok: true, host: h_raw, category: "hostname" };
    }

    let o0 = octs[0];
    let o1 = octs[1];
    let o2 = octs[2];
    let o3 = octs[3];

    // Cloud metadata 169.254.169.254 & link-local 169.254.0.0/16 & Alibaba 100.100.100.200
    if (o0 == 169 and o1 == 254) or (o0 == 100 and o1 == 100 and o2 == 100 and o3 == 200) {
        if allow_metadata {
            return map{ ok: true, host: h_raw, octets: octs, category: "cloud_metadata" };
        }
        return map{
            ok: false,
            host: h_raw,
            octets: octs,
            category: "cloud_metadata",
            code: "SSRF_METADATA_BLOCKED",
            error: "SSRF policy blocked cloud metadata / link-local IP: " + h_raw
        };
    }

    // 0.0.0.0/8 wildcard
    if o0 == 0 {
        if is_bind and o1 == 0 and o2 == 0 and o3 == 0 and allow_loopback {
            return map{ ok: true, host: h_raw, octets: octs, category: "wildcard_bind" };
        }
        return map{ ok: false, host: h_raw, octets: octs, category: "unspecified", code: "SSRF_UNSPECIFIED_BLOCKED", error: "SSRF policy blocked 0.0.0.0/8 destination: " + h_raw };
    }

    // 127.0.0.0/8 loopback
    if o0 == 127 {
        if allow_loopback {
            return map{ ok: true, host: h_raw, octets: octs, category: "loopback" };
        }
        return map{ ok: false, host: h_raw, octets: octs, category: "loopback", code: "SSRF_LOOPBACK_BLOCKED", error: "SSRF policy blocked loopback IP: " + h_raw };
    }

    // RFC1918 & CGNAT private networks
    let is_priv = (o0 == 10) or
                  (o0 == 172 and o1 >= 16 and o1 <= 31) or
                  (o0 == 192 and o1 == 168) or
                  (o0 == 100 and o1 >= 64 and o1 <= 127);
    if is_priv {
        if allow_private {
            return map{ ok: true, host: h_raw, octets: octs, category: "private" };
        }
        return map{ ok: false, host: h_raw, octets: octs, category: "private", code: "SSRF_PRIVATE_BLOCKED", error: "SSRF policy blocked private RFC1918/CGNAT IP: " + h_raw };
    }

    return map{ ok: true, host: h_raw, octets: octs, category: "public" };
}

// ═════════════════════════════════════════════════════════════════════════════
// 1. Direct Pure-PBLang Kernel UDP Datagram Sockets
// ═════════════════════════════════════════════════════════════════════════════

fn _split_host_port(host_or_addr, port_arg, default_port) {
    if port_arg != nil and is_number(port_arg) {
        return map{ host: str_trim(str(host_or_addr)), port: num_floor(port_arg) };
    }
    if is_map(host_or_addr) {
        let mh = _opt(host_or_addr, "ip", _opt(host_or_addr, "host", "127.0.0.1"));
        let mp = _opt(host_or_addr, "port", default_port);
        return map{ host: str(mh), port: num_floor(mp) };
    }
    let s = str_trim(str(host_or_addr));
    let colon = str_index_of(s, ":");
    if colon >= 0 {
        let hp = str_slice(s, 0, colon);
        let pp_str = str_slice(s, colon + 1, len(s));
        let pp = try parse_number(pp_str) catch default_port;
        return map{ host: if hp == "" { "0.0.0.0" } else { hp }, port: num_floor(pp) };
    }
    return map{ host: s, port: default_port };
}

// Packs exact 16-byte `struct sockaddr_in`:
//   Linux/Windows: [AF_INET=2, 0, port_hi, port_lo, ip0, ip1, ip2, ip3, 0,0,0,0,0,0,0,0]
//   macOS/BSD:     [16, AF_INET=2, port_hi, port_lo, ip0, ip1, ip2, ip3, 0,0,0,0,0,0,0,0]
fn pure_pack_sockaddr_in(ip_str, port_num, is_bsd_override = nil) {
    let st = _init_sys_abi();
    let use_bsd = if is_bsd_override != nil { is_bsd_override == true } else { st["is_bsd"] };
    let octs = pure_parse_ipv4(ip_str);
    if octs == nil {
        throw "pure_os_syscalls: invalid IPv4 address '" + str(ip_str) + "'";
    }
    let p = num_floor(port_num);
    if p < 0 or p > 65535 {
        throw "pure_os_syscalls: invalid UDP/TCP port " + str(port_num);
    }
    let buf = bytes_new(16);
    if use_bsd {
        bytes_set(buf, 0, 16);
        bytes_set(buf, 1, AF_INET);
    } else {
        bytes_set(buf, 0, AF_INET);
        bytes_set(buf, 1, 0);
    }
    bytes_set(buf, 2, bit_and(num_floor(p / 256), 255));
    bytes_set(buf, 3, bit_and(p, 255));
    bytes_set(buf, 4, octs[0]);
    bytes_set(buf, 5, octs[1]);
    bytes_set(buf, 6, octs[2]);
    bytes_set(buf, 7, octs[3]);
    return buf;
}

fn pure_unpack_sockaddr_in(sockaddr_buf, is_bsd_override = nil) {
    let st = _init_sys_abi();
    let use_bsd = if is_bsd_override != nil { is_bsd_override == true } else { st["is_bsd"] };
    let fam = if use_bsd { bytes_get(sockaddr_buf, 1) } else { bytes_get(sockaddr_buf, 0) + bytes_get(sockaddr_buf, 1) * 256 };
    let port_val = bytes_get(sockaddr_buf, 2) * 256 + bytes_get(sockaddr_buf, 3);
    let ip_str = str(bytes_get(sockaddr_buf, 4)) + "." +
                 str(bytes_get(sockaddr_buf, 5)) + "." +
                 str(bytes_get(sockaddr_buf, 6)) + "." +
                 str(bytes_get(sockaddr_buf, 7));
    return map{
        family: fam,
        ip: ip_str,
        port: port_val,
        addr: ip_str + ":" + str(port_val)
    };
}

fn pure_udp_bind(host_or_addr = "127.0.0.1", port_arg = nil, opts = nil) {
    let st = _init_sys_abi();
    let hp = _split_host_port(host_or_addr, port_arg, 0);
    let bind_opts = map{
        allow_loopback: _opt(opts, "allow_loopback", true),
        allow_private: _opt(opts, "allow_private", false),
        allow_metadata: _opt(opts, "allow_metadata", false),
        for_bind: true
    };
    let ssrf = pure_check_ssrf_ip(hp["host"], bind_opts);
    if not ssrf["ok"] {
        throw "pure_udp_bind: " + ssrf["error"];
    }
    let octs = pure_parse_ipv4(hp["host"]);
    if octs == nil {
        throw "pure_udp_bind: expected IPv4 bind address, got '" + hp["host"] + "'";
    }
    let ip_canon = str(octs[0]) + "." + str(octs[1]) + "." + str(octs[2]) + "." + str(octs[3]);
    let timeout_def = _opt(opts, "timeout_ms", 2000);

    // Deterministic virtual fallback when FFI is disabled/WASM
    if not st["native_ffi"] {
        let vfd = st["virt_next_fd"];
        st["virt_next_fd"] = vfd + 1;
        let vport = hp["port"];
        if vport == 0 {
            vport = st["virt_next_port"];
            st["virt_next_port"] = vport + 1;
        }
        let vaddr = ip_canon + ":" + str(vport);
        let vsock = map{
            ok: true,
            kind: "pure_udp_socket",
            fd: vfd,
            ip: ip_canon,
            port: vport,
            addr: vaddr,
            timeout_ms: timeout_def,
            allow_loopback: bind_opts["allow_loopback"],
            allow_private: bind_opts["allow_private"],
            allow_metadata: bind_opts["allow_metadata"],
            closed: false,
            virtual: true,
            rx_queue: []
        };
        st["virt_udp_sockets"][str(vfd)] = vsock;
        st["virt_udp_by_addr"][vaddr] = vsock;
        return vsock;
    }

    let sa = pure_pack_sockaddr_in(ip_canon, hp["port"], st["is_bsd"]);
    let fd = -1;
    let bind_rc = -1;

    if st["is_win"] {
        fd = ffi_call_typed(st["ws2"], "socket", "i32,i32,i32->i64", [AF_INET, SOCK_DGRAM, IPPROTO_UDP]);
        if fd < 0 {
            throw "pure_udp_bind: Winsock socket(AF_INET, SOCK_DGRAM) failed";
        }
        bind_rc = ffi_call_typed(st["ws2"], "bind", "u64,ptr,i32->i32", [fd, sa, 16]);
        if bind_rc != 0 {
            ffi_call_typed(st["ws2"], "closesocket", "u64->i32", [fd]);
            throw "pure_udp_bind: Winsock bind(" + ip_canon + ":" + str(hp["port"]) + ") failed";
        }
    } else {
        fd = ffi_call_typed(st["libc"], "socket", "i32,i32,i32->i32", [AF_INET, SOCK_DGRAM, 0]);
        if fd < 0 {
            throw "pure_udp_bind: kernel socket(AF_INET, SOCK_DGRAM, 0) failed";
        }
        bind_rc = ffi_call_typed(st["libc"], "bind", "i32,ptr,u32->i32", [fd, sa, 16]);
        if bind_rc != 0 {
            ffi_call_typed(st["libc"], "close", "i32->i32", [fd]);
            throw "pure_udp_bind: kernel bind(" + ip_canon + ":" + str(hp["port"]) + ") failed";
        }
    }

    let sock_obj = map{
        ok: true,
        kind: "pure_udp_socket",
        fd: fd,
        ip: ip_canon,
        port: hp["port"],
        addr: ip_canon + ":" + str(hp["port"]),
        timeout_ms: timeout_def,
        allow_loopback: bind_opts["allow_loopback"],
        allow_private: bind_opts["allow_private"],
        allow_metadata: bind_opts["allow_metadata"],
        closed: false,
        virtual: false
    };

    let bound = pure_udp_local_addr(sock_obj);
    sock_obj["ip"] = bound["ip"];
    sock_obj["port"] = bound["port"];
    sock_obj["addr"] = bound["addr"];
    pure_udp_set_timeout(sock_obj, timeout_def);
    return sock_obj;
}

fn pure_udp_local_addr(sock) {
    if not is_map(sock) or sock["closed"] == true {
        throw "pure_udp_local_addr: socket is closed or invalid";
    }
    if sock["virtual"] == true {
        return map{
            ok: true,
            family: AF_INET,
            ip: sock["ip"],
            port: sock["port"],
            addr: sock["addr"]
        };
    }
    let st = _init_sys_abi();
    let name_buf = bytes_new(16);
    let len_buf = _pack_u32_le_buf(16);
    let rc = -1;
    if st["is_win"] {
        rc = ffi_call_typed(st["ws2"], "getsockname", "u64,ptr,ptr->i32", [sock["fd"], name_buf, len_buf]);
    } else {
        rc = ffi_call_typed(st["libc"], "getsockname", "i32,ptr,ptr->i32", [sock["fd"], name_buf, len_buf]);
    }
    if rc != 0 {
        throw "pure_udp_local_addr: getsockname() failed (rc=" + str(rc) + ")";
    }
    let unpacked = pure_unpack_sockaddr_in(name_buf, st["is_bsd"]);
    sock["ip"] = unpacked["ip"];
    sock["port"] = unpacked["port"];
    sock["addr"] = unpacked["addr"];
    return map{
        ok: true,
        family: unpacked["family"],
        ip: unpacked["ip"],
        port: unpacked["port"],
        addr: unpacked["addr"]
    };
}

fn pure_udp_set_timeout(sock, timeout_ms) {
    if not is_map(sock) or sock["closed"] == true {
        throw "pure_udp_set_timeout: socket is closed or invalid";
    }
    let tms = if timeout_ms < 0 { 0 } else { num_floor(timeout_ms) };
    sock["timeout_ms"] = tms;
    if sock["virtual"] == true {
        return map{ ok: true, rc: 0, timeout_ms: tms };
    }
    let st = _init_sys_abi();
    let rc = 0;
    if st["is_win"] {
        // SOL_SOCKET=0xFFFF, SO_RCVTIMEO=0x1006, DWORD ms
        let opt_dw = _pack_u32_le_buf(tms);
        rc = ffi_call_typed(st["ws2"], "setsockopt", "u64,i32,i32,ptr,i32->i32", [sock["fd"], 65535, 4102, opt_dw, 4]);
    } elif st["is_macos"] {
        // Darwin: SOL_SOCKET=0xFFFF, SO_RCVTIMEO=0x1006, timeval { int64 tv_sec, int32 tv_usec, int32 pad }
        let sec_m = num_floor(tms / 1000);
        let usec_m = (tms % 1000) * 1000;
        let tv_m = bytes_new(16);
        _put_i64_le(tv_m, 0, sec_m);
        _put_i32_le(tv_m, 8, usec_m);
        _put_i32_le(tv_m, 12, 0);
        rc = ffi_call_typed(st["libc"], "setsockopt", "i32,i32,i32,ptr,u32->i32", [sock["fd"], 65535, 4102, tv_m, 16]);
    } else {
        // Linux 64-bit: SOL_SOCKET=1, SO_RCVTIMEO=20, timeval { int64 tv_sec, int64 tv_usec }
        let sec_l = num_floor(tms / 1000);
        let usec_l = (tms % 1000) * 1000;
        let tv_l = bytes_new(16);
        _put_i64_le(tv_l, 0, sec_l);
        _put_i64_le(tv_l, 8, usec_l);
        rc = ffi_call_typed(st["libc"], "setsockopt", "i32,i32,i32,ptr,u32->i32", [sock["fd"], 1, 20, tv_l, 16]);
    }
    return map{ ok: rc == 0, rc: rc, timeout_ms: tms };
}

fn pure_udp_sendto(sock, payload, dst_host_or_addr, dst_port_arg = nil, opts = nil) {
    if not is_map(sock) or sock["closed"] == true {
        throw "pure_udp_sendto: socket is closed or invalid";
    }
    let hp = _split_host_port(dst_host_or_addr, dst_port_arg, 0);
    let send_opts = map{
        allow_loopback: _opt(opts, "allow_loopback", sock["allow_loopback"]),
        allow_private: _opt(opts, "allow_private", sock["allow_private"]),
        allow_metadata: _opt(opts, "allow_metadata", sock["allow_metadata"]),
        for_bind: false
    };
    let ssrf = pure_check_ssrf_ip(hp["host"], send_opts);
    if not ssrf["ok"] {
        throw "pure_udp_sendto: " + ssrf["error"];
    }
    let octs = pure_parse_ipv4(hp["host"]);
    if octs == nil {
        throw "pure_udp_sendto: expected IPv4 destination address, got '" + hp["host"] + "'";
    }
    let dst_ip = str(octs[0]) + "." + str(octs[1]) + "." + str(octs[2]) + "." + str(octs[3]);
    let tx_buf = _to_bytes_buf(payload);
    let tx_len = len(tx_buf);

    if sock["virtual"] == true {
        let st_v = _init_sys_abi();
        let target_key = dst_ip + ":" + str(hp["port"]);
        if map_has(st_v["virt_udp_by_addr"], target_key) {
            let rx_sock = st_v["virt_udp_by_addr"][target_key];
            if rx_sock["closed"] != true {
                array_push(rx_sock["rx_queue"], map{
                    data: bytes_slice(tx_buf, 0, tx_len),
                    ip: sock["ip"],
                    port: sock["port"],
                    addr: sock["addr"]
                });
            }
        }
        return tx_len;
    }

    let st = _init_sys_abi();
    let dst_sa = pure_pack_sockaddr_in(dst_ip, hp["port"], st["is_bsd"]);
    let sent = -1;
    if st["is_win"] {
        sent = ffi_call_typed(st["ws2"], "sendto", "u64,ptr,i32,i32,ptr,i32->i32", [sock["fd"], tx_buf, tx_len, 0, dst_sa, 16]);
    } else {
        sent = ffi_call_typed(st["libc"], "sendto", "i32,ptr,u64,i32,ptr,u32->i64", [sock["fd"], tx_buf, tx_len, 0, dst_sa, 16]);
    }
    if sent < 0 {
        throw "pure_udp_sendto: kernel sendto() failed";
    }
    return sent;
}

fn pure_udp_recvfrom(sock, max_len = 2048, timeout_override_ms = nil) {
    if not is_map(sock) or sock["closed"] == true {
        throw "pure_udp_recvfrom: socket is closed or invalid";
    }
    let cap_len = if max_len <= 0 { 2048 } else { num_floor(max_len) };
    let tms = if timeout_override_ms != nil { num_floor(timeout_override_ms) } else { sock["timeout_ms"] };

    if sock["virtual"] == true {
        let q = sock["rx_queue"];
        if len(q) == 0 {
            return map{
                ok: false,
                timed_out: true,
                length: 0,
                data: bytes_new(0),
                bytes: bytes_new(0),
                text: "",
                ip: "",
                port: 0,
                peer_ip: "",
                peer_port: 0,
                addr: ""
            };
        }
        let pkt = q[0];
        let rest = [];
        let qi = 1;
        while qi < len(q) { array_push(rest, q[qi]); qi = qi + 1; }
        sock["rx_queue"] = rest;
        let dlen = if len(pkt["data"]) > cap_len { cap_len } else { len(pkt["data"]) };
        let clipped = bytes_slice(pkt["data"], 0, dlen);
        return map{
            ok: true,
            timed_out: false,
            length: dlen,
            data: clipped,
            bytes: clipped,
            text: bytes_to_str(clipped),
            ip: pkt["ip"],
            port: pkt["port"],
            peer_ip: pkt["ip"],
            peer_port: pkt["port"],
            addr: pkt["addr"]
        };
    }

    let st = _init_sys_abi();
    if not st["is_win"] and tms >= 0 {
        let pfd = _pack_pollfd_buf(sock["fd"], POLLIN);
        let prc = ffi_call_typed(st["libc"], "poll", "ptr,u64,i32->i32", [pfd, 1, tms]);
        if prc == 0 {
            return map{
                ok: false,
                timed_out: true,
                length: 0,
                data: bytes_new(0),
                bytes: bytes_new(0),
                text: "",
                ip: "",
                port: 0,
                peer_ip: "",
                peer_port: 0,
                addr: ""
            };
        }
    } elif st["is_win"] and timeout_override_ms != nil {
        pure_udp_set_timeout(sock, tms);
    }

    let rx_buf = bytes_new(cap_len);
    let peer_sa = bytes_new(16);
    let peer_len = _pack_u32_le_buf(16);
    let n = -1;
    if st["is_win"] {
        n = ffi_call_typed(st["ws2"], "recvfrom", "u64,ptr,i32,i32,ptr,ptr->i32", [sock["fd"], rx_buf, cap_len, 0, peer_sa, peer_len]);
    } else {
        n = ffi_call_typed(st["libc"], "recvfrom", "i32,ptr,u64,i32,ptr,ptr->i64", [sock["fd"], rx_buf, cap_len, 0, peer_sa, peer_len]);
    }
    if n < 0 {
        return map{
            ok: false,
            timed_out: true,
            length: 0,
            data: bytes_new(0),
            bytes: bytes_new(0),
            text: "",
            ip: "",
            port: 0,
            peer_ip: "",
            peer_port: 0,
            addr: ""
        };
    }
    let out_bytes = bytes_slice(rx_buf, 0, n);
    let peer = pure_unpack_sockaddr_in(peer_sa, st["is_bsd"]);
    return map{
        ok: true,
        timed_out: false,
        length: n,
        data: out_bytes,
        bytes: out_bytes,
        text: bytes_to_str(out_bytes),
        ip: peer["ip"],
        port: peer["port"],
        peer_ip: peer["ip"],
        peer_port: peer["port"],
        addr: peer["addr"]
    };
}

fn pure_udp_close(sock) {
    if not is_map(sock) {
        return map{ ok: false, closed: true };
    }
    if sock["closed"] == true {
        return map{ ok: true, closed: true };
    }
    if sock["virtual"] == true {
        let st_v = _init_sys_abi();
        map_remove(st_v["virt_udp_sockets"], str(sock["fd"]));
        map_remove(st_v["virt_udp_by_addr"], sock["addr"]);
        sock["closed"] = true;
        sock["fd"] = -1;
        return map{ ok: true, closed: true };
    }
    let st = _init_sys_abi();
    let rc = 0;
    if st["is_win"] {
        rc = ffi_call_typed(st["ws2"], "closesocket", "u64->i32", [sock["fd"]]);
    } else {
        rc = ffi_call_typed(st["libc"], "close", "i32->i32", [sock["fd"]]);
    }
    sock["closed"] = true;
    sock["fd"] = -1;
    return map{ ok: rc == 0, rc: rc, closed: true };
}

// ═════════════════════════════════════════════════════════════════════════════
// 2. Direct Pure-PBLang Kernel TCP Liveness Peek & HTTP/1.1 Keep-Alive Engine
// ═════════════════════════════════════════════════════════════════════════════

fn _probe_posix_kernel_fd(st, raw_fd) {
    if raw_fd < 0 {
        return map{ alive: false, readable: false, eof: true };
    }
    let pfd = _pack_pollfd_buf(raw_fd, POLLIN);
    let prc = ffi_call_typed(st["libc"], "poll", "ptr,u64,i32->i32", [pfd, 1, 0]);
    if prc < 0 {
        return map{ alive: false, readable: false, eof: true };
    }
    let revents = _get_u16_le(pfd, 6);
    if bit_and(revents, 56) != 0 {
        return map{ alive: false, readable: false, eof: true, revents: revents };
    }
    if bit_and(revents, POLLIN) != 0 {
        // MSG_PEEK(2) | MSG_DONTWAIT(64 on Linux, 128 on macOS)
        let flags = if st["is_macos"] { 130 } else { 66 };
        let peek_b = bytes_new(1);
        let rrc = ffi_call_typed(st["libc"], "recv", "i32,ptr,u64,i32->i64", [raw_fd, peek_b, 1, flags]);
        if rrc == 0 {
            return map{ alive: false, readable: false, eof: true, revents: revents };
        }
        return map{ alive: true, readable: true, eof: false, revents: revents };
    }
    return map{ alive: true, readable: false, eof: false, revents: 0 };
}

fn _discover_posix_peer_fd(st, peer_port, claimed_map) {
    if not st["native_ffi"] or st["is_win"] {
        return -1;
    }
    let peer_sa = bytes_new(16);
    let peer_len = _pack_u32_le_buf(16);
    let fd = 128;
    while fd >= 3 {
        if not map_has(claimed_map, str(fd)) {
            _put_i32_le(peer_len, 0, 16);
            let rc = ffi_call_typed(st["libc"], "getpeername", "i32,ptr,ptr->i32", [fd, peer_sa, peer_len]);
            if rc == 0 {
                let unp = pure_unpack_sockaddr_in(peer_sa, st["is_bsd"]);
                if unp["port"] == peer_port {
                    return fd;
                }
            }
        }
        fd = fd - 1;
    }
    return -1;
}

fn pure_socket_alive_poll(sock_or_fd) {
    if sock_or_fd == nil {
        return map{ alive: false, readable: false, eof: true };
    }
    if is_map(sock_or_fd) {
        if _opt(sock_or_fd, "closed", false) == true {
            return map{ alive: false, readable: false, eof: true };
        }
        if map_has(sock_or_fd, "raw_fd") or map_has(sock_or_fd, "fd") {
            let raw_fd = _opt(sock_or_fd, "raw_fd", _opt(sock_or_fd, "fd", -1));
            if raw_fd >= 0 {
                let st = _init_sys_abi();
                if st["native_ffi"] and not st["is_win"] {
                    return _probe_posix_kernel_fd(st, raw_fd);
                }
            } else {
                return map{ alive: false, readable: false, eof: true };
            }
        }
        if map_has(sock_or_fd, "handle") {
            return map{ alive: sock_or_fd["handle"] != nil, readable: false, eof: sock_or_fd["handle"] == nil };
        }
    }
    if is_number(sock_or_fd) {
        let fd_num = num_floor(sock_or_fd);
        if fd_num < 0 {
            return map{ alive: false, readable: false, eof: true };
        }
        return map{ alive: true, readable: false, eof: false };
    }
    return map{ alive: true, readable: false, eof: false };
}

fn _validate_http_token_no_crlf(val_str, label) {
    let bs = str_to_bytes(val_str);
    let i = 0;
    while i < len(bs) {
        let b = bs[i];
        if b == 0 or b == 10 or b == 13 {
            throw "pure_http11: CRLF/NUL injection blocked in " + label;
        }
        i = i + 1;
    }
}

fn _parse_http_url(url_str) {
    let u = str_trim(str(url_str));
    let scheme = "http";
    let rest = u;
    if str_starts_with(str_lower(u), "https://") {
        scheme = "https";
        rest = str_slice(u, 8, len(u));
    } elif str_starts_with(str_lower(u), "http://") {
        scheme = "http";
        rest = str_slice(u, 7, len(u));
    } else {
        throw "pure_http11: unsupported URL scheme in '" + u + "'";
    }

    let slash_idx = str_index_of(rest, "/");
    let authority = rest;
    let path_part = "/";
    if slash_idx >= 0 {
        authority = str_slice(rest, 0, slash_idx);
        path_part = str_slice(rest, slash_idx, len(rest));
    }
    if authority == "" {
        throw "pure_http11: empty authority in '" + u + "'";
    }
    _validate_http_token_no_crlf(authority, "URL authority");
    _validate_http_token_no_crlf(path_part, "URL path");

    let host = authority;
    let port_val = if scheme == "https" { 443 } else { 80 };
    if str_starts_with(authority, "[") {
        let rb = str_index_of(authority, "]");
        if rb < 0 { throw "pure_http11: malformed IPv6 literal in URL"; }
        host = str_slice(authority, 1, rb);
        if rb + 1 < len(authority) and str_slice(authority, rb + 1, rb + 2) == ":" {
            port_val = parse_number(str_slice(authority, rb + 2, len(authority)));
        }
    } else {
        let col = str_index_of(authority, ":");
        if col >= 0 {
            host = str_slice(authority, 0, col);
            port_val = parse_number(str_slice(authority, col + 1, len(authority)));
        }
    }
    let default_p = if scheme == "https" { 443 } else { 80 };
    let host_hdr = if port_val == default_p { host } else { host + ":" + str(port_val) };
    return map{
        scheme: scheme,
        host: host,
        port: num_floor(port_val),
        path: path_part,
        host_header: host_hdr,
        pool_key: scheme + "://" + str_lower(host) + ":" + str(num_floor(port_val))
    };
}

fn _int_to_hex_lower(n) {
    if n == 0 { return "0"; }
    let digits = "0123456789abcdef";
    let v = num_floor(n);
    let out = "";
    while v > 0 {
        let rem = v % 16;
        out = str_slice(digits, rem, rem + 1) + out;
        v = num_floor(v / 16);
    }
    return out;
}

fn _parse_hex_chunk_len(line_str) {
    let trimmed = str_trim(line_str);
    let semi = str_index_of(trimmed, ";");
    if semi >= 0 {
        trimmed = str_trim(str_slice(trimmed, 0, semi));
    }
    if trimmed == "" {
        throw "pure_http11: empty chunked size header";
    }
    let acc = 0;
    let i = 0;
    while i < len(trimmed) {
        let cp = strcharcodeat(trimmed, i);
        let nib = -1;
        if cp >= 48 and cp <= 57 { nib = cp - 48; }
        elif cp >= 97 and cp <= 102 { nib = cp - 87; }
        elif cp >= 65 and cp <= 70 { nib = cp - 55; }
        else { throw "pure_http11: invalid hex digit in chunk size '" + trimmed + "'"; }
        acc = acc * 16 + nib;
        i = i + 1;
    }
    return acc;
}

fn pure_encode_chunked_body(chunks_arr) {
    let parts = [];
    let i = 0;
    while i < len(chunks_arr) {
        let ch_str = if is_bytes(chunks_arr[i]) { bytes_to_str(chunks_arr[i]) } else { str(chunks_arr[i]) };
        let blen = len(str_to_bytes(ch_str));
        if blen > 0 {
            array_push(parts, _int_to_hex_lower(blen) + "\r\n" + ch_str + "\r\n");
        }
        i = i + 1;
    }
    array_push(parts, "0\r\n\r\n");
    return str_join(parts, "");
}

fn pure_decode_chunked_bytes(raw_str_or_bytes) {
    let s = if is_bytes(raw_str_or_bytes) { bytes_to_str(raw_str_or_bytes) } else { str(raw_str_or_bytes) };
    let pos = 0;
    let total = len(s);
    let out_parts = [];
    while pos < total {
        let rem_str = str_slice(s, pos, total);
        let eol = str_index_of(rem_str, "\r\n");
        if eol < 0 { break; }
        let sz_line = str_slice(rem_str, 0, eol);
        let csz = _parse_hex_chunk_len(sz_line);
        pos = pos + eol + 2;
        if csz == 0 { break; }
        let chunk_piece = str_slice(s, pos, pos + csz);
        array_push(out_parts, chunk_piece);
        pos = pos + csz + 2;
    }
    let joined = str_join(out_parts, "");
    return map{
        ok: true,
        text: joined,
        bytes: bytes_from_str(joined),
        length: len(str_to_bytes(joined))
    };
}

fn pure_build_multipart_chunks(parts_arr, boundary_str = nil, max_chunk = 16384) {
    let bnd = if boundary_str != nil and boundary_str != "" { str(boundary_str) } else { "----PBLangPureBoundary" + bytes_to_hex(random_bytes(8)) };
    _validate_http_token_no_crlf(bnd, "multipart boundary");
    let wire_chunks = [];
    let total_bytes = 0;
    let step = if max_chunk <= 0 { 16384 } else { num_floor(max_chunk) };

    let i = 0;
    while i < len(parts_arr) {
        let p = parts_arr[i];
        let pname = str(_opt(p, "name", "field" + str(i)));
        let fname = _opt(p, "filename", nil);
        let ctype = _opt(p, "content_type", if fname != nil { "application/octet-stream" } else { "text/plain; charset=utf-8" });
        _validate_http_token_no_crlf(pname, "multipart name");
        _validate_http_token_no_crlf(ctype, "multipart content-type");

        let disp = "Content-Disposition: form-data; name=\"" + pname + "\"";
        if fname != nil {
            _validate_http_token_no_crlf(str(fname), "multipart filename");
            disp = disp + "; filename=\"" + str(fname) + "\"";
        }
        let part_hdr = "--" + bnd + "\r\n" + disp + "\r\nContent-Type: " + str(ctype) + "\r\n\r\n";
        array_push(wire_chunks, part_hdr);
        total_bytes = total_bytes + len(str_to_bytes(part_hdr));

        let body_b = _to_bytes_buf(_opt(p, "data", _opt(p, "content", "")));
        let blen = len(body_b);
        let off = 0;
        while off < blen {
            let end_off = if off + step < blen { off + step } else { blen };
            let sub = bytes_slice(body_b, off, end_off);
            array_push(wire_chunks, sub);
            total_bytes = total_bytes + (end_off - off);
            off = end_off;
        }
        array_push(wire_chunks, "\r\n");
        total_bytes = total_bytes + 2;
        i = i + 1;
    }
    let closing = "--" + bnd + "--\r\n";
    array_push(wire_chunks, closing);
    total_bytes = total_bytes + len(str_to_bytes(closing));

    return map{
        boundary: bnd,
        content_type: "multipart/form-data; boundary=" + bnd,
        content_length: total_bytes,
        chunks: wire_chunks
    };
}

fn _read_exact_tcp_str(handle, byte_count) {
    if byte_count <= 0 { return ""; }
    let parts = [];
    let got = 0;
    while got < byte_count {
        let piece = tcp_read(handle, byte_count - got);
        let plen = len(str_to_bytes(piece));
        if plen == 0 {
            throw "pure_http11: unexpected EOF while reading Content-Length body (" + str(got) + "/" + str(byte_count) + ")";
        }
        array_push(parts, piece);
        got = got + plen;
    }
    if len(parts) == 1 { return parts[0]; }
    return str_join(parts, "");
}

fn _read_http11_response(handle, req_method, max_hdr_bytes, max_body_bytes, on_chunk_cb) {
    let raw_head = tcp_read_until(handle, "\r\n\r\n", max_hdr_bytes);
    if raw_head == "" or not str_contains(raw_head, "\r\n\r\n") {
        throw "pure_http11: empty or truncated HTTP response header";
    }
    let head_end = str_index_of(raw_head, "\r\n\r\n");
    let head_block = str_slice(raw_head, 0, head_end);
    let lines = str_split(head_block, "\r\n");
    if len(lines) == 0 {
        throw "pure_http11: missing status line";
    }

    let status_line = lines[0];
    let sp1 = str_index_of(status_line, " ");
    if sp1 < 0 {
        throw "pure_http11: malformed status line '" + status_line + "'";
    }
    let http_ver = str_slice(status_line, 0, sp1);
    let after_ver = str_trim(str_slice(status_line, sp1 + 1, len(status_line)));
    let sp2 = str_index_of(after_ver, " ");
    let code_str = if sp2 >= 0 { str_slice(after_ver, 0, sp2) } else { after_ver };
    let reason_str = if sp2 >= 0 { str_slice(after_ver, sp2 + 1, len(after_ver)) } else { "" };
    let status_code = num_floor(parse_number(code_str));

    let hdrs = map{};
    let li = 1;
    while li < len(lines) {
        let ln = lines[li];
        let col = str_index_of(ln, ":");
        if col > 0 {
            let hk = str_lower(str_trim(str_slice(ln, 0, col)));
            let hv = str_trim(str_slice(ln, col + 1, len(ln)));
            if map_has(hdrs, hk) {
                hdrs[hk] = hdrs[hk] + ", " + hv;
            } else {
                hdrs[hk] = hv;
            }
        }
        li = li + 1;
    }

    let conn_hdr = str_lower(_opt(hdrs, "connection", ""));
    let keep_alive = true;
    if str_contains(str_lower(http_ver), "http/1.0") {
        keep_alive = str_contains(conn_hdr, "keep-alive");
    } else {
        keep_alive = not str_contains(conn_hdr, "close");
    }

    let te_hdr = str_lower(_opt(hdrs, "transfer-encoding", ""));
    let is_chunked = str_contains(te_hdr, "chunked");
    let body_str = "";

    if req_method == "HEAD" or status_code == 204 or status_code == 304 or (status_code >= 100 and status_code < 200) {
        body_str = "";
    } elif is_chunked {
        let chunk_parts = [];
        let acc_bytes = 0;
        while true {
            let sz_raw = tcp_read_until(handle, "\r\n", 512);
            if sz_raw == "" {
                throw "pure_http11: unexpected EOF reading chunk header";
            }
            let csz = _parse_hex_chunk_len(sz_raw);
            if csz == 0 {
                // Drain trailers up to final CRLF
                while true {
                    let tr_line = tcp_read_until(handle, "\r\n", 4096);
                    if tr_line == "" or tr_line == "\r\n" {
                        break;
                    }
                }
                break;
            }
            acc_bytes = acc_bytes + csz;
            if acc_bytes > max_body_bytes {
                throw "pure_http11: chunked response exceeded max_body_bytes";
            }
            let cdata = _read_exact_tcp_str(handle, csz);
            let crlf_tail = _read_exact_tcp_str(handle, 2);
            if crlf_tail != "\r\n" {
                throw "pure_http11: missing CRLF after chunk payload";
            }
            if on_chunk_cb != nil and is_fn(on_chunk_cb) {
                on_chunk_cb(cdata);
            }
            array_push(chunk_parts, cdata);
        }
        body_str = str_join(chunk_parts, "");
    } elif map_has(hdrs, "content-length") {
        let clen = num_floor(parse_number(hdrs["content-length"]));
        if clen > max_body_bytes {
            throw "pure_http11: Content-Length exceeded max_body_bytes";
        }
        body_str = _read_exact_tcp_str(handle, clen);
        if on_chunk_cb != nil and is_fn(on_chunk_cb) and clen > 0 {
            on_chunk_cb(body_str);
        }
    } else {
        // EOF-delimited stream
        keep_alive = false;
        let eof_parts = [];
        let eof_total = 0;
        while true {
            let chunk_eof = tcp_read(handle, 16384);
            let n_eof = len(str_to_bytes(chunk_eof));
            if n_eof == 0 { break; }
            eof_total = eof_total + n_eof;
            if eof_total > max_body_bytes {
                throw "pure_http11: response exceeded max_body_bytes";
            }
            if on_chunk_cb != nil and is_fn(on_chunk_cb) {
                on_chunk_cb(chunk_eof);
            }
            array_push(eof_parts, chunk_eof);
        }
        body_str = str_join(eof_parts, "");
    }

    return map{
        status: status_code,
        reason: reason_str,
        http_version: http_ver,
        headers: hdrs,
        body: body_str,
        chunked: is_chunked,
        keep_alive: keep_alive
    };
}

fn _pool_acquire(pool_state, parsed_url) {
    let want_key = parsed_url["pool_key"];
    let idle = pool_state["idle"];
    let kept = [];
    let chosen = nil;
    let chosen_raw_fd = -1;
    let i = 0;
    while i < len(idle) {
        let item = idle[i];
        if chosen == nil and item["key"] == want_key {
            let item_rfd = _opt(item, "raw_fd", -1);
            let probe = if item_rfd >= 0 {
                pure_socket_alive_poll(map{ raw_fd: item_rfd })
            } else {
                pure_socket_alive_poll(map{ handle: item["handle"] })
            };
            if probe["alive"] == true and probe["readable"] == false {
                chosen = item["handle"];
                chosen_raw_fd = item_rfd;
                pool_state["hits"] = pool_state["hits"] + 1;
            } else {
                try tcp_close(item["handle"]) catch nil;
                pool_state["evicted"] = pool_state["evicted"] + 1;
            }
        } else {
            array_push(kept, item);
        }
        i = i + 1;
    }
    pool_state["idle"] = kept;
    if chosen != nil {
        return map{ handle: chosen, raw_fd: chosen_raw_fd, reused: true };
    }
    pool_state["misses"] = pool_state["misses"] + 1;
    let claimed = map{};
    let ci = 0;
    while ci < len(kept) {
        let crfd = _opt(kept[ci], "raw_fd", -1);
        if crfd >= 0 { claimed[str(crfd)] = true; }
        ci = ci + 1;
    }
    let h = nil;
    if parsed_url["scheme"] == "https" {
        h = tcp_connect_tls(parsed_url["host"], str(parsed_url["port"]));
    } else {
        h = tcp_connect(parsed_url["host"] + ":" + str(parsed_url["port"]));
    }
    let st_p = _init_sys_abi();
    let discovered_fd = _discover_posix_peer_fd(st_p, parsed_url["port"], claimed);
    return map{ handle: h, raw_fd: discovered_fd, reused: false };
}

fn _pool_release(pool_state, pool_key, handle, raw_fd = -1) {
    let max_idle = pool_state["max_idle"];
    if max_idle <= 0 {
        try tcp_close(handle) catch nil;
        return;
    }
    let idle = pool_state["idle"];
    while len(idle) >= max_idle {
        let oldest = idle[0];
        try tcp_close(oldest["handle"]) catch nil;
        pool_state["evicted"] = pool_state["evicted"] + 1;
        let trimmed = [];
        let k = 1;
        while k < len(idle) {
            array_push(trimmed, idle[k]);
            k = k + 1;
        }
        idle = trimmed;
    }
    array_push(idle, map{ key: pool_key, handle: handle, raw_fd: raw_fd });
    pool_state["idle"] = idle;
}

fn pure_http11_close_all(client) {
    if not is_map(client) or not map_has(client, "_pool") {
        return map{ ok: true, closed_count: 0 };
    }
    let p = client["_pool"];
    let idle = p["idle"];
    let n = len(idle);
    let i = 0;
    while i < n {
        try tcp_close(idle[i]["handle"]) catch nil;
        i = i + 1;
    }
    p["idle"] = [];
    return map{ ok: true, closed_count: n };
}

fn pure_http11_request(client, method_str, url_str, headers = nil, body = nil, req_opts = nil) {
    let p = client["_pool"];
    let m = str_upper(str_trim(str(method_str)));
    _validate_http_token_no_crlf(m, "HTTP method");
    let u = _parse_http_url(url_str);

    let ssrf = pure_check_ssrf_ip(u["host"], map{
        allow_loopback: _opt(req_opts, "allow_loopback", p["allow_loopback"]),
        allow_private: _opt(req_opts, "allow_private", p["allow_private"]),
        allow_metadata: _opt(req_opts, "allow_metadata", p["allow_metadata"]),
        for_bind: false
    });
    if not ssrf["ok"] {
        throw "pure_http11_request: " + ssrf["error"];
    }

    let t0_ns = pure_monotonic_ns();
    let use_chunked_req = _opt(req_opts, "chunked_chunks", nil);
    let multipart_Stream = _opt(req_opts, "multipart_plan", nil);
    let on_chunk_cb = _opt(req_opts, "on_chunk", nil);

    let hdr_lines = [m + " " + u["path"] + " HTTP/1.1", "Host: " + u["host_header"]];
    let has_conn = false;
    let has_cl = false;
    let has_te = false;
    let has_ct = false;
    let has_ua = false;

    if is_map(headers) {
        let hks = map_keys(headers);
        let hi = 0;
        while hi < len(hks) {
            let hk = str(hks[hi]);
            let hv = str(headers[hk]);
            _validate_http_token_no_crlf(hk, "header name");
            _validate_http_token_no_crlf(hv, "header value");
            let low_k = str_lower(hk);
            if low_k != "host" {
                if low_k == "connection" { has_conn = true; }
                if low_k == "content-length" { has_cl = true; }
                if low_k == "transfer-encoding" { has_te = true; }
                if low_k == "content-type" { has_ct = true; }
                if low_k == "user-agent" { has_ua = true; }
                array_push(hdr_lines, hk + ": " + hv);
            }
            hi = hi + 1;
        }
    }
    if not has_conn {
        array_push(hdr_lines, "Connection: keep-alive");
    }
    if not has_ua {
        array_push(hdr_lines, "User-Agent: PBLang-PureHTTP/4.2.0");
    }

    let body_buf = nil;
    if use_chunked_req != nil {
        if not has_te {
            array_push(hdr_lines, "Transfer-Encoding: chunked");
        }
        body_buf = bytes_from_str(pure_encode_chunked_body(use_chunked_req));
    } elif multipart_Stream != nil {
        if not has_ct {
            array_push(hdr_lines, "Content-Type: " + multipart_Stream["content_type"]);
        }
        if not has_cl {
            array_push(hdr_lines, "Content-Length: " + str(multipart_Stream["content_length"]));
        }
    } elif body != nil {
        body_buf = _to_bytes_buf(body);
        if not has_cl {
            array_push(hdr_lines, "Content-Length: " + str(len(body_buf)));
        }
    } elif m == "POST" or m == "PUT" or m == "PATCH" {
        if not has_cl and not has_te {
            array_push(hdr_lines, "Content-Length: 0");
        }
    }

    let req_head_wire = str_join(hdr_lines, "\r\n") + "\r\n\r\n";

    let attempt = 0;
    while attempt < 2 {
        let acq = _pool_acquire(p, u);
        let h = acq["handle"];
        let acq_rfd = _opt(acq, "raw_fd", -1);
        let was_reused = acq["reused"];
        let send_ok = true;

        try {
            if multipart_Stream != nil {
                tcp_write(h, req_head_wire);
                let mchunks = multipart_Stream["chunks"];
                let mi = 0;
                while mi < len(mchunks) {
                    tcp_write(h, mchunks[mi]);
                    mi = mi + 1;
                }
            } elif body_buf != nil and len(body_buf) > 0 {
                if is_string(body) and use_chunked_req == nil {
                    tcp_write(h, req_head_wire + body);
                } else {
                    tcp_write(h, req_head_wire);
                    tcp_write(h, body_buf);
                }
            } else {
                tcp_write(h, req_head_wire);
            }
        } catch err_w {
            send_ok = false;
            try tcp_close(h) catch nil;
            if not was_reused or attempt >= 1 {
                throw err_w;
            }
        }

        if send_ok {
            let parsed_resp = nil;
            let read_ok = true;
            try {
                parsed_resp = _read_http11_response(h, m, p["max_header_bytes"], p["max_body_bytes"], on_chunk_cb);
            } catch err_r {
                read_ok = false;
                try tcp_close(h) catch nil;
                if not was_reused or attempt >= 1 {
                    throw err_r;
                }
            }
            if read_ok {
                if parsed_resp["keep_alive"] {
                    _pool_release(p, u["pool_key"], h, acq_rfd);
                } else {
                    try tcp_close(h) catch nil;
                }
                let dt_ns = pure_monotonic_ns() - t0_ns;
                return map{
                    ok: parsed_resp["status"] >= 200 and parsed_resp["status"] < 400,
                    status: parsed_resp["status"],
                    reason: parsed_resp["reason"],
                    http_version: parsed_resp["http_version"],
                    headers: parsed_resp["headers"],
                    body: parsed_resp["body"],
                    body_bytes: bytes_from_str(parsed_resp["body"]),
                    chunked: parsed_resp["chunked"],
                    keep_alive: parsed_resp["keep_alive"],
                    reused_socket: was_reused,
                    elapsed_ns: dt_ns,
                    elapsed_ms: dt_ns / 1000000.0
                };
            }
        }
        attempt = attempt + 1;
    }
    throw "pure_http11_request: request failed after stale-socket retry";
}

fn pure_http11_keepalive_client(opts = nil) {
    let max_idle_cfg = num_floor(_opt(opts, "max_idle", 8));
    if max_idle_cfg < 0 { max_idle_cfg = 0; }
    let pool_state = map{
        max_idle: max_idle_cfg,
        idle: [],
        hits: 0,
        misses: 0,
        evicted: 0,
        max_header_bytes: num_floor(_opt(opts, "max_header_bytes", 65536)),
        max_body_bytes: num_floor(_opt(opts, "max_body_bytes", 67108864)),
        allow_loopback: _opt(opts, "allow_loopback", true),
        allow_private: _opt(opts, "allow_private", false),
        allow_metadata: _opt(opts, "allow_metadata", false)
    };

    let client = map{
        kind: "pure_http11_keepalive_client",
        max_idle: max_idle_cfg,
        _pool: pool_state
    };

    client["request"] = fn(method_s, url_s, hdrs = nil, body_d = nil, r_opts = nil) {
        return pure_http11_request(client, method_s, url_s, hdrs, body_d, r_opts);
    };
    client["get"] = fn(url_s, hdrs = nil, r_opts = nil) {
        return pure_http11_request(client, "GET", url_s, hdrs, nil, r_opts);
    };
    client["post"] = fn(url_s, body_d = "", hdrs = nil, r_opts = nil) {
        return pure_http11_request(client, "POST", url_s, hdrs, body_d, r_opts);
    };
    client["post_chunked"] = fn(url_s, chunks_arr, hdrs = nil) {
        return pure_http11_request(client, "POST", url_s, hdrs, nil, map{ chunked_chunks: chunks_arr });
    };
    client["post_multipart"] = fn(url_s, parts_arr, hdrs = nil, max_chunk = 16384) {
        let plan = pure_build_multipart_chunks(parts_arr, nil, max_chunk);
        return pure_http11_request(client, "POST", url_s, hdrs, nil, map{ multipart_plan: plan });
    };
    client["stats"] = fn() {
        return map{
            max_idle: pool_state["max_idle"],
            active_idle: len(pool_state["idle"]),
            pool_hits: pool_state["hits"],
            pool_misses: pool_state["misses"],
            sockets_evicted: pool_state["evicted"]
        };
    };
    client["close_all"] = fn() {
        return pure_http11_close_all(client);
    };
    return client;
}

// ═════════════════════════════════════════════════════════════════════════════
// 3. Direct Pure-PBLang `W^X` Executable Memory & Live Machine-Code JIT Runner
// ═════════════════════════════════════════════════════════════════════════════

// Builds architecture-native `bsearch(args_ptr, out_ptr, 1, 8, tramp_ptr)` trampoline
// inside the upper 64 bytes of the RW page BEFORE flipping `RW -> RX` (`W^X`!).
fn _build_wx_trampoline_bytes(st, tramp_offset, entry_offset) {
    if st["is_x64"] and not st["is_win"] {
        // SysV AMD64 ABI (`rdi = args_ptr`, `rsi = out_ptr`):
        //   push rbx               (53)
        //   mov rbx, rsi           (48 89 F3)
        //   mov rcx, [rdi + 0x18]  (48 8B 4F 18)
        //   mov rdx, [rdi + 0x10]  (48 8B 57 10)
        //   mov rsi, [rdi + 0x08]  (48 8B 77 08)
        //   mov rdi, [rdi]         (48 8B 3F)
        //   call rel32             (E8 <rel32>)
        //   mov [rbx], rax         (48 89 03)
        //   xor eax, eax           (31 C0)
        //   pop rbx                (5B)
        //   ret                    (C3)
        let rel32 = entry_offset - (tramp_offset + 24);
        let rbytes = _u32_le_bytes(rel32);
        return bytes_new([
            83,
            72, 137, 243,
            72, 139, 79, 24,
            72, 139, 87, 16,
            72, 139, 119, 8,
            72, 139, 63,
            232, rbytes[0], rbytes[1], rbytes[2], rbytes[3],
            72, 137, 3,
            49, 192,
            91,
            195
        ]);
    }
    if st["is_x64"] and st["is_win"] {
        // Win64 ABI (`rcx = args_ptr`, `rdx = out_ptr` + 32-byte shadow space):
        //   push rbx               (53)
        //   sub rsp, 32            (48 83 EC 20)
        //   mov rbx, rdx           (48 89 D3)
        //   mov r9,  [rcx + 0x18]  (4C 8B 49 18)
        //   mov r8,  [rcx + 0x10]  (4C 8B 41 10)
        //   mov rdx, [rcx + 0x08]  (48 8B 51 08)
        //   mov rcx, [rcx]         (48 8B 09)
        //   call rel32             (E8 <rel32>)
        //   mov [rbx], rax         (48 89 03)
        //   xor eax, eax           (31 C0)
        //   add rsp, 32            (48 83 C4 20)
        //   pop rbx                (5B)
        //   ret                    (C3)
        let rel32_w = entry_offset - (tramp_offset + 28);
        let rbw = _u32_le_bytes(rel32_w);
        return bytes_new([
            83,
            72, 131, 236, 32,
            72, 137, 211,
            76, 139, 73, 24,
            76, 139, 65, 16,
            72, 139, 81, 8,
            72, 139, 9,
            232, rbw[0], rbw[1], rbw[2], rbw[3],
            72, 137, 3,
            49, 192,
            72, 131, 196, 32,
            91,
            195
        ]);
    }
    if st["is_arm64"] {
        // AAPCS64 (`x0 = args_ptr`, `x1 = out_ptr`):
        let word_off = num_floor((entry_offset - (tramp_offset + 24)) / 4);
        let imm26 = bit_and(word_off + 67108864, 67108863);
        let bl_inst = _u32_le_bytes(2483027968 + imm26); // 0x94000000 | imm26
        return bytes_new([
            243, 123, 191, 169, // stp x19, x30, [sp, #-16]!
            243, 3, 1, 170,     // mov x19, x1
            3, 12, 64, 249,     // ldr x3, [x0, #24]
            2, 8, 64, 249,      // ldr x2, [x0, #16]
            1, 4, 64, 249,      // ldr x1, [x0, #8]
            0, 0, 64, 249,      // ldr x0, [x0, #0]
            bl_inst[0], bl_inst[1], bl_inst[2], bl_inst[3],
            96, 2, 0, 249,      // str x0, [x19, #0]
            0, 0, 128, 82,      // mov w0, #0
            243, 123, 193, 168, // ldp x19, x30, [sp], #16
            192, 3, 95, 214     // ret
        ]);
    }
    return nil;
}

// Deterministic pure-PBLang sandbox x86_64 tiny subset evaluator when FFI is disabled
fn _emulate_virtual_x64_subset(code_arr, a0, a1, a2, a3) {
    let n = len(code_arr);
    // Recognize canonical SysV x86_64 sequences (`mov eax, edi; add eax, esi; ret`, `sub`, `imul`, `mov eax, imm32; ret`)
    if n >= 5 and code_arr[0] == 137 and code_arr[1] == 248 and code_arr[2] == 1 and code_arr[3] == 240 and code_arr[4] == 195 {
        return a0 + a1;
    }
    if n >= 7 and code_arr[0] == 72 and code_arr[1] == 137 and code_arr[2] == 248 and code_arr[3] == 72 and code_arr[4] == 1 and code_arr[5] == 240 and code_arr[6] == 195 {
        return a0 + a1;
    }
    if n >= 5 and code_arr[0] == 137 and code_arr[1] == 248 and code_arr[2] == 41 and code_arr[3] == 240 and code_arr[4] == 195 {
        return a0 - a1;
    }
    if n >= 6 and code_arr[0] == 184 and code_arr[5] == 195 {
        return code_arr[1] + code_arr[2] * 256 + code_arr[3] * 65536 + code_arr[4] * 16777216;
    }
    return a0 + a1 + a2 + a3;
}

fn _memcpy_to_ptr(st, dst_ptr, src_bytes, count) {
    if count <= 0 { return; }
    if st["is_win"] {
        if st["msvcrt"] != nil {
            ffi_call_typed(st["msvcrt"], "memcpy", "ptr,ptr,u64->ptr", [dst_ptr, src_bytes, count]);
        } else {
            ffi_call_typed(st["k32"], "RtlMoveMemory", "ptr,ptr,u64->void", [dst_ptr, src_bytes, count]);
        }
    } else {
        ffi_call_typed(st["libc"], "memcpy", "ptr,ptr,u64->ptr", [dst_ptr, src_bytes, count]);
    }
}

fn pure_wx_alloc(code_or_size, opts = nil) {
    let st = _init_sys_abi();
    let init_bytes = nil;
    let req_size = 4096;

    if is_number(code_or_size) {
        req_size = if code_or_size <= 0 { st["page_size"] } else { num_floor(code_or_size) };
    } else {
        init_bytes = _to_bytes_buf(code_or_size);
        req_size = len(init_bytes);
    }

    // Reserve 64 bytes at end of mapped region for the `bsearch` RX trampoline
    let mapped_sz = _align_up(req_size + 128, st["page_size"]);
    let tramp_off = mapped_sz - 64;

    if not st["native_ffi"] {
        let vptr = st["virt_next_ptr"];
        st["virt_next_ptr"] = vptr + mapped_sz;
        let vbuf = bytes_new(mapped_sz);
        let code_len_v = 0;
        if init_bytes != nil and len(init_bytes) > 0 {
            code_len_v = len(init_bytes);
            let vi = 0;
            while vi < code_len_v {
                bytes_set(vbuf, vi, bytes_get(init_bytes, vi));
                vi = vi + 1;
            }
        }
        let vwx = map{
            ok: true,
            kind: "pure_wx_page",
            ptr: vptr,
            mapped_size: mapped_sz,
            code_len: code_len_v,
            tramp_offset: tramp_off,
            entry_offset: num_floor(_opt(opts, "entry_offset", 0)),
            state: "RW",
            prot: "RW-",
            writable: true,
            executable: false,
            wx_strict: true,
            virtual: true,
            _vbuf: vbuf
        };
        st["virt_wx_blocks"][str(vptr)] = vwx;
        return vwx;
    }

    let ptr = 0;
    if st["is_win"] {
        ptr = ffi_call_typed(st["k32"], "VirtualAlloc", "ptr,u64,u32,u32->ptr", [0, mapped_sz, WIN_MEM_COMMIT_RESERVE, WIN_PAGE_READWRITE]);
    } else {
        let map_flags = if st["is_macos"] { MAP_PRIVATE_ANON_MACOS } else { MAP_PRIVATE_ANON_LINUX };
        // PROT_READ | PROT_WRITE = 3 (NEVER RWX = 7!)
        ptr = ffi_call_typed(st["libc"], "mmap", "ptr,u64,i32,i32,i32,i64->ptr", [0, mapped_sz, 3, map_flags, -1, 0]);
    }

    // Valid 64-bit user-space VAs are > 0 and < 2^53 (MAP_FAILED on POSIX is ~2^64-1)
    if ptr == nil or ptr <= 0 or ptr >= 9007199254740992 {
        throw "pure_wx_alloc: kernel mmap/VirtualAlloc(RW) failed";
    }

    let wx_obj = map{
        ok: true,
        kind: "pure_wx_page",
        ptr: ptr,
        mapped_size: mapped_sz,
        code_len: 0,
        tramp_offset: tramp_off,
        entry_offset: num_floor(_opt(opts, "entry_offset", 0)),
        state: "RW",
        prot: "RW-",
        writable: true,
        executable: false,
        wx_strict: true,
        virtual: false
    };

    if init_bytes != nil and len(init_bytes) > 0 {
        pure_wx_write(wx_obj, init_bytes, 0);
    }
    return wx_obj;
}

fn pure_wx_write(wx_block, code_bytes_or_arr, offset = 0) {
    if not is_map(wx_block) or wx_block["state"] != "RW" or wx_block["writable"] != true {
        throw "pure_wx_write: W^X violation — cannot write to non-RW page (state=" + str(_opt(wx_block, "state", "invalid")) + ")";
    }
    let src = _to_bytes_buf(code_bytes_or_arr);
    let n = len(src);
    let off = num_floor(offset);
    if off < 0 or off + n > wx_block["tramp_offset"] {
        throw "pure_wx_write: code write exceeds user region of W^X page";
    }
    if wx_block["virtual"] == true {
        let vb = wx_block["_vbuf"];
        let i = 0;
        while i < n {
            bytes_set(vb, off + i, bytes_get(src, i));
            i = i + 1;
        }
        if off + n > wx_block["code_len"] {
            wx_block["code_len"] = off + n;
        }
        return n;
    }
    let st = _init_sys_abi();
    _memcpy_to_ptr(st, wx_block["ptr"] + off, src, n);
    if off + n > wx_block["code_len"] {
        wx_block["code_len"] = off + n;
    }
    return n;
}

fn pure_wx_protect_rx(wx_block) {
    if not is_map(wx_block) {
        throw "pure_wx_protect_rx: invalid W^X block";
    }
    if wx_block["state"] == "FREED" {
        throw "pure_wx_protect_rx: cannot protect freed page";
    }
    if wx_block["state"] == "RX" {
        return map{ ok: true, rc: 0, state: "RX", prot: "R-X", wx_enforced: true };
    }
    if wx_block["state"] != "RW" {
        throw "pure_wx_protect_rx: expected RW state before RX transition";
    }

    if wx_block["virtual"] == true {
        wx_block["state"] = "RX";
        wx_block["prot"] = "R-X";
        wx_block["writable"] = false;
        wx_block["executable"] = true;
        return map{ ok: true, rc: 0, state: "RX", prot: "R-X", wx_enforced: true };
    }

    let st = _init_sys_abi();
    let tramp_bytes = _build_wx_trampoline_bytes(st, wx_block["tramp_offset"], wx_block["entry_offset"]);
    let has_tramp = false;
    if tramp_bytes != nil {
        _memcpy_to_ptr(st, wx_block["ptr"] + wx_block["tramp_offset"], tramp_bytes, len(tramp_bytes));
        has_tramp = true;
    }

    let rc = -1;
    if st["is_win"] {
        let old_prot = bytes_new(4);
        let ok_vp = ffi_call_typed(st["k32"], "VirtualProtect", "ptr,u64,u32,ptr->i32", [wx_block["ptr"], wx_block["mapped_size"], WIN_PAGE_EXECUTE_READ, old_prot]);
        if st["k32"] != nil {
            let hproc = try ffi_call_typed(st["k32"], "GetCurrentProcess", "void->ptr", []) catch 0;
            if hproc != 0 {
                try ffi_call_typed(st["k32"], "FlushInstructionCache", "ptr,ptr,u64->i32", [hproc, wx_block["ptr"], wx_block["mapped_size"]]) catch 0;
            }
        }
        rc = if ok_vp != 0 { 0 } else { -1 };
    } else {
        // PROT_READ | PROT_EXEC = 5 (strictly Write XOR Execute: write bit removed!)
        rc = ffi_call_typed(st["libc"], "mprotect", "ptr,u64,i32->i32", [wx_block["ptr"], wx_block["mapped_size"], 5]);
        if rc == 0 and st["is_macos"] and st["is_arm64"] {
            try ffi_call_typed(st["libc"], "sys_icache_invalidate", "ptr,u64->void", [wx_block["ptr"], wx_block["mapped_size"]]) catch nil;
        }
    }

    if rc != 0 {
        throw "pure_wx_protect_rx: mprotect/VirtualProtect(PROT_READ|PROT_EXEC) failed (rc=" + str(rc) + ")";
    }

    wx_block["state"] = "RX";
    wx_block["prot"] = "R-X";
    wx_block["writable"] = false;
    wx_block["executable"] = true;
    wx_block["has_trampoline"] = has_tramp;
    return map{ ok: true, rc: 0, state: "RX", prot: "R-X", wx_enforced: true };
}

fn pure_wx_exec_i64(wx_block, arg0_or_arr = nil, arg1 = 0, arg2 = 0, arg3 = 0) {
    if not is_map(wx_block) {
        throw "pure_wx_exec_i64: invalid W^X block";
    }
    if wx_block["state"] != "RX" or wx_block["writable"] == true or wx_block["executable"] != true {
        throw "pure_wx_exec_i64: W^X security refusal — page must be R-X (non-writable, executable) before execution!";
    }
    if wx_block["code_len"] <= 0 {
        throw "pure_wx_exec_i64: no machine code written to W^X page";
    }

    let v0 = 0;
    let v1 = 0;
    let v2 = 0;
    let v3 = 0;
    if is_array(arg0_or_arr) {
        if len(arg0_or_arr) > 0 { v0 = num_floor(arg0_or_arr[0]); }
        if len(arg0_or_arr) > 1 { v1 = num_floor(arg0_or_arr[1]); }
        if len(arg0_or_arr) > 2 { v2 = num_floor(arg0_or_arr[2]); }
        if len(arg0_or_arr) > 3 { v3 = num_floor(arg0_or_arr[3]); }
    } elif is_number(arg0_or_arr) {
        v0 = num_floor(arg0_or_arr);
        v1 = num_floor(arg1);
        v2 = num_floor(arg2);
        v3 = num_floor(arg3);
    }

    if wx_block["virtual"] == true {
        let sub_b = bytes_slice(wx_block["_vbuf"], wx_block["entry_offset"], wx_block["code_len"]);
        return _emulate_virtual_x64_subset(_bytes_to_array(sub_b), v0, v1, v2, v3);
    }

    let st = _init_sys_abi();
    if _opt(wx_block, "has_trampoline", false) != true {
        throw "pure_wx_exec_i64: direct CPU trampoline unavailable on arch '" + st["arch"] + "'";
    }

    let args_buf = bytes_new(32);
    _put_i64_le(args_buf, 0, v0);
    _put_i64_le(args_buf, 8, v1);
    _put_i64_le(args_buf, 16, v2);
    _put_i64_le(args_buf, 24, v3);
    let out_buf = bytes_new(8);
    let tramp_addr = wx_block["ptr"] + wx_block["tramp_offset"];
    let call_lib = if st["is_win"] { st["msvcrt"] } else { st["libc"] };
    if call_lib == nil {
        throw "pure_wx_exec_i64: C runtime handle unavailable for function-pointer dispatch";
    }
    ffi_call_typed(call_lib, "bsearch", "ptr,ptr,u64,u64,ptr->ptr", [args_buf, out_buf, 1, 8, tramp_addr]);
    return _get_i64_le(out_buf, 0);
}

fn pure_wx_free(wx_block) {
    if not is_map(wx_block) {
        return map{ ok: false, rc: -1, unmapped_bytes: 0 };
    }
    if wx_block["state"] == "FREED" or wx_block["ptr"] == 0 {
        return map{ ok: true, rc: 0, unmapped_bytes: 0 };
    }
    let ptr = wx_block["ptr"];
    let sz = wx_block["mapped_size"];

    if wx_block["virtual"] == true {
        let st_v = _init_sys_abi();
        map_remove(st_v["virt_wx_blocks"], str(ptr));
        wx_block["state"] = "FREED";
        wx_block["prot"] = "---";
        wx_block["ptr"] = 0;
        wx_block["writable"] = false;
        wx_block["executable"] = false;
        wx_block["_vbuf"] = nil;
        return map{ ok: true, rc: 0, unmapped_bytes: sz };
    }

    let st = _init_sys_abi();
    let rc = -1;
    if st["is_win"] {
        let ok_vf = ffi_call_typed(st["k32"], "VirtualFree", "ptr,u64,u32->i32", [ptr, 0, WIN_MEM_RELEASE]);
        rc = if ok_vf != 0 { 0 } else { -1 };
    } else {
        rc = ffi_call_typed(st["libc"], "munmap", "ptr,u64->i32", [ptr, sz]);
    }
    wx_block["state"] = "FREED";
    wx_block["prot"] = "---";
    wx_block["ptr"] = 0;
    wx_block["writable"] = false;
    wx_block["executable"] = false;
    return map{ ok: rc == 0, rc: rc, unmapped_bytes: sz };
}

fn _parse_hex_u64(hex_str) {
    let acc = 0;
    let i = 0;
    while i < len(hex_str) {
        let cp = strcharcodeat(hex_str, i);
        let nib = -1;
        if cp >= 48 and cp <= 57 { nib = cp - 48; }
        elif cp >= 97 and cp <= 102 { nib = cp - 87; }
        elif cp >= 65 and cp <= 70 { nib = cp - 55; }
        else { return -1; }
        acc = acc * 16 + nib;
        i = i + 1;
    }
    return acc;
}

// Inspects anonymous VMA address ranges in `/proc/self/maps` on Linux without retaining
// any file-backed paths. Returns `{ supported, mapped, perms }` for leak & W^X verification.
fn pure_wx_verify_unmapped(ptr_addr) {
    let st = _init_sys_abi();
    if not st["native_ffi"] {
        let present = map_has(st["virt_wx_blocks"], str(ptr_addr));
        return map{ supported: true, mapped: present, unmapped: not present, perms: if present { st["virt_wx_blocks"][str(ptr_addr)]["prot"] } else { "" } };
    }
    if not st["is_linux"] {
        return map{ supported: false, mapped: false, unmapped: true, perms: "" };
    }
    let maps_txt = try fs_read("/proc/self/maps") catch nil;
    if maps_txt == nil {
        return map{ supported: false, mapped: false, unmapped: true, perms: "" };
    }
    let lines = str_split(maps_txt, "\n");
    let i = 0;
    while i < len(lines) {
        let ln = lines[i];
        let sp = str_index_of(ln, " ");
        if sp > 0 {
            let range_part = str_slice(ln, 0, sp);
            let dash = str_index_of(range_part, "-");
            if dash > 0 and sp + 5 <= len(ln) {
                let lo = _parse_hex_u64(str_slice(range_part, 0, dash));
                let hi = _parse_hex_u64(str_slice(range_part, dash + 1, len(range_part)));
                if lo >= 0 and hi > lo and ptr_addr >= lo and ptr_addr < hi {
                    let perms = str_slice(ln, sp + 1, sp + 5);
                    return map{ supported: true, mapped: true, unmapped: false, perms: perms };
                }
            }
        }
        i = i + 1;
    }
    return map{ supported: true, mapped: false, unmapped: true, perms: "" };
}

// ═════════════════════════════════════════════════════════════════════════════
// 4. Direct Pure-PBLang Linux `memfd_create` Shared Memory & Monotonic Clock
// ═════════════════════════════════════════════════════════════════════════════

fn pure_monotonic_ns() {
    let st = _init_sys_abi();
    if st["native_ffi"] {
        if st["is_linux"] {
            let ts = bytes_new(16);
            // CLOCK_MONOTONIC = 1 on Linux
            let rc = ffi_call_typed(st["libc"], "clock_gettime", "i32,ptr->i32", [1, ts]);
            if rc == 0 {
                let sec = _get_i64_le(ts, 0);
                let nsec = _get_i64_le(ts, 8);
                if st["posix_sec_base"] < 0 {
                    st["posix_sec_base"] = if sec >= 8000000 { sec - 1000 } else { 0 };
                }
                return (sec - st["posix_sec_base"]) * 1000000000 + nsec;
            }
        } elif st["is_macos"] {
            let ts_m = bytes_new(16);
            // CLOCK_MONOTONIC = 6 on Darwin / macOS
            let rc_m = ffi_call_typed(st["libc"], "clock_gettime", "i32,ptr->i32", [6, ts_m]);
            if rc_m == 0 {
                let sec_m = _get_i64_le(ts_m, 0);
                let nsec_m = _get_i64_le(ts_m, 8);
                if st["posix_sec_base"] < 0 {
                    st["posix_sec_base"] = if sec_m >= 8000000 { sec_m - 1000 } else { 0 };
                }
                return (sec_m - st["posix_sec_base"]) * 1000000000 + nsec_m;
            }
        } elif st["is_win"] and st["win_qpc_freq"] > 0 {
            let cnt_b = bytes_new(8);
            let ok_c = ffi_call_typed(st["k32"], "QueryPerformanceCounter", "ptr->i32", [cnt_b]);
            if ok_c != 0 {
                let delta = _get_i64_le(cnt_b, 0) - st["win_qpc_base"];
                return num_floor((delta * 1000000000.0) / st["win_qpc_freq"]);
            }
        }
    }

    // Deterministic monotonic fallback
    let ms_now = now_ms() * 1000000;
    if ms_now <= st["virt_mono_last"] {
        st["virt_mono_seq"] = st["virt_mono_seq"] + 1;
        return st["virt_mono_last"] + st["virt_mono_seq"];
    }
    st["virt_mono_last"] = ms_now;
    st["virt_mono_seq"] = 0;
    return ms_now;
}

fn pure_memfd_create(name_str = "pblang_shm", size_bytes = 4096, opts = nil) {
    let st = _init_sys_abi();
    let nm = str_trim(str(name_str));
    if nm == "" { nm = "pblang_shm"; }
    if str_contains(nm, "/") or str_contains(nm, "\x00") or len(str_to_bytes(nm)) > 249 {
        throw "pure_memfd_create: invalid memfd name '" + nm + "'";
    }
    let sz = if size_bytes < 0 { 0 } else { num_floor(size_bytes) };
    let allow_seal = _opt(opts, "allow_sealing", false);
    let flags = if allow_seal { MFD_CLOEXEC + MFD_ALLOW_SEALING } else { MFD_CLOEXEC };

    if st["native_ffi"] and st["is_linux"] {
        let fd = try ffi_call_typed(st["libc"], "memfd_create", "string,u32->i32", [nm, flags]) catch -1;
        if fd < 0 {
            // Direct syscall fallback: __NR_memfd_create = 319 (x86_64) or 279 (aarch64)
            let nr = if st["is_x64"] { 319 } elif st["is_arm64"] { 279 } else { -1 };
            if nr > 0 {
                fd = try ffi_call_typed(st["libc"], "syscall", "i64,string,u32->i64", [nr, nm, flags]) catch -1;
            }
        }
        if fd < 0 {
            throw "pure_memfd_create: kernel memfd_create() failed";
        }
        if sz > 0 {
            let trc = ffi_call_typed(st["libc"], "ftruncate", "i32,i64->i32", [fd, sz]);
            if trc != 0 {
                ffi_call_typed(st["libc"], "close", "i32->i32", [fd]);
                throw "pure_memfd_create: ftruncate(" + str(sz) + ") failed";
            }
        }
        return map{
            ok: true,
            kind: "pure_memfd",
            fd: fd,
            name: nm,
            size: sz,
            backend: "linux-memfd",
            zero_disk_footprint: true,
            cloexec: true,
            closed: false,
            virtual: false
        };
    }

    // Anonymous RAM buffer fallback on non-Linux or restricted sandbox
    let vfd = st["virt_next_fd"];
    st["virt_next_fd"] = vfd + 1;
    let mobj = map{
        ok: true,
        kind: "pure_memfd",
        fd: vfd,
        name: nm,
        size: sz,
        backend: "ram-anonymous-buffer",
        zero_disk_footprint: true,
        cloexec: true,
        closed: false,
        virtual: true,
        _buf: bytes_new(sz)
    };
    st["virt_memfds"][str(vfd)] = mobj;
    return mobj;
}

fn pure_memfd_write(mfd, offset, payload) {
    if not is_map(mfd) or mfd["closed"] == true {
        throw "pure_memfd_write: memfd is closed or invalid";
    }
    let src = _to_bytes_buf(payload);
    let n = len(src);
    let off = num_floor(offset);
    if off < 0 or off + n > mfd["size"] {
        throw "pure_memfd_write: write exceeds memfd size (" + str(off + n) + " > " + str(mfd["size"]) + ")";
    }
    if n == 0 { return 0; }
    if mfd["virtual"] == true {
        let b = mfd["_buf"];
        let i = 0;
        while i < n {
            bytes_set(b, off + i, bytes_get(src, i));
            i = i + 1;
        }
        return n;
    }
    let st = _init_sys_abi();
    let wr = try ffi_call_typed(st["libc"], "pwrite", "i32,ptr,u64,i64->i64", [mfd["fd"], src, n, off]) catch -1;
    if wr < 0 {
        ffi_call_typed(st["libc"], "lseek", "i32,i64,i32->i64", [mfd["fd"], off, 0]);
        wr = ffi_call_typed(st["libc"], "write", "i32,ptr,u64->i64", [mfd["fd"], src, n]);
    }
    if wr < 0 {
        throw "pure_memfd_write: kernel write failed";
    }
    return wr;
}

fn pure_memfd_read(mfd, offset, count) {
    if not is_map(mfd) or mfd["closed"] == true {
        throw "pure_memfd_read: memfd is closed or invalid";
    }
    let off = num_floor(offset);
    let n = num_floor(count);
    if off < 0 or n < 0 or off + n > mfd["size"] {
        throw "pure_memfd_read: read out of bounds";
    }
    if n == 0 { return bytes_new(0); }
    if mfd["virtual"] == true {
        return bytes_slice(mfd["_buf"], off, off + n);
    }
    let st = _init_sys_abi();
    let dst = bytes_new(n);
    let rd = try ffi_call_typed(st["libc"], "pread", "i32,ptr,u64,i64->i64", [mfd["fd"], dst, n, off]) catch -1;
    if rd < 0 {
        ffi_call_typed(st["libc"], "lseek", "i32,i64,i32->i64", [mfd["fd"], off, 0]);
        rd = ffi_call_typed(st["libc"], "read", "i32,ptr,u64->i64", [mfd["fd"], dst, n]);
    }
    if rd < 0 {
        throw "pure_memfd_read: kernel read failed";
    }
    return bytes_slice(dst, 0, rd);
}

fn pure_memfd_close(mfd) {
    if not is_map(mfd) { return map{ ok: false, closed: true }; }
    if mfd["closed"] == true { return map{ ok: true, closed: true }; }
    if mfd["virtual"] == true {
        let st_v = _init_sys_abi();
        map_remove(st_v["virt_memfds"], str(mfd["fd"]));
        mfd["closed"] = true;
        mfd["fd"] = -1;
        mfd["_buf"] = nil;
        return map{ ok: true, rc: 0, closed: true };
    }
    let st = _init_sys_abi();
    let rc = ffi_call_typed(st["libc"], "close", "i32->i32", [mfd["fd"]]);
    mfd["closed"] = true;
    mfd["fd"] = -1;
    return map{ ok: rc == 0, rc: rc, closed: true };
}

fn pure_chmod_exec(file_path) {
    let st = _init_sys_abi();
    if st["native_ffi"] and not st["is_win"] {
        let rc = try ffi_call_typed(st["libc"], "chmod", "string,u32->i32", [str(file_path), 493]) catch -1;
        return rc == 0;
    }
    return false;
}

// ═════════════════════════════════════════════════════════════════════════════
// 5. Direct Pure-PBLang OOM-Shield (`RLIMIT_AS` 2.5 GiB + `oom_score_adj` 850)
// ═════════════════════════════════════════════════════════════════════════════

let RLIMIT_AS_LINUX = 9;
let RLIMIT_AS_BSD = 5;
let OOM_SHIELD_DEFAULT_BYTES = 2684354560;
let OOM_SHIELD_DEFAULT_SCORE_ADJ = 850;

fn _get_rlim_u64_capped(buf, off) {
    let lo = bytes_get(buf, off)
        + bytes_get(buf, off + 1) * 256
        + bytes_get(buf, off + 2) * 65536
        + bytes_get(buf, off + 3) * 16777216;
    let hi = bytes_get(buf, off + 4)
        + bytes_get(buf, off + 5) * 256
        + bytes_get(buf, off + 6) * 65536
        + bytes_get(buf, off + 7) * 16777216;
    // Upper 32-bit word >= 1048576 (>= 4 PiB, including RLIM_INFINITY = ~0ULL) => unlimited (-1)
    if hi >= 1048576 {
        return -1;
    }
    return hi * 4294967296.0 + lo;
}

fn pure_apply_oom_shield(max_bytes = 2684354560, oom_score_adj = 850) {
    let st = _init_sys_abi();
    let want_bytes = if max_bytes <= 67108864 { 67108864 } else { num_floor(max_bytes) };
    let target_adj = num_floor(oom_score_adj);
    if target_adj < -1000 { target_adj = -1000; }
    if target_adj > 1000 { target_adj = 1000; }

    let oom_applied = false;
    let effective_adj = 0;

    if st["is_linux"] {
        let oom_path = "/proc/self/oom_score_adj";
        let cur_txt = try fs_read(oom_path) catch nil;
        let cur_num = if cur_txt != nil { (try parse_number(str_trim(cur_txt)) catch nil) } else { nil };
        if cur_num != nil and cur_num >= target_adj {
            oom_applied = true;
            effective_adj = num_floor(cur_num);
        } else {
            let payload_str = str(target_adj) + "\n";
            let wrote_fs = false;
            try {
                fs_write(oom_path, payload_str);
                wrote_fs = true;
            } catch err_oom_fs {
                wrote_fs = false;
            }
            if not wrote_fs and st["native_ffi"] and st["libc"] != nil {
                // Fallback direct kernel open(O_WRONLY=1) + write + close
                let ofd = try ffi_call_typed(st["libc"], "open", "string,i32,u32->i32", [oom_path, 1, 0]) catch -1;
                if ofd >= 0 {
                    let wb = bytes_from_str(payload_str);
                    let wn = try ffi_call_typed(st["libc"], "write", "i32,ptr,u64->i64", [ofd, wb, len(wb)]) catch -1;
                    try ffi_call_typed(st["libc"], "close", "i32->i32", [ofd]) catch 0;
                    if wn > 0 { wrote_fs = true; }
                }
            }
            let verify_txt = try fs_read(oom_path) catch nil;
            let verify_num = if verify_txt != nil { (try parse_number(str_trim(verify_txt)) catch nil) } else { nil };
            if verify_num != nil {
                effective_adj = num_floor(verify_num);
                oom_applied = (effective_adj >= target_adj) or wrote_fs;
            } elif wrote_fs {
                effective_adj = target_adj;
                oom_applied = true;
            }
        }
    }

    let rlimit_applied = false;
    let rlimit_rc = -1;
    let eff_cur = want_bytes;
    let eff_max = want_bytes;

    if st["native_ffi"] and not st["is_win"] and st["libc"] != nil {
        let res_id = if st["is_macos"] { RLIMIT_AS_BSD } else { RLIMIT_AS_LINUX };
        let cur_buf = bytes_new(16);
        let grc = try ffi_call_typed(st["libc"], "getrlimit", "i32,ptr->i32", [res_id, cur_buf]) catch -1;
        if grc != 0 {
            grc = try ffi_call_typed(st["libc"], "getrlimit64", "i32,ptr->i32", [res_id, cur_buf]) catch -1;
        }
        if grc == 0 {
            let old_cur = _get_rlim_u64_capped(cur_buf, 0);
            let old_max = _get_rlim_u64_capped(cur_buf, 8);
            // Never raise above existing hard limit `rlim_max` or tighter soft limit `rlim_cur`
            if old_max >= 0 and old_max < eff_max {
                eff_max = old_max;
            }
            eff_cur = eff_max;
            if old_cur >= 0 and old_cur < eff_cur {
                eff_cur = old_cur;
            }
        }
        let set_buf = bytes_new(16);
        _put_i64_le(set_buf, 0, eff_cur);
        _put_i64_le(set_buf, 8, eff_max);
        rlimit_rc = try ffi_call_typed(st["libc"], "setrlimit", "i32,ptr->i32", [res_id, set_buf]) catch -1;
        if rlimit_rc != 0 {
            rlimit_rc = try ffi_call_typed(st["libc"], "setrlimit64", "i32,ptr->i32", [res_id, set_buf]) catch -1;
        }
        if rlimit_rc == 0 {
            rlimit_applied = true;
            let ver_buf = bytes_new(16);
            let vrc = try ffi_call_typed(st["libc"], "getrlimit", "i32,ptr->i32", [res_id, ver_buf]) catch -1;
            if vrc == 0 {
                let vc = _get_rlim_u64_capped(ver_buf, 0);
                let vm = _get_rlim_u64_capped(ver_buf, 8);
                if vc >= 0 { eff_cur = vc; }
                if vm >= 0 { eff_max = vm; }
            }
        }
    }

    return map{
        ok: rlimit_applied or oom_applied or not st["native_ffi"] or st["is_win"],
        platform: st["platform"],
        max_bytes_requested: want_bytes,
        rlim_cur: eff_cur,
        rlim_max: eff_max,
        rlimit_applied: rlimit_applied,
        rlimit_rc: rlimit_rc,
        oom_score_adj_requested: target_adj,
        oom_score_adj: effective_adj,
        oom_score_applied: oom_applied
    };
}

export PURE_SYS_VERSION,
       AF_INET, SOCK_STREAM, SOCK_DGRAM,
       PROT_NONE, PROT_READ, PROT_WRITE, PROT_EXEC,
       POLLIN, POLLOUT, POLLERR, POLLHUP, POLLNVAL,
       MFD_CLOEXEC, MFD_ALLOW_SEALING,
       RLIMIT_AS_LINUX, RLIMIT_AS_BSD,
       OOM_SHIELD_DEFAULT_BYTES, OOM_SHIELD_DEFAULT_SCORE_ADJ,
       pure_os_capabilities,
       pure_parse_ipv4,
       pure_check_ssrf_ip,
       pure_pack_sockaddr_in,
       pure_unpack_sockaddr_in,
       pure_udp_bind,
       pure_udp_local_addr,
       pure_udp_set_timeout,
       pure_udp_sendto,
       pure_udp_recvfrom,
       pure_udp_close,
       pure_socket_alive_poll,
       pure_encode_chunked_body,
       pure_decode_chunked_bytes,
       pure_build_multipart_chunks,
       pure_http11_keepalive_client,
       pure_http11_request,
       pure_http11_close_all,
       pure_wx_alloc,
       pure_wx_write,
       pure_wx_protect_rx,
       pure_wx_exec_i64,
       pure_wx_free,
       pure_wx_verify_unmapped,
       pure_monotonic_ns,
       pure_memfd_create,
       pure_memfd_write,
       pure_memfd_read,
       pure_memfd_close,
       pure_chmod_exec,
       pure_apply_oom_shield;
