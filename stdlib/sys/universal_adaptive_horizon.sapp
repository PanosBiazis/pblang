//   5. Anti-Terminal-Escape-Injection (`OSC-52`/`CSI` RCE/Clipboard Hijack Shield) + full 5-entity XML escaping.

let SYS = import("stdlib:sys/pure_os_syscalls.sapp");

let HORIZON_VERSION = "4.2.0";
let PBLEG1_MAX_ENVELOPE_CHARS = 1048576;
let PBLEG1_MIN_SECRET_BYTES = 16;

fn _opt(m, key, fallback) {
    if is_map(m) and map_has(m, key) and m[key] != nil {
        return m[key];
    }
    return fallback;
}

fn byte_at(b, i) { return bytes_get(b, i); }
fn floor(v) { return num_floor(v); }
fn push(arr, val) { array_push(arr, val); }
fn str_replace(t, a, b) { return str_join(str_split(str(t), a), b); }

fn _parse_strict_uint(s) {
    if s == nil { return -1; }
    let txt = str(s);
    let n = len(txt);
    if n == 0 or n > 15 { return -1; }
    let i = 0;
    let acc = 0;
    while i < n {
        let ch = str_slice(txt, i, i + 1);
        if ch >= "0" and ch <= "9" {
            acc = acc * 10 + (byte_at(bytes_from_str(ch), 0) - 48);
            i = i + 1;
        } else {
            return -1;
        }
    }
    return acc;
}

fn _parse_leading_int(s) {
    if s == nil { return 0; }
    let txt = str_trim(str(s));
    let n = len(txt);
    let i = 0;
    let acc = 0;
    while i < n and i < 15 {
        let ch = str_slice(txt, i, i + 1);
        if ch >= "0" and ch <= "9" {
            acc = acc * 10 + (byte_at(bytes_from_str(ch), 0) - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    return acc;
}

fn int(v) {
    if is_number(v) { return floor(v); }
    return _parse_strict_uint(v);
}

fn _probe_linux_cpu_features() {
    let info = map{
        has_aes_hw: false,
        has_avx2: false,
        has_avx512: false,
        has_sha_ni: false,
        has_neon_asimd: false,
        has_rdrand: false,
        logical_cores: 1
    };
    if not fs_exists("/proc/cpuinfo") {
        return info;
    }
    let raw = try fs_read("/proc/cpuinfo") catch "";
    if raw == nil or len(raw) == 0 {
        return info;
    }
    let low = str_lower(raw);
    if str_contains(low, " aes ") or str_contains(low, "\taes ") or str_contains(low, " pmull") {
        info["has_aes_hw"] = true;
    }
    if str_contains(low, "avx2") { info["has_avx2"] = true; }
    if str_contains(low, "avx512") { info["has_avx512"] = true; }
    if str_contains(low, "sha_ni") or str_contains(low, " sha2") { info["has_sha_ni"] = true; }
    if str_contains(low, "asimd") or str_contains(low, "neon") { info["has_neon_asimd"] = true; }
    if str_contains(low, "rdrand") or str_contains(low, "rng") { info["has_rdrand"] = true; }
    let lines = str_split(raw, "\n");
    let cores = 0;
    let idx = 0;
    while idx < len(lines) {
        if str_starts_with(str_trim(lines[idx]), "processor") {
            cores = cores + 1;
        }
        idx = idx + 1;
    }
    if cores > 0 { info["logical_cores"] = cores; }
    return info;
}

fn _probe_ram_mib() {
    let res = map{
        total_mib: 4096,
        avail_mib: 2048,
        probed: false
    };
    if not fs_exists("/proc/meminfo") {
        return res;
    }
    let raw = try fs_read("/proc/meminfo") catch "";
    if raw == nil or len(raw) == 0 {
        return res;
    }
    let lines = str_split(raw, "\n");
    let idx = 0;
    while idx < len(lines) {
        let ln = str_trim(lines[idx]);
        if str_starts_with(ln, "MemTotal:") {
            let rest = str_trim(str_slice(ln, 9, len(ln)));
            let kib = _parse_leading_int(rest);
            if kib > 0 {
                res["total_mib"] = int(kib / 1024);
                res["probed"] = true;
            }
        } elif str_starts_with(ln, "MemAvailable:") {
            let rest2 = str_trim(str_slice(ln, 13, len(ln)));
            let kib2 = _parse_leading_int(rest2);
            if kib2 > 0 {
                res["avail_mib"] = int(kib2 / 1024);
            }
        }
        idx = idx + 1;
    }
    return res;
}

fn probe_universal_system_horizon(overrides = nil) {
    let caps = SYS.pure_os_capabilities();
    let os_raw = str_lower(str(_opt(caps, "platform", "linux")));
    let arch_raw = str_lower(str(_opt(caps, "arch", "x86_64")));
    let os_kind = str_lower(str(_opt(overrides, "os", os_raw)));
    let arch_kind = str_lower(str(_opt(overrides, "arch", arch_raw)));
    let word_bits = _opt(overrides, "word_bits", 64);

    if str_contains(arch_kind, "avr") or str_contains(arch_kind, "z80") or str_contains(arch_kind, "6502") {
        word_bits = _opt(overrides, "word_bits", 8);
    } elif str_contains(arch_kind, "8086") or str_contains(arch_kind, "dos16") or str_contains(arch_kind, "msp430") {
        word_bits = _opt(overrides, "word_bits", 16);
    } elif arch_kind == "x86" or arch_kind == "i386" or arch_kind == "i686" or arch_kind == "arm" or arch_kind == "rv32" or arch_kind == "wasm32" {
        word_bits = _opt(overrides, "word_bits", 32);
    }

    let cpu = _probe_linux_cpu_features();
    if is_map(overrides) {
        if map_has(overrides, "has_aes_hw") { cpu["has_aes_hw"] = overrides["has_aes_hw"]; }
        if map_has(overrides, "has_avx2") { cpu["has_avx2"] = overrides["has_avx2"]; }
        if map_has(overrides, "has_neon_asimd") { cpu["has_neon_asimd"] = overrides["has_neon_asimd"]; }
        if map_has(overrides, "has_rdrand") { cpu["has_rdrand"] = overrides["has_rdrand"]; }
        if map_has(overrides, "logical_cores") { cpu["logical_cores"] = overrides["logical_cores"]; }
    } else {
        if (arch_kind == "aarch64" or arch_kind == "arm64") and os_kind != "linux" {
            cpu["has_neon_asimd"] = true;
            cpu["has_aes_hw"] = true;
        }
    }

    let ram = _probe_ram_mib();
    let total_mib = _opt(overrides, "ram_mib", ram["total_mib"]);
    let avail_mib = _opt(overrides, "avail_ram_mib", ram["avail_mib"]);
    if avail_mib > total_mib { avail_mib = total_mib; }

    let has_wayland = false;
    let has_x11 = false;
    let wl_env = env_get("WAYLAND_DISPLAY");
    let x11_env = env_get("DISPLAY");
    if wl_env != nil and len(str(wl_env)) > 0 { has_wayland = true; }
    if x11_env != nil and len(str(x11_env)) > 0 { has_x11 = true; }
    if is_map(overrides) {
        if map_has(overrides, "has_wayland") { has_wayland = overrides["has_wayland"]; }
        if map_has(overrides, "has_x11") { has_x11 = overrides["has_x11"]; }
    }

    let has_vulkan = fs_exists("/usr/lib/x86_64-linux-gnu/libvulkan.so.1") or
                     fs_exists("/usr/lib64/libvulkan.so.1") or
                     fs_exists("/usr/lib/aarch64-linux-gnu/libvulkan.so.1") or
                     os_kind == "windows";
    if is_map(overrides) and map_has(overrides, "has_vulkan") {
        has_vulkan = overrides["has_vulkan"];
    }

    let tier = "tier3_modern_workstation";
    if word_bits <= 16 or total_mib < 4 {
        tier = "tier0_8_16bit_mcu";
    } elif word_bits == 32 or total_mib <= 1024 {
        tier = "tier1_legacy_32_lowram";
    } elif not cpu["has_aes_hw"] or total_mib <= 4096 {
        tier = "tier2_classic_64bit";
    } elif (cpu["has_avx2"] or cpu["has_neon_asimd"]) and has_vulkan and total_mib >= 8192 {
        tier = "tier4_bleeding_edge_gpu_quantum";
    }

    return map{
        ok: true,
        horizon_version: HORIZON_VERSION,
        tier: tier,
        os: os_kind,
        arch: arch_kind,
        word_bits: word_bits,
        ram_total_mib: total_mib,
        ram_avail_mib: avail_mib,
        cpu: cpu,
        display: map{
            wayland: has_wayland,
            x11: has_x11,
            win32_dwm: os_kind == "windows",
            macos_cocoa: os_kind == "macos" or os_kind == "darwin",
            vulkan_capable: has_vulkan
        },
        privacy_zero_telemetry: true
    };
}

// ── Security Guard 1: Zero Protocol-Downgrade & Zero Alt-Svc SSRF Hijack ─────

fn verify_no_protocol_downgrade(scheme, chosen_proto, fallback_chain, opts = nil) {
    let sch = str_lower(str(scheme));
    let allow_legacy = _opt(opts, "allow_legacy_http09_10", false);
    if sch == "https" {
        if chosen_proto == "HTTP/0.9" or chosen_proto == "HTTP/1.0" or str_starts_with(str(chosen_proto), "http://") {
            return map{ ok: false, error: "HTTPS_DOWNGRADE_TO_LEGACY_BLOCKED", protocol: chosen_proto };
        }
        if is_array(fallback_chain) {
            let i = 0;
            while i < len(fallback_chain) {
                let fb = str(fallback_chain[i]);
                if fb == "HTTP/0.9" or fb == "HTTP/1.0" or str_starts_with(str_lower(fb), "http://") {
                    return map{ ok: false, error: "HTTPS_FALLBACK_DOWNGRADE_BLOCKED", forbidden_fallback: fb };
                }
                i = i + 1;
            }
        }
        return map{ ok: true, tls_mandatory: true, scheme: "https" };
    }
    if (chosen_proto == "HTTP/0.9" or chosen_proto == "HTTP/1.0") and not allow_legacy {
        return map{ ok: false, error: "LEGACY_HTTP_REQUIRES_EXPLICIT_OPT_IN", protocol: chosen_proto };
    }
    return map{ ok: true, tls_mandatory: false, scheme: sch };
}

fn validate_alt_svc_target(origin_host, alt_host, alt_port, opts = nil) {
    let orig = str_lower(str_trim(str(origin_host)));
    let alt = str_lower(str_trim(str(alt_host)));
    if len(alt) == 0 { alt = orig; }

    if str_contains(alt, "\r") or str_contains(alt, "\n") or str_contains(alt, " ") or str_contains(alt, "@") or str_contains(alt, "/") {
        return map{ ok: false, error: "ALT_SVC_HOST_INJECTION_BLOCKED" };
    }

    let allow_cross = _opt(opts, "allow_cross_host_alt_svc", false);
    if alt != orig and not allow_cross {
        return map{ ok: false, error: "ALT_SVC_CROSS_ORIGIN_BLOCKED", origin: orig, alt_host: alt };
    }

    let allow_loopback = _opt(opts, "allow_loopback", false);
    if alt == "localhost" or alt == "::1" or alt == "[::1]" or str_starts_with(alt, "127.") or alt == "0.0.0.0" {
        if not allow_loopback {
            return map{ ok: false, error: "ALT_SVC_SSRF_LOOPBACK_BLOCKED", alt_host: alt };
        }
    }
    if str_starts_with(alt, "169.254.") or str_starts_with(alt, "10.") or str_starts_with(alt, "192.168.") or
       str_starts_with(alt, "172.16.") or str_starts_with(alt, "172.17.") or str_starts_with(alt, "172.18.") or
       str_starts_with(alt, "172.19.") or str_starts_with(alt, "172.2") or str_starts_with(alt, "172.30.") or
       str_starts_with(alt, "172.31.") {
        return map{ ok: false, error: "ALT_SVC_SSRF_PRIVATE_OR_METADATA_BLOCKED", alt_host: alt };
    }

    let p = int(alt_port);
    if p <= 0 or p > 65535 {
        return map{ ok: false, error: "ALT_SVC_INVALID_PORT", port: p };
    }
    let blocked_ports = [21, 22, 23, 25, 53, 110, 135, 139, 143, 445, 1433, 1521, 2375, 3306, 3389, 5432, 5900, 6379, 9200, 11211, 27017];
    let idx = 0;
    while idx < len(blocked_ports) {
        if p == blocked_ports[idx] {
            return map{ ok: false, error: "ALT_SVC_DANGEROUS_PORT_BLOCKED", port: p };
        }
        idx = idx + 1;
    }
    if p < 1024 and p != 443 and not allow_loopback {
        return map{ ok: false, error: "ALT_SVC_PRIVILEGED_PORT_BLOCKED", port: p };
    }
    return map{ ok: true, host: alt, port: p };
}

fn select_adaptive_stack(opts = nil) {
    let hw = probe_universal_system_horizon(opts);
    let tier = hw["tier"];
    let cpu = hw["cpu"];
    let disp = hw["display"];

    let scheme = str_lower(str(_opt(opts, "scheme", "https")));
    let allow_legacy_http = _opt(opts, "allow_legacy_http09_10", false);
    let allow_plain_dns = _opt(opts, "allow_plaintext_dns_fallback", false);
    let rtt_ms = _opt(opts, "rtt_ms", 18);
    let loss_pct = _opt(opts, "packet_loss_pct", 0.0);
    let streams = _opt(opts, "concurrent_streams", 1);
    let udp_blocked = _opt(opts, "udp_blocked", false);
    let mobile_roaming = _opt(opts, "mobile_roaming", false);
    let payload_bytes = _opt(opts, "payload_bytes", 4096);
    let is_loopback = _opt(opts, "is_loopback", false);

    // 1. Adaptive Multi-Generation HTTP — NEVER downgrading https:// to HTTP/1.0 or HTTP/0.9!
    let http_primary = "HTTP/2";
    let http_fallbacks = ["HTTP/1.1"];
    let http_reason = "Multiplexed binary framing + HPACK compression over single TLS 1.3 connection";
    if tier == "tier0_8_16bit_mcu" {
        if scheme == "https" or not allow_legacy_http {
            http_primary = "HTTP/1.1";
            http_fallbacks = [];
            http_reason = "Compact HTTP/1.1 + mandatory PBLEG1 Encrypt-then-MAC envelope (legacy plaintext downgrade blocked)";
        } else {
            http_primary = "HTTP/1.0";
            http_fallbacks = ["HTTP/0.9"];
            http_reason = "Explicitly authorized retro MCU framing wrapped in PBLEG1 AEAD";
        }
    } elif tier == "tier1_legacy_32_lowram" or is_loopback or (streams <= 2 and rtt_ms <= 2 and loss_pct == 0.0) or (streams == 1 and payload_bytes >= 16777216 and loss_pct < 0.1) {
        http_primary = "HTTP/1.1";
        http_fallbacks = [];
        http_reason = "Zero-mux CPU/RAM overhead (< 0.15 ms Keep-Alive) + kernel TCP TSO efficiency (TLS preserved)";
    } elif (not udp_blocked) and (mobile_roaming or loss_pct >= 0.5 or (rtt_ms >= 40 and streams >= 4)) {
        http_primary = "HTTP/3";
        http_fallbacks = ["HTTP/2", "HTTP/1.1"];
        http_reason = "QUIC over UDP + QPACK eliminates TCP Head-of-Line blocking & supports 0-RTT/roaming with TLS-only Happy-Eyeballs fallback";
    } else {
        http_primary = "HTTP/2";
        if not udp_blocked {
            http_fallbacks = ["HTTP/3", "HTTP/1.1"];
        } else {
            http_fallbacks = ["HTTP/1.1"];
        }
        http_reason = "High-concurrency stream multiplexing + HPACK header compression with CVE-2023-44487 Rapid-Reset shield";
    }

    // 2. Privacy-First Encrypted DNS — NEVER silently falling back to plaintext UDP:53 unless opted in!
    let dns_primary = "DoH-RFC8484";
    let dns_fallbacks = [];
    if tier == "tier0_8_16bit_mcu" or (tier == "tier1_legacy_32_lowram" and allow_plain_dns) {
        dns_primary = "UDP-DNS-RFC1035";
        dns_fallbacks = ["HOSTS-STATIC"];
    } elif not udp_blocked and http_primary == "HTTP/3" {
        dns_primary = "DoQ-RFC9250";
        dns_fallbacks = if allow_plain_dns { ["DoH-RFC8484", "UDP-DNS-RFC1035"] } else { ["DoH-RFC8484"] };
    } else {
        dns_primary = "DoH-RFC8484";
        dns_fallbacks = if allow_plain_dns { ["UDP-DNS-RFC1035"] } else { [] };
    }

    let aead_cipher = "ChaCha20-Poly1305";
    let kem_mode = "X25519";
    if cpu["has_aes_hw"] and tier != "tier0_8_16bit_mcu" and tier != "tier1_legacy_32_lowram" {
        aead_cipher = "AES-256-GCM";
    }
    if tier == "tier3_modern_workstation" or tier == "tier4_bleeding_edge_gpu_quantum" {
        kem_mode = "Hybrid-ML-KEM-768+X25519";
    }

    let exec_engine = "Threaded-PBCK-VM";
    if tier == "tier0_8_16bit_mcu" {
        exec_engine = "Freestanding-Micro-VM-v4.2";
    } elif hw["arch"] == "x86_64" or hw["arch"] == "amd64" {
        exec_engine = "W^X-x86_64-SSE2-JIT+AOT";
    } elif hw["arch"] == "aarch64" or hw["arch"] == "arm64" {
        exec_engine = "W^X-ARM64-NEON-JIT+AOT";
    }

    let ui_backend = "Headless-WAI-ARIA-HTML5+Braille-TUI";
    if tier == "tier0_8_16bit_mcu" {
        ui_backend = "Retro-7Bit-ASCII-Geometric+1bpp-OLED";
    } elif disp["win32_dwm"] {
        ui_backend = "Win32-DWM-WDA_EXCLUDEFROMCAPTURE-HiDPI";
    } elif disp["wayland"] and disp["vulkan_capable"] {
        ui_backend = "Wayland-Vulkan-144Hz-FractionalHiDPI-Shield";
    } elif disp["wayland"] {
        ui_backend = "Wayland-SHM-DirtyRect-0PctIdle";
    } elif disp["x11"] {
        ui_backend = "X11-FocusBlurShield-DirtyRect-0PctIdle";
    } elif disp["macos_cocoa"] {
        ui_backend = "Cocoa-Metal-Retina-SecureLayer";
    }

    let max_ram_bytes = 2684354560;
    if tier == "tier0_8_16bit_mcu" {
        max_ram_bytes = 2048;
    } elif tier == "tier1_legacy_32_lowram" {
        max_ram_bytes = 201326592;
    } elif hw["ram_total_mib"] <= 4096 {
        max_ram_bytes = 1073741824;
    }

    let dg_check = verify_no_protocol_downgrade(scheme, http_primary, http_fallbacks, opts);

    return map{
        ok: dg_check["ok"],
        horizon_version: HORIZON_VERSION,
        hardware: hw,
        http: map{
            primary: http_primary,
            fallback_chain: http_fallbacks,
            downgrade_shield_verified: dg_check["ok"],
            allow_plaintext_downgrade: false,
            webtransport_h3_ready: http_primary == "HTTP/3",
            legacy_aead_envelope: "PBLEG1-EtM-HMAC-SHA256",
            rationale: http_reason
        },
        dns_privacy: map{
            primary: dns_primary,
            fallback_chain: dns_fallbacks,
            strict_encrypted_dns: not allow_plain_dns,
            zero_isp_snoop: dns_primary != "UDP-DNS-RFC1035"
        },
        crypto: map{
            aead_primary: aead_cipher,
            key_exchange: kem_mode,
            signature: "Ed25519-RFC8032",
            binary_shield: "PBSH-v1-ChaCha20-MBA",
            entropy_guard: if cpu["has_rdrand"] { "HW-RDRAND+OS-CSPRNG" } else { "OS-CSPRNG+MonotonicJitter-SHA256" },
            timing_safe_on_legacy_cpu: true
        },
        compute: map{
            engine: exec_engine,
            zero_idle_cpu: true,
            oom_cap_bytes: max_ram_bytes,
            oom_score_adj_transient: 850
        },
        display: map{
            compositor: ui_backend,
            progressive_aesthetics: ["modern_glass_svg", "legacy_zero_js_html", "tui_unicode_braille", "retro_7bit_ascii"],
            capture_shield_ready: true
        },
        database: map{
            enterprise_wire: ["PostgreSQL-v3-SCRAM-SHA-256", "MSSQL-TDS-7.4/8.0", "MySQL-v10-caching_sha2"],
            embedded_fallback: "Sovereign-MVCC-AES256GCM+SQLite-WAL"
        }
    };
}

// ── Out-of-the-Box 1: Hybrid Entropy Jitter Harvester for Legacy CPUs Without RDRAND ──

let _HEX_CHARS = "0123456789abcdef";

fn _hex_nibble_strict_lower(ch) {
    if ch >= "0" and ch <= "9" { return byte_at(bytes_from_str(ch), 0) - 48; }
    if ch >= "a" and ch <= "f" { return byte_at(bytes_from_str(ch), 0) - 87; }
    return -1;
}

fn _is_strict_lower_hex(s) {
    if s == nil { return false; }
    let n = len(s);
    if n == 0 or n % 2 != 0 { return false; }
    let i = 0;
    while i < n {
        if _hex_nibble_strict_lower(str_slice(s, i, i + 1)) < 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _bytes_to_hex_str(buf) {
    let b = if is_bytes(buf) { buf } else { bytes_from_str(str(buf)) };
    let n = len(b);
    let parts = [];
    let i = 0;
    while i < n {
        let v = byte_at(b, i);
        let hi = int(v / 16);
        let lo = v % 16;
        push(parts, str_slice(_HEX_CHARS, hi, hi + 1) + str_slice(_HEX_CHARS, lo, lo + 1));
        i = i + 1;
    }
    return str_join(parts, "");
}

fn harvest_hybrid_entropy_seed(context_tag = "") {
    let acc = "PBLANG-ENTROPY-V42|" + str(context_tag);
    let r = 0;
    while r < 8 {
        let t0 = SYS.pure_monotonic_ns();
        let spin = sha256(acc + "|" + str(r) + "|" + str(t0));
        let t1 = SYS.pure_monotonic_ns();
        acc = sha256(spin + "|dt=" + str(t1 - t0) + "|t1=" + str(t1));
        r = r + 1;
    }
    let csprng_part = try _bytes_to_hex_str(random_bytes(32)) catch str(SYS.pure_monotonic_ns());
    return sha256(acc + "|csprng=" + str(csprng_part));
}

// ── Out-of-the-Box 2: Hardened Zero-Trust Cryptographic Envelope Over Legacy Transports (`PBLEG1.`) ──

fn _hex_str_to_bytes(hex_s) {
    if not _is_strict_lower_hex(hex_s) { return nil; }
    let n = len(hex_s);
    let out = [];
    let i = 0;
    while i < n {
        let hi = _hex_nibble_strict_lower(str_slice(hex_s, i, i + 1));
        let lo = _hex_nibble_strict_lower(str_slice(hex_s, i + 1, i + 2));
        push(out, hi * 16 + lo);
        i = i + 2;
    }
    return bytes_new(out);
}

fn _xor_keystream_sha256(data_bytes, enc_key_hex, nonce_hex) {
    let n = len(data_bytes);
    let out = [];
    let blk = 0;
    let pos = 0;
    while pos < n {
        let ks_hex = hmac_sha256(enc_key_hex, nonce_hex + "|ctr=" + str(blk));
        let ks_bytes = _hex_str_to_bytes(ks_hex);
        let klen = len(ks_bytes);
        let j = 0;
        while j < klen and pos < n {
            let bval = bit_xor(byte_at(data_bytes, pos), byte_at(ks_bytes, j));
            push(out, bval);
            pos = pos + 1;
            j = j + 1;
        }
        blk = blk + 1;
    }
    return bytes_new(out);
}

fn _const_time_str_eq(a, b) {
    let ba = bytes_from_str(str(a));
    let bb = bytes_from_str(str(b));
    if len(ba) != len(bb) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(ba) {
        diff = bit_or(diff, bit_xor(byte_at(ba, i), byte_at(bb, i)));
        i = i + 1;
    }
    return diff == 0;
}

fn seal_legacy_transport_envelope(payload, shared_secret, seq_num = 1, aad = "") {
    if shared_secret == nil or len(bytes_from_str(str(shared_secret))) < PBLEG1_MIN_SECRET_BYTES {
        throw "PBLEG1 security error: shared_secret must be at least 16 bytes";
    }
    if seq_num < 1 {
        throw "PBLEG1 security error: seq_num must be >= 1";
    }
    let plain = if is_bytes(payload) { payload } else { bytes_from_str(str(payload)) };
    if len(plain) > 524288 {
        throw "PBLEG1 security error: payload exceeds bounded 512 KiB frame limit";
    }
    let enc_key = hmac_sha256(str(shared_secret), "PBLEG1-ENC-SUBKEY-V42");
    let mac_key = hmac_sha256(str(shared_secret), "PBLEG1-MAC-SUBKEY-V42");
    let nonce_hex = str_slice(harvest_hybrid_entropy_seed(str(seq_num)), 0, 32); // 128-bit nonce
    let cipher_bytes = _xor_keystream_sha256(plain, enc_key, nonce_hex);
    let cipher_hex = _bytes_to_hex_str(cipher_bytes);
    let aad_hex = _bytes_to_hex_str(bytes_from_str(str(aad)));
    let canonical = "PBLEG1|" + str(seq_num) + "|" + nonce_hex + "|" + aad_hex + "|" + cipher_hex;
    let tag_hex = hmac_sha256(mac_key, canonical);
    return "PBLEG1." + str(seq_num) + "." + nonce_hex + "." + cipher_hex + "." + tag_hex;
}

fn open_legacy_transport_envelope(envelope_str, shared_secret, min_seq_num = 1, aad = "") {
    if shared_secret == nil or len(bytes_from_str(str(shared_secret))) < PBLEG1_MIN_SECRET_BYTES {
        return map{ ok: false, error: "WEAK_OR_EMPTY_SHARED_SECRET" };
    }
    if envelope_str == nil {
        return map{ ok: false, error: "INVALID_ENVELOPE_MAGIC" };
    }
    let env_txt = str(envelope_str);
    if len(env_txt) > PBLEG1_MAX_ENVELOPE_CHARS {
        return map{ ok: false, error: "ENVELOPE_TOO_LARGE_DOS_BLOCKED" };
    }
    if not str_starts_with(env_txt, "PBLEG1.") {
        return map{ ok: false, error: "INVALID_ENVELOPE_MAGIC" };
    }
    let parts = str_split(env_txt, ".");
    if len(parts) != 5 {
        return map{ ok: false, error: "MALFORMED_ENVELOPE_PARTS" };
    }
    let seq_val = _parse_strict_uint(parts[1]);
    if seq_val < 1 {
        return map{ ok: false, error: "INVALID_SEQUENCE_NUMBER" };
    }
    if seq_val < min_seq_num {
        return map{ ok: false, error: "REPLAY_DETECTED_STALE_SEQ", seq: seq_val, min_expected: min_seq_num };
    }
    let nonce_hex = parts[2];
    let cipher_hex = parts[3];
    let tag_hex = parts[4];
    if len(nonce_hex) != 32 or not _is_strict_lower_hex(nonce_hex) {
        return map{ ok: false, error: "INVALID_NONCE_FORMAT" };
    }
    if len(tag_hex) != 64 or not _is_strict_lower_hex(tag_hex) {
        return map{ ok: false, error: "INVALID_MAC_FORMAT" };
    }
    if len(cipher_hex) > 0 and not _is_strict_lower_hex(cipher_hex) {
        return map{ ok: false, error: "CORRUPT_CIPHERTEXT_HEX" };
    }
    let mac_key = hmac_sha256(str(shared_secret), "PBLEG1-MAC-SUBKEY-V42");
    let aad_hex = _bytes_to_hex_str(bytes_from_str(str(aad)));
    let canonical = "PBLEG1|" + str(seq_val) + "|" + nonce_hex + "|" + aad_hex + "|" + cipher_hex;
    let expected_tag = hmac_sha256(mac_key, canonical);
    if not _const_time_str_eq(tag_hex, expected_tag) {
        return map{ ok: false, error: "TAMPERED_OR_WRONG_KEY" };
    }
    let cipher_bytes = if len(cipher_hex) == 0 { bytes_new(0) } else { _hex_str_to_bytes(cipher_hex) };
    if cipher_bytes == nil {
        return map{ ok: false, error: "CORRUPT_CIPHERTEXT_HEX" };
    }
    let enc_key = hmac_sha256(str(shared_secret), "PBLEG1-ENC-SUBKEY-V42");
    let plain_bytes = _xor_keystream_sha256(cipher_bytes, enc_key, nonce_hex);
    return map{
        ok: true,
        seq: seq_val,
        next_min_seq: seq_val + 1,
        plaintext: bytes_to_str(plain_bytes),
        plaintext_bytes: plain_bytes
    };
}

// ── Out-of-the-Box 3: Progressive Adaptive Aesthetics (XSS-Safe & Anti-Terminal-Escape-Injection) ──

fn _xml_esc(s) {
    let t = str(s);
    t = str_replace(t, "&", "&amp;");
    t = str_replace(t, "<", "&lt;");
    t = str_replace(t, ">", "&gt;");
    t = str_replace(t, "\"", "&quot;");
    t = str_replace(t, "'", "&#39;");
    return t;
}

// Strips ALL C0/C1 terminal control bytes (0x00..0x1F, 0x7F..0x9F including ESC 0x1B OSC-52/CSI)
fn _sanitize_terminal_text(s, seven_bit_only = false) {
    let raw = bytes_from_str(str(s));
    let n = len(raw);
    let safe = [];
    let i = 0;
    while i < n and i < 256 {
        let b = byte_at(raw, i);
        if b < 32 or b == 127 or (b >= 128 and b <= 159) {
            if b == 9 { push(safe, 32); } // tab -> space; strip ESC/CR/LF/BEL/C1 completely
        } elif seven_bit_only and b > 126 {
            push(safe, 63); // '?'
        } else {
            push(safe, b);
        }
        i = i + 1;
    }
    return bytes_to_str(bytes_new(safe));
}

fn _braille_sparkline(vals) {
    let glyphs = ["⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"];
    if not is_array(vals) or len(vals) == 0 { return "⣀⣤⣶⣿"; }
    let mn = vals[0];
    let mx = vals[0];
    let i = 1;
    while i < len(vals) {
        if vals[i] < mn { mn = vals[i]; }
        if vals[i] > mx { mx = vals[i]; }
        i = i + 1;
    }
    let span = mx - mn;
    if span <= 0 { span = 1; }
    let out = [];
    let j = 0;
    while j < len(vals) and j < 64 {
        let norm = int(((vals[j] - mn) * 6) / span);
        if norm < 0 { norm = 0; }
        if norm > 6 { norm = 6; }
        push(out, glyphs[norm]);
        j = j + 1;
    }
    return str_join(out, "");
}

fn _ascii_sparkline(vals) {
    let glyphs = ["_", ".", "-", "=", "+", "*", "#"];
    if not is_array(vals) or len(vals) == 0 { return "_-=+#"; }
    let mn = vals[0];
    let mx = vals[0];
    let i = 1;
    while i < len(vals) {
        if vals[i] < mn { mn = vals[i]; }
        if vals[i] > mx { mx = vals[i]; }
        i = i + 1;
    }
    let span = mx - mn;
    if span <= 0 { span = 1; }
    let out = [];
    let j = 0;
    while j < len(vals) and j < 64 {
        let norm = int(((vals[j] - mn) * 6) / span);
        if norm < 0 { norm = 0; }
        if norm > 6 { norm = 6; }
        push(out, glyphs[norm]);
        j = j + 1;
    }
    return str_join(out, "");
}

fn render_adaptive_beautiful_surface(model, target_mode = "auto") {
    let title = _opt(model, "title", "PBLang v4.2 Sovereign Telemetry");
    let subtitle = _opt(model, "subtitle", "Cutting-Edge + Legacy Universal Horizon");
    let metric_label = _opt(model, "metric_label", "Latency");
    let metric_value = _opt(model, "metric_value", "0.14 ms");
    let series = _opt(model, "series", [12, 19, 24, 31, 28, 42, 55, 64]);

    let mode = target_mode;
    if mode == "auto" {
        let hw = probe_universal_system_horizon(nil);
        if hw["tier"] == "tier0_8_16bit_mcu" {
            mode = "retro_7bit_ascii";
        } elif hw["tier"] == "tier1_legacy_32_lowram" {
            mode = "legacy_zero_js_html";
        } elif hw["display"]["wayland"] or hw["display"]["vulkan_capable"] {
            mode = "modern_glass_svg";
        } else {
            mode = "tui_unicode_braille";
        }
    }

    if mode == "retro_7bit_ascii" {
        let t7 = _sanitize_terminal_text(title, true);
        let s7 = _sanitize_terminal_text(subtitle, true);
        let ml7 = _sanitize_terminal_text(metric_label, true);
        let mv7 = _sanitize_terminal_text(metric_value, true);
        let spark7 = _ascii_sparkline(series);
        let txt7 = "+========================================================+\n" +
                   "| " + t7 + "\n" +
                   "| " + s7 + "\n" +
                   "+--------------------------------------------------------+\n" +
                   "| " + ml7 + ": " + mv7 + "   Trend: [" + spark7 + "]\n" +
                   "+========================================================+";
        return map{ ok: true, mode: mode, seven_bit_clean: true, ansi_escape_stripped: true, zero_js: true, output: txt7 };
    }

    if mode == "tui_unicode_braille" {
        let tu = _sanitize_terminal_text(title, false);
        let su = _sanitize_terminal_text(subtitle, false);
        let mlu = _sanitize_terminal_text(metric_label, false);
        let mvu = _sanitize_terminal_text(metric_value, false);
        let spark_u = _braille_sparkline(series);
        let txt_u = "╔════════════════════════════════════════════════════════╗\n" +
                    "║ ◈ " + tu + "\n" +
                    "║   " + su + "\n" +
                    "╟────────────────────────────────────────────────────────╢\n" +
                    "║ ● " + mlu + ": " + mvu + "   Braille 2x4: " + spark_u + "\n" +
                    "╚════════════════════════════════════════════════════════╝";
        return map{ ok: true, mode: mode, seven_bit_clean: false, ansi_escape_stripped: true, zero_js: true, output: txt_u };
    }

    let pts = [];
    let mn = 0;
    let mx = 1;
    if is_array(series) and len(series) > 0 {
        mn = series[0];
        mx = series[0];
        let k = 1;
        while k < len(series) and k < 256 {
            if series[k] < mn { mn = series[k]; }
            if series[k] > mx { mx = series[k]; }
            k = k + 1;
        }
    }
    let span = mx - mn;
    if span <= 0 { span = 1; }
    let npts = if is_array(series) { (if len(series) > 256 { 256 } else { len(series) }) } else { 0 };
    let idx = 0;
    while idx < npts {
        let x = 32 + int((idx * 416) / (if npts > 1 { npts - 1 } else { 1 }));
        let y = 168 - int(((series[idx] - mn) * 64) / span);
        push(pts, str(x) + "," + str(y));
        idx = idx + 1;
    }
    let poly = if len(pts) > 0 { str_join(pts, " ") } else { "32,150 448,110" };

    let svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 200\" role=\"img\" aria-label=\"" + _xml_esc(title) + "\">" +
              "<defs><linearGradient id=\"pbBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">" +
              "<stop offset=\"0%\" stop-color=\"#0B1020\"/><stop offset=\"100%\" stop-color=\"#131C36\"/></linearGradient>" +
              "<linearGradient id=\"pbLine\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">" +
              "<stop offset=\"0%\" stop-color=\"#38BDF8\"/><stop offset=\"100%\" stop-color=\"#A855F7\"/></linearGradient></defs>" +
              "<rect width=\"480\" height=\"200\" rx=\"16\" fill=\"url(#pbBg)\" stroke=\"#334155\" stroke-width=\"1.5\"/>" +
              "<text x=\"28\" y=\"42\" fill=\"#F8FAFC\" font-family=\"system-ui,sans-serif\" font-size=\"18\" font-weight=\"700\">" + _xml_esc(title) + "</text>" +
              "<text x=\"28\" y=\"66\" fill=\"#94A3B8\" font-family=\"system-ui,sans-serif\" font-size=\"12\">" + _xml_esc(subtitle) + "</text>" +
              "<text x=\"28\" y=\"100\" fill=\"#38BDF8\" font-family=\"monospace\" font-size=\"15\" font-weight=\"700\">" + _xml_esc(metric_label) + ": " + _xml_esc(metric_value) + "</text>" +
              "<polyline fill=\"none\" stroke=\"url(#pbLine)\" stroke-width=\"3\" stroke-linecap=\"round\" points=\"" + poly + "\"/>" +
              "</svg>";

    if mode == "legacy_zero_js_html" {
        let html_doc = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">" +
                       "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; img-src data:;\">" +
                       "<title>" + _xml_esc(title) + "</title></head>" +
                       "<body style=\"margin:0;padding:24px;background:#070B14;color:#F8FAFC;font-family:sans-serif;\">" +
                       "<main role=\"main\" style=\"max-width:520px;margin:0 auto;\">" + svg + "</main></body></html>";
        return map{ ok: true, mode: mode, wcag_aaa: true, xss_escaped: true, zero_js: true, strict_csp: true, output: html_doc };
    }

    return map{ ok: true, mode: "modern_glass_svg", wcag_aaa: true, xss_escaped: true, zero_js: true, output: svg };
}

