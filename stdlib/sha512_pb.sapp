// Pure PBLang SHA-384/SHA-512 (FIPS 180-4).
//
// A 64-bit word is represented as [high32, low32]. This avoids relying on
// floating-point integer precision and keeps interpreted/native results equal.

let MASK = 4294967295;
let BASE = 4294967296;

let K = [
 [0x428a2f98,0xd728ae22],[0x71374491,0x23ef65cd],[0xb5c0fbcf,0xec4d3b2f],[0xe9b5dba5,0x8189dbbc],
 [0x3956c25b,0xf348b538],[0x59f111f1,0xb605d019],[0x923f82a4,0xaf194f9b],[0xab1c5ed5,0xda6d8118],
 [0xd807aa98,0xa3030242],[0x12835b01,0x45706fbe],[0x243185be,0x4ee4b28c],[0x550c7dc3,0xd5ffb4e2],
 [0x72be5d74,0xf27b896f],[0x80deb1fe,0x3b1696b1],[0x9bdc06a7,0x25c71235],[0xc19bf174,0xcf692694],
 [0xe49b69c1,0x9ef14ad2],[0xefbe4786,0x384f25e3],[0x0fc19dc6,0x8b8cd5b5],[0x240ca1cc,0x77ac9c65],
 [0x2de92c6f,0x592b0275],[0x4a7484aa,0x6ea6e483],[0x5cb0a9dc,0xbd41fbd4],[0x76f988da,0x831153b5],
 [0x983e5152,0xee66dfab],[0xa831c66d,0x2db43210],[0xb00327c8,0x98fb213f],[0xbf597fc7,0xbeef0ee4],
 [0xc6e00bf3,0x3da88fc2],[0xd5a79147,0x930aa725],[0x06ca6351,0xe003826f],[0x14292967,0x0a0e6e70],
 [0x27b70a85,0x46d22ffc],[0x2e1b2138,0x5c26c926],[0x4d2c6dfc,0x5ac42aed],[0x53380d13,0x9d95b3df],
 [0x650a7354,0x8baf63de],[0x766a0abb,0x3c77b2a8],[0x81c2c92e,0x47edaee6],[0x92722c85,0x1482353b],
 [0xa2bfe8a1,0x4cf10364],[0xa81a664b,0xbc423001],[0xc24b8b70,0xd0f89791],[0xc76c51a3,0x0654be30],
 [0xd192e819,0xd6ef5218],[0xd6990624,0x5565a910],[0xf40e3585,0x5771202a],[0x106aa070,0x32bbd1b8],
 [0x19a4c116,0xb8d2d0c8],[0x1e376c08,0x5141ab53],[0x2748774c,0xdf8eeb99],[0x34b0bcb5,0xe19b48a8],
 [0x391c0cb3,0xc5c95a63],[0x4ed8aa4a,0xe3418acb],[0x5b9cca4f,0x7763e373],[0x682e6ff3,0xd6b2b8a3],
 [0x748f82ee,0x5defb2fc],[0x78a5636f,0x43172f60],[0x84c87814,0xa1f0ab72],[0x8cc70208,0x1a6439ec],
 [0x90befffa,0x23631e28],[0xa4506ceb,0xde82bde9],[0xbef9a3f7,0xb2c67915],[0xc67178f2,0xe372532b],
 [0xca273ece,0xea26619c],[0xd186b8c7,0x21c0c207],[0xeada7dd6,0xcde0eb1e],[0xf57d4f7f,0xee6ed178],
 [0x06f067aa,0x72176fba],[0x0a637dc5,0xa2c898a6],[0x113f9804,0xbef90dae],[0x1b710b35,0x131c471b],
 [0x28db77f5,0x23047d84],[0x32caab7b,0x40c72493],[0x3c9ebe0a,0x15c9bebc],[0x431d67c4,0x9c100d4c],
 [0x4cc5d4be,0xcb3e42b6],[0x597f299c,0xfc657e2a],[0x5fcb6fab,0x3ad6faec],[0x6c44198c,0x4a475817]
];

fn _word(hi,lo) { return [bit_and(hi,MASK),bit_and(lo,MASK)]; }
fn _xor(a,b) { return _word(bit_xor(a[0],b[0]),bit_xor(a[1],b[1])); }
fn _and(a,b) { return _word(bit_and(a[0],b[0]),bit_and(a[1],b[1])); }
fn _not(a) { return _word(bit_not(a[0]),bit_not(a[1])); }
fn _add(a,b) {
    let low=a[1]+b[1]; let carry=num_floor(low/BASE);
    return _word((a[0]+b[0]+carry)%BASE,low%BASE);
}
fn _add4(a,b,c,d) { return _add(_add(a,b),_add(c,d)); }
fn _add5(a,b,c,d,e) { return _add(_add4(a,b,c,d),e); }
fn _low_mask(bits) { return if bits==0 {0}else{bit_shr(MASK,32-bits)}; }
fn _rotr(value,bits) {
    bits=bits%64; if bits==0 { return _word(value[0],value[1]); }
    if bits==32 { return _word(value[1],value[0]); }
    if bits>32 { return _rotr(_word(value[1],value[0]),bits-32); }
    let mask=_low_mask(bits);
    return _word(bit_or(bit_shr(value[0],bits),bit_shl(bit_and(value[1],mask),32-bits)),
        bit_or(bit_shr(value[1],bits),bit_shl(bit_and(value[0],mask),32-bits)));
}
fn _shr(value,bits) {
    if bits<=0 { return _word(value[0],value[1]); }
    if bits>=64 { return _word(0,0); }
    if bits==32 { return _word(0,value[0]); }
    if bits>32 { return _word(0,bit_shr(value[0],bits-32)); }
    return _word(bit_shr(value[0],bits),bit_or(bit_shr(value[1],bits),
        bit_shl(bit_and(value[0],_low_mask(bits)),32-bits)));
}
fn _hex8(value) {
    let digits="0123456789abcdef"; let out=""; let i=7;
    while i>=0 { let n=bit_and(bit_shr(value,i*4),15); out=out+str_slice(digits,n,n+1); i=i-1; }
    return out;
}
fn _word_hex(value) { return _hex8(value[0])+_hex8(value[1]); }
fn _append_word(data,value) {
    array_push(data,bit_and(bit_shr(value[0],24),255)); array_push(data,bit_and(bit_shr(value[0],16),255));
    array_push(data,bit_and(bit_shr(value[0],8),255)); array_push(data,bit_and(value[0],255));
    array_push(data,bit_and(bit_shr(value[1],24),255)); array_push(data,bit_and(bit_shr(value[1],16),255));
    array_push(data,bit_and(bit_shr(value[1],8),255)); array_push(data,bit_and(value[1],255));
}
fn _validate(bytes) {
    if type(bytes)!="array" { throw "sha512: expected a byte array"; }
    for byte in bytes { if type(byte)!="number" or num_floor(byte)!=byte or byte<0 or byte>255 { throw "sha512: invalid byte"; } }
}

fn _digest(bytes,variant) {
    _validate(bytes);
    if len(bytes)>536870911 { throw "sha512: input exceeds the bounded implementation limit"; }
    let data=[]; for byte in bytes { array_push(data,byte); } array_push(data,0x80);
    while len(data)%128!=112 { array_push(data,0); }
    // This bounded implementation admits lengths below 2^32 bytes, so the high 64 length bits are zero.
    _append_word(data,_word(0,0));
    let bit_length=len(bytes)*8; _append_word(data,_word(num_floor(bit_length/BASE),bit_length%BASE));

    let h=if variant==384 {
        [_word(0xcbbb9d5d,0xc1059ed8),_word(0x629a292a,0x367cd507),_word(0x9159015a,0x3070dd17),_word(0x152fecd8,0xf70e5939),
         _word(0x67332667,0xffc00b31),_word(0x8eb44a87,0x68581511),_word(0xdb0c2e0d,0x64f98fa7),_word(0x47b5481d,0xbefa4fa4)]
    } else {
        [_word(0x6a09e667,0xf3bcc908),_word(0xbb67ae85,0x84caa73b),_word(0x3c6ef372,0xfe94f82b),_word(0xa54ff53a,0x5f1d36f1),
         _word(0x510e527f,0xade682d1),_word(0x9b05688c,0x2b3e6c1f),_word(0x1f83d9ab,0xfb41bd6b),_word(0x5be0cd19,0x137e2179)]
    };
    let chunk=0;
    while chunk<len(data) {
        let w=[]; let i=0;
        while i<16 {
            let at=chunk+i*8;
            let hi=bit_or(bit_or(bit_shl(data[at],24),bit_shl(data[at+1],16)),bit_or(bit_shl(data[at+2],8),data[at+3]));
            let lo=bit_or(bit_or(bit_shl(data[at+4],24),bit_shl(data[at+5],16)),bit_or(bit_shl(data[at+6],8),data[at+7]));
            array_push(w,_word(hi,lo)); i=i+1;
        }
        while i<80 {
            let s0=_xor(_xor(_rotr(w[i-15],1),_rotr(w[i-15],8)),_shr(w[i-15],7));
            let s1=_xor(_xor(_rotr(w[i-2],19),_rotr(w[i-2],61)),_shr(w[i-2],6));
            array_push(w,_add4(w[i-16],s0,w[i-7],s1)); i=i+1;
        }
        let a=h[0]; let b=h[1]; let c=h[2]; let d=h[3]; let e=h[4]; let f=h[5]; let g=h[6]; let hh=h[7];
        i=0;
        while i<80 {
            let s1=_xor(_xor(_rotr(e,14),_rotr(e,18)),_rotr(e,41));
            let ch=_xor(_and(e,f),_and(_not(e),g));
            let t1=_add5(hh,s1,ch,K[i],w[i]);
            let s0=_xor(_xor(_rotr(a,28),_rotr(a,34)),_rotr(a,39));
            let maj=_xor(_xor(_and(a,b),_and(a,c)),_and(b,c)); let t2=_add(s0,maj);
            hh=g; g=f; f=e; e=_add(d,t1); d=c; c=b; b=a; a=_add(t1,t2); i=i+1;
        }
        h[0]=_add(h[0],a); h[1]=_add(h[1],b); h[2]=_add(h[2],c); h[3]=_add(h[3],d);
        h[4]=_add(h[4],e); h[5]=_add(h[5],f); h[6]=_add(h[6],g); h[7]=_add(h[7],hh);
        chunk=chunk+128;
    }
    let count=if variant==384 {6}else{8}; let result=""; let i=0;
    while i<count { result=result+_word_hex(h[i]); i=i+1; } return result;
}

fn sha384_hex_bytes(bytes) { return _digest(bytes,384); }
fn sha512_hex_bytes(bytes) { return _digest(bytes,512); }
fn sha384_hex(text) { return sha384_hex_bytes(str_to_bytes(text)); }
fn sha512_hex(text) { return sha512_hex_bytes(str_to_bytes(text)); }

export sha384_hex,sha512_hex,sha384_hex_bytes,sha512_hex_bytes;
