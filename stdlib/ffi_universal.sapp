// stdlib/ffi_universal.sapp — Universal FFI Bridge for pblang
//
// A comprehensive Foreign Function Interface layer providing typed
// marshaling, struct packing/unpacking, callback registration, and
// auto-detection of shared library types across platforms.
//
// Builds upon pblang's built-in ffi_load, ffi_call, ffi_call_typed.
//
// Supported C types: int, float, double, char*, void*, int32_t,
//   int64_t, uint32_t, uint64_t, size_t, bool
//
// Usage:
//   let fu = import("stdlib:ffi_universal.sapp");
//   let lib = fu.load_any("./mylib.so");
//   let result = fu.call_typed(lib, "add", [1, 2], ["int", "int"], "int");

// Module-level state
let _ffi_struct_registry_val = map{};
let _ffi_callback_registry_val = map{};

// ── Type Registry ─────────────────────────────────────────────────────────────

fn _c_type_sizes() {
    return map{
        int: 4,
        float: 4,
        double: 8,
        int32_t: 4,
        int64_t: 8,
        uint32_t: 4,
        uint64_t: 8,
        size_t: 8,
        bool: 1,
    };
}

fn _pblang_to_ffi_type(pblang_typ) {
    let p = str_lower(pblang_typ);
    if p == "int" or p == "i32" or p == "i64" or p == "number" { return "i64"; }
    if p == "float" or p == "f32" or p == "f64" or p == "double" { return "f64"; }
    if p == "string" or p == "str" { return "string"; }
    if p == "bool" or p == "boolean" { return "bool"; }
    if p == "ptr" or p == "pointer" or p == "void" or p == "void*" { return "ptr"; }
    return pblang_typ;
}

// ── Library Loading ───────────────────────────────────────────────────────────

// load_any(lib_path) — auto-detect and load any shared library type
fn load_any(lib_path) {
    // Try direct load first
    let h = try ffi_load(lib_path) catch nil;
    if h != nil {
        return map{
            handle: h,
            path: lib_path,
            platform: platform(),
        };
    }

    // Try platform-specific extensions
    let platforms = [".so", ".dylib", ".dll"];
    for i len(platforms) {
        let ext = platforms[i];
        if str_ends_with(lib_path, ext) == false {
            let alt = lib_path + ext;
            h = try ffi_load(alt) catch nil;
            if h != nil {
                return map{
                    handle: h,
                    path: alt,
                    platform: platform(),
                };
            }
        }
    }

    // Try with lib prefix on Unix
    let p = platform();
    if p != "windows" {
        let dir_parts = str_split(lib_path, "/");
        let last_idx = len(dir_parts) - 1;
        let basename = dir_parts[last_idx];
        if str_starts_with(basename, "lib") == false {
            let prefix_path = str_join(dir_parts, "/");
            // Replace last segment with lib-prefixed version
            let libbed = "";
            let k = 0;
            while k < last_idx {
                libbed = libbed + dir_parts[k] + "/";
                k = k + 1;
            }
            libbed = libbed + "lib" + basename;
            h = try ffi_load(libbed) catch nil;
            if h != nil {
                return map{
                    handle: h,
                    path: libbed,
                    platform: p,
                };
            }
            // Also try with extension
            h = try ffi_load(libbed + ".so") catch nil;
            if h != nil {
                return map{
                    handle: h,
                    path: libbed + ".so",
                    platform: p,
                };
            }
        }
    }

    // Try just the basename (may be on library path)
    let parts = str_split(lib_path, "/");
    let bare_name = parts[len(parts) - 1];
    h = try ffi_load(bare_name) catch nil;
    if h != nil {
        return map{
            handle: h,
            path: bare_name,
            platform: p,
        };
    }

    return map{ error: "failed to load library: " + lib_path };
}

// ── Typed Calls ───────────────────────────────────────────────────────────────

// call_typed(lib, fn_name, args, arg_types, ret_type) — typed FFI call with marshaling
fn call_typed(lib, fn_name, args, arg_types, ret_type) {
    let h = lib;
    if is_map(lib) { h = lib.handle; }

    // Build signature string for ffi_call_typed
    let sig = "";
    for i len(arg_types) {
        if i > 0 { sig = sig + ","; }
        sig = sig + _pblang_to_ffi_type(arg_types[i]);
    }
    sig = sig + "->" + _pblang_to_ffi_type(ret_type);

    // Marshal args
    let marshaled = [];
    for i len(args) {
        if i < len(arg_types) {
            let marshaled_val = marshal_to_c(args[i], arg_types[i]);
            array_push(marshaled, marshaled_val);
        } else {
            array_push(marshaled, args[i]);
        }
    }

    let result = try {
        let r = ffi_call_typed(h, fn_name, sig, marshaled);
        r
    } catch nil;

    if result == nil {
        return map{ error: "ffi call failed" };
    }

    return map{
        ok: true,
        result: marshal_from_c(result, ret_type),
        raw: result,
    };
}

// ── Value Marshaling ──────────────────────────────────────────────────────────

// marshal_to_c(value, c_type) — convert pblang value to C-compatible value
fn marshal_to_c(value, c_type) {
    let t = str_lower(c_type);

    if t == "int" or t == "int32_t" or t == "uint32_t" {
        return value;
    }
    if t == "int64_t" or t == "uint64_t" or t == "size_t" {
        return value;
    }
    if t == "float" {
        return value;
    }
    if t == "double" {
        return value;
    }
    if t == "bool" {
        if value == true or value == 1 { return 1; }
        return 0;
    }
    if t == "char*" or t == "string" {
        return str(value);
    }
    if t == "void*" or t == "pointer" or t == "ptr" {
        return value;
    }
    // Passthrough for unknown types
    return value;
}

// marshal_from_c(c_value, pblang_type) — convert C value to pblang value
fn marshal_from_c(c_value, pblang_type) {
    let t = str_lower(pblang_type);

    if t == "int" or t == "int32_t" or t == "int64_t" or t == "uint32_t" or t == "uint64_t" or t == "size_t" {
        return c_value;
    }
    if t == "float" or t == "double" {
        return c_value;
    }
    if t == "bool" {
        if c_value == 0 or c_value == false { return false; }
        return true;
    }
    if t == "char*" or t == "string" {
        return str(c_value);
    }
    if t == "void*" or t == "pointer" or t == "ptr" {
        return c_value;
    }
    // Passthrough for unknown types
    return c_value;
}

// ── Struct Operations ─────────────────────────────────────────────────────────

fn _struct_registry() {
    return _ffi_struct_registry_val;
}

// struct_define(name, fields) — define a C struct layout
// fields: array of map{ name: string, type: string }
fn struct_define(name, fields) {
    let reg = _struct_registry();
    if reg == nil { reg = map{}; }

    // Calculate offsets and total size
    let offset = 0;
    let layout = [];
    for i len(fields) {
        let field = fields[i];
        let sizes = _c_type_sizes();
        let ftype = field.type;
        let size = sizes[ftype];
        if size == nil { size = 8; } // default to 8 bytes
        array_push(layout, map{
            name: field.name,
            type: ftype,
            offset: offset,
            size: size,
        });
        offset = offset + size;
    }

    reg[name] = map{
        fields: layout,
        total_size: offset,
    };
    _ffi_struct_registry_val = reg;

    return map{
        ok: true,
        name: name,
        field_count: len(fields),
        total_size: offset,
    };
}

// struct_pack(name, values) — pack values into struct bytes (as integer representation)
// values: map of field_name -> value
fn struct_pack(name, values) {
    let reg = _struct_registry();
    if reg == nil { return map{ error: "no structs defined" }; }

    let struct_def = reg[name];
    if struct_def == nil {
        return map{ error: "unknown struct: " + name };
    }

    // We can't do raw bytes in pblang, so we store as an integer
    // using manual bit packing into a single large integer
    let result = 0;
    let shift = 0;
    for i len(struct_def.fields) {
        let field = struct_def.fields[i];
        let val = values[field.name];
        if val == nil { val = 0; }
        // Pack each field into bits
        let shifted = val * _pow2(shift);
        result = result + shifted;
        shift = shift + field.size * 8;
    }

    return map{
        ok: true,
        packed: result,
        total_size: struct_def.total_size,
    };
}

// struct_unpack(name, bytes_int) — unpack integer to struct values
fn struct_unpack(name, bytes_int) {
    let reg = _struct_registry();
    if reg == nil { return map{ error: "no structs defined" }; }

    let struct_def = reg[name];
    if struct_def == nil {
        return map{ error: "unknown struct: " + name };
    }

    let result = map{};
    let remaining = bytes_int;
    for i len(struct_def.fields) {
        let field = struct_def.fields[i];
        let mask = _pow2(field.size * 8) - 1;
        let val = remaining % (mask + 1);
        result[field.name] = val;
        remaining = (remaining - val) / (mask + 1);
    }

    return map{
        ok: true,
        values: result,
    };
}

// ── Callback Registration ────────────────────────────────────────────────────

fn _callback_registry() {
    return _ffi_callback_registry_val;
}

// callback_register(fn) — register a pblang function as a C-callable callback
// Returns a callback ID that can be passed to C functions expecting a function pointer
fn callback_register(callback_fn) {
    let reg = _callback_registry();
    if reg == nil { reg = map{}; }

    let id = "cb_" + str(len(map_keys(reg)) + 1);
    reg[id] = callback_fn;
    _ffi_callback_registry_val = reg;

    return map{
        ok: true,
        callback_id: id,
        note: "callbacks usable via ffi_call_typed with ptr type",
    };
}

// callback_invoke(id, args) — invoke a registered callback by ID
fn callback_invoke(id, args) {
    let reg = _callback_registry();
    if reg == nil { return nil; }

    let fn_val = reg[id];
    if fn_val == nil { return nil; }

    return fn_val(args);
}

// ── Type Helpers ──────────────────────────────────────────────────────────────

// type_size(c_type) — get the size in bytes of a C type (defaults to 8 for unknown).
// BUG FIX: a bare `sizes[key]` THROWS in pblang on a missing key, so the `return 8`
// fallback was unreachable for unknown types — guard with map_has.
fn type_size(c_type) {
    let sizes = _c_type_sizes();
    let key = str_lower(c_type);
    if not map_has(sizes, key) { return 8; }
    return sizes[key];
}

// list_types() — list all supported C types with their sizes
fn list_types() {
    let sizes = _c_type_sizes();
    let keys = map_keys(sizes);
    let result = [];
    for i len(keys) {
        array_push(result, map{
            type: keys[i],
            size: sizes[keys[i]],
        });
    }
    return result;
}

// ── Math Helper ───────────────────────────────────────────────────────────────

fn _pow2(n) {
    if n <= 0 { return 1; }
    let result = 1;
    let i = 0;
    while i < n {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// ── pure type helpers ────────────────────────────────────────────────────────────

// sizeof(c_type) — alias of type_size, in bytes.
fn sizeof(c_type) { return type_size(c_type); }

// is_type(name) — true if name is a known C type.
fn is_type(name) { return map_has(_c_type_sizes(), str_lower(name)); }

// struct_size(fields) — total byte size of a packed struct ([{name,type}, ...]),
// matching struct_define's layout (no registration).
fn struct_size(fields) {
    let total = 0;
    let i = 0;
    while i < len(fields) { total = total + type_size(fields[i].type); i = i + 1; }
    return total;
}

// struct_layout(fields) — [{name, type, offset, size}, ...] for a packed struct
// (same offsets struct_define computes, but pure / no registration).
fn struct_layout(fields) {
    let out = [];
    let offset = 0;
    let i = 0;
    while i < len(fields) {
        let sz = type_size(fields[i].type);
        array_push(out, map{ name: fields[i].name, type: fields[i].type, offset: offset, size: sz });
        offset = offset + sz;
        i = i + 1;
    }
    return out;
}

// struct_offset(fields, name) — byte offset of a named field, or nil if absent.
fn struct_offset(fields, name) {
    let offset = 0;
    let i = 0;
    while i < len(fields) {
        if fields[i].name == name { return offset; }
        offset = offset + type_size(fields[i].type);
        i = i + 1;
    }
    return nil;
}

export load_any;
export call_typed;
export marshal_to_c, marshal_from_c;
export struct_define, struct_pack, struct_unpack;
export callback_register, callback_invoke;
export type_size, list_types, sizeof, is_type, struct_size, struct_layout, struct_offset;
