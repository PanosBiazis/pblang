// stdlib/codegen_cpm.sapp -- CP/M 2.2 Z80 .COM backend for the shared register IR.
//
// CP/M loads a transient program at 0100h. This backend emits Z80 instructions
// directly and keeps the four 16-bit virtual registers in fixed image slots.
// The memory-backed register file makes every binary IR operation symmetric and
// avoids relying on undocumented CP/M state. Termination jumps to address 0000h,
// the documented warm-boot entry. CP/M has no portable process exit status; r0
// is loaded into HL before termination so execution-model and monitor tooling can
// inspect the result.

let IR = import("stdlib:codegen_ir.sapp");

fn _app(dst, src) { let i = 0; while i < len(src) { array_push(dst, src[i]); i = i + 1; } return dst; }
fn _reg(r) {
    if not is_number(r) or r < 0 or r > 3 or r != num_floor(r) {
        throw "codegen_cpm: register out of range 0..3";
    }
    return r;
}
fn _word(n, label) {
    if not is_number(n) or n < 0 or n > 65535 or n != num_floor(n) {
        throw "codegen_cpm: " + label + " outside unsigned 16-bit range: " + str(n);
    }
    return n;
}
fn _le16(n) { n = _word(n, "word"); return [n % 256, num_floor(n / 256) % 256]; }
fn _addr(slots, r) { return slots + _reg(r) * 2; }

fn _ld_hl_imm(n) { return _app([0x21], _le16(n)); }
fn _ld_hl_mem(a) { return _app([0x2A], _le16(a)); }
fn _st_hl_mem(a) { return _app([0x22], _le16(a)); }
fn _ld_bc_mem(a) { return _app([0xED, 0x4B], _le16(a)); }
fn _ld_de_mem(a) { return _app([0xED, 0x5B], _le16(a)); }
fn _ld_de_imm(n) { return _app([0x11], _le16(n)); }
fn _jp(a) { return _app([0xC3], _le16(a)); }
fn _jp_z(a) { return _app([0xCA], _le16(a)); }

// Load a virtual register into HL and set Z iff the complete 16-bit value is 0.
fn _test(slots, r) {
    let out = _ld_hl_mem(_addr(slots, r));
    _app(out, [0x7C, 0xB5]);                 // ld a,h; or l
    return out;
}

fn _seti(slots, r, n) {
    let out = _ld_hl_imm(_word(n, "immediate"));
    return _app(out, _st_hl_mem(_addr(slots, r)));
}
fn _movr(slots, dst, src) {
    let out = _ld_hl_mem(_addr(slots, src));
    return _app(out, _st_hl_mem(_addr(slots, dst)));
}
fn _add(slots, dst, src) {
    let out = _ld_hl_mem(_addr(slots, dst));
    _app(out, _ld_de_mem(_addr(slots, src)));
    array_push(out, 0x19);                   // add hl,de
    return _app(out, _st_hl_mem(_addr(slots, dst)));
}
fn _sub(slots, dst, src) {
    let out = _ld_hl_mem(_addr(slots, dst));
    _app(out, _ld_de_mem(_addr(slots, src)));
    _app(out, [0xB7, 0xED, 0x52]);           // or a (clear carry); sbc hl,de
    return _app(out, _st_hl_mem(_addr(slots, dst)));
}
fn _addi(slots, dst, n) {
    let out = _ld_hl_mem(_addr(slots, dst));
    _app(out, _ld_de_imm(_word(n, "immediate")));
    array_push(out, 0x19);                   // add hl,de
    return _app(out, _st_hl_mem(_addr(slots, dst)));
}

// Unsigned low-word multiplication. A bounded 16-bit repeated-add loop is slow
// on original Z80 hardware but exact, compact, and deterministic for all inputs.
fn _mul(slots, dst, src, pc) {
    let out = _ld_bc_mem(_addr(slots, dst));
    _app(out, _ld_de_mem(_addr(slots, src)));
    _app(out, _ld_hl_imm(0));
    let loop_pc = pc + len(out);
    _app(out, [0x7A, 0xB3]);                 // ld a,d; or e
    let done_pc = loop_pc + 2 + 3 + 1 + 1 + 3;
    _app(out, _jp_z(done_pc));
    _app(out, [0x09, 0x1B]);                 // add hl,bc; dec de
    _app(out, _jp(loop_pc));
    _app(out, _st_hl_mem(_addr(slots, dst)));
    return out;
}

fn _validate(ir, depth) {
    if depth > 64 { throw "codegen_cpm: control-flow nesting exceeds 64"; }
    let i = 0;
    while i < len(ir) {
        let ins = ir[i]; let op = ins[0];
        if op == "seti" or op == "addi" { _reg(ins[1]); _word(ins[2], "immediate"); }
        elif op == "add" or op == "sub" or op == "mul" or op == "movr" { _reg(ins[1]); _reg(ins[2]); }
        elif op == "loop" { _reg(ins[1]); _validate(ins[2], depth + 1); }
        elif op == "ifnz" { _reg(ins[1]); _validate(ins[2], depth + 1); _validate(ins[3], depth + 1); }
        else { throw "codegen_cpm: IR op is not available in CP/M COM backend: " + str(op); }
        i = i + 1;
    }
}

fn _measure(ir) {
    let n = 0; let i = 0;
    while i < len(ir) {
        let ins = ir[i]; let op = ins[0];
        if op == "seti" or op == "movr" { n = n + 6; }
        elif op == "add" { n = n + 11; }
        elif op == "sub" { n = n + 13; }
        elif op == "addi" { n = n + 10; }
        elif op == "mul" { n = n + 24; }
        elif op == "ifnz" {
            let else_len = _measure(ins[3]);
            n = n + 8 + _measure(ins[2]) + else_len + (if else_len > 0 { 3 } else { 0 });
        } elif op == "loop" { n = n + 8 + _measure(ins[2]) + 10; }
        i = i + 1;
    }
    return n;
}

fn _compile(ir, pc, slots) {
    let code = []; let i = 0;
    while i < len(ir) {
        let ins = ir[i]; let op = ins[0]; let here = pc + len(code);
        if op == "seti" { _app(code, _seti(slots, ins[1], ins[2])); }
        elif op == "movr" { _app(code, _movr(slots, ins[1], ins[2])); }
        elif op == "add" { _app(code, _add(slots, ins[1], ins[2])); }
        elif op == "sub" { _app(code, _sub(slots, ins[1], ins[2])); }
        elif op == "addi" { _app(code, _addi(slots, ins[1], ins[2])); }
        elif op == "mul" { _app(code, _mul(slots, ins[1], ins[2], here)); }
        elif op == "ifnz" {
            let then_pc = here + 5 + 3;
            let thenb = _compile(ins[2], then_pc, slots);
            let has_else = len(ins[3]) > 0;
            let else_pc = then_pc + len(thenb) + (if has_else { 3 } else { 0 });
            let elseb = _compile(ins[3], else_pc, slots);
            let end_pc = else_pc + len(elseb);
            _app(code, _test(slots, ins[1])); _app(code, _jp_z(if has_else { else_pc } else { end_pc }));
            _app(code, thenb);
            if has_else { _app(code, _jp(end_pc)); _app(code, elseb); }
        } elif op == "loop" {
            let loop_pc = here;
            let body_pc = loop_pc + 5 + 3;
            let body = _compile(ins[2], body_pc, slots);
            let tail_len = 7 + 3;            // load/decrement/store counter + jump
            let end_pc = body_pc + len(body) + tail_len;
            _app(code, _test(slots, ins[1])); _app(code, _jp_z(end_pc));
            _app(code, body);
            _app(code, _ld_hl_mem(_addr(slots, ins[1]))); array_push(code, 0x2B); // dec hl
            _app(code, _st_hl_mem(_addr(slots, ins[1]))); _app(code, _jp(loop_pc));
        }
        i = i + 1;
    }
    return code;
}

fn compile_ir(ir) {
    IR.assert_valid(ir); _validate(ir, 0);
    let measured = _measure(ir);
    let slots = 0x100 + measured + 6;         // ld hl,(r0); jp 0000h
    if slots + 8 > 0x10000 { throw "codegen_cpm: program exceeds CP/M 64 KiB address space"; }
    let code = _compile(ir, 0x100, slots);
    if len(code) != measured { throw "codegen_cpm: internal size mismatch"; }
    return map{ bytes: code, slots: slots };
}

fn compile_program(ir) {
    let built = compile_ir(ir); let code = built.bytes;
    _app(code, _ld_hl_mem(built.slots));
    _app(code, [0xC3, 0, 0]);                 // jp 0000h (CP/M warm boot)
    _app(code, [0, 0, 0, 0, 0, 0, 0, 0]);  // r0..r3 register slots
    if len(code) > 0xFF00 { throw "codegen_cpm: COM image exceeds transient program area"; }
    return code;
}

fn metadata() {
    return map{
        os: "cpm", arch: "z80", cpu_min: "z80", format: "com", os_min: "2.2",
        load_offset: 0x100, result_register: "hl", exit: "jp-0000h",
        status: "execution-model-verified"
    };
}

export compile_ir, compile_program, metadata;
