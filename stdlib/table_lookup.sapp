// Literal many-to-one enrichment of bounded Sheet documents. No SQL or I/O.
let Sheet=import("stdlib:sheet_document.sapp");
fn _column(value,count) {
    if type(value)!="number" or not (value>=0 and value<count) or value!=num_floor(value) {throw "invalid lookup column";}
}
// Both tables have headers. Right-hand keys must be unique and nonblank.
// Keep every left row in left mode; matched reports distinguish missing from blank.
fn join(left,right,left_key,right_key,columns,mode="left") {
    let a=Sheet.copy(left);let b=Sheet.copy(right);
    _column(left_key,len(a.cells[0]));_column(right_key,len(b.cells[0]));
    if type(columns)!="array" or len(columns)<1 or len(columns)>Sheet.MAX_COLUMNS
        or len(a.cells[0])+len(columns)>Sheet.MAX_COLUMNS or (mode!="left" and mode!="inner") {throw "invalid lookup selection or mode";}
    let seen=map{};
    for column in columns {_column(column,len(b.cells[0]));if map_has(seen,str(column)) {throw "duplicate lookup column";}seen[str(column)]=true;}
    let index=map{};
    for r in range(1,len(b.cells)) {
        let key=b.cells[r][right_key];
        if str_trim(key)=="" or map_has(index,key) {throw "lookup requires unique nonblank right keys";}
        index[key]=r;
    }
    let headers=[];for value in a.cells[0] {array_push(headers,value);}
    for column in columns {array_push(headers,b.cells[0][column]);}
    let rows=[headers];let matches=[];let source_rows=[];let matched=0;let unmatched=0;
    for r in range(1,len(a.cells)) {
        let key=a.cells[r][left_key];if str_trim(key)=="" {throw "lookup requires nonblank left keys";}
        let found=map_has(index,key);
        if found {matched=matched+1;}else {unmatched=unmatched+1;}
        if found or mode=="left" {
            let row=[];for value in a.cells[r] {array_push(row,value);}
            for column in columns {array_push(row,if found {b.cells[index[key]][column]} else {""});}
            array_push(rows,row);array_push(matches,found);array_push(source_rows,r);
        }
    }
    let document=map{format:Sheet.FORMAT,cells:rows};Sheet.validate(document);
    return map{format:"pblang.table-lookup.v1",document:document,matched:matched,unmatched:unmatched,
        row_matches:matches,source_rows:source_rows,mode:mode,contains_cell_text:true,safe_to_log:false};
}
export join;
