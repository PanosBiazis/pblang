// stdlib/fuzzy_match.sapp — fzf-style fuzzy matching (pbide command palette,
// file pickers, tool discovery). Adoptable module: pbide's WIP files import it
// when ready; nothing here depends on the IDE.
//
//   let FZ = import("stdlib:fuzzy_match.sapp");
//   FZ.rank("gp", candidates, 10);          // [{text, score}] best-first
//   FZ.highlight("gp", "gpio.sapp", "<b>", "</b>");
//
// Scoring: greedy left-to-right subsequence match, case-insensitive.
//   +1 per matched char, +2 when consecutive with the previous match,
//   +3 when the match lands on a word boundary (start, or after _ - . / space)
//   — boundaries outrank runs, as in fzf, so "rc" prefers read_config to circle.
// Not full fzf (no backtracking optimality), but fast, allocation-light, and
// right for palette-sized candidate lists.

fn _is_boundary_char(c) {
    return c == "_" or c == "-" or c == "." or c == "/" or c == " ";
}

// score(pattern, text) — match quality, or -1 when pattern is not a
// subsequence of text. Empty pattern scores 0 (matches everything weakly).
fn score(pattern, text) {
    let p = str_lower(pattern);
    let t = str_lower(text);
    if len(p) == 0 { return 0; }
    let s = 0;
    let ti = 0;
    let prev = 0 - 2;   // so the first match never counts as consecutive
    let pi = 0;
    while pi < len(p) {
        let pc = str_slice(p, pi, pi + 1);
        let found = 0 - 1;
        while ti < len(t) {
            if str_slice(t, ti, ti + 1) == pc { found = ti; ti = ti + 1; break; }
            ti = ti + 1;
        }
        if found < 0 { return 0 - 1; }
        s = s + 1;
        if found == prev + 1 { s = s + 2; }
        if found == 0 { s = s + 3; }
        else if _is_boundary_char(str_slice(t, found - 1, found)) { s = s + 3; }
        prev = found;
        pi = pi + 1;
    }
    return s;
}

// match_positions(pattern, text) — the matched indexes (greedy), or nil.
fn match_positions(pattern, text) {
    let p = str_lower(pattern);
    let t = str_lower(text);
    let out = [];
    let ti = 0;
    let pi = 0;
    while pi < len(p) {
        let pc = str_slice(p, pi, pi + 1);
        let found = 0 - 1;
        while ti < len(t) {
            if str_slice(t, ti, ti + 1) == pc { found = ti; ti = ti + 1; break; }
            ti = ti + 1;
        }
        if found < 0 { return nil; }
        push(out, found);
        pi = pi + 1;
    }
    return out;
}

// rank(pattern, candidates, k) — [{text, score}] best-first, non-matches dropped.
fn rank(pattern, candidates, k) {
    let scored = [];
    let i = 0;
    while i < len(candidates) {
        let s = score(pattern, candidates[i]);
        if s >= 0 { push(scored, map{ text: candidates[i], score: s }); }
        i = i + 1;
    }
    let out = [];
    while len(out) < k and len(scored) > 0 {
        let best = 0;
        let j = 1;
        while j < len(scored) { if scored[j].score > scored[best].score { best = j; } j = j + 1; }
        push(out, scored[best]);
        let rest = [];
        j = 0;
        while j < len(scored) { if j != best { push(rest, scored[j]); } j = j + 1; }
        scored = rest;
    }
    return out;
}

// highlight(pattern, text, open, close) — wrap matched chars for display.
// Unmatched (or empty) patterns return text unchanged.
fn highlight(pattern, text, open, close) {
    let pos = match_positions(pattern, text);
    if pos == nil or len(pos) == 0 { return text; }
    let out = "";
    let pi = 0;
    let i = 0;
    while i < len(text) {
        let c = str_slice(text, i, i + 1);
        if pi < len(pos) and pos[pi] == i { out = out + open + c + close; pi = pi + 1; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

export score, match_positions, rank, highlight;
