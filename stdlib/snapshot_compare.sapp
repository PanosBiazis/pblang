// Compare caller-supplied metadata only. No filesystem, hashing or merge operations.
let Fields=import("stdlib:template_fields.sapp");
let FORMAT="pblang.snapshot-manifest.v1";let MAX_ENTRIES=256;
fn _digest(value) {
 if type(value)!="string" or len(value)!=64 {return false;}
 for i in range(0,64) {let c=strcharcodeat(value,i);if not ((c>=48 and c<=57) or (c>=97 and c<=102)) {return false;}}
 return true;
}
fn validate(manifest) {
 if type(manifest)!="map" or len(manifest)!=2 or (try manifest.format catch nil)!=FORMAT or type(try manifest.entries catch nil)!="array" or len(manifest.entries)>MAX_ENTRIES {throw "snapshot: invalid manifest";}
 let seen=map{};
 for entry in manifest.entries {
  if type(entry)!="map" or len(entry)!=3 or not Fields.valid_name(try entry.id catch nil) or not _digest(try entry.digest catch nil) or not map_has(entry,"size") {throw "snapshot: invalid entry";}
  if type(entry.size)!="number" or not (entry.size>=0 and entry.size<=1000000000000) or entry.size!=num_floor(entry.size) {throw "snapshot: invalid size";}
  if map_has(seen,entry.id) {throw "snapshot: duplicate identifier";}seen[entry.id]=true;
 }
 return true;
}
fn compare(before,after) {
 validate(before);validate(after);
 let old=map{};let latest=map{};
 for entry in before.entries {old[entry.id]=entry;}
 for entry in after.entries {latest[entry.id]=entry;}
 let rows=[];let counts=map{unchanged:0,modified:0,added:0,removed:0,inconsistent:0};
 for entry in before.entries {
  let status="removed";let new_size=nil;
  if map_has(latest,entry.id) {
   let newer=latest[entry.id];new_size=newer.size;status="modified";
   if entry.digest==newer.digest {status=if entry.size==newer.size {"unchanged"} else {"inconsistent"};}
  }
  counts[status]=counts[status]+1;
  array_push(rows,map{id:entry.id,status:status,before_size:entry.size,after_size:new_size});
 }
 for entry in after.entries {
  if not map_has(old,entry.id) {counts.added=counts.added+1;array_push(rows,map{id:entry.id,status:"added",before_size:nil,after_size:entry.size});}
 }
 return map{format:"pblang.snapshot-comparison.v1",entries:rows,counts:counts,metadata_is_caller_supplied:true,contents_verified:false,merge_performed:false,digests_included:false};
}
export FORMAT,MAX_ENTRIES,validate,compare;
