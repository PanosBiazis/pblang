// stdlib/validate.sapp — Schema validation helpers.
//
// Validate maps/values against schemas. Returns {ok, errors} result.
//
// Usage:
//   let schema = validate.schema({
//     name:  { type: "string", required: true, min: 1, max: 50 },
//     age:   { type: "number", min: 0, max: 150 },
//     email: { type: "string", pattern: "@" }
//   });
//   let r = validate.check(schema, map{ name: "Alice", age: 30 });
//   if r.ok { print "valid"; } else { print r.errors; }

// --- Type checkers ---
fn _is_string(v) { return type(v) == "string"; }
fn _is_number(v) { return type(v) == "number"; }
fn _is_bool(v)   { return type(v) == "bool"; }
fn _is_array(v)  { return type(v) == "array"; }
fn _is_map(v)    { return type(v) == "map"; }
fn _is_nil(v)    { return v == nil; }

fn _copy_map(m) {
    let out = map{};
    if type(m) != "map" { return out; }
    let keys = map_keys(m);
    for i len(keys) {
        out[keys[i]] = m[keys[i]];
    }
    return out;
}

fn _enum_contains(opts, value) {
    let i = 0;
    while i < len(opts) {
        if opts[i] == value { return true; }
        i = i + 1;
    }
    return false;
}

// schema(fields_map) — create a schema definition
fn schema(fields_map, options = nil) {
    let out = map{ __schema: true, fields: fields_map };
    if type(options) == "map" {
        let keys = map_keys(options);
        for i len(keys) {
            out[keys[i]] = options[keys[i]];
        }
    }
    return out;
}

// check_field(value, field_def, field_name) — validate one field; returns [] or [error_string]
fn check_field(value, field_def, field_name) {
    let errs = [];
    let t = try field_def.type catch "any";

    // Required check
    if map_has(field_def, "required") and field_def.required == true {
        if value == nil {
            array_push(errs, field_name + " is required");
            return errs;
        }
    }
    if value == nil { return errs; }

    // Type check
    if t == "string" and _is_string(value) == false {
        array_push(errs, field_name + " must be a string");
    }
    if t == "number" and _is_number(value) == false {
        array_push(errs, field_name + " must be a number");
    }
    if t == "bool" and _is_bool(value) == false {
        array_push(errs, field_name + " must be a bool");
    }
    if t == "array" and _is_array(value) == false {
        array_push(errs, field_name + " must be an array");
    }
    if t == "map" and _is_map(value) == false {
        array_push(errs, field_name + " must be a map");
    }

    if map_has(field_def, "enum") and _enum_contains(field_def.enum, value) == false {
        array_push(errs, field_name + " must be one of the allowed values");
    }

    // String constraints
    if t == "string" and _is_string(value) {
        if map_has(field_def, "min") and len(value) < field_def.min {
            array_push(errs, field_name + " must be at least " + str(field_def.min) + " chars");
        }
        if map_has(field_def, "max") and len(value) > field_def.max {
            array_push(errs, field_name + " must be at most " + str(field_def.max) + " chars");
        }
        if map_has(field_def, "pattern") {
            // Real regex (linear-time engine, no ReDoS); an invalid pattern
            // falls back to the historical substring semantics.
            let pat = field_def.pattern;
            let m = try regex_match(value, pat) catch str_contains(value, pat);
            if m == false {
                array_push(errs, field_name + " must match pattern '" + pat + "'");
            }
        }
        if map_has(field_def, "format") {
            let fm = field_def.format;
            if fm == "email" and is_email(value) == false {
                array_push(errs, field_name + " must be an email");
            }
            if fm == "url" and is_url(value) == false {
                array_push(errs, field_name + " must be a URL");
            }
            if fm == "uuid" and is_uuid(value) == false {
                array_push(errs, field_name + " must be a valid uuid");
            }
            if fm == "ipv4" and is_ipv4(value) == false {
                array_push(errs, field_name + " must be a valid ipv4 address");
            }
            if fm == "ipv6" and is_ipv6(value) == false {
                array_push(errs, field_name + " must be a valid ipv6 address");
            }
            if fm == "date" and is_iso_date(value) == false {
                array_push(errs, field_name + " must be a valid ISO date");
            }
            if fm == "datetime" and is_iso_datetime(value) == false {
                array_push(errs, field_name + " must be a valid ISO datetime");
            }
            if fm == "hostname" and is_hostname(value) == false {
                array_push(errs, field_name + " must be a valid hostname");
            }
            if fm == "hex" and is_hex(value) == false {
                array_push(errs, field_name + " must be hex");
            }
            if fm == "base64" and is_base64(value) == false {
                array_push(errs, field_name + " must be base64");
            }
            if fm == "slug" and is_slug(value) == false {
                array_push(errs, field_name + " must be a slug");
            }
        }
    }

    // Number constraints
    if t == "number" and _is_number(value) {
        if map_has(field_def, "min") and value < field_def.min {
            array_push(errs, field_name + " must be >= " + str(field_def.min));
        }
        if map_has(field_def, "max") and value > field_def.max {
            array_push(errs, field_name + " must be <= " + str(field_def.max));
        }
        if map_has(field_def, "integer") and field_def.integer == true {
            if num_floor(value) != value {
                array_push(errs, field_name + " must be an integer");
            }
        }
        if map_has(field_def, "multiple_of") {
            if num_mod(value, field_def.multiple_of) != 0 {
                array_push(errs, field_name + " must be a multiple of " + str(field_def.multiple_of));
            }
        }
        if map_has(field_def, "format") and field_def.format == "port" {
            if is_port(value) == false {
                array_push(errs, field_name + " must be a valid port");
            }
        }
    }

    // Custom validator: fn(value) -> true | false | "error message".
    // A throwing validator counts as failure, never as a crash.
    if map_has(field_def, "validate") {
        let vr = try field_def.validate(value) catch false;
        if vr != true {
            if type(vr) == "string" {
                array_push(errs, vr);
            } else {
                array_push(errs, field_name + " failed custom validation");
            }
        }
    }

    // Array constraints
    if t == "array" and _is_array(value) {
        if map_has(field_def, "min") and len(value) < field_def.min {
            array_push(errs, field_name + " must have at least " + str(field_def.min) + " items");
        }
        if map_has(field_def, "max") and len(value) > field_def.max {
            array_push(errs, field_name + " must have at most " + str(field_def.max) + " items");
        }
        if map_has(field_def, "items") {
            let i = 0;
            while i < len(value) {
                let item_errs = check_field(value[i], field_def.items, field_name + "[" + str(i) + "]");
                let j = 0;
                while j < len(item_errs) {
                    array_push(errs, item_errs[j]);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
    }

    // Nested map constraints
    if t == "map" and _is_map(value) {
        if map_has(field_def, "fields") {
            let nested_opts = map{};
            if map_has(field_def, "strict") { nested_opts.strict = field_def.strict; }
            let nested = check(schema(field_def.fields, nested_opts), value, field_name + ".");
            let i = 0;
            while i < len(nested.errors) {
                array_push(errs, nested.errors[i]);
                i = i + 1;
            }
        }
    }

    return errs;
}

// check(schema_def, value_map) — validate a map against a schema
// Returns: { ok: bool, errors: [string] }
fn check(schema_def, value_map, prefix = "") {
    let all_errs = [];
    if type(schema_def) != "map" or (try schema_def.__schema catch false) != true {
        return map{ ok: false, errors: ["schema definition is invalid"] };
    }
    if type(value_map) != "map" {
        return map{ ok: false, errors: [prefix + "value must be a map"] };
    }
    let fields = schema_def.fields;
    let field_names = map_keys(fields);
    let i = 0;
    while i < len(field_names) {
        let fname = field_names[i];
        let fdef  = fields[fname];
        let fval  = nil;
        if map_has(value_map, fname) { fval = value_map[fname]; }
        let ferrs = check_field(fval, fdef, prefix + fname);
        let j = 0;
        while j < len(ferrs) {
            array_push(all_errs, ferrs[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    if (try schema_def.strict catch false) == true {
        let keys = map_keys(value_map);
        let k = 0;
        while k < len(keys) {
            if map_has(fields, keys[k]) == false {
                array_push(all_errs, prefix + keys[k] + " is not allowed");
            }
            k = k + 1;
        }
    }
    if len(all_errs) == 0 {
        return map{ ok: true, errors: [] };
    }
    return map{ ok: false, errors: all_errs };
}

// _prepare_value(fdef, v) — per-field sanitizers applied by apply_defaults:
// trim: true (strings) and coerce: true (string -> number/bool). A value that
// cannot be coerced is left untouched so the type check reports it; NaN is
// refused explicitly because it would sail through every min/max comparison.
fn _prepare_value(fdef, v) {
    if type(v) == "string" and (try fdef.trim catch false) == true {
        v = str_trim(v);
    }
    if type(v) == "string" and (try fdef.coerce catch false) == true {
        let t = try fdef.type catch "any";
        if t == "number" {
            let n = try parse_number(v) catch nil;
            if n != nil and n == n { v = n; }
        }
        if t == "bool" {
            let b = try parse_bool(v) catch nil;
            if b != nil { v = b; }
        }
    }
    return v;
}

fn apply_defaults(schema_def, value_map) {
    let out = _copy_map(value_map);
    let fields = schema_def.fields;
    let names = map_keys(fields);
    for i len(names) {
        let name = names[i];
        let fdef = fields[name];
        if map_has(out, name) == false and map_has(fdef, "default") {
            out[name] = fdef.default;
        }
        if map_has(out, name) {
            out[name] = _prepare_value(fdef, out[name]);
        }
        if map_has(out, name) and type(out[name]) == "map" and map_has(fdef, "fields") {
            out[name] = apply_defaults(schema(fdef.fields), out[name]);
        }
    }
    return out;
}

fn check_with_defaults(schema_def, value_map) {
    let value = apply_defaults(schema_def, value_map);
    let result = check(schema_def, value);
    result.value = value;
    return result;
}

fn assert_valid(schema_def, value_map) {
    let result = check(schema_def, value_map);
    if result.ok == false {
        return error("validation failed: " + result.errors[0]);
    }
    return value_map;
}

fn validate_all(schema_def, values) {
    let errors = [];
    if type(values) != "array" {
        return map{ ok: false, errors: ["values must be an array"], count: 0 };
    }
    for i len(values) {
        let r = check(schema_def, values[i], "[" + str(i) + "].");
        for j len(r.errors) {
            array_push(errors, r.errors[j]);
        }
    }
    return map{ ok: len(errors) == 0, errors: errors, count: len(values) };
}

fn explain(result) {
    if result.ok == true { return "valid"; }
    let out = "";
    for i len(result.errors) {
        if i > 0 { out = out + "\n"; }
        out = out + "- " + result.errors[i];
    }
    return out;
}

// is_email(s) — strict-enough email shape: one @, sane local part, dotted
// domain ending in an alphabetic TLD of 2+ chars. (Not full RFC 5321, but it
// refuses the classic garbage: "@.", "a@b", spaces, doubled @.)
fn is_email(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+([.][A-Za-z0-9-]+)*[.][A-Za-z]{2,}$");
}

// is_url(s) — http(s) URL with a non-empty host (a bare "https://" fails).
fn is_url(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^https?://[^/?# ]+");
}

// is_uuid(s) — 8-4-4-4-12 hex, case-insensitive.
fn is_uuid(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$");
}

// is_ipv4(s) — strict dotted quad: 4 decimal octets 0..255, leading zeros
// refused (they invite octal-interpretation confusion between parsers).
fn is_ipv4(s) {
    if type(s) != "string" { return false; }
    let parts = str_split(s, ".");
    if len(parts) != 4 { return false; }
    let i = 0;
    while i < 4 {
        let p = parts[i];
        if regex_match(p, "^(0|[1-9][0-9]{0,2})$") == false { return false; }
        if parse_number(p) > 255 { return false; }
        i = i + 1;
    }
    return true;
}

fn _ipv6_side_groups(side) {
    if side == "" { return []; }
    let gs = str_split(side, ":");
    let i = 0;
    while i < len(gs) {
        if gs[i] == "" { return nil; }
        i = i + 1;
    }
    return gs;
}

// is_ipv6(s) — RFC 4291 text form: 8 hex groups, at most one "::" gap
// (which must compress at least one group), optional IPv4-mapped tail.
fn is_ipv6(s) {
    if type(s) != "string" or s == "" { return false; }
    if str_contains(s, ":::") { return false; }
    let halves = str_split(s, "::");
    if len(halves) > 2 { return false; }
    let has_gap = len(halves) == 2;
    let groups = [];
    if has_gap {
        let l = _ipv6_side_groups(halves[0]);
        let r = _ipv6_side_groups(halves[1]);
        if l == nil or r == nil { return false; }
        let i = 0;
        while i < len(l) { array_push(groups, l[i]); i = i + 1; }
        i = 0;
        while i < len(r) { array_push(groups, r[i]); i = i + 1; }
    } else {
        groups = str_split(s, ":");
    }
    let count = 0;
    let i = 0;
    while i < len(groups) {
        let g = groups[i];
        if g == "" { return false; }
        if str_contains(g, ".") {
            if i != len(groups) - 1 { return false; }
            if is_ipv4(g) == false { return false; }
            count = count + 2;
        } else {
            if regex_match(g, "^[0-9A-Fa-f]{1,4}$") == false { return false; }
            count = count + 1;
        }
        i = i + 1;
    }
    if has_gap { return count <= 7; }
    return count == 8;
}

// is_iso_date(s) — "YYYY-MM-DD" with a real calendar check (leap years incl.
// the 100/400 century rules).
fn is_iso_date(s) {
    if type(s) != "string" { return false; }
    if regex_match(s, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") == false { return false; }
    let y  = parse_number(str_slice(s, 0, 4));
    let mo = parse_number(str_slice(s, 5, 7));
    let d  = parse_number(str_slice(s, 8, 10));
    if mo < 1 or mo > 12 { return false; }
    let dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let maxd = dim[mo - 1];
    if mo == 2 {
        if (num_mod(y, 4) == 0 and num_mod(y, 100) != 0) or num_mod(y, 400) == 0 {
            maxd = 29;
        }
    }
    return d >= 1 and d <= maxd;
}

// is_iso_datetime(s) — ISO date + "T"/" " + HH:MM:SS, optional .fraction and
// Z / +-HH:MM offset.
fn is_iso_datetime(s) {
    if type(s) != "string" or len(s) < 19 { return false; }
    if is_iso_date(str_slice(s, 0, 10)) == false { return false; }
    let sep = s[10];
    if sep != "T" and sep != "t" and sep != " " { return false; }
    let rest = str_slice(s, 11, len(s));
    return regex_match(rest, "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])?$");
}

// is_hostname(s) — RFC 1123: labels of 1..63 alnum/hyphen chars that don't
// start or end with a hyphen, total length <= 253.
fn is_hostname(s) {
    if type(s) != "string" { return false; }
    if len(s) < 1 or len(s) > 253 { return false; }
    let labels = str_split(s, ".");
    let i = 0;
    while i < len(labels) {
        let l = labels[i];
        if len(l) < 1 or len(l) > 63 { return false; }
        if regex_match(l, "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$") == false { return false; }
        i = i + 1;
    }
    return true;
}

// is_port(n) — integer 0..65535 (a number, never a string).
fn is_port(n) {
    if type(n) != "number" { return false; }
    if num_floor(n) != n { return false; }
    return n >= 0 and n <= 65535;
}

fn is_hex(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^[0-9A-Fa-f]+$");
}

// is_base64(s) — standard alphabet, correct padding, length % 4 == 0.
fn is_base64(s) {
    if type(s) != "string" { return false; }
    if num_mod(len(s), 4) != 0 { return false; }
    return regex_match(s, "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$");
}

fn is_slug(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^[a-z0-9]+(-[a-z0-9]+)*$");
}

fn is_alnum(s) {
    if type(s) != "string" { return false; }
    return regex_match(s, "^[A-Za-z0-9]+$");
}

// is_int(n) — true if number has no fractional part
fn is_int(n) {
    if type(n) != "number" { return false; }
    return num_floor(n) == n;
}

// in_range(n, lo, hi) — inclusive range check
fn in_range(n, lo, hi) { return n >= lo and n <= hi; }

// ── Bounded JSON-like value inspection ──────────────────────────────────────
//
// These helpers are deliberately separate from schema()/check(). They validate
// already-materialized values before a caller hashes or serializes them, return only
// fixed content-free reason codes, and never invoke callbacks or echo input.
let BOUNDED_VALUE_VERSION = "pblang.validate.bounded-value.v1";
let _BOUND_DEFAULT = map{
    max_depth: 32, max_nodes: 32768, max_map_entries: 256,
    max_array_items: 2048, max_string_chars: 65536,
    max_string_bytes: 262144, max_total_string_bytes: 1048576,
    max_key_chars: 128, max_key_bytes: 512
};
let _BOUND_KEYS = ["max_depth", "max_nodes", "max_map_entries",
    "max_array_items", "max_string_chars", "max_string_bytes",
    "max_total_string_bytes", "max_key_chars", "max_key_bytes"];

fn _bounded_hard_max(name) {
    if name == "max_depth" { return 64; }
    if name == "max_nodes" { return 65536; }
    if name == "max_map_entries" { return 1024; }
    if name == "max_array_items" { return 4096; }
    if name == "max_string_chars" { return 262144; }
    if name == "max_string_bytes" { return 1048576; }
    if name == "max_total_string_bytes" { return 2097152; }
    if name == "max_key_chars" { return 256; }
    if name == "max_key_bytes" { return 1024; }
    return -1;
}

fn _bounded_base(format) {
    return map{ format: format, version: BOUNDED_VALUE_VERSION, ok: false,
        safe_for_public_logging: false, input_returned: false,
        content_hashed: false, canonicalized: false, authorizes_effects: false };
}

fn _bounded_fail(format, reason) {
    let out = _bounded_base(format);
    out.reason = reason;
    return out;
}

fn _bounded_integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}

fn _bounded_options(options = nil) {
    let format = "pblang.validate.bounded-limits.v1";
    if options == nil { options = map{}; }
    if type(options) != "map" or len(options) > len(_BOUND_KEYS) {
        return _bounded_fail(format, "invalid-options");
    }
    // Width is checked with len(map) before map_keys, which otherwise clones and sorts.
    let keys = map_keys(options);
    let i = 0;
    while i < len(keys) {
        let known = false;
        let j = 0;
        while j < len(_BOUND_KEYS) {
            if keys[i] == _BOUND_KEYS[j] { known = true; }
            j = j + 1;
        }
        if not known { return _bounded_fail(format, "invalid-options"); }
        i = i + 1;
    }
    let out = _bounded_base(format);
    out.ok = true;
    out.reason = "valid";
    i = 0;
    while i < len(_BOUND_KEYS) {
        let name = _BOUND_KEYS[i];
        let value = _BOUND_DEFAULT[name];
        if map_has(options, name) { value = options[name]; }
        let minimum = 0;
        if name == "max_nodes" { minimum = 1; }
        if not _bounded_integer(value, minimum, _bounded_hard_max(name)) {
            return _bounded_fail(format, "invalid-options");
        }
        out[name] = value;
        i = i + 1;
    }
    return out;
}

fn bounded_limits(options = nil) { return _bounded_options(options); }

fn _finite_json_number(value) {
    let same = value;
    if type(value) != "number" or value != same { return false; }
    return value - same == 0;
}

fn _take_node(state, limits) {
    if state.nodes >= limits.max_nodes { return "node-limit"; }
    state.nodes = state.nodes + 1;
    return "";
}

fn _take_text_bytes(state, amount, limits) {
    if amount > limits.max_total_string_bytes - state.total_string_bytes {
        return "total-string-byte-limit";
    }
    state.total_string_bytes = state.total_string_bytes + amount;
    return "";
}

fn _walk_bounded(value, depth, limits, state, root_keys = nil) {
    if depth > limits.max_depth { return "depth-limit"; }
    let node_reason = _take_node(state, limits);
    if node_reason != "" { return node_reason; }
    if value == nil { state.nils = state.nils + 1; return ""; }
    let kind = type(value);
    if kind == "bool" { state.bools = state.bools + 1; return ""; }
    if kind == "number" {
        if not _finite_json_number(value) { return "nonfinite-number"; }
        state.numbers = state.numbers + 1;
        return "";
    }
    if kind == "string" {
        if len(value) > limits.max_string_chars { return "string-char-limit"; }
        let byte_count = len(str_to_bytes(value));
        if byte_count > limits.max_string_bytes { return "string-byte-limit"; }
        let byte_reason = _take_text_bytes(state, byte_count, limits);
        if byte_reason != "" { return byte_reason; }
        state.strings = state.strings + 1;
        return "";
    }
    if kind == "array" {
        if len(value) > limits.max_array_items { return "array-item-limit"; }
        state.arrays = state.arrays + 1;
        let i = 0;
        while i < len(value) {
            let reason = _walk_bounded(value[i], depth + 1, limits, state);
            if reason != "" { return reason; }
            i = i + 1;
        }
        return "";
    }
    if kind == "map" {
        if len(value) > limits.max_map_entries { return "map-entry-limit"; }
        state.maps = state.maps + 1;
        let keys = root_keys;
        if keys == nil { keys = map_keys(value); }
        let i = 0;
        while i < len(keys) {
            let key_reason = _take_node(state, limits);
            if key_reason != "" { return key_reason; }
            if type(keys[i]) != "string" { return "map-key-type"; }
            if len(keys[i]) > limits.max_key_chars { return "key-char-limit"; }
            let key_bytes = len(str_to_bytes(keys[i]));
            if key_bytes > limits.max_key_bytes { return "key-byte-limit"; }
            key_reason = _take_text_bytes(state, key_bytes, limits);
            if key_reason != "" { return key_reason; }
            state.keys = state.keys + 1;
            let value_reason = _walk_bounded(value[keys[i]], depth + 1, limits, state);
            if value_reason != "" { return value_reason; }
            i = i + 1;
        }
        return "";
    }
    return "unsupported-type";
}

fn _bounded_state() {
    return map{ nodes: 0, maps: 0, arrays: 0, keys: 0, strings: 0,
        numbers: 0, bools: 0, nils: 0, total_string_bytes: 0 };
}

fn _bounded_success(format, state) {
    let out = _bounded_base(format);
    out.ok = true;
    out.reason = "valid";
    out.nodes = state.nodes;
    out.maps = state.maps;
    out.arrays = state.arrays;
    out.keys = state.keys;
    out.strings = state.strings;
    out.numbers = state.numbers;
    out.bools = state.bools;
    out.nils = state.nils;
    out.total_string_bytes = state.total_string_bytes;
    return out;
}

fn inspect_bounded(value, options = nil) {
    let format = "pblang.validate.bounded-inspection.v1";
    let limits = _bounded_options(options);
    if not limits.ok { return _bounded_fail(format, "invalid-options"); }
    let state = _bounded_state();
    let reason = _walk_bounded(value, 0, limits, state);
    if reason != "" { return _bounded_fail(format, reason); }
    return _bounded_success(format, state);
}

fn _schema_key(value, limits) {
    if type(value) != "string" or value == "" or len(value) > limits.max_key_chars {
        return false;
    }
    let bytes = str_to_bytes(value);
    if len(bytes) > limits.max_key_bytes { return false; }
    let i = 0;
    while i < len(value) {
        let code = strcharcodeat(value, i);
        if code < 33 or code > 126 { return false; }
        i = i + 1;
    }
    return true;
}

fn exact_map_bounded(value, allowed_keys, options = nil) {
    let format = "pblang.validate.bounded-exact-map.v1";
    let limits = _bounded_options(options);
    if not limits.ok or type(allowed_keys) != "array"
        or len(allowed_keys) > limits.max_map_entries {
        return _bounded_fail(format, "invalid-schema-keys");
    }
    let allowed = map{};
    let i = 0;
    while i < len(allowed_keys) {
        if not _schema_key(allowed_keys[i], limits) or map_has(allowed, allowed_keys[i]) {
            return _bounded_fail(format, "invalid-schema-keys");
        }
        allowed[allowed_keys[i]] = true;
        i = i + 1;
    }
    if type(value) != "map" { return _bounded_fail(format, "not-a-map"); }
    if len(value) > limits.max_map_entries { return _bounded_fail(format, "map-entry-limit"); }
    let value_keys = map_keys(value);
    let state = _bounded_state();
    let reason = _walk_bounded(value, 0, limits, state, value_keys);
    if reason != "" { return _bounded_fail(format, reason); }
    if len(value_keys) != len(allowed_keys) { return _bounded_fail(format, "exact-map-mismatch"); }
    i = 0;
    while i < len(value_keys) {
        if not map_has(allowed, value_keys[i]) {
            return _bounded_fail(format, "exact-map-mismatch");
        }
        i = i + 1;
    }
    let out = _bounded_success(format, state);
    out.exact = true;
    return out;
}

fn bounded_value_status() {
    return map{
        format: "pblang.validate.bounded-value-status.v1",
        version: BOUNDED_VALUE_VERSION, ok: true,
        implementation_language: "pblang", pure: true,
        pre_enumeration_map_width_gate: true,
        bounded_depth_nodes_arrays_maps_strings_and_keys: true,
        finite_json_numbers_only: true, cycle_termination_bounded: true,
        aliases_counted_per_occurrence: true, fixed_content_free_reasons: true,
        post_materialization_only: true, bounds_parsing: false,
        remote_hostile_ready: false, outer_serialized_request_cap_required: true,
        prevents_already_materialized_input: false,
        detects_duplicate_json_keys: false, canonicalizes_for_hashing: false,
        content_safe: false, authorizes_effects: false,
        safe_for_public_logging: false
    };
}

export schema, check, check_field, apply_defaults, check_with_defaults,
       assert_valid, validate_all, explain, is_email, is_url, is_int, in_range,
       is_uuid, is_ipv4, is_ipv6, is_iso_date, is_iso_datetime, is_hostname,
       is_port, is_hex, is_base64, is_slug, is_alnum,
       BOUNDED_VALUE_VERSION, bounded_limits, inspect_bounded,
       exact_map_bounded, bounded_value_status;
