// stdlib/date.sapp — Date/time utilities (G2)
//
// Provides comprehensive date/time operations: instant timestamps,
// ISO parsing, strftime-like formatting, date arithmetic, and
// calendar utilities (day-of-week, week number, leap year).
//
// Usage:
//   let date = import("stdlib:date.sapp");
//
//   let now = date.now();                         // "2024-06-15T14:30:00Z"
//   let ts = date.now_unix();                     // 1718457000
//   let dt = date.parse("2024-06-15");            // → map{year,month,day,...}
//   let fmt = date.format(ts, "%Y-%m-%d");        // "2024-06-15"
//   let next = date.add_days(ts, 7);              // +7 days
//   let diff = date.diff_days(ts1, ts2);          // days between
//   let wd = date.weekday(ts);                    // "Monday"

// ──────────────────────────────────────────────────────────────────────────
// Unix timestamp basics
// ──────────────────────────────────────────────────────────────────────────

fn now_unix() { return num_floor(clock()); }
fn now_ms() { return num_floor(clock() * 1000.0); }

// now() → ISO 8601 UTC string like "2024-06-15T14:30:00Z"
fn now() {
    return from_unix_iso(now_unix());
}

fn from_unix(ts) { return map{ unix: ts, ms: ts * 1000 }; }

// ──────────────────────────────────────────────────────────────────────────
// ISO 8601 string generation from unix timestamp
// ──────────────────────────────────────────────────────────────────────────

// _pad2(n) — zero-pad to 2 digits
fn _pad2(n) {
    if n < 10 { return "0" + str(n); }
    return str(n);
}

// _pad4(n) — zero-pad to 4 digits
fn _pad4(n) {
    if n < 1000 { return "0" + _pad3(n); }
    return str(n);
}

fn _pad3(n) {
    if n < 10 { return "00" + str(n); }
    if n < 100 { return "0" + str(n); }
    return str(n);
}

// _unix_to_calendar(ts) — convert unix timestamp to calendar components
// Returns map{ year, month, day, hour, minute, second, yearday }
fn _unix_to_calendar(ts) {
    // Algorithm: convert seconds since 1970-01-01 to Gregorian calendar.
    // This uses a straightforward day-counting approach.

    let days_since_epoch = num_floor(ts / 86400);
    let sec_of_day = num_mod(ts, 86400);
    if ts < 0 and sec_of_day != 0 {
        // Adjust for negative timestamps before epoch
        days_since_epoch = days_since_epoch - 1;
        sec_of_day = sec_of_day + 86400;
    }

    // Compute year from days since epoch
    let remaining_days = days_since_epoch;
    let year = 1970;

    // Move to the right year
    while true {
        let days_in_year = 365;
        if is_leap_year(year) { days_in_year = 366; }
        if remaining_days < days_in_year { break; }
        remaining_days = remaining_days - days_in_year;
        year = year + 1;
    }

    // Handle negative (before epoch)
    while remaining_days < 0 {
        year = year - 1;
        let days_in_year = 365;
        if is_leap_year(year) { days_in_year = 366; }
        remaining_days = remaining_days + days_in_year;
    }

    let yearday = remaining_days;

    // Compute month and day
    let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if is_leap_year(year) { month_days[1] = 29; }

    let month = 0;
    while month < 12 and remaining_days >= month_days[month] {
        remaining_days = remaining_days - month_days[month];
        month = month + 1;
    }

    let day = remaining_days + 1;
    month = month + 1;

    let hour = num_floor(sec_of_day / 3600);
    let minute = num_floor(num_mod(sec_of_day, 3600) / 60);
    let second = num_mod(sec_of_day, 60);

    return map{
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        yearday: yearday,
    };
}

// from_unix_iso(ts) → ISO 8601 UTC string
fn from_unix_iso(ts) {
    let cal = _unix_to_calendar(ts);
    return _pad4(cal.year) + "-" + _pad2(cal.month) + "-" + _pad2(cal.day) +
           "T" + _pad2(cal.hour) + ":" + _pad2(cal.minute) + ":" + _pad2(cal.second) + "Z";
}

// ──────────────────────────────────────────────────────────────────────────
// Parse ISO 8601 string
// ──────────────────────────────────────────────────────────────────────────

// parse(iso_string) → map{ year, month, day, hour, minute, second }
// Accepts: "2024-06-15", "2024-06-15T14:30:00", "2024-06-15T14:30:00Z"
fn parse(iso_string) {
    let s = iso_string;

    // Strip timezone suffix Z
    if str_ends_with(s, "Z") { s = str_slice(s, 0, len(s) - 1); }

    // Split into date and time parts
    let parts = str_split(s, "T");
    let date_part = parts[0];
    let time_part = try parts[1] catch "00:00:00";

    // Split date
    let date_parts = str_split(date_part, "-");
    let year = try parse_number(date_parts[0]) catch 1970;
    let month = try parse_number(date_parts[1]) catch 1;
    let day = try parse_number(date_parts[2]) catch 1;

    // Split time
    let time_parts = str_split(time_part, ":");
    let hour = try parse_number(time_parts[0]) catch 0;
    let minute = try parse_number(time_parts[1]) catch 0;
    // Seconds may have fractional part
    let sec_str = try time_parts[2] catch "0";
    let sec_parts = str_split(sec_str, ".");
    let second = try parse_number(sec_parts[0]) catch 0;

    return map{
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
    };
}

// parse_unix(iso_string) — parse an ISO-8601 string directly to a unix
// timestamp (seconds). Convenience over `parse` (which returns a calendar map).
fn parse_unix(iso_string) {
    return _calendar_to_unix(parse(iso_string));
}

// _calendar_to_unix(cal) — convert calendar map to unix timestamp (approximate)
fn _calendar_to_unix(cal) {
    // Count days from 1970-01-01
    let year = cal.year;
    let month = cal.month;
    let day = cal.day;

    let days = 0;

    // Days for full years
    let y = 1970;
    while y < year {
        days = days + 365;
        if is_leap_year(y) { days = days + 1; }
        y = y + 1;
    }
    while y > year {
        y = y - 1;
        days = days - 365;
        if is_leap_year(y) { days = days - 1; }
    }

    // Days for months in current year
    let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if is_leap_year(year) { month_days[1] = 29; }

    let m = 1;
    while m < month {
        days = days + month_days[m - 1];
        m = m + 1;
    }

    // Days of current month
    days = days + (day - 1);

    let total_seconds = days * 86400;

    let hour = try cal.hour catch 0;
    let minute = try cal.minute catch 0;
    let second = try cal.second catch 0;

    total_seconds = total_seconds + hour * 3600 + minute * 60 + second;
    return total_seconds;
}

// ──────────────────────────────────────────────────────────────────────────
// Format timestamp with strftime-like patterns
// ──────────────────────────────────────────────────────────────────────────

// format(timestamp, pattern) → formatted string
// Pattern tokens:
//   %Y  — 4-digit year (2024)
//   %m  — 2-digit month (01-12)
//   %d  — 2-digit day (01-31)
//   %H  — 2-digit hour 24h (00-23)
//   %M  — 2-digit minute (00-59)
//   %S  — 2-digit second (00-59)
//   %%  — literal %
fn format(timestamp, pattern = nil) {
    if pattern == nil { pattern = "%Y-%m-%d"; }
    let cal = _unix_to_calendar(timestamp);
    let result = "";
    let i = 0;
    while i < len(pattern) {
        let ch = str_slice(pattern, i, i + 1);
        let next = "";
        if i + 1 < len(pattern) { next = str_slice(pattern, i + 1, i + 2); }

        if ch == "%" and next != "" {
            if next == "Y" { result = result + _pad4(cal.year); i = i + 1; }
            else if next == "m" { result = result + _pad2(cal.month); i = i + 1; }
            else if next == "d" { result = result + _pad2(cal.day); i = i + 1; }
            else if next == "H" { result = result + _pad2(cal.hour); i = i + 1; }
            else if next == "M" { result = result + _pad2(cal.minute); i = i + 1; }
            else if next == "S" { result = result + _pad2(cal.second); i = i + 1; }
            else if next == "%" { result = result + "%"; i = i + 1; }
            else { result = result + ch; }
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

// ──────────────────────────────────────────────────────────────────────────
// Date arithmetic
// ──────────────────────────────────────────────────────────────────────────

fn add_days(ts, days) { return ts + days * 86400; }
fn add_hours(ts, hours) { return ts + hours * 3600; }
fn add_minutes(ts, minutes) { return ts + minutes * 60; }

fn diff_seconds(ts1, ts2) { return ts2 - ts1; }
fn diff_minutes(ts1, ts2) { return (ts2 - ts1) / 60; }
fn diff_hours(ts1, ts2) { return (ts2 - ts1) / 3600; }
fn diff_days(ts1, ts2) { return (ts2 - ts1) / 86400; }

// ──────────────────────────────────────────────────────────────────────────
// Calendar utilities
// ──────────────────────────────────────────────────────────────────────────

fn is_leap_year(year) {
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0);
}

fn days_in_month(month, year) {
    let days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if month == 2 and is_leap_year(year) { return 29; }
    return days[month - 1];
}

// weekday(timestamp) → "Monday", "Tuesday", etc.
// Uses Zeller-like logic: 1970-01-01 was a Thursday (weekday 4 in 0=Sunday scheme)
fn weekday(timestamp) {
    let days = num_floor(timestamp / 86400);
    // 1970-01-01 was a Thursday
    let wd = num_mod(days + 4, 7);
    // Adjust for negative days
    while wd < 0 { wd = wd + 7; }

    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    return names[wd];
}

// weekday_number(timestamp) → 0=Sunday .. 6=Saturday
fn weekday_number(timestamp) {
    let days = num_floor(timestamp / 86400);
    let wd = num_mod(days + 4, 7);
    while wd < 0 { wd = wd + 7; }
    return wd;
}

// week_number(timestamp) → ISO 8601 week number (1-53)
// ISO weeks start on Monday; week 1 is the week containing the first Thursday.
fn week_number(timestamp) {
    let cal = _unix_to_calendar(timestamp);

    // Get ordinal day of year (1-based)
    let doy = cal.yearday + 1;

    // ISO weekday: Monday=1, Sunday=7
    let wd = weekday_number(timestamp);
    let iso_wd = wd;
    if iso_wd == 0 { iso_wd = 7; }   // Sunday → 7

    // Week = (doy - iso_wd + 10) / 7
    let week = num_floor((doy - iso_wd + 10) / 7);

    if week < 1 {
        // Week belongs to previous year
        let prev_year = cal.year - 1;
        let prev_days = 365;
        if is_leap_year(prev_year) { prev_days = 366; }
        let prev_doy = doy + prev_days;

        let prev_wd = iso_wd;
        // Recalculate doy offset into prev year
        week = num_floor((prev_doy - prev_wd + 10) / 7);
    }

    if week > 52 {
        // Check if it's really week 53
        let next_year_start = _unix_to_calendar(add_days(timestamp, 7 - iso_wd));
        if next_year_start.year == cal.year {
            week = 1;
        }
    }

    return week;
}

// format_duration(seconds) → human-readable duration string
fn format_duration(seconds) {
    let s = num_floor(seconds);
    let days = num_floor(s / 86400); s = s % 86400;
    let hours = num_floor(s / 3600); s = s % 3600;
    let mins = num_floor(s / 60); s = s % 60;
    let parts = [];
    if days > 0 { parts[len(parts)] = str(days) + "d"; }
    if hours > 0 { parts[len(parts)] = str(hours) + "h"; }
    if mins > 0 { parts[len(parts)] = str(mins) + "m"; }
    parts[len(parts)] = str(s) + "s";
    let out = ""; for i len(parts) { if i > 0 { out = out + " "; } out = out + parts[i]; }
    return out;
}

fn sleep(ms) { sleep_ms(ms); }

fn measure(fn_) {
    let t0 = clock();
    let r = fn_();
    return map{ result: r, ms: (clock() - t0) * 1000.0 };
}

// ──────────────────────────────────────────────────────────────────────────
// Export
// ──────────────────────────────────────────────────────────────────────────

export now, now_unix, now_ms, from_unix, from_unix_iso,
       parse, parse_unix, format,
       _unix_to_calendar, _calendar_to_unix,
       add_days, add_hours, add_minutes,
       diff_seconds, diff_minutes, diff_hours, diff_days,
       is_leap_year, days_in_month,
       weekday, weekday_number, week_number,
       format_duration, sleep, measure;
