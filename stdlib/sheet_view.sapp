// Detached read-only sheet page. Contains selected cell text: never log/export
// implicitly. Rendering adapters may embed it in HTML or JVM constant pools.
let Sheet=import("stdlib:sheet_document.sapp");
let UI=import("stdlib:modern_ui.sapp");
fn _page(value,dimension) {
    return type(value)=="number" and value==value and value>=0
        and value<num_floor((dimension+3)/4) and value==num_floor(value);
}
fn create(doc,row_page=0,column_page=0) {
    let snapshot=Sheet.copy(doc); let rows=len(snapshot.cells); let columns=len(snapshot.cells[0]);
    if not _page(row_page,rows) or not _page(column_page,columns) { throw "invalid sheet view page"; }
    let first_row=row_page*4; let first_column=column_page*4;
    let cells=[];
    for r in range(first_row,num_min(first_row+4,rows)) {
        for c in range(first_column,num_min(first_column+4,columns)) {
            let address=strfromcharcode(65+c)+str(r+1);
            array_push(cells,UI.card([
                UI.text(snapshot.cells[r][c],map{name:"value_"+address})
            ],map{title:address,name:"cell_"+address}));
        }
    }
    return UI.screen([
        UI.heading("PBOffice Sheets",map{name:"sheet_heading"}),
        UI.text("Read-only snapshot. Editing and saving are available in the native editor.",map{name:"sheet_notice"}),
        UI.text("Sheet: "+str(rows)+" rows x "+str(columns)+" columns. Page: "
            +str(row_page+1)+" / "+str(num_floor((rows+3)/4))+" rows; "
            +str(column_page+1)+" / "+str(num_floor((columns+3)/4))+" columns.",map{name:"sheet_page"}),
        UI.grid(cells,map{name:"sheet_cells",columns:4}),
        UI.text("This view contains document values. Do not publish or export it without approval.",map{name:"sheet_privacy"})
    ],map{name:"sheet_snapshot"});
}
export create;
