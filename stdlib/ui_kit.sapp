// stdlib/ui_kit.sapp — modern UI widget geometry for pblang GUIs (pblang-native).
//
// A tiny, fast, renderer-agnostic toolkit: it turns a widget rectangle into a list of
// axis-aligned sub-rects that any backend fills with its rect primitive. That buys you
// rounded cards, pill buttons, soft elevation shadows and crisp dividers WITHOUT any
// per-pixel work in the draw loop — ideal for the native IDE (editors/ide/pbide.sapp).
//
// Everything is pure (no drawing, no globals), so the geometry is unit-testable. Rects
// are maps { x, y, w, h }. Colors are the caller's concern.
//
//   let ui  = import("stdlib:ui_kit.sapp");
//   for r in ui.rounded_rect(x, y, w, h, 6) { win.rect(r.x, r.y, r.w, r.h, fill); }
//   for r in ui.elevation(x, y, w, h, 2)    { win.rect(r.x, r.y, r.w, r.h, shadow); }

fn _min(a, b) { if a < b { return a; } return b; }
fn _max(a, b) { if a > b { return a; } return b; }
fn _r(x, y, w, h) { return map{ x: x, y: y, w: w, h: h }; }

// _isqrt(v) — integer square root (largest x with x*x <= v). Radii are tiny, so the
// linear climb is cheap and avoids depending on a float sqrt builtin.
fn _isqrt(v) {
    if v <= 0 { return 0; }
    let x = 0;
    while (x + 1) * (x + 1) <= v { x = x + 1; }
    return x;
}

// rounded_rect(x, y, w, h, r) — a rounded rectangle with SMOOTH quarter-circle corners,
// as 2r+1 filled bands: one 1px scanline span per corner row (its horizontal inset
// follows the circle x² + y² = r²) plus one full-width middle band. Still pure rect
// fills — no per-pixel work — but the corners genuinely curve instead of the old square
// notch. r is clamped to the box; r<=0 returns the plain rect; degenerate bands are
// dropped so a too-large r degrades gracefully.
fn rounded_rect(x, y, w, h, r) {
    if w <= 0 or h <= 0 { return []; }
    let rad = num_floor(r);
    let cap = num_floor(_min(w, h) / 2);
    if rad > cap { rad = cap; }
    if rad <= 0 { return [_r(x, y, w, h)]; }
    let out = [];
    let rr = rad * rad;
    let dy = 0;
    let circle_x = 0;
    while dy < rad {
        let d = rad - dy;
        // As d decreases, the root never decreases. Advance at most rad times
        // across the entire corner, preserving the exact legacy bands/order.
        let remaining = rr - d * d;
        while (circle_x + 1) * (circle_x + 1) <= remaining { circle_x = circle_x + 1; }
        let inset = rad - circle_x;
        let bw = w - 2 * inset;
        if bw > 0 {
            array_push(out, _r(x + inset, y + dy, bw, 1));
            array_push(out, _r(x + inset, y + h - 1 - dy, bw, 1));
        }
        dy = dy + 1;
    }
    let mh = h - 2 * rad;
    if mh > 0 { array_push(out, _r(x, y + rad, w, mh)); }
    if len(out) == 0 { return [_r(x, y, w, h)]; }
    return out;
}

// pill(x, y, w, h) — a rounded_rect with a generous, always-safe corner radius.
fn pill(x, y, w, h) { return rounded_rect(x, y, w, h, num_floor(_min(w, h) / 3)); }

// card(x, y, w, h, r, t) — a bordered rounded card as { border, fill } rect lists: draw
// `border` in the border color, then `fill` (inset by border thickness t) in the surface
// color, for a clean framed panel.
fn card(x, y, w, h, r, t) {
    let border = rounded_rect(x, y, w, h, r);
    let fr = _max(r - t, 0);
    let fill = rounded_rect(x + t, y + t, _max(w - 2 * t, 0), _max(h - 2 * t, 0), fr);
    return map{ border: border, fill: fill };
}

// inset(rect, d) — shrink a rect symmetrically by d on every side.
fn inset(rect, d) {
    return _r(rect.x + d, rect.y + d, _max(rect.w - 2 * d, 0), _max(rect.h - 2 * d, 0));
}

// elevation(x, y, w, h, t) — a soft drop shadow as the bottom + right edges, offset by t
// (draw these in a darker shadow color BEFORE the widget for a "floating" look).
fn elevation(x, y, w, h, t) {
    return [_r(x + t, y + h, w, t), _r(x + w, y + t, t, h)];
}

// divider_h / divider_v — 1-axis separators of thickness t.
fn divider_h(x, y, w, t) { return _r(x, y, w, t); }
fn divider_v(x, y, h, t) { return _r(x, y, t, h); }

// contains(rect, px, py) — half-open hit test [x, x+w) × [y, y+h).
fn contains(rect, px, py) {
    return px >= rect.x and px < rect.x + rect.w and py >= rect.y and py < rect.y + rect.h;
}

// top_accent(x, y, w, t) / bottom_accent(x, y, h, w, t) — accent bars for active tabs.
fn top_accent(x, y, w, t) { return _r(x, y, w, t); }
fn bottom_accent(x, y, w, h, t) { return _r(x, y + h - t, w, t); }

fn _clamp01(f) { if f < 0 { return 0; } if f > 1 { return 1; } return f; }

// progress(x, y, w, h, frac) — a { track, fill } bar; frac is clamped to [0,1].
fn progress(x, y, w, h, frac) {
    let f = _clamp01(frac);
    return map{ track: _r(x, y, w, h), fill: _r(x, y, num_floor(w * f), h) };
}

// segmented(x, y, w, h, n, gap) — n equal segment rects across w (for segmented
// controls / button groups), separated by `gap`.
fn segmented(x, y, w, h, n, gap) {
    let out = [];
    if n <= 0 { return out; }
    let sw = num_floor((w - (n - 1) * gap) / n);
    let i = 0;
    while i < n { array_push(out, _r(x + i * (sw + gap), y, sw, h)); i = i + 1; }
    return out;
}

// scrollbar(x, y, h, total, visible, offset, thick) — a { track, thumb }. The thumb is
// sized to the visible fraction and positioned by the scroll offset. When everything
// fits (total <= visible) the thumb fills the track.
fn scrollbar(x, y, h, total, visible, offset, thick) {
    let track = _r(x, y, thick, h);
    if total <= visible or total <= 0 { return map{ track: track, thumb: _r(x, y, thick, h) }; }
    let th = num_floor(h * visible / total);
    if th < thick * 2 { th = thick * 2; }
    if th > h { th = h; }
    let maxoff = total - visible;
    let ty = num_floor((h - th) * offset / maxoff);
    if ty < 0 { ty = 0; }
    if ty > h - th { ty = h - th; }
    return map{ track: track, thumb: _r(x, y + ty, thick, th) };
}

// badge_width(text, cw, pad) — pixel width of a text badge/chip (glyph advance * length
// plus horizontal padding on both sides).
fn badge_width(text, cw, pad) { return len(text) * cw + 2 * pad; }

// grid_cells(x, y, w, h, cols, rows, gap) — a uniform grid of cell rects (row-major),
// for icon grids / Designer canvases / file tiles.
fn grid_cells(x, y, w, h, cols, rows, gap) {
    let out = [];
    if cols <= 0 or rows <= 0 { return out; }
    let cw = num_floor((w - (cols - 1) * gap) / cols);
    let ch = num_floor((h - (rows - 1) * gap) / rows);
    let ry = 0;
    while ry < rows {
        let cx = 0;
        while cx < cols {
            array_push(out, _r(x + cx * (cw + gap), y + ry * (ch + gap), cw, ch));
            cx = cx + 1;
        }
        ry = ry + 1;
    }
    return out;
}

// tag(x, y, text_len, cw, pad, h) — a text-chip rect sized to its glyph count (round it
// with rounded_rect / pill to draw a label/badge).
fn tag(x, y, text_len, cw, pad, h) { return _r(x, y, badge_width_n(text_len, cw, pad), h); }
fn badge_width_n(text_len, cw, pad) { return text_len * cw + 2 * pad; }

// clamp(v, lo, hi) — bound v to [lo, hi].
fn clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }

// center(outer, inner) — offset to center an inner length within an outer one (never < 0),
// e.g. vertically centering CH-tall text inside a CH+PAD row.
fn center(outer, inner) { return _max(num_floor((outer - inner) / 2), 0); }

// zebra(index) — true on odd rows (for alternating list-row backgrounds).
fn zebra(index) { return num_floor(index) - 2 * num_floor(index / 2) == 1; }

export rounded_rect, pill, card, inset, elevation, divider_h, divider_v, contains, top_accent, bottom_accent;
export progress, segmented, scrollbar, badge_width, grid_cells;
export tag, clamp, center, zebra;
