// stdlib/net/index.sapp — Unified Sovereign Networking Facade (v4.2.0).
//
// Combines:
//   - TCP / TLS sockets & server loops (`stdlib:net.sapp`)
//   - HTTP/1.1 Keep-Alive connection pooling, Chunked streaming, W3C SSE & Multipart (`stdlib:net/http_keepalive_stream.sapp`)
//   - Cross-platform UDP datagrams, RFC 1035 DNS, RFC 5389 STUN & RFC 9000/9221 QUIC telemetry (`stdlib:net/udp_dns_quic_realtime.sapp`)
//   - HTTP/0.9, HTTP/1.0, HTTP/2 + HPACK, HTTP/3 + QPACK, WebTransport (RFC 9297),
//     DoH/DoQ Encrypted DNS, Hardened Web Security Headers & Adaptive HTTP Router (`stdlib:net/http2_http3_adaptive.sapp`)

let TCP = import("stdlib:net.sapp");
let HTTP_STREAM = import("stdlib:net/http_keepalive_stream.sapp");
let REALTIME = import("stdlib:net/udp_dns_quic_realtime.sapp");
let H2H3 = import("stdlib:net/http2_http3_adaptive.sapp");

// ── TCP & TLS Re-exports ─────────────────────────────────────────────────────

fn listen(addr) { return TCP.listen(addr); }
fn connect(addr) { return TCP.connect(addr); }
fn accept(listener) { return TCP.accept(listener); }
fn read(handle, maximum) { return TCP.read(handle, maximum); }
fn read_until(handle, delimiter, maximum) { return TCP.read_until(handle, delimiter, maximum); }
fn write(handle, data) { return TCP.write(handle, data); }
fn close(handle) { return TCP.close(handle); }
fn local_addr(handle) { return TCP.local_addr(handle); }
fn connect_tls(host, port) { return TCP.connect_tls(host, port); }
fn listen_tls(addr, cert_path, key_path) { return TCP.listen_tls(addr, cert_path, key_path); }
fn wrap_tls(handle, cert_path, key_path) { return TCP.wrap_tls(handle, cert_path, key_path); }
fn parse_addr(s) { return TCP.parse_addr(s); }
fn host_port(host, port) { return TCP.host_port(host, port); }
fn read_n(handle, n) {
    if n <= 0 { return ""; }
    let out = [];
    while len(out) < n {
        let chunk = TCP.read(handle, n - len(out));
        if chunk == nil or chunk == "" { break; }
        let cb = str_to_bytes(chunk);
        if len(cb) == 0 { break; }
        let i = 0;
        while i < len(cb) {
            array_push(out, cb[i]);
            i = i + 1;
        }
    }
    return bytes_to_str(out);
}
fn read_all(handle) { return TCP.read_all(handle); }
fn read_line(handle) { return TCP.read_line(handle); }
fn with_listener(addr, body) { return TCP.with_listener(addr, body); }
fn serve_once(addr, handler) { return TCP.serve_once(addr, handler); }
fn serve(addr, handler) { return TCP.serve(addr, handler); }

// ── HTTP/1.1 Keep-Alive, Chunked, SSE & Multipart Re-exports ─────────────────

fn KeepAliveSession(base_url = "", opts = nil) { return HTTP_STREAM.KeepAliveSession(base_url, opts); }
fn new_session(base_url = "", opts = nil) { return HTTP_STREAM.new_session(base_url, opts); }
fn stream_request(method, url, on_chunk_fn, opts = nil) { return HTTP_STREAM.stream_request(method, url, on_chunk_fn, opts); }
fn stream_sse_events(url, on_event_fn, opts = nil) { return HTTP_STREAM.stream_sse_events(url, on_event_fn, opts); }
fn upload_multipart(url, parts_array, opts = nil) { return HTTP_STREAM.upload_multipart(url, parts_array, opts); }
fn encode_chunked(chunks_array, trailers = nil) { return HTTP_STREAM.encode_chunked(chunks_array, trailers); }
fn decode_chunked(raw_bytes_or_str, max_body_bytes = 67108864) { return HTTP_STREAM.decode_chunked(raw_bytes_or_str, max_body_bytes); }
fn build_multipart(parts_array, boundary = nil) { return HTTP_STREAM.build_multipart(parts_array, boundary); }
fn parse_multipart(body_bytes_or_str, boundary) { return HTTP_STREAM.parse_multipart(body_bytes_or_str, boundary); }
fn parse_url(url_str) { return HTTP_STREAM.parse_url(url_str); }
fn check_url_ssrf(url_or_parsed, opts = nil) { return HTTP_STREAM.check_url_ssrf(url_or_parsed, opts); }
fn redact_headers(headers) { return HTTP_STREAM.redact_headers(headers); }

