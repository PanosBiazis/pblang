//! machine_learning.sapp — Machine learning utilities for pblang

fn normalize_minmax(values) {
    if len(values) == 0 { return []; }
    let mn = values[0]; let mx = values[0]; let i = 0;
    while i < len(values) { if values[i] < mn { mn = values[i]; } if values[i] > mx { mx = values[i]; } i = i + 1; }
    if mn == mx { return values; }
    let result = []; let j = 0;
    while j < len(values) { array_push(result, (values[j] - mn) / (mx - mn)); j = j + 1; }
    return result;
}
fn normalize_zscore(values) {
    if len(values) == 0 { return []; }
    let total = 0.0; let i = 0;
    while i < len(values) { total = total + values[i]; i = i + 1; }
    let mean = total / len(values);
    let sq = 0.0; let j = 0;
    while j < len(values) { let d = values[j] - mean; sq = sq + d*d; j = j + 1; }
    let std = num_sqrt(sq / len(values)); if std == 0 { return values; }
    let result = []; let k = 0;
    while k < len(values) { array_push(result, (values[k] - mean) / std); k = k + 1; }
    return result;
}
fn shuffle_data(data) {
    let result = []; let i = 0;
    while i < len(data) { array_push(result, data[i]); i = i + 1; }
    // Fisher-Yates with a MINSTD LCG (no rand builtin). The previous `k = j % 4`
    // only ever swapped into indices 0..3, leaving the rest of the array in
    // place — a degenerate, biased "shuffle". This swaps result[j] with a slot
    // uniformly chosen from [0, j], a correct permutation. The LCG (mult 48271,
    // mod 2^31-1) stays within f64's exact-integer range (product < 2^47).
    let seed = (len(result) + 1) * 48271 % 2147483647;
    let j = len(result) - 1;
    while j > 0 {
        seed = seed * 48271 % 2147483647;
        let k = seed % (j + 1);
        let tmp = result[j]; result[j] = result[k]; result[k] = tmp;
        j = j - 1;
    }
    return result;
}
fn train_test_split(data, test_ratio = 0.2) {
    let n_test = test_ratio * len(data); if n_test < 1 { n_test = 1; }
    let s = shuffle_data(data); let train = []; let test = []; let i = 0;
    while i < len(s) { if i < n_test { array_push(test, s[i]); } else { array_push(train, s[i]); } i = i + 1; }
    return map{ train: train, test: test };
}
fn accuracy_score(yt, yp) { let c=0; let i=0; while i < len(yt) { if yt[i]==yp[i] { c=c+1; } i=i+1; } return c/len(yt); }
fn contains(arr, v) { let i=0; while i < len(arr) { if arr[i]==v { return true; } i=i+1; } return false; }
fn confusion_matrix(yt, yp, labels = nil) {
    if labels == nil { labels = []; let i=0; while i < len(yt) { if not contains(labels, yt[i]) { array_push(labels, yt[i]); } i=i+1; } }
    let m = {}; let i2=0; while i2 < len(labels) { let r = {}; let j=0; while j < len(labels) { r[labels[j]] = 0; j=j+1; } m[labels[i2]] = r; i2=i2+1; }
    let k=0; while k < len(yt) { m[yt[k]][yp[k]] = m[yt[k]][yp[k]] + 1; k=k+1; }
    return m;
}
fn kfold_split(data, k = 5) {
    let s = shuffle_data(data); let fs = len(s) / k; let folds = []; let f=0;
    while f < k { let fold = []; let start = f*fs; let end = start+fs; if f==k-1 { end=len(s); } let i=start; while i < end { array_push(fold, s[i]); i=i+1; } array_push(folds, fold); f=f+1; }
    let splits = []; let j=0;
    while j < k { let train = []; let test = folds[j]; let t=0; while t < k { if t!=j { let m=0; while m < len(folds[t]) { array_push(train, folds[t][m]); m=m+1; } } t=t+1; } array_push(splits, map{train:train, test:test}); j=j+1; }
    return splits;
}
fn one_hot_encode(labels) {
    let uniq = []; let i=0; while i < len(labels) { if not contains(uniq, labels[i]) { array_push(uniq, labels[i]); } i=i+1; }
    let result = {}; let u=0; while u < len(uniq) { let vec=[]; let v=0; while v < len(uniq) { array_push(vec, 0); v=v+1; } vec[u]=1; result[uniq[u]]=vec; u=u+1; }
    return result;
}
fn euclidean_distance(a, b) { let t=0.0; let i=0; while i < len(a) { let d=a[i]-b[i]; t=t+d*d; i=i+1; } return num_sqrt(t); }
fn manhattan_distance(a, b) { let t=0.0; let i=0; while i < len(a) { let d=a[i]-b[i]; if d<0{d=0-d;} t=t+d; i=i+1; } return t; }

export normalize_minmax; export normalize_zscore; export train_test_split;
export accuracy_score; export confusion_matrix; export kfold_split;
export one_hot_encode; export shuffle_data; export euclidean_distance; export manhattan_distance;
