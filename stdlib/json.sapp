// stdlib/json.sapp
//
// Thin convenience layer over VM builtins:
// - json_parse(str) -> value
// - json_stringify(value) -> string

fn parse(s) { return json_parse(s); }
fn stringify(v) { return json_stringify(v); }

// Handy helpers
fn try_parse(s) {
    return try json_parse(s) catch nil;
}

export parse, stringify, try_parse;

