// Canonical dense lowering image for verified exact-i32 PBCK call graphs.
// Platform backends consume primitive arrays instead of recursive function
// maps. The image is independently validated and checksum-bound before use.
let Calls = import("stdlib:host_pbck_frame_calls.sapp");

let FORMAT = "pblang.host-pbck.frame-lowering-i32.v1";
let VERSION = 1;
let MODULUS = 2147483647;

fn _fault(message) { throw "host_pbck_frame_lowering: " + message; }

fn _integer(value) { return is_number(value) and value == num_floor(value); }

fn _option(options, key, fallback) {
    if options != nil and is_map(options) and map_has(options, key) { return options[key]; }
    return fallback;
}

fn _limit(options, key, fallback, hard_max) {
    let value = _option(options, key, fallback);
    if not is_number(value) or value != num_floor(value)
    or value < 1 or value > hard_max { _fault("invalid " + key); }
    return value;
}

fn _is_function(value) {
    return is_map(value) and map_has(value, "__pbck_function_id")
        and is_number(value.__pbck_function_id)
        and value.__pbck_function_id == num_floor(value.__pbck_function_id);
}

fn _required_upvalues(program, function_id) {
    let function = program.functions[function_id]; let required = 0; let i = 0;
    while i < function.instruction_count {
        let absolute = function.instruction_start + i;
        let op = program.opcodes[absolute]; let operand = program.operands[absolute];
        if (op == 28 or op == 29) and operand + 1 > required { required = operand + 1; }
        if op == 27 {
            let start = program.instruction_capture_starts[absolute];
            let count = program.instruction_capture_counts[absolute]; let ci = 0;
            while ci < count {
                let slot = start + ci;
                if not program.capture_is_local[slot]
                and program.capture_indices[slot] + 1 > required {
                    required = program.capture_indices[slot] + 1;
                }
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    return required;
}

fn _mix(hash, value) {
    let normalized = num_mod(value, MODULUS);
    if normalized < 0 { normalized = normalized + MODULUS; }
    return num_mod(hash * 65599 + normalized + 97, MODULUS);
}

fn _mix_array(hash, values) {
    hash = _mix(hash, len(values)); let i = 0;
    while i < len(values) { hash = _mix(hash, values[i]); i = i + 1; }
    return hash;
}

fn checksum(image) {
    let hash = 1469597;
    let scalars = [image.version, image.entry_function, image.function_count,
    image.entry_arg_count, image.instruction_count, image.constant_count, image.capture_count,
    image.default_count, image.expected_value, image.observed_steps,
    image.observed_peak_frames, image.observed_peak_stack,
    image.observed_peak_locals, image.observed_closures,
    image.observed_tail_calls, image.max_steps, image.max_frames,
    image.max_stack, image.max_locals, image.max_total_locals,
    image.max_closures];
    hash = _mix_array(hash, scalars);
    let arrays = [image.original_function_ids, image.function_arity,
    image.function_min_arity, image.function_max_local,
    image.function_upvalue_count, image.function_instruction_start,
    image.function_instruction_count, image.function_default_start,
    image.function_default_count, image.opcodes, image.operands,
    image.instruction_capture_start, image.instruction_capture_count,
    image.capture_is_local, image.capture_indices, image.constant_kinds,
    image.constant_i32, image.constant_functions, image.default_constants,
    image.entry_arg_constants];
    let i = 0;
    while i < len(arrays) { hash = _mix_array(hash, arrays[i]); i = i + 1; }
    return hash;
}

fn _required_array(image, key) {
    if not map_has(image, key) or not is_array(image[key]) {
        _fault("missing array " + key);
    }
    return image[key];
}

fn validate(image, options = nil) {
    if options != nil and not is_map(options) { _fault("options must be a map"); }
    if not is_map(image) or not map_has(image, "format") or image.format != FORMAT
    or not map_has(image, "version") or image.version != VERSION {
        _fault("invalid lowering image header");
    }
    let max_functions = _limit(options, "max_functions", 4096, 4096);
    let max_instructions = _limit(options, "max_instructions", 65536, 1048576);
    let max_constants = _limit(options, "max_constants", 65536, 1048576);
    let max_captures = _limit(options, "max_captures", 65536, 1048576);
    let max_defaults = _limit(options, "max_defaults", 65536, 1048576);
    let scalar_names = ["entry_function", "function_count", "entry_arg_count",
    "instruction_count", "constant_count", "capture_count", "default_count",
    "expected_value", "observed_steps", "observed_peak_frames",
    "observed_peak_stack", "observed_peak_locals", "observed_closures",
    "observed_tail_calls", "max_steps", "max_frames", "max_stack",
    "max_locals", "max_total_locals", "max_closures"];
    let si = 0;
    while si < len(scalar_names) {
        if not map_has(image, scalar_names[si]) or not _integer(image[scalar_names[si]]) {
            _fault("invalid scalar " + scalar_names[si]);
        }
        si = si + 1;
    }
    let function_arrays = ["original_function_ids", "function_arity",
    "function_min_arity", "function_max_local", "function_upvalue_count",
    "function_instruction_start", "function_instruction_count",
    "function_default_start", "function_default_count"];
    let i = 0;
    while i < len(function_arrays) {
        if len(_required_array(image, function_arrays[i])) != image.function_count {
            _fault("function array length mismatch");
        }
        i = i + 1;
    }
    if image.function_count < 1 or image.function_count > max_functions
    or image.entry_function < 0 or image.entry_function >= image.function_count {
        _fault("invalid function table bounds");
    }
    let opcodes = _required_array(image, "opcodes");
    let operands = _required_array(image, "operands");
    let capture_starts = _required_array(image, "instruction_capture_start");
    let capture_counts = _required_array(image, "instruction_capture_count");
    if image.instruction_count < 1 or image.instruction_count > max_instructions
    or len(opcodes) != image.instruction_count or len(operands) != image.instruction_count
    or len(capture_starts) != image.instruction_count
    or len(capture_counts) != image.instruction_count {
        _fault("invalid instruction table bounds");
    }
    let constant_kinds = _required_array(image, "constant_kinds");
    let constant_i32 = _required_array(image, "constant_i32");
    let constant_functions = _required_array(image, "constant_functions");
    if image.constant_count < 0 or image.constant_count > max_constants
    or len(constant_kinds) != image.constant_count
    or len(constant_i32) != image.constant_count
    or len(constant_functions) != image.constant_count {
        _fault("invalid constant table bounds");
    }
    let capture_is_local = _required_array(image, "capture_is_local");
    let capture_indices = _required_array(image, "capture_indices");
    if image.capture_count < 0 or image.capture_count > max_captures
    or len(capture_is_local) != image.capture_count
    or len(capture_indices) != image.capture_count {
        _fault("invalid capture table bounds");
    }
    let defaults = _required_array(image, "default_constants");
    if image.default_count < 0 or image.default_count > max_defaults
    or len(defaults) != image.default_count {
        _fault("invalid default table bounds");
    }
    let entry_args = _required_array(image, "entry_arg_constants");
    if image.entry_arg_count < 0 or image.entry_arg_count > image.max_stack
    or len(entry_args) != image.entry_arg_count {
        _fault("invalid entry argument table bounds");
    }
    let numeric_arrays = [image.original_function_ids, image.function_arity,
    image.function_min_arity, image.function_max_local,
    image.function_upvalue_count, image.function_instruction_start,
    image.function_instruction_count, image.function_default_start,
    image.function_default_count, opcodes, operands, capture_starts,
    capture_counts, capture_is_local, capture_indices, constant_kinds,
    constant_i32, constant_functions, defaults, entry_args];
    i = 0;
    while i < len(numeric_arrays) {
        let ni = 0;
        while ni < len(numeric_arrays[i]) {
            if not _integer(numeric_arrays[i][ni]) { _fault("non-integer table value"); }
            ni = ni + 1;
        }
        i = i + 1;
    }

    let next_instruction = 0; let next_default = 0; let original_seen = map{}; let fi = 0;
    while fi < image.function_count {
        let original_key = str(image.original_function_ids[fi]);
        if image.original_function_ids[fi] < 0 or map_has(original_seen, original_key)
        or image.function_arity[fi] < 0
        or image.function_min_arity[fi] < 0
        or image.function_min_arity[fi] > image.function_arity[fi]
        or image.function_max_local[fi] < image.function_arity[fi]
        or image.function_upvalue_count[fi] < 0
        or image.function_instruction_start[fi] != next_instruction
        or image.function_instruction_count[fi] < 1
        or image.function_instruction_start[fi] + image.function_instruction_count[fi]
            > image.instruction_count
        or image.function_default_start[fi] != next_default
        or image.function_default_count[fi] < 0
        or image.function_default_count[fi] > image.function_arity[fi]
        or image.function_default_start[fi] + image.function_default_count[fi]
            > image.default_count {
            _fault("invalid function record");
        }
        original_seen[original_key] = true;
        next_instruction = next_instruction + image.function_instruction_count[fi];
        next_default = next_default + image.function_default_count[fi];
        fi = fi + 1;
    }
    if next_instruction != image.instruction_count or next_default != image.default_count {
        _fault("non-canonical function ranges");
    }

    i = 0;
    while i < image.constant_count {
        let kind = constant_kinds[i];
        if kind < 0 or kind > 3 { _fault("invalid constant kind"); }
        if kind == 1 and (constant_i32[i] < -2147483648
        or constant_i32[i] > 2147483647) { _fault("i32 constant out of range"); }
        if kind == 2 and constant_i32[i] != 0 and constant_i32[i] != 1 {
            _fault("invalid boolean constant");
        }
        if (kind == 0 or kind == 3) and constant_i32[i] != 0 {
            _fault("non-canonical constant payload");
        }
        if kind == 3 and (constant_functions[i] < 0
        or constant_functions[i] >= image.function_count
        or image.function_upvalue_count[constant_functions[i]] != 0) {
            _fault("invalid function constant");
        }
        if kind != 3 and constant_functions[i] != -1 {
            _fault("non-function constant has function target");
        }
        i = i + 1;
    }
    i = 0;
    while i < image.default_count {
        if defaults[i] < 0 or defaults[i] >= image.constant_count
        or constant_kinds[defaults[i]] == 3 { _fault("invalid default constant"); }
        i = i + 1;
    }
    i = 0;
    while i < image.entry_arg_count {
        if entry_args[i] < 0 or entry_args[i] >= image.constant_count {
            _fault("invalid entry argument constant");
        }
        i = i + 1;
    }
    if image.entry_arg_count < image.function_min_arity[image.entry_function]
    or image.entry_arg_count > image.function_arity[image.entry_function] {
        _fault("entry argument arity mismatch");
    }

    let next_capture = 0; fi = 0;
    while fi < image.function_count {
        let local_ip = 0;
        while local_ip < image.function_instruction_count[fi] {
            let absolute = image.function_instruction_start[fi] + local_ip;
            let op = opcodes[absolute]; let operand = operands[absolute];
            if not Calls.supports_opcode(op) { _fault("unsupported opcode"); }
            if op == 0 and (operand < 0 or operand >= image.constant_count) {
                _fault("constant operand out of range");
            } elif (op == 25 or op == 26) and (operand < 0
            or operand >= image.function_max_local[fi]) {
                _fault("local operand out of range");
            } elif op == 27 {
                if operand < 0 or operand >= image.function_count {
                    _fault("closure target out of range");
                }
                let start = capture_starts[absolute]; let count = capture_counts[absolute];
                if start != next_capture or count != image.function_upvalue_count[operand]
                or start + count > image.capture_count { _fault("capture range mismatch"); }
                let ci = 0;
                while ci < count {
                    let slot = start + ci; let index = capture_indices[slot];
                    if capture_is_local[slot] != 0 and capture_is_local[slot] != 1 {
                        _fault("invalid capture locality");
                    }
                    if index < 0
                    or (capture_is_local[slot] == 1
                    and index >= image.function_max_local[fi])
                    or (capture_is_local[slot] == 0
                    and index >= image.function_upvalue_count[fi]) {
                        _fault("capture index out of range");
                    }
                    ci = ci + 1;
                }
                next_capture = next_capture + count;
            } elif (op == 28 or op == 29) and (operand < 0
            or operand >= image.function_upvalue_count[fi]) {
                _fault("upvalue operand out of range");
            } elif (op == 31 or op == 32) and (operand < 0 or operand > image.max_stack) {
                _fault("call arity out of range");
            } elif (op == 35 or op == 36 or op == 37) and (operand < 0
            or operand > image.function_instruction_count[fi]) {
                _fault("jump target out of range");
            }
            let has_operand = op == 0 or op == 25 or op == 26 or op == 27
                or op == 28 or op == 29 or op == 31 or op == 32
                or op == 35 or op == 36 or op == 37;
            if not has_operand and operand != -1 {
                _fault("non-canonical sentinel operand");
            }
            if op != 27 and (capture_starts[absolute] != -1
            or capture_counts[absolute] != 0) {
                _fault("non-closure instruction has captures");
            }
            local_ip = local_ip + 1;
        }
        fi = fi + 1;
    }
    if next_capture != image.capture_count { _fault("non-canonical capture ranges"); }
    if not is_number(image.expected_value) or image.expected_value != num_floor(image.expected_value)
    or image.expected_value < -2147483648 or image.expected_value > 2147483647
    or image.observed_steps < 1 or image.observed_peak_frames < 1
    or image.observed_peak_stack < 1 or image.observed_peak_locals < 0
    or image.observed_closures < 1 or image.observed_tail_calls < 0
    or image.max_steps < 1 or image.max_frames < 1 or image.max_stack < 1
    or image.max_locals < 1 or image.max_total_locals < 1 or image.max_closures < 1
    or image.observed_steps > image.max_steps
    or image.observed_peak_frames > image.max_frames
    or image.observed_peak_stack > image.max_stack
    or image.observed_peak_locals > image.max_total_locals
    or image.observed_closures > image.max_closures {
        _fault("invalid oracle metrics");
    }
    let actual = checksum(image);
    if not map_has(image, "checksum") or image.checksum != actual {
        _fault("lowering checksum mismatch");
    }
    return map{ format: FORMAT, ok: true, checksum: actual,
        functions: image.function_count, instructions: image.instruction_count,
        constants: image.constant_count, captures: image.capture_count,
        defaults: image.default_count, expected_value: image.expected_value,
        peak_frames: image.observed_peak_frames };
}

fn _add_value(state, value) {
    let kind = -1; let i32 = 0; let target = -1;
    if value == nil { kind = 0; }
    elif is_number(value) and value == num_floor(value)
    and value >= -2147483648 and value <= 2147483647 { kind = 1; i32 = value; }
    elif is_bool(value) { kind = 2; i32 = if value { 1 } else { 0 }; }
    elif _is_function(value) {
        kind = 3; let old_target = value.__pbck_function_id;
        if old_target < 0 or old_target >= len(state.function_dense)
        or state.function_dense[old_target] < 0 { _fault("function constant is not reachable"); }
        target = state.function_dense[old_target];
    } else { _fault("constant is outside exact-i32 lowering ABI"); }
    let dense = len(state.constant_kinds);
    array_push(state.constant_kinds, kind); array_push(state.constant_i32, i32);
    array_push(state.constant_functions, target);
    return dense;
}

fn _add_constant(state, program, old_slot) {
    let key = str(old_slot);
    if map_has(state.constant_dense, key) { return state.constant_dense[key]; }
    if old_slot < 0 or old_slot >= len(program.values) { _fault("constant slot out of range"); }
    let dense = _add_value(state, program.values[old_slot]);
    state.constant_dense[key] = dense;
    return dense;
}

fn build(verified, options = nil) {
    if options != nil and not is_map(options) { _fault("options must be a map"); }
    if not is_map(verified) or not map_has(verified, "format")
    or verified.format != Calls.VERIFIED_I32_FORMAT or not (try verified.ok catch false)
    or not map_has(verified, "program") { _fault("verified i32 graph required"); }
    let max_functions = _limit(options, "max_functions", 4096, 4096);
    let max_instructions = _limit(options, "max_instructions", 65536, 1048576);
    let max_constants = _limit(options, "max_constants", 65536, 1048576);
    let max_captures = _limit(options, "max_captures", 65536, 1048576);
    let max_defaults = _limit(options, "max_defaults", 65536, 1048576);
    let rechecked = Calls.verify_i32_prepared(verified.program, verified.function_id,
    verified.args, map{ max_steps: verified.limits.max_steps,
        max_frames: verified.limits.max_frames, max_stack: verified.limits.max_stack,
        max_locals: verified.limits.max_locals,
        max_total_locals: verified.limits.max_total_locals,
        max_closures: verified.limits.max_closures });
    if rechecked.value != verified.value
    or rechecked.reachable_functions != verified.reachable_functions
    or rechecked.reachable_instructions != verified.reachable_instructions
    or rechecked.captures != verified.captures
    or rechecked.observed_steps != verified.observed_steps
    or rechecked.observed_peak_frames != verified.observed_peak_frames
    or rechecked.observed_peak_stack != verified.observed_peak_stack
    or rechecked.observed_peak_locals != verified.observed_peak_locals
    or rechecked.observed_closures != verified.observed_closures
    or rechecked.observed_tail_calls != verified.observed_tail_calls {
        _fault("verified graph changed during lowering");
    }
    if rechecked.reachable_function_count > max_functions
    or rechecked.reachable_instructions > max_instructions
    or rechecked.captures > max_captures { _fault("verified graph exceeds lowering limits"); }

    let program = rechecked.program; let function_dense = []; let i = 0;
    while i < len(program.functions) { array_push(function_dense, -1); i = i + 1; }
    i = 0;
    while i < len(rechecked.reachable_functions) {
        function_dense[rechecked.reachable_functions[i]] = i; i = i + 1;
    }
    let state = map{ function_dense: function_dense, constant_dense: map{},
        constant_kinds: [], constant_i32: [], constant_functions: [] };
    let original_ids = []; let arity = []; let min_arity = []; let max_local = [];
    let upvalues = []; let instruction_start = []; let instruction_count = [];
    let default_start = []; let default_count = []; let opcodes = []; let operands = [];
    let capture_start = []; let capture_count = []; let capture_is_local = [];
    let capture_indices = []; let defaults = [];
    let dense_id = 0;
    while dense_id < len(rechecked.reachable_functions) {
        let old_id = rechecked.reachable_functions[dense_id];
        let function = program.functions[old_id];
        array_push(original_ids, old_id); array_push(arity, function.arity);
        array_push(min_arity, function.min_arity); array_push(max_local, function.max_local);
        array_push(upvalues, _required_upvalues(program, old_id));
        array_push(instruction_start, len(opcodes));
        array_push(instruction_count, function.instruction_count);
        let local_ip = 0;
        while local_ip < function.instruction_count {
            let absolute = function.instruction_start + local_ip;
            let op = program.opcodes[absolute]; let operand = program.operands[absolute];
            array_push(opcodes, op);
            if op == 0 { operand = _add_constant(state, program, operand); }
            elif op == 27 {
                if operand < 0 or operand >= len(function_dense)
                or function_dense[operand] < 0 { _fault("closure target is not reachable"); }
                operand = function_dense[operand];
            }
            array_push(operands, operand);
            if op == 27 {
                let old_start = program.instruction_capture_starts[absolute];
                let count = program.instruction_capture_counts[absolute];
                array_push(capture_start, len(capture_indices));
                array_push(capture_count, count); let ci = 0;
                while ci < count {
                    let slot = old_start + ci;
                    array_push(capture_is_local,
                        if program.capture_is_local[slot] { 1 } else { 0 });
                    array_push(capture_indices, program.capture_indices[slot]); ci = ci + 1;
                }
            } else { array_push(capture_start, -1); array_push(capture_count, 0); }
            local_ip = local_ip + 1;
        }
        array_push(default_start, len(defaults));
        array_push(default_count, function.default_count); let di = 0;
        while di < function.default_count {
            array_push(defaults, _add_constant(state, program,
                program.default_slots[function.default_start + di]));
            di = di + 1;
        }
        dense_id = dense_id + 1;
    }
    if len(state.constant_kinds) > max_constants or len(defaults) > max_defaults
    or len(capture_indices) > max_captures { _fault("lowered tables exceed limits"); }
    let entry_args = []; i = 0;
    while i < len(rechecked.args) {
        array_push(entry_args, _add_value(state, rechecked.args[i])); i = i + 1;
    }
    if len(state.constant_kinds) > max_constants {
        _fault("entry arguments exceed constant limit");
    }
    let dense_entry = function_dense[rechecked.function_id];
    if dense_entry < 0 { _fault("entry function is not reachable"); }
    let image = map{ format: FORMAT, version: VERSION, entry_function: dense_entry,
        function_count: len(original_ids), entry_arg_count: len(entry_args),
        entry_arg_constants: entry_args, instruction_count: len(opcodes),
        constant_count: len(state.constant_kinds), capture_count: len(capture_indices),
        default_count: len(defaults), original_function_ids: original_ids,
        function_arity: arity, function_min_arity: min_arity,
        function_max_local: max_local, function_upvalue_count: upvalues,
        function_instruction_start: instruction_start,
        function_instruction_count: instruction_count,
        function_default_start: default_start, function_default_count: default_count,
        opcodes: opcodes, operands: operands,
        instruction_capture_start: capture_start,
        instruction_capture_count: capture_count,
        capture_is_local: capture_is_local, capture_indices: capture_indices,
        constant_kinds: state.constant_kinds, constant_i32: state.constant_i32,
        constant_functions: state.constant_functions, default_constants: defaults,
        expected_value: rechecked.value, observed_steps: rechecked.observed_steps,
        observed_peak_frames: rechecked.observed_peak_frames,
        observed_peak_stack: rechecked.observed_peak_stack,
        observed_peak_locals: rechecked.observed_peak_locals,
        observed_closures: rechecked.observed_closures,
        observed_tail_calls: rechecked.observed_tail_calls,
        max_steps: rechecked.limits.max_steps, max_frames: rechecked.limits.max_frames,
        max_stack: rechecked.limits.max_stack, max_locals: rechecked.limits.max_locals,
        max_total_locals: rechecked.limits.max_total_locals,
        max_closures: rechecked.limits.max_closures, checksum: 0 };
    image.checksum = checksum(image);
    validate(image, map{ max_functions: max_functions,
        max_instructions: max_instructions, max_constants: max_constants,
        max_captures: max_captures, max_defaults: max_defaults });
    return freeze(image);
}

export FORMAT, VERSION, checksum, validate, build;
