// stdlib/workflow.sapp — a node-based workflow engine (n8n-style).
//
// Idea harvested from n8n (~/n8n-codex): describe work as a directed graph of typed
// NODES; the engine runs them in topological order, feeding each node the output(s) of
// its predecessors. The node functions are pure pblang you register; the engine owns
// ordering, data flow, fan-in, and cycle safety. No side effects of its own.
//
//   let W = import("stdlib/workflow.sapp");
//   let wf = W.new();
//   W.register(wf, "add", fn(input, params) { return input + params.n; });
//   W.add_node(wf, "a", "add", map{ n: 5 });
//   W.add_node(wf, "b", "add", map{ n: 1 });
//   W.connect(wf, "a", "b");
//   W.run(wf, 10);            // {a: 15, b: 16}  (entry node 'a' is seeded with 10)
//
// A node with 0 predecessors is an entry and receives the run() seed; with 1, it
// receives that predecessor's output; with >1, it receives the LIST of their outputs
// (in connection order) so the node function decides how to merge.

fn new() { return map{ types: map{}, nodes: [], edges: [] }; }

// register(wf, type_name, f) — define a node type. f is fn(input, params) -> output.
fn register(wf, type_name, f) { wf.types[type_name] = f; return wf; }

fn _find_node(wf, id) {
    for i len(wf.nodes) { if wf.nodes[i].id == id { return wf.nodes[i]; } }
    return nil;
}
fn has_node(wf, id) { return _find_node(wf, id) != nil; }

// add_node(wf, id, type_name, params) — instantiate a node; unknown type / dup id throw.
fn add_node(wf, id, type_name, params) {
    if not map_has(wf.types, type_name) { throw "workflow: unknown node type '" + str(type_name) + "'"; }
    if has_node(wf, id) { throw "workflow: duplicate node id '" + str(id) + "'"; }
    array_push(wf.nodes, map{ id: id, type: type_name, params: params });
    return wf;
}

// connect(wf, from_id, to_id) — wire from -> to; unknown endpoints throw.
fn connect(wf, from_id, to_id) {
    if not has_node(wf, from_id) { throw "workflow: unknown node '" + str(from_id) + "'"; }
    if not has_node(wf, to_id) { throw "workflow: unknown node '" + str(to_id) + "'"; }
    array_push(wf.edges, map{ from: from_id, to: to_id });
    return wf;
}

fn node_count(wf) { return len(wf.nodes); }
fn edge_count(wf) { return len(wf.edges); }
fn node_ids(wf) {
    let out = [];
    for i len(wf.nodes) { array_push(out, wf.nodes[i].id); }
    return out;
}

// predecessors of `id`, in edge-insertion order (defines fan-in order).
fn _preds(wf, id) {
    let out = [];
    for i len(wf.edges) { if wf.edges[i].to == id { array_push(out, wf.edges[i].from); } }
    return out;
}

// Kahn topological sort. Returns the emitted order; on a cycle it emits fewer than all.
fn _kahn(wf) {
    let indeg = map{};
    let outgoing = map{};
    for i len(wf.nodes) {
        indeg[wf.nodes[i].id] = 0;
        outgoing[wf.nodes[i].id] = [];
    }
    // Preserve connection order and repeated edges while visiting each edge once.
    for edge in wf.edges {
        indeg[edge.to] = indeg[edge.to] + 1;
        array_push(outgoing[edge.from], edge.to);
    }
    let queue = [];
    for i len(wf.nodes) { let id = wf.nodes[i].id; if indeg[id] == 0 { array_push(queue, id); } }
    let order = [];
    let qi = 0;
    while qi < len(queue) {
        let id = queue[qi];
        qi = qi + 1;
        array_push(order, id);
        for to in outgoing[id] {
            indeg[to] = indeg[to] - 1;
            if indeg[to] == 0 { array_push(queue, to); }
        }
    }
    return order;
}

// has_cycle(wf) — true when the graph cannot be fully ordered.
fn has_cycle(wf) { return len(_kahn(wf)) != len(wf.nodes); }

// topo_order(wf) — the execution order; throws on a cycle.
fn topo_order(wf) {
    let order = _kahn(wf);
    if len(order) != len(wf.nodes) { throw "workflow: cycle detected"; }
    return order;
}

// run(wf, seed) — execute the whole graph; returns map of node_id -> output.
fn run(wf, seed) {
    let order = topo_order(wf);   // throws on cycle before any node runs
    let results = map{};
    for i len(order) {
        let id = order[i];
        let node = _find_node(wf, id);
        let preds = _preds(wf, id);
        let input = seed;                             // 0 predecessors -> the seed
        if len(preds) == 1 { input = results[preds[0]]; }
        if len(preds) > 1 {
            input = [];
            for p len(preds) { array_push(input, results[preds[p]]); }
        }
        let f = wf.types[node.type];
        results[id] = f(input, node.params);
    }
    return results;
}

export new, register, add_node, connect, has_node, node_ids;
export node_count, edge_count, topo_order, has_cycle, run;
