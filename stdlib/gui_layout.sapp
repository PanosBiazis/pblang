// Rebuild per operation: callers may add/remove/rename/reorder public widgets.
// First matching name wins, exactly as GUI.get does. No persistent stale cache.
fn index(widgets) {
    let out=map{};
    for widget in widgets {
        if not map_has(out,widget.name) { out[widget.name]=widget; }
    }
    return out;
}
fn apply(form, records, widgets = nil) {
    if widgets==nil { widgets=index(form.widgets); }
    for record in records {
        if map_has(widgets,record.name) {
            let widget=widgets[record.name];
            widget.x=record.x; widget.y=record.y;
            widget.w=record.w; widget.h=record.h;
        }
    }
    form.layout_records=records;
    return form;
}
export index,apply;
