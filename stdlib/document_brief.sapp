// Compose detached selected sources as one standard Writer document.
let D=import("stdlib:text_document.sapp");let E=import("stdlib:document_excerpt.sapp");
let MAX_SOURCES=4;
fn create(documents,title,selections=nil) {
 if type(documents)!="array" or len(documents)<2 or len(documents)>MAX_SOURCES {throw "brief needs 2-4 sources";}
 if type(title)!="string" or len(title)>256 or str_trim(title)=="" {throw "brief needs a title";}
 let out=D.create(title);out.blocks=[];
 if selections!=nil and (type(selections)!="array" or len(selections)!=len(documents)) {throw "brief selections must match sources";}
 let chosen=[];let count=0;let bytes=len(str_to_bytes(title));
 for i in range(0,len(documents)) {
  let source=documents[i];D.validate(source);let indices=[];
  if selections==nil {for j in range(0,len(source.blocks)) {array_push(indices,j);}} else {indices=selections[i];}
  let selected=E.select(source,indices);let heading="Source "+str(i+1)+": "+selected.title;
  count=count+1+len(selected.blocks);bytes=bytes+len(str_to_bytes(heading));
  for block in selected.blocks {bytes=bytes+len(str_to_bytes(block.text));}
  if count>D.MAX_BLOCKS or bytes>D.MAX_TOTAL_BYTES {throw "brief exceeds Writer limits; select fewer blocks";}
  array_push(chosen,map{heading:heading,document:selected});
 }
 for source in chosen {
  array_push(out.blocks,map{kind:"heading",text:source.heading});
  for block in source.document.blocks {array_push(out.blocks,map{kind:block.kind,text:block.text});}
 }
 D.validate(out);return out;
}
export MAX_SOURCES,create;
