// stdlib/polyglot_router.sapp - deterministic, security-aware language routing.
// Resolves aliases, language names, and filenames without invoking a toolchain.

let REGISTRY = import("stdlib:polyglot_registry.sapp");
let GUARD = import("stdlib:polyglot_guard.sapp");
let PATH = import("stdlib:path.sapp");
let MAX_TARGET_BYTES = 256;
let MAX_TASK_BYTES = 4096;

fn _result(ok, language, source, reason) {
    return map{
        format: "pblang.polyglot.route.v1",
        ok: ok,
        language: language,
        source: source,
        reason: reason,
    };
}

// resolve(target) accepts a canonical language, alias, extension, or filename.
fn resolve(target) {
    if target == nil { return _result(false, nil, "none", "missing_target"); }
    if type(target) != "string" or len(str_to_bytes(target)) > MAX_TARGET_BYTES {
        return _result(false, nil, "none", "invalid_target");
    }
    let raw = str_lower(str_trim(str(target)));
    if raw == "" { return _result(false, nil, "none", "empty_target"); }

    let canonical = REGISTRY.alias(raw);
    if REGISTRY.is_supported(canonical) {
        return _result(true, canonical, if canonical == raw { "language" } else { "alias" }, "resolved");
    }

    let ext = PATH.extension(raw);
    if ext == "" and str_starts_with(raw, ".") and len(raw) > 1 {
        ext = str_slice(raw, 1, len(raw));
    }
    if ext == "" { ext = raw; }
    let language = REGISTRY.lang_for_ext(ext);
    if language != nil { return _result(true, language, "extension", "resolved"); }
    return _result(false, nil, "unknown", "unsupported_target");
}

// route(target, task) resolves target first and falls back to task recommendation.
fn route(target, task = nil) {
    let direct = resolve(target);
    if direct.ok or task == nil { return direct; }
    if type(task) != "string" or len(str_to_bytes(task)) > MAX_TASK_BYTES {
        return _result(false, nil, "task", "invalid_task");
    }
    if str_trim(task) == "" { return direct; }
    let recommendation = REGISTRY.best_for(task);
    return map{
        format: "pblang.polyglot.route.v1",
        ok: true,
        language: recommendation.recommended,
        source: "task",
        reason: recommendation.reason,
    };
}

// plan(...) performs the deterministic safety decision but never executes code.
// This is an analysis planner, not an authority source. `sandbox_ready` is kept
// as a compatibility declaration but can never make a plan executable.
fn plan(target, code, mode = "secure", task = nil, sandbox_ready = false) {
    if mode != "secure" and mode != "sandbox" and mode != "audit"
       and mode != "unrestricted" and mode != "report" {
        return map{
            format: "pblang.polyglot.plan.v1", ok: false, allowed: false,
            language: nil, mode: mode, route: nil, scan: nil,
            reason: "invalid_mode",
        };
    }
    let selected = route(target, task);
    if not selected.ok {
        return map{
            format: "pblang.polyglot.plan.v1", ok: false, allowed: false,
            language: nil, mode: mode, route: selected, scan: nil,
            reason: selected.reason,
        };
    }

    if code != nil and type(code) != "string" {
        return map{
            format: "pblang.polyglot.plan.v1", ok: false, allowed: false,
            executable: false, language: selected.language, mode: mode,
            route: selected, scan: nil, reason: "invalid_code",
            sandbox_declared: false, sandbox_verified: false, sandbox_ready: false,
        };
    }

    let sandbox_declared = type(sandbox_ready) == "bool" and sandbox_ready;
    let assessment = GUARD.scan(if code == nil { "" } else { code }, selected.language);
    let analyzed = mode == "report";
    let policy_permits = (assessment.safe and mode == "secure" and sandbox_declared)
        or mode == "audit" or (mode == "sandbox" and sandbox_declared)
        or mode == "unrestricted";
    let allowed = false;
    let decision_reason = "blocked_by_policy";
    if analyzed {
        decision_reason = "report_only";
    } elif policy_permits {
        decision_reason = "execution_authority_required";
    } elif (mode == "secure" or mode == "sandbox") and not sandbox_declared {
        decision_reason = "sandbox_required";
    }
    return map{
        format: "pblang.polyglot.plan.v1",
        ok: true,
        allowed: allowed,
        analyzed: true,
        executable: allowed,
        language: selected.language,
        mode: mode,
        policy_permits: policy_permits,
        sandbox_declared: sandbox_declared,
        sandbox_verified: false,
        sandbox_ready: false,
        route: selected,
        scan: assessment,
        reason: decision_reason,
    };
}

export resolve, route, plan;
