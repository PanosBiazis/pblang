// stdlib/polyglot_router.sapp - deterministic, security-aware language routing.
// Resolves aliases, language names, and filenames without invoking a toolchain.

let REGISTRY = import("stdlib:polyglot_registry.sapp");
let GUARD = import("stdlib:polyglot_guard.sapp");
let POLICY = import("stdlib:polyglot_policy.sapp");
let PATH = import("stdlib:path.sapp");

fn _result(ok, language, source, reason) {
    return map{
        format: "pblang.polyglot.route.v1",
        ok: ok,
        language: language,
        source: source,
        reason: reason,
    };
}

// resolve(target) accepts a canonical language, alias, extension, or filename.
fn resolve(target) {
    if target == nil { return _result(false, nil, "none", "missing_target"); }
    let raw = str_lower(str_trim(str(target)));
    if raw == "" { return _result(false, nil, "none", "empty_target"); }

    let canonical = REGISTRY.alias(raw);
    if REGISTRY.is_supported(canonical) {
        return _result(true, canonical, if canonical == raw { "language" } else { "alias" }, "resolved");
    }

    let ext = PATH.extension(raw);
    if ext == "" and str_starts_with(raw, ".") and len(raw) > 1 {
        ext = str_slice(raw, 1, len(raw));
    }
    if ext == "" { ext = raw; }
    let language = REGISTRY.lang_for_ext(ext);
    if language != nil { return _result(true, language, "extension", "resolved"); }
    return _result(false, nil, "unknown", "unsupported_target");
}

// route(target, task) resolves target first and falls back to task recommendation.
fn route(target, task = nil) {
    let direct = resolve(target);
    if direct.ok or task == nil or str_trim(str(task)) == "" { return direct; }
    let recommendation = REGISTRY.best_for(task);
    return map{
        format: "pblang.polyglot.route.v1",
        ok: true,
        language: recommendation.recommended,
        source: "task",
        reason: recommendation.reason,
    };
}

// plan(...) performs the deterministic safety decision but never executes code.
fn plan(target, code, mode = "secure", task = nil) {
    if not POLICY.is_mode(mode) {
        return map{
            format: "pblang.polyglot.plan.v1", ok: false, allowed: false,
            language: nil, mode: mode, route: nil, scan: nil,
            reason: "invalid_mode",
        };
    }
    let selected = route(target, task);
    if not selected.ok {
        return map{
            format: "pblang.polyglot.plan.v1", ok: false, allowed: false,
            language: nil, mode: mode, route: selected, scan: nil,
            reason: selected.reason,
        };
    }

    let assessment = GUARD.scan(if code == nil { "" } else { str(code) }, selected.language);
    let allowed = assessment.safe or mode == "audit" or mode == "sandbox" or mode == "unrestricted" or mode == "report";
    let decision_reason = "blocked_by_policy";
    if allowed {
        if assessment.safe { decision_reason = "safe"; }
        else { decision_reason = "mode_allows_unsafe"; }
    }
    return map{
        format: "pblang.polyglot.plan.v1",
        ok: true,
        allowed: allowed,
        language: selected.language,
        mode: mode,
        route: selected,
        scan: assessment,
        reason: decision_reason,
    };
}

export resolve, route, plan;
