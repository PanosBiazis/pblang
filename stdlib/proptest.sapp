// stdlib/proptest.sapp — property-based testing (QuickCheck-style).
//
// A property is a fn taking ONE argument: the array of generated values.
// It fails a case by returning false or by throwing.
//
//   let P = import("stdlib:proptest.sapp");
//   let r = P.for_all_seeded([P.int(0, 1000)], fn(a) { return a[0] * 2 >= a[0]; }, 100, 42);
//   // r = map{ ok: true, cases: 100, seed: 42 }
//   // on failure: map{ ok: false, seed, case, args, shrunk } — `shrunk` is the
//   // greedily minimized counterexample; rerun with the same seed to reproduce.
//
// Generators are maps { gen: fn(g) -> value, shrink: fn(v) -> [smaller...] }.
// Shrink candidates must differ from the input value — the runner also guards
// against equal candidates so shrinking always terminates.

let R = import("stdlib:random.sapp");
let TIME = import("stdlib:time.sapp");

let _MAX_SHRINK_STEPS = 500;

// ── generators ────────────────────────────────────────────────────────────────

// int(lo, hi) — integer in [lo, hi] inclusive; shrinks toward the in-range
// point closest to 0.
fn int(lo, hi) {
    return map{
        gen: fn(g) { return R.randint(g, lo, hi); },
        shrink: fn(v) {
            let zero = 0;
            if lo > 0 { zero = lo; }
            if hi < 0 { zero = hi; }
            let out = [];
            if v != zero { array_push(out, zero); }
            if v > zero {
                let half = zero + num_floor((v - zero) / 2);
                if half != v and half != zero { array_push(out, half); }
                if v - 1 != zero { array_push(out, v - 1); }
            }
            if v < zero {
                let half = zero - num_floor((zero - v) / 2);
                if half != v and half != zero { array_push(out, half); }
                if v + 1 != zero { array_push(out, v + 1); }
            }
            return out;
        }
    };
}

// float(lo, hi) — float in [lo, hi); shrinks toward the in-range point
// closest to 0.0 (bisection, bounded by the runner's step cap).
fn float(lo, hi) {
    return map{
        gen: fn(g) { return R.uniform(g, lo, hi); },
        shrink: fn(v) {
            let zero = 0.0;
            if lo > 0.0 { zero = lo; }
            if hi < 0.0 { zero = hi; }
            let out = [];
            if v != zero { array_push(out, zero); }
            let mid = (v + zero) / 2;
            if mid != v and mid != zero { array_push(out, mid); }
            return out;
        }
    };
}

// bool() — true/false; true shrinks to false.
fn bool() {
    return map{
        gen: fn(g) {
            if R.bernoulli(g, 0.5) == 1 { return true; }
            return false;
        },
        shrink: fn(v) {
            if v == true { return [false]; }
            return [];
        }
    };
}

let _CHARSET = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _-";

// string_of(max_len) — string of 0..max_len charset characters; shrinks by
// emptying, halving, then dropping the last character.
fn string_of(max_len) {
    return map{
        gen: fn(g) {
            let n = R.randint(g, 0, max_len);
            let s = "";
            let i = 0;
            while i < n {
                let k = R.randint(g, 0, len(_CHARSET) - 1);
                s = s + str_slice(_CHARSET, k, k + 1);
                i = i + 1;
            }
            return s;
        },
        shrink: fn(v) {
            let n = len(v);
            if n == 0 { return []; }
            let out = [""];
            let half = num_floor(n / 2);
            if half > 0 and half < n { array_push(out, str_slice(v, 0, half)); }
            if n > 1 { array_push(out, str_slice(v, 0, n - 1)); }
            return out;
        }
    };
}

// array_of(inner, max_len) — array of 0..max_len values from `inner`;
// shrinks by emptying, halving, dropping the last element, and shrinking
// individual elements in place.
fn array_of(inner, max_len) {
    return map{
        gen: fn(g) {
            let n = R.randint(g, 0, max_len);
            let out = [];
            let i = 0;
            while i < n {
                array_push(out, inner.gen(g));
                i = i + 1;
            }
            return out;
        },
        shrink: fn(v) {
            let n = len(v);
            if n == 0 { return []; }
            let out = [[]];
            let half = num_floor(n / 2);
            if half > 0 and half < n {
                let h = [];
                let i = 0;
                while i < half { array_push(h, v[i]); i = i + 1; }
                array_push(out, h);
            }
            if n > 1 {
                let d = [];
                let i = 0;
                while i < n - 1 { array_push(d, v[i]); i = i + 1; }
                array_push(out, d);
            }
            let i = 0;
            while i < n {
                let cands = inner.shrink(v[i]);
                let j = 0;
                while j < len(cands) {
                    let cp = [];
                    let k = 0;
                    while k < n { array_push(cp, v[k]); k = k + 1; }
                    cp[i] = cands[j];
                    array_push(out, cp);
                    j = j + 1;
                }
                i = i + 1;
            }
            return out;
        }
    };
}

// one_of(values) — one of the given literal values; shrinks toward the first.
fn one_of(values) {
    return map{
        gen: fn(g) { return R.choice(g, values); },
        shrink: fn(v) {
            if len(values) > 0 and v != values[0] { return [values[0]]; }
            return [];
        }
    };
}

// map_of(spec) — map with the same keys as `spec`, each value drawn from the
// corresponding generator; shrinks one field at a time.
fn map_of(spec) {
    return map{
        gen: fn(g) {
            let out = map{};
            let keys = map_keys(spec);
            let i = 0;
            while i < len(keys) {
                let k = keys[i];
                out[k] = spec[k].gen(g);
                i = i + 1;
            }
            return out;
        },
        shrink: fn(v) {
            let out = [];
            let keys = map_keys(spec);
            let i = 0;
            while i < len(keys) {
                let k = keys[i];
                let cands = spec[k].shrink(v[k]);
                let j = 0;
                while j < len(cands) {
                    let cp = map{};
                    let m = 0;
                    while m < len(keys) {
                        let kk = keys[m];
                        cp[kk] = v[kk];
                        m = m + 1;
                    }
                    cp[k] = cands[j];
                    array_push(out, cp);
                    j = j + 1;
                }
                i = i + 1;
            }
            return out;
        }
    };
}

// ── runner ────────────────────────────────────────────────────────────────────

// A case fails when the property throws or returns false; nil (any
// statement-bodied fn) and true both count as passing.
fn _fails(prop, args) {
    let o = try map{ ok: true, value: prop(args) } catch map{ ok: false, value: nil };
    if o.ok == false { return true; }
    return o.value == false;
}

fn _copy_args(args) {
    let out = [];
    let i = 0;
    while i < len(args) { array_push(out, args[i]); i = i + 1; }
    return out;
}

// Greedy shrink: repeatedly try each argument's shrink candidates, keeping
// any candidate that still fails, until nothing improves or the step cap.
fn _shrink(gens, args, prop) {
    let cur = _copy_args(args);
    let steps = 0;
    let improved = true;
    while improved and steps < _MAX_SHRINK_STEPS {
        improved = false;
        let i = 0;
        while i < len(gens) {
            let cands = gens[i].shrink(cur[i]);
            let j = 0;
            while j < len(cands) {
                if steps >= _MAX_SHRINK_STEPS { return cur; }
                if cands[j] != cur[i] {
                    let trial = _copy_args(cur);
                    trial[i] = cands[j];
                    steps = steps + 1;
                    if _fails(prop, trial) {
                        cur = trial;
                        improved = true;
                        j = len(cands);
                    } else {
                        j = j + 1;
                    }
                } else {
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }
    return cur;
}

// for_all_seeded(gens, prop, cases, seed) — deterministic run; on failure the
// counterexample is shrunk and the seed is echoed back for reproduction.
fn for_all_seeded(gens, prop, cases, seed) {
    let g = R.seed(seed);
    let n = 0;
    while n < cases {
        let args = [];
        let i = 0;
        while i < len(gens) {
            array_push(args, gens[i].gen(g));
            i = i + 1;
        }
        if _fails(prop, args) {
            let shrunk = _shrink(gens, args, prop);
            return map{ ok: false, seed: seed, case: n, args: args, shrunk: shrunk };
        }
        n = n + 1;
    }
    return map{ ok: true, cases: cases, seed: seed };
}

// for_all(gens, prop) — 100 cases with a time-derived seed (echoed in the
// result so failures stay reproducible).
fn for_all(gens, prop) {
    return for_all_seeded(gens, prop, 100, num_floor(TIME.now_ms()));
}

// check(gens, prop, cases, seed) — like for_all_seeded but raises on failure,
// for direct use inside test files.
fn check(gens, prop, cases, seed) {
    let r = for_all_seeded(gens, prop, cases, seed);
    if r.ok == false {
        return error("proptest: property failed (seed " + str(r.seed) + ", case "
                     + str(r.case) + "), shrunk counterexample: " + str(r.shrunk));
    }
    return r;
}

export int, float, bool, string_of, array_of, one_of, map_of,
       for_all, for_all_seeded, check;
