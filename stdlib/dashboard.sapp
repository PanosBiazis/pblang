// stdlib/dashboard.sapp — a GUI dashboard (built on stdlib:gui.sapp) that surfaces the
// Watchers (stdlib:watch.sapp) and the Master Control safety core (stdlib:master_control).
//
// build() composes the form and is headless-testable; refresh(f) re-reads live data into
// the labels; run() opens a window and drives the event loop. Click handlers wire the
// buttons to the real subsystems (Refresh -> watchers, Kill/Lock -> master control), so
// the dashboard is a live control panel, not a mockup.
//
//   let d = import("stdlib:dashboard.sapp");
//   d.run();

let gui   = import("stdlib:gui.sapp");
let watch = import("stdlib:watch.sapp");
let mc    = import("stdlib:master_control.sapp");
let perc  = import("stdlib:perception.sapp");
let ic    = import("stdlib:input_control.sapp");
let il    = import("stdlib:img_load.sapp");

// Tracks the most recent pending capability request so the approval widget knows
// which subsystem (perception vs input) owns the id to run.
let _pending = map{ id: nil, source: "" };

fn _line(name, x, y) { return gui.label(name, x, y, ""); }

// pblang can't assign to a call-result's field (gui.get(f,n).text = v), so bind first.
fn _set(f, name, text) { let w = gui.get(f, name); if w != nil { w.text = text; } }

fn _mc_word(s) {
    if s.killed { return "KILLED (human reset required)"; }
    if s.active { return "UNLOCKED / ACTIVE"; }
    return "LOCKED (human unlock required)";
}

// Pull live data from the watchers + master control into the dashboard's labels.
fn refresh(f) {
    let snap = watch.capture_all();
    let comp = snap.compute;
    let h = snap.heap;
    _set(f, "l_cpu",  "CPU threads: " + str(try comp.cpu_threads catch "?"));
    _set(f, "l_gpu",  "GPU available: " + str(try comp.gpu_available catch "?"));
    _set(f, "l_heap", "Heap: str=" + str(try h.string_allocs catch 0) +
                      " arr=" + str(try h.array_allocs catch 0) +
                      " map=" + str(try h.map_allocs catch 0));
    _set(f, "l_mem",  "Mem locations: " + str(try snap.memory.total_locations catch 0));
    _set(f, "l_time", "Snapshot @ " + str(snap.time_ms) + " ms");
    _set(f, "l_probes", "Watcher probes: " + str(len(watch.probes())) +
                        "  sampling: " + str(len(watch.sample_modes())) + " modes");
    let s = mc.status();
    _set(f, "l_mc_status",  "Status: " + _mc_word(s));
    _set(f, "l_mc_session", "active=" + str(s.active) + "  killed=" + str(s.killed) +
                            "  env_enabled=" + str(s.env_enabled) + "  pending=" + str(s.pending));
    _set(f, "l_insp", "watch.inspect(path) / binary(path) / media(path) - read-only");
    let pb = perc.backends();
    _set(f, "l_percept", "backends: screenshot=" + str(pb.screenshot) + "  ocr=" + str(pb.ocr) + "  audio=" + str(pb.audio));
    let ib = ic.backends();
    _set(f, "l_input", "enabled=" + str(ib.enabled) + " (PB_INPUT_CONTROL)  xdotool=" + str(ib.xdotool) + "  ydotool=" + str(ib.ydotool));
    return f;
}

// ── button handlers (receive the form) ───────────────────────────────────────
fn _on_refresh(f) { refresh(f); }
fn _on_kill(f) { mc.kill(); refresh(f); }
fn _on_lock(f) { mc.lock(); refresh(f); }
fn _on_screen(f) {
    let r = perc.screen();
    let msg = "screen capture -> " + r.status;
    if r.status == "pending" {
        _pending.id = r.id; _pending.source = "perception";
        msg = msg + " (id " + str(r.id) + "): enter nonce and Approve + Run";
    } else { msg = msg + ": " + str(try r.reason catch ""); }
    _set(f, "l_percept_status", msg);
}
fn _on_type(f) {
    let r = ic.type_text("hello from the dashboard");
    let msg = "type request -> " + r.status;
    if r.status == "pending" {
        _pending.id = r.id; _pending.source = "input";
        msg = msg + " (id " + str(r.id) + "): enter nonce and Approve + Run";
    } else { msg = msg + ": " + str(try r.reason catch ""); }
    _set(f, "l_input_status", msg);
}
// Render up to 4 sampled frames as a metadata strip (the pblang GUI has no image
// widget, so a frame "preview" shows index / availability / dimensions / timestamp).
fn _render_frames(f, frames) {
    let i = 0;
    while i < 4 {
        let key = "l_frame_" + str(i);
        if i < len(frames) {
            let fr = frames[i];
            let dims = "-";
            if (try fr.width catch nil) != nil { dims = str(fr.width) + "x" + str(fr.height); }
            _set(f, key, "frame " + str(i) + ": available=" + str(try fr.available catch "?") +
                          "  dims=" + dims + "  tool=" + str(try fr.tool catch "-"));
        } else { _set(f, key, ""); }
        i = i + 1;
    }
    // Load the first available frame as a real pixel thumbnail into the image widget.
    let iw = gui.get(f, "preview_img");
    if iw != nil {
        iw.img = nil;
        let j = 0;
        while j < len(frames) {
            let p = try frames[j].path catch nil;
            if p != nil and (try frames[j].available catch false) and iw.img == nil {
                let thumb = il.to_thumbnail(p, 248, 158);
                if thumb != nil { iw.img = thumb; }
            }
            j = j + 1;
        }
    }
}

fn _on_sample(f) {
    let r = perc.screen_sampling(4, 250);
    let msg = "sample 4 frames -> " + r.status;
    if r.status == "pending" {
        _pending.id = r.id; _pending.source = "perception";
        msg = msg + " (id " + str(r.id) + "): enter nonce and Approve + Run to capture";
    } else { msg = msg + ": " + str(try r.reason catch ""); }
    _set(f, "l_preview_status", msg);
}

fn _on_approve(f) {
    if _pending.id == nil { _set(f, "l_approve", "approve: no pending request"); return nil; }
    let w = gui.get(f, "nonce");
    let nonce = "";
    if w != nil { nonce = w.value; }
    let res = nil;
    if _pending.source == "input" { res = ic.run(_pending.id, nonce); }
    else { res = perc.run(_pending.id, nonce); }
    let msg = "approve id " + str(_pending.id) + ": ok=" + str(res.ok);
    if res.ok { msg = msg + " available=" + str(try res.result.available catch "?"); }
    else { msg = msg + " - " + str(try res.reason catch ""); }
    _set(f, "l_approve", msg);
    if res.ok {
        let rr = try res.result catch nil;
        if rr != nil and map_has(rr, "frames") {
            _render_frames(f, rr.frames);
            _set(f, "l_preview_status", "captured " + str(len(rr.frames)) + " frames");
        }
    }
    _pending.id = nil; _pending.source = "";
    refresh(f);
}

fn build() {
    let f = gui.form("pblang — Watchers + Master Control + Perception + Input", 760, 1064);

    gui.add(f, gui.panel("p_sys", 16, 16, 360, 156, "System / Compute"));
    gui.add(f, _line("l_cpu", 28, 52));
    gui.add(f, _line("l_gpu", 28, 78));
    gui.add(f, _line("l_heap", 28, 104));
    gui.add(f, _line("l_mem", 28, 130));

    gui.add(f, gui.panel("p_watch", 392, 16, 352, 156, "Watchers"));
    gui.add(f, _line("l_time", 404, 52));
    gui.add(f, _line("l_probes", 404, 78));
    gui.add(f, gui.button("b_refresh", 404, 116, 150, 32, "Refresh", _on_refresh));

    gui.add(f, gui.panel("p_mc", 16, 188, 728, 150, "Master Control (local-only, human-gated)"));
    gui.add(f, _line("l_mc_status", 28, 222));
    gui.add(f, _line("l_mc_session", 28, 248));
    gui.add(f, gui.button("b_kill", 28, 288, 180, 32, "KILL SWITCH", _on_kill));
    gui.add(f, gui.button("b_lock", 224, 288, 150, 32, "Lock", _on_lock));
    // Approval widget: enter the unlock nonce and run the latest pending capability.
    gui.add(f, _line("l_approve", 392, 218));
    gui.add(f, gui.label("l_nonce_lbl", 392, 244, "nonce:"));
    gui.add(f, gui.textbox("nonce", 470, 240, 262, 28, ""));
    gui.add(f, gui.button("b_approve", 392, 288, 200, 32, "Approve + Run pending", _on_approve));
    _set(f, "l_approve", "approve a pending screen/input request here");

    gui.add(f, gui.panel("p_insp", 16, 354, 728, 150, "Inspect / Reverse Engineer"));
    gui.add(f, _line("l_insp", 28, 390));
    gui.add(f, _line("l_hint", 28, 416));
    _set(f, "l_hint", "Actuation requires human unlock + per-action approval; malicious actions are always denied.");

    gui.add(f, gui.panel("p_percept", 16, 520, 728, 150, "Perception (screen / OCR / audio - gated)"));
    gui.add(f, _line("l_percept", 28, 554));
    gui.add(f, _line("l_percept_status", 28, 580));
    gui.add(f, gui.button("b_screen", 28, 618, 220, 32, "Request Screen Capture", _on_screen));
    _set(f, "l_percept_status", "requests go through Master Control (unlock + approval required)");

    gui.add(f, gui.panel("p_input", 16, 690, 728, 150, "Input Control (keyboard/mouse - strictest gates)"));
    gui.add(f, _line("l_input", 28, 724));
    gui.add(f, _line("l_input_status", 28, 750));
    gui.add(f, gui.button("b_type", 28, 788, 220, 32, "Request Type Text", _on_type));
    _set(f, "l_input_status", "needs PB_INPUT_CONTROL=1 + unlock + per-action approval; malicious text always denied");

    gui.add(f, gui.panel("p_preview", 16, 850, 728, 204, "Live Preview - sampled screen frames (gated)"));
    gui.add(f, _line("l_preview_status", 28, 884));
    gui.add(f, _line("l_frame_0", 28, 912));
    gui.add(f, _line("l_frame_1", 28, 936));
    gui.add(f, _line("l_frame_2", 28, 960));
    gui.add(f, _line("l_frame_3", 28, 984));
    gui.add(f, gui.image("preview_img", 480, 884, 248, 158, nil));   // real pixel preview
    gui.add(f, gui.button("b_sample", 28, 1014, 240, 32, "Sample 4 Frames (preview)", _on_sample));
    _set(f, "l_preview_status", "sampling routes through Master Control (unlock + approval); frames appear after approval");

    refresh(f);
    return f;
}

fn run() { return gui.run(build()); }

export build, refresh, run;
