// stdlib/keymap.sapp — map graphics keydown names to characters, in pblang.
//
// `gfxpollevents` reports keys by name ("A", "Space", "Num1", "Period", …) plus a Shift
// state from LShift/RShift keydown/keyup. This turns (key, shift) into the character it
// types — uppercase letters and shifted symbols included. Pure function → testable in
// the VM. Used by the pblang-native IDE (editors/ide/pbide.sapp).

let _DIGITS = map{
    "Num0": ["0", ")"], "Num1": ["1", "!"], "Num2": ["2", "@"], "Num3": ["3", "#"],
    "Num4": ["4", "$"], "Num5": ["5", "%"], "Num6": ["6", "^"], "Num7": ["7", "&"],
    "Num8": ["8", "*"], "Num9": ["9", "("]
};
let _PUNCT = map{
    "Period": [".", ">"], "Comma": [",", "<"], "Semicolon": [";", ":"], "Slash": ["/", "?"],
    "Minus": ["-", "_"], "Equals": ["=", "+"], "LeftBracket": ["[", "{"], "RightBracket": ["]", "}"],
    "Backslash": ["\\", "|"], "Quote": ["'", "\""], "Backquote": ["`", "~"], "Space": [" ", " "]
};

// key_to_char(key, shift) -> the typed character, or "" if `key` is not a typing key.
fn key_to_char(key, shift) {
    if len(key) == 1 {
        let c = strcharcodeat(key, 0);
        if c >= 65 and c <= 90 {           // letter "A".."Z"
            if shift { return key; }
            return str_lower(key);
        }
    }
    if map_has(_DIGITS, key) { let p = _DIGITS[key]; if shift { return p[1]; } return p[0]; }
    if map_has(_PUNCT, key)  { let p = _PUNCT[key];  if shift { return p[1]; } return p[0]; }
    return "";
}

fn is_shift(key) { return key == "LShift" or key == "RShift"; }

export key_to_char, is_shift;
