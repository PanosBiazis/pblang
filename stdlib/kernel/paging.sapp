// stdlib/kernel/paging.sapp — virtual memory (x86 32-bit paging), in pblang.
// pblang:target=kernel — lowered by compiler/ctranspile.sapp; the freestanding
// preamble provides the OS intrinsics used below (see diagnostics.sapp pragmas).
//
// The last core protected-mode mechanism: a two-level page table (page directory →
// page tables → 4 KiB pages) that maps virtual addresses to physical, so a kernel can
// give each process its own address space, protect pages, and enable demand paging.
// This module is the LANGUAGE readiness — the reusable primitives to build and install
// page tables; an actual VM subsystem is the kernel author's to build on top.
//
//   fn kmain() {
//     let pd = page_alloc(); pd_init(pd);
//     let pt = page_alloc(); pt_identity(pt, 0);   // identity-map the first 4 MiB
//     pd_set(pd, 0, pt);
//     paging_enable(pd);                            // CR3 = pd, CR0.PG = 1
//   }
//
// Lower with `transpile_kernel_int`. Page directory / tables must be 4 KiB aligned —
// `page_alloc` handles that. All pblang.

// page_alloc() — a fresh 4 KiB-aligned, 4 KiB page from the bump heap (over-allocate
// and round the base up; the bump allocator is only 8-byte aligned).
fn page_alloc() {
    let raw = kmalloc(8192);
    return bit_and(raw + 4095, bit_not(4095));
}

// pd_init(pd) — clear a page directory (all entries not-present).
fn pd_init(pd) {
    let i = 0;
    while i < 1024 { poke32(pd + i * 4, 0); i = i + 1; }
}

// pd_set(pd, idx, pt) — point directory entry `idx` (covering 4 MiB of virtual space)
// at page table `pt`, present + writable (low flag bits 0x3).
fn pd_set(pd, idx, pt) {
    poke32(pd + idx * 4, bit_or(pt, 3));
}

// pt_identity(pt, base_phys) — fill a page table so its 1024 pages map identically to
// physical [base_phys, base_phys + 4 MiB), present + writable.
fn pt_identity(pt, base_phys) {
    let i = 0;
    while i < 1024 {
        poke32(pt + i * 4, bit_or(base_phys + i * 4096, 3));
        i = i + 1;
    }
}

// pt_map(pt, idx, phys, flags) — map a single page (table entry `idx`) to `phys` with
// the given flags (e.g. 3 = present+rw, 7 = present+rw+user).
fn pt_map(pt, idx, phys, flags) {
    poke32(pt + idx * 4, bit_or(bit_and(phys, bit_not(4095)), flags));
}

// paging_enable(pd) — install the directory in CR3 and turn paging on.
fn paging_enable(pd) {
    set_cr3(pd);
    enable_paging();
}

export page_alloc, pd_init, pd_set, pt_identity, pt_map, paging_enable;
