// stdlib/kernel/gdt.sapp — GDT + TSS primitives for privilege separation, in pblang.
// pblang:target=kernel — lowered by compiler/ctranspile.sapp; the freestanding
// preamble provides the OS intrinsics used below (see diagnostics.sapp pragmas).
//
// The facilities a kernel needs to run code at ring 3 (usermode): a Global Descriptor
// Table with kernel + USER code/data segments, and a Task State Segment so that a
// ring3→ring0 trap (interrupt/syscall) switches to a kernel stack (TSS esp0/ss0). With
// these plus the `enter_user` intrinsic and a DPL-3 syscall gate, a kernel author can
// drop to usermode and service syscalls. (This module is the LANGUAGE readiness — the
// reusable primitives; the kernel/OS is the author's to build on top.)
//
// Standard flat layout (selector = index*8):
//   1 (0x08) kernel code   2 (0x10) kernel data
//   3 (0x1B) user code      4 (0x23) user data     5 (0x28) TSS
// Kernel selectors match GRUB's, so no CS reload is needed after `lgdt`.
//
// Lower with `transpile_kernel_int`. All pblang.

// gdt_set_entry(gdt, idx, base, limit, access, gran) — encode one 8-byte descriptor.
fn gdt_set_entry(gdt, idx, base, limit, access, gran) {
    let e = gdt + idx * 8;
    poke16(e + 0, bit_and(limit, 65535));
    poke16(e + 2, bit_and(base, 65535));
    poke8(e + 4, bit_and(bit_shr(base, 16), 255));
    poke8(e + 5, access);
    poke8(e + 6, bit_or(bit_and(bit_shr(limit, 16), 15), bit_and(gran, 240)));
    poke8(e + 7, bit_and(bit_shr(base, 24), 255));
}

// gdt_build(gdt, tss_base) — fill the standard 6 descriptors. Access bytes:
//   0x9A kernel code, 0x92 kernel data, 0xFA user code, 0xF2 user data, 0x89 TSS.
//   gran 0xCF = 4 KiB, 32-bit for segments; 0x00 for the byte-granular TSS.
fn gdt_build(gdt, tss_base) {
    gdt_set_entry(gdt, 0, 0, 0, 0, 0);
    gdt_set_entry(gdt, 1, 0, 1048575, 154, 207);     // 0x9A / 0xCF  kernel code
    gdt_set_entry(gdt, 2, 0, 1048575, 146, 207);     // 0x92 / 0xCF  kernel data
    gdt_set_entry(gdt, 3, 0, 1048575, 250, 207);     // 0xFA / 0xCF  user code
    gdt_set_entry(gdt, 4, 0, 1048575, 242, 207);     // 0xF2 / 0xCF  user data
    gdt_set_entry(gdt, 5, tss_base, 103, 137, 0);    // 0x89 TSS, limit 103
}

// gdt_load(gdt, num_entries) — build the GDTR (limit + base) and load it.
fn gdt_load(gdt, num_entries) {
    let gdtr = kmalloc(8);
    poke16(gdtr, num_entries * 8 - 1);
    poke32(gdtr + 2, gdt);
    lgdt(gdtr);
}

// tss_init(tss, esp0, ss0) — zero a TSS and set the ring-0 stack used on a privilege
// switch into the kernel (ss0 is the kernel data selector, e.g. 0x10).
fn tss_init(tss, esp0, ss0) {
    let i = 0;
    while i < 104 { poke8(tss + i, 0); i = i + 1; }
    poke32(tss + 4, esp0);    // esp0
    poke32(tss + 8, ss0);     // ss0
}

// tss_load() — load the task register with the TSS selector (0x28).
fn tss_load() { ltr(40); }

export gdt_set_entry, gdt_build, gdt_load, tss_init, tss_load;
