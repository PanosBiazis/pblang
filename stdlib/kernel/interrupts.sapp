// stdlib/kernel/interrupts.sapp — IDT + PIC + keyboard primitives, in pblang.
// pblang:target=kernel — lowered by compiler/ctranspile.sapp; the freestanding
// preamble provides the OS intrinsics used below (see diagnostics.sapp pragmas).
//
// The building blocks that make INTERRUPT-DRIVEN kernel code writable in pblang:
// install gates into an Interrupt Descriptor Table, load it (`lidt`), remap the
// PIC, ack interrupts (EOI), and read a keyboard scancode. Interrupt HANDLERS are
// ordinary pblang functions named `isr...` — `ctranspile` emits them with the
// GCC interrupt attribute (proper prologue/epilogue + `iret`); install one with
// `idt_set_gate(idt, vec, addr_of("isr_kbd"), 8, 142)`. Written in the
// freestanding-transpilable subset (numbers, bitwise, intrinsics); concatenate
// with your kmain and pass to `transpile_kernel`.
//
//   fn isr_kbd() { let sc = kbd_scancode(); /* ...handle... */ pic_eoi(); }
//   fn kmain() {
//     let idt = kmalloc(2048);
//     pic_remap();
//     idt_set_gate(idt, 33, addr_of("isr_kbd"), 8, 142);   // IRQ1 = vector 0x21
//     idt_load(idt);
//     sti();                                               // enable interrupts
//     while 1 > 0 { hlt(); }
//   }
//
// Implemented entirely in pblang.

// idt_set_gate — write one 8-byte IDT gate at idt_base + vec*8.
//   handler = 32-bit handler address (use addr_of("isr_..."))
//   sel     = code selector (0x08 = 8 under GRUB's GDT)
//   flags   = type/attributes (0x8E = 142: present, ring 0, 32-bit interrupt gate)
fn idt_set_gate(idt_base, vec, handler, sel, flags) {
    let base = idt_base + vec * 8;
    poke16(base, bit_and(handler, 65535));                       // offset 0..15
    poke16(base + 2, sel);                                       // segment selector
    poke8(base + 4, 0);                                          // reserved
    poke8(base + 5, flags);                                      // type + attributes
    poke16(base + 6, bit_and(bit_shr(handler, 16), 65535));      // offset 16..31
}

// idt_load — build the IDTR (limit + base) and load it with `lidt`.
fn idt_load(idt_base) {
    let idtr = kmalloc(8);
    poke16(idtr, 2047);             // limit = 256*8 - 1
    poke32(idtr + 2, idt_base);     // base address
    lidt(idtr);
}

// pic_remap — remap the 8259 PIC so IRQ0..15 land on vectors 0x20..0x2F (away
// from the CPU exception vectors), then unmask all lines.
fn pic_remap() {
    outb(32, 17);  outb(160, 17);   // ICW1: begin init (cascade, ICW4)
    outb(33, 32);  outb(161, 40);   // ICW2: master->0x20, slave->0x28
    outb(33, 4);   outb(161, 2);    // ICW3: cascade wiring (IRQ2)
    outb(33, 1);   outb(161, 1);    // ICW4: 8086 mode
    outb(33, 0);   outb(161, 0);    // unmask all IRQs
}

// pic_mask(master, slave) — set the PIC interrupt masks (1 bit = that IRQ disabled).
// `pic_remap` unmasks everything; a kernel that only handles some IRQs MUST mask the
// rest, or a stray IRQ (e.g. the free-running PIT on IRQ0) vectors to an uninstalled
// IDT gate and triple-faults. E.g. only the keyboard (IRQ1): pic_mask(253, 255)
// (253 = 0xFD = all master IRQs masked except bit 1).
fn pic_mask(master, slave) { outb(33, master); outb(161, slave); }

// pic_eoi — signal End-Of-Interrupt to the master PIC (call at the end of an IRQ
// handler). For IRQ8..15 the slave (0xA0) also needs an EOI.
fn pic_eoi() { outb(32, 32); }
fn pic_eoi_slave() { outb(160, 32); outb(32, 32); }

// kbd_scancode — read a scancode from the keyboard controller data port (0x60).
fn kbd_scancode() { return inb(96); }

// kbd_status — read the keyboard controller status port (0x64). Bit 0 = output
// buffer full (a byte is ready to read).
fn kbd_status() { return inb(100); }

export idt_set_gate, idt_load, pic_remap, pic_mask, pic_eoi, pic_eoi_slave;
export kbd_scancode, kbd_status;
