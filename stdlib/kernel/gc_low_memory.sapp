// pblang:target=kernel
// pblang:extern _kernel_memory_enter _kernel_memory_leave _guarded_heap_free_from _guarded_gc_alloc _guarded_gc_add_root _guarded_heap_free _guarded_kernel_gc_collect
// Optional low-memory operations for the precise kernel collector. Concatenate
// heap.sapp and gc.sapp first. Ordinary GC/allocator behavior stays unchanged.
// Valid owned pointers/metadata and explicit roots are the base kernel contract.
// With roots present, prove every owned node is a leaf or single edge before
// changing marks. Unsupported rooted topology returns -1.
// The caller holds the memory lock, so topology cannot change after admission.
fn _guarded_gc_collect_chains(g) {
    // No roots means no survivors, regardless of topology. The existing path
    // needs no scratch and retains this same lock through all frees.
    let nr = peek32(g + 24);
    if nr == 0 { return _guarded_kernel_gc_collect(g); }
    let heap = peek32(g); let n = peek32(g + 16);
    let objs = peek32(g + 20);
    let i = 0;
    // Batch admission only; every owner is still checked before any marks.
    while i + 3 < n {
        if peek32(peek32(objs + i * 4) + 4) > 1 { return 0 - 1; }
        if peek32(peek32(objs + (i + 1) * 4) + 4) > 1 { return 0 - 1; }
        if peek32(peek32(objs + (i + 2) * 4) + 4) > 1 { return 0 - 1; }
        if peek32(peek32(objs + (i + 3) * 4) + 4) > 1 { return 0 - 1; }
        i = i + 4;
    }
    while i < n {
        if peek32(peek32(objs + i * 4) + 4) > 1 { return 0 - 1; }
        i = i + 1;
    }
    let generation = peek32(g + 44);
    if generation >= 2147483647 {
        i = 0;
        while i < n { poke32(peek32(objs + i * 4), 0); i = i + 1; }
        generation = 1;
    } else { generation = generation + 1; }
    poke32(g + 44, generation);
    let roots = peek32(g + 28); let marked = 0; i = 0;
    while i < nr {
        let obj = peek32(roots + i * 4);
        while obj != 0 and peek32(obj) != generation {
            if marked >= n { return 0 - 1; }
            poke32(obj, generation); marked = marked + 1;
            if peek32(obj + 4) == 0 { break; }
            obj = peek32(obj + 8);
        }
        i = i + 1;
    }
    let keep = n;
    if marked < n {
        keep = 0; let cursor = 0; i = 0;
        while i < n {
            let obj = peek32(objs + i * 4);
            if peek32(obj) == generation { poke32(objs + keep * 4, obj); keep = keep + 1; }
            else { cursor = _guarded_heap_free_from(heap, obj, cursor); }
            i = i + 1;
        }
    }
    poke32(g + 16, keep); poke32(g + 12, 0);
    poke32(g + 32, peek32(g + 32) + 1); return 0;
}

// Explicit collection/debug entry. Returns 0 on success, -1 for unsupported
// rooted topology/admission failure. Rootless graphs accept any child count.
// No scratch allocation or change to auto policy.
fn kernel_gc_collect_low_memory(g) {
    let flags = _kernel_memory_enter();
    let result = _guarded_gc_collect_chains(g);
    _kernel_memory_leave(flags); return result;
}
// The selected allocator first uses normal allocation. Only a valid failed
// request with auto collection enabled may reclaim and retry, under one lock.
fn _guarded_gc_alloc_low_memory(g, nchildren) {
    if nchildren < 0 or nchildren > 536870905 { return 0; }
    let obj = _guarded_gc_alloc(g, nchildren);
    if obj == 0 and peek32(g + 4) == 1 {
        if _guarded_gc_collect_chains(g) == 0 {
            // The graph was just collected under this same lock. With a zero
            // threshold, ordinary allocation would collect again.
            // Suppress only that retry's auto trigger, then restore before any
            // return/root publication/unlock, including allocation failure.
            // The internal allocator has no callbacks or exception exits.
            poke32(g + 4, 0);
            obj = _guarded_gc_alloc(g, nchildren);
            poke32(g + 4, 1);
        }
    }
    return obj;
}
fn gc_alloc_low_memory(g, nchildren) {
    let flags = _kernel_memory_enter();
    let obj = _guarded_gc_alloc_low_memory(g, nchildren);
    _kernel_memory_leave(flags); return obj;
}
// Publish the new root before unlock; unwind an unpublished allocation if root
// registration cannot grow. This mirrors the existing atomic publication API.
fn gc_alloc_rooted_low_memory(g, nchildren) {
    let flags = _kernel_memory_enter();
    let obj = _guarded_gc_alloc_low_memory(g, nchildren);
    if obj != 0 {
        if _guarded_gc_add_root(g, obj) == 0 {
            poke32(g + 16, peek32(g + 16) - 1);
            _guarded_heap_free(peek32(g), obj); obj = 0;
        }
    }
    _kernel_memory_leave(flags); return obj;
}
export kernel_gc_collect_low_memory, gc_alloc_low_memory, gc_alloc_rooted_low_memory;
