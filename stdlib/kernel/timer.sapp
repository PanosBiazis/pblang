// stdlib/kernel/timer.sapp — the 8253/8254 Programmable Interval Timer (PIT), in pblang.
//
// The PIT raises IRQ0 at a fixed rate, the heartbeat every OS needs: preemptive
// scheduling, timekeeping, timeouts. Channel 0 is wired to IRQ0 (vector 0x20 = 32
// after `pic_remap`). Program it with a divisor of the 1193182 Hz base clock:
//   rate_hz = 1193182 / divisor   (divisor 1..65535; 0 means 65536 ≈ 18.2 Hz)
//
// Install a handler and let it tick:
//   fn isr_timer() { /* ...tick... */ pic_eoi(); }   // EOI so the next IRQ can arrive
//   fn kmain() {
//     let idt = kmalloc(2048);
//     pic_remap();
//     idt_set_gate(idt, 32, addr_of("isr_timer"), 8, 142);  // IRQ0 -> vector 0x20
//     idt_load(idt);
//     pit_init(1193);     // ~1 kHz
//     sti();              // enable interrupts — IRQ0 now fires on its own
//     while 1 > 0 { hlt(); }
//   }
//
// Uses the OS intrinsics from the kernel preamble (outb / bitwise). All pblang.

// pit_init(divisor) — program PIT channel 0 in mode 3 (square wave), low-byte then
// high-byte. Command 0x36 (54) = channel 0, access lobyte/hibyte, mode 3, binary.
fn pit_init(divisor) {
    outb(67, 54);                                       // 0x43: mode/command register
    outb(64, bit_and(divisor, 255));                    // 0x40: divisor low byte
    outb(64, bit_and(bit_shr(divisor, 8), 255));        // 0x40: divisor high byte
}

// pit_divisor_for(hz) — the divisor that yields approximately `hz` ticks/sec. In the
// integer codegen mode (how kernels are built) `/` is integer division.
fn pit_divisor_for(hz) { return 1193182 / hz; }

export pit_init, pit_divisor_for;
