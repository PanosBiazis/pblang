// stdlib/kernel/syscall.sapp — a system-call trap mechanism, in pblang.
// pblang:target=kernel — lowered by compiler/ctranspile.sapp; the freestanding
// preamble provides the OS intrinsics used below (see diagnostics.sapp pragmas).
//
// The user/kernel boundary primitive: code traps into the kernel with `int 0x80`
// (vector 128), the kernel services the request and returns a result. This is what a
// usermode program would use to ask the kernel for I/O, memory, etc.
//
// ABI is MEMORY-BASED (num/arg/ret in three fixed cells) rather than register-based,
// because a GCC interrupt handler (`__attribute__((interrupt))`) hides the saved
// register frame — so the handler can't read eax/ebx directly. The caller writes the
// cells, traps, and reads the result cell; the handler reads/writes the same cells.
//
// Write the dispatcher as an `isr_syscall` handler and install it on vector 0x80:
//   fn isr_syscall() {
//     let n = sys_num(); let a = sys_arg();
//     if n == 1 { serial_putc(a); sys_return(0); }   // SYS_putc
//     else { sys_return(0 - 1); }                     // unknown -> -1
//   }
//   fn kmain() {
//     let idt = kmalloc(2048);
//     idt_set_gate(idt, 128, addr_of("isr_syscall"), 8, 142);  // DPL 0; use 238 (0xEE) for ring-3
//     idt_load(idt);
//     let r = sys_call(1, 65);   // putc 'A'
//   }
//
// Lower with `transpile_kernel_int`. All pblang.

// ── Fixed ABI cells (low scratch memory): num=0x9300, arg=0x9304, ret=0x9308 ──────────
fn sys_num() { return peek32(37632); }          // handler: requested syscall number
fn sys_arg() { return peek32(37636); }          // handler: the argument
fn sys_return(v) { poke32(37640, v); }          // handler: write the result

// sys_call(num, arg) — trap into the kernel and return the handler's result.
fn sys_call(num, arg) {
    poke32(37632, num);
    poke32(37636, arg);
    swint80();                                   // int 0x80 -> isr_syscall
    return peek32(37640);
}

export sys_num, sys_arg, sys_return, sys_call;
