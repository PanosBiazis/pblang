// stdlib/kernel/console.sapp — VGA text + serial console, written in pblang.
//
// The first real, useful KERNEL component in pblang: text output to the screen
// (VGA text mode at 0xB8000, 80×25) and to the serial port (COM1, 0x3F8). Written
// in the freestanding-transpilable subset (numbers, bitwise, the OS intrinsics
// poke16/peek8/outb/inb) so `ctranspile.transpile_kernel` lowers it to native
// code that runs in a booted kernel — no GC, no libc. Concatenate this source
// with your `kmain` and pass the whole thing to `transpile_kernel`.
//
//   serial_init();
//   serial_puts(some_string);          // print to COM1
//   vga_clear(15);                      // white-on-black
//   vga_puts(0, 0, some_string, 15);    // print at (row 0, col 0)
//
// Implemented entirely in pblang.

// ── VGA text mode (0xB8000, 80 cols × 25 rows, 2 bytes/cell: char + attribute) ──
fn vga_cell(row, col) { return 753664 + (row * 80 + col) * 2; }

// vga_putc — write char `ch` with attribute `attr` at (row, col). A cell is
// (attr << 8) | ch, written as one 16-bit store.
fn vga_putc(row, col, ch, attr) { poke16(vga_cell(row, col), attr * 256 + ch); }

// vga_clear — fill the whole screen with spaces of the given attribute.
fn vga_clear(attr) {
    let i = 0;
    while i < 2000 {
        poke16(753664 + i * 2, attr * 256 + 32);   // 32 = ' '
        i = i + 1;
    }
}

// vga_puts — write a null-terminated string at (row, col); returns the next free
// column. Reads bytes via peek8 until the 0 terminator.
fn vga_puts(row, col, s, attr) {
    let i = 0;
    let c = peek8(s);
    while c > 0 {
        poke16(vga_cell(row, col + i), attr * 256 + c);
        i = i + 1;
        c = peek8(s + i);
    }
    return col + i;
}

// ── Serial port (COM1 = 0x3F8 = 1016; status = 0x3FD = 1021) ───────────────────────
fn serial_init() {
    outb(1017, 0);     // disable interrupts
    outb(1019, 128);   // enable DLAB (set baud divisor)
    outb(1016, 1);     // divisor low  (115200)
    outb(1017, 0);     // divisor high
    outb(1019, 3);     // 8 bits, no parity, 1 stop
    outb(1018, 199);   // enable FIFO, clear, 14-byte threshold
    outb(1020, 11);    // IRQs enabled, RTS/DSR set
}

// serial_ready — nonzero when the transmit-holding register is empty (bit 5).
fn serial_ready() { return bit_and(inb(1021), 32); }

fn serial_putc(c) {
    let w = serial_ready();
    while w == 0 { w = serial_ready(); }
    outb(1016, c);
}

// serial_puts — write a null-terminated string to COM1.
fn serial_puts(s) {
    let i = 0;
    let c = peek8(s);
    while c > 0 {
        serial_putc(c);
        i = i + 1;
        c = peek8(s + i);
    }
}

export vga_cell, vga_putc, vga_clear, vga_puts;
export serial_init, serial_ready, serial_putc, serial_puts;
