// stdlib/kernel/keyboard.sapp — keyboard input facilities, in pblang.
//
// Two reusable kernel primitives layered on the raw §72 scancode read (`kbd_scancode`,
// inb 0x60): a SCANCODE RING BUFFER fed by the IRQ1 ISR (so the handler stays tiny and
// the consumer drains at its leisure), and a US scancode-set-1 → ASCII KEYMAP that
// turns make-codes into characters and ignores key releases. Together they let a task
// read typed lines. Lower with `transpile_kernel_int`.
//
//   fn isr_kbd() { kbd_push(THE_BUF, kbd_scancode()); pic_eoi(); }
//   ... in a task: let sc = kbd_pop(buf); if sc != -1 { let ch = kbd_ascii(km, sc); ... }
//
// All pblang.

// ── Scancode ring buffer ─────────────────────────────────────────────────────────────
// Layout (raw cells): +0 head  +4 tail  +8 capacity  +12 data pointer (byte array).
fn kbd_buf_new(capacity) {
    let b = kmalloc(16);
    poke32(b + 0, 0);
    poke32(b + 4, 0);
    poke32(b + 8, capacity);
    poke32(b + 12, kmalloc(capacity));
    return b;
}

// kbd_push(b, sc) — enqueue a scancode (called from the ISR). Drops if the buffer is
// full (a slot is kept empty to distinguish full from empty).
fn kbd_push(b, sc) {
    let cap = peek32(b + 8);
    let head = peek32(b + 0);
    let nh = head + 1;
    if nh >= cap { nh = 0; }
    if nh == peek32(b + 4) { return 0; }        // full → drop
    poke8(peek32(b + 12) + head, sc);
    poke32(b + 0, nh);
    return 0;
}

// kbd_pop(b) — dequeue a scancode, or -1 if the buffer is empty.
fn kbd_pop(b) {
    let tail = peek32(b + 4);
    if tail == peek32(b + 0) { return 0 - 1; }  // empty
    let sc = peek8(peek32(b + 12) + tail);
    let nt = tail + 1;
    if nt >= peek32(b + 8) { nt = 0; }
    poke32(b + 4, nt);
    return sc;
}

// ── US scancode-set-1 → ASCII keymap ─────────────────────────────────────────────────
// A 128-byte table: table[make_code] = ASCII (0 = no mapping). Release codes have the
// high bit set (>= 0x80), so `kbd_ascii` returns 0 for them.
fn kbd_keymap_new() {
    let t = kmalloc(128);
    let i = 0;
    while i < 128 { poke8(t + i, 0); i = i + 1; }
    // top letter row q..p
    poke8(t + 16, 113); poke8(t + 17, 119); poke8(t + 18, 101); poke8(t + 19, 114);
    poke8(t + 20, 116); poke8(t + 21, 121); poke8(t + 22, 117); poke8(t + 23, 105);
    poke8(t + 24, 111); poke8(t + 25, 112);
    // home row a..l
    poke8(t + 30, 97);  poke8(t + 31, 115); poke8(t + 32, 100); poke8(t + 33, 102);
    poke8(t + 34, 103); poke8(t + 35, 104); poke8(t + 36, 106); poke8(t + 37, 107);
    poke8(t + 38, 108);
    // bottom row z..m
    poke8(t + 44, 122); poke8(t + 45, 120); poke8(t + 46, 99);  poke8(t + 47, 118);
    poke8(t + 48, 98);  poke8(t + 49, 110); poke8(t + 50, 109);
    // digits 1..9 0
    poke8(t + 2, 49);  poke8(t + 3, 50);  poke8(t + 4, 51);  poke8(t + 5, 52);
    poke8(t + 6, 53);  poke8(t + 7, 54);  poke8(t + 8, 55);  poke8(t + 9, 56);
    poke8(t + 10, 57); poke8(t + 11, 48);
    poke8(t + 57, 32);    // space
    poke8(t + 28, 10);    // enter → newline
    poke8(t + 14, 8);     // backspace
    return t;
}

// kbd_ascii(t, sc) — the ASCII char for a scancode, or 0 (unmapped / a key release).
fn kbd_ascii(t, sc) {
    if sc >= 128 { return 0; }
    return peek8(t + sc);
}

export kbd_buf_new, kbd_push, kbd_pop, kbd_keymap_new, kbd_ascii;
