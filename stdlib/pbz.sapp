// stdlib/pbz.sapp — a self-contained LZSS (LZ77-family) compressor in pure pblang.
//
// HONEST SCOPE: this is a real, correct, dependency-free codec with good ratio on
// text/code and a fast, simple decoder. It is NOT a state-of-the-art compressor — it
// won't beat zstd/brotli/LZMA on ratio, and being interpreted, its *encoder* is slow on
// large inputs. It exists so pblang/storage has a built-in codec with zero dependencies;
// storage.sapp can plug in a faster/native backend when one is available.
//
// Format: [4-byte big-endian original length][groups]. Each group = 1 control byte then
// up to 8 tokens; control bit g (LSB-first) = 1 => token g is a match (2 bytes:
// 12-bit offset-1 + 4-bit length-3), 0 => literal (1 byte). Window 4096, match 3..18.

let WIN = 4096;
let MINM = 3;
let MAXM = 18;
let MAX_CHAIN = 32;   // match-finder effort (higher = better ratio, slower)

fn _as_bytes(data) {
    if type(data) == "string" { return str_to_bytes(data); }
    return data;
}

fn _key3(bytes, i) { return str(bytes[i] * 65536 + bytes[i + 1] * 256 + bytes[i + 2]); }

fn _insert(heads, k, pos) {
    if not map_has(heads, k) { heads[k] = []; }
    array_push(heads[k], pos);
}

// compress(data: string|bytes) -> byte array
fn compress(data) {
    let bytes = _as_bytes(data);
    let n = len(bytes);
    let out = [];
    array_push(out, bit_and(bit_shr(n, 24), 255));
    array_push(out, bit_and(bit_shr(n, 16), 255));
    array_push(out, bit_and(bit_shr(n, 8), 255));
    array_push(out, bit_and(n, 255));

    let heads = map{};
    let tokens = [];
    let i = 0;
    while i < n {
        let best_len = 0;
        let best_off = 0;
        if i + MINM <= n {
            let cand = try heads[_key3(bytes, i)] catch nil;
            if cand != nil {
                let ci = len(cand) - 1;
                let tries = 0;
                while ci >= 0 and tries < MAX_CHAIN {
                    let p = cand[ci];
                    if i - p <= WIN {
                        let l = 0;
                        while l < MAXM and i + l < n and bytes[p + l] == bytes[i + l] { l = l + 1; }
                        if l > best_len { best_len = l; best_off = i - p; }
                    }
                    ci = ci - 1;
                    tries = tries + 1;
                }
            }
        }
        if best_len >= MINM {
            array_push(tokens, map{ off: best_off, len: best_len });
            let j = 0;
            while j < best_len {
                if i + j + MINM <= n { _insert(heads, _key3(bytes, i + j), i + j); }
                j = j + 1;
            }
            i = i + best_len;
        } else {
            array_push(tokens, map{ lit: bytes[i] });
            if i + MINM <= n { _insert(heads, _key3(bytes, i), i); }
            i = i + 1;
        }
    }

    let t = 0;
    while t < len(tokens) {
        let ctrlb = 0;
        let g = 0;
        while g < 8 and t + g < len(tokens) {
            if map_has(tokens[t + g], "off") { ctrlb = bit_or(ctrlb, bit_shl(1, g)); }
            g = g + 1;
        }
        array_push(out, ctrlb);
        g = 0;
        while g < 8 and t + g < len(tokens) {
            let tok = tokens[t + g];
            if map_has(tok, "off") {
                let code = (tok.off - 1) * 16 + (tok.len - MINM);
                array_push(out, bit_and(bit_shr(code, 8), 255));
                array_push(out, bit_and(code, 255));
            } else {
                array_push(out, tok.lit);
            }
            g = g + 1;
        }
        t = t + 8;
    }
    return out;
}

// decompress(blob: bytes) -> byte array
fn decompress(blob) {
    let n = blob[0] * 16777216 + blob[1] * 65536 + blob[2] * 256 + blob[3];
    let out = [];
    let pos = 4;
    while len(out) < n {
        let ctrlb = blob[pos];
        pos = pos + 1;
        let g = 0;
        while g < 8 and len(out) < n {
            if bit_and(bit_shr(ctrlb, g), 1) == 1 {
                let code = blob[pos] * 256 + blob[pos + 1];
                pos = pos + 2;
                let off = bit_shr(code, 4) + 1;
                let l = bit_and(code, 15) + MINM;
                let start = len(out) - off;
                let k = 0;
                while k < l { array_push(out, out[start + k]); k = k + 1; }
            } else {
                array_push(out, blob[pos]);
                pos = pos + 1;
            }
            g = g + 1;
        }
    }
    return out;
}

// Convenience: string round-trip.
fn compress_str(s) { return compress(str_to_bytes(s)); }
fn decompress_str(blob) { return bytes_to_str(decompress(blob)); }

// ratio(original_len, compressed_len) -> compression ratio (orig/comp).
fn ratio(orig, comp) { if comp <= 0 { return 0; } return orig / comp; }

export compress, decompress, compress_str, decompress_str, ratio;
