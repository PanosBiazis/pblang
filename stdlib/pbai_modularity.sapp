// Fixed pbAI adapter bridge. Trusted packaged sources only; no user plugin paths.
fn _known(id) {return type(id)=="string" and (id=="sensor-v1" or id=="student-v1");}
// Walk the small expected schema, never arbitrary caller structure or callbacks.
fn _same(actual,expected) {
 if type(actual)!=type(expected) {return false;}
 if type(expected)=="map" {
  if len(actual)!=len(expected) {return false;}
  for key in map_keys(expected) {if not map_has(actual,key) or not _same(actual[key],expected[key]) {return false;}}
  return true;
 }
 if type(expected)=="array" {
  if len(actual)!=len(expected) {return false;}
  for i len(expected) {if not _same(actual[i],expected[i]) {return false;}}
  return true;
 }
 return actual==expected;
}
fn _sensor_contract() {
 return map{format:"pbai.sensor.contract.v1",profile:"uniform-linear-last-point.v1",
  min_samples:4,max_samples:256,max_abs_value:1000000,
  period_seconds_min:1,period_seconds_max:86400,period_seconds_integer:true,
  sigma_min:1,sigma_max:10,absolute_tolerance_min:0.000001,absolute_tolerance_max:1000000,
  required_fields:["values","period_seconds","sigma","absolute_tolerance"],
  implementation_kind:"deterministic-specialist",trained_model:false,
  uniform_sampling:"caller-declared-unverified",device_access:false,
  persistence:false,network:false,authorizes_action:false};
}
fn _student_contract() {
 return map{operations:["capabilities","predict_batch","compare"],
  transport:"in-process-map",model_scope:"fixed-tiny-token-specialist",
  checkpoint_format:"pbai.neural.student-checkpoint.v1",
  checkpoint_profile:"tiny-token-8-context-4-seed-77-rank-1-alpha-2-q6-v1",
  max_contexts:32,max_context_tokens:4,vocabulary_size:8,max_examples:32,
  required_fields:map{capabilities:["op"],predict_batch:["op","checkpoint","contexts","include_logits"],
   compare:["op","baseline","candidate","examples"]},
  training:false,activation:false,persistence:false,network:false,acceptance:false,
  artifact_authenticated:false,independent_provenance_verified:false,
  agi_status:"not-demonstrated",asi_status:"not-demonstrated"};
}
fn catalog() {
 return map{format:"pbai.modular.catalog.v1",runtime_checked:false,
  adapters:[map{id:"sensor-v1",interface:"pbai.sensor",version:"1.0.0",contract:_sensor_contract()},
   map{id:"student-v1",interface:"pbai.student-tool",version:"1.0.0",contract:_student_contract()}],
  loading:"explicit-selected-adapter-only",backend:"pure-pblang-cpu",
  execution_mode:"serial",workers_per_call:1,launches_workers:false,
  global_concurrency_enforced:false,arbitrary_plugins:false,authorizes_action:false};
}
fn _interface(id) {return if id=="sensor-v1" {"pbai.sensor"} else {"pbai.student-tool"};}
fn _resolved_plan(id,present,resolver) {
 let dependency=map{slot:"selected",module:id,version:"1.0.0",interface:_interface(id),
  interface_version:"1.0.0",optional:true,fallback:nil};
 let modules=[map{id:"pbai",version:"1.0.0",interfaces:map{},capabilities:[],dependencies:[dependency]}];
 if present {
  let interfaces=map{};interfaces[_interface(id)]="1.0.0";
  push(modules,map{id:id,version:"1.0.0",interfaces:interfaces,capabilities:[],dependencies:[]});
 }
 return resolver.resolve(map{format:"pblang.controlled-modularity.v1",modules:modules},"pbai",[]);
}
fn _plan(id,present) {let resolver=import("stdlib:controlled_modularity.sapp");return _resolved_plan(id,present,resolver);}
fn _load(id) {
 if id=="sensor-v1" {return try import("stdlib:pbai_sensor.sapp") catch nil;}
 return try import("stdlib:pbai_neural_adapter.sapp") catch nil;
}
fn _callable(value) {return type(value)=="fn" or type(value)=="closure";}
fn _check(id,provider) {
 if id=="sensor-v1" {
  if not _callable(try provider.contract catch nil) or not _callable(try provider.analyze catch nil) {return "incompatible_exports";}
  if not _same(provider.contract(),_sensor_contract()) {return "incompatible_contract";}
  let reply=provider.analyze(map{values:[2,4,6,8],period_seconds:2,sigma:3,absolute_tolerance:1});
  let expected=map{format:"pbai.sensor.result.v1",status:"result",error:nil,
   implementation_kind:"deterministic-specialist",trained_model:false,external_effects:false,authorizes_action:false,
   value:map{profile:"uniform-linear-last-point.v1",baseline_samples:3,baseline_mean:4,
    slope_per_second:1,residual_sd:0,expected_last:8,deviation:0,threshold:1,outlier:false,
    direction:"within-threshold",uniform_sampling:"caller-declared-unverified",confidence_calibrated:false}};
  if not _same(reply,expected) {return "probe_failed";}
  return "ok";
 }
 if not _callable(try provider.student_tool catch nil) {return "incompatible_exports";}
 let reply=provider.student_tool(map{op:"capabilities"});
 if not _same(reply,map{format:"pbai.neural.student-tool.v1",status:"result",result:_student_contract(),error:nil}) {return "incompatible_contract";}
 if not _same(provider.student_tool(map{op:"unsupported"}),map{format:"pbai.neural.student-tool.v1",status:"error",result:nil,error:"unsupported_operation"}) {return "probe_failed";}
 return "ok";
}
fn _report(id,code,plan=nil) {
 let kind="not-probed";
 if _known(id) {kind=if id=="sensor-v1" {"synthetic-numeric-oracle"} else {"capability-and-error-contract"};}
 return map{format:"pbai.modular.probe.v1",adapter:if _known(id) {id} else {nil},
  ok:code=="ok",code:code,plan:plan,runtime_checked:code=="ok",
  numeric_inference_checked:code=="ok" and id=="sensor-v1",
  probe_kind:kind,
  backend:"pure-pblang-cpu",trained_during_probe:false,spawns_workers:false,
  artifact_authenticated:false,authorizes_action:false};
}
fn _prepare(id) {
 if not _known(id) {return map{report:_report(nil,"invalid_adapter"),provider:nil};}
 let provider=_load(id);
 if provider==nil {return map{report:_report(id,"dependency_unavailable",try _plan(id,false) catch nil),provider:nil};}
 let code=try _check(id,provider) catch "probe_failed";
 if code!="ok" {return map{report:_report(id,code),provider:nil};}
 let plan=try _plan(id,true) catch nil;
 if plan==nil or not plan.ok {return map{report:_report(id,"resolution_failed"),provider:nil};}
 return map{report:_report(id,"ok",plan),provider:provider};
}
fn probe(id) {return _prepare(id).report;}
fn run(id,request) {
 let prepared=_prepare(id);
 if not prepared.report.ok {return map{format:"pbai.modular.result.v1",status:"error",error:prepared.report.code,output:nil};}
 let result=if id=="sensor-v1" {try prepared.provider.analyze(request) catch nil}
  else {try prepared.provider.student_tool(request) catch nil};
 if result==nil {return map{format:"pbai.modular.result.v1",status:"error",error:"execution_failed",output:nil};}
 return map{format:"pbai.modular.result.v1",status:"result",error:nil,output:result};
}
// Constant storage: one bounded observation window, no request/result/event retention.
fn _metrics() {
 return map{format:"pbai.modular.metrics.v1",scope:"binding-since-clear",limit:1024,
  observed_calls:0,window_full:false,observations_dropped:false,
  rejected_calls:0,executed_calls:0,provider_results:0,provider_errors:0,
  execution_errors:0,unclassified_replies:0,
  duration:map{source:"now_ms",unit:"ms",monotonic:false,max_valid_ms:86400000,
   samples:0,invalid_samples:0,total_ms:0,min_ms:nil,max_ms:nil},
  includes_probe:false,persistence:false,retains_payloads:false,
  artifact_authenticated:false,authorizes_action:false};
}
fn _finite_number(value) {return type(value)=="number" and value==value and value-value==0;}
fn _duration(stats,started,ended) {
 if not _finite_number(started) or not _finite_number(ended) {
  stats.invalid_samples=stats.invalid_samples+1;return nil;
 }
 let elapsed=ended-started;
 if not _finite_number(elapsed) or elapsed<0 or elapsed>stats.max_valid_ms {
  stats.invalid_samples=stats.invalid_samples+1;return nil;
 }
 if stats.samples==0 {stats.min_ms=elapsed;stats.max_ms=elapsed;}
 else {
  if elapsed<stats.min_ms {stats.min_ms=elapsed;}
  if elapsed>stats.max_ms {stats.max_ms=elapsed;}
 }
 stats.samples=stats.samples+1;stats.total_ms=stats.total_ms+elapsed;
 return nil;
}
fn _observe(stats,output,started,ended) {
 stats.executed_calls=stats.executed_calls+1;
 _duration(stats.duration,started,ended);
 if output==nil {stats.execution_errors=stats.execution_errors+1;return nil;}
 let status=if type(output)=="map" {try output.status catch nil} else {nil};
 if status=="result" {stats.provider_results=stats.provider_results+1;}
 elif status=="error" {stats.provider_errors=stats.provider_errors+1;}
 else {stats.unclassified_replies=stats.unclassified_replies+1;}
 return nil;
}
// Trusted host imports select providers before crossing this non-serializable API.
// Native module handles are not publisher authentication or permission grants.
fn bind(id,provider,resolver) {
 let code="invalid_binding";let private=map{plan:nil};
 let execute=fn(request) {return nil;};
 if not _known(id) {code="invalid_adapter";}
 elif type(provider)=="module" and type(resolver)=="module" {
  code=try _check(id,provider) catch "probe_failed";
  if code=="ok" {
   let resolved=try _resolved_plan(id,true,resolver) catch nil;
   let expected=map{format:"pblang.module-plan.v1",ok:true,code:"ok",module:"pbai",slot:nil,
    order:[id,"pbai"],bindings:[map{consumer:"pbai",slot:"selected",provider:id,status:"primary",
     interface:_interface(id),interface_version:"1.0.0",version:"1.0.0"}],
    capability_claims_verified:false,execution_performed:false};
   if not _same(resolved,expected) {code="resolution_failed";}
   else {private.plan=resolved;execute=if id=="sensor-v1" {provider.analyze} else {provider.student_tool};}
  }
 }
 let report=_report(id,code,private.plan);report.binding_scope="explicit-trusted-host-modules";
 let frozen=json_stringify(report);let admitted=code=="ok";let failure=code;
 let monitor=map{stats:_metrics()};
 return map{format:"pbai.modular.binding.v1",
  report:fn(){return json_parse(frozen);},
  metrics:fn(){return json_parse(json_stringify(monitor.stats));},
  clear_metrics:fn(){monitor.stats=_metrics();return nil;},
  run:fn(request){
   let stats=monitor.stats;let observe=stats.observed_calls<stats.limit;
   if observe {
    stats.observed_calls=stats.observed_calls+1;
    stats.window_full=stats.observed_calls==stats.limit;
   } else {stats.observations_dropped=true;}
   if not admitted {
    if observe {stats.rejected_calls=stats.rejected_calls+1;}
    return map{format:"pbai.modular.result.v1",status:"error",error:failure,output:nil};
   }
   let started=if observe {try now_ms() catch nil} else {nil};
   let output=try execute(request) catch nil;
   let ended=if observe {try now_ms() catch nil} else {nil};
   if observe {_observe(stats,output,started,ended);}
   if output==nil {return map{format:"pbai.modular.result.v1",status:"error",error:"execution_failed",output:nil};}
   return map{format:"pbai.modular.result.v1",status:"result",error:nil,output:output};
  }};
}
export catalog,probe,run,bind;
