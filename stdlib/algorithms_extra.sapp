// stdlib/algorithms_extra.sapp — classic algorithms, pure pblang.
//
// Graphs: Borůvka & Kruskal minimum spanning tree, Floyd–Warshall all-pairs.
// Geometry: convex hull (Andrew's monotone chain) + onion peeling (convex layers).
// Strings: Knuth–Morris–Pratt search. Arrays: Kadane max-subarray. Union-Find.
//
// Edges are map{ from, to, weight }; nodes are integers 0..n-1. Points are [x, y].

// ── Union-Find (disjoint set, path compression + union by rank) ──────────────
fn uf_new(n) {
    let parent = [];
    let rank = [];
    let i = 0;
    while i < n { array_push(parent, i); array_push(rank, 0); i = i + 1; }
    return map{ parent: parent, rank: rank };
}

fn uf_find(uf, x) {
    let root = x;
    while uf.parent[root] != root { root = uf.parent[root]; }
    let cur = x;
    while uf.parent[cur] != root {
        let nxt = uf.parent[cur];
        uf.parent[cur] = root;
        cur = nxt;
    }
    return root;
}

// uf_union -> true if two distinct sets were merged, false if already joined.
fn uf_union(uf, a, b) {
    let ra = uf_find(uf, a);
    let rb = uf_find(uf, b);
    if ra == rb { return false; }
    if uf.rank[ra] < uf.rank[rb] {
        uf.parent[ra] = rb;
    } else {
        if uf.rank[ra] > uf.rank[rb] {
            uf.parent[rb] = ra;
        } else {
            uf.parent[rb] = ra;
            uf.rank[ra] = uf.rank[ra] + 1;
        }
    }
    return true;
}

fn _sort_edges(edges) {
    let a = [];
    let i = 0;
    while i < len(edges) { array_push(a, edges[i]); i = i + 1; }
    let j = 1;
    while j < len(a) {
        let key = a[j];
        let k = j - 1;
        while k >= 0 and a[k].weight > key.weight {
            a[k + 1] = a[k];
            k = k - 1;
        }
        a[k + 1] = key;
        j = j + 1;
    }
    return a;
}

// ── Kruskal MST ──────────────────────────────────────────────────────────────
fn kruskal(n, edges) {
    let sorted = _sort_edges(edges);
    let uf = uf_new(n);
    let mst = [];
    let total = 0;
    let count = 0;
    let i = 0;
    while i < len(sorted) {
        let e = sorted[i];
        if uf_union(uf, e.from, e.to) {
            array_push(mst, e);
            total = total + e.weight;
            count = count + 1;
        }
        i = i + 1;
    }
    return map{ edges: mst, weight: total, components: n - count };
}

// ── Borůvka MST ──────────────────────────────────────────────────────────────
fn boruvka(n, edges) {
    let uf = uf_new(n);
    let mst = [];
    let total = 0;
    let num_comp = n;
    while num_comp > 1 {
        // cheapest outgoing edge for each current component
        let cheapest = map{};
        let i = 0;
        while i < len(edges) {
            let e = edges[i];
            let ru = uf_find(uf, e.from);
            let rv = uf_find(uf, e.to);
            if ru != rv {
                let ka = str(ru);
                if not map_has(cheapest, ka) or edges[cheapest[ka]].weight > e.weight { cheapest[ka] = i; }
                let kb = str(rv);
                if not map_has(cheapest, kb) or edges[cheapest[kb]].weight > e.weight { cheapest[kb] = i; }
            }
            i = i + 1;
        }
        let keys = map_keys(cheapest);
        let progressed = false;
        let j = 0;
        while j < len(keys) {
            let e = edges[cheapest[keys[j]]];
            if uf_union(uf, e.from, e.to) {
                array_push(mst, e);
                total = total + e.weight;
                num_comp = num_comp - 1;
                progressed = true;
            }
            j = j + 1;
        }
        if not progressed { break; }   // graph is disconnected
    }
    return map{ edges: mst, weight: total, components: num_comp };
}

// ── Convex hull (Andrew's monotone chain), CCW, interior points removed ──────
fn _pt_less(a, b) {
    if a[0] != b[0] { return a[0] < b[0]; }
    return a[1] < b[1];
}

fn _sort_points(points) {
    let a = [];
    let i = 0;
    while i < len(points) { array_push(a, points[i]); i = i + 1; }
    let j = 1;
    while j < len(a) {
        let key = a[j];
        let k = j - 1;
        while k >= 0 and _pt_less(key, a[k]) {
            a[k + 1] = a[k];
            k = k - 1;
        }
        a[k + 1] = key;
        j = j + 1;
    }
    return a;
}

fn _cross(o, a, b) {
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
}

fn convex_hull(points) {
    let pts = _sort_points(points);
    let n = len(pts);
    if n < 3 { return pts; }
    let lower = [];
    let i = 0;
    while i < n {
        while len(lower) >= 2 and _cross(lower[len(lower) - 2], lower[len(lower) - 1], pts[i]) <= 0 {
            array_pop(lower);
        }
        array_push(lower, pts[i]);
        i = i + 1;
    }
    let upper = [];
    let j = n - 1;
    while j >= 0 {
        while len(upper) >= 2 and _cross(upper[len(upper) - 2], upper[len(upper) - 1], pts[j]) <= 0 {
            array_pop(upper);
        }
        array_push(upper, pts[j]);
        j = j - 1;
    }
    let hull = [];
    let a = 0;
    while a < len(lower) - 1 { array_push(hull, lower[a]); a = a + 1; }
    let b = 0;
    while b < len(upper) - 1 { array_push(hull, upper[b]); b = b + 1; }
    return hull;
}

// ── Onion peeling: repeated convex hulls from the outside in ──────────────────
fn _pt_key(p) { return str(p[0]) + "," + str(p[1]); }

fn onion_peeling(points) {
    let remaining = [];
    let i = 0;
    while i < len(points) { array_push(remaining, points[i]); i = i + 1; }
    let layers = [];
    while len(remaining) > 0 {
        let hull = convex_hull(remaining);
        if len(hull) == 0 { break; }
        array_push(layers, hull);
        let on_hull = map{};
        let h = 0;
        while h < len(hull) { on_hull[_pt_key(hull[h])] = true; h = h + 1; }
        let next = [];
        let r = 0;
        while r < len(remaining) {
            if not map_has(on_hull, _pt_key(remaining[r])) { array_push(next, remaining[r]); }
            r = r + 1;
        }
        if len(next) == len(remaining) { break; }   // no progress (degenerate)
        remaining = next;
    }
    return layers;
}

// ── Kadane: maximum contiguous subarray sum (+ its [start,end]) ───────────────
fn kadane(arr) {
    if len(arr) == 0 { return map{ sum: 0, start: 0, end: 0 }; }
    let best = arr[0];
    let cur = arr[0];
    let bs = 0;
    let be = 0;
    let s = 0;
    let i = 1;
    while i < len(arr) {
        if cur < 0 { cur = arr[i]; s = i; } else { cur = cur + arr[i]; }
        if cur > best { best = cur; bs = s; be = i; }
        i = i + 1;
    }
    return map{ sum: best, start: bs, end: be };
}

// ── Knuth–Morris–Pratt substring search ──────────────────────────────────────
fn _ch(s, i) { return str_slice(s, i, i + 1); }

fn _kmp_failure(p) {
    let m = len(p);
    let f = [];
    let i = 0;
    while i < m { array_push(f, 0); i = i + 1; }
    let k = 0;
    let q = 1;
    while q < m {
        while k > 0 and _ch(p, k) != _ch(p, q) { k = f[k - 1]; }
        if _ch(p, k) == _ch(p, q) { k = k + 1; }
        f[q] = k;
        q = q + 1;
    }
    return f;
}

fn kmp_search_all(text, pattern) {
    let res = [];
    let n = len(text);
    let m = len(pattern);
    if m == 0 or m > n { return res; }
    let f = _kmp_failure(pattern);
    let k = 0;
    let i = 0;
    while i < n {
        while k > 0 and _ch(text, i) != _ch(pattern, k) { k = f[k - 1]; }
        if _ch(text, i) == _ch(pattern, k) { k = k + 1; }
        if k == m { array_push(res, i - m + 1); k = f[k - 1]; }
        i = i + 1;
    }
    return res;
}

fn kmp_search(text, pattern) {
    let all = kmp_search_all(text, pattern);
    if len(all) == 0 { return 0 - 1; }
    return all[0];
}

// ── Floyd–Warshall all-pairs shortest paths ──────────────────────────────────
// matrix[i][j] = edge weight (use a large `inf` sentinel for "no edge"); diagonal 0.
fn floyd_warshall(matrix, inf = nil) {
    if inf == nil { inf = 1000000000; }
    let n = len(matrix);
    let d = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < len(matrix[i]) { array_push(row, matrix[i][j]); j = j + 1; }
        array_push(d, row);
        i = i + 1;
    }
    let k = 0;
    while k < n {
        let a = 0;
        while a < n {
            let b = 0;
            while b < n {
                if d[a][k] < inf and d[k][b] < inf {
                    let nd = d[a][k] + d[k][b];
                    if nd < d[a][b] { d[a][b] = nd; }
                }
                b = b + 1;
            }
            a = a + 1;
        }
        k = k + 1;
    }
    return d;
}

export uf_new, uf_find, uf_union;
export kruskal, boruvka;
export convex_hull, onion_peeling;
export kadane, kmp_search, kmp_search_all, floyd_warshall;
