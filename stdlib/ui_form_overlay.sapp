// Detached, renderer-neutral customization. Source documents are never mutated.
// Events stay inert; no foreign code, files, network, or executable patching.
let Doc = import("stdlib:ui_document.sapp");
fn _copy(document) {
    let checked = Doc.validate(document);
    if not checked.ok { throw "ui_form_overlay: invalid document"; }
    return checked.document;
}

fn _index(document) {
    let out = map{};
    for widget in document.widgets { out[widget.id] = widget; }
    return out;
}
// Patch fields deliberately exclude identity/parent/kind: structural edits use compose.

fn apply(document, patches) {
    if type(patches) != "array" or len(patches) > 512 { throw "ui_form_overlay: invalid patches"; }
    let out = _copy(document); let widgets = _index(out);
    for patch in patches {
        if type(patch) != "map" or len(map_keys(patch)) != 2 or not map_has(patch, "id") or not map_has(patch, "set")
        or type(patch.id) != "string" or not map_has(widgets, patch.id) or type(patch.set) != "map" {
            throw "ui_form_overlay: invalid patch";
        }
        let widget = widgets[patch.id];
        for key in map_keys(patch.set) {
            if key == "props" {
                if type(patch.set.props) != "map" or len(map_keys(patch.set.props)) > 256 { throw "ui_form_overlay: invalid properties"; }
                for name in map_keys(patch.set.props) { widget.props[name] = patch.set.props[name]; }
            } elif key == "events" or key == "bind" or key == "x" or key == "y" or key == "w" or key == "h" {
                widget[key] = patch.set[key];
            } else { throw "ui_form_overlay: unsupported patch field"; }
        }
    }
    // Revalidation also detaches nested patch values and enforces cumulative budgets.
    return _copy(out);
}
// Each part receives a panel and an id namespace; binding keys are namespaced too.
// Handler identifiers are not renamed or executed. The caller binds actions by new id.

fn compose(parts, title = "Combined forms") {
    if type(parts) != "array" or len(parts) < 1 or len(parts) > 16 { throw "ui_form_overlay: invalid parts"; }
    let design = map{form:map{title:title, w:900, h:700}, widgets:[], model:map{}};
    let seen = map{};
    for part in parts {
        if type(part) != "map" or len(map_keys(part)) != 2 or not map_has(part, "prefix") or not map_has(part, "document")
        or type(part.prefix) != "string" or len(part.prefix) > 32
        or not regex_match(part.prefix, "^[A-Za-z][A-Za-z0-9_]*$") or map_has(seen, part.prefix) {
            throw "ui_form_overlay: invalid namespace";
        }
        seen[part.prefix] = true;
        let doc = _copy(part.document); let panel = part.prefix + ".root";
        if len(design.widgets) + len(doc.widgets) + 1 > 512 { throw "ui_form_overlay: too many widgets"; }
        push(design.widgets, map{name:panel, kind:"panel", parent:"root", x:0, y:0, w:doc.form.w, h:doc.form.h, props:map{title:doc.form.title}, events:map{}, bind:""});
        for widget in doc.widgets {
            push(design.widgets, map{name:part.prefix + "." + widget.id, kind:widget.kind,
                parent:if widget.parent == "root" { panel } else { part.prefix + "." + widget.parent },
                x:widget.x, y:widget.y, w:widget.w, h:widget.h, props:widget.props, events:widget.events,
                bind:if widget.bind == "" { "" } else { part.prefix + "." + widget.bind }});
        }
        for key in map_keys(doc.model) { design.model[part.prefix + "." + key] = doc.model[key]; }
    }
    return Doc.from_design(design, "pblang-composed");
}
export apply, compose;
