// stdlib/ui_parse.sapp — parse generated pblang web code back into a design tree.
//
// The DESIGNER ROUND-TRIP (Visual_Designer.md D1): the designer generates pblang
// (html.sapp calls); this reads that pblang back — via the SELF-HOSTED parser
// (stdlib/compiler/) — into the component tree the canvas renders, so hand-edited code
// and drag-authored design stay in sync. The inverse of the designer's codegen.
//
//   let U = import("stdlib/ui_parse.sapp");
//   let tree = U.parse(generatedCode);   // -> [ {type, props, children}, … ]
//
// Recognizes the html.* call shapes the designer emits (tag/a/img/self_closing). All pblang.

let _tok = import("stdlib/compiler/tokenizer.sapp");
let _par = import("stdlib/compiler/parser.sapp");

fn _str_arg(a) { if a != nil and (try a.kind catch "") == "string" { return a.value; } return ""; }

// ── events (D2) ───────────────────────────────────────────────────────────────────────
// The designer emits event bindings as html attributes (onclick/onchange/oninput/onsubmit)
// whose value is a handler call like "on_save_click(event)". Read them back into an
// `events` map { eventKey: handlerName } so a code→canvas→code cycle preserves the wiring.
fn _ev_key(attr) {
    if attr == "onclick" { return "click"; }
    if attr == "onchange" { return "change"; }
    if attr == "oninput" { return "input"; }
    if attr == "onsubmit" { return "submit"; }
    return "";
}
fn _handler_name(v) {                       // "on_save_click(event)" -> "on_save_click"
    let p = str_index_of(v, "(");
    if p >= 0 { return str_trim(str_slice(v, 0, p)); }
    return str_trim(v);
}
fn _events_from_attrs(attrs) {
    let evs = map{};
    if attrs == nil or (try attrs.kind catch "") != "map" { return evs; }
    let entries = try attrs.entries catch [];
    let i = 0;
    while i < len(entries) {
        let ev = _ev_key(try entries[i].key catch "");
        let val = entries[i].value;
        if ev != "" and (try val.kind catch "") == "string" {
            evs[ev] = _handler_name(val.value);
        }
        i = i + 1;
    }
    return evs;
}
fn _with_events(node, attrs) {
    if node == nil { return nil; }
    let evs = _events_from_attrs(attrs);
    if len(map_keys(evs)) > 0 { node["events"] = evs; }
    return node;
}

// flatten an `expr + expr + …` concatenation into a list of leaf call expressions.
fn _flatten(expr, out) {
    if expr == nil { return 0; }
    if (try expr.kind catch "") == "binary" and (try expr.op catch "") == "+" {
        _flatten(expr.left, out);
        _flatten(expr.right, out);
    } else {
        push(out, expr);
    }
    return 0;
}

fn _nodes_from_expr(expr) {
    let calls = [];
    _flatten(expr, calls);
    let out = [];
    let i = 0;
    while i < len(calls) {
        if (try calls[i].kind catch "") == "call" {
            let node = _node_from_call(calls[i]);
            if node != nil { push(out, node); }
        }
        i = i + 1;
    }
    return out;
}

fn _node_from_call(call) {
    let f = try call.func.name catch "";       // tag / a / img / self_closing
    let args = try call.args catch [];
    if len(args) == 0 { return nil; }
    // attrs map (where event bindings live): self_closing -> args[1]; tag/a/img -> args[2]
    let attrs = nil;
    if f == "self_closing" { if len(args) > 1 { attrs = args[1]; } }
    else { if len(args) > 2 { attrs = args[2]; } }
    if f == "a" {
        return _with_events(map{ type: "link", props: map{ href: _str_arg(args[0]), text: _str_arg(args[1]) } }, attrs);
    }
    if f == "img" {
        return _with_events(map{ type: "image", props: map{ src: _str_arg(args[0]), alt: _str_arg(args[1]) } }, attrs);
    }
    if f == "self_closing" {
        let t = _str_arg(args[0]);
        if t == "input" { return _with_events(map{ type: "input", props: map{ placeholder: "", name: "field" } }, attrs); }
        if t == "canvas" { return _with_events(map{ type: "canvas2d", props: map{ width: "300", height: "180" } }, attrs); }
        return nil;
    }
    if f == "tag" {
        let t = _str_arg(args[0]);
        let content = nil;
        if len(args) > 1 { content = args[1]; }
        if t == "h1" or t == "h2" or t == "h3" or t == "h4" {
            return _with_events(map{ type: "heading", props: map{ text: _str_arg(content), level: str_slice(t, 1, 2) } }, attrs);
        }
        if t == "p" { return _with_events(map{ type: "text", props: map{ text: _str_arg(content) } }, attrs); }
        if t == "button" { return _with_events(map{ type: "button", props: map{ text: _str_arg(content) } }, attrs); }
        if t == "section" { return _with_events(map{ type: "section", props: map{}, children: _nodes_from_expr(content) }, attrs); }
        if t == "div" { return _with_events(map{ type: "card", props: map{}, children: _nodes_from_expr(content) }, attrs); }
    }
    return nil;
}

fn _find_render(ast) {
    let stmts = try ast.stmts catch [];
    let i = 0;
    while i < len(stmts) {
        if (try stmts[i].kind catch "") == "fn" and (try stmts[i].name catch "") == "render" {
            let bs = try stmts[i].body.stmts catch [];
            let j = 0;
            while j < len(bs) {
                if (try bs[j].kind catch "") == "return" { return bs[j].value; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return nil;
}

// parse(code) — generated pblang web code -> a list of design nodes (or [] if none/parse error).
fn parse(code) {
    let ast = try _par.parse(_tok.tokenize(code)) catch nil;
    if ast == nil { return []; }
    let expr = _find_render(ast);
    if expr == nil { return []; }
    return _nodes_from_expr(expr);
}

// node_count(nodes) — total nodes in a design tree, counting nested children.
fn node_count(nodes) {
    let total = 0;
    let i = 0;
    while i < len(nodes) {
        total = total + 1;
        let ch = try nodes[i].children catch nil;
        if ch != nil { total = total + node_count(ch); }
        i = i + 1;
    }
    return total;
}

// find_nodes(nodes, type) — all nodes of the given type, depth-first.
fn find_nodes(nodes, node_type) {
    let out = [];
    let i = 0;
    while i < len(nodes) {
        let n = nodes[i];
        if (try n.type catch nil) == node_type { array_push(out, n); }
        let ch = try n.children catch nil;
        if ch != nil {
            let sub = find_nodes(ch, node_type);
            let j = 0;
            while j < len(sub) { array_push(out, sub[j]); j = j + 1; }
        }
        i = i + 1;
    }
    return out;
}

export parse, node_count, find_nodes;
