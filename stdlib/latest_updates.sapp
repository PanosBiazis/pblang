// A cooperative buffer for explicitly replaceable state, not ordered events.
// No clocks, background tasks, OS calls, payload comparisons or implicit retries.
fn new_buffer() {
    let state=map{pending:map{},order:[],replaced:0,busy:false};
    let enqueue=fn(key,value,lazy){
        if not is_string(key) {throw "latest_updates: key must be a string";}
        if map_has(state.pending,key) {
            let entry=state.pending[key];
            entry.value=value;
            entry.lazy=lazy;
            state.replaced=state.replaced+1;
            return false;
        }
        let entry=map{key:key,value:value,lazy:lazy};
        state.pending[key]=entry;
        array_push(state.order,entry);
        return true;
    };
    return map{
        submit:fn(key,value){return enqueue(key,value,false);},
        submit_lazy:fn(key,producer){return enqueue(key,producer,true);},
        pending:fn(){return len(state.order);},
        discard:fn(){
            if state.busy {throw "latest_updates: cannot discard during flush";}
            let count=len(state.order);
            state.pending=map{};state.order=[];state.replaced=0;
            return count;
        },
        flush:fn(consumer){
            if state.busy {throw "latest_updates: recursive flush";}
            let batch=state.order;
            let replaced=state.replaced;
            // New submissions from callbacks belong to the NEXT flush. This
            // pass is finite even if each callback submits another update.
            state.pending=map{};state.order=[];state.replaced=0;state.busy=true;
            let applied=0;
            let failures=[];
            for entry in batch {
                let payload=entry.value;
                entry.value=nil;
                let produced=[true,payload];
                if entry.lazy {produced=try [true,payload()] catch [false,nil];}
                if not produced[0] {
                    array_push(failures,map{key:entry.key,stage:"producer_exception"});
                } else {
                    let result=try [true,consumer(entry.key,produced[1])] catch [false,nil];
                    if not result[0] {
                        array_push(failures,map{key:entry.key,stage:"consumer_exception"});
                    } else {
                        if type(result[1])=="bool" and result[1] {applied=applied+1;}
                        else {array_push(failures,map{key:entry.key,stage:"not_acknowledged"});}
                    }
                }
            }
            state.busy=false;
            return map{ok:len(failures)==0,attempted:len(batch),applied:applied,
                coalesced:replaced,failures:failures};
        }
    };
}

export new_buffer;
