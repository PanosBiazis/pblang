// stdlib/ui_observer.sapp
//
// Pure UI/UX observability helpers for pblang tools. A program can publish a
// structured snapshot of the visible surface so an IDE watcher, test, or agent can
// understand layout/behavior without depending only on screenshots.

fn _num(v, fallback) {
    let n = try parse_number(str(v)) catch nil;
    if n == nil { return fallback; }
    return n;
}

fn _field_num(m, key, fallback) {
    if key == "x" { return _num(try m.x catch fallback, fallback); }
    if key == "y" { return _num(try m.y catch fallback, fallback); }
    if key == "w" { return _num(try m.w catch fallback, fallback); }
    if key == "h" { return _num(try m.h catch fallback, fallback); }
    return fallback;
}

fn issue(severity, target, message) {
    return map{
        severity: str(severity),
        target: str(target),
        message: str(message)
    };
}

fn region(name, x, y, w, h, role, state) {
    if state == nil { state = map{}; }
    return map{
        name: str(name),
        x: _num(x, 0),
        y: _num(y, 0),
        w: _num(w, 0),
        h: _num(h, 0),
        role: str(role),
        state: state,
        overlay: try state.overlay catch false
    };
}

fn _region_name(r) {
    return str(try r.name catch "?");
}

fn _region_raw_name(r) {
    return str_trim(str(try r.name catch ""));
}

fn _region_overlay(r) {
    if try r.overlay catch false { return true; }
    return try r.state.overlay catch false;
}

fn _region_visible(r) {
    let state = try r.state catch map{};
    let visible = try state.visible catch true;
    return visible != false;
}

fn text_capacity(region) {
    if region == nil { return 0; }
    let w = _field_num(region, "w", 0);
    let state = try region.state catch map{};
    let pad = _num(try state.pad catch 0, 0);
    let char_w = _num(try state.char_w catch 8, 8);
    if char_w < 1 { char_w = 8; }
    let available = w - pad * 2;
    if available < 0 { available = 0; }
    return num_floor(available / char_w);
}

fn _region_text_issue(r) {
    let state = try r.state catch map{};
    let text = try state.text catch nil;
    if text == nil { return nil; }
    let s = str(text);
    let capacity = text_capacity(r);
    let required = len(s);
    if required > capacity {
        return issue("warn", _region_name(r), "text clipped " + str(required) + " chars > capacity " + str(capacity));
    }
    return nil;
}

fn _required_name(item) {
    return str(try item.name catch item);
}

fn _action_name(item) {
    return str(try item.id catch try item.name catch item);
}

fn _action_label(item) {
    return str_trim(str(try item.label catch try item.title catch ""));
}

fn _action_visible(item) {
    let visible = try item.visible catch true;
    return visible != false;
}

fn _region_exists(regions, name) {
    let target = str(name);
    let i = 0;
    while regions != nil and i < len(regions) {
        if _region_name(regions[i]) == target { return true; }
        i = i + 1;
    }
    return false;
}

fn required_region_issues(regions, required) {
    let out = [];
    let i = 0;
    while required != nil and i < len(required) and i < 120 {
        let name = _required_name(required[i]);
        if name != "" and not _region_exists(regions, name) {
            array_push(out, issue("error", name, "required region missing"));
        }
        i = i + 1;
    }
    return out;
}

fn _seen_region_name(names, name) {
    let i = 0;
    while names != nil and i < len(names) {
        if str(names[i]) == str(name) { return true; }
        i = i + 1;
    }
    return false;
}

fn region_identity_issues(regions) {
    let out = [];
    let seen = [];
    let i = 0;
    while regions != nil and i < len(regions) and i < 240 {
        let name = _region_raw_name(regions[i]);
        if name == "" {
            array_push(out, issue("error", "region:" + str(i), "region has empty name"));
        } else if _seen_region_name(seen, name) {
            array_push(out, issue("warn", name, "duplicate region name"));
        } else {
            array_push(seen, name);
        }
        i = i + 1;
    }
    return out;
}

fn _region_actions(r) {
    let state = try r.state catch map{};
    let actions = try state.actions catch [];
    let out = [];
    let a = 0;
    while actions != nil and a < len(actions) {
        array_push(out, actions[a]);
        a = a + 1;
    }
    let panel_actions = try state.panel_actions catch [];
    if panel_actions != nil {
        let i = 0;
        while i < len(panel_actions) {
            array_push(out, panel_actions[i]);
            i = i + 1;
        }
    }
    return out;
}

fn _is_action_record(item) {
    let id = try item.id catch nil;
    let name = try item.name catch nil;
    let label = try item.label catch nil;
    let title = try item.title catch nil;
    return id != nil or name != nil or label != nil or title != nil;
}

fn _seen_action(ids, id) {
    let i = 0;
    while ids != nil and i < len(ids) {
        if str(ids[i]) == str(id) { return true; }
        i = i + 1;
    }
    return false;
}

fn action_metadata_issues(regions) {
    let out = [];
    let r = 0;
    while regions != nil and r < len(regions) and r < 240 {
        let region_name = _region_name(regions[r]);
        let actions = _region_actions(regions[r]);
        let seen = [];
        let a = 0;
        while actions != nil and a < len(actions) and len(out) < 120 {
            let id = _action_name(actions[a]);
            if id == "" {
                array_push(out, issue("error", region_name, "action has empty id"));
            } else if _seen_action(seen, id) {
                array_push(out, issue("warn", region_name, "duplicate action id " + id));
            } else {
                array_push(seen, id);
            }
            if _is_action_record(actions[a]) and _action_label(actions[a]) == "" {
                array_push(out, issue("warn", "action:" + id, "action has no visible label"));
            }
            a = a + 1;
        }
        r = r + 1;
    }
    return out;
}

fn _region_focused(r) {
    let state = try r.state catch map{};
    return try state.focused catch false;
}

fn _region_focus_required(r) {
    let state = try r.state catch map{};
    return try state.focus_required catch false;
}

fn focus_issues(regions) {
    let out = [];
    let focused = [];
    let r = 0;
    while regions != nil and r < len(regions) and r < 240 {
        let name = _region_name(regions[r]);
        if _region_focus_required(regions[r]) and not _region_focused(regions[r]) {
            array_push(out, issue("error", name, "required focus missing"));
        }
        if _region_focused(regions[r]) {
            array_push(focused, name);
        }
        r = r + 1;
    }
    if len(focused) > 1 {
        array_push(out, issue("warn", str_join(focused, " / "), "multiple focused regions"));
    }
    return out;
}

fn visibility_issues(regions) {
    let out = [];
    let r = 0;
    while regions != nil and r < len(regions) and r < 240 {
        let item = regions[r];
        let name = _region_name(item);
        let state = try item.state catch map{};
        let visible = _region_visible(item);
        if (try state.visibility_required catch false) and not visible {
            array_push(out, issue("error", name, "required region hidden"));
        }
        if not visible and _region_focused(item) {
            array_push(out, issue("warn", name, "hidden region is focused"));
        }
        let actions = _region_actions(item);
        if not visible and actions != nil and len(actions) > 0 {
            array_push(out, issue("warn", name, "hidden region has actions"));
        }
        if visible {
            let a = 0;
            while actions != nil and a < len(actions) and len(out) < 160 {
                if not _action_visible(actions[a]) {
                    let id = _action_name(actions[a]);
                    if id != "" {
                        array_push(out, issue("warn", "action:" + id, "action hidden"));
                    }
                }
                a = a + 1;
            }
        }
        r = r + 1;
    }
    return out;
}

fn action_target_capacity(region) {
    if region == nil { return 0; }
    let actions = _region_actions(region);
    if actions == nil or len(actions) == 0 { return 0; }
    let w = _field_num(region, "w", 0);
    let state = try region.state catch map{};
    let pad = _num(try state.pad catch 0, 0);
    let available = w - pad * 2;
    if available < 0 { available = 0; }
    return num_floor(available / len(actions));
}

fn _region_action_target_issue(r) {
    let actions = _region_actions(r);
    if actions == nil or len(actions) == 0 { return nil; }
    let state = try r.state catch map{};
    let min_w = _num(try state.min_action_w catch 0, 0);
    if min_w <= 0 { return nil; }
    let cap = action_target_capacity(r);
    if cap < min_w {
        return issue("warn", _region_name(r), "action targets cramped " + str(cap) + "px < " + str(min_w) + "px for " + str(len(actions)) + " action(s)");
    }
    return nil;
}

fn _action_exists(regions, action) {
    let target = str(action);
    let i = 0;
    while regions != nil and i < len(regions) {
        if not _region_visible(regions[i]) {
            i = i + 1;
            continue;
        }
        let actions = _region_actions(regions[i]);
        let j = 0;
        while actions != nil and j < len(actions) {
            if _action_visible(actions[j]) and _action_name(actions[j]) == target { return true; }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

fn required_action_issues(regions, required) {
    let out = [];
    let i = 0;
    while required != nil and i < len(required) and i < 160 {
        let name = _required_name(required[i]);
        if name != "" and not _action_exists(regions, name) {
            array_push(out, issue("error", "action:" + name, "required action missing"));
        }
        i = i + 1;
    }
    return out;
}

fn _overlap(a, b) {
    if _region_overlay(a) or _region_overlay(b) { return false; }
    let ax = _field_num(a, "x", 0);
    let ay = _field_num(a, "y", 0);
    let aw = _field_num(a, "w", 0);
    let ah = _field_num(a, "h", 0);
    let bx = _field_num(b, "x", 0);
    let by = _field_num(b, "y", 0);
    let bw = _field_num(b, "w", 0);
    let bh = _field_num(b, "h", 0);
    if aw <= 0 or ah <= 0 or bw <= 0 or bh <= 0 { return false; }
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by;
}

fn analyze_regions(regions, viewport) {
    let out = [];
    if regions == nil { return out; }
    let vw = _field_num(viewport, "w", 0);
    let vh = _field_num(viewport, "h", 0);
    let i = 0;
    while i < len(regions) and i < 240 {
        let r = regions[i];
        let name = _region_name(r);
        let x = _field_num(r, "x", 0);
        let y = _field_num(r, "y", 0);
        let w = _field_num(r, "w", 0);
        let h = _field_num(r, "h", 0);
        if w <= 0 or h <= 0 {
            array_push(out, issue("error", name, "nonpositive size " + str(w) + "x" + str(h)));
        }
        if x < 0 or y < 0 {
            array_push(out, issue("warn", name, "starts outside viewport at " + str(x) + "," + str(y)));
        }
        if vw > 0 and x + w > vw {
            array_push(out, issue("warn", name, "extends past viewport width"));
        }
        if vh > 0 and y + h > vh {
            array_push(out, issue("warn", name, "extends past viewport height"));
        }
        let text_issue = _region_text_issue(r);
        if text_issue != nil {
            array_push(out, text_issue);
        }
        let action_issue = _region_action_target_issue(r);
        if action_issue != nil {
            array_push(out, action_issue);
        }
        let action_meta = action_metadata_issues([r]);
        let mi = 0;
        while mi < len(action_meta) {
            array_push(out, action_meta[mi]);
            mi = mi + 1;
        }
        let j = i + 1;
        while j < len(regions) and j < 240 and len(out) < 120 {
            if _overlap(r, regions[j]) {
                array_push(out, issue("warn", name + " / " + _region_name(regions[j]), "regions overlap"));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn surface_snapshot(kind, title, size, focus, regions, signals) {
    return surface_snapshot_checked(kind, title, size, focus, regions, signals, []);
}

fn surface_snapshot_checked(kind, title, size, focus, regions, signals, required) {
    return surface_snapshot_contract(kind, title, size, focus, regions, signals, required, []);
}

fn surface_snapshot_contract(kind, title, size, focus, regions, signals, required_regions, required_actions) {
    if regions == nil { regions = []; }
    if signals == nil { signals = []; }
    let viewport = map{
        w: _field_num(size, "w", 0),
        h: _field_num(size, "h", 0)
    };
    let issues = analyze_regions(regions, viewport);
    let missing = required_region_issues(regions, required_regions);
    let m = 0;
    while m < len(missing) {
        array_push(issues, missing[m]);
        m = m + 1;
    }
    let missing_actions = required_action_issues(regions, required_actions);
    let a = 0;
    while a < len(missing_actions) {
        array_push(issues, missing_actions[a]);
        a = a + 1;
    }
    let focus_list = focus_issues(regions);
    let f = 0;
    while f < len(focus_list) {
        array_push(issues, focus_list[f]);
        f = f + 1;
    }
    let visibility = visibility_issues(regions);
    let vi = 0;
    while vi < len(visibility) {
        array_push(issues, visibility[vi]);
        vi = vi + 1;
    }
    let identities = region_identity_issues(regions);
    let ri = 0;
    while ri < len(identities) {
        array_push(issues, identities[ri]);
        ri = ri + 1;
    }
    let score = snapshot_score(map{ issues: issues });
    return map{
        format: "pblang.ui.snapshot.v1",
        kind: str(kind),
        title: str(title),
        size: viewport,
        focus: str(focus),
        regions: regions,
        signals: signals,
        issues: issues,
        issue_count: len(issues),
        quality_score: score,
        region_count: len(regions)
    };
}

fn snapshot_score(snapshot) {
    if snapshot == nil { return 0; }
    let issues = try snapshot.issues catch [];
    let score = 100;
    let i = 0;
    while issues != nil and i < len(issues) {
        let sev = str_lower(str(try issues[i].severity catch "warn"));
        if sev == "error" { score = score - 25; }
        else if sev == "warn" { score = score - 8; }
        else { score = score - 3; }
        i = i + 1;
    }
    if score < 0 { return 0; }
    if score > 100 { return 100; }
    return score;
}

fn _region_line(r) {
    return "- " + _region_name(r)
        + " [" + str(try r.role catch "?") + "] "
        + str(_field_num(r, "x", 0)) + "," + str(_field_num(r, "y", 0))
        + " " + str(_field_num(r, "w", 0)) + "x" + str(_field_num(r, "h", 0));
}

fn snapshot_lines(snapshot, limit) {
    if snapshot == nil { return ["ui: no snapshot"]; }
    if limit == nil or limit < 1 { limit = 8; }
    let size = try snapshot.size catch map{};
    let out = [
        "ui: " + str(try snapshot.kind catch "?")
            + " focus=" + str(try snapshot.focus catch "?")
            + " " + str(_field_num(size, "w", 0)) + "x" + str(_field_num(size, "h", 0))
            + " regions=" + str(try snapshot.region_count catch len(try snapshot.regions catch []))
            + " issues=" + str(try snapshot.issue_count catch len(try snapshot.issues catch []))
            + " quality=" + str(try snapshot.quality_score catch snapshot_score(snapshot)) + "/100"
    ];
    let issues = try snapshot.issues catch [];
    let i = 0;
    while issues != nil and i < len(issues) and len(out) < limit {
        let it = issues[i];
        array_push(out, "issue: " + str(try it.severity catch "?") + " "
            + str(try it.target catch "?") + " - " + str(try it.message catch "?"));
        i = i + 1;
    }
    let signals = try snapshot.signals catch [];
    let s = 0;
    while signals != nil and s < len(signals) and len(out) < limit {
        array_push(out, "signal: " + str(signals[s]));
        s = s + 1;
    }
    let regions = try snapshot.regions catch [];
    let r = 0;
    while regions != nil and r < len(regions) and len(out) < limit {
        array_push(out, _region_line(regions[r]));
        r = r + 1;
    }
    return out;
}

export issue, region, text_capacity, action_target_capacity, action_metadata_issues, focus_issues, visibility_issues, region_identity_issues, required_region_issues, required_action_issues, analyze_regions, surface_snapshot, surface_snapshot_checked, surface_snapshot_contract, snapshot_score, snapshot_lines;
