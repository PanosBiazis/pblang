// stdlib/quantum_viz.sapp
// Bloch sphere visualization helpers for quantum states.
// Pure Sapphire implementation (no external dependencies).

// bloch_angles(state_2d) → map{ theta, phi }
// Converts a 2D state vector [alpha, beta] to Bloch sphere angles.
// State is assumed normalized: |alpha|^2 + |beta|^2 = 1
// Returns:
//   theta: polar angle (0 to π), theta = 2 * arccos(|alpha|)
//   phi: azimuthal angle (-π to π), phi = arg(beta) - arg(alpha)
fn bloch_angles(state_2d) {
    // Extract alpha and beta (complex numbers as [re, im] pairs)
    let alpha = state_2d[0];
    let beta = state_2d[1];

    // Calculate |alpha| (magnitude)
    let alpha_mag = num_sqrt(alpha[0] * alpha[0] + alpha[1] * alpha[1]);

    // Clamp alpha_mag to [0, 1] to handle numerical errors
    let alpha_clamped = alpha_mag;
    if alpha_clamped > 1.0 {
        alpha_clamped = 1.0;
    }
    if alpha_clamped < 0.0 {
        alpha_clamped = 0.0;
    }

    // theta = 2 * arccos(|alpha|)
    // Use approximation: arccos(x) ≈ π/2 - x - x^3/6 for x near 0
    // For general case, use iterative approximation
    let theta = _arccos(alpha_clamped) * 2.0;

    // Calculate arguments (phases)
    let phi_alpha = _atan2(alpha[1], alpha[0]);
    let phi_beta = _atan2(beta[1], beta[0]);

    // phi = arg(beta) - arg(alpha)
    let phi = phi_beta - phi_alpha;

    // Normalize phi to [-π, π]
    let phi_normalized = phi;
    while phi_normalized > 3.14159265358979 {
        phi_normalized = phi_normalized - 6.28318530717958;
    }
    while phi_normalized < -3.14159265358979 {
        phi_normalized = phi_normalized + 6.28318530717958;
    }

    return map{
        "theta": theta,
        "phi": phi_normalized
    };
}

// bloch_to_svg(theta, phi) → SVG string
// Generates an SVG representation of the Bloch sphere with a vector.
// The sphere is shown as a circle, with an arrow indicating the state.
fn bloch_to_svg(theta, phi) {
    // SVG canvas dimensions
    let width = 200;
    let height = 200;
    let cx = 100;  // center x
    let cy = 100;  // center y
    let r = 80;    // sphere radius

    // Project 3D Bloch vector to 2D
    // Bloch vector: (sin(theta)*cos(phi), sin(theta)*sin(phi), cos(theta))
    // Use orthographic projection: x = sin(theta)*cos(phi), z = cos(theta)
    // Flip z for screen coordinates (y increases downward)
    let x_proj = num_sin(theta) * num_cos(phi);
    let z_proj = num_cos(theta);

    // Convert to screen coordinates
    let arrow_x = cx + x_proj * r;
    let arrow_y = cy - z_proj * r;

    // Build SVG string
    let svg = "<svg width=\"" + str(width) + "\" height=\"" + str(height) + "\" xmlns=\"http://www.w3.org/2000/svg\">";

    // Background
    svg = svg + "<rect width=\"100%\" height=\"100%\" fill=\"white\"/>";

    // Sphere outline (circle)
    svg = svg + "<circle cx=\"" + str(cx) + "\" cy=\"" + str(cy) + "\" r=\"" + str(r) + "\" fill=\"none\" stroke=\"black\" stroke-width=\"2\"/>";

    // Equator (dashed)
    svg = svg + "<ellipse cx=\"" + str(cx) + "\" cy=\"" + str(cy) + "\" rx=\"" + str(r) + "\" ry=\"" + str(r * 0.3) + "\" fill=\"none\" stroke=\"gray\" stroke-width=\"1\" stroke-dasharray=\"4\"/>";

    // Axes
    // X-axis (horizontal)
    svg = svg + "<line x1=\"" + str(cx - r - 10) + "\" y1=\"" + str(cy) + "\" x2=\"" + str(cx + r + 10) + "\" y2=\"" + str(cy) + "\" stroke=\"gray\" stroke-width=\"1\"/>";
    // Z-axis (vertical)
    svg = svg + "<line x1=\"" + str(cx) + "\" y1=\"" + str(cy - r - 10) + "\" x2=\"" + str(cx) + "\" y2=\"" + str(cy + r + 10) + "\" stroke=\"gray\" stroke-width=\"1\"/>";

    // |0⟩ and |1⟩ labels
    svg = svg + "<text x=\"" + str(cx) + "\" y=\"" + str(cy - r - 15) + "\" text-anchor=\"middle\" font-size=\"12\">|0⟩</text>";
    svg = svg + "<text x=\"" + str(cx) + "\" y=\"" + str(cy + r + 20) + "\" text-anchor=\"middle\" font-size=\"12\">|1⟩</text>";

    // State vector arrow
    svg = svg + "<line x1=\"" + str(cx) + "\" y1=\"" + str(cy) + "\" x2=\"" + str(arrow_x) + "\" y2=\"" + str(arrow_y) + "\" stroke=\"red\" stroke-width=\"3\"/>";

    // Arrow head
    let head_size = 8;
    let angle = _atan2(arrow_y - cy, arrow_x - cx);
    let head1_x = arrow_x - head_size * num_cos(angle - 0.5);
    let head1_y = arrow_y - head_size * num_sin(angle - 0.5);
    let head2_x = arrow_x - head_size * num_cos(angle + 0.5);
    let head2_y = arrow_y - head_size * num_sin(angle + 0.5);
    svg = svg + "<polygon points=\"" + str(arrow_x) + "," + str(arrow_y) + " " + str(head1_x) + "," + str(head1_y) + " " + str(head2_x) + "," + str(head2_y) + "\" fill=\"red\"/>";

    // State point
    svg = svg + "<circle cx=\"" + str(arrow_x) + "\" cy=\"" + str(arrow_y) + "\" r=\"4\" fill=\"red\"/>";

    // Coordinate display
    svg = svg + "<text x=\"10\" y=\"" + str(height - 30) + "\" font-size=\"10\" fill=\"black\">θ = " + str(num_round(theta * 180.0 / 3.14159265358979, 1)) + "°</text>";
    svg = svg + "<text x=\"10\" y=\"" + str(height - 15) + "\" font-size=\"10\" fill=\"black\">φ = " + str(num_round(phi * 180.0 / 3.14159265358979, 1)) + "°</text>";

    svg = svg + "</svg>";

    return svg;
}

// Helper: arctan2 approximation
fn _atan2(y, x) {
    // Handle special cases
    if x == 0.0 and y == 0.0 {
        return 0.0;
    }
    if x == 0.0 {
        if y > 0.0 {
            return 1.5707963267948966;  // π/2
        } else {
            return -1.5707963267948966;  // -π/2
        }
    }
    if y == 0.0 {
        if x > 0.0 {
            return 0.0;
        } else {
            return 3.141592653589793;  // π
        }
    }

    // Use arctan(y/x) and adjust quadrant
    let ratio = y / x;
    let atan_ratio = _atan(ratio);

    if x > 0.0 {
        return atan_ratio;
    } else {
        if y > 0.0 {
            return atan_ratio + 3.141592653589793;
        } else {
            return atan_ratio - 3.141592653589793;
        }
    }
}

// Helper: arctan approximation using Taylor series
fn _atan(x) {
    // Clamp input for convergence
    let abs_x = x;
    if abs_x < 0.0 {
        abs_x = 0.0 - abs_x;
    }

    // For |x| <= 1, use Taylor series
    // arctan(x) ≈ x - x^3/3 + x^5/5 - x^7/7 + ...
    let result = 0.0;
    let term = x;
    let x_squared = x * x;
    let i = 0;
    let sign = 1.0;

    while i < 20 {
        let denom = 2.0 * i + 1.0;
        result = result + sign * term / denom;
        term = term * x_squared;
        sign = 0.0 - sign;
        i = i + 1;
    }

    return result;
}

// Helper: arccos approximation
fn _arccos(x) {
    // arccos(x) = π/2 - arcsin(x)
    // arcsin(x) ≈ x + x^3/6 + 3x^5/40 + ... for |x| <= 1
    let x_clamped = x;
    if x_clamped > 1.0 {
        x_clamped = 1.0;
    }
    if x_clamped < -1.0 {
        x_clamped = -1.0;
    }

    let x2 = x_clamped * x_clamped;
    let x3 = x2 * x_clamped;
    let x5 = x3 * x2;
    let x7 = x5 * x2;

    let arcsin = x_clamped + x3 / 6.0 + 3.0 * x5 / 40.0 + 5.0 * x7 / 112.0;

    return 1.5707963267948966 - arcsin;
}

// Helper: sine approximation using Taylor series
fn num_sin(x) {
    // Normalize x to [-π, π]
    let normalized = x;
    while normalized > 3.14159265358979 {
        normalized = normalized - 6.28318530717958;
    }
    while normalized < -3.14159265358979 {
        normalized = normalized + 6.28318530717958;
    }

    // Taylor series: sin(x) ≈ x - x^3/6 + x^5/120 - x^7/5040
    let x2 = normalized * normalized;
    let x3 = x2 * normalized;
    let x5 = x3 * x2;
    let x7 = x5 * x2;

    return normalized - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0;
}

// Helper: cosine approximation using Taylor series
fn num_cos(x) {
    // cos(x) ≈ 1 - x^2/2 + x^4/24 - x^6/720
    let x2 = x * x;
    let x4 = x2 * x2;
    let x6 = x4 * x2;

    return 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0;
}

// Helper: round to decimal places
fn num_round(x, decimals) {
    let factor = 1.0;
    let i = 0;
    while i < decimals {
        factor = factor * 10.0;
        i = i + 1;
    }
    let shifted = x * factor;
    let rounded = num_floor(shifted + 0.5);
    return rounded / factor;
}

export bloch_angles, bloch_to_svg;
