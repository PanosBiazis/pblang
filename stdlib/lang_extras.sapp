// stdlib/lang_extras.sapp — cross-language convenience helpers.
// These are pure pblang building blocks inspired by Python, JavaScript,
// Rust/Kotlin, and functional pipelines.

fn range(start, end_value = nil, step_value = nil) {
    let first = start;
    let last = end_value;
    let step = step_value;
    if last == nil {
        last = first;
        first = 0;
    }
    if step == nil { step = 1; }
    if step == 0 { throw "range step cannot be 0"; }

    let out = [];
    let i = first;
    if step > 0 {
        while i < last {
            array_push(out, i);
            i = i + step;
        }
    } else {
        while i > last {
            array_push(out, i);
            i = i + step;
        }
    }
    return out;
}

fn enumerate(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        array_push(out, [i, arr[i]]);
        i = i + 1;
    }
    return out;
}

fn zip(a, b) {
    let out = [];
    let n = len(a);
    if len(b) < n { n = len(b); }
    let i = 0;
    while i < n {
        array_push(out, [a[i], b[i]]);
        i = i + 1;
    }
    return out;
}

fn reversed(arr) {
    let out = [];
    let i = len(arr) - 1;
    while i >= 0 {
        array_push(out, arr[i]);
        i = i - 1;
    }
    return out;
}

fn keys(m) {
    return map_keys(m);
}

fn values(m) {
    let out = [];
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        array_push(out, m[ks[i]]);
        i = i + 1;
    }
    return out;
}

fn entries(m) {
    let out = [];
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        array_push(out, [ks[i], m[ks[i]]]);
        i = i + 1;
    }
    return out;
}

fn from_entries(pairs) {
    let out = map{};
    let i = 0;
    while i < len(pairs) {
        out[str(pairs[i][0])] = pairs[i][1];
        i = i + 1;
    }
    return out;
}

fn pick(m, wanted) {
    let out = map{};
    let i = 0;
    while i < len(wanted) {
        if map_has(m, wanted[i]) { out[wanted[i]] = m[wanted[i]]; }
        i = i + 1;
    }
    return out;
}

fn omit(m, blocked) {
    let out = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let skip = false;
        let j = 0;
        while j < len(blocked) {
            if ks[i] == blocked[j] { skip = true; }
            j = j + 1;
        }
        if skip == false { out[ks[i]] = m[ks[i]]; }
        i = i + 1;
    }
    return out;
}

fn get_path(obj, path, fallback = nil) {
    let cur = obj;
    let i = 0;
    while i < len(path) {
        if cur == nil { return fallback; }
        let next = try cur[path[i]] catch fallback;
        if next == nil { return fallback; }
        cur = next;
        i = i + 1;
    }
    return cur;
}

fn unwrap_or(value, fallback) {
    if value == nil { return fallback; }
    return value;
}

fn expect(value, message) {
    if value == nil { throw message; }
    return value;
}

fn tap(value, fn_value) {
    fn_value(value);
    return value;
}

fn pipe(value, fns) {
    let current = value;
    let i = 0;
    while i < len(fns) {
        current = fns[i](current);
        i = i + 1;
    }
    return current;
}

fn take_if(value, predicate) {
    if predicate(value) { return value; }
    return nil;
}

fn take_unless(value, predicate) {
    if predicate(value) { return nil; }
    return value;
}

fn repeat(count, fn_value) {
    let out = [];
    let i = 0;
    while i < count {
        array_push(out, fn_value(i));
        i = i + 1;
    }
    return out;
}

fn clamp(value, low, high) {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

export range, enumerate, zip, reversed;
export keys, values, entries, from_entries, pick, omit, get_path;
export unwrap_or, expect, tap, pipe, take_if, take_unless;
export repeat, clamp;
