// Four-card portable reader with local answer reveal/hide, not persistent ratings.
let Study=import("stdlib:study_cards.sapp"); let UI=import("stdlib:modern_ui.sapp");
fn create(deck,today,page=0) {
    let cards=Study.due(deck,today); let count=num_max(1,num_floor((len(cards)+3)/4));
    if type(page)!="number" or not (page>=0 and page<count) or page!=num_floor(page) { throw "study view: invalid page"; }
    let children=[UI.heading("PBStudy"),UI.text("Due cards: "+str(len(cards))+" | Page "+str(page+1)+" / "+str(count)),
        UI.text("Local reveal only. Answers are included in the exported reader; review progress is not saved.")];
    for i in range(page*4,num_min(page*4+4,len(cards))) {
        let c=cards[i]; let target="answer_"+str(c.id);
        array_push(children,UI.card([UI.text(c.prompt),UI.text("Answer hidden.",map{name:target}),
            UI.row([UI.button("Reveal",UI.action_set_text(target,c.answer),map{name:"reveal_"+str(c.id)}),
                UI.button("Hide",UI.action_set_text(target,"Answer hidden."),map{name:"hide_"+str(c.id)})])],map{title:"Card "+str(c.id)}));
    }
    return UI.screen(children);
}
export create;

// Compact lesson reader: every question and answer is explicitly selectable.
// Local controls only; generated Android inputs are not a persistence surface.
fn reader(deck,today) {
    let cards=Study.due(deck,today);
    if len(cards)>8 { throw "study reader: at most eight due cards"; }
    let children=[UI.heading("PBLesson cards"),UI.text("Select a question, then its answer. All answers are included locally."),
        UI.area(if len(cards)>0 {cards[0].prompt} else {"No cards due."},map{name:"reader_question",readonly:true,h:120}),
        UI.area("Answer hidden.",map{name:"reader_answer",readonly:true,h:120})];
    let buttons=[];
    for c in cards {
        array_push(buttons,UI.button("Question "+str(c.id),UI.action_sequence([UI.action_set_text("reader_question",c.prompt),UI.action_set_text("reader_answer","Answer hidden.")]),map{name:"question_"+str(c.id)}));
        array_push(buttons,UI.button("Answer "+str(c.id),UI.action_sequence([UI.action_set_text("reader_question",c.prompt),UI.action_set_text("reader_answer",c.answer)]),map{name:"show_answer_"+str(c.id)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4})); return UI.screen(children);
}
export reader;
