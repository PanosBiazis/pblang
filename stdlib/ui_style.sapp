// Shared semantic presentation. Pure values; no renderer, device or application effects.
// Opt-in presets leave existing product palettes and layouts unchanged.
fn palette(name = "dark") {
    if name != "dark" and name != "light" { throw "ui_style theme must be dark or light"; }
    if name == "light" {
        return map{bg:[246,248,252],panel:[255,255,255],field:[255,255,255],
            border:[174,185,205],accent:[67,56,202],text:[23,32,51],muted:[79,94,117],
            on_accent:[255,255,255],selected:[15,110,86],danger:[185,28,46],focus:[29,78,216]};
    }
    return map{bg:[15,20,32],panel:[24,33,50],field:[19,27,43],
        border:[92,109,137],accent:[104,82,224],text:[237,242,252],muted:[172,185,207],
        on_accent:[255,255,255],selected:[15,110,86],danger:[185,28,46],focus:[147,197,253]};
}

fn options(name = "dark") {
    return map{theme:name,palette:palette(name),text_render:"auto",card_radius:14};
}

// nil preserves each platform's existing card geometry.
fn card_radius(options) {
    let value=try options.card_radius catch nil;
    if value==nil { return nil; }
    if type(value)!="number" or not (value>=0 and value<=32)
        or value!=num_floor(value) { throw "ui_style card radius must be an integer from 0 to 32"; }
    return value;
}

// Unknown legacy variants retain the primary role. Selection is an explicit bool.
fn button(colors, variant = "primary", selected = false, enabled = true) {
    let fill=colors.accent; let border=colors.accent; let text=colors.on_accent;
    if variant == "secondary" or variant == "navigation" {
        fill=colors.panel; border=colors.border; text=colors.text;
    } elif variant == "ghost" {
        fill=colors.bg; border=colors.bg; text=colors.text;
    } elif variant == "danger" {
        fill=colors.danger; border=colors.danger;
    }
    if selected == true { fill=colors.selected; border=colors.selected; text=colors.on_accent; }
    if not enabled { fill=colors.panel; border=colors.field; text=colors.muted; }
    return map{fill:fill,border:border,text:text};
}

fn tone(colors, name, fallback) {
    if name == "accent" or name == "primary" { return colors.accent; }
    if name == "success" { return colors.selected; }
    if name == "danger" { return colors.danger; }
    if name == "muted" { return colors.muted; }
    return fallback;
}
fn card_validate(options) {
    if type(options)!="map" {throw "ui_style card options must be a map";}
    card_radius(options);
    if map_has(options,"card_variant") {
        let value=options.card_variant;
        if value!="surface" and value!="outlined" and value!="tonal" {
            throw "card_variant must be surface, outlined or tonal";
        }
    }
    let elevation=try options.card_elevation catch nil;
    if elevation!=nil and (type(elevation)!="number" or not (elevation>=0 and elevation<=8)
        or elevation!=num_floor(elevation)) {throw "card_elevation must be an integer from 0 to 8";}
    return true;
}
fn card(colors,options) {
    card_validate(options);
    let variant=try options.card_variant catch "surface";
    let fill=colors.panel;let border=colors.border;
    if variant=="outlined" {border=colors.accent;}
    elif variant=="tonal" {fill=colors.field;border=colors.field;}
    return map{fill:fill,border:border};
}
fn card_preset(name="surface",overrides=nil) {
    let radius=14;let elevation=2;
    if name=="outlined" {elevation=0;}
    elif name=="tonal" {radius=20;elevation=0;}
    elif name!="surface" {throw "unknown ui_style card preset";}
    let out=map{card_variant:name,card_radius:radius,card_elevation:elevation};
    if overrides!=nil {
        if type(overrides)!="map" {throw "card preset overrides must be a map";}
        for key in map_keys(overrides) {out[key]=overrides[key];}
    }
    card_validate(out);return out;
}
export palette,options,button,tone,card_radius,card_validate,card,card_preset;
