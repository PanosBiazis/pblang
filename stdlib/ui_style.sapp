// Shared semantic presentation. Pure values; no renderer, device or application effects.
// Opt-in presets leave existing product palettes and layouts unchanged.
fn palette(name = "dark") {
    if name != "dark" and name != "light" { throw "ui_style theme must be dark or light"; }
    if name == "light" {
        return map{bg:[246,248,252],panel:[255,255,255],field:[255,255,255],
            border:[174,185,205],accent:[67,56,202],text:[23,32,51],muted:[79,94,117],
            on_accent:[255,255,255],selected:[15,110,86],danger:[185,28,46],focus:[29,78,216]};
    }
    return map{bg:[15,20,32],panel:[24,33,50],field:[19,27,43],
        border:[92,109,137],accent:[104,82,224],text:[237,242,252],muted:[172,185,207],
        on_accent:[255,255,255],selected:[15,110,86],danger:[185,28,46],focus:[147,197,253]};
}

fn options(name = "dark") {
    return map{theme:name,palette:palette(name),text_render:"auto"};
}

// Unknown legacy variants retain the primary role. Selection is an explicit bool.
fn button(colors, variant = "primary", selected = false, enabled = true) {
    let fill=colors.accent; let border=colors.accent; let text=colors.on_accent;
    if variant == "secondary" or variant == "navigation" {
        fill=colors.panel; border=colors.border; text=colors.text;
    } elif variant == "ghost" {
        fill=colors.bg; border=colors.bg; text=colors.text;
    } elif variant == "danger" {
        fill=colors.danger; border=colors.danger;
    }
    if selected == true { fill=colors.selected; border=colors.selected; text=colors.on_accent; }
    if not enabled { fill=colors.panel; border=colors.field; text=colors.muted; }
    return map{fill:fill,border:border,text:text};
}

fn tone(colors, name, fallback) {
    if name == "accent" or name == "primary" { return colors.accent; }
    if name == "success" { return colors.selected; }
    if name == "danger" { return colors.danger; }
    if name == "muted" { return colors.muted; }
    return fallback;
}
export palette,options,button,tone;
