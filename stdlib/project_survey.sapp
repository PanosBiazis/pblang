// stdlib/project_survey.sapp -- safe path-to-ideas survey for AAP projects.
//
// This module intentionally reasons from path/name metadata only. It avoids
// reading file contents, skips secret/cache/build locations, and returns
// deterministic project improvement ideas that other tools can use safely.

let PRODUCT_HEALTH = import("stdlib:product_health.sapp");

fn _lower(x) { return str_lower(str(x ?? "")); }

fn _base(path) {
    let parts = str_split(str(path ?? ""), "/");
    if len(parts) == 0 { return ""; }
    let b = parts[len(parts) - 1];
    if b == "" and len(parts) > 1 { b = parts[len(parts) - 2]; }
    return b;
}

fn _contains_any(text, needles) {
    let t = _lower(text);
    let i = 0;
    while i < len(needles) {
        if str_contains(t, _lower(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _sensitive_name(name) {
    let n = _lower(name);
    if n == "" { return false; }
    if n == ".git" or n == ".ssh" or n == ".gnupg" or n == ".cache" { return true; }
    if n == "target" or n == "node_modules" or n == "__pycache__" or n == ".venv" { return true; }
    if n == "cache" or n == "tmp" or n == "temp" or n == "build" or n == "dist" { return true; }
    if str_contains(n, "credential") or str_contains(n, "password") or str_contains(n, "passwd") { return true; }
    if str_contains(n, "secret") or str_contains(n, "token") or str_contains(n, "openrouter") { return true; }
    if str_contains(n, "api_key") or str_contains(n, "access_key") { return true; }
    if str_starts_with(n, "id_ed25519") or str_starts_with(n, "id_rsa") { return true; }
    if str_ends_with(n, ".pem") or str_ends_with(n, ".p12") or str_ends_with(n, ".pfx") or str_ends_with(n, ".key") { return true; }
    return false;
}

fn sensitive_path(path) {
    let parts = str_split(str(path ?? ""), "/");
    let i = 0;
    while i < len(parts) {
        if _sensitive_name(parts[i]) { return true; }
        i = i + 1;
    }
    return false;
}

fn path_category(path) {
    let p = _lower(path);
    let b = _lower(_base(path));
    if _contains_any(p, ["pb-mcp", "mcp-server", "/mcp/", "modelcontextprotocol"]) { return "mcp"; }
    if _contains_any(p, ["pbai", "/ai/", "llm", "model", "dataset", "tokenizer", "neural", "onnx"]) { return "ai"; }
    if _contains_any(p, ["pbide", "/ide/", "editor", "designer", "gui", "ui", "ux", "qt", "gtk"]) { return "ide"; }
    if _contains_any(p, ["pbos", "/os-", "/kernel", "boot", "driver", "firmware", "efi"]) { return "os"; }
    if _contains_any(p, ["opengl", "vulkan", "mesa", "sdl", "gpu", "shader", "render", "graphics"]) { return "graphics"; }
    if _contains_any(p, ["security", "audit", "secscan", "sandbox", "capability", "crypto", "tls"]) { return "security"; }
    if _contains_any(p, ["bench", "benchmark", "perf", "profile", "criterion"]) { return "bench"; }
    if _contains_any(p, ["pbremote", "remote-desktop", "remote_control", "webrtc", "tailscale", "network", "socket", "quic", "relay"]) { return "networking"; }
    if _contains_any(p, ["web", "html", "css", "browser", "dom", "http", "wasm"]) { return "web"; }
    if _contains_any(p, ["android", "mobile", "ios", "phone"]) { return "mobile"; }
    if _contains_any(p, ["database", "sqlite", "postgres", "mysql", "db"]) { return "database"; }
    if _contains_any(p, ["quantum", "qpu", "qubit"]) { return "quantum"; }
    if _contains_any(p, ["arduino", "embedded", "iot", "sensor", "microcontroller"]) { return "embedded"; }
    if _contains_any(p, ["game", "unity", "godot", "unreal"]) { return "game"; }
    if _contains_any(p, ["docker", "ci", "workflow", "deploy", "devops", "k8s"]) { return "devops"; }
    if _contains_any(p, ["course", "docs", "book", "paper", "corpus", "data"]) { return "data"; }
    if b == "pblang" or str_contains(p, "/pl-dev/") { return "language"; }
    return "unknown";
}

fn path_record(path) {
    let raw = str(path ?? "");
    let sensitive = sensitive_path(raw);
    let cat = path_category(raw);
    let shown = raw;
    if sensitive { shown = "[redacted]/" + _base(raw); }
    let reason = "metadata-only";
    if sensitive { reason = "sensitive path skipped"; }
    return map{
        format: "pblang.project_survey.path.v1",
        path: shown,
        name: _base(raw),
        category: cat,
        safe_for_ideas: not sensitive,
        reason: reason
    };
}

fn survey_paths(paths, limit = 1000) {
    if paths == nil { paths = []; }
    if limit == nil or limit < 1 { limit = 1000; }
    let records = [];
    let counts = map{};
    let skipped = 0;
    let i = 0;
    while i < len(paths) and i < limit {
        let rec = path_record(paths[i]);
        if rec.safe_for_ideas {
            array_push(records, rec);
            let c = try counts[rec.category] catch 0;
            counts[rec.category] = c + 1;
        } else {
            skipped = skipped + 1;
        }
        i = i + 1;
    }
    return map{
        format: "pblang.project_survey.report.v1",
        scanned: i,
        records: records,
        counts: counts,
        skipped_sensitive: skipped,
        policy: "path metadata only; no file contents; sensitive/cache/build paths skipped"
    };
}

fn _add_once(arr, text) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == text { return arr; }
        i = i + 1;
    }
    array_push(arr, text);
    return arr;
}

fn _has_category(records, cat) {
    let i = 0;
    while i < len(records) {
        if records[i].category == cat { return true; }
        i = i + 1;
    }
    return false;
}

fn _present_focus(records, focus) {
    let out = [];
    let i = 0;
    while i < len(focus) {
        if _has_category(records, focus[i]) { array_push(out, focus[i]); }
        i = i + 1;
    }
    return out;
}

fn _missing_focus(records, focus) {
    let out = [];
    let i = 0;
    while i < len(focus) {
        if not _has_category(records, focus[i]) { array_push(out, focus[i]); }
        i = i + 1;
    }
    return out;
}

fn _first_n(arr, n) {
    if n == nil or n < 1 { n = len(arr); }
    let out = [];
    let i = 0;
    while i < len(arr) and i < n {
        array_push(out, arr[i]);
        i = i + 1;
    }
    return out;
}

fn project_focus(project) {
    let p = _lower(project);
    if p == "pblang" {
        return ["language", "graphics", "security", "bench", "web", "ai", "os"];
    }
    if p == "pbai" {
        return ["ai", "data", "bench", "security", "graphics", "language"];
    }
    if p == "pbos" {
        return ["os", "security", "embedded", "graphics", "language", "bench"];
    }
    if p == "pbide" {
        return ["ide", "graphics", "web", "security", "database", "ai", "bench"];
    }
    if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        return ["mcp", "security", "devops", "ide", "ai", "database"];
    }
    if p == "pbremote" {
        return ["networking", "security", "mobile", "web", "graphics", "bench", "language"];
    }
    return ["security", "bench", "data"];
}

fn _device_routes(project) {
    let p = _lower(project);
    if p == "pblang" {
        return ["VM/JIT/AOT route selection", "GPU-present graphics", "parallel/polyglot workers"];
    }
    if p == "pbai" {
        return ["CPU-safe baseline", "GPU/tensor route metadata", "parallel training/eval workers"];
    }
    if p == "pbos" {
        return ["VM-tested pure modules", "freestanding backend later", "capability-gated devices"];
    }
    if p == "pbide" {
        return ["batched CPU raster", "SDL2 GPU-present route", "micro_gui panels and cached hit regions"];
    }
    if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        return ["read-only defaults", "write/network gates", "agent/tool registry"];
    }
    if p == "pbremote" {
        return ["loopback or trusted encrypted tunnel", "Linux and Android peer nodes", "capability-scoped transport adapters"];
    }
    return ["safe local execution", "bounded resource profile"];
}

fn _readiness_gates(project, skipped) {
    let gates = [
        "metadata-only survey before content ingestion",
        "secret/cache/build paths skipped",
        "focused tests must verify every behavior claim"
    ];
    let p = _lower(project);
    if p == "pbai" {
        array_push(gates, "training data must pass sanitization and benchmark gates");
    } else if p == "pbide" {
        array_push(gates, "render/input changes need watcher-visible timings and hit tests");
    } else if p == "pbos" {
        array_push(gates, "kernel/device authority stays capability-scoped");
    } else if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        array_push(gates, "tool read/write/network classes must be explicit");
    } else if p == "pbremote" {
        array_push(gates, "remote authority requires pairing, encryption, replay protection, capability checks, quotas, revocation, and audit");
    }
    if skipped > 0 {
        array_push(gates, str(skipped) + " sensitive path(s) were ignored");
    }
    return gates;
}

fn _readiness_score(report, present, focus) {
    let total = len(focus);
    if total < 1 { total = 1; }
    let score = 40 + num_floor((len(present) * 45) / total);
    if (try report.skipped_sensitive catch 0) > 0 { score = score - 5; }
    if len(try report.records catch []) == 0 { score = 0; }
    if score < 0 { score = 0; }
    if score > 95 { score = 95; }
    return score;
}

fn _readiness_status(score, safe_count) {
    if safe_count == 0 { return "empty"; }
    if score >= 80 { return "strong"; }
    if score >= 60 { return "ready"; }
    return "needs-data";
}

fn _next_actions(project, ideas, missing) {
    let out = [];
    if len(ideas) > 0 { array_push(out, ideas[0]); }
    if len(missing) > 0 {
        array_push(out, "Add safe examples/metadata for missing focus: " + str_join(_first_n(missing, 4), ", "));
    }
    let p = _lower(project);
    if p == "pbide" {
        array_push(out, "Keep render/input changes measured by watchers before claiming faster UI.");
    } else if p == "pbai" {
        array_push(out, "Feed only curated, sanitized, validation-split data into pbAI-Max training.");
    } else if p == "pblang" {
        array_push(out, "Prefer cache/parallel/polyglot acceleration behind stable language contracts.");
    } else if p == "pbos" {
        array_push(out, "Keep pure VM-tested layers separate from future freestanding kernel claims.");
    } else if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        array_push(out, "Keep new tools read-only by default unless an explicit gate is attached.");
    } else if p == "pbremote" {
        array_push(out, "Keep remote services disabled until their capability, quotas, cancellation, revocation, and negative tests pass.");
    }
    return out;
}

fn category_protocols(category) {
    let c = _lower(category);
    if c == "security" {
        return ["capability gates", "secret redaction", "deny-by-default policy", "audit trail", "origin/path allowlists"];
    }
    if c == "graphics" {
        return ["dirty-region rendering", "rect/text batching", "glyph/cache atlas", "GPU-present route", "frame scheduler"];
    }
    if c == "ai" {
        return ["curated corpus manifest", "secret/noise filtering", "validation split", "verified generation", "feedback/eval loop"];
    }
    if c == "mcp" {
        return ["tool schema validation", "read/write/network classification", "central egress gate", "rate limits", "sensitive-field redaction"];
    }
    if c == "os" {
        return ["capability-scoped devices", "syscall gate", "driver profile", "QEMU/VM exit test", "memory map contract"];
    }
    if c == "ide" {
        return ["cached hit regions", "watcher diagnostics", "UI observer snapshots", "command palette routes", "responsive panel metrics"];
    }
    if c == "web" {
        return ["URL policy", "safe parser", "origin/CORS gate", "JS/DOM opt-in profile", "tracker/adblock rules"];
    }
    if c == "networking" {
        return ["authenticated encrypted transport", "strict replay protection", "bounded frames and queues", "timeouts and cancellation", "direct then relay fallback"];
    }
    if c == "database" {
        return ["connection profile", "transaction wrapper", "backup-before-write", "migration plan", "query limit"];
    }
    if c == "bench" {
        return ["timings", "slow-test threshold", "cache hit report", "resource budget", "regression gate"];
    }
    if c == "data" {
        return ["metadata-only intake", "format detector", "dedupe/filter", "license/privacy gate", "train/validation split"];
    }
    if c == "language" {
        return ["semantic tests", "compile/test cache", "VM/JIT/AOT route", "stdlib contract", "backward compatibility gate"];
    }
    if c == "embedded" {
        return ["small-memory profile", "device capability map", "bounded scheduler", "portable fallback", "hardware probe gate"];
    }
    if c == "quantum" {
        return ["simulator-first contract", "provider adapter", "measurement validation", "quota gate", "fallback circuit"];
    }
    if c == "devops" {
        return ["CI matrix", "release manifest", "artifact checksum", "cross-target build plan", "rollback note"];
    }
    return ["bounded implementation", "explicit tests", "safety gate"];
}

fn _task_score(impact, effort, risk) {
    let score = impact * 10 - effort * 3 - risk * 2;
    if score < 1 { score = 1; }
    return score;
}

fn _task(project, category, title, impact, effort, risk, route, gates) {
    return map{
        format: "pblang.project_survey.action_task.v1",
        project: project,
        category: category,
        title: title,
        impact: impact,
        effort: effort,
        risk: risk,
        score: _task_score(impact, effort, risk),
        device_route: route,
        protocols: category_protocols(category),
        gates: gates,
        status: "planned"
    };
}

fn _category_risk(project, category, present) {
    let p = _lower(project);
    let c = _lower(category);
    if present {
        if c == "security" or c == "graphics" or c == "ai" or c == "os" or c == "mcp" { return "watch"; }
        return "normal";
    }
    if c == "security" { return "high"; }
    if p == "pbide" and (c == "graphics" or c == "ide" or c == "web") { return "high"; }
    if p == "pbai" and (c == "ai" or c == "data" or c == "bench") { return "high"; }
    if p == "pbos" and (c == "os" or c == "embedded") { return "high"; }
    if (p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp") and c == "mcp" { return "high"; }
    if p == "pbremote" and (c == "networking" or c == "security" or c == "mobile") { return "high"; }
    return "medium";
}

fn _category_status(present, risk) {
    if present {
        if risk == "watch" { return "present-watch"; }
        return "present";
    }
    if risk == "high" { return "missing-high"; }
    return "missing";
}

fn _category_priority(project, category, present, position) {
    let base = 100 - position * 7;
    let risk = _category_risk(project, category, present);
    let bonus = 0;
    if risk == "high" { bonus = 25; }
    else if risk == "watch" { bonus = 10; }
    else if risk == "medium" { bonus = 12; }
    if present { bonus = bonus - 12; }
    let score = base + bonus;
    if score < 1 { return 1; }
    return score;
}

fn _category_next_step(project, category, present) {
    let c = _lower(category);
    let p = _lower(project);
    if not present {
        if c == "security" { return "Add a deny-by-default gate, redaction rule, and regression test before expanding behavior."; }
        if c == "graphics" { return "Add a GPU-present/dirty-region example or benchmark path with CPU fallback."; }
        if c == "ai" { return "Add curated, redacted corpus metadata plus eval/loss gates before training growth."; }
        if c == "mcp" { return "Add explicit read/write/network/secret classification for this tool surface."; }
        if c == "os" { return "Add a pure VM-tested OS layer before kernel/device claims."; }
        if c == "web" { return "Add safe URL/origin/browser-mode handling before live interactivity grows."; }
        if c == "networking" { return "Add authenticated transport, replay rejection, bounded queues, timeouts, and negative tests before remote exposure."; }
        return "Add safe metadata, docs, and one focused regression test for " + str(category) + ".";
    }
    if p == "pbide" and c == "graphics" { return "Measure frame time, input latency, dirty regions, and GPU-present route in Watchers."; }
    if p == "pbai" and c == "ai" { return "Run a small train/eval loop, compare loss, and only promote verified checkpoints."; }
    if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" { return "Keep gates centralized and default every new tool to read-only."; }
    return "Keep tests and docs synchronized before increasing scope.";
}

fn project_category_health(project, records) {
    if records == nil { records = []; }
    let focus = project_focus(project);
    let rows = [];
    let present_count = 0;
    let missing_count = 0;
    let high_count = 0;
    let i = 0;
    while i < len(focus) {
        let cat = focus[i];
        let present = _has_category(records, cat);
        if present { present_count = present_count + 1; } else { missing_count = missing_count + 1; }
        let risk = _category_risk(project, cat, present);
        if risk == "high" { high_count = high_count + 1; }
        let priority = _category_priority(project, cat, present, i);
        array_push(rows, map{
            format: "pblang.project_survey.category_health_row.v1",
            project: project,
            category: cat,
            status: _category_status(present, risk),
            present: present,
            risk: risk,
            priority: priority,
            score: priority,
            device_route: _project_route(project, cat),
            protocols: category_protocols(cat),
            gates: _base_gates(project, cat),
            next_step: _category_next_step(project, cat, present)
        });
        i = i + 1;
    }
    let status = "ready";
    if len(records) == 0 { status = "empty"; }
    else if high_count > 0 { status = "high-risk"; }
    else if missing_count > 0 { status = "needs-work"; }
    return map{
        format: "pblang.project_survey.category_health.v1",
        project: project,
        status: status,
        focus: focus,
        present_count: present_count,
        missing_count: missing_count,
        high_risk_missing: high_count,
        rows: _sort_tasks(rows),
        policy: "metadata-only category health; validate every task with tests before implementation"
    };
}

fn portfolio_category_health(paths, projects = nil) {
    if projects == nil { projects = ["pblang", "pbai", "pbos", "pbide", "pb-mcp-server", "pbremote"]; }
    let survey = survey_paths(paths, 4000);
    let boards = [];
    let rows = [];
    let high = 0;
    let i = 0;
    while i < len(projects) {
        let board = project_category_health(projects[i], survey.records);
        array_push(boards, board);
        high = high + (try board.high_risk_missing catch 0);
        let rs = try board.rows catch [];
        let j = 0;
        while j < len(rs) {
            array_push(rows, rs[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let status = "ready";
    if len(try survey.records catch []) == 0 { status = "empty"; }
    else if high > 0 { status = "high-risk"; }
    return map{
        format: "pblang.project_survey.portfolio_category_health.v1",
        status: status,
        survey: survey,
        projects: boards,
        rows: _sort_tasks(rows),
        high_risk_missing: high,
        policy: "safe metadata-only category health for AAP projects; skips secret/cache/build paths"
    };
}

fn portfolio_category_health_lines(board, limit = 14) {
    if limit == nil or limit < 1 { limit = 14; }
    let b = try board catch map{};
    let survey = try b.survey catch map{};
    let lines = [
        "Portfolio category health: " + str(try b.status catch "unknown"),
        "safe paths=" + str(len(try survey.records catch [])) + " skipped=" + str(try survey.skipped_sensitive catch 0) + " high-risk-missing=" + str(try b.high_risk_missing catch 0),
        "policy: " + str(try b.policy catch "metadata-only")
    ];
    let rows = try b.rows catch [];
    let i = 0;
    while i < len(rows) and len(lines) < limit {
        let r = rows[i];
        array_push(lines, "- " + str(try r.project catch "?") + "/" + str(try r.category catch "?") + " " + str(try r.status catch "?") + " risk=" + str(try r.risk catch "?") + " priority=" + str(try r.priority catch 0) + " :: " + str(try r.next_step catch ""));
        i = i + 1;
    }
    return lines;
}

fn _base_gates(project, category) {
    let gates = [
        "bounded input",
        "focused semantic/regression test",
        "docs current-vs-roadmap update"
    ];
    let p = _lower(project);
    let c = _lower(category);
    if c == "security" or p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        array_push(gates, "deny-by-default capability check");
    }
    if c == "graphics" or p == "pbide" {
        array_push(gates, "watcher-visible render/input timing");
    }
    if c == "ai" or p == "pbai" {
        array_push(gates, "redacted corpus and validation split");
    }
    if c == "os" or p == "pbos" {
        array_push(gates, "VM/QEMU-style exit test before bootability claims");
    }
    return gates;
}

fn _project_route(project, category) {
    let routes = _device_routes(project);
    if _lower(category) == "graphics" {
        return "GPU-present when available; batched CPU raster fallback";
    }
    if _lower(category) == "ai" {
        return "parallel CPU baseline; tensor/GPU route metadata where available";
    }
    if _lower(category) == "bench" {
        return "all CPU cores through pblang parallel test/bench workers";
    }
    if len(routes) > 0 { return routes[0]; }
    return "portable safe local execution";
}

fn _sort_tasks(tasks) {
    let out = [];
    let used = map{};
    while len(out) < len(tasks) {
        let best = 0 - 1;
        let i = 0;
        while i < len(tasks) {
            if not (try used[str(i)] catch false) {
                if best < 0 or tasks[i].score > tasks[best].score {
                    best = i;
                }
            }
            i = i + 1;
        }
        if best < 0 { return out; }
        used[str(best)] = true;
        array_push(out, tasks[best]);
    }
    return out;
}

fn project_improvement_tasks(project, records, limit = 8) {
    if limit == nil or limit < 1 { limit = 8; }
    let p = _lower(project);
    let focus = project_focus(project);
    let present = _present_focus(records, focus);
    let missing = _missing_focus(records, focus);
    let tasks = [];

    if p == "pblang" {
        array_push(tasks, _task("pblang", "language", "Tighten compile/test/cache/JIT route contracts with semantic tests", 9, 4, 3, _project_route(project, "language"), _base_gates(project, "language")));
        array_push(tasks, _task("pblang", "bench", "Keep pblang test profiles resource-aware and benchmark slow suites", 8, 3, 2, _project_route(project, "bench"), _base_gates(project, "bench")));
        if _has_category(records, "graphics") { array_push(tasks, _task("pblang", "graphics", "Promote GPU-present graphics batching into reusable renderer contracts", 8, 5, 4, _project_route(project, "graphics"), _base_gates(project, "graphics"))); }
        if _has_category(records, "security") { array_push(tasks, _task("pblang", "security", "Keep fs/net/exec/polyglot capability gates testable and redaction-aware", 9, 4, 3, _project_route(project, "security"), _base_gates(project, "security"))); }
    } else if p == "pbai" {
        array_push(tasks, _task("pbai", "ai", "Feed pbAI-Max only curated, redacted, validation-split corpus manifests", 10, 5, 4, _project_route(project, "ai"), _base_gates(project, "ai")));
        array_push(tasks, _task("pbai", "bench", "Run small fast train/eval loops before larger checkpoint growth", 9, 4, 3, _project_route(project, "bench"), _base_gates(project, "bench")));
        array_push(tasks, _task("pbai", "security", "Block secrets/caches/binaries from live learning and model memory", 10, 3, 2, _project_route(project, "security"), _base_gates(project, "security")));
        if _has_category(records, "graphics") { array_push(tasks, _task("pbai", "graphics", "Use verified model-state visualization without exposing raw private data", 6, 4, 3, _project_route(project, "graphics"), _base_gates(project, "graphics"))); }
    } else if p == "pbos" {
        array_push(tasks, _task("pbos", "os", "Keep pbOS layers VM-testable before claiming freestanding boot parity", 9, 5, 4, _project_route(project, "os"), _base_gates(project, "os")));
        array_push(tasks, _task("pbos", "security", "Make privilege, device, and filesystem operations capability-scoped", 10, 4, 3, _project_route(project, "security"), _base_gates(project, "security")));
        if _has_category(records, "graphics") { array_push(tasks, _task("pbos", "graphics", "Reuse PBIDE/micro_gui contracts for a lightweight desktop shell", 7, 4, 3, _project_route(project, "graphics"), _base_gates(project, "graphics"))); }
    } else if p == "pbide" {
        array_push(tasks, _task("pbide", "graphics", "Move hot panels toward batched dirty-region GPU-present rendering", 10, 5, 4, _project_route(project, "graphics"), _base_gates(project, "graphics")));
        array_push(tasks, _task("pbide", "ide", "Keep every panel responsive through cached hit regions and shared metrics", 9, 4, 3, _project_route(project, "ide"), _base_gates(project, "ide")));
        array_push(tasks, _task("pbide", "web", "Grow native browser interactivity behind explicit safety modes", 8, 5, 4, _project_route(project, "web"), _base_gates(project, "web")));
        if _has_category(records, "database") { array_push(tasks, _task("pbide", "database", "Keep database management gated by backup/confirm/query-limit contracts", 7, 4, 3, _project_route(project, "database"), _base_gates(project, "database"))); }
    } else if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        array_push(tasks, _task("pb-mcp-server", "mcp", "Classify every tool by read/write/network/destructive/secret behavior", 10, 4, 3, _project_route(project, "mcp"), _base_gates(project, "mcp")));
        array_push(tasks, _task("pb-mcp-server", "security", "Enforce central egress/write/secret gates for every new tool", 10, 4, 3, _project_route(project, "security"), _base_gates(project, "security")));
        if _has_category(records, "devops") { array_push(tasks, _task("pb-mcp-server", "devops", "Add release/CI diagnostic tools with read-only defaults", 7, 3, 2, _project_route(project, "devops"), _base_gates(project, "devops"))); }
    } else if p == "pbremote" {
        array_push(tasks, _task("pbremote", "security", "Keep pairing, sessions, capabilities, replay rejection, revocation, and audit fail-closed", 10, 4, 4, _project_route(project, "security"), _base_gates(project, "security")));
        array_push(tasks, _task("pbremote", "networking", "Build bounded persistent PTY transport over loopback or an authenticated tunnel", 9, 6, 5, _project_route(project, "networking"), _base_gates(project, "networking")));
        array_push(tasks, _task("pbremote", "mobile", "Add an Android peer adapter only after the shared protocol contract passes", 8, 6, 4, _project_route(project, "mobile"), _base_gates(project, "mobile")));
    } else {
        array_push(tasks, _task(project, "security", "Start with safe survey, gates, docs, and tests", 8, 3, 2, _project_route(project, "security"), _base_gates(project, "security")));
    }

    let mi = 0;
    while mi < len(missing) {
        array_push(tasks, _task(project, missing[mi], "Add safe metadata/examples for missing focus " + missing[mi], 6, 2, 1, _project_route(project, missing[mi]), _base_gates(project, missing[mi])));
        mi = mi + 1;
    }

    let sorted = _sort_tasks(tasks);
    let trimmed = _first_n(sorted, limit);
    return map{
        format: "pblang.project_survey.project_action_plan.v1",
        project: project,
        focus: focus,
        present_focus: present,
        missing_focus: missing,
        tasks: trimmed,
        task_count: len(trimmed),
        generated_from: "metadata-only survey records"
    };
}

fn portfolio_action_plan(paths, projects = nil, limit_per_project = 5) {
    if projects == nil { projects = ["pblang", "pbai", "pbos", "pbide", "pb-mcp-server", "pbremote"]; }
    if limit_per_project == nil or limit_per_project < 1 { limit_per_project = 5; }
    let survey = survey_paths(paths, 4000);
    let project_plans = [];
    let all_tasks = [];
    let i = 0;
    while i < len(projects) {
        let plan = project_improvement_tasks(projects[i], survey.records, limit_per_project);
        array_push(project_plans, plan);
        let j = 0;
        while j < len(plan.tasks) {
            array_push(all_tasks, plan.tasks[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let ordered = _sort_tasks(all_tasks);
    return map{
        format: "pblang.project_survey.portfolio_action_plan.v1",
        survey: survey,
        projects: project_plans,
        tasks: ordered,
        top_tasks: _first_n(ordered, 10),
        policy: "metadata-only action planning; verify every change with tests; sensitive/cache/build paths are skipped"
    };
}

fn portfolio_action_lines(plan, limit = 16) {
    if limit == nil or limit < 1 { limit = 16; }
    let p = try plan catch map{};
    let survey = try p.survey catch map{};
    let lines = [
        "Portfolio action plan: " + str(len(try p.projects catch [])) + " project(s)",
        "safe paths=" + str(len(try survey.records catch [])) + " skipped=" + str(try survey.skipped_sensitive catch 0),
        "policy: " + str(try p.policy catch "metadata-only")
    ];
    let tasks = try p.top_tasks catch try p.tasks catch [];
    let i = 0;
    while i < len(tasks) and len(lines) < limit {
        let t = tasks[i];
        array_push(lines, "- " + str(t.project) + "/" + str(t.category) + " score=" + str(t.score) + " :: " + str(t.title));
        i = i + 1;
    }
    return lines;
}

fn ideas_for_project(project, records) {
    let p = _lower(project);
    let ideas = [];

    if p == "pblang" {
        _add_once(ideas, "Use machine_opt + project_survey metadata to choose VM/JIT/AOT/GPU routes per workload.");
        if _has_category(records, "graphics") { _add_once(ideas, "Promote graphics paths into batched GPU-present render plans and renderer benchmarks."); }
        if _has_category(records, "os") { _add_once(ideas, "Keep OS-level features behind explicit capability gates and portable backend contracts."); }
        if _has_category(records, "bench") { _add_once(ideas, "Add unchanged-source compile/test cache benchmarks and regression thresholds."); }
        if _has_category(records, "security") { _add_once(ideas, "Run secret/path/capability checks before learning, serving, or tool execution."); }
    } else if p == "pbai" {
        _add_once(ideas, "Build curated corpus manifests from safe text-like records and reject secrets/noise before training.");
        _add_once(ideas, "Keep verified generation, repair, evaluation, and distillation gates in the model core.");
        if _has_category(records, "bench") { _add_once(ideas, "Expand eval prompts and track loss/perplexity/accuracy per checkpoint."); }
        if _has_category(records, "graphics") { _add_once(ideas, "Use GPU/tensor route metadata for faster training and visualization."); }
        if _has_category(records, "security") { _add_once(ideas, "Prevent private keys, tokens, caches, and binary installers from entering training data."); }
    } else if p == "pbos" {
        _add_once(ideas, "Turn boot, driver, memory, process, service, and shell features into capability-tested layers.");
        if _has_category(records, "embedded") { _add_once(ideas, "Add embedded/legacy device profiles with small-memory scheduler tests."); }
        if _has_category(records, "security") { _add_once(ideas, "Make privilege transitions, syscalls, and filesystem access deny-by-default."); }
        if _has_category(records, "graphics") { _add_once(ideas, "Share PBIDE/micro_gui rendering contracts for a lightweight desktop shell."); }
    } else if p == "pbide" {
        _add_once(ideas, "Move hot panels onto micro_gui-style batched layout, cached hit regions, and GPU-present routes.");
        _add_once(ideas, "Keep UI observer snapshots, event counters, and render timings visible in Watchers.");
        if _has_category(records, "web") { _add_once(ideas, "Grow the native browser from safe flow layout toward CSS/DOM/JS modes behind safety gates."); }
        if _has_category(records, "graphics") { _add_once(ideas, "Benchmark draw_rects/text caches and prefer batched primitives over per-pixel repaint."); }
        if _has_category(records, "database") { _add_once(ideas, "Keep database tools behind connection, backup, path, and confirmation gates."); }
    } else if p == "pb-mcp-server" or p == "pb-mcp" or p == "mcp" {
        _add_once(ideas, "Classify every tool as read/write/network/secret-sensitive and enforce gates centrally.");
        _add_once(ideas, "Use project_survey categories to propose useful tools without exposing sensitive paths.");
        if _has_category(records, "devops") { _add_once(ideas, "Add CI/release/diagnostic tools with explicit read-only defaults."); }
        if _has_category(records, "ide") { _add_once(ideas, "Expose IDE-aware tools for diagnostics, UI snapshots, and safe project navigation."); }
    } else if p == "pbremote" {
        _add_once(ideas, "Keep Linux and Android as peer nodes with negotiated, attenuation-only remote capabilities.");
        _add_once(ideas, "Ship loopback or trusted-tunnel transport first; require vetted TLS/QUIC before direct Internet exposure.");
        _add_once(ideas, "Add PTY, files, desktop, input, and media one service at a time with quotas, cancellation, revocation, and audit tests.");
    } else {
        _add_once(ideas, "Start with safe metadata survey, security gates, benchmarks, docs, and regression tests.");
    }

    return map{
        format: "pblang.project_survey.ideas.v1",
        project: project,
        focus: project_focus(project),
        ideas: ideas
    };
}

fn portfolio_readiness(paths, projects = nil) {
    if projects == nil { projects = ["pblang", "pbai", "pbos", "pbide", "pb-mcp-server", "pbremote"]; }
    let survey = survey_paths(paths, 2000);
    let rows = [];
    let priorities = [];
    let i = 0;
    while i < len(projects) {
        let project = projects[i];
        let focus = project_focus(project);
        let present = _present_focus(survey.records, focus);
        let missing = _missing_focus(survey.records, focus);
        let ideas = ideas_for_project(project, survey.records);
        let score = _readiness_score(survey, present, focus);
        let status = _readiness_status(score, len(survey.records));
        let actions = _next_actions(project, ideas.ideas, missing);
        array_push(rows, map{
            format: "pblang.project_survey.portfolio_project.v1",
            project: project,
            focus: focus,
            present_focus: present,
            missing_focus: missing,
            readiness_score: score,
            status: status,
            ideas: ideas.ideas,
            gates: _readiness_gates(project, survey.skipped_sensitive),
            device_routes: _device_routes(project),
            next_actions: actions
        });
        if len(actions) > 0 {
            _add_once(priorities, str(project) + ": " + str(actions[0]));
        }
        i = i + 1;
    }
    return map{
        format: "pblang.project_survey.portfolio_readiness.v1",
        survey: survey,
        projects: rows,
        top_priorities: priorities,
        policy: "metadata-only readiness; do not read private files, train from raw paths, or claim completion without tests"
    };
}

fn portfolio_readiness_lines(portfolio, limit = 10) {
    if limit == nil or limit < 1 { limit = 10; }
    let p = try portfolio catch map{};
    let survey = try p.survey catch map{};
    let lines = [
        "Portfolio readiness: " + str(len(try p.projects catch [])) + " project(s)",
        "safe paths=" + str(len(try survey.records catch [])) + " skipped=" + str(try survey.skipped_sensitive catch 0) + " scanned=" + str(try survey.scanned catch 0),
        "policy: " + str(try p.policy catch "metadata-only")
    ];
    let projects = try p.projects catch [];
    let i = 0;
    while i < len(projects) and len(lines) < limit {
        let row = projects[i];
        array_push(lines, "- " + str(row.project) + " " + str(row.status) + " score=" + str(row.readiness_score) + " present=" + str_join(try row.present_focus catch [], ","));
        i = i + 1;
    }
    let priorities = try p.top_priorities catch [];
    let j = 0;
    while j < len(priorities) and len(lines) < limit {
        array_push(lines, "> " + str(priorities[j]));
        j = j + 1;
    }
    return lines;
}

// portfolio_product_health(paths) converts survey/readiness evidence into the shared
// product-health contract consumed by PBIDE and the ecosystem products. It remains
// metadata-only: no source file, secret, cache, or build artifact is opened here.
fn portfolio_product_health(paths, projects = nil) {
    let readiness = portfolio_readiness(paths, projects);
    let survey = try readiness.survey catch map{};
    let reports = [];
    let rows = try readiness.projects catch [];
    let i = 0;
    while i < len(rows) {
        let row = rows[i];
        let safe_count = len(try survey.records catch []);
        let inventory_status = "ready";
        if safe_count == 0 { inventory_status = "blocked"; }
        let focus_status = "ready";
        if len(try row.missing_focus catch []) > 0 { focus_status = "degraded"; }
        let score_status = "ready";
        if (try row.readiness_score catch 0) < 80 { score_status = "degraded"; }
        let checks = [
            PRODUCT_HEALTH.check("metadata_inventory", inventory_status,
                str(safe_count) + " safe path records available",
                map{ required: true, category: "data", evidence: ["skipped_sensitive=" + str(try survey.skipped_sensitive catch 0)] }),
            PRODUCT_HEALTH.check("sensitive_path_policy", "ready",
                "secret/cache/build paths are skipped and sensitive names are redacted",
                map{ required: true, category: "security", security_sensitive: true }),
            PRODUCT_HEALTH.check("focus_coverage", focus_status,
                "present=" + str(len(try row.present_focus catch [])) + " missing=" + str(len(try row.missing_focus catch [])),
                map{ required: false, category: "coverage", evidence: try row.missing_focus catch [] }),
            PRODUCT_HEALTH.check("readiness_score", score_status,
                "metadata readiness score=" + str(try row.readiness_score catch 0),
                map{ required: false, category: "readiness" }),
            PRODUCT_HEALTH.check("device_routes", if len(try row.device_routes catch []) > 0 { "ready" } else { "unknown" },
                str(len(try row.device_routes catch [])) + " portable device route(s) declared",
                map{ required: false, category: "platform", evidence: try row.device_routes catch [] })
        ];
        array_push(reports, PRODUCT_HEALTH.report(
            try row.project catch "unknown",
            "survey-v1",
            checks,
            map{
                minimum_score: 70,
                capabilities: try row.present_focus catch [],
                dependencies: []
            }
        ));
        i = i + 1;
    }
    let out = PRODUCT_HEALTH.portfolio(reports, map{ name: "AAP pblang ecosystem" });
    out.survey = survey;
    out.readiness = readiness;
    out.policy = "metadata-only product health; required inventory and redaction checks fail closed";
    return out;
}

fn portfolio_product_health_lines(product_health, limit = 12) {
    let lines = PRODUCT_HEALTH.portfolio_lines(product_health, limit);
    let p = try product_health catch map{};
    let survey = try p.survey catch map{};
    if len(lines) < limit {
        array_push(lines, "safe paths=" + str(len(try survey.records catch [])) + " skipped=" + str(try survey.skipped_sensitive catch 0));
    }
    return lines;
}

fn cross_project_plan(paths) {
    let survey = survey_paths(paths, 2000);
    let projects = ["pblang", "pbai", "pbos", "pbide", "pb-mcp-server", "pbremote"];
    let out = [];
    let i = 0;
    while i < len(projects) {
        array_push(out, ideas_for_project(projects[i], survey.records));
        i = i + 1;
    }
    return map{
        format: "pblang.project_survey.plan.v1",
        survey: survey,
        projects: out,
        rule: "use metadata for ideas; verify with tests before changing project behavior"
    };
}

export sensitive_path, path_category, path_record, survey_paths, project_focus, category_protocols,
       ideas_for_project, project_improvement_tasks, portfolio_action_plan, portfolio_action_lines,
       project_category_health, portfolio_category_health, portfolio_category_health_lines,
       portfolio_readiness, portfolio_readiness_lines, portfolio_product_health, portfolio_product_health_lines,
       cross_project_plan;
