// stdlib/crypto_advanced.sapp — Advanced cryptography utilities.
//
// Provides: password hashing, symmetric encryption, secure tokens, UUID v4.
//
// IMPORTANT: The encryption primitives here are educational-grade.
// For production use requiring NIST-approved algorithms, use an FFI plugin.
//
// Usage:
//   let crypto = import("stdlib:crypto_advanced.sapp");
//   let hash = crypto.password_hash("my-password", "my-salt");
//   print crypto.password_verify("my-password", "my-salt", hash);  // true
//   let token = crypto.generate_token(32);  // URL-safe random token

// password_hash(password, salt, rounds) — derive a hash via iterated SHA256.
// Default rounds: 10000. Returns hex-encoded hash.
fn password_hash(password, salt, rounds) {
    if rounds == nil { rounds = 10000; }
    if rounds < 1 { rounds = 1; }
    let data = password + ":" + salt;
    let h = sha256(data);
    for i rounds - 1 {
        h = sha256(h + data);
    }
    return h;
}

// password_verify(password, salt, hash) — verify a password hash
fn password_verify(password, salt, hash) {
    // Use default rounds (10000) to match password_hash default
    let computed = password_hash(password, salt, 10000);
    return constant_time_eq(computed, hash);
}

// generate_token(length) — cryptographically random URL-safe token string
fn generate_token(length) {
    if length == nil { length = 32; }
    let bytes = random_bytes(length);
    // Convert bytes to URL-safe base64-like chars
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    let result = "";
    for i len(bytes) {
        let idx = bytes[i] % 64;
        result = result + str_slice(chars, idx, idx + 1);
    }
    return result;
}

// uuid4() — generate a UUID v4 (random)
fn uuid4() {
    let b = random_bytes(16);
    // Set version bits: version 4 (0100xxxx at byte 6)
    b[6] = (b[6] % 16) + 64;   // 0100xxxx
    // Set variant bits: variant 1 (10xxxxxx at byte 8)
    b[8] = (b[8] % 64) + 128;  // 10xxxxxx

    fn _hex2(n) {
        let h = "0123456789abcdef";
        return str_slice(h, num_floor(n / 16), num_floor(n / 16) + 1) +
               str_slice(h, n % 16, (n % 16) + 1);
    }

    return _hex2(b[0]) + _hex2(b[1]) + _hex2(b[2]) + _hex2(b[3]) + "-" +
           _hex2(b[4]) + _hex2(b[5]) + "-" +
           _hex2(b[6]) + _hex2(b[7]) + "-" +
           _hex2(b[8]) + _hex2(b[9]) + "-" +
           _hex2(b[10]) + _hex2(b[11]) + _hex2(b[12]) +
           _hex2(b[13]) + _hex2(b[14]) + _hex2(b[15]);
}

// encrypt(plaintext, key) — XOR stream cipher with HMAC authentication.
// Returns base64-encoded ciphertext with embedded HMAC.
fn encrypt(plaintext, key) {
    // Generate a random nonce (16 bytes)
    let nonce_bytes = random_bytes(16);
    let nonce_str = base64_encode(str(nonce_bytes));

    // Derive keystream from key+nonce via SHA256 chaining
    let keystream = sha256(key + nonce_str);

    // XOR each byte
    let plain_bytes = random_bytes(0);  // placeholder approach
    // Since we can't easily do byte-level ops without builtins,
    // use a deterministic approach: SHA256(key+nonce+index) for each block
    let cipher_text = "";
    let block_size = 32;
    let i = 0;
    let plain_len = len(plaintext);
    while i < plain_len {
        let block_key = sha256(key + nonce_str + str(i / block_size));
        let end = i + block_size;
        if end > plain_len { end = plain_len; }
        let chunk = str_slice(plaintext, i, end);
        // XOR characters with block key
        let xored = "";
        for j len(chunk) {
            let p = strcharcodeat(chunk, j);
            let k = strcharcodeat(block_key, j % len(block_key));
            xored = xored + strfromcharcode((p + k) % 256);
        }
        cipher_text = cipher_text + xored;
        i = i + block_size;
    }

    // Compute authentication tag
    let tag = hmac_sha256(nonce_str + cipher_text, key);
    let payload = map{ n: nonce_str, c: base64_encode(cipher_text), t: tag };
    return base64_encode(json_stringify(payload));
}

// decrypt(ciphertext, key) — decrypt and verify HMAC
fn decrypt(ciphertext, key) {
    let payload_json = try base64_decode(ciphertext) catch nil;
    if payload_json == nil { return error("crypto_advanced.decrypt: invalid ciphertext"); }
    let payload = try json_parse(payload_json) catch nil;
    if payload == nil { return error("crypto_advanced.decrypt: invalid ciphertext format"); }

    let nonce_str = try payload.n catch nil;
    let cipher_b64 = try payload.c catch nil;
    let tag = try payload.t catch nil;
    if nonce_str == nil or cipher_b64 == nil or tag == nil {
        return error("crypto_advanced.decrypt: malformed payload");
    }

    let cipher_text = base64_decode(cipher_b64);

    // Verify HMAC
    let expected_tag = hmac_sha256(nonce_str + cipher_text, key);
    if constant_time_eq(tag, expected_tag) == false {
        return error("crypto_advanced.decrypt: authentication failed (invalid key or tampered data)");
    }

    // Decrypt: same XOR operation
    let plaintext = "";
    let block_size = 32;
    let i = 0;
    let cipher_len = len(cipher_text);
    while i < cipher_len {
        let block_key = sha256(key + nonce_str + str(i / block_size));
        let end = i + block_size;
        if end > cipher_len { end = cipher_len; }
        let chunk = str_slice(cipher_text, i, end);
        let decrypted = "";
        for j len(chunk) {
            let p = strcharcodeat(chunk, j);
            let k = strcharcodeat(block_key, j % len(block_key));
            let orig = (p - k + 256) % 256;
            decrypted = decrypted + strfromcharcode(orig);
        }
        plaintext = plaintext + decrypted;
        i = i + block_size;
    }
    return plaintext;
}

// secure_compare(a, b) — constant-time string comparison
fn secure_compare(a, b) {
    return constant_time_eq(a, b);
}

export password_hash, password_verify, generate_token, uuid4, encrypt, decrypt, secure_compare;
