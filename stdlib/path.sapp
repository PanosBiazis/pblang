// stdlib/path.sapp

fn join(a, b) { return path_join(a, b); }
fn dirname(p) { return path_dirname(p); }
fn basename(p) { return path_basename(p); }

fn extension(p) {
    let b = path_basename(p);
    // A leading dot is part of a dotfile's name (e.g. ".bashrc"), not an extension
    // separator — strip it before looking for the last dot.
    let name = b;
    if str_starts_with(name, ".") { name = str_slice(name, 1, len(name)); }
    let dot = 0 - 1;
    let i = 0;
    while i < len(name) {
        if str_slice(name, i, i + 1) == "." { dot = i; }
        i = i + 1;
    }
    if dot < 0 { return ""; }
    return str_slice(name, dot + 1, len(name));
}

// stem(p) — basename with its extension removed (".bashrc" stays ".bashrc").
fn stem(p) {
    let b = path_basename(p);
    let ext = extension(p);
    if ext == "" { return b; }
    return str_slice(b, 0, len(b) - len(ext) - 1);
}

// with_extension(p, ext) — replace (or add) the extension on a path.
fn with_extension(p, ext) {
    let d = path_dirname(p);
    let newbase = stem(p) + "." + ext;
    if d == "" or d == "." { return newbase; }
    return d + "/" + newbase;
}

// split(p) — the non-empty path components.
fn split(p) {
    let parts = str_split(p, "/");
    let out = [];
    let i = 0;
    while i < len(parts) { if parts[i] != "" { array_push(out, parts[i]); } i = i + 1; }
    return out;
}

// is_absolute(p) — true for POSIX "/..." or a Windows drive root.
fn is_absolute(p) {
    if str_starts_with(p, "/") { return true; }
    if len(p) >= 3 and (str_slice(p, 1, 3) == ":/" or str_slice(p, 1, 3) == ":\\") { return true; }
    return false;
}

// parent(p) — the containing directory (alias of dirname).
fn parent(p) { return path_dirname(p); }

// normalize(p) — resolve "." and ".." lexically (no filesystem access).
fn normalize(p) {
    let is_abs = str_starts_with(p, "/");
    let parts = str_split(p, "/");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let seg = parts[i];
        if seg == "" or seg == "." {
            // drop empty and current-dir segments
        } else if seg == ".." {
            let n = len(out);
            if n > 0 and out[n - 1] != ".." {
                let no = [];
                let k = 0;
                while k < n - 1 { array_push(no, out[k]); k = k + 1; }
                out = no;
            } else if not is_abs {
                array_push(out, "..");
            }
            // an absolute path can't go above root: drop the ".."
        } else {
            array_push(out, seg);
        }
        i = i + 1;
    }
    let joined = "";
    let j = 0;
    while j < len(out) {
        if j > 0 { joined = joined + "/"; }
        joined = joined + out[j];
        j = j + 1;
    }
    if is_abs { return "/" + joined; }
    if joined == "" { return "."; }
    return joined;
}

fn exists(p) { return fs_exists(p); }

fn is_file(p) {
    let e = try fs_exists(p) catch false;
    if e == false { return false; }
    // Check that it's not a directory via fs_listdir (errors on non-dir)
    let dir_check = try { fs_listdir(p); true } catch false;
    if dir_check == true { return false; }
    return true;
}

fn is_dir(p) {
    let e = try fs_exists(p) catch false;
    if e == false { return false; }
    let dir_check = try { fs_listdir(p); true } catch false;
    return dir_check;
}

fn absolute(p) {
    // If already absolute, return as-is
    if str_starts_with(p, "/") { return p; }
    // Windows absolute path check
    if len(p) >= 3 and str_slice(p, 1, 3) == ":/" { return p; }
    if len(p) >= 3 and str_slice(p, 1, 3) == ":\\" { return p; }
    return cwd() + "/" + p;
}

// ── wave 2: path relationships (lexical, component-wise) ──────────────────────────

// relative_to(base, target) — the path from base to target (".." for ancestors).
fn relative_to(base, target) {
    let b = split(base);
    let t = split(target);
    let k = 0;
    while k < len(b) and k < len(t) and b[k] == t[k] { k = k + 1; }
    let out = [];
    let i = k;
    while i < len(b) { array_push(out, ".."); i = i + 1; }
    let j = k;
    while j < len(t) { array_push(out, t[j]); j = j + 1; }
    if len(out) == 0 { return "."; }
    let s = "";
    let m = 0;
    while m < len(out) { if m > 0 { s = s + "/"; } s = s + out[m]; m = m + 1; }
    return s;
}

// common_prefix(paths) — the longest shared directory of every path.
fn common_prefix(paths) {
    if len(paths) == 0 { return ""; }
    let abs = is_absolute(paths[0]);
    let first = split(paths[0]);
    let k = len(first);
    let i = 1;
    while i < len(paths) {
        let p = split(paths[i]);
        let j = 0;
        while j < k and j < len(p) and first[j] == p[j] { j = j + 1; }
        k = j;
        i = i + 1;
    }
    let s = "";
    let m = 0;
    while m < k { if m > 0 { s = s + "/"; } s = s + first[m]; m = m + 1; }
    if abs { return "/" + s; }
    return s;
}

// is_subpath(parent, child) — true if child equals or lives under parent (by component).
fn is_subpath(parent, child) {
    let pp = split(parent);
    let cc = split(child);
    if len(cc) < len(pp) { return false; }
    let i = 0;
    while i < len(pp) { if pp[i] != cc[i] { return false; } i = i + 1; }
    return true;
}

export join, dirname, basename, extension, exists, is_file, is_dir, absolute;
export stem, with_extension, split, is_absolute, parent, normalize;
export relative_to, common_prefix, is_subpath;
