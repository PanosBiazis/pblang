// Bounded inference-only forward/reverse dense networks. No I/O or training.
let NN=import("stdlib:nn.sapp");
fn _fail() {throw "pbai.feedback: invalid or unsupported request";}
fn _number(x,lo,hi) {
 if type(x)!="number" {return false;}
 // Ordered bounded comparisons also reject NaN and infinities.
 return x>=lo and x<=hi;
}
fn _integer(x,lo,hi) {return _number(x,lo,hi) and num_floor(x)==x;}
fn _copy_vector(xs,n,lo,hi) {
 if type(xs)!="array" {return _fail();}
 if len(xs)!=n {return _fail();}
 let out=[];let i=0;
 while i<n {if not _number(xs[i],lo,hi) {return _fail();} push(out,xs[i]);i=i+1;}
 return out;
}
fn _copy_stack(model) {
 if type(model)!="map" {return _fail();}
 if len(model)!=2 {return _fail();}
 if (try model.format catch nil)!="pbai.feedback.stack.v1" {return _fail();}
 let ls=try model.layers catch nil;
 if type(ls)!="array" {return _fail();}
 if len(ls)<1 or len(ls)>8 {return _fail();}
 let copied=[];let params=0;let prev=0;let first=0;let k=0;
 while k<len(ls) {
  let l=ls[k];if type(l)!="map" {return _fail();}
  if len(l)!=4 {return _fail();}
  let ni=try l.n_in catch nil;let no=try l.n_out catch nil;
  if not _integer(ni,1,32) or not _integer(no,1,32) {return _fail();}
  if k>0 and ni!=prev {return _fail();}
  if k==0 {first=ni;}
  let w=try l.w catch nil;let b=try l.b catch nil;
  if type(w)!="array" {return _fail();}
  if len(w)!=no {return _fail();}
  let rows=[];let j=0;
  while j<no {push(rows,_copy_vector(w[j],ni,0-10000,10000));j=j+1;}
  push(copied,map{n_in:ni,n_out:no,w:rows,b:_copy_vector(b,no,0-10000,10000)});
  params=params+ni*no+no;prev=no;k=k+1;
 }
 return map{layers:copied,n_in:first,n_out:prev,parameters:params};
}
fn _forward(model,x) {
 let current=x;let i=0;
 while i<len(model.layers) {
  current=NN.dense_forward(model.layers[i],current);
  current=_copy_vector(current,model.layers[i].n_out,0,1);
  i=i+1;
 }
 return current;
}
fn _distance(a,b) {
 let d=0;let i=0;
 while i<len(a) {let v=num_abs(a[i]-b[i]);if v>d {d=v;} i=i+1;}
 return d;
}
// Compatible with dense layers created/trained through nn.sapp. Copies all weights.
fn stack(layers) {
 let checked=_copy_stack(map{format:"pbai.feedback.stack.v1",layers:layers});
 return map{format:"pbai.feedback.stack.v1",layers:checked.layers};
}
fn forward(model,input) {
 let checked=_copy_stack(model);
 return _forward(checked,_copy_vector(input,checked.n_in,0-1000000,1000000));
}
// anchor=0: reconstruction recurrence; anchor>0: retain a fraction of the original
// observation. damping relaxes updates. Residual is measured BEFORE damping,
// preventing tiny damping from falsely declaring convergence.
fn cycle(encoder,decoder,input,options=nil) {
 let e=_copy_stack(encoder);let d=_copy_stack(decoder);
 if e.n_out!=d.n_in or d.n_out!=e.n_in {return _fail();}
 if e.parameters+d.parameters>16384 {return _fail();}
 let original=_copy_vector(input,e.n_in,0-1000000,1000000);
 if options==nil {options=map{};}
 if type(options)!="map" {return _fail();}
 if len(options)>4 {return _fail();}
 let ks=map_keys(options);let ki=0;
 while ki<len(ks) {
  let key=ks[ki];
  if key!="max_iterations" and key!="tolerance" and key!="damping" and key!="anchor" {return _fail();}
  ki=ki+1;
 }
 let cap=try options.max_iterations catch 8;
 let tol=try options.tolerance catch 0.000001;
 let damping=try options.damping catch 1;
 let anchor=try options.anchor catch 0;
 if not _integer(cap,1,32) or not _number(tol,0.000000000001,1) {return _fail();}
 if not _number(damping,0.000001,1) or not _number(anchor,0,0.999999) {return _fail();}
 let current=_copy_vector(original,e.n_in,0-1000000,1000000);
 let history=[];let iterations=0;let reason="iteration_limit";
 while iterations<cap {
  let y=_forward(e,current);let reconstruction=_forward(d,y);
  let target=[];let i=0;
  while i<len(current) {push(target,anchor*original[i]+(1-anchor)*reconstruction[i]);i=i+1;}
  let residual=_distance(target,current);
  push(history,residual);iterations=iterations+1;
  if residual<=tol {reason="converged";break;}
  let next=[];i=0;
  while i<len(current) {push(next,(1-damping)*current[i]+damping*target[i]);i=i+1;}
  current=next;
 }
 // Final diagnostics refer to the returned input, never the previous iteration.
 let output=_forward(e,current);let rebuilt=_forward(d,output);let final_target=[];let fi=0;
 while fi<len(current) {push(final_target,anchor*original[fi]+(1-anchor)*rebuilt[fi]);fi=fi+1;}
 let final_residual=_distance(final_target,current);
 if final_residual<=tol {reason="converged";}
 return map{format:"pbai.feedback.result.v1",input:current,output:output,
  reconstruction:rebuilt,iterations:iterations,stop_reason:reason,
  converged:reason=="converged",residual:final_residual,residuals:history,
  reconstruction_error:_distance(rebuilt,original),
  pair_evaluations:iterations+1,parameters:e.parameters+d.parameters};
}
export stack,forward,cycle;
