// stdlib/pbai_accel.sapp -- pbAI hardware acceleration policy and detection.
//
// HONEST capability picture (as of pblang with the `gpu` feature):
//   * By default, pblang's tensor/NN kernels run on the CPU, parallelised across cores
//     (rayon-based tensor_matmul). This is the path used by every standard pblang build.
//   * pblang now ALSO ships an OPT-IN GPU compute backend: a wgpu matmul kernel behind
//     the `tensor_matmul` builtin, compiled only with `cargo build --features gpu` and
//     activated at runtime with PBLANG_GPU=1. It is f32-only (GPUs lack f64), so it is
//     opt-in by design and the default stays exact/deterministic f64 on the CPU. The
//     `tensor_backend()` builtin reports what the running binary actually supports.
//   * There is still NO NPU compute backend.
//
// What this means for pbAI specifically: the Nano char-level LM (pbai_lm) does its
// arithmetic directly in pblang, NOT through tensor_matmul, so it does not benefit from
// the GPU backend today — its lever is MULTI-CORE CPU parallelism
// (pbai_lm.train_nano_parallel trains N models on N OS threads via spawn and keeps the
// best, using ~N cores for ~the wall-time of one model). The heavy pbai_max / llm_*
// path that DOES call tensor_matmul is the part that can ride the CPU-parallel or
// (opt-in) GPU matmul. detect()/probe still treat any enumerated GPU as informational.
//
// Safety: CPU compute saturating cores is safe on modern hardware — the OS/firmware
// handle thermal throttling — but it raises power draw and heat, so the default leaves
// headroom and the user opts into higher intensity.

let BACKEND = "cpu";
let PBAI_HW = import("pbai_hw.sapp");
let BACKEND_NOTE =
    "pblang tensor kernels run multi-core on the CPU by default (exact f64); an opt-in "
  + "GPU matmul backend exists behind `--features gpu` + PBLANG_GPU=1 (f32). pbAI's Nano "
  + "LM computes in pblang directly (no tensor_matmul) so its lever is multi-core CPU "
  + "best-of-N training; tensor_matmul-based code (pbai_max/llm_*) can use either path.";

fn _parse_int(s) {
    if s == nil { return 0; }
    let n = 0;
    let i = 0;
    let ok = false;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c >= 48 and c <= 57 { n = n * 10 + (c - 48); ok = true; }
        i = i + 1;
    }
    if not ok { return 0; }
    return n;
}

fn _floor(x) { return x - num_mod(x, 1); }

fn _cmd_int(cmd, args) {
    let r = try proc_spawn_wait(cmd, args) catch nil;
    if r == nil { return 0; }
    if r.exit_code != 0 { return 0; }
    return _parse_int(r.stdout);
}

// cpu_cores() — logical core count. Uses NUMBER_OF_PROCESSORS (set on Windows; often on
// CI too); on Linux/macOS tries `nproc` and `getconf _NPROCESSORS_ONLN`; falls back to a
// safe default when the environment does not expose it and process probing is unavailable.
//
// NOTE: env_get() returns nil for an UNSET variable (it does not throw), so `try/catch`
// cannot rescue it — nil must be handled explicitly. NUMBER_OF_PROCESSORS is a Windows
// variable and is typically unset on Linux/macOS.
fn cpu_cores() {
    let raw = try env_get("NUMBER_OF_PROCESSORS") catch "";
    if raw == nil { raw = ""; }
    let c = _parse_int(raw);
    if c >= 1 { return c; }

    let nproc = _cmd_int("nproc", []);
    if nproc >= 1 { return nproc; }

    let getconf = _cmd_int("getconf", ["_NPROCESSORS_ONLN"]);
    if getconf >= 1 { return getconf; }

    if c < 1 { return 4; }
    return c;
}

// plan(intensity, cores) — map an intensity to a worker (thread) count.
//   "eco"      -> 1 worker  (~one core; matches the conservative default)
//   "balanced" -> half the cores
//   "max"      -> all but one core (leave one for the system/UI)
//   <number>   -> that many workers (clamped to [1, cores])
fn plan(intensity = "balanced", cores = 0) {
    let c = cores;
    if c < 1 { c = cpu_cores(); }
    let workers = 1;
    if intensity == "eco" { workers = 1; }
    else if intensity == "balanced" { workers = _floor(c / 2); }
    else if intensity == "max" { workers = c - 1; }
    else { workers = _parse_int(str(intensity)); }
    if workers < 1 { workers = 1; }
    if workers > c { workers = c; }
    return map{
        intensity: intensity,
        cpu_cores: c,
        workers: workers,
        backend: BACKEND
    };
}

// probe_gpu() — best-effort GPU enumeration for INFORMATION only. Requires the exec
// capability (--allow-exec). Uses the shared pblang hwinfo detector so Windows,
// Linux, and macOS all degrade through the same honest inventory path.
fn probe_gpu() {
    let s = try PBAI_HW.gpu_summary() catch "";
    if s != nil and s != "" { return s; }
    return "gpu detection unavailable (grant --allow-exec or install platform inventory tools)";
}

// probe_npu() — best-effort NPU (Neural Processing Unit) enumeration for INFORMATION only.
// Requires the exec capability (--allow-exec). On Windows, NPUs (e.g. AMD XDNA "Ryzen AI",
// Intel AI Boost, Qualcomm Hexagon) enumerate under the `ComputeAccelerator` device class.
//
// IMPORTANT — detection is NOT compute. pblang has no NPU compute backend: unlike the GPU
// (which has a real, verified opt-in wgpu matmul behind `--features gpu`), the NPU is
// driven only by vendor stacks (AMD Ryzen AI / ONNX Runtime + Vitis AI EP, Intel OpenVINO,
// Qualcomm QNN) that run INT8-quantized ONNX graphs, not pblang's f64 tensor_matmul. So a
// detected NPU is reported truthfully but is NOT yet usable for model math from pblang.
fn probe_npu() {
    let s = try PBAI_HW.npu_summary() catch "";
    if s != nil and s != "" { return s; }
    return "npu detection unavailable; no pblang NPU compute backend";
}

// detect(allow_probe) — capability + policy report. Does NOT probe by default (probing
// needs exec); pass true to attempt an informational GPU enumeration.
fn detect(allow_probe = false) {
    let cores = cpu_cores();
    let gpu = "not probed (enumeration is informational; tensor_matmul GPU offload is opt-in via pblang `--features gpu` + PBLANG_GPU=1)";
    let npu = "not probed (enumeration is informational; pblang has no NPU compute backend)";
    if allow_probe { gpu = probe_gpu(); npu = probe_npu(); }
    return map{
        platform: try platform() catch "unknown",
        compute_backend: BACKEND,
        backend_note: BACKEND_NOTE,
        cpu_cores: cores,
        concurrency: "OS threads via spawn/spawn_n",
        parallel_training: "pbai_lm.train_nano_parallel (best-of-N across cores)",
        gpu: gpu,
        gpu_compute: "opt-in pblang wgpu matmul (build --features gpu, run PBLANG_GPU=1, f32); used by tensor_matmul code, not by the Nano char LM",
        npu: npu,
        npu_compute: "no pblang NPU backend; a detected NPU (AMD Ryzen AI/XDNA, Intel AI Boost, Qualcomm Hexagon) is informational only. Real path: ONNX Runtime + vendor EP (Vitis AI/OpenVINO/QNN) on INT8 graphs.",
        recommended: plan("balanced", cores)
    };
}

fn describe() {
    let d = detect(false);
    return "pbAI acceleration: backend=" + d.compute_backend + ", cores=" + str(d.cpu_cores)
        + ", recommended workers=" + str(d.recommended.workers)
        + " (balanced). Default compute is multi-core CPU (f64); an opt-in GPU matmul "
        + "(pblang --features gpu + PBLANG_GPU=1, f32) accelerates tensor_matmul code only. "
        + "No NPU backend. The Nano LM's lever is multi-core CPU best-of-N training.";
}

export cpu_cores, plan, probe_gpu, probe_npu, detect, describe;
