// stdlib/pbai_ingest.sapp -- local file/folder ingestion for pbAI live learning.
//
// Reads explicit local paths and appends bounded lessons to pbAI's live corpus.
// Text-like files are learned as content chunks. Binary/unknown files are learned as
// metadata so pbAI can remember their existence without pretending to parse them.

let LM = import("stdlib/pbai_lm.sapp");
let DATA = import("stdlib:llm_data.sapp");

let MAX_FILES = 80;
let MAX_DEPTH = 4;
let MAX_TEXT_CHARS = 24000;
let CHUNK_CHARS = 6000;
let MAX_CHUNKS_PER_FILE = 4;

fn _join(a, b) {
    if a == "" or a == "." { return b; }
    if str_ends_with(a, "/") { return a + b; }
    return a + "/" + b;
}

fn _lower(s) { return str_lower(str(s)); }

fn _is_dir(path) {
    let items = try fs_listdir(path) catch nil;
    return items != nil;
}

fn _file_size(path) {
    let b = try fs_read_bytes(path) catch nil;
    if b == nil { return nil; }
    return len(b);
}

fn _text_like(path) {
    let p = _lower(path);
    let exts = [".txt", ".md", ".json", ".jsonl", ".csv", ".tsv", ".sapp", ".pb", ".js", ".ts",
        ".html", ".css", ".py", ".rs", ".c", ".cpp", ".h", ".hpp", ".cs", ".pas", ".java",
        ".kt", ".go", ".rb", ".php", ".sql", ".sh", ".bat", ".ps1", ".toml", ".yaml",
        ".yml", ".ini", ".log", ".xml"];
    for e in exts {
        if str_ends_with(p, e) { return true; }
    }
    return false;
}

fn _skip_name(name) {
    if name == "" { return true; }
    let n = _lower(name);
    if str_starts_with(n, ".") { return true; }
    if n == "target" or n == "node_modules" or n == "__pycache__" or n == ".venv" { return true; }
    if n == "cache" or n == "tmp" or n == "temp" or n == "build" or n == "dist" { return true; }
    if n == "bin" or n == "obj" or n == "coverage" { return true; }
    if str_contains(n, "credential") or str_contains(n, "password") or str_contains(n, "passwd") { return true; }
    if str_contains(n, "secret") or str_contains(n, "token") or str_contains(n, "openrouter") { return true; }
    if str_contains(n, "appsettings") or str_contains(n, "api_key") or str_contains(n, "access_key") { return true; }
    if str_starts_with(n, "id_ed25519") or str_starts_with(n, "id_rsa") { return true; }
    if str_ends_with(n, ".pem") or str_ends_with(n, ".p12") or str_ends_with(n, ".pfx") or str_ends_with(n, ".key") { return true; }
    if str_ends_with(n, ".iso") or str_ends_with(n, ".exe") or str_ends_with(n, ".msi") or str_ends_with(n, ".zip") or str_ends_with(n, ".7z") { return true; }
    return false;
}

fn _remember_chunk(path, idx, total, text) {
    LM.remember_text("file content chunk " + str(idx) + "/" + str(total) + ": " + path + "\n--- content ---\n" + text);
}

fn _ingest_text_file(path, stats) {
    let raw = try fs_read(path) catch "";
    if len(raw) > MAX_TEXT_CHARS { raw = str_slice(raw, 0, MAX_TEXT_CHARS); }
    let sanitized = DATA.sanitize_text(raw);
    raw = sanitized.text;
    stats.redactions = stats.redactions + sanitized.redactions;
    let total = (len(raw) / CHUNK_CHARS) + 1;
    if total > MAX_CHUNKS_PER_FILE { total = MAX_CHUNKS_PER_FILE; }
    let i = 0;
    while i < total {
        let start = i * CHUNK_CHARS;
        let end = start + CHUNK_CHARS;
        if end > len(raw) { end = len(raw); }
        if start < len(raw) {
            _remember_chunk(path, i + 1, total, str_slice(raw, start, end));
            stats.chunks = stats.chunks + 1;
        }
        i = i + 1;
    }
    stats.files = stats.files + 1;
}

fn _ingest_metadata(path, stats) {
    let size = _file_size(path);
    LM.remember_text("file metadata: " + path + "\nsize_bytes: " + str(size) + "\ncontent_status: metadata only; add a parser/backend for deep binary understanding");
    stats.files = stats.files + 1;
    stats.chunks = stats.chunks + 1;
    stats.metadata = stats.metadata + 1;
}

fn _ingest_file(path, stats) {
    if stats.files >= stats.max_files { return; }
    let slash = str_split(path, "/");
    let name = path;
    if len(slash) > 0 { name = slash[len(slash) - 1]; }
    if _skip_name(name) {
        stats.skipped = stats.skipped + 1;
        return;
    }
    if _text_like(path) { _ingest_text_file(path, stats); }
    else { _ingest_metadata(path, stats); }
}

fn _walk(path, depth, stats) {
    if stats.files >= stats.max_files { return; }
    if depth > stats.max_depth { return; }
    if _is_dir(path) {
        let items = try fs_listdir(path) catch [];
        for item in items {
            if not _skip_name(item) {
                _walk(_join(path, item), depth + 1, stats);
            } else {
                stats.skipped = stats.skipped + 1;
            }
            if stats.files >= stats.max_files { return; }
        }
    } else {
        _ingest_file(path, stats);
    }
}

fn ingest_path(path, max_files = nil, max_depth = nil, epochs = 4) {
    if max_files == nil { max_files = MAX_FILES; }
    if max_depth == nil { max_depth = MAX_DEPTH; }
    let before = LM.live_stats();
    let stats = map{
        path: path,
        files: 0,
        chunks: 0,
        metadata: 0,
        redactions: 0,
        skipped: 0,
        max_files: max_files,
        max_depth: max_depth
    };
    _walk(path, 0, stats);
    let ckpt = LM.train_nano(epochs, 0.2);
    let after = LM.live_stats();
    return map{
        format: "pbai.ingest.v1",
        stats: stats,
        live_before: before,
        live_after: after,
        checkpoint: map{
            tier: ckpt.tier,
            format: ckpt.format,
            loss_before: ckpt.metrics.loss_before,
            loss_after: ckpt.metrics.loss_after
        }
    };
}

export ingest_path;
