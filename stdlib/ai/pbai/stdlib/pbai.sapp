let _BPE_TOK = nil;
let _BPE_CORPUS = "";
// Cached BPE tokenizer trained on pbAI's own source corpus, so its merges reflect real
// pblang/code (retrained when the live corpus changes).
fn _bpe() {
    let corpus = PBAI_LM.source_corpus();
    if _BPE_TOK == nil or _BPE_CORPUS != corpus {
        _BPE_TOK = PBAI_BPE.train(corpus, 160);
        _BPE_CORPUS = corpus;
    }
    return _BPE_TOK;
}

// bpe_tokenize(text) — subword tokenize via the BPE tokenizer; reports the compression
// (token_count vs char_count) that shorter subword sequences buy a fixed-context model.
fn bpe_tokenize(text, add_specials = true) {
    let tok = _bpe();
    let ids = PBAI_BPE.encode(tok, text, add_specials, add_specials);
    return map{
        format: tok.format,
        text: text,
        ids: ids,
        tokens: PBAI_BPE.tokenize(tok, text, add_specials, add_specials),
        token_count: len(ids),
        char_count: len(text),
        vocab_size: tok.vocab_size,
        merges: tok.num_merges
    };
}

// accelerate_status() — honest hardware/acceleration report (CPU-only compute, core
// count, recommended parallelism). GPU/NPU are informational; pass true to probe.
fn accelerate_status(allow_probe = false) {
    return PBAI_ACCEL.detect(allow_probe);
}

// train_parallel(intensity) — retrain pbAI-Nano using multi-core best-of-N training at
// the chosen intensity ("eco"/"balanced"/"max" or an explicit worker count). Uses more
// CPU for a better (lowest-loss-of-N) checkpoint; reports what it did.
fn train_parallel(intensity = "balanced", epochs = 18, lr = 0.25) {
    let p = PBAI_ACCEL.plan(intensity);
    let ckpt = PBAI_LM.train_nano_parallel(p.workers, epochs, lr);
    return map{
        intensity: intensity,
        workers: p.workers,
        cpu_cores: p.cpu_cores,
        backend: p.backend,
        tier: ckpt.tier,
        loss_before: ckpt.metrics.loss_before,
        loss_after: ckpt.metrics.loss_after,
        note: "best-of-" + str(p.workers) + " across CPU cores; pblang has no GPU/NPU compute backend."
    };
}

fn model_status() {
    let ckpt = PBAI_LM.train_nano(2, 0.2);
    let tok = PBAI_TOKENIZER.train_default();
    let learning = PBAI_LM.live_stats();
    return map{
        family: "pbAI",
        top: map{
            assistant: "stdlib/pbai.sapp",
            router: "neural intent classifier + grounded pblang skills",
            tools: PBAI_TOOLS.short_summary(),
            target: "full pbAI LLM family, not only pbAI-Nano"
        },
        tokenizer: PBAI_TOKENIZER.metadata(tok),
        subword: PBAI_BPE.metadata(_bpe()),
        accelerator: PBAI_ACCEL.detect(false),
        quantization: PBAI_QUANT.capability(),
        low_memory_streaming: PBAI_STREAMING.capability(),
        model_io: PBAI_TOKENIZER.model_io(tok),
        brain: map{
            module: "stdlib/pbai_brain.sapp",
            format: "pbai.brain.loop.v1",
            neural: "pbai.neural.brain.v1 portable pblang MLP",
            loop: "perceive -> plan -> critique -> verify",
            memory: "working + episodic + long_term",
            agents: "root -> sub-agents -> atomic-agents -> sub-atomic-agents"
        },
        bottom: map{
            lm: "stdlib/pbai_lm.sapp",
            tier: ckpt.tier,
            format: ckpt.format,
            source: ckpt.source,
            architecture: ckpt.architecture,
            learns: true,
            training_signal: map{
                loss_before: ckpt.metrics.loss_before,
                loss_after: ckpt.metrics.loss_after,
                improved: ckpt.metrics.loss_after < ckpt.metrics.loss_before
            },
            live_learning: learning
        },
        max: PBAI_MAX.status(),
        references: PBAI_ASSETS.implementation_plan(),
        tool_substrate: PBAI_TOOLS.catalog()
    };
}

fn think(prompt, observed_output = "") {
    let loop = PBAI_BRAIN.run(prompt, observed_output);
    loop.answer = respond(prompt);
    let p = PBAI_BRAIN.perceive(prompt);
    if p.kind == "code" or p.kind == "failure" or p.kind == "diff" {
        loop.live_memory = [];
    } else {
        loop.live_memory = _live_memory_matches(prompt);
    }
    return loop;
}

// respond_tool(tool, prompt) — a tool name hint (from the gateway) overrides routing.
fn respond_tool(tool, prompt) {
    if tool == "ai_ollama_generate" { return generate(prompt, 80); } // replaced locally by native pbAI
    if tool == "ai_self_critique" { return _run(1, prompt); }       // critique ≈ find bugs
    if tool == "ai_structured_extract" { return _run(0, prompt); }  // extract ≈ explain
    return respond(prompt);
}

fn tool_catalog() {
    return MCP.tool_catalog();
}

fn tool_call(name, args = nil) {
    return MCP.call(name, args);
}

