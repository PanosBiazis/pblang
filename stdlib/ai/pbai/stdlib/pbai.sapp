// _intent_index(name) — intent label -> classifier index (falls back to "general").
fn _intent_index(name) {
    let i = 0;
    while i < len(_INTENTS) { if _INTENTS[i] == name { return i; } i = i + 1; }
    return len(_INTENTS) - 1;
}
// respond_as(intent_name, prompt) — run the skill for an ALREADY-decided intent label.
fn respond_as(intent_name, prompt) { return _run(_intent_index(intent_name), prompt); }

