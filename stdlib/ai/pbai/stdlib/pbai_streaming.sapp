// pbAI facade for PBLang's integrity-checked low-memory LLM shard runtime.

let STORE = import("stdlib:llm_tiered_store.sapp");

fn open(root, parts, options = nil) {
    if options == nil { options = map{}; }
    let budget = try options.ram_budget_bytes catch 536870912;
    let cfg = STORE.config(budget, options);
    return STORE.create(root, parts, cfg);
}

fn load_weight(runtime, id, pin = false) { return STORE.load(runtime, id, pin); }

fn observe_routes(runtime, layer_index, expert_indices, prefetch_count = 2) {
    let observed = STORE.record_routes(runtime, layer_index, expert_indices);
    if not observed.ok { return observed; }
    let queued = STORE.queue_expert_prefetch(runtime, layer_index, prefetch_count);
    return map{
        ok: queued.ok,
        format: "pbai.streaming.route_prefetch.v1",
        observed: observed,
        predicted: STORE.predict_experts(runtime, layer_index, prefetch_count),
        prefetch: queued
    };
}

fn run_prefetch(runtime, max_items = 1) { return STORE.run_prefetch(runtime, max_items); }
fn cancel_prefetch(runtime) { return STORE.cancel_prefetch(runtime); }
fn rebalance(runtime) { return STORE.rebalance_hot(runtime); }
fn status(runtime) { return STORE.status(runtime); }
fn close(runtime) { return STORE.close(runtime); }

fn capability() {
    let base = STORE.capability();
    return map{
        format: "pbai.streaming.capability.v1",
        language: "pblang",
        layer_streaming: true,
        moe_expert_streaming: true,
        weighted_storage_mirrors: true,
        learned_hot_experts: true,
        verified_shards: true,
        semantics_preserved: true,
        asynchronous_io: base.asynchronous_io,
        cooperative_prefetch_cancellation: base.cooperative_prefetch_cancellation,
        preempts_active_read: base.preempts_active_read,
        gpu_transfer_backend: base.gpu_transfer_backend,
        implementation: "stdlib:llm_tiered_store.sapp",
        note: base.note
    };
}

export open, load_weight, observe_routes, run_prefetch, cancel_prefetch, rebalance, status, close, capability;
