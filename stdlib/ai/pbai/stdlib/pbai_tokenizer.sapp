// stdlib/pbai_tokenizer.sapp -- pbAI's first native tokenizer contract.
//
// This is intentionally small and fully pblang-native: a deterministic character /
// codepoint tokenizer with versioned metadata and explicit special tokens. It is not
// a legacy checkpoint tokenizer and it does not depend on Python, Rust, or network
// providers. Later BPE/SentencePiece-style tokenizers can keep this public contract:
// train -> encode -> decode -> metadata.

let FORMAT = "pbai.tokenizer.char.v1";
let KIND = "codepoint-char";

let DEFAULT_SPECIALS = ["<pad>", "<bos>", "<eos>", "<unk>"];

let DEFAULT_CORPUS =
    "fn main() { print \"hello\"; }\n"
    + "fn add(a, b) { return a + b; }\n"
    + "let m = map{ ok: true, value: 42 };\n"
    + "if map_has(m, \"value\") { print m[\"value\"]; }\n"
    + "while false { break; }\n";

fn _token_key(token) {
    return token;
}

fn _codepoint_token(text, i) {
    return strfromcharcode(strcharcodeat(text, i));
}

fn _copy_array(a) {
    let out = [];
    let i = 0;
    while i < len(a) {
        push(out, a[i]);
        i = i + 1;
    }
    return out;
}

fn _add_token(state, token, kind) {
    let key = _token_key(token);
    if map_has(state.token_to_id, key) { return state.token_to_id[key]; }
    let id = len(state.id_to_token);
    state.token_to_id[key] = id;
    push(state.id_to_token, token);
    state.token_kind[key] = kind;
    return id;
}

fn train(corpus, max_vocab = 0) {
    let state = map{ token_to_id: map{}, id_to_token: [], token_kind: map{} };
    let i = 0;
    while i < len(DEFAULT_SPECIALS) {
        _add_token(state, DEFAULT_SPECIALS[i], "special");
        i = i + 1;
    }

    // The special tokens are mandatory and reserved, so a positive max_vocab smaller
    // than the special count is infeasible. Floor the effective cap to the special
    // count (specials always win) while preserving the raw request for honesty, so the
    // returned metadata never advertises a cap it silently violates.
    let requested_max_vocab = max_vocab;
    let effective_max_vocab = max_vocab;
    if max_vocab > 0 and max_vocab < len(DEFAULT_SPECIALS) {
        effective_max_vocab = len(DEFAULT_SPECIALS);
    }

    let pos = 0;
    while pos < len(corpus) {
        let tok = _codepoint_token(corpus, pos);
        if effective_max_vocab <= 0 or len(state.id_to_token) < effective_max_vocab {
            _add_token(state, tok, "char");
        }
        pos = pos + 1;
    }

    return map{
        format: FORMAT,
        kind: KIND,
        source: "pblang-native first-seen codepoint tokenizer",
        token_to_id: state.token_to_id,
        id_to_token: state.id_to_token,
        token_kind: state.token_kind,
        special: map{
            pad: state.token_to_id["<pad>"],
            bos: state.token_to_id["<bos>"],
            eos: state.token_to_id["<eos>"],
            unk: state.token_to_id["<unk>"]
        },
        vocab_size: len(state.id_to_token),
        max_vocab: effective_max_vocab,
        requested_max_vocab: requested_max_vocab
    };
}

fn train_default(max_vocab = 0) {
    return train(DEFAULT_CORPUS, max_vocab);
}

fn encode(tok, text, add_bos = false, add_eos = false) {
    let ids = [];
    if add_bos { push(ids, tok.special.bos); }
    let i = 0;
    while i < len(text) {
        let t = _codepoint_token(text, i);
        if map_has(tok.token_to_id, t) { push(ids, tok.token_to_id[t]); }
        else { push(ids, tok.special.unk); }
        i = i + 1;
    }
    if add_eos { push(ids, tok.special.eos); }
    return ids;
}

fn decode(tok, ids, skip_special = true) {
    let out = "";
    let i = 0;
    while i < len(ids) {
        let id = ids[i];
        if id >= 0 and id < len(tok.id_to_token) {
            let t = tok.id_to_token[id];
            let is_special = map_has(tok.token_kind, t) and tok.token_kind[t] == "special";
            if not (skip_special and is_special) {
                out = out + t;
            }
        }
        i = i + 1;
    }
    return out;
}

fn tokenize(tok, text, add_bos = false, add_eos = false) {
    let ids = encode(tok, text, add_bos, add_eos);
    let tokens = [];
    let i = 0;
    while i < len(ids) {
        push(tokens, tok.id_to_token[ids[i]]);
        i = i + 1;
    }
    return tokens;
}

fn metadata(tok) {
    return map{
        format: tok.format,
        kind: tok.kind,
        source: tok.source,
        vocab_size: tok.vocab_size,
        max_vocab: tok.max_vocab,
        specials: _copy_array(DEFAULT_SPECIALS),
        ids: tok.special
    };
}

fn model_io(tok) {
    return map{
        token_format: tok.format,
        input: "array<number> token ids",
        output: "array<number> token ids",
        pad_id: tok.special.pad,
        bos_id: tok.special.bos,
        eos_id: tok.special.eos,
        unk_id: tok.special.unk,
        vocab_size: tok.vocab_size
    };
}

fn describe(tok = nil) {
    if tok == nil { tok = train_default(); }
    return "pbAI tokenizer: " + tok.format + " (" + tok.kind + "), vocab="
        + str(tok.vocab_size) + ", specials=<pad>/<bos>/<eos>/<unk>, all pblang-native.";
}

export train, train_default, encode, decode, tokenize, metadata, model_io, describe;
