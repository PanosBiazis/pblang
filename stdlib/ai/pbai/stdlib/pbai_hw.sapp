// stdlib/pbai_hw.sapp -- pbAI alias for the pblang hardware library.
//
// The real, general-purpose implementation now lives in pblang's stdlib (stdlib:hwinfo.sapp)
// so ANY pblang program can detect the machine and plan compute, not just pbAI. This module
// re-exports it under a stable pbAI name. See stdlib:hwinfo.sapp for the honest compute
// picture (CPU + GPU are usable; NPU/RAM/disks/network/sound are detect-only).

let HW = import("stdlib:hwinfo.sapp");

fn cpu() { return HW.cpu(); }
fn ram() { return HW.ram(); }
fn disks() { return HW.disks(); }
fn gpus() { return HW.gpus(); }
fn npu() { return HW.npu(); }
fn gpu_summary() { return HW.gpu_summary(); }
fn npu_summary() { return HW.npu_summary(); }
fn network() { return HW.network(); }
fn sound() { return HW.sound(); }
fn devices_by_class() { return HW.devices_by_class(); }
fn compute_plan(intensity = "balanced") { return HW.compute_plan(intensity); }
fn survey() { return HW.survey(); }
fn vendor(name) { return HW.vendor(name); }

export cpu, ram, disks, gpus, npu, gpu_summary, npu_summary, network, sound, devices_by_class, compute_plan, survey, vendor;
