// tools/pbai_feed.sapp -- feed local data into pbAI from pblang.
//
// Run from ai/pbai:
//   pblang run tools/pbai_feed.sapp --allow-all -- quick
//   pblang run tools/pbai_feed.sapp --allow-all -- path tests/fixtures 10 2
//   pblang run tools/pbai_feed.sapp --allow-all -- lesson "project rule: ..."
//   pblang run tools/pbai_feed.sapp --allow-all -- drives_survey
//   pblang run tools/pbai_feed.sapp --allow-all -- drives 10 2
//
// Optional:
//   PBAI_FEED_ROOTS="/home/me/data;/mnt/shared;/run/user/.../mtp:host=..." pblang run ...
// Roots are separated with semicolons because MTP paths can contain colons.

let pbai = import("stdlib/pbai.sapp");

fn _arg(idx, fallback = "") {
    let a = os_args();
    let start = 0;
    let i = 0;
    while i < len(a) {
        if a[i] == "--" { start = i + 1; }
        i = i + 1;
    }
    let real = start + idx;
    if real < len(a) { return a[real]; }
    return fallback;
}

fn _int_arg(idx, fallback) {
    let raw = _arg(idx, "");
    if raw == "" { return fallback; }
    let n = 0;
    let i = 0;
    while i < len(raw) {
        let c = strcharcodeat(raw, i);
        if c < 48 or c > 57 { return fallback; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn _print_json(value) {
    print json_stringify(value);
}

fn _feed_path(path, max_files = 20, max_depth = 3, epochs = 3) {
    return pbai.ingest_path(path, max_files, max_depth, epochs);
}

fn _is_dir(path) {
    let items = try fs_listdir(path) catch nil;
    return items != nil;
}

fn _skip_name(name) {
    if name == "" { return true; }
    let n = str_lower(name);
    if str_starts_with(n, ".") { return true; }
    if n == "target" or n == "node_modules" or n == "__pycache__" or n == ".venv" { return true; }
    if n == "cache" or n == "tmp" or n == "temp" or n == "build" or n == "dist" { return true; }
    if n == "bin" or n == "obj" or n == "coverage" { return true; }
    if str_contains(n, "credential") or str_contains(n, "password") or str_contains(n, "passwd") { return true; }
    if str_contains(n, "secret") or str_contains(n, "token") or str_contains(n, "openrouter") { return true; }
    if str_contains(n, "appsettings") or str_contains(n, "api_key") or str_contains(n, "access_key") { return true; }
    if str_starts_with(n, "id_ed25519") or str_starts_with(n, "id_rsa") { return true; }
    if str_ends_with(n, ".pem") or str_ends_with(n, ".p12") or str_ends_with(n, ".pfx") or str_ends_with(n, ".key") { return true; }
    if str_ends_with(n, ".iso") or str_ends_with(n, ".exe") or str_ends_with(n, ".msi") or str_ends_with(n, ".zip") or str_ends_with(n, ".7z") { return true; }
    return false;
}

fn _env_roots() {
    let raw = try env_get("PBAI_FEED_ROOTS") catch nil;
    let roots = [];
    if raw == nil or raw == "" { return roots; }
    let parts = str_split(raw, ";");
    for p in parts {
        let t = str_trim(p);
        if t != "" { push(roots, t); }
    }
    return roots;
}

fn _drive_roots() {
    let roots = _env_roots();
    if len(roots) > 0 { return roots; }
    return [
        ".",
        "../../..",
        "/mnt/win"
    ];
}

fn _survey_root(root, max_items = 40) {
    let items = try fs_listdir(root) catch [];
    let dirs = [];
    let files = [];
    for item in items {
        if not _skip_name(item) {
            let path = root + "/" + item;
            if _is_dir(path) {
                if len(dirs) < max_items { push(dirs, item); }
            } else {
                if len(files) < max_items { push(files, item); }
            }
        }
    }
    return map{ root: root, available: len(items) > 0, dirs: dirs, files: files };
}

fn _survey_drives() {
    let roots = _drive_roots();
    let survey = [];
    let lesson = "pbAI laptop drive survey:\n";
    for root in roots {
        let s = _survey_root(root, 40);
        push(survey, s);
        lesson = lesson + "- root: " + root + " dirs=" + str(s.dirs) + " files=" + str(s.files) + "\n";
    }
    let learned = pbai.learn(lesson, 2);
    return map{ format: "pbai.drive_survey.v1", survey: survey, learned: learned };
}

fn _feed_drives(max_files = 10, max_depth = 2) {
    let results = [];
    for root in _drive_roots() {
        if _is_dir(root) {
            let r = try _feed_path(root, max_files, max_depth, 2) catch map{ path: root, error: "drive ingest failed" };
            push(results, r);
        }
    }
    return map{ format: "pbai.feed.v1", mode: "drives", max_files_per_root: max_files, max_depth: max_depth, results: results };
}

fn _quick_paths() {
    return [
        "tests/fixtures",
        "docs",
        "stdlib",
        "../../datasets/data",
        "../../training/html",
        "../../training/cpp",
        "../../ai/max",
        "../../ai/aipy"
    ];
}

fn _feed_quick() {
    let results = [];
    for p in _quick_paths() {
        let r = try _feed_path(p, 12, 2, 2) catch map{ path: p, error: "ingest failed" };
        push(results, r);
    }
    return map{ format: "pbai.feed.v1", mode: "quick", results: results };
}

fn main() {
    let mode = _arg(0, "help");
    if mode == "lesson" {
        let lesson = _arg(1, "");
        if lesson == "" { _print_json(map{ ok: false, error: "lesson text required" }); return; }
        _print_json(map{ ok: true, mode: mode, result: pbai.learn(lesson, _int_arg(2, 4)) });
        return;
    }
    if mode == "path" {
        let path = _arg(1, "");
        if path == "" { _print_json(map{ ok: false, error: "path required" }); return; }
        _print_json(map{ ok: true, mode: mode, result: _feed_path(path, _int_arg(2, 40), _int_arg(3, 3), _int_arg(4, 3)) });
        return;
    }
    if mode == "quick" {
        _print_json(map{ ok: true, mode: mode, result: _feed_quick() });
        return;
    }
    if mode == "drives_survey" {
        _print_json(map{ ok: true, mode: mode, result: _survey_drives() });
        return;
    }
    if mode == "drives" {
        _print_json(map{ ok: true, mode: mode, result: _feed_drives(_int_arg(1, 10), _int_arg(2, 2)) });
        return;
    }
    _print_json(map{
        ok: true,
        usage: [
            "pblang run tools/pbai_feed.sapp --allow-all -- lesson \"project rule: ...\"",
            "pblang run tools/pbai_feed.sapp --allow-all -- path tests/fixtures 10 2",
            "pblang run tools/pbai_feed.sapp --allow-all -- quick",
            "pblang run tools/pbai_feed.sapp --allow-all -- drives_survey",
            "pblang run tools/pbai_feed.sapp --allow-all -- drives 10 2"
        ]
    });
}

main();
