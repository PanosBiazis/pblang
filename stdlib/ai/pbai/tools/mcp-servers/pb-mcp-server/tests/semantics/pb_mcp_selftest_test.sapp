// Test: the pb-mcp-server `server_selftest` native tool + router dispatch.
// Run: pblang run tests/semantics/pb_mcp_selftest_test.sapp --allow-all

let router = import("src/router.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

// server_selftest runs a curated battery of pure native tools and must be healthy.
let r = router.call("server_selftest", map{});
expect(r.ok, "server_selftest must return ok");
let st = r.value;
expect(st.format == "pb_mcp.selftest.v1", "selftest format tag");
expect(st.total >= 6, "selftest covers at least 6 cases");
expect(st.passed == st.total, "all selftest cases must pass (got " + str(st.passed) + "/" + str(st.total) + ")");
expect(st.failed == 0, "no selftest failures");
expect(st.healthy, "selftest must report healthy");

// every case entry must carry a tool name and ok flag
let i = 0;
while i < len(st.cases) {
    let c = st.cases[i];
    expect(c.ok, "case " + str(c.tool) + " must be ok");
    i = i + 1;
}

// router error path: unknown tools return a structured error, not a crash.
let bad = router.call("definitely_not_a_tool", map{});
expect(not bad.ok, "unknown tool must return ok=false");
expect(len(bad.error) > 0, "unknown tool must include an error message");

// a couple of real handlers across categories
expect(router.call("text_stats", map{ text: "a b a" }).ok, "text_stats handler");
expect(router.call("algo_gcd_lcm", map{ a: 12, b: 18 }).ok, "algo handler");

// server_meta_tools lists the router-native meta-tools for discoverability.
let mt = router.call("server_meta_tools", map{});
expect(mt.ok, "server_meta_tools returns ok");
expect(mt.value.format == "pb_mcp.meta_tools.v1", "meta_tools format");
expect(len(mt.value.tools) >= 6, "meta_tools lists the server-native tools");

print "pb_mcp_selftest_pass";
