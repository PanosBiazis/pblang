// Native pblang translations for deterministic algorithm tools.

let sec = import("src/security.sapp");
let text_tools = import("src/text_tools.sapp");
let graphlib = import("stdlib:graph.sapp");
let bend = import("stdlib:bend.sapp");

fn _abs(x) {
    if x < 0 { return 0 - x; }
    return x;
}

fn _min(a, b) {
    if a < b { return a; }
    return b;
}

fn _max(a, b) {
    if a > b { return a; }
    return b;
}

fn _copy(items, limit) {
    let out = [];
    let n = sec.clamp(len(items), 0, limit);
    for i n { out[len(out)] = items[i]; }
    return out;
}

fn _sum(values) {
    let s = 0.0;
    for i len(values) { s = s + values[i]; }
    return s;
}

fn _mean(values) {
    if len(values) == 0 { return 0.0; }
    return _sum(values) / len(values);
}

fn _sort_numbers(values) {
    let out = _copy(values, 10000);
    for i len(out) {
        let j = i;
        while j > 0 and out[j - 1] > out[j] {
            let t = out[j - 1];
            out[j - 1] = out[j];
            out[j] = t;
            j = j - 1;
        }
    }
    return out;
}

fn _sort_items(items, reverse) {
    let out = _copy(items, 10000);
    for i len(out) {
        let j = i;
        while j > 0 {
            let should_swap = false;
            if reverse == true {
                should_swap = out[j - 1] < out[j];
            } else {
                should_swap = out[j - 1] > out[j];
            }
            if not should_swap { break; }
            let t = out[j - 1];
            out[j - 1] = out[j];
            out[j] = t;
            j = j - 1;
        }
    }
    return out;
}

fn _percentile_sorted(sorted, p) {
    if len(sorted) == 0 { return 0.0; }
    if len(sorted) == 1 { return sorted[0]; }
    if p < 0 { p = 0; }
    if p > 100 { p = 100; }
    let pos = (p / 100.0) * (len(sorted) - 1);
    let lo = num_floor(pos);
    let hi = num_ceil(pos);
    if lo == hi { return sorted[lo]; }
    let frac = pos - lo;
    return sorted[lo] + (sorted[hi] - sorted[lo]) * frac;
}

fn _variance(values) {
    if len(values) < 2 { return 0.0; }
    let m = _mean(values);
    let s = 0.0;
    for i len(values) {
        let d = values[i] - m;
        s = s + d * d;
    }
    return s / (len(values) - 1);
}

fn _stddev(values) {
    return num_sqrt(_variance(values));
}

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _unique_push(arr, value) {
    if not _contains(arr, value) { arr[len(arr)] = value; }
    return arr;
}

fn _words(text) {
    let s = str_lower(str(text));
    let cleaned = "";
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_ ";
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        if str_contains(allowed, ch) { cleaned = cleaned + ch; }
        else { cleaned = cleaned + " "; }
    }
    let raw = str_split(cleaned, " ");
    let out = [];
    for i len(raw) {
        let w = str_trim(raw[i]);
        if w != "" { out[len(out)] = w; }
    }
    return out;
}

fn _shingles(s, n) {
    s = str(s);
    n = sec.clamp(n, 1, 20);
    let out = [];
    if len(s) == 0 { return out; }
    if len(s) <= n {
        out[len(out)] = s;
        return out;
    }
    for i len(s) - n + 1 {
        out = _unique_push(out, str_slice(s, i, i + n));
    }
    return out;
}

fn _hash_num(text) {
    let raw = text_tools.text_djb2_hash(text);
    return try parse_number(raw) catch 0;
}

fn _hash_hex(text) {
    let n = _hash_num(text);
    let hex = "0123456789abcdef";
    let out = "";
    if n == 0 { return "0"; }
    while n > 0 {
        let digit = n % 16;
        out = str_slice(hex, digit, digit + 1) + out;
        n = num_floor(n / 16);
    }
    return out;
}

fn _graph_from_adjacency(spec, weighted) {
    let g = graphlib.new(true);
    let keys = map_keys(spec);
    for i len(keys) {
        let from = str(keys[i]);
        graphlib.add_node(g, from, map{});
        let edges = spec[keys[i]];
        if weighted == true and type(edges) == "map" {
            let ekeys = map_keys(edges);
            for j len(ekeys) {
                graphlib.add_edge(g, from, str(ekeys[j]), edges[ekeys[j]]);
            }
        } else {
            for j len(edges) { graphlib.add_edge(g, from, str(edges[j]), 1.0); }
        }
    }
    return g;
}

fn algo_sort(args) {
    let items = try args.items catch [];
    let reverse = try args.reverse catch false;
    let algorithm = try args.algorithm catch "auto";
    if reverse != true and (algorithm == "auto" or algorithm == "mergesort" or algorithm == "bend") {
        let arr = _copy(items, 10000);
        let sorted = try bend.divide_sort(arr, fn(a, b) { return a < b; }, 4) catch _sort_items(arr, false);
        return map{ items: sorted, count: len(sorted), algorithm: "bend.divide_sort" };
    }
    let sorted = _sort_items(items, reverse);
    return map{ items: sorted, count: len(sorted), algorithm: "insertion_sort_bounded" };
}

fn algo_search(args) {
    let items = try args.items catch [];
    let target = try args.target catch nil;
    let method = try args.method catch "linear";
    if method == "binary" {
        let lo = 0;
        let hi = len(items) - 1;
        while lo <= hi {
            let mid = num_floor((lo + hi) / 2);
            if items[mid] == target { return map{ found: true, index: mid, method: method }; }
            if items[mid] < target { lo = mid + 1; }
            else { hi = mid - 1; }
        }
        return map{ found: false, index: -1, method: method };
    }
    for i len(items) {
        if items[i] == target { return map{ found: true, index: i, method: "linear" }; }
    }
    return map{ found: false, index: -1, method: "linear" };
}

fn algo_binary_search_bounds(args) {
    let items = try args.items catch [];
    let target = try args.target catch nil;
    let lower = -1;
    let upper = -1;
    for i len(items) {
        if items[i] == target {
            if lower < 0 { lower = i; }
            upper = i + 1;
        }
    }
    return map{ target: target, lower_bound: lower, upper_bound: upper, count: if lower < 0 { 0 } else { upper - lower } };
}

fn algo_graph_bfs(args) {
    let g = _graph_from_adjacency(try args.graph catch map{}, false);
    let order = graphlib.bfs(g, try args.start catch "");
    return map{ order: order, count: len(order) };
}

fn algo_graph_dfs(args) {
    let g = _graph_from_adjacency(try args.graph catch map{}, false);
    let order = graphlib.dfs(g, try args.start catch "");
    return map{ order: order, count: len(order) };
}

fn algo_graph_topo_sort(args) {
    let g = _graph_from_adjacency(try args.graph catch map{}, false);
    let order = graphlib.topological_sort(g);
    if order == nil { return map{ ok: false, error: "cycle detected" }; }
    return map{ ok: true, order: order, count: len(order) };
}

fn algo_graph_shortest_path(args) {
    let start = str(try args.start catch "");
    let end = str(try args.end catch "");
    let g = _graph_from_adjacency(try args.graph catch map{}, true);
    let dist = graphlib.dijkstra(g, start);
    return map{ start: start, end: end, distance: try dist[end] catch 999999999.0, distances: dist };
}

fn algo_stats_describe(args) {
    let values = _copy(try args.values catch [], 10000);
    let sorted = _sort_numbers(values);
    let n = len(values);
    let counts = map{};
    let mode = nil;
    let mode_count = 0;
    for i n {
        let k = str(values[i]);
        let c = try counts[k] catch 0;
        c = c + 1;
        counts[k] = c;
        if c > mode_count { mode_count = c; mode = values[i]; }
    }
    return map{
        count: n,
        mean: _mean(values),
        median: _percentile_sorted(sorted, 50),
        mode: mode,
        std_dev: _stddev(values),
        min: if n == 0 { 0 } else { sorted[0] },
        max: if n == 0 { 0 } else { sorted[n - 1] },
        p25: _percentile_sorted(sorted, 25),
        p50: _percentile_sorted(sorted, 50),
        p75: _percentile_sorted(sorted, 75),
        p95: _percentile_sorted(sorted, 95),
        p99: _percentile_sorted(sorted, 99),
        iqr: _percentile_sorted(sorted, 75) - _percentile_sorted(sorted, 25),
    };
}

fn algo_stats_correlation(args) {
    let x = _copy(try args.x catch [], 10000);
    let y = _copy(try args.y catch [], 10000);
    let n = _min(len(x), len(y));
    if n < 2 { return map{ correlation: 0.0, n: n, error: "need at least two paired values" }; }
    let mx = _mean(x);
    let my = _mean(y);
    let num = 0.0;
    let sx = 0.0;
    let sy = 0.0;
    for i n {
        let dx = x[i] - mx;
        let dy = y[i] - my;
        num = num + dx * dy;
        sx = sx + dx * dx;
        sy = sy + dy * dy;
    }
    if sx == 0 or sy == 0 { return map{ correlation: 0.0, n: n }; }
    return map{ correlation: num / num_sqrt(sx * sy), n: n, method: "pearson" };
}

fn algo_stats_regression(args) {
    let x = _copy(try args.x catch [], 10000);
    let y = _copy(try args.y catch [], 10000);
    let n = _min(len(x), len(y));
    if n < 2 { return map{ slope: 0.0, intercept: 0.0, r_squared: 0.0, n: n, error: "need at least two paired values" }; }
    let mx = _mean(x);
    let my = _mean(y);
    let num = 0.0;
    let den = 0.0;
    for i n {
        num = num + (x[i] - mx) * (y[i] - my);
        den = den + (x[i] - mx) * (x[i] - mx);
    }
    let slope = if den == 0 { 0.0 } else { num / den };
    let intercept = my - slope * mx;
    let corr = algo_stats_correlation(map{ x: x, y: y }).correlation;
    return map{ slope: slope, intercept: intercept, r_squared: corr * corr, n: n };
}

fn algo_matrix_ops(args) {
    let op = try args.operation catch "transpose";
    let a = try args.a catch [];
    if op == "transpose" {
        let out = [];
        if len(a) == 0 { return map{ operation: op, result: out }; }
        for c len(a[0]) {
            let row = [];
            for r len(a) { row[len(row)] = a[r][c]; }
            out[len(out)] = row;
        }
        return map{ operation: op, result: out };
    }
    if op == "multiply" {
        let b = try args.b catch [];
        let out = [];
        if len(a) == 0 or len(b) == 0 { return map{ operation: op, result: out }; }
        for r len(a) {
            let row = [];
            for c len(b[0]) {
                let s = 0.0;
                for k len(b) { s = s + a[r][k] * b[k][c]; }
                row[len(row)] = s;
            }
            out[len(out)] = row;
        }
        return map{ operation: op, result: out };
    }
    if op == "determinant" {
        return map{ operation: op, result: _determinant(a) };
    }
    return map{ operation: op, error: "unsupported operation in pblang port" };
}

fn _determinant(m) {
    let n = len(m);
    if n == 0 { return 0.0; }
    let a = [];
    for r n {
        let row = [];
        for c n { row[len(row)] = m[r][c]; }
        a[len(a)] = row;
    }
    let det = 1.0;
    let sign = 1.0;
    for i n {
        let pivot = i;
        let best = _abs(a[i][i]);
        for r in i + 1 to n - 1 {
            let v = _abs(a[r][i]);
            if v > best { best = v; pivot = r; }
        }
        if best == 0 { return 0.0; }
        if pivot != i {
            let tmp = a[i];
            a[i] = a[pivot];
            a[pivot] = tmp;
            sign = 0 - sign;
        }
        let pv = a[i][i];
        det = det * pv;
        for r in i + 1 to n - 1 {
            let factor = a[r][i] / pv;
            for c in i to n - 1 {
                a[r][c] = a[r][c] - factor * a[i][c];
            }
        }
    }
    return det * sign;
}

fn algo_ngram_similarity(args) {
    let a = _shingles(try args.a catch try args.text_a catch "", try args.n catch try args.ngram catch 2);
    let b = _shingles(try args.b catch try args.text_b catch "", try args.n catch try args.ngram catch 2);
    let union = [];
    let inter = 0;
    for i len(a) { union = _unique_push(union, a[i]); }
    for i len(b) {
        if _contains(a, b[i]) { inter = inter + 1; }
        union = _unique_push(union, b[i]);
    }
    let sim = if len(union) == 0 { 1.0 } else { inter / len(union); };
    return map{ similarity: sim, intersection: inter, union: len(union), ngram: try args.n catch try args.ngram catch 2 };
}

fn algo_cosine_similarity(args) {
    let a = try args.a catch nil;
    let b = try args.b catch nil;
    if a != nil and b != nil {
        let n = _min(len(a), len(b));
        let dot = 0.0;
        let na = 0.0;
        let nb = 0.0;
        for i n {
            dot = dot + a[i] * b[i];
            na = na + a[i] * a[i];
            nb = nb + b[i] * b[i];
        }
        if na == 0 or nb == 0 { return map{ similarity: 0.0, n: n }; }
        return map{ similarity: dot / num_sqrt(na * nb), n: n };
    }
    let wa = _words(try args.text_a catch "");
    let wb = _words(try args.text_b catch "");
    let vocab = [];
    for i len(wa) { vocab = _unique_push(vocab, wa[i]); }
    for i len(wb) { vocab = _unique_push(vocab, wb[i]); }
    let va = [];
    let vb = [];
    for i len(vocab) {
        let ca = 0;
        let cb = 0;
        for j len(wa) { if wa[j] == vocab[i] { ca = ca + 1; } }
        for j len(wb) { if wb[j] == vocab[i] { cb = cb + 1; } }
        va[len(va)] = ca;
        vb[len(vb)] = cb;
    }
    return algo_cosine_similarity(map{ a: va, b: vb });
}

fn algo_edit_distance(args) {
    return text_tools.text_levenshtein_distance(try args.a catch "", try args.b catch "", try args.max_len catch 1000);
}

fn algo_hash_text(args) {
    let txt = try args.text catch "";
    return map{ algorithm: "djb2-hex-pblang", digest: _hash_hex(txt), decimal: text_tools.text_djb2_hash(txt) };
}

fn algo_gcd_lcm(args) {
    let a = try args.a catch 0;
    let b = try args.b catch 0;
    let aa = _abs(a);
    let bb = _abs(b);
    while bb != 0 {
        let t = bb;
        bb = aa % bb;
        aa = t;
    }
    let gcd = aa;
    let lcm = if gcd == 0 { 0 } else { _abs(a * b) / gcd };
    return map{ gcd: gcd, lcm: lcm };
}

fn algo_fibonacci(args) {
    let n = sec.clamp(try args.n catch 0, 0, 186);
    let a = 0;
    let b = 1;
    for i n {
        let t = a + b;
        a = b;
        b = t;
    }
    return map{ n: n, value: a };
}

fn algo_is_prime(args) {
    let n = try args.n catch 0;
    if n < 2 { return map{ n: n, prime: false }; }
    if n == 2 { return map{ n: n, prime: true }; }
    if n % 2 == 0 { return map{ n: n, prime: false }; }
    let d = 3;
    while d * d <= n {
        if n % d == 0 { return map{ n: n, prime: false }; }
        d = d + 2;
    }
    return map{ n: n, prime: true };
}

fn algo_prime_factors(args) {
    let n = try args.n catch 1;
    let out = [];
    let d = 2;
    while n > 1 and d * d <= n {
        while n % d == 0 {
            out[len(out)] = d;
            n = n / d;
        }
        if d == 2 { d = 3; } else { d = d + 2; }
    }
    if n > 1 { out[len(out)] = n; }
    return map{ factors: out };
}

fn algo_set_ops(args) {
    let a = try args.a catch [];
    let b = try args.b catch [];
    let union = [];
    let inter = [];
    let only_a = [];
    let only_b = [];
    for i len(a) {
        union = _unique_push(union, a[i]);
        if _contains(b, a[i]) { inter = _unique_push(inter, a[i]); }
        else { only_a = _unique_push(only_a, a[i]); }
    }
    for i len(b) {
        union = _unique_push(union, b[i]);
        if not _contains(a, b[i]) { only_b = _unique_push(only_b, b[i]); }
    }
    return map{ union: union, intersection: inter, only_a: only_a, only_b: only_b };
}

fn algo_text_chunks(args) {
    let s = str(try args.text catch "");
    let size = sec.clamp(try args.chunk_size catch 1000, 1, 200000);
    let overlap = sec.clamp(try args.overlap catch 0, 0, size - 1);
    let out = [];
    let i = 0;
    while i < len(s) {
        let end = i + size;
        if end > len(s) { end = len(s); }
        out[len(out)] = map{ start: i, end: end, text: str_slice(s, i, end) };
        if end == len(s) { break; }
        i = end - overlap;
    }
    return map{ chunks: out, count: len(out), chunk_size: size, overlap: overlap };
}

fn algo_dataset_quality(args) {
    let records = try args.records catch [];
    let seen = map{};
    let empty = 0;
    let duplicates = 0;
    let secret_like = 0;
    let lengths = [];
    for i len(records) {
        let s = str(records[i]);
        lengths[len(lengths)] = len(s);
        if str_trim(s) == "" { empty = empty + 1; }
        let key = text_tools.text_djb2_hash(s);
        if map_has(seen, key) { duplicates = duplicates + 1; }
        else { seen[key] = true; }
        let low = str_lower(s);
        if str_contains(low, "password") or str_contains(low, "token") or str_contains(low, "secret") or str_contains(s, "sk-") {
            secret_like = secret_like + 1;
        }
    }
    let desc = algo_stats_describe(map{ values: lengths });
    return map{ records: len(records), empty: empty, duplicate_records: duplicates, unique_records: len(map_keys(seen)), secret_like: secret_like, length_stats: desc };
}

fn algo_base_convert(args) {
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    let value = str_lower(str(try args.value catch "0"));
    let from_base = sec.clamp(try args.from_base catch 10, 2, 36);
    let to_base = sec.clamp(try args.to_base catch 10, 2, 36);
    let n = 0;
    for i len(value) {
        let ch = str_slice(value, i, i + 1);
        let d = str_index_of(digits, ch);
        if d < 0 or d >= from_base { return map{ error: "invalid digit for base", value: value }; }
        n = n * from_base + d;
    }
    if n == 0 { return map{ value: "0", from_base: from_base, to_base: to_base }; }
    let out = "";
    while n > 0 {
        let d = n % to_base;
        out = str_slice(digits, d, d + 1) + out;
        n = num_floor(n / to_base);
    }
    return map{ value: out, from_base: from_base, to_base: to_base };
}

fn algo_combinations_count(args) {
    let n = sec.clamp(try args.n catch 0, 0, 1000);
    let k = sec.clamp(try args.k catch 0, 0, n);
    if k > n - k { k = n - k; }
    let res = 1.0;
    for i in 1 to k {
        res = (res * (n - k + i)) / i;
    }
    return map{ n: n, k: k, count: res };
}

fn algo_permutations_count(args) {
    let n = sec.clamp(try args.n catch 0, 0, 170);
    let k = sec.clamp(try args.k catch 0, 0, n);
    let res = 1.0;
    for i in 0 to k - 1 { res = res * (n - i); }
    return map{ n: n, k: k, count: res };
}

fn algo_frequency_table(args) {
    let mode = try args.mode catch "word";
    let limit = sec.clamp(try args.limit catch 50, 1, 500);
    let counts = map{};
    if mode == "char" {
        let s = str(try args.text catch "");
        for i len(s) {
            let ch = str_slice(s, i, i + 1);
            counts[ch] = (try counts[ch] catch 0) + 1;
        }
    } else {
        let ws = _words(try args.text catch "");
        for i len(ws) { counts[ws[i]] = (try counts[ws[i]] catch 0) + 1; }
    }
    return map{ mode: mode, items: _top_count_map(counts, limit) };
}

fn _top_count_map(counts, limit) {
    let keys = map_keys(counts);
    let used = map{};
    let out = [];
    let n = sec.clamp(limit, 1, 500);
    for rank n {
        let best = nil;
        let best_count = -1;
        for i len(keys) {
            let k = keys[i];
            if (try used[k] catch false) != true and counts[k] > best_count {
                best = k;
                best_count = counts[k];
            }
        }
        if best != nil {
            used[best] = true;
            out[len(out)] = map{ value: best, count: best_count };
        }
    }
    return out;
}

fn algo_entropy(args) {
    let s = str(try args.text catch "");
    if len(s) == 0 { return map{ entropy_bits_per_char: 0.0, chars: 0 }; }
    let counts = map{};
    for i len(s) {
        let ch = str_slice(s, i, i + 1);
        counts[ch] = (try counts[ch] catch 0) + 1;
    }
    let h = 0.0;
    let keys = map_keys(counts);
    for i len(keys) {
        let p = counts[keys[i]] / len(s);
        h = h - p * (num_ln(p) / num_ln(2));
    }
    return map{ entropy_bits_per_char: h, chars: len(s), distinct: len(keys) };
}

fn algo_moving_average(args) {
    let values = _copy(try args.values catch [], 10000);
    let window = sec.clamp(try args.window catch 3, 1, _max(1, len(values)));
    let out = [];
    for i len(values) {
        let start = i - window + 1;
        if start < 0 { start = 0; }
        let s = 0.0;
        let c = 0;
        for j in start to i {
            s = s + values[j];
            c = c + 1;
        }
        out[len(out)] = s / c;
    }
    return map{ window: window, values: out };
}

fn algo_numeric_histogram(args) {
    let values = _copy(try args.values catch [], 10000);
    let bins = sec.clamp(try args.bins catch 10, 1, 200);
    if len(values) == 0 { return map{ bins: [], count: 0 }; }
    let sorted = _sort_numbers(values);
    let minv = sorted[0];
    let maxv = sorted[len(sorted) - 1];
    let counts = [];
    for i bins { counts[i] = 0; }
    for i len(values) {
        let idx = 0;
        if maxv != minv {
            idx = num_floor(((values[i] - minv) / (maxv - minv)) * bins);
            if idx >= bins { idx = bins - 1; }
        }
        counts[idx] = counts[idx] + 1;
    }
    let out = [];
    for i bins {
        let start = minv + (maxv - minv) * i / bins;
        let end = minv + (maxv - minv) * (i + 1) / bins;
        out[len(out)] = map{ start: start, end: end, count: counts[i] };
    }
    return map{ bins: out, count: len(values), min: minv, max: maxv };
}

fn algo_percentile(args) {
    let values = _sort_numbers(try args.values catch []);
    let p = try args.percentile catch 50;
    return map{ percentile: p, value: _percentile_sorted(values, p) };
}

fn algo_outliers_iqr(args) {
    let values = _copy(try args.values catch [], 10000);
    let sorted = _sort_numbers(values);
    let mult = try args.multiplier catch 1.5;
    let q1 = _percentile_sorted(sorted, 25);
    let q3 = _percentile_sorted(sorted, 75);
    let iqr = q3 - q1;
    let low = q1 - mult * iqr;
    let high = q3 + mult * iqr;
    let out = [];
    for i len(values) {
        if values[i] < low or values[i] > high { out[len(out)] = map{ index: i, value: values[i] }; }
    }
    return map{ lower_fence: low, upper_fence: high, outliers: out };
}

fn algo_normalize_scores(args) {
    let values = _copy(try args.values catch [], 10000);
    let method = try args.method catch "minmax";
    let out = [];
    if len(values) == 0 { return map{ method: method, values: out }; }
    if method == "zscore" {
        let m = _mean(values);
        let sd = _stddev(values);
        for i len(values) { out[len(out)] = if sd == 0 { 0.0 } else { (values[i] - m) / sd }; }
        return map{ method: method, values: out };
    }
    let sorted = _sort_numbers(values);
    let minv = sorted[0];
    let maxv = sorted[len(sorted) - 1];
    for i len(values) { out[len(out)] = if maxv == minv { 0.0 } else { (values[i] - minv) / (maxv - minv) }; }
    return map{ method: "minmax", values: out };
}

fn algo_rolling_stats(args) {
    let values = _copy(try args.values catch [], 10000);
    let window = sec.clamp(try args.window catch 3, 1, _max(1, len(values)));
    let out = [];
    for i len(values) {
        let start = i - window + 1;
        if start < 0 { start = 0; }
        let w = [];
        for j in start to i { w[len(w)] = values[j]; }
        let sorted = _sort_numbers(w);
        out[len(out)] = map{ index: i, mean: _mean(w), min: sorted[0], max: sorted[len(sorted) - 1], std_dev: _stddev(w) };
    }
    return map{ window: window, stats: out };
}

fn algo_label_distribution(args) {
    let labels = try args.labels catch [];
    let counts = map{};
    for i len(labels) {
        let k = str(labels[i]);
        counts[k] = (try counts[k] catch 0) + 1;
    }
    let top = _top_count_map(counts, len(map_keys(counts)));
    let entropy = 0.0;
    for i len(top) {
        let p = top[i].count / _max(1, len(labels));
        entropy = entropy - p * (num_ln(p) / num_ln(2));
    }
    return map{ count: len(labels), distribution: top, entropy: entropy, majority: if len(top) == 0 { nil } else { top[0] } };
}

fn algo_sieve_primes(args) {
    let limit = sec.clamp(try args.limit catch 100, 2, 100000);
    let sieve = [];
    for i limit + 1 { sieve[i] = true; }
    sieve[0] = false;
    sieve[1] = false;
    let p = 2;
    while p * p <= limit {
        if sieve[p] == true {
            let j = p * p;
            while j <= limit {
                sieve[j] = false;
                j = j + p;
            }
        }
        p = p + 1;
    }
    let out = [];
    for i limit + 1 { if sieve[i] == true { out[len(out)] = i; } }
    return map{ limit: limit, primes: out, count: len(out) };
}

fn algo_run_length_encode(args) {
    let s = str(try args.text catch "");
    let out = [];
    if len(s) == 0 { return map{ runs: out }; }
    let cur = str_slice(s, 0, 1);
    let count = 1;
    for i in 1 to len(s) - 1 {
        let ch = str_slice(s, i, i + 1);
        if ch == cur { count = count + 1; }
        else {
            out[len(out)] = map{ value: cur, count: count };
            cur = ch;
            count = 1;
        }
    }
    out[len(out)] = map{ value: cur, count: count };
    return map{ runs: out };
}

fn algo_top_k(args) {
    let mode = try args.mode catch "frequency";
    let k = sec.clamp(try args.k catch 5, 1, 500);
    if mode == "largest" or mode == "smallest" {
        let values = _sort_numbers(try args.values catch []);
        let out = [];
        if mode == "largest" {
            let i = len(values) - 1;
            while i >= 0 and len(out) < k { out[len(out)] = values[i]; i = i - 1; }
        } else {
            for i len(values) { if len(out) < k { out[len(out)] = values[i]; } }
        }
        return map{ mode: mode, values: out };
    }
    let items = try args.items catch [];
    let counts = map{};
    for i len(items) {
        let key = str(items[i]);
        counts[key] = (try counts[key] catch 0) + 1;
    }
    return map{ mode: "frequency", items: _top_count_map(counts, k) };
}

fn call_algorithm(tool, args) {
    if args == nil { args = map{}; }
    if tool == "algo_sort" { return algo_sort(args); }
    if tool == "algo_search" { return algo_search(args); }
    if tool == "algo_binary_search_bounds" { return algo_binary_search_bounds(args); }
    if tool == "algo_graph_bfs" { return algo_graph_bfs(args); }
    if tool == "algo_graph_dfs" { return algo_graph_dfs(args); }
    if tool == "algo_graph_shortest_path" { return algo_graph_shortest_path(args); }
    if tool == "algo_graph_topo_sort" { return algo_graph_topo_sort(args); }
    if tool == "algo_stats_describe" { return algo_stats_describe(args); }
    if tool == "algo_stats_correlation" { return algo_stats_correlation(args); }
