    if tool == "algo_matrix_ops" { return algo_matrix_ops(args); }
    if tool == "algo_ngram_similarity" { return algo_ngram_similarity(args); }
    if tool == "algo_cosine_similarity" { return algo_cosine_similarity(args); }
