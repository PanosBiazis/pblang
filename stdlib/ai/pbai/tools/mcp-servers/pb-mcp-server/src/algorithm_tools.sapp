    if tool == "algo_hash_text" { return algo_hash_text(args); }
    if tool == "algo_gcd_lcm" { return algo_gcd_lcm(args); }
    if tool == "algo_fibonacci" { return algo_fibonacci(args); }
    if tool == "algo_is_prime" { return algo_is_prime(args); }
    if tool == "algo_prime_factors" { return algo_prime_factors(args); }
    if tool == "algo_set_ops" { return algo_set_ops(args); }
    if tool == "algo_text_chunks" { return algo_text_chunks(args); }
    if tool == "algo_dataset_quality" { return algo_dataset_quality(args); }
    if tool == "algo_base_convert" { return algo_base_convert(args); }
    if tool == "algo_combinations_count" { return algo_combinations_count(args); }
    if tool == "algo_permutations_count" { return algo_permutations_count(args); }
    if tool == "algo_frequency_table" { return algo_frequency_table(args); }
    if tool == "algo_entropy" { return algo_entropy(args); }
    if tool == "algo_moving_average" { return algo_moving_average(args); }
    if tool == "algo_numeric_histogram" { return algo_numeric_histogram(args); }
    if tool == "algo_percentile" { return algo_percentile(args); }
    if tool == "algo_outliers_iqr" { return algo_outliers_iqr(args); }
    if tool == "algo_normalize_scores" { return algo_normalize_scores(args); }
    if tool == "algo_rolling_stats" { return algo_rolling_stats(args); }
    if tool == "algo_label_distribution" { return algo_label_distribution(args); }
    if tool == "algo_sieve_primes" { return algo_sieve_primes(args); }
    if tool == "algo_run_length_encode" { return algo_run_length_encode(args); }
    if tool == "algo_top_k" { return algo_top_k(args); }
    return nil;
}

