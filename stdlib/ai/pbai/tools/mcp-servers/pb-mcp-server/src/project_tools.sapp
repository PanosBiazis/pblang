// Native pblang project tool plans.
//
// These mirror the Rust server's bounded command builders without executing
// cargo/pytest. The terminal execution gate remains a separate porting step.

let sec = import("src/security.sapp");

fn _bool(args, name, fallback = false) {
    return try args[name] catch fallback;
}

fn _push_if(arr, cond, value) {
    if cond { arr[len(arr)] = value; }
    return arr;
}

fn _cargo_args(args, mode) {
    let argv = [mode, "--message-format", "short"];
    argv = _push_if(argv, _bool(args, "workspace", false), "--workspace");
    argv = _push_if(argv, _bool(args, "all_targets", false), "--all-targets");
    argv = _push_if(argv, _bool(args, "all_features", false), "--all-features");
    argv = _push_if(argv, _bool(args, "no_default_features", false), "--no-default-features");
    let package = try args.package catch "";
    if package != "" { argv[len(argv)] = "-p"; argv[len(argv)] = str(package); }
    let jobs = sec.clamp(try args.jobs catch 0, 0, 256);
    if jobs > 0 { argv[len(argv)] = "-j"; argv[len(argv)] = str(jobs); }
    if mode == "test" {
        argv = _push_if(argv, _bool(args, "no_run", false), "--no-run");
        let filter = try args.filter catch "";
        if filter != "" { argv[len(argv)] = str(filter); }
        if _bool(args, "nocapture", false) { argv[len(argv)] = "--"; argv[len(argv)] = "--nocapture"; }
    }
    return argv;
}

fn project_cargo_check(args) {
    if args == nil { args = map{}; }
    let dir = sec.safe_rel_path(try args.dir catch try args.directory catch ".", ".");
    return map{
        ok: true,
        executed: false,
        program: "cargo",
        argv: _cargo_args(args, "check"),
        directory: dir,
        timeout_ms: sec.clamp(try args.timeout_ms catch 600000, 1000, 600000),
        gates: ["trusted-or-lan profile", "MINT_PROJECT_TEST_ENABLE=1", "cargo in terminal allowlist"],
    };
}

fn project_cargo_test(args) {
    if args == nil { args = map{}; }
    let dir = sec.safe_rel_path(try args.dir catch try args.directory catch ".", ".");
    return map{
        ok: true,
        executed: false,
        program: "cargo",
        argv: _cargo_args(args, "test"),
        directory: dir,
        timeout_ms: sec.clamp(try args.timeout_ms catch 600000, 1000, 600000),
        gates: ["trusted-or-lan profile", "MINT_PROJECT_TEST_ENABLE=1", "cargo in terminal allowlist"],
    };
}

fn project_pytest(args) {
    if args == nil { args = map{}; }
    let dir = sec.safe_rel_path(try args.dir catch try args.directory catch ".", ".");
    let path = sec.safe_rel_path(try args.test_path catch try args.path catch ".", ".");
    let argv = [path];
    if _bool(args, "quiet", true) { argv[len(argv)] = "-q"; }
    let keyword = try args.keyword catch try args.k catch "";
    if keyword != "" { argv[len(argv)] = "-k"; argv[len(argv)] = str(keyword); }
    let maxfail = sec.clamp(try args.maxfail catch 0, 0, 100);
    if maxfail > 0 { argv[len(argv)] = "--maxfail"; argv[len(argv)] = str(maxfail); }
    return map{
        ok: true,
        executed: false,
        program: "pytest",
        argv: argv,
        directory: dir,
        timeout_ms: sec.clamp(try args.timeout_ms catch 600000, 1000, 600000),
        gates: ["trusted-or-lan profile", "MINT_PROJECT_TEST_ENABLE=1", "pytest in terminal allowlist"],
    };
}

fn call_project(tool, args) {
    if tool == "project_cargo_check" { return project_cargo_check(args); }
    if tool == "project_cargo_test" { return project_cargo_test(args); }
    if tool == "project_pytest" { return project_pytest(args); }
    return nil;
}

fn implemented_tools() {
    return ["project_cargo_check", "project_cargo_test", "project_pytest"];
}

export implemented_tools, call_project,
       project_cargo_check, project_cargo_test, project_pytest;
