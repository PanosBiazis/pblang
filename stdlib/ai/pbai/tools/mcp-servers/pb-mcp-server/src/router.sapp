// Tool router for the pblang pb-mcp-server port.

let catalog = import("src/catalog.sapp");
let watchertools = import("src/watcher_tools.sapp");
let core = import("src/core_tools.sapp");
let thinking = import("src/thinking_tools.sapp");
let text = import("src/text_tools.sapp");
let runtime = import("src/runtime_tools.sapp");
let algorithm = import("src/algorithm_tools.sapp");
let codebase = import("src/codebase_tools.sapp");
let workspace = import("src/workspace_tools.sapp");
let git = import("src/git_tools.sapp");
let convert = import("src/convert_tools.sapp");
let logtools = import("src/log_tools.sapp");
let chart = import("src/chart_tools.sapp");
let agent = import("src/agent_tools.sapp");
let mcp = import("src/mcp_tools.sapp");
let history = import("src/history_tools.sapp");
let consensus = import("src/consensus_tools.sapp");
let system = import("src/system_tools.sapp");
let app = import("src/app_tools.sapp");
let review = import("src/review_tools.sapp");
let wait = import("src/wait_tools.sapp");
let filetools = import("src/file_tools.sapp");
let shelltools = import("src/shell_tools.sapp");
let mltools = import("src/ml_tools.sapp");
let protect = import("src/protect_tools.sapp");
let terminal = import("src/terminal_tools.sapp");
let codeindex = import("src/code_index_tools.sapp");
let context = import("src/context_tools.sapp");
let debug = import("src/debug_tools.sapp");
let ide = import("src/ide_tools.sapp");
let aitools = import("src/ai_tools.sapp");
let quantum = import("src/quantum_tools.sapp");
let projecttools = import("src/project_tools.sapp");
let webtools = import("src/web_tools.sapp");
let mediatools = import("src/media_tools.sapp");
let netiot = import("src/net_iot_tools.sapp");
let retools = import("src/re_tools.sapp");
let sandboxtools = import("src/sandbox_tools.sapp");
let completion = import("src/completion_tools.sapp");
let security = import("src/security_tools.sapp");
let finance = import("src/finance_tools.sapp");
let probability = import("src/prob_tools.sapp");
let inferential = import("src/inferential_tools.sapp");
let timeseries = import("src/timeseries_tools.sapp");
let indicators = import("src/indicator_tools.sapp");

// Per-category handlers, in priority order (first that claims a tool wins — same
// order as the original chain). Each `call_X(tool, args)` returns nil if it does
// not own `tool`. Stored as first-class function values so dispatch is a loop
// over this array instead of a 38-branch if-chain.
let _handlers = [
    core.call_core, thinking.call_thinking, text.call_text, runtime.call_runtime,
    algorithm.call_algorithm, codebase.call_codebase, workspace.call_workspace,
    git.call_git, convert.call_convert, logtools.call_log, chart.call_chart,
    agent.call_agent, mcp.call_mcp, history.call_history, consensus.call_consensus,
    system.call_system, app.call_app, review.call_review, wait.call_wait,
    filetools.call_file, shelltools.call_shell, mltools.call_ml, protect.call_protect,
    terminal.call_terminal, codeindex.call_code_index, context.call_context,
    debug.call_debug, ide.call_ide, aitools.call_ai, quantum.call_quantum,
    projecttools.call_project, webtools.call_web, mediatools.call_media,
    netiot.call_net_iot, retools.call_re, sandboxtools.call_sandbox,
    completion.call_completion, watchertools.call_watch, security.call_security,
    finance.call_finance, probability.call_probability,
    inferential.call_inferential, timeseries.call_timeseries,
    indicators.call_indicators
];

// tool name -> index into _handlers that served it (filled on first hit), so
// repeated calls skip the linear scan: O(1) amortized dispatch.
let _dispatch_cache = map{};

fn ok(tool, value) {
    return map{ ok: true, tool: tool, value: value };
}

fn err(tool, message) {
    return map{ ok: false, tool: tool, error: message };
}

fn call(tool, args = nil) {
    if args == nil { args = map{}; }

    if tool == "tools_runtime_status" or tool == "tool_status" {
        return ok(tool, catalog.status());
    }
    if tool == "tool_catalog" or tool == "tools_catalog" {
        return ok(tool, catalog.tool_catalog());
    }
    if tool == "tool_search" or tool == "tools_search" {
        return ok(tool, catalog.search_tools(try args.query catch ""));
    }
    if tool == "implemented_catalog" {
        return ok(tool, catalog.implemented_catalog());
    }
    if tool == "server_selftest" {
        return ok(tool, _selftest());
    }
    if tool == "server_meta_tools" {
        return ok(tool, _meta_tools());
    }
    if tool == "native_tool_groups" {
        return ok(tool, _native_tool_groups());
    }

    // Fast path: a tool we've dispatched before goes straight to its handler.
    let cached = try _dispatch_cache[tool] catch nil;
    if cached != nil {
        let cv = _handlers[cached](tool, args);
        if cv != nil { return ok(tool, cv); }
    }
    // Linear scan over the handler array; cache the winning index for next time.
    let i = 0;
    while i < len(_handlers) {
        let hv = _handlers[i](tool, args);
        if hv != nil {
            _dispatch_cache[tool] = i;
            return ok(tool, hv);
        }
        i = i + 1;
    }

    let meta = catalog.find_tool(tool);
    if meta != nil {
        return err(tool, "tool is known from the Rust pb-mcp-server catalog but is not yet natively implemented in pblang; port module '" + meta.source + "' next");
    }
    return err(tool, "unknown tool: " + str(tool));
}

// server_meta_tools — list the server-native meta-tools (handled directly by the
// router, not in the generated Rust catalog), so clients can discover them.
fn _meta_tools() {
    return map{
        format: "pb_mcp.meta_tools.v1",
        tools: [
            map{ name: "tool_status", desc: "runtime status + catalog completion" },
            map{ name: "tool_catalog", desc: "full tool catalog" },
            map{ name: "tool_search", desc: "search the catalog (args.query)" },
            map{ name: "implemented_catalog", desc: "tools with native pblang handlers" },
            map{ name: "server_selftest", desc: "run a pure-tool health battery" },
            map{ name: "server_meta_tools", desc: "this list" },
            map{ name: "native_tool_groups", desc: "extra native tool groups (watcher, security) not in the Rust catalog" }
        ]
    };
}

// native_tool_groups — the extra native tool groups that dispatch through the
// router but aren't in the generated Rust catalog (so implemented_catalog won't
// list them). Lets clients discover the watcher + security tools.
fn _native_tool_groups() {
    return map{
        format: "pb_mcp.native_tool_groups.v1",
        groups: [
            map{ name: "watcher", tools: watchertools.tool_list() },
            map{ name: "security", tools: security.tool_list() },
            map{ name: "finance", tools: finance.tool_list() },
            map{ name: "probability", tools: probability.tool_list() },
            map{ name: "inferential", tools: inferential.tool_list() },
            map{ name: "timeseries", tools: timeseries.tool_list() },
            map{ name: "indicators", tools: indicators.tool_list() }
        ]
    };
}

// server_selftest — run a curated battery of pure, deterministic native tool
// calls across several categories and report pass/fail. Lets an operator/agent
// confirm the server's local handlers are wired and working without any network,
// filesystem, or privileged action. Tool name: "server_selftest".
fn _selftest() {
    // Pure, deterministic, side-effect-free calls spanning many categories — no
    // filesystem writes, network, or agent-bus mutation — so an operator can
    // confirm the local handlers are wired and healthy at any time, cheaply.
    let cases = [
        // meta / catalog
        map{ tool: "tool_status", args: map{} },
        map{ tool: "tool_catalog", args: map{} },
        // text
        map{ tool: "text_stats", args: map{ text: "hello world hello" } },
        map{ tool: "text_levenshtein_distance", args: map{ a: "kitten", b: "sitting", max_len: 20 } },
        map{ tool: "summarize_bullets", args: map{ text: "a. b. c." } },
        map{ tool: "summarize_top_terms", args: map{ text: "alpha beta alpha gamma beta alpha", top_n: 2 } },
        // algorithms
        map{ tool: "algo_sort", args: map{ items: [5, 1, 4, 2, 3] } },
        map{ tool: "algo_gcd_lcm", args: map{ a: 12, b: 18 } },
        map{ tool: "algo_search", args: map{ items: [1, 2, 3, 4], target: 3, method: "binary" } },
        map{ tool: "algo_graph_bfs", args: map{ graph: map{ A: ["B", "C"], B: ["D"], C: [], D: [] }, start: "A" } },
        map{ tool: "algo_stats_describe", args: map{ values: [1, 2, 3, 4, 5] } },
        map{ tool: "algo_matrix_ops", args: map{ operation: "determinant", a: [[1, 2], [3, 4]] } },
        // convert / data
        map{ tool: "convert_format", args: map{ operation: "base64_encode", text: "hello" } },
        map{ tool: "data_json_flatten", args: map{ text: "{\"a\":{\"b\":2},\"c\":[3]}" } },
        map{ tool: "db_json_query", args: map{ text: "{\"a\":{\"b\":2}}", query: "$.a.b" } },
        // planning / mcp / app / workflow
        map{ tool: "plan_work_buckets", args: map{ items: ["a", "b", "c"], buckets: 2 } },
        map{ tool: "mcp_prompt_template_validate", args: map{ template: "Hello {name}", variables: ["name"] } },
        map{ tool: "app_slash_command_expand", args: map{ command: "/review security" } },
        map{ tool: "workflow_template_generate", args: map{ kind: "coding-ci" } },
        // watchers (pure: analytics over supplied values + probe registry, no sampling)
        map{ tool: "watch_analyze", args: map{ values: [1, 2, 3, 4, 5] } },
        map{ tool: "watch_probes", args: map{} },
    ];
    let results = [];
    let passed = 0;
    let i = 0;
    while i < len(cases) {
        let c = cases[i];
        let r = call(c.tool, c.args);
        let okf = try r.ok catch false;
        if okf { passed = passed + 1; }
        push(results, map{ tool: c.tool, ok: okf, error: try r.error catch nil });
        i = i + 1;
    }
    return map{
        format: "pb_mcp.selftest.v1",
        total: len(cases),
        passed: passed,
        failed: len(cases) - passed,
        healthy: passed == len(cases),
        cases: results
    };
}

export call, ok, err;
