// Native pblang exact-decimal finance tools for pb-mcp-server.
//
// Exposes stdlib:decimal_round.sapp + the VM's exact `decimal` type as MCP tools
// for banking/trading precision: 0.1 + 0.2 is EXACTLY 0.3, 1.005 * 100 is exactly
// 100.5, banker's rounding, and penny-perfect allocation. All values cross the
// wire as STRINGS (decimals don't JSON-serialize), so precision is never lost to
// an intermediate float.

let dr = import("stdlib:decimal_round.sapp");

let FIN_TOOLS = ["fin_add", "fin_sub", "fin_mul", "fin_round", "fin_allocate",
                 "fin_sum", "fin_cmp", "fin_format", "fin_pct", "fin_pct_change",
                 "fin_compound", "fin_div"];

fn tool_list() { return FIN_TOOLS; }
fn implemented_tools() { return FIN_TOOLS; }

fn _dec(x) { return decimal(str(x)); }

// group an integer-digit string into thousands: "1234567" -> "1,234,567"
fn _group(s) {
    let out = "";
    let n = len(s);
    let i = 0;
    while i < n {
        if i > 0 and ((n - i) % 3) == 0 { out = out + ","; }
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

fn call_finance(tool, args) {
    if args == nil { args = map{}; }

    if tool == "fin_add" {
        return map{ result: str(_dec(try args.a catch "0") + _dec(try args.b catch "0")) };
    }
    if tool == "fin_sub" {
        return map{ result: str(_dec(try args.a catch "0") - _dec(try args.b catch "0")) };
    }
    if tool == "fin_mul" {
        return map{ result: str(_dec(try args.a catch "0") * _dec(try args.b catch "0")) };
    }
    // fin_round: round a decimal string to `places` under a mode
    // (half_even [default] / half_up / half_down / floor / ceil / truncate).
    if tool == "fin_round" {
        let v = _dec(try args.value catch "0");
        let places = try args.places catch 2;
        let mode = try args.mode catch "half_even";
        return map{ result: str(dr.round_mode(v, places, mode)), mode: mode, places: places };
    }
    // fin_allocate: split `total` across `weights` so the parts sum EXACTLY to it.
    if tool == "fin_allocate" {
        let total = _dec(try args.total catch "0");
        let weights = try args.weights catch [];
        let places = try args.places catch 2;
        let parts = dr.allocate(total, weights, places);
        let out = [];
        let sum = decimal("0");
        let i = 0;
        while i < len(parts) { push(out, str(parts[i])); sum = sum + parts[i]; i = i + 1; }
        return map{ parts: out, sum: str(sum), count: len(out) };
    }
    // fin_sum: exact total of a list of decimal strings (no float drift).
    if tool == "fin_sum" {
        let values = try args.values catch [];
        let acc = decimal("0");
        let i = 0;
        while i < len(values) { acc = acc + _dec(values[i]); i = i + 1; }
        return map{ result: str(acc), count: len(values) };
    }
    // fin_cmp: exact decimal comparison -> -1 (a<b) / 0 (a==b) / 1 (a>b).
    if tool == "fin_cmp" {
        let a = _dec(try args.a catch "0");
        let b = _dec(try args.b catch "0");
        let c = 0;
        if a > b { c = 1; } else { if a < b { c = 0 - 1; } }
        return map{ cmp: c };
    }
    // fin_format: banker's-rounded currency string with thousands grouping.
    if tool == "fin_format" {
        let decimals = try args.decimals catch 2;
        let currency = try args.currency catch "";
        let q = dr.round_mode(_dec(try args.value catch "0"), decimals, "half_even");
        let s = str(q);
        let neg = false;
        if len(s) > 0 and s[0] == "-" { neg = true; s = slice(s, 1, len(s)); }
        let parts = str_split(s, ".");
        let ip = parts[0];
        let fp = "";
        if len(parts) > 1 { fp = parts[1]; }
        while len(fp) < decimals { fp = fp + "0"; }
        let res = _group(ip);
        if decimals > 0 { res = res + "." + fp; }
        if neg { res = "-" + res; }
        if currency != "" { res = res + " " + currency; }
        return map{ result: res };
    }
    // fin_pct: `rate` percent of `amount` (exact), banker's-rounded to places.
    if tool == "fin_pct" {
        let amount = _dec(try args.amount catch "0");
        let rate = _dec(try args.rate catch "0");
        let places = try args.places catch 2;
        return map{ result: str(dr.round_mode(amount * rate / decimal("100"), places, "half_even")) };
    }
    // fin_pct_change: percentage change from `old` to `new` = (new-old)/old*100.
    if tool == "fin_pct_change" {
        let o = _dec(try args.old catch "0");
        let nw = _dec(try args.new catch "0");
        let places = try args.places catch 2;
        if o == decimal("0") { return map{ ok: false, error: "fin_pct_change: old value is zero" }; }
        return map{ result: str(dr.round_mode((nw - o) / o * decimal("100"), places, "half_even")) };
    }
    // fin_compound: principal * (1 + rate/100)^periods (exact decimal growth).
    if tool == "fin_compound" {
        let p = _dec(try args.principal catch "0");
        let rate = _dec(try args.rate catch "0");
        let periods = try args.periods catch 1;
        let places = try args.places catch 2;
        let factor = decimal("1") + rate / decimal("100");
        let amount = p;
        let i = 0;
        while i < periods { amount = amount * factor; i = i + 1; }
        return map{ result: str(dr.round_mode(amount, places, "half_even")) };
    }
    // fin_div: exact decimal division; optional `places` rounds (banker's by
    // default), else returns the exact quotient. Guards divide-by-zero.
    if tool == "fin_div" {
        let a = _dec(try args.a catch "0");
        let b = _dec(try args.b catch "0");
        if b == decimal("0") { return map{ ok: false, error: "fin_div: division by zero" }; }
        let q = a / b;
        let places = try args.places catch nil;
        if places != nil { q = dr.round_mode(q, places, try args.mode catch "half_even"); }
        return map{ result: str(q) };
    }
    return nil;
}

export call_finance, tool_list, implemented_tools, FIN_TOOLS;
