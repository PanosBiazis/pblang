// Native pblang translations for history/audit replay tools.

let FS = import("stdlib:fs.sapp");
let JSON = import("stdlib:json.sapp");
let sec = import("src/security.sapp");
let git = import("src/git_tools.sapp");

fn _jsonl(path) {
    sec.require_trusted("history JSONL read");
    let raw = try FS.read(sec.safe_rel_path(path, "")) catch "";
    let lines = str_split(raw, "\n");
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if t != "" {
            let v = try JSON.parse(t) catch nil;
            if v != nil { out[len(out)] = v; }
        }
    }
    return out;
}

fn _contains_json(v, needle) {
    return str_contains(str_lower(JSON.stringify(v)), str_lower(str(needle)));
}

fn history_bus_replay(args) {
    let path = try args.path catch ".mint-mcp/agent-bus.jsonl";
    let rows = _jsonl(path);
    let out = [];
    let limit = sec.clamp(try args.limit catch 200, 1, 5000);
    let agent = try args.agent_id catch try args.agent catch nil;
    let since = try args.since_ts_ms catch nil;
    for i len(rows) {
        if len(out) >= limit { return out; }
        let ok = true;
        if agent != nil and str(try rows[i].from_agent catch "") != str(agent) and str(try rows[i].to_agent catch "") != str(agent) { ok = false; }
        if since != nil and (try rows[i].ts_ms catch 0) < since { ok = false; }
        if ok == true { out[len(out)] = rows[i]; }
    }
    return out;
}

fn history_tool_calls(args) {
    let path = try args.path catch ".mint-mcp/audit/audit-log.jsonl";
    let rows = _jsonl(path);
    let out = [];
    let limit = sec.clamp(try args.limit catch 100, 1, 5000);
    let agent = try args.agent_id catch nil;
    for i len(rows) {
        if len(out) >= limit { return out; }
        if agent == nil or str(try rows[i].agent_id catch try rows[i].agent catch "") == str(agent) {
            out[len(out)] = map{
                timestamp: try rows[i].timestamp catch try rows[i].ts_ms catch nil,
                agent: try rows[i].agent_id catch try rows[i].agent catch "",
                tool: try rows[i].tool catch try rows[i].tool_name catch "",
                status: try rows[i].status catch try rows[i].ok catch "",
                raw: rows[i],
            };
        }
    }
    return out;
}

fn history_search_past_calls(args) {
    let path = try args.path catch ".mint-mcp/audit/audit-log.jsonl";
    let rows = _jsonl(path);
    let needle = try args.needle catch try args.query catch "";
    let out = [];
    let limit = sec.clamp(try args.limit catch 100, 1, 5000);
    for i len(rows) {
        if len(out) >= limit { return out; }
        if _contains_json(rows[i], needle) { out[len(out)] = rows[i]; }
    }
    return out;
}

fn history_diff_timeline(args) {
    let path = try args.path catch "";
    let n = sec.clamp(try args.limit catch try args.max_count catch 10, 1, 100);
    let res = git.git_log(map{ path: path, max_count: n, max_chars: 80000 });
    if res.ok != true { return res; }
    let lines = str_split(res.stdout, "\n");
    let out = [];
    for i len(lines) {
        let t = str_trim(lines[i]);
        if t != "" { out[len(out)] = map{ index: i, summary: t }; }
    }
    return out;
}

fn call_history(tool, args) {
    if args == nil { args = map{}; }
    if tool == "history_bus_replay" { return history_bus_replay(args); }
    if tool == "history_tool_calls" { return history_tool_calls(args); }
    if tool == "history_search_past_calls" { return history_search_past_calls(args); }
    if tool == "history_diff_timeline" { return history_diff_timeline(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "history_bus_replay",
        "history_tool_calls",
        "history_search_past_calls",
        "history_diff_timeline",
    ];
}

export implemented_tools, call_history,
       history_bus_replay, history_tool_calls, history_search_past_calls,
       history_diff_timeline;
