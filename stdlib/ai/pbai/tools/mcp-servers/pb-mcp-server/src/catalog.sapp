let netiot = import("src/net_iot_tools.sapp");
let retools = import("src/re_tools.sapp");
let sandboxtools = import("src/sandbox_tools.sapp");
let completion = import("src/completion_tools.sapp");
let sec = import("src/security.sapp");

fn _contains(arr, value) {
    for i len(arr) {
        if arr[i] == value { return true; }
    }
    return false;
}

fn _dedupe(arr) {
    let out = [];
    for i len(arr) {
        if not _contains(out, arr[i]) { out[len(out)] = arr[i]; }
    }
    return out;
}

fn _entry_with_status(e, impls) {
    let native = _contains(impls, e.name);
    e.native_pblang = native;
    if native {
        e.port_status = "implemented";
    } else {
        e.port_status = "catalog-only";
    }
    return e;
}

fn tool_catalog() {
    let raw = gen.generated_tool_catalog();
    let impls = implemented_tool_names();
    let out = [];
    for i len(raw) {
        out[len(out)] = _entry_with_status(raw[i], impls);
    }
    return out;
}

fn implemented_catalog() {
    let all = tool_catalog();
    let out = [];
    for i len(all) {
        if all[i].native_pblang == true { out[len(out)] = all[i]; }
    }
    return _dedupe(out);
}

fn find_tool(name) {
    let all = tool_catalog();
    for i len(all) {
        if all[i].name == name { return all[i]; }
    }
    return nil;
}

fn search_tools(query) {
    let q = str_lower(str(query));
    let all = tool_catalog();
    let out = [];
    for i len(all) {
        let e = all[i];
        let hay = str_lower(e.name + " " + e.category + " " + e.profile + " " + e.description);
        if q == "" or str_contains(hay, q) { out[len(out)] = e; }
    }
    return out;
}

fn category_counts() {
    let all = tool_catalog();
    let counts = map{};
    for i len(all) {
        let c = all[i].category;
        let n = try counts[c] catch 0;
        counts[c] = n + 1;
    }
    return counts;
}

fn native_catalog_tool_count() {
    return len(implemented_catalog());
}

fn status() {
    let total = gen.generated_tool_count();
    let impls = implemented_tool_names();
    let native_catalog = native_catalog_tool_count();
    return map{
        name: "pb-mcp-server-pblang",
        runtime: "pblang",
        source_project: "tools/rust/pb-mcp-server",
        generated_tool_count: total,
        native_catalog_tool_count: native_catalog,
        catalog_completion_percent: if total == 0 { 0 } else { native_catalog * 100 / total },
        native_pblang_handler_count: len(impls),
        native_pblang_handlers: impls,
        category_counts: category_counts(),
        network_profile: sec.network_profile(),
        public_profile: sec.is_public_profile(),
        boundary: "This folder is a pblang port with 100% generated Rust catalog coverage. Some handlers are full local pblang implementations; external-binary, network, hardware, privileged, and provider-backed actions return validated gated plans until matching pblang runtime primitives are available.",
    };
}

