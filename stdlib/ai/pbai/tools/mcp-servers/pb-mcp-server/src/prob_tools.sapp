// Probability tools for pb-mcp-server — exposes stdlib:prob.sapp over MCP.
//
// Distributions (pmf/pdf + cdf), combinatorics counts, and Shannon entropy for
// stats / risk / Monte-Carlo work. All inputs and outputs are plain numbers, so
// everything JSON-serializes cleanly across the wire (unlike the decimal finance
// tools, which must ship as strings).

let prob = import("stdlib:prob.sapp");

let PROB_TOOLS = ["prob_normal", "prob_binomial", "prob_poisson",
                  "prob_uniform", "prob_exponential",
                  "prob_combinations", "prob_permutations", "prob_entropy",
                  "prob_normal_quantile", "prob_value_at_risk"];

fn tool_list() { return PROB_TOOLS; }
fn implemented_tools() { return PROB_TOOLS; }

fn call_probability(tool, args) {
    if args == nil { args = map{}; }

    // prob_normal: Gaussian pdf + cdf at x for N(mu, sigma).
    if tool == "prob_normal" {
        let x = try args.x catch 0;
        let mu = try args.mu catch 0;
        let sigma = try args.sigma catch 1;
        if sigma <= 0 { return map{ ok: false, error: "prob_normal: sigma must be > 0" }; }
        return map{ pdf: prob.normal_pdf(x, mu, sigma), cdf: prob.normal_cdf(x, mu, sigma),
                    mu: mu, sigma: sigma };
    }
    // prob_binomial: P(X=k) and P(X<=k) for Binomial(n, p).
    if tool == "prob_binomial" {
        let k = try args.k catch 0;
        let n = try args.n catch 0;
        let p = try args.p catch 0.5;
        if p < 0 or p > 1 { return map{ ok: false, error: "prob_binomial: p must be in [0,1]" }; }
        return map{ pmf: prob.binomial_pmf(k, n, p), cdf: prob.binomial_cdf(k, n, p) };
    }
    // prob_poisson: P(X=k) and P(X<=k) for Poisson(lambda).
    if tool == "prob_poisson" {
        let k = try args.k catch 0;
        let lambda = try args.lambda catch 1;
        if lambda < 0 { return map{ ok: false, error: "prob_poisson: lambda must be >= 0" }; }
        return map{ pmf: prob.poisson_pmf(k, lambda), cdf: prob.poisson_cdf(k, lambda) };
    }
    // prob_uniform: continuous Uniform(a, b) pdf + cdf at x.
    if tool == "prob_uniform" {
        let x = try args.x catch 0;
        let a = try args.a catch 0;
        let b = try args.b catch 1;
        if b <= a { return map{ ok: false, error: "prob_uniform: need a < b" }; }
        return map{ pdf: prob.uniform_pdf(x, a, b), cdf: prob.uniform_cdf(x, a, b) };
    }
    // prob_exponential: Exponential(rate) pdf + cdf at x.
    if tool == "prob_exponential" {
        let x = try args.x catch 0;
        let rate = try args.rate catch 1;
        if rate <= 0 { return map{ ok: false, error: "prob_exponential: rate must be > 0" }; }
        return map{ pdf: prob.exp_pdf(x, rate), cdf: prob.exp_cdf(x, rate) };
    }
    // prob_combinations: n choose k.
    if tool == "prob_combinations" {
        let n = try args.n catch 0;
        let k = try args.k catch 0;
        return map{ result: prob.comb(n, k) };
    }
    // prob_permutations: ordered arrangements P(n, k) = n!/(n-k)!.
    if tool == "prob_permutations" {
        let n = try args.n catch 0;
        let k = try args.k catch 0;
        return map{ result: prob.perm(n, k) };
    }
    // prob_entropy: Shannon entropy (bits) of a probability vector.
    if tool == "prob_entropy" {
        let probs = try args.probs catch [];
        return map{ bits: prob.entropy(probs), count: len(probs) };
    }
    // prob_normal_quantile: inverse normal CDF (percent-point function).
    if tool == "prob_normal_quantile" {
        let p = try args.p catch 0.5;
        if p <= 0 or p >= 1 { return map{ ok: false, error: "prob_normal_quantile: p must be in (0,1)" }; }
        let mu = try args.mu catch 0;
        let sigma = try args.sigma catch 1;
        if sigma <= 0 { return map{ ok: false, error: "prob_normal_quantile: sigma must be > 0" }; }
        return map{ result: prob.normal_ppf(p, mu, sigma), p: p, mu: mu, sigma: sigma };
    }
    // prob_value_at_risk: parametric VaR + Expected Shortfall (CVaR) for normal
    // returns R ~ N(mu, sigma) at the given confidence level.
    if tool == "prob_value_at_risk" {
        let mu = try args.mu catch 0;
        let sigma = try args.sigma catch 1;
        let confidence = try args.confidence catch 0.95;
        if sigma <= 0 { return map{ ok: false, error: "prob_value_at_risk: sigma must be > 0" }; }
        if confidence <= 0 or confidence >= 1 { return map{ ok: false, error: "prob_value_at_risk: confidence must be in (0,1)" }; }
        return map{ var: prob.value_at_risk(mu, sigma, confidence),
                    cvar: prob.conditional_value_at_risk(mu, sigma, confidence),
                    confidence: confidence };
    }
    return nil;
}

export call_probability, tool_list, implemented_tools, PROB_TOOLS;
