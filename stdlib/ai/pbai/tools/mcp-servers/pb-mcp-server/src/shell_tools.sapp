// Native pblang translations for shell command intelligence.
//
// These tools never execute commands. They classify, translate, and template.

fn _lower(v) { return str_lower(str(v)); }

fn _contains(hay, needle) { return str_contains(_lower(hay), _lower(needle)); }

fn _catalog() {
    return [
        map{ intent: "list files", bash: "ls -la", powershell: "Get-ChildItem -Force", batch: "dir /a", macos: "ls -la" },
        map{ intent: "show current directory", bash: "pwd", powershell: "Get-Location", batch: "cd", macos: "pwd" },
        map{ intent: "copy file", bash: "cp SOURCE DEST", powershell: "Copy-Item SOURCE DEST", batch: "copy SOURCE DEST", macos: "cp SOURCE DEST" },
        map{ intent: "move file", bash: "mv SOURCE DEST", powershell: "Move-Item SOURCE DEST", batch: "move SOURCE DEST", macos: "mv SOURCE DEST" },
        map{ intent: "remove file", bash: "rm FILE", powershell: "Remove-Item FILE", batch: "del FILE", macos: "rm FILE" },
        map{ intent: "make directory", bash: "mkdir -p DIR", powershell: "New-Item -ItemType Directory DIR", batch: "mkdir DIR", macos: "mkdir -p DIR" },
        map{ intent: "find text", bash: "rg PATTERN PATH", powershell: "Select-String -Path PATH -Pattern PATTERN", batch: "findstr /s PATTERN PATH", macos: "rg PATTERN PATH" },
        map{ intent: "process list", bash: "ps aux", powershell: "Get-Process", batch: "tasklist", macos: "ps aux" },
        map{ intent: "network interfaces", bash: "ip addr", powershell: "Get-NetIPConfiguration", batch: "ipconfig /all", macos: "ifconfig" },
        map{ intent: "disk usage", bash: "df -h", powershell: "Get-PSDrive", batch: "wmic logicaldisk get size,freespace,caption", macos: "df -h" },
    ];
}

fn shell_command_catalog(args) {
    if args == nil { args = map{}; }
    let q = _lower(try args.query catch "");
    let rows = _catalog();
    if q == "" { return map{ executes: false, commands: rows }; }
    let out = [];
    for i len(rows) {
        let r = rows[i];
        let hay = r.intent + " " + r.bash + " " + r.powershell + " " + r.batch + " " + r.macos;
        if _contains(hay, q) { out[len(out)] = r; }
    }
    return map{ executes: false, query: q, commands: out };
}

fn shell_command_safety_check(args) {
    if args == nil { args = map{}; }
    let cmd = str(try args.command catch "");
    let c = _lower(cmd);
    let issues = [];
    let risk = "low";
    if str_contains(cmd, ";") or str_contains(cmd, "&&") or str_contains(cmd, "|") {
        issues[len(issues)] = "compound shell operator";
    }
    if _contains(c, "rm -rf") or _contains(c, "format ") or _contains(c, "del /s") or _contains(c, "remove-item") {
        issues[len(issues)] = "destructive delete/format pattern";
    }
    if _contains(c, "curl ") or _contains(c, "wget ") or _contains(c, "invoke-webrequest") {
        issues[len(issues)] = "network download/request pattern";
    }
    if _contains(c, "sudo ") or _contains(c, "runas") or _contains(c, "start-process -verb runas") {
        issues[len(issues)] = "privilege escalation pattern";
    }
    if _contains(c, ">") or _contains(c, ">>") {
        issues[len(issues)] = "redirection writes output to a file";
    }
    if len(issues) > 2 { risk = "high"; }
    else if len(issues) > 0 { risk = "medium"; }
    return map{ command: cmd, risk: risk, issues: issues, executes: false };
}

fn shell_command_translate(args) {
    if args == nil { args = map{}; }
    let intent = _lower(try args.intent catch try args.query catch "");
    let target = _lower(try args.target catch try args.shell catch "bash");
    let rows = _catalog();
    for i len(rows) {
        let r = rows[i];
        if intent == "" or _contains(r.intent, intent) or _contains(intent, r.intent) {
            if target == "powershell" or target == "pwsh" { return map{ intent: r.intent, shell: "powershell", command: r.powershell, executes: false }; }
            if target == "batch" or target == "cmd" or target == "windows" { return map{ intent: r.intent, shell: "batch", command: r.batch, executes: false }; }
            if target == "macos" or target == "zsh" { return map{ intent: r.intent, shell: "macos", command: r.macos, executes: false }; }
            return map{ intent: r.intent, shell: "bash", command: r.bash, executes: false };
        }
    }
    return map{ ok: false, error: "unknown command intent", executes: false };
}

fn shell_script_template_generate(args) {
    if args == nil { args = map{}; }
    let shell = _lower(try args.shell catch "bash");
    let purpose = str(try args.purpose catch "safe starter script");
    if shell == "powershell" or shell == "pwsh" {
        return map{ shell: "powershell", text: "$ErrorActionPreference = \"Stop\"\nSet-StrictMode -Version Latest\n# " + purpose + "\n" };
    }
    if shell == "batch" or shell == "cmd" {
        return map{ shell: "batch", text: "@echo off\r\nsetlocal enabledelayedexpansion\r\nREM " + purpose + "\r\n" };
    }
    return map{ shell: "bash", text: "#!/usr/bin/env bash\nset -euo pipefail\n# " + purpose + "\n" };
}

fn call_shell(tool, args) {
    if tool == "shell_command_catalog" { return shell_command_catalog(args); }
    if tool == "shell_command_safety_check" { return shell_command_safety_check(args); }
    if tool == "shell_command_translate" { return shell_command_translate(args); }
    if tool == "shell_script_template_generate" { return shell_script_template_generate(args); }
    return nil;
}

fn implemented_tools() {
    return [
        "shell_command_catalog",
        "shell_command_safety_check",
        "shell_command_translate",
        "shell_script_template_generate",
    ];
}

export implemented_tools, call_shell,
       shell_command_catalog, shell_command_safety_check,
       shell_command_translate, shell_script_template_generate;
