// Runtime/performance status tools for the pblang pb-mcp-server port.

let jit = import("stdlib:jit.sapp");

fn pblang_runtime_status() {
    return map{
        runtime: "pblang",
        machine_code_path: jit.runtime_mode(),
        jit_available_flag: jit.is_available(),
        recommended_run: "PBLANG_JIT=1 pblang run main.sapp --allow-all -- serve 8090",
        register_memory_boundary: "Do not add raw register/memory primitives to this server layer. Put low-level work in pl-dev/pblang VM/JIT after a benchmark proves it is the bottleneck.",
    };
}

fn pblang_machine_code_plan() {
    return map{
        goal: "make pblang run hot numeric kernels as machine code safely",
        current: "transparent Cranelift VM JIT exists for eligible numeric bytecode functions when PBLANG_JIT=1",
        next_steps: [
            "add benchmark cases for MCP text/catalog and pbAI tensor kernels",
            "measure interpreter vs PBLANG_JIT=1 before changing VM internals",
            "expose read-only JIT cache stats from the VM if profiling needs it",
            "keep raw register/memory APIs out of application code unless wrapped by safe stdlib modules",
        ],
        not_needed_for_current_port: "current translated MCP handlers are string/JSON/filesystem dominated, not numeric register-bound loops",
    };
}

fn call_runtime(tool, args) {
    if tool == "pblang_runtime_status" { return pblang_runtime_status(); }
    if tool == "pblang_machine_code_plan" { return pblang_machine_code_plan(); }
    return nil;
}

fn implemented_tools() {
    return ["pblang_runtime_status", "pblang_machine_code_plan"];
}

export implemented_tools, call_runtime, pblang_runtime_status, pblang_machine_code_plan;
