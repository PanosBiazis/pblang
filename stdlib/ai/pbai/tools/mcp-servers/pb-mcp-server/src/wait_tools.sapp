// Native pblang translations for bounded wait helpers.

let FS = import("stdlib:fs.sapp");
let sec = import("src/security.sapp");

fn _now_ms() { return try now_ms() catch num_floor(clock() * 1000.0); }

fn _cap_ms(ms) {
    let hi = if sec.is_public_profile() { 5000 } else { 30000 };
    return sec.clamp(ms, 0, hi);
}

fn _sleep(ms) {
    let n = _cap_ms(ms);
    if n > 0 { sleep_ms(n); }
    return n;
}

fn server_sleep(args) {
    if args == nil { args = map{}; }
    let requested = try args.duration_ms catch try args.ms catch 0;
    let slept = _sleep(requested);
    return map{ requested_ms: requested, slept_ms: slept, profile: sec.network_profile() };
}

fn wait_until_timestamp(args) {
    if args == nil { args = map{}; }
    let target = try args.timestamp_ms catch try args.unix_ms catch _now_ms();
    let before = _now_ms();
    let remaining = target - before;
    let slept = 0;
    if remaining > 0 { slept = _sleep(remaining); }
    return map{ target_ms: target, before_ms: before, slept_ms: slept, remaining_ms: target - _now_ms() };
}

fn wait_for_path(args) {
    if args == nil { args = map{}; }
    let path = sec.safe_rel_path(try args.path catch "", "");
    if path == "" { return map{ ok: false, error: "path is required" }; }
    let timeout = _cap_ms(try args.timeout_ms catch 1000);
    let interval = sec.clamp(try args.interval_ms catch 50, 1, 1000);
    let start = _now_ms();
    let found = FS.exists(path);
    while found != true and (_now_ms() - start) < timeout {
        _sleep(interval);
        found = FS.exists(path);
    }
    return map{ ok: found == true, path: path, exists: found, waited_ms: _now_ms() - start, profile: sec.network_profile() };
}

fn call_wait(tool, args) {
    if tool == "server_sleep" { return server_sleep(args); }
    if tool == "wait_until_timestamp" { return wait_until_timestamp(args); }
    if tool == "wait_for_path" { return wait_for_path(args); }
    return nil;
}

fn implemented_tools() {
    return ["server_sleep", "wait_until_timestamp", "wait_for_path"];
}

export implemented_tools, call_wait, server_sleep, wait_until_timestamp, wait_for_path;
