// Test: pbAI acceleration policy (stdlib/pbai_accel.sapp). Verifies the honest capability
// report (default multi-core CPU compute; opt-in GPU matmul; no NPU compute) and the
// intensity -> worker-count plan (with a fixed core count so it is deterministic across
// machines).

let accel = import("stdlib/pbai_accel.sapp");

let d = accel.detect(false);
assert(d.compute_backend == "cpu", "default compute backend is honestly reported as cpu");
assert(d.cpu_cores >= 1, "cpu core count is at least 1");
assert(d.recommended.workers >= 1, "recommended worker count is at least 1");
// Honesty contract: the note must state the default is CPU and the GPU path is opt-in.
assert(str_contains(d.backend_note, "CPU"),
    "backend note is honest that the default compute path is the CPU");
assert(str_contains(d.backend_note, "opt-in") and str_contains(d.backend_note, "GPU"),
    "backend note is honest that GPU compute is opt-in, not automatic");
// NPU: detection is real and informational; there is no NPU compute backend. detect()
// must report both honestly. (npu = enumeration text; npu_compute = honesty about offload.)
assert(d.npu != nil, "detect() reports an npu field");
assert(str_contains(str(d.npu_compute), "no pblang NPU backend"),
    "detect() is honest that there is no NPU compute backend (detection != compute)");
// probe_npu() always returns a non-empty status string on every platform (a name where an
// NPU is present, or an explanatory message otherwise). It is exec-gated and best-effort.
let npu_status = accel.probe_npu();
assert(npu_status != nil and len(str(npu_status)) > 0, "probe_npu returns a status string");
assert(not str_contains(str(npu_status), "not implemented for platform"),
    "probe_npu uses shared hwinfo fallback instead of platform stub text");
let gpu_status = accel.probe_gpu();
assert(gpu_status != nil and len(str(gpu_status)) > 0, "probe_gpu returns a status string");
assert(not str_contains(str(gpu_status), "not implemented for platform"),
    "probe_gpu uses shared hwinfo fallback instead of platform stub text");

// intensity -> workers (fixed 8-core machine for determinism)
assert(accel.plan("eco", 8).workers == 1, "eco maps to 1 worker");
assert(accel.plan("balanced", 8).workers == 4, "balanced maps to half the cores");
assert(accel.plan("max", 8).workers == 7, "max maps to all but one core");
assert(accel.plan(3, 8).workers == 3, "an explicit number maps to that many workers");
assert(accel.plan(99, 8).workers == 8, "worker count is clamped to the core count");
assert(accel.plan("max", 1).workers == 1, "a single-core machine still yields >= 1 worker");

print "pbai_accel_pass";
