// Test: pbAI native tokenizer contract (stdlib/pbai_tokenizer.sapp).
//
// Locks the first pblang-only tokenizer layer: versioned metadata, explicit special
// tokens, deterministic encode/decode, and model I/O metadata for later Nano/Mini
// decoder work.

let tokmod = import("stdlib/pbai_tokenizer.sapp");
let pbai = import("stdlib/pbai.sapp");

let tok = tokmod.train("fn main() { print 1; }\nlet x = 2;\n");

assert(tok.format == "pbai.tokenizer.char.v1", "tokenizer format is versioned");
assert(tok.kind == "codepoint-char", "tokenizer kind is explicit");
assert(tok.special.pad == 0 and tok.special.bos == 1 and tok.special.eos == 2 and tok.special.unk == 3,
    "special token ids are stable");
assert(tok.vocab_size > 10, "training builds a useful character vocabulary");

let ids = tokmod.encode(tok, "fn ", true, true);
assert(ids[0] == tok.special.bos, "encode prepends BOS when requested");
assert(ids[len(ids) - 1] == tok.special.eos, "encode appends EOS when requested");
assert(tokmod.decode(tok, ids) == "fn ", "decode skips specials by default");
assert(str_contains(tokmod.decode(tok, ids, false), "<bos>"), "decode can keep specials");

let limited = tokmod.train("abc", 5);
let unknown = tokmod.encode(limited, "az", false, false);
assert(unknown[0] != limited.special.unk and unknown[1] == limited.special.unk,
    "unknown characters route to the UNK token");

let toks = tokmod.tokenize(tok, "fn", false, false);
assert(toks[0] == "f" and toks[1] == "n", "tokenize returns token strings");

let meta = tokmod.metadata(tok);
assert(meta.format == tok.format and meta.vocab_size == tok.vocab_size,
    "metadata summarizes tokenizer format and size");
let io = tokmod.model_io(tok);
assert(io.input == "array<number> token ids" and io.vocab_size == tok.vocab_size,
    "model I/O contract is exposed");

let desc = tokmod.describe(tok);
assert(str_contains(desc, "pblang-native"), "description states the native boundary");

let status = pbai.model_status();
assert(status.tokenizer.format == "pbai.tokenizer.char.v1", "pbAI status includes tokenizer metadata");
assert(status.model_io.unk_id == 3, "pbAI status includes tokenizer model I/O ids");

let answer = pbai.respond("what pbAI tokenizer model exists?");
assert(str_contains(answer, "pbAI tokenizer") and str_contains(answer, "pblang-native"),
    "pbAI knowledge layer reports the native tokenizer");

print "pbai_tokenizer_pass";
