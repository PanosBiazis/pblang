// Test: pbAI native tokenizer CORE contract (stdlib/pbai_tokenizer.sapp).
//
// Unlike pbai_tokenizer_test.sapp, this imports ONLY the tokenizer module — no
// pbai.sapp facade, no LM/brain — so it is fast and CI-runnable under the debug VM.
// It locks edge cases of the train/encode/decode contract.

let t = import("stdlib/pbai_tokenizer.sapp");

// ── max_vocab smaller than the number of special tokens ──────────────────────────────
// The 4 specials (<pad>/<bos>/<eos>/<unk>) are mandatory and reserved. A requested
// max_vocab below that is infeasible: specials must still all be present, and the
// returned metadata must report this honestly instead of a cap it silently violates.
let tiny = t.train("abcdef", 2);
assert(tiny.special.pad == 0 and tiny.special.bos == 1 and tiny.special.eos == 2 and tiny.special.unk == 3,
    "all special tokens are present even when max_vocab is below the special count");
assert(tiny.vocab_size == 4, "tiny max_vocab keeps exactly the 4 reserved specials");
assert(tiny.requested_max_vocab == 2, "the raw requested max_vocab is preserved for honesty");
assert(tiny.max_vocab >= 4, "the effective max_vocab is floored to the special count");
assert(tiny.vocab_size <= tiny.max_vocab, "invariant: vocab_size never exceeds the effective max_vocab");

// ── A feasible max_vocab is reported verbatim (no clamping) ───────────────────────────
let capped = t.train("abc", 5);
assert(capped.max_vocab == 5 and capped.requested_max_vocab == 5,
    "a max_vocab at/above the special count is preserved unchanged");
assert(capped.vocab_size == 5 and capped.vocab_size <= capped.max_vocab,
    "the total cap (specials + learned) is honored");

// ── Unbounded vocab (max_vocab = 0) learns every distinct codepoint ───────────────────
let full = t.train("aabbc");
assert(full.max_vocab == 0 and full.requested_max_vocab == 0, "max_vocab 0 stays unbounded");
assert(full.vocab_size == 7, "4 specials + 3 distinct chars (a,b,c), duplicates folded");

// ── Empty corpus still yields a valid specials-only tokenizer ─────────────────────────
let empty = t.train("");
assert(empty.vocab_size == 4, "empty corpus -> specials only");
assert(empty.special.unk == 3, "empty corpus keeps stable special ids");

// ── encode/decode round-trips in-vocabulary text exactly ─────────────────────────────
let rt = t.train("hello world");
assert(t.decode(rt, t.encode(rt, "hello world")) == "hello world",
    "decode(encode(x)) is identity for in-vocabulary text");

// ── Unknown codepoints route to UNK, and decode is robust to garbage ids ─────────────
let unk_ids = t.encode(rt, "hz");   // 'h' is in vocab, 'z' is not
assert(unk_ids[1] == rt.special.unk, "unseen codepoints encode to the UNK id");
assert(t.decode(rt, [-1, 999999, rt.special.bos], true) == "",
    "decode skips out-of-range ids and specials without raising");

print "pbai_tokenizer_core_pass";
