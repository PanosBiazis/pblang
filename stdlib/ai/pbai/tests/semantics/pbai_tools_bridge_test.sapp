// tests/semantics/pbai_tools_bridge_test.sapp
// pbai exposes the pb_mcp tool bridge (incl. the Watchers) to external clients. The
// pbai_api/pbai_server "outside pblang" actions tool_catalog/tool_call delegate to these.
let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }

// catalog includes the watcher tools
let cat = pbai.tool_catalog();
if len(cat) < 5 { fail("tool_catalog too small"); }
let has_watch = false;
let has_read = false;
let i = 0;
while i < len(cat) {
    let nm = str(try cat[i].name catch cat[i]);
    if str_contains(nm, "watch_capture") { has_watch = true; }
    if str_contains(nm, "read_file") { has_read = true; }
    i = i + 1;
}
if not has_watch { fail("tool_catalog should include watch_capture"); }
if not has_read { fail("tool_catalog should include read_file"); }

// tool_call reaches a watcher tool
let snap = try pbai.tool_call("watch_capture", map{}) catch nil;
if snap == nil or not map_has(snap, "heap") { fail("tool_call watch_capture should return a snapshot"); }

// tool_call reaches a core file tool
let wc = try pbai.tool_call("workspace_context", map{}) catch nil;
if wc == nil or wc.native != true { fail("tool_call workspace_context"); }

print "pbai_tools_bridge_pass";
