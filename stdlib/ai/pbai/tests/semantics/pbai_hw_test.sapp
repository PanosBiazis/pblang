// Test: stdlib/pbai_hw.sapp -- full machine hardware inventory.
// Asserts structure and the honest compute-usability labels (machine-independent; the
// detectors degrade to notes off-Windows, but the survey shape is always present).

let HW = import("stdlib/pbai_hw.sapp");

let s = HW.survey();
assert(is_map(s), "survey() returns a map");
assert(map_has(s, "cpu") and map_has(s, "ram") and map_has(s, "disks"), "survey has cpu/ram/disks");
assert(map_has(s, "gpus") and map_has(s, "npu") and map_has(s, "network") and map_has(s, "sound"), "survey has gpus/npu/network/sound");
assert(map_has(s, "devices"), "survey has a device-class section");

// honest labels: CPU + GPU are compute-usable; everything else is detect-only
assert(is_array(s.compute_usable) and len(s.compute_usable) >= 2, "compute_usable lists CPU and GPU");
assert(is_array(s.detect_only) and len(s.detect_only) >= 4, "detect_only lists the non-compute devices");

// CPU is honestly reported as fully used
let c = HW.cpu();
assert(map_has(c, "used_by_pblang"), "cpu() reports how pblang uses it");
assert(str_contains(c.used_by_pblang, "all cores"), "cpu() is honest that all cores are used");

// NPU is honestly detect-only
let n = HW.npu();
assert(str_contains(str(n.used_by_pblang), "no pblang NPU compute backend"), "npu() is honest: detection only");

print "pbai_hw_pass";
