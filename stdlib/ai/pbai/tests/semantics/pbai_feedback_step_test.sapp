let T=import("stdlib:ai/pbai/stdlib/pbai_feedback_train.sapp");
let F=import("stdlib:ai/pbai/stdlib/pbai_feedback.sapp");
let checks=0;let records=[];let maximum_error=0;
fn check(ok,label) {assert(ok,label);checks=checks+1;}
fn model(ls) {return map{format:"pbai.feedback.stack.v1",layers:ls};}
fn fixtures(wide) {
 if not wide {return [model([map{n_in:1,n_out:2,w:[[0.3],[0-0.2]],b:[0.1,0.2]}]),
  model([map{n_in:2,n_out:1,w:[[0.4,0-0.5]],b:[0.15]}])];}
 return [model([map{n_in:2,n_out:2,w:[[0.2,0-0.3],[0.4,0.1]],b:[0.1,0-0.2]},
  map{n_in:2,n_out:1,w:[[0.5,0-0.4]],b:[0.05]}]),
  model([map{n_in:1,n_out:2,w:[[0.3],[0-0.6]],b:[0.2,0.1]},
  map{n_in:2,n_out:2,w:[[0.4,0.2],[0-0.3,0.5]],b:[0-0.1,0.15]}])];
}
// Separate scalar oracle: no production forward, loss, gradient or NN helper.
fn scalar_forward(m,x) {
 let k=0;let a=x;
 while k<len(m.layers) {let l=m.layers[k];let y=[];let o=0;
  while o<len(l.b) {let sum=l.b[o];let i=0;
   while i<len(a) {sum=sum+a[i]*l.w[o][i];i=i+1;}
   push(y,1/(1+num_exp(0-sum)));o=o+1;
  } a=y;k=k+1;
 } return a;
}
fn oracle(pair,batch) {
 let sum=0;let n=0;
 while n<len(batch) {let y=scalar_forward(pair[1],scalar_forward(pair[0],batch[n]));let j=0;
  while j<len(y) {let diff=y[j]-batch[n][j];sum=sum+diff*diff;j=j+1;}
  n=n+1;
 } return sum/(2*len(batch)*len(batch[0]));
}
fn flatten_layers(ls) {let out=[];let k=0;
 while k<len(ls) {let l=ls[k];let o=0;
  while o<l.n_out {let i=0;while i<l.n_in {push(out,l.w[o][i]);i=i+1;}push(out,l.b[o]);o=o+1;}
  k=k+1;
 } return out;
}
fn flat_pair(pair) {let a=flatten_layers(pair[0].layers);let b=flatten_layers(pair[1].layers);let i=0;
 while i<len(b) {push(a,b[i]);i=i+1;}return a;
}
fn altered(pair,direction,eps) {let out=[];let cursor=0;let side=0;
 while side<2 {let ls=[];let k=0;
  while k<len(pair[side].layers) {let l=pair[side].layers[k];let ws=[];let bs=[];let o=0;
   while o<l.n_out {let row=[];let i=0;
    while i<l.n_in {push(row,l.w[o][i]+eps*direction[cursor]);cursor=cursor+1;i=i+1;}
    push(ws,row);push(bs,l.b[o]+eps*direction[cursor]);cursor=cursor+1;o=o+1;
   }push(ls,map{n_in:l.n_in,n_out:l.n_out,w:ws,b:bs});k=k+1;
  }push(out,model(ls));side=side+1;
 }return out;
}
fn test_update(wide,batch,rate) {
 let pair=fixtures(wide);let before=flat_pair(pair);let saved=json_stringify(map{pair:pair,batch:batch});
 let r=T.step(pair[0],pair[1],batch,rate);let after=flat_pair([r.encoder,r.decoder]);
 check(r.format=="pbai.feedback.step.v1" and r.objective=="half_mean_squared_reconstruction","step identity");
 check(num_abs(r.loss_before-oracle(pair,batch))<0.00000000000001,"frozen before oracle");
 check(num_abs(r.loss_after-oracle([r.encoder,r.decoder],batch))<0.00000000000001,"frozen after oracle");
 let actual=F.forward(r.decoder,F.forward(r.encoder,batch[0]));
 let reference=scalar_forward(r.decoder,scalar_forward(r.encoder,batch[0]));
 let coordinate=0;while coordinate<len(actual) {check(num_abs(actual[coordinate]-reference[coordinate])<0.00000000000001,"returned stacks accepted by actual inference");coordinate=coordinate+1;}
 check(r.loss_after<r.loss_before,"declared unsaturated fixture improves");
 let eps=0.000001;let largest=0;let i=0;
 while i<len(before) {let dir=[];let j=0;while j<len(before) {push(dir,0);j=j+1;}dir[i]=1;
  let fd=(oracle(altered(pair,dir,eps),batch)-oracle(altered(pair,dir,0-eps),batch))/(2*eps);
  let expected=before[i]-rate*fd;let err=num_abs(after[i]-expected);
  if err>maximum_error {maximum_error=err;}
  check(err<0.0000000001,"every candidate parameter matches independent SGD oracle");
  push(records,map{wide:wide,batch:len(batch),rate:rate,index:i,actual:after[i],expected:expected,error:err});
  let change=num_abs(after[i]-before[i]);if change>largest {largest=change;}i=i+1;
 }
 check(r.learning_rate==rate and r.parameters==len(before) and r.parameter_sample_pairs==len(before)*len(batch),"bounded metadata");
 check(r.max_abs_update==largest and largest>0,"actual represented update accounting");
 check(json_stringify(pair[0])!=json_stringify(r.encoder),"encoder genuinely updated");
 check(json_stringify(pair[1])!=json_stringify(r.decoder),"decoder genuinely updated");
 check(json_stringify(map{pair:pair,batch:batch})==saved,"original inputs unchanged");
 let result_before=json_stringify(r);pair[0].layers[0].w[0][0]=700;batch[0][0]=0.99;
 check(json_stringify(r)==result_before,"caller changes do not affect candidate");
 r.encoder.layers[0].w[0][0]=800;check(pair[0].layers[0].w[0][0]==700,"candidate changes do not affect caller");
}
test_update(true,[[0.2,0.8]],0.1);test_update(true,[[0.2,0.8],[0.7,0.1],[0.4,0.6]],0.01);
test_update(false,[[0.3]],0.000001);test_update(false,[[0.3],[0.9],[0.1]],0.1);
fn reject(pair,batch,rate,label) {
 let before=json_stringify(map{pair:pair,batch:batch});let produced=nil;
 let failed=try {produced=T.step(pair[0],pair[1],batch,rate);false;} catch true;
 check(failed and produced==nil,label);
 check(json_stringify(map{pair:pair,batch:batch})==before,"rejected step leaves all inputs unchanged");
}
let p=fixtures(true);
reject(p,[[0.2,0.8]],0,"zero rate");reject(p,[[0.2,0.8]],0-0.1,"negative rate");
reject(p,[[0.2,0.8]],0.0000009,"rate below supported interval");reject(p,[[0.2,0.8]],0.100001,"rate above supported interval");
reject(p,[[0.2,0.8]],nil,"nil rate");reject(p,[[0.2,0.8]],true,"boolean rate");
reject(p,[[0.2,0.8]],"0.1","string rate");reject(p,[[0.2,0.8]],num_exp(1000),"infinite rate");
reject(p,[[0.2,0.8]],num_sqrt(0-1),"NaN rate");
reject(p,[],0.1,"empty batch");reject(p,[[0]],0.1,"input shape");reject(p,[[0,1.1]],0.1,"input range");
p=fixtures(true);p[1].layers[1].w[0][0]=10001;reject(p,[[0,0]],0.1,"parameter admission");
p=fixtures(true);p[1].layers[1].b=[];reject(p,[[0,0]],0.1,"late model shape");
p=fixtures(true);p[0].extra=true;reject(p,[[0,0]],0.1,"unknown model field");
// Reachable delta boundary: E(0)=0.5; D(0.5)=0.5, decoder w=320.
// dL/db_encoder = 0.125*320*0.25 = 10; rate 0.1 gives exactly 1.
let e=model([map{n_in:1,n_out:1,w:[[0]],b:[0]}]);
let d=model([map{n_in:1,n_out:1,w:[[320]],b:[0-160]}]);
let boundary=T.step(e,d,[[0]],0.1);
check(boundary.max_abs_update==1 and boundary.encoder.layers[0].b[0]==0-1,"exact update bound admitted");
let beyond=model([map{n_in:1,n_out:1,w:[[320.001]],b:[0-160.0005]}]);
reject([e,beyond],[[0]],0.1,"reachable one-over update bound");
// Reachable late failure: original encoder saturates at 1; decoder output 0.5.
// Decoder weight moves inward, but its LAST bias would become 10000.0125.
let saturated=model([map{n_in:1,n_out:1,w:[[0]],b:[10000]}]);
let last_bad=model([map{n_in:1,n_out:1,w:[[0-10000]],b:[10000]}]);
reject([saturated,last_bad],[[1]],0.1,"last candidate bias rejected atomically");
let stable=T.step(saturated,saturated,[[1]],0.1);
check(stable.loss_before==0 and stable.loss_after==0 and stable.max_abs_update==0,"finite saturated no-op truthful");
let big=[];let i=0;while i<17 {push(big,[0,0]);i=i+1;}reject(fixtures(true),big,0.1,"batch cap");
let w=[];let b=[];let row=[];i=0;while i<16 {push(row,0.01);push(b,0);i=i+1;}
i=0;while i<16 {push(w,row);i=i+1;}
let layer=map{n_in:16,n_out:16,w:w,b:b};let deep=model([layer,layer,layer,layer]);let batch=[];
i=0;while i<16 {push(batch,b);i=i+1;}reject([deep,deep],batch,0.1,"work cap before step");
let malformed=fixtures(false);let intact=json_stringify(malformed);
check((try {T.step(malformed[0],malformed[1],[[num_sqrt(0-1)]],0.1);false;} catch true),"NaN input rejected");
check((try {T.step(malformed[0],malformed[1],[[num_exp(1000)]],0.1);false;} catch true),"Inf input rejected");
check(json_stringify(malformed)==intact,"nonfinite input refusal preserves models");
malformed[0].layers[0].w[0][0]=num_sqrt(0-1);
check((try {T.step(malformed[0],malformed[1],[[0.2]],0.1);false;} catch true),"NaN parameter rejected");
let cyclic=[];push(cyclic,cyclic);let clean=fixtures(false);
check((try {T.step(clean[0],clean[1],[cyclic],0.1);false;} catch true),"cyclic batch rejected");
let repeated=fixtures(false);let r1=T.step(repeated[0],repeated[1],[[0.3]],0.1);let r2=T.step(repeated[0],repeated[1],[[0.3]],0.1);
check(json_stringify(r1)==json_stringify(r2),"same weights same deterministic candidate");
print json_stringify(map{status:"pbai_feedback_step_pass",checks:checks,maximum_candidate_error:maximum_error,updates:records});
