let Streaming = import("stdlib/pbai_streaming.sapp");
let Store = import("stdlib:llm_tiered_store.sapp");

fn require(value, message) { if value != true { throw "FAIL pbai_streaming: " + message; } }
fn digest(bytes) { return sha256(base64_encode_bytes(bytes)); }

let root = "/tmp/pbai-streaming-test-" + str_slice(sha256(str(now_ms())), 0, 16);
fs_mkdirs(root);
let dense = [1, 2, 3, 4];
let expert0 = [5, 6, 7, 8];
let expert1 = [9, 10, 11, 12];
fs_write_bytes(root + "/dense.bin", dense);
fs_write_bytes(root + "/e0.bin", expert0);
fs_write_bytes(root + "/e1.bin", expert1);
let parts = [
    Store.model_part("dense-0", "dense.bin", 4, digest(dense), "dense", 0, -1, "int4"),
    Store.model_part("expert-0-0", "e0.bin", 4, digest(expert0), "expert", 0, 0, "int4"),
    Store.model_part("expert-0-1", "e1.bin", 4, digest(expert1), "expert", 0, 1, "int4")
];
let runtime = Streaming.open(root, parts, map{
    ram_budget_bytes: 12, max_shard_bytes: 8, expected_precision: "int4",
    prefetch_capacity: 2, hot_slots: 1
});
require(runtime.ok, "pbAI opens the PBLang shard runtime");
require(Streaming.load_weight(runtime, "dense-0", true).verified, "dense weights verify");
let routed = Streaming.observe_routes(runtime, 0, [1, 1, 0], 1);
require(routed.ok and routed.predicted == ["expert-0-1"], "routing heat predicts the hot expert");
require(Streaming.run_prefetch(runtime, 1).ok, "predicted expert prefetch executes");
require(Streaming.load_weight(runtime, "expert-0-1").cache_hit, "pbAI reuses prefetched weights");
let cap = Streaming.capability();
require(cap.layer_streaming and cap.moe_expert_streaming and cap.semantics_preserved,
    "capability reports real streaming with unchanged semantics");
require(Streaming.close(runtime), "runtime closes");
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
print "pbai_streaming_pass";
