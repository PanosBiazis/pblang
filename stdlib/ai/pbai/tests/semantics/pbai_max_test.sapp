let max = import("stdlib/pbai_max.sapp");
let cache = import("stdlib/pbai_cache.sapp");

let st = max.status();
assert(st.tier == "pbAI-Max", "pbAI-Max status exposes flagship tier");
assert(st.max_owner == "AAP/ai/pbai", "pbAI-Max is owned by ai/pbai");
assert(str_contains(st.nano_owner, "pblang"), "Nano remains owned by pblang foundation");
assert(st.architecture_config.format == "pbai.max.architecture_config.v2", "Max-v2 exposes a seed architecture contract");
assert(st.architecture.layers >= 3 and st.architecture.heads >= 3, "Max-v2 starts from a larger stacked multi-head decoder seed");
assert(st.architecture.d_model >= 12 and st.architecture.d_ff >= 24, "Max-v2 widens model and FFN dimensions");
assert(st.params >= 7000, "Max-v2 increases active parameters");
assert(st.corpus.records >= 20 and st.corpus.curated_records >= 16 and st.corpus.chars > 1000, "Max status uses a larger quality-filtered curated corpus");
assert(st.corpus.curriculum_records >= 9 and str_contains(st.corpus.example_policy, "curriculum"), "Max status exposes expanded curriculum training data");
assert(st.personality.format == "pbai.max.personality.v1" and len(st.personality.traits) >= 5, "Max exposes trainable personality profile");
assert(st.live_learning.format == "pbai.max.live_learning.v1" and st.live_learning.enabled, "Max exposes live learning loop");
assert(st.cache.format == "pbai.cache.status.v1", "Max exposes persistent cache status");
assert(st.memory.format == "pbai.max.memory_status.v1" and st.memory.retrieval == "pblang-native-vector-turbovec", "Max exposes pblang-native vector memory retrieval");
assert(st.memory.manifest.format == "pblang.llm.turbovec.manifest.v1" and st.memory.records >= 16, "Max memory status exposes Turbovec manifest and records");
assert(st.adapter.format == "pbai.max.adapter_status.v1" and st.adapter.summary.format == "pblang.llm.adapter_summary.v1", "Max exposes pblang LoRA-style adapter status");
assert(st.adapter.trainable_params < st.adapter.full_head_params, "Max LoRA-style adapter trains fewer params than full LM head");
let memory_hit = max.memory_retrieve("fn add function print", 3, 48);
assert(memory_hit.format == "pbai.max.memory_retrieval.v1", "Max can retrieve memory through pblang vector search");
assert(memory_hit.search.format == "pblang.llm.turbovec.search.v1" and len(memory_hit.results) > 0, "Max memory retrieval uses Turbovec search results");
assert(memory_hit.results[0].format == "pbai.max.memory_hit.v1" and memory_hit.results[0].source != "" and memory_hit.results[0].snippet != "", "Max memory retrieval returns sourced snippets");
assert(memory_hit.cache.format == "pbai.cache.write.v1" and memory_hit.cache.ok, "Max memory retrieval writes cache metadata");
let before_live_lessons = max.live_lessons();
let remembered_lesson = max.remember_lesson("personality rule: pbAI should learn with humility, tests, and local evidence.", "semantic-test");
assert(remembered_lesson.remembered and str_contains(max.live_lessons(), "learn with humility"), "Max can append live lessons for later training");
let live_adapter = max.train_live_adapter(1, 0.02, 24, 2, 4.0);
assert(live_adapter.format == "pbai.max.live_adapter_training.v1" and live_adapter.trained, "Max can train an adapter directly from live lessons");
assert(live_adapter.base_weights_frozen and not live_adapter.touches_checkpoint, "live adapter training does not touch the base checkpoint");
assert(live_adapter.acceptance_gate.format == "pbai.max.adapter_acceptance.v1", "live adapter training reports acceptance gate");
assert(live_adapter.acceptance_gate.benchmark.format == "pbai.max.benchmark_suite.v1", "live adapter acceptance includes benchmark score");
assert(live_adapter.cache.format == "pbai.cache.write.v1" and live_adapter.cache.ok, "live adapter training writes cache metadata");
fs_write(max.live_lessons_path(), before_live_lessons);
assert(st.checkpoint_dir == "checkpoints/pbai-max", "Max status exposes checkpoint directory");
assert(st.stream.stats.emitted >= 2, "Max status exposes streaming corpus path");
assert(st.binary.tokenizer.bit_width >= 7, "Max status exposes binary token substrate");
assert(len(st.binary.sample_examples) > 0, "Max status exposes binary LM examples");
assert(st.architecture.binary_adapter, "Max architecture exposes binary adapter");
assert(st.architecture.live_mutable, "Max architecture is live-updatable");
assert(st.live_architecture.after.layers > st.live_architecture.before.layers, "Max live architecture can grow layers");
assert(st.live_architecture.after.context > st.live_architecture.before.context, "Max live architecture can extend context");
assert(st.growth_control.policy.mode == "controlled", "Max exposes controlled live growth policy");
assert(len(st.growth_control.guesses) == 4, "Max exposes guessing-loop candidates");
assert(st.ideal_neural_target.format == "pbai.max.ideal_neural_target.v1", "Max exposes ideal neural target contract");
assert(st.ideal_neural_target.implementation_status == "research-target", "ideal neural target is honest roadmap status");
assert(str_contains(str(st.ideal_neural_target.math_substrate), "complex-valued"), "ideal neural target includes complex math substrate");
assert(str_contains(str(st.ideal_neural_target.training_direction), "reduce that distance"), "ideal neural target trains current networks toward a measured target");
assert(st.ideal_neural_target.alignment_objective.format == "pbai.max.ideal_alignment_objective.v1", "ideal neural target exposes measurable objective proxy");
assert(st.ideal_neural_target.alignment_objective.distance > 0.0, "default ideal alignment objective shows remaining distance");
assert(st.ideal_neural_target.math_contract.format == "pbai.max.ideal_math_contract.v1", "ideal neural target exposes standalone ideal math contract");
assert(st.ideal_neural_target.math_contract.step_reduces_distance, "ideal math contract proves one ideal step reduces distance");
assert(not st.ideal_neural_target.math_contract.training_loop_wired, "ideal math contract remains opt-in, not silently wired into Max training");
let ideal_objective_pass = max.ideal_alignment_objective(map{
    valid_loss: 3.9,
    benchmark_pass_rate: 1.0,
    teacher_quality: 0.97,
    calibration_error: 0.04,
    geometry_distance: 0.08
});
assert(ideal_objective_pass.passed and ideal_objective_pass.alignment_score == 1.0, "ideal alignment objective passes when all proxy components reach target");
assert(st.fast_trial_reinforcement.format == "pbai.max.fast_trial_reinforcement.v1", "Max exposes a small fast trial/error reinforcement loop");
assert(st.fast_trial_reinforcement.implementation_status == "small-fast-smoke", "fast reinforcement loop is clearly labelled as a smoke loop");
assert(st.fast_trial_reinforcement.trial_count >= 3, "fast reinforcement loop compares multiple tiny candidate trials");
assert(st.fast_trial_reinforcement.best_trial.reinforcement == "reward", "fast reinforcement loop rewards the best improving trial");
assert(st.fast_trial_reinforcement.best_trial.source_format == "pblang.llm.trial_candidate.v1", "fast reinforcement candidates use pblang shared trial helper");
assert(st.fast_trial_reinforcement.best_trial.reinforcement_report.format == "pblang.llm.objective_reinforcement.v1", "fast reinforcement keeps pblang reinforcement report");
assert(st.fast_trial_reinforcement.pblang_elite_selection.format == "pblang.llm.trial_elite_selection.v1", "fast reinforcement exposes pblang elite selection report");
assert(st.fast_trial_reinforcement.rewarded >= 1 and st.fast_trial_reinforcement.punished >= 1, "fast reinforcement loop reports both reward and punish signals");
assert(not st.fast_trial_reinforcement.mutates_checkpoint, "fast reinforcement smoke does not mutate checkpoint weights");
let fast_trial = max.fast_trial_reinforcement_smoke();
assert(fast_trial.accepted and fast_trial.current_state.distance < fast_trial.previous_state.distance, "fast reinforcement smoke accepts only an objective-improving trial");
assert(str_contains(fast_trial.mode, "trial-error"), "fast reinforcement smoke documents trial/error behavior");
assert(st.rl_trial_learning.format == "pbai.max.rl_trial_learning_status.v1", "Max exposes pbAI RL trial learning status");
assert(st.rl_trial_learning.source_module == "stdlib/pbai_rl.sapp", "Max RL status is backed by the pbAI RL module");
assert(st.rl_trial_learning.trainer_format == "pbai.rl.train_toward_ideal.v1", "Max RL status records the trainer contract");
assert(st.rl_trial_learning.reward_improved and st.rl_trial_learning.final_reward >= st.rl_trial_learning.start_reward, "Max RL trial learning moves toward the ideal target");
assert(not st.rl_trial_learning.mutates_checkpoint, "Max RL status smoke does not mutate checkpoint weights");
let rl_status = max.rl_trial_learning_status();
assert(rl_status.reward_improved and len(rl_status.rewards) == rl_status.iterations + 1, "direct Max RL status call returns deterministic reward history");
assert(len(rl_status.reward_history) == len(rl_status.rewards), "direct Max RL status exposes explicit reward_history alias");
assert(st.resource_plan.mode == "parallel-two-stage-candidate-screening", "Max exposes parallel candidate resource plan");
assert(st.resource_plan.full_examples == 1280, "Max default training budget is larger");
assert(st.training_workers >= 2, "Max exposes parallel training workers");
assert(st.resource_plan.quick_parallel_workers >= 2, "Max can use multiple workers for candidate screening");
assert(st.resource_plan.quick_screen_mode == "head-only-validation-no-regression", "Max quick screening avoids expensive regression generation");
assert(st.resource_plan.finalist_mode == "full-binary-feedback-deep-regression", "Max finalists keep the full training and regression path");
assert(st.distillation.implementation_status == "bounded-student-training", "Max status labels distillation as bounded student training");
assert(st.distillation.dataset_contract == "pbai.max.distillation_dataset.v1", "Max status exposes distillation dataset contract");
assert(st.distillation.student_contract == "pbai.max.distilled_student_checkpoint.v1", "Max status exposes distilled student checkpoint contract");
assert(len(st.distillation.targets) == 3 and len(st.distillation.steps) >= 4, "Max status exposes Pro/Mini/Nano distillation plan");
assert(st.benchmark.format == "pbai.max.benchmark_status.v1", "Max status exposes benchmark suite status");
assert(st.benchmark.cases >= 12 and len(st.benchmark.categories) >= 6, "Max benchmark covers multiple categories with multiple cases");
assert(len(st.benchmark.thresholds) >= 6, "Max benchmark exposes category thresholds");

let distill = max.distillation_preview(nil, 6, 3);
assert(distill.format == "pbai.max.distillation_preview.v1", "Max exposes distillation preview contract");
assert(distill.implementation_status == "student-training-available", "Max distillation preview includes student training availability");
assert(len(distill.targets) == 3, "Max distillation targets Pro/Mini/Nano");
assert(distill.dataset.format == "pbai.max.distillation_dataset.v1", "Max distillation preview includes teacher dataset");
assert(distill.dataset.implementation_status == "curated-teacher-records", "Max distillation uses curated teacher records without checkpoint");
assert(distill.dataset.records_count >= 6, "Max distillation dataset includes prompt records");
assert(distill.dataset.records[0].format == "pbai.max.distillation_record.v1", "Max distillation records are versioned");
assert(distill.dataset.records[0].teacher == "pbAI-Max", "Max distillation records keep teacher identity");
assert(distill.dataset.records[0].teacher_text_source == "curated", "checkpoint-free distillation uses curated teacher text");
assert(distill.dataset.records[0].teacher_text_chars > 40 and distill.dataset.avg_teacher_chars > 40, "curated distillation teacher text is richer than one-token labels");
assert(distill.dataset.teacher_quality.format == "pblang.llm.teacher_dataset_quality.v1" and distill.dataset.teacher_quality.passed, "Max distillation requires pblang teacher-quality gates");
assert(distill.dataset.teacher_quality.records == distill.dataset.records_count and distill.dataset.teacher_quality.failed_records == 0, "Max teacher-quality report covers every distillation record");
let bad_teacher_quality = max.distillation_teacher_quality([
    map{
        prompt: "Explain pblang",
        expected: ["fn"],
        forbidden: ["undefined", "nan", "<unk>"],
        teacher_text_source: "raw",
        teacher_text: "undefined"
    }
], 40, 0.65);
assert(not bad_teacher_quality.passed and bad_teacher_quality.failed_records == 1, "Max teacher-quality wrapper rejects weak forbidden teacher text");
let bad_acceptance = max.distillation_acceptance_gate(1.0, 2.0, map{ passed: true }, bad_teacher_quality);
assert(not bad_acceptance.passed and not bad_acceptance.teacher_quality_passed, "Max distillation acceptance rejects failed teacher quality even when validation and benchmark pass");
let validation_bad_acceptance = max.distillation_acceptance_gate(2.1, 2.0, map{ passed: true }, distill.dataset.teacher_quality);
let benchmark_bad_acceptance = max.distillation_acceptance_gate(1.0, 2.0, map{ passed: false }, distill.dataset.teacher_quality);
assert(not validation_bad_acceptance.passed and not validation_bad_acceptance.validation_improved, "Max distillation acceptance rejects validation regression");
assert(not benchmark_bad_acceptance.passed and not benchmark_bad_acceptance.benchmark_passed, "Max distillation acceptance rejects benchmark threshold failure");
assert(str_contains(str(validation_bad_acceptance.reasons), "validation-worse"), "validation rejection records a reason");
assert(str_contains(str(benchmark_bad_acceptance.reasons), "benchmark-threshold-failed"), "benchmark rejection records a reason");
assert(str_contains(str(bad_acceptance.reasons), "teacher-quality-failed"), "teacher-quality rejection records a reason");
assert(not distill.dataset.generated_with_checkpoint, "checkpoint-free distillation preview stays deterministic and cheap");
assert(distill.acceptance_gate.format == "pbai.max.benchmark_threshold_report.v1" and distill.acceptance_gate.passed, "Max distillation preview carries benchmark threshold gate");

let student = max.train_distilled_student(nil, "pbAI-Mini", 1, 0.02, 6, 3);
assert(student.format == "pbai.max.distilled_student_checkpoint.v1", "Max can train a real distilled student checkpoint");
assert(student.tier == "pbAI-Mini" and student.teacher == "pbAI-Max", "distilled student keeps tier and teacher identity");
assert(student.implementation_status == "bounded-student-training", "distilled student is labelled as bounded training");
assert(student.records >= 6 and student.examples.train > 0 and student.examples.valid > 0, "distilled student trains on teacher records with validation split");
assert(student.target_config.context == 8 and student.target_config.layers == 2, "Mini student uses smaller target architecture");
assert(student.params > 0 and student.params < st.params, "distilled Mini has fewer params than Max seed");
assert(student.training.mode == "parallel-cached-hidden-lm-head-backprop", "distilled student uses parallel head training");
assert(student.training.parallel_workers >= 2, "distilled student uses multiple workers");
assert(student.binary_training.mode == "binary-adapter-analytic-backprop", "distilled student trains binary adapter");
assert(student.deep_training.mode == "analytic-input-embedding-binary-backprop", "distilled student runs deep input updates");
assert(student.metrics.loss_after <= student.metrics.loss_before, "distilled student lowers train loss");
assert(student.metrics.valid_loss_after <= student.metrics.valid_loss_before, "distilled student does not worsen validation loss");
assert(student.threshold_gate.passed and student.teacher_quality_gate.passed and student.acceptance_gate.passed and student.accepted_for_save, "distilled student passes save acceptance gate");
assert(student.teacher_sources.curated >= 6, "checkpoint-free distillation records curated teacher source counts");
assert(not student.touches_teacher_checkpoint, "distilled student training never mutates teacher checkpoint");
let nano_student = max.train_distilled_student(nil, "pbAI-Nano", 1, 0.02, 3, 2);
assert(nano_student.tier == "pbAI-Nano" and nano_student.target.owner == "pblang stdlib / Nano foundation", "Nano student preserves pblang ownership boundary");
assert(nano_student.target_config.layers == 1 and nano_student.target_config.context == 6, "Nano student uses smallest distillation architecture");
let family = max.distill_family(nil, 1, 0.02, 3, 2);
assert(family.format == "pbai.max.distillation_family.v1", "Max can train a distilled student family");
assert(family.student_count == 3 and family.accepted_count >= 0 and family.accepted_count <= 3, "distilled family trains Pro/Mini/Nano students and reports bounded acceptance");
let family_saved = max.save_distilled_family("target/pbai-max-test/students", family);
assert(family_saved.format == "pbai.max.distilled_family_save.v1" and family_saved.ok, "Max can save distilled family checkpoints");
assert(family_saved.index.format == "pbai.max.distilled_family_index.v1", "distilled family save writes an index contract");
assert(len(family_saved.saves) == 3 and family_saved.accepted_count == family.accepted_count, "distilled family save records all student saves and acceptance count");
assert(fs_exists("target/pbai-max-test/students/index.json"), "distilled family index is written");
assert(fs_exists("target/pbai-max-test/students/pbAI-Mini/student.json"), "distilled Mini student checkpoint is written");
let family_summary = max.distilled_family_summary_saved("target/pbai-max-test/students");
assert(family_summary.format == "pbai.max.distilled_family_index.v1", "distilled family summary loads saved index");
assert(family_summary.student_count == 3 and family_summary.accepted_count == family.accepted_count, "distilled family summary reports accepted students");
let loaded_student = max.load_distilled_student("target/pbai-max-test/students/pbAI-Mini");
let loaded_summary = max.distilled_student_summary(loaded_student);
assert(loaded_summary.format == "pbai.max.distilled_student_summary.v1", "distilled student summary contract is versioned");
assert(loaded_summary.tier == "pbAI-Mini" and (loaded_summary.accepted_for_save or not loaded_summary.accepted_for_save), "loaded distilled student keeps explicit save acceptance");
let student_eval = max.evaluate_distilled_student(loaded_student, 64);
assert(student_eval.format == "pbai.max.distilled_student_eval.v1", "loaded distilled student can be evaluated");
assert(student_eval.tier == "pbAI-Mini" and student_eval.validation.examples > 0, "distilled student eval reports validation examples");
let student_ranked = max.generate_distilled_student_ranked(loaded_student, "fn ", 3, ["fn"], ["undefined", "nan", "<unk>"], 1);
assert(student_ranked.format == "pbai.max.distilled_student_ranked_generation.v1", "loaded distilled student can generate ranked text");
assert(student_ranked.tier == "pbAI-Mini" and len(student_ranked.text) >= 2, "distilled student generation returns text");
let saved_student_eval = max.evaluate_distilled_student_saved("target/pbai-max-test/students", "pbAI-Nano", 64);
assert(saved_student_eval.tier == "pbAI-Nano" and saved_student_eval.summary.context == 6, "saved Nano student can be evaluated from family dir");
let saved_family_eval = max.evaluate_distilled_family_saved("target/pbai-max-test/students", 64);
assert(saved_family_eval.format == "pbai.max.distilled_family_eval.v1" and saved_family_eval.student_count == 3, "saved distilled family can be evaluated");
let nano_route = max.route_distilled_tier("hi", "target/pbai-max-test/students");
assert(nano_route.format == "pbai.max.distilled_route.v1" and nano_route.tier == "pbAI-Nano", "short prompts route to Nano");
let mini_route = max.route_distilled_tier("pblang memory learn", "target/pbai-max-test/students");
assert(mini_route.tier == "pbAI-Mini", "pblang memory prompts route to Mini");
let pro_route = max.route_distilled_tier("Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }", "target/pbai-max-test/students");
assert(pro_route.tier == "pbAI-Pro" and pro_route.available, "code review prompts route to Pro and confirm availability");
let routed_gen = max.generate_distilled_route_saved("Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }", 3, "target/pbai-max-test/students", ["fn"], ["undefined", "nan", "<unk>"]);
assert(routed_gen.format == "pbai.max.distilled_route_generation.v1", "routed distilled generation contract is versioned");
assert(routed_gen.route.tier == "pbAI-Pro" and routed_gen.ranked.format == "pbai.max.distilled_student_ranked_generation.v1", "routed generation uses selected Pro student");
let routed_eval = max.evaluate_distilled_route_saved("pblang memory learn", "target/pbai-max-test/students", 64);
assert(routed_eval.format == "pbai.max.distilled_route_eval.v1" and routed_eval.tier == "pbAI-Mini", "routed eval uses selected Mini student");

let broken_verify = max.strict_verify_generation("fn fn sa, ) { ///pbaixt i) { return", "fn add(a,b)", ["fn"], ["undefined", "nan", "<unk>"]);
assert(broken_verify.format == "pbai.max.verified_generation.v1", "Max strict verifier is core-owned");
assert(not broken_verify.passed, "Max strict verifier rejects malformed generation");
assert(len(broken_verify.issues) >= 2, "Max strict verifier reports concrete syntax issues");

let bench = max.benchmark_suite(nil, 8);
assert(bench.format == "pbai.max.benchmark_suite.v1", "Max exposes deterministic pblang benchmark suite");
assert(bench.cases >= 12 and bench.passed == bench.cases, "Max benchmark suite passes deterministic system checks");
assert(bench.pass_rate == 1 and bench.average_score >= 0.99, "Max benchmark suite reports strong bounded score");
assert(len(bench.category_scores) >= 6, "Max benchmark suite reports per-category scores");
assert(bench.threshold_report.format == "pbai.max.benchmark_threshold_report.v1" and bench.threshold_report.passed, "Max benchmark suite passes category thresholds");
let bench_has_coding = false;
let bench_has_math = false;
let bench_has_memory = false;
let bench_has_retrieval = false;
let bench_has_tools = false;
let bench_has_safety = false;
let bench_i = 0;
while bench_i < len(bench.category_scores) {
    let cat = bench.category_scores[bench_i].category;
    if cat == "pblang-coding" { bench_has_coding = true; }
    if cat == "math" { bench_has_math = true; }
    if cat == "memory" { bench_has_memory = true; }
    if cat == "retrieval" { bench_has_retrieval = true; }
    if cat == "tools" { bench_has_tools = true; }
    if cat == "safety" { bench_has_safety = true; }
    assert(bench.category_scores[bench_i].cases >= 2, "each benchmark category has multiple cases");
    assert(bench.category_scores[bench_i].pass_rate >= 0 and bench.category_scores[bench_i].pass_rate <= 1, "benchmark category pass rate is bounded");
    bench_i = bench_i + 1;
}
assert(bench_has_coding and bench_has_math and bench_has_memory and bench_has_retrieval and bench_has_tools and bench_has_safety, "Max benchmark covers coding/math/memory/retrieval/tools/safety");

let adapter_run = max.train_adapter(1, 0.02, 24, 2, 4.0);
assert(adapter_run.format == "pbai.max.adapter_training.v1" and adapter_run.source_format == "pblang.llm.lora_training.v1", "Max can train a pblang LoRA-style adapter");
assert(adapter_run.steps > 0 and adapter_run.adapter_summary.trainable_params < st.adapter.full_head_params, "Max adapter training updates low-rank params only");
assert(adapter_run.acceptance_gate.format == "pbai.max.adapter_acceptance.v1", "Max adapter training reports loss plus benchmark acceptance gate");
assert(adapter_run.acceptance_gate.benchmark_ok, "Max adapter benchmark gate passes deterministic checks");
assert(adapter_run.acceptance_gate.threshold.format == "pbai.max.benchmark_threshold_report.v1" and adapter_run.acceptance_gate.threshold.passed, "Max adapter acceptance uses category thresholds");
assert(adapter_run.cache.format == "pbai.cache.write.v1" and adapter_run.cache.ok, "Max adapter training writes cache metadata");
let before_teach_adapter = max.live_lessons();
let taught_adapter = max.teach_adapter("adapter lesson: prefer small verified updates before base checkpoint continuation.", 1, 0.02, 24, 2, 4.0);
assert(taught_adapter.format == "pbai.max.teach_adapter.v1" and taught_adapter.remembered.remembered, "Max can teach a live lesson into adapter training");
assert(taught_adapter.training.trained and not taught_adapter.training.touches_checkpoint, "teach_adapter trains only the adapter path");
assert(taught_adapter.training.acceptance_gate.format == "pbai.max.adapter_acceptance.v1", "teach_adapter returns adapter acceptance gate");
fs_write(max.live_lessons_path(), before_teach_adapter);

let ckpt = max.train_checkpoint(1, 0.05, 1, 1, 180);
assert(ckpt.format == "pbai.max.checkpoint.v1", "pbAI-Max checkpoint format is versioned");
assert(ckpt.tier == "pbAI-Max", "checkpoint keeps tier");
assert(ckpt.product_root == "AAP/ai/pbai", "checkpoint keeps product root");
assert(ckpt.training.mode == "parallel-cached-hidden-lm-head-backprop", "checkpoint records parallel cached-hidden LM-head training mode");
assert(ckpt.training.parallel_workers >= 2 and ckpt.training.cache_mode == "parallel-transformer-hidden-cache", "checkpoint computes transformer hiddens in parallel");
assert(ckpt.cache.format == "pbai.cache.write.v1" and ckpt.cache.ok, "checkpoint writes a training summary cache entry");
assert(ckpt.binary_training.mode == "binary-adapter-analytic-backprop", "checkpoint records binary analytic training mode");
assert(ckpt.binary_training.bit_width == ckpt.binary.tokenizer.bit_width, "binary training uses checkpoint bit width");
assert(ckpt.live_architecture.mutable, "checkpoint records live-mutable architecture support");
assert(ckpt.live_architecture.growth_policy.mode == "controlled", "checkpoint records controlled growth policy");
assert(len(ckpt.live_architecture.growth_policy.allowed_signals) >= 4, "checkpoint allows live growth signals beyond binary scale");
let grew_arch = ckpt.live_architecture.after.layers > ckpt.live_architecture.seed.layers
    or ckpt.live_architecture.after.context > ckpt.live_architecture.seed.context
    or ckpt.live_architecture.after.binary_scale != ckpt.live_architecture.seed.binary_scale;
assert(grew_arch, "checkpoint records live architecture growth during training");
assert(ckpt.adaptive_growth.mode == "train-measure-grow", "checkpoint records adaptive error-reduction loop");
assert(ckpt.feedback_loop.mode == "measure-train-feedback-grow", "checkpoint records feedback loop");
assert(ckpt.feedback_loop.traces[0].before_state.format == "pblang.llm.feedback_state.v1", "checkpoint keeps pre-feedback state");
assert(ckpt.feedback_loop.traces[0].after_state.format == "pblang.llm.feedback_state.v1", "checkpoint keeps post-feedback state");
assert(ckpt.feedback_loop.traces[0].evaluation.format == "pblang.llm.feedback_evaluation.v1", "checkpoint evaluates feedback success or failure");
assert(ckpt.feedback_loop.traces[0].evaluation.reinforcement.format == "pblang.llm.reinforcement.v1", "checkpoint feedback comparison has reward/punish");
assert(ckpt.guessing_loop.mode == "guess-policy-gated-growth", "checkpoint records guessing loop");
assert(ckpt.guessing_loop.traces[0].before_state.format == "pblang.llm.guess_state.v1", "checkpoint keeps pre-guess state");
assert(ckpt.guessing_loop.traces[0].after_state.format == "pblang.llm.guess_state.v1", "checkpoint keeps post-guess state");
assert(ckpt.guessing_loop.traces[0].evaluation.format == "pblang.llm.guess_evaluation.v1", "checkpoint evaluates guess success or failure");
assert(ckpt.guessing_loop.traces[0].evaluation.reinforcement.format == "pblang.llm.reinforcement.v1", "checkpoint guess comparison has reward/punish");
assert(ckpt.elite_selection.format == "pblang.llm.elite_selection.v1", "checkpoint records elite selection");
assert(len(ckpt.elite_selection.kept) == 1, "checkpoint keeps best candidate");
assert(len(ckpt.elite_selection.thrown) >= 0, "checkpoint can throw lower-ranked candidates");
assert(ckpt.deep_training.mode == "analytic-input-embedding-binary-backprop", "checkpoint records analytic deep input update mode");
assert(ckpt.deep_training.steps > 0, "deep transformer training runs at least one step");
assert(ckpt.eval.perplexity > 0, "checkpoint records eval metrics");
assert(ckpt.validation.eval.perplexity > 0, "checkpoint records validation metrics");
assert(ckpt.metrics.loss_after <= ckpt.metrics.loss_before, "pbAI-Max training does not worsen train loss");
assert(ckpt.params > 0, "checkpoint records parameter estimate");
assert(ckpt.params >= 9000, "trained Max-v2 checkpoint has more parameters than the previous 5040-param model");
assert(ckpt.corpus.curated_records >= 16 and ckpt.corpus.curriculum_records >= 9 and ckpt.corpus.train_examples > 100 and ckpt.corpus.valid_examples > 0, "checkpoint records quality-filtered curriculum train/validation corpus stats");
assert(ckpt.architecture_config.layers >= 3 and ckpt.architecture_config.heads >= 3, "checkpoint records Max-v2 seed architecture");
assert(ckpt.training_context == 6, "checkpoint records the current training context");
assert(ckpt.corpus.split == "pbai.max.representative_split.v1", "checkpoint uses representative validation split");
assert(ckpt.corpus.example_policy == "balanced-per-record-strong-target-plus-curriculum-interleave", "checkpoint uses balanced strong-target curriculum examples");
assert(ckpt.binary.tokenizer.bit_width >= 8, "checkpoint records binary token metadata");
assert(ckpt.binary.sample_examples[0].format == "pblang.llm.binary_lm_example.v1", "checkpoint carries binary example views");
assert(len(ckpt.model.binary_projection) == ckpt.binary.tokenizer.bit_width, "checkpoint stores binary projection weights");
assert(ckpt.benchmark.tokens == 4, "checkpoint records generation benchmark");
assert(ckpt.benchmark_gate.format == "pbai.max.benchmark_suite.v1", "checkpoint records benchmark acceptance gate");
assert(ckpt.benchmark_gate.pass_rate >= 0.85, "checkpoint benchmark gate records bounded system quality");
assert(ckpt.regression.format == "pbai.max.regression_suite.v1", "checkpoint records prompt-level regression suite");
assert(ckpt.regression.cases >= 4, "regression suite has multiple prompt cases");
assert(ckpt.regression.average_score >= 0 and ckpt.regression.average_score <= 1, "regression suite records bounded prompt-level score");
assert(ckpt.regression.pass_rate >= 0 and ckpt.regression.pass_rate <= 1, "regression suite records bounded pass rate");
assert(ckpt.regression.pass_rate >= 0.50, "safe Max generation passes at least half of prompt regressions");
assert(ckpt.regression.results[0].score.format == "pbai.max.regression_score.v1", "regression case score is versioned");
assert(ckpt.regression.results[0].score.source_format == "pblang.llm.generation_quality.v1", "Max regression delegates scoring to pblang llm_eval");
assert(ckpt.regression.generation_policy == "multi-candidate-safe-decode-retrieval-verifier-rerank-strict-repair", "Max regression uses ranked safe decoding with strict verification and repair");
assert(ckpt.regression.generation_policy_version == "verified-repair-v1", "Max regression records verifier policy version");
assert(ckpt.regression.results[0].generation.format == "pbai.max.ranked_generation.v1", "regression records ranked generation details");
assert(ckpt.regression.results[0].verified_generation.format == "pbai.max.verified_ranked_generation.v1", "regression records verified generation details");
assert(len(ckpt.regression.results[0].generation.candidates) >= 4, "regression scores neural and retrieval-grounded candidates");
assert(ckpt.regression.results[0].generation.candidates[0].sequence_eval.format == "pblang.llm.sequence_eval.v1", "regression candidate records sequence loss");
assert(ckpt.regression.results[0].generation.candidates[0].text_shape.format == "pblang.llm.text_shape.v1", "regression candidate records text shape");
assert(ckpt.regression.results[0].generation.candidates[0].verifier.format == "pbai.max.generation_verifier.v1", "regression candidate records verifier score");
let has_retrieval_candidate = false;
let rc_i = 0;
while rc_i < len(ckpt.regression.results[0].generation.candidates) {
    let rc_mode = try ckpt.regression.results[0].generation.candidates[rc_i].mode catch "";
    if rc_mode == "retrieval-grounded-candidate" { has_retrieval_candidate = true; }
    rc_i = rc_i + 1;
}
assert(has_retrieval_candidate, "regression includes a retrieval-grounded candidate");
assert(ckpt.regression.results[0].generation.choice.format == "pbai.max.generation_choice.v3", "regression choice uses quality plus sequence loss plus text shape plus verifier");

let out = max.generate(ckpt, "fn ", 4);
assert(len(out) >= 3, "pbAI-Max generation returns text");
let ranked = max.generate_ranked(ckpt, "fn ", 4, ["fn"], ["<unk>"], 2);
assert(ranked.format == "pbai.max.ranked_generation.v1", "pbAI-Max exposes ranked generation metadata");
assert(ranked.mode == "multi-candidate-safe-decode-retrieval-verifier-rerank", "ranked generation mode names retrieval and verifier reranking");
assert(ranked.shape_choice.format == "pblang.llm.generation_choice.v1", "ranked generation keeps pblang llm_eval shape scoring");
assert(ranked.choice.format == "pbai.max.generation_choice.v3" and ranked.choice.verifier_weight > 0, "ranked generation combines quality, sequence loss, text shape, and verifier");
assert(len(ranked.candidates) >= 4 and ranked.selected.format == "pbai.max.generation_candidate.v1", "ranked generation keeps neural and retrieval candidate settings");
assert(ranked.selected.sequence_eval.examples > 0 and ranked.selected.rank_score >= 0, "ranked generation scores selected sequence loss");
assert(ranked.selected.text_shape.score >= 0 and ranked.selected.text_shape.score <= 1, "ranked generation scores selected text shape");
assert(ranked.selected.verifier.format == "pbai.max.generation_verifier.v1" and ranked.selected.verifier.score >= 0, "ranked generation verifies selected output");
assert(ranked.candidates[len(ranked.candidates) - 1].retrieval.memory.format == "pbai.max.memory_retrieval.v1", "ranked generation retrieval candidate is backed by vector memory");
let verified_ranked = max.generate_verified_ranked(ckpt, "fn add(a, b)", 4, ["fn"], ["undefined", "nan", "<unk>"], 1);
assert(verified_ranked.format == "pbai.max.verified_ranked_generation.v1", "Max exposes core verified generation");
assert(verified_ranked.passed, "Max verified generation selects a passing candidate");
assert(verified_ranked.selected.kind == "original" or verified_ranked.selected.kind == "repair" or verified_ranked.selected.kind == "fallback", "verified generation identifies selected source kind");
assert(verified_ranked.selected_verifier.passed and len(verified_ranked.selected_verifier.issues) == 0, "verified generation selected text has no strict issues");
assert(str_contains(verified_ranked.text, "fn"), "verified generation selected text contains pblang function signal");

let ev = max.evaluate_checkpoint(ckpt);
assert(ev.examples > 0 and ev.perplexity > 0, "pbAI-Max checkpoint can be evaluated");
let rg = max.regression_suite(ckpt, 4);
assert(rg.format == "pbai.max.regression_suite.v1" and rg.cases == ckpt.regression.cases, "pbAI-Max checkpoint can run regression suite on demand");
assert(rg.passed + rg.failed == rg.cases and rg.average_score >= 0 and rg.average_score <= 1, "on-demand regression suite reports bounded pass/fail counts and score");
assert(rg.pass_rate >= 0.50, "on-demand regression suite catches collapse regressions and rewards safe decoding");
let distill_ckpt = max.distillation_preview(ckpt, 3, 3);
assert(distill_ckpt.dataset.generated_with_checkpoint, "checkpoint-backed distillation preview uses Max generation");
assert(distill_ckpt.dataset.records_count >= 3, "checkpoint-backed distillation preview emits teacher records");
assert(distill_ckpt.dataset.records[0].ranked_generation.format == "pbai.max.ranked_generation.v1", "checkpoint-backed distillation records keep ranked generation trace");
assert(distill_ckpt.dataset.records[0].verified_generation.format == "pbai.max.verified_ranked_generation.v1", "checkpoint-backed distillation records keep verified generation trace");
assert(distill_ckpt.dataset.records[0].teacher_text_source == "original" or distill_ckpt.dataset.records[0].teacher_text_source == "repair" or distill_ckpt.dataset.records[0].teacher_text_source == "fallback", "distillation teacher text comes from verified source");
assert(distill_ckpt.acceptance_gate.format == "pbai.max.benchmark_threshold_report.v1", "checkpoint-backed distillation preview keeps benchmark gate");

let saved = max.save_checkpoint("target/pbai-max-test", ckpt);
assert(saved.format == "pbai.max.saved_checkpoint.v1", "pbAI-Max checkpoint save contract is versioned");
let continued = max.continue_training("target/pbai-max-test", 1, 0.02, 1, 80);
assert(continued.format == "pbai.max.continue_result.v1", "pbAI-Max can continue training an existing checkpoint");
assert(continued.accepted or not continued.accepted, "continued training explicitly accepts or rejects candidate");
assert(continued.tried >= 2, "continued training tries multiple small candidates");
assert(continued.quick_tried >= 2, "continued training reports quick candidate screening");
assert(continued.full_tried >= 0, "continued training reports full finalist count");
assert(continued.resource_plan.quick_screen_mode == "head-only-validation-no-regression", "continued training reports optimized quick screening");
if continued.resource_plan.full_finalists > 0 {
    assert(continued.quick_candidates[0].screening_mode == "quick-head-validation-screen", "quick candidates are cheap validation screens");
} else {
    assert(continued.quick_candidates[0].screening_mode == "full-regression-finalist", "tiny continuation smoke runs use full candidates instead of saving quick proxies");
}
assert(continued.best_candidate.format == "pbai.max.continue_candidate.v1", "continued training reports best candidate");
assert(continued.best_candidate.selection.format == "pbai.max.selection_score.v1", "continued training reports validation-plus-regression selection score");
assert(continued.best_candidate.selection.source_format == "pblang.llm.selection_score.v1", "continued training delegates selection scoring to pblang llm_eval");
assert(continued.best_candidate.selection.mode == "validation-loss-plus-regression-plus-benchmark-quality", "continued training selection includes benchmark quality");
assert(continued.best_candidate.selection.benchmark_pass_rate >= 0 and continued.best_candidate.selection.benchmark_pass_rate <= 1, "continued training reports bounded benchmark pass rate");
assert(continued.best_candidate.selection.benchmark_threshold_passed, "continued training selection passes benchmark category thresholds");
assert(continued.best_candidate.selection.benchmark_failed_categories == 0, "continued training selection has no failed benchmark categories");
assert(continued.best_candidate.regression_pass_rate >= 0 and continued.best_candidate.regression_pass_rate <= 1, "continued training reports bounded regression pass rate");
assert(continued.acceptance_policy.format == "pbai.max.acceptance_policy.v1", "continued training reports acceptance policy");
assert(continued.acceptance_policy.mode == "validation-plus-benchmark-or-regression-plus-benchmark-with-validation-tolerance", "continued training acceptance requires benchmark gate");
assert(continued.acceptance_policy.benchmark_ok or continued.acceptance_policy.benchmark_nonregression or not continued.accepted, "continued training reports benchmark acceptance decision");
assert(continued.acceptance_policy.benchmark_threshold_passed, "continued training policy reports benchmark threshold pass");
assert(continued.before_selection.format == "pbai.max.selection_score.v1", "continued training records baseline selection score");
assert(continued.after_selection.format == "pbai.max.selection_score.v1", "continued training records best candidate selection score");
assert(continued.before_benchmark.format == "pbai.max.benchmark_suite.v1", "continued training records baseline benchmark gate");
let loaded = max.load_checkpoint("target/pbai-max-test");
assert(loaded.format == "pbai.max.checkpoint.v1", "pbAI-Max checkpoint can be loaded");
let summary = max.checkpoint_summary(loaded);
assert(summary.format == "pbai.max.checkpoint_summary.v1", "pbAI-Max has pblang-only checkpoint summary");
assert(summary.binary_training == "binary-adapter-analytic-backprop", "checkpoint summary reports binary training");
assert(summary.binary_projection.rows == summary.binary_bit_width, "checkpoint summary reports binary projection shape");
assert(summary.live_mutable, "checkpoint summary reports live architecture support");
assert(summary.adaptive_growth.mode == "train-measure-grow", "checkpoint summary reports adaptive growth loop");
assert(summary.feedback_loop.mode == "measure-train-feedback-grow", "checkpoint summary reports feedback loop");
assert(summary.feedback_loop.last_evaluation.format == "pblang.llm.feedback_evaluation.v1", "checkpoint summary reports last feedback evaluation");
assert(summary.feedback_loop.last_evaluation.reinforcement.format == "pblang.llm.reinforcement.v1", "checkpoint summary reports feedback reward/punish");
assert(summary.guessing_loop.mode == "guess-policy-gated-growth", "checkpoint summary reports guessing loop");
assert(summary.guessing_loop.last_evaluation.format == "pblang.llm.guess_evaluation.v1", "checkpoint summary reports last guess evaluation");
assert(summary.guessing_loop.last_evaluation.reinforcement.format == "pblang.llm.reinforcement.v1", "checkpoint summary reports guess reward/punish");
assert(summary.elite_selection.format == "pblang.llm.elite_selection.v1", "checkpoint summary reports elite selection");
assert(len(summary.elite_selection.kept) == 1, "checkpoint summary reports kept elite");
assert(summary.regression.format == "pbai.max.regression_suite.v1", "checkpoint summary reports regression suite");
assert(summary.benchmark_gate.format == "pbai.max.benchmark_suite.v1", "checkpoint summary reports benchmark acceptance gate");
assert(summary.cache.format == "pbai.cache.write.v1", "checkpoint summary reports cache write metadata");
assert(summary.cache_status.format == "pbai.cache.status.v1", "checkpoint summary reports current cache status");
let out2 = max.generate(loaded, "pbAI", 3);
assert(len(out2) >= 4, "loaded pbAI-Max checkpoint generates text");
cache.clear_kind("max-generation");
let cached_first = max.generate_ranked_saved("fn ", 4, "target/pbai-max-test", ["fn"], ["<unk>"], 2);
let cached_second = max.generate_ranked_saved("fn ", 4, "target/pbai-max-test", ["fn"], ["<unk>"], 2);
assert(cached_first.cache.format == "pbai.cache.write.v1" and cached_first.cache.ok, "saved ranked generation writes cache metadata");
assert(cached_second.cache.format == "pbai.max.generation_cache.v1" and cached_second.cache.hit, "saved ranked generation reuses cache on repeated prompts");
assert(str_contains(cached_second.cache.key, "max-generation-"), "saved ranked generation exposes cache key");
cache.clear_kind("max-generation");

print "pbai_max_pass";
