let T=import("stdlib:ai/pbai/stdlib/pbai_feedback_train.sapp");
let checks=0;let records=[];let maximum_error=0;let derivative_comparisons=0;
fn check(ok,label) {assert(ok,label);checks=checks+1;}
fn model(ls) {return map{format:"pbai.feedback.stack.v1",layers:ls};}
fn fixtures(wide) {
 if not wide {return [model([map{n_in:1,n_out:2,w:[[0.3],[0-0.2]],b:[0.1,0.2]}]),
  model([map{n_in:2,n_out:1,w:[[0.4,0-0.5]],b:[0.15]}])];}
 return [model([map{n_in:2,n_out:2,w:[[0.2,0-0.3],[0.4,0.1]],b:[0.1,0-0.2]},
  map{n_in:2,n_out:1,w:[[0.5,0-0.4]],b:[0.05]}]),
  model([map{n_in:1,n_out:2,w:[[0.3],[0-0.6]],b:[0.2,0.1]},
  map{n_in:2,n_out:2,w:[[0.4,0.2],[0-0.3,0.5]],b:[0-0.1,0.15]}])];
}
// Separate scalar oracle: no production forward, loss, gradient or NN helper.
fn scalar_forward(m,x) {
 let k=0;let a=x;
 while k<len(m.layers) {let l=m.layers[k];let y=[];let o=0;
  while o<len(l.b) {let sum=l.b[o];let i=0;
   while i<len(a) {sum=sum+a[i]*l.w[o][i];i=i+1;}
   push(y,1/(1+num_exp(0-sum)));o=o+1;
  } a=y;k=k+1;
 } return a;
}
fn oracle(pair,batch) {
 let sum=0;let n=0;
 while n<len(batch) {let y=scalar_forward(pair[1],scalar_forward(pair[0],batch[n]));let j=0;
  while j<len(y) {let diff=y[j]-batch[n][j];sum=sum+diff*diff;j=j+1;}
  n=n+1;
 } return sum/(2*len(batch)*len(batch[0]));
}
fn flatten_layers(ls) {let out=[];let k=0;
 while k<len(ls) {let l=ls[k];let o=0;
  while o<l.n_out {let i=0;while i<l.n_in {push(out,l.w[o][i]);i=i+1;}push(out,l.b[o]);o=o+1;}
  k=k+1;
 } return out;
}
fn flat_pair(pair) {let a=flatten_layers(pair[0].layers);let b=flatten_layers(pair[1].layers);let i=0;
 while i<len(b) {push(a,b[i]);i=i+1;}return a;
}
fn altered(pair,direction,eps) {let out=[];let cursor=0;let side=0;
 while side<2 {let ls=[];let k=0;
  while k<len(pair[side].layers) {let l=pair[side].layers[k];let ws=[];let bs=[];let o=0;
   while o<l.n_out {let row=[];let i=0;
    while i<l.n_in {push(row,l.w[o][i]+eps*direction[cursor]);cursor=cursor+1;i=i+1;}
    push(ws,row);push(bs,l.b[o]+eps*direction[cursor]);cursor=cursor+1;o=o+1;
   }push(ls,map{n_in:l.n_in,n_out:l.n_out,w:ws,b:bs});k=k+1;
  }push(out,model(ls));side=side+1;
 }return out;
}

fn reference_step(pair,batch,rate) {
 let before=flat_pair(pair);let gradient=[];let i=0;let eps=0.00001;
 while i<len(before) {let dir=[];let j=0;while j<len(before) {push(dir,0);j=j+1;}dir[i]=1;
  push(gradient,(oracle(altered(pair,dir,eps),batch)-oracle(altered(pair,dir,0-eps),batch))/(2*eps));
  derivative_comparisons=derivative_comparisons+1;i=i+1;
 }return altered(pair,gradient,0-rate);
}
fn run_reference(wide,epochs) {
 let pair=fixtures(wide);let train=[[0.2,0.8],[0.7,0.1],[0.4,0.6]];let eval=[[0.15,0.85],[0.65,0.35]];
 if not wide {train=[[0.3],[0.9],[0.1]];eval=[[0.2],[0.8]];}
 let saved=json_stringify(map{pair:pair,train:train,eval:eval});
 let r=T.train_epochs(pair[0],pair[1],train,eval,0.1,epochs);
 check(r.format=="pbai.feedback.epochs.v1" and r.objective=="half_mean_squared_reconstruction","epochs identity");
 check(r.epochs==epochs and len(r.trace)==epochs and r.learning_rate==0.1,"exact epoch and trace bounds");
 check(num_abs(r.initial_train_loss-oracle(pair,train))<0.00000000000001,"initial train half mean loss");
 check(num_abs(r.initial_eval_loss-oracle(pair,eval))<0.00000000000001,"initial held-out half mean loss");
 let original=flat_pair(pair);let reference=pair;let n=0;
 while n<epochs {
  let before=flat_pair(reference);let before_loss=oracle(reference,train);reference=reference_step(reference,train,0.1);
  let after=flat_pair(reference);let largest=0;let j=0;
  while j<len(before) {let change=num_abs(after[j]-before[j]);if change>largest {largest=change;}j=j+1;}
  check(r.trace[n].epoch==n+1 and len(r.trace[n])==4,"trace contains only bounded scalar metadata");
  check(num_abs(r.trace[n].loss_before-before_loss)<0.000000001,"each epoch frozen loss before");
  check(num_abs(r.trace[n].loss_after-oracle(reference,train))<0.000000001,"each epoch frozen loss after");
  check(num_abs(r.trace[n].max_abs_update-largest)<0.000000001,"trace actual update");n=n+1;
 }
 let actual=flat_pair([r.encoder,r.decoder]);let expected=flat_pair(reference);let i=0;
 while i<len(actual) {let err=num_abs(actual[i]-expected[i]);if err>maximum_error {maximum_error=err;}
  check(err<0.000000003,"all trained parameters match independent multi-epoch SGD");i=i+1;
 }
 check(num_abs(r.final_train_loss-oracle(reference,train))<0.000000001,"final train oracle");
 check(num_abs(r.final_eval_loss-oracle(reference,eval))<0.000000001,"final held-out oracle");
 check(r.parameters==len(original) and r.parameter_sample_traversals==len(original)*(3*epochs*len(train)+2*len(eval)),"traversal accounting includes held-out");
 check(r.train_batch_size==len(train) and r.eval_batch_size==len(eval) and r.input_width==len(train[0]),"batch metadata");
 check(json_stringify(map{pair:pair,train:train,eval:eval})==saved,"all original objects unchanged");
 let other=[[0.01,0.99]];if not wide {other=[[0.01]];}
 let alternative=T.train_epochs(pair[0],pair[1],train,other,0.1,epochs);
 check(json_stringify(flat_pair([alternative.encoder,alternative.decoder]))==json_stringify(actual),"held-out batch never affects trained parameters");
 check(json_stringify(alternative.trace)==json_stringify(r.trace),"held-out never affects epoch trace");
 let snapshot=json_stringify(r);pair[0].layers[0].w[0][0]=700;train[0][0]=0.99;eval[0][0]=0.98;
 check(json_stringify(r)==snapshot,"result detached from callers");
 let trace_snapshot=json_stringify(r.trace);r.encoder.layers[0].w[0][0]=800;
 check(json_stringify(r.trace)==trace_snapshot and pair[0].layers[0].w[0][0]==700,"trace detached from weights and originals");
 let weights_snapshot=json_stringify(r.encoder);r.trace[0].loss_after=800;
 check(json_stringify(r.encoder)==weights_snapshot,"trace mutation does not affect model");
 push(records,map{wide:wide,epochs:epochs,parameters:len(actual),initial_train_loss:r.initial_train_loss,initial_eval_loss:r.initial_eval_loss,max_error:maximum_error});
}
run_reference(true,1);run_reference(true,2);run_reference(true,5);
run_reference(false,1);run_reference(false,2);run_reference(false,5);
fn reject(pair,train,eval,rate,epochs,label) {
 let saved=json_stringify(map{pair:pair,train:train,eval:eval});let candidate=nil;
 let failed=try {candidate=T.train_epochs(pair[0],pair[1],train,eval,rate,epochs);false;} catch true;
 check(failed and candidate==nil,label);
 check(json_stringify(map{pair:pair,train:train,eval:eval})==saved,"failed training preserves originals");
}
let p=fixtures(false);let batch=[[0.3]];let held=[[0.4]];
reject(p,batch,held,0.1,0,"zero epochs");reject(p,batch,held,0.1,17,"epoch cap");
reject(p,batch,held,0.1,1.5,"fractional epochs");reject(p,batch,held,0.1,true,"boolean epochs");
reject(p,batch,held,0.1,"2","string epochs");reject(p,batch,held,0.1,nil,"nil epochs");
reject(p,batch,held,0.1,num_sqrt(0-1),"NaN epochs");reject(p,batch,held,0.1,num_exp(1000),"infinite epochs");
reject(p,batch,held,0,1,"zero rate");reject(p,batch,held,0.10001,1,"rate cap");
reject(p,batch,held,true,1,"boolean rate");reject(p,batch,held,num_sqrt(0-1),1,"NaN rate");
reject(p,nil,held,0.1,1,"nil training batch");reject(p,batch,nil,0.1,1,"nil held-out batch");
reject(p,[],held,0.1,1,"empty training batch");reject(p,batch,[],0.1,1,"empty held-out batch");
reject(p,[[0.1],[]],held,0.1,1,"last training sample malformed");
reject(p,batch,[[0.2],[]],0.1,1,"last held-out sample malformed");
reject(p,batch,[[true]],0.1,1,"held-out boolean");reject(p,batch,[[1.01]],0.1,1,"held-out range");
reject(p,batch,[[num_sqrt(0-1)]],0.1,1,"held-out NaN");reject(p,batch,[[num_exp(1000)]],0.1,1,"held-out infinity");
let many=[];let i=0;while i<17 {push(many,[0.2]);i=i+1;}
reject(p,many,held,0.1,1,"training batch cap");reject(p,batch,many,0.1,1,"held-out batch cap");
p=fixtures(false);p[0].extra="PRIVATE_CANARY";reject(p,batch,held,0.1,1,"unsupported model metadata");
p=fixtures(false);p[1].layers[0].w[0]=[];reject(p,batch,held,0.1,1,"ragged decoder");
let cyc=[];push(cyc,cyc);p=fixtures(false);
check((try {T.train_epochs(p[0],p[1],batch,[cyc],0.1,1);false;} catch true),"cyclic held-out rejected without recursive scan");
// Exact zero derivative from saturation, despite nonzero train loss.
let saturated=model([map{n_in:1,n_out:1,w:[[0]],b:[10000]}]);
let nochange=T.train_epochs(saturated,saturated,[[0]],[[0.25]],0.1,16);
check(nochange.initial_train_loss==0.5 and nochange.final_train_loss==0.5,"zero gradient is not successful learning");
check(len(nochange.trace)==16 and nochange.trace[15].max_abs_update==0,"fixed maximum epochs even with zero update");
// Reachable accepted worsening: steep decoder makes a bounded SGD step overshoot.
let e=model([map{n_in:1,n_out:1,w:[[0]],b:[0]}]);
let d=model([map{n_in:1,n_out:1,w:[[100]],b:[0-50]}]);
let worse=T.train_epochs(e,d,[[0.4]],[[0.6]],0.1,1);
check(worse.final_train_loss>worse.initial_train_loss and worse.trace[0].max_abs_update<1,"worsening is returned truthfully without selecting old weights");
check(num_abs(worse.final_train_loss-oracle([worse.encoder,worse.decoder],[[0.4]]))<0.00000000000001,"worsening loss independently recomputed");
// First epoch succeeds. The second proposes the last decoder bias above 10000.
let late=model([map{n_in:1,n_out:1,w:[[0-9999.98]],b:[9999.98]}]);
let first=T.train_epochs(saturated,late,[[1]],[[0.25]],0.1,1);
check(first.decoder.layers[0].b[0]<10000 and first.decoder.layers[0].b[0]>9999.98,"late-failure fixture really completes first epoch");
reject([saturated,late],[[1]],[[0.25]],0.1,2,"second epoch failure returns no partial training result");
fn layer(ni,no) {let ws=[];let bs=[];let o=0;while o<no {let row=[];let j=0;
 while j<ni {push(row,0);j=j+1;}push(ws,row);push(bs,0);o=o+1;}
 return map{n_in:ni,n_out:no,w:ws,b:bs};}
// 9->13 / 13->9 has P=256. 3*3*14+2*1=128 traversals: exactly 32768.
let cap_e=model([layer(9,13)]);let cap_d=model([layer(13,9)]);let row=[];i=0;
while i<9 {push(row,0.5);i=i+1;}let train=[];i=0;while i<14 {push(train,row);i=i+1;}
let exact=T.train_epochs(cap_e,cap_d,train,[row],0.1,3);
check(exact.parameters==256 and exact.parameter_sample_traversals==32768,"exact total accounting cap accepted");
reject([cap_e,cap_d],train,[row,row],0.1,3,"next held-out count exceeds total cap by 512");
reject([cap_e,cap_d],train,[row],0.1,4,"extra epoch exceeds accounting cap");
let small=T.train_epochs(fixtures(false)[0],fixtures(false)[1],[[0.3]],[[0.2]],0.000001,1);
check(small.learning_rate==0.000001,"minimum learning rate supported");
print json_stringify(map{status:"pbai_feedback_epochs_pass",checks:checks,finite_difference_derivatives:derivative_comparisons,maximum_candidate_error:maximum_error,cases:records,worsening_before:worse.initial_train_loss,worsening_after:worse.final_train_loss});
