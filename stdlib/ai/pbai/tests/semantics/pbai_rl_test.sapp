// Test: pbAI reinforcement-learning / trial-and-error trainer (stdlib/pbai_rl.sapp).
//
// "Try or trial and error": propose a candidate, keep it only if the reward improves.
// Reward toward the Ideal NN = -ideality_distance. Deterministic (seeded RNG) so the
// test is fast and reproducible; imports only the module under test (+ ideal_nn).

let rl = import("stdlib/pbai_rl.sapp");
let nn = import("stdlib/pbai_ideal_nn.sapp");

fn approx(a, b) { let d = a - b; if d < 0 { d = 0 - d; } return d < 0.0001; }
fn fabs(x) { if x < 0 { return 0 - x; } return x; }

// ── Deterministic seeded RNG ─────────────────────────────────────────────────────────
let r1 = rl.rng_next(rl.make_rng(42));
let r2 = rl.rng_next(rl.make_rng(42));
assert(approx(r1.value, r2.value), "same seed yields the same first draw (deterministic)");
assert(r1.value >= 0.0 and r1.value < 1.0, "rng draws lie in [0,1)");
let r3 = rl.rng_next(r1.rng);
assert(not approx(r3.value, r1.value), "successive draws differ");

// ── Epsilon-greedy bandit converges to the best action (explore/exploit) ─────────────
// Reward(action) = action index, so action 2 is best of 3.
let b = rl.bandit_new(3);
let rng = rl.make_rng(7);
let i = 0;
while i < 80 {
    let sel = rl.bandit_select(b, 0.2, rng);
    rng = sel.rng;
    b = rl.bandit_update(b, sel.action, sel.action * 1.0);
    i = i + 1;
}
assert(rl.bandit_best(b) == 2, "epsilon-greedy bandit learns the highest-reward action by trial and error");

// ── Generic trial-and-error optimizer maximizes a reward (minimize (x-3)^2) ──────────
let propose = fn(x, g) {
    let u = rl.rng_uniform(g, 0.0 - 0.5, 0.5);
    return map{ value: x + u.value, rng: u.rng };
};
let reward = fn(x) { let d = x - 3.0; return 0.0 - d * d; };
let res = rl.trial_and_error(0.0, propose, reward, 300, 7);
assert(res.best_reward > reward(0.0), "trial-and-error improves the reward over the starting point");
assert(fabs(res.best - 3.0) < 0.5, "trial-and-error converges near the optimum x=3");
assert(res.accepted >= 1 and res.accepted <= res.tried, "it accepts only improving candidates");
let h = res.history;
assert(h[len(h) - 1] >= h[0], "greedy acceptance makes the best-reward history non-decreasing");

// ── RL trial-and-error trains a model toward the Ideal NN ────────────────────────────
let model = map{
    layers: [[[1.1, 0.0], [0.0, 0.9]]],
    output_dist: [0.1, 0.6, 0.3],
    complex_weights: [map{ re: 0.3, im: 0.7 }, map{ re: 1.0, im: 0.0 }]
};
let ideal = nn.ideal_spec([0.2, 0.5, 0.3]);
let start_reward = rl.ideal_reward(model, ideal);
assert(approx(start_reward, 0.0 - nn.ideality_distance(model, ideal).total),
    "ideal_reward is the negated ideality distance (higher reward = closer to ideal)");

let run = rl.train_toward_ideal_rl(model, ideal, 25, 6, 0.3, 11);
let rw = run.rewards;
assert(len(rw) == 26, "training records the initial reward plus one per iteration");
let mono = true;
let s = 1;
while s < len(rw) {
    if rw[s] < rw[s - 1] { mono = false; }
    s = s + 1;
}
assert(mono, "reward never decreases (trial-and-error keeps only improvements)");
assert(rw[len(rw) - 1] > rw[0], "RL trial-and-error moves the model closer to the Ideal NN");
assert(run.accepted >= 1, "at least one improving candidate was accepted");

// ── hybrid trainer (gradient + RL) converges toward the Ideal NN ─────────────────────
let hmodel = map{
    layers: [[[1.3, 0.2], [0.1, 0.7]]],
    output_dist: [0.1, 0.6, 0.3],
    complex_weights: [map{ re: 0.3, im: 0.7 }, map{ re: 0.8, im: 0.2 }]
};
let hideal = nn.ideal_spec([0.2, 0.5, 0.3]);
let hres = rl.train_toward_ideal_hybrid(hmodel, hideal, 3, 2, 0.3, 4, 4, 0.05, 11);
assert(hres.improved, "hybrid trainer reduces the ideality distance");
assert(hres.final_distance < hres.initial_distance, "final distance < initial distance");
// history is monotonically non-increasing (each phase only accepts improvements)
let hh = hres.history;
let hmono = true;
let hk = 1;
while hk < len(hh) {
    if hh[hk] > hh[hk - 1] + 0.0000001 { hmono = false; }
    hk = hk + 1;
}
assert(hmono, "hybrid distance history never increases");

print "pbai_rl_pass";
