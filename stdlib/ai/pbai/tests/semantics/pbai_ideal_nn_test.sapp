// Test: pbAI Ideal-NN target contract (stdlib/pbai_ideal_nn.sapp).
//
// The Ideal NN is an imaginary mathematical target; we measure a computable ideality
// distance from a current model and prove that step_toward_ideal reduces it. Lean: imports
// only the module under test (+ math), so it runs fast under the debug VM.

let nn = import("stdlib/pbai_ideal_nn.sapp");

fn approx(a, b) { let d = a - b; if d < 0 { d = 0 - d; } return d < 0.0001; }

// ── Probability distances: zero on identical, positive otherwise ──────────────────────
let p = [0.2, 0.5, 0.3];
let q = [0.1, 0.6, 0.3];
assert(approx(nn.kl_divergence(p, p), 0.0), "KL(p,p) = 0");
assert(nn.kl_divergence(p, q) > 0.0, "KL(p,q) > 0 for distinct distributions");
assert(approx(nn.hellinger(p, p), 0.0), "Hellinger(p,p) = 0");
assert(nn.hellinger(p, q) > 0.0 and nn.hellinger(p, q) <= 1.0, "Hellinger in (0,1] for distinct");

// ── Fisher–Rao geodesic on the simplex (geometry): 0 on identical, needs accurate acos ─
assert(approx(nn.fisher_rao(p, p), 0.0), "Fisher-Rao(p,p) = 0 (accurate acos)");
assert(nn.fisher_rao(p, q) > 0.0, "Fisher-Rao(p,q) > 0 for distinct distributions");
assert(approx(nn.bhattacharyya(p, p), 1.0), "Bhattacharyya coefficient = 1 for identical");

// ── Spectral (linear algebra): orthogonal matrix has zero defect; Newton–Schulz reduces ─
let I = [[1.0, 0.0], [0.0, 1.0]];
assert(approx(nn.orthogonality_defect(I), 0.0), "identity is perfectly orthogonal");
let W = [[1.1, 0.0], [0.0, 0.9]];
let before = nn.orthogonality_defect(W);
let stepped = nn.newton_schulz_step(W);
let after = nn.orthogonality_defect(stepped);
assert(before > 0.0, "non-orthogonal W has positive defect");
assert(after < before, "one Newton-Schulz step moves W toward orthogonality");

// ── Complex / imaginary axis: ideal weight is 1 + 0i ─────────────────────────────────
let ideal_w = [map{ re: 1.0, im: 0.0 }, map{ re: 1.0, im: 0.0 }];
let off_w = [map{ re: 0.3, im: 0.7 }, map{ re: 1.0, im: 0.0 }];
assert(approx(nn.complex_ideality(ideal_w), 0.0), "complex_ideality = 0 at the ideal point 1+0i");
assert(nn.complex_ideality(off_w) > 0.0, "complex_ideality > 0 away from the ideal");

// ── Composite ideality distance + training toward the ideal ──────────────────────────
let model = map{
    layers: [W],
    output_dist: q,
    complex_weights: off_w
};
let ideal = nn.ideal_spec(p);   // target distribution = p
let d0 = nn.ideality_distance(model, ideal);
assert(d0.total > 0.0, "a non-ideal model has positive total ideality distance");
assert(d0.spectral >= 0.0 and d0.distributional >= 0.0 and d0.geometric >= 0.0 and d0.complex >= 0.0,
    "ideality distance reports a non-negative per-axis breakdown");

let model2 = nn.step_toward_ideal(model, ideal, 0.5);
let d1 = nn.ideality_distance(model2, ideal);
assert(d1.total < d0.total, "step_toward_ideal strictly reduces the total ideality distance");

// ── Opt-in regularizer hook is the composite total (loss = task + lambda*reg) ─────────
assert(approx(nn.ideality_regularizer(model, ideal), d0.total),
    "ideality_regularizer equals the composite total, ready to add to a task loss");

// ── Multi-step training loop: the current NN converges toward the Ideal NN ────────────
let run = nn.iterate_toward_ideal(model, ideal, 0.5, 6);
assert(len(run.distances) == 7, "iterate records the initial distance plus one per step");
assert(approx(run.distances[0], d0.total), "trajectory starts at the initial ideality distance");
let mono = true;
let s = 1;
while s < len(run.distances) {
    if run.distances[s] >= run.distances[s - 1] { mono = false; }
    s = s + 1;
}
assert(mono, "each training step strictly decreases the ideality distance (monotonic convergence)");
assert(run.distances[6] < run.distances[0] * 0.5, "the loop closes most of the gap to the Ideal NN");

print "pbai_ideal_nn_pass";
