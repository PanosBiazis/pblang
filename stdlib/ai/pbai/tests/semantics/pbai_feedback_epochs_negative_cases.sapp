// Uncaught diagnostic fixtures: the external bounded runner must compare the
// complete error payload, not merely exit 1 or the presence of any exception.
let T=import("stdlib:ai/pbai/stdlib/pbai_feedback_train.sapp");
fn model(w,b) {return map{format:"pbai.feedback.stack.v1",layers:[map{n_in:1,n_out:1,w:[[w]],b:[b]}]};}
fn run_case(name) {
 let e=model(0.2,0.1);let d=model(0.3,0.1);
 let request=map{train:[[0.2]],eval:[[0.3]],rate:0.1,epochs:1};let found=true;let operation="epochs";
 if name=="gradient_nan_sample" {operation="gradients";request.train=[[num_sqrt(0-1)]];}
 else if name=="gradient_nan_parameter" {operation="gradients";e.layers[0].w[0][0]=num_sqrt(0-1);}
 else if name=="step_nan_rate" {operation="step";request.rate=num_sqrt(0-1);}
 else if name=="step_nan_sample" {operation="step";request.train=[[num_sqrt(0-1)]];}
 else if name=="step_nan_parameter" {operation="step";e.layers[0].w[0][0]=num_sqrt(0-1);}
 else if name=="epochs_nan_parameter" {e.layers[0].w[0][0]=num_sqrt(0-1);}
 else if name=="epoch_zero" {request.epochs=0;}
 else if name=="epoch_over" {request.epochs=17;}
 else if name=="epoch_fraction" {request.epochs=1.5;}
 else if name=="epoch_bool" {request.epochs=true;}
 else if name=="epoch_string" {request.epochs="2";}
 else if name=="epoch_nil" {request.epochs=nil;}
 else if name=="epoch_nan" {request.epochs=num_sqrt(0-1);}
 else if name=="epoch_inf" {request.epochs=num_exp(1000);}
 else if name=="rate_zero" {request.rate=0;}
 else if name=="rate_over" {request.rate=0.10001;}
 else if name=="rate_bool" {request.rate=true;}
 else if name=="rate_nan" {request.rate=num_sqrt(0-1);}
 else if name=="train_nil" {request.train=nil;}
 else if name=="eval_nil" {request.eval=nil;}
 else if name=="train_empty" {request.train=[];}
 else if name=="eval_empty" {request.eval=[];}
 else if name=="train_last_shape" {request.train=[[0.2],[]];}
 else if name=="eval_last_shape" {request.eval=[[0.3],[]];}
 else if name=="eval_bool" {request.eval=[[true]];}
 else if name=="eval_range" {request.eval=[[1.01]];}
 else if name=="eval_nan" {request.eval=[[num_sqrt(0-1)]];}
 else if name=="eval_inf" {request.eval=[[num_exp(1000)]];}
 else if name=="train_many" {request.train=[];let i=0;while i<17 {push(request.train,[0.2]);i=i+1;}}
 else if name=="eval_many" {request.eval=[];let i=0;while i<17 {push(request.eval,[0.3]);i=i+1;}}
 else if name=="model_extra" {e.extra="PRIVATE_CANARY";}
 else if name=="model_ragged" {d.layers[0].w[0]=[];}
 else if name=="eval_cyclic" {let row=[];push(row,row);request.eval=[row];}
 else if name=="second_epoch_last_bias" {
  e=model(0,10000);d=model(0-9999.98,9999.98);request.train=[[1]];request.eval=[[0.25]];request.epochs=2;
 } else {found=false;}
 assert(found,"unknown negative diagnostic fixture");
 if operation=="gradients" {T.gradients(e,d,request.train);}
 else if operation=="step" {T.step(e,d,request.train,request.rate);}
 else {T.train_epochs(e,d,request.train,request.eval,request.rate,request.epochs);}
 // Deliberately different from the API family, so unexpected success rejects.
 throw "negative diagnostic fixture unexpectedly succeeded";
}
export run_case;
