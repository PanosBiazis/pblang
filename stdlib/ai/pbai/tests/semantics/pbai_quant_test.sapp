// Test: stdlib/pbai_quant.sapp -- pbAI weight quantization (fN engine Phase 3).
// Builds a small Nano LM, quantizes its weights to low-bit formats, and verifies the
// compression math, error bounds, shape preservation, idempotency, and pack round-trip.

let LM = import("stdlib/pbai_lm.sapp");
let Q = import("stdlib/pbai_quant.sapp");

// small deterministic model: V=8, D=4, H=6, K=2 -> 32+48+6+48+8 = 142 weights
let model = LM.model_new(8, 4, 6, 2, 1);

// ---- report: compression math is exact -------------------------------------
let r16 = Q.quant_report(model, "f16");
assert(r16.weights == 142, "counts all 142 scalar weights");
assert(r16.bits_per_weight == 16, "f16 is 16 bits/weight");
assert(r16.compression == 4, "f16 vs f64 is 4x smaller");

let r8 = Q.quant_report(model, "f8e4m3");
assert(r8.bits_per_weight == 8, "f8e4m3 is 8 bits/weight");
assert(r8.compression == 8, "f8e4m3 vs f64 is 8x smaller");

// f8 is coarser than f16, so its quantization error is at least as large
assert(r8.max_abs_error >= r16.max_abs_error, "f8 error >= f16 error");
assert(r16.mean_abs_error >= 0, "mean error is well-defined");

// ---- quantize_model: shapes preserved, model still well-formed --------------
let qm = Q.quantize_model(model, "f16");
assert(len(qm.E) == 8 and len(qm.E[0]) == 4, "E shape [8][4] preserved");
assert(len(qm.W1) == 8 and len(qm.W1[0]) == 6, "W1 shape [8][6] preserved");
assert(len(qm.W2) == 6 and len(qm.W2[0]) == 8, "W2 shape [6][8] preserved");
assert(len(qm.b2) == 8, "b2 shape [8] preserved");
assert(qm.V == 8 and qm.D == 4 and qm.H == 6 and qm.K == 2, "V/D/H/K preserved");
assert(qm.quant.weights == 142, "embedded report counts 142 weights");

// ---- idempotency: re-quantizing already-f16 weights has zero error ----------
let qm2 = Q.quantize_model(qm, "f16");
assert(qm2.quant.max_abs_error == 0, "re-quantizing f16 weights is lossless (idempotent)");

// ---- pack / unpack round-trip on real weights -------------------------------
let packed = Q.pack_tensor(model.b2, "f8e5m2");
assert(packed.n == 8, "packed flat length is 8");
let restored = Q.unpack_tensor(packed, "f8e5m2");
let FN = import("stdlib:floatn.sapp");
let i = 0;
while i < 8 {
    assert(restored[i] == FN.quantize(model.b2[i], "f8e5m2"), "b2 pack round-trip @" + str(i));
    i = i + 1;
}

// ---- capability report ------------------------------------------------------
let cap = Q.capability();
assert(cap.module == "stdlib/pbai_quant.sapp", "capability names the module");
assert(len(cap.supported) >= 5, "capability lists supported formats");

print "pbai_quant_pass";
