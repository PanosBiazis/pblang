let F=import("stdlib/pbai_feedback.sapp");
let N=import("stdlib:nn.sapp");
fn near(a,b) {return num_abs(a-b)<0.00000001;}
fn rejected(f) {return (try {f();false;} catch true);}
let net=N.mlp_new(2,3,1,42);
let rev=N.mlp_new(1,4,2,55);
let a=F.stack([net.l1,net.l2]);let b=F.stack([rev.l1,rev.l2]);
let x=[0.2,0.8];let expected=N.predict(net,x);
assert(near(F.forward(a,x)[0],expected[0]),"actual MLP forward");
let original=json_stringify(map{a:a,b:b,x:x});
let r=F.cycle(a,b,x,map{max_iterations:16});
assert(r.converged and r.iterations<=16,"bounded convergence");
assert(near(F.forward(a,r.input)[0],r.output[0]),"final output uses returned state");
assert(near(F.forward(b,r.output)[1],r.reconstruction[1]),"final reconstruction consistent");
assert(json_stringify(map{a:a,b:b,x:x})==original,"caller model and input unchanged");
r.input[0]=99;r.output[0]=99;r.reconstruction[0]=99;
assert(json_stringify(map{a:a,b:b,x:x})==original,"result detached");
net.l1.w[0][0]=123;assert(a.layers[0].w[0][0]!=123,"stack detaches original weights");
let small=F.cycle(a,b,x,map{max_iterations:1,damping:0.000001,tolerance:0.000001});
assert(not small.converged and small.stop_reason=="iteration_limit","tiny damping not false convergence");
let anchored=F.cycle(a,b,x,map{max_iterations:32,anchor:0.5,damping:0.8});
assert(anchored.converged,"anchored reconstruction converges");
assert(near(anchored.input[0],0.5*x[0]+0.5*anchored.reconstruction[0]) or anchored.residual<0.000001,"anchor retained");
let depth=F.stack([N.dense_new(2,4,1),N.dense_new(4,3,2),N.dense_new(3,1,3)]);
assert(len(F.forward(depth,x))==1,"multiple hidden layers");
assert(rejected(fn(){F.cycle(a,a,x);}),"reverse dimension mismatch");
assert(rejected(fn(){F.forward(a,[0.2]);}),"input dimensions");
assert(rejected(fn(){F.forward(a,[nil,0]);}),"numeric validation");
assert(rejected(fn(){F.forward(a,[true,0]);}),"boolean rejected");
assert(rejected(fn(){F.forward(a,[1000001,0]);}),"input bound");
assert(rejected(fn(){F.cycle(a,b,x,map{max_iterations:0});}),"zero cap");
assert(rejected(fn(){F.cycle(a,b,x,map{max_iterations:33});}),"large cap");
assert(rejected(fn(){F.cycle(a,b,x,map{max_iterations:1.5});}),"fraction cap");
assert(rejected(fn(){F.cycle(a,b,x,map{damping:0});}),"zero damping");
assert(rejected(fn(){F.cycle(a,b,x,map{anchor:1});}),"identity anchor false convergence avoided");
assert(rejected(fn(){F.cycle(a,b,x,map{tolerance:0});}),"zero tolerance");
assert(rejected(fn(){F.cycle(a,b,x,map{extra:true});}),"unknown options");
assert(rejected(fn(){F.stack([]);}),"empty network");
assert(rejected(fn(){F.stack([map{n_in:33,n_out:1,w:[],b:[]}]);}),"width limit");
assert(rejected(fn(){F.stack([map{n_in:1,n_out:1,w:[[10001]],b:[0]}]);}),"weight magnitude limit");
assert(rejected(fn(){F.stack([map{n_in:1,n_out:1,w:[[]],b:[0]}]);}),"ragged rows");
assert(rejected(fn(){F.stack([map{n_in:1,n_out:1,w:[[1]],b:[]}]);}),"bias shape");
assert(rejected(fn(){F.stack([rev.l1,net.l2]);}),"interlayer shape mismatch");
assert(rejected(fn(){F.forward(map{},x);}),"model format");
// Strong negative feedback oscillates; finite cap must stop it honestly.
let identity=F.stack([map{n_in:1,n_out:1,w:[[40]],b:[0-20]}]);
let flip=F.stack([map{n_in:1,n_out:1,w:[[0-40]],b:[20]}]);
let oscillating=F.cycle(identity,flip,[0],map{max_iterations:4,tolerance:0.000001});
assert(not oscillating.converged and oscillating.iterations==4,"oscillation bounded");
assert(oscillating.pair_evaluations==5,"diagnostic evaluation counted");
// Fixed point can reconstruct the wrong observation: these measures are distinct.
let constant=F.stack([map{n_in:1,n_out:1,w:[[0]],b:[0]}]);
let stationary=F.cycle(constant,constant,[0]);
assert(stationary.converged and stationary.reconstruction_error==0.5,"convergence not accuracy");
let nan=num_sqrt(0-1);let inf=num_exp(1000);
assert(rejected(fn(){F.forward(a,[nan,0]);}),"NaN input rejected");
assert(rejected(fn(){F.forward(a,[inf,0]);}),"infinite input rejected");
assert(rejected(fn(){F.stack([map{n_in:1,n_out:1,w:[[nan]],b:[0]}]);}),"NaN weight rejected");
assert(rejected(fn(){F.cycle(a,b,x,map{tolerance:inf});}),"infinite tolerance rejected");
let many=[];let idx=0;while idx<9 {push(many,constant.layers[0]);idx=idx+1;}
assert(rejected(fn(){F.stack(many);}),"layer cap");
let wide=[];idx=0;while idx<8 {push(wide,N.dense_new(32,32,idx));idx=idx+1;}
let wide_model=F.stack(wide);
assert(rejected(fn(){F.cycle(wide_model,wide_model,[]);}),"aggregate parameter cap before input");
// Large finite preactivation saturates without propagating nonfinite values.
let saturation=F.stack([map{n_in:1,n_out:1,w:[[10000]],b:[10000]}]);
assert(F.forward(saturation,[1000000])[0]==1,"positive saturation finite");
assert(F.forward(saturation,[0-1000000])[0]==0,"negative saturation finite");
// Independent numerical oracle: sigmoid(1) and sigmoid(2*sigmoid(1)-1).
let oracle=F.stack([map{n_in:1,n_out:1,w:[[2]],b:[0-1]}]);
assert(near(F.forward(oracle,[1])[0],0.7310585786300049),"independent sigmoid oracle");
let oracle_round=F.cycle(oracle,oracle,[1],map{max_iterations:1});
assert(near(oracle_round.input[0],0.6135163043587272),"independent round-trip oracle");
let swapped=F.cycle(b,a,[0.3],map{max_iterations:16});
assert(len(swapped.input)==1 and len(swapped.output)==2 and swapped.converged,"output-origin cycle");
assert(rejected(fn(){F.stack(nil);}),"nil layers");
assert(rejected(fn(){F.stack([nil]);}),"nil layer");
assert(rejected(fn(){F.cycle(a,b,x,[]);}),"options type");
assert(rejected(fn(){F.cycle(a,b,x,map{tolerance:nil});}),"nil option value");
assert(rejected(fn(){F.stack([map{n_in:1,n_out:1,w:[[1]],b:[0],extra:0}]);}),"unknown layer field");
print "pbai_feedback_pass";
