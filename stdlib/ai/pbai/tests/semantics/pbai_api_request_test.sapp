let R=import("stdlib:ai/pbai/tools/pbai_api_request.sapp");
let checks=0;
fn check(ok,label) {checks=checks+1;assert(ok,label);}
fn parsed(text) {return R.parse_bytes(str_to_bytes(text));}
check(R.read_request("").ok,"omitted request bypasses backend");
check(parsed("{}").ok,"empty object");
check(parsed("{\"prompt\":\"Ελληνικά 😀\"}").value.prompt=="Ελληνικά 😀","unicode");
let texts=["", " ", "null", "true", "2", "[]", "\"text\"", "{", "{}{}", "{\"n\":1e999}"];
let at=0;while at<len(texts) {
    check(not parsed(texts[at]).ok,"malformed or non-object rejected");at=at+1;
}
let invalid_bytes=[[255],[123,34,120,34,58,34,192,175,34,125],
    [123,34,120,34,58,34,237,160,128,34,125],[123,34,120,34,58,34,226,130,34,125]];
at=0;while at<len(invalid_bytes) {
    check(not R.parse_bytes(invalid_bytes[at]).ok,"invalid UTF-8 rejected");at=at+1;
}
check(not parsed(strfromcharcode(65279)+"{}").ok,"BOM rejected by JSON grammar");
check(parsed("{\"x\":1,\"x\":2}").value.x==2,"duplicate last wins preserved");
check(parsed("{\"format\":\"pbai.api.invalid-request.v1\",\"error\":\"synthetic-secret\"}").ok,
    "payload cannot forge internal failure envelope");
let text="{}";
at=0;while at<31 {text="{\"x\":"+text+"}";at=at+1;}
check(parsed(text).ok,"32 containers accepted");
check(not parsed("{\"x\":"+text+"}").ok,"33 containers rejected");
check(parsed("{\"x\":\"[[[[{{}}\\\"\\\\\"}").ok,"string brackets and escapes ignored");
print json_stringify(map{format:"pbai.api.request-tests.v1",checks:checks});
