// tests/semantics/pbai_ingest_test.sapp
let ingest = import("stdlib/pbai_ingest.sapp");
let lm = import("stdlib/pbai_lm.sapp");

let before_live = lm.live_corpus();
let result = ingest.ingest_path("tests/fixtures/sanitized_note.txt", 1, 0, 1);
let live = lm.live_corpus();

assert(result.format == "pbai.ingest.v1", "ingest result contract is versioned");
assert(result.stats.files == 1, "ingest reads the explicit fixture file");
assert(result.stats.redactions == 1, "ingest reports redacted sensitive lines");
assert(str_contains(live, "comet orchid"), "safe lesson content is learned");
assert(str_contains(live, "safe code survives sanitization"), "safe code content is learned");
assert(str_contains(live, "[REDACTED sensitive line]"), "redaction marker is learned instead of the secret value");
assert(not str_contains(live, "do-not-store-this-value"), "secret value is not stored in live corpus");

fs_write(lm.live_corpus_path(), before_live);

print "pbai_ingest_pass";
