// Test: pbAI external data/reference inventory (stdlib/pbai_assets.sapp).
//
// The repo can run without the external AAP/ai sandbox. When it is present, this test
// locks the boundary: those files are reference inputs/baselines, not the pbAI runtime
// model or the architecture source of truth.

let assets = import("stdlib/pbai_assets.sapp");
let pbai = import("stdlib/pbai.sapp");

let missing = assets.model_summary("/definitely/not/a/pbai/asset/root");
assert(not missing.available, "missing asset root reports unavailable");

let root = assets.find_root();
if root != nil {
    let m = assets.model_summary(root);
    assert(m.available, "model summary is available");
    assert(m.model_type == "gpt2", "prior baseline checkpoint is GPT-2 shaped");
    assert(m.layers == 4 and m.heads == 4, "checkpoint architecture is 4L/4H");
    assert(m.embedding == 256 and m.ffn == 1024, "checkpoint dimensions are locked");
    assert(m.context == 128 and m.vocab_size == 16384, "checkpoint context/vocab are locked");

    let t = assets.tokenizer_summary(root);
    assert(t.available, "tokenizer summary is available");
    assert(t.tokenizer_type == "BPE", "tokenizer is BPE");
    assert(t.vocab_size == 16384, "tokenizer vocab matches model vocab");
    assert(t.merges > 10000, "tokenizer exposes a real merge table");

    let files = assets.checkpoint_files(root);
    assert(files.available, "checkpoint files are listed");
    assert(files.files[0].exists and files.files[1].exists and files.files[4].exists,
        "config, tokenizer, and safetensors files exist");

    let desc = assets.describe(root);
    assert(str_contains(desc, "gpt2") and str_contains(desc, "tokenizer=BPE"),
        "describe reports model and tokenizer");
    assert(str_contains(desc, "not the pbAI runtime model"),
        "describe keeps prior checkpoints outside the pbAI runtime model");

    let plan = assets.implementation_plan(root);
    assert(str_contains(plan.next_steps[0], "fresh pbAI tokenizer"),
        "implementation plan starts from the fresh pbAI contract");
    assert(str_contains(plan.next_steps[3], "not as pbAI-Max"),
        "implementation plan forbids old checkpoints from defining pbAI-Max");

    let ans = pbai.respond("what pbAI model checkpoint and tokenizer assets are available?");
    assert(str_contains(ans, "pbAI external references") and str_contains(ans, "not the pbAI runtime model"),
        "pbAI knowledge layer reports local assets as references only");
} else {
    let desc2 = assets.describe();
    assert(str_contains(desc2, "not found"), "describe handles absent local assets");
}

print "pbai_assets_pass";
