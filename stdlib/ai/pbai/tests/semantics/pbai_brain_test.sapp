// Test: pbAI brain loop contract (stdlib/pbai_brain.sapp).

let brain = import("stdlib/pbai_brain.sapp");
let pbai = import("stdlib/pbai.sapp");

let p = brain.perceive("Find the bug:\n\nfn f() { print(1); }");
assert(p.format == "pbai.brain.loop.v1", "brain perception format is versioned");
assert(p.kind == "code", "perception classifies code-shaped prompts");
assert(brain.contains(p.signals, "code"), "perception records code signal");
assert(brain.contains(p.modalities, "code"), "perception records code modality");
assert(not brain.contains(p.modalities, "json"), "pblang braces do not make code look like JSON");
assert(p.needs_verification, "code prompts require verification");
let neural = brain.neural_core("Find the bug:\n\nfn f() { print(1); }", p);
assert(neural.format == "pbai.neural.brain.v1", "neural brain core is versioned");
assert(str_contains(neural.portable, "pblang"), "neural brain core is portable pblang");
assert(neural.outputs.attention > 0 and neural.outputs.verification > 0, "neural brain core emits cognitive scores");

let mods = brain.data_modalities("# Report\n\n```pblang\nfn f() { return 1; }\n```\nimage.png\nerror: failed");
assert(brain.contains(mods, "markdown"), "modality detection sees markdown");
assert(brain.contains(mods, "code"), "modality detection sees code");
assert(brain.contains(mods, "image"), "modality detection sees image hints");
assert(brain.contains(mods, "logs"), "modality detection sees logs");

let mem = brain.new_memory(2);
brain.remember(mem, "observation", "first");
brain.remember(mem, "decision", "guard map reads", 2);
brain.remember(mem, "lesson", "print is a statement", 2);
assert(len(mem.working) == 2, "working memory respects its limit");
assert(len(mem.episodic) == 3, "episodic memory keeps the sequence");
assert(len(mem.long_term) == 2, "important events enter long-term memory");
let att = brain.attend(mem, p);
assert(att.focus_count > 0, "attention selects relevant working-memory events");
let goal = brain.goal_state("Find the bug:\n\nfn f() { print(1); }", p);
assert(goal.priority == 2 and str_contains(goal.success, "verification"), "goal state defines success criteria for code work");
let cons = brain.consolidate(mem);
assert(cons.long_term >= 2, "consolidation reports long-term memory size");

let pl = brain.plan("error: missing key while running tests", brain.perceive("error: missing key while running tests"));
assert(pl.tool_ready, "failure plans are tool-ready");
assert(len(pl.steps) >= 5, "failure plan includes localize/fix/verify steps");
assert(brain.contains(pl.data_modalities, "logs") or brain.contains(pl.data_modalities, "test-output"), "plans carry data modality hints");
assert(pl.neural.outputs.verification > 0, "plans include neural cognitive scores");

let cr = brain.critique(pl);
assert(len(cr.risks) > 0, "critique reports risks");
assert(str_contains(cr.recommendation, "verifier"), "tool-ready critique recommends verification");

let vr = brain.verify_result("pbai_pass");
assert(vr.passed, "verification recognizes pass output");
let refl = brain.reflect(pl, cr, vr);
assert(len(refl.lessons) > 0 and refl.confidence_delta > 0, "reflection captures lessons from verification");
let agents = brain.agent_hierarchy("review json data and fix code");
assert(agents.format == "pbai.agent.hierarchy.v1", "agent hierarchy is versioned");
assert(len(agents.sub_agents) >= 4, "agent hierarchy exposes sub-agents");
assert(len(agents.atomic_agents) >= 5, "agent hierarchy exposes atomic-agents");
assert(len(agents.sub_atomic_agents) >= 4, "agent hierarchy exposes sub-atomic-agents");

let thought = pbai.think("what pbAI brain memory plan exists?", "pbai_pass");
assert(thought.format == "pbai.brain.loop.v1", "top-level think returns the brain loop");
assert(thought.verification.passed, "top-level think includes verification");
assert(str_contains(thought.answer, "pbAI brain loop"), "top-level think includes grounded answer");
assert(thought.attention.focus_count > 0, "top-level think includes attention state");
assert(len(thought.reflection.lessons) > 0, "top-level think includes reflection lessons");
assert(len(thought.agents.sub_agents) >= 4, "top-level think includes agent hierarchy");
assert(thought.neural.outputs.attention > 0, "top-level think includes neural cognitive core");
let code_thought = pbai.think("Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }");
assert(len(code_thought.live_memory) == 0, "code review thoughts do not inject unrelated live memory");

let status = pbai.model_status();
assert(status.brain.format == "pbai.brain.loop.v1", "model status exposes brain loop");

print "pbai_brain_pass";
