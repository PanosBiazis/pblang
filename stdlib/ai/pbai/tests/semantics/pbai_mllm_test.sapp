// Test: the standalone pbAI project now shares the ONE MLLM engine (stdlib/pbai_ensemble.sapp)
// and can combine multiple brains/LLMs into a single confidence-weighted ensemble.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = "explain what this function does";

// the shared ensemble API is wired into the project pbai
pbai.clear_voters();
pbai.reset_stats();
eq(pbai.ensemble(p), pbai.classify_scores(p).intent, "ensemble == native when no extra voters");

// register_model: plug a SECOND brain into the MLLM (here a stub classifier). A strong second
// model swings the combined decision — this is two models combined into one MLLM.
pbai.register_model("brain2", fn(x) { return map{ intent: "bugs", scores: [0.1, 0.95, 0.1, 0.1, 0.1] }; }, 4);
eq(pbai.ensemble(p), "bugs", "a strong second model swings the combined MLLM");

// the full smart stack is present in the project too
pbai.set_adaptive(true);
pbai.set_parallel(true);
let d = pbai.ensemble_decide(p, 0.5);
if not map_has(d, "intent") or not map_has(d, "confidence") or not map_has(d, "escalate") { fail("ensemble_decide shape"); }
pbai.set_parallel(false);
pbai.set_adaptive(false);

// external/local LLM voter constructors are available here as well
let v = pbai.llm_voter("x", nil, fn(msg) { return "improve"; });
eq(v(p).intent, "improve", "llm_voter works in the project build");

pbai.clear_voters();
pbai.reset_stats();
print "pbai_mllm_pass";
