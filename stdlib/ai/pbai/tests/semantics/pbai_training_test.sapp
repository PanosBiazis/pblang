// Test: pbAI-Nano training — learning-rate annealing (stdlib/pbai_lm.sapp). A higher
// initial lr that decays each epoch settles into a much sharper minimum than a flat lr
// for the same epoch budget. Deterministic, so the comparison is exact and non-flaky.

let lm = import("stdlib/pbai_lm.sapp");

let corpus = "fn add(a, b) { return a + b; }\nfn main() { let x = add(2, 3); print x; }\nlet m = map{ ok: true, value: 42 };\nif map_has(m, \"value\") { print m[\"value\"]; }\n";
let v = lm.vocab_build(corpus);
let ids = lm.encode(v, corpus);
let epochs = 40;

// identical initialization (same seed) — anneal must beat constant lr on equal budget
let a = lm.model_new(v.size, 4, 10, 3, 7);
lm.train(a, ids, epochs, 0.2);              // constant lr (4-arg, default schedule)
let const_loss = lm.avg_loss(a, ids);

let b = lm.model_new(v.size, 4, 10, 3, 7);
lm.train(b, ids, epochs, 0.25, 0.97);       // annealed lr
let anneal_loss = lm.avg_loss(b, ids);

assert(anneal_loss < const_loss, "lr annealing reaches lower loss than constant lr on equal budget");
assert(anneal_loss < 1.0, "annealed training converges to a sharp minimum");

// backward compatibility: the 4-argument constant-lr call still learns
let c = lm.model_new(v.size, 4, 8, 2, 1);
let c0 = lm.avg_loss(c, ids);
lm.train(c, ids, 20, 0.2);
assert(lm.avg_loss(c, ids) < c0, "4-argument train (constant lr) still reduces loss");

// determinism: same init + same schedule -> identical loss
let d1 = lm.model_new(v.size, 4, 10, 3, 7);
lm.train(d1, ids, 15, 0.25, 0.97);
let d2 = lm.model_new(v.size, 4, 10, 3, 7);
lm.train(d2, ids, 15, 0.25, 0.97);
assert(lm.avg_loss(d1, ids) == lm.avg_loss(d2, ids), "training is deterministic for a fixed init and schedule");

// Xavier init trains faster than the default heuristic in the few-epoch regime (the
// live generate/learn paths), at identical seed/schedule
let xa = lm.model_new(v.size, 4, 10, 3, 7, "xavier");
lm.train(xa, ids, 4, 0.25, 0.96);
let de = lm.model_new(v.size, 4, 10, 3, 7, "default");
lm.train(de, ids, 4, 0.25, 0.96);
assert(lm.avg_loss(xa, ids) < lm.avg_loss(de, ids), "xavier init reaches lower loss than default at low epochs");

// mini-batch optimizer (gradient accumulation + momentum): learns and is deterministic
let bt1 = lm.model_new(v.size, 4, 10, 3, 7);
let bt0 = lm.avg_loss(bt1, ids);
lm.train_batch(bt1, ids, 30, 0.5, 8, 0.9, 0.97);
assert(lm.avg_loss(bt1, ids) < bt0, "train_batch reduces loss");
let bt2 = lm.model_new(v.size, 4, 10, 3, 7);
lm.train_batch(bt2, ids, 30, 0.5, 8, 0.9, 0.97);
assert(lm.avg_loss(bt1, ids) == lm.avg_loss(bt2, ids), "train_batch is deterministic");

// parallel best-of-N training (multi-core via spawn): best-of-4 includes the single
// seed, so it can only match or beat it, and it still reduces loss
let single = lm.train_best(ids, v.size, 1, 18, 0.25);
let multi = lm.train_best(ids, v.size, 4, 18, 0.25);
assert(multi.loss1 <= single.loss1, "best-of-4 parallel training is no worse than a single seed");
assert(multi.loss1 < single.loss0, "parallel training reduces loss");

print "pbai_training_pass";
