let T=import("stdlib:ai/pbai/stdlib/pbai_feedback_train.sapp");
let numerical_records=[];let directional_records=[];let checks=0;let max_error=0;let max_directional_error=0;let min_encoder_norm=1;
fn check(ok,label) {assert(ok,label);checks=checks+1;}
fn model(ls) {return map{format:"pbai.feedback.stack.v1",layers:ls};}
fn fixtures(wide) {
 if not wide {return [model([map{n_in:1,n_out:2,w:[[0.3],[0-0.2]],b:[0.1,0.2]}]),
  model([map{n_in:2,n_out:1,w:[[0.4,0-0.5]],b:[0.15]}])];}
 return [model([map{n_in:2,n_out:2,w:[[0.2,0-0.3],[0.4,0.1]],b:[0.1,0-0.2]},
  map{n_in:2,n_out:1,w:[[0.5,0-0.4]],b:[0.05]}]),
  model([map{n_in:1,n_out:2,w:[[0.3],[0-0.6]],b:[0.2,0.1]},
  map{n_in:2,n_out:2,w:[[0.4,0.2],[0-0.3,0.5]],b:[0-0.1,0.15]}])];
}
// Separate scalar oracle: no production forward, loss, gradient or NN helper.
fn scalar_forward(m,x) {
 let k=0;let a=x;
 while k<len(m.layers) {let l=m.layers[k];let y=[];let o=0;
  while o<len(l.b) {let sum=l.b[o];let i=0;
   while i<len(a) {sum=sum+a[i]*l.w[o][i];i=i+1;}
   push(y,1/(1+num_exp(0-sum)));o=o+1;
  } a=y;k=k+1;
 } return a;
}
fn oracle(pair,batch) {
 let sum=0;let n=0;
 while n<len(batch) {let y=scalar_forward(pair[1],scalar_forward(pair[0],batch[n]));let j=0;
  while j<len(y) {let diff=y[j]-batch[n][j];sum=sum+diff*diff;j=j+1;}
  n=n+1;
 } return sum/(2*len(batch)*len(batch[0]));
}
fn flatten_layers(ls) {let out=[];let k=0;
 while k<len(ls) {let l=ls[k];let o=0;
  while o<l.n_out {let i=0;while i<l.n_in {push(out,l.w[o][i]);i=i+1;}push(out,l.b[o]);o=o+1;}
  k=k+1;
 } return out;
}
fn flat_pair(pair) {let a=flatten_layers(pair[0].layers);let b=flatten_layers(pair[1].layers);let i=0;
 while i<len(b) {push(a,b[i]);i=i+1;}return a;
}
fn altered(pair,direction,eps) {let out=[];let cursor=0;let side=0;
 while side<2 {let ls=[];let k=0;
  while k<len(pair[side].layers) {let l=pair[side].layers[k];let ws=[];let bs=[];let o=0;
   while o<l.n_out {let row=[];let i=0;
    while i<l.n_in {push(row,l.w[o][i]+eps*direction[cursor]);cursor=cursor+1;i=i+1;}
    push(ws,row);push(bs,l.b[o]+eps*direction[cursor]);cursor=cursor+1;o=o+1;
   }push(ls,map{n_in:l.n_in,n_out:l.n_out,w:ws,b:bs});k=k+1;
  }push(out,model(ls));side=side+1;
 }return out;
}
fn numerical(wide,batch) {
 let pair=fixtures(wide);let before=flat_pair(pair);let input_before=json_stringify(batch);
 let g=T.gradients(pair[0],pair[1],batch);let flat=flat_pair([model(g.encoder),model(g.decoder)]);
 check(g.objective=="half_mean_squared_reconstruction","objective identity");
 check(num_abs(g.loss - oracle(pair,batch))<0.00000000000001,"independent scalar objective");
 check(g.parameters==len(before) and g.parameter_sample_pairs==len(before)*len(batch),"work accounting");
 let en=flatten_layers(g.encoder);let norm=0;let i=0;while i<len(en) {norm=norm+num_abs(en[i]);i=i+1;}
 check(norm>0.00000001,"nonzero encoder gradient across decoder boundary");if norm<min_encoder_norm {min_encoder_norm=norm;}
 let epss=[0.00001,0.000001];let s=0;
 while s<len(epss) {let eps=epss[s];i=0;
  while i<len(before) {let dir=[];let j=0;while j<len(before) {push(dir,0);j=j+1;}dir[i]=1;
   let fd=(oracle(altered(pair,dir,eps),batch) - oracle(altered(pair,dir,0-eps),batch))/(2*eps);
   let err=num_abs(fd - flat[i]);if err>max_error {max_error=err;}
   push(numerical_records,map{wide:wide,batch:len(batch),parameter:i,epsilon:eps,analytic:flat[i],finite_difference:fd,error:err});
   check(err<=0.000001+0.0001*num_abs(fd),"every weight/bias central finite difference");i=i+1;
  }
  let v=[];let dot=0;i=0;
  while i<len(before) {let value=(num_mod(i*7+3,11)-5)/7;push(v,value);dot=dot+flat[i]*value;i=i+1;}
  let numerical=(oracle(altered(pair,v,eps),batch) - oracle(altered(pair,v,0-eps),batch))/(2*eps);
  let error=num_abs(numerical - dot);if error>max_directional_error {max_directional_error=error;}
  push(directional_records,map{wide:wide,batch:len(batch),epsilon:eps,analytic:dot,finite_difference:numerical,error:error});
  check(error<=0.000001+0.0001*num_abs(numerical),"joint directional derivative");s=s+1;
 }
 check(json_stringify(flat_pair(pair))==json_stringify(before),"parameters unchanged");
 check(json_stringify(batch)==input_before,"batch unchanged");
 let saved=json_stringify(g);pair[0].layers[0].w[0][0]=900;batch[0][0]=0.99;
 check(json_stringify(g)==saved,"caller mutation cannot alter result");
 g.encoder[0].w[0][0]=800;check(pair[0].layers[0].w[0][0]==900,"result mutation cannot alter caller");
}
numerical(true,[[0.2,0.8]]);numerical(true,[[0.2,0.8],[0.7,0.1],[0.4,0.6]]);
numerical(false,[[0.3]]);numerical(false,[[0.3],[0.9],[0.1]]);
fn reject_call(pair,batch,label) {
 let got=try {T.gradients(pair[0],pair[1],batch);false;} catch true;
 check(got,label);
}
let p=fixtures(true);
reject_call(p,[],"empty batch");reject_call(p,nil,"nil batch");reject_call(p,[[]],"input width");
reject_call(p,[[true,0]],"boolean input");reject_call(p,[[0-0.01,0]],"negative input");
reject_call(p,[[1.01,0]],"input over one");reject_call(p,[[num_sqrt(0-1),0]],"NaN input");
reject_call(p,[[num_exp(1000),0]],"Inf input");reject_call(p,[[0-num_exp(1000),0]],"negative Inf input");
let many=[];let i=0;while i<17 {push(many,[0,0]);i=i+1;}reject_call(p,many,"batch cap");
let cyc=[];push(cyc,cyc);push(cyc,0);reject_call(p,[cyc],"cyclic input rejected without recursion");
p=fixtures(true);p[0].extra=true;reject_call(p,[[0,0]],"unknown model field");
p=fixtures(true);p[0].layers[0].extra=true;reject_call(p,[[0,0]],"unknown layer field");
p=fixtures(true);p[0].layers[0].w[0]=[];reject_call(p,[[0,0]],"ragged weights");
p=fixtures(true);p[0].layers[0].b=[];reject_call(p,[[0,0]],"bias shape");
p=fixtures(true);p[0].layers[0].w[0][0]=num_sqrt(0-1);reject_call(p,[[0,0]],"NaN weight");
p=fixtures(true);p[0].layers[0].b[0]=num_exp(1000);reject_call(p,[[0,0]],"Inf bias");
p=fixtures(true);p[0].layers[0].w[0][0]=10001;reject_call(p,[[0,0]],"weight magnitude");
p=fixtures(true);p[0].layers[0].n_in=17;reject_call(p,[[0,0]],"width cap");
p=fixtures(true);p[0].layers[0].n_in=1.5;reject_call(p,[[0,0]],"fractional width");
p=fixtures(true);p[0].layers[1].n_in=1;reject_call(p,[[0,0]],"internal shape");
p=fixtures(true);p[1]=p[0];reject_call(p,[[0,0]],"cross boundary shape");
p=fixtures(true);p[0].format="unknown";reject_call(p,[[0,0]],"format");
p=fixtures(true);p[0].layers=[];reject_call(p,[[0,0]],"empty model");
p=fixtures(true);p[0].layers=[nil];reject_call(p,[[0,0]],"nil layer");
fn wide_layer(width) {let ws=[];let bs=[];let o=0;while o<width {let row=[];let j=0;
 while j<width {push(row,0.01);j=j+1;}push(ws,row);push(bs,0);o=o+1;}
 return map{n_in:width,n_out:width,w:ws,b:bs};}
let w=wide_layer(16);let deep=model([w,w,w,w]);let inputs=[];let v=[];i=0;
while i<16 {push(v,0.5);push(inputs,v);i=i+1;}
reject_call([deep,deep],inputs,"work cap before numerical evaluation");
let allowed=[];i=0;while i<15 {push(allowed,v);i=i+1;}
let upper=T.gradients(deep,deep,allowed);
check(upper.parameter_sample_pairs==32640 and upper.parameters==2176,"largest widths and depths admitted below work cap");
reject_call([model([w,w,w,w,w]),deep],inputs,"depth cap");
let saturation=model([map{n_in:1,n_out:1,w:[[10000]],b:[10000]}]);
let saturated=T.gradients(saturation,saturation,[[1]]);
check(saturated.loss==0 and saturated.encoder[0].w[0][0]==0,"finite saturation valid zero gradient");
p=fixtures(true);p[0].layers[0].w[0]=p[0].layers[0].w;reject_call(p,[[0,0]],"cyclic weights rejected");
p=fixtures(true);p[0].layers=[p[0]];reject_call(p,[[0,0]],"cyclic model rejected");
let same=fixtures(false)[0];let reverse=fixtures(false)[1];
let repeated=T.gradients(same,reverse,[[0],[1]]);let repeated2=T.gradients(same,reverse,[[0],[1]]);
check(json_stringify(repeated)==json_stringify(repeated2),"deterministic no training state");
print json_stringify(map{status:"pbai_feedback_gradients_pass",checks:checks,
 max_parameter_error:max_error,max_directional_error:max_directional_error,min_encoder_l1:min_encoder_norm,parameter_errors:numerical_records,directional_errors:directional_records});
