// Test: pbAI BPE subword tokenizer (stdlib/pbai_bpe.sapp). Verifies the same contract
// as the char tokenizer (train/encode/decode/metadata) plus the BPE-specific wins:
// learned merges, fewer tokens than characters on repetitive text, and determinism.

let bpe = import("stdlib/pbai_bpe.sapp");

let corpus = "ab ab ab ab cd cd cd cd fn fn return return\n";
let tok = bpe.train(corpus, 50);

assert(tok.format == "pbai.tokenizer.bpe.v1", "BPE format is versioned");
assert(tok.num_merges > 0, "BPE learned at least one merge");
assert(tok.vocab_size > 4, "vocab includes specials, base chars, and merges");
assert(tok.special.pad == 0 and tok.special.bos == 1 and tok.special.eos == 2 and tok.special.unk == 3,
    "special tokens keep canonical ids 0..3");

// round-trip on in-vocabulary text
let text = "ab cd fn return";
let ids = bpe.encode(tok, text, false, false);
assert(bpe.decode(tok, ids) == text, "decode(encode(text)) round-trips exactly");
assert(len(bpe.tokenize(tok, text)) == len(ids), "tokenize returns one token per id");

// compression: merged subwords make the sequence shorter than the raw character count
let rep = "abababab";
let cids = bpe.encode(tok, rep, false, false);
assert(len(cids) < len(rep), "BPE encodes repetitive text in fewer tokens than characters");

// bos/eos wrapping and special-skipping decode
let wrapped = bpe.encode(tok, "ab", true, true);
assert(wrapped[0] == tok.special.bos and wrapped[len(wrapped) - 1] == tok.special.eos,
    "bos/eos wrap the encoded sequence");
assert(bpe.decode(tok, wrapped) == "ab", "decode skips special tokens by default");

// unknown characters map to <unk>
let unkids = bpe.encode(tok, "Z", false, false);
assert(unkids[0] == tok.special.unk, "unknown characters map to <unk>");

// determinism: same corpus -> identical merges and vocabulary
let tok2 = bpe.train(corpus, 50);
assert(tok2.vocab_size == tok.vocab_size and tok2.num_merges == tok.num_merges,
    "BPE training is deterministic");

// metadata contract
let meta = bpe.metadata(tok);
assert(meta.format == "pbai.tokenizer.bpe.v1" and meta.vocab_size == tok.vocab_size,
    "metadata reports the BPE format and vocab size");

print "pbai_bpe_pass";
