let cache = import("stdlib/pbai_cache.sapp");

let clear = cache.clear_kind("semantic-test");
assert(clear.format == "pbai.cache.clear.v1", "cache clear contract is versioned");

let wrote = cache.put("semantic-test", "hello", map{ value: 42 });
assert(wrote.ok and str_contains(wrote.path, "target/pbai-cache"), "cache writes JSON entries under target");
assert(cache.has("semantic-test", "hello"), "cache can report a hit");
let got = cache.get("semantic-test", "hello");
assert(got.value == 42, "cache retrieves stored JSON value");

let safe_key = cache.key("../semantic test", "x");
assert(str_contains(safe_key, "semantictest-") and not str_contains(safe_key, "/"), "cache normalizes kind names before using paths");
let unsafe_write = cache.put("../semantic test", "x", map{ safe: true });
assert(str_contains(unsafe_write.path, "target/pbai-cache/semantictest/"), "cache writes normalized kinds under the cache root");
assert(cache.has("semantictest", "x"), "cache normalized writes can be read by normalized kind");

let st = cache.status();
assert(st.format == "pbai.cache.status.v1" and st.total_entries >= 1, "cache status reports entries");

let removed = cache.clear_kind("semantic-test");
assert(removed.removed >= 1, "cache kind clear removes entries");
cache.clear_kind("semantictest");

print "pbai_cache_pass";
