// Test: pbAI generative sampling — temperature + top-k + repetition penalty with a
// deterministic seeded RNG (stdlib/pbai_lm.sapp). Greedy argmax collapses a tiny LM
// into loops; sampling must stay valid, in-vocabulary, and reproducible for a fixed
// seed so it can be used in tests and the live console.

let lm = import("stdlib/pbai_lm.sapp");

let corpus = "let x; let y; let z; let w; ";
let v = lm.vocab_build(corpus);
let ids = lm.encode(v, corpus);
let m = lm.model_new(v.size, 4, 8, 2, 1);
lm.train(m, ids, 25, 0.2);

// (a) deterministic: identical seed -> identical sample
let a = lm.generate_sampled(m, v, "let", 12, 0.8, 0, 7, 0);
let b = lm.generate_sampled(m, v, "let", 12, 0.8, 0, 7, 0);
assert(a == b, "sampling is deterministic for a fixed seed");

// (b) shape + vocabulary safety
assert(len(a) == 3 + 12, "sampled generation appends exactly n characters to the seed");
assert(len(lm.encode(v, a)) == len(a), "every sampled character is in the vocabulary");

// (c) top-k truncation still produces valid in-vocab text
let d = lm.generate_sampled(m, v, "let", 16, 0.9, 3, 5, 0.5);
assert(len(d) == 3 + 16, "top-k sampled generation has the right length");
assert(len(lm.encode(v, d)) == len(d), "top-k sampling stays in the vocabulary");

// (d) the seeded RNG is reproducible and advances within ~[0,1)
let r = lm.rng_new(123);
let u = lm.sample_next_id(m, [0, 0], r, 0.7, 4, nil, 0);
assert(u >= 0 and u < v.size, "sample_next_id returns a valid token id");

// (e) low-temperature sampling stays deterministic and in-vocabulary
let cold1 = lm.generate_sampled(m, v, "let", 10, 0.02, 0, 1, 0);
let cold2 = lm.generate_sampled(m, v, "let", 10, 0.02, 0, 1, 0);
assert(cold1 == cold2, "low-temperature sampling is still deterministic");
assert(len(lm.encode(v, cold1)) == len(cold1), "low-temperature sampling stays in the vocabulary");

print "pbai_sampling_pass";
