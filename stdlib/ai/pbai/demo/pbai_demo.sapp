// demo/pbai_demo.sapp -- JSON fixture generator for the pbAI web test harness.
//
// Run from ai/pbai:
//   ../../pl-dev/pblang/target/debug/pblang run demo/pbai_demo.sapp --allow-all > website/data/pbai-demo.json

let pbai = import("stdlib/pbai.sapp");
let tokmod = import("stdlib/pbai_tokenizer.sapp");
let brain = import("stdlib/pbai_brain.sapp");

let sample = "Find bugs:\n\n--- pblang code ---\nfn risky(path) { let s = fs_read(path); print(s); return s; }";
let tok = tokmod.train_default();

let payload = map{
    generated_at: "2026-06-07",
    sample: sample,
    status: pbai.model_status(),
    analysis: pbai.analyze(sample),
    response: pbai.respond(sample),
    generated: pbai.generate("fn ", 32),
    thought: pbai.think("what pbAI brain memory plan exists?", "pbai_brain_pass"),
    tokenizer: map{
        description: tokmod.describe(tok),
        ids: tokmod.encode(tok, "fn ", true, true),
        tokens: tokmod.tokenize(tok, "fn ", true, true),
        decoded: tokmod.decode(tok, tokmod.encode(tok, "fn ", true, true))
    },
    brain_direct: brain.run(sample, "pbai_demo_pass")
};

print json_stringify(payload);
