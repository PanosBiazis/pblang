let S=import("stdlib:task_scope.sapp");let D=import("stdlib:task_plan.sapp");let F=import("stdlib:task_plan_files.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
fn sample() {let doc=D.create("Workshop work packages","2026-09-27");doc=D.edit(doc,"task_1","Outline",2,[]);doc=D.append(doc);doc=D.edit(doc,"task_2","Prepare materials",3,["task_1"]);doc=D.append(doc);return D.edit(doc,"task_3","Independent publicity",1,[]);}
fn _body(task) {return task.id+" | "+task.label+"\n"+task.start+" -> "+task.due+" | "+task.status+" | "+str(task.days)+" days";}
fn view(doc,targets,index=0) {
 let scoped=S.extract(doc,targets);let report=D.schedule(scoped);
 if type(index)!="number" or not(index>=0 and index<len(report.tasks)) or index!=num_floor(index) {throw "invalid task index";}
 let text=_body(report.tasks[index]);return UI.screen([UI.heading("PBTaskScope"),UI.text(scoped.title),UI.text("Task "+str(index+1)+" / "+str(len(scoped.tasks))+" | includes required prerequisites"),UI.area(text,map{name:"task",readonly:true,h:200}),UI.row([UI.button("Show",UI.action_set_text("task",text)),UI.button("Hide",UI.action_set_text("task","Task hidden."))]),UI.text("Independent plan copy. Calendar-day estimates; no task execution or progress sync.")]);
}
fn _message(form,text){let w=G.get(form,"status");w.text=text;form.dirty=true;}
fn refresh(form,state){let schedule=D.schedule(state.doc);let task=schedule.tasks[state.index];let body=G.get(form,"task");body.value=_body(task);let summary=G.get(form,"summary");summary.text=str(len(state.targets))+" selected + "+str(len(state.doc.tasks)-len(state.targets))+" prerequisites | task "+str(state.index+1)+" / "+str(len(state.doc.tasks));_message(form,"Applied selection. Export a new independent plan copy.");}
fn act(form,state,action){
 if action=="previous" or action=="next" {state.index=num_max(0,num_min(len(state.doc.tasks)-1,state.index+(if action=="next" {1} else {-1})));refresh(form,state);return;}
 if action=="open" or action=="apply" {
  let path=G.get(form,"source").value;let doc=state.source;
  if action=="apply" and path!=state.source_path {_message(form,"Open the changed source path before applying a selection.");return;}
  if action=="open" {let loaded=F.open(path);if not loaded.ok {_message(form,loaded.error);return;}doc=loaded.document;}
  let text=G.get(form,"ids").value;let ids=try S.parse_ids(text) catch nil;let scoped=nil;if ids!=nil {scoped=try S.extract(doc,ids) catch nil;}
  if scoped==nil {_message(form,"Invalid or unknown task IDs. Previous preview retained.");return;}
  state.source=doc;state.source_path=path;state.doc=scoped;state.targets=ids;state.text=text;state.index=0;refresh(form,state);return;
 }
 if action=="save" {
  if G.get(form,"ids").value!=state.text or G.get(form,"source").value!=state.source_path {_message(form,"Open/apply changed inputs before exporting.");return;}
  let saved=F.save(G.get(form,"output").value,state.doc);if not saved.ok {_message(form,saved.error);return;}_message(form,"New scoped plan saved. Source and its progress unchanged.");
 }
}
fn _button(state,label,action){return UI.button(label,fn(f){act(f,state,action);},map{name:action});}
fn build(){let doc=sample();let state=map{source:doc,source_path:"",doc:S.extract(doc,["task_2"]),targets:["task_2"],text:"task_2",index:0};let form=UI.build("PBTaskScope",UI.screen([
 UI.heading("PBTaskScope - focused project copies"),UI.text("Choose tasks; required prerequisites are included automatically."),
 UI.input("",map{name:"source",placeholder:"Source .pbplan",max_chars:4096}),UI.input("task_2",map{name:"ids",placeholder:"Task IDs separated by commas",max_chars:1600}),
 UI.row([_button(state,"Open and preview","open"),_button(state,"Apply selection","apply")]),UI.text("",map{name:"summary"}),UI.area("",map{name:"task",readonly:true,h:230}),
 UI.row([_button(state,"Previous task","previous"),_button(state,"Next task","next")]),UI.input("",map{name:"output",placeholder:"New .pbplan output",max_chars:4096}),_button(state,"Export scoped plan","save"),UI.text("",map{name:"status"}),UI.text("Copies keep IDs, dependencies and completion. Later progress is not synchronized.")]),map{width:1100,height:950,theme:"dark"});refresh(form,state);return map{form:form,state:state};}
fn run(){let e=build();G.run(e.form);}
export sample,view,refresh,act,build,run;
