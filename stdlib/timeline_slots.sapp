// Pure free-slot projection; source labels/title are deliberately omitted.
let T=import("stdlib:timeline_document.sapp");let I=import("stdlib:interval_analysis.sapp");
fn find(doc,start_ms,end_ms,minimum_ms=1){T.validate(doc);let intervals=[];for item in doc.entries{array_push(intervals,map{start_ms:item.start_ms,end_ms:item.end_ms});}return I.free_windows(intervals,start_ms,end_ms,minimum_ms);}
fn _index(index,count){if type(index)!="number" or not(index>=0 and index<count) or index!=num_floor(index){throw "timeline slots: invalid slot index";}}
// Generic labels make this an independent planning copy, never a reservation.
fn to_timeline(doc,start_ms,end_ms,minimum_ms=1,index=nil){
    let report=find(doc,start_ms,end_ms,minimum_ms);let slots=report.slots;
    if index!=nil {_index(index,len(slots));slots=[slots[index]];}
    if len(slots)<1 or len(slots)>T.MAX_ENTRIES {throw "timeline slots: export requires 1 to 64 slots";}
    let entries=[];for i in range(0,len(slots)){let slot=slots[i];let number=if index==nil {i+1} else {index+1};array_push(entries,map{label:"Free slot "+str(number),start_ms:slot.start_ms,end_ms:slot.end_ms});}
    let result=map{format:T.FORMAT,title:"Available time slots",entries:entries};T.validate(result);return result;
}
export find,to_timeline;
