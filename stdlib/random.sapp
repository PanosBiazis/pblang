// stdlib/random.sapp — Seeded, reproducible pseudo-random generation (pure pblang).
//
// A generator is a tiny mutable map { s: <state> }. The same seed always yields
// the same stream, on any platform, with no Rust dependency — the engine is the
// Numerical Recipes LCG (multiplier 1664525, increment 1013904223, modulus 2^32),
// whose largest intermediate product (~7.15e15) stays under f64's exact-integer
// ceiling (2^53 ≈ 9.0e15), so every step is computed exactly.
//
// Usage:
//   let rng = import("stdlib:random.sapp");
//   let g = rng.seed(42);
//   rng.random(g);            // float in [0, 1)
//   rng.randint(g, 1, 6);     // integer die roll in [1, 6]
//   rng.shuffle(g, deck);     // permuted COPY (original untouched)

let _PI = 3.141592653589793;
let _MOD = 4294967296;   // 2^32
let _MUL = 1664525;
let _INC = 1013904223;

// local cos via Taylor (keeps this module dependency-free)
fn _cos(x) {
    let x = num_mod(x, 2 * _PI);
    let term = 1;
    let result = 1;
    for i in 1 to 12 {
        term = term * (0 - x * x) / ((2 * i - 1) * (2 * i));
        result = result + term;
    }
    return result;
}

// seed(s) → a fresh generator. Non-integer / negative seeds are normalized.
fn seed(s) {
    let v = num_floor(num_abs(s));
    v = num_mod(v, _MOD);
    return map{ s: v };
}

// advance the generator one step and return the new 32-bit state (mutates g)
fn _step(g) {
    g.s = num_mod(_MUL * g.s + _INC, _MOD);
    return g.s;
}

// next_u32(g) → integer in [0, 2^32)
fn next_u32(g) { return _step(g); }

// random(g) → float in [0, 1)
fn random(g) { return _step(g) / _MOD; }

// uniform(g, lo, hi) → float in [lo, hi)
fn uniform(g, lo, hi) { return lo + (hi - lo) * random(g); }

// randint(g, lo, hi) → integer in [lo, hi] inclusive
fn randint(g, lo, hi) {
    let span = hi - lo + 1;
    return lo + num_floor(random(g) * span);
}

// internal: shallow copy of an array
fn _copy(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) { push(out, arr[i]); i = i + 1; }
    return out;
}

// choice(g, arr) → a uniformly random element
fn choice(g, arr) {
    return arr[randint(g, 0, len(arr) - 1)];
}

// shuffle(g, arr) → a permuted COPY (Fisher–Yates); original is untouched
fn shuffle(g, arr) {
    let out = _copy(arr);
    let i = len(out) - 1;
    while i > 0 {
        let j = randint(g, 0, i);
        let tmp = out[i];
        out[i] = out[j];
        out[j] = tmp;
        i = i - 1;
    }
    return out;
}

// sample(g, arr, k) → k distinct elements (random, without replacement)
fn sample(g, arr, k) {
    let out = _copy(arr);
    let n = len(out);
    if k > n { k = n; }
    let i = 0;
    while i < k {
        let j = randint(g, i, n - 1);
        let tmp = out[i];
        out[i] = out[j];
        out[j] = tmp;
        i = i + 1;
    }
    let res = [];
    let m = 0;
    while m < k { push(res, out[m]); m = m + 1; }
    return res;
}

// normal(g, mu, sigma) → a Gaussian draw via Box–Muller
fn normal(g, mu, sigma) {
    let u1 = random(g);
    if u1 < 0.000000000001 { u1 = 0.000000000001; }   // guard ln(0)
    let u2 = random(g);
    let z = num_sqrt(0 - 2 * num_ln(u1)) * _cos(2 * _PI * u2);
    return mu + sigma * z;
}

// exponential(g, rate) → a draw from Exponential(rate>0), via inverse CDF
fn exponential(g, rate) {
    let u = random(g);
    if u < 0.000000000001 { u = 0.000000000001; }
    return (0 - num_ln(u)) / rate;
}

// from_quantile(g, qf) → inverse-transform sample: feed a uniform draw into ANY
// quantile (inverse-CDF) function. Pair with prob.normal_ppf / exp_ppf / etc. to
// sample from any distribution whose quantile you can compute.
fn from_quantile(g, qf) { return qf(random(g)); }

// poisson(g, lambda) → a Poisson-distributed count via Knuth's algorithm
fn poisson(g, lambda) {
    let l = num_exp(0 - lambda);
    let k = 0;
    let p = 1;
    while true {
        k = k + 1;
        p = p * random(g);
        if p <= l { return k - 1; }
    }
}

// binomial(g, n, p) → number of successes in n independent Bernoulli(p) trials
fn binomial(g, n, p) {
    let c = 0;
    let i = 0;
    while i < n {
        if random(g) < p { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// bernoulli(g, p) → 1 with probability p, else 0.
fn bernoulli(g, p) {
    if random(g) < p { return 1; }
    return 0;
}

// weighted_choice(g, items, weights) → an item chosen with probability
// proportional to its weight (zero-weight items are never chosen).
fn weighted_choice(g, items, weights) {
    let total = 0;
    let i = 0;
    while i < len(weights) { total = total + weights[i]; i = i + 1; }
    let r = random(g) * total;
    let acc = 0;
    i = 0;
    while i < len(items) {
        acc = acc + weights[i];
        if r < acc { return items[i]; }
        i = i + 1;
    }
    return items[len(items) - 1];
}

// randoms(g, n) → array of n floats in [0, 1).
fn randoms(g, n) {
    let out = [];
    let i = 0;
    while i < n { push(out, random(g)); i = i + 1; }
    return out;
}

// randints(g, lo, hi, n) → array of n integers in [lo, hi].
fn randints(g, lo, hi, n) {
    let out = [];
    let i = 0;
    while i < n { push(out, randint(g, lo, hi)); i = i + 1; }
    return out;
}

// geometric(g, p) → number of Bernoulli(p) trials until the first success (>= 1).
fn geometric(g, p) {
    if p <= 0 { return error("random.geometric: p must be > 0"); }
    let k = 1;
    while random(g) >= p { k = k + 1; }
    return k;
}

// bytes(g, n) → array of n random bytes (0..255).
fn bytes(g, n) {
    let out = [];
    let i = 0;
    while i < n { push(out, randint(g, 0, 255)); i = i + 1; }
    return out;
}

export seed, next_u32, random, uniform, randint, choice, shuffle, sample,
       normal, exponential, from_quantile, poisson, binomial,
       bernoulli, weighted_choice, randoms, randints, geometric, bytes;
