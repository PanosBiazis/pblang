// stdlib/gpio.sapp — Linux sysfs GPIO driver in pure pblang (robotics/embedded).
//
// Harvested from the LightLedRasPi project: drive LEDs/relays/buttons on a
// Raspberry Pi (or any board exposing /sys/class/gpio) with NO Rust and no
// C library — the sysfs protocol is just files, and pblang can read/write
// files. Same pattern as stdlib/device.sapp (use kernel drivers via /sys).
//
//   let GP = import("stdlib:gpio.sapp");
//   let g = GP.new(GP.sysfs_backend());   // real hardware
//   GP.export_pin(g, 17);
//   GP.set_direction(g, 17, "out");
//   GP.write_pin(g, 17, 1);               // LED on
//
// The backend is INJECTABLE ({read: fn(path), write: fn(path, text)}), so all
// protocol logic is unit-testable on machines with no GPIO. Honest boundary:
// sysfs GPIO needs permissions (gpio group or root) and is the legacy-but-
// ubiquitous interface. `linux_device_handle.sapp` now supplies the bounded
// character-device/ioctl boundary; GPIO line-request structures still need a
// dedicated high-level gpiod adapter before this module can use it.

let BASE = "/sys/class/gpio";
let MAX_PIN = 1000000;
let MAX_PLAN_CYCLES = 2048;
let MAX_DURATION_MS = 60000;
let MAX_SAFE_INTEGER = 9007199254740991;

fn _finite(value, minimum, maximum, label) {
    if type(value) != "number" {
        throw "gpio: " + label + " must be in " + str(minimum) + ".." + str(maximum);
    }
    let normalized = value + 0;
    if normalized != value or value < minimum or value > maximum {
        throw "gpio: " + label + " must be in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _whole(value, minimum, maximum, label) {
    let checked = _finite(value, minimum, maximum, label);
    if checked != num_floor(checked) { throw "gpio: " + label + " must be a whole number"; }
    return checked;
}

fn _binary(value, label) {
    if value != 0 and value != 1 { throw "gpio: " + label + " must be 0 or 1"; }
    return value;
}

// new(backend) -> handle. backend: { read: fn(path)->text, write: fn(path, text) }.
fn new(backend) { return map{ be: backend }; }

// sysfs_backend() — the real filesystem-backed backend (absolute sysfs paths).
fn sysfs_backend() {
    return map{
        read: fn(p) { return fs_read(p); },
        write: fn(p, t) { return fs_write(p, t); },
    };
}

fn _check_pin(pin) {
    _whole(pin, 0, MAX_PIN, "pin");
    return nil;
}

// export_pin(g, pin) — ask the kernel to expose /sys/class/gpio/gpioN.
fn export_pin(g, pin) {
    _check_pin(pin);
    let w = g.be.write;
    w(BASE + "/export", str(pin));
    return nil;
}

// unexport_pin(g, pin) — release the pin back to the kernel.
fn unexport_pin(g, pin) {
    _check_pin(pin);
    let w = g.be.write;
    w(BASE + "/unexport", str(pin));
    return nil;
}

// set_direction(g, pin, dir) — "in" or "out" only.
fn set_direction(g, pin, dir) {
    _check_pin(pin);
    if dir != "in" and dir != "out" {
        throw "gpio: direction must be 'in' or 'out', got " + str(dir);
    }
    let w = g.be.write;
    w(BASE + "/gpio" + str(pin) + "/direction", dir);
    return nil;
}

// write_pin(g, pin, v) — v must be 0 or 1.
fn write_pin(g, pin, v) {
    _check_pin(pin);
    if v != 0 and v != 1 { throw "gpio: value must be 0 or 1, got " + str(v); }
    let w = g.be.write;
    w(BASE + "/gpio" + str(pin) + "/value", str(v));
    return nil;
}

// read_pin(g, pin) -> 0|1. Tolerates the trailing newline sysfs emits.
fn read_pin(g, pin) {
    _check_pin(pin);
    let r = g.be.read;
    let raw = str_trim(r(BASE + "/gpio" + str(pin) + "/value"));
    if raw == "1" { return 1; }
    if raw == "0" { return 0; }
    throw "gpio: unexpected value '" + raw + "' on pin " + str(pin);
}

// blink_plan(pin, times, ms) — a PURE [{pin, value, ms}] schedule (on/off pairs)
// that any executor (loop + sleep, watcher, wokwi-style simulator) can replay.
fn blink_plan(pin, times, ms) {
    _check_pin(pin);
    let bounded_times = _whole(times, 0, MAX_PLAN_CYCLES, "blink times");
    let bounded_ms = _finite(ms, 0.001, MAX_DURATION_MS, "blink duration_ms");
    let out = [];
    let i = 0;
    while i < bounded_times {
        push(out, map{ pin: pin, value: 1, ms: bounded_ms });
        push(out, map{ pin: pin, value: 0, ms: bounded_ms });
        i = i + 1;
    }
    return out;
}

// pwm_plan(pin, duty_pct, period_ms, cycles) — a PURE software-PWM schedule:
// each cycle is on for duty% of the period, off for the rest. For LEDs and
// servo-ish dimming via any executor; real hardware PWM needs the pwmchip
// sysfs interface (different files, same backend pattern).
fn pwm_plan(pin, duty_pct, period_ms, cycles) {
    _check_pin(pin);
    let duty = _finite(duty_pct, 0, 100, "duty_pct");
    let period = _finite(period_ms, 0.001, MAX_DURATION_MS, "PWM period_ms");
    let bounded_cycles = _whole(cycles, 0, MAX_PLAN_CYCLES, "PWM cycles");
    let on_ms = period * duty / 100;
    let off_ms = period - on_ms;
    let out = [];
    let i = 0;
    while i < bounded_cycles {
        push(out, map{ pin: pin, value: 1, ms: on_ms });
        push(out, map{ pin: pin, value: 0, ms: off_ms });
        i = i + 1;
    }
    return out;
}

// ── debounce: pure state machine for mechanical switches ──────────────────────
// A raw input must hold a new level for stable_ms before the debounced value
// flips; shorter flickers (contact bounce) are ignored. Pure: step returns a
// NEW state, so it composes with any polling loop or event source.
fn debounce_new(initial, stable_ms) {
    let level = _binary(initial, "initial level");
    let window = _finite(stable_ms, 0.001, MAX_DURATION_MS, "debounce stable_ms");
    return map{ value: level, candidate: level, since_ms: 0,
        stable_ms: window, last_ms: 0 };
}

fn debounce_step(state, raw, now_ms) {
    if type(state) != "map" { throw "gpio: debounce state must be a map"; }
    let level = _binary(raw, "raw level");
    let now = _finite(now_ms, 0, MAX_SAFE_INTEGER, "debounce now_ms");
    let last = try state.last_ms catch 0;
    if now < last { throw "gpio: debounce time must be monotonic"; }
    _binary(try state.value catch nil, "debounced level");
    _binary(try state.candidate catch nil, "candidate level");
    _finite(try state.stable_ms catch nil, 0.001, MAX_DURATION_MS, "debounce stable_ms");
    let value = state.value;
    let candidate = state.candidate;
    let since = state.since_ms;
    if level == value {
        candidate = level;
        since = now;
    } else if level != candidate {
        candidate = level;
        since = now;
    } else if now - since >= state.stable_ms {
        value = level;
    }
    return map{ value: value, candidate: candidate, since_ms: since,
        stable_ms: state.stable_ms, last_ms: now };
}

// servo_plan(pin, angle_deg, cycles) — standard hobby-servo schedule: 50Hz
// (20ms) frames with a 1ms (0 deg) .. 2ms (180 deg) pulse. Software timing via
// sysfs is jittery — fine for rough positioning, not for precision.
fn servo_plan(pin, angle_deg, cycles) {
    _check_pin(pin);
    let angle = _finite(angle_deg, 0, 180, "servo angle");
    let bounded_cycles = _whole(cycles, 0, MAX_PLAN_CYCLES, "servo cycles");
    let pulse = 1.0 + angle / 180.0;
    let out = [];
    let i = 0;
    while i < bounded_cycles {
        push(out, map{ pin: pin, value: 1, ms: pulse });
        push(out, map{ pin: pin, value: 0, ms: 20.0 - pulse });
        i = i + 1;
    }
    return out;
}

export new, sysfs_backend, export_pin, unexport_pin, set_direction, write_pin, read_pin, blink_plan, pwm_plan;
export debounce_new, debounce_step, servo_plan;
