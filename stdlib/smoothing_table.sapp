let Series=import("stdlib:sample_series.sapp");let Sheet=import("stdlib:sheet_document.sapp");let Decimal=import("stdlib:measure_table.sapp");
fn window(text){if type(text)!="string" or len(text)>16 {throw "window requires an integer from 1 to 31";}let token=str_trim(text);if len(token)<1 or len(token)>2 {throw "window requires 1-31";}for i in range(0,len(token)){if not str_contains("0123456789",str_slice(token,i,i+1)){throw "window requires digits";}}let n=parse_number(token);if n<1 or n>31 {throw "window requires 1-31";}return n;}
fn create(labels,values,count){
 if type(labels)!="array" or type(values)!="array" or len(labels)!=len(values) or len(labels)<1 or len(labels)>31 {throw "one label per sample, 1-31 samples";}
 let input=Sheet.create(len(labels)+1,2);input.cells[0]=["Label","Value"];
 for i in range(0,len(labels)){input.cells[i+1]=[labels[i],str(values[i])];}Sheet.validate(input);
 let result=Series.moving_mean(values,count);let cells=[["First","Last","From label","To label","Mean"]];
 for i in range(0,len(result.values)){let last=i+count-1;array_push(cells,[str(i+1),str(last+1),labels[i],labels[last],str(result.values[i])]);}
 let doc=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(doc);
 return map{format:"pblang.smoothing-table.v1",document:doc,window:count,samples:len(values),rows:len(result.values)};
}
fn from_sheet(doc,count){let size=Sheet.validate(doc);if size.columns!=2 or size.rows<2 or doc.cells[0]!=["Label","Value"] {throw "exact Label,Value header and samples required";}let labels=[];let values=[];for i in range(1,size.rows){array_push(labels,doc.cells[i][0]);array_push(values,Decimal.parse_value(doc.cells[i][1]));}return create(labels,values,count);}
export window,create,from_sheet;
