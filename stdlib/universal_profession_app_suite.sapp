    ];
}

fn find_profession_spec(profession_id) {
    if type(profession_id) == "map" {
        let cid = str_lower(str_trim(str(try profession_id.id catch "custom_domain_specialty")));
        let ctitle = str_trim(str(try profession_id.title_el catch ("Εξειδικευμένη Εφαρμογή: " + cid)));
        return map{
            found: true,
            dynamically_synthesized: true,
            sector_id: str_trim(str(try profession_id.sector_id catch "sector_custom_generalized")),
            sector_title_el: str_trim(str(try profession_id.sector_title_el catch "Γενικευμένος Τομέας & Εξειδικευμένα Επαγγέλματα")),
            default_theme: str_trim(str(try profession_id.default_theme catch "obsidian_aurora_glass")),
            categories: try profession_id.categories catch ["Δυναμική Κατηγορία", "Αυτοματισμός Ροών", "Ασφάλεια & Αναφορές"],
            specialization: map{
                id: cid,
                title_el: ctitle,
                kpi_label: str_trim(str(try profession_id.kpi_label catch "Δείκτης Απόδοσης Ειδικότητας")),
                sample_metric: str_trim(str(try profession_id.sample_metric catch "99.9% Ακρίβεια & Ταχύτητα"))
            }
        };
    }
    let raw_str = str_trim(str(profession_id));
    let target = str_lower(raw_str);
    let catalog = profession_taxonomy_catalog();
    let s = 0;
    while s < len(catalog) {
        let sec = catalog[s];
        let specs = sec.specializations;
        let p = 0;
        while p < len(specs) {
            if specs[p].id == target or sec.sector_id == target or str_contains(str_lower(specs[p].title_el), target) {
                return map{
                    found: true,
                    dynamically_synthesized: false,
                    sector_id: sec.sector_id,
                    sector_title_el: sec.sector_title_el,
                    default_theme: sec.default_theme,
                    categories: sec.categories,
                    specialization: specs[p]
                };
            }
            p = p + 1;
        }
        s = s + 1;
    }
    // Generalized dynamic synthesis for ANY unseen profession/specialty!
    let slug = str_replace_all(target, " ", "_");
    if slug == "" { slug = "general_profession"; }
    return map{
        found: true,
        dynamically_synthesized: true,
        sector_id: "sector_dynamic_" + slug,
        sector_title_el: "Δυναμικός Τομέας: " + raw_str,
        default_theme: "obsidian_aurora_glass",
        categories: ["Κύρια Ροή Εργασίας", "Αναλυτικά KPIs & Έγγραφα", "AI Co-Designer & Zero-Trust"],
        specialization: map{
            id: slug,
            title_el: if raw_str != "" { raw_str } else { "Γενικευμένη Επαγγελματική Σουίτα" },
            kpi_label: "Επιχειρησιακή Απόδοση (" + raw_str + ")",
            sample_metric: "100% Αυτόματη & Επαληθευμένη"
        }
    };
}

fn build_integrated_support_suite(prof_entry) {
    let spec = prof_entry.specialization;
    return map{
        interactive_guided_demo: map{
            enabled: true,
            mode: "one_click_live_sandbox",
            steps: [
                "Βήμα 1: Φόρτωση ρεαλιστικών συνθετικών δεδομένων για «" + spec.title_el + "» (100% Offline & Ιδιωτικά).",
                "Βήμα 2: Αυτόματη ανάλυση, επικύρωση κανόνων ειδικότητας και εμφάνιση KPI («" + spec.kpi_label + ": " + spec.sample_metric + "»).",
                "Βήμα 3: Ενεργοποίηση του ενσωματωμένου pbAI Co-Designer για αυτόματη συμπλήρωση φορμών, αναφορών και ειδοποιήσεων.",
                "Βήμα 4: Εξαγωγή αποτελεσμάτων σε PDF / CSV / HTML Dashboard ή αποστολή μέσω Zero-Trust καναλιού."
            ]
        },
        contextual_ai_help_assistant: map{
            enabled: true,
            engine: "pblang_embedded_ai_plus_pbai",
            instant_tooltips: true,
            shortcut: "F1 / Ctrl+/",
            welcome_prompt_el: "Γεια σας! Είμαι ο ενσωματωμένος βοηθός για την ειδικότητα «" + spec.title_el + "». Πατήστε σε οποιοδήποτε πεδίο ή ρωτήστε με πώς να ολοκληρώσετε τη ροή σε 1 κλικ."
        },
        integrated_live_manual: map{
            enabled: true,
            languages: ["el", "en"],
            sections: [
                "1. Γρήγορη Εκκίνηση σε 60 Δευτερόλεπτα (Zero-Admin Portable ή Υπηρεσία)",
                "2. Αναλυτικός Οδηγός Ειδικότητας: " + spec.title_el,
                "3. Παραμετροποίηση UI (12 Flagship Themes, Sketch-to-UI & Visual Blocks/Flowcharts)",
                "4. Ασφάλεια, Απόρρητο, Κρυπτογράφηση & Zero-Trust Δικαιώματα",
                "5. Συντομεύσεις Πληκτρολογίου & Αυτόματος Διαγνωστικός Έλεγχος (Doctor)"
            ],
            printable_html_and_pdf_ready: true
        },
        built_in_security_and_doctor: map{
            enabled: true,
            zero_admin_portable_supported: true,
            secret_redaction_active: true,
            transport_guard_tls13: true,
            static_security_gate_verified: true
        }
    };
}

fn instantiate_profession_app(profession_id, edition_target = "all_editions", theme_override = "") {
    let entry = find_profession_spec(profession_id);
    let spec = entry.specialization;
    let theme_id = if str_trim(str(theme_override)) != "" { str_trim(str(theme_override)) } else { entry.default_theme };
    let tokens = Wave7.resolve_design_tokens(theme_id);
    let support = build_integrated_support_suite(entry);

    let view = UI.screen([
        UI.heading(spec.title_el, map{
            name: "prof_title",
            tone: "accent",
            font_size: 26,
            font_weight: "bold"
        }),
        UI.text(entry.sector_title_el + "  │  Θέμα: " + tokens.theme_id + "  │  Έκδοση: Πλήρης Πολυ-Πλατφορμική Σουίτα", map{
            name: "prof_subtitle",
            tone: "muted",
            wrap: true
        }),
        Wave7.command_palette("Αναζήτηση στην εφαρμογή «" + spec.title_el + "», Βοήθεια (F1), Interactive Demo ή Εντολή AI (Ctrl+K)...", [
            "▶ Εκκίνηση Interactive Guided Demo",
            "📖 Άνοιγμα Ενσωματωμένου Εγχειριδίου (Manual)",
            "🤖 Ερώτηση στον Ενσωματωμένο Βοηθό pbAI",
            "🎨 Προσαρμογή UI με Ζωγραφική / Blocks / Flowchart",
            "🛡️ Έλεγχος Ασφαλείας & Απορρήτου (Doctor)"
        ], map{ name: "prof_cmd_bar" }),
        UI.grid([
            Wave7.kpi_card(spec.kpi_label, spec.sample_metric, "Verified", [65, 74, 82, 91, 99], map{ name: "prof_kpi_main" }),
            Wave7.kpi_card("Ασφάλεια & Απόρρητο", "Zero-Trust Ready", "100% Ιδιωτικό", [100, 100, 100, 100, 100], map{ name: "prof_kpi_sec" }),
            Wave7.kpi_card("Ενσωματωμένη Υποστήριξη", "Demo + Manual + AI", "4 Συστήματα Ενεργά", [80, 88, 94, 98, 100], map{ name: "prof_kpi_help" })
        ], map{ name: "prof_kpi_grid", columns: 3, gap: 14 }),
        Wave7.step_wizard("Ενσωματωμένος Οδηγός & Interactive Demo (" + spec.id + ")", support.interactive_guided_demo.steps, 2, map{ name: "prof_demo_wizard" }),
        Wave7.smart_data_grid("Ενότητες Εφαρμογής & Ενσωματωμένου Εγχειριδίου", [
            "Ενότητα", "Κατάσταση", "Περιγραφή"
        ], [
            ["Κύριος Πίνακας Εργασίας", "ΕΝΕΡΓΟ", spec.title_el],
            ["Interactive Demo Sandbox", "ΕΤΟΙΜΟ", "Ζωντανή προσομοίωση με ρεαλιστικά δεδομένα χωρίς κίνδυνο"],
            ["Ενσωματωμένο Manual (EL/EN)", "ΕΤΟΙΜΟ", str(len(support.integrated_live_manual.sections)) + " πλήρη κεφάλαια με αναζήτηση"],
            ["AI Co-Designer & Βοήθεια", "ΕΝΕΡΓΟ", support.contextual_ai_help_assistant.welcome_prompt_el]
        ], map{ name: "prof_modules_grid" }),
        Wave7.ai_copilot_dock("Βοηθός Ειδικότητας & Αυτόματος Σχεδιαστής UI (" + spec.id + ")", "Εκτέλεση αυτόματης ροής εργασίας και εμφάνιση οδηγιών βήμα-προς-βήμα", map{ name: "prof_ai_dock" })
    ], map{
        name: "prof_root_" + spec.id,
        padding: 18,
        gap: 14
    });

    let desktop_bundle = UI.compile(view, UI.theme_options(theme_id, map{ target: "desktop", width: 1280, height: 840 }));
    let web_bundle = UI.compile(view, UI.theme_options(theme_id, map{ target: "web", width: 1280, height: 840 }));
    let android_bundle = UI.compile(view, UI.theme_options(theme_id, map{ target: "android", width: 412, height: 915 }));

    return map{
        ok: len(desktop_bundle.records) > 0 and len(web_bundle.records) > 0 and len(android_bundle.records) > 0,
        sector_id: entry.sector_id,
        sector_title_el: entry.sector_title_el,
        profession_id: spec.id,
        profession_title_el: spec.title_el,
        edition_requested: edition_target,
        supported_editions: supported_app_editions(),
        active_theme: tokens.theme_id,
        view: view,
        compiled_editions: map{
            desktop_native_records: len(desktop_bundle.records),
            web_studio_pwa_records: len(web_bundle.records),
            mobile_android_ios_records: len(android_bundle.records),
            cli_automation_daemon_ready: true,
            polyform_14_targets_ready: true,
            embedded_iot_edge_ready: true
        },
        support_and_onboarding: support
    };
}

fn run_universal_profession_suite_wave8() {
    let catalog = profession_taxonomy_catalog();
    let total_sectors = len(catalog);
    let total_categories = 0;
    let total_specializations = 0;
    let verified_sector_apps = [];

    let s = 0;
    while s < len(catalog) {
        let sec = catalog[s];
        total_categories = total_categories + len(sec.categories);
        total_specializations = total_specializations + len(sec.specializations);
        let first_prof = sec.specializations[0];
        let app_inst = instantiate_profession_app(first_prof.id, "all_editions", sec.default_theme);
        array_push(verified_sector_apps, map{
            sector_id: sec.sector_id,
            profession_id: first_prof.id,
            title_el: first_prof.title_el,
            theme: app_inst.active_theme,
            desktop_records: app_inst.compiled_editions.desktop_native_records,
            web_records: app_inst.compiled_editions.web_studio_pwa_records,
            mobile_records: app_inst.compiled_editions.mobile_android_ios_records,
            demo_ready: app_inst.support_and_onboarding.interactive_guided_demo.enabled,
            manual_ready: app_inst.support_and_onboarding.integrated_live_manual.enabled,
            ai_help_ready: app_inst.support_and_onboarding.contextual_ai_help_assistant.enabled
        });
        s = s + 1;
    }

    let polyform_check = Wave6.run_visual_sketch_and_polyform_wave6_suite();
    let flagship_ui_check = Wave7.run_flagship_default_ui_wave7_suite();

    return map{
        ok: total_sectors == 12 and total_categories == 36 and total_specializations == 72
            and len(verified_sector_apps) == 12 and polyform_check.ok and flagship_ui_check.ok,
        wave: "WAVE_8_UNIVERSAL_PROFESSION_AND_SECTOR_SUITE",
        sectors_count: total_sectors,
        categories_count: total_categories,
        specializations_count: total_specializations,
        editions_per_profession: len(supported_app_editions()),
        total_edition_combinations: total_specializations * len(supported_app_editions()),
        onboarding_systems_per_app: len(supported_onboarding_and_support_modes()),
        verified_sector_apps: verified_sector_apps
    };
}

export supported_app_editions, supported_onboarding_and_support_modes, profession_taxonomy_catalog;
export find_profession_spec, build_integrated_support_suite, instantiate_profession_app, run_universal_profession_suite_wave8;
