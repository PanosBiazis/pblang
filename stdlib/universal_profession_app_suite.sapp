            specializations: [
                map{ id: "hr_talent_workdays_manager", title_el: "Διεύθυνση Ανθρώπινου Δυναμικού (Προσλήψεις, Άδειες PBWorkdays & Αξιολόγηση)", kpi_label: "Υπολογισμός Εργάσιμων & Αδειών", sample_metric: "100% Ακρίβεια Ημερολογίου" },
                map{ id: "business_consultant_espa", title_el: "Σύμβουλος Επιχειρήσεων & ΕΣΠΑ / Αναπτυξιακών Προγραμμάτων (Φάκελοι, Επιλεξιμότητα & Ορόσημα)", kpi_label: "Επιτυχία Εγκρίσεων Φακέλων", sample_metric: "96% Εγκεκριμένες Προτάσεις" },
                map{ id: "pmo_agile_project_manager", title_el: "Project Manager & PMO (PBTaskScope, Χρονοδιαγράμματα, Kanban & Κρίσιμη Διαδρομή)", kpi_label: "Παράδοση Οροσήμων Έργου", sample_metric: "98% Εντός Προθεσμίας" },
                map{ id: "freelancer_solo_professional", title_el: "Ελεύθερος Επαγγελματίας & Ατομική Επιχείρηση (Προσφορές PBOffer, Κοστολόγηση PBQuote & Πελάτες)", kpi_label: "Μετατροπή Προσφορών σε Έργα", sample_metric: "+41% Αποδοχή Προσφορών" },
                map{ id: "omnichannel_customer_support", title_el: "Κέντρο Εξυπηρέτησης Πελατών & Helpdesk AI (CosmoPulse OmniMail™ 360°)", kpi_label: "Αυτόματη Απάντηση & Ικανοποίηση", sample_metric: "100% Αυτόματη Κάλυψη με PDF" },
                map{ id: "public_sector_municipality_kep", title_el: "Δημόσιος Φορέας, Δήμος (ΟΤΑ) & ΚΕΠ (Ηλεκτρονικό Πρωτόκολλο, Αιτήσεις Πολιτών & Διαφάνεια)", kpi_label: "Χρόνος Διεκπεραίωσης Αιτήματος", sample_metric: "Αυθημερόν Ψηφιακή Διεκπεραίωση" }
            ]
