                map{ id: "cleaning_pest_control_facility", title_el: "Εταιρεία Καθαρισμού, Απεντομώσεων & Συντήρησης Κτιρίων (Πιστοποιητικά & Συνεργεία)", kpi_label: "Πιστοποιημένες Επισκέψεις", sample_metric: "100% Ψηφιακά Πιστοποιητικά" },
