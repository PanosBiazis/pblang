                map{ id: "building_common_expenses", title_el: "Γραφείο Κοινοχρήστων & Διαχείριση Πολυκατοικιών (Χιλιοστά, Θέρμανση & Ειδοποιητήρια)", kpi_label: "Ακρίβεια Επιμερισμού Δαπανών", sample_metric: "100% Ακριβή Χιλιοστά (PBPortions)" },
