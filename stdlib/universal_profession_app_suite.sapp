// stdlib/universal_profession_app_suite.sapp
// =====================================================================================================================
// PBLang Wave 8: Universal Multi-Edition Profession, Sector, Category & Specialization Application Suite (PB-07-001)
// =====================================================================================================================
// Provides a complete, modular, verified application generator and runtime for:
//   - 12 Major Economic & Scientific Sectors
//   - 36 Categories & 72 Specialized Professions
//   - 6 Target Editions per Profession (Desktop Native X11/Win32/macOS, Web Studio PWA, Mobile Android/iOS,
//     CLI & Background Daemon, PolyForm Delphi/Qt/Unreal/Blazor, Embedded IoT/Edge)
//   - 4 Built-in Automated Support & Onboarding Systems in every app:
//       1. Interactive Guided Demo & Sandbox (`interactive_guided_demo`)
//       2. Contextual AI Help & Smart Tooltip Assistant (`contextual_ai_help_assistant`)
//       3. Integrated Bilingual User & Admin Manual (`integrated_live_manual`)
//       4. Self-Healing Doctor & Zero-Trust Security/Privacy Guard (`built_in_security_and_doctor`)
// =====================================================================================================================

let UI = import("stdlib/modern_ui.sapp");
let Wave6 = import("stdlib:visual_sketch_and_polyform_studio.sapp");
let Wave7 = import("stdlib:flagship_default_ui_engine.sapp");

fn supported_app_editions() {
    return [
        "desktop_native",
        "web_studio_pwa",
        "mobile_android_ios",
        "cli_automation_daemon",
        "polyform_delphi_qt_unreal",
        "embedded_iot_edge"
    ];
}

fn supported_onboarding_and_support_modes() {
    return [
        "interactive_guided_demo",
        "contextual_ai_help_assistant",
        "integrated_live_manual",
        "built_in_security_and_doctor"
    ];
}

