// stdlib/watch.sapp — pblang Watchers: a unified, extensible observability + reverse-
// engineering facade. One simple API to capture state across every level pblang can
// reach: from bytecode/opcodes (the lowest level pblang executes) up to heap, memory,
// CPU/GPU/NPU compute, storage, devices, network, quantum backends, and binary files —
// plus a watcher abstraction (snapshot / diff / watch-a-block) and LIVE time-series
// sampling (incl. over networks).
//
// Design: each domain is a "probe" (a function returning a map). Probes are read-only
// and fail safe — a probe whose backend is unavailable returns { available: false }
// instead of throwing, so a watcher never crashes the program it observes.
//
//   let w = import("stdlib:watch.sapp");
//   w.disasm("let x = 1 + 2;")        // bytecode/opcodes
//   w.capture_all()                    // fast full snapshot (time/heap/memory/compute)
//   let wt = w.watcher("run");
//   w.watch(wt, "load", fn(){ ... })   // measure allocations + time of a block
//   w.sample(w.compute, 5, 200)        // live: 5 samples, 200ms apart
//   w.binary("target/release/pblang")  // reverse-engineer a file (format/entropy/magic)

let FS = import("stdlib:fs.sapp");

// Opcode number -> name, mirroring stdlib/compiler/ir.sapp (0..40). Index by op number.
let OPNAMES = [
    "CONSTANT", "ADD", "SUB", "MUL", "DIV", "EQ", "NOT_EQ", "GT", "GE", "LT", "LE",
    "POP", "PRINT", "DEFINE_GLOBAL", "GET_GLOBAL", "SET_GLOBAL", "GET_LOCAL", "SET_LOCAL",
    "CALL", "RETURN", "JUMP", "JUMP_IF_FALSE", "JUMP_IF_TRUE", "NOT", "CLOSURE",
    "MAKE_ARRAY", "MAKE_MAP", "GET_INDEX", "SET_INDEX", "GET_ATTR", "SET_ATTR", "MOD",
    "LEN", "JUMP_IF_FALSE_PEEK", "JUMP_IF_TRUE_PEEK", "TRY", "JUMP_IF_NIL_PEEK",
    "JUMP_IF_NOT_NIL_PEEK", "GET_UPVALUE", "SET_UPVALUE", "THROW"
];

let HEX = "0123456789abcdef";

// ── helpers ──────────────────────────────────────────────────────────────────
fn _opname(op) {
    if op >= 0 and op < len(OPNAMES) { return OPNAMES[op]; }
    return "OP_" + str(op);
}

// Parse "a=1 b=2" (the gc_stats string) into a numeric map.
fn _parse_kv(s) {
    let m = map{};
    if type(s) != "string" { return m; }
    let parts = str_split(s, " ");
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" and str_contains(p, "=") {
            let kv = str_split(p, "=");
            if len(kv) >= 2 {
                let v = try parse_number(kv[1]) catch nil;
                if v == nil { v = kv[1]; }
                m[kv[0]] = v;
            }
        }
    }
    return m;
}

fn _hex2(b) {
    let hi = num_floor(b / 16);
    let lo = num_mod(b, 16);
    return str_slice(HEX, hi, hi + 1) + str_slice(HEX, lo, lo + 1);
}

fn _bytes_to_hex(bytes) {
    let out = "";
    for i len(bytes) {
        if i > 0 { out = out + " "; }
        out = out + _hex2(bytes[i]);
    }
    return out;
}

// Shannon entropy (bits/byte) over a sample — a quick reverse-engineering signal:
// ~8.0 means compressed/encrypted, low values mean structured/text.
fn _entropy(bytes, sample) {
    let n = len(bytes);
    if n == 0 { return 0; }
    if sample > 0 and n > sample { n = sample; }
    let counts = [];
    let z = 0;
    while z < 256 { array_push(counts, 0); z = z + 1; }
    let i = 0;
    while i < n { let b = bytes[i]; counts[b] = counts[b] + 1; i = i + 1; }
    let h = 0;
    let k = 0;
    while k < 256 {
        if counts[k] > 0 {
            let p = counts[k] / n;
            h = h - p * (num_ln(p) / num_ln(2));
        }
        k = k + 1;
    }
    return h;
}

fn _ascii(bytes, off, n) {
    let s = "";
    let i = 0;
    while i < n and (off + i) < len(bytes) {
        s = s + strfromcharcode(bytes[off + i]);
        i = i + 1;
    }
    return s;
}

// Identify a file from its magic bytes -> { kind, format }. Covers all common image,
// audio and video formats (plus archives/executables/documents). Read-only, no decoder.
fn _media_id(bytes) {
    let n = len(bytes);
    fn at(i) { if i >= 0 and i < n { return bytes[i]; } return 0 - 1; }

    // ISO base-media containers (offset 4 == "ftyp"): images, audio and video by brand.
    if n >= 12 and _ascii(bytes, 4, 4) == "ftyp" {
        let brand = _ascii(bytes, 8, 4);
        if brand == "avif" or brand == "avis" { return map{ kind: "image", format: "AVIF" }; }
        if brand == "heic" or brand == "heix" or brand == "heif" or brand == "mif1" { return map{ kind: "image", format: "HEIC" }; }
        if brand == "M4A " { return map{ kind: "audio", format: "M4A/AAC" }; }
        return map{ kind: "video", format: "MP4/MOV (" + str_trim(brand) + ")" };
    }

    // ── images ──
    if at(0)==137 and at(1)==80 and at(2)==78 and at(3)==71 { return map{ kind: "image", format: "PNG" }; }
    if at(0)==255 and at(1)==216 and at(2)==255 { return map{ kind: "image", format: "JPEG" }; }
    if at(0)==71 and at(1)==73 and at(2)==70 { return map{ kind: "image", format: "GIF" }; }
    if at(0)==66 and at(1)==77 { return map{ kind: "image", format: "BMP" }; }
    if at(0)==56 and at(1)==66 and at(2)==80 and at(3)==83 { return map{ kind: "image", format: "PSD" }; }
    if (at(0)==73 and at(1)==73 and at(2)==42 and at(3)==0) or (at(0)==77 and at(1)==77 and at(2)==0 and at(3)==42) { return map{ kind: "image", format: "TIFF" }; }
    if at(0)==0 and at(1)==0 and at(2)==1 and at(3)==0 { return map{ kind: "image", format: "ICO" }; }
    if at(0)==0 and at(1)==0 and at(2)==2 and at(3)==0 { return map{ kind: "image", format: "CUR" }; }

    // RIFF family: WEBP (image) / WAVE (audio) / AVI (video)
    if at(0)==82 and at(1)==73 and at(2)==70 and at(3)==70 {
        let sub = _ascii(bytes, 8, 4);
        if sub == "WEBP" { return map{ kind: "image", format: "WEBP" }; }
        if sub == "WAVE" { return map{ kind: "audio", format: "WAV" }; }
        if sub == "AVI " { return map{ kind: "video", format: "AVI" }; }
        return map{ kind: "data", format: "RIFF" };
    }

    // SVG / XML (text-based vector image)
    if at(0)==60 or (n >= 5 and _ascii(bytes, 0, 5) == "<?xml") {
        if str_contains(_ascii(bytes, 0, 512), "<svg") { return map{ kind: "image", format: "SVG" }; }
    }

    // ── audio ──
    if at(0)==102 and at(1)==76 and at(2)==97 and at(3)==67 { return map{ kind: "audio", format: "FLAC" }; }   // fLaC
    if at(0)==79 and at(1)==103 and at(2)==103 and at(3)==83 { return map{ kind: "audio", format: "OGG" }; }    // OggS
    if at(0)==73 and at(1)==68 and at(2)==51 { return map{ kind: "audio", format: "MP3 (ID3)" }; }              // ID3
    if at(0)==255 and (at(1)==251 or at(1)==250 or at(1)==243 or at(1)==242 or at(1)==227 or at(1)==226) { return map{ kind: "audio", format: "MP3" }; }
    if at(0)==255 and (at(1)==241 or at(1)==249) { return map{ kind: "audio", format: "AAC (ADTS)" }; }
    if at(0)==70 and at(1)==79 and at(2)==82 and at(3)==77 {                                                    // FORM
        let sub = _ascii(bytes, 8, 4);
        if sub == "AIFF" or sub == "AIFC" { return map{ kind: "audio", format: "AIFF" }; }
    }
    if at(0)==77 and at(1)==84 and at(2)==104 and at(3)==100 { return map{ kind: "audio", format: "MIDI" }; }   // MThd
    if at(0)==35 and at(1)==33 and at(2)==65 and at(3)==77 and at(4)==82 { return map{ kind: "audio", format: "AMR" }; }

    // ── video ──
    if at(0)==26 and at(1)==69 and at(2)==223 and at(3)==163 { return map{ kind: "video", format: "Matroska/WebM" }; } // EBML
    if at(0)==70 and at(1)==76 and at(2)==86 { return map{ kind: "video", format: "FLV" }; }
    if at(0)==0 and at(1)==0 and at(2)==1 and (at(3)==186 or at(3)==179) { return map{ kind: "video", format: "MPEG-PS" }; }
    if at(0)==71 and at(188)==71 { return map{ kind: "video", format: "MPEG-TS" }; }
    if at(0)==48 and at(1)==38 and at(2)==178 and at(3)==117 { return map{ kind: "video", format: "ASF/WMV/WMA" }; }

    // ── databases / structured data ──
    if n >= 16 and _ascii(bytes, 0, 15) == "SQLite format 3" { return map{ kind: "database", format: "SQLite" }; }
    if _ascii(bytes, 0, 4) == "PAR1" { return map{ kind: "database", format: "Parquet" }; }
    if at(0)==0 and at(1)==97 and at(2)==115 and at(3)==109 { return map{ kind: "data", format: "WASM" }; }   // \0asm

    // ── archives / executables / documents ──
    if at(0)==31 and at(1)==139 { return map{ kind: "archive", format: "gzip" }; }
    if at(0)==80 and at(1)==75 and at(2)==3 and at(3)==4 { return map{ kind: "archive", format: "zip" }; }
    if at(0)==66 and at(1)==90 and at(2)==104 { return map{ kind: "archive", format: "bzip2" }; }
    if at(0)==253 and at(1)==55 and at(2)==122 and at(3)==88 { return map{ kind: "archive", format: "xz" }; }
    if at(0)==55 and at(1)==122 and at(2)==188 and at(3)==175 { return map{ kind: "archive", format: "7z" }; }
    if at(0)==40 and at(1)==181 and at(2)==47 and at(3)==253 { return map{ kind: "archive", format: "zstd" }; }
    if at(0)==127 and at(1)==69 and at(2)==76 and at(3)==70 { return map{ kind: "executable", format: "ELF" }; }
    if at(0)==77 and at(1)==90 { return map{ kind: "executable", format: "PE/DOS" }; }
    if at(0)==202 and at(1)==254 and at(2)==186 and at(3)==190 { return map{ kind: "executable", format: "Mach-O (fat)" }; }
    if (at(0)==207 or at(0)==206) and at(1)==250 and at(2)==237 and at(3)==254 { return map{ kind: "executable", format: "Mach-O" }; }
    if at(0)==37 and at(1)==80 and at(2)==68 and at(3)==70 { return map{ kind: "document", format: "PDF" }; }

    return map{ kind: "data", format: "data" };
}

fn _detect_format(bytes) { return _media_id(bytes).format; }

// ── bytecode / opcode probes (lowest level pblang executes) ──────────────────
fn disasm(source) {
    let out = [];
    let FE = import("stdlib:compiler/selfhost_frontend.sapp");
    let r = try FE.frontend_compile(source) catch nil;
    if r == nil { return out; }
    let chunk = try r.chunk catch nil;
    if chunk == nil { return out; }
    let ins = try chunk.instructions catch nil;
    if ins == nil { return out; }
    for i len(ins) {
        let inst = ins[i];
        let op = try inst.op catch (0 - 1);
        array_push(out, map{ index: i, op: op, name: _opname(op), operand: try inst.operand catch nil });
    }
    return out;
}

fn opcode_histogram(source) {
    let d = disasm(source);
    let hist = map{};
    for i len(d) {
        let name = d[i].name;
        if map_has(hist, name) { hist[name] = hist[name] + 1; } else { hist[name] = 1; }
    }
    return hist;
}

fn bytecode(source) {
    let FE = import("stdlib:compiler/selfhost_frontend.sapp");
    let r = try FE.frontend_compile(source) catch nil;
    let chunk = nil;
    if r != nil { chunk = try r.chunk catch nil; }
    let n = 0;
    let nconst = 0;
    if chunk != nil {
        n = len(try chunk.instructions catch []);
        nconst = len(try chunk.constants catch []);
    }
    return map{
        ok: try r.ok catch false,
        instructions: n,
        constants: nconst,
        histogram: opcode_histogram(source),
    };
}

// ── runtime probes (heap / memory / vm) ──────────────────────────────────────
fn heap()   { return _parse_kv(try gc_stats() catch ""); }     // object allocation counts
fn memory() { return try memory_stats() catch map{}; }          // ref-count / borrow tracker
fn time_now() { return try now_ms() catch 0; }

fn vm() {
    return map{ time_ms: time_now(), heap: heap(), memory: memory() };
}

// ── hardware / compute probes ────────────────────────────────────────────────
fn compute() { return try tensor_backend() catch map{}; }       // fast: CPU threads / GPU

fn _hw() { return import("stdlib:hwinfo.sapp"); }

fn cpu()     { return try _hw().cpu() catch map{ available: false }; }
fn storage() { return try _hw().disks() catch map{ available: false }; }
fn gpus()    { return try _hw().gpus() catch map{ available: false }; }
fn npu()     { return try _hw().npu() catch map{ available: false }; }
fn devices() { return try _hw().devices_by_class() catch map{ available: false }; }
fn network() { return try _hw().network() catch map{ available: false }; }

fn quantum() {
    return map{
        available: true,
        backends: try quantum_backends() catch nil,
    };
}

fn neural() {
    // Neural-network compute view: backend (CPU threads / GPU) the tensor kernels use.
    return map{ available: true, backend: compute() };
}

// Full hardware survey (slower: queries the OS). Each piece fails safe.
fn hardware() {
    return map{
        cpu: cpu(), storage: storage(), gpus: gpus(), npu: npu(),
        network: network(), devices: devices(), compute: compute(),
    };
}

// ── target probes: binaries / compression (reverse engineering) ──────────────
fn binary(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let n = len(bytes);
    let head = [];
    let i = 0;
    while i < n and i < 16 { array_push(head, bytes[i]); i = i + 1; }
    return map{
        path: path,
        available: true,
        size: n,
        format: _detect_format(bytes),
        magic_hex: _bytes_to_hex(head),
        entropy: _entropy(bytes, 65536),
    };
}

fn hexdump(bytes, max_bytes = 256) {
    if type(bytes) == "string" { bytes = str_to_bytes(bytes); }
    let n = len(bytes);
    if max_bytes > 0 and n > max_bytes { n = max_bytes; }
    let out = "";
    let i = 0;
    while i < n {
        if num_mod(i, 16) == 0 {
            if i > 0 { out = out + "\n"; }
            out = out + _hex2(num_floor(i / 256)) + _hex2(num_mod(i, 256)) + "  ";
        }
        out = out + _hex2(bytes[i]) + " ";
        i = i + 1;
    }
    return out;
}

// Read an n-byte big-endian / little-endian unsigned integer from a byte array.
fn _be(bytes, off, n) {
    let v = 0;
    let i = 0;
    while i < n { v = v * 256 + bytes[off + i]; i = i + 1; }
    return v;
}
fn _le(bytes, off, n) {
    let v = 0;
    let mult = 1;
    let i = 0;
    while i < n { v = v + bytes[off + i] * mult; mult = mult * 256; i = i + 1; }
    return v;
}

// Scan a JPEG for its Start-Of-Frame marker to recover dimensions.
fn _jpeg_dims(bytes) {
    let n = len(bytes);
    let i = 2;   // skip the FF D8 SOI marker
    while i + 9 < n {
        if bytes[i] != 255 { i = i + 1; }
        else {
            let marker = bytes[i + 1];
            // SOF0..SOF15 (0xC0..0xCF) excluding DHT(0xC4), JPG(0xC8), DAC(0xCC)
            if marker >= 192 and marker <= 207 and marker != 196 and marker != 200 and marker != 204 {
                return [_be(bytes, i + 7, 2), _be(bytes, i + 5, 2)];   // [width, height]
            }
            i = i + 2 + _be(bytes, i + 2, 2);   // skip this segment by its length
        }
    }
    return nil;
}

// WEBP dimensions from the chunk after "RIFF....WEBP" (VP8X / lossy VP8 ; VP8L skipped).
fn _webp_dims(bytes) {
    if len(bytes) < 30 { return nil; }
    let fourcc = _ascii(bytes, 12, 4);
    if fourcc == "VP8X" { return [_le(bytes, 24, 3) + 1, _le(bytes, 27, 3) + 1]; }
    if fourcc == "VP8 " {
        return [num_mod(_le(bytes, 26, 2), 16384), num_mod(_le(bytes, 28, 2), 16384)];
    }
    return nil;
}

// FLAC STREAMINFO (right after the "fLaC" magic + 4-byte block header) -> audio params.
fn _flac_meta(bytes) {
    let sr = bytes[18] * 4096 + bytes[19] * 16 + num_floor(bytes[20] / 16);
    let ch = num_mod(num_floor(bytes[20] / 2), 8) + 1;
    let bits = num_mod(bytes[20], 2) * 16 + num_floor(bytes[21] / 16) + 1;
    let total = num_mod(bytes[21], 16) * 4294967296 + _be(bytes, 22, 4);
    let dur = 0;
    if sr > 0 { dur = total / sr; }
    return map{ sample_rate: sr, channels: ch, bits_per_sample: bits, total_samples: total, duration_sec: dur };
}

// Image metadata from already-read bytes. Dimensions for PNG/JPEG/GIF/BMP/WEBP/PSD/ICO;
// other image formats (TIFF/HEIC/AVIF/SVG) are identified (dims need deeper parsing).
fn _image_meta(bytes) {
    let id = _media_id(bytes);
    let n = len(bytes);
    let res = map{ available: true, kind: id.kind, format: id.format, size: n, width: nil, height: nil };
    let f = id.format;
    if f == "PNG" and n >= 24 { res.width = _be(bytes, 16, 4); res.height = _be(bytes, 20, 4); }
    else if f == "JPEG" { let wh = _jpeg_dims(bytes); if wh != nil { res.width = wh[0]; res.height = wh[1]; } }
    else if f == "GIF" and n >= 10 { res.width = _le(bytes, 6, 2); res.height = _le(bytes, 8, 2); }
    else if f == "BMP" and n >= 26 { res.width = _le(bytes, 18, 4); res.height = _le(bytes, 22, 4); }
    else if f == "WEBP" { let wh = _webp_dims(bytes); if wh != nil { res.width = wh[0]; res.height = wh[1]; } }
    else if f == "PSD" and n >= 22 { res.height = _be(bytes, 14, 4); res.width = _be(bytes, 18, 4); }
    else if (f == "ICO" or f == "CUR") and n >= 8 {
        let w = bytes[6]; if w == 0 { w = 256; }
        let h = bytes[7]; if h == 0 { h = 256; }
        res.width = w; res.height = h;
    }
    return res;
}

// Audio metadata from already-read bytes. Full params for WAV (PCM) and FLAC; other
// formats (MP3/OGG/AAC/AIFF/M4A/MIDI/AMR) are identified.
fn _audio_meta(bytes) {
    let id = _media_id(bytes);
    let n = len(bytes);
    let res = map{ available: true, kind: id.kind, format: id.format, size: n };
    if id.format == "WAV" and n >= 44 {
        res.channels = _le(bytes, 22, 2);
        res.sample_rate = _le(bytes, 24, 4);
        let byte_rate = _le(bytes, 28, 4);
        res.bits_per_sample = _le(bytes, 34, 2);
        let data_size = _le(bytes, 40, 4);
        res.duration_sec = 0;
        if byte_rate > 0 { res.duration_sec = data_size / byte_rate; }
    } else if id.format == "FLAC" and n >= 26 {
        let fm = _flac_meta(bytes);
        res.channels = fm.channels; res.sample_rate = fm.sample_rate;
        res.bits_per_sample = fm.bits_per_sample; res.duration_sec = fm.duration_sec;
    }
    return res;
}

// Video metadata from already-read bytes. Containers are identified; frame dimensions
// require deep box/atom parsing (per-codec) and are reported as needing it.
fn _video_meta(bytes) {
    let id = _media_id(bytes);
    return map{ available: true, kind: id.kind, format: id.format, size: len(bytes),
                note: "container identified; frame dimensions require deep parsing" };
}

fn image(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let m = _image_meta(bytes); m.path = path; return m;
}
fn audio(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let m = _audio_meta(bytes); m.path = path; return m;
}
fn video(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let m = _video_meta(bytes); m.path = path; return m;
}

// media(path): identify ANY image/audio/video/other file and return its metadata,
// dispatching by detected kind. Reads the file once.
fn media(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let id = _media_id(bytes);
    let res = nil;
    if id.kind == "image" { res = _image_meta(bytes); }
    else if id.kind == "audio" { res = _audio_meta(bytes); }
    else if id.kind == "video" { res = _video_meta(bytes); }
    else { res = map{ available: true, kind: id.kind, format: id.format, size: len(bytes) }; }
    res.path = path;
    return res;
}

// ── filesystem / folders / databases ─────────────────────────────────────────
fn _is_dir(path) {
    let items = try FS.listdir(path) catch nil;
    return items != nil;
}

fn _ext(name) {
    let dot = 0 - 1;
    let i = 0;
    while i < len(name) { if str_slice(name, i, i + 1) == "." { dot = i; } i = i + 1; }
    if dot < 0 { return "(none)"; }
    return str_slice(name, dot, len(name));
}

// stat(path): read-only metadata for a file OR directory.
fn stat(path) {
    let exists = try FS.exists(path) catch false;
    if not exists { return map{ path: path, exists: false }; }
    if _is_dir(path) {
        return map{ path: path, exists: true, is_dir: true, entries: len(try FS.listdir(path) catch []) };
    }
    return map{ path: path, exists: true, is_dir: false, size: try FS.size(path) catch nil };
}

fn _walk(dir, depth, acc, max_entries) {
    if acc.total >= max_entries { return; }
    let items = try FS.listdir(dir) catch [];
    for i len(items) {
        if acc.total < max_entries {
            let name = items[i];
            if name != ".git" and name != "target" and name != ".mint-mcp" and name != "node_modules" {
                let path = dir + "/" + name;
                if _is_dir(path) {
                    acc.dirs = acc.dirs + 1;
                    if depth + 1 > acc.max_depth { acc.max_depth = depth + 1; }
                    _walk(path, depth + 1, acc, max_entries);
                } else {
                    acc.files = acc.files + 1;
                    acc.total = acc.total + 1;
                    let ext = _ext(name);
                    if map_has(acc.by_ext, ext) { acc.by_ext[ext] = acc.by_ext[ext] + 1; }
                    else { acc.by_ext[ext] = 1; }
                    if len(acc.sample) < 20 { array_push(acc.sample, path); }
                }
            }
        }
    }
}

// folder(path): recursive analysis — file/dir counts, depth, by-extension breakdown,
// a sample of paths. Listing-only (no file reads) so it stays fast; bounded by max_entries.
fn folder(path, max_entries = 5000) {
    let acc = map{ files: 0, dirs: 0, total: 0, max_depth: 0, by_ext: map{}, sample: [] };
    _walk(path, 0, acc, max_entries);
    return map{
        path: path, kind: "folder",
        files: acc.files, dirs: acc.dirs, max_depth: acc.max_depth,
        by_extension: acc.by_ext, sample: acc.sample,
        truncated: acc.total >= max_entries,
    };
}

// database(path): detect a database/structured-data file; parse the SQLite header.
fn database(path) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return map{ path: path, available: false }; }
    let id = _media_id(bytes);
    let res = map{ path: path, available: true, kind: id.kind, format: id.format, size: len(bytes) };
    if id.format == "SQLite" and len(bytes) >= 32 {
        let page_size = _be(bytes, 16, 2);
        if page_size == 1 { page_size = 65536; }
        res.page_size = page_size;
        res.page_count = _be(bytes, 28, 4);
        res.estimated_bytes = page_size * res.page_count;
    }
    return res;
}

// inspect(path): the one entry point for any path — folder analysis for directories,
// media/binary metadata for files.
fn inspect(path) {
    if _is_dir(path) { return folder(path); }
    return media(path);
}

fn hexdump_file(path, max_bytes = 256) {
    let bytes = try FS.read_bytes(path) catch nil;
    if bytes == nil { return ""; }
    return hexdump(bytes, max_bytes);
}

// Self-contained compressibility estimate via Shannon entropy — no temp files or
// subprocess (secure, fast). estimated_compressed_bytes is the information-theoretic
// lower bound; entropy near 8 bits/byte means already-compressed/encrypted data.
fn compress_stats(data) {
    if type(data) != "string" { data = str(data); }
    let bytes = str_to_bytes(data);
    let orig = len(bytes);
    if orig == 0 {
        return map{ available: true, original_bytes: 0, entropy_bits_per_byte: 0,
                    estimated_compressed_bytes: 0, estimated_ratio: 0 };
    }
    let ent = _entropy(bytes, 0);
    let est = num_floor(orig * ent / 8) + 1;
    let ratio = 0;
    if est > 0 { ratio = orig / est; }
    return map{
        available: true,
        original_bytes: orig,
        entropy_bits_per_byte: ent,
        estimated_compressed_bytes: est,
        estimated_ratio: ratio,
    };
}

// ── unified capture ──────────────────────────────────────────────────────────
// Fast snapshot: only the cheap, always-available probes (no OS queries).
fn capture_all() {
    return map{
        time_ms: time_now(),
        heap: heap(),
        memory: memory(),
        compute: compute(),
    };
}

// Everything, including the slower hardware survey.
fn capture_full() {
    let s = capture_all();
    s.hardware = hardware();
    s.quantum = quantum();
    return s;
}

// Registry of no-target probes, for discovery and generic dispatch.
fn probes() {
    return ["time", "heap", "memory", "vm", "compute", "neural", "quantum",
            "cpu", "storage", "gpus", "npu", "devices", "network", "hardware"];
}

fn probe(name) {
    if name == "time"     { return map{ time_ms: time_now() }; }
    if name == "heap"     { return heap(); }
    if name == "memory"   { return memory(); }
    if name == "vm"       { return vm(); }
    if name == "compute"  { return compute(); }
    if name == "neural"   { return neural(); }
    if name == "quantum"  { return quantum(); }
    if name == "cpu"      { return cpu(); }
    if name == "storage"  { return storage(); }
    if name == "gpus"     { return gpus(); }
    if name == "npu"      { return npu(); }
    if name == "devices"  { return devices(); }
    if name == "network"  { return network(); }
    if name == "hardware" { return hardware(); }
    throw "watch: unknown probe '" + str(name) + "'";
}

// ── watcher abstraction (snapshots over time) ────────────────────────────────
fn watcher(name) {
    return map{ name: name, created: time_now(), snapshots: [] };
}

fn snapshot(w, label) {
    let snap = map{ label: label, at: time_now(), state: capture_all() };
    array_push(w.snapshots, snap);
    return snap;
}

// Delta between two capture_all() states: allocations created + elapsed ms.
fn diff(a, b) {
    let ha = try a.heap catch map{};
    let hb = try b.heap catch map{};
    let alloc = map{};
    let keys = map_keys(hb);
    for i len(keys) {
        let k = keys[i];
        let va = try ha[k] catch 0;
        alloc[k] = hb[k] - va;
    }
    return map{
        ms: (try b.time_ms catch 0) - (try a.time_ms catch 0),
        allocations: alloc,
    };
}

// Watch a code block: snapshot before, run f, snapshot after; report result + cost.
fn watch(w, label, f) {
    let before = snapshot(w, label + ":before");
    let result = f();
    let after = snapshot(w, label + ":after");
    return map{
        result: result,
        ms: after.at - before.at,
        delta: diff(before.state, after.state),
    };
}

fn report(w) {
    let out = "watcher '" + str(w.name) + "' — " + str(len(w.snapshots)) + " snapshots\n";
    for i len(w.snapshots) {
        let s = w.snapshots[i];
        out = out + "  [" + str(i) + "] " + str(s.label) + " @ " + str(s.at) + "ms\n";
    }
    return out;
}

// ── live sampling (time-series; works for any probe, incl. network) ──────────
// probe_fn: a 0-arg function (e.g. watch.compute, watch.network). Returns an array of
// { at, value } samples, `interval_ms` apart.
fn sample(probe_fn, n, interval_ms = 100) {
    let out = [];
    let i = 0;
    while i < n {
        array_push(out, map{ at: time_now(), value: probe_fn() });
        i = i + 1;
        if i < n { sleep_ms(interval_ms); }
    }
    return out;
}

// Convenience: live-sample a named probe (discrete mode).
fn live(name, n, interval_ms = 100) {
    return sample(fn() { return probe(name); }, n, interval_ms);
}

// CONTINUOUS mode: sample as fast as possible until `duration_ms` elapses (or a safety
// cap of max_samples). Yields a dense time-series — use for fine-grained live capture.
fn sample_continuous(probe_fn, duration_ms, max_samples = 100000) {
    let out = [];
    let start = time_now();
    while (time_now() - start) < duration_ms and len(out) < max_samples {
        array_push(out, map{ at: time_now(), value: probe_fn() });
    }
    return out;
}

// TRIGGERED mode: sample at an interval until `predicate(value)` is true (or max hit).
// The last sample is the one that satisfied the predicate.
fn sample_until(probe_fn, predicate, max_samples = 1000, interval_ms = 50) {
    let out = [];
    let i = 0;
    while i < max_samples {
        let v = probe_fn();
        array_push(out, map{ at: time_now(), value: v });
        if predicate(v) { return out; }
        i = i + 1;
        sleep_ms(interval_ms);
    }
    return out;
}

// ON-CHANGE mode: poll `checks` times at an interval but only record a sample when its
// value differs from the last recorded one (the first is always recorded). `eq` is an
// optional comparator; by default values compare by their string form. Great for
// watching something that changes rarely without storing redundant samples.
fn sample_on_change(probe_fn, checks, interval_ms = 50, eq = nil) {
    let out = [];
    let last = nil;
    let have_last = false;
    let i = 0;
    while i < checks {
        let v = probe_fn();
        let changed = true;
        if have_last {
            if eq != nil { changed = not eq(last, v); }
            else { changed = str(last) != str(v); }
        }
        if changed {
            array_push(out, map{ at: time_now(), value: v });
            last = v;
            have_last = true;
        }
        i = i + 1;
        if i < checks { sleep_ms(interval_ms); }
    }
    return out;
}

fn sample_modes() { return ["discrete", "continuous", "until", "on_change"]; }

// Unified entry: stream(probe_fn, map{ mode, ... }). mode defaults to "discrete".
//   discrete:   { n, interval_ms }
//   continuous: { duration_ms, max_samples }
//   until:      { predicate, max_samples, interval_ms }
fn stream(probe_fn, opts) {
    if opts == nil { opts = map{}; }
    let mode = try opts.mode catch "discrete";
    if mode == "continuous" {
        return sample_continuous(probe_fn, try opts.duration_ms catch 1000, try opts.max_samples catch 100000);
    }
    if mode == "until" {
        return sample_until(probe_fn, opts.predicate, try opts.max_samples catch 1000, try opts.interval_ms catch 50);
    }
    if mode == "on_change" {
        return sample_on_change(probe_fn, try opts.checks catch 100, try opts.interval_ms catch 50, try opts.eq catch nil);
    }
    return sample(probe_fn, try opts.n catch 10, try opts.interval_ms catch 100);
}

export OPNAMES;
export disasm, opcode_histogram, bytecode;
export heap, memory, vm, time_now, compute, neural, quantum;
export cpu, storage, gpus, npu, devices, network, hardware;
export binary, hexdump, hexdump_file, compress_stats, image, audio, video, media;
export stat, folder, database, inspect;
export capture_all, capture_full, probes, probe;
export watcher, snapshot, diff, watch, report;
export sample, live, sample_continuous, sample_until, sample_on_change, sample_modes, stream;
