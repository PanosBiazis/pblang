// stdlib/vision_ledger.sapp -- ordered, honest execution ledger for the pblang
// vision. Broad goals remain active until their measurable exit criteria pass.

let FORMAT = "pblang.vision.ledger.v1";

fn _item(order, id, title, state, evidence, exit_criterion, current = false) {
    return map{
        order: order, id: id, title: title, state: state, evidence: evidence,
        exit_criterion: exit_criterion, current: current
    };
}

fn items() {
    return [
        _item(1, "pblang-only-policy", "Implement new ecosystem logic in pblang", "active",
            "The pure-pblang migration policy and pbmigrate CLI reject new/added Rust, bound exact host exceptions, and gate reference-to-retirement evidence",
            "The manifest gate is adopted by product/release workflows and each migrated product has a tested pblang entry point with no new non-pblang implementation dependency"),
        _item(2, "selfhost-parity", "Self-hosted compiler and runtime parity", "active",
            "44 pblang-native self-host suites pass; bounded recursive types, generics, typed ADTs, and real frontend parsing join hosted C99 project linking, checked closures, native/sanitizer execution, and PBIDE",
            "Bootstrap, parser, checker, interpreter, and codegen parity gates pass without the legacy host", true),
        _item(3, "x86-64", "Optimize and harden native x86-64", "active",
            "Validated shared IR, ELF64 backend, executable tests, and size benchmarks pass",
            "ABI, calls, safety, correctness, speed, RSS, and artifact-size gates pass on the native suite"),
        _item(4, "i386", "Optimize and harden native i386", "active",
            "ELF32 backend and cross-backend semantic/size tests pass",
            "Feature parity and differential execution pass on supported 32-bit hosts/emulators"),
        _item(5, "c99", "Portable C99 backend and runtime", "active",
            "Shared IR and pblang-source C99 paths reject unsupported AST/symbol collisions, bound kernel allocation, lower hosted closures/globals, and safely link bounded module snapshots",
            "Defined integer/runtime semantics and compiler matrix pass across supported C99 toolchains"),
        _item(6, "interpreter", "Fast bounded pblang interpreter", "active",
            "Sticky budgets, pre-allocation guards, lexical cache, superinstructions, and conservative unshadowed-builtin dispatch are tested; the latest full semantic run passed 680/680",
            "Correctness, dispatch, wall-time, RSS, and adversarial resource gates meet recorded budgets"),
        _item(7, "platforms-devices", "OS, architecture, and device execution models", "active",
            "Platform profiles and verified ISA emulators cover classic, embedded, modern, web, and quantum models",
            "Each claimed target has a specified ISA/ABI, conformance fixture, bounded execution, and honest hardware boundary"),
        _item(8, "performance", "Measured performance and size leadership", "active",
            "Phase and artifact benchmarks report deterministic work plus machine-specific timing",
            "Reproducible suites establish wins per workload without claiming one language wins every workload"),
        _item(9, "one-line-apps", "One-line configurable application facades", "active",
            "app.sapp and app_domains.sapp expose tested CLI, GUI, web, REST, desktop, game, image, database, networking, automation, AI, and ML helpers over real PBLang libraries",
            "Every claimed category has a real provider, bounded/capability-safe execution, runnable examples, target acceptance tests, and measured facade overhead"),
        _item(10, "libraries", "Expand and optimize pblang libraries", "active",
            "Data, security, web, graphics, algorithms, resilience, and tooling modules have semantic suites",
            "Each library has bounded APIs, compatibility tests, benchmarks where relevant, and current docs"),
        _item(11, "products", "Improve PBIDE, pbAI, pbOS, and pb-mcp", "active",
            "Shared pblang product runtime, health, performance, and execution facades exist",
            "Each product passes its pblang-native functional, safety, performance, and UI/CLI acceptance gates"),
        _item(12, "aap-ideas", "Review AAP projects for reusable ideas", "active",
            "Bounded project inventory, survey, audit, graph, and status tools exist",
            "Ideas are adopted only with ownership, tests, license compatibility, and measurable product value"),
        _item(13, "aap-migration", "Migrate applicable AAP implementations to pblang", "active",
            "Migration inventory and pblang-native product modules are underway",
            "Every selected project has behavior parity, data migration, rollback, and no hidden host-language dependency"),
        _item(14, "language-benchmarks", "Cross-language category benchmarks", "active",
            "Language benchmark contracts and category matrices exist",
            "Pinned toolchains, equivalent algorithms, warmup, repetitions, RSS, size, compile time, runtime, and correctness are published"),
        _item(15, "polyglot-benchmarks", "Polyglot and parallel feature benchmarks", "active",
            "Polyglot registry/router and benchmark fixtures exist",
            "Startup, marshaling, steady-state, parallel scaling, memory, failure, and security overhead are measured"),
        _item(16, "safety-security", "Memory, capability, device, and supply-chain safety", "active",
            "Validation, bounded execution, resource budgets, capability gates, and security libraries exist",
            "Threat-model tests pass at language, runtime, product, OS, driver, firmware, and deployment boundaries"),
        _item(17, "docs-ui", "Synchronize docs, usability, and visual quality", "active",
            "Current-status and product docs distinguish implementation from roadmap",
            "Docs match tested behavior and product interfaces pass desktop/mobile readability and interaction checks")
    ];
}

fn current() {
    let all = items(); let i = 0;
    while i < len(all) { if all[i].current { return all[i]; } i = i + 1; }
    return nil;
}

fn summary() {
    let all = items(); let active = 0; let complete = 0; let blocked = 0; let i = 0;
    while i < len(all) {
        if all[i].state == "complete" { complete = complete + 1; }
        elif all[i].state == "blocked" { blocked = blocked + 1; }
        else { active = active + 1; }
        i = i + 1;
    }
    return map{
        format: FORMAT, total: len(all), active: active, complete: complete,
        blocked: blocked, current: current(), items: all
    };
}

fn lines() {
    let report = summary(); let out = [
        "pblang vision ledger: " + str(report.total) + " ordered requirements",
        "current: " + str(report.current.order) + " " + report.current.id + " - " + report.current.title
    ];
    let i = 0;
    while i < len(report.items) {
        let item = report.items[i];
        array_push(out, str(item.order) + ". [" + item.state + "] " + item.title);
        array_push(out, "   evidence: " + item.evidence);
        array_push(out, "   exit: " + item.exit_criterion);
        i = i + 1;
    }
    return out;
}

export items, current, summary, lines;
