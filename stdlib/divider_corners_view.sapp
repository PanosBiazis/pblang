let C=import("stdlib:divider_corners.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
fn rounded(n){return str((if n<0 {num_ceil(n*1000000-0.5)} else {num_floor(n*1000000+0.5)})/1000000);}
fn summary(r){return "Nominal: "+rounded(r.nominal.loaded_vout)+" V | Range: "+rounded(r.minimum_vout)+" to "+rounded(r.maximum_vout)+" V";}
fn lines(r,n){let lines=["Corners "+str(n*4+1)+"-"+str(n*4+4)+" of 8 | R1 / R2 / RL"];
 for i in range(n*4,n*4+4){let row=r.rows[i];let tags=[];for bit in row.corner {array_push(tags,if bit==0 {"low"} else {"high"});}array_push(lines,str(i+1)+". "+str_join(tags," / ")+" = "+rounded(row.result.loaded_vout)+" V");}return lines;}
fn page(r,n){return str_join(lines(r,n),"\n\n");}
fn page_action(r,n){let a=[];let text=lines(r,n);for i in range(0,5){array_push(a,UI.action_set_text("corner_"+str(i),text[i]));}return UI.action_sequence(a);}
fn view(vin=5,top=1000,bottom=1000,load=1000,tp=5,bp=5,lp=5){let r=C.analyze(vin,top,bottom,load,tp,bp,lp);
 return UI.screen([UI.heading("PBCorners"),UI.text("Loaded divider | fixed supply: "+str(vin)+" V"),
 UI.text("R1 / R2 / RL (ohm): "+str(top)+" / "+str(bottom)+" / "+str(load)),UI.text("Tolerances (%): "+str(tp)+" / "+str(bp)+" / "+str(lp)),
 UI.text(summary(r)),UI.text(lines(r,0)[0],map{name:"corner_0"}),UI.text(lines(r,0)[1],map{name:"corner_1"}),UI.text(lines(r,0)[2],map{name:"corner_2"}),UI.text(lines(r,0)[3],map{name:"corner_3"}),UI.text(lines(r,0)[4],map{name:"corner_4"}),UI.row([UI.button("Corners 1-4",page_action(r,0)),UI.button("Corners 5-8",page_action(r,1))]),
 UI.text("Rounded to six decimals. Low/high are resistance endpoints."),UI.text("Read-only snapshot. Ideal model; no hardware or power-rating check.")]);}
fn calculate(form){let tokens=[];for key in ["vin","top","bottom","load","tp","bp","lp"] {array_push(tokens,G.get(form,key).value);}
 let r=try C.from_tokens(tokens) catch nil;let status=G.get(form,"status");let output=G.get(form,"output");let rows=G.get(form,"rows");
 if r==nil {output.text="";rows.value="";status.text="Use +/-1000 V, 0..20% tolerances, and all resistance endpoints within 1..1000000 ohms.";}
 else {output.text=summary(r);rows.value=page(r,0)+"\n\n"+page(r,1);status.text="Eight endpoint combinations. Fixed supply; independent tolerances.";}form.dirty=true;
}
fn build(){let f=UI.build("PBCorners",UI.screen([UI.heading("PBCorners - loaded divider tolerances"),UI.text("R1: supply to output. R2 and RL: output to ground."),
 UI.text("Supply V / R1 ohm / R2 ohm / RL ohm"),UI.row([UI.input("5",map{name:"vin",max_chars:24}),UI.input("1000",map{name:"top",max_chars:24}),UI.input("1000",map{name:"bottom",max_chars:24}),UI.input("1000",map{name:"load",max_chars:24})]),
 UI.text("Independent tolerances %: R1 / R2 / RL"),UI.row([UI.input("5",map{name:"tp",max_chars:24}),UI.input("5",map{name:"bp",max_chars:24}),UI.input("5",map{name:"lp",max_chars:24})]),
 UI.button("Calculate",fn(f){calculate(f);},map{name:"calculate"}),UI.text("",map{name:"output",h:60}),UI.area("",map{name:"rows",readonly:true,h:400}),UI.text("",map{name:"status"}),UI.text("Educational ideal DC model. Display rounded to six decimals. No hardware access.")]),map{width:1100,height:1050,theme:"dark"});calculate(f);return f;}
fn run(){G.run(build());}
export view,calculate,build,run;
