// Offline pipeline-document inspection. No callbacks, source execution or I/O.
let Ops=import("stdlib:devops_pipeline.sapp");
let Serialization=import("stdlib:serialization.sapp");

fn _failure(code) {
    return map{format:"pblang.devops-inspection.v1",ok:false,error:code,
        job_count:0,dependency_count:0,stage_count:0,max_stage_width:0,stages:[],
        contains_job_ids:false,execution_performed:false,production_ready:false};
}
fn _analyze(jobs,reveal) {
    let ordered=Ops.order(jobs); // validates the entire graph before inspection
    let needs=map{};
    for job in jobs { needs[job.id]=job.needs; }
    let levels=map{}; let grouped=[]; let edges=0;
    for id in ordered {
        let level=0;
        for dep in needs[id] {
            level=num_max(level,levels[dep]+1); edges=edges+1;
        }
        levels[id]=level;
        if level==len(grouped) { array_push(grouped,[]); }
        array_push(grouped[level],id);
    }
    let rows=[]; let width=0;
    for index in range(0,len(grouped)) {
        let ids=[];
        if reveal { for id in grouped[index] { array_push(ids,id); } }
        let count=len(grouped[index]); width=num_max(width,count);
        array_push(rows,map{index:index,job_count:count,job_ids:ids});
    }
    return map{format:"pblang.devops-inspection.v1",ok:true,error:nil,
        job_count:len(ordered),dependency_count:edges,stage_count:len(rows),
        max_stage_width:width,stages:rows,contains_job_ids:reveal,
        execution_performed:false,production_ready:false};
}
fn _target_report(core,total,targets) {
    return map{format:"pblang.devops-target-inspection.v1",ok:core.ok,
        selection_mode:"target-closure",total_job_count:if core.ok {total} else {0},
        selected_job_count:core.job_count,target_count:if core.ok {targets} else {0},
        all_jobs_selected:core.ok and core.job_count==total,report:core,
        execution_performed:false,production_ready:false};
}
fn _inspect(source,reveal,targets=nil,selected=false) {
    if type(reveal)!="bool" { return _failure("invalid-options"); }
    if type(source)!="string" { return _failure("invalid-source"); }
    if len(source)>65536 or len(str_to_bytes(source))>65536 { return _failure("input-limit"); }
    let parsed=Serialization.parse_safe(source,"json",map{max_input_bytes:65536,
        max_line_bytes:65536,max_depth:5,max_items:2048,strict:true,reject_duplicate_keys:true});
    if not parsed.ok or parsed.duplicate_keys_checked!=true { return _failure("invalid-json"); }
    let doc=parsed.value;
    if type(doc)!="map" or len(map_keys(doc))!=2 or not map_has(doc,"format")
        or not map_has(doc,"jobs") or doc.format!="pblang.devops-pipeline.v1" {
        return _failure("invalid-document");
    }
    if selected {
        let jobs=try Ops.select_jobs(doc.jobs,targets) catch nil;
        if jobs==nil { return _failure("invalid-pipeline"); }
        let core=try _analyze(jobs,reveal==true) catch _failure("invalid-pipeline");
        return _target_report(core,len(doc.jobs),len(targets));
    }
    return try _analyze(doc.jobs,reveal==true) catch _failure("invalid-pipeline");
}
// Every ordinary parser/model failure is contained; no exception text escapes.
// Process termination, VM exhaustion and hostile imports are outside this API.
fn inspect_text(source,reveal_jobs=false) {
    return try _inspect(source,reveal_jobs) catch _failure("inspection-failed");
}
fn inspect_targets(source,targets,reveal_jobs=false) {
    let result=try _inspect(source,reveal_jobs,targets,true) catch _failure("inspection-failed");
    if result.format=="pblang.devops-target-inspection.v1" { return result; }
    return _target_report(result,0,0);
}
export inspect_text,inspect_targets;
