// Bounded display wrapping. Uses the existing cluster model; not full Unicode UAX29.
let Layout=import("stdlib:text_layout.sapp");
let Strings=import("stdlib:strings.sapp");
fn _integer(n,low,high) { if type(n)!="number" or not (n>=low and n<=high) or n!=num_floor(n) { throw "text pages: invalid dimensions"; } }
fn wrap(text,columns=40) {
    _integer(columns,1,120);
    if type(text)!="string" or len(text)>8192 or len(str_to_bytes(text))>8192 { throw "text pages: text limit"; }
    text=Strings.replace_all(text,"\r\n","\n");
    let visible=[];
    for i in range(0,len(text)) {
        let c=strcharcodeat(text,i);
        if c==9 { array_push(visible,"    "); }
        elif c==13 { array_push(visible,"\n"); }
        elif (c<32 and c!=10) or c==127 { array_push(visible,"�"); }
        else { array_push(visible,str_slice(text,i,i+1)); }
    }
    text=str_join(visible,""); // Display normalization never changes the source model.
    let lines=[];
    for paragraph in str_split(text,"\n") {
        let parts=[]; let width=0;
        for cluster in Layout.clusters(paragraph) {
            if width+cluster.width>columns and len(parts)>0 { array_push(lines,str_join(parts,"")); parts=[]; width=0; }
            array_push(parts,cluster.text); width=width+cluster.width;
        }
        array_push(lines,str_join(parts,""));
    }
    return lines;
}
fn paginate(text,columns=40,rows=6) {
    _integer(rows,1,32); let lines=wrap(text,columns); let pages=[]; let page=[];
    for line in lines {
        if len(page)==rows { array_push(pages,page); page=[]; }
        if len(pages)>=256 { throw "text pages: page limit"; }
        array_push(page,line);
    }
    if len(page)>0 { array_push(pages,page); } return pages;
}
export wrap,paginate;
