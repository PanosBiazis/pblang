// Internal worker launch boundary. Keep this module free of library imports:
// spawn snapshots its module globals into every child VM. Importing the full
// async/thread API here duplicates unrelated code and closures per worker.
fn launch(task_fn) {
    // A future sends exactly one terminal envelope, including transfer failure.
    let ch = channel_buffered(1);
    let worker = try spawn(fn() {
        // spawn copies module globals into this child. Its unused launch closure
        // otherwise points back to this module and retains it after VM exit.
        // A native builtin has the same callable type without owning this module.
        launch = error;
        // send returns nil on success; false is reserved for the catch marker.
        // One boundary covers both task execution and result serialization.
        let sent = try send(ch.sender, map{ok: true, value: task_fn()}) catch false;
        if sent == false {
            // Functions and cyclic/deep values can fail wire conversion after
            // the task itself succeeds. Notify the owner with a plain envelope.
            try send(ch.sender, map{ok: false, value: nil}) catch nil;
            channel_close(ch.sender);
        }
    }) catch nil;
    if worker == nil {
        channel_close(ch.sender);
        throw "async.go: worker could not start";
    }
    return map{ channel: ch, worker: worker, resolved: false, _ok: false, _value: nil };
}
export launch;
