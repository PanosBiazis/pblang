// Internal worker launch boundary. Keep this module free of library imports:
// spawn snapshots its module globals into every child VM. Importing the full
// async/thread API here duplicates unrelated code and closures per worker.
fn launch(task_fn) {
    let ch = channel();
    let worker = try spawn(fn() {
        let msg = try map{ ok: true, value: task_fn() }
                  catch map{ ok: false, value: nil };
        send(ch.sender, msg);
    }) catch nil;
    if worker == nil {
        channel_close(ch.sender);
        throw "async.go: worker could not start";
    }
    return map{ channel: ch, worker: worker, resolved: false, _ok: false, _value: nil };
}
export launch;
