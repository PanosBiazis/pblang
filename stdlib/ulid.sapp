// stdlib/ulid.sapp — ULID: Universally Unique Lexicographically Sortable IDentifier.
//
// A 26-char Crockford base32 string = 48-bit millisecond timestamp (10 chars) + 80 bits
// of randomness (16 chars). Unlike UUIDv4, ULIDs sort by creation time as plain strings,
// which makes them ideal database keys. Case-insensitive, URL-safe, no special chars.
//
//   let ulid = import("stdlib:ulid.sapp");
//   let id = ulid.new();              // "01ARZ3NDEKTSV4RRFFQ69G5FAV"
//   ulid.timestamp(id);              // the creation time in unix ms
//   ulid.is_valid(id);               // true

// Crockford base32 alphabet (excludes I, L, O, U to avoid ambiguity).
let _ALPHA = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";

fn _alpha_index(ch) {
    let i = 0;
    while i < 32 { if str_slice(_ALPHA, i, i + 1) == ch { return i; } i = i + 1; }
    return 0 - 1;
}

// _encode_time(ms) — 48-bit timestamp as 10 Crockford base32 chars (big-endian).
fn _encode_time(ms) {
    let v = num_floor(ms);
    let digits = [];
    let i = 0;
    while i < 10 { array_push(digits, num_mod(v, 32)); v = num_floor(v / 32); i = i + 1; }
    let out = "";
    let j = 9;
    while j >= 0 { out = out + str_slice(_ALPHA, digits[j], digits[j] + 1); j = j - 1; }
    return out;
}

// _decode_time(s10) — the 10 timestamp chars back into a unix-ms number.
fn _decode_time(s10) {
    let v = 0;
    let i = 0;
    while i < 10 {
        let d = _alpha_index(str_slice(s10, i, i + 1));
        if d < 0 { return 0 - 1; }
        v = v * 32 + d;
        i = i + 1;
    }
    return v;
}

// new() — a fresh ULID for the current time.
fn new() {
    let ts = _encode_time(now_ms());
    let rb = random_bytes(16);
    let rand = "";
    let i = 0;
    while i < 16 { rand = rand + str_slice(_ALPHA, num_mod(rb[i], 32), num_mod(rb[i], 32) + 1); i = i + 1; }
    return ts + rand;
}

// from_time(ms) — a ULID whose timestamp section encodes a specific time.
fn from_time(ms) {
    let ts = _encode_time(ms);
    let rb = random_bytes(16);
    let rand = "";
    let i = 0;
    while i < 16 { rand = rand + str_slice(_ALPHA, num_mod(rb[i], 32), num_mod(rb[i], 32) + 1); i = i + 1; }
    return ts + rand;
}

// is_valid(s) — 26 Crockford-base32 chars.
fn is_valid(s) {
    if type(s) != "string" or len(s) != 26 { return false; }
    let i = 0;
    while i < 26 { if _alpha_index(str_slice(s, i, i + 1)) < 0 { return false; } i = i + 1; }
    return true;
}

// timestamp(s) — the unix-ms creation time encoded in a ULID (nil if invalid).
fn timestamp(s) {
    if not is_valid(s) { return nil; }
    return _decode_time(str_slice(s, 0, 10));
}

export new, from_time, is_valid, timestamp;
