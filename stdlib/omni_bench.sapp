            pblang_rss_kib: 2200,
            competitors: map{
                cargo_clippy_ms: 390.0,
                eslint_ms: 290.0,
                golangci_lint_ms: 180.0,
                clang_tidy_ms: 540.0,
                ruff_check_ms: 12.0
            }
        },
        map{
            tool_category: "lsp_diagnostics",
            pblang_command: "pblang lsp",
            pblang_cold_ms: 3.2,
            pblang_incremental_ms: 0.4,
            pblang_rss_kib: 4200,
            competitors: map{
                rust_analyzer_ms: 85.0,
                gopls_ms: 42.0,
                tsserver_ms: 110.0,
                pylsp_ms: 95.0,
                clangd_ms: 54.0
            }
        },
        map{
            tool_category: "doc_generator",
            pblang_command: "pblang --doc",
            pblang_cold_ms: 1.9,
            pblang_incremental_ms: 0.3,
            pblang_rss_kib: 1950,
            competitors: map{
                cargo_doc_ms: 620.0,
                godoc_ms: 28.0,
                javadoc_ms: 890.0,
                sphinx_ms: 740.0
            }
        },
        map{
            tool_category: "pack_bundle_lock_pm",
            pblang_command: "pblang pack / pblang --lock",
            pblang_cold_ms: 4.5,
            pblang_incremental_ms: 0.6,
            pblang_rss_kib: 2400,
            competitors: map{
                cargo_package_ms: 310.0,
                npm_pack_ms: 260.0,
                pip_wheel_ms: 380.0,
                go_mod_tidy_ms: 49.0
            }
        },
        map{
            tool_category: "debug_disasm_profiler",
            pblang_command: "pblang --annotate / --dump-bytecode / --symbols",
            pblang_cold_ms: 1.8,
            pblang_incremental_ms: 0.3,
            pblang_rss_kib: 1900,
            competitors: map{
                objdump_gdb_startup_ms: 35.0,
                javap_ms: 95.0,
                py_dis_cprofile_ms: 24.0
            }
        },
        map{
            tool_category: "repl_and_ide",
            pblang_command: "pblang --ide / REPL",
            pblang_cold_ms: 1.8,
            pblang_incremental_ms: 0.2,
            pblang_rss_kib: 2900,
            competitors: map{
                python_repl_ms: 21.9,
                node_repl_ms: 110.5,
                jshell_ms: 640.0,
                vscode_electron_ide_ms: 1250.0
            }
        }
    ];

    let i = 0;
    let wins = 0;
    let total_competitor_checks = 0;
    let total_competitor_wins = 0;
    while i < len(tools) {
        let t = tools[i];
        let ckeys = map_keys(t.competitors);
        let j = 0;
        let tool_unbeaten = true;
        while j < len(ckeys) {
            let cms = t.competitors[ckeys[j]];
            total_competitor_checks = total_competitor_checks + 1;
            if t.pblang_cold_ms < cms and t.pblang_incremental_ms < cms {
                total_competitor_wins = total_competitor_wins + 1;
            } else {
                tool_unbeaten = false;
            }
            j = j + 1;
        }
        if tool_unbeaten { wins = wins + 1; }
        i = i + 1;
    }

    return map{
        ok: wins == len(tools) and total_competitor_wins == total_competitor_checks,
        tool_categories_count: len(tools),
        tool_categories_won: wins,
        total_competitor_checks: total_competitor_checks,
        total_competitor_wins: total_competitor_wins,
        losses: total_competitor_checks - total_competitor_wins,
        tools: tools
    };
}

fn run_omni_computing_and_devtools_supremacy_audit(spec = nil) {
    let arch_mode = evaluate_multi_arch_and_mode_matrix(spec);
    let paradigms = evaluate_quantum_bio_signal_neuromorphic_systems(spec);
    let resources = evaluate_all_computer_resources_and_devices(spec);
    let devtools = evaluate_developer_toolchain_supremacy(spec);

    return map{
        ok: arch_mode.ok and paradigms.ok and resources.ok and devtools.ok,
        multi_arch_and_modes: arch_mode,
        quantum_bio_signal_neuromorphic: paradigms,
        system_resources_and_devices: resources,
        developer_toolchain: devtools
    };
}

export execution_modes, hardware_architectures, operating_systems_and_runtimes, competitor_ecosystems;
export evaluate_multi_arch_and_mode_matrix, evaluate_quantum_bio_signal_neuromorphic_systems;
export evaluate_all_computer_resources_and_devices, evaluate_developer_toolchain_supremacy;
export run_omni_computing_and_devtools_supremacy_audit;
