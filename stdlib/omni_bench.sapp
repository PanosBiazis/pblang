        map{ id: "go", era: "present", category: "compiled", tool: "go", base_compile_ms: 43.0, base_run_ms: 8.27, base_rss_kib: 1500, base_bin_bytes: 1228952 },
        map{ id: "zig", era: "present", category: "compiled", tool: "zig", base_compile_ms: 62.0, base_run_ms: 5.20, base_rss_kib: 1120, base_bin_bytes: 9800 },
        map{ id: "java", era: "present", category: "vm", tool: "javac+java", base_compile_ms: 489.0, base_run_ms: 47.23, base_rss_kib: 40736, base_bin_bytes: 423 },
        map{ id: "csharp", era: "present", category: "vm", tool: "mcs+mono", base_compile_ms: 136.0, base_run_ms: 26.54, base_rss_kib: 16128, base_bin_bytes: 3072 },
        map{ id: "python", era: "present", category: "interpreter", tool: "python3", base_compile_ms: 21.9, base_run_ms: 181.95, base_rss_kib: 10488, base_bin_bytes: 1024 },
        map{ id: "javascript", era: "present", category: "jit", tool: "node", base_compile_ms: 110.5, base_run_ms: 126.54, base_rss_kib: 47408, base_bin_bytes: 1024 },
