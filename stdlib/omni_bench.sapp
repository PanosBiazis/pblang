        map{ id: "fortran", era: "legacy", category: "compiled", tool: "gfortran", base_compile_ms: 85.0, base_run_ms: 4.8, base_rss_kib: 2200, base_bin_bytes: 18400 },
        map{ id: "cobol", era: "legacy", category: "compiled", tool: "cobc", base_compile_ms: 140.0, base_run_ms: 14.5, base_rss_kib: 4100, base_bin_bytes: 32000 },
