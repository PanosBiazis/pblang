        map{ id: "mojo", era: "future", category: "compiled", tool: "mojo", base_compile_ms: 95.0, base_run_ms: 4.50, base_rss_kib: 8400, base_bin_bytes: 65536 },
        map{ id: "carbon", era: "future", category: "compiled", tool: "carbon", base_compile_ms: 180.0, base_run_ms: 6.10, base_rss_kib: 3100, base_bin_bytes: 24576 },
        map{ id: "bend_hvm", era: "future", category: "jit", tool: "bend", base_compile_ms: 110.0, base_run_ms: 9.80, base_rss_kib: 12400, base_bin_bytes: 49152 },
        map{ id: "qiskit_qsharp", era: "quantum", category: "specialized", tool: "qiskit", base_compile_ms: 240.0, base_run_ms: 68.0, base_rss_kib: 64000, base_bin_bytes: 8192 },
        map{ id: "biopython_cello", era: "biocomputing", category: "specialized", tool: "biopython", base_compile_ms: 130.0, base_run_ms: 92.0, base_rss_kib: 38000, base_bin_bytes: 4096 },
        map{ id: "matlab_gnuradio", era: "signal_dsp", category: "specialized", tool: "gnuradio", base_compile_ms: 210.0, base_run_ms: 34.0, base_rss_kib: 52000, base_bin_bytes: 16384 },
        map{ id: "lava_brian2", era: "neuromorphic", category: "specialized", tool: "lava", base_compile_ms: 155.0, base_run_ms: 41.0, base_rss_kib: 29000, base_bin_bytes: 8192 }
