        map{ id: "c", era: "present", category: "compiled", tool: "gcc", base_compile_ms: 39.5, base_run_ms: 7.62, base_rss_kib: 1304, base_bin_bytes: 14472 },
        map{ id: "cpp", era: "present", category: "compiled", tool: "g++", base_compile_ms: 329.0, base_run_ms: 8.35, base_rss_kib: 3448, base_bin_bytes: 16312 },
