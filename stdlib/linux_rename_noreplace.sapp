// Linux x86-64 renameat2(RENAME_NOREPLACE) helper generated entirely by PBLang.
//
// The caller supplies already-held, inheritable parent directory descriptors.
// Path components are embedded as inert NUL-terminated data in a static ELF;
// no shell, dynamic loader, compiler, or mutable argv interpretation is used.

let X = import("stdlib:codegen_x64.sapp");

let LOAD_BASE = 0x400000;
let ELF_HEADER_BYTES = 120;
let SYS_RENAMEAT2_X86_64 = 316;
let RENAME_NOREPLACE = 1;

fn _append(dst, src) {
    for i len(src) { dst[len(dst)] = src[i]; }
    return dst;
}

fn _component(value, label) {
    if type(value) != "string" or len(value) < 1 or len(value) > 255
       or value == "." or value == ".." or str_contains(value, "/")
       or str_contains(value, strfromcharcode(0)) {
        throw "linux_rename_noreplace: invalid " + label;
    }
    let out = str_to_bytes(value); out[len(out)] = 0; return out;
}

fn _fd(value, label) {
    if type(value) != "number" or value != num_floor(value)
       or value < 0 or value > 4194304 {
        throw "linux_rename_noreplace: invalid " + label;
    }
    return value;
}

fn _set_rel32(code, position, target) {
    let delta = target - (position + 4);
    if delta < -2147483648 or delta > 2147483647 {
        throw "linux_rename_noreplace: branch exceeds rel32";
    }
    if delta < 0 { delta = 4294967296 + delta; }
    let bytes = X.le32(delta);
    for i 4 { code[position + i] = bytes[i]; }
}

fn _emit(from_fd, from_address, to_fd, to_address) {
    let code = [];
    _append(code, X.mov_imm32("rax", SYS_RENAMEAT2_X86_64));
    _append(code, X.mov_imm32("rdi", from_fd));
    _append(code, X.movabs_imm64("rsi", from_address));
    _append(code, X.mov_imm32("rdx", to_fd));
    // movabs r10, imm64 and mov r8d, imm32.
    _append(code, [0x49, 0xBA]); _append(code, X.le64(to_address));
    _append(code, [0x41, 0xB8]); _append(code, X.le32(RENAME_NOREPLACE));
    _append(code, X.syscall());
    _append(code, [0x48, 0x85, 0xC0]);
    // js failure
    _append(code, [0x0F, 0x88]); let failure_branch = len(code);
    _append(code, [0, 0, 0, 0]);
    _append(code, X.mov_imm32("rax", 60));
    _append(code, X.mov_imm32("rdi", 0));
    _append(code, X.syscall());
    let failure = len(code);
    _append(code, X.mov_imm32("rax", 60));
    _append(code, X.mov_imm32("rdi", 1));
    _append(code, X.syscall());
    _set_rel32(code, failure_branch, failure);
    return code;
}

fn build(from_fd, from_name, to_fd, to_name) {
    from_fd = _fd(from_fd, "source descriptor");
    to_fd = _fd(to_fd, "destination descriptor");
    let from_bytes = _component(from_name, "source name");
    let to_bytes = _component(to_name, "destination name");
    let probe = _emit(from_fd, 0, to_fd, 0);
    let from_address = LOAD_BASE + ELF_HEADER_BYTES + len(probe);
    let to_address = from_address + len(from_bytes);
    let code = _emit(from_fd, from_address, to_fd, to_address);
    let data = []; _append(data, from_bytes); _append(data, to_bytes);
    return X.elf64_exec_rx(code, data);
}

fn info() {
    return map{
        format: "pblang.linux-rename-noreplace.v1",
        platform: "linux", architecture: "x86_64",
        syscall: "renameat2", flag: "RENAME_NOREPLACE",
        no_shell: true, external_compiler: false, static_elf: true
    };
}

export build, info;
