// stdlib/diagnostics.sapp — smart error/warning detection + suggestions for pblang.
//
// Rust-style diagnostics, written in pblang (self-hosted). It is the single source of
// truth for smart checks: the watchers (stdlib/watch.sapp) and the `pblang check` CLI
// both delegate here, so the logic is never duplicated.
//
// Pipeline: source -> self-hosted frontend (AST) -> semantic analysis (scopes/symbols)
//           -> smart layer (did-you-mean, unused, pitfalls, unreachable) -> diagnostics.
//
// A diagnostic is a map:
//   { severity: "error"|"warning"|"hint", code, message, name?, suggestion?, line, help?, fix? }
// A fix (when autofixable) is a map: { kind: "replace_identifier", from, to } or { kind: "remove_binding", name }.
//
// Usage:
//   let dx = import("stdlib:diagnostics.sapp");
//   let r = dx.diagnose(source);   // { ok, diagnostics, errors, warnings, hints, counts }
//   print dx.format(r);
//   let f = dx.autofix(source);    // { fixed, applied, count }

let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let SEM = import("stdlib:compiler/semantic.sapp");
let BL = import("stdlib:compiler/builtins_list.sapp");
let DS = import("stdlib:compiler/diagnostic_suggestions.sapp");
let TOK = import("stdlib:compiler/tokenizer.sapp");
let PAR = import("stdlib:compiler/parser.sapp");

// ── edit distance (Levenshtein), the core of "did you mean?" ──────────────────────
fn edit_distance(a, b) {
    let la = len(a);
    let lb = len(b);
    if la == 0 { return lb; }
    if lb == 0 { return la; }
    let prev = [];
    let j = 0;
    while j <= lb { array_push(prev, j); j = j + 1; }
    let i = 1;
    while i <= la {
        let cur = [i];
        let jj = 1;
        while jj <= lb {
            let cost = 1;
            if a[i - 1] == b[jj - 1] { cost = 0; }
            let del = prev[jj] + 1;
            let ins = cur[jj - 1] + 1;
            let sub = prev[jj - 1] + cost;
            let m = del;
            if ins < m { m = ins; }
            if sub < m { m = sub; }
            array_push(cur, m);
            jj = jj + 1;
        }
        prev = cur;
        i = i + 1;
    }
    return prev[lb];
}

// suggest_name(name, candidates) — closest candidate within an adaptive threshold,
// or nil. Short names get a stricter threshold to avoid silly suggestions.
fn suggest_name(name, candidates) {
    return DS.suggest_name(name, candidates);
}

// ── candidate gathering from the semantic symbol table + builtins ─────────────────
fn _candidates(table, name, bset) {
    let acc = map_keys(try table.free_contexts[name] catch map{});
    let bks = map_keys(bset);
    let i = 0;
    while i < len(bks) { array_push(acc, bks[i]); i = i + 1; }
    return acc;
}

// ── unused-symbol detection (reads Symbol.references recorded by semantic) ─────────
fn _collect_unused(scope, diags) {
    if scope == nil { return; }
    let ks = map_keys(scope.symbols);
    let i = 0;
    while i < len(ks) {
        let sym = scope.symbols[ks[i]];
        let kind = try sym.kind catch "variable";
        let refs = try sym.references catch [];
        let exported = try sym.is_exported catch false;
        let nm = try sym.name catch ks[i];
        let is_var = kind == "let" or kind == "const" or kind == "variable";
        // `_`/`_name` is the declared intentionally-unused convention (it is
        // what this very warning's help text tells people to write).
        let deliberate = str_starts_with(nm, "_");
        if (is_var or kind == "import") and len(refs) == 0 and not exported and not deliberate {
            let code = "unused-variable";
            let msg = "unused variable `" + nm + "`";
            if kind == "import" { code = "unused-import"; msg = "unused import `" + nm + "`"; }
            array_push(diags, map{
                severity: "warning", code: code, message: msg, name: nm,
                line: try sym.defined_line catch 0,
                help: "remove it, or prefix with `_` if it is intentionally unused",
                fix: map{ kind: "remove_binding", name: nm },
            });
        }
        i = i + 1;
    }
    let ch = try scope.children catch [];
    let c = 0;
    while c < len(ch) { _collect_unused(ch[c], diags); c = c + 1; }
}

// ── AST-based reliable lints: unreachable-after-return/throw + self-assignment ────
// Subtle semantic pitfalls (catch-binding, ??-vs-throw) are intentionally NOT pattern
// matched here: reliable static detection is false-positive-prone, and noisy lints
// erode trust. Only checks that are provably correct from the AST are emitted.

// A "body" in the AST is a block node map{kind, stmts}; normalize to a stmt array.
fn _block_stmts(b) {
    if b == nil { return []; }
    if type(b) == "array" { return b; }
    let s = try b.stmts catch nil;
    if s == nil { return []; }
    return s;
}

fn _child_stmt_lists(stmt) {
    let out = [];
    let k = stmt.kind;
    if k == "fn" or k == "block" or k == "while" or k == "for" or k == "for_in" or k == "for_range" {
        array_push(out, _block_stmts(try stmt.body catch nil));
    } else if k == "if" {
        array_push(out, _block_stmts(try stmt.then catch nil));
        let e = try stmt.else catch nil;
        if e != nil { array_push(out, _block_stmts(e)); }
    }
    return out;
}

// Conservative structural equality for expressions whose evaluation cannot
// call user code or mutate state. This deliberately supports only the shapes
// needed by eq-op; unknown nodes are treated as different.
fn _pure_expr_equal(a, b, depth = 0) {
    if a == nil or b == nil or depth > 32 { return false; }
    let ak = try a.kind catch "";
    let bk = try b.kind catch "";
    if ak != bk { return false; }
    if ak == "ident" { return (try a.name catch "") == (try b.name catch ""); }
    if ak == "number" or ak == "string" or ak == "bool" {
        return (try a.value catch nil) == (try b.value catch nil);
    }
    if ak == "nil" { return true; }
    if ak == "member" or ak == "opt_member" {
        return (try a.name catch "") == (try b.name catch "")
            and _pure_expr_equal(try a.obj catch nil, try b.obj catch nil, depth + 1);
    }
    if ak == "index" or ak == "opt_index" {
        return _pure_expr_equal(try a.obj catch nil, try b.obj catch nil, depth + 1)
            and _pure_expr_equal(try a.index catch nil, try b.index catch nil, depth + 1);
    }
    if ak == "unary" {
        return (try a.op catch "") == (try b.op catch "")
            and _pure_expr_equal(try a.operand catch nil, try b.operand catch nil, depth + 1);
    }
    return false;
}

fn _eq_op_message(op) {
    if op == "-" { return "subtracting an expression from itself always produces zero for ordinary finite values"; }
    if op == "/" or op == "%" { return "both operands of this arithmetic expression are identical"; }
    return "a value cannot be strictly ordered before or after itself";
}

fn _lint_expr(expr, diags, depth = 0) {
    if expr == nil or depth > 128 { return; }
    let k = try expr.kind catch "";
    if k == "binary" {
        let op = try expr.op catch "";
        // Equality and non-strict comparisons are intentionally excluded:
        // `x != x`, `x == x`, `x <= x`, and `x >= x` are valid IEEE-754 NaN
        // classification idioms when the static type is not yet precise enough.
        let suspicious = op == "-" or op == "/" or op == "%" or op == "<" or op == ">";
        if suspicious and _pure_expr_equal(expr.left, expr.right) {
            array_push(diags, map{
                severity: "warning", code: "eq-op", message: _eq_op_message(op),
                line: try expr.line catch 0,
                help: "use distinct operands, or document and rewrite the intended calculation",
                fix: nil,
            });
        }
        _lint_expr(expr.left, diags, depth + 1);
        _lint_expr(expr.right, diags, depth + 1);
        return;
    }
    if k == "unary" { _lint_expr(try expr.operand catch nil, diags, depth + 1); return; }
    if k == "call" {
        _lint_expr(try expr.func catch nil, diags, depth + 1);
        let args = try expr.args catch []; let ai = 0;
        while ai < len(args) { _lint_expr(args[ai], diags, depth + 1); ai = ai + 1; }
        return;
    }
    if k == "assign" { _lint_expr(try expr.value catch nil, diags, depth + 1); return; }
    if k == "assign_to" {
        _lint_expr(try expr.target catch nil, diags, depth + 1);
        _lint_expr(try expr.value catch nil, diags, depth + 1);
        return;
    }
    if k == "array" {
        let items = try expr.items catch []; let ii = 0;
        while ii < len(items) { _lint_expr(items[ii], diags, depth + 1); ii = ii + 1; }
        return;
    }
    if k == "map" {
        let entries = try expr.entries catch []; let ei = 0;
        while ei < len(entries) { _lint_expr(try entries[ei].value catch nil, diags, depth + 1); ei = ei + 1; }
        return;
    }
    if k == "index" or k == "opt_index" {
        _lint_expr(try expr.obj catch nil, diags, depth + 1);
        _lint_expr(try expr.index catch nil, diags, depth + 1);
        return;
    }
    if k == "member" or k == "opt_member" { _lint_expr(try expr.obj catch nil, diags, depth + 1); return; }
    if k == "coalesce" {
        _lint_expr(try expr.left catch nil, diags, depth + 1);
        _lint_expr(try expr.right catch nil, diags, depth + 1);
        return;
    }
    if k == "throw" { _lint_expr(try expr.value catch nil, diags, depth + 1); return; }
    if k == "try" {
        _lint_expr(try expr.body catch nil, diags, depth + 1);
        _lint_expr(try expr.handler catch nil, diags, depth + 1);
    }
}

fn _lint_stmt_exprs(stmt, diags) {
    let k = stmt.kind;
    if k == "let" or k == "const" or k == "return" or k == "print" {
        _lint_expr(try stmt.value catch nil, diags); return;
    }
    if k == "expr_stmt" { _lint_expr(try stmt.expr catch nil, diags); return; }
    if k == "if" or k == "while" { _lint_expr(try stmt.cond catch nil, diags); return; }
    if k == "for" { _lint_expr(try stmt.end catch nil, diags); return; }
    if k == "for_in" { _lint_expr(try stmt.iter catch nil, diags); return; }
    if k == "for_range" {
        _lint_expr(try stmt.start catch nil, diags);
        _lint_expr(try stmt.end catch nil, diags);
    }
}

fn _lint_stmt_list(stmts, diags) {
    let terminated = false;
    let reported = false;
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        if terminated and not reported {
            array_push(diags, map{
                severity: "warning", code: "unreachable-code",
                message: "unreachable code", line: try s.line catch 0,
                help: "this statement follows a return/throw and can never run; remove it or restructure",
                fix: nil,
            });
            reported = true;
        }
        let k = s.kind;
        // assignment can be a bare stmt ("assign") or wrapped in an expr_stmt.
        let asn = nil;
        if k == "assign" { asn = s; }
        else if k == "expr_stmt" and (try s.expr.kind catch "") == "assign" { asn = s.expr; }
        if asn != nil {
            let v = try asn.value catch nil;
            if v != nil and (try v.kind catch "") == "ident" and (try v.name catch "") == (try asn.name catch "_") {
                array_push(diags, map{
                    severity: "warning", code: "self-assignment",
                    message: "`" + (try asn.name catch "?") + "` is assigned to itself",
                    line: try s.line catch 0, help: "this assignment has no effect", fix: nil,
                });
            }
        }
        _lint_stmt_exprs(s, diags);
        // return is its own stmt; throw is an expr_stmt wrapping a throw expression.
        if k == "return" or k == "throw" {
            terminated = true;
        } else if k == "expr_stmt" and (try s.expr.kind catch "") == "throw" {
            terminated = true;
        }
        let lists = _child_stmt_lists(s);
        let li = 0;
        while li < len(lists) { _lint_stmt_list(lists[li], diags); li = li + 1; }
        i = i + 1;
    }
}

fn _extra_lints(ast, diags) {
    if ast == nil { return; }
    let stmts = try ast.stmts catch nil;
    if stmts == nil { return; }
    _lint_stmt_list(stmts, diags);
}

// ── result assembly ────────────────────────────────────────────────────────────────
fn _result(diags) {
    let errors = [];
    let warnings = [];
    let hints = [];
    let i = 0;
    while i < len(diags) {
        let sev = diags[i].severity;
        if sev == "error" { array_push(errors, diags[i]); }
        else if sev == "warning" { array_push(warnings, diags[i]); }
        else { array_push(hints, diags[i]); }
        i = i + 1;
    }
    return map{
        ok: len(errors) == 0,
        diagnostics: diags,
        errors: errors,
        warnings: warnings,
        hints: hints,
        counts: map{ error: len(errors), warning: len(warnings), hint: len(hints) },
    };
}

// ── pragmas ──────────────────────────────────────────────────────────────────────
// stdlib/kernel modules are lowered by the ctranspiler, whose freestanding
// preamble PROVIDES the OS intrinsics, and several modules are concatenated
// into one translation unit (gc.sapp calls heap.sapp's heap_alloc). Sources
// opt in explicitly so the checker stays sound everywhere else:
//   // pblang:target=kernel   — the ctranspile intrinsics below are defined
//   // pblang:extern a b c    — declared cross-unit symbols are defined

// The ctranspile freestanding preamble's symbols (see compiler/ctranspile.sapp).
fn _kernel_intrinsics() {
    return map{
        "outb": true, "inb": true, "hlt": true, "cli": true, "sti": true,
        "kmalloc": true, "kfree": true, "kreset": true,
        "poke8": true, "poke16": true, "poke32": true,
        "peek8": true, "peek16": true, "peek32": true,
        "swint": true, "swint80": true, "set_cr3": true, "read_cr2": true,
        "read_cs": true, "ltr": true, "lidt": true, "lgdt": true,
        "invlpg": true, "enable_paging": true, "enter_user": true,
        "ctx_switch": true,
    };
}

fn _is_kernel_target(source) {
    return str_contains(source, "pblang:target=kernel");
}

// Names listed on `// pblang:extern n1 n2 ...` lines (any number of lines).
fn _extern_names(source) {
    let out = map{};
    let lines = str_split(source, "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        i = i + 1;
        let at = str_index_of(line, "pblang:extern");
        if at < 0 { continue; }
        let rest = str_trim(str_slice(line, at + len("pblang:extern"), len(line)));
        let parts = str_split(rest, " ");
        let j = 0;
        while j < len(parts) {
            let nm = str_trim(parts[j]);
            if nm != "" { out[nm] = true; }
            j = j + 1;
        }
    }
    return out;
}

// ── main entry: diagnose(source) ─────────────────────────────────────────────────
fn _diagnose(source, source_spans = false) {
    let parsed = FE.frontend_parse_safe(source);
    if source_spans and parsed.ok {
        // The normal frontend already checked lexer termination and grammar.
        // Reparse opt-in token offsets without changing default AST schemas.
        parsed.ast = PAR.parse(TOK.tokenize(source, true));
    }
    let diags = [];

    let perrs = try parsed.errors catch [];
    let pe = 0;
    while pe < len(perrs) {
        array_push(diags, map{
            severity: "error", code: "parse-error", message: str(perrs[pe]),
            name: nil, line: 0, help: nil, fix: nil,
        });
        pe = pe + 1;
    }

    let ast = try parsed.ast catch nil;
    if ast != nil {
        let table = SEM.analyze(ast, true);

        let fv = try table.free_variables catch [];
        let bset = try BL.builtin_set() catch map{};
        let kern = _is_kernel_target(source);
        let kset = if kern { _kernel_intrinsics() } else { map{} };
        let externs = _extern_names(source);
        let i = 0;
        while i < len(fv) {
            let name = fv[i];
            // builtins are provided by the VM, not the source — never "undefined".
            // (Without this filter every len/str/num_floor call-site was an error.)
            if (try bset[name] catch nil) == true { i = i + 1; continue; }
            // opt-in pragmas: ctranspile intrinsics / declared cross-unit names
            if kern and (try kset[name] catch nil) == true { i = i + 1; continue; }
            if (try externs[name] catch nil) == true { i = i + 1; continue; }
            let s = suggest_name(name, _candidates(table, name, bset));
            let help: any = nil;
            let fix: any = nil;
            if s != nil {
                help = "did you mean `" + s + "`?";
                fix = map{ kind: "replace_identifier", from: name, to: s };
            }
            array_push(diags, map{
                severity: "error", code: "undefined-name",
                message: "cannot find name `" + name + "` in this scope",
                name: name, suggestion: s, line: 0, help: help, fix: fix,
            });
            i = i + 1;
        }

        _collect_unused(table.global_scope, diags);
        _extra_lints(ast, diags);
        if source_spans {
            let result = _result(diags);
            result.autofix_sites = table.free_sites;
            result.autofix_truncated = table.free_sites_truncated;
            return result;
        }
    }

    return _result(diags);
}

fn diagnose(source) { return _diagnose(source); }

// suggest(source) — just the actionable did-you-mean items: [{name, suggestion}].
fn suggest(source) {
    let r = diagnose(source);
    let out = [];
    let i = 0;
    while i < len(r.diagnostics) {
        let d = r.diagnostics[i];
        if d.code == "undefined-name" and (try d.suggestion catch nil) != nil {
            array_push(out, map{ name: d.name, suggestion: d.suggestion });
        }
        i = i + 1;
    }
    return out;
}

// Bounded, all-or-nothing source edits. Offsets are Unicode scalar indexes,
// not byte offsets. No source execution or filesystem effects occur here.
fn autofix(source) {
    let unchanged = map{fixed:source, applied:[], count:0};
    if type(source)!="string" or len(source)>65536 { return unchanged; }
    let r = _diagnose(source, true);
    if r.ok or len(r.errors)>256 or (try r.autofix_truncated catch true) { return unchanged; }
    let fixes = map{};
    for d in r.errors {
        let fix = try d.fix catch nil;
        if d.code!="undefined-name" or fix==nil or fix.kind!="replace_identifier" { return unchanged; }
        fixes[fix.from] = fix.to;
    }
    let positions = []; let edits = map{}; let covered = map{};
    for site in r.autofix_sites {
        if map_has(fixes, site.name) {
            if type(site.start)!="number" or type(site.end)!="number" { return unchanged; }
            if site.start<0 or site.end<=site.start or site.end>len(source)
                or str_slice(source,site.start,site.end)!=site.name { return unchanged; }
            let key = str(site.start);
            if not map_has(edits,key) { array_push(positions,site.start); }
            edits[key] = map{end:site.end, from:site.name, to:fixes[site.name]};
            covered[site.name] = true;
        }
    }
    if len(map_keys(covered))!=len(map_keys(fixes)) { return unchanged; }
    positions = array_sort(positions);
    let pieces = []; let cursor = 0;
    for start in positions {
        let edit = edits[str(start)];
        if start<cursor { return unchanged; }
        array_push(pieces,str_slice(source,cursor,start)); array_push(pieces,edit.to);
        cursor=edit.end;
    }
    array_push(pieces,str_slice(source,cursor,len(source)));
    let fixed = str_join(pieces,"");
    if not diagnose(fixed).ok { return unchanged; }
    let applied = [];
    for d in r.errors { array_push(applied,map{kind:"replace_identifier",from:d.name,to:fixes[d.name]}); }
    return map{fixed:fixed, applied:applied, count:len(applied)};
}

// format(result) — Rust-style human-readable rendering of a diagnose() result.
fn format(result) {
    if len(result.diagnostics) == 0 { return "no issues found\n"; }
    let out = "";
    let i = 0;
    while i < len(result.diagnostics) {
        let d = result.diagnostics[i];
        let loc = "";
        let ln = try d.line catch 0;
        if ln != nil and ln > 0 { loc = ":" + str(ln); }
        out = out + d.severity + "[" + d.code + "]" + loc + ": " + d.message + "\n";
        let help = try d.help catch nil;
        if help != nil { out = out + "  = help: " + help + "\n"; }
        i = i + 1;
    }
    out = out + "\n" + str(result.counts.error) + " error(s), "
              + str(result.counts.warning) + " warning(s), "
              + str(result.counts.hint) + " hint(s)\n";
    return out;
}

export edit_distance, suggest_name, diagnose, suggest, autofix, format;
