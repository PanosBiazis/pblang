fn list_competitor_eras() {
    return [
        map{
            era_id: "legacy_foundational",
            title_el: "Κλασικές / Εδραιωμένες Γλώσσες (1957–2008)",
            competitors: ["C", "C++23", "Fortran", "Delphi / Object Pascal", "Java / JVM", "C# / .NET", "Python", "JavaScript / Node.js", "SQL / PL-SQL", "Erlang"]
        },
        map{
