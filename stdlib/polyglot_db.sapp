// stdlib/polyglot_db.sapp — Database Polyglot Bridge for pblang
//
// Provides unified database connectivity across SQLite, PostgreSQL,
// MySQL/MariaDB, MongoDB, and Redis. Leverages the polyglot subprocess
// bridge to execute SQL / NoSQL queries via native CLI tools.
//
// Usage:
//   let db = import("stdlib:polyglot_db.sapp");
//   let result = db.query("sqlite", "mydb.sqlite", "SELECT * FROM users");
//   let result = db.query("postgresql", "host=localhost dbname=mydb", "SELECT now()");
//   let result = db.query("mysql", "-u root mydb", "SHOW TABLES");
//   let result = db.query("redis", "", "PING");

import "stdlib:polyglot.sapp";

// ── Connection string builders ────────────────────────────────────────────────

fn sqlite_conn(path) {
    if path == "" or path == ":memory:" { return ":memory:"; }
    return path;
}

fn postgres_conn(host, port, user, password, dbname) {
    if port == nil or port == "" { port = "5432"; }
    let conn = "postgresql://";
    if user != "" { conn = conn + user; }
    if password != "" { conn = conn + ":" + password; }
    conn = conn + "@" + host + ":" + port;
    if dbname != "" { conn = conn + "/" + dbname; }
    return conn;
}

fn mysql_conn(host, port, user, password, dbname) {
    if port == nil or port == "" { port = "3306"; }
    let conn = "-h " + host;
    if port != "" { conn = conn + " -P " + port; }
    if user != "" { conn = conn + " -u " + user; }
    if password != "" { conn = conn + " -p" + password; }
    if dbname != "" { conn = conn + " " + dbname; }
    return conn;
}

fn mongodb_conn(host, port, dbname) {
    if port == nil or port == "" { port = "27017"; }
    let conn = "mongodb://" + host + ":" + port;
    if dbname != "" { conn = conn + "/" + dbname; }
    return conn;
}

fn redis_conn(host, port) {
    if port == nil or port == "" { port = "6379"; }
    return "-h " + host + " -p " + port;
}

// ── Query execution ───────────────────────────────────────────────────────────

fn _escape_sql(s) {
    let r = str_replace_all(s, "'", "'\\''");
    return r;
}

// escape_arg(s) — quote a string as a single, safe POSIX shell token. Wrapping in
// single quotes neutralizes every metacharacter; an embedded ' becomes '\''.
fn escape_arg(s) {
    return "'" + str_replace_all(str(s), "'", "'\\''") + "'";
}

// escape_sql(s) — single-quote escaping for a value inside a shell `-c '...'` context.
fn escape_sql(s) { return _escape_sql(s); }

// _has_shell_meta(s) — true if s contains a character that a shell would interpret.
// Used to reject inputs that cannot be safely passed as multi-token argv (redis).
fn _has_shell_meta(s) {
    let meta = [";", "|", "&", "`", "$", ">", "<", "(", ")", "\n", "\r", "\\", "\""];
    let i = 0;
    while i < len(meta) {
        if str_index_of(s, meta[i]) >= 0 { return true; }
        i = i + 1;
    }
    return false;
}

// query(lang, conn_string, sql_or_command) — execute a query against a database
fn query(lang, conn, command) {
    if lang == "sqlite" {
        let code = ".mode json\n" + command + ";";
        let tmp = "/tmp/pblang_sql_" + str(random_float()) + str(now_ms()) + ".sql";
        fs_write(tmp, code);
        // SECURITY: quote the db path (conn) so it is one shell token (was raw).
        let result = exec("sqlite3 " + escape_arg(conn) + " < " + escape_arg(tmp) + " 2>&1");
        try fs_remove(tmp) catch nil;
        return _parse_db_result("sqlite", result);
    }

    if lang == "postgresql" or lang == "psql" or lang == "pg" {
        // conn is a single conninfo/dbname token → quote it; command stays in -c '...'.
        let result = exec("psql " + escape_arg(conn) + " -c '" + _escape_sql(command) + "' -t 2>&1");
        return _parse_db_result("postgresql", result);
    }

    if lang == "mysql" or lang == "mariadb" {
        let result = exec("mysql " + escape_arg(conn) + " -e '" + _escape_sql(command) + "' 2>&1");
        return _parse_db_result("mysql", result);
    }

    if lang == "mongodb" or lang == "mongo" {
        let result = exec("mongosh " + escape_arg(conn) + " --eval '" + _escape_sql(command) + "' 2>&1");
        return _parse_db_result("mongodb", result);
    }

    if lang == "redis" {
        // SECURITY: redis-cli takes conn as multi-token flags ("-h h -p p") and the
        // command as bare words, neither of which can be safely single-quoted as one
        // token. The previous code concatenated `command` with NO escaping at all
        // (shell injection). Since safe quoting isn't possible here, reject any input
        // containing shell metacharacters rather than execute it.
        if _has_shell_meta(conn) or _has_shell_meta(command) {
            return map{ ok: false, language: "redis", stdout: "", stderr: "",
                        error: "unsafe characters in redis conn/command rejected", data: nil,
                        exit_code: 0 - 1 };
        }
        let result = exec("redis-cli " + conn + " " + command + " 2>&1");
        return _parse_db_result("redis", result);
    }

    // Fallback: use generic polyglot exec for SQL
    let code = command;
    if lang == "sqlite" {
        code = ".mode json\n" + command + ";";
    }
    let result = exec(lang, code);
    return _parse_db_result(lang, result);
}

fn _parse_db_result(lang, result) {
    let ok = result.ok;
    let stdout = str_trim(result.stdout);
    let stderr = str_trim(result.stderr);

    // Try to parse stdout as JSON (for sqlite3 json mode etc.)
    let parsed = nil;
    if stdout != "" {
        parsed = try json_parse(stdout) catch nil;
    }

    return map{
        ok: ok,
        language: lang,
        stdout: stdout,
        stderr: stderr,
        data: parsed,
        exit_code: result.exit_code,
    };
}

// ── Convenience: table operations ─────────────────────────────────────────────

// list_tables(lang, conn) — list all tables in the database
fn list_tables(lang, conn) {
    if lang == "sqlite" {
        return query(lang, conn, "SELECT name FROM sqlite_master WHERE type='table'");
    }
    if lang == "postgresql" or lang == "psql" or lang == "pg" {
        return query(lang, conn, "SELECT table_name FROM information_schema.tables WHERE table_schema='public'");
    }
    if lang == "mysql" or lang == "mariadb" {
        return query(lang, conn, "SHOW TABLES");
    }
    return map{ ok: false, error: "unsupported database: " + lang };
}

// describe_table(lang, conn, table) — get column info for a table
fn describe_table(lang, conn, table) {
    if lang == "sqlite" {
        return query(lang, conn, "PRAGMA table_info(" + table + ")");
    }
    if lang == "postgresql" or lang == "psql" or lang == "pg" {
        return query(lang, conn, "SELECT column_name, data_type FROM information_schema.columns WHERE table_name='" + table + "'");
    }
    if lang == "mysql" or lang == "mariadb" {
        return query(lang, conn, "DESCRIBE " + table);
    }
    return map{ ok: false, error: "unsupported database: " + lang };
}

// ── Key-Value operations (Redis) ──────────────────────────────────────────────

fn redis_get(conn, key) {
    return query("redis", conn, "GET " + key);
}

fn redis_set(conn, key, value) {
    return query("redis", conn, "SET " + key + " '" + _escape_sql(value) + "'");
}

fn redis_del(conn, key) {
    return query("redis", conn, "DEL " + key);
}

// ── Batch operations ──────────────────────────────────────────────────────────

// execute file against a database
fn execute_file(lang, conn, filepath) {
    let code = fs_read(filepath);
    if code == nil {
        return map{ ok: false, error: "cannot read: " + filepath };
    }
    return query(lang, conn, code);
}

// migrate(lang, conn, migrations_dir) — run .sql migration files in order
fn migrate(lang, conn, migrations_dir) {
    let files = fs_listdir(migrations_dir);
    if files == nil {
        return map{ ok: false, error: "cannot read directory: " + migrations_dir };
    }
    let results = [];
    for i len(files) {
        let file = files[i];
        if str_ends_with(file, ".sql") {
            let full_path = migrations_dir + "/" + file;
            let r = execute_file(lang, conn, full_path);
            array_push(results, r);
        }
    }
    return map{ ok: true, migrations: len(results), results: results };
}

export query;
export list_tables;
export describe_table;
export execute_file;
export migrate;
export redis_get, redis_set, redis_del;
export sqlite_conn, postgres_conn, mysql_conn, mongodb_conn, redis_conn;
export escape_arg, escape_sql;
