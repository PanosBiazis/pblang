// stdlib/profiler.sapp — Performance profiling and debugging for pblang
//
// Provides wall-clock profiling, benchmarking, and debugging utilities
// for measuring and optimizing pblang programs.
//
// Usage:
//   let prof = import("stdlib:profiler.sapp");
//   prof.start("my-section");
//   // ... code to profile ...
//   let elapsed = prof.end("my-section");
//
//   let result = prof.benchmark("sort-bench", fn() {
//       return quicksort(large_array);
//   }, 100);  // run 100 iterations
//
//   prof.trace(fn() { my_func(42); });

// ── Internal state ───────────────────────────────────────────────────────────

// Global profiling store (per-VM in practice, global for stdlib simplicity)
let _sections = map{};
let _marks = map{};
let _counters = map{};
let _traces = [];
let _enabled = true;

// ── Section Timing ────────────────────────────────────────────────────────────

// start(name) — begin timing a section
fn start(name) {
    if !_enabled { return nil; }
    _sections[name] = map{
        start_time: _wall_time_ms(),
        running: true,
    };
    return nil;
}

// end(name) — end timing a section, returns elapsed ms
fn end(name) {
    if !_enabled { return nil; }
    let s = if map_has(_sections, name) { _sections[name] } else { nil };
    if s == nil or !s.running {
        return 0;
    }
    let ended = _wall_time_ms();
    let elapsed = ended - s.start_time;
    s.running = false;
    s.elapsed = elapsed;
    s.end_time = ended;
    return elapsed;
}

// elapsed(name) — get elapsed time for a completed section
fn elapsed(name) {
    let s = if map_has(_sections, name) { _sections[name] } else { nil };
    if s == nil { return 0; }
    if s.running { return _wall_time_ms() - s.start_time; }
    return s.elapsed;
}

// ── Mark/Point Timing ─────────────────────────────────────────────────────────

// mark(name) — record a timestamp mark
fn mark(name) {
    if !_enabled { return nil; }
    _marks[name] = _wall_time_ms();
    return nil;
}

// since(name) — ms since a mark was set
fn since(name) {
    let t = if map_has(_marks, name) { _marks[name] } else { nil };
    if t == nil { return 0; }
    return _wall_time_ms() - t;
}

// between(from_mark, to_mark) — ms elapsed between two marks
fn between(from_mark, to_mark) {
    let t1 = if map_has(_marks, from_mark) { _marks[from_mark] } else { nil };
    let t2 = if map_has(_marks, to_mark) { _marks[to_mark] } else { nil };
    if t1 == nil or t2 == nil { return 0; }
    return t2 - t1;
}

// ── Counters & Metrics ────────────────────────────────────────────────────────

// inc(name) — increment a counter
fn inc(name) {
    let c = if map_has(_counters, name) { _counters[name] } else { nil };
    if c == nil { c = 0; }
    _counters[name] = c + 1;
    return _counters[name];
}

// dec(name) — decrement a counter
fn dec(name) {
    let c = if map_has(_counters, name) { _counters[name] } else { nil };
    if c == nil { c = 0; }
    _counters[name] = c - 1;
    return _counters[name];
}

// count(name) — get counter value
fn count(name) {
    let c = if map_has(_counters, name) { _counters[name] } else { nil };
    if c == nil { return 0; }
    return c;
}

// set_counter(name, value) — set counter directly
fn set_counter(name, value) {
    _counters[name] = value;
    return value;
}

// ── Benchmarking ──────────────────────────────────────────────────────────────

// benchmark(name, fn_to_bench, iterations) — benchmark a function
// Returns map{name, total_ms, avg_ms, min_ms, max_ms, iterations, result}
fn _check_work(fn_to_run, iterations) {
    if type(iterations) != "number" {
        throw "profiler: iterations must be a finite integer in 0..1000000";
    }
    if iterations != iterations or iterations - iterations != 0
       or iterations < 0 or iterations > 1000000 or iterations != num_floor(iterations) {
        throw "profiler: iterations must be a finite integer in 0..1000000";
    }
    let kind = type(fn_to_run);
    if kind != "fn" and kind != "closure" and kind != "builtin" {
        throw "profiler: callback must be a function";
    }
}

fn benchmark(name, fn_to_bench, iterations) {
    _check_work(fn_to_bench, iterations);
    if iterations == 0 {
        return map{ name: name, total_ms: 0, avg_ms: 0, min_ms: 0,
            max_ms: 0, iterations: 0, result: nil };
    }
    let result = nil; let total = 0.0;
    let min_val = 999999999.0; let max_val = 0.0;
    let i = 0;
    while i < iterations {
        let t0 = _wall_time_ms();
        result = fn_to_bench();
        let duration = _wall_time_ms() - t0;
        total = total + duration;
        if duration < min_val { min_val = duration; }
        if duration > max_val { max_val = duration; }
        i = i + 1;
    }
    return map{ name: name, total_ms: total, avg_ms: total / iterations,
        min_ms: min_val, max_ms: max_val, iterations: iterations, result: result };
}

// Warmup performs the same admission before any callback.
fn warmup(fn_to_warmup, iterations) {
    _check_work(fn_to_warmup, iterations);
    let i = 0;
    while i < iterations {
        fn_to_warmup();
        i = i + 1;
    }
    return nil;
}

// ── Memory Profiling ──────────────────────────────────────────────────────────

// mem_snapshot() — get current memory usage
fn mem_snapshot() {
    return memory_stats();
}

fn _metric_value(value) {
    if type(value) != "number" { throw "profiler: invalid memory metric"; }
    if value != value or value - value != 0 or value < 0 {
        throw "profiler: invalid memory metric";
    }
    return value;
}

fn _metric_delta(before, after, canonical, legacy) {
    // Never subtract counters from different schemas. Canonical presence wins,
    // even when only one side has it; missing evidence is not a zero sample.
    let key = if map_has(before, canonical) or map_has(after, canonical) { canonical } else { legacy };
    let has_before = map_has(before, key); let has_after = map_has(after, key);
    let a = if has_before { _metric_value(before[key]) } else { nil };
    let b = if has_after { _metric_value(after[key]) } else { nil };
    if not has_before or not has_after { return nil; }
    return b - a;
}

// Raw memory_stats has active_borrows, but no total allocation counter.
// resources.snapshot/diff provides the richer allocation interface.
fn mem_diff(before, after) {
    if type(before) != "map" or type(after) != "map" {
        throw "profiler: memory snapshots must be maps";
    }
    return map{
        allocations_delta: _metric_delta(before, after, "total_allocs", "allocations"),
        borrows_delta: _metric_delta(before, after, "active_borrows", "borrows"),
    };
}

// ── Tracing ───────────────────────────────────────────────────────────────────

// trace(fn_to_trace) — trace a function execution
fn trace(fn_to_trace) {
    // Admission is sampled at entry; nested traces cannot overwrite this start.
    if !_enabled { return fn_to_trace(); }
    let started = _wall_time_ms();
    let result = fn_to_trace();
    let elapsed_ms = _wall_time_ms() - started;
    array_push(_traces, map{
        time: time_now_iso(),
        elapsed_ms: elapsed_ms,
        result_type: typeof(result),
    });
    return result;
}

// trace_log() — get all trace records
fn trace_log() {
    return _traces;
}

// clear_traces() — clear trace log
fn clear_traces() {
    _traces = [];
    return nil;
}

// ── Control ──────────────────────────────────────────────────────────────────

// enable() / disable() — toggle profiling
fn enable() {
    _enabled = true;
    return nil;
}

fn disable() {
    _enabled = false;
    return nil;
}

// reset() — clear all profiling data
fn reset() {
    _sections = map{};
    _marks = map{};
    _counters = map{};
    _traces = [];
    _enabled = true;
    return nil;
}

// ── Report Generation ─────────────────────────────────────────────────────────

// report() — generate a summary report of all profiling data
fn report() {
    let section_names = map_keys(_sections);
    let sections_report = [];
    let i = 0;
    while i < len(section_names) {
        let name = section_names[i];
        let s = _sections[name];
        if s.running {
            array_push(sections_report, name + ": running (" + (_wall_time_ms() - s.start_time) + "ms)");
        } else {
            array_push(sections_report, name + ": " + s.elapsed + "ms");
        }
        i = i + 1;
    }

    let counter_names = map_keys(_counters);
    let counter_report = [];
    let j = 0;
    while j < len(counter_names) {
        let name = counter_names[j];
        array_push(counter_report, name + ": " + _counters[name]);
        j = j + 1;
    }

    return map{
        sections: sections_report,
        counters: counter_report,
        marks_count: len(map_keys(_marks)),
        traces_count: len(_traces),
    };
}

// ── Utilities ─────────────────────────────────────────────────────────────────

// Wall-clock milliseconds; this wrapper never promises monotonic time.
fn clock_info() {
    return map{ source: "now_ms", monotonic: false, unit: "ms" };
}

fn _wall_time_ms() {
    return now_ms();
}

// time_now_iso() — current time as ISO string
fn time_now_iso() {
    return now_iso();
}

// typeof(val) — get the type name of a value
fn typeof(val) {
    if val == nil { return "nil"; }
    if val == true or val == false { return "bool"; }
    let t = type(val);
    if t == "number" { return "number"; }
    if t == "string" { return "string"; }
    if t == "array" { return "array"; }
    if t == "map" { return "map"; }
    if t == "function" { return "function"; }
    return t;
}

export start, end, elapsed;
export mark, since, between;
export inc, dec, count, set_counter;
export benchmark, warmup;
export mem_snapshot, mem_diff;
export trace, trace_log, clear_traces;
export enable, disable, reset;
export report, clock_info;
