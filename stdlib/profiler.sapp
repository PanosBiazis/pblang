// stdlib/profiler.sapp — Performance profiling and debugging for pblang
//
// Provides deterministic profiling, benchmarking, and debugging utilities
// for measuring and optimizing pblang programs.
//
// Usage:
//   let prof = import("stdlib:profiler.sapp");
//   prof.start("my-section");
//   // ... code to profile ...
//   let elapsed = prof.end("my-section");
//
//   let result = prof.benchmark("sort-bench", fn() {
//       return quicksort(large_array);
//   }, 100);  // run 100 iterations
//
//   prof.trace(fn() { my_func(42); });

// ── Internal state ───────────────────────────────────────────────────────────

// Global profiling store (per-VM in practice, global for stdlib simplicity)
let _sections = map{};
let _marks = map{};
let _counters = map{};
let _traces = [];
let _enabled = true;

// ── Section Timing ────────────────────────────────────────────────────────────

// start(name) — begin timing a section
fn start(name) {
    if !_enabled { return nil; }
    _sections[name] = map{
        start_time: time_monotonic_ms(),
        running: true,
    };
    return nil;
}

// end(name) — end timing a section, returns elapsed ms
fn end(name) {
    if !_enabled { return nil; }
    let s = _sections[name];
    if s == nil or !s.running {
        return 0;
    }
    let elapsed = time_monotonic_ms() - s.start_time;
    s.running = false;
    s.elapsed = elapsed;
    s.end_time = time_monotonic_ms();
    return elapsed;
}

// elapsed(name) — get elapsed time for a completed section
fn elapsed(name) {
    let s = _sections[name];
    if s == nil { return 0; }
    if s.running { return time_monotonic_ms() - s.start_time; }
    return s.elapsed;
}

// ── Mark/Point Timing ─────────────────────────────────────────────────────────

// mark(name) — record a timestamp mark
fn mark(name) {
    if !_enabled { return nil; }
    _marks[name] = time_monotonic_ms();
    return nil;
}

// since(name) — ms since a mark was set
fn since(name) {
    let t = _marks[name];
    if t == nil { return 0; }
    return time_monotonic_ms() - t;
}

// between(from_mark, to_mark) — ms elapsed between two marks
fn between(from_mark, to_mark) {
    let t1 = _marks[from_mark];
    let t2 = _marks[to_mark];
    if t1 == nil or t2 == nil { return 0; }
    return t2 - t1;
}

// ── Counters & Metrics ────────────────────────────────────────────────────────

// inc(name) — increment a counter
fn inc(name) {
    let c = _counters[name];
    if c == nil { c = 0; }
    _counters[name] = c + 1;
    return _counters[name];
}

// dec(name) — decrement a counter
fn dec(name) {
    let c = _counters[name];
    if c == nil { c = 0; }
    _counters[name] = c - 1;
    return _counters[name];
}

// count(name) — get counter value
fn count(name) {
    let c = _counters[name];
    if c == nil { return 0; }
    return c;
}

// set_counter(name, value) — set counter directly
fn set_counter(name, value) {
    _counters[name] = value;
    return value;
}

// ── Benchmarking ──────────────────────────────────────────────────────────────

// benchmark(name, fn_to_bench, iterations) — benchmark a function
// Returns map{name, total_ms, avg_ms, min_ms, max_ms, iterations, result}
fn benchmark(name, fn_to_bench, iterations) {
    let times = [];
    let result = nil;
    let i = 0;
    while i < iterations {
        let t0 = time_monotonic_ms();
        result = fn_to_bench();
        let t1 = time_monotonic_ms();
        array_push(times, t1 - t0);
        i = i + 1;
    }

    let total = 0.0;
    let min_val = 999999999.0;
    let max_val = 0.0;
    let j = 0;
    let n = len(times);
    while j < n {
        let t = times[j];
        total = total + t;
        if t < min_val { min_val = t; }
        if t > max_val { max_val = t; }
        j = j + 1;
    }

    return map{
        name: name,
        total_ms: total,
        avg_ms: total / n,
        min_ms: min_val,
        max_ms: max_val,
        iterations: n,
        result: result,
    };
}

// warmup(fn_to_warmup, iterations) — warm up a function (JIT/cache)
fn warmup(fn_to_warmup, iterations) {
    let i = 0;
    while i < iterations {
        fn_to_warmup();
        i = i + 1;
    }
    return nil;
}

// ── Memory Profiling ──────────────────────────────────────────────────────────

// mem_snapshot() — get current memory usage
fn mem_snapshot() {
    return memory_stats();
}

// mem_diff(before, after) — compute memory delta between two snapshots
fn mem_diff(before, after) {
    return map{
        allocations_delta: (after.allocations or 0) - (before.allocations or 0),
        borrows_delta: (after.borrows or 0) - (before.borrows or 0),
    };
}

// ── Tracing ───────────────────────────────────────────────────────────────────

// trace(fn_to_trace) — trace a function execution
fn trace(fn_to_trace) {
    mark("trace_start");
    let result = fn_to_trace();
    let elapsed_ms = since("trace_start");
    array_push(_traces, map{
        time: time_now_iso(),
        elapsed_ms: elapsed_ms,
        result_type: typeof(result),
    });
    return result;
}

// trace_log() — get all trace records
fn trace_log() {
    return _traces;
}

// clear_traces() — clear trace log
fn clear_traces() {
    _traces = [];
    return nil;
}

// ── Control ──────────────────────────────────────────────────────────────────

// enable() / disable() — toggle profiling
fn enable() {
    _enabled = true;
    return nil;
}

fn disable() {
    _enabled = false;
    return nil;
}

// reset() — clear all profiling data
fn reset() {
    _sections = map{};
    _marks = map{};
    _counters = map{};
    _traces = [];
    _enabled = true;
    return nil;
}

// ── Report Generation ─────────────────────────────────────────────────────────

// report() — generate a summary report of all profiling data
fn report() {
    let section_names = map_keys(_sections);
    let sections_report = [];
    let i = 0;
    while i < len(section_names) {
        let name = section_names[i];
        let s = _sections[name];
        if s.running {
            array_push(sections_report, name + ": running (" + (time_monotonic_ms() - s.start_time) + "ms)");
        } else {
            array_push(sections_report, name + ": " + s.elapsed + "ms");
        }
        i = i + 1;
    }

    let counter_names = map_keys(_counters);
    let counter_report = [];
    let j = 0;
    while j < len(counter_names) {
        let name = counter_names[j];
        array_push(counter_report, name + ": " + _counters[name]);
        j = j + 1;
    }

    return map{
        sections: sections_report,
        counters: counter_report,
        marks_count: len(map_keys(_marks)),
        traces_count: len(_traces),
    };
}

// ── Utilities ─────────────────────────────────────────────────────────────────

// time_monotonic_ms() — monotonic time in milliseconds (wrapper for VM builtin)
fn time_monotonic_ms() {
    return now_ms();
}

// time_now_iso() — current time as ISO string
fn time_now_iso() {
    return now_iso();
}

// typeof(val) — get the type name of a value
fn typeof(val) {
    if val == nil { return "nil"; }
    if val == true or val == false { return "bool"; }
    let t = type(val);
    if t == "number" { return "number"; }
    if t == "string" { return "string"; }
    if t == "array" { return "array"; }
    if t == "map" { return "map"; }
    if t == "function" { return "function"; }
    return t;
}

export start, end, elapsed;
export mark, since, between;
export inc, dec, count, set_counter;
export benchmark, warmup;
export mem_snapshot, mem_diff;
export trace, trace_log, clear_traces;
export enable, disable, reset;
export report;
