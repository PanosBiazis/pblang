// Ideal, unloaded divider with fixed supply and independent bounded R tolerances.
let DC=import("stdlib:circuits_dc.sapp");let Units=import("stdlib:units.sapp");
fn analyze(vin,top,bottom,percent=0) {
    DC.divider(vin,top,bottom);
    if type(percent)!="number" or not (percent>=0 and percent<=20) {throw "divider: tolerance must be 0..20 percent";}
    let fraction=percent/100;let top_low=top*(1-fraction);let top_high=top*(1+fraction);
    let bottom_low=bottom*(1-fraction);let bottom_high=bottom*(1+fraction);
    DC.divider(vin,top_low,bottom_low);DC.divider(vin,top_high,bottom_high);
    let lo=vin*bottom_low/(top_high+bottom_low);let hi=vin*bottom_high/(top_low+bottom_high);
    let current_a=vin/(top_low+bottom_low);let current_b=vin/(top_high+bottom_high);
    return map{format:"pblang.divider-analysis.v1",nominal_vout:vin*bottom/(top+bottom),
        minimum_vout:num_min(lo,hi),maximum_vout:num_max(lo,hi),
        minimum_current_amperes:num_min(current_a,current_b),maximum_current_amperes:num_max(current_a,current_b),
        tolerance_percent:percent,educational_only:true,loaded:false};
}
fn analyze_units(vin,voltage_unit,top,top_unit,bottom,bottom_unit,percent=0) {
    return analyze(Units.convert_checked(vin,voltage_unit,"V"),Units.convert_checked(top,top_unit,"ohm"),Units.convert_checked(bottom,bottom_unit,"ohm"),percent);
}
export analyze,analyze_units;
