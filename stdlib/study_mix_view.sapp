let Mix=import("stdlib:study_mix.sapp");let Files=import("stdlib:study_mix_files.sapp");let Store=import("stdlib:study_files.sapp");let Study=import("stdlib:study_cards.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
fn sample(){return Study.create("Synthetic deck mix",[map{prompt:"Reusable models?",answer:"One contract across products."},map{prompt:"Explicit seed?",answer:"Repeatable selection."},map{prompt:"New copy?",answer:"Keep the source unchanged."},map{prompt:"Review dates?",answer:"Keep the saved schedule."}],"2026-09-27");}
fn line(r,index){if index>=r.count{return "End of selection";}let c=r.deck.cards[index];return str(index+1)+". ID "+str(c.id)+" | due "+c.due+" | stage "+str(c.stage);}
fn view(deck,count,seed){let r=Mix.create(deck,count,seed);let pages=num_ceil(count/8);let nodes=[UI.heading("PBDeckMix"),UI.text("Selected "+str(count)+" / "+str(r.source_count)+" | Seed "+str(seed)),UI.text("Saved order; review still prioritizes due dates."),UI.text("Page 1 / "+str(pages),map{name:"page"})];for i in range(0,8){array_push(nodes,UI.text(line(r,i),map{name:"row_"+str(i)}));}let buttons=[];for page in range(0,pages){let actions=[UI.action_set_text("page","Page "+str(page+1)+" / "+str(pages))];for i in range(0,8){array_push(actions,UI.action_set_text("row_"+str(i),line(r,page*8+i)));}array_push(buttons,UI.button("Page "+str(page+1),UI.action_sequence(actions)));}array_push(nodes,UI.grid(buttons,map{columns:4}));array_push(nodes,UI.text("Metadata snapshot only. No question or answer text embedded."));return UI.screen(nodes);}
fn message(f,text){let w=G.get(f,"status");w.text=text;f.dirty=true;}
fn settings(f){return json_stringify([G.get(f,"source").value,G.get(f,"count").value,G.get(f,"seed").value]);}
fn show(f,s){let text=[];for i in range(s.page*8,num_min(s.report.count,s.page*8+8)){array_push(text,line(s.report,i));}let body=G.get(f,"result");body.value=str_join(text,"\n\n");let summary=G.get(f,"summary");summary.text="Selected "+str(s.report.count)+" / "+str(s.report.source_count)+" | Seed "+str(s.report.seed)+" | Page "+str(s.page+1)+" / "+str(num_ceil(s.report.count/8));f.dirty=true;}
fn act(f,s,action){if action=="previous"{s.page=num_max(0,s.page-1);show(f,s);return;}if action=="next"{s.page=num_min(num_ceil(s.report.count/8)-1,s.page+1);show(f,s);return;}
 if action=="mix"{s.can_save=false;let count=try Mix.parse_count(G.get(f,"count").value) catch nil;let seed=try Mix.parse_seed(G.get(f,"seed").value) catch nil;if count==nil or seed==nil{message(f,"Use count 1..64 and seed 0..4294967295. Previous selection retained; save disabled.");return;}
 let path=G.get(f,"source").value;let loaded=map{ok:false};if path==""{let r=try Mix.create(sample(),count,seed) catch nil;if r!=nil{loaded=map{ok:true,report:r};}} else {loaded=Files.open(path,count,seed);}
 if not loaded.ok{message(f,"Could not mix this deck/count. Previous selection retained; save disabled.");return;}s.report=loaded.report;s.settings=settings(f);s.can_save=true;s.page=0;show(f,s);message(f,"Prepared independent copy. IDs, content and review history retained.");return;}
 if action=="save"{if not s.can_save or s.settings!=settings(f){message(f,"Mix the current source, count and seed before saving.");return;}let result=Store.save_copy(G.get(f,"output").value,s.report.deck);let msg=result.error;if result.ok{msg="New deck copy saved. Source unchanged.";}message(f,msg);}
}
fn button(s,label,action){return UI.button(label,fn(f){act(f,s,action);},map{name:action});}
fn build(){let s=map{report:Mix.create(sample(),3,42),settings:"",can_save:true,page:0};let f=UI.build("PBDeckMix",UI.screen([UI.heading("PBDeckMix"),UI.text("Repeatable selection from a saved study deck; review history is retained."),UI.input("",map{name:"source",max_chars:4096,placeholder:"Source .pbdeck; empty uses the labelled synthetic example"}),UI.text("Cards to keep (1..64) / Seed (0..4294967295)"),UI.row([UI.input("3",map{name:"count",max_chars:10}),UI.input("42",map{name:"seed",max_chars:10}),button(s,"Mix selection","mix")]),UI.text("",map{name:"summary"}),UI.area("",map{name:"result",readonly:true,h:300}),UI.row([button(s,"Previous page","previous"),button(s,"Next page","next")]),UI.input("",map{name:"output",max_chars:4096,placeholder:"New .pbdeck output"}),button(s,"Save new deck","save"),UI.text("",map{name:"status"}),UI.text("PBStudy reviews by due date; mix order breaks equal-date ties."),UI.text("Saved copies contain questions and answers. They do not synchronize progress.")]),map{width:1100,height:1000,theme:"dark"});s.settings=settings(f);show(f,s);message(f,"Synthetic four-card example. No file or clock read until requested.");return map{form:f,state:s};}
fn run(){let e=build();G.run(e.form,map{ordered_input:true});}
export sample,view,act,build,run;
