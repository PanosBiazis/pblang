// Pure report preferences: no rendering, persistence, ambient locale or I/O.
let Theme = import("stdlib:theme.sapp");
fn _language(value) {
    if value!="el" and value!="en" { throw "report customization: unsupported language"; }
}
fn _style(value) {
    if type(value)!="map" or len(value)>4 { throw "report customization: invalid style"; }
    for key in map_keys(value) {
        let item=value[key];
        if key=="preset" {
            if item!="light" and item!="dark" and item!="ink" { throw "report customization: invalid preset"; }
        } elif key=="font_size" {
            if type(item)!="number" or not (item>=9 and item<=24) or item!=num_floor(item) {
                throw "report customization: invalid font size";
            }
        } elif key=="landscape" or key=="dense" {
            if type(item)!="bool" { throw "report customization: invalid style flag"; }
        } else { throw "report customization: unknown style field"; }
    }
}
fn _preferences(value) {
    if type(value)!="map" or len(value)>2 { throw "report customization: invalid preferences"; }
    for key in map_keys(value) {
        if key=="report_language" {
            if value[key]!=nil { _language(value[key]); }
        } elif key=="style" { _style(value[key]); }
        else { throw "report customization: unknown preference"; }
    }
}
fn plan(ui_language, preferences_saved=nil, operation=nil) {
    if preferences_saved==nil { preferences_saved=map{}; }
    if operation==nil { operation=map{}; }
    _language(ui_language); _preferences(preferences_saved); _preferences(operation);
    let language="el"; let source="default";
    let style=map{preset:"light",font_size:12,landscape:false,dense:false};
    for preferences in [preferences_saved,operation] {
        let selected=try preferences.report_language catch nil;
        if selected!=nil { language=selected; }
        if map_has(preferences,"style") {
            for key in map_keys(preferences.style) { style[key]=preferences.style[key]; }
        }
    }
    if (try operation.report_language catch nil)!=nil { source="operation"; }
    elif (try preferences_saved.report_language catch nil)!=nil { source="saved"; }
    let theme=if style.preset=="dark" { Theme.dark() } else { Theme.light() };
    if style.preset=="ink" {
        theme=Theme.with_role(theme,"fg",map{r:0,g:0,b:0});
        theme=Theme.with_role(theme,"bg",map{r:255,g:255,b:255});
    }
    return map{format:"pblang.report-customization.v1",ui_language:ui_language,
        report_language:language,language_source:source,style:style,
        foreground:Theme.role(theme,"fg"),background:Theme.role(theme,"bg"),
        foreground_background_contrast:Theme.contrast(theme,"fg","bg"),
        rendering_performed:false,persistence_performed:false,safe_to_log:false};
}
export plan;
