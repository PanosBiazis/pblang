//! registry.sapp — Pblang package registry operations wrapper
//!
//! Provides a high-level API for interacting with pblang package registries.
//! Requires the pblang CLI to be on PATH for install and publish operations.
//!
//! Usage:
//!   import "stdlib:registry.sapp";
//!   let results = registry.search("http");
//!   registry.install("@scope/package", "1.0.0");
//!   registry.publish("./my-package");

// ──────────────────────────────────────────────────────────────
// Configuration
// ──────────────────────────────────────────────────────────────

/// RegistryConfig holds the base URL and optional token for registry operations.
fn RegistryConfig(url = nil, token = nil) {
    if url == nil { url = env_get("PBLANG_REGISTRY_INDEX"); }
    if token == nil { token = env_get("PBLANG_REGISTRY_TOKEN"); }
    return map{
        url: url,
        token: token,
        cache_dir: env_get("PBLANG_CACHE"),
    };
}

// ──────────────────────────────────────────────────────────────
// Search
// ──────────────────────────────────────────────────────────────

/// Search a registry for packages matching `query`.
///
/// Returns an array of result objects:
///   [{name: "pkg", version: "1.0.0", description: "..."}, ...]
///
/// If `config` is nil, reads PBLANG_REGISTRY_INDEX from the environment.
/// If `config` is a string, it is treated as the registry URL.
/// If `config` is a map, it should have {url: "..."} or the result of RegistryConfig.
fn registry_search(config, query) {
    let url = nil;
    if config == nil {
        url = env_get("PBLANG_REGISTRY_INDEX");
    } else if type(config) == "string" {
        url = config;
    } else if type(config) == "map" {
        url = config.url;
    }
    if url == nil or url == "" {
        return map{ ok: false, error: "no registry configured (set PBLANG_REGISTRY_INDEX)" };
    }

    let search_url = url;
    if not str_starts_with(url, "file://") {
        search_url = url + "/search?q=" + url_encode(query);
    }

    // For file:// registries, read the index.json directly
    if str_starts_with(url, "file://") {
        let dir = str_slice(url, 7, nil); // strip "file://"
        let index_path = path_join(dir, "index.json");
        if not fs_exists(index_path) {
            return map{ ok: false, error: "index not found: " + index_path };
        }
        let index_json = fs_read(index_path);
        let index = json_parse(index_json);
        let packages = index.packages;
        if packages == nil {
            return map{ ok: true, results: [] };
        }
        let results = [];
        let q = str_lower(query);
        let names = map_keys(packages);
        let i = 0;
        while i < len(names) {
            let name = names[i];
            if q == "" or str_contains(str_lower(name), q) {
                let versions = packages[name];
                let ver_keys = map_keys(versions);
                let j = 0;
                while j < len(ver_keys) {
                    let ver = ver_keys[j];
                    let release = versions[ver];
                    let desc = "";
                    if map_has(release, "description") { desc = release.description; }
                    results.push(map{
                        name: name,
                        version: ver,
                        description: desc,
                    });
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return map{ ok: true, results: results };
    }

    // For HTTP registries, use the search endpoint
    let resp = http_get(search_url);
    if resp == nil {
        return map{ ok: false, error: "registry search request failed" };
    }
    let parsed = json_parse(resp);
    if type(parsed) == "array" {
        return map{ ok: true, results: parsed };
    }
    if type(parsed) == "map" and map_has(parsed, "results") {
        return map{ ok: true, results: parsed.results };
    }
    return map{ ok: true, results: [] };
}

// ──────────────────────────────────────────────────────────────
// Install
// ──────────────────────────────────────────────────────────────

/// Install a package from the registry into the local cache.
///
/// Parameters:
///   config  - RegistryConfig map, registry URL string, or nil (uses env vars)
///   name    - Package name (e.g. "@scope/pkg")
///   version - Package version (e.g. "1.0.0")
///
/// Returns {ok: true, path: "...", metadata: {...}} on success,
///         {ok: false, error: "..."} on failure.
// Resolve any accepted config shape (nil/env, url string, {url, token} map)
// into a plain {url, token}.
fn _config_resolve(config) {
    let url = nil;
    let token = nil;
    if config == nil {
        url = env_get("PBLANG_REGISTRY_INDEX");
        token = env_get("PBLANG_REGISTRY_TOKEN");
    } else if type(config) == "string" {
        url = config;
    } else if type(config) == "map" {
        url = try config.url catch nil;
        token = try config.token catch nil;
    }
    return map{ url: url, token: token };
}

// install_plan(config, name, version) — the exact CLI invocation as data:
// { ok, cmd, args, env }. The CLI accepts the registry as --registry-index
// but tokens ONLY via the PBLANG_REGISTRY_TOKEN env var (SECURITY FIX #28
// disabled --registry-token), so a config-map token must ride `env`.
fn install_plan(config, name, version) {
    let c = _config_resolve(config);
    if c.url == nil or c.url == "" {
        return map{ ok: false, error: "no registry configured (set PBLANG_REGISTRY_INDEX)" };
    }
    let env = map{};
    if c.token != nil and c.token != "" { env["PBLANG_REGISTRY_TOKEN"] = c.token; }
    return map{
        ok: true,
        cmd: "pblang",
        args: ["install", name + "@" + version, "--registry-index", c.url],
        env: env,
    };
}

// Run a plan: set its env vars (remembering the old values), spawn, restore.
// proc_spawn_wait has no env parameter — the child inherits this process's
// environment, so the token/index must be visible for exactly this call.
fn _spawn_with_env(cmd, args, env) {
    let keys = map_keys(env);
    let saved = map{};
    let i = 0;
    while i < len(keys) {
        saved[keys[i]] = env_get(keys[i]);
        env_set(keys[i], env[keys[i]]);
        i = i + 1;
    }
    let outcome = try map{ ok: true, value: proc_spawn_wait(cmd, args) }
                  catch map{ ok: false, value: nil };
    i = 0;
    while i < len(keys) {
        let old = saved[keys[i]];
        if old == nil { old = ""; }   // no unset builtin; empty means "none" to the CLI
        env_set(keys[i], old);
        i = i + 1;
    }
    if not outcome.ok {
        return map{ exit_code: 0 - 1, stdout: "", stderr: "spawn failed: " + cmd };
    }
    return outcome.value;
}

fn registry_install(config, name, version) {
    let plan = install_plan(config, name, version);
    if not plan.ok { return plan; }

    let result = _spawn_with_env(plan.cmd, plan.args, plan.env);
    if result.exit_code != 0 {
        return map{ ok: false, error: "install failed: " + result.stderr };
    }

    // Where the CLI caches installs (returned so callers can locate the files)
    let cache_dir = env_get("PBLANG_CACHE");
    if cache_dir == nil or cache_dir == "" {
        let home = env_get("HOME");
        if home == nil { home = env_get("USERPROFILE"); }
        if home == nil { home = "."; }
        cache_dir = path_join(home, ".pblang", "cache");
    }

    return map{
        ok: true,
        name: name,
        version: version,
        cache_dir: cache_dir,
        message: "installed " + name + "@" + version,
    };
}

// ──────────────────────────────────────────────────────────────
// Publish
// ──────────────────────────────────────────────────────────────

/// Publish a package to the registry.
///
/// Parameters:
///   config - RegistryConfig map, registry URL string, or nil (uses env vars)
///   path   - Path to the package directory (must contain pblang.toml)
///
/// Returns {ok: true, name: "...", version: "..."} on success,
///         {ok: false, error: "..."} on failure.
// publish_plan(config, path) — the CLI takes NO positional path (it searches
// for pblang.toml upward from the CURRENT directory) and reads the registry
// and token only from PBLANG_REGISTRY_INDEX / PBLANG_REGISTRY_TOKEN, so the
// plan is: run `pblang publish` FROM `run_from` with `env` set.
fn publish_plan(config, path) {
    let c = _config_resolve(config);
    if c.url == nil or c.url == "" {
        return map{ ok: false, error: "no registry configured (set PBLANG_REGISTRY_INDEX)" };
    }
    if path == nil or path == "" { path = "."; }
    let env = map{};
    env["PBLANG_REGISTRY_INDEX"] = c.url;
    if c.token != nil and c.token != "" { env["PBLANG_REGISTRY_TOKEN"] = c.token; }
    return map{ ok: true, cmd: "pblang", args: ["publish"], env: env, run_from: path };
}

// manifest_summary(toml_text) — name/version out of a pblang.toml ("unknown"
// when absent). Line scan, not a full TOML parser: `key = "value"` pairs.
fn manifest_summary(text) {
    let name = "unknown";
    let version = "unknown";
    let lines = str_split(str(text), "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        i = i + 1;
        let eq_at = str_index_of(line, "=");
        if eq_at < 0 { continue; }
        let key = str_trim(str_slice(line, 0, eq_at));
        let val = str_trim(str_slice(line, eq_at + 1, len(line)));
        if str_starts_with(val, "\"") and len(val) >= 2 and str_ends_with(val, "\"") {
            val = str_slice(val, 1, len(val) - 1);
        }
        if key == "name" and name == "unknown" { name = val; }
        if key == "version" and version == "unknown" { version = val; }
    }
    return map{ name: name, version: version };
}

fn registry_publish(config, path) {
    let plan = publish_plan(config, path);
    if not plan.ok { return plan; }
    if path == nil or path == "" { path = "."; }

    // Validate the package directory has a manifest
    let manifest_path = path_join(path, "pblang.toml");
    if not fs_exists(manifest_path) {
        return map{ ok: false, error: "no pblang.toml found in " + path };
    }
    let ms = manifest_summary(try fs_read(manifest_path) catch "");

    // The CLI publishes the manifest found from the CURRENT directory — there
    // is no way to point it elsewhere, so refuse instead of publishing the
    // wrong package when `path` is not where we are running from.
    if path != "." and path != cwd() {
        return map{ ok: false, error: "pblang publish runs from the package directory; run it from '"
                                      + path + "' (or pass \".\")" };
    }

    let result = _spawn_with_env(plan.cmd, plan.args, plan.env);
    if result.exit_code != 0 {
        return map{ ok: false, error: "publish failed: " + result.stderr };
    }

    return map{
        ok: true,
        path: path,
        registry: plan.env["PBLANG_REGISTRY_INDEX"],
        name: ms.name,
        version: ms.version,
        message: result.stdout,
    };
}

// ──────────────────────────────────────────────────────────────
// Public API (exported as registry.*)
// ──────────────────────────────────────────────────────────────

/// Module entry point.
///   registry.search(query)  → {ok, results}       (config from env vars)
///   registry.install(name, version) → {ok, ...}   (config from env vars)
///   registry.publish(path) → {ok, ...}             (config from env vars)
///   registry.config(url, token) → RegistryConfig map
let registry = map{
    search:  fn(query)             { return registry_search(nil, query); },
    install: fn(name, version)     { return registry_install(nil, name, version); },
    publish: fn(path)              { return registry_publish(nil, path); },
    config:  fn(url, token)        { return RegistryConfig(url, token); },
};

export registry;
export install_plan, publish_plan, manifest_summary;
