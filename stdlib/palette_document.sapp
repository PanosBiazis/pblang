let C=import("stdlib:colors.sapp");let S=import("stdlib:serialization.sapp");let Sheet=import("stdlib:sheet_document.sapp");
let FORMAT="pblang.palette.v1";let MAX_FILE_BYTES=16384;
fn _label(text){if type(text)!="string" or len(str_trim(text))==0 or len(text)>40 or len(str_to_bytes(text))>80{throw "palette: label limit";}for i in range(0,len(text)){let c=strcharcodeat(text,i);if c<32 or c==127{throw "palette: single-line label required";}}}
fn canonical(hex){return C.rgb_to_hex(C.hex_checked(hex));}
fn validate(doc){
 if type(doc)!="map" or len(doc)!=4 or not map_has(doc,"format") or doc.format!=FORMAT or not map_has(doc,"title") or not map_has(doc,"background") or not map_has(doc,"swatches") or type(doc.swatches)!="array" or len(doc.swatches)<1 or len(doc.swatches)>8{throw "palette: invalid document";}
 _label(doc.title);if doc.background!=canonical(doc.background){throw "palette: canonical background required";}
 for row in doc.swatches{if type(row)!="map" or len(row)!=2 or not map_has(row,"label") or not map_has(row,"hex"){throw "palette: invalid swatch";}_label(row.label);if row.hex!=canonical(row.hex){throw "palette: canonical hex required";}}return true;
}
fn create(title="New palette",background="#ffffff"){_label(title);return map{format:FORMAT,title:title,background:canonical(background),swatches:[map{label:"Ink",hex:"#000000"}]};}
fn copy(doc){validate(doc);let out=create(doc.title,doc.background);out.swatches=[];for s in doc.swatches{array_push(out.swatches,map{label:s.label,hex:s.hex});}return out;}
fn _index(index,count){if type(index)!="number" or not(index>=0 and index<count) or index!=num_floor(index){throw "palette: invalid index";}}
fn set_swatch(doc,index,label,hex){validate(doc);_index(index,len(doc.swatches));_label(label);let value=canonical(hex);let out=copy(doc);out.swatches[index]=map{label:label,hex:value};return out;}
fn configure(doc,title,background){_label(title);let value=canonical(background);let out=copy(doc);out.title=title;out.background=value;return out;}
fn append(doc,label="New color",hex="#808080"){validate(doc);if len(doc.swatches)>=8{throw "palette: eight swatch limit";}_label(label);let value=canonical(hex);let out=copy(doc);array_push(out.swatches,map{label:label,hex:value});return out;}
fn remove(doc,index){validate(doc);_index(index,len(doc.swatches));if len(doc.swatches)==1{throw "palette: retain one swatch";}let out=copy(doc);out.swatches=[];for i in range(0,len(doc.swatches)){if i!=index{let s=doc.swatches[i];array_push(out.swatches,map{label:s.label,hex:s.hex});}}return out;}
// Move one detached swatch; all other swatches retain their relative order.
fn move_swatch(doc,source,target){let out=copy(doc);_index(source,len(out.swatches));_index(target,len(out.swatches));let selected=out.swatches[source];
 if source<target {for i in range(source,target){out.swatches[i]=out.swatches[i+1];}}
 elif source>target {for step in range(0,source-target){let i=source-step;out.swatches[i]=out.swatches[i-1];}}
 out.swatches[target]=selected;return out;
}
fn analyze(doc){validate(doc);let bg=C.hex_checked(doc.background);let out=[];for row in doc.swatches{let rgb=C.hex_checked(row.hex);array_push(out,map{label:row.label,hex:row.hex,contrast:C.contrast_checked(rgb,bg),best_text:C.best_text_checked(rgb)});}return out;}
fn matrix(doc){validate(doc);let colors=[];for row in doc.swatches{array_push(colors,C.hex_checked(row.hex));}array_push(colors,C.hex_checked(doc.background));return C.contrast_matrix_checked(colors);}
fn strip(doc){validate(doc);let colors=[];for s in doc.swatches{array_push(colors,C.hex_checked(s.hex));}let out=[];for y in range(0,16){let row=[];for c in colors{for x in range(0,16){array_push(row,[c.r,c.g,c.b,255]);}}array_push(out,row);}return out;}
fn to_sheet(doc){let rows=[["Name","HEX","Background","Contrast ratio","AA normal","AAA normal"]];for item in analyze(doc){array_push(rows,[item.label,item.hex,doc.background,str(item.contrast.ratio),str(item.contrast.aa_normal),str(item.contrast.aaa_normal)]);}let sheet=map{format:Sheet.FORMAT,cells:rows};Sheet.validate(sheet);return sheet;}
fn _limits(){return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:128,strict:true,reject_duplicate_keys:true};}
fn encode(doc){let r=S.stringify_safe(copy(doc),"json",_limits());if not r.ok{throw "palette encoding failed";}return r.value;}
fn decode(text){let r=S.parse_safe(text,"json",_limits());if not r.ok or not r.duplicate_keys_checked{throw "invalid palette file";}return copy(r.value);}
export FORMAT,MAX_FILE_BYTES,canonical,validate,create,copy,set_swatch,configure,append,remove,move_swatch,analyze,matrix,strip,to_sheet,encode,decode;
