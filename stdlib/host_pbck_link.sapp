// Static link requirements for decoded host PBCK-v1 artifacts.
// The analysis never executes guest code. It walks every nested function and
// reports which globals are defined by the artifact and which names require an
// explicitly injected host adapter.

let Decode = import("stdlib:host_pbck_decode.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

fn _fault(message) { throw "host_pbck_link: " + message; }

fn _set_add(values, value) {
    if not is_string(value) { return; }
    values[value] = true;
}

fn _instruction_count(chunk) {
    if map_has(chunk, "compact") and chunk.compact { return len(chunk.opcodes); }
    return len(chunk.instructions);
}

fn _instruction(chunk, index) {
    if map_has(chunk, "compact") and chunk.compact {
        return map{ op: chunk.opcodes[index], operand: chunk.operands[index] };
    }
    return chunk.instructions[index];
}

fn _constant_name(chunk, instruction) {
    if not map_has(instruction, "operand") { return nil; }
    let index = instruction.operand;
    if index < 0 or index >= len(chunk.constants) { _fault("constant index out of range"); }
    let value = chunk.constants[index];
    if not is_string(value) { _fault("global name constant must be a string"); }
    return value;
}

fn _walk_value(value, state, depth) {
    if depth > Decode.MAX_DEPTH { _fault("nesting limit exceeded"); }
    if not is_map(value) or not map_has(value, "__pbck_function") { return; }
    state.functions = state.functions + 1;
    _walk_chunk(value.chunk, state, depth + 1);
    let i = 0;
    while i < len(value.defaults) {
        _walk_value(value.defaults[i], state, depth + 1);
        i = i + 1;
    }
}

fn _walk_chunk(chunk, state, depth) {
    if not is_map(chunk) or not map_has(chunk, "constants") { _fault("invalid chunk"); }
    if depth > Decode.MAX_DEPTH { _fault("nesting limit exceeded"); }
    state.chunks = state.chunks + 1;
    let count = _instruction_count(chunk);
    state.instructions = state.instructions + count;
    let i = 0;
    while i < count {
        let instruction = _instruction(chunk, i);
        let op = instruction.op;
        if op == 13 or op == 15 { _set_add(state.definitions, _constant_name(chunk, instruction)); }
        elif op == 14 { _set_add(state.reads, _constant_name(chunk, instruction)); }
        elif op == 18 { _set_add(state.exports, _constant_name(chunk, instruction)); }
        i = i + 1;
    }
    i = 0;
    while i < len(chunk.constants) {
        _walk_value(chunk.constants[i], state, depth + 1);
        i = i + 1;
    }
}

fn _provided_set(provided) {
    let out = map{};
    let i = 0;
    while i < len(VM.BUILTIN_ADAPTERS) {
        out[VM.BUILTIN_ADAPTERS[i]] = true;
        i = i + 1;
    }
    if provided == nil { return out; }
    if is_array(provided) {
        i = 0;
        while i < len(provided) {
            if not is_string(provided[i]) { _fault("provided adapter name must be a string"); }
            out[provided[i]] = true;
            i = i + 1;
        }
        return out;
    }
    if is_map(provided) {
        let names = map_keys(provided);
        i = 0;
        while i < len(names) { out[names[i]] = true; i = i + 1; }
        return out;
    }
    _fault("provided adapters must be an array or map");
}

fn analyze_decoded(decoded, provided = nil) {
    if not is_map(decoded) or not map_has(decoded, "chunk") { _fault("decoded artifact required"); }
    let state = map{
        reads: map{}, definitions: map{}, exports: map{},
        chunks: 0, functions: 0, instructions: 0
    };
    _walk_chunk(decoded.chunk, state, 0);
    let available = _provided_set(provided);
    let reads = array_sort(map_keys(state.reads));
    let definitions = array_sort(map_keys(state.definitions));
    let exports = array_sort(map_keys(state.exports));
    let required = [];
    let unresolved = [];
    let i = 0;
    while i < len(reads) {
        let name = reads[i];
        if not map_has(state.definitions, name) {
            array_push(required, name);
            if not map_has(available, name) { array_push(unresolved, name); }
        }
        i = i + 1;
    }
    return map{
        format: "pblang.host-pbck.link.v1", version: 1,
        chunks: state.chunks, functions: state.functions,
        instructions: state.instructions, reads: reads,
        definitions: definitions, exports: exports,
        required_host_adapters: required,
        provided_host_adapters: array_sort(map_keys(available)),
        unresolved_host_adapters: unresolved,
        link_ready: len(unresolved) == 0
    };
}

fn analyze_bytes(bytes, provided = nil) {
    return analyze_decoded(Decode.decode_bytes_compact(bytes), provided);
}

fn analyze_file(path, provided = nil) {
    return analyze_decoded(Decode.decode_file_compact(path), provided);
}

export analyze_decoded, analyze_bytes, analyze_file;
