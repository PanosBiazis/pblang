// stdlib/datetime.sapp — high-level date+time built on date.sapp + duration.sapp.
//
// A datetime is a unix timestamp (seconds), so it composes with both
// `stdlib/date.sapp` (calendar/format) and `stdlib/duration.sapp` (spans).
//
// Usage:
//   let dt = import("stdlib:datetime.sapp");
//   let later = dt.add(dt.now(), dt.dur.hours(2));
//   print dt.format(later, "%Y-%m-%d %H:%M:%S");
//   print dt.relative(later - 7200, later);   // "2 hours ago"

import "stdlib:date.sapp";
import "stdlib:duration.sapp";

// Re-expose the duration helpers so callers don't need a second import.
let dur = duration;

// ── Construction ─────────────────────────────────────────────────────────────
fn now() { return date.now_unix(); }
fn from_unix(ts) { return ts; }
fn to_unix(dt) { return dt; }

// from_ymd(y, mo, d [, h, mi, s]) → unix timestamp (UTC), via date.parse.
fn from_ymd(y, mo, d, h = 0, mi = 0, s = 0) {
    let iso = _pad4(y) + "-" + _pad2(mo) + "-" + _pad2(d) + "T"
        + _pad2(h) + ":" + _pad2(mi) + ":" + _pad2(s) + "Z";
    return date.parse_unix(iso);
}

fn _pad2(n) { if n < 10 { return "0" + str(n); } return str(n); }
fn _pad4(n) {
    if n < 10 { return "000" + str(n); }
    if n < 100 { return "00" + str(n); }
    if n < 1000 { return "0" + str(n); }
    return str(n);
}

// ── Arithmetic with durations ────────────────────────────────────────────────
fn add(dt, d) { return dt + d; }
fn sub(dt, d) { return dt - d; }
// diff(a, b) → duration (seconds) from a to b.
fn diff(a, b) { return b - a; }

// ── Comparison ───────────────────────────────────────────────────────────────
fn is_before(a, b) { return a < b; }
fn is_after(a, b)  { return a > b; }
fn is_same(a, b)   { return a == b; }
fn min_dt(a, b)    { if a < b { return a; } return b; }
fn max_dt(a, b)    { if a > b { return a; } return b; }

// ── Formatting (delegates to date.sapp) ──────────────────────────────────────
fn format(dt, pattern) { return date.format(dt, pattern); }
fn to_iso(dt) { return date.format(dt, "%Y-%m-%dT%H:%M:%S"); }
fn parse_iso(s) { return date.parse_unix(s); }

// ── Component accessors ──────────────────────────────────────────────────────
fn year(dt)   { return parse_number(date.format(dt, "%Y")); }
fn month(dt)  { return parse_number(date.format(dt, "%m")); }
fn day(dt)    { return parse_number(date.format(dt, "%d")); }
fn hour(dt)   { return parse_number(date.format(dt, "%H")); }
fn minute(dt) { return parse_number(date.format(dt, "%M")); }
fn second(dt) { return parse_number(date.format(dt, "%S")); }

// start_of_day(dt) → midnight of the same calendar day.
fn start_of_day(dt) {
    return dt - (num_mod(hour(dt), 24) * 3600 + minute(dt) * 60 + second(dt));
}

// ── Relative / "time ago" ────────────────────────────────────────────────────
// relative(ts, ref) → human string like "2 hours ago" / "in 3 days" / "just now".
fn relative(ts, ref) {
    let delta = ref - ts;
    let past = delta >= 0;
    let secs = delta;
    if past == false { secs = 0 - delta; }
    if secs < 1 { return "just now"; }

    let value = 0;
    let unit = "";
    if secs >= 86400 { value = num_floor(secs / 86400.0); unit = "day"; }
    else if secs >= 3600 { value = num_floor(secs / 3600.0); unit = "hour"; }
    else if secs >= 60 { value = num_floor(secs / 60.0); unit = "minute"; }
    else { value = num_floor(secs); unit = "second"; }

    let label = str(value) + " " + unit;
    if value != 1 { label = label + "s"; }
    if past { return label + " ago"; }
    return "in " + label;
}

fn ago(ts) { return relative(ts, now()); }

// ── weekday / ranges (datetimes are unix seconds) ────────────────────────────────
let _WEEKDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

// weekday(dt) → 0..6 with 0 = Sunday (1970-01-01 was a Thursday).
fn weekday(dt) {
    let days_since_epoch = num_floor(dt / 86400.0);
    let w = num_mod(days_since_epoch + 4, 7);
    if w < 0 { w = w + 7; }
    return w;
}

// weekday_name(dt) → "Sunday".."Saturday".
fn weekday_name(dt) { return _WEEKDAYS[weekday(dt)]; }

// is_weekend(dt) → true for Saturday (6) or Sunday (0).
fn is_weekend(dt) { let w = weekday(dt); return w == 0 or w == 6; }

// end_of_day(dt) → the last second of the same calendar day.
fn end_of_day(dt) { return start_of_day(dt) + 86399; }

// clamp_dt(dt, lo, hi) → confine a timestamp to [lo, hi].
fn clamp_dt(dt, lo, hi) { if dt < lo { return lo; } if dt > hi { return hi; } return dt; }

// is_between(dt, lo, hi) → inclusive range test.
fn is_between(dt, lo, hi) { return dt >= lo and dt <= hi; }

// ── wave 2: calendar math + duration-free arithmetic ─────────────────────────────

// is_leap_year(y) → Gregorian leap-year rule.
fn is_leap_year(y) { return (num_mod(y, 4) == 0 and num_mod(y, 100) != 0) or num_mod(y, 400) == 0; }

// days_in_month(y, m) → number of days in month m (1..12) of year y.
fn days_in_month(y, m) {
    if m == 2 { if is_leap_year(y) { return 29; } return 28; }
    if m == 4 or m == 6 or m == 9 or m == 11 { return 30; }
    return 31;
}

// Convenience arithmetic (datetimes are unix seconds).
fn add_days(dt, n) { return dt + n * 86400; }
fn add_hours(dt, n) { return dt + n * 3600; }
fn add_minutes(dt, n) { return dt + n * 60; }
fn add_seconds(dt, n) { return dt + n; }

// ── Calendar-aware arithmetic ────────────────────────────────────────────────

// add_months(dt, n) — shift by whole calendar months, clamping the day to the
// target month's length (2024-01-31 + 1 month → 2024-02-29). `n` may be
// negative. Time-of-day is preserved.
fn add_months(dt, n) {
    let y = year(dt); let mo = month(dt); let d = day(dt);
    let h = hour(dt); let mi = minute(dt); let s = second(dt);
    // months elapsed since year 0, then floor-decompose back (robust for n<0)
    let total = (y * 12 + (mo - 1)) + n;
    let ny = num_floor(total / 12);
    let nmo = (total - ny * 12) + 1;
    let maxd = days_in_month(ny, nmo);
    if d > maxd { d = maxd; }
    return from_ymd(ny, nmo, d, h, mi, s);
}

// add_years(dt, n) — shift by whole years; Feb 29 clamps to Feb 28 on a
// non-leap target year (delegates to add_months so the day clamp is shared).
fn add_years(dt, n) { return add_months(dt, n * 12); }

// ── Period boundaries ────────────────────────────────────────────────────────
fn start_of_month(dt) { return from_ymd(year(dt), month(dt), 1, 0, 0, 0); }
fn end_of_month(dt) {
    let y = year(dt); let mo = month(dt);
    return from_ymd(y, mo, days_in_month(y, mo), 23, 59, 59);
}
fn start_of_year(dt) { return from_ymd(year(dt), 1, 1, 0, 0, 0); }
fn end_of_year(dt)   { return from_ymd(year(dt), 12, 31, 23, 59, 59); }

// start_of_week(dt) — 00:00 of the Monday of dt's week (ISO: week starts Monday).
fn start_of_week(dt) {
    let w = weekday(dt);                 // 0=Sun..6=Sat
    let back = num_mod(w + 6, 7);        // days since Monday
    return start_of_day(dt) - back * 86400;
}

// ── Calendar fields ──────────────────────────────────────────────────────────
fn quarter(dt) { return num_floor((month(dt) - 1) / 3) + 1; }

// day_of_year(dt) — 1 on Jan 1, up to 365/366.
fn day_of_year(dt) {
    let jan1 = from_ymd(year(dt), 1, 1, 0, 0, 0);
    return days_between(jan1, start_of_day(dt)) + 1;
}

// week_of_year(dt) — ISO 8601 week number (delegates to date.sapp).
fn week_of_year(dt) { return date.week_number(dt); }

// ── Ranges ───────────────────────────────────────────────────────────────────
// date_range(start, end, step_days) — timestamps from `start` to `end`
// inclusive, stepping `step_days` (default 1). Empty if step_days <= 0.
fn date_range(start, end, step_days = 1) {
    let out = [];
    if step_days <= 0 { return out; }
    let cur = start;
    let step = step_days * 86400;
    while cur <= end {
        out[len(out)] = cur;
        cur = cur + step;
    }
    return out;
}

// days_until(dt, target) — whole days from dt to target (negative if past).
fn days_until(dt, target) { return days_between(dt, target); }

// ── Business days (Mon–Fri) ──────────────────────────────────────────────────
fn is_business_day(dt) { return not is_weekend(dt); }

// add_business_days(dt, n) — advance (or, for n<0, rewind) by `n` business days,
// skipping Saturdays and Sundays. Time-of-day is preserved.
fn add_business_days(dt, n) {
    let cur = dt;
    let remaining = n;
    if n >= 0 {
        while remaining > 0 {
            cur = add_days(cur, 1);
            if is_business_day(cur) { remaining = remaining - 1; }
        }
    } else {
        while remaining < 0 {
            cur = add_days(cur, 0 - 1);
            if is_business_day(cur) { remaining = remaining + 1; }
        }
    }
    return cur;
}

// business_days_between(a, b) — count business days in the half-open span [a, b)
// (a full Mon-based work week = 5). Negative if b precedes a.
fn business_days_between(a, b) {
    if b < a { return 0 - business_days_between(b, a); }
    let count = 0;
    let cur = start_of_day(a);
    let end = start_of_day(b);
    while cur < end {
        if is_business_day(cur) { count = count + 1; }
        cur = add_days(cur, 1);
    }
    return count;
}

// is_same_day(a, b) — same calendar day (ignores time-of-day).
fn is_same_day(a, b) { return start_of_day(a) == start_of_day(b); }

// days_between(a, b) → whole days from a to b.
fn days_between(a, b) { return num_floor((b - a) / 86400.0); }

export is_leap_year, days_in_month, add_days, add_hours, add_minutes, add_seconds, days_between;
export add_months, add_years, start_of_month, end_of_month, start_of_year, end_of_year,
       start_of_week, quarter, day_of_year, week_of_year, date_range, days_until,
       is_business_day, add_business_days, business_days_between, is_same_day;
export dur, now, from_unix, to_unix, from_ymd;
export add, sub, diff, is_before, is_after, is_same, min_dt, max_dt;
export format, to_iso, parse_iso;
export year, month, day, hour, minute, second, start_of_day;
export relative, ago;
export weekday, weekday_name, is_weekend, end_of_day, clamp_dt, is_between;
