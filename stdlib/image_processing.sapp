//! image_processing.sapp — Image processing in pure pblang

fn rgb_to_grayscale(r, g, b) { return 0.299*r + 0.587*g + 0.114*b; }
fn grayscale_to_ascii(v) { const CHARS="@%#*+=-:. "; return CHARS[(v*9/255)..((v*9/255)+1)]; }
fn to_grayscale_image(img) { let r=[]; let y=0; while y<len(img) { let row=[]; let x=0; while x<len(img[y]) { let p=img[y][x]; if len(p)>=3{ array_push(row, rgb_to_grayscale(p[0],p[1],p[2])); } else { array_push(row, p[0]); } x=x+1; } array_push(r,row);y=y+1; } return r; }
fn to_ascii_art(img) { let r=""; let y=0; while y<len(img) { let x=0; while x<len(img[y]) { r=r+grayscale_to_ascii(img[y][x]); x=x+1; } r=r+"\n"; y=y+1; } return r; }
fn resize_bilinear(img, nw, nh) {
    let oh=len(img); if oh==0{return[];} let ow=len(img[0]); let r=[];
    let y=0; while y<nh { let row=[]; let sy=(y/(nh-1))*(oh-1); if nh==1{sy=0;} let y0=sy; let y1=y0+1; if y1>=oh{y1=oh-1;} let yf=sy-y0;
        let x=0; while x<nw { let sx=(x/(nw-1))*(ow-1); if nw==1{sx=0;} let x0=sx; let x1=x0+1; if x1>=ow{x1=ow-1;} let xf=sx-x0;
            let top=img[y0][x0]*(1-xf)+img[y0][x1]*xf; let bot=img[y1][x0]*(1-xf)+img[y1][x1]*xf;
            array_push(row, top*(1-yf)+bot*yf); x=x+1; } array_push(r,row); y=y+1; } return r;
}
fn blur_box(img, rad) { if rad==nil{rad=1;} let h=len(img); if h==0{return[];} let w=len(img[0]); let r=[]; let y=0; while y<h { let row=[]; let x=0; while x<w { let t=0.0; let c=0; let dy=-rad; while dy<=rad { let dx=-rad; while dx<=rad { let ny=y+dy; let nx=x+dx; if ny>=0and ny<h and nx>=0and nx<w { t=t+img[ny][nx]; c=c+1; } dx=dx+1; } dy=dy+1; } array_push(row, t/c); x=x+1; } array_push(r,row); y=y+1; } return r; }
fn edge_detect_sobel(img) { let h=len(img); if h<3{return[];} let w=len(img[0]); let r=[]; let y=1; while y<h-1 { let row=[]; let x=1; while x<w-1 { let gx=-img[y-1][x-1]+img[y-1][x+1]-2*img[y][x-1]+2*img[y][x+1]-img[y+1][x-1]+img[y+1][x+1]; let gy=-img[y-1][x-1]-2*img[y-1][x]-img[y-1][x+1]+img[y+1][x-1]+2*img[y+1][x]+img[y+1][x+1]; let m=num_sqrt(gx*gx+gy*gy); if m>255{m=255;} array_push(row,m); x=x+1; } array_push(r,row); y=y+1; } return r; }
fn threshold(img, v) { if v==nil{v=128;} let r=[]; let y=0; while y<len(img) { let row=[]; let x=0; while x<len(img[y]) { if img[y][x]>=v{array_push(row,255);}else{array_push(row,0);} x=x+1; } array_push(r,row); y=y+1; } return r; }
fn invert_colors(img) { let r=[]; let y=0; while y<len(img) { let row=[]; let x=0; while x<len(img[y]) { array_push(row,255-img[y][x]); x=x+1; } array_push(r,row); y=y+1; } return r; }
fn brightness_contrast(img, b, c) { if b==nil{b=0;} if c==nil{c=1.0;} let r=[]; let y=0; while y<len(img) { let row=[]; let x=0; while x<len(img[y]) { let v=(img[y][x]-128)*c+128+b; if v<0{v=0;}if v>255{v=255;} array_push(row,v); x=x+1; } array_push(r,row); y=y+1; } return r; }

export rgb_to_grayscale; export grayscale_to_ascii; export to_grayscale_image; export to_ascii_art;
export resize_bilinear; export blur_box; export edge_detect_sobel; export threshold;
export invert_colors; export brightness_contrast;
