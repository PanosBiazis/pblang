// stdlib/image_processing.sapp - pure pblang image processing.
//
// Images are row-major 2D arrays. A pixel may be a grayscale number, RGB
// [r,g,b], or RGBA [r,g,b,a]. Functions that operate on grayscale accept either
// grayscale matrices directly or RGB/RGBA images via to_grayscale_image().

fn clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn clamp_u8(v) { return num_floor(clamp(v, 0, 255)); }

fn width(img) {
    if len(img) == 0 { return 0; }
    return len(img[0]);
}

fn height(img) { return len(img); }

fn dimensions(img) { return map{ w: width(img), h: height(img) }; }

fn make_image(w, h, fill) {
    let out = [];
    let y = 0;
    while y < h {
        let row = [];
        let x = 0;
        while x < w { array_push(row, fill); x = x + 1; }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn clone_image(img) {
    let out = [];
    let y = 0;
    while y < len(img) {
        let row = [];
        let x = 0;
        while x < len(img[y]) { array_push(row, img[y][x]); x = x + 1; }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn get_pixel(img, x, y, fallback) {
    if y < 0 or y >= len(img) { return fallback; }
    if x < 0 or x >= len(img[y]) { return fallback; }
    return img[y][x];
}

fn rgb_to_grayscale(r, g, b) { return 0.299 * r + 0.587 * g + 0.114 * b; }

fn pixel_luma(p) {
    if type(p) == "array" {
        if len(p) >= 3 { return rgb_to_grayscale(p[0], p[1], p[2]); }
        if len(p) == 1 { return p[0]; }
        return 0;
    }
    return p;
}

fn to_grayscale_image(img) {
    let out = [];
    let y = 0;
    while y < len(img) {
        let row = [];
        let x = 0;
        while x < len(img[y]) {
            array_push(row, clamp_u8(pixel_luma(img[y][x])));
            x = x + 1;
        }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn grayscale_to_ascii(v) {
    let chars = "@%#*+=-:. ";
    let idx = num_floor(clamp(v, 0, 255) * (len(chars) - 1) / 255);
    return chars[idx..(idx + 1)];
}

fn to_ascii_art(img) {
    let gray = to_grayscale_image(img);
    let out = "";
    let y = 0;
    while y < len(gray) {
        let x = 0;
        while x < len(gray[y]) {
            out = out + grayscale_to_ascii(gray[y][x]);
            x = x + 1;
        }
        if y + 1 < len(gray) { out = out + "\n"; }
        y = y + 1;
    }
    return out;
}

fn map_pixels(img, fn_) {
    let out = [];
    let y = 0;
    while y < len(img) {
        let row = [];
        let x = 0;
        while x < len(img[y]) {
            array_push(row, fn_(img[y][x], x, y));
            x = x + 1;
        }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn invert_colors(img) {
    return map_pixels(img, fn(p, x, y) {
        if type(p) == "array" {
            if len(p) >= 4 { return [255 - p[0], 255 - p[1], 255 - p[2], p[3]]; }
            if len(p) >= 3 { return [255 - p[0], 255 - p[1], 255 - p[2]]; }
            if len(p) == 1 { return [255 - p[0]]; }
        }
        return 255 - p;
    });
}

fn brightness_contrast(img, brightness = nil, contrast = nil) {
    if brightness == nil { brightness = 0; }
    if contrast == nil { contrast = 1.0; }
    let gray = to_grayscale_image(img);
    return map_pixels(gray, fn(p, x, y) {
        return clamp_u8((p - 128) * contrast + 128 + brightness);
    });
}

fn histogram(img) {
    let gray = to_grayscale_image(img);
    let hist = [];
    let i = 0;
    while i < 256 { array_push(hist, 0); i = i + 1; }
    let y = 0;
    while y < len(gray) {
        let x = 0;
        while x < len(gray[y]) {
            let b = clamp_u8(gray[y][x]);
            hist[b] = hist[b] + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    return hist;
}

fn threshold(img, value = nil) {
    if value == nil { value = 128; }
    let gray = to_grayscale_image(img);
    return map_pixels(gray, fn(p, x, y) {
        if p >= value { return 255; }
        return 0;
    });
}

fn threshold_otsu(img) {
    let hist = histogram(img);
    let total = 0;
    let sum = 0;
    let i = 0;
    while i < 256 { total = total + hist[i]; sum = sum + i * hist[i]; i = i + 1; }
    let sum_b = 0;
    let w_b = 0;
    let max_var = -1;
    let threshold_value = 0;
    i = 0;
    while i < 256 {
        w_b = w_b + hist[i];
        if w_b > 0 {
            let w_f = total - w_b;
            if w_f == 0 { i = 256; }
            else {
                sum_b = sum_b + i * hist[i];
                let m_b = sum_b / w_b;
                let m_f = (sum - sum_b) / w_f;
                let between = w_b * w_f * (m_b - m_f) * (m_b - m_f);
                if between > max_var { max_var = between; threshold_value = i; }
            }
        }
        i = i + 1;
    }
    return threshold_value;
}

fn convolve(img, kernel, divisor = nil, bias = nil) {
    if divisor == nil { divisor = 1; }
    if bias == nil { bias = 0; }
    let gray = to_grayscale_image(img);
    let kh = len(kernel);
    let kw = len(kernel[0]);
    let ky0 = num_floor(kh / 2);
    let kx0 = num_floor(kw / 2);
    let out = [];
    let y = 0;
    while y < len(gray) {
        let row = [];
        let x = 0;
        while x < len(gray[y]) {
            let acc = 0.0;
            let ky = 0;
            while ky < kh {
                let kx = 0;
                while kx < kw {
                    let px = get_pixel(gray, x + kx - kx0, y + ky - ky0, gray[y][x]);
                    acc = acc + px * kernel[ky][kx];
                    kx = kx + 1;
                }
                ky = ky + 1;
            }
            array_push(row, clamp_u8(acc / divisor + bias));
            x = x + 1;
        }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn blur_box(img, radius = nil) {
    if radius == nil { radius = 1; }
    let size = radius * 2 + 1;
    let kernel = [];
    let y = 0;
    while y < size {
        let row = [];
        let x = 0;
        while x < size { array_push(row, 1); x = x + 1; }
        array_push(kernel, row);
        y = y + 1;
    }
    return convolve(img, kernel, size * size, 0);
}

fn sharpen(img) { return convolve(img, [[0, -1, 0], [-1, 5, -1], [0, -1, 0]], 1, 0); }

fn edge_detect_sobel(img) {
    let gray = to_grayscale_image(img);
    let h = len(gray);
    if h == 0 { return []; }
    let w = len(gray[0]);
    let out = make_image(w, h, 0);
    let y = 0;
    while y < h {
        let x = 0;
        while x < w {
            let gx = -get_pixel(gray, x - 1, y - 1, gray[y][x]) + get_pixel(gray, x + 1, y - 1, gray[y][x])
                - 2 * get_pixel(gray, x - 1, y, gray[y][x]) + 2 * get_pixel(gray, x + 1, y, gray[y][x])
                - get_pixel(gray, x - 1, y + 1, gray[y][x]) + get_pixel(gray, x + 1, y + 1, gray[y][x]);
            let gy = -get_pixel(gray, x - 1, y - 1, gray[y][x]) - 2 * get_pixel(gray, x, y - 1, gray[y][x]) - get_pixel(gray, x + 1, y - 1, gray[y][x])
                + get_pixel(gray, x - 1, y + 1, gray[y][x]) + 2 * get_pixel(gray, x, y + 1, gray[y][x]) + get_pixel(gray, x + 1, y + 1, gray[y][x]);
            out[y][x] = clamp_u8(num_sqrt(gx * gx + gy * gy));
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

fn resize_nearest(img, nw, nh) {
    let h = len(img);
    if h == 0 or nw <= 0 or nh <= 0 { return []; }
    let w = len(img[0]);
    let out = [];
    let y = 0;
    while y < nh {
        let row = [];
        let sy = num_floor(y * h / nh);
        if sy >= h { sy = h - 1; }
        let x = 0;
        while x < nw {
            let sx = num_floor(x * w / nw);
            if sx >= w { sx = w - 1; }
            array_push(row, img[sy][sx]);
            x = x + 1;
        }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn resize_bilinear(img, nw, nh) {
    let gray = to_grayscale_image(img);
    let h = len(gray);
    if h == 0 or nw <= 0 or nh <= 0 { return []; }
    let w = len(gray[0]);
    let out = [];
    let y = 0;
    while y < nh {
        let row = [];
        let sy = 0;
        if nh > 1 { sy = y * (h - 1) / (nh - 1); }
        let y0 = num_floor(sy);
        let y1 = y0 + 1;
        if y1 >= h { y1 = h - 1; }
        let yf = sy - y0;
        let x = 0;
        while x < nw {
            let sx = 0;
            if nw > 1 { sx = x * (w - 1) / (nw - 1); }
            let x0 = num_floor(sx);
            let x1 = x0 + 1;
            if x1 >= w { x1 = w - 1; }
            let xf = sx - x0;
            let top = gray[y0][x0] * (1 - xf) + gray[y0][x1] * xf;
            let bot = gray[y1][x0] * (1 - xf) + gray[y1][x1] * xf;
            array_push(row, clamp_u8(top * (1 - yf) + bot * yf));
            x = x + 1;
        }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn crop(img, x, y, w, h) {
    let out = [];
    let yy = 0;
    while yy < h {
        let row = [];
        let xx = 0;
        while xx < w {
            array_push(row, get_pixel(img, x + xx, y + yy, 0));
            xx = xx + 1;
        }
        array_push(out, row);
        yy = yy + 1;
    }
    return out;
}

fn flip_horizontal(img) {
    let out = [];
    let y = 0;
    while y < len(img) {
        let row = [];
        let x = len(img[y]) - 1;
        while x >= 0 { array_push(row, img[y][x]); x = x - 1; }
        array_push(out, row);
        y = y + 1;
    }
    return out;
}

fn flip_vertical(img) {
    let out = [];
    let y = len(img) - 1;
    while y >= 0 { array_push(out, img[y]); y = y - 1; }
    return out;
}

fn rotate90(img) {
    let h = len(img);
    if h == 0 { return []; }
    let w = len(img[0]);
    let out = [];
    let x = 0;
    while x < w {
        let row = [];
        let y = h - 1;
        while y >= 0 { array_push(row, img[y][x]); y = y - 1; }
        array_push(out, row);
        x = x + 1;
    }
    return out;
}

fn dilate(img, radius = nil) {
    if radius == nil { radius = 1; }
    let gray = to_grayscale_image(img);
    let out = clone_image(gray);
    let y = 0;
    while y < len(gray) {
        let x = 0;
        while x < len(gray[y]) {
            let m = 0;
            let dy = 0 - radius;
            while dy <= radius {
                let dx = 0 - radius;
                while dx <= radius {
                    let v = get_pixel(gray, x + dx, y + dy, 0);
                    if v > m { m = v; }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            out[y][x] = m;
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

fn erode(img, radius = nil) {
    if radius == nil { radius = 1; }
    let gray = to_grayscale_image(img);
    let out = clone_image(gray);
    let y = 0;
    while y < len(gray) {
        let x = 0;
        while x < len(gray[y]) {
            let m = 255;
            let dy = 0 - radius;
            while dy <= radius {
                let dx = 0 - radius;
                while dx <= radius {
                    let v = get_pixel(gray, x + dx, y + dy, 255);
                    if v < m { m = v; }
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            out[y][x] = m;
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

export clamp, clamp_u8, width, height, dimensions, make_image, clone_image, get_pixel;
export rgb_to_grayscale, pixel_luma, to_grayscale_image, grayscale_to_ascii, to_ascii_art;
export map_pixels, invert_colors, brightness_contrast, histogram, threshold, threshold_otsu;
export convolve, blur_box, sharpen, edge_detect_sobel;
export resize_nearest, resize_bilinear, crop, flip_horizontal, flip_vertical, rotate90;
export dilate, erode;
