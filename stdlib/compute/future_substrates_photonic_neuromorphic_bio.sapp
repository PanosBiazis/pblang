// stdlib/compute/future_substrates_photonic_neuromorphic_bio.sapp
// PBLang v5.3.0 — Pillar 3: Future Non-Classical Compute Substrates
//
// 100% pure PBLang (.sapp) mathematical implementations of four post-CMOS
// compute substrates:
//   1. Photonic Interferometer Mesh (Clements Universal Multiport Optical Processor)
//   2. Neuromorphic Spiking Fabric (LIF + Asymmetric STDP + AER Packet Routing)
//   3. Biological / DNA Archival Storage Codec (Homopolymer-Free, GC-Balanced,
//      Single-Base SEC) & Mass-Action Chemical Reaction Network (CRN) Solver
//   4. Analog Compute-in-Memory (ReRAM Differential Crossbar for BitNet b1.58)

let FUTURE_SUBSTRATES_VERSION = "5.3.0";

// ============================================================================
// Internal numeric & bitwise helpers (pure PBLang)
// ============================================================================

fn _abs(x) {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

fn _clamp(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _round(x) {
    if x >= 0.0 { return num_floor(x + 0.5); }
    return 0.0 - num_floor((0.0 - x) + 0.5);
}

fn _pow_int(base, exp_n) {
    let acc = 1.0;
    let i = 0;
    while i < exp_n {
        acc = acc * base;
        i = i + 1;
    }
    return acc;
}

fn _pow2_int(bits) {
    let acc = 1;
    let i = 0;
    while i < bits {
        acc = acc * 2;
        i = i + 1;
    }
    return acc;
}

fn _bit_get(n, bit_idx) {
    let d = _pow2_int(bit_idx);
    return num_floor(n / d) % 2;
}

fn _xor8(a, b) {
    let x = num_floor(a) % 256;
    let y = num_floor(b) % 256;
    if x < 0 { x = x + 256; }
    if y < 0 { y = y + 256; }
    let out = 0;
    let p = 1;
    let i = 0;
    while i < 8 {
        let bx = x % 2;
        let by = y % 2;
        if bx != by {
            out = out + p;
        }
        x = num_floor(x / 2);
        y = num_floor(y / 2);
        p = p * 2;
        i = i + 1;
    }
    return out;
}

fn _map_get_or(m, key, fallback) {
    if m == nil or type(m) != "map" { return fallback; }
    if map_has(m, key) { return m[key]; }
    return fallback;
}

// Complex arithmetic on [re, im] pairs
fn _c_add(a, b) { return [a[0] + b[0], a[1] + b[1]]; }
fn _c_sub(a, b) { return [a[0] - b[0], a[1] - b[1]]; }
fn _c_mul(a, b) { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]]; }
fn _c_conj(a)   { return [a[0], 0.0 - a[1]]; }
fn _c_abs2(a)   { return a[0] * a[0] + a[1] * a[1]; }

// ============================================================================
// 1. Photonic Interferometer Mesh (Clements Universal Optical Processor)
// ============================================================================

// Exact 2x2 Mach-Zehnder Interferometer (MZI) unitary transfer matrix:
//   T(theta, phi) = [ [ exp(i*phi)*cos(theta),  -sin(theta) ],
//                     [ exp(i*phi)*sin(theta),   cos(theta) ] ]
// Each entry is a complex pair [re, im]. Satisfies T^dagger * T == I exactly.
fn photonic_mzi_matrix(theta, phi) {
    let ct = num_cos(theta);
    let st = num_sin(theta);
    let cp = num_cos(phi);
    let sp = num_sin(phi);
    let m00 = [cp * ct, sp * ct];
    let m01 = [0.0 - st, 0.0];
    let m10 = [cp * st, sp * st];
    let m11 = [ct, 0.0];
    return [[m00, m01], [m10, m11]];
}

fn _photonic_apply_mzi_left(u_mat, n_modes, a, b, theta, phi) {
    let t = photonic_mzi_matrix(theta, phi);
    let t00 = t[0][0];
    let t01 = t[0][1];
    let t10 = t[1][0];
    let t11 = t[1][1];
    let col = 0;
    while col < n_modes {
        let ua = u_mat[a][col];
        let ub = u_mat[b][col];
        let na = _c_add(_c_mul(t00, ua), _c_mul(t01, ub));
        let nb = _c_add(_c_mul(t10, ua), _c_mul(t11, ub));
        u_mat[a][col] = na;
        u_mat[b][col] = nb;
        col = col + 1;
    }
}

fn _photonic_unitary_frobenius_error(u_mat, n_modes) {
    // Computes ||U^dagger * U - I||_F
    let sum_sq = 0.0;
    let i = 0;
    while i < n_modes {
        let j = 0;
        while j < n_modes {
            let acc = [0.0, 0.0];
            let k = 0;
            while k < n_modes {
                let u_dag_ik = _c_conj(u_mat[k][i]);
                let u_kj = u_mat[k][j];
                acc = _c_add(acc, _c_mul(u_dag_ik, u_kj));
                k = k + 1;
            }
            if i == j {
                acc[0] = acc[0] - 1.0;
            }
            sum_sq = sum_sq + _c_abs2(acc);
            j = j + 1;
        }
        i = i + 1;
    }
    return num_sqrt(sum_sq);
}

// Constructs an N x N universal optical unitary U from Clements MZI layers.
// n_modes >= 2.
// mzi_layers: array of layers (each layer is an array of MZI gate maps) OR a
// flat array of MZI gate maps:
//   map{ "mode_a": a, "mode_b": b, "theta": th, "phi": ph }
//   (also accepts "mode": m as shorthand for adjacent pair (m, m+1)).
fn photonic_clements_build_mesh(n_modes, mzi_layers) {
    if type(n_modes) != "number" or num_floor(n_modes) != n_modes or n_modes < 2 {
        return map{ "ok": false, "error": "photonic_clements_build_mesh: n_modes must be integer >= 2" };
    }
    if not is_array(mzi_layers) {
        return map{ "ok": false, "error": "photonic_clements_build_mesh: mzi_layers must be an array" };
    }

    // Initialize U = I_N
    let u_mat = [];
    let r = 0;
    while r < n_modes {
        let row = [];
        let c = 0;
        while c < n_modes {
            if r == c {
                array_push(row, [1.0, 0.0]);
            } else {
                array_push(row, [0.0, 0.0]);
            }
            c = c + 1;
        }
        array_push(u_mat, row);
        r = r + 1;
    }

    let mzi_count = 0;
    let depth = 0;
    let li = 0;
    while li < len(mzi_layers) {
        let item = mzi_layers[li];
        let gates = [];
        if is_array(item) {
            gates = item;
            depth = depth + 1;
        } else if type(item) == "map" {
            gates = [item];
            depth = depth + 1;
        } else {
            return map{ "ok": false, "error": "photonic_clements_build_mesh: invalid layer element at index " + str(li) };
        }

        let gi = 0;
        while gi < len(gates) {
            let g = gates[gi];
            if type(g) != "map" {
                return map{ "ok": false, "error": "photonic_clements_build_mesh: MZI gate must be a map" };
            }
            let a = _map_get_or(g, "mode_a", _map_get_or(g, "mode", -1));
            let b = _map_get_or(g, "mode_b", a + 1);
            let th = _map_get_or(g, "theta", 0.0);
            let ph = _map_get_or(g, "phi", 0.0);
            if a < 0 or a >= n_modes or b < 0 or b >= n_modes or a == b {
                return map{ "ok": false, "error": "photonic_clements_build_mesh: invalid mode pair (" + str(a) + ", " + str(b) + ")" };
            }
            _photonic_apply_mzi_left(u_mat, n_modes, a, b, th, ph);
            mzi_count = mzi_count + 1;
            gi = gi + 1;
        }
        li = li + 1;
    }

    let err = _photonic_unitary_frobenius_error(u_mat, n_modes);
    return map{
        "ok": true,
        "n_modes": n_modes,
        "mzi_count": mzi_count,
        "depth": depth,
        "unitary": u_mat,
        "unitary_error": err,
        "is_unitary": err < 0.000000001
    };
}

// Computes O(1)-optical-pass complex matrix-vector product y = U * v,
// verifying exact optical energy conservation ||U v||_2 == ||v||_2.
fn photonic_optical_matvec(mesh, vec_re, vec_im = nil) {
    if type(mesh) != "map" or not _map_get_or(mesh, "ok", false) {
        return map{ "ok": false, "error": "photonic_optical_matvec: invalid mesh" };
    }
    let n = mesh["n_modes"];
    let u_mat = mesh["unitary"];
    if not is_array(vec_re) or len(vec_re) != n {
        return map{ "ok": false, "error": "photonic_optical_matvec: vec_re length must equal n_modes" };
    }
    let vim = vec_im;
    if vim == nil {
        vim = [];
        let z = 0;
        while z < n {
            array_push(vim, 0.0);
            z = z + 1;
        }
    }
    if not is_array(vim) or len(vim) != n {
        return map{ "ok": false, "error": "photonic_optical_matvec: vec_im length must equal n_modes" };
    }

    let in_energy = 0.0;
    let i = 0;
    while i < n {
        in_energy = in_energy + vec_re[i] * vec_re[i] + vim[i] * vim[i];
        i = i + 1;
    }

    let out_re = [];
    let out_im = [];
    let out_energy = 0.0;
    let r = 0;
    while r < n {
        let acc = [0.0, 0.0];
        let c = 0;
        while c < n {
            let v_c = [vec_re[c], vim[c]];
            acc = _c_add(acc, _c_mul(u_mat[r][c], v_c));
            c = c + 1;
        }
        array_push(out_re, acc[0]);
        array_push(out_im, acc[1]);
        out_energy = out_energy + _c_abs2(acc);
        r = r + 1;
    }

    let in_norm = num_sqrt(in_energy);
    let out_norm = num_sqrt(out_energy);
    let energy_err = _abs(out_norm - in_norm);

    return map{
        "ok": true,
        "out_re": out_re,
        "out_im": out_im,
        "input_norm": in_norm,
        "output_norm": out_norm,
        "energy_error": energy_err,
        "energy_conserved": energy_err < 0.000000001,
        "optical_passes": 1
    };
}

// ============================================================================
// 2. Neuromorphic Spiking Fabric (LIF + Asymmetric STDP + AER Packet Routing)
// ============================================================================

// Creates a Leaky Integrate-and-Fire (LIF) neuromorphic fabric with STDP
// plasticity and picojoule (pJ) synaptic event energy accounting.
// weights[post][pre]: synaptic weight from pre-synaptic neuron to post-synaptic neuron.
fn neuromorphic_create_fabric(n_neurons, weights, params = nil) {
    if type(n_neurons) != "number" or num_floor(n_neurons) != n_neurons or n_neurons < 1 {
        return map{ "ok": false, "error": "neuromorphic_create_fabric: n_neurons must be integer >= 1" };
    }
    if not is_array(weights) or len(weights) != n_neurons {
        return map{ "ok": false, "error": "neuromorphic_create_fabric: weights must be N x N array" };
    }

    let w_copy = [];
    let i = 0;
    while i < n_neurons {
        if not is_array(weights[i]) or len(weights[i]) != n_neurons {
            return map{ "ok": false, "error": "neuromorphic_create_fabric: weights row " + str(i) + " length mismatch" };
        }
        let row = [];
        let j = 0;
        while j < n_neurons {
            array_push(row, weights[i][j] * 1.0);
            j = j + 1;
        }
        array_push(w_copy, row);
        i = i + 1;
    }

    let v = [];
    let ref_until = [];
    let last_spike = [];
    let k = 0;
    while k < n_neurons {
        array_push(v, 0.0);
        array_push(ref_until, -1.0);
        array_push(last_spike, -1000000.0);
        k = k + 1;
    }

    return map{
        "ok": true,
        "n_neurons": n_neurons,
        "weights": w_copy,
        "v": v,
        "refractory_until_ms": ref_until,
        "last_spike_ms": last_spike,
        "time_ms": 0.0,
        "leak": _map_get_or(params, "leak", 0.85),
        "threshold": _map_get_or(params, "threshold", 1.0),
        "v_reset": _map_get_or(params, "v_reset", 0.0),
        "refractory_ms": _map_get_or(params, "refractory_ms", 2.0),
        "stdp_a_plus": _map_get_or(params, "stdp_a_plus", 0.05),
        "stdp_a_minus": _map_get_or(params, "stdp_a_minus", 0.06),
        "stdp_tau_plus_ms": _map_get_or(params, "stdp_tau_plus_ms", 20.0),
        "stdp_tau_minus_ms": _map_get_or(params, "stdp_tau_minus_ms", 20.0),
        "w_min": _map_get_or(params, "w_min", 0.0),
        "w_max": _map_get_or(params, "w_max", 2.0),
        "pj_per_synop": _map_get_or(params, "pj_per_synop", 0.1),
        "pj_per_dense_mac": _map_get_or(params, "pj_per_dense_mac", 4.6),
        "total_synops": 0,
        "total_spikes": 0,
        "total_energy_pj": 0.0,
        "total_dense_equiv_energy_pj": 0.0,
        "ltp_updates": 0,
        "ltd_updates": 0
    };
}

// Advances the neuromorphic fabric by dt_ms using Address-Event Representation
// (AER) spike packets, LIF dynamics, asymmetric STDP learning, and pJ energy tracking.
// input_spikes entries can be:
//   - integer pre-synaptic neuron ID (broadcasts via W[post][pre] != 0)
//   - map{ "src": pre } (same broadcast)
//   - map{ "src": pre, "dst": post, "gain": 1.0 } (point-to-point AER packet)
//   - map{ "dst": post, "current": amp } or map{ "neuron": post, "current": amp } (direct current)
fn neuromorphic_step_aer(fabric, input_spikes, dt_ms = 1.0) {
    if type(fabric) != "map" or not _map_get_or(fabric, "ok", false) {
        return map{ "ok": false, "error": "neuromorphic_step_aer: invalid fabric" };
    }
    if not is_array(input_spikes) {
        return map{ "ok": false, "error": "neuromorphic_step_aer: input_spikes must be an array" };
    }
    if dt_ms <= 0.0 {
        return map{ "ok": false, "error": "neuromorphic_step_aer: dt_ms must be > 0" };
    }

    let n = fabric["n_neurons"];
    let w = fabric["weights"];
    let v = fabric["v"];
    let ref_until = fabric["refractory_until_ms"];
    let last_spike = fabric["last_spike_ms"];
    let t_now = fabric["time_ms"] + dt_ms;

    let i_syn = [];
    let pre_event = [];
    let post_fired = [];
    let z = 0;
    while z < n {
        array_push(i_syn, 0.0);
        array_push(pre_event, false);
        array_push(post_fired, false);
        z = z + 1;
    }

    let step_synops = 0;

    // 1. Route AER input packets
    let si = 0;
    while si < len(input_spikes) {
        let pkt = input_spikes[si];
        if type(pkt) == "number" {
            let src = num_floor(pkt);
            if src >= 0 and src < n {
                pre_event[src] = true;
                let post = 0;
                while post < n {
                    if post != src and w[post][src] != 0.0 {
                        i_syn[post] = i_syn[post] + w[post][src];
                        step_synops = step_synops + 1;
                    }
                    post = post + 1;
                }
            }
        } else if type(pkt) == "map" {
            let has_src = map_has(pkt, "src");
            let has_dst = map_has(pkt, "dst");
            let has_neuron = map_has(pkt, "neuron");
            let has_curr = map_has(pkt, "current");

            if has_src and has_dst {
                let src = num_floor(pkt["src"]);
                let dst = num_floor(pkt["dst"]);
                let gain = _map_get_or(pkt, "gain", 1.0);
                if src >= 0 and src < n and dst >= 0 and dst < n {
                    pre_event[src] = true;
                    i_syn[dst] = i_syn[dst] + w[dst][src] * gain;
                    step_synops = step_synops + 1;
                }
            } else if has_dst and has_curr {
                let dst = num_floor(pkt["dst"]);
                if dst >= 0 and dst < n {
                    i_syn[dst] = i_syn[dst] + pkt["current"];
                    step_synops = step_synops + 1;
                }
            } else if has_neuron and has_curr {
                let dst = num_floor(pkt["neuron"]);
                if dst >= 0 and dst < n {
                    i_syn[dst] = i_syn[dst] + pkt["current"];
                    step_synops = step_synops + 1;
                }
            } else if has_src {
                let src = num_floor(pkt["src"]);
                if src >= 0 and src < n {
                    pre_event[src] = true;
                    if has_curr {
                        i_syn[src] = i_syn[src] + pkt["current"];
                        step_synops = step_synops + 1;
                    } else {
                        let post = 0;
                        while post < n {
                            if post != src and w[post][src] != 0.0 {
                                i_syn[post] = i_syn[post] + w[post][src];
                                step_synops = step_synops + 1;
                            }
                            post = post + 1;
                        }
                    }
                }
            }
        }
        si = si + 1;
    }

    // 2. LIF membrane update: V_{t+1} = lambda * V_t + I_syn with reset & refractory
    let leak = fabric["leak"];
    let thresh = fabric["threshold"];
    let v_reset = fabric["v_reset"];
    let ref_ms = fabric["refractory_ms"];
    let fired_ids = [];
    let aer_out = [];

    let ni = 0;
    while ni < n {
        if t_now < ref_until[ni] {
            v[ni] = v_reset;
        } else {
            let v_next = leak * v[ni] + i_syn[ni];
            if v_next >= thresh {
                post_fired[ni] = true;
                v[ni] = v_reset;
                ref_until[ni] = t_now + ref_ms;
                array_push(fired_ids, ni);
                let targets = [];
                let dst_k = 0;
                while dst_k < n {
                    if dst_k != ni and w[dst_k][ni] != 0.0 {
                        array_push(targets, dst_k);
                    }
                    dst_k = dst_k + 1;
                }
                array_push(aer_out, map{ "src": ni, "time_ms": t_now, "targets": targets });
            } else {
                v[ni] = v_next;
            }
        }
        ni = ni + 1;
    }

    // 3. Asymmetric STDP learning (pre-before-post LTP, post-before-pre LTD)
    let a_plus = fabric["stdp_a_plus"];
    let a_minus = fabric["stdp_a_minus"];
    let tau_plus = fabric["stdp_tau_plus_ms"];
    let tau_minus = fabric["stdp_tau_minus_ms"];
    let w_min = fabric["w_min"];
    let w_max = fabric["w_max"];
    let step_ltp = 0;
    let step_ltd = 0;

    // 3a. LTP: post neuron i fired at t_now; strengthen synapses from pre j that
    //     spiked at t_pre <= t_now (causal pre -> post window).
    let pi = 0;
    while pi < n {
        if post_fired[pi] {
            let pj = 0;
            while pj < n {
                if pj != pi {
                    let dt_ltp = -1.0;
                    if pre_event[pj] {
                        dt_ltp = 0.0;
                    } else if last_spike[pj] >= 0.0 and last_spike[pj] < t_now {
                        dt_ltp = t_now - last_spike[pj];
                    }
                    if dt_ltp >= 0.0 and dt_ltp <= 5.0 * tau_plus {
                        let dw = a_plus * num_exp((0.0 - dt_ltp) / tau_plus);
                        w[pi][pj] = _clamp(w[pi][pj] + dw, w_min, w_max);
                        step_ltp = step_ltp + 1;
                    }
                }
                pj = pj + 1;
            }
        }
        pi = pi + 1;
    }

    // 3b. LTD: pre neuron j spiked at t_now (via AER input or firing); weaken
    //     synapses to post i that spiked strictly before t_now (anti-causal post -> pre).
    let qj = 0;
    while qj < n {
        if pre_event[qj] or post_fired[qj] {
            let qi = 0;
            while qi < n {
                if qi != qj and last_spike[qi] >= 0.0 and last_spike[qi] < t_now {
                    let dt_ltd = t_now - last_spike[qi];
                    if dt_ltd > 0.0 and dt_ltd <= 5.0 * tau_minus {
                        let dw = a_minus * num_exp((0.0 - dt_ltd) / tau_minus);
                        w[qi][qj] = _clamp(w[qi][qj] - dw, w_min, w_max);
                        step_ltd = step_ltd + 1;
                    }
                }
                qi = qi + 1;
            }
        }
        qj = qj + 1;
    }

    // 4. Commit spike timestamps for this step
    let ui = 0;
    while ui < n {
        if pre_event[ui] or post_fired[ui] {
            last_spike[ui] = t_now;
        }
        ui = ui + 1;
    }

    // 5. Energy accounting in picojoules (pJ)
    let step_energy_pj = step_synops * fabric["pj_per_synop"];
    let dense_macs = n * n;
    let step_dense_pj = dense_macs * fabric["pj_per_dense_mac"];
    let savings_ratio = 0.0;
    if step_energy_pj > 0.0 {
        savings_ratio = step_dense_pj / step_energy_pj;
    } else {
        savings_ratio = step_dense_pj;
    }

    fabric["time_ms"] = t_now;
    fabric["total_synops"] = fabric["total_synops"] + step_synops;
    fabric["total_spikes"] = fabric["total_spikes"] + len(fired_ids);
    fabric["total_energy_pj"] = fabric["total_energy_pj"] + step_energy_pj;
    fabric["total_dense_equiv_energy_pj"] = fabric["total_dense_equiv_energy_pj"] + step_dense_pj;
    fabric["ltp_updates"] = fabric["ltp_updates"] + step_ltp;
    fabric["ltd_updates"] = fabric["ltd_updates"] + step_ltd;

    return map{
        "ok": true,
        "time_ms": t_now,
        "fired_neurons": fired_ids,
        "aer_packets": aer_out,
        "step_synops": step_synops,
        "step_energy_pj": step_energy_pj,
        "dense_equiv_energy_pj": step_dense_pj,
        "energy_savings_ratio": savings_ratio,
        "ltp_updates": step_ltp,
        "ltd_updates": step_ltd,
        "fabric": fabric
    };
}

// ============================================================================
// 3. Biological / DNA Archival Storage Codec & Mass-Action CRN Solver
// ============================================================================

let _DNA_BASES = ["A", "C", "G", "T"];

// Rotating base-3 transition table (Goldman et al.):
// Given prev_base in 0..3 and trit in 0..2, selects next_base != prev_base.
let _DNA_ROT_NEXT = [
    [1, 2, 3],
    [2, 3, 0],
    [3, 0, 1],
    [0, 1, 2]
];

fn _dna_char_to_idx(ch) {
    if ch == "A" { return 0; }
    if ch == "C" { return 1; }
    if ch == "G" { return 2; }
    if ch == "T" { return 3; }
    return -1;
}

fn _dna_rot_trit(prev_b, next_b) {
    let row = _DNA_ROT_NEXT[prev_b];
    if row[0] == next_b { return 0; }
    if row[1] == next_b { return 1; }
    if row[2] == next_b { return 2; }
    return -1;
}

fn _dna_prng_byte(mask_id, pos) {
    // Deterministic 8-bit LCG/hash whitening keystream for GC balancing
    let h = ((mask_id + 17) * 73 + (pos + 11) * 137 + (mask_id * pos) * 29 + 53) % 256;
    if h < 0 { h = h + 256; }
    return h;
}

fn _dna_str_to_utf8_bytes(s) {
    let out = [];
    let i = 0;
    while i < len(s) {
        let cp = strcharcodeat(s, i);
        if cp <= 127 {
            array_push(out, cp);
        } else if cp <= 2047 {
            array_push(out, 192 + num_floor(cp / 64));
            array_push(out, 128 + (cp % 64));
        } else if cp <= 65535 {
            array_push(out, 224 + num_floor(cp / 4096));
            array_push(out, 128 + (num_floor(cp / 64) % 64));
            array_push(out, 128 + (cp % 64));
        } else {
            array_push(out, 240 + num_floor(cp / 262144));
            array_push(out, 128 + (num_floor(cp / 4096) % 64));
            array_push(out, 128 + (num_floor(cp / 64) % 64));
            array_push(out, 128 + (cp % 64));
        }
        i = i + 1;
    }
    return out;
}

fn _dna_strand_metrics(bases) {
    let n = len(bases);
    if n == 0 {
        return map{ "max_run": 0, "gc_ratio": 0.0 };
    }
    let max_run = 1;
    let cur_run = 1;
    let gc_count = 0;
    let i = 0;
    while i < n {
        if bases[i] == 1 or bases[i] == 2 {
            gc_count = gc_count + 1;
        }
        if i > 0 {
            if bases[i] == bases[i - 1] {
                cur_run = cur_run + 1;
                if cur_run > max_run { max_run = cur_run; }
            } else {
                cur_run = 1;
            }
        }
        i = i + 1;
    }
    return map{ "max_run": max_run, "gc_ratio": (gc_count * 1.0) / (n * 1.0) };
}

fn _dna_encode_chunk_with_mask(chunk, mask_id) {
    // Frame: [mask_id, chunk_len, masked_payload...]
    let frame = [mask_id, len(chunk)];
    let i = 0;
    while i < len(chunk) {
        array_push(frame, _xor8(chunk[i], _dna_prng_byte(mask_id, i)));
        i = i + 1;
    }

    // Encode each byte as 6 base-3 trits via rotating DNA bases (homopolymer run == 1)
    let data_bases = [];
    let prev_b = mask_id % 4;
    let bi = 0;
    while bi < len(frame) {
        let val = frame[bi];
        let trits = [];
        let t = 0;
        while t < 6 {
            array_push(trits, val % 3);
            val = num_floor(val / 3);
            t = t + 1;
        }
        let ti = 0;
        while ti < 6 {
            let nb = _DNA_ROT_NEXT[prev_b][trits[ti]];
            array_push(data_bases, nb);
            prev_b = nb;
            ti = ti + 1;
        }
        bi = bi + 1;
    }

    // Compute 8-base Z_4 Hamming Single-Base Error-Correcting Code (SEC):
    //   P[0] = sum(data_bases) mod 4
    //   P[1+b] = sum(data_bases[j] where bit b of (j+1) == 1) mod 4, for b=0..6
    // Supports up to 127 data bases (up to 19 payload bytes per strand).
    let parity = [0, 0, 0, 0, 0, 0, 0, 0];
    let j = 0;
    while j < len(data_bases) {
        let sym = data_bases[j];
        parity[0] = (parity[0] + sym) % 4;
        let pos1 = j + 1;
        let b = 0;
        while b < 7 {
            if _bit_get(pos1, b) == 1 {
                parity[1 + b] = (parity[1 + b] + sym) % 4;
            }
            b = b + 1;
        }
        j = j + 1;
    }

    // Append parity bases with deterministic rotating shift to avoid homopolymers
    let full_bases = [];
    let di = 0;
    while di < len(data_bases) {
        array_push(full_bases, data_bases[di]);
        di = di + 1;
    }
    let pi = 0;
    while pi < 8 {
        let shifted = (parity[pi] + ((pi + mask_id) % 4)) % 4;
        array_push(full_bases, shifted);
        pi = pi + 1;
    }
    return full_bases;
}

// Encodes arbitrary binary bytes (array of 0..255) or UTF-8 string into valid
// DNA strands ('A','C','G','T') guaranteeing:
//   - max_homopolymer_run <= 3 (never AAAA/CCCC/GGGG/TTTT)
//   - balanced GC content in [0.40, 0.60]
//   - single-base substitution error correction per strand
fn dna_encode_bytes(data_bytes, chunk_bytes = 12) {
    let raw = [];
    if type(data_bytes) == "string" {
        raw = _dna_str_to_utf8_bytes(data_bytes);
    } else if is_array(data_bytes) {
        let i = 0;
        while i < len(data_bytes) {
            let b = data_bytes[i];
            if type(b) != "number" or num_floor(b) != b or b < 0 or b > 255 {
                return map{ "ok": false, "error": "dna_encode_bytes: byte out of range 0..255 at index " + str(i) };
            }
            array_push(raw, b);
            i = i + 1;
        }
    } else {
        return map{ "ok": false, "error": "dna_encode_bytes: expected byte array or string" };
    }

    let csize = chunk_bytes;
    if csize < 1 or csize > 16 { csize = 12; }

    let strands = [];
    let strand_meta = [];
    let global_max_run = 0;
    let min_gc = 1.0;
    let max_gc = 0.0;

    let offset = 0;
    let force_empty = (len(raw) == 0);
    while offset < len(raw) or force_empty {
        force_empty = false;
        let chunk = [];
        let ci = 0;
        while ci < csize and (offset + ci) < len(raw) {
            array_push(chunk, raw[offset + ci]);
            ci = ci + 1;
        }
        offset = offset + ci;

        // Search deterministic masks 0..127 for max_run <= 3 and 0.40 <= GC <= 0.60
        let chosen_bases = nil;
        let chosen_metrics = nil;
        let chosen_mask = 0;
        let best_score = 999.0;

        let mid = 0;
        while mid < 128 {
            let cand = _dna_encode_chunk_with_mask(chunk, mid);
            let m = _dna_strand_metrics(cand);
            let gc_dev = _abs(m["gc_ratio"] - 0.50);
            if m["max_run"] <= 3 and m["gc_ratio"] >= 0.40 and m["gc_ratio"] <= 0.60 {
                chosen_bases = cand;
                chosen_metrics = m;
                chosen_mask = mid;
                mid = 128; // break
            } else {
                let penalty = gc_dev + (m["max_run"] * 0.25);
                if penalty < best_score {
                    best_score = penalty;
                    chosen_bases = cand;
                    chosen_metrics = m;
                    chosen_mask = mid;
                }
                mid = mid + 1;
            }
        }

        let seq = "";
        let bi = 0;
        while bi < len(chosen_bases) {
            seq = seq + _DNA_BASES[chosen_bases[bi]];
            bi = bi + 1;
        }
        array_push(strands, seq);
        array_push(strand_meta, map{
            "mask_id": chosen_mask,
            "data_bytes": len(chunk),
            "length_nt": len(chosen_bases),
            "max_homopolymer_run": chosen_metrics["max_run"],
            "gc_ratio": chosen_metrics["gc_ratio"]
        });

        if chosen_metrics["max_run"] > global_max_run {
            global_max_run = chosen_metrics["max_run"];
        }
        if chosen_metrics["gc_ratio"] < min_gc { min_gc = chosen_metrics["gc_ratio"]; }
        if chosen_metrics["gc_ratio"] > max_gc { max_gc = chosen_metrics["gc_ratio"]; }
    }

    return map{
        "ok": true,
        "codec": "goldman_rot3_z4_hamming_sec_v1",
        "original_byte_length": len(raw),
        "strand_count": len(strands),
        "strands": strands,
        "strand_meta": strand_meta,
        "max_homopolymer_run": global_max_run,
        "min_gc_ratio": min_gc,
        "max_gc_ratio": max_gc,
        "homopolymer_safe": global_max_run <= 3,
        "gc_balanced": min_gc >= 0.40 and max_gc <= 0.60
    };
}

// Decodes DNA strands from dna_encode_bytes(), automatically detecting and
// correcting up to 1 single-base substitution mutation per strand!
fn dna_decode_strands(encoded_pkg) {
    if type(encoded_pkg) != "map" or not map_has(encoded_pkg, "strands") {
        return map{ "ok": false, "error": "dna_decode_strands: invalid encoded package" };
    }
    let strands = encoded_pkg["strands"];
    let meta = _map_get_or(encoded_pkg, "strand_meta", nil);
    if not is_array(strands) {
        return map{ "ok": false, "error": "dna_decode_strands: strands must be an array" };
    }

    let out_bytes = [];
    let corrected_errors = 0;
    let parity_errors_ignored = 0;

    let si = 0;
    while si < len(strands) {
        let seq = strands[si];
        if type(seq) != "string" or len(seq) < 20 {
            return map{ "ok": false, "error": "dna_decode_strands: invalid strand at index " + str(si) };
        }
        let n = len(seq);
        let data_len = n - 8;
        if data_len % 6 != 0 {
            return map{ "ok": false, "error": "dna_decode_strands: strand data length not multiple of 6" };
        }

        let bases = [];
        let ci = 0;
        while ci < n {
            let idx = _dna_char_to_idx(str_slice(seq, ci, ci + 1));
            if idx < 0 {
                return map{ "ok": false, "error": "dna_decode_strands: invalid DNA base at strand " + str(si) };
            }
            array_push(bases, idx);
            ci = ci + 1;
        }

        let data_bases = [];
        let di = 0;
        while di < data_len {
            array_push(data_bases, bases[di]);
            di = di + 1;
        }

        // Determine mask_id (from metadata if present, else trial-recover mod 4)
        let known_mask = -1;
        if is_array(meta) and si < len(meta) and type(meta[si]) == "map" and map_has(meta[si], "mask_id") {
            known_mask = meta[si]["mask_id"];
        }

        // Recover parity bases & run Z_4 Hamming single-base error correction
        let shift_phase = 0;
        if known_mask >= 0 {
            shift_phase = known_mask % 4;
        } else {
            // Try phases 0..3; pick phase with 0 or 1 consistent single-base error
            let ph = 0;
            let best_ph = 0;
            let best_score = 999;
            while ph < 4 {
                let s0 = 0;
                let j = 0;
                while j < data_len { s0 = (s0 + data_bases[j]) % 4; j = j + 1; }
                let p0 = (bases[data_len] - ((0 + ph) % 4) + 4) % 4;
                let diff0 = (s0 - p0 + 4) % 4;
                let nz = 0;
                let b = 0;
                while b < 7 {
                    let sb = 0;
                    let jj = 0;
                    while jj < data_len {
                        if _bit_get(jj + 1, b) == 1 { sb = (sb + data_bases[jj]) % 4; }
                        jj = jj + 1;
                    }
                    let pb = (bases[data_len + 1 + b] - ((1 + b + ph) % 4) + 4) % 4;
                    let db = (sb - pb + 4) % 4;
                    if db != 0 {
                        if diff0 != 0 and db != diff0 { nz = nz + 10; }
                        else { nz = nz + 1; }
                    }
                    b = b + 1;
                }
                let sc = nz;
                if diff0 == 0 and nz == 0 { sc = 0; }
                else if diff0 != 0 and nz < 10 { sc = 1; }
                if sc < best_score {
                    best_score = sc;
                    best_ph = ph;
                }
                ph = ph + 1;
            }
            shift_phase = best_ph;
        }

        // Compute syndromes S_0 .. S_7
        let sum0 = 0;
        let j = 0;
        while j < data_len {
            sum0 = (sum0 + data_bases[j]) % 4;
            j = j + 1;
        }
        let p0 = (bases[data_len] - (shift_phase % 4) + 4) % 4;
        let syn0 = (sum0 - p0 + 4) % 4;

        let err_pos = 0;
        let parity_mismatch_count = 0;
        let b = 0;
        while b < 7 {
            let sumb = 0;
            let jj = 0;
            while jj < data_len {
                if _bit_get(jj + 1, b) == 1 {
                    sumb = (sumb + data_bases[jj]) % 4;
                }
                jj = jj + 1;
            }
            let pb = (bases[data_len + 1 + b] - ((1 + b + shift_phase) % 4) + 4) % 4;
            let synb = (sumb - pb + 4) % 4;
            if synb != 0 {
                parity_mismatch_count = parity_mismatch_count + 1;
                err_pos = err_pos + _pow2_int(b);
            }
            b = b + 1;
        }

        if syn0 != 0 {
            if err_pos >= 1 and err_pos <= data_len {
                let k = err_pos - 1;
                data_bases[k] = (data_bases[k] - syn0 + 4) % 4;
                corrected_errors = corrected_errors + 1;
            } else if err_pos == 0 {
                // Single-base mutation occurred in parity base P_0; data_bases intact
                parity_errors_ignored = parity_errors_ignored + 1;
            }
        } else if parity_mismatch_count > 0 {
            // Single-base mutation occurred in one of P_1..P_7; data_bases intact
            parity_errors_ignored = parity_errors_ignored + 1;
        }

        // Decode rotating base-3 trits back to frame bytes
        let frame_bytes = [];
        let prev_b = shift_phase;
        let n_frame_bytes = num_floor(data_len / 6);
        let fb = 0;
        while fb < n_frame_bytes {
            let val = 0;
            let p3 = 1;
            let ti = 0;
            while ti < 6 {
                let cur_b = data_bases[fb * 6 + ti];
                let trit = _dna_rot_trit(prev_b, cur_b);
                if trit < 0 {
                    return map{ "ok": false, "error": "dna_decode_strands: uncorrectable multi-base corruption in strand " + str(si) };
                }
                val = val + trit * p3;
                p3 = p3 * 3;
                prev_b = cur_b;
                ti = ti + 1;
            }
            array_push(frame_bytes, val);
            fb = fb + 1;
        }

        let mask_id = frame_bytes[0];
        let chunk_len = frame_bytes[1];
        if chunk_len < 0 or (2 + chunk_len) > len(frame_bytes) {
            return map{ "ok": false, "error": "dna_decode_strands: corrupted chunk length in strand " + str(si) };
        }
        let ki = 0;
        while ki < chunk_len {
            let orig_b = _xor8(frame_bytes[2 + ki], _dna_prng_byte(mask_id, ki));
            array_push(out_bytes, orig_b);
            ki = ki + 1;
        }
        si = si + 1;
    }

    return map{
        "ok": true,
        "bytes": out_bytes,
        "byte_length": len(out_bytes),
        "corrected_errors": corrected_errors,
        "parity_errors_ignored": parity_errors_ignored,
        "lossless": true
    };
}

// Helper: normalize reaction species side (supports map{"A": 1, "B": 1} or array ["A", "B"])
fn _crn_norm_stoich(side) {
    let out = map{};
    if type(side) == "map" {
        let ks = map_keys(side);
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            out[k] = side[k] * 1.0;
            i = i + 1;
        }
        return out;
    }
    if is_array(side) {
        let i = 0;
        while i < len(side) {
            let sp = side[i];
            if map_has(out, sp) {
                out[sp] = out[sp] + 1.0;
            } else {
                out[sp] = 1.0;
            }
            i = i + 1;
        }
        return out;
    }
    return out;
}

fn _crn_derivatives(state, species_list, norm_reactions) {
    let deriv = map{};
    let si = 0;
    while si < len(species_list) {
        deriv[species_list[si]] = 0.0;
        si = si + 1;
    }

    let ri = 0;
    while ri < len(norm_reactions) {
        let rxn = norm_reactions[ri];
        let reacts = rxn["reactants"];
        let prods = rxn["products"];
        let rate = rxn["rate"];

        // Mass-action velocity v = k * prod([S]^nu)
        let vel = rate;
        let rkeys = map_keys(reacts);
        let rk = 0;
        while rk < len(rkeys) {
            let sp = rkeys[rk];
            let coeff = reacts[sp];
            let conc = _map_get_or(state, sp, 0.0);
            if conc < 0.0 { conc = 0.0; }
            vel = vel * _pow_int(conc, num_floor(coeff));
            rk = rk + 1;
        }

        // Subtract reactants
        let rki = 0;
        while rki < len(rkeys) {
            let sp = rkeys[rki];
            deriv[sp] = deriv[sp] - reacts[sp] * vel;
            rki = rki + 1;
        }
        // Add products
        let pkeys = map_keys(prods);
        let pki = 0;
        while pki < len(pkeys) {
            let sp = pkeys[pki];
            deriv[sp] = deriv[sp] + prods[sp] * vel;
            pki = pki + 1;
        }
        ri = ri + 1;
    }
    return deriv;
}

// Simulates coupled Chemical Reaction Networks (CRN) via RK2 (midpoint)
// mass-action ODE integration with strict non-negativity conservation.
// Supports bimolecular (A + B -> C), catalytic/enzymatic (E + S -> E + P), etc.
fn bio_crn_simulate_mass_action(species_init, reactions, dt, steps) {
    if type(species_init) != "map" {
        return map{ "ok": false, "error": "bio_crn_simulate_mass_action: species_init must be a map" };
    }
    if not is_array(reactions) {
        return map{ "ok": false, "error": "bio_crn_simulate_mass_action: reactions must be an array" };
    }
    if dt <= 0.0 or steps < 0 {
        return map{ "ok": false, "error": "bio_crn_simulate_mass_action: dt must be > 0 and steps >= 0" };
    }

    // Collect full species set & normalize reactions
    let state = map{};
    let init_copy = map{};
    let init_keys = map_keys(species_init);
    let i = 0;
    while i < len(init_keys) {
        let k = init_keys[i];
        let val = species_init[k] * 1.0;
        if val < 0.0 { val = 0.0; }
        state[k] = val;
        init_copy[k] = val;
        i = i + 1;
    }

    let norm_rxns = [];
    let ri = 0;
    while ri < len(reactions) {
        let rxn = reactions[ri];
        let reacts = _crn_norm_stoich(_map_get_or(rxn, "reactants", map{}));
        let prods = _crn_norm_stoich(_map_get_or(rxn, "products", map{}));
        let rate = _map_get_or(rxn, "rate", 1.0) * 1.0;

        let rks = map_keys(reacts);
        let j = 0;
        while j < len(rks) {
            if not map_has(state, rks[j]) { state[rks[j]] = 0.0; init_copy[rks[j]] = 0.0; }
            j = j + 1;
        }
        let pks = map_keys(prods);
        let m = 0;
        while m < len(pks) {
            if not map_has(state, pks[m]) { state[pks[m]] = 0.0; init_copy[pks[m]] = 0.0; }
            m = m + 1;
        }
        array_push(norm_rxns, map{ "reactants": reacts, "products": prods, "rate": rate });
        ri = ri + 1;
    }

    let species_list = map_keys(state);
    let non_negative = true;

    // RK2 (midpoint) integration loop
    let step = 0;
    while step < steps {
        let k1 = _crn_derivatives(state, species_list, norm_rxns);
        let mid = map{};
        let si = 0;
        while si < len(species_list) {
            let sp = species_list[si];
            let mv = state[sp] + 0.5 * dt * k1[sp];
            if mv < 0.0 { mv = 0.0; }
            mid[sp] = mv;
            si = si + 1;
        }
        let k2 = _crn_derivatives(mid, species_list, norm_rxns);
        let sj = 0;
        while sj < len(species_list) {
            let sp = species_list[sj];
            let nv = state[sp] + dt * k2[sp];
            if nv < 0.0 {
                nv = 0.0;
            }
            state[sp] = nv;
            if state[sp] < 0.0 { non_negative = false; }
            sj = sj + 1;
        }
        step = step + 1;
    }

    let total_init = 0.0;
    let total_final = 0.0;
    let ti = 0;
    while ti < len(species_list) {
        let sp = species_list[ti];
        total_init = total_init + init_copy[sp];
        total_final = total_final + state[sp];
        ti = ti + 1;
    }

    return map{
        "ok": true,
        "initial_concentrations": init_copy,
        "final_concentrations": state,
        "dt": dt,
        "steps": steps,
        "total_time": dt * steps,
        "non_negative": non_negative,
        "total_mass_initial": total_init,
        "total_mass_final": total_final
    };
}

// ============================================================================
// 4. Analog Compute-in-Memory (ReRAM Crossbar Array for BitNet b1.58)
// ============================================================================

// Maps ternary BitNet b1.58 weights {-1, 0, +1} onto differential conductance
// pairs (G+, G-) in microsiemens (uS) inside an analog ReRAM crossbar array.
// Default: G_on = 100.0 uS (10 kOhm LRS), G_off = 1.0 uS (1 MOhm HRS).
fn reram_crossbar_program_ternary(weights_ternary, g_on_us = 100.0, g_off_us = 1.0) {
    if not is_array(weights_ternary) or len(weights_ternary) == 0 {
        return map{ "ok": false, "error": "reram_crossbar_program_ternary: weights_ternary must be non-empty 2D array" };
    }
    if g_on_us <= g_off_us or g_off_us < 0.0 {
        return map{ "ok": false, "error": "reram_crossbar_program_ternary: require g_on_us > g_off_us >= 0" };
    }
    let rows = len(weights_ternary);
    if not is_array(weights_ternary[0]) or len(weights_ternary[0]) == 0 {
        return map{ "ok": false, "error": "reram_crossbar_program_ternary: rows must be non-empty arrays" };
    }
    let cols = len(weights_ternary[0]);

    let g_pos = [];
    let g_neg = [];
    let w_copy = [];
    let zero_count = 0;

    let r = 0;
    while r < rows {
        if not is_array(weights_ternary[r]) or len(weights_ternary[r]) != cols {
            return map{ "ok": false, "error": "reram_crossbar_program_ternary: ragged weight matrix at row " + str(r) };
        }
        let gp_row = [];
        let gn_row = [];
        let wc_row = [];
        let c = 0;
        while c < cols {
            let wv = weights_ternary[r][c];
            if wv != -1 and wv != 0 and wv != 1 {
                return map{ "ok": false, "error": "reram_crossbar_program_ternary: non-ternary weight " + str(wv) + " at (" + str(r) + "," + str(c) + ")" };
            }
            if wv == 1 {
                array_push(gp_row, g_on_us);
                array_push(gn_row, g_off_us);
            } else if wv == -1 {
                array_push(gp_row, g_off_us);
                array_push(gn_row, g_on_us);
            } else {
                array_push(gp_row, g_off_us);
                array_push(gn_row, g_off_us);
                zero_count = zero_count + 1;
            }
            array_push(wc_row, wv);
            c = c + 1;
        }
        array_push(g_pos, gp_row);
        array_push(g_neg, gn_row);
        array_push(w_copy, wc_row);
        r = r + 1;
    }

    let total_cells = rows * cols;
    return map{
        "ok": true,
        "rows": rows,
        "cols": cols,
        "g_pos_us": g_pos,
        "g_neg_us": g_neg,
        "g_on_us": g_on_us,
        "g_off_us": g_off_us,
        "g_delta_us": g_on_us - g_off_us,
        "weights_ternary": w_copy,
        "sparsity": (zero_count * 1.0) / (total_cells * 1.0)
    };
}

// Computes Ohm's-law + Kirchhoff's-current-law analog dot product:
//   I_j = sum_i V_i * (G+_{ij} - G-_{ij})   [uA]
// with realistic signed adc_bits ADC quantization, and compares directly
// against digital BitNet b1.58 matmul.
fn reram_crossbar_mvm(crossbar, input_voltages, adc_bits = 8) {
    if type(crossbar) != "map" or not _map_get_or(crossbar, "ok", false) {
        return map{ "ok": false, "error": "reram_crossbar_mvm: invalid crossbar" };
    }
    let rows = crossbar["rows"];
    let cols = crossbar["cols"];
    if not is_array(input_voltages) or len(input_voltages) != rows {
        return map{ "ok": false, "error": "reram_crossbar_mvm: input_voltages length must equal crossbar rows (" + str(rows) + ")" };
    }
    if type(adc_bits) != "number" or adc_bits < 2 or adc_bits > 24 {
        return map{ "ok": false, "error": "reram_crossbar_mvm: adc_bits must be in 2..24" };
    }

    let g_pos = crossbar["g_pos_us"];
    let g_neg = crossbar["g_neg_us"];
    let g_delta = crossbar["g_delta_us"];
    let w = crossbar["weights_ternary"];

    let q_max = _pow2_int(num_floor(adc_bits) - 1) - 1;
    let sum_abs_v = 0.0;
    let all_int_v = true;
    let vi = 0;
    while vi < rows {
        let val = input_voltages[vi] * 1.0;
        sum_abs_v = sum_abs_v + _abs(val);
        if num_floor(val) != val { all_int_v = false; }
        vi = vi + 1;
    }

    // Calibrate ADC full-scale range:
    // If inputs are integers with sum(|V_i|) <= q_max, unit-step ADC gain yields
    // exact integer bitline recovery; otherwise dynamic full-scale prevents clipping.
    let fs_logical = sum_abs_v;
    if all_int_v and sum_abs_v <= (q_max * 1.0) and sum_abs_v > 0.0 {
        fs_logical = q_max * 1.0;
    }
    if fs_logical <= 0.0 { fs_logical = 1.0; }
    let i_fs_ua = fs_logical * g_delta;
    let adc_lsb = fs_logical / (q_max * 1.0);

    let currents_ua = [];
    let adc_codes = [];
    let analog_out = [];
    let exact_analog_out = [];
    let digital_ref = [];
    let max_abs_err = 0.0;
    let pre_adc_err = 0.0;
    let power_uw = 0.0;

    let j = 0;
    while j < cols {
        let cur_ua = 0.0;
        let dig = 0.0;
        let i = 0;
        while i < rows {
            let v_i = input_voltages[i] * 1.0;
            cur_ua = cur_ua + v_i * (g_pos[i][j] - g_neg[i][j]);
            dig = dig + v_i * (w[i][j] * 1.0);
            power_uw = power_uw + (v_i * v_i) * (g_pos[i][j] + g_neg[i][j]);
            i = i + 1;
        }
        let exact_val = cur_ua / g_delta;
        let raw_code = _round((cur_ua / i_fs_ua) * (q_max * 1.0));
        let code = _clamp(raw_code, 0.0 - (q_max * 1.0), q_max * 1.0);
        let quant_ua = (code / (q_max * 1.0)) * i_fs_ua;
        let quant_val = quant_ua / g_delta;

        let err = _abs(quant_val - dig);
        let perr = _abs(exact_val - dig);
        if err > max_abs_err { max_abs_err = err; }
        if perr > pre_adc_err { pre_adc_err = perr; }

        array_push(currents_ua, cur_ua);
        array_push(adc_codes, code);
        array_push(analog_out, quant_val);
        array_push(exact_analog_out, exact_val);
        array_push(digital_ref, dig);
        j = j + 1;
    }

    return map{
        "ok": true,
        "currents_ua": currents_ua,
        "adc_codes": adc_codes,
        "analog_out": analog_out,
        "exact_analog_out": exact_analog_out,
        "digital_ref": digital_ref,
        "adc_bits": adc_bits,
        "adc_lsb": adc_lsb,
        "max_abs_error": max_abs_err,
        "pre_adc_max_error": pre_adc_err,
        "matches_digital": max_abs_err <= (0.5 * adc_lsb + 0.000000001),
        "power_uw": power_uw,
        "read_energy_pj": power_uw * 0.01
    };
}

