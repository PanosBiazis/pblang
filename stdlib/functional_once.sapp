// One callback attempt per live closure under sequential execution.
// No cross-thread/process guarantee or callback sandbox. See FUNCTIONAL_ONCE.md.
fn once_attempt(f) {
    let state = map{started:false,done:false,value:nil};
    return fn(x) {
        if state.done { return state.value; }
        if state.started { throw "once: call started without a completed result"; }
        state.started = true;
        // No catch: the original first exception must reach the caller unchanged.
        state.value = f(x);
        state.done = true;
        return state.value;
    };
}

export once_attempt;
