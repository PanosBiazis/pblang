// stdlib/emulator_mips32.sapp -- bounded MIPS32 execution-model subset.

let Support = import("stdlib:emulator_support.sapp");
let FORMAT = "pblang.emulator.mips32.v1";
let DEFAULT_BUDGET = 1000000;
let MAX_CODE_WORDS = 1048576;
let MAX_WORD = 4294967295;

fn _require(value, low, high, name) {
    if not Support.integer(value, low, high) {
        throw "emulator_mips32: " + name + " must be " + str(low) + ".." + str(high);
    }
    return value;
}
fn _register(value, name) { return _require(value, 0, 31, name); }
fn _signed16(value, name) { return _require(value, -32768, 32767, name); }
fn _encoded16(value) { if value < 0 { return value + 65536; } return value; }
fn _decode16(value) { if value >= 32768 { return value - 65536; } return value; }
fn _u32(value) { let result = value % 4294967296; if result < 0 { result = result + 4294967296; } return result; }

fn add_immediate_unsigned(target, source, immediate) {
    _register(target, "ADDIU target"); _register(source, "ADDIU source"); _signed16(immediate, "ADDIU immediate");
    return 9 * 67108864 + source * 2097152 + target * 65536 + _encoded16(immediate);
}
fn add_unsigned(destination, source, target) {
    _register(destination, "ADDU destination"); _register(source, "ADDU source"); _register(target, "ADDU target");
    return source * 2097152 + target * 65536 + destination * 2048 + 33;
}
fn subtract_unsigned(destination, source, target) {
    _register(destination, "SUBU destination"); _register(source, "SUBU source"); _register(target, "SUBU target");
    return source * 2097152 + target * 65536 + destination * 2048 + 35;
}
fn multiply(destination, source, target) {
    _register(destination, "MUL destination"); _register(source, "MUL source"); _register(target, "MUL target");
    return 28 * 67108864 + source * 2097152 + target * 65536 + destination * 2048 + 2;
}
fn load_upper_immediate(target, immediate) {
    _register(target, "LUI target"); _require(immediate, 0, 65535, "LUI immediate");
    return 15 * 67108864 + target * 65536 + immediate;
}
fn branch_equal(source, target, offset) {
    _register(source, "BEQ source"); _register(target, "BEQ target"); _signed16(offset, "BEQ offset");
    return 4 * 67108864 + source * 2097152 + target * 65536 + _encoded16(offset);
}
fn branch_not_equal(source, target, offset) {
    _register(source, "BNE source"); _register(target, "BNE target"); _signed16(offset, "BNE offset");
    return 5 * 67108864 + source * 2097152 + target * 65536 + _encoded16(offset);
}
fn jump(target_word) {
    _require(target_word, 0, 67108863, "jump target"); return 2 * 67108864 + target_word;
}
fn nop() { return 0; }
fn syscall_instruction() { return 12; }
fn program(instructions) { return Support.unit_program(instructions, MAX_CODE_WORDS, MAX_WORD, "word"); }
fn _failure(reason, pc, instructions) { return Support.failure(FORMAT, reason, pc, instructions); }

fn run(code, options = nil) {
    let invalid = Support.validate_units(code, MAX_CODE_WORDS, MAX_WORD, "word");
    if invalid != nil { return _failure(invalid, 0, 0); }
    let budget_result = Support.instruction_budget(options, DEFAULT_BUDGET);
    if not budget_result.ok { return _failure(budget_result.error, 0, 0); }
    let registers = []; let i = 0; while i < 32 { array_push(registers, 0); i = i + 1; }
    let pc = 0; let count = 0; let delayed = false; let delayed_target = 0;
    while count < budget_result.value {
        if pc < 0 or pc >= len(code) { return _failure("program counter outside code", pc, count); }
        let word = code[pc]; let opcode = num_floor(word / 67108864) % 64;
        let source = num_floor(word / 2097152) % 32;
        let target = num_floor(word / 65536) % 32;
        let destination = num_floor(word / 2048) % 32;
        let function = word % 64; let immediate = _decode16(word % 65536);
        let branch = false; let branch_target = 0; count = count + 1;
        let is_control = opcode == 4 or opcode == 5 or opcode == 2;
        if delayed and is_control { return _failure("control transfer in delay slot is not modeled", pc, count); }
        if opcode == 9 { registers[target] = _u32(registers[source] + immediate); }
        elif opcode == 15 { registers[target] = _u32((word % 65536) * 65536); }
        elif opcode == 28 {
            if function != 2 { return _failure("unmodeled special2 function " + str(function), pc, count); }
            registers[destination] = _u32(registers[source] * registers[target]);
        }
        elif opcode == 4 { if registers[source] == registers[target] { branch = true; branch_target = pc + 1 + immediate; } }
        elif opcode == 5 { if registers[source] != registers[target] { branch = true; branch_target = pc + 1 + immediate; } }
        elif opcode == 2 { branch = true; branch_target = word % 67108864; }
        elif opcode == 0 {
            if word == 0 { }
            elif function == 33 { registers[destination] = _u32(registers[source] + registers[target]); }
            elif function == 35 { registers[destination] = _u32(registers[source] - registers[target]); }
            elif function == 12 {
                if registers[2] != 4001 { return _failure("unmodeled syscall " + str(registers[2]), pc, count); }
                let exit_code = registers[4] % 256;
                return map{
                    ok: true, format: FORMAT, halted: true, pc: pc,
                    instructions: count, registers: registers, value: exit_code,
                    branch_delay_slots: true,
                    boundary: "verified MIPS32 arithmetic/branch-delay/Linux-exit subset; not a full machine"
                };
            }
            else { return _failure("unmodeled special function " + str(function), pc, count); }
        }
        else { return _failure("unmodeled opcode " + str(opcode), pc, count); }
        registers[0] = 0;
        if branch {
            if pc + 1 >= len(code) { return _failure("branch has no delay-slot instruction", pc, count); }
            if branch_target < 0 or branch_target >= len(code) { return _failure("branch target outside code", pc, count); }
            pc = pc + 1; delayed = true; delayed_target = branch_target;
        }
        elif delayed { delayed = false; pc = delayed_target; }
        else { pc = pc + 1; }
    }
    return _failure("instruction budget exceeded", pc, count);
}

export FORMAT, DEFAULT_BUDGET, MAX_CODE_WORDS;
export add_immediate_unsigned, add_unsigned, subtract_unsigned, multiply;
export load_upper_immediate, branch_equal, branch_not_equal, jump, nop;
export syscall_instruction, program, run;
