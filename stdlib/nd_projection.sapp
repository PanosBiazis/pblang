// Pure, detached affine projections. Rows select/rotate/combine input axes.
// Budgets bound this operation, not the language's supported dimensionality.
let MAGNITUDE_LIMIT=parse_number("1e100");
fn _number(value) {
    if type(value)!="number" or not (value>=0-MAGNITUDE_LIMIT and value<=MAGNITUDE_LIMIT) {
        throw "nd_projection: invalid or out-of-range number";
    }
    return value;
}
fn compile(matrix, bias=nil, work_limit=1000000) {
    if type(work_limit)!="number" or not (work_limit>=1 and work_limit<=9007199254740991)
        or work_limit!=num_floor(work_limit) {throw "nd_projection: invalid work budget";}
    if type(matrix)!="array" or len(matrix)<1 or len(matrix)>work_limit
        or type(matrix[0])!="array" or len(matrix[0])<1 {throw "nd_projection: invalid matrix";}
    let inputs=len(matrix[0]);let outputs=len(matrix);
    if inputs>num_floor(work_limit/outputs) {throw "nd_projection: matrix budget exceeded";}
    if bias!=nil and (type(bias)!="array" or len(bias)!=outputs) {throw "nd_projection: invalid bias";}
    let rows=[];let offsets=[];let terms=0;let operations=0;let row_index=0;
    for row in matrix {
        if type(row)!="array" or len(row)!=inputs {throw "nd_projection: ragged matrix";}
        let values=[];let active=0;
        for value in row {_number(value);push(values,value);if value!=0 {active=active+1;}}
        terms=terms+active;
        if active*2<inputs {
            let entries=[];let axis=0;
            for value in values {if value!=0 {push(entries,[axis,value]);}axis=axis+1;}
            push(rows,map{sparse:true,values:entries});operations=operations+active;
        } else {push(rows,map{sparse:false,values:values});operations=operations+inputs;}
        push(offsets,if bias==nil {0} else {_number(bias[row_index])});
        row_index=row_index+1;
    }
    // Validation + arithmetic + output slots are charged before processing.
    let per_point=inputs+operations+outputs;
    let project=fn(points){
        if type(points)!="array" or len(points)>num_floor(work_limit/per_point) {
            throw "nd_projection: point budget exceeded";
        }
        let result=[];
        for point in points {
            if type(point)!="array" or len(point)!=inputs {throw "nd_projection: invalid point dimension";}
            // Zero-weight axes must not hide malformed/nonfinite input.
            for value in point {_number(value);}
            let projected=[];let i=0;
            for row in rows {
                let total=offsets[i];
                if row.sparse {
                    for entry in row.values {total=total+point[entry[0]]*entry[1];}
                } else {
                    let axis=0;for value in row.values {total=total+point[axis]*value;axis=axis+1;}
                }
                push(projected,_number(total));i=i+1;
            }
            push(result,projected);
        }
        return result;
    };
    return map{input_dimensions:inputs,output_dimensions:outputs,nonzero_terms:terms,evaluated_terms:operations,
        max_points:num_floor(work_limit/per_point),project:project};
}
export compile;
