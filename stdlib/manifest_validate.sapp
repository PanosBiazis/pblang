// stdlib/manifest_validate.sapp
//
// Incremental migration helper:
// pblang-side validator for core pblang.toml package fields.

let RELEASE_CHANNEL = import("stdlib:release_channel.sapp");
let SEMVER = import("stdlib:semver.sapp");
let MAX_MANIFEST_BYTES = 1048576;
let MAX_MANIFEST_LINES = 16384;
let MAX_MANIFEST_LINE_CHARS = 16384;

fn _lhs_before_equals(line) {
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 61 { // =
            let out = "";
            let j = 0;
            while j < i {
                out = out + strfromcharcode(strcharcodeat(line, j));
                j = j + 1;
            }
            return str_trim(out);
        }
        i = i + 1;
    }
    return nil;
}

fn _rhs_after_equals(line) {
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 61 { // =
            let out = "";
            let j = i + 1;
            while j < len(line) {
                out = out + strfromcharcode(strcharcodeat(line, j));
                j = j + 1;
            }
            return str_trim(out);
        }
        i = i + 1;
    }
    return nil;
}

fn _normalize_dep_key(key) {
    if key == nil { return ""; }
    let t = str_trim(key);
    if len(t) >= 2 and strcharcodeat(t, 0) == 34 and strcharcodeat(t, len(t) - 1) == 34 {
        let out = "";
        let i = 1;
        while i < len(t) - 1 {
            out = out + strfromcharcode(strcharcodeat(t, i));
            i = i + 1;
        }
        return out;
    }
    return t;
}

fn _detect_dep_kind(rhs) {
    if rhs == nil { return "unknown"; }
    let t = str_trim(rhs);
    if t == "" { return "unknown"; }

    // "1.2.3" style version
    if strcharcodeat(t, 0) == 34 {
        return "version";
    }
    // { path = "..."} / { git = "..."} / { version = "..."}
    if str_contains(t, "{") and str_contains(t, "}") {
        if str_contains(t, "path") { return "path"; }
        if str_contains(t, "git") { return "git"; }
        if str_contains(t, "version") { return "version"; }
        return "detailed";
    }
    return "unknown";
}

fn _strip_comment(line) {
    let out = ""; let quoted = false; let escaped = false; let i = 0;
    while i < len(line) {
        let c = strcharcodeat(line, i);
        if c == 35 and not quoted { return map{ok:true,text:out}; }
        if c == 34 and not escaped { quoted = not quoted; }
        out = out + strfromcharcode(c);
        if quoted and c == 92 and not escaped { escaped = true; }
        else { escaped = false; }
        i = i + 1;
    }
    if quoted { return map{ok:false,error:"manifest contains an unterminated quoted value"}; }
    return map{ok:true,text:out};
}

fn _exact_quoted(rhs) {
    let value = str_trim(rhs);
    if len(value) < 2 or strcharcodeat(value, 0) != 34
       or strcharcodeat(value, len(value) - 1) != 34 { return nil; }
    let out = ""; let i = 1;
    while i < len(value) - 1 {
        let c = strcharcodeat(value, i);
        if c == 34 or c == 92 or c < 32 or c == 127 { return nil; }
        out = out + strfromcharcode(c); i = i + 1;
    }
    return out;
}

fn _valid_package_name(value) {
    if type(value) != "string" or len(value) < 1 or len(value) > 128
       or not regex_match(value, "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
       or value == "." or value == ".." or str_contains(value, "..") {
        return false;
    }
    return true;
}

fn _has_trojan_bidi_bytes(bytes) {
    let n = len(bytes);
    let i = 0;
    while i + 2 < n {
        let b0 = bytes[i];
        let b1 = bytes[i + 1];
        let b2 = bytes[i + 2];
        // UTF-8 for U+202A..U+202E (0xE2 0x80 0xAA..0xAE) and U+2066..U+2069 (0xE2 0x81 0xA6..0xA9)
        if b0 == 226 and b1 == 128 and b2 >= 170 and b2 <= 174 { return true; }
        if b0 == 226 and b1 == 129 and b2 >= 166 and b2 <= 169 { return true; }
        i = i + 1;
    }
    return false;
}

fn _is_forbidden_hook_section(sec) {
    return sec == "scripts" or sec == "hooks" or sec == "install"
        or sec == "preinstall" or sec == "postinstall"
        or sec == "build_scripts" or sec == "lifecycle";
}

fn _is_forbidden_hook_key(k) {
    return k == "preinstall" or k == "postinstall" or k == "install"
        or k == "install_script" or k == "build_script" or k == "hook"
        or k == "run_command" or k == "shell_hook";
}

fn _scan_manifest(text) {
    let errors = []; let package = map{}; let package_keys = map{};
    let dependency_items = []; let dependency_keys = map{};
    if type(text) != "string" {
        return map{ok:false,errors:["manifest exceeds bounded UTF-8 text contract"],
            package:package,dependency_items:dependency_items};
    }
    let raw_bytes = str_to_bytes(text);
    if len(raw_bytes) > MAX_MANIFEST_BYTES or str_contains(text, strfromcharcode(0)) {
        return map{ok:false,errors:["manifest exceeds bounded UTF-8 text contract"],
            package:package,dependency_items:dependency_items};
    }
    if _has_trojan_bidi_bytes(raw_bytes) {
        return map{ok:false,errors:["supply-chain guard: Trojan Source Unicode Bidi override characters are forbidden"],
            package:package,dependency_items:dependency_items};
    }
    let normalized = str_replace_all(str_replace_all(text, "\r\n", "\n"), "\r", "\n");
    let lines = str_split(normalized, "\n");
    if len(lines) > MAX_MANIFEST_LINES {
        return map{ok:false,errors:["manifest exceeds line limit"],
            package:package,dependency_items:dependency_items};
    }
    let section = ""; let sections = map{}; let i = 0;
    while i < len(lines) {
        if len(lines[i]) > MAX_MANIFEST_LINE_CHARS {
            array_push(errors, "manifest line exceeds limit"); return map{ok:false,errors:errors,
                package:package,dependency_items:dependency_items};
        }
        let stripped = _strip_comment(lines[i]);
        if not stripped.ok { array_push(errors, stripped.error); }
        else {
            let line = str_trim(stripped.text);
            if line == "" { }
            else if str_starts_with(line, "[") {
                if not str_ends_with(line, "]") or not regex_match(line, "^\\[[A-Za-z0-9_.-]+\\]$") {
                    array_push(errors, "manifest contains an invalid section header");
                } else {
                    section = str_lower(str_slice(line, 1, len(line) - 1));
                    if _is_forbidden_hook_section(section) {
                        array_push(errors, "supply-chain guard: install/build hook section [" + section + "] is forbidden");
                    } else if map_has(sections, section) {
                        array_push(errors, "manifest contains a duplicate section: " + section);
                    } else { sections[section] = true; }
                }
            } else if section == "package" or section == "dependencies" {
                let lhs_raw = _lhs_before_equals(line); let rhs = _rhs_after_equals(line);
                if lhs_raw == nil or rhs == nil { array_push(errors, "manifest assignment is malformed"); }
                else if section == "package" {
                    let lhs = str_lower(str_trim(lhs_raw));
                    if not regex_match(lhs, "^[a-z][a-z0-9_]*$") {
                        array_push(errors, "[package] contains an invalid key");
                    } else if _is_forbidden_hook_key(lhs) {
                        array_push(errors, "supply-chain guard: install/build hook key '" + lhs + "' is forbidden");
                    } else if map_has(package_keys, lhs) {
                        array_push(errors, "[package] contains duplicate key: " + lhs);
                    } else {
                        package_keys[lhs] = true;
                        if lhs == "name" or lhs == "version" or lhs == "entry" or lhs == "release_channel" {
                            let parsed = _exact_quoted(rhs);
                            if parsed == nil { array_push(errors, "[package]." + lhs + " must be an exact quoted string"); }
                            else { package[lhs] = parsed; }
                        } else if lhs == "show_release_channel" or lhs == "release_channel_in_artifact" {
                            let bool_text = str_trim(rhs);
                            if bool_text == "true" { package[lhs] = true; }
                            else if bool_text == "false" { package[lhs] = false; }
                            else { array_push(errors, "[package]." + lhs + " must be true or false"); }
                        }
                    }
                } else {
                    let name = _normalize_dep_key(lhs_raw);
                    if name == "" { array_push(errors, "dependencies entry has empty key"); }
                    else if _is_forbidden_hook_key(str_lower(name)) {
                        array_push(errors, "supply-chain guard: install/build hook dependency key '" + name + "' is forbidden");
                    } else if str_contains(rhs, "http://") {
                        array_push(errors, "supply-chain guard: unencrypted http:// dependency source is forbidden for '" + name + "'");
                    } else if map_has(dependency_keys, name) {
                        array_push(errors, "dependencies contains duplicate key: " + name);
                    } else {
                        dependency_keys[name] = true; let kind = _detect_dep_kind(rhs);
                        if kind == "unknown" { array_push(errors, "dependency '" + name + "' has unsupported spec"); }
                        else { array_push(dependency_items, map{name:name,kind:kind}); }
                    }
                }
            }
        }
        i = i + 1;
    }
    return map{ok:len(errors) == 0,errors:errors,package:package,
        dependency_items:dependency_items};
}

fn validate_manifest_text(text) {
    let errors = [];
    if text == nil or str_trim(text) == "" {
        array_push(errors, "manifest is empty");
        return map{ ok: false, errors: errors };
    }

    let scanned = _scan_manifest(text);
    for issue in scanned.errors { array_push(errors, issue); }
    let fields = scanned.package;
    let package_name = try fields.name catch nil;
    let package_version = try fields.version catch nil;
    let package_entry = try fields.entry catch nil;
    let release_channel = try fields.release_channel catch nil;
    if release_channel == nil { release_channel = ""; }
    let show_release_channel = map{ok:true,value:try fields.show_release_channel catch false};
    let channel_in_artifact = map{ok:true,value:try fields.release_channel_in_artifact catch false};
    let dependency_items = scanned.dependency_items;

    if package_name == nil or package_name == "" {
        array_push(errors, "[package].name is required");
    } else if not _valid_package_name(package_name) {
        array_push(errors, "[package].name must be a safe 1..128 character package identifier");
    }
    if package_version == nil or package_version == "" {
        array_push(errors, "[package].version is required");
    } else {
        let parsed_version = SEMVER.parse_strict(package_version);
        if parsed_version == nil or SEMVER.format(parsed_version) != package_version {
            array_push(errors, "[package].version must be canonical SemVer 2.0.0");
        }
    }
    if package_entry != nil and not str_contains(package_entry, ".sapp") {
        array_push(errors, "[package].entry should point to a .sapp file");
    }
    if not show_release_channel.ok {
        array_push(errors, "[package].show_release_channel must be true or false");
    }
    if not channel_in_artifact.ok {
        array_push(errors, "[package].release_channel_in_artifact must be true or false");
    }
    let release = RELEASE_CHANNEL.resolve(package_version ?? "0.0.0", map{
        release_channel:release_channel,
        show_release_channel:show_release_channel.value,
        release_channel_in_artifact:channel_in_artifact.value
    });
    if not release.ok { array_push(errors, "[package]." + release.error); }

    return map{
        ok: len(errors) == 0,
        errors: errors,
        package: map{
            name: package_name,
            version: package_version,
            entry: package_entry,
            release_channel: release_channel,
            display_version: if release.ok { release.application_version } else { package_version },
            artifact_suffix: if release.ok { release.artifact_suffix } else { "" },
            exact_version_identity: package_version,
            version_is_independent: true,
            channel_changes_package_identity: false,
            contradictory_stability: if release.ok { release.contradictory_stability } else { false },
        },
        dependency_items: dependency_items,
        dependency_count: len(dependency_items),
    };
}

fn validate_manifest_file(path) {
    if path == nil or path == "" {
        return map{ ok: false, errors: ["path is empty"] };
    }
    let text = fs_read(path);
    if text == nil or text == "" {
        return map{ ok: false, errors: ["cannot read manifest file"] };
    }
    return validate_manifest_text(text);
}

// ── PB-01-005: Declared Required/Optional Dependencies, Versions, Capabilities, Licenses & Cycle Guard ──

let SUPPORTED_LICENSES = [
    "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause",
    "MPL-2.0", "LGPL-3.0-only", "GPL-3.0-only", "Proprietary", "Unlicense"
];

fn is_supported_license(spdx) {
    if type(spdx) != "string" or spdx == "" { return false; }
    let i = 0;
    while i < len(SUPPORTED_LICENSES) {
        if SUPPORTED_LICENSES[i] == spdx { return true; }
        i = i + 1;
    }
    return false;
}

fn check_license_compatibility(consumer_license, provider_license) {
    if not is_supported_license(consumer_license) or not is_supported_license(provider_license) {
        return map{ ok: false, compatible: false, reason: "unsupported_or_missing_spdx_license" };
    }
    let provider_permissive = provider_license == "MIT" or provider_license == "Apache-2.0"
        or provider_license == "BSD-2-Clause" or provider_license == "BSD-3-Clause"
        or provider_license == "Unlicense";
    if provider_permissive {
        return map{ ok: true, compatible: true, reason: "permissive_provider_compatible" };
    }
    if provider_license == "MPL-2.0" or provider_license == "LGPL-3.0-only" {
        return map{ ok: true, compatible: true, reason: "weak_copyleft_module_boundary_compatible" };
    }
    if provider_license == "GPL-3.0-only" {
        if consumer_license == "GPL-3.0-only" {
            return map{ ok: true, compatible: true, reason: "strong_copyleft_matched" };
        }
        return map{ ok: false, compatible: false, reason: "gpl3_incompatible_with_" + consumer_license };
    }
    if provider_license == "Proprietary" {
        if consumer_license == "Proprietary" {
            return map{ ok: true, compatible: true, reason: "proprietary_matched" };
        }
        return map{ ok: false, compatible: false, reason: "proprietary_provider_incompatible_with_open_license" };
    }
    return map{ ok: false, compatible: false, reason: "license_combination_rejected" };
}

fn _version_satisfies(offered_ver, constraint) {
    if type(offered_ver) != "string" or type(constraint) != "string" { return false; }
    let offered = SEMVER.parse_strict(offered_ver);
    if offered == nil { return false; }
    let c = str_trim(constraint);
    if str_starts_with(c, "^") {
        let req = SEMVER.parse_strict(str_slice(c, 1, len(c)));
        if req == nil { return false; }
        if offered.major != req.major { return false; }
        if offered.major == 0 and offered.minor != req.minor { return false; }
        return SEMVER.compare(offered, req) >= 0;
    }
    if str_starts_with(c, ">=") {
        let req = SEMVER.parse_strict(str_slice(c, 2, len(c)));
        if req == nil { return false; }
        return SEMVER.compare(offered, req) >= 0;
    }
    let exact = SEMVER.parse_strict(c);
    if exact == nil { return false; }
    return SEMVER.compare(offered, exact) == 0;
}

fn _visit_pkg(pkg_name, reg, cap_set, state_color, order, bindings, degraded_optional, failure) {
    if failure.failed { return nil; }
    let color = try state_color[pkg_name] catch 0;
    if color == 1 {
        failure.failed = true;
        failure.code = "dependency_cycle_detected";
        failure.package = pkg_name;
        return nil;
    }
    if color == 2 { return nil; }
    state_color[pkg_name] = 1;

    let pkg = reg[pkg_name];
    let req_caps = try pkg.required_capabilities catch [];
    if type(req_caps) == "array" {
        let ci = 0;
        while ci < len(req_caps) {
            let rc = req_caps[ci];
            if not map_has(cap_set, rc) {
                failure.failed = true;
                failure.code = "missing_required_capability";
                failure.package = pkg_name;
                failure.detail = rc;
                return nil;
            }
            ci = ci + 1;
        }
    }

    let deps = try pkg.dependencies catch [];
    if type(deps) == "array" {
        let di = 0;
        while di < len(deps) {
            if failure.failed { return nil; }
            let dep = deps[di];
            let dep_name = try dep.name catch "";
            let dep_ver = try dep.version catch "";
            let fallback_name = try dep.fallback catch nil;

            let target_name = dep_name;
            let resolution_mode = "required";
            if try dep.optional catch false {
                resolution_mode = "optional_present";
            }
            if not map_has(reg, target_name) {
                if resolution_mode == "required" {
                    failure.failed = true;
                    failure.code = "missing_required_dependency";
                    failure.package = pkg_name;
                    failure.dependency = dep_name;
                    return nil;
                }
                if fallback_name != nil and fallback_name != "" {
                    if not map_has(reg, fallback_name) {
                        failure.failed = true;
                        failure.code = "missing_optional_fallback";
                        failure.package = pkg_name;
                        failure.dependency = fallback_name;
                        return nil;
                    }
                    target_name = fallback_name;
                    resolution_mode = "optional_fallback";
                } else {
                    array_push(degraded_optional, map{
                        consumer: pkg_name,
                        dependency: dep_name,
                        status: "optional_absent_safe_degraded"
                    });
                    target_name = "";
                }
            }

            if target_name != "" {
                let target_pkg = reg[target_name];
                if not _version_satisfies(target_pkg.version, dep_ver) {
                    failure.failed = true;
                    failure.code = "incompatible_dependency_version";
                    failure.package = pkg_name;
                    failure.dependency = target_name;
                    failure.detail = "expected " + dep_ver + ", got " + target_pkg.version;
                    return nil;
                }
                let lic_check = check_license_compatibility(pkg.license, target_pkg.license);
                if not lic_check.compatible {
                    failure.failed = true;
                    failure.code = "incompatible_dependency_license";
                    failure.package = pkg_name;
                    failure.dependency = target_name;
                    failure.detail = lic_check.reason;
                    return nil;
                }
                _visit_pkg(target_name, reg, cap_set, state_color, order, bindings, degraded_optional, failure);
                if failure.failed { return nil; }
                array_push(bindings, map{
                    consumer: pkg_name,
                    provider: target_name,
                    version: target_pkg.version,
                    license: target_pkg.license,
                    mode: resolution_mode
                });
            }
            di = di + 1;
        }
    }

    state_color[pkg_name] = 2;
    array_push(order, pkg_name);
    return nil;
}

fn resolve_dependency_graph_safe(pkg_list, root_name, available_capabilities = nil) {
    if type(pkg_list) != "array" or len(pkg_list) < 1 or len(pkg_list) > 128 {
        return map{ ok: false, code: "invalid_package_catalog", order: [], resolved: [] };
    }
    if not _valid_package_name(root_name) {
        return map{ ok: false, code: "invalid_root_name", order: [], resolved: [] };
    }
    let cap_set = map{};
    if type(available_capabilities) == "array" {
        let ci = 0;
        while ci < len(available_capabilities) {
            let cap = available_capabilities[ci];
            if type(cap) == "string" and cap != "" { cap_set[cap] = true; }
            ci = ci + 1;
        }
    }
    let reg = map{};
    let pi = 0;
    while pi < len(pkg_list) {
        let pkg = pkg_list[pi];
        if type(pkg) != "map" or not _valid_package_name(try pkg.name catch "") {
            return map{ ok: false, code: "invalid_package_entry", order: [], resolved: [] };
        }
        if map_has(reg, pkg.name) {
            return map{ ok: false, code: "duplicate_package_entry", package: pkg.name, order: [], resolved: [] };
        }
        let ver = try pkg.version catch "";
        if SEMVER.parse_strict(ver) == nil {
            return map{ ok: false, code: "invalid_package_semver", package: pkg.name, order: [], resolved: [] };
        }
        if not is_supported_license(try pkg.license catch "") {
            return map{ ok: false, code: "invalid_or_missing_license", package: pkg.name, order: [], resolved: [] };
        }
        reg[pkg.name] = pkg;
        pi = pi + 1;
    }
    if not map_has(reg, root_name) {
        return map{ ok: false, code: "missing_root_package", package: root_name, order: [], resolved: [] };
    }

    let state_color = map{};
    let order = [];
    let bindings = [];
    let degraded_optional = [];
    let failure = map{ failed: false, code: "", package: "", dependency: "", detail: "" };

    _visit_pkg(root_name, reg, cap_set, state_color, order, bindings, degraded_optional, failure);
    if failure.failed {
        return map{
            ok: false,
            code: failure.code,
            package: failure.package,
            dependency: failure.dependency,
            detail: failure.detail,
            order: [],
            bindings: [],
            degraded_optional: []
        };
    }

    return map{
        ok: true,
        code: "ok",
        root: root_name,
        order: order,
        bindings: bindings,
        degraded_optional: degraded_optional
    };
}

export MAX_MANIFEST_BYTES, MAX_MANIFEST_LINES, MAX_MANIFEST_LINE_CHARS;
export SUPPORTED_LICENSES, is_supported_license, check_license_compatibility;
export validate_manifest_text, validate_manifest_file, resolve_dependency_graph_safe;

