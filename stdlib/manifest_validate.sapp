// stdlib/manifest_validate.sapp
//
// Incremental migration helper:
// pblang-side validator for core pblang.toml package fields.

fn _parse_quoted_value(line) {
    let first_q = -1;
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 34 { // "
            first_q = i;
            break;
        }
        i = i + 1;
    }
    if first_q < 0 { return nil; }

    let second_q = -1;
    let j = first_q + 1;
    while j < len(line) {
        if strcharcodeat(line, j) == 34 { // "
            second_q = j;
            break;
        }
        j = j + 1;
    }
    if second_q <= first_q { return nil; }

    let out = "";
    let k = first_q + 1;
    while k < second_q {
        out = out + strfromcharcode(strcharcodeat(line, k));
        k = k + 1;
    }
    return out;
}

fn _is_digits(s) {
    if s == nil or s == "" { return false; }
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

fn _is_semver_basic(v) {
    let parts = str_split(v, ".");
    if len(parts) != 3 { return false; }
    return _is_digits(str_trim(parts[0]))
        and _is_digits(str_trim(parts[1]))
        and _is_digits(str_trim(parts[2]));
}

fn _extract_quoted_after(text, prefix) {
    if text == nil or prefix == nil { return nil; }
    let i = 0;
    while i < len(text) {
        // prefix match at i
        let ok = true;
        let j = 0;
        while j < len(prefix) {
            if i + j >= len(text) {
                return nil;
            }
            if strcharcodeat(text, i + j) != strcharcodeat(prefix, j) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            let start = i + len(prefix);
            let out = "";
            let k = start;
            while k < len(text) {
                if strcharcodeat(text, k) == 34 { // closing "
                    return out;
                }
                out = out + strfromcharcode(strcharcodeat(text, k));
                k = k + 1;
            }
            return nil;
        }
        i = i + 1;
    }
    return nil;
}

fn _lhs_before_equals(line) {
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 61 { // =
            let out = "";
            let j = 0;
            while j < i {
                out = out + strfromcharcode(strcharcodeat(line, j));
                j = j + 1;
            }
            return str_trim(out);
        }
        i = i + 1;
    }
    return nil;
}

fn _rhs_after_equals(line) {
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 61 { // =
            let out = "";
            let j = i + 1;
            while j < len(line) {
                out = out + strfromcharcode(strcharcodeat(line, j));
                j = j + 1;
            }
            return str_trim(out);
        }
        i = i + 1;
    }
    return nil;
}

fn _normalize_dep_key(key) {
    if key == nil { return ""; }
    let t = str_trim(key);
    if len(t) >= 2 and strcharcodeat(t, 0) == 34 and strcharcodeat(t, len(t) - 1) == 34 {
        let out = "";
        let i = 1;
        while i < len(t) - 1 {
            out = out + strfromcharcode(strcharcodeat(t, i));
            i = i + 1;
        }
        return out;
    }
    return t;
}

fn _detect_dep_kind(rhs) {
    if rhs == nil { return "unknown"; }
    let t = str_trim(rhs);
    if t == "" { return "unknown"; }

    // "1.2.3" style version
    if strcharcodeat(t, 0) == 34 {
        return "version";
    }
    // { path = "..."} / { git = "..."} / { version = "..."}
    if str_contains(t, "{") and str_contains(t, "}") {
        if str_contains(t, "path") { return "path"; }
        if str_contains(t, "git") { return "git"; }
        if str_contains(t, "version") { return "version"; }
        return "detailed";
    }
    return "unknown";
}

fn _find_substr(text, needle, start_at) {
    if text == nil or needle == nil { return -1; }
    if start_at == nil { start_at = 0; }
    if len(needle) == 0 { return start_at; }
    let i = start_at;
    while i + len(needle) <= len(text) {
        let ok = true;
        let j = 0;
        while j < len(needle) {
            if strcharcodeat(text, i + j) != strcharcodeat(needle, j) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok { return i; }
        i = i + 1;
    }
    return -1;
}

fn validate_manifest_text(text) {
    let errors = [];
    if text == nil or str_trim(text) == "" {
        array_push(errors, "manifest is empty");
        return map{ ok: false, errors: errors };
    }

    let package_name = _extract_quoted_after(text, "name = \"");
    let package_version = _extract_quoted_after(text, "version = \"");
    let package_entry = _extract_quoted_after(text, "entry = \"");

    let dependency_items = [];
    let deps_marker = "[dependencies]";
    if str_contains(text, deps_marker) {
        let deps_idx = _find_substr(text, deps_marker, 0);
        if deps_idx >= 0 {
            let cursor = deps_idx + len(deps_marker);
            while cursor < len(text) {
                while cursor < len(text) {
                    let ch = strcharcodeat(text, cursor);
                    if ch == 10 or ch == 13 {
                        cursor = cursor + 1;
                    } else {
                        break;
                    }
                }
                if cursor >= len(text) { break; }
                let line = "";
                while cursor < len(text) {
                    let ch2 = strcharcodeat(text, cursor);
                    if ch2 == 10 {
                        break;
                    }
                    if ch2 != 13 {
                        line = line + strfromcharcode(ch2);
                    }
                    cursor = cursor + 1;
                }
                let tline = str_trim(line);
                if tline == "" or str_starts_with(tline, "#") {
                    continue;
                }
                if str_starts_with(tline, "[") {
                    break;
                }
                let lhs = _normalize_dep_key(_lhs_before_equals(tline));
                let rhs = _rhs_after_equals(tline);
                if lhs == "" {
                    array_push(errors, "dependencies entry has empty key");
                    continue;
                }
                let kind = _detect_dep_kind(rhs);
                if kind == "unknown" {
                    array_push(errors, "dependency '" + lhs + "' has unsupported spec");
                } else {
                    array_push(dependency_items, map{ name: lhs, kind: kind });
                }
            }
        }
    }

    if package_name == nil or package_name == "" {
        array_push(errors, "[package].name is required");
    }
    if package_version == nil or package_version == "" {
        array_push(errors, "[package].version is required");
    } else if not _is_semver_basic(package_version) {
        array_push(errors, "[package].version must be basic semver: X.Y.Z");
    }
    if package_entry != nil and not str_contains(package_entry, ".sapp") {
        array_push(errors, "[package].entry should point to a .sapp file");
    }

    return map{
        ok: len(errors) == 0,
        errors: errors,
        package: map{
            name: package_name,
            version: package_version,
            entry: package_entry,
        },
        dependency_items: dependency_items,
        dependency_count: len(dependency_items),
    };
}

fn validate_manifest_file(path) {
    if path == nil or path == "" {
        return map{ ok: false, errors: ["path is empty"] };
    }
    let text = fs_read(path);
    if text == nil or text == "" {
        return map{ ok: false, errors: ["cannot read manifest file"] };
    }
    return validate_manifest_text(text);
}

export validate_manifest_text, validate_manifest_file;
