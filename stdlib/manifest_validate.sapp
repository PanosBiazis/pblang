// stdlib/manifest_validate.sapp
//
// Incremental migration helper:
// pblang-side validator for core pblang.toml package fields.

fn _parse_quoted_value(line) {
    let first_q = -1;
    let i = 0;
    while i < len(line) {
        if strcharcodeat(line, i) == 34 { // "
            first_q = i;
            break;
        }
        i = i + 1;
    }
    if first_q < 0 { return nil; }

    let second_q = -1;
    let j = first_q + 1;
    while j < len(line) {
        if strcharcodeat(line, j) == 34 { // "
            second_q = j;
            break;
        }
        j = j + 1;
    }
    if second_q <= first_q { return nil; }

    let out = "";
    let k = first_q + 1;
    while k < second_q {
        out = out + strfromcharcode(strcharcodeat(line, k));
        k = k + 1;
    }
    return out;
}

fn _is_digits(s) {
    if s == nil or s == "" { return false; }
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

fn _is_semver_basic(v) {
    let parts = str_split(v, ".");
    if len(parts) != 3 { return false; }
    return _is_digits(str_trim(parts[0]))
        and _is_digits(str_trim(parts[1]))
        and _is_digits(str_trim(parts[2]));
}

fn _extract_quoted_after(text, prefix) {
    if text == nil or prefix == nil { return nil; }
    let i = 0;
    while i < len(text) {
        // prefix match at i
        let ok = true;
        let j = 0;
        while j < len(prefix) {
            if i + j >= len(text) {
                return nil;
            }
            if strcharcodeat(text, i + j) != strcharcodeat(prefix, j) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            let start = i + len(prefix);
            let out = "";
            let k = start;
            while k < len(text) {
                if strcharcodeat(text, k) == 34 { // closing "
                    return out;
                }
                out = out + strfromcharcode(strcharcodeat(text, k));
                k = k + 1;
            }
            return nil;
        }
        i = i + 1;
    }
    return nil;
}

fn validate_manifest_text(text) {
    let errors = [];
    if text == nil or str_trim(text) == "" {
        array_push(errors, "manifest is empty");
        return map{ ok: false, errors: errors };
    }

    let package_name = _extract_quoted_after(text, "name = \"");
    let package_version = _extract_quoted_after(text, "version = \"");
    let package_entry = _extract_quoted_after(text, "entry = \"");

    if package_name == nil or package_name == "" {
        array_push(errors, "[package].name is required");
    }
    if package_version == nil or package_version == "" {
        array_push(errors, "[package].version is required");
    } else if not _is_semver_basic(package_version) {
        array_push(errors, "[package].version must be basic semver: X.Y.Z");
    }
    if package_entry != nil and not str_contains(package_entry, ".sapp") {
        array_push(errors, "[package].entry should point to a .sapp file");
    }

    return map{
        ok: len(errors) == 0,
        errors: errors,
        package: map{
            name: package_name,
            version: package_version,
            entry: package_entry,
        },
    };
}

fn validate_manifest_file(path) {
    if path == nil or path == "" {
        return map{ ok: false, errors: ["path is empty"] };
    }
    let text = fs_read(path);
    if text == nil or text == "" {
        return map{ ok: false, errors: ["cannot read manifest file"] };
    }
    return validate_manifest_text(text);
}

export validate_manifest_text, validate_manifest_file;
