// Single traversal per column, stable literal categories, no formula evaluation.
let Sheet=import("stdlib:sheet_document.sapp");
fn _number(text) {
    let value=str_trim(text); if len(value)==0 or len(value)>32 { return nil; }
    let i=0; let digits=0; let dot=false;
    if str_slice(value,0,1)=="+" or str_slice(value,0,1)=="-" { i=1; }
    while i<len(value) {
        let ch=str_slice(value,i,i+1);
        if ch=="." and not dot { dot=true; }
        elif str_index_of("0123456789",ch)>=0 { digits=digits+1; }
        else { return nil; } i=i+1;
    }
    if digits==0 { return nil; }
    let n=parse_number(value);
    if not (n>= -1000000000000 and n<=1000000000000) { throw "numeric value outside profile range"; }
    return n;
}
fn describe(doc,header=false) {
    let size=Sheet.validate(doc); if type(header)!="bool" { throw "header must be boolean"; }
    let start=if header {1} else {0}; let columns=[]; let row_keys=map{}; let duplicates=0;
    for r in range(start,size.rows) {
        let key=json_stringify(doc.cells[r]);
        if map_has(row_keys,key) { duplicates=duplicates+1; } else { row_keys[key]=true; }
    }
    for c in range(0,size.columns) {
        let empty=0; let numeric=0; let text=0; let total=0; let mean=0; let m2=0;
        let minimum=nil; let maximum=nil; let unique=map{};
        for r in range(start,size.rows) {
            let value=doc.cells[r][c];
            if value=="" { empty=empty+1; continue; }
            unique[value]=true; let number=_number(value);
            if number==nil { text=text+1; continue; }
            numeric=numeric+1; total=total+number;
            let delta=number-mean; mean=mean+delta/numeric; m2=m2+delta*(number-mean);
            if minimum==nil or number<minimum { minimum=number; }
            if maximum==nil or number>maximum { maximum=number; }
        }
        array_push(columns,map{index:c,empty:empty,numeric:numeric,text:text,distinct_nonempty:len(unique),
            sum:total,mean:if numeric>0 {mean} else {nil},min:minimum,max:maximum,
            population_variance:if numeric>0 {num_max(0,m2/numeric)} else {nil}});
    }
    return map{format:"pblang.table-profile.v1",rows:size.rows-start,columns:columns,
        header:header,duplicate_rows:duplicates,contains_cell_text:false,contains_headers:false,
        safe_to_log:false};
}
// Stable, case-sensitive literal filtering. The header is never inferred.
fn select_rows(doc,column,query,header=false) {
    let size=Sheet.validate(doc);
    if type(column)!="number" or not (column>=0 and column<size.columns) or column!=num_floor(column)
        or type(header)!="bool" or type(query)!="string" or len(query)>256
        or len(str_to_bytes(query))>256 or str_contains(query,"\u0000") { throw "invalid table filter"; }
    let indices=[]; for r in range(if header {1} else {0},size.rows) {
        if str_contains(doc.cells[r][column],query) { array_push(indices,r); }
    }
    return indices;
}
export describe,select_rows;
