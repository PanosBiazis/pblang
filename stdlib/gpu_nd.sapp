// stdlib/gpu_nd.sapp — n-dimensional geometry projected to the screen ("every dimension").
//
// Completes the GPU stack across dimensions: gpu2d (2D), gpu3d (3D), and this for R^n.
// Points live in n dimensions, rotate in any (i,j) plane, and project n -> n-1 -> ... -> 2
// by successive perspective division — the standard construction for drawing a tesseract
// (4-cube) or any higher hypercube. The resulting 2D points + edges feed gpu2d_tess.line()
// for rendering (CPU today, or the emitted GPU host). Pure + deterministic.
//
//   let ND = import("stdlib/gpu_nd.sapp");
//   let scene = ND.project_cube_2d(4, [4.0, 4.0]);   // a tesseract as 2D points + edges
//   for e in scene.edges: TS.line(mesh, pts[e.a], pts[e.b], ...)

let MA = import("stdlib:math.sapp");

fn deg(d) { return d * MA.PI / 180.0; }

fn _copy(coords) {
    let out = [];
    let i = 0;
    while i < len(coords) { array_push(out, coords[i] * 1.0); i = i + 1; }
    return out;
}

// rotate(coords, i, j, angle) — rotate the point in the (i,j) coordinate plane.
fn rotate(coords, i, j, angle) {
    let out = _copy(coords);
    let c = MA.cos(angle);
    let s = MA.sin(angle);
    let ci = coords[i];
    let cj = coords[j];
    out[i] = ci * c - cj * s;
    out[j] = ci * s + cj * c;
    return out;
}

// project(coords, distance) — perspective-project from R^n to R^(n-1): the last coordinate
// is depth; scale the rest by distance/(distance - depth).
fn project(coords, distance) {
    let n = len(coords);
    let depth = coords[n - 1];
    let denom = distance - depth;
    let f = 1.0;
    if denom != 0 { f = distance / denom; }
    let out = [];
    let k = 0;
    while k < n - 1 { array_push(out, coords[k] * f); k = k + 1; }
    return out;
}

// project_to_2d(coords, distances) — chain projections down to {x,y}. distances[step] is the
// viewer distance used at each drop (defaults to 4 if the list runs out).
fn project_to_2d(coords, distances) {
    let c = _copy(coords);
    let step = 0;
    while len(c) > 2 {
        let d = 4.0;
        if step < len(distances) { d = distances[step]; }
        c = project(c, d);
        step = step + 1;
    }
    return map{ x: c[0], y: c[1] };
}

// hypercube(n) — the 2^n vertices of an n-cube (coords in {-1,+1}) and its n*2^(n-1) edges.
fn hypercube(n) {
    let count = 1;
    let i = 0;
    while i < n { count = count * 2; i = i + 1; }
    let vertices = [];
    let v = 0;
    while v < count {
        let coords = [];
        let d = 0;
        while d < n {
            if ((v >> d) & 1) == 1 { array_push(coords, 1.0); } else { array_push(coords, 0.0 - 1.0); }
            d = d + 1;
        }
        array_push(vertices, coords);
        v = v + 1;
    }
    let edges = [];
    let a = 0;
    while a < count {
        let d = 0;
        while d < n {
            let b = a ^ (1 << d);   // neighbour differs in exactly one coordinate
            if b > a { array_push(edges, map{ a: a, b: b }); }
            d = d + 1;
        }
        a = a + 1;
    }
    return map{ n: n, vertices: vertices, edges: edges };
}

// rotate_cube(cube, i, j, angle) — rotate every vertex in the (i,j) plane (spin a tesseract).
fn rotate_cube(cube, i, j, angle) {
    let vs = [];
    let k = 0;
    while k < len(cube.vertices) { array_push(vs, rotate(cube.vertices[k], i, j, angle)); k = k + 1; }
    return map{ n: cube.n, vertices: vs, edges: cube.edges };
}

// project_cube_2d(n, distances) — an n-cube projected to 2D: { points:[{x,y}...], edges }.
fn project_cube_2d(n, distances) {
    let cube = hypercube(n);
    let points = [];
    let k = 0;
    while k < len(cube.vertices) { array_push(points, project_to_2d(cube.vertices[k], distances)); k = k + 1; }
    return map{ points: points, edges: cube.edges };
}

export deg, rotate, project, project_to_2d, hypercube, rotate_cube, project_cube_2d;
