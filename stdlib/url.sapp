// stdlib/url.sapp — URL and query-string parsing / building.
//
// Uses the native `url_encode` / `url_decode` builtins for percent-encoding.
//
// Usage:
//   let url = import("stdlib:url.sapp");
//   let u = url.parse("https://user:pw@example.com:8080/a/b?x=1&y=two#top");
//   print u.host;                       // "example.com"
//   print u.username;                   // "user"
//   print u.params.x;                   // "1"
//   print url.build_query(map{ q: "a b", page: "2" });  // "q=a+b&page=2"
//   print url.join("http://h/a/b/c", "../d");            // "http://h/a/d"

// ── small string helpers ──────────────────────────────────────────────────────
// Last index of single-char `ch` in `s`, or -1.
fn _rindex(s, ch) {
    let i = len(s) - 1;
    while i >= 0 {
        if str_slice(s, i, i + 1) == ch { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// Parse a port string to a number, or nil if empty/non-numeric (never throws —
// a malformed authority must not crash url.parse).
fn _safe_port(s) {
    if s == "" { return nil; }
    return try parse_number(s) catch nil;
}

// ── query strings ──────────────────────────────────────────────────────────────

fn _hexv(code) {
    if code >= 48 and code <= 57 { return code - 48; }      // 0-9
    if code >= 65 and code <= 70 { return code - 55; }      // A-F
    if code >= 97 and code <= 102 { return code - 87; }     // a-f
    return -1;
}

// Lenient percent-decoding for query components. The url_decode builtin is
// strict (throws on malformed escapes), which is right for a codec — but a
// URL PARSER must never throw on untrusted input. WHATWG behavior: an invalid
// percent-escape is passed through as literal text. If the decoded bytes are
// not valid UTF-8 (e.g. a lone "%FF"), fall back to the raw undecoded string.
fn _decode_lenient(s) {
    let r = try url_decode(s) catch nil;
    if r != nil { return r; }
    let bytes = [];
    let i = 0;
    let n = len(s);
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "+" {
            push(bytes, 32);
            i = i + 1;
        } else if ch == "%" and i + 2 < n
                  and _hexv(strcharcodeat(s, i + 1)) >= 0
                  and _hexv(strcharcodeat(s, i + 2)) >= 0 {
            push(bytes, _hexv(strcharcodeat(s, i + 1)) * 16 + _hexv(strcharcodeat(s, i + 2)));
            i = i + 3;
        } else {
            let cb = str_to_bytes(ch);
            let k = 0;
            while k < len(cb) { push(bytes, cb[k]); k = k + 1; }
            i = i + 1;
        }
    }
    return try bytes_to_str(bytes) catch s;
}

// parse_query(qs) → map of decoded key → decoded value (LAST value wins on a
// repeated key; use parse_query_all to keep every value). Lenient: malformed
// percent-escapes stay literal instead of throwing.
fn parse_query(qs) {
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        if pair != "" {
            let eq = str_index_of(pair, "=");
            if eq >= 0 {
                out[_decode_lenient(pair[0..eq])] = _decode_lenient(pair[(eq + 1)..]);
            } else {
                out[_decode_lenient(pair)] = "";
            }
        }
        i = i + 1;
    }
    return out;
}

// parse_query_all(qs) → map of decoded key → LIST of decoded values, preserving
// repeated keys (e.g. "a=1&a=2" → { a: ["1", "2"] }). The standard form for
// multi-valued query parameters (checkbox groups, filters, tags, ...).
fn parse_query_all(qs) {
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        if pair != "" {
            let eq = str_index_of(pair, "=");
            let k = "";
            let v = "";
            if eq >= 0 { k = _decode_lenient(pair[0..eq]); v = _decode_lenient(pair[(eq + 1)..]); }
            else { k = _decode_lenient(pair); }
            if not map_has(out, k) { out[k] = []; }
            push(out[k], v);
        }
        i = i + 1;
    }
    return out;
}

// build_query(params) → "k1=v1&k2=v2" with keys/values percent-encoded. A LIST
// value emits one repeated key per element ("tag=x&tag=y"); any other value is
// stringified.
fn build_query(params) {
    let keys = map_keys(params);
    let acc = [];
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        let v = params[k];
        if is_array(v) {
            let j = 0;
            while j < len(v) {
                push(acc, url_encode(k) + "=" + url_encode(str(v[j])));
                j = j + 1;
            }
        } else {
            push(acc, url_encode(k) + "=" + url_encode(str(v)));
        }
        i = i + 1;
    }
    return str_join(acc, "&");
}

// ── authority (userinfo@host:port) ──────────────────────────────────────────────
// Robustly split an authority into { userinfo, username, password, host, port }.
// Handles userinfo (split at the LAST '@'), IPv6 literals ([::1]:port, host keeps
// its brackets), and a non-numeric/absent port (→ nil, never throws).
fn _parse_authority(authority) {
    let userinfo = "";
    let username = "";
    let password = "";
    let hostport = authority;

    let at = _rindex(authority, "@");
    if at >= 0 {
        userinfo = str_slice(authority, 0, at);
        hostport = str_slice(authority, at + 1, len(authority));
        let uc = str_index_of(userinfo, ":");
        if uc >= 0 {
            username = str_slice(userinfo, 0, uc);
            password = str_slice(userinfo, uc + 1, len(userinfo));
        } else {
            username = userinfo;
        }
    }

    let host = "";
    let port = nil;
    if str_starts_with(hostport, "[") {
        // IPv6 literal: [addr]:port — colons inside [] are NOT the port separator.
        let rb = str_index_of(hostport, "]");
        if rb >= 0 {
            host = str_slice(hostport, 0, rb + 1);   // keep the brackets
            let after = str_slice(hostport, rb + 1, len(hostport));
            if str_starts_with(after, ":") { port = _safe_port(str_slice(after, 1, len(after))); }
        } else {
            host = hostport;
        }
    } else {
        let colon = str_index_of(hostport, ":");
        if colon >= 0 {
            host = str_slice(hostport, 0, colon);
            port = _safe_port(str_slice(hostport, colon + 1, len(hostport)));
        } else {
            host = hostport;
        }
    }
    return map{ userinfo: userinfo, username: username, password: password, host: host, port: port };
}

// parse(url) → map{ scheme, userinfo, username, password, host, port, path,
//                   query, fragment, params }.
// Lenient: missing components come back as "" (or nil for port / empty map for
// params). A string with no scheme is treated as a bare path.
fn parse(url) {
    let s = url;

    let fragment = "";
    let hash = str_index_of(s, "#");
    if hash >= 0 {
        fragment = s[(hash + 1)..];
        s = s[0..hash];
    }

    let query = "";
    let q = str_index_of(s, "?");
    if q >= 0 {
        query = s[(q + 1)..];
        s = s[0..q];
    }

    let scheme = "";
    let rest = s;
    let sep = str_index_of(s, "://");
    if sep >= 0 {
        scheme = s[0..sep];
        rest = s[(sep + 3)..];
    }

    let userinfo = "";
    let username = "";
    let password = "";
    let host = "";
    let port = nil;
    let path = "";
    if scheme != "" {
        // WHATWG: in special schemes (http/https/ws/wss/ftp/file) a backslash is
        // an authority/path separator just like '/'. Normalizing it BEFORE we
        // split the authority is a security fix: `http://evil.com\@google.com/`
        // must resolve to host evil.com (what a browser/fetcher connects to),
        // not google.com — otherwise a parse().host allow-list is bypassable.
        if _is_special_scheme(scheme) { rest = str_replace_all(rest, "\\", "/"); }
        let slash = str_index_of(rest, "/");
        let authority = rest;
        if slash >= 0 {
            authority = rest[0..slash];
            path = rest[slash..];
        }
        let a = _parse_authority(authority);
        userinfo = a.userinfo; username = a.username; password = a.password;
        host = a.host; port = a.port;
    } else {
        path = rest;
    }

    return map{
        scheme: scheme,
        userinfo: userinfo,
        username: username,
        password: password,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment,
        params: parse_query(query)
    };
}

fn _get(parts, key, default_val) {
    return try parts[key] catch default_val;
}

// build(parts) → URL string. Accepts the shape produced by `parse`; any
// component may be omitted. If `query` is absent but `params` is present, the
// query is rendered from `params`. Userinfo comes from `userinfo`, or is built
// from `username`[:`password`].
fn build(parts) {
    let scheme = _get(parts, "scheme", "");
    let userinfo = _get(parts, "userinfo", "");
    let username = _get(parts, "username", "");
    let password = _get(parts, "password", "");
    let host = _get(parts, "host", "");
    let port = _get(parts, "port", nil);
    let path = _get(parts, "path", "");
    let query = _get(parts, "query", "");
    let fragment = _get(parts, "fragment", "");
    let params = _get(parts, "params", nil);

    if query == "" and params != nil {
        query = build_query(params);
    }
    // Reconstruct userinfo from username/password if not given explicitly.
    if userinfo == "" and username != "" {
        if password != "" { userinfo = username + ":" + password; }
        else { userinfo = username; }
    }

    let out = "";
    if scheme != "" { out = out + scheme + "://"; }
    if userinfo != "" { out = out + userinfo + "@"; }
    out = out + host;
    if port != nil { out = out + ":" + str(port); }
    out = out + path;
    if query != "" { out = out + "?" + query; }
    if fragment != "" { out = out + "#" + fragment; }
    return out;
}

// Normalize a path's `.` and `..` segments (RFC 3986 §5.2.4, segment form).
fn _remove_dot_segments(path) {
    let segs = str_split(path, "/");
    let out = [];
    let i = 0;
    while i < len(segs) {
        let s = segs[i];
        if s == "." {
            // current dir — drop
        } elif s == ".." {
            // go up, but never above the root (a leading "" segment)
            if len(out) > 0 and out[len(out) - 1] != "" { array_pop(out); }
        } else {
            push(out, s);
        }
        i = i + 1;
    }
    return str_join(out, "/");
}

// join(base, ref) → resolve a (possibly relative) reference against a base URL.
// RFC 3986 §5.2 subset: absolute refs, scheme-relative (//host), absolute-path
// (/p), query-only (?q), fragment-only (#f), and relative paths merged against
// the base's directory with dot-segment removal.
fn join(base, ref) {
    if ref == "" { return base; }
    let r = parse(ref);
    if r.scheme != "" {
        r.path = _remove_dot_segments(r.path);
        return build(r);
    }
    let b = parse(base);
    if str_starts_with(ref, "//") {
        // scheme-relative: take base scheme, ref's authority + path
        let rr = parse(b.scheme + ":" + ref);
        rr.path = _remove_dot_segments(rr.path);
        return build(rr);
    }
    let out = map{
        scheme: b.scheme, userinfo: b.userinfo, username: b.username,
        password: b.password, host: b.host, port: b.port
    };
    if str_starts_with(ref, "/") {
        out.path = _remove_dot_segments(r.path);
        out.query = r.query; out.fragment = r.fragment;
    } elif str_starts_with(ref, "?") {
        out.path = b.path; out.query = r.query; out.fragment = r.fragment;
    } elif str_starts_with(ref, "#") {
        out.path = b.path; out.query = b.query; out.fragment = r.fragment;
    } else {
        // relative path: merge with the base path's directory
        let basedir = b.path;
        let ls = _rindex(basedir, "/");
        let merged = r.path;
        if ls >= 0 { merged = str_slice(basedir, 0, ls + 1) + r.path; }
        out.path = _remove_dot_segments(merged);
        out.query = r.query; out.fragment = r.fragment;
    }
    return build(out);
}

// default_port(scheme) — the well-known port for a scheme, or nil.
fn default_port(scheme) {
    let s = str_lower(str(scheme));
    if s == "http" or s == "ws" { return 80; }
    if s == "https" or s == "wss" { return 443; }
    if s == "ftp" { return 21; }
    if s == "ssh" or s == "sftp" { return 22; }
    return nil;
}

// _is_special_scheme(scheme) — the WHATWG "special" schemes, whose authority
// parsing treats '\' like '/'. Case-insensitive.
fn _is_special_scheme(scheme) {
    let s = str_lower(str(scheme));
    return s == "http" or s == "https" or s == "ws" or s == "wss"
        or s == "ftp" or s == "file";
}
fn is_special_scheme(scheme) { return _is_special_scheme(scheme); }

// strip_credentials(url) — the URL with any userinfo (user:pass@) removed.
// Use before logging or following a redirect so credentials don't leak.
fn strip_credentials(url) {
    let u = parse(url);
    u.userinfo = ""; u.username = ""; u.password = "";
    return build(u);
}

// _effective_port(u) — explicit port, or the scheme default (may be nil).
fn _effective_port(u) {
    if u.port != nil { return u.port; }
    return default_port(u.scheme);
}

// same_origin(a, b) — true if two URLs share scheme + host + effective port
// (host/scheme compared case-insensitively; an explicit default port equals the
// implicit one). The web same-origin rule — the basis for CORS/cookie scoping.
fn same_origin(a, b) {
    let ua = parse(a);
    let ub = parse(b);
    if str_lower(ua.scheme) != str_lower(ub.scheme) { return false; }
    if str_lower(ua.host) != str_lower(ub.host) { return false; }
    return _effective_port(ua) == _effective_port(ub);
}

// is_absolute(url) — true if the URL has a scheme.
fn is_absolute(url) {
    return parse(url).scheme != "";
}

// origin(url) — scheme://host[:port], without userinfo / path / query / fragment.
// WHATWG origin serialization: the host is lowercased and a port equal to the
// scheme default is dropped, so origins compare reliably for security checks.
fn origin(url) {
    let u = parse(url);
    let out = "";
    if u.scheme != "" { out = str_lower(u.scheme) + "://"; }
    out = out + str_lower(u.host);
    if u.port != nil and u.port != default_port(u.scheme) {
        out = out + ":" + str(u.port);
    }
    return out;
}

// with_query(url, params) — return the URL with its query REPLACED by `params`.
fn with_query(url, params) {
    let u = parse(url);
    u.query = build_query(params);
    u.params = params;
    return build(u);
}

// add_params(url, params) — merge `params` into the URL's existing query (new keys
// override). Returns the rebuilt URL.
fn add_params(url, params) {
    let u = parse(url);
    let merged = u.params;
    let ks = map_keys(params);
    let i = 0;
    while i < len(ks) { merged[ks[i]] = params[ks[i]]; i = i + 1; }
    u.query = build_query(merged);
    u.params = merged;
    return build(u);
}

// normalize(url) — lowercase the scheme and host, remove `.`/`..` path segments,
// drop a default port, and give an authority URL an explicit "/" path.
fn normalize(url) {
    let u = parse(url);
    u.scheme = str_lower(u.scheme);
    u.host = str_lower(u.host);
    u.path = _remove_dot_segments(u.path);
    if u.scheme != "" and u.host != "" and u.path == "" { u.path = "/"; }
    if u.port != nil and u.port == default_port(u.scheme) { u.port = nil; }
    return build(u);
}

export is_special_scheme, strip_credentials, same_origin;
export parse, build, parse_query, parse_query_all, build_query, join,
       default_port, is_absolute, origin, with_query, add_params, normalize;
