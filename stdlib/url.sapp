// stdlib/url.sapp — URL and query-string parsing / building.
//
// Uses the native `url_encode` / `url_decode` builtins for percent-encoding.
//
// Usage:
//   let url = import("stdlib:url.sapp");
//   let u = url.parse("https://example.com:8080/a/b?x=1&y=two#top");
//   print u.host;                       // "example.com"
//   print u.params.x;                   // "1"
//   print url.build_query(map{ q: "a b", page: "2" });  // "q=a+b&page=2"

// parse_query(qs) → map of decoded key → decoded value.
fn parse_query(qs) {
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        if pair != "" {
            let eq = str_index_of(pair, "=");
            if eq >= 0 {
                let k = url_decode(pair[0..eq]);
                let v = url_decode(pair[(eq + 1)..]);
                out[k] = v;
            } else {
                out[url_decode(pair)] = "";
            }
        }
        i = i + 1;
    }
    return out;
}

// build_query(params) → "k1=v1&k2=v2" with keys/values percent-encoded.
fn build_query(params) {
    let keys = map_keys(params);
    let acc = [];
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        let v = params[k];
        push(acc, url_encode(k) + "=" + url_encode(str(v)));
        i = i + 1;
    }
    return str_join(acc, "&");
}

// parse(url) → map{ scheme, host, port, path, query, fragment, params }.
// Lenient: missing components come back as "" (or nil for port / empty map
// for params). A string with no scheme is treated as a bare path.
fn parse(url) {
    let s = url;

    let fragment = "";
    let hash = str_index_of(s, "#");
    if hash >= 0 {
        fragment = s[(hash + 1)..];
        s = s[0..hash];
    }

    let query = "";
    let q = str_index_of(s, "?");
    if q >= 0 {
        query = s[(q + 1)..];
        s = s[0..q];
    }

    let scheme = "";
    let rest = s;
    let sep = str_index_of(s, "://");
    if sep >= 0 {
        scheme = s[0..sep];
        rest = s[(sep + 3)..];
    }

    let host = "";
    let port = nil;
    let path = "";
    if scheme != "" {
        let slash = str_index_of(rest, "/");
        let authority = rest;
        if slash >= 0 {
            authority = rest[0..slash];
            path = rest[slash..];
        }
        let colon = str_index_of(authority, ":");
        if colon >= 0 {
            host = authority[0..colon];
            port = parse_number(authority[(colon + 1)..]);
        } else {
            host = authority;
        }
    } else {
        path = rest;
    }

    return map{
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment,
        params: parse_query(query)
    };
}

fn _get(parts, key, default_val) {
    return try parts[key] catch default_val;
}

// build(parts) → URL string. Accepts the shape produced by `parse`; any
// component may be omitted. If `query` is absent but `params` is present,
// the query is rendered from `params`.
fn build(parts) {
    let scheme = _get(parts, "scheme", "");
    let host = _get(parts, "host", "");
    let port = _get(parts, "port", nil);
    let path = _get(parts, "path", "");
    let query = _get(parts, "query", "");
    let fragment = _get(parts, "fragment", "");
    let params = _get(parts, "params", nil);

    if query == "" and params != nil {
        query = build_query(params);
    }

    let out = "";
    if scheme != "" { out = out + scheme + "://"; }
    out = out + host;
    if port != nil { out = out + ":" + str(port); }
    out = out + path;
    if query != "" { out = out + "?" + query; }
    if fragment != "" { out = out + "#" + fragment; }
    return out;
}

export parse, build, parse_query, build_query;
