// stdlib/math_symbols.sapp — mathematical symbols and shortcuts for pblang.
//
// pblang source syntax is intentionally ASCII-first today. This module lets tools,
// the IDE, notebooks, and preprocessors accept common mathematical notation and
// normalize it into valid pblang code without changing parser semantics.

let M = import("stdlib:math.sapp");

fn _r(s, from, to) { return str_replace_all(s, from, to); }

fn symbol_table() {
    return [
        map{ symbol: "π", ascii: "PI", name: "pi constant", kind: "constant" },
        map{ symbol: "Π", ascii: "product", name: "product / repeated multiplication", kind: "function" },
        map{ symbol: "∏", ascii: "product", name: "product / repeated multiplication", kind: "function" },
        map{ symbol: "τ", ascii: "TAU", name: "tau constant", kind: "constant" },
        map{ symbol: "φ", ascii: "PHI", name: "golden ratio", kind: "constant" },
        map{ symbol: "Φ", ascii: "PHI", name: "golden ratio", kind: "constant" },
        map{ symbol: "√", ascii: "sqrt", name: "square root", kind: "function" },
        map{ symbol: "×", ascii: "*", name: "multiply", kind: "operator" },
        map{ symbol: "·", ascii: "*", name: "dot/multiply", kind: "operator" },
        map{ symbol: "÷", ascii: "/", name: "divide", kind: "operator" },
        map{ symbol: "−", ascii: "-", name: "minus", kind: "operator" },
        map{ symbol: "≤", ascii: "<=", name: "less or equal", kind: "operator" },
        map{ symbol: "≥", ascii: ">=", name: "greater or equal", kind: "operator" },
        map{ symbol: "≠", ascii: "!=", name: "not equal", kind: "operator" },
        map{ symbol: "≡", ascii: "==", name: "equivalent/equal", kind: "operator" },
        map{ symbol: "∧", ascii: "and", name: "logical and", kind: "operator" },
        map{ symbol: "∨", ascii: "or", name: "logical or", kind: "operator" },
        map{ symbol: "¬", ascii: "not", name: "logical not", kind: "operator" },
        map{ symbol: "∞", ascii: "(1 / 0)", name: "infinity expression", kind: "constant" },
    ];
}

fn has_symbol(s) {
    let tbl = symbol_table();
    let i = 0;
    while i < len(tbl) {
        if str_contains(s, tbl[i].symbol) { return true; }
        i = i + 1;
    }
    return false;
}

// normalize_expr(expr) converts math notation for expression snippets.
// It also treats caret as exponent because math users normally mean power there.
fn normalize_expr(expr) {
    let s = str(expr);
    s = _r(s, "π", "PI");
    s = _r(s, "Π", "product");
    s = _r(s, "∏", "product");
    s = _r(s, "τ", "TAU");
    s = _r(s, "φ", "PHI");
    s = _r(s, "Φ", "PHI");
    s = _r(s, "√", "num_sqrt");
    s = _r(s, "×", "*");
    s = _r(s, "·", "*");
    s = _r(s, "÷", "/");
    s = _r(s, "−", "-");
    s = _r(s, "≤", "<=");
    s = _r(s, "≥", ">=");
    s = _r(s, "≠", "!=");
    s = _r(s, "≡", "==");
    s = _r(s, "∧", " and ");
    s = _r(s, "∨", " or ");
    s = _r(s, "¬", "not ");
    s = _r(s, "∞", "(1 / 0)");
    s = _r(s, "^", "**");
    return s;
}

// normalize_code(code) converts safe symbols for pblang source. It does not rewrite
// caret because pblang already uses `^` for bitwise xor; use normalize_expr for math
// scratchpads where `^` should mean exponent.
fn normalize_code(code) {
    let s = str(code);
    s = _r(s, "π", "PI");
    s = _r(s, "Π", "product");
    s = _r(s, "∏", "product");
    s = _r(s, "τ", "TAU");
    s = _r(s, "φ", "PHI");
    s = _r(s, "Φ", "PHI");
    s = _r(s, "√", "num_sqrt");
    s = _r(s, "×", "*");
    s = _r(s, "·", "*");
    s = _r(s, "÷", "/");
    s = _r(s, "−", "-");
    s = _r(s, "≤", "<=");
    s = _r(s, "≥", ">=");
    s = _r(s, "≠", "!=");
    s = _r(s, "≡", "==");
    s = _r(s, "∧", " and ");
    s = _r(s, "∨", " or ");
    s = _r(s, "¬", "not ");
    s = _r(s, "∞", "(1 / 0)");
    return s;
}

fn shortcuts() {
    return map{
        PI: M.PI, TAU: M.TAU, PHI: M.PHI, E: M.E,
        product: product,
        sqrt: num_sqrt,
        pow: num_pow,
        sin: M.sin, cos: M.cos, tan: M.tan,
        asin: M.asin, acos: M.acos, atan: M.atan, atan2: M.atan2,
        log: M.log, log2: M.log2, log10: M.log10,
        abs: M.abs, min: M.min, max: M.max,
    };
}

fn shortcut_table() {
    return map{
        "\\pi": "π", "\\Pi": "∏", "\\prod": "∏", "\\product": "∏", "\\GreekPi": "Π", "\\tau": "τ", "\\phi": "φ", "\\Phi": "Φ",
        "\\alpha": "α", "\\Alpha": "Α", "\\beta": "β", "\\Beta": "Β",
        "\\gamma": "γ", "\\Gamma": "Γ", "\\delta": "δ", "\\Delta": "Δ",
        "\\epsilon": "ε", "\\Epsilon": "Ε", "\\theta": "θ", "\\Theta": "Θ",
        "\\lambda": "λ", "\\Lambda": "Λ", "\\mu": "μ", "\\Mu": "Μ",
        "\\sigma": "σ", "\\Sigma": "Σ", "\\omega": "ω", "\\Omega": "Ω",
        "\\sqrt": "√", "\\times": "×", "\\cdot": "·", "\\div": "÷", "\\minus": "−",
        "\\le": "≤", "\\ge": "≥", "\\ne": "≠", "\\eq": "≡",
        "\\and": "∧", "\\or": "∨", "\\not": "¬",
        "\\inf": "∞", "\\sum": "∑", "\\int": "∫", "\\deg": "°",
        "\\approx": "≈", "\\to": "→", "\\right": "→", "\\left": "←", "\\up": "↑", "\\down": "↓",
        "\\bullet": "•", "\\copy": "©", "\\tm": "™", "\\ellipsis": "…",
    };
}

fn expand_shortcut(name) {
    let tbl = shortcut_table();
    if map_has(tbl, name) { return tbl[name]; }
    return nil;
}

// superscript_to_pow(s) — convert unicode superscript digits to `**n` exponents.
fn superscript_to_pow(s) {
    let supers = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];
    let out = str(s);
    let i = 0;
    while i < 10 { out = _r(out, supers[i], "**" + str(i)); i = i + 1; }
    return out;
}

// to_symbols(s) — the REVERSE of normalize: render ASCII math as pretty symbols
// for display (power `**` becomes `^`, not `××`).
fn to_symbols(s) {
    let out = str(s);
    out = _r(out, "**", "^");
    out = _r(out, "<=", "≤");
    out = _r(out, ">=", "≥");
    out = _r(out, "!=", "≠");
    out = _r(out, "*", "×");
    out = _r(out, "sqrt", "√");
    out = _r(out, "PI", "π");
    return out;
}

// latex_expand(s) — replace every \command in `s` with its symbol. Commands are
// applied LONGEST-FIRST so a short command (\le) can't corrupt a longer one (\left).
fn latex_expand(s) {
    let tbl = shortcut_table();
    let keys = map_keys(tbl);
    let a = 1;
    while a < len(keys) {
        let key = keys[a];
        let kl = len(key);
        let b = a - 1;
        while b >= 0 and len(keys[b]) < kl { keys[b + 1] = keys[b]; b = b - 1; }
        keys[b + 1] = key;
        a = a + 1;
    }
    let out = str(s);
    let i = 0;
    while i < len(keys) { out = _r(out, keys[i], tbl[keys[i]]); i = i + 1; }
    return out;
}

fn explain_symbol(sym) {
    let tbl = symbol_table();
    let i = 0;
    while i < len(tbl) {
        if tbl[i].symbol == sym { return tbl[i]; }
        i = i + 1;
    }
    return map{ symbol: sym, ascii: "", name: "unknown mathematical symbol", kind: "unknown" };
}

export symbol_table, has_symbol, normalize_expr, normalize_code, shortcuts, shortcut_table, expand_shortcut, explain_symbol,
       superscript_to_pow, to_symbols, latex_expand;
