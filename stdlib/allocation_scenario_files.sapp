let Tables=import("stdlib:table_files.sapp");let Scenario=import("stdlib:allocation_scenario.sapp");let Files=import("stdlib:allocation_files.sapp");
fn open(path,before_total,after_total,delimiter=",") {
 let loaded=Tables.open(path,delimiter);if not loaded.ok{return loaded;}
 let report=try Scenario.compare(loaded.document,before_total,after_total) catch nil;
 if report==nil{return map{ok:false,error:"Expected Label,Weight table and two integer totals; the full comparison must fit Sheets limits."};}
 return map{ok:true,report:report};
}
fn run(input,output,before_total,after_total,delimiter=",") {
 let loaded=open(input,before_total,after_total,delimiter);if not loaded.ok{return loaded;}
 let saved=Files.save(output,loaded.report,delimiter);if not saved.ok{return saved;}
 return map{ok:true,before_total:loaded.report.before_total,total:loaded.report.total,rows:loaded.report.rows,increased:loaded.report.increased,decreased:loaded.report.decreased,unchanged:loaded.report.unchanged,method:loaded.report.method,atomic_visibility:false};
}
export open,run;
