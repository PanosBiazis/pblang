// stdlib/bignum.sapp — exact big-number helpers built on the arbitrary-precision
// `bigint` type. Every result is exact, with no f64 overflow/rounding:
//
//   let bn = import("stdlib:bignum.sapp");
//   bn.factorial(50)        // 30414093201713378043612608166064768844377641568960512000000000000
//   bn.comb(52, 5)          // 2598960  (poker hands, exact)
//   bn.fib(100)             // 354224848179261915075

fn _b(x) { return bigint(x); }
fn _zero() { return bigint(0); }

fn abs(n) {
    let x = _b(n);
    if x < _zero() { return _zero() - x; }
    return x;
}

// n! — exact factorial (n is a non-negative integer).
fn factorial(n) {
    let r = bigint(1);
    let i = bigint(2);
    let nn = _b(n);
    while i <= nn { r = r * i; i = i + 1; }
    return r;
}

// Greatest common divisor (Euclid), exact and sign-normalized.
fn gcd(a, b) {
    let x = abs(a);
    let y = abs(b);
    while y != _zero() {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

// Least common multiple, exact.
fn lcm(a, b) {
    let g = gcd(a, b);
    if g == _zero() { return _zero(); }
    return abs(_b(a) / g * _b(b));   // (a / gcd) * b, divides exactly
}

// base ** exp — exact integer power (exp a non-negative integer).
fn pow(base, exp) { return _b(base) ** exp; }

// n-th Fibonacci number (fib(0)=0, fib(1)=1), exact for any n.
fn fib(n) {
    let a = bigint(0);
    let b = bigint(1);
    let i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

// Binomial coefficient "n choose k", exact.
fn comb(n, k) {
    if k < 0 or k > n { return _zero(); }
    return factorial(n) / (factorial(k) * factorial(n - k));
}

// Permutations "n pick k" = n!/(n-k)!, exact.
fn perm(n, k) {
    if k < 0 or k > n { return _zero(); }
    return factorial(n) / factorial(n - k);
}

fn is_even(n) { return _b(n) % bigint(2) == _zero(); }
fn is_odd(n) { return not is_even(n); }

// comb_fast(n, k) — binomial coefficient via the MULTIPLICATIVE formula: stays
// integral at every step, so it avoids the huge intermediate factorials `comb`
// builds. Prefer this for large n. (n, k are plain integers.)
fn comb_fast(n, k) {
    if k < 0 or k > n { return _zero(); }
    let kk = k;
    if kk > n - kk { kk = n - kk; }
    let r = bigint(1);
    let i = 0;
    while i < kk {
        r = r * bigint(n - i);
        r = r / bigint(i + 1);
        i = i + 1;
    }
    return r;
}

// mod_pow(base, exp, m) — (base^exp) mod m via fast binary exponentiation, all in
// bigint so it never overflows. The workhorse of modular / RSA-style crypto.
// exp is a plain non-negative integer; base/m may be numbers or bigints.
fn mod_pow(base, exp, m) {
    let mm = _b(m);
    let r = bigint(1);
    let b = _b(base) % mm;
    let e = exp;
    while e > 0 {
        if e % 2 == 1 { r = (r * b) % mm; }
        b = (b * b) % mm;
        e = num_floor(e / 2);
    }
    return r;
}

// mod_inv(a, m) — modular multiplicative inverse of a mod m (extended Euclid),
// or nil if it doesn't exist (gcd(a,m) != 1). Returns a bigint in [0, m).
fn mod_inv(a, m) {
    let mm = _b(m);
    let old_r = _b(a) % mm;
    let r = mm;
    let old_s = bigint(1);
    let s = bigint(0);
    while r != _zero() {
        let q = old_r / r;
        let tr = old_r - q * r; old_r = r; r = tr;
        let ts = old_s - q * s; old_s = s; s = ts;
    }
    if old_r != bigint(1) { return nil; }   // not invertible
    let inv = old_s % mm;
    if inv < _zero() { inv = inv + mm; }
    return inv;
}

// is_prime(n) — deterministic trial division for a plain number n.
fn is_prime(n) {
    if n < 2 { return false; }
    if n < 4 { return true; }
    if n % 2 == 0 { return false; }
    let i = 3;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 2;
    }
    return true;
}

// next_prime(n) — smallest prime strictly greater than n (plain number).
fn next_prime(n) {
    let c = n + 1;
    while not is_prime(c) { c = c + 1; }
    return c;
}

// sum_to(n) — exact 1 + 2 + ... + n  =  n(n+1)/2  (bigint).
fn sum_to(n) { return _b(n) * _b(n + 1) / bigint(2); }

// digit_count(x) — number of decimal digits of bigint/number x (sign ignored).
fn digit_count(x) {
    let s = str(abs(x));
    return len(s);
}

export abs, factorial, gcd, lcm, pow, fib, comb, perm, is_even, is_odd;
export comb_fast, mod_pow, mod_inv, is_prime, next_prime, sum_to, digit_count;
