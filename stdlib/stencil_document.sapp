// Editable small geometric-mask recipes, independent of any UI or file system.
let Mask=import("stdlib:binary_mask.sapp");let S=import("stdlib:serialization.sapp");
let FORMAT="pblang.stencil.v1";let MAX_FILE_BYTES=16384;
fn _int(n,low,high) {return type(n)=="number" and n>=low and n<=high and n==num_floor(n);}
fn validate(doc) {
    if type(doc)!="map" or len(doc)!=6 or not map_has(doc,"format") or not map_has(doc,"width") or not map_has(doc,"height") or not map_has(doc,"regions") or not map_has(doc,"operation") or not map_has(doc,"radius")
        or doc.format!=FORMAT or not _int(doc.width,1,64) or not _int(doc.height,1,64) or type(doc.regions)!="array" or len(doc.regions)>16 or not _int(doc.radius,0,8)
        or (doc.operation!="original" and doc.operation!="dilate" and doc.operation!="erode" and doc.operation!="outline") {throw "invalid stencil recipe";}
    for r in doc.regions {
        if type(r)!="map" or len(r)!=4 or not map_has(r,"x") or not map_has(r,"y") or not map_has(r,"width") or not map_has(r,"height")
            or not _int(r.x,0,doc.width-1) or not _int(r.y,0,doc.height-1) or not _int(r.width,1,doc.width) or not _int(r.height,1,doc.height)
            or r.x+r.width>doc.width or r.y+r.height>doc.height {throw "stencil rectangle outside canvas";}
    }
    return true;
}
fn create(width=32,height=24) {let doc=map{format:FORMAT,width:width,height:height,regions:[],operation:"original",radius:1};validate(doc);return doc;}
fn copy(doc) {validate(doc);let out=create(doc.width,doc.height);out.operation=doc.operation;out.radius=doc.radius;for r in doc.regions {array_push(out.regions,map{x:r.x,y:r.y,width:r.width,height:r.height});}return out;}
fn add_rectangle(doc,x,y,width,height) {let out=copy(doc);array_push(out.regions,map{x:x,y:y,width:width,height:height});validate(out);return out;}
fn transform(doc,operation,radius=1) {let out=copy(doc);out.operation=operation;out.radius=radius;validate(out);return out;}
fn render(doc) {validate(doc);let mask=Mask.rectangles(doc.width,doc.height,doc.regions);if doc.operation=="dilate" {return Mask.dilate(mask,doc.radius);}if doc.operation=="erode" {return Mask.erode(mask,doc.radius);}if doc.operation=="outline" {return Mask.outline(mask,doc.radius);}return mask;}
fn _limits() {return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:4,max_items:300,strict:true,reject_duplicate_keys:true};}
fn encode(doc) {let r=S.stringify_safe(copy(doc),"json",_limits());if not r.ok {throw "stencil encoding failed";}return r.value;}
fn decode(text) {let r=S.parse_safe(text,"json",_limits());if not r.ok or r.duplicate_keys_checked!=true {throw "invalid stencil file";}return copy(r.value);}
export FORMAT,MAX_FILE_BYTES,validate,create,copy,add_rectangle,transform,render,encode,decode;

// Orthogonal geometry transforms preserve the existing stencil format and morphology.
fn orient(doc,operation) {
 let out=copy(doc);if operation!="clockwise" and operation!="mirror_x" and operation!="mirror_y" {throw "invalid stencil orientation";}
 if operation=="clockwise" {out.width=doc.height;out.height=doc.width;}
 out.regions=[];for r in doc.regions {
  let next=map{x:r.x,y:r.y,width:r.width,height:r.height};
  if operation=="clockwise" {next.x=doc.height-r.y-r.height;next.y=r.x;next.width=r.height;next.height=r.width;}
  elif operation=="mirror_x" {next.x=doc.width-r.x-r.width;}
  else {next.y=doc.height-r.y-r.height;}
  array_push(out.regions,next);
 }
 validate(out);return out;
}
export orient;
