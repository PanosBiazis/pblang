// stdlib/cli.sapp — Command-line interface utilities (G2)
//
// Provides comprehensive CLI tools: argument parsing, user prompts,
// progress bars, ASCII tables, spinners, and ANSI color formatting.
//
// Usage:
//   let cli = import("stdlib:cli.sapp");
//
//   // Argument parsing
//   let parser = cli.new("myapp", "1.0", "A tool that does things");
//   cli.flag(parser, "verbose", "v", false, "Enable verbose output");
//   cli.option(parser, "output", "o", "out.txt", "Output file path");
//   cli.positional(parser, "input", "Input file");
//   let args = cli.parse(parser, os_args());
//
//   // Interactive prompts
//   let name = cli.prompt("What is your name?");
//   let ok = cli.confirm("Continue?");
//
//   // Display
//   print cli.colorize("Error!", "red");
//   print cli.table(["Name","Age"], [["Alice","30"],["Bob","25"]]);
//   cli.progress_bar(5, 10, 40);

// ──────────────────────────────────────────────────────────────────────────
// Argument Parser (enhanced from G1)
// ──────────────────────────────────────────────────────────────────────────

// new(name, version, description) → parser object
fn new(name, version, description) {
    return map{
        name: name,
        version: version,
        description: description,
        flags: [],      // {name, short, default, help}
        options: [],    // {name, short, default, help}
        positionals: [] // {name, help}
    };
}

// flag(parser, name, short, default_val, help) — add a boolean flag
fn flag(parser, name, short, default_val, help) {
    array_push(parser.flags, map{
        name: name,
        short: short,
        default: default_val,
        help: help
    });
    return parser;
}

// option(parser, name, short, default_val, help) — add a string option
fn option(parser, name, short, default_val, help) {
    array_push(parser.options, map{
        name: name,
        short: short,
        default: default_val,
        help: help
    });
    return parser;
}

// positional(parser, name, help) — add a positional argument
fn positional(parser, name, help) {
    array_push(parser.positionals, map{ name: name, help: help });
    return parser;
}

// parse(parser, argv) → map of parsed values
fn parse(parser, argv) {
    let result = map{};
    let _rest = [];

    // Initialize defaults
    let fi = 0;
    while fi < len(parser.flags) {
        result[parser.flags[fi].name] = parser.flags[fi].default;
        fi = fi + 1;
    }
    let oi = 0;
    while oi < len(parser.options) {
        result[parser.options[oi].name] = parser.options[oi].default;
        oi = oi + 1;
    }

    // Parse arguments
    let i = 0;
    while i < len(argv) {
        let arg = argv[i];

        // --help / -h
        if arg == "--help" or arg == "-h" {
            result["_help"] = true;
            i = i + 1;
            continue;
        }

        // --version
        if arg == "--version" {
            result["_version"] = true;
            i = i + 1;
            continue;
        }

        // --flag or -f  (boolean)
        let flag_match = false;
        let fj = 0;
        while fj < len(parser.flags) {
            let f = parser.flags[fj];
            if arg == "--" + f.name or (f.short != "" and arg == "-" + f.short) {
                result[f.name] = true;
                flag_match = true;
                break;
            }
            fj = fj + 1;
        }
        if flag_match { i = i + 1; continue; }

        // --option value or -o value  (string)
        let opt_match = false;
        let ok = 0;
        while ok < len(parser.options) {
            let o = parser.options[ok];
            if arg == "--" + o.name or (o.short != "" and arg == "-" + o.short) {
                if i + 1 < len(argv) {
                    result[o.name] = argv[i + 1];
                    i = i + 2;
                } else {
                    i = i + 1;
                }
                opt_match = true;
                break;
            }
            // --option=value
            let eq_prefix = "--" + o.name + "=";
            if str_starts_with(arg, eq_prefix) {
                result[o.name] = str_slice(arg, len(eq_prefix), len(arg));
                opt_match = true;
                i = i + 1;
                break;
            }
            ok = ok + 1;
        }
        if opt_match { continue; }

        // Positional
        array_push(_rest, arg);
        i = i + 1;
    }

    // Assign positional args
    let pi = 0;
    while pi < len(parser.positionals) and pi < len(_rest) {
        result[parser.positionals[pi].name] = _rest[pi];
        pi = pi + 1;
    }
    result["_rest"] = _rest;
    return result;
}

// help_text(parser) → formatted help string
fn help_text(parser) {
    let h = parser.name + " " + parser.version + " — " + parser.description + "\n\n";
    h = h + "Usage: " + parser.name;
    if len(parser.options) > 0 { h = h + " [options]"; }
    if len(parser.flags) > 0 { h = h + " [flags]"; }
    let pi = 0;
    while pi < len(parser.positionals) {
        h = h + " <" + parser.positionals[pi].name + ">";
        pi = pi + 1;
    }
    h = h + "\n\n";

    if len(parser.flags) > 0 {
        h = h + "Flags:\n";
        let fi = 0;
        while fi < len(parser.flags) {
            let f = parser.flags[fi];
            let flag_str = "  --" + f.name;
            if f.short != "" { flag_str = flag_str + ", -" + f.short; }
            h = h + str_pad_right(flag_str, 24, " ") + f.help + "\n";
            fi = fi + 1;
        }
        h = h + "\n";
    }

    if len(parser.options) > 0 {
        h = h + "Options:\n";
        let oi = 0;
        while oi < len(parser.options) {
            let o = parser.options[oi];
            let opt_str = "  --" + o.name + " <val>";
            if o.short != "" { opt_str = "  --" + o.name + "/-" + o.short + " <val>"; }
            h = h + str_pad_right(opt_str, 24, " ") + o.help;
            if o.default != nil { h = h + " [default: " + str(o.default) + "]"; }
            h = h + "\n";
            oi = oi + 1;
        }
    }
    return h;
}

// ──────────────────────────────────────────────────────────────────────────
// Convenience: quick arg accessors
// ──────────────────────────────────────────────────────────────────────────

// args() — get all command-line arguments
fn args() {
    return os_args();
}

// has_flag(name) — check if a flag is present in the args
fn has_flag(name) {
    let all = os_args();
    let flag_long = "--" + name;
    let i = 0;
    while i < len(all) {
        if all[i] == flag_long { return true; }
        i = i + 1;
    }
    return false;
}

// get_opt(name, default_val) — get an option value from the args (--name value or --name=value)
fn get_opt(name, default_val) {
    let all = os_args();
    let opt_prefix = "--" + name + "=";
    let opt_long = "--" + name;
    let i = 0;
    while i < len(all) {
        if str_starts_with(all[i], opt_prefix) {
            return str_slice(all[i], len(opt_prefix), len(all[i]));
        }
        if all[i] == opt_long and i + 1 < len(all) {
            return all[i + 1];
        }
        i = i + 1;
    }
    return default_val;
}

// ──────────────────────────────────────────────────────────────────────────
// Interactive Prompts
// ──────────────────────────────────────────────────────────────────────────

// prompt(question) — ask for a line of input, return trimmed string (or "" if nil)
fn prompt(question) {
    print question;
    let raw = read_line();
    if raw == nil { return ""; }
    return str_trim(raw);
}

// confirm(question) — ask a yes/no question, return true/false
fn confirm(question) {
    let answer = prompt(question + " [y/N] ");
    let lower = "";
    let i = 0;
    while i < len(answer) {
        let ch = str_slice(answer, i, i + 1);
        // Simple ASCII lowercasing
        if ch == "Y" { lower = lower + "y"; }
        else if ch == "N" { lower = lower + "n"; }
        else { lower = lower + ch; }
        i = i + 1;
    }
    if lower == "y" or lower == "yes" { return true; }
    return false;
}

// ──────────────────────────────────────────────────────────────────────────
// Display Utilities
// ──────────────────────────────────────────────────────────────────────────

// progress_bar(current, total, width) — print ASCII progress bar
// Example: [████████░░░░░░░░] 50%
fn progress_bar(current, total, width) {
    if width == nil { width = 40; }
    if total <= 0 { total = 1; }

    let ratio = current / total;
    if ratio > 1.0 { ratio = 1.0; }
    if ratio < 0.0 { ratio = 0.0; }

    let filled = num_floor(ratio * width);
    let empty = width - filled;

    let bar = "[";
    let i = 0;
    while i < filled {
        bar = bar + "█";
        i = i + 1;
    }
    i = 0;
    while i < empty {
        bar = bar + "░";
        i = i + 1;
    }
    bar = bar + "] " + str(num_floor(ratio * 100)) + "%";
    return bar;
}

// table(headers, rows) → formatted ASCII table string
// headers: ["Name", "Age"]
// rows: [["Alice","30"], ["Bob","25"]]
fn table(headers, rows) {
    if len(headers) == 0 { return ""; }

    // Calculate column widths
    let col_widths = [];
    let ci = 0;
    while ci < len(headers) {
        col_widths[ci] = len(headers[ci]);
        ci = ci + 1;
    }

    let ri = 0;
    while ri < len(rows) {
        let fi = 0;
        while fi < len(rows[ri]) and fi < len(col_widths) {
            let cell_len = len(str(try rows[ri][fi] catch ""));
            if cell_len > try col_widths[fi] catch 0 { col_widths[fi] = cell_len; }
            fi = fi + 1;
        }
        ri = ri + 1;
    }

    // Build separator line
    fn sep_line(widths) {
        let line = "+";
        let i = 0;
        while i < len(widths) {
            let j = 0;
            while j < widths[i] + 2 { line = line + "-"; j = j + 1; }
            line = line + "+";
            i = i + 1;
        }
        return line;
    }

    // Pad a cell
    fn pad_cell(text, width) {
        let result = text;
        while len(result) < width { result = result + " "; }
        return result;
    }

    let sep = sep_line(col_widths);
    let output = sep + "\n";

    // Header row
    output = output + "|";
    let hi = 0;
    while hi < len(headers) {
        output = output + " " + pad_cell(headers[hi], col_widths[hi]) + " |";
        hi = hi + 1;
    }
    output = output + "\n" + sep + "\n";

    // Data rows
    ri = 0;
    while ri < len(rows) {
        output = output + "|";
        let fi = 0;
        while fi < len(rows[ri]) and fi < len(col_widths) {
            let cell = str(try rows[ri][fi] catch "");
            output = output + " " + pad_cell(cell, col_widths[fi]) + " |";
            fi = fi + 1;
        }
        output = output + "\n";
        ri = ri + 1;
    }

    output = output + sep;
    return output;
}

// spinner(msg, fn_to_run) — show a simple spinning animation while executing fn_to_run()
// This is a simplified version — in a real app you'd use async/concurrency.
fn spinner(msg, fn_to_run) {
    let frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    // Without true async, we just run the function and show start/end
    print msg + " ...";
    let result = fn_to_run();
    print msg + " done.";
    return result;
}

// ──────────────────────────────────────────────────────────────────────────
// ANSI Color Formatting
// ──────────────────────────────────────────────────────────────────────────

// ANSI color codes
let _ansi = map{
    reset:     "\x1b[0m",
    bold:      "\x1b[1m",
    dim:       "\x1b[2m",
    italic:    "\x1b[3m",
    underline: "\x1b[4m",
    black:     "\x1b[30m",
    red:       "\x1b[31m",
    green:     "\x1b[32m",
    yellow:    "\x1b[33m",
    blue:      "\x1b[34m",
    magenta:   "\x1b[35m",
    cyan:      "\x1b[36m",
    white:     "\x1b[37m",
    bg_black:  "\x1b[40m",
    bg_red:    "\x1b[41m",
    bg_green:  "\x1b[42m",
    bg_yellow: "\x1b[43m",
    bg_blue:   "\x1b[44m",
    bg_white:  "\x1b[47m",
};

// colorize(text, color) — wrap text in ANSI color codes
// Colors: red, green, yellow, blue, magenta, cyan, white, black
//         bg_red, bg_green, bg_yellow, bg_blue, bg_white, bg_black
// Styles: bold, dim, italic, underline
fn colorize(text, color) {
    if color == nil { return text; }
    let code = try _ansi[color] catch "";
    if code == "" { return text; }
    return code + text + _ansi.reset;
}

// color_print(text, color) — print colored text (convenience)
fn color_print(text, color) {
    print colorize(text, color);
    return nil;
}

// ──────────────────────────────────────────────────────────────────────────
// Export
// ──────────────────────────────────────────────────────────────────────────

export new, flag, option, positional, parse, help_text,
       args, has_flag, get_opt,
       prompt, confirm,
       progress_bar, table, spinner,
       colorize, color_print;
