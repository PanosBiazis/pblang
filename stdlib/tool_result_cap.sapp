// Whole-result UTF-8 admission for caller-owned, PREVALIDATED serialized JSON.
// This is deliberately not a JSON parser, validator, serializer or redactor.
// Pass the final serialized wrapper; send only receipt.output, never the receipt.

let _MAX_BYTES = 1048576;
let _MAX_INPUT_SCALARS = 1048576;
let _DEFAULT_BYTES = 65536;
let _REPLACEMENT = "{\"error\":\"tool_result_too_large\"}";

fn limits() {
    return map{ default_bytes: _DEFAULT_BYTES, max_bytes: _MAX_BYTES,
        max_input_scalars: _MAX_INPUT_SCALARS };
}

fn replacement_json() { return _REPLACEMENT; }

fn _receipt(ok, accepted, capped, input_bytes, output, output_bytes, reason) {
    return map{ format: "pblang.tool-result-cap.v1", ok: ok,
        accepted: accepted, capped: capped, input_bytes: input_bytes,
        output: output, output_bytes: output_bytes, reason: reason };
}

fn _reject(reason) {
    return _receipt(false, false, false, nil, nil, 0, reason);
}

fn _replacement(max_bytes, input_bytes, reason) {
    let bytes = len(str_to_bytes(_REPLACEMENT));
    if bytes > max_bytes {
        return _receipt(true, false, true, input_bytes, nil, 0, reason);
    }
    return _receipt(true, false, true, input_bytes, _REPLACEMENT, bytes, reason);
}

// Caps are exact bounded integers, not coercions. Zero means no nonempty output.
// Inputs beyond the scalar ceiling are rejected without byte-array allocation;
// input_bytes=nil explicitly means the exact UTF-8 byte count was not measured.
fn bound_prevalidated_json(text, max_bytes = 65536) {
    if type(max_bytes) != "number" { return _reject("invalid_limit"); }
    if max_bytes != max_bytes { return _reject("invalid_limit"); }
    if max_bytes < 0 or max_bytes > _MAX_BYTES or num_floor(max_bytes) != max_bytes {
        return _reject("invalid_limit");
    }
    if type(text) != "string" { return _reject("invalid_source_type"); }
    if len(text) > _MAX_INPUT_SCALARS {
        return _replacement(max_bytes, nil, "input_scalar_limit");
    }
    // At most four bytes per PBLang Unicode scalar, independent of caller cap.
    let input_bytes = len(str_to_bytes(text));
    if input_bytes > max_bytes {
        return _replacement(max_bytes, input_bytes, "output_byte_limit");
    }
    return _receipt(true, true, false, input_bytes, text, input_bytes, "accepted");
}

export limits, replacement_json, bound_prevalidated_json;
