// stdlib/encoding.sapp — Data encoding/decoding utilities for pblang.
//
// Binary-to-text encodings, URL encoding, MIME, and data formats.
//
// Usage:
//   let enc = import("stdlib:encoding.sapp");
//   let b64 = enc.base64_encode("Hello");
//   let txt = enc.base64_decode(b64);

// ── Hex encoding ──────────────────────────────────────────────────────────────

fn hex_encode(data) {
    let hex_chars = "0123456789abcdef";
    let result = "";
    for i in 0 to len(data) - 1 {
        let byte = strcharcodeat(data, i);
        let hi = (byte / 16) % 16;
        let lo = byte % 16;
        result = result + hex_chars[hi] + hex_chars[lo];
    }
    return result;
}

fn hex_decode(hex) {
    let result = "";
    let i = 0;
    while i + 1 < len(hex) {
        let hi = _hex_val(strcharcodeat(hex, i));
        let lo = _hex_val(strcharcodeat(hex, i + 1));
        if hi < 0 or lo < 0 { return nil; }
        result = result + strfromcharcode(hi * 16 + lo);
        i = i + 2;
    }
    return result;
}

fn _hex_val(code) {
    if code >= 48 and code <= 57 { return code - 48; }      // 0-9
    if code >= 65 and code <= 70 { return code - 55; }      // A-F
    if code >= 97 and code <= 102 { return code - 87; }     // a-f
    return -1;
}

// ── URL encoding ──────────────────────────────────────────────────────────────

fn url_encode(s) {
    let result = "";
    for i in 0 to len(s) - 1 {
        let ch = s[i];
        let code = strcharcodeat(ch, 0);
        if (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
           or (code >= 48 and code <= 57)
           or code == 45 or code == 95 or code == 46 or code == 126 {
            result = result + ch;
        } else if code == 32 {
            result = result + "+";
        } else {
            result = result + "%" + hex_encode(ch);
        }
    }
    return result;
}

fn url_decode(s) {
    let result = "";
    let i = 0;
    while i < len(s) {
        let ch = s[i];
        if ch == "+" {
            result = result + " ";
        } else if ch == "%" and i + 2 < len(s) {
            let hex = s[i + 1] + s[i + 2];
            let decoded = hex_decode(hex);
            if decoded != nil {
                result = result + decoded;
            }
            i = i + 2;
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return result;
}

// ── CSV encoding ──────────────────────────────────────────────────────────────

fn csv_encode(rows) {
    let result = "";
    for i in 0 to len(rows) - 1 {
        let row = rows[i];
        let line = "";
        for j in 0 to len(row) - 1 {
            let cell = str(row[j]);
            // Quote if contains comma, quote, or newline
            if str_contains(cell, ",") or str_contains(cell, "\"") or str_contains(cell, "\n") {
                cell = "\"" + str_replace_all(cell, "\"", "\"\"") + "\"";
            }
            if j > 0 { line = line + ","; }
            line = line + cell;
        }
        if i > 0 { result = result + "\n"; }
        result = result + line;
    }
    return result;
}

fn csv_decode(text) {
    let rows = [];
    let lines = str_split(text, "\n");
    for i in 0 to len(lines) - 1 {
        if str_trim(lines[i]) != "" {
            push(rows, _csv_parse_line(lines[i]));
        }
    }
    return rows;
}

fn _csv_parse_line(line) {
    let cells = [];
    let cell = "";
    let in_quotes = false;
    let i = 0;
    while i < len(line) {
        let ch = line[i];
        if in_quotes {
            if ch == "\"" {
                if i + 1 < len(line) and line[i + 1] == "\"" {
                    cell = cell + "\"";
                    i = i + 1;
                } else {
                    in_quotes = false;
                }
            } else {
                cell = cell + ch;
            }
        } else {
            if ch == "\"" {
                in_quotes = true;
            } else if ch == "," {
                push(cells, cell);
                cell = "";
            } else {
                cell = cell + ch;
            }
        }
        i = i + 1;
    }
    push(cells, cell);
    return cells;
}

// ── Base64 wrappers (delegate to builtins) ────────────────────────────────────

fn base64_encode(data) {
    return base64_encode_builtin(data);
}

fn base64_decode(data) {
    return base64_decode_builtin(data);
}

// ── JSON wrappers ─────────────────────────────────────────────────────────────

fn json_encode(val) {
    return json_stringify(val);
}

fn json_decode(str) {
    return json_parse(str);
}

export hex_encode, hex_decode, url_encode, url_decode;
export csv_encode, csv_decode;
export base64_encode, base64_decode;
export json_encode, json_decode;
