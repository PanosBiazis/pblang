// stdlib/encoding.sapp — Data encoding/decoding utilities for pblang.
//
// Binary-to-text encodings, URL encoding, MIME, and data formats.
//
// Usage:
//   let enc = import("stdlib:encoding.sapp");
//   let b64 = enc.base64_encode("Hello");
//   let txt = enc.base64_decode(b64);
//
// NOTE: For high-throughput code, the global builtins `hex_encode`,
// `hex_decode`, `url_encode`, `url_decode`, `base64_encode`, `base64_decode`
// are implemented natively in Rust and are 50-100x faster than the pure-pblang
// wrappers in this module. Use them directly without importing this module
// when you don't need the CSV / JSON helpers here too.

// ── Hex encoding ──────────────────────────────────────────────────────────────

// Encode every UTF-8 byte of `data` as two lowercase hex digits. Iterating
// the raw bytes (not codepoints) keeps multi-byte characters intact, matching
// the native `hex_encode` builtin.
fn hex_encode(data) {
    let hex_chars = "0123456789abcdef";
    let bytes = str_to_bytes(data);
    let result = "";
    for i in 0 to len(bytes) - 1 {
        let byte = bytes[i];
        let hi = num_floor(byte / 16);
        let lo = num_mod(byte, 16);
        result = result + str_slice(hex_chars, hi, hi + 1) + str_slice(hex_chars, lo, lo + 1);
    }
    return result;
}

// Decode a hex string into bytes, then interpret those bytes as UTF-8.
// Building a byte array (rather than concatenating strfromcharcode, which
// treats each value as a codepoint) is what makes binary round-trips correct.
fn hex_decode(hex) {
    let bytes = [];
    let i = 0;
    let n = len(hex);
    while i + 1 < n {
        let hi = _hex_val(strcharcodeat(hex, i));
        let lo = _hex_val(strcharcodeat(hex, i + 1));
        if hi < 0 or lo < 0 { return nil; }
        push(bytes, hi * 16 + lo);
        i = i + 2;
    }
    return bytes_to_str(bytes);
}

fn _hex_val(code) {
    if code >= 48 and code <= 57 { return code - 48; }      // 0-9
    if code >= 65 and code <= 70 { return code - 55; }      // A-F
    if code >= 97 and code <= 102 { return code - 87; }     // a-f
    return -1;
}

// ── URL encoding ──────────────────────────────────────────────────────────────

// Percent-encode per RFC 3986. Encoding operates byte-by-byte: a multi-byte
// UTF-8 character becomes one %XX escape per byte (e.g. "é" -> "%C3%A9"), which
// is what `url_decode` and every conforming decoder expect.
fn url_encode(s) {
    let hex_chars = "0123456789ABCDEF";
    let bytes = str_to_bytes(s);
    let result = "";
    for i in 0 to len(bytes) - 1 {
        let code = bytes[i];
        if (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
           or (code >= 48 and code <= 57)
           or code == 45 or code == 95 or code == 46 or code == 126 {
            result = result + strfromcharcode(code);
        } else {
            let hi = num_floor(code / 16);
            let lo = num_mod(code, 16);
            result = result + "%" + str_slice(hex_chars, hi, hi + 1) + str_slice(hex_chars, lo, lo + 1);
        }
    }
    return result;
}

// Decode percent-encoding into raw bytes first, then interpret the whole byte
// stream as UTF-8 once. Decoding per-escape would split a multi-byte character
// across invalid-UTF-8 boundaries.
//
// Malformed escapes ("%", "%2", "%zz") are REJECTED with an error, matching
// the native `url_decode` builtin: silently passing them through lets crafted
// input slip past validators that inspect the decoded form (filter bypass).
// "+" decodes to space, also matching the builtin (form-tolerant).
fn url_decode(s) {
    let bytes = [];
    let i = 0;
    let n = len(s);
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "+" {
            push(bytes, 32);
            i = i + 1;
        } else if ch == "%" {
            if i + 2 >= n { return error("url_decode: truncated percent-escape at " + str(i)); }
            let hi = _hex_val(strcharcodeat(str_slice(s, i + 1, i + 2), 0));
            let lo = _hex_val(strcharcodeat(str_slice(s, i + 2, i + 3), 0));
            if hi < 0 or lo < 0 { return error("url_decode: invalid percent-escape at " + str(i)); }
            push(bytes, hi * 16 + lo);
            i = i + 3;
        } else {
            let cb = str_to_bytes(ch);
            let k = 0;
            while k < len(cb) {
                push(bytes, cb[k]);
                k = k + 1;
            }
            i = i + 1;
        }
    }
    return bytes_to_str(bytes);
}

// ── CSV encoding ──────────────────────────────────────────────────────────────

fn csv_encode(rows) {
    let result = "";
    for i in 0 to len(rows) - 1 {
        let row = rows[i];
        let line = "";
        for j in 0 to len(row) - 1 {
            let cell = str(row[j]);
            // Quote if it contains comma/quote/CR/newline, or is non-empty
            // whitespace only (an unquoted whitespace line would be skipped
            // as blank by csv_decode and the row would vanish).
            if str_contains(cell, ",") or str_contains(cell, "\"")
               or str_contains(cell, "\n") or str_contains(cell, "\r")
               or (cell != "" and str_trim(cell) == "") {
                cell = "\"" + str_replace_all(cell, "\"", "\"\"") + "\"";
            }
            if j > 0 { line = line + ","; }
            line = line + cell;
        }
        // A row whose only field is empty would serialize to a blank line,
        // which csv_decode (and every CSV reader) drops. Emit "" instead so
        // the row survives the round trip.
        if line == "" and len(row) == 1 { line = "\"\""; }
        if i > 0 { result = result + "\n"; }
        result = result + line;
    }
    return result;
}

// Split into records BEFORE splitting on newlines: a newline inside a quoted
// field is data, not a record separator. Plain blank lines are skipped.
fn csv_decode(text) {
    let rows = [];
    let record = "";
    let in_q = false;
    let i = 0;
    let n = len(text);
    while i < n {
        let ch = str_slice(text, i, i + 1);
        if ch == "\"" { in_q = not in_q; }
        if ch == "\n" and in_q == false {
            if str_trim(record) != "" { push(rows, _csv_parse_line(_strip_cr(record))); }
            record = "";
        } else {
            record = record + ch;
        }
        i = i + 1;
    }
    if str_trim(record) != "" { push(rows, _csv_parse_line(_strip_cr(record))); }
    return rows;
}

// CRLF tolerance: a bare \r before the record break is a line-ending artifact.
// Data \r is always inside quotes (csv_encode quotes it), so this never eats it.
fn _strip_cr(record) {
    let n = len(record);
    if n > 0 and str_slice(record, n - 1, n) == "\r" { return str_slice(record, 0, n - 1); }
    return record;
}

fn _csv_parse_line(line) {
    let cells = [];
    let cell = "";
    let in_quotes = false;
    let i = 0;
    while i < len(line) {
        let ch = line[i];
        if in_quotes {
            if ch == "\"" {
                if i + 1 < len(line) and line[i + 1] == "\"" {
                    cell = cell + "\"";
                    i = i + 1;
                } else {
                    in_quotes = false;
                }
            } else {
                cell = cell + ch;
            }
        } else {
            if ch == "\"" {
                in_quotes = true;
            } else if ch == "," {
                push(cells, cell);
                cell = "";
            } else {
                cell = cell + ch;
            }
        }
        i = i + 1;
    }
    push(cells, cell);
    return cells;
}

// ── base64url (URL-safe, RFC 4648 §5, unpadded) ───────────────────────────────

fn base64url_encode(data) {
    let b = base64_encode(data);
    b = str_replace_all(b, "+", "-");
    b = str_replace_all(b, "/", "_");
    while str_ends_with(b, "=") { b = str_slice(b, 0, len(b) - 1); }
    return b;
}

fn base64url_decode(s) {
    s = str_replace_all(s, "-", "+");
    s = str_replace_all(s, "_", "/");
    let rem = len(s) % 4;
    if rem == 2 { s = s + "=="; }
    else if rem == 3 { s = s + "="; }
    return base64_decode(s);
}

// ── base32 bridge (RFC 4648; delegates to stdlib/base32.sapp) ──────────────────
let _b32 = import("stdlib:base32.sapp");
fn base32_encode(s) { return _b32.encode(s); }
fn base32_decode(s) { return _b32.decode(s); }

// ── Query strings (application/x-www-form-urlencoded) ──────────────────────────

// query_encode(params) — map → "k=v&k2=v2" with each part percent-encoded
// (keys are emitted in sorted order for deterministic output). Spaces become
// "+" — the application/x-www-form-urlencoded convention browsers use —
// while url_encode itself stays strict RFC 3986 (%20).
fn query_encode(params) {
    let ks = map_keys(params);
    let out = "";
    let i = 0;
    while i < len(ks) {
        if i > 0 { out = out + "&"; }
        out = out + _form_encode(str(ks[i])) + "=" + _form_encode(str(params[ks[i]]));
        i = i + 1;
    }
    return out;
}

fn _form_encode(s) {
    return str_replace_all(url_encode(s), "%20", "+");
}

// query_decode(qs) — "k=v&k2=v2" → map (last value wins on duplicate keys).
fn query_decode(qs) {
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        if pair != "" {
            let eq = str_index_of(pair, "=");
            if eq < 0 {
                out[url_decode(pair)] = "";
            } else {
                let k = url_decode(str_slice(pair, 0, eq));
                let v = url_decode(str_slice(pair, eq + 1, len(pair)));
                out[k] = v;
            }
        }
        i = i + 1;
    }
    return out;
}

// ── HTML entity escaping (XSS-relevant) ────────────────────────────────────────

// html_encode(s) — escape the five characters that matter for HTML/attribute
// contexts. & must be replaced first so the other entities aren't double-encoded.
fn html_encode(s) {
    let out = str_replace_all(s, "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    out = str_replace_all(out, "'", "&#39;");
    return out;
}

// html_decode(s) — inverse of html_encode (&amp; decoded last for symmetry).
fn html_decode(s) {
    let out = str_replace_all(s, "&lt;", "<");
    out = str_replace_all(out, "&gt;", ">");
    out = str_replace_all(out, "&quot;", "\"");
    out = str_replace_all(out, "&#39;", "'");
    out = str_replace_all(out, "&amp;", "&");
    return out;
}

// ── Base64 wrappers (delegate to builtins) ────────────────────────────────────

// Go through the byte-array base64 builtins: the same-named string builtin
// (base64_encode/_decode) is shadowed by these wrappers, and the previously-referenced
// base64_encode_builtin/base64_decode_builtin never existed, so these always threw.
fn base64_encode(data) {
    return base64_encode_bytes(str_to_bytes(data));
}

fn base64_decode(data) {
    return bytes_to_str(base64_decode_bytes(data));
}

// ── JSON wrappers ─────────────────────────────────────────────────────────────

fn json_encode(val) {
    return json_stringify(val);
}

fn json_decode(str) {
    return json_parse(str);
}

export hex_encode, hex_decode, url_encode, url_decode;
export csv_encode, csv_decode;
export base64_encode, base64_decode, base64url_encode, base64url_decode;
export base32_encode, base32_decode;
export query_encode, query_decode;
export html_encode, html_decode;
export json_encode, json_decode;
