// stdlib/cron.sapp — 5-field cron expression matching (pure, deterministic).
//
// Fields: "minute hour day-of-month month day-of-week". Each supports:
//   *            any value
//   n            exact value
//   a-b          inclusive range
//   */n          every n (from 0)
//   a-b/n        every n within a range
//   a,b,c        comma list of any of the above
//
//   let cron = import("stdlib:cron.sapp");
//   cron.matches("*/15 9-17 * * 1-5", map{minute:30,hour:10,day:5,month:6,weekday:2});
//   // -> true (every 15 min, 9am-5pm, Mon-Fri)
// A scheduler can call matches() once per minute with the current time fields.

fn _uint(text) {
    if type(text) != "string" or text == "" { return -1; }
    for i len(text) {
        let code = strcharcodeat(text, i);
        if code < 48 or code > 57 { return -1; }
    }
    return try parse_number(text) catch -1;
}

fn _validate_one(part, minimum, maximum) {
    if part == "" { return map{ ok: false, reason: "empty list item" }; }
    let slash_parts = str_split(part, "/");
    if len(slash_parts) > 2 or slash_parts[0] == "" {
        return map{ ok: false, reason: "invalid step syntax" };
    }
    let step = 1;
    if len(slash_parts) == 2 {
        step = _uint(slash_parts[1]);
        if step < 1 or step > maximum - minimum + 1 {
            return map{ ok: false, reason: "step is outside its field range" };
        }
    }
    let range = slash_parts[0];
    if range == "*" { return map{ ok: true }; }
    let range_parts = str_split(range, "-");
    if len(range_parts) > 2 { return map{ ok: false, reason: "invalid range syntax" }; }
    if len(slash_parts) == 2 and len(range_parts) == 1 {
        return map{ ok: false, reason: "steps require wildcard or explicit range syntax" };
    }
    let low = _uint(range_parts[0]);
    let high = if len(range_parts) == 2 { _uint(range_parts[1]) } else { low };
    if low < 0 or high < 0 { return map{ ok: false, reason: "field values must be decimal integers" }; }
    if low < minimum or low > maximum or high < minimum or high > maximum {
        return map{ ok: false, reason: "field value is outside its allowed range" };
    }
    if low > high { return map{ ok: false, reason: "range start exceeds range end" }; }
    return map{ ok: true };
}

fn validate_field(spec, minimum, maximum) {
    if type(spec) != "string" or spec == "" { return map{ ok: false, reason: "field is empty" }; }
    let parts = str_split(spec, ",");
    for i len(parts) {
        let result = _validate_one(parts[i], minimum, maximum);
        if not result.ok { result.list_index = i; return result; }
    }
    return map{ ok: true };
}

fn _one(p, value) {
    let step = 1;
    let rangepart = p;
    let slash = str_index_of(p, "/");
    if slash >= 0 {
        let parsed_step = _uint(str_slice(p, slash + 1, len(p)));
        rangepart = str_slice(p, 0, slash);
        if parsed_step < 0 { return false; }
        step = parsed_step;
        if step < 1 { return false; }
    }
    if rangepart == "*" {
        if step <= 1 { return true; }
        return num_mod(value, step) == 0;
    }
    let lo = -1;
    let hi = -1;
    let dash = str_index_of(rangepart, "-");
    if dash >= 0 {
        lo = _uint(str_slice(rangepart, 0, dash));
        hi = _uint(str_slice(rangepart, dash + 1, len(rangepart)));
    } else {
        lo = _uint(rangepart);
        hi = lo;
    }
    if lo < 0 or hi < 0 { return false; }
    if value < lo or value > hi { return false; }
    return num_mod(value - lo, step) == 0;
}

// field_matches(spec, value) — does one cron field (with commas) match a number?
fn field_matches(spec, value) {
    let parts = str_split(spec, ",");
    let i = 0;
    while i < len(parts) {
        if _one(str_trim(parts[i]), value) { return true; }
        i = i + 1;
    }
    return false;
}

fn _fields(expr) {
    let raw = str_split(str_trim(expr), " ");
    let out = [];
    let i = 0;
    while i < len(raw) { if raw[i] != "" { array_push(out, raw[i]); } i = i + 1; }
    return out;
}

fn validate(expr) {
    if type(expr) != "string" or len(expr) > 256 {
        return map{ ok: false, reason: "expression must be a string of at most 256 characters" };
    }
    let fields = _fields(expr);
    if len(fields) != 5 { return map{ ok: false, reason: "expression must contain exactly five fields" }; }
    let ranges = [[0,59], [0,23], [1,31], [1,12], [0,7]];
    let names = ["minute", "hour", "day-of-month", "month", "day-of-week"];
    for i 5 {
        let result = validate_field(fields[i], ranges[i][0], ranges[i][1]);
        if not result.ok {
            result.field_index = i; result.field = names[i]; result.expression = expr;
            return result;
        }
    }
    return map{ ok: true, expression: str_join(fields, " "), fields: fields };
}

// is_valid(expr) — complete five-field grammar and domain validation.
fn is_valid(expr) { return validate(expr).ok; }

// matches(expr, t) — does the cron expr fire at time t? t = map{minute,hour,day,month,weekday}.
// (day = day-of-month 1..31, weekday = 0..6 with 0=Sunday — match datetime.weekday.)
fn matches(expr, t) {
    let checked = validate(expr);
    if not checked.ok { return false; }
    let f = checked.fields;
    return field_matches(f[0], t.minute)
       and field_matches(f[1], t.hour)
       and field_matches(f[2], t.day)
       and field_matches(f[3], t.month)
       and (field_matches(f[4], t.weekday)
            or (t.weekday == 0 and field_matches(f[4], 7)));
}

export matches, field_matches, validate_field, validate, is_valid;
