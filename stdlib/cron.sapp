// stdlib/cron.sapp — 5-field cron expression matching (pure, deterministic).
//
// Fields: "minute hour day-of-month month day-of-week". Each supports:
//   *            any value
//   n            exact value
//   a-b          inclusive range
//   */n          every n (from 0)
//   a-b/n        every n within a range
//   a,b,c        comma list of any of the above
//
//   let cron = import("stdlib:cron.sapp");
//   cron.matches("*/15 9-17 * * 1-5", map{minute:30,hour:10,day:5,month:6,weekday:2});
//   // -> true (every 15 min, 9am-5pm, Mon-Fri)
// A scheduler can call matches() once per minute with the current time fields.

fn _one(p, value) {
    let step = 1;
    let rangepart = p;
    let slash = str_index_of(p, "/");
    if slash >= 0 {
        step = parse_number(str_slice(p, slash + 1, len(p)));
        rangepart = str_slice(p, 0, slash);
        if step == nil or step < 1 { return false; }
    }
    if rangepart == "*" {
        if step <= 1 { return true; }
        return num_mod(value, step) == 0;
    }
    let lo = nil;
    let hi = nil;
    let dash = str_index_of(rangepart, "-");
    if dash >= 0 {
        lo = parse_number(str_slice(rangepart, 0, dash));
        hi = parse_number(str_slice(rangepart, dash + 1, len(rangepart)));
    } else {
        lo = parse_number(rangepart);
        hi = lo;
    }
    if lo == nil or hi == nil { return false; }
    if value < lo or value > hi { return false; }
    return num_mod(value - lo, step) == 0;
}

// field_matches(spec, value) — does one cron field (with commas) match a number?
fn field_matches(spec, value) {
    let parts = str_split(spec, ",");
    let i = 0;
    while i < len(parts) {
        if _one(str_trim(parts[i]), value) { return true; }
        i = i + 1;
    }
    return false;
}

fn _fields(expr) {
    let raw = str_split(str_trim(expr), " ");
    let out = [];
    let i = 0;
    while i < len(raw) { if raw[i] != "" { array_push(out, raw[i]); } i = i + 1; }
    return out;
}

// is_valid(expr) — exactly 5 non-empty fields.
fn is_valid(expr) { return len(_fields(expr)) == 5; }

// matches(expr, t) — does the cron expr fire at time t? t = map{minute,hour,day,month,weekday}.
// (day = day-of-month 1..31, weekday = 0..6 with 0=Sunday — match datetime.weekday.)
fn matches(expr, t) {
    let f = _fields(expr);
    if len(f) != 5 { return false; }
    return field_matches(f[0], t.minute)
       and field_matches(f[1], t.hour)
       and field_matches(f[2], t.day)
       and field_matches(f[3], t.month)
       and field_matches(f[4], t.weekday);
}

export matches, field_matches, is_valid;
