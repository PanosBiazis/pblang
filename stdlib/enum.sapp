// stdlib/enum.sapp — Algebraic data types (sum types / tagged unions) for pblang.
//
// Usage:
//   let en = import("stdlib:enum.sapp");
//
//   let Color = en.define("Color", ["Red", "Green", "Blue"]);
//   let c = en.variant(Color, "Red");
//   en.match(c, map{
//       Red:   fn() { return "red!"; },
//       Green: fn() { return "green!"; },
//       Blue:  fn() { return "blue!"; },
//       _:     fn() { return "unknown"; }
//   });
//
//   // Option type (built-in):
//   let opt = en.some(42);
//   print en.is_some(opt);    // true
//   print en.unwrap(opt);     // 42
//
//   // Result type (built-in):
//   let res = en.ok(100);
//   print en.is_ok(res);      // true

// define(name, variants_array) — define an enum type
fn define(name, variants) {
    if type(variants) != "array" {
        return error("enum.define: variants must be an array of strings");
    }
    let variant_set = map{};
    for i len(variants) {
        variant_set[variants[i]] = true;
    }
    return map{
        __enum_name: name,
        __variants: variants,
        __variant_set: variant_set,
        __is_enum_def: true
    };
}

// variant(enum_type, variant_name, value) — create a tagged value
fn variant(enum_type, variant_name, value) {
    // Validate variant exists in the enum
    let variant_set = try enum_type.__variant_set catch nil;
    if variant_set != nil {
        if map_has(variant_set, variant_name) == false {
            return error("enum.variant: '" + variant_name + "' is not a valid variant of " + str(enum_type.__enum_name));
        }
    }
    return map{
        __enum_name: try enum_type.__enum_name catch "unknown",
        __variant: variant_name,
        __value: value,
        __is_enum_value: true
    };
}

// match(value, handlers_map) — pattern match on an enum value
// handlers_map: { VariantName: fn() { ... }, _: fn() { ... } }
fn match(value, handlers) {
    if type(value) != "map" {
        return error("enum.match: value must be an enum variant");
    }
    let variant_name = try value.__variant catch nil;
    if variant_name == nil {
        return error("enum.match: value is not an enum variant");
    }

    // Try exact match
    let handler = try handlers[variant_name] catch nil;
    if handler != nil { return handler(); }

    // Try wildcard
    let wildcard = try handlers._ catch nil;
    if wildcard != nil { return wildcard(); }

    return error("enum.match: no handler for variant '" + variant_name + "'");
}

// variant_name(value) — get the variant name
fn variant_name(value) {
    return try value.__variant catch nil;
}

// variant_value(value) — get the payload
fn variant_value(value) {
    return try value.__value catch nil;
}

// is_variant(value, name) — check if value is a specific variant
fn is_variant(value, name) {
    if type(value) != "map" { return false; }
    return (try value.__variant catch nil) == name;
}

// ── Option type ───────────────────────────────────────────────────────────────

// some(v) — wrap a value in Option::Some
fn some(v) {
    return map{ __variant: "Some", __value: v, __is_option: true };
}

// none() — create Option::None
fn none() {
    return map{ __variant: "None", __value: nil, __is_option: true };
}

// is_some(opt) — true if opt is Some
fn is_some(opt) {
    if type(opt) != "map" { return false; }
    return (try opt.__variant catch nil) == "Some";
}

// is_none(opt) — true if opt is None
fn is_none(opt) {
    if type(opt) != "map" { return true; }
    return (try opt.__variant catch nil) == "None";
}

// unwrap(opt) — extract value or error
fn unwrap(opt) {
    if is_some(opt) { return opt.__value; }
    return error("enum.unwrap: called on None");
}

// unwrap_or(opt, default_val) — extract value or return default
fn unwrap_or(opt, default_val) {
    if is_some(opt) { return opt.__value; }
    return default_val;
}

// map_opt(opt, fn) — transform Some value, pass None through
fn map_opt(opt, fn_) {
    if is_some(opt) { return some(fn_(opt.__value)); }
    return opt;
}

// and_then(opt, fn) — flatMap for Option
fn and_then(opt, fn_) {
    if is_some(opt) { return fn_(opt.__value); }
    return opt;
}

// ── Result type ───────────────────────────────────────────────────────────────

// ok(v) — wrap value in Result::Ok
fn ok(v) {
    return map{ __variant: "Ok", __value: v, __is_result: true };
}

// err(e) — wrap error in Result::Err
fn err(e) {
    return map{ __variant: "Err", __error: e, __is_result: true };
}

// is_ok(res) — true if Ok
fn is_ok(res) {
    if type(res) != "map" { return false; }
    return (try res.__variant catch nil) == "Ok";
}

// is_err(res) — true if Err
fn is_err(res) {
    if type(res) != "map" { return true; }
    return (try res.__variant catch nil) == "Err";
}

// unwrap_ok(res) — get Ok value or error
fn unwrap_ok(res) {
    if is_ok(res) { return res.__value; }
    return error("enum.unwrap_ok: got Err: " + str(try res.__error catch "unknown"));
}

// unwrap_err(res) — get Err value or error
fn unwrap_err(res) {
    if is_err(res) { return res.__error; }
    return error("enum.unwrap_err: got Ok");
}

// result_ok_or(value, err_value) — convert nullable to Result
fn result_ok_or(value, err_value) {
    if value == nil { return err(err_value); }
    return ok(value);
}

// map_res(res, fn) — transform Ok value
fn map_res(res, fn_) {
    if is_ok(res) { return ok(fn_(res.__value)); }
    return res;
}

export define, variant, match, variant_name, variant_value, is_variant,
       some, none, is_some, is_none, unwrap, unwrap_or, map_opt, and_then,
       ok, err, is_ok, is_err, unwrap_ok, unwrap_err, result_ok_or, map_res;
