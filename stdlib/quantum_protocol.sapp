// stdlib/quantum_protocol.sapp — In-memory quantum job queue (Q2)

let _jobs = map{};
let _next_id = 0;

fn _simulate(spec) {
    let sim = import("stdlib:quantum_sim.sapp");
    let n = try spec.n catch 1;
    let state = sim.zero_state(n);
    let ops = try spec.ops catch [];
    let i = 0;
    while i < len(ops) {
        let op = ops[i];
        let gate = try op.gate catch "i";
        let q = try op.q catch 0;
        if gate == "h" { state = sim.h_gate(state, q); }
        else if gate == "x" { state = sim.x_gate(state, q); }
        else if gate == "y" { state = sim.y_gate(state, q); }
        else if gate == "z" { state = sim.z_gate(state, q); }
        else if gate == "cx" {
            let ctrl = try op.control catch 0;
            let tgt = try op.target catch 1;
            state = sim.cnot_gate(state, ctrl, tgt);
        }
        i = i + 1;
    }
    let measurements = [];
    let qq = 0;
    while qq < n {
        array_push(measurements, sim.measure(state, qq));
        qq = qq + 1;
    }
    return map{ measurements: measurements };
}

fn submit(spec) {
    let job_id = str(_next_id);
    _next_id = _next_id + 1;
    let result = _simulate(spec);
    let job = map{ job_id: job_id, status: "completed", result: result };
    _jobs[job_id] = job;
    return job;
}

fn poll(job_id) {
    let job = try _jobs[str(job_id)] catch nil;
    if job == nil { return map{ status: "not_found" }; }
    return job;
}

fn submit_remote(endpoint, spec) { return submit(spec); }
fn poll_remote(endpoint, job_id) { return poll(job_id); }

export submit, poll, submit_remote, poll_remote;
