// Pure weighted capacity over an explicit half-open window; no calendar or device I/O.
let I=import("stdlib:interval_analysis.sapp");
let MAX_RESOURCES=32;let MAX_BOOKINGS=128;let MAX_UNITS=10000;
fn _id(value) {
 return type(value)=="string" and len(value)>0 and len(value)<=64 and len(str_to_bytes(value))<=128 and not str_contains(value,"\u0000");
}
fn _units(value) {return type(value)=="number" and value>=1 and value<=MAX_UNITS and value==num_floor(value);}
fn analyze(resources,bookings,window) {
 I.validate([window]);
 if type(resources)!="array" or len(resources)<1 or len(resources)>MAX_RESOURCES {throw "capacity: resource limit";}
 if type(bookings)!="array" or len(bookings)>MAX_BOOKINGS {throw "capacity: booking limit";}
 let known=map{};let ids=map{};let intervals=[];
 for resource in resources {
  if type(resource)!="map" or len(resource)!=2 or not _id(try resource.id catch nil) or not _units(try resource.capacity catch nil) {throw "capacity: invalid resource";}
  if map_has(known,resource.id) {throw "capacity: duplicate resource";}
  known[resource.id]=true;
 }
 for booking in bookings {
  if type(booking)!="map" or len(booking)!=5 or not _id(try booking.id catch nil) or not _id(try booking.resource catch nil) or not _units(try booking.units catch nil) or not map_has(booking,"start_ms") or not map_has(booking,"end_ms") {throw "capacity: invalid booking";}
  if map_has(ids,booking.id) or not map_has(known,booking.resource) {throw "capacity: duplicate booking or unknown resource";}
  ids[booking.id]=true;array_push(intervals,map{start_ms:booking.start_ms,end_ms:booking.end_ms});
 }
 I.validate(intervals);
 for booking in bookings {if booking.start_ms<window.start_ms or booking.end_ms>window.end_ms {throw "capacity: booking outside window";}}
 let reports=[];let overloaded_resources=0;
 for resource in resources {
  let selected=[];let points=[window.start_ms,window.end_ms];
  for booking in bookings {if booking.resource==resource.id {array_push(selected,booking);array_push(points,booking.start_ms);array_push(points,booking.end_ms);}}
  points=array_sort(points);let segments=[];let peak=0;let used=0;let overload=0;let shortfall=0;
  for index in range(0,len(points)-1) {
   let start=points[index];let end=points[index+1];
   if start<end {
    let load=0;let active=[];
    for booking in selected {if booking.start_ms<=start and start<booking.end_ms {load=load+booking.units;array_push(active,booking.id);}}
    let duration=end-start;let excess=num_max(0,load-resource.capacity);
    peak=num_max(peak,load);used=used+load*duration;shortfall=shortfall+excess*duration;
    if excess>0 {overload=overload+duration;}
    array_push(segments,map{start_ms:start,end_ms:end,load:load,excess:excess,booking_ids:active});
   }
  }
  if overload>0 {overloaded_resources=overloaded_resources+1;}
  array_push(reports,map{id:resource.id,capacity:resource.capacity,peak_units:peak,used_unit_ms:used,available_unit_ms:resource.capacity*(window.end_ms-window.start_ms),overload_ms:overload,shortfall_unit_ms:shortfall,segments:segments});
 }
 return map{format:"pblang.resource-capacity.v1",window:map{start_ms:window.start_ms,end_ms:window.end_ms},resources:reports,overloaded_resources:overloaded_resources,contains_input_identifiers:true};
}
export MAX_RESOURCES,MAX_BOOKINGS,MAX_UNITS,analyze;
