let L=import("stdlib:divider_load.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let File=import("stdlib:secure_file.sapp");
fn _number(value) {return str((if value<0 {num_ceil(value*1000000-0.5)} else {num_floor(value*1000000+0.5)})/1000000);}
fn _lines(report,start,end) {
 let lines=["Load ohm | Output V | Load mA | Load mW"];
 for i in range(start,end) {let r=report.rows[i];array_push(lines,_number(r.load_ohms)+" | "+_number(r.loaded_vout)+" | "+_number(r.load_current_amperes*1000)+" | "+_number(r.load_power_watts*1000));}return str_join(lines,"\n");
}
fn view(vin=5,top=1000,bottom=1000,low=1000,high=10000,count=5,page=0) {
 let report=L.sweep(vin,top,bottom,L.linear_loads(low,high,count));let pages=num_ceil(count/3);
 if type(page)!="number" or not(page>=0 and page<pages) or page!=num_floor(page) {throw "invalid result page";}
 let text=_lines(report,page*3,num_min(count,page*3+3));
 return UI.screen([UI.heading("PBLoadLab"),UI.text("Ideal loaded divider | page "+str(page+1)+" / "+str(pages)),
 UI.text("Supply "+_number(vin)+" V | R1 "+_number(top)+" ohm | R2 "+_number(bottom)+" ohm"),
 UI.area(text,map{name:"rows",readonly:true,h:220}),UI.row([UI.button("Show",UI.action_set_text("rows",text)),UI.button("Hide",UI.action_set_text("rows","Results hidden."))]),
 UI.text("Rounded display. Fixed ideal resistors; no tolerance or hardware measurements.")]);
}
fn _status(form,text) {let w=G.get(form,"status");w.text=text;form.dirty=true;}
fn _inputs(form) {let values=[];for key in ["vin","top","bottom","low","high","count"] {array_push(values,parse_number(G.get(form,key).value));}return values;}
fn calculate(form,state) {
 let values=try _inputs(form) catch nil;let result=nil;
 if values!=nil {result=try L.sweep(values[0],values[1],values[2],L.linear_loads(values[3],values[4],values[5])) catch nil;}
 let body=G.get(form,"rows");let summary=G.get(form,"summary");
 if result==nil {state.values=nil;state.report=nil;body.value="";summary.text="";_status(form,"Use +/-1000 V, 1..1000000 ohms, low <= high and 2..32 samples.");return;}
 state.values=values;state.report=result;body.value=_lines(result,0,len(result.rows));summary.text="Unloaded output: "+_number(result.rows[0].unloaded_vout)+" V | "+str(len(result.rows))+" load samples";_status(form,"Calculated. Display rounded to six decimals; CSV retains numeric precision.");
}
fn save(form,state) {
 let values=try _inputs(form) catch nil;
 if state.values==nil or values!=state.values {_status(form,"Calculate the current inputs before exporting.");return;}
 let path=G.get(form,"path").value;
 if type(path)!="string" or len(str_to_bytes(path))>4096 or len(path)<=4 or not str_ends_with(str_lower(path),".csv") {_status(form,"Choose a new .csv filename.");return;}
 let text=L.to_csv(values[0],values[1],values[2],L.linear_loads(values[3],values[4],values[5]));let saved=try File.write_text_new_exclusive(path,text,false,false) catch nil;
 if saved==nil or not saved.ok {_status(form,"Save not confirmed; use a new filename. Failed new copies may be incomplete.");return;}
 _status(form,"New CSV saved.");
}
fn build() {
 let state=map{values:nil,report:nil};let form=UI.build("PBLoadLab",UI.screen([
 UI.heading("PBLoadLab - divider load comparison"),UI.text("R1: supply to output. R2 and load: output to ground. Ideal DC model."),
 UI.text("Supply (V) / R1 (ohm) / R2 (ohm)"),UI.row([UI.input("5",map{name:"vin",max_chars:24}),UI.input("1000",map{name:"top",max_chars:24}),UI.input("1000",map{name:"bottom",max_chars:24})]),
 UI.text("First load (ohm) / Last load (ohm) / Samples (2..32, linear spacing)"),UI.row([UI.input("1000",map{name:"low",max_chars:24}),UI.input("10000",map{name:"high",max_chars:24}),UI.input("5",map{name:"count",max_chars:2})]),
 UI.button("Calculate",fn(f){calculate(f,state);},map{name:"calculate"}),UI.text("",map{name:"summary"}),UI.area("",map{name:"rows",readonly:true,h:360}),
 UI.input("",map{name:"path",max_chars:4096,placeholder:"New .csv output path"}),UI.button("Export CSV",fn(f){save(f,state);},map{name:"save"}),UI.text("",map{name:"status"}),
 UI.text("Educational results. No tolerance, power-rating checks or hardware access.")]),map{width:1100,height:1050,theme:"dark"});calculate(form,state);return map{form:form,state:state};
}
fn run() {let e=build();G.run(e.form,map{ordered_input:true});}
export view,calculate,save,build,run;
