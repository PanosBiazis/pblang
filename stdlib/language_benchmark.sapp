// stdlib/language_benchmark.sapp -- correctness-gated cross-language fixtures.
// Every implementation performs the same algorithm and prints one checksum.
// Timings include process startup and are intended for local, reproducible A/B
// work, not universal ranking claims across unrelated hosts or toolchain builds.

let BENCH = import("stdlib:benchmark.sapp");
let _seq = 0;
let _command_cache = map{};

fn _lang(id, name, commands, ext, before = nil, after = nil) {
    return map{
        id: id, name: name, commands: commands, extension: ext,
        args_before: before ?? [], args_after: after ?? []
    };
}

fn languages() {
    return [
        _lang("pblang", "pblang interpreter", ["target/release/pblang", "target/debug/pblang", "pblang"], "sapp", ["run"], ["--allow-all"]),
        _lang("python", "Python", ["python3", "python"], "py"),
        _lang("javascript", "JavaScript/Node", ["node"], "js"),
        _lang("ruby", "Ruby", ["ruby"], "rb"),
        _lang("perl", "Perl", ["perl"], "pl"),
        _lang("lua", "Lua", ["lua", "lua5.4", "lua5.3"], "lua"),
        _lang("php", "PHP", ["php"], "php"),
        _lang("tcl", "Tcl", ["tclsh"], "tcl"),
        _lang("awk", "AWK", ["gawk", "mawk", "awk"], "awk", ["-f"]),
        _lang("bash", "Bash", ["bash"], "sh"),
        _lang("r", "R", ["Rscript"], "r"),
        _lang("julia", "Julia", ["julia"], "jl"),
        _lang("raku", "Raku", ["raku", "perl6"], "raku"),
        _lang("dart", "Dart", ["dart"], "dart"),
        _lang("swift", "Swift", ["swift"], "swift")
    ];
}

fn categories() {
    return ["startup", "recursion", "integer_loop", "array", "string", "hash_map"];
}

fn _fib(n) { if n < 2 { return n; } return _fib(n - 1) + _fib(n - 2); }
fn _integer_checksum(n) { let s = 0; let i = 0; while i < n { s = (s + (i % 1000) * 17 + 3) % 1000003; i = i + 1; } return s; }
fn _array_checksum(n) { let s = 0; let i = 0; while i < n { s = s + (i % 97); i = i + 1; } return s; }
fn _map_checksum(n) { let s = 0; let i = 0; while i < n { s = s + (i % 101); i = i + 1; } return s; }

fn expected(category) {
    if category == "startup" { return "1"; }
    if category == "recursion" { return str(_fib(22)); }
    if category == "integer_loop" { return str(_integer_checksum(100000)); }
    if category == "array" { return str(_array_checksum(20000)); }
    if category == "string" { return "10000"; }
    if category == "hash_map" { return str(_map_checksum(5000)); }
    throw "language_benchmark.expected: unknown category " + str(category);
}

fn _pblang(category) {
    if category == "startup" { return "print 1;\n"; }
    if category == "recursion" { return "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(22);\n"; }
    if category == "integer_loop" { return "let i = 0; let s = 0; while i < 100000 { s = (s + (i % 1000) * 17 + 3) % 1000003; i = i + 1; } print s;\n"; }
    if category == "array" { return "let a = []; let i = 0; while i < 20000 { push(a, i % 97); i = i + 1; } let s = 0; i = 0; while i < len(a) { s = s + a[i]; i = i + 1; } print s;\n"; }
    if category == "string" { return "let s = \"\"; let i = 0; while i < 5000 { s = s + \"ab\"; i = i + 1; } print len(s);\n"; }
    return "let m = map{}; let i = 0; while i < 5000 { m[str(i)] = i % 101; i = i + 1; } let s = 0; i = 0; while i < 5000 { s = s + m[str(i)]; i = i + 1; } print s;\n";
}

fn _python(category) {
    if category == "startup" { return "print(1)\n"; }
    if category == "recursion" { return "def fib(n): return n if n < 2 else fib(n-1)+fib(n-2)\nprint(fib(22))\n"; }
    if category == "integer_loop" { return "s=0\nfor i in range(100000): s=(s+(i%1000)*17+3)%1000003\nprint(s)\n"; }
    if category == "array" { return "a=[i%97 for i in range(20000)]\nprint(sum(a))\n"; }
    if category == "string" { return "s=''\nfor i in range(5000): s += 'ab'\nprint(len(s))\n"; }
    return "m={str(i):i%101 for i in range(5000)}\nprint(sum(m[str(i)] for i in range(5000)))\n";
}

fn _javascript(category) {
    if category == "startup" { return "console.log(1);\n"; }
    if category == "recursion" { return "function fib(n){return n<2?n:fib(n-1)+fib(n-2)} console.log(fib(22));\n"; }
    if category == "integer_loop" { return "let s=0; for(let i=0;i<100000;i++) s=(s+(i%1000)*17+3)%1000003; console.log(s);\n"; }
    if category == "array" { return "let a=[]; for(let i=0;i<20000;i++) a.push(i%97); let s=0; for(const v of a)s+=v; console.log(s);\n"; }
    if category == "string" { return "let s=''; for(let i=0;i<5000;i++)s+='ab'; console.log(s.length);\n"; }
    return "let m=new Map(); for(let i=0;i<5000;i++)m.set(String(i),i%101); let s=0; for(let i=0;i<5000;i++)s+=m.get(String(i)); console.log(s);\n";
}

fn _ruby(category) {
    if category == "startup" { return "puts 1\n"; }
    if category == "recursion" { return "def fib(n); n<2 ? n : fib(n-1)+fib(n-2); end\nputs fib(22)\n"; }
    if category == "integer_loop" { return "s=0\n100000.times{|i|s=(s+(i%1000)*17+3)%1000003}\nputs s\n"; }
    if category == "array" { return "a=Array.new(20000){|i|i%97}\nputs a.sum\n"; }
    if category == "string" { return "s=''\n5000.times{s << 'ab'}\nputs s.length\n"; }
    return "m={}\n5000.times{|i|m[i.to_s]=i%101}\ns=0\n5000.times{|i|s+=m[i.to_s]}\nputs s\n";
}

fn _perl(category) {
    if category == "startup" { return "print 1,qq(\\n);\n"; }
    if category == "recursion" { return "sub fib{my $n=shift;return $n<2?$n:fib($n-1)+fib($n-2)} print fib(22),qq(\\n);\n"; }
    if category == "integer_loop" { return "my $s=0;for(my $i=0;$i<100000;$i++){$s=($s+($i%1000)*17+3)%1000003}print $s,qq(\\n);\n"; }
    if category == "array" { return "my @a=map {$_%97} (0..19999);my $s=0;$s+=$_ for @a;print $s,qq(\\n);\n"; }
    if category == "string" { return "my $s='';$s.='ab' for (1..5000);print length($s),qq(\\n);\n"; }
    return "my %m;for(my $i=0;$i<5000;$i++){$m{$i}=$i%101}my $s=0;for(my $i=0;$i<5000;$i++){$s+=$m{$i}}print $s,qq(\\n);\n";
}

fn _lua(category) {
    if category == "startup" { return "print(1)\n"; }
    if category == "recursion" { return "local function fib(n) if n<2 then return n end return fib(n-1)+fib(n-2) end print(fib(22))\n"; }
    if category == "integer_loop" { return "local s=0 for i=0,99999 do s=(s+(i%1000)*17+3)%1000003 end print(s)\n"; }
    if category == "array" { return "local a={} for i=0,19999 do a[#a+1]=i%97 end local s=0 for i=1,#a do s=s+a[i] end print(s)\n"; }
    if category == "string" { return "local s='' for i=1,5000 do s=s..'ab' end print(#s)\n"; }
    return "local m={} for i=0,4999 do m[tostring(i)]=i%101 end local s=0 for i=0,4999 do s=s+m[tostring(i)] end print(s)\n";
}

fn _php(category) {
    if category == "startup" { return "<?php echo 1,PHP_EOL;\n"; }
    if category == "recursion" { return "<?php function fib($n){return $n<2?$n:fib($n-1)+fib($n-2);} echo fib(22),PHP_EOL;\n"; }
    if category == "integer_loop" { return "<?php $s=0;for($i=0;$i<100000;$i++)$s=($s+($i%1000)*17+3)%1000003;echo $s,PHP_EOL;\n"; }
    if category == "array" { return "<?php $a=[];for($i=0;$i<20000;$i++)$a[]=$i%97;echo array_sum($a),PHP_EOL;\n"; }
    if category == "string" { return "<?php $s='';for($i=0;$i<5000;$i++)$s.='ab';echo strlen($s),PHP_EOL;\n"; }
    return "<?php $m=[];for($i=0;$i<5000;$i++)$m[(string)$i]=$i%101;$s=0;for($i=0;$i<5000;$i++)$s+=$m[(string)$i];echo $s,PHP_EOL;\n";
}

fn _tcl(category) {
    if category == "startup" { return "puts 1\n"; }
    if category == "recursion" { return "proc fib {n} {if {$n<2} {return $n}; return [expr {[fib [expr {$n-1}]]+[fib [expr {$n-2}]]}]}\nputs [fib 22]\n"; }
    if category == "integer_loop" { return "set s 0\nfor {set i 0} {$i<100000} {incr i} {set s [expr {($s+($i%1000)*17+3)%1000003}]}\nputs $s\n"; }
    if category == "array" { return "set a {}\nfor {set i 0} {$i<20000} {incr i} {lappend a [expr {$i%97}]}\nset s 0\nforeach v $a {incr s $v}\nputs $s\n"; }
    if category == "string" { return "set s {}\nfor {set i 0} {$i<5000} {incr i} {append s ab}\nputs [string length $s]\n"; }
    return "set m [dict create]\nfor {set i 0} {$i<5000} {incr i} {dict set m $i [expr {$i%101}]}\nset s 0\nfor {set i 0} {$i<5000} {incr i} {incr s [dict get $m $i]}\nputs $s\n";
}

fn _awk(category) {
    if category == "startup" { return "BEGIN{print 1}\n"; }
    if category == "recursion" { return "function fib(n){return n<2?n:fib(n-1)+fib(n-2)} BEGIN{print fib(22)}\n"; }
    if category == "integer_loop" { return "BEGIN{s=0;for(i=0;i<100000;i++)s=(s+(i%1000)*17+3)%1000003;print s}\n"; }
    if category == "array" { return "BEGIN{for(i=0;i<20000;i++)a[i]=i%97;s=0;for(i=0;i<20000;i++)s+=a[i];print s}\n"; }
    if category == "string" { return "BEGIN{s=\"\";for(i=0;i<5000;i++)s=s \"ab\";print length(s)}\n"; }
    return "BEGIN{for(i=0;i<5000;i++)m[\"k\" i]=i%101;s=0;for(i=0;i<5000;i++)s+=m[\"k\" i];print s}\n";
}

fn _bash(category) {
    if category == "startup" { return "printf '%s\\n' 1\n"; }
    if category == "recursion" { return "fib(){ local n=$1; if ((n<2));then REPLY=$n;return;fi;fib $((n-1));local a=$REPLY;fib $((n-2));REPLY=$((a+REPLY));}\nfib 22;printf '%s\\n' \"$REPLY\"\n"; }
    if category == "integer_loop" { return "s=0;for ((i=0;i<100000;i++));do s=$(((s+(i%1000)*17+3)%1000003));done;printf '%s\\n' \"$s\"\n"; }
    if category == "array" { return "a=();for ((i=0;i<20000;i++));do a[i]=$((i%97));done;s=0;for v in \"${a[@]}\";do s=$((s+v));done;printf '%s\\n' \"$s\"\n"; }
    if category == "string" { return "s='';for ((i=0;i<5000;i++));do s+='ab';done;printf '%s\\n' \"${#s}\"\n"; }
    return "declare -A m;for ((i=0;i<5000;i++));do m[$i]=$((i%101));done;s=0;for ((i=0;i<5000;i++));do s=$((s+m[$i]));done;printf '%s\\n' \"$s\"\n";
}

fn _r(category) {
    if category == "startup" { return "cat(1,'\\n')\n"; }
    if category == "recursion" { return "fib<-function(n)if(n<2)n else fib(n-1)+fib(n-2)\ncat(fib(22),'\\n')\n"; }
    if category == "integer_loop" { return "s<-0\nfor(i in 0:99999)s<-(s+(i%%1000)*17+3)%%1000003\ncat(s,'\\n')\n"; }
    if category == "array" { return "a<-(0:19999)%%97\ncat(sum(a),'\\n')\n"; }
    if category == "string" { return "s<-''\nfor(i in 1:5000)s<-paste0(s,'ab')\ncat(nchar(s),'\\n')\n"; }
    return "m<-new.env(hash=TRUE,parent=emptyenv())\nfor(i in 0:4999)assign(as.character(i),i%%101,envir=m)\ns<-0\nfor(i in 0:4999)s<-s+get(as.character(i),envir=m)\ncat(s,'\\n')\n";
}

fn _julia(category) {
    if category == "startup" { return "println(1)\n"; }
    if category == "recursion" { return "fib(n)=n<2 ? n : fib(n-1)+fib(n-2)\nprintln(fib(22))\n"; }
    if category == "integer_loop" { return "s=0\nfor i=0:99999 global s=(s+(i%1000)*17+3)%1000003 end\nprintln(s)\n"; }
    if category == "array" { return "a=[i%97 for i=0:19999]\nprintln(sum(a))\n"; }
    if category == "string" { return "s=\"\"\nfor i=1:5000 global s*=\"ab\" end\nprintln(length(s))\n"; }
    return "m=Dict{String,Int}()\nfor i=0:4999 m[string(i)]=i%101 end\ns=0\nfor i=0:4999 global s+=m[string(i)] end\nprintln(s)\n";
}

fn _raku(category) {
    if category == "startup" { return "say 1;\n"; }
    if category == "recursion" { return "sub fib($n){$n<2 ?? $n !! fib($n-1)+fib($n-2)}; say fib(22);\n"; }
    if category == "integer_loop" { return "my $s=0;for 0..99999 -> $i {$s=($s+($i%1000)*17+3)%1000003};say $s;\n"; }
    if category == "array" { return "my @a=(0..19999).map(*%97);say [+] @a;\n"; }
    if category == "string" { return "my $s='';for 1..5000 {$s~='ab'};say $s.chars;\n"; }
    return "my %m;for 0..4999 -> $i {%m{$i.Str}=$i%101};my $s=0;for 0..4999 -> $i {$s+=%m{$i.Str}};say $s;\n";
}

fn _dart(category) {
    if category == "startup" { return "void main(){print(1);}\n"; }
    if category == "recursion" { return "int fib(int n)=>n<2?n:fib(n-1)+fib(n-2);void main(){print(fib(22));}\n"; }
    if category == "integer_loop" { return "void main(){var s=0;for(var i=0;i<100000;i++)s=(s+(i%1000)*17+3)%1000003;print(s);}\n"; }
    if category == "array" { return "void main(){var a=<int>[];for(var i=0;i<20000;i++)a.add(i%97);var s=0;for(final v in a)s+=v;print(s);}\n"; }
    if category == "string" { return "void main(){var b=StringBuffer();for(var i=0;i<5000;i++)b.write('ab');print(b.length);}\n"; }
    return "void main(){var m=<String,int>{};for(var i=0;i<5000;i++)m['$i']=i%101;var s=0;for(var i=0;i<5000;i++)s+=m['$i']!;print(s);}\n";
}

fn _swift(category) {
    if category == "startup" { return "print(1)\n"; }
    if category == "recursion" { return "func fib(_ n:Int)->Int{return n<2 ? n : fib(n-1)+fib(n-2)}\nprint(fib(22))\n"; }
    if category == "integer_loop" { return "var s=0\nfor i in 0..<100000{s=(s+(i%1000)*17+3)%1000003}\nprint(s)\n"; }
    if category == "array" { return "var a=[Int]()\nfor i in 0..<20000{a.append(i%97)}\nprint(a.reduce(0,+))\n"; }
    if category == "string" { return "var s=\"\"\nfor _ in 0..<5000{s += \"ab\"}\nprint(s.count)\n"; }
    return "var m=[String:Int]()\nfor i in 0..<5000{m[String(i)]=i%101}\nvar s=0\nfor i in 0..<5000{s += m[String(i)]!}\nprint(s)\n";
}

fn source(language, category) {
    if not _contains(categories(), category) { throw "language_benchmark.source: unknown category " + str(category); }
    if language == "pblang" { return _pblang(category); }
    if language == "python" { return _python(category); }
    if language == "javascript" { return _javascript(category); }
    if language == "ruby" { return _ruby(category); }
    if language == "perl" { return _perl(category); }
    if language == "lua" { return _lua(category); }
    if language == "php" { return _php(category); }
    if language == "tcl" { return _tcl(category); }
    if language == "awk" { return _awk(category); }
    if language == "bash" { return _bash(category); }
    if language == "r" { return _r(category); }
    if language == "julia" { return _julia(category); }
    if language == "raku" { return _raku(category); }
    if language == "dart" { return _dart(category); }
    if language == "swift" { return _swift(category); }
    throw "language_benchmark.source: unsupported language " + str(language);
}

fn _contains(values, wanted) { let i = 0; while i < len(values) { if values[i] == wanted { return true; } i = i + 1; } return false; }

fn _canonical_spec(value) {
    let id = "";
    if is_string(value) { id = value; }
    else if is_map(value) and map_has(value, "id") { id = str(value.id); }
    let known = languages(); let i = 0;
    while i < len(known) { if known[i].id == id { return known[i]; } i = i + 1; }
    return nil;
}

fn _command(spec) {
    if map_has(_command_cache, spec.id) { let cached = _command_cache[spec.id]; if cached == "" { return nil; } return cached; }
    let i = 0;
    while i < len(spec.commands) {
        let cmd = spec.commands[i];
        if str_contains(cmd, "/") {
            let r = try proc_spawn_wait(cmd, ["--version"]) catch nil;
            if r != nil { _command_cache[spec.id] = cmd; return cmd; }
        } else {
            let r = try proc_spawn_wait("which", [cmd]) catch nil;
            if r != nil and r.exit_code == 0 { _command_cache[spec.id] = cmd; return cmd; }
        }
        i = i + 1;
    }
    _command_cache[spec.id] = ""; return nil;
}

fn available(spec) { let known = _canonical_spec(spec); if known == nil { return false; } return _command(known) != nil; }

fn _temp_path(spec) {
    _seq = _seq + 1;
    return "/tmp/pblang_language_benchmark_" + str(now_ms()) + "_" + str(_seq) + "." + spec.extension;
}

fn run_once(spec, category, timeout_seconds = 20) {
    spec = _canonical_spec(spec);
    if spec == nil { return map{ ok: false, status: "unsupported-language", stdout: "", stderr: "language is not in the benchmark registry", elapsed_ms: 0 }; }
    if not is_number(timeout_seconds) or timeout_seconds < 1 or timeout_seconds > 300 {
        return map{ ok: false, status: "invalid-timeout", stdout: "", stderr: "timeout must be 1..300 seconds", elapsed_ms: 0 };
    }
    timeout_seconds = num_floor(timeout_seconds);
    let cmd = _command(spec);
    if cmd == nil { return map{ ok: false, status: "unavailable", stdout: "", stderr: "", elapsed_ms: 0 }; }
    let path = _temp_path(spec); fs_write(path, source(spec.id, category));
    let args = [str(timeout_seconds) + "s", cmd]; let i = 0;
    while i < len(spec.args_before) { array_push(args, spec.args_before[i]); i = i + 1; }
    array_push(args, path); i = 0;
    while i < len(spec.args_after) { array_push(args, spec.args_after[i]); i = i + 1; }
    let t0 = now_ms();
    let result = try proc_spawn_wait("timeout", args) catch nil;
    let elapsed = now_ms() - t0;
    try fs_remove(path) catch nil;
    if result == nil { return map{ ok: false, status: "spawn-error", stdout: "", stderr: "spawn failed", elapsed_ms: elapsed }; }
    if result.exit_code == 124 { return map{ ok: false, status: "timeout", stdout: result.stdout, stderr: result.stderr, elapsed_ms: elapsed }; }
    if result.exit_code != 0 { return map{ ok: false, status: "runtime-error", stdout: result.stdout, stderr: result.stderr, elapsed_ms: elapsed }; }
    let actual = str_trim(result.stdout); let wanted = expected(category);
    if actual != wanted { return map{ ok: false, status: "wrong-result", stdout: actual, expected: wanted, stderr: result.stderr, elapsed_ms: elapsed }; }
    return map{ ok: true, status: "ok", stdout: actual, stderr: result.stderr, elapsed_ms: elapsed };
}

fn benchmark(spec, category, repetitions = 3, timeout_seconds = 20) {
    spec = _canonical_spec(spec);
    if spec == nil { return map{ language: "unknown", name: "unknown", category: category, status: "unsupported-language", samples_ms: [] }; }
    if not is_number(repetitions) or repetitions < 1 or repetitions > 20 {
        return map{ language: spec.id, name: spec.name, category: category, status: "invalid-repetitions", samples_ms: [] };
    }
    repetitions = num_floor(repetitions);
    if not available(spec) { return map{ language: spec.id, name: spec.name, category: category, status: "unavailable", samples_ms: [] }; }
    let warm = run_once(spec, category, timeout_seconds);
    if not warm.ok { return map{ language: spec.id, name: spec.name, category: category, status: warm.status, detail: warm.stderr, samples_ms: [] }; }
    let samples = []; let i = 0; let output = "";
    while i < repetitions {
        let r = run_once(spec, category, timeout_seconds);
        if not r.ok { return map{ language: spec.id, name: spec.name, category: category, status: r.status, detail: r.stderr, samples_ms: samples }; }
        array_push(samples, r.elapsed_ms); output = r.stdout; i = i + 1;
    }
    let summary = BENCH.stats(spec.id + "/" + category, samples);
    return map{
        language: spec.id, name: spec.name, category: category, status: "ok",
        repetitions: repetitions, median_ms: summary.median_ms,
        average_ms: summary.avg_ms, min_ms: summary.min_ms, max_ms: summary.max_ms,
        p90_ms: summary.p90_ms, p95_ms: summary.p95_ms, p99_ms: summary.p99_ms,
        stddev_ms: summary.stddev_ms, mad_ms: summary.mad_ms, iqr_ms: summary.iqr_ms,
        cv_percent: summary.cv_percent, outlier_count: summary.outlier_count,
        stability: summary.stability,
        checksum: output, samples_ms: samples
    };
}

fn run_matrix(selected_categories = nil, repetitions = 3, timeout_seconds = 20) {
    let cats = selected_categories ?? categories(); let langs = languages(); let rows = [];
    let li = 0;
    while li < len(langs) {
        let ci = 0;
        while ci < len(cats) { array_push(rows, benchmark(langs[li], cats[ci], repetitions, timeout_seconds)); ci = ci + 1; }
        li = li + 1;
    }
    return rows;
}

export languages, categories, expected, source, available, run_once, benchmark, run_matrix;
