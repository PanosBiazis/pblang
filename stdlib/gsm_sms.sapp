// Bounded GSM/AT SMS sender implemented in PBLang over linux_serial.

let SERIAL=import("stdlib:linux_serial.sapp");
let FORMAT="pblang.gsm-sms.v1";
let MAX_RESPONSE_BYTES=8192;

fn _integer(value,minimum,maximum){return type(value)=="number" and value==num_floor(value)
    and value>=minimum and value<=maximum;}
fn _valid_recipient(value){return type(value)=="string"
    and regex_match(value,"^[+][1-9][0-9]{7,14}$");}
fn _valid_message(value){
    if type(value)!="string"{return false;}let bytes=str_to_bytes(value);
    if len(bytes)<1 or len(bytes)>160{return false;}
    for i len(bytes){let byte=bytes[i];
        if not ((byte>=32 and byte<=126) or byte==10 or byte==13){return false;}
    }return true;
}
fn native_backend(){return map{
    open:fn(port,baud){return SERIAL.open_port(port,baud);},
    write:fn(handle,bytes,timeout_ms){return SERIAL.write_bytes(handle,bytes,timeout_ms);},
    read:fn(handle,maximum,timeout_ms){return SERIAL.read_bytes(handle,maximum,timeout_ms);},
    close:fn(handle){return SERIAL.close(handle);}
};}
fn _response_text(bytes){return try bytes_to_str(bytes) catch "";}
fn _read_until(backend,handle,expected,timeout_ms){
    let started=now_ms();let response="";
    while now_ms()-started<timeout_ms and len(str_to_bytes(response))<MAX_RESPONSE_BYTES{
        let remaining=timeout_ms-num_floor(now_ms()-started);let wait=remaining;if wait>250{wait=250;}
        let read=backend.read(handle,1024,wait);
        if try read.ok catch false {
            response=response+_response_text(try read.bytes catch []);
            if str_contains(response,expected){return map{ok:true,response:response};}
            if str_contains(response,"+CMS ERROR") or str_contains(response,"+CME ERROR")
                or str_contains(response,"\r\nERROR"){
                return map{ok:false,error:"modem rejected the SMS command",modem_error:true};
            }
        } elif not (try read.timed_out catch false){
            return map{ok:false,error:"modem response read failed"};
        }
    }
    return map{ok:false,error:"modem response deadline expired",timeout:true};
}
fn _write(backend,handle,text,timeout_ms){
    let written=backend.write(handle,str_to_bytes(text),timeout_ms);
    if not (try written.ok catch false){return map{ok:false,error:"modem command write failed"};}
    return map{ok:true};
}
fn _command(backend,handle,command,expected,timeout_ms){
    let written=_write(backend,handle,command+"\r",timeout_ms);
    if not written.ok{return written;}
    return _read_until(backend,handle,expected,timeout_ms);
}

fn send_with_backend(port,baud,recipient,message,timeout_ms,backend){
    if not _valid_recipient(recipient){throw "recipient must be an E.164 number";}
    if not _valid_message(message){throw "message must be 1 to 160 GSM-safe ASCII bytes";}
    if not _integer(baud,50,4000000){throw "invalid modem baud rate";}
    if not _integer(timeout_ms,1000,60000){throw "timeout_ms must be from 1000 to 60000";}
    let handle=backend.open(port,baud);
    if not (try handle.ok catch false){return map{ok:false,executed:false,format:FORMAT,
        error:try handle.error catch "modem open failed"};}
    let commands=[["AT","OK"],["ATE0","OK"],["AT+CMEE=2","OK"],
        ["AT+CMGF=1","OK"],["AT+CSCS=\"GSM\"","OK"]];
    let result=map{ok:true};
    for i len(commands){if result.ok{result=_command(backend,handle,commands[i][0],commands[i][1],timeout_ms);}}
    if result.ok{result=_command(backend,handle,"AT+CMGS=\""+recipient+"\"",">",timeout_ms);}
    if result.ok{
        result=_write(backend,handle,message+str_from_char_code(26),timeout_ms);
        if result.ok{result=_read_until(backend,handle,"+CMGS:",timeout_ms);}
        if result.ok and not str_contains(result.response,"OK"){
            let final_ack=_read_until(backend,handle,"OK",timeout_ms);
            if not final_ack.ok{result=final_ack;}
        }
    }
    let closed=backend.close(handle);
    if not result.ok{return map{ok:false,executed:true,format:FORMAT,error:result.error,
        timeout:try result.timeout catch false,descriptor_closed:try closed.ok catch false};}
    return map{ok:true,executed:true,format:FORMAT,accepted_by_modem:true,
        recipient:recipient,message_bytes:len(str_to_bytes(message)),charset:"GSM",
        descriptor_bound:true,descriptor_closed:try closed.ok catch false,
        shell_used:false,response_exposed:false};
}

fn send(port,baud,recipient,message,timeout_ms=15000){
    if platform()!="linux"{return map{ok:false,executed:false,error:"Linux serial modem backend unavailable"};}
    return send_with_backend(port,baud,recipient,message,timeout_ms,native_backend());
}

export FORMAT, MAX_RESPONSE_BYTES, native_backend, send_with_backend, send;
