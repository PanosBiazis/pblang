// Portable read-only pages; no file loading, recalculation or implicit clock.
let Work=import("stdlib:task_workdays.sapp");let UI=import("stdlib:modern_ui.sapp");
fn page(report,index){let lines=[];for i in range(index*4,num_min(len(report.tasks),(index+1)*4)){let t=report.tasks[i];array_push(lines,t.id+" | "+t.label+"\n"+t.start+" -> "+t.due+"\nWorkdays: "+str(t.workdays)+" | "+t.status);}return str_join(lines,"\n\n");}
fn create(plan,weekdays=nil,closed=nil){let report=Work.schedule(plan,weekdays,closed);let buttons=[];for i in range(0,num_ceil(report.total/4)){array_push(buttons,UI.button("Page "+str(i+1),UI.action_set_text("schedule",page(report,i)),map{name:"page_"+str(i)}));}
 return UI.screen([UI.heading("PBWorkdays"),UI.text(report.title),UI.text(report.start+" to "+report.due+" | Workday span: "+str(report.workdays)),UI.text("What-if: durations are workdays. Unlimited workers."),UI.text("Weekdays Monday=0: "+json_stringify(report.weekdays)+" | Explicit closures: "+str(len(report.closed))),UI.area(page(report,0),map{name:"schedule",readonly:true,enabled:false,h:530}),UI.grid(buttons,map{columns:4}),UI.text("Read-only dates. No reminders or automatic holiday calendar.")]);
}
export page,create;
