// stdlib/ide_features.sapp — web-IDE-style editor features as pure, testable functions
// (no display): a symbol OUTLINE, FIND-ALL, FIND & REPLACE, STATUS-BAR text,
// bounded run/check HISTORY records, DIAGNOSTIC normalization/navigation data, and
// searchable EXAMPLES catalog helpers.
// pbide.sapp (and any editor) wires these into its UI; the logic is unit-tested headlessly.

let PROJECT_SURVEY = import("stdlib:project_survey.sapp");
let PROJECT_AUDIT = import("stdlib:project_audit.sapp");
let PROJECT_TEXT_AUDIT = import("stdlib:project_text_audit.sapp");
let AAP_STATUS = import("stdlib:aap_status.sapp");
let GFX = import("stdlib:graphics.sapp");
let RESOURCE_BUDGET = import("stdlib:resource_budget.sapp");
let PRODUCT_RUNTIME = import("stdlib:product_runtime.sapp");
let RESILIENCE = import("stdlib:resilience.sapp");
let _EXECUTION_PIPELINE = nil;

fn _execution_pipeline() {
    if _EXECUTION_PIPELINE == nil { _EXECUTION_PIPELINE = import("stdlib:execution_pipeline.sapp"); }
    return _EXECUTION_PIPELINE;
}

fn _ident(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        let c = strcharcodeat(ch, 0);
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 {
            out = out + ch;
        } else { return out; }
        i = i + 1;
    }
    return out;
}

// outline(code) -> [{ kind, name, line }] for top-level fn / let / const / export.
fn outline(code) {
    let out = [];
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let t = str_trim(lines[i]);
        let ln = i + 1;
        if str_starts_with(t, "fn ") {
            array_push(out, map{ kind: "fn", name: _ident(str_slice(t, 3, len(t))), line: ln });
        } else if str_starts_with(t, "let ") {
            array_push(out, map{ kind: "let", name: _ident(str_slice(t, 4, len(t))), line: ln });
        } else if str_starts_with(t, "const ") {
            array_push(out, map{ kind: "const", name: _ident(str_slice(t, 6, len(t))), line: ln });
        } else if str_starts_with(t, "export ") {
            array_push(out, map{ kind: "export", name: str_trim(str_slice(t, 7, len(t))), line: ln });
        }
        i = i + 1;
    }
    return out;
}

fn filter_outline(code, query, limit) {
    if limit == nil or limit < 1 { limit = 100; }
    let out = [];
    let q = str_lower(str_trim(str(query)));
    let items = outline_ranges(code);
    let i = 0;
    while i < len(items) and len(out) < limit {
        let it = items[i];
        let hay = str_lower(str(try it.kind catch "") + "\n" + str(try it.name catch "") + "\n" + str(try it.line catch "") + "\n" + str(try it.end_line catch ""));
        if q == "" or str_contains(hay, q) {
            array_push(out, map{
                index: i,
                kind: it.kind,
                name: it.name,
                line: it.line,
                end_line: it.end_line,
                lines: it.lines,
                label: it.label
            });
        }
        i = i + 1;
    }
    return out;
}

fn outline_filter_status(code, query, selected) {
    let total = len(outline_ranges(code));
    let q = str_trim(str(query));
    if total == 0 { return "outline: no symbols"; }
    let hits = filter_outline(code, q, 10000);
    let prefix = "outline: all " + str(total) + " symbol(s)";
    if q != "" { prefix = "outline: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits));
}

fn _symbol_label(kind, name, line, end_line) {
    let span = "L" + str(line);
    if end_line != line { span = span + "-L" + str(end_line); }
    return str(kind) + " " + str(name) + " " + span;
}

fn outline_ranges(code) {
    let items = outline(code);
    let total = len(str_split(str(code), "\n"));
    let out = [];
    let i = 0;
    while i < len(items) {
        let it = items[i];
        let start = try it.line catch 1;
        let end_line = total;
        if i + 1 < len(items) { end_line = (try items[i + 1].line catch start + 1) - 1; }
        if end_line < start { end_line = start; }
        array_push(out, map{
            kind: it.kind,
            name: it.name,
            line: start,
            end_line: end_line,
            lines: end_line - start + 1,
            label: _symbol_label(it.kind, it.name, start, end_line)
        });
        i = i + 1;
    }
    return out;
}

fn current_symbol(code, line) {
    let raw_target = try parse_number(str(line)) catch 1;
    if raw_target != nil and raw_target < 1 {
        return map{ kind: "file", name: "top-level", line: 1, label: "top-level" };
    }
    let target = raw_target;
    if target == nil { target = 1; }
    target = num_floor(target);
    let items = outline_ranges(code);
    let best = nil;
    let i = 0;
    while i < len(items) {
        if items[i].line <= target { best = items[i]; }
        i = i + 1;
    }
    if best == nil {
        return map{ kind: "file", name: "top-level", line: 1, label: "top-level" };
    }
    return map{
        kind: best.kind,
        name: best.name,
        line: best.line,
        end_line: best.end_line,
        lines: best.lines,
        label: best.label
    };
}

// find_all(code, query) -> [{ line, col }] (1-based) of every (case-sensitive) match.
fn find_all(code, query) {
    let out = [];
    if query == nil or query == "" { return out; }
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let rem = lines[i];
        let base = 0;
        let guard = 0;
        while guard < 100000 {
            let idx = str_index_of(rem, query);
            if idx < 0 { break; }
            array_push(out, map{ line: i + 1, col: base + idx + 1 });
            let step = idx + len(query);
            base = base + step;
            rem = str_slice(rem, step, len(rem));
            guard = guard + 1;
        }
        i = i + 1;
    }
    return out;
}

// _count_occurrences(hay, needle) -> non-overlapping left-to-right count over the WHOLE string.
// find_all() counts per line (it needs {line,col} for highlighting), so it can't see a `needle`
// that spans a newline — but str_replace_all() operates on the whole buffer and WOULD replace it.
// This helper matches str_replace_all's exact semantics so replace_all's reported count is honest.
fn _count_occurrences(hay, needle) {
    if needle == nil or needle == "" { return 0; }
    let n = 0;
    let rem = hay;
    let guard = 0;
    while guard < 1000000 {
        let idx = str_index_of(rem, needle);
        if idx < 0 { break; }
        n = n + 1;
        rem = str_slice(rem, idx + len(needle), len(rem));
        guard = guard + 1;
    }
    return n;
}

// replace_all(code, find, repl) -> { code, count } (count = matches replaced).
fn replace_all(code, find, repl) {
    if find == nil or find == "" { return map{ code: code, count: 0 }; }
    // Count over the whole buffer (not per-line) so a multi-line `find` reports the real number
    // of replacements str_replace_all makes — previously it wrongly reported 0 while editing text.
    let count = _count_occurrences(code, find);
    return map{ code: str_replace_all(code, find, repl), count: count };
}

fn _match_label(n) {
    if n == 1 { return "1 match"; }
    return str(n) + " matches";
}

// find_status(code, query, replace_mode, replace_focus, replace_text) -> compact
// status text for the native IDE's find / replace overlay.
fn find_status(code, query, replace_mode, replace_focus, replace_text) {
    let q = str(try query catch "");
    let count = len(find_all(code, q));
    let summary = _match_label(count);
    if try replace_mode catch false {
        let f = "find";
        if str(try replace_focus catch "find") == "replace" { f = "replace"; }
        return "REPLACE [" + f + "]  " + summary + "  find='" + q + "' -> '" +
               str(try replace_text catch "") + "'  Tab=switch  Enter=replace-all  Esc=close";
    }
    return "find: " + q + "  " + summary + "  Enter=next  Esc=close";
}

fn find_position_status(code, query, line, col) {
    let hits = find_all(code, query);
    let n = len(hits);
    if n == 0 { return "match 0/0"; }
    let target_line = try parse_number(str(line)) catch 1;
    let target_col = try parse_number(str(col)) catch 1;
    if target_line == nil { target_line = 1; }
    if target_col == nil { target_col = 1; }
    target_line = num_floor(target_line);
    target_col = num_floor(target_col);
    if target_line < 1 { target_line = 1; }
    if target_col < 1 { target_col = 1; }
    let chosen = 0;
    let i = 0;
    while i < n {
        let h = hits[i];
        if h.line == target_line and h.col == target_col {
            chosen = i;
            break;
        }
        if h.line < target_line or (h.line == target_line and h.col < target_col) {
            chosen = i;
        }
        i = i + 1;
    }
    let hit = hits[chosen];
    return "match " + str(chosen + 1) + "/" + str(n) + " at L" + str(hit.line) + ":C" + str(hit.col);
}

// filter_examples(catalog, query, limit) -> [{ index, title }]
// Matches title, code, path metadata, browser URLs, and project files, case-insensitive.
// Used by the native/web examples picker.
fn filter_examples(catalog, query, limit) {
    let out = [];
    if limit == nil or limit < 1 { limit = 50; }
    let q = str_lower(str_trim(str(query)));
    let i = 0;
    while catalog != nil and i < len(catalog) and len(out) < limit {
        let ex = catalog[i];
        let title = str(try ex.title catch "Example " + str(i + 1));
        let code = str(try ex.code catch "");
        let meta = str(try ex.main_path catch "") + "\n" +
            str(try ex.run_path catch "") + "\n" +
            str(try ex.project_root catch "");
        let files = try ex.files catch [];
        let fi = 0;
        while files != nil and fi < len(files) {
            meta = meta + "\n" + str(files[fi]);
            fi = fi + 1;
        }
        let browser_urls = try ex.browser_urls catch [];
        let bi = 0;
        while browser_urls != nil and bi < len(browser_urls) {
            meta = meta + "\n" + str(browser_urls[bi]);
            bi = bi + 1;
        }
        let hay = str_lower(title + "\n" + code + "\n" + meta);
        if q == "" or str_contains(hay, q) {
            array_push(out, map{ index: i, title: title });
        }
        i = i + 1;
    }
    return out;
}

fn examples_filter_status(catalog, query, selected) {
    let total = len(try catalog catch []);
    let q = str_trim(str(query));
    if total == 0 { return "examples: empty"; }
    let hits = filter_examples(catalog, q, 10000);
    let prefix = "examples: all " + str(total) + " item(s)";
    if q != "" { prefix = "examples: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits));
}

