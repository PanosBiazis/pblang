fn project_category_health_lines(board, limit = 12) {
    if limit == nil or limit < 1 { limit = 12; }
    let b = try board catch map{};
    let rows = try b.rows catch [];
    let highlights = [];
    let routes = [];
    let hi = 0;
    while hi < len(rows) and len(highlights) < 6 {
        let r = rows[hi];
        if str(try r.risk catch "") == "high" or str_starts_with(str(try r.status catch ""), "missing") {
            array_push(highlights, str(try r.project catch "?") + "/" + str(try r.category catch "?"));
        }
        hi = hi + 1;
    }
    let ri = 0;
    while ri < len(rows) and len(routes) < 3 {
        let route = str(try rows[ri].device_route catch "");
        if str_contains(str_lower(route), "gpu") {
            array_push(routes, route);
        }
        ri = ri + 1;
    }
    let lines = [
        "Project category health: " + str(try b.status catch "unknown"),
        str(try b.detail catch "no category health loaded"),
        "policy: " + str(try b.policy catch "metadata-only")
    ];
    if len(highlights) > 0 and len(lines) < limit {
        array_push(lines, "high-risk: " + str_join(highlights, ", "));
    }
    if len(routes) > 0 and len(lines) < limit {
        array_push(lines, "device-routes: " + str_join(routes, " | "));
    }
    let i = 0;
    while i < len(rows) and len(lines) < limit {
        let r = rows[i];
        array_push(lines, "- " + str(try r.project catch "?") + "/" + str(try r.category catch "?") +
            " " + str(try r.status catch "?") +
            " risk=" + str(try r.risk catch "?") +
            " priority=" + str(try r.priority catch 0) +
            " route=" + str(try r.device_route catch "portable"));
        i = i + 1;
    }
    if len(rows) > 0 and len(lines) < limit {
        let first = rows[0];
        array_push(lines, "next: " + str(try first.next_step catch ""));
        if len(lines) < limit { array_push(lines, "protocols: " + str_join(try first.protocols catch [], ", ")); }
        if len(lines) < limit { array_push(lines, "gates: " + str_join(try first.gates catch [], ", ")); }
    }
    return lines;
}

fn project_gap_board(project, records, max_findings = 100) {
    let audit = PROJECT_AUDIT.audit_project(project, records, max_findings);
    let report = try audit.report catch map{};
    let gate = PROJECT_AUDIT.quality_gate(report, map{ max_high: 0, max_medium: 8, max_total: 80, allow_roadmap: true });
    let tasks = PROJECT_AUDIT.backlog(report, 20);
    let count = try report.finding_count catch 0;
    let high = try report.counts_severity.high catch 0;
    let status = "clean";
    if count > 0 { status = "needs-review"; }
    if high > 0 { status = "high-risk"; }
    return map{
        format: "pbide.project_gap_board.v1",
        project: project,
        status: status,
        finding_count: count,
        counts_kind: try report.counts_kind catch map{},
        counts_severity: try report.counts_severity catch map{},
        findings: try report.findings catch [],
        quality_gate: gate,
        backlog: tasks,
        recommendations: try audit.recommendations catch [],
        detail: str(count) + " finding(s); high=" + str(high) + "; gate=" + str(try gate.status catch "unknown") + "; policy=" + str(try report.policy catch "bounded text only")
    };
}

