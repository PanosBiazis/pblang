fn _query_tokens(query) {
    let q = str_lower(str_trim(str(query)));
    let raw = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(raw) {
        let t = str_trim(raw[i]);
        if t != "" { array_push(out, t); }
        i = i + 1;
    }
    return out;
}

fn _matches_tokens(hay, tokens) {
    let i = 0;
    while i < len(tokens) {
        if not str_contains(hay, tokens[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn _command_query_group(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "group:") { return str_slice(p, 6, len(p)); }
        if str_starts_with(p, "group=") { return str_slice(p, 6, len(p)); }
        i = i + 1;
    }
    return "";
}

fn _command_query_scoped(query, names) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        let ni = 0;
        while names != nil and ni < len(names) {
            let n = str(names[ni]);
            let colon = n + ":";
            let eq = n + "=";
            if str_starts_with(p, colon) { return str_slice(p, len(colon), len(p)); }
            if str_starts_with(p, eq) { return str_slice(p, len(eq), len(p)); }
            ni = ni + 1;
        }
        i = i + 1;
    }
    return "";
}

fn _command_query_id(query) { return _command_query_scoped(query, ["id", "cmd", "command"]); }
fn _command_query_title(query) { return _command_query_scoped(query, ["title", "name"]); }
fn _command_query_shortcut(query) { return _command_query_scoped(query, ["shortcut", "key", "keys"]); }

fn _command_query_excludes(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "not:") { array_push(out, str_slice(p, 4, len(p))); }
        if str_starts_with(p, "not=") { array_push(out, str_slice(p, 4, len(p))); }
        if str_starts_with(p, "exclude:") { array_push(out, str_slice(p, 8, len(p))); }
        if str_starts_with(p, "exclude=") { array_push(out, str_slice(p, 8, len(p))); }
        i = i + 1;
    }
    return out;
}

fn _command_is_scoped_token(p) {
    let prefixes = ["group:", "group=", "id:", "id=", "cmd:", "cmd=", "command:", "command=", "title:", "title=", "name:", "name=", "shortcut:", "shortcut=", "key:", "key=", "keys:", "keys=", "not:", "not=", "exclude:", "exclude="];
    let i = 0;
    while i < len(prefixes) {
        if str_starts_with(p, prefixes[i]) { return true; }
        i = i + 1;
    }
    return false;
}

fn _command_query_without_scoped(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if p != "" and not _command_is_scoped_token(p) {
            array_push(out, p);
        }
        i = i + 1;
    }
    return str_join(out, " ");
}

fn _seen_text(items, text) {
    let i = 0;
    while items != nil and i < len(items) {
        if str(items[i]) == str(text) { return true; }
        i = i + 1;
    }
    return false;
}

fn _valid_command_id(id) {
    if id == "" { return false; }
    let i = 0;
    while i < len(id) {
        let c = strcharcodeat(id, i);
        let lower = c >= 97 and c <= 122;
        let digit = c >= 48 and c <= 57;
        let under = c == 95;
        if not (lower or digit or under) { return false; }
        i = i + 1;
    }
    return true;
}

fn command_catalog_issues(catalog) {
    if catalog == nil { catalog = command_catalog(); }
    let issues = [];
    let seen = [];
    let i = 0;
    while i < len(catalog) {
        let c = catalog[i];
        let id = str_trim(str(try c.id catch ""));
        let title = str_trim(str(try c.title catch ""));
        let group = str_trim(str(try c.group catch ""));
        let shortcut = str_trim(str(try c.shortcut catch ""));
        if id == "" {
            array_push(issues, map{ kind: "missing_id", index: i, message: "command has no id" });
        } else if not _valid_command_id(id) {
            array_push(issues, map{ kind: "malformed_id", id: id, index: i, message: "command id must use lowercase letters, digits, and underscore" });
        } else if _seen_text(seen, id) {
            array_push(issues, map{ kind: "duplicate_id", id: id, index: i, message: "duplicate command id " + id });
        } else {
            array_push(seen, id);
        }
        if title == "" { array_push(issues, map{ kind: "missing_title", id: id, index: i, message: "command has no title" }); }
        if group == "" { array_push(issues, map{ kind: "missing_group", id: id, index: i, message: "command has no group" }); }
        if shortcut == "" { array_push(issues, map{ kind: "missing_shortcut", id: id, index: i, message: "command has no shortcut or discoverability hint" }); }
        i = i + 1;
    }
    return issues;
}

fn command_catalog_has(id, catalog) {
    if catalog == nil { catalog = command_catalog(); }
    let target = str_trim(str(id));
    if target == "" { return false; }
    let i = 0;
    while i < len(catalog) {
        if str_trim(str(try catalog[i].id catch "")) == target { return true; }
        i = i + 1;
    }
    return false;
}

fn command_catalog_missing(ids, catalog) {
    if catalog == nil { catalog = command_catalog(); }
    let missing = [];
    let i = 0;
    while ids != nil and i < len(ids) {
        let id = str_trim(str(ids[i]));
        if id != "" and not command_catalog_has(id, catalog) { array_push(missing, id); }
        i = i + 1;
    }
    return missing;
}

fn _command_group_index(groups, name) {
    let i = 0;
    while groups != nil and i < len(groups) {
        if str(try groups[i].group catch "") == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn command_catalog_group_counts(catalog) {
    if catalog == nil { catalog = command_catalog(); }
    let groups = [];
    let i = 0;
    while i < len(catalog) {
        let group = str_trim(str(try catalog[i].group catch ""));
        if group != "" {
            let idx = _command_group_index(groups, group);
            if idx < 0 {
                array_push(groups, map{ group: group, count: 1 });
            } else {
                groups[idx].count = groups[idx].count + 1;
            }
        }
        i = i + 1;
    }
    return groups;
}

fn command_catalog_summary(catalog) {
    if catalog == nil { catalog = command_catalog(); }
    let groups = command_catalog_group_counts(catalog);
    let largest = "";
    let largest_count = 0;
    let i = 0;
    while i < len(groups) {
        if groups[i].count > largest_count {
            largest = groups[i].group;
            largest_count = groups[i].count;
        }
        i = i + 1;
    }
    let s = str(len(catalog)) + " commands / " + str(len(groups)) + " groups";
    if largest != "" { s = s + " / largest " + largest + " " + str(largest_count); }
    return s;
}

fn panel_command_id(panel_id) {
    let id = str_trim(str(panel_id));
    if id == "" { return ""; }
    if str_starts_with(id, "panel_") { return id; }
    return "panel_" + id;
}

fn panel_command_ids(panel_ids) {
    let out = [];
    let i = 0;
    while panel_ids != nil and i < len(panel_ids) {
        let id = panel_command_id(panel_ids[i]);
        if id != "" { array_push(out, id); }
        i = i + 1;
    }
    return out;
}

fn _command_excludes_ok(c, excludes) {
    if excludes == nil or len(excludes) == 0 { return true; }
    let hay = str_lower(str(try c.title catch "") + "\n" +
        str(try c.group catch "") + "\n" +
        str(try c.shortcut catch "") + "\n" +
        str(try c.id catch ""));
    let i = 0;
    while i < len(excludes) {
        let ex = str_lower(str_trim(str(excludes[i])));
        if ex != "" and str_contains(hay, ex) { return false; }
        i = i + 1;
    }
    return true;
}

fn _command_rank(c, qtext, tokens, group_filter, id_filter, title_filter, shortcut_filter) {
    let q = str_lower(str_trim(str(qtext)));
    let id = str_lower(str(try c.id catch ""));
    let title = str_lower(str(try c.title catch ""));
    let shortcut = str_lower(str(try c.shortcut catch ""));
    let group = str_lower(str(try c.group catch ""));
    if id_filter != "" and id == id_filter { return 0; }
    if title_filter != "" and title == title_filter { return 0; }
    if shortcut_filter != "" and shortcut == shortcut_filter { return 0; }
    if q == "" {
        if group_filter != "" and group == group_filter { return 0; }
        if id_filter != "" or title_filter != "" or shortcut_filter != "" { return 1; }
        return 20;
    }
    if id == q { return 0; }
    if str_starts_with(id, "panel_") and str_contains(title, q) { return 1; }
    if title == q { return 2; }
    if shortcut == q { return 3; }
    if str_starts_with(id, q) { return 4; }
    if str_starts_with(title, q) { return 5; }
    if str_contains(shortcut, q) { return 6; }
    if str_contains(id, q) { return 7; }
    if str_contains(title, q) { return 8; }
    if _matches_tokens(id + "\n" + title, tokens) { return 9; }
    if str_contains(group, q) { return 10; }
    return 20;
}

fn _command_insert_ranked(out, item, limit) {
    if limit == nil or limit < 1 { limit = 50; }
    let rank = try item.rank catch 20;
    let next = [];
    let inserted = false;
    let i = 0;
    while i < len(out) and len(next) < limit {
        let other_rank = try out[i].rank catch 20;
        if not inserted and rank < other_rank {
            array_push(next, item);
            inserted = true;
        }
        if len(next) < limit { array_push(next, out[i]); }
        i = i + 1;
    }
    if not inserted and len(next) < limit { array_push(next, item); }
    return next;
}

fn filter_commands(query, limit) {
    if limit == nil or limit < 1 { limit = 50; }
    let out = [];
    let q = str_lower(str_trim(str(query)));
    let group_filter = _command_query_group(q);
    let id_filter = _command_query_id(q);
    let title_filter = _command_query_title(q);
    let shortcut_filter = _command_query_shortcut(q);
    let excludes = _command_query_excludes(q);
    let qtext = _command_query_without_scoped(q);
    let tokens = _query_tokens(qtext);
    let cmds = command_catalog();
    let i = 0;
    while i < len(cmds) {
        let c = cmds[i];
        let hay = str_lower(c.title + "\n" + c.group + "\n" + c.shortcut + "\n" + c.id);
        let cid = str_lower(str(try c.id catch ""));
        let ctitle = str_lower(str(try c.title catch ""));
        let cshortcut = str_lower(str(try c.shortcut catch ""));
        let group_ok = group_filter == "" or str_contains(str_lower(str(try c.group catch "")), group_filter);
        let id_ok = id_filter == "" or str_contains(cid, id_filter);
        let title_ok = title_filter == "" or str_contains(ctitle, title_filter);
        let shortcut_ok = shortcut_filter == "" or str_contains(cshortcut, shortcut_filter);
        let text_ok = qtext == "" or str_contains(hay, qtext) or _matches_tokens(hay, tokens);
        let exclude_ok = _command_excludes_ok(c, excludes);
        if group_ok and id_ok and title_ok and shortcut_ok and text_ok and exclude_ok {
            let item = map{
                index: i,
                id: c.id,
                title: c.title,
                group: c.group,
                shortcut: c.shortcut,
                rank: _command_rank(c, qtext, tokens, group_filter, id_filter, title_filter, shortcut_filter)
            };
            out = _command_insert_ranked(out, item, limit);
        }
        i = i + 1;
    }
    return out;
}

fn command_filter_status(query, selected) {
    let total = len(command_catalog());
    let q = str_trim(str(query));
    if total == 0 { return "commands: empty"; }
    let hits = filter_commands(q, 10000);
    let prefix = "commands: all " + str(total);
    if q != "" { prefix = "commands: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    let h = hits[sel];
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits)) + "  " +
        str(try h.id catch "?") + "  " + str(try h.group catch "?") + "  " + str(try h.shortcut catch "");
}

fn command_filter_hint(query) {
    let q = str_trim(str(query));
    let g = _command_query_group(q);
    let idf = _command_query_id(q);
    let titlef = _command_query_title(q);
    let shortcutf = _command_query_shortcut(q);
    let excludes = _command_query_excludes(q);
    let rest = _command_query_without_scoped(q);
    let parts = [];
    if g != "" { array_push(parts, "group " + g); }
    if idf != "" { array_push(parts, "id " + idf); }
    if titlef != "" { array_push(parts, "title " + titlef); }
    if shortcutf != "" { array_push(parts, "shortcut " + shortcutf); }
    if len(excludes) > 0 { array_push(parts, "not " + str_join(excludes, "/")); }
    if len(parts) > 0 {
        let base = "filter: " + str_join(parts, " + ");
        if rest != "" { return base + " + text '" + rest + "'"; }
        return base + " active; add words to narrow";
    }
    if g != "" {
        if rest != "" { return "filter: group " + g + " + text '" + rest + "'"; }
        return "filter: group " + g + " active; add words to narrow";
    }
    if rest != "" { return "hint: add group:code, id:run, title:browser, shortcut:ctrl+6, not:browser, or group:ai"; }
    return "hint: type text or use group:code / group:browser / group:designer / id:run / title:browser / shortcut:ctrl+6 / not:browser";
}

fn command_filter_examples(limit) {
    let items = ["group:code", "group:browser", "id:run", "title:browser", "shortcut:ctrl+6", "not:browser"];
    if limit == nil or limit < 1 { limit = len(items); }
    if limit > len(items) { limit = len(items); }
    let out = [];
    let i = 0;
    while i < limit {
        array_push(out, items[i]);
        i = i + 1;
    }
    return out;
}

fn command_filter_examples_line(limit) {
    return "filters: " + str_join(command_filter_examples(limit), " ");
}

fn command_empty_message(query) {
    let q = str_trim(str(query));
    let msg = "No matching commands";
    if q != "" { msg = msg + " for `" + q + "`"; }
    return msg + ". " + command_filter_hint(q) + ". Try group:code, group:file, group:browser, group:ai, or exact command ids like run/save/open.";
}

fn browser_bar_metrics(ch, pad) {
    if ch == nil or ch < 1 { ch = 8; }
    if pad == nil or pad < 0 { pad = 0; }
    let button_h = ch + 3 * pad;
    let summary_h = 2 * (ch + pad);
    return map{
        button_h: button_h,
        summary_h: summary_h,
        total_h: button_h + summary_h
    };
}

fn browser_bar_zone(my, top, ch, pad) {
    let m = browser_bar_metrics(ch, pad);
    if my < top { return "above"; }
    let rel = my - top;
    if rel < m.button_h { return "buttons"; }
    if rel < m.total_h { return "summary"; }
    return "body";
}

fn browser_header_layout(w, char_w, pad) {
    let ww = try parse_number(str(w)) catch 0;
    let cw = try parse_number(str(char_w)) catch 6;
    let pp = try parse_number(str(pad)) catch 4;
    if ww == nil { ww = 0; }
    if cw == nil or cw < 1 { cw = 6; }
    if pp == nil or pp < 0 { pp = 4; }
    let compact = false;
    let back_u = 6;
    let reload_u = 8;
    let mode_units = [6, 8, 7, 7, 8, 9, 6];
    let mode_labels = ["Live", "Reader", "Links", "Forms", "Source", "Inspect", "Host"];
    let sec_u = 14;
    let tor_u = 9;
    let gap_u = 1;
    let reserve_u = 14;
    let total_u = back_u + reload_u + sec_u + tor_u + reserve_u + 11 * gap_u;
    let mi = 0;
    while mi < len(mode_units) { total_u = total_u + mode_units[mi]; mi = mi + 1; }
    if ww > 0 and total_u * cw + 2 * pp > ww {
        compact = true;
        back_u = 5;
        reload_u = 5;
        mode_units = [4, 5, 4, 5, 4, 5, 4];
        mode_labels = ["Lv", "Read", "Lnk", "Form", "Src", "Insp", "Host"];
        sec_u = 8;
        tor_u = 6;
        reserve_u = 0;
        gap_u = 0;
    }
    let x = pp;
    let back = map{ x: x, w: back_u * cw, label: "Back" };
    x = x + back.w + gap_u * cw;
    let reload = map{ x: x, w: reload_u * cw, label: if compact { "Load" } else { "Reload" } };
    x = x + reload.w + gap_u * cw;
    let modes = [];
    mi = 0;
    while mi < len(mode_units) {
        let label = mode_labels[mi];
        array_push(modes, map{ index: mi, x: x, w: mode_units[mi] * cw, label: label });
        x = x + mode_units[mi] * cw + gap_u * cw;
        mi = mi + 1;
    }
    let sec = map{ x: x, w: sec_u * cw };
    x = x + sec.w + gap_u * cw;
    let tor = map{ x: x, w: tor_u * cw };
    x = x + tor.w + gap_u * cw;
    let url_w = ww - x - reserve_u * cw;
    if url_w < 0 { url_w = 0; }
    return map{
        format: "pbide.browser.header.layout.v1",
        compact: compact,
        gap: gap_u * cw,
        back: back,
        reload: reload,
        modes: modes,
        security: sec,
        tor: tor,
        url_x: x,
        url_w: url_w,
        status_x: ww - reserve_u * cw
    };
}

fn problems_panel_hit(my, body_top, ch, pad, diagnostic_count) {
    if ch == nil or ch < 1 { ch = 8; }
    if pad == nil or pad < 0 { pad = 0; }
    if diagnostic_count == nil or diagnostic_count < 0 { diagnostic_count = 0; }
    if my < body_top { return map{ kind: "above", index: 0 - 1 }; }
    if my < body_top + ch { return map{ kind: "action", index: 0 }; }
    let start = body_top + ch + pad;
    if my < start { return map{ kind: "gap", index: 0 - 1 }; }
    let idx = num_floor((my - start) / ch);
    if idx >= 0 and idx < diagnostic_count { return map{ kind: "diagnostic", index: idx }; }
    return map{ kind: "below", index: 0 - 1 };
}

fn _entry_field(e, key, fallback) {
    if e == nil { return fallback; }
    if type(e) == "string" {
        if key == "name" or key == "path" { return e; }
        return fallback;
    }
    return try e[key] catch fallback;
}

fn _quick_text_ok(hay, query) {
    let q = str_lower(str_trim(str(query)));
    if q == "" { return true; }
    let parts = str_split(q, " ");
    let matched = 0;
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if p != "" {
            matched = matched + 1;
            if not str_contains(hay, p) { return false; }
        }
        i = i + 1;
    }
    return matched > 0;
}

fn _quick_hit(entry, query, name_filter, path_filter) {
    let name = str(_entry_field(entry, "name", ""));
    let path = str(_entry_field(entry, "path", name));
    let kind = str(_entry_field(entry, "kind", "file"));
    let display = str(_entry_field(entry, "display", ""));
    let lname = str_lower(name);
    let lpath = str_lower(path);
    let hay = str_lower(name + "\n" + path + "\n" + kind + "\n" + display);
    let nf = str_lower(str_trim(str(name_filter)));
    let pf = str_lower(str_trim(str(path_filter)));
    if nf != "" and not str_contains(lname, nf) { return false; }
    if pf != "" and not str_contains(lpath, pf) { return false; }
    return _quick_text_ok(hay, query);
}

fn _quick_query_kind(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "kind:") { return str_slice(p, 5, len(p)); }
        if str_starts_with(p, "kind=") { return str_slice(p, 5, len(p)); }
        if str_starts_with(p, "type:") { return str_slice(p, 5, len(p)); }
        if str_starts_with(p, "type=") { return str_slice(p, 5, len(p)); }
        i = i + 1;
    }
    return "";
}

fn _quick_query_ext(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "ext:") { return str_slice(p, 4, len(p)); }
        if str_starts_with(p, "ext=") { return str_slice(p, 4, len(p)); }
        if str_starts_with(p, "extension:") { return str_slice(p, 10, len(p)); }
        if str_starts_with(p, "extension=") { return str_slice(p, 10, len(p)); }
        i = i + 1;
    }
    return "";
}

fn _quick_query_name(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "name:") { return str_slice(p, 5, len(p)); }
        if str_starts_with(p, "name=") { return str_slice(p, 5, len(p)); }
        i = i + 1;
    }
    return "";
}

fn _quick_query_path(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "path:") { return str_slice(p, 5, len(p)); }
        if str_starts_with(p, "path=") { return str_slice(p, 5, len(p)); }
        i = i + 1;
    }
    return "";
}

fn _quick_query_excludes(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "not:") { array_push(out, str_slice(p, 4, len(p))); }
        if str_starts_with(p, "not=") { array_push(out, str_slice(p, 4, len(p))); }
        if str_starts_with(p, "exclude:") { array_push(out, str_slice(p, 8, len(p))); }
        if str_starts_with(p, "exclude=") { array_push(out, str_slice(p, 8, len(p))); }
        i = i + 1;
    }
    return out;
}

fn _quick_query_line(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "line:") { return _positive_int_or_nil(str_slice(p, 5, len(p))); }
        if str_starts_with(p, "line=") { return _positive_int_or_nil(str_slice(p, 5, len(p))); }
        if str_starts_with(p, "ln:") { return _positive_int_or_nil(str_slice(p, 3, len(p))); }
        if str_starts_with(p, "ln=") { return _positive_int_or_nil(str_slice(p, 3, len(p))); }
        if str_starts_with(p, "l:") { return _positive_int_or_nil(str_slice(p, 2, len(p))); }
        if str_starts_with(p, "l=") { return _positive_int_or_nil(str_slice(p, 2, len(p))); }
        i = i + 1;
    }
    return nil;
}

fn _quick_query_col(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if str_starts_with(p, "col:") { return _positive_int_or_nil(str_slice(p, 4, len(p))); }
        if str_starts_with(p, "col=") { return _positive_int_or_nil(str_slice(p, 4, len(p))); }
        if str_starts_with(p, "column:") { return _positive_int_or_nil(str_slice(p, 7, len(p))); }
        if str_starts_with(p, "column=") { return _positive_int_or_nil(str_slice(p, 7, len(p))); }
        if str_starts_with(p, "c:") { return _positive_int_or_nil(str_slice(p, 2, len(p))); }
        if str_starts_with(p, "c=") { return _positive_int_or_nil(str_slice(p, 2, len(p))); }
        i = i + 1;
    }
    return nil;
}

fn _quick_query_without_location(query) {
    let q = str_trim(str(query));
    let parts = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        let lp = str_lower(p);
        if str_starts_with(lp, "line:") or str_starts_with(lp, "line=") or str_starts_with(lp, "ln:") or str_starts_with(lp, "ln=") or str_starts_with(lp, "l:") or str_starts_with(lp, "l=") or
           str_starts_with(lp, "col:") or str_starts_with(lp, "col=") or str_starts_with(lp, "column:") or str_starts_with(lp, "column=") or str_starts_with(lp, "c:") or str_starts_with(lp, "c=") {
            // remove navigation target tokens but keep file filters intact
        } else if p != "" {
            array_push(out, p);
        }
        i = i + 1;
    }
    return str_join(out, " ");
}

fn _quick_query_without_kind(query) {
    let q = str_lower(str_trim(str(query)));
    let parts = str_split(q, " ");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if p != "" and not str_starts_with(p, "kind:") and not str_starts_with(p, "kind=") and
           not str_starts_with(p, "type:") and not str_starts_with(p, "type=") and
           not str_starts_with(p, "ext:") and not str_starts_with(p, "ext=") and
           not str_starts_with(p, "extension:") and not str_starts_with(p, "extension=") and
           not str_starts_with(p, "name:") and not str_starts_with(p, "name=") and
           not str_starts_with(p, "path:") and not str_starts_with(p, "path=") and
           not str_starts_with(p, "not:") and not str_starts_with(p, "not=") and
           not str_starts_with(p, "exclude:") and not str_starts_with(p, "exclude=") {
            if str_starts_with(p, "line:") or str_starts_with(p, "line=") or str_starts_with(p, "ln:") or str_starts_with(p, "ln=") or str_starts_with(p, "l:") or str_starts_with(p, "l=") or
               str_starts_with(p, "col:") or str_starts_with(p, "col=") or str_starts_with(p, "column:") or str_starts_with(p, "column=") or str_starts_with(p, "c:") or str_starts_with(p, "c=") {
                // location tokens are handled by quick_open_apply_target
            } else {
            array_push(out, p);
            }
        }
        i = i + 1;
    }
    return str_join(out, " ");
}

fn _quick_kind_ok(kind, filter) {
    let k = str_lower(str_trim(str(kind)));
    let f = str_lower(str_trim(str(filter)));
    if f == "" { return true; }
    if f == "directory" or f == "folder" { f = "dir"; }
    if f == "directories" or f == "folders" { f = "dir"; }
    if f == "files" { f = "file"; }
    return k == f;
}

fn _quick_ext_ok(entry, filter) {
    let f = str_lower(str_trim(str(filter)));
    if f == "" { return true; }
    if str_starts_with(f, ".") { f = str_slice(f, 1, len(f)); }
    if f == "" { return true; }
    let kind = str_lower(str(_entry_field(entry, "kind", "file")));
    if kind == "dir" { return false; }
    let name = str_lower(str(_entry_field(entry, "name", "")));
    let path = str_lower(str(_entry_field(entry, "path", name)));
    let suffix = "." + f;
    return str_ends_with(name, suffix) or str_ends_with(path, suffix);
}

fn _quick_excludes_ok(entry, excludes) {
    if excludes == nil or len(excludes) == 0 { return true; }
    let name = str_lower(str(_entry_field(entry, "name", "")));
    let path = str_lower(str(_entry_field(entry, "path", name)));
    let kind = str_lower(str(_entry_field(entry, "kind", "file")));
    let display = str_lower(str(_entry_field(entry, "display", "")));
    let hay = name + "\n" + path + "\n" + kind + "\n" + display;
    let i = 0;
    while i < len(excludes) {
        let ex = str_lower(str_trim(str(excludes[i])));
        if ex != "" and str_contains(hay, ex) { return false; }
        i = i + 1;
    }
    return true;
}

fn _quick_rank(entry, query, name_filter, path_filter) {
    let q = str_lower(str_trim(str(query)));
    let name = str_lower(str(_entry_field(entry, "name", "")));
    let path = str_lower(str(_entry_field(entry, "path", name)));
    let display = str_lower(str(_entry_field(entry, "display", "")));
    let nf = str_lower(str_trim(str(name_filter)));
    let pf = str_lower(str_trim(str(path_filter)));
    if nf != "" and name == nf { return 0; }
    if q != "" and name == q { return 1; }
    if nf != "" and str_starts_with(name, nf) { return 2; }
    if q != "" and str_starts_with(name, q) { return 3; }
    if nf != "" and str_contains(name, nf) { return 4; }
    if q != "" and str_contains(name, q) { return 5; }
    if pf != "" and path == pf { return 6; }
    if pf != "" and str_starts_with(path, pf) { return 7; }
    if pf != "" and str_contains(path, pf) { return 8; }
    if q != "" and str_contains(path, q) { return 9; }
    if q != "" and str_contains(display, q) { return 10; }
    return 20;
}

fn _quick_label(name, kind, display) {
    if str(display) != "" { return str(display); }
    if kind == "dir" { return "[dir]  " + name; }
    return "       " + name;
}

fn _quick_tree_order(entries) {
    let i = 0;
    while entries != nil and i < len(entries) {
        if _entry_field(entries[i], "tree", false) { return true; }
        i = i + 1;
    }
    return false;
}

fn _quick_insert_ranked(out, item, limit) {
    if limit == nil or limit < 1 { limit = 100; }
    let rank = try item.rank catch 20;
    let next = [];
    let inserted = false;
    let i = 0;
    while i < len(out) and len(next) < limit {
        let other_rank = try out[i].rank catch 20;
        if not inserted and rank < other_rank {
            array_push(next, item);
            inserted = true;
        }
        if len(next) < limit { array_push(next, out[i]); }
        i = i + 1;
    }
    if not inserted and len(next) < limit { array_push(next, item); }
    return next;
}

fn _quick_push(out, entry, index, q, kind_filter, ext_filter, name_filter, path_filter, excludes, limit) {
    let name = str(_entry_field(entry, "name", entry));
    let path = str(_entry_field(entry, "path", name));
    let kind = str(_entry_field(entry, "kind", "file"));
    let display = str(_entry_field(entry, "display", ""));
    if _quick_kind_ok(kind, kind_filter) and _quick_ext_ok(entry, ext_filter) and
       _quick_excludes_ok(entry, excludes) and _quick_hit(entry, q, name_filter, path_filter) {
        let item = map{
            index: index,
            name: name,
            path: path,
            kind: kind,
            display: display,
            label: _quick_label(name, kind, display),
            rank: _quick_rank(entry, q, name_filter, path_filter)
        };
        out = _quick_insert_ranked(out, item, limit);
    }
    return out;
}

// quick_open_candidates(entries, query, limit) -> filtered file-picker rows.
// Entries can be strings or maps {name,path,kind,display}. Directories are listed
// before files unless entries opt into tree order with {tree:true}.
fn quick_open_candidates(entries, query, limit) {
    if limit == nil or limit < 1 { limit = 100; }
    let out = [];
    let kind_filter = _quick_query_kind(query);
    let ext_filter = _quick_query_ext(query);
    let name_filter = _quick_query_name(query);
    let path_filter = _quick_query_path(query);
    let excludes = _quick_query_excludes(query);
    let q = _quick_query_without_kind(query);
    if _quick_tree_order(entries) {
        let ti = 0;
        while entries != nil and ti < len(entries) {
            out = _quick_push(out, entries[ti], ti, q, kind_filter, ext_filter, name_filter, path_filter, excludes, limit);
            ti = ti + 1;
        }
        return out;
    }
    let pass = 0;
    while pass < 2 {
        let want_dir = pass == 0;
        let i = 0;
        while entries != nil and i < len(entries) {
            let e = entries[i];
            let kind = str(_entry_field(e, "kind", "file"));
            let is_dir = kind == "dir";
            if is_dir == want_dir and _quick_kind_ok(kind, kind_filter) and _quick_ext_ok(e, ext_filter) and _quick_excludes_ok(e, excludes) and _quick_hit(e, q, name_filter, path_filter) {
                out = _quick_push(out, e, i, q, kind_filter, ext_filter, name_filter, path_filter, excludes, limit);
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return out;
}

fn _push_unique_path(out, item, limit) {
    let p = str(_entry_field(item, "path", item));
    let i = 0;
    while i < len(out) {
        if str(try out[i].path catch out[i]) == p { return len(out); }
        i = i + 1;
    }
    if len(out) < limit { array_push(out, item); }
    return len(out);
}

fn quick_open_with_recent(entries, recent, query, limit) {
    if limit == nil or limit < 1 { limit = 100; }
    if limit > 300 { limit = 300; }
    let out = [];
    let recent_hits = quick_open_candidates(recent_files_entries(recent, 30), query, limit);
    let ri = 0;
    while ri < len(recent_hits) and len(out) < limit {
        _push_unique_path(out, recent_hits[ri], limit);
        ri = ri + 1;
    }
    let normal_hits = quick_open_candidates(entries, query, limit);
    let ni = 0;
    while ni < len(normal_hits) and len(out) < limit {
        _push_unique_path(out, normal_hits[ni], limit);
        ni = ni + 1;
    }
    return out;
}

fn quick_open_search_query(query) {
    if _quick_query_line(query) != nil { return _quick_query_without_location(query); }
    let target = open_path_target(query);
    if try target.has_line catch false { return str(try target.path catch query); }
    return _quick_query_without_location(query);
}

fn quick_open_apply_target(path, query) {
    let line = _quick_query_line(query);
    let col = _quick_query_col(query);
    let has_line = line != nil;
    let has_col = col != nil;
    if col == nil { col = 1; }
    if not has_line {
        let target = open_path_target(query);
        line = try target.line catch 1;
        col = try target.col catch 1;
        has_line = try target.has_line catch false;
        has_col = try target.has_col catch false;
    }
    if not has_line { return str(path); }
    let out = str(path) + ":" + str(line);
    if has_col { out = out + ":" + str(col); }
    return out;
}

fn quick_open_target_label(query) {
    let line = _quick_query_line(query);
    let col = _quick_query_col(query);
    let has_line = line != nil;
    let has_col = col != nil;
    if col == nil { col = 1; }
    if not has_line {
        let target = open_path_target(query);
        line = try target.line catch 1;
        col = try target.col catch 1;
        has_line = try target.has_line catch false;
        has_col = try target.has_col catch false;
    }
    if not has_line { return ""; }
    let label = "target L" + str(line);
    if has_col { label = label + ":C" + str(col); }
    let search = str_trim(quick_open_search_query(query));
    if search != "" { label = label + " search '" + search + "'"; }
    return label;
}

fn quick_open_status(query, selected, hits, dir, recent_count) {
    let q = str_trim(str(query));
    let d = str(try dir catch ".");
    let rc = try parse_number(str(recent_count)) catch 0;
    if rc == nil { rc = 0; }
    rc = num_floor(rc);
    if rc < 0 { rc = 0; }
    let n = 0;
    if hits != nil { n = len(hits); }
    let s = "quick open: " + d + "  recent " + str(rc) + "  results " + str(n);
    if q != "" { s = s + " for '" + q + "'"; }
    let target_label = quick_open_target_label(q);
    if target_label != "" { s = s + "  " + target_label; }
    if n == 0 { return s + "  Enter tries typed path"; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= n { sel = n - 1; }
    let h = hits[sel];
    let hit_path = str(try h.path catch try h.name catch "");
    let out = s + "  sel " + str(sel + 1) + "/" + str(n) + "  " +
        str(try h.kind catch "file") + "  " + hit_path;
    if target_label != "" { out = out + "  opens " + quick_open_apply_target(hit_path, q); }
    return out;
}

fn quick_open_hint(query) {
    let q = str_trim(str(query));
    let target_label = quick_open_target_label(q);
    if target_label != "" { return "hint: " + target_label + "; Enter opens selected file at that location"; }
    let kind = _quick_query_kind(q);
    let ext = _quick_query_ext(q);
    let namef = _quick_query_name(q);
    let pathf = _quick_query_path(q);
    let excludes = _quick_query_excludes(q);
    let rest = _quick_query_without_kind(q);
    let parts = [];
    if kind != "" { array_push(parts, "kind " + kind); }
    if ext != "" { array_push(parts, "ext " + ext); }
    if namef != "" { array_push(parts, "name " + namef); }
    if pathf != "" { array_push(parts, "path " + pathf); }
    if len(excludes) > 0 { array_push(parts, "not " + str_join(excludes, "/")); }
    if len(parts) > 0 {
        let base = "filter: " + str_join(parts, " + ");
        if rest != "" { return base + " + text '" + rest + "'"; }
        return base + " active; add text to narrow";
    }
    if rest != "" { return "hint: multi-word search is AND; add kind:dir, kind=file, ext:sapp, type:folder, name:main, path:src, or not:test"; }
    return "hint: type words or use kind:dir / kind=file / ext:sapp / name:main / not:test";
}

fn quick_open_empty_message(query) {
    let q = str_trim(str(query));
    let msg = "No match";
    if q != "" { msg = msg + " for `" + q + "`"; }
    return msg + ". Enter tries typed path. " + quick_open_hint(q);
}

fn file_filter_examples(limit) {
    let items = ["kind:dir", "kind=file", "ext:sapp", "name:main", "path:src", "not:test"];
    if limit == nil or limit < 1 { limit = len(items); }
    if limit > len(items) { limit = len(items); }
    let out = [];
    let i = 0;
    while i < limit {
        array_push(out, items[i]);
        i = i + 1;
    }
    return out;
}

fn file_filter_examples_line(limit) {
    return "filters: " + str_join(file_filter_examples(limit), " ");
}

fn files_panel_status(query, selected, hits, dir, mode) {
    let q = str_trim(str(query));
    let d = str(try dir catch ".");
    let m = str(try mode catch "flat");
    let n = 0;
    if hits != nil { n = len(hits); }
    let s = "files " + m + ": " + d + "  results " + str(n);
    if q != "" { s = s + " for '" + q + "'"; }
    if n == 0 { return s; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= n { sel = n - 1; }
    let h = hits[sel];
    return s + "  sel " + str(sel + 1) + "/" + str(n) + "  " +
        str(try h.kind catch "file") + "  " + str(try h.path catch try h.name catch "");
}

fn files_panel_hint(query) {
    let h = quick_open_hint(query);
    if str_starts_with(h, "hint:") { return "files " + h; }
    return "files " + h;
}

fn files_panel_empty_message(query, mode) {
    let q = str_trim(str(query));
    let m = str(try mode catch "flat");
    let msg = "No matching files";
    if m == "recent" { msg = "No recent files yet"; }
    if q != "" { msg = msg + " for `" + q + "`"; }
    return msg + ". " + files_panel_hint(q);
}

fn file_explorer_action_line(hit) {
    if hit == nil { return "files actions: no selection"; }
    let kind = str(try hit.kind catch "file");
    if kind == "dir" {
        return "files actions: Enter open folder · Ctrl+B bookmark root · Ctrl+C copy · Ctrl+X cut · Ctrl+V paste plan · Ctrl+I inspect";
    }
    let profile = editor_asset_profile(try hit.path catch try hit.name catch "");
    return "files actions: Enter open · Space preview · Ctrl+C copy · Ctrl+X cut · Ctrl+V paste plan · Ctrl+I inspect · Ctrl+U transfer plan · " +
        str(try profile.editor catch "text") + "/" + str(try profile.family catch "file");
}

fn file_explorer_operation_plan(action, source, target) {
    let act = str_lower(str_trim(str(action)));
    let src = str_trim(str(source));
    let dst = str_trim(str(target));
    let profile = editor_asset_profile(src);
    let destructive = act == "delete" or act == "move" or act == "rename";
    let needs_target = act == "copy" or act == "move" or act == "rename" or act == "upload" or act == "download";
    let ok = src != "";
    if needs_target and dst == "" { ok = false; }
    let family = str(try profile.family catch "file");
    let summary = act + " " + src;
    if dst != "" { summary = summary + " -> " + dst; }
    let requires = ["explicit user action", "path validation", "operation result shown in Files output"];
    if act == "upload" or act == "download" {
        array_push(requires, "remote profile");
        array_push(requires, "network/transfer permission");
    }
    if destructive { array_push(requires, "destructive confirmation"); }
    return map{
        ok: ok,
        action: act,
        source: src,
        target: dst,
        family: family,
        read_only: act == "inspect" or act == "preview" or act == "copy_path",
        destructive: destructive,
        requires: requires,
        summary: summary
    };
}

fn file_explorer_operation_summary(plan) {
    if plan == nil { return "file operation: none"; }
    let status = "ready";
    if not (try plan.ok catch false) { status = "needs target/source"; }
    let flags = "read";
    if try plan.destructive catch false { flags = "destructive"; }
    else if not (try plan.read_only catch false) { flags = "write"; }
    return "file operation " + status + " [" + flags + "]: " + str(try plan.summary catch "");
}

fn file_explorer_breadcrumbs(path) {
    let p = str_trim(str(path));
    let out = [];
    if p == "" { return out; }
    let absolute = str_starts_with(p, "/");
    let parts = str_split(p, "/");
    let cur = "";
    if absolute {
        cur = "/";
        array_push(out, map{ label: "/", path: "/", index: 0 });
    }
    let i = 0;
    while i < len(parts) {
        let part = str_trim(parts[i]);
        if part != "" {
            if cur == "" or cur == "/" { cur = cur + part; }
            else { cur = cur + "/" + part; }
            array_push(out, map{ label: part, path: cur, index: len(out) });
        }
        i = i + 1;
    }
    return out;
}

fn file_explorer_breadcrumb_line(path) {
    let crumbs = file_explorer_breadcrumbs(path);
    if len(crumbs) == 0 { return "path: ."; }
    let line = "path:";
    let i = 0;
    while i < len(crumbs) {
        let label = str(try crumbs[i].label catch "");
        if i == 0 and label == "/" { line = line + " /"; }
        else if str_ends_with(line, " /") { line = line + label; }
        else { line = line + " / " + label; }
        i = i + 1;
    }
    return line;
}

fn file_explorer_selection_detail_lines(hit, current_dir) {
    if hit == nil {
        return ["Selection", "No file selected.", file_explorer_breadcrumb_line(current_dir)];
    }
    let p = str(try hit.path catch try hit.name catch "");
    let profile = editor_asset_profile(p);
    return [
        "Selection",
        "Name: " + str(try hit.name catch _path_basename(p)),
        "Kind: " + str(try hit.kind catch "file"),
        "Path: " + p,
        "Profile: " + str(try profile.editor catch "text") + "/" + str(try profile.family catch "file"),
        file_explorer_breadcrumb_line(current_dir),
        file_explorer_action_line(hit)
    ];
}

fn file_explorer_clipboard_record(action, hit) {
    let act = str_lower(str_trim(str(action)));
    if act != "copy" and act != "cut" { act = "copy"; }
    if hit == nil { return map{ ok: false, action: act, path: "", name: "", kind: "", message: "no selection" }; }
    let p = str(try hit.path catch try hit.name catch "");
    let op = "copy";
    if act == "cut" { op = "move"; }
    return map{
        ok: p != "",
        action: act,
        operation: op,
        path: p,
        name: str(try hit.name catch _path_basename(p)),
        kind: str(try hit.kind catch "file"),
        message: act + " " + p
    };
}

fn file_explorer_clipboard_summary(cb) {
    if cb == nil or not (try cb.ok catch false) { return "files clipboard: empty"; }
    return "files clipboard: " + str(try cb.action catch "copy") + " " + str(try cb.path catch "");
}

fn file_explorer_paste_plan(cb, dest_dir) {
    if cb == nil or not (try cb.ok catch false) {
        return file_explorer_operation_plan("paste", "", "");
    }
    let dest = str_trim(str(dest_dir));
    if dest == "" { dest = "."; }
    let name = str(try cb.name catch _path_basename(try cb.path catch ""));
    let target = dest;
    if not str_ends_with(target, "/") { target = target + "/"; }
    target = target + name;
    return file_explorer_operation_plan(str(try cb.operation catch "copy"), str(try cb.path catch ""), target);
}

fn file_explorer_status_line(current_dir, cb, remote) {
    return file_explorer_breadcrumb_line(current_dir) + "  ·  " +
        file_explorer_clipboard_summary(cb) + "  ·  " +
        file_transfer_profile_summary(remote);
}

fn file_transfer_profile(name, host, path, protocol = "sftp") {
    let proto = str_lower(str_trim(str(protocol)));
    if proto == "" { proto = "sftp"; }
    return map{
        name: str_trim(str(name)),
        host: str_trim(str(host)),
        path: str_trim(str(path)),
        protocol: proto,
        ok: str_trim(str(host)) != "" and str_trim(str(path)) != "",
        note: "remote profile stores no password; credentials stay outside PBIDE"
    };
}

fn file_transfer_profile_summary(profile) {
    if profile == nil or not (try profile.ok catch false) {
        return "remote profile: not configured";
    }
    return "remote profile: " + str(try profile.name catch "remote") + " " +
        str(try profile.protocol catch "sftp") + "://" + str(try profile.host catch "") +
        str(try profile.path catch "");
}

fn _root_push_unique(out, path) {
    let p = str_trim(str(path));
    if p == "" { return len(out); }
    let i = 0;
    while i < len(out) {
        if out[i] == p { return len(out); }
        i = i + 1;
    }
    array_push(out, p);
    return len(out);
}

fn _path_dir(path) {
    let p = str(path);
    if p == "" { return ""; }
    if str_ends_with(p, "/") { return p; }
    let last = 0 - 1;
    let i = 0;
    while i < len(p) {
        if strcharcodeat(p, i) == 47 { last = i; }
        i = i + 1;
    }
    if last <= 0 { return "."; }
    return str_slice(p, 0, last);
}

fn _path_base_name(path) {
    let p = str_trim(str(path));
    if p == "" { return ""; }
    let end = len(p);
    while end > 1 and (strcharcodeat(p, end - 1) == 47 or strcharcodeat(p, end - 1) == 92) {
        end = end - 1;
    }
    let last = 0 - 1;
    let i = 0;
    while i < end {
        let c = strcharcodeat(p, i);
        if c == 47 or c == 92 { last = i; }
        i = i + 1;
    }
    if end == 1 and last == 0 { return "/"; }
    if last < 0 { return str_slice(p, 0, end); }
    if last >= end - 1 { return str_slice(p, 0, end); }
    return str_slice(p, last + 1, end);
}

fn project_root_label(path) {
    let p = str_trim(str(path));
    if p == "" { return "workspace"; }
    if p == "." { return "current"; }
    let b = _path_base_name(p);
    if b == "" { return p; }
    return b;
}

fn project_root_group(path) {
    let p = str_trim(str(path));
    if p == "" or p == "." { return "relative"; }
    if str_starts_with(p, "/home/") { return "home"; }
    if str_starts_with(p, "/media/") or str_starts_with(p, "/mnt/") { return "drive"; }
    if str_starts_with(p, "/") { return "system"; }
    if str_starts_with(p, "..") { return "relative"; }
    return "project";
}

fn _project_root_meta_field(value) {
    let s = str_trim(str(value));
    let cleaned = str_replace_all(str_replace_all(str_replace_all(s, "\n", " "), "\r", " "), "\t", " ");
    return str_replace_all(cleaned, "|", "/");
}

fn project_root_meta_record(path, label, group) {
    let p = str_trim(str(path));
    let lbl = _project_root_meta_field(label);
    if lbl == "" { lbl = project_root_label(p); }
    let grp = _project_root_meta_field(group);
    if grp == "" { grp = project_root_group(p); }
    return map{ path: p, label: lbl, group: grp, edited: true };
}

fn project_root_meta_get(meta, path) {
    let p = str_trim(str(path));
    let i = 0;
    while meta != nil and i < len(meta) {
        let m = meta[i];
        if str(try m.path catch "") == p {
            return project_root_meta_record(p, try m.label catch "", try m.group catch "");
        }
        i = i + 1;
    }
    return map{ path: p, label: project_root_label(p), group: project_root_group(p), edited: false };
}

fn project_root_meta_set(meta, path, label, group) {
    let p = str_trim(str(path));
    let out = [];
    if p == "" { return out; }
    let rec = project_root_meta_record(p, label, group);
    let found = false;
    let i = 0;
    while meta != nil and i < len(meta) {
        let m = meta[i];
        let mp = str_trim(str(try m.path catch ""));
        if mp == p {
            if not found {
                array_push(out, rec);
                found = true;
            }
        } else if mp != "" {
            array_push(out, project_root_meta_record(mp, try m.label catch "", try m.group catch ""));
        }
        i = i + 1;
    }
    if not found { array_push(out, rec); }
    return out;
}

fn project_root_meta_next_group(meta, path) {
    let cur = project_root_meta_get(meta, path);
    let groups = ["project", "home", "drive", "system", "relative", "code", "docs", "data", "media", "favorite"];
    let idx = 0;
    let i = 0;
    while i < len(groups) {
        if groups[i] == str(try cur.group catch "") { idx = i; }
        i = i + 1;
    }
    idx = idx + 1;
    if idx >= len(groups) { idx = 0; }
    return project_root_meta_set(meta, path, try cur.label catch project_root_label(path), groups[idx]);
}

fn project_root_meta_to_text(meta) {
    let out = "";
    let i = 0;
    while meta != nil and i < len(meta) {
        let m = project_root_meta_record(try meta[i].path catch "", try meta[i].label catch "", try meta[i].group catch "");
        if str(try m.path catch "") != "" {
            out = out + "#meta|" + str(m.path) + "|" + str(m.label) + "|" + str(m.group) + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn project_root_meta_from_text(text) {
    let out = [];
    let lines = str_split(str(text), "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(str(lines[i]));
        if str_starts_with(line, "#meta|") {
            let parts = str_split(line, "|");
            if len(parts) >= 4 {
                out = project_root_meta_set(out, parts[1], parts[2], parts[3]);
            }
        }
        i = i + 1;
    }
    return out;
}

fn project_roots_file_to_text(roots, meta) {
    return "# pblang native IDE project roots\n" + project_root_meta_to_text(meta) + project_roots_to_text(roots);
}

fn project_roots(cwd, file_path, extras) {
    let out = [];
    _root_push_unique(out, cwd);
    let fp = str_trim(str(file_path));
    if fp != "" { _root_push_unique(out, _path_dir(fp)); }
    let i = 0;
    while extras != nil and i < len(extras) {
        _root_push_unique(out, extras[i]);
        i = i + 1;
    }
    if len(out) == 0 { array_push(out, "."); }
    return out;
}

fn project_roots_to_text(roots) {
    let clean = [];
    let j = 0;
    while roots != nil and j < len(roots) {
        _root_push_unique(clean, roots[j]);
        j = j + 1;
    }
    let out = "";
    let i = 0;
    while i < len(clean) {
        let p = str_trim(str(clean[i]));
        if p != "" { out = out + p + "\n"; }
        i = i + 1;
    }
    return out;
}

fn project_roots_from_text(text, fallback) {
    let parsed = [];
    let lines = str_split(str(text), "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(str(lines[i]));
        if line != "" and not str_starts_with(line, "#") {
            _root_push_unique(parsed, line);
        }
        i = i + 1;
    }
    if len(parsed) == 0 {
        if fallback == nil or len(fallback) == 0 { return []; }
        return project_roots("", "", fallback);
    }
    return project_roots("", "", parsed);
}

fn project_roots_merge_saved(cwd, file_path, saved_text) {
    let saved = project_roots_from_text(saved_text, []);
    return project_roots(cwd, file_path, saved);
}

fn project_root_records(roots, current) {
    let clean = project_roots("", "", roots);
    let cur = str(current);
    let out = [];
    let i = 0;
    while i < len(clean) {
        let p = str(clean[i]);
        array_push(out, map{
            index: i,
            path: p,
            label: project_root_label(p),
            group: project_root_group(p),
            current: p == cur
        });
        i = i + 1;
    }
    return out;
}

fn project_root_records_with_meta(roots, current, meta) {
    let clean = project_roots("", "", roots);
    let cur = str(current);
    let out = [];
    let i = 0;
    while i < len(clean) {
        let p = str(clean[i]);
        let m = project_root_meta_get(meta, p);
        array_push(out, map{
            index: i,
            path: p,
            label: try m.label catch project_root_label(p),
            group: try m.group catch project_root_group(p),
            current: p == cur,
            edited: try m.edited catch false
        });
        i = i + 1;
    }
    return out;
}

fn project_root_status(roots, current) {
    let records = project_root_records(roots, current);
    if len(records) == 0 { return "root 0/0"; }
    let idx = project_root_index(roots, current);
    if idx < 0 { idx = 0; }
    if idx >= len(records) { idx = len(records) - 1; }
    let r = records[idx];
    return "root " + str(idx + 1) + "/" + str(len(records)) + " " +
        str(try r.label catch "?") + " [" + str(try r.group catch "?") + "] " +
        str(try r.path catch current);
}

fn project_root_status_with_meta(roots, current, meta) {
    let records = project_root_records_with_meta(roots, current, meta);
    if len(records) == 0 { return "root 0/0"; }
    let idx = project_root_index(roots, current);
    if idx < 0 { idx = 0; }
    if idx >= len(records) { idx = len(records) - 1; }
    let r = records[idx];
    let mark = "";
    if try r.edited catch false { mark = "*"; }
    return "root " + str(idx + 1) + "/" + str(len(records)) + " " +
        str(try r.label catch "?") + mark + " [" + str(try r.group catch "?") + "] " +
        str(try r.path catch current);
}

fn project_root_edit_summary(meta, path) {
    let r = project_root_meta_get(meta, path);
    let mark = "";
    if try r.edited catch false { mark = " edited"; }
    return "root metadata" + mark + ": " + str(try r.label catch project_root_label(path)) +
        " [" + str(try r.group catch project_root_group(path)) + "] " + str(path);
}

fn project_root_index(roots, current) {
    let cur = str(current);
    let i = 0;
    while roots != nil and i < len(roots) {
        if str(roots[i]) == cur { return i; }
        i = i + 1;
    }
    return 0;
}

fn project_root_cycle(roots, current, dir) {
    if roots == nil or len(roots) == 0 { return map{ index: 0, path: "." }; }
    let idx = project_root_index(roots, current) + dir;
    while idx < 0 { idx = idx + len(roots); }
    while idx >= len(roots) { idx = idx - len(roots); }
    return map{ index: idx, path: roots[idx] };
}

fn project_tree_settings(depth, max_items) {
    let d = try parse_number(str(depth)) catch 3;
    if d == nil { d = 3; }
    if d < 1 { d = 1; }
    if d > 8 { d = 8; }
    let m = try parse_number(str(max_items)) catch 600;
    if m == nil { m = 600; }
    if m < 50 { m = 50; }
    if m > 5000 { m = 5000; }
    return map{ depth: d, max_items: m };
}

fn project_tree_depth_delta(depth, delta) {
    let settings = project_tree_settings(depth + delta, 600);
    return settings.depth;
}

fn _path_basename(path) {
    let p = str(path);
    if p == "" { return ""; }
    let last = 0 - 1;
    let i = 0;
    while i < len(p) {
        if strcharcodeat(p, i) == 47 or strcharcodeat(p, i) == 92 { last = i; }
        i = i + 1;
    }
    if last < 0 { return p; }
    if last >= len(p) - 1 { return p; }
    return str_slice(p, last + 1, len(p));
}

fn recent_files_push(recent, path, limit) {
    if limit == nil or limit < 1 { limit = 30; }
    if limit > 200 { limit = 200; }
    let p = str_trim(str(path));
    let out = [];
    if p != "" { array_push(out, p); }
    let i = 0;
    while recent != nil and i < len(recent) and len(out) < limit {
        let item = str_trim(str(recent[i]));
        let seen = false;
        let j = 0;
        while j < len(out) {
            if out[j] == item { seen = true; }
            j = j + 1;
        }
        if item != "" and not seen { array_push(out, item); }
        i = i + 1;
    }
    return out;
}

fn recent_files_remove(recent, path) {
    let p = str_trim(str(path));
    let out = [];
    let i = 0;
    while recent != nil and i < len(recent) {
        let item = str_trim(str(recent[i]));
        if item != "" and item != p { array_push(out, item); }
        i = i + 1;
    }
    return out;
}

fn recent_files_entries(recent, limit) {
    if limit == nil or limit < 1 { limit = 30; }
    if limit > 200 { limit = 200; }
    let out = [];
    let i = 0;
    while recent != nil and i < len(recent) and len(out) < limit {
        let p = str_trim(str(recent[i]));
        if p != "" {
            let name = _path_basename(p);
            if name == "" { name = p; }
            array_push(out, map{
                name: name,
                path: p,
                kind: "file",
                display: "[recent] " + name,
                tree: true
            });
        }
        i = i + 1;
    }
    return out;
}

fn _line_text(code, line) {
    let lines = str_split(code, "\n");
    if line < 1 or line > len(lines) { return ""; }
    return lines[line - 1];
}

fn _quoted_name(message) {
    let a = str_index_of(message, "'");
    if a < 0 { return ""; }
    let rest = str_slice(message, a + 1, len(message));
    let b = str_index_of(rest, "'");
    if b < 0 { return ""; }
    return str_slice(rest, 0, b);
}

fn normalize_diagnostic(code, diag, index) {
    let msg = str(try diag.message catch diag);
    let kind = str(try diag.kind catch try diag.stage catch "info");
    let line = try diag.line catch nil;
    let col = try diag.col catch try diag.column catch nil;
    if line == nil {
        let name = _quoted_name(msg);
        if name != "" {
            let hits = find_all(code, name);
            if len(hits) > 0 {
                line = hits[0].line;
                col = hits[0].col;
            }
        }
    }
    if line == nil { line = 1; }
    if col == nil { col = 1; }
    if line < 1 { line = 1; }
    if col < 1 { col = 1; }
    return map{
        index: index,
        kind: kind,
        message: msg,
        line: line,
        col: col,
        source: _line_text(code, line),
    };
}

fn normalize_diagnostics(code, diagnostics) {
    let out = [];
    let i = 0;
    while diagnostics != nil and i < len(diagnostics) {
        array_push(out, normalize_diagnostic(code, diagnostics[i], i));
        i = i + 1;
    }
    return out;
}

fn diagnostic_summary(diagnostics, limit) {
    if diagnostics == nil or len(diagnostics) == 0 {
        return ["No diagnostics. F6 Check passed."];
    }
    if limit == nil or limit < 1 { limit = len(diagnostics); }
    let out = [];
    let i = 0;
    while i < len(diagnostics) and i < limit {
        let d = diagnostics[i];
        array_push(out, str(i + 1) + ". " + str_upper(str(try d.kind catch "info")) +
            " L" + str(try d.line catch 1) + ":C" + str(try d.col catch 1) +
            " " + str(try d.message catch "diagnostic"));
        i = i + 1;
    }
    return out;
}

fn diagnostic_counts(diagnostics) {
    let errors = 0;
    let warnings = 0;
    let info = 0;
    let other = 0;
    let i = 0;
    while diagnostics != nil and i < len(diagnostics) {
        let k = str_lower(str(try diagnostics[i].kind catch "info"));
        if k == "error" { errors = errors + 1; }
        else if k == "warning" or k == "warn" { warnings = warnings + 1; }
        else if k == "info" or k == "note" or k == "hint" { info = info + 1; }
        else { other = other + 1; }
        i = i + 1;
    }
    return map{
        total: errors + warnings + info + other,
        errors: errors,
        warnings: warnings,
        info: info,
        other: other
    };
}

fn diagnostic_counts_label(diagnostics) {
    let c = diagnostic_counts(diagnostics);
    if c.total == 0 { return "diagnostics: clean"; }
    let parts = [];
    if c.errors > 0 { array_push(parts, str(c.errors) + " error(s)"); }
    if c.warnings > 0 { array_push(parts, str(c.warnings) + " warning(s)"); }
    if c.info > 0 { array_push(parts, str(c.info) + " info"); }
    if c.other > 0 { array_push(parts, str(c.other) + " other"); }
    return "diagnostics: " + str_join(parts, ", ");
}

fn filter_diagnostics(diagnostics, query, limit) {
    if limit == nil or limit < 1 { limit = 1000; }
    if limit > 10000 { limit = 10000; }
    let q = str_lower(str_trim(str(query)));
    let out = [];
    let i = 0;
    while diagnostics != nil and i < len(diagnostics) and len(out) < limit {
        let d = diagnostics[i];
        let hay = str_lower(
            str(try d.kind catch "info") + "\n" +
            str(try d.message catch "") + "\n" +
            str(try d.source catch "") + "\n" +
            "l" + str(try d.line catch 1) + "\n" +
            "c" + str(try d.col catch 1)
        );
        if q == "" or str_contains(hay, q) {
            array_push(out, map{
                index: i,
                kind: try d.kind catch "info",
                message: try d.message catch "diagnostic",
                line: try d.line catch 1,
                col: try d.col catch 1,
                source: try d.source catch ""
            });
        }
        i = i + 1;
    }
    return out;
}

fn diagnostic_filter_status(diagnostics, query, selected) {
    let total = len(try diagnostics catch []);
    let q = str_trim(str(query));
    if total == 0 { return "filter: no diagnostics"; }
    let hits = filter_diagnostics(diagnostics, q, 10000);
    let prefix = "filter: all " + str(total) + " diagnostic(s)";
    if q != "" { prefix = "filter: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits));
}

fn selection_move(current, count, action, page_size) {
    let n = try parse_number(str(count)) catch 0;
    if n == nil or n < 1 { return 0; }
    n = num_floor(n);
    let cur = try parse_number(str(current)) catch 0;
    if cur == nil { cur = 0; }
    cur = num_floor(cur);
    let page = try parse_number(str(page_size)) catch 10;
    if page == nil or page < 1 { page = 10; }
    page = num_floor(page);
    let a = str_lower(str(action));
    if a == "home" or a == "first" { cur = 0; }
    else if a == "end" or a == "last" { cur = n - 1; }
    else if a == "next" or a == "down" { cur = cur + 1; }
    else if a == "prev" or a == "previous" or a == "up" { cur = cur - 1; }
    else if a == "page_down" or a == "pagedown" { cur = cur + page; }
    else if a == "page_up" or a == "pageup" { cur = cur - page; }
    if cur < 0 { cur = 0; }
    if cur >= n { cur = n - 1; }
    return cur;
}

fn diagnostics_at_line(diagnostics, line) {
    let target = try parse_number(str(line)) catch 1;
    if target == nil { target = 1; }
    target = num_floor(target);
    let out = [];
    let i = 0;
    while diagnostics != nil and i < len(diagnostics) {
        let d = diagnostics[i];
        let ln = try d.line catch nil;
        if ln != nil and num_floor(ln) == target { array_push(out, d); }
        i = i + 1;
    }
    return out;
}

fn diagnostic_line_status(diagnostics, line) {
    let hits = diagnostics_at_line(diagnostics, line);
    if len(hits) == 0 { return ""; }
    let first = hits[0];
    let kind = str_lower(str(try first.kind catch "info"));
    let msg = _one_line(try first.message catch "diagnostic", 48);
    let suffix = "";
    if len(hits) > 1 { suffix = " +" + str(len(hits) - 1); }
    return "line " + kind + ": " + msg + suffix;
}

fn diagnostic_line_marker(diagnostics, line) {
    let hits = diagnostics_at_line(diagnostics, line);
    if len(hits) == 0 { return map{ marker: "", severity: "none", count: 0, label: "" }; }
    let severity = "info";
    let marker = "I";
    let i = 0;
    while i < len(hits) {
        let k = str_lower(str(try hits[i].kind catch "info"));
        if k == "error" {
            severity = "error";
            marker = "E";
            break;
        }
        if k == "warning" or k == "warn" {
            if severity != "error" {
                severity = "warning";
                marker = "W";
            }
        } else if not (k == "info" or k == "note" or k == "hint") {
            if severity == "info" {
                severity = "other";
                marker = "?";
            }
        }
        i = i + 1;
    }
    let label = severity;
    if len(hits) > 1 { label = label + " x" + str(len(hits)); }
    return map{ marker: marker, severity: severity, count: len(hits), label: label };
}

fn diagnostic_detail_lines(diag, limit) {
    if limit == nil or limit < 1 { limit = 3; }
    if limit > 8 { limit = 8; }
    if diag == nil { return ["No diagnostic selected."]; }
    let out = [];
    let kind = str_upper(str(try diag.kind catch "info"));
    let loc = "L" + str(try diag.line catch 1) + ":C" + str(try diag.col catch 1);
    array_push(out, kind + " " + loc);
    if len(out) < limit { array_push(out, _one_line(try diag.message catch "diagnostic", 96)); }
    let src = str_trim(str(try diag.source catch ""));
    if src != "" and len(out) < limit { array_push(out, "source: " + _one_line(src, 96)); }
    return out;
}

// status_text(info) -> a VSCode-style status-bar string.
fn status_text(info) {
    let path = str(try info.path catch "untitled");
    let modified = try info.modified catch false;
    let m = "";
    if modified { m = " *"; }
    let ln = str(try info.line catch 1);
    let col = str(try info.col catch 1);
    let lines = str(try info.lines catch 0);
    let lang = str(try info.lang catch "pblang");
    let text = path + m + "  |  Ln " + ln + ", Col " + col + "  |  " + lines + " lines";
    let chars = try info.chars catch nil;
    if chars != nil { text = text + "  |  " + str(chars) + " chars"; }
    let diagnostics = try info.diagnostics catch nil;
    if diagnostics != nil { text = text + "  |  diagnostics: " + str(diagnostics); }
    let selected = try info.selection_chars catch nil;
    if selected != nil and selected > 0 { text = text + "  |  sel " + str(selected) + " chars"; }
    return text + "  |  " + lang;
}

fn goto_line_target(input, total_lines) {
    let total = try parse_number(str(total_lines)) catch 1;
    if total == nil or total < 1 { total = 1; }
    let n = try parse_number(str_trim(str(input))) catch 1;
    if n == nil { n = 1; }
    n = num_floor(n);
    if n < 1 { n = 1; }
    if n > total { n = total; }
    return map{ line: n, row: n - 1, col: 0, total: total };
}

fn _positive_int_or_nil(text) {
    let t = str_trim(str(text));
    if t == "" { return nil; }
    let n = try parse_number(t) catch nil;
    if n == nil { return nil; }
    n = num_floor(n);
    if n < 1 { return nil; }
    return n;
}

fn open_path_target(input) {
    let raw = str_trim(str(input));
    let parts = str_split(raw, ":");
    let n = len(parts);
    if n < 2 { return map{ path: raw, line: 1, col: 1, has_line: false, has_col: false }; }
    let last = _positive_int_or_nil(parts[n - 1]);
    if last == nil { return map{ path: raw, line: 1, col: 1, has_line: false, has_col: false }; }
    let before = nil;
    if n >= 3 { before = _positive_int_or_nil(parts[n - 2]); }
    let path_end = n - 1;
    let line = last;
    let col = 1;
    let has_col = false;
    if before != nil {
        line = before;
        col = last;
        has_col = true;
        path_end = n - 2;
    }
    let path_parts = [];
    let i = 0;
    while i < path_end {
        array_push(path_parts, parts[i]);
        i = i + 1;
    }
    let path = str_join(path_parts, ":");
    if str_trim(path) == "" { path = raw; line = 1; col = 1; has_col = false; return map{ path: path, line: line, col: col, has_line: false, has_col: false }; }
    return map{ path: path, line: line, col: col, has_line: true, has_col: has_col };
}

fn open_path_target_status(target) {
    let p = str(try target.path catch "");
    if not (try target.has_line catch false) { return p; }
    let s = p + ":" + str(try target.line catch 1);
    if try target.has_col catch false { s = s + ":" + str(try target.col catch 1); }
    return s;
}

fn _same_location(a, b) {
    if a == nil or b == nil { return false; }
    return str(try a.path catch "") == str(try b.path catch "")
        and (try a.line catch 1) == (try b.line catch 1)
        and (try a.col catch 1) == (try b.col catch 1);
}

fn navigation_push(stack, loc, limit) {
    if limit == nil or limit < 1 { limit = 80; }
    if limit > 500 { limit = 500; }
    let out = [];
    if loc != nil { array_push(out, loc); }
    let i = 0;
    while stack != nil and i < len(stack) and len(out) < limit {
        let item = stack[i];
        if not _same_location(item, loc) { array_push(out, item); }
        i = i + 1;
    }
    return out;
}

fn navigation_step(source, other, current, limit) {
    if source == nil or len(source) == 0 {
        return map{ ok: false, source: [], other: other, target: nil };
    }
    let target = source[0];
    let rest = [];
    let i = 1;
    while i < len(source) {
        array_push(rest, source[i]);
        i = i + 1;
    }
    return map{
        ok: true,
        source: rest,
        other: navigation_push(other, current, limit),
        target: target
    };
}

fn _one_line(s, max_len) {
    let t = str_trim(str_replace_all(str(s), "\n", " "));
    if max_len < 4 { max_len = 4; }
    if len(t) <= max_len { return t; }
    return str_slice(t, 0, max_len - 3) + "...";
}

fn history_mode_next(mode) {
    let m = str_lower(str_trim(str(mode)));
    if m == "permanent" or m == "persistent" or m == "saved" { return "temporary"; }
    return "permanent";
}

fn history_mode_label(mode) {
    let m = str_lower(str_trim(str(mode)));
    if m == "permanent" or m == "persistent" or m == "saved" { return "Permanent"; }
    return "Temporary";
}

// make_history_record(action, ok, output, code) -> one IDE history entry.
fn make_history_record(action, ok, output, code, mode = "temporary") {
    let ts = try now_iso() catch "now";
    let m = str_lower(str_trim(str(mode)));
    if m != "permanent" { m = "temporary"; }
    return map{
        action: str(action),
        ok: ok,
        output: str(output),
        code: str(code),
        summary: _one_line(output, 96),
        ts: ts,
        storage: m,
        stored: false,
    };
}

// push_history(history, action, ok, output, code, limit) -> newest-first bounded history.
fn push_history_with_mode(history, action, ok, output, code, limit, mode) {
    if limit == nil or limit < 1 { limit = 30; }
    let out = [make_history_record(action, ok, output, code, mode)];
    let i = 0;
    while history != nil and i < len(history) and len(out) < limit {
        array_push(out, history[i]);
        i = i + 1;
    }
    return out;
}

fn push_history(history, action, ok, output, code, limit) {
    return push_history_with_mode(history, action, ok, output, code, limit, "temporary");
}

fn history_mark_stored(history, stored) {
    let out = [];
    let i = 0;
    while history != nil and i < len(history) {
        let h = history[i];
        h.stored = stored;
        if stored { h.storage = "permanent"; }
        array_push(out, h);
        i = i + 1;
    }
    return out;
}

fn history_remove_index(history, index) {
    let idx = try parse_number(str(index)) catch 0 - 1;
    if idx == nil { idx = 0 - 1; }
    idx = num_floor(idx);
    let out = [];
    let removed = nil;
    let i = 0;
    while history != nil and i < len(history) {
        if i == idx {
            removed = history[i];
        } else {
            array_push(out, history[i]);
        }
        i = i + 1;
    }
    return map{ history: out, removed: removed, removed_index: idx, ok: removed != nil };
}

fn history_delete_selected(history, hits, selected) {
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if hits == nil or len(hits) == 0 or sel < 0 or sel >= len(hits) {
        return map{ history: try history catch [], removed: nil, removed_index: 0 - 1, ok: false };
    }
    let hit = hits[sel];
    return history_remove_index(history, try hit.index catch sel);
}

fn history_storage_state(history, mode, stored, path) {
    let count = len(try history catch []);
    let m = str_lower(str_trim(str(mode)));
    if m != "permanent" { m = "temporary"; }
    let has_rows = count > 0;
    let label = history_mode_label(m);
    let status = "empty";
    if has_rows and m == "temporary" { status = "memory-only"; }
    if has_rows and m == "permanent" and stored { status = "saved"; }
    if has_rows and m == "permanent" and not stored { status = "needs-save"; }
    return map{
        mode: m,
        label: label,
        count: count,
        has_rows: has_rows,
        stored: stored,
        status: status,
        path: str(path)
    };
}

fn history_storage_summary(history, mode, stored, path) {
    let s = history_storage_state(history, mode, stored, path);
    let msg = "history storage: " + str(try s.label catch "Temporary") +
        " · " + str(try s.count catch 0) + " snapshot(s) · " + str(try s.status catch "empty");
    if str(try s.path catch "") != "" { msg = msg + " · " + str(try s.path catch ""); }
    return msg;
}

// history_summary(history, limit) -> printable lines for native/web history panes.
fn history_summary(history, limit) {
    let lines = [];
    if history == nil or len(history) == 0 {
        return ["No run/check history yet.", "Run or Check to add a snapshot."];
    }
    if limit == nil or limit < 1 { limit = len(history); }
    let i = 0;
    while i < len(history) and i < limit {
        let h = history[i];
        let badge = "FAIL";
        if try h.ok catch false { badge = "OK"; }
        let store = str(try h.storage catch "temporary");
        if try h.stored catch false { store = "saved"; }
        array_push(lines, str(i + 1) + ". " + str_upper(str(try h.action catch "?")) +
            " " + badge + " [" + store + "]  " + _one_line(try h.summary catch try h.output catch "", 82));
        i = i + 1;
    }
    return lines;
}

fn filter_history(history, query, limit) {
    let out = [];
    if limit == nil or limit < 1 { limit = 50; }
    let q = str_lower(str_trim(str(query)));
    let i = 0;
    while history != nil and i < len(history) and len(out) < limit {
        let h = history[i];
        let status = "fail";
        if try h.ok catch false { status = "ok"; }
        let hay = str_lower(
            str(try h.action catch "") + "\n" +
            status + "\n" +
            str(try h.summary catch "") + "\n" +
            str(try h.output catch "") + "\n" +
            str(try h.code catch "") + "\n" +
            str(try h.ts catch "")
        );
        if q == "" or str_contains(hay, q) {
            array_push(out, map{
                index: i,
                action: try h.action catch "?",
                ok: try h.ok catch false,
                output: try h.output catch "",
                code: try h.code catch "",
                summary: try h.summary catch try h.output catch "",
                ts: try h.ts catch "",
                storage: try h.storage catch "temporary",
                stored: try h.stored catch false
            });
        }
        i = i + 1;
    }
    return out;
}

fn history_filter_status(history, query, selected) {
    let total = len(try history catch []);
    let q = str_trim(str(query));
    if total == 0 { return "history: empty"; }
    let hits = filter_history(history, q, 10000);
    let prefix = "history: all " + str(total) + " snapshot(s)";
    if q != "" { prefix = "history: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits));
}

fn browser_management_state(bookmarks, downloads, security, tor, search_engine) {
    let bs = try bookmarks catch [];
    let ds = try downloads catch [];
    let sec = str(try security catch "safe");
    let tor_on = try tor catch false;
    let engine = str(try search_engine catch "duckduckgo");
    let route = sec;
    if tor_on { route = "tor"; }
    let status = "empty";
    if len(bs) > 0 or len(ds) > 0 { status = "active"; }
    let summary = "bookmarks " + str(len(bs)) + " · downloads " + str(len(ds)) +
        " · security " + route + " · search " + engine;
    return map{
        format: "pbide.browser.management.v1",
        bookmarks: len(bs),
        downloads: len(ds),
        security: sec,
        tor: tor_on,
        search_engine: engine,
        route: route,
        status: status,
        summary: summary
    };
}

fn browser_management_records(state) {
    let s = try state catch map{};
    let bookmark_status = "empty";
    if (try s.bookmarks catch 0) > 0 { bookmark_status = "active"; }
    let download_status = "empty";
    if (try s.downloads catch 0) > 0 { download_status = "planned"; }
    return [
        map{ id: "browser_bookmarks", group: "Browser", title: "Bookmarks", status: bookmark_status, detail: str(try s.bookmarks catch 0) + " saved page(s); open Browser Bookmarks to inspect/remove" },
        map{ id: "browser_downloads", group: "Browser", title: "Download plans", status: download_status, detail: str(try s.downloads catch 0) + " policy-checked recent plan(s); downloads stay planned until explicit execution gates exist" },
        map{ id: "browser_security", group: "Browser", title: "Security route", status: str(try s.route catch try s.security catch "safe"), detail: "profile " + str(try s.security catch "safe") + "; tor " + str(try s.tor catch false) },
        map{ id: "browser_search", group: "Browser", title: "Search engine", status: str(try s.search_engine catch "duckduckgo"), detail: "address-bar text queries use this selected provider" }
    ];
}

fn browser_management_summary(state) {
    let s = try state catch map{};
    return str(try s.summary catch ("bookmarks " + str(try s.bookmarks catch 0) + " · downloads " + str(try s.downloads catch 0)));
}

fn database_profile(name, kind, location, mode = "readonly") {
    let n = str_trim(str(name));
    if n == "" { n = "database"; }
    let k = str_lower(str_trim(str(kind)));
    if k == "" { k = "sqlite"; }
    let loc = str_trim(str(location));
    let m = str_lower(str_trim(str(mode)));
    if m != "readwrite" and m != "admin" { m = "readonly"; }
    let local = k == "sqlite" or str_starts_with(loc, ".") or str_starts_with(loc, "/");
    return map{
        format: "pbide.database.profile.v1",
        name: n,
        kind: k,
        location: loc,
        mode: m,
        local: local,
        configured: loc != "",
        summary: n + " " + k + " " + m + " " + loc
    };
}

fn database_management_state(profiles, migrations, backups) {
    let ps = try profiles catch [];
    let ms = try migrations catch [];
    let bs = try backups catch [];
    let configured = 0;
    let i = 0;
    while i < len(ps) {
        if try ps[i].configured catch false { configured = configured + 1; }
        i = i + 1;
    }
    let status = "empty";
    if len(ps) > 0 { status = "profiles"; }
    if configured > 0 { status = "ready"; }
    let summary = "profiles " + str(len(ps)) + " · configured " + str(configured) +
        " · migrations " + str(len(ms)) + " · backups " + str(len(bs));
    return map{
        format: "pbide.database.management.v1",
        profiles: len(ps),
        configured: configured,
        migrations: len(ms),
        backups: len(bs),
        status: status,
        summary: summary
    };
}

fn database_action_plan(action, profile, target = "") {
    let a = str_lower(str_trim(str(action)));
    let p = try profile catch map{};
    let configured = try p.configured catch false;
    let mode = str_lower(str(try p.mode catch "readonly"));
    let destructive = a == "migrate" or a == "restore" or a == "write" or a == "delete";
    let requires = ["configured profile", "explicit user confirmation"];
    if destructive { array_push(requires, "backup before mutation"); }
    if a == "restore" { array_push(requires, "restore source path"); }
    if a == "backup" or a == "export" { array_push(requires, "output path"); }
    let ok = configured;
    if destructive and mode == "readonly" { ok = false; }
    return map{
        format: "pbide.database.action_plan.v1",
        action: a,
        profile: str(try p.name catch "database"),
        kind: str(try p.kind catch "sqlite"),
        target: str(target),
        mode: mode,
        configured: configured,
        destructive: destructive,
        executable: false,
        ok: ok,
        requires: requires,
        reason: "PBIDE database actions are planned only until execution gates are attached"
    };
}

fn project_improvement_board(paths, project = "pbide") {
    if paths == nil { paths = []; }
    let survey = PROJECT_SURVEY.survey_paths(paths, 1000);
    let ideas = PROJECT_SURVEY.ideas_for_project(project, survey.records);
    let status = "ready";
    if len(survey.records) == 0 { status = "empty"; }
    if survey.skipped_sensitive > 0 { status = "safe-skip"; }
    return map{
        format: "pbide.project_improvement_board.v1",
        project: project,
        status: status,
        scanned: survey.scanned,
        safe_records: len(survey.records),
        skipped_sensitive: survey.skipped_sensitive,
        categories: survey.counts,
        ideas: ideas.ideas,
        policy: survey.policy,
        detail: str(len(ideas.ideas)) + " idea(s), " + str(len(survey.records)) + " safe path(s), " + str(survey.skipped_sensitive) + " skipped"
    };
}

fn project_improvement_lines(board, limit = 6) {
    if limit == nil or limit < 1 { limit = 6; }
    let b = try board catch map{};
    let lines = [
        "Project improvement: " + str(try b.project catch "pbide") + " · " + str(try b.status catch "unknown"),
        str(try b.detail catch "no project survey loaded"),
        "policy: " + str(try b.policy catch "metadata-only")
    ];
    let ideas = try b.ideas catch [];
    let i = 0;
    while i < len(ideas) and len(lines) < limit {
        array_push(lines, "- " + str(ideas[i]));
        i = i + 1;
    }
    return lines;
}

fn project_portfolio_board(paths) {
    if paths == nil { paths = []; }
    let readiness = PROJECT_SURVEY.portfolio_readiness(paths, nil);
    let survey = try readiness.survey catch map{};
    let status = "ready";
    if len(try survey.records catch []) == 0 { status = "empty"; }
    if (try survey.skipped_sensitive catch 0) > 0 { status = "safe-skip"; }
    let projects = try readiness.projects catch [];
    let i = 0;
    let min_score = 100;
    while i < len(projects) {
        if projects[i].readiness_score < min_score { min_score = projects[i].readiness_score; }
        i = i + 1;
    }
    if len(projects) > 0 and min_score < 60 { status = "needs-data"; }
    return map{
        format: "pbide.project_portfolio_board.v1",
        status: status,
        scanned: try survey.scanned catch 0,
        safe_records: len(try survey.records catch []),
        skipped_sensitive: try survey.skipped_sensitive catch 0,
        categories: try survey.counts catch map{},
        projects: projects,
        top_priorities: try readiness.top_priorities catch [],
        policy: try readiness.policy catch "metadata-only",
        detail: str(len(projects)) + " project(s), " + str(len(try survey.records catch [])) + " safe path(s), min readiness " + str(min_score)
    };
}

fn project_portfolio_lines(board, limit = 8) {
    if limit == nil or limit < 1 { limit = 8; }
    let b = try board catch map{};
    let lines = [
        "Project portfolio: " + str(try b.status catch "unknown"),
        str(try b.detail catch "no portfolio readiness loaded"),
        "policy: " + str(try b.policy catch "metadata-only")
    ];
    let projects = try b.projects catch [];
    let i = 0;
    while i < len(projects) and len(lines) < limit {
        let row = projects[i];
        array_push(lines, "- " + str(row.project) + " " + str(row.status) + " score=" + str(row.readiness_score) + " devices=" + str_join(try row.device_routes catch [], ", "));
        i = i + 1;
    }
    let priorities = try b.top_priorities catch [];
    let j = 0;
    while j < len(priorities) and len(lines) < limit {
        array_push(lines, "> " + str(priorities[j]));
        j = j + 1;
    }
    return lines;
}

