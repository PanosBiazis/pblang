fn project_action_board(paths) {
    if paths == nil { paths = []; }
    let plan = PROJECT_SURVEY.portfolio_action_plan(paths, nil, 5);
    let survey = try plan.survey catch map{};
    let tasks = try plan.tasks catch [];
    let status = "ready";
