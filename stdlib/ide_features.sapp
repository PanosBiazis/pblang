fn _render_policy_num(v, fallback = 0) {
    let n = try v catch fallback;
    if n == nil { return fallback; }
    return n;
}

fn ide_render_quality_policy(perf, text, options = nil) {
    if options == nil { options = map{}; }
    let p = try perf catch map{};
    let t = try text catch map{};
    let target = _render_policy_num(try options.target_fps catch 60, 60);
    if target < 1 { target = 60; }
    let budget = 1000 / target;
    let avg = _render_policy_num(try p.avg_draw_ms catch 0, 0);
    let last = _render_policy_num(try p.last_draw_ms catch 0, 0);
    let skips = _render_policy_num(try p.skips catch 0, 0);
    let draws = _render_policy_num(try p.draws catch 0, 0);
    let text_calls = _render_policy_num(try t.text_calls catch try p.text_calls catch 0, 0);
    let text_skips = _render_policy_num(try t.text_skips catch try p.text_skips catch 0, 0);
    let text_aa = _render_policy_num(try t.text_aa catch try p.text_aa catch 0, 0);
    let text_bitmap = _render_policy_num(try t.text_bitmap catch try p.text_bitmap catch 0, 0);
    let pressure_score = 0;
    let reasons = [];
    if avg > budget * 2 or last > budget * 2 or text_calls > 1000 {
        pressure_score = pressure_score + 3;
        array_push(reasons, "frame over 2x budget or very high text volume");
    } else if avg > budget * 1.35 or last > budget * 1.5 or text_calls > 650 {
        pressure_score = pressure_score + 2;
        array_push(reasons, "frame over budget or high text volume");
    } else if avg > budget or last > budget or text_calls > 350 {
        pressure_score = pressure_score + 1;
        array_push(reasons, "near frame budget");
    }
    if text_skips < text_calls / 20 and text_calls > 300 {
        pressure_score = pressure_score + 1;
        array_push(reasons, "low text skip ratio");
    }
    if skips > draws * 6 and draws > 0 {
        array_push(reasons, "idle skip is active");
    }
    let pressure = "ok";
    let action = "steady";
    let recommended_fps = target;
    let text_mode = "native-aa";
    let actions = ["keep dirty redraw", "keep text shaping cache"];
    if pressure_score >= 4 {
        pressure = "critical";
        action = "protect-desktop-and-lower-cost";
        recommended_fps = 24;
        text_mode = "adaptive-aa-or-bitmap";
        actions = ["skip idle present", "prefer partial present", "defer hidden panels", "cache heavy panel geometry", "allow bitmap text fallback"];
    } else if pressure_score >= 2 {
        pressure = "high";
        action = "reduce-ui-work";
        recommended_fps = 30;
        text_mode = "adaptive-aa";
        actions = ["prefer partial present", "skip idle present", "reuse cached text/layout", "batch rectangles"];
    } else if pressure_score == 1 {
        pressure = "watch";
        action = "watch-and-cache";
        recommended_fps = 45;
        text_mode = "native-aa-cached";
        actions = ["keep dirty redraw", "watch draw spikes", "keep shape cache warm"];
    }
    if text_bitmap > 0 and text_aa == 0 {
        text_mode = "bitmap";
    }
    if len(reasons) == 0 { array_push(reasons, "within budget"); }
    return map{
        format: "pbide.render.quality_policy.v1",
        pressure: pressure,
        action: action,
        target_fps: target,
        recommended_fps: recommended_fps,
        budget_ms: budget,
        avg_draw_ms: avg,
        last_draw_ms: last,
        draws: draws,
        skips: skips,
        text_calls: text_calls,
        text_skips: text_skips,
        text_aa: text_aa,
        text_bitmap: text_bitmap,
        text_mode: text_mode,
        actions: actions,
        reasons: reasons,
        summary: "quality " + pressure + " -> " + action + " fps " + str(recommended_fps) + " text " + text_mode
    };
}

fn ide_render_quality_policy_lines(policy, limit = 5) {
    if limit == nil or limit < 1 { limit = 5; }
    let p = try policy catch map{};
    let lines = [
        "Render quality: " + str(try p.pressure catch "unknown") + " · " + str(try p.action catch "steady"),
        str(try p.summary catch "no render quality policy")
    ];
    let actions = try p.actions catch [];
    let i = 0;
    while i < len(actions) and len(lines) < limit {
        array_push(lines, "- " + str(actions[i]));
        i = i + 1;
    }
    let reasons = try p.reasons catch [];
    let j = 0;
    while j < len(reasons) and len(lines) < limit {
        array_push(lines, "! " + str(reasons[j]));
        j = j + 1;
    }
    return lines;
}

fn _render_policy_max(a, b) {
    if a > b { return a; }
    return b;
}

fn ide_render_runtime_plan(policy, options = nil) {
    if options == nil { options = map{}; }
    let p = try policy catch map{};
    let pressure = str(try p.pressure catch "ok");
    let base_idle = _render_policy_num(try options.idle_ms catch 500, 500);
    if base_idle < 0 { base_idle = 0; }
    if base_idle > 5000 { base_idle = 5000; }
    let rec_fps = _render_policy_num(try p.recommended_fps catch try options.target_fps catch 60, 60);
    if rec_fps < 1 { rec_fps = 60; }
    let idle_ms = base_idle;
    let min_draw_gap_ms = 0;
    let input_grace_ms = 60;
    let throttle = "none";
    let notes = ["input events remain immediate"];
    if pressure == "critical" {
        throttle = "critical";
        idle_ms = _render_policy_max(base_idle, 1500);
        min_draw_gap_ms = _render_policy_max(1000 / rec_fps, 40);
        input_grace_ms = 120;
        array_push(notes, "defer rapid non-input redraws");
        array_push(notes, "stretch idle repaint cadence");
    } else if pressure == "high" {
        throttle = "high";
        idle_ms = _render_policy_max(base_idle, 1000);
        min_draw_gap_ms = _render_policy_max(1000 / rec_fps, 34);
        input_grace_ms = 90;
        array_push(notes, "coalesce background redraws");
    } else if pressure == "watch" {
        throttle = "watch";
        idle_ms = _render_policy_max(base_idle, 700);
        min_draw_gap_ms = _render_policy_max(1000 / rec_fps, 20);
        input_grace_ms = 60;
        array_push(notes, "watch draw spikes before stronger throttling");
    }
    return map{
        format: "pbide.render.runtime_plan.v1",
        pressure: pressure,
        throttle: throttle,
        target_fps: _render_policy_num(try p.target_fps catch try options.target_fps catch 60, 60),
        recommended_fps: rec_fps,
        idle_ms: idle_ms,
        min_draw_gap_ms: min_draw_gap_ms,
        input_grace_ms: input_grace_ms,
        text_mode: str(try p.text_mode catch "native-aa"),
        notes: notes,
        summary: "runtime " + throttle + " idle " + str(idle_ms) + "ms min-gap " + str(min_draw_gap_ms) + "ms fps " + str(rec_fps)
    };
}

fn ide_render_runtime_plan_lines(plan, limit = 5) {
    if limit == nil or limit < 1 { limit = 5; }
    let p = try plan catch map{};
    let lines = [
        "Render runtime: " + str(try p.throttle catch "unknown") + " · " + str(try p.pressure catch "unknown"),
        str(try p.summary catch "no runtime render plan")
    ];
    let notes = try p.notes catch [];
    let i = 0;
    while i < len(notes) and len(lines) < limit {
        array_push(lines, "- " + str(notes[i]));
        i = i + 1;
    }
    return lines;
}

// Decide when PBIDE should rebuild its adaptive runtime policy. The policy is
// derived from completed draw samples, so idle event-loop ticks can safely
// reuse one bounded map instead of allocating a full frame plan at 60 Hz.
fn ide_render_runtime_cache_policy(last_refresh_ms, now_ms, last_draws, draws, options = nil) {
    if options == nil { options = map{}; }
    let last = _render_policy_num(last_refresh_ms, 0);
    let now = _render_policy_num(now_ms, last);
    let previous_draws = _render_policy_num(last_draws, 0);
    let current_draws = _render_policy_num(draws, previous_draws);
    let interval = _render_policy_num(try options.interval_ms catch 1000, 1000);
    if interval < 100 { interval = 100; }
    if interval > 5000 { interval = 5000; }

    let initialized = try options.initialized catch false;
    let force = try options.force catch false;
    let clock_reset = now < last;
    let elapsed = 0;
    if not clock_reset { elapsed = now - last; }
    let sample_changed = current_draws != previous_draws;
    let refresh = false;
    let reason = "reuse-unchanged-sample";
    if force {
        refresh = true;
        reason = "forced";
    } else if not initialized {
        refresh = true;
        reason = "uninitialized";
    } else if clock_reset {
        refresh = true;
        reason = "clock-reset";
    } else if sample_changed and elapsed >= interval {
        refresh = true;
        reason = "new-draw-sample";
    } else if sample_changed {
        reason = "coalesce-new-sample";
    }

    let next_in_ms = interval - elapsed;
    if next_in_ms < 0 { next_in_ms = 0; }
    if not sample_changed { next_in_ms = interval; }
    return map{
        format: "pbide.render.runtime_cache_policy.v1",
        refresh: refresh,
        reason: reason,
        initialized: initialized,
        sample_changed: sample_changed,
        interval_ms: interval,
        elapsed_ms: elapsed,
        next_in_ms: next_in_ms,
        previous_draws: previous_draws,
        current_draws: current_draws,
        bounded_entries: 1
    };
}

fn ide_render_frame_plan(width, height, backend_profile, dirty_rects, commands, options = nil) {
    if options == nil { options = map{}; }
    let profile = backend_profile;
    if profile == nil {
        profile = map{
            format: "pblang.graphics.backend.profile.v1",
            backend: "minifb",
            present: "cpu-framebuffer",
            gpu_present: false,
            cpu_raster_ui: true,
            idle_present_skip: true
        };
    }
    let schedule = GFX.frame_schedule(profile, map{ w: width, h: height }, dirty_rects, commands, options);
    let perf = try options.perf catch map{};
    let quality = ide_render_quality_policy(perf, perf, options);
    let runtime = ide_render_runtime_plan(quality, options);
    return map{
        format: "pbide.render.frame_plan.v1",
        width: width,
        height: height,
        status: schedule.present,
        route: schedule.route.route,
        device: schedule.route.device,
        gpu_present: schedule.route.gpu_present,
        dirty_mode: schedule.dirty.mode,
        dirty_tiles: schedule.dirty.tile_count,
        command_count: schedule.batch.command_count,
        batch_strategy: schedule.batch.strategy,
        parallel_prepare: schedule.parallel_prepare,
        pressure: try schedule.adaptive.pressure catch "ok",
        adaptive_action: try schedule.adaptive.action catch "steady",
        recommended_fps: try schedule.adaptive.recommended_fps catch try options.target_fps catch 60,
        quality_pressure: quality.pressure,
        quality_action: quality.action,
        quality_recommended_fps: quality.recommended_fps,
        quality_policy: quality,
        runtime_plan: runtime,
        runtime_throttle: runtime.throttle,
        runtime_idle_ms: runtime.idle_ms,
        schedule: schedule,
        summary: GFX.frame_schedule_status(schedule)
    };
}

fn ide_render_frame_lines(plan, limit = 6) {
    if limit == nil or limit < 1 { limit = 6; }
    let p = try plan catch map{};
    let lines = [
        "Render frame: " + str(try p.status catch "unknown") + " · " + str(try p.route catch "?"),
        str(try p.summary catch "no frame schedule")
    ];
    let lanes = try p.schedule.lanes catch [];
    let i = 0;
    while i < len(lanes) and len(lines) < limit {
        array_push(lines, "- " + str(lanes[i]));
        i = i + 1;
    }
    let warnings = try p.schedule.warnings catch [];
    let j = 0;
    while j < len(warnings) and len(lines) < limit {
        array_push(lines, "! " + str(warnings[j]));
        j = j + 1;
    }
    if len(lines) < limit {
        array_push(lines, "Adaptive: " + str(try p.pressure catch "ok") + " -> " + str(try p.adaptive_action catch "steady") + " fps " + str(try p.recommended_fps catch 60));
    }
    if len(lines) < limit {
        array_push(lines, str(try p.quality_policy.summary catch "Render quality: unknown"));
    }
    if len(lines) < limit {
        array_push(lines, str(try p.runtime_plan.summary catch "Render runtime: unknown"));
    }
    return lines;
}

