    if len(tasks) == 0 { status = "empty"; }
    return map{
        format: "pbide.project_action_board.v1",
        status: status,
        scanned: try survey.scanned catch 0,
        safe_records: len(try survey.records catch []),
        skipped_sensitive: try survey.skipped_sensitive catch 0,
        categories: try survey.counts catch map{},
        projects: try plan.projects catch [],
        tasks: tasks,
        top_tasks: try plan.top_tasks catch [],
        policy: try plan.policy catch "metadata-only",
        detail: str(len(try plan.projects catch [])) + " project(s), " + str(len(tasks)) + " ranked task(s), " + str(len(try survey.records catch [])) + " safe path(s)"
    };
}

fn project_action_lines(board, limit = 10) {
    if limit == nil or limit < 1 { limit = 10; }
    let b = try board catch map{};
    let lines = [
        "Project action plan: " + str(try b.status catch "unknown"),
        str(try b.detail catch "no action plan loaded"),
        "policy: " + str(try b.policy catch "metadata-only")
    ];
    let tasks = try b.top_tasks catch try b.tasks catch [];
    let i = 0;
    while i < len(tasks) and len(lines) < limit {
        let t = tasks[i];
        array_push(lines, "- " + str(try t.project catch "?") + "/" + str(try t.category catch "?") + " score=" + str(try t.score catch 0) + " " + str(try t.title catch ""));
        i = i + 1;
    }
    if len(tasks) > 0 and len(lines) < limit {
        let first = tasks[0];
        array_push(lines, "route: " + str(try first.device_route catch "portable"));
        if len(lines) < limit { array_push(lines, "protocols: " + str_join(try first.protocols catch [], ", ")); }
        if len(lines) < limit { array_push(lines, "gates: " + str_join(try first.gates catch [], ", ")); }
    }
    return lines;
}

