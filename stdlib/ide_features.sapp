    let out = [
        map{ id: "database", group: "Databases", title: "Database management", status: str(try s.database_status catch "planned"), detail: str(try s.database_detail catch "connections, local data files, migrations, backup/restore plans") },
        map{ id: "history", group: "Storage", title: "History storage", status: str(try s.history_status catch "temporary"), detail: str(try s.history_detail catch "toggle temporary/permanent and verify saved snapshots") },
        map{ id: "files", group: "Storage", title: "Project/files management", status: str(try s.files_status catch "active"), detail: "roots, recent files, safe copy/cut/paste/delete/rename plans" },
        map{ id: "browser", group: "Network", title: "Browser/security management", status: str(try s.browser_status catch "safe"), detail: str(try s.browser_detail catch "safe/live/js-dom/trusted/tor, blockers, bookmarks, downloads") },
        map{ id: "browser_data", group: "Network", title: "Browser data management", status: str(try s.browser_data_status catch "empty"), detail: str(try s.browser_data_detail catch "bookmark/download/search/security records") },
        map{ id: "asset_backends", group: "Assets", title: "Document/media backends", status: str(try s.asset_status catch "planned"), detail: str(try s.asset_detail catch "decoder/export/player readiness for the current file") },
        map{ id: "models", group: "AI", title: "AI/model management", status: str(try s.ai_status catch "local"), detail: "pbAI prompts, memory, local model checks, future checkpoints" },
        map{ id: "backups", group: "Maintenance", title: "Backup/export management", status: str(try s.backup_status catch "planned"), detail: "export project settings, history, roots, designer documents" },
        map{ id: "graphics", group: "Runtime", title: "Graphics/GPU backend", status: str(try s.graphics_status catch "unknown"), detail: str(try s.graphics_detail catch "renderer backend, CPU/GPU present mode, and text renderer") }
    ];
    let portfolio = try s.project_portfolio catch nil;
