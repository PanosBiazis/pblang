// stdlib/ide_features.sapp — web-IDE-style editor features as pure, testable functions
// (no display): a symbol OUTLINE, FIND-ALL, FIND & REPLACE, STATUS-BAR text,
// bounded run/check HISTORY records, DIAGNOSTIC normalization/navigation data, and
// searchable EXAMPLES catalog helpers.
// pbide.sapp (and any editor) wires these into its UI; the logic is unit-tested headlessly.

fn _ident(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        let c = strcharcodeat(ch, 0);
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 {
            out = out + ch;
        } else { return out; }
        i = i + 1;
    }
    return out;
}

// outline(code) -> [{ kind, name, line }] for top-level fn / let / const / export.
fn outline(code) {
    let out = [];
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let t = str_trim(lines[i]);
        let ln = i + 1;
        if str_starts_with(t, "fn ") {
            array_push(out, map{ kind: "fn", name: _ident(str_slice(t, 3, len(t))), line: ln });
        } else if str_starts_with(t, "let ") {
            array_push(out, map{ kind: "let", name: _ident(str_slice(t, 4, len(t))), line: ln });
        } else if str_starts_with(t, "const ") {
            array_push(out, map{ kind: "const", name: _ident(str_slice(t, 6, len(t))), line: ln });
        } else if str_starts_with(t, "export ") {
            array_push(out, map{ kind: "export", name: str_trim(str_slice(t, 7, len(t))), line: ln });
        }
        i = i + 1;
    }
    return out;
}

// find_all(code, query) -> [{ line, col }] (1-based) of every (case-sensitive) match.
fn find_all(code, query) {
    let out = [];
    if query == nil or query == "" { return out; }
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let rem = lines[i];
        let base = 0;
        let guard = 0;
        while guard < 100000 {
            let idx = str_index_of(rem, query);
            if idx < 0 { break; }
            array_push(out, map{ line: i + 1, col: base + idx + 1 });
            let step = idx + len(query);
            base = base + step;
            rem = str_slice(rem, step, len(rem));
            guard = guard + 1;
        }
        i = i + 1;
    }
    return out;
}

// replace_all(code, find, repl) -> { code, count } (count = matches replaced).
fn replace_all(code, find, repl) {
    if find == nil or find == "" { return map{ code: code, count: 0 }; }
    let count = len(find_all(code, find));
    return map{ code: str_replace_all(code, find, repl), count: count };
}

// filter_examples(catalog, query, limit) -> [{ index, title }]
// Matches title or code, case-insensitive. Used by the native/web examples picker.
fn filter_examples(catalog, query, limit) {
    let out = [];
    if limit == nil or limit < 1 { limit = 50; }
    let q = str_lower(str_trim(str(query)));
    let i = 0;
    while catalog != nil and i < len(catalog) and len(out) < limit {
        let ex = catalog[i];
        let title = str(try ex.title catch "Example " + str(i + 1));
        let code = str(try ex.code catch "");
        let hay = str_lower(title + "\n" + code);
        if q == "" or str_contains(hay, q) {
            array_push(out, map{ index: i, title: title });
        }
        i = i + 1;
    }
    return out;
}

fn _line_text(code, line) {
    let lines = str_split(code, "\n");
    if line < 1 or line > len(lines) { return ""; }
    return lines[line - 1];
}

fn _quoted_name(message) {
    let a = str_index_of(message, "'");
    if a < 0 { return ""; }
    let rest = str_slice(message, a + 1, len(message));
    let b = str_index_of(rest, "'");
    if b < 0 { return ""; }
    return str_slice(rest, 0, b);
}

fn normalize_diagnostic(code, diag, index) {
    let msg = str(try diag.message catch diag);
    let kind = str(try diag.kind catch try diag.stage catch "info");
    let line = try diag.line catch nil;
    let col = try diag.col catch try diag.column catch nil;
    if line == nil {
        let name = _quoted_name(msg);
        if name != "" {
            let hits = find_all(code, name);
            if len(hits) > 0 {
                line = hits[0].line;
                col = hits[0].col;
            }
        }
    }
    if line == nil { line = 1; }
    if col == nil { col = 1; }
    if line < 1 { line = 1; }
    if col < 1 { col = 1; }
    return map{
        index: index,
        kind: kind,
        message: msg,
        line: line,
        col: col,
        source: _line_text(code, line),
    };
}

fn normalize_diagnostics(code, diagnostics) {
    let out = [];
    let i = 0;
    while diagnostics != nil and i < len(diagnostics) {
        array_push(out, normalize_diagnostic(code, diagnostics[i], i));
        i = i + 1;
    }
    return out;
}

fn diagnostic_summary(diagnostics, limit) {
    if diagnostics == nil or len(diagnostics) == 0 {
        return ["No diagnostics. F6 Check passed."];
    }
    if limit == nil or limit < 1 { limit = len(diagnostics); }
    let out = [];
    let i = 0;
    while i < len(diagnostics) and i < limit {
        let d = diagnostics[i];
        array_push(out, str(i + 1) + ". " + str_upper(str(try d.kind catch "info")) +
            " L" + str(try d.line catch 1) + ":C" + str(try d.col catch 1) +
            " " + str(try d.message catch "diagnostic"));
        i = i + 1;
    }
    return out;
}

// status_text(info) -> a VSCode-style status-bar string.
fn status_text(info) {
    let path = str(try info.path catch "untitled");
    let modified = try info.modified catch false;
    let m = "";
    if modified { m = " *"; }
    let ln = str(try info.line catch 1);
    let col = str(try info.col catch 1);
    let lines = str(try info.lines catch 0);
    let lang = str(try info.lang catch "pblang");
    return path + m + "  |  Ln " + ln + ", Col " + col + "  |  " + lines + " lines  |  " + lang;
}

fn _one_line(s, max_len) {
    let t = str_trim(str_replace_all(str(s), "\n", " "));
    if max_len < 4 { max_len = 4; }
    if len(t) <= max_len { return t; }
    return str_slice(t, 0, max_len - 3) + "...";
}

// make_history_record(action, ok, output, code) -> one IDE history entry.
fn make_history_record(action, ok, output, code) {
    let ts = try now_iso() catch "now";
    return map{
        action: str(action),
        ok: ok,
        output: str(output),
        code: str(code),
        summary: _one_line(output, 96),
        ts: ts,
    };
}

// push_history(history, action, ok, output, code, limit) -> newest-first bounded history.
fn push_history(history, action, ok, output, code, limit) {
    if limit == nil or limit < 1 { limit = 30; }
    let out = [make_history_record(action, ok, output, code)];
    let i = 0;
    while history != nil and i < len(history) and len(out) < limit {
        array_push(out, history[i]);
        i = i + 1;
    }
    return out;
}

// history_summary(history, limit) -> printable lines for native/web history panes.
fn history_summary(history, limit) {
    let lines = [];
    if history == nil or len(history) == 0 {
        return ["No run/check history yet.", "Run or Check to add a snapshot."];
    }
    if limit == nil or limit < 1 { limit = len(history); }
    let i = 0;
    while i < len(history) and i < limit {
        let h = history[i];
        let badge = "FAIL";
        if try h.ok catch false { badge = "OK"; }
        array_push(lines, str(i + 1) + ". " + str_upper(str(try h.action catch "?")) +
            " " + badge + "  " + _one_line(try h.summary catch try h.output catch "", 82));
        i = i + 1;
    }
    return lines;
}

fn code_hash(code) {
    let h = 5381;
    let i = 0;
    let s = str(code);
    while i < len(s) {
        h = num_mod(h * 33 + strcharcodeat(s, i), 2147483647);
        i = i + 1;
    }
    return h;
}

fn build_profile(mode) {
    let m = str_lower(str(mode));
    if m == "release" {
        return map{
            mode: "release",
            label: "Release",
            lint_before_run: false,
            diagnostics: "manual",
            history: true,
            optimize: "speed",
            output: "normal",
            note: "Run directly for speed; use Check before shipping."
        };
    }
    return map{
        mode: "debug",
        label: "Debug",
        lint_before_run: true,
        diagnostics: "always-before-run",
        history: true,
        optimize: "none",
        output: "diagnostic",
        note: "Check before run and block on diagnostics."
    };
}

fn next_build_mode(mode) {
    if str_lower(str(mode)) == "debug" { return "release"; }
    return "debug";
}

fn build_mode_summary(mode) {
    let p = build_profile(mode);
    return "mode: " + p.label + " | optimize=" + p.optimize + " | diagnostics=" + p.diagnostics;
}

fn watcher_new(path, code) {
    let text = str(code);
    return map{
        enabled: true,
        path: str(path),
        revision: 0,
        hash: code_hash(text),
        last_hash: code_hash(text),
        dirty: false,
        lines: len(str_split(text, "\n")),
        symbols: len(outline(text)),
        diagnostics: 0,
        last_event: "watcher initialized"
    };
}

fn watcher_update(w, path, code, dirty, diagnostics, event) {
    if w == nil { w = watcher_new(path, code); }
    let text = str(code);
    let h = code_hash(text);
    let changed = h != (try w.hash catch h);
    if changed { w.revision = (try w.revision catch 0) + 1; }
    w.path = str(path);
    w.last_hash = try w.hash catch h;
    w.hash = h;
    w.dirty = dirty;
    w.lines = len(str_split(text, "\n"));
    w.symbols = len(outline(text));
    w.diagnostics = len(try diagnostics catch []);
    w.last_event = str(event);
    w.changed = changed;
    return w;
}

fn watcher_summary(w) {
    if w == nil { return "watch: off"; }
    let on = "on";
    if try w.enabled catch true { on = "on"; } else { on = "off"; }
    let d = "clean";
    if try w.dirty catch false { d = "dirty"; }
    return "watch: " + on + " rev " + str(try w.revision catch 0) + " " + d
        + " | lines " + str(try w.lines catch 0)
        + " | symbols " + str(try w.symbols catch 0)
        + " | diagnostics " + str(try w.diagnostics catch 0);
}

export outline, find_all, replace_all, status_text,
    filter_examples,
    normalize_diagnostic, normalize_diagnostics, diagnostic_summary,
    make_history_record, push_history, history_summary,
    code_hash, build_profile, next_build_mode, build_mode_summary,
    watcher_new, watcher_update, watcher_summary;
