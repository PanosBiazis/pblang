        array_push(out, map{
            id: "project_aap_status",
            group: "Project",
            title: "AAP project status",
            status: str(try aap_status.status catch "on-demand"),
            detail: str(try aap_status.detail catch "bounded source/docs status for pblang, pbAI, pbOS, PBIDE, and pb-mcp")
        });
    }
    let board = try s.project_improvement catch nil;
    if board != nil {
        array_push(out, map{
            id: "project_improvement",
            group: "Project",
            title: "Safe project improvement board",
            status: str(try board.status catch "ready"),
            detail: str(try board.detail catch "metadata-only project ideas")
        });
    }
    let gaps = try s.project_gaps catch nil;
    if gaps != nil {
        array_push(out, map{
            id: "project_gaps",
            group: "Project",
            title: "Project gap/security audit",
            status: str(try gaps.status catch "needs-review"),
            detail: str(try gaps.detail catch "bounded text audit")
        });
    }
    let text_audit = try s.project_text_audit catch nil;
    if text_audit != nil {
        array_push(out, map{
            id: "project_text_audit",
            group: "Project",
            title: "Bounded project text audit",
            status: str(try text_audit.status catch "needs-review"),
            detail: str(try text_audit.detail catch "safe text-like file audit")
        });
    }
    return out;
}

fn filter_management_records(records, query, limit) {
    let out = [];
    if limit == nil or limit < 1 { limit = 50; }
    let q = str_lower(str_trim(str(query)));
    let i = 0;
    while records != nil and i < len(records) and len(out) < limit {
        let r = records[i];
        let hay = str_lower(str(try r.id catch "") + "\n" + str(try r.group catch "") + "\n" +
            str(try r.title catch "") + "\n" + str(try r.status catch "") + "\n" + str(try r.detail catch ""));
        if q == "" or str_contains(hay, q) {
            r.index = i;
            array_push(out, r);
        }
        i = i + 1;
    }
    return out;
}

fn management_filter_status(records, query, selected) {
    let total = len(try records catch []);
    let q = str_trim(str(query));
    if total == 0 { return "management: empty"; }
    let hits = filter_management_records(records, q, 10000);
    let prefix = "management: all " + str(total) + " area(s)";
    if q != "" { prefix = "management: " + str(len(hits)) + "/" + str(total) + " for '" + q + "'"; }
    if len(hits) == 0 { return prefix; }
    let sel = try parse_number(str(selected)) catch 0;
    if sel == nil { sel = 0; }
    sel = num_floor(sel);
    if sel < 0 { sel = 0; }
    if sel >= len(hits) { sel = len(hits) - 1; }
    return prefix + "  sel " + str(sel + 1) + "/" + str(len(hits));
}

fn terminal_history_push(history, command, limit) {
    if limit == nil or limit < 1 { limit = 80; }
    let cmd = str_trim(str(command));
    let out = [];
    if cmd == "" { return out; }
    array_push(out, cmd);
    let i = 0;
    while history != nil and i < len(history) and len(out) < limit {
        let old = str_trim(str(history[i]));
        if old != "" and old != cmd { array_push(out, old); }
        i = i + 1;
    }
    return out;
}

fn terminal_history_move(history, pos, direction, draft, input) {
    let n = len(try history catch []);
    let p = try parse_number(str(pos)) catch n;
    if p == nil { p = n; }
    p = num_floor(p);
    if p < 0 { p = 0; }
    if p > n { p = n; }
    let d = str(try draft catch "");
    let cur = str(try input catch "");
    if n == 0 { return map{ pos: 0, input: cur, draft: d, active: false }; }
    let dir = str_lower(str(direction));
    if dir == "up" or dir == "prev" or dir == "previous" {
        if p >= n {
            d = cur;
            p = 0;
        } else if p + 1 < n {
            p = p + 1;
        }
    } else if dir == "down" or dir == "next" {
        if p >= n {
            return map{ pos: n, input: cur, draft: d, active: false };
        } else if p > 0 {
            p = p - 1;
        } else {
            p = n;
            return map{ pos: p, input: d, draft: d, active: false };
        }
    }
    if p >= n { return map{ pos: n, input: d, draft: d, active: false }; }
    return map{ pos: p, input: str(history[p]), draft: d, active: true };
}

fn terminal_history_status(history, pos) {
    let n = len(try history catch []);
    if n == 0 { return "terminal: no command history"; }
    let p = try parse_number(str(pos)) catch n;
    if p == nil { p = n; }
    p = num_floor(p);
    if p < 0 { p = 0; }
    if p >= n { return "terminal history: " + str(n) + " command(s)  draft"; }
    return "terminal history: " + str(n) + " command(s)  sel " + str(p + 1) + "/" + str(n);
}

fn ai_prompt_history_push(history, prompt, limit) {
    if limit == nil or limit < 1 { limit = 80; }
    let p = str_trim(str(prompt));
    let out = [];
    if p == "" { return out; }
    array_push(out, p);
    let i = 0;
    while history != nil and i < len(history) and len(out) < limit {
        let old = str_trim(str(history[i]));
        if old != "" and old != p { array_push(out, old); }
        i = i + 1;
    }
    return out;
}

fn ai_prompt_history_move(history, pos, direction, draft, input) {
    return terminal_history_move(history, pos, direction, draft, input);
}

fn ai_prompt_history_status(history, pos) {
    let n = len(try history catch []);
    if n == 0 { return "pbAI prompts: no history"; }
    let p = try parse_number(str(pos)) catch n;
    if p == nil { p = n; }
    p = num_floor(p);
    if p < 0 { p = 0; }
    if p >= n { return "pbAI prompts: " + str(n) + " saved  draft"; }
    return "pbAI prompts: " + str(n) + " saved  sel " + str(p + 1) + "/" + str(n);
}

fn _path_extension(path) {
    let p = str_lower(str(path));
    let dot = 0 - 1;
    let slash = 0 - 1;
    let i = 0;
    while i < len(p) {
        let c = strcharcodeat(p, i);
        if c == 46 { dot = i; }
        if c == 47 or c == 92 { slash = i; }
        i = i + 1;
    }
    if dot <= slash or dot < 0 or dot >= len(p) - 1 { return ""; }
    return str_slice(p, dot + 1, len(p));
}

fn editor_asset_profile(path) {
    let ext = _path_extension(path);
    let family = "text";
    let editor = "text";
    let preview = "text";
    let editable = true;
    let binary = false;
    let tools = ["edit text", "find", "replace", "preview", "save"];
    let formats = [ext];
    let note = "Plain text editor mode.";

    if ext == "sapp" or ext == "pb" or ext == "pblang" {
        family = "code"; editor = "code"; preview = "syntax"; note = "pblang/code editor with diagnostics, run/check, preview, and watcher.";
        tools = ["edit code", "format", "fix", "run", "check", "preview", "watch"];
    } else if ext == "csv" or ext == "tsv" {
        family = "table"; editor = "spreadsheet"; preview = "table"; note = "Table editor plan: grid cells, formulas later, CSV/TSV preview now.";
        tools = ["edit cells", "sort", "filter", "find", "preview table", "save csv"];
        formats = ["csv", "tsv", "xlsx", "xls"];
    } else if ext == "doc" or ext == "docx" or ext == "odt" or ext == "rtf" {
        family = "document"; editor = "document"; preview = "pages"; binary = true; note = "Document editor plan: text boxes, images, tables, styles, page preview, export.";
        tools = ["edit paragraphs", "styles", "insert image", "insert table", "drag elements", "page preview"];
        formats = ["txt", "doc", "docx", "odt", "pdf"];
    } else if ext == "ppt" or ext == "pptx" or ext == "odp" {
        family = "slides"; editor = "slides"; preview = "slides"; binary = true; note = "Presentation editor plan: slide canvas, drag/drop shapes/media, notes, transitions.";
        tools = ["edit slides", "drag shapes", "insert media", "speaker notes", "slide preview"];
        formats = ["ppt", "pptx", "odp", "pdf"];
    } else if ext == "xls" or ext == "xlsx" or ext == "ods" {
        family = "sheet"; editor = "spreadsheet"; preview = "grid"; binary = true; note = "Spreadsheet editor plan: sheets, cells, formulas, charts, CSV import/export.";
        tools = ["edit cells", "formulas", "charts", "sort", "filter", "sheet preview"];
        formats = ["xls", "xlsx", "ods", "csv"];
    } else if ext == "pdf" {
        family = "pdf"; editor = "document"; preview = "pages"; binary = true; editable = false; note = "PDF preview/annotation plan: page thumbnails, text extract, comments, export copy.";
        tools = ["page preview", "text extract", "annotate", "search", "export"];
        formats = ["pdf"];
    } else if ext == "png" or ext == "jpg" or ext == "jpeg" or ext == "gif" or ext == "webp" or ext == "bmp" or ext == "svg" {
        family = "image"; editor = "image"; preview = "image"; binary = true; note = "Image editor/player plan: view, crop, resize, annotate, filters, metadata.";
        tools = ["view", "crop", "resize", "draw", "filters", "metadata"];
        formats = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "svg"];
    } else if ext == "mp3" or ext == "wav" or ext == "ogg" or ext == "flac" or ext == "m4a" {
        family = "audio"; editor = "audio"; preview = "waveform"; binary = true; note = "Audio editor/player plan: play, waveform, trim, normalize, metadata.";
        tools = ["play", "pause", "waveform", "trim", "normalize", "metadata"];
        formats = ["mp3", "wav", "ogg", "flac", "m4a"];
    } else if ext == "mp4" or ext == "webm" or ext == "mkv" or ext == "mov" or ext == "avi" {
        family = "video"; editor = "video"; preview = "timeline"; binary = true; note = "Video editor/player plan: play, timeline, trim, captions, thumbnails, export.";
        tools = ["play", "pause", "timeline", "trim", "captions", "export"];
        formats = ["mp4", "webm", "mkv", "mov", "avi"];
    } else if ext == "md" or ext == "markdown" or ext == "html" or ext == "htm" {
        family = "document"; editor = "document"; preview = "rich-text"; note = "Markup document editor with text editing and live preview contract.";
        tools = ["edit text", "preview rich text", "links", "images", "export"];
        formats = ["txt", "md", "html", "pdf"];
    }

    return map{
        path: str(path),
        ext: ext,
        family: family,
        editor: editor,
        preview: preview,
        editable: editable,
        binary: binary,
        formats: formats,
        tools: tools,
        note: note
    };
}

fn preview_modes_for_asset(profile) {
    let family = str(try profile.family catch "text");
    if family == "image" { return ["image", "metadata", "tools"]; }
    if family == "audio" { return ["waveform", "metadata", "tools"]; }
    if family == "video" { return ["timeline", "metadata", "tools"]; }
    if family == "table" or family == "sheet" { return ["table", "schema", "tools"]; }
    if family == "slides" { return ["slides", "outline", "tools"]; }
    if family == "pdf" { return ["pages", "extract", "tools"]; }
    if family == "document" { return ["rich-text", "outline", "tools"]; }
    if family == "code" { return ["syntax", "outline", "tools"]; }
    return ["text", "metadata", "tools"];
}

fn preview_mode_next(current, profile) {
    let modes = preview_modes_for_asset(profile);
    let cur = str_lower(str(current));
    let i = 0;
    while i < len(modes) {
        if modes[i] == cur {
            let n = i + 1;
            if n >= len(modes) { n = 0; }
            return modes[n];
        }
        i = i + 1;
    }
    return modes[0];
}

fn asset_editor_mode(profile) {
    let p = try profile catch map{};
    let family = str(try p.family catch "text");
    let editor = str(try p.editor catch "text");
    let binary = try p.binary catch false;
    let editable = try p.editable catch true;
    let title = editor + " editor";
    if family == "pdf" { title = "PDF preview/annotation editor"; }
    else if family == "image" { title = "image editor/player"; }
    else if family == "audio" { title = "audio editor/player"; }
    else if family == "video" { title = "video editor/player"; }
    else if family == "slides" { title = "presentation editor"; }
    else if family == "sheet" or family == "table" { title = "spreadsheet editor"; }
    else if family == "document" { title = "document editor"; }
    else if family == "code" { title = "code editor"; }
    return map{
        title: title,
        family: family,
        editor: editor,
        safe_text_edit: (not binary) and editable,
        native_decode_required: binary,
        can_save_direct: (not binary) and editable,
        can_preview: true,
        can_drag_drop: family == "document" or family == "slides" or family == "image" or family == "video" or family == "pdf",
        can_play: family == "audio" or family == "video",
        can_annotate: family == "pdf" or family == "image" or family == "document",
        can_timeline: family == "audio" or family == "video",
        preview_modes: preview_modes_for_asset(p),
        tools: try p.tools catch []
    };
}

fn asset_backend_status(profile) {
    let p = try profile catch map{};
    let family = str(try p.family catch "text");
    let binary = try p.binary catch false;
    let editable = try p.editable catch true;
    let decode_backend = "text-buffer";
    let export_backend = "text-writer";
    let player_backend = "none";
    let decode_status = "ready";
    let export_status = "ready";
    let player_status = "none";
    let native_required = false;
    let actions = ["preview", "metadata"];

    if binary {
        native_required = true;
        decode_status = "planned";
        export_status = "planned";
        decode_backend = "native-" + family + "-decoder";
        export_backend = "native-" + family + "-exporter";
        actions = ["preview-contract", "metadata", "decode-plan", "export-plan"];
    }
    if family == "table" {
        decode_backend = "csv-tsv-grid";
        export_backend = "csv-tsv-writer";
        actions = ["preview", "metadata", "grid", "sort-filter", "save"];
    } else if family == "code" {
        decode_backend = "pblang-text-frontend";
        export_backend = "source-writer";
        actions = ["preview", "metadata", "edit", "check", "run", "save"];
    } else if family == "document" and not binary {
        decode_backend = "markup-text-decoder";
        export_backend = "markup-text-exporter";
        actions = ["preview", "metadata", "edit", "outline", "save"];
    } else if family == "pdf" {
        decode_backend = "native-pdf-page-decoder";
        export_backend = "native-pdf-exporter";
        actions = ["preview-contract", "metadata", "extract-plan", "annotate-plan", "export-plan"];
        editable = false;
    } else if family == "image" {
        actions = ["preview-contract", "metadata", "crop-plan", "filter-plan", "export-plan"];
    } else if family == "audio" {
        player_backend = "native-audio-player";
        player_status = "planned";
        actions = ["preview-contract", "metadata", "play-plan", "waveform-plan", "trim-plan"];
    } else if family == "video" {
        player_backend = "native-video-player";
        player_status = "planned";
        actions = ["preview-contract", "metadata", "play-plan", "timeline-plan", "caption-plan", "export-plan"];
    }

    return map{
        format: "pbide.asset.backend_status.v1",
        family: family,
        path: str(try p.path catch ""),
        binary: binary,
        editable: editable,
        native_required: native_required,
        decode_backend: decode_backend,
        export_backend: export_backend,
        player_backend: player_backend,
        decode_status: decode_status,
        export_status: export_status,
        player_status: player_status,
        ready: decode_status == "ready" and export_status == "ready",
        actions: actions
    };
}

fn asset_backend_summary(profile) {
    let s = asset_backend_status(profile);
    let base = "asset backend: " + str(try s.family catch "text") +
        " decode " + str(try s.decode_status catch "?") +
        " / export " + str(try s.export_status catch "?");
    if str(try s.player_status catch "none") != "none" {
        return base + " / player " + str(try s.player_status catch "?");
    }
    return base;
}

fn asset_action_plan(action, profile, target = "") {
    let a = str_lower(str_trim(str(action)));
    let s = asset_backend_status(profile);
    let family = str(try s.family catch "text");
    let binary = try s.binary catch false;
    let requires = ["explicit user action"];
    let destructive = a == "overwrite" or a == "replace" or a == "delete";
    let executable = false;
    let ok = true;
    if binary {
        array_push(requires, "native decoder/export/player backend");
        array_push(requires, "write target path for export actions");
    } else {
        if a == "save" or a == "preview" or a == "metadata" { executable = true; }
    }
    if destructive { array_push(requires, "backup before mutation"); ok = false; }
    if a == "play" and not (family == "audio" or family == "video") { ok = false; array_push(requires, "audio/video asset"); }
    if a == "decode" and not binary { executable = true; }
    return map{
        format: "pbide.asset.action_plan.v1",
        action: a,
        family: family,
        target: str(target),
        binary: binary,
        executable: executable,
        ok: ok,
        destructive: destructive,
        backend_status: s,
        requires: requires,
        reason: asset_backend_summary(profile)
    };
}

fn asset_tool_palette(profile) {
    let mode = asset_editor_mode(profile);
    let backend = asset_backend_status(profile);
    let family = str(try mode.family catch "text");
    let decode_ready = (try backend.decode_status catch "planned") == "ready";
    let export_ready = (try backend.export_status catch "planned") == "ready";
    let tools = [];
    array_push(tools, map{ id: "preview", label: "Preview", group: "view", enabled: true });
    array_push(tools, map{ id: "metadata", label: "Metadata", group: "view", enabled: true });
    if try mode.safe_text_edit catch false {
        array_push(tools, map{ id: "edit", label: "Edit", group: "edit", enabled: true });
        array_push(tools, map{ id: "save", label: "Save", group: "file", enabled: true });
    } else {
        array_push(tools, map{ id: "decode", label: "Native decoder", group: "backend", enabled: decode_ready });
        array_push(tools, map{ id: "export", label: "Export copy", group: "file", enabled: export_ready });
    }
    if family == "table" or family == "sheet" {
        array_push(tools, map{ id: "grid", label: "Grid", group: "table", enabled: true });
        array_push(tools, map{ id: "formula", label: "Formula", group: "table", enabled: true });
        array_push(tools, map{ id: "chart", label: "Chart", group: "table", enabled: true });
    }
    if family == "document" or family == "slides" {
        array_push(tools, map{ id: "drag", label: "Drag/drop elements", group: "layout", enabled: true });
        array_push(tools, map{ id: "style", label: "Styles", group: "layout", enabled: true });
        array_push(tools, map{ id: "page", label: "Page/slide preview", group: "view", enabled: true });
    }
    if family == "pdf" {
        array_push(tools, map{ id: "search", label: "Search text", group: "pdf", enabled: true });
        array_push(tools, map{ id: "annotate", label: "Annotate", group: "pdf", enabled: true });
    }
    if family == "image" {
        array_push(tools, map{ id: "crop", label: "Crop", group: "image", enabled: true });
        array_push(tools, map{ id: "filter", label: "Filters", group: "image", enabled: true });
        array_push(tools, map{ id: "draw", label: "Draw", group: "image", enabled: true });
    }
    if family == "audio" or family == "video" {
        array_push(tools, map{ id: "play", label: "Play", group: "media", enabled: true });
        array_push(tools, map{ id: "trim", label: "Trim", group: "media", enabled: true });
        array_push(tools, map{ id: "timeline", label: "Timeline", group: "media", enabled: true });
    }
    if family == "video" {
        array_push(tools, map{ id: "captions", label: "Captions", group: "media", enabled: true });
        array_push(tools, map{ id: "thumbnail", label: "Thumbnails", group: "media", enabled: true });
    }
    return tools;
}

fn asset_tool_summary(profile) {
    let mode = asset_editor_mode(profile);
    let palette = asset_tool_palette(profile);
    let labels = [];
    let i = 0;
    while i < len(palette) {
        let label = str(try palette[i].label catch "");
        if not (try palette[i].enabled catch true) { label = label + " (needs backend)"; }
        array_push(labels, label);
        i = i + 1;
    }
    return str(try mode.title catch "editor") + ": " + str_join(labels, " · ");
}

fn preview_feature_lines(profile, mode) {
    let p = try profile catch map{};
    let m = str_lower(str(mode));
    let family = str(try p.family catch "text");
    let editor_mode = asset_editor_mode(p);
    let lines = [];
    array_push(lines, "Editor mode: " + str(try editor_mode.title catch "editor"));
    array_push(lines, "Preview modes: " + str_join(preview_modes_for_asset(p), ", "));
    array_push(lines, "Backend: " + asset_backend_summary(p));
    array_push(lines, "Tool palette: " + asset_tool_summary(p));
    if family == "document" {
        array_push(lines, "Document tools: paragraphs, styles, tables, images, free-position elements, export plan.");
    } else if family == "slides" {
        array_push(lines, "Slides tools: slide canvas, shapes, media placeholders, notes, transition metadata.");
    } else if family == "sheet" or family == "table" {
        array_push(lines, "Sheet tools: editable grid contract, formulas, sort/filter, chart/export plan.");
    } else if family == "pdf" {
        array_push(lines, "PDF tools: page thumbnails, search/extract, annotations, safe export copy.");
    } else if family == "image" {
        array_push(lines, "Image tools: view, crop, resize, draw, filters, metadata.");
    } else if family == "audio" {
        array_push(lines, "Audio tools: player controls, waveform, trim, normalize, metadata.");
    } else if family == "video" {
        array_push(lines, "Video tools: player controls, timeline, trim, captions, thumbnails, export.");
    } else if family == "code" {
        array_push(lines, "Code tools: syntax, outline, diagnostics, run/check, watcher.");
    } else {
        array_push(lines, "Text tools: edit, find/replace, preview, save.");
    }
    if try p.binary catch false {
        array_push(lines, "Safety: direct Save is blocked until the native decoder/export backend is attached.");
    }
    return lines;
}

fn _preview_first_lines(text, limit) {
    let out = [];
    let lines = str_split(str(text), "\n");
    let i = 0;
    while i < len(lines) and len(out) < limit {
        array_push(out, str(i + 1) + ": " + str(lines[i]));
        i = i + 1;
    }
    if len(lines) > len(out) { array_push(out, "... +" + str(len(lines) - len(out)) + " more line(s)"); }
    return out;
}

fn _preview_csv_lines(text, limit) {
    let lines = str_split(str(text), "\n");
    let header = "";
    if len(lines) > 0 { header = str(lines[0]); }
    let delim = ",";
    if str_contains(header, "\t") { delim = "\t"; }
    let cols = str_split(header, delim);
    let out = ["table preview: " + str(len(lines)) + " row(s), " + str(len(cols)) + " column(s)", "columns: " + str_join(cols, " | ")];
    let i = 1;
    while i < len(lines) and len(out) < limit {
        if str_trim(lines[i]) != "" { array_push(out, str(i) + ": " + str_replace_all(str(lines[i]), delim, " | ")); }
        i = i + 1;
    }
    return out;
}

fn preview_lines_for_asset(profile, text, mode, limit) {
    if limit == nil or limit < 4 { limit = 12; }
    let p = try profile catch map{};
    let m = str_lower(str(mode));
    if m == "" { m = str(try p.preview catch "text"); }
    let lines = [
        "Preview: " + str(try p.editor catch "text") + " / " + str(try p.family catch "text") + " (" + str(try p.ext catch "") + ")",
        "Path: " + str(try p.path catch ""),
        "Mode: " + m,
        "Tools: " + str_join(try p.tools catch [], ", "),
        "Formats: " + str_join(try p.formats catch [], ", "),
        "Note: " + str(try p.note catch "")
    ];
    let features = preview_feature_lines(p, m);
    let fi = 0;
    while fi < len(features) and len(lines) < limit + 6 {
        array_push(lines, features[fi]);
        fi = fi + 1;
    }
    if try p.binary catch false {
        array_push(lines, "Binary/native asset: PBIDE opens a safe preview contract now; full decode/edit engines attach here.");
        return lines;
    }
    if (try p.family catch "") == "table" or m == "table" {
        let csv = _preview_csv_lines(text, limit);
        let i = 0;
        while i < len(csv) and len(lines) < limit + 6 {
            array_push(lines, csv[i]);
            i = i + 1;
        }
        return lines;
    }
    let body = _preview_first_lines(text, limit);
    let j = 0;
    while j < len(body) and len(lines) < limit + 6 {
        array_push(lines, body[j]);
        j = j + 1;
    }
    return lines;
}

fn _source_has_any(hay, needles) {
    let i = 0;
    while i < len(needles) {
        if str_contains(hay, str(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _option_number(options, key, fallback) {
    let v = try options[key] catch nil;
    if v == nil { return fallback; }
    let n = try parse_number(str(v)) catch fallback;
    if n == nil { return fallback; }
    return n;
}

fn app_run_safety_profile(profile, options = nil) {
    if options == nil { options = map{}; }
    let p = try profile catch map{};
    let kind = str(try p.kind catch "cli");
    let can_native = try p.can_native_run catch false;
    let has_gui = try p.has_gui catch false;
    let has_web = try p.has_web_runtime catch false;
    let timeout_ms = _option_number(options, "timeout_ms", 30000);
    let target_fps = 0;
    let frame_budget_ms = 0;
    let launch_mode = "headless";
    let watchdog = false;
    let gates = ["bounded process output", "no direct blocking GUI loop in PBIDE"];
    let risks = [];
    if can_native {
        launch_mode = "detached-guarded";
        watchdog = true;
        timeout_ms = _option_number(options, "timeout_ms", 120000);
        target_fps = 30;
        frame_budget_ms = 33;
        array_push(gates, "detached child process");
        array_push(gates, "wall-clock timeout");
        array_push(gates, "graphics frame cap");
        array_push(risks, "child app can draw or serve independently; PBIDE must stay interactive");
    }
    if has_web {
        timeout_ms = _option_number(options, "timeout_ms", 300000);
        target_fps = 10;
        frame_budget_ms = 100;
        array_push(gates, "local web server should use explicit port and browser security mode");
        array_push(risks, "web server may keep running until timeout or user stop");
    }
    if has_gui {
        array_push(gates, "display/graphics backend required");
        array_push(gates, "Esc/window-close path expected");
    }
    if timeout_ms < 5000 { timeout_ms = 5000; }
    if timeout_ms > 3600000 { timeout_ms = 3600000; }
    let max_frames = 0;
    if target_fps > 0 {
        max_frames = num_floor((timeout_ms * target_fps) / 1000);
        if max_frames < 60 { max_frames = 60; }
    }
    let runtime_limits = map{ elapsed_ms: num_floor(timeout_ms), workers: 2 };
    if max_frames > 0 { runtime_limits.frames = max_frames; }
    if frame_budget_ms > 0 { runtime_limits.frame_ms = frame_budget_ms; }
    let resource_runtime = PRODUCT_RUNTIME.runtime("pbide", "preview", map{ limits: runtime_limits });
    let resource_budget = resource_runtime.budget;
    let max_attempts = if can_native { 2 } else { 1 };
    let resilience_policy = RESILIENCE.policy("pbide-child-app", map{
        max_attempts: max_attempts,
        base_delay_ms: 250,
        multiplier: 2,
        max_delay_ms: 2000,
        timeout_ms: num_floor(timeout_ms),
        failure_threshold: max_attempts,
        recovery_ms: 5000
    });
    return map{
        format: "pbide.app_run_safety_profile.v1",
        kind: kind,
        launch_mode: launch_mode,
        can_native_run: can_native,
        watchdog: watchdog,
        timeout_ms: num_floor(timeout_ms),
        target_fps: target_fps,
        frame_budget_ms: frame_budget_ms,
        max_frames: max_frames,
        resource_budget: resource_budget,
        resource_runtime: resource_runtime,
        resource_status: RESOURCE_BUDGET.evaluate(resource_budget, RESOURCE_BUDGET.usage(map{})),
        resilience_policy: resilience_policy,
        resilience_state: RESILIENCE.initial(resilience_policy, 0),
        env: map{
            PBIDE_CHILD_APP: "1",
            PBLANG_GRAPHICS_MAX_MS: str(num_floor(timeout_ms)),
            PBLANG_GRAPHICS_MAX_FRAMES: str(max_frames),
            PBLANG_GRAPHICS_TARGET_FPS: str(target_fps)
        },
        gates: gates,
        risks: risks,
        summary: "launch=" + launch_mode +
            " timeout=" + str(num_floor(timeout_ms)) + "ms" +
            " fps=" + str(target_fps) +
            " max_frames=" + str(max_frames)
    };
}

fn app_run_resource_report(safety, usage_values) {
    let s = try safety catch map{};
    let b = try s.resource_budget catch RESOURCE_BUDGET.profile("untrusted");
    let evaluation = RESOURCE_BUDGET.evaluate(b, RESOURCE_BUDGET.usage(usage_values));
    return map{
        format: "pbide.app_run_resource_report.v1",
        allowed: evaluation.allowed,
        evaluation: evaluation,
        adaptive: RESOURCE_BUDGET.adaptive_plan(evaluation),
        summary: RESOURCE_BUDGET.summary(evaluation)
    };
}

fn app_run_safety_summary(safety) {
    let s = try safety catch map{};
    return "safety=" + str(try s.launch_mode catch "headless")
        + " timeout=" + str(try s.timeout_ms catch 0) + "ms"
        + " fps=" + str(try s.target_fps catch 0)
        + " frames=" + str(try s.max_frames catch 0)
        + " gates=[" + str_join(try s.gates catch [], ", ") + "]";
}

fn app_run_capability_plan(profile) {
    let p = try profile catch map{};
    let kind = str(try p.kind catch "cli");
    let has_gui = try p.has_gui catch false;
    let has_web = try p.has_web_runtime catch false;
    let needed = ["core"];
    if has_gui { array_push(needed, "gfx"); }
    if has_web {
        array_push(needed, "net");
        array_push(needed, "http");
    }
    if not has_gui and not has_web { array_push(needed, "stdio"); }
    let env_overrides = map{
        PBIDE_CHILD_CAPS: "least-privilege",
        PBLANG_ALLOW_ALL: "0",
        PBLANG_ALLOW_EXEC: "0",
        PBLANG_ALLOW_FFI: "0"
    };
    return map{
        format: "pbide.app_run_capability_plan.v1",
        kind: kind,
        cli_args: [],
        needed: needed,
        env_overrides: env_overrides,
        grants_exec: false,
        grants_ffi: false,
        grants_all: false,
        policy: "least privilege child launch; use pblang defaults, do not pass --allow-all, and clear inherited PBLANG_ALLOW_* env grants",
        summary: "caps=" + str_join(needed, "+") + " exec=false ffi=false all=false env-guard=true"
    };
}

fn app_run_profile(source, path = "") {
    let s = str(source);
    let low = str_lower(s);
    let target = "cli";
    if str_contains(low, "app target: both") or str_contains(low, "return \"both\"") {
        target = "both";
    } elif str_contains(low, "app target: web") or str_contains(low, "return \"web\"") {
        target = "web";
    } elif str_contains(low, "app target: gui") or str_contains(low, "return \"gui\"") {
        target = "gui";
    } elif str_contains(low, "app target: doc") or str_contains(low, "return \"doc\"") {
        target = "doc";
    }

    let has_gui = _source_has_any(low, [
        "fn run_gui(",
        "gui.run(",
        "gfx.window(",
        "stdlib/gui.sapp",
        "stdlib/graphics.sapp"
    ]);
    let has_web_runtime = _source_has_any(low, [
        "serve_forever(",
        "serve_once(",
        "http_server.sapp",
        "web_framework.sapp",
        "app_get(",
        "app_post(",
        "res_html(",
        "html_page("
    ]);
    let has_web_target = target == "web" or target == "both";
    let has_preview = str_contains(low, "fn preview(");

    let kind = "cli";
    if has_web_runtime { kind = "web"; }
    if has_gui { kind = "gui"; }
    if target == "both" and has_web_runtime { kind = "gui+web"; }
    if target == "web" and not has_web_runtime { kind = "web-metadata"; }
    if target == "doc" { kind = "document-preview"; }

    let can_native_run = has_gui or has_web_runtime;
    let run_method = "selfhost-headless";
    if has_gui { run_method = "pblang-native-gui"; }
    elif has_web_runtime { run_method = "pblang-native-web-server"; }
    elif has_web_target { run_method = "preview-only-web-metadata"; }
    elif target == "doc" { run_method = "preview-only-document"; }

    let preview_method = "asset/text preview";
    if has_preview { preview_method = "headless preview()"; }
    if has_gui { preview_method = "designer/native GUI preview"; }
    elif has_web_runtime { preview_method = "web server launch plan"; }

    let requires = ["pblang runtime"];
    if can_native_run { array_push(requires, "--allow-exec or --allow-all from PBIDE"); }
    if has_gui { array_push(requires, "display and graphics backend"); }
    if has_web_runtime { array_push(requires, "HTTP/network capability and a free port"); }

    let profile = map{
        format: "pbide.app_run_profile.v1",
        path: str(path),
        kind: kind,
        target: target,
        has_gui: has_gui,
        has_web: has_web_runtime or has_web_target,
        has_web_runtime: has_web_runtime,
        has_preview: has_preview,
        can_native_run: can_native_run,
        run_method: run_method,
        preview_method: preview_method,
        requires: requires
    };
    profile.safety = app_run_safety_profile(profile, nil);
    profile.capabilities = app_run_capability_plan(profile);
    return profile;
}

fn app_run_profile_summary(profile) {
    let p = try profile catch map{};
    let native = "headless";
    if try p.can_native_run catch false { native = "native"; }
    return "App profile: " + str(try p.kind catch "cli")
        + " target=" + str(try p.target catch "cli")
        + " run=" + str(try p.run_method catch "selfhost-headless")
        + " preview=" + str(try p.preview_method catch "asset/text preview")
        + " mode=" + native
        + " requires=[" + str_join(try p.requires catch [], ", ") + "]"
        + " " + app_run_safety_summary(try p.safety catch app_run_safety_profile(p, nil))
        + " " + str(try p.capabilities.summary catch try app_run_capability_plan(p).summary catch "caps=default");
}

fn _designer_screen_seen(paths, path) {
    let p = str(path);
    let i = 0;
    while paths != nil and i < len(paths) {
        if str(paths[i]) == p { return true; }
        i = i + 1;
    }
    return false;
}

fn _designer_screen_title(path) {
    let p = str(path);
    if str_trim(p) == "" { return "untitled"; }
    let base = try path_basename(p) catch p;
    if base == nil or str(base) == "" { base = p; }
    let name = str(base);
    let dot = 0 - 1;
    let i = 0;
    while i < len(name) {
        if strcharcodeat(name, i) == 46 { dot = i; }
        i = i + 1;
    }
    if dot > 0 { name = str_slice(name, 0, dot); }
    return name;
}

fn designer_screen_kind(path) {
    let ext = _path_extension(path);
    if not (ext == "sapp" or ext == "pb" or ext == "pblang") { return ""; }
    let p = str_lower(str(path));
    let base = str_lower(_designer_screen_title(path));
    if str_contains(p, "/screens/") or str_contains(p, "\\screens\\") {
        return "screen";
    }
    if str_contains(base, "screen") or str_contains(base, "view") or str_contains(base, "page") or str_contains(base, "form") or str_contains(base, "window") {
        return "screen";
    }
    if str_contains(base, "gui") or str_contains(base, "ui") or str_contains(base, "designer") {
        return "ui";
    }
    if base == "main" or base == "app" or str_contains(p, "/main.") or str_contains(p, "/app.") {
        return "entry";
    }
    return "source";
}

fn designer_screen_tabs_from_files(files, active_path) {
    let out = [];
    let seen = [];
    let active = str(try active_path catch "");
    let ai = 0 - 1;
    let i = 0;
    while files != nil and i < len(files) {
        let p = str(files[i]);
        let kind = designer_screen_kind(p);
        if p != "" and kind != "" and not _designer_screen_seen(seen, p) {
            let is_active = p == active;
            if is_active { ai = len(out); }
            array_push(out, map{
                index: len(out),
                path: p,
                title: _designer_screen_title(p),
                kind: kind,
                active: is_active
            });
            array_push(seen, p);
        }
        i = i + 1;
    }
    if active != "" and not _designer_screen_seen(seen, active) and designer_screen_kind(active) != "" {
        ai = len(out);
        array_push(out, map{
            index: len(out),
            path: active,
            title: _designer_screen_title(active),
            kind: designer_screen_kind(active),
            active: true
        });
    }
    if len(out) == 0 {
        array_push(out, map{ index: 0, path: active, title: _designer_screen_title(active), kind: "scratch", active: true });
        ai = 0;
    }
    if ai < 0 { ai = 0; out[0].active = true; }
    return out;
}

fn designer_document_plan(design) {
    let d = try design catch map{};
    let widgets = try d.widgets catch [];
    let target = str(try d.target catch "gui");
    let out = [
        "Designer document plan",
        "target: " + target,
        "exports: txt, docx, doc, odt, rtf, pdf, ppt, pptx, xls, xlsx, csv",
        "items: " + str(len(widgets)),
        "drag/drop: labels, rich text, text boxes, images/media placeholders, tables, charts, 2D/3D/ND components",
        "layout: absolute/free placement now; responsive/page-flow export metadata later"
    ];
    let i = 0;
    while i < len(widgets) and len(out) < 18 {
        let w = widgets[i];
        array_push(out, "- " + str(i + 1) + ". " + str(try w.kind catch "?") + " " + str(try w.name catch "?") +
            " @ " + str(try w.x catch 0) + "," + str(try w.y catch 0) +
            " " + str(try w.w catch 0) + "x" + str(try w.h catch 0));
        i = i + 1;
    }
    return out;
}

fn designer_document_export_plan(design, format) {
    let fmt = str_lower(str_trim(str(format)));
    if fmt == "" { fmt = "pdf"; }
    let supported = ["txt", "docx", "doc", "odt", "rtf", "pdf", "ppt", "pptx", "xls", "xlsx", "csv"];
    let ok = false;
    let i = 0;
    while i < len(supported) {
        if supported[i] == fmt { ok = true; }
        i = i + 1;
    }
    let base = designer_document_plan(design);
    let out = [
        "Designer export plan: " + fmt,
        "supported: " + str(ok),
        "backend: planned native encoder",
        "safety: source design remains editable; export writes a new file"
    ];
    let j = 0;
    while j < len(base) and len(out) < 16 {
        array_push(out, base[j]);
        j = j + 1;
    }
    return out;
}

fn _designer_field(name, value, kind = "text", editable = true) {
    return map{ name: str(name), value: str(value), kind: str(kind), editable: editable };
}

fn designer_property_fields(widget) {
    let w = try widget catch nil;
    if w == nil { return [_designer_field("selection", "none", "status", false)]; }
    let fields = [
        _designer_field("kind", try w.kind catch "widget", "readonly", false),
        _designer_field("name", try w.name catch "", "identifier", true),
        _designer_field("x", try w.x catch 0, "number", true),
        _designer_field("y", try w.y catch 0, "number", true),
        _designer_field("w", try w.w catch 0, "number", true),
        _designer_field("h", try w.h catch 0, "number", true)
    ];
    let k = str(try w.kind catch "");
    if k == "textbox" {
        array_push(fields, _designer_field("value", try w.value catch "", "text", true));
    } else if k == "panel" {
        array_push(fields, _designer_field("title", try w.title catch "", "text", true));
    } else if k == "checkbox" {
        array_push(fields, _designer_field("checked", try w.checked catch false, "bool", true));
    } else if k == "radio" {
        array_push(fields, _designer_field("group", try w.group catch "group1", "text", true));
        array_push(fields, _designer_field("selected", try w.selected catch false, "bool", true));
    } else if k == "select" {
        array_push(fields, _designer_field("options", str_join(try w.options catch [], ", "), "list", true));
        array_push(fields, _designer_field("selected", try w.selected catch 0, "number", true));
    } else if k == "slider" {
        array_push(fields, _designer_field("value", try w.value catch 0, "number", true));
        array_push(fields, _designer_field("min", try w.min catch 0, "number", true));
        array_push(fields, _designer_field("max", try w.max catch 100, "number", true));
    } else {
        array_push(fields, _designer_field("text", try w.text catch try w.title catch try w.name catch "", "text", true));
    }
    if try w.component catch nil != nil {
        array_push(fields, _designer_field("component", try w.component.kind catch try w.component.type catch "attached", "component", false));
    }
    return fields;
}

fn designer_property_summary(widget) {
    let fields = designer_property_fields(widget);
    let parts = [];
    let i = 0;
    while i < len(fields) and len(parts) < 8 {
        array_push(parts, str(try fields[i].name catch "?") + "=" + str(try fields[i].value catch ""));
        i = i + 1;
    }
    return str_join(parts, " · ");
}

fn designer_component_library() {
    return [
        map{ id: "app_shell", group: "layout", title: "App shell", kind: "panel", detail: "header/sidebar/content responsive shell" },
        map{ id: "form_stack", group: "forms", title: "Form stack", kind: "panel", detail: "label/input/button form section" },
        map{ id: "data_table", group: "data", title: "Data table", kind: "doctable", detail: "table/spreadsheet placeholder with export metadata" },
        map{ id: "media_card", group: "media", title: "Media card", kind: "docmedia", detail: "image/audio/video preview block" },
        map{ id: "safe_calculator", group: "examples", title: "Safe calculator", kind: "panel", detail: "calculator display, keypad, operations, history, light/dark theme example" },
        map{ id: "chart_panel", group: "visual", title: "Chart panel", kind: "chart2d", detail: "2D chart with title and data metadata" },
        map{ id: "scene_camera", group: "3d", title: "3D camera rig", kind: "camera", detail: "camera/light/material starter scene" },
        map{ id: "physics_prefab", group: "game", title: "Physics prefab", kind: "prefab", detail: "prefab with body/collider metadata" },
        map{ id: "web_embed", group: "web", title: "Web component", kind: "webcomp", detail: "HTML/CSS/JS metadata, not executed by native designer" },
        map{ id: "custom_component", group: "custom", title: "Custom component", kind: "custom", detail: "user-defined component contract" }
    ];
}

fn filter_designer_components(query, limit) {
    if limit == nil or limit < 1 { limit = 20; }
    let q = str_lower(str_trim(str(query)));
    let out = [];
    let lib = designer_component_library();
    let i = 0;
    while i < len(lib) and len(out) < limit {
        let c = lib[i];
        let hay = str_lower(str(try c.id catch "") + "\n" + str(try c.group catch "") + "\n" + str(try c.title catch "") + "\n" + str(try c.kind catch "") + "\n" + str(try c.detail catch ""));
        if q == "" or str_contains(hay, q) {
            c.index = i;
            array_push(out, c);
        }
        i = i + 1;
    }
    return out;
}

fn designer_component_lines(components, limit) {
    if limit == nil or limit < 1 { limit = 8; }
    let lines = [];
    let i = 0;
    while components != nil and i < len(components) and len(lines) < limit {
        let c = components[i];
        array_push(lines, str(i + 1) + ". [" + str(try c.group catch "?") + "] " + str(try c.title catch "?") + " -> " + str(try c.kind catch "?"));
        i = i + 1;
    }
    if len(lines) == 0 { array_push(lines, "No designer components match."); }
    return lines;
}

fn _designer_preset_item(kind, name, x, y, w, h, text) {
    return map{ kind: kind, name: name, x: x, y: y, w: w, h: h, text: text };
}

fn _designer_preset_record(id, title, items) {
    return map{
        format: "pbide.designer.component_preset.v1",
        ok: true,
        id: id,
        title: title,
        items: items,
        item_count: len(items),
        summary: title + " preset: " + str(len(items)) + " item(s)"
    };
}

fn designer_component_default_id(query) {
    let hits = filter_designer_components(query, 1);
    if len(hits) > 0 { return str(try hits[0].id catch "app_shell"); }
    return "app_shell";
}

fn designer_component_preset(component_id, x, y) {
    let id = str_lower(str_trim(str(component_id)));
    let px = try parse_number(str(x)) catch 0;
    let py = try parse_number(str(y)) catch 0;
    if px == nil { px = 0; }
    if py == nil { py = 0; }
    if id == "app_shell" {
        return _designer_preset_record(id, "App shell", [
            _designer_preset_item("panel", "app_header", px, py, 460, 48, "App header"),
            _designer_preset_item("panel", "app_sidebar", px, py + 56, 140, 260, "Navigation"),
            _designer_preset_item("panel", "app_content", px + 152, py + 56, 308, 260, "Content")
        ]);
    }
    if id == "form_stack" {
        return _designer_preset_record(id, "Form stack", [
            _designer_preset_item("label", "form_title", px, py, 180, 24, "Form title"),
            _designer_preset_item("textbox", "form_input", px, py + 36, 240, 28, "Type here"),
            _designer_preset_item("button", "form_submit", px, py + 76, 140, 32, "Submit")
        ]);
    }
    if id == "data_table" {
        return _designer_preset_record(id, "Data table", [
            _designer_preset_item("doctable", "data_table", px, py, 320, 160, "Table 3x3")
        ]);
    }
    if id == "media_card" {
        return _designer_preset_record(id, "Media card", [
            _designer_preset_item("docimage", "media_image", px, py, 220, 132, "Image placeholder"),
            _designer_preset_item("doctext", "media_caption", px, py + 144, 220, 64, "Caption or transcript")
        ]);
    }
    if id == "safe_calculator" or id == "calculator" {
        let margin = 20;
        let gap = 10;
        let shell_w = 860;
        let shell_h = 820;
        let left_x = px + margin;
        let title_y = py + margin;
        let display_y = title_y + 38;
        let display_h = 64;
        let status_y = display_y + display_h + 8;
        let keys_y = status_y + 26;
        let left_w = 540;
        let right_w = 270;
        let history_x = left_x + left_w + gap;
        let history_y = display_y;
        let history_h = shell_h - display_y - margin;
        let col_w = 127;
        let row_h = 46;
        let row_step = row_h + gap;
        let c0 = left_x;
        let c1 = left_x + col_w + gap;
        let c2 = left_x + (col_w + gap) * 2;
        let c3 = left_x + (col_w + gap) * 3;
        let r0 = keys_y;
        let r1 = keys_y + row_step;
        let r2 = keys_y + row_step * 2;
        let r3 = keys_y + row_step * 3;
        let r4 = keys_y + row_step * 4;
        let r5 = keys_y + row_step * 5;
        let r6 = keys_y + row_step * 6;
        let r7 = keys_y + row_step * 7;
        let r8 = keys_y + row_step * 8;
        let r9 = keys_y + row_step * 9;
        let r10 = keys_y + row_step * 10;
        return _designer_preset_record("safe_calculator", "Safe calculator", [
            _designer_preset_item("panel", "calc_shell", px, py, shell_w, shell_h, "Safe Calculator"),
            _designer_preset_item("label", "calc_title", left_x, title_y, 300, 26, "Safe pblang Calculator"),
            _designer_preset_item("label", "calc_subtitle", left_x + 280, title_y + 4, 250, 22, "No eval · shared parser · memory · history"),
            _designer_preset_item("panel", "calc_display_panel", left_x, display_y, left_w, display_h, "Display"),
            _designer_preset_item("textbox", "calc_display", left_x + 14, display_y + 14, left_w - 28, 36, "0"),
            _designer_preset_item("label", "calc_status", left_x, status_y, left_w - 96, 20, "Ready"),
            _designer_preset_item("label", "calc_memory", left_x + left_w - 88, status_y, 88, 20, "M=0"),
            _designer_preset_item("panel", "calc_history_panel", history_x, history_y, right_w, history_h, "History"),
            _designer_preset_item("label", "calc_history_title", history_x + 14, history_y + 16, 150, 22, "History"),
            _designer_preset_item("label", "calc_history_count", history_x + right_w - 84, history_y + 18, 70, 20, "0 rows"),
            _designer_preset_item("label", "calc_history_empty", history_x + 14, history_y + 54, right_w - 28, 24, "No calculations yet."),

            _designer_preset_item("button", "calc_mc", c0, r0, col_w, row_h, "MC"),
            _designer_preset_item("button", "calc_mr", c1, r0, col_w, row_h, "MR"),
            _designer_preset_item("button", "calc_mplus", c2, r0, col_w, row_h, "M+"),
            _designer_preset_item("button", "calc_mminus", c3, r0, col_w, row_h, "M-"),
            _designer_preset_item("button", "calc_clear", c0, r1, col_w, row_h, "C"),
            _designer_preset_item("button", "calc_back", c1, r1, col_w, row_h, "Back"),
            _designer_preset_item("button", "calc_lparen", c2, r1, col_w, row_h, "("),
            _designer_preset_item("button", "calc_rparen", c3, r1, col_w, row_h, ")"),
            _designer_preset_item("button", "calc_7", c0, r2, col_w, row_h, "7"),
            _designer_preset_item("button", "calc_8", c1, r2, col_w, row_h, "8"),
            _designer_preset_item("button", "calc_9", c2, r2, col_w, row_h, "9"),
            _designer_preset_item("button", "calc_div", c3, r2, col_w, row_h, "/"),
            _designer_preset_item("button", "calc_4", c0, r3, col_w, row_h, "4"),
            _designer_preset_item("button", "calc_5", c1, r3, col_w, row_h, "5"),
            _designer_preset_item("button", "calc_6", c2, r3, col_w, row_h, "6"),
            _designer_preset_item("button", "calc_mul", c3, r3, col_w, row_h, "*"),
            _designer_preset_item("button", "calc_1", c0, r4, col_w, row_h, "1"),
            _designer_preset_item("button", "calc_2", c1, r4, col_w, row_h, "2"),
            _designer_preset_item("button", "calc_3", c2, r4, col_w, row_h, "3"),
            _designer_preset_item("button", "calc_sub", c3, r4, col_w, row_h, "-"),
            _designer_preset_item("button", "calc_0", c0, r5, col_w, row_h, "0"),
            _designer_preset_item("button", "calc_dot", c1, r5, col_w, row_h, "."),
            _designer_preset_item("button", "calc_equals", c2, r5, col_w, row_h, "="),
            _designer_preset_item("button", "calc_add", c3, r5, col_w, row_h, "+"),
            _designer_preset_item("button", "calc_percent", c0, r6, col_w, row_h, "%"),
            _designer_preset_item("button", "calc_mod", c1, r6, col_w, row_h, "mod"),
            _designer_preset_item("button", "calc_pow", c2, r6, col_w, row_h, "^"),
            _designer_preset_item("button", "calc_sqrt", c3, r6, col_w, row_h, "sqrt"),
            _designer_preset_item("button", "calc_sin", c0, r7, col_w, row_h, "sin"),
            _designer_preset_item("button", "calc_cos", c1, r7, col_w, row_h, "cos"),
            _designer_preset_item("button", "calc_tan", c2, r7, col_w, row_h, "tan"),
            _designer_preset_item("button", "calc_ln", c3, r7, col_w, row_h, "ln"),
            _designer_preset_item("button", "calc_log10", c0, r8, col_w, row_h, "log10"),
            _designer_preset_item("button", "calc_abs", c1, r8, col_w, row_h, "abs"),
            _designer_preset_item("button", "calc_pi", c2, r8, col_w, row_h, "pi"),
            _designer_preset_item("button", "calc_e", c3, r8, col_w, row_h, "e"),
            _designer_preset_item("button", "calc_asin", c0, r9, col_w, row_h, "asin"),
            _designer_preset_item("button", "calc_acos", c1, r9, col_w, row_h, "acos"),
            _designer_preset_item("button", "calc_atan", c2, r9, col_w, row_h, "atan"),
            _designer_preset_item("button", "calc_fact", c3, r9, col_w, row_h, "fact"),
            _designer_preset_item("button", "calc_theme", c0, r10, col_w, row_h, "Theme"),
            _designer_preset_item("button", "calc_history", c1, r10, col_w, row_h, "History"),
            _designer_preset_item("button", "calc_clear_history", c2, r10, col_w, row_h, "Clear History"),
            _designer_preset_item("button", "calc_close", c3, r10, col_w, row_h, "Close"),
            _designer_preset_item("label", "calc_footer", left_x, py + shell_h - 34, left_w, 22, "Keyboard: Enter =, Backspace delete, Esc clear")
        ]);
    }
    if id == "chart_panel" {
        return _designer_preset_record(id, "Chart panel", [
            _designer_preset_item("panel", "chart_panel", px, py, 260, 180, "Metrics"),
            _designer_preset_item("chart2d", "chart_main", px + 16, py + 36, 220, 120, "Line chart")
        ]);
    }
    if id == "scene_camera" {
        return _designer_preset_record(id, "3D camera rig", [
            _designer_preset_item("camera", "scene_camera", px, py, 150, 90, "Camera"),
            _designer_preset_item("light", "scene_light", px + 164, py, 150, 90, "Directional light"),
            _designer_preset_item("material", "scene_material", px, py + 108, 170, 88, "PBR material")
        ]);
    }
    if id == "physics_prefab" {
        return _designer_preset_record(id, "Physics prefab", [
            _designer_preset_item("prefab", "physics_prefab", px, py, 190, 100, "Prefab"),
            _designer_preset_item("physics", "physics_body", px + 204, py, 180, 90, "Physics body")
        ]);
    }
    if id == "web_embed" {
        return _designer_preset_record(id, "Web component", [
            _designer_preset_item("webcomp", "web_component", px, py, 240, 120, "HTML/CSS/JS component")
        ]);
    }
    if id == "custom_component" {
        return _designer_preset_record(id, "Custom component", [
            _designer_preset_item("custom", "custom_component", px, py, 200, 100, "Custom component")
        ]);
    }
    return map{
        format: "pbide.designer.component_preset.v1",
        ok: false,
        id: component_id,
        title: "Unknown component preset",
        items: [],
        item_count: 0,
        summary: "component preset not found: " + str(component_id)
    };
}

fn designer_component_preset_summary(preset) {
    let p = try preset catch map{};
    let items = try p.items catch [];
    let lines = [
        str(try p.title catch "Component preset") + " · " + str(len(items)) + " item(s)",
        str(try p.summary catch "")
    ];
    let i = 0;
    while i < len(items) and i < 6 {
        let it = items[i];
        array_push(lines, "- " + str(try it.kind catch "?") + " " + str(try it.name catch "?") +
            " @ " + str(try it.x catch 0) + "," + str(try it.y catch 0) +
            " " + str(try it.w catch 0) + "x" + str(try it.h catch 0));
        i = i + 1;
    }
    return lines;
}

fn designer_status(design) {
    let d = try design catch map{};
    let widgets = try d.widgets catch [];
    let n = len(widgets);
    let target = str(try d.target catch "gui");
    let layout = str(try d.layout catch "free");
    let tool = str(try d.tool catch "label");
    let sel = try parse_number(str(try d.sel catch 0 - 1)) catch 0 - 1;
    if sel == nil { sel = 0 - 1; }
    sel = num_floor(sel);
    let out = "designer: app " + target + " · layout " + layout + " · tool " + tool + " · " + str(n) + " item(s)";
    if n == 0 or sel < 0 or sel >= n {
        return out + " · no selection";
    }
    let w = widgets[sel];
    return out + " · sel " + str(sel + 1) + "/" + str(n) + " " +
        str(try w.kind catch "?") + " " + str(try w.name catch "?") +
        " @ " + str(try w.x catch 0) + "," + str(try w.y catch 0) +
        " " + str(try w.w catch 0) + "x" + str(try w.h catch 0);
}

fn code_hash(code) {
    let h = 5381;
    let i = 0;
    let s = str(code);
    while i < len(s) {
        h = num_mod(h * 33 + strcharcodeat(s, i), 2147483647);
        i = i + 1;
    }
    return h;
}

fn build_profile(mode) {
    let m = str_lower(str(mode));
    if m == "release" {
        return map{
            mode: "release",
            label: "Release",
            lint_before_run: false,
            diagnostics: "manual",
            history: true,
            optimize: "speed",
            output: "normal",
            note: "Run directly for speed; use Check before shipping."
        };
    }
    return map{
        mode: "debug",
        label: "Debug",
        lint_before_run: true,
        diagnostics: "always-before-run",
        history: true,
        optimize: "none",
        output: "diagnostic",
        note: "Check before run and block on diagnostics."
    };
}

fn next_build_mode(mode) {
    if str_lower(str(mode)) == "debug" { return "release"; }
    return "debug";
}

fn build_mode_summary(mode) {
    let p = build_profile(mode);
    return "mode: " + p.label + " | optimize=" + p.optimize + " | diagnostics=" + p.diagnostics;
}

fn _ui_quality_text(snapshot) {
    if snapshot == nil { return "ui ?"; }
    let score = try snapshot.quality_score catch nil;
    if score == nil { score = try snapshot.score catch nil; }
    let issues = try snapshot.issue_count catch 0;
    let text = "ui ?";
    if score != nil { text = "ui " + str(score) + "/100"; }
    if issues != nil and issues > 0 { text = text + " " + str(issues) + " issue(s)"; }
    return text;
}

fn _health_label(severity, snapshot) {
    let sev = str(severity);
    let issues = 0;
    if snapshot != nil { issues = try snapshot.issue_count catch 0; }
    if sev == "error" { return "ERROR"; }
    if sev == "warn" { return "WARN"; }
    if sev == "off" { return "OFF"; }
    if issues > 0 { return "WARN"; }
    if sev == "ok" { return "OK"; }
    return "INFO";
}

fn ide_health_line(w, build_mode, ui_snapshot) {
    let action = watcher_action(w);
    let severity = str(try action.severity catch "info");
    let profile = build_profile(build_mode);
    let label = _health_label(severity, ui_snapshot);
    return "health " + label
        + " | " + profile.label
        + " | " + watcher_badge(w)
        + " | " + _one_line(try action.message catch "ready", 42)
        + " | " + _ui_quality_text(ui_snapshot);
}

fn watcher_new(path, code) {
    let text = str(code);
    let line_count = len(str_split(text, "\n"));
    let symbol_count = len(outline(text));
    return map{
        enabled: true,
        path: str(path),
        revision: 0,
        hash: code_hash(text),
        last_hash: code_hash(text),
        dirty: false,
        lines: line_count,
        symbols: symbol_count,
        diagnostics: 0,
        checked_hash: "",
        diagnostics_state: "unchecked",
        diagnostics_stale: false,
        last_event: "watcher initialized",
        line_delta: 0,
        symbol_delta: 0,
        diagnostic_delta: 0,
        events: ["watcher initialized | lines " + str(line_count) + " | symbols " + str(symbol_count)]
    };
}

fn _watch_delta_text(label, delta) {
    if delta == 0 { return ""; }
    let sign = "+";
    if delta < 0 { sign = ""; }
    return " | " + label + " " + sign + str(delta);
}

fn _watch_diagnostic_state(w, h, event) {
    if str(event) == "check" { return "fresh"; }
    let checked = str(try w.checked_hash catch "");
    if checked == "" { return "unchecked"; }
    if checked != str(h) { return "stale"; }
    return "fresh";
}

fn _watch_event_text(event, changed, line_delta, symbol_delta, diagnostic_delta, diagnostic_state) {
    let text = str(event);
    if changed { text = text + " changed"; } else { text = text + " no-code-change"; }
    text = text + _watch_delta_text("lines", line_delta);
    text = text + _watch_delta_text("symbols", symbol_delta);
    text = text + _watch_delta_text("diagnostics", diagnostic_delta);
    text = text + " | diagnostics " + str(diagnostic_state);
    return text;
}

fn _watch_push_event(w, text) {
    let old = try w.events catch [];
    let next = [str(text)];
    let i = 0;
    while old != nil and i < len(old) and len(next) < 6 {
        if str(old[i]) != str(text) { array_push(next, old[i]); }
        i = i + 1;
    }
    w.events = next;
    return w;
}

fn watcher_update(w, path, code, dirty, diagnostics, event) {
    if w == nil { w = watcher_new(path, code); }
    let text = str(code);
    let h = code_hash(text);
    let changed = h != (try w.hash catch h);
    let old_lines = try w.lines catch len(str_split(text, "\n"));
    let old_symbols = try w.symbols catch len(outline(text));
    let old_diagnostics = try w.diagnostics catch 0;
    let new_lines = len(str_split(text, "\n"));
    let new_symbols = len(outline(text));
    let new_diagnostics = len(try diagnostics catch []);
    if changed { w.revision = (try w.revision catch 0) + 1; }
    w.path = str(path);
    w.last_hash = try w.hash catch h;
    w.hash = h;
    w.dirty = dirty;
    w.lines = new_lines;
    w.symbols = new_symbols;
    w.diagnostics = new_diagnostics;
    w.changed = changed;
    w.line_delta = new_lines - old_lines;
    w.symbol_delta = new_symbols - old_symbols;
    w.diagnostic_delta = new_diagnostics - old_diagnostics;
    if str(event) == "check" { w.checked_hash = h; }
    w.diagnostics_state = _watch_diagnostic_state(w, h, event);
    w.diagnostics_stale = w.diagnostics_state == "stale";
    if changed or str(event) != "draw" {
        let entry = _watch_event_text(event, changed, w.line_delta, w.symbol_delta, w.diagnostic_delta, w.diagnostics_state);
        w.last_event = entry;
        _watch_push_event(w, entry);
    }
    return w;
}

fn watcher_summary(w) {
    if w == nil { return "watch: off"; }
    let on = "on";
    if try w.enabled catch true { on = "on"; } else { on = "off"; }
    let d = "clean";
    if try w.dirty catch false { d = "dirty"; }
    return "watch: " + on + " rev " + str(try w.revision catch 0) + " " + d
        + " | lines " + str(try w.lines catch 0)
        + " | symbols " + str(try w.symbols catch 0)
        + " | diagnostics " + str(try w.diagnostics catch 0)
        + " " + str(try w.diagnostics_state catch "unchecked")
        + " | last " + str(try w.last_event catch "?");
}

fn watcher_action(w) {
    if w == nil { return map{ severity: "off", command: "watch", message: "watcher off - press F12 Watch" }; }
    let state = str(try w.diagnostics_state catch "unchecked");
    if state == "stale" {
        return map{ severity: "warn", command: "check", message: "diagnostics stale - press F6 Check" };
    }
    if state == "unchecked" {
        return map{ severity: "info", command: "check", message: "diagnostics unchecked - press F6 Check" };
    }
    let n = try w.diagnostics catch 0;
    if n > 0 {
        return map{ severity: "error", command: "diagnostic_next", message: "fresh diagnostics: " + str(n) + " issue(s) - press F8" };
    }
    let ui = try w.ui_snapshot catch nil;
    let ui_issues = 0;
    if ui != nil { ui_issues = try ui.issue_count catch 0; }
    if ui_issues > 0 {
        let score = try ui.quality_score catch "?";
        return map{ severity: "warn", command: "ui_snapshot", message: "ui observer: " + str(ui_issues) + " issue(s), quality " + str(score) + "/100 - open UI snapshot" };
    }
    if try w.dirty catch false {
        return map{ severity: "info", command: "save", message: "diagnostics fresh, unsaved changes - press Ctrl+S Save" };
    }
    return map{ severity: "ok", command: "none", message: "watcher ok - diagnostics fresh" };
}

fn watcher_badge(w) {
    if w == nil { return "watch off"; }
    let state = str(try w.diagnostics_state catch "unchecked");
    if state == "stale" { return "watch stale"; }
    if state == "unchecked" { return "watch unchecked"; }
    let n = try w.diagnostics catch 0;
    if n > 0 { return "watch err " + str(n); }
    let ui = try w.ui_snapshot catch nil;
    let ui_issues = 0;
    if ui != nil { ui_issues = try ui.issue_count catch 0; }
    if ui_issues > 0 { return "watch ui " + str(ui_issues); }
    if try w.dirty catch false { return "watch dirty"; }
    return "watch ok";
}

fn watcher_toolbar_label(w, enabled) {
    if enabled == false { return "NoWatch"; }
    let badge = watcher_badge(w);
    if badge == "watch stale" { return "Stale"; }
    if badge == "watch unchecked" { return "Unchk"; }
    if str_contains(badge, "watch err ") { return "Err" + str(try w.diagnostics catch 0); }
    if str_contains(badge, "watch ui ") { return "Ui" + str(try w.ui_snapshot.issue_count catch 0); }
    if badge == "watch dirty" { return "Dirty"; }
    return "Watch";
}

fn _watch_ui_issue_line(w) {
    if w == nil { return ""; }
    let snap = try w.ui_snapshot catch nil;
    if snap != nil {
        let issues = try snap.issues catch [];
        if issues != nil and len(issues) > 0 {
            let it = issues[0];
            return "ui issue: " + str(try it.severity catch "?")
                + " " + str(try it.target catch "?")
                + " - " + str(try it.message catch "?");
        }
    }
    let lines = try w.ui_lines catch [];
    let i = 0;
    while lines != nil and i < len(lines) {
        let line = str(lines[i]);
        if str_contains(line, "issue:") { return "ui " + line; }
        i = i + 1;
    }
    return "";
}

fn watcher_lines(w, limit) {
    if w == nil { return ["watch: off"]; }
    if limit == nil or limit < 1 { limit = 4; }
    let out = [watcher_summary(w)];
    let action = watcher_action(w);
    if len(out) < limit { array_push(out, "action: " + action.message); }
    if (try action.command catch "") == "ui_snapshot" and len(out) < limit {
        let ui_line = _watch_ui_issue_line(w);
        if ui_line != "" { array_push(out, ui_line); }
    }
    let events = try w.events catch [];
    let i = 0;
    while events != nil and i < len(events) and len(out) < limit {
        array_push(out, "- " + str(events[i]));
        i = i + 1;
    }
    return out;
}

fn _ide_visual_norm_style(style) {
    let s = str_lower(str_trim(str(try style catch "web")));
    if s == "web" or s == "smooth" or s == "crystal" or s == "contrast" or s == "pixel" { return s; }
    return "web";
}

fn _ide_visual_norm_theme(theme) {
    let t = str_lower(str_trim(str(try theme catch "dark")));
    if t == "light" { return "light"; }
    return "dark";
}

fn ide_visual_style_next(style) {
    let s = _ide_visual_norm_style(style);
    if s == "web" { return "smooth"; }
    if s == "smooth" { return "crystal"; }
    if s == "crystal" { return "contrast"; }
    if s == "contrast" { return "web"; }
    return "web";
}

fn ide_visual_tokens(style, theme) {
    let s = _ide_visual_norm_style(style);
    let t = _ide_visual_norm_theme(theme);
    let density = "balanced";
    let motion = "snappy";
    let chrome = "glass-rail";
    let radius = 8;
    let shadow = "soft";
    let focus = "active-glow";
    if s == "web" {
        density = "compact";
        motion = "instant";
        chrome = "web-studio";
        radius = 6;
        shadow = "hairline";
    }
    if s == "smooth" {
        density = "comfortable";
        motion = "soft";
        chrome = "frosted-studio";
        radius = 10;
        shadow = "layered";
    }
    if s == "crystal" {
        density = "compact-comfort";
        motion = "silky";
        chrome = "crystal-studio";
        radius = 12;
        shadow = "glow";
        focus = "crystal-focus";
    }
    if s == "contrast" {
        density = "clear";
        motion = "instant";
        chrome = "high-contrast-studio";
        radius = 5;
        shadow = "hard";
        focus = "thick-focus";
    }
    if s == "pixel" {
        density = "retro-precise";
        motion = "instant";
        chrome = "pixel-studio";
        radius = 2;
        shadow = "none";
        focus = "block-focus";
    }
    let accent = "electric-cyan";
    let secondary = "mint";
    let warning = "amber";
    if t == "light" {
        accent = "royal-blue";
        secondary = "teal";
        warning = "warm-amber";
    }
    return map{
        format: "pbide.visual.tokens.v1",
        style: s,
        theme: t,
        density: density,
        motion: motion,
        chrome: chrome,
        radius: radius,
        shadow: shadow,
        focus: focus,
        accent: accent,
        secondary: secondary,
        warning: warning,
        surface: "layered-panels",
        toolbar: "brand-rail-tabs-actions",
        editor: "quiet-current-line-gutter",
        panels: "carded-side-surfaces",
        sidepane: "stacked-section-cards",
        statusbar: "health-led-context-strip",
        modals: "centered-card-focus-ring",
        usability: "clean fast smooth simple readable futuristic"
    };
}

fn ide_visual_chrome(style, theme) {
    let v = ide_visual_tokens(style, theme);
    let section_gap = 6;
    let row_gap = 4;
    let density = str(try v.density catch "balanced");
    if density == "comfortable" { section_gap = 8; row_gap = 6; }
    if density == "compact" { section_gap = 4; row_gap = 3; }
    if density == "retro-precise" { section_gap = 2; row_gap = 2; }
    return map{
        format: "pbide.visual.chrome.v1",
        style: v.style,
        theme: v.theme,
        toolbar: v.toolbar,
        sidepane: v.sidepane,
        statusbar: v.statusbar,
        modals: v.modals,
        overdraw_policy: "opaque-replace-legacy",
        legacy_layer_visible: false,
        section_gap: section_gap,
        row_gap: row_gap,
        radius: v.radius,
        focus: v.focus,
        shadow: v.shadow
    };
}

fn ide_responsive_density(w, h, override_scale) {
    let ww = try parse_number(str(w)) catch 0;
    let hh = try parse_number(str(h)) catch 0;
    let ov = try parse_number(str(override_scale)) catch 0;
    if ww == nil { ww = 0; }
    if hh == nil { hh = 0; }
    if ov != nil and ov >= 1 {
        ov = num_floor(ov);
        if ov > 4 { ov = 4; }
        return map{ format: "pbide.responsive.density.v1", scale: ov, source: "manual", width: ww, height: hh, density: "manual", reason: "PBIDE density override" };
    }
    let scale = 1;
    let density = "compact";
    let reason = "1080p/1440p compact modern default";
    if hh >= 3000 {
        scale = 3;
        density = "large";
        reason = "very large display";
    } else if hh >= 1900 {
        scale = 2;
        density = "comfortable";
        reason = "4K-class display";
    } else if ww > 0 and ww < 1100 {
        scale = 1;
        density = "compact";
        reason = "small/narrow window";
    }
    return map{ format: "pbide.responsive.density.v1", scale: scale, source: "auto", width: ww, height: hh, density: density, reason: reason };
}

fn ide_viewport_layout(w, h, scale) {
    let ww = try parse_number(str(w)) catch 0;
    let hh = try parse_number(str(h)) catch 0;
    let sc = try parse_number(str(scale)) catch 1;
    if ww == nil { ww = 0; }
    if hh == nil { hh = 0; }
    if sc == nil or sc < 1 { sc = 1; }
    sc = num_floor(sc);
    let cls = "medium";
    let density = "compact";
    let toolbar = "full";
    let panel_tabs = "full";
    let side_chars = 30;
    let modal_chars = 82;
    let content_cols = 2;
    let gap = 4 * sc;
    if ww > 0 and ww < 1120 {
        cls = "small";
        density = "tight";
        toolbar = "compact";
        panel_tabs = "compact";
        side_chars = 22;
        modal_chars = 64;
        content_cols = 1;
    } else if ww >= 1700 {
        cls = "wide";
        density = "comfortable";
        side_chars = 34;
        modal_chars = 96;
        content_cols = 3;
    }
    if ww >= 2400 {
        cls = "huge";
        density = "large-canvas";
        side_chars = 38;
        modal_chars = 112;
        content_cols = 4;
    }
    if hh > 0 and hh < 760 {
        density = "tight";
        if side_chars > 26 { side_chars = 26; }
        if modal_chars > 72 { modal_chars = 72; }
    }
    return map{
        format: "pbide.viewport.layout.v1",
        width: ww,
        height: hh,
        scale: sc,
        class: cls,
        density: density,
        toolbar: toolbar,
        panel_tabs: panel_tabs,
        side_chars: side_chars,
        modal_chars: modal_chars,
        content_cols: content_cols,
        gap: gap,
        rounded: true,
        crystal_ready: true
    };
}

fn ide_panel_metrics(w, h, scale, char_w, char_h, pad, top, status_h, kind) {
    let ww = try parse_number(str(w)) catch 0;
    let hh = try parse_number(str(h)) catch 0;
    let sc = try parse_number(str(scale)) catch 1;
    let cw = try parse_number(str(char_w)) catch 8;
    let ch = try parse_number(str(char_h)) catch 16;
    let pp = try parse_number(str(pad)) catch 8;
    let tt = try parse_number(str(top)) catch 40;
    let ss = try parse_number(str(status_h)) catch 24;
    if ww == nil { ww = 0; }
    if hh == nil { hh = 0; }
    if sc == nil or sc < 1 { sc = 1; }
    if cw == nil or cw < 1 { cw = 8; }
    if ch == nil or ch < 1 { ch = 16; }
    if pp == nil or pp < 1 { pp = 8; }
    if tt == nil or tt < 0 { tt = 40; }
    if ss == nil or ss < 1 { ss = 24; }
    sc = num_floor(sc);
    let kk = str(kind);
    let vp = ide_viewport_layout(ww, hh, sc);
    let header_h = ch + 3 * pp;
    let search_y = tt + ch + 4 * pp;
    let search_h = ch + pp;
    let body_top = search_y + ch + 2 * pp;
    let row_h = ch;
    let hint_mode = "full";
    if (try vp.class catch "medium") == "small" { hint_mode = "compact"; }
    if kk == "files" {
        body_top = search_y + ch * 3 + 3 * pp;
    }
    if kk == "manage" {
        row_h = ch * 2;
    }
    let detail_h = 0;
    let detail_y = hh - ss;
    if kk == "problems" {
        detail_h = ch * 4 + pp;
        detail_y = hh - ss - detail_h;
    }
    let rows_area = hh - body_top - ss - pp;
    if kk == "problems" {
        rows_area = detail_y - (body_top + ch + pp) - pp;
    }
    let rows = num_floor(rows_area / row_h);
    if rows < 1 { rows = 1; }
    let max_chars = num_floor((ww - 2 * pp) / cw);
    if max_chars < 8 { max_chars = 8; }
    return map{
        format: "pbide.panel.metrics.v1",
        kind: kk,
        viewport_class: try vp.class catch "medium",
        density: try vp.density catch "compact",
        hint_mode: hint_mode,
        header_h: header_h,
        search_y: search_y,
        search_h: search_h,
        body_top: body_top,
        row_h: row_h,
        rows: rows,
        footer_y: hh - ss,
        footer_h: ss,
        detail_y: detail_y,
        detail_h: detail_h,
        max_chars: max_chars,
        content_w: ww - 2 * pp,
        gap: try vp.gap catch 4 * sc
    };
}

fn ide_visual_summary(style, theme) {
    let v = ide_visual_tokens(style, theme);
    return "pbIDE visual " + v.style + "/" + v.theme
        + ": " + v.chrome
        + ", density " + v.density
        + ", motion " + v.motion
        + ", focus " + v.focus
        + ", " + v.usability;
}

// PBIDE consumes the same bounded backend contract as CLI tools and products.
// Native targets are build-only here; reference previews use eval_bounded.
fn ide_execution_targets() { return _execution_pipeline().targets(); }
fn ide_execution_plan(os, version, arch, options = nil) {
    return _execution_pipeline().plan_platform(os, version, arch, options);
}
fn ide_execution_preview(ir, target = "eval", options = nil) {
    return _execution_pipeline().build_ir(ir, target, options);
}
fn ide_source_preview(source, options = nil) {
    return _execution_pipeline().run_source(source, options);
}
fn ide_source_build(source, target = "interpreter", options = nil) {
    return _execution_pipeline().build_source(source, target, options);
}
fn ide_execution_safety(options = nil) {
    let lim = _execution_pipeline().limits(options);
    return map{
        format: "pbide.execution.safety.v1", limits: lim,
        native_execution: "disabled-by-default",
        syscalls: if lim.allow_syscalls { "explicitly-enabled" } else { "deny-by-default" },
        boundary: "PBIDE controls source, IR, artifact, evaluator, stack, and locals budgets; OS/kernel/driver/firmware/DMA isolation is external"
    };
}

