// stdlib/ide_features.sapp — web-IDE-style editor features as pure, testable functions
// (no display): a symbol OUTLINE, FIND-ALL, FIND & REPLACE, and a STATUS-BAR string.
// pbide.sapp (and any editor) wires these into its UI; the logic is unit-tested headlessly.

fn _ident(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        let c = strcharcodeat(ch, 0);
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 {
            out = out + ch;
        } else { return out; }
        i = i + 1;
    }
    return out;
}

// outline(code) -> [{ kind, name, line }] for top-level fn / let / const / export.
fn outline(code) {
    let out = [];
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let t = str_trim(lines[i]);
        let ln = i + 1;
        if str_starts_with(t, "fn ") {
            array_push(out, map{ kind: "fn", name: _ident(str_slice(t, 3, len(t))), line: ln });
        } else if str_starts_with(t, "let ") {
            array_push(out, map{ kind: "let", name: _ident(str_slice(t, 4, len(t))), line: ln });
        } else if str_starts_with(t, "const ") {
            array_push(out, map{ kind: "const", name: _ident(str_slice(t, 6, len(t))), line: ln });
        } else if str_starts_with(t, "export ") {
            array_push(out, map{ kind: "export", name: str_trim(str_slice(t, 7, len(t))), line: ln });
        }
        i = i + 1;
    }
    return out;
}

// find_all(code, query) -> [{ line, col }] (1-based) of every (case-sensitive) match.
fn find_all(code, query) {
    let out = [];
    if query == nil or query == "" { return out; }
    let lines = str_split(code, "\n");
    let i = 0;
    while i < len(lines) {
        let rem = lines[i];
        let base = 0;
        let guard = 0;
        while guard < 100000 {
            let idx = str_index_of(rem, query);
            if idx < 0 { break; }
            array_push(out, map{ line: i + 1, col: base + idx + 1 });
            let step = idx + len(query);
            base = base + step;
            rem = str_slice(rem, step, len(rem));
            guard = guard + 1;
        }
        i = i + 1;
    }
    return out;
}

// replace_all(code, find, repl) -> { code, count } (count = matches replaced).
fn replace_all(code, find, repl) {
    if find == nil or find == "" { return map{ code: code, count: 0 }; }
    let count = len(find_all(code, find));
    return map{ code: str_replace_all(code, find, repl), count: count };
}

// status_text(info) -> a VSCode-style status-bar string.
fn status_text(info) {
    let path = str(try info.path catch "untitled");
    let modified = try info.modified catch false;
    let m = "";
    if modified { m = " *"; }
    let ln = str(try info.line catch 1);
    let col = str(try info.col catch 1);
    let lines = str(try info.lines catch 0);
    let lang = str(try info.lang catch "pblang");
    return path + m + "  |  Ln " + ln + ", Col " + col + "  |  " + lines + " lines  |  " + lang;
}

export outline, find_all, replace_all, status_text;
