// stdlib/polyglot_web.sapp — HTML/CSS/JS bundling helpers
//
// HTML and CSS aren't "executed" by an interpreter the way python or rust are
// — they're rendered by a browser. So the polyglot bridge for the web stack
// is a *bundling* helper: take HTML / CSS / JS strings, write them to a
// single self-contained .html file, and (optionally) point a browser at it.
//
// JS is also independently runnable via `polyglot.exec("js", code)` (node)
// or `polyglot.exec("deno", code)` (deno).
//
// Usage:
//   let pw = import("stdlib:polyglot_web.sapp");
//   let path = pw.bundle("<h1>Hello</h1>", "h1 { color: blue; }", "alert(1)");
//   pw.open_in_browser(path);
//
// All file writes go through the standard sandbox (`allow_fs`).

import "stdlib:polyglot.sapp";

// Inline `css` into a <style> tag and `js` into a <script> tag, wrapping the
// `body_html` in a minimal HTML5 skeleton. Returns the full HTML document.
fn bundle_html(body_html, css, js) {
    let css_block = "";
    if css != nil and css != "" {
        css_block = "<style>\n" + css + "\n</style>\n";
    }
    let js_block = "";
    if js != nil and js != "" {
        js_block = "<script>\n" + js + "\n</script>\n";
    }
    let html = "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>pblang polyglot page</title>\n" + css_block + "</head><body>\n" + body_html + "\n" + js_block + "</body></html>\n";
    return html;
}

// Bundle and write to a temp file. Returns the file path.
fn bundle(body_html, css, js) {
    let html = bundle_html(body_html, css, js);
    let nonce = str(random_float());
    let path = "/tmp/pblang_web_" + nonce + ".html";
    fs_write(path, html);
    return path;
}

// Bundle and write to a specific file. Returns the path.
fn bundle_to(body_html, css, js, path) {
    let html = bundle_html(body_html, css, js);
    fs_write(path, html);
    return path;
}

// Best-effort: ask the OS to open `path` in the default browser. Returns
// `true` on apparent success, `false` if no opener was available.
// Tries (in order): xdg-open (Linux), open (macOS), start (Windows via cmd).
fn open_in_browser(path) {
    let plat = platform();
    let cmd = "xdg-open";
    if plat == "macos" { cmd = "open"; }
    if plat == "windows" { cmd = "start"; }
    let r = try proc_spawn_wait(cmd, [path]) catch nil;
    if r == nil {
        return false;
    }
    return r.exit_code == 0;
}

// Execute a JS snippet via node (interpreted) — convenience wrapper.
fn js(code) {
    return polyglot.exec("js", code);
}

// Execute a JS snippet via deno when present, falling back to node.
fn deno_or_node(code) {
    let info = polyglot.detect();
    if info != nil and info != map{} {
        let deno_info = try info.deno catch nil;
        if deno_info != nil and deno_info.available {
            return polyglot.exec("deno", code);
        }
    }
    return polyglot.exec("js", code);
}

// Convenience: bundle HTML/CSS/JS and write to a path returned to the
// caller, then call `open_in_browser` only if `auto_open` is truthy.
fn render(body_html, css, js, auto_open) {
    let path = bundle(body_html, css, js);
    if auto_open {
        open_in_browser(path);
    }
    return path;
}

export bundle_html;
export bundle;
export bundle_to;
export open_in_browser;
export js;
export deno_or_node;
export render;
