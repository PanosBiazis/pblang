// Secure HTML/CSS/JS bundling and bounded local launch helpers.

let PROCESS = import("stdlib:process.sapp");
let SECURE_FILE = import("stdlib:secure_file.sapp");

let MAX_FRAGMENT_BYTES = 8388608;
let MAX_BUNDLE_BYTES = 16777216;
let MAX_PATH_BYTES = 4096;

fn _text(value, label) {
    if value == nil { return ""; }
    if type(value) != "string" or len(str_to_bytes(value)) > MAX_FRAGMENT_BYTES
       or str_contains(value, strfromcharcode(0)) {
        throw "polyglot_web: invalid " + label;
    }
    return value;
}

fn _base_environment() {
    return map{ PATH: "/usr/bin:/bin", HOME: "/nonexistent", LANG: "C", LC_ALL: "C" };
}

fn _copy_environment(target, name, maximum) {
    let value = try env_get(name) catch nil;
    if type(value) == "string" and len(str_to_bytes(value)) <= maximum
       and not str_contains(value, strfromcharcode(0)) {
        target[name] = value;
    }
}

fn _desktop_environment() {
    let environment = _base_environment();
    _copy_environment(environment, "DISPLAY", 256);
    _copy_environment(environment, "WAYLAND_DISPLAY", 256);
    _copy_environment(environment, "XDG_RUNTIME_DIR", MAX_PATH_BYTES);
    _copy_environment(environment, "DBUS_SESSION_BUS_ADDRESS", 4096);
    _copy_environment(environment, "XAUTHORITY", MAX_PATH_BYTES);
    let home = try env_get("HOME") catch nil;
    if type(home) == "string" and str_starts_with(home, "/")
       and len(str_to_bytes(home)) <= MAX_PATH_BYTES
       and not str_contains(home, strfromcharcode(0)) { environment.HOME = home; }
    return environment;
}

fn _escape_html(value) {
    let escaped = str_replace_all(_text(value, "untrusted text"), "&", "&amp;");
    escaped = str_replace_all(escaped, "<", "&lt;");
    escaped = str_replace_all(escaped, ">", "&gt;");
    escaped = str_replace_all(escaped, "\"", "&quot;");
    return str_replace_all(escaped, "'", "&#39;");
}

// Trusted executable fragments only. Use bundle_text_html for untrusted text.
fn bundle_html(body_html, css, js) {
    body_html = _text(body_html, "HTML body");
    css = _text(css, "CSS");
    js = _text(js, "JavaScript");
    let css_block = "";
    if css != "" { css_block = "<style>\n" + css + "\n</style>\n"; }
    let js_block = "";
    if js != "" { js_block = "<script>\n" + js + "\n</script>\n"; }
    let csp = "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
        + "img-src data: blob:; media-src data: blob:; font-src data:; "
        + "connect-src 'none'; frame-src 'none'; object-src 'none'; worker-src 'none'; "
        + "base-uri 'none'; form-action 'none'";
    let html = "<!doctype html>\n<html lang=\"en\"><head>\n"
        + "<meta charset=\"utf-8\">\n"
        + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"
        + "<meta name=\"referrer\" content=\"no-referrer\">\n"
        + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + csp + "\">\n"
        + "<title>PBLang page</title>\n" + css_block
        + "</head><body>\n" + body_html + "\n" + js_block + "</body></html>\n";
    if len(str_to_bytes(html)) > MAX_BUNDLE_BYTES { throw "polyglot_web: bundle exceeds byte limit"; }
    return html;
}

fn bundle_text_html(text) {
    let body = "<main><pre>" + _escape_html(text) + "</pre></main>";
    let csp = "default-src 'none'; script-src 'none'; style-src 'none'; "
        + "img-src 'none'; media-src 'none'; connect-src 'none'; frame-src 'none'; "
        + "object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'";
    let html = "<!doctype html>\n<html lang=\"en\"><head>\n"
        + "<meta charset=\"utf-8\">\n"
        + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"
        + "<meta name=\"referrer\" content=\"no-referrer\">\n"
        + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + csp + "\">\n"
        + "<title>PBLang text</title></head><body>\n" + body + "\n</body></html>\n";
    if len(str_to_bytes(html)) > MAX_BUNDLE_BYTES {
        throw "polyglot_web: escaped text bundle exceeds byte limit";
    }
    return html;
}

fn bundle(body_html, css, js) {
    let html = bundle_html(body_html, css, js);
    let attempt = 0;
    let last_error = "secure publication rejected";
    while attempt < 8 {
        let token = str_slice(sha256(base64_encode_bytes(random_bytes(32)) + str(now_ms())), 0, 32);
        let path = "/tmp/pblang-web-" + token + ".html";
        let published = SECURE_FILE.write_text_new_exclusive(path, html, false, false);
        if published.ok { return path; }
        if try published.cleanup_uncertain catch false {
            throw "polyglot_web: exclusive temporary bundle cleanup unconfirmed; publication may remain";
        }
        last_error = try published.error catch "secure publication rejected";
        attempt = attempt + 1;
    }
    throw "polyglot_web: exclusive temporary bundle publication failed: " + last_error;
}

fn bundle_to(body_html, css, js, path) {
    if type(path) != "string" or path == "" or len(str_to_bytes(path)) > MAX_PATH_BYTES
       or str_contains(path, strfromcharcode(0)) { throw "polyglot_web: invalid output path"; }
    if not SECURE_FILE.write_text_atomic(path, bundle_html(body_html, css, js), true, false).ok {
        throw "polyglot_web: secure bundle publication failed";
    }
    return path;
}

fn browser_plan(path) {
    if platform() != "linux" or type(path) != "string" or path == ""
       or len(str_to_bytes(path)) > MAX_PATH_BYTES or not str_ends_with(str_lower(path), ".html")
       or str_contains(path, strfromcharcode(0)) {
        return map{ ok: false, launcher_bounded: false, browser_bounded: false,
            identity_bound: false, raw_fallback: false,
            error: "local HTML launcher is unavailable" };
    }
    if not SECURE_FILE.read_text_prefix(path, 1, false).ok {
        return map{ ok: false, launcher_bounded: false, browser_bounded: false,
            identity_bound: false, raw_fallback: false,
            error: "local HTML file cannot be opened safely" };
    }
    return map{ ok: true, candidates: ["/usr/bin/xdg-open", "/bin/xdg-open"],
        args: [path], launcher_bounded: true, browser_bounded: false,
        identity_bound: false, same_uid_path_trusted: true,
        raw_fallback: false, shell_used: false };
}

fn open_in_browser_status(path) {
    let plan = browser_plan(path);
    if not plan.ok {
        return map{ ok: false, launch_requested: false, launcher_ok: false,
            browser_bounded: false, identity_bound: false, error: plan.error };
    }
    let result = PROCESS.run_fixed_bounded(plan.candidates, plan.args, map{
        timeout_secs: 10, startup_timeout_ms: 3000, max_output_bytes: 65536,
        max_file_bytes: 1048576, max_memory_bytes: 536870912,
        environment: _desktop_environment(), inherit_environment: false
    });
    let launcher_ok = (try result.command_ok catch false) and (try result.bounded catch false);
    return map{ ok: launcher_ok, launch_requested: true, launcher_ok: launcher_ok,
        launcher_bounded: try result.bounded catch false, browser_bounded: false,
        identity_bound: false, same_uid_path_trusted: true,
        error: if launcher_ok { "" } else { "local browser launcher failed" } };
}

fn open_in_browser(path) { return open_in_browser_status(path).launcher_ok; }

fn _run_js(candidates, args, code) {
    code = _text(code, "JavaScript");
    let result = PROCESS.run_fixed_bounded(candidates, args, map{
        timeout_secs: 15, startup_timeout_ms: 3000, max_output_bytes: 1048576,
        max_file_bytes: 8388608, max_memory_bytes: 536870912,
        stdin_bytes: str_to_bytes(code), environment: _base_environment(),
        inherit_environment: false
    });
    return map{ ok: try result.command_ok catch false,
        stdout: try result.stdout catch "", stderr: try result.stderr catch "",
        exit_code: try result.exit_code catch -1, bounded: try result.bounded catch false,
        executed: try result.completed catch false,
        execution_admitted: try result.bounded catch false,
        process_status: try result.process_status catch PROCESS.bounded_status(),
        error: try result.error catch (try result.stderr catch "bounded JavaScript execution failed"),
        timed_out: try result.timed_out catch false,
        output_truncated: try result.output_truncated catch false,
        shell_used: false, raw_fallback: false, sandboxed: false,
        trusted_source_required: true };
}

fn js(code) { return _run_js(["/usr/bin/node", "/bin/node"], ["-"], code); }

fn deno_or_node(code) {
    if fs_exists("/usr/bin/deno") or fs_exists("/bin/deno") {
        return _run_js(["/usr/bin/deno", "/bin/deno"],
            ["run", "--no-prompt", "--cached-only", "-"], code);
    }
    return js(code);
}

fn render_status(body_html, css, js_code, auto_open) {
    let path = bundle(body_html, css, js_code);
    if auto_open {
        if not open_in_browser(path) {
            return map{ ok: false, path: path, launch_requested: true,
                launcher_ok: false, browser_bounded: false, identity_bound: false,
                error: "bundle created but local browser launcher failed" };
        }
        return map{ ok: true, path: path, launch_requested: true,
            launcher_ok: true, browser_bounded: false, identity_bound: false };
    }
    return map{ ok: true, path: path, launch_requested: false,
        launcher_ok: false, browser_bounded: false, identity_bound: false };
}

fn render(body_html, css, js_code, auto_open) {
    return render_status(body_html, css, js_code, auto_open).path;
}

fn remove_bundle(path) {
    if type(path) != "string" or not str_starts_with(path, "/tmp/pblang-web-")
       or not str_ends_with(path, ".html") or str_contains(path, "/../") {
        return map{ ok: false, error: "path is not a polyglot_web temporary bundle" };
    }
    return SECURE_FILE.remove_file(path, false);
}

export bundle_html, bundle_text_html, bundle, bundle_to, remove_bundle;
export browser_plan, open_in_browser, open_in_browser_status;
export js, deno_or_node, render, render_status;
