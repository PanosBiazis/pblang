// stdlib/layout.sapp — a pure pblang-native flow-layout engine for the browser engine.
//
// browser.sapp turns a page into semantic blocks (page_blocks -> [{kind, text, src?}]);
// this module turns those blocks into POSITIONED boxes ({x, y, w, h, kind, lines, ...})
// via top-to-bottom block flow with word wrapping. It is the layer between parse and
// render: pure, deterministic, font-metric-parameterized, so any renderer (the IDE's
// bitmap font, an SVG/PDF exporter, a headless snapshot) can draw the same box list.
//
//   let lay = import("stdlib:layout.sapp");
//   let page = browser.fetch_page(url);
//   let doc  = lay.flow(browser.page_blocks(page), map{ width: 640 });
//   for b in doc.boxes { /* draw b.lines at (b.x, b.y) with b.char_w/b.line_h */ }

// _opt(opts, key, default) — read an option with a fallback (map-missing-key throws).
fn _opt(opts, key, default) {
    if opts == nil { return default; }
    if not map_has(opts, key) { return default; }
    return opts[key];
}

// _metrics(kind) — per-kind font metrics { char_w, line_h }. Headings render larger.
fn _metrics(kind) {
    if kind == "title" { return map{ char_w: 12, line_h: 20 }; }
    if kind == "h1"    { return map{ char_w: 10, line_h: 18 }; }
    if kind == "h2"    { return map{ char_w: 8,  line_h: 15 }; }
    return map{ char_w: 6, line_h: 12 };   // p / link / li / default body text
}

// wrap_text(text, max_chars) — greedy word wrap to a character budget. An oversized
// single word keeps its own line rather than being split or dropped.
fn wrap_text(text, max_chars) {
    if text == "" { return []; }
    if max_chars < 1 { max_chars = 1; }
    let words = str_split(text, " ");
    let lines = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = words[i];
        let cand = if cur == "" { w } else { cur + " " + w };
        if cur == "" or len(cand) <= max_chars {
            cur = cand;
        } else {
            array_push(lines, cur);
            cur = w;
        }
        i = i + 1;
    }
    if cur != "" { array_push(lines, cur); }
    return lines;
}

// flow(blocks, opts) — lay blocks out top-to-bottom into positioned boxes.
// opts: { width=640, pad=8, gap=6, img_h=80 }. Returns { boxes, width, height }.
fn flow(blocks, opts) {
    let width = _opt(opts, "width", 640);
    let pad = _opt(opts, "pad", 8);
    let gap = _opt(opts, "gap", 6);
    let img_h = _opt(opts, "img_h", 80);
    let content_w = width - 2 * pad;
    if content_w < 1 { content_w = 1; }

    let boxes = [];
    let y = pad;
    let i = 0;
    while i < len(blocks) {
        let b = blocks[i];
        let kind = try b.kind catch "p";
        if kind == "img" {
            array_push(boxes, map{
                x: pad, y: y, w: content_w, h: img_h, kind: "img",
                text: try b.text catch "", src: try b.src catch "",
            });
            y = y + img_h + gap;
        } else if kind == "hr" {
            array_push(boxes, map{ x: pad, y: y, w: content_w, h: 2, kind: "hr", text: "", lines: [] });
            y = y + 2 + gap;
        } else {
            let m = _metrics(kind);
            let max_chars = num_floor(content_w / m.char_w);
            let lines = wrap_text(try b.text catch "", max_chars);
            if len(lines) == 0 { array_push(lines, ""); }
            let h = len(lines) * m.line_h;
            array_push(boxes, map{
                x: pad, y: y, w: content_w, h: h, kind: kind,
                text: try b.text catch "", lines: lines,
                char_w: m.char_w, line_h: m.line_h,
            });
            y = y + h + gap;
        }
        i = i + 1;
    }

    let height = pad * 2;
    if len(boxes) > 0 {
        let last = boxes[len(boxes) - 1];
        height = last.y + last.h + pad;
    }
    return map{ boxes: boxes, width: width, height: height };
}

// hit_test(boxes, px, py) — the first box containing the point (e.g. for click→link),
// or nil. Half-open on the right/bottom edges.
fn hit_test(boxes, px, py) {
    let i = 0;
    while i < len(boxes) {
        let b = boxes[i];
        if px >= b.x and px < b.x + b.w and py >= b.y and py < b.y + b.h { return b; }
        i = i + 1;
    }
    return nil;
}

// content_height(blocks, opts) — total laid-out height without keeping the boxes.
fn content_height(blocks, opts) { return flow(blocks, opts).height; }

export wrap_text, flow, hit_test, content_height;
