let Timeline=import("stdlib:timeline_document.sapp"); let UI=import("stdlib:modern_ui.sapp"); let Pages=import("stdlib:text_pages.sapp");
let PAGE_SIZE=8;
fn summary(report) { return "Overlap pairs: "+str(report.overlap_pairs)+" | Peak: "+str(report.peak_concurrency)+" | Gaps: "+str(report.gap_ms)+" ms"; }
fn _details(doc,report,index) {
    let item=doc.entries[index]; let label=Pages.wrap(item.label,40);
    let lines=["Activity "+str(index+1)+" / "+str(len(doc.entries))];
    if len(label)>4 { throw "timeline view: label display limit"; }
    for i in range(0,4) {array_push(lines,if i<len(label) {label[i]} else {""});}
    array_push(lines,"Start: "+str(item.start_ms)+" ms | End: "+str(item.end_ms)+" ms");
    array_push(lines,"Duration: "+str(item.end_ms-item.start_ms)+" ms | Overlaps: "+str(report.overlaps_by_index[index]));
    return lines;
}
fn create(doc,page=0) {
    Timeline.validate(doc); let count=num_ceil(len(doc.entries)/PAGE_SIZE);
    if type(page)!="number" or not (page>=0 and page<count) or page!=num_floor(page) { throw "timeline view: invalid page"; }
    let report=Timeline.analyze(doc); let start=page*PAGE_SIZE; let first=_details(doc,report,start);
    let children=[UI.heading("PBTimeline")];
    for line in Pages.wrap(doc.title,40) {array_push(children,UI.text(line));}
    array_push(children,UI.text(summary(report)));array_push(children,UI.text("Saved snapshot - page "+str(page+1)+" / "+str(count)));
    for i in range(0,len(first)) { array_push(children,UI.text(first[i],map{name:"detail_"+str(i)})); }
    let buttons=[];
    for index in range(start,num_min(start+PAGE_SIZE,len(doc.entries))) {
        let lines=_details(doc,report,index); let actions=[];
        for i in range(0,len(lines)) { array_push(actions,UI.action_set_text("detail_"+str(i),lines[i])); }
        array_push(buttons,UI.button("Activity "+str(index+1),UI.action_sequence(actions),map{name:"select_"+str(index)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4}));
    array_push(children,UI.text("Select an activity on this page. Editing and saving use the native application. Export another page to browse more activities."));
    return UI.screen(children);
}
export PAGE_SIZE,summary,create;
