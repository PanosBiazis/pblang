// stdlib/testing.sapp — Full-featured test framework for pblang.
//
// Inspired by Jest, Go testing, and Rust's #[test].
//
// Usage:
//   let t = import("stdlib:testing.sapp");
//   t.describe("my suite", fn() {
//       t.it("adds numbers", fn() { t.expect(1 + 1).to_equal(2); });
//       t.it("throws on bad input", fn() { t.expect_throws(fn() { error("boom"); }); });
//   });
//   t.run_all();

let TIME = import("stdlib:time.sapp");

let _suites = [];
let _current_suite = nil;
let _pass_count = 0;
let _fail_count = 0;
let _skip_count = 0;
let _has_focus = false;

// reset() — clear all registered suites and counters so independent runs
// don't accumulate (run_all() alone only resets the counters).
fn reset() {
    _suites = [];
    _current_suite = nil;
    _pass_count = 0;
    _fail_count = 0;
    _skip_count = 0;
    _has_focus = false;
}

// stats() — counts from the most recent run_all(), readable even when
// run_all() raised because of failures.
fn stats() {
    return map{ passed: _pass_count, failed: _fail_count, skipped: _skip_count };
}

// describe(name, fn) — define a test suite
fn describe(name, suite_fn) {
    let suite = map{ name: name, tests: [], before_each: nil, after_each: nil, before_all: nil, after_all: nil };
    _suites[len(_suites)] = suite;
    let prev = _current_suite;
    _current_suite = suite;
    suite_fn();
    _current_suite = prev;
}

// it(name, fn) — define a test case (inside describe)
fn it(name, test_fn) {
    if _current_suite == nil { return error("testing.it() must be called inside describe()"); }
    _current_suite.tests[len(_current_suite.tests)] = map{ name: name, fn: test_fn, skip: false, focus: false };
}

// xit(name, fn) — skip a test (pending)
fn xit(name, test_fn) {
    if _current_suite == nil { return error("testing.xit() must be called inside describe()"); }
    _current_suite.tests[len(_current_suite.tests)] = map{ name: name, fn: test_fn, skip: true, focus: false };
}

// fit(name, fn) — focused test: when any fit() exists, run_all() runs ONLY
// focused tests and counts the rest as skipped (like Jest's it.only).
fn fit(name, test_fn) {
    if _current_suite == nil { return error("testing.fit() must be called inside describe()"); }
    _current_suite.tests[len(_current_suite.tests)] = map{ name: name, fn: test_fn, skip: false, focus: true };
    _has_focus = true;
}

// test(name, fn) — alias for it() for use outside describe()
fn test(name, test_fn) {
    let suite = map{ name: "(top level)", tests: [], before_each: nil, after_each: nil, before_all: nil, after_all: nil };
    suite.tests[0] = map{ name: name, fn: test_fn, skip: false, focus: false };
    _suites[len(_suites)] = suite;
}

// before_each(fn) — run fn before each test in the current suite
fn before_each(fn_) {
    if _current_suite == nil { return; }
    _current_suite.before_each = fn_;
}

// after_each(fn) — run fn after each test in the current suite
fn after_each(fn_) {
    if _current_suite == nil { return; }
    _current_suite.after_each = fn_;
}

// before_all(fn) — run fn once before all tests in the current suite
fn before_all(fn_) {
    if _current_suite == nil { return; }
    _current_suite.before_all = fn_;
}

// after_all(fn) — run fn once after all tests in the current suite
fn after_all(fn_) {
    if _current_suite == nil { return; }
    _current_suite.after_all = fn_;
}

// --- Expectation builder ---
// expect(val) → returns an expectation object with assertion methods

fn expect(val) {
    return map{
        _val: val,
        to_equal: fn(expected) {
            if val != expected {
                return error("expect: " + str(val) + " to equal " + str(expected));
            }
            return true;
        },
        not_to_equal: fn(expected) {
            if val == expected {
                return error("expect: " + str(val) + " NOT to equal " + str(expected));
            }
            return true;
        },
        to_be_nil: fn() {
            if val != nil {
                return error("expect: " + str(val) + " to be nil");
            }
            return true;
        },
        not_to_be_nil: fn() {
            if val == nil {
                return error("expect: value to not be nil, but got nil");
            }
            return true;
        },
        to_be_true: fn() {
            if val != true {
                return error("expect: " + str(val) + " to be true");
            }
            return true;
        },
        to_be_false: fn() {
            if val != false {
                return error("expect: " + str(val) + " to be false");
            }
            return true;
        },
        to_be_type: fn(t) {
            if type(val) != t {
                return error("expect: type(" + str(val) + ") to be '" + t + "', got '" + type(val) + "'");
            }
            return true;
        },
        to_contain: fn(item) {
            if type(val) == "array" {
                for i len(val) { if val[i] == item { return true; } }
                return error("expect: array does not contain " + str(item));
            }
            if type(val) == "string" {
                if str_contains(val, str(item)) { return true; }
                return error("expect: string '" + val + "' does not contain '" + str(item) + "'");
            }
            return error("expect.to_contain: value is not array or string");
        },
        to_have_length: fn(n) {
            if len(val) != n {
                return error("expect: len(" + str(val) + ") = " + str(len(val)) + ", expected " + str(n));
            }
            return true;
        },
        to_be_greater_than: fn(n) {
            if val <= n {
                return error("expect: " + str(val) + " to be > " + str(n));
            }
            return true;
        },
        to_be_less_than: fn(n) {
            if val >= n {
                return error("expect: " + str(val) + " to be < " + str(n));
            }
            return true;
        },
        to_be_between: fn(lo, hi) {
            if val < lo or val > hi {
                return error("expect: " + str(val) + " to be between " + str(lo) + " and " + str(hi));
            }
            return true;
        },
        to_be_close_to: fn(expected, tol) {
            let d = val - expected;
            if d < 0 { d = 0 - d; }
            if d > tol {
                return error("expect: " + str(val) + " to be within " + str(tol) + " of " + str(expected));
            }
            return true;
        },
        to_start_with: fn(prefix) {
            if type(val) != "string" {
                return error("expect.to_start_with: value is not a string");
            }
            if str_starts_with(val, prefix) == false {
                return error("expect: '" + val + "' to start with '" + prefix + "'");
            }
            return true;
        },
        to_end_with: fn(suffix) {
            if type(val) != "string" {
                return error("expect.to_end_with: value is not a string");
            }
            if str_ends_with(val, suffix) == false {
                return error("expect: '" + val + "' to end with '" + suffix + "'");
            }
            return true;
        },
        to_match_map: fn(expected_map) {
            if type(val) != "map" {
                return error("expect.to_match_map: value is not a map");
            }
            let keys = map_keys(expected_map);
            for i len(keys) {
                let k = keys[i];
                if map_has(val, k) == false {
                    return error("expect.to_match_map: missing key '" + k + "'");
                }
                if val[k] != expected_map[k] {
                    return error("expect.to_match_map: key '" + k + "': got " + str(val[k]) + ", expected " + str(expected_map[k]));
                }
            }
            return true;
        }
    };
}

// expect_throws(fn) — assert that fn() throws. Uses the out-of-band map
// sentinel: the old string sentinel had a false positive when fn()
// legitimately returned "caught".
fn expect_throws(fn_) {
    let outcome = try map{ ok: true, value: fn_() } catch map{ ok: false, value: nil };
    if outcome.ok {
        return error("expect_throws: function did not throw");
    }
    return true;
}

// expect_no_throw(fn) — assert that fn() does NOT throw.
// catch binds no name in pblang, so success rides an out-of-band map (the
// old `err` check was never assigned and let throwing fns PASS).
fn expect_no_throw(fn_) {
    let outcome = try map{ ok: true, value: fn_() }
                  catch map{ ok: false, value: nil };
    if not outcome.ok {
        return error("expect_no_throw: function threw");
    }
    return true;
}

// --- Runner ---

fn _run_test(suite_name, test_def, before_fn, after_fn) {
    if test_def.skip == true {
        print "  ⏭  SKIP: " + test_def.name;
        _skip_count = _skip_count + 1;
        return;
    }
    if _has_focus and test_def.focus != true {
        print "  ⏭  SKIP (unfocused): " + test_def.name;
        _skip_count = _skip_count + 1;
        return;
    }

    // A throwing before_each means the test would run against broken state —
    // that is a FAILURE, not something to swallow.
    if before_fn != nil {
        let bh = try map{ ok: true, value: before_fn() } catch map{ ok: false, value: nil };
        if bh.ok == false {
            print "  ✗  FAIL: " + test_def.name;
            print "       (before_each threw)";
            _fail_count = _fail_count + 1;
            return;
        }
    }

    // catch binds no name in pblang, so pass/throw rides an out-of-band map.
    // A test fn that returns nil (any statement-bodied fn) is a PASS; only a
    // throw or an explicit `return false` fails.
    let outcome = try map{ ok: true, value: test_def.fn() } catch map{ ok: false, value: nil };
    let passed = outcome.ok;
    let why = "";
    if outcome.ok == false { why = "(test threw)"; }
    if passed and outcome.value == false {
        passed = false;
        why = "(test returned false)";
    }

    // A throwing after_each fails an otherwise-passing test (leaked state).
    if after_fn != nil {
        let ah = try map{ ok: true, value: after_fn() } catch map{ ok: false, value: nil };
        if ah.ok == false and passed {
            passed = false;
            why = "(after_each threw)";
        }
    }

    if passed {
        print "  ✓  " + test_def.name;
        _pass_count = _pass_count + 1;
    } else {
        print "  ✗  FAIL: " + test_def.name;
        if why != "" { print "       " + why; }
        _fail_count = _fail_count + 1;
    }
}

fn run_all() {
    _pass_count = 0;
    _fail_count = 0;
    _skip_count = 0;
    let t0 = TIME.now_ms();

    for s len(_suites) {
        let suite = _suites[s];
        print "\n▶ " + suite.name;
        if suite.before_all != nil { try suite.before_all() catch nil; }
        for i len(suite.tests) {
            _run_test(suite.name, suite.tests[i], suite.before_each, suite.after_each);
        }
        if suite.after_all != nil { try suite.after_all() catch nil; }
    }

    let elapsed = num_floor((TIME.now_ms() - t0) * 10 + 0.5) / 10;
    print "\n─────────────────────────────";
    print "Results: " + str(_pass_count) + " passed  " + str(_fail_count) + " failed  " + str(_skip_count) + " skipped  (" + str(elapsed) + " ms)";
    if _fail_count > 0 {
        return error("Test suite failed: " + str(_fail_count) + " test(s) failed");
    }
    return map{ passed: _pass_count, failed: _fail_count, skipped: _skip_count };
}

// fail(msg) — unconditionally fail the current test with a message
fn fail(msg) {
    return error("fail: " + str(msg));
}

// assert_equal(a, b) — quick assertion without builder pattern
fn assert_equal(a, b) {
    if a != b {
        return error("assert_equal: " + str(a) + " != " + str(b));
    }
    return true;
}

// assert_true(v) — assert value is truthy
fn assert_true(v) {
    if v != true and v != 1 {
        return error("assert_true: got " + str(v));
    }
    return true;
}

// assert_false(v) — assert value is falsy
fn assert_false(v) {
    if v != false and v != 0 {
        return error("assert_false: got " + str(v));
    }
    return true;
}

// assert_nil(v) — assert value is nil
fn assert_nil(v) {
    if v != nil {
        return error("assert_nil: expected nil, got " + str(v));
    }
    return true;
}

// assert_not_nil(v) — assert value is not nil
fn assert_not_nil(v) {
    if v == nil {
        return error("assert_not_nil: expected non-nil value");
    }
    return true;
}

export describe, it, xit, fit, test, before_each, after_each, before_all, after_all,
       expect, expect_throws, expect_no_throw, run_all, reset, stats, fail,
       assert_equal, assert_true, assert_false, assert_nil, assert_not_nil;
