// stdlib/ecs.sapp — Entity Component System for game development.
//
// Usage:
//   let ecs = import("stdlib:ecs.sapp");
//   let world = ecs.create_world();
//   let player = ecs.spawn(world, map{ position: map{x:0,y:0}, health: 100, name: "Player" });
//   let enemies = ecs.query(world, ["position", "health"]);  // all entities with both components
//   ecs.add_system(world, "move", fn(entities) { ... });
//   ecs.tick(world);  // run all systems once

fn create_world() {
    return map{ entities: map{}, next_id: 1, systems: [], _removed: [] };
}

fn spawn(world, components) {
    let id = world.next_id;
    world.next_id = id + 1;
    world.entities[str(id)] = components;
    return id;
}

fn despawn(world, entity_id) {
    map_remove(world.entities, str(entity_id));
}

fn get_component(world, entity_id, component_name) {
    let entity = try world.entities[str(entity_id)] catch nil;
    if entity == nil { return nil; }
    return try entity[component_name] catch nil;
}

fn set_component(world, entity_id, component_name, value) {
    let entity = try world.entities[str(entity_id)] catch nil;
    if entity == nil { return; }
    entity[component_name] = value;
}

fn has_component(world, entity_id, component_name) {
    let entity = try world.entities[str(entity_id)] catch nil;
    if entity == nil { return false; }
    return map_has(entity, component_name);
}

fn query(world, required_components) {
    let result = [];
    let entity_ids = map_keys(world.entities);
    for i len(entity_ids) {
        let eid = entity_ids[i];
        let entity = world.entities[eid];
        let has_all = true;
        for c len(required_components) {
            if map_has(entity, required_components[c]) == false {
                has_all = false;
                break;
            }
        }
        if has_all {
            result[len(result)] = map{ id: parse_number(eid), components: entity };
        }
    }
    return result;
}

fn add_system(world, name, system_fn) {
    world.systems[len(world.systems)] = map{ name: name, fn: system_fn };
}

fn tick(world) {
    for i len(world.systems) {
        let sys = world.systems[i];
        try sys.fn(world) catch nil;
    }
}

fn entity_count(world) { return len(map_keys(world.entities)); }

// remove_component(world, id, name) — drop one component from an entity.
fn remove_component(world, entity_id, component_name) {
    let entity = try world.entities[str(entity_id)] catch nil;
    if entity == nil { return; }
    if map_has(entity, component_name) { map_remove(entity, component_name); }
}

// query_one(world, required) — the first entity matching all components, or nil.
fn query_one(world, required_components) {
    let r = query(world, required_components);
    if len(r) == 0 { return nil; }
    return r[0];
}

// count_with(world, required) — number of entities with all the given components.
fn count_with(world, required_components) { return len(query(world, required_components)); }

// all_entities(world) — array of all entity ids.
fn all_entities(world) {
    let out = [];
    let ks = map_keys(world.entities);
    let i = 0;
    while i < len(ks) { push(out, parse_number(ks[i])); i = i + 1; }
    return out;
}

// clear(world) — remove every entity (systems are kept).
fn clear(world) { world.entities = map{}; }

export create_world, spawn, despawn, get_component, set_component, has_component,
       query, add_system, tick, entity_count,
       remove_component, query_one, count_with, all_entities, clear;
