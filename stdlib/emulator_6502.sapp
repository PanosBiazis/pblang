// stdlib/emulator_6502.sapp -- bounded MOS 6502 execution-model subset.
//
// Models the immediate arithmetic/index/branch subset used by PBLang's retro
// conformance suite. This is not a complete 6502 machine or NES/C64 emulator.

let Support = import("stdlib:emulator_support.sapp");
let FORMAT = "pblang.emulator.6502.v1";
let DEFAULT_BUDGET = 1000000;
let MAX_CODE_BYTES = 65536;

fn load_a(value) { return [169, Support.byte(value)]; }
fn load_x(value) { return [162, Support.byte(value)]; }
fn load_y(value) { return [160, Support.byte(value)]; }
fn add_carry(value) { return [105, Support.byte(value)]; }
fn subtract_carry(value) { return [233, Support.byte(value)]; }
fn clear_carry() { return [24]; }
fn set_carry() { return [56]; }
fn increment_x() { return [232]; }
fn decrement_x() { return [202]; }
fn increment_y() { return [200]; }
fn decrement_y() { return [136]; }
fn compare_x(value) { return [224, Support.byte(value)]; }
fn compare_a(value) { return [201, Support.byte(value)]; }
fn branch_not_equal(displacement) { return [208, Support.byte(displacement)]; }
fn branch_equal(displacement) { return [240, Support.byte(displacement)]; }
fn break_instruction() { return [0]; }

fn program(instructions) { return Support.program(instructions, MAX_CODE_BYTES); }

fn _zero(value) { if value == 0 { return 1; } return 0; }
fn _wrap(value) { let result = value % 256; if result < 0 { result = result + 256; } return result; }
fn _failure(reason, pc, instructions) { return Support.failure(FORMAT, reason, pc, instructions); }

fn _needs_immediate(opcode) {
    return opcode == 169 or opcode == 162 or opcode == 160 or opcode == 105 or
           opcode == 233 or opcode == 224 or opcode == 201 or opcode == 208 or opcode == 240;
}

fn run(code, options = nil) {
    let invalid = Support.validate_bytes(code, MAX_CODE_BYTES);
    if invalid != nil { return _failure(invalid, 0, 0); }
    let budget_result = Support.instruction_budget(options, DEFAULT_BUDGET);
    if not budget_result.ok { return _failure(budget_result.error, 0, 0); }
    let budget = budget_result.value;

    let a = 0; let x = 0; let y = 0; let carry = 0; let zero = 0;
    let pc = 0; let count = 0;
    while count < budget {
        if pc < 0 or pc >= len(code) { return _failure("program counter outside code", pc, count); }
        let opcode = code[pc];
        if _needs_immediate(opcode) and pc + 1 >= len(code) {
            return _failure("truncated immediate operand at offset " + str(pc), pc, count);
        }
        count = count + 1;
        if opcode == 169 { a = code[pc + 1]; zero = _zero(a); pc = pc + 2; }
        elif opcode == 162 { x = code[pc + 1]; zero = _zero(x); pc = pc + 2; }
        elif opcode == 160 { y = code[pc + 1]; zero = _zero(y); pc = pc + 2; }
        elif opcode == 24 { carry = 0; pc = pc + 1; }
        elif opcode == 56 { carry = 1; pc = pc + 1; }
        elif opcode == 105 {
            let value = a + code[pc + 1] + carry;
            carry = if value > 255 { 1 } else { 0 }; a = value % 256;
            zero = _zero(a); pc = pc + 2;
        }
        elif opcode == 233 {
            let value = a - code[pc + 1] - (1 - carry);
            carry = if value < 0 { 0 } else { 1 }; a = _wrap(value);
            zero = _zero(a); pc = pc + 2;
        }
        elif opcode == 232 { x = (x + 1) % 256; zero = _zero(x); pc = pc + 1; }
        elif opcode == 202 { x = _wrap(x - 1); zero = _zero(x); pc = pc + 1; }
        elif opcode == 200 { y = (y + 1) % 256; zero = _zero(y); pc = pc + 1; }
        elif opcode == 136 { y = _wrap(y - 1); zero = _zero(y); pc = pc + 1; }
        elif opcode == 224 {
            let immediate = code[pc + 1]; carry = if x >= immediate { 1 } else { 0 };
            zero = _zero(_wrap(x - immediate)); pc = pc + 2;
        }
        elif opcode == 201 {
            let immediate = code[pc + 1]; carry = if a >= immediate { 1 } else { 0 };
            zero = _zero(_wrap(a - immediate)); pc = pc + 2;
        }
        elif opcode == 208 {
            let next = pc + 2; if zero == 0 { next = next + Support.signed_byte(code[pc + 1]); } pc = next;
        }
        elif opcode == 240 {
            let next = pc + 2; if zero == 1 { next = next + Support.signed_byte(code[pc + 1]); } pc = next;
        }
        elif opcode == 0 {
            return map{
                ok: true, format: FORMAT, halted: true, pc: pc,
                instructions: count, registers: map{ a: a, x: x, y: y },
                flags: map{ zero: zero, carry: carry }, value: a,
                boundary: "verified 6502 immediate arithmetic/control subset; not a full machine"
            };
        }
        else { return _failure("unmodeled opcode " + str(opcode) + " at offset " + str(pc), pc, count); }
    }
    return _failure("instruction budget exceeded", pc, count);
}

export FORMAT, DEFAULT_BUDGET, MAX_CODE_BYTES;
export load_a, load_x, load_y, add_carry, subtract_carry, clear_carry, set_carry;
export increment_x, decrement_x, increment_y, decrement_y, compare_x, compare_a;
export branch_not_equal, branch_equal, break_instruction, program, run;
