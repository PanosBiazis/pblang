// stdlib/nd.sapp — n-dimensional vector math (2D, 3D, 4D, …, nD)
// Vectors are arrays of numbers: [x], [x,y], [x,y,z], [x,y,z,w], …
// Use with graphics: project to 2D then draw (e.g. gfx.drawPoint(win, nd.project2D(p), color)).

// Dimension (number of components)
fn dims(v) {
    return len(v);
}

// a + b (same dimension)
fn add(a, b) {
    let n = len(a);
    if len(b) != n { return nil; }
    let out = [];
    let i = 0;
    while i < n {
        array_push(out, a[i] + b[i]);
        i = i + 1;
    }
    return out;
}

// a - b
fn sub(a, b) {
    let n = len(a);
    if len(b) != n { return nil; }
    let out = [];
    let i = 0;
    while i < n {
        array_push(out, a[i] - b[i]);
        i = i + 1;
    }
    return out;
}

// s * v
fn scale(v, s) {
    let out = [];
    let i = 0;
    while i < len(v) {
        array_push(out, v[i] * s);
        i = i + 1;
    }
    return out;
}

// Dot product (any dimension)
fn dot(a, b) {
    let n = len(a);
    if len(b) != n { return nil; }
    let sum = 0;
    let i = 0;
    while i < n {
        sum = sum + a[i] * b[i];
        i = i + 1;
    }
    return sum;
}

// Length (Euclidean norm)
fn length(v) {
    return num_sqrt(dot(v, v));
}

// Unit vector (nil if zero length)
fn normalize(v) {
    let L = length(v);
    if L == 0 { return nil; }
    return scale(v, 1 / L);
}

// 3D cross product: a × b (returns 3D vector)
fn cross3(a, b) {
    if len(a) < 3 or len(b) < 3 { return nil; }
    return [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ];
}

// Project nD → 2D for drawing.
// 2D: return [x,y] as-is.
// 3D: perspective with (z + dist); use project2D(v) for dist=1, or project2D_dist(v, dist).
// 4D+: first project to 3D (drop tail), then 3D→2D.
fn project2D_dist(v, dist) {
    if len(v) < 2 { return nil; }
    if len(v) == 2 { return [v[0], v[1]]; }
    if len(v) == 3 {
        let z = v[2] + dist;
        if z <= 0 { return nil; }
        return [v[0] / z, v[1] / z];
    }
    let v3 = [v[0], v[1], v[2]];
    return project2D_dist(v3, dist);
}

fn project2D(v) {
    return project2D_dist(v, 1);
}

// Project nD → 3D (drop components beyond 3; pad with 0 if needed)
fn project3D(v) {
    if len(v) >= 3 { return [v[0], v[1], v[2]]; }
    if len(v) == 2 { return [v[0], v[1], 0]; }
    if len(v) == 1 { return [v[0], 0, 0]; }
    return [0, 0, 0];
}

// Linear interpolation: lerp(a, b, t) = a + t*(b-a), t in [0,1]
fn lerp(a, b, t) {
    return add(a, scale(sub(b, a), t));
}

// Distance between two points (any dimension)
fn distance(a, b) {
    return length(sub(b, a));
}

// Compute the inverse of a 2x2 or 3x3 matrix (flat row-major array).
// Returns nil for singular matrices (det == 0).
// 2x2: [a,b,c,d], 3x3: [a,b,c,d,e,f,g,h,i]
fn mat_inv(m) {
    if len(m) == 4 {
        // 2x2
        let det = m[0]*m[3] - m[1]*m[2];
        if det == 0 { return nil; }
        let inv_det = 1 / det;
        return [m[3]*inv_det, (-m[1])*inv_det, (-m[2])*inv_det, m[0]*inv_det];
    }
    if len(m) == 9 {
        // 3x3 — cofactor expansion
        let a=m[0]; let b=m[1]; let c=m[2];
        let d=m[3]; let e=m[4]; let f=m[5];
        let g=m[6]; let h=m[7]; let i=m[8];
        let det = a*(e*i - f*h) - b*(d*i - f*g) + c*(d*h - e*g);
        if det == 0 { return nil; }
        let id = 1 / det;
        return [
            (e*i - f*h)*id, (c*h - b*i)*id, (b*f - c*e)*id,
            (f*g - d*i)*id, (a*i - c*g)*id, (c*d - a*f)*id,
            (d*h - e*g)*id, (b*g - a*h)*id, (a*e - b*d)*id
        ];
    }
    return nil; // unsupported size
}

// Solve Ax = b using Cramer's rule. A is 2x2 or 3x3 (flat row-major).
// b is a 2 or 3 element array. Returns x or nil if singular.
fn mat_solve(A, b) {
    if len(A) == 4 and len(b) == 2 {
        // 2x2
        let det = A[0]*A[3] - A[1]*A[2];
        if det == 0 { return nil; }
        let x0 = (b[0]*A[3] - b[1]*A[1]) / det;
        let x1 = (A[0]*b[1] - A[2]*b[0]) / det;
        return [x0, x1];
    }
    if len(A) == 9 and len(b) == 3 {
        // 3x3 Cramer's rule
        let a=A[0]; let bv=A[1]; let c=A[2];
        let d=A[3]; let e=A[4]; let f=A[5];
        let g=A[6]; let h=A[7]; let i=A[8];
        let det = a*(e*i - f*h) - bv*(d*i - f*g) + c*(d*h - e*g);
        if det == 0 { return nil; }
        let b0=b[0]; let b1=b[1]; let b2=b[2];
        let det0 = b0*(e*i-f*h) - bv*(b1*i-f*b2) + c*(b1*h-e*b2);
        let det1 = a*(b1*i-f*b2) - b0*(d*i-f*g) + c*(d*b2-b1*g);
        let det2 = a*(e*b2-b1*h) - bv*(d*b2-b1*g) + b0*(d*h-e*g);
        return [det0/det, det1/det, det2/det];
    }
    return nil;
}

export dims, add, sub, scale, dot, length, normalize, cross3, project2D, project2D_dist, project3D, lerp, distance, mat_inv, mat_solve;
