// stdlib/matrix.sapp — dense matrices as an array of row-arrays.
// Determinant uses cofactor expansion with ordinary numeric rounding; inverse and
// solve use Gaussian elimination with partial pivoting. Pairs with vector.sapp.
//
//   let mat = import("stdlib:matrix.sapp");
//   mat.determinant([[1,2],[3,4]])           // -2
//   mat.mul([[1,2],[3,4]], mat.identity(2))  // [[1,2],[3,4]]
//   mat.solve([[2,0],[0,4]], [4, 8])         // [2, 2]

fn rows(m) { return len(m); }
fn cols(m) { if len(m) == 0 { return 0; } return len(m[0]); }
fn shape(m) { return [rows(m), cols(m)]; }
fn is_square(m) { return rows(m) == cols(m); }
// Validate all rows, not just the width of the first row.
fn _square_size(m) {
    if not is_array(m) { throw "matrix: expected an array of rows"; }
    let n=len(m);
    for row in m {
        if not is_array(row) or len(row)!=n { throw "matrix: square rows required"; }
    }
    return n;
}
fn get(m, i, j) { return m[i][j]; }
fn set(m, i, j, v) { m[i][j] = v; return m; }

fn zeros(r, c) {
    let m = [];
    for _i in 0 to r - 1 {
        let row = [];
        for _j in 0 to c - 1 { array_push(row, 0); }
        array_push(m, row);
    }
    return m;
}
fn fill(r, c, x) {
    let m = zeros(r, c);
    for i in 0 to r - 1 { for j in 0 to c - 1 { m[i][j] = x; } }
    return m;
}
fn identity(n) {
    let m = zeros(n, n);
    for i in 0 to n - 1 { m[i][i] = 1; }
    return m;
}

// Deep copy (rows are fresh arrays).
fn copy(m) {
    let out = [];
    for i in 0 to rows(m) - 1 {
        let row = [];
        for j in 0 to cols(m) - 1 { array_push(row, m[i][j]); }
        array_push(out, row);
    }
    return out;
}
fn from_rows(rs) { return copy(rs); }

fn _check_same(a, b) {
    if rows(a) != rows(b) or cols(a) != cols(b) {
        return error("matrix: shape mismatch");
    }
    return true;
}

fn add(a, b) {
    let _ = _check_same(a, b);
    let out = zeros(rows(a), cols(a));
    for i in 0 to rows(a) - 1 { for j in 0 to cols(a) - 1 { out[i][j] = a[i][j] + b[i][j]; } }
    return out;
}
fn sub(a, b) {
    let _ = _check_same(a, b);
    let out = zeros(rows(a), cols(a));
    for i in 0 to rows(a) - 1 { for j in 0 to cols(a) - 1 { out[i][j] = a[i][j] - b[i][j]; } }
    return out;
}
fn scale(m, k) {
    let out = zeros(rows(m), cols(m));
    for i in 0 to rows(m) - 1 { for j in 0 to cols(m) - 1 { out[i][j] = m[i][j] * k; } }
    return out;
}

fn transpose(m) {
    let out = zeros(cols(m), rows(m));
    for i in 0 to rows(m) - 1 { for j in 0 to cols(m) - 1 { out[j][i] = m[i][j]; } }
    return out;
}

fn mul(a, b) {
    if cols(a) != rows(b) { return error("matrix: mul dimension mismatch"); }
    let n = rows(a); let p = cols(b); let q = cols(a);
    let out = zeros(n, p);
    for i in 0 to n - 1 {
        for j in 0 to p - 1 {
            let s = 0;
            for k in 0 to q - 1 { s = s + a[i][k] * b[k][j]; }
            out[i][j] = s;
        }
    }
    return out;
}

// m * v  (matrix times column vector) -> array.
fn mul_vec(m, v) {
    if cols(m) != len(v) { return error("matrix: mul_vec dimension mismatch"); }
    let out = [];
    for i in 0 to rows(m) - 1 {
        let s = 0;
        for j in 0 to cols(m) - 1 { s = s + m[i][j] * v[j]; }
        array_push(out, s);
    }
    return out;
}

fn trace(m) {
    if not is_square(m) { return error("matrix: trace requires square"); }
    let s = 0;
    for i in 0 to rows(m) - 1 { s = s + m[i][i]; }
    return s;
}

// Submatrix with row 0 and column `col` removed.
fn _minor(m, col) {
    let out = [];
    for i in 1 to rows(m) - 1 {
        let row = [];
        for j in 0 to cols(m) - 1 { if j != col { array_push(row, m[i][j]); } }
        array_push(out, row);
    }
    return out;
}

// determinant — cofactor expansion; not arbitrary-precision integer arithmetic.
fn determinant(m) {
    if not is_square(m) { return error("matrix: determinant requires square"); }
    let n = rows(m);
    if n == 0 { return 1; }
    if n == 1 { return m[0][0]; }
    if n == 2 { return m[0][0] * m[1][1] - m[0][1] * m[1][0]; }
    let det = 0;
    let sign = 1;
    for j in 0 to n - 1 {
        det = det + sign * m[0][j] * determinant(_minor(m, j));
        sign = 0 - sign;
    }
    return det;
}

fn _swap_rows(m, i, j) { let t = m[i]; m[i] = m[j]; m[j] = t; }

// inverse — Gauss-Jordan with partial pivoting. Errors on a singular matrix.
fn inverse(m) {
    if not is_square(m) { return error("matrix: inverse requires square"); }
    let n = rows(m);
    let a = copy(m);
    let inv = identity(n);
    for col in 0 to n - 1 {
        let pivot = col;
        let maxv = num_abs(a[col][col]);
        for r in col + 1 to n - 1 {
            let av = num_abs(a[r][col]);
            if av > maxv { maxv = av; pivot = r; }
        }
        if maxv == 0 { return error("matrix: singular, not invertible"); }
        if pivot != col { _swap_rows(a, col, pivot); _swap_rows(inv, col, pivot); }
        let p = a[col][col];
        for j in 0 to n - 1 { a[col][j] = a[col][j] / p; inv[col][j] = inv[col][j] / p; }
        for r in 0 to n - 1 {
            if r != col {
                let f = a[r][col];
                if f != 0 {
                    for j in 0 to n - 1 {
                        a[r][j] = a[r][j] - f * a[col][j];
                        inv[r][j] = inv[r][j] - f * inv[col][j];
                    }
                }
            }
        }
    }
    return inv;
}

// solve A x = b  (Gaussian elimination + back substitution) -> array x.
fn solve(A, b) {
    let n = _square_size(A);
    if n != len(b) { return error("matrix: solve dimension mismatch"); }
    let a = copy(A);
    let rhs = [];
    for i in 0 to n - 1 { array_push(rhs, b[i]); }
    for col in 0 to n - 1 {
        let pivot = col;
        let maxv = num_abs(a[col][col]);
        for r in col + 1 to n - 1 {
            let av = num_abs(a[r][col]);
            if av > maxv { maxv = av; pivot = r; }
        }
        if maxv == 0 { return error("matrix: singular system"); }
        if pivot != col {
            _swap_rows(a, col, pivot);
            let t = rhs[col]; rhs[col] = rhs[pivot]; rhs[pivot] = t;
        }
        for r in col + 1 to n - 1 {
            let f = a[r][col] / a[col][col];
            for j in col to n - 1 { a[r][j] = a[r][j] - f * a[col][j]; }
            rhs[r] = rhs[r] - f * rhs[col];
        }
    }
    let x = [];
    for _i in 0 to n - 1 { array_push(x, 0); }
    let i = n - 1;
    while i >= 0 {
        let s = rhs[i];
        for j in i + 1 to n - 1 { s = s - a[i][j] * x[j]; }
        x[i] = s / a[i][i];
        i = i - 1;
    }
    return x;
}

fn equals(a, b) {
    if rows(a) != rows(b) or cols(a) != cols(b) { return false; }
    for i in 0 to rows(a) - 1 {
        for j in 0 to cols(a) - 1 { if a[i][j] != b[i][j] { return false; } }
    }
    return true;
}
fn equals_approx(a, b, eps) {
    if type(eps)!="number" { throw "matrix: epsilon must be a finite nonnegative number"; }
    if eps!=eps or eps-eps!=0 or eps<0 { throw "matrix: epsilon must be a finite nonnegative number"; }
    if not is_array(a) or not is_array(b) or len(a)!=len(b) { return false; }
    let width=0;
    if len(a)>0 {
        if not is_array(a[0]) { return false; }
        width=len(a[0]);
    }
    for i len(a) {
        if not is_array(a[i]) or not is_array(b[i]) or len(a[i])!=width or len(b[i])!=width { return false; }
        for j width {
            let delta=a[i][j]-b[i][j];
            // The runtime rejects ordered NaN comparisons; reject it explicitly.
            if delta!=delta or delta-delta!=0 { return false; }
            if num_abs(delta)>eps { return false; }
        }
    }
    return true;
}

// hadamard(a, b) — element-wise product.
fn hadamard(a, b) {
    let _ = _check_same(a, b);
    let out = zeros(rows(a), cols(a));
    for i in 0 to rows(a) - 1 { for j in 0 to cols(a) - 1 { out[i][j] = a[i][j] * b[i][j]; } }
    return out;
}

// power(m, n) — integer matrix power (n >= 0; 0 → identity).
fn power(m, n) {
    let size=_square_size(m);
    if type(n)!="number" { throw "matrix: exponent must be a nonnegative safe integer"; }
    if n!=n or n-n!=0 or n<0 or n>9007199254740991 or num_floor(n)!=n {
        throw "matrix: exponent must be a nonnegative safe integer";
    }
    let result = identity(size);
    let base=m; let remaining=n;
    while remaining>0 {
        if remaining%2==1 { result=mul(result,base); }
        remaining=num_floor(remaining/2);
        if remaining>0 { base=mul(base,base); }
    }
    return result;
}

// Solve A*X=B, with B's columns as independent right-hand sides. Reuse one
// elimination pass; all rows in the result are fresh. Limits apply only here.
fn solve_many(A, B) {
    if not is_array(A) or len(A)>128 { throw "matrix.solve_many: at most 128 rows required"; }
    let n=_square_size(A);
    if not is_array(B) or len(B)!=n { throw "matrix.solve_many: right-hand row count mismatch"; }
    let count=0;
    if n>0 {
        if not is_array(B[0]) { throw "matrix.solve_many: right-hand rows must be arrays"; }
        count=len(B[0]);
    }
    if count>128 { throw "matrix.solve_many: at most 128 right-hand columns required"; }
    for r n {
        if not is_array(B[r]) or len(B[r])!=count { throw "matrix.solve_many: ragged right-hand rows"; }
        for value in A[r] {
            if type(value)!="number" { throw "matrix.solve_many: finite numeric cells required"; }
            if value!=value or value-value!=0 { throw "matrix.solve_many: finite numeric cells required"; }
        }
        for value in B[r] {
            if type(value)!="number" { throw "matrix.solve_many: finite numeric cells required"; }
            if value!=value or value-value!=0 { throw "matrix.solve_many: finite numeric cells required"; }
        }
    }
    let x=zeros(n,count);
    if count==0 { return x; }
    let a=copy(A); let rhs=copy(B);
    for c n {
        let pivot=c; let maxv=num_abs(a[c][c]);
        for r in c+1 to n-1 {
            let av=num_abs(a[r][c]); if av>maxv {maxv=av;pivot=r;}
        }
        if maxv==0 { throw "matrix.solve_many: singular system"; }
        if pivot!=c {_swap_rows(a,c,pivot);_swap_rows(rhs,c,pivot);}
        let pivot_row=a[c]; let pivot_rhs=rhs[c];
        for r in c+1 to n-1 {
            let row=a[r]; let values=rhs[r];let f=row[c]/pivot_row[c];
            if f!=0 {
                for j in c to n-1 {row[j]=row[j]-f*pivot_row[j];}
                for j count {values[j]=values[j]-f*pivot_rhs[j];}
            }
        }
    }
    let i=n-1;
    while i>=0 {
        for c count {
            let s=rhs[i][c];
            for j in i+1 to n-1 {s=s-a[i][j]*x[j][c];}
            let value=s/a[i][i];
            if value!=value or value-value!=0 {throw "matrix.solve_many: nonfinite solution";}
            x[i][c]=value;
        }
        i=i-1;
    }
    return x;
}

// diag(vec) — build a diagonal matrix from a vector.
fn diag(vec) {
    let n = len(vec);
    let m = zeros(n, n);
    for i in 0 to n - 1 { m[i][i] = vec[i]; }
    return m;
}

// diagonal(m) — extract the main diagonal as an array.
fn diagonal(m) {
    let n = rows(m);
    if cols(m) < n { n = cols(m); }
    let out = [];
    for i in 0 to n - 1 { array_push(out, m[i][i]); }
    return out;
}

// is_symmetric(m) — true if square and m[i][j] == m[j][i].
fn is_symmetric(m) {
    if not is_square(m) { return false; }
    for i in 0 to rows(m) - 1 {
        for j in 0 to cols(m) - 1 { if m[i][j] != m[j][i] { return false; } }
    }
    return true;
}

// row(m, i) / col(m, j) — extract a row or column as a fresh array.
fn row(m, i) {
    let out = [];
    for j in 0 to cols(m) - 1 { array_push(out, m[i][j]); }
    return out;
}
fn col(m, j) {
    let out = [];
    for i in 0 to rows(m) - 1 { array_push(out, m[i][j]); }
    return out;
}

// map_elements(m, f) — apply f to every element, returning a new matrix.
fn map_elements(m, f) {
    let out = zeros(rows(m), cols(m));
    for i in 0 to rows(m) - 1 { for j in 0 to cols(m) - 1 { out[i][j] = f(m[i][j]); } }
    return out;
}

fn to_string(m) {
    let s = "";
    for i in 0 to rows(m) - 1 {
        let row = "[";
        for j in 0 to cols(m) - 1 {
            if j > 0 { row = row + ", "; }
            row = row + str(m[i][j]);
        }
        s = s + row + "]";
        if i < rows(m) - 1 { s = s + "\n"; }
    }
    return s;
}

export rows, cols, shape, is_square, get, set, zeros, fill, identity, copy,
       from_rows, add, sub, scale, transpose, mul, mul_vec, trace,
       determinant, inverse, solve, equals, equals_approx, to_string,
       hadamard, power, diag, diagonal, is_symmetric, row, col, map_elements;
export solve_many;
