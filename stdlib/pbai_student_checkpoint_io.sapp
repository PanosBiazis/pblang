// Explicit private-file adapter. Pure codec/inference remain platform-independent.
// No ordinary filesystem fallback: private-parent guarantees currently need Linux.
let N=import("stdlib:pbai_neural_adapter.sapp");
// Resolve storage with this explicit owner import, never at the later call site.
let S=import("stdlib:secure_file.sapp");
fn _path_error(path) {
    if type(path)!="string" or len(path)<1 or len(path)>4096
        or str_contains(path,strfromcharcode(0)) {return "invalid checkpoint path";}
    if platform()!="linux" {return "private checkpoint file storage unavailable on this platform";}
    return nil;
}
fn _path(path) {
    let error=_path_error(path);if error!=nil {throw error;}
}
// Inspect only fixed fields; never stringify backend payloads or error objects.
fn _success(value) {
    return type(value)=="map" and map_has(value,"ok")
        and type(value.ok)=="bool" and value.ok;
}
fn _saved(value, bytes) {
    if not _success(value) {return false;}
    if not map_has(value,"size") or type(value.size)!="number" or value.size!=bytes {return false;}
    for key in ["no_replace","exclusive_create","descriptor_bound_parent","atomic_namespace_admission"] {
        if not map_has(value,key) or type(value[key])!="bool" or not value[key] {return false;}
    }
    return map_has(value,"atomic_visibility") and type(value.atomic_visibility)=="bool"
        and not value.atomic_visibility;
}
fn _read_text(value) {
    if not _success(value) {return nil;}
    let data=try map{text:value.text,size:value.size} catch nil;
    if data==nil or type(data.text)!="string" or len(data.text)>4096
        or type(data.size)!="number" or data.size<0 or data.size>4096
        or data.size!=num_floor(data.size) {return nil;}
    // Character admission bounds this conversion even for multibyte UTF-8.
    if len(str_to_bytes(data.text))!=data.size {return nil;}
    return data.text;
}
fn save_new(path, artifact) {
    let encoded=N.student_encode(artifact);_path(path);let bytes=len(str_to_bytes(encoded));
    // Parent must already exist, be user-owned mode 0700, and resolve without links.
    let saved=try S.write_text_new_exclusive(path,encoded,false,true) catch nil;
    if _saved(saved,bytes) {return map{format:"pbai.neural.student-save.v1",ok:true,bytes:bytes,
        artifact_digest:artifact.digest,persists_weights:true,no_replace:true,
        atomic_visibility:false,crash_durability_verified:false,encrypted:false,production_ready:false,
        artifact_authenticated:false,globally_activated:false,authorizes_activation:false};}
    throw "checkpoint could not be created exclusively in a private directory";
}
// Success transfers one owned handle; a known rejection returns no handle.
// Error strings are the existing bounded public messages, never backend payloads.
fn load_file_result(path) {
    let error=_path_error(path);if error!=nil {return map{ok:false,error:error};}
    let loaded=try S.read_text(path,4096,true) catch nil;
    let text=_read_text(loaded);
    if text==nil {return map{ok:false,error:"checkpoint could not be read within private storage bounds"};}
    let decoded=N.student_decode_result(text);
    if not decoded.ok {return decoded;}
    return map{ok:true,value:N.student_load(decoded.value)};
}
fn load_file(path) {
    let result=load_file_result(path);
    if not result.ok {throw result.error;}
    return result.value;
}
export save_new, load_file, load_file_result;
