// Explicit private-file adapter. Pure codec/inference remain platform-independent.
// No ordinary filesystem fallback: private-parent guarantees currently need Linux.
let N=import("stdlib:pbai_neural_adapter.sapp");
// Resolve storage with this explicit owner import, never at the later call site.
let S=import("stdlib:secure_file.sapp");
fn _path(path) {
    if type(path)!="string" or len(path)<1 or len(path)>4096
        or str_contains(path,strfromcharcode(0)) {throw "invalid checkpoint path";}
    if platform()!="linux" {throw "private checkpoint file storage unavailable on this platform";}
}
fn save_new(path, artifact) {
    let encoded=N.student_encode(artifact);_path(path);
    // Parent must already exist, be user-owned mode 0700, and resolve without links.
    let saved=try S.write_text_new_exclusive(path,encoded,false,true) catch map{ok:false};
    if not saved.ok {throw "checkpoint could not be created exclusively in a private directory";}
    return map{format:"pbai.neural.student-save.v1",ok:true,bytes:len(str_to_bytes(encoded)),
        artifact_digest:artifact.digest,persists_weights:true,no_replace:true,
        atomic_visibility:false,crash_durability_verified:false,encrypted:false,production_ready:false,
        artifact_authenticated:false,globally_activated:false,authorizes_activation:false};
}
fn load_file(path) {
    _path(path);
    let loaded=try S.read_text(path,4096,true) catch map{ok:false};
    if not loaded.ok {throw "checkpoint could not be read within private storage bounds";}
    return N.student_load(N.student_decode(loaded.text));
}
export save_new, load_file;
