// Persistent classic-ESP32 GPIO23 controller firmware emitted entirely by
// PBLang. It implements embedded_protocol.sapp over UART0 without an SDK.

let X = import("stdlib:xtensa_lx6.sapp");
let ESP = import("stdlib:codegen_esp32_embedded.sapp");
let Protocol = import("stdlib:embedded_protocol.sapp");

let FORMAT = "pblang.embedded-wire-esp32.v1";
let IRAM_ADDRESS = 0x40078000;
let CONSTANT_WORDS = 58;
let STATE_WORDS = 27;
let POOL_BYTES = (CONSTANT_WORDS + STATE_WORDS) * 4;
let ENTRY_ADDRESS = IRAM_ADDRESS + POOL_BYTES;
let BAUD = 115200;
let MAX_IMAGE_BYTES = 8192;

let RTC_WDT_WRITE_PROTECT = 0x3ff480a4;
let RTC_WDT_FEED = 0x3ff480a0;
let RTC_WDT_CONFIG0 = 0x3ff4808c;
let RTC_WDT_WRITE_KEY = 0x50d83aa1;
let TG0_WDT_WRITE_PROTECT = 0x3ff5f064;
let TG0_WDT_CONFIG0 = 0x3ff5f048;
let GPIO_ENABLE_W1TS = 0x3ff44024;
let GPIO_ENABLE_W1TC = 0x3ff44028;
let GPIO_ENABLE = 0x3ff44020;
let GPIO_OUT_W1TS = 0x3ff44008;
let GPIO_OUT_W1TC = 0x3ff4400c;
let GPIO23_MASK = 0x00800000;
let GPIO25_MASK = 0x02000000;
let GPIO27_MASK = 0x08000000;
let GPIO_IN = 0x3ff4403c;
let GPIO_IN1 = 0x3ff44040;
let IO_MUX_GPIO25 = 0x3ff49024;
let IO_MUX_GPIO27 = 0x3ff4902c;
let IO_MUX_GPIO33 = 0x3ff49020;
let IO_MUX_GPIO_INPUT = 0x00002200;
let UART_FIFO = 0x3ff40000;
let UART_STATUS = 0x3ff4001c;
let RTC_IO_ADC_PAD = 0x3ff48480;
// GPIO34 is RTC_GPIO4/ADC1. The classic ESP32 RTCIO LL contract sets MUX_SEL
// for RTC/analog routing despite the stale inverse wording in rtc_io_reg.h.
let RTC_IO_ADC34_CONFIG = 0x20000000;
let RTC_IO_ADC34_CLEAR_MASK = 0x707fffff;
let RTC_IO_HALL_SENS = 0x3ff48478;
let RTC_IO_HALL_XPD_CLEAR_MASK = 0x7fffffff;
let RTC_IO_TOUCH_PAD7 = 0x3ff484b0;
let RTC_IO_TOUCH_PAD7_DIGITAL_MASK = 0xfff7ffff;
let SENS_SAR_READ_CTRL = 0x3ff48800;
// RTC ADC1, hardware-corrected 12-bit output, 9-cycle sample and IDF default /1 clock.
// Classic ESP32 oneshot conversion requires SAR1_DATA_INV for increasing output.
let SENS_SAR_READ_CTRL_CONFIG = 0x10070901;
let SENS_SAR_MEAS_WAIT1 = 0x3ff48808;
let SENS_SAR_AMP_WAIT_CONFIG = 0x00010001;
let SENS_SAR_MEAS_WAIT2 = 0x3ff4880c;
let SENS_SAR_MEAS_WAIT2_AMP_CLEAR_MASK = 0xfffc0000;
let SENS_SAR_MEAS_WAIT2_AMP_DISABLED = 0x00020001;
let SENS_SAR_MEAS_CTRL = 0x3ff48810;
let SENS_SAR_MEAS_CTRL_AMP_CLEAR_MASK = 0xffff000f;
let SENS_SAR_START_FORCE = 0x3ff4882c;
let SENS_SAR_START_FORCE_CONFIG = 0x00000403;
let SENS_SAR_ATTEN1 = 0x3ff48834;
let SENS_SAR_ATTEN1_GPIO34 = 0x00003000;
let SENS_SAR_MEAS_START1 = 0x3ff48854;
let SENS_SAR_MEAS_GPIO34 = 0x82040000;
let SENS_SAR_MEAS_GPIO34_START = 0x82060000;
let SENS_SAR_TOUCH_CTRL1 = 0x3ff48858;
let SENS_SAR_TOUCH_CTRL1_FORCE = 0x0c000000;
let RTC_IO_PAD_DAC1 = 0x3ff48484;
let RTC_IO_DAC1_CLEAR_MASK = 0xc00001ff;
// MUX_SEL=1 routes GPIO25 to RTC/DAC; MUX_SEL=0 returns it to digital GPIO.
let RTC_IO_DAC1_ANALOG_CONFIG = 0x00060400;
let RTC_IO_DAC1_DIGITAL_CONFIG = 0x00000000;
let RTC_IO_DAC1_DATA_CLEAR_MASK = 0xf807ffff;
let SENS_SAR_DAC_CTRL2 = 0x3ff4889c;
let SENS_DAC_CW_EN1_CLEAR_MASK = 0xfeffffff;
let SENS_SAR_MEAS_CTRL2 = 0x3ff488a0;
let SENS_SAR1_DAC_SYNC_CLEAR_MASK = 0xfffffffe;

let STAGE=0; let CHECKSUM=1; let SEQUENCE=2; let OPCODE=3; let VALUE=4;
let INTERVAL_L=5; let INTERVAL_H=6; let DURATION_L=7; let DURATION_H=8;
let FLAGS=9; let LAST_SEQUENCE=10; let EXPECTED=11;
let PHASE_L=12; let PHASE_H=13; let REMAINING_L=14; let REMAINING_H=15;
let PAYLOAD0_L=16; let PAYLOAD0_H=17; let PAYLOAD1_L=18; let PAYLOAD1_H=19;
let BLINK_INTERVAL_L=20; let BLINK_INTERVAL_H=21;
let BUTTON_LATCH=22; let BUTTON_COUNT=23; let BUTTON_DEBOUNCE_TICKS=12;
let ANALOG_FOLLOW=24;let ADC_REFRESH_COUNT=25;let ANALOG_DUTY=26;
let ADC_REFRESH_TICKS=4;

fn _append(target,source){for i len(source){array_push(target,source[i]);}}
fn _u32(value){return [num_mod(value,256),num_mod(num_floor(value/256),256),
    num_mod(num_floor(value/65536),256),num_mod(num_floor(value/16777216),256)];}
fn _emit(state,bytes){X.emit(state,bytes);}
fn _pool(){
    let state_base=IRAM_ADDRESS+CONSTANT_WORDS*4;
    let words=[RTC_WDT_WRITE_PROTECT,RTC_WDT_FEED,RTC_WDT_CONFIG0,RTC_WDT_WRITE_KEY,
        0,GPIO23_MASK,TG0_WDT_WRITE_PROTECT,TG0_WDT_CONFIG0,
        GPIO_ENABLE_W1TS,GPIO_OUT_W1TS,GPIO_OUT_W1TC,UART_FIFO,UART_STATUS,
        GPIO25_MASK,GPIO_IN1,IO_MUX_GPIO25,IO_MUX_GPIO33,IO_MUX_GPIO_INPUT,
        RTC_IO_ADC_PAD,RTC_IO_ADC34_CONFIG,SENS_SAR_READ_CTRL,SENS_SAR_READ_CTRL_CONFIG,
        SENS_SAR_START_FORCE,SENS_SAR_START_FORCE_CONFIG,SENS_SAR_ATTEN1,
        SENS_SAR_ATTEN1_GPIO34,SENS_SAR_MEAS_START1,SENS_SAR_MEAS_GPIO34,
        SENS_SAR_MEAS_GPIO34_START,SENS_SAR_TOUCH_CTRL1,SENS_SAR_TOUCH_CTRL1_FORCE,
        GPIO_IN,IO_MUX_GPIO27,GPIO27_MASK,RTC_IO_TOUCH_PAD7,
        RTC_IO_TOUCH_PAD7_DIGITAL_MASK,GPIO_ENABLE_W1TC,
        RTC_IO_ADC34_CLEAR_MASK,RTC_IO_HALL_SENS,RTC_IO_HALL_XPD_CLEAR_MASK,
        SENS_SAR_MEAS_WAIT1,SENS_SAR_AMP_WAIT_CONFIG,SENS_SAR_MEAS_WAIT2,
        SENS_SAR_MEAS_WAIT2_AMP_CLEAR_MASK,SENS_SAR_MEAS_WAIT2_AMP_DISABLED,
        SENS_SAR_MEAS_CTRL,SENS_SAR_MEAS_CTRL_AMP_CLEAR_MASK,GPIO_ENABLE,
        RTC_IO_PAD_DAC1,RTC_IO_DAC1_CLEAR_MASK,RTC_IO_DAC1_ANALOG_CONFIG,
        RTC_IO_DAC1_DIGITAL_CONFIG,RTC_IO_DAC1_DATA_CLEAR_MASK,
        SENS_SAR_DAC_CTRL2,SENS_DAC_CW_EN1_CLEAR_MASK,SENS_SAR_MEAS_CTRL2,
        SENS_SAR1_DAC_SYNC_CLEAR_MASK,state_base];
    let out=[];for i len(words){_append(out,_u32(words[i]));}
    let state_word=0;while state_word<STATE_WORDS{
        _append(out,[0,0,0,0]);state_word=state_word+1;
    }return out;
}
fn _literal(state,register,index){
    _emit(state,X.l32r(register,POOL_BYTES+len(state.code),index*4));
}
fn _load(state,register,index){
    if index < 16 { _emit(state,X.l32i_n(register,2,index*4)); } else { _emit(state,X.l32i(register,2,index*4)); }
}
fn _store(state,index,register){
    if index < 16 { _emit(state,X.s32i_n(register,2,index*4)); } else { _emit(state,X.s32i(register,2,index*4)); }
}
fn _store_value(state,index,value,register=11){_emit(state,X.movi(register,value));_store(state,index,register);}
fn _branch_zero(state,register,target){
    let nonzero=X.unique(state,"nonzero_");X.branch_nonzero(state,register,nonzero);
    X.jump(state,target);X.label(state,nonzero);
}
fn _branch_equal_imm(state,register,value,target,left=12,result=13){
    _emit(state,X.movi(left,value));_emit(state,X.xor_regs(result,register,left));
    _branch_zero(state,result,target);
}
fn _branch_not_equal_imm(state,register,value,target,left=12,result=13){
    _emit(state,X.movi(left,value));_emit(state,X.xor_regs(result,register,left));
    X.branch_nonzero(state,result,target);
}
fn _branch_negative(state,register,target,temp=14){
    _emit(state,X.extui(temp,register,31,1));X.branch_nonzero(state,temp,target);
}
fn _checksum_add(state,byte_register){
    _load(state,11,CHECKSUM);_emit(state,X.add_regs(11,11,byte_register));
    _emit(state,X.extui(11,11,0,8));_store(state,CHECKSUM,11);
}
fn _advance(state,next){_store_value(state,STAGE,next);X.jump(state,"timer");}
fn _reset_parser(state){
    let retain_magic=X.unique(state,"retain_magic_");
    _branch_equal_imm(state,10,80,retain_magic);
    _store_value(state,STAGE,0);X.jump(state,"timer");
    X.label(state,retain_magic);_store(state,CHECKSUM,10);
    _store_value(state,STAGE,1);X.jump(state,"timer");
}
fn _guard_byte(state,register,value){
    let accepted=X.unique(state,"byte_ok_");_branch_equal_imm(state,register,value,accepted);
    _reset_parser(state);X.label(state,accepted);
}
fn _capture_stage(state,index,next){_store(state,index,10);_checksum_add(state,10);_advance(state,next);}
fn _led_on(state){_emit(state,X.s32i_n(8,6,0));_emit(state,X.memw());}
fn _led_off(state){_emit(state,X.s32i_n(8,7,0));_emit(state,X.memw());}
fn _dac_pad_config(state,config_index){
    _literal(state,9,48);_emit(state,X.l32i_n(10,9,0));_literal(state,11,49);
    _emit(state,X.and_regs(10,10,11));_literal(state,12,config_index);
    _emit(state,X.or_regs(10,10,12));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
}
fn _dac_write(state,value_register){
    _literal(state,9,48);_emit(state,X.l32i_n(10,9,0));_literal(state,11,52);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.move(12,value_register));
    _emit(state,X.movi(13,19));let shift_loop=X.unique(state,"dac_shift_");X.label(state,shift_loop);
    _emit(state,X.add_regs(12,12,12));_emit(state,X.addi_n(13,-1));X.branch_nonzero(state,13,shift_loop);
    _emit(state,X.or_regs(10,10,12));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
}
fn _dac_enable(state){
    _literal(state,9,36);_literal(state,10,13);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _dac_pad_config(state,50);_load(state,11,ANALOG_DUTY);_dac_write(state,11);
}
fn _dac_disable_digital(state){
    _dac_pad_config(state,51);_literal(state,9,8);_literal(state,10,13);
    _emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
}
fn _set_result_bit(state,value){
    _load(state,11,FLAGS);_emit(state,X.movi(12,value));
    _emit(state,X.or_regs(13,11,12));_store(state,FLAGS,13);
}
fn _loopback_test(state){
    let low_done=X.unique(state,"loopback_low_done_");
    let high_done=X.unique(state,"loopback_high_done_");
    _dac_disable_digital(state);
    _literal(state,5,13);_emit(state,X.s32i_n(5,7,0));_emit(state,X.memw());
    _literal(state,9,14);_emit(state,X.l32i_n(10,9,0));_emit(state,X.extui(10,10,1,1));
    X.branch_nonzero(state,10,low_done);_set_result_bit(state,4);X.label(state,low_done);
    _emit(state,X.s32i_n(5,6,0));_emit(state,X.memw());
    _emit(state,X.l32i_n(10,9,0));_emit(state,X.extui(10,10,1,1));
    _branch_zero(state,10,high_done);_set_result_bit(state,8);X.label(state,high_done);
    _emit(state,X.s32i_n(5,7,0));_emit(state,X.memw());
    _load(state,10,ANALOG_FOLLOW);let follow_disabled=X.unique(state,"loopback_follow_disabled_");
    _branch_zero(state,10,follow_disabled);_dac_enable(state);X.label(state,follow_disabled);
}
fn _prepare_payload(state){
    _load(state,11,BLINK_INTERVAL_L);_store(state,PAYLOAD0_L,11);
    _load(state,11,BLINK_INTERVAL_H);_store(state,PAYLOAD0_H,11);
    _load(state,11,REMAINING_L);_store(state,PAYLOAD1_L,11);
    _load(state,11,REMAINING_H);_store(state,PAYLOAD1_H,11);
}
fn _adc_conversion(state,retain,failure="invalid_command"){
    _literal(state,9,26);_literal(state,10,27);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,10,28);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _emit(state,X.movi(13,32));let outer=X.unique(state,"adc_outer_");
    let inner=X.unique(state,"adc_inner_");let done=X.unique(state,"adc_done_");
    X.label(state,outer);_emit(state,X.movi(14,255));X.label(state,inner);
    _emit(state,X.l32i_n(11,9,0));_emit(state,X.extui(12,11,16,1));
    X.branch_nonzero(state,12,done);_emit(state,X.addi_n(14,-1));
    X.branch_nonzero(state,14,inner);_emit(state,X.addi_n(13,-1));
    X.branch_nonzero(state,13,outer);X.jump(state,failure);
    X.label(state,done);if retain{
        _emit(state,X.extui(12,11,0,8));_store(state,PAYLOAD0_L,12);
        _emit(state,X.extui(12,11,8,4));_store(state,PAYLOAD0_H,12);
    }
}
fn _adc_read(state){
    _adc_conversion(state,false);_adc_conversion(state,true);
    _store_value(state,PAYLOAD1_L,255);_store_value(state,PAYLOAD1_H,15);
}

fn _adc_follow_service(state){
    let done=X.unique(state,"adc_follow_done_");let sample=X.unique(state,"adc_follow_sample_");
    let failed=X.unique(state,"adc_follow_failed_");
    _load(state,10,ANALOG_FOLLOW);_branch_zero(state,10,done);
    _load(state,10,ADC_REFRESH_COUNT);_emit(state,X.addi_n(10,1));_store(state,ADC_REFRESH_COUNT,10);
    _emit(state,X.movi(11,ADC_REFRESH_TICKS));_emit(state,X.sub_regs(12,10,11));
    _branch_negative(state,12,done,13);X.label(state,sample);_store_value(state,ADC_REFRESH_COUNT,0);
    _adc_conversion(state,false,failed);_adc_conversion(state,true,failed);
    // ADC bits 11:4 map exactly to the 8-bit GPIO25 DAC value.
    _emit(state,X.extui(12,11,4,8));_store(state,ANALOG_DUTY,12);_dac_write(state,12);
    X.jump(state,done);X.label(state,failed);_store_value(state,ANALOG_FOLLOW,0);
    _dac_disable_digital(state);_literal(state,9,13);_emit(state,X.s32i_n(9,7,0));_emit(state,X.memw());
    X.label(state,done);
}

fn _gpio27_read(state){
    _literal(state,9,31);_emit(state,X.l32i_n(10,9,0));
    _literal(state,11,33);_emit(state,X.and_regs(10,10,11));
}

fn _button_service(state){
    let released=X.unique(state,"button_released_");
    let done=X.unique(state,"button_done_");
    let stable_pressed=X.unique(state,"button_stable_pressed_");
    let stable_released=X.unique(state,"button_stable_released_");
    let turn_on=X.unique(state,"button_turn_on_");
    let toggled=X.unique(state,"button_toggled_");
    _gpio27_read(state);
    _branch_zero(state,10,released);_load(state,11,BUTTON_LATCH);
    X.branch_nonzero(state,11,stable_pressed);_load(state,11,BUTTON_COUNT);
    _emit(state,X.addi_n(11,1));_store(state,BUTTON_COUNT,11);
    _emit(state,X.movi(12,BUTTON_DEBOUNCE_TICKS));_emit(state,X.sub_regs(13,11,12));
    _branch_negative(state,13,done,14);
    _store_value(state,BUTTON_LATCH,1);_store_value(state,BUTTON_COUNT,0);
    _store_value(state,REMAINING_L,0);_store_value(state,REMAINING_H,0);
    _load(state,11,FLAGS);_emit(state,X.extui(11,11,0,1));_branch_zero(state,11,turn_on);
    _store_value(state,FLAGS,0);_led_off(state);X.jump(state,toggled);
    X.label(state,turn_on);_store_value(state,FLAGS,1);_led_on(state);
    X.label(state,toggled);X.jump(state,done);
    X.label(state,stable_pressed);_store_value(state,BUTTON_COUNT,0);X.jump(state,done);
    X.label(state,released);_load(state,11,BUTTON_LATCH);
    _branch_zero(state,11,stable_released);_load(state,11,BUTTON_COUNT);
    _emit(state,X.addi_n(11,1));_store(state,BUTTON_COUNT,11);
    _emit(state,X.movi(12,BUTTON_DEBOUNCE_TICKS));_emit(state,X.sub_regs(13,11,12));
    _branch_negative(state,13,done,14);
    _store_value(state,BUTTON_LATCH,0);_store_value(state,BUTTON_COUNT,0);X.jump(state,done);
    X.label(state,stable_released);_store_value(state,BUTTON_COUNT,0);X.label(state,done);
}
fn _button_read(state){
    let done=X.unique(state,"button_read_done_");
    _store_value(state,PAYLOAD0_L,0);_store_value(state,PAYLOAD0_H,0);
    _store_value(state,PAYLOAD1_L,0);_store_value(state,PAYLOAD1_H,0);
    _gpio27_read(state);
    _branch_zero(state,10,done);_set_result_bit(state,4);_store_value(state,PAYLOAD0_L,1);X.label(state,done);
}

fn _gpio_snapshot(state){
    _literal(state,9,31);_emit(state,X.l32i_n(10,9,0));
    _emit(state,X.extui(11,10,0,8));_store(state,PAYLOAD0_L,11);
    _emit(state,X.extui(11,10,8,8));_store(state,PAYLOAD0_H,11);
    _emit(state,X.extui(11,10,16,8));_store(state,PAYLOAD1_L,11);
    _emit(state,X.extui(11,10,24,8));_store(state,PAYLOAD1_H,11);
}

fn _gpio27_self_test(state){
    let output_still_enabled=X.unique(state,"gpio27_output_enabled_");
    let input_low=X.unique(state,"gpio27_input_low_");
    let input_done=X.unique(state,"gpio27_input_done_");
    _store_value(state,PAYLOAD0_L,0);_store_value(state,PAYLOAD0_H,0);
    _store_value(state,PAYLOAD1_L,0);_store_value(state,PAYLOAD1_H,0);
    // Never drive a button pin. Disable output, verify the enable bit is clear,
    // then take one bounded input-only electrical sample.
    _literal(state,9,36);_literal(state,10,33);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,47);_emit(state,X.l32i_n(10,9,0));_literal(state,11,33);
    _emit(state,X.and_regs(10,10,11));X.branch_nonzero(state,10,output_still_enabled);
    _set_result_bit(state,4);_store_value(state,PAYLOAD0_L,1);
    X.label(state,output_still_enabled);_gpio27_read(state);_branch_zero(state,10,input_low);
    _store_value(state,PAYLOAD1_L,1);X.jump(state,input_done);
    X.label(state,input_low);_store_value(state,PAYLOAD1_L,0);X.label(state,input_done);
    _set_result_bit(state,8);
}

fn _set_expected(state){
    _load(state,11,SEQUENCE);_store(state,LAST_SEQUENCE,11);_emit(state,X.addi_n(11,1));
    _emit(state,X.extui(11,11,0,8));
    let ready=X.unique(state,"sequence_ready_");X.branch_nonzero(state,11,ready);
    _emit(state,X.movi(11,1));X.label(state,ready);_store(state,EXPECTED,11);
}
fn _pair_zero_branch(state,low_index,high_index,target){
    _load(state,11,low_index);_load(state,12,high_index);
    _emit(state,X.or_regs(13,11,12));_branch_zero(state,13,target);
}
fn _decrement_pair(state,low_index,high_index){
    _load(state,11,low_index);let low_nonzero=X.unique(state,"low_nonzero_");
    let complete=X.unique(state,"decrement_done_");X.branch_nonzero(state,11,low_nonzero);
    _emit(state,X.movi(11,255));_store(state,low_index,11);_load(state,12,high_index);
    _emit(state,X.addi_n(12,-1));_store(state,high_index,12);X.jump(state,complete);
    X.label(state,low_nonzero);_emit(state,X.addi_n(11,-1));_store(state,low_index,11);
    X.label(state,complete);
}
fn _validate_reserved_timing(state,invalid){
    _load(state,11,INTERVAL_L);_branch_not_equal_imm(state,11,244,invalid);
    _load(state,11,INTERVAL_H);_branch_not_equal_imm(state,11,1,invalid);
    _load(state,11,DURATION_L);X.branch_nonzero(state,11,invalid);
    _load(state,11,DURATION_H);X.branch_nonzero(state,11,invalid);
}
fn _validate_zero_value(state,invalid){_load(state,11,VALUE);X.branch_nonzero(state,11,invalid);}
fn _validate_interval(state,valid,invalid){
    _load(state,11,INTERVAL_H);_load(state,12,INTERVAL_L);
    _emit(state,X.movi(13,235));_emit(state,X.sub_regs(14,11,13));
    let below235=X.unique(state,"interval_below235_");_branch_negative(state,14,below235,13);
    X.jump(state,invalid);X.label(state,below235);
    let low_min=X.unique(state,"interval_low_min_");let low_max=X.unique(state,"interval_low_max_");
    // Preserve register 12: it holds the low byte used by both boundary checks.
    _branch_equal_imm(state,11,0,low_min,13,14);_branch_equal_imm(state,11,234,low_max,13,14);
    X.jump(state,valid);
    X.label(state,low_min);_emit(state,X.movi(13,10));_emit(state,X.sub_regs(14,12,13));
    _branch_negative(state,14,invalid,13);X.jump(state,valid);
    X.label(state,low_max);_emit(state,X.movi(13,97));_emit(state,X.sub_regs(14,12,13));
    _branch_negative(state,14,valid,13);X.jump(state,invalid);
}
fn _validate_duration(state,valid,invalid){
    _load(state,11,DURATION_H);_load(state,12,DURATION_L);
    _emit(state,X.movi(13,235));_emit(state,X.sub_regs(14,11,13));
    let below235=X.unique(state,"duration_below235_");_branch_negative(state,14,below235,13);
    X.jump(state,invalid);X.label(state,below235);
    let low_max=X.unique(state,"duration_low_max_");_branch_equal_imm(state,11,234,low_max,13,14);
    X.jump(state,valid);
    X.label(state,low_max);_emit(state,X.movi(13,97));_emit(state,X.sub_regs(14,12,13));
    _branch_negative(state,14,valid,13);X.jump(state,invalid);
