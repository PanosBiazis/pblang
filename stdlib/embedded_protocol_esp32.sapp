fn _command_ok(state){_set_expected(state);_emit(state,X.movi(10,Protocol.STATUS_OK));X.jump(state,"respond");}
fn _send_checked(state,register){
    _emit(state,X.s32i_n(register,3,0));_emit(state,X.add_regs(11,11,register));
    _emit(state,X.extui(11,11,0,8));
