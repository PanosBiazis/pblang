fn _send_value(state,value){_emit(state,X.movi(12,value));_send_checked(state,12);}
fn _send_state(state,index){_load(state,12,index);_emit(state,X.extui(12,12,0,8));_send_checked(state,12);}

fn _startup(state){
    // Disable both ROM-started watchdogs and restore write protection.
    _literal(state,9,0);_literal(state,10,3);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,1);_literal(state,10,5);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,2);_literal(state,10,4);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,0);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,6);_literal(state,10,3);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,7);_literal(state,10,4);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,6);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    // Put GPIO25 and GPIO33 in GPIO function 2 and enable the GPIO33 input path.
    _literal(state,9,15);_literal(state,10,17);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,16);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,32);_literal(state,10,17);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    // GPIO27 is also RTC_GPIO17. Preserve its RTC pad configuration while
    // selecting the digital path, matching rtc_gpio_deinit semantics.
    _literal(state,9,34);_emit(state,X.l32i_n(10,9,0));_literal(state,11,35);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    // Preserve GPIO35 fields while selecting GPIO34's RTC analog route and
    // disabling GPIO34 hold/function/input controls.
    _literal(state,9,18);_emit(state,X.l32i_n(10,9,0));_literal(state,11,37);
    _emit(state,X.and_regs(10,10,11));_literal(state,12,19);
    _emit(state,X.or_regs(10,10,12));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    // Match the classic ESP-IDF oneshot setup: disable the Hall sensor and
    // LNA-only ADC amplifier, retain unrelated fields, and use bounded waits.
    _literal(state,9,38);_emit(state,X.l32i_n(10,9,0));_literal(state,11,39);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,40);_literal(state,10,41);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,42);_emit(state,X.l32i_n(10,9,0));_literal(state,11,43);
    _emit(state,X.and_regs(10,10,11));_literal(state,12,44);
    _emit(state,X.or_regs(10,10,12));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,45);_emit(state,X.l32i_n(10,9,0));_literal(state,11,46);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    // Configure ADC1 channel 6 at 12-bit, 12 dB attenuation. Preserve touch
    // settings while forcing Hall power/phase under software control.
    _literal(state,9,20);_literal(state,10,21);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,22);_literal(state,10,23);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,24);_literal(state,10,25);_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,29);_emit(state,X.l32i_n(10,9,0));_literal(state,11,30);
    _emit(state,X.or_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    // Select direct register-driven DAC1 output and keep ADC conversions from
    // power-cycling it. All unrelated SENS fields are retained.
    _literal(state,9,53);_emit(state,X.l32i_n(10,9,0));_literal(state,11,54);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());
    _literal(state,9,55);_emit(state,X.l32i_n(10,9,0));_literal(state,11,56);
    _emit(state,X.and_regs(10,10,11));_emit(state,X.s32i_n(10,9,0));_emit(state,X.memw());

    _literal(state,2,57);_literal(state,3,11);_literal(state,4,12);
    _literal(state,5,8);_literal(state,6,9);_literal(state,7,10);_literal(state,8,5);
    _emit(state,X.s32i_n(8,5,0));_literal(state,9,13);
    _emit(state,X.memw());_led_off(state);
    _emit(state,X.s32i_n(9,7,0));_emit(state,X.memw());
    _store_value(state,INTERVAL_L,244);_store_value(state,INTERVAL_H,1);
    _store_value(state,BLINK_INTERVAL_L,244);_store_value(state,BLINK_INTERVAL_H,1);
    _store_value(state,PHASE_L,244);_store_value(state,PHASE_H,1);
    _store_value(state,STAGE,0);_store_value(state,FLAGS,0);
    _store_value(state,ANALOG_FOLLOW,1);_store_value(state,ADC_REFRESH_COUNT,0);
    _store_value(state,ANALOG_DUTY,0);_dac_enable(state);
}

fn _parser(state){
    X.label(state,"main");_emit(state,X.l8ui(9,4,0));_branch_zero(state,9,"timer");
    _emit(state,X.l8ui(10,3,0));_load(state,11,STAGE);
    for stage 12{_branch_equal_imm(state,11,stage,"stage"+str(stage));}
    _reset_parser(state);

    X.label(state,"stage0");_guard_byte(state,10,80);_store(state,CHECKSUM,10);_advance(state,1);
    X.label(state,"stage1");_guard_byte(state,10,66);_checksum_add(state,10);_advance(state,2);
    X.label(state,"stage2");_guard_byte(state,10,Protocol.VERSION);_checksum_add(state,10);_advance(state,3);
    X.label(state,"stage3");let sequence_ok=X.unique(state,"sequence_ok_");X.branch_nonzero(state,10,sequence_ok);
    _reset_parser(state);X.label(state,sequence_ok);_capture_stage(state,SEQUENCE,4);
    X.label(state,"stage4");_capture_stage(state,OPCODE,5);
    X.label(state,"stage5");_capture_stage(state,VALUE,6);
    X.label(state,"stage6");_capture_stage(state,INTERVAL_L,7);
    X.label(state,"stage7");_capture_stage(state,INTERVAL_H,8);
    X.label(state,"stage8");_capture_stage(state,DURATION_L,9);
    X.label(state,"stage9");_capture_stage(state,DURATION_H,10);
    X.label(state,"stage10");_guard_byte(state,10,0);_checksum_add(state,10);_advance(state,11);
    X.label(state,"stage11");_load(state,11,CHECKSUM);_emit(state,X.xor_regs(12,11,10));
    _branch_zero(state,12,"execute");_reset_parser(state);
}

fn _execute(state){
    X.label(state,"execute");_load(state,11,FLAGS);_emit(state,X.extui(11,11,0,2));
    _store(state,FLAGS,11);_prepare_payload(state);_load(state,11,OPCODE);
    _branch_equal_imm(state,11,Protocol.OP_STATUS,"do_status");
    _load(state,12,EXPECTED);_branch_zero(state,12,"not_synchronized");
    _load(state,13,SEQUENCE);_load(state,14,LAST_SEQUENCE);_emit(state,X.xor_regs(14,13,14));
    _branch_zero(state,14,"duplicate_command");_emit(state,X.xor_regs(14,13,12));
    X.branch_nonzero(state,14,"out_of_order");
    _branch_equal_imm(state,11,Protocol.OP_SET,"do_set");
    _branch_equal_imm(state,11,Protocol.OP_TOGGLE,"do_toggle");
    _branch_equal_imm(state,11,Protocol.OP_BLINK,"do_blink");
    _branch_equal_imm(state,11,Protocol.OP_STOP,"do_stop");
    _branch_equal_imm(state,11,Protocol.OP_CAPABILITIES,"do_capabilities");
    _branch_equal_imm(state,11,Protocol.OP_LOOPBACK,"do_loopback");
    _branch_equal_imm(state,11,Protocol.OP_ADC_READ,"do_adc_read");
    _branch_equal_imm(state,11,Protocol.OP_BUTTON_READ,"do_button_read");
    _branch_equal_imm(state,11,Protocol.OP_OUTPUT_TEST,"do_output_test");
    _branch_equal_imm(state,11,Protocol.OP_GPIO_SNAPSHOT,"do_gpio_snapshot");
    _branch_equal_imm(state,11,Protocol.OP_GPIO27_SELF_TEST,"do_gpio27_self_test");
    _branch_equal_imm(state,11,Protocol.OP_ANALOG_FOLLOW,"do_analog_follow");X.jump(state,"invalid_command");

    X.label(state,"do_status");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_command_ok(state);

    X.label(state,"do_set");_load(state,11,VALUE);_emit(state,X.movi(12,2));
    _emit(state,X.sub_regs(13,11,12));let set_value_ok=X.unique(state,"set_value_ok_");
    _branch_negative(state,13,set_value_ok,14);X.jump(state,"invalid_command");X.label(state,set_value_ok);
    _validate_reserved_timing(state,"invalid_command");_store_value(state,REMAINING_L,0);
    _store_value(state,REMAINING_H,0);_load(state,11,VALUE);let set_on=X.unique(state,"set_on_");
    let set_done=X.unique(state,"set_done_");X.branch_nonzero(state,11,set_on);
    _store_value(state,FLAGS,0);_led_off(state);X.jump(state,set_done);
    X.label(state,set_on);_store_value(state,FLAGS,1);_led_on(state);X.label(state,set_done);_command_ok(state);

    X.label(state,"do_toggle");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_store_value(state,REMAINING_L,0);
    _store_value(state,REMAINING_H,0);_load(state,11,FLAGS);_emit(state,X.extui(11,11,0,1));
    let toggle_on=X.unique(state,"toggle_on_");let toggle_done=X.unique(state,"toggle_done_");
    _branch_zero(state,11,toggle_on);_store_value(state,FLAGS,0);_led_off(state);X.jump(state,toggle_done);
    X.label(state,toggle_on);_store_value(state,FLAGS,1);_led_on(state);X.label(state,toggle_done);_command_ok(state);

    X.label(state,"do_blink");_validate_zero_value(state,"invalid_command");
    let interval_valid=X.unique(state,"interval_valid_");_validate_interval(state,interval_valid,"invalid_command");
    X.label(state,interval_valid);let duration_valid=X.unique(state,"duration_valid_");
    _validate_duration(state,duration_valid,"invalid_command");X.label(state,duration_valid);
    _load(state,11,INTERVAL_L);_store(state,PHASE_L,11);_load(state,11,INTERVAL_H);_store(state,PHASE_H,11);
    _load(state,11,INTERVAL_L);_store(state,BLINK_INTERVAL_L,11);
    _load(state,11,INTERVAL_H);_store(state,BLINK_INTERVAL_H,11);
    _load(state,11,INTERVAL_L);_store(state,PAYLOAD0_L,11);
    _load(state,11,INTERVAL_H);_store(state,PAYLOAD0_H,11);
    _load(state,11,DURATION_L);_store(state,REMAINING_L,11);_load(state,11,DURATION_H);_store(state,REMAINING_H,11);
    _store_value(state,FLAGS,3);_led_on(state);_command_ok(state);

    X.label(state,"do_stop");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_store_value(state,FLAGS,0);
    _store_value(state,REMAINING_L,0);_store_value(state,REMAINING_H,0);_led_off(state);_command_ok(state);

    X.label(state,"do_capabilities");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_set_result_bit(state,4);
    _set_result_bit(state,8);
    _store_value(state,PAYLOAD0_L,
        Protocol.CAP_DIGITAL_LOOPBACK|Protocol.CAP_ADC_READ|Protocol.CAP_ANALOG_FOLLOW);
    _store_value(state,PAYLOAD0_H,0);_store_value(state,PAYLOAD1_L,0);_store_value(state,PAYLOAD1_H,0);
    _command_ok(state);

    X.label(state,"do_loopback");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_loopback_test(state);_command_ok(state);

    X.label(state,"do_adc_read");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_adc_read(state);_command_ok(state);

    X.label(state,"do_button_read");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_button_read(state);_command_ok(state);

    X.label(state,"do_gpio_snapshot");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_gpio_snapshot(state);_command_ok(state);

    X.label(state,"do_gpio27_self_test");_validate_zero_value(state,"invalid_command");
    _validate_reserved_timing(state,"invalid_command");_gpio27_self_test(state);_command_ok(state);

    X.label(state,"do_output_test");_load(state,11,VALUE);_emit(state,X.movi(12,2));
    _emit(state,X.sub_regs(13,11,12));let outputs_value_ok=X.unique(state,"outputs_value_ok_");
    _branch_negative(state,13,outputs_value_ok,14);X.jump(state,"invalid_command");X.label(state,outputs_value_ok);
    _validate_reserved_timing(state,"invalid_command");_store_value(state,ANALOG_FOLLOW,0);
    _dac_disable_digital(state);_store_value(state,REMAINING_L,0);
    _store_value(state,REMAINING_H,0);_load(state,11,VALUE);let outputs_on=X.unique(state,"outputs_on_");
    let outputs_done=X.unique(state,"outputs_done_");X.branch_nonzero(state,11,outputs_on);
    _store_value(state,FLAGS,0);_led_off(state);_literal(state,5,13);
    _emit(state,X.s32i_n(5,7,0));_emit(state,X.memw());X.jump(state,outputs_done);
    X.label(state,outputs_on);_store_value(state,FLAGS,1);_led_on(state);_literal(state,5,13);
    _emit(state,X.s32i_n(5,6,0));_emit(state,X.memw());X.label(state,outputs_done);_command_ok(state);

    X.label(state,"do_analog_follow");_load(state,11,VALUE);_emit(state,X.movi(12,2));
    _emit(state,X.sub_regs(13,11,12));let follow_value_ok=X.unique(state,"follow_value_ok_");
    _branch_negative(state,13,follow_value_ok,14);X.jump(state,"invalid_command");X.label(state,follow_value_ok);
    _validate_reserved_timing(state,"invalid_command");_load(state,11,VALUE);
    let follow_off=X.unique(state,"analog_follow_off_");let follow_done=X.unique(state,"analog_follow_done_");
    _branch_zero(state,11,follow_off);_store_value(state,ANALOG_FOLLOW,1);
    _store_value(state,ADC_REFRESH_COUNT,0);_dac_enable(state);X.jump(state,follow_done);
    X.label(state,follow_off);_store_value(state,ANALOG_FOLLOW,0);_store_value(state,ANALOG_DUTY,0);
    _dac_disable_digital(state);_literal(state,9,13);_emit(state,X.s32i_n(9,7,0));_emit(state,X.memw());
    X.label(state,follow_done);_load(state,11,ANALOG_FOLLOW);_store(state,PAYLOAD0_L,11);
    _store_value(state,PAYLOAD0_H,0);_load(state,11,ANALOG_DUTY);_store(state,PAYLOAD1_L,11);
    _store_value(state,PAYLOAD1_H,0);_command_ok(state);

    X.label(state,"invalid_command");_emit(state,X.movi(10,Protocol.STATUS_INVALID));X.jump(state,"respond");
    X.label(state,"duplicate_command");_emit(state,X.movi(10,Protocol.STATUS_DUPLICATE));X.jump(state,"respond");
    X.label(state,"not_synchronized");_emit(state,X.movi(10,Protocol.STATUS_NOT_SYNCHRONIZED));X.jump(state,"respond");
    X.label(state,"out_of_order");_emit(state,X.movi(10,Protocol.STATUS_OUT_OF_ORDER));X.jump(state,"respond");
}

fn _respond(state){
    X.label(state,"respond");_emit(state,X.movi(11,0));
    _send_value(state,80);_send_value(state,82);_send_value(state,Protocol.VERSION);
    _send_state(state,SEQUENCE);_send_checked(state,10);_send_state(state,FLAGS);
    _send_state(state,PAYLOAD0_L);_send_state(state,PAYLOAD0_H);
    _send_state(state,PAYLOAD1_L);_send_state(state,PAYLOAD1_H);_send_value(state,0);
    _emit(state,X.s32i_n(11,3,0));_store_value(state,STAGE,0);X.jump(state,"timer");
}

fn _timer(state){
    X.label(state,"timer");_emit(state,X.movi(9,40));let outer=X.unique(state,"tick_outer_");
    let inner=X.unique(state,"tick_inner_");X.label(state,outer);_emit(state,X.movi(10,200));
    X.label(state,inner);_emit(state,X.addi_n(10,-1));X.branch_nonzero(state,10,inner);
    _emit(state,X.addi_n(9,-1));X.branch_nonzero(state,9,outer);
    _button_service(state);
    _adc_follow_service(state);
    _load(state,9,FLAGS);_emit(state,X.extui(9,9,1,1));_branch_zero(state,9,"main");
    _decrement_pair(state,PHASE_L,PHASE_H);let phase_expired=X.unique(state,"phase_expired_");
    let remaining=X.unique(state,"remaining_service_");_pair_zero_branch(state,PHASE_L,PHASE_H,phase_expired);
    X.jump(state,remaining);X.label(state,phase_expired);
    _load(state,11,BLINK_INTERVAL_L);_store(state,PHASE_L,11);
    _load(state,11,BLINK_INTERVAL_H);_store(state,PHASE_H,11);
    _load(state,11,FLAGS);_emit(state,X.extui(11,11,0,1));let phase_on=X.unique(state,"phase_on_");
    let phase_done=X.unique(state,"phase_done_");_branch_zero(state,11,phase_on);
    _store_value(state,FLAGS,2);_led_off(state);X.jump(state,phase_done);
    X.label(state,phase_on);_store_value(state,FLAGS,3);_led_on(state);X.label(state,phase_done);
    X.label(state,remaining);let infinite=X.unique(state,"infinite_blink_");
    _pair_zero_branch(state,REMAINING_L,REMAINING_H,infinite);
    _decrement_pair(state,REMAINING_L,REMAINING_H);let finished=X.unique(state,"finite_finished_");
    _pair_zero_branch(state,REMAINING_L,REMAINING_H,finished);X.jump(state,"main");
    X.label(state,finished);_store_value(state,FLAGS,0);_led_off(state);X.jump(state,"main");
    X.label(state,infinite);X.jump(state,"main");
}

fn compile(){
    let state=X.assembler();_startup(state);_parser(state);_execute(state);_respond(state);_timer(state);
    let code=X.finish(state);let segment=_pool();_append(segment,code);
    while num_mod(len(segment),4)!=0{array_push(segment,0);}
    let image=ESP.image(segment,IRAM_ADDRESS,ENTRY_ADDRESS);let parsed=ESP.parse_image(image);
    if parsed.segment!=segment or len(image)>MAX_IMAGE_BYTES{throw "embedded_protocol_esp32: controller image failed bounded roundtrip (image_bytes="+str(len(image))+")";}
    return map{ok:true,format:FORMAT,board:"esp32-devkitc-v4",mcu:"esp32",
        architecture:"xtensa-lx6",backend:"native-xtensa-lx6",firmware_format:"esp-image",
        image:image,binary:segment,bytes:len(segment),image_bytes:len(image),
        load_address:IRAM_ADDRESS,entry_address:ENTRY_ADDRESS,
        sha256:sha256(base64_encode_bytes(image)),baud:BAUD,protocol:Protocol.FORMAT,
        protocol_version:Protocol.VERSION,persistent_command_loop:true,ram_loadable:true,
        flash_bootable:true,persistent_flash_ready:true,gpio:23,
        loopback:map{output:"GPIO25",input:"GPIO33",expected_result_bits:3},
        button:map{pin:"GPIO27",active_high:true,input_mask:GPIO27_MASK,
            read_strategy:"rtc-digital-mux+gpio-in-mask",rtc_digital_mux:true,
            rtc_mux_operation:"clear-bit-19",
            debounce_ticks:BUTTON_DEBOUNCE_TICKS,
            release_debounce_ticks:BUTTON_DEBOUNCE_TICKS,symmetric_debounce:true,
            self_test:"input-only-output-disable-verification",
            self_test_drives_pin:false,
            action:"stop-blink-and-toggle-led"},
        adc:map{pin:"GPIO34",unit:1,channel:6,bits:12,maximum:4095,
            attenuation_db:12,data_inverted:true,rtc_analog_mux:true,
            adjacent_pad_preserved:true,sar_clock_div:1,
            hall_disabled:true,amp_disabled:true},
        analog_follow:map{enabled_at_boot:true,input:"GPIO34",output:"GPIO25",
            method:"dac1-8bit",dac_channel:1,dac_bits:8,refresh_ticks:ADC_REFRESH_TICKS,
            adc_dac_sync_disabled:true,cw_generator_disabled:true},
        c_fallback:false,assembler_dependency:false,compiler_dependency:false,
        native_source_language:"pblang"};
}

export FORMAT, IRAM_ADDRESS, ENTRY_ADDRESS, POOL_BYTES, BAUD, MAX_IMAGE_BYTES,
