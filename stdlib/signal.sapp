// stdlib/signal.sapp — Lightweight event/signal system (pub-sub within a module)
//
// Usage:
//   let signal = import("stdlib:signal.sapp");
//   let sig = signal.new();
//   let unsub = signal.subscribe(sig, fn(data) { print "got: " + str(data); });
//   signal.emit(sig, "hello");
//   unsub();  // unsubscribe

// Signal state: { handlers: map{ id: fn }, next_id: number }
fn new() {
    return map{
        handlers: map{},
        next_id: 0
    };
}

// subscribe(sig, fn) → unsub_fn
// Registers a handler and returns an unsubscribe function.
fn subscribe(sig, handler) {
    let id = str(sig.next_id);
    sig.handlers[id] = handler;
    sig.next_id = sig.next_id + 1;
    // Return unsub closure
    return fn() { map_remove(sig.handlers, id); };
}

// once(sig, fn) → unsub_fn
// Subscribe for a single emission only (auto-unsubscribes after first call).
fn once(sig, handler) {
    let unsub = nil;
    let wrapper = fn(data) {
        unsub();
        handler(data);
    };
    unsub = subscribe(sig, wrapper);
    return unsub;
}

// emit(sig, data) — call all subscribed handlers with data
fn emit(sig, data) {
    let ids = map_keys(sig.handlers);
    let i = 0;
    while i < len(ids) {
        let h = sig.handlers[ids[i]];
        if h != nil { h(data); }
        i = i + 1;
    }
}

// emit_async(sig, data) — emit in a new thread (fire and forget)
fn emit_async(sig, data) {
    let ids = map_keys(sig.handlers);
    let handlers_copy = [];
    let i = 0;
    while i < len(ids) {
        array_push(handlers_copy, sig.handlers[ids[i]]);
        i = i + 1;
    }
    let h_ref = handlers_copy;
    let d_ref = data;
    spawn(fn() {
        let j = 0;
        while j < len(h_ref) {
            if h_ref[j] != nil { h_ref[j](d_ref); }
            j = j + 1;
        }
    });
}

// clear(sig) — remove all subscribers
fn clear(sig) {
    sig.handlers = map{};
    return sig;
}

// count(sig) → number of subscribers
fn count(sig) {
    return len(map_keys(sig.handlers));
}

// map_signal(sig, transform_fn) → new_signal
// Creates a derived signal whose emissions are the transformed values.
fn map_signal(sig, transform_fn) {
    let derived = new();
    subscribe(sig, fn(data) {
        emit(derived, transform_fn(data));
    });
    return derived;
}

// filter_signal(sig, pred) → new_signal
// Creates a derived signal that only emits when pred(data) is truthy.
fn filter_signal(sig, pred) {
    let derived = new();
    subscribe(sig, fn(data) {
        if pred(data) { emit(derived, data); }
    });
    return derived;
}

export new, subscribe, once, emit, emit_async, clear, count, map_signal, filter_signal;
