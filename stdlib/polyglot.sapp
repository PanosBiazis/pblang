let _detect_cache = map{};
let _detect_cached = false;

fn _detect_command(candidates) {
    let i = 0;
    while i < len(candidates) {
        let cmd = str(candidates[i]);
        let found = try os_which(cmd) catch nil;
        if found != nil and str_trim(str(found)) != "" {
            return map{ command: cmd, path: str_trim(str(found)) };
        }
        i = i + 1;
    }
    return nil;
}

fn _copy_detect_entry(entry) {
    return map{ available: entry.available, kind: entry.kind,
        command: entry.command, path: entry.path, probe: entry.probe,
        execution_authorized: false };
}

fn _copy_detect_map(source) {
    let copied = map{};
    let keys = map_keys(source);
    let i = 0;
    while i < len(keys) {
        copied[keys[i]] = _copy_detect_entry(source[keys[i]]);
        i = i + 1;
    }
    return copied;
}

// Probe which polyglot toolchains exist on the host PATH. Returns the existing
// lang -> { available, kind, command } contract and retains one bounded result.
fn detect(refresh = false) {
    if not refresh and _detect_cached { return _copy_detect_map(_detect_cache); }
    let out = map{};
    let i = 0;
    while i < len(_DETECT_SPECS) {
        let spec = _DETECT_SPECS[i];
        let resolved = _detect_command(spec[2]);
        out[spec[0]] = map{
            available: resolved != nil,
            kind: spec[1],
            command: if resolved == nil { "" } else { resolved.command },
            path: if resolved == nil { "" } else { resolved.path },
            probe: "discovery-only",
            execution_authorized: false
        };
        i = i + 1;
    }
    _detect_cache = out;
    _detect_cached = true;
    return _copy_detect_map(out);
}

fn run(lang, code, options = nil) { return REGISTRY.run(lang, code, options); }

// Compilation is separate from execution and requires explicit source and
// toolchain-effect approval. The result is a verified private artifact; this
// module never loads it into the VM process.
fn compile(lang, code, output_root, options = nil) {
    return REGISTRY.compile(lang, code, output_root, options);
}

// Legacy in-process loading is intentionally disabled. Native library
// constructors and ABI faults require an isolated broker, not only an allowlist.
fn compile_cached(lang, code) {
    throw "polyglot.compile_cached is disabled; use compile() and an isolated typed-FFI broker";
}

fn cache_clear() {
    return map{ format: "pblang.polyglot-cache.v2", ok: false, complete: false,
        removed: 0, raw_fallback: false,
        error: "legacy native polyglot cache management is disabled" };
}

fn cache_info() {
    return map{ format: "pblang.polyglot-cache.v2", ok: true, complete: true,
        enabled: false, dir: "", count: 0, size_bytes: 0, raw_fallback: false,
        reason: "legacy in-process native cache is disabled" };
}

// ── Language matrix (informational) ──────────────────────────────────────────
