            "asm_x86", "asm_rv32", "asm_x64", "asm_arm64", "nasm", "gas"
        ],
        interpreted: [
            "python", "js", "deno", "bun", "bash", "zsh", "fish", "powershell",
            "ruby", "perl", "raku", "lua", "php", "r",
            "tcl", "awk", "sed", "m4", "jq", "julia", "racket", "scheme", "clojure",
            "elixir", "groovy", "fennel", "ocaml", "scala",
            "csharp",
            "qsharp", "sql", "sqlite", "postgresql", "mysql",
            "mongodb", "redis",
            "matlab", "prolog", "smalltalk", "forth", "logo", "basic", "apl",
            "idris", "sass", "less", "bc", "dc", "gnuplot", "io",
            "duckdb", "cassandra", "neo4j", "clickhouse",
            "lisp", "janet", "maxima", "gap", "pari", "brainfuck"
        ],
        compiled: [
            "rust", "go", "c", "cpp", "zig", "java", "kotlin", "typescript",
            "pascal", "nim", "crystal", "d", "haskell", "fortran", "ada",
            "swift", "cobol", "erlang", "vala", "objc",
            "nasm", "gas", "v", "ocaml-compiled",
            "csharp", "fsharp", "vb", "dart",
            "odin", "carbon", "mojo", "chapel", "factor",
            "purescript", "solidity", "gleam", "hare", "vale", "austral", "hylo", "koka",
            "lean4", "coq", "agda", "bend", "verse",
