// stdlib/polyglot.sapp — Polyglot block execution bridge (PL1-alpha)
// Executes code in a foreign language (python, node, bash, etc.) via subprocess.
// Requires allow_exec capability.

// Run a code block in the given language via subprocess.
// lang: "python", "python3", "node", "bash", "ruby", "perl"
// src: source code string
// Returns map{ ok, stdout, stderr, exit_code }
fn run_block(lang, src) {
    // Build command based on language
    let cmd = lang;
    if lang == "python" { cmd = "python3"; }
    if lang == "js" { cmd = "node"; }
    if lang == "javascript" { cmd = "node"; }

    // Write src to a temp file and execute it
    let tmp_path = "/tmp/pblang_polyglot_" + to_string(random_float()) + "." + _ext_for_lang(lang);
    let wrote = try fs_write(tmp_path, src) catch false;
    if wrote == false {
        return map{ ok: false, stdout: "", stderr: "failed to write temp file", exit_code: -1 };
    }

    let result = try {
        let r = proc_spawn_wait(cmd, [tmp_path]);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "subprocess failed or not found" };

    try fs_remove(tmp_path) catch nil;

    let ok = result.exit_code == 0;
    return map{
        ok: ok,
        stdout: result.stdout,
        stderr: result.stderr,
        exit_code: result.exit_code
    };
}

fn _ext_for_lang(lang) {
    if lang == "python" or lang == "python3" { return "py"; }
    if lang == "node" or lang == "js" or lang == "javascript" { return "js"; }
    if lang == "ruby" { return "rb"; }
    if lang == "perl" { return "pl"; }
    if lang == "lua" { return "lua"; }
    if lang == "php" { return "php"; }
    if lang == "r" { return "r"; }
    if lang == "rust" { return "rs"; }
    if lang == "go" { return "go"; }
    if lang == "c" { return "c"; }
    if lang == "cpp" or lang == "c++" { return "cpp"; }
    if lang == "java" { return "java"; }
    if lang == "kotlin" or lang == "kt" { return "kt"; }
    if lang == "swift" { return "swift"; }
    if lang == "zig" { return "zig"; }
    if lang == "haskell" or lang == "hs" { return "hs"; }
    if lang == "typescript" or lang == "ts" { return "ts"; }
    if lang == "bash" { return "sh"; }
    if lang == "qsharp" or lang == "qs" { return "qs"; }
    if lang == "sql" or lang == "sqlite" { return "sql"; }
    if lang == "matlab" or lang == "octave" { return "m"; }
    if lang == "prolog" { return "pl"; }
    if lang == "smalltalk" { return "st"; }
    if lang == "forth" { return "fth"; }
    if lang == "sass" or lang == "scss" { return "scss"; }
    if lang == "less" { return "less"; }
    return "sh";
}

fn to_string(v) {
    return str(v);
}

// ── Native-backed wrappers (PL1-beta) ────────────────────────────────────────
//
// These wrap the in-VM `polyglot_exec*` / `polyglot_detect` builtins. They
// avoid the temp-file ceremony in `run_block` above (cheaper + no /tmp
// pollution) and add coverage for compiled languages (rust/go/c/cpp/zig/java/ts)
// that `run_block` cannot reach because it assumes a single interpreter call.
//
// All return the same shape:
//   map{ ok: bool, stdout: string, stderr: string, exit_code: number }

fn _parse_result(raw) {
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot: malformed result JSON: " + raw, exit_code: -1 };
    }
    return map{
        ok: parsed.success,
        stdout: parsed.stdout,
        stderr: parsed.stderr,
        exit_code: parsed.exit_code
    };
}

// Run an interpreted-language snippet via the in-VM subprocess bridge.
// Supported: python, js (node), bash, ruby, perl, lua, php, r.
fn exec(lang, code) {
    let raw = try polyglot_exec(lang, code) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// Same as exec but feeds `input` to the subprocess's stdin. Lets a polyglot
// block act as a stdin → stdout filter.
fn exec_with_input(lang, code, input) {
    let raw = try polyglot_exec_with_input(lang, code, input) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec_with_input: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// Compile-and-run for compiled languages: rust, go, c, cpp, zig, java, typescript.
// Uses a temp dir + the right host compiler/runtime, captures stdout/stderr.
fn exec_compiled(lang, code) {
    let raw = try polyglot_exec_compiled(lang, code) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec_compiled: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// PBLang-owned toolchain registry. Discovery only resolves trusted executable
// names through the argv-safe os_which system boundary; it never starts the
// discovered program. This matters for shells such as Tcl where `--version`
// starts an interactive REPL and can otherwise wait forever for stdin.
let _DETECT_SPECS = [
    ["python", "interpreter", ["python3", "python"]],
    ["node", "interpreter", ["node"]],
    ["deno", "interpreter", ["deno"]],
    ["bash", "interpreter", ["bash"]],
    ["zsh", "interpreter", ["zsh"]],
    ["fish", "interpreter", ["fish"]],
    ["powershell", "interpreter", ["pwsh"]],
    ["ruby", "interpreter", ["ruby"]],
    ["perl", "interpreter", ["perl"]],
    ["raku", "interpreter", ["raku"]],
    ["lua", "interpreter", ["lua"]],
    ["php", "interpreter", ["php"]],
    ["r", "interpreter", ["Rscript"]],
    ["tcl", "interpreter", ["tclsh"]],
    ["awk", "interpreter", ["awk"]],
    ["julia", "interpreter", ["julia"]],
    ["racket", "interpreter", ["racket"]],
    ["scheme", "interpreter", ["guile"]],
    ["clojure", "interpreter", ["clojure"]],
    ["elixir", "interpreter", ["elixir"]],
    ["groovy", "interpreter", ["groovy"]],
    ["fennel", "interpreter", ["fennel"]],
    ["ocaml", "interpreter", ["ocaml"]],
    ["scala", "interpreter", ["scala"]],
    ["rust", "compiler", ["rustc"]],
    ["go", "compiler", ["go"]],
    ["c", "compiler", ["cc", "gcc", "clang"]],
    ["cpp", "compiler", ["c++", "g++", "clang++"]],
    ["zig", "compiler", ["zig"]],
    ["java", "compiler", ["javac"]],
    ["kotlin", "compiler", ["kotlinc"]],
    ["typescript", "compiler", ["tsc"]],
    ["pascal", "compiler", ["fpc"]],
    ["nim", "compiler", ["nim"]],
    ["crystal", "compiler", ["crystal"]],
    ["d", "compiler", ["dmd", "ldc2", "gdc"]],
    ["haskell", "compiler", ["runghc", "ghc"]],
    ["fortran", "compiler", ["gfortran", "flang"]],
    ["ada", "compiler", ["gnatmake"]],
    ["swift", "compiler", ["swift"]],
    ["cobol", "compiler", ["cobc"]],
    ["erlang", "compiler", ["escript"]],
    ["vala", "compiler", ["valac"]],
    ["objc", "compiler", ["clang", "gcc"]],
    ["nasm", "compiler", ["nasm"]],
    ["gas", "compiler", ["as"]],
    ["v", "compiler", ["v"]],
    ["ocaml-compiled", "compiler", ["ocamlfind", "ocamlc"]],
    ["csharp", "compiler", ["dotnet"]],
    ["fsharp", "compiler", ["dotnet"]],
    ["vb", "compiler", ["dotnet"]],
    ["dotnet-script", "interpreter", ["dotnet-script"]],
    ["native-image", "compiler", ["native-image"]],
    ["kotlin-native", "compiler", ["kotlinc-native"]],
    ["qsharp", "interpreter", ["python3"]],
    ["sqlite", "interpreter", ["sqlite3"]],
    ["psql", "interpreter", ["psql"]],
    ["mysql", "interpreter", ["mysql"]],
    ["mongosh", "interpreter", ["mongosh"]],
    ["redis-cli", "interpreter", ["redis-cli"]],
    ["octave", "interpreter", ["octave"]],
    ["prolog", "interpreter", ["swipl"]],
    ["smalltalk", "interpreter", ["gst"]],
    ["forth", "interpreter", ["gforth"]],
    ["idris", "interpreter", ["idris2"]],
    ["sass", "interpreter", ["sass"]],
    ["lessc", "interpreter", ["lessc"]],
    ["bc", "interpreter", ["bc"]],
    ["dc", "interpreter", ["dc"]],
    ["gnuplot", "interpreter", ["gnuplot"]],
    ["io", "interpreter", ["io"]],
    ["qsharp-compiled", "compiler", ["dotnet"]],
    ["haxe", "compiler", ["haxe"]],
    ["pony", "compiler", ["ponyc"]],
    ["red", "compiler", ["red"]],
    ["verilog", "compiler", ["iverilog"]],
    ["mercury", "compiler", ["mmc"]],
    ["reason", "compiler", ["bsb"]],
    ["duckdb", "interpreter", ["duckdb"]],
    ["cassandra", "interpreter", ["cqlsh"]],
    ["neo4j", "interpreter", ["cypher-shell"]],
    ["clickhouse", "interpreter", ["clickhouse-client"]],
    ["lisp", "interpreter", ["sbcl"]],
    ["janet", "interpreter", ["janet"]],
    ["maxima", "interpreter", ["maxima"]],
    ["gap", "interpreter", ["gap"]],
    ["pari", "interpreter", ["gp"]],
    ["odin", "compiler", ["odin"]],
    ["carbon", "compiler", ["carbon"]],
    ["mojo", "compiler", ["mojo"]],
    ["chapel", "compiler", ["chpl"]],
    ["factor", "compiler", ["factor"]],
    ["purescript", "compiler", ["purs"]],
    ["solidity", "compiler", ["solc"]]
];

let _detect_cache = map{};
let _detect_cached = false;

fn _detect_command(candidates) {
    let i = 0;
    while i < len(candidates) {
        let cmd = str(candidates[i]);
        let found = try os_which(cmd) catch nil;
        if found != nil and str_trim(str(found)) != "" { return cmd; }
        i = i + 1;
    }
    return "";
}

// Probe which polyglot toolchains exist on the host PATH. Returns the existing
// lang -> { available, kind, command } contract and retains one bounded result.
fn detect(refresh = false) {
    if not refresh and _detect_cached { return _detect_cache; }
    let out = map{};
    let i = 0;
    while i < len(_DETECT_SPECS) {
        let spec = _DETECT_SPECS[i];
        let cmd = _detect_command(spec[2]);
        out[spec[0]] = map{
            available: cmd != "",
            kind: spec[1],
            command: cmd,
            probe: "path-lookup"
        };
        i = i + 1;
    }
    _detect_cache = out;
    _detect_cached = true;
    return out;
}

// Convenience: pick the right strategy automatically — interpreters go through
// `exec`, compiled languages go through `exec_compiled`. Useful when a caller
// has a generic @lang block without caring which path it takes.
fn run(lang, code) {
    let compiled_langs = [
        "rust", "rs",
        "go",
        "c", "cpp", "c++", "cxx",
        "zig",
        "java",
        "ts", "typescript",
        "pascal", "pas", "delphi", "freepascal",
        "kotlin", "kt",
        "nim",
        "crystal",
        "d",
        "haskell", "hs",
        "fortran", "f90", "f95", "f03", "f08", "f",
        "ada", "adb",
        "swift",
        "cobol", "cob",
        "erlang", "erl",
        "vala",
        "objc", "objective-c", "m",
        "nasm", "asm", "s",
        "gas",
        "v",
        "ocaml-compiled",
        "csharp", "cs", "c#",
        "fsharp", "fs", "fsx", "f#",
        "vb", "vbnet", "visualbasic",
        "qsharp-compiled", "qs-compiled",
        "haxe", "hx",
        "pony",
        "red",
        "verilog", "vlog",
        "mercury",
        "reason", "re",
        "odin", "carbon", "mojo", "chapel", "chpl",
        "factor", "purescript", "purs", "solidity", "sol"
    ];
    let i = 0;
    while i < len(compiled_langs) {
        if compiled_langs[i] == lang {
            return exec_compiled(lang, code);
        }
        i = i + 1;
    }
    return exec(lang, code);
}

// ── Cached cdylib loader (PL2-alpha) ─────────────────────────────────────────
//
// `compile_cached(lang, code)` compiles the given snippet to a shared
// library, caches it by content hash under ~/.cache/pblang/polyglot/,
// and returns an FFI handle. Subsequent identical calls reuse the
// cached artifact — zero subprocess overhead on warm cache.
//
// The caller is responsible for declaring C-ABI exports inside `code`:
//   rust: #[no_mangle] pub extern "C" fn foo(...) { ... }
//   c:    int foo(...) { ... }
//   cpp:  extern "C" int foo(...) { ... }
//   go:   //export Foo  (above each exported function)
//   pascal: function Foo(...): Integer; cdecl; export;
//
// Then invoke via the standard FFI:
//   let h = polyglot.compile_cached("rust", source);
//   let result = ffi_call_typed(h, "foo", "i64->i64", [42]);
//   ffi_close(h);
//
// Supported languages: rust, c, cpp, go, pascal, csharp (NativeAOT), fsharp
// (NativeAOT), zig, d, nim, swift, haskell, fortran, objc, ocaml, java
// (GraalVM native-image --shared, two-step javac+native-image), kotlin
// (Kotlin/Native -produce dynamic). All must produce a host-loadable cdylib
// / .so / .dll / .dylib.

fn _shared_library_ext() {
    let p = str_lower(platform());
    if str_contains(p, "windows") { return "dll"; }
    if str_contains(p, "mac") or str_contains(p, "darwin") { return "dylib"; }
    return "so";
}

fn _first_tool(candidates) {
    let i = 0;
    while i < len(candidates) {
        let probe = try proc_spawn_wait("which", [candidates[i]]) catch nil;
        if probe != nil and probe.exit_code == 0 { return candidates[i]; }
        i = i + 1;
    }
    return nil;
}

let _d_compiler_name = "";
let _d_compiler_signature = "";

fn _d_compiler() {
    if _d_compiler_name != "" { return _d_compiler_name; }
    _d_compiler_name = _first_tool(["dmd", "ldc2", "gdc"]);
    if _d_compiler_name == nil { _d_compiler_name = ""; return nil; }
    let version = try proc_spawn_wait(_d_compiler_name, ["--version"]) catch nil;
    let version_text = if version == nil { "unknown" } else { version.stdout + version.stderr };
    _d_compiler_signature = _d_compiler_name + "\n" + version_text;
    return _d_compiler_name;
}

fn _d_cache_dir() {
    let home = try env_get("HOME") catch "";
    if home == nil or home == "" { home = "/tmp"; }
    return path_join(home, ".cache", "pblang", "polyglot", "pblang-d");
}

// Compiler-specific fallback for D. The native bridge historically passed
// GCC's -fPIC to ldc2; ldc2 requires -relocation-model=pic instead. Keeping the
// fallback in pblang also gives self-hosted tools a portable path immediately.
fn _compile_cached_d(code) {
    let compiler = _d_compiler();
    if compiler == nil { throw "polyglot.compile_cached(d): no D compiler found"; }

    let cache_dir = _d_cache_dir();
    fs_mkdirs(cache_dir);
    let key = sha256("pblang-d-v2\n" + platform() + "\n" + _d_compiler_signature + "\n" + code);
    let artifact = path_join(cache_dir, key + "." + _shared_library_ext());
    if fs_exists(artifact) { return ffi_load(artifact); }

    let nonce = str(num_floor(now_ms())) + "_" + str(num_floor(random_float() * 1000000000));
    let source = path_join(cache_dir, "pblang_d_" + nonce + ".d");
    let staged = path_join(cache_dir, "pblang_d_" + nonce + "." + _shared_library_ext());
    fs_write(source, code);

    let args = [];
    if compiler == "ldc2" {
        args = ["-shared", "-relocation-model=pic", "-O3", "-of=" + staged, source];
    } else if compiler == "gdc" {
        args = ["-shared", "-fPIC", "-O3", "-o", staged, source];
    } else {
        args = ["-shared", "-fPIC", "-O", "-of=" + staged, source];
    }

    let built = try proc_spawn_wait(compiler, args) catch nil;
    try fs_remove(source) catch nil;
    if built == nil or built.exit_code != 0 or not fs_exists(staged) {
        try fs_remove(staged) catch nil;
        let details = if built == nil { "compiler process failed" } else { built.stderr };
        throw "polyglot.compile_cached(d): " + compiler + " failed: " + details;
    }

    if fs_exists(artifact) { try fs_remove(staged) catch nil; }
    else {
        let published = try { fs_rename(staged, artifact); true } catch false;
        if not published {
            if fs_exists(artifact) { try fs_remove(staged) catch nil; }
            else { throw "polyglot.compile_cached(d): failed to publish cache artifact"; }
        }
    }
    return ffi_load(artifact);
}

fn compile_cached(lang, code) {
    let normalized = str_lower(lang);
    if normalized == "d" { return _compile_cached_d(code); }
    return polyglot_compile_cached(lang, code);
}

fn cache_clear() {
    let removed = polyglot_cache_clear();
    let dir = _d_cache_dir();
    let files = try fs_listdir(dir) catch [];
    let i = 0;
    while i < len(files) {
        let path = path_join(dir, files[i]);
        let deleted = try { fs_remove(path); true } catch false;
        if deleted { removed = removed + 1; }
        i = i + 1;
    }
    return removed;
}

fn cache_info() {
    let raw = polyglot_cache_info();
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil { parsed = map{ dir: "", count: 0, size_bytes: 0 }; }
    let d_dir = _d_cache_dir();
    let files = try fs_listdir(d_dir) catch [];
    let d_count = 0;
    let d_size = 0;
    let ext = "." + _shared_library_ext();
    let i = 0;
    while i < len(files) {
        if str_ends_with(files[i], ext) {
            let bytes = try fs_read_bytes(path_join(d_dir, files[i])) catch [];
            d_count = d_count + 1;
            d_size = d_size + len(bytes);
        }
        i = i + 1;
    }
    parsed.count = parsed.count + d_count;
    parsed.size_bytes = parsed.size_bytes + d_size;
    parsed.d_dir = d_dir;
    parsed.d_count = d_count;
    return parsed;
}

// ── Language matrix (informational) ──────────────────────────────────────────
//
// Returns a map describing every language the bridge knows about plus how
// it's reached. Pair with `detect()` to discover what's actually installed.
fn supported_languages() {
    return map{
        interpreted: [
            "python", "js", "deno", "bash", "zsh", "fish", "powershell",
            "ruby", "perl", "raku", "lua", "php", "r",
            "tcl", "awk", "julia", "racket", "scheme", "clojure",
            "elixir", "groovy", "fennel", "ocaml", "scala",
            "csharp",
            "qsharp", "sql", "sqlite", "postgresql", "mysql",
            "mongodb", "redis",
            "matlab", "prolog", "smalltalk", "forth",
            "idris", "sass", "less", "bc", "dc", "gnuplot", "io",
            "duckdb", "cassandra", "neo4j", "clickhouse",
            "lisp", "janet", "maxima", "gap", "pari"
        ],
        compiled: [
            "rust", "go", "c", "cpp", "zig", "java", "kotlin", "typescript",
            "pascal", "nim", "crystal", "d", "haskell", "fortran", "ada",
            "swift", "cobol", "erlang", "vala", "objc",
            "nasm", "gas", "v", "ocaml-compiled",
            "csharp", "fsharp", "vb",
            "odin", "carbon", "mojo", "chapel", "factor",
            "purescript", "solidity",
            "qsharp-compiled", "haxe", "pony", "red",
            "verilog", "mercury", "reason"
        ],
        cdylib_cached: [
            "rust", "c", "cpp", "go", "pascal",
            "csharp", "fsharp",
            "zig", "d", "nim", "swift", "haskell", "fortran", "objc", "ocaml",
            "java", "kotlin"
        ],
        web_bundle: ["html", "css", "js", "scss", "sass", "less", "svg", "xml", "json"],
        database: ["sql", "sqlite", "postgresql", "psql", "mysql", "mariadb", "mongodb", "redis"],
        stylesheet: ["css", "scss", "sass", "less"]
    };
}

// all_languages() — every supported language, flattened across categories.
fn all_languages() {
    let m = supported_languages();
    let out = [];
    let cats = map_keys(m);
    let i = 0;
    while i < len(cats) {
        let arr = m[cats[i]];
        if type(arr) == "array" {
            let j = 0;
            while j < len(arr) { array_push(out, arr[j]); j = j + 1; }
        }
        i = i + 1;
    }
    return out;
}

// is_supported(lang) — true if lang appears in any supported category.
fn is_supported(lang) {
    let all = all_languages();
    let i = 0;
    while i < len(all) { if all[i] == lang { return true; } i = i + 1; }
    return false;
}

// language_count() — total number of supported languages.
fn language_count() { return len(all_languages()); }

export run_block;
export exec;
export exec_with_input;
export exec_compiled;
export detect;
export run;
export compile_cached;
export cache_clear;
export cache_info;
export supported_languages;
export all_languages, is_supported, language_count;
