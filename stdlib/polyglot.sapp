}

// all_languages() — every supported language, flattened across categories.
fn all_languages() {
    let m = supported_languages();
    let out = [];
    let cats = map_keys(m);
    let i = 0;
    while i < len(cats) {
        let arr = m[cats[i]];
        if type(arr) == "array" {
            let j = 0;
            while j < len(arr) {
                let seen = false;
                let k = 0;
                while k < len(out) { if out[k] == arr[j] { seen = true; } k = k + 1; }
                if not seen { array_push(out, arr[j]); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

// is_supported(lang) — true if lang appears in any supported category or universal alias table.
fn is_supported(lang) {
    if UNIVERSAL.is_known(lang) { return true; }
    let all = all_languages();
    let i = 0;
    while i < len(all) { if all[i] == lang { return true; } i = i + 1; }
    return false;
}

// language_count() — total number of distinct supported language IDs.
fn language_count() { return len(all_languages()); }

// ── Sovereign Pure-PBLang In-Engine Execution (Zero Host Subprocesses) ───────
// Evaluates/compiles/simulates 40+ historical, non-programming, and futuristic
// languages directly in memory-safe PBLang without spawning external binaries.
fn eval_native(lang, code, input = nil) { return UNIVERSAL.eval_native(lang, code, input); }

// Executes an extracted `@<lang> [name="..."] { ... }` block (`__polyglot.by_name[...]`).
fn eval_block(block, input = nil) {
    if type(block) != "map" or not map_has(block, "lang") or not map_has(block, "code") {
        return _failure("eval_block requires a @lang polyglot block map with { lang, code }", "");
    }
    return UNIVERSAL.eval_native(block.lang, block.code, input);
}

fn describe_language(lang) { return UNIVERSAL.describe_language(lang); }
fn catalog_summary() { return UNIVERSAL.catalog_summary(); }
fn universal_languages() { return UNIVERSAL.all_universal_ids(); }

export run_block;
export exec;
export exec_with_input;
export exec_compiled;
export detect;
export run;
export compile;
export compile_cached;
export cache_clear;
export cache_info;
export supported_languages;
export all_languages, is_supported, language_count;
export eval_native, eval_block, describe_language, catalog_summary, universal_languages;
