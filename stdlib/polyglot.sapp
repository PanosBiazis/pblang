// stdlib/polyglot.sapp — fail-closed compatibility facade for PBLang polyglot.
// Foreign source execution requires allow_exec plus a hash-bound
// unsafe_polyglot=true acknowledgement and trusted_source=true.

let REGISTRY = import("stdlib:polyglot_registry.sapp");
let UNIVERSAL = import("stdlib:polyglot_universal.sapp");

fn _failure(message, lang = "") {
    return map{ format: "pblang.polyglot-compat.v2", ok: false, complete: false,
        executed: false, bounded: false, sandboxed: false, effects_confined: false,
        raw_fallback: false, trusted_source_required: true, language: str(lang),
        unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: false,
        stdout: "", stderr: message, error: message, exit_code: -1,
        timed_out: false, output_truncated: false };
}

// Run a code block in the given language via subprocess.
// lang: "python", "python3", "node", "bash", "ruby", "perl"
// src: source code string
// Returns map{ ok, stdout, stderr, exit_code }
fn run_block(lang, src, options = nil) { return REGISTRY.run(lang, src, options); }

// ── Bounded PBLang wrappers ──────────────────────────────────────────────────
// All execution flows through polyglot_registry and its fixed, descriptor-held
// process backend. The facade never calls the raw polyglot_* VM builtins.

// Run an interpreted-language snippet via the in-VM subprocess bridge.
// Supported: python, js (node), bash, ruby, perl, lua, php, r.
fn exec(lang, code, options = nil) { return REGISTRY.run(lang, code, options); }

// Same as exec but feeds `input` to the subprocess's stdin. Lets a polyglot
// block act as a stdin → stdout filter.
fn exec_with_input(lang, code, input, options = nil) {
    return REGISTRY.run_with_input(lang, code, input, options);
}

// Compile-and-run for compiled languages: rust, go, c, cpp, zig, java, typescript.
// Uses a temp dir + the right host compiler/runtime, captures stdout/stderr.
fn exec_compiled(lang, code, options = nil) {
    return _failure("compile-and-run is disabled; use compile() to produce a verified artifact and execute it through an isolated broker", lang);
}

// Discovery resolves names without starting them. Returned paths are inventory
