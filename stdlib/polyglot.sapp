        ],
        non_programming_markup_docs: [
            "html", "xml", "svg", "css", "markdown", "latex", "postscript", "mermaid"
        ],
        non_programming_query_grammar: [
            "sql", "graphql", "ebnf", "regex", "pddl", "pbruler"
        ],
        non_programming_hdl_cnc_music: [
            "gcode", "verilog", "vhdl", "spice", "abc_music", "wgsl"
        ],
        futuristic_quantum: [
            "openqasm", "qsharp", "cirq", "silq", "quipper"
        ],
