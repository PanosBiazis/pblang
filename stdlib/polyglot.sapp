            "snn", "photonic", "janus", "zk_r1cs", "cellular"
        ],
        web_bundle: ["html", "css", "js", "scss", "sass", "less", "svg", "xml", "json", "markdown"],
        database: ["sql", "sqlite", "postgresql", "psql", "mysql", "mariadb", "mongodb", "redis", "duckdb", "cassandra", "neo4j", "clickhouse"],
        stylesheet: ["css", "scss", "sass", "less"],
        universal_all: UNIVERSAL.all_universal_ids()
