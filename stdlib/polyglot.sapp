// stdlib/polyglot.sapp — Polyglot block execution bridge (PL1-alpha)
// Executes code in a foreign language (python, node, bash, etc.) via subprocess.
// Requires allow_exec capability.

// Run a code block in the given language via subprocess.
// lang: "python", "python3", "node", "bash", "ruby", "perl"
// src: source code string
// Returns map{ ok, stdout, stderr, exit_code }
fn run_block(lang, src) {
    // Build command based on language
    let cmd = lang;
    if lang == "python" { cmd = "python3"; }
    if lang == "js" { cmd = "node"; }
    if lang == "javascript" { cmd = "node"; }

    // Write src to a temp file and execute it
    let tmp_path = "/tmp/pblang_polyglot_" + to_string(random_float()) + "." + _ext_for_lang(lang);
    let wrote = try fs_write(tmp_path, src) catch false;
    if wrote == false {
        return map{ ok: false, stdout: "", stderr: "failed to write temp file", exit_code: -1 };
    }

    let result = try {
        let r = proc_spawn_wait(cmd, [tmp_path]);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "subprocess failed or not found" };

    try fs_remove(tmp_path) catch nil;

    let ok = result.exit_code == 0;
    return map{
        ok: ok,
        stdout: result.stdout,
        stderr: result.stderr,
        exit_code: result.exit_code
    };
}

fn _ext_for_lang(lang) {
    if lang == "python" or lang == "python3" { return "py"; }
    if lang == "node" or lang == "js" or lang == "javascript" { return "js"; }
    if lang == "ruby" { return "rb"; }
    if lang == "perl" { return "pl"; }
    return "sh";
}

fn to_string(v) {
    return str(v);
}

// ── Native-backed wrappers (PL1-beta) ────────────────────────────────────────
//
// These wrap the in-VM `polyglot_exec*` / `polyglot_detect` builtins. They
// avoid the temp-file ceremony in `run_block` above (cheaper + no /tmp
// pollution) and add coverage for compiled languages (rust/go/c/cpp/zig/java/ts)
// that `run_block` cannot reach because it assumes a single interpreter call.
//
// All return the same shape:
//   map{ ok: bool, stdout: string, stderr: string, exit_code: number }

fn _parse_result(raw) {
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot: malformed result JSON: " + raw, exit_code: -1 };
    }
    return map{
        ok: parsed.success,
        stdout: parsed.stdout,
        stderr: parsed.stderr,
        exit_code: parsed.exit_code
    };
}

// Run an interpreted-language snippet via the in-VM subprocess bridge.
// Supported: python, js (node), bash, ruby, perl, lua, php, r.
fn exec(lang, code) {
    let raw = try polyglot_exec(lang, code) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// Same as exec but feeds `input` to the subprocess's stdin. Lets a polyglot
// block act as a stdin → stdout filter.
fn exec_with_input(lang, code, input) {
    let raw = try polyglot_exec_with_input(lang, code, input) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec_with_input: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// Compile-and-run for compiled languages: rust, go, c, cpp, zig, java, typescript.
// Uses a temp dir + the right host compiler/runtime, captures stdout/stderr.
fn exec_compiled(lang, code) {
    let raw = try polyglot_exec_compiled(lang, code) catch nil;
    if raw == nil {
        return map{ ok: false, stdout: "", stderr: "polyglot.exec_compiled: not available", exit_code: -1 };
    }
    return _parse_result(raw);
}

// Probe which polyglot toolchains exist on the host PATH. Returns a map of
// lang → { available, kind ("interpreter"|"compiler"), command }.
fn detect() {
    let raw = try polyglot_detect() catch nil;
    if raw == nil {
        return map{};
    }
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil {
        return map{};
    }
    return parsed;
}

// Convenience: pick the right strategy automatically — interpreters go through
// `exec`, compiled languages go through `exec_compiled`. Useful when a caller
// has a generic @lang block without caring which path it takes.
fn run(lang, code) {
    let compiled_langs = [
        "rust", "rs",
        "go",
        "c", "cpp", "c++", "cxx",
        "zig",
        "java",
        "ts", "typescript",
        "pascal", "pas", "delphi", "freepascal",
        "kotlin", "kt",
        "nim",
        "crystal",
        "d",
        "haskell", "hs",
        "fortran", "f90", "f95", "f03", "f08", "f",
        "ada", "adb",
        "swift",
        "cobol", "cob",
        "erlang", "erl",
        "vala",
        "objc", "objective-c", "m",
        "nasm", "asm", "s",
        "gas",
        "v",
        "ocaml-compiled",
        "csharp", "cs", "c#",
        "fsharp", "fs", "fsx", "f#",
        "vb", "vbnet", "visualbasic"
    ];
    let i = 0;
    while i < len(compiled_langs) {
        if compiled_langs[i] == lang {
            return exec_compiled(lang, code);
        }
        i = i + 1;
    }
    return exec(lang, code);
}

// ── Cached cdylib loader (PL2-alpha) ─────────────────────────────────────────
//
// `compile_cached(lang, code)` compiles the given snippet to a shared
// library, caches it by content hash under ~/.cache/pblang/polyglot/,
// and returns an FFI handle. Subsequent identical calls reuse the
// cached artifact — zero subprocess overhead on warm cache.
//
// The caller is responsible for declaring C-ABI exports inside `code`:
//   rust: #[no_mangle] pub extern "C" fn foo(...) { ... }
//   c:    int foo(...) { ... }
//   cpp:  extern "C" int foo(...) { ... }
//   go:   //export Foo  (above each exported function)
//   pascal: function Foo(...): Integer; cdecl; export;
//
// Then invoke via the standard FFI:
//   let h = polyglot.compile_cached("rust", source);
//   let result = ffi_call_typed(h, "foo", "i64->i64", [42]);
//   ffi_close(h);
//
// Supported languages: rust, c, cpp, go, pascal, csharp (NativeAOT), fsharp
// (NativeAOT), zig, d, nim, swift, haskell, fortran, objc, ocaml, java
// (GraalVM native-image --shared, two-step javac+native-image), kotlin
// (Kotlin/Native -produce dynamic). All must produce a host-loadable cdylib
// / .so / .dll / .dylib.

fn compile_cached(lang, code) {
    return polyglot_compile_cached(lang, code);
}

fn cache_clear() {
    return polyglot_cache_clear();
}

fn cache_info() {
    let raw = polyglot_cache_info();
    let parsed = try json_parse(raw) catch nil;
    if parsed == nil {
        return map{ dir: "", count: 0, size_bytes: 0 };
    }
    return parsed;
}

// ── Language matrix (informational) ──────────────────────────────────────────
//
// Returns a map describing every language the bridge knows about plus how
// it's reached. Pair with `detect()` to discover what's actually installed.
fn supported_languages() {
    return map{
        interpreted: [
            "python", "js", "deno", "bash", "zsh", "fish", "powershell",
            "ruby", "perl", "raku", "lua", "php", "r",
            "tcl", "awk", "julia", "racket", "scheme", "clojure",
            "elixir", "groovy", "fennel", "ocaml", "scala",
            "csharp"
        ],
        compiled: [
            "rust", "go", "c", "cpp", "zig", "java", "kotlin", "typescript",
            "pascal", "nim", "crystal", "d", "haskell", "fortran", "ada",
            "swift", "cobol", "erlang", "vala", "objc",
            "nasm", "gas", "v", "ocaml-compiled",
            "csharp", "fsharp", "vb"
        ],
        cdylib_cached: [
            "rust", "c", "cpp", "go", "pascal",
            "csharp", "fsharp",
            "zig", "d", "nim", "swift", "haskell", "fortran", "objc", "ocaml",
            "java", "kotlin"
        ],
        web_bundle: ["html", "css", "js"]
    };
}

export run_block;
export exec;
export exec_with_input;
export exec_compiled;
export detect;
export run;
export compile_cached;
export cache_clear;
export cache_info;
export supported_languages;
