// stdlib/fs.sapp — Filesystem utilities with path validation.
//
// SECURITY: All paths are validated to prevent:
//   - Absolute paths (e.g. /etc/passwd)
//   - Parent-dir traversal (e.g. ../../etc/passwd)
//
// Use `fs.allow_absolute(true)` to opt-in to absolute paths when needed.

// _safe_path(path) — validate a path is safe (relative, no traversal).
// Returns the original path if safe, or an error string if not.
fn _safe_path(path, allow_absolute) {
    if type(path) != "string" or len(path) == 0 {
        return error("fs: path must be a non-empty string");
    }
    // Allow absolute paths only if explicitly opted-in
    if allow_absolute != true {
        if str_starts_with(path, "/") or str_starts_with(path, "\\") {
            return error("fs: absolute paths not allowed by default (got: " + path + ")");
        }
        // Detect Windows absolute paths like C:\
        if len(path) >= 3 and str_slice(path, 1, 3) == ":\\" {
            return error("fs: absolute paths not allowed by default (got: " + path + ")");
        }
    }
    // Reject embedded NUL — some C-level path APIs truncate at NUL.
    if str_index_of(path, "\x00") >= 0 {
        return error("fs: NUL byte in path");
    }
    // Normalise both separators to '/' so a mixed path like `foo/..\bar`
    // (which defeats single-separator splitting) is caught.
    let norm = str_replace_all(path, "\\", "/");
    let segs = str_split(norm, "/");
    for i len(segs) {
        if segs[i] == ".." {
            return error("fs: path traversal not allowed (got: " + path + ")");
        }
    }
    return path;
}

// --- Safe wrappers ---

fn read(path)                { let p = _safe_path(path, false); if type(p) == "string" { return fs_read(p); } return p; }
fn write(path, contents)     { let p = _safe_path(path, false); if type(p) == "string" { return fs_write(p, contents); } return p; }
fn append(path, contents)    { let p = _safe_path(path, false); if type(p) == "string" { return fs_append(p, contents); } return p; }
fn exists(path)              { let p = _safe_path(path, false); if type(p) == "string" { return fs_exists(p); } return false; }
fn mkdirs(path)              { let p = _safe_path(path, false); if type(p) == "string" { return fs_mkdirs(p); } return p; }
fn listdir(path)             { let p = _safe_path(path, false); if type(p) == "string" { return fs_listdir(p); } return []; }
fn remove(path)              { let p = _safe_path(path, false); if type(p) == "string" { return fs_remove(p); } return p; }
fn rename(from, to)          { let pf = _safe_path(from, false); let pt = _safe_path(to, false); if type(pf) == "string" and type(pt) == "string" { return fs_rename(pf, pt); } return error("fs.rename: invalid paths"); }
fn copy(from, to)            { let pf = _safe_path(from, false); let pt = _safe_path(to, false); if type(pf) == "string" and type(pt) == "string" { return fs_copy(pf, pt); } return error("fs.copy: invalid paths"); }
fn read_bytes(path)          { let p = _safe_path(path, false); if type(p) == "string" { return fs_read_bytes(p); } return p; }
fn write_bytes(path, bytes)  { let p = _safe_path(path, false); if type(p) == "string" { return fs_write_bytes(p, bytes); } return p; }

// --- Absolute-path variants (opt-in) ---

fn read_abs(path)                { return fs_read(path); }
fn write_abs(path, contents)     { return fs_write(path, contents); }
fn append_abs(path, contents)    { return fs_append(path, contents); }
fn exists_abs(path)              { return fs_exists(path); }
fn listdir_abs(path)             { return fs_listdir(path); }
fn remove_abs(path)              { return fs_remove(path); }
fn read_bytes_abs(path)          { return fs_read_bytes(path); }
fn write_bytes_abs(path, bytes)  { return fs_write_bytes(path, bytes); }

// --- Convenience helpers ---

// read_json(path) — read a JSON file and parse it
fn read_json(path) {
    let raw = read(path);
    if type(raw) != "string" { return raw; }
    return json_parse(raw);
}

// write_json(path, value) — stringify and write JSON
fn write_json(path, value) {
    let s = json_stringify(value);
    return write(path, s);
}

// read_lines(path) — read file and split into lines
fn read_lines(path) {
    let raw = read(path);
    if type(raw) != "string" { return raw; }
    return str_split(raw, "\n");
}

// write_lines(path, lines) — join lines with newline and write
fn write_lines(path, lines) {
    let out = "";
    for i len(lines) {
        if i > 0 { out = out + "\n"; }
        out = out + lines[i];
    }
    return write(path, out);
}

// size(path) — return file size in bytes (via read_bytes length)
fn size(path) {
    let b = read_bytes(path);
    if type(b) == "array" { return len(b); }
    return nil;
}

// append_line(path, line) — append a line plus a trailing newline.
fn append_line(path, line) { return append(path, line + "\n"); }

// touch(path) — create an empty file if it does not exist; returns true.
fn touch(path) {
    if exists(path) != true { write(path, ""); }
    return true;
}

// is_empty(path) — true if the file is missing or zero-length.
fn is_empty(path) {
    if exists(path) != true { return true; }
    return size(path) == 0;
}

// read_or(path, default) — file contents, or `default` if it can't be read.
fn read_or(path, default) {
    if exists(path) != true { return default; }
    let raw = read(path);
    if type(raw) != "string" { return default; }
    return raw;
}

// count_lines(path) — number of lines, ignoring a single trailing newline.
fn count_lines(path) {
    let raw = read(path);
    if type(raw) != "string" or raw == "" { return 0; }
    let lines = str_split(raw, "\n");
    if len(lines) > 0 and lines[len(lines) - 1] == "" {
        return len(lines) - 1;
    }
    return len(lines);
}

// walk(dir) — recursively list every file path under dir (directories descended into,
// not themselves listed). Safe wrappers apply, so dir must be relative.
fn walk(dir) {
    let out = [];
    let entries = try listdir(dir) catch [];
    if type(entries) != "array" { return out; }
    let i = 0;
    while i < len(entries) {
        let full = dir + "/" + entries[i];
        let sub = try listdir(full) catch nil;   // listable -> directory
        if type(sub) == "array" {
            let children = walk(full);
            let j = 0;
            while j < len(children) { array_push(out, children[j]); j = j + 1; }
        } else {
            array_push(out, full);
        }
        i = i + 1;
    }
    return out;
}

// read_json_or(path, default) — parsed JSON, or `default` if missing/invalid.
fn read_json_or(path, default) {
    if exists(path) != true { return default; }
    let v = try read_json(path) catch nil;
    if v == nil { return default; }
    return v;
}

export read, write, append, exists, mkdirs, listdir, remove, rename, copy,
       read_bytes, write_bytes,
       read_abs, write_abs, append_abs, exists_abs, listdir_abs, remove_abs,
       read_bytes_abs, write_bytes_abs,
       read_json, write_json, read_lines, write_lines, size,
       append_line, touch, is_empty, read_or, count_lines,
       walk, read_json_or;
