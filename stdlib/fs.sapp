// stdlib/fs.sapp

fn read(path) { return fs_read(path); }
fn write(path, contents) { return fs_write(path, contents); }
fn append(path, contents) { return fs_append(path, contents); }

fn exists(path) { return fs_exists(path); }
fn mkdirs(path) { return fs_mkdirs(path); }
fn listdir(path) { return fs_listdir(path); }

fn remove(path) { return fs_remove(path); }
fn rename(from, to) { return fs_rename(from, to); }
fn copy(from, to) { return fs_copy(from, to); }

fn read_bytes(path) { return fs_read_bytes(path); }
fn write_bytes(path, bytes) { return fs_write_bytes(path, bytes); }

export read, write, append, exists, mkdirs, listdir, remove, rename, copy, read_bytes, write_bytes;

