// stdlib/orm.sapp — Lightweight ORM / Query Builder for pblang.
//
// Provides an ActiveRecord-style ORM backed by SQLite (via stdlib:db.sapp).
//
// Usage:
//   let orm = import("stdlib:orm.sapp");
//   let db = orm.connect("./app.db");
//   orm.define_model(db, "User", ["id INTEGER PRIMARY KEY", "name TEXT NOT NULL", "email TEXT UNIQUE"]);
//   let id = orm.insert(db, "User", map{ name: "Alice", email: "alice@example.com" });
//   let user = orm.find_by_id(db, "User", id);
//   let users = orm.find_where(db, "User", "name = ?", ["Alice"]);
//   orm.update(db, "User", id, map{ name: "Alice Smith" });
//   orm.delete(db, "User", id);

let db_mod = import("stdlib:db.sapp");

// connect(path) — open a database connection
fn connect(path) {
    return db_mod.sqlite.open(path);
}

// define_model(conn, table_name, columns) — create table if not exists.
// columns: array of SQL column definitions like "id INTEGER PRIMARY KEY"
fn define_model(conn, table_name, columns) {
    let cols_sql = "";
    for i len(columns) {
        if i > 0 { cols_sql = cols_sql + ", "; }
        cols_sql = cols_sql + columns[i];
    }
    let sql = "CREATE TABLE IF NOT EXISTS " + table_name + " (" + cols_sql + ")";
    return conn.exec(sql, []);
}

// insert(conn, table, data_map) — insert a row. Returns last insert rowid.
fn insert(conn, table, data_map) {
    let keys = map_keys(data_map);
    let cols = "";
    let placeholders = "";
    let vals = [];
    for i len(keys) {
        if i > 0 {
            cols = cols + ", ";
            placeholders = placeholders + ", ";
        }
        cols = cols + keys[i];
        placeholders = placeholders + "?";
        vals[i] = data_map[keys[i]];
    }
    let sql = "INSERT INTO " + table + " (" + cols + ") VALUES (" + placeholders + ")";
    conn.exec(sql, vals);
    return conn.last_insert_rowid();
}

// find_by_id(conn, table, id) — find a single row by primary key 'id'
fn find_by_id(conn, table, id) {
    let rows = conn.query("SELECT * FROM " + table + " WHERE id = ? LIMIT 1", [id]);
    if type(rows) != "array" or len(rows) == 0 { return nil; }
    return rows[0];
}

// find_where(conn, table, where_clause, params) — query with WHERE clause
// where_clause: SQL like "name = ? AND active = ?"
// params: array of values for the ? placeholders
fn find_where(conn, table, where_clause, params) {
    let sql = "SELECT * FROM " + table;
    if where_clause != nil and where_clause != "" {
        sql = sql + " WHERE " + where_clause;
    }
    if params == nil { params = []; }
    return conn.query(sql, params);
}

// find_all(conn, table) — select all rows
fn find_all(conn, table) {
    return conn.query("SELECT * FROM " + table, []);
}

// find_one(conn, table, where_clause, params) — return first matching row or nil
fn find_one(conn, table, where_clause, params) {
    let rows = find_where(conn, table, where_clause, params);
    if type(rows) != "array" or len(rows) == 0 { return nil; }
    return rows[0];
}

// update(conn, table, id, data_map) — update row by id
fn update(conn, table, id, data_map) {
    let keys = map_keys(data_map);
    if len(keys) == 0 { return nil; }
    let set_clause = "";
    let vals = [];
    for i len(keys) {
        if i > 0 { set_clause = set_clause + ", "; }
        set_clause = set_clause + keys[i] + " = ?";
        vals[i] = data_map[keys[i]];
    }
    vals[len(vals)] = id;
    let sql = "UPDATE " + table + " SET " + set_clause + " WHERE id = ?";
    return conn.exec(sql, vals);
}

// delete(conn, table, id) — delete row by id
fn delete(conn, table, id) {
    return conn.exec("DELETE FROM " + table + " WHERE id = ?", [id]);
}

// delete_where(conn, table, where_clause, params) — delete matching rows
fn delete_where(conn, table, where_clause, params) {
    if params == nil { params = []; }
    return conn.exec("DELETE FROM " + table + " WHERE " + where_clause, params);
}

// count(conn, table) — count all rows in table
fn count(conn, table) {
    let rows = conn.query("SELECT COUNT(*) as n FROM " + table, []);
    if type(rows) != "array" or len(rows) == 0 { return 0; }
    return try rows[0].n catch 0;
}

// count_where(conn, table, where_clause, params) — count matching rows
fn count_where(conn, table, where_clause, params) {
    if params == nil { params = []; }
    let rows = conn.query("SELECT COUNT(*) as n FROM " + table + " WHERE " + where_clause, params);
    if type(rows) != "array" or len(rows) == 0 { return 0; }
    return try rows[0].n catch 0;
}

// exists_where(conn, table, where_clause, params) — true if any row matches
fn exists_where(conn, table, where_clause, params) {
    return count_where(conn, table, where_clause, params) > 0;
}

// paginate(conn, table, page, per_page) — return paginated results
fn paginate(conn, table, page, per_page) {
    if page < 1 { page = 1; }
    if per_page < 1 { per_page = 10; }
    let offset = (page - 1) * per_page;
    let rows = conn.query("SELECT * FROM " + table + " LIMIT ? OFFSET ?", [per_page, offset]);
    let total = count(conn, table);
    return map{
        rows: rows,
        page: page,
        per_page: per_page,
        total: total,
        total_pages: (total + per_page - 1) / per_page
    };
}

// transaction(conn, fn) — run fn inside a transaction; rollback on error
fn transaction(conn, fn_) {
    conn.exec("BEGIN", []);
    let result = try fn_() catch nil;
    if result == nil {
        conn.exec("ROLLBACK", []);
        return error("orm.transaction: rolled back");
    }
    conn.exec("COMMIT", []);
    return result;
}

// raw_query(conn, sql, params) — execute raw SQL query
fn raw_query(conn, sql, params) {
    if params == nil { params = []; }
    return conn.query(sql, params);
}

// raw_exec(conn, sql, params) — execute raw SQL statement
fn raw_exec(conn, sql, params) {
    if params == nil { params = []; }
    return conn.exec(sql, params);
}

export connect, define_model, insert, find_by_id, find_where, find_all, find_one,
       update, delete, delete_where, count, count_where, exists_where, paginate,
       transaction, raw_query, raw_exec;
