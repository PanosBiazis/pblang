// stdlib/orm.sapp — Lightweight ORM / Query Builder for pblang.
//
// Provides an ActiveRecord-style ORM backed by SQLite (via stdlib:db.sapp).
//
// Usage:
//   let orm = import("stdlib:orm.sapp");
//   let db = orm.connect("./app.db");
//   orm.define_model(db, "User", ["id INTEGER PRIMARY KEY", "name TEXT NOT NULL", "email TEXT UNIQUE"]);
//   let id = orm.insert(db, "User", map{ name: "Alice", email: "alice@example.com" });
//   let user = orm.find_by_id(db, "User", id);
//   let users = orm.find_where(db, "User", "name = ?", ["Alice"]);
//   orm.update(db, "User", id, map{ name: "Alice Smith" });
//   orm.delete(db, "User", id);

let db_mod = import("stdlib:db.sapp");

// _safe_ident(name) — validate a SQL identifier (table / column name).
// Parameter placeholders (?) only protect *values*; identifiers go into the
// SQL string by concatenation, so a hostile `table` or column key would be
// a direct SQL-injection vector. Reject anything that isn't a plain
// [A-Za-z_][A-Za-z0-9_]* identifier (also caps length at 64 chars).
fn _safe_ident(name) {
    if type(name) != "string" {
        return error("orm: identifier must be a string, got " + type(name));
    }
    let n = len(name);
    if n == 0 or n > 64 {
        return error("orm: identifier length must be 1..=64, got " + str(n));
    }
    let i = 0;
    while i < n {
        let code = strcharcodeat(name, i);
        let is_alpha = (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95;
        let is_digit = code >= 48 and code <= 57;
        if i == 0 {
            if not is_alpha {
                return error("orm: identifier must start with letter or '_': " + name);
            }
        } else {
            if not (is_alpha or is_digit) {
                return error("orm: identifier contains invalid char at " + str(i) + ": " + name);
            }
        }
        i = i + 1;
    }
    return name;
}

// _safe_ident_cols(keys) — validate every key in a map-keys array.
// Returns the same array if all are valid; throws otherwise.
fn _safe_ident_cols(keys) {
    let i = 0;
    while i < len(keys) {
        _safe_ident(keys[i]);
        i = i + 1;
    }
    return keys;
}

// connect(path) — open a database connection
fn connect(path) {
    return db_mod.sqlite.open(path);
}

// define_model(conn, table_name, columns) — create table if not exists.
// columns: array of SQL column definitions like "id INTEGER PRIMARY KEY"
// The table_name is validated; column defs are raw SQL by design (developer
// authored, never user input — document this contract clearly).
fn define_model(conn, table_name, columns) {
    _safe_ident(table_name);
    let cols_sql = "";
    for i len(columns) {
        if i > 0 { cols_sql = cols_sql + ", "; }
        cols_sql = cols_sql + columns[i];
    }
    let sql = "CREATE TABLE IF NOT EXISTS " + table_name + " (" + cols_sql + ")";
    return conn.exec(sql, []);
}

// insert(conn, table, data_map) — insert a row. Returns last insert rowid.
fn insert(conn, table, data_map) {
    _safe_ident(table);
    let keys = map_keys(data_map);
    _safe_ident_cols(keys);
    let cols = "";
    let placeholders = "";
    let vals = [];
    if len(keys) <= 8 {
        // Avoid extra joining overhead on ordinary small rows.
        for i len(keys) {
            if i > 0 { cols = cols + ", "; placeholders = placeholders + ", "; }
            cols = cols + keys[i];
            placeholders = placeholders + "?";
            vals[i] = data_map[keys[i]];
        }
    } else {
        cols = str_join(keys, ", ");
        // map_keys returns a private array: reuse it after collecting column text.
        for i len(keys) {
            vals[i] = data_map[keys[i]];
            keys[i] = "?";
        }
        placeholders = str_join(keys, ", ");
    }
    let sql = "INSERT INTO " + table + " (" + cols + ") VALUES (" + placeholders + ")";
    conn.exec(sql, vals);
    return conn.last_insert_rowid();
}

// find_by_id(conn, table, id) — find a single row by primary key 'id'
fn find_by_id(conn, table, id) {
    _safe_ident(table);
    let rows = conn.query("SELECT * FROM " + table + " WHERE id = ? LIMIT 1", [id]);
    if type(rows) != "array" or len(rows) == 0 { return nil; }
    return rows[0];
}

// find_where(conn, table, where_clause, params) — query with WHERE clause
// where_clause: SQL like "name = ? AND active = ?"
// params: array of values for the ? placeholders
fn find_where(conn, table, where_clause, params = nil) {
    _safe_ident(table);
    let sql = "SELECT * FROM " + table;
    if where_clause != nil and where_clause != "" {
        sql = sql + " WHERE " + where_clause;
    }
    if params == nil { params = []; }
    return conn.query(sql, params);
}

// find_all(conn, table) — select all rows
fn find_all(conn, table) {
    _safe_ident(table);
    return conn.query("SELECT * FROM " + table, []);
}

// find_one(conn, table, where_clause, params) — return first matching row or nil
fn find_one(conn, table, where_clause, params) {
    let rows = find_where(conn, table, where_clause, params);
    if type(rows) != "array" or len(rows) == 0 { return nil; }
    return rows[0];
}

// _order_safe(clause) — validate an ORDER BY clause built from identifiers.
// Allows "col", "col ASC", "col DESC", comma-separated. Rejects anything else so
// a hostile order string can't inject SQL.
fn _order_safe(clause) {
    if type(clause) != "string" { throw "orm: invalid order clause"; }
    let parts = str_split(clause, ",");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        let toks = str_split(p, " ");
        if len(toks) < 1 or len(toks) > 2 { throw "orm: invalid order clause"; }
        let identifier = try _safe_ident(toks[0]) catch nil;
        if identifier == nil { throw "orm: invalid order clause"; }
        if len(toks) == 2 {
            let dir = str_upper(toks[1]);
            if dir != "ASC" and dir != "DESC" { throw "orm: invalid order clause"; }
        }
        i = i + 1;
    }
    return clause;
}

// find(conn, table, opts) — flexible select. opts (all optional):
//   { where: "age > ?", params: [...], order: "age DESC", limit: n, offset: n }
fn find(conn, table, opts = nil) {
    _safe_ident(table);
    if opts == nil { opts = map{}; }
    let sql = "SELECT * FROM " + table;
    let params = try opts.params catch nil;
    if params == nil { params = []; }
    let where = try opts.where catch nil;
    if where != nil and where != "" { sql = sql + " WHERE " + where; }
    let order = try opts.order catch nil;
    if order != nil and order != "" { sql = sql + " ORDER BY " + _order_safe(order); }
    let limit = try opts.limit catch nil;
    if limit != nil { sql = sql + " LIMIT " + str(num_floor(limit)); }
    let offset = try opts.offset catch nil;
    if offset != nil { sql = sql + " OFFSET " + str(num_floor(offset)); }
    return conn.query(sql, params);
}

// pluck(conn, table, column, opts) — return a single column as an array.
fn pluck(conn, table, column, opts = nil) {
    _safe_ident(column);
    let rows = find(conn, table, opts);
    let out = [];
    let i = 0;
    while i < len(rows) { out[len(out)] = try rows[i][column] catch nil; i = i + 1; }
    return out;
}

// update_where(conn, table, set_map, where_clause, params) — bulk update matching
// rows. Returns the underlying exec result.
fn update_where(conn, table, set_map, where_clause, params = nil) {
    _safe_ident(table);
    let keys = map_keys(set_map);
    _safe_ident_cols(keys);
    if len(keys) == 0 { return nil; }
    let set_clause = "";
    let vals = [];
    for i len(keys) {
        if i > 0 { set_clause = set_clause + ", "; }
        set_clause = set_clause + keys[i] + " = ?";
        vals[i] = set_map[keys[i]];
    }
    if params == nil { params = []; }
    let pi = 0;
    while pi < len(params) { vals[len(vals)] = params[pi]; pi = pi + 1; }
    let sql = "UPDATE " + table + " SET " + set_clause;
    if where_clause != nil and where_clause != "" { sql = sql + " WHERE " + where_clause; }
    return conn.exec(sql, vals);
}

// upsert(conn, table, data_map) — INSERT OR REPLACE a full row (data_map should
// include the primary key for the "replace" path). Returns last insert rowid.
fn upsert(conn, table, data_map) {
    _safe_ident(table);
    let keys = map_keys(data_map);
    _safe_ident_cols(keys);
    let cols = "";
    let placeholders = "";
    let vals = [];
    if len(keys) <= 8 {
        // Avoid extra joining overhead on ordinary small rows.
        for i len(keys) {
            if i > 0 { cols = cols + ", "; placeholders = placeholders + ", "; }
            cols = cols + keys[i];
            placeholders = placeholders + "?";
            vals[i] = data_map[keys[i]];
        }
    } else {
        cols = str_join(keys, ", ");
        // map_keys returns a private array: reuse it after collecting column text.
        for i len(keys) {
            vals[i] = data_map[keys[i]];
            keys[i] = "?";
        }
        placeholders = str_join(keys, ", ");
    }
    let sql = "INSERT OR REPLACE INTO " + table + " (" + cols + ") VALUES (" + placeholders + ")";
    conn.exec(sql, vals);
    return conn.last_insert_rowid();
}

// update(conn, table, id, data_map) — update row by id
fn update(conn, table, id, data_map) {
    _safe_ident(table);
    let keys = map_keys(data_map);
    _safe_ident_cols(keys);
    if len(keys) == 0 { return nil; }
    let set_clause = "";
    let vals = [];
    for i len(keys) {
        if i > 0 { set_clause = set_clause + ", "; }
        set_clause = set_clause + keys[i] + " = ?";
        vals[i] = data_map[keys[i]];
    }
    vals[len(vals)] = id;
    let sql = "UPDATE " + table + " SET " + set_clause + " WHERE id = ?";
    return conn.exec(sql, vals);
}

// delete(conn, table, id) — delete row by id
fn delete(conn, table, id) {
    _safe_ident(table);
    return conn.exec("DELETE FROM " + table + " WHERE id = ?", [id]);
}

// delete_where(conn, table, where_clause, params) — delete matching rows
fn delete_where(conn, table, where_clause, params = nil) {
    _safe_ident(table);
    if params == nil { params = []; }
    return conn.exec("DELETE FROM " + table + " WHERE " + where_clause, params);
}

// count(conn, table) — count all rows in table
fn count(conn, table) {
    _safe_ident(table);
    let rows = conn.query("SELECT COUNT(*) as n FROM " + table, []);
    if type(rows) != "array" or len(rows) == 0 { return 0; }
    return try rows[0].n catch 0;
}

// count_where(conn, table, where_clause, params) — count matching rows
fn count_where(conn, table, where_clause, params = nil) {
    _safe_ident(table);
    if params == nil { params = []; }
    let rows = conn.query("SELECT COUNT(*) as n FROM " + table + " WHERE " + where_clause, params);
    if type(rows) != "array" or len(rows) == 0 { return 0; }
    return try rows[0].n catch 0;
}

// exists_where(conn, table, where_clause, params) — true if any row matches
fn exists_where(conn, table, where_clause, params) {
    return count_where(conn, table, where_clause, params) > 0;
}

// paginate(conn, table, page, per_page) — return paginated results
fn paginate(conn, table, page, per_page) {
    _safe_ident(table);
    if page < 1 { page = 1; }
    if per_page < 1 { per_page = 10; }
    let offset = (page - 1) * per_page;
    let rows = conn.query("SELECT * FROM " + table + " LIMIT ? OFFSET ?", [per_page, offset]);
    let total = count(conn, table);
    return map{
        rows: rows,
        page: page,
        per_page: per_page,
        total: total,
        total_pages: (total + per_page - 1) / per_page
    };
}

// transaction(conn, fn) — run fn inside a transaction; rollback on error
fn transaction(conn, fn_) {
    conn.exec("BEGIN", []);
    let result = try fn_() catch nil;
    if result == nil {
        conn.exec("ROLLBACK", []);
        return error("orm.transaction: rolled back");
    }
    conn.exec("COMMIT", []);
    return result;
}

// tx(conn, fn_) — modern transaction: passes the connection to fn_, and ONLY
// a thrown error rolls back (nil is a legitimate result — transaction() above
// would silently roll it back). Returns map{ ok: true, value } on commit or
// map{ ok: false } after rollback.
fn tx(conn, fn_) {
    conn.exec("BEGIN", []);
    let r = try map{ ok: true, value: fn_(conn) } catch map{ ok: false };
    if r.ok { conn.exec("COMMIT", []); } else { conn.exec("ROLLBACK", []); }
    return r;
}

fn _insert_all(conn, table, rows) {
    let n = 0;
    let i = 0;
    while i < len(rows) {
        insert(conn, table, rows[i]);
        n = n + 1;
        i = i + 1;
    }
    return n;
}

// insert_many(conn, table, rows) — atomic batch insert: all rows or none
// (one bad row rolls the whole batch back). Returns map{ ok, value: count }.
fn insert_many(conn, table, rows) {
    conn.exec("BEGIN", []);
    let r = try map{ ok: true, value: _insert_all(conn, table, rows) } catch map{ ok: false };
    if r.ok { conn.exec("COMMIT", []); } else { conn.exec("ROLLBACK", []); }
    return r;
}

// raw_query(conn, sql, params) — execute raw SQL query
fn raw_query(conn, sql, params = nil) {
    if params == nil { params = []; }
    return conn.query(sql, params);
}

// raw_exec(conn, sql, params) — execute raw SQL statement
fn raw_exec(conn, sql, params = nil) {
    if params == nil { params = []; }
    return conn.exec(sql, params);
}

export connect, define_model, insert, insert_many, find, find_by_id, find_where, find_all,
       find_one, pluck, update, update_where, upsert, delete, delete_where, count,
       count_where, exists_where, paginate, transaction, tx, raw_query, raw_exec;
