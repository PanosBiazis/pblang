let Tables=import("stdlib:table_files.sapp");let Reshape=import("stdlib:table_reshape.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn open(path,action,columns=nil,delimiter=",") {
    let loaded=Tables.open(path,delimiter);if not loaded.ok {return loaded;}
    let doc=try Reshape.apply(loaded.document,action,columns) catch nil;
    if doc==nil {return map{ok:false,error:"Invalid reshape settings, headers or output limits. Source unchanged."};}
    return map{ok:true,document:doc};
}
fn save(path,doc,delimiter=",") {
    if type(path)!="string" {return map{ok:false,error:"Choose a new output filename."};}
    return Tables.save(path,doc,if str_ends_with(str_lower(path),".pbsheet") {"sheet"} else {"csv"},delimiter);
}
fn run(input,output,action,columns=nil,delimiter=",") {
    let result=open(input,action,columns,delimiter);if not result.ok {return result;}
    let saved=save(output,result.document,delimiter);if not saved.ok {return saved;}
    let size=Sheet.validate(result.document);return map{ok:true,rows:size.rows,columns:size.columns,atomic_visibility:false};
}
export open,save,run;
