// Data-only form diagnostics shared by CLI, IDE and MCP integrations.
// No source code, labels, values, paths, component names or handler names in reports.
let DFM=import("stdlib:ui_form_delphi_dfm.sapp");
let Web=import("stdlib:ui_form_web_document.sapp");
fn analyze_dfm(source) {
    let imported=DFM.import_text(source, "input.dfm");
    if not imported.ok {
        return map{format:"pblang.form-check.v1", ok:false, stage:"import", error:imported.error,
            renderable:false, conversion_complete:false, production_ready:false};
    }
    let preview=Web.inspect(imported.document);
    let report=map{format:"pblang.form-check.v1", ok:preview.ok, stage:"web-preflight", renderable:preview.ok,
        source_format:"delphi-dfm", widgets:imported.widget_count,
        import_lossy:imported.lossy, unmapped_properties:imported.unmapped_property_count,
        unmapped_events:imported.unmapped_event_count, external_reference_present:imported.external_reference_present,
        conversion_complete:false, production_ready:false, source_executed:false, source_content_included:false};
    if preview.ok {
        report.buttons=preview.buttons;report.input_fields=preview.input_fields;
        report.imported_handlers=preview.imported_handlers;
        report.requires_explicit_actions=preview.buttons > 0 or preview.imported_handlers > 0 or imported.unmapped_event_count > 0;
        report.layout_preserved=false;
    } else {report.error=preview.error;}
    return report;
}
export analyze_dfm;
