// Editable relative-time agenda. No clock, calendar, notifications or execution.
let Intervals=import("stdlib:interval_analysis.sapp"); let Serialization=import("stdlib:serialization.sapp");
let FORMAT="pblang.timeline.v1"; let MAX_ENTRIES=64; let MAX_FILE_BYTES=65536;
fn _keys(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } } return true;
}
fn _text(value) {
    if type(value)!="string" or str_trim(value)=="" or len(value)>80 or len(str_to_bytes(value))>256 { throw "timeline: expected a short nonblank title"; }
    for i in range(0,len(value)) { let c=strcharcodeat(value,i); if c<32 or c==127 { throw "timeline: unsupported control character"; } }
}
fn _index(value,maximum) {
    if type(value)!="number" or not (value>=0 and value<=maximum) or value!=num_floor(value) { throw "timeline: invalid index"; }
}
fn validate(doc) {
    if not _keys(doc,["format","title","entries"]) or doc.format!=FORMAT or type(doc.entries)!="array" or len(doc.entries)<1 or len(doc.entries)>MAX_ENTRIES { throw "timeline: invalid document"; }
    _text(doc.title); let intervals=[];
    for item in doc.entries {
        if not _keys(item,["label","start_ms","end_ms"]) { throw "timeline: invalid entry"; }
        _text(item.label); array_push(intervals,map{start_ms:item.start_ms,end_ms:item.end_ms});
    }
    Intervals.validate(intervals); return true;
}
fn copy(doc) {
    validate(doc); let entries=[];
    for item in doc.entries { array_push(entries,map{label:item.label,start_ms:item.start_ms,end_ms:item.end_ms}); }
    return map{format:FORMAT,title:doc.title,entries:entries};
}
fn create(title="New timeline") { let doc=map{format:FORMAT,title:title,entries:[map{label:"First activity",start_ms:0,end_ms:60000}]}; validate(doc); return doc; }
fn set_entry(doc,index,label,start_ms,end_ms) {
    let out=copy(doc); _index(index,len(out.entries)-1); out.entries[index]=map{label:label,start_ms:start_ms,end_ms:end_ms}; validate(out); return out;
}
fn append(doc,label,start_ms,end_ms) {
    let out=copy(doc); if len(out.entries)>=MAX_ENTRIES { throw "timeline: entry limit"; }
    array_push(out.entries,map{label:label,start_ms:start_ms,end_ms:end_ms}); validate(out); return out;
}
fn remove(doc,index) {
    let out=copy(doc); _index(index,len(out.entries)-1); if len(out.entries)==1 { throw "timeline: one entry required"; }
    let entries=[]; for i in range(0,len(out.entries)) { if i!=index { array_push(entries,out.entries[i]); } } out.entries=entries; return out;
}
fn rename(doc,title) { let out=copy(doc); _text(title); out.title=title; return out; }
fn analyze(doc) {
    validate(doc); let intervals=[];
    for item in doc.entries { array_push(intervals,map{start_ms:item.start_ms,end_ms:item.end_ms}); } return Intervals.analyze(intervals);
}
fn _limits() { return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:1024,strict:true,reject_duplicate_keys:true}; }
fn encode(doc) { let r=Serialization.stringify_safe(copy(doc),"json",_limits()); if not r.ok { throw "timeline: encoding failed"; } return r.value; }
fn decode(text) { let r=Serialization.parse_safe(text,"json",_limits()); if not r.ok or not r.duplicate_keys_checked { throw "timeline: invalid file"; } return copy(r.value); }
export FORMAT,MAX_ENTRIES,MAX_FILE_BYTES,validate,copy,create,set_entry,append,remove,rename,analyze,encode,decode;
