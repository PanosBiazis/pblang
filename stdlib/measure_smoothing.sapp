let Measure=import("stdlib:measure_document.sapp");let Smooth=import("stdlib:smoothing_table.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn create(doc,count){let values=Measure.results(doc);let unit=doc.rows[0].to;let mode=doc.rows[0].mode;let labels=[];
 for row in doc.rows {if row.to!=unit or row.mode!=mode {throw "smoothing requires identical target symbols and modes";}array_push(labels,row.label);}
 let report=Smooth.create(labels,values,count);array_push(report.document.cells[0],"Unit");array_push(report.document.cells[0],"Mode");
 for i in range(1,len(report.document.cells)){array_push(report.document.cells[i],unit);array_push(report.document.cells[i],mode);}Sheet.validate(report.document);return report;
}
export create;
