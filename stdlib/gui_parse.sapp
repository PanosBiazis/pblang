// stdlib/gui_parse.sapp — parse generated pblang desktop-GUI code back into a design tree.
//
// The DESKTOP ROUND-TRIP (Visual_Designer.md D3, the D1 analogue): the designer generates
// a gui.sapp app (gui.form + gui.add(form, gui.<kind>(...)) calls); this reads that pblang
// back — via the SELF-HOSTED parser (stdlib/compiler/) — into the form + widget list the
// canvas renders, so hand-edited code and drag-authored design stay in sync. The inverse
// of dzGenDesktop's codegen. All pblang.
//
//   let G = import("stdlib/gui_parse.sapp");
//   let design = G.parse(generatedCode);   // -> { form: {title,w,h}, widgets: [ {kind,name,x,y,w,h,props,events?}, … ] }
//
// Recognizes the gui.* constructor shapes the designer emits (label/button/textbox/
// checkbox/panel) and recovers wired handlers (button->click, checkbox->change).

let _tok = import("stdlib/compiler/tokenizer.sapp");
let _par = import("stdlib/compiler/parser.sapp");

// metrics mirror stdlib/gui.sapp so auto-sized widgets (label/checkbox) round-trip with a
// box matching how gui.sapp draws them (label/checkbox don't emit w/h in codegen).
let _CW = 12;
let _CH = 16;

fn _s(a) { if a != nil and (try a.kind catch "") == "string" { return a.value; } return ""; }
// number-literal nodes store their value as the source TEXT (e.g. "500"), so coerce to a
// real number — otherwise round-tripped geometry would be strings, not ints.
fn _n(a) {
    if a == nil or (try a.kind catch "") != "number" { return 0; }
    return try parse_number(a.value) catch 0;
}
fn _bool(a) { if a != nil and (try a.kind catch "") == "bool" { return a.value; } return false; }
fn _ident(a) {                              // handler identifier, or "" for nil / anything else
    if a != nil and (try a.kind catch "") == "ident" { return a.name; }
    return "";
}
fn _strings(a) {                            // array-literal node -> list of its string values
    let out = [];
    if a == nil or (try a.kind catch "") != "array" { return out; }
    let items = try a.items catch [];
    let i = 0;
    while i < len(items) { push(out, _s(items[i])); i = i + 1; }
    return out;
}
// map-literal node -> a real map (string/number/bool values). Used for gui.set_model(...).
fn _map_from_node(node) {
    let m = map{};
    if node == nil or (try node.kind catch "") != "map" { return m; }
    let entries = try node.entries catch [];
    let i = 0;
    while i < len(entries) {
        let key = try entries[i].key catch "";
        let v = entries[i].value;
        let vk = try v.kind catch "";
        if vk == "string" { m[key] = v.value; }
        else if vk == "number" { m[key] = try parse_number(v.value) catch 0; }
        else if vk == "bool" { m[key] = v.value; }
        i = i + 1;
    }
    return m;
}

// is `call` a `gui.<method>(...)` call?
fn _is_gui(call, method) {
    if (try call.kind catch "") != "call" { return false; }
    if (try call.func.obj.name catch "") != "gui" { return false; }
    return (try call.func.name catch "") == method;
}

fn _widget_from_call(c) {
    if (try c.kind catch "") != "call" { return nil; }
    let m = try c.func.name catch "";
    let a = try c.args catch [];
    // `gui.bind(gui.<kind>(...), "field")` — unwrap to the inner widget + attach its binding.
    if m == "bind" {
        let inner = _widget_from_call(try a[0] catch nil);
        if inner != nil {
            let field = _s(try a[1] catch nil);
            if field != "" { inner["bind"] = field; }
        }
        return inner;
    }
    if m == "label" {
        let text = _s(a[3]);
        return map{ kind: "label", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: len(text) * _CW, h: 18, props: map{ text: text } };
    }
    if m == "button" {
        let node = map{ kind: "button", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
        let h = _ident(a[6]);
        if h != "" { node["events"] = map{ click: h }; }
        return node;
    }
    if m == "textbox" {
        return map{ kind: "textbox", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ value: _s(a[5]) } };
    }
    if m == "checkbox" {
        let text = _s(a[3]);
        let node = map{ kind: "checkbox", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _CH + 6 + len(text) * _CW, h: 18,
                        props: map{ text: text, checked: _bool(a[4]) } };
        let h = _ident(a[5]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "radio" {
        let text = _s(a[3]);
        let node = map{ kind: "radio", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _CH + 6 + len(text) * _CW, h: 18,
                        props: map{ text: text, group: _s(a[4]), selected: _bool(a[5]) } };
        let h = _ident(a[6]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "select" {
        let node = map{ kind: "select", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]),
                        props: map{ options: _strings(a[5]), selected: _n(a[6]) } };
        let h = _ident(a[7]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "slider" {
        let node = map{ kind: "slider", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]),
                        props: map{ value: _n(a[5]), min: _n(a[6]), max: _n(a[7]) } };
        let h = _ident(a[8]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "panel" {
        return map{ kind: "panel", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ title: _s(a[5]) } };
    }
    if m == "cube3d" {
        return map{ kind: "cube3d", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
    }
    if m == "sphere3d" {
        return map{ kind: "sphere3d", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
    }
    return nil;
}

// scan a list of statements for `let form = gui.form(...)` and `gui.add(form, gui.<kind>(...))`.
fn _scan(stmts, res) {
    let i = 0;
    while i < len(stmts) {
        let st = stmts[i];
        let k = try st.kind catch "";
        if k == "let" {
            let v = try st.value catch nil;
            if v != nil and _is_gui(v, "form") {
                let a = try v.args catch [];
                res["form"] = map{ title: _s(a[0]), w: _n(a[1]), h: _n(a[2]) };
            }
        } else if k == "expr_stmt" {
            let e = try st.expr catch nil;
            if e != nil and _is_gui(e, "add") {
                let a = try e.args catch [];
                if len(a) > 1 {
                    let wd = _widget_from_call(a[1]);
                    if wd != nil { push(res.widgets, wd); }
                }
            } else if e != nil and _is_gui(e, "set_model") {
                let a = try e.args catch [];
                if len(a) > 1 { res["model"] = _map_from_node(a[1]); }
            }
        }
        i = i + 1;
    }
    return 0;
}

// parse(code) — generated pblang desktop code -> { form, widgets }. Scans every top-level
// function body, so it tolerates the design living in build()/main()/anything. On a parse
// error or no gui calls, returns the default empty form (never crashes).
fn parse(code) {
    let res = map{ form: map{ title: "My App", w: 480, h: 320 }, widgets: [], model: map{} };
    let ast = try _par.parse(_tok.tokenize(code)) catch nil;
    if ast == nil { return res; }
    let stmts = try ast.stmts catch [];
    let i = 0;
    while i < len(stmts) {
        if (try stmts[i].kind catch "") == "fn" {
            _scan(try stmts[i].body.stmts catch [], res);
        }
        i = i + 1;
    }
    return res;
}

export parse;
