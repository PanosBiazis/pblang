// stdlib/gui_parse.sapp — parse generated pblang desktop-GUI code back into a design tree.
//
// The DESKTOP ROUND-TRIP (Visual_Designer.md D3, the D1 analogue): the designer generates
// a gui.sapp app (gui.form + gui.add(form, gui.<kind>(...)) calls); this reads that pblang
// back — via the SELF-HOSTED parser (stdlib/compiler/) — into the form + widget list the
// canvas renders, so hand-edited code and drag-authored design stay in sync. The inverse
// of dzGenDesktop's codegen. All pblang.
//
//   let G = import("stdlib/gui_parse.sapp");
//   let design = G.parse(generatedCode);   // -> { form: {title,w,h}, widgets: [ {kind,name,x,y,w,h,props,events?}, … ] }
//
// Recognizes the gui.* constructor shapes the designer emits (label/button/textbox/
// checkbox/panel) and recovers wired handlers (button->click, checkbox->change).

let _tok = import("stdlib/compiler/tokenizer.sapp");
let _par = import("stdlib/compiler/parser.sapp");
let Typography=import("stdlib:ui_typography.sapp");
let _doc = import("stdlib:ui_document.sapp");

// metrics mirror stdlib/gui.sapp so auto-sized widgets (label/checkbox) round-trip with a
// box matching how gui.sapp draws them (label/checkbox don't emit w/h in codegen).
let _CW = 12;
let _CH = 16;
let MAX_SOURCE_CHARS = 262144;
let MAX_WIDGETS = 512;

fn _s(a) { if a != nil and (try a.kind catch "") == "string" { return a.value; } return ""; }
// number-literal nodes store their value as the source TEXT (e.g. "500"), so coerce to a
// real number — otherwise round-tripped geometry would be strings, not ints.
fn _n(a) {
    if a == nil or (try a.kind catch "") != "number" { return 0; }
    return try parse_number(a.value) catch 0;
}
fn _bool(a) { if a != nil and (try a.kind catch "") == "bool" { return a.value; } return false; }
fn _ident(a) {                              // handler identifier, or "" for nil / anything else
    if a != nil and (try a.kind catch "") == "ident" { return a.name; }
    return "";
}
fn _strings(a) {                            // array-literal node -> list of its string values
    let out = [];
    if a == nil or (try a.kind catch "") != "array" { return out; }
    let items = try a.items catch [];
    let i = 0;
    while i < len(items) { push(out, _s(items[i])); i = i + 1; }
    return out;
}
// map-literal node -> a real map (string/number/bool values). Used for gui.set_model(...).
fn _map_from_node(node) {
    let m = map{};
    if node == nil or (try node.kind catch "") != "map" { return m; }
    let entries = try node.entries catch [];
    let i = 0;
    while i < len(entries) {
        let key = try entries[i].key catch "";
        let v = entries[i].value;
        let vk = try v.kind catch "";
        if vk == "string" { m[key] = v.value; }
        else if vk == "number" { m[key] = try parse_number(v.value) catch 0; }
        else if vk == "bool" { m[key] = v.value; }
        i = i + 1;
    }
    return m;
}

// is `call` a `gui.<method>(...)` call?
fn _is_gui(call, method) {
    if (try call.kind catch "") != "call" { return false; }
    if (try call.func.obj.name catch "") != "gui" { return false; }
    return (try call.func.name catch "") == method;
}

fn _widget_from_call(c) {
    if (try c.kind catch "") != "call" { return nil; }
    let m = try c.func.name catch "";
    let a = try c.args catch [];
    // `gui.bind(gui.<kind>(...), "field")` — unwrap to the inner widget + attach its binding.
    if m == "bind" {
        let inner = _widget_from_call(try a[0] catch nil);
        if inner != nil {
            let field = _s(try a[1] catch nil);
            if field != "" { inner["bind"] = field; }
        }
        return inner;
    }
    if m=="styled_label" {
        if len(a)!=7 or (try a[6].kind catch "")!="map" {return nil;}
        if (try a[0].kind catch "")!="string" or (try a[5].kind catch "")!="string" {return nil;}
        for index in [1,2] {if (try a[index].kind catch "")!="number" {return nil;}}
        for entry in a[6].entries {
            if entry.key!="font_size" and entry.key!="font_weight" and entry.key!="text_align" {return nil;}
            let kind=entry.value.kind;
            if kind!="number" and kind!="string" {return nil;}
        }
        let props=_map_from_node(a[6]);
        if not (try Typography.validate(props) catch false) {return nil;}
        for index in [3,4] {
            if (try a[index].kind catch "")!="number" {return nil;}
            let value=_n(a[index]);
            if not (value>=0 and value<=8192) or value!=num_floor(value) {return nil;}
        }
        props.text=_s(a[5]);
        return map{kind:"label",name:_s(a[0]),x:_n(a[1]),y:_n(a[2]),w:_n(a[3]),h:_n(a[4]),props:props};
    }
    if m == "label" {
        let text = _s(a[3]);
        return map{ kind: "label", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: len(text) * _CW, h: 18, props: map{ text: text } };
    }
    if m == "button" {
        let node = map{ kind: "button", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
        let h = _ident(a[6]);
        if h != "" { node["events"] = map{ click: h }; }
        return node;
    }
    if m == "textbox" {
        return map{ kind: "textbox", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ value: _s(a[5]) } };
    }
    if m == "checkbox" {
        let text = _s(a[3]);
        let node = map{ kind: "checkbox", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _CH + 6 + len(text) * _CW, h: 18,
                        props: map{ text: text, checked: _bool(a[4]) } };
        let h = _ident(a[5]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "radio" {
        let text = _s(a[3]);
        let node = map{ kind: "radio", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _CH + 6 + len(text) * _CW, h: 18,
                        props: map{ text: text, group: _s(a[4]), selected: _bool(a[5]) } };
        let h = _ident(a[6]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "select" {
        let node = map{ kind: "select", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]),
                        props: map{ options: _strings(a[5]), selected: _n(a[6]) } };
        let h = _ident(a[7]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "slider" {
        let node = map{ kind: "slider", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                        w: _n(a[3]), h: _n(a[4]),
                        props: map{ value: _n(a[5]), min: _n(a[6]), max: _n(a[7]) } };
        let h = _ident(a[8]);
        if h != "" { node["events"] = map{ change: h }; }
        return node;
    }
    if m == "panel" {
        return map{ kind: "panel", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ title: _s(a[5]) } };
    }
    if m == "cube3d" {
        return map{ kind: "cube3d", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
    }
    if m == "sphere3d" {
        return map{ kind: "sphere3d", name: _s(a[0]), x: _n(a[1]), y: _n(a[2]),
                    w: _n(a[3]), h: _n(a[4]), props: map{ text: _s(a[5]) } };
    }
    return nil;
}

// scan a list of statements for `let form = gui.form(...)` and `gui.add(form, gui.<kind>(...))`.
fn _scan(stmts, res) {
    let i = 0;
    while i < len(stmts) {
        let st = stmts[i];
        let k = try st.kind catch "";
        if k == "let" {
            let v = try st.value catch nil;
            if v != nil and _is_gui(v, "form") {
                let a = try v.args catch [];
                res["form"] = map{ title: _s(a[0]), w: _n(a[1]), h: _n(a[2]) };
            }
        } else if k == "expr_stmt" {
            let e = try st.expr catch nil;
            if e != nil and _is_gui(e, "add") {
                let a = try e.args catch [];
                if len(a) > 1 {
                    let wd = _widget_from_call(a[1]);
                    if wd != nil { push(res.widgets, wd); }
                }
            } else if e != nil and _is_gui(e, "set_model") {
                let a = try e.args catch [];
                if len(a) > 1 { res["model"] = _map_from_node(a[1]); }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _strict_error(state, code, message) {
    if state.error == "" { state.error = str(code); }
    if len(state.diagnostics) < 32 { array_push(state.diagnostics, str(message)); }
    return 0;
}

fn _strict_widget_valid(widget, state) {
    let name = str(try widget.name catch "");
    if name == "" or len(name) > 128 {
        _strict_error(state, "invalid-widget-name", "widget names must contain 1..128 characters");
        return false;
    }
    let x = try widget.x catch nil; let y = try widget.y catch nil;
    let w = try widget.w catch nil; let h = try widget.h catch nil;
    for value in [x, y, w, h] {
        if type(value) != "number" or value < -100000 or value > 100000 {
            _strict_error(state, "invalid-widget-geometry", "widget geometry exceeds the bounded designer range");
            return false;
        }
    }
    if w < 0 or h < 0 {
        _strict_error(state, "invalid-widget-geometry", "widget width and height cannot be negative");
        return false;
    }
    let names = state.names;
    if map_has(names, name) {
        _strict_error(state, "duplicate-widget-name", "duplicate widget name: " + name);
        return false;
    }
    names[name] = true;
    return true;
}

fn _scan_strict(stmts, res, state) {
    let i = 0;
    while i < len(stmts) and state.error == "" {
        let st = stmts[i]; let k = try st.kind catch "";
        if k == "let" {
            let value = try st.value catch nil;
            if value != nil and _is_gui(value, "form") {
                let args = try value.args catch [];
                if len(args) < 3 {
                    _strict_error(state, "invalid-form", "gui.form requires title, width and height");
                } else {
                    let title = _s(args[0]); let width = _n(args[1]); let height = _n(args[2]);
                    if title == "" or len(title) > 256 or width < 64 or width > 16384 or height < 64 or height > 16384 {
                        _strict_error(state, "invalid-form", "form title or dimensions are outside the bounded designer contract");
                    } else {
                        res.form = map{ title:title, w:width, h:height };
                        state.form_found = true;
                    }
                }
            }
        } else if k == "expr_stmt" {
            let expr = try st.expr catch nil;
            if expr != nil and _is_gui(expr, "add") {
                let args = try expr.args catch [];
                if len(args) < 2 {
                    _strict_error(state, "invalid-add", "gui.add requires a widget constructor");
                } else {
                    let widget = _widget_from_call(args[1]);
                    if widget == nil {
                        let method = str(try args[1].func.name catch "unknown");
                        _strict_error(state, "unsupported-widget", "unsupported GUI constructor: " + method);
                        array_push(state.unsupported, method);
                    } else if len(res.widgets) >= MAX_WIDGETS {
                        _strict_error(state, "too-many-widgets", "designer import exceeds " + str(MAX_WIDGETS) + " widgets");
                    } else if _strict_widget_valid(widget, state) {
                        array_push(res.widgets, widget);
                    }
                }
            } else if expr != nil and _is_gui(expr, "set_model") {
                let args = try expr.args catch [];
                if len(args) > 1 { res.model = _map_from_node(args[1]); }
            }
        }
        i = i + 1;
    }
    return 0;
}

// parse_strict is the versioned, bounded Designer import boundary. Unlike the
// compatibility parse() helper, it reports malformed/unsupported source and is
// suitable for atomic UI state replacement.
fn parse_strict(code) {
    if type(code) != "string" { return map{ ok:false, error:"source-type", diagnostics:["source must be text"], unsupported:[] }; }
    if len(code) > MAX_SOURCE_CHARS {
        return map{ ok:false, error:"source-too-large", diagnostics:["source exceeds " + str(MAX_SOURCE_CHARS) + " characters"], unsupported:[] };
    }
    let ast = try _par.parse(_tok.tokenize(code)) catch nil;
    if ast == nil { return map{ ok:false, error:"parse-failed", diagnostics:["source did not parse"], unsupported:[] }; }
    let result = map{ form:map{title:"My App", w:480, h:320}, widgets:[], model:map{} };
    let state = map{ error:"", diagnostics:[], unsupported:[], names:map{}, form_found:false };
    let statements = try ast.stmts catch [];
    let i = 0;
    while i < len(statements) and state.error == "" {
        if (try statements[i].kind catch "") == "fn" {
            _scan_strict(try statements[i].body.stmts catch [], result, state);
        }
        i = i + 1;
    }
    if state.error == "" and not state.form_found {
        _strict_error(state, "form-missing", "no bounded gui.form declaration was found");
    }
    if state.error != "" {
        return map{ ok:false, format:"pbide.designer.import.v1", error:state.error,
            diagnostics:state.diagnostics, unsupported:state.unsupported, widget_count:len(result.widgets) };
    }
    return map{ ok:true, format:"pbide.designer.import.v1", form:result.form,
        widgets:result.widgets, model:result.model, widget_count:len(result.widgets),
        diagnostics:[], unsupported:[] };
}

// parse(code) — generated pblang desktop code -> { form, widgets }. Scans every top-level
// function body, so it tolerates the design living in build()/main()/anything. On a parse
// error or no gui calls, returns the default empty form (never crashes).
fn parse(code) {
    let strict = parse_strict(code);
    if strict.ok { return map{ form:strict.form, widgets:strict.widgets, model:strict.model }; }
    return map{ form: map{ title: "My App", w: 480, h: 320 }, widgets: [], model: map{} };
}

// Strict parser plus canonical renderer-neutral interchange. This never executes
// recovered handler identifiers or performs renderer/platform effects.
fn parse_document(code) {
    let imported = parse_strict(code);
    if not imported.ok { return imported; }
    return _doc.from_design(map{form:imported.form, widgets:imported.widgets,
        model:imported.model}, "pblang-gui");
}

// find_widgets(design, kind) — all parsed widgets of the given kind.
fn find_widgets(design, kind) {
    let out = [];
    let i = 0;
    while i < len(design.widgets) {
        if design.widgets[i].kind == kind { array_push(out, design.widgets[i]); }
        i = i + 1;
    }
    return out;
}

// count_by_kind(design) — map of widget kind → count.
fn count_by_kind(design) {
    let m = map{};
    let i = 0;
    while i < len(design.widgets) {
        let k = design.widgets[i].kind;
        if map_has(m, k) { m[k] = m[k] + 1; } else { m[k] = 1; }
        i = i + 1;
    }
    return m;
}

// widget_names(design) — the names of all parsed widgets, in order.
fn widget_names(design) {
    let out = [];
    let i = 0;
    while i < len(design.widgets) { array_push(out, try design.widgets[i].name catch nil); i = i + 1; }
    return out;
}

// ── wave 2: widget lookup ────────────────────────────────────────────────────────

// get_widget(design, name) — the first parsed widget with this name, or nil.
fn get_widget(design, name) {
    let i = 0;
    while i < len(design.widgets) {
        if (try design.widgets[i].name catch nil) == name { return design.widgets[i]; }
        i = i + 1;
    }
    return nil;
}

// has_widget(design, name) — true if a widget with this name was parsed.
fn has_widget(design, name) { return get_widget(design, name) != nil; }

export MAX_SOURCE_CHARS, MAX_WIDGETS;
export parse, parse_strict, parse_document, find_widgets, count_by_kind, widget_names, get_widget, has_widget;
