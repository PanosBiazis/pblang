// Review the computed lookup mapping; no inference from blank output cells.
let S=import("stdlib:sheet_document.sapp");let D=import("stdlib:text_document.sapp");
fn _int(value,low,high) {return type(value)=="number" and value>=low and value<=high and value==num_floor(value);}
fn validate(report) {
 if type(report)!="map" {throw "join review: expected report";}
 for key in ["format","document","matched","unmatched","mode","row_matches","source_rows","reference_rows","unmatched_source_rows"] {if not map_has(report,key) {throw "join review: missing mapping metadata; recompute join";}}
 if report.format!="pblang.table-lookup.v1" or (report.mode!="left" and report.mode!="inner") or not _int(report.matched,0,31) or not _int(report.unmatched,0,31) {throw "join review: invalid counts or mode";}
 let total=report.matched+report.unmatched;if total>31 {throw "join review: source limit";}
 S.validate(report.document);let n=len(report.document.cells)-1;
 for key in ["row_matches","source_rows","reference_rows"] {if type(report[key])!="array" or len(report[key])!=n {throw "join review: mapping lengths";}}
 if type(report.unmatched_source_rows)!="array" or len(report.unmatched_source_rows)!=report.unmatched {throw "join review: unmatched mapping length";}
 if (report.mode=="left" and n!=total) or (report.mode=="inner" and n!=report.matched) {throw "join review: output count";}
 let missing=map{};let previous=0;
 for row in report.unmatched_source_rows {if not _int(row,1,total) or row<=previous {throw "join review: invalid unmatched row";}missing[str(row)]=true;previous=row;}
 let seen=map{};previous=0;let matched=0;
 for i in range(0,n) {
  let row=report.source_rows[i];let flag=report.row_matches[i];let reference=report.reference_rows[i];
  if not _int(row,1,total) or row<=previous {throw "join review: invalid source mapping";}
  if type(flag)!="bool" {throw "join review: flag must be boolean";}
  if flag {
   if not _int(reference,1,31) or map_has(missing,str(row)) {throw "join review: invalid matched mapping";}matched=matched+1;
  } else {if reference!=nil or not map_has(missing,str(row)) or report.mode!="left" {throw "join review: invalid missing mapping";}}
  seen[str(row)]=true;previous=row;
 }
 if matched!=report.matched {throw "join review: matched count";}
 for row in range(1,total+1) {if not map_has(seen,str(row)) and not map_has(missing,str(row)) {throw "join review: source coverage";}}
 return true;
}
fn to_document(report,title="Table join review") {
 validate(report);if type(title)!="string" or len(title)>256 or str_trim(title)=="" {throw "join review: nonblank title required";}
 let out=D.create(title);let total=report.matched+report.unmatched;
 let summary="Mode: "+report.mode+" | Left rows: "+str(total)+" | Matched: "+str(report.matched)+" | Unmatched: "+str(report.unmatched)+" | Output rows: "+str(len(report.document.cells)-1)+".\nRow numbers count data rows after the header (file row = data row + 1). MATCH can contain blank values. NO MATCH is not inferred from blanks. Snapshot mapping; no cell values or filenames included. Counts/positions may still be sensitive.";
 out.blocks=[map{kind:"paragraph",text:summary}];let outputs=map{};
 for i in range(0,len(report.source_rows)) {outputs[str(report.source_rows[i])]=i;}
 for row in range(1,total+1) {
  let text="Left data row "+str(row)+": ";
  if map_has(outputs,str(row)) {
   let i=outputs[str(row)];
   text=text+(if report.row_matches[i] {"MATCH; reference data row "+str(report.reference_rows[i])} else {"NO MATCH"})+"; output data row "+str(i+1)+".";
  } else {text=text+"NO MATCH; omitted from inner output.";}
  array_push(out.blocks,map{kind:"paragraph",text:text});
 }
 D.validate(out);return out;
}
export validate,to_document;
