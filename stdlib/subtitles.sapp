// Bounded plain-text SRT cues. No media decoder, clock, file I/O or markup execution.
let Strings=import("stdlib:strings.sapp");
let FORMAT="pblang.subtitles.v1";
let MAX_CUES=128; let MAX_INPUT_BYTES=131072; let MAX_TEXT_BYTES=2048;
let MAX_TIME_MS=359999999;
fn _integer(value,low,high) {
    if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value) { throw "subtitles: invalid integer"; }
}
fn _keys(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } } return true;
}
fn _text(text) {
    if type(text)!="string" or len(text)>MAX_TEXT_BYTES or len(str_to_bytes(text))>MAX_TEXT_BYTES
        or str_trim(text)=="" or str_contains(text,"\r") or str_contains(text,"\u0000") { throw "subtitles: invalid cue text"; }
    let lines=str_split(text,"\n");
    if len(lines)>4 { throw "subtitles: at most four lines per cue"; }
    for line in lines { if str_trim(line)=="" { throw "subtitles: blank cue line"; } }
}
fn validate(doc) {
    if not _keys(doc,["format","cues"]) or doc.format!=FORMAT or type(doc.cues)!="array"
        or len(doc.cues)<1 or len(doc.cues)>MAX_CUES { throw "subtitles: invalid document"; }
    let previous= -1; let bytes=0;
    for cue in doc.cues {
        if not _keys(cue,["start_ms","end_ms","text"]) { throw "subtitles: invalid cue"; }
        _integer(cue.start_ms,0,MAX_TIME_MS); _integer(cue.end_ms,0,MAX_TIME_MS); _text(cue.text);
        if cue.start_ms<previous or cue.end_ms<=cue.start_ms { throw "subtitles: invalid cue ordering or duration"; }
        previous=cue.start_ms; bytes=bytes+len(str_to_bytes(cue.text));
        if bytes>65536 { throw "subtitles: total text limit"; }
    }
    return true;
}
fn copy(doc) {
    validate(doc); let cues=[];
    for cue in doc.cues { array_push(cues,map{start_ms:cue.start_ms,end_ms:cue.end_ms,text:cue.text}); }
    return map{format:FORMAT,cues:cues};
}
fn parse_time(text) {
    if type(text)!="string" or len(text)!=12 or str_slice(text,2,3)!=":"
        or str_slice(text,5,6)!=":" or str_slice(text,8,9)!="," { throw "subtitles: expected HH:MM:SS,mmm"; }
    for i in range(0,12) {
        if i!=2 and i!=5 and i!=8 and str_index_of("0123456789",str_slice(text,i,i+1))<0 { throw "subtitles: invalid timestamp"; }
    }
    let h=parse_number(str_slice(text,0,2)); let m=parse_number(str_slice(text,3,5));
    let s=parse_number(str_slice(text,6,8)); let ms=parse_number(str_slice(text,9,12));
    if m>59 or s>59 { throw "subtitles: invalid timestamp"; } return h*3600000+m*60000+s*1000+ms;
}
fn _pad(value,width) { let text=str(value); return str_repeat("0",width-len(text))+text; }
fn format_time(ms,web=false) {
    _integer(ms,0,MAX_TIME_MS); if type(web)!="bool" { throw "subtitles: invalid target"; }
    return _pad(num_floor(ms/3600000),2)+":"+_pad(num_mod(num_floor(ms/60000),60),2)+":"
        +_pad(num_mod(num_floor(ms/1000),60),2)+(if web {"."} else {","})+_pad(num_mod(ms,1000),3);
}
fn parse_srt(source) {
    if type(source)!="string" or len(source)>MAX_INPUT_BYTES or len(str_to_bytes(source))>MAX_INPUT_BYTES { throw "subtitles: input limit"; }
    let text=Strings.replace_all(source,"\r\n","\n");
    if str_starts_with(text,"\uFEFF") { text=str_slice(text,1,len(text)); }
    if str_contains(text,"\r") { throw "subtitles: unsupported line endings"; }
    let lines=str_split(text,"\n"); let cues=[]; let i=0;
    while i<len(lines) {
        if lines[i]=="" { i=i+1; continue; }
        if len(cues)>=MAX_CUES or lines[i]!=str(len(cues)+1) or i+2>=len(lines) { throw "subtitles: expected consecutive cue number"; }
        let times=str_split(lines[i+1]," --> ");
        if len(times)!=2 { throw "subtitles: invalid timing line"; }
        let start=parse_time(times[0]); let end=parse_time(times[1]); i=i+2; let body=[];
        while i<len(lines) and lines[i]!="" {
            if len(body)>=4 { throw "subtitles: line limit"; }
            array_push(body,lines[i]); i=i+1;
        }
        array_push(cues,map{start_ms:start,end_ms:end,text:str_join(body,"\n")});
    }
    let doc=map{format:FORMAT,cues:cues}; validate(doc); return doc;
}
fn to_srt(doc) {
    validate(doc); let parts=[];
    for i in range(0,len(doc.cues)) {
        let c=doc.cues[i]; array_push(parts,str(i+1)+"\n"+format_time(c.start_ms)+" --> "+format_time(c.end_ms)+"\n"+c.text+"\n");
    }
    return str_join(parts,"\n")+"\n";
}
fn to_vtt(doc) {
    validate(doc); let parts=["WEBVTT\n"];
    for c in doc.cues {
        let literal=Strings.replace_all(Strings.replace_all(Strings.replace_all(c.text,"&","&amp;"),"<","&lt;"),">","&gt;");
        array_push(parts,format_time(c.start_ms,true)+" --> "+format_time(c.end_ms,true)+"\n"+literal+"\n");
    }
    return str_join(parts,"\n")+"\n";
}
fn shift(doc,offset_ms) {
    _integer(offset_ms,0-MAX_TIME_MS,MAX_TIME_MS); let out=copy(doc);
    for cue in out.cues { cue.start_ms=cue.start_ms+offset_ms; cue.end_ms=cue.end_ms+offset_ms; }
    validate(out); return out;
}
fn set_cue(doc,index,start_ms,end_ms,text) {
    validate(doc); _integer(index,0,len(doc.cues)-1); let out=copy(doc);
    out.cues[index]=map{start_ms:start_ms,end_ms:end_ms,text:text}; validate(out); return out;
}
fn statistics(doc) {
    validate(doc); let overlaps=0; let end=0; let visible=0;
    for c in doc.cues { if c.start_ms<end { overlaps=overlaps+1; } end=num_max(end,c.end_ms); visible=visible+c.end_ms-c.start_ms; }
    return map{cue_count:len(doc.cues),end_ms:end,cue_duration_sum_ms:visible,overlapping_cues:overlaps};
}
export FORMAT,MAX_CUES,MAX_INPUT_BYTES,MAX_TIME_MS;
export validate,copy,parse_time,format_time,parse_srt,to_srt,to_vtt,shift,set_cue,statistics;
