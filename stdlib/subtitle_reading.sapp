let Subs=import("stdlib:subtitles.sapp");let Metrics=import("stdlib:text_metrics.sapp");
fn _limit(limit){if type(limit)!="number" or not(limit>=0 and limit<=1000000){throw "subtitle reading: invalid custom limit";}}
fn analyze(doc,limit=20){Subs.validate(doc);_limit(limit);let cues=[];let above=0;let peak=0;
 for c in doc.cues{let m=Metrics.count(c.text);let duration=c.end_ms-c.start_ms;let rate=m.nonspace_characters*1000/duration;let over=rate>limit;if over{above=above+1;}peak=num_max(peak,rate);array_push(cues,map{characters:m.characters,nonspace_characters:m.nonspace_characters,words:m.words,duration_ms:duration,characters_per_second:rate,above_limit:over});}
 return map{limit:limit,above_limit:above,peak_characters_per_second:peak,cues:cues};
}
fn next_above(doc,index,limit=20){let report=analyze(doc,limit);if type(index)!="number" or not(index>=0 and index<len(doc.cues)) or index!=num_floor(index){throw "subtitle reading: invalid index";}
 for step in range(1,len(doc.cues)+1){let at=num_mod(index+step,len(doc.cues));if report.cues[at].above_limit{return at;}}return nil;
}
export analyze,next_above;
