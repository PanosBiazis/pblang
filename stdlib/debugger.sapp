// stdlib/debugger.sapp — Interactive Debugger for pblang
//
// Provides breakpoint-based debugging, step execution, variable inspection,
// and call stack analysis for pblang programs.
//
// Usage:
//   let dbg = import("stdlib:debugger.sapp");
//   dbg.breakpoint("my_func", 10);     // set a breakpoint at line 10
//   dbg.watch("counter");              // watch a variable
//   dbg.run("my_script.sapp");         // run with debugger attached

// ── Internal State ────────────────────────────────────────────────────────────

let RUNTIME_GC = import("stdlib:runtime_gc.sapp");

let _breakpoints = map{};       // file → [line_numbers]
let _watches = [];              // list of variable names
let _step_mode = false;         // single-step mode
let _step_over = false;         // step-over mode
let _paused = false;
let _current_file = "";
let _current_line = 0;
let _variables = map{};         // snapshot of current variables
let _call_stack = [];
let _trace_enabled = false;
let _trace_log = [];

// ── Breakpoint Management ─────────────────────────────────────────────────────

// breakpoint(file, line) — set a breakpoint at a specific file/line
fn breakpoint(file, line) {
    let bp_list = [];
    if map_has(_breakpoints, file) {
        let stored = _breakpoints[file];
        if stored != nil { bp_list = stored; }
    }
    array_push(bp_list, line);
    _breakpoints[file] = bp_list;
    return map{ok: true, file: file, line: line};
}

// breakpoints(file) — get all breakpoints for a file
fn breakpoints(file) {
    if not map_has(_breakpoints, file) { return []; }
    let bp = _breakpoints[file];
    if bp == nil { return []; }
    return bp;
}

// clear_breakpoint(file, line) — remove a specific breakpoint
fn clear_breakpoint(file, line) {
    let bp_list = nil;
    if map_has(_breakpoints, file) { bp_list = _breakpoints[file]; }
    if bp_list == nil { return nil; }
    let new_list = [];
    let i = 0;
    while i < len(bp_list) {
        if bp_list[i] != line {
            array_push(new_list, bp_list[i]);
        }
        i = i + 1;
    }
    _breakpoints[file] = new_list;
    return nil;
}

// clear_all_breakpoints() — remove all breakpoints
fn clear_all_breakpoints() {
    _breakpoints = map{};
    return nil;
}

// ── Watch Management ──────────────────────────────────────────────────────────

// watch(var_name) — add a variable to the watch list
fn watch(var_name) {
    array_push(_watches, var_name);
    return nil;
}

// unwatch(var_name) — remove a variable from watch list
fn unwatch(var_name) {
    let new_watches = [];
    let i = 0;
    while i < len(_watches) {
        if _watches[i] != var_name {
            array_push(new_watches, _watches[i]);
        }
        i = i + 1;
    }
    _watches = new_watches;
    return nil;
}

// watched() — get all watched variables and their values
fn watched() {
    let result = [];
    let i = 0;
    while i < len(_watches) {
        let name = _watches[i];
        if map_has(_variables, name) {
            array_push(result, map{name: name, value: _variables[name]});
        } else {
            array_push(result, map{name: name, value: "<undefined>"});
        }
        i = i + 1;
    }
    return result;
}

// ── Execution Control ─────────────────────────────────────────────────────────

// step() — execute the next instruction and pause
fn step() {
    _step_mode = true;
    _paused = false;
    return nil;
}

// step_over() — execute the next instruction without entering function calls
fn step_over() {
    _step_over = true;
    _paused = false;
    return nil;
}

// continue_exec() — continue execution until next breakpoint
fn continue_exec() {
    _step_mode = false;
    _step_over = false;
    _paused = false;
    return nil;
}

// pause() — pause execution immediately
fn pause() {
    _paused = true;
    return nil;
}

// ── State Inspection ──────────────────────────────────────────────────────────

// inspect(var_name) — get the value of a specific variable (nil if not tracked).
fn inspect(var_name) {
    if not map_has(_variables, var_name) { return nil; }
    return _variables[var_name];
}

// locals() — get all local variables in current scope
fn locals() {
    return _variables;
}

// call_stack() — get current call stack
fn call_stack() {
    return _call_stack;
}

// current_location() — get current file and line
fn current_location() {
    return map{
        file: _current_file,
        line: _current_line,
    };
}

// ── Tracing ───────────────────────────────────────────────────────────────────

// enable_trace() — enable execution tracing
fn enable_trace() {
    _trace_enabled = true;
    return nil;
}

// disable_trace() — disable execution tracing
fn disable_trace() {
    _trace_enabled = false;
    return nil;
}

// trace_record(event, details) — record a trace event
fn trace_record(event, details) {
    if !_trace_enabled { return nil; }
    array_push(_trace_log, map{
        time: time_monotonic_ms(),
        event: event,
        details: details,
        file: _current_file,
        line: _current_line,
    });
    return nil;
}

// trace_dump() — get all trace records
fn trace_dump() {
    return _trace_log;
}

// trace_clear() — clear trace log
fn trace_clear() {
    _trace_log = [];
    return nil;
}

// ── Profiling Integration ─────────────────────────────────────────────────────

// profile(iterations) — run a quick performance profile
fn profile(iterations) {
    if iterations <= 0 { iterations = 1; }
    let t0 = time_monotonic_ms();
    let i = 0;
    while i < iterations {
        locals();
        i = i + 1;
    }
    let t1 = time_monotonic_ms();
    return map{
        iterations: iterations,
        total_ms: t1 - t0,
        avg_ms: (t1 - t0) / iterations,
    };
}

// ── Disassembly ───────────────────────────────────────────────────────────────

// disasm(filepath) — disassemble a .sapp file (bytecode dump).
// SECURITY: was exec("pblang --dump-bytecode " + filepath) which concatenates an
// untrusted path into a shell (injection). Uses argv-based proc_spawn_wait instead.
fn disasm(filepath) {
    let result = try proc_spawn_wait("pblang", ["--dump-bytecode", filepath]) catch nil;
    let out = "";
    if result != nil { out = try result.stdout catch ""; }
    return map{
        file: filepath,
        output: out,
    };
}

// ── Memory Inspection ─────────────────────────────────────────────────────────

// memory_dump() — dump memory statistics
fn memory_dump() {
    return memory_stats();
}

// gc_collect_force() — force garbage collection
fn gc_collect_force() {
    return RUNTIME_GC.collect();
}

// gc_stats() — get scoped GC status and observational host-thread counters.
fn gc_stats() {
    return map{
        format: "pblang.debugger.gc-stats.v2",
        runtime: RUNTIME_GC.status(),
        host_thread_stats: RUNTIME_GC.host_thread_stats_text()
    };
}

// ── Helpers ───────────────────────────────────────────────────────────────────

fn time_monotonic_ms() {
    return now_ms();
}

export breakpoint, breakpoints, clear_breakpoint, clear_all_breakpoints;
export watch, unwatch, watched;
export step, step_over, continue_exec, pause;
export inspect, locals, call_stack, current_location;
export enable_trace, disable_trace, trace_record, trace_dump, trace_clear;
export profile;
export disasm;
export memory_dump, gc_collect_force, gc_stats;
