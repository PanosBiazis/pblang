// Database stdlib (future-proof driver-style API).
//
// Today: SQLite backend.
// Tomorrow: postgres/mysql can implement the same shape.
//
// Usage:
//   import "stdlib:db.sapp";
//   let c = db.sqlite.open("app.db");
//   c.exec("create table if not exists t(x int)", []);
//   c.exec("insert into t(x) values (?)", [123]);
//   print c.query("select x from t where x > ?", [0]);
//   c.close();

fn _conn(kind, handle) {
    return map{
        kind: kind,
        handle: handle,

        exec: fn(sql, params) {
            if kind == "sqlite" {
                return sqlite_exec(handle, sql, params);
            }
            return nil;
        },

        query: fn(sql, params) {
            if kind == "sqlite" {
                return sqlite_query(handle, sql, params);
            }
            return [];
        },

        prepare: fn(sql) {
            // Prepared statement object (API-stable). SQLite currently prepares per-call internally.
            let k = kind;
            let h = handle;
            return map{
                sql: sql,
                exec: fn(params) {
                    if k == "sqlite" { return sqlite_exec(h, sql, params); }
                    return nil;
                },
                query: fn(params) {
                    if k == "sqlite" { return sqlite_query(h, sql, params); }
                    return [];
                }
            };
        },

        last_insert_rowid: fn() {
            if kind == "sqlite" {
                return sqlite_last_insert_rowid(handle);
            }
            return nil;
        },

        transaction: fn(f) {
            // BEGIN; try f(conn) catch { ROLLBACK; return nil }; COMMIT;
            let _ = _conn(kind, handle).exec("BEGIN", []);
            let out = try f(_conn(kind, handle)) catch {
                let _ = _conn(kind, handle).exec("ROLLBACK", []);
                return nil;
            };
            let _ = _conn(kind, handle).exec("COMMIT", []);
            return out;
        },

        close: fn() {
            if kind == "sqlite" { return sqlite_close(handle); }
            return nil;
        }
    };
}

let sqlite = map{
    open: fn(path) {
        let h = sqlite_open(path);
        return _conn("sqlite", h);
    }
};

// Helpers for SQL string building (minimal, safe defaults).
fn sql_placeholders(n) {
    // n=3 -> "?,?,?"
    let s = "";
    for i n {
        if i == 0 { s = "?"; } else { s = s + ",?"; }
    }
    return s;
}

fn _migs_sort(migs) {
    // stable-ish O(n^2) sort by .version
    let i = 0;
    while i < len(migs) {
        let j = i + 1;
        while j < len(migs) {
            if migs[j].version < migs[i].version {
                let t = migs[i];
                migs[i] = migs[j];
                migs[j] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return migs;
}

fn migrate(conn, migrations) {
    // migrations: [ map{version: 1, up: "SQL"}, ... ]
    return conn.transaction(fn(c) {
        c.exec("CREATE TABLE IF NOT EXISTS __pblang_migrations (version INTEGER PRIMARY KEY, applied_at TEXT)", []);
        let rows = c.query("SELECT version FROM __pblang_migrations", []);
        let applied = map{};
        for i len(rows) {
            applied[str(rows[i].version)] = true;
        }

        let migs = _migs_sort(migrations);
        for j len(migs) {
            let m = migs[j];
            let k = str(m.version);
            let has = try applied[k] catch nil;
            if has == nil {
                c.exec(m.up, []);
                c.exec(
                    "INSERT INTO __pblang_migrations(version, applied_at) VALUES (?,?)",
                    [m.version, str(clock())]
                );
                applied[k] = true;
            }
        }
        return true;
    });
}

export sqlite, sql_placeholders, migrate;

