// Database stdlib (future-proof driver-style API).
//
// Today: SQLite backend.
// Tomorrow: postgres/mysql can implement the same shape.
//
// Usage:
//   import "stdlib:db.sapp";
//   let c = db.sqlite.open("app.db");
//   c.exec("create table if not exists t(x int)", []);
//   c.exec("insert into t(x) values (?)", [123]);
//   print c.query("select x from t where x > ?", [0]);
//   c.close();
//
// Design note: all closures in the connection map capture `c` (the map itself)
// as a single-level upvalue.  This avoids the 2-level upvalue chain that the
// current compiler cannot resolve (BlockExpr/IIFE inside a closure that itself
// has upvalues).  Accessing c.kind / c.handle through the map bypasses the
// limitation entirely.

fn _conn(kind, handle) {
    let c = map{ kind: kind, handle: handle };

    c.exec = fn(sql, params) {
        if c.kind == "sqlite" {
            return sqlite_exec(c.handle, sql, params);
        }
        return nil;
    };

    c.query = fn(sql, params) {
        if c.kind == "sqlite" {
            return sqlite_query(c.handle, sql, params);
        }
        return [];
    };

    c.prepare = fn(sql) {
        // Capture kind/handle as locals so the inner closures stay 1-level deep.
        let k = c.kind;
        let h = c.handle;
        return map{
            sql: sql,
            exec: fn(params) {
                if k == "sqlite" { return sqlite_exec(h, sql, params); }
                return nil;
            },
            query: fn(params) {
                if k == "sqlite" { return sqlite_query(h, sql, params); }
                return [];
            }
        };
    };

    c.last_insert_rowid = fn() {
        if c.kind == "sqlite" {
            return sqlite_last_insert_rowid(c.handle);
        }
        return nil;
    };

    // transaction(f) — BEGIN; call f(c); COMMIT on success, ROLLBACK on error.
    //
    // Uses `try f(c) catch nil` (simple literal catch, no BlockExpr/IIFE) so that
    // the upvalue for `c` is always reachable within this single closure level.
    // A nil return from f is treated the same as an error (rollback). If your
    // transaction legitimately returns nil, return a wrapper value instead.
    c.transaction = fn(f) {
        c.exec("BEGIN", []);
        let out = try f(c) catch nil;
        if out == nil {
            c.exec("ROLLBACK", []);
            return nil;
        }
        c.exec("COMMIT", []);
        return out;
    };

    c.close = fn() {
        if c.kind == "sqlite" { return sqlite_close(c.handle); }
        return nil;
    };

    return c;
}

let sqlite = map{
    open: fn(path) {
        let h = sqlite_open(path);
        return _conn("sqlite", h);
    }
};

// Helpers for SQL string building (minimal, safe defaults).
fn sql_placeholders(n) {
    // n=3 -> "?,?,?"
    let s = "";
    for i n {
        if i == 0 { s = "?"; } else { s = s + ",?"; }
    }
    return s;
}

fn _migs_sort(migs) {
    // stable-ish O(n^2) sort by .version
    let i = 0;
    while i < len(migs) {
        let j = i + 1;
        while j < len(migs) {
            if migs[j].version < migs[i].version {
                let t = migs[i];
                migs[i] = migs[j];
                migs[j] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return migs;
}

fn migrate(conn, migrations) {
    // migrations: [ map{version: 1, up: "SQL"}, ... ]
    return conn.transaction(fn(c) {
        c.exec("CREATE TABLE IF NOT EXISTS __pblang_migrations (version INTEGER PRIMARY KEY, applied_at TEXT)", []);
        let rows = c.query("SELECT version FROM __pblang_migrations", []);
        let applied = map{};
        for i len(rows) {
            applied[str(rows[i].version)] = true;
        }

        let migs = _migs_sort(migrations);
        for j len(migs) {
            let m = migs[j];
            let k = str(m.version);
            let has = try applied[k] catch nil;
            if has == nil {
                c.exec(m.up, []);
                c.exec(
                    "INSERT INTO __pblang_migrations(version, applied_at) VALUES (?,?)",
                    [m.version, str(clock())]
                );
                applied[k] = true;
            }
        }
        return true;
    });
}

export sqlite, sql_placeholders, migrate;
