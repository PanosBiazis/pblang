// All computed windows, four per page. No file access or recalculation in export.
let Smooth=import("stdlib:smoothing_table.sapp");let UI=import("stdlib:modern_ui.sapp");
fn _line(report,index){if index>=report.rows{return "End of results";}let row=report.document.cells[index+1];return "Samples "+row[0]+"-"+row[1]+" | Mean: "+row[4];}
fn create(source,count){let report=Smooth.from_sheet(source,count);let pages=num_ceil(report.rows/4);let children=[UI.heading("PBSmooth"),UI.text("Samples: "+str(report.samples)+" | Window: "+str(report.window)),UI.text("Complete trailing windows; equally weighted observations."),UI.text("Page 1 / "+str(pages),map{name:"page_label"})];
 for slot in range(0,4){array_push(children,UI.text(_line(report,slot),map{name:"window_"+str(slot)}));}
 let buttons=[];for i in range(0,pages){let actions=[UI.action_set_text("page_label","Page "+str(i+1)+" / "+str(pages))];for slot in range(0,4){array_push(actions,UI.action_set_text("window_"+str(slot),_line(report,i*4+slot)));}array_push(buttons,UI.button("Page "+str(i+1),UI.action_sequence(actions),map{name:"page_"+str(i)}));}
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Numeric overview. Endpoint labels are retained in the full saved table."));array_push(children,UI.text("Read-only snapshot. No live sensor, file access or time-based weighting."));return UI.screen(children);
}
export create;
