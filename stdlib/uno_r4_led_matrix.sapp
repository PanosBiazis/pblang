// Pure 12x8 monochrome model. Arduino loadFrame words are row-major, MSB first.
let Font=import("stdlib:bitmap_font.sapp");
let FORMAT="pblang.uno-r4-led-matrix.v1";
let MAX_FRAMES=64;let MAX_TOTAL_MS=60000;
fn integer(value,low,high) {
    return type(value)=="number" and value>=low and value<=high and value==num_floor(value);
}
fn frame(pixels) {
    if type(pixels)!="array" or len(pixels)!=96 {throw "A frame requires exactly 96 pixels.";}
    let out=[];
    for pixel in pixels {
        if type(pixel)!="number" or not (pixel==0 or pixel==1) {throw "Pixels must be numeric 0 or 1.";}
        push(out,pixel);
    }
    return out;
}
fn blank(value=0) {
    if type(value)!="number" or not (value==0 or value==1) {throw "Pixels must be numeric 0 or 1.";}
    let out=[];for _i 96 {push(out,value);}return out;
}
fn pixel(pixels,x,y,value) {
    if not integer(x,0,11) or not integer(y,0,7) {throw "Pixel coordinates exceed 12x8.";}
    if type(value)!="number" or not (value==0 or value==1) {throw "Pixels must be numeric 0 or 1.";}
    let out=frame(pixels);out[y*12+x]=value;return out;
}
fn pack(pixels) {
    let checked=frame(pixels);let words=[];let word=0;
    // All intermediate values are exact integers <= 2^32-1, no signed shifts.
    for i 96 {word=word*2+checked[i];if i%32==31 {push(words,word);word=0;}}
    return words;
}
fn unpack(words) {
    if type(words)!="array" or len(words)!=3 {throw "Arduino frame requires three uint32 words.";}
    let out=[];
    for word in words {
        if not integer(word,0,4294967295) {throw "Invalid uint32 word.";}
        let remaining=word;let divisor=2147483648;
        for _i 32 {
            let bit=0;if remaining>=divisor {bit=1;remaining=remaining-divisor;}
            push(out,bit);divisor=divisor/2;
        }
    }
    return out;
}
fn animation(frames) {
    if type(frames)!="array" or len(frames)<1 or len(frames)>MAX_FRAMES {throw "Use 1 to 64 frames.";}
    let out=[];let total=0;
    for item in frames {
        if type(item)!="map" or len(map_keys(item))!=2 or not map_has(item,"pixels") or not map_has(item,"duration_ms") {throw "Invalid frame record.";}
        if not integer(item.duration_ms,50,5000) {throw "Frame duration must be 50 to 5000 ms.";}
        total=total+item.duration_ms;if total>MAX_TOTAL_MS {throw "Animation exceeds 60 seconds.";}
        push(out,map{pixels:frame(item.pixels),duration_ms:item.duration_ms});
    }
    return map{format:FORMAT,width:12,height:8,frames:out,total_ms:total};
}
fn validate(document) {
    if type(document)!="map" or len(map_keys(document))!=5 or (try document.format catch nil)!=FORMAT
    or (try document.width catch nil)!=12 or (try document.height catch nil)!=8 {throw "Invalid LED document.";}
    let checked=animation(try document.frames catch nil);
    if (try document.total_ms catch nil)!=checked.total_ms {throw "Invalid total duration.";}
    return checked;
}
fn encode(document) {return json_stringify(validate(document));}
fn decode(text) {
    if type(text)!="string" or len(text)>65536 or len(str_to_bytes(text))>65536 {throw "LED document exceeds 64 KiB.";}
    return validate(json_parse(text));
}
fn arduino_sequence(document) {
    let checked=validate(document);let rows=[];
    for item in checked.frames {let row=pack(item.pixels);push(row,item.duration_ms);push(rows,row);}
    return rows;
}
fn sample(document,elapsed_ms) {
    let checked=validate(document);
    if not integer(elapsed_ms,0,9007199254740991) {throw "Invalid elapsed time.";}
    let elapsed=0;let index=0;
    for item in checked.frames {
        elapsed=elapsed+item.duration_ms;
        if elapsed_ms<elapsed {return map{index:index,finished:false,pixels:item.pixels};}
        index=index+1;
    }
    return map{index:len(checked.frames)-1,finished:true,pixels:checked.frames[len(checked.frames)-1].pixels};
}
fn preset(name) {
    let out=blank();
    if name=="clear" {return out;}
    if name=="full" {return blank(1);}
    if name=="border" {
        for y 8 {for x 12 {if x==0 or x==11 or y==0 or y==7 {out[y*12+x]=1;}}}return out;
    }
    if name=="checker" {for y 8 {for x 12 {out[y*12+x]=(x+y)%2;}}return out;}
    if name=="heart" {
        // Original small 5x7 heart from the existing PBLang font, centered.
        let glyph=Font.glyph(10084);
        for y 7 {for x 5 {out[y*12+x+3]=num_floor(glyph[y]/num_pow(2,4-x))%2;}}return out;
    }
    throw "Unknown LED preset.";
}
fn text_animation(text,duration_ms=100) {
    if type(text)!="string" or len(text)<1 or len(text)>8 {throw "Text requires 1 to 8 supported characters.";}
    if not integer(duration_ms,50,5000) {throw "Frame duration must be 50 to 5000 ms.";}
    let glyphs=[];
    for i len(text) {
        let code=strcharcodeat(text,i);let glyph=Font.glyph(code);
        if code==32 {glyph=[0,0,0,0,0,0,0];}
        if glyph==nil {throw "Unsupported glyph: use Latin, digits or documented symbols/Greek subset.";}
        push(glyphs,glyph);
    }
    let frames=[];let width=len(text)*6;
    for offset width+13 {
        let pixels=blank();
        for i len(glyphs) {for y 7 {for x 5 {
            let column=12-offset+i*6+x;
            if column>=0 and column<12 {pixels[y*12+column]=num_floor(glyphs[i][y]/num_pow(2,4-x))%2;}
        }}}
        push(frames,map{pixels:pixels,duration_ms:duration_ms});
    }
    return animation(frames);
}
export FORMAT,MAX_FRAMES,MAX_TOTAL_MS,integer,frame,blank,pixel,pack,unpack,animation,validate,encode,decode,arduino_sequence,sample,preset,text_animation;
