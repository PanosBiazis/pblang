// Additional diagnostics without changing the existing subtitle statistics contract.
let Subs=import("stdlib:subtitles.sapp"); let Intervals=import("stdlib:interval_analysis.sapp");
fn analyze(doc) {
    Subs.validate(doc); let intervals=[];
    for cue in doc.cues { array_push(intervals,map{start_ms:cue.start_ms,end_ms:cue.end_ms}); }
    return Intervals.analyze(intervals);
}
fn next_overlap(doc,index) {
    Subs.validate(doc);
    if type(index)!="number" or not (index>=0 and index<len(doc.cues)) or index!=num_floor(index) { throw "subtitle timing: invalid index"; }
    let report=analyze(doc);
    for step in range(1,len(doc.cues)+1) {
        let at=num_mod(index+step,len(doc.cues)); if report.overlaps_by_index[at]>0 { return at; }
    }
    return nil;
}
export analyze,next_overlap;
