// Local adapters shared by table tools. New copies only; no overwrite fallback.
let File=import("stdlib:secure_file.sapp"); let CSV=import("stdlib:sheet_csv.sapp"); let Sheet=import("stdlib:sheet_document.sapp");
fn _path(path) { return type(path)=="string" and len(path)>0 and len(path)<=4096 and len(str_to_bytes(path))<=4096 and not str_contains(path,"\u0000"); }
fn open(path,delimiter=",") {
    if not _path(path) { return map{ok:false,error:"Choose a table file path."}; }
    let read=try File.read_text(path,CSV.MAX_INPUT_BYTES,false) catch nil;
    if read==nil or not read.ok { return map{ok:false,error:"Could not read the table."}; }
    let doc=if str_ends_with(str_lower(path),".pbsheet") {try Sheet.decode(read.text) catch nil} else {try CSV.decode(read.text,delimiter) catch nil};
    if doc==nil { return map{ok:false,error:"Unsupported table, delimiter or limits (32 rows, 8 columns)."}; }
    return map{ok:true,document:doc};
}
fn _encode(doc,kind,delimiter) {
    if kind=="sheet" { return Sheet.encode(doc); }
    if kind=="csv" { return CSV.encode(doc,delimiter); }
    throw "unsupported table format";
}
fn save(path,doc,kind="csv",delimiter=",") {
    let extension=".csv"; if delimiter=="\t" { extension=".tsv"; } if kind=="sheet" { extension=".pbsheet"; }
    if not _path(path) or type(kind)!="string" or (kind!="sheet" and kind!="csv")
        or not str_ends_with(str_lower(path),extension) {
        return map{ok:false,error:"Choose a new .pbsheet, .csv or tab-delimited .tsv filename matching the format."};
    }
    let text=try _encode(doc,kind,delimiter) catch nil;
    if text==nil { return map{ok:false,error:"Invalid table or delimiter; nothing written."}; }
    let result=try File.write_text_new_exclusive(path,text,false,false) catch nil;
    if result==nil or not result.ok { return map{ok:false,error:"Copy not confirmed. Use a new filename in an existing folder; failed copies may be incomplete."}; }
    return map{ok:true,atomic_visibility:false};
}
export open,save;
