// stdlib/state_machine.sapp — Finite State Machine (FSM) for pblang.
//
// Usage:
//   let fsm = import("stdlib:state_machine.sapp");
//   let machine = fsm.create("idle", map{
//       idle:    map{ start: "running", reset: "idle" },
//       running: map{ pause: "paused", stop: "idle", error: "failed" },
//       paused:  map{ resume: "running", stop: "idle" },
//       failed:  map{ reset: "idle" }
//   });
//   fsm.send(machine, "start");   // → "running"
//   fsm.send(machine, "pause");   // → "paused"

fn create(initial_state, transitions) {
    return map{
        current: initial_state,
        transitions: transitions,
        history: [initial_state],
        listeners: map{},
        guards: map{}
    };
}

fn current(machine) { return machine.current; }

fn send(machine, event) {
    let state_transitions = try machine.transitions[machine.current] catch nil;
    if state_transitions == nil {
        return error("state_machine: no transitions for state '" + machine.current + "'");
    }
    let next = try state_transitions[event] catch nil;
    if next == nil {
        return error("state_machine: no transition for event '" + event + "' in state '" + machine.current + "'");
    }
    // Check guard
    let guard_key = machine.current + ":" + event;
    let guard = try machine.guards[guard_key] catch nil;
    if guard != nil {
        if guard(machine) == false {
            return error("state_machine: guard blocked transition '" + event + "'");
        }
    }
    let prev = machine.current;
    machine.current = next;
    machine.history[len(machine.history)] = next;
    // Notify listeners
    let listener = try machine.listeners[event] catch nil;
    if listener != nil { listener(prev, next); }
    let enter_listener = try machine.listeners["enter:" + next] catch nil;
    if enter_listener != nil { enter_listener(prev, next); }
    return next;
}

fn can(machine, event) {
    let state_transitions = try machine.transitions[machine.current] catch nil;
    if state_transitions == nil { return false; }
    return map_has(state_transitions, event);
}

fn on(machine, event_or_state, handler) {
    machine.listeners[event_or_state] = handler;
    return machine;
}

fn guard(machine, state, event, guard_fn) {
    machine.guards[state + ":" + event] = guard_fn;
    return machine;
}

fn reset(machine, state) {
    if state == nil { state = machine.history[0]; }
    machine.current = state;
    machine.history = [state];
    return machine;
}

fn history(machine) { return machine.history; }
fn available_events(machine) {
    let state_transitions = try machine.transitions[machine.current] catch map{};
    return map_keys(state_transitions);
}

export create, current, send, can, on, guard, reset, history, available_events;
