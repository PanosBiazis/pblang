// ── 4A. Hellenic Tradition ────────────────────────────────────────────────────

// Archimedes' Method of Exhaustion on inscribed & circumscribed 6 * 2^k regular polygons
// using cancellation-free Borchardt-Pfaff harmonic-geometric recurrence:
//   U_{k+1} = 2 L_k U_k / (L_k + U_k),   L_{k+1} = sqrt(L_k * U_{k+1}),   L_k < pi < U_k.
fn archimedes_pi_bounds(doublings) {
    let k_max = num_round(_f64(doublings, "archimedes_pi_bounds"));
    if k_max < 0 or k_max > 48 {
        throw "archimedes_pi_bounds: doublings must be in [0, 48]";
    }
    // 50-digit BigInt fixed-point scale prevents IEEE-754 53-bit ULP saturation up to k=48
    let scale = bigint(10) ** 50;
    let pi_50 = bigint("314159265358979323846264338327950288419716939937510");
    let L_b = _B3 * scale;                                      // exact 3 * 10^50
    let U_b = _b_isqrt(bigint(12) * scale * scale) + _B1;       // strict upper ceil(2*sqrt(3)*10^50)
    let sides = bigint(6);
    let k = 0;
    while k < k_max {
        let sum_lu = L_b + U_b;
        let U_hi = (_B2 * L_b * U_b + sum_lu - _B1) / sum_lu;   // outward-rounded upper bound
        let U_lo = (_B2 * L_b * U_b) / sum_lu;
        L_b = _b_isqrt(L_b * U_lo);                             // downward-rounded lower bound
        U_b = U_hi;
        sides = sides * _B2;
        k = k + 1;
    }

    let L_str = str(L_b);
    let U_str = str(U_b);
    let L_dec = str_slice(L_str, 0, 1) + "." + str_slice(L_str, 1, 18);
    let U_dec = str_slice(U_str, 0, 1) + "." + str_slice(U_str, 1, 18);
    let L_f = parse_number(L_dec);
    let U_f = parse_number(U_dec);
    let diff_b = U_b - L_b;
    let diff_digits = len(str(diff_b));
    let width_f = if diff_b == _B0 {
        0.0
    } else if diff_digits <= 15 {
        parse_number(str(diff_b)) * num_exp((0.0 - 50.0) * num_ln(10.0))
    } else {
        let lead15 = parse_number(str_slice(str(diff_b), 0, 15));
        lead15 * num_exp(((diff_digits - 15) - 50.0) * num_ln(10.0))
    };

    return map{
        doublings: k_max,
        polygon_sides: str(sides),
        lower_bound: L_f,
        upper_bound: U_f,
        lower_decimal_40: str_slice(L_str, 0, 1) + "." + str_slice(L_str, 1, 41),
        upper_decimal_40: str_slice(U_str, 0, 1) + "." + str_slice(U_str, 1, 41),
        midpoint: 0.5 * (L_f + U_f),
        bound_width: width_f,
        strictly_brackets_pi: (L_b < pi_50 and pi_50 < U_b),
        archimedes_classic_96gon_verified: (L_b * bigint(71) > bigint(223) * scale or k_max < 4) and (U_b * bigint(7) < bigint(22) * scale or k_max < 4)
    };
}

// Finds a non-zero nullspace vector v of a d x k matrix M with k >= d + 1 via full-row-pivoted RREF
fn _underdetermined_nullvector(M, d, k) {
    let R = LA.mat_copy(M);
    let pivot_col_for_row = [];
    let is_pivot_col = [];
    let c = 0;
    while c < k { array_push(is_pivot_col, false); c = c + 1; }

    let r = 0;
    let col = 0;
    while r < d and col < k {
        let best_r = r;
        let best_v = num_abs(R[r][col]);
        let rr = r + 1;
        while rr < d {
            if num_abs(R[rr][col]) > best_v {
                best_v = num_abs(R[rr][col]);
                best_r = rr;
            }
            rr = rr + 1;
        }
        if best_v <= 1e-13 {
            col = col + 1;
        } else {
            if best_r != r {
                let tmp = R[r];
                R[r] = R[best_r];
                R[best_r] = tmp;
            }
            let piv = R[r][col];
            let cc = col;
            while cc < k {
                R[r][cc] = R[r][cc] / piv;
                cc = cc + 1;
            }
            let i = 0;
            while i < d {
                if i != r and num_abs(R[i][col]) > 0.0 {
                    let fac = R[i][col];
                    cc = col;
                    while cc < k {
                        R[i][cc] = R[i][cc] - fac * R[r][cc];
                        cc = cc + 1;
                    }
                    R[i][col] = 0.0;
                }
                i = i + 1;
            }
            array_push(pivot_col_for_row, col);
            is_pivot_col[col] = true;
            r = r + 1;
            col = col + 1;
        }
    }

    // Pick first free column (guaranteed to exist since k >= d + 1 > r)
    let free_col = -1;
    c = 0;
    while c < k and free_col < 0 {
        if not is_pivot_col[c] { free_col = c; }
        c = c + 1;
    }

    let v = [];
    c = 0;
    while c < k { array_push(v, 0.0); c = c + 1; }
    v[free_col] = 1.0;

    let pr = 0;
    while pr < len(pivot_col_for_row) {
        let pc = pivot_col_for_row[pr];
        v[pc] = 0.0 - R[pr][free_col];
        pr = pr + 1;
    }
    return v;
}

// Constantin Caratheodory's Theorem (1907) Constructive Convex Reduction:
// Given m points in R^d and convex weights lambda_i >= 0, sum lambda_i = 1 with p = sum lambda_i x_i,
// iteratively eliminates affinely dependent points until <= d + 1 positive weights remain with exact sum = p.
fn caratheodory_convex_reduction(points_d, weights) {
    if type(points_d) != "array" or len(points_d) == 0 or type(weights) != "array" or len(points_d) != len(weights) {
        throw "caratheodory_convex_reduction: points_d and weights must be equal-length non-empty arrays";
    }
    let m = len(points_d);
    if m > MAX_DIM * 4 {
        throw "caratheodory_convex_reduction: point count exceeds bound";
    }
    if type(points_d[0]) != "array" or len(points_d[0]) == 0 {
        throw "caratheodory_convex_reduction: each point must be a d-dimensional array";
    }
    let d = len(points_d[0]);
    if d > MAX_DIM {
        throw "caratheodory_convex_reduction: dimension d exceeds MAX_DIM";
    }

    let pts = [];
    let lam = [];
    let sum_w = 0.0;
    let i = 0;
    while i < m {
        if type(points_d[i]) != "array" or len(points_d[i]) != d {
            throw "caratheodory_convex_reduction: inconsistent point dimension";
        }
        let p_row = [];
        let c = 0;
        while c < d {
            array_push(p_row, _f64(points_d[i][c], "caratheodory"));
            c = c + 1;
        }
        let wi = _f64(weights[i], "caratheodory");
        if wi < -1e-12 {
            throw "caratheodory_convex_reduction: convex weights must be >= 0";
        }
        if wi < 0.0 { wi = 0.0; }
        array_push(pts, p_row);
        array_push(lam, wi);
        sum_w = sum_w + wi;
        i = i + 1;
    }
    if num_abs(sum_w - 1.0) > 1e-8 {
        throw "caratheodory_convex_reduction: convex weights must sum to 1 (got " + str(sum_w) + ")";
    }
    // Normalize initial weights to exact unit sum
    i = 0;
    while i < m { lam[i] = lam[i] / sum_w; i = i + 1; }

    // Target convex combination p = sum_{i=0}^{m-1} lam[i] * pts[i]
    let target_p = [];
    let c = 0;
    while c < d {
        let s = 0.0;
        i = 0;
        while i < m { s = s + lam[i] * pts[i][c]; i = i + 1; }
        array_push(target_p, s);
        c = c + 1;
    }

    let guard = 0;
    let done = false;
    while not done and guard <= m + 4 {
        guard = guard + 1;
        let active = [];
        i = 0;
        while i < m {
            if lam[i] > 1e-15 { array_push(active, i); } else { lam[i] = 0.0; }
            i = i + 1;
        }
        if len(active) <= d + 1 {
            done = true;
        } else {
            // Take first (d + 2) active points: guaranteed affinely dependent in R^d!
            let idx0 = active[0];
            let M = LA.mat_zeros(d, d + 1);
            let j = 0;
            while j < d + 1 {
                let idx_j = active[j + 1];
                c = 0;
                while c < d {
                    M[c][j] = pts[idx_j][c] - pts[idx0][c];
                    c = c + 1;
                }
                j = j + 1;
            }
            let v = _underdetermined_nullvector(M, d, d + 1);
            // Affine dependence delta on the (d + 2) active indices: sum delta == 0, sum delta_r x_r == 0
            let delta = [];
            let sum_v = 0.0;
            j = 0;
            while j < d + 1 { sum_v = sum_v + v[j]; j = j + 1; }
            array_push(delta, 0.0 - sum_v);
            j = 0;
            while j < d + 1 { array_push(delta, v[j]); j = j + 1; }

            // Ensure at least one delta[r] > 0 so subtracting theta * delta drives a weight to 0
            let has_pos = false;
            j = 0;
            while j < d + 2 {
                if delta[j] > 1e-14 { has_pos = true; }
                j = j + 1;
            }
            if not has_pos {
                j = 0;
                while j < d + 2 { delta[j] = 0.0 - delta[j]; j = j + 1; }
            }

            let best_theta = 1e300;
            let drop_local = -1;
            j = 0;
            while j < d + 2 {
                if delta[j] > 1e-15 {
                    let ratio = lam[active[j]] / delta[j];
                    if ratio < best_theta {
                        best_theta = ratio;
                        drop_local = j;
                    }
                }
                j = j + 1;
            }
            j = 0;
            while j < d + 2 {
                let g_idx = active[j];
                if j == drop_local {
                    lam[g_idx] = 0.0;
                } else {
                    lam[g_idx] = _max2(0.0, lam[g_idx] - best_theta * delta[j]);
                }
                j = j + 1;
            }
        }
    }

    let final_active_indices = [];
    let final_active_points = [];
    let final_active_weights = [];
    i = 0;
    while i < m {
        if lam[i] > 1e-15 {
            array_push(final_active_indices, i);
            array_push(final_active_points, pts[i]);
            array_push(final_active_weights, lam[i]);
        } else {
            lam[i] = 0.0;
        }
        i = i + 1;
    }

    let recon_p = [];
    let err_sq = 0.0;
    c = 0;
    while c < d {
        let s = 0.0;
        i = 0;
        while i < m { s = s + lam[i] * pts[i][c]; i = i + 1; }
        array_push(recon_p, s);
        let df = s - target_p[c];
        err_sq = err_sq + df * df;
        c = c + 1;
    }

    return map{
        target_point: target_p,
        reconstructed_point: recon_p,
        weights: lam,
        active_indices: final_active_indices,
        active_points: final_active_points,
        active_weights: final_active_weights,
        support_size: len(final_active_indices),
        caratheodory_bound: d + 1,
        reconstruction_error: num_sqrt(err_sq)
    };
}

// Heron of Alexandria (*Metrica* I.8) Exact Rational Area^2 & Exact Rational Area (when Heronian)
fn heron_area_exact(a, b, c) {
    let ra = _to_ex_rat(a);
    let rb = _to_ex_rat(b);
    let rc = _to_ex_rat(c);
    let zero = EX.rat(0, 1);
    if EX.rat_cmp(ra, zero) <= 0 or EX.rat_cmp(rb, zero) <= 0 or EX.rat_cmp(rc, zero) <= 0 {
        throw "heron_area_exact: side lengths must be > 0";
    }
    let s = EX.rat_div(EX.rat_add(EX.rat_add(ra, rb), rc), EX.rat(2, 1));
    let sa = EX.rat_sub(s, ra);
    let sb = EX.rat_sub(s, rb);
    let sc = EX.rat_sub(s, rc);
    if EX.rat_cmp(sa, zero) < 0 or EX.rat_cmp(sb, zero) < 0 or EX.rat_cmp(sc, zero) < 0 {
        throw "heron_area_exact: side lengths violate triangle inequality";
    }

    let area_sq = EX.rat_mul(EX.rat_mul(s, sa), EX.rat_mul(sb, sc));
    let sn = _b_isqrt(area_sq.num);
    let sd = _b_isqrt(area_sq.den);
    let is_heronian = (sn * sn == area_sq.num) and (sd * sd == area_sq.den);
    let exact_area = if is_heronian { EX.rat(sn, sd) } else { nil };

    return map{
        semiperimeter: s,
        area_squared: area_sq,
        area_squared_str: EX.rat_to_str(area_sq),
        is_rational_area: is_heronian,
        exact_area: exact_area,
        exact_area_str: if is_heronian { EX.rat_to_str(exact_area) } else { "sqrt(" + EX.rat_to_str(area_sq) + ")" },
        area_float: num_sqrt(EX.rat_to_float(area_sq))
    };
}

// Diophantus (*Arithmetica* II.8) Rational Parametrization of x^2 + y^2 = 1 for t = t_num / t_den
fn diophantus_circle_parametrization(t_num, t_den) {
    let p = _to_bigint(t_num, "diophantus_circle_parametrization");
    let q = _to_bigint(t_den, "diophantus_circle_parametrization");
    if q == _B0 {
        throw "diophantus_circle_parametrization: t_den must be non-zero";
    }
    let t = EX.rat(p, q);
    let t2 = EX.rat_mul(t, t);
    let one = EX.rat(1, 1);
    let denom = EX.rat_add(one, t2);
    let x = EX.rat_div(EX.rat_sub(one, t2), denom);
    let y = EX.rat_div(EX.rat_mul(EX.rat(2, 1), t), denom);
    let check_sum = EX.rat_add(EX.rat_mul(x, x), EX.rat_mul(y, y));

    let a_leg = _b_abs(q * q - p * p);
    let b_leg = _b_abs(_B2 * p * q);
    let c_hyp = q * q + p * p;
    let g = _b_gcd(_b_gcd(a_leg, b_leg), c_hyp);

    return map{
        t: t,
        x: x,
        y: y,
        x_str: EX.rat_to_str(x),
        y_str: EX.rat_to_str(y),
        on_unit_circle: EX.rat_eq(check_sum, one),
        primitive_pythagorean_triple: [a_leg / g, b_leg / g, c_hyp / g]
    };
}

// ── 4B. Indian Tradition: Chakravala, Ramanujan 1914 & Madhava ───────────────

// Brahmagupta (628 CE) – Jayadeva – Bhaskara II (1150 CE) Cyclic `Chakravala` Pell Solver:
// Solves x^2 - N * y^2 = 1 in exact BigInt via minimal |m^2 - N| multiplier selection.
fn chakravala_pell(N) {
    let n_b = _to_bigint(N, "chakravala_pell");
    if n_b <= _B1 {
        throw "chakravala_pell: N must be an integer > 1";
    }
    let s = _b_isqrt(n_b);
    if s * s == n_b {
        throw "chakravala_pell: N=" + str(n_b) + " is a perfect square (no non-trivial Pell solution)";
    }

    // Choose initial a_0 closest to sqrt(N) minimizing |a_0^2 - N|
    let d_lo = n_b - s * s;
    let d_hi = (s + _B1) * (s + _B1) - n_b;
    let a = if d_lo <= d_hi { s } else { s + _B1 };
    let b = _B1;
    let k = a * a - n_b;

    let steps = 0;
    while k != _B1 {
        steps = steps + 1;
        if steps > MAX_STEPS {
            throw "chakravala_pell: iteration count exceeded MAX_STEPS";
        }
        let K = _b_abs(k);
        let m0 = _B1;
        if K > _B1 {
            // Solve a + b * m === 0 (mod K)
            let g = _b_gcd(b, K);
            let K_red = K / g;
            let b_red = (b / g) % K_red;
            let rhs = _b_mod((_B0 - a) / g, K_red);
            let inv_b = EX.mod_inv(b_red, K_red);
            m0 = (rhs * inv_b) % K_red;
            if m0 == _B0 { m0 = K_red; }
            K = K_red;
        }

        // Select m = m0 + q * K > 0 minimizing |m^2 - N|
        let q_base = (s - m0) / K;
        let best_m = nil;
        let best_diff = nil;
        let dq = -2;
        while dq <= 3 {
            let cand = m0 + (q_base + bigint(dq)) * K;
            if cand > _B0 {
                let diff = _b_abs(cand * cand - n_b);
                if best_diff == nil or diff < best_diff {
                    best_diff = diff;
                    best_m = cand;
                }
            }
            dq = dq + 1;
        }

        let K_abs = _b_abs(k);
        let a_next = (a * best_m + n_b * b) / K_abs;
        let b_next = (a + b * best_m) / K_abs;
        let k_next = (best_m * best_m - n_b) / k;
        a = a_next;
        b = b_next;
        k = k_next;
    }

    let check_pell = (a * a - n_b * b * b == _B1);
    return map{
        N: n_b,
        x: a,
        y: b,
        x_str: str(a),
        y_str: str(b),
        iterations: steps,
        verified: check_pell
    };
}

// Ramanujan's Proven 1914 Modular Series:
//   1/pi = (2*sqrt(2)/9801) * sum_{k=0}^{T-1} ((4k)! * (1103 + 26390*k)) / ((k!)^4 * 396^(4k))
// Computed in exact BigRat + 80-digit BigInt fixed-point sqrt(2) (~8 decimal digits per term!).
fn ramanujan_1914_pi(terms) {
    let T = num_round(_f64(terms, "ramanujan_1914_pi"));
    if T < 1 or T > 64 {
        throw "ramanujan_1914_pi: terms must be in [1, 64]";
    }

    let sum_rat = EX.rat(0, 1);
    let fact_4k = _B1;
    let fact_k = _B1;
    let pow_396_4k = _B1;
    let b_396_4 = bigint(396) ** 4;

    let k = 0;
    while k < T {
        if k > 0 {
            let kk = bigint(k);
            let base4 = bigint(4 * k);
            fact_4k = fact_4k * (base4 - _B3) * (base4 - _B2) * (base4 - _B1) * base4;
            fact_k = fact_k * kk;
            pow_396_4k = pow_396_4k * b_396_4;
        }
        let lin = bigint(1103) + bigint(26390) * bigint(k);
        let numer = fact_4k * lin;
        let fk4 = fact_k * fact_k * fact_k * fact_k;
        let denom = fk4 * pow_396_4k;
        sum_rat = EX.rat_add(sum_rat, EX.rat(numer, denom));
        k = k + 1;
    }

    // 80-digit fixed-point decimal evaluation of pi = (9801 * den) / (2 * sqrt(2) * num)
    let digits = 80;
    let scale = bigint(10) ** digits;
    let sqrt2_scaled = _b_isqrt(_B2 * scale * scale); // floor(sqrt(2) * 10^80)
    let pi_scaled = (bigint(9801) * sum_rat.den * scale * scale) / (_B2 * sqrt2_scaled * sum_rat.num);
    let pi_raw = str(pi_scaled);
    let int_part = str_slice(pi_raw, 0, 1);
    let frac_part = str_slice(pi_raw, 1, 1 + 50); // 50 verified fractional digits capacity
    let pi_dec = int_part + "." + frac_part;

    let inv_pi_f = (2.0 * num_sqrt(2.0) / 9801.0) * EX.rat_to_float(sum_rat);
    let pi_f = 1.0 / inv_pi_f;

    return map{
        terms: T,
        pi_approx: pi_f,
        pi_decimal_50: pi_dec,
        abs_error_float: num_abs(pi_f - PI),
        exact_rational_sum: sum_rat
    };
}

// Madhava of Sangamagrama (c. 1400 CE) Kerala School Pi Series with 3rd-order Rational End-Term Correction:
//   pi/4 ~= sum_{k=0}^{n-1} (-1)^k / (2k + 1) + (-1)^n * (n^2 + 1) / (4*n^3 + 5*n)
fn madhava_corrected_pi(n_terms) {
    let n = num_round(_f64(n_terms, "madhava_corrected_pi"));
    if n < 1 or n > MAX_STEPS {
        throw "madhava_corrected_pi: n_terms must be in [1, " + str(MAX_STEPS) + "]";
    }

    let leibniz_q = 0.0;
    let sgn = 1.0;
    let k = 0;
    while k < n {
        leibniz_q = leibniz_q + sgn / (2.0 * k + 1.0);
        sgn = 0.0 - sgn;
        k = k + 1;
    }
    let nf = n * 1.0;
    let f1 = 1.0 / (4.0 * nf);
    let f2 = nf / (4.0 * nf * nf + 1.0);
    let f3 = (nf * nf + 1.0) / (4.0 * nf * nf * nf + 5.0 * nf);

    let pi_uncorr = 4.0 * leibniz_q;
    let pi_c1 = 4.0 * (leibniz_q + sgn * f1);
    let pi_c2 = 4.0 * (leibniz_q + sgn * f2);
    let pi_c3 = 4.0 * (leibniz_q + sgn * f3);

    return map{
        n_terms: n,
        pi_uncorrected: pi_uncorr,
        pi_madhava_order1: pi_c1,
        pi_madhava_order2: pi_c2,
        pi_approx: pi_c3,
        uncorrected_error: num_abs(pi_uncorr - PI),
        corrected_error: num_abs(pi_c3 - PI)
    };
}

// ── 4C. Chinese & Japanese (Wasan) Tradition ─────────────────────────────────

// Seki Takakazu (1681) / Alexander Aitken (1926) Delta^2 Sequence Acceleration
// with guarded 0/0 plateau skip when sequence has already converged!
fn seki_aitken_delta2(seq) {
    if type(seq) != "array" or len(seq) < 3 {
        throw "seki_aitken_delta2: require at least 3 sequence elements";
    }
    let n = len(seq);
    if n > MAX_SIGNAL_LEN {
        throw "seki_aitken_delta2: sequence length exceeds MAX_SIGNAL_LEN";
    }
    let s = [];
    let i = 0;
    while i < n {
        array_push(s, _f64(seq[i], "seki_aitken_delta2"));
        i = i + 1;
    }

    let acc = [];
    let skips = 0;
    i = 0;
    while i <= n - 3 {
        let s0 = s[i];
        let s1 = s[i + 1];
        let s2 = s[i + 2];
        let d1 = s1 - s0;
        let d2 = s2 - 2.0 * s1 + s0;
        let scale = 1.0 + num_abs(s0) + num_abs(s1) + num_abs(s2);
        if num_abs(d2) <= 1e-15 * scale or num_abs(d1) <= 1e-16 * scale {
            array_push(acc, s2);
            skips = skips + 1;
        } else {
            array_push(acc, s0 - (d1 * d1) / d2);
        }
        i = i + 1;
    }

    return map{
        accelerated: acc,
        estimate: acc[len(acc) - 1],
        raw_last: s[n - 1],
        plateau_skips: skips
    };
}

// Seki Takakazu (1683) / J. J. Sylvester (1840) Exact Polynomial Resultant Res(A, B) over Q
fn sylvester_resultant(poly_A, poly_B) {
    if type(poly_A) != "array" or len(poly_A) == 0 or type(poly_B) != "array" or len(poly_B) == 0 {
        throw "sylvester_resultant: poly_A and poly_B must be non-empty descending coefficient arrays";
    }

    let A = [];
    let i = 0;
    while i < len(poly_A) { array_push(A, _to_la_rat(poly_A[i])); i = i + 1; }
    let B = [];
    i = 0;
    while i < len(poly_B) { array_push(B, _to_la_rat(poly_B[i])); i = i + 1; }

    let ia = 0;
    while ia < len(A) - 1 and LA.rat_is_zero(A[ia]) { ia = ia + 1; }
    let ib = 0;
    while ib < len(B) - 1 and LA.rat_is_zero(B[ib]) { ib = ib + 1; }

    let Ac = [];
    while ia < len(A) { array_push(Ac, A[ia]); ia = ia + 1; }
    let Bc = [];
    while ib < len(B) { array_push(Bc, B[ib]); ib = ib + 1; }

    let m = len(Ac) - 1;
    let n = len(Bc) - 1;
    if m + n > 64 {
        throw "sylvester_resultant: combined degree m + n exceeds bound 64";
    }

    if LA.rat_is_zero(Ac[0]) or LA.rat_is_zero(Bc[0]) {
        let z = LA.rat(0, 1);
        return map{ resultant: z, resultant_str: "0", resultant_float: 0.0, has_common_root: true, sylvester_dim: 0 };
    }
    if m == 0 and n == 0 {
        let one = LA.rat(1, 1);
        return map{ resultant: one, resultant_str: "1", resultant_float: 1.0, has_common_root: false, sylvester_dim: 0 };
    }
    if m == 0 {
        let r_m0 = EX.rat_pow(_to_ex_rat(Ac[0]), n);
        let lr = LA.rat(r_m0.num, r_m0.den);
        return map{ resultant: lr, resultant_str: lr.str, resultant_float: LA.rat_to_float(lr), has_common_root: false, sylvester_dim: n };
    }
    if n == 0 {
        let r_n0 = EX.rat_pow(_to_ex_rat(Bc[0]), m);
        let lr = LA.rat(r_n0.num, r_n0.den);
        return map{ resultant: lr, resultant_str: lr.str, resultant_float: LA.rat_to_float(lr), has_common_root: false, sylvester_dim: m };
    }

    let dim = m + n;
    let z_rat = LA.rat(0, 1);
    let S = [];
    let r = 0;
    while r < dim {
        let row = [];
        let c = 0;
        while c < dim { array_push(row, z_rat); c = c + 1; }
        array_push(S, row);
        r = r + 1;
    }

    // First n rows: shifted coefficients of A
    r = 0;
    while r < n {
        let k = 0;
        while k <= m {
            S[r][r + k] = Ac[k];
            k = k + 1;
        }
        r = r + 1;
    }
    // Next m rows: shifted coefficients of B
    r = 0;
    while r < m {
        let k = 0;
        while k <= n {
            S[n + r][r + k] = Bc[k];
            k = k + 1;
        }
        r = r + 1;
    }

    let det_res = LA.det_exact(S);
    return map{
        resultant: det_res,
        resultant_str: det_res.str,
        resultant_float: LA.rat_to_float(det_res),
        has_common_root: LA.rat_is_zero(det_res),
        sylvester_dim: dim,
        sylvester_matrix: S
    };
}

// ── 4D. Islamic Golden Age / Persian / Arab Tradition ────────────────────────

// Nasir al-Din al-Tusi (1260 CE) Spherical Triangle Solver (SAS: sides a, b and included angle C)
// + Albert Girard Spherical Excess Area E = A + B + C - pi on unit sphere S^2
fn al_tusi_spherical_triangle(a_rad, b_rad, C_rad) {
    let a = _f64(a_rad, "al_tusi_spherical_triangle");
    let b = _f64(b_rad, "al_tusi_spherical_triangle");
    let C = _f64(C_rad, "al_tusi_spherical_triangle");
    if a <= 0.0 or a >= PI or b <= 0.0 or b >= PI or C <= 0.0 or C >= PI {
        throw "al_tusi_spherical_triangle: sides a, b and angle C must lie strictly in (0, pi)";
    }

    let ca = num_cos(a);
    let sa = num_sin(a);
    let cb = num_cos(b);
    let sb = num_sin(b);
    let cC = num_cos(C);
    let sC = num_sin(C);

    let cos_c = _clamp(ca * cb + sa * sb * cC, -1.0, 1.0);
    let sc = num_sqrt(_max2(0.0, 1.0 - cos_c * cos_c));
    let c = num_atan2(sc, cos_c);
    if sc <= 1e-15 {
        throw "al_tusi_spherical_triangle: degenerate collinear spherical triangle";
    }

    // Quadrant-exact interior angles A, B via atan2(sin A * sb * sc, cos A * sb * sc)
    let A = num_atan2(sa * sb * sC, ca - cb * cos_c);
    let B = num_atan2(sa * sb * sC, cb - ca * cos_c);
    let excess = A + B + C - PI;

    let ratio_a = sa / num_sin(A);
    let ratio_b = sb / num_sin(B);
    let ratio_c = sc / sC;
    let sine_law_err = _max2(num_abs(ratio_a - ratio_b), num_abs(ratio_b - ratio_c));

    return map{
        side_a_rad: a,
        side_b_rad: b,
        side_c_rad: c,
        angle_A_rad: A,
        angle_B_rad: B,
        angle_C_rad: C,
        spherical_excess_rad: excess,
        unit_sphere_area: excess,
        sine_law_ratio: ratio_c,
        sine_law_residual: sine_law_err
    };
}

// Jamshid al-Kashi (*Risala al-watar wa'l-jaib*, c. 1424 CE) Contraction Iteration for sin(1 deg):
// 1. Computes sin(3 deg) = sin(18 deg - 15 deg) purely from exact square-root radicals
// 2. Solves sin(3 deg) = 3*x - 4*x^3 via Al-Kashi's fixed-point map x_{k+1} = (sin(3 deg) + 4*x_k^3) / 3
fn al_kashi_cubic_trig_sin1deg() {
    let s5 = num_sqrt(5.0);
    let s6 = num_sqrt(6.0);
    let s2 = num_sqrt(2.0);

    let sin18 = (s5 - 1.0) / 4.0;
    let cos18 = num_sqrt(10.0 + 2.0 * s5) / 4.0;
    let sin15 = (s6 - s2) / 4.0;
    let cos15 = (s6 + s2) / 4.0;
    let sin3_exact_radicals = sin18 * cos15 - cos18 * sin15;

    let x = sin3_exact_radicals / 3.0;
    let iterates = [x];
    let it = 0;
    let done = false;
    while it < 32 and not done {
        it = it + 1;
        let x_next = (sin3_exact_radicals + 4.0 * x * x * x) / 3.0;
        array_push(iterates, x_next);
        if num_abs(x_next - x) <= 1e-16 {
            done = true;
        }
        x = x_next;
    }

    let ref_sin1 = num_sin(PI / 180.0);
    let cubic_res = num_abs((3.0 * x - 4.0 * x * x * x) - sin3_exact_radicals);
    return map{
        sin_1deg: x,
        sin_3deg_radicals: sin3_exact_radicals,
        reference_sin_1deg: ref_sin1,
        abs_error: num_abs(x - ref_sin1),
        cubic_residual: cubic_res,
        iterations: it,
        iterates: iterates
    };
}

// ── 4E. Egyptian & Mesopotamian Tradition ────────────────────────────────────

// Fibonacci (1202) – Sylvester (1880) Greedy Egyptian Unit Fraction Expansion p/q = sum 1/n_i
fn egyptian_greedy_unit_fractions(p, q) {
    let p_b = _to_bigint(p, "egyptian_greedy_unit_fractions");
    let q_b = _to_bigint(q, "egyptian_greedy_unit_fractions");
    if p_b <= _B0 or q_b <= _B0 {
        throw "egyptian_greedy_unit_fractions: require positive integers p > 0, q > 0";
    }
    let g0 = _b_gcd(p_b, q_b);
    let num_cur = p_b / g0;
    let den_cur = q_b / g0;
    let target_rat = EX.rat(num_cur, den_cur);

    let int_part = num_cur / den_cur;
    num_cur = num_cur % den_cur;

    let denoms = [];
    let unit_rats = [];
    let sum_rat = EX.rat(int_part, _B1);
    let steps = 0;
    while num_cur > _B0 {
        steps = steps + 1;
        if steps > 512 {
            throw "egyptian_greedy_unit_fractions: expansion length exceeded 512 steps";
        }
        // Ceiling division n_i = ceil(den_cur / num_cur)
        let n_i = (den_cur + num_cur - _B1) / num_cur;
        array_push(denoms, n_i);
        let ur = EX.rat(_B1, n_i);
        array_push(unit_rats, ur);
        sum_rat = EX.rat_add(sum_rat, ur);

        let next_num = num_cur * n_i - den_cur;
        let next_den = den_cur * n_i;
        if next_num > _B0 {
            let g = _b_gcd(next_num, next_den);
            num_cur = next_num / g;
            den_cur = next_den / g;
        } else {
            num_cur = _B0;
        }
    }

    let denom_strs = [];
    let i = 0;
    while i < len(denoms) {
        array_push(denom_strs, str(denoms[i]));
        i = i + 1;
    }

    return map{
        input_rational: target_rat,
        integer_part: int_part,
        denominators: denoms,
        denominator_strings: denom_strs,
        unit_fractions: unit_rats,
        reconstructed_sum: sum_rat,
        exact_verified: EX.rat_eq(sum_rat, target_rat)
    };
}

// ── 4F. Russian/Soviet (Tikhonov), Polish (Banach) & Hungarian (Erdos-Gallai)

// Andrey Tikhonov (1943/1963) Regularization (A^T A + lambda^2 I) x = A^T b
// solved stably via SVD with Golub-Heath-Wahba (1979) Generalized Cross-Validation (GCV) lambda* selection.
fn tikhonov_regularized_solve(A, b, lambda_grid = nil) {
    let MA = LA.mat_copy(A);
    let m = len(MA);
    let n = len(MA[0]);
    if type(b) != "array" or len(b) != m {
        throw "tikhonov_regularized_solve: vector b length must match rows of A";
    }
    let b_vec = [];
    let b_norm_sq = 0.0;
    let i = 0;
    while i < m {
        let bi = _f64(b[i], "tikhonov");
        array_push(b_vec, bi);
        b_norm_sq = b_norm_sq + bi * bi;
        i = i + 1;
    }

    let s = LA.svd(MA);
    let sv = s.singular_values;
    let r = len(sv);
    let sigma_max = if r > 0 and sv[0] > 0.0 { sv[0] } else { 1.0 };

    // Project b onto left singular vectors u_k: c_k = u_k^T b
    let c_proj = [];
    let proj_sq = 0.0;
    let k = 0;
    while k < r {
        let ck = 0.0;
        i = 0;
        while i < m {
            ck = ck + s.U[i][k] * b_vec[i];
            i = i + 1;
        }
        array_push(c_proj, ck);
        proj_sq = proj_sq + ck * ck;
        k = k + 1;
    }
    let r_perp_sq = _max2(0.0, b_norm_sq - proj_sq);

    // Build candidate lambda grid
    let cands = [];
    if lambda_grid == nil {
        let g_idx = 0;
        while g_idx <= 60 {
            let exp10 = -10.0 + (12.0 * g_idx) / 60.0;
            array_push(cands, sigma_max * num_exp(exp10 * num_ln(10.0)));
            g_idx = g_idx + 1;
        }
    } else if type(lambda_grid) == "number" {
        let lv = _f64(lambda_grid, "tikhonov");
        if lv <= 0.0 { throw "tikhonov_regularized_solve: lambda must be > 0"; }
        array_push(cands, lv);
    } else if type(lambda_grid) == "array" and len(lambda_grid) > 0 {
        i = 0;
        while i < len(lambda_grid) {
            let lv = _f64(lambda_grid[i], "tikhonov");
            if lv <= 0.0 { throw "tikhonov_regularized_solve: all lambda candidates must be > 0"; }
            array_push(cands, lv);
            i = i + 1;
        }
    } else {
        throw "tikhonov_regularized_solve: lambda_grid must be nil, positive number, or non-empty array";
    }

    let best_lam = cands[0];
    let best_gcv = 1e300;
    let gcv_scores = [];

    i = 0;
    while i < len(cands) {
        let lam = cands[i];
        let lam2 = lam * lam;
        let res_sq = r_perp_sq;
        let tr_I_minus_H = (m - r) * 1.0;
        k = 0;
        while k < r {
            let sig2 = sv[k] * sv[k];
            let denom = sig2 + lam2;
            let one_minus_f = lam2 / denom;
            res_sq = res_sq + (one_minus_f * one_minus_f) * (c_proj[k] * c_proj[k]);
            tr_I_minus_H = tr_I_minus_H + one_minus_f;
            k = k + 1;
        }
        let gcv = if tr_I_minus_H > 1e-14 { (m * res_sq) / (tr_I_minus_H * tr_I_minus_H) } else { 1e300 };
        array_push(gcv_scores, gcv);
        if gcv < best_gcv {
            best_gcv = gcv;
            best_lam = lam;
        }
        i = i + 1;
    }

    // Reconstruct x_{lambda*} = sum_{k=0}^{r-1} (sigma_k / (sigma_k^2 + lambda*^2)) c_k v_k
    let lam2_opt = best_lam * best_lam;
    let x_sol = [];
    let j = 0;
    while j < n { array_push(x_sol, 0.0); j = j + 1; }
    k = 0;
    while k < r {
        let w_k = (sv[k] * c_proj[k]) / (sv[k] * sv[k] + lam2_opt);
        j = 0;
        while j < n {
            x_sol[j] = x_sol[j] + w_k * s.Vt[k][j];
            j = j + 1;
        }
        k = k + 1;
    }

    let ax = LA.mat_vec_mul(MA, x_sol);
    let res_vec = [];
    i = 0;
    while i < m { array_push(res_vec, ax[i] - b_vec[i]); i = i + 1; }

    return map{
        x: x_sol,
        lambda_opt: best_lam,
        gcv_min: best_gcv,
        residual_norm: _vec_norm2(res_vec),
        solution_norm: _vec_norm2(x_sol),
        singular_values: sv,
        gcv_scores: gcv_scores
    };
}

// Paul Erdos & Tibor Gallai Theorem (1960): Exact Graphical Degree Sequence Characterization
fn erdos_gallai_is_graphical(deg_seq) {
    if type(deg_seq) != "array" {
        throw "erdos_gallai_is_graphical: deg_seq must be an array of integers";
    }
    let n = len(deg_seq);
    if n > MAX_DIM * 4 {
        throw "erdos_gallai_is_graphical: sequence length exceeds bound";
    }
    if n == 0 {
        return map{ is_graphical: true, sorted_degrees: [], sum_degrees: 0, sum_is_even: true, failed_k: nil };
    }

    let d = [];
    let sum_d = 0;
    let has_invalid_entry = false;
    let i = 0;
    while i < n {
        let di = num_round(_f64(deg_seq[i], "erdos_gallai"));
        if di != _f64(deg_seq[i], "erdos_gallai") or di < 0 or di >= n {
            has_invalid_entry = true;
        }
        array_push(d, di);
        sum_d = sum_d + di;
        i = i + 1;
    }

    // Sort descending d_0 >= d_1 >= ... >= d_{n-1}
    let a = 1;
    while a < n {
        let key = d[a];
        let b = a - 1;
        while b >= 0 and d[b] < key {
            d[b + 1] = d[b];
            b = b - 1;
        }
        d[b + 1] = key;
        a = a + 1;
    }

    if has_invalid_entry or (sum_d % 2) != 0 {
        return map{
            is_graphical: false,
            sorted_degrees: d,
            sum_degrees: sum_d,
            sum_is_even: ((sum_d % 2) == 0),
            failed_k: 0
        };
    }

    let lhs_prefix = 0;
    let failed_k = nil;
    let k = 1;
    while k <= n and failed_k == nil {
        lhs_prefix = lhs_prefix + d[k - 1];
        let rhs = k * (k - 1);
        let j = k;
        while j < n {
            rhs = rhs + _min2(d[j], k);
            j = j + 1;
        }
        if lhs_prefix > rhs {
            failed_k = k;
        }
        k = k + 1;
    }

    return map{
        is_graphical: (failed_k == nil),
        sorted_degrees: d,
        sum_degrees: sum_d,
        sum_is_even: true,
        failed_k: failed_k
    };
}

// Vaclav Havel (1955) & S. L. Hakimi (1962) Constructive Simple Graph Realization
fn havel_hakimi_construct_graph(deg_seq) {
    let eg = erdos_gallai_is_graphical(deg_seq);
    let n = len(deg_seq);
    if not eg.is_graphical {
        return map{
            ok: false,
            is_graphical: false,
            vertex_count: n,
            edge_count: 0,
            edges: [],
            adjacency_matrix: []
        };
    }
    if n == 0 {
        return map{
            ok: true,
            is_graphical: true,
            vertex_count: 0,
            edge_count: 0,
            edges: [],
            adjacency_matrix: [],
            realized_degrees: []
        };
    }

    // Track (rem_deg, vertex_id) preserving input vertex labels 0..n-1
    let nodes = [];
    let i = 0;
    while i < n {
        array_push(nodes, map{ deg: num_round(_f64(deg_seq[i], "havel_hakimi")), id: i });
        i = i + 1;
    }

    let adj = LA.mat_zeros(n, n);
    let edges = [];
    let done = false;

    while not done {
        // Insertion sort descending by remaining degree (tie-break ascending id)
        let a = 1;
        while a < n {
            let key = nodes[a];
            let b = a - 1;
            while b >= 0 and (nodes[b].deg < key.deg or (nodes[b].deg == key.deg and nodes[b].id > key.id)) {
                nodes[b + 1] = nodes[b];
                b = b - 1;
            }
            nodes[b + 1] = key;
            a = a + 1;
        }

        let d_top = nodes[0].deg;
        if d_top == 0 {
            done = true;
        } else {
            let u = nodes[0].id;
            nodes[0].deg = 0;
            let t = 1;
            while t <= d_top {
                if t >= n or nodes[t].deg <= 0 {
                    return map{ ok: false, is_graphical: false, vertex_count: n, edge_count: 0, edges: [], adjacency_matrix: [] };
                }
                let v = nodes[t].id;
                nodes[t].deg = nodes[t].deg - 1;
                adj[u][v] = 1.0;
                adj[v][u] = 1.0;
                let lo = if u < v { u } else { v };
                let hi = if u < v { v } else { u };
                array_push(edges, [lo, hi]);
                t = t + 1;
            }
        }
    }

    let realized = [];
    i = 0;
    while i < n {
        let deg_i = 0;
        let j = 0;
        while j < n {
            if adj[i][j] > 0.5 { deg_i = deg_i + 1; }
            j = j + 1;
        }
        array_push(realized, deg_i);
        i = i + 1;
    }

    return map{
        ok: true,
        is_graphical: true,
        vertex_count: n,
        edge_count: len(edges),
        edges: edges,
        adjacency_matrix: adj,
        realized_degrees: realized
    };
}

