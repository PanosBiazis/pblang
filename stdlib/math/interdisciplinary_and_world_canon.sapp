        _msc_div("85", "Astronomy and astrophysics", "Αστρονομία, αστροφυσική & ουράνια μηχανική τροχιών Kepler", M_CANON, ["kepler_orbit_solve", "al_tusi_spherical_triangle"]),
        _msc_div("86", "Geophysics", "Γεωφυσική & ελλειψοειδής γεωδαισία WGS-84 (Vincenty & εμβαδόν γεωτεμαχίων)", M_LA, ["vincenty_wgs84", "haversine_distance_m", "geodesic_polygon_area_m2"]),
        _msc_div("90", "Operations research, mathematical programming", "Επιχειρησιακή έρευνα, γραμμικός/ακέραιος προγραμματισμός Simplex/MILP & BFGS", M_STAT, ["linprog_simplex", "milp_solve", "minimize_bfgs", "minimize_constrained"]),
        _msc_div("91", "Game theory, economics, finance, and other social and behavioral sciences", "Οικονομικά (εισροές-εκροές Leontief), αναλογιστικά, χρηματοοικονομικά & κοινωνική επιλογή", M_CANON, ["actuarial_life_commutations", "leontief_input_output", "social_choice_election", "dhondt_allocate_seats"]),
        _msc_div("92", "Biology and other natural sciences", "Μαθηματική βιολογία, επιδημιολογία SIR, ενζυμική κινητική, γενετική & αξονική τομογραφία CT", M_CANON, ["epidemic_sir_exact_and_rk4", "michaelis_menten_fit", "hardy_weinberg", "radon_sinogram_2d", "filtered_backprojection_2d"]),
        _msc_div("93", "Systems theory; control", "Θεωρία συστημάτων & αυτόματος έλεγχος (Kalman, Routh-Hurwitz, Jury, LQR)", M_CANON, ["kalman_controllability_observability", "routh_hurwitz_stability", "kalman_filter_1d_nd", "lqr_discrete", "z_transform_stability"]),
        _msc_div("94", "Information and communication theory, circuits", "Θεωρία πληροφορίας/εντροπίας, ψηφιακά φίλτρα IIR, άλγεβρα Boole & πεπερασμένα σώματα", M_CANON, ["filter_iir", "von_neumann_entropy"]),
        _msc_div("97", "Mathematics education", "Μαθηματική εκπαίδευση, επαληθευμένες λύσεις βήμα-προς-βήμα & οπτικοποίηση SVG", M_CAS, ["transform", "solve", "plot_svg"])
    ];

    let by_code = map{};
    let i = 0;
    while i < len(divisions) {
        let d = divisions[i];
        by_code[d.code] = d;
        i = i + 1;
    }
    // Convenient standard composite MSC range aliases
    by_code["16-17"] = by_code["16"];
    by_code["30-32"] = by_code["30"];
    by_code["34-35"] = by_code["34"];
    by_code["40-44"] = by_code["40"];
    by_code["46-47"] = by_code["46"];
    by_code["51-53"] = by_code["51"];
    by_code["54-57"] = by_code["54"];
    by_code["70-86"] = by_code["70"];

    let millennium_and_hilbert_demarcation = [
        map{ id: "riemann_hypothesis", msc: "11M26", status: "open_unproven_conjecture", statement: "All non-trivial zeros of zeta(s) satisfy Re(s) = 1/2" },
        map{ id: "p_vs_np", msc: "68Q15", status: "open_unproven_conjecture", statement: "Whether P = NP or P != NP for deterministic vs nondeterministic polynomial time" },
        map{ id: "navier_stokes_3d_regularity", msc: "35Q30", status: "open_unproven_conjecture", statement: "Global C^infinity existence and smoothness of 3D incompressible Navier-Stokes solutions" },
        map{ id: "yang_mills_mass_gap", msc: "81T13", status: "open_unproven_conjecture", statement: "Rigorous constructive 4D quantum Yang-Mills existence and positive mass gap Delta > 0" },
        map{ id: "hodge_conjecture", msc: "14C30", status: "open_unproven_conjecture", statement: "Hodge classes on smooth projective complex algebraic varieties are Q-linear algebraic cycle combinations" },
        map{ id: "birch_swinnerton_dyer", msc: "11G40", status: "open_unproven_conjecture", statement: "ord_{s=1} L(E, s) equals algebraic rank of elliptic curve E(Q)" },
        map{ id: "goldbach_binary_conjecture", msc: "11P32", status: "open_unproven_conjecture", statement: "Every even integer n > 2 is the sum of two primes (note: weak ternary proved by Helfgott 2013)" },
        map{ id: "twin_prime_conjecture", msc: "11N05", status: "open_unproven_conjecture", statement: "Infinitely many primes p such that p + 2 is prime (bounded gaps proved by Zhang/Maynard/Polymath 2013-2014)" },
        map{ id: "collatz_conjecture", msc: "11B83", status: "open_unproven_conjecture", statement: "Every positive integer eventually reaches 1 under 3n+1 / n/2 iteration" },
        map{ id: "poincare_conjecture", msc: "57M40", status: "rigorously_proved_theorem", statement: "Every closed simply connected 3-manifold is homeomorphic to S^3 (proved by Grigori Perelman, 2002-2003)" },
        map{ id: "fermat_last_theorem", msc: "11D41", status: "rigorously_proved_theorem", statement: "No positive integers satisfy x^n + y^n = z^n for n >= 3 (proved by Andrew Wiles & Richard Taylor, 1995)" }
    ];

    return map{
        ok: true,
        standard: "MSC2020",
        version: CANON_VERSION,
        divisions_count: len(divisions),
        divisions: divisions,
        by_code: by_code,
        millennium_and_hilbert_demarcation: millennium_and_hilbert_demarcation
    };
}

fn _str_to_lower_ascii(s) {
    let out = "";
    let n = len(s);
    let i = 0;
    while i < n {
        let code = strcharcodeat(s, i);
        let ch = str_slice(s, i, i + 1);
        if code >= 65 and code <= 90 {
            let lowers = "abcdefghijklmnopqrstuvwxyz";
            let idx = code - 65;
            out = out + str_slice(lowers, idx, idx + 1);
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out;
}

fn classify_open_vs_proved(topic) {
    let raw = str_trim(str(topic));
    let low = _str_to_lower_ascii(raw);

    // 1. Non-scientific / impossible constructions / pseudoscience (checked first so e.g. numerology is rejected)
    if str_contains(low, "numerolog") or str_contains(low, "gematria") or str_contains(low, "pyramidolog") or str_contains(low, "astrolog") or str_contains(low, "sacred geometry") or str_contains(low, "bible code") or str_contains(low, "αριθμομαντ") or str_contains(low, "αστρολογ") {
        return map{
            ok: true,
            topic: raw,
            status: "rejected_non_scientific",
            epistemic_class_el: "Απορρίπτεται ως μη επιστημονικό / ψευδοεπιστήμη",
            reference: "Popperian falsifiability & mathematical proof standards: symbolic superstition has zero axiomatic or empirical validity."
        };
    }
    if str_contains(low, "squaring the circle") or str_contains(low, "angle trisection") or str_contains(low, "doubling the cube") or str_contains(low, "perpetual motion") or str_contains(low, "τετραγωνισμός του κύκλου") or str_contains(low, "αεικίνητο") {
        return map{
            ok: true,
            topic: raw,
            status: "rejected_non_scientific",
            epistemic_class_el: "Αποδεδειγμένα αδύνατο / απορρίπτεται",
            reference: "Wantzel (1837) Galois degree [Q(cos 20 deg):Q] = 3 != 2^k, Lindemann (1882) transcendence of pi, and 1st/2nd Laws of Thermodynamics."
        };
    }

    // 2. Undecidable / Independent theorems (Godel, Turing, Church, Cohen, Matiyasevich, Richardson)
    if str_contains(low, "halting") or str_contains(low, "hilbert's 10") or str_contains(low, "hilbert 10") or str_contains(low, "general diophantine") or str_contains(low, "matiyasevich") or str_contains(low, "richardson") or str_contains(low, "continuum hypothesis") or str_contains(low, "godel") or str_contains(low, "gödel") or str_contains(low, "post correspondence") or str_contains(low, "rice's theorem") or str_contains(low, "word problem for groups") {
        return map{
            ok: true,
            topic: raw,
            status: "undecidable_by_godel_turing_matiyasevich",
            epistemic_class_el: "Μη αποφασίσιμο / ανεξάρτητο (Gödel–Turing–Matiyasevich–Richardson–Cohen)",
            reference: "Godel (1931), Turing (1936), Cohen (1963), Richardson (1968), Davis-Putnam-Robinson-Matiyasevich (1970)."
        };
    }

    // 3. Open unproven mathematical conjectures (Millennium, Hilbert 8/16, Landau, Collatz)
    if str_contains(low, "riemann") or str_contains(low, "goldbach") or str_contains(low, "p vs np") or str_contains(low, "p != np") or str_contains(low, "p=np") or str_contains(low, "navier-stokes") or str_contains(low, "navier stokes") or str_contains(low, "yang-mills") or str_contains(low, "yang mills") or str_contains(low, "hodge") or str_contains(low, "birch") or str_contains(low, "swinnerton-dyer") or str_contains(low, "twin prime") or str_contains(low, "collatz") or str_contains(low, "3n+1") or str_contains(low, "schanuel") or str_contains(low, "landau") or str_contains(low, "odd perfect") or str_contains(low, "abc conjecture") {
        return map{
            ok: true,
            topic: raw,
            status: "open_unproven_conjecture",
            epistemic_class_el: "Ανοικτή αναπόδεικτη εικασία (ερευνητικό μέτωπο)",
            reference: "Clay Millennium / Hilbert / Landau open problems registry — strictly demarcated from proved theorems."
        };
    }

    // 4. Rigorously proved theorems
    if str_contains(low, "fermat") or str_contains(low, "poincare") or str_contains(low, "poincaré") or str_contains(low, "hasse") or str_contains(low, "banach") or str_contains(low, "caratheodory") or str_contains(low, "carathéodory") or str_contains(low, "καραθεοδωρ") or str_contains(low, "erdos-gallai") or str_contains(low, "erdős-gallai") or str_contains(low, "routh") or str_contains(low, "hurwitz") or str_contains(low, "kalman") or str_contains(low, "ramanujan") or str_contains(low, "chakravala") or str_contains(low, "archimedes") or str_contains(low, "tikhonov") or str_contains(low, "prime number theorem") or str_contains(low, "four color") or str_contains(low, "fundamental theorem") or str_contains(low, "central limit") or str_contains(low, "gauss-bonnet") or str_contains(low, "noether") or str_contains(low, "shannon") or str_contains(low, "arrow") or str_contains(low, "hawkins-simon") or str_contains(low, "kepler") {
        return map{
            ok: true,
            topic: raw,
            status: "rigorously_proved_theorem",
            epistemic_class_el: "Αυστηρά αποδεδειγμένο μαθηματικό θεώρημα",
            reference: "Peer-reviewed deductive proof in the international mathematical canon."
        };
    }

    return map{
        ok: true,
        topic: raw,
        status: "unclassified_requires_peer_review",
        epistemic_class_el: "Μη καταχωρισμένο θέμα — απαιτείται έλεγχος βιβλιογραφίας",
        reference: "No automatic claim made without explicit proof citation."
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// 2. Pure & Functional Analysis Pillars (MSC 14, 42, 44, 46, 47, 68)
// ══════════════════════════════════════════════════════════════════════════════

// ── 2A. Elliptic Curves over F_p and Exact Q (MSC 11G / 14H52) ────────────────

fn _ec_is_inf(P) {
    if P == nil { return true; }
    if type(P) == "string" {
        let u = str_trim(P);
        return u == "INF" or u == "O" or u == "inf" or u == "∞";
    }
    if type(P) == "map" and map_has(P, "infinity") and P.infinity == true {
        return true;
    }
    return false;
}

fn _ec_fp_coords(P, p_b, ctx) {
    if type(P) == "array" and len(P) == 2 {
        return [_b_mod(_to_bigint(P[0], ctx), p_b), _b_mod(_to_bigint(P[1], ctx), p_b)];
    }
    if type(P) == "map" and map_has(P, "x") and map_has(P, "y") {
        return [_b_mod(_to_bigint(P.x, ctx), p_b), _b_mod(_to_bigint(P.y, ctx), p_b)];
    }
    throw ctx + ": expected elliptic curve point [x, y] or \"INF\"";
}

fn _ec_fp_check_nonsingular(a_b, b_b, p_b, ctx) {
    if p_b <= _B3 or not EX.is_prime(p_b) {
        throw ctx + ": short Weierstrass curve over F_p requires prime p > 3";
    }
    let aa = _b_mod(a_b, p_b);
    let bb = _b_mod(b_b, p_b);
    let disc_core = _b_mod(_B4 * aa * aa * aa + _B27 * bb * bb, p_b);
    if disc_core == _B0 {
        throw ctx + ": singular Weierstrass curve (4*a^3 + 27*b^2 == 0 mod p)";
    }
}

fn ec_fp_add(P, Q, a, p) {
    let p_b = _to_bigint(p, "ec_fp_add");
    if p_b <= _B3 or not EX.is_prime(p_b) {
        throw "ec_fp_add: modulus p must be a prime > 3";
    }
    let a_b = _b_mod(_to_bigint(a, "ec_fp_add"), p_b);

    let p_inf = _ec_is_inf(P);
    let q_inf = _ec_is_inf(Q);
    if p_inf and q_inf { return "INF"; }
    if p_inf {
        let qpt = _ec_fp_coords(Q, p_b, "ec_fp_add");
        let b_q = _b_mod(qpt[1] * qpt[1] - qpt[0] * qpt[0] * qpt[0] - a_b * qpt[0], p_b);
        _ec_fp_check_nonsingular(a_b, b_q, p_b, "ec_fp_add");
        return qpt;
    }
    if q_inf {
        let ppt = _ec_fp_coords(P, p_b, "ec_fp_add");
        let b_p = _b_mod(ppt[1] * ppt[1] - ppt[0] * ppt[0] * ppt[0] - a_b * ppt[0], p_b);
        _ec_fp_check_nonsingular(a_b, b_p, p_b, "ec_fp_add");
        return ppt;
    }

    let cP = _ec_fp_coords(P, p_b, "ec_fp_add");
    let cQ = _ec_fp_coords(Q, p_b, "ec_fp_add");
    let x1 = cP[0];
    let y1 = cP[1];
    let x2 = cQ[0];
    let y2 = cQ[1];

    // Verify P and Q lie on the same non-singular Weierstrass curve y^2 = x^3 + a*x + b (mod p)
    let b1 = _b_mod(y1 * y1 - x1 * x1 * x1 - a_b * x1, p_b);
    let b2 = _b_mod(y2 * y2 - x2 * x2 * x2 - a_b * x2, p_b);
    if b1 != b2 {
        throw "ec_fp_add: points P and Q do not lie on the same curve y^2 = x^3 + a*x + b (mod p)";
    }
    _ec_fp_check_nonsingular(a_b, b1, p_b, "ec_fp_add");

    if x1 == x2 {
        if _b_mod(y1 + y2, p_b) == _B0 {
            return "INF";
        }
        // Tangent doubling: y1 == y2 != 0, lambda = (3*x1^2 + a) * (2*y1)^(-1) mod p
        let num_l = _b_mod(_B3 * x1 * x1 + a_b, p_b);
        let den_l = _b_mod(_B2 * y1, p_b);
        let lam = _b_mod(num_l * EX.mod_inv(den_l, p_b), p_b);
        let x3 = _b_mod(lam * lam - _B2 * x1, p_b);
        let y3 = _b_mod(lam * (x1 - x3) - y1, p_b);
        return [x3, y3];
    }

    // Secant chord: x1 != x2, lambda = (y2 - y1) * (x2 - x1)^(-1) mod p
    let num_s = _b_mod(y2 - y1, p_b);
    let den_s = _b_mod(x2 - x1, p_b);
    let lam_s = _b_mod(num_s * EX.mod_inv(den_s, p_b), p_b);
    let x3_s = _b_mod(lam_s * lam_s - x1 - x2, p_b);
    let y3_s = _b_mod(lam_s * (x1 - x3_s) - y1, p_b);
    return [x3_s, y3_s];
}

fn ec_fp_mul(k, P, a, p) {
    let p_b = _to_bigint(p, "ec_fp_mul");
    if p_b <= _B3 or not EX.is_prime(p_b) {
        throw "ec_fp_mul: modulus p must be a prime > 3";
    }
    let k_b = _to_bigint(k, "ec_fp_mul");
    if _ec_is_inf(P) or k_b == _B0 {
        return "INF";
    }
    let a_b = _b_mod(_to_bigint(a, "ec_fp_mul"), p_b);
    let base = _ec_fp_coords(P, p_b, "ec_fp_mul");
    let b_curve = _b_mod(base[1] * base[1] - base[0] * base[0] * base[0] - a_b * base[0], p_b);
    _ec_fp_check_nonsingular(a_b, b_curve, p_b, "ec_fp_mul");

    if k_b < _B0 {
        k_b = _B0 - k_b;
        base = [base[0], _b_mod(_B0 - base[1], p_b)];
    }

    let acc = "INF";
    let cur = base;
    let rem = k_b;
    let steps = 0;
    while rem > _B0 {
        steps = steps + 1;
        if steps > MAX_STEPS {
            throw "ec_fp_mul: scalar bit-length exceeds MAX_STEPS";
        }
        if rem % _B2 == _B1 {
            acc = ec_fp_add(acc, cur, a_b, p_b);
        }
        rem = rem / _B2;
        if rem > _B0 {
            cur = ec_fp_add(cur, cur, a_b, p_b);
        }
    }
    return acc;
}

// Counts #E(F_p) = p + 1 + sum_{x=0}^{p-1} ((x^3 + a*x + b) / p) via Legendre symbol
// and verifies Hasse's Theorem (1933): |#E(F_p) - (p + 1)| <= 2 * sqrt(p).
fn ec_fp_count_points(a, b, p) {
    let p_b = _to_bigint(p, "ec_fp_count_points");
    if p_b > bigint(MAX_EC_PRIME_SCAN) {
        throw "ec_fp_count_points: p exceeds MAX_EC_PRIME_SCAN (" + str(MAX_EC_PRIME_SCAN) + ")";
    }
    let a_b = _b_mod(_to_bigint(a, "ec_fp_count_points"), p_b);
    let b_b = _b_mod(_to_bigint(b, "ec_fp_count_points"), p_b);
    _ec_fp_check_nonsingular(a_b, b_b, p_b, "ec_fp_count_points");

    let count = _B1; // Point at infinity "INF"
    let exp_leg = (p_b - _B1) / _B2;
    let pm1 = p_b - _B1;
    let x = _B0;
    while x < p_b {
        let rhs = _b_mod(x * x * x + a_b * x + b_b, p_b);
        if rhs == _B0 {
            count = count + _B1;
        } else {
            let ls = EX.mod_pow(rhs, exp_leg, p_b);
            if ls == _B1 {
                count = count + _B2;
            } else if ls != pm1 {
                throw "ec_fp_count_points: Euler criterion failure";
            }
        }
        x = x + _B1;
    }

    let trace_t = (p_b + _B1) - count;
    let hasse_exact = (trace_t * trace_t <= _B4 * p_b);
    let p_num = parse_number(str(p_b));
    let cnt_num = parse_number(str(count));
    let t_num = parse_number(str(trace_t));
    return map{
        count: cnt_num,
        count_bigint: count,
        trace_of_frobenius: t_num,
        hasse_bound: 2.0 * num_sqrt(p_num),
        hasse_satisfied: hasse_exact
    };
}

// Exact rational discriminant Delta = -16 * (4*a^3 + 27*b^2) over Q
fn ec_discriminant(a, b) {
    let ra = _to_ex_rat(a);
    let rb = _to_ex_rat(b);
    let a3 = EX.rat_pow(ra, 3);
    let b2 = EX.rat_pow(rb, 2);
    let core = EX.rat_add(EX.rat_mul(EX.rat(4, 1), a3), EX.rat_mul(EX.rat(27, 1), b2));
    return EX.rat_mul(EX.rat(-16, 1), core);
}

// Exact rational j-invariant j = -1728 * (4*a)^3 / Delta = 1728 * (4*a^3) / (4*a^3 + 27*b^2)
fn ec_j_invariant(a, b) {
    let delta = ec_discriminant(a, b);
    if EX.rat_is_zero(delta) {
        throw "ec_j_invariant: singular curve has Delta == 0";
    }
    let ra = _to_ex_rat(a);
    let num_4a_cubed = EX.rat_pow(EX.rat_mul(EX.rat(4, 1), ra), 3);
    let numer = EX.rat_mul(EX.rat(-1728, 1), num_4a_cubed);
    return EX.rat_div(numer, delta);
}

fn _ec_q_coords(P, ctx) {
    if type(P) == "array" and len(P) == 2 {
        return [_to_ex_rat(P[0]), _to_ex_rat(P[1])];
    }
    if type(P) == "map" and map_has(P, "x") and map_has(P, "y") {
        return [_to_ex_rat(P.x), _to_ex_rat(P.y)];
    }
    throw ctx + ": expected rational point [x, y] or \"INF\"";
}

fn ec_q_add(P, Q, a) {
    let ra = _to_ex_rat(a);
    let p_inf = _ec_is_inf(P);
    let q_inf = _ec_is_inf(Q);
    if p_inf and q_inf { return "INF"; }
    if p_inf {
        let cq = _ec_q_coords(Q, "ec_q_add");
        let bq = EX.rat_sub(EX.rat_pow(cq[1], 2), EX.rat_add(EX.rat_pow(cq[0], 3), EX.rat_mul(ra, cq[0])));
        if EX.rat_is_zero(ec_discriminant(ra, bq)) {
            throw "ec_q_add: point lies on a singular curve over Q";
        }
        return cq;
    }
    if q_inf {
        let cp = _ec_q_coords(P, "ec_q_add");
        let bp = EX.rat_sub(EX.rat_pow(cp[1], 2), EX.rat_add(EX.rat_pow(cp[0], 3), EX.rat_mul(ra, cp[0])));
        if EX.rat_is_zero(ec_discriminant(ra, bp)) {
            throw "ec_q_add: point lies on a singular curve over Q";
        }
        return cp;
    }

    let cP = _ec_q_coords(P, "ec_q_add");
    let cQ = _ec_q_coords(Q, "ec_q_add");
    let x1 = cP[0];
    let y1 = cP[1];
    let x2 = cQ[0];
    let y2 = cQ[1];

    let b1 = EX.rat_sub(EX.rat_pow(y1, 2), EX.rat_add(EX.rat_pow(x1, 3), EX.rat_mul(ra, x1)));
    let b2 = EX.rat_sub(EX.rat_pow(y2, 2), EX.rat_add(EX.rat_pow(x2, 3), EX.rat_mul(ra, x2)));
    if not EX.rat_eq(b1, b2) {
        throw "ec_q_add: points P and Q do not lie on the same curve over Q";
    }
    if EX.rat_is_zero(ec_discriminant(ra, b1)) {
        throw "ec_q_add: curve over Q is singular";
    }

    if EX.rat_eq(x1, x2) {
        if EX.rat_is_zero(EX.rat_add(y1, y2)) {
            return "INF";
        }
        let num_l = EX.rat_add(EX.rat_mul(EX.rat(3, 1), EX.rat_pow(x1, 2)), ra);
        let den_l = EX.rat_mul(EX.rat(2, 1), y1);
        let lam = EX.rat_div(num_l, den_l);
        let x3 = EX.rat_sub(EX.rat_pow(lam, 2), EX.rat_mul(EX.rat(2, 1), x1));
        let y3 = EX.rat_sub(EX.rat_mul(lam, EX.rat_sub(x1, x3)), y1);
        return [x3, y3];
    }

    let lam_s = EX.rat_div(EX.rat_sub(y2, y1), EX.rat_sub(x2, x1));
    let x3_s = EX.rat_sub(EX.rat_sub(EX.rat_pow(lam_s, 2), x1), x2);
    let y3_s = EX.rat_sub(EX.rat_mul(lam_s, EX.rat_sub(x1, x3_s)), y1);
    return [x3_s, y3_s];
}

// ── 2B. Functional Analysis: Weighted L^2 Gram-Schmidt & Banach Fixed Point ──

// 8-point Gauss-Legendre nodes & weights on [-1, 1] (exact for degree <= 15 per panel)
let _GL8_NODES = [
    -0.96028985649753623,
    -0.79666647741362674,
    -0.52553240991632899,
    -0.18343464249564980,
     0.18343464249564980,
     0.52553240991632899,
     0.79666647741362674,
     0.96028985649753623
];
let _GL8_WEIGHTS = [
    0.10122853629037626,
    0.22238103445337447,
    0.31370664587788729,
    0.36268378337836198,
    0.36268378337836198,
    0.31370664587788729,
    0.22238103445337447,
    0.10122853629037626
];

fn _make_lincomb_fn(basis_fns, coeffs_row) {
    let m = len(coeffs_row);
    return fn(x) {
        let s = 0.0;
        let j = 0;
        while j < m {
            let c = coeffs_row[j];
            if c != 0.0 {
                s = s + c * basis_fns[j](x);
            }
            j = j + 1;
        }
        return s;
    };
}

// Orthonormalizes `basis_fns` on [a, b] under <f, g>_w = int_a^b f(x) g(x) w(x) dx
// via 16-panel composite 8-point Gauss-Legendre quadrature (128 nodes) + twice-iterated
// Modified Gram-Schmidt for machine-precision L^2_w orthonormality.
fn gram_schmidt_functions(basis_fns, a, b, weight_fn = nil) {
    if type(basis_fns) != "array" or len(basis_fns) == 0 {
        throw "gram_schmidt_functions: basis_fns must be a non-empty array of functions";
    }
    let k_count = len(basis_fns);
    if k_count > 64 {
        throw "gram_schmidt_functions: basis size exceeds bound 64";
    }
    let x_lo = _f64(a, "gram_schmidt_functions");
    let x_hi = _f64(b, "gram_schmidt_functions");
    if x_hi <= x_lo {
        throw "gram_schmidt_functions: require a < b";
    }

    let panels = 16;
    let h_panel = (x_hi - x_lo) / (panels * 1.0);
    let q_nodes = [];
    let q_weights = [];
    let p_idx = 0;
    while p_idx < panels {
        let p_a = x_lo + p_idx * h_panel;
        let p_mid = p_a + 0.5 * h_panel;
        let p_half = 0.5 * h_panel;
        let g_idx = 0;
        while g_idx < 8 {
            let xq = p_mid + p_half * _GL8_NODES[g_idx];
            let w_base = p_half * _GL8_WEIGHTS[g_idx];
            let w_val = if weight_fn == nil { 1.0 } else { _f64(weight_fn(xq), "gram_schmidt_functions") };
            if w_val < 0.0 {
                throw "gram_schmidt_functions: weight_fn must be non-negative on [a, b]";
            }
            array_push(q_nodes, xq);
            array_push(q_weights, w_base * w_val);
            g_idx = g_idx + 1;
        }
        p_idx = p_idx + 1;
    }

    let n_quad = len(q_nodes);
    // Pre-sample basis functions on quadrature nodes: B_vals[i][q]
    let B_vals = [];
    let i = 0;
    while i < k_count {
        let row_v = [];
        let q = 0;
        while q < n_quad {
            array_push(row_v, _f64(basis_fns[i](q_nodes[q]), "gram_schmidt_functions"));
            q = q + 1;
        }
        array_push(B_vals, row_v);
        i = i + 1;
    }

    // Orthonormal sampled vectors Q_vals[i][q] and expansion coefficients C[i][j] (e_i = sum_j C[i][j] phi_j)
    let Q_vals = [];
    let C_mat = LA.mat_zeros(k_count, k_count);
    let norms = [];
    i = 0;
    while i < k_count {
        let u_q = [];
        let q = 0;
        while q < n_quad {
            array_push(u_q, B_vals[i][q]);
            q = q + 1;
        }
        C_mat[i][i] = 1.0;

        // Two passes of Modified Gram-Schmidt (Kahan-Parlett "twice is enough")
        let pass = 0;
        while pass < 2 {
            let j = 0;
            while j < i {
                let ip = 0.0;
                q = 0;
                while q < n_quad {
                    ip = ip + u_q[q] * Q_vals[j][q] * q_weights[q];
                    q = q + 1;
                }
                q = 0;
                while q < n_quad {
                    u_q[q] = u_q[q] - ip * Q_vals[j][q];
                    q = q + 1;
                }
                let c_col = 0;
                while c_col <= j {
                    C_mat[i][c_col] = C_mat[i][c_col] - ip * C_mat[j][c_col];
                    c_col = c_col + 1;
                }
                j = j + 1;
            }
            pass = pass + 1;
        }

        let norm_sq = 0.0;
        q = 0;
        while q < n_quad {
            norm_sq = norm_sq + u_q[q] * u_q[q] * q_weights[q];
            q = q + 1;
        }
        let nrm = num_sqrt(_max2(0.0, norm_sq));
        if nrm <= 1e-13 {
            throw "gram_schmidt_functions: basis functions are linearly dependent on [a, b]";
        }
        array_push(norms, nrm);
        let inv_nrm = 1.0 / nrm;
        q = 0;
        while q < n_quad {
            u_q[q] = u_q[q] * inv_nrm;
            q = q + 1;
        }
        let c_col2 = 0;
        while c_col2 <= i {
            C_mat[i][c_col2] = C_mat[i][c_col2] * inv_nrm;
            c_col2 = c_col2 + 1;
        }
        array_push(Q_vals, u_q);
        i = i + 1;
    }

    let ortho_fns = [];
    i = 0;
    while i < k_count {
        let coeffs_prefix = [];
        let j = 0;
        while j <= i {
            array_push(coeffs_prefix, C_mat[i][j]);
            j = j + 1;
        }
        array_push(ortho_fns, _make_lincomb_fn(basis_fns, coeffs_prefix));
        i = i + 1;
    }

    // Verify Gram matrix <e_i, e_j>_w == delta_{ij}
    let gram = LA.mat_zeros(k_count, k_count);
    let max_err = 0.0;
    i = 0;
    while i < k_count {
        let j = 0;
        while j < k_count {
            let s = 0.0;
            let q = 0;
            while q < n_quad {
                s = s + Q_vals[i][q] * Q_vals[j][q] * q_weights[q];
                q = q + 1;
            }
            gram[i][j] = s;
            let target = if i == j { 1.0 } else { 0.0 };
            let e = num_abs(s - target);
            if e > max_err { max_err = e; }
            j = j + 1;
        }
        i = i + 1;
    }

    return map{
        orthonormal_fns: ortho_fns,
        coeff_matrix: C_mat,
        norms: norms,
        gram_matrix: gram,
        max_orthonormality_error: max_err
    };
}

fn _state_dist(x, y, is_vec) {
    if not is_vec {
        return num_abs(_f64(x, "banach") - _f64(y, "banach"));
    }
    let s = 0.0;
    let i = 0;
    while i < len(x) {
        let d = _f64(x[i], "banach") - _f64(y[i], "banach");
        s = s + d * d;
        i = i + 1;
    }
    return num_sqrt(s);
}

// Banach Contraction Mapping Theorem (1922) solver with verified a priori & a posteriori bounds:
//   ||x* - x_k|| <= (L / (1 - L)) ||x_k - x_{k-1}||   (a posteriori)
//   ||x* - x_k|| <= (L^k / (1 - L)) ||x_1 - x_0||     (a priori)
fn banach_fixed_point(T_fn, x0, lipschitz_L, tol = 1e-12) {
    let L = _f64(lipschitz_L, "banach_fixed_point");
    let eps = _f64(tol, "banach_fixed_point");
    if L < 0.0 or L >= 1.0 {
        throw "banach_fixed_point: Banach theorem requires strict contraction 0 <= L < 1, got L=" + str(L);
    }
    if eps <= 0.0 {
        throw "banach_fixed_point: tol must be > 0";
    }

    let is_vec = (type(x0) == "array");
    let x_prev = x0;
    let x_curr = T_fn(x_prev);
    let d0 = _state_dist(x_curr, x_prev, is_vec);
    let inv_one_minus_L = 1.0 / (1.0 - L);

    if d0 == 0.0 or L == 0.0 {
        let x_check = T_fn(x_curr);
        let res0 = _state_dist(x_check, x_curr, is_vec);
        return map{
            ok: true,
            converged: true,
            fixed_point: x_curr,
            iterations: 1,
            lipschitz_L: L,
            initial_step_norm: d0,
            a_priori_bound: L * inv_one_minus_L * d0,
            a_posteriori_bound: L * inv_one_minus_L * d0,
            residual: res0
        };
    }

    let k = 1;
    let d_prev = d0;
    let L_pow_k = L;
    let aposteriori = L * inv_one_minus_L * d0;
    let apriori = L_pow_k * inv_one_minus_L * d0;

    while aposteriori > eps and k < MAX_STEPS {
        let x_next = T_fn(x_curr);
        let d_curr = _state_dist(x_next, x_curr, is_vec);
        if d_prev > 1e-14 and d_curr > (L + 1e-7) * d_prev + 1e-15 {
            throw "banach_fixed_point: empirical step violated claimed Lipschitz constant L=" + str(L);
        }
        x_prev = x_curr;
        x_curr = x_next;
        d_prev = d_curr;
        k = k + 1;
        L_pow_k = L_pow_k * L;
        aposteriori = L * inv_one_minus_L * d_curr;
        apriori = L_pow_k * inv_one_minus_L * d0;
    }

    if aposteriori > eps {
        throw "banach_fixed_point: exceeded MAX_STEPS before reaching tolerance";
    }

    let residual = _state_dist(T_fn(x_curr), x_curr, is_vec);
    return map{
        ok: true,
        converged: true,
        fixed_point: x_curr,
        iterations: k,
        lipschitz_L: L,
        initial_step_norm: d0,
        a_priori_bound: apriori,
        a_posteriori_bound: aposteriori,
        residual: residual
    };
}

// ── 2C. Orthonormal Wavelets: Haar & Daubechies-4 (D4) (MSC 42C40) ───────────

fn _unpack_dwt_coeffs(coeffs, ctx) {
    if type(coeffs) == "map" {
        if map_has(coeffs, "approx") and map_has(coeffs, "detail") {
            let a = coeffs.approx;
            let d = coeffs.detail;
            if len(a) != len(d) or len(a) == 0 {
                throw ctx + ": approx and detail arrays must have equal positive length";
            }
            return map{ approx: a, detail: d };
        }
        if map_has(coeffs, "coeffs") {
            return _unpack_dwt_coeffs(coeffs.coeffs, ctx);
        }
    }
    if type(coeffs) == "array" {
        let n = len(coeffs);
        if n < 2 or (n % 2) != 0 {
            throw ctx + ": flat wavelet coefficient array must have positive even length";
        }
        let half = num_round(n / 2);
        let a = [];
        let d = [];
        let i = 0;
        while i < half {
            array_push(a, _f64(coeffs[i], ctx));
            array_push(d, _f64(coeffs[half + i], ctx));
            i = i + 1;
        }
        return map{ approx: a, detail: d };
    }
    throw ctx + ": expected DWT result map or flat coefficient array";
}

fn dwt_haar(signal) {
    if type(signal) != "array" or len(signal) < 2 or (len(signal) % 2) != 0 {
        throw "dwt_haar: signal must be an array of positive even length";
    }
    let n = len(signal);
    if n > MAX_SIGNAL_LEN {
        throw "dwt_haar: signal length exceeds MAX_SIGNAL_LEN";
    }
    let inv_sqrt2 = 0.70710678118654752440;
    let half = num_round(n / 2);
    let approx = [];
    let detail = [];
    let flat = [];
    let energy = 0.0;
    let i = 0;
    while i < half {
        let x0 = _f64(signal[2 * i], "dwt_haar");
        let x1 = _f64(signal[2 * i + 1], "dwt_haar");
        let a = (x0 + x1) * inv_sqrt2;
        let d = (x0 - x1) * inv_sqrt2;
        array_push(approx, a);
        array_push(detail, d);
        energy = energy + a * a + d * d;
        i = i + 1;
    }
    i = 0;
    while i < half { array_push(flat, approx[i]); i = i + 1; }
    i = 0;
    while i < half { array_push(flat, detail[i]); i = i + 1; }
    return map{
        wavelet: "haar",
        approx: approx,
        detail: detail,
        coeffs: flat,
        energy: energy
    };
}

fn idwt_haar(coeffs) {
    let parts = _unpack_dwt_coeffs(coeffs, "idwt_haar");
    let approx = parts.approx;
    let detail = parts.detail;
    let half = len(approx);
    let inv_sqrt2 = 0.70710678118654752440;
    let out = [];
    let i = 0;
    while i < half {
        let a = _f64(approx[i], "idwt_haar");
        let d = _f64(detail[i], "idwt_haar");
        array_push(out, (a + d) * inv_sqrt2);
        array_push(out, (a - d) * inv_sqrt2);
        i = i + 1;
    }
    return out;
}

// Daubechies-4 (4-tap D4 orthonormal wavelet with 2 vanishing moments, Daubechies 1988)
fn _db4_filters() {
    let s3 = num_sqrt(3.0);
    let denom = 4.0 * num_sqrt(2.0);
    let h0 = (1.0 + s3) / denom;
    let h1 = (3.0 + s3) / denom;
    let h2 = (3.0 - s3) / denom;
    let h3 = (1.0 - s3) / denom;
    return map{
        h: [h0, h1, h2, h3],
        g: [h3, 0.0 - h2, h1, 0.0 - h0]
    };
}

fn dwt_db4(signal) {
    if type(signal) != "array" or len(signal) < 4 or (len(signal) % 2) != 0 {
        throw "dwt_db4: signal must be an array of even length >= 4";
    }
    let n = len(signal);
    if n > MAX_SIGNAL_LEN {
        throw "dwt_db4: signal length exceeds MAX_SIGNAL_LEN";
    }
    let x = [];
    let idx = 0;
    while idx < n {
        array_push(x, _f64(signal[idx], "dwt_db4"));
        idx = idx + 1;
    }

    let flt = _db4_filters();
    let h = flt.h;
    let g = flt.g;
    let half = num_round(n / 2);
    let approx = [];
    let detail = [];
    let flat = [];
    let energy = 0.0;
    let i = 0;
    while i < half {
        let i0 = 2 * i;
        let i1 = (i0 + 1) % n;
        let i2 = (i0 + 2) % n;
        let i3 = (i0 + 3) % n;
        let a = h[0] * x[i0] + h[1] * x[i1] + h[2] * x[i2] + h[3] * x[i3];
        let d = g[0] * x[i0] + g[1] * x[i1] + g[2] * x[i2] + g[3] * x[i3];
        array_push(approx, a);
        array_push(detail, d);
        energy = energy + a * a + d * d;
        i = i + 1;
    }
    i = 0;
    while i < half { array_push(flat, approx[i]); i = i + 1; }
    i = 0;
    while i < half { array_push(flat, detail[i]); i = i + 1; }
    return map{
        wavelet: "db4",
        approx: approx,
        detail: detail,
        coeffs: flat,
        energy: energy
    };
}

fn idwt_db4(coeffs) {
    let parts = _unpack_dwt_coeffs(coeffs, "idwt_db4");
    let approx = parts.approx;
    let detail = parts.detail;
    let half = len(approx);
    if half < 2 {
        throw "idwt_db4: require at least 2 approximation and 2 detail coefficients";
    }
    let n = 2 * half;
    let out = [];
    let idx = 0;
    while idx < n {
        array_push(out, 0.0);
        idx = idx + 1;
    }
    let flt = _db4_filters();
    let h = flt.h;
    let g = flt.g;
    let i = 0;
    while i < half {
        let a = _f64(approx[i], "idwt_db4");
        let d = _f64(detail[i], "idwt_db4");
        let base = 2 * i;
        let k = 0;
        while k < 4 {
            let pos = (base + k) % n;
            out[pos] = out[pos] + a * h[k] + d * g[k];
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

// ── 2D. Z-Transform Stability (Schur-Cohn-Jury + Poles) & Causal IIR Filter ──

// Causal transfer function H(z) = (b_0 + b_1 z^-1 + ... + b_M z^-M) / (a_0 + a_1 z^-1 + ... + a_N z^-N).
// Characteristic denominator in z is A(z) = a_0 z^N + a_1 z^{N-1} + ... + a_N.
fn z_transform_stability(num_coeffs, den_coeffs) {
    if type(num_coeffs) != "array" or len(num_coeffs) == 0 {
        throw "z_transform_stability: num_coeffs must be non-empty";
    }
    if type(den_coeffs) != "array" or len(den_coeffs) == 0 {
        throw "z_transform_stability: den_coeffs must be non-empty";
    }
    let a0 = _f64(den_coeffs[0], "z_transform_stability");
    if num_abs(a0) <= 1e-15 {
        throw "z_transform_stability: causal IIR denominator requires den_coeffs[0] != 0";
    }

    let b = [];
    let i = 0;
    while i < len(num_coeffs) {
        array_push(b, _f64(num_coeffs[i], "z_transform_stability") / a0);
        i = i + 1;
    }
    let a = [];
    i = 0;
    while i < len(den_coeffs) {
        array_push(a, _f64(den_coeffs[i], "z_transform_stability") / a0);
        i = i + 1;
    }

    // Strip trailing zeros in a (each corresponds to an exact pole at z = 0, inside unit circle)
    let end_idx = len(a) - 1;
    let origin_poles = 0;
    while end_idx > 0 and num_abs(a[end_idx]) <= 1e-15 {
        origin_poles = origin_poles + 1;
        end_idx = end_idx - 1;
    }
    let a_core = [];
    i = 0;
    while i <= end_idx {
        array_push(a_core, a[i]);
        i = i + 1;
    }

    // Exact Schur-Cohn / Jury step-down reflection test on a_core[0..deg]
    let deg = len(a_core) - 1;
    let cur = [];
    i = 0;
    while i <= deg { array_push(cur, a_core[i]); i = i + 1; }
    let reflections = [];
    let jury_inside = true;
    let m = deg;
    while m >= 1 {
        if num_abs(cur[0]) <= 1e-15 {
            jury_inside = false;
            m = 0;
        } else {
            let kappa = cur[m] / cur[0];
            array_push(reflections, kappa);
            if num_abs(kappa) >= 1.0 - 1e-12 {
                jury_inside = false;
                m = 0;
            } else {
                let nxt = [];
                let k = 0;
                while k < m {
                    array_push(nxt, (cur[k] - kappa * cur[m - k]) / (1.0 - kappa * kappa));
                    k = k + 1;
                }
                cur = nxt;
                m = m - 1;
            }
        }
    }

    // Compute exact complex poles via Aberth-Ehrlich on exact rationalized polynomial
    let poles = [];
    let k0 = 0;
    while k0 < origin_poles {
        array_push(poles, map{ re: 0.0, im: 0.0, magnitude: 0.0 });
        k0 = k0 + 1;
    }
    if deg >= 1 {
        let rat_desc = [];
        i = 0;
        while i <= deg {
            array_push(rat_desc, _to_ex_rat(a_core[i]));
            i = i + 1;
        }
        let roots = EX.poly_all_roots(EX.poly_from_coeffs_desc(rat_desc));
        i = 0;
        while i < len(roots) {
            let mag = num_sqrt(roots[i].re * roots[i].re + roots[i].im * roots[i].im);
            array_push(poles, map{ re: roots[i].re, im: roots[i].im, magnitude: mag });
            i = i + 1;
        }
    }

    let max_mag = 0.0;
    let unstable_count = 0;
    i = 0;
    while i < len(poles) {
        if poles[i].magnitude > max_mag {
            max_mag = poles[i].magnitude;
        }
        if poles[i].magnitude >= 1.0 - 1e-11 {
            unstable_count = unstable_count + 1;
        }
        i = i + 1;
    }

    let bibo = jury_inside and (unstable_count == 0);
    // DC gain H(1) and Nyquist gain H(-1) when BIBO stable
    let dc_gain = nil;
    if bibo {
        let sum_b = 0.0;
        let sum_a = 0.0;
        i = 0;
        while i < len(b) { sum_b = sum_b + b[i]; i = i + 1; }
        i = 0;
        while i < len(a) { sum_a = sum_a + a[i]; i = i + 1; }
        if num_abs(sum_a) > 1e-14 {
            dc_gain = sum_b / sum_a;
        }
    }

    return map{
        is_bibo_stable: bibo,
        jury_all_inside_unit_circle: jury_inside,
        reflection_coefficients: reflections,
        poles: poles,
        max_pole_magnitude: max_mag,
        unstable_pole_count: unstable_count,
        stability_margin: 1.0 - max_mag,
        dc_gain: dc_gain
    };
}

fn filter_iir(b, a, x_seq) {
    if type(b) != "array" or len(b) == 0 or type(a) != "array" or len(a) == 0 {
        throw "filter_iir: b and a must be non-empty coefficient arrays";
    }
    if type(x_seq) != "array" {
        throw "filter_iir: x_seq must be an input sample array";
    }
    if len(x_seq) > MAX_SIGNAL_LEN {
        throw "filter_iir: x_seq exceeds MAX_SIGNAL_LEN";
    }
    let a0 = _f64(a[0], "filter_iir");
    if num_abs(a0) <= 1e-15 {
        throw "filter_iir: leading denominator coefficient a[0] must be non-zero";
    }
    let nb = len(b);
    let na = len(a);
    let nx = len(x_seq);
    let x = [];
    let i = 0;
    while i < nx { array_push(x, _f64(x_seq[i], "filter_iir")); i = i + 1; }

    let y = [];
    let n = 0;
    while n < nx {
        let acc = 0.0;
        let k = 0;
        while k < nb {
            if n - k >= 0 {
                acc = acc + _f64(b[k], "filter_iir") * x[n - k];
            }
            k = k + 1;
        }
        let j = 1;
        while j < na {
            if n - j >= 0 {
                acc = acc - _f64(a[j], "filter_iir") * y[n - j];
            }
            j = j + 1;
        }
        array_push(y, acc / a0);
        n = n + 1;
    }
    return y;
}

// ── 2E. 2D Medical CT Radon Sinogram & Filtered Back-Projection (MSC 44A12) ──

fn _bilin_sample(grid, rows, cols, r_f, c_f) {
    if r_f < 0.0 or r_f > (rows - 1) * 1.0 or c_f < 0.0 or c_f > (cols - 1) * 1.0 {
        return 0.0;
    }
    let r0 = num_floor(r_f);
    let c0 = num_floor(c_f);
    let r1 = if r0 + 1 < rows { r0 + 1 } else { r0 };
    let c1 = if c0 + 1 < cols { c0 + 1 } else { c0 };
    let dr = r_f - r0;
    let dc = c_f - c0;
    let v00 = grid[r0][c0];
    let v01 = grid[r0][c1];
    let v10 = grid[r1][c0];
    let v11 = grid[r1][c1];
    return (1.0 - dr) * ((1.0 - dc) * v00 + dc * v01) + dr * ((1.0 - dc) * v10 + dc * v11);
}

fn radon_sinogram_2d(image_grid, angles_deg) {
    let img = LA.mat_copy(image_grid);
    let rows = len(img);
    let cols = len(img[0]);
    if rows > MAX_RADON_GRID or cols > MAX_RADON_GRID {
        throw "radon_sinogram_2d: image dimensions exceed MAX_RADON_GRID";
    }
    if type(angles_deg) != "array" or len(angles_deg) == 0 {
        throw "radon_sinogram_2d: angles_deg must be a non-empty array";
    }

    let r_center = 0.5 * (rows - 1);
    let c_center = 0.5 * (cols - 1);
    let half_diag = num_ceil(0.5 * num_sqrt(rows * rows + cols * cols)) + 2;
    let n_det = 2 * half_diag + 1;
    let ds = 0.5;
    let n_steps = num_round((2.0 * half_diag) / ds);

    let sino = [];
    let a_idx = 0;
    while a_idx < len(angles_deg) {
        let theta = _f64(angles_deg[a_idx], "radon_sinogram_2d") * DEG_TO_RAD;
        let ct = num_cos(theta);
        let st = num_sin(theta);
        let proj = [];
        let b_idx = 0;
        while b_idx < n_det {
            let t = (b_idx - half_diag) * 1.0;
            let ray_sum = 0.0;
            let s_idx = 0;
            while s_idx <= n_steps {
                let s = (0.0 - half_diag) + s_idx * ds;
                let x = t * ct - s * st;
                let y = t * st + s * ct;
                let c_f = c_center + x;
                let r_f = r_center + y;
                ray_sum = ray_sum + _bilin_sample(img, rows, cols, r_f, c_f) * ds;
                s_idx = s_idx + 1;
            }
            array_push(proj, ray_sum);
            b_idx = b_idx + 1;
        }
        array_push(sino, proj);
        a_idx = a_idx + 1;
    }
    return sino;
}

// Exact Kak & Slaney spatial Ram-Lak ramp filter + linear-interpolated Radon backprojection
fn filtered_backprojection_2d(sinogram, angles_deg, out_n) {
    let sino = LA.mat_copy(sinogram);
    let n_ang = len(sino);
    let n_det = len(sino[0]);
    if type(angles_deg) != "array" or len(angles_deg) != n_ang {
        throw "filtered_backprojection_2d: angles_deg length must match sinogram rows";
    }
    let N = num_round(_f64(out_n, "filtered_backprojection_2d"));
    if N < 2 or N > MAX_RADON_GRID {
        throw "filtered_backprojection_2d: out_n must be in [2, " + str(MAX_RADON_GRID) + "]";
    }

    // Precompute Kak-Slaney exact bandlimited Ram-Lak kernel h[k] for k in [-(n_det-1), n_det-1]:
    // h[0] = 1/4, h[even != 0] = 0, h[odd k] = -1 / (pi^2 * k^2)
    let inv_pi_sq = 1.0 / (PI * PI);
    let filtered = [];
    let m = 0;
    while m < n_ang {
        let p = sino[m];
        let q_row = [];
        let b = 0;
        while b < n_det {
            let acc = 0.25 * p[b];
            let k = 1;
            while k < n_det {
                let hk = (0.0 - inv_pi_sq) / (k * k * 1.0);
                if b - k >= 0 { acc = acc + hk * p[b - k]; }
                if b + k < n_det { acc = acc + hk * p[b + k]; }
                k = k + 2; // even lags are identically zero!
            }
            array_push(q_row, acc);
            b = b + 1;
        }
        array_push(filtered, q_row);
        m = m + 1;
    }

    let center_det = 0.5 * (n_det - 1);
    let center_img = 0.5 * (N - 1);
    let dtheta = PI / (n_ang * 1.0);

    let cos_tab = [];
    let sin_tab = [];
    m = 0;
    while m < n_ang {
        let th = _f64(angles_deg[m], "filtered_backprojection_2d") * DEG_TO_RAD;
        array_push(cos_tab, num_cos(th));
        array_push(sin_tab, num_sin(th));
        m = m + 1;
    }

    let recon = LA.mat_zeros(N, N);
    let r = 0;
    while r < N {
        let y = r - center_img;
        let c = 0;
        while c < N {
            let x = c - center_img;
            let sum_bp = 0.0;
            m = 0;
            while m < n_ang {
                let t_pos = center_det + x * cos_tab[m] + y * sin_tab[m];
                if t_pos >= 0.0 and t_pos <= (n_det - 1) * 1.0 {
                    let i0 = num_floor(t_pos);
                    let i1 = if i0 + 1 < n_det { i0 + 1 } else { i0 };
                    let frac = t_pos - i0;
                    let q_interp = (1.0 - frac) * filtered[m][i0] + frac * filtered[m][i1];
                    sum_bp = sum_bp + q_interp;
                }
                m = m + 1;
            }
            recon[r][c] = sum_bp * dtheta;
            c = c + 1;
        }
        r = r + 1;
    }
    return recon;
}

// ── 2F. Theory of Computation: DFA, Rabin-Scott NFA->DFA & CYK (MSC 68Q) ─────

fn _normalize_symbol_seq(input_symbols) {
    if type(input_symbols) == "array" {
        let out = [];
        let i = 0;
        while i < len(input_symbols) {
            array_push(out, str(input_symbols[i]));
            i = i + 1;
        }
        return out;
    }
    if type(input_symbols) == "string" {
        let out = [];
        let i = 0;
        while i < len(input_symbols) {
            array_push(out, str_slice(input_symbols, i, i + 1));
            i = i + 1;
        }
        return out;
    }
    throw "automata: input_symbols must be an array of symbols or a string";
}

fn _array_contains_str(arr, target) {
    let i = 0;
    while i < len(arr) {
        if str(arr[i]) == target { return true; }
        i = i + 1;
    }
    return false;
}

fn _sort_strings_unique(arr) {
    let tmp = [];
    let i = 0;
    while i < len(arr) {
        let s = str(arr[i]);
        if not _array_contains_str(tmp, s) {
            array_push(tmp, s);
        }
        i = i + 1;
    }
    let a = 1;
    while a < len(tmp) {
        let key = tmp[a];
        let b = a - 1;
        while b >= 0 and tmp[b] > key {
            tmp[b + 1] = tmp[b];
            b = b - 1;
        }
        tmp[b + 1] = key;
        a = a + 1;
    }
    return tmp;
}

fn dfa_run(dfa, input_symbols) {
    if type(dfa) != "map" or not map_has(dfa, "start") or not map_has(dfa, "accept") or not map_has(dfa, "transitions") {
        throw "dfa_run: dfa must be a map with start, accept, transitions";
    }
    let syms = _normalize_symbol_seq(input_symbols);
    if len(syms) > MAX_STEPS {
        throw "dfa_run: input length exceeds MAX_STEPS";
    }
    let cur = str(dfa.start);
    let trace = [cur];
    let dead = false;
    let i = 0;
    while i < len(syms) and not dead {
        let sym = syms[i];
        if map_has(dfa, "alphabet") and type(dfa.alphabet) == "array" and len(dfa.alphabet) > 0 {
            if not _array_contains_str(dfa.alphabet, sym) {
                throw "dfa_run: symbol '" + sym + "' is not in DFA alphabet";
            }
        }
        if map_has(dfa.transitions, cur) and map_has(dfa.transitions[cur], sym) {
            cur = str(dfa.transitions[cur][sym]);
            array_push(trace, cur);
        } else {
            cur = "__DEAD__";
            array_push(trace, cur);
            dead = true;
        }
        i = i + 1;
    }
    let acc = (not dead) and _array_contains_str(dfa.accept, cur);
    return map{
        accepted: acc,
        final_state: cur,
        trace: trace,
        steps: len(syms)
    };
}

fn _nfa_eps_closure(nfa_trans, seed_states) {
    let closure = _sort_strings_unique(seed_states);
    let queue = [];
    let i = 0;
    while i < len(closure) { array_push(queue, closure[i]); i = i + 1; }
    let eps_keys = ["", "eps", "epsilon", "ε"];
    let head = 0;
    while head < len(queue) {
        let st = queue[head];
        head = head + 1;
        if map_has(nfa_trans, st) {
            let st_map = nfa_trans[st];
            let k = 0;
            while k < len(eps_keys) {
                let ek = eps_keys[k];
                if map_has(st_map, ek) {
                    let targets = st_map[ek];
                    if type(targets) == "array" {
                        let ti = 0;
                        while ti < len(targets) {
                            let nxt = str(targets[ti]);
                            if not _array_contains_str(closure, nxt) {
                                array_push(closure, nxt);
                                array_push(queue, nxt);
                            }
                            ti = ti + 1;
                        }
                    }
                }
                k = k + 1;
            }
        }
    }
    return _sort_strings_unique(closure);
}

fn _subset_key(sorted_states) {
    if len(sorted_states) == 0 { return "{}"; }
    let out = "{";
    let i = 0;
    while i < len(sorted_states) {
        if i > 0 { out = out + ","; }
        out = out + sorted_states[i];
        i = i + 1;
    }
    return out + "}";
}

// Rabin-Scott Powerset Construction (1959) converting NFA (with epsilon transitions) to equivalent DFA
fn nfa_to_dfa(nfa) {
    if type(nfa) != "map" or not map_has(nfa, "start") or not map_has(nfa, "accept") or not map_has(nfa, "alphabet") or not map_has(nfa, "transitions") {
        throw "nfa_to_dfa: nfa must have start, accept, alphabet, transitions";
    }
    let alphabet = [];
    let ai = 0;
    while ai < len(nfa.alphabet) {
        let sym = str(nfa.alphabet[ai]);
        if sym != "" and sym != "eps" and sym != "epsilon" and sym != "ε" {
            array_push(alphabet, sym);
        }
        ai = ai + 1;
    }

    let start_set = _nfa_eps_closure(nfa.transitions, [str(nfa.start)]);
    let start_name = _subset_key(start_set);

    let dfa_states = [start_name];
    let subset_by_name = map{};
    subset_by_name[start_name] = start_set;
    let dfa_trans = map{};
    let dfa_accept = [];

    let queue = [start_name];
    let head = 0;
    while head < len(queue) {
        let cur_name = queue[head];
        head = head + 1;
        let cur_set = subset_by_name[cur_name];

        // Mark accepting if cur_set intersects nfa.accept
        let is_acc = false;
        let ci = 0;
        while ci < len(cur_set) and not is_acc {
            if _array_contains_str(nfa.accept, cur_set[ci]) {
                is_acc = true;
            }
            ci = ci + 1;
        }
        if is_acc {
            array_push(dfa_accept, cur_name);
        }

        let row_trans = map{};
        let si = 0;
        while si < len(alphabet) {
            let sym = alphabet[si];
            let raw_next = [];
            let qi = 0;
            while qi < len(cur_set) {
                let s_sub = cur_set[qi];
                if map_has(nfa.transitions, s_sub) and map_has(nfa.transitions[s_sub], sym) {
                    let dsts = nfa.transitions[s_sub][sym];
                    if type(dsts) == "array" {
                        let di = 0;
                        while di < len(dsts) {
                            array_push(raw_next, str(dsts[di]));
                            di = di + 1;
                        }
                    } else {
                        array_push(raw_next, str(dsts));
                    }
                }
                qi = qi + 1;
            }
            let closed_next = _nfa_eps_closure(nfa.transitions, raw_next);
            let next_name = _subset_key(closed_next);
            if not map_has(subset_by_name, next_name) {
                if len(dfa_states) >= MAX_DFA_STATES {
                    throw "nfa_to_dfa: subset state count exceeds MAX_DFA_STATES (" + str(MAX_DFA_STATES) + ")";
                }
                subset_by_name[next_name] = closed_next;
                array_push(dfa_states, next_name);
                array_push(queue, next_name);
            }
            row_trans[sym] = next_name;
            si = si + 1;
        }
        dfa_trans[cur_name] = row_trans;
    }

    return map{
        states: dfa_states,
        alphabet: alphabet,
        transitions: dfa_trans,
        start: start_name,
        accept: dfa_accept
    };
}

fn _build_cyk_tree(back_table, tokens, span_len, start_idx, nonterm) {
    let key = nonterm;
    let info = back_table[span_len - 1][start_idx][key];
    if info.kind == "term" {
        return map{ symbol: nonterm, token: tokens[start_idx] };
    }
    let k = info.split;
    let left_t = _build_cyk_tree(back_table, tokens, k, start_idx, info.left);
    let right_t = _build_cyk_tree(back_table, tokens, span_len - k, start_idx + k, info.right);
    return map{ symbol: nonterm, left: left_t, right: right_t };
}

// Cocke-Younger-Kasami O(n^3 |G|) parser for Chomsky Normal Form CFGs:
// `cnf_grammar` = { start: "S", rules: { "S": [["A", "B"], ["x"]], ... } }
fn cyk_parse(cnf_grammar, tokens) {
    if type(cnf_grammar) != "map" or not map_has(cnf_grammar, "start") or not map_has(cnf_grammar, "rules") {
        throw "cyk_parse: cnf_grammar must be a map with start and rules";
    }
    let tok_arr = _normalize_symbol_seq(tokens);
    let n = len(tok_arr);
    if n > MAX_CYK_TOKENS {
        throw "cyk_parse: token count exceeds MAX_CYK_TOKENS (" + str(MAX_CYK_TOKENS) + ")";
    }

    let start_sym = str(cnf_grammar.start);
    let rules_map = cnf_grammar.rules;
    let lhs_list = map_keys(rules_map);

    let term_rules = [];
    let bin_rules = [];
    let accepts_empty = false;

    let li = 0;
    while li < len(lhs_list) {
        let lhs = lhs_list[li];
        let prods = rules_map[lhs];
        let pi = 0;
        while pi < len(prods) {
            let rhs = prods[pi];
            if type(rhs) == "string" {
                if rhs == "" and lhs == start_sym {
                    accepts_empty = true;
                } else {
                    array_push(term_rules, map{ lhs: lhs, term: rhs });
                }
            } else if type(rhs) == "array" {
                if len(rhs) == 0 and lhs == start_sym {
                    accepts_empty = true;
                } else if len(rhs) == 1 {
                    let r0 = str(rhs[0]);
                    if r0 == "" and lhs == start_sym {
                        accepts_empty = true;
                    } else {
                        array_push(term_rules, map{ lhs: lhs, term: r0 });
                    }
                } else if len(rhs) == 2 {
                    array_push(bin_rules, map{ lhs: lhs, B: str(rhs[0]), C: str(rhs[1]) });
                } else {
                    throw "cyk_parse: rule for '" + lhs + "' is not in Chomsky Normal Form (len=" + str(len(rhs)) + ")";
                }
            }
            pi = pi + 1;
        }
        li = li + 1;
    }

    if n == 0 {
        return map{
            accepted: accepts_empty,
            start_symbol: start_sym,
            token_count: 0,
            parse_tree: if accepts_empty { map{ symbol: start_sym, token: "" } } else { nil },
            chart: []
        };
    }

    // table[l][i] is a map of reachable nonterminals for span length (l+1) starting at index i
    let chart = [];
    let back = [];
    let l_idx = 0;
    while l_idx < n {
        let row_c = [];
        let row_b = [];
        let i_idx = 0;
        while i_idx < n - l_idx {
            array_push(row_c, []);
            array_push(row_b, map{});
            i_idx = i_idx + 1;
        }
        array_push(chart, row_c);
        array_push(back, row_b);
        l_idx = l_idx + 1;
    }

    // Length 1 spans (terminal productions A -> a)
    let pos = 0;
    while pos < n {
        let tok = tok_arr[pos];
        let tr_i = 0;
        while tr_i < len(term_rules) {
            let tr = term_rules[tr_i];
            if tr.term == tok and not _array_contains_str(chart[0][pos], tr.lhs) {
                array_push(chart[0][pos], tr.lhs);
                back[0][pos][tr.lhs] = map{ kind: "term", token: tok };
            }
            tr_i = tr_i + 1;
        }
        pos = pos + 1;
    }

    // Spans of length L = 2 .. n
    let L = 2;
    while L <= n {
        let i = 0;
        while i <= n - L {
            let k = 1;
            while k < L {
                let left_set = chart[k - 1][i];
                let right_set = chart[L - k - 1][i + k];
                if len(left_set) > 0 and len(right_set) > 0 {
                    let br_i = 0;
                    while br_i < len(bin_rules) {
                        let br = bin_rules[br_i];
                        if _array_contains_str(left_set, br.B) and _array_contains_str(right_set, br.C) {
                            if not _array_contains_str(chart[L - 1][i], br.lhs) {
                                array_push(chart[L - 1][i], br.lhs);
                                back[L - 1][i][br.lhs] = map{
                                    kind: "bin",
                                    split: k,
                                    left: br.B,
                                    right: br.C
                                };
                            }
                        }
                        br_i = br_i + 1;
                    }
                }
                k = k + 1;
            }
            i = i + 1;
        }
        L = L + 1;
    }

    let ok_parse = _array_contains_str(chart[n - 1][0], start_sym);
    let tree = nil;
    if ok_parse {
        tree = _build_cyk_tree(back, tok_arr, n, 0, start_sym);
    }

    return map{
        accepted: ok_parse,
        start_symbol: start_sym,
        token_count: n,
        parse_tree: tree,
        chart: chart
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// 3. Interdisciplinary Mathematical Sciences (MSC 70–86, 91, 92, 93)
// ══════════════════════════════════════════════════════════════════════════════

// ── 3A. Control Theory & Signal Estimation (MSC 93) ───────────────────────────

fn _as_col_or_2d(M, expected_rows, ctx) {
    if type(M) == "number" and expected_rows == 1 {
        return [[_f64(M, ctx)]];
    }
    if type(M) == "array" and len(M) > 0 and type(M[0]) != "array" {
        if len(M) != expected_rows {
            throw ctx + ": vector length mismatch";
        }
        let out = [];
        let i = 0;
        while i < len(M) {
            array_push(out, [_f64(M[i], ctx)]);
            i = i + 1;
        }
        return out;
    }
    let out2 = LA.mat_copy(M);
    if len(out2) != expected_rows {
        throw ctx + ": matrix row dimension mismatch";
    }
    return out2;
}

fn _as_row_or_2d(M, expected_cols, ctx) {
    if type(M) == "number" and expected_cols == 1 {
        return [[_f64(M, ctx)]];
    }
    if type(M) == "array" and len(M) > 0 and type(M[0]) != "array" {
        if len(M) != expected_cols {
            throw ctx + ": row vector length mismatch";
        }
        let r = [];
        let i = 0;
        while i < len(M) {
            array_push(r, _f64(M[i], ctx));
            i = i + 1;
        }
        return [r];
    }
    let out2 = LA.mat_copy(M);
    if len(out2[0]) != expected_cols {
        throw ctx + ": matrix column dimension mismatch";
    }
    return out2;
}

fn _numerical_rank(M) {
    let s = LA.svd(M);
    let sv = s.singular_values;
    if len(sv) == 0 or sv[0] <= 1e-14 { return 0; }
    let tol = _max2(len(M), len(M[0])) * 1e-10 * _max2(1.0, sv[0]);
    let r = 0;
    let i = 0;
    while i < len(sv) {
        if sv[i] > tol { r = r + 1; }
        i = i + 1;
    }
    return r;
}

// Kalman Controllability C = [B, AB, ..., A^{n-1}B] & Observability O = [C; CA; ...; CA^{n-1}]
fn kalman_controllability_observability(A, B, C) {
    let MA = if type(A) == "number" { [[_f64(A, "kalman_co")]] } else { LA.mat_copy(A) };
    let n = len(MA);
    if len(MA[0]) != n or n > MAX_DIM {
        throw "kalman_controllability_observability: A must be square <= MAX_DIM";
    }
    let MB = _as_col_or_2d(B, n, "kalman_controllability_observability");
    let MC = _as_row_or_2d(C, n, "kalman_controllability_observability");
    let m_in = len(MB[0]);
    let p_out = len(MC);

    let calC = LA.mat_zeros(n, n * m_in);
    let AkB = MB;
    let k = 0;
    while k < n {
        let r = 0;
        while r < n {
            let c = 0;
            while c < m_in {
                calC[r][k * m_in + c] = AkB[r][c];
                c = c + 1;
            }
            r = r + 1;
        }
        if k + 1 < n {
            AkB = LA.mat_mul(MA, AkB);
        }
        k = k + 1;
    }

    let calO = LA.mat_zeros(n * p_out, n);
    let CAk = MC;
    k = 0;
    while k < n {
        let r = 0;
        while r < p_out {
            let c = 0;
            while c < n {
                calO[k * p_out + r][c] = CAk[r][c];
                c = c + 1;
            }
            r = r + 1;
        }
        if k + 1 < n {
            CAk = LA.mat_mul(CAk, MA);
        }
        k = k + 1;
    }

    let rank_c = _numerical_rank(calC);
    let rank_o = _numerical_rank(calO);
    return map{
        state_dim: n,
        controllability_matrix: calC,
        observability_matrix: calO,
        controllability_rank: rank_c,
        observability_rank: rank_o,
        is_controllable: (rank_c == n),
        is_observable: (rank_o == n),
        is_minimal: (rank_c == n and rank_o == n)
    };
}

// Routh-Hurwitz continuous-time stability table with zero-pivot epsilon perturbation
// and all-zero-row auxiliary polynomial derivative handling.
fn routh_hurwitz_stability(poly_coeffs_desc) {
    if type(poly_coeffs_desc) != "array" or len(poly_coeffs_desc) == 0 {
        throw "routh_hurwitz_stability: poly_coeffs_desc must be non-empty";
    }
    let start = 0;
    while start < len(poly_coeffs_desc) - 1 and num_abs(_f64(poly_coeffs_desc[start], "routh")) <= 1e-15 {
        start = start + 1;
    }
    let n = (len(poly_coeffs_desc) - 1) - start;
    if n > MAX_DIM {
        throw "routh_hurwitz_stability: degree exceeds MAX_DIM";
    }
    let lead = _f64(poly_coeffs_desc[start], "routh");
    if num_abs(lead) <= 1e-15 {
        throw "routh_hurwitz_stability: zero polynomial";
    }
    if n == 0 {
        return map{
            is_hurwitz_stable: true,
            rhp_roots: 0,
            had_auxiliary_zero_row: false,
            had_epsilon_pivot: false,
            first_column: [1.0],
            routh_table: [[1.0]]
        };
    }

    let sgn = if lead > 0.0 { 1.0 } else { -1.0 };
    let coeffs = [];
    let i = start;
    while i < len(poly_coeffs_desc) {
        array_push(coeffs, _f64(poly_coeffs_desc[i], "routh") * sgn);
        i = i + 1;
    }

    let cols = num_floor(n / 2) + 1;
    let table = LA.mat_zeros(n + 1, cols);
    i = 0;
    while i <= n {
        let row_01 = i % 2;
        let col_idx = num_floor(i / 2);
        table[row_01][col_idx] = coeffs[i];
        i = i + 1;
    }

    let had_aux_row = false;
    let had_eps_pivot = false;

    // Check if row 1 is already identically zero (e.g. purely even polynomial s^2 + 1)
    let row1_norm = 0.0;
    let c = 0;
    while c < cols {
        row1_norm = row1_norm + num_abs(table[1][c]);
        c = c + 1;
    }
    if row1_norm <= 1e-14 {
        had_aux_row = true;
        c = 0;
        while c < cols {
            let pwr = n - 2 * c;
            if pwr > 0 {
                table[1][c] = pwr * table[0][c];
            }
            c = c + 1;
        }
    } else if num_abs(table[1][0]) <= 1e-14 {
        had_eps_pivot = true;
        table[1][0] = 1e-11 * row1_norm;
    }

    let r = 2;
    while r <= n {
        let p_pivot = table[r - 1][0];
        c = 0;
        while c < cols - 1 {
            let a1 = table[r - 2][0];
            let a2 = table[r - 2][c + 1];
            let b1 = p_pivot;
            let b2 = table[r - 1][c + 1];
            table[r][c] = (b1 * a2 - a1 * b2) / b1;
            c = c + 1;
        }

        let row_norm = 0.0;
        c = 0;
        while c < cols {
            row_norm = row_norm + num_abs(table[r][c]);
            c = c + 1;
        }
        let scale_above = 0.0;
        c = 0;
        while c < cols { scale_above = scale_above + num_abs(table[r - 1][c]); c = c + 1; }

        if row_norm <= 1e-13 * _max2(1.0, scale_above) {
            // Entire row of zeros -> replace with derivative of auxiliary polynomial at row (r - 1)
            had_aux_row = true;
            let aux_deg = n - (r - 1);
            c = 0;
            while c < cols {
                let pwr = aux_deg - 2 * c;
                if pwr > 0 {
                    table[r][c] = pwr * table[r - 1][c];
                } else {
                    table[r][c] = 0.0;
                }
                c = c + 1;
            }
        } else if num_abs(table[r][0]) <= 1e-14 * _max2(1.0, row_norm) {
            // Zero leading pivot with non-zero remainder -> positive epsilon perturbation
            had_eps_pivot = true;
            table[r][0] = 1e-11 * row_norm;
        }
        r = r + 1;
    }

    let first_col = [];
    let sign_changes = 0;
    let prev_sign = 1;
    r = 0;
    while r <= n {
        let val = table[r][0];
        array_push(first_col, val);
        let cur_sign = if val > 0.0 { 1 } else if val < 0.0 { -1 } else { 0 };
        if cur_sign != 0 and cur_sign != prev_sign {
            sign_changes = sign_changes + 1;
            prev_sign = cur_sign;
        }
        r = r + 1;
    }

    let strictly_stable = (sign_changes == 0) and (not had_aux_row) and (not had_eps_pivot);
    return map{
        is_hurwitz_stable: strictly_stable,
        rhp_roots: sign_changes,
        had_auxiliary_zero_row: had_aux_row,
        had_epsilon_pivot: had_eps_pivot,
        first_column: first_col,
        routh_table: table
    };
}

fn _symmetrize_mat(M) {
    let n = len(M);
    let out = LA.mat_zeros(n, n);
    let i = 0;
    while i < n {
        let j = i;
        while j < n {
            let v = 0.5 * (M[i][j] + M[j][i]);
            out[i][j] = v;
            out[j][i] = v;
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

// Discrete Linear-Gaussian Kalman Filter (1D scalar or N-D state / M-D observation)
// using numerically PSD-preserving Joseph-form covariance update:
//   P_{k|k} = (I - K_k H) P_{k|k-1} (I - K_k H)^T + K_k R K_k^T
fn kalman_filter_1d_nd(F, H, Q, R, x0, P0, measurements) {
    let scalar_mode = (type(x0) == "number");
    let x_cur = if scalar_mode { [_f64(x0, "kalman")] } else { [] };
    if not scalar_mode {
        if type(x0) != "array" or len(x0) == 0 {
            throw "kalman_filter_1d_nd: x0 must be a number or state vector array";
        }
        let i = 0;
        while i < len(x0) {
            array_push(x_cur, _f64(x0[i], "kalman"));
            i = i + 1;
        }
    }
    let n = len(x_cur);
    let MF = if type(F) == "number" and n == 1 { [[_f64(F, "kalman")]] } else { LA.mat_copy(F) };
    let MH = _as_row_or_2d(H, n, "kalman_filter_1d_nd");
    let m = len(MH);
    let MQ = if type(Q) == "number" and n == 1 { [[_f64(Q, "kalman")]] } else { LA.mat_copy(Q) };
    let MR = if type(R) == "number" and m == 1 { [[_f64(R, "kalman")]] } else { LA.mat_copy(R) };
    let P_cur = if type(P0) == "number" and n == 1 { [[_f64(P0, "kalman")]] } else { LA.mat_copy(P0) };

    if type(measurements) != "array" {
        throw "kalman_filter_1d_nd: measurements must be an array";
    }
    if len(measurements) > MAX_STEPS {
        throw "kalman_filter_1d_nd: measurement count exceeds MAX_STEPS";
    }

    let FT = LA.mat_transpose(MF);
    let HT = LA.mat_transpose(MH);
    let I_n = LA.mat_eye(n);

    let states = [];
    let covs = [];
    let gains = [];
    let innovations = [];

    let step = 0;
    while step < len(measurements) {
        let z_raw = measurements[step];
        let z_vec = [];
        if type(z_raw) == "number" {
            if m != 1 {
                throw "kalman_filter_1d_nd: scalar measurement given for m=" + str(m) + " outputs";
            }
            array_push(z_vec, _f64(z_raw, "kalman"));
        } else {
            if type(z_raw) != "array" or len(z_raw) != m {
                throw "kalman_filter_1d_nd: measurement vector dimension mismatch";
            }
            let j = 0;
            while j < m {
                array_push(z_vec, _f64(z_raw[j], "kalman"));
                j = j + 1;
            }
        }

        // 1. Predict
        let x_pred = LA.mat_vec_mul(MF, x_cur);
        let P_pred = _symmetrize_mat(LA.mat_add(LA.mat_mul(LA.mat_mul(MF, P_cur), FT), MQ));

        // 2. Innovation & Kalman Gain K = P_pred * H^T * (H * P_pred * H^T + R)^(-1)
        let hx = LA.mat_vec_mul(MH, x_pred);
        let innov = [];
        let j = 0;
        while j < m {
            array_push(innov, z_vec[j] - hx[j]);
            j = j + 1;
        }
        let S = _symmetrize_mat(LA.mat_add(LA.mat_mul(LA.mat_mul(MH, P_pred), HT), MR));
        let S_inv = LA.inv(S);
        let K = LA.mat_mul(LA.mat_mul(P_pred, HT), S_inv);

        // 3. State update & Joseph-form covariance update
        let Ky = LA.mat_vec_mul(K, innov);
        let x_upd = [];
        let i = 0;
        while i < n {
            array_push(x_upd, x_pred[i] + Ky[i]);
            i = i + 1;
        }
        let I_minus_KH = LA.mat_sub(I_n, LA.mat_mul(K, MH));
        let term1 = LA.mat_mul(LA.mat_mul(I_minus_KH, P_pred), LA.mat_transpose(I_minus_KH));
        let term2 = LA.mat_mul(LA.mat_mul(K, MR), LA.mat_transpose(K));
        let P_upd = _symmetrize_mat(LA.mat_add(term1, term2));

        x_cur = x_upd;
        P_cur = P_upd;
        array_push(states, x_cur);
        array_push(covs, P_cur);
        array_push(gains, K);
        array_push(innovations, innov);
        step = step + 1;
    }

    return map{
        x_posterior: x_cur,
        P_posterior: P_cur,
        final_scalar_state: if n == 1 { x_cur[0] } else { nil },
        filtered_states: states,
        filtered_covariances: covs,
        kalman_gains: gains,
        innovations: innovations
    };
}

// Discrete-Time Linear Quadratic Regulator (DARE solver) for u_k = -K x_k
fn lqr_discrete(A, B, Q, R, max_iter = 500) {
    let MA = if type(A) == "number" { [[_f64(A, "lqr")]] } else { LA.mat_copy(A) };
    let n = len(MA);
    let MB = _as_col_or_2d(B, n, "lqr_discrete");
    let m = len(MB[0]);
    let MQ = if type(Q) == "number" and n == 1 { [[_f64(Q, "lqr")]] } else { LA.mat_copy(Q) };
    let MR = if type(R) == "number" and m == 1 { [[_f64(R, "lqr")]] } else { LA.mat_copy(R) };
    let max_it = num_round(_f64(max_iter, "lqr_discrete"));
    if max_it < 1 or max_it > MAX_STEPS {
        throw "lqr_discrete: max_iter out of range";
    }

    let BT = LA.mat_transpose(MB);
    let P = _symmetrize_mat(MQ);
    let K = LA.mat_zeros(m, n);
    let it = 0;
    let conv = false;
    let diff_norm = 0.0;

    while it < max_it and not conv {
        it = it + 1;
        // K_t = (R + B^T P_t B)^(-1) B^T P_t A
        let S_u = _symmetrize_mat(LA.mat_add(MR, LA.mat_mul(LA.mat_mul(BT, P), MB)));
        let S_u_inv = LA.inv(S_u);
        K = LA.mat_mul(S_u_inv, LA.mat_mul(LA.mat_mul(BT, P), MA));

        // Joseph-stabilized Riccati update: P_{t+1} = Q + K^T R K + (A - B K)^T P (A - B K)
        let A_cl = LA.mat_sub(MA, LA.mat_mul(MB, K));
        let KT = LA.mat_transpose(K);
        let p1 = LA.mat_add(MQ, LA.mat_mul(LA.mat_mul(KT, MR), K));
        let p2 = LA.mat_mul(LA.mat_mul(LA.mat_transpose(A_cl), P), A_cl);
        let P_next = _symmetrize_mat(LA.mat_add(p1, p2));

        diff_norm = LA.mat_norms(LA.mat_sub(P_next, P)).frobenius;
        let scale = 1.0 + LA.mat_norms(P_next).frobenius;
        P = P_next;
        if diff_norm <= 1e-13 * scale {
            conv = true;
        }
    }

    // Final optimal gain K* at converged P*
    let S_fin = _symmetrize_mat(LA.mat_add(MR, LA.mat_mul(LA.mat_mul(BT, P), MB)));
    K = LA.mat_mul(LA.inv(S_fin), LA.mat_mul(LA.mat_mul(BT, P), MA));
    let A_closed = LA.mat_sub(MA, LA.mat_mul(MB, K));

    let eig_cl = LA.eig_general(A_closed);
    let rho = 0.0;
    let i = 0;
    while i < len(eig_cl.eigenvalues) {
        let ev = eig_cl.eigenvalues[i];
        let mag = num_sqrt(ev.re * ev.re + ev.im * ev.im);
        if mag > rho { rho = mag; }
        i = i + 1;
    }

    return map{
        K: K,
        P: P,
        closed_loop_A: A_closed,
        spectral_radius: rho,
        is_closed_loop_stable: (rho < 1.0 - 1e-9),
        riccati_delta_norm: diff_norm,
        iterations: it,
        converged: conv
    };
}

// ── 3B. Mathematical Physics, Quantum, Continuum & Thermodynamics (MSC 70–86) ─

// Solves Kepler's Equation M = E - e * sin(E) (0 <= e < 1) via Halley's cubic-order iteration
fn kepler_orbit_solve(mean_anomaly_rad, eccentricity) {
    let M_in = _f64(mean_anomaly_rad, "kepler_orbit_solve");
    let e = _f64(eccentricity, "kepler_orbit_solve");
    if e < 0.0 or e >= 1.0 {
        throw "kepler_orbit_solve: elliptical orbit requires 0 <= eccentricity < 1";
    }

    // Reduce M to [-pi, pi] while tracking full 2*pi turns so unwrapped E satisfies E - e*sin(E) == M_in
    let turns = num_round(M_in / TWO_PI);
    let M = M_in - turns * TWO_PI;

    let sgn_sin = if num_sin(M) >= 0.0 { 1.0 } else { -1.0 };
    let E = if e < 0.8 { M + e * num_sin(M) / (1.0 - num_sin(M + e) + num_sin(M)) } else { M + 0.85 * e * sgn_sin };
    if num_abs(M) < 1e-15 { E = 0.0; }

    let it = 0;
    let done = false;
    while it < 32 and not done {
        it = it + 1;
        let sE = num_sin(E);
        let cE = num_cos(E);
        let f = E - e * sE - M;
        if num_abs(f) <= 1e-15 {
            done = true;
        } else {
            let fp = 1.0 - e * cE;
            let fpp = e * sE;
            let denom = 2.0 * fp * fp - f * fpp;
            let dE = (0.0 - 2.0 * f * fp) / denom;
            E = E + dE;
            if num_abs(dE) <= 1e-15 {
                done = true;
            }
        }
    }

    let E_full = E + turns * TWO_PI;
    let half_E = 0.5 * E;
    let nu_wrapped = 2.0 * num_atan2(num_sqrt(1.0 + e) * num_sin(half_E), num_sqrt(1.0 - e) * num_cos(half_E));
    let nu_full = nu_wrapped + turns * TWO_PI;
    let r_over_a = 1.0 - e * num_cos(E_full);
    let res_err = num_abs((E_full - e * num_sin(E_full)) - M_in);

    return map{
        eccentric_anomaly_rad: E_full,
        true_anomaly_rad: nu_full,
        true_anomaly_wrapped_rad: nu_wrapped,
        radius_ratio_r_over_a: r_over_a,
        residual: res_err,
        iterations: it
    };
}

// 1D Time-Independent Schrodinger Equation -(hbar^2 / 2m) d^2 psi / dx^2 + V(x) psi = E psi
// Discretized with 4th-order symmetric central finite differences [-1/12, 4/3, -5/2, 4/3, -1/12] / dx^2
// and solved via cyclic Jacobi symmetric eigensolver (`linalg_geometry.eigh_symmetric`).
fn schrodinger_1d_eigenstates(V_fn, x_min, x_max, n_grid = 80, mass = 1.0, hbar = 1.0, n_states = 4) {
    let x0 = _f64(x_min, "schrodinger_1d_eigenstates");
    let x1 = _f64(x_max, "schrodinger_1d_eigenstates");
    let N = num_round(_f64(n_grid, "schrodinger_1d_eigenstates"));
    let m = _f64(mass, "schrodinger_1d_eigenstates");
    let hb = _f64(hbar, "schrodinger_1d_eigenstates");
    let k_req = num_round(_f64(n_states, "schrodinger_1d_eigenstates"));

    if x1 <= x0 { throw "schrodinger_1d_eigenstates: require x_min < x_max"; }
    if N < 8 or N > MAX_DIM { throw "schrodinger_1d_eigenstates: n_grid must be in [8, " + str(MAX_DIM) + "]"; }
    if m <= 0.0 or hb <= 0.0 { throw "schrodinger_1d_eigenstates: mass and hbar must be > 0"; }
    if k_req < 1 or k_req > N { throw "schrodinger_1d_eigenstates: n_states must be in [1, n_grid]"; }

    let dx = (x1 - x0) / ((N + 1) * 1.0);
    let kin = (hb * hb) / (2.0 * m * dx * dx);

    let grid_x = [];
    let H = LA.mat_zeros(N, N);
    let i = 0;
    while i < N {
        let xi = x0 + (i + 1) * dx;
        array_push(grid_x, xi);
        let vi = _f64(V_fn(xi), "schrodinger_1d_eigenstates");
        H[i][i] = 2.5 * kin + vi;
        if i + 1 < N {
            let c1 = (0.0 - (4.0 / 3.0)) * kin;
            H[i][i + 1] = c1;
            H[i + 1][i] = c1;
        }
        if i + 2 < N {
            let c2 = (1.0 / 12.0) * kin;
            H[i][i + 2] = c2;
            H[i + 2][i] = c2;
        }
        i = i + 1;
    }

    let eig = LA.eigh_symmetric(H);
    let energies = [];
    let wavefunctions = [];
    let inv_sqrt_dx = 1.0 / num_sqrt(dx);

    let s = 0;
    while s < k_req {
        array_push(energies, eig.eigenvalues[s]);
        // Normalize L^2 wavefunction so sum_i |psi_s(x_i)|^2 * dx == 1, with canonical positive first peak
        let psi = [];
        let max_abs_idx = 0;
        let max_abs_v = 0.0;
        let r = 0;
        while r < N {
            let v = eig.eigenvectors[r][s] * inv_sqrt_dx;
            array_push(psi, v);
            if num_abs(v) > max_abs_v {
                max_abs_v = num_abs(v);
                max_abs_idx = r;
            }
            r = r + 1;
        }
        if psi[max_abs_idx] < 0.0 {
            r = 0;
            while r < N { psi[r] = 0.0 - psi[r]; r = r + 1; }
        }
        array_push(wavefunctions, psi);
        s = s + 1;
    }

    return map{
        energies: energies,
        wavefunctions: wavefunctions,
        grid_x: grid_x,
        dx: dx,
        jacobi_iterations: eig.iterations
    };
}

// Von Neumann Quantum Entropy S(rho) = -Tr(rho ln rho) for real symmetric or complex Hermitian PSD rho
fn von_neumann_entropy(density_matrix) {
    if type(density_matrix) != "array" or len(density_matrix) == 0 {
        throw "von_neumann_entropy: expected non-empty square density matrix";
    }
    let d = len(density_matrix);
    if d > 128 {
        throw "von_neumann_entropy: dimension exceeds bound 128";
    }

    let Re = LA.mat_zeros(d, d);
    let Im = LA.mat_zeros(d, d);
    let has_imag = false;
    let i = 0;
    while i < d {
        if type(density_matrix[i]) != "array" or len(density_matrix[i]) != d {
            throw "von_neumann_entropy: density matrix must be square";
        }
        let j = 0;
        while j < d {
            let cell = density_matrix[i][j];
            if type(cell) == "map" and map_has(cell, "re") and map_has(cell, "im") {
                Re[i][j] = _f64(cell.re, "von_neumann_entropy");
                Im[i][j] = _f64(cell.im, "von_neumann_entropy");
                if num_abs(Im[i][j]) > 1e-15 { has_imag = true; }
            } else {
                Re[i][j] = _f64(cell, "von_neumann_entropy");
                Im[i][j] = 0.0;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Check Hermitian rho_{ij} == conj(rho_{ji}) and Tr(rho) == 1
    let tr_re = 0.0;
    let tr_im = 0.0;
    i = 0;
    while i < d {
        tr_re = tr_re + Re[i][i];
        tr_im = tr_im + Im[i][i];
        if num_abs(Im[i][i]) > 1e-9 {
            throw "von_neumann_entropy: diagonal entry has non-zero imaginary part (not Hermitian)";
        }
        let j = i + 1;
        while j < d {
            if num_abs(Re[i][j] - Re[j][i]) > 1e-9 or num_abs(Im[i][j] + Im[j][i]) > 1e-9 {
                throw "von_neumann_entropy: matrix is not Hermitian";
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if num_abs(tr_re - 1.0) > 1e-8 or num_abs(tr_im) > 1e-8 {
        throw "von_neumann_entropy: density matrix must have unit trace Tr(rho) == 1, got " + str(tr_re);
    }

    let evals = [];
    if not has_imag {
        evals = LA.eigh_symmetric(Re).eigenvalues;
    } else {
        // Real 2d x 2d symmetric block embedding [[Re, -Im], [Im, Re]] has exact eigenvalue pairs
        let H2 = LA.mat_zeros(2 * d, 2 * d);
        i = 0;
        while i < d {
            let j = 0;
            while j < d {
                H2[i][j] = Re[i][j];
                H2[i][d + j] = 0.0 - Im[i][j];
                H2[d + i][j] = Im[i][j];
                H2[d + i][d + j] = Re[i][j];
                j = j + 1;
            }
            i = i + 1;
        }
        let ev2 = LA.eigh_symmetric(H2).eigenvalues;
        i = 0;
        while i < d {
            array_push(evals, 0.5 * (ev2[2 * i] + ev2[2 * i + 1]));
            i = i + 1;
        }
    }

    let s_nats = 0.0;
    let purity = 0.0;
    let clean_evals = [];
    i = 0;
    while i < d {
        let lam = evals[i];
        if lam < -1e-8 {
            throw "von_neumann_entropy: density matrix is not positive semi-definite (min eig=" + str(lam) + ")";
        }
        if lam < 0.0 { lam = 0.0; }
        array_push(clean_evals, lam);
        purity = purity + lam * lam;
        if lam > 1e-15 {
            s_nats = s_nats - lam * num_ln(lam);
        }
        i = i + 1;
    }
    if s_nats < 0.0 and s_nats > -1e-14 { s_nats = 0.0; }

    return map{
        entropy_nats: s_nats,
        entropy_bits: s_nats / num_ln(2.0),
        eigenvalues: clean_evals,
        purity: purity,
        is_pure_state: (num_abs(purity - 1.0) <= 1e-9),
        max_entropy_nats: num_ln(d * 1.0)
    };
}

// Canonical Ensemble Statistical Mechanics (k_B = 1 natural units):
// Z = sum_i g_i exp(-beta E_i), F = -(1/beta) ln Z, U = <E>, C_V = beta^2 Var(E), S = beta (U - F)
fn statmech_partition_function(energies, degeneracies, beta) {
    if type(energies) != "array" or len(energies) == 0 {
        throw "statmech_partition_function: energies must be a non-empty array";
    }
    let g_arr = [];
    if degeneracies == nil {
        let i = 0;
        while i < len(energies) { array_push(g_arr, 1.0); i = i + 1; }
    } else {
        if type(degeneracies) != "array" or len(degeneracies) != len(energies) {
            throw "statmech_partition_function: degeneracies must match energies length";
        }
        let i = 0;
        while i < len(degeneracies) {
            let gi = _f64(degeneracies[i], "statmech_partition_function");
            if gi <= 0.0 { throw "statmech_partition_function: degeneracies must be > 0"; }
            array_push(g_arr, gi);
            i = i + 1;
        }
    }
    let b = _f64(beta, "statmech_partition_function");
    if b <= 0.0 {
        throw "statmech_partition_function: inverse temperature beta must be > 0";
    }

    let E = [];
    let e_min = _f64(energies[0], "statmech_partition_function");
    let i = 0;
    while i < len(energies) {
        let ei = _f64(energies[i], "statmech_partition_function");
        array_push(E, ei);
        if ei < e_min { e_min = ei; }
        i = i + 1;
    }

    // Log-sum-exp stabilization relative to ground state e_min
    let weights = [];
    let z_shift = 0.0;
    i = 0;
    while i < len(E) {
        let wi = g_arr[i] * num_exp(0.0 - b * (E[i] - e_min));
        array_push(weights, wi);
        z_shift = z_shift + wi;
        i = i + 1;
    }

    let ln_Z = (0.0 - b * e_min) + num_ln(z_shift);
    let Z = if ln_Z > -700.0 and ln_Z < 700.0 { num_exp(ln_Z) } else { 0.0 };
    let F = e_min - num_ln(z_shift) / b;

    let probs = [];
    let U = 0.0;
    i = 0;
    while i < len(E) {
        let pi = weights[i] / z_shift;
        array_push(probs, pi);
        U = U + pi * E[i];
        i = i + 1;
    }

    let var_E = 0.0;
    let S_gibbs = 0.0;
    i = 0;
    while i < len(E) {
        let pi = probs[i];
        let de = E[i] - U;
        var_E = var_E + pi * de * de;
        if pi > 1e-300 {
            S_gibbs = S_gibbs - pi * num_ln(pi / g_arr[i]);
        }
        i = i + 1;
    }
    let Cv = b * b * var_E;

    return map{
        Z: Z,
        ln_Z: ln_Z,
        helmholtz_free_energy_F: F,
        internal_energy_U: U,
        energy_variance: var_E,
        heat_capacity_Cv: Cv,
        gibbs_entropy_S: S_gibbs,
        boltzmann_probabilities: probs,
        euler_identity_residual: num_abs(F - (U - S_gibbs / b))
    };
}

// 3D Continuum Mechanics Cauchy Stress Tensor Analysis & Von Mises Equivalent Stress
fn von_mises_stress_3d(stress_tensor_3x3) {
    let sig = LA.mat_copy(stress_tensor_3x3);
    if len(sig) != 3 or len(sig[0]) != 3 {
        throw "von_mises_stress_3d: expected 3x3 symmetric Cauchy stress tensor";
    }
    let eig = LA.eigh_symmetric(sig); // Also validates symmetry!
    // Sort principal stresses descending sigma_1 >= sigma_2 >= sigma_3
    let p_asc = eig.eigenvalues;
    let s1 = p_asc[2];
    let s2 = p_asc[1];
    let s3 = p_asc[0];

    let mean_stress = (sig[0][0] + sig[1][1] + sig[2][2]) / 3.0;
    let hydro_pressure = 0.0 - mean_stress;
    let dev = LA.mat_zeros(3, 3);
    let sij_sij = 0.0;
    let i = 0;
    while i < 3 {
        let j = 0;
        while j < 3 {
            let val = if i == j { sig[i][j] - mean_stress } else { sig[i][j] };
            dev[i][j] = val;
            sij_sij = sij_sij + val * val;
            j = j + 1;
        }
        i = i + 1;
    }
    let J2 = 0.5 * sij_sij;
    let vm = num_sqrt(1.5 * sij_sij);
    let max_shear = 0.5 * (s1 - s3);

    return map{
        mean_normal_stress: mean_stress,
        hydrostatic_pressure: hydro_pressure,
        deviatoric_tensor: dev,
        principal_stresses: [s1, s2, s3],
        sigma_1: s1,
        sigma_2: s2,
        sigma_3: s3,
        J2_invariant: J2,
        von_mises_stress: vm,
        max_shear_stress: max_shear
    };
}

// ── 3C. Mathematical Biology, Epidemiology, Actuarial, Economics & Social Choice

// Halley solver for Principal Branch Lambert W_0(z) on z >= -1/e
fn _lambert_w0(z) {
    let inv_e = 0.36787944117144232160;
    if z < (0.0 - inv_e) - 1e-14 {
        throw "_lambert_w0: argument below -1/e";
    }
    if num_abs(z + inv_e) <= 1e-14 { return -1.0; }
    if num_abs(z) <= 1e-16 { return 0.0; }

    let w = if z < 1.0 { z * (1.0 - z + 1.5 * z * z) / (1.0 + z * z) } else { num_ln(z) - num_ln(_max2(1.0, num_ln(z))) };
    if z < 0.0 and z > -0.36 {
        let p = num_sqrt(2.0 * (2.71828182845904523536 * z + 1.0));
        w = -1.0 + p - (p * p) / 3.0;
    }
    let it = 0;
    while it < 32 {
        it = it + 1;
        let ew = num_exp(w);
        let wew = w * ew;
        let f = wew - z;
        if num_abs(f) <= 1e-15 * _max2(1.0, num_abs(z)) {
            return w;
        }
        let denom = ew * (w + 1.0) - ((w + 2.0) * f) / (2.0 * w + 2.0);
        let dw = f / denom;
        w = w - dw;
        if num_abs(dw) <= 1e-15 { return w; }
    }
    return w;
}

// Kermack-McKendrick (1927) SIR Model:
//   dS/dt = -(beta / N) S I,   dI/dt = (beta / N) S I - gamma I,   dR/dt = gamma I
// Computes R_0 = (beta * S_0) / (gamma * N), herd immunity threshold 1 - 1/R_0,
// exact asymptotic S_inf via Lambert-W / Newton on first integral, and RK4 trajectory.
fn epidemic_sir_exact_and_rk4(S0, I0, R0_init, beta, gamma, t_end) {
    let s0 = _f64(S0, "epidemic_sir");
    let i0 = _f64(I0, "epidemic_sir");
    let r0_i = _f64(R0_init, "epidemic_sir");
    let b = _f64(beta, "epidemic_sir");
    let g = _f64(gamma, "epidemic_sir");
    let T = _f64(t_end, "epidemic_sir");

    if s0 <= 0.0 or i0 < 0.0 or r0_i < 0.0 {
        throw "epidemic_sir_exact_and_rk4: require S0 > 0, I0 >= 0, R0_init >= 0";
    }
    if b <= 0.0 or g <= 0.0 or T <= 0.0 {
        throw "epidemic_sir_exact_and_rk4: require beta > 0, gamma > 0, t_end > 0";
    }

    let N = s0 + i0 + r0_i;
    let R0_eff = (b * s0) / (g * N);
    let R0_basic = b / g;
    let hit = if R0_eff > 1.0 { 1.0 - 1.0 / R0_eff } else { 0.0 };

    // 1. Exact ODE asymptotic final susceptible S_inf from conserved first integral:
    //    ln(S_inf / S_0) = (beta / (gamma * N)) * (S_inf - (S_0 + I_0))
    //    => -(beta/(gamma*N))*S_inf * exp(-(beta/(gamma*N))*S_inf) = -(beta/(gamma*N))*S_0 * exp(-(beta/(gamma*N))*(S_0 + I_0))
    let S_inf_ode = s0;
    if i0 > 0.0 {
        let alpha = b / (g * N);
        let arg_w = (0.0 - alpha * s0) * num_exp(0.0 - alpha * (s0 + i0));
        let w_val = _lambert_w0(arg_w);
        S_inf_ode = (0.0 - w_val) / alpha;
        // Polish to full 53-bit precision with 3 Newton steps on g(S) = ln(S/s0) - alpha*(S - s0 - i0)
        let k = 0;
        while k < 4 {
            let gv = num_ln(S_inf_ode / s0) - alpha * (S_inf_ode - s0 - i0);
            let gp = (1.0 / S_inf_ode) - alpha;
            S_inf_ode = S_inf_ode - gv / gp;
            k = k + 1;
        }
    }

    // Also solve the pure zero-seed asymptotic fraction equation ln(s_inf / s0_frac) = R0_eff * (s_inf - 1)
    let s0_frac = s0 / N;
    let s_inf_r0_eq = s0_frac;
    if R0_eff > 1.0 or i0 > 0.0 {
        let arg_r0 = (0.0 - R0_eff * s0_frac) * num_exp(0.0 - R0_eff);
        if arg_r0 >= -0.36787944117144232 {
            let cand = (0.0 - _lambert_w0(arg_r0)) / R0_eff;
            if cand < s0_frac {
                let k2 = 0;
                while k2 < 5 {
                    let fv = num_ln(cand / s0_frac) - R0_eff * (cand - 1.0);
                    let fp = (1.0 / cand) - R0_eff;
                    cand = cand - fv / fp;
                    k2 = k2 + 1;
                }
                s_inf_r0_eq = cand;
            }
        }
    }

    // Analytical peak infected count when S0 > (gamma * N / beta)
    let s_star = (g * N) / b;
    let I_peak_exact = if s0 > s_star and i0 > 0.0 {
        s0 + i0 - s_star + s_star * num_ln(s_star / s0)
    } else {
        i0
    };

    // 2. 4th-order Runge-Kutta trajectory
    let n_steps = num_round(_clamp(num_ceil(T * 5.0), 200.0, 1500.0));
    let dt = T / (n_steps * 1.0);
    let S = s0;
    let I = i0;
    let R = r0_i;
    let trajectory = [map{ t: 0.0, S: S, I: I, R: R }];
    let inv_N_beta = b / N;

    let step = 1;
    while step <= n_steps {
        let k1_s = (0.0 - inv_N_beta) * S * I;
        let k1_i = inv_N_beta * S * I - g * I;
        let k1_r = g * I;

        let s2 = S + 0.5 * dt * k1_s;
        let i2 = I + 0.5 * dt * k1_i;
        let k2_s = (0.0 - inv_N_beta) * s2 * i2;
        let k2_i = inv_N_beta * s2 * i2 - g * i2;
        let k2_r = g * i2;

        let s3 = S + 0.5 * dt * k2_s;
        let i3 = I + 0.5 * dt * k2_i;
        let k3_s = (0.0 - inv_N_beta) * s3 * i3;
        let k3_i = inv_N_beta * s3 * i3 - g * i3;
        let k3_r = g * i3;

        let s4 = S + dt * k3_s;
        let i4 = I + dt * k3_i;
        let k4_s = (0.0 - inv_N_beta) * s4 * i4;
        let k4_i = inv_N_beta * s4 * i4 - g * i4;
        let k4_r = g * i4;

        S = S + (dt / 6.0) * (k1_s + 2.0 * k2_s + 2.0 * k3_s + k4_s);
        I = I + (dt / 6.0) * (k1_i + 2.0 * k2_i + 2.0 * k3_i + k4_i);
        R = R + (dt / 6.0) * (k1_r + 2.0 * k2_r + 2.0 * k3_r + k4_r);
        if step % 10 == 0 or step == n_steps {
            array_push(trajectory, map{ t: step * dt, S: S, I: I, R: R });
        }
        step = step + 1;
    }

    return map{
        N: N,
        R0: R0_eff,
        R0_basic: R0_basic,
        herd_immunity_threshold: hit,
        S_inf: S_inf_ode,
        S_inf_fraction: S_inf_ode / N,
        final_size_fraction: 1.0 - (S_inf_ode / N),
        s_inf_lambert_r0_eq: s_inf_r0_eq,
        I_peak_exact: I_peak_exact,
        S_final_rk4: S,
        I_final_rk4: I,
        R_final_rk4: R,
        trajectory: trajectory
    };
}

// Michaelis-Menten Enzyme Kinetics v = (Vmax * S) / (Km + S):
// Lineweaver-Burk double-reciprocal seed + damped Gauss-Newton nonlinear least squares
fn michaelis_menten_fit(substrate_S, velocity_V) {
    if type(substrate_S) != "array" or type(velocity_V) != "array" or len(substrate_S) < 2 or len(substrate_S) != len(velocity_V) {
        throw "michaelis_menten_fit: require equal-length arrays with >= 2 positive data points";
    }
    let n = len(substrate_S);
    let S = [];
    let V = [];
    let sum_x = 0.0;
    let sum_y = 0.0;
    let sum_xx = 0.0;
    let sum_xy = 0.0;
    let max_v = 0.0;
    let i = 0;
    while i < n {
        let si = _f64(substrate_S[i], "michaelis_menten_fit");
        let vi = _f64(velocity_V[i], "michaelis_menten_fit");
        if si <= 0.0 or vi <= 0.0 {
            throw "michaelis_menten_fit: substrate S and velocity V must be strictly positive";
        }
        array_push(S, si);
        array_push(V, vi);
        if vi > max_v { max_v = vi; }
        let xi = 1.0 / si;
        let yi = 1.0 / vi;
        sum_x = sum_x + xi;
        sum_y = sum_y + yi;
        sum_xx = sum_xx + xi * xi;
        sum_xy = sum_xy + xi * yi;
        i = i + 1;
    }

    // 1. Lineweaver-Burk OLS: 1/V = intercept + slope * (1/S), Vmax = 1/intercept, Km = slope * Vmax
    let denom_lb = n * sum_xx - sum_x * sum_x;
    let slope_lb = (n * sum_xy - sum_x * sum_y) / denom_lb;
    let inter_lb = (sum_y - slope_lb * sum_x) / (n * 1.0);
    let lb_vmax = if inter_lb > 1e-12 { 1.0 / inter_lb } else { 1.5 * max_v };
    let lb_km = if slope_lb * lb_vmax > 1e-12 { slope_lb * lb_vmax } else { S[0] };

    // 2. Damped Gauss-Newton (Levenberg-Marquardt) directly on nonlinear RSS
    let vmax = lb_vmax;
    let km = lb_km;
    let lam = 1e-6;
    let rss = 0.0;
    i = 0;
    while i < n {
        let r = V[i] - (vmax * S[i]) / (km + S[i]);
        rss = rss + r * r;
        i = i + 1;
    }

    let it = 0;
    let conv = false;
    while it < 200 and not conv {
        it = it + 1;
        let j11 = 0.0;
        let j12 = 0.0;
        let j22 = 0.0;
        let g1 = 0.0;
        let g2 = 0.0;
        i = 0;
        while i < n {
            let si = S[i];
            let den = km + si;
            let f = (vmax * si) / den;
            let r = V[i] - f;
            let dv = si / den;
            let dk = (0.0 - vmax * si) / (den * den);
            j11 = j11 + dv * dv;
            j12 = j12 + dv * dk;
            j22 = j22 + dk * dk;
            g1 = g1 + dv * r;
            g2 = g2 + dk * r;
            i = i + 1;
        }
        let a11 = j11 + lam * (1.0 + j11);
        let a22 = j22 + lam * (1.0 + j22);
        let det_h = a11 * a22 - j12 * j12;
        if num_abs(det_h) <= 1e-30 {
            conv = true;
        } else {
            let d_vmax = (a22 * g1 - j12 * g2) / det_h;
            let d_km = (a11 * g2 - j12 * g1) / det_h;
            let cand_vmax = vmax + d_vmax;
            let cand_km = km + d_km;
            if cand_vmax > 0.0 and cand_km > 0.0 {
                let cand_rss = 0.0;
                i = 0;
                while i < n {
                    let r2 = V[i] - (cand_vmax * S[i]) / (cand_km + S[i]);
                    cand_rss = cand_rss + r2 * r2;
                    i = i + 1;
                }
                if cand_rss <= rss + 1e-18 {
                    let step_rel = (num_abs(d_vmax) + num_abs(d_km)) / (1.0 + vmax + km);
                    vmax = cand_vmax;
                    km = cand_km;
                    rss = cand_rss;
                    lam = _max2(1e-12, lam * 0.25);
                    if step_rel <= 1e-13 { conv = true; }
                } else {
                    lam = lam * 8.0;
                }
            } else {
                lam = lam * 8.0;
            }
        }
    }

    let mean_v = 0.0;
    i = 0;
    while i < n { mean_v = mean_v + V[i]; i = i + 1; }
    mean_v = mean_v / (n * 1.0);
    let tss = 0.0;
    i = 0;
    while i < n {
        let dv = V[i] - mean_v;
        tss = tss + dv * dv;
        i = i + 1;
    }
    let r2 = if tss > 0.0 { 1.0 - rss / tss } else { 1.0 };

    return map{
        Vmax: vmax,
        Km: km,
        lineweaver_burk_Vmax: lb_vmax,
        lineweaver_burk_Km: lb_km,
        rss: rss,
        r_squared: r2,
        iterations: it,
        converged: conv
    };
}

fn hardy_weinberg(p_allele, observed_counts = nil) {
    let p = _f64(p_allele, "hardy_weinberg");
    if p < 0.0 or p > 1.0 {
        throw "hardy_weinberg: allele frequency p must satisfy 0 <= p <= 1";
    }
    let q = 1.0 - p;
    let f_AA = p * p;
    let f_Aa = 2.0 * p * q;
    let f_aa = q * q;

    let chi2 = nil;
    if observed_counts != nil {
        if type(observed_counts) != "array" or len(observed_counts) != 3 {
            throw "hardy_weinberg: observed_counts must be [n_AA, n_Aa, n_aa]";
        }
        let n0 = _f64(observed_counts[0], "hardy_weinberg");
        let n1 = _f64(observed_counts[1], "hardy_weinberg");
        let n2 = _f64(observed_counts[2], "hardy_weinberg");
        let tot = n0 + n1 + n2;
        if tot > 0.0 and p > 0.0 and q > 0.0 {
            let e0 = tot * f_AA;
            let e1 = tot * f_Aa;
            let e2 = tot * f_aa;
            chi2 = ((n0 - e0) * (n0 - e0)) / e0 + ((n1 - e1) * (n1 - e1)) / e1 + ((n2 - e2) * (n2 - e2)) / e2;
        }
    }

    return map{
        p: p,
        q: q,
        AA: f_AA,
        Aa: f_Aa,
        aa: f_aa,
        heterozygosity: f_Aa,
        normalization_sum: f_AA + f_Aa + f_aa,
        chi2_statistic: chi2
    };
}

// Whole-Life Actuarial Commutation Functions (lx, dx, Dx, Nx, Cx, Mx, a_due_x, Ax)
// Verifies the fundamental whole-life actuarial identity Ax + d * a_due_x == 1 to 1e-14!
fn actuarial_life_commutations(qx_table, interest_rate) {
    if type(qx_table) != "array" or len(qx_table) == 0 {
        throw "actuarial_life_commutations: qx_table must be a non-empty mortality probability array";
    }
    if len(qx_table) > 200 {
        throw "actuarial_life_commutations: table length exceeds 200 ages";
    }
    let rate_i = _f64(interest_rate, "actuarial_life_commutations");
    if rate_i <= -1.0 {
        throw "actuarial_life_commutations: interest_rate must be > -1";
    }

    let q_ext = [];
    let idx = 0;
    while idx < len(qx_table) {
        let qv = _f64(qx_table[idx], "actuarial_life_commutations");
        if qv < 0.0 or qv > 1.0 {
            throw "actuarial_life_commutations: mortality q_x must be in [0, 1]";
        }
        array_push(q_ext, qv);
        idx = idx + 1;
    }
    let n_user = len(q_ext);
    // Ensure whole-life closure at limiting age omega if last q_x < 1.0
    if q_ext[n_user - 1] < 1.0 - 1e-15 {
        array_push(q_ext, 1.0);
    }
    let n_tot = len(q_ext);

    let v = 1.0 / (1.0 + rate_i);
    let d_disc = rate_i / (1.0 + rate_i); // d = 1 - v

    let lx_full = [];
    let dx_full = [];
    let Dx_full = [];
    let Cx_full = [];

    let cur_l = 100000.0;
    let v_pow = 1.0;
    let x = 0;
    while x < n_tot {
        let d_deaths = cur_l * q_ext[x];
        array_push(lx_full, cur_l);
        array_push(dx_full, d_deaths);
        array_push(Dx_full, v_pow * cur_l);
        array_push(Cx_full, (v_pow * v) * d_deaths);
        cur_l = _max2(0.0, cur_l - d_deaths);
        v_pow = v_pow * v;
        x = x + 1;
    }

    let Nx_full = [];
    let Mx_full = [];
    x = 0;
    while x < n_tot {
        array_push(Nx_full, 0.0);
        array_push(Mx_full, 0.0);
        x = x + 1;
    }
    let run_N = 0.0;
    let run_M = 0.0;
    x = n_tot - 1;
    while x >= 0 {
        run_N = run_N + Dx_full[x];
        run_M = run_M + Cx_full[x];
        Nx_full[x] = run_N;
        Mx_full[x] = run_M;
        x = x - 1;
    }

    let lx = [];
    let dx = [];
    let Dx = [];
    let Nx = [];
    let Cx = [];
    let Mx = [];
    let a_due = [];
    let Ax = [];
    let max_id_err = 0.0;

    x = 0;
    while x < n_user {
        array_push(lx, lx_full[x]);
        array_push(dx, dx_full[x]);
        array_push(Dx, Dx_full[x]);
        array_push(Nx, Nx_full[x]);
        array_push(Cx, Cx_full[x]);
        array_push(Mx, Mx_full[x]);
        if Dx_full[x] > 0.0 {
            let ax_val = Nx_full[x] / Dx_full[x];
            let Ax_val = Mx_full[x] / Dx_full[x];
            array_push(a_due, ax_val);
            array_push(Ax, Ax_val);
            let id_err = num_abs((Ax_val + d_disc * ax_val) - 1.0);
            if id_err > max_id_err { max_id_err = id_err; }
        } else {
            array_push(a_due, 0.0);
            array_push(Ax, 1.0);
        }
        x = x + 1;
    }

    return map{
        discount_v: v,
        discount_rate_d: d_disc,
        lx: lx,
        dx: dx,
        Dx: Dx,
        Nx: Nx,
        Cx: Cx,
        Mx: Mx,
        annuity_due_ax: a_due,
        whole_life_Ax: Ax,
        max_identity_error: max_id_err,
        identity_verified: (max_id_err <= 1e-14)
    };
}

// Leontief Input-Output Economic Equilibrium x = (I - A)^(-1) d with Hawkins-Simon check
fn leontief_input_output(tech_matrix_A, final_demand_d) {
    let A = LA.mat_copy(tech_matrix_A);
    let n = len(A);
    if len(A[0]) != n or n > MAX_DIM {
        throw "leontief_input_output: tech_matrix_A must be square <= MAX_DIM";
    }
    if type(final_demand_d) != "array" or len(final_demand_d) != n {
        throw "leontief_input_output: final_demand_d length must match A";
    }
    let d = [];
    let i = 0;
    while i < n {
        let di = _f64(final_demand_d[i], "leontief_input_output");
        if di < 0.0 { throw "leontief_input_output: final demand entries must be >= 0"; }
        array_push(d, di);
        let j = 0;
        while j < n {
            if A[i][j] < 0.0 {
                throw "leontief_input_output: technology coefficients A[i][j] must be >= 0";
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let L = LA.mat_sub(LA.mat_eye(n), A);

    // Hawkins-Simon Theorem (1949): all n leading principal minors of (I - A) are strictly > 0
    let minors = [];
    let hs_ok = true;
    let k = 1;
    while k <= n {
        let sub = LA.mat_zeros(k, k);
        let r = 0;
        while r < k {
            let c = 0;
            while c < k {
                sub[r][c] = L[r][c];
                c = c + 1;
            }
            r = r + 1;
        }
        let mk = LA.det(sub);
        array_push(minors, mk);
        if mk <= 1e-12 { hs_ok = false; }
        k = k + 1;
    }

    if not hs_ok {
        return map{
            hawkins_simon_productive: false,
            leading_principal_minors: minors,
            total_output_x: nil,
            leontief_inverse: nil
        };
    }

    let L_inv = LA.inv(L);
    let nonneg_inv = true;
    i = 0;
    while i < n {
        let j = 0;
        while j < n {
            if L_inv[i][j] < -1e-11 { nonneg_inv = false; }
            j = j + 1;
        }
        i = i + 1;
    }
    let x = LA.mat_vec_mul(L_inv, d);
    let inter_demand = LA.mat_vec_mul(A, x);

    return map{
        hawkins_simon_productive: (hs_ok and nonneg_inv),
        leading_principal_minors: minors,
        leontief_inverse: L_inv,
        total_output_x: x,
        intermediate_demand: inter_demand
    };
}

// Social Choice Election Analyzer: Plurality, Borda Count & Pairwise Condorcet Winner Check
fn social_choice_election(ballots, candidates) {
    if type(candidates) != "array" or len(candidates) < 2 {
        throw "social_choice_election: require at least 2 candidates";
    }
    if type(ballots) != "array" or len(ballots) == 0 {
        throw "social_choice_election: ballots must be non-empty";
    }
    let m = len(candidates);
    let cands = [];
    let cand_idx = map{};
    let i = 0;
    while i < m {
        let cname = str(candidates[i]);
        array_push(cands, cname);
        cand_idx[cname] = i;
        i = i + 1;
    }

    let plurality = [];
    let borda = [];
    i = 0;
    while i < m {
        array_push(plurality, 0.0);
        array_push(borda, 0.0);
        i = i + 1;
    }
    let pairwise = LA.mat_zeros(m, m);
    let total_votes = 0.0;

    let bi = 0;
    while bi < len(ballots) {
        let b_item = ballots[bi];
        let ranking = nil;
        let w = 1.0;
        if type(b_item) == "array" {
            ranking = b_item;
        } else if type(b_item) == "map" and map_has(b_item, "ranking") {
            ranking = b_item.ranking;
            if map_has(b_item, "count") { w = _f64(b_item.count, "social_choice"); }
            else if map_has(b_item, "weight") { w = _f64(b_item.weight, "social_choice"); }
        } else {
            throw "social_choice_election: each ballot must be a ranking array or { ranking, count }";
        }
        if len(ranking) != m {
            throw "social_choice_election: each ranking must list all " + str(m) + " candidates";
        }
        total_votes = total_votes + w;

        let rank_pos = [];
        i = 0;
        while i < m { array_push(rank_pos, -1); i = i + 1; }

        let r = 0;
        while r < m {
            let cname = str(ranking[r]);
            if not map_has(cand_idx, cname) {
                throw "social_choice_election: unknown candidate '" + cname + "'";
            }
            let c_id = cand_idx[cname];
            if rank_pos[c_id] != -1 {
                throw "social_choice_election: duplicate candidate in ballot";
            }
            rank_pos[c_id] = r;
            if r == 0 {
                plurality[c_id] = plurality[c_id] + w;
            }
            borda[c_id] = borda[c_id] + w * ((m - 1 - r) * 1.0);
            r = r + 1;
        }

        let a_i = 0;
        while a_i < m {
            let b_i = a_i + 1;
            while b_i < m {
                if rank_pos[a_i] < rank_pos[b_i] {
                    pairwise[a_i][b_i] = pairwise[a_i][b_i] + w;
                } else {
                    pairwise[b_i][a_i] = pairwise[b_i][a_i] + w;
                }
                b_i = b_i + 1;
            }
            a_i = a_i + 1;
        }
        bi = bi + 1;
    }

    let plur_map = map{};
    let borda_map = map{};
    let best_plur = -1.0;
    let plur_win = nil;
    let best_borda = -1.0;
    let borda_win = nil;
    let condorcet_win = nil;
    let copeland = map{};

    i = 0;
    while i < m {
        let nm = cands[i];
        plur_map[nm] = plurality[i];
        borda_map[nm] = borda[i];
        if plurality[i] > best_plur {
            best_plur = plurality[i];
            plur_win = nm;
        }
        if borda[i] > best_borda {
            best_borda = borda[i];
            borda_win = nm;
        }

        let beats_all = true;
        let cop_score = 0.0;
        let j = 0;
        while j < m {
            if i != j {
                if pairwise[i][j] > pairwise[j][i] {
                    cop_score = cop_score + 1.0;
                } else if pairwise[i][j] == pairwise[j][i] {
                    cop_score = cop_score + 0.5;
                    beats_all = false;
                } else {
                    beats_all = false;
                }
            }
            j = j + 1;
        }
        copeland[nm] = cop_score;
        if beats_all {
            condorcet_win = nm;
        }
        i = i + 1;
    }

    return map{
        total_votes: total_votes,
        plurality_scores: plur_map,
        plurality_winner: plur_win,
        borda_scores: borda_map,
        borda_winner: borda_win,
        has_condorcet_winner: (condorcet_win != nil),
        condorcet_winner: condorcet_win,
        copeland_scores: copeland,
        pairwise_matrix: pairwise
    };
}

fn _divisor_apportion_bigint(votes_b, seats_total, odd_divisors) {
    let p = len(votes_b);
    let seats = [];
    let i = 0;
    while i < p { array_push(seats, 0); i = i + 1; }

    let s = 0;
    while s < seats_total {
        let best_idx = 0;
        let j = 1;
        while j < p {
            let div_best = if odd_divisors { bigint(2 * seats[best_idx] + 1) } else { bigint(seats[best_idx] + 1) };
            let div_j = if odd_divisors { bigint(2 * seats[j] + 1) } else { bigint(seats[j] + 1) };
            // Exact cross-multiplication V_j / div_j > V_best / div_best <=> V_j * div_best > V_best * div_j
            let lhs = votes_b[j] * div_best;
            let rhs = votes_b[best_idx] * div_j;
            if lhs > rhs or (lhs == rhs and votes_b[j] > votes_b[best_idx]) {
                best_idx = j;
            }
            j = j + 1;
        }
        seats[best_idx] = seats[best_idx] + 1;
        s = s + 1;
    }
    return seats;
}

// Exact BigInt D'Hondt (divisors 1, 2, 3, ...) & Sainte-Lague (divisors 1, 3, 5, ...) Seat Allocation
fn dhondt_allocate_seats(party_votes, total_seats) {
    let S = num_round(_f64(total_seats, "dhondt_allocate_seats"));
    if S < 0 or S > MAX_STEPS {
        throw "dhondt_allocate_seats: total_seats must be in [0, " + str(MAX_STEPS) + "]";
    }

    let is_map = (type(party_votes) == "map");
    let names = [];
    let votes_b = [];
    let sum_v = _B0;

    if is_map {
        names = _sort_strings_unique(map_keys(party_votes));
        if len(names) == 0 {
            throw "dhondt_allocate_seats: party_votes map is empty";
        }
        let i = 0;
        while i < len(names) {
            let vb = _to_bigint(party_votes[names[i]], "dhondt_allocate_seats");
            if vb < _B0 { throw "dhondt_allocate_seats: votes must be >= 0"; }
            array_push(votes_b, vb);
            sum_v = sum_v + vb;
            i = i + 1;
        }
    } else if type(party_votes) == "array" and len(party_votes) > 0 {
        let i = 0;
        while i < len(party_votes) {
            let vb = _to_bigint(party_votes[i], "dhondt_allocate_seats");
            if vb < _B0 { throw "dhondt_allocate_seats: votes must be >= 0"; }
            array_push(names, "party_" + str(i));
            array_push(votes_b, vb);
            sum_v = sum_v + vb;
            i = i + 1;
        }
    } else {
        throw "dhondt_allocate_seats: party_votes must be a non-empty map or array";
    }

    if sum_v == _B0 and S > 0 {
        throw "dhondt_allocate_seats: cannot allocate positive seats with zero total votes";
    }

    let dh_arr = _divisor_apportion_bigint(votes_b, S, false);
    let sl_arr = _divisor_apportion_bigint(votes_b, S, true);

    if is_map {
        let dh_map = map{};
        let sl_map = map{};
        let i = 0;
        while i < len(names) {
            dh_map[names[i]] = dh_arr[i];
            sl_map[names[i]] = sl_arr[i];
            i = i + 1;
        }
        return map{
            seats: dh_map,
            dhondt_seats: dh_map,
            sainte_lague_seats: sl_map,
            total_seats: S
        };
    }

    return map{
        seats: dh_arr,
        dhondt_seats: dh_arr,
        sainte_lague_seats: sl_arr,
        total_seats: S
    };
}

