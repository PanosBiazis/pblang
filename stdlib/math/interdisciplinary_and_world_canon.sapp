// stdlib/math/interdisciplinary_and_world_canon.sapp
// PBLang v2.6.0 — Complete MSC2020 Interdisciplinary Mathematical Sciences &
// Scientifically Proven World Mathematical Canon Engine.
//
// Scope & Scientific Rigor:
//   1. Complete MSC2020 (Mathematics Subject Classification 00–97, all 63 active 2-digit
//      divisions) registry mapped to executable PBLang modules & functions, plus strict
//      epistemic demarcation (`rigorously_proved_theorem` vs `open_unproven_conjecture` vs
//      `undecidable_by_godel_turing_matiyasevich` vs `rejected_non_scientific`).
//   2. Pure & Functional Analysis Pillars (MSC 11G/14H52, 42, 44, 46, 47, 68Q):
//      - Elliptic Curves over F_p (Hasse theorem point counting, double-and-add) & exact Q
//      - Weighted L^2 Gram-Schmidt function orthonormalization (composite Gauss-Legendre)
//      - Banach Contraction Mapping Fixed-Point solver with a priori & a posteriori bounds
//      - Orthonormal Haar & Daubechies-4 (D4) Discrete Wavelet Transforms (DWT / IDWT)
//      - Z-Transform Schur-Cohn-Jury BIBO stability & causal IIR filtering
//      - 2D Medical CT Radon Transform Sinogram & Kak-Slaney Ram-Lak Filtered Back-Projection
//      - Theory of Computation: DFA simulator, Rabin-Scott NFA->DFA powerset (+ epsilon), CYK O(n^3)
//   3. Interdisciplinary Mathematical Sciences (MSC 70–86, 91, 92, 93):
//      - Control & Estimation: Kalman Controllability/Observability rank, Routh-Hurwitz (with
//        epsilon-pivot & auxiliary derivative handling), Joseph-form Discrete Kalman Filter,
//        Discrete Algebraic Riccati Equation (DARE) Optimal LQR
//      - Mathematical Physics: Halley Kepler orbit solver, 4th-order symmetric FD 1D Schrodinger
//        eigenstates, Hermitian Von Neumann quantum entropy, Canonical Partition Function
//        statistical mechanics, 3D Cauchy/Deviatoric/Principal/Von Mises continuum stress
//      - Math Biology, Actuarial, Economics & Social Choice: Exact Lambert-W/Newton + RK4
//        Kermack-McKendrick SIR epidemic model, Lineweaver-Burk + Gauss-Newton Michaelis-Menten,
//        Hardy-Weinberg equilibrium, Whole-Life Actuarial Commutations (verifying A_x + d*a_due_x = 1),
//        Hawkins-Simon Leontief Input-Output model, Plurality/Borda/Condorcet Social Choice &
//        exact BigInt D'Hondt / Sainte-Lague parliamentary seat allocation
//   4. Scientifically Proven World Mathematical Traditions Engine:
//      - Hellenic: Archimedes cancellation-free 6*2^k-gon pi bounds, Constantin Caratheodory (1907)
//        constructive convex-hull nullspace reduction, exact BigRat Heron area, Diophantus S^1 parametrization
//      - Indian: Brahmagupta-Bhaskara II cyclic Chakravala Pell solver in BigInt, Ramanujan (1914)
//        modular 1/pi series (exact rational + arbitrary-precision BigInt sqrt(2)), Madhava end-corrected pi
//      - Chinese & Japanese (Wasan): Seki-Aitken Delta^2 acceleration (0/0 plateau guarded),
//        exact Q Sylvester resultant determinant
//      - Islamic Golden Age: Al-Tusi spherical trigonometry + Girard spherical excess,
//        Al-Kashi radical sin(3 deg) + contraction cubic iteration for sin(1 deg)
//      - Egyptian & Mesopotamian: Fibonacci-Sylvester greedy Egyptian unit fractions verified in BigRat
//      - Russian/Soviet, Polish & Hungarian: SVD Tikhonov regularization with Golub-Heath-Wahba GCV,
//        Erdos-Gallai graphical degree sequence theorem & Havel-Hakimi simple graph realization.
//
// Zero network I/O, zero host subprocesses, strict bounded resource guards throughout.

let EX = import("stdlib:math/exact_algebra.sapp");
let LA = import("stdlib:math/linalg_geometry.sapp");

let CANON_VERSION = "2.6.0";
let PI = 3.14159265358979323846;
let TWO_PI = 6.28318530717958647692;
let DEG_TO_RAD = 0.01745329251994329577;
let RAD_TO_DEG = 57.2957795130823208768;

// ── Bounded Resource Safety Constants ─────────────────────────────────────────

let MAX_STEPS = 25000;
let MAX_DIM = 256;
let MAX_SIGNAL_LEN = 16384;
let MAX_RADON_GRID = 128;
let MAX_DFA_STATES = 1024;
let MAX_CYK_TOKENS = 96;
let MAX_EC_PRIME_SCAN = 200000;

let _B0 = bigint(0);
let _B1 = bigint(1);
let _B2 = bigint(2);
let _B3 = bigint(3);
let _B4 = bigint(4);
let _B27 = bigint(27);

// ══════════════════════════════════════════════════════════════════════════════
// 0. Internal Numeric, BigInt & Rational Coercion Helpers
// ══════════════════════════════════════════════════════════════════════════════

fn _f64(x, ctx = "canon") {
    let t = type(x);
    if t == "number" {
        if x != x or (x - x) != 0.0 {
            throw ctx + ": expected finite real number";
        }
        return x + 0.0;
    }
    if t == "bigint" {
        return parse_number(str(x)) + 0.0;
    }
    if t == "map" and map_has(x, "num") and map_has(x, "den") {
        return EX.rat_to_float(EX.rat(x.num, x.den));
    }
    if t == "string" {
        return EX.rat_to_float(EX.rat_from_str(x));
    }
    throw ctx + ": expected numeric value, got " + t;
}

fn _to_bigint(x, ctx = "canon") {
    let t = type(x);
    if t == "bigint" { return x; }
    if t == "number" {
        if x != x or (x - x) != 0.0 or num_floor(x) != x {
            throw ctx + ": expected exact integer, got " + str(x);
        }
        return bigint(x);
    }
    if t == "string" {
        let r = EX.rat_from_str(x);
        if r.den != _B1 {
            throw ctx + ": expected integer string, got rational " + x;
        }
        return r.num;
    }
    if t == "map" and map_has(x, "num") and map_has(x, "den") {
        if bigint(x.den) != _B1 {
            throw ctx + ": expected integer, got non-integral rational";
        }
        return bigint(x.num);
    }
    throw ctx + ": expected integer, got " + t;
}

fn _to_ex_rat(x) {
    let t = type(x);
    if t == "map" and map_has(x, "kind") and x.kind == "rat" {
        return x;
    }
    if t == "map" and map_has(x, "num") and map_has(x, "den") {
        return EX.rat(x.num, x.den);
    }
    if t == "bigint" {
        return EX.rat(x, _B1);
    }
    if t == "number" {
        if x != x or (x - x) != 0.0 {
            throw "exact rational conversion: non-finite float";
        }
        if num_floor(x) == x and num_abs(x) < 9007199254740992.0 {
            return EX.rat(bigint(x), _B1);
        }
        return EX.rat_from_str(str(x));
    }
    if t == "string" {
        return EX.rat_from_str(x);
    }
    throw "exact rational conversion: unsupported type " + t;
}

fn _to_la_rat(x) {
    let r = _to_ex_rat(x);
    return LA.rat(r.num, r.den);
}

fn _b_abs(x) {
    if x < _B0 { return _B0 - x; }
    return x;
}

fn _b_gcd(a, b) {
    let x = _b_abs(a);
    let y = _b_abs(b);
    while y != _B0 {
        let r = x % y;
        x = y;
        y = r;
    }
    return x;
}

fn _b_mod(a, m) {
    let r = a % m;
    if r < _B0 { return r + m; }
    return r;
}

fn _b_isqrt(n) {
    if n < _B0 { throw "_b_isqrt: negative integer"; }
    if n == _B0 { return _B0; }
    if n < _B4 { return _B1; }
    let digits = len(str(n));
    let half_d = num_floor((digits + 1) / 2);
    let x = bigint(10) ** half_d;
    let y = (x + n / x) / _B2;
    while y < x {
        x = y;
        y = (x + n / x) / _B2;
    }
    return x;
}

fn _clamp(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _max2(a, b) {
    if a >= b { return a; }
    return b;
}

fn _min2(a, b) {
    if a <= b { return a; }
    return b;
}

fn _vec_norm2(v) {
    let s = 0.0;
    let i = 0;
    while i < len(v) {
        s = s + v[i] * v[i];
        i = i + 1;
    }
    return num_sqrt(s);
}

// ══════════════════════════════════════════════════════════════════════════════
// 1. Complete MSC2020 (00–97) Registry & Epistemic Demarcation
// ══════════════════════════════════════════════════════════════════════════════

fn _msc_div(code, title_en, title_el, mod_path, fns, note = "Proved theorems & verified algorithms") {
    return map{
        code: code,
        title_en: title_en,
        title_el: title_el,
        module: mod_path,
        functions: fns,
        epistemic_note: note
    };
}

