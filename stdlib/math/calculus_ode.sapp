// stdlib/math/calculus_ode.sapp
// Pure PBLang (v2.6.0) Symbolic & Numerical Calculus, Multivariable Analysis,
// Series, Integral/Spectral Transforms, and Differential Equations (ODE / PDE).
//
// Self-contained mathematical expression parser, canonical algebraic simplifier,
// ASCII / Unicode / LaTeX formatters, exact symbolic calculus & ODE/Laplace engines,
// adaptive Gauss-Kronrod & Tanh-Sinh quadrature, Dormand-Prince RK45 / Symplectic Verlet /
// Stiff Backward-Euler integrators, 1D/2D PDE solvers, and Cooley-Tukey Radix-2 FFT.

let MAX_DEPTH = 128;
let MAX_QUAD_DEPTH = 24;
let MAX_ODE_STEPS = 50000;
let MAX_PDE_GRID = 512;

let PI = 3.14159265358979323846;
let E_CONST = 2.71828182845904523536;
let LN10 = 2.30258509299404568402;
let EULER_GAMMA = 0.57721566490153286061;

// ============================================================================
// 0. Numeric & Rational Helpers
// ============================================================================

fn _is_finite(x) {
    if type(x) != "number" { return false; }
    if x != x { return false; }
    let s = str(x);
    if s == "inf" or s == "-inf" or s == "Infinity" or s == "-Infinity" or s == "NaN" {
        return false;
    }
    return num_abs(x) < 1e300;
}

fn _is_int_val(x) {
    if not _is_finite(x) { return false; }
    if num_abs(x) > 9007199254740991.0 { return false; }
    return num_abs(x - num_round(x)) < 1e-11;
}

fn _near_zero(x) {
    return _is_finite(x) and num_abs(x) < 1e-12;
}

fn _snap_num(x) {
    if not _is_finite(x) { return x; }
    let rx = num_round(x);
    if num_abs(x - rx) < 1e-11 {
        if rx == 0 { return 0; }
        return rx;
    }
    return x;
}

fn _gcd_int(a, b) {
    let x = num_round(num_abs(a));
    let y = num_round(num_abs(b));
    let guard = 0;
    while y > 0 and guard < 128 {
        let r = num_mod(x, y);
        x = y;
        y = r;
        guard = guard + 1;
    }
    if x == 0 { return 1; }
    return x;
}

fn _factorial(n) {
    let k = num_round(n);
    if k <= 1 { return 1; }
    let res = 1;
    let i = 2;
    while i <= k {
        res = res * i;
        i = i + 1;
    }
    return res;
}

fn _num_to_clean_str(v) {
    let s_val = _snap_num(v);
    if _is_int_val(s_val) {
        return str(num_round(s_val));
    }
    return str(s_val);
}

// ============================================================================
// 1. AST Constructors & Self-Contained Expression Tokenizer / Parser
// ============================================================================

fn _num(v) { return map{ kind: "num", val: _snap_num(v) }; }
fn _sym(name) { return map{ kind: "sym", name: name }; }
fn _neg(arg) { return map{ kind: "neg", arg: arg }; }
fn _bin(op, left, right) { return map{ kind: "bin", op: op, left: left, right: right }; }
fn _call(name, args) { return map{ kind: "call", name: name, args: args }; }

fn _is_num(n) { return type(n) == "map" and n.kind == "num"; }
fn _is_num_eq(n, val) { return _is_num(n) and num_abs(n.val - val) < 1e-12; }
fn _is_sym(n) { return type(n) == "map" and n.kind == "sym"; }

fn _is_digit_code(c) { return c >= 48 and c <= 57; }
fn _is_alpha_code(c) {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
}

let _KNOWN_FUNCS = map{
    "sin": true, "cos": true, "tan": true, "cot": true, "sec": true, "csc": true,
    "asin": true, "acos": true, "atan": true,
    "arcsin": true, "arccos": true, "arctan": true,
    "sinh": true, "cosh": true, "tanh": true,
    "exp": true, "ln": true, "log": true, "log10": true,
    "sqrt": true, "cbrt": true, "abs": true,
    "erf": true, "erfc": true, "erfi": true,
    "Ei": true, "li": true, "Si": true, "Ci": true,
    "FresnelS": true, "fresnels": true, "FresnelC": true, "fresnelc": true,
    "Li2": true, "li2": true, "dilog": true,
    "lambertw": true, "LambertW": true
};

fn _canon_func_name(name) {
    if name == "arcsin" { return "asin"; }
    if name == "arccos" { return "acos"; }
    if name == "arctan" { return "atan"; }
    if name == "dilog" or name == "li2" { return "Li2"; }
    if name == "LambertW" { return "lambertw"; }
    if name == "fresnels" { return "FresnelS"; }
    if name == "fresnelc" { return "FresnelC"; }
    return name;
}

fn _tokenize_expr(src) {
    let s = str_replace_all(src, "**", "^");
    let n = len(s);
    let raw = [];
    let i = 0;
    while i < n {
        let ch = str_slice(s, i, i + 1);
        let code = strcharcodeat(s, i);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            i = i + 1;
        } else if _is_digit_code(code) or (ch == "." and i + 1 < n and _is_digit_code(strcharcodeat(s, i + 1))) {
            let start = i;
            let seen_dot = false;
            while i < n {
                let c2 = strcharcodeat(s, i);
                let ch2 = str_slice(s, i, i + 1);
                if _is_digit_code(c2) {
                    i = i + 1;
                } else if ch2 == "." and not seen_dot {
                    seen_dot = true;
                    i = i + 1;
                } else {
                    break;
                }
            }
            if i < n {
                let ech = str_slice(s, i, i + 1);
                if ech == "e" or ech == "E" {
                    let j = i + 1;
                    if j < n {
                        let sch = str_slice(s, j, j + 1);
                        if sch == "+" or sch == "-" { j = j + 1; }
                    }
                    if j < n and _is_digit_code(strcharcodeat(s, j)) {
                        i = j + 1;
                        while i < n and _is_digit_code(strcharcodeat(s, i)) {
                            i = i + 1;
                        }
                    }
                }
            }
            let num_txt = str_slice(s, start, i);
            let parsed = parse_number(num_txt);
            array_push(raw, map{ kind: "num", val: parsed });
        } else if _is_alpha_code(code) {
            let start = i;
            i = i + 1;
            while i < n {
                let c2 = strcharcodeat(s, i);
                if _is_alpha_code(c2) or _is_digit_code(c2) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            let ident = str_slice(s, start, i);
            array_push(raw, map{ kind: "ident", val: ident });
        } else if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "^" or ch == "(" or ch == ")" or ch == "," or ch == "|" {
            array_push(raw, map{ kind: "punct", val: ch });
            i = i + 1;
        } else {
            throw "calculus_ode: unexpected character '" + ch + "' in expression '" + src + "'";
        }
    }

    // Insert implicit '*' for forms like 2x, 2(x+1), (x+1)(x-1), (x+1)y
    let tokens = [];
    let k = 0;
    while k < len(raw) {
        let cur = raw[k];
        array_push(tokens, cur);
        if k + 1 < len(raw) {
            let nxt = raw[k + 1];
            let left_can_mul = cur.kind == "num" or (cur.kind == "punct" and cur.val == ")") or (cur.kind == "ident" and not map_has(_KNOWN_FUNCS, cur.val));
            let right_can_mul = nxt.kind == "ident" or nxt.kind == "num" or (nxt.kind == "punct" and nxt.val == "(");
            if cur.kind == "ident" and map_has(_KNOWN_FUNCS, cur.val) and nxt.kind == "punct" and nxt.val == "(" {
                left_can_mul = false;
            }
            if left_can_mul and right_can_mul {
                // Do not insert '*' between two numbers (would not happen anyway)
                array_push(tokens, map{ kind: "punct", val: "*" });
            }
        }
        k = k + 1;
    }
    array_push(tokens, map{ kind: "eof", val: "" });
    return tokens;
}

fn _peek_tok(st) { return st.tokens[st.pos]; }
fn _next_tok(st) {
    let t = st.tokens[st.pos];
    st.pos = st.pos + 1;
    return t;
}

fn _parse_sum(st, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in parser"; }
    let left = _parse_mul(st, depth + 1);
    while true {
        let t = _peek_tok(st);
        if t.kind == "punct" and (t.val == "+" or t.val == "-") {
            let _ = _next_tok(st);
            let right = _parse_mul(st, depth + 1);
            left = _bin(t.val, left, right);
        } else {
            break;
        }
    }
    return left;
}

fn _parse_mul(st, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in parser"; }
    let left = _parse_unary(st, depth + 1);
    while true {
        let t = _peek_tok(st);
        if t.kind == "punct" and (t.val == "*" or t.val == "/") {
            let _ = _next_tok(st);
            let right = _parse_unary(st, depth + 1);
            left = _bin(t.val, left, right);
        } else {
            break;
        }
    }
    return left;
}

fn _parse_unary(st, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in parser"; }
    let t = _peek_tok(st);
    if t.kind == "punct" and t.val == "+" {
        let _ = _next_tok(st);
        return _parse_unary(st, depth + 1);
    }
    if t.kind == "punct" and t.val == "-" {
        let _ = _next_tok(st);
        let inner = _parse_unary(st, depth + 1);
        return _neg(inner);
    }
    return _parse_pow(st, depth + 1);
}

fn _parse_pow(st, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in parser"; }
    let base = _parse_primary(st, depth + 1);
    let t = _peek_tok(st);
    if t.kind == "punct" and t.val == "^" {
        let _ = _next_tok(st);
        let exponent = _parse_unary(st, depth + 1);
        return _bin("^", base, exponent);
    }
    return base;
}

fn _parse_primary(st, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in parser"; }
    let t = _peek_tok(st);
    if t.kind == "num" {
        let _ = _next_tok(st);
        return _num(t.val);
    }
    if t.kind == "ident" {
        let _ = _next_tok(st);
        let nxt = _peek_tok(st);
        if nxt.kind == "punct" and nxt.val == "(" {
            let _ = _next_tok(st);
            let args = [];
            if not (_peek_tok(st).kind == "punct" and _peek_tok(st).val == ")") {
                array_push(args, _parse_sum(st, depth + 1));
                while _peek_tok(st).kind == "punct" and _peek_tok(st).val == "," {
                    let _ = _next_tok(st);
                    array_push(args, _parse_sum(st, depth + 1));
                }
            }
            let close = _next_tok(st);
            if close.kind != "punct" or close.val != ")" {
                throw "calculus_ode: expected ')' after function call " + t.val;
            }
            return _call(_canon_func_name(t.val), args);
        }
        return _sym(t.val);
    }
    if t.kind == "punct" and t.val == "(" {
        let _ = _next_tok(st);
        let inner = _parse_sum(st, depth + 1);
        let close = _next_tok(st);
        if close.kind != "punct" or close.val != ")" {
            throw "calculus_ode: expected ')'";
        }
        return inner;
    }
    if t.kind == "punct" and t.val == "|" {
        let _ = _next_tok(st);
        let inner = _parse_sum(st, depth + 1);
        let close = _next_tok(st);
        if close.kind != "punct" or close.val != "|" {
            throw "calculus_ode: expected closing '|'";
        }
        return _call("abs", [inner]);
    }
    throw "calculus_ode: unexpected token '" + str(t.val) + "'";
}

fn parse_expr(expr) {
    if type(expr) == "map" and map_has(expr, "kind") {
        return expr;
    }
    if type(expr) == "number" {
        return _num(expr);
    }
    if type(expr) != "string" {
        throw "calculus_ode: parse_expr expects string or AST";
    }
    let toks = _tokenize_expr(expr);
    let st = map{ tokens: toks, pos: 0 };
    let ast = _parse_sum(st, 0);
    let rem = _peek_tok(st);
    if rem.kind != "eof" {
        throw "calculus_ode: trailing token '" + str(rem.val) + "' in '" + expr + "'";
    }
    return ast;
}

// ============================================================================
// 2. AST Evaluator & Dependency / Substitution Utilities
// ============================================================================

fn _nan_val() { return num_ln(-1.0); }

fn _safe_pow(a, b) {
    if not _is_finite(a) or not _is_finite(b) { return _nan_val(); }
    if num_abs(b) < 1e-15 { return 1.0; }
    if num_abs(a) < 1e-300 {
        if b > 0 { return 0.0; }
        return _nan_val();
    }
    if a < 0 {
        if _is_int_val(b) {
            let bi = num_round(b);
            let mag = num_pow(num_abs(a), bi);
            if num_mod(num_abs(bi), 2) == 1 { return 0.0 - mag; }
            return mag;
        }
        return _nan_val();
    }
    return num_pow(a, b);
}

fn _c_make(re, im) { return map{ re: re * 1.0, im: im * 1.0 }; }
fn _c_add(a, b) { return map{ re: a.re + b.re, im: a.im + b.im }; }
fn _c_sub(a, b) { return map{ re: a.re - b.re, im: a.im - b.im }; }
fn _c_mul(a, b) { return map{ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re }; }
fn _c_div(a, b) {
    let ar = num_abs(b.re);
    let ai = num_abs(b.im);
    if ar >= ai {
        if ar == 0.0 { return _c_make(_nan_val(), _nan_val()); }
        let r = b.im / b.re;
        let den = b.re + b.im * r;
        return map{ re: (a.re + a.im * r) / den, im: (a.im - a.re * r) / den };
    }
    let r = b.re / b.im;
    let den = b.im + b.re * r;
    return map{ re: (a.re * r + a.im) / den, im: (a.im * r - a.re) / den };
}

// Laplace continued fraction for erfc(z), z >= 2.2:
// erfc(z) = (exp(-z^2) / sqrt(pi)) * (1 / (z + (1/2)/(z + 1/(z + (3/2)/(z + ...)))))
fn _erfc_pos_cf(z) {
    if z > 27.0 { return 0.0; }
    let tiny = 1e-30;
    let f = tiny;
    let c = f;
    let d = 0.0;
    let j = 1;
    while j <= 160 {
        let a_j = if j == 1 { 1.0 } else { 0.5 * (j - 1) };
        let b_j = z;
        d = b_j + a_j * d;
        if num_abs(d) < tiny { d = tiny; }
        c = b_j + a_j / c;
        if num_abs(c) < tiny { c = tiny; }
        d = 1.0 / d;
        let delta = c * d;
        f = f * delta;
        if num_abs(delta - 1.0) < 1e-16 { break; }
        j = j + 1;
    }
    return (num_exp(0.0 - z * z) / num_sqrt(PI)) * f;
}

// Positive power series for erf(z), 0 <= z < 2.2:
// erf(z) = (2/sqrt(pi)) * exp(-z^2) * sum_{n=0}^inf (2^n z^(2n+1)) / (2n+1)!!
fn _erf_pos_series(z) {
    if z == 0.0 { return 0.0; }
    let two_z2 = 2.0 * z * z;
    let term = z;
    let sum_s = z;
    let n = 1;
    while n <= 80 {
        term = term * two_z2 / (2.0 * n + 1.0);
        sum_s = sum_s + term;
        if term <= 1e-17 * sum_s { break; }
        n = n + 1;
    }
    return (2.0 / num_sqrt(PI)) * num_exp(0.0 - z * z) * sum_s;
}

fn _eval_erf(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 0.0; }
    let z = num_abs(x);
    let res = if z < 2.2 { _erf_pos_series(z) } else { 1.0 - _erfc_pos_cf(z) };
    return if x < 0.0 { 0.0 - res } else { res };
}

fn _eval_erfc(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 1.0; }
    if x > 0.0 {
        return if x < 2.2 { 1.0 - _erf_pos_series(x) } else { _erfc_pos_cf(x) };
    }
    let z = 0.0 - x;
    return if z < 2.2 { 1.0 + _erf_pos_series(z) } else { 2.0 - _erfc_pos_cf(z) };
}

fn _eval_erfi(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 0.0; }
    let z = num_abs(x);
    if z > 26.6 { return _nan_val(); }
    let res = 0.0;
    if z <= 6.5 {
        // Strictly positive Maclaurin series (zero cancellation across [0, 6.5]):
        // erfi(z) = (2/sqrt(pi)) * sum_{n=0}^inf z^(2n+1) / (n! * (2n+1))
        let z2 = z * z;
        let z_pow_div_fact = z;
        let sum_s = z;
        let n = 1;
        while n <= 240 {
            z_pow_div_fact = z_pow_div_fact * z2 / (n * 1.0);
            let contrib = z_pow_div_fact / (2.0 * n + 1.0);
            sum_s = sum_s + contrib;
            if contrib <= 1e-17 * sum_s { break; }
            n = n + 1;
        }
        res = (2.0 / num_sqrt(PI)) * sum_s;
    } else {
        // Asymptotic expansion for z > 6.5 (truncation error < exp(-42.25) < 5e-19):
        // erfi(z) ~ (exp(z^2) / (sqrt(pi) * z)) * sum_{k=0}^K (2k-1)!! / (2*z^2)^k
        let inv_2z2 = 1.0 / (2.0 * z * z);
        let term = 1.0;
        let sum_a = 1.0;
        let k = 1;
        while k <= 80 {
            let nxt = term * (2.0 * k - 1.0) * inv_2z2;
            if nxt > term { break; }
            term = nxt;
            sum_a = sum_a + term;
            if term <= 1e-17 * sum_a { break; }
            k = k + 1;
        }
        res = (num_exp(z * z) / (num_sqrt(PI) * z)) * sum_a;
    }
    return if x < 0.0 { 0.0 - res } else { res };
}

fn _eval_Ei(x) {
    if not _is_finite(x) or x == 0.0 { return _nan_val(); }
    if x < 0.0 {
        let z = 0.0 - x;
        if z <= 1.0 {
            let term = 0.0 - z;
            let sum_s = term;
            let k = 2;
            while k <= 50 {
                term = term * (0.0 - z) / (k * 1.0);
                let contrib = term / (k * 1.0);
                sum_s = sum_s + contrib;
                if num_abs(contrib) <= 1e-17 * (1.0 + num_abs(sum_s)) { break; }
                k = k + 1;
            }
            return EULER_GAMMA + num_ln(z) + sum_s;
        }
        if z > 710.0 { return 0.0; }
        // Legendre Jacobi continued fraction for E_1(z) = -Ei(-z), z > 1:
        // E_1(z) = exp(-z) / (z + 1 - 1^2 / (z + 3 - 2^2 / (z + 5 - ...)))
        let tiny = 1e-30;
        let f = tiny;
        let c = f;
        let d = 0.0;
        let j = 1;
        while j <= 200 {
            let a_j = if j == 1 { 1.0 } else { 0.0 - (j - 1.0) * (j - 1.0) };
            let b_j = z + (2.0 * j - 1.0);
            d = b_j + a_j * d;
            if num_abs(d) < tiny { d = tiny; }
            c = b_j + a_j / c;
            if num_abs(c) < tiny { c = tiny; }
            d = 1.0 / d;
            let delta = c * d;
            f = f * delta;
            if num_abs(delta - 1.0) < 1e-16 { break; }
            j = j + 1;
        }
        return 0.0 - num_exp(0.0 - z) * f;
    }
    if x > 709.0 { return _nan_val(); }
    if x <= 40.0 {
        // Strictly positive series for x > 0: Ei(x) = gamma + ln(x) + sum_{k=1}^inf x^k / (k * k!)
        let pow_fact = x;
        let sum_s = x;
        let k = 2;
        while k <= 180 {
            pow_fact = pow_fact * x / (k * 1.0);
            let contrib = pow_fact / (k * 1.0);
            sum_s = sum_s + contrib;
            if contrib <= 1e-17 * sum_s and k > x { break; }
            k = k + 1;
        }
        return EULER_GAMMA + num_ln(x) + sum_s;
    }
    // Asymptotic expansion for x > 40 (min term < 40!/40^40 ~ 6e-17):
    // Ei(x) ~ (exp(x)/x) * sum_{k=0}^K k! / x^k
    let term = 1.0;
    let sum_a = 1.0;
    let k = 1;
    while k <= 80 {
        let nxt = term * (k * 1.0) / x;
        if nxt > term { break; }
        term = nxt;
        sum_a = sum_a + term;
        if term <= 1e-17 * sum_a { break; }
        k = k + 1;
    }
    return (num_exp(x) / x) * sum_a;
}

fn _eval_li(x) {
    if not _is_finite(x) or x <= 0.0 or x == 1.0 { return _nan_val(); }
    return _eval_Ei(num_ln(x));
}

// Auxiliary functions f(z), g(z) via complex Legendre continued fraction for exp(i*z)*E_1(i*z) = g(z) - i*f(z), z >= 4.0
fn _si_ci_aux_fg(z) {
    let tiny = 1e-30;
    let f = _c_make(tiny, 0.0);
    let c = _c_make(tiny, 0.0);
    let d = _c_make(0.0, 0.0);
    let one = _c_make(1.0, 0.0);
    let j = 1;
    while j <= 220 {
        let a_re = if j == 1 { 1.0 } else { 0.0 - (j - 1.0) * (j - 1.0) };
        let a_j = _c_make(a_re, 0.0);
        let b_j = _c_make(2.0 * j - 1.0, z);
        d = _c_add(b_j, _c_mul(a_j, d));
        if num_abs(d.re) + num_abs(d.im) < tiny { d = _c_make(tiny, 0.0); }
        c = _c_add(b_j, _c_div(a_j, c));
        if num_abs(c.re) + num_abs(c.im) < tiny { c = _c_make(tiny, 0.0); }
        d = _c_div(one, d);
        let delta = _c_mul(c, d);
        f = _c_mul(f, delta);
        if num_abs(delta.re - 1.0) + num_abs(delta.im) < 1e-16 { break; }
        j = j + 1;
    }
    return map{ f_aux: 0.0 - f.im, g_aux: f.re };
}

fn _eval_Si(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 0.0; }
    let z = num_abs(x);
    let res = 0.0;
    if z < 4.0 {
        // Rapidly convergent alternating Taylor series for |x| < 4 (max term < 3.4):
        let neg_z2 = 0.0 - z * z;
        let pow_fact = z;
        let sum_s = z;
        let k = 1;
        while k <= 40 {
            let m = 2.0 * k + 1.0;
            pow_fact = pow_fact * neg_z2 / ((2.0 * k) * m);
            let contrib = pow_fact / m;
            sum_s = sum_s + contrib;
            if num_abs(contrib) <= 1e-17 * num_abs(sum_s) { break; }
            k = k + 1;
        }
        res = sum_s;
    } else {
        let aux = _si_ci_aux_fg(z);
        res = 0.5 * PI - aux.f_aux * num_cos(z) - aux.g_aux * num_sin(z);
    }
    return if x < 0.0 { 0.0 - res } else { res };
}

fn _eval_Ci(x) {
    if not _is_finite(x) or x <= 0.0 { return _nan_val(); }
    if x < 4.0 {
        let neg_x2 = 0.0 - x * x;
        let pow_fact = 1.0;
        let sum_s = 0.0;
        let k = 1;
        while k <= 40 {
            let m = 2.0 * k;
            pow_fact = pow_fact * neg_x2 / ((m - 1.0) * m);
            let contrib = pow_fact / m;
            sum_s = sum_s + contrib;
            if num_abs(contrib) <= 1e-17 * (1.0 + num_abs(sum_s)) { break; }
            k = k + 1;
        }
        return EULER_GAMMA + num_ln(x) + sum_s;
    }
    let aux = _si_ci_aux_fg(x);
    return aux.f_aux * num_sin(x) - aux.g_aux * num_cos(x);
}

// Complex Laplace continued fraction for Fresnel tail integral_{z}^{inf} exp(i*(pi/2)*t^2) dt, z >= 1.6
fn _fresnel_tail_cf(z) {
    let half_sqrt_pi = 0.5 * num_sqrt(PI);
    let w = _c_make(half_sqrt_pi * z, 0.0 - half_sqrt_pi * z);
    let tiny = 1e-30;
    let f = _c_make(tiny, 0.0);
    let c = _c_make(tiny, 0.0);
    let d = _c_make(0.0, 0.0);
    let one = _c_make(1.0, 0.0);
    let j = 1;
    while j <= 180 {
        let a_re = if j == 1 { 1.0 } else { 0.5 * (j - 1.0) };
        let a_j = _c_make(a_re, 0.0);
        let b_j = w;
        d = _c_add(b_j, _c_mul(a_j, d));
        if num_abs(d.re) + num_abs(d.im) < tiny { d = _c_make(tiny, 0.0); }
        c = _c_add(b_j, _c_div(a_j, c));
        if num_abs(c.re) + num_abs(c.im) < tiny { c = _c_make(tiny, 0.0); }
        d = _c_div(one, d);
        let delta = _c_mul(c, d);
        f = _c_mul(f, delta);
        if num_abs(delta.re - 1.0) + num_abs(delta.im) < 1e-16 { break; }
        j = j + 1;
    }
    let ang = 0.5 * PI * z * z;
    let phase = _c_make(num_cos(ang), num_sin(ang));
    let scale = 1.0 / (2.0 * num_sqrt(PI));
    let pref = _c_make(scale, scale); // (1 + i) / (2*sqrt(pi))
    let tail = _c_mul(_c_mul(pref, phase), f);
    return map{ C: 0.5 - tail.re, S: 0.5 - tail.im };
}

fn _eval_FresnelS(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 0.0; }
    let z = num_abs(x);
    let res = 0.0;
    if z < 1.6 {
        let a = 0.5 * PI;
        let neg_a2_z4 = 0.0 - a * a * z * z * z * z;
        let pow_fact = a * z * z * z;
        let sum_s = pow_fact / 3.0;
        let k = 1;
        while k <= 36 {
            pow_fact = pow_fact * neg_a2_z4 / ((2.0 * k) * (2.0 * k + 1.0));
            let contrib = pow_fact / (4.0 * k + 3.0);
            sum_s = sum_s + contrib;
            if num_abs(contrib) <= 1e-17 * num_abs(sum_s) { break; }
            k = k + 1;
        }
        res = sum_s;
    } else {
        res = _fresnel_tail_cf(z).S;
    }
    return if x < 0.0 { 0.0 - res } else { res };
}

fn _eval_FresnelC(x) {
    if not _is_finite(x) { return _nan_val(); }
    if x == 0.0 { return 0.0; }
    let z = num_abs(x);
    let res = 0.0;
    if z < 1.6 {
        let a = 0.5 * PI;
        let neg_a2_z4 = 0.0 - a * a * z * z * z * z;
        let pow_fact = z;
        let sum_c = z;
        let k = 1;
        while k <= 36 {
            pow_fact = pow_fact * neg_a2_z4 / ((2.0 * k - 1.0) * (2.0 * k));
            let contrib = pow_fact / (4.0 * k + 1.0);
            sum_c = sum_c + contrib;
            if num_abs(contrib) <= 1e-17 * num_abs(sum_c) { break; }
            k = k + 1;
        }
        res = sum_c;
    } else {
        res = _fresnel_tail_cf(z).C;
    }
    return if x < 0.0 { 0.0 - res } else { res };
}

fn _li2_unit_half_series(z) {
    if z == 0.0 { return 0.0; }
    let zk = z;
    let sum_s = z;
    let k = 2;
    while k <= 64 {
        zk = zk * z;
        let contrib = zk / ((k * 1.0) * (k * 1.0));
        sum_s = sum_s + contrib;
        if num_abs(contrib) <= 1e-18 * num_abs(sum_s) { break; }
        k = k + 1;
    }
    return sum_s;
}

fn _eval_Li2(x) {
    if not _is_finite(x) or x > 1.0 { return _nan_val(); }
    let pi2_6 = (PI * PI) / 6.0;
    if x == 1.0 { return pi2_6; }
    if x == 0.0 { return 0.0; }
    if x == -1.0 { return 0.0 - 0.5 * pi2_6; }
    if x < -1.0 {
        // Inversion reflection x -> 1/x in (-1, 0):
        let lnx = num_ln(0.0 - x);
        return 0.0 - _eval_Li2(1.0 / x) - pi2_6 - 0.5 * lnx * lnx;
    }
    if x < -0.5 {
        // Landen's transformation x -> x/(x - 1) in (1/3, 1/2):
        let w = x / (x - 1.0);
        let ln1mx = num_ln(1.0 - x);
        return 0.0 - _li2_unit_half_series(w) - 0.5 * ln1mx * ln1mx;
    }
    if x > 0.5 {
        // Euler's reflection x -> 1 - x in (0, 1/2):
        return pi2_6 - num_ln(x) * num_ln(1.0 - x) - _li2_unit_half_series(1.0 - x);
    }
    return _li2_unit_half_series(x);
}

fn _eval_lambertw(x) {
    if not _is_finite(x) { return _nan_val(); }
    let branch_min = -1.0 / E_CONST;
    if x < branch_min - 1e-15 { return _nan_val(); }
    if x <= branch_min + 1e-15 { return -1.0; }
    if x == 0.0 { return 0.0; }

    let w = 0.0;
    if x < -0.3 {
        let p2 = 2.0 * (E_CONST * x + 1.0);
        let p = if p2 > 0.0 { num_sqrt(p2) } else { 0.0 };
        w = -1.0 + p - (p * p) / 3.0 + (11.0 / 72.0) * p * p * p;
    } else if x < 0.0 {
        w = x / (1.0 + x);
    } else if x < 3.0 {
        let l1 = num_ln(1.0 + x);
        w = l1 * (1.0 - num_ln(1.0 + l1) / (2.0 + l1));
    } else {
        let l1 = num_ln(x);
        let l2 = num_ln(l1);
        w = l1 - l2 + l2 / l1;
    }

    // Halley's cubic root-finding on r(w) = w - x * exp(-w) = 0
    let iter = 0;
    while iter < 24 {
        let ew = num_exp(w);
        let r = w - x / ew;
        let wp1 = w + 1.0;
        if num_abs(wp1) < 1e-15 { break; }
        let denom = wp1 - ((w + 2.0) * r) / (2.0 * wp1);
        if num_abs(denom) < 1e-30 { break; }
        let dw = r / denom;
        w = w - dw;
        if num_abs(dw) <= 1e-16 * (1.0 + num_abs(w)) { break; }
        iter = iter + 1;
    }
    return w;
}

fn _eval_ast(node, env, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in evaluator"; }
    let k = node.kind;
    if k == "num" { return node.val * 1.0; }
    if k == "sym" {
        let nm = node.name;
        if type(env) == "map" and map_has(env, nm) {
            return env[nm] * 1.0;
        }
        if nm == "pi" { return PI; }
        if nm == "e" { return E_CONST; }
        throw "calculus_ode: unbound variable '" + nm + "'";
    }
    if k == "neg" {
        return 0.0 - _eval_ast(node.arg, env, depth + 1);
    }
    if k == "bin" {
        let lv = _eval_ast(node.left, env, depth + 1);
        let rv = _eval_ast(node.right, env, depth + 1);
        if not _is_finite(lv) or not _is_finite(rv) { return _nan_val(); }
        let op = node.op;
        if op == "+" { return lv + rv; }
        if op == "-" { return lv - rv; }
        if op == "*" { return lv * rv; }
        if op == "/" {
            if num_abs(rv) == 0.0 { return _nan_val(); }
            return lv / rv;
        }
        if op == "^" { return _safe_pow(lv, rv); }
        throw "calculus_ode: unknown operator '" + op + "'";
    }
    if k == "call" {
        let fn_nm = node.name;
        let a0 = _eval_ast(node.args[0], env, depth + 1);
        if not _is_finite(a0) { return _nan_val(); }
        if fn_nm == "sin" { return num_sin(a0); }
        if fn_nm == "cos" { return num_cos(a0); }
        if fn_nm == "tan" { return num_tan(a0); }
        if fn_nm == "cot" {
            let t = num_tan(a0);
            if num_abs(t) == 0.0 { return _nan_val(); }
            return 1.0 / t;
        }
        if fn_nm == "sec" {
            let c = num_cos(a0);
            if num_abs(c) == 0.0 { return _nan_val(); }
            return 1.0 / c;
        }
        if fn_nm == "csc" {
            let s = num_sin(a0);
            if num_abs(s) == 0.0 { return _nan_val(); }
            return 1.0 / s;
        }
        if fn_nm == "asin" {
            if a0 < -1.0 or a0 > 1.0 { return _nan_val(); }
            return num_atan2(a0, num_sqrt(1.0 - a0 * a0));
        }
        if fn_nm == "acos" {
            if a0 < -1.0 or a0 > 1.0 { return _nan_val(); }
            return num_atan2(num_sqrt(1.0 - a0 * a0), a0);
        }
        if fn_nm == "atan" { return num_atan2(a0, 1.0); }
        if fn_nm == "sinh" { return 0.5 * (num_exp(a0) - num_exp(0.0 - a0)); }
        if fn_nm == "cosh" { return 0.5 * (num_exp(a0) + num_exp(0.0 - a0)); }
        if fn_nm == "tanh" {
            if a0 > 40.0 { return 1.0; }
            if a0 < -40.0 { return -1.0; }
            let ep = num_exp(a0);
            let em = num_exp(0.0 - a0);
            return (ep - em) / (ep + em);
        }
        if fn_nm == "exp" { return num_exp(a0); }
        if fn_nm == "ln" {
            if a0 <= 0.0 { return _nan_val(); }
            return num_ln(a0);
        }
        if fn_nm == "log" {
            if a0 <= 0.0 { return _nan_val(); }
            if len(node.args) >= 2 {
                let b0 = _eval_ast(node.args[1], env, depth + 1);
                if b0 <= 0.0 or b0 == 1.0 { return _nan_val(); }
                return num_ln(a0) / num_ln(b0);
            }
            return num_ln(a0);
        }
        if fn_nm == "log10" {
            if a0 <= 0.0 { return _nan_val(); }
            return num_ln(a0) / LN10;
        }
        if fn_nm == "sqrt" {
            if a0 < 0.0 { return _nan_val(); }
            return num_sqrt(a0);
        }
        if fn_nm == "cbrt" {
            if a0 < 0.0 { return 0.0 - num_pow(0.0 - a0, 1.0 / 3.0); }
            if a0 == 0.0 { return 0.0; }
            return num_pow(a0, 1.0 / 3.0);
        }
        if fn_nm == "abs" { return num_abs(a0); }
        if fn_nm == "erf" { return _eval_erf(a0); }
        if fn_nm == "erfc" { return _eval_erfc(a0); }
        if fn_nm == "erfi" { return _eval_erfi(a0); }
        if fn_nm == "Ei" { return _eval_Ei(a0); }
        if fn_nm == "li" { return _eval_li(a0); }
        if fn_nm == "Si" { return _eval_Si(a0); }
        if fn_nm == "Ci" { return _eval_Ci(a0); }
        if fn_nm == "FresnelS" { return _eval_FresnelS(a0); }
        if fn_nm == "FresnelC" { return _eval_FresnelC(a0); }
        if fn_nm == "Li2" { return _eval_Li2(a0); }
        if fn_nm == "lambertw" { return _eval_lambertw(a0); }
        throw "calculus_ode: unknown function '" + fn_nm + "'";
    }
    throw "calculus_ode: invalid AST node";
}

fn evaluate_expr(expr, env = map{}) {
    let ast = parse_expr(expr);
    return _eval_ast(ast, env, 0);
}

fn _eval_1d(ast, var_name, x_val) {
    let env = map{};
    env[var_name] = x_val * 1.0;
    return _eval_ast(ast, env, 0);
}

fn _eval_point(ast, vars, pt) {
    if type(pt) == "map" {
        return _eval_ast(ast, pt, 0);
    }
    let env = map{};
    let i = 0;
    while i < len(vars) {
        env[vars[i]] = pt[i] * 1.0;
        i = i + 1;
    }
    return _eval_ast(ast, env, 0);
}

fn _depends_on(node, var_name, depth) {
    if depth > MAX_DEPTH { return true; }
    let k = node.kind;
    if k == "num" { return false; }
    if k == "sym" { return node.name == var_name; }
    if k == "neg" { return _depends_on(node.arg, var_name, depth + 1); }
    if k == "bin" {
        return _depends_on(node.left, var_name, depth + 1) or _depends_on(node.right, var_name, depth + 1);
    }
    if k == "call" {
        let i = 0;
        while i < len(node.args) {
            if _depends_on(node.args[i], var_name, depth + 1) { return true; }
            i = i + 1;
        }
        return false;
    }
    return false;
}

fn _subst_ast(node, var_name, repl, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in substitution"; }
    let k = node.kind;
    if k == "num" { return node; }
    if k == "sym" {
        if node.name == var_name { return repl; }
        return node;
    }
    if k == "neg" { return _neg(_subst_ast(node.arg, var_name, repl, depth + 1)); }
    if k == "bin" {
        return _bin(node.op, _subst_ast(node.left, var_name, repl, depth + 1), _subst_ast(node.right, var_name, repl, depth + 1));
    }
    if k == "call" {
        let nargs = [];
        let i = 0;
        while i < len(node.args) {
            array_push(nargs, _subst_ast(node.args[i], var_name, repl, depth + 1));
            i = i + 1;
        }
        return _call(node.name, nargs);
    }
    return node;
}

// ============================================================================
// 3. Canonical Key, Formatters (ASCII, Unicode, LaTeX) & Algebraic Simplifier
// ============================================================================

fn _canon_key(node, depth) {
    if depth > MAX_DEPTH { return "?"; }
    let k = node.kind;
    if k == "num" { return "#" + _num_to_clean_str(node.val); }
    if k == "sym" { return "$" + node.name; }
    if k == "neg" { return "-(" + _canon_key(node.arg, depth + 1) + ")"; }
    if k == "bin" {
        return "(" + _canon_key(node.left, depth + 1) + node.op + _canon_key(node.right, depth + 1) + ")";
    }
    if k == "call" {
        let s = node.name + "(";
        let i = 0;
        while i < len(node.args) {
            if i > 0 { s = s + ","; }
            s = s + _canon_key(node.args[i], depth + 1);
            i = i + 1;
        }
        return s + ")";
    }
    return "?";
}

fn _prec(node) {
    if node.kind == "bin" {
        if node.op == "+" or node.op == "-" { return 1; }
        if node.op == "*" or node.op == "/" { return 2; }
        if node.op == "^" { return 4; }
    }
    if node.kind == "neg" { return 3; }
    if node.kind == "num" and node.val < 0 { return 3; }
    return 5;
}

fn format_ascii(node, depth = 0) {
    if depth > MAX_DEPTH { return "..."; }
    let k = node.kind;
    if k == "num" { return _num_to_clean_str(node.val); }
    if k == "sym" { return node.name; }
    if k == "neg" {
        let inner = format_ascii(node.arg, depth + 1);
        if _prec(node.arg) <= 1 { return "-(" + inner + ")"; }
        return "-" + inner;
    }
    if k == "call" {
        let s = node.name + "(";
        let i = 0;
        while i < len(node.args) {
            if i > 0 { s = s + ", "; }
            s = s + format_ascii(node.args[i], depth + 1);
            i = i + 1;
        }
        return s + ")";
    }
    if k == "bin" {
        let op = node.op;
        let ls = format_ascii(node.left, depth + 1);
        let rs = format_ascii(node.right, depth + 1);
        let p = _prec(node);
        let lp = _prec(node.left);
        let rp = _prec(node.right);
        if op == "+" {
            if node.right.kind == "neg" {
                let r_pos = format_ascii(node.right.arg, depth + 1);
                if _prec(node.right.arg) <= 1 { r_pos = "(" + r_pos + ")"; }
                return ls + " - " + r_pos;
            }
            if _is_num(node.right) and node.right.val < 0 {
                return ls + " - " + _num_to_clean_str(0.0 - node.right.val);
            }
            return ls + " + " + rs;
        }
        if op == "-" {
            if rp <= 1 { rs = "(" + rs + ")"; }
            return ls + " - " + rs;
        }
        if op == "*" {
            if lp < 2 { ls = "(" + ls + ")"; }
            if rp < 2 or (node.right.kind == "neg") or (_is_num(node.right) and node.right.val < 0) {
                rs = "(" + rs + ")";
            }
            return ls + "*" + rs;
        }
        if op == "/" {
            if lp < 2 { ls = "(" + ls + ")"; }
            if rp <= 2 or (node.right.kind == "neg") or (_is_num(node.right) and node.right.val < 0) {
                rs = "(" + rs + ")";
            }
            return ls + "/" + rs;
        }
        if op == "^" {
            if lp <= 4 and not (_is_sym(node.left) or (_is_num(node.left) and node.left.val >= 0) or node.left.kind == "call") {
                ls = "(" + ls + ")";
            }
            if rp < 4 or node.right.kind == "neg" or (_is_num(node.right) and node.right.val < 0) {
                rs = "(" + rs + ")";
            }
            return ls + "^" + rs;
        }
    }
    return "?";
}

fn _int_to_superscript(n) {
    let s = _num_to_clean_str(n);
    let out = "";
    let i = 0;
    let sup_digits = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if ch == "-" {
            out = out + "⁻";
        } else {
            let code = strcharcodeat(s, i);
            if code >= 48 and code <= 57 {
                out = out + sup_digits[code - 48];
            } else {
                return "";
            }
        }
        i = i + 1;
    }
    return out;
}

fn format_unicode(node, depth = 0) {
    if depth > MAX_DEPTH { return "..."; }
    let k = node.kind;
    if k == "num" { return _num_to_clean_str(node.val); }
    if k == "sym" {
        if node.name == "pi" { return "π"; }
        return node.name;
    }
    if k == "neg" {
        let inner = format_unicode(node.arg, depth + 1);
        if _prec(node.arg) <= 1 { return "−(" + inner + ")"; }
        return "−" + inner;
    }
    if k == "call" {
        if node.name == "sqrt" and len(node.args) == 1 {
            if _is_sym(node.args[0]) and node.args[0].name == "pi" {
                return "√π";
            }
            return "√(" + format_unicode(node.args[0], depth + 1) + ")";
        }
        if node.name == "abs" and len(node.args) == 1 {
            return "|" + format_unicode(node.args[0], depth + 1) + "|";
        }
        if node.name == "Li2" and len(node.args) == 1 {
            return "Li₂(" + format_unicode(node.args[0], depth + 1) + ")";
        }
        if node.name == "lambertw" and len(node.args) == 1 {
            return "W₀(" + format_unicode(node.args[0], depth + 1) + ")";
        }
        let s = node.name + "(";
        let i = 0;
        while i < len(node.args) {
            if i > 0 { s = s + ", "; }
            s = s + format_unicode(node.args[i], depth + 1);
            i = i + 1;
        }
        return s + ")";
    }
    if k == "bin" {
        let op = node.op;
        let ls = format_unicode(node.left, depth + 1);
        let rs = format_unicode(node.right, depth + 1);
        let lp = _prec(node.left);
        let rp = _prec(node.right);
        if op == "+" {
            if node.right.kind == "neg" {
                let r_pos = format_unicode(node.right.arg, depth + 1);
                if _prec(node.right.arg) <= 1 { r_pos = "(" + r_pos + ")"; }
                return ls + " − " + r_pos;
            }
            return ls + " + " + rs;
        }
        if op == "-" {
            if rp <= 1 { rs = "(" + rs + ")"; }
            return ls + " − " + rs;
        }
        if op == "*" {
            if lp < 2 { ls = "(" + ls + ")"; }
            if rp < 2 or node.right.kind == "neg" { rs = "(" + rs + ")"; }
            return ls + "·" + rs;
        }
        if op == "/" {
            if lp < 2 { ls = "(" + ls + ")"; }
            if rp <= 2 or node.right.kind == "neg" { rs = "(" + rs + ")"; }
            return ls + "/" + rs;
        }
        if op == "^" {
            if lp <= 4 and not (_is_sym(node.left) or (_is_num(node.left) and node.left.val >= 0) or node.left.kind == "call") {
                ls = "(" + ls + ")";
            }
            if _is_num(node.right) and _is_int_val(node.right.val) {
                let sup = _int_to_superscript(node.right.val);
                if sup != "" { return ls + sup; }
            }
            if rp < 4 or node.right.kind == "neg" { rs = "(" + rs + ")"; }
            return ls + "^" + rs;
        }
    }
    return "?";
}

let _LATEX_FUNCS = map{
    "sin": "\\sin", "cos": "\\cos", "tan": "\\tan",
    "cot": "\\cot", "sec": "\\sec", "csc": "\\csc",
    "asin": "\\arcsin", "acos": "\\arccos", "atan": "\\arctan",
    "sinh": "\\sinh", "cosh": "\\cosh", "tanh": "\\tanh",
    "exp": "\\exp", "ln": "\\ln", "log": "\\log", "log10": "\\log_{10}",
    "erf": "\\operatorname{erf}", "erfc": "\\operatorname{erfc}", "erfi": "\\operatorname{erfi}",
    "Ei": "\\operatorname{Ei}", "li": "\\operatorname{li}",
    "Si": "\\operatorname{Si}", "Ci": "\\operatorname{Ci}",
    "FresnelS": "\\operatorname{FresnelS}", "FresnelC": "\\operatorname{FresnelC}",
    "Li2": "\\operatorname{Li}_{2}", "lambertw": "W_{0}"
};

fn format_latex(node, depth = 0) {
    if depth > MAX_DEPTH { return "\\dots"; }
    let k = node.kind;
    if k == "num" { return _num_to_clean_str(node.val); }
    if k == "sym" {
        if node.name == "pi" { return "\\pi"; }
        if node.name == "C1" { return "C_{1}"; }
        if node.name == "C2" { return "C_{2}"; }
        return node.name;
    }
    if k == "neg" {
        let inner = format_latex(node.arg, depth + 1);
        if _prec(node.arg) <= 1 { return "-\\left(" + inner + "\\right)"; }
        return "-" + inner;
    }
    if k == "call" {
        let nm = node.name;
        if nm == "sqrt" and len(node.args) == 1 {
            return "\\sqrt{" + format_latex(node.args[0], depth + 1) + "}";
        }
        if nm == "cbrt" and len(node.args) == 1 {
            return "\\sqrt[3]{" + format_latex(node.args[0], depth + 1) + "}";
        }
        if nm == "abs" and len(node.args) == 1 {
            return "\\left|" + format_latex(node.args[0], depth + 1) + "\\right|";
        }
        if nm == "exp" and len(node.args) == 1 {
            return "e^{" + format_latex(node.args[0], depth + 1) + "}";
        }
        let lnm = if map_has(_LATEX_FUNCS, nm) { _LATEX_FUNCS[nm] } else { "\\operatorname{" + nm + "}" };
        let s = lnm + "\\left(";
        let i = 0;
        while i < len(node.args) {
            if i > 0 { s = s + ", "; }
            s = s + format_latex(node.args[i], depth + 1);
            i = i + 1;
        }
        return s + "\\right)";
    }
    if k == "bin" {
        let op = node.op;
        if op == "/" {
            return "\\frac{" + format_latex(node.left, depth + 1) + "}{" + format_latex(node.right, depth + 1) + "}";
        }
        let ls = format_latex(node.left, depth + 1);
        let rs = format_latex(node.right, depth + 1);
        let lp = _prec(node.left);
        let rp = _prec(node.right);
        if op == "+" {
            if node.right.kind == "neg" {
                let r_pos = format_latex(node.right.arg, depth + 1);
                if _prec(node.right.arg) <= 1 { r_pos = "\\left(" + r_pos + "\\right)"; }
                return ls + " - " + r_pos;
            }
            return ls + " + " + rs;
        }
        if op == "-" {
            if rp <= 1 { rs = "\\left(" + rs + "\\right)"; }
            return ls + " - " + rs;
        }
        if op == "*" {
            if lp < 2 { ls = "\\left(" + ls + "\\right)"; }
            if rp < 2 or node.right.kind == "neg" { rs = "\\left(" + rs + "\\right)"; }
            if _is_num(node.right) { return ls + " \\cdot " + rs; }
            return ls + " " + rs;
        }
        if op == "^" {
            if lp <= 4 and not (_is_sym(node.left) or (_is_num(node.left) and node.left.val >= 0)) {
                ls = "\\left(" + ls + "\\right)";
            }
            return ls + "^{" + format_latex(node.right, depth + 1) + "}";
        }
    }
    return "?";
}

// ============================================================================
// 4. Canonical Algebraic Simplifier (Constant Folding, Rational GCD, Powers, Like Terms)
// ============================================================================

// Extract exact rational constant { ok, p, q } if node is num, -num, or num/num
fn _as_rational(node) {
    if _is_num(node) and _is_int_val(node.val) {
        return map{ ok: true, p: num_round(node.val), q: 1 };
    }
    if node.kind == "neg" {
        let sub_r = _as_rational(node.arg);
        if sub_r.ok {
            return map{ ok: true, p: 0 - sub_r.p, q: sub_r.q };
        }
    }
    if node.kind == "bin" and node.op == "/" {
        let rl = _as_rational(node.left);
        let rr = _as_rational(node.right);
        if rl.ok and rr.ok and rr.p != 0 {
            let p = rl.p * rr.q;
            let q = rl.q * rr.p;
            if q < 0 { p = 0 - p; q = 0 - q; }
            let g = _gcd_int(p, q);
            return map{ ok: true, p: num_round(p / g), q: num_round(q / g) };
        }
    }
    return map{ ok: false, p: 0, q: 1 };
}

fn _rational_to_ast(p, q) {
    if p == 0 { return _num(0); }
    let np = p;
    let nq = q;
    if nq < 0 { np = 0 - np; nq = 0 - nq; }
    let g = _gcd_int(np, nq);
    np = num_round(np / g);
    nq = num_round(nq / g);
    if nq == 1 {
        if np < 0 { return _neg(_num(0 - np)); }
        return _num(np);
    }
    if np < 0 {
        return _neg(_bin("/", _num(0 - np), _num(nq)));
    }
    return _bin("/", _num(np), _num(nq));
}

// Collect multiplicative factors into a list of { base, exp } and rational/float scalar
fn _collect_mul_factors(node, invert, state, depth) {
    if depth > MAX_DEPTH { return false; }
    if _is_num(node) {
        let v = node.val;
        if _near_zero(v) {
            if invert {
                // Keep 1/0 untouched as a factor so we do not erase division by 0
                array_push(state.factors, map{ base: node, exp: _num(-1) });
                return true;
            }
            state.zero = true;
            return true;
        }
        if v < 0 {
            state.sign = 0 - state.sign;
            v = 0.0 - v;
        }
        if _is_int_val(v) and state.is_rat {
            let iv = num_round(v);
            if invert { state.den_int = state.den_int * iv; }
            else { state.num_int = state.num_int * iv; }
            let g = _gcd_int(state.num_int, state.den_int);
            state.num_int = num_round(state.num_int / g);
            state.den_int = num_round(state.den_int / g);
        } else {
            if state.is_rat {
                state.float_val = (state.num_int * 1.0) / (state.den_int * 1.0);
                state.is_rat = false;
            }
            if invert { state.float_val = state.float_val / v; }
            else { state.float_val = state.float_val * v; }
        }
        return true;
    }
    if node.kind == "neg" {
        state.sign = 0 - state.sign;
        return _collect_mul_factors(node.arg, invert, state, depth + 1);
    }
    if node.kind == "bin" and node.op == "*" {
        let _ = _collect_mul_factors(node.left, invert, state, depth + 1);
        let _ = _collect_mul_factors(node.right, invert, state, depth + 1);
        return true;
    }
    if node.kind == "bin" and node.op == "/" {
        let _ = _collect_mul_factors(node.left, invert, state, depth + 1);
        let _ = _collect_mul_factors(node.right, not invert, state, depth + 1);
        return true;
    }
    if node.kind == "bin" and node.op == "^" {
        let e = if invert { _neg(node.right) } else { node.right };
        array_push(state.factors, map{ base: node.left, exp: e });
        return true;
    }
    let e = if invert { _num(-1) } else { _num(1) };
    array_push(state.factors, map{ base: node, exp: e });
    return true;
}

// Decompose a term into { coeff_num, coeff_den, coeff_float, is_rat, core }
fn _split_coeff_and_core(node) {
    let r = _as_rational(node);
    if r.ok {
        return map{ is_const: true, is_rat: true, p: r.p, q: r.q, f: (r.p * 1.0) / (r.q * 1.0), core: _num(1) };
    }
    if _is_num(node) {
        return map{ is_const: true, is_rat: false, p: 0, q: 1, f: node.val, core: _num(1) };
    }
    if node.kind == "neg" {
        let sub = _split_coeff_and_core(node.arg);
        if sub.is_const {
            return map{ is_const: true, is_rat: sub.is_rat, p: 0 - sub.p, q: sub.q, f: 0.0 - sub.f, core: _num(1) };
        }
        return map{ is_const: false, is_rat: sub.is_rat, p: 0 - sub.p, q: sub.q, f: 0.0 - sub.f, core: sub.core };
    }
    if node.kind == "bin" and node.op == "*" {
        let rl = _as_rational(node.left);
        if rl.ok {
            return map{ is_const: false, is_rat: true, p: rl.p, q: rl.q, f: (rl.p * 1.0) / (rl.q * 1.0), core: node.right };
        }
        if _is_num(node.left) {
            return map{ is_const: false, is_rat: false, p: 0, q: 1, f: node.left.val, core: node.right };
        }
    }
    if node.kind == "bin" and node.op == "/" {
        let rr = _as_rational(node.right);
        if rr.ok and rr.p != 0 {
            let sub = _split_coeff_and_core(node.left);
            if sub.is_rat {
                let np = sub.p * rr.q;
                let nq = sub.q * rr.p;
                if nq < 0 { np = 0 - np; nq = 0 - nq; }
                let g = _gcd_int(np, nq);
                return map{ is_const: sub.is_const, is_rat: true, p: num_round(np / g), q: num_round(nq / g), f: (np * 1.0) / (nq * 1.0), core: sub.core };
            }
        }
    }
    return map{ is_const: false, is_rat: true, p: 1, q: 1, f: 1.0, core: node };
}

fn _build_scaled_term(is_rat, p, q, f, core) {
    if is_rat {
        if p == 0 { return _num(0); }
        let np = p;
        let nq = q;
        if nq < 0 { np = 0 - np; nq = 0 - nq; }
        let g = _gcd_int(np, nq);
        np = num_round(np / g);
        nq = num_round(nq / g);
        if _is_num_eq(core, 1) { return _rational_to_ast(np, nq); }
        let abs_p = num_round(num_abs(np));
        let num_part = if abs_p == 1 { core } else { _bin("*", _num(abs_p), core) };
        let frac_part = if nq == 1 { num_part } else { _bin("/", num_part, _num(nq)) };
        if np < 0 { return _neg(frac_part); }
        return frac_part;
    } else {
        if _near_zero(f) { return _num(0); }
        if _is_num_eq(core, 1) {
            if f < 0 { return _neg(_num(0.0 - f)); }
            return _num(f);
        }
        let af = num_abs(f);
        let prod = if num_abs(af - 1.0) < 1e-12 { core } else { _bin("*", _num(af), core) };
        if f < 0 { return _neg(prod); }
        return prod;
    }
}

fn _collect_sum_terms(node, sign, list, depth) {
    if depth > MAX_DEPTH { return false; }
    if node.kind == "bin" and node.op == "+" {
        let _ = _collect_sum_terms(node.left, sign, list, depth + 1);
        let _ = _collect_sum_terms(node.right, sign, list, depth + 1);
        return true;
    }
    if node.kind == "bin" and node.op == "-" {
        let _ = _collect_sum_terms(node.left, sign, list, depth + 1);
        let _ = _collect_sum_terms(node.right, 0 - sign, list, depth + 1);
        return true;
    }
    if node.kind == "neg" {
        return _collect_sum_terms(node.arg, 0 - sign, list, depth + 1);
    }
    if sign < 0 {
        array_push(list, _neg(node));
    } else {
        array_push(list, node);
    }
    return true;
}

fn _simplify_ast(node, depth) {
    if depth > MAX_DEPTH { return node; }
    let k = node.kind;
    if k == "num" {
        if node.val < 0 { return _neg(_num(0.0 - node.val)); }
        return _num(node.val);
    }
    if k == "sym" { return node; }
    if k == "neg" {
        let a = _simplify_ast(node.arg, depth + 1);
        if _is_num_eq(a, 0) { return _num(0); }
        if a.kind == "neg" { return a.arg; }
        return _neg(a);
    }
    if k == "call" {
        let args = [];
        let i = 0;
        while i < len(node.args) {
            array_push(args, _simplify_ast(node.args[i], depth + 1));
            i = i + 1;
        }
        let nm = node.name;
        if len(args) == 1 {
            let u = args[0];
            if nm == "ln" {
                if _is_num_eq(u, 1) { return _num(0); }
                if _is_sym(u) and u.name == "e" { return _num(1); }
                if u.kind == "call" and u.name == "exp" and len(u.args) == 1 { return u.args[0]; }
            }
            if nm == "exp" {
                if _is_num_eq(u, 0) { return _num(1); }
                if u.kind == "call" and u.name == "ln" and len(u.args) == 1 { return u.args[0]; }
            }
            if nm == "sin" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "cos" and _is_num_eq(u, 0) { return _num(1); }
            if nm == "tan" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "asin" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "atan" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "sinh" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "cosh" and _is_num_eq(u, 0) { return _num(1); }
            if nm == "tanh" and _is_num_eq(u, 0) { return _num(0); }
            if nm == "sqrt" {
                if _is_num_eq(u, 0) { return _num(0); }
                if _is_num_eq(u, 1) { return _num(1); }
                if _is_num(u) and u.val > 0 {
                    let sr = num_sqrt(u.val);
                    if _is_int_val(sr) { return _num(num_round(sr)); }
                }
            }
            if nm == "abs" {
                if _is_num(u) { return _num(num_abs(u.val)); }
                if u.kind == "neg" { return _call("abs", [u.arg]); }
            }
            if (nm == "erf" or nm == "erfi" or nm == "Si" or nm == "FresnelS" or nm == "FresnelC" or nm == "Li2" or nm == "lambertw") and _is_num_eq(u, 0) {
                return _num(0);
            }
            if nm == "erfc" and _is_num_eq(u, 0) { return _num(1); }
            // Even/odd symmetries on negated arguments
            if u.kind == "neg" {
                if nm == "cos" or nm == "cosh" or nm == "sec" {
                    return _call(nm, [u.arg]);
                }
                if nm == "sin" or nm == "tan" or nm == "sinh" or nm == "tanh" or nm == "atan" or nm == "asin" or nm == "erf" or nm == "erfi" or nm == "Si" or nm == "FresnelS" or nm == "FresnelC" {
                    return _neg(_call(nm, [u.arg]));
                }
            }
        }
        return _call(nm, args);
    }
    if k == "bin" {
        let op = node.op;
        if op == "^" {
            let b = _simplify_ast(node.left, depth + 1);
            let e = _simplify_ast(node.right, depth + 1);
            if _is_num_eq(e, 0) { return _num(1); }
            if _is_num_eq(e, 1) { return b; }
            if _is_num_eq(b, 1) { return _num(1); }
            if _is_num_eq(b, 0) {
                let re = _as_rational(e);
                if (re.ok and re.p > 0) or (_is_num(e) and e.val > 0) { return _num(0); }
            }
            // (-u)^n for integer n
            if b.kind == "neg" and _is_num(e) and _is_int_val(e.val) {
                let ni = num_round(e.val);
                let inner_pow = _simplify_ast(_bin("^", b.arg, e), depth + 1);
                if num_mod(num_abs(ni), 2) == 0 { return inner_pow; }
                return _simplify_ast(_neg(inner_pow), depth + 1);
            }
            // sqrt(u)^2 -> u
            if b.kind == "call" and b.name == "sqrt" and len(b.args) == 1 and _is_num_eq(e, 2) {
                return b.args[0];
            }
            // exp(u)^e -> exp(u * e)
            if b.kind == "call" and b.name == "exp" and len(b.args) == 1 {
                return _simplify_ast(_call("exp", [_simplify_ast(_bin("*", b.args[0], e), depth + 1)]), depth + 1);
            }
            // (u^a)^c -> u^(a*c) when c is integer
            if b.kind == "bin" and b.op == "^" {
                let rc = _as_rational(e);
                if rc.ok and rc.q == 1 {
                    let new_e = _simplify_ast(_bin("*", b.right, e), depth + 1);
                    return _simplify_ast(_bin("^", b.left, new_e), depth + 1);
                }
            }
            // Exact integer power of rational/integer constant
            let rb = _as_rational(b);
            let re = _as_rational(e);
            if rb.ok and re.ok and re.q == 1 and num_abs(re.p) <= 16 {
                let exp_i = re.p;
                if exp_i >= 0 {
                    let np = num_round(_safe_pow(rb.p, exp_i));
                    let nq = num_round(_safe_pow(rb.q, exp_i));
                    return _rational_to_ast(np, nq);
                } else if rb.p != 0 {
                    let np = num_round(_safe_pow(rb.q, 0 - exp_i));
                    let nq = num_round(_safe_pow(rb.p, 0 - exp_i));
                    return _rational_to_ast(np, nq);
                }
            }
            if _is_num(b) and _is_num(e) {
                let pv = _safe_pow(b.val, e.val);
                if _is_finite(pv) {
                    if pv < 0 { return _neg(_num(0.0 - pv)); }
                    return _num(pv);
                }
            }
            return _bin("^", b, e);
        }

        if op == "*" or op == "/" {
            let sl = _simplify_ast(node.left, depth + 1);
            let sr = _simplify_ast(node.right, depth + 1);
            let st = map{
                zero: false, sign: 1, is_rat: true,
                num_int: 1, den_int: 1, float_val: 1.0, factors: []
            };
            let _ = _collect_mul_factors(sl, false, st, depth + 1);
            let _ = _collect_mul_factors(sr, op == "/", st, depth + 1);
            if st.zero { return _num(0); }

            // Combine factors sharing identical canonical base
            let order_keys = [];
            let base_map = map{};
            let exp_map = map{};
            let idx = 0;
            while idx < len(st.factors) {
                let f = st.factors[idx];
                let sb = _simplify_ast(f.base, depth + 1);
                let se = _simplify_ast(f.exp, depth + 1);
                if sb.kind == "call" and sb.name == "sqrt" and len(sb.args) == 1 {
                    sb = sb.args[0];
                    se = _simplify_ast(_bin("/", se, _num(2)), depth + 1);
                }
                let bk = _canon_key(sb, 0);
                if map_has(exp_map, bk) {
                    exp_map[bk] = _simplify_ast(_bin("+", exp_map[bk], se), depth + 1);
                } else {
                    array_push(order_keys, bk);
                    base_map[bk] = sb;
                    exp_map[bk] = se;
                }
                idx = idx + 1;
            }

            let num_nodes = [];
            let den_nodes = [];
            if st.is_rat {
                if st.num_int != 1 { array_push(num_nodes, _num(st.num_int)); }
                if st.den_int != 1 { array_push(den_nodes, _num(st.den_int)); }
            } else {
                if num_abs(st.float_val - 1.0) >= 1e-12 {
                    array_push(num_nodes, _num(st.float_val));
                }
            }

            let ki = 0;
            while ki < len(order_keys) {
                let bk = order_keys[ki];
                let sb = base_map[bk];
                let se = _simplify_ast(exp_map[bk], depth + 1);
                if not _is_num_eq(se, 0) {
                    let re = _as_rational(se);
                    if re.ok and re.p < 0 {
                        let pos_e = _rational_to_ast(0 - re.p, re.q);
                        if re.p == -1 and re.q == 2 {
                            array_push(den_nodes, _call("sqrt", [sb]));
                        } else if _is_num_eq(pos_e, 1) {
                            array_push(den_nodes, sb);
                        } else {
                            array_push(den_nodes, _simplify_ast(_bin("^", sb, pos_e), depth + 1));
                        }
                    } else if se.kind == "neg" {
                        let pos_e = se.arg;
                        if _is_num_eq(pos_e, 1) { array_push(den_nodes, sb); }
                        else { array_push(den_nodes, _bin("^", sb, pos_e)); }
                    } else if re.ok and re.p == 1 and re.q == 2 {
                        array_push(num_nodes, _call("sqrt", [sb]));
                    } else if _is_num_eq(se, 1) {
                        array_push(num_nodes, sb);
                    } else {
                        array_push(num_nodes, _simplify_ast(_bin("^", sb, se), depth + 1));
                    }
                }
                ki = ki + 1;
            }

            let num_ast = _num(1);
            if len(num_nodes) > 0 {
                num_ast = num_nodes[0];
                let m = 1;
                while m < len(num_nodes) {
                    num_ast = _bin("*", num_ast, num_nodes[m]);
                    m = m + 1;
                }
            }
            let res = num_ast;
            if len(den_nodes) > 0 {
                let den_ast = den_nodes[0];
                let m = 1;
                while m < len(den_nodes) {
                    den_ast = _bin("*", den_ast, den_nodes[m]);
                    m = m + 1;
                }
                res = _bin("/", num_ast, den_ast);
            }
            if st.sign < 0 { return _neg(res); }
            return res;
        }

        if op == "+" or op == "-" {
            let raw_terms = [];
            let _ = _collect_sum_terms(node, 1, raw_terms, depth + 1);

            let const_is_rat = true;
            let const_p = 0;
            let const_q = 1;
            let const_f = 0.0;

            let keys = [];
            let groups = map{};
            let ti = 0;
            while ti < len(raw_terms) {
                let sterm = _simplify_ast(raw_terms[ti], depth + 1);
                let sp = _split_coeff_and_core(sterm);
                if sp.is_const {
                    if const_is_rat and sp.is_rat {
                        let np = const_p * sp.q + sp.p * const_q;
                        let nq = const_q * sp.q;
                        let g = _gcd_int(np, nq);
                        const_p = num_round(np / g);
                        const_q = num_round(nq / g);
                        const_f = (const_p * 1.0) / (const_q * 1.0);
                    } else {
                        const_is_rat = false;
                        const_f = const_f + sp.f;
                    }
                } else {
                    let ck = _canon_key(sp.core, 0);
                    if map_has(groups, ck) {
                        let gobj = groups[ck];
                        if gobj.is_rat and sp.is_rat {
                            let np = gobj.p * sp.q + sp.p * gobj.q;
                            let nq = gobj.q * sp.q;
                            let g = _gcd_int(np, nq);
                            gobj.p = num_round(np / g);
                            gobj.q = num_round(nq / g);
                            gobj.f = (gobj.p * 1.0) / (gobj.q * 1.0);
                        } else {
                            gobj.is_rat = false;
                            gobj.f = gobj.f + sp.f;
                        }
                    } else {
                        array_push(keys, ck);
                        groups[ck] = map{
                            is_rat: sp.is_rat, p: sp.p, q: sp.q, f: sp.f, core: sp.core
                        };
                    }
                }
                ti = ti + 1;
            }

            // Pythagorean trig identity check: c*sin(u)^2 + c*cos(u)^2 -> c
            let ki = 0;
            while ki < len(keys) {
                let ck = keys[ki];
                let gobj = groups[ck];
                let cnode = gobj.core;
                if cnode.kind == "bin" and cnode.op == "^" and _is_num_eq(cnode.right, 2) and cnode.left.kind == "call" and cnode.left.name == "sin" {
                    let cos_sq = _bin("^", _call("cos", cnode.left.args), _num(2));
                    let cos_ck = _canon_key(cos_sq, 0);
                    if map_has(groups, cos_ck) {
                        let gcos = groups[cos_ck];
                        if num_abs(gobj.f - gcos.f) < 1e-12 and num_abs(gobj.f) > 0 {
                            if const_is_rat and gobj.is_rat {
                                let np = const_p * gobj.q + gobj.p * const_q;
                                let nq = const_q * gobj.q;
                                let g = _gcd_int(np, nq);
                                const_p = num_round(np / g);
                                const_q = num_round(nq / g);
                                const_f = (const_p * 1.0) / (const_q * 1.0);
                            } else {
                                const_is_rat = false;
                                const_f = const_f + gobj.f;
                            }
                            gobj.p = 0; gobj.f = 0.0;
                            gcos.p = 0; gcos.f = 0.0;
                        }
                    }
                }
                ki = ki + 1;
            }

            let out_terms = [];
            let ki2 = 0;
            while ki2 < len(keys) {
                let gobj = groups[keys[ki2]];
                let built = _build_scaled_term(gobj.is_rat, gobj.p, gobj.q, gobj.f, gobj.core);
                if not _is_num_eq(built, 0) {
                    array_push(out_terms, built);
                }
                ki2 = ki2 + 1;
            }
            let c_built = _build_scaled_term(const_is_rat, const_p, const_q, const_f, _num(1));
            if not _is_num_eq(c_built, 0) {
                array_push(out_terms, c_built);
            }

            if len(out_terms) == 0 { return _num(0); }
            let acc = out_terms[0];
            let m = 1;
            while m < len(out_terms) {
                let nxt = out_terms[m];
                if nxt.kind == "neg" {
                    acc = _bin("-", acc, nxt.arg);
                } else {
                    acc = _bin("+", acc, nxt);
                }
                m = m + 1;
            }
            return acc;
        }
    }
    return node;
}

fn simplify(expr) {
    let ast = parse_expr(expr);
    let s1 = _simplify_ast(ast, 0);
    let s2 = _simplify_ast(s1, 0);
    return map{
        expr: format_ascii(s2, 0),
        ascii: format_ascii(s2, 0),
        unicode: format_unicode(s2, 0),
        latex: format_latex(s2, 0),
        ast: s2
    };
}

fn _simp(ast) {
    return _simplify_ast(_simplify_ast(ast, 0), 0);
}

// ============================================================================
// 5. Symbolic Differentiation, Implicit & Parametric Derivatives
// ============================================================================

fn _diff_ast(node, v, steps, depth) {
    if depth > MAX_DEPTH { throw "calculus_ode: MAX_DEPTH exceeded in differentiation"; }
    if not _depends_on(node, v, 0) {
        return _num(0);
    }
    let k = node.kind;
    if k == "sym" {
        if node.name == v {
            array_push(steps, "d/d" + v + "(" + v + ") = 1 [variable_rule]");
            return _num(1);
        }
        return _num(0);
    }
    if k == "neg" {
        return _neg(_diff_ast(node.arg, v, steps, depth + 1));
    }
    if k == "bin" {
        let op = node.op;
        let u = node.left;
        let w = node.right;
        let u_dep = _depends_on(u, v, 0);
        let w_dep = _depends_on(w, v, 0);

        if op == "+" or op == "-" {
            array_push(steps, "sum_rule on " + format_ascii(node, 0));
            let du = if u_dep { _diff_ast(u, v, steps, depth + 1) } else { _num(0) };
            let dw = if w_dep { _diff_ast(w, v, steps, depth + 1) } else { _num(0) };
            return _bin(op, du, dw);
        }
        if op == "*" {
            if not u_dep {
                array_push(steps, "constant_multiple_rule on " + format_ascii(node, 0));
                return _bin("*", u, _diff_ast(w, v, steps, depth + 1));
            }
            if not w_dep {
                array_push(steps, "constant_multiple_rule on " + format_ascii(node, 0));
                return _bin("*", w, _diff_ast(u, v, steps, depth + 1));
            }
            array_push(steps, "product_rule (uv)' = u'v + uv' on " + format_ascii(node, 0));
            let du = _diff_ast(u, v, steps, depth + 1);
            let dw = _diff_ast(w, v, steps, depth + 1);
            return _bin("+", _bin("*", du, w), _bin("*", u, dw));
        }
        if op == "/" {
            if not w_dep {
                array_push(steps, "constant_divisor_rule on " + format_ascii(node, 0));
                return _bin("/", _diff_ast(u, v, steps, depth + 1), w);
            }
            array_push(steps, "quotient_rule (u/v)' = (u'v - uv')/v^2 on " + format_ascii(node, 0));
            let du = if u_dep { _diff_ast(u, v, steps, depth + 1) } else { _num(0) };
            let dw = _diff_ast(w, v, steps, depth + 1);
            let numer = _bin("-", _bin("*", du, w), _bin("*", u, dw));
            let denom = _bin("^", w, _num(2));
            return _bin("/", numer, denom);
        }
        if op == "^" {
            if not w_dep {
                array_push(steps, "power_rule (u^c)' = c*u^(c-1)*u' on " + format_ascii(node, 0));
                let du = _diff_ast(u, v, steps, depth + 1);
                let c_minus_1 = _simp(_bin("-", w, _num(1)));
                return _bin("*", _bin("*", w, _bin("^", u, c_minus_1)), du);
            }
            if not u_dep {
                array_push(steps, "exponential_rule (a^v)' = a^v*ln(a)*v' on " + format_ascii(node, 0));
                let dw = _diff_ast(w, v, steps, depth + 1);
                if _is_sym(u) and u.name == "e" {
                    return _bin("*", _call("exp", [w]), dw);
                }
                return _bin("*", _bin("*", node, _call("ln", [u])), dw);
            }
            // Generalized exponential-power rule: (u^v)' = u^v * (v'*ln(u) + v*u'/u)
            array_push(steps, "generalized_power_rule (u^v)' = u^v*(v'*ln(u) + v*u'/u) on " + format_ascii(node, 0));
            let du = _diff_ast(u, v, steps, depth + 1);
            let dw = _diff_ast(w, v, steps, depth + 1);
            let term1 = _simp(_bin("*", dw, _call("ln", [u])));
            let term2 = _simp(_bin("/", _bin("*", w, du), u));
            let inner = _simp(_bin("+", term1, term2));
            return _bin("*", node, inner);
        }
    }
    if k == "call" {
        let nm = node.name;
        let u = node.args[0];
        array_push(steps, "chain_rule:" + nm + " on " + format_ascii(node, 0));
        let du = _diff_ast(u, v, steps, depth + 1);
        if nm == "sin" { return _bin("*", _call("cos", [u]), du); }
        if nm == "cos" { return _neg(_bin("*", _call("sin", [u]), du)); }
        if nm == "tan" { return _bin("*", _bin("^", _call("sec", [u]), _num(2)), du); }
        if nm == "cot" { return _neg(_bin("*", _bin("^", _call("csc", [u]), _num(2)), du)); }
        if nm == "sec" { return _bin("*", _bin("*", _call("sec", [u]), _call("tan", [u])), du); }
        if nm == "csc" { return _neg(_bin("*", _bin("*", _call("csc", [u]), _call("cot", [u])), du)); }
        if nm == "asin" {
            return _bin("/", du, _call("sqrt", [_bin("-", _num(1), _bin("^", u, _num(2)))]));
        }
        if nm == "acos" {
            return _neg(_bin("/", du, _call("sqrt", [_bin("-", _num(1), _bin("^", u, _num(2)))]) ));
        }
        if nm == "atan" {
            return _bin("/", du, _bin("+", _num(1), _bin("^", u, _num(2))));
        }
        if nm == "sinh" { return _bin("*", _call("cosh", [u]), du); }
        if nm == "cosh" { return _bin("*", _call("sinh", [u]), du); }
        if nm == "tanh" { return _bin("/", du, _bin("^", _call("cosh", [u]), _num(2))); }
        if nm == "exp" { return _bin("*", _call("exp", [u]), du); }
        if nm == "ln" { return _bin("/", du, u); }
        if nm == "log" {
            if len(node.args) >= 2 {
                let b = node.args[1];
                return _bin("/", du, _bin("*", u, _call("ln", [b])));
            }
            return _bin("/", du, u);
        }
        if nm == "log10" { return _bin("/", du, _bin("*", u, _call("ln", [_num(10)]))); }
        if nm == "sqrt" { return _bin("/", du, _bin("*", _num(2), _call("sqrt", [u]))); }
        if nm == "cbrt" { return _bin("/", du, _bin("*", _num(3), _bin("^", _call("cbrt", [u]), _num(2)))); }
        if nm == "abs" { return _bin("*", _bin("/", u, _call("abs", [u])), du); }
        if nm == "erf" {
            let two_ov_rtpi = _bin("/", _num(2), _call("sqrt", [_sym("pi")]));
            return _bin("*", _bin("*", two_ov_rtpi, _call("exp", [_neg(_bin("^", u, _num(2)))])), du);
        }
        if nm == "erfc" {
            let two_ov_rtpi = _bin("/", _num(2), _call("sqrt", [_sym("pi")]));
            return _neg(_bin("*", _bin("*", two_ov_rtpi, _call("exp", [_neg(_bin("^", u, _num(2)))])), du));
        }
        if nm == "erfi" {
            let two_ov_rtpi = _bin("/", _num(2), _call("sqrt", [_sym("pi")]));
            return _bin("*", _bin("*", two_ov_rtpi, _call("exp", [_bin("^", u, _num(2))])), du);
        }
        if nm == "Ei" {
            return _bin("*", _bin("/", _call("exp", [u]), u), du);
        }
        if nm == "li" {
            return _bin("/", du, _call("ln", [u]));
        }
        if nm == "Si" {
            return _bin("*", _bin("/", _call("sin", [u]), u), du);
        }
        if nm == "Ci" {
            return _bin("*", _bin("/", _call("cos", [u]), u), du);
        }
        if nm == "FresnelS" {
            let half_pi_u2 = _bin("*", _bin("/", _sym("pi"), _num(2)), _bin("^", u, _num(2)));
            return _bin("*", _call("sin", [half_pi_u2]), du);
        }
        if nm == "FresnelC" {
            let half_pi_u2 = _bin("*", _bin("/", _sym("pi"), _num(2)), _bin("^", u, _num(2)));
            return _bin("*", _call("cos", [half_pi_u2]), du);
        }
        if nm == "Li2" {
            return _neg(_bin("*", _bin("/", _call("ln", [_bin("-", _num(1), u)]), u), du));
        }
        if nm == "lambertw" {
            let wu = _call("lambertw", [u]);
            return _bin("*", _bin("/", wu, _bin("*", u, _bin("+", _num(1), wu))), du);
        }
        throw "calculus_ode: unsupported function '" + nm + "' in diff";
    }
    throw "calculus_ode: invalid node in diff";
}

fn diff(expr, var_name = "x", order = 1) {
    if order < 0 or order > MAX_DEPTH {
        throw "calculus_ode: invalid derivative order " + str(order);
    }
    let cur = _simp(parse_expr(expr));
    let steps = [];
    let k = 0;
    while k < order {
        cur = _simp(_diff_ast(cur, var_name, steps, 0));
        k = k + 1;
    }
    let asc = format_ascii(cur, 0);
    let uni = format_unicode(cur, 0);
    let ltx = format_latex(cur, 0);
    let fn_eval = fn(pt_or_val) {
        if type(pt_or_val) == "number" {
            return _eval_1d(cur, var_name, pt_or_val);
        }
        return _eval_ast(cur, pt_or_val, 0);
    };
    return map{
        expr: asc,
        ascii: asc,
        unicode: uni,
        latex: ltx,
        ast: cur,
        variable: var_name,
        order: order,
        steps: steps,
        evaluate: fn_eval
    };
}

fn implicit_diff(expr, x_var = "x", y_var = "y") {
    let ast = _simp(parse_expr(expr));
    let steps = [];
    let fx = _simp(_diff_ast(ast, x_var, steps, 0));
    let fy = _simp(_diff_ast(ast, y_var, steps, 0));
    let ratio = _simp(_neg(_bin("/", fx, fy)));
    array_push(steps, "implicit_diff: dy/dx = -F_" + x_var + " / F_" + y_var + " = " + format_ascii(ratio, 0));
    return map{
        expr: format_ascii(ratio, 0),
        ascii: format_ascii(ratio, 0),
        unicode: format_unicode(ratio, 0),
        latex: format_latex(ratio, 0),
        fx: format_ascii(fx, 0),
        fy: format_ascii(fy, 0),
        ast: ratio,
        steps: steps,
        evaluate: fn(env) { return _eval_ast(ratio, env, 0); }
    };
}

fn parametric_diff(x_expr, y_expr, t_var = "t", order = 1) {
    let x_ast = _simp(parse_expr(x_expr));
    let y_ast = _simp(parse_expr(y_expr));
    let steps = [];
    let dxdt = _simp(_diff_ast(x_ast, t_var, steps, 0));
    let dydt = _simp(_diff_ast(y_ast, t_var, steps, 0));
    let cur = _simp(_bin("/", dydt, dxdt));
    let k = 1;
    while k < order {
        let dcur = _simp(_diff_ast(cur, t_var, steps, 0));
        cur = _simp(_bin("/", dcur, dxdt));
        k = k + 1;
    }
    return map{
        expr: format_ascii(cur, 0),
        ascii: format_ascii(cur, 0),
        unicode: format_unicode(cur, 0),
        latex: format_latex(cur, 0),
        dx_dt: format_ascii(dxdt, 0),
        dy_dt: format_ascii(dydt, 0),
        ast: cur,
        steps: steps,
        evaluate: fn(t_val) { return _eval_1d(cur, t_var, t_val); }
    };
}

// ============================================================================
// 6. Multivariable & Vector Calculus + Extrema Classifier
// ============================================================================

fn gradient(expr, vars) {
    let ast = _simp(parse_expr(expr));
    let asts = [];
    let asc = [];
    let uni = [];
    let ltx = [];
    let i = 0;
    while i < len(vars) {
        let st = [];
        let gi = _simp(_diff_ast(ast, vars[i], st, 0));
        array_push(asts, gi);
        array_push(asc, format_ascii(gi, 0));
        array_push(uni, format_unicode(gi, 0));
        array_push(ltx, format_latex(gi, 0));
        i = i + 1;
    }
    return map{
        exprs: asc,
        ascii: asc,
        unicode: uni,
        latex: ltx,
        asts: asts,
        vars: vars,
        evaluate: fn(pt) {
            let out = [];
            let j = 0;
            while j < len(asts) {
                array_push(out, _eval_point(asts[j], vars, pt));
                j = j + 1;
            }
            return out;
        }
    };
}

fn jacobian(exprs, vars) {
    let m = len(exprs);
    let n = len(vars);
    let ast_mat = [];
    let asc_mat = [];
    let uni_mat = [];
    let ltx_rows = [];
    let i = 0;
    while i < m {
        let fi = _simp(parse_expr(exprs[i]));
        let r_ast = [];
        let r_asc = [];
        let r_uni = [];
        let r_ltx = "";
        let j = 0;
        while j < n {
            let st = [];
            let df = _simp(_diff_ast(fi, vars[j], st, 0));
            array_push(r_ast, df);
            array_push(r_asc, format_ascii(df, 0));
            array_push(r_uni, format_unicode(df, 0));
            if j > 0 { r_ltx = r_ltx + " & "; }
            r_ltx = r_ltx + format_latex(df, 0);
            j = j + 1;
        }
        array_push(ast_mat, r_ast);
        array_push(asc_mat, r_asc);
        array_push(uni_mat, r_uni);
        array_push(ltx_rows, r_ltx);
        i = i + 1;
    }
    let ltx_str = "\\begin{bmatrix} ";
    let r = 0;
    while r < len(ltx_rows) {
        if r > 0 { ltx_str = ltx_str + " \\\\ "; }
        ltx_str = ltx_str + ltx_rows[r];
        r = r + 1;
    }
    ltx_str = ltx_str + " \\end{bmatrix}";
    return map{
        rows: m,
        cols: n,
        exprs: asc_mat,
        ascii: asc_mat,
        unicode: uni_mat,
        latex: ltx_str,
        asts: ast_mat,
        evaluate: fn(pt) {
            let mat = [];
            let r2 = 0;
            while r2 < m {
                let row = [];
                let c2 = 0;
                while c2 < n {
                    array_push(row, _eval_point(ast_mat[r2][c2], vars, pt));
                    c2 = c2 + 1;
                }
                array_push(mat, row);
                r2 = r2 + 1;
            }
            return mat;
        }
    };
}

fn hessian(expr, vars) {
    let g = gradient(expr, vars);
    let n = len(vars);
    let ast_mat = [];
    let asc_mat = [];
    let uni_mat = [];
    let ltx_rows = [];
    let i = 0;
    while i < n {
        let r_ast = [];
        let r_asc = [];
        let r_uni = [];
        let r_ltx = "";
        let j = 0;
        while j < n {
            let st = [];
            let hij = _simp(_diff_ast(g.asts[i], vars[j], st, 0));
            array_push(r_ast, hij);
            array_push(r_asc, format_ascii(hij, 0));
            array_push(r_uni, format_unicode(hij, 0));
            if j > 0 { r_ltx = r_ltx + " & "; }
            r_ltx = r_ltx + format_latex(hij, 0);
            j = j + 1;
        }
        array_push(ast_mat, r_ast);
        array_push(asc_mat, r_asc);
        array_push(uni_mat, r_uni);
        array_push(ltx_rows, r_ltx);
        i = i + 1;
    }
    let ltx_str = "\\begin{bmatrix} ";
    let r = 0;
    while r < len(ltx_rows) {
        if r > 0 { ltx_str = ltx_str + " \\\\ "; }
        ltx_str = ltx_str + ltx_rows[r];
        r = r + 1;
    }
    ltx_str = ltx_str + " \\end{bmatrix}";
    return map{
        dim: n,
        exprs: asc_mat,
        ascii: asc_mat,
        unicode: uni_mat,
        latex: ltx_str,
        asts: ast_mat,
        evaluate: fn(pt) {
            let mat = [];
            let r2 = 0;
            while r2 < n {
                let row = [];
                let c2 = 0;
                while c2 < n {
                    array_push(row, _eval_point(ast_mat[r2][c2], vars, pt));
                    c2 = c2 + 1;
                }
                array_push(mat, row);
                r2 = r2 + 1;
            }
            return mat;
        }
    };
}

fn divergence(vec_exprs, vars) {
    if len(vec_exprs) != len(vars) {
        throw "calculus_ode: divergence requires equal vector and variable dimensions";
    }
    let acc = _num(0);
    let i = 0;
    while i < len(vars) {
        let st = [];
        let fi = _simp(parse_expr(vec_exprs[i]));
        let dfi = _simp(_diff_ast(fi, vars[i], st, 0));
        acc = _simp(_bin("+", acc, dfi));
        i = i + 1;
    }
    return map{
        expr: format_ascii(acc, 0),
        ascii: format_ascii(acc, 0),
        unicode: format_unicode(acc, 0),
        latex: format_latex(acc, 0),
        ast: acc,
        evaluate: fn(pt) { return _eval_point(acc, vars, pt); }
    };
}

fn curl_3d(vec_exprs, vars = ["x", "y", "z"]) {
    if len(vec_exprs) != 3 or len(vars) != 3 {
        throw "calculus_ode: curl_3d requires 3 vector components and 3 variables";
    }
    let fx = _simp(parse_expr(vec_exprs[0]));
    let fy = _simp(parse_expr(vec_exprs[1]));
    let fz = _simp(parse_expr(vec_exprs[2]));
    let st = [];
    let c0 = _simp(_bin("-", _diff_ast(fz, vars[1], st, 0), _diff_ast(fy, vars[2], st, 0)));
    let c1 = _simp(_bin("-", _diff_ast(fx, vars[2], st, 0), _diff_ast(fz, vars[0], st, 0)));
    let c2 = _simp(_bin("-", _diff_ast(fy, vars[0], st, 0), _diff_ast(fx, vars[1], st, 0)));
    let asts = [c0, c1, c2];
    let asc = [format_ascii(c0, 0), format_ascii(c1, 0), format_ascii(c2, 0)];
    let uni = [format_unicode(c0, 0), format_unicode(c1, 0), format_unicode(c2, 0)];
    let ltx = [format_latex(c0, 0), format_latex(c1, 0), format_latex(c2, 0)];
    return map{
        exprs: asc,
        ascii: asc,
        unicode: uni,
        latex: ltx,
        asts: asts,
        evaluate: fn(pt) {
            return [
                _eval_point(c0, vars, pt),
                _eval_point(c1, vars, pt),
                _eval_point(c2, vars, pt)
            ];
        }
    };
}

fn laplacian(expr, vars) {
    let ast = _simp(parse_expr(expr));
    let acc = _num(0);
    let i = 0;
    while i < len(vars) {
        let st = [];
        let d1 = _simp(_diff_ast(ast, vars[i], st, 0));
        let d2 = _simp(_diff_ast(d1, vars[i], st, 0));
        acc = _simp(_bin("+", acc, d2));
        i = i + 1;
    }
    return map{
        expr: format_ascii(acc, 0),
        ascii: format_ascii(acc, 0),
        unicode: format_unicode(acc, 0),
        latex: format_latex(acc, 0),
        ast: acc,
        evaluate: fn(pt) { return _eval_point(acc, vars, pt); }
    };
}

fn directional_derivative(expr, vars, point, direction_vec) {
    if len(vars) != len(direction_vec) {
        throw "calculus_ode: direction_vec length mismatch";
    }
    let norm_sq = 0.0;
    let i = 0;
    while i < len(direction_vec) {
        norm_sq = norm_sq + direction_vec[i] * direction_vec[i];
        i = i + 1;
    }
    let norm_v = num_sqrt(norm_sq);
    if norm_v == 0.0 {
        throw "calculus_ode: direction_vec must be non-zero";
    }
    let unit_u = [];
    let j = 0;
    while j < len(direction_vec) {
        array_push(unit_u, direction_vec[j] / norm_v);
        j = j + 1;
    }
    let g = gradient(expr, vars);
    let g_pt = g.evaluate(point);
    let val = 0.0;
    let sym_acc = _num(0);
    let k = 0;
    while k < len(vars) {
        val = val + g_pt[k] * unit_u[k];
        sym_acc = _simp(_bin("+", sym_acc, _bin("*", _num(unit_u[k]), g.asts[k])));
        k = k + 1;
    }
    return map{
        value: val,
        unit_direction: unit_u,
        gradient_at_point: g_pt,
        ascii: format_ascii(sym_acc, 0),
        latex: format_latex(sym_acc, 0)
    };
}

// Dense linear solver Ax = b with partial pivoting; returns { ok, x, det }
fn _linear_solve_det(mat_a, vec_b) {
    let n = len(mat_a);
    let a = [];
    let b = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, mat_a[i][j] * 1.0);
            j = j + 1;
        }
        array_push(a, row);
        if len(vec_b) > 0 { array_push(b, vec_b[i] * 1.0); }
        else { array_push(b, 0.0); }
        i = i + 1;
    }
    let det = 1.0;
    let col = 0;
    while col < n {
        let piv = col;
        let max_v = num_abs(a[col][col]);
        let r = col + 1;
        while r < n {
            if num_abs(a[r][col]) > max_v {
                max_v = num_abs(a[r][col]);
                piv = r;
            }
            r = r + 1;
        }
        if max_v < 1e-13 {
            return map{ ok: false, x: b, det: 0.0 };
        }
        if piv != col {
            let tmp_row = a[col]; a[col] = a[piv]; a[piv] = tmp_row;
            let tmp_b = b[col]; b[col] = b[piv]; b[piv] = tmp_b;
            det = 0.0 - det;
        }
        det = det * a[col][col];
        let r2 = col + 1;
        while r2 < n {
            let factor = a[r2][col] / a[col][col];
            a[r2][col] = 0.0;
            let c2 = col + 1;
            while c2 < n {
                a[r2][c2] = a[r2][c2] - factor * a[col][c2];
                c2 = c2 + 1;
            }
            b[r2] = b[r2] - factor * b[col];
            r2 = r2 + 1;
        }
        col = col + 1;
    }
    let x = [];
    let idx = 0;
    while idx < n { array_push(x, 0.0); idx = idx + 1; }
    let row_i = n - 1;
    while row_i >= 0 {
        let s = b[row_i];
        let c3 = row_i + 1;
        while c3 < n {
            s = s - a[row_i][c3] * x[c3];
            c3 = c3 + 1;
        }
        x[row_i] = s / a[row_i][row_i];
        row_i = row_i - 1;
    }
    return map{ ok: true, x: x, det: det };
}

fn _sylvester_minors(mat) {
    let n = len(mat);
    let minors = [];
    let k = 1;
    while k <= n {
        let sub = [];
        let r = 0;
        while r < k {
            let row = [];
            let c = 0;
            while c < k {
                array_push(row, mat[r][c]);
                c = c + 1;
            }
            array_push(sub, row);
            r = r + 1;
        }
        let dummy = [];
        let z = 0;
        while z < k { array_push(dummy, 0.0); z = z + 1; }
        let res = _linear_solve_det(sub, dummy);
        array_push(minors, res.det);
        k = k + 1;
    }
    return minors;
}

// Symmetric Jacobi eigenvalue algorithm for exact Hessian eigenvalues
fn _sym_eigenvalues(mat) {
    let n = len(mat);
    if n == 1 { return [mat[0][0] * 1.0]; }
    let a = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, mat[i][j] * 1.0);
            j = j + 1;
        }
        array_push(a, row);
        i = i + 1;
    }
    let iter = 0;
    while iter < 120 {
        let p = 0;
        let q = 1;
        let max_off = 0.0;
        let r = 0;
        while r < n {
            let c = r + 1;
            while c < n {
                if num_abs(a[r][c]) > max_off {
                    max_off = num_abs(a[r][c]);
                    p = r;
                    q = c;
                }
                c = c + 1;
            }
            r = r + 1;
        }
        if max_off < 1e-13 { break; }
        let app = a[p][p];
        let aqq = a[q][q];
        let apq = a[p][q];
        let theta = 0.5 * num_atan2(2.0 * apq, aqq - app);
        let cs = num_cos(theta);
        let sn = num_sin(theta);
        let k = 0;
        while k < n {
            if k != p and k != q {
                let akp = a[k][p];
                let akq = a[k][q];
                a[k][p] = cs * akp - sn * akq;
                a[p][k] = a[k][p];
                a[k][q] = sn * akp + cs * akq;
                a[q][k] = a[k][q];
            }
            k = k + 1;
        }
        a[p][p] = cs * cs * app - 2.0 * sn * cs * apq + sn * sn * aqq;
        a[q][q] = sn * sn * app + 2.0 * sn * cs * apq + cs * cs * aqq;
        a[p][q] = 0.0;
        a[q][p] = 0.0;
        iter = iter + 1;
    }
    let eig = [];
    let d = 0;
    while d < n {
        array_push(eig, _snap_num(a[d][d]));
        d = d + 1;
    }
    return eig;
}

fn find_and_classify_extrema(expr, vars, initial_guesses) {
    let f_ast = _simp(parse_expr(expr));
    let grad_obj = gradient(f_ast, vars);
    let hess_obj = hessian(f_ast, vars);
    let n = len(vars);

    let guesses = initial_guesses;
    if len(guesses) > 0 and type(guesses[0]) == "number" {
        guesses = [guesses];
    }

    let found = [];
    let gi = 0;
    while gi < len(guesses) {
        let x = [];
        let c = 0;
        while c < n {
            array_push(x, guesses[gi][c] * 1.0);
            c = c + 1;
        }
        let step_i = 0;
        let converged = false;
        while step_i < 80 {
            let g = grad_obj.evaluate(x);
            let gnorm_sq = 0.0;
            let k = 0;
            while k < n { gnorm_sq = gnorm_sq + g[k] * g[k]; k = k + 1; }
            if num_sqrt(gnorm_sq) < 1e-10 {
                converged = true;
                break;
            }
            let hmat = hess_obj.evaluate(x);
            let neg_g = [];
            let k2 = 0;
            while k2 < n { array_push(neg_g, 0.0 - g[k2]); k2 = k2 + 1; }
            let sol = _linear_solve_det(hmat, neg_g);
            if not sol.ok {
                break;
            }
            // Damped Newton step if step is huge
            let dx = sol.x;
            let dnorm = 0.0;
            let k3 = 0;
            while k3 < n { dnorm = dnorm + dx[k3] * dx[k3]; k3 = k3 + 1; }
            dnorm = num_sqrt(dnorm);
            let alpha = if dnorm > 5.0 { 5.0 / dnorm } else { 1.0 };
            let k4 = 0;
            while k4 < n {
                x[k4] = x[k4] + alpha * dx[k4];
                k4 = k4 + 1;
            }
            step_i = step_i + 1;
        }
        let g_end = grad_obj.evaluate(x);
        let gnorm = 0.0;
        let m = 0;
        while m < n { gnorm = gnorm + g_end[m] * g_end[m]; m = m + 1; }
        gnorm = num_sqrt(gnorm);

        if converged or gnorm < 1e-7 {
            let clean_pt = [];
            let m2 = 0;
            while m2 < n { array_push(clean_pt, _snap_num(x[m2])); m2 = m2 + 1; }

            // Deduplicate against already found points
            let is_dup = false;
            let fi = 0;
            while fi < len(found) {
                let dist = 0.0;
                let m3 = 0;
                while m3 < n {
                    let df = found[fi].point[m3] - clean_pt[m3];
                    dist = dist + df * df;
                    m3 = m3 + 1;
                }
                if num_sqrt(dist) < 1e-5 { is_dup = true; break; }
                fi = fi + 1;
            }

            if not is_dup {
                let h_at = hess_obj.evaluate(clean_pt);
                let eigs = _sym_eigenvalues(h_at);
                let minors = _sylvester_minors(h_at);
                let n_pos = 0;
                let n_neg = 0;
                let n_zero = 0;
                let ei = 0;
                while ei < len(eigs) {
                    if eigs[ei] > 1e-7 { n_pos = n_pos + 1; }
                    else if eigs[ei] < -1e-7 { n_neg = n_neg + 1; }
                    else { n_zero = n_zero + 1; }
                    ei = ei + 1;
                }
                let cls = "degenerate";
                if n_zero == 0 {
                    if n_pos == n { cls = "local_min"; }
                    else if n_neg == n { cls = "local_max"; }
                    else { cls = "saddle_point"; }
                }
                array_push(found, map{
                    point: clean_pt,
                    value: _snap_num(_eval_point(f_ast, vars, clean_pt)),
                    classification: cls,
                    eigenvalues: eigs,
                    sylvester_minors: minors,
                    grad_norm: gnorm
                });
            }
        }
        gi = gi + 1;
    }

    return map{
        points: found,
        gradient_ascii: grad_obj.ascii,
        hessian_ascii: hess_obj.ascii
    };
}

// ============================================================================
// 7. Polynomial & Linear Pattern Helpers for Symbolic Integration / Limits / ODE
// ============================================================================

// Match linear form a*x + b where a, b are independent of var_name (numeric constants)
fn _match_linear(node, var_name) {
    let s = _simp(node);
    if not _depends_on(s, var_name, 0) {
        let b_val = try _eval_ast(s, map{}, 0) catch _nan_val();
        if _is_finite(b_val) {
            return map{ ok: true, a: 0.0, b: _snap_num(b_val), a_ast: _num(0), b_ast: s };
        }
        return map{ ok: false };
    }
    let st = [];
    let d1 = _simp(_diff_ast(s, var_name, st, 0));
    if _depends_on(d1, var_name, 0) {
        return map{ ok: false };
    }
    let a_val = try _eval_ast(d1, map{}, 0) catch _nan_val();
    if not _is_finite(a_val) { return map{ ok: false }; }
    let b_ast = _simp(_subst_ast(s, var_name, _num(0), 0));
    if _depends_on(b_ast, var_name, 0) { return map{ ok: false }; }
    let b_val = try _eval_ast(b_ast, map{}, 0) catch _nan_val();
    if not _is_finite(b_val) { return map{ ok: false }; }
    // Verify linearity at two test points (guards against piecewise or non-polynomial functions)
    let v1 = _eval_1d(s, var_name, 1.37);
    let v2 = _eval_1d(s, var_name, -0.83);
    if not _is_finite(v1) or not _is_finite(v2) { return map{ ok: false }; }
    if num_abs(v1 - (a_val * 1.37 + b_val)) > 1e-9 or num_abs(v2 - (a_val * (-0.83) + b_val)) > 1e-9 {
        return map{ ok: false };
    }
    return map{ ok: true, a: _snap_num(a_val), b: _snap_num(b_val), a_ast: d1, b_ast: b_ast };
}

fn _poly_add_c(a, b) {
    let na = len(a);
    let nb = len(b);
    let n = if na > nb { na } else { nb };
    let out = [];
    let i = 0;
    while i < n {
        let va = if i < na { a[i] } else { 0.0 };
        let vb = if i < nb { b[i] } else { 0.0 };
        array_push(out, va + vb);
        i = i + 1;
    }
    return out;
}

fn _poly_sub_c(a, b) {
    let na = len(a);
    let nb = len(b);
    let n = if na > nb { na } else { nb };
    let out = [];
    let i = 0;
    while i < n {
        let va = if i < na { a[i] } else { 0.0 };
        let vb = if i < nb { b[i] } else { 0.0 };
        array_push(out, va - vb);
        i = i + 1;
    }
    return out;
}

fn _poly_mul_c(a, b, max_deg) {
    let da = len(a) - 1;
    while da > 0 and _near_zero(a[da]) { da = da - 1; }
    let db = len(b) - 1;
    while db > 0 and _near_zero(b[db]) { db = db - 1; }
    if da + db > max_deg { return nil; }
    let out = [];
    let k = 0;
    while k <= da + db { array_push(out, 0.0); k = k + 1; }
    let i = 0;
    while i <= da {
        let j = 0;
        while j <= db {
            out[i + j] = out[i + j] + a[i] * b[j];
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _extract_poly_rec(node, var_name, max_deg, depth) {
    if depth > MAX_DEPTH { return nil; }
    if not _depends_on(node, var_name, 0) {
        let cv = try _eval_ast(node, map{}, 0) catch _nan_val();
        if not _is_finite(cv) { return nil; }
        return [_snap_num(cv)];
    }
    let k = node.kind;
    if k == "sym" {
        if node.name == var_name { return [0.0, 1.0]; }
        return nil;
    }
    if k == "neg" {
        let sub = _extract_poly_rec(node.arg, var_name, max_deg, depth + 1);
        if sub == nil { return nil; }
        let out = [];
        let i = 0;
        while i < len(sub) { array_push(out, 0.0 - sub[i]); i = i + 1; }
        return out;
    }
    if k == "bin" {
        let op = node.op;
        if op == "+" {
            let pl = _extract_poly_rec(node.left, var_name, max_deg, depth + 1);
            if pl == nil { return nil; }
            let pr = _extract_poly_rec(node.right, var_name, max_deg, depth + 1);
            if pr == nil { return nil; }
            return _poly_add_c(pl, pr);
        }
        if op == "-" {
            let pl = _extract_poly_rec(node.left, var_name, max_deg, depth + 1);
            if pl == nil { return nil; }
            let pr = _extract_poly_rec(node.right, var_name, max_deg, depth + 1);
            if pr == nil { return nil; }
            return _poly_sub_c(pl, pr);
        }
        if op == "*" {
            let pl = _extract_poly_rec(node.left, var_name, max_deg, depth + 1);
            if pl == nil { return nil; }
            let pr = _extract_poly_rec(node.right, var_name, max_deg, depth + 1);
            if pr == nil { return nil; }
            return _poly_mul_c(pl, pr, max_deg);
        }
        if op == "/" {
            if _depends_on(node.right, var_name, 0) { return nil; }
            let dv = try _eval_ast(node.right, map{}, 0) catch _nan_val();
            if not _is_finite(dv) or _near_zero(dv) { return nil; }
            let pl = _extract_poly_rec(node.left, var_name, max_deg, depth + 1);
            if pl == nil { return nil; }
            let out = [];
            let i = 0;
            while i < len(pl) { array_push(out, pl[i] / dv); i = i + 1; }
            return out;
        }
        if op == "^" {
            if _depends_on(node.right, var_name, 0) { return nil; }
            let ev = try _eval_ast(node.right, map{}, 0) catch _nan_val();
            if not _is_int_val(ev) { return nil; }
            let exp_i = num_round(ev);
            if exp_i < 0 or exp_i > max_deg { return nil; }
            if exp_i == 0 { return [1.0]; }
            let pb = _extract_poly_rec(node.left, var_name, max_deg, depth + 1);
            if pb == nil { return nil; }
            let acc = [1.0];
            let step = 0;
            while step < exp_i {
                acc = _poly_mul_c(acc, pb, max_deg);
                if acc == nil { return nil; }
                step = step + 1;
            }
            return acc;
        }
    }
    return nil;
}

// Extract numeric polynomial coefficients [c0, c1, ..., cd] up to max_deg in var_name
fn _extract_poly(node, var_name, max_deg = 8) {
    let cur = _simp(node);
    let raw = _extract_poly_rec(cur, var_name, max_deg, 0);
    if raw == nil or len(raw) == 0 {
        return map{ ok: false };
    }
    let coeffs = [];
    let i = 0;
    while i < len(raw) {
        array_push(coeffs, _snap_num(raw[i]));
        i = i + 1;
    }
    let deg = len(coeffs) - 1;
    while deg > 0 and _near_zero(coeffs[deg]) {
        let _ = pop(coeffs);
        deg = deg - 1;
    }
    if deg > max_deg {
        return map{ ok: false };
    }
    return map{ ok: true, coeffs: coeffs, deg: deg };
}

fn _poly_coeffs_to_ast(coeffs, var_name, center = 0.0) {
    let terms = [];
    let k = 0;
    while k < len(coeffs) {
        let c = _snap_num(coeffs[k]);
        if not _near_zero(c) {
            let base = if _near_zero(center) { _sym(var_name) } else { _simp(_bin("-", _sym(var_name), _num(center))) };
            let xpow = if k == 0 { _num(1) } else if k == 1 { base } else { _bin("^", base, _num(k)) };
            let c_ast = _num_or_simple_rat(c);
            array_push(terms, _simp(_bin("*", c_ast, xpow)));
        }
        k = k + 1;
    }
    if len(terms) == 0 { return _num(0); }
    let acc = terms[0];
    let i = 1;
    while i < len(terms) {
        acc = _simp(_bin("+", acc, terms[i]));
        i = i + 1;
    }
    return _simp(acc);
}

// Convert clean decimals like 0.5 -> 1/2, -0.25 -> -1/4 when exact small denominator <= 720
fn _num_or_simple_rat(x) {
    let sx = _snap_num(x);
    if _is_int_val(sx) {
        let iv = num_round(sx);
        if iv < 0 { return _neg(_num(0 - iv)); }
        return _num(iv);
    }
    // Continued fraction / small denominator search up to q = 720
    let sign = if sx < 0 { -1 } else { 1 };
    let ax = num_abs(sx);
    let q = 2;
    while q <= 720 {
        let p = num_round(ax * q);
        if num_abs(ax - (p * 1.0) / (q * 1.0)) < 1e-12 {
            return _rational_to_ast(sign * p, q);
        }
        q = q + 1;
    }
    if sx < 0 { return _neg(_num(0.0 - sx)); }
    return _num(sx);
}

// Polynomial long division N(x) / D(x) -> { q_coeffs, r_coeffs }
fn _poly_divmod(num_c, den_c) {
    let rem = [];
    let i = 0;
    while i < len(num_c) { array_push(rem, num_c[i] * 1.0); i = i + 1; }
    let d_deg = len(den_c) - 1;
    while d_deg > 0 and _near_zero(den_c[d_deg]) { d_deg = d_deg - 1; }
    let lead_d = den_c[d_deg];
    if len(rem) - 1 < d_deg {
        return map{ q: [0.0], r: rem };
    }
    let q_len = len(rem) - d_deg;
    let quot = [];
    let j = 0;
    while j < q_len { array_push(quot, 0.0); j = j + 1; }
    let k = len(rem) - 1;
    while k >= d_deg {
        let coeff = rem[k] / lead_d;
        let q_idx = k - d_deg;
        quot[q_idx] = coeff;
        let m = 0;
        while m <= d_deg {
            rem[q_idx + m] = rem[q_idx + m] - coeff * den_c[m];
            m = m + 1;
        }
        k = k - 1;
    }
    while len(rem) > 1 and _near_zero(rem[len(rem) - 1]) {
        let _ = pop(rem);
    }
    return map{ q: quot, r: rem };
}

// Check if expr_a / expr_b is a non-zero constant independent of var_name
fn _const_ratio(expr_a, expr_b, var_name) {
    let ratio = _simp(_bin("/", expr_a, expr_b));
    if not _depends_on(ratio, var_name, 0) {
        let v = try _eval_ast(ratio, map{}, 0) catch _nan_val();
        if _is_finite(v) and not _near_zero(v) {
            return map{ ok: true, k_ast: _num_or_simple_rat(v), k_val: v };
        }
    }
    // Numerical constancy probe for trig/algebraic identities where AST doesn't cancel directly
    let pts = [0.31, 0.77, 1.23, 1.69];
    let vals = [];
    let i = 0;
    while i < len(pts) {
        let va = _eval_1d(expr_a, var_name, pts[i]);
        let vb = _eval_1d(expr_b, var_name, pts[i]);
        if _is_finite(va) and _is_finite(vb) and num_abs(vb) > 1e-9 {
            array_push(vals, va / vb);
        }
        i = i + 1;
    }
    if len(vals) >= 3 {
        let c0 = vals[0];
        if not _near_zero(c0) {
            let same = true;
            let j = 1;
            while j < len(vals) {
                if num_abs(vals[j] - c0) > 1e-9 * (1.0 + num_abs(c0)) {
                    same = false;
                    break;
                }
                j = j + 1;
            }
            if same {
                return map{ ok: true, k_ast: _num_or_simple_rat(c0), k_val: c0 };
            }
        }
    }
    return map{ ok: false };
}

fn _is_identically_zero_1d(node, var_name) {
    let s = _simp(node);
    if _is_num_eq(s, 0) { return true; }
    if not _depends_on(s, var_name, 0) {
        let cv = try _eval_ast(s, map{}, 0) catch _nan_val();
        return _is_finite(cv) and num_abs(cv) < 1e-11;
    }
    let pts = [0.23, 0.61, 1.13, 1.79, -0.47, -1.19];
    let valid = 0;
    let i = 0;
    while i < len(pts) {
        let y = _eval_1d(s, var_name, pts[i]);
        if _is_finite(y) {
            if num_abs(y) > 1e-10 { return false; }
            valid = valid + 1;
        }
        i = i + 1;
    }
    return valid >= 3;
}

// ============================================================================
// 8. Transcendental Risch-Bronstein-Liouville Symbolic Integration Engine
// ============================================================================

let _SPECIAL_FUNC_SET = map{
    "erf": true, "erfc": true, "erfi": true,
    "Ei": true, "li": true, "Si": true, "Ci": true,
    "FresnelS": true, "FresnelC": true, "Li2": true, "lambertw": true
};

fn _uses_special_func(node, depth = 0) {
    if depth > MAX_DEPTH { return false; }
    let k = node.kind;
    if k == "num" or k == "sym" { return false; }
    if k == "neg" { return _uses_special_func(node.arg, depth + 1); }
    if k == "bin" {
        return _uses_special_func(node.left, depth + 1) or _uses_special_func(node.right, depth + 1);
    }
    if k == "call" {
        if map_has(_SPECIAL_FUNC_SET, node.name) { return true; }
        let i = 0;
        while i < len(node.args) {
            if _uses_special_func(node.args[i], depth + 1) { return true; }
            i = i + 1;
        }
    }
    return false;
}

fn _exact_sqrt_ast(val) {
    let sv = _snap_num(val);
    let rt = num_sqrt(sv);
    if _is_int_val(rt) {
        return _num(num_round(rt));
    }
    return _simp(_call("sqrt", [_num_or_simple_rat(sv)]));
}

fn _poly_max_abs(p) {
    let m = 0.0;
    let i = 0;
    while i < len(p) {
        let a = num_abs(p[i]);
        if a > m { m = a; }
        i = i + 1;
    }
    return m;
}

fn _poly_trim_tol(p, tol = 1e-10) {
    let out = [];
    let i = 0;
    while i < len(p) {
        let c = if num_abs(p[i]) <= tol { 0.0 } else { _snap_num(p[i]) };
        array_push(out, c);
        i = i + 1;
    }
    while len(out) > 1 and num_abs(out[len(out) - 1]) <= tol {
        let _ = pop(out);
    }
    if len(out) == 0 { return [0.0]; }
    return out;
}

fn _poly_is_zero_c(p) {
    let tp = _poly_trim_tol(p, 1e-10);
    return len(tp) == 1 and num_abs(tp[0]) <= 1e-10;
}

fn _poly_deg_c(p) {
    let tp = _poly_trim_tol(p, 1e-10);
    return len(tp) - 1;
}

fn _poly_scale_c(p, s) {
    let out = [];
    let i = 0;
    while i < len(p) {
        array_push(out, p[i] * s);
        i = i + 1;
    }
    return _poly_trim_tol(out, 1e-11);
}

fn _poly_monic_c(p) {
    let tp = _poly_trim_tol(p, 1e-10);
    let lead = tp[len(tp) - 1];
    if num_abs(lead) <= 1e-12 { return [0.0]; }
    return _poly_scale_c(tp, 1.0 / lead);
}

fn _poly_diff_c(p) {
    if len(p) <= 1 { return [0.0]; }
    let out = [];
    let i = 1;
    while i < len(p) {
        array_push(out, p[i] * (i * 1.0));
        i = i + 1;
    }
    return _poly_trim_tol(out, 1e-11);
}

fn _poly_eval_real(p, xv) {
    let acc = 0.0;
    let i = len(p) - 1;
    while i >= 0 {
        acc = acc * xv + p[i];
        i = i - 1;
    }
    return acc;
}

fn _poly_eval_complex(p, z) {
    let acc = _c_make(0.0, 0.0);
    let i = len(p) - 1;
    while i >= 0 {
        acc = _c_add(_c_mul(acc, z), _c_make(p[i], 0.0));
        i = i - 1;
    }
    return acc;
}

fn _poly_gcd_c(a_in, b_in) {
    let r0 = _poly_trim_tol(a_in, 1e-10);
    let r1 = _poly_trim_tol(b_in, 1e-10);
    if _poly_is_zero_c(r0) { return _poly_monic_c(r1); }
    if _poly_is_zero_c(r1) { return _poly_monic_c(r0); }
    let guard = 0;
    while not _poly_is_zero_c(r1) and guard < 40 {
        let scale0 = 1.0 + _poly_max_abs(r0);
        let dm = _poly_divmod(r0, r1);
        let r2 = _poly_trim_tol(dm.r, 1e-9 * scale0);
        r0 = _poly_monic_c(r1);
        r1 = r2;
        guard = guard + 1;
    }
    return _poly_monic_c(r0);
}

// Extended polynomial GCD: returns { g, u, v } with u*a + v*b == g (g monic)
fn _poly_ext_gcd_c(a_in, b_in) {
    let r0 = _poly_trim_tol(a_in, 1e-11);
    let r1 = _poly_trim_tol(b_in, 1e-11);
    let s0 = [1.0];
    let s1 = [0.0];
    let t0 = [0.0];
    let t1 = [1.0];
    let guard = 0;
    while not _poly_is_zero_c(r1) and guard < 40 {
        let scale0 = 1.0 + _poly_max_abs(r0);
        let dm = _poly_divmod(r0, r1);
        let q = dm.q;
        let r2 = _poly_trim_tol(dm.r, 1e-9 * scale0);
        let qs1 = _poly_mul_c(q, s1, 64);
        let qt1 = _poly_mul_c(q, t1, 64);
        let s2 = _poly_trim_tol(_poly_sub_c(s0, qs1), 1e-11);
        let t2 = _poly_trim_tol(_poly_sub_c(t0, qt1), 1e-11);
        r0 = r1; r1 = r2;
        s0 = s1; s1 = s2;
        t0 = t1; t1 = t2;
        guard = guard + 1;
    }
    let lead = r0[len(r0) - 1];
    if num_abs(lead) <= 1e-12 {
        return map{ g: [1.0], u: [0.0], v: [0.0] };
    }
    return map{
        g: _poly_scale_c(r0, 1.0 / lead),
        u: _poly_scale_c(s0, 1.0 / lead),
        v: _poly_scale_c(t0, 1.0 / lead)
    };
}

// Square-free decomposition of monic polynomial P(x) = prod_{k=1}^m F_k(x)^k (returns [F_1, ..., F_m])
fn _poly_sqfree_factors(p_monic) {
    let p = _poly_monic_c(p_monic);
    if _poly_deg_c(p) == 0 { return [[1.0]]; }
    let g = _poly_gcd_c(p, _poly_diff_c(p));
    let w = _poly_monic_c(_poly_divmod(p, g).q);
    let factors = [];
    let guard = 0;
    while _poly_deg_c(g) > 0 and guard < 24 {
        let y = _poly_gcd_c(w, g);
        let fk = _poly_monic_c(_poly_divmod(w, y).q);
        array_push(factors, fk);
        w = y;
        g = _poly_monic_c(_poly_divmod(g, y).q);
        guard = guard + 1;
    }
    array_push(factors, _poly_monic_c(w));
    return factors;
}

// Extract rational function N(x)/D(x) in var_name from arbitrary rational AST
fn _extract_rational_poly_rec(node, var_name, max_deg, depth) {
    if depth > MAX_DEPTH { return nil; }
    let p_direct = _extract_poly(node, var_name, max_deg);
    if p_direct.ok {
        return map{ n: p_direct.coeffs, d: [1.0] };
    }
    if node.kind == "neg" {
        let sub = _extract_rational_poly_rec(node.arg, var_name, max_deg, depth + 1);
        if sub == nil { return nil; }
        return map{ n: _poly_scale_c(sub.n, -1.0), d: sub.d };
    }
    if node.kind == "bin" {
        let op = node.op;
        if op == "+" or op == "-" {
            let rl = _extract_rational_poly_rec(node.left, var_name, max_deg, depth + 1);
            if rl == nil { return nil; }
            let rr = _extract_rational_poly_rec(node.right, var_name, max_deg, depth + 1);
            if rr == nil { return nil; }
            let t1 = _poly_mul_c(rl.n, rr.d, max_deg * 2);
            let t2 = _poly_mul_c(rr.n, rl.d, max_deg * 2);
            let dd = _poly_mul_c(rl.d, rr.d, max_deg * 2);
            if t1 == nil or t2 == nil or dd == nil { return nil; }
            let nn = if op == "+" { _poly_add_c(t1, t2) } else { _poly_sub_c(t1, t2) };
            let g = _poly_gcd_c(nn, dd);
            if _poly_deg_c(g) > 0 {
                nn = _poly_divmod(nn, g).q;
                dd = _poly_divmod(dd, g).q;
            }
            if _poly_deg_c(nn) > max_deg or _poly_deg_c(dd) > max_deg { return nil; }
            return map{ n: _poly_trim_tol(nn, 1e-11), d: _poly_trim_tol(dd, 1e-11) };
        }
        if op == "*" or op == "/" {
            let rl = _extract_rational_poly_rec(node.left, var_name, max_deg, depth + 1);
            if rl == nil { return nil; }
            let rr = _extract_rational_poly_rec(node.right, var_name, max_deg, depth + 1);
            if rr == nil { return nil; }
            let r_num = if op == "*" { rr.n } else { rr.d };
            let r_den = if op == "*" { rr.d } else { rr.n };
            if _poly_is_zero_c(r_den) { return nil; }
            let nn = _poly_mul_c(rl.n, r_num, max_deg * 2);
            let dd = _poly_mul_c(rl.d, r_den, max_deg * 2);
            if nn == nil or dd == nil { return nil; }
            let g = _poly_gcd_c(nn, dd);
            if _poly_deg_c(g) > 0 {
                nn = _poly_divmod(nn, g).q;
                dd = _poly_divmod(dd, g).q;
            }
            if _poly_deg_c(nn) > max_deg or _poly_deg_c(dd) > max_deg { return nil; }
            return map{ n: _poly_trim_tol(nn, 1e-11), d: _poly_trim_tol(dd, 1e-11) };
        }
        if op == "^" and not _depends_on(node.right, var_name, 0) {
            let ev = try _eval_ast(node.right, map{}, 0) catch _nan_val();
            if not _is_int_val(ev) { return nil; }
            let ei = num_round(ev);
            if num_abs(ei) > max_deg { return nil; }
            if ei == 0 { return map{ n: [1.0], d: [1.0] }; }
            let rb = _extract_rational_poly_rec(node.left, var_name, max_deg, depth + 1);
            if rb == nil { return nil; }
            let base_n = if ei > 0 { rb.n } else { rb.d };
            let base_d = if ei > 0 { rb.d } else { rb.n };
            if _poly_is_zero_c(base_d) { return nil; }
            let p_abs = num_round(num_abs(ei));
            let an = [1.0];
            let ad = [1.0];
            let k = 0;
            while k < p_abs {
                an = _poly_mul_c(an, base_n, max_deg);
                ad = _poly_mul_c(ad, base_d, max_deg);
                if an == nil or ad == nil { return nil; }
                k = k + 1;
            }
            return map{ n: _poly_trim_tol(an, 1e-11), d: _poly_trim_tol(ad, 1e-11) };
        }
    }
    return nil;
}

fn _extract_rational_poly(node, var_name, max_deg = 16) {
    let raw = _extract_rational_poly_rec(_simp(node), var_name, max_deg, 0);
    if raw == nil or _poly_is_zero_c(raw.d) {
        return map{ ok: false };
    }
    let lead_d = raw.d[len(raw.d) - 1];
    let n_c = _poly_scale_c(raw.n, 1.0 / lead_d);
    let d_c = _poly_scale_c(raw.d, 1.0 / lead_d);
    let g = _poly_gcd_c(n_c, d_c);
    if _poly_deg_c(g) > 0 {
        n_c = _poly_trim_tol(_poly_divmod(n_c, g).q, 1e-11);
        d_c = _poly_monic_c(_poly_divmod(d_c, g).q);
    }
    return map{ ok: true, num_c: n_c, den_c: d_c };
}

// Find all real & complex roots of a monic square-free polynomial S(x) via Durand-Kerner + complex Newton polish
fn _poly_sqfree_roots(s_monic) {
    let d = _poly_deg_c(s_monic);
    if d <= 0 { return map{ ok: true, real_roots: [], complex_upper: [] }; }
    if d == 1 {
        return map{ ok: true, real_roots: [_snap_num(0.0 - s_monic[0])], complex_upper: [] };
    }
    if d == 2 {
        let b = s_monic[1];
        let c = s_monic[0];
        let disc = b * b - 4.0 * c;
        if disc >= -1e-12 {
            let sq = if disc > 0.0 { num_sqrt(disc) } else { 0.0 };
            return map{
                ok: true,
                real_roots: [_snap_num((-0.5) * (b - sq)), _snap_num((-0.5) * (b + sq))],
                complex_upper: []
            };
        }
        return map{
            ok: true,
            real_roots: [],
            complex_upper: [_c_make(-0.5 * b, 0.5 * num_sqrt(0.0 - disc))]
        };
    }

    let radius = 1.0 + _poly_max_abs(s_monic);
    let roots = [];
    let k = 0;
    while k < d {
        let ang = (2.0 * PI * k) / (d * 1.0) + 0.3719;
        let rk = radius * (0.65 + 0.35 * ((k * 1.0) / (d * 1.0)));
        array_push(roots, _c_make(rk * num_cos(ang), rk * num_sin(ang)));
        k = k + 1;
    }

    let iter = 0;
    while iter < 80 {
        let max_step = 0.0;
        let i = 0;
        while i < d {
            let zi = roots[i];
            let pval = _poly_eval_complex(s_monic, zi);
            let denom = _c_make(1.0, 0.0);
            let j = 0;
            while j < d {
                if j != i {
                    let diff_z = _c_sub(zi, roots[j]);
                    if num_abs(diff_z.re) + num_abs(diff_z.im) < 1e-14 {
                        diff_z = _c_make(1e-7, 1e-7);
                    }
                    denom = _c_mul(denom, diff_z);
                }
                j = j + 1;
            }
            let delta = _c_div(pval, denom);
            roots[i] = _c_sub(zi, delta);
            let step_sz = num_abs(delta.re) + num_abs(delta.im);
            if step_sz > max_step { max_step = step_sz; }
            i = i + 1;
        }
        if max_step < 1e-14 { break; }
        iter = iter + 1;
    }

    // Complex Newton polish on simple roots
    let sp = _poly_diff_c(s_monic);
    let i = 0;
    while i < d {
        let zi = roots[i];
        let n_it = 0;
        while n_it < 8 {
            let fv = _poly_eval_complex(s_monic, zi);
            let dfv = _poly_eval_complex(sp, zi);
            if num_abs(dfv.re) + num_abs(dfv.im) < 1e-14 { break; }
            let dz = _c_div(fv, dfv);
            zi = _c_sub(zi, dz);
            if num_abs(dz.re) + num_abs(dz.im) < 1e-15 { break; }
            n_it = n_it + 1;
        }
        let res_chk = _poly_eval_complex(s_monic, zi);
        if num_abs(res_chk.re) + num_abs(res_chk.im) > 1e-6 * (1.0 + _poly_max_abs(s_monic)) {
            return map{ ok: false, real_roots: [], complex_upper: [] };
        }
        roots[i] = zi;
        i = i + 1;
    }

    let real_r = [];
    let comp_up = [];
    let m = 0;
    while m < d {
        let zm = roots[m];
        if num_abs(zm.im) < 1e-7 {
            array_push(real_r, _snap_num(zm.re));
        } else if zm.im >= 1e-7 {
            array_push(comp_up, _c_make(_snap_num(zm.re), _snap_num(zm.im)));
        }
        m = m + 1;
    }
    return map{ ok: true, real_roots: real_r, complex_upper: comp_up };
}

fn _int_rational_quad(A_val, B_val, a_val, b_val, c_val, v) {
    // Integrates (A*x + B) / (a*x^2 + b*x + c)
    let x = _sym(v);
    let denom_poly = _simp(_bin("+", _bin("+", _bin("*", _num_or_simple_rat(a_val), _bin("^", x, _num(2))), _bin("*", _num_or_simple_rat(b_val), x)), _num_or_simple_rat(c_val)));
    let res = _num(0);

    // Part 1: (A / (2a)) * ln|a*x^2 + b*x + c|
    if not _near_zero(A_val) {
        let coeff1 = _num_or_simple_rat(A_val / (2.0 * a_val));
        let pos_def = a_val > 0.0 and (b_val * b_val - 4.0 * a_val * c_val) < -1e-11;
        let ln_arg = if pos_def { denom_poly } else { _call("abs", [denom_poly]) };
        res = _simp(_bin("+", res, _bin("*", coeff1, _call("ln", [ln_arg]))));
    }

    // Part 2: K * ∫ 1 / (a*x^2 + b*x + c) dx where K = B - A*b/(2a)
    let K_val = B_val - (A_val * b_val) / (2.0 * a_val);
    if not _near_zero(K_val) {
        let disc = b_val * b_val - 4.0 * a_val * c_val;
        if num_abs(disc) < 1e-11 {
            let lin = _simp(_bin("+", _bin("*", _num_or_simple_rat(a_val), x), _num_or_simple_rat(b_val / 2.0)));
            let term2 = _simp(_bin("/", _num_or_simple_rat(0.0 - K_val), lin));
            res = _simp(_bin("+", res, term2));
        } else if disc < 0.0 {
            let s = num_sqrt(0.0 - disc);
            if _near_zero(b_val) and a_val > 0.0 and c_val > 0.0 {
                let m = num_sqrt(c_val / a_val);
                let coeff2 = _num_or_simple_rat(K_val / (a_val * m));
                let arg = _simp(_bin("/", x, _num_or_simple_rat(m)));
                res = _simp(_bin("+", res, _bin("*", coeff2, _call("atan", [arg]))));
            } else {
                let coeff2 = _num_or_simple_rat((2.0 * K_val) / s);
                let num_arg = _simp(_bin("+", _bin("*", _num_or_simple_rat(2.0 * a_val), x), _num_or_simple_rat(b_val)));
                let arg = _simp(_bin("/", num_arg, _num_or_simple_rat(s)));
                res = _simp(_bin("+", res, _bin("*", coeff2, _call("atan", [arg]))));
            }
        } else {
            let q = num_sqrt(disc);
            let r1 = (0.0 - b_val + q) / (2.0 * a_val);
            let r2 = (0.0 - b_val - q) / (2.0 * a_val);
            let coeff2 = _num_or_simple_rat(K_val / q);
            let numer_f = _simp(_bin("-", x, _num_or_simple_rat(r1)));
            let denom_f = _simp(_bin("-", x, _num_or_simple_rat(r2)));
            let ratio_f = _simp(_bin("/", numer_f, denom_f));
            res = _simp(_bin("+", res, _bin("*", coeff2, _call("ln", [_call("abs", [ratio_f])]))));
        }
    }
    return res;
}

// Hermite Reduction + Rothstein-Trager Algebraic/Logarithmic Part for arbitrary P(x)/Q(x)
fn _int_rational_hermite(num_in, den_in, v) {
    if _poly_is_zero_c(den_in) { return map{ ok: false }; }
    if _poly_is_zero_c(num_in) { return map{ ok: true, ast: _num(0) }; }

    let lead_d = den_in[len(den_in) - 1];
    let P = _poly_scale_c(num_in, 1.0 / lead_d);
    let Q = _poly_scale_c(den_in, 1.0 / lead_d);
    let g_pq = _poly_gcd_c(P, Q);
    if _poly_deg_c(g_pq) > 0 {
        P = _poly_trim_tol(_poly_divmod(P, g_pq).q, 1e-11);
        Q = _poly_monic_c(_poly_divmod(Q, g_pq).q);
    }

    let dm = _poly_divmod(P, Q);
    let S_quot = dm.q;
    let A = _poly_trim_tol(dm.r, 1e-11);

    // Integrate polynomial quotient S_quot(x)
    let poly_int_c = [0.0];
    let idx = 0;
    while idx < len(S_quot) {
        array_push(poly_int_c, S_quot[idx] / ((idx + 1) * 1.0));
        idx = idx + 1;
    }
    let total_ast = _poly_coeffs_to_ast(poly_int_c, v, 0.0);
    if _poly_is_zero_c(A) or _poly_deg_c(Q) == 0 {
        return map{ ok: true, ast: total_ast };
    }

    // Square-free factorization Q = prod_{k=1}^m F_k^k and Hermite reduction from k = m down to 2
    let F = _poly_sqfree_factors(Q);
    let k = len(F);
    while k >= 2 {
        let V = F[k - 1];
        if _poly_deg_c(V) >= 1 {
            // Compute U = prod_{j=1}^{k-1} F_j^j
            let U = [1.0];
            let j = 1;
            while j < k {
                let Fj = F[j - 1];
                if _poly_deg_c(Fj) >= 1 {
                    let pj = 0;
                    while pj < j {
                        U = _poly_mul_c(U, Fj, 48);
                        if U == nil { return map{ ok: false }; }
                        pj = pj + 1;
                    }
                }
                j = j + 1;
            }
            let Vp = _poly_diff_c(V);
            let UVp = _poly_mul_c(U, Vp, 48);
            if UVp == nil { return map{ ok: false }; }
            let eg = _poly_ext_gcd_c(UVp, V);
            let As = _poly_mul_c(A, eg.u, 64);
            if As == nil { return map{ ok: false }; }
            let B = _poly_trim_tol(_poly_divmod(As, V).r, 1e-10);
            let B_UVp = _poly_mul_c(B, UVp, 64);
            let C = _poly_trim_tol(_poly_divmod(_poly_sub_c(A, B_UVp), V).q, 1e-10);

            // Rational antiderivative term: -(B / (k - 1)) / V^(k - 1)
            if not _poly_is_zero_c(B) {
                let B_scaled_ast = _poly_coeffs_to_ast(_poly_scale_c(B, -1.0 / ((k - 1) * 1.0)), v, 0.0);
                let V_ast = _poly_coeffs_to_ast(V, v, 0.0);
                let V_pow = if k - 1 == 1 { V_ast } else { _bin("^", V_ast, _num(k - 1)) };
                total_ast = _simp(_bin("+", total_ast, _bin("/", B_scaled_ast, V_pow)));
            }

            // Update A <- C + (1/(k - 1)) * U * B' and merge V into F_{k-1}
            let Bp = _poly_diff_c(B);
            let UBp = _poly_mul_c(U, Bp, 64);
            A = _poly_trim_tol(_poly_add_c(C, _poly_scale_c(UBp, 1.0 / ((k - 1) * 1.0))), 1e-10);
            F[k - 2] = _poly_monic_c(_poly_mul_c(F[k - 2], V, 48));
        }
        k = k - 1;
    }

    // Remaining square-free integrand: ∫ A(x) / S(x) dx
    let S = _poly_monic_c(F[0]);
    let g_as = _poly_gcd_c(A, S);
    if _poly_deg_c(g_as) > 0 {
        A = _poly_trim_tol(_poly_divmod(A, g_as).q, 1e-10);
        S = _poly_monic_c(_poly_divmod(S, g_as).q);
    }
    if _poly_is_zero_c(A) or _poly_deg_c(S) == 0 {
        return map{ ok: true, ast: total_ast };
    }

    let deg_s = _poly_deg_c(S);
    if deg_s == 1 {
        let r0 = A[0];
        let s_ast = _poly_coeffs_to_ast(S, v, 0.0);
        let ln_term = _simp(_bin("*", _num_or_simple_rat(r0), _call("ln", [_call("abs", [s_ast])])));
        return map{ ok: true, ast: _simp(_bin("+", total_ast, ln_term)) };
    }
    if deg_s == 2 {
        let B_v = A[0];
        let A_v = if len(A) >= 2 { A[1] } else { 0.0 };
        let q_term = _int_rational_quad(A_v, B_v, S[2], S[1], S[0], v);
        return map{ ok: true, ast: _simp(_bin("+", total_ast, q_term)) };
    }

    // Check uniform constant residue A(x) == c * S'(x) -> c * ln|S(x)| (pure Rothstein-Trager degree-1 resultant)
    let Sp = _poly_diff_c(S);
    let A_ast = _poly_coeffs_to_ast(A, v, 0.0);
    let Sp_ast = _poly_coeffs_to_ast(Sp, v, 0.0);
    let cr_s = _const_ratio(A_ast, Sp_ast, v);
    if cr_s.ok {
        let S_ast = _poly_coeffs_to_ast(S, v, 0.0);
        return map{ ok: true, ast: _simp(_bin("+", total_ast, _bin("*", cr_s.k_ast, _call("ln", [_call("abs", [S_ast])])))) };
    }

    // Rothstein-Trager residues over real linear & conjugate irreducible quadratic factors of S(x)
    let rts = _poly_sqfree_roots(S);
    if not rts.ok { return map{ ok: false }; }
    let x_sym = _sym(v);

    let ri = 0;
    while ri < len(rts.real_roots) {
        let r_val = rts.real_roots[ri];
        let res_r = _poly_eval_real(A, r_val) / _poly_eval_real(Sp, r_val);
        if not _near_zero(res_r) {
            let lin_f = _simp(_bin("-", x_sym, _num_or_simple_rat(r_val)));
            let term_r = _simp(_bin("*", _num_or_simple_rat(res_r), _call("ln", [_call("abs", [lin_f])])));
            total_ast = _simp(_bin("+", total_ast, term_r));
        }
        ri = ri + 1;
    }

    let ci = 0;
    while ci < len(rts.complex_upper) {
        let zc = rts.complex_upper[ci];
        let alpha = zc.re;
        let beta = zc.im;
        let w = _c_div(_poly_eval_complex(A, zc), _poly_eval_complex(Sp, zc));
        let Aq = 2.0 * w.re;
        let Bq = -2.0 * w.re * alpha - 2.0 * w.im * beta;
        let quad_t = _int_rational_quad(Aq, Bq, 1.0, -2.0 * alpha, alpha * alpha + beta * beta, v);
        total_ast = _simp(_bin("+", total_ast, quad_t));
        ci = ci + 1;
    }

    return map{ ok: true, ast: total_ast };
}

// Extract exponential factor exp(g(x)) from a multiplicative term: node == f_ast * exp(g_ast)
fn _split_exp_factor(node, v) {
    let s = _simp(node);
    if s.kind == "call" and s.name == "exp" and len(s.args) == 1 and _depends_on(s.args[0], v, 0) {
        return map{ has_exp: true, f_ast: _num(1), g_ast: _simp(s.args[0]) };
    }
    if s.kind == "bin" and s.op == "^" and _is_sym(s.left) and s.left.name == "e" and _depends_on(s.right, v, 0) {
        return map{ has_exp: true, f_ast: _num(1), g_ast: _simp(s.right) };
    }
    if s.kind == "neg" {
        let sub = _split_exp_factor(s.arg, v);
        if sub.has_exp {
            return map{ has_exp: true, f_ast: _simp(_neg(sub.f_ast)), g_ast: sub.g_ast };
        }
        return map{ has_exp: false };
    }
    if s.kind == "bin" and (s.op == "*" or s.op == "/") {
        let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(s, false, st_m, 0);
        if st_m.zero { return map{ has_exp: false }; }
        let scalar_val = if st_m.is_rat { (st_m.sign * st_m.num_int * 1.0) / (st_m.den_int * 1.0) } else { st_m.sign * st_m.float_val };
        let f_acc = _num_or_simple_rat(scalar_val);
        let g_acc = _num(0);
        let found_exp = false;
        let i = 0;
        while i < len(st_m.factors) {
            let fac = st_m.factors[i];
            let b = fac.base;
            let e = fac.exp;
            if b.kind == "call" and b.name == "exp" and len(b.args) == 1 and _depends_on(b.args[0], v, 0) and not _depends_on(e, v, 0) {
                found_exp = true;
                g_acc = _simp(_bin("+", g_acc, _bin("*", e, b.args[0])));
            } else if _is_sym(b) and b.name == "e" and _depends_on(e, v, 0) {
                found_exp = true;
                g_acc = _simp(_bin("+", g_acc, e));
            } else {
                f_acc = _simp(_bin("*", f_acc, _bin("^", b, e)));
            }
            i = i + 1;
        }
        if found_exp and _depends_on(g_acc, v, 0) {
            return map{ has_exp: true, f_ast: f_acc, g_ast: g_acc };
        }
    }
    return map{ has_exp: false };
}

// Solve Polynomial Risch DE: ∫ P(x) * exp(g(x)) dx where P, g are polynomials in x (deg(g) >= 1)
fn _risch_poly_exp(p_coeffs, pg, g_ast, v) {
    let d = pg.deg;
    let gp = _poly_diff_c(pg.coeffs);
    let b_lead = gp[d - 1];
    let R = [];
    let i = 0;
    while i < len(p_coeffs) { array_push(R, p_coeffs[i] * 1.0); i = i + 1; }
    while len(R) < d { array_push(R, 0.0); }

    let m = len(R) - 1;
    let Q = [0.0];
    if m >= d - 1 {
        let q_deg = m - (d - 1);
        Q = [];
        let z = 0;
        while z <= q_deg { array_push(Q, 0.0); z = z + 1; }
        let k = q_deg;
        while k >= 0 {
            let qk = R[k + d - 1] / b_lead;
            Q[k] = qk;
            if not _near_zero(qk) {
                // Subtract qk * (k * x^(k - 1) + x^k * g'(x))
                if k >= 1 {
                    R[k - 1] = R[k - 1] - qk * (k * 1.0);
                }
                let j = 0;
                while j <= d - 1 {
                    R[k + j] = R[k + j] - qk * gp[j];
                    j = j + 1;
                }
            }
            k = k - 1;
        }
    }

    let R_trim = _poly_trim_tol(R, 1e-10);
    let elem_ast = _num(0);
    if not _poly_is_zero_c(Q) {
        elem_ast = _simp(_bin("*", _poly_coeffs_to_ast(Q, v, 0.0), _call("exp", [g_ast])));
    }
    if _poly_is_zero_c(R_trim) {
        return map{ ok: true, ast: elem_ast };
    }

    // Non-zero constant remainder r0 when deg(g) == 2 (g(x) = a*x^2 + b*x + c) -> erf / erfi!
    if d == 2 and _poly_deg_c(R_trim) == 0 {
        let r0 = R_trim[0];
        let c_v = pg.coeffs[0];
        let b_v = pg.coeffs[1];
        let a_v = pg.coeffs[2];
        let kappa = _snap_num(c_v - (b_v * b_v) / (4.0 * a_v));
        let alpha_ast = _exact_sqrt_ast(num_abs(a_v));
        let shift_x = _simp(_bin("+", _sym(v), _num_or_simple_rat(b_v / (2.0 * a_v))));
        let erf_arg = _simp(_bin("*", alpha_ast, shift_x));
        let exp_k = if _near_zero(kappa) { _num(1) } else { _call("exp", [_num_or_simple_rat(kappa)]) };
        let rtpi_over_2a = _simp(_bin("/", _call("sqrt", [_sym("pi")]), _bin("*", _num(2), alpha_ast)));
        let pref = _simp(_bin("*", _bin("*", _num_or_simple_rat(r0), exp_k), rtpi_over_2a));
        let fn_nm = if a_v < 0.0 { "erf" } else { "erfi" };
        let spec_part = _simp(_bin("*", pref, _call(fn_nm, [erf_arg])));
        return map{ ok: true, ast: _simp(_bin("+", elem_ast, spec_part)) };
    }

    return map{ ok: false };
}

// Solve General Exponential Risch Extension: ∫ f(x) * exp(g(x)) dx
fn _solve_risch_exp_de(f_ast, g_ast, v) {
    let sf = _simp(f_ast);
    let sg = _simp(g_ast);
    if _is_num_eq(sf, 0) { return map{ ok: true, ast: _num(0) }; }

    // 1. Polynomial & Rational Risch Differential Equation when g(x) is polynomial and f(x) = N(x)/D(x)
    let pg = _extract_poly(sg, v, 10);
    let rf = _extract_rational_poly(sf, v, 16);
    if pg.ok and pg.deg >= 1 and rf.ok {
        let N = rf.num_c;
        let D = rf.den_c;
        if _poly_deg_c(D) == 0 {
            return _risch_poly_exp(_poly_scale_c(N, 1.0 / D[0]), pg, sg, v);
        }

        // Laurent / Hermite pole-order reduction on D = prod_{k=1}^m F_k^k for k >= 2:
        // d/dx((B / V^(k-1)) * exp(g)) = (((B' + g'*B)/V^(k-1)) - ((k-1)*B*V' / V^k)) * exp(g)
        let gp = _poly_diff_c(pg.coeffs);
        let F = _poly_sqfree_factors(D);
        let rat_exp_acc = _num(0);
        let red_ok = true;
        let k = len(F);
        while k >= 2 {
            let V = F[k - 1];
            if _poly_deg_c(V) >= 1 {
                let U = [1.0];
                let j = 1;
                while j < k {
                    let Fj = F[j - 1];
                    if _poly_deg_c(Fj) >= 1 {
                        let pj = 0;
                        while pj < j {
                            U = _poly_mul_c(U, Fj, 48);
                            if U == nil { red_ok = false; break; }
                            pj = pj + 1;
                        }
                    }
                    if not red_ok { break; }
                    j = j + 1;
                }
                if not red_ok { break; }
                let Vp = _poly_diff_c(V);
                let UVp = _poly_mul_c(U, Vp, 48);
                if UVp == nil { red_ok = false; break; }
                let eg = _poly_ext_gcd_c(UVp, V);
                let Ns = _poly_mul_c(_poly_scale_c(N, -1.0 / ((k - 1) * 1.0)), eg.u, 64);
                if Ns == nil { red_ok = false; break; }
                let B = _poly_trim_tol(_poly_divmod(Ns, V).r, 1e-10);
                let corr = _poly_scale_c(_poly_mul_c(B, UVp, 64), (k - 1) * 1.0);
                let C = _poly_trim_tol(_poly_divmod(_poly_add_c(N, corr), V).q, 1e-10);

                if not _poly_is_zero_c(B) {
                    let B_ast = _poly_coeffs_to_ast(B, v, 0.0);
                    let V_ast = _poly_coeffs_to_ast(V, v, 0.0);
                    let V_pow = if k - 1 == 1 { V_ast } else { _bin("^", V_ast, _num(k - 1)) };
                    let term_re = _simp(_bin("*", _bin("/", B_ast, V_pow), _call("exp", [sg])));
                    rat_exp_acc = _simp(_bin("+", rat_exp_acc, term_re));
                }

                // Update N <- C - U * (B' + g' * B)
                let Bp = _poly_diff_c(B);
                let gpB = _poly_mul_c(gp, B, 64);
                if gpB == nil { red_ok = false; break; }
                let U_shift = _poly_mul_c(U, _poly_add_c(Bp, gpB), 64);
                if U_shift == nil { red_ok = false; break; }
                N = _poly_trim_tol(_poly_sub_c(C, U_shift), 1e-10);
                F[k - 2] = _poly_monic_c(_poly_mul_c(F[k - 2], V, 48));
            }
            k = k - 1;
        }

        if red_ok {
            let S = _poly_monic_c(F[0]);
            let g_ns = _poly_gcd_c(N, S);
            if _poly_deg_c(g_ns) > 0 {
                N = _poly_trim_tol(_poly_divmod(N, g_ns).q, 1e-10);
                S = _poly_monic_c(_poly_divmod(S, g_ns).q);
            }

            let dm = _poly_divmod(N, S);
            let poly_q = dm.q;
            let rem_s = _poly_trim_tol(dm.r, 1e-10);

            let poly_res = _risch_poly_exp(poly_q, pg, sg, v);
            if poly_res.ok {
                let total_ast = _simp(_bin("+", rat_exp_acc, poly_res.ast));

                if _poly_is_zero_c(rem_s) or _poly_deg_c(S) == 0 {
                    return map{ ok: true, ast: total_ast };
                }

                // Non-zero simple-pole residual rem_s(x)/S(x) * exp(g(x)):
                // Closed-form over R via Ei when g(x) = a*x + b and all roots of square-free S(x) are real!
                if pg.deg == 1 {
                    let b_g = pg.coeffs[0];
                    let a_g = pg.coeffs[1];
                    let rts = _poly_sqfree_roots(S);
                    if rts.ok and len(rts.complex_upper) == 0 {
                        let Sp = _poly_diff_c(S);
                        let x_sym = _sym(v);
                        let i = 0;
                        while i < len(rts.real_roots) {
                            let ri = rts.real_roots[i];
                            let ci = _poly_eval_real(rem_s, ri) / _poly_eval_real(Sp, ri);
                            if not _near_zero(ci) {
                                let shift_exp = _snap_num(a_g * ri + b_g);
                                let exp_pref = if _near_zero(shift_exp) { _num(1) } else { _call("exp", [_num_or_simple_rat(shift_exp)]) };
                                let ei_arg = _simp(_bin("*", _num_or_simple_rat(a_g), _bin("-", x_sym, _num_or_simple_rat(ri))));
                                let ei_term = _simp(_bin("*", _bin("*", _num_or_simple_rat(ci), exp_pref), _call("Ei", [ei_arg])));
                                total_ast = _simp(_bin("+", total_ast, ei_term));
                            }
                            i = i + 1;
                        }
                        return map{ ok: true, ast: total_ast };
                    }
                }
                // Monomial simple pole c * exp(a*x^d + b) / x -> (c * exp(b) / d) * Ei(a * x^d)
                if _poly_deg_c(S) == 1 and _near_zero(S[0]) {
                    let pure_monomial = true;
                    let mi = 1;
                    while mi < pg.deg {
                        if not _near_zero(pg.coeffs[mi]) { pure_monomial = false; break; }
                        mi = mi + 1;
                    }
                    if pure_monomial {
                        let c0 = rem_s[0];
                        let b_g = pg.coeffs[0];
                        let a_g = pg.coeffs[pg.deg];
                        let exp_b = if _near_zero(b_g) { _num(1) } else { _call("exp", [_num_or_simple_rat(b_g)]) };
                        let ei_arg = _simp(_bin("*", _num_or_simple_rat(a_g), _bin("^", _sym(v), _num(pg.deg))));
                        let ei_t = _simp(_bin("*", _bin("*", _num_or_simple_rat(c0 / (pg.deg * 1.0)), exp_b), _call("Ei", [ei_arg])));
                        return map{ ok: true, ast: _simp(_bin("+", total_ast, ei_t)) };
                    }
                }
            }
        }
        return map{ ok: false };
    }

    // 2. Mixed-Tower Risch Derivative Ansatz: f(x) == g'(x)*h(x) + h'(x) => exp(g(x)) * h(x)
    let st_dg = [];
    let dg = _simp(_diff_ast(sg, v, st_dg, 0));
    if not _is_num_eq(dg, 0) {
        let cr_u = _const_ratio(sf, dg, v);
        if cr_u.ok {
            return map{ ok: true, ast: _simp(_bin("*", cr_u.k_ast, _call("exp", [sg]))) };
        }
        let f_terms = [];
        let _ = _collect_sum_terms(sf, 1, f_terms, 0);
        if len(f_terms) >= 2 and len(f_terms) <= 8 {
            let ti = 0;
            while ti < len(f_terms) {
                let h_cand = _simp(_bin("/", f_terms[ti], dg));
                let st_h = [];
                let dh = _simp(_diff_ast(h_cand, v, st_h, 0));
                let rhs = _simp(_bin("+", _bin("*", dg, h_cand), dh));
                let residual = _simp(_bin("-", sf, rhs));
                if _is_identically_zero_1d(residual, v) {
                    return map{ ok: true, ast: _simp(_bin("*", _call("exp", [sg]), h_cand)) };
                }
                ti = ti + 1;
            }
            if len(f_terms) >= 3 and len(f_terms) <= 4 {
                let i1 = 0;
                while i1 < len(f_terms) {
                    let i2 = i1 + 1;
                    while i2 < len(f_terms) {
                        let h2 = _simp(_bin("/", _bin("+", f_terms[i1], f_terms[i2]), dg));
                        let dh2 = _simp(_diff_ast(h2, v, [], 0));
                        let res2 = _simp(_bin("-", sf, _bin("+", _bin("*", dg, h2), dh2)));
                        if _is_identically_zero_1d(res2, v) {
                            return map{ ok: true, ast: _simp(_bin("*", _call("exp", [sg]), h2)) };
                        }
                        i2 = i2 + 1;
                    }
                    i1 = i1 + 1;
                }
            }
        }
    }

    return map{ ok: false };
}

// Find common linear-log generator ln(a*x) in node (returns { ok, a, u_ast } or { ok: false })
fn _find_log_tower_gen(node, v, state, depth) {
    if depth > MAX_DEPTH or state.bad { return false; }
    let k = node.kind;
    if k == "num" or k == "sym" { return true; }
    if k == "neg" { return _find_log_tower_gen(node.arg, v, state, depth + 1); }
    if k == "bin" {
        let _ = _find_log_tower_gen(node.left, v, state, depth + 1);
        let _ = _find_log_tower_gen(node.right, v, state, depth + 1);
        return true;
    }
    if k == "call" {
        if not _depends_on(node, v, 0) { return true; }
        if node.name == "ln" and len(node.args) == 1 {
            let lin = _match_linear(node.args[0], v);
            if lin.ok and lin.a > 0.0 and _near_zero(lin.b) {
                if not state.found {
                    state.found = true;
                    state.a = lin.a;
                    state.u_ast = _simp(node.args[0]);
                } else if num_abs(state.a - lin.a) > 1e-11 {
                    state.bad = true;
                }
                return true;
            }
        }
        state.bad = true;
        return false;
    }
    return true;
}

fn _replace_ln_with_sym(node, target_key, sym_name, depth) {
    if depth > MAX_DEPTH { return node; }
    if _canon_key(node, 0) == target_key {
        return _sym(sym_name);
    }
    if node.kind == "neg" {
        return _neg(_replace_ln_with_sym(node.arg, target_key, sym_name, depth + 1));
    }
    if node.kind == "bin" {
        return _bin(node.op, _replace_ln_with_sym(node.left, target_key, sym_name, depth + 1), _replace_ln_with_sym(node.right, target_key, sym_name, depth + 1));
    }
    if node.kind == "call" {
        let nargs = [];
        let i = 0;
        while i < len(node.args) {
            array_push(nargs, _replace_ln_with_sym(node.args[i], target_key, sym_name, depth + 1));
            i = i + 1;
        }
        return _call(node.name, nargs);
    }
    return node;
}

// Risch Logarithmic Tower Integrator for Q(x)[theta, 1/theta^k] where theta = ln(a*x), plus Dilogarithm Li2
fn _try_risch_log_and_dilog(node, v, depth) {
    let s = _simp(node);

    // 1. Dilogarithm pattern: c * ln(b0 + b1*x) / x -> ln(b0)*ln|x| - Li2(-(b1/b0)*x)
    if s.kind == "bin" and (s.op == "/" or s.op == "*") {
        let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(s, false, st_m, 0);
        if not st_m.zero and len(st_m.factors) == 2 {
            let scalar_val = if st_m.is_rat { (st_m.sign * st_m.num_int * 1.0) / (st_m.den_int * 1.0) } else { st_m.sign * st_m.float_val };
            let f0 = st_m.factors[0];
            let f1 = st_m.factors[1];
            let ln_node = nil;
            let inv_x_ok = false;
            if f0.base.kind == "call" and f0.base.name == "ln" and _is_num_eq(f0.exp, 1) and _is_sym(f1.base) and f1.base.name == v and _is_num_eq(f1.exp, -1) {
                ln_node = f0.base; inv_x_ok = true;
            } else if f1.base.kind == "call" and f1.base.name == "ln" and _is_num_eq(f1.exp, 1) and _is_sym(f0.base) and f0.base.name == v and _is_num_eq(f0.exp, -1) {
                ln_node = f1.base; inv_x_ok = true;
            }
            if inv_x_ok and ln_node != nil and len(ln_node.args) == 1 {
                let lin = _match_linear(ln_node.args[0], v);
                if lin.ok and not _near_zero(lin.a) and lin.b > 0.0 {
                    let ratio_a = (0.0 - lin.a) / lin.b;
                    let li2_arg = _simp(_bin("*", _num_or_simple_rat(ratio_a), _sym(v)));
                    let main_li2 = _neg(_call("Li2", [li2_arg]));
                    if num_abs(lin.b - 1.0) < 1e-12 {
                        return map{ ok: true, ast: _simp(_bin("*", _num_or_simple_rat(scalar_val), main_li2)) };
                    }
                    let extra_ln = _bin("*", _call("ln", [_num_or_simple_rat(lin.b)]), _call("ln", [_call("abs", [_sym(v)])]));
                    return map{ ok: true, ast: _simp(_bin("*", _num_or_simple_rat(scalar_val), _bin("+", extra_ln, main_li2))) };
                }
            }
        }
    }

    // 2. Logarithmic tower theta = ln(a*x)
    let st_lg = map{ found: false, bad: false, a: 1.0, u_ast: _sym(v) };
    let _ = _find_log_tower_gen(s, v, st_lg, 0);
    if not st_lg.found or st_lg.bad {
        return map{ ok: false };
    }
    let th_ast = _call("ln", [st_lg.u_ast]);
    let th_key = _canon_key(th_ast, 0);
    let t_sym = "__risch_th";
    let sub_ast = _simp(_replace_ln_with_sym(s, th_key, t_sym, 0));

    // Determine pole order K in 0..6 of t_sym so M = sub_ast * t_sym^K has no pole at t_sym = 0
    let K_pole = -1;
    let M_ast = nil;
    let try_k = 0;
    while try_k <= 6 {
        let mult_t = if try_k == 0 { sub_ast } else { _simp(_bin("*", sub_ast, _bin("^", _sym(t_sym), _num(try_k)))) };
        let env_chk = map{};
        env_chk[v] = 1.73;
        env_chk[t_sym] = 0.0;
        let v0 = try _eval_ast(mult_t, env_chk, 0) catch _nan_val();
        if _is_finite(v0) {
            // Check 6th derivative w.r.t. t_sym vanishes (confirms polynomial in t_sym of degree <= 5)
            let d_cur = mult_t;
            let deg_t = 0;
            let is_poly_t = false;
            while deg_t <= 5 {
                let nxt_d = _simp(_diff_ast(d_cur, t_sym, [], 0));
                if _is_num_eq(nxt_d, 0) {
                    is_poly_t = true;
                    break;
                }
                d_cur = nxt_d;
                deg_t = deg_t + 1;
            }
            if is_poly_t {
                K_pole = try_k;
                M_ast = mult_t;
                break;
            }
        }
        try_k = try_k + 1;
    }
    if K_pole < 0 or M_ast == nil {
        return map{ ok: false };
    }

    // Extract symbolic coefficient ASTs C_arr[j] of t_sym^j in M_ast (corresponding to theta^(j - K_pole))
    let C_arr = [];
    let cur_d = M_ast;
    let j = 0;
    while j <= 5 {
        let c_j = _simp(_bin("/", _subst_ast(cur_d, t_sym, _num(0), 0), _num(_factorial(j))));
        array_push(C_arr, c_j);
        cur_d = _simp(_diff_ast(cur_d, t_sym, [], 0));
        if _is_num_eq(cur_d, 0) { break; }
        j = j + 1;
    }
    while len(C_arr) <= K_pole {
        array_push(C_arr, _num(0));
    }

    // Hermite pole-order reduction in theta = ln(a*x) from k = K_pole down to 2:
    // d/dx(u(x) / theta^(k-1)) = u'(x)/theta^(k-1) - ((k-1)*(u(x)/x)) / theta^k
    let ans_ast = _num(0);
    let k = K_pole;
    while k >= 2 {
        let Ak = C_arr[K_pole - k];
        if not _is_num_eq(Ak, 0) {
            let u_x = _simp(_neg(_bin("/", _bin("*", _sym(v), Ak), _num(k - 1))));
            let denom_th = if k - 1 == 1 { th_ast } else { _bin("^", th_ast, _num(k - 1)) };
            ans_ast = _simp(_bin("+", ans_ast, _bin("/", u_x, denom_th)));
            let du_x = _simp(_diff_ast(u_x, v, [], 0));
            C_arr[K_pole - (k - 1)] = _simp(_bin("-", C_arr[K_pole - (k - 1)], du_x));
            C_arr[K_pole - k] = _num(0);
        }
        k = k - 1;
    }

    // Simple-pole residual C_{-1}(x) / ln(a*x)
    if K_pole >= 1 {
        let C_m1 = _simp(C_arr[K_pole - 1]);
        if not _is_num_eq(C_m1, 0) {
            let m1_terms = [];
            let _ = _collect_sum_terms(C_m1, 1, m1_terms, 0);
            let ti = 0;
            while ti < len(m1_terms) {
                let tm = _simp(m1_terms[ti]);
                if not _depends_on(tm, v, 0) {
                    // ∫ c / ln(a*x) dx = (c / a) * li(a*x)
                    let pref_li = _simp(_bin("/", tm, _num_or_simple_rat(st_lg.a)));
                    ans_ast = _simp(_bin("+", ans_ast, _bin("*", pref_li, _call("li", [st_lg.u_ast]))));
                } else {
                    // Extract c * x^n
                    let sp_t = _split_coeff_and_core(tm);
                    let c_ast = _build_scaled_term(sp_t.is_rat, sp_t.p, sp_t.q, sp_t.f, _num(1));
                    let core = sp_t.core;
                    let n_pow = _nan_val();
                    if _is_sym(core) and core.name == v {
                        n_pow = 1.0;
                    } else if core.kind == "bin" and core.op == "/" and _is_num_eq(core.left, 1) and _is_sym(core.right) and core.right.name == v {
                        n_pow = -1.0;
                    } else if core.kind == "bin" and core.op == "/" and _is_num_eq(core.left, 1) and core.right.kind == "bin" and core.right.op == "^" and _is_sym(core.right.left) and core.right.left.name == v and not _depends_on(core.right.right, v, 0) {
                        let pv = try _eval_ast(core.right.right, map{}, 0) catch _nan_val();
                        if _is_finite(pv) { n_pow = 0.0 - pv; }
                    } else if core.kind == "bin" and core.op == "^" and _is_sym(core.left) and core.left.name == v and not _depends_on(core.right, v, 0) {
                        n_pow = try _eval_ast(core.right, map{}, 0) catch _nan_val();
                    }
                    if not _is_finite(n_pow) { return map{ ok: false }; }
                    if num_abs(n_pow + 1.0) < 1e-12 {
                        // ∫ c / (x * ln(a*x)) dx = c * ln|ln(a*x)|
                        ans_ast = _simp(_bin("+", ans_ast, _bin("*", c_ast, _call("ln", [_call("abs", [th_ast])]))));
                    } else {
                        // ∫ c * x^n / ln(a*x) dx = (c / a^(n + 1)) * Ei((n + 1) * ln(a*x))
                        let np1 = _snap_num(n_pow + 1.0);
                        let scale_a = _safe_pow(st_lg.a, np1);
                        let pref_ei = _simp(_bin("/", c_ast, _num_or_simple_rat(scale_a)));
                        let ei_arg = _simp(_bin("*", _num_or_simple_rat(np1), th_ast));
                        ans_ast = _simp(_bin("+", ans_ast, _bin("*", pref_ei, _call("Ei", [ei_arg]))));
                    }
                }
                ti = ti + 1;
            }
        }
    }

    // Non-negative powers m >= 0: C_arr[K_pole + m] * theta^m
    let m_deg = len(C_arr) - 1 - K_pole;
    if m_deg >= 0 {
        // Reduce m from m_deg down to 1 if C_m(x) is polynomial/power, then m = 0 via _int_ast
        let m = m_deg;
        while m >= 1 {
            let Cm = _simp(C_arr[K_pole + m]);
            if not _is_num_eq(Cm, 0) {
                let sub_m = _int_ast(Cm, v, depth + 1);
                if not sub_m.ok { return map{ ok: false }; }
                // ∫ Cm(x) * theta^m dx = sub_m * theta^m - ∫ (m * sub_m / x) * theta^(m - 1) dx
                let th_pow = if m == 1 { th_ast } else { _bin("^", th_ast, _num(m)) };
                ans_ast = _simp(_bin("+", ans_ast, _bin("*", sub_m.ast, th_pow)));
                let next_c = _simp(_bin("/", _bin("*", _num(m), sub_m.ast), _sym(v)));
                C_arr[K_pole + m - 1] = _simp(_bin("-", C_arr[K_pole + m - 1], next_c));
            }
            m = m - 1;
        }
        let C0 = _simp(C_arr[K_pole]);
        if not _is_num_eq(C0, 0) {
            let sub_0 = _int_ast(C0, v, depth + 1);
            if not sub_0.ok { return map{ ok: false }; }
            ans_ast = _simp(_bin("+", ans_ast, sub_0.ast));
        }
    }

    return map{ ok: true, ast: ans_ast };
}

// Integrate sin(a*x)/x^k and cos(a*x)/x^k (k >= 1) via pole reduction to Si(a*x), Ci(|a|*x)
fn _int_sincos_inv_pow(is_sin, a_val, k_pow, v) {
    if k_pow < 1 or k_pow > 10 or _near_zero(a_val) { return map{ ok: false }; }
    let x_sym = _sym(v);
    let ax = _simp(_bin("*", _num_or_simple_rat(a_val), x_sym));
    if k_pow == 1 {
        if is_sin {
            return map{ ok: true, ast: _simp(_call("Si", [ax])) };
        }
        let abs_ax = _simp(_bin("*", _num_or_simple_rat(num_abs(a_val)), x_sym));
        return map{ ok: true, ast: _simp(_call("Ci", [abs_ax])) };
    }
    let km1 = k_pow - 1;
    let x_km1 = if km1 == 1 { x_sym } else { _bin("^", x_sym, _num(km1)) };
    let denom = _simp(_bin("*", _num(km1), x_km1));
    if is_sin {
        let head = _neg(_bin("/", _call("sin", [ax]), denom));
        let rec = _int_sincos_inv_pow(false, a_val, km1, v);
        if not rec.ok { return map{ ok: false }; }
        let tail = _bin("*", _num_or_simple_rat(a_val / (km1 * 1.0)), rec.ast);
        return map{ ok: true, ast: _simp(_bin("+", head, tail)) };
    } else {
        let head = _neg(_bin("/", _call("cos", [ax]), denom));
        let rec = _int_sincos_inv_pow(true, a_val, km1, v);
        if not rec.ok { return map{ ok: false }; }
        let tail = _neg(_bin("*", _num_or_simple_rat(a_val / (km1 * 1.0)), rec.ast));
        return map{ ok: true, ast: _simp(_bin("+", head, tail)) };
    }
}

// Fresnel reduction for ∫ P(x) * sin(a*x^2 + b*x + c) dx and ∫ P(x) * cos(a*x^2 + b*x + c) dx
fn _try_fresnel_or_sincos_pole(node, v) {
    let s = _simp(node);
    let scalar_val = 1.0;
    let trig_node = nil;
    let rest_ast = _num(1);

    if s.kind == "call" and (s.name == "sin" or s.name == "cos") and len(s.args) == 1 {
        trig_node = s;
    } else if s.kind == "bin" and (s.op == "*" or s.op == "/") {
        let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(s, false, st_m, 0);
        if st_m.zero { return map{ ok: true, ast: _num(0) }; }
        scalar_val = if st_m.is_rat { (st_m.sign * st_m.num_int * 1.0) / (st_m.den_int * 1.0) } else { st_m.sign * st_m.float_val };
        let i = 0;
        while i < len(st_m.factors) {
            let f = st_m.factors[i];
            if trig_node == nil and f.base.kind == "call" and (f.base.name == "sin" or f.base.name == "cos") and len(f.base.args) == 1 and _is_num_eq(f.exp, 1) {
                trig_node = f.base;
            } else {
                rest_ast = _simp(_bin("*", rest_ast, _bin("^", f.base, f.exp)));
            }
            i = i + 1;
        }
    }
    if trig_node == nil { return map{ ok: false }; }
    let is_sin = trig_node.name == "sin";
    let arg = trig_node.args[0];

    // Case A: sin(a*x)/x^k or cos(a*x)/x^k (and Laurent polynomial * sin(a*x)/x^k)
    let lin_arg = _match_linear(arg, v);
    if lin_arg.ok and not _near_zero(lin_arg.a) and _near_zero(lin_arg.b) {
        let rf = _extract_rational_poly(rest_ast, v, 10);
        if rf.ok and _poly_deg_c(rf.den_c) >= 1 {
            // Check if denominator is pure power x^k
            let k_den = _poly_deg_c(rf.den_c);
            let pure_xk = true;
            let j = 0;
            while j < k_den {
                if not _near_zero(rf.den_c[j]) { pure_xk = false; break; }
                j = j + 1;
            }
            if pure_xk and num_abs(rf.den_c[k_den] - 1.0) < 1e-11 {
                let acc_sc = _num(0);
                let deg_n = 0;
                while deg_n < len(rf.num_c) {
                    let cn = scalar_val * rf.num_c[deg_n];
                    if not _near_zero(cn) {
                        let net_pow = deg_n - k_den;
                        if net_pow < 0 {
                            let sr = _int_sincos_inv_pow(is_sin, lin_arg.a, 0 - net_pow, v);
                            if not sr.ok { return map{ ok: false }; }
                            acc_sc = _simp(_bin("+", acc_sc, _bin("*", _num_or_simple_rat(cn), sr.ast)));
                        } else {
                            let x_p = if net_pow == 0 { _num(1) } else if net_pow == 1 { _sym(v) } else { _bin("^", _sym(v), _num(net_pow)) };
                            let sub_p = _int_ast(_bin("*", _num_or_simple_rat(cn), _bin("*", x_p, trig_node)), v, 1);
                            if not sub_p.ok { return map{ ok: false }; }
                            acc_sc = _simp(_bin("+", acc_sc, sub_p.ast));
                        }
                    }
                    deg_n = deg_n + 1;
                }
                return map{ ok: true, ast: acc_sc };
            }
        }
    }

    // Case B: Fresnel integrals ∫ P(x) * sin(a*x^2) dx and ∫ P(x) * cos(a*x^2) dx (including symbolic pi/2 * x^2)
    let poly_p = _extract_poly(rest_ast, v, 10);
    if not poly_p.ok { return map{ ok: false }; }
    let d1_arg = _simp(_diff_ast(arg, v, [], 0));
    let d2_arg = _simp(_diff_ast(d1_arg, v, [], 0));
    if _depends_on(d2_arg, v, 0) { return map{ ok: false }; }
    let a_raw_val = try _eval_ast(d2_arg, map{}, 0) catch _nan_val();
    if not _is_finite(a_raw_val) or _near_zero(a_raw_val) { return map{ ok: false }; }
    let a_val = 0.5 * a_raw_val;
    let a_sym_raw = _simp(_bin("/", d2_arg, _num(2)));
    let c0_ast = _simp(_subst_ast(arg, v, _num(0), 0));
    let b1_ast = _simp(_subst_ast(d1_arg, v, _num(0), 0));

    // Pure centered quadratic Q(x) = a * x^2 (preserves exact symbolic pi factors!)
    if _is_num_eq(c0_ast, 0) and _is_num_eq(b1_ast, 0) {
        // Verify arg is genuinely a*x^2 and not e.g. piecewise
        if not _is_identically_zero_1d(_bin("-", arg, _bin("*", a_sym_raw, _bin("^", _sym(v), _num(2)))), v) {
            return map{ ok: false };
        }
        let pos_a_val = num_abs(a_val);
        let pos_a_ast = if a_val < 0.0 { _simp(_neg(a_sym_raw)) } else { a_sym_raw };
        let sign_sin = if a_val < 0.0 and is_sin { -1.0 } else { 1.0 };

        let deg_m = poly_p.deg;
        let ps = [];
        let pc = [];
        let k = 0;
        while k <= deg_m {
            let pv = scalar_val * poly_p.coeffs[k];
            if is_sin {
                array_push(ps, sign_sin * pv);
                array_push(pc, 0.0);
            } else {
                array_push(ps, 0.0);
                array_push(pc, pv);
            }
            k = k + 1;
        }

        let elem_acc = _num(0);
        let ax2_ast = _simp(_bin("*", pos_a_ast, _bin("^", _sym(v), _num(2))));
        let m = deg_m;
        while m >= 1 {
            let cs = ps[m];
            if not _near_zero(cs) {
                let xm1 = if m - 1 == 0 { _num(1) } else if m - 1 == 1 { _sym(v) } else { _bin("^", _sym(v), _num(m - 1)) };
                let coeff_c = _simp(_neg(_bin("/", _num_or_simple_rat(cs), _bin("*", _num(2), pos_a_ast))));
                elem_acc = _simp(_bin("+", elem_acc, _bin("*", coeff_c, _bin("*", xm1, _call("cos", [ax2_ast])))));
                if m >= 2 {
                    pc[m - 2] = pc[m - 2] + (cs * (m - 1.0)) / (2.0 * pos_a_val);
                }
                ps[m] = 0.0;
            }
            let cc = pc[m];
            if not _near_zero(cc) {
                let xm1 = if m - 1 == 0 { _num(1) } else if m - 1 == 1 { _sym(v) } else { _bin("^", _sym(v), _num(m - 1)) };
                let coeff_s = _simp(_bin("/", _num_or_simple_rat(cc), _bin("*", _num(2), pos_a_ast)));
                elem_acc = _simp(_bin("+", elem_acc, _bin("*", coeff_s, _bin("*", xm1, _call("sin", [ax2_ast])))));
                if m >= 2 {
                    ps[m - 2] = ps[m - 2] - (cc * (m - 1.0)) / (2.0 * pos_a_val);
                }
                pc[m] = 0.0;
            }
            m = m - 1;
        }

        let rs0 = ps[0];
        let rc0 = pc[0];
        let k_fres = _simp(_call("sqrt", [_simp(_bin("/", _bin("*", _num(2), pos_a_ast), _sym("pi")))]));
        let inv_k_fres = _simp(_call("sqrt", [_simp(_bin("/", _sym("pi"), _bin("*", _num(2), pos_a_ast)))]));
        let f_arg = _simp(_bin("*", k_fres, _sym(v)));

        if not _near_zero(rs0) {
            let ts = _simp(_bin("*", _bin("*", _num_or_simple_rat(rs0), inv_k_fres), _call("FresnelS", [f_arg])));
            elem_acc = _simp(_bin("+", elem_acc, ts));
        }
        if not _near_zero(rc0) {
            let tc = _simp(_bin("*", _bin("*", _num_or_simple_rat(rc0), inv_k_fres), _call("FresnelC", [f_arg])));
            elem_acc = _simp(_bin("+", elem_acc, tc));
        }
        return map{ ok: true, ast: elem_acc };
    }

    return map{ ok: false };
}

fn _int_ast(node, v, depth) {
    if depth > MAX_DEPTH { return map{ ok: false }; }
    let s = _simp(node);

    // 1. Constant w.r.t. v
    if not _depends_on(s, v, 0) {
        return map{ ok: true, ast: _simp(_bin("*", s, _sym(v))) };
    }

    // 2. Negation
    if s.kind == "neg" {
        let sub = _int_ast(s.arg, v, depth + 1);
        if sub.ok { return map{ ok: true, ast: _simp(_neg(sub.ast)) }; }
        return map{ ok: false };
    }

    // 3. Sum / Difference: group common exponential towers FIRST (so Risch cancellations happen cleanly!),
    //    and also attempt logarithmic tower before splitting individual terms
    if s.kind == "bin" and (s.op == "+" or s.op == "-") {
        let log_try = _try_risch_log_and_dilog(s, v, depth + 1);
        if log_try.ok { return log_try; }

        let terms = [];
        let _ = _collect_sum_terms(s, 1, terms, 0);
        if len(terms) > 1 {
            // Group terms sharing identical exp(g(x)) factor
            let exp_keys = [];
            let exp_groups = map{};
            let plain_terms = [];
            let idx_t = 0;
            while idx_t < len(terms) {
                let sp_e = _split_exp_factor(terms[idx_t], v);
                if sp_e.has_exp {
                    let gk = _canon_key(sp_e.g_ast, 0);
                    if map_has(exp_groups, gk) {
                        exp_groups[gk].f_sum = _simp(_bin("+", exp_groups[gk].f_sum, sp_e.f_ast));
                        exp_groups[gk].count = exp_groups[gk].count + 1;
                    } else {
                        array_push(exp_keys, gk);
                        exp_groups[gk] = map{ f_sum: sp_e.f_ast, g_ast: sp_e.g_ast, count: 1 };
                    }
                } else {
                    array_push(plain_terms, terms[idx_t]);
                }
                idx_t = idx_t + 1;
            }

            // If grouping merged at least two exponential terms (or all terms integrate cleanly by group)
            if len(exp_keys) > 0 {
                let group_ok = true;
                let acc_g = _num(0);
                let gi = 0;
                while gi < len(exp_keys) {
                    let grp = exp_groups[exp_keys[gi]];
                    let gr_res = _solve_risch_exp_de(grp.f_sum, grp.g_ast, v);
                    if not gr_res.ok {
                        let rebuild = _simp(_bin("*", grp.f_sum, _call("exp", [grp.g_ast])));
                        if _canon_key(rebuild, 0) != _canon_key(s, 0) {
                            gr_res = _int_ast(rebuild, v, depth + 1);
                        }
                    }
                    if not gr_res.ok { group_ok = false; break; }
                    acc_g = _simp(_bin("+", acc_g, gr_res.ast));
                    gi = gi + 1;
                }
                if group_ok {
                    let pi = 0;
                    while pi < len(plain_terms) {
                        let pr = _int_ast(plain_terms[pi], v, depth + 1);
                        if not pr.ok { group_ok = false; break; }
                        acc_g = _simp(_bin("+", acc_g, pr.ast));
                        pi = pi + 1;
                    }
                }
                if group_ok {
                    return map{ ok: true, ast: acc_g };
                }
            }

            // Standard term-by-term linearity
            let acc = _num(0);
            let all_ok = true;
            let i = 0;
            while i < len(terms) {
                let ti = _int_ast(terms[i], v, depth + 1);
                if not ti.ok { all_ok = false; break; }
                acc = _simp(_bin("+", acc, ti.ast));
                i = i + 1;
            }
            if all_ok {
                return map{ ok: true, ast: acc };
            }

            // Fallback: rational function presented as sum of fractions
            let rat_sum = _extract_rational_poly(s, v, 16);
            if rat_sum.ok {
                return _int_rational_hermite(rat_sum.num_c, rat_sum.den_c, v);
            }
        }
    }

    // 4. Pull out constant multiplicative factor
    if s.kind == "bin" and (s.op == "*" or s.op == "/") {
        let st = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(s, false, st, 0);
        if st.zero { return map{ ok: true, ast: _num(0) }; }
        let const_factors = [];
        let var_factors = [];
        if st.is_rat {
            if st.num_int != 1 or st.den_int != 1 {
                array_push(const_factors, _rational_to_ast(st.sign * st.num_int, st.den_int));
            } else if st.sign < 0 {
                array_push(const_factors, _neg(_num(1)));
            }
        } else {
            array_push(const_factors, _num(st.sign * st.float_val));
        }
        let fi = 0;
        while fi < len(st.factors) {
            let f = st.factors[fi];
            let f_ast = _simp(_bin("^", f.base, f.exp));
            if _depends_on(f_ast, v, 0) {
                array_push(var_factors, f_ast);
            } else {
                array_push(const_factors, f_ast);
            }
            fi = fi + 1;
        }
        if len(const_factors) > 0 {
            let c_ast = const_factors[0];
            let ci = 1;
            while ci < len(const_factors) { c_ast = _simp(_bin("*", c_ast, const_factors[ci])); ci = ci + 1; }
            if not _is_num_eq(c_ast, 1) {
                let v_ast = _num(1);
                if len(var_factors) > 0 {
                    v_ast = var_factors[0];
                    let vi = 1;
                    while vi < len(var_factors) { v_ast = _simp(_bin("*", v_ast, var_factors[vi])); vi = vi + 1; }
                }
                let sub = _int_ast(v_ast, v, depth + 1);
                if sub.ok {
                    return map{ ok: true, ast: _simp(_bin("*", c_ast, sub.ast)) };
                }
            }
        }
    }

    // 5. Polynomial directly
    let poly = _extract_poly(s, v, 16);
    if poly.ok {
        let out_c = [0.0];
        let k = 0;
        while k < len(poly.coeffs) {
            array_push(out_c, poly.coeffs[k] / ((k + 1) * 1.0));
            k = k + 1;
        }
        return map{ ok: true, ast: _poly_coeffs_to_ast(out_c, v, 0.0) };
    }

    // 5b. Pure Rational Function P(x)/Q(x) via Hermite Reduction + Rothstein-Trager
    let rat_fn = _extract_rational_poly(s, v, 16);
    if rat_fn.ok {
        let herm = _int_rational_hermite(rat_fn.num_c, rat_fn.den_c, v);
        if herm.ok { return herm; }
    }

    // 6. Power forms: (a*x + b)^p, e^(a*x + b), k^(a*x + b), trig^2
    if s.kind == "bin" and s.op == "^" {
        let base = s.left;
        let exp_n = s.right;
        if not _depends_on(exp_n, v, 0) {
            let p_val = try _eval_ast(exp_n, map{}, 0) catch _nan_val();
            let lin = _match_linear(base, v);
            if lin.ok and not _near_zero(lin.a) and _is_finite(p_val) {
                if num_abs(p_val + 1.0) < 1e-12 {
                    let res = _simp(_bin("/", _call("ln", [_call("abs", [base])]), _num_or_simple_rat(lin.a)));
                    return map{ ok: true, ast: res };
                }
                let np = _simp(_bin("+", exp_n, _num(1)));
                let denom = _simp(_bin("*", _num_or_simple_rat(lin.a), np));
                return map{ ok: true, ast: _simp(_bin("/", _bin("^", base, np), denom)) };
            }
            if _is_num_eq(exp_n, 2) and base.kind == "call" and len(base.args) == 1 {
                let arg_lin = _match_linear(base.args[0], v);
                if arg_lin.ok and not _near_zero(arg_lin.a) {
                    let a_ast = _num_or_simple_rat(arg_lin.a);
                    if base.name == "sec" {
                        return map{ ok: true, ast: _simp(_bin("/", _call("tan", [base.args[0]]), a_ast)) };
                    }
                    if base.name == "csc" {
                        return map{ ok: true, ast: _simp(_neg(_bin("/", _call("cot", [base.args[0]]), a_ast))) };
                    }
                    if base.name == "sin" {
                        let t1 = _bin("/", _sym(v), _num(2));
                        let dbl = _simp(_bin("*", _num(2), base.args[0]));
                        let t2 = _bin("/", _call("sin", [dbl]), _num_or_simple_rat(4.0 * arg_lin.a));
                        return map{ ok: true, ast: _simp(_bin("-", t1, t2)) };
                    }
                    if base.name == "cos" {
                        let t1 = _bin("/", _sym(v), _num(2));
                        let dbl = _simp(_bin("*", _num(2), base.args[0]));
                        let t2 = _bin("/", _call("sin", [dbl]), _num_or_simple_rat(4.0 * arg_lin.a));
                        return map{ ok: true, ast: _simp(_bin("+", t1, t2)) };
                    }
                }
            }
        }
        if not _depends_on(base, v, 0) {
            let lin_e = _match_linear(exp_n, v);
            if lin_e.ok and not _near_zero(lin_e.a) {
                if _is_sym(base) and base.name == "e" {
                    return map{ ok: true, ast: _simp(_bin("/", _call("exp", [exp_n]), _num_or_simple_rat(lin_e.a))) };
                }
                let denom = _simp(_bin("*", _num_or_simple_rat(lin_e.a), _call("ln", [base])));
                return map{ ok: true, ast: _simp(_bin("/", s, denom)) };
            }
        }
    }

    // 7. Elementary function with linear inner argument f(a*x + b)
    if s.kind == "call" and len(s.args) == 1 {
        let u = s.args[0];
        let lin = _match_linear(u, v);
        if lin.ok and not _near_zero(lin.a) {
            let nm = s.name;
            let a_ast = _num_or_simple_rat(lin.a);
            if nm == "sin" { return map{ ok: true, ast: _simp(_neg(_bin("/", _call("cos", [u]), a_ast))) }; }
            if nm == "cos" { return map{ ok: true, ast: _simp(_bin("/", _call("sin", [u]), a_ast)) }; }
            if nm == "tan" { return map{ ok: true, ast: _simp(_neg(_bin("/", _call("ln", [_call("abs", [_call("cos", [u])])]), a_ast))) }; }
            if nm == "cot" { return map{ ok: true, ast: _simp(_bin("/", _call("ln", [_call("abs", [_call("sin", [u])])]), a_ast)) }; }
            if nm == "exp" { return map{ ok: true, ast: _simp(_bin("/", _call("exp", [u]), a_ast)) }; }
            if nm == "sinh" { return map{ ok: true, ast: _simp(_bin("/", _call("cosh", [u]), a_ast)) }; }
            if nm == "cosh" { return map{ ok: true, ast: _simp(_bin("/", _call("sinh", [u]), a_ast)) }; }
            if nm == "tanh" { return map{ ok: true, ast: _simp(_bin("/", _call("ln", [_call("cosh", [u])]), a_ast)) }; }
            if nm == "ln" {
                let num_part = _simp(_bin("-", _bin("*", u, _call("ln", [u])), u));
                return map{ ok: true, ast: _simp(_bin("/", num_part, a_ast)) };
            }
            if nm == "sqrt" {
                let p32 = _bin("^", u, _bin("/", _num(3), _num(2)));
                return map{ ok: true, ast: _simp(_bin("/", _bin("*", _num(2), p32), _num_or_simple_rat(3.0 * lin.a))) };
            }
        }
    }

    // 7b. Risch Exponential Extension (handles exp(a*x^2 + b*x + c), P(x)*exp(g(x)), (N(x)/D(x))*exp(g(x)), exp(g)*(h' + g'*h))
    let sp_exp = _split_exp_factor(s, v);
    if sp_exp.has_exp {
        let risch_e = _solve_risch_exp_de(sp_exp.f_ast, sp_exp.g_ast, v);
        if risch_e.ok { return risch_e; }
    }

    // 7c. Fresnel & Trig Pole Integrals (sin(a*x^2), cos(a*x^2), P(x)*sin(a*x^2), sin(a*x)/x^k, cos(a*x)/x^k)
    let fres_sc = _try_fresnel_or_sincos_pole(s, v);
    if fres_sc.ok { return fres_sc; }

    // 8. Quotient forms: 1/cos^2, 1/sqrt(c - (ax+b)^2), log-derivative f'/f
    if s.kind == "bin" and s.op == "/" {
        let numer = s.left;
        let denom = s.right;

        // 8a. 1 / cos(ax+b)^2 -> tan(ax+b)/a, 1 / sin(ax+b)^2 -> -cot(ax+b)/a
        if not _depends_on(numer, v, 0) and denom.kind == "bin" and denom.op == "^" and _is_num_eq(denom.right, 2) and denom.left.kind == "call" {
            let lin_trig = _match_linear(denom.left.args[0], v);
            if lin_trig.ok and not _near_zero(lin_trig.a) {
                let a_ast = _num_or_simple_rat(lin_trig.a);
                if denom.left.name == "cos" {
                    return map{ ok: true, ast: _simp(_bin("/", _bin("*", numer, _call("tan", [denom.left.args[0]])), a_ast)) };
                }
                if denom.left.name == "sin" {
                    return map{ ok: true, ast: _simp(_neg(_bin("/", _bin("*", numer, _call("cot", [denom.left.args[0]])), a_ast))) };
                }
            }
        }

        // 8b. c / sqrt(k - m*x^2) or c / sqrt(a^2 - (m*x + d)^2) -> asin
        if not _depends_on(numer, v, 0) and denom.kind == "call" and denom.name == "sqrt" and len(denom.args) == 1 {
            let inner_q = _extract_poly(denom.args[0], v, 2);
            if inner_q.ok and inner_q.deg == 1 {
                let sub_lin = _int_ast(_bin("*", numer, _bin("^", denom.args[0], _neg(_bin("/", _num(1), _num(2))))), v, depth + 1);
                if sub_lin.ok { return sub_lin; }
            }
            if inner_q.ok and inner_q.deg == 2 {
                let c0 = inner_q.coeffs[0];
                let c1 = inner_q.coeffs[1];
                let c2 = inner_q.coeffs[2];
                if c2 < 0.0 {
                    let neg_c2 = 0.0 - c2;
                    let top_const = c0 + (c1 * c1) / (4.0 * neg_c2);
                    if top_const > 0.0 {
                        let m_a = num_sqrt(neg_c2);
                        let rad_r = num_sqrt(top_const);
                        let shift_x = _simp(_bin("+", _bin("*", _num_or_simple_rat(m_a), _sym(v)), _num_or_simple_rat(c1 / (2.0 * m_a))));
                        let asin_arg = _simp(_bin("/", shift_x, _num_or_simple_rat(rad_r)));
                        let scale_c = _simp(_bin("/", numer, _num_or_simple_rat(m_a)));
                        return map{ ok: true, ast: _simp(_bin("*", scale_c, _call("asin", [asin_arg]))) };
                    }
                }
            }
        }

        // 8c. Logarithmic derivative rule: ∫ k * f'(x) / f(x) dx = k * ln|f(x)|
        let st_d = [];
        let d_denom = _simp(_diff_ast(denom, v, st_d, 0));
        let cr = _const_ratio(numer, d_denom, v);
        if cr.ok {
            return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("ln", [_call("abs", [denom])]))) };
        }
    }

    // 8d. Risch Logarithmic Tower & Dilogarithm (1/ln(a*x), x^n/ln(x), (ln(x)-1)/ln(x)^2, ln(1-a*x)/x)
    let log_dilog = _try_risch_log_and_dilog(s, v, depth + 1);
    if log_dilog.ok { return log_dilog; }

    // 9. Product forms: u-substitution g'(x)*f(g(x)), LIATE tabular parts P(x)*exp/sin/cos/ln, and exp*sin/cos
    if s.kind == "bin" and (s.op == "*" or s.op == "/") {
        let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(s, false, st_m, 0);
        let scalar_val = if st_m.is_rat { (st_m.sign * st_m.num_int * 1.0) / (st_m.den_int * 1.0) } else { st_m.sign * st_m.float_val };
        let scalar_ast = _num_or_simple_rat(scalar_val);

        let facs = [];
        let i = 0;
        while i < len(st_m.factors) {
            array_push(facs, _simp(_bin("^", st_m.factors[i].base, st_m.factors[i].exp)));
            i = i + 1;
        }

        // 9a. Derivative-times-function recognition: pick factor idx as H(g(x)) or g(x)^p
        let idx = 0;
        while idx < len(facs) {
            let f_main = facs[idx];
            let rest = scalar_ast;
            let j = 0;
            while j < len(facs) {
                if j != idx { rest = _simp(_bin("*", rest, facs[j])); }
                j = j + 1;
            }
            if f_main.kind == "call" and len(f_main.args) == 1 {
                let g = f_main.args[0];
                let st_g = [];
                let dg = _simp(_diff_ast(g, v, st_g, 0));
                let cr = _const_ratio(rest, dg, v);
                if cr.ok {
                    let nm = f_main.name;
                    if nm == "exp" { return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("exp", [g]))) }; }
                    if nm == "sin" { return map{ ok: true, ast: _simp(_neg(_bin("*", cr.k_ast, _call("cos", [g])))) }; }
                    if nm == "cos" { return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("sin", [g]))) }; }
                    if nm == "sinh" { return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("cosh", [g]))) }; }
                    if nm == "cosh" { return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("sinh", [g]))) }; }
                    if nm == "sqrt" {
                        let p32 = _bin("^", g, _bin("/", _num(3), _num(2)));
                        return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _bin("*", _bin("/", _num(2), _num(3)), p32))) };
                    }
                    if nm == "ln" {
                        let part_ln = _simp(_bin("-", _bin("*", g, _call("ln", [g])), g));
                        return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, part_ln)) };
                    }
                }
                let st_fm = [];
                let dfm = _simp(_diff_ast(f_main, v, st_fm, 0));
                let cr_self = _const_ratio(rest, dfm, v);
                if cr_self.ok {
                    let half_k = _simp(_bin("/", cr_self.k_ast, _num(2)));
                    return map{ ok: true, ast: _simp(_bin("*", half_k, _bin("^", f_main, _num(2)))) };
                }
            }
            if f_main.kind == "bin" and f_main.op == "^" and not _depends_on(f_main.right, v, 0) {
                let g = f_main.left;
                let p_val = try _eval_ast(f_main.right, map{}, 0) catch _nan_val();
                let st_g = [];
                let dg = _simp(_diff_ast(g, v, st_g, 0));
                let cr = _const_ratio(rest, dg, v);
                if cr.ok and _is_finite(p_val) {
                    if num_abs(p_val + 1.0) < 1e-12 {
                        return map{ ok: true, ast: _simp(_bin("*", cr.k_ast, _call("ln", [_call("abs", [g])]))) };
                    }
                    let np = _simp(_bin("+", f_main.right, _num(1)));
                    return map{ ok: true, ast: _simp(_bin("/", _bin("*", cr.k_ast, _bin("^", g, np)), np)) };
                }
            }
            idx = idx + 1;
        }

        // 9b. Exponential * Trig: exp(ax + c1) * sin(bx + c2) or cos(bx + c2)
        if len(facs) == 2 {
            let f0 = facs[0];
            let f1 = facs[1];
            let exp_f = nil;
            let trig_f = nil;
            if f0.kind == "call" and f0.name == "exp" and f1.kind == "call" and (f1.name == "sin" or f1.name == "cos") {
                exp_f = f0; trig_f = f1;
            } else if f1.kind == "call" and f1.name == "exp" and f0.kind == "call" and (f0.name == "sin" or f0.name == "cos") {
                exp_f = f1; trig_f = f0;
            }
            if exp_f != nil and trig_f != nil {
                let la = _match_linear(exp_f.args[0], v);
                let lb = _match_linear(trig_f.args[0], v);
                if la.ok and lb.ok and (not _near_zero(la.a) or not _near_zero(lb.a)) {
                    let av = la.a;
                    let bv = lb.a;
                    let den = av * av + bv * bv;
                    let u_trig = trig_f.args[0];
                    let comb = nil;
                    if trig_f.name == "sin" {
                        comb = _simp(_bin("-", _bin("*", _num_or_simple_rat(av), _call("sin", [u_trig])), _bin("*", _num_or_simple_rat(bv), _call("cos", [u_trig]))));
                    } else {
                        comb = _simp(_bin("+", _bin("*", _num_or_simple_rat(av), _call("cos", [u_trig])), _bin("*", _num_or_simple_rat(bv), _call("sin", [u_trig]))));
                    }
                    let scale = _num_or_simple_rat(scalar_val / den);
                    return map{ ok: true, ast: _simp(_bin("*", _bin("*", scale, exp_f), comb)) };
                }
            }
        }

        // 9c. Tabular Integration by Parts (LIATE)
        let trans_idx = -1;
        let ti = 0;
        while ti < len(facs) {
            let fn_node = facs[ti];
            if fn_node.kind == "call" and len(fn_node.args) == 1 {
                if fn_node.name == "exp" or fn_node.name == "sin" or fn_node.name == "cos" or fn_node.name == "ln" {
                    trans_idx = ti;
                    break;
                }
            }
            ti = ti + 1;
        }
        if trans_idx >= 0 {
            let trans = facs[trans_idx];
            let p_part = scalar_ast;
            let pj = 0;
            while pj < len(facs) {
                if pj != trans_idx { p_part = _simp(_bin("*", p_part, facs[pj])); }
                pj = pj + 1;
            }
            let lin_t = _match_linear(trans.args[0], v);
            if trans.name == "ln" and lin_t.ok and not _near_zero(lin_t.a) and _near_zero(lin_t.b) {
                let p_poly = _extract_poly(p_part, v, 8);
                if p_poly.ok {
                    let acc_ln = _num(0);
                    let deg_i = 0;
                    while deg_i < len(p_poly.coeffs) {
                        let ck = p_poly.coeffs[deg_i];
                        if not _near_zero(ck) {
                            let kp1 = deg_i + 1;
                            let x_kp1 = _bin("^", _sym(v), _num(kp1));
                            let lead = _simp(_bin("*", _num_or_simple_rat(ck / (kp1 * 1.0)), x_kp1));
                            let inner_ln = _simp(_bin("-", trans, _rational_to_ast(1, kp1)));
                            acc_ln = _simp(_bin("+", acc_ln, _bin("*", lead, inner_ln)));
                        }
                        deg_i = deg_i + 1;
                    }
                    return map{ ok: true, ast: acc_ln };
                }
                if p_part.kind == "bin" and p_part.op == "^" and _is_sym(p_part.left) and p_part.left.name == v and not _depends_on(p_part.right, v, 0) {
                    let kv = try _eval_ast(p_part.right, map{}, 0) catch _nan_val();
                    if _is_finite(kv) and num_abs(kv + 1.0) > 1e-12 {
                        let kp1 = kv + 1.0;
                        let lead = _bin("/", _bin("^", _sym(v), _num_or_simple_rat(kp1)), _num_or_simple_rat(kp1));
                        let inner_ln = _bin("-", trans, _num_or_simple_rat(1.0 / kp1));
                        return map{ ok: true, ast: _simp(_bin("*", lead, inner_ln)) };
                    }
                }
            }
            if (trans.name == "exp" or trans.name == "sin" or trans.name == "cos") and lin_t.ok and not _near_zero(lin_t.a) {
                let p_poly = _extract_poly(p_part, v, 8);
                if p_poly.ok {
                    let av = lin_t.a;
                    let u_arg = trans.args[0];
                    let cur_p = _poly_coeffs_to_ast(p_poly.coeffs, v, 0.0);
                    let acc_tab = _num(0);
                    let sign_tab = 1;
                    let a_pow = av;
                    let step_j = 0;
                    let st_tab = [];
                    while step_j <= p_poly.deg {
                        let v_anti = nil;
                        if trans.name == "exp" {
                            v_anti = _bin("/", _call("exp", [u_arg]), _num_or_simple_rat(a_pow));
                        } else if trans.name == "sin" {
                            let phase = num_mod(step_j, 4);
                            if phase == 0 { v_anti = _neg(_bin("/", _call("cos", [u_arg]), _num_or_simple_rat(a_pow))); }
                            else if phase == 1 { v_anti = _neg(_bin("/", _call("sin", [u_arg]), _num_or_simple_rat(a_pow))); }
                            else if phase == 2 { v_anti = _bin("/", _call("cos", [u_arg]), _num_or_simple_rat(a_pow)); }
                            else { v_anti = _bin("/", _call("sin", [u_arg]), _num_or_simple_rat(a_pow)); }
                        } else {
                            let phase = num_mod(step_j, 4);
                            if phase == 0 { v_anti = _bin("/", _call("sin", [u_arg]), _num_or_simple_rat(a_pow)); }
                            else if phase == 1 { v_anti = _neg(_bin("/", _call("cos", [u_arg]), _num_or_simple_rat(a_pow))); }
                            else if phase == 2 { v_anti = _neg(_bin("/", _call("sin", [u_arg]), _num_or_simple_rat(a_pow))); }
                            else { v_anti = _bin("/", _call("cos", [u_arg]), _num_or_simple_rat(a_pow)); }
                        }
                        let term_j = _simp(_bin("*", cur_p, v_anti));
                        if sign_tab < 0 { term_j = _neg(term_j); }
                        acc_tab = _simp(_bin("+", acc_tab, term_j));
                        cur_p = _simp(_diff_ast(cur_p, v, st_tab, 0));
                        sign_tab = 0 - sign_tab;
                        a_pow = a_pow * av;
                        step_j = step_j + 1;
                    }
                    return map{ ok: true, ast: _simp(acc_tab) };
                }
            }
        }
    }

    return map{ ok: false };
}

fn _collect_tower_rec(node, v, gens, seen, flags, depth) {
    if depth > MAX_DEPTH { return true; }
    if not _depends_on(node, v, 0) { return true; }
    if node.kind == "neg" { return _collect_tower_rec(node.arg, v, gens, seen, flags, depth + 1); }
    if node.kind == "bin" {
        let _ = _collect_tower_rec(node.left, v, gens, seen, flags, depth + 1);
        let _ = _collect_tower_rec(node.right, v, gens, seen, flags, depth + 1);
        if node.op == "^" and _depends_on(node.left, v, 0) and _depends_on(node.right, v, 0) {
            flags.self_power = true;
        }
        return true;
    }
    if node.kind == "call" {
        let i = 0;
        while i < len(node.args) {
            let _ = _collect_tower_rec(node.args[i], v, gens, seen, flags, depth + 1);
            i = i + 1;
        }
        let k_str = format_ascii(node, 0);
        if not map_has(seen, k_str) {
            seen[k_str] = true;
            array_push(gens, k_str);
        }
        if node.name == "exp" and len(node.args) == 1 {
            let u = node.args[0];
            let pu = _extract_poly(u, v, 10);
            if not pu.ok {
                flags.super_exp = true;
            } else if pu.deg >= 3 {
                flags.high_deg_exp = true;
            } else {
                flags.poly_exp = true;
            }
        }
        if node.name == "sqrt" and len(node.args) == 1 {
            let pq = _extract_poly(node.args[0], v, 10);
            if not pq.ok or pq.deg >= 3 {
                flags.elliptic = true;
            }
        }
        if (node.name == "sin" or node.name == "cos" or node.name == "tan" or node.name == "ln") and len(node.args) == 1 {
            let pl = _extract_poly(node.args[0], v, 10);
            if not pl.ok {
                flags.nested_trans = true;
            }
        }
    }
    return true;
}

// ============================================================================
// 8b. Truncated Power Series (1D Automatic Differentiation Taylor Jet Engine)
// ============================================================================

fn _jet_const(val, n_len) {
    let out = [val * 1.0];
    let i = 1;
    while i < n_len { array_push(out, 0.0); i = i + 1; }
    return out;
}

fn _jet_add(u, v, sign_v) {
    let m = if len(u) < len(v) { len(u) } else { len(v) };
    let out = [];
    let i = 0;
    while i < m {
        array_push(out, u[i] + sign_v * v[i]);
        i = i + 1;
    }
    return out;
}

fn _jet_mul(u, v) {
    let m = if len(u) < len(v) { len(u) } else { len(v) };
    let out = [];
    let k = 0;
    while k < m {
        let s = 0.0;
        let j = 0;
        while j <= k {
            s = s + u[j] * v[k - j];
            j = j + 1;
        }
        array_push(out, s);
        k = k + 1;
    }
    return out;
}

fn _jet_scale(u, sc) {
    let out = [];
    let i = 0;
    while i < len(u) { array_push(out, u[i] * sc); i = i + 1; }
    return out;
}

// Power series division u / v with removable-zero valuation shifting
fn _jet_div(u, v) {
    let m = if len(u) < len(v) { len(u) } else { len(v) };
    let val_v = -1;
    let idx = 0;
    while idx < m {
        if num_abs(v[idx]) > 1e-13 {
            val_v = idx;
            break;
        }
        idx = idx + 1;
    }
    if val_v < 0 { return nil; }
    let z = 0;
    while z < val_v {
        if num_abs(u[z]) > 1e-11 { return nil; }
        z = z + 1;
    }
    let out_len = m - val_v;
    if out_len <= 0 { return nil; }
    let v0 = v[val_v];
    let w = [];
    let k = 0;
    while k < out_len {
        let acc = u[k + val_v];
        let j = 1;
        while j <= k {
            acc = acc - v[j + val_v] * w[k - j];
            j = j + 1;
        }
        let wk = acc / v0;
        if not _is_finite(wk) { return nil; }
        array_push(w, wk);
        k = k + 1;
    }
    return w;
}

fn _jet_pow_nonneg_int(u, p_int) {
    let n_len = len(u);
    if p_int == 0 { return _jet_const(1.0, n_len); }
    if p_int == 1 { return _jet_scale(u, 1.0); }
    let res = _jet_const(1.0, n_len);
    let base = _jet_scale(u, 1.0);
    let e = p_int;
    while e > 0 {
        if num_mod(e, 2) == 1 {
            res = _jet_mul(res, base);
        }
        e = num_floor((e * 1.0) / 2.0);
        if e > 0 {
            base = _jet_mul(base, base);
        }
    }
    return res;
}

fn _jet_exp(u) {
    if not _is_finite(u[0]) or num_abs(u[0]) > 700.0 { return nil; }
    let e0 = num_exp(u[0]);
    if not _is_finite(e0) { return nil; }
    let out = [e0];
    let k = 1;
    while k < len(u) {
        let s = 0.0;
        let j = 1;
        while j <= k {
            s = s + (j * 1.0) * u[j] * out[k - j];
            j = j + 1;
        }
        array_push(out, s / (k * 1.0));
        k = k + 1;
    }
    return out;
}

fn _jet_ln(u) {
    if u[0] <= 1e-14 or not _is_finite(u[0]) { return nil; }
    let out = [num_ln(u[0])];
    let k = 1;
    while k < len(u) {
        let s = 0.0;
        let j = 1;
        while j < k {
            s = s + (j * 1.0) * out[j] * u[k - j];
            j = j + 1;
        }
        array_push(out, (u[k] - s / (k * 1.0)) / u[0]);
        k = k + 1;
    }
    return out;
}

fn _jet_sincos(u) {
    if not _is_finite(u[0]) { return nil; }
    let s_arr = [num_sin(u[0])];
    let c_arr = [num_cos(u[0])];
    let k = 1;
    while k < len(u) {
        let ss = 0.0;
        let sc = 0.0;
        let j = 1;
        while j <= k {
            ss = ss + (j * 1.0) * u[j] * c_arr[k - j];
            sc = sc - (j * 1.0) * u[j] * s_arr[k - j];
            j = j + 1;
        }
        array_push(s_arr, ss / (k * 1.0));
        array_push(c_arr, sc / (k * 1.0));
        k = k + 1;
    }
    return map{ s: s_arr, c: c_arr };
}

fn _jet_sqrt(u) {
    if u[0] <= 1e-14 or not _is_finite(u[0]) { return nil; }
    let r0 = num_sqrt(u[0]);
    let out = [r0];
    let k = 1;
    while k < len(u) {
        let s = 0.0;
        let j = 1;
        while j < k {
            s = s + out[j] * out[k - j];
            j = j + 1;
        }
        array_push(out, (u[k] - s) / (2.0 * r0));
        k = k + 1;
    }
    return out;
}

fn _jet_deriv(u) {
    let out = [];
    let k = 1;
    while k < len(u) {
        array_push(out, (k * 1.0) * u[k]);
        k = k + 1;
    }
    array_push(out, 0.0);
    return out;
}

fn _jet_integrate_chain(f0_val, g_of_u, u_jet) {
    if not _is_finite(f0_val) or g_of_u == nil { return nil; }
    let du = _jet_deriv(u_jet);
    let prod = _jet_mul(g_of_u, du);
    let m = if len(u_jet) < len(prod) { len(u_jet) } else { len(prod) };
    let out = [f0_val];
    let k = 1;
    while k < m {
        array_push(out, prod[k - 1] / (k * 1.0));
        k = k + 1;
    }
    return out;
}

fn _eval_taylor_jet_1d(node, var_name, c0, order, depth) {
    if depth > MAX_DEPTH { return map{ ok: false }; }
    let n_len = if depth == 0 { order + 5 } else { order };
    let k = node.kind;
    if k == "num" {
        return map{ ok: true, c: _jet_const(node.val, n_len) };
    }
    if k == "sym" {
        if node.name == var_name {
            let out = _jet_const(c0, n_len);
            if n_len >= 2 { out[1] = 1.0; }
            return map{ ok: true, c: out };
        }
        if node.name == "pi" { return map{ ok: true, c: _jet_const(PI, n_len) }; }
        if node.name == "e" { return map{ ok: true, c: _jet_const(E_CONST, n_len) }; }
        return map{ ok: false };
    }
    if k == "neg" {
        let sub = _eval_taylor_jet_1d(node.arg, var_name, c0, n_len, depth + 1);
        if not sub.ok { return map{ ok: false }; }
        return map{ ok: true, c: _jet_scale(sub.c, -1.0) };
    }
    if k == "bin" {
        let jl = _eval_taylor_jet_1d(node.left, var_name, c0, n_len, depth + 1);
        if not jl.ok { return map{ ok: false }; }
        let jr = _eval_taylor_jet_1d(node.right, var_name, c0, n_len, depth + 1);
        if not jr.ok { return map{ ok: false }; }
        let op = node.op;
        if op == "+" { return map{ ok: true, c: _jet_add(jl.c, jr.c, 1.0) }; }
        if op == "-" { return map{ ok: true, c: _jet_add(jl.c, jr.c, -1.0) }; }
        if op == "*" { return map{ ok: true, c: _jet_mul(jl.c, jr.c) }; }
        if op == "/" {
            let dv = _jet_div(jl.c, jr.c);
            if dv == nil { return map{ ok: false }; }
            return map{ ok: true, c: dv };
        }
        if op == "^" {
            let is_const_exp = not _depends_on(node.right, var_name, 0);
            if is_const_exp and _is_int_val(jr.c[0]) {
                let pi = num_round(jr.c[0]);
                if num_abs(pi) <= 64 {
                    if pi >= 0 {
                        return map{ ok: true, c: _jet_pow_nonneg_int(jl.c, pi) };
                    }
                    let pos_p = _jet_pow_nonneg_int(jl.c, 0 - pi);
                    let inv_p = _jet_div(_jet_const(1.0, len(pos_p)), pos_p);
                    if inv_p == nil { return map{ ok: false }; }
                    return map{ ok: true, c: inv_p };
                }
            }
            let lnu = _jet_ln(jl.c);
            if lnu == nil { return map{ ok: false }; }
            let ex = _jet_exp(_jet_mul(jr.c, lnu));
            if ex == nil { return map{ ok: false }; }
            return map{ ok: true, c: ex };
        }
        return map{ ok: false };
    }
    if k == "call" and len(node.args) >= 1 {
        let ju = _eval_taylor_jet_1d(node.args[0], var_name, c0, n_len, depth + 1);
        if not ju.ok { return map{ ok: false }; }
        let u = ju.c;
        let m = len(u);
        let nm = node.name;
        if nm == "exp" {
            let r = _jet_exp(u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "ln" {
            let r = _jet_ln(u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "log10" {
            let r = _jet_ln(u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: _jet_scale(r, 1.0 / LN10) };
        }
        if nm == "log" {
            let r = _jet_ln(u);
            if r == nil { return map{ ok: false }; }
            if len(node.args) >= 2 {
                let jb = _eval_taylor_jet_1d(node.args[1], var_name, c0, n_len, depth + 1);
                if not jb.ok { return map{ ok: false }; }
                let rb = _jet_ln(jb.c);
                if rb == nil { return map{ ok: false }; }
                let dv = _jet_div(r, rb);
                if dv == nil { return map{ ok: false }; }
                return map{ ok: true, c: dv };
            }
            return map{ ok: true, c: r };
        }
        if nm == "sin" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            return map{ ok: true, c: sc.s };
        }
        if nm == "cos" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            return map{ ok: true, c: sc.c };
        }
        if nm == "tan" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            let dv = _jet_div(sc.s, sc.c);
            if dv == nil { return map{ ok: false }; }
            return map{ ok: true, c: dv };
        }
        if nm == "cot" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            let dv = _jet_div(sc.c, sc.s);
            if dv == nil { return map{ ok: false }; }
            return map{ ok: true, c: dv };
        }
        if nm == "sec" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            let dv = _jet_div(_jet_const(1.0, len(sc.c)), sc.c);
            if dv == nil { return map{ ok: false }; }
            return map{ ok: true, c: dv };
        }
        if nm == "csc" {
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            let dv = _jet_div(_jet_const(1.0, len(sc.s)), sc.s);
            if dv == nil { return map{ ok: false }; }
            return map{ ok: true, c: dv };
        }
        if nm == "sinh" or nm == "cosh" or nm == "tanh" {
            let ep = _jet_exp(u);
            let em = _jet_exp(_jet_scale(u, -1.0));
            if ep == nil or em == nil { return map{ ok: false }; }
            let sh = _jet_scale(_jet_add(ep, em, -1.0), 0.5);
            let ch = _jet_scale(_jet_add(ep, em, 1.0), 0.5);
            if nm == "sinh" { return map{ ok: true, c: sh }; }
            if nm == "cosh" { return map{ ok: true, c: ch }; }
            let th = _jet_div(sh, ch);
            if th == nil { return map{ ok: false }; }
            return map{ ok: true, c: th };
        }
        if nm == "sqrt" {
            let r = _jet_sqrt(u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "cbrt" {
            if num_abs(u[0]) <= 1e-14 { return map{ ok: false }; }
            let sgn = if u[0] < 0.0 { -1.0 } else { 1.0 };
            let lnu = _jet_ln(_jet_scale(u, sgn));
            if lnu == nil { return map{ ok: false }; }
            let ex = _jet_exp(_jet_scale(lnu, 1.0 / 3.0));
            if ex == nil { return map{ ok: false }; }
            return map{ ok: true, c: _jet_scale(ex, sgn) };
        }
        if nm == "abs" {
            if num_abs(u[0]) <= 1e-13 { return map{ ok: false }; }
            return map{ ok: true, c: _jet_scale(u, if u[0] > 0.0 { 1.0 } else { -1.0 }) };
        }
        if nm == "atan" {
            let g = _jet_div(_jet_const(1.0, m), _jet_add(_jet_const(1.0, m), _jet_mul(u, u), 1.0));
            let r = _jet_integrate_chain(num_atan2(u[0], 1.0), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "asin" or nm == "acos" {
            if num_abs(u[0]) >= 1.0 - 1e-12 { return map{ ok: false }; }
            let sq = _jet_sqrt(_jet_add(_jet_const(1.0, m), _jet_mul(u, u), -1.0));
            if sq == nil { return map{ ok: false }; }
            let g = _jet_div(_jet_const(if nm == "asin" { 1.0 } else { -1.0 }, m), sq);
            let f0 = if nm == "asin" { num_atan2(u[0], num_sqrt(1.0 - u[0] * u[0])) } else { num_atan2(num_sqrt(1.0 - u[0] * u[0]), u[0]) };
            let r = _jet_integrate_chain(f0, g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "erf" or nm == "erfc" or nm == "erfi" {
            let u2 = _jet_mul(u, u);
            let ex = _jet_exp(if nm == "erfi" { u2 } else { _jet_scale(u2, -1.0) });
            if ex == nil { return map{ ok: false }; }
            let sc_e = (if nm == "erfc" { -2.0 } else { 2.0 }) / num_sqrt(PI);
            let f0 = if nm == "erf" { _eval_erf(u[0]) } else if nm == "erfc" { _eval_erfc(u[0]) } else { _eval_erfi(u[0]) };
            let r = _jet_integrate_chain(f0, _jet_scale(ex, sc_e), u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "Ei" {
            if num_abs(u[0]) <= 1e-13 { return map{ ok: false }; }
            let g = _jet_div(_jet_exp(u), u);
            let r = _jet_integrate_chain(_eval_Ei(u[0]), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "li" {
            if u[0] <= 1e-13 or num_abs(u[0] - 1.0) <= 1e-13 { return map{ ok: false }; }
            let g = _jet_div(_jet_const(1.0, m), _jet_ln(u));
            let r = _jet_integrate_chain(_eval_li(u[0]), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "Si" {
            let g = nil;
            if num_abs(u[0]) <= 1e-13 {
                // sinc(u) = sum_{j=0} (-1)^j u^(2j) / (2j + 1)!
                let u2 = _jet_mul(u, u);
                let acc = _jet_const(1.0, m);
                let upow = _jet_const(1.0, m);
                let j = 1;
                while 2 * j < m + 2 {
                    upow = _jet_mul(upow, u2);
                    let sgn = if num_mod(j, 2) == 1 { -1.0 } else { 1.0 };
                    acc = _jet_add(acc, upow, sgn / (_factorial(2 * j + 1) * 1.0));
                    j = j + 1;
                }
                g = acc;
            } else {
                let sc = _jet_sincos(u);
                if sc == nil { return map{ ok: false }; }
                g = _jet_div(sc.s, u);
            }
            let r = _jet_integrate_chain(_eval_Si(u[0]), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "Ci" {
            if u[0] <= 1e-13 { return map{ ok: false }; }
            let sc = _jet_sincos(u);
            if sc == nil { return map{ ok: false }; }
            let g = _jet_div(sc.c, u);
            let r = _jet_integrate_chain(_eval_Ci(u[0]), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "FresnelS" or nm == "FresnelC" {
            let sc = _jet_sincos(_jet_scale(_jet_mul(u, u), 0.5 * PI));
            if sc == nil { return map{ ok: false }; }
            let g = if nm == "FresnelS" { sc.s } else { sc.c };
            let f0 = if nm == "FresnelS" { _eval_FresnelS(u[0]) } else { _eval_FresnelC(u[0]) };
            let r = _jet_integrate_chain(f0, g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "Li2" {
            if u[0] >= 1.0 - 1e-12 { return map{ ok: false }; }
            let g = nil;
            if num_abs(u[0]) <= 1e-13 {
                // -ln(1 - u)/u = sum_{j=0} u^j / (j + 1)
                let acc = _jet_const(1.0, m);
                let upow = _jet_const(1.0, m);
                let j = 1;
                while j < m {
                    upow = _jet_mul(upow, u);
                    acc = _jet_add(acc, upow, 1.0 / ((j + 1) * 1.0));
                    j = j + 1;
                }
                g = acc;
            } else {
                let l1mu = _jet_ln(_jet_add(_jet_const(1.0, m), u, -1.0));
                if l1mu == nil { return map{ ok: false }; }
                g = _jet_div(_jet_scale(l1mu, -1.0), u);
            }
            let r = _jet_integrate_chain(_eval_Li2(u[0]), g, u);
            if r == nil { return map{ ok: false }; }
            return map{ ok: true, c: r };
        }
        if nm == "lambertw" {
            let e_inv = 1.0 / E_CONST;
            if u[0] <= (0.0 - e_inv) + 1e-12 { return map{ ok: false }; }
            let w0 = _eval_lambertw(u[0]);
            if not _is_finite(w0) { return map{ ok: false }; }
            // Implicit ODE: w' = u' / (exp(w) * (1 + w))
            let w_arr = [w0];
            let ew_arr = [num_exp(w0)];
            let k_w = 1;
            while k_w < m {
                // (u')[k_w - 1] = k_w * u[k_w]
                // Note (w * exp(w))[k_w] = u[k_w]:
                // sum_{j=0}^{k_w} w[j] * ew[k_w - j] = u[k_w], with ew[k_w] = (1/k_w) * sum_{r=1}^{k_w} r * w[r] * ew[k_w - r]
                // Coefficient of w[k_w] in (w * exp(w))[k_w] is ew[0] + w[0] * ew[0] = ew[0] * (1 + w[0])!
                let rem_ew = 0.0;
                let r_i = 1;
                while r_i < k_w {
                    rem_ew = rem_ew + (r_i * 1.0) * w_arr[r_i] * ew_arr[k_w - r_i];
                    r_i = r_i + 1;
                }
                let ew_part = rem_ew / (k_w * 1.0);
                let rem_prod = w_arr[0] * ew_part;
                let j_i = 1;
                while j_i < k_w {
                    rem_prod = rem_prod + w_arr[j_i] * ew_arr[k_w - j_i];
                    j_i = j_i + 1;
                }
                let wk = (u[k_w] - rem_prod) / (ew_arr[0] * (1.0 + w_arr[0]));
                array_push(w_arr, wk);
                array_push(ew_arr, ew_part + wk * ew_arr[0]);
                k_w = k_w + 1;
            }
            return map{ ok: true, c: w_arr };
        }
    }
    return map{ ok: false };
}

// Liouville's Theorem Differential Extension Tower Analyzer + Maclaurin/Taylor Series Antiderivative Fallback
fn _liouville_obstruction_analysis(f_ast, var_name) {
    let gens = ["R(" + var_name + ")"];
    let seen = map{};
    let flags = map{ super_exp: false, high_deg_exp: false, poly_exp: false, elliptic: false, nested_trans: false, self_power: false };
    let _ = _collect_tower_rec(f_ast, var_name, gens, seen, flags, 0);

    let code = "liouville_non_elementary";
    let reason = "Liouville's Theorem obstruction: differential extension tower admits no elementary or canonical real special-function antiderivative.";
    if flags.super_exp or flags.self_power {
        code = "super_exponential_tower";
        reason = "Liouville-Risch obstruction in nested exponential tower: Risch differential equation q' + u'*q = f has no solution in base field due to unbounded exponential degree growth.";
    } else if flags.elliptic {
        code = "elliptic_or_hyperelliptic_radical";
        reason = "Liouville algebraic-extension obstruction: genus >= 1 elliptic/hyperelliptic radical integral has no elementary antiderivative.";
    } else if flags.high_deg_exp or flags.poly_exp {
        code = "exponential_extension_risch_de_unsolvable";
        reason = "Liouville's Theorem obstruction: Risch exponential differential equation leaves non-vanishing residual with non-real or higher-degree poles.";
    } else if flags.nested_trans {
        code = "nested_transcendental_tower";
        reason = "Liouville-Bronstein monomial tower obstruction: nested transcendental generator admits no elementary antiderivative.";
    }

    // Build series antiderivative around regular point via O(d^2) AD Taylor Jet (prefer 0.0, fallback 1.0 or 0.5)
    let centers = [0.0, 1.0, 0.5];
    let c_used = 0.0;
    let s_ast = _num(0);
    let s_ok = false;
    let ci = 0;
    while ci < len(centers) {
        let c0 = centers[ci];
        let jet = _eval_taylor_jet_1d(f_ast, var_name, c0, 6, 0);
        if jet.ok and len(jet.c) >= 6 {
            let terms = [];
            let k = 0;
            while k <= 5 {
                let ck = _snap_num(jet.c[k] / ((k + 1) * 1.0));
                if not _near_zero(ck) {
                    let base = if _near_zero(c0) { _sym(var_name) } else { _simp(_bin("-", _sym(var_name), _num_or_simple_rat(c0))) };
                    let xpow = if k + 1 == 1 { base } else { _bin("^", base, _num(k + 1)) };
                    array_push(terms, _simp(_bin("*", _num_or_simple_rat(ck), xpow)));
                }
                k = k + 1;
            }
            c_used = c0;
            s_ok = true;
            if len(terms) > 0 {
                s_ast = terms[0];
                let ti = 1;
                while ti < len(terms) {
                    let nxt = terms[ti];
                    if nxt.kind == "neg" { s_ast = _bin("-", s_ast, nxt.arg); }
                    else { s_ast = _bin("+", s_ast, nxt); }
                    ti = ti + 1;
                }
            }
            break;
        }
        ci = ci + 1;
    }

    let s_asc = if s_ok { format_ascii(s_ast, 0) } else { nil };
    let s_ltx = if s_ok { format_latex(s_ast, 0) } else { nil };
    return map{
        code: code,
        reason: reason,
        tower: gens,
        center: c_used,
        series_ok: s_ok,
        series_ascii: s_asc,
        series_latex: s_ltx,
        series_ast: if s_ok { s_ast } else { nil }
    };
}

fn integrate_symbolic(expr, var_name = "x") {
    let f_ast = _simp(parse_expr(expr));
    let res = _int_ast(f_ast, var_name, 0);
    if not res.ok {
        let obs = _liouville_obstruction_analysis(f_ast, var_name);
        return map{
            ok: false,
            verified: false,
            is_elementary: false,
            uses_special_functions: false,
            liouville_non_elementary: true,
            liouville_obstruction: obs,
            series_antiderivative: obs.series_ascii,
            error: "calculus_ode: no closed-form antiderivative matched for '" + format_ascii(f_ast, 0) + "' (" + obs.code + ")"
        };
    }
    let F_ast = _simp(res.ast);

    // Automatic derivative verification: check d/dx F(x) == f(x) at generic test points
    let st_v = [];
    let dF_ast = _simp(_diff_ast(F_ast, var_name, st_v, 0));
    let probes = [0.07, -0.09, 0.19, 0.37, 0.73, 1.31, 1.87, 2.41, -0.59, -1.43];
    let tested = 0;
    let passed = 0;
    let i = 0;
    while i < len(probes) {
        let xv = probes[i];
        let fv = _eval_1d(f_ast, var_name, xv);
        let dfv = _eval_1d(dF_ast, var_name, xv);
        if _is_finite(fv) and _is_finite(dfv) {
            tested = tested + 1;
            let scale = 1.0 + num_abs(fv);
            if num_abs(fv - dfv) < 1e-6 * scale {
                passed = passed + 1;
            }
        }
        i = i + 1;
    }
    let is_verified = tested > 0 and passed == tested;
    let uses_spec = _uses_special_func(F_ast, 0);
    let is_elem = not uses_spec;
    let asc = format_ascii(F_ast, 0);
    let uni = format_unicode(F_ast, 0);
    let ltx = format_latex(F_ast, 0);
    return map{
        ok: true,
        is_elementary: is_elem,
        uses_special_functions: uses_spec,
        antiderivative: asc,
        expr: asc + " + C",
        ascii: asc + " + C",
        unicode: uni + " + C",
        latex: ltx + " + C",
        ast: F_ast,
        verified: is_verified,
        tested_points: tested,
        evaluate: fn(xv) { return _eval_1d(F_ast, var_name, xv); }
    };
}

fn risch_integrate(expr, var_name = "x") {
    let f_ast = _simp(parse_expr(expr));
    let sym = integrate_symbolic(f_ast, var_name);
    let gens = ["R(" + var_name + ")"];
    let seen = map{};
    let flags = map{ super_exp: false, high_deg_exp: false, poly_exp: false, elliptic: false, nested_trans: false, self_power: false };
    let _ = _collect_tower_rec(f_ast, var_name, gens, seen, flags, 0);

    if sym.ok {
        let base_pt = if _is_finite(_eval_1d(f_ast, var_name, 0.0)) { 0.0 } else { 1.0 };
        return map{
            ok: true,
            closed_form_found: true,
            is_elementary: sym.is_elementary,
            uses_special_functions: sym.uses_special_functions,
            liouville_non_elementary: not sym.is_elementary,
            antiderivative: sym.antiderivative,
            expr: sym.expr,
            ascii: sym.ascii,
            unicode: sym.unicode,
            latex: sym.latex,
            ast: sym.ast,
            verified: sym.verified,
            tested_points: sym.tested_points,
            differential_tower: gens,
            evaluate: sym.evaluate,
            evaluate_from_zero: fn(xv) { return integrate_definite(f_ast, var_name, base_pt, xv).value; }
        };
    }

    let obs = sym.liouville_obstruction;
    let q_origin = if _is_finite(_eval_1d(f_ast, var_name, 0.0)) { 0.0 } else { obs.center };
    return map{
        ok: true,
        closed_form_found: false,
        is_elementary: false,
        uses_special_functions: false,
        liouville_non_elementary: true,
        liouville_obstruction: obs,
        obstruction_code: obs.code,
        obstruction_proof: obs.reason,
        differential_tower: obs.tower,
        series_approximation: obs.series_ascii,
        series_latex: obs.series_latex,
        series_ast: obs.series_ast,
        center: obs.center,
        evaluate_from_zero: fn(xv) { return integrate_definite(f_ast, var_name, q_origin, xv).value; }
    };
}

// ============================================================================
// 9. High-Precision Definite Quadrature: Adaptive Gauss-Kronrod G7-K15,
//    Tanh-Sinh (Double-Exponential), and 2D Iterated Quadrature
// ============================================================================

let _GK15_X = [
    0.9914553711208126,
    0.9491079123427585,
    0.8648644233597691,
    0.7415311855993945,
    0.5860872354676911,
    0.4058451513773972,
    0.2077849550078985,
    0.0
];

let _GK15_WK = [
    0.02293532201052922,
    0.06309209262997856,
    0.1047900103222502,
    0.1406532597155259,
    0.1690047266392679,
    0.1903505780647854,
    0.2044329400752989,
    0.2094821410847278
];

let _GK15_WG = [
    0.0,
    0.1294849661688697,
    0.0,
    0.2797053914892766,
    0.0,
    0.3818300505051189,
    0.0,
    0.4179591836734694
];

fn _make_1d_callable(expr_or_fn, var_name) {
    if type(expr_or_fn) == "fn" {
        return expr_or_fn;
    }
    let ast = _simp(parse_expr(expr_or_fn));
    return fn(xv) { return _eval_1d(ast, var_name, xv); };
}

fn _gk15_panel(f, a, b, counter) {
    let mid = 0.5 * (a + b);
    let half = 0.5 * (b - a);
    let f_mid = f(mid);
    counter.evals = counter.evals + 1;
    let res_k = _GK15_WK[7] * f_mid;
    let res_g = _GK15_WG[7] * f_mid;
    let j = 0;
    while j < 7 {
        let absc = half * _GK15_X[j];
        let f1 = f(mid - absc);
        let f2 = f(mid + absc);
        counter.evals = counter.evals + 2;
        let fsum = f1 + f2;
        res_k = res_k + _GK15_WK[j] * fsum;
        if _GK15_WG[j] > 0.0 {
            res_g = res_g + _GK15_WG[j] * fsum;
        }
        j = j + 1;
    }
    let ik = res_k * half;
    let ig = res_g * half;
    let err = num_abs(ik - ig);
    // QUADPACK-style realistic error scaling: (200 * |Ik - Ig|)^1.5 bounded safely
    return map{ val: ik, err: err, ok: _is_finite(ik) and _is_finite(err) };
}

fn _gk15_adapt(f, a, b, tol, depth, counter) {
    let p = _gk15_panel(f, a, b, counter);
    if not p.ok {
        return p;
    }
    if p.err <= tol or depth >= MAX_QUAD_DEPTH {
        return p;
    }
    let mid = 0.5 * (a + b);
    let left = _gk15_adapt(f, a, mid, 0.5 * tol, depth + 1, counter);
    let right = _gk15_adapt(f, mid, b, 0.5 * tol, depth + 1, counter);
    return map{
        val: left.val + right.val,
        err: left.err + right.err,
        ok: left.ok and right.ok
    };
}

fn _is_inf_bound(b) {
    if type(b) == "string" {
        let s = str_lower(str_trim(b));
        if s == "inf" or s == "+inf" or s == "infinity" or s == "+infinity" { return 1; }
        if s == "-inf" or s == "-infinity" { return -1; }
    }
    return 0;
}

// Tanh-Sinh (Double-Exponential) quadrature on finite (a, b) avoiding endpoint cancellation
fn _tanh_sinh_finite(f, a, b, tol, counter) {
    if a == b { return map{ val: 0.0, err: 0.0 }; }
    let sign = 1.0;
    let lo = a * 1.0;
    let hi = b * 1.0;
    if lo > hi {
        sign = -1.0;
        let tmp = lo; lo = hi; hi = tmp;
    }
    let span = hi - lo;
    let mid = 0.5 * (lo + hi);
    let f0 = f(mid);
    counter.evals = counter.evals + 1;
    let sum_t = f0 * 0.25 * PI; // at t=0: d=0.5, pi * cosh(0) * 0.5 * 0.5 = pi/4
    let h = 1.0;
    let prev_I = span * h * sum_t;
    let best_err = 1e300;
    let level = 0;
    while level < 7 {
        if level > 0 { h = 0.5 * h; }
        let stride = if level == 0 { 1 } else { 2 };
        let k = 1;
        while true {
            let t = k * h;
            if t > 5.6 { break; }
            let sh = 0.5 * (num_exp(t) - num_exp(0.0 - t));
            let ch = 0.5 * (num_exp(t) + num_exp(0.0 - t));
            let two_s = PI * sh;
            if two_s > 650.0 { break; }
            let e2s = num_exp(two_s);
            let d = 1.0 / (e2s + 1.0);
            let one_minus_d = e2s * d;
            let w = PI * ch * d * one_minus_d;
            let offset = span * d;
            let x_left = lo + offset;
            let x_right = hi - offset;
            let contrib_l = 0.0;
            let contrib_r = 0.0;
            if x_left > lo and x_left < hi {
                let fl = f(x_left);
                counter.evals = counter.evals + 1;
                if _is_finite(fl) and _is_finite(w * fl) {
                    contrib_l = w * fl;
                    sum_t = sum_t + contrib_l;
                }
            }
            if x_right > lo and x_right < hi {
                let fr = f(x_right);
                counter.evals = counter.evals + 1;
                if _is_finite(fr) and _is_finite(w * fr) {
                    contrib_r = w * fr;
                    sum_t = sum_t + contrib_r;
                }
            }
            if w < 1e-18 and num_abs(contrib_l) < 1e-18 and num_abs(contrib_r) < 1e-18 and k > 4 {
                break;
            }
            k = k + stride;
        }
        let cur_I = span * h * sum_t;
        if level >= 2 {
            let diff_I = num_abs(cur_I - prev_I);
            best_err = diff_I;
            if diff_I <= tol {
                return map{ val: sign * cur_I, err: diff_I };
            }
        }
        prev_I = cur_I;
        level = level + 1;
    }
    return map{ val: sign * prev_I, err: best_err };
}

// Double-Exponential quadrature on [a, +infinity) via x = a + u/(1-u) composed with logistic(pi*sinh(t)) => x = a + exp(pi*sinh(t))
fn _de_semi_infinite_pos(f, a, tol, counter) {
    let a0 = a * 1.0;
    let f0 = f(a0 + 1.0);
    counter.evals = counter.evals + 1;
    let sum_t = if _is_finite(f0) { PI * f0 } else { 0.0 };
    let h = 1.0;
    let prev_I = h * sum_t;
    let best_err = 1e300;
    let level = 0;
    while level < 7 {
        if level > 0 { h = 0.5 * h; }
        let stride = if level == 0 { 1 } else { 2 };
        let k = 1;
        while true {
            let t = k * h;
            if t > 5.0 { break; }
            let sh = 0.5 * (num_exp(t) - num_exp(0.0 - t));
            let ch = 0.5 * (num_exp(t) + num_exp(0.0 - t));
            let ps = PI * sh;
            if ps > 600.0 { break; }
            // Positive t: x = a + exp(+ps), dx/dt = pi * ch * exp(+ps)
            let ep = num_exp(ps);
            let wp = PI * ch * ep;
            let fp = f(a0 + ep);
            counter.evals = counter.evals + 1;
            let contrib_p = if _is_finite(fp) and _is_finite(fp * wp) { fp * wp } else { 0.0 };

            // Negative t: x = a + exp(-ps), dx/dt = pi * ch * exp(-ps)
            let em = num_exp(0.0 - ps);
            let wm = PI * ch * em;
            let contrib_m = 0.0;
            if a0 + em > a0 {
                let fm = f(a0 + em);
                counter.evals = counter.evals + 1;
                if _is_finite(fm) and _is_finite(fm * wm) { contrib_m = fm * wm; }
            }
            sum_t = sum_t + contrib_p + contrib_m;
            if num_abs(contrib_p) < 1e-18 and num_abs(contrib_m) < 1e-18 and k > 4 {
                break;
            }
            k = k + stride;
        }
        let cur_I = h * sum_t;
        if level >= 2 {
            let diff_I = num_abs(cur_I - prev_I);
            best_err = diff_I;
            if diff_I <= tol {
                return map{ val: cur_I, err: diff_I };
            }
        }
        prev_I = cur_I;
        level = level + 1;
    }
    return map{ val: prev_I, err: best_err };
}

fn integrate_improper_or_singular(expr_or_fn, var_name = "x", a = 0.0, b = 1.0, tol = 1e-11) {
    let f = _make_1d_callable(expr_or_fn, var_name);
    let counter = map{ evals: 0 };
    let ia = _is_inf_bound(a);
    let ib = _is_inf_bound(b);

    if ia == -1 and ib == 1 {
        // (-inf, +inf) = (-inf, 0] + [0, +inf)
        let f_neg = fn(u) { return f(0.0 - u); };
        let r_neg = _de_semi_infinite_pos(f_neg, 0.0, 0.5 * tol, counter);
        let r_pos = _de_semi_infinite_pos(f, 0.0, 0.5 * tol, counter);
        return map{
            value: r_neg.val + r_pos.val,
            error_estimate: r_neg.err + r_pos.err,
            evaluations: counter.evals,
            method: "tanh_sinh_double_exponential_inf"
        };
    }
    if ia == 0 and ib == 1 {
        let r_pos = _de_semi_infinite_pos(f, a * 1.0, tol, counter);
        return map{
            value: r_pos.val,
            error_estimate: r_pos.err,
            evaluations: counter.evals,
            method: "tanh_sinh_semi_infinite_right"
        };
    }
    if ia == -1 and ib == 0 {
        let b0 = b * 1.0;
        let f_shift = fn(u) { return f(b0 - u); };
        let r_neg = _de_semi_infinite_pos(f_shift, 0.0, tol, counter);
        return map{
            value: r_neg.val,
            error_estimate: r_neg.err,
            evaluations: counter.evals,
            method: "tanh_sinh_semi_infinite_left"
        };
    }
    if ia == 1 and ib == -1 {
        let rev = integrate_improper_or_singular(f, var_name, "-inf", "+inf", tol);
        return map{
            value: 0.0 - rev.value,
            error_estimate: rev.error_estimate,
            evaluations: rev.evaluations,
            method: "tanh_sinh_double_exponential_inf"
        };
    }

    let r_fin = _tanh_sinh_finite(f, a * 1.0, b * 1.0, tol, counter);
    return map{
        value: r_fin.val,
        error_estimate: r_fin.err,
        evaluations: counter.evals,
        method: "tanh_sinh_endpoint_singular"
    };
}

fn integrate_definite(expr_or_fn, var_name = "x", a = 0.0, b = 1.0, tol = 1e-12) {
    if _is_inf_bound(a) != 0 or _is_inf_bound(b) != 0 {
        let imp = integrate_improper_or_singular(expr_or_fn, var_name, a, b, tol);
        return map{
            value: imp.value,
            error_estimate: imp.error_estimate,
            evaluations: imp.evaluations,
            exact_symbolic_value: nil,
            method: imp.method
        };
    }
    let f = _make_1d_callable(expr_or_fn, var_name);
    let counter = map{ evals: 0 };
    let a_num = a * 1.0;
    let b_num = b * 1.0;
    let gk = _gk15_adapt(f, a_num, b_num, tol, 0, counter);

    let val = gk.val;
    let err = gk.err;
    let method = "gauss_kronrod_g7_k15";
    // Fallback to Tanh-Sinh if endpoint singularity produced NaN/Inf in G7-K15
    if not gk.ok {
        let ts = _tanh_sinh_finite(f, a_num, b_num, tol, counter);
        val = ts.val;
        err = ts.err;
        method = "tanh_sinh_fallback";
    }

    let exact_sym = nil;
    if type(expr_or_fn) == "string" or (type(expr_or_fn) == "map" and map_has(expr_or_fn, "kind")) {
        let sym_res = try integrate_symbolic(expr_or_fn, var_name) catch map{ ok: false };
        if sym_res.ok and sym_res.verified {
            let fa = sym_res.evaluate(a_num);
            let fb = sym_res.evaluate(b_num);
            if _is_finite(fa) and _is_finite(fb) {
                let fdiff = fb - fa;
                if num_abs(fdiff - val) < 1e-5 * (1.0 + num_abs(val)) {
                    exact_sym = fdiff;
                }
            }
        }
    }

    return map{
        value: val,
        error_estimate: err,
        evaluations: counter.evals,
        exact_symbolic_value: exact_sym,
        method: method
    };
}

fn integrate_2d(expr_or_fn, xvar, ax, bx, yvar, ay_or_expr, by_or_expr, tol = 1e-9) {
    let f2 = nil;
    if type(expr_or_fn) == "fn" {
        f2 = expr_or_fn;
    } else {
        let ast2 = _simp(parse_expr(expr_or_fn));
        f2 = fn(xv, yv) {
            let env = map{};
            env[xvar] = xv * 1.0;
            env[yvar] = yv * 1.0;
            return _eval_ast(ast2, env, 0);
        };
    }

    let ay_fn = nil;
    if type(ay_or_expr) == "number" {
        let c_ay = ay_or_expr * 1.0;
        ay_fn = fn(_x) { return c_ay; };
    } else if type(ay_or_expr) == "fn" {
        ay_fn = ay_or_expr;
    } else {
        let ay_ast = _simp(parse_expr(ay_or_expr));
        ay_fn = fn(xv) { return _eval_1d(ay_ast, xvar, xv); };
    }

    let by_fn = nil;
    if type(by_or_expr) == "number" {
        let c_by = by_or_expr * 1.0;
        by_fn = fn(_x) { return c_by; };
    } else if type(by_or_expr) == "fn" {
        by_fn = by_or_expr;
    } else {
        let by_ast = _simp(parse_expr(by_or_expr));
        by_fn = fn(xv) { return _eval_1d(by_ast, xvar, xv); };
    }

    let inner_counter = map{ evals: 0 };
    let outer_fn = fn(xv) {
        let y_lo = ay_fn(xv);
        let y_hi = by_fn(xv);
        let slice_f = fn(yv) { return f2(xv, yv); };
        let r = _gk15_adapt(slice_f, y_lo, y_hi, 0.25 * tol, 0, inner_counter);
        return r.val;
    };
    let outer_counter = map{ evals: 0 };
    let res = _gk15_adapt(outer_fn, ax * 1.0, bx * 1.0, tol, 0, outer_counter);
    return map{
        value: res.val,
        error_estimate: res.err,
        evaluations: inner_counter.evals
    };
}

// ============================================================================
// 10. Limits (Symbolic L'Hopital, Rational Cancellation, Richardson, Jump Check),
//     Taylor / Maclaurin Series, Pade Approximants & Summations
// ============================================================================

fn _ast_node_count(node, depth) {
    if depth > MAX_DEPTH or type(node) != "map" { return 1; }
    let k = node.kind;
    if k == "num" or k == "sym" { return 1; }
    if k == "neg" { return 1 + _ast_node_count(node.arg, depth + 1); }
    if k == "bin" { return 1 + _ast_node_count(node.left, depth + 1) + _ast_node_count(node.right, depth + 1); }
    if k == "call" {
        let s = 1;
        let i = 0;
        while i < len(node.args) {
            s = s + _ast_node_count(node.args[i], depth + 1);
            i = i + 1;
        }
        return s;
    }
    return 1;
}

// Continued-fraction rational recovery up to denominator max_den
fn _cf_rational_approx(val, max_den, tol) {
    if type(val) != "number" or not _is_finite(val) {
        return map{ ok: false };
    }
    if num_abs(val) <= tol {
        return map{ ok: true, p: 0, q: 1, str: "0", exact_val: 0 };
    }
    let sgn = if val < 0.0 { -1 } else { 1 };
    let x = num_abs(val);
    let rx = num_round(x);
    if num_abs(x - rx) <= tol * (1.0 + x) and rx <= 9007199254740991.0 {
        let p_int = sgn * rx;
        return map{ ok: true, p: p_int, q: 1, str: str(p_int), exact_val: p_int };
    }
    let p_prev = 0;
    let p_cur = 1;
    let q_prev = 1;
    let q_cur = 0;
    let rem = x;
    let iter = 0;
    while iter < 20 {
        let a = num_floor(rem);
        let p_next = a * p_cur + p_prev;
        let q_next = a * q_cur + q_prev;
        if q_next > max_den or q_next <= 0 { break; }
        p_prev = p_cur; p_cur = p_next;
        q_prev = q_cur; q_cur = q_next;
        let approx = (p_cur * 1.0) / (q_cur * 1.0);
        if num_abs(x - approx) <= tol * (1.0 + x) {
            let g = _gcd_int(p_cur, q_cur);
            let pn = sgn * num_round(p_cur / g);
            let qn = num_round(q_cur / g);
            let f_str = if qn == 1 { str(pn) } else { str(pn) + "/" + str(qn) };
            let ex_v = if qn == 1 { pn } else { (pn * 1.0) / (qn * 1.0) };
            return map{ ok: true, p: pn, q: qn, str: f_str, exact_val: ex_v };
        }
        let frac = rem - a;
        if frac < 1e-13 { break; }
        rem = 1.0 / frac;
        iter = iter + 1;
    }
    return map{ ok: false };
}

fn _inf_sign_val(v) {
    if type(v) == "string" {
        if v == "+inf" or v == "inf" { return 1; }
        if v == "-inf" { return -1; }
    }
    return 0;
}

fn _make_limit_res(exists, val, left_lim, right_lim, method, indet_form, steps, opts) {
    let out_val = val;
    let exact_frac = nil;
    if exists and type(out_val) == "number" and _is_finite(out_val) {
        let cf = _cf_rational_approx(out_val, 10000, 1e-11);
        if cf.ok {
            exact_frac = cf.str;
            out_val = cf.exact_val;
            if type(left_lim) == "number" and num_abs(left_lim - out_val) < 1e-9 { left_lim = out_val; }
            if type(right_lim) == "number" and num_abs(right_lim - out_val) < 1e-9 { right_lim = out_val; }
        } else {
            out_val = _snap_num(out_val);
        }
    }
    let sym_val = nil;
    if type(opts) == "map" and map_has(opts, "symbolic_value") and opts.symbolic_value != nil {
        sym_val = opts.symbolic_value;
    } else if exact_frac != nil {
        sym_val = exact_frac;
    } else if exists and type(out_val) == "string" {
        sym_val = out_val;
    } else if exists and type(out_val) == "number" and _is_finite(out_val) {
        if num_abs(out_val - E_CONST) < 1e-11 { sym_val = "exp(1)"; }
        else if num_abs(out_val - 1.0 / E_CONST) < 1e-11 { sym_val = "exp(-1)"; }
        else if num_abs(out_val - PI) < 1e-11 { sym_val = "pi"; }
        else { sym_val = str(out_val); }
    }
    let osc_b = if type(opts) == "map" and map_has(opts, "oscillation_bounds") { opts.oscillation_bounds } else { nil };
    let dom_r = if type(opts) == "map" and map_has(opts, "domain_restricted") { opts.domain_restricted } else { nil };
    return map{
        exists: exists,
        value: out_val,
        left_limit: left_lim,
        right_limit: right_lim,
        method: method,
        indeterminate_form: indet_form,
        exact_fraction: exact_frac,
        symbolic_value: sym_val,
        oscillation_bounds: osc_b,
        domain_restricted: dom_r,
        steps: steps
    };
}

fn _lim_is_zero(r) {
    return r.exists and type(r.value) == "number" and _is_finite(r.value) and num_abs(r.value) < 1e-11;
}

fn _lim_is_one(r) {
    return r.exists and type(r.value) == "number" and _is_finite(r.value) and num_abs(r.value - 1.0) < 1e-11;
}

fn _lim_tends_abs_inf(r) {
    if r.exists and _inf_sign_val(r.value) != 0 { return true; }
    if not r.exists and r.indeterminate_form == "pole" { return true; }
    if _inf_sign_val(r.left_limit) != 0 and _inf_sign_val(r.right_limit) != 0 { return true; }
    if _inf_sign_val(r.right_limit) != 0 and r.left_limit == nil { return true; }
    if _inf_sign_val(r.left_limit) != 0 and r.right_limit == nil { return true; }
    return false;
}

fn _contains_abs_zero_at(node, var_name, c_val, depth) {
    if depth > MAX_DEPTH { return false; }
    if node.kind == "call" and node.name == "abs" and len(node.args) == 1 {
        let u_val = _eval_1d(node.args[0], var_name, c_val);
        if _is_finite(u_val) and num_abs(u_val) < 1e-11 { return true; }
    }
    if node.kind == "neg" { return _contains_abs_zero_at(node.arg, var_name, c_val, depth + 1); }
    if node.kind == "bin" {
        return _contains_abs_zero_at(node.left, var_name, c_val, depth + 1) or _contains_abs_zero_at(node.right, var_name, c_val, depth + 1);
    }
    if node.kind == "call" {
        let i = 0;
        while i < len(node.args) {
            if _contains_abs_zero_at(node.args[i], var_name, c_val, depth + 1) { return true; }
            i = i + 1;
        }
    }
    return false;
}

// One-sided numerical limit as x -> c + sign*h (sign = +1 or -1) using Richardson + blowup detection
fn _one_sided_limit(ast, var_name, c_val, sign) {
    let hs = [1e-2, 5e-3, 2.5e-3, 1.25e-3, 6.25e-4, 3.125e-4];
    let vals = [];
    let i = 0;
    while i < len(hs) {
        let xv = c_val + sign * hs[i];
        let fv = _eval_1d(ast, var_name, xv);
        if not _is_finite(fv) {
            let sv = str(fv);
            if sv == "inf" or sv == "+inf" or sv == "Infinity" or sv == "+Infinity" {
                return map{ kind: "inf", val: "+inf" };
            }
            if sv == "-inf" or sv == "-Infinity" {
                return map{ kind: "inf", val: "-inf" };
            }
            if len(vals) >= 2 and num_abs(vals[len(vals) - 1]) > 1e20 and num_abs(vals[len(vals) - 1]) > 10.0 * num_abs(vals[len(vals) - 2]) {
                return map{ kind: "inf", val: if vals[len(vals) - 1] > 0.0 { "+inf" } else { "-inf" } };
            }
            return map{ kind: "undefined", val: nil };
        }
        array_push(vals, fv);
        i = i + 1;
    }
    // 1. Power / exponential blowup to +/- infinity
    let a3 = num_abs(vals[3]);
    let a4 = num_abs(vals[4]);
    let a5 = num_abs(vals[5]);
    if a5 > 500.0 and a5 > 1.7 * a4 and a4 > 1.7 * a3 {
        if vals[5] > 0 { return map{ kind: "inf", val: "+inf" }; }
        return map{ kind: "inf", val: "-inf" };
    }
    // 2. Logarithmic / slow monotone blowup check across decades 1e-4, 1e-7, 1e-10, 1e-13
    let f_d1 = _eval_1d(ast, var_name, c_val + sign * 1e-4);
    let f_d2 = _eval_1d(ast, var_name, c_val + sign * 1e-7);
    let f_d3 = _eval_1d(ast, var_name, c_val + sign * 1e-10);
    let f_d4 = _eval_1d(ast, var_name, c_val + sign * 1e-13);
    if _is_finite(f_d1) and _is_finite(f_d2) and _is_finite(f_d3) and _is_finite(f_d4) {
        let s1 = f_d2 - f_d1;
        let s2 = f_d3 - f_d2;
        let s3 = f_d4 - f_d3;
        if num_abs(f_d4) > 15.0 and s1 * s2 > 0.0 and s2 * s3 > 0.0 and num_abs(s3) >= 0.9 * num_abs(s2) and num_abs(s2) > 0.2 {
            if f_d4 > 0.0 { return map{ kind: "inf", val: "+inf" }; }
            return map{ kind: "inf", val: "-inf" };
        }
        // Check decade-level power blowup (e.g. 1/sqrt(x) where 2^-0.5 = 1.414 < 1.7)
        if num_abs(f_d4) > 1e5 and num_abs(f_d4) > 15.0 * num_abs(f_d3) and num_abs(f_d3) > 15.0 * num_abs(f_d2) and f_d4 * f_d3 > 0.0 {
            if f_d4 > 0.0 { return map{ kind: "inf", val: "+inf" }; }
            return map{ kind: "inf", val: "-inf" };
        }
    }
    // 3. Constant sequence immediately (e.g. abs(x)/x -> +1 or -1)
    if num_abs(vals[5] - vals[4]) < 1e-13 and num_abs(vals[4] - vals[3]) < 1e-13 {
        return map{ kind: "finite", val: _snap_num(vals[5]) };
    }
    // 4. Neville / Richardson extrapolation in h -> 0
    let m = len(hs);
    let tab = [];
    let k = 0;
    while k < m {
        array_push(tab, [vals[k]]);
        k = k + 1;
    }
    let col = 1;
    while col < m {
        let row = col;
        while row < m {
            let ratio = hs[row - col] / hs[row];
            let extrap = (ratio * tab[row][col - 1] - tab[row - 1][col - 1]) / (ratio - 1.0);
            array_push(tab[row], extrap);
            row = row + 1;
        }
        col = col + 1;
    }
    let est = tab[m - 1][m - 1];
    let prev = tab[m - 2][m - 2];
    if _is_finite(est) and num_abs(est - prev) < 1e-4 * (1.0 + num_abs(est)) {
        return map{ kind: "finite", val: _snap_num(est) };
    }
    // Check closer decade samples for fractional power limits like sqrt(x) -> 0
    if _is_finite(f_d3) and _is_finite(f_d4) and num_abs(f_d4 - f_d3) < 1e-5 * (1.0 + num_abs(f_d4)) {
        return map{ kind: "finite", val: _snap_num(f_d4) };
    }
    if num_abs(vals[5] - vals[4]) < 1e-4 * (1.0 + num_abs(vals[5])) {
        return map{ kind: "finite", val: _snap_num(vals[5]) };
    }
    return map{ kind: "undefined", val: nil };
}

fn _trig_to_sincos(node, depth) {
    if depth > MAX_DEPTH { return node; }
    let k = node.kind;
    if k == "num" or k == "sym" { return node; }
    if k == "neg" { return _neg(_trig_to_sincos(node.arg, depth + 1)); }
    if k == "bin" {
        return _bin(node.op, _trig_to_sincos(node.left, depth + 1), _trig_to_sincos(node.right, depth + 1));
    }
    if k == "call" {
        let nargs = [];
        let i = 0;
        while i < len(node.args) {
            array_push(nargs, _trig_to_sincos(node.args[i], depth + 1));
            i = i + 1;
        }
        if len(nargs) == 1 {
            let u = nargs[0];
            if node.name == "tan" { return _bin("/", _call("sin", [u]), _call("cos", [u])); }
            if node.name == "cot" { return _bin("/", _call("cos", [u]), _call("sin", [u])); }
            if node.name == "sec" { return _bin("/", _num(1), _call("cos", [u])); }
            if node.name == "csc" { return _bin("/", _num(1), _call("sin", [u])); }
        }
        return _call(node.name, nargs);
    }
    return node;
}

fn _to_single_fraction(node, depth) {
    if depth > MAX_DEPTH { return map{ num: node, den: _num(1) }; }
    let k = node.kind;
    if k == "neg" {
        let sub = _to_single_fraction(node.arg, depth + 1);
        return map{ num: _simp(_neg(sub.num)), den: sub.den };
    }
    if k == "bin" {
        let op = node.op;
        if op == "/" {
            let fl = _to_single_fraction(node.left, depth + 1);
            let fr = _to_single_fraction(node.right, depth + 1);
            return map{ num: _simp(_bin("*", fl.num, fr.den)), den: _simp(_bin("*", fl.den, fr.num)) };
        }
        if op == "*" {
            let fl = _to_single_fraction(node.left, depth + 1);
            let fr = _to_single_fraction(node.right, depth + 1);
            return map{ num: _simp(_bin("*", fl.num, fr.num)), den: _simp(_bin("*", fl.den, fr.den)) };
        }
        if op == "+" or op == "-" {
            let fl = _to_single_fraction(node.left, depth + 1);
            let fr = _to_single_fraction(node.right, depth + 1);
            if _canon_key(fl.den, 0) == _canon_key(fr.den, 0) {
                return map{ num: _simp(_bin(op, fl.num, fr.num)), den: fl.den };
            }
            let t1 = _bin("*", fl.num, fr.den);
            let t2 = _bin("*", fr.num, fl.den);
            return map{ num: _simp(_bin(op, t1, t2)), den: _simp(_bin("*", fl.den, fr.den)) };
        }
        if op == "^" and _is_num(node.right) and _is_int_val(node.right.val) and node.right.val < 0 {
            let pos_e = num_round(0.0 - node.right.val);
            let fb = _to_single_fraction(node.left, depth + 1);
            let np = if pos_e == 1 { fb.den } else { _bin("^", fb.den, _num(pos_e)) };
            let dp = if pos_e == 1 { fb.num } else { _bin("^", fb.num, _num(pos_e)) };
            return map{ num: _simp(np), den: _simp(dp) };
        }
    }
    return map{ num: node, den: _num(1) };
}

fn _contains_sqrt_var(node, var_name, depth) {
    if depth > MAX_DEPTH or not _depends_on(node, var_name, 0) { return false; }
    if node.kind == "call" and node.name == "sqrt" and len(node.args) == 1 { return true; }
    if node.kind == "bin" and node.op == "^" and _is_num_eq(node.right, 0.5) { return true; }
    if node.kind == "bin" and node.op == "^" and node.right.kind == "bin" and node.right.op == "/" and _is_num_eq(node.right.left, 1) and _is_num_eq(node.right.right, 2) { return true; }
    if node.kind == "neg" { return _contains_sqrt_var(node.arg, var_name, depth + 1); }
    if node.kind == "bin" {
        return _contains_sqrt_var(node.left, var_name, depth + 1) or _contains_sqrt_var(node.right, var_name, depth + 1);
    }
    if node.kind == "call" {
        let i = 0;
        while i < len(node.args) {
            if _contains_sqrt_var(node.args[i], var_name, depth + 1) { return true; }
            i = i + 1;
        }
    }
    return false;
}

// Compute exact algebraic square of a term, clearing outer sqrt(P) -> P cleanly
fn _sq_clear_sqrt(node) {
    let s = _simp(node);
    if s.kind == "neg" { return _sq_clear_sqrt(s.arg); }
    if s.kind == "call" and s.name == "sqrt" and len(s.args) == 1 {
        return _simp(s.args[0]);
    }
    if s.kind == "bin" and s.op == "^" {
        if _is_num_eq(s.right, 0.5) or (s.right.kind == "bin" and s.right.op == "/" and _is_num_eq(s.right.left, 1) and _is_num_eq(s.right.right, 2)) {
            return _simp(s.left);
        }
    }
    if s.kind == "bin" and s.op == "*" {
        return _simp(_bin("*", _sq_clear_sqrt(s.left), _sq_clear_sqrt(s.right)));
    }
    if s.kind == "bin" and s.op == "/" {
        return _simp(_bin("/", _sq_clear_sqrt(s.left), _sq_clear_sqrt(s.right)));
    }
    return _simp(_bin("^", s, _num(2)));
}

// Rationalize radical sum/difference U - V -> (U^2 - V^2) / (U + V)
fn _try_radical_conjugate(node, var_name) {
    let terms = [];
    let _ = _collect_sum_terms(_simp(node), 1, terms, 0);
    if len(terms) < 2 { return map{ ok: false }; }
    let rad_terms = [];
    let other_terms = [];
    let i = 0;
    while i < len(terms) {
        if _contains_sqrt_var(terms[i], var_name, 0) {
            array_push(rad_terms, terms[i]);
        } else {
            array_push(other_terms, terms[i]);
        }
        i = i + 1;
    }
    let U = nil;
    let V = nil;
    if len(rad_terms) == 1 and len(other_terms) >= 1 {
        U = rad_terms[0];
        let sum_o = other_terms[0];
        let j = 1;
        while j < len(other_terms) { sum_o = _bin("+", sum_o, other_terms[j]); j = j + 1; }
        V = _simp(_neg(sum_o));
    } else if len(rad_terms) == 2 and len(other_terms) == 0 {
        U = rad_terms[0];
        V = _simp(_neg(rad_terms[1]));
    } else {
        return map{ ok: false };
    }
    let num_c = _simp(_bin("-", _sq_clear_sqrt(U), _sq_clear_sqrt(V)));
    let den_c = _simp(_bin("+", U, V));
    return map{ ok: true, num: num_c, den: den_c };
}

// Multiply node(t) by t^p_pow for t > 0, pushing t^(2*p_pow) inside sqrt(...) to clear poles at t = 0+
fn _scale_t_pos(node, t_sym, p_pow, depth) {
    if depth > MAX_DEPTH or p_pow == 0 { return node; }
    if node.kind == "neg" {
        return _simp(_neg(_scale_t_pos(node.arg, t_sym, p_pow, depth + 1)));
    }
    if node.kind == "bin" and (node.op == "+" or node.op == "-") {
        return _simp(_bin(node.op, _scale_t_pos(node.left, t_sym, p_pow, depth + 1), _scale_t_pos(node.right, t_sym, p_pow, depth + 1)));
    }
    if node.kind == "call" and node.name == "sqrt" and len(node.args) == 1 {
        let t2p = _bin("^", _sym(t_sym), _num(2 * p_pow));
        let fr = _to_single_fraction(_bin("*", t2p, node.args[0]), 0);
        let inside = _simp(_bin("/", fr.num, fr.den));
        return _simp(_call("sqrt", [inside]));
    }
    if node.kind == "bin" and node.op == "*" {
        if not _depends_on(node.left, t_sym, 0) {
            return _simp(_bin("*", node.left, _scale_t_pos(node.right, t_sym, p_pow, depth + 1)));
        }
        if not _depends_on(node.right, t_sym, 0) {
            return _simp(_bin("*", _scale_t_pos(node.left, t_sym, p_pow, depth + 1), node.right));
        }
    }
    let tp = if p_pow == 1 { _sym(t_sym) } else { _bin("^", _sym(t_sym), _num(p_pow)) };
    let fr = _to_single_fraction(_bin("*", tp, node), 0);
    return _simp(_bin("/", fr.num, fr.den));
}

// Check if an inner trig phase w(x) diverges in magnitude as x -> target
fn _arg_diverges_at(w_ast, var_name, target, dir) {
    let inf_flag = _is_inf_bound(target);
    if inf_flag != 0 {
        let sgn = inf_flag * 1.0;
        let w1 = num_abs(_eval_1d(w_ast, var_name, sgn * 100.0));
        let w2 = num_abs(_eval_1d(w_ast, var_name, sgn * 10000.0));
        let w3 = num_abs(_eval_1d(w_ast, var_name, sgn * 1e8));
        if _is_finite(w2) and _is_finite(w3) and w3 > 15.0 and w3 > 1.2 * w2 and (not _is_finite(w1) or w2 > 1.2 * w1) {
            return true;
        }
        return false;
    }
    let c0 = target * 1.0;
    if dir != "-" and dir != "left" {
        let r1 = num_abs(_eval_1d(w_ast, var_name, c0 + 1e-3));
        let r2 = num_abs(_eval_1d(w_ast, var_name, c0 + 1e-6));
        if _is_finite(r1) and _is_finite(r2) and r2 > 50.0 and r2 > 1.5 * r1 {
            return true;
        }
    }
    if dir != "+" and dir != "right" {
        let l1 = num_abs(_eval_1d(w_ast, var_name, c0 - 1e-3));
        let l2 = num_abs(_eval_1d(w_ast, var_name, c0 - 1e-6));
        if _is_finite(l1) and _is_finite(l2) and l2 > 50.0 and l2 > 1.5 * l1 {
            return true;
        }
    }
    return false;
}

fn _has_divergent_trig_phase(node, var_name, target, dir, depth) {
    if depth > MAX_DEPTH or not _depends_on(node, var_name, 0) { return false; }
    if node.kind == "neg" { return _has_divergent_trig_phase(node.arg, var_name, target, dir, depth + 1); }
    if node.kind == "bin" {
        return _has_divergent_trig_phase(node.left, var_name, target, dir, depth + 1) or _has_divergent_trig_phase(node.right, var_name, target, dir, depth + 1);
    }
    if node.kind == "call" {
        if len(node.args) == 1 {
            let nm = node.name;
            if nm == "sin" or nm == "cos" or nm == "tan" or nm == "cot" or nm == "sec" or nm == "csc" {
                if _arg_diverges_at(node.args[0], var_name, target, dir) {
                    return true;
                }
            }
        }
        let i = 0;
        while i < len(node.args) {
            if _has_divergent_trig_phase(node.args[i], var_name, target, dir, depth + 1) { return true; }
            i = i + 1;
        }
    }
    return false;
}

fn _is_bounded_osc_ast(node, var_name, depth) {
    if depth > MAX_DEPTH { return false; }
    if not _depends_on(node, var_name, 0) { return true; }
    if node.kind == "neg" { return _is_bounded_osc_ast(node.arg, var_name, depth + 1); }
    if node.kind == "call" and len(node.args) == 1 {
        let nm = node.name;
        if nm == "sin" or nm == "cos" or nm == "atan" or nm == "erf" or nm == "erfc" or nm == "FresnelS" or nm == "FresnelC" or nm == "tanh" {
            return true;
        }
        if nm == "abs" {
            return _is_bounded_osc_ast(node.args[0], var_name, depth + 1);
        }
        return false;
    }
    if node.kind == "bin" {
        let op = node.op;
        if op == "+" or op == "-" or op == "*" {
            return _is_bounded_osc_ast(node.left, var_name, depth + 1) and _is_bounded_osc_ast(node.right, var_name, depth + 1);
        }
        if op == "^" and not _depends_on(node.right, var_name, 0) {
            let pv = try _eval_ast(node.right, map{}, 0) catch _nan_val();
            if _is_finite(pv) and pv > 0.0 {
                return _is_bounded_osc_ast(node.left, var_name, depth + 1);
            }
        }
    }
    return false;
}

fn _osc_probe_points(target, dir, scale_idx) {
    let phi = 0.6180339887498949;
    let inf_flag = _is_inf_bound(target);
    let pts = [];
    if inf_flag != 0 {
        let sgn = inf_flag * 1.0;
        let base_r = if scale_idx == 1 { 200.0 } else { 20000.0 };
        let m = 0;
        while m < 48 {
            array_push(pts, sgn * (base_r + (m * 1.0) * phi));
            m = m + 1;
        }
        return pts;
    }
    let c0 = target * 1.0;
    let base_k = if scale_idx == 1 { 1000.0 } else { 1000000.0 };
    let m = 0;
    while m < 48 {
        let h = 1.0 / (base_k + (m * 1.0) * phi);
        if dir != "-" and dir != "left" {
            array_push(pts, c0 + h);
        }
        if dir != "+" and dir != "right" {
            array_push(pts, c0 - h);
        }
        m = m + 1;
    }
    return pts;
}

// Match exact c0 + a * sin(w(x)) or c0 + a * cos(w(x)) with constant c0, a for exact oscillation bounds
fn _match_affine_sincos_bounds(node, var_name, target, dir) {
    let terms = [];
    let _ = _collect_sum_terms(_simp(node), 1, terms, 0);
    if len(terms) == 0 or len(terms) > 2 { return map{ ok: false }; }
    let c0_val = 0.0;
    let amp_val = 0.0;
    let found_trig = false;
    let i = 0;
    while i < len(terms) {
        let tm = _simp(terms[i]);
        if not _depends_on(tm, var_name, 0) {
            let cv = try _eval_ast(tm, map{}, 0) catch _nan_val();
            if not _is_finite(cv) { return map{ ok: false }; }
            c0_val = c0_val + cv;
        } else if not found_trig {
            let sp = _split_coeff_and_core(tm);
            if sp.core.kind == "call" and (sp.core.name == "sin" or sp.core.name == "cos") and len(sp.core.args) == 1 {
                if _arg_diverges_at(sp.core.args[0], var_name, target, dir) {
                    amp_val = num_abs(sp.f);
                    found_trig = true;
                } else {
                    return map{ ok: false };
                }
            } else {
                return map{ ok: false };
            }
        } else {
            return map{ ok: false };
        }
        i = i + 1;
    }
    if not found_trig or _near_zero(amp_val) { return map{ ok: false }; }
    return map{ ok: true, lo: _snap_num(c0_val - amp_val), hi: _snap_num(c0_val + amp_val) };
}

fn _map_exp_limit_val(v) {
    if type(v) == "number" and _is_finite(v) {
        return map{ ok: true, val: _snap_num(num_exp(v)) };
    }
    if _inf_sign_val(v) == 1 { return map{ ok: true, val: "+inf" }; }
    if _inf_sign_val(v) == -1 { return map{ ok: true, val: 0 }; }
    return map{ ok: false, val: nil };
}

// Resolve quotient N(x) / D(x) at finite target or +/-inf
fn _resolve_quotient_limit(num_ast, den_ast, var_name, target, dir, initial_form, steps, depth) {
    let inf_flag = _is_inf_bound(target);
    let s_num = _simp(num_ast);
    let s_den = _simp(den_ast);

    // Case 1: Target at +/- infinity
    if inf_flag != 0 {
        let sgn = inf_flag * 1.0;
        let pn = _extract_poly(s_num, var_name, 16);
        let pd = _extract_poly(s_den, var_name, 16);
        if pn.ok and pd.ok and pd.deg >= 0 {
            let q_form = initial_form;
            if q_form == nil {
                q_form = if pn.deg >= 1 and pd.deg >= 1 { "inf/inf" } else { "none" };
            }
            let ln_c = pn.coeffs[pn.deg];
            let ld_c = pd.coeffs[pd.deg];
            if pn.deg < pd.deg {
                array_push(steps, "rational_degree: deg(N) < deg(D) => 0");
                return _make_limit_res(true, 0, nil, nil, "rational_degree", q_form, steps, map{});
            }
            if pn.deg == pd.deg {
                let ratio = ln_c / ld_c;
                array_push(steps, "rational_degree: deg(N) == deg(D) => lead(N)/lead(D)");
                return _make_limit_res(true, ratio, nil, nil, "rational_degree", q_form, steps, map{});
            }
            let deg_diff = pn.deg - pd.deg;
            let sign_inf = (ln_c / ld_c) * _safe_pow(sgn, deg_diff);
            let inf_s = if sign_inf > 0.0 { "+inf" } else { "-inf" };
            if q_form == "none" { q_form = "pole"; }
            return _make_limit_res(true, inf_s, nil, nil, "rational_degree", q_form, steps, map{});
        }

        // Determine quotient indeterminacy at +/-inf if not already set
        let q_form = initial_form;
        if q_form == nil and depth <= 6 {
            let rn_inf = _limit_core(s_num, var_name, target, dir, [], depth + 1);
            let rd_inf = _limit_core(s_den, var_name, target, dir, [], depth + 1);
            if _lim_is_zero(rn_inf) and _lim_is_zero(rd_inf) { q_form = "0/0"; }
            else if _lim_tends_abs_inf(rn_inf) and _lim_tends_abs_inf(rd_inf) { q_form = "inf/inf"; }
            else if rn_inf.exists and rd_inf.exists and type(rn_inf.value) == "number" and _lim_tends_abs_inf(rd_inf) {
                return _make_limit_res(true, 0, nil, nil, "asymptotic_quotient", "none", steps, map{});
            }
        }
        if q_form == nil { q_form = "none"; }

        // Algebraic / Radical asymptotic power scaling via x = sgn / t (t -> 0+)
        let d_probe1 = _eval_1d(s_den, var_name, sgn * 1e4);
        let d_probe2 = _eval_1d(s_den, var_name, sgn * 1e5);
        if _is_finite(d_probe1) and _is_finite(d_probe2) and num_abs(d_probe1) > 1e-12 and num_abs(d_probe2) > 1e-12 {
            let p_est = num_ln(num_abs(d_probe2) / num_abs(d_probe1)) / LN10;
            let p_int = num_round(p_est);
            if p_int >= 1 and p_int <= 12 and num_abs(p_est - p_int) < 0.05 {
                let t_sym = "__lim_t";
                let sub_x = if sgn > 0.0 { _bin("/", _num(1), _sym(t_sym)) } else { _neg(_bin("/", _num(1), _sym(t_sym))) };
                let nt_raw = _subst_ast(s_num, var_name, sub_x, 0);
                let dt_raw = _subst_ast(s_den, var_name, sub_x, 0);
                let nt_sc = _scale_t_pos(nt_raw, t_sym, p_int, 0);
                let dt_sc = _scale_t_pos(dt_raw, t_sym, p_int, 0);
                let jn_t = _eval_taylor_jet_1d(nt_sc, t_sym, 0.0, 8, 0);
                let jd_t = _eval_taylor_jet_1d(dt_sc, t_sym, 0.0, 8, 0);
                if jn_t.ok and jd_t.ok and num_abs(jd_t.c[0]) > 1e-12 {
                    let q_jet = _jet_div(jn_t.c, jd_t.c);
                    if q_jet != nil and len(q_jet) >= 1 {
                        array_push(steps, "asymptotic_radical_scaling: scaled by t^" + str(p_int) + " at t = 1/x -> 0+");
                        return _make_limit_res(true, q_jet[0], nil, nil, "algebraic_asymptotic", q_form, steps, map{});
                    }
                }
            }
        }

        // Symbolic L'Hopital directly in var_name at +/-inf (up to 8 iterations for x^k/exp(x), ln(x)/x, etc.)
        if q_form != "none" and q_form != "pole" and _ast_node_count(s_num, 0) + _ast_node_count(s_den, 0) <= 60 {
            let n_cur = s_num;
            let d_cur = s_den;
            let lh = 0;
            while lh < 8 {
                if _ast_node_count(n_cur, 0) + _ast_node_count(d_cur, 0) > 120 { break; }
                let dn = _simp(_diff_ast(n_cur, var_name, [], 0));
                let dd = _simp(_diff_ast(d_cur, var_name, [], 0));
                if _is_num_eq(dd, 0) { break; }
                let q_simp = _simp(_bin("/", dn, dd));
                array_push(steps, "lhopital_inf_step_" + str(lh + 1) + ": " + format_ascii(q_simp, 0));
                if not (q_simp.kind == "bin" and q_simp.op == "/") {
                    let sub_r = _limit_core(q_simp, var_name, target, dir, steps, depth + 1);
                    if sub_r.exists {
                        return _make_limit_res(true, sub_r.value, nil, nil, "lhopital", q_form, steps, map{ symbolic_value: sub_r.symbolic_value });
                    }
                    break;
                }
                if not _depends_on(q_simp.left, var_name, 0) or not _depends_on(q_simp.right, var_name, 0) {
                    let sub_r = _limit_core(q_simp, var_name, target, dir, steps, depth + 1);
                    if sub_r.exists {
                        return _make_limit_res(true, sub_r.value, nil, nil, "lhopital", q_form, steps, map{ symbolic_value: sub_r.symbolic_value });
                    }
                    break;
                }
                n_cur = q_simp.left;
                d_cur = q_simp.right;
                lh = lh + 1;
            }
        }

        // Fallback substitution x = sgn / t as t -> 0+
        let t_sym = "__lim_t";
        let sub_x = if sgn > 0.0 { _bin("/", _num(1), _sym(t_sym)) } else { _neg(_bin("/", _num(1), _sym(t_sym))) };
        let t_ast = _simp(_subst_ast(_bin("/", s_num, s_den), var_name, sub_x, 0));
        let r_side = _one_sided_limit(t_ast, t_sym, 0.0, 1.0);
        if r_side.kind == "finite" or r_side.kind == "inf" {
            if q_form == "none" and r_side.kind == "inf" { q_form = "pole"; }
            return _make_limit_res(true, r_side.val, nil, nil, "substitution_richardson", q_form, steps, map{});
        }
        return _make_limit_res(false, nil, nil, nil, "divergent_or_oscillatory", q_form, steps, map{});
    }

    // Case 2: Finite target c_val
    let c_val = target * 1.0;
    let has_kink = _contains_abs_zero_at(s_num, var_name, c_val, 0) or _contains_abs_zero_at(s_den, var_name, c_val, 0);

    // Detect initial quotient form (0/0 vs inf/inf vs pole vs none) if not already provided
    let q_form = initial_form;
    let vn0 = _eval_1d(s_num, var_name, c_val);
    let vd0 = _eval_1d(s_den, var_name, c_val);
    let probe_sgn = if dir == "-" or dir == "left" { -1.0 } else { 1.0 };
    let vn_p1 = _eval_1d(s_num, var_name, c_val + probe_sgn * 1e-5);
    let vn_p2 = _eval_1d(s_num, var_name, c_val + probe_sgn * 1e-8);
    let vd_p1 = _eval_1d(s_den, var_name, c_val + probe_sgn * 1e-5);
    let vd_p2 = _eval_1d(s_den, var_name, c_val + probe_sgn * 1e-8);

    let num_zero = (_is_finite(vn0) and num_abs(vn0) < 1e-11) or (_is_finite(vn_p2) and num_abs(vn_p2) < 1e-6 and _is_finite(vn_p1) and num_abs(vn_p2) < 0.05 * num_abs(vn_p1));
    let den_zero = (_is_finite(vd0) and num_abs(vd0) < 1e-11) or (_is_finite(vd_p2) and num_abs(vd_p2) < 1e-6 and _is_finite(vd_p1) and num_abs(vd_p2) < 0.05 * num_abs(vd_p1));
    let num_inf = not _is_finite(vn0) and _is_finite(vn_p1) and _is_finite(vn_p2) and num_abs(vn_p2) > 10.0 and num_abs(vn_p2) > 1.2 * num_abs(vn_p1);
    let den_inf = not _is_finite(vd0) and _is_finite(vd_p1) and _is_finite(vd_p2) and num_abs(vd_p2) > 10.0 and num_abs(vd_p2) > 1.2 * num_abs(vd_p1);

    if q_form == nil {
        if num_zero and den_zero { q_form = "0/0"; }
        else if num_inf and den_inf { q_form = "inf/inf"; }
        else if den_zero and not num_zero { q_form = "pole"; }
        else { q_form = "none"; }
    }

    if not has_kink {
        // 2a. Exact Polynomial Deflation (x - c_val)
        let pn = _extract_poly(s_num, var_name, 16);
        let pd = _extract_poly(s_den, var_name, 16);
        if pn.ok and pd.ok {
            let nc = pn.coeffs;
            let dc = pd.coeffs;
            let lin_fac = [0.0 - c_val, 1.0];
            let guard_p = 0;
            while guard_p < 16 {
                let vn = _eval_1d(_poly_coeffs_to_ast(nc, var_name, 0.0), var_name, c_val);
                let vd = _eval_1d(_poly_coeffs_to_ast(dc, var_name, 0.0), var_name, c_val);
                if num_abs(vn) < 1e-11 and num_abs(vd) < 1e-11 and len(dc) > 1 {
                    nc = _poly_divmod(nc, lin_fac).q;
                    dc = _poly_divmod(dc, lin_fac).q;
                    array_push(steps, "algebraic_cancellation: divided numerator & denominator by (" + var_name + " - " + _num_to_clean_str(c_val) + ")");
                } else {
                    break;
                }
                guard_p = guard_p + 1;
            }
            let vn2 = _eval_1d(_poly_coeffs_to_ast(nc, var_name, 0.0), var_name, c_val);
            let vd2 = _eval_1d(_poly_coeffs_to_ast(dc, var_name, 0.0), var_name, c_val);
            if _is_finite(vn2) and _is_finite(vd2) and num_abs(vd2) > 1e-12 {
                let rv = vn2 / vd2;
                let meth = if guard_p > 0 { "algebraic_cancellation" } else { "direct_evaluation" };
                let l_lim = if dir == "+" or dir == "right" { nil } else { rv };
                let r_lim = if dir == "-" or dir == "left" { nil } else { rv };
                return _make_limit_res(true, rv, l_lim, r_lim, meth, q_form, steps, map{});
            }
        }

        // 2b. Radical Conjugate Rationalization at finite target (e.g. (sqrt(x + 4) - 2)/x at x -> 0)
        if (q_form == "0/0" or (num_zero and den_zero)) and _contains_sqrt_var(s_num, var_name, 0) {
            let rc_n = _try_radical_conjugate(s_num, var_name);
            if rc_n.ok {
                let new_num = rc_n.num;
                let new_den = _simp(_bin("*", s_den, rc_n.den));
                let vd_conj = _eval_1d(rc_n.den, var_name, c_val);
                if _is_finite(vd_conj) and num_abs(vd_conj) > 1e-11 {
                    array_push(steps, "radical_conjugate_numerator: (" + format_ascii(new_num, 0) + ") / (" + format_ascii(new_den, 0) + ")");
                    return _resolve_quotient_limit(new_num, new_den, var_name, target, dir, q_form, steps, depth + 1);
                }
            }
        }

        // 2c. Exact High-Order Taylor / Laurent Jet Quotient Cancellation up to Order 14!
        let jn = _eval_taylor_jet_1d(s_num, var_name, c_val, 14, 0);
        let jd = _eval_taylor_jet_1d(s_den, var_name, c_val, 14, 0);
        if jn.ok and jd.ok {
            let m_jet = if len(jn.c) < len(jd.c) { len(jn.c) } else { len(jd.c) };
            let ord_n = -1;
            let ord_d = -1;
            let ki = 0;
            while ki < m_jet {
                if ord_n < 0 and num_abs(jn.c[ki]) > 1e-13 { ord_n = ki; }
                if ord_d < 0 and num_abs(jd.c[ki]) > 1e-13 { ord_d = ki; }
                ki = ki + 1;
            }
            if ord_d == 0 {
                let rv = jn.c[0] / jd.c[0];
                let l_lim = if dir == "+" or dir == "right" { nil } else { rv };
                let r_lim = if dir == "-" or dir == "left" { nil } else { rv };
                return _make_limit_res(true, rv, l_lim, r_lim, "direct_evaluation", q_form, steps, map{});
            }
            if ord_d >= 1 {
                if q_form == "none" {
                    q_form = if ord_n >= 1 or ord_n < 0 { "0/0" } else { "pole" };
                }
                if ord_n < 0 or ord_n > ord_d {
                    array_push(steps, "taylor_lhopital_cancellation: ord(N) > ord(D) = " + str(ord_d) + " => 0");
                    let l_lim = if dir == "+" or dir == "right" { nil } else { 0 };
                    let r_lim = if dir == "-" or dir == "left" { nil } else { 0 };
                    return _make_limit_res(true, 0, l_lim, r_lim, "lhopital", q_form, steps, map{});
                }
                if ord_n == ord_d {
                    // Record symbolic L'Hopital steps when small order for explanatory trace
                    if ord_d <= 4 and _ast_node_count(s_num, 0) + _ast_node_count(s_den, 0) <= 45 {
                        let tmp_n = s_num;
                        let tmp_d = s_den;
                        let s_i = 0;
                        while s_i < ord_d {
                            tmp_n = _simp(_diff_ast(tmp_n, var_name, [], 0));
                            tmp_d = _simp(_diff_ast(tmp_d, var_name, [], 0));
                            array_push(steps, "lhopital_step_" + str(s_i + 1) + ": (" + format_ascii(tmp_n, 0) + ") / (" + format_ascii(tmp_d, 0) + ")");
                            s_i = s_i + 1;
                        }
                    } else {
                        array_push(steps, "taylor_laurent_order_" + str(ord_d) + ": a_" + str(ord_n) + " / b_" + str(ord_d));
                    }
                    let rv = jn.c[ord_n] / jd.c[ord_d];
                    let l_lim = if dir == "+" or dir == "right" { nil } else { rv };
                    let r_lim = if dir == "-" or dir == "left" { nil } else { rv };
                    return _make_limit_res(true, rv, l_lim, r_lim, "lhopital", q_form, steps, map{});
                }
                if ord_n < ord_d {
                    let diff_o = ord_d - ord_n;
                    let lead_r = jn.c[ord_n] / jd.c[ord_d];
                    let r_inf = if lead_r > 0.0 { "+inf" } else { "-inf" };
                    let l_sgn = if num_mod(diff_o, 2) == 0 { lead_r } else { 0.0 - lead_r };
                    let l_inf = if l_sgn > 0.0 { "+inf" } else { "-inf" };
                    if dir == "+" or dir == "right" {
                        return _make_limit_res(true, r_inf, nil, r_inf, "laurent_pole", q_form, steps, map{});
                    }
                    if dir == "-" or dir == "left" {
                        return _make_limit_res(true, l_inf, l_inf, nil, "laurent_pole", q_form, steps, map{});
                    }
                    if l_inf == r_inf {
                        return _make_limit_res(true, r_inf, l_inf, r_inf, "unbounded_pole", q_form, steps, map{});
                    }
                    return _make_limit_res(false, nil, l_inf, r_inf, "two_sided_discontinuity", q_form, steps, map{});
                }
            }
        }

        // 2d. Symbolic L'Hopital's Rule up to 12 iterations (essential for inf/inf like ln(x)/(1/x) or non-analytic singularities)
        let num_cur = s_num;
        let den_cur = s_den;
        let lh_iter = 0;
        while lh_iter < 12 {
            let vn = _eval_1d(num_cur, var_name, c_val);
            let vd = _eval_1d(den_cur, var_name, c_val);
            let vn_e = _eval_1d(num_cur, var_name, c_val + probe_sgn * 1e-8);
            let vd_e = _eval_1d(den_cur, var_name, c_val + probe_sgn * 1e-8);
            let is_zz = (_is_finite(vn) and _is_finite(vd) and num_abs(vn) < 1e-11 and num_abs(vd) < 1e-11) or (_is_finite(vn_e) and _is_finite(vd_e) and num_abs(vn_e) < 1e-5 and num_abs(vd_e) < 1e-5);
            let is_ii = _is_finite(vn_e) and _is_finite(vd_e) and num_abs(vn_e) > 8.0 and num_abs(vd_e) > 8.0 and not (_is_finite(vn) and _is_finite(vd));

            if not is_zz and not is_ii {
                if lh_iter > 0 and _is_finite(vn) and _is_finite(vd) and num_abs(vd) > 1e-12 {
                    let lv = vn / vd;
                    let l_lim = if dir == "+" or dir == "right" { nil } else { lv };
                    let r_lim = if dir == "-" or dir == "left" { nil } else { lv };
                    return _make_limit_res(true, lv, l_lim, r_lim, "lhopital", q_form, steps, map{});
                }
                break;
            }
            if _ast_node_count(num_cur, 0) + _ast_node_count(den_cur, 0) > 140 { break; }
            let d_num = _simp(_diff_ast(num_cur, var_name, [], 0));
            let d_den = _simp(_diff_ast(den_cur, var_name, [], 0));
            if _is_num_eq(d_den, 0) { break; }

            // Simplify ratio (d_num / d_den) so e.g. (1/x) / (-1/x^2) simplifies immediately to -x!
            let q_simp = _simp(_bin("/", d_num, d_den));
            array_push(steps, "lhopital_step_" + str(lh_iter + 1) + ": " + format_ascii(q_simp, 0));
            if not (q_simp.kind == "bin" and q_simp.op == "/") {
                let sub_lh = _limit_core(q_simp, var_name, target, dir, steps, depth + 1);
                let dom_opt = if sub_lh.domain_restricted != nil { map{ domain_restricted: sub_lh.domain_restricted } } else { map{} };
                return _make_limit_res(sub_lh.exists, sub_lh.value, sub_lh.left_limit, sub_lh.right_limit, "lhopital", q_form, steps, dom_opt);
            }
            if _ast_node_count(q_simp, 0) <= _ast_node_count(d_num, 0) + _ast_node_count(d_den, 0) + 2 {
                num_cur = q_simp.left;
                den_cur = q_simp.right;
            } else {
                num_cur = d_num;
                den_cur = d_den;
            }
            lh_iter = lh_iter + 1;
        }
        let vn_f = _eval_1d(num_cur, var_name, c_val);
        let vd_f = _eval_1d(den_cur, var_name, c_val);
        if lh_iter > 0 and _is_finite(vn_f) and _is_finite(vd_f) and num_abs(vd_f) > 1e-12 {
            let lv = vn_f / vd_f;
            let l_lim = if dir == "+" or dir == "right" { nil } else { lv };
            let r_lim = if dir == "-" or dir == "left" { nil } else { lv };
            return _make_limit_res(true, lv, l_lim, r_lim, "lhopital", q_form, steps, map{});
        }
    }

    return map{ _unresolved: true, q_form: q_form };
}

fn _limit_core(raw_ast, var_name, target, dir, steps, depth) {
    if depth > 12 {
        return _make_limit_res(false, nil, nil, nil, "max_depth", "none", steps, map{});
    }
    let ast = _simp(raw_ast);
    let inf_flag = _is_inf_bound(target);

    // 0. Constant w.r.t. var_name
    if not _depends_on(ast, var_name, 0) {
        let cv = _eval_ast(ast, map{}, 0);
        if _is_finite(cv) {
            let l_lim = if inf_flag != 0 or dir == "+" or dir == "right" { nil } else { cv };
            let r_lim = if inf_flag != 0 or dir == "-" or dir == "left" { nil } else { cv };
            return _make_limit_res(true, cv, l_lim, r_lim, "constant", "none", steps, map{});
        }
    }

    // 1. Oscillatory Phase Detection: Squeeze Theorem vs Oscillatory Non-Existence
    if _has_divergent_trig_phase(ast, var_name, target, dir, 0) {
        // 1a. Squeeze Theorem on multiplicative damping: damp(x) * bounded_osc(x) -> 0
        if ast.kind == "bin" and (ast.op == "*" or ast.op == "/") {
            let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
            let _ = _collect_mul_factors(ast, false, st_m, 0);
            if st_m.zero {
                return _make_limit_res(true, 0, 0, 0, "squeeze_theorem", "none", steps, map{});
            }
            let scalar_val = if st_m.is_rat { (st_m.sign * st_m.num_int * 1.0) / (st_m.den_int * 1.0) } else { st_m.sign * st_m.float_val };
            let osc_facs = [];
            let damp_facs = [];
            let bad_unbounded_osc = false;
            let fi = 0;
            while fi < len(st_m.factors) {
                let fac = st_m.factors[fi];
                let f_ast = _simp(_bin("^", fac.base, fac.exp));
                if _has_divergent_trig_phase(f_ast, var_name, target, dir, 0) {
                    if _is_bounded_osc_ast(f_ast, var_name, 0) {
                        array_push(osc_facs, f_ast);
                    } else {
                        bad_unbounded_osc = true;
                    }
                } else {
                    array_push(damp_facs, f_ast);
                }
                fi = fi + 1;
            }
            if not bad_unbounded_osc and len(osc_facs) >= 1 and len(damp_facs) >= 1 {
                let damp_ast = _num_or_simple_rat(scalar_val);
                let di = 0;
                while di < len(damp_facs) {
                    damp_ast = _simp(_bin("*", damp_ast, damp_facs[di]));
                    di = di + 1;
                }
                let rd = _limit_core(damp_ast, var_name, target, dir, [], depth + 1);
                if _lim_is_zero(rd) {
                    array_push(steps, "squeeze_theorem: |" + format_ascii(ast, 0) + "| <= M * |" + format_ascii(damp_ast, 0) + "| -> 0");
                    let l_z = if inf_flag != 0 or dir == "+" or dir == "right" { nil } else { 0 };
                    let r_z = if inf_flag != 0 or dir == "-" or dir == "left" { nil } else { 0 };
                    return _make_limit_res(true, 0, l_z, r_z, "squeeze_theorem", "none", steps, map{});
                }
            }
        }

        // 1b. Exact affine sin/cos bounds (e.g. sin(1/x) -> [-1, 1], cos(x) -> [-1, 1])
        let aff = _match_affine_sincos_bounds(ast, var_name, target, dir);
        if aff.ok {
            array_push(steps, "oscillatory_non_existence: persistent phase oscillation in [" + str(aff.lo) + ", " + str(aff.hi) + "]");
            return _make_limit_res(false, nil, nil, nil, "oscillatory_non_existence", "oscillatory", steps, map{ oscillation_bounds: [aff.lo, aff.hi] });
        }

        // 1c. Multi-scale golden-ratio phase sampling for general oscillatory expressions
        let pts1 = _osc_probe_points(target, dir, 1);
        let pts2 = _osc_probe_points(target, dir, 2);
        let min1 = 1e300; let max1 = -1e300; let cnt1 = 0;
        let min2 = 1e300; let max2 = -1e300; let cnt2 = 0;
        let pi_idx = 0;
        while pi_idx < len(pts1) {
            let v1 = _eval_1d(ast, var_name, pts1[pi_idx]);
            if _is_finite(v1) {
                if v1 < min1 { min1 = v1; }
                if v1 > max1 { max1 = v1; }
                cnt1 = cnt1 + 1;
            }
            pi_idx = pi_idx + 1;
        }
        pi_idx = 0;
        while pi_idx < len(pts2) {
            let v2 = _eval_1d(ast, var_name, pts2[pi_idx]);
            if _is_finite(v2) {
                if v2 < min2 { min2 = v2; }
                if v2 > max2 { max2 = v2; }
                cnt2 = cnt2 + 1;
            }
            pi_idx = pi_idx + 1;
        }
        if cnt1 >= 8 and cnt2 >= 8 {
            let sp1 = max1 - min1;
            let sp2 = max2 - min2;
            if sp2 < 1e-4 and sp2 < 0.02 * sp1 {
                let mid2 = _snap_num(0.5 * (min2 + max2));
                array_push(steps, "squeeze_damped_oscillation: oscillation amplitude decays to 0");
                let l_m = if inf_flag != 0 or dir == "+" or dir == "right" { nil } else { mid2 };
                let r_m = if inf_flag != 0 or dir == "-" or dir == "left" { nil } else { mid2 };
                return _make_limit_res(true, mid2, l_m, r_m, "squeeze_theorem", "none", steps, map{});
            }
            if sp2 > 1e-3 and sp2 >= 0.4 * sp1 {
                let b_lo = min2;
                let b_hi = max2;
                if _is_bounded_osc_ast(ast, var_name, 0) {
                    if num_abs(b_lo - num_round(b_lo)) < 0.02 { b_lo = num_round(b_lo); }
                    else { b_lo = num_round(b_lo * 10000.0) / 10000.0; }
                    if num_abs(b_hi - num_round(b_hi)) < 0.02 { b_hi = num_round(b_hi); }
                    else { b_hi = num_round(b_hi * 10000.0) / 10000.0; }
                } else {
                    b_lo = "-inf";
                    b_hi = "+inf";
                }
                array_push(steps, "oscillatory_non_existence: multi-scale golden-ratio spread = " + str(sp2));
                return _make_limit_res(false, nil, nil, nil, "oscillatory_non_existence", "oscillatory", steps, map{ oscillation_bounds: [b_lo, b_hi] });
            }
        }
    }

    // 2. Power Indeterminacies (1^inf, 0^0, inf^0) on raw_ast or simplified ast
    let pow_node = if raw_ast.kind == "bin" and raw_ast.op == "^" { raw_ast } else if ast.kind == "bin" and ast.op == "^" { ast } else { nil };
    if pow_node != nil and depth <= 6 {
        let u_base = pow_node.left;
        let v_exp = pow_node.right;
        if _depends_on(u_base, var_name, 0) and _depends_on(v_exp, var_name, 0) {
            let ru = _limit_core(u_base, var_name, target, dir, [], depth + 1);
            let rv = _limit_core(v_exp, var_name, target, dir, [], depth + 1);

            // 2a. "1^inf" form: u -> 1 and |v| -> inf => exp(lim (u - 1)*v)
            if _lim_is_one(ru) and _lim_tends_abs_inf(rv) {
                let w_ast = _simp(_bin("*", _bin("-", u_base, _num(1)), v_exp));
                array_push(steps, "power_1_pow_inf: rewrite lim u^v = exp(lim (u - 1)*v), w = " + format_ascii(w_ast, 0));
                let rw = _limit_core(w_ast, var_name, target, dir, steps, depth + 1);
                if rw.exists {
                    let me = _map_exp_limit_val(rw.value);
                    if me.ok {
                        let sym_s = nil;
                        if type(rw.value) == "number" and _is_finite(rw.value) and not _near_zero(rw.value) {
                            let lw_s = if rw.exact_fraction != nil { rw.exact_fraction } else { _num_to_clean_str(rw.value) };
                            sym_s = "exp(" + lw_s + ")";
                        }
                        let l_lim = if inf_flag != 0 or dir == "+" or dir == "right" { nil } else { me.val };
                        let r_lim = if inf_flag != 0 or dir == "-" or dir == "left" { nil } else { me.val };
                        return _make_limit_res(true, me.val, l_lim, r_lim, "power_1_pow_inf", "1^inf", steps, map{ symbolic_value: sym_s });
                    }
                } else if inf_flag == 0 and dir == "both" and rw.left_limit != nil and rw.right_limit != nil {
                    let ml = _map_exp_limit_val(rw.left_limit);
                    let mr = _map_exp_limit_val(rw.right_limit);
                    return _make_limit_res(false, nil, ml.val, mr.val, "power_1_pow_inf", "1^inf", steps, map{});
                }
            }

            // 2b. "0^0" and "inf^0" forms: (u -> 0 and v -> 0) OR (|u| -> inf and v -> 0) => exp(lim v * ln(u))
            let is_0_0 = _lim_is_zero(ru) and _lim_is_zero(rv);
            let is_inf_0 = _lim_tends_abs_inf(ru) and _lim_is_zero(rv);
            if is_0_0 or is_inf_0 {
                let p_form = if is_0_0 { "0^0" } else { "inf^0" };
                let p_meth = if is_0_0 { "power_0_pow_0" } else { "power_inf_pow_0" };
                let eff_dir = dir;
                let dom_str = nil;

                if inf_flag == 0 {
                    let c0 = target * 1.0;
                    let ur1 = _eval_1d(u_base, var_name, c0 + 1e-4);
                    let ur2 = _eval_1d(u_base, var_name, c0 + 1e-7);
                    let ul1 = _eval_1d(u_base, var_name, c0 - 1e-4);
                    let ul2 = _eval_1d(u_base, var_name, c0 - 1e-7);
                    let pos_r = _is_finite(ur1) and _is_finite(ur2) and ur1 > 0.0 and ur2 > 0.0;
                    let pos_l = _is_finite(ul1) and _is_finite(ul2) and ul1 > 0.0 and ul2 > 0.0;
                    if dir == "both" and pos_r and not pos_l {
                        eff_dir = "+";
                        dom_str = var_name + " > " + _num_to_clean_str(c0);
                    } else if dir == "both" and pos_l and not pos_r {
                        eff_dir = "-";
                        dom_str = var_name + " < " + _num_to_clean_str(c0);
                    } else if (dir == "+" or dir == "right") and not pos_r {
                        return _make_limit_res(false, nil, nil, nil, "domain_error", p_form, steps, map{});
                    } else if (dir == "-" or dir == "left") and not pos_l {
                        return _make_limit_res(false, nil, nil, nil, "domain_error", p_form, steps, map{});
                    }
                }

                let w_ln = _bin("*", v_exp, _call("ln", [u_base]));
                array_push(steps, p_meth + ": rewrite lim u^v = exp(lim v*ln(u))");
                let rw = _limit_core(w_ln, var_name, target, eff_dir, steps, depth + 1);
                if rw.exists {
                    let me = _map_exp_limit_val(rw.value);
                    if me.ok {
                        let sym_s = nil;
                        if type(rw.value) == "number" and _is_finite(rw.value) and not _near_zero(rw.value) {
                            let lw_s = if rw.exact_fraction != nil { rw.exact_fraction } else { _num_to_clean_str(rw.value) };
                            sym_s = "exp(" + lw_s + ")";
                        }
                        let l_lim = if inf_flag != 0 or eff_dir == "+" or eff_dir == "right" { nil } else { me.val };
                        let r_lim = if inf_flag != 0 or eff_dir == "-" or eff_dir == "left" { nil } else { me.val };
                        return _make_limit_res(true, me.val, l_lim, r_lim, p_meth, p_form, steps, map{ domain_restricted: dom_str, symbolic_value: sym_s });
                    }
                }
            }
        }
    }

    // 3. Product Indeterminacy ("0*inf") on raw_ast before _simp merges * into /
    if raw_ast.kind == "bin" and raw_ast.op == "*" and depth <= 6 {
        let rl = _limit_core(raw_ast.left, var_name, target, dir, [], depth + 1);
        let rr = _limit_core(raw_ast.right, var_name, target, dir, [], depth + 1);
        let l0_rinf = _lim_is_zero(rl) and _lim_tends_abs_inf(rr);
        let linf_r0 = _lim_tends_abs_inf(rl) and _lim_is_zero(rr);
        if l0_rinf or linf_r0 {
            let z_fac = if l0_rinf { raw_ast.left } else { raw_ast.right };
            let i_fac = if l0_rinf { raw_ast.right } else { raw_ast.left };
            let dom_prod = if rl.domain_restricted != nil { rl.domain_restricted } else { rr.domain_restricted };
            let eff_dir = dir;
            if inf_flag == 0 and dir == "both" and dom_prod != nil {
                if str_contains(dom_prod, ">") { eff_dir = "+"; }
                else if str_contains(dom_prod, "<") { eff_dir = "-"; }
            }

            // Normalize trig (cot, tan, sec, csc) and check if product already simplifies to a clean quotient
            let norm_p = _simp(_trig_to_sincos(raw_ast, 0));
            let q_num = nil;
            let q_den = nil;
            if norm_p.kind == "bin" and norm_p.op == "/" {
                q_num = norm_p.left;
                q_den = norm_p.right;
            } else if z_fac.kind == "call" and z_fac.name == "exp" and len(z_fac.args) == 1 {
                // exp(g) * i_fac -> i_fac / exp(-g) (e.g. x^3 * exp(-x) -> x^3 / exp(x))
                q_num = i_fac;
                q_den = _call("exp", [_simp(_neg(z_fac.args[0]))]);
            } else if i_fac.kind == "call" and (i_fac.name == "ln" or i_fac.name == "log" or i_fac.name == "log10" or i_fac.name == "Ei" or i_fac.name == "li") {
                // Keep log/Ei in numerator: ln(u) / (1 / z_fac)
                q_num = i_fac;
                q_den = _simp(_bin("/", _num(1), z_fac));
            } else {
                q_num = z_fac;
                q_den = _simp(_bin("/", _num(1), i_fac));
            }
            array_push(steps, "product_0_mul_inf: rewrite as quotient (" + format_ascii(q_num, 0) + ") / (" + format_ascii(q_den, 0) + ")");
            let qr = _resolve_quotient_limit(q_num, q_den, var_name, target, eff_dir, "0*inf", steps, depth + 1);
            if not map_has(qr, "_unresolved") {
                return _make_limit_res(qr.exists, qr.value, qr.left_limit, qr.right_limit, qr.method, "0*inf", steps, map{ domain_restricted: dom_prod, symbolic_value: qr.symbolic_value });
            }
        }
    }

    // 4. Difference / Sum Indeterminacy ("inf-inf") on raw_ast
    if raw_ast.kind == "bin" and (raw_ast.op == "-" or raw_ast.op == "+") and depth <= 6 {
        let ra = _limit_core(raw_ast.left, var_name, target, dir, [], depth + 1);
        let rb = _limit_core(raw_ast.right, var_name, target, dir, [], depth + 1);
        if _lim_tends_abs_inf(ra) and _lim_tends_abs_inf(rb) {
            let is_opposing = true;
            let op_s = if raw_ast.op == "-" { -1 } else { 1 };
            if ra.exists and rb.exists and _inf_sign_val(ra.value) != 0 and _inf_sign_val(rb.value) != 0 {
                if _inf_sign_val(ra.value) + op_s * _inf_sign_val(rb.value) != 0 {
                    is_opposing = false;
                }
            }
            if not is_opposing {
                return _make_limit_res(true, ra.value, ra.left_limit, ra.right_limit, "divergent_sum", "pole", steps, map{});
            }

            // 4a. Combine rational / trig fractions (e.g. 1/sin(x) - 1/x -> (x - sin(x))/(x*sin(x)), sec(x) - tan(x))
            let trig_norm = _trig_to_sincos(raw_ast, 0);
            let comb = _to_single_fraction(trig_norm, 0);
            if not _is_num_eq(comb.den, 1) {
                array_push(steps, "difference_inf_minus_inf: combine fractions -> (" + format_ascii(comb.num, 0) + ") / (" + format_ascii(comb.den, 0) + ")");
                let qr_c = _resolve_quotient_limit(comb.num, comb.den, var_name, target, dir, "inf-inf", steps, depth + 1);
                if not map_has(qr_c, "_unresolved") {
                    return qr_c;
                }
            }

            // 4b. Radical Conjugate Rationalization (e.g. sqrt(x^2 + 4*x) - x -> 4*x / (sqrt(x^2 + 4*x) + x) -> 2)
            let conj = _try_radical_conjugate(raw_ast, var_name);
            if conj.ok {
                array_push(steps, "difference_inf_minus_inf: radical conjugate -> (" + format_ascii(conj.num, 0) + ") / (" + format_ascii(conj.den, 0) + ")");
                let qr_rad = _resolve_quotient_limit(conj.num, conj.den, var_name, target, dir, "inf-inf", steps, depth + 1);
                if not map_has(qr_rad, "_unresolved") {
                    return qr_rad;
                }
            }

            // 4c. Logarithmic combination c*ln(U) - c*ln(V) -> c*ln(U/V)
            if raw_ast.op == "-" and raw_ast.left.kind == "call" and raw_ast.left.name == "ln" and raw_ast.right.kind == "call" and raw_ast.right.name == "ln" {
                let ratio_ln = _simp(_bin("/", raw_ast.left.args[0], raw_ast.right.args[0]));
                let r_in = _limit_core(ratio_ln, var_name, target, dir, steps, depth + 1);
                if r_in.exists and type(r_in.value) == "number" and r_in.value > 0.0 {
                    let lv = _snap_num(num_ln(r_in.value));
                    let sym_ln = if r_in.exact_fraction != nil and r_in.exact_fraction != "1" { "ln(" + r_in.exact_fraction + ")" } else { nil };
                    return _make_limit_res(true, lv, nil, nil, "log_quotient_rule", "inf-inf", steps, map{ symbolic_value: sym_ln });
                }
            }
        }
    }

    // 5. Quotient Forms (including trig-normalized tan/cot/sec/csc quotients)
    let trig_ast = _simp(_trig_to_sincos(ast, 0));
    if ast.kind == "bin" and ast.op == "/" {
        let qr = _resolve_quotient_limit(ast.left, ast.right, var_name, target, dir, nil, steps, depth + 1);
        if not map_has(qr, "_unresolved") {
            return qr;
        }
    } else if trig_ast.kind == "bin" and trig_ast.op == "/" {
        let qr_t = _resolve_quotient_limit(trig_ast.left, trig_ast.right, var_name, target, dir, nil, steps, depth + 1);
        if not map_has(qr_t, "_unresolved") {
            return qr_t;
        }
    }

    // 5b. Analytical Function Composition Rules (exp, ln, atan, erf, erfc, tanh, sqrt)
    if ast.kind == "call" and len(ast.args) == 1 and depth <= 8 {
        let nm = ast.name;
        if nm == "exp" or nm == "ln" or nm == "atan" or nm == "erf" or nm == "erfc" or nm == "tanh" or nm == "sqrt" {
            let ru_c = _limit_core(ast.args[0], var_name, target, dir, [], depth + 1);
            if ru_c.exists {
                let is_p = _inf_sign_val(ru_c.value) == 1;
                let is_m = _inf_sign_val(ru_c.value) == -1;
                if nm == "exp" {
                    if is_p { return _make_limit_res(true, "+inf", nil, nil, "composition", "pole", steps, map{}); }
                    if is_m {
                        let lz = if inf_flag != 0 or dir == "+" or dir == "right" { nil } else { 0 };
                        let rz = if inf_flag != 0 or dir == "-" or dir == "left" { nil } else { 0 };
                        return _make_limit_res(true, 0, lz, rz, "composition", "none", steps, map{});
                    }
                }
                if nm == "ln" and is_p {
                    return _make_limit_res(true, "+inf", nil, nil, "composition", "pole", steps, map{});
                }
                if nm == "sqrt" and is_p {
                    return _make_limit_res(true, "+inf", nil, nil, "composition", "pole", steps, map{});
                }
                if nm == "atan" {
                    if is_p { return _make_limit_res(true, 0.5 * PI, nil, nil, "composition", "none", steps, map{ symbolic_value: "pi/2" }); }
                    if is_m { return _make_limit_res(true, -0.5 * PI, nil, nil, "composition", "none", steps, map{ symbolic_value: "-pi/2" }); }
                }
                if nm == "erf" {
                    if is_p { return _make_limit_res(true, 1, nil, nil, "composition", "none", steps, map{}); }
                    if is_m { return _make_limit_res(true, -1, nil, nil, "composition", "none", steps, map{}); }
                }
                if nm == "erfc" {
                    if is_p { return _make_limit_res(true, 0, nil, nil, "composition", "none", steps, map{}); }
                    if is_m { return _make_limit_res(true, 2, nil, nil, "composition", "none", steps, map{}); }
                }
                if nm == "tanh" {
                    if is_p { return _make_limit_res(true, 1, nil, nil, "composition", "none", steps, map{}); }
                    if is_m { return _make_limit_res(true, -1, nil, nil, "composition", "none", steps, map{}); }
                }
            }
        }
    }

    // 6. Limits at +/- infinity for non-quotients
    if inf_flag != 0 {
        let sgn = inf_flag * 1.0;
        let poly_x = _extract_poly(ast, var_name, 16);
        if poly_x.ok and poly_x.deg >= 1 {
            let lead = poly_x.coeffs[poly_x.deg] * _safe_pow(sgn, poly_x.deg);
            let inf_s = if lead > 0.0 { "+inf" } else { "-inf" };
            return _make_limit_res(true, inf_s, nil, nil, "polynomial_leading_term", "pole", steps, map{});
        }
        let t_sym = "__lim_t";
        let sub_x = if sgn > 0.0 { _bin("/", _num(1), _sym(t_sym)) } else { _neg(_bin("/", _num(1), _sym(t_sym))) };
        let t_ast = _simp(_subst_ast(ast, var_name, sub_x, 0));
        let r_side = _one_sided_limit(t_ast, t_sym, 0.0, 1.0);
        if r_side.kind == "finite" or r_side.kind == "inf" {
            array_push(steps, "infinity_substitution: " + var_name + " = " + format_ascii(sub_x, 0) + " as t -> 0+");
            let f_ind = if r_side.kind == "inf" { "pole" } else { "none" };
            return _make_limit_res(true, r_side.val, nil, nil, "substitution_richardson", f_ind, steps, map{});
        }
        let v1 = _eval_1d(ast, var_name, sgn * 1e4);
        let v2 = _eval_1d(ast, var_name, sgn * 1e5);
        if _is_finite(v1) and _is_finite(v2) and num_abs(v2 - v1) < 1e-4 * (1.0 + num_abs(v2)) {
            return _make_limit_res(true, _snap_num(v2), nil, nil, "asymptotic_probe", "none", steps, map{});
        }
        return _make_limit_res(false, nil, nil, nil, "divergent_or_oscillatory", "none", steps, map{});
    }

    // 7. Finite target c_val: Direct continuity, One-sided Richardson, Jump Discontinuity & Poles
    let c_val = target * 1.0;
    let has_kink = _contains_abs_zero_at(ast, var_name, c_val, 0);

    if not has_kink {
        // Try AD Taylor Jet order 0 first for exact smooth evaluation (including removable cancellations in subexpressions!)
        let j0 = _eval_taylor_jet_1d(ast, var_name, c_val, 4, 0);
        if j0.ok and len(j0.c) >= 1 {
            let direct = j0.c[0];
            let pr = _eval_1d(ast, var_name, c_val + 1e-7);
            let pl = _eval_1d(ast, var_name, c_val - 1e-7);
            let ok_r = _is_finite(pr) and num_abs(pr - direct) < 1e-4 * (1.0 + num_abs(direct));
            let ok_l = _is_finite(pl) and num_abs(pl - direct) < 1e-4 * (1.0 + num_abs(direct));
            if (dir == "both" and ok_l and ok_r) or ((dir == "+" or dir == "right") and ok_r) or ((dir == "-" or dir == "left") and ok_l) {
                array_push(steps, "direct_continuity at " + var_name + " = " + _num_to_clean_str(c_val));
                let dv = _snap_num(direct);
                let l_lim = if dir == "+" or dir == "right" { nil } else { dv };
                let r_lim = if dir == "-" or dir == "left" { nil } else { dv };
                return _make_limit_res(true, dv, l_lim, r_lim, "direct_evaluation", "none", steps, map{});
            }
        }
    }

    let right_res = _one_sided_limit(ast, var_name, c_val, 1.0);
    let left_res = _one_sided_limit(ast, var_name, c_val, -1.0);

    if dir == "+" or dir == "right" {
        let f_ind = if right_res.kind == "inf" { "pole" } else { "none" };
        return _make_limit_res(right_res.kind != "undefined", right_res.val, nil, right_res.val, "richardson_right", f_ind, steps, map{});
    }
    if dir == "-" or dir == "left" {
        let f_ind = if left_res.kind == "inf" { "pole" } else { "none" };
        return _make_limit_res(left_res.kind != "undefined", left_res.val, left_res.val, nil, "richardson_left", f_ind, steps, map{});
    }

    // Two-sided comparison
    if left_res.kind == "finite" and right_res.kind == "finite" {
        let diff_lr = num_abs(left_res.val - right_res.val);
        let tol_lr = 1e-5 * (1.0 + num_abs(left_res.val) + num_abs(right_res.val));
        if diff_lr <= tol_lr {
            let avg = _snap_num(0.5 * (left_res.val + right_res.val));
            return _make_limit_res(true, avg, left_res.val, right_res.val, "richardson_two_sided", "none", steps, map{});
        }
        array_push(steps, "jump_discontinuity: left_limit (" + str(left_res.val) + ") != right_limit (" + str(right_res.val) + ")");
        return _make_limit_res(false, nil, left_res.val, right_res.val, "two_sided_discontinuity", "jump_discontinuity", steps, map{});
    }
    if left_res.kind == "inf" and right_res.kind == "inf" and left_res.val == right_res.val {
        return _make_limit_res(true, left_res.val, left_res.val, right_res.val, "unbounded_pole", "pole", steps, map{});
    }
    if left_res.kind == "inf" or right_res.kind == "inf" {
        // Check half-line real domain (e.g. ln(x) at 0 where x > 0)
        if left_res.kind == "undefined" and right_res.kind == "inf" {
            let dom_r = var_name + " > " + _num_to_clean_str(c_val);
            return _make_limit_res(false, nil, nil, right_res.val, "two_sided_discontinuity", "pole", steps, map{ domain_restricted: dom_r });
        }
        if right_res.kind == "undefined" and left_res.kind == "inf" {
            let dom_l = var_name + " < " + _num_to_clean_str(c_val);
            return _make_limit_res(false, nil, left_res.val, nil, "two_sided_discontinuity", "pole", steps, map{ domain_restricted: dom_l });
        }
        return _make_limit_res(false, nil, left_res.val, right_res.val, "two_sided_discontinuity", "pole", steps, map{});
    }
    // Half-line finite boundary limit (e.g. sqrt(x) at 0 where x >= 0)
    if left_res.kind == "undefined" and right_res.kind == "finite" {
        let dom_r = var_name + " > " + _num_to_clean_str(c_val);
        return _make_limit_res(false, nil, nil, right_res.val, "two_sided_discontinuity", "none", steps, map{ domain_restricted: dom_r });
    }
    if right_res.kind == "undefined" and left_res.kind == "finite" {
        let dom_l = var_name + " < " + _num_to_clean_str(c_val);
        return _make_limit_res(false, nil, left_res.val, nil, "two_sided_discontinuity", "none", steps, map{ domain_restricted: dom_l });
    }
    return _make_limit_res(false, nil, left_res.val, right_res.val, "two_sided_discontinuity", "none", steps, map{});
}

fn limit(expr, var_name = "x", target = 0, dir = "both") {
    let raw_ast = parse_expr(expr);
    let eff_target = target;
    if type(target) == "string" and _is_inf_bound(target) == 0 {
        let tv = try _eval_ast(parse_expr(target), map{}, 0) catch _nan_val();
        if _is_finite(tv) { eff_target = tv; }
    }
    let steps = [];
    return _limit_core(raw_ast, var_name, eff_target, dir, steps, 0);
}

fn taylor(expr, var_name = "x", center = 0, order = 5) {
    if order < 0 or order > 32 {
        throw "calculus_ode: taylor order must be in 0..32";
    }
    let cur = _simp(parse_expr(expr));
    let c0 = center * 1.0;
    let coeffs = [];
    let terms = [];
    let st = [];
    let k = 0;
    while k <= order {
        let fk = _eval_1d(cur, var_name, c0);
        if not _is_finite(fk) {
            throw "calculus_ode: expression or derivative singular at center = " + str(c0);
        }
        let ck = _snap_num(fk / _factorial(k));
        array_push(coeffs, ck);
        if not _near_zero(ck) {
            let base = if _near_zero(c0) { _sym(var_name) } else { _simp(_bin("-", _sym(var_name), _num_or_simple_rat(c0))) };
            let xpow = if k == 0 { _num(1) } else if k == 1 { base } else { _bin("^", base, _num(k)) };
            let c_ast = _num_or_simple_rat(ck);
            array_push(terms, _simp(_bin("*", c_ast, xpow)));
        }
        if k < order {
            cur = _simp(_diff_ast(cur, var_name, st, 0));
        }
        k = k + 1;
    }
    let poly_ast = _num(0);
    if len(terms) > 0 {
        poly_ast = terms[0];
        let i = 1;
        while i < len(terms) {
            let nxt = terms[i];
            if nxt.kind == "neg" { poly_ast = _bin("-", poly_ast, nxt.arg); }
            else { poly_ast = _bin("+", poly_ast, nxt); }
            i = i + 1;
        }
    }
    let asc = format_ascii(poly_ast, 0);
    return map{
        expr: asc,
        ascii: asc,
        unicode: format_unicode(poly_ast, 0),
        latex: format_latex(poly_ast, 0),
        ast: poly_ast,
        coefficients: coeffs,
        center: c0,
        order: order,
        variable: var_name,
        evaluate: fn(xv) { return _eval_1d(poly_ast, var_name, xv); }
    };
}

fn pade(expr, var_name = "x", center = 0, m = 2, n = 2) {
    let t = taylor(expr, var_name, center, m + n);
    let c = t.coefficients;
    let b = [1.0];
    if n > 0 {
        let mat = [];
        let rhs = [];
        let row = 0;
        while row < n {
            let r_arr = [];
            let idx_c = m + 1 + row;
            let col = 0;
            while col < n {
                let k_sub = idx_c - (col + 1);
                let val_c = if k_sub >= 0 { c[k_sub] } else { 0.0 };
                array_push(r_arr, val_c);
                col = col + 1;
            }
            array_push(mat, r_arr);
            array_push(rhs, 0.0 - c[idx_c]);
            row = row + 1;
        }
        let sol = _linear_solve_det(mat, rhs);
        if sol.ok {
            let j = 0;
            while j < n { array_push(b, _snap_num(sol.x[j])); j = j + 1; }
        } else {
            let j = 0;
            while j < n { array_push(b, 0.0); j = j + 1; }
        }
    }
    let a = [];
    let k = 0;
    while k <= m {
        let ak = 0.0;
        let j = 0;
        while j <= n and j <= k {
            ak = ak + b[j] * c[k - j];
            j = j + 1;
        }
        array_push(a, _snap_num(ak));
        k = k + 1;
    }
    let num_ast = _poly_coeffs_to_ast(a, var_name, center * 1.0);
    let den_ast = _poly_coeffs_to_ast(b, var_name, center * 1.0);
    let rat_ast = _simp(_bin("/", num_ast, den_ast));
    return map{
        expr: format_ascii(rat_ast, 0),
        ascii: format_ascii(rat_ast, 0),
        unicode: format_unicode(rat_ast, 0),
        latex: format_latex(rat_ast, 0),
        numerator_coeffs: a,
        denominator_coeffs: b,
        evaluate: fn(xv) { return _eval_1d(rat_ast, var_name, xv); }
    };
}

// Closed-form Faulhaber sum S_p(N) = sum_{k=1}^N k^p for N >= 0, p in 0..6
fn _faulhaber_pos(N, p) {
    if N <= 0 { return 0.0; }
    let n = N * 1.0;
    if p == 0 { return n; }
    if p == 1 { return n * (n + 1.0) / 2.0; }
    if p == 2 { return n * (n + 1.0) * (2.0 * n + 1.0) / 6.0; }
    if p == 3 {
        let s1 = n * (n + 1.0) / 2.0;
        return s1 * s1;
    }
    if p == 4 { return n * (n + 1.0) * (2.0 * n + 1.0) * (3.0 * n * n + 3.0 * n - 1.0) / 30.0; }
    if p == 5 { return n * n * (n + 1.0) * (n + 1.0) * (2.0 * n * n + 2.0 * n - 1.0) / 12.0; }
    if p == 6 {
        let n2 = n * n;
        let n3 = n2 * n;
        let n4 = n2 * n2;
        return n * (n + 1.0) * (2.0 * n + 1.0) * (3.0 * n4 + 6.0 * n3 - 3.0 * n + 1.0) / 42.0;
    }
    return 0.0;
}

fn _faulhaber_range(lo_i, hi_i, p) {
    if lo_i > hi_i { return 0.0; }
    if lo_i >= 1 {
        return _faulhaber_pos(hi_i, p) - _faulhaber_pos(lo_i - 1, p);
    }
    let zero_term = if lo_i <= 0 and hi_i >= 0 and p == 0 { 1.0 } else { 0.0 };
    let pos_part = if hi_i >= 1 { _faulhaber_pos(hi_i, p) } else { 0.0 };
    let neg_part = 0.0;
    if lo_i <= -1 {
        let neg_hi = if hi_i < -1 { 0 - hi_i - 1 } else { 0 };
        let mag_sum = _faulhaber_pos(0 - lo_i, p) - _faulhaber_pos(neg_hi, p);
        let sign = if num_mod(p, 2) == 1 { -1.0 } else { 1.0 };
        neg_part = sign * mag_sum;
    }
    return neg_part + zero_term + pos_part;
}

fn sum_series(expr, var_name, lo, hi) {
    let ast = _simp(parse_expr(expr));
    let lo_i = num_round(lo);
    let hi_inf = _is_inf_bound(hi);

    // Check geometric series: term(k+1)/term(k) == constant ratio R
    let t0 = _eval_1d(ast, var_name, lo_i);
    let t1 = _eval_1d(ast, var_name, lo_i + 1);
    let t2 = _eval_1d(ast, var_name, lo_i + 2);
    let t3 = _eval_1d(ast, var_name, lo_i + 3);
    if _is_finite(t0) and _is_finite(t1) and _is_finite(t2) and _is_finite(t3) and num_abs(t0) > 1e-14 and num_abs(t1) > 1e-14 and num_abs(t2) > 1e-14 {
        let r1 = t1 / t0;
        let r2 = t2 / t1;
        let r3 = t3 / t2;
        if num_abs(r1 - r2) < 1e-12 * (1.0 + num_abs(r1)) and num_abs(r2 - r3) < 1e-12 * (1.0 + num_abs(r1)) {
            let t10 = _eval_1d(ast, var_name, lo_i + 10);
            let pred10 = t0 * _safe_pow(r1, 10);
            if _is_finite(t10) and _is_finite(pred10) and num_abs(t10 - pred10) < 1e-10 * (1.0 + num_abs(pred10)) {
                if hi_inf == 1 {
                    if num_abs(r1) < 1.0 - 1e-14 {
                        let val_g = _snap_num(t0 / (1.0 - r1));
                        return map{ value: val_g, converged: true, method: "geometric_closed_form", ratio: _snap_num(r1) };
                    }
                    return map{ value: nil, converged: false, method: "geometric_divergent", ratio: _snap_num(r1) };
                } else {
                    let hi_i = num_round(hi);
                    if hi_i < lo_i { return map{ value: 0, converged: true, method: "empty_range" }; }
                    let count = hi_i - lo_i + 1;
                    if num_abs(r1 - 1.0) < 1e-14 {
                        return map{ value: _snap_num(t0 * count), converged: true, method: "geometric_closed_form" };
                    }
                    let val_fg = _snap_num(t0 * (1.0 - _safe_pow(r1, count)) / (1.0 - r1));
                    return map{ value: val_fg, converged: true, method: "geometric_closed_form", ratio: _snap_num(r1) };
                }
            }
        }
    }

    // Finite range
    if hi_inf == 0 {
        let hi_i = num_round(hi);
        if hi_i < lo_i { return map{ value: 0, converged: true, method: "empty_range" }; }
        // Exact closed-form Faulhaber for polynomials of degree <= 6
        let poly = _extract_poly(ast, var_name, 6);
        if poly.ok {
            let total = 0.0;
            let p = 0;
            while p < len(poly.coeffs) {
                if not _near_zero(poly.coeffs[p]) {
                    total = total + poly.coeffs[p] * _faulhaber_range(lo_i, hi_i, p);
                }
                p = p + 1;
            }
            return map{ value: _snap_num(total), converged: true, method: "faulhaber_closed_form" };
        }
        // Direct summation up to MAX_ODE_STEPS
        let count = hi_i - lo_i + 1;
        if count <= MAX_ODE_STEPS {
            let acc = 0.0;
            let k = lo_i;
            while k <= hi_i {
                acc = acc + _eval_1d(ast, var_name, k);
                k = k + 1;
            }
            return map{ value: _snap_num(acc), converged: true, method: "direct_sum" };
        }
        // Euler-Maclaurin for huge finite ranges > MAX_ODE_STEPS
        let n_cut = lo_i + 200;
        let head = 0.0;
        let k = lo_i;
        while k < n_cut {
            head = head + _eval_1d(ast, var_name, k);
            k = k + 1;
        }
        let int_tail = integrate_definite(ast, var_name, n_cut, hi_i, 1e-12).value;
        let st_em = [];
        let d1 = _simp(_diff_ast(ast, var_name, st_em, 0));
        let d2 = _simp(_diff_ast(d1, var_name, st_em, 0));
        let d3 = _simp(_diff_ast(d2, var_name, st_em, 0));
        let f_a = _eval_1d(ast, var_name, n_cut);
        let f_b = _eval_1d(ast, var_name, hi_i);
        let d1_a = _eval_1d(d1, var_name, n_cut);
        let d1_b = _eval_1d(d1, var_name, hi_i);
        let d3_a = _eval_1d(d3, var_name, n_cut);
        let d3_b = _eval_1d(d3, var_name, hi_i);
        let em = head + int_tail + 0.5 * (f_a + f_b) + (d1_b - d1_a) / 12.0 - (d3_b - d3_a) / 720.0;
        return map{ value: _snap_num(em), converged: true, method: "euler_maclaurin_finite" };
    }

    // Convergent infinite series (hi == "inf")
    // Detect alternating vs monotone tail
    let f_chk1 = _eval_1d(ast, var_name, lo_i + 20);
    let f_chk2 = _eval_1d(ast, var_name, lo_i + 21);
    if _is_finite(f_chk1) and _is_finite(f_chk2) and f_chk1 * f_chk2 < 0.0 {
        // Wynn's epsilon algorithm (Padé-type sequence accelerator) on partial sums
        let n_terms = 40;
        let psums = [];
        let s_acc = 0.0;
        let idx = 0;
        while idx < n_terms {
            s_acc = s_acc + _eval_1d(ast, var_name, lo_i + idx);
            array_push(psums, s_acc);
            idx = idx + 1;
        }
        let eps_prev = [];
        let eps_curr = [];
        let m = 0;
        while m < n_terms {
            array_push(eps_prev, 0.0);
            array_push(eps_curr, psums[m]);
            m = m + 1;
        }
        let step_w = 1;
        let best = psums[n_terms - 1];
        while step_w < n_terms - 1 {
            let nxt_col = [];
            let r = 0;
            while r < n_terms - step_w {
                let diff_e = eps_curr[r + 1] - eps_curr[r];
                let val_e = if num_abs(diff_e) < 1e-30 { eps_prev[r + 1] } else { eps_prev[r + 1] + 1.0 / diff_e };
                array_push(nxt_col, val_e);
                r = r + 1;
            }
            eps_prev = eps_curr;
            eps_curr = nxt_col;
            if num_mod(step_w, 2) == 0 and len(eps_curr) > 0 {
                best = eps_curr[len(eps_curr) - 1];
            }
            step_w = step_w + 1;
        }
        return map{ value: best, converged: true, method: "wynn_epsilon_acceleration" };
    }

    // Positive / smooth tail: Euler-Maclaurin tail acceleration at N = lo + 200
    let N_cut = lo_i + 200;
    let partial = 0.0;
    let k = lo_i;
    while k < N_cut {
        let tk = _eval_1d(ast, var_name, k);
        if not _is_finite(tk) {
            return map{ value: nil, converged: false, method: "singular_term" };
        }
        partial = partial + tk;
        k = k + 1;
    }
    let tail_int = integrate_improper_or_singular(ast, var_name, N_cut, "+inf", 1e-13);
    if not _is_finite(tail_int.value) {
        return map{ value: nil, converged: false, method: "divergent_integral_test" };
    }
    let st_em = [];
    let d1 = _simp(_diff_ast(ast, var_name, st_em, 0));
    let d2 = _simp(_diff_ast(d1, var_name, st_em, 0));
    let d3 = _simp(_diff_ast(d2, var_name, st_em, 0));
    let d4 = _simp(_diff_ast(d3, var_name, st_em, 0));
    let d5 = _simp(_diff_ast(d4, var_name, st_em, 0));

    let fN = _eval_1d(ast, var_name, N_cut);
    let d1N = _eval_1d(d1, var_name, N_cut);
    let d3N = _eval_1d(d3, var_name, N_cut);
    let d5N = _eval_1d(d5, var_name, N_cut);

    // Euler-Maclaurin remainder: sum_{k=N}^inf f(k) = int_N^inf f(x)dx + f(N)/2 - f'(N)/12 + f'''(N)/720 - f^(5)(N)/30240
    let corr = 0.5 * fN;
    if _is_finite(d1N) { corr = corr - d1N / 12.0; }
    if _is_finite(d3N) { corr = corr + d3N / 720.0; }
    if _is_finite(d5N) { corr = corr - d5N / 30240.0; }

    let total_inf = partial + tail_int.value + corr;
    return map{
        value: total_inf,
        converged: true,
        method: "euler_maclaurin_tail_acceleration"
    };
}

// ============================================================================
// 11. Symbolic ODE Solver (`solve_ode_symbolic`)
// ============================================================================

fn _particular_2nd_term(term_ast, a_v, b_v, c_v, x_var) {
    let s = _simp(term_ast);
    if _is_num_eq(s, 0) { return _num(0); }

    // 1. Polynomial term P(x) (includes constants)
    let poly = _extract_poly(s, x_var, 6);
    if poly.ok {
        let deg = poly.deg;
        let shift = 0;
        if _near_zero(c_v) {
            if not _near_zero(b_v) { shift = 1; }
            else { shift = 2; }
        }
        // Build ansatz y_p = sum_{j=0}^deg A_j * x^(j + shift) and match coefficients of x^0..x^deg
        let n_unk = deg + 1;
        let mat = [];
        let rhs = [];
        let row = 0;
        while row < n_unk {
            let r_arr = [];
            let col = 0;
            while col < n_unk { array_push(r_arr, 0.0); col = col + 1; }
            array_push(mat, r_arr);
            array_push(rhs, poly.coeffs[row]);
            row = row + 1;
        }
        let j = 0;
        while j < n_unk {
            let p_pow = j + shift;
            // c * x^p_pow
            if p_pow < n_unk and not _near_zero(c_v) {
                mat[p_pow][j] = mat[p_pow][j] + c_v;
            }
            // b * p_pow * x^(p_pow - 1)
            if p_pow >= 1 and (p_pow - 1) < n_unk and not _near_zero(b_v) {
                mat[p_pow - 1][j] = mat[p_pow - 1][j] + b_v * p_pow;
            }
            // a * p_pow * (p_pow - 1) * x^(p_pow - 2)
            if p_pow >= 2 and (p_pow - 2) < n_unk and not _near_zero(a_v) {
                mat[p_pow - 2][j] = mat[p_pow - 2][j] + a_v * p_pow * (p_pow - 1);
            }
            j = j + 1;
        }
        let sol = _linear_solve_det(mat, rhs);
        if sol.ok {
            let full_c = [];
            let z = 0;
            while z < shift { array_push(full_c, 0.0); z = z + 1; }
            let m = 0;
            while m < n_unk { array_push(full_c, sol.x[m]); m = m + 1; }
            return _poly_coeffs_to_ast(full_c, x_var, 0.0);
        }
    }

    // Extract scalar multiplier K * core
    let sp = _split_coeff_and_core(s);
    let K_val = sp.f;
    let core = sp.core;

    // 2. Exponential K * exp(k*x + d)
    if core.kind == "call" and core.name == "exp" and len(core.args) == 1 {
        let lin = _match_linear(core.args[0], x_var);
        if lin.ok {
            let kv = lin.a;
            let pk = a_v * kv * kv + b_v * kv + c_v;
            let dpk = 2.0 * a_v * kv + b_v;
            if num_abs(pk) > 1e-11 {
                return _simp(_bin("*", _num_or_simple_rat(K_val / pk), core));
            }
            if num_abs(dpk) > 1e-11 {
                return _simp(_bin("*", _bin("*", _num_or_simple_rat(K_val / dpk), _sym(x_var)), core));
            }
            return _simp(_bin("*", _bin("*", _num_or_simple_rat(K_val / (2.0 * a_v)), _bin("^", _sym(x_var), _num(2))), core));
        }
    }

    // 3. Sinusoid K * sin(w*x) or K * cos(w*x)
    if core.kind == "call" and (core.name == "sin" or core.name == "cos") and len(core.args) == 1 {
        let lin = _match_linear(core.args[0], x_var);
        if lin.ok and not _near_zero(lin.a) {
            let wv = lin.a;
            let u_arg = core.args[0];
            let K1 = if core.name == "cos" { K_val } else { 0.0 };
            let K2 = if core.name == "sin" { K_val } else { 0.0 };
            let M = c_v - a_v * wv * wv;
            let N = b_v * wv;
            let D = M * M + N * N;
            if D > 1e-18 {
                let A_cos = (K1 * M - K2 * N) / D;
                let B_sin = (K1 * N + K2 * M) / D;
                let tc = if _near_zero(A_cos) { _num(0) } else { _bin("*", _num_or_simple_rat(A_cos), _call("cos", [u_arg])) };
                let ts = if _near_zero(B_sin) { _num(0) } else { _bin("*", _num_or_simple_rat(B_sin), _call("sin", [u_arg])) };
                return _simp(_bin("+", tc, ts));
            } else {
                // Undamped resonance: b == 0 and c == a*w^2
                let A_res = (0.0 - K2) / (2.0 * a_v * wv);
                let B_res = K1 / (2.0 * a_v * wv);
                let tc = if _near_zero(A_res) { _num(0) } else { _bin("*", _num_or_simple_rat(A_res), _call("cos", [u_arg])) };
                let ts = if _near_zero(B_res) { _num(0) } else { _bin("*", _num_or_simple_rat(B_res), _call("sin", [u_arg])) };
                return _simp(_bin("*", _sym(x_var), _bin("+", tc, ts)));
            }
        }
    }

    throw "calculus_ode: unsupported forcing term '" + format_ascii(s, 0) + "' in undetermined coefficients";
}

fn solve_ode_symbolic(ode_str, ivp = nil) {
    let parts = str_split(ode_str, "=");
    let lhs_s = str_trim(parts[0]);
    let rhs_s = if len(parts) >= 2 { str_trim(parts[1]) } else { "0" };

    // Detect independent variable ("t" if ivp uses t0 or if 't' present without 'x', default "x")
    let x_var = "x";
    if type(ivp) == "map" and map_has(ivp, "t0") and not map_has(ivp, "x0") {
        x_var = "t";
    } else if str_contains(ode_str, "t") and not str_contains(ode_str, "x") {
        // Avoid matching "tan", "cot", "atan", "sqrt", "cbrt", "lambertw" falsely by checking after stripping function names
        let stripped = str_replace_all(str_replace_all(str_replace_all(ode_str, "lambertw", ""), "LambertW", ""), "sqrt", "");
        stripped = str_replace_all(str_replace_all(stripped, "atan", ""), "cot", "");
        stripped = str_replace_all(str_replace_all(stripped, "tan", ""), "cbrt", "");
        if str_contains(stripped, "t") { x_var = "t"; }
    }

    let norm_l = str_replace_all(str_replace_all(lhs_s, "y''", "__d2y"), "y'", "__dy");
    let norm_r = str_replace_all(str_replace_all(rhs_s, "y''", "__d2y"), "y'", "__dy");
    let eq_ast = _simp(_bin("-", parse_expr(norm_l), parse_expr(norm_r)));

    let st = [];
    let a_ast = _simp(_diff_ast(eq_ast, "__d2y", st, 0));
    let b_ast = _simp(_diff_ast(eq_ast, "__dy", st, 0));
    let c_ast = _simp(_diff_ast(eq_ast, "y", st, 0));

    let rem0 = _subst_ast(eq_ast, "__d2y", _num(0), 0);
    rem0 = _subst_ast(rem0, "__dy", _num(0), 0);
    rem0 = _simp(_subst_ast(rem0, "y", _num(0), 0));
    let g_ast = _simp(_neg(rem0));

    let a_is_zero = _is_num_eq(a_ast, 0);

    // ------------------------------------------------------------------------
    // Case A: First-Order ODE (b * y' + c * y = g(x))
    // ------------------------------------------------------------------------
    if a_is_zero {
        if _is_num_eq(b_ast, 0) {
            throw "calculus_ode: no derivative y' or y'' found in ODE '" + ode_str + "'";
        }
        let p_ast = _simp(_bin("/", c_ast, b_ast));
        let q_ast = _simp(_bin("/", g_ast, b_ast));

        // Integrating factor mu(x) = exp(∫ P(x) dx)
        let int_p = _int_ast(p_ast, x_var, 0);
        if not int_p.ok {
            throw "calculus_ode: could not integrate P(" + x_var + ") = " + format_ascii(p_ast, 0);
        }
        let P_big = _simp(int_p.ast);
        let yh_basis = _simp(_call("exp", [_simp(_neg(P_big))]));

        let yp_ast = _num(0);
        if not _is_num_eq(q_ast, 0) {
            let mu_q = _simp(_bin("*", _call("exp", [P_big]), q_ast));
            let int_rhs = _int_ast(mu_q, x_var, 0);
            if not int_rhs.ok {
                throw "calculus_ode: could not integrate integrating-factor RHS " + format_ascii(mu_q, 0);
            }
            yp_ast = _simp(_bin("*", yh_basis, int_rhs.ast));
        }

        let sol_ast = _simp(_bin("+", _bin("*", _sym("C1"), yh_basis), yp_ast));
        let c1_solved = nil;
        if type(ivp) == "map" {
            let x0 = if map_has(ivp, "x0") { ivp.x0 * 1.0 } else if map_has(ivp, "t0") { ivp.t0 * 1.0 } else { 0.0 };
            let y0 = ivp.y0 * 1.0;
            let u1_0 = _eval_1d(yh_basis, x_var, x0);
            let yp_0 = _eval_1d(yp_ast, x_var, x0);
            let c1_v = _snap_num((y0 - yp_0) / u1_0);
            c1_solved = c1_v;
            sol_ast = _simp(_bin("+", _bin("*", _num_or_simple_rat(c1_v), yh_basis), yp_ast));
        }

        let asc = format_ascii(sol_ast, 0);
        return map{
            order: 1,
            variable: x_var,
            expr: asc,
            ascii: asc,
            unicode: format_unicode(sol_ast, 0),
            latex: format_latex(sol_ast, 0),
            homogeneous: format_ascii(_simp(_bin("*", _sym("C1"), yh_basis)), 0),
            particular: format_ascii(yp_ast, 0),
            constants: if c1_solved != nil { map{ C1: c1_solved } } else { nil },
            ast: sol_ast,
            evaluate: fn(xv) { return _eval_1d(sol_ast, x_var, xv); }
        };
    }

    // ------------------------------------------------------------------------
    // Case B: Second-Order Constant-Coefficient Linear ODE (a*y'' + b*y' + c*y = g(x))
    // ------------------------------------------------------------------------
    if _depends_on(a_ast, x_var, 0) or _depends_on(b_ast, x_var, 0) or _depends_on(c_ast, x_var, 0) {
        throw "calculus_ode: 2nd-order symbolic solver requires constant coefficients";
    }
    let av = _eval_ast(a_ast, map{}, 0);
    let bv = _eval_ast(b_ast, map{}, 0);
    let cv = _eval_ast(c_ast, map{}, 0);

    let disc = bv * bv - 4.0 * av * cv;
    let x_sym = _sym(x_var);
    let u1 = nil;
    let u2 = nil;
    let regime = "";

    if disc > 1e-11 {
        regime = "overdamped_real_distinct";
        let sq = num_sqrt(disc);
        let r1 = _snap_num((0.0 - bv + sq) / (2.0 * av));
        let r2 = _snap_num((0.0 - bv - sq) / (2.0 * av));
        u1 = if _near_zero(r1) { _num(1) } else { _simp(_call("exp", [_simp(_bin("*", _num_or_simple_rat(r1), x_sym))])) };
        u2 = if _near_zero(r2) { _num(1) } else { _simp(_call("exp", [_simp(_bin("*", _num_or_simple_rat(r2), x_sym))])) };
    } else if num_abs(disc) <= 1e-11 {
        regime = "critically_damped_repeated";
        let r0 = _snap_num((0.0 - bv) / (2.0 * av));
        u1 = if _near_zero(r0) { _num(1) } else { _simp(_call("exp", [_simp(_bin("*", _num_or_simple_rat(r0), x_sym))])) };
        u2 = _simp(_bin("*", x_sym, u1));
    } else {
        regime = "underdamped_harmonic";
        let alpha = _snap_num((0.0 - bv) / (2.0 * av));
        let beta = _snap_num(num_sqrt(0.0 - disc) / (2.0 * num_abs(av)));
        let env_exp = if _near_zero(alpha) { _num(1) } else { _simp(_call("exp", [_simp(_bin("*", _num_or_simple_rat(alpha), x_sym))])) };
        let bx = _simp(_bin("*", _num_or_simple_rat(beta), x_sym));
        u1 = _simp(_bin("*", env_exp, _call("cos", [bx])));
        u2 = _simp(_bin("*", env_exp, _call("sin", [bx])));
    }

    // Particular solution y_p(x) across additive terms of g(x)
    let yp = _num(0);
    if not _is_num_eq(g_ast, 0) {
        let g_terms = [];
        let _ = _collect_sum_terms(g_ast, 1, g_terms, 0);
        let ti = 0;
        while ti < len(g_terms) {
            let p_part = _particular_2nd_term(g_terms[ti], av, bv, cv, x_var);
            yp = _simp(_bin("+", yp, p_part));
            ti = ti + 1;
        }
    }

    let yh_gen = _simp(_bin("+", _bin("*", _sym("C1"), u1), _bin("*", _sym("C2"), u2)));
    let sol_ast = _simp(_bin("+", yh_gen, yp));
    let const_map = nil;

    if type(ivp) == "map" {
        let x0 = if map_has(ivp, "x0") { ivp.x0 * 1.0 } else if map_has(ivp, "t0") { ivp.t0 * 1.0 } else { 0.0 };
        let y0 = ivp.y0 * 1.0;
        let dy0 = ivp.dy0 * 1.0;

        let st_d = [];
        let du1 = _simp(_diff_ast(u1, x_var, st_d, 0));
        let du2 = _simp(_diff_ast(u2, x_var, st_d, 0));
        let dyp = _simp(_diff_ast(yp, x_var, st_d, 0));

        let u1_0 = _eval_1d(u1, x_var, x0);
        let u2_0 = _eval_1d(u2, x_var, x0);
        let du1_0 = _eval_1d(du1, x_var, x0);
        let du2_0 = _eval_1d(du2, x_var, x0);
        let yp_0 = _eval_1d(yp, x_var, x0);
        let dyp_0 = _eval_1d(dyp, x_var, x0);

        let wronsk = _linear_solve_det([[u1_0, u2_0], [du1_0, du2_0]], [y0 - yp_0, dy0 - dyp_0]);
        if not wronsk.ok {
            throw "calculus_ode: singular Wronskian at initial point";
        }
        let c1_v = _snap_num(wronsk.x[0]);
        let c2_v = _snap_num(wronsk.x[1]);
        const_map = map{ C1: c1_v, C2: c2_v };
        let t_c1 = _simp(_bin("*", _num_or_simple_rat(c1_v), u1));
        let t_c2 = _simp(_bin("*", _num_or_simple_rat(c2_v), u2));
        sol_ast = _simp(_bin("+", _bin("+", t_c1, t_c2), yp));
    }

    let asc = format_ascii(sol_ast, 0);
    return map{
        order: 2,
        regime: regime,
        variable: x_var,
        expr: asc,
        ascii: asc,
        unicode: format_unicode(sol_ast, 0),
        latex: format_latex(sol_ast, 0),
        homogeneous: format_ascii(yh_gen, 0),
        particular: format_ascii(yp, 0),
        constants: const_map,
        ast: sol_ast,
        evaluate: fn(xv) { return _eval_1d(sol_ast, x_var, xv); }
    };
}

// ============================================================================
// 12. Numerical ODE Solvers: Dormand-Prince RK45, Symplectic Verlet, Stiff BE
// ============================================================================

fn _vec_clone(v) {
    let r = [];
    let i = 0;
    while i < len(v) { array_push(r, v[i] * 1.0); i = i + 1; }
    return r;
}

fn ode_rk45(f, t0, y0_vec, t_end, tol = 1e-8) {
    let is_scalar = type(y0_vec) == "number";
    let y = if is_scalar { [y0_vec * 1.0] } else { _vec_clone(y0_vec) };
    let dim = len(y);

    let call_f = fn(tv, yv) {
        if is_scalar { return [f(tv, yv[0]) * 1.0]; }
        return f(tv, yv);
    };

    let t = t0 * 1.0;
    let tf = t_end * 1.0;
    let dir_s = if tf >= t { 1.0 } else { -1.0 };
    let total_span = num_abs(tf - t);

    let t_hist = [t];
    let y_hist = [if is_scalar { y[0] } else { _vec_clone(y) }];
    if total_span == 0.0 {
        return map{ t: t_hist, y: y_hist, y_final: y_hist[0], steps: 0, rejected_steps: 0, evaluations: 0 };
    }

    let h = dir_s * (total_span / 50.0);
    let k1 = call_f(t, y);
    let nfev = 1;
    let accepted = 0;
    let rejected = 0;
    let total_iters = 0;

    while num_abs(tf - t) > 1e-14 * (1.0 + num_abs(tf)) {
        if total_iters >= MAX_ODE_STEPS {
            throw "calculus_ode: ode_rk45 exceeded MAX_ODE_STEPS (" + str(MAX_ODE_STEPS) + ")";
        }
        total_iters = total_iters + 1;

        if num_abs(h) > num_abs(tf - t) {
            h = tf - t;
        }

        // Dormand-Prince 5(4) stages
        let y2 = [];
        let i = 0;
        while i < dim { array_push(y2, y[i] + h * (0.2 * k1[i])); i = i + 1; }
        let k2 = call_f(t + 0.2 * h, y2);

        let y3 = [];
        i = 0;
        while i < dim { array_push(y3, y[i] + h * ((3.0 / 40.0) * k1[i] + (9.0 / 40.0) * k2[i])); i = i + 1; }
        let k3 = call_f(t + 0.3 * h, y3);

        let y4 = [];
        i = 0;
        while i < dim { array_push(y4, y[i] + h * ((44.0 / 45.0) * k1[i] - (56.0 / 15.0) * k2[i] + (32.0 / 9.0) * k3[i])); i = i + 1; }
        let k4 = call_f(t + 0.8 * h, y4);

        let y5 = [];
        i = 0;
        while i < dim {
            array_push(y5, y[i] + h * ((19372.0 / 6561.0) * k1[i] - (25360.0 / 2187.0) * k2[i] + (64448.0 / 6561.0) * k3[i] - (212.0 / 729.0) * k4[i]));
            i = i + 1;
        }
        let k5 = call_f(t + (8.0 / 9.0) * h, y5);

        let y6 = [];
        i = 0;
        while i < dim {
            array_push(y6, y[i] + h * ((9017.0 / 3168.0) * k1[i] - (355.0 / 33.0) * k2[i] + (46732.0 / 5247.0) * k3[i] + (49.0 / 176.0) * k4[i] - (5103.0 / 18656.0) * k5[i]));
            i = i + 1;
        }
        let k6 = call_f(t + h, y6);

        // 5th-order solution (FSAL stage)
        let y_next = [];
        i = 0;
        while i < dim {
            let yn = y[i] + h * ((35.0 / 384.0) * k1[i] + (500.0 / 1113.0) * k3[i] + (125.0 / 192.0) * k4[i] - (2187.0 / 6784.0) * k5[i] + (11.0 / 84.0) * k6[i]);
            array_push(y_next, yn);
            i = i + 1;
        }
        let k7 = call_f(t + h, y_next);
        nfev = nfev + 6;

        // Error estimate |y5 - y4| normalized by atol + rtol * max(|y|, |y_next|)
        let err_norm = 0.0;
        i = 0;
        while i < dim {
            let e_i = h * ((71.0 / 57600.0) * k1[i] - (71.0 / 16695.0) * k3[i] + (71.0 / 1920.0) * k4[i] - (17253.0 / 339200.0) * k5[i] + (22.0 / 525.0) * k6[i] - (1.0 / 40.0) * k7[i]);
            let sc = tol + tol * (if num_abs(y[i]) > num_abs(y_next[i]) { num_abs(y[i]) } else { num_abs(y_next[i]) });
            let ratio_i = num_abs(e_i) / sc;
            if ratio_i > err_norm { err_norm = ratio_i; }
            i = i + 1;
        }

        if err_norm <= 1.0 {
            t = t + h;
            y = y_next;
            k1 = k7; // FSAL reuse!
            accepted = accepted + 1;
            array_push(t_hist, t);
            array_push(y_hist, if is_scalar { y[0] } else { _vec_clone(y) });
        } else {
            rejected = rejected + 1;
        }

        let fac = if err_norm == 0.0 { 5.0 } else { 0.9 * num_pow(err_norm, -0.2) };
        if fac < 0.2 { fac = 0.2; }
        if fac > 5.0 { fac = 5.0; }
        h = h * fac;
    }

    return map{
        t: t_hist,
        y: y_hist,
        y_final: y_hist[len(y_hist) - 1],
        steps: accepted,
        rejected_steps: rejected,
        evaluations: nfev
    };
}

// Symplectic Velocity Stormer-Verlet for q'' = accel_fn(q)
fn ode_verlet(accel_fn, q0_vec, v0_vec, dt, steps) {
    if steps < 0 or steps > MAX_ODE_STEPS {
        throw "calculus_ode: ode_verlet steps must be in 0.." + str(MAX_ODE_STEPS);
    }
    let is_scalar = type(q0_vec) == "number";
    let q = if is_scalar { [q0_vec * 1.0] } else { _vec_clone(q0_vec) };
    let v = if is_scalar { [v0_vec * 1.0] } else { _vec_clone(v0_vec) };
    let dim = len(q);

    let call_a = fn(qv) {
        if is_scalar { return [accel_fn(qv[0]) * 1.0]; }
        return accel_fn(qv);
    };

    let t_hist = [0.0];
    let q_hist = [if is_scalar { q[0] } else { _vec_clone(q) }];
    let v_hist = [if is_scalar { v[0] } else { _vec_clone(v) }];

    let a_cur = call_a(q);
    let s = 0;
    let h = dt * 1.0;
    while s < steps {
        let v_half = [];
        let q_next = [];
        let i = 0;
        while i < dim {
            let vh = v[i] + 0.5 * h * a_cur[i];
            array_push(v_half, vh);
            array_push(q_next, q[i] + h * vh);
            i = i + 1;
        }
        let a_next = call_a(q_next);
        let v_next = [];
        i = 0;
        while i < dim {
            array_push(v_next, v_half[i] + 0.5 * h * a_next[i]);
            i = i + 1;
        }
        q = q_next;
        v = v_next;
        a_cur = a_next;
        s = s + 1;
        array_push(t_hist, s * h);
        array_push(q_hist, if is_scalar { q[0] } else { _vec_clone(q) });
        array_push(v_hist, if is_scalar { v[0] } else { _vec_clone(v) });
    }

    return map{
        t: t_hist,
        q: q_hist,
        v: v_hist,
        q_final: q_hist[len(q_hist) - 1],
        v_final: v_hist[len(v_hist) - 1],
        steps: steps
    };
}

// Implicit L-Stable Backward-Euler for stiff ODEs: y_{n+1} - y_n - h * f(t_{n+1}, y_{n+1}) = 0
fn ode_stiff_be(f, t0, y0_vec, t_end, steps = 200, newton_tol = 1e-10) {
    if steps <= 0 or steps > MAX_ODE_STEPS {
        throw "calculus_ode: ode_stiff_be steps must be in 1.." + str(MAX_ODE_STEPS);
    }
    let is_scalar = type(y0_vec) == "number";
    let y = if is_scalar { [y0_vec * 1.0] } else { _vec_clone(y0_vec) };
    let dim = len(y);

    let call_f = fn(tv, yv) {
        if is_scalar { return [f(tv, yv[0]) * 1.0]; }
        return f(tv, yv);
    };

    let h = ((t_end * 1.0) - (t0 * 1.0)) / (steps * 1.0);
    let t = t0 * 1.0;
    let t_hist = [t];
    let y_hist = [if is_scalar { y[0] } else { _vec_clone(y) }];
    let total_newton = 0;

    let step_i = 0;
    while step_i < steps {
        let t_next = t + h;
        let z = _vec_clone(y);
        let n_it = 0;
        while n_it < 30 {
            total_newton = total_newton + 1;
            let fz = call_f(t_next, z);
            // Residual G(z) = z - y - h * f(t_next, z)
            let neg_G = [];
            let g_norm = 0.0;
            let y_norm = 0.0;
            let i = 0;
            while i < dim {
                let gi = z[i] - y[i] - h * fz[i];
                array_push(neg_G, 0.0 - gi);
                g_norm = g_norm + gi * gi;
                y_norm = y_norm + y[i] * y[i];
                i = i + 1;
            }
            if n_it > 0 and num_sqrt(g_norm) <= newton_tol * (1e-30 + num_sqrt(y_norm)) { break; }

            // Finite-difference Jacobian J_G = I - h * df/dz
            let j_mat = [];
            let r = 0;
            while r < dim {
                let row = [];
                let c = 0;
                while c < dim { array_push(row, if r == c { 1.0 } else { 0.0 }); c = c + 1; }
                array_push(j_mat, row);
                r = r + 1;
            }
            let col = 0;
            while col < dim {
                let eps = 1e-8 * (1.0 + num_abs(z[col]));
                let z_pert = _vec_clone(z);
                z_pert[col] = z_pert[col] + eps;
                let f_pert = call_f(t_next, z_pert);
                let row_i = 0;
                while row_i < dim {
                    let df_ij = (f_pert[row_i] - fz[row_i]) / eps;
                    j_mat[row_i][col] = j_mat[row_i][col] - h * df_ij;
                    row_i = row_i + 1;
                }
                col = col + 1;
            }

            let sol = _linear_solve_det(j_mat, neg_G);
            if not sol.ok { break; }
            let d_norm = 0.0;
            let k = 0;
            while k < dim {
                z[k] = z[k] + sol.x[k];
                d_norm = d_norm + sol.x[k] * sol.x[k];
                k = k + 1;
            }
            if num_sqrt(d_norm) <= newton_tol { break; }
            n_it = n_it + 1;
        }
        y = z;
        t = t_next;
        array_push(t_hist, t);
        array_push(y_hist, if is_scalar { y[0] } else { _vec_clone(y) });
        step_i = step_i + 1;
    }

    return map{
        t: t_hist,
        y: y_hist,
        y_final: y_hist[len(y_hist) - 1],
        steps: steps,
        newton_iterations: total_newton
    };
}

// ============================================================================
// 13. 1D / 2D PDE Solvers: Crank-Nicolson Heat, 1D Wave, 2D SOR Poisson
// ============================================================================

// O(N) Thomas algorithm for tridiagonal system: sub[i]*x[i-1] + diag[i]*x[i] + sup[i]*x[i+1] = rhs[i]
fn _thomas_solve(sub, diag, sup, rhs) {
    let n = len(diag);
    let c_p = [];
    let d_p = [];
    let i = 0;
    while i < n {
        array_push(c_p, 0.0);
        array_push(d_p, 0.0);
        i = i + 1;
    }
    c_p[0] = sup[0] / diag[0];
    d_p[0] = rhs[0] / diag[0];
    i = 1;
    while i < n {
        let denom = diag[i] - sub[i] * c_p[i - 1];
        c_p[i] = if i < n - 1 { sup[i] / denom } else { 0.0 };
        d_p[i] = (rhs[i] - sub[i] * d_p[i - 1]) / denom;
        i = i + 1;
    }
    let x = [];
    i = 0;
    while i < n { array_push(x, 0.0); i = i + 1; }
    x[n - 1] = d_p[n - 1];
    let k = n - 2;
    while k >= 0 {
        x[k] = d_p[k] - c_p[k] * x[k + 1];
        k = k - 1;
    }
    return x;
}

fn pde_heat_1d_crank_nicolson(u0, alpha, dx, dt, steps) {
    let n = len(u0);
    if n < 3 or n > MAX_PDE_GRID {
        throw "calculus_ode: pde_heat_1d_crank_nicolson grid length must be in 3.." + str(MAX_PDE_GRID);
    }
    if steps < 0 or steps > MAX_ODE_STEPS {
        throw "calculus_ode: steps must be in 0.." + str(MAX_ODE_STEPS);
    }
    let u = _vec_clone(u0);
    let r = (alpha * dt) / (2.0 * dx * dx);
    let m = n - 2; // interior points

    let sub = [];
    let diag = [];
    let sup = [];
    let i = 0;
    while i < m {
        array_push(sub, 0.0 - r);
        array_push(diag, 1.0 + 2.0 * r);
        array_push(sup, 0.0 - r);
        i = i + 1;
    }

    let s = 0;
    while s < steps {
        let rhs = [];
        let j = 1;
        while j <= m {
            let val = r * u[j - 1] + (1.0 - 2.0 * r) * u[j] + r * u[j + 1];
            if j == 1 { val = val + r * u[0]; }
            if j == m { val = val + r * u[n - 1]; }
            array_push(rhs, val);
            j = j + 1;
        }
        let interior = _thomas_solve(sub, diag, sup, rhs);
        let j2 = 0;
        while j2 < m {
            u[j2 + 1] = interior[j2];
            j2 = j2 + 1;
        }
        s = s + 1;
    }

    return map{
        u: u,
        u_initial: _vec_clone(u0),
        fourier_number: 2.0 * r,
        steps: steps
    };
}

fn pde_wave_1d(u0, v0, c, dx, dt, steps) {
    let n = len(u0);
    if n < 3 or n > MAX_PDE_GRID or len(v0) != n {
        throw "calculus_ode: pde_wave_1d invalid grid size (must be 3.." + str(MAX_PDE_GRID) + " and len(u0)==len(v0))";
    }
    if steps < 0 or steps > MAX_ODE_STEPS {
        throw "calculus_ode: steps must be in 0.." + str(MAX_ODE_STEPS);
    }
    let courant = (c * dt) / dx;
    let c2 = courant * courant;
    if steps == 0 {
        return map{ u: _vec_clone(u0), u_prev: _vec_clone(u0), courant: courant, stable: courant <= 1.0, steps: 0 };
    }

    let u_prev = _vec_clone(u0);
    let u_curr = _vec_clone(u0);
    // 2nd-order startup step n = 1
    let i = 1;
    while i < n - 1 {
        u_curr[i] = u_prev[i] + dt * v0[i] + 0.5 * c2 * (u_prev[i + 1] - 2.0 * u_prev[i] + u_prev[i - 1]);
        i = i + 1;
    }

    let s = 1;
    while s < steps {
        let u_next = _vec_clone(u_curr);
        let j = 1;
        while j < n - 1 {
            u_next[j] = 2.0 * u_curr[j] - u_prev[j] + c2 * (u_curr[j + 1] - 2.0 * u_curr[j] + u_curr[j - 1]);
            j = j + 1;
        }
        u_prev = u_curr;
        u_curr = u_next;
        s = s + 1;
    }

    return map{
        u: u_curr,
        u_prev: u_prev,
        courant: courant,
        stable: courant <= 1.0 + 1e-12,
        steps: steps
    };
}

// 2D Poisson solver u_xx + u_yy = rhs_grid with zero Dirichlet boundaries using SOR Gauss-Seidel
fn pde_poisson_2d(nx, ny, dx, dy, rhs_grid, tol = 1e-7) {
    if nx < 3 or ny < 3 or nx > MAX_PDE_GRID or ny > MAX_PDE_GRID {
        throw "calculus_ode: pde_poisson_2d grid dimensions must be in 3.." + str(MAX_PDE_GRID);
    }
    let u = [];
    let i = 0;
    while i < nx {
        let row = [];
        let j = 0;
        while j < ny { array_push(row, 0.0); j = j + 1; }
        array_push(u, row);
        i = i + 1;
    }

    let dx2 = dx * dx;
    let dy2 = dy * dy;
    let denom = 2.0 * (dx2 + dy2);
    let n_max = if nx > ny { nx } else { ny };
    let omega = 2.0 / (1.0 + num_sin(PI / (n_max - 1.0)));
    if omega < 1.0 or omega >= 2.0 { omega = 1.7; }

    let max_iters = 20000;
    let iter = 0;
    let max_diff = 0.0;
    let converged = false;

    while iter < max_iters {
        max_diff = 0.0;
        let ix = 1;
        while ix < nx - 1 {
            let iy = 1;
            while iy < ny - 1 {
                let u_gs = (dy2 * (u[ix + 1][iy] + u[ix - 1][iy]) + dx2 * (u[ix][iy + 1] + u[ix][iy - 1]) - dx2 * dy2 * rhs_grid[ix][iy]) / denom;
                let u_new = (1.0 - omega) * u[ix][iy] + omega * u_gs;
                let diff_u = num_abs(u_new - u[ix][iy]);
                if diff_u > max_diff { max_diff = diff_u; }
                u[ix][iy] = u_new;
                iy = iy + 1;
            }
            ix = ix + 1;
        }
        iter = iter + 1;
        if max_diff <= tol {
            converged = true;
            break;
        }
    }

    return map{
        u: u,
        iterations: iter,
        residual: max_diff,
        omega: omega,
        converged: converged
    };
}

// ============================================================================
// 14. Symbolic Laplace / Inverse Laplace Transforms & Spectral FFT / DCT-II
// ============================================================================

fn _laplace_term(node, t_var, s_var) {
    let n = _simp(node);
    let s = _sym(s_var);

    // 1. Constant c -> c / s
    if not _depends_on(n, t_var, 0) {
        return _simp(_bin("/", n, s));
    }

    // Extract scalar multiplier c * core
    let sp = _split_coeff_and_core(n);
    let c_ast = _build_scaled_term(sp.is_rat, sp.p, sp.q, sp.f, _num(1));
    let core = sp.core;

    // Pure polynomial term t^k -> k! / s^(k+1)
    let poly = _extract_poly(n, t_var, 12);
    if poly.ok {
        let acc = _num(0);
        let k = 0;
        while k < len(poly.coeffs) {
            let ck = poly.coeffs[k];
            if not _near_zero(ck) {
                let term_k = _simp(_bin("/", _num_or_simple_rat(ck * _factorial(k)), _bin("^", s, _num(k + 1))));
                acc = _simp(_bin("+", acc, term_k));
            }
            k = k + 1;
        }
        return acc;
    }

    // Elementary single call: exp(a*t), sin(w*t), cos(w*t), sinh(w*t), cosh(w*t)
    if core.kind == "call" and len(core.args) == 1 {
        let lin = _match_linear(core.args[0], t_var);
        if lin.ok and _near_zero(lin.b) {
            let param = lin.a;
            let p_ast = _num_or_simple_rat(param);
            let p2_ast = _num_or_simple_rat(param * param);
            if core.name == "exp" {
                return _simp(_bin("/", c_ast, _bin("-", s, p_ast)));
            }
            if core.name == "sin" {
                return _simp(_bin("*", c_ast, _bin("/", p_ast, _bin("+", _bin("^", s, _num(2)), p2_ast))));
            }
            if core.name == "cos" {
                return _simp(_bin("*", c_ast, _bin("/", s, _bin("+", _bin("^", s, _num(2)), p2_ast))));
            }
            if core.name == "sinh" {
                return _simp(_bin("*", c_ast, _bin("/", p_ast, _bin("-", _bin("^", s, _num(2)), p2_ast))));
            }
            if core.name == "cosh" {
                return _simp(_bin("*", c_ast, _bin("/", s, _bin("-", _bin("^", s, _num(2)), p2_ast))));
            }
        }
    }

    // Products: t^n * exp(a*t), exp(a*t) * sin(w*t), exp(a*t) * cos(w*t), t * sin(w*t), t * cos(w*t)
    if core.kind == "bin" and core.op == "*" {
        let st_m = map{ zero: false, sign: 1, is_rat: true, num_int: 1, den_int: 1, float_val: 1.0, factors: [] };
        let _ = _collect_mul_factors(core, false, st_m, 0);
        if len(st_m.factors) == 2 {
            let f0 = _simp(_bin("^", st_m.factors[0].base, st_m.factors[0].exp));
            let f1 = _simp(_bin("^", st_m.factors[1].base, st_m.factors[1].exp));

            // Match exp(a*t) * other -> frequency shift s -> (s - a) on L{other}(s)
            let exp_part = nil;
            let other_part = nil;
            if f0.kind == "call" and f0.name == "exp" { exp_part = f0; other_part = f1; }
            else if f1.kind == "call" and f1.name == "exp" { exp_part = f1; other_part = f0; }

            if exp_part != nil {
                let lin_e = _match_linear(exp_part.args[0], t_var);
                if lin_e.ok and _near_zero(lin_e.b) {
                    let a_shift = _num_or_simple_rat(lin_e.a);
                    let base_L = _laplace_term(other_part, t_var, s_var);
                    let shifted = _simp(_subst_ast(base_L, s_var, _bin("-", s, a_shift), 0));
                    return _simp(_bin("*", c_ast, shifted));
                }
            }

            // Match t * sin(w*t) or t * cos(w*t) -> -d/ds L{sin/cos}
            let t_pow = nil;
            let trig_p = nil;
            if _is_sym(f0) and f0.name == t_var { t_pow = 1; trig_p = f1; }
            else if _is_sym(f1) and f1.name == t_var { t_pow = 1; trig_p = f0; }
            else if f0.kind == "bin" and f0.op == "^" and _is_sym(f0.left) and f0.left.name == t_var and _is_num(f0.right) and _is_int_val(f0.right.val) {
                t_pow = num_round(f0.right.val); trig_p = f1;
            } else if f1.kind == "bin" and f1.op == "^" and _is_sym(f1.left) and f1.left.name == t_var and _is_num(f1.right) and _is_int_val(f1.right.val) {
                t_pow = num_round(f1.right.val); trig_p = f0;
            }
            if t_pow != nil and t_pow >= 1 and t_pow <= 6 {
                // Frequency differentiation property: L{t^k g(t)} = (-1)^k d^k/ds^k G(s)
                let cur_G = _laplace_term(trig_p, t_var, s_var);
                let st_d = [];
                let d_idx = 0;
                while d_idx < t_pow {
                    cur_G = _simp(_neg(_diff_ast(cur_G, s_var, st_d, 0)));
                    d_idx = d_idx + 1;
                }
                return _simp(_bin("*", c_ast, cur_G));
            }
        }
    }

    throw "calculus_ode: unsupported Laplace transform term '" + format_ascii(n, 0) + "'";
}

fn laplace(expr, t_var = "t", s_var = "s") {
    let ast = _simp(parse_expr(expr));
    let terms = [];
    let _ = _collect_sum_terms(ast, 1, terms, 0);
    let acc = _num(0);
    let i = 0;
    while i < len(terms) {
        let lt = _laplace_term(terms[i], t_var, s_var);
        acc = _simp(_bin("+", acc, lt));
        i = i + 1;
    }
    let asc = format_ascii(acc, 0);
    return map{
        expr: asc,
        ascii: asc,
        unicode: format_unicode(acc, 0),
        latex: format_latex(acc, 0),
        ast: acc,
        evaluate: fn(sv) { return _eval_1d(acc, s_var, sv); }
    };
}

fn _inv_laplace_term(node, s_var, t_var) {
    let n = _simp(node);
    let t = _sym(t_var);

    if _is_num_eq(n, 0) { return _num(0); }

    let sign = 1.0;
    if n.kind == "neg" {
        sign = -1.0;
        n = n.arg;
    }

    // Must be rational in s_var: numer / denom
    let numer = _num(1);
    let denom = _num(1);
    if n.kind == "bin" and n.op == "/" {
        numer = n.left;
        denom = n.right;
    } else {
        throw "calculus_ode: inverse Laplace requires strictly proper rational term in " + s_var;
    }

    // Case 1: c / (s - a)^k (including c / s^k when a = 0)
    if not _depends_on(numer, s_var, 0) {
        let c_val = sign * _eval_ast(numer, map{}, 0);
        if _is_sym(denom) and denom.name == s_var {
            return _num_or_simple_rat(c_val);
        }
        let lin_d = _match_linear(denom, s_var);
        if lin_d.ok and not _near_zero(lin_d.a) {
            let pole = (0.0 - lin_d.b) / lin_d.a;
            let scale = c_val / lin_d.a;
            let exp_p = if _near_zero(pole) { _num(1) } else { _call("exp", [_simp(_bin("*", _num_or_simple_rat(pole), t))]) };
            return _simp(_bin("*", _num_or_simple_rat(scale), exp_p));
        }
        if denom.kind == "bin" and denom.op == "^" and _is_num(denom.right) and _is_int_val(denom.right.val) {
            let k_pow = num_round(denom.right.val);
            let lin_base = _match_linear(denom.left, s_var);
            if k_pow >= 1 and lin_base.ok and not _near_zero(lin_base.a) {
                let pole = (0.0 - lin_base.b) / lin_base.a;
                let scale = c_val / (_safe_pow(lin_base.a, k_pow) * _factorial(k_pow - 1));
                let t_part = if k_pow == 1 { _num(1) } else if k_pow == 2 { t } else { _bin("^", t, _num(k_pow - 1)) };
                let exp_p = if _near_zero(pole) { _num(1) } else { _call("exp", [_simp(_bin("*", _num_or_simple_rat(pole), t))]) };
                return _simp(_bin("*", _num_or_simple_rat(scale), _bin("*", t_part, exp_p)));
            }
        }
    }

    // Case 2: (A*s + B) / (a2*s^2 + b1*s + c0) — handles sin, cos, damped sin/cos, distinct & repeated real poles!
    let pn = _extract_poly(numer, s_var, 1);
    let pd = _extract_poly(denom, s_var, 2);
    if pn.ok and pd.ok and pd.deg == 2 {
        let a2 = pd.coeffs[2];
        let p = pd.coeffs[1] / a2;
        let q = pd.coeffs[0] / a2;
        let B = sign * pn.coeffs[0] / a2;
        let A = if pn.deg >= 1 { sign * pn.coeffs[1] / a2 } else { 0.0 };

        // Complete the square: s^2 + p*s + q = (s - alpha)^2 + d
        let alpha = -0.5 * p;
        let d = q - 0.25 * p * p;
        let env_exp = if _near_zero(alpha) { _num(1) } else { _call("exp", [_simp(_bin("*", _num_or_simple_rat(alpha), t))]) };
        let rem_num = B + A * alpha;

        if d > 1e-11 {
            let w = num_sqrt(d);
            let wt = _simp(_bin("*", _num_or_simple_rat(w), t));
            let cos_part = if _near_zero(A) { _num(0) } else { _bin("*", _num_or_simple_rat(A), _call("cos", [wt])) };
            let sin_coeff = rem_num / w;
            let sin_part = if _near_zero(sin_coeff) { _num(0) } else { _bin("*", _num_or_simple_rat(sin_coeff), _call("sin", [wt])) };
            return _simp(_bin("*", env_exp, _bin("+", cos_part, sin_part)));
        }
        if num_abs(d) <= 1e-11 {
            let c_part = if _near_zero(A) { _num(0) } else { _num_or_simple_rat(A) };
            let t_part = if _near_zero(rem_num) { _num(0) } else { _bin("*", _num_or_simple_rat(rem_num), t) };
            return _simp(_bin("*", env_exp, _bin("+", c_part, t_part)));
        }
        // d < 0: two distinct real poles r1 = alpha + u, r2 = alpha - u
        let u = num_sqrt(0.0 - d);
        let r1 = alpha + u;
        let r2 = alpha - u;
        let C1 = (A * r1 + B) / (r1 - r2);
        let C2 = (A * r2 + B) / (r2 - r1);
        let e1 = if _near_zero(r1) { _num(1) } else { _call("exp", [_simp(_bin("*", _num_or_simple_rat(r1), t))]) };
        let e2 = if _near_zero(r2) { _num(1) } else { _call("exp", [_simp(_bin("*", _num_or_simple_rat(r2), t))]) };
        let term1 = if _near_zero(C1) { _num(0) } else { _bin("*", _num_or_simple_rat(C1), e1) };
        let term2 = if _near_zero(C2) { _num(0) } else { _bin("*", _num_or_simple_rat(C2), e2) };
        return _simp(_bin("+", term1, term2));
    }

    throw "calculus_ode: unsupported inverse Laplace term '" + format_ascii(node, 0) + "'";
}

fn inv_laplace(expr, s_var = "s", t_var = "t") {
    let ast = _simp(parse_expr(expr));
    let terms = [];
    let _ = _collect_sum_terms(ast, 1, terms, 0);
    let acc = _num(0);
    let i = 0;
    while i < len(terms) {
        let it = _inv_laplace_term(terms[i], s_var, t_var);
        acc = _simp(_bin("+", acc, it));
        i = i + 1;
    }
    let asc = format_ascii(acc, 0);
    return map{
        expr: asc,
        ascii: asc,
        unicode: format_unicode(acc, 0),
        latex: format_latex(acc, 0),
        ast: acc,
        evaluate: fn(tv) { return _eval_1d(acc, t_var, tv); }
    };
}

// Complex signal normalization -> array of map{ re, im }
fn _to_complex_array(sig) {
    let out = [];
    let i = 0;
    while i < len(sig) {
        let el = sig[i];
        if type(el) == "number" {
            array_push(out, map{ re: el * 1.0, im: 0.0 });
        } else if type(el) == "array" {
            array_push(out, map{ re: el[0] * 1.0, im: el[1] * 1.0 });
        } else if type(el) == "map" {
            array_push(out, map{ re: el.re * 1.0, im: el.im * 1.0 });
        } else {
            throw "calculus_ode: invalid complex element in signal";
        }
        i = i + 1;
    }
    return out;
}

fn _is_power_of_two(n) {
    if n <= 0 { return false; }
    let m = n;
    while m > 1 {
        if num_mod(m, 2) != 0 { return false; }
        m = num_round(m / 2);
    }
    return true;
}

// Iterative Cooley-Tukey Radix-2 FFT (with exact DFT fallback if N is not a power of 2)
fn fft(signal) {
    let buf = _to_complex_array(signal);
    let n = len(buf);
    if n == 0 { return []; }
    if n > 65536 {
        throw "calculus_ode: fft length exceeds safety bound 65536";
    }
    if not _is_power_of_two(n) {
        // Exact O(N^2) DFT fallback for non-power-of-2 length
        let dft_out = [];
        let k = 0;
        while k < n {
            let sre = 0.0;
            let sim = 0.0;
            let j = 0;
            while j < n {
                let ang = (-2.0 * PI * k * j) / (n * 1.0);
                let cs = num_cos(ang);
                let sn = num_sin(ang);
                sre = sre + buf[j].re * cs - buf[j].im * sn;
                sim = sim + buf[j].re * sn + buf[j].im * cs;
                j = j + 1;
            }
            array_push(dft_out, map{ re: sre, im: sim });
            k = k + 1;
        }
        return dft_out;
    }

    // Bit-reversal permutation in-place
    let j = 0;
    let i = 1;
    while i < n {
        let bit = num_round(n / 2);
        while j >= bit {
            j = j - bit;
            bit = num_round(bit / 2);
        }
        j = j + bit;
        if i < j {
            let tmp = buf[i];
            buf[i] = buf[j];
            buf[j] = tmp;
        }
        i = i + 1;
    }

    // Butterfly stages len_s = 2, 4, 8, ..., n
    let len_s = 2;
    while len_s <= n {
        let half = num_round(len_s / 2);
        let ang = (-2.0 * PI) / (len_s * 1.0);
        let wlen_re = num_cos(ang);
        let wlen_im = num_sin(ang);
        let start = 0;
        while start < n {
            let w_re = 1.0;
            let w_im = 0.0;
            let k = 0;
            while k < half {
                let u = buf[start + k];
                let v = buf[start + k + half];
                let t_re = v.re * w_re - v.im * w_im;
                let t_im = v.re * w_im + v.im * w_re;
                buf[start + k] = map{ re: u.re + t_re, im: u.im + t_im };
                buf[start + k + half] = map{ re: u.re - t_re, im: u.im - t_im };
                let nw_re = w_re * wlen_re - w_im * wlen_im;
                let nw_im = w_re * wlen_im + w_im * wlen_re;
                w_re = nw_re;
                w_im = nw_im;
                k = k + 1;
            }
            start = start + len_s;
        }
        len_s = len_s * 2;
    }
    return buf;
}

fn ifft(spectrum) {
    let conj_in = _to_complex_array(spectrum);
    let n = len(conj_in);
    if n == 0 { return []; }
    let i = 0;
    while i < n {
        conj_in[i].im = 0.0 - conj_in[i].im;
        i = i + 1;
    }
    let fwd = fft(conj_in);
    let out = [];
    let inv_n = 1.0 / (n * 1.0);
    i = 0;
    while i < n {
        array_push(out, map{
            re: fwd[i].re * inv_n,
            im: (0.0 - fwd[i].im) * inv_n
        });
        i = i + 1;
    }
    return out;
}

fn power_spectrum(signal) {
    let spec = fft(signal);
    let n = len(spec);
    let mags = [];
    let pwr = [];
    let norm_pwr = [];
    let inv_n = if n > 0 { 1.0 / (n * 1.0) } else { 0.0 };
    let i = 0;
    while i < n {
        let p = spec[i].re * spec[i].re + spec[i].im * spec[i].im;
        array_push(mags, num_sqrt(p));
        array_push(pwr, p);
        array_push(norm_pwr, p * inv_n);
        i = i + 1;
    }
    return map{
        bins: n,
        spectrum: spec,
        magnitudes: mags,
        power: pwr,
        normalized_power: norm_pwr
    };
}

// Type-II Discrete Cosine Transform (via 2N-symmetric FFT when power-of-2, or exact formula)
fn dct_ii(signal, ortho = false) {
    let n = len(signal);
    if n == 0 { return []; }
    if n > MAX_PDE_GRID * 16 {
        throw "calculus_ode: dct_ii length exceeds bound";
    }
    let out = [];
    if _is_power_of_two(n) and n <= 16384 {
        // O(N log N) Makhoul N-point even-odd reordering + FFT!
        let reord = [];
        let half = num_round(n / 2);
        let i = 0;
        while i < half {
            array_push(reord, signal[2 * i] * 1.0);
            i = i + 1;
        }
        i = 0;
        while i < half {
            array_push(reord, signal[n - 1 - 2 * i] * 1.0);
            i = i + 1;
        }
        let Y = fft(reord);
        let k = 0;
        while k < n {
            let ang = (0.0 - PI * k) / (2.0 * n);
            // Multiply by 2 * Re(Y[k] * exp(-i*pi*k/(2N))) * 0.5 -> standard unnormalized DCT-II X[k] = sum x[n] cos(pi/N*(n+0.5)*k)
            let val = Y[k].re * num_cos(ang) - Y[k].im * num_sin(ang);
            if ortho {
                let sc = if k == 0 { num_sqrt(1.0 / (n * 1.0)) } else { num_sqrt(2.0 / (n * 1.0)) };
                val = val * sc;
            }
            array_push(out, val);
            k = k + 1;
        }
        return out;
    }

    let k = 0;
    while k < n {
        let s = 0.0;
        let idx = 0;
        while idx < n {
            s = s + signal[idx] * num_cos((PI / (n * 1.0)) * (idx + 0.5) * k);
            idx = idx + 1;
        }
        if ortho {
            let sc = if k == 0 { num_sqrt(1.0 / (n * 1.0)) } else { num_sqrt(2.0 / (n * 1.0)) };
            s = s * sc;
        }
        array_push(out, s);
        k = k + 1;
    }
    return out;
}

export MAX_DEPTH, MAX_QUAD_DEPTH, MAX_ODE_STEPS, MAX_PDE_GRID, PI, E_CONST, EULER_GAMMA,
       parse_expr, evaluate_expr, simplify, format_ascii, format_unicode, format_latex,
       diff, implicit_diff, parametric_diff,
       gradient, jacobian, hessian, divergence, curl_3d, laplacian,
       directional_derivative, find_and_classify_extrema,
       integrate_symbolic, risch_integrate, integrate_definite, integrate_improper_or_singular, integrate_2d,
       limit, taylor, pade, sum_series,
       solve_ode_symbolic, ode_rk45, ode_verlet, ode_stiff_be,
       pde_heat_1d_crank_nicolson, pde_wave_1d, pde_poisson_2d,
       laplace, inv_laplace, fft, ifft, power_spectrum, dct_ii;
