        "0,0,1,0,0,0,0,0,0": "s",
        "0,0,-1,0,0,0,0,0,0": "Hz",
        "1,0,-1,0,0,0,0,0,0": "m/s",
        "1,0,-2,0,0,0,0,0,0": "m/s^2",
        "1,1,-2,0,0,0,0,0,0": "N",
        "-1,1,-2,0,0,0,0,0,0": "Pa",
        "2,1,-2,0,0,0,0,0,0": "J",
        "2,1,-3,0,0,0,0,0,0": "W",
        "-3,1,0,0,0,0,0,0,0": "kg/m^3",
        "-1,1,-1,0,0,0,0,0,0": "Pa*s",
        "2,0,-1,0,0,0,0,0,0": "m^2/s",
        "0,1,-3,0,0,0,0,0,0": "W/m^2",
        "2,0,-2,0,-1,0,0,0,0": "J/(kg*K)",
        "0,0,0,1,0,0,0,0,0": "A",
        "0,0,1,1,0,0,0,0,0": "C",
        "2,1,-3,-1,0,0,0,0,0": "V",
        "2,1,-3,-2,0,0,0,0,0": "Ohm",
        "-2,-1,3,2,0,0,0,0,0": "S",
        "-2,-1,4,2,0,0,0,0,0": "F",
        "2,1,-2,-2,0,0,0,0,0": "H",
        "2,1,-2,-1,0,0,0,0,0": "Wb",
        "0,1,-2,-1,0,0,0,0,0": "T_mag",
        "0,0,0,0,1,0,0,0,0": "K",
        "0,0,0,0,0,1,0,0,0": "mol",
        "0,0,0,0,0,0,1,0,0": "cd",
        "-2,0,0,0,0,0,1,0,0": "lx",
        "0,0,0,0,0,0,0,1,0": "EUR",
        "0,0,0,0,0,0,0,0,1": "bit"
    };
}

fn dim_canonical_si_unit(dim) {
    _init_quantity_catalog();
    let k = _dim_key(dim);
    if map_has(_CANONICAL_SI_UNITS, k) {
        return _CANONICAL_SI_UNITS[k];
    }
    if dim_is_dimensionless(dim) { return "1"; }
    let num_parts = [];
    let den_parts = [];
    let idx_k = 0;
    while idx_k < 9 {
        let idx = _DIM_DISPLAY_ORDER[idx_k];
        let r = dim[idx];
        let u = _DIM_BASE_SI_UNITS[idx];
        if r[0] > 0 {
            if r[0] == 1 and r[1] == 1 { push(num_parts, u); }
            else { push(num_parts, u + "^" + rat_to_ascii(r)); }
        } else if r[0] < 0 {
            let pr = [0 - r[0], r[1]];
            if pr[0] == 1 and pr[1] == 1 { push(den_parts, u); }
            else { push(den_parts, u + "^" + rat_to_ascii(pr)); }
        }
        idx_k = idx_k + 1;
    }
    let ns = if len(num_parts) == 0 { "1" } else { str_join(num_parts, "*") };
    if len(den_parts) == 0 { return ns; }
    if len(den_parts) == 1 { return ns + "/" + den_parts[0]; }
    return ns + "/(" + str_join(den_parts, "*") + ")";
}

fn dim_named_quantity(dim) {
    _init_quantity_catalog();
    let k = _dim_key(dim);
    if map_has(_NAMED_QUANTITIES, k) {
        return _NAMED_QUANTITIES[k];
    }
    return "Σύνθετο Μέγεθος / Compound Quantity (" + dim_canonical_si_unit(dim) + ")";
}

// ── Rich 110+ Unit Catalog + Metric Prefix & Compound Unit Parser ─────────────

let _UNIT_CATALOG = nil;
let _PREFIXABLE_BASES = nil;
let _SI_PREFIXES = nil;

fn _u_entry(scale, l_e, m_e, t_e, i_e = 0, th_e = 0, n_e = 0, j_e = 0, eur_e = 0, bit_e = 0, affine = "") {
    return map{
        "scale": scale * 1.0,
        "dim": dim_from_ints(l_e, m_e, t_e, i_e, th_e, n_e, j_e, eur_e, bit_e),
        "affine": affine
    };
}

