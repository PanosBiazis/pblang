// stdlib/math/omni_dimensional_grapher.sapp
// Omni-Dimensional (0D / 1D / 2D / 3D / 4D / N-D / Hyperbolic / Spherical / Network)
// Scene Grapher, Spatial Rotor Manipulator, Marching-Squares Implicit Extractor,
// Pure-PBLang PCA Subspace Projector, Obsidian SVG Vector Renderer & 24-bit BMP Rasterizer (PBLang v2.7.0).
//
// 100% Pure PBLang — Zero external CDNs, zero external binaries, strict XSS-safe SVG output.

let BF = try import("stdlib/bitmap_font.sapp") catch (try import("bitmap_font.sapp") catch import("stdlib:bitmap_font.sapp"));
let UIK = try import("stdlib/ui_kit.sapp") catch (try import("ui_kit.sapp") catch import("stdlib:ui_kit.sapp"));

let ODG_VERSION = "2.7.0";
let PI = 3.14159265358979323846;
let TAU = 6.28318530717958647692;
let E_VAL = 2.71828182845904523536;
let PHI_VAL = 1.61803398874989484820;
let SQRT2 = 1.41421356237309504880;
let INV_SQRT2 = 0.70710678118654752440;
let NAN_VAL = num_sqrt(-1.0);

// ============================================================================
// 1. Numeric, String, Sanitization & Color Palette Helpers
// ============================================================================

fn _is_finite(v) {
    if type(v) != "number" { return false; }
    if not (v == v) { return false; }
    return (v - v) == 0;
}

fn _num_or(v, fb) {
    if v == nil { return fb; }
    if type(v) == "number" {
        if _is_finite(v) { return v; }
        return fb;
    }
    let parsed = try parse_number(str_trim(str(v))) catch nil;
    if parsed != nil and _is_finite(parsed) { return parsed; }
    return fb;
}

fn _int_or(v, fb) {
    return num_floor(_num_or(v, fb));
}

fn _bool_or(v, fb) {
    if type(v) == "bool" { return v; }
    return fb;
}

fn _str_or(v, fb) {
    if v == nil { return fb; }
    let s = str(v);
    if s == "" { return fb; }
    return s;
}

fn _min(a, b) { if a < b { return a; } return b; }
fn _max(a, b) { if a > b { return a; } return b; }

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _abs(v) {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

fn _sign(v) {
    if v > 0.0 { return 1.0; }
    if v < 0.0 { return -1.0; }
    return 0.0;
}

fn _fmt_num(v, digits = 2) {
    if not _is_finite(v) { return "NaN"; }
    let av = _abs(v);
    if av < 1e-11 { return "0"; }
    let scale = 1.0;
    let d = 0;
    while d < digits { scale = scale * 10.0; d = d + 1; }
    let r = num_floor(av * scale + 0.5) / scale;
    let sign_prefix = "";
    if v < 0.0 and r > 0.0 { sign_prefix = "-"; }
    let int_part = num_floor(r);
    if digits <= 0 { return sign_prefix + str(int_part); }
    let rem = num_floor((r - int_part) * scale + 0.5);
    if rem >= scale {
        int_part = int_part + 1;
        rem = 0;
    }
    if rem == 0 { return sign_prefix + str(int_part); }
    let frac_s = str(rem);
    while len(frac_s) < digits { frac_s = "0" + frac_s; }
    // Trim trailing zeros after decimal point for clean axis ticks
    while len(frac_s) > 1 and str_ends_with(frac_s, "0") {
        frac_s = str_slice(frac_s, 0, len(frac_s) - 1);
    }
    return sign_prefix + str(int_part) + "." + frac_s;
}

fn _fmt_fixed(v, digits = 2) {
    if not _is_finite(v) { return "0.00"; }
    let av = _abs(v);
    let scale = 1.0;
    let d = 0;
    while d < digits { scale = scale * 10.0; d = d + 1; }
    let r = num_floor(av * scale + 0.5) / scale;
    let sign_prefix = "";
    if v < -1e-11 and r > 0.0 { sign_prefix = "-"; }
    let int_part = num_floor(r);
    if digits <= 0 { return sign_prefix + str(int_part); }
    let rem = num_floor((r - int_part) * scale + 0.5);
    if rem >= scale {
        int_part = int_part + 1;
        rem = 0;
    }
    let frac_s = str(rem);
    while len(frac_s) < digits { frac_s = "0" + frac_s; }
    return sign_prefix + str(int_part) + "." + frac_s;
}

fn svg_escape(raw) {
    if raw == nil { return ""; }
    let s = str(raw);
    s = str_replace_all(s, "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    s = str_replace_all(s, "\"", "&quot;");
    s = str_replace_all(s, "'", "&#39;");
    return s;
}

fn _hex_byte(n) {
    let v = _clamp(num_floor(n + 0.5), 0, 255);
    let hi = num_floor(v / 16);
    let lo = v - hi * 16;
    let hex = "0123456789ABCDEF";
    return str_slice(hex, hi, hi + 1) + str_slice(hex, lo, lo + 1);
}

fn rgba_to_hex(col) {
    if type(col) == "string" { return col; }
    if not is_array(col) or len(col) < 3 { return "#10E59B"; }
    return "#" + _hex_byte(col[0]) + _hex_byte(col[1]) + _hex_byte(col[2]);
}

fn _hex_nibble(ch_code) {
    if ch_code >= 48 and ch_code <= 57 { return ch_code - 48; }
    if ch_code >= 65 and ch_code <= 70 { return ch_code - 55; }
    if ch_code >= 97 and ch_code <= 102 { return ch_code - 87; }
    return 0;
}

fn color_to_rgba(col, default_alpha = 255) {
    if is_array(col) and len(col) >= 3 {
        let a = default_alpha;
        if len(col) >= 4 { a = _clamp(_int_or(col[3], 255), 0, 255); }
        return [
            _clamp(_int_or(col[0], 16), 0, 255),
            _clamp(_int_or(col[1], 229), 0, 255),
            _clamp(_int_or(col[2], 155), 0, 255),
            a
        ];
    }
    if type(col) == "string" {
        let s = str_trim(col);
        if str_starts_with(s, "#") and len(s) >= 7 {
            let r = _hex_nibble(strcharcodeat(s, 1)) * 16 + _hex_nibble(strcharcodeat(s, 2));
            let g = _hex_nibble(strcharcodeat(s, 3)) * 16 + _hex_nibble(strcharcodeat(s, 4));
            let b = _hex_nibble(strcharcodeat(s, 5)) * 16 + _hex_nibble(strcharcodeat(s, 6));
            return [r, g, b, default_alpha];
        }
    }
    return [16, 229, 155, default_alpha];
}

fn _lerp_rgba(c1, c2, t, alpha = 255) {
    let u = _clamp(t, 0.0, 1.0);
    return [
        _clamp(num_floor(c1[0] + (c2[0] - c1[0]) * u + 0.5), 0, 255),
        _clamp(num_floor(c1[1] + (c2[1] - c1[1]) * u + 0.5), 0, 255),
        _clamp(num_floor(c1[2] + (c2[2] - c1[2]) * u + 0.5), 0, 255),
        alpha
    ];
}

// Perceptual 4-stop Cyan -> Emerald -> Amber -> Coral palette for 3D/4D/ND fields
fn palette_perceptual(t, alpha = 255) {
    let u = _clamp(t, 0.0, 1.0);
    let c_cyan = [34, 211, 238, 255];
    let c_em = [16, 229, 155, 255];
    let c_amb = [251, 191, 36, 255];
    let c_cor = [251, 113, 133, 255];
    if u < 0.333333 {
        return _lerp_rgba(c_cyan, c_em, u * 3.0, alpha);
    }
    if u < 0.666667 {
        return _lerp_rgba(c_em, c_amb, (u - 0.333333) * 3.0, alpha);
    }
    return _lerp_rgba(c_amb, c_cor, (u - 0.666667) * 3.0, alpha);
}

// HSL to RGBA for Complex Domain Phase Coloring
fn hsl_to_rgba(h_deg, sat, light, alpha = 255) {
    let h = h_deg - num_floor(h_deg / 360.0) * 360.0;
    if h < 0.0 { h = h + 360.0; }
    let s = _clamp(sat, 0.0, 1.0);
    let l = _clamp(light, 0.0, 1.0);
    let c = (1.0 - _abs(2.0 * l - 1.0)) * s;
    let hp = h / 60.0;
    let h_mod2 = hp - num_floor(hp / 2.0) * 2.0;
    let x = c * (1.0 - _abs(h_mod2 - 1.0));
    let r1 = 0.0; let g1 = 0.0; let b1 = 0.0;
    if hp < 1.0 { r1 = c; g1 = x; b1 = 0.0; }
    else if hp < 2.0 { r1 = x; g1 = c; b1 = 0.0; }
    else if hp < 3.0 { r1 = 0.0; g1 = c; b1 = x; }
    else if hp < 4.0 { r1 = 0.0; g1 = x; b1 = c; }
    else if hp < 5.0 { r1 = x; g1 = 0.0; b1 = c; }
    else { r1 = c; g1 = 0.0; b1 = x; }
    let m = l - c * 0.5;
    return [
        _clamp(num_floor((r1 + m) * 255.0 + 0.5), 0, 255),
        _clamp(num_floor((g1 + m) * 255.0 + 0.5), 0, 255),
        _clamp(num_floor((b1 + m) * 255.0 + 0.5), 0, 255),
        alpha
    ];
}

fn _series_palette(idx) {
    let pal = [
        [16, 229, 155, 255],   // Emerald #10E59B
        [34, 211, 238, 255],   // Cyan #22D3EE
        [147, 197, 253, 255],  // Periwinkle #93C5FD
        [251, 191, 36, 255],   // Amber #FBBF24
        [251, 113, 133, 255],  // Coral #FB7185
        [192, 132, 252, 255]   // Violet #C084FC
    ];
    let k = num_mod(_max(0, num_floor(idx)), len(pal));
    return pal[k];
}

fn graph_theme(dark_mode = true) {
    if dark_mode {
        return map{
            dark: true,
            bg: [11, 15, 20, 255],
            card: [18, 25, 34, 255],
            card_alt: [24, 34, 46, 255],
            grid: [28, 41, 56, 255],
            axis: [72, 98, 126, 255],
            border: [40, 58, 78, 255],
            text: [242, 247, 252, 255],
            text_sec: [188, 204, 222, 255],
            text_muted: [146, 168, 190, 255],
            emerald: [16, 229, 155, 255],
            cyan: [34, 211, 238, 255],
            periwinkle: [147, 197, 253, 255],
            amber: [251, 191, 36, 255],
            coral: [251, 113, 133, 255],
            dimmed: [38, 52, 68, 140]
        };
    }
    return map{
        dark: false,
        bg: [244, 248, 252, 255],
        card: [255, 255, 255, 255],
        card_alt: [236, 243, 250, 255],
        grid: [218, 228, 238, 255],
        axis: [110, 132, 156, 255],
        border: [186, 204, 222, 255],
        text: [11, 19, 30, 255],
        text_sec: [36, 56, 78, 255],
        text_muted: [72, 96, 122, 255],
        emerald: [4, 120, 87, 255],
        cyan: [14, 116, 144, 255],
        periwinkle: [37, 99, 235, 255],
        amber: [180, 83, 9, 255],
        coral: [190, 18, 60, 255],
        dimmed: [192, 206, 220, 140]
    };
}

// ============================================================================
// 2. Fast Pure-PBLang Real & Complex Math Expression Compiler (RPN Bytecode)
// ============================================================================

fn _normalize_expr_str(expr_raw) {
    let s = str_trim(str(expr_raw));
    // Strip leading "f(x) =" or "y =" or "z =" if user typed an equation
    if str_contains(s, "=") and not str_contains(s, "<=") and not str_contains(s, ">=") and not str_contains(s, "==") {
        let parts = str_split(s, "=");
        if len(parts) == 2 {
            let lhs = str_trim(parts[0]);
            let rhs = str_trim(parts[1]);
            // For implicit F(x, y) = 0, convert lhs = rhs -> (lhs) - (rhs)
            if rhs == "0" or rhs == "0.0" {
                s = lhs;
            } else if lhs == "y" or lhs == "z" or lhs == "w" or lhs == "r" or str_starts_with(lhs, "f(") or str_starts_with(lhs, "g(") {
                s = rhs;
            } else {
                s = "(" + lhs + ")-(" + rhs + ")";
            }
        }
    }
    s = str_replace_all(s, "−", "-");
    s = str_replace_all(s, "×", "*");
    s = str_replace_all(s, "÷", "/");
    s = str_replace_all(s, "²", "^2");
    s = str_replace_all(s, "³", "^3");
    s = str_replace_all(s, "⁴", "^4");
    s = str_replace_all(s, "π", "pi");
    s = str_replace_all(s, "θ", "theta");
    s = str_replace_all(s, "ω", "omega");
    s = str_replace_all(s, "φ", "phi");
    s = str_replace_all(s, "√", "sqrt");
    return s;
}

fn _is_digit_code(c) { return c >= 48 and c <= 57; }
fn _is_alpha_code(c) { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95; }

fn _is_known_fn(ident) {
    return ident == "sin" or ident == "cos" or ident == "tan"
        or ident == "asin" or ident == "acos" or ident == "atan" or ident == "atan2"
        or ident == "sinh" or ident == "cosh" or ident == "tanh"
        or ident == "exp" or ident == "ln" or ident == "log" or ident == "log10"
        or ident == "sqrt" or ident == "abs" or ident == "floor" or ident == "ceil"
        or ident == "round" or ident == "sign" or ident == "sinc"
        or ident == "min" or ident == "max" or ident == "hypot" or ident == "conj"
        or ident == "re" or ident == "im" or ident == "arg";
}

fn _tokenize_math(s) {
    let toks = [];
    let n = len(s);
    let idx = 0;
    while idx < n {
        let c = strcharcodeat(s, idx);
        if c == 32 or c == 9 or c == 10 or c == 13 {
            idx = idx + 1;
        } else if _is_digit_code(c) or (c == 46 and idx + 1 < n and _is_digit_code(strcharcodeat(s, idx + 1))) {
            let start = idx;
            let seen_dot = false;
            while idx < n {
                let cc = strcharcodeat(s, idx);
                if _is_digit_code(cc) {
                    idx = idx + 1;
                } else if cc == 46 and not seen_dot {
                    seen_dot = true;
                    idx = idx + 1;
                } else {
                    break;
                }
            }
            // Scientific notation e.g. 1.5e-3
            if idx < n {
                let ec = strcharcodeat(s, idx);
                if ec == 101 or ec == 69 {
                    let next_i = idx + 1;
                    if next_i < n and (strcharcodeat(s, next_i) == 43 or strcharcodeat(s, next_i) == 45) {
                        next_i = next_i + 1;
                    }
                    if next_i < n and _is_digit_code(strcharcodeat(s, next_i)) {
                        idx = next_i + 1;
                        while idx < n and _is_digit_code(strcharcodeat(s, idx)) {
                            idx = idx + 1;
                        }
                    }
                }
            }
            let num_txt = str_slice(s, start, idx);
            let val = _num_or(num_txt, 0.0);
            array_push(toks, map{ t: "num", v: val });
        } else if _is_alpha_code(c) {
            let start = idx;
            while idx < n {
                let cc = strcharcodeat(s, idx);
                if _is_alpha_code(cc) or _is_digit_code(cc) {
                    idx = idx + 1;
                } else {
                    break;
                }
            }
            let ident = str_lower(str_slice(s, start, idx));
            // Check if followed by '(' -> function call if known function
            let look = idx;
            while look < n and strcharcodeat(s, look) == 32 { look = look + 1; }
            if look < n and strcharcodeat(s, look) == 40 and _is_known_fn(ident) {
                array_push(toks, map{ t: "fn", name: ident });
            } else if ident == "pi" {
                array_push(toks, map{ t: "num", v: PI });
            } else if ident == "tau" {
                array_push(toks, map{ t: "num", v: TAU });
            } else if ident == "e" {
                array_push(toks, map{ t: "num", v: E_VAL });
            } else {
                array_push(toks, map{ t: "var", name: ident });
            }
        } else {
            let ch = str_slice(s, idx, idx + 1);
            if ch == "*" and idx + 1 < n and str_slice(s, idx + 1, idx + 2) == "*" {
                array_push(toks, map{ t: "op", op: "^" });
                idx = idx + 2;
            } else if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "^" or ch == "%" {
                array_push(toks, map{ t: "op", op: ch });
                idx = idx + 1;
            } else if ch == "(" or ch == ")" or ch == "," {
                array_push(toks, map{ t: ch });
                idx = idx + 1;
            } else {
                idx = idx + 1;
            }
        }
    }

    // Insert implicit multiplication: e.g. 2x, 2(x+1), (x+1)(x-1), x(y+1), 2 sin(x)
    let out = [];
    let k = 0;
    while k < len(toks) {
        let cur = toks[k];
        if len(out) > 0 {
            let prev = out[len(out) - 1];
            let prev_val = prev.t == "num" or prev.t == "var" or prev.t == ")";
            let cur_val = cur.t == "num" or cur.t == "var" or cur.t == "fn" or cur.t == "(";
            if prev_val and cur_val {
                array_push(out, map{ t: "op", op: "*" });
            }
        }
        array_push(out, cur);
        k = k + 1;
    }
    return out;
}

fn _op_prec(op) {
    if op == "u-" or op == "u+" { return 4; }
    if op == "^" { return 5; }
    if op == "*" or op == "/" or op == "%" { return 3; }
    if op == "+" or op == "-" { return 2; }
    return 0;
}

fn _op_right_assoc(op) {
    return op == "^" or op == "u-" or op == "u+";
}

fn compile_math_expr(expr_or_fn) {
    if is_fn(expr_or_fn) {
        return map{ ok: true, kind: "closure", fn_ref: expr_or_fn, source: "<fn>" };
    }
    if type(expr_or_fn) == "map" and map_has(expr_or_fn, "rpn") {
        return expr_or_fn;
    }
    let norm = _normalize_expr_str(expr_or_fn);
    let toks = _tokenize_math(norm);
    let rpn = [];
    let stack = [];
    let prev_type = "start";
    let idx = 0;
    while idx < len(toks) {
        let tk = toks[idx];
        if tk.t == "num" or tk.t == "var" {
            array_push(rpn, tk);
            prev_type = "val";
        } else if tk.t == "fn" {
            array_push(stack, tk);
            prev_type = "fn";
        } else if tk.t == "," {
            while len(stack) > 0 and stack[len(stack) - 1].t != "(" {
                array_push(rpn, array_pop(stack));
            }
            prev_type = ",";
        } else if tk.t == "(" {
            array_push(stack, tk);
            prev_type = "(";
        } else if tk.t == ")" {
            while len(stack) > 0 and stack[len(stack) - 1].t != "(" {
                array_push(rpn, array_pop(stack));
            }
            if len(stack) > 0 and stack[len(stack) - 1].t == "(" {
                array_pop(stack);
            }
            if len(stack) > 0 and stack[len(stack) - 1].t == "fn" {
                array_push(rpn, array_pop(stack));
            }
            prev_type = "val";
        } else if tk.t == "op" {
            let op = tk.op;
            if (op == "-" or op == "+") and (prev_type == "start" or prev_type == "(" or prev_type == "," or prev_type == "op") {
                if op == "-" { op = "u-"; } else { op = "u+"; }
            }
            let p1 = _op_prec(op);
            let r_assoc = _op_right_assoc(op);
            while len(stack) > 0 and stack[len(stack) - 1].t == "op" {
                let top_op = stack[len(stack) - 1].op;
                let p2 = _op_prec(top_op);
                if (not r_assoc and p1 <= p2) or (r_assoc and p1 < p2) {
                    array_push(rpn, array_pop(stack));
                } else {
                    break;
                }
            }
            array_push(stack, map{ t: "op", op: op });
            prev_type = "op";
        }
        idx = idx + 1;
    }
    while len(stack) > 0 {
        let top = array_pop(stack);
        if top.t != "(" and top.t != ")" {
            array_push(rpn, top);
        }
    }
    return map{ ok: len(rpn) > 0, kind: "rpn", rpn: rpn, source: str(expr_or_fn), normalized: norm };
}

fn _eval_real_fn(fname, st) {
    if fname == "atan2" or fname == "min" or fname == "max" or fname == "hypot" {
        let b = if len(st) > 0 { array_pop(st) } else { 0.0 };
        let a = if len(st) > 0 { array_pop(st) } else { 0.0 };
        if fname == "atan2" { return num_atan2(a, b); }
        if fname == "min" { return _min(a, b); }
        if fname == "max" { return _max(a, b); }
        return num_sqrt(a * a + b * b);
    }
    let a = if len(st) > 0 { array_pop(st) } else { 0.0 };
    if not _is_finite(a) { return NAN_VAL; }
    if fname == "sin" { return num_sin(a); }
    if fname == "cos" { return num_cos(a); }
    if fname == "tan" { return num_tan(a); }
    if fname == "atan" { return num_atan2(a, 1.0); }
    if fname == "asin" {
        if a < -1.0 or a > 1.0 { return NAN_VAL; }
        return num_atan2(a, num_sqrt(_max(0.0, 1.0 - a * a)));
    }
    if fname == "acos" {
        if a < -1.0 or a > 1.0 { return NAN_VAL; }
        return num_atan2(num_sqrt(_max(0.0, 1.0 - a * a)), a);
    }
    if fname == "sinh" { return 0.5 * (num_exp(a) - num_exp(0.0 - a)); }
    if fname == "cosh" { return 0.5 * (num_exp(a) + num_exp(0.0 - a)); }
    if fname == "tanh" {
        let ea = num_exp(a);
        let eb = num_exp(0.0 - a);
        return (ea - eb) / (ea + eb);
    }
    if fname == "exp" { return num_exp(a); }
    if fname == "ln" or fname == "log" {
        if a <= 0.0 { return NAN_VAL; }
        return num_ln(a);
    }
    if fname == "log10" {
        if a <= 0.0 { return NAN_VAL; }
        return num_ln(a) / 2.302585092994046;
    }
    if fname == "sqrt" {
        if a < 0.0 { return NAN_VAL; }
        return num_sqrt(a);
    }
    if fname == "abs" { return _abs(a); }
    if fname == "floor" { return num_floor(a); }
    if fname == "ceil" { return num_ceil(a); }
    if fname == "round" { return num_round(a); }
    if fname == "sign" { return _sign(a); }
    if fname == "sinc" {
        if _abs(a) < 1e-8 { return 1.0; }
        return num_sin(a) / a;
    }
    return a;
}

fn eval_compiled_expr(compiled, env) {
    if compiled.kind == "closure" {
        let fn_ref = compiled.fn_ref;
        let res = try fn_ref(env) catch (NAN_VAL);
        return _num_or(res, NAN_VAL);
    }
    let rpn = compiled.rpn;
    let st = [];
    let idx = 0;
    let n = len(rpn);
    while idx < n {
        let ins = rpn[idx];
        let kt = ins.t;
        if kt == "num" {
            array_push(st, ins.v);
        } else if kt == "var" {
            let vn = ins.name;
            let vv = 0.0;
            if env != nil and map_has(env, vn) {
                vv = _num_or(env[vn], 0.0);
            } else if vn == "phi" {
                vv = PHI_VAL;
            }
            array_push(st, vv);
        } else if kt == "op" {
            let op = ins.op;
            if op == "u-" {
                let a = if len(st) > 0 { array_pop(st) } else { 0.0 };
                array_push(st, 0.0 - a);
            } else if op == "u+" {
                // no-op
            } else {
                let b = if len(st) > 0 { array_pop(st) } else { 0.0 };
                let a = if len(st) > 0 { array_pop(st) } else { 0.0 };
                if op == "+" { array_push(st, a + b); }
                else if op == "-" { array_push(st, a - b); }
                else if op == "*" { array_push(st, a * b); }
                else if op == "/" {
                    if _abs(b) < 1e-14 { array_push(st, NAN_VAL); }
                    else { array_push(st, a / b); }
                } else if op == "%" {
                    if _abs(b) < 1e-14 { array_push(st, NAN_VAL); }
                    else { array_push(st, a - num_floor(a / b) * b); }
                } else if op == "^" {
                    if b == 2.0 { array_push(st, a * a); }
                    else if b == 3.0 { array_push(st, a * a * a); }
                    else if b == 4.0 { let a2 = a * a; array_push(st, a2 * a2); }
                    else if a < 0.0 and num_floor(b) != b { array_push(st, NAN_VAL); }
                    else { array_push(st, num_pow(a, b)); }
                }
            }
        } else if kt == "fn" {
            array_push(st, _eval_real_fn(ins.name, st));
        }
        idx = idx + 1;
    }
    if len(st) == 0 { return 0.0; }
    return st[len(st) - 1];
}

// Complex RPN Evaluator over C: pairs [re, im], supports z = [x, y], i = [0, 1], +,-,*,/,^,exp,sin,cos,ln,sqrt,conj
fn _cmul(a, b) { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]]; }

fn _cdiv(a, b) {
    let den = b[0] * b[0] + b[1] * b[1];
    if den < 1e-24 { return [NAN_VAL, NAN_VAL]; }
    return [(a[0] * b[0] + a[1] * b[1]) / den, (a[1] * b[0] - a[0] * b[1]) / den];
}

fn _cexp(z) {
    let er = num_exp(_clamp(z[0], -60.0, 60.0));
    return [er * num_cos(z[1]), er * num_sin(z[1])];
}

fn _cln(z) {
    let r = num_sqrt(z[0] * z[0] + z[1] * z[1]);
    if r < 1e-20 { return [-46.0, 0.0]; }
    return [num_ln(r), num_atan2(z[1], z[0])];
}

fn _cpow(a, b) {
    if _abs(b[1]) < 1e-12 {
        let n = b[0];
        if n == 0.0 { return [1.0, 0.0]; }
        if n == 1.0 { return a; }
        if n == 2.0 { return _cmul(a, a); }
        if n == 3.0 { return _cmul(_cmul(a, a), a); }
        if n == 4.0 { let a2 = _cmul(a, a); return _cmul(a2, a2); }
        if n == -1.0 { return _cdiv([1.0, 0.0], a); }
    }
    if a[0] * a[0] + a[1] * a[1] < 1e-24 { return [0.0, 0.0]; }
    return _cexp(_cmul(b, _cln(a)));
}

fn eval_complex_compiled(compiled, zx, zy, env = nil) {
    if compiled.kind == "closure" {
        let fn_ref = compiled.fn_ref;
        let r = try fn_ref(zx, zy) catch [0.0, 0.0];
        if is_array(r) and len(r) >= 2 { return [r[0], r[1]]; }
        return [_num_or(r, 0.0), 0.0];
    }
    let rpn = compiled.rpn;
    let st = [];
    let idx = 0;
    while idx < len(rpn) {
        let ins = rpn[idx];
        if ins.t == "num" {
            array_push(st, [ins.v, 0.0]);
        } else if ins.t == "var" {
            let vn = ins.name;
            if vn == "z" { array_push(st, [zx, zy]); }
            else if vn == "i" { array_push(st, [0.0, 1.0]); }
            else if vn == "x" { array_push(st, [zx, 0.0]); }
            else if vn == "y" { array_push(st, [zy, 0.0]); }
            else if env != nil and map_has(env, vn) { array_push(st, [_num_or(env[vn], 0.0), 0.0]); }
            else { array_push(st, [0.0, 0.0]); }
        } else if ins.t == "op" {
            let op = ins.op;
            if op == "u-" {
                let a = if len(st) > 0 { array_pop(st) } else { [0.0, 0.0] };
                array_push(st, [0.0 - a[0], 0.0 - a[1]]);
            } else if op != "u+" {
                let b = if len(st) > 0 { array_pop(st) } else { [0.0, 0.0] };
                let a = if len(st) > 0 { array_pop(st) } else { [0.0, 0.0] };
                if op == "+" { array_push(st, [a[0] + b[0], a[1] + b[1]]); }
                else if op == "-" { array_push(st, [a[0] - b[0], a[1] - b[1]]); }
                else if op == "*" { array_push(st, _cmul(a, b)); }
                else if op == "/" { array_push(st, _cdiv(a, b)); }
                else if op == "^" { array_push(st, _cpow(a, b)); }
            }
        } else if ins.t == "fn" {
            let fnm = ins.name;
            let a = if len(st) > 0 { array_pop(st) } else { [0.0, 0.0] };
            if fnm == "exp" { array_push(st, _cexp(a)); }
            else if fnm == "ln" or fnm == "log" { array_push(st, _cln(a)); }
            else if fnm == "sqrt" { array_push(st, _cpow(a, [0.5, 0.0])); }
            else if fnm == "conj" { array_push(st, [a[0], 0.0 - a[1]]); }
            else if fnm == "abs" { array_push(st, [num_sqrt(a[0] * a[0] + a[1] * a[1]), 0.0]); }
            else if fnm == "re" { array_push(st, [a[0], 0.0]); }
            else if fnm == "im" { array_push(st, [a[1], 0.0]); }
            else if fnm == "arg" { array_push(st, [num_atan2(a[1], a[0]), 0.0]); }
            else if fnm == "sin" {
                let iz = [0.0 - a[1], a[0]];
                let niz = [a[1], 0.0 - a[0]];
                let d = _cdiv([_cexp(iz)[0] - _cexp(niz)[0], _cexp(iz)[1] - _cexp(niz)[1]], [0.0, 2.0]);
                array_push(st, d);
            } else if fnm == "cos" {
                let iz = [0.0 - a[1], a[0]];
                let niz = [a[1], 0.0 - a[0]];
                let ea = _cexp(iz); let eb = _cexp(niz);
                array_push(st, [(ea[0] + eb[0]) * 0.5, (ea[1] + eb[1]) * 0.5]);
            } else {
                array_push(st, a);
            }
        }
        idx = idx + 1;
    }
    if len(st) == 0 { return [0.0, 0.0]; }
    return st[len(st) - 1];
}

// ============================================================================
// 3. Linear Algebra, SO(3)/SO(4)/SO(N) Rotors, Depth Sort & Pure-PBLang PCA
// ============================================================================

fn _eye_mat(n) {
    let m = [];
    let r = 0;
    while r < n {
        let row = [];
        let c = 0;
        while c < n {
            array_push(row, if r == c { 1.0 } else { 0.0 });
            c = c + 1;
        }
        array_push(m, row);
        r = r + 1;
    }
    return m;
}

// Left-multiply N×N matrix M by Givens plane rotation G(i, j, angle_rad)
fn _apply_givens_left(mat, dim_i, dim_j, angle_rad) {
    let n = len(mat);
    if dim_i < 0 or dim_j < 0 or dim_i >= n or dim_j >= n or dim_i == dim_j { return mat; }
    let cs = num_cos(angle_rad);
    let sn = num_sin(angle_rad);
    let row_i = mat[dim_i];
    let row_j = mat[dim_j];
    let new_i = [];
    let new_j = [];
    let c = 0;
    while c < n {
        let vi = row_i[c];
        let vj = row_j[c];
        array_push(new_i, cs * vi - sn * vj);
        array_push(new_j, sn * vi + cs * vj);
        c = c + 1;
    }
    mat[dim_i] = new_i;
    mat[dim_j] = new_j;
    return mat;
}

// Gram-Schmidt row orthonormalization to keep SO(N) rotor drift-free over 10,000+ frames
fn _orthonormalize_rows(mat) {
    let n = len(mat);
    let r = 0;
    while r < n {
        let row = mat[r];
        let p = 0;
        while p < r {
            let prev = mat[p];
            let dot = 0.0;
            let k = 0;
            while k < n { dot = dot + row[k] * prev[k]; k = k + 1; }
            k = 0;
            while k < n { row[k] = row[k] - dot * prev[k]; k = k + 1; }
            p = p + 1;
        }
        let norm2 = 0.0;
        let k2 = 0;
        while k2 < n { norm2 = norm2 + row[k2] * row[k2]; k2 = k2 + 1; }
        let inv = if norm2 > 1e-20 { 1.0 / num_sqrt(norm2) } else { 1.0 };
        k2 = 0;
        while k2 < n { row[k2] = row[k2] * inv; k2 = k2 + 1; }
        mat[r] = row;
        r = r + 1;
    }
    return mat;
}

fn _mat_vec_mul(mat, vec) {
    let n = len(mat);
    let m = len(vec);
    let out = [];
    let r = 0;
    while r < n {
        let row = mat[r];
        let acc = 0.0;
        let c = 0;
        let lim = _min(len(row), m);
        while c < lim { acc = acc + row[c] * vec[c]; c = c + 1; }
        array_push(out, acc);
        r = r + 1;
    }
    return out;
}

fn _plane_indices_4d(plane_name) {
    let p = str_lower(str_trim(str(plane_name)));
    if p == "xw" { return [0, 3, 1.0]; }
    if p == "wx" { return [0, 3, -1.0]; }
    if p == "yw" { return [1, 3, 1.0]; }
    if p == "wy" { return [1, 3, -1.0]; }
    if p == "zw" { return [2, 3, 1.0]; }
    if p == "wz" { return [2, 3, -1.0]; }
    if p == "xy" { return [0, 1, 1.0]; }
    if p == "yx" { return [0, 1, -1.0]; }
    if p == "xz" { return [0, 2, 1.0]; }
    if p == "zx" { return [0, 2, -1.0]; }
    if p == "yz" { return [1, 2, 1.0]; }
    if p == "zy" { return [1, 2, -1.0]; }
    return [0, 3, 1.0];
}

// 4D -> 3D stereographic / perspective projection
fn _project_4d_to_3d(pt4, rotor4, w_eye = 3.5) {
    let rot = _mat_vec_mul(rotor4, pt4);
    let denom = w_eye - rot[3];
    if _abs(denom) < 0.25 { denom = if denom >= 0.0 { 0.25 } else { -0.25 }; }
    let s4 = w_eye / denom;
    return map{
        x: rot[0] * s4,
        y: rot[1] * s4,
        z: rot[2] * s4,
        w_rot: rot[3],
        rot4: rot,
        scale4: s4
    };
}

// 3D Camera Gimbal transform + perspective/orthographic projection to screen (sx, sy, z_depth)
fn _project_3d_point(x, y, z, cam3d, vp) {
    let yaw_r = cam3d.yaw * PI / 180.0;
    let pitch_r = cam3d.pitch * PI / 180.0;
    let roll_r = cam3d.roll * PI / 180.0;

    // Turntable orbit around Z-up (math convention: x, y horizontal, z vertical!)
    let cy = num_cos(yaw_r);
    let sy = num_sin(yaw_r);
    let x1 = x * cy - y * sy;
    let y1 = x * sy + y * cy;
    let z1 = z;

    // Pitch tilts (y1, z1) so Z-up maps onto screen -Y
    let cp = num_cos(pitch_r);
    let sp = num_sin(pitch_r);
    let rx = x1;
    let ry = z1 * cp - y1 * sp;
    let rz = z1 * sp + y1 * cp; // camera depth: smaller rz = farther, larger rz = closer to viewer!

    // Optional roll in image plane
    if _abs(roll_r) > 1e-7 {
        let cr = num_cos(roll_r);
        let sr = num_sin(roll_r);
        let rrx = rx * cr - ry * sr;
        let rry = rx * sr + ry * cr;
        rx = rrx;
        ry = rry;
    }

    let persp = 1.0;
    if cam3d.perspective {
        let eye_d = 7.5;
        let denom = _max(1.2, eye_d - rz * 0.45);
        persp = eye_d / denom;
    }
    let scale_px = _min(vp.w, vp.h) * 0.135 * cam3d.zoom * persp;
    let sx = vp.cx + cam3d.pan_x + rx * scale_px;
    let sy = vp.cy + cam3d.pan_y - ry * scale_px;
    return map{
        sx: sx,
        sy: sy,
        z_depth: rz,
        cam_x: rx,
        cam_y: ry
    };
}

// Directional diffuse + ambient + rim shading for 3D surface quads
fn _shade_3d_quad(p0, p1, p3, base_rgba) {
    let ux = p1[0] - p0[0]; let uy = p1[1] - p0[1]; let uz = p1[2] - p0[2];
    let vx = p3[0] - p0[0]; let vy = p3[1] - p0[1]; let vz = p3[2] - p0[2];
    let nx = uy * vz - uz * vy;
    let ny = uz * vx - ux * vz;
    let nz = ux * vy - uy * vx;
    let nl = num_sqrt(nx * nx + ny * ny + nz * nz);
    if nl > 1e-12 { nx = nx / nl; ny = ny / nl; nz = nz / nl; } else { nz = 1.0; }
    // Light source direction normalized: (0.42, -0.38, 0.824)
    let dot_l = _abs(nx * 0.42 - ny * 0.38 + nz * 0.824);
    let intensity = _clamp(0.38 + 0.68 * dot_l, 0.25, 1.12);
    return [
        _clamp(num_floor(base_rgba[0] * intensity + 0.5), 0, 255),
        _clamp(num_floor(base_rgba[1] * intensity + 0.5), 0, 255),
        _clamp(num_floor(base_rgba[2] * intensity + 0.5), 0, 255),
        base_rgba[3]
    ];
}

// Iterative Quicksort on array of maps by `.z_depth` ascending (Painter's back-to-front order!)
fn _sort_by_z_depth(items) {
    let n = len(items);
    if n <= 1 { return items; }
    let stack = [[0, n - 1]];
    while len(stack) > 0 {
        let range_pair = array_pop(stack);
        let lo = range_pair[0];
        let hi = range_pair[1];
        if lo < hi {
            let mid = num_floor((lo + hi) / 2);
            let pivot = items[mid].z_depth;
            let l_idx = lo;
            let r_idx = hi;
            while l_idx <= r_idx {
                while items[l_idx].z_depth < pivot { l_idx = l_idx + 1; }
                while items[r_idx].z_depth > pivot { r_idx = r_idx - 1; }
                if l_idx <= r_idx {
                    let tmp = items[l_idx];
                    items[l_idx] = items[r_idx];
                    items[r_idx] = tmp;
                    l_idx = l_idx + 1;
                    r_idx = r_idx - 1;
                }
            }
            if lo < r_idx { array_push(stack, [lo, r_idx]); }
            if l_idx < hi { array_push(stack, [l_idx, hi]); }
        }
    }
    return items;
}

// Solve small dense linear system A * c = b via Gaussian elimination with partial pivoting (for OLS polynomial trendlines)
fn _solve_linear_dense(mat_a, vec_b) {
    let n = len(vec_b);
    let aug = [];
    let r = 0;
    while r < n {
        let row = [];
        let c = 0;
        while c < n { array_push(row, mat_a[r][c]); c = c + 1; }
        array_push(row, vec_b[r]);
        array_push(aug, row);
        r = r + 1;
    }
    let col = 0;
    while col < n {
        let piv = col;
        let best = _abs(aug[col][col]);
        let rr = col + 1;
        while rr < n {
            if _abs(aug[rr][col]) > best { best = _abs(aug[rr][col]); piv = rr; }
            rr = rr + 1;
        }
        if piv != col {
            let sw = aug[col]; aug[col] = aug[piv]; aug[piv] = sw;
        }
        let diag = aug[col][col];
        if _abs(diag) < 1e-12 { diag = 1e-12; }
        rr = col + 1;
        while rr < n {
            let factor = aug[rr][col] / diag;
            let cc = col;
            while cc <= n {
                aug[rr][cc] = aug[rr][cc] - factor * aug[col][cc];
                cc = cc + 1;
            }
            rr = rr + 1;
        }
        col = col + 1;
    }
    let sol = [];
    let z = 0;
    while z < n { array_push(sol, 0.0); z = z + 1; }
    let back = n - 1;
    while back >= 0 {
        let sum_v = aug[back][n];
        let cc2 = back + 1;
        while cc2 < n { sum_v = sum_v - aug[back][cc2] * sol[cc2]; cc2 = cc2 + 1; }
        let d2 = aug[back][back];
        sol[back] = if _abs(d2) > 1e-12 { sum_v / d2 } else { 0.0 };
        back = back - 1;
    }
    return sol;
}

// Pure-PBLang PCA: centers N×D data, computes D×D covariance, Power-Iteration + Hotelling Deflation
fn compute_pca_subspace(data_NxD, target_dim = 3) {
    let n_rows = len(data_NxD);
    if n_rows == 0 {
        return map{ projected: [], eigenvalues: [], explained_variance_pct: [], total_explained_pct: 0.0, dim_d: 0 };
    }
    let dim_d = len(data_NxD[0]);
    let k_dim = _clamp(_int_or(target_dim, 3), 1, _min(3, dim_d));

    // 1. Column means
    let means = [];
    let j = 0;
    while j < dim_d {
        let s = 0.0;
        let r = 0;
        while r < n_rows { s = s + _num_or(data_NxD[r][j], 0.0); r = r + 1; }
        array_push(means, s / n_rows);
        j = j + 1;
    }

    // 2. Centered matrix Xc
    let xc = [];
    let r = 0;
    while r < n_rows {
        let row = [];
        j = 0;
        while j < dim_d {
            array_push(row, _num_or(data_NxD[r][j], 0.0) - means[j]);
            j = j + 1;
        }
        array_push(xc, row);
        r = r + 1;
    }

    // 3. Covariance matrix Cov = (1 / max(1, N-1)) * Xc^T * Xc
    let denom = _max(1.0, (n_rows - 1) * 1.0);
    let cov = [];
    let trace_cov = 0.0;
    let a = 0;
    while a < dim_d {
        let crow = [];
        let b = 0;
        while b < dim_d {
            let acc = 0.0;
            r = 0;
            while r < n_rows { acc = acc + xc[r][a] * xc[r][b]; r = r + 1; }
            let cv = acc / denom;
            array_push(crow, cv);
            if a == b { trace_cov = trace_cov + _max(0.0, cv); }
            b = b + 1;
        }
        array_push(cov, crow);
        a = a + 1;
    }

    // 4. Power Iteration + Hotelling Deflation for top k_dim eigenvectors
    let work = [];
    a = 0;
    while a < dim_d {
        let wrow = [];
        let b = 0;
        while b < dim_d { array_push(wrow, cov[a][b]); b = b + 1; }
        array_push(work, wrow);
        a = a + 1;
    }

    let eig_vecs = [];
    let eig_vals = [];
    let comp = 0;
    while comp < k_dim {
        // Deterministic non-degenerate initial seed orthogonalized against prior components
        let vec = [];
        j = 0;
        while j < dim_d {
            array_push(vec, num_cos((j + 1.0) * (comp + 1.37)) + 0.31 * (j + 1.0));
            j = j + 1;
        }
        let iter = 0;
        while iter < 64 {
            let nxt = _mat_vec_mul(work, vec);
            // Re-orthogonalize against previous eigenvectors
            let p = 0;
            while p < len(eig_vecs) {
                let pv = eig_vecs[p];
                let d_prev = 0.0;
                j = 0;
                while j < dim_d { d_prev = d_prev + nxt[j] * pv[j]; j = j + 1; }
                j = 0;
                while j < dim_d { nxt[j] = nxt[j] - d_prev * pv[j]; j = j + 1; }
                p = p + 1;
            }
            let nrm2 = 0.0;
            j = 0;
            while j < dim_d { nrm2 = nrm2 + nxt[j] * nxt[j]; j = j + 1; }
            if nrm2 < 1e-22 { break; }
            let inv_n = 1.0 / num_sqrt(nrm2);
            j = 0;
            while j < dim_d { vec[j] = nxt[j] * inv_n; j = j + 1; }
            iter = iter + 1;
        }
        // Normalize final vec & compute Rayleigh quotient v^T * Cov * v
        let vn2 = 0.0;
        j = 0;
        while j < dim_d { vn2 = vn2 + vec[j] * vec[j]; j = j + 1; }
        let v_inv = if vn2 > 1e-22 { 1.0 / num_sqrt(vn2) } else { 1.0 };
        j = 0;
        while j < dim_d { vec[j] = vec[j] * v_inv; j = j + 1; }
        // Canonical sign: first largest-magnitude component positive
        let max_j = 0;
        j = 1;
        while j < dim_d { if _abs(vec[j]) > _abs(vec[max_j]) { max_j = j; } j = j + 1; }
        if vec[max_j] < 0.0 {
            j = 0;
            while j < dim_d { vec[j] = 0.0 - vec[j]; j = j + 1; }
        }
        let cv_vec = _mat_vec_mul(cov, vec);
        let lam = 0.0;
        j = 0;
        while j < dim_d { lam = lam + vec[j] * cv_vec[j]; j = j + 1; }
        lam = _max(0.0, lam);
        array_push(eig_vecs, vec);
        array_push(eig_vals, lam);

        // Hotelling deflation: W <- W - lam * v * v^T
        a = 0;
        while a < dim_d {
            let b = 0;
            while b < dim_d {
                work[a][b] = work[a][b] - lam * vec[a] * vec[b];
                b = b + 1;
            }
            a = a + 1;
        }
        comp = comp + 1;
    }

    let exp_pct = [];
    let tot_pct = 0.0;
    let safe_tr = if trace_cov > 1e-18 { trace_cov } else { 1.0 };
    comp = 0;
    while comp < len(eig_vals) {
        let pct = _clamp(100.0 * eig_vals[comp] / safe_tr, 0.0, 100.0);
        array_push(exp_pct, pct);
        tot_pct = tot_pct + pct;
        comp = comp + 1;
    }

    // Project rows Xc * V
    let proj = [];
    r = 0;
    while r < n_rows {
        let coords = [0.0, 0.0, 0.0];
        comp = 0;
        while comp < len(eig_vecs) {
            let ev = eig_vecs[comp];
            let dot = 0.0;
            j = 0;
            while j < dim_d { dot = dot + xc[r][j] * ev[j]; j = j + 1; }
            coords[comp] = dot;
            comp = comp + 1;
        }
        array_push(proj, coords);
        r = r + 1;
    }

    return map{
        projected: proj,
        eigenvectors: eig_vecs,
        eigenvalues: eig_vals,
        explained_variance_pct: exp_pct,
        total_explained_pct: _clamp(tot_pct, 0.0, 100.0),
        means: means,
        dim_d: dim_d,
        target_dim: k_dim
    };
}

// ============================================================================
// 4. Marching Squares (16-Case Linear Interpolation), 4D Polytopes & Geodesics
// ============================================================================

fn _interp_edge(p1x, p1y, v1, p2x, p2y, v2, level) {
    let dv = v2 - v1;
    let t = 0.5;
    if _abs(dv) > 1e-14 {
        t = _clamp((level - v1) / dv, 0.0, 1.0);
    }
    return [p1x + t * (p2x - p1x), p1y + t * (p2y - p1y)];
}

// Real 16-case Marching Squares contour segment extractor for F(x, y) = level
fn marching_squares_segments(grid_vals, xs, ys, level = 0.0) {
    let segs = [];
    let ny = len(ys) - 1;
    let nx = len(xs) - 1;
    let j = 0;
    while j < ny {
        let y0 = ys[j];
        let y1 = ys[j + 1];
        let row0 = grid_vals[j];
        let row1 = grid_vals[j + 1];
        let i = 0;
        while i < nx {
            let x0 = xs[i];
            let x1 = xs[i + 1];
            let v_bl = row0[i];
            let v_br = row0[i + 1];
            let v_tr = row1[i + 1];
            let v_tl = row1[i];
            if _is_finite(v_bl) and _is_finite(v_br) and _is_finite(v_tr) and _is_finite(v_tl) {
                let mask = 0;
                if v_bl >= level { mask = mask + 1; }
                if v_br >= level { mask = mask + 2; }
                if v_tr >= level { mask = mask + 4; }
                if v_tl >= level { mask = mask + 8; }

                if mask != 0 and mask != 15 {
                    let e_bot = _interp_edge(x0, y0, v_bl, x1, y0, v_br, level);
                    let e_rgt = _interp_edge(x1, y0, v_br, x1, y1, v_tr, level);
                    let e_top = _interp_edge(x0, y1, v_tl, x1, y1, v_tr, level);
                    let e_lft = _interp_edge(x0, y0, v_bl, x0, y1, v_tl, level);

                    if mask == 1 or mask == 14 {
                        array_push(segs, [e_lft, e_bot]);
                    } else if mask == 2 or mask == 13 {
                        array_push(segs, [e_bot, e_rgt]);
                    } else if mask == 3 or mask == 12 {
                        array_push(segs, [e_lft, e_rgt]);
                    } else if mask == 4 or mask == 11 {
                        array_push(segs, [e_top, e_rgt]);
                    } else if mask == 6 or mask == 9 {
                        array_push(segs, [e_bot, e_top]);
                    } else if mask == 7 or mask == 8 {
                        array_push(segs, [e_lft, e_top]);
                    } else if mask == 5 {
                        // Saddle point disambiguation via cell center average
                        let vc = 0.25 * (v_bl + v_br + v_tr + v_tl);
                        if vc >= level {
                            array_push(segs, [e_lft, e_top]);
                            array_push(segs, [e_bot, e_rgt]);
                        } else {
                            array_push(segs, [e_lft, e_bot]);
                            array_push(segs, [e_top, e_rgt]);
                        }
                    } else if mask == 10 {
                        let vc2 = 0.25 * (v_bl + v_br + v_tr + v_tl);
                        if vc2 >= level {
                            array_push(segs, [e_lft, e_bot]);
                            array_push(segs, [e_top, e_rgt]);
                        } else {
                            array_push(segs, [e_lft, e_top]);
                            array_push(segs, [e_bot, e_rgt]);
                        }
                    }
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return segs;
}

fn _build_4d_polytope(kind_raw) {
    let kind = str_lower(str_trim(str(kind_raw)));
    let verts = [];
    let edges = [];
    let faces = [];

    if kind == "16cell" or kind == "orthoplex" {
        let axis = 0;
        while axis < 4 {
            let s_idx = 0;
            while s_idx < 2 {
                let sgn = if s_idx == 0 { -1.35 } else { 1.35 };
                let pt = [0.0, 0.0, 0.0, 0.0];
                pt[axis] = sgn;
                array_push(verts, pt);
                s_idx = s_idx + 1;
            }
            axis = axis + 1;
        }
        let a = 0;
        while a < len(verts) {
            let b = a + 1;
            while b < len(verts) {
                // Non-antipodal vertices share dot product == 0
                let dot = verts[a][0] * verts[b][0] + verts[a][1] * verts[b][1] + verts[a][2] * verts[b][2] + verts[a][3] * verts[b][3];
                if _abs(dot) < 1e-6 {
                    array_push(edges, [a, b]);
                }
                b = b + 1;
            }
            a = a + 1;
        }
        return map{ kind: "16cell", vertices: verts, edges: edges, faces: faces };
    }

    if kind == "24cell" {
        let p1 = 0;
        while p1 < 4 {
            let p2 = p1 + 1;
            while p2 < 4 {
                let s1 = 0;
                while s1 < 2 {
                    let s2 = 0;
                    while s2 < 2 {
                        let pt = [0.0, 0.0, 0.0, 0.0];
                        pt[p1] = if s1 == 0 { -1.0 } else { 1.0 };
                        pt[p2] = if s2 == 0 { -1.0 } else { 1.0 };
                        array_push(verts, pt);
                        s2 = s2 + 1;
                    }
                    s1 = s1 + 1;
                }
                p2 = p2 + 1;
            }
            p1 = p1 + 1;
        }
        let a = 0;
        while a < len(verts) {
            let b = a + 1;
            while b < len(verts) {
                let dot = verts[a][0] * verts[b][0] + verts[a][1] * verts[b][1] + verts[a][2] * verts[b][2] + verts[a][3] * verts[b][3];
                if _abs(dot - 1.0) < 1e-6 {
                    array_push(edges, [a, b]);
                }
                b = b + 1;
            }
            a = a + 1;
        }
        return map{ kind: "24cell", vertices: verts, edges: edges, faces: faces };
    }

    if kind == "clifford_torus" or kind == "clifford" {
        let nu = 16;
        let nv = 12;
        let iu = 0;
        while iu < nu {
            let u = TAU * iu / nu;
            let cu = num_cos(u) * 1.15;
            let su = num_sin(u) * 1.15;
            let iv = 0;
            while iv < nv {
                let v = TAU * iv / nv;
                array_push(verts, [cu, su, num_cos(v) * 1.15, num_sin(v) * 1.15]);
                iv = iv + 1;
            }
            iu = iu + 1;
        }
        iu = 0;
        while iu < nu {
            let iu_next = num_mod(iu + 1, nu);
            let iv = 0;
            while iv < nv {
                let iv_next = num_mod(iv + 1, nv);
                let idx00 = iu * nv + iv;
                let idx10 = iu_next * nv + iv;
                let idx11 = iu_next * nv + iv_next;
                let idx01 = iu * nv + iv_next;
                array_push(edges, [idx00, idx10]);
                array_push(edges, [idx00, idx01]);
                array_push(faces, [idx00, idx10, idx11, idx01]);
                iv = iv + 1;
            }
            iu = iu + 1;
        }
        return map{ kind: "clifford_torus", vertices: verts, edges: edges, faces: faces };
    }

    // Default: "tesseract" (8-cell) — 16 vertices in {-1, +1}^4, 32 edges, 24 2D faces
    let mask = 0;
    while mask < 16 {
        let bx = if bit_and(mask, 1) != 0 { 1.0 } else { -1.0 };
        let by = if bit_and(mask, 2) != 0 { 1.0 } else { -1.0 };
        let bz = if bit_and(mask, 4) != 0 { 1.0 } else { -1.0 };
        let bw = if bit_and(mask, 8) != 0 { 1.0 } else { -1.0 };
        array_push(verts, [bx, by, bz, bw]);
        mask = mask + 1;
    }
    let v_idx = 0;
    while v_idx < 16 {
        let bit_k = 0;
        while bit_k < 4 {
            let nb = bit_xor(v_idx, bit_shl(1, bit_k));
            if v_idx < nb {
                array_push(edges, [v_idx, nb]);
            }
            bit_k = bit_k + 1;
        }
        v_idx = v_idx + 1;
    }
    // 24 square faces for exact hyperplane cross-section polygon slicing
    let d1 = 0;
    while d1 < 4 {
        let d2 = d1 + 1;
        while d2 < 4 {
            // Other two dimensions fixed in {-1, +1}
            let others = [];
            let dd = 0;
            while dd < 4 {
                if dd != d1 and dd != d2 { array_push(others, dd); }
                dd = dd + 1;
            }
            let s_a = 0;
            while s_a < 2 {
                let s_b = 0;
                while s_b < 2 {
                    let base = 0;
                    if s_a == 1 { base = base + bit_shl(1, others[0]); }
                    if s_b == 1 { base = base + bit_shl(1, others[1]); }
                    let f0 = base;
                    let f1 = base + bit_shl(1, d1);
                    let f2 = base + bit_shl(1, d1) + bit_shl(1, d2);
                    let f3 = base + bit_shl(1, d2);
                    array_push(faces, [f0, f1, f2, f3]);
                    s_b = s_b + 1;
                }
                s_a = s_a + 1;
            }
            d2 = d2 + 1;
        }
        d1 = d1 + 1;
    }
    return map{ kind: "tesseract", vertices: verts, edges: edges, faces: faces };
}

fn _build_nd_hypercube(dim_n) {
    let n = _clamp(_int_or(dim_n, 5), 2, 7);
    let total_v = bit_shl(1, n);
    let verts = [];
    let m = 0;
    while m < total_v {
        let pt = [];
        let k = 0;
        while k < n {
            array_push(pt, if bit_and(m, bit_shl(1, k)) != 0 { 1.0 } else { -1.0 });
            k = k + 1;
        }
        array_push(verts, pt);
        m = m + 1;
    }
    let edges = [];
    m = 0;
    while m < total_v {
        let k = 0;
        while k < n {
            let nb = bit_xor(m, bit_shl(1, k));
            if m < nb { array_push(edges, [m, nb]); }
            k = k + 1;
        }
        m = m + 1;
    }
    return map{ dim_n: n, vertices: verts, edges: edges };
}

// Compute exact hyperbolic geodesic polyline in Poincaré unit disk |z| < 1
fn _poincare_geodesic_points(z1, z2, steps = 44) {
    let x1 = z1[0]; let y1 = z1[1];
    let x2 = z2[0]; let y2 = z2[1];
    let r1sq = x1 * x1 + y1 * y1;
    let r2sq = x2 * x2 + y2 * y2;
    let cross = x1 * y2 - y1 * x2;
    let pts = [];
    if _abs(cross) < 1e-5 or r1sq < 1e-8 or r2sq < 1e-8 {
        // Diameter line through origin
        let k = 0;
        while k <= steps {
            let t = (k * 1.0) / steps;
            array_push(pts, [x1 + t * (x2 - x1), y1 + t * (y2 - y1)]);
            k = k + 1;
        }
        return pts;
    }
    // Invert z1 across unit circle: z3 = z1 / |z1|^2 -> circle through z1, z2, z3 is orthogonal to |z| = 1
    let x3 = x1 / r1sq;
    let y3 = y1 / r1sq;
    let d = 2.0 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2));
    if _abs(d) < 1e-9 {
        let k = 0;
        while k <= steps {
            let t = (k * 1.0) / steps;
            array_push(pts, [x1 + t * (x2 - x1), y1 + t * (y2 - y1)]);
            k = k + 1;
        }
        return pts;
    }
    let s1 = x1 * x1 + y1 * y1;
    let s2 = x2 * x2 + y2 * y2;
    let s3 = x3 * x3 + y3 * y3;
    let cx = (s1 * (y2 - y3) + s2 * (y3 - y1) + s3 * (y1 - y2)) / d;
    let cy = (s1 * (x3 - x2) + s2 * (x1 - x3) + s3 * (x2 - x1)) / d;
    let rad = num_sqrt(_max(1e-9, (x1 - cx) * (x1 - cx) + (y1 - cy) * (y1 - cy)));
    let a1 = num_atan2(y1 - cy, x1 - cx);
    let a2 = num_atan2(y2 - cy, x2 - cx);
    let da = a2 - a1;
    while da > PI { da = da - TAU; }
    while da < 0.0 - PI { da = da + TAU; }
    let k = 0;
    while k <= steps {
        let ang = a1 + da * (k * 1.0) / steps;
        array_push(pts, [cx + rad * num_cos(ang), cy + rad * num_sin(ang)]);
        k = k + 1;
    }
    return pts;
}

fn _poincare_distance(z1, z2) {
    let dx = z1[0] - z2[0];
    let dy = z1[1] - z2[1];
    let n1 = _max(1e-6, 1.0 - (z1[0] * z1[0] + z1[1] * z1[1]));
    let n2 = _max(1e-6, 1.0 - (z2[0] * z2[0] + z2[1] * z2[1]));
    let arg = _max(1.0, 1.0 + 2.0 * (dx * dx + dy * dy) / (n1 * n2));
    return num_ln(arg + num_sqrt(_max(0.0, arg * arg - 1.0)));
}

// ============================================================================
// 5. All Layer Constructors Across 0D, 1D, 2D, 3D, 4D, N-D & Non-Euclidean
// ============================================================================

fn _base_layer(kind, space, opts = nil) {
    let o = if opts != nil and is_map(opts) { opts } else { map{} };
    return map{
        id: 0,
        kind: kind,
        space: space,
        visible: _bool_or(try o.visible catch true, true),
        label: _str_or(try o.label catch "", kind),
        color: try o.color catch nil,
        opts: o
    };
}

// ── 0D & 1D Layers ───────────────────────────────────────────────────────────

fn layer_number_line(intervals_or_pts, opts = nil) {
    let lyr = _base_layer("number_line", "1d", opts);
    lyr.items = if is_array(intervals_or_pts) { intervals_or_pts } else { [intervals_or_pts] };
    return lyr;
}

fn layer_histogram_kde(values, bins = 12, bandwidth = nil, opts = nil) {
    let lyr = _base_layer("histogram_kde", "1d", opts);
    lyr.values = if is_array(values) { values } else { [] };
    lyr.bins = _clamp(_int_or(bins, 12), 2, 80);
    lyr.bandwidth = if bandwidth != nil { _num_or(bandwidth, 0.0) } else { nil };
    return lyr;
}

fn layer_boxplot(groups_map_or_arr, opts = nil) {
    let lyr = _base_layer("boxplot", "1d", opts);
    lyr.groups_raw = groups_map_or_arr;
    return lyr;
}

fn layer_deviation_bars(values, is_sample = true, opts = nil) {
    let lyr = _base_layer("deviation_bars", "1d", opts);
    lyr.values = if is_array(values) { values } else { [] };
    lyr.is_sample = _bool_or(is_sample, true);
    return lyr;
}

// ── 2D Layers (Cartesian, Statistical, Polar, Parametric, Implicit, Vector, Complex) ──

fn layer_2d_explicit(expr, xmin = nil, xmax = nil, opts = nil) {
    let lyr = _base_layer("2d_explicit", "2d", opts);
    lyr.expr = expr;
    lyr.compiled = compile_math_expr(expr);
    lyr.xmin = if xmin != nil { _num_or(xmin, -6.0) } else { nil };
    lyr.xmax = if xmax != nil { _num_or(xmax, 6.0) } else { nil };
    if lyr.label == "2d_explicit" { lyr.label = "f(x) = " + str(expr); }
    return lyr;
}

fn layer_bar_grouped(categories, series_list, horizontal = false, opts = nil) {
    let lyr = _base_layer("bar_grouped", "2d", opts);
    lyr.categories = if is_array(categories) { categories } else { [] };
    lyr.series_list = if is_array(series_list) { series_list } else { [] };
    lyr.horizontal = _bool_or(horizontal, false);
    return lyr;
}

fn layer_scatter_regression(xs, ys, trend_deg = 1, opts = nil) {
    let lyr = _base_layer("scatter_regression", "2d", opts);
    lyr.xs = if is_array(xs) { xs } else { [] };
    lyr.ys = if is_array(ys) { ys } else { [] };
    lyr.trend_deg = _clamp(_int_or(trend_deg, 1), 0, 5);
    return lyr;
}

fn layer_2d_parametric(x_expr, y_expr, u_var = "u", u_min = 0.0, u_max = 6.2831853, steps = 240, opts = nil) {
    let lyr = _base_layer("2d_parametric", "2d", opts);
    lyr.x_expr = x_expr;
    lyr.y_expr = y_expr;
    lyr.x_comp = compile_math_expr(x_expr);
    lyr.y_comp = compile_math_expr(y_expr);
    lyr.u_var = str_lower(_str_or(u_var, "u"));
    lyr.u_min = _num_or(u_min, 0.0);
    lyr.u_max = _num_or(u_max, TAU);
    lyr.steps = _clamp(_int_or(steps, 240), 16, 1200);
    return lyr;
}

fn layer_2d_polar(r_expr, theta_var = "theta", th_min = 0.0, th_max = 6.2831853, steps = 240, opts = nil) {
    let lyr = _base_layer("2d_polar", "2d", opts);
    lyr.r_expr = r_expr;
    lyr.r_comp = compile_math_expr(r_expr);
    lyr.theta_var = str_lower(_str_or(theta_var, "theta"));
    lyr.th_min = _num_or(th_min, 0.0);
    lyr.th_max = _num_or(th_max, TAU);
    lyr.steps = _clamp(_int_or(steps, 240), 16, 1200);
    if lyr.label == "2d_polar" { lyr.label = "r(θ) = " + str(r_expr); }
    return lyr;
}

fn layer_2d_implicit(f_xy_expr, xmin = -4.0, xmax = 4.0, ymin = -4.0, ymax = 4.0, grid_n = 48, opts = nil) {
    let lyr = _base_layer("2d_implicit", "2d", opts);
    lyr.f_xy_expr = f_xy_expr;
    lyr.f_comp = compile_math_expr(f_xy_expr);
    lyr.xmin = _num_or(xmin, -4.0);
    lyr.xmax = _num_or(xmax, 4.0);
    lyr.ymin = _num_or(ymin, -4.0);
    lyr.ymax = _num_or(ymax, 4.0);
    lyr.grid_n = _clamp(_int_or(grid_n, 48), 8, 128);
    if lyr.label == "2d_implicit" { lyr.label = str(f_xy_expr) + " = 0"; }
    return lyr;
}

fn layer_2d_contour_heatmap(f_xy_expr, xmin = -4.0, xmax = 4.0, ymin = -4.0, ymax = 4.0, levels = 8, grid_n = 32, opts = nil) {
    let lyr = _base_layer("2d_contour_heatmap", "2d", opts);
    lyr.f_xy_expr = f_xy_expr;
    lyr.f_comp = compile_math_expr(f_xy_expr);
    lyr.xmin = _num_or(xmin, -4.0);
    lyr.xmax = _num_or(xmax, 4.0);
    lyr.ymin = _num_or(ymin, -4.0);
    lyr.ymax = _num_or(ymax, 4.0);
    lyr.levels = _clamp(_int_or(levels, 8), 2, 24);
    lyr.grid_n = _clamp(_int_or(grid_n, 32), 8, 96);
    return lyr;
}

fn layer_2d_vector_field(px_expr, qy_expr, xmin = -4.0, xmax = 4.0, ymin = -4.0, ymax = 4.0, grid_n = 15, streamlines_starts = nil, opts = nil) {
    let lyr = _base_layer("2d_vector_field", "2d", opts);
    lyr.px_expr = px_expr;
    lyr.qy_expr = qy_expr;
    lyr.p_comp = compile_math_expr(px_expr);
    lyr.q_comp = compile_math_expr(qy_expr);
    lyr.xmin = _num_or(xmin, -4.0);
    lyr.xmax = _num_or(xmax, 4.0);
    lyr.ymin = _num_or(ymin, -4.0);
    lyr.ymax = _num_or(ymax, 4.0);
    lyr.grid_n = _clamp(_int_or(grid_n, 15), 4, 40);
    lyr.streamlines_starts = streamlines_starts;
    return lyr;
}

fn layer_complex_domain(fz_re_expr, fz_im_expr = nil, xmin = -2.5, xmax = 2.5, ymin = -2.5, ymax = 2.5, grid_n = 28, opts = nil) {
    let lyr = _base_layer("complex_domain", "2d", opts);
    lyr.fz_re_expr = fz_re_expr;
    lyr.fz_im_expr = fz_im_expr;
    if fz_im_expr == nil or str_trim(str(fz_im_expr)) == "" {
        lyr.complex_mode = "single_z";
        lyr.z_comp = compile_math_expr(fz_re_expr);
    } else {
        lyr.complex_mode = "re_im_xy";
        lyr.re_comp = compile_math_expr(fz_re_expr);
        lyr.im_comp = compile_math_expr(fz_im_expr);
    }
    lyr.xmin = _num_or(xmin, -2.5);
    lyr.xmax = _num_or(xmax, 2.5);
    lyr.ymin = _num_or(ymin, -2.5);
    lyr.ymax = _num_or(ymax, 2.5);
    lyr.grid_n = _clamp(_int_or(grid_n, 28), 6, 72);
    return lyr;
}

// ── 3D Layers (R^3) ──────────────────────────────────────────────────────────

fn layer_3d_surface(z_xy_expr, xmin = -3.0, xmax = 3.0, ymin = -3.0, ymax = 3.0, nx = 22, ny = 22, opts = nil) {
    let lyr = _base_layer("3d_surface", "3d", opts);
    lyr.z_xy_expr = z_xy_expr;
    lyr.z_comp = compile_math_expr(z_xy_expr);
    lyr.xmin = _num_or(xmin, -3.0);
    lyr.xmax = _num_or(xmax, 3.0);
    lyr.ymin = _num_or(ymin, -3.0);
    lyr.ymax = _num_or(ymax, 3.0);
    lyr.nx = _clamp(_int_or(nx, 22), 4, 64);
    lyr.ny = _clamp(_int_or(ny, 22), 4, 64);
    if lyr.label == "3d_surface" { lyr.label = "z = " + str(z_xy_expr); }
    return lyr;
}

fn layer_3d_parametric_curve(x_u, y_u = nil, z_u = nil, u_var = "u", u_min = 0.0, u_max = 6.2831853, steps = 250, opts = nil) {
    let lyr = _base_layer("3d_parametric_curve", "3d", opts);
    if is_array(x_u) {
        // Direct 3D trajectory points array [[x,y,z], ...] (e.g. integrated Lorenz attractor)
        lyr.curve_mode = "points";
        lyr.points_xyz = x_u;
    } else if str_lower(str_trim(str(x_u))) == "lorenz" and y_u == nil {
        // Built-in RK4 Lorenz strange attractor trajectory
        let pts = [];
        let lx = 0.1; let ly = 0.0; let lz = 0.0;
        let dt = 0.012;
        let sigma = 10.0; let rho = 28.0; let beta = 8.0 / 3.0;
        let stp = _clamp(_int_or(steps, 450), 50, 2000);
        let k = 0;
        while k < stp {
            let dx1 = sigma * (ly - lx);
            let dy1 = lx * (rho - lz) - ly;
            let dz1 = lx * ly - beta * lz;
            let mx = lx + 0.5 * dt * dx1;
            let my = ly + 0.5 * dt * dy1;
            let mz = lz + 0.5 * dt * dz1;
            let dx2 = sigma * (my - mx);
            let dy2 = mx * (rho - mz) - my;
            let dz2 = mx * my - beta * mz;
            lx = lx + dt * dx2;
            ly = ly + dt * dy2;
            lz = lz + dt * dz2;
            array_push(pts, [lx * 0.11, ly * 0.11, (lz - 25.0) * 0.11]);
            k = k + 1;
        }
        lyr.curve_mode = "points";
        lyr.points_xyz = pts;
        if lyr.label == "3d_parametric_curve" { lyr.label = "Ελκυστής Lorenz"; }
    } else {
        lyr.curve_mode = "expr";
        lyr.x_comp = compile_math_expr(x_u);
        lyr.y_comp = compile_math_expr(_str_or(y_u, "0"));
        lyr.z_comp = compile_math_expr(_str_or(z_u, "0"));
        lyr.u_var = str_lower(_str_or(u_var, "u"));
        lyr.u_min = _num_or(u_min, 0.0);
        lyr.u_max = _num_or(u_max, TAU);
        lyr.steps = _clamp(_int_or(steps, 250), 16, 1500);
    }
    return lyr;
}

fn layer_3d_parametric_surface(x_uv, y_uv, z_uv, u_var = "u", u_min = 0.0, u_max = 6.2831853, v_var = "v", v_min = 0.0, v_max = 6.2831853, nu = 20, nv = 16, opts = nil) {
    let lyr = _base_layer("3d_parametric_surface", "3d", opts);
    lyr.x_comp = compile_math_expr(x_uv);
    lyr.y_comp = compile_math_expr(y_uv);
    lyr.z_comp = compile_math_expr(z_uv);
    lyr.u_var = str_lower(_str_or(u_var, "u"));
    lyr.u_min = _num_or(u_min, 0.0);
    lyr.u_max = _num_or(u_max, TAU);
    lyr.v_var = str_lower(_str_or(v_var, "v"));
    lyr.v_min = _num_or(v_min, 0.0);
    lyr.v_max = _num_or(v_max, TAU);
    lyr.nu = _clamp(_int_or(nu, 20), 4, 60);
    lyr.nv = _clamp(_int_or(nv, 16), 4, 60);
    return lyr;
}

fn layer_3d_scatter_quiver(points_xyz, vectors_uvw = nil, opts = nil) {
    let lyr = _base_layer("3d_scatter_quiver", "3d", opts);
    lyr.points_xyz = if is_array(points_xyz) { points_xyz } else { [] };
    lyr.vectors_uvw = if is_array(vectors_uvw) { vectors_uvw } else { nil };
    return lyr;
}

// ── 4D Hyperspace Layers (R^4) ───────────────────────────────────────────────

fn layer_4d_polytope(kind = "tesseract", opts = nil) {
    let lyr = _base_layer("4d_polytope", "4d", opts);
    let poly = _build_4d_polytope(kind);
    lyr.poly_kind = poly.kind;
    lyr.vertices = poly.vertices;
    lyr.edges = poly.edges;
    lyr.faces = poly.faces;
    if lyr.label == "4d_polytope" { lyr.label = "4D " + poly.kind; }
    return lyr;
}

fn layer_4d_hypersurface_slice(w_xyz_expr, bounds_map = nil, slice_axis = "z", slice_val = 0.0, grid_n = 18, opts = nil) {
    let lyr = _base_layer("4d_hypersurface_slice", "4d", opts);
    lyr.w_xyz_expr = w_xyz_expr;
    lyr.w_comp = compile_math_expr(w_xyz_expr);
    let bm = if bounds_map != nil and is_map(bounds_map) { bounds_map } else { map{} };
    lyr.xmin = _num_or(try bm.xmin catch -2.5, -2.5);
    lyr.xmax = _num_or(try bm.xmax catch 2.5, 2.5);
    lyr.ymin = _num_or(try bm.ymin catch -2.5, 2.5);
    if lyr.ymin >= lyr.xmax and not map_has(bm, "ymin") { lyr.ymin = -2.5; }
    lyr.ymax = _num_or(try bm.ymax catch 2.5, 2.5);
    lyr.zmin = _num_or(try bm.zmin catch -2.5, -2.5);
    lyr.zmax = _num_or(try bm.zmax catch 2.5, 2.5);
    lyr.slice_axis = str_lower(_str_or(slice_axis, "z"));
    lyr.slice_val = _num_or(slice_val, 0.0);
    lyr.grid_n = _clamp(_int_or(grid_n, 18), 5, 42);
    return lyr;
}

// ── N-D High-Dimensional Layers (R^N, N >= 5) ────────────────────────────────

fn layer_nd_hypercube(dim_n = 5, opts = nil) {
    let lyr = _base_layer("nd_hypercube", "nd", opts);
    let hc = _build_nd_hypercube(dim_n);
    lyr.dim_n = hc.dim_n;
    lyr.vertices = hc.vertices;
    lyr.edges = hc.edges;
    if lyr.label == "nd_hypercube" { lyr.label = str(hc.dim_n) + "D Hypercube"; }
    return lyr;
}

fn layer_nd_parallel_coords(data_matrix_NxD, axis_names = nil, opts = nil) {
    let lyr = _base_layer("nd_parallel_coords", "nd", opts);
    lyr.data = if is_array(data_matrix_NxD) { data_matrix_NxD } else { [] };
    lyr.axis_names = axis_names;
    lyr.dim_n = if len(lyr.data) > 0 and is_array(lyr.data[0]) { len(lyr.data[0]) } else { 0 };
    return lyr;
}

fn layer_nd_radar(profiles_NxD, axis_names = nil, opts = nil) {
    let lyr = _base_layer("nd_radar", "nd", opts);
    lyr.data = if is_array(profiles_NxD) { profiles_NxD } else { [] };
    lyr.axis_names = axis_names;
    lyr.dim_n = if len(lyr.data) > 0 and is_array(lyr.data[0]) { len(lyr.data[0]) } else { 0 };
    return lyr;
}

fn layer_nd_pca_projection(data_matrix_NxD, labels = nil, target_dim = 3, opts = nil) {
    let lyr = _base_layer("nd_pca_projection", "nd", opts);
    lyr.data = if is_array(data_matrix_NxD) { data_matrix_NxD } else { [] };
    lyr.labels = labels;
    lyr.target_dim = _clamp(_int_or(target_dim, 3), 2, 3);
    lyr.pca_model = compute_pca_subspace(lyr.data, lyr.target_dim);
    lyr.dim_n = lyr.pca_model.dim_d;
    return lyr;
}

fn layer_nd_andrews_curves(data_matrix_NxD, steps = 80, opts = nil) {
    let lyr = _base_layer("nd_andrews_curves", "nd", opts);
    lyr.data = if is_array(data_matrix_NxD) { data_matrix_NxD } else { [] };
    lyr.steps = _clamp(_int_or(steps, 80), 20, 320);
    lyr.dim_n = if len(lyr.data) > 0 and is_array(lyr.data[0]) { len(lyr.data[0]) } else { 0 };
    return lyr;
}

// ── Non-Euclidean & Network Graph Layers ─────────────────────────────────────

fn layer_poincare_disk(geodesic_pairs, opts = nil) {
    let lyr = _base_layer("poincare_disk", "hyperbolic", opts);
    lyr.geodesic_pairs = if is_array(geodesic_pairs) { geodesic_pairs } else { [] };
    return lyr;
}

fn layer_riemann_sphere(complex_pts_or_curve, opts = nil) {
    let lyr = _base_layer("riemann_sphere", "spherical", opts);
    lyr.complex_items = if is_array(complex_pts_or_curve) { complex_pts_or_curve } else { [] };
    return lyr;
}

fn layer_network_graph(nodes, edges, dim = 3, iterations = 40, opts = nil) {
    let lyr = _base_layer("network_graph", if _int_or(dim, 3) >= 3 { "3d" } else { "2d" }, opts);
    let node_list = if is_array(nodes) { nodes } else { [] };
    let edge_list = if is_array(edges) { edges } else { [] };
    let d_space = if _int_or(dim, 3) >= 3 { 3 } else { 2 };
    let iters = _clamp(_int_or(iterations, 40), 1, 200);

    // Deterministic spring-electrical layout in 2D or 3D
    let n_cnt = len(node_list);
    let pos = [];
    let id_map = map{};
    let k = 0;
    while k < n_cnt {
        let nd = node_list[k];
        let nid = if is_map(nd) and map_has(nd, "id") { str(nd.id) } else { str(k) };
        id_map[nid] = k;
        let ang = TAU * k / _max(1, n_cnt);
        let z0 = if d_space == 3 { num_sin(ang * 2.0 + 0.5) * 1.1 } else { 0.0 };
        array_push(pos, [1.8 * num_cos(ang), 1.8 * num_sin(ang), z0]);
        k = k + 1;
    }

    let k_ideal = if n_cnt > 1 { 2.4 / num_sqrt(n_cnt * 1.0) } else { 1.0 };
    let it = 0;
    while it < iters and n_cnt > 1 {
        let disp = [];
        k = 0;
        while k < n_cnt { array_push(disp, [0.0, 0.0, 0.0]); k = k + 1; }

        // Repulsive Coulomb forces
        let a = 0;
        while a < n_cnt {
            let b = a + 1;
            while b < n_cnt {
                let dx = pos[a][0] - pos[b][0];
                let dy = pos[a][1] - pos[b][1];
                let dz = if d_space == 3 { pos[a][2] - pos[b][2] } else { 0.0 };
                let dist2 = dx * dx + dy * dy + dz * dz + 0.02;
                let dist = num_sqrt(dist2);
                let rep = (k_ideal * k_ideal) / dist;
                let fx = (dx / dist) * rep;
                let fy = (dy / dist) * rep;
                let fz = (dz / dist) * rep;
                disp[a][0] = disp[a][0] + fx; disp[a][1] = disp[a][1] + fy; disp[a][2] = disp[a][2] + fz;
                disp[b][0] = disp[b][0] - fx; disp[b][1] = disp[b][1] - fy; disp[b][2] = disp[b][2] - fz;
                b = b + 1;
            }
            a = a + 1;
        }

        // Attractive Hooke spring forces
        let ei = 0;
        while ei < len(edge_list) {
            let ed = edge_list[ei];
            let u_raw = if is_array(ed) { ed[0] } else { try ed.src catch (try ed.u catch 0) };
            let v_raw = if is_array(ed) { ed[1] } else { try ed.dst catch (try ed.v catch 0) };
            let ui = if map_has(id_map, str(u_raw)) { id_map[str(u_raw)] } else { _clamp(_int_or(u_raw, 0), 0, n_cnt - 1) };
            let vi = if map_has(id_map, str(v_raw)) { id_map[str(v_raw)] } else { _clamp(_int_or(v_raw, 0), 0, n_cnt - 1) };
            if ui != vi {
                let dx = pos[ui][0] - pos[vi][0];
                let dy = pos[ui][1] - pos[vi][1];
                let dz = if d_space == 3 { pos[ui][2] - pos[vi][2] } else { 0.0 };
                let dist = num_sqrt(dx * dx + dy * dy + dz * dz + 0.001);
                let att = (dist * dist) / _max(0.2, k_ideal);
                let fx = (dx / dist) * att;
                let fy = (dy / dist) * att;
                let fz = (dz / dist) * att;
                disp[ui][0] = disp[ui][0] - fx; disp[ui][1] = disp[ui][1] - fy; disp[ui][2] = disp[ui][2] - fz;
                disp[vi][0] = disp[vi][0] + fx; disp[vi][1] = disp[vi][1] + fy; disp[vi][2] = disp[vi][2] + fz;
            }
            ei = ei + 1;
        }

        let temp = 0.45 * (1.0 - (it * 1.0) / (iters + 1.0));
        k = 0;
        while k < n_cnt {
            let dm = num_sqrt(disp[k][0] * disp[k][0] + disp[k][1] * disp[k][1] + disp[k][2] * disp[k][2] + 1e-9);
            let step_len = _min(dm, temp);
            pos[k][0] = _clamp(pos[k][0] + (disp[k][0] / dm) * step_len, -2.6, 2.6);
            pos[k][1] = _clamp(pos[k][1] + (disp[k][1] / dm) * step_len, -2.6, 2.6);
            if d_space == 3 {
                pos[k][2] = _clamp(pos[k][2] + (disp[k][2] / dm) * step_len, -2.4, 2.4);
            }
            k = k + 1;
        }
        it = it + 1;
    }

    lyr.nodes = node_list;
    lyr.edges = edge_list;
    lyr.id_map = id_map;
    lyr.positions = pos;
    lyr.net_dim = d_space;
    return lyr;
}

// ============================================================================
// 6. Multi-Dimensional Scene Projection Engine -> Renderer-Agnostic Primitives
// ============================================================================

fn _row_passes_brushes(row, brushes) {
    let bkeys = map_keys(brushes);
    if len(bkeys) == 0 { return true; }
    let bi = 0;
    while bi < len(bkeys) {
        let br = brushes[bkeys[bi]];
        let d_idx = br.dim;
        if d_idx >= 0 and d_idx < len(row) {
            let v = _num_or(row[d_idx], 0.0);
            if v < br.lo or v > br.hi { return false; }
        }
        bi = bi + 1;
    }
    return true;
}

fn _ensure_rotor_dim(st, req_n) {
    let cur_n = len(st.rotor_nd);
    if cur_n >= req_n { return; }
    let next_m = _eye_mat(req_n);
    let r = 0;
    while r < cur_n {
        let c = 0;
        while c < cur_n {
            next_m[r][c] = st.rotor_nd[r][c];
            c = c + 1;
        }
        r = r + 1;
    }
    st.rotor_nd = next_m;
}

fn _quantile_sorted(sorted_arr, q) {
    let n = len(sorted_arr);
    if n == 0 { return 0.0; }
    if n == 1 { return sorted_arr[0]; }
    let pos = _clamp(q, 0.0, 1.0) * (n - 1);
    let lo = num_floor(pos);
    let hi = _min(n - 1, lo + 1);
    let frac = pos - lo;
    return sorted_arr[lo] + frac * (sorted_arr[hi] - sorted_arr[lo]);
}

fn _wx(x, b2d, vp) {
    let span = _max(1e-9, b2d.xmax - b2d.xmin);
    return vp.x + ((x - b2d.xmin) / span) * vp.w;
}

fn _wy(y, b2d, vp) {
    let span = _max(1e-9, b2d.ymax - b2d.ymin);
    return vp.y + vp.h - ((y - b2d.ymin) / span) * vp.h;
}

fn _merge_env(base_env, extra_env) {
    let m = map{ t: 0.0, omega: 2.2, a: 1.0, b: 1.0, k: 1.0 };
    if base_env != nil and is_map(base_env) {
        let ks = map_keys(base_env);
        let i = 0;
        while i < len(ks) { let key = ks[i]; m[key] = base_env[key]; i = i + 1; }
    }
    if extra_env != nil and is_map(extra_env) {
        let ks2 = map_keys(extra_env);
        let j = 0;
        while j < len(ks2) { let key2 = ks2[j]; m[key2] = extra_env[key2]; j = j + 1; }
    }
    return m;
}

fn _compile_scene_primitives(st, width = 880, height = 540, extra_env = nil) {
    let w = _max(32, _int_or(width, 880));
    let h = _max(32, _int_or(height, 540));
    let th = graph_theme(st.dark_mode);
    let env = _merge_env(st.env, extra_env);

    let compact = _bool_or(st.compact, false);
    let pad_l = if compact { 44 } else { 58 };
    let pad_r = if compact { 18 } else { 26 };
    let pad_t = if st.title != "" { (if compact { 34 } else { 44 }) } else { 20 };
    let pad_b = if compact { 30 } else { 40 };
    let vp = map{
        x: pad_l,
        y: pad_t,
        w: _max(60, w - pad_l - pad_r),
        h: _max(50, h - pad_t - pad_b)
    };
    vp.cx = vp.x + vp.w * 0.5;
    vp.cy = vp.y + vp.h * 0.52;

    let rects = [];
    let lines = [];
    let polygons = [];
    let circles = [];
    let texts = [];
    let tooltips = [];
    let depth_queue = [];

    // Plot card frame
    array_push(rects, map{ x: vp.x, y: vp.y, w: vp.w, h: vp.h, color: th.card, radius: 6, stroke_color: th.border });

    if st.title != "" {
        array_push(texts, map{ x: pad_l, y: 12, text: st.title, color: th.text, px: if compact { 13 } else { 15 }, align: "left" });
    }
    if st.subtitle != "" {
        array_push(texts, map{ x: w - pad_r, y: 14, text: st.subtitle, color: th.text_muted, px: 11, align: "right" });
    }

    // Inspect visible layers to decide background coordinate frame
    let vis_layers = [];
    let has_cartesian_2d = false;
    let has_3d_stage = false;
    let pca_stats = nil;
    let li = 0;
    while li < len(st.layers) {
        let lyr = st.layers[li];
        if lyr.visible {
            array_push(vis_layers, lyr);
            let knd = lyr.kind;
            if knd == "2d_explicit" or knd == "scatter_regression" or knd == "2d_parametric"
                or knd == "2d_polar" or knd == "2d_implicit" or knd == "2d_contour_heatmap"
                or knd == "2d_vector_field" or knd == "complex_domain"
                or (knd == "network_graph" and lyr.net_dim == 2)
                or (knd == "nd_pca_projection" and lyr.target_dim == 2) {
                has_cartesian_2d = true;
            }
            if lyr.space == "3d" or lyr.space == "4d" or lyr.space == "spherical"
                or knd == "nd_hypercube" or (knd == "nd_pca_projection" and lyr.target_dim == 3) {
                has_3d_stage = true;
            }
        }
        li = li + 1;
    }

    let b2d = map{
        xmin: st.bounds_2d.xmin,
        xmax: st.bounds_2d.xmax,
        ymin: st.bounds_2d.ymin,
        ymax: st.bounds_2d.ymax
    };

    // Draw Cartesian 2D Grid & Axes when active
    if has_cartesian_2d and st.show_grid {
        let gx_steps = 8;
        let gy_steps = 6;
        let gi = 1;
        while gi < gx_steps {
            let xv = b2d.xmin + (b2d.xmax - b2d.xmin) * gi / gx_steps;
            let sx = _wx(xv, b2d, vp);
            array_push(lines, map{ x1: sx, y1: vp.y, x2: sx, y2: vp.y + vp.h, color: th.grid, width: 1, dashed: false });
            array_push(texts, map{ x: sx - 10, y: vp.y + vp.h + 6, text: _fmt_num(xv, 1), color: th.text_muted, px: 10, align: "center" });
            gi = gi + 1;
        }
        let gj = 1;
        while gj < gy_steps {
            let yv = b2d.ymin + (b2d.ymax - b2d.ymin) * gj / gy_steps;
            let sy = _wy(yv, b2d, vp);
            array_push(lines, map{ x1: vp.x, y1: sy, x2: vp.x + vp.w, y2: sy, color: th.grid, width: 1, dashed: false });
            array_push(texts, map{ x: vp.x - 6, y: sy - 5, text: _fmt_num(yv, 1), color: th.text_muted, px: 10, align: "right" });
            gj = gj + 1;
        }
        if st.show_axes {
            if b2d.xmin <= 0.0 and b2d.xmax >= 0.0 {
                let x0_px = _wx(0.0, b2d, vp);
                array_push(lines, map{ x1: x0_px, y1: vp.y, x2: x0_px, y2: vp.y + vp.h, color: th.axis, width: 1.6, dashed: false });
            }
            if b2d.ymin <= 0.0 and b2d.ymax >= 0.0 {
                let y0_px = _wy(0.0, b2d, vp);
                array_push(lines, map{ x1: vp.x, y1: y0_px, x2: vp.x + vp.w, y2: y0_px, color: th.axis, width: 1.6, dashed: false });
            }
        }
    }

    // Draw 3D Reference Triad when 3D/4D/Spherical/ND-3D stage is active
    if has_3d_stage and st.show_axes {
        let orig3 = _project_3d_point(0.0, 0.0, 0.0, st.cam_3d, vp);
        let ax_x = _project_3d_point(2.4, 0.0, 0.0, st.cam_3d, vp);
        let ax_y = _project_3d_point(0.0, 2.4, 0.0, st.cam_3d, vp);
        let ax_z = _project_3d_point(0.0, 0.0, 2.4, st.cam_3d, vp);
        array_push(depth_queue, map{ ptype: "line", z_depth: (orig3.z_depth + ax_x.z_depth) * 0.5 - 4.0, x1: orig3.sx, y1: orig3.sy, x2: ax_x.sx, y2: ax_x.sy, color: [251, 113, 133, 185], width: 1.4, dashed: false });
        array_push(depth_queue, map{ ptype: "line", z_depth: (orig3.z_depth + ax_y.z_depth) * 0.5 - 4.0, x1: orig3.sx, y1: orig3.sy, x2: ax_y.sx, y2: ax_y.sy, color: [16, 229, 155, 185], width: 1.4, dashed: false });
        array_push(depth_queue, map{ ptype: "line", z_depth: (orig3.z_depth + ax_z.z_depth) * 0.5 - 4.0, x1: orig3.sx, y1: orig3.sy, x2: ax_z.sx, y2: ax_z.sy, color: [34, 211, 238, 185], width: 1.4, dashed: false });
        array_push(texts, map{ x: ax_x.sx + 4, y: ax_x.sy - 6, text: "X", color: th.coral, px: 11, align: "left" });
        array_push(texts, map{ x: ax_y.sx + 4, y: ax_y.sy - 6, text: "Y", color: th.emerald, px: 11, align: "left" });
        array_push(texts, map{ x: ax_z.sx + 4, y: ax_z.sy - 6, text: "Z", color: th.cyan, px: 11, align: "left" });
    }

    // Compile each visible layer
    let v_idx = 0;
    while v_idx < len(vis_layers) {
        let lyr = vis_layers[v_idx];
        let knd = lyr.kind;
        let base_col = if lyr.color != nil { color_to_rgba(lyr.color, 255) } else { _series_palette(v_idx) };

        // ── 1. 1D Number Line & Interval Sets ────────────────────────────────
        if knd == "number_line" {
            let mid_y = vp.y + vp.h * 0.58;
            let nl_min = b2d.xmin;
            let nl_max = b2d.xmax;
            array_push(lines, map{ x1: vp.x + 16, y1: mid_y, x2: vp.x + vp.w - 16, y2: mid_y, color: th.axis, width: 2.0, dashed: false });
            let tk = num_ceil(nl_min);
            while tk <= num_floor(nl_max) {
                let tx = _wx(tk, b2d, vp);
                array_push(lines, map{ x1: tx, y1: mid_y - 6, x2: tx, y2: mid_y + 6, color: th.axis, width: 1.3, dashed: false });
                array_push(texts, map{ x: tx - 6, y: mid_y + 12, text: _fmt_num(tk, 0), color: th.text_muted, px: 11, align: "center" });
                tk = tk + 1;
            }
            let ii = 0;
            while ii < len(lyr.items) {
                let it = lyr.items[ii];
                let lane_y = mid_y - 22 - ii * 24;
                let ic = _series_palette(ii);
                if type(it) == "number" {
                    let px = _wx(it, b2d, vp);
                    array_push(circles, map{ cx: px, cy: mid_y, r: 5.5, fill_color: ic, stroke_color: ic, stroke_width: 2.0, hollow: false, tooltip: "x = " + _fmt_num(it, 2) });
                } else if is_array(it) and len(it) >= 2 {
                    let sx1 = _wx(_clamp(_num_or(it[0], nl_min), nl_min, nl_max), b2d, vp);
                    let sx2 = _wx(_clamp(_num_or(it[1], nl_max), nl_min, nl_max), b2d, vp);
                    array_push(lines, map{ x1: sx1, y1: lane_y, x2: sx2, y2: lane_y, color: ic, width: 3.5, dashed: false });
                    array_push(circles, map{ cx: sx1, cy: lane_y, r: 5.0, fill_color: ic, stroke_color: ic, stroke_width: 2.0, hollow: false, tooltip: _fmt_num(it[0], 2) });
                    array_push(circles, map{ cx: sx2, cy: lane_y, r: 5.0, fill_color: ic, stroke_color: ic, stroke_width: 2.0, hollow: false, tooltip: _fmt_num(it[1], 2) });
                } else if is_map(it) {
                    if map_has(it, "val") {
                        let pv = _num_or(it.val, 0.0);
                        let px = _wx(pv, b2d, vp);
                        let is_op = _bool_or(try it.open catch false, false);
                        array_push(circles, map{ cx: px, cy: lane_y, r: 5.5, fill_color: if is_op { th.card } else { ic }, stroke_color: ic, stroke_width: 2.2, hollow: is_op, tooltip: _str_or(try it.label catch "", "x=" + _fmt_num(pv, 2)) });
                    } else {
                        let lo_v = _clamp(_num_or(try it.lo catch nl_min, nl_min), nl_min, nl_max);
                        let hi_v = _clamp(_num_or(try it.hi catch nl_max, nl_max), nl_min, nl_max);
                        let lo_op = _bool_or(try it.lo_open catch false, false);
                        let hi_op = _bool_or(try it.hi_open catch false, false);
                        let sx1 = _wx(lo_v, b2d, vp);
                        let sx2 = _wx(hi_v, b2d, vp);
                        array_push(lines, map{ x1: sx1, y1: lane_y, x2: sx2, y2: lane_y, color: ic, width: 3.5, dashed: false });
                        array_push(circles, map{ cx: sx1, cy: lane_y, r: 5.2, fill_color: if lo_op { th.card } else { ic }, stroke_color: ic, stroke_width: 2.2, hollow: lo_op, tooltip: _fmt_num(lo_v, 2) });
                        array_push(circles, map{ cx: sx2, cy: lane_y, r: 5.2, fill_color: if hi_op { th.card } else { ic }, stroke_color: ic, stroke_width: 2.2, hollow: hi_op, tooltip: _fmt_num(hi_v, 2) });
                        let lbl = _str_or(try it.label catch "", "");
                        if lbl != "" {
                            array_push(texts, map{ x: (sx1 + sx2) * 0.5 - 16, y: lane_y - 16, text: lbl, color: ic, px: 11, align: "center" });
                        }
                    }
                }
                ii = ii + 1;
            }

        // ── 2. 1D Histogram + Smooth Gaussian KDE ────────────────────────────
        } else if knd == "histogram_kde" {
            let vals = lyr.values;
            let n = len(vals);
            if n > 0 {
                let vmin = _num_or(vals[0], 0.0);
                let vmax = vmin;
                let sum_v = 0.0;
                let k = 0;
                while k < n {
                    let v = _num_or(vals[k], 0.0);
                    if v < vmin { vmin = v; }
                    if v > vmax { vmax = v; }
                    sum_v = sum_v + v;
                    k = k + 1;
                }
                if vmax - vmin < 1e-6 { vmin = vmin - 1.0; vmax = vmax + 1.0; }
                let mean_v = sum_v / n;
                let ss = 0.0;
                k = 0;
                while k < n {
                    let dv = _num_or(vals[k], 0.0) - mean_v;
                    ss = ss + dv * dv;
                    k = k + 1;
                }
                let sd = num_sqrt(_max(1e-6, ss / _max(1, n - 1)));
                let bw = if lyr.bandwidth != nil and lyr.bandwidth > 0.0 { lyr.bandwidth } else { _max(0.08 * (vmax - vmin), 1.06 * sd * num_pow(n * 1.0, -0.2)) };

                let nbins = lyr.bins;
                let counts = [];
                let b = 0;
                while b < nbins { array_push(counts, 0); b = b + 1; }
                let bin_w = (vmax - vmin) / nbins;
                k = 0;
                while k < n {
                    let bi = _clamp(num_floor((_num_or(vals[k], 0.0) - vmin) / bin_w), 0, nbins - 1);
                    counts[bi] = counts[bi] + 1;
                    k = k + 1;
                }
                let max_dens = 1e-6;
                b = 0;
                while b < nbins {
                    let d_bin = counts[b] / (n * bin_w);
                    if d_bin > max_dens { max_dens = d_bin; }
                    b = b + 1;
                }
                // Evaluate KDE curve across 80 points
                let kde_pts = [];
                let ks = 0;
                let kde_steps = 80;
                while ks <= kde_steps {
                    let xv = vmin - 0.1 * (vmax - vmin) + 1.2 * (vmax - vmin) * ks / kde_steps;
                    let acc = 0.0;
                    k = 0;
                    while k < n {
                        let u = (xv - _num_or(vals[k], 0.0)) / bw;
                        acc = acc + num_exp(-0.5 * u * u) * 0.3989422804014327;
                        k = k + 1;
                    }
                    let dens = acc / (n * bw);
                    if dens > max_dens { max_dens = dens; }
                    array_push(kde_pts, [xv, dens]);
                    ks = ks + 1;
                }
                let x_lo = vmin - 0.1 * (vmax - vmin);
                let x_hi = vmax + 0.1 * (vmax - vmin);
                let hb = map{ xmin: x_lo, xmax: x_hi, ymin: 0.0, ymax: max_dens * 1.15 };
                let fill_bar = [base_col[0], base_col[1], base_col[2], 145];
                b = 0;
                while b < nbins {
                    let bx0 = vmin + b * bin_w;
                    let bx1 = bx0 + bin_w;
                    let d_bin = counts[b] / (n * bin_w);
                    let sx0 = _wx(bx0, hb, vp) + 1;
                    let sx1 = _wx(bx1, hb, vp) - 1;
                    let sy_top = _wy(d_bin, hb, vp);
                    let sy_bot = _wy(0.0, hb, vp);
                    array_push(rects, map{
                        x: sx0, y: sy_top, w: _max(2, sx1 - sx0), h: _max(1, sy_bot - sy_top),
                        color: fill_bar, radius: 2, stroke_color: base_col,
                        tooltip: "[" + _fmt_num(bx0, 2) + ", " + _fmt_num(bx1, 2) + "): n=" + str(counts[b])
                    });
                    b = b + 1;
                }
                ks = 1;
                while ks < len(kde_pts) {
                    array_push(lines, map{
                        x1: _wx(kde_pts[ks - 1][0], hb, vp), y1: _wy(kde_pts[ks - 1][1], hb, vp),
                        x2: _wx(kde_pts[ks][0], hb, vp), y2: _wy(kde_pts[ks][1], hb, vp),
                        color: th.cyan, width: 2.4, dashed: false
                    });
                    ks = ks + 1;
                }
                array_push(texts, map{ x: vp.x + 10, y: vp.y + 10, text: "Ιστόγραμμα + KDE (n=" + str(n) + ", x̄=" + _fmt_num(mean_v, 2) + ", s=" + _fmt_num(sd, 2) + ")", color: th.emerald, px: 11, align: "left" });
            }

        // ── 3. 1D Tukey Boxplot (Q1, Median, Q3, 1.5 IQR Whiskers & Outliers) ─
        } else if knd == "boxplot" {
            let groups = [];
            let raw = lyr.groups_raw;
            if is_map(raw) {
                let gkeys = map_keys(raw);
                let gi = 0;
                while gi < len(gkeys) {
                    let gk = gkeys[gi];
                    array_push(groups, map{ name: gk, values: raw[gk] });
                    gi = gi + 1;
                }
            } else if is_array(raw) {
                if len(raw) > 0 and type(raw[0]) == "number" {
                    array_push(groups, map{ name: lyr.label, values: raw });
                } else {
                    let gi = 0;
                    while gi < len(raw) {
                        let g = raw[gi];
                        if is_map(g) { array_push(groups, g); }
                        else if is_array(g) { array_push(groups, map{ name: "Ομάδα " + str(gi + 1), values: g }); }
                        gi = gi + 1;
                    }
                }
            }
            if len(groups) > 0 {
                let gmin = 1e18; let gmax = -1e18;
                let gi = 0;
                while gi < len(groups) {
                    let gv = groups[gi].values;
                    let k = 0;
                    while k < len(gv) {
                        let v = _num_or(gv[k], 0.0);
                        if v < gmin { gmin = v; }
                        if v > gmax { gmax = v; }
                        k = k + 1;
                    }
                    gi = gi + 1;
                }
                if gmax <= gmin { gmin = gmin - 1.0; gmax = gmax + 1.0; }
                let pad_v = (gmax - gmin) * 0.14;
                let bb = map{ xmin: 0.0, xmax: len(groups) * 1.0, ymin: gmin - pad_v, ymax: gmax + pad_v };
                gi = 0;
                while gi < len(groups) {
                    let gv = array_sort(groups[gi].values);
                    if len(gv) > 0 {
                        let q1 = _quantile_sorted(gv, 0.25);
                        let med = _quantile_sorted(gv, 0.50);
                        let q3 = _quantile_sorted(gv, 0.75);
                        let iqr = q3 - q1;
                        let lo_fence = q1 - 1.5 * iqr;
                        let hi_fence = q3 + 1.5 * iqr;
                        let w_lo = q1; let w_hi = q3;
                        let outliers = [];
                        let k = 0;
                        while k < len(gv) {
                            let v = gv[k];
                            if v < lo_fence or v > hi_fence { array_push(outliers, v); }
                            else {
                                if v < w_lo { w_lo = v; }
                                if v > w_hi { w_hi = v; }
                            }
                            k = k + 1;
                        }
                        let cx_px = _wx(gi + 0.5, bb, vp);
                        let bw_px = _min(58, (vp.w / len(groups)) * 0.42);
                        let y_q1 = _wy(q1, bb, vp);
                        let y_q3 = _wy(q3, bb, vp);
                        let y_med = _wy(med, bb, vp);
                        let y_wlo = _wy(w_lo, bb, vp);
                        let y_whi = _wy(w_hi, bb, vp);
                        let gc = _series_palette(gi);
                        array_push(lines, map{ x1: cx_px, y1: y_whi, x2: cx_px, y2: y_q3, color: gc, width: 1.8, dashed: false });
                        array_push(lines, map{ x1: cx_px, y1: y_q1, x2: cx_px, y2: y_wlo, color: gc, width: 1.8, dashed: false });
                        array_push(lines, map{ x1: cx_px - bw_px * 0.3, y1: y_whi, x2: cx_px + bw_px * 0.3, y2: y_whi, color: gc, width: 1.8, dashed: false });
                        array_push(lines, map{ x1: cx_px - bw_px * 0.3, y1: y_wlo, x2: cx_px + bw_px * 0.3, y2: y_wlo, color: gc, width: 1.8, dashed: false });
                        array_push(rects, map{
                            x: cx_px - bw_px * 0.5, y: y_q3, w: bw_px, h: _max(2, y_q1 - y_q3),
                            color: [gc[0], gc[1], gc[2], 95], radius: 3, stroke_color: gc,
                            tooltip: groups[gi].name + " | Q1=" + _fmt_num(q1, 2) + " Med=" + _fmt_num(med, 2) + " Q3=" + _fmt_num(q3, 2)
                        });
                        array_push(lines, map{ x1: cx_px - bw_px * 0.5, y1: y_med, x2: cx_px + bw_px * 0.5, y2: y_med, color: th.amber, width: 2.6, dashed: false });
                        let oi = 0;
                        while oi < len(outliers) {
                            array_push(circles, map{ cx: cx_px, cy: _wy(outliers[oi], bb, vp), r: 4.5, fill_color: th.coral, stroke_color: th.coral, stroke_width: 1.5, hollow: false, tooltip: "Ακραία τιμή: " + _fmt_num(outliers[oi], 2) });
                            oi = oi + 1;
                        }
                        array_push(texts, map{ x: cx_px - 20, y: vp.y + vp.h + 8, text: groups[gi].name, color: th.text_sec, px: 11, align: "center" });
                    }
                    gi = gi + 1;
                }
            }

        // ── 4. Statistical Deviation Bars (x_i, Mean x̄, ±1s Zone & Stems) ────
        } else if knd == "deviation_bars" {
            let vals = lyr.values;
            let n = len(vals);
            if n > 0 {
                let sum_v = 0.0;
                let vmax = _num_or(vals[0], 0.0);
                let vmin = _min(0.0, vmax);
                let k = 0;
                while k < n {
                    let v = _num_or(vals[k], 0.0);
                    sum_v = sum_v + v;
                    if v > vmax { vmax = v; }
                    if v < vmin { vmin = v; }
                    k = k + 1;
                }
                let mean_v = sum_v / n;
                let ss = 0.0;
                k = 0;
                while k < n {
                    let d = _num_or(vals[k], 0.0) - mean_v;
                    ss = ss + d * d;
                    k = k + 1;
                }
                let denom = if lyr.is_sample and n > 1 { (n - 1) * 1.0 } else { _max(1.0, n * 1.0) };
                let sd = num_sqrt(ss / denom);
                let y_hi = _max(vmax, mean_v + sd) * 1.18 + 0.5;
                let y_lo = _min(0.0, _min(vmin, mean_v - sd) * 1.1);
                let db = map{ xmin: 0.0, xmax: n * 1.0, ymin: y_lo, ymax: y_hi };

                // Shaded ±1s zone [x̄ - s, x̄ + s]
                let y_plus_s = _wy(mean_v + sd, db, vp);
                let y_minus_s = _wy(_max(y_lo, mean_v - sd), db, vp);
                array_push(rects, map{
                    x: vp.x + 2, y: y_plus_s, w: vp.w - 4, h: _max(2, y_minus_s - y_plus_s),
                    color: [16, 229, 155, 36], radius: 0,
                    tooltip: "Ζώνη ±1s: [" + _fmt_fixed(mean_v - sd, 2) + ", " + _fmt_fixed(mean_v + sd, 2) + "]"
                });

                let y0_px = _wy(0.0, db, vp);
                let y_mean_px = _wy(mean_v, db, vp);
                let slot_w = vp.w / n;
                let bar_w = _clamp(slot_w * 0.52, 8.0, 52.0);

                k = 0;
                while k < n {
                    let xi = _num_or(vals[k], 0.0);
                    let dev = xi - mean_v;
                    let dev2 = dev * dev;
                    let cx_px = vp.x + (k + 0.5) * slot_w;
                    let y_xi = _wy(xi, db, vp);
                    let b_top = _min(y_xi, y0_px);
                    let b_h = _max(2.0, _abs(y0_px - y_xi));
                    let tip = "Σημείο x" + str(k + 1) + " = " + _fmt_fixed(xi, 2) + " | Απόκλιση = " + _fmt_fixed(dev, 2) + " | Τετράγωνο = " + _fmt_fixed(dev2, 2);
                    array_push(rects, map{
                        x: cx_px - bar_w * 0.5, y: b_top, w: bar_w, h: b_h,
                        color: [147, 197, 253, 180], radius: 4, stroke_color: th.periwinkle,
                        tooltip: tip
                    });
                    // Dashed residual stem from x_i to x̄
                    array_push(lines, map{ x1: cx_px, y1: y_xi, x2: cx_px, y2: y_mean_px, color: th.amber, width: 1.8, dashed: true });
                    array_push(circles, map{ cx: cx_px, cy: y_xi, r: 4.0, fill_color: th.cyan, stroke_color: th.cyan, stroke_width: 1.5, hollow: false, tooltip: tip });
                    array_push(tooltips, map{ x: cx_px, y: y_xi, r: 8, text: tip });
                    array_push(texts, map{ x: cx_px - 8, y: vp.y + vp.h + 6, text: "x" + str(k + 1), color: th.text_muted, px: 10, align: "center" });
                    k = k + 1;
                }
                // Horizontal green mean line x̄
                array_push(lines, map{ x1: vp.x, y1: y_mean_px, x2: vp.x + vp.w, y2: y_mean_px, color: th.emerald, width: 2.4, dashed: false });
                array_push(texts, map{ x: vp.x + 8, y: _max(vp.y + 6, y_mean_px - 16), text: "x̄ = " + _fmt_fixed(mean_v, 2) + "  (±1s = " + _fmt_fixed(sd, 2) + ")", color: th.emerald, px: 11, align: "left" });
            }

        // ── 5. 2D Explicit Function y = f(x) + Integral + Tangent + Roots ────
        } else if knd == "2d_explicit" {
            let x_lo = if lyr.xmin != nil { _max(b2d.xmin, lyr.xmin) } else { b2d.xmin };
            let x_hi = if lyr.xmax != nil { _min(b2d.xmax, lyr.xmax) } else { b2d.xmax };
            let steps = _clamp(_int_or(try lyr.opts.steps catch 240, 240), 32, 1000);
            if x_hi > x_lo {
                // Optional shaded integral [a, b]
                let ib = try lyr.opts.integral_bounds catch nil;
                if is_array(ib) and len(ib) >= 2 {
                    let ia = _max(x_lo, _num_or(ib[0], x_lo));
                    let ib_hi = _min(x_hi, _num_or(ib[1], x_hi));
                    if ib_hi > ia {
                        let i_steps = 48;
                        let poly_pts = [[_wx(ia, b2d, vp), _wy(0.0, b2d, vp)]];
                        let s_idx = 0;
                        while s_idx <= i_steps {
                            let ix = ia + (ib_hi - ia) * s_idx / i_steps;
                            env.x = ix;
                            let iy = eval_compiled_expr(lyr.compiled, env);
                            if _is_finite(iy) {
                                array_push(poly_pts, [_wx(ix, b2d, vp), _wy(_clamp(iy, b2d.ymin, b2d.ymax), b2d, vp)]);
                            }
                            s_idx = s_idx + 1;
                        }
                        array_push(poly_pts, [_wx(ib_hi, b2d, vp), _wy(0.0, b2d, vp)]);
                        array_push(polygons, map{
                            points: poly_pts,
                            fill_color: [base_col[0], base_col[1], base_col[2], 58],
                            stroke_color: [base_col[0], base_col[1], base_col[2], 120],
                            stroke_width: 1.0,
                            tooltip: "∫ f(x) dx [" + _fmt_num(ia, 2) + ", " + _fmt_num(ib_hi, 2) + "]"
                        });
                    }
                }

                let prev_ok = false;
                let prev_x = 0.0; let prev_y = 0.0;
                let prev_sx = 0.0; let prev_sy = 0.0;
                let prev_slope = 0.0; let has_slope = false;
                let show_roots = _bool_or(try lyr.opts.show_roots catch false, false);
                let show_extrema = _bool_or(try lyr.opts.show_extrema catch false, false);
                let y_span = _max(1e-6, b2d.ymax - b2d.ymin);

                let s_i = 0;
                while s_i <= steps {
                    let xv = x_lo + (x_hi - x_lo) * s_i / steps;
                    env.x = xv;
                    let yv = eval_compiled_expr(lyr.compiled, env);
                    if _is_finite(yv) and _abs(yv) < 1e6 {
                        let sx = _wx(xv, b2d, vp);
                        let sy = _wy(yv, b2d, vp);
                        if prev_ok and _abs(yv - prev_y) < y_span * 2.8 {
                            if (yv >= b2d.ymin and yv <= b2d.ymax) or (prev_y >= b2d.ymin and prev_y <= b2d.ymax) {
                                array_push(lines, map{
                                    x1: prev_sx, y1: _clamp(prev_sy, vp.y, vp.y + vp.h),
                                    x2: sx, y2: _clamp(sy, vp.y, vp.y + vp.h),
                                    color: base_col, width: 2.3, dashed: false
                                });
                            }
                            if show_roots and ((prev_y <= 0.0 and yv >= 0.0) or (prev_y >= 0.0 and yv <= 0.0)) and _abs(yv - prev_y) < y_span {
                                let rx = if _abs(yv - prev_y) > 1e-12 { prev_x - prev_y * (xv - prev_x) / (yv - prev_y) } else { xv };
                                array_push(circles, map{ cx: _wx(rx, b2d, vp), cy: _wy(0.0, b2d, vp), r: 4.5, fill_color: th.amber, stroke_color: th.amber, stroke_width: 1.5, hollow: false, tooltip: "Ρίζα x ≈ " + _fmt_num(rx, 3) });
                            }
                            let cur_slope = yv - prev_y;
                            if show_extrema and has_slope and ((prev_slope > 0.0 and cur_slope <= 0.0) or (prev_slope < 0.0 and cur_slope >= 0.0)) {
                                if prev_y >= b2d.ymin and prev_y <= b2d.ymax {
                                    array_push(circles, map{ cx: prev_sx, cy: prev_sy, r: 4.2, fill_color: th.coral, stroke_color: th.coral, stroke_width: 1.5, hollow: false, tooltip: "Ακρότατο (" + _fmt_num(prev_x, 2) + ", " + _fmt_num(prev_y, 2) + ")" });
                                }
                            }
                            prev_slope = cur_slope;
                            has_slope = true;
                        } else {
                            has_slope = false;
                        }
                        prev_x = xv; prev_y = yv;
                        prev_sx = sx; prev_sy = sy;
                        prev_ok = true;
                    } else {
                        prev_ok = false;
                        has_slope = false;
                    }
                    s_i = s_i + 1;
                }

                // Optional moving tangent line at x0
                let tx0 = try lyr.opts.tangent_x catch nil;
                if tx0 != nil {
                    let x0 = _num_or(tx0, 0.0);
                    let h_eps = 1e-4;
                    env.x = x0; let y0 = eval_compiled_expr(lyr.compiled, env);
                    env.x = x0 + h_eps; let yp = eval_compiled_expr(lyr.compiled, env);
                    env.x = x0 - h_eps; let ym = eval_compiled_expr(lyr.compiled, env);
                    if _is_finite(y0) and _is_finite(yp) and _is_finite(ym) {
                        let slope = (yp - ym) / (2.0 * h_eps);
                        let dx_tan = (b2d.xmax - b2d.xmin) * 0.24;
                        let tx1 = x0 - dx_tan; let ty1 = y0 - slope * dx_tan;
                        let tx2 = x0 + dx_tan; let ty2 = y0 + slope * dx_tan;
                        array_push(lines, map{ x1: _wx(tx1, b2d, vp), y1: _clamp(_wy(ty1, b2d, vp), vp.y, vp.y + vp.h), x2: _wx(tx2, b2d, vp), y2: _clamp(_wy(ty2, b2d, vp), vp.y, vp.y + vp.h), color: th.amber, width: 1.9, dashed: true });
                        array_push(circles, map{ cx: _wx(x0, b2d, vp), cy: _clamp(_wy(y0, b2d, vp), vp.y, vp.y + vp.h), r: 5.0, fill_color: th.amber, stroke_color: th.card, stroke_width: 1.5, hollow: false, tooltip: "Εφαπτομένη στο x₀=" + _fmt_num(x0, 2) + ", f'(x₀)=" + _fmt_num(slope, 2) });
                    }
                }
            }

        // ── 6. Grouped Vertical & Horizontal Bars (CV, CV², D & CV% Bars) ────
        } else if knd == "bar_grouped" {
            let cats = lyr.categories;
            let s_list = lyr.series_list;
            let n_cat = len(cats);
            let n_ser = len(s_list);
            if n_cat > 0 and n_ser > 0 {
                let vmax = 1e-6;
                let si = 0;
                while si < n_ser {
                    let sv = if is_map(s_list[si]) { s_list[si].values } else { s_list[si] };
                    let ci = 0;
                    while ci < len(sv) {
                        let v = _abs(_num_or(sv[ci], 0.0));
                        if v > vmax { vmax = v; }
                        ci = ci + 1;
                    }
                    si = si + 1;
                }
                vmax = vmax * 1.18;
                if lyr.horizontal {
                    let row_h = vp.h / n_cat;
                    let sub_h = _clamp((row_h * 0.68) / n_ser, 6.0, 28.0);
                    let ci = 0;
                    while ci < n_cat {
                        let base_y = vp.y + ci * row_h + row_h * 0.16;
                        array_push(texts, map{ x: vp.x - 6, y: base_y + sub_h * 0.3, text: str(cats[ci]), color: th.text_sec, px: 11, align: "right" });
                        si = 0;
                        while si < n_ser {
                            let s_obj = s_list[si];
                            let s_vals = if is_map(s_obj) { s_obj.values } else { s_obj };
                            let s_name = if is_map(s_obj) and map_has(s_obj, "name") { str(s_obj.name) } else { "S" + str(si + 1) };
                            let scol = if is_map(s_obj) and map_has(s_obj, "color") { color_to_rgba(s_obj.color, 220) } else { _series_palette(si) };
                            let val = if ci < len(s_vals) { _max(0.0, _num_or(s_vals[ci], 0.0)) } else { 0.0 };
                            let bw_px = _max(2.0, (val / vmax) * (vp.w - 48));
                            let ry = base_y + si * (sub_h + 2);
                            array_push(rects, map{ x: vp.x + 2, y: ry, w: bw_px, h: sub_h, color: scol, radius: 3, tooltip: str(cats[ci]) + " (" + s_name + "): " + _fmt_fixed(val, 2) });
                            array_push(texts, map{ x: vp.x + bw_px + 8, y: ry + 1, text: _fmt_fixed(val, 1) + "%", color: scol, px: 10, align: "left" });
                            si = si + 1;
                        }
                        ci = ci + 1;
                    }
                } else {
                    let grp_w = vp.w / n_cat;
                    let bar_w = _clamp((grp_w * 0.68) / n_ser, 6.0, 42.0);
                    let ci = 0;
                    while ci < n_cat {
                        let grp_x = vp.x + ci * grp_w + (grp_w - bar_w * n_ser - (n_ser - 1) * 3) * 0.5;
                        si = 0;
                        while si < n_ser {
                            let s_obj = s_list[si];
                            let s_vals = if is_map(s_obj) { s_obj.values } else { s_obj };
                            let s_name = if is_map(s_obj) and map_has(s_obj, "name") { str(s_obj.name) } else { "S" + str(si + 1) };
                            let scol = if is_map(s_obj) and map_has(s_obj, "color") { color_to_rgba(s_obj.color, 225) } else { _series_palette(si) };
                            let val = if ci < len(s_vals) { _max(0.0, _num_or(s_vals[ci], 0.0)) } else { 0.0 };
                            let bh_px = _max(2.0, (val / vmax) * (vp.h - 24));
                            let bx = grp_x + si * (bar_w + 3);
                            let by = vp.y + vp.h - bh_px;
                            array_push(rects, map{ x: bx, y: by, w: bar_w, h: bh_px, color: scol, radius: 3, tooltip: str(cats[ci]) + " • " + s_name + " = " + _fmt_fixed(val, 3) });
                            array_push(texts, map{ x: bx + bar_w * 0.5 - 10, y: by - 14, text: _fmt_num(val, 2), color: scol, px: 10, align: "center" });
                            si = si + 1;
                        }
                        array_push(texts, map{ x: vp.x + (ci + 0.5) * grp_w - 10, y: vp.y + vp.h + 8, text: str(cats[ci]), color: th.text_sec, px: 11, align: "center" });
                        ci = ci + 1;
                    }
                }
            }

        // ── 7. 2D Scatter + Polynomial / Linear OLS Regression ───────────────
        } else if knd == "scatter_regression" {
            let n = _min(len(lyr.xs), len(lyr.ys));
            let k = 0;
            while k < n {
                let xv = _num_or(lyr.xs[k], 0.0);
                let yv = _num_or(lyr.ys[k], 0.0);
                let sx = _wx(xv, b2d, vp);
                let sy = _wy(yv, b2d, vp);
                array_push(circles, map{ cx: sx, cy: sy, r: 4.5, fill_color: base_col, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "(" + _fmt_num(xv, 2) + ", " + _fmt_num(yv, 2) + ")" });
                k = k + 1;
            }
            if lyr.trend_deg >= 1 and n >= lyr.trend_deg + 1 {
                let deg = lyr.trend_deg;
                let m_sz = deg + 1;
                let xtx = [];
                let xty = [];
                let r = 0;
                while r < m_sz {
                    let row = [];
                    let c = 0;
                    while c < m_sz {
                        let acc = 0.0;
                        k = 0;
                        while k < n { acc = acc + num_pow(_num_or(lyr.xs[k], 0.0), (r + c) * 1.0); k = k + 1; }
                        array_push(row, acc);
                        c = c + 1;
                    }
                    array_push(xtx, row);
                    let acc_y = 0.0;
                    k = 0;
                    while k < n { acc_y = acc_y + _num_or(lyr.ys[k], 0.0) * num_pow(_num_or(lyr.xs[k], 0.0), r * 1.0); k = k + 1; }
                    array_push(xty, acc_y);
                    r = r + 1;
                }
                let coeffs = _solve_linear_dense(xtx, xty);
                let t_steps = 80;
                let prev_sx = 0.0; let prev_sy = 0.0;
                let s_i = 0;
                while s_i <= t_steps {
                    let xv = b2d.xmin + (b2d.xmax - b2d.xmin) * s_i / t_steps;
                    let yv = 0.0;
                    let p = 0;
                    while p < m_sz { yv = yv + coeffs[p] * num_pow(xv, p * 1.0); p = p + 1; }
                    let sx = _wx(xv, b2d, vp);
                    let sy = _clamp(_wy(yv, b2d, vp), vp.y, vp.y + vp.h);
                    if s_i > 0 {
                        array_push(lines, map{ x1: prev_sx, y1: prev_sy, x2: sx, y2: sy, color: th.amber, width: 2.0, dashed: true });
                    }
                    prev_sx = sx; prev_sy = sy;
                    s_i = s_i + 1;
                }
            }

        // ── 8. 2D Parametric Curve (x(u), y(u)) ──────────────────────────────
        } else if knd == "2d_parametric" {
            let s_i = 0;
            let prev_ok = false; let prev_sx = 0.0; let prev_sy = 0.0;
            while s_i <= lyr.steps {
                let uv = lyr.u_min + (lyr.u_max - lyr.u_min) * s_i / lyr.steps;
                env[lyr.u_var] = uv;
                let xv = eval_compiled_expr(lyr.x_comp, env);
                let yv = eval_compiled_expr(lyr.y_comp, env);
                if _is_finite(xv) and _is_finite(yv) {
                    let sx = _wx(xv, b2d, vp);
                    let sy = _wy(yv, b2d, vp);
                    if prev_ok {
                        array_push(lines, map{ x1: prev_sx, y1: prev_sy, x2: sx, y2: sy, color: base_col, width: 2.2, dashed: false });
                    }
                    prev_sx = sx; prev_sy = sy; prev_ok = true;
                } else { prev_ok = false; }
                s_i = s_i + 1;
            }

        // ── 9. 2D Polar Curve r = f(theta) ───────────────────────────────────
        } else if knd == "2d_polar" {
            // Subtle polar reference rings around origin
            let ox = _wx(0.0, b2d, vp);
            let oy = _wy(0.0, b2d, vp);
            let ring_r = 1;
            while ring_r <= 3 {
                let r_px = _abs(_wx(ring_r * 1.0, b2d, vp) - ox);
                if ox - r_px >= vp.x and ox + r_px <= vp.x + vp.w and oy - r_px >= vp.y and oy + r_px <= vp.y + vp.h {
                    array_push(circles, map{ cx: ox, cy: oy, r: r_px, fill_color: [0, 0, 0, 0], stroke_color: th.grid, stroke_width: 1.0, hollow: true, tooltip: "" });
                }
                ring_r = ring_r + 1;
            }
            let s_i = 0;
            let prev_ok = false; let prev_sx = 0.0; let prev_sy = 0.0;
            while s_i <= lyr.steps {
                let th_v = lyr.th_min + (lyr.th_max - lyr.th_min) * s_i / lyr.steps;
                env[lyr.theta_var] = th_v;
                let rv = eval_compiled_expr(lyr.r_comp, env);
                if _is_finite(rv) {
                    let xv = rv * num_cos(th_v);
                    let yv = rv * num_sin(th_v);
                    let sx = _wx(xv, b2d, vp);
                    let sy = _wy(yv, b2d, vp);
                    if prev_ok {
                        array_push(lines, map{ x1: prev_sx, y1: prev_sy, x2: sx, y2: sy, color: base_col, width: 2.2, dashed: false });
                    }
                    prev_sx = sx; prev_sy = sy; prev_ok = true;
                } else { prev_ok = false; }
                s_i = s_i + 1;
            }

        // ── 10. 2D Implicit Curve F(x, y) = 0 via 16-Case Marching Squares ───
        } else if knd == "2d_implicit" {
            let gn = lyr.grid_n;
            let xs = []; let ys = [];
            let i = 0;
            while i <= gn {
                array_push(xs, lyr.xmin + (lyr.xmax - lyr.xmin) * i / gn);
                array_push(ys, lyr.ymin + (lyr.ymax - lyr.ymin) * i / gn);
                i = i + 1;
            }
            let grid_v = [];
            let j = 0;
            while j <= gn {
                let row = [];
                env.y = ys[j];
                i = 0;
                while i <= gn {
                    env.x = xs[i];
                    array_push(row, eval_compiled_expr(lyr.f_comp, env));
                    i = i + 1;
                }
                array_push(grid_v, row);
                j = j + 1;
            }
            let segs = marching_squares_segments(grid_v, xs, ys, 0.0);
            let si = 0;
            while si < len(segs) {
                let p1 = segs[si][0];
                let p2 = segs[si][1];
                array_push(lines, map{
                    x1: _wx(p1[0], b2d, vp), y1: _wy(p1[1], b2d, vp),
                    x2: _wx(p2[0], b2d, vp), y2: _wy(p2[1], b2d, vp),
                    color: base_col, width: 2.3, dashed: false
                });
                si = si + 1;
            }

        // ── 11. 2D Contour Heatmap + Iso-Contours ────────────────────────────
        } else if knd == "2d_contour_heatmap" {
            let gn = lyr.grid_n;
            let xs = []; let ys = [];
            let i = 0;
            while i <= gn {
                array_push(xs, lyr.xmin + (lyr.xmax - lyr.xmin) * i / gn);
                array_push(ys, lyr.ymin + (lyr.ymax - lyr.ymin) * i / gn);
                i = i + 1;
            }
            let grid_v = [];
            let zmin = 1e18; let zmax = -1e18;
            let j = 0;
            while j <= gn {
                let row = [];
                env.y = ys[j];
                i = 0;
                while i <= gn {
                    env.x = xs[i];
                    let zv = eval_compiled_expr(lyr.f_comp, env);
                    if _is_finite(zv) {
                        if zv < zmin { zmin = zv; }
                        if zv > zmax { zmax = zv; }
                    }
                    array_push(row, zv);
                    i = i + 1;
                }
                array_push(grid_v, row);
                j = j + 1;
            }
            if zmax <= zmin { zmax = zmin + 1.0; }
            j = 0;
            while j < gn {
                let sy1 = _wy(ys[j + 1], b2d, vp);
                let sy0 = _wy(ys[j], b2d, vp);
                i = 0;
                while i < gn {
                    let vc = 0.25 * (grid_v[j][i] + grid_v[j][i + 1] + grid_v[j + 1][i] + grid_v[j + 1][i + 1]);
                    if _is_finite(vc) {
                        let t_col = (vc - zmin) / (zmax - zmin);
                        let sx0 = _wx(xs[i], b2d, vp);
                        let sx1 = _wx(xs[i + 1], b2d, vp);
                        array_push(rects, map{
                            x: sx0, y: sy1, w: _max(1.5, sx1 - sx0 + 0.8), h: _max(1.5, sy0 - sy1 + 0.8),
                            color: palette_perceptual(t_col, 165), radius: 0, tooltip: ""
                        });
                    }
                    i = i + 1;
                }
                j = j + 1;
            }
            let lv = 1;
            while lv <= lyr.levels {
                let iso = zmin + (zmax - zmin) * lv / (lyr.levels + 1);
                let segs = marching_squares_segments(grid_v, xs, ys, iso);
                let si = 0;
                while si < len(segs) {
                    array_push(lines, map{
                        x1: _wx(segs[si][0][0], b2d, vp), y1: _wy(segs[si][0][1], b2d, vp),
                        x2: _wx(segs[si][1][0], b2d, vp), y2: _wy(segs[si][1][1], b2d, vp),
                        color: [242, 247, 252, 175], width: 1.2, dashed: false
                    });
                    si = si + 1;
                }
                lv = lv + 1;
            }

        // ── 12. 2D Vector Field (Quiver Arrows + RK4 Streamlines) ────────────
        } else if knd == "2d_vector_field" {
            let gn = lyr.grid_n;
            let cell_dx = (lyr.xmax - lyr.xmin) / _max(1, gn - 1);
            let cell_dy = (lyr.ymax - lyr.ymin) / _max(1, gn - 1);
            let arrow_scale = 0.38 * _min(cell_dx, cell_dy);
            let j = 0;
            while j < gn {
                let yv = lyr.ymin + j * cell_dy;
                let i = 0;
                while i < gn {
                    let xv = lyr.xmin + i * cell_dx;
                    env.x = xv; env.y = yv;
                    let vx = eval_compiled_expr(lyr.p_comp, env);
                    let vy = eval_compiled_expr(lyr.q_comp, env);
                    if _is_finite(vx) and _is_finite(vy) {
                        let mag = num_sqrt(vx * vx + vy * vy);
                        if mag > 1e-9 {
                            let ux = vx / mag;
                            let uy = vy / mag;
                            let x_end = xv + ux * arrow_scale;
                            let y_end = yv + uy * arrow_scale;
                            let sx1 = _wx(xv, b2d, vp); let sy1 = _wy(yv, b2d, vp);
                            let sx2 = _wx(x_end, b2d, vp); let sy2 = _wy(y_end, b2d, vp);
                            let vcol = palette_perceptual(_clamp(mag / 4.5, 0.0, 1.0), 220);
                            array_push(lines, map{ x1: sx1, y1: sy1, x2: sx2, y2: sy2, color: vcol, width: 1.5, dashed: false });
                            // Arrowhead wings
                            let ang = num_atan2(sy2 - sy1, sx2 - sx1);
                            let ah1x = sx2 - 5.5 * num_cos(ang - 0.5);
                            let ah1y = sy2 - 5.5 * num_sin(ang - 0.5);
                            let ah2x = sx2 - 5.5 * num_cos(ang + 0.5);
                            let ah2y = sy2 - 5.5 * num_sin(ang + 0.5);
                            array_push(lines, map{ x1: sx2, y1: sy2, x2: ah1x, y2: ah1y, color: vcol, width: 1.4, dashed: false });
                            array_push(lines, map{ x1: sx2, y1: sy2, x2: ah2x, y2: ah2y, color: vcol, width: 1.4, dashed: false });
                        }
                    }
                    i = i + 1;
                }
                j = j + 1;
            }
            // RK4 Streamlines
            let starts = lyr.streamlines_starts;
            if starts == nil {
                starts = [
                    [lyr.xmin * 0.6, lyr.ymin * 0.5],
                    [lyr.xmax * 0.6, lyr.ymax * 0.5],
                    [lyr.xmin * 0.4, lyr.ymax * 0.6],
                    [lyr.xmax * 0.4, lyr.ymin * 0.6]
                ];
            }
            let si = 0;
            while si < len(starts) {
                let sx_cur = _num_or(starts[si][0], 0.0);
                let sy_cur = _num_or(starts[si][1], 0.0);
                let h_rk = 0.06;
                let step = 0;
                while step < 55 {
                    env.x = sx_cur; env.y = sy_cur;
                    let k1x = eval_compiled_expr(lyr.p_comp, env); let k1y = eval_compiled_expr(lyr.q_comp, env);
                    if not _is_finite(k1x) or not _is_finite(k1y) { break; }
                    let m1 = num_sqrt(k1x * k1x + k1y * k1y + 1e-12);
                    k1x = k1x / m1; k1y = k1y / m1;
                    env.x = sx_cur + 0.5 * h_rk * k1x; env.y = sy_cur + 0.5 * h_rk * k1y;
                    let k2x = eval_compiled_expr(lyr.p_comp, env); let k2y = eval_compiled_expr(lyr.q_comp, env);
                    let m2 = num_sqrt(k2x * k2x + k2y * k2y + 1e-12);
                    k2x = k2x / m2; k2y = k2y / m2;
                    env.x = sx_cur + 0.5 * h_rk * k2x; env.y = sy_cur + 0.5 * h_rk * k2y;
                    let k3x = eval_compiled_expr(lyr.p_comp, env); let k3y = eval_compiled_expr(lyr.q_comp, env);
                    let m3 = num_sqrt(k3x * k3x + k3y * k3y + 1e-12);
                    k3x = k3x / m3; k3y = k3y / m3;
                    env.x = sx_cur + h_rk * k3x; env.y = sy_cur + h_rk * k3y;
                    let k4x = eval_compiled_expr(lyr.p_comp, env); let k4y = eval_compiled_expr(lyr.q_comp, env);
                    let m4 = num_sqrt(k4x * k4x + k4y * k4y + 1e-12);
                    k4x = k4x / m4; k4y = k4y / m4;

                    let nx_cur = sx_cur + (h_rk / 6.0) * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
                    let ny_cur = sy_cur + (h_rk / 6.0) * (k1y + 2.0 * k2y + 2.0 * k3y + k4y);
                    if nx_cur < lyr.xmin or nx_cur > lyr.xmax or ny_cur < lyr.ymin or ny_cur > lyr.ymax { break; }
                    array_push(lines, map{
                        x1: _wx(sx_cur, b2d, vp), y1: _wy(sy_cur, b2d, vp),
                        x2: _wx(nx_cur, b2d, vp), y2: _wy(ny_cur, b2d, vp),
                        color: th.cyan, width: 1.8, dashed: false
                    });
                    sx_cur = nx_cur; sy_cur = ny_cur;
                    step = step + 1;
                }
                si = si + 1;
            }

        // ── 13. Complex Domain Coloring + Conformal Grid Warping w = f(z) ────
        } else if knd == "complex_domain" {
            let gn = lyr.grid_n;
            let dx = (lyr.xmax - lyr.xmin) / gn;
            let dy = (lyr.ymax - lyr.ymin) / gn;
            let j = 0;
            while j < gn {
                let zy = lyr.ymin + (j + 0.5) * dy;
                let sy1 = _wy(lyr.ymin + (j + 1) * dy, b2d, vp);
                let sy0 = _wy(lyr.ymin + j * dy, b2d, vp);
                let i = 0;
                while i < gn {
                    let zx = lyr.xmin + (i + 0.5) * dx;
                    let wz = [0.0, 0.0];
                    if lyr.complex_mode == "single_z" {
                        wz = eval_complex_compiled(lyr.z_comp, zx, zy, env);
                    } else {
                        env.x = zx; env.y = zy;
                        wz = [eval_compiled_expr(lyr.re_comp, env), eval_compiled_expr(lyr.im_comp, env)];
                    }
                    if _is_finite(wz[0]) and _is_finite(wz[1]) {
                        let phase_deg = num_atan2(wz[1], wz[0]) * 180.0 / PI;
                        let mod_r = num_sqrt(wz[0] * wz[0] + wz[1] * wz[1]);
                        let log_m = if mod_r > 1e-9 { num_ln(mod_r) / 0.69314718 } else { -12.0 };
                        let ring = log_m - num_floor(log_m);
                        let light = 0.28 + 0.36 * ring;
                        let sx0 = _wx(lyr.xmin + i * dx, b2d, vp);
                        let sx1 = _wx(lyr.xmin + (i + 1) * dx, b2d, vp);
                        array_push(rects, map{
                            x: sx0, y: sy1, w: _max(1.5, sx1 - sx0 + 0.8), h: _max(1.5, sy0 - sy1 + 0.8),
                            color: hsl_to_rgba(phase_deg, 0.82, light, 195), radius: 0,
                            tooltip: "z=(" + _fmt_num(zx, 2) + "," + _fmt_num(zy, 2) + "i) -> w=(" + _fmt_num(wz[0], 2) + "," + _fmt_num(wz[1], 2) + "i)"
                        });
                    }
                    i = i + 1;
                }
                j = j + 1;
            }
            // Overlay conformal warped image grid w = f(z) for 7×7 grid lines
            let cg = 6;
            let ci = 0;
            while ci <= cg {
                let u_const = lyr.xmin + (lyr.xmax - lyr.xmin) * ci / cg;
                let s_k = 0;
                let prev_ok = false; let px = 0.0; let py = 0.0;
                while s_k <= 32 {
                    let v_var = lyr.ymin + (lyr.ymax - lyr.ymin) * s_k / 32;
                    let wz = if lyr.complex_mode == "single_z" { eval_complex_compiled(lyr.z_comp, u_const, v_var, env) } else { env.x = u_const; env.y = v_var; [eval_compiled_expr(lyr.re_comp, env), eval_compiled_expr(lyr.im_comp, env)] };
                    if _is_finite(wz[0]) and _is_finite(wz[1]) and _abs(wz[0]) <= b2d.xmax * 1.5 and _abs(wz[1]) <= b2d.ymax * 1.5 {
                        let sx = _clamp(_wx(wz[0], b2d, vp), vp.x, vp.x + vp.w);
                        let sy = _clamp(_wy(wz[1], b2d, vp), vp.y, vp.y + vp.h);
                        if prev_ok { array_push(lines, map{ x1: px, y1: py, x2: sx, y2: sy, color: [255, 255, 255, 130], width: 1.1, dashed: false }); }
                        px = sx; py = sy; prev_ok = true;
                    } else { prev_ok = false; }
                    s_k = s_k + 1;
                }
                ci = ci + 1;
            }

        // ── 14. 3D Surface z = f(x, y) (Depth-Sorted Diffuse Shaded Quads) ───
        } else if knd == "3d_surface" {
            let nx = lyr.nx; let ny = lyr.ny;
            let pts3 = [];
            let zmin = 1e18; let zmax = -1e18;
            let j = 0;
            while j <= ny {
                let yv = lyr.ymin + (lyr.ymax - lyr.ymin) * j / ny;
                env.y = yv;
                let row = [];
                let i = 0;
                while i <= nx {
                    let xv = lyr.xmin + (lyr.xmax - lyr.xmin) * i / nx;
                    env.x = xv;
                    let zv = eval_compiled_expr(lyr.z_comp, env);
                    if not _is_finite(zv) { zv = 0.0; }
                    if zv < zmin { zmin = zv; }
                    if zv > zmax { zmax = zv; }
                    array_push(row, [xv, yv, zv]);
                    i = i + 1;
                }
                array_push(pts3, row);
                j = j + 1;
            }
            if zmax <= zmin { zmax = zmin + 1.0; }
            j = 0;
            while j < ny {
                let i = 0;
                while i < nx {
                    let p00 = pts3[j][i];
                    let p10 = pts3[j][i + 1];
                    let p11 = pts3[j + 1][i + 1];
                    let p01 = pts3[j + 1][i];
                    let z_avg = 0.25 * (p00[2] + p10[2] + p11[2] + p01[2]);
                    let t_h = (z_avg - zmin) / (zmax - zmin);
                    let raw_col = palette_perceptual(t_h, 232);
                    let shaded = _shade_3d_quad(p00, p10, p01, raw_col);
                    let q00 = _project_3d_point(p00[0], p00[1], p00[2], st.cam_3d, vp);
                    let q10 = _project_3d_point(p10[0], p10[1], p10[2], st.cam_3d, vp);
                    let q11 = _project_3d_point(p11[0], p11[1], p11[2], st.cam_3d, vp);
                    let q01 = _project_3d_point(p01[0], p01[1], p01[2], st.cam_3d, vp);
                    let zd = 0.25 * (q00.z_depth + q10.z_depth + q11.z_depth + q01.z_depth);
                    array_push(depth_queue, map{
                        ptype: "poly",
                        z_depth: zd,
                        points: [[q00.sx, q00.sy], [q10.sx, q10.sy], [q11.sx, q11.sy], [q01.sx, q01.sy]],
                        fill_color: shaded,
                        stroke_color: [18, 28, 38, 130],
                        stroke_width: 0.7,
                        tooltip: "z=" + _fmt_num(z_avg, 2)
                    });
                    i = i + 1;
                }
                j = j + 1;
            }

        // ── 15. 3D Parametric Curve / Lorenz Trajectory ──────────────────────
        } else if knd == "3d_parametric_curve" {
            let pts = [];
            if lyr.curve_mode == "points" {
                pts = lyr.points_xyz;
            } else {
                let s_i = 0;
                while s_i <= lyr.steps {
                    let uv = lyr.u_min + (lyr.u_max - lyr.u_min) * s_i / lyr.steps;
                    env[lyr.u_var] = uv;
                    let xv = eval_compiled_expr(lyr.x_comp, env);
                    let yv = eval_compiled_expr(lyr.y_comp, env);
                    let zv = eval_compiled_expr(lyr.z_comp, env);
                    if _is_finite(xv) and _is_finite(yv) and _is_finite(zv) {
                        array_push(pts, [xv, yv, zv]);
                    }
                    s_i = s_i + 1;
                }
            }
            let np = len(pts);
            let k = 1;
            while k < np {
                let a = pts[k - 1]; let b = pts[k];
                let qa = _project_3d_point(a[0], a[1], a[2], st.cam_3d, vp);
                let qb = _project_3d_point(b[0], b[1], b[2], st.cam_3d, vp);
                let c_seg = if lyr.color != nil { base_col } else { palette_perceptual((k * 1.0) / np, 240) };
                array_push(depth_queue, map{
                    ptype: "line",
                    z_depth: 0.5 * (qa.z_depth + qb.z_depth),
                    x1: qa.sx, y1: qa.sy, x2: qb.sx, y2: qb.sy,
                    color: c_seg, width: 2.0, dashed: false
                });
                k = k + 1;
            }

        // ── 16. 3D Parametric Surface (Torus, Sphere, Möbius, Klein) ─────────
        } else if knd == "3d_parametric_surface" {
            let nu = lyr.nu; let nv = lyr.nv;
            let grid3 = [];
            let j = 0;
            while j <= nv {
                let vv = lyr.v_min + (lyr.v_max - lyr.v_min) * j / nv;
                env[lyr.v_var] = vv;
                let row = [];
                let i = 0;
                while i <= nu {
                    let uv = lyr.u_min + (lyr.u_max - lyr.u_min) * i / nu;
                    env[lyr.u_var] = uv;
                    let xv = eval_compiled_expr(lyr.x_comp, env);
                    let yv = eval_compiled_expr(lyr.y_comp, env);
                    let zv = eval_compiled_expr(lyr.z_comp, env);
                    array_push(row, [if _is_finite(xv) { xv } else { 0.0 }, if _is_finite(yv) { yv } else { 0.0 }, if _is_finite(zv) { zv } else { 0.0 }]);
                    i = i + 1;
                }
                array_push(grid3, row);
                j = j + 1;
            }
            j = 0;
            while j < nv {
                let i = 0;
                while i < nu {
                    let p00 = grid3[j][i]; let p10 = grid3[j][i + 1];
                    let p11 = grid3[j + 1][i + 1]; let p01 = grid3[j + 1][i];
                    let shaded = _shade_3d_quad(p00, p10, p01, palette_perceptual((i * 1.0) / nu, 225));
                    let q00 = _project_3d_point(p00[0], p00[1], p00[2], st.cam_3d, vp);
                    let q10 = _project_3d_point(p10[0], p10[1], p10[2], st.cam_3d, vp);
                    let q11 = _project_3d_point(p11[0], p11[1], p11[2], st.cam_3d, vp);
                    let q01 = _project_3d_point(p01[0], p01[1], p01[2], st.cam_3d, vp);
                    array_push(depth_queue, map{
                        ptype: "poly",
                        z_depth: 0.25 * (q00.z_depth + q10.z_depth + q11.z_depth + q01.z_depth),
                        points: [[q00.sx, q00.sy], [q10.sx, q10.sy], [q11.sx, q11.sy], [q01.sx, q01.sy]],
                        fill_color: shaded, stroke_color: [16, 24, 34, 120], stroke_width: 0.6, tooltip: ""
                    });
                    i = i + 1;
                }
                j = j + 1;
            }

        // ── 17. 3D Scatter & Quiver ──────────────────────────────────────────
        } else if knd == "3d_scatter_quiver" {
            let pts = lyr.points_xyz;
            let vecs = lyr.vectors_uvw;
            let k = 0;
            while k < len(pts) {
                let p = pts[k];
                let qp = _project_3d_point(_num_or(p[0], 0.0), _num_or(p[1], 0.0), _num_or(p[2], 0.0), st.cam_3d, vp);
                array_push(depth_queue, map{
                    ptype: "circle", z_depth: qp.z_depth,
                    cx: qp.sx, cy: qp.sy, r: 4.5, fill_color: base_col, stroke_color: th.card, stroke_width: 1.2, hollow: false,
                    tooltip: "(" + _fmt_num(p[0], 2) + ", " + _fmt_num(p[1], 2) + ", " + _fmt_num(p[2], 2) + ")"
                });
                if vecs != nil and k < len(vecs) {
                    let v = vecs[k];
                    let qe = _project_3d_point(p[0] + v[0], p[1] + v[1], p[2] + v[2], st.cam_3d, vp);
                    array_push(depth_queue, map{
                        ptype: "line", z_depth: 0.5 * (qp.z_depth + qe.z_depth),
                        x1: qp.sx, y1: qp.sy, x2: qe.sx, y2: qe.sy, color: th.amber, width: 2.0, dashed: false
                    });
                }
                k = k + 1;
            }

        // ── 18. 4D Polytopes (SO(4) Rotor + Stereographic + Hyperplane Slicer) ──
        } else if knd == "4d_polytope" {
            let proj4 = [];
            let proj3 = [];
            let k = 0;
            while k < len(lyr.vertices) {
                let p4 = _project_4d_to_3d(lyr.vertices[k], st.rotor_4d, st.w_eye_4d);
                let p3 = _project_3d_point(p4.x, p4.y, p4.z, st.cam_3d, vp);
                array_push(proj4, p4);
                array_push(proj3, p3);
                let w_norm = _clamp((p4.w_rot + 1.6) / 3.2, 0.0, 1.0);
                let vcol = palette_perceptual(w_norm, 250);
                array_push(depth_queue, map{
                    ptype: "circle", z_depth: p3.z_depth + 0.02,
                    cx: p3.sx, cy: p3.sy, r: _clamp(3.6 * p4.scale4, 2.5, 7.0),
                    fill_color: vcol, stroke_color: th.card, stroke_width: 1.0, hollow: false,
                    tooltip: "4D w'=" + _fmt_num(p4.w_rot, 2)
                });
                k = k + 1;
            }
            let ei = 0;
            while ei < len(lyr.edges) {
                let u = lyr.edges[ei][0];
                let v = lyr.edges[ei][1];
                let pu4 = proj4[u]; let pv4 = proj4[v];
                let pu3 = proj3[u]; let pv3 = proj3[v];
                let w_mid = _clamp(((pu4.w_rot + pv4.w_rot) * 0.5 + 1.6) / 3.2, 0.0, 1.0);
                array_push(depth_queue, map{
                    ptype: "line", z_depth: 0.5 * (pu3.z_depth + pv3.z_depth),
                    x1: pu3.sx, y1: pu3.sy, x2: pv3.sx, y2: pv3.sy,
                    color: palette_perceptual(w_mid, 215), width: 1.9, dashed: false
                });
                ei = ei + 1;
            }

            // Active 4D Hyperplane Cross-Section Slicer!
            if st.slice_4d.active {
                let ax_name = st.slice_4d.axis;
                let ax_idx = if ax_name == "x" { 0 } else if ax_name == "y" { 1 } else if ax_name == "z" { 2 } else { 3 };
                let s_val = st.slice_4d.val;
                let slice_pts3 = [];
                // Intersect every 4D edge in rotated R^4 with rot4[ax_idx] == s_val
                ei = 0;
                while ei < len(lyr.edges) {
                    let ra = proj4[lyr.edges[ei][0]].rot4;
                    let rb = proj4[lyr.edges[ei][1]].rot4;
                    let da = ra[ax_idx] - s_val;
                    let db = rb[ax_idx] - s_val;
                    if (da <= 0.0 and db >= 0.0) or (da >= 0.0 and db <= 0.0) {
                        let denom = rb[ax_idx] - ra[ax_idx];
                        let t_int = if _abs(denom) > 1e-9 { _clamp((s_val - ra[ax_idx]) / denom, 0.0, 1.0) } else { 0.5 };
                        let ix4 = [
                            ra[0] + t_int * (rb[0] - ra[0]),
                            ra[1] + t_int * (rb[1] - ra[1]),
                            ra[2] + t_int * (rb[2] - ra[2]),
                            ra[3] + t_int * (rb[3] - ra[3])
                        ];
                        let denom_w = _max(0.25, st.w_eye_4d - ix4[3]);
                        let sc4 = st.w_eye_4d / denom_w;
                        let sp3 = _project_3d_point(ix4[0] * sc4, ix4[1] * sc4, ix4[2] * sc4, st.cam_3d, vp);
                        array_push(slice_pts3, sp3);
                        array_push(depth_queue, map{
                            ptype: "circle", z_depth: sp3.z_depth + 0.18,
                            cx: sp3.sx, cy: sp3.sy, r: 4.8,
                            fill_color: th.amber, stroke_color: th.coral, stroke_width: 1.6, hollow: false,
                            tooltip: "Τομή " + ax_name + "=" + _fmt_num(s_val, 2)
                        });
                    }
                    ei = ei + 1;
                }
                // Intersect 2D faces to draw exact cross-section slice segments & translucent slice hull
                let fi = 0;
                while fi < len(lyr.faces) {
                    let fc = lyr.faces[fi];
                    let f_hits = [];
                    let fk = 0;
                    while fk < len(fc) {
                        let va = proj4[fc[fk]].rot4;
                        let vb = proj4[fc[num_mod(fk + 1, len(fc))]].rot4;
                        let da = va[ax_idx] - s_val;
                        let db = vb[ax_idx] - s_val;
                        if ((da <= 0.0 and db > 0.0) or (da >= 0.0 and db < 0.0)) and _abs(vb[ax_idx] - va[ax_idx]) > 1e-9 {
                            let ti = _clamp((s_val - va[ax_idx]) / (vb[ax_idx] - va[ax_idx]), 0.0, 1.0);
                            let q4 = [va[0] + ti * (vb[0] - va[0]), va[1] + ti * (vb[1] - va[1]), va[2] + ti * (vb[2] - va[2]), va[3] + ti * (vb[3] - va[3])];
                            let sc4 = st.w_eye_4d / _max(0.25, st.w_eye_4d - q4[3]);
                            array_push(f_hits, _project_3d_point(q4[0] * sc4, q4[1] * sc4, q4[2] * sc4, st.cam_3d, vp));
                        }
                        fk = fk + 1;
                    }
                    if len(f_hits) >= 2 {
                        array_push(depth_queue, map{
                            ptype: "line", z_depth: 0.5 * (f_hits[0].z_depth + f_hits[1].z_depth) + 0.15,
                            x1: f_hits[0].sx, y1: f_hits[0].sy, x2: f_hits[1].sx, y2: f_hits[1].sy,
                            color: th.amber, width: 2.8, dashed: false
                        });
                    }
                    fi = fi + 1;
                }
                if len(slice_pts3) >= 3 and len(lyr.faces) == 0 {
                    let si = 1;
                    while si < len(slice_pts3) {
                        array_push(depth_queue, map{
                            ptype: "line", z_depth: 0.5 * (slice_pts3[0].z_depth + slice_pts3[si].z_depth) + 0.12,
                            x1: slice_pts3[si - 1].sx, y1: slice_pts3[si - 1].sy, x2: slice_pts3[si].sx, y2: slice_pts3[si].sy,
                            color: th.amber, width: 2.5, dashed: false
                        });
                        si = si + 1;
                    }
                }
            }

        // ── 19. 4D Hypersurface Slice w = F(x, y, z) + Volumetric Cloud ──────
        } else if knd == "4d_hypersurface_slice" {
            let gn = lyr.grid_n;
            let s_ax = if st.slice_4d.active { st.slice_4d.axis } else { lyr.slice_axis };
            let s_val = if st.slice_4d.active { st.slice_4d.val } else { lyr.slice_val };
            let grid3 = [];
            let wgrid = [];
            let wmin = 1e18; let wmax = -1e18;
            let j = 0;
            while j <= gn {
                let v_coord = lyr.ymin + (lyr.ymax - lyr.ymin) * j / gn;
                let r3 = []; let rw = [];
                let i = 0;
                while i <= gn {
                    let u_coord = lyr.xmin + (lyr.xmax - lyr.xmin) * i / gn;
                    let xv = u_coord; let yv = v_coord; let zv = s_val;
                    if s_ax == "x" { xv = s_val; yv = u_coord; zv = v_coord; }
                    else if s_ax == "y" { xv = u_coord; yv = s_val; zv = v_coord; }
                    env.x = xv; env.y = yv; env.z = zv;
                    let wv = eval_compiled_expr(lyr.w_comp, env);
                    if not _is_finite(wv) { wv = 0.0; }
                    if wv < wmin { wmin = wv; }
                    if wv > wmax { wmax = wv; }
                    array_push(r3, [xv, yv, wv * 0.65]);
                    array_push(rw, wv);
                    i = i + 1;
                }
                array_push(grid3, r3);
                array_push(wgrid, rw);
                j = j + 1;
            }
            if wmax <= wmin { wmax = wmin + 1.0; }
            j = 0;
            while j < gn {
                let i = 0;
                while i < gn {
                    let p00 = grid3[j][i]; let p10 = grid3[j][i + 1];
                    let p11 = grid3[j + 1][i + 1]; let p01 = grid3[j + 1][i];
                    let w_avg = 0.25 * (wgrid[j][i] + wgrid[j][i + 1] + wgrid[j + 1][i + 1] + wgrid[j + 1][i]);
                    let col_w = _shade_3d_quad(p00, p10, p01, palette_perceptual((w_avg - wmin) / (wmax - wmin), 220));
                    let q00 = _project_3d_point(p00[0], p00[1], p00[2], st.cam_3d, vp);
                    let q10 = _project_3d_point(p10[0], p10[1], p10[2], st.cam_3d, vp);
                    let q11 = _project_3d_point(p11[0], p11[1], p11[2], st.cam_3d, vp);
                    let q01 = _project_3d_point(p01[0], p01[1], p01[2], st.cam_3d, vp);
                    array_push(depth_queue, map{
                        ptype: "poly",
                        z_depth: 0.25 * (q00.z_depth + q10.z_depth + q11.z_depth + q01.z_depth),
                        points: [[q00.sx, q00.sy], [q10.sx, q10.sy], [q11.sx, q11.sy], [q01.sx, q01.sy]],
                        fill_color: col_w, stroke_color: [16, 24, 34, 110], stroke_width: 0.6,
                        tooltip: "w=" + _fmt_num(w_avg, 2) + " (" + s_ax + "=" + _fmt_num(s_val, 2) + ")"
                    });
                    i = i + 1;
                }
                j = j + 1;
            }

        // ── 20. N-D Hypercube (2^N Vertices Projected via SO(N) Rotor) ───────
        } else if knd == "nd_hypercube" {
            _ensure_rotor_dim(st, lyr.dim_n);
            let proj3 = [];
            let higher_w = [];
            let k = 0;
            while k < len(lyr.vertices) {
                let rv = _mat_vec_mul(st.rotor_nd, lyr.vertices[k]);
                // Cascade perspective from dim N-1 down to 3D
                let cur_pts = rv;
                let d_cur = lyr.dim_n - 1;
                let h_acc = 0.0;
                while d_cur >= 3 {
                    let coord_d = cur_pts[d_cur];
                    h_acc = h_acc + coord_d;
                    let eye_nd = 3.8 + (d_cur - 3) * 0.45;
                    let s_nd = eye_nd / _max(0.5, eye_nd - coord_d);
                    let m = 0;
                    while m < d_cur { cur_pts[m] = cur_pts[m] * s_nd; m = m + 1; }
                    d_cur = d_cur - 1;
                }
                let x3 = if len(cur_pts) > 0 { cur_pts[0] } else { 0.0 };
                let y3 = if len(cur_pts) > 1 { cur_pts[1] } else { 0.0 };
                let z3 = if len(cur_pts) > 2 { cur_pts[2] } else { 0.0 };
                let p3 = _project_3d_point(x3, y3, z3, st.cam_3d, vp);
                array_push(proj3, p3);
                array_push(higher_w, h_acc);
                k = k + 1;
            }
            let ei = 0;
            while ei < len(lyr.edges) {
                let u = lyr.edges[ei][0]; let v = lyr.edges[ei][1];
                let pu = proj3[u]; let pv = proj3[v];
                let t_col = _clamp(((higher_w[u] + higher_w[v]) * 0.25 + 1.5) / 3.0, 0.0, 1.0);
                array_push(depth_queue, map{
                    ptype: "line", z_depth: 0.5 * (pu.z_depth + pv.z_depth),
                    x1: pu.sx, y1: pu.sy, x2: pv.sx, y2: pv.sy,
                    color: palette_perceptual(t_col, 195), width: 1.4, dashed: false
                });
                ei = ei + 1;
            }

        // ── 21. N-D Parallel Coordinates (Normalized Axes + Brushing) ────────
        } else if knd == "nd_parallel_coords" {
            let mat = lyr.data;
            let n_rows = len(mat);
            let dim_d = lyr.dim_n;
            if n_rows > 0 and dim_d >= 2 {
                // Axis permutation
                let perm = [];
                if st.axis_perm != nil and len(st.axis_perm) == dim_d {
                    perm = st.axis_perm;
                } else {
                    let d = 0;
                    while d < dim_d { array_push(perm, d); d = d + 1; }
                }
                // Min/Max per original dimension
                let mins = []; let maxs = [];
                let d = 0;
                while d < dim_d {
                    let mn = _num_or(mat[0][d], 0.0);
                    let mx = mn;
                    let r = 1;
                    while r < n_rows {
                        let v = _num_or(mat[r][d], 0.0);
                        if v < mn { mn = v; }
                        if v > mx { mx = v; }
                        r = r + 1;
                    }
                    if mx - mn < 1e-9 { mx = mn + 1.0; }
                    array_push(mins, mn);
                    array_push(maxs, mx);
                    d = d + 1;
                }
                let ax_pad = 24.0;
                let usable_w = _max(40.0, vp.w - 2.0 * ax_pad);
                let top_y = vp.y + 22;
                let bot_y = vp.y + vp.h - 20;

                // Draw dimmed (filtered-out) polylines first, then bright brushed polylines on top!
                let pass = 0;
                while pass < 2 {
                    let r = 0;
                    while r < n_rows {
                        let row = mat[r];
                        let ok_brush = _row_passes_brushes(row, st.brushes);
                        if (pass == 0 and not ok_brush) or (pass == 1 and ok_brush) {
                            let rcol = if ok_brush { _series_palette(r) } else { th.dimmed };
                            let lw = if ok_brush { 2.0 } else { 1.0 };
                            let s = 1;
                            while s < dim_d {
                                let d0 = perm[s - 1];
                                let d1 = perm[s];
                                let x0 = vp.x + ax_pad + usable_w * (s - 1) / (dim_d - 1);
                                let x1 = vp.x + ax_pad + usable_w * s / (dim_d - 1);
                                let t0 = (_num_or(row[d0], 0.0) - mins[d0]) / (maxs[d0] - mins[d0]);
                                let t1 = (_num_or(row[d1], 0.0) - mins[d1]) / (maxs[d1] - mins[d1]);
                                let y0 = bot_y - t0 * (bot_y - top_y);
                                let y1 = bot_y - t1 * (bot_y - top_y);
                                array_push(lines, map{ x1: x0, y1: y0, x2: x1, y2: y1, color: rcol, width: lw, dashed: false });
                                s = s + 1;
                            }
                        }
                        r = r + 1;
                    }
                    pass = pass + 1;
                }

                // Vertical axis spines, min/max labels, and active brush highlight boxes
                let s = 0;
                while s < dim_d {
                    let orig_d = perm[s];
                    let ax_x = vp.x + ax_pad + usable_w * s / (dim_d - 1);
                    array_push(lines, map{ x1: ax_x, y1: top_y, x2: ax_x, y2: bot_y, color: th.axis, width: 1.6, dashed: false });
                    let aname = if lyr.axis_names != nil and orig_d < len(lyr.axis_names) { str(lyr.axis_names[orig_d]) } else { "D" + str(orig_d + 1) };
                    array_push(texts, map{ x: ax_x - 12, y: vp.y + 4, text: aname, color: th.text, px: 11, align: "center" });
                    array_push(texts, map{ x: ax_x + 4, y: top_y - 2, text: _fmt_num(maxs[orig_d], 1), color: th.text_muted, px: 9, align: "left" });
                    array_push(texts, map{ x: ax_x + 4, y: bot_y - 8, text: _fmt_num(mins[orig_d], 1), color: th.text_muted, px: 9, align: "left" });

                    if map_has(st.brushes, str(orig_d)) {
                        let br = st.brushes[str(orig_d)];
                        let bt0 = _clamp((br.lo - mins[orig_d]) / (maxs[orig_d] - mins[orig_d]), 0.0, 1.0);
                        let bt1 = _clamp((br.hi - mins[orig_d]) / (maxs[orig_d] - mins[orig_d]), 0.0, 1.0);
                        let by_hi = bot_y - bt1 * (bot_y - top_y);
                        let by_lo = bot_y - bt0 * (bot_y - top_y);
                        array_push(rects, map{
                            x: ax_x - 6, y: by_hi, w: 12, h: _max(4, by_lo - by_hi),
                            color: [16, 229, 155, 110], radius: 3, stroke_color: th.emerald,
                            tooltip: "Brush " + aname + ": [" + _fmt_num(br.lo, 2) + ", " + _fmt_num(br.hi, 2) + "]"
                        });
                    }
                    s = s + 1;
                }
            }

        // ── 22. N-D Radar / Spider Profiles ──────────────────────────────────
        } else if knd == "nd_radar" {
            let mat = lyr.data;
            let n_rows = len(mat);
            let dim_d = lyr.dim_n;
            if n_rows > 0 and dim_d >= 3 {
                let perm = if st.axis_perm != nil and len(st.axis_perm) == dim_d { st.axis_perm } else {
                    let tmp_p = []; let d = 0; while d < dim_d { array_push(tmp_p, d); d = d + 1; } tmp_p
                };
                let max_v = 1e-6;
                let r = 0;
                while r < n_rows {
                    let d = 0;
                    while d < dim_d {
                        let v = _abs(_num_or(mat[r][d], 0.0));
                        if v > max_v { max_v = v; }
                        d = d + 1;
                    }
                    r = r + 1;
                }
                let rad = _min(vp.w, vp.h) * 0.38;
                // Concentric web rings
                let ring = 1;
                while ring <= 4 {
                    let rr = rad * ring / 4.0;
                    let s = 0;
                    while s < dim_d {
                        let a0 = -0.5 * PI + TAU * s / dim_d;
                        let a1 = -0.5 * PI + TAU * (s + 1) / dim_d;
                        array_push(lines, map{
                            x1: vp.cx + rr * num_cos(a0), y1: vp.cy + rr * num_sin(a0),
                            x2: vp.cx + rr * num_cos(a1), y2: vp.cy + rr * num_sin(a1),
                            color: th.grid, width: 1.0, dashed: false
                        });
                        s = s + 1;
                    }
                    ring = ring + 1;
                }
                // Spokes & axis labels
                let s = 0;
                while s < dim_d {
                    let ang = -0.5 * PI + TAU * s / dim_d;
                    let ex = vp.cx + rad * num_cos(ang);
                    let ey = vp.cy + rad * num_sin(ang);
                    array_push(lines, map{ x1: vp.cx, y1: vp.cy, x2: ex, y2: ey, color: th.axis, width: 1.2, dashed: false });
                    let od = perm[s];
                    let aname = if lyr.axis_names != nil and od < len(lyr.axis_names) { str(lyr.axis_names[od]) } else { "D" + str(od + 1) };
                    array_push(texts, map{ x: vp.cx + (rad + 16) * num_cos(ang) - 10, y: vp.cy + (rad + 16) * num_sin(ang) - 5, text: aname, color: th.text_sec, px: 10, align: "center" });
                    s = s + 1;
                }
                // Profile polygons
                r = 0;
                while r < n_rows {
                    let row = mat[r];
                    let ok_b = _row_passes_brushes(row, st.brushes);
                    let pcol = if ok_b { _series_palette(r) } else { th.dimmed };
                    let pts = [];
                    s = 0;
                    while s < dim_d {
                        let od = perm[s];
                        let frac = _clamp(_abs(_num_or(row[od], 0.0)) / max_v, 0.0, 1.0);
                        let ang = -0.5 * PI + TAU * s / dim_d;
                        array_push(pts, [vp.cx + rad * frac * num_cos(ang), vp.cy + rad * frac * num_sin(ang)]);
                        s = s + 1;
                    }
                    array_push(polygons, map{
                        points: pts,
                        fill_color: [pcol[0], pcol[1], pcol[2], if ok_b { 56 } else { 20 }],
                        stroke_color: pcol, stroke_width: if ok_b { 2.1 } else { 1.0 },
                        tooltip: "Προφίλ #" + str(r + 1)
                    });
                    r = r + 1;
                }
            }

        // ── 23. N-D PCA Subspace Projection (R^D -> R^3 / R^2) ───────────────
        } else if knd == "nd_pca_projection" {
            let pm = lyr.pca_model;
            pca_stats = pm;
            let proj = pm.projected;
            let n_rows = len(proj);
            let r = 0;
            while r < n_rows {
                let c = proj[r];
                let ok_b = _row_passes_brushes(lyr.data[r], st.brushes);
                let lbl_idx = if lyr.labels != nil and r < len(lyr.labels) { _int_or(lyr.labels[r], r) } else { r };
                let pcol = if ok_b { _series_palette(lbl_idx) } else { th.dimmed };
                if lyr.target_dim == 3 {
                    let p3 = _project_3d_point(c[0], c[1], c[2], st.cam_3d, vp);
                    array_push(depth_queue, map{
                        ptype: "circle", z_depth: p3.z_depth,
                        cx: p3.sx, cy: p3.sy, r: if ok_b { 5.0 } else { 3.0 },
                        fill_color: pcol, stroke_color: th.card, stroke_width: 1.2, hollow: false,
                        tooltip: "PCA #" + str(r + 1) + " (" + _fmt_num(c[0], 2) + ", " + _fmt_num(c[1], 2) + ", " + _fmt_num(c[2], 2) + ")"
                    });
                } else {
                    array_push(circles, map{
                        cx: _wx(c[0], b2d, vp), cy: _wy(c[1], b2d, vp), r: if ok_b { 5.0 } else { 3.0 },
                        fill_color: pcol, stroke_color: th.card, stroke_width: 1.2, hollow: false,
                        tooltip: "PCA #" + str(r + 1)
                    });
                }
                r = r + 1;
            }
            if len(pm.explained_variance_pct) > 0 {
                let ev_txt = "PCA Διακύμανση: PC1=" + _fmt_fixed(pm.explained_variance_pct[0], 1) + "%";
                if len(pm.explained_variance_pct) > 1 { ev_txt = ev_txt + ", PC2=" + _fmt_fixed(pm.explained_variance_pct[1], 1) + "%"; }
                if len(pm.explained_variance_pct) > 2 { ev_txt = ev_txt + ", PC3=" + _fmt_fixed(pm.explained_variance_pct[2], 1) + "%"; }
                ev_txt = ev_txt + " (Σ=" + _fmt_fixed(pm.total_explained_pct, 1) + "%)";
                array_push(texts, map{ x: vp.x + 10, y: vp.y + 10, text: ev_txt, color: th.emerald, px: 11, align: "left" });
            }

        // ── 24. N-D Andrews Fourier Curves on [-pi, pi] ──────────────────────
        } else if knd == "nd_andrews_curves" {
            let mat = lyr.data;
            let n_rows = len(mat);
            let dim_d = lyr.dim_n;
            if n_rows > 0 and dim_d >= 1 {
                let all_curves = [];
                let ymin_a = 1e18; let ymax_a = -1e18;
                let r = 0;
                while r < n_rows {
                    let row = mat[r];
                    let c_pts = [];
                    let s = 0;
                    while s <= lyr.steps {
                        let tv = 0.0 - PI + TAU * s / lyr.steps;
                        let fv = _num_or(row[0], 0.0) * INV_SQRT2;
                        let d = 1;
                        while d < dim_d {
                            let k_harm = num_floor((d + 1) / 2);
                            let xv = _num_or(row[d], 0.0);
                            if num_mod(d, 2) == 1 {
                                fv = fv + xv * num_sin(k_harm * tv);
                            } else {
                                fv = fv + xv * num_cos(k_harm * tv);
                            }
                            d = d + 1;
                        }
                        if fv < ymin_a { ymin_a = fv; }
                        if fv > ymax_a { ymax_a = fv; }
                        array_push(c_pts, [tv, fv]);
                        s = s + 1;
                    }
                    array_push(all_curves, c_pts);
                    r = r + 1;
                }
                if ymax_a <= ymin_a { ymax_a = ymin_a + 1.0; }
                let pad_a = (ymax_a - ymin_a) * 0.12;
                let ab = map{ xmin: 0.0 - PI, xmax: PI, ymin: ymin_a - pad_a, ymax: ymax_a + pad_a };
                let pass = 0;
                while pass < 2 {
                    r = 0;
                    while r < n_rows {
                        let ok_b = _row_passes_brushes(mat[r], st.brushes);
                        if (pass == 0 and not ok_b) or (pass == 1 and ok_b) {
                            let ccol = if ok_b { _series_palette(r) } else { th.dimmed };
                            let pts = all_curves[r];
                            let s = 1;
                            while s < len(pts) {
                                array_push(lines, map{
                                    x1: _wx(pts[s - 1][0], ab, vp), y1: _wy(pts[s - 1][1], ab, vp),
                                    x2: _wx(pts[s][0], ab, vp), y2: _wy(pts[s][1], ab, vp),
                                    color: ccol, width: if ok_b { 1.9 } else { 1.0 }, dashed: false
                                });
                                s = s + 1;
                            }
                        }
                        r = r + 1;
                    }
                    pass = pass + 1;
                }
            }

        // ── 25. Hyperbolic Poincaré Disk (Orthogonal Geodesic Arcs) ──────────
        } else if knd == "poincare_disk" {
            let rad_px = _min(vp.w, vp.h) * 0.43;
            // Unit disk |z| = 1 boundary & hyperbolic metric rings
            array_push(circles, map{ cx: vp.cx, cy: vp.cy, r: rad_px, fill_color: th.card_alt, stroke_color: th.cyan, stroke_width: 2.2, hollow: false, tooltip: "Poincaré Disk |z| < 1" });
            array_push(circles, map{ cx: vp.cx, cy: vp.cy, r: rad_px * 0.5, fill_color: [0, 0, 0, 0], stroke_color: th.grid, stroke_width: 1.0, hollow: true, tooltip: "" });
            array_push(circles, map{ cx: vp.cx, cy: vp.cy, r: rad_px * 0.8, fill_color: [0, 0, 0, 0], stroke_color: th.grid, stroke_width: 1.0, hollow: true, tooltip: "" });
            let gi = 0;
            while gi < len(lyr.geodesic_pairs) {
                let pr = lyr.geodesic_pairs[gi];
                let z1 = if is_array(pr) { pr[0] } else { pr.z1 };
                let z2 = if is_array(pr) { pr[1] } else { pr.z2 };
                let gpts = _poincare_geodesic_points(z1, z2, 44);
                let gcol = _series_palette(gi);
                let s = 1;
                while s < len(gpts) {
                    array_push(lines, map{
                        x1: vp.cx + gpts[s - 1][0] * rad_px, y1: vp.cy - gpts[s - 1][1] * rad_px,
                        x2: vp.cx + gpts[s][0] * rad_px, y2: vp.cy - gpts[s][1] * rad_px,
                        color: gcol, width: 2.2, dashed: false
                    });
                    s = s + 1;
                }
                let dh = _poincare_distance(z1, z2);
                array_push(circles, map{ cx: vp.cx + z1[0] * rad_px, cy: vp.cy - z1[1] * rad_px, r: 4.5, fill_color: gcol, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "d_H = " + _fmt_fixed(dh, 3) });
                array_push(circles, map{ cx: vp.cx + z2[0] * rad_px, cy: vp.cy - z2[1] * rad_px, r: 4.5, fill_color: gcol, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "d_H = " + _fmt_fixed(dh, 3) });
                gi = gi + 1;
            }

        // ── 26. Riemann Sphere S^2 (Stereographic C U {inf} -> R^3) ──────────
        } else if knd == "riemann_sphere" {
            let R_sph = 2.0;
            // Wireframe latitude & meridian rings on S^2
            let lat_i = -2;
            while lat_i <= 2 {
                let phi_lat = lat_i * PI / 6.0;
                let r_ring = R_sph * num_cos(phi_lat);
                let z_ring = R_sph * num_sin(phi_lat);
                let s = 0;
                let ring_steps = 32;
                while s < ring_steps {
                    let a0 = TAU * s / ring_steps;
                    let a1 = TAU * (s + 1) / ring_steps;
                    let q0 = _project_3d_point(r_ring * num_cos(a0), r_ring * num_sin(a0), z_ring, st.cam_3d, vp);
                    let q1 = _project_3d_point(r_ring * num_cos(a1), r_ring * num_sin(a1), z_ring, st.cam_3d, vp);
                    array_push(depth_queue, map{
                        ptype: "line", z_depth: 0.5 * (q0.z_depth + q1.z_depth) - 0.1,
                        x1: q0.sx, y1: q0.sy, x2: q1.sx, y2: q1.sy,
                        color: if lat_i == 0 { [34, 211, 238, 150] } else { [52, 74, 98, 110] }, width: if lat_i == 0 { 1.6 } else { 1.0 }, dashed: false
                    });
                    s = s + 1;
                }
                lat_i = lat_i + 1;
            }
            // North Pole (infinity) & South Pole (0)
            let np3 = _project_3d_point(0.0, 0.0, R_sph, st.cam_3d, vp);
            let sp3 = _project_3d_point(0.0, 0.0, 0.0 - R_sph, st.cam_3d, vp);
            array_push(depth_queue, map{ ptype: "circle", z_depth: np3.z_depth, cx: np3.sx, cy: np3.sy, r: 5.0, fill_color: th.coral, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "Βόρειος Πόλος z = ∞" });
            array_push(depth_queue, map{ ptype: "circle", z_depth: sp3.z_depth, cx: sp3.sx, cy: sp3.sy, r: 5.0, fill_color: th.cyan, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "Νότιος Πόλος z = 0" });

            // Stereographically project complex points z = [re, im] onto S^2
            let prev_s = nil;
            let ci = 0;
            while ci < len(lyr.complex_items) {
                let cz = lyr.complex_items[ci];
                let sx3 = 0.0; let sy3 = 0.0; let sz3 = R_sph;
                if type(cz) == "string" and str_lower(cz) == "inf" {
                    sx3 = 0.0; sy3 = 0.0; sz3 = R_sph;
                } else if is_array(cz) and len(cz) >= 2 {
                    let u = _num_or(cz[0], 0.0);
                    let v = _num_or(cz[1], 0.0);
                    let r2 = u * u + v * v;
                    sx3 = R_sph * (2.0 * u) / (r2 + 1.0);
                    sy3 = R_sph * (2.0 * v) / (r2 + 1.0);
                    sz3 = R_sph * (r2 - 1.0) / (r2 + 1.0);
                }
                let qz = _project_3d_point(sx3, sy3, sz3, st.cam_3d, vp);
                array_push(depth_queue, map{ ptype: "circle", z_depth: qz.z_depth + 0.05, cx: qz.sx, cy: qz.sy, r: 4.5, fill_color: th.emerald, stroke_color: th.card, stroke_width: 1.2, hollow: false, tooltip: "S² σημείο #" + str(ci + 1) });
                if prev_s != nil {
                    array_push(depth_queue, map{ ptype: "line", z_depth: 0.5 * (prev_s.z_depth + qz.z_depth) + 0.02, x1: prev_s.sx, y1: prev_s.sy, x2: qz.sx, y2: qz.sy, color: th.amber, width: 1.9, dashed: false });
                }
                prev_s = qz;
                ci = ci + 1;
            }

        // ── 27. Force-Directed Network Graph (2D or 3D) ──────────────────────
        } else if knd == "network_graph" {
            let pos = lyr.positions;
            let n_cnt = len(pos);
            let ei = 0;
            while ei < len(lyr.edges) {
                let ed = lyr.edges[ei];
                let u_raw = if is_array(ed) { ed[0] } else { try ed.src catch (try ed.u catch 0) };
                let v_raw = if is_array(ed) { ed[1] } else { try ed.dst catch (try ed.v catch 0) };
                let ui = if map_has(lyr.id_map, str(u_raw)) { lyr.id_map[str(u_raw)] } else { _clamp(_int_or(u_raw, 0), 0, _max(0, n_cnt - 1)) };
                let vi = if map_has(lyr.id_map, str(v_raw)) { lyr.id_map[str(v_raw)] } else { _clamp(_int_or(v_raw, 0), 0, _max(0, n_cnt - 1)) };
                if ui < n_cnt and vi < n_cnt {
                    if lyr.net_dim == 3 {
                        let qa = _project_3d_point(pos[ui][0], pos[ui][1], pos[ui][2], st.cam_3d, vp);
                        let qb = _project_3d_point(pos[vi][0], pos[vi][1], pos[vi][2], st.cam_3d, vp);
                        array_push(depth_queue, map{ ptype: "line", z_depth: 0.5 * (qa.z_depth + qb.z_depth), x1: qa.sx, y1: qa.sy, x2: qb.sx, y2: qb.sy, color: [147, 197, 253, 175], width: 1.6, dashed: false });
                    } else {
                        array_push(lines, map{ x1: _wx(pos[ui][0], b2d, vp), y1: _wy(pos[ui][1], b2d, vp), x2: _wx(pos[vi][0], b2d, vp), y2: _wy(pos[vi][1], b2d, vp), color: [147, 197, 253, 175], width: 1.6, dashed: false });
                    }
                }
                ei = ei + 1;
            }
            let ni = 0;
            while ni < n_cnt {
                let nd = lyr.nodes[ni];
                let nlbl = if is_map(nd) and map_has(nd, "label") { str(nd.label) } else if is_map(nd) and map_has(nd, "id") { str(nd.id) } else { str(nd) };
                let ncol = _series_palette(ni);
                if lyr.net_dim == 3 {
                    let qn = _project_3d_point(pos[ni][0], pos[ni][1], pos[ni][2], st.cam_3d, vp);
                    array_push(depth_queue, map{ ptype: "circle", z_depth: qn.z_depth + 0.08, cx: qn.sx, cy: qn.sy, r: 6.5, fill_color: ncol, stroke_color: th.card, stroke_width: 1.5, hollow: false, tooltip: "Κόμβος " + nlbl });
                    array_push(texts, map{ x: qn.sx + 8, y: qn.sy - 6, text: nlbl, color: th.text, px: 11, align: "left" });
                } else {
                    let sx = _wx(pos[ni][0], b2d, vp);
                    let sy = _wy(pos[ni][1], b2d, vp);
                    array_push(circles, map{ cx: sx, cy: sy, r: 6.5, fill_color: ncol, stroke_color: th.card, stroke_width: 1.5, hollow: false, tooltip: "Κόμβος " + nlbl });
                    array_push(texts, map{ x: sx + 8, y: sy - 6, text: nlbl, color: th.text, px: 11, align: "left" });
                }
                ni = ni + 1;
            }
        }

        v_idx = v_idx + 1;
    }

    // Painter's Algorithm Depth-Sort for all 3D/4D/ND-3D primitives!
    if len(depth_queue) > 0 {
        _sort_by_z_depth(depth_queue);
        let di = 0;
        while di < len(depth_queue) {
            let item = depth_queue[di];
            if item.ptype == "poly" {
                array_push(polygons, item);
            } else if item.ptype == "line" {
                array_push(lines, item);
            } else if item.ptype == "circle" {
                array_push(circles, item);
            }
            di = di + 1;
        }
    }

    let stats = map{
        total_layers: len(st.layers),
        visible_layers: len(vis_layers),
        rect_count: len(rects),
        line_count: len(lines),
        polygon_count: len(polygons),
        circle_count: len(circles),
        text_count: len(texts),
        primitive_count: len(rects) + len(lines) + len(polygons) + len(circles) + len(texts),
        bounds_2d: b2d,
        cam_3d: st.cam_3d,
        angles_4d: st.angles_4d,
        slice_4d: st.slice_4d,
        brushed_dims: len(map_keys(st.brushes)),
        pca_explained_variance_pct: if pca_stats != nil { pca_stats.explained_variance_pct } else { [] },
        pca_total_explained_pct: if pca_stats != nil { pca_stats.total_explained_pct } else { 0.0 }
    };

    return map{
        width: w,
        height: h,
        viewport: vp,
        bg: th.bg,
        theme: th,
        rects: rects,
        lines: lines,
        polygons: polygons,
        circles: circles,
        texts: texts,
        tooltips: tooltips,
        stats: stats
    };
}

// ============================================================================
// 7. Crisp Obsidian/Alabaster SVG Renderer & 24-Bit Pure-PBLang BMP Rasterizer
// ============================================================================

fn _svg_opacity_attr(rgba, attr_name) {
    if not is_array(rgba) or len(rgba) < 4 { return ""; }
    let a = _clamp(rgba[3], 0, 255);
    if a >= 254 { return ""; }
    return " " + attr_name + "=\"" + _fmt_fixed(a / 255.0, 2) + "\"";
}

fn render_primitives_svg(prims, opts = nil) {
    let w = prims.width;
    let h = prims.height;
    let out = [];
    array_push(out, "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" font-family=\"system-ui, -apple-system, Segoe UI, Noto Sans, sans-serif\">");
    array_push(out, "  <rect x=\"0\" y=\"0\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" fill=\"" + rgba_to_hex(prims.bg) + "\"/>");

    // 1. Rectangles
    let ri = 0;
    while ri < len(prims.rects) {
        let rc = prims.rects[ri];
        let rad = _num_or(try rc.radius catch 0, 0);
        let rx_attr = if rad > 0 { " rx=\"" + _fmt_num(rad, 1) + "\"" } else { "" };
        let st_col = try rc.stroke_color catch nil;
        let st_attr = if st_col != nil { " stroke=\"" + rgba_to_hex(st_col) + "\" stroke-width=\"1\"" } else { "" };
        let tip = _str_or(try rc.tooltip catch "", "");
        let tag_start = "  <rect x=\"" + _fmt_num(rc.x, 1) + "\" y=\"" + _fmt_num(rc.y, 1) + "\" width=\"" + _fmt_num(_max(0.5, rc.w), 1) + "\" height=\"" + _fmt_num(_max(0.5, rc.h), 1) + "\"" + rx_attr + " fill=\"" + rgba_to_hex(rc.color) + "\"" + _svg_opacity_attr(rc.color, "fill-opacity") + st_attr;
        if tip != "" {
            array_push(out, tag_start + "><title>" + svg_escape(tip) + "</title></rect>");
        } else {
            array_push(out, tag_start + "/>");
        }
        ri = ri + 1;
    }

    // 2. Polygons (depth-sorted 3D quads, shaded integrals, radar webs)
    let pi = 0;
    while pi < len(prims.polygons) {
        let pg = prims.polygons[pi];
        let pts_s = [];
        let k = 0;
        while k < len(pg.points) {
            array_push(pts_s, _fmt_num(pg.points[k][0], 1) + "," + _fmt_num(pg.points[k][1], 1));
            k = k + 1;
        }
        if len(pts_s) >= 3 {
            let fcol = pg.fill_color;
            let scol = pg.stroke_color;
            let sw = _num_or(try pg.stroke_width catch 1.0, 1.0);
            let tip = _str_or(try pg.tooltip catch "", "");
            let p_open = "  <polygon points=\"" + str_join(pts_s, " ") + "\" fill=\"" + rgba_to_hex(fcol) + "\"" + _svg_opacity_attr(fcol, "fill-opacity") + " stroke=\"" + rgba_to_hex(scol) + "\"" + _svg_opacity_attr(scol, "stroke-opacity") + " stroke-width=\"" + _fmt_num(sw, 1) + "\" stroke-linejoin=\"round\"";
            if tip != "" {
                array_push(out, p_open + "><title>" + svg_escape(tip) + "</title></polygon>");
            } else {
                array_push(out, p_open + "/>");
            }
        }
        pi = pi + 1;
    }

    // 3. Lines
    let li = 0;
    while li < len(prims.lines) {
        let ln = prims.lines[li];
        if _is_finite(ln.x1) and _is_finite(ln.y1) and _is_finite(ln.x2) and _is_finite(ln.y2) {
            let dash = if _bool_or(try ln.dashed catch false, false) { " stroke-dasharray=\"5,4\"" } else { "" };
            let lw = _num_or(try ln.width catch 1.5, 1.5);
            array_push(out, "  <line x1=\"" + _fmt_num(ln.x1, 1) + "\" y1=\"" + _fmt_num(ln.y1, 1) + "\" x2=\"" + _fmt_num(ln.x2, 1) + "\" y2=\"" + _fmt_num(ln.y2, 1) + "\" stroke=\"" + rgba_to_hex(ln.color) + "\"" + _svg_opacity_attr(ln.color, "stroke-opacity") + " stroke-width=\"" + _fmt_num(lw, 1) + "\" stroke-linecap=\"round\"" + dash + "/>");
        }
        li = li + 1;
    }

    // 4. Circles & Markers
    let ci = 0;
    while ci < len(prims.circles) {
        let cc = prims.circles[ci];
        if _is_finite(cc.cx) and _is_finite(cc.cy) {
            let is_hol = _bool_or(try cc.hollow catch false, false);
            let f_attr = if is_hol and cc.fill_color[3] == 0 { "none" } else { rgba_to_hex(cc.fill_color) };
            let f_op = if f_attr == "none" { "" } else { _svg_opacity_attr(cc.fill_color, "fill-opacity") };
            let sw = _num_or(try cc.stroke_width catch 1.5, 1.5);
            let tip = _str_or(try cc.tooltip catch "", "");
            let c_open = "  <circle cx=\"" + _fmt_num(cc.cx, 1) + "\" cy=\"" + _fmt_num(cc.cy, 1) + "\" r=\"" + _fmt_num(_max(1.0, cc.r), 1) + "\" fill=\"" + f_attr + "\"" + f_op + " stroke=\"" + rgba_to_hex(cc.stroke_color) + "\" stroke-width=\"" + _fmt_num(sw, 1) + "\"";
            if tip != "" {
                array_push(out, c_open + "><title>" + svg_escape(tip) + "</title></circle>");
            } else {
                array_push(out, c_open + "/>");
            }
        }
        ci = ci + 1;
    }

    // 5. Crisp Text Labels
    let ti = 0;
    while ti < len(prims.texts) {
        let tx = prims.texts[ti];
        let al = _str_or(try tx.align catch "left", "left");
        let anchor = if al == "right" { "end" } else if al == "center" { "middle" } else { "start" };
        let px_sz = _int_or(try tx.px catch 12, 12);
        array_push(out, "  <text x=\"" + _fmt_num(tx.x, 1) + "\" y=\"" + _fmt_num(tx.y + px_sz * 0.85, 1) + "\" fill=\"" + rgba_to_hex(tx.color) + "\" font-size=\"" + str(px_sz) + "\" text-anchor=\"" + anchor + "\">" + svg_escape(tx.text) + "</text>");
        ti = ti + 1;
    }

    array_push(out, "</svg>");
    return str_join(out, "\n");
}

// ── 24-bit Uncompressed BMP Byte Rasterizer (100% Pure PBLang) ───────────────

fn _put_u16_le(buf, offset, val) {
    let v = num_floor(val);
    buf[offset] = bit_and(v, 255);
    buf[offset + 1] = bit_and(bit_shr(v, 8), 255);
}

fn _put_u32_le(buf, offset, val) {
    let v = num_floor(val);
    buf[offset] = bit_and(v, 255);
    buf[offset + 1] = bit_and(bit_shr(v, 8), 255);
    buf[offset + 2] = bit_and(bit_shr(v, 16), 255);
    buf[offset + 3] = bit_and(bit_shr(v, 24), 255);
}

fn _bmp_set_px(buf, w, h, stride, px_x, px_y, rgba) {
    let x = num_floor(px_x);
    let y = num_floor(px_y);
    if x < 0 or x >= w or y < 0 or y >= h { return; }
    // Bottom-up BMP scanline index
    let bmp_row = h - 1 - y;
    let idx = 54 + bmp_row * stride + x * 3;
    let a = if len(rgba) >= 4 { rgba[3] } else { 255 };
    if a <= 2 { return; }
    if a >= 250 {
        buf[idx] = rgba[2];
        buf[idx + 1] = rgba[1];
        buf[idx + 2] = rgba[0];
    } else {
        let inv_a = 255 - a;
        buf[idx] = num_floor((rgba[2] * a + buf[idx] * inv_a) / 255);
        buf[idx + 1] = num_floor((rgba[1] * a + buf[idx + 1] * inv_a) / 255);
        buf[idx + 2] = num_floor((rgba[0] * a + buf[idx + 2] * inv_a) / 255);
    }
}

fn _bmp_fill_rect(buf, w, h, stride, rx, ry, rw, rh, rgba) {
    let x0 = _clamp(num_floor(rx), 0, w);
    let y0 = _clamp(num_floor(ry), 0, h);
    let x1 = _clamp(num_floor(rx + rw), 0, w);
    let y1 = _clamp(num_floor(ry + rh), 0, h);
    let a = if len(rgba) >= 4 { rgba[3] } else { 255 };
    if a <= 2 or x1 <= x0 or y1 <= y0 { return; }
    let r = rgba[0]; let g = rgba[1]; let b = rgba[2];
    let y = y0;
    if a >= 250 {
        while y < y1 {
            let base = 54 + (h - 1 - y) * stride + x0 * 3;
            let count = x1 - x0;
            let k = 0;
            while k < count {
                let p = base + k * 3;
                buf[p] = b; buf[p + 1] = g; buf[p + 2] = r;
                k = k + 1;
            }
            y = y + 1;
        }
    } else {
        let inv_a = 255 - a;
        while y < y1 {
            let base = 54 + (h - 1 - y) * stride + x0 * 3;
            let count = x1 - x0;
            let k = 0;
            while k < count {
                let p = base + k * 3;
                buf[p] = num_floor((b * a + buf[p] * inv_a) / 255);
                buf[p + 1] = num_floor((g * a + buf[p + 1] * inv_a) / 255);
                buf[p + 2] = num_floor((r * a + buf[p + 2] * inv_a) / 255);
                k = k + 1;
            }
            y = y + 1;
        }
    }
}

fn _bmp_draw_line(buf, w, h, stride, x1_f, y1_f, x2_f, y2_f, rgba, dashed = false) {
    if not _is_finite(x1_f) or not _is_finite(y1_f) or not _is_finite(x2_f) or not _is_finite(y2_f) { return; }
    let x0 = num_floor(x1_f + 0.5);
    let y0 = num_floor(y1_f + 0.5);
    let x1 = num_floor(x2_f + 0.5);
    let y1 = num_floor(y2_f + 0.5);
    let dx = _abs(x1 - x0);
    let sx = if x0 < x1 { 1 } else { -1 };
    let dy = 0 - _abs(y1 - y0);
    let sy = if y0 < y1 { 1 } else { -1 };
    let err = dx + dy;
    let step = 0;
    let guard = w + h + 64;
    while step < guard {
        if not dashed or num_mod(num_floor(step / 4), 2) == 0 {
            _bmp_set_px(buf, w, h, stride, x0, y0, rgba);
        }
        if x0 == x1 and y0 == y1 { break; }
        let e2 = 2 * err;
        if e2 >= dy { err = err + dy; x0 = x0 + sx; }
        if e2 <= dx { err = err + dx; y0 = y0 + sy; }
        step = step + 1;
    }
}

fn _bmp_fill_triangle(buf, w, h, stride, p0, p1, p2, rgba) {
    let min_x = _clamp(num_floor(_min(p0[0], _min(p1[0], p2[0]))), 0, w - 1);
    let max_x = _clamp(num_ceil(_max(p0[0], _max(p1[0], p2[0]))), 0, w - 1);
    let min_y = _clamp(num_floor(_min(p0[1], _min(p1[1], p2[1]))), 0, h - 1);
    let max_y = _clamp(num_ceil(_max(p0[1], _max(p1[1], p2[1]))), 0, h - 1);
    let area = (p1[0] - p0[0]) * (p2[1] - p0[1]) - (p1[1] - p0[1]) * (p2[0] - p0[0]);
    if _abs(area) < 0.5 { return; }
    let sgn = if area > 0.0 { 1.0 } else { -1.0 };
    let y = min_y;
    while y <= max_y {
        let py = y + 0.5;
        let x = min_x;
        while x <= max_x {
            let px = x + 0.5;
            let w0 = ((p2[0] - p1[0]) * (py - p1[1]) - (p2[1] - p1[1]) * (px - p1[0])) * sgn;
            let w1 = ((p0[0] - p2[0]) * (py - p2[1]) - (p0[1] - p2[1]) * (px - p2[0])) * sgn;
            let w2 = ((p1[0] - p0[0]) * (py - p0[1]) - (p1[1] - p0[1]) * (px - p0[0])) * sgn;
            if w0 >= 0.0 and w1 >= 0.0 and w2 >= 0.0 {
                _bmp_set_px(buf, w, h, stride, x, y, rgba);
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

fn _bmp_draw_circle(buf, w, h, stride, cx_f, cy_f, rad_f, fill_rgba, stroke_rgba, hollow) {
    let r = _max(1, num_floor(rad_f + 0.5));
    let cx = num_floor(cx_f + 0.5);
    let cy = num_floor(cy_f + 0.5);
    let r2_outer = r * r;
    let r2_inner = _max(0, (r - 2) * (r - 2));
    let dy = 0 - r;
    while dy <= r {
        let dx = 0 - r;
        while dx <= r {
            let d2 = dx * dx + dy * dy;
            if d2 <= r2_outer {
                if d2 >= r2_inner {
                    _bmp_set_px(buf, w, h, stride, cx + dx, cy + dy, stroke_rgba);
                } else if not hollow {
                    _bmp_set_px(buf, w, h, stride, cx + dx, cy + dy, fill_rgba);
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

fn render_primitives_bmp_bytes(prims, opts = nil) {
    let w = prims.width;
    let h = prims.height;
    let stride = num_floor((w * 3 + 3) / 4) * 4;
    let img_bytes = stride * h;
    let total_bytes = 54 + img_bytes;

    let buf = [];
    let hi = 0;
    while hi < 54 { array_push(buf, 0); hi = hi + 1; }

    let bg_r = prims.bg[0];
    let bg_g = prims.bg[1];
    let bg_b = prims.bg[2];
    let pad_cnt = stride - w * 3;
    let row_idx = 0;
    while row_idx < h {
        let col_idx = 0;
        while col_idx < w {
            array_push(buf, bg_b);
            array_push(buf, bg_g);
            array_push(buf, bg_r);
            col_idx = col_idx + 1;
        }
        let pi = 0;
        while pi < pad_cnt { array_push(buf, 0); pi = pi + 1; }
        row_idx = row_idx + 1;
    }

    // 14-byte BITMAPFILEHEADER ('BM') + 40-byte BITMAPINFOHEADER
    buf[0] = 66; // 'B'
    buf[1] = 77; // 'M'
    _put_u32_le(buf, 2, total_bytes);
    _put_u32_le(buf, 10, 54);
    _put_u32_le(buf, 14, 40);
    _put_u32_le(buf, 18, w);
    _put_u32_le(buf, 22, h);
    _put_u16_le(buf, 26, 1);
    _put_u16_le(buf, 28, 24);
    _put_u32_le(buf, 30, 0);
    _put_u32_le(buf, 34, img_bytes);
    _put_u32_le(buf, 38, 2835);
    _put_u32_le(buf, 42, 2835);

    // Rasterize rectangles
    let ri = 0;
    while ri < len(prims.rects) {
        let rc = prims.rects[ri];
        _bmp_fill_rect(buf, w, h, stride, rc.x, rc.y, rc.w, rc.h, rc.color);
        let sc = try rc.stroke_color catch nil;
        if sc != nil {
            _bmp_draw_line(buf, w, h, stride, rc.x, rc.y, rc.x + rc.w, rc.y, sc, false);
            _bmp_draw_line(buf, w, h, stride, rc.x, rc.y + rc.h, rc.x + rc.w, rc.y + rc.h, sc, false);
            _bmp_draw_line(buf, w, h, stride, rc.x, rc.y, rc.x, rc.y + rc.h, sc, false);
            _bmp_draw_line(buf, w, h, stride, rc.x + rc.w, rc.y, rc.x + rc.w, rc.y + rc.h, sc, false);
        }
        ri = ri + 1;
    }

    // Rasterize polygons (triangle fan + outline)
    let pgi = 0;
    while pgi < len(prims.polygons) {
        let pg = prims.polygons[pgi];
        let pts = pg.points;
        if len(pts) >= 3 {
            let k = 1;
            while k + 1 < len(pts) {
                _bmp_fill_triangle(buf, w, h, stride, pts[0], pts[k], pts[k + 1], pg.fill_color);
                k = k + 1;
            }
            k = 0;
            while k < len(pts) {
                let nxt = pts[num_mod(k + 1, len(pts))];
                _bmp_draw_line(buf, w, h, stride, pts[k][0], pts[k][1], nxt[0], nxt[1], pg.stroke_color, false);
                k = k + 1;
            }
        }
        pgi = pgi + 1;
    }

    // Rasterize lines
    let li = 0;
    while li < len(prims.lines) {
        let ln = prims.lines[li];
        _bmp_draw_line(buf, w, h, stride, ln.x1, ln.y1, ln.x2, ln.y2, ln.color, _bool_or(try ln.dashed catch false, false));
        li = li + 1;
    }

    // Rasterize circles
    let ci = 0;
    while ci < len(prims.circles) {
        let cc = prims.circles[ci];
        _bmp_draw_circle(buf, w, h, stride, cc.cx, cc.cy, cc.r, cc.fill_color, cc.stroke_color, _bool_or(try cc.hollow catch false, false));
        ci = ci + 1;
    }

    // Rasterize bitmap_font text labels
    let ti = 0;
    while ti < len(prims.texts) {
        let tx = prims.texts[ti];
        let label_str = str(tx.text);
        let draw_x = num_floor(tx.x);
        let al = _str_or(try tx.align catch "left", "left");
        if al == "right" { draw_x = draw_x - len(label_str) * 6; }
        else if al == "center" { draw_x = draw_x - len(label_str) * 3; }
        let draw_y = num_floor(tx.y);
        let col = tx.color;
        BF.draw_text(fn(px_x, px_y, c_val) {
            _bmp_set_px(buf, w, h, stride, px_x, px_y, c_val);
        }, draw_x, draw_y, label_str, col);
        ti = ti + 1;
    }

    return buf;
}

// ============================================================================
// 8. Scene & Layer Manager + Spatial Manipulators + Live Loop (`create_scene`)
// ============================================================================

fn _refresh_layer_after_patch(lyr) {
    if lyr.kind == "2d_explicit" and map_has(lyr, "expr") {
        lyr.compiled = compile_math_expr(lyr.expr);
    } else if lyr.kind == "2d_implicit" and map_has(lyr, "f_xy_expr") {
        lyr.f_comp = compile_math_expr(lyr.f_xy_expr);
    } else if lyr.kind == "2d_polar" and map_has(lyr, "r_expr") {
        lyr.r_comp = compile_math_expr(lyr.r_expr);
    } else if lyr.kind == "3d_surface" and map_has(lyr, "z_xy_expr") {
        lyr.z_comp = compile_math_expr(lyr.z_xy_expr);
    } else if lyr.kind == "4d_polytope" and map_has(lyr, "poly_kind") {
        let poly = _build_4d_polytope(lyr.poly_kind);
        lyr.vertices = poly.vertices;
        lyr.edges = poly.edges;
        lyr.faces = poly.faces;
    } else if lyr.kind == "nd_pca_projection" and map_has(lyr, "data") {
        lyr.pca_model = compute_pca_subspace(lyr.data, lyr.target_dim);
    }
}

fn create_scene(opts = nil) {
    let o = if opts != nil and is_map(opts) { opts } else { map{} };
    let init_nd = _clamp(_int_or(try o.nd_dim catch 6, 6), 4, 12);
    let st = map{
        title: _str_or(try o.title catch "", ""),
        subtitle: _str_or(try o.subtitle catch "", ""),
        dark_mode: _bool_or(try o.dark_mode catch true, true),
        compact: _bool_or(try o.compact catch false, false),
        show_grid: _bool_or(try o.show_grid catch true, true),
        show_axes: _bool_or(try o.show_axes catch true, true),
        next_layer_id: 1,
        layers: [],
        env: if map_has(o, "env") and is_map(o.env) { o.env } else { map{ t: 0.0, omega: 2.2, a: 1.0, b: 1.0, k: 1.0 } },
        bounds_2d: map{
            xmin: _num_or(try o.xmin catch -6.0, -6.0),
            xmax: _num_or(try o.xmax catch 6.0, 6.0),
            ymin: _num_or(try o.ymin catch -4.0, -4.0),
            ymax: _num_or(try o.ymax catch 4.0, 4.0)
        },
        cam_3d: map{
            yaw: _num_or(try o.yaw catch 38.0, 38.0),
            pitch: _num_or(try o.pitch catch 26.0, 26.0),
            roll: _num_or(try o.roll catch 0.0, 0.0),
            zoom: _num_or(try o.zoom catch 1.0, 1.0),
            perspective: _bool_or(try o.perspective catch true, true),
            pan_x: 0.0,
            pan_y: 0.0
        },
        rotor_4d: _eye_mat(4),
        w_eye_4d: _num_or(try o.w_eye catch 3.5, 3.5),
        rot4_ops: 0,
        angles_4d: map{ xw: 0.0, yw: 0.0, zw: 0.0, xy: 0.0, xz: 0.0, yz: 0.0 },
        slice_4d: map{ active: false, axis: "w", val: 0.0 },
        rotor_nd: _eye_mat(init_nd),
        rotnd_ops: 0,
        brushes: map{},
        axis_perm: nil
    };

    let api = map{ state: st };

    // 1. Scene & Layer Manager
    api.add_layer = fn(layer_spec) {
        let lid = st.next_layer_id;
        st.next_layer_id = st.next_layer_id + 1;
        layer_spec.id = lid;
        if not map_has(layer_spec, "visible") { layer_spec.visible = true; }
        if layer_spec.kind == "nd_hypercube" { _ensure_rotor_dim(st, layer_spec.dim_n); }
        array_push(st.layers, layer_spec);
        return lid;
    };

    api.update_layer = fn(layer_id, patch_map) {
        let target = str(layer_id);
        let i = 0;
        while i < len(st.layers) {
            let lyr = st.layers[i];
            if str(lyr.id) == target {
                if patch_map != nil and is_map(patch_map) {
                    let pkeys = map_keys(patch_map);
                    let pk = 0;
                    while pk < len(pkeys) {
                        let key = pkeys[pk];
                        if key == "opts" and is_map(patch_map.opts) {
                            let ok_list = map_keys(patch_map.opts);
                            let oi = 0;
                            while oi < len(ok_list) {
                                let okey = ok_list[oi];
                                lyr.opts[okey] = patch_map.opts[okey];
                                oi = oi + 1;
                            }
                        } else {
                            lyr[key] = patch_map[key];
                        }
                        pk = pk + 1;
                    }
                    _refresh_layer_after_patch(lyr);
                }
                return true;
            }
            i = i + 1;
        }
        return false;
    };

    api.remove_layer = fn(layer_id) {
        let target = str(layer_id);
        let kept = [];
        let removed = false;
        let i = 0;
        while i < len(st.layers) {
            if str(st.layers[i].id) == target { removed = true; }
            else { array_push(kept, st.layers[i]); }
            i = i + 1;
        }
        st.layers = kept;
        return removed;
    };

    api.toggle_layer = fn(layer_id, visible_bool = nil) {
        let target = str(layer_id);
        let i = 0;
        while i < len(st.layers) {
            if str(st.layers[i].id) == target {
                if visible_bool == nil { st.layers[i].visible = not st.layers[i].visible; }
                else { st.layers[i].visible = _bool_or(visible_bool, true); }
                return st.layers[i].visible;
            }
            i = i + 1;
        }
        return false;
    };

    api.list_layers = fn() {
        let info = [];
        let i = 0;
        while i < len(st.layers) {
            let lyr = st.layers[i];
            array_push(info, map{
                id: lyr.id,
                kind: lyr.kind,
                space: lyr.space,
                label: lyr.label,
                visible: lyr.visible
            });
            i = i + 1;
        }
        return info;
    };

    api.clear_layers = fn() {
        st.layers = [];
        return 0;
    };

    // 2. 2D / 3D / 4D / N-D Spatial & Dimensional Manipulators
    api.pan = fn(dx, dy) {
        let ddx = _num_or(dx, 0.0);
        let ddy = _num_or(dy, 0.0);
        st.bounds_2d.xmin = st.bounds_2d.xmin + ddx;
        st.bounds_2d.xmax = st.bounds_2d.xmax + ddx;
        st.bounds_2d.ymin = st.bounds_2d.ymin + ddy;
        st.bounds_2d.ymax = st.bounds_2d.ymax + ddy;
        st.cam_3d.pan_x = st.cam_3d.pan_x + ddx;
        st.cam_3d.pan_y = st.cam_3d.pan_y + ddy;
        return st.bounds_2d;
    };

    api.zoom = fn(factor) {
        let f = _clamp(_num_or(factor, 1.0), 0.05, 40.0);
        let cx = 0.5 * (st.bounds_2d.xmin + st.bounds_2d.xmax);
        let cy = 0.5 * (st.bounds_2d.ymin + st.bounds_2d.ymax);
        let hx = _max(1e-4, 0.5 * (st.bounds_2d.xmax - st.bounds_2d.xmin) / f);
        let hy = _max(1e-4, 0.5 * (st.bounds_2d.ymax - st.bounds_2d.ymin) / f);
        st.bounds_2d.xmin = cx - hx;
        st.bounds_2d.xmax = cx + hx;
        st.bounds_2d.ymin = cy - hy;
        st.bounds_2d.ymax = cy + hy;
        st.cam_3d.zoom = _clamp(st.cam_3d.zoom * f, 0.15, 12.0);
        return st.bounds_2d;
    };

    api.set_bounds_2d = fn(xmin, xmax, ymin, ymax) {
        let x0 = _num_or(xmin, -6.0);
        let x1 = _num_or(xmax, 6.0);
        let y0 = _num_or(ymin, -4.0);
        let y1 = _num_or(ymax, 4.0);
        if x1 <= x0 { x1 = x0 + 1.0; }
        if y1 <= y0 { y1 = y0 + 1.0; }
        st.bounds_2d.xmin = x0; st.bounds_2d.xmax = x1;
        st.bounds_2d.ymin = y0; st.bounds_2d.ymax = y1;
        return st.bounds_2d;
    };

    api.rotate_3d = fn(d_yaw_deg, d_pitch_deg, d_roll_deg = 0.0) {
        st.cam_3d.yaw = st.cam_3d.yaw + _num_or(d_yaw_deg, 0.0);
        st.cam_3d.pitch = _clamp(st.cam_3d.pitch + _num_or(d_pitch_deg, 0.0), -88.0, 88.0);
        st.cam_3d.roll = st.cam_3d.roll + _num_or(d_roll_deg, 0.0);
        return st.cam_3d;
    };

    api.set_camera_3d = fn(yaw, pitch, roll = 0.0, zoom_val = 1.0, perspective_bool = true) {
        st.cam_3d.yaw = _num_or(yaw, 38.0);
        st.cam_3d.pitch = _clamp(_num_or(pitch, 26.0), -88.0, 88.0);
        st.cam_3d.roll = _num_or(roll, 0.0);
        st.cam_3d.zoom = _clamp(_num_or(zoom_val, 1.0), 0.15, 12.0);
        st.cam_3d.perspective = _bool_or(perspective_bool, true);
        return st.cam_3d;
    };

    api.rotate_4d = fn(plane_name, d_angle_rad) {
        let info = _plane_indices_4d(plane_name);
        let ang = _num_or(d_angle_rad, 0.0) * info[2];
        _apply_givens_left(st.rotor_4d, info[0], info[1], ang);
        st.rot4_ops = st.rot4_ops + 1;
        if num_mod(st.rot4_ops, 32) == 0 {
            _orthonormalize_rows(st.rotor_4d);
        }
        let pk = str_lower(str_trim(str(plane_name)));
        if map_has(st.angles_4d, pk) {
            st.angles_4d[pk] = st.angles_4d[pk] + _num_or(d_angle_rad, 0.0);
        }
        return st.rotor_4d;
    };

    api.set_slice = fn(axis_name, slice_val) {
        if axis_name == nil {
            st.slice_4d.active = false;
            return st.slice_4d;
        }
        st.slice_4d.active = true;
        st.slice_4d.axis = str_lower(str_trim(str(axis_name)));
        st.slice_4d.val = _num_or(slice_val, 0.0);
        return st.slice_4d;
    };

    api.clear_slice = fn() {
        st.slice_4d.active = false;
        return st.slice_4d;
    };

    api.rotate_nd = fn(dim_i, dim_j, d_angle_rad) {
        let i = _int_or(dim_i, 0);
        let j = _int_or(dim_j, 1);
        let req = _max(i, j) + 1;
        _ensure_rotor_dim(st, req);
        _apply_givens_left(st.rotor_nd, i, j, _num_or(d_angle_rad, 0.0));
        st.rotnd_ops = st.rotnd_ops + 1;
        if num_mod(st.rotnd_ops, 32) == 0 {
            _orthonormalize_rows(st.rotor_nd);
        }
        return st.rotor_nd;
    };

    api.set_brush = fn(dim_idx, lo_val, hi_val) {
        let d = _int_or(dim_idx, 0);
        let lo = _num_or(lo_val, 0.0);
        let hi = _num_or(hi_val, 1.0);
        let b_lo = _min(lo, hi);
        let b_hi = _max(lo, hi);
        st.brushes[str(d)] = map{ dim: d, lo: b_lo, hi: b_hi };
        return st.brushes;
    };

    api.clear_brushes = fn() {
        st.brushes = map{};
        return st.brushes;
    };

    api.reorder_axes = fn(perm_indices) {
        if is_array(perm_indices) {
            st.axis_perm = perm_indices;
        }
        return st.axis_perm;
    };

    api.set_env = fn(key, val) {
        st.env[str(key)] = val;
        return st.env;
    };

    // 3. Rendering & Live Telemetry Loop
    api.compile_primitives = fn(width = 880, height = 540, env = nil) {
        return _compile_scene_primitives(st, width, height, env);
    };

    api.render_svg = fn(width = 880, height = 540, r_opts = nil) {
        let saved_dark = st.dark_mode;
        if r_opts != nil and is_map(r_opts) and map_has(r_opts, "dark_mode") {
            st.dark_mode = _bool_or(r_opts.dark_mode, saved_dark);
        }
        let extra = if r_opts != nil and is_map(r_opts) and map_has(r_opts, "env") { r_opts.env } else { nil };
        let prims = _compile_scene_primitives(st, width, height, extra);
        st.dark_mode = saved_dark;
        return render_primitives_svg(prims, r_opts);
    };

    api.render_bmp_bytes = fn(width = 640, height = 400, r_opts = nil) {
        let saved_dark = st.dark_mode;
        if r_opts != nil and is_map(r_opts) and map_has(r_opts, "dark_mode") {
            st.dark_mode = _bool_or(r_opts.dark_mode, saved_dark);
        }
        let extra = if r_opts != nil and is_map(r_opts) and map_has(r_opts, "env") { r_opts.env } else { nil };
        let prims = _compile_scene_primitives(st, width, height, extra);
        st.dark_mode = saved_dark;
        return render_primitives_bmp_bytes(prims, r_opts);
    };

    api.play_live = fn(duration_ms = 300, tick_ms = 30, on_tick = nil) {
        let dur = _max(10, _int_or(duration_ms, 300));
        let tk = _clamp(_int_or(tick_ms, 30), 5, 250);
        let t_start = try time_ms() catch (try now_ms() catch 0.0);
        let frames = 0;
        let last_prim_cnt = 0;

        while true {
            let t_now = try time_ms() catch (try now_ms() catch (t_start + frames * tk));
            let elapsed = t_now - t_start;
            let t_sec = elapsed / 1000.0;
            st.env.t = t_sec;

            // Advance spatial rotors smoothly
            st.cam_3d.yaw = st.cam_3d.yaw + 2.4;
            api.rotate_4d("xw", 0.07);
            api.rotate_4d("yz", 0.04);
            if len(st.rotor_nd) >= 5 {
                api.rotate_nd(0, 4, 0.06);
            }

            let prims = _compile_scene_primitives(st, 640, 400, nil);
            last_prim_cnt = prims.stats.primitive_count;
            frames = frames + 1;

            if on_tick != nil and is_fn(on_tick) {
                let info = map{ frame: frames, elapsed_ms: elapsed, t: t_sec, stats: prims.stats };
                try on_tick(info, api) catch (try on_tick(frames, t_sec, api) catch (try on_tick(info) catch nil));
            }

            let after = try time_ms() catch (try now_ms() catch (t_now + 2.0));
            if after - t_start >= dur { break; }
            let work_dt = _max(0.0, after - t_now);
            let wait_ms = _max(1, num_floor(tk - work_dt));
            sleep_ms(wait_ms);
        }

        let t_end = try time_ms() catch (try now_ms() catch (t_start + dur));
        let total_ms = _max(1.0, t_end - t_start);
        return map{
            ok: true,
            frames: frames,
            elapsed_ms: total_ms,
            target_duration_ms: dur,
            tick_ms: tk,
            avg_fps: (frames * 1000.0) / total_ms,
            final_t: st.env.t,
            last_primitive_count: last_prim_cnt
        };
    };

    return api;
}

// Functional module-level wrappers & standalone quick plotters
fn add_layer(scene, layer_spec) { return scene.add_layer(layer_spec); }
fn update_layer(scene, layer_id, patch_map) { return scene.update_layer(layer_id, patch_map); }
fn remove_layer(scene, layer_id) { return scene.remove_layer(layer_id); }
fn toggle_layer(scene, layer_id, visible_bool = nil) { return scene.toggle_layer(layer_id, visible_bool); }
fn list_layers(scene) { return scene.list_layers(); }
fn clear_layers(scene) { return scene.clear_layers(); }
fn pan(scene, dx, dy) { return scene.pan(dx, dy); }
fn zoom(scene, factor) { return scene.zoom(factor); }
fn set_bounds_2d(scene, xmin, xmax, ymin, ymax) { return scene.set_bounds_2d(xmin, xmax, ymin, ymax); }
fn rotate_3d(scene, d_yaw_deg, d_pitch_deg, d_roll_deg = 0.0) { return scene.rotate_3d(d_yaw_deg, d_pitch_deg, d_roll_deg); }
fn set_camera_3d(scene, yaw, pitch, roll = 0.0, zoom_val = 1.0, perspective_bool = true) { return scene.set_camera_3d(yaw, pitch, roll, zoom_val, perspective_bool); }
fn rotate_4d(scene, plane_name, d_angle_rad) { return scene.rotate_4d(plane_name, d_angle_rad); }
fn set_slice(scene, axis_name, slice_val) { return scene.set_slice(axis_name, slice_val); }
fn rotate_nd(scene, dim_i, dim_j, d_angle_rad) { return scene.rotate_nd(dim_i, dim_j, d_angle_rad); }
fn set_brush(scene, dim_idx, lo_val, hi_val) { return scene.set_brush(dim_idx, lo_val, hi_val); }
fn clear_brushes(scene) { return scene.clear_brushes(); }
fn reorder_axes(scene, perm_indices) { return scene.reorder_axes(perm_indices); }
fn compile_primitives(scene, width = 880, height = 540, env = nil) { return scene.compile_primitives(width, height, env); }
fn render_svg(scene, width = 880, height = 540, opts = nil) { return scene.render_svg(width, height, opts); }
fn render_bmp_bytes(scene, width = 640, height = 400, opts = nil) { return scene.render_bmp_bytes(width, height, opts); }
fn play_live(scene, duration_ms = 300, tick_ms = 30, on_tick = nil) { return scene.play_live(duration_ms, tick_ms, on_tick); }

fn quick_svg(layer_spec, width = 880, height = 540, opts = nil) {
    let sc = create_scene(opts);
    sc.add_layer(layer_spec);
    return sc.render_svg(width, height, opts);
}

fn quick_bmp_bytes(layer_spec, width = 640, height = 400, opts = nil) {
    let sc = create_scene(opts);
    sc.add_layer(layer_spec);
    return sc.render_bmp_bytes(width, height, opts);
}

export ODG_VERSION, PI, TAU, E_VAL, PHI_VAL,
       svg_escape, rgba_to_hex, color_to_rgba, palette_perceptual, hsl_to_rgba, graph_theme,
       compile_math_expr, eval_compiled_expr, eval_complex_compiled,
       marching_squares_segments, compute_pca_subspace,
       layer_number_line, layer_histogram_kde, layer_boxplot, layer_deviation_bars,
       layer_2d_explicit, layer_bar_grouped, layer_scatter_regression,
       layer_2d_parametric, layer_2d_polar, layer_2d_implicit,
       layer_2d_contour_heatmap, layer_2d_vector_field, layer_complex_domain,
       layer_3d_surface, layer_3d_parametric_curve, layer_3d_parametric_surface, layer_3d_scatter_quiver,
       layer_4d_polytope, layer_4d_hypersurface_slice,
       layer_nd_hypercube, layer_nd_parallel_coords, layer_nd_radar, layer_nd_pca_projection, layer_nd_andrews_curves,
       layer_poincare_disk, layer_riemann_sphere, layer_network_graph,
       create_scene, add_layer, update_layer, remove_layer, toggle_layer, list_layers, clear_layers,
       pan, zoom, set_bounds_2d, rotate_3d, set_camera_3d, rotate_4d, set_slice,
       rotate_nd, set_brush, clear_brushes, reorder_axes,
       compile_primitives, render_primitives_svg, render_primitives_bmp_bytes,
       render_svg, render_bmp_bytes, play_live, quick_svg, quick_bmp_bytes;
