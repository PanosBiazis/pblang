// stdlib/math/linalg_geometry.sapp
// Exact & Numerical Linear Algebra, N-D Tensor Calculus, Differential Geometry,
// Analytic/Projective/Computational Geometry & WGS-84 Geodesic Geometry (PBLang v2.7.0).
//
// Self-contained pure PBLang stdlib module:
//   let lg = import("stdlib:math/linalg_geometry.sapp");

let GOV = import("stdlib:math/resource_governor.sapp");

// Legacy exported constants preserved for 100% backward compatibility;
// live runtime bounds adapt dynamically via `GOV.current_limits()`.
let MAX_DIM = 512;
let MAX_ITER = 2000;
let PI = 3.14159265358979323846;
let TAU = 6.28318530717958647692;
let EPS = 1e-12;
let _MACHINE_EPS = 2.220446049250313e-16;

// ============================================================================
// 0. Internal Validation, Sorting & Numeric Coercion Helpers
// ============================================================================

fn _max2(a, b) {
    if a >= b { return a; }
    return b;
}

fn _min2(a, b) {
    if a <= b { return a; }
    return b;
}

fn _sign_nonzero(x) {
    if x >= 0.0 { return 1.0; }
    return -1.0;
}

fn _is_rat_map(x) {
    return type(x) == "map" and map_has(x, "num") and map_has(x, "den");
}

fn _bg_zero() { return bigint(0); }
fn _bg_one()  { return bigint(1); }

fn _bg_abs(n) {
    let b = bigint(n);
    if b < _bg_zero() { return _bg_zero() - b; }
    return b;
}

fn _bg_gcd(a, b) {
    let x = _bg_abs(a);
    let y = _bg_abs(b);
    let z = _bg_zero();
    while y != z {
        let r = x % y;
        x = y;
        y = r;
    }
    return x;
}

fn _bg_lcm(a, b) {
    let z = _bg_zero();
    if a == z or b == z { return z; }
    let g = _bg_gcd(a, b);
    return _bg_abs((a / g) * b);
}

// Convert exact rational {num, den} to IEEE-754 f64 safely even for huge numerators/denominators.
fn _rat_to_f64_raw(num_b, den_b) {
    if den_b == _bg_zero() {
        throw "linalg_geometry: division by zero in rational conversion";
    }
    let sign = 1.0;
    let p = num_b;
    let q = den_b;
    if p < _bg_zero() {
        sign = -1.0;
        p = _bg_zero() - p;
    }
    if q < _bg_zero() {
        sign = 0.0 - sign;
        q = _bg_zero() - q;
    }
    let int_part = p / q;
    let rem_part = p % q;
    let scale = bigint("10000000000000000");
    let frac_scaled = (rem_part * scale) / q;
    let int_f = parse_number(str(int_part));
    let frac_f = parse_number(str(frac_scaled)) / 10000000000000000.0;
    return sign * (int_f + frac_f);
}

fn _num(x) {
    let t = type(x);
    if t == "number" { return x + 0.0; }
    if t == "bigint" { return parse_number(str(x)) + 0.0; }
    if _is_rat_map(x) { return _rat_to_f64_raw(x.num, x.den); }
    if t == "string" {
        let s = str_trim(x);
        let parts = str_split(s, "/");
        if len(parts) == 2 {
            return _rat_to_f64_raw(bigint(str_trim(parts[0])), bigint(str_trim(parts[1])));
        }
        return parse_number(s) + 0.0;
    }
    throw "linalg_geometry: expected numeric value, got " + t;
}

fn _validate_dims(m, n, ctx) {
    if m < 1 or n < 1 {
        throw "linalg_geometry (" + ctx + "): matrix dimensions must be >= 1";
    }
    let max_d = GOV.current_limits()["max_matrix_dim"];
    if m > max_d or n > max_d {
        throw "MathGovernor[linalg_geometry:" + ctx + "]: matrix dimensions exceed adaptive max_matrix_dim=" + str(max_d);
    }
}

fn _check_float_mat(A, ctx) {
    if type(A) != "array" or len(A) == 0 {
        throw "linalg_geometry (" + ctx + "): expected non-empty 2D matrix array";
    }
    let m = len(A);
    if type(A[0]) != "array" or len(A[0]) == 0 {
        throw "linalg_geometry (" + ctx + "): expected non-empty matrix rows";
    }
    let n = len(A[0]);
    _validate_dims(m, n, ctx);
    let out = [];
    let i = 0;
    while i < m {
        let row = A[i];
        if type(row) != "array" or len(row) != n {
            throw "linalg_geometry (" + ctx + "): ragged or non-rectangular matrix";
        }
        let r_out = [];
        let j = 0;
        while j < n {
            array_push(r_out, _num(row[j]));
            j = j + 1;
        }
        array_push(out, r_out);
        i = i + 1;
    }
    return out;
}

fn _check_square_mat(A, ctx) {
    let M = _check_float_mat(A, ctx);
    if len(M) != len(M[0]) {
        throw "linalg_geometry (" + ctx + "): expected square matrix, got " + str(len(M)) + "x" + str(len(M[0]));
    }
    return M;
}

fn _check_float_vec(v, ctx) {
    if type(v) != "array" or len(v) == 0 {
        throw "linalg_geometry (" + ctx + "): expected non-empty vector";
    }
    let max_d = GOV.current_limits()["max_matrix_dim"];
    if len(v) > max_d {
        throw "MathGovernor[linalg_geometry:" + ctx + "]: vector length exceeds adaptive max_matrix_dim=" + str(max_d);
    }
    let out = [];
    let i = 0;
    while i < len(v) {
        array_push(out, _num(v[i]));
        i = i + 1;
    }
    return out;
}

// ============================================================================
// 1. Exact Arbitrary-Precision Linear Algebra over Q (Zero Rounding Error)
// ============================================================================

fn _make_rat_canonical(num_b, den_b) {
    let z = _bg_zero();
    let one = _bg_one();
    if den_b == z {
        throw "linalg_geometry: zero denominator in exact rational";
    }
    let p = bigint(num_b);
    let q = bigint(den_b);
    if q < z {
        p = z - p;
        q = z - q;
    }
    if p == z {
        return {
            num: z,
            den: one,
            str: "0",
            latex: "0",
            is_int: true
        };
    }
    let g = _bg_gcd(p, q);
    p = p / g;
    q = q / g;
    let is_integer = (q == one);
    let s = str(p);
    let ltx = s;
    if not is_integer {
        s = str(p) + "/" + str(q);
        if p < z {
            ltx = "-\\frac{" + str(z - p) + "}{" + str(q) + "}";
        } else {
            ltx = "\\frac{" + str(p) + "}{" + str(q) + "}";
        }
    }
    return {
        num: p,
        den: q,
        str: s,
        latex: ltx,
        is_int: is_integer
    };
}

fn rat(num_val, den_val = 1) {
    return _make_rat_canonical(bigint(num_val), bigint(den_val));
}

fn _parse_decimal_to_rat(s_raw) {
    let s = str_trim(s_raw);
    let sign = _bg_one();
    if len(s) > 0 and str_slice(s, 0, 1) == "-" {
        sign = bigint(-1);
        s = str_slice(s, 1, len(s));
    } else {
        if len(s) > 0 and str_slice(s, 0, 1) == "+" {
            s = str_slice(s, 1, len(s));
        }
    }
    let exp_parts = str_split(s, "e");
    if len(exp_parts) == 1 {
        exp_parts = str_split(s, "E");
    }
    let mantissa = exp_parts[0];
    let exp10 = 0;
    if len(exp_parts) == 2 {
        exp10 = parse_number(str_trim(exp_parts[1]));
    }
    let dot_parts = str_split(mantissa, ".");
    let digits = dot_parts[0];
    let frac_len = 0;
    if len(dot_parts) == 2 {
        digits = dot_parts[0] + dot_parts[1];
        frac_len = len(dot_parts[1]);
    }
    if digits == "" { digits = "0"; }
    let p = sign * bigint(digits);
    let net_exp = exp10 - frac_len;
    let ten = bigint(10);
    if net_exp >= 0 {
        let k = 0;
        let mul_p = _bg_one();
        while k < net_exp {
            mul_p = mul_p * ten;
            k = k + 1;
        }
        return _make_rat_canonical(p * mul_p, _bg_one());
    } else {
        let k = 0;
        let den_q = _bg_one();
        let target = 0 - net_exp;
        while k < target {
            den_q = den_q * ten;
            k = k + 1;
        }
        return _make_rat_canonical(p, den_q);
    }
}

fn rat_from(x) {
    if _is_rat_map(x) {
        return _make_rat_canonical(x.num, x.den);
    }
    let t = type(x);
    if t == "bigint" {
        return _make_rat_canonical(x, _bg_one());
    }
    if t == "number" {
        if num_floor(x) == x and num_abs(x) < 9007199254740991.0 {
            return _make_rat_canonical(bigint(num_round(x)), _bg_one());
        }
        return _parse_decimal_to_rat(str(x));
    }
    if t == "string" {
        let s = str_trim(x);
        let parts = str_split(s, "/");
        if len(parts) == 2 {
            return _make_rat_canonical(bigint(str_trim(parts[0])), bigint(str_trim(parts[1])));
        }
        let dots = str_split(s, ".");
        if len(dots) > 1 {
            return _parse_decimal_to_rat(s);
        }
        return _make_rat_canonical(bigint(s), _bg_one());
    }
    throw "linalg_geometry: unsupported value for rat_from: " + t;
}

fn rat_add(a, b) {
    let ra = rat_from(a);
    let rb = rat_from(b);
    return _make_rat_canonical(ra.num * rb.den + rb.num * ra.den, ra.den * rb.den);
}

fn rat_sub(a, b) {
    let ra = rat_from(a);
    let rb = rat_from(b);
    return _make_rat_canonical(ra.num * rb.den - rb.num * ra.den, ra.den * rb.den);
}

fn rat_mul(a, b) {
    let ra = rat_from(a);
    let rb = rat_from(b);
    return _make_rat_canonical(ra.num * rb.num, ra.den * rb.den);
}

fn rat_div(a, b) {
    let ra = rat_from(a);
    let rb = rat_from(b);
    if rb.num == _bg_zero() {
        throw "linalg_geometry: division by zero in rat_div";
    }
    return _make_rat_canonical(ra.num * rb.den, ra.den * rb.num);
}

fn rat_neg(a) {
    let ra = rat_from(a);
    return _make_rat_canonical(_bg_zero() - ra.num, ra.den);
}

fn rat_abs(a) {
    let ra = rat_from(a);
    return _make_rat_canonical(_bg_abs(ra.num), ra.den);
}

fn rat_is_zero(a) {
    let ra = rat_from(a);
    return ra.num == _bg_zero();
}

fn rat_eq(a, b) {
    let ra = rat_from(a);
    let rb = rat_from(b);
    return ra.num == rb.num and ra.den == rb.den;
}

fn rat_to_string(r) {
    return rat_from(r).str;
}

fn rat_to_latex(r) {
    return rat_from(r).latex;
}

fn rat_to_float(r) {
    let rr = rat_from(r);
    return _rat_to_f64_raw(rr.num, rr.den);
}

// Exact n x n Hilbert matrix H[i][j] = 1 / (i + j + 1) over Q.
fn hilbert_exact(n) {
    _validate_dims(n, n, "hilbert_exact");
    let H = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, rat(1, i + j + 1));
            j = j + 1;
        }
        array_push(H, row);
        i = i + 1;
    }
    return H;
}

fn hilbert(n) {
    return hilbert_exact(n);
}

fn hilbert_float(n) {
    _validate_dims(n, n, "hilbert_float");
    let H = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, 1.0 / (i + j + 1));
            j = j + 1;
        }
        array_push(H, row);
        i = i + 1;
    }
    return H;
}

fn _check_rat_mat(A, ctx) {
    if type(A) != "array" or len(A) == 0 {
        throw "linalg_geometry (" + ctx + "): expected non-empty 2D matrix";
    }
    let m = len(A);
    if type(A[0]) != "array" or len(A[0]) == 0 {
        throw "linalg_geometry (" + ctx + "): expected non-empty matrix rows";
    }
    let n = len(A[0]);
    _validate_dims(m, n, ctx);
    let out = [];
    let i = 0;
    while i < m {
        let row = A[i];
        if type(row) != "array" or len(row) != n {
            throw "linalg_geometry (" + ctx + "): ragged matrix rows";
        }
        let r_out = [];
        let j = 0;
        while j < n {
            array_push(r_out, rat_from(row[j]));
            j = j + 1;
        }
        array_push(out, r_out);
        i = i + 1;
    }
    return out;
}

fn rat_mat_mul(A, B) {
    let MA = _check_rat_mat(A, "rat_mat_mul");
    let MB = _check_rat_mat(B, "rat_mat_mul");
    let m = len(MA);
    let k_dim = len(MA[0]);
    if len(MB) != k_dim {
        throw "linalg_geometry (rat_mat_mul): incompatible dimensions";
    }
    let n = len(MB[0]);
    let zero_q = rat(0, 1);
    let C = [];
    let i = 0;
    while i < m {
        let row = [];
        let j = 0;
        while j < n {
            let acc = zero_q;
            let k = 0;
            while k < k_dim {
                if not rat_is_zero(MA[i][k]) and not rat_is_zero(MB[k][j]) {
                    acc = rat_add(acc, rat_mul(MA[i][k], MB[k][j]));
                }
                k = k + 1;
            }
            array_push(row, acc);
            j = j + 1;
        }
        array_push(C, row);
        i = i + 1;
    }
    return C;
}

fn rat_mat_vec_mul(A, v) {
    let MA = _check_rat_mat(A, "rat_mat_vec_mul");
    let m = len(MA);
    let n = len(MA[0]);
    if type(v) != "array" or len(v) != n {
        throw "linalg_geometry (rat_mat_vec_mul): incompatible vector length";
    }
    let zero_q = rat(0, 1);
    let out = [];
    let i = 0;
    while i < m {
        let acc = zero_q;
        let j = 0;
        while j < n {
            let vj = rat_from(v[j]);
            if not rat_is_zero(MA[i][j]) and not rat_is_zero(vj) {
                acc = rat_add(acc, rat_mul(MA[i][j], vj));
            }
            j = j + 1;
        }
        array_push(out, acc);
        i = i + 1;
    }
    return out;
}

fn _pad_left(s, width) {
    let out = s;
    while len(out) < width {
        out = " " + out;
    }
    return out;
}

fn _rat_mat_to_latex(M) {
    let m = len(M);
    let n = len(M[0]);
    let s = "\\begin{bmatrix}";
    let i = 0;
    while i < m {
        if i > 0 { s = s + " \\\\ "; }
        let j = 0;
        while j < n {
            if j > 0 { s = s + " & "; }
            s = s + M[i][j].latex;
            j = j + 1;
        }
        i = i + 1;
    }
    s = s + "\\end{bmatrix}";
    return s;
}

fn _rat_mat_to_unicode(M) {
    let m = len(M);
    let n = len(M[0]);
    let widths = [];
    let j = 0;
    while j < n {
        let w = 1;
        let i = 0;
        while i < m {
            let sl = len(M[i][j].str);
            if sl > w { w = sl; }
            i = i + 1;
        }
        array_push(widths, w);
        j = j + 1;
    }
    let lines = "";
    let i = 0;
    while i < m {
        let lb = "⎢";
        let rb = "⎥";
        if m == 1 {
            lb = "[";
            rb = "]";
        } else {
            if i == 0 {
                lb = "⎡";
                rb = "⎤";
            } else {
                if i == m - 1 {
                    lb = "⎣";
                    rb = "⎦";
                }
            }
        }
        let row_s = lb + " ";
        let c = 0;
        while c < n {
            if c > 0 { row_s = row_s + "  "; }
            row_s = row_s + _pad_left(M[i][c].str, widths[c]);
            c = c + 1;
        }
        row_s = row_s + " " + rb;
        if i > 0 { lines = lines + "\n"; }
        lines = lines + row_s;
        i = i + 1;
    }
    return lines;
}

// Exact Gauss-Jordan RREF over Q.
// Returns { rref, pivot_cols, free_cols, rank, rref_latex, rref_unicode }.
fn rref_exact(A) {
    let M = _check_rat_mat(A, "rref_exact");
    let m = len(M);
    let n = len(M[0]);
    let pivot_cols = [];
    let free_cols = [];
    let zero_q = rat(0, 1);
    let one_q = rat(1, 1);
    let piv_row = 0;
    let col = 0;
    while col < n {
        if piv_row < m {
            let sel = -1;
            let r = piv_row;
            while r < m {
                if not rat_is_zero(M[r][col]) {
                    sel = r;
                    r = m;
                } else {
                    r = r + 1;
                }
            }
            if sel == -1 {
                array_push(free_cols, col);
            } else {
                if sel != piv_row {
                    let tmp = M[piv_row];
                    M[piv_row] = M[sel];
                    M[sel] = tmp;
                }
                let piv_val = M[piv_row][col];
                M[piv_row][col] = one_q;
                let j = col + 1;
                while j < n {
                    M[piv_row][j] = rat_div(M[piv_row][j], piv_val);
                    j = j + 1;
                }
                let r2 = 0;
                while r2 < m {
                    if r2 != piv_row and not rat_is_zero(M[r2][col]) {
                        let factor = M[r2][col];
                        M[r2][col] = zero_q;
                        let j2 = col + 1;
                        while j2 < n {
                            if not rat_is_zero(M[piv_row][j2]) {
                                M[r2][j2] = rat_sub(M[r2][j2], rat_mul(factor, M[piv_row][j2]));
                            }
                            j2 = j2 + 1;
                        }
                    }
                    r2 = r2 + 1;
                }
                array_push(pivot_cols, col);
                piv_row = piv_row + 1;
            }
        } else {
            array_push(free_cols, col);
        }
        col = col + 1;
    }
    return {
        rref: M,
        pivot_cols: pivot_cols,
        free_cols: free_cols,
        rank: len(pivot_cols),
        rref_latex: _rat_mat_to_latex(M),
        rref_unicode: _rat_mat_to_unicode(M)
    };
}

// Bareiss Fraction-Free O(n^3) exact determinant over Z / Q (zero rounding error).
fn det_exact(A) {
    let MQ = _check_rat_mat(A, "det_exact");
    let n = len(MQ);
    if len(MQ[0]) != n {
        throw "linalg_geometry (det_exact): expected square matrix";
    }
    // Clear row denominators so Bareiss operates purely in exact bigint Z!
    let scale_den = _bg_one();
    let B = [];
    let i = 0;
    while i < n {
        let row_lcm = _bg_one();
        let j = 0;
        while j < n {
            row_lcm = _bg_lcm(row_lcm, MQ[i][j].den);
            j = j + 1;
        }
        scale_den = scale_den * row_lcm;
        let b_row = [];
        let j2 = 0;
        while j2 < n {
            let mult = row_lcm / MQ[i][j2].den;
            array_push(b_row, MQ[i][j2].num * mult);
            j2 = j2 + 1;
        }
        array_push(B, b_row);
        i = i + 1;
    }

    let z = _bg_zero();
    let sign = _bg_one();
    let prev_pivot = _bg_one();
    let k = 0;
    while k < n - 1 {
        if B[k][k] == z {
            let swap_r = -1;
            let r = k + 1;
            while r < n {
                if B[r][k] != z {
                    swap_r = r;
                    r = n;
                } else {
                    r = r + 1;
                }
            }
            if swap_r == -1 {
                return rat(0, 1);
            }
            let tmp_row = B[k];
            B[k] = B[swap_r];
            B[swap_r] = tmp_row;
            sign = z - sign;
        }
        let piv = B[k][k];
        let r2 = k + 1;
        while r2 < n {
            let rik = B[r2][k];
            let c2 = k + 1;
            while c2 < n {
                // Exact integer division guaranteed by Sylvester's identity
                B[r2][c2] = (piv * B[r2][c2] - rik * B[k][c2]) / prev_pivot;
                c2 = c2 + 1;
            }
            B[r2][k] = z;
            r2 = r2 + 1;
        }
        prev_pivot = piv;
        k = k + 1;
    }
    let det_int = sign * B[n - 1][n - 1];
    return _make_rat_canonical(det_int, scale_den);
}

// Exact matrix inverse over Q via augmented Gauss-Jordan elimination.
fn inv_exact(A) {
    let MQ = _check_rat_mat(A, "inv_exact");
    let n = len(MQ);
    if len(MQ[0]) != n {
        throw "linalg_geometry (inv_exact): expected square matrix";
    }
    let max_d = GOV.current_limits()["max_matrix_dim"];
    if n > max_d {
        throw "MathGovernor[linalg_geometry:inv_exact]: dimension exceeds adaptive max_matrix_dim=" + str(max_d);
    }
    let trk = GOV.new_tracker("linalg_geometry.inv_exact");
    let zero_q = rat(0, 1);
    let one_q = rat(1, 1);
    let aug = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, MQ[i][j]);
            j = j + 1;
        }
        let j2 = 0;
        while j2 < n {
            if i == j2 {
                array_push(row, one_q);
            } else {
                array_push(row, zero_q);
            }
            j2 = j2 + 1;
        }
        array_push(aug, row);
        i = i + 1;
    }

    let w = 2 * n;
    let k = 0;
    while k < n {
        GOV.tick(trk, n);
        let sel = -1;
        let r = k;
        while r < n {
            if not rat_is_zero(aug[r][k]) {
                sel = r;
                r = n;
            } else {
                r = r + 1;
            }
        }
        if sel == -1 {
            throw "linalg_geometry (inv_exact): matrix is singular";
        }
        if sel != k {
            let tmp = aug[k];
            aug[k] = aug[sel];
            aug[sel] = tmp;
        }
        let piv = aug[k][k];
        aug[k][k] = one_q;
        let j = k + 1;
        while j < w {
            aug[k][j] = rat_div(aug[k][j], piv);
            j = j + 1;
        }
        let r2 = 0;
        while r2 < n {
            if r2 != k and not rat_is_zero(aug[r2][k]) {
                let factor = aug[r2][k];
                aug[r2][k] = zero_q;
                let j2 = k + 1;
                while j2 < w {
                    if not rat_is_zero(aug[k][j2]) {
                        aug[r2][j2] = rat_sub(aug[r2][j2], rat_mul(factor, aug[k][j2]));
                    }
                    j2 = j2 + 1;
                }
            }
            r2 = r2 + 1;
        }
        k = k + 1;
    }

    let inv_mat = [];
    let r_idx = 0;
    while r_idx < n {
        let row_out = [];
        let c_idx = 0;
        while c_idx < n {
            array_push(row_out, aug[r_idx][n + c_idx]);
            c_idx = c_idx + 1;
        }
        array_push(inv_mat, row_out);
        r_idx = r_idx + 1;
    }
    return inv_mat;
}

// Exact basis of ker(A); satisfies rank(A) + nullity(A) = n.
fn nullspace_exact(A) {
    let MQ = _check_rat_mat(A, "nullspace_exact");
    let n = len(MQ[0]);
    let rr = rref_exact(MQ);
    let basis = [];
    let zero_q = rat(0, 1);
    let one_q = rat(1, 1);
    let f_idx = 0;
    while f_idx < len(rr.free_cols) {
        let fc = rr.free_cols[f_idx];
        let vec = [];
        let j = 0;
        while j < n {
            array_push(vec, zero_q);
            j = j + 1;
        }
        vec[fc] = one_q;
        let p_idx = 0;
        while p_idx < len(rr.pivot_cols) {
            let pc = rr.pivot_cols[p_idx];
            vec[pc] = rat_neg(rr.rref[p_idx][fc]);
            p_idx = p_idx + 1;
        }
        array_push(basis, vec);
        f_idx = f_idx + 1;
    }
    return {
        basis: basis,
        nullity: len(basis),
        rank: rr.rank,
        dim_domain: n
    };
}

// Exact basis of im(A) = col(A) selected from pivot columns of A.
fn colspace_exact(A) {
    let MQ = _check_rat_mat(A, "colspace_exact");
    let m = len(MQ);
    let rr = rref_exact(MQ);
    let basis = [];
    let p_idx = 0;
    while p_idx < len(rr.pivot_cols) {
        let pc = rr.pivot_cols[p_idx];
        let col_vec = [];
        let i = 0;
        while i < m {
            array_push(col_vec, MQ[i][pc]);
            i = i + 1;
        }
        array_push(basis, col_vec);
        p_idx = p_idx + 1;
    }
    return {
        basis: basis,
        pivot_cols: rr.pivot_cols,
        rank: rr.rank,
        dim_codomain: m
    };
}

fn _pinv_min_norm_vec(MQ, b_vec) {
    let A_pinv = pinv(MQ);
    let bf = _check_float_vec(b_vec, "solve_exact");
    let n = len(A_pinv);
    let m = len(bf);
    let x_mn = [];
    let i = 0;
    while i < n {
        let acc = 0.0;
        let j = 0;
        while j < m {
            acc = acc + A_pinv[i][j] * bf[j];
            j = j + 1;
        }
        array_push(x_mn, acc);
        i = i + 1;
    }
    return x_mn;
}

// Exact linear system classifier & solver over Q:
// Classifies "unique", "infinite_parametric", or "inconsistent",
// enriched with SVD Moore-Penrose minimum-norm subspace solution when rank-deficient.
fn solve_exact(A, b) {
    let MQ = _check_rat_mat(A, "solve_exact");
    let m = len(MQ);
    let n = len(MQ[0]);
    if type(b) != "array" or len(b) != m {
        throw "linalg_geometry (solve_exact): RHS vector b length must match rows of A";
    }
    let max_d = GOV.current_limits()["max_matrix_dim"];
    if n + 1 > max_d + 1 {
        throw "MathGovernor[linalg_geometry:solve_exact]: augmented matrix exceeds adaptive max_matrix_dim=" + str(max_d);
    }
    let aug = [];
    let i = 0;
    while i < m {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, MQ[i][j]);
            j = j + 1;
        }
        array_push(row, rat_from(b[i]));
        array_push(aug, row);
        i = i + 1;
    }
    let rr_aug = rref_exact(aug);
    let pcols = rr_aug.pivot_cols;
    let npiv = len(pcols);
    if npiv > 0 and pcols[npiv - 1] == n {
        let rk_a = npiv - 1;
        let mn_ls = _pinv_min_norm_vec(MQ, b);
        return {
            status: "inconsistent",
            rank: rk_a,
            effective_rank: rk_a,
            augmented_rank: npiv,
            nullity: n - rk_a,
            rank_deficient_indeterminacy: (rk_a < n),
            indeterminate_subspace: false,
            min_norm_solution: mn_ls,
            solution: nil,
            particular: nil,
            nullspace_basis: [],
            free_cols: []
        };
    }

    let zero_q = rat(0, 1);
    let xp = [];
    let j = 0;
    while j < n {
        array_push(xp, zero_q);
        j = j + 1;
    }
    let r = 0;
    while r < npiv {
        let pc = pcols[r];
        xp[pc] = rr_aug.rref[r][n];
        r = r + 1;
    }

    if npiv == n {
        let xp_f = [];
        let qi = 0;
        while qi < n {
            array_push(xp_f, _num(xp[qi]));
            qi = qi + 1;
        }
        return {
            status: "unique",
            rank: npiv,
            effective_rank: npiv,
            augmented_rank: npiv,
            nullity: 0,
            rank_deficient_indeterminacy: false,
            indeterminate_subspace: false,
            min_norm_solution: xp_f,
            solution: xp,
            particular: xp,
            nullspace_basis: [],
            free_cols: []
        };
    }

    let ns = nullspace_exact(MQ);
    let mn_sol = _pinv_min_norm_vec(MQ, b);
    return {
        status: "infinite_parametric",
        rank: npiv,
        effective_rank: npiv,
        augmented_rank: npiv,
        nullity: len(ns.basis),
        rank_deficient_indeterminacy: true,
        indeterminate_subspace: true,
        min_norm_solution: mn_sol,
        solution: nil,
        particular: xp,
        nullspace_basis: ns.basis,
        free_cols: ns.basis
    };
}

// ============================================================================
// 2. High-Performance Numerical Matrix Decompositions & Matrix Functions
// ============================================================================

fn mat_zeros(m, n) {
    _validate_dims(m, n, "mat_zeros");
    let out = [];
    let i = 0;
    while i < m {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, 0.0);
            j = j + 1;
        }
        array_push(out, row);
        i = i + 1;
    }
    return out;
}

fn mat_eye(n) {
    let I = mat_zeros(n, n);
    let i = 0;
    while i < n {
        I[i][i] = 1.0;
        i = i + 1;
    }
    return I;
}

fn mat_copy(A) {
    return _check_float_mat(A, "mat_copy");
}

fn mat_scale(A, alpha) {
    let M = _check_float_mat(A, "mat_scale");
    let s = _num(alpha);
    let m = len(M);
    let n = len(M[0]);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            M[i][j] = M[i][j] * s;
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

fn mat_add(A, B) {
    let MA = _check_float_mat(A, "mat_add");
    let MB = _check_float_mat(B, "mat_add");
    let m = len(MA);
    let n = len(MA[0]);
    if len(MB) != m or len(MB[0]) != n {
        throw "linalg_geometry (mat_add): dimension mismatch";
    }
    let out = mat_zeros(m, n);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            out[i][j] = MA[i][j] + MB[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mat_sub(A, B) {
    let MA = _check_float_mat(A, "mat_sub");
    let MB = _check_float_mat(B, "mat_sub");
    let m = len(MA);
    let n = len(MA[0]);
    if len(MB) != m or len(MB[0]) != n {
        throw "linalg_geometry (mat_sub): dimension mismatch";
    }
    let out = mat_zeros(m, n);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            out[i][j] = MA[i][j] - MB[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mat_mul(A, B) {
    let MA = _check_float_mat(A, "mat_mul");
    let MB = _check_float_mat(B, "mat_mul");
    let m = len(MA);
    let p = len(MA[0]);
    if len(MB) != p {
        throw "linalg_geometry (mat_mul): inner dimensions do not agree (" + str(p) + " vs " + str(len(MB)) + ")";
    }
    let n = len(MB[0]);
    let C = mat_zeros(m, n);
    let i = 0;
    while i < m {
        let row_a = MA[i];
        let row_c = C[i];
        let k = 0;
        while k < p {
            let aik = row_a[k];
            if aik != 0.0 {
                let row_b = MB[k];
                let j = 0;
                while j < n {
                    row_c[j] = row_c[j] + aik * row_b[j];
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return C;
}

fn mat_vec_mul(A, v) {
    let MA = _check_float_mat(A, "mat_vec_mul");
    let vec = _check_float_vec(v, "mat_vec_mul");
    let m = len(MA);
    let n = len(MA[0]);
    if len(vec) != n {
        throw "linalg_geometry (mat_vec_mul): vector length mismatch";
    }
    let out = [];
    let i = 0;
    while i < m {
        let s = 0.0;
        let j = 0;
        while j < n {
            s = s + MA[i][j] * vec[j];
            j = j + 1;
        }
        array_push(out, s);
        i = i + 1;
    }
    return out;
}

fn mat_transpose(A) {
    let MA = _check_float_mat(A, "mat_transpose");
    let m = len(MA);
    let n = len(MA[0]);
    let T = mat_zeros(n, m);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            T[j][i] = MA[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return T;
}

fn mat_trace(A) {
    let MA = _check_square_mat(A, "mat_trace");
    let n = len(MA);
    let tr = 0.0;
    let i = 0;
    while i < n {
        tr = tr + MA[i][i];
        i = i + 1;
    }
    return tr;
}

// Kronecker product A (x) B
fn mat_kron(A, B) {
    let MA = _check_float_mat(A, "mat_kron");
    let MB = _check_float_mat(B, "mat_kron");
    let ma = len(MA);
    let na = len(MA[0]);
    let mb = len(MB);
    let nb = len(MB[0]);
    let mr = ma * mb;
    let nr = na * nb;
    _validate_dims(mr, nr, "mat_kron");
    let K = mat_zeros(mr, nr);
    let ia = 0;
    while ia < ma {
        let ja = 0;
        while ja < na {
            let v = MA[ia][ja];
            let ib = 0;
            while ib < mb {
                let jb = 0;
                while jb < nb {
                    K[ia * mb + ib][ja * nb + jb] = v * MB[ib][jb];
                    jb = jb + 1;
                }
                ib = ib + 1;
            }
            ja = ja + 1;
        }
        ia = ia + 1;
    }
    return K;
}

fn _fmt_float_latex(x) {
    if num_abs(x) < 1e-14 { return "0"; }
    let rx = num_round(x);
    if num_abs(x - rx) < 1e-12 {
        return str(rx);
    }
    let scaled = num_round(x * 1000000.0) / 1000000.0;
    return str(scaled);
}

fn mat_to_latex(A) {
    let MA = _check_float_mat(A, "mat_to_latex");
    let m = len(MA);
    let n = len(MA[0]);
    let s = "\\begin{bmatrix}";
    let i = 0;
    while i < m {
        if i > 0 { s = s + " \\\\ "; }
        let j = 0;
        while j < n {
            if j > 0 { s = s + " & "; }
            s = s + _fmt_float_latex(MA[i][j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return s + "\\end{bmatrix}";
}

// Partial-pivoting PA = LU decomposition in O(n^3).
fn lu_decompose(A) {
    let U = _check_square_mat(A, "lu_decompose");
    let n = len(U);
    let L = mat_eye(n);
    let perm = [];
    let i = 0;
    while i < n {
        array_push(perm, i);
        i = i + 1;
    }
    let swap_count = 0;
    let singular = false;

    let k = 0;
    while k < n {
        let max_val = num_abs(U[k][k]);
        let max_row = k;
        let r = k + 1;
        while r < n {
            let v = num_abs(U[r][k]);
            if v > max_val {
                max_val = v;
                max_row = r;
            }
            r = r + 1;
        }
        if max_val < 1e-15 {
            singular = true;
        } else {
            if max_row != k {
                let tmp_u = U[k];
                U[k] = U[max_row];
                U[max_row] = tmp_u;

                let tmp_p = perm[k];
                perm[k] = perm[max_row];
                perm[max_row] = tmp_p;

                let c = 0;
                while c < k {
                    let tmp_l = L[k][c];
                    L[k][c] = L[max_row][c];
                    L[max_row][c] = tmp_l;
                    c = c + 1;
                }
                swap_count = swap_count + 1;
            }
            let piv = U[k][k];
            let r2 = k + 1;
            while r2 < n {
                let factor = U[r2][k] / piv;
                L[r2][k] = factor;
                U[r2][k] = 0.0;
                let c2 = k + 1;
                while c2 < n {
                    U[r2][c2] = U[r2][c2] - factor * U[k][c2];
                    c2 = c2 + 1;
                }
                r2 = r2 + 1;
            }
        }
        k = k + 1;
    }

    let P = mat_zeros(n, n);
    let idx = 0;
    while idx < n {
        P[idx][perm[idx]] = 1.0;
        idx = idx + 1;
    }

    return {
        P: P,
        L: L,
        U: U,
        perm: perm,
        swap_count: swap_count,
        singular: singular
    };
}

fn det(A) {
    let lu = lu_decompose(A);
    if lu.singular { return 0.0; }
    let n = len(lu.U);
    let prod = 1.0;
    if num_mod(lu.swap_count, 2) == 1 {
        prod = -1.0;
    }
    let i = 0;
    while i < n {
        prod = prod * lu.U[i][i];
        i = i + 1;
    }
    return prod;
}

fn lu_solve(lu_or_A, b) {
    let lu = lu_or_A;
    if type(lu_or_A) == "array" {
        lu = lu_decompose(lu_or_A);
    }
    if type(lu) != "map" or not map_has(lu, "L") or not map_has(lu, "U") {
        throw "linalg_geometry (lu_solve): expected LU map from lu_decompose or square matrix";
    }
    if lu.singular {
        throw "linalg_geometry (lu_solve): singular matrix";
    }
    let rhs = _check_float_vec(b, "lu_solve");
    let n = len(lu.U);
    if len(rhs) != n {
        throw "linalg_geometry (lu_solve): vector b length mismatch";
    }
    // Forward substitution: L y = P b
    let y = [];
    let i = 0;
    while i < n {
        let s = rhs[lu.perm[i]];
        let j = 0;
        while j < i {
            s = s - lu.L[i][j] * y[j];
            j = j + 1;
        }
        array_push(y, s);
        i = i + 1;
    }
    // Back substitution: U x = y
    let x = [];
    let k = 0;
    while k < n {
        array_push(x, 0.0);
        k = k + 1;
    }
    let r = n - 1;
    while r >= 0 {
        let s = y[r];
        let c = r + 1;
        while c < n {
            s = s - lu.U[r][c] * x[c];
            c = c + 1;
        }
        if num_abs(lu.U[r][r]) < 1e-15 {
            throw "linalg_geometry (lu_solve): zero pivot encountered";
        }
        x[r] = s / lu.U[r][r];
        r = r - 1;
    }
    return x;
}

fn inv(A) {
    let lu = lu_decompose(A);
    if lu.singular {
        throw "linalg_geometry (inv): matrix is singular";
    }
    let n = len(lu.U);
    let cols_inv = [];
    let j = 0;
    while j < n {
        let ej = [];
        let i = 0;
        while i < n {
            if i == j { array_push(ej, 1.0); } else { array_push(ej, 0.0); }
            i = i + 1;
        }
        array_push(cols_inv, lu_solve(lu, ej));
        j = j + 1;
    }
    let out = mat_zeros(n, n);
    let r = 0;
    while r < n {
        let c = 0;
        while c < n {
            out[r][c] = cols_inv[c][r];
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}

// Householder QR decomposition A = Q R for m >= n.
fn qr_decompose(A) {
    let R = _check_float_mat(A, "qr_decompose");
    let m = len(R);
    let n = len(R[0]);
    if m < n {
        throw "linalg_geometry (qr_decompose): requires m >= n (got " + str(m) + "x" + str(n) + ")";
    }
    let Q = mat_eye(m);
    let k = 0;
    while k < n {
        let norm_sq = 0.0;
        let i = k;
        while i < m {
            norm_sq = norm_sq + R[i][k] * R[i][k];
            i = i + 1;
        }
        let norm_x = num_sqrt(norm_sq);
        if norm_x > 1e-15 {
            let alpha = (0.0 - _sign_nonzero(R[k][k])) * norm_x;
            let v = [];
            let i2 = k;
            while i2 < m {
                if i2 == k {
                    array_push(v, R[i2][k] - alpha);
                } else {
                    array_push(v, R[i2][k]);
                }
                i2 = i2 + 1;
            }
            let v_sq = 0.0;
            let iv = 0;
            while iv < len(v) {
                v_sq = v_sq + v[iv] * v[iv];
                iv = iv + 1;
            }
            let v_norm = num_sqrt(v_sq);
            if v_norm > 1e-15 {
                let u = [];
                let iu = 0;
                while iu < len(v) {
                    array_push(u, v[iu] / v_norm);
                    iu = iu + 1;
                }
                // R[k..m-1, k..n-1] -= 2 u (u^T R)
                let col = k;
                while col < n {
                    let dot_ur = 0.0;
                    let r_idx = 0;
                    while r_idx < len(u) {
                        dot_ur = dot_ur + u[r_idx] * R[k + r_idx][col];
                        r_idx = r_idx + 1;
                    }
                    let two_dot = 2.0 * dot_ur;
                    let r_idx2 = 0;
                    while r_idx2 < len(u) {
                        R[k + r_idx2][col] = R[k + r_idx2][col] - two_dot * u[r_idx2];
                        r_idx2 = r_idx2 + 1;
                    }
                    col = col + 1;
                }
                // Clean subdiagonal zeros in column k
                let z_idx = k + 1;
                while z_idx < m {
                    R[z_idx][k] = 0.0;
                    z_idx = z_idx + 1;
                }
                // Q[:, k..m-1] -= 2 (Q u) u^T
                let row_q = 0;
                while row_q < m {
                    let dot_qu = 0.0;
                    let u_idx = 0;
                    while u_idx < len(u) {
                        dot_qu = dot_qu + Q[row_q][k + u_idx] * u[u_idx];
                        u_idx = u_idx + 1;
                    }
                    let two_qu = 2.0 * dot_qu;
                    let u_idx2 = 0;
                    while u_idx2 < len(u) {
                        Q[row_q][k + u_idx2] = Q[row_q][k + u_idx2] - two_qu * u[u_idx2];
                        u_idx2 = u_idx2 + 1;
                    }
                    row_q = row_q + 1;
                }
            }
        }
        // Canonicalize positive diagonal on R
        if R[k][k] < 0.0 {
            let c_idx = k;
            while c_idx < n {
                R[k][c_idx] = 0.0 - R[k][c_idx];
                c_idx = c_idx + 1;
            }
            let r_idx = 0;
            while r_idx < m {
                Q[r_idx][k] = 0.0 - Q[r_idx][k];
                r_idx = r_idx + 1;
            }
        }
        k = k + 1;
    }

    let Q_thin = mat_zeros(m, n);
    let i_qt = 0;
    while i_qt < m {
        let j_qt = 0;
        while j_qt < n {
            Q_thin[i_qt][j_qt] = Q[i_qt][j_qt];
            j_qt = j_qt + 1;
        }
        i_qt = i_qt + 1;
    }
    let R_thin = mat_zeros(n, n);
    let i_rt = 0;
    while i_rt < n {
        let j_rt = 0;
        while j_rt < n {
            R_thin[i_rt][j_rt] = R[i_rt][j_rt];
            j_rt = j_rt + 1;
        }
        i_rt = i_rt + 1;
    }
    return {
        Q: Q,
        R: R,
        Q_thin: Q_thin,
        R_thin: R_thin
    };
}

// Cholesky factorization A = L L^T for symmetric positive-definite matrices.
fn cholesky(A) {
    let MA = _check_square_mat(A, "cholesky");
    let n = len(MA);
    let i_sym = 0;
    while i_sym < n {
        let j_sym = i_sym + 1;
        while j_sym < n {
            let scale = 1.0 + num_abs(MA[i_sym][j_sym]) + num_abs(MA[j_sym][i_sym]);
            if num_abs(MA[i_sym][j_sym] - MA[j_sym][i_sym]) > 1e-10 * scale {
                throw "linalg_geometry (cholesky): matrix is not symmetric";
            }
            j_sym = j_sym + 1;
        }
        i_sym = i_sym + 1;
    }
    let L = mat_zeros(n, n);
    let i = 0;
    while i < n {
        let j = 0;
        while j <= i {
            let s = MA[i][j];
            let k = 0;
            while k < j {
                s = s - L[i][k] * L[j][k];
                k = k + 1;
            }
            if i == j {
                if s <= 1e-15 {
                    throw "linalg_geometry (cholesky): matrix is not symmetric positive-definite";
                }
                L[i][i] = num_sqrt(s);
            } else {
                L[i][j] = s / L[j][j];
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return L;
}

// Cyclic Jacobi Eigenvalue Algorithm for real symmetric matrices:
// Returns { eigenvalues, eigenvectors, iterations } with A V = V Lambda, V^T V = I.
fn eigh_symmetric(A) {
    let MA = _check_square_mat(A, "eigh_symmetric");
    let n = len(MA);
    let D = mat_zeros(n, n);
    let frob_sq = 0.0;
    let i = 0;
    while i < n {
        let j = i;
        while j < n {
            let scale = 1.0 + num_abs(MA[i][j]) + num_abs(MA[j][i]);
            if num_abs(MA[i][j] - MA[j][i]) > 1e-9 * scale {
                throw "linalg_geometry (eigh_symmetric): matrix is not symmetric";
            }
            let sym_v = 0.5 * (MA[i][j] + MA[j][i]);
            D[i][j] = sym_v;
            D[j][i] = sym_v;
            if i == j {
                frob_sq = frob_sq + sym_v * sym_v;
            } else {
                frob_sq = frob_sq + 2.0 * sym_v * sym_v;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let V = mat_eye(n);
    let tol = 1e-15 * _max2(1.0, num_sqrt(frob_sq));
    let max_sw = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("linalg_geometry.eigh_symmetric");
    let sweep = 0;
    let converged = false;
    while sweep < max_sw and not converged {
        GOV.tick(trk, n);
        let off_sq = 0.0;
        let p = 0;
        while p < n - 1 {
            let q = p + 1;
            while q < n {
                off_sq = off_sq + D[p][q] * D[p][q];
                q = q + 1;
            }
            p = p + 1;
        }
        if num_sqrt(2.0 * off_sq) <= tol {
            converged = true;
        } else {
            let p2 = 0;
            while p2 < n - 1 {
                let q2 = p2 + 1;
                while q2 < n {
                    let apq = D[p2][q2];
                    let diag_scale = num_abs(D[p2][p2]) + num_abs(D[q2][q2]);
                    if num_abs(apq) > 1e-16 * diag_scale and num_abs(apq) > 1e-30 {
                        let tau = (D[q2][q2] - D[p2][p2]) / (2.0 * apq);
                        let t_rot = _sign_nonzero(tau) / (num_abs(tau) + num_sqrt(1.0 + tau * tau));
                        let c_rot = 1.0 / num_sqrt(1.0 + t_rot * t_rot);
                        let s_rot = t_rot * c_rot;

                        D[p2][p2] = D[p2][p2] - t_rot * apq;
                        D[q2][q2] = D[q2][q2] + t_rot * apq;
                        D[p2][q2] = 0.0;
                        D[q2][p2] = 0.0;

                        let r = 0;
                        while r < n {
                            if r != p2 and r != q2 {
                                let drp = D[r][p2];
                                let drq = D[r][q2];
                                let new_rp = c_rot * drp - s_rot * drq;
                                let new_rq = s_rot * drp + c_rot * drq;
                                D[r][p2] = new_rp;
                                D[p2][r] = new_rp;
                                D[r][q2] = new_rq;
                                D[q2][r] = new_rq;
                            }
                            r = r + 1;
                        }

                        let rv = 0;
                        while rv < n {
                            let vrp = V[rv][p2];
                            let vrq = V[rv][q2];
                            V[rv][p2] = c_rot * vrp - s_rot * vrq;
                            V[rv][q2] = s_rot * vrp + c_rot * vrq;
                            rv = rv + 1;
                        }
                    }
                    q2 = q2 + 1;
                }
                p2 = p2 + 1;
            }
            sweep = sweep + 1;
        }
    }

    // Sort eigenvalues ascending and permute eigenvector columns accordingly
    let evals = [];
    let order = [];
    let idx = 0;
    while idx < n {
        array_push(evals, D[idx][idx]);
        array_push(order, idx);
        idx = idx + 1;
    }
    let a_idx = 1;
    while a_idx < n {
        let key_v = evals[a_idx];
        let key_o = order[a_idx];
        let b_idx = a_idx - 1;
        while b_idx >= 0 and evals[b_idx] > key_v {
            evals[b_idx + 1] = evals[b_idx];
            order[b_idx + 1] = order[b_idx];
            b_idx = b_idx - 1;
        }
        evals[b_idx + 1] = key_v;
        order[b_idx + 1] = key_o;
        a_idx = a_idx + 1;
    }

    let V_sorted = mat_zeros(n, n);
    let col_i = 0;
    while col_i < n {
        let src_c = order[col_i];
        let row_i = 0;
        while row_i < n {
            V_sorted[row_i][col_i] = V[row_i][src_c];
            row_i = row_i + 1;
        }
        col_i = col_i + 1;
    }

    return {
        eigenvalues: evals,
        eigenvectors: V_sorted,
        iterations: sweep
    };
}

fn _eig_2x2_pair(a, b, c, d) {
    let mu = 0.5 * (a + d);
    let half_diff = 0.5 * (a - d);
    let disc = half_diff * half_diff + b * c;
    if disc >= 0.0 {
        let r = num_sqrt(disc);
        if mu >= 0.0 {
            let l1 = mu + r;
            let l2 = (a * d - b * c) / l1;
            if num_abs(l1) < 1e-15 { l2 = mu - r; }
            return [{ re: l1, im: 0.0 }, { re: l2, im: 0.0 }];
        } else {
            let l2 = mu - r;
            let l1 = (a * d - b * c) / l2;
            if num_abs(l2) < 1e-15 { l1 = mu + r; }
            return [{ re: l1, im: 0.0 }, { re: l2, im: 0.0 }];
        }
    } else {
        let w = num_sqrt(0.0 - disc);
        return [{ re: mu, im: w }, { re: mu, im: 0.0 - w }];
    }
}

// Householder Upper Hessenberg reduction + Francis Double-Shift / Wilkinson QR Iteration
// Returns { eigenvalues: [{ re, im }, ...], converged, iterations }.
fn eig_general(A) {
    let H = _check_square_mat(A, "eig_general");
    let n = len(H);
    if n == 1 {
        return {
            eigenvalues: [{ re: H[0][0], im: 0.0 }],
            converged: true,
            iterations: 0
        };
    }
    if n == 2 {
        return {
            eigenvalues: _eig_2x2_pair(H[0][0], H[0][1], H[1][0], H[1][1]),
            converged: true,
            iterations: 0
        };
    }

    // Step 1: Householder similarity reduction to upper Hessenberg form H = Q^T A Q
    let k = 0;
    while k < n - 2 {
        let norm_sq = 0.0;
        let i = k + 1;
        while i < n {
            norm_sq = norm_sq + H[i][k] * H[i][k];
            i = i + 1;
        }
        let norm_x = num_sqrt(norm_sq);
        if norm_x > 1e-15 {
            let alpha = (0.0 - _sign_nonzero(H[k + 1][k])) * norm_x;
            let v = [];
            let i2 = k + 1;
            while i2 < n {
                if i2 == k + 1 {
                    array_push(v, H[i2][k] - alpha);
                } else {
                    array_push(v, H[i2][k]);
                }
                i2 = i2 + 1;
            }
            let v_sq = 0.0;
            let iv = 0;
            while iv < len(v) {
                v_sq = v_sq + v[iv] * v[iv];
                iv = iv + 1;
            }
            let v_norm = num_sqrt(v_sq);
            if v_norm > 1e-15 {
                let u = [];
                let iu = 0;
                while iu < len(v) {
                    array_push(u, v[iu] / v_norm);
                    iu = iu + 1;
                }
                // Left apply: H[k+1..n-1, k..n-1] -= 2 u (u^T H)
                let col = k;
                while col < n {
                    let dot_uh = 0.0;
                    let r = 0;
                    while r < len(u) {
                        dot_uh = dot_uh + u[r] * H[k + 1 + r][col];
                        r = r + 1;
                    }
                    let two_uh = 2.0 * dot_uh;
                    let r2 = 0;
                    while r2 < len(u) {
                        H[k + 1 + r2][col] = H[k + 1 + r2][col] - two_uh * u[r2];
                        r2 = r2 + 1;
                    }
                    col = col + 1;
                }
                // Right apply: H[0..n-1, k+1..n-1] -= 2 (H u) u^T
                let row = 0;
                while row < n {
                    let dot_hu = 0.0;
                    let c = 0;
                    while c < len(u) {
                        dot_hu = dot_hu + H[row][k + 1 + c] * u[c];
                        c = c + 1;
                    }
                    let two_hu = 2.0 * dot_hu;
                    let c2 = 0;
                    while c2 < len(u) {
                        H[row][k + 1 + c2] = H[row][k + 1 + c2] - two_hu * u[c2];
                        c2 = c2 + 1;
                    }
                    row = row + 1;
                }
                let zi = k + 2;
                while zi < n {
                    H[zi][k] = 0.0;
                    zi = zi + 1;
                }
            }
        }
        k = k + 1;
    }

    let norm_h = 0.0;
    let r_n = 0;
    while r_n < n {
        let c_n = 0;
        while c_n < n {
            norm_h = norm_h + num_abs(H[r_n][c_n]);
            c_n = c_n + 1;
        }
        r_n = r_n + 1;
    }
    if norm_h == 0.0 { norm_h = 1.0; }

    // Step 2: Francis Implicit Double-Shift QR Iteration with Wilkinson & ad-hoc shifts
    let eigs = [];
    let nn = n - 1;
    let total_iters = 0;
    let local_iters = 0;
    let max_qr_iters = GOV.current_limits()["max_opt_iter"] * 4;
    let trk = GOV.new_tracker("linalg_geometry.eig_general");

    while nn >= 0 and total_iters < max_qr_iters {
        GOV.tick(trk, 1);
        if nn == 0 {
            array_push(eigs, { re: H[0][0], im: 0.0 });
            nn = -1;
        } else {
            // Deflation scan
            let idx_d = nn;
            while idx_d >= 1 {
                let s_scale = num_abs(H[idx_d - 1][idx_d - 1]) + num_abs(H[idx_d][idx_d]);
                if s_scale == 0.0 { s_scale = norm_h; }
                if num_abs(H[idx_d][idx_d - 1]) <= _MACHINE_EPS * s_scale {
                    H[idx_d][idx_d - 1] = 0.0;
                }
                idx_d = idx_d - 1;
            }

            let l_start = nn;
            let searching = true;
            while l_start > 0 and searching {
                if H[l_start][l_start - 1] == 0.0 {
                    searching = false;
                } else {
                    l_start = l_start - 1;
                }
            }

            if l_start == nn {
                array_push(eigs, { re: H[nn][nn], im: 0.0 });
                nn = nn - 1;
                local_iters = 0;
            } else {
                if l_start == nn - 1 {
                    let pair = _eig_2x2_pair(H[nn - 1][nn - 1], H[nn - 1][nn], H[nn][nn - 1], H[nn][nn]);
                    array_push(eigs, pair[0]);
                    array_push(eigs, pair[1]);
                    nn = nn - 2;
                    local_iters = 0;
                } else {
                    total_iters = total_iters + 1;
                    local_iters = local_iters + 1;

                    let a_tr = H[nn - 1][nn - 1];
                    let b_tr = H[nn - 1][nn];
                    let c_tr = H[nn][nn - 1];
                    let d_tr = H[nn][nn];
                    let s_shift = a_tr + d_tr;
                    let t_shift = a_tr * d_tr - b_tr * c_tr;

                    // EISPACK exceptional ad-hoc shift to break symmetry cycles (e.g. permutation matrices)
                    if local_iters == 10 or local_iters == 20 {
                        let w_ex = num_abs(H[nn][nn - 1]) + num_abs(H[nn - 1][nn - 2]);
                        s_shift = 1.5 * w_ex;
                        t_shift = w_ex * w_ex;
                    }

                    let m0 = l_start;
                    let x_b = H[m0][m0] * H[m0][m0] + H[m0][m0 + 1] * H[m0 + 1][m0] - s_shift * H[m0][m0] + t_shift;
                    let y_b = H[m0 + 1][m0] * (H[m0][m0] + H[m0 + 1][m0 + 1] - s_shift);
                    let z_b = H[m0 + 2][m0 + 1] * H[m0 + 1][m0];

                    let k_step = m0;
                    while k_step <= nn - 1 {
                        let r_len = 3;
                        if k_step == nn - 1 { r_len = 2; }
                        let v_norm_sq = x_b * x_b + y_b * y_b;
                        if r_len == 3 { v_norm_sq = v_norm_sq + z_b * z_b; }
                        let v_norm = num_sqrt(v_norm_sq);

                        if v_norm > 1e-30 {
                            let alpha = (0.0 - _sign_nonzero(x_b)) * v_norm;
                            let v0 = x_b - alpha;
                            let v1 = y_b;
                            let v2 = z_b;
                            let u_sq = v0 * v0 + v1 * v1;
                            if r_len == 3 { u_sq = u_sq + v2 * v2; }
                            let u_norm = num_sqrt(u_sq);
                            if u_norm > 1e-30 {
                                let u0 = v0 / u_norm;
                                let u1 = v1 / u_norm;
                                let u2 = 0.0;
                                if r_len == 3 { u2 = v2 / u_norm; }

                                let col_lo = k_step - 1;
                                if col_lo < l_start { col_lo = l_start; }
                                let cj = col_lo;
                                while cj <= nn {
                                    let dot_u = u0 * H[k_step][cj] + u1 * H[k_step + 1][cj];
                                    if r_len == 3 { dot_u = dot_u + u2 * H[k_step + 2][cj]; }
                                    let two_d = 2.0 * dot_u;
                                    H[k_step][cj] = H[k_step][cj] - two_d * u0;
                                    H[k_step + 1][cj] = H[k_step + 1][cj] - two_d * u1;
                                    if r_len == 3 {
                                        H[k_step + 2][cj] = H[k_step + 2][cj] - two_d * u2;
                                    }
                                    cj = cj + 1;
                                }

                                let row_hi = k_step + 3;
                                if row_hi > nn { row_hi = nn; }
                                let ri = l_start;
                                while ri <= row_hi {
                                    let dot_r = H[ri][k_step] * u0 + H[ri][k_step + 1] * u1;
                                    if r_len == 3 { dot_r = dot_r + H[ri][k_step + 2] * u2; }
                                    let two_r = 2.0 * dot_r;
                                    H[ri][k_step] = H[ri][k_step] - two_r * u0;
                                    H[ri][k_step + 1] = H[ri][k_step + 1] - two_r * u1;
                                    if r_len == 3 {
                                        H[ri][k_step + 2] = H[ri][k_step + 2] - two_r * u2;
                                    }
                                    ri = ri + 1;
                                }
                            }
                        }

                        if k_step < nn - 1 {
                            x_b = H[k_step + 1][k_step];
                            y_b = H[k_step + 2][k_step];
                            if k_step + 3 <= nn {
                                z_b = H[k_step + 3][k_step];
                            } else {
                                z_b = 0.0;
                            }
                        }
                        k_step = k_step + 1;
                    }
                }
            }
        }
    }

    // Sort eigenvalues descending by real part, then descending by imaginary part
    let s_i = 1;
    while s_i < len(eigs) {
        let key_e = eigs[s_i];
        let s_j = s_i - 1;
        let move_flag = true;
        while s_j >= 0 and move_flag {
            let cur = eigs[s_j];
            let swap_needed = false;
            if cur.re < key_e.re - 1e-12 {
                swap_needed = true;
            } else {
                if num_abs(cur.re - key_e.re) <= 1e-12 and cur.im < key_e.im {
                    swap_needed = true;
                }
            }
            if swap_needed {
                eigs[s_j + 1] = cur;
                s_j = s_j - 1;
            } else {
                move_flag = false;
            }
        }
        eigs[s_j + 1] = key_e;
        s_i = s_i + 1;
    }

    return {
        eigenvalues: eigs,
        converged: (nn < 0),
        iterations: total_iters
    };
}

// Helper: One-sided Hestenes-Jacobi SVD for m >= n (avoids A^T A condition-number squaring!)
fn _svd_tall(MA) {
    let m = len(MA);
    let n = len(MA[0]);
    let W = mat_copy(MA);
    let V = mat_eye(n);

    let max_sw = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("linalg_geometry.svd");
    let sweep = 0;
    let done = false;
    while sweep < max_sw and not done {
        GOV.tick(trk, n);
        let max_cos = 0.0;
        let p = 0;
        while p < n - 1 {
            let q = p + 1;
            while q < n {
                let alpha = 0.0;
                let beta = 0.0;
                let gamma = 0.0;
                let i = 0;
                while i < m {
                    let wp = W[i][p];
                    let wq = W[i][q];
                    alpha = alpha + wp * wp;
                    beta = beta + wq * wq;
                    gamma = gamma + wp * wq;
                    i = i + 1;
                }
                let denom_ab = num_sqrt(alpha * beta);
                if denom_ab > 1e-30 {
                    let rel = num_abs(gamma) / denom_ab;
                    if rel > max_cos { max_cos = rel; }
                    if rel > 1e-15 {
                        let zeta = (beta - alpha) / (2.0 * gamma);
                        let t_rot = _sign_nonzero(zeta) / (num_abs(zeta) + num_sqrt(1.0 + zeta * zeta));
                        let c_rot = 1.0 / num_sqrt(1.0 + t_rot * t_rot);
                        let s_rot = t_rot * c_rot;
                        let r = 0;
                        while r < m {
                            let wp = W[r][p];
                            let wq = W[r][q];
                            W[r][p] = c_rot * wp - s_rot * wq;
                            W[r][q] = s_rot * wp + c_rot * wq;
                            r = r + 1;
                        }
                        let rv = 0;
                        while rv < n {
                            let vp = V[rv][p];
                            let vq = V[rv][q];
                            V[rv][p] = c_rot * vp - s_rot * vq;
                            V[rv][q] = s_rot * vp + c_rot * vq;
                            rv = rv + 1;
                        }
                    }
                }
                q = q + 1;
            }
            p = p + 1;
        }
        if max_cos <= 1e-15 {
            done = true;
        } else {
            sweep = sweep + 1;
        }
    }

    let sigmas = [];
    let order = [];
    let j = 0;
    while j < n {
        let s_sq = 0.0;
        let i = 0;
        while i < m {
            s_sq = s_sq + W[i][j] * W[i][j];
            i = i + 1;
        }
        array_push(sigmas, num_sqrt(s_sq));
        array_push(order, j);
        j = j + 1;
    }

    // Sort singular values descending
    let a = 1;
    while a < n {
        let ks = sigmas[a];
        let ko = order[a];
        let b = a - 1;
        while b >= 0 and sigmas[b] < ks {
            sigmas[b + 1] = sigmas[b];
            order[b + 1] = order[b];
            b = b - 1;
        }
        sigmas[b + 1] = ks;
        order[b + 1] = ko;
        a = a + 1;
    }

    let sigma_max = sigmas[0];
    let tol = _max2(m, n) * 1e-13 * _max2(1.0, sigma_max);
    if sigma_max == 0.0 { tol = 1e-15; }

    let U = mat_zeros(m, n);
    let Vt = mat_zeros(n, n);
    let rank_cnt = 0;
    let filled_u_cols = [];

    let col = 0;
    while col < n {
        let src = order[col];
        let r_v = 0;
        while r_v < n {
            Vt[col][r_v] = V[r_v][src];
            r_v = r_v + 1;
        }
        let sv = sigmas[col];
        if sv > tol {
            rank_cnt = rank_cnt + 1;
            let r_u = 0;
            while r_u < m {
                U[r_u][col] = W[r_u][src] / sv;
                r_u = r_u + 1;
            }
            array_push(filled_u_cols, col);
        }
        col = col + 1;
    }

    // Complete orthonormal columns of U for rank-deficient zero singular values via twice-iterated MGS
    let col2 = 0;
    while col2 < n {
        if sigmas[col2] <= tol {
            // Choose standard basis vector e_best with smallest projection onto existing columns
            let best_e = 0;
            let best_norm = -1.0;
            let cand_vec = [];
            let try_e = 0;
            while try_e < m {
                let v_try = [];
                let ii = 0;
                while ii < m {
                    if ii == try_e { array_push(v_try, 1.0); } else { array_push(v_try, 0.0); }
                    ii = ii + 1;
                }
                // Two passes of Modified Gram-Schmidt against filled_u_cols
                let pass = 0;
                while pass < 2 {
                    let fi = 0;
                    while fi < len(filled_u_cols) {
                        let fc = filled_u_cols[fi];
                        let dot_p = 0.0;
                        let rr = 0;
                        while rr < m {
                            dot_p = dot_p + U[rr][fc] * v_try[rr];
                            rr = rr + 1;
                        }
                        let rr2 = 0;
                        while rr2 < m {
                            v_try[rr2] = v_try[rr2] - dot_p * U[rr2][fc];
                            rr2 = rr2 + 1;
                        }
                        fi = fi + 1;
                    }
                    pass = pass + 1;
                }
                let nsq = 0.0;
                let rr3 = 0;
                while rr3 < m {
                    nsq = nsq + v_try[rr3] * v_try[rr3];
                    rr3 = rr3 + 1;
                }
                if nsq > best_norm {
                    best_norm = nsq;
                    best_e = try_e;
                    cand_vec = v_try;
                }
                if best_norm > 0.25 {
                    try_e = m;
                } else {
                    try_e = try_e + 1;
                }
            }
            let inv_n = 1.0 / num_sqrt(best_norm);
            let rr4 = 0;
            while rr4 < m {
                U[rr4][col2] = cand_vec[rr4] * inv_n;
                rr4 = rr4 + 1;
            }
            array_push(filled_u_cols, col2);
        }
        col2 = col2 + 1;
    }

    let S_mat = mat_zeros(n, n);
    let si = 0;
    while si < n {
        S_mat[si][si] = sigmas[si];
        si = si + 1;
    }

    let cond2 = 1e308;
    if sigmas[n - 1] > tol {
        cond2 = sigmas[0] / sigmas[n - 1];
    } else {
        if sigma_max == 0.0 { cond2 = 0.0; }
    }

    return {
        U: U,
        S: S_mat,
        singular_values: sigmas,
        Vt: Vt,
        rank: rank_cnt,
        cond_2: cond2
    };
}

// Singular Value Decomposition A = U * S * Vt for arbitrary m x n matrices.
fn svd(A) {
    let MA = _check_float_mat(A, "svd");
    let m = len(MA);
    let n = len(MA[0]);
    if m >= n {
        return _svd_tall(MA);
    }
    // Wide matrix m < n: compute SVD of A^T = U_t S V_t^T => A = V_t S U_t^T
    let AT = mat_transpose(MA);
    let res_t = _svd_tall(AT);
    return {
        U: mat_transpose(res_t.Vt),
        S: res_t.S,
        singular_values: res_t.singular_values,
        Vt: mat_transpose(res_t.U),
        rank: res_t.rank,
        cond_2: res_t.cond_2
    };
}

// Moore-Penrose pseudoinverse A^+ satisfying A A^+ A = A and A^+ A A^+ = A^+.
fn pinv(A) {
    let MA = _check_float_mat(A, "pinv");
    let m = len(MA);
    let n = len(MA[0]);
    let s = svd(MA);
    let k = len(s.singular_values);
    let sigma_max = s.singular_values[0];
    let tol = _max2(m, n) * 1e-13 * _max2(1.0, sigma_max);
    let out = mat_zeros(n, m);
    let r = 0;
    while r < k {
        let sv = s.singular_values[r];
        if sv > tol {
            let inv_sv = 1.0 / sv;
            let i = 0;
            while i < n {
                let v_ir = s.Vt[r][i] * inv_sv;
                let j = 0;
                while j < m {
                    out[i][j] = out[i][j] + v_ir * s.U[j][r];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        r = r + 1;
    }
    return out;
}

// 2-norm condition number kappa_2(A) = sigma_max / sigma_min.
fn cond_number(A) {
    let s = svd(A);
    return s.cond_2;
}

// Overdetermined / minimum-norm least squares solver min_x ||A x - b||_2.
fn lstsq(A, b) {
    let MA = _check_float_mat(A, "lstsq");
    let rhs = _check_float_vec(b, "lstsq");
    let m = len(MA);
    let n = len(MA[0]);
    if len(rhs) != m {
        throw "linalg_geometry (lstsq): vector b length must equal rows of A";
    }
    let x = [];
    let rank_val = n;
    if m >= n {
        let qr = qr_decompose(MA);
        let full_rank = true;
        let d = 0;
        while d < n {
            if num_abs(qr.R_thin[d][d]) < 1e-12 {
                full_rank = false;
            }
            d = d + 1;
        }
        if full_rank {
            // c = Q_thin^T b, solve R_thin x = c
            let c_vec = [];
            let j = 0;
            while j < n {
                let dot_qb = 0.0;
                let i = 0;
                while i < m {
                    dot_qb = dot_qb + qr.Q_thin[i][j] * rhs[i];
                    i = i + 1;
                }
                array_push(c_vec, dot_qb);
                j = j + 1;
            }
            let k = 0;
            while k < n {
                array_push(x, 0.0);
                k = k + 1;
            }
            let r = n - 1;
            while r >= 0 {
                let s = c_vec[r];
                let col = r + 1;
                while col < n {
                    s = s - qr.R_thin[r][col] * x[col];
                    col = col + 1;
                }
                x[r] = s / qr.R_thin[r][r];
                r = r - 1;
            }
        } else {
            let sv = svd(MA);
            rank_val = sv.rank;
            x = mat_vec_mul(pinv(MA), rhs);
        }
    } else {
        let sv = svd(MA);
        rank_val = sv.rank;
        x = mat_vec_mul(pinv(MA), rhs);
    }

    let ax = mat_vec_mul(MA, x);
    let residuals = [];
    let res_sq = 0.0;
    let idx = 0;
    while idx < m {
        let diff = ax[idx] - rhs[idx];
        array_push(residuals, diff);
        res_sq = res_sq + diff * diff;
        idx = idx + 1;
    }
    return {
        x: x,
        residuals: residuals,
        residual_norm: num_sqrt(res_sq),
        rank: rank_val
    };
}

// Matrix norms: Frobenius, induced L1, induced L_inf, and spectral L2.
fn mat_norms(A) {
    let MA = _check_float_mat(A, "mat_norms");
    let m = len(MA);
    let n = len(MA[0]);
    let frob_sq = 0.0;
    let linf = 0.0;
    let i = 0;
    while i < m {
        let row_sum = 0.0;
        let j = 0;
        while j < n {
            let v = num_abs(MA[i][j]);
            frob_sq = frob_sq + v * v;
            row_sum = row_sum + v;
            j = j + 1;
        }
        if row_sum > linf { linf = row_sum; }
        i = i + 1;
    }
    let l1 = 0.0;
    let c = 0;
    while c < n {
        let col_sum = 0.0;
        let r = 0;
        while r < m {
            col_sum = col_sum + num_abs(MA[r][c]);
            r = r + 1;
        }
        if col_sum > l1 { l1 = col_sum; }
        c = c + 1;
    }
    let sv = svd(MA);
    return {
        frobenius: num_sqrt(frob_sq),
        l1: l1,
        linf: linf,
        spectral_2: sv.singular_values[0]
    };
}

// Matrix Exponential expm(A) via Higham Scaling-and-Squaring [6/6] Pade Approximant.
fn expm(A) {
    let MA = _check_square_mat(A, "expm");
    let n = len(MA);

    // Infinity norm of A
    let norm_inf = 0.0;
    let i = 0;
    while i < n {
        let rs = 0.0;
        let j = 0;
        while j < n {
            rs = rs + num_abs(MA[i][j]);
            j = j + 1;
        }
        if rs > norm_inf { norm_inf = rs; }
        i = i + 1;
    }

    if norm_inf == 0.0 {
        return mat_eye(n);
    }

    // Scale X = A / 2^s so ||X||_inf <= 0.5 (achieves < 1e-15 accuracy for [6/6] Pade)
    let s_pow = 0;
    let scale_factor = 1.0;
    while norm_inf / scale_factor > 0.5 {
        scale_factor = scale_factor * 2.0;
        s_pow = s_pow + 1;
    }
    let X = mat_scale(MA, 1.0 / scale_factor);

    // Exact integer-scaled [6/6] Pade weights: b_k = c_k * 665280
    let b0 = 665280.0;
    let b1 = 332640.0;
    let b2 = 75600.0;
    let b3 = 10080.0;
    let b4 = 840.0;
    let b5 = 42.0;
    let b6 = 1.0;

    let I_n = mat_eye(n);
    let X2 = mat_mul(X, X);
    let X4 = mat_mul(X2, X2);
    let X6 = mat_mul(X2, X4);

    // U_even = b6*X6 + b4*X4 + b2*X2 + b0*I
    // W_inner = b5*X4 + b3*X2 + b1*I, V_odd = X * W_inner
    let U_even = mat_zeros(n, n);
    let W_inner = mat_zeros(n, n);
    let r = 0;
    while r < n {
        let c = 0;
        while c < n {
            let id_rc = I_n[r][c];
            U_even[r][c] = b6 * X6[r][c] + b4 * X4[r][c] + b2 * X2[r][c] + b0 * id_rc;
            W_inner[r][c] = b5 * X4[r][c] + b3 * X2[r][c] + b1 * id_rc;
            c = c + 1;
        }
        r = r + 1;
    }
    let V_odd = mat_mul(X, W_inner);

    let P_num = mat_add(U_even, V_odd);
    let Q_den = mat_sub(U_even, V_odd);

    // Solve Q_den * R_pade = P_num column by column
    let lu_q = lu_decompose(Q_den);
    let R_pade = mat_zeros(n, n);
    let col = 0;
    while col < n {
        let p_col = [];
        let rr = 0;
        while rr < n {
            array_push(p_col, P_num[rr][col]);
            rr = rr + 1;
        }
        let sol_col = lu_solve(lu_q, p_col);
        let rr2 = 0;
        while rr2 < n {
            R_pade[rr2][col] = sol_col[rr2];
            rr2 = rr2 + 1;
        }
        col = col + 1;
    }

    // Squaring phase: R <- R^(2^s)
    let sq = 0;
    while sq < s_pow {
        R_pade = mat_mul(R_pade, R_pade);
        sq = sq + 1;
    }
    return R_pade;
}

// ============================================================================
// 3. N-Dimensional Tensor Algebra & Differential Geometry
// ============================================================================

fn _compute_strides(shape) {
    let ndim = len(shape);
    let strides = [];
    let k = 0;
    while k < ndim {
        array_push(strides, 1);
        k = k + 1;
    }
    let d = ndim - 2;
    while d >= 0 {
        strides[d] = strides[d + 1] * shape[d + 1];
        d = d - 1;
    }
    return strides;
}

fn _validate_shape(shape, ctx) {
    if type(shape) != "array" {
        throw "linalg_geometry (" + ctx + "): tensor shape must be an array";
    }
    let ndim = len(shape);
    if ndim == 0 {
        return { shape: [], size: 1 };
    }
    let max_d = GOV.current_limits()["max_matrix_dim"];
    let total = 1;
    let out_shape = [];
    let d = 0;
    while d < ndim {
        let dim = num_round(_num(shape[d]));
        if dim < 1 or dim > max_d {
            throw "MathGovernor[linalg_geometry:" + ctx + "]: invalid tensor axis dimension " + str(dim) + " (max " + str(max_d) + ")";
        }
        total = total * dim;
        if total > max_d * max_d {
            throw "MathGovernor[linalg_geometry:" + ctx + "]: tensor element count exceeds adaptive safety bound";
        }
        array_push(out_shape, dim);
        d = d + 1;
    }
    return { shape: out_shape, size: total };
}

fn tensor_new(shape, data) {
    let sv = _validate_shape(shape, "tensor_new");
    if type(data) != "array" or len(data) != sv.size {
        throw "linalg_geometry (tensor_new): data length does not match shape product";
    }
    let buf = [];
    let i = 0;
    while i < sv.size {
        array_push(buf, _num(data[i]));
        i = i + 1;
    }
    return {
        shape: sv.shape,
        strides: _compute_strides(sv.shape),
        data: buf,
        ndim: len(sv.shape),
        size: sv.size
    };
}

fn tensor_zeros(shape) {
    let sv = _validate_shape(shape, "tensor_zeros");
    let buf = [];
    let i = 0;
    while i < sv.size {
        array_push(buf, 0.0);
        i = i + 1;
    }
    return tensor_new(sv.shape, buf);
}

fn _check_tensor(T, ctx) {
    if type(T) == "map" and map_has(T, "shape") and map_has(T, "data") {
        return T;
    }
    if type(T) == "array" and len(T) > 0 {
        if type(T[0]) == "array" {
            let M = _check_float_mat(T, ctx);
            let m = len(M);
            let n = len(M[0]);
            let flat = [];
            let i = 0;
            while i < m {
                let j = 0;
                while j < n {
                    array_push(flat, M[i][j]);
                    j = j + 1;
                }
                i = i + 1;
            }
            return tensor_new([m, n], flat);
        } else {
            let v = _check_float_vec(T, ctx);
            return tensor_new([len(v)], v);
        }
    }
    throw "linalg_geometry (" + ctx + "): expected tensor";
}

fn _tensor_flat_idx(T, indices, ctx) {
    if type(indices) != "array" or len(indices) != len(T.shape) {
        throw "linalg_geometry (" + ctx + "): indices rank mismatch";
    }
    let flat = 0;
    let d = 0;
    while d < len(T.shape) {
        let idx = num_round(_num(indices[d]));
        if idx < 0 or idx >= T.shape[d] {
            throw "linalg_geometry (" + ctx + "): tensor index out of bounds";
        }
        flat = flat + idx * T.strides[d];
        d = d + 1;
    }
    return flat;
}

fn tensor_get(T, indices) {
    let TT = _check_tensor(T, "tensor_get");
    let flat = _tensor_flat_idx(TT, indices, "tensor_get");
    return TT.data[flat];
}

fn tensor_set(T, indices, val) {
    let TT = _check_tensor(T, "tensor_set");
    let flat = _tensor_flat_idx(TT, indices, "tensor_set");
    TT.data[flat] = _num(val);
    return TT;
}

fn tensor_reshape(T, new_shape) {
    let TT = _check_tensor(T, "tensor_reshape");
    let sv = _validate_shape(new_shape, "tensor_reshape");
    if sv.size != TT.size {
        throw "linalg_geometry (tensor_reshape): cannot reshape size " + str(TT.size) + " into " + str(sv.size);
    }
    return tensor_new(sv.shape, TT.data);
}

fn tensor_PermuteAxes(T, perm) {
    let TT = _check_tensor(T, "tensor_PermuteAxes");
    let ndim = len(TT.shape);
    if type(perm) != "array" or len(perm) != ndim {
        throw "linalg_geometry (tensor_PermuteAxes): permutation length must match tensor ndim";
    }
    if ndim == 0 {
        return tensor_new([], TT.data);
    }
    let seen = [];
    let k = 0;
    while k < ndim {
        array_push(seen, false);
        k = k + 1;
    }
    let new_shape = [];
    let d = 0;
    while d < ndim {
        let p = num_round(_num(perm[d]));
        if p < 0 or p >= ndim or seen[p] {
            throw "linalg_geometry (tensor_PermuteAxes): invalid axis permutation";
        }
        seen[p] = true;
        array_push(new_shape, TT.shape[p]);
        d = d + 1;
    }

    let new_strides = _compute_strides(new_shape);
    let out_data = [];
    let total = TT.size;
    let idx_flat = 0;
    while idx_flat < total {
        let rem = idx_flat;
        let src_flat = 0;
        let ax = 0;
        while ax < ndim {
            let coord = num_floor(rem / new_strides[ax]);
            rem = rem - coord * new_strides[ax];
            let orig_ax = num_round(_num(perm[ax]));
            src_flat = src_flat + coord * TT.strides[orig_ax];
            ax = ax + 1;
        }
        array_push(out_data, TT.data[src_flat]);
        idx_flat = idx_flat + 1;
    }
    return tensor_new(new_shape, out_data);
}

fn tensor_permute_axes(T, perm) {
    return tensor_PermuteAxes(T, perm);
}

fn tensor_outer(A, B) {
    let TA = _check_tensor(A, "tensor_outer");
    let TB = _check_tensor(B, "tensor_outer");
    let out_shape = [];
    let i = 0;
    while i < len(TA.shape) {
        array_push(out_shape, TA.shape[i]);
        i = i + 1;
    }
    let j = 0;
    while j < len(TB.shape) {
        array_push(out_shape, TB.shape[j]);
        j = j + 1;
    }
    let sv = _validate_shape(out_shape, "tensor_outer");
    let out_data = [];
    let ia = 0;
    while ia < TA.size {
        let va = TA.data[ia];
        let ib = 0;
        while ib < TB.size {
            array_push(out_data, va * TB.data[ib]);
            ib = ib + 1;
        }
        ia = ia + 1;
    }
    return tensor_new(sv.shape, out_data);
}

fn _norm_axes_arg(axes_raw, ndim, ctx) {
    let arr = axes_raw;
    if type(axes_raw) == "number" {
        arr = [axes_raw];
    }
    if type(arr) != "array" {
        throw "linalg_geometry (" + ctx + "): axes must be integer or array of integers";
    }
    let out = [];
    let seen = [];
    let i = 0;
    while i < ndim {
        array_push(seen, false);
        i = i + 1;
    }
    let k = 0;
    while k < len(arr) {
        let ax = num_round(_num(arr[k]));
        if ax < 0 or ax >= ndim or seen[ax] {
            throw "linalg_geometry (" + ctx + "): invalid or duplicate contraction axis";
        }
        seen[ax] = true;
        array_push(out, ax);
        k = k + 1;
    }
    return out;
}

fn _contains_int(arr, target) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == target { return true; }
        i = i + 1;
    }
    return false;
}

// Generalized N-D tensor contraction (Einstein summation over paired axes_a and axes_b).
fn tensor_contract(A, B, axes_a, axes_b) {
    let TA = _check_tensor(A, "tensor_contract");
    let TB = _check_tensor(B, "tensor_contract");
    let ax_a = _norm_axes_arg(axes_a, len(TA.shape), "tensor_contract");
    let ax_b = _norm_axes_arg(axes_b, len(TB.shape), "tensor_contract");
    if len(ax_a) != len(ax_b) {
        throw "linalg_geometry (tensor_contract): axes_a and axes_b must have equal length";
    }

    let k_len = 1;
    let c = 0;
    while c < len(ax_a) {
        let da = TA.shape[ax_a[c]];
        let db = TB.shape[ax_b[c]];
        if da != db {
            throw "linalg_geometry (tensor_contract): contracted axis dimension mismatch (" + str(da) + " vs " + str(db) + ")";
        }
        k_len = k_len * da;
        c = c + 1;
    }

    let free_a = [];
    let free_a_shape = [];
    let m_len = 1;
    let ia = 0;
    while ia < len(TA.shape) {
        if not _contains_int(ax_a, ia) {
            array_push(free_a, ia);
            array_push(free_a_shape, TA.shape[ia]);
            m_len = m_len * TA.shape[ia];
        }
        ia = ia + 1;
    }

    let free_b = [];
    let free_b_shape = [];
    let n_len = 1;
    let ib = 0;
    while ib < len(TB.shape) {
        if not _contains_int(ax_b, ib) {
            array_push(free_b, ib);
            array_push(free_b_shape, TB.shape[ib]);
            n_len = n_len * TB.shape[ib];
        }
        ib = ib + 1;
    }

    // Permute A -> (free_a ++ ax_a) and B -> (ax_b ++ free_b)
    let perm_a = [];
    let pa = 0;
    while pa < len(free_a) { array_push(perm_a, free_a[pa]); pa = pa + 1; }
    let ca = 0;
    while ca < len(ax_a) { array_push(perm_a, ax_a[ca]); ca = ca + 1; }

    let perm_b = [];
    let cb = 0;
    while cb < len(ax_b) { array_push(perm_b, ax_b[cb]); cb = cb + 1; }
    let pb = 0;
    while pb < len(free_b) { array_push(perm_b, free_b[pb]); pb = pb + 1; }

    let PA = tensor_PermuteAxes(TA, perm_a);
    let PB = tensor_PermuteAxes(TB, perm_b);

    let out_shape = [];
    let s1 = 0;
    while s1 < len(free_a_shape) { array_push(out_shape, free_a_shape[s1]); s1 = s1 + 1; }
    let s2 = 0;
    while s2 < len(free_b_shape) { array_push(out_shape, free_b_shape[s2]); s2 = s2 + 1; }
    let sv = _validate_shape(out_shape, "tensor_contract");

    let out_data = [];
    let idx_z = 0;
    while idx_z < m_len * n_len {
        array_push(out_data, 0.0);
        idx_z = idx_z + 1;
    }

    let i_row = 0;
    while i_row < m_len {
        let base_a = i_row * k_len;
        let base_c = i_row * n_len;
        let k_idx = 0;
        while k_idx < k_len {
            let va = PA.data[base_a + k_idx];
            if va != 0.0 {
                let base_b = k_idx * n_len;
                let j_col = 0;
                while j_col < n_len {
                    out_data[base_c + j_col] = out_data[base_c + j_col] + va * PB.data[base_b + j_col];
                    j_col = j_col + 1;
                }
            }
            k_idx = k_idx + 1;
        }
        i_row = i_row + 1;
    }

    return tensor_new(sv.shape, out_data);
}

// ── Differential Geometry Helpers ──────────────────────────────────────────

fn vec3_cross(a, b) {
    let va = _check_float_vec(a, "vec3_cross");
    let vb = _check_float_vec(b, "vec3_cross");
    if len(va) != 3 or len(vb) != 3 {
        throw "linalg_geometry (vec3_cross): expected 3D vectors";
    }
    return [
        va[1] * vb[2] - va[2] * vb[1],
        va[2] * vb[0] - va[0] * vb[2],
        va[0] * vb[1] - va[1] * vb[0]
    ];
}

fn _vec_dot(a, b) {
    let s = 0.0;
    let i = 0;
    while i < len(a) {
        s = s + a[i] * b[i];
        i = i + 1;
    }
    return s;
}

fn _vec_norm(a) {
    return num_sqrt(_vec_dot(a, a));
}

fn _vec_scale(a, s) {
    let out = [];
    let i = 0;
    while i < len(a) {
        array_push(out, a[i] * s);
        i = i + 1;
    }
    return out;
}

// Frenet-Serret 3D frame, curvature kappa(t), and torsion tau(t) using 4th-order central stencils.
fn frenet_serret_3d(r_fn, t, h = 1e-5) {
    if type(r_fn) != "fn" {
        throw "linalg_geometry (frenet_serret_3d): r_fn must be a function";
    }
    let t0 = _num(t);
    let h_base = _num(h);
    if h_base <= 0.0 {
        throw "linalg_geometry (frenet_serret_3d): step h must be positive";
    }

    // Optimal step balancing truncation O(h^4) vs IEEE-754 roundoff for 1st, 2nd, 3rd derivatives
    let h1 = _max2(h_base, 1e-3);
    let h2 = _max2(h_base, 1e-3);
    let h3 = _max2(h_base, 5e-3);

    let r_m2 = _check_float_vec(r_fn(t0 - 2.0 * h1), "frenet_serret_3d");
    let r_m1 = _check_float_vec(r_fn(t0 - h1), "frenet_serret_3d");
    let r_p1 = _check_float_vec(r_fn(t0 + h1), "frenet_serret_3d");
    let r_p2 = _check_float_vec(r_fn(t0 + 2.0 * h1), "frenet_serret_3d");
    if len(r_m1) != 3 {
        throw "linalg_geometry (frenet_serret_3d): curve r_fn(t) must return a 3D vector";
    }

    let r0 = _check_float_vec(r_fn(t0), "frenet_serret_3d");
    let r2_m2 = _check_float_vec(r_fn(t0 - 2.0 * h2), "frenet_serret_3d");
    let r2_m1 = _check_float_vec(r_fn(t0 - h2), "frenet_serret_3d");
    let r2_p1 = _check_float_vec(r_fn(t0 + h2), "frenet_serret_3d");
    let r2_p2 = _check_float_vec(r_fn(t0 + 2.0 * h2), "frenet_serret_3d");

    let r3_m3 = _check_float_vec(r_fn(t0 - 3.0 * h3), "frenet_serret_3d");
    let r3_m2 = _check_float_vec(r_fn(t0 - 2.0 * h3), "frenet_serret_3d");
    let r3_m1 = _check_float_vec(r_fn(t0 - h3), "frenet_serret_3d");
    let r3_p1 = _check_float_vec(r_fn(t0 + h3), "frenet_serret_3d");
    let r3_p2 = _check_float_vec(r_fn(t0 + 2.0 * h3), "frenet_serret_3d");
    let r3_p3 = _check_float_vec(r_fn(t0 + 3.0 * h3), "frenet_serret_3d");

    let d1 = [];
    let d2 = [];
    let d3 = [];
    let i = 0;
    let den1 = 12.0 * h1;
    let den2 = 12.0 * h2 * h2;
    let den3 = 8.0 * h3 * h3 * h3;
    while i < 3 {
        let v1 = (r_m2[i] - 8.0 * r_m1[i] + 8.0 * r_p1[i] - r_p2[i]) / den1;
        let v2 = ((0.0 - r2_m2[i]) + 16.0 * r2_m1[i] - 30.0 * r0[i] + 16.0 * r2_p1[i] - r2_p2[i]) / den2;
        let v3 = (r3_m3[i] - 8.0 * r3_m2[i] + 13.0 * r3_m1[i] - 13.0 * r3_p1[i] + 8.0 * r3_p2[i] - r3_p3[i]) / den3;
        array_push(d1, v1);
        array_push(d2, v2);
        array_push(d3, v3);
        i = i + 1;
    }

    let speed = _vec_norm(d1);
    if speed < 1e-14 {
        throw "linalg_geometry (frenet_serret_3d): singular curve point (zero speed)";
    }
    let T_vec = _vec_scale(d1, 1.0 / speed);
    let cross_12 = vec3_cross(d1, d2);
    let cross_norm = _vec_norm(cross_12);
    let kappa = cross_norm / (speed * speed * speed);

    let N_vec = [0.0, 0.0, 0.0];
    let B_vec = [0.0, 0.0, 0.0];
    let tau = 0.0;
    if cross_norm > 1e-13 {
        B_vec = _vec_scale(cross_12, 1.0 / cross_norm);
        N_vec = vec3_cross(B_vec, T_vec);
        tau = _vec_dot(cross_12, d3) / (cross_norm * cross_norm);
    } else {
        // Collinear (zero curvature): pick arbitrary unit normal perpendicular to T
        let ref_v = [1.0, 0.0, 0.0];
        if num_abs(T_vec[0]) > 0.9 { ref_v = [0.0, 1.0, 0.0]; }
        let perp = vec3_cross(T_vec, ref_v);
        N_vec = _vec_scale(perp, 1.0 / _vec_norm(perp));
        B_vec = vec3_cross(T_vec, N_vec);
    }

    return {
        velocity: d1,
        acceleration: d2,
        jerk: d3,
        speed: speed,
        tangent: T_vec,
        normal: N_vec,
        binormal: B_vec,
        T: T_vec,
        N: N_vec,
        B: B_vec,
        curvature: kappa,
        torsion: tau
    };
}

// Arc length of parametric curve r_fn(t) over [t0, t1] via composite 5-pt Gauss-Legendre quadrature.
fn arc_length_curve(r_fn, t0, t1) {
    if type(r_fn) != "fn" {
        throw "linalg_geometry (arc_length_curve): r_fn must be a function";
    }
    let a = _num(t0);
    let b = _num(t1);
    if num_abs(b - a) < 1e-15 { return 0.0; }
    let sign = 1.0;
    if b < a {
        let tmp = a;
        a = b;
        b = tmp;
        sign = 1.0; // Geometric arc length is non-negative
    }

    let nodes = [
        -0.9061798459386640,
        -0.5384693101056831,
         0.0,
         0.5384693101056831,
         0.9061798459386640
    ];
    let weights = [
        0.2369268850561891,
        0.4786286704993665,
        0.5688888888888889,
        0.4786286704993665,
        0.2369268850561891
    ];

    let n_panels = 32;
    let panel_w = (b - a) / n_panels;
    let h_fd = _max2(1e-3, 1e-4 * _min2(1.0, b - a));
    let total_len = 0.0;

    let p = 0;
    while p < n_panels {
        let pa = a + p * panel_w;
        let mid = pa + 0.5 * panel_w;
        let half = 0.5 * panel_w;
        let panel_sum = 0.0;
        let q = 0;
        while q < 5 {
            let tq = mid + half * nodes[q];
            let rm2 = _check_float_vec(r_fn(tq - 2.0 * h_fd), "arc_length_curve");
            let rm1 = _check_float_vec(r_fn(tq - h_fd), "arc_length_curve");
            let rp1 = _check_float_vec(r_fn(tq + h_fd), "arc_length_curve");
            let rp2 = _check_float_vec(r_fn(tq + 2.0 * h_fd), "arc_length_curve");
            let sq = 0.0;
            let d = 0;
            let den = 12.0 * h_fd;
            while d < len(rm1) {
                let deriv = (rm2[d] - 8.0 * rm1[d] + 8.0 * rp1[d] - rp2[d]) / den;
                sq = sq + deriv * deriv;
                d = d + 1;
            }
            panel_sum = panel_sum + weights[q] * num_sqrt(sq);
            q = q + 1;
        }
        total_len = total_len + half * panel_sum;
        p = p + 1;
    }
    return sign * total_len;
}

fn _surf_du_4th(surf_fn, u0, v0, h) {
    let m2 = _check_float_vec(surf_fn(u0 - 2.0 * h, v0), "surface_curvatures");
    let m1 = _check_float_vec(surf_fn(u0 - h, v0), "surface_curvatures");
    let p1 = _check_float_vec(surf_fn(u0 + h, v0), "surface_curvatures");
    let p2 = _check_float_vec(surf_fn(u0 + 2.0 * h, v0), "surface_curvatures");
    let den = 12.0 * h;
    return [
        (m2[0] - 8.0 * m1[0] + 8.0 * p1[0] - p2[0]) / den,
        (m2[1] - 8.0 * m1[1] + 8.0 * p1[1] - p2[1]) / den,
        (m2[2] - 8.0 * m1[2] + 8.0 * p1[2] - p2[2]) / den
    ];
}

// First & Second Fundamental Forms, Gaussian curvature K, Mean curvature H, principal curvatures k1, k2.
fn surface_curvatures(surf_fn, u, v, h = 1e-5) {
    if type(surf_fn) != "fn" {
        throw "linalg_geometry (surface_curvatures): surf_fn must be a function";
    }
    let u0 = _num(u);
    let v0 = _num(v);
    let h_base = _num(h);
    if h_base <= 0.0 {
        throw "linalg_geometry (surface_curvatures): step h must be positive";
    }

    let h1 = _max2(h_base, 1e-3);
    let h2 = _max2(h_base, 1e-3);

    let r_center = _check_float_vec(surf_fn(u0, v0), "surface_curvatures");
    if len(r_center) != 3 {
        throw "linalg_geometry (surface_curvatures): surf_fn(u, v) must return a 3D vector";
    }

    let ru = _surf_du_4th(surf_fn, u0, v0, h1);
    let vm2 = _check_float_vec(surf_fn(u0, v0 - 2.0 * h1), "surface_curvatures");
    let vm1 = _check_float_vec(surf_fn(u0, v0 - h1), "surface_curvatures");
    let vp1 = _check_float_vec(surf_fn(u0, v0 + h1), "surface_curvatures");
    let vp2 = _check_float_vec(surf_fn(u0, v0 + 2.0 * h1), "surface_curvatures");
    let den1 = 12.0 * h1;
    let rv = [
        (vm2[0] - 8.0 * vm1[0] + 8.0 * vp1[0] - vp2[0]) / den1,
        (vm2[1] - 8.0 * vm1[1] + 8.0 * vp1[1] - vp2[1]) / den1,
        (vm2[2] - 8.0 * vm1[2] + 8.0 * vp1[2] - vp2[2]) / den1
    ];

    let u2_m2 = _check_float_vec(surf_fn(u0 - 2.0 * h2, v0), "surface_curvatures");
    let u2_m1 = _check_float_vec(surf_fn(u0 - h2, v0), "surface_curvatures");
    let u2_p1 = _check_float_vec(surf_fn(u0 + h2, v0), "surface_curvatures");
    let u2_p2 = _check_float_vec(surf_fn(u0 + 2.0 * h2, v0), "surface_curvatures");

    let v2_m2 = _check_float_vec(surf_fn(u0, v0 - 2.0 * h2), "surface_curvatures");
    let v2_m1 = _check_float_vec(surf_fn(u0, v0 - h2), "surface_curvatures");
    let v2_p1 = _check_float_vec(surf_fn(u0, v0 + h2), "surface_curvatures");
    let v2_p2 = _check_float_vec(surf_fn(u0, v0 + 2.0 * h2), "surface_curvatures");

    let den2 = 12.0 * h2 * h2;
    let ruu = [];
    let rvv = [];
    let c = 0;
    while c < 3 {
        array_push(ruu, ((0.0 - u2_m2[c]) + 16.0 * u2_m1[c] - 30.0 * r_center[c] + 16.0 * u2_p1[c] - u2_p2[c]) / den2);
        array_push(rvv, ((0.0 - v2_m2[c]) + 16.0 * v2_m1[c] - 30.0 * r_center[c] + 16.0 * v2_p1[c] - v2_p2[c]) / den2);
        c = c + 1;
    }

    // 4th-order mixed partial r_uv
    let du_vm2 = _surf_du_4th(surf_fn, u0, v0 - 2.0 * h2, h2);
    let du_vm1 = _surf_du_4th(surf_fn, u0, v0 - h2, h2);
    let du_vp1 = _surf_du_4th(surf_fn, u0, v0 + h2, h2);
    let du_vp2 = _surf_du_4th(surf_fn, u0, v0 + 2.0 * h2, h2);
    let den_uv = 12.0 * h2;
    let ruv = [
        (du_vm2[0] - 8.0 * du_vm1[0] + 8.0 * du_vp1[0] - du_vp2[0]) / den_uv,
        (du_vm2[1] - 8.0 * du_vm1[1] + 8.0 * du_vp1[1] - du_vp2[1]) / den_uv,
        (du_vm2[2] - 8.0 * du_vm1[2] + 8.0 * du_vp1[2] - du_vp2[2]) / den_uv
    ];

    let E_val = _vec_dot(ru, ru);
    let F_val = _vec_dot(ru, rv);
    let G_val = _vec_dot(rv, rv);
    let area_det = E_val * G_val - F_val * F_val;
    let n_raw = vec3_cross(ru, rv);
    let n_len = _vec_norm(n_raw);
    if n_len < 1e-14 or area_det <= 1e-28 {
        throw "linalg_geometry (surface_curvatures): degenerate surface parameterization";
    }
    let n_unit = _vec_scale(n_raw, 1.0 / n_len);

    let L_val = _vec_dot(ruu, n_unit);
    let M_val = _vec_dot(ruv, n_unit);
    let N_val = _vec_dot(rvv, n_unit);

    let K_gauss = (L_val * N_val - M_val * M_val) / area_det;
    let H_mean = (E_val * N_val - 2.0 * F_val * M_val + G_val * L_val) / (2.0 * area_det);
    let disc = _max2(0.0, H_mean * H_mean - K_gauss);
    let root_d = num_sqrt(disc);
    let k1 = H_mean + root_d;
    let k2 = H_mean - root_d;

    return {
        first_fundamental: { E: E_val, F: F_val, G: G_val },
        second_fundamental: { L: L_val, M: M_val, N: N_val },
        E: E_val,
        F: F_val,
        G: G_val,
        L: L_val,
        M: M_val,
        N: N_val,
        normal: n_unit,
        gaussian_curvature: K_gauss,
        mean_curvature: H_mean,
        K: K_gauss,
        H: H_mean,
        k1: k1,
        k2: k2,
        principal_curvatures: [k1, k2]
    };
}

// ============================================================================
// 4. Analytic, Projective, Computational & Spherical/WGS-84 Geometry
// ============================================================================

fn _pt2(p, ctx) {
    let v = _check_float_vec(p, ctx);
    if len(v) != 2 {
        throw "linalg_geometry (" + ctx + "): expected 2D point [x, y]";
    }
    return v;
}

fn _pt3(p, ctx) {
    let v = _check_float_vec(p, ctx);
    if len(v) != 3 {
        throw "linalg_geometry (" + ctx + "): expected 3D point [x, y, z]";
    }
    return v;
}

// Distance from 2D point pt to line through (line_p1, line_p2) OR line [a, b, c] (ax + by + c = 0).
fn point_line_distance_2d(pt, line_p1, line_p2 = nil) {
    let p = _pt2(pt, "point_line_distance_2d");
    if line_p2 == nil {
        let abc = _check_float_vec(line_p1, "point_line_distance_2d");
        if len(abc) != 3 {
            throw "linalg_geometry (point_line_distance_2d): expected [a, b, c] line coefficients";
        }
        let den = num_sqrt(abc[0] * abc[0] + abc[1] * abc[1]);
        if den < 1e-15 {
            throw "linalg_geometry (point_line_distance_2d): degenerate line";
        }
        return num_abs(abc[0] * p[0] + abc[1] * p[1] + abc[2]) / den;
    }
    let a = _pt2(line_p1, "point_line_distance_2d");
    let b = _pt2(line_p2, "point_line_distance_2d");
    let dx = b[0] - a[0];
    let dy = b[1] - a[1];
    let den = num_sqrt(dx * dx + dy * dy);
    if den < 1e-15 {
        throw "linalg_geometry (point_line_distance_2d): coincident line points";
    }
    return num_abs(dx * (a[1] - p[1]) - (a[0] - p[0]) * dy) / den;
}

// Distance from 3D point pt to plane (supports [a,b,c,d], or normal [nx,ny,nz] + point [x0,y0,z0] or scalar d).
fn point_plane_distance_3d(pt, plane_normal, plane_point_or_d = 0.0) {
    let p = _pt3(pt, "point_plane_distance_3d");
    let nv = _check_float_vec(plane_normal, "point_plane_distance_3d");
    if len(nv) == 4 {
        let den = num_sqrt(nv[0] * nv[0] + nv[1] * nv[1] + nv[2] * nv[2]);
        if den < 1e-15 {
            throw "linalg_geometry (point_plane_distance_3d): zero plane normal";
        }
        return num_abs(nv[0] * p[0] + nv[1] * p[1] + nv[2] * p[2] + nv[3]) / den;
    }
    if len(nv) != 3 {
        throw "linalg_geometry (point_plane_distance_3d): expected 3D normal or [a,b,c,d]";
    }
    let den = _vec_norm(nv);
    if den < 1e-15 {
        throw "linalg_geometry (point_plane_distance_3d): zero plane normal";
    }
    if type(plane_point_or_d) == "array" {
        let p0 = _pt3(plane_point_or_d, "point_plane_distance_3d");
        let diff = [p[0] - p0[0], p[1] - p0[1], p[2] - p0[2]];
        return num_abs(_vec_dot(nv, diff)) / den;
    }
    let d_coef = _num(plane_point_or_d);
    return num_abs(_vec_dot(nv, p) + d_coef) / den;
}

fn line_line_intersect_2d(p1, p2, p3, p4) {
    let a = _pt2(p1, "line_line_intersect_2d");
    let b = _pt2(p2, "line_line_intersect_2d");
    let c = _pt2(p3, "line_line_intersect_2d");
    let d = _pt2(p4, "line_line_intersect_2d");
    let denom = (a[0] - b[0]) * (c[1] - d[1]) - (a[1] - b[1]) * (c[0] - d[0]);
    if num_abs(denom) <= 1e-12 {
        let dist = point_line_distance_2d(c, a, b);
        if dist <= 1e-11 {
            return { status: "collinear", intersects: false, point: nil };
        }
        return { status: "parallel", intersects: false, point: nil };
    }
    let t = ((a[0] - c[0]) * (c[1] - d[1]) - (a[1] - c[1]) * (c[0] - d[0])) / denom;
    let u = ((a[0] - c[0]) * (a[1] - b[1]) - (a[1] - c[1]) * (a[0] - b[0])) / denom;
    let px = a[0] + t * (b[0] - a[0]);
    let py = a[1] + t * (b[1] - a[1]);
    return {
        status: "intersecting",
        intersects: true,
        point: [px, py],
        t: t,
        u: u
    };
}

fn line_plane_intersect_3d(line_pt, line_dir, plane_pt, plane_normal) {
    let l0 = _pt3(line_pt, "line_plane_intersect_3d");
    let ld = _pt3(line_dir, "line_plane_intersect_3d");
    let p0 = _pt3(plane_pt, "line_plane_intersect_3d");
    let pn = _pt3(plane_normal, "line_plane_intersect_3d");
    let denom = _vec_dot(pn, ld);
    let diff = [p0[0] - l0[0], p0[1] - l0[1], p0[2] - l0[2]];
    let numer = _vec_dot(pn, diff);
    if num_abs(denom) <= 1e-12 {
        if num_abs(numer) <= 1e-11 {
            return { status: "in_plane", intersects: true, point: l0, t: 0.0 };
        }
        return { status: "parallel", intersects: false, point: nil, t: nil };
    }
    let t = numer / denom;
    return {
        status: "intersecting",
        intersects: true,
        point: [l0[0] + t * ld[0], l0[1] + t * ld[1], l0[2] + t * ld[2]],
        t: t
    };
}

fn circle_circle_intersect_2d(c1, r1, c2, r2) {
    let p1 = _pt2(c1, "circle_circle_intersect_2d");
    let p2 = _pt2(c2, "circle_circle_intersect_2d");
    let rad1 = _num(r1);
    let rad2 = _num(r2);
    if rad1 <= 0.0 or rad2 <= 0.0 {
        throw "linalg_geometry (circle_circle_intersect_2d): radii must be positive";
    }
    let dx = p2[0] - p1[0];
    let dy = p2[1] - p1[1];
    let d = num_sqrt(dx * dx + dy * dy);
    if d <= 1e-12 {
        if num_abs(rad1 - rad2) <= 1e-12 {
            return { status: "coincident", count: -1, points: [] };
        }
        return { status: "concentric_disjoint", count: 0, points: [] };
    }
    if d > rad1 + rad2 + 1e-12 or d < num_abs(rad1 - rad2) - 1e-12 {
        return { status: "disjoint", count: 0, points: [] };
    }
    let a = (rad1 * rad1 - rad2 * rad2 + d * d) / (2.0 * d);
    let h_sq = rad1 * rad1 - a * a;
    let mx = p1[0] + (a / d) * dx;
    let my = p1[1] + (a / d) * dy;
    if h_sq <= 1e-22 {
        return { status: "tangent", count: 1, points: [[mx, my]] };
    }
    let h = num_sqrt(h_sq);
    let rx = (0.0 - dy) * (h / d);
    let ry = dx * (h / d);
    return {
        status: "secant",
        count: 2,
        points: [[mx + rx, my + ry], [mx - rx, my - ry]]
    };
}

// Moller-Trumbore 3D ray-triangle intersection.
fn ray_triangle_intersect_3d(ray_origin, ray_dir, v0, v1, v2) {
    let orig = _pt3(ray_origin, "ray_triangle_intersect_3d");
    let dir = _pt3(ray_dir, "ray_triangle_intersect_3d");
    let p0 = _pt3(v0, "ray_triangle_intersect_3d");
    let p1 = _pt3(v1, "ray_triangle_intersect_3d");
    let p2 = _pt3(v2, "ray_triangle_intersect_3d");

    let e1 = [p1[0] - p0[0], p1[1] - p0[1], p1[2] - p0[2]];
    let e2 = [p2[0] - p0[0], p2[1] - p0[1], p2[2] - p0[2]];
    let pvec = vec3_cross(dir, e2);
    let det_val = _vec_dot(e1, pvec);
    if num_abs(det_val) < 1e-12 {
        return { hit: false, reason: "parallel", point: nil, t: nil };
    }
    let inv_det = 1.0 / det_val;
    let tvec = [orig[0] - p0[0], orig[1] - p0[1], orig[2] - p0[2]];
    let u = _vec_dot(tvec, pvec) * inv_det;
    if u < -1e-12 or u > 1.0 + 1e-12 {
        return { hit: false, reason: "outside_u", point: nil, t: nil };
    }
    let qvec = vec3_cross(tvec, e1);
    let v = _vec_dot(dir, qvec) * inv_det;
    if v < -1e-12 or u + v > 1.0 + 1e-12 {
        return { hit: false, reason: "outside_v", point: nil, t: nil };
    }
    let t = _vec_dot(e2, qvec) * inv_det;
    if t < 1e-12 {
        return { hit: false, reason: "behind_ray", point: nil, t: t };
    }
    let w = 1.0 - u - v;
    let hit_pt = [
        orig[0] + t * dir[0],
        orig[1] + t * dir[1],
        orig[2] + t * dir[2]
    ];
    return {
        hit: true,
        t: t,
        u: u,
        v: v,
        w: w,
        barycentric: [w, u, v],
        point: hit_pt
    };
}

fn barycentric_coords_2d(pt, a, b, c) {
    let p = _pt2(pt, "barycentric_coords_2d");
    let v0 = _pt2(a, "barycentric_coords_2d");
    let v1 = _pt2(b, "barycentric_coords_2d");
    let v2 = _pt2(c, "barycentric_coords_2d");
    let den = (v1[1] - v2[1]) * (v0[0] - v2[0]) + (v2[0] - v1[0]) * (v0[1] - v2[1]);
    if num_abs(den) < 1e-15 {
        throw "linalg_geometry (barycentric_coords_2d): degenerate collinear triangle";
    }
    let u = ((v1[1] - v2[1]) * (p[0] - v2[0]) + (v2[0] - v1[0]) * (p[1] - v2[1])) / den;
    let v = ((v2[1] - v0[1]) * (p[0] - v2[0]) + (v0[0] - v2[0]) * (p[1] - v2[1])) / den;
    let w = 1.0 - u - v;
    let inside = (u >= -1e-12 and v >= -1e-12 and w >= -1e-12);
    return {
        coords: [u, v, w],
        u: u,
        v: v,
        w: w,
        inside: inside
    };
}

// 4x4 homogeneous transform matrix builder (translation, scale, axis-angle rotation, perspective).
fn transform_matrix_4x4(spec) {
    if type(spec) != "map" {
        throw "linalg_geometry (transform_matrix_4x4): expected specification map";
    }
    if map_has(spec, "kind") and spec.kind == "perspective" {
        let fovy = _num(spec.fov_y_rad);
        let aspect = _num(spec.aspect);
        let z_near = _num(spec.near);
        let z_far = _num(spec.far);
        if fovy <= 0.0 or aspect <= 0.0 or z_near <= 0.0 or z_far <= z_near {
            throw "linalg_geometry (transform_matrix_4x4): invalid perspective frustum parameters";
        }
        let f = 1.0 / num_tan(0.5 * fovy);
        let nf = 1.0 / (z_near - z_far);
        let P = mat_zeros(4, 4);
        P[0][0] = f / aspect;
        P[1][1] = f;
        P[2][2] = (z_far + z_near) * nf;
        P[2][3] = (2.0 * z_far * z_near) * nf;
        P[3][2] = -1.0;
        return P;
    }

    let M = mat_eye(4);
    if map_has(spec, "scale") {
        let sv = _pt3(spec.scale, "transform_matrix_4x4");
        let S = mat_eye(4);
        S[0][0] = sv[0];
        S[1][1] = sv[1];
        S[2][2] = sv[2];
        M = mat_mul(S, M);
    }
    if map_has(spec, "axis") and map_has(spec, "angle_rad") {
        let ax_raw = _pt3(spec.axis, "transform_matrix_4x4");
        let ax_n = _vec_norm(ax_raw);
        if ax_n < 1e-15 {
            throw "linalg_geometry (transform_matrix_4x4): zero rotation axis";
        }
        let ux = ax_raw[0] / ax_n;
        let uy = ax_raw[1] / ax_n;
        let uz = ax_raw[2] / ax_n;
        let th = _num(spec.angle_rad);
        let c = num_cos(th);
        let s = num_sin(th);
        let omc = 1.0 - c;
        let R = mat_eye(4);
        R[0][0] = c + ux * ux * omc;
        R[0][1] = ux * uy * omc - uz * s;
        R[0][2] = ux * uz * omc + uy * s;
        R[1][0] = uy * ux * omc + uz * s;
        R[1][1] = c + uy * uy * omc;
        R[1][2] = uy * uz * omc - ux * s;
        R[2][0] = uz * ux * omc - uy * s;
        R[2][1] = uz * uy * omc + ux * s;
        R[2][2] = c + uz * uz * omc;
        M = mat_mul(R, M);
    }
    if map_has(spec, "translate") {
        let tv = _pt3(spec.translate, "transform_matrix_4x4");
        let T = mat_eye(4);
        T[0][3] = tv[0];
        T[1][3] = tv[1];
        T[2][3] = tv[2];
        M = mat_mul(T, M);
    }
    return M;
}

fn transform_point_3d(M4, pt3) {
    let M = _check_float_mat(M4, "transform_point_3d");
    if len(M) != 4 or len(M[0]) != 4 {
        throw "linalg_geometry (transform_point_3d): expected 4x4 matrix";
    }
    let p = _pt3(pt3, "transform_point_3d");
    let v4 = mat_vec_mul(M, [p[0], p[1], p[2], 1.0]);
    if num_abs(v4[3]) < 1e-15 {
        return [v4[0], v4[1], v4[2]];
    }
    return [v4[0] / v4[3], v4[1] / v4[3], v4[2] / v4[3]];
}

// General Conic Classifier: A x^2 + B x y + C y^2 + D x + E_coef y + F = 0.
fn classify_conic(A, B, C, D, E_coef, F) {
    let a = _num(A);
    let b = _num(B);
    let c = _num(C);
    let d = _num(D);
    let e = _num(E_coef);
    let f = _num(F);

    if num_abs(a) < 1e-14 and num_abs(b) < 1e-14 and num_abs(c) < 1e-14 {
        throw "linalg_geometry (classify_conic): quadratic coefficients A, B, C cannot all be zero";
    }

    let M3 = [
        [a, 0.5 * b, 0.5 * d],
        [0.5 * b, c, 0.5 * e],
        [0.5 * d, 0.5 * e, f]
    ];
    let delta3 = det(M3);
    let disc = b * b - 4.0 * a * c;

    let theta = 0.0;
    if num_abs(b) > 1e-14 {
        theta = 0.5 * num_atan2(b, a - c);
    }
    let ct = num_cos(theta);
    let st = num_sin(theta);
    let a_rot = a * ct * ct + b * st * ct + c * st * st;
    let c_rot = a * st * st - b * st * ct + c * ct * ct;

    let tol = 1e-11;

    // Case 1: Elliptic family (B^2 - 4AC < 0)
    if disc < 0.0 - tol {
        let den_c = 4.0 * a * c - b * b;
        let x0 = (b * e - 2.0 * c * d) / den_c;
        let y0 = (b * d - 2.0 * a * e) / den_c;
        let f_cent = a * x0 * x0 + b * x0 * y0 + c * y0 * y0 + d * x0 + e * y0 + f;

        if num_abs(f_cent) <= tol or num_abs(delta3) <= tol {
            return {
                kind: "point",
                delta_3: delta3,
                discriminant: disc,
                center: [x0, y0],
                rotation_rad: theta,
                semi_axes: [0.0, 0.0],
                eccentricity: 0.0
            };
        }
        let rhs = 0.0 - f_cent;
        let s1_sq = rhs / a_rot;
        let s2_sq = rhs / c_rot;
        if s1_sq < 0.0 or s2_sq < 0.0 {
            return {
                kind: "empty",
                delta_3: delta3,
                discriminant: disc,
                center: [x0, y0],
                rotation_rad: theta,
                semi_axes: nil,
                eccentricity: nil
            };
        }
        let s1 = num_sqrt(s1_sq);
        let s2 = num_sqrt(s2_sq);
        let semi_a = _max2(s1, s2);
        let semi_b = _min2(s1, s2);
        if num_abs(semi_a - semi_b) <= 1e-11 * _max2(1.0, semi_a) {
            return {
                kind: "circle",
                delta_3: delta3,
                discriminant: disc,
                center: [x0, y0],
                rotation_rad: 0.0,
                semi_axes: [semi_a, semi_a],
                eccentricity: 0.0
            };
        }
        let ecc = num_sqrt(_max2(0.0, 1.0 - (semi_b * semi_b) / (semi_a * semi_a)));
        return {
            kind: "ellipse",
            delta_3: delta3,
            discriminant: disc,
            center: [x0, y0],
            rotation_rad: theta,
            semi_axes: [semi_a, semi_b],
            eccentricity: ecc
        };
    }

    // Case 2: Hyperbolic family (B^2 - 4AC > 0)
    if disc > tol {
        let den_c = 4.0 * a * c - b * b;
        let x0 = (b * e - 2.0 * c * d) / den_c;
        let y0 = (b * d - 2.0 * a * e) / den_c;
        let f_cent = a * x0 * x0 + b * x0 * y0 + c * y0 * y0 + d * x0 + e * y0 + f;

        if num_abs(f_cent) <= tol or num_abs(delta3) <= tol {
            return {
                kind: "intersecting_lines",
                delta_3: delta3,
                discriminant: disc,
                center: [x0, y0],
                rotation_rad: theta,
                semi_axes: nil,
                eccentricity: nil
            };
        }
        let rhs = 0.0 - f_cent;
        let q1 = rhs / a_rot;
        let q2 = rhs / c_rot;
        let a_sq = q1;
        let b_sq = 0.0 - q2;
        if q2 > 0.0 {
            a_sq = q2;
            b_sq = 0.0 - q1;
        }
        let semi_a = num_sqrt(num_abs(a_sq));
        let semi_b = num_sqrt(num_abs(b_sq));
        let ecc = num_sqrt(1.0 + (semi_b * semi_b) / (semi_a * semi_a));
        return {
            kind: "hyperbola",
            delta_3: delta3,
            discriminant: disc,
            center: [x0, y0],
            rotation_rad: theta,
            semi_axes: [semi_a, semi_b],
            eccentricity: ecc
        };
    }

    // Case 3: Parabolic family (B^2 - 4AC == 0)
    if num_abs(delta3) > tol {
        return {
            kind: "parabola",
            delta_3: delta3,
            discriminant: disc,
            center: nil,
            rotation_rad: theta,
            semi_axes: nil,
            eccentricity: 1.0
        };
    }

    // Degenerate parabolic: rotate to eliminate xy and check univariate quadratic discriminant
    let d_rot = d * ct + e * st;
    let e_rot = (0.0 - d) * st + e * ct;
    let disc1 = 0.0;
    if num_abs(a_rot) >= num_abs(c_rot) {
        disc1 = d_rot * d_rot - 4.0 * a_rot * f;
    } else {
        disc1 = e_rot * e_rot - 4.0 * c_rot * f;
    }
    if disc1 < 0.0 - tol {
        return {
            kind: "empty",
            delta_3: delta3,
            discriminant: disc,
            center: nil,
            rotation_rad: theta,
            semi_axes: nil,
            eccentricity: nil
        };
    }
    return {
        kind: "parallel_lines",
        delta_3: delta3,
        discriminant: disc,
        center: nil,
        rotation_rad: theta,
        semi_axes: nil,
        eccentricity: nil
    };
}

// ── Computational Geometry ───────────────────────────────────────────────────

fn _orient2d(o, a, b) {
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
}

fn _merge_sort_pts_xy(pts) {
    let n = len(pts);
    if n <= 1 { return pts; }
    let mid = num_floor(n / 2);
    let left = [];
    let right = [];
    let i = 0;
    while i < mid { array_push(left, pts[i]); i = i + 1; }
    while i < n   { array_push(right, pts[i]); i = i + 1; }
    let sl = _merge_sort_pts_xy(left);
    let sr = _merge_sort_pts_xy(right);
    let out = [];
    let p = 0;
    let q = 0;
    while p < len(sl) and q < len(sr) {
        let lp = sl[p];
        let rp = sr[q];
        if lp[0] < rp[0] or (lp[0] == rp[0] and lp[1] <= rp[1]) {
            array_push(out, lp);
            p = p + 1;
        } else {
            array_push(out, rp);
            q = q + 1;
        }
    }
    while p < len(sl) { array_push(out, sl[p]); p = p + 1; }
    while q < len(sr) { array_push(out, sr[q]); q = q + 1; }
    return out;
}

// Andrew's Monotone Chain O(n log n) 2D Convex Hull (CCW vertices).
fn convex_hull_2d(points) {
    if type(points) != "array" or len(points) == 0 {
        throw "linalg_geometry (convex_hull_2d): expected non-empty array of 2D points";
    }
    let raw = [];
    let i = 0;
    while i < len(points) {
        array_push(raw, _pt2(points[i], "convex_hull_2d"));
        i = i + 1;
    }
    let sorted = _merge_sort_pts_xy(raw);
    let uniq = [sorted[0]];
    let k = 1;
    while k < len(sorted) {
        let prev = uniq[len(uniq) - 1];
        let cur = sorted[k];
        if num_abs(cur[0] - prev[0]) > 1e-13 or num_abs(cur[1] - prev[1]) > 1e-13 {
            array_push(uniq, cur);
        }
        k = k + 1;
    }
    let n = len(uniq);
    if n <= 2 { return uniq; }

    let lower = [];
    let idx = 0;
    while idx < n {
        let pt = uniq[idx];
        while len(lower) >= 2 and _orient2d(lower[len(lower) - 2], lower[len(lower) - 1], pt) <= 1e-13 {
            pop(lower);
        }
        array_push(lower, pt);
        idx = idx + 1;
    }

    let upper = [];
    let idx2 = n - 1;
    while idx2 >= 0 {
        let pt = uniq[idx2];
        while len(upper) >= 2 and _orient2d(upper[len(upper) - 2], upper[len(upper) - 1], pt) <= 1e-13 {
            pop(upper);
        }
        array_push(upper, pt);
        idx2 = idx2 - 1;
    }

    pop(lower);
    pop(upper);
    let hull = [];
    let h1 = 0;
    while h1 < len(lower) { array_push(hull, lower[h1]); h1 = h1 + 1; }
    let h2 = 0;
    while h2 < len(upper) { array_push(hull, upper[h2]); h2 = h2 + 1; }
    return hull;
}

// Shoelace area, perimeter, centroid, and convexity test for 2D polygon.
fn polygon_metrics_2d(poly) {
    if type(poly) != "array" or len(poly) < 3 {
        throw "linalg_geometry (polygon_metrics_2d): polygon requires at least 3 vertices";
    }
    let n = len(poly);
    let pts = [];
    let i = 0;
    while i < n {
        array_push(pts, _pt2(poly[i], "polygon_metrics_2d"));
        i = i + 1;
    }

    let twice_area = 0.0;
    let perim = 0.0;
    let cx_acc = 0.0;
    let cy_acc = 0.0;
    let pos_turns = 0;
    let neg_turns = 0;

    let k = 0;
    while k < n {
        let p0 = pts[k];
        let p1 = pts[num_mod(k + 1, n)];
        let p2 = pts[num_mod(k + 2, n)];
        let cross_z = p0[0] * p1[1] - p1[0] * p0[1];
        twice_area = twice_area + cross_z;
        cx_acc = cx_acc + (p0[0] + p1[0]) * cross_z;
        cy_acc = cy_acc + (p0[1] + p1[1]) * cross_z;

        let dx = p1[0] - p0[0];
        let dy = p1[1] - p0[1];
        perim = perim + num_sqrt(dx * dx + dy * dy);

        let turn = _orient2d(p0, p1, p2);
        if turn > 1e-12 { pos_turns = pos_turns + 1; }
        if turn < -1e-12 { neg_turns = neg_turns + 1; }
        k = k + 1;
    }

    let signed_area = 0.5 * twice_area;
    let area = num_abs(signed_area);
    let centroid = [0.0, 0.0];
    if area > 1e-14 {
        centroid = [cx_acc / (6.0 * signed_area), cy_acc / (6.0 * signed_area)];
    } else {
        let sx = 0.0;
        let sy = 0.0;
        let m = 0;
        while m < n {
            sx = sx + pts[m][0];
            sy = sy + pts[m][1];
            m = m + 1;
        }
        centroid = [sx / n, sy / n];
    }

    let is_convex = not (pos_turns > 0 and neg_turns > 0);
    return {
        area: area,
        signed_area: signed_area,
        perimeter: perim,
        centroid: centroid,
        is_convex: is_convex
    };
}

fn _point_on_segment_2d(p, a, b) {
    let cross_v = _orient2d(a, b, p);
    if num_abs(cross_v) > 1e-11 { return false; }
    let min_x = _min2(a[0], b[0]) - 1e-12;
    let max_x = _max2(a[0], b[0]) + 1e-12;
    let min_y = _min2(a[1], b[1]) - 1e-12;
    let max_y = _max2(a[1], b[1]) + 1e-12;
    return p[0] >= min_x and p[0] <= max_x and p[1] >= min_y and p[1] <= max_y;
}

// Sunday's exact 2D Winding Number algorithm.
fn winding_number_2d(pt, poly) {
    let p = _pt2(pt, "winding_number_2d");
    if type(poly) != "array" or len(poly) < 3 {
        throw "linalg_geometry (winding_number_2d): polygon requires >= 3 vertices";
    }
    let n = len(poly);
    let wn = 0;
    let i = 0;
    while i < n {
        let a = _pt2(poly[i], "winding_number_2d");
        let b = _pt2(poly[num_mod(i + 1, n)], "winding_number_2d");
        if _point_on_segment_2d(p, a, b) {
            return 1;
        }
        if a[1] <= p[1] {
            if b[1] > p[1] and _orient2d(a, b, p) > 0.0 {
                wn = wn + 1;
            }
        } else {
            if b[1] <= p[1] and _orient2d(a, b, p) < 0.0 {
                wn = wn - 1;
            }
        }
        i = i + 1;
    }
    return wn;
}

fn point_in_polygon_2d(pt, poly) {
    return winding_number_2d(pt, poly) != 0;
}

fn segments_intersect_2d(p1, p2, q1, q2) {
    let a = _pt2(p1, "segments_intersect_2d");
    let b = _pt2(p2, "segments_intersect_2d");
    let c = _pt2(q1, "segments_intersect_2d");
    let d = _pt2(q2, "segments_intersect_2d");

    let o1 = _orient2d(a, b, c);
    let o2 = _orient2d(a, b, d);
    let o3 = _orient2d(c, d, a);
    let o4 = _orient2d(c, d, b);

    if ((o1 > 1e-12 and o2 < -1e-12) or (o1 < -1e-12 and o2 > 1e-12)) and
       ((o3 > 1e-12 and o4 < -1e-12) or (o3 < -1e-12 and o4 > 1e-12)) {
        return true;
    }
    if _point_on_segment_2d(c, a, b) { return true; }
    if _point_on_segment_2d(d, a, b) { return true; }
    if _point_on_segment_2d(a, c, d) { return true; }
    if _point_on_segment_2d(b, c, d) { return true; }
    return false;
}

fn _dist2d(a, b) {
    let dx = a[0] - b[0];
    let dy = a[1] - b[1];
    return num_sqrt(dx * dx + dy * dy);
}

fn _merge_sort_pts_y(pts) {
    let n = len(pts);
    if n <= 1 { return pts; }
    let mid = num_floor(n / 2);
    let left = [];
    let right = [];
    let i = 0;
    while i < mid { array_push(left, pts[i]); i = i + 1; }
    while i < n   { array_push(right, pts[i]); i = i + 1; }
    let sl = _merge_sort_pts_y(left);
    let sr = _merge_sort_pts_y(right);
    let out = [];
    let p = 0;
    let q = 0;
    while p < len(sl) and q < len(sr) {
        if sl[p][1] <= sr[q][1] {
            array_push(out, sl[p]);
            p = p + 1;
        } else {
            array_push(out, sr[q]);
            q = q + 1;
        }
    }
    while p < len(sl) { array_push(out, sl[p]); p = p + 1; }
    while q < len(sr) { array_push(out, sr[q]); q = q + 1; }
    return out;
}

fn _closest_pair_rec(px, lo, hi) {
    let count = hi - lo;
    if count <= 3 {
        let best_d = 1e308;
        let bp1 = px[lo];
        let bp2 = px[lo + 1];
        let i = lo;
        while i < hi {
            let j = i + 1;
            while j < hi {
                let d = _dist2d(px[i], px[j]);
                if d < best_d {
                    best_d = d;
                    bp1 = px[i];
                    bp2 = px[j];
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return { distance: best_d, p1: bp1, p2: bp2, pair: [bp1, bp2] };
    }
    let mid = lo + num_floor(count / 2);
    let mid_x = px[mid][0];
    let left_res = _closest_pair_rec(px, lo, mid);
    let right_res = _closest_pair_rec(px, mid, hi);
    let best = left_res;
    if right_res.distance < best.distance {
        best = right_res;
    }

    let strip_raw = [];
    let idx = lo;
    while idx < hi {
        if num_abs(px[idx][0] - mid_x) < best.distance {
            array_push(strip_raw, px[idx]);
        }
        idx = idx + 1;
    }
    let strip = _merge_sort_pts_y(strip_raw);
    let si = 0;
    while si < len(strip) {
        let sj = si + 1;
        while sj < len(strip) and (strip[sj][1] - strip[si][1]) < best.distance {
            let d = _dist2d(strip[si], strip[sj]);
            if d < best.distance {
                best = { distance: d, p1: strip[si], p2: strip[sj], pair: [strip[si], strip[sj]] };
            }
            sj = sj + 1;
        }
        si = si + 1;
    }
    return best;
}

// Divide-and-Conquer O(n log n) closest pair of 2D points.
fn closest_pair_2d(points) {
    if type(points) != "array" or len(points) < 2 {
        throw "linalg_geometry (closest_pair_2d): requires at least 2 points";
    }
    let pts = [];
    let i = 0;
    while i < len(points) {
        array_push(pts, _pt2(points[i], "closest_pair_2d"));
        i = i + 1;
    }
    let px = _merge_sort_pts_xy(pts);
    return _closest_pair_rec(px, 0, len(px));
}

fn _make_delaunay_tri(all_pts, i, j, k) {
    let a = all_pts[i];
    let b = all_pts[j];
    let c = all_pts[k];
    let orient = _orient2d(a, b, c);
    let ii = i;
    let jj = j;
    let kk = k;
    if orient < 0.0 {
        jj = k;
        kk = j;
        b = all_pts[jj];
        c = all_pts[kk];
        orient = 0.0 - orient;
    }
    if orient <= 1e-13 {
        return nil;
    }
    let ax = a[0]; let ay = a[1];
    let bx = b[0]; let by = b[1];
    let cx = c[0]; let cy = c[1];
    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
    let a2 = ax * ax + ay * ay;
    let b2 = bx * bx + by * by;
    let c2 = cx * cx + cy * cy;
    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;
    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;
    let dx = ax - ux;
    let dy = ay - uy;
    return {
        i: ii,
        j: jj,
        k: kk,
        cx: ux,
        cy: uy,
        r2: dx * dx + dy * dy
    };
}

// Bowyer-Watson 2D Delaunay Triangulation satisfying empty-circumcircle property.
fn delaunay_triangulation_2d(points) {
    if type(points) != "array" or len(points) < 3 {
        throw "linalg_geometry (delaunay_triangulation_2d): requires at least 3 points";
    }
    let n = len(points);
    let max_d = GOV.current_limits()["max_matrix_dim"];
    if n > max_d {
        throw "MathGovernor[linalg_geometry:delaunay_triangulation_2d]: point count exceeds adaptive max_matrix_dim=" + str(max_d);
    }
    let all_pts = [];
    let min_x = 1e308; let max_x = -1e308;
    let min_y = 1e308; let max_y = -1e308;
    let idx = 0;
    while idx < n {
        let p = _pt2(points[idx], "delaunay_triangulation_2d");
        if p[0] < min_x { min_x = p[0]; }
        if p[0] > max_x { max_x = p[0]; }
        if p[1] < min_y { min_y = p[1]; }
        if p[1] > max_y { max_y = p[1]; }
        array_push(all_pts, p);
        idx = idx + 1;
    }

    let dmax = _max2(max_x - min_x, _max2(max_y - min_y, 1.0));
    let mid_x = 0.5 * (min_x + max_x);
    let mid_y = 0.5 * (min_y + max_y);

    // Enclosing super-triangle vertices at indices n, n+1, n+2
    array_push(all_pts, [mid_x - 20.0 * dmax, mid_y - 10.0 * dmax]);
    array_push(all_pts, [mid_x + 20.0 * dmax, mid_y - 10.0 * dmax]);
    array_push(all_pts, [mid_x, mid_y + 25.0 * dmax]);

    let tris = [];
    let super_tri = _make_delaunay_tri(all_pts, n, n + 1, n + 2);
    array_push(tris, super_tri);

    let p_idx = 0;
    while p_idx < n {
        let pt = all_pts[p_idx];
        let bad_tris = [];
        let good_tris = [];
        let ti = 0;
        while ti < len(tris) {
            let tr = tris[ti];
            let dx = pt[0] - tr.cx;
            let dy = pt[1] - tr.cy;
            let dist_sq = dx * dx + dy * dy;
            if dist_sq < tr.r2 * (1.0 - 1e-12) {
                array_push(bad_tris, tr);
            } else {
                array_push(good_tris, tr);
            }
            ti = ti + 1;
        }

        // Collect boundary edges of polygonal cavity (edges appearing exactly once among bad_tris)
        let raw_edges = [];
        let bi = 0;
        while bi < len(bad_tris) {
            let bt = bad_tris[bi];
            array_push(raw_edges, [bt.i, bt.j]);
            array_push(raw_edges, [bt.j, bt.k]);
            array_push(raw_edges, [bt.k, bt.i]);
            bi = bi + 1;
        }

        let boundary = [];
        let e1 = 0;
        while e1 < len(raw_edges) {
            let u = raw_edges[e1][0];
            let v = raw_edges[e1][1];
            let shared = false;
            let e2 = 0;
            while e2 < len(raw_edges) {
                if e1 != e2 {
                    let u2 = raw_edges[e2][0];
                    let v2 = raw_edges[e2][1];
                    if (u == u2 and v == v2) or (u == v2 and v == u2) {
                        shared = true;
                        e2 = len(raw_edges);
                    }
                }
                e2 = e2 + 1;
            }
            if not shared {
                array_push(boundary, [u, v]);
            }
            e1 = e1 + 1;
        }

        let b_idx = 0;
        while b_idx < len(boundary) {
            let edge = boundary[b_idx];
            let new_t = _make_delaunay_tri(all_pts, edge[0], edge[1], p_idx);
            if new_t != nil {
                array_push(good_tris, new_t);
            }
            b_idx = b_idx + 1;
        }
        tris = good_tris;
        p_idx = p_idx + 1;
    }

    let out_indices = [];
    let out_coords = [];
    let out_circles = [];
    let fi = 0;
    while fi < len(tris) {
        let tr = tris[fi];
        if tr.i < n and tr.j < n and tr.k < n {
            array_push(out_indices, [tr.i, tr.j, tr.k]);
            array_push(out_coords, [all_pts[tr.i], all_pts[tr.j], all_pts[tr.k]]);
            array_push(out_circles, {
                center: [tr.cx, tr.cy],
                radius: num_sqrt(tr.r2)
            });
        }
        fi = fi + 1;
    }
    return {
        triangles: out_indices,
        triangle_coords: out_coords,
        circumcircles: out_circles
    };
}

// ── Spherical & WGS-84 Ellipsoid Geodesic Geometry ───────────────────────────

let _WGS84_A = 6378137.0;
let _WGS84_F = 1.0 / 298.257223563;
let _WGS84_B = 6356752.314245179497563967;
let _EARTH_MEAN_R = 6371008.7714;

fn _deg_to_rad(d) { return (_num(d) * PI) / 180.0; }
fn _rad_to_deg(r) { return (r * 180.0) / PI; }

fn _wrap_360(deg) {
    let m = num_mod(deg, 360.0);
    if m < 0.0 { m = m + 360.0; }
    return m;
}

fn _wrap_pi(rad) {
    let r = num_mod(rad + PI, TAU);
    if r < 0.0 { r = r + TAU; }
    return r - PI;
}

// Spherical Haversine distance in meters.
fn haversine_distance_m(lat1, lon1, lat2, lon2) {
    let phi1 = _deg_to_rad(lat1);
    let phi2 = _deg_to_rad(lat2);
    let dphi = phi2 - phi1;
    let dlam = _deg_to_rad(_num(lon2) - _num(lon1));
    let sp = num_sin(0.5 * dphi);
    let sl = num_sin(0.5 * dlam);
    let h = sp * sp + num_cos(phi1) * num_cos(phi2) * sl * sl;
    if h > 1.0 { h = 1.0; }
    if h < 0.0 { h = 0.0; }
    let c = 2.0 * num_atan2(num_sqrt(h), num_sqrt(1.0 - h));
    return _EARTH_MEAN_R * c;
}

// Sub-millimeter WGS-84 oblate ellipsoid geodesic solver (Vincenty 1975 inverse formula).
fn vincenty_wgs84(lat1, lon1, lat2, lon2) {
    let phi1 = _deg_to_rad(lat1);
    let phi2 = _deg_to_rad(lat2);
    let L = _wrap_pi(_deg_to_rad(_num(lon2) - _num(lon1)));

    if num_abs(phi1 - phi2) < 1e-14 and num_abs(L) < 1e-14 {
        return {
            distance_m: 0.0,
            initial_bearing_deg: 0.0,
            final_bearing_deg: 0.0,
            iterations: 0
        };
    }

    let a = _WGS84_A;
    let f = _WGS84_F;
    let b = _WGS84_B;

    let U1 = num_atan2((1.0 - f) * num_sin(phi1), num_cos(phi1));
    let U2 = num_atan2((1.0 - f) * num_sin(phi2), num_cos(phi2));
    let sinU1 = num_sin(U1); let cosU1 = num_cos(U1);
    let sinU2 = num_sin(U2); let cosU2 = num_cos(U2);

    let lam = L;
    let iter = 0;
    let converged = false;
    let sinSigma = 0.0;
    let cosSigma = 0.0;
    let sigma = 0.0;
    let cosSqAlpha = 0.0;
    let cos2SigmaM = 0.0;
    let sinLam = 0.0;
    let cosLam = 0.0;

    while iter < 300 and not converged {
        sinLam = num_sin(lam);
        cosLam = num_cos(lam);
        let t1 = cosU2 * sinLam;
        let t2 = cosU1 * sinU2 - sinU1 * cosU2 * cosLam;
        sinSigma = num_sqrt(t1 * t1 + t2 * t2);
        if sinSigma == 0.0 {
            return {
                distance_m: 0.0,
                initial_bearing_deg: 0.0,
                final_bearing_deg: 0.0,
                iterations: iter
            };
        }
        cosSigma = sinU1 * sinU2 + cosU1 * cosU2 * cosLam;
        sigma = num_atan2(sinSigma, cosSigma);
        let sinAlpha = (cosU1 * cosU2 * sinLam) / sinSigma;
        cosSqAlpha = 1.0 - sinAlpha * sinAlpha;
        if cosSqAlpha > 1e-15 {
            cos2SigmaM = cosSigma - (2.0 * sinU1 * sinU2) / cosSqAlpha;
        } else {
            cos2SigmaM = 0.0;
        }
        let C = (f / 16.0) * cosSqAlpha * (4.0 + f * (4.0 - 3.0 * cosSqAlpha));
        let lam_prev = lam;
        lam = L + (1.0 - C) * f * sinAlpha * (
            sigma + C * sinSigma * (
                cos2SigmaM + C * cosSigma * (-1.0 + 2.0 * cos2SigmaM * cos2SigmaM)
            )
        );
        iter = iter + 1;
        if num_abs(lam - lam_prev) <= 1e-13 {
            converged = true;
        }
    }

    let uSq = cosSqAlpha * ((a * a - b * b) / (b * b));
    let A_v = 1.0 + (uSq / 16384.0) * (4096.0 + uSq * (-768.0 + uSq * (320.0 - 175.0 * uSq)));
    let B_v = (uSq / 1024.0) * (256.0 + uSq * (-128.0 + uSq * (74.0 - 47.0 * uSq)));
    let c2sm_sq = cos2SigmaM * cos2SigmaM;
    let deltaSigma = B_v * sinSigma * (
        cos2SigmaM + (B_v / 4.0) * (
            cosSigma * (-1.0 + 2.0 * c2sm_sq) -
            (B_v / 6.0) * cos2SigmaM * (-3.0 + 4.0 * sinSigma * sinSigma) * (-3.0 + 4.0 * c2sm_sq)
        )
    );

    let dist_m = b * A_v * (sigma - deltaSigma);
    let alpha1 = num_atan2(cosU2 * sinLam, cosU1 * sinU2 - sinU1 * cosU2 * cosLam);
    let alpha2 = num_atan2(cosU1 * sinLam, (0.0 - sinU1) * cosU2 + cosU1 * sinU2 * cosLam);

    return {
        distance_m: dist_m,
        initial_bearing_deg: _wrap_360(_rad_to_deg(alpha1)),
        final_bearing_deg: _wrap_360(_rad_to_deg(alpha2)),
        iterations: iter,
        converged: converged
    };
}

// Exact WGS-84 authalic latitude potential q_tilde(phi) such that a^2 d(q_tilde) d(lambda) = M(phi) N(phi) cos(phi) d(phi) d(lambda).
fn _wgs84_authalic_q(phi) {
    let f = _WGS84_F;
    let e2 = f * (2.0 - f);
    let e = num_sqrt(e2);
    let s = num_sin(phi);
    let es = e * s;
    let term1 = s / (1.0 - e2 * s * s);
    let term2 = num_ln((1.0 + es) / (1.0 - es)) / (2.0 * e);
    return 0.5 * (1.0 - e2) * (term1 + term2);
}

// WGS-84 Ellipsoidal Geodesic Polygon Area in m^2 (accurate from sub-m^2 land parcels / KAEK to continents).
fn geodesic_polygon_area_m2(lat_lon_points) {
    if type(lat_lon_points) != "array" or len(lat_lon_points) < 3 {
        throw "linalg_geometry (geodesic_polygon_area_m2): polygon requires at least 3 [lat, lon] vertices";
    }
    let n = len(lat_lon_points);
    let phis = [];
    let lams = [];
    let qs = [];
    let i = 0;
    while i < n {
        let pt = _pt2(lat_lon_points[i], "geodesic_polygon_area_m2");
        let phi = _deg_to_rad(pt[0]);
        let lam = _deg_to_rad(pt[1]);
        array_push(phis, phi);
        array_push(lams, lam);
        array_push(qs, _wgs84_authalic_q(phi));
        i = i + 1;
    }

    // Subtract reference q0 = qs[0] to prevent catastrophic cancellation on small land parcels!
    let q0 = qs[0];
    let integral = 0.0;
    let k = 0;
    while k < n {
        let nxt = num_mod(k + 1, n);
        let dlam = _wrap_pi(lams[nxt] - lams[k]);
        let avg_dq = 0.5 * ((qs[k] - q0) + (qs[nxt] - q0));
        integral = integral + dlam * avg_dq;
        k = k + 1;
    }
    return _WGS84_A * _WGS84_A * num_abs(integral);
}

