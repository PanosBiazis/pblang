export class_index_of, get_canonical_allographs, strokes_to_bitmap, synthesize_handwritten_glyph;
export encode_bmp24, decode_bmp24;
export preprocess_math_bitmap, deskew_glyph_bitmap, count_glyph_holes, extract_glyph_features;
export reload_ocr_weights, classify_glyph_features, classify_glyph_bitmap;
export segment_math_components, recognize_handwritten_bitmap, recognize_handwritten_strokes;
export solve_handwritten_math, render_handwritten_expression_bitmap;
export create_ink_canvas, canvas_add_stroke, canvas_clear, canvas_to_bitmap, canvas_recognize_and_solve;
