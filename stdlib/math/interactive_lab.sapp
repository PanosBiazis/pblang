// stdlib/math/interactive_lab.sapp
// Pure PBLang (v2.7.0) Stateful Interactive Custom Function Lab, Autonomous
// Real-Time Parameter Sliders, and Statistical & Unit-Scale Invariance Explorers.
//
// Zero HTML/JS dependencies, zero external tools, zero network/FS telemetry.
// Integrates with symbolic_cas.sapp, calculus_ode.sapp, and resource_governor.sapp.

let CAS = import("stdlib:math/symbolic_cas.sapp");
let CALC = import("stdlib:math/calculus_ode.sapp");
let GOV = import("stdlib:math/resource_governor.sapp");

let LAB_VERSION = "2.7.0";
let _PI = 3.14159265358979323846;
let _SQRT_2PI = 2.50662827463100050242;
let _SPARK_BLOCKS = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"];

let _NEXT_LAB_ID = 0;
let _ACTIVE_LAB_ID = -1;
let _ACTIVE_LAB_REV = -1;

// ── Numeric, Formatting & Collection Helpers ──────────────────────────────────

fn _is_finite(v) {
    if type(v) != "number" { return false; }
    if not (v == v) { return false; }
    return (v - v) == 0.0 and num_abs(v) < 1.0e300;
}

fn _min_num(a, b) {
    if a < b { return a; }
    return b;
}

fn _max_num(a, b) {
    if a > b { return a; }
    return b;
}

fn _clamp_num(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _clamp_int(v, lo, hi) {
    let iv = num_floor(v);
    if iv < lo { return lo; }
    if iv > hi { return hi; }
    return iv;
}

fn _clean_float(x) {
    if not _is_finite(x) { return x; }
    if num_abs(x) < 1.0e-13 { return 0.0; }
    let rx = num_round(x);
    if num_abs(x - rx) < 1.0e-12 {
        return rx * 1.0;
    }
    let grid = num_round(x * 10000000000.0) / 10000000000.0;
    if num_abs(x - grid) < 1.0e-12 {
        return grid;
    }
    return x;
}

fn _fmt_fixed(val, decimals = 2) {
    if not _is_finite(val) { return "NaN"; }
    let d = _clamp_int(decimals, 0, 8);
    let neg = val < -1.0e-13;
    let av = num_abs(val);
    let scale = num_pow(10.0, d * 1.0);
    let scaled_int = num_round(av * scale + 1.0e-12);
    let int_part = num_floor(scaled_int / scale);
    let frac_part = num_round(scaled_int - int_part * scale);
    let prefix = if neg and scaled_int > 0 { "-" } else { "" };
    if d == 0 {
        return prefix + str(int_part);
    }
    let frac_str = str(frac_part);
    while len(frac_str) < d {
        frac_str = "0" + frac_str;
    }
    return prefix + str(int_part) + "." + frac_str;
}

fn _fmt_smart(val, max_dec = 4) {
    if not _is_finite(val) { return "NaN"; }
    let rv = num_round(val);
    if num_abs(val - rv) < 1.0e-9 {
        if rv == 0 { return "0"; }
        return str(rv);
    }
    let s = _fmt_fixed(val, max_dec);
    if str_contains(s, ".") {
        while len(s) > 1 and str_slice(s, len(s) - 1, len(s)) == "0" {
            s = str_slice(s, 0, len(s) - 1);
        }
        if len(s) > 1 and str_slice(s, len(s) - 1, len(s)) == "." {
            s = str_slice(s, 0, len(s) - 1);
        }
    }
    if s == "-0" { return "0"; }
    return s;
}

fn _copy_map(src) {
    let out = map{};
    if src == nil or type(src) != "map" { return out; }
    let ks = map_keys(src);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = src[k];
        i = i + 1;
    }
    return out;
}

fn _merge_env(base_m, extra_m) {
    let out = _copy_map(base_m);
    if extra_m == nil or type(extra_m) != "map" { return out; }
    let ks = map_keys(extra_m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if extra_m[k] != nil {
            out[k] = extra_m[k];
        }
        i = i + 1;
    }
    return out;
}

fn _sort_numbers(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        push(out, arr[i]);
        i = i + 1;
    }
    let n = len(out);
    let a = 1;
    while a < n {
        let key_v = out[a];
        let b = a - 1;
        while b >= 0 and out[b] > key_v {
            out[b + 1] = out[b];
            b = b - 1;
        }
        out[b + 1] = key_v;
        a = a + 1;
    }
    return out;
}

fn _now_ms() {
    let t = try time_ms() catch 0.0;
    if t != nil and type(t) == "number" { return t; }
    return 0.0;
}

// Render an 8-level Unicode block sparkline ("▁▂▃▄▅▆▇█") for a numeric series.
fn sparkline_unicode(series, max_width = 64) {
    let n = len(series);
    if n == 0 { return ""; }
    let sampled = [];
    let cap_w = _clamp_int(max_width, 4, 256);
    if n <= cap_w {
        let i = 0;
        while i < n {
            push(sampled, series[i]);
            i = i + 1;
        }
    } else {
        let i = 0;
        while i < cap_w {
            let idx = _clamp_int(num_round((i * (n - 1) * 1.0) / ((cap_w - 1) * 1.0)), 0, n - 1);
            push(sampled, series[idx]);
            i = i + 1;
        }
    }

    let min_v = nil;
    let max_v = nil;
    let i = 0;
    while i < len(sampled) {
        let v = sampled[i];
        if v != nil and _is_finite(v) {
            if min_v == nil or v < min_v { min_v = v; }
            if max_v == nil or v > max_v { max_v = v; }
        }
        i = i + 1;
    }
    if min_v == nil or max_v == nil {
        let blank = "";
        let bi = 0;
        while bi < len(sampled) { blank = blank + " "; bi = bi + 1; }
        return blank;
    }

    let span = max_v - min_v;
    let out = "";
    i = 0;
    while i < len(sampled) {
        let v = sampled[i];
        if v == nil or not _is_finite(v) {
            out = out + " ";
        } else if span <= 1.0e-15 {
            out = out + _SPARK_BLOCKS[3];
        } else {
            let norm = (v - min_v) / span;
            let lvl = _clamp_int(num_round(norm * 7.0), 0, 7);
            out = out + _SPARK_BLOCKS[lvl];
        }
        i = i + 1;
    }
    return out;
}

// ── Isolated Per-Lab CAS User-Function Synchronization ────────────────────────

fn _lab_needs_cas_sync(st) {
    if _ACTIVE_LAB_ID != st["id"] or _ACTIVE_LAB_REV != st["func_rev"] {
        return true;
    }
    let order = st["func_order"];
    let live = CAS.list_functions();
    if len(live) != len(order) {
        return true;
    }
    let i = 0;
    while i < len(order) {
        let nm = order[i];
        let gf = CAS.get_function(nm);
        if gf == nil or gf["body_str"] != st["func_defs"][nm]["body_str"] {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn _sync_lab_to_cas(st) {
    if not _lab_needs_cas_sync(st) {
        return true;
    }
    CAS.clear_functions();
    let order = st["func_order"];
    // Pass 1: register placeholders so mutually-dependent or redefined single-arg
    // custom calls parse as function invocations rather than implicit multiplication.
    let i = 0;
    while i < len(order) {
        let nm = order[i];
        if map_has(st["func_defs"], nm) {
            let fd = st["func_defs"][nm];
            CAS.define_function(fd["name"], fd["params"], "0");
        }
        i = i + 1;
    }
    // Pass 2: parse and bind full symbolic bodies in definition order.
    i = 0;
    while i < len(order) {
        let nm = order[i];
        if map_has(st["func_defs"], nm) {
            let fd = st["func_defs"][nm];
            CAS.define_function(fd["name"], fd["params"], fd["body_str"]);
        }
        i = i + 1;
    }
    _ACTIVE_LAB_ID = st["id"];
    _ACTIVE_LAB_REV = st["func_rev"];
    return true;
}

fn _parse_lab_expr(st, expr) {
    _sync_lab_to_cas(st);
    if type(expr) == "map" and map_has(expr, "kind") {
        return expr;
    }
    let key = str(expr);
    if map_has(st["ast_cache"], key) {
        return st["ast_cache"][key];
    }
    let ast = CAS.parse_math(key);
    if len(map_keys(st["ast_cache"])) >= 256 {
        st["ast_cache"] = map{};
    }
    st["ast_cache"][key] = ast;
    return ast;
}

// ── Adaptive Gauss-Kronrod G7-K15 & Composite Simpson Quadrature ──────────────

let _GK15_NODES = [
    0.9914553711208126,
    0.9491079123427585,
    0.8648644233597691,
    0.7415311855993945,
    0.5860872354676911,
    0.4058451513773972,
    0.2077849550078985,
    0.0
];

let _GK15_WK = [
    0.02293532201052922,
    0.06309209262997856,
    0.1047900103222502,
    0.1406532597155259,
    0.1690047266392679,
    0.1903505780647854,
    0.2044329400752989,
    0.2094821410847278
];

let _GK15_WG = [
    0.0,
    0.1294849661688697,
    0.0,
    0.2797053914892766,
    0.0,
    0.3818300505051189,
    0.0,
    0.4179591836734694
];

fn _gk15_panel_ast(ast, env, var_name, a, b) {
    let mid = 0.5 * (a + b);
    let half = 0.5 * (b - a);
    env[var_name] = mid;
    let f_mid = CAS.eval_ast(ast, env);
    if f_mid == nil or not _is_finite(f_mid) {
        return map{ "ok": false, "val": 0.0, "err": 1.0e300 };
    }
    let acc_k = _GK15_WK[7] * f_mid;
    let acc_g = _GK15_WG[7] * f_mid;
    let j = 0;
    while j < 7 {
        let dx = half * _GK15_NODES[j];
        env[var_name] = mid - dx;
        let f1 = CAS.eval_ast(ast, env);
        env[var_name] = mid + dx;
        let f2 = CAS.eval_ast(ast, env);
        if f1 == nil or f2 == nil or not _is_finite(f1) or not _is_finite(f2) {
            return map{ "ok": false, "val": 0.0, "err": 1.0e300 };
        }
        let fsum = f1 + f2;
        acc_k = acc_k + _GK15_WK[j] * fsum;
        if _GK15_WG[j] > 0.0 {
            acc_g = acc_g + _GK15_WG[j] * fsum;
        }
        j = j + 1;
    }
    let ik = acc_k * half;
    let ig = acc_g * half;
    return map{ "ok": true, "val": ik, "err": num_abs(ik - ig) };
}

fn _gk15_adaptive_ast(ast, env, var_name, a, b, tol, depth, max_depth, trk) {
    GOV.tick(trk, 1);
    let p = _gk15_panel_ast(ast, env, var_name, a, b);
    if not p["ok"] {
        return p;
    }
    if p["err"] <= tol or depth >= max_depth {
        return p;
    }
    let mid = 0.5 * (a + b);
    let left_r = _gk15_adaptive_ast(ast, env, var_name, a, mid, 0.5 * tol, depth + 1, max_depth, trk);
    if not left_r["ok"] { return left_r; }
    let right_r = _gk15_adaptive_ast(ast, env, var_name, mid, b, 0.5 * tol, depth + 1, max_depth, trk);
    if not right_r["ok"] { return right_r; }
    return map{
        "ok": true,
        "val": left_r["val"] + right_r["val"],
        "err": left_r["err"] + right_r["err"]
    };
}

fn _composite_simpson_ast(ast, env, var_name, a, b, panels = 256) {
    let n_even = _clamp_int(panels, 16, 2048);
    if n_even - num_floor(n_even / 2) * 2 == 1 {
        n_even = n_even + 1;
    }
    let h = (b - a) / (n_even * 1.0);
    let sum_s = 0.0;
    let valid_pts = 0;
    let i = 0;
    while i <= n_even {
        let xv = a + i * h;
        env[var_name] = xv;
        let fv = CAS.eval_ast(ast, env);
        if fv == nil or not _is_finite(fv) {
            // Nudge away from isolated removable singularity or jump boundary
            env[var_name] = xv + 1.0e-11 * h;
            fv = CAS.eval_ast(ast, env);
        }
        if fv != nil and _is_finite(fv) {
            let wt = 2.0;
            if i == 0 or i == n_even {
                wt = 1.0;
            } else if i - num_floor(i / 2) * 2 == 1 {
                wt = 4.0;
            }
            sum_s = sum_s + wt * fv;
            valid_pts = valid_pts + 1;
        }
        i = i + 1;
    }
    if valid_pts == 0 { return nil; }
    return (h / 3.0) * sum_s;
}

// Bracketed root finder on [xmin, xmax] for f(var_name) = 0 with bound lab variables.
fn _find_roots_in_window_ast(ast, base_env, var_name, xmin, xmax, subdivisions = 80) {
    let lo_w = _min_num(xmin * 1.0, xmax * 1.0);
    let hi_w = _max_num(xmin * 1.0, xmax * 1.0);
    if hi_w - lo_w <= 0.0 { return []; }
    let env = _copy_map(base_env);
    let n_sub = _clamp_int(subdivisions, 16, 400);
    let dx = (hi_w - lo_w) / (n_sub * 1.0);
    let raw_roots = [];

    let prev_x = lo_w;
    env[var_name] = prev_x;
    let prev_y = CAS.eval_ast(ast, env);
    if prev_y != nil and _is_finite(prev_y) and num_abs(prev_y) < 1.0e-11 {
        push(raw_roots, _clean_float(prev_x));
    }

    let i = 1;
    while i <= n_sub {
        let cur_x = if i == n_sub { hi_w } else { lo_w + i * dx };
        env[var_name] = cur_x;
        let cur_y = CAS.eval_ast(ast, env);
        if cur_y != nil and _is_finite(cur_y) {
            if num_abs(cur_y) < 1.0e-11 {
                push(raw_roots, _clean_float(cur_x));
            } else if prev_y != nil and _is_finite(prev_y) and num_abs(prev_y) >= 1.0e-11 {
                if (prev_y < 0.0 and cur_y > 0.0) or (prev_y > 0.0 and cur_y < 0.0) {
                    // Hybrid Illinois / Bisection refinement to 1e-12
                    let a = prev_x;
                    let b = cur_x;
                    let fa = prev_y;
                    let fb = cur_y;
                    let iter = 0;
                    let mid = 0.5 * (a + b);
                    let continuous = true;
                    while iter < 52 and num_abs(b - a) > 1.0e-12 {
                        // Guard against vertical asymptotepoles (e.g. 1/(x - c))
                        mid = 0.5 * (a + b);
                        env[var_name] = mid;
                        let fm = CAS.eval_ast(ast, env);
                        if fm == nil or not _is_finite(fm) {
                            continuous = false;
                            break;
                        }
                        if num_abs(fm) < 1.0e-14 {
                            a = mid;
                            b = mid;
                            break;
                        }
                        if (fa < 0.0 and fm > 0.0) or (fa > 0.0 and fm < 0.0) {
                            b = mid;
                            fb = fm;
                        } else {
                            a = mid;
                            fa = fm;
                        }
                        iter = iter + 1;
                    }
                    let cand = 0.5 * (a + b);
                    env[var_name] = cand;
                    let fc = CAS.eval_ast(ast, env);
                    if continuous and fc != nil and _is_finite(fc) and num_abs(fc) < 1.0e-5 * (1.0 + num_abs(fa) + num_abs(fb)) and num_abs(fc) < 1.0e-3 {
                        push(raw_roots, _clean_float(cand));
                    }
                }
            }
        }
        prev_x = cur_x;
        prev_y = cur_y;
        i = i + 1;
    }

    let sorted = _sort_numbers(raw_roots);
    let dedup = [];
    let ri = 0;
    while ri < len(sorted) {
        let rv = sorted[ri];
        if len(dedup) == 0 or num_abs(rv - dedup[len(dedup) - 1]) > 1.0e-6 {
            push(dedup, rv);
        }
        ri = ri + 1;
    }
    return dedup;
}

// ── Slider Kinematics Helpers (Discrete Tick & Continuous Real-Time dt) ───────

fn _advance_slider_delta(sl, delta_mag, is_discrete) {
    let lo = sl["min"];
    let hi = sl["max"];
    let span = hi - lo;
    let mode = sl["mode"];

    if delta_mag <= 0.0 {
        return sl["value"];
    }
    if span <= 1.0e-15 {
        sl["value"] = lo;
        if mode == "once" {
            sl["playing"] = false;
        }
        return lo;
    }

    let cur = sl["value"];
    let dir = sl["dir"];
    if dir >= 0 { dir = 1; } else { dir = -1; }

    if mode == "once" {
        let nxt = cur + delta_mag * dir;
        if dir > 0 and nxt >= hi - 1.0e-12 {
            sl["value"] = hi;
            sl["playing"] = false;
        } else if dir < 0 and nxt <= lo + 1.0e-12 {
            sl["value"] = lo;
            sl["playing"] = false;
        } else {
            sl["value"] = _clamp_num(_clean_float(nxt), lo, hi);
        }
        return sl["value"];
    }

    if mode == "loop" {
        if is_discrete {
            let stp = sl["step"];
            let ticks_est = num_round(delta_mag / stp);
            if ticks_est >= 1 and ticks_est <= 64 and num_abs(delta_mag - ticks_est * stp) < 1.0e-11 {
                let v = cur;
                let ti = 0;
                while ti < ticks_est {
                    if dir > 0 {
                        if num_abs(v - hi) <= 1.0e-12 {
                            v = lo;
                        } else if v + stp <= hi + 1.0e-12 {
                            v = _min_num(hi, v + stp);
                        } else {
                            let excess = (v + stp) - hi;
                            v = lo + (excess - num_floor(excess / span) * span);
                        }
                    } else {
                        if num_abs(v - lo) <= 1.0e-12 {
                            v = hi;
                        } else if v - stp >= lo - 1.0e-12 {
                            v = _max_num(lo, v - stp);
                        } else {
                            let deficit = lo - (v - stp);
                            v = hi - (deficit - num_floor(deficit / span) * span);
                        }
                    }
                    ti = ti + 1;
                }
                sl["value"] = _clamp_num(_clean_float(v), lo, hi);
                return sl["value"];
            }
        }
        let u = (cur - lo) + delta_mag * dir;
        let wrapped = lo + (u - num_floor(u / span) * span);
        sl["value"] = _clamp_num(_clean_float(wrapped), lo, hi);
        return sl["value"];
    }

    // Default: "ping_pong" — exact O(1) phase-space reflection on period 2 * span
    let period = 2.0 * span;
    let p0 = if dir > 0 { cur - lo } else { period - (cur - lo) };
    let p1 = p0 + delta_mag;
    let r = p1 - num_floor(p1 / period) * period;
    if num_abs(r - span) <= 1.0e-12 {
        sl["value"] = hi;
        sl["dir"] = -1;
    } else if r <= 1.0e-12 or num_abs(r - period) <= 1.0e-12 {
        sl["value"] = lo;
        sl["dir"] = 1;
    } else if r < span {
        sl["value"] = _clamp_num(_clean_float(lo + r), lo, hi);
        sl["dir"] = 1;
    } else {
        sl["value"] = _clamp_num(_clean_float(hi - (r - span)), lo, hi);
        sl["dir"] = -1;
    }
    return sl["value"];
}

fn _validate_slider_mode(mode_in) {
    let m = str_lower(str_trim(str(mode_in)));
    if m == "ping_pong" or m == "loop" or m == "once" {
        return m;
    }
    throw "interactive_lab: invalid slider mode '" + str(mode_in) + "' (expected 'ping_pong', 'loop', or 'once')";
}

fn _clone_slider_info(sl) {
    if sl == nil { return nil; }
    return map{
        "name": sl["name"],
        "min": sl["min"],
        "max": sl["max"],
        "step": sl["step"],
        "initial": sl["initial"],
        "value": sl["value"],
        "dir": sl["dir"],
        "mode": sl["mode"],
        "speed": sl["speed"],
        "playing": sl["playing"],
        "label_el": sl["label_el"],
        "label_en": sl["label_en"]
    };
}

// ── 1. Stateful Interactive Custom Function, Variable & Slider Lab ────────────

fn create_lab(opts = nil) {
    _NEXT_LAB_ID = _NEXT_LAB_ID + 1;
    let st = map{
        "id": _NEXT_LAB_ID,
        "name": "interactive_lab_" + str(_NEXT_LAB_ID),
        "func_defs": map{},
        "func_order": [],
        "func_rev": 1,
        "vars": map{},
        "sliders": map{},
        "slider_order": [],
        "clock_ticks": 0,
        "elapsed_ms": 0.0,
        "ast_cache": map{}
    };

    if opts != nil and type(opts) == "map" {
        if map_has(opts, "name") and opts["name"] != nil {
            st["name"] = str(opts["name"]);
        }
    }

    let fn_define = fn(def_str_or_name, params_opt = nil, body_opt = nil) {
        _sync_lab_to_cas(st);
        let entry = CAS.define_function(def_str_or_name, params_opt, body_opt);
        let nm = entry["name"];
        if not map_has(st["func_defs"], nm) {
            push(st["func_order"], nm);
        }
        st["func_defs"][nm] = map{
            "name": nm,
            "params": entry["params"],
            "signature": entry["signature"],
            "body_str": entry["body_str"],
            "ascii": entry["ascii"],
            "unicode": entry["unicode"],
            "latex": entry["latex"],
            "is_recursive": entry["is_recursive"],
            "is_piecewise_rec": entry["is_piecewise_rec"]
        };
        st["func_rev"] = st["func_rev"] + 1;
        st["ast_cache"] = map{};
        _ACTIVE_LAB_ID = st["id"];
        _ACTIVE_LAB_REV = st["func_rev"];
        return _copy_map(st["func_defs"][nm]);
    };

    let fn_define_many = fn(defs_array) {
        if type(defs_array) != "array" {
            throw "interactive_lab.define_many: expected array of function definitions";
        }
        let out = [];
        let i = 0;
        while i < len(defs_array) {
            let item = defs_array[i];
            if type(item) == "string" {
                push(out, fn_define(item, nil, nil));
            } else if type(item) == "map" {
                push(out, fn_define(item["name"], item["params"], item["body"]));
            } else {
                throw "interactive_lab.define_many: invalid entry at index " + str(i);
            }
            i = i + 1;
        }
        return out;
    };

    let fn_undefine = fn(name) {
        let nm = str_trim(str(name));
        if not map_has(st["func_defs"], nm) {
            return false;
        }
        map_remove(st["func_defs"], nm);
        let next_ord = [];
        let i = 0;
        while i < len(st["func_order"]) {
            if st["func_order"][i] != nm {
                push(next_ord, st["func_order"][i]);
            }
            i = i + 1;
        }
        st["func_order"] = next_ord;
        st["func_rev"] = st["func_rev"] + 1;
        st["ast_cache"] = map{};
        if _ACTIVE_LAB_ID == st["id"] {
            CAS.undefine_function(nm);
            _ACTIVE_LAB_REV = st["func_rev"];
        }
        return true;
    };

    let fn_clear_functions = fn() {
        st["func_defs"] = map{};
        st["func_order"] = [];
        st["func_rev"] = st["func_rev"] + 1;
        st["ast_cache"] = map{};
        if _ACTIVE_LAB_ID == st["id"] {
            CAS.clear_functions();
            _ACTIVE_LAB_REV = st["func_rev"];
        }
        return true;
    };

    let fn_list_functions = fn() {
        _sync_lab_to_cas(st);
        return CAS.list_functions();
    };

    let fn_get_function = fn(name) {
        let nm = str_trim(str(name));
        if map_has(st["func_defs"], nm) {
            return _copy_map(st["func_defs"][nm]);
        }
        return nil;
    };

    let fn_expand_expr = fn(expr) {
        _sync_lab_to_cas(st);
        let parsed = CAS.parse_math(expr);
        let inlined = CAS.expand_user_functions(parsed, 0);
        let simp = try CAS.simplify_node(inlined, nil) catch inlined;
        let tr = try CAS.transform(CAS.to_ascii(inlined), "expand") catch nil;
        let final_ast = if tr != nil and map_has(tr, "ast") { tr["ast"] } else { simp };
        return map{
            "ok": true,
            "ascii": CAS.to_ascii(final_ast),
            "unicode": CAS.to_unicode(final_ast),
            "latex": CAS.to_latex(final_ast),
            "simplified_ascii": CAS.to_ascii(simp),
            "ast": final_ast
        };
    };

    let fn_set = fn(name, val) {
        let nm = str_trim(str(name));
        if nm == "" {
            throw "interactive_lab.set: variable name cannot be empty";
        }
        let num_v = if type(val) == "number" { val * 1.0 } else { parse_number(str(val)) };
        if num_v == nil or not _is_finite(num_v) {
            throw "interactive_lab.set: expected finite numeric value for '" + nm + "'";
        }
        let clean_v = _clean_float(num_v);
        st["vars"][nm] = clean_v;
        if map_has(st["sliders"], nm) {
            let sl = st["sliders"][nm];
            sl["value"] = _clamp_num(clean_v, sl["min"], sl["max"]);
            st["vars"][nm] = sl["value"];
        }
        return st["vars"][nm];
    };

    let fn_set_many = fn(vars_map) {
        if vars_map == nil or type(vars_map) != "map" {
            return _copy_map(st["vars"]);
        }
        let ks = map_keys(vars_map);
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            fn_set(k, vars_map[k]);
            i = i + 1;
        }
        return _copy_map(st["vars"]);
    };

    let fn_get = fn(name) {
        let nm = str_trim(str(name));
        if map_has(st["vars"], nm) {
            return st["vars"][nm];
        }
        return nil;
    };

    let fn_remove_var = fn(name) {
        let nm = str_trim(str(name));
        if map_has(st["vars"], nm) {
            map_remove(st["vars"], nm);
            return true;
        }
        return false;
    };

    let fn_vars = fn() {
        return _copy_map(st["vars"]);
    };

    let fn_eval = fn(expr, extra_env = nil) {
        let ast = _parse_lab_expr(st, expr);
        let env = _merge_env(st["vars"], extra_env);
        let res = CAS.eval_ast(ast, env);
        if res == nil or not _is_finite(res) {
            return nil;
        }
        return _clean_float(res);
    };

    let fn_eval_many = fn(expr_list, extra_env = nil) {
        if type(expr_list) != "array" {
            return [fn_eval(expr_list, extra_env)];
        }
        _sync_lab_to_cas(st);
        let env = _merge_env(st["vars"], extra_env);
        let out = [];
        let i = 0;
        while i < len(expr_list) {
            let ast = _parse_lab_expr(st, expr_list[i]);
            let v = CAS.eval_ast(ast, env);
            if v == nil or not _is_finite(v) {
                push(out, nil);
            } else {
                push(out, _clean_float(v));
            }
            i = i + 1;
        }
        return out;
    };

    let fn_eval_table = fn(expr, var_name, values_arr) {
        if type(values_arr) != "array" {
            throw "interactive_lab.eval_table: values_arr must be an array";
        }
        let ast = _parse_lab_expr(st, expr);
        let env = _copy_map(st["vars"]);
        let v_nm = str_trim(str(var_name));
        let rows = [];
        let i = 0;
        while i < len(values_arr) {
            let xv = values_arr[i] * 1.0;
            env[v_nm] = xv;
            let yv = CAS.eval_ast(ast, env);
            let clean_y = if yv != nil and _is_finite(yv) { _clean_float(yv) } else { nil };
            push(rows, map{
                "x": _clean_float(xv),
                "y": clean_y
            });
            i = i + 1;
        }
        return rows;
    };

    let fn_derivative_at = fn(expr, var_name, x_val) {
        let ast = _parse_lab_expr(st, expr);
        let v_nm = str_trim(str(var_name));
        let x0 = x_val * 1.0;
        let env = _copy_map(st["vars"]);
        env[v_nm] = x0;

        // Expand non-recursive custom functions first so parameter dependencies inside
        // custom function bodies are differentiated accurately, then try symbolic diff_ast.
        let target_ast = try CAS.expand_user_functions(ast, 0) catch ast;
        let d_ast = try CAS.diff_ast(target_ast, v_nm) catch nil;
        if d_ast != nil {
            let sym_val = try CAS.eval_ast(d_ast, env) catch nil;
            if sym_val != nil and _is_finite(sym_val) {
                return _clean_float(sym_val);
            }
        }

        // 5-point 4th-order central finite-difference fallback
        let h = 1.0e-5 * _max_num(1.0, num_abs(x0));
        env[v_nm] = x0 - 2.0 * h;
        let fm2 = CAS.eval_ast(ast, env);
        env[v_nm] = x0 - h;
        let fm1 = CAS.eval_ast(ast, env);
        env[v_nm] = x0 + h;
        let fp1 = CAS.eval_ast(ast, env);
        env[v_nm] = x0 + 2.0 * h;
        let fp2 = CAS.eval_ast(ast, env);
        if fm2 != nil and fm1 != nil and fp1 != nil and fp2 != nil and _is_finite(fm2) and _is_finite(fm1) and _is_finite(fp1) and _is_finite(fp2) {
            return _clean_float((fm2 - 8.0 * fm1 + 8.0 * fp1 - fp2) / (12.0 * h));
        }
        if fm1 != nil and fp1 != nil and _is_finite(fm1) and _is_finite(fp1) {
            return _clean_float((fp1 - fm1) / (2.0 * h));
        }
        return nil;
    };

    let fn_integral_on = fn(expr, var_name, a, b) {
        let ast = _parse_lab_expr(st, expr);
        let v_nm = str_trim(str(var_name));
        let a_f = a * 1.0;
        let b_f = b * 1.0;
        if not _is_finite(a_f) or not _is_finite(b_f) {
            throw "interactive_lab.integral_on: integration bounds must be finite numbers";
        }
        if num_abs(b_f - a_f) < 1.0e-15 {
            return 0.0;
        }

        // Substitute bound lab parameters (except integration variable) so elementary
        // expressions can also leverage CALC.integrate_definite when supported.
        let sub_map = map{};
        let v_keys = map_keys(st["vars"]);
        let ki = 0;
        while ki < len(v_keys) {
            let kn = v_keys[ki];
            if kn != v_nm {
                sub_map[kn] = CAS.parse_math(str(st["vars"][kn]));
            }
            ki = ki + 1;
        }
        let exp_ast = try CAS.expand_user_functions(ast, 0) catch ast;
        let bound_ast = try CAS.subst_ast(exp_ast, sub_map) catch exp_ast;
        let bound_ascii = CAS.to_ascii(bound_ast);
        if not str_contains(bound_ascii, "piecewise") and not str_contains(bound_ascii, "heaviside") and not str_contains(bound_ascii, "sign(") and not str_contains(bound_ascii, "sinc(") and not str_contains(bound_ascii, "min(") and not str_contains(bound_ascii, "max(") and not str_contains(bound_ascii, "clamp(") {
            let calc_res = try CALC.integrate_definite(bound_ascii, v_nm, a_f, b_f, 1.0e-11) catch nil;
            if calc_res != nil and map_has(calc_res, "value") and _is_finite(calc_res["value"]) {
                return _clean_float(calc_res["value"]);
            }
        }

        // Universal CAS AST quadrature (supports piecewise, heaviside, sinc, recursive custom functions)
        let trk = GOV.new_tracker("interactive_lab.integral_on", nil);
        let env = _copy_map(st["vars"]);
        let sign_dir = 1.0;
        let lo_b = a_f;
        let hi_b = b_f;
        if a_f > b_f {
            lo_b = b_f;
            hi_b = a_f;
            sign_dir = -1.0;
        }
        let gk = _gk15_adaptive_ast(ast, env, v_nm, lo_b, hi_b, 1.0e-10, 0, 12, trk);
        if gk["ok"] and _is_finite(gk["val"]) {
            return _clean_float(sign_dir * gk["val"]);
        }
        let simp_v = _composite_simpson_ast(ast, env, v_nm, lo_b, hi_b, 512);
        if simp_v == nil { return nil; }
        return _clean_float(sign_dir * simp_v);
    };

    // ── Range Sliders & Autonomous Time-Stepping Engine ───────────────────────

    let fn_slider = fn(name, min_val, max_val, step = 0.1, s_opts = nil) {
        let nm = str_trim(str(name));
        if nm == "" {
            throw "interactive_lab.slider: slider name cannot be empty";
        }
        let lo = min_val * 1.0;
        let hi = max_val * 1.0;
        let stp = step * 1.0;
        if not _is_finite(lo) or not _is_finite(hi) or not _is_finite(stp) {
            throw "interactive_lab.slider: min_val, max_val, and step must be finite numbers";
        }
        if lo > hi {
            throw "interactive_lab.slider: min_val (" + str(lo) + ") must be <= max_val (" + str(hi) + ")";
        }
        if stp <= 0.0 {
            throw "interactive_lab.slider: step (" + str(stp) + ") must be > 0";
        }

        let init_v = lo;
        let mode_s = "ping_pong";
        let speed_v = 10.0 * stp;
        let playing_b = false;
        let lbl_el = nm;
        let lbl_en = nm;

        if s_opts != nil and type(s_opts) == "map" {
            if map_has(s_opts, "initial") and s_opts["initial"] != nil {
                init_v = _clamp_num(s_opts["initial"] * 1.0, lo, hi);
            }
            if map_has(s_opts, "mode") and s_opts["mode"] != nil {
                mode_s = _validate_slider_mode(s_opts["mode"]);
            }
            if map_has(s_opts, "speed") and s_opts["speed"] != nil {
                let sp = s_opts["speed"] * 1.0;
                if not _is_finite(sp) or sp < 0.0 {
                    throw "interactive_lab.slider: speed must be >= 0";
                }
                speed_v = sp;
            }
            if map_has(s_opts, "playing") and s_opts["playing"] != nil {
                playing_b = if s_opts["playing"] { true } else { false };
            }
            if map_has(s_opts, "label_el") and s_opts["label_el"] != nil {
                lbl_el = str(s_opts["label_el"]);
            }
            if map_has(s_opts, "label_en") and s_opts["label_en"] != nil {
                lbl_en = str(s_opts["label_en"]);
            }
        }

        let clean_init = _clean_float(init_v);
        if not map_has(st["sliders"], nm) {
            push(st["slider_order"], nm);
        }
        let sl = map{
            "name": nm,
            "min": _clean_float(lo),
            "max": _clean_float(hi),
            "step": _clean_float(stp),
            "initial": clean_init,
            "value": clean_init,
            "dir": 1,
            "mode": mode_s,
            "speed": _clean_float(speed_v),
            "playing": playing_b,
            "label_el": lbl_el,
            "label_en": lbl_en
        };
        st["sliders"][nm] = sl;
        st["vars"][nm] = clean_init;
        return _clone_slider_info(sl);
    };

    let fn_get_slider = fn(name) {
        let nm = str_trim(str(name));
        if map_has(st["sliders"], nm) {
            return _clone_slider_info(st["sliders"][nm]);
        }
        return nil;
    };

    let fn_list_sliders = fn() {
        let out = [];
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                push(out, _clone_slider_info(st["sliders"][nm]));
            }
            i = i + 1;
        }
        return out;
    };

    let fn_set_slider_mode = fn(name, mode) {
        let nm = str_trim(str(name));
        if not map_has(st["sliders"], nm) {
            throw "interactive_lab.set_slider_mode: unknown slider '" + nm + "'";
        }
        let m = _validate_slider_mode(mode);
        st["sliders"][nm]["mode"] = m;
        return _clone_slider_info(st["sliders"][nm]);
    };

    let fn_set_slider_speed = fn(name, speed) {
        let nm = str_trim(str(name));
        if not map_has(st["sliders"], nm) {
            throw "interactive_lab.set_slider_speed: unknown slider '" + nm + "'";
        }
        let sp = speed * 1.0;
        if not _is_finite(sp) or sp < 0.0 {
            throw "interactive_lab.set_slider_speed: speed must be >= 0";
        }
        st["sliders"][nm]["speed"] = _clean_float(sp);
        return _clone_slider_info(st["sliders"][nm]);
    };

    let fn_start = fn(name = nil) {
        if name != nil {
            let nm = str_trim(str(name));
            if not map_has(st["sliders"], nm) {
                throw "interactive_lab.start: unknown slider '" + nm + "'";
            }
            let sl = st["sliders"][nm];
            if sl["mode"] == "once" and num_abs(sl["value"] - sl["max"]) <= 1.0e-12 {
                sl["value"] = sl["min"];
                sl["dir"] = 1;
                st["vars"][nm] = sl["value"];
            }
            sl["playing"] = true;
            return _clone_slider_info(sl);
        }
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                let sl = st["sliders"][nm];
                if sl["mode"] == "once" and num_abs(sl["value"] - sl["max"]) <= 1.0e-12 {
                    sl["value"] = sl["min"];
                    sl["dir"] = 1;
                    st["vars"][nm] = sl["value"];
                }
                sl["playing"] = true;
            }
            i = i + 1;
        }
        return fn_list_sliders();
    };

    let fn_pause = fn(name = nil) {
        if name != nil {
            let nm = str_trim(str(name));
            if not map_has(st["sliders"], nm) {
                throw "interactive_lab.pause: unknown slider '" + nm + "'";
            }
            st["sliders"][nm]["playing"] = false;
            return _clone_slider_info(st["sliders"][nm]);
        }
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                st["sliders"][nm]["playing"] = false;
            }
            i = i + 1;
        }
        return fn_list_sliders();
    };

    let fn_reset = fn(name = nil) {
        if name != nil {
            let nm = str_trim(str(name));
            if not map_has(st["sliders"], nm) {
                throw "interactive_lab.reset: unknown slider '" + nm + "'";
            }
            let sl = st["sliders"][nm];
            sl["value"] = sl["initial"];
            sl["dir"] = 1;
            st["vars"][nm] = sl["initial"];
            return _clone_slider_info(sl);
        }
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                let sl = st["sliders"][nm];
                sl["value"] = sl["initial"];
                sl["dir"] = 1;
                st["vars"][nm] = sl["initial"];
            }
            i = i + 1;
        }
        st["clock_ticks"] = 0;
        st["elapsed_ms"] = 0.0;
        return fn_list_sliders();
    };

    let fn_step = fn(ticks = 1) {
        let tk_count = num_floor(ticks * 1.0);
        if tk_count <= 0 {
            return map{
                "clock_ticks": st["clock_ticks"],
                "elapsed_ms": st["elapsed_ms"],
                "vars": _copy_map(st["vars"]),
                "sliders": fn_list_sliders()
            };
        }
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                let sl = st["sliders"][nm];
                if sl["playing"] {
                    let nv = _advance_slider_delta(sl, tk_count * sl["step"], true);
                    st["vars"][nm] = nv;
                }
            }
            i = i + 1;
        }
        st["clock_ticks"] = st["clock_ticks"] + tk_count;
        return map{
            "clock_ticks": st["clock_ticks"],
            "elapsed_ms": st["elapsed_ms"],
            "vars": _copy_map(st["vars"]),
            "sliders": fn_list_sliders()
        };
    };

    let fn_step_dt = fn(dt_ms) {
        let dt = dt_ms * 1.0;
        if not _is_finite(dt) or dt <= 0.0 {
            return map{
                "clock_ticks": st["clock_ticks"],
                "elapsed_ms": st["elapsed_ms"],
                "vars": _copy_map(st["vars"]),
                "sliders": fn_list_sliders()
            };
        }
        let dt_sec = dt / 1000.0;
        let i = 0;
        while i < len(st["slider_order"]) {
            let nm = st["slider_order"][i];
            if map_has(st["sliders"], nm) {
                let sl = st["sliders"][nm];
                if sl["playing"] {
                    let nv = _advance_slider_delta(sl, dt_sec * sl["speed"], false);
                    st["vars"][nm] = nv;
                }
            }
            i = i + 1;
        }
        st["elapsed_ms"] = _clean_float(st["elapsed_ms"] + dt);
        return map{
            "clock_ticks": st["clock_ticks"],
            "elapsed_ms": st["elapsed_ms"],
            "vars": _copy_map(st["vars"]),
            "sliders": fn_list_sliders()
        };
    };

    let fn_run_sweep = fn(expr_or_list, slider_name, sw_opts = nil) {
        let s_nm = str_trim(str(slider_name));
        if not map_has(st["sliders"], s_nm) {
            throw "interactive_lab.run_sweep: unknown slider '" + s_nm + "'";
        }
        let exprs = if type(expr_or_list) == "array" { expr_or_list } else { [expr_or_list] };
        if len(exprs) == 0 {
            throw "interactive_lab.run_sweep: expression list cannot be empty";
        }

        _sync_lab_to_cas(st);
        let asts = [];
        let ei = 0;
        while ei < len(exprs) {
            push(asts, _parse_lab_expr(st, exprs[ei]));
            ei = ei + 1;
        }

        let sl = st["sliders"][s_nm];
        let saved_sl_val = sl["value"];
        let saved_sl_dir = sl["dir"];
        let saved_sl_play = sl["playing"];
        let saved_var_val = st["vars"][s_nm];

        let lo = sl["min"];
        let hi = sl["max"];
        let stp = sl["step"];

        let lim = GOV.current_limits(sw_opts);
        let max_cap = _min_num(2000, lim["max_steps"]);
        let trk = GOV.new_tracker("interactive_lab.run_sweep", sw_opts);

        let est_count = if hi > lo { num_floor((hi - lo) / stp + 1.0e-9) + 1 } else { 1 };
        let clamped_gov = false;
        if est_count > max_cap {
            if sw_opts != nil and type(sw_opts) == "map" and map_has(sw_opts, "strict") and sw_opts["strict"] {
                throw "MathGovernor[interactive_lab.run_sweep]: sweep steps (" + str(est_count) + ") exceed limit (" + str(max_cap) + ")";
            }
            stp = (hi - lo) / ((max_cap - 1) * 1.0);
            est_count = max_cap;
            clamped_gov = true;
        }

        let track_roots_v = nil;
        let rx_min = -10.0;
        let rx_max = 10.0;
        let slope_v = s_nm;
        let keep_final = false;
        if sw_opts != nil and type(sw_opts) == "map" {
            if map_has(sw_opts, "track_roots_var") and sw_opts["track_roots_var"] != nil {
                track_roots_v = str_trim(str(sw_opts["track_roots_var"]));
            } else if map_has(sw_opts, "xmin") or map_has(sw_opts, "xmax") {
                track_roots_v = "x";
            }
            if map_has(sw_opts, "xmin") and sw_opts["xmin"] != nil { rx_min = sw_opts["xmin"] * 1.0; }
            if map_has(sw_opts, "xmax") and sw_opts["xmax"] != nil { rx_max = sw_opts["xmax"] * 1.0; }
            if map_has(sw_opts, "slope_var") and sw_opts["slope_var"] != nil {
                slope_v = str_trim(str(sw_opts["slope_var"]));
            }
            if map_has(sw_opts, "keep_final") and sw_opts["keep_final"] {
                keep_final = true;
            }
        }

        let steps_out = [];
        let primary_ys = [];
        let min_y = nil;
        let max_y = nil;
        let sum_y = 0.0;
        let valid_y_cnt = 0;

        let idx = 0;
        while idx < est_count {
            GOV.tick(trk, 1);
            let pv = _clean_float(_min_num(hi, lo + idx * stp));
            if idx == est_count - 1 and est_count > 1 and num_abs((lo + idx * stp) - hi) <= stp + 1.0e-9 {
                pv = _clean_float(_min_num(hi, lo + idx * stp));
            }
            sl["value"] = pv;
            st["vars"][s_nm] = pv;

            let env_cur = _copy_map(st["vars"]);
            let vals_row = [];
            let j = 0;
            while j < len(asts) {
                let yj = CAS.eval_ast(asts[j], env_cur);
                let clean_yj = if yj != nil and _is_finite(yj) { _clean_float(yj) } else { nil };
                push(vals_row, clean_yj);
                j = j + 1;
            }

            let y0 = vals_row[0];
            push(primary_ys, y0);
            if y0 != nil {
                if min_y == nil or y0 < min_y { min_y = y0; }
                if max_y == nil or y0 > max_y { max_y = y0; }
                sum_y = sum_y + y0;
                valid_y_cnt = valid_y_cnt + 1;
            }

            let slope_at = if map_has(st["vars"], slope_v) { st["vars"][slope_v] } else { pv };
            let slp = fn_derivative_at(asts[0], slope_v, slope_at);

            let roots_w = [];
            if track_roots_v != nil and track_roots_v != "" {
                roots_w = _find_roots_in_window_ast(asts[0], env_cur, track_roots_v, rx_min, rx_max, 80);
            }

            push(steps_out, map{
                "step_index": idx,
                "param_value": pv,
                "value": y0,
                "values": vals_row,
                "slope": slp,
                "roots_in_window": roots_w
            });
            idx = idx + 1;
        }

        // Include exact upper bound if step did not land on hi and count < max_cap
        if len(steps_out) > 0 and len(steps_out) < max_cap {
            let last_pv = steps_out[len(steps_out) - 1]["param_value"];
            if hi - last_pv > 1.0e-9 {
                GOV.tick(trk, 1);
                let pv = _clean_float(hi);
                sl["value"] = pv;
                st["vars"][s_nm] = pv;
                let env_cur = _copy_map(st["vars"]);
                let vals_row = [];
                let j = 0;
                while j < len(asts) {
                    let yj = CAS.eval_ast(asts[j], env_cur);
                    let clean_yj = if yj != nil and _is_finite(yj) { _clean_float(yj) } else { nil };
                    push(vals_row, clean_yj);
                    j = j + 1;
                }
                let y0 = vals_row[0];
                push(primary_ys, y0);
                if y0 != nil {
                    if min_y == nil or y0 < min_y { min_y = y0; }
                    if max_y == nil or y0 > max_y { max_y = y0; }
                    sum_y = sum_y + y0;
                    valid_y_cnt = valid_y_cnt + 1;
                }
                let slope_at = if map_has(st["vars"], slope_v) { st["vars"][slope_v] } else { pv };
                let slp = fn_derivative_at(asts[0], slope_v, slope_at);
                let roots_w = [];
                if track_roots_v != nil and track_roots_v != "" {
                    roots_w = _find_roots_in_window_ast(asts[0], env_cur, track_roots_v, rx_min, rx_max, 80);
                }
                push(steps_out, map{
                    "step_index": len(steps_out),
                    "param_value": pv,
                    "value": y0,
                    "values": vals_row,
                    "slope": slp,
                    "roots_in_window": roots_w
                });
            }
        }

        if not keep_final {
            sl["value"] = saved_sl_val;
            sl["dir"] = saved_sl_dir;
            sl["playing"] = saved_sl_play;
            st["vars"][s_nm] = saved_var_val;
        }

        let mean_y = if valid_y_cnt > 0 { _clean_float(sum_y / (valid_y_cnt * 1.0)) } else { nil };
        let spark = sparkline_unicode(primary_ys, 64);

        return map{
            "ok": true,
            "slider": s_nm,
            "steps_count": len(steps_out),
            "clamped_by_governor": clamped_gov,
            "steps": steps_out,
            "summary": map{
                "min_y": min_y,
                "max_y": max_y,
                "mean_y": mean_y,
                "valid_count": valid_y_cnt,
                "sparkline_unicode": spark
            }
        };
    };

    let fn_play_realtime = fn(expr_or_list, duration_ms = 300, tick_ms = 30, on_frame = nil) {
        let exprs = if type(expr_or_list) == "array" { expr_or_list } else { [expr_or_list] };
        if len(exprs) == 0 {
            throw "interactive_lab.play_realtime: expression list cannot be empty";
        }
        _sync_lab_to_cas(st);
        let asts = [];
        let ei = 0;
        while ei < len(exprs) {
            push(asts, _parse_lab_expr(st, exprs[ei]));
            ei = ei + 1;
        }

        // Enforce resource governor <= 5000 ms wall-clock cap
        let gov_lim = GOV.current_limits(nil);
        let max_wall_ms = _min_num(5000.0, gov_lim["budget_ms"] * 1.0);
        if max_wall_ms <= 0.0 { max_wall_ms = 250.0; }
        let dur_cap = _clamp_num(duration_ms * 1.0, 0.0, max_wall_ms);
        let tk_step = _clamp_num(tick_ms * 1.0, 1.0, _max_num(1.0, dur_cap));

        // Start all sliders automatically if none are currently playing
        let any_playing = false;
        let si = 0;
        while si < len(st["slider_order"]) {
            let nm = st["slider_order"][si];
            if map_has(st["sliders"], nm) and st["sliders"][nm]["playing"] {
                any_playing = true;
            }
            si = si + 1;
        }
        if not any_playing and len(st["slider_order"]) > 0 {
            fn_start(nil);
        }

        let frames = [];
        let series_per_expr = [];
        ei = 0;
        while ei < len(asts) {
            push(series_per_expr, []);
            ei = ei + 1;
        }

        let record_frame = fn(f_idx, elapsed_now, dt_now) {
            let env_now = _copy_map(st["vars"]);
            let vals_now = [];
            let j = 0;
            while j < len(asts) {
                let vj = CAS.eval_ast(asts[j], env_now);
                let clean_vj = if vj != nil and _is_finite(vj) { _clean_float(vj) } else { nil };
                push(vals_now, clean_vj);
                push(series_per_expr[j], clean_vj);
                j = j + 1;
            }
            let sl_vals = map{};
            let k = 0;
            while k < len(st["slider_order"]) {
                let sn = st["slider_order"][k];
                if map_has(st["sliders"], sn) {
                    sl_vals[sn] = st["sliders"][sn]["value"];
                }
                k = k + 1;
            }
            let frm = map{
                "frame_index": f_idx,
                "elapsed_ms": _clean_float(elapsed_now),
                "dt_ms": _clean_float(dt_now),
                "sliders": sl_vals,
                "vars": env_now,
                "value": vals_now[0],
                "values": vals_now
            };
            push(frames, frm);
            if on_frame != nil and (type(on_frame) == "fn" or type(on_frame) == "function") {
                on_frame(frm);
            }
        };

        let t0 = _now_ms();
        let t_prev = t0;
        record_frame(0, 0.0, 0.0);

        let f_idx = 1;
        let max_frames_guard = 1000;
        while f_idx < max_frames_guard {
            let elapsed_so_far = _now_ms() - t0;
            if elapsed_so_far >= dur_cap {
                break;
            }
            let rem_ms = dur_cap - elapsed_so_far;
            let sleep_dur = _max_num(1, num_round(_min_num(tk_step, rem_ms)));
            sleep_ms(sleep_dur);

            let t_now = _now_ms();
            let actual_dt = _max_num(0.5, t_now - t_prev);
            t_prev = t_now;

            _sync_lab_to_cas(st);
            fn_step_dt(actual_dt);
            record_frame(f_idx, t_now - t0, actual_dt);
            f_idx = f_idx + 1;
        }

        let total_elapsed = _clean_float(_max_num(0.0, _now_ms() - t0));
        let sparks = [];
        let spark_map = map{};
        ei = 0;
        while ei < len(asts) {
            let sp_s = sparkline_unicode(series_per_expr[ei], 64);
            push(sparks, sp_s);
            spark_map[str(exprs[ei])] = sp_s;
            ei = ei + 1;
        }

        return map{
            "ok": true,
            "mode": "realtime_autonomous",
            "frames_count": len(frames),
            "elapsed_ms": total_elapsed,
            "frames": frames,
            "sparklines": sparks,
            "sparkline_unicode": sparks[0],
            "sparkline_map": spark_map
        };
    };

    // Apply optional initial definitions, variables, and sliders from opts
    if opts != nil and type(opts) == "map" {
        if map_has(opts, "functions") and type(opts["functions"]) == "array" {
            fn_define_many(opts["functions"]);
        }
        if map_has(opts, "vars") and type(opts["vars"]) == "map" {
            fn_set_many(opts["vars"]);
        }
    }

    return map{
        "id": st["id"],
        "name": st["name"],
        "define": fn_define,
        "define_many": fn_define_many,
        "undefine": fn_undefine,
        "clear_functions": fn_clear_functions,
        "list_functions": fn_list_functions,
        "get_function": fn_get_function,
        "expand_expr": fn_expand_expr,
        "set": fn_set,
        "set_many": fn_set_many,
        "get": fn_get,
        "remove_var": fn_remove_var,
        "vars": fn_vars,
        "eval": fn_eval,
        "eval_many": fn_eval_many,
        "eval_table": fn_eval_table,
        "derivative_at": fn_derivative_at,
        "integral_on": fn_integral_on,
        "slider": fn_slider,
        "get_slider": fn_get_slider,
        "list_sliders": fn_list_sliders,
        "set_slider_mode": fn_set_slider_mode,
        "set_slider_speed": fn_set_slider_speed,
        "start": fn_start,
        "pause": fn_pause,
        "reset": fn_reset,
        "step": fn_step,
        "step_dt": fn_step_dt,
        "run_sweep": fn_run_sweep,
        "play_realtime": fn_play_realtime
    };
}

// ── 2. Interactive Statistical & Unit-Scale Invariance Concept Explorers ──────

fn _parse_dataset_input(values_or_preset) {
    if values_or_preset == nil {
        return map{ "preset": "basic", "values": [4.0, 7.0, 8.0, 10.0, 11.0] };
    }
    if type(values_or_preset) == "string" {
        let trimmed = str_trim(values_or_preset);
        let low = str_lower(trimmed);
        if low == "basic" or low == "" {
            return map{ "preset": "basic", "values": [4.0, 7.0, 8.0, 10.0, 11.0] };
        }
        if low == "low_dispersion" {
            return map{ "preset": "low_dispersion", "values": [7.0, 7.5, 8.0, 8.5, 9.0] };
        }
        if low == "with_outlier" {
            return map{ "preset": "with_outlier", "values": [4.0, 7.0, 8.0, 10.0, 26.0] };
        }
        // Parse comma / space / semicolon separated numeric list
        let norm_s = str_replace_all(trimmed, ";", " ");
        norm_s = str_replace_all(norm_s, ",", " ");
        norm_s = str_replace_all(norm_s, "\t", " ");
        norm_s = str_replace_all(norm_s, "\n", " ");
        let raw_parts = str_split(norm_s, " ");
        let nums = [];
        let i = 0;
        while i < len(raw_parts) {
            let tok = str_trim(raw_parts[i]);
            if tok != "" {
                let pv = parse_number(tok);
                if pv == nil or not _is_finite(pv) {
                    throw "stddev_explorer: invalid numeric token '" + tok + "'";
                }
                push(nums, _clean_float(pv));
            }
            i = i + 1;
        }
        return map{ "preset": "custom", "values": nums };
    }
    if type(values_or_preset) == "array" {
        let nums = [];
        let i = 0;
        while i < len(values_or_preset) {
            let item = values_or_preset[i];
            let pv = if type(item) == "number" { item * 1.0 } else { parse_number(str(item)) };
            if pv == nil or not _is_finite(pv) {
                throw "stddev_explorer: non-numeric element at index " + str(i);
            }
            push(nums, _clean_float(pv));
            i = i + 1;
        }
        return map{ "preset": "custom", "values": nums };
    }
    throw "stddev_explorer: expected preset name, comma/space-separated string, or numeric array";
}

fn stddev_explorer(values_or_preset = "basic", is_sample = true) {
    let parsed = _parse_dataset_input(values_or_preset);
    let xs = parsed["values"];
    let n = len(xs);
    let sample_mode = if is_sample { true } else { false };

    if sample_mode and n < 2 {
        throw "stddev_explorer: sample statistics require at least n >= 2 observations (got " + str(n) + ")";
    }
    if not sample_mode and n < 1 {
        throw "stddev_explorer: population statistics require at least n >= 1 observation";
    }

    let sum_x = 0.0;
    let i = 0;
    while i < n {
        sum_x = sum_x + xs[i];
        i = i + 1;
    }
    sum_x = _clean_float(sum_x);
    let mean_v = _clean_float(sum_x / (n * 1.0));

    let ss = 0.0;
    let devs = [];
    let sq_devs = [];
    let sq_terms_txt = "";
    i = 0;
    while i < n {
        let d = _clean_float(xs[i] - mean_v);
        let sq = _clean_float(d * d);
        push(devs, d);
        push(sq_devs, sq);
        ss = ss + sq;
        if i < 8 {
            if i > 0 { sq_terms_txt = sq_terms_txt + " + "; }
            sq_terms_txt = sq_terms_txt + _fmt_smart(sq, 4);
        } else if i == 8 {
            sq_terms_txt = sq_terms_txt + " + ...";
        }
        i = i + 1;
    }
    ss = _clean_float(ss);

    let denom = if sample_mode { n - 1 } else { n };
    let variance = _clean_float(ss / (denom * 1.0));
    let sd = _clean_float(num_sqrt(_max_num(0.0, variance)));

    let cv_ratio = if num_abs(mean_v) > 1.0e-15 { _clean_float(sd / num_abs(mean_v)) } else { nil };
    let cv_pct = if cv_ratio != nil { _clean_float(cv_ratio * 100.0) } else { nil };
    let disp_D = if num_abs(mean_v) > 1.0e-15 { _clean_float(variance / mean_v) } else { nil };

    let zone_1sd = [_clean_float(mean_v - sd), _clean_float(mean_v + sd)];
    let zone_3sd = [_clean_float(mean_v - 3.0 * sd), _clean_float(mean_v + 3.0 * sd)];

    let rows = [];
    let dom_idx = 0;
    let dom_sq = -1.0;
    i = 0;
    while i < n {
        let xi = xs[i];
        let dev = devs[i];
        let sq = sq_devs[i];
        let share = if ss > 1.0e-15 { _clean_float((sq / ss) * 100.0) } else { 0.0 };
        let in_1sd = num_abs(dev) <= sd + 1.0e-12;
        let lbl = "x" + str(i + 1);
        if sq > dom_sq {
            dom_sq = sq;
            dom_idx = i;
        }
        let tip_el = "Η παρατήρηση " + lbl + " = " + _fmt_smart(xi, 4) +
            " απέχει " + _fmt_fixed(dev, 2) + " από τη μέση τιμή (" + _fmt_fixed(mean_v, 2) +
            ") και συνεισφέρει (xᵢ - x̄)² = " + _fmt_smart(sq, 4) +
            " (" + _fmt_fixed(share, 2) + "% του συνολικού SS).";
        push(rows, map{
            "label": lbl,
            "index": i + 1,
            "x": xi,
            "deviation": dev,
            "sq_deviation": sq,
            "share_of_ss_pct": share,
            "within_1sd": in_1sd,
            "tooltip_el": tip_el
        });
        i = i + 1;
    }

    let mean_sym = if sample_mode { "x̄" } else { "μ" };
    let var_sym = if sample_mode { "s²" } else { "σ²" };
    let sd_sym = if sample_mode { "s" } else { "σ" };

    let f_step1 = "Σxᵢ / " + str(n) + " = " + _fmt_smart(sum_x, 4) + " / " + str(n) + " = " + _fmt_fixed(mean_v, 2);
    let f_step2 = "Σ(xᵢ - " + mean_sym + ")² = " + sq_terms_txt + " = " + _fmt_smart(ss, 4);
    let f_step3 = if sample_mode {
        _fmt_smart(ss, 4) + " / (" + str(n) + " - 1) = " + _fmt_fixed(variance, 2)
    } else {
        _fmt_smart(ss, 4) + " / " + str(n) + " = " + _fmt_fixed(variance, 2)
    };
    let f_step4 = "√" + _fmt_fixed(variance, 2) + " = " + _fmt_fixed(sd, 4);
    let cv_text = if cv_pct != nil { _fmt_fixed(cv_pct, 2) + "%" } else { "Μη ορισμένο (x̄ = 0)" };

    let steps_cards = [
        map{
            "step": 1,
            "title_el": "Βήμα 1 - Μέση Τιμή (" + mean_sym + ")",
            "title_en": "Step 1 - Mean (" + mean_sym + ")",
            "formula": f_step1,
            "value": mean_v,
            "description_el": "Κέντρο βάρους των " + str(n) + " παρατηρήσεων (Σ(xᵢ - " + mean_sym + ") = 0).",
            "description_en": "Center of mass of the " + str(n) + " observations."
        },
        map{
            "step": 2,
            "title_el": "Βήμα 2 - Άθροισμα Τετραγώνων (SS)",
            "title_en": "Step 2 - Sum of Squares (SS)",
            "formula": f_step2,
            "value": ss,
            "description_el": "Άθροισμα τετραγωνικών αποκλίσεων από τη μέση τιμή ώστε να μην αλληλοαναιρούνται τα πρόσημα.",
            "description_en": "Sum of squared deviations from the mean preventing sign cancellation."
        },
        map{
            "step": 3,
            "title_el": "Βήμα 3 - Διακύμανση (" + var_sym + ")",
            "title_en": "Step 3 - Variance (" + var_sym + ")",
            "formula": f_step3,
            "value": variance,
            "description_el": if sample_mode {
                "Αμερόληπτη εκτίμηση διακύμανσης με διόρθωση Bessel (βαθμοί ελευθερίας n - 1 = " + str(denom) + ")."
            } else {
                "Διακύμανση πληθυσμού διαιρεμένη με N = " + str(denom) + "."
            },
            "description_en": if sample_mode {
                "Unbiased sample variance using Bessel's correction (df = n - 1 = " + str(denom) + ")."
            } else {
                "Population variance divided by N = " + str(denom) + "."
            }
        },
        map{
            "step": 4,
            "title_el": "Βήμα 4 - Τυπική Απόκλιση (" + sd_sym + ") & CV%",
            "title_en": "Step 4 - Standard Deviation (" + sd_sym + ") & CV%",
            "formula": f_step4,
            "cv_formula": if cv_pct != nil {
                "(" + _fmt_fixed(sd, 4) + " / |" + _fmt_fixed(mean_v, 2) + "|) × 100% = " + cv_text
            } else {
                cv_text
            },
            "value": sd,
            "cv_pct": cv_pct,
            "description_el": "Επιστροφή στις αρχικές μονάδες μέτρησης μέσω τετραγωνικής ρίζας και σχετική διασπορά CV = " + cv_text + ".",
            "description_en": "Square root restores original physical units; relative dispersion CV = " + cv_text + "."
        }
    ];

    let dom_row = rows[dom_idx];
    let outlier_el = "";
    let outlier_en = "";
    if ss <= 1.0e-15 {
        outlier_el = "Όλες οι παρατηρήσεις ταυτίζονται με τη μέση τιμή (" + _fmt_smart(mean_v, 4) + "), επομένως SS = 0 και η διασπορά είναι μηδενική.";
        outlier_en = "All observations equal the mean (" + _fmt_smart(mean_v, 4) + "), so SS = 0 and dispersion is zero.";
    } else {
        outlier_el = "Λόγω της ύψωσης στο τετράγωνο, η παρατήρηση " + dom_row["label"] + " = " + _fmt_smart(dom_row["x"], 4) +
            " (απόκλιση " + _fmt_smart(dom_row["deviation"], 4) + ") συνεισφέρει " + _fmt_smart(dom_row["sq_deviation"], 4) +
            " από το συνολικό SS = " + _fmt_smart(ss, 4) + ", δηλαδή το " + _fmt_fixed(dom_row["share_of_ss_pct"], 2) + "% της συνολικής διασποράς!";
        outlier_en = "Due to squaring, observation " + dom_row["label"] + " = " + _fmt_smart(dom_row["x"], 4) +
            " (deviation " + _fmt_smart(dom_row["deviation"], 4) + ") contributes " + _fmt_smart(dom_row["sq_deviation"], 4) +
            " out of SS = " + _fmt_smart(ss, 4) + " (" + _fmt_fixed(dom_row["share_of_ss_pct"], 2) + "% of total SS)!";
    }

    return map{
        "ok": true,
        "preset": parsed["preset"],
        "is_sample": sample_mode,
        "values": xs,
        "n": n,
        "sum_x": sum_x,
        "mean": mean_v,
        "ss": ss,
        "denom": denom,
        "variance": variance,
        "sd": sd,
        "cv_ratio": cv_ratio,
        "cv_pct": cv_pct,
        "index_of_dispersion": disp_D,
        "zone_1sd": zone_1sd,
        "zone_3sd": zone_3sd,
        "steps_cards": steps_cards,
        "deviation_table": map{
            "rows": rows,
            "totals": map{
                "sum_x": sum_x,
                "sum_dev": 0.0,
                "sum_sq": ss
            }
        },
        "dominant_observation": dom_row,
        "outlier_insight_el": outlier_el,
        "outlier_insight_en": outlier_en
    };
}

fn _classify_cv_status(cv_pct, threshold_pct) {
    if cv_pct == nil {
        return map{ "el": "Μη ορισμένο", "en": "Undefined" };
    }
    if cv_pct <= threshold_pct + 1.0e-12 {
        return map{ "el": "Ομοιογενές", "en": "Homogeneous" };
    }
    if cv_pct <= 25.0 + 1.0e-12 {
        return map{ "el": "Μέτρια μεταβλητότητα", "en": "Moderate variability" };
    }
    return map{ "el": "Ανομοιογενές", "en": "Heterogeneous" };
}

fn cv_comparison_explorer(mean_a = 50.0, sd_a = 5.0, mean_b = 200.0, sd_b = 15.0, homogeneity_threshold_pct = 10.0) {
    let ma = mean_a * 1.0;
    let sa = sd_a * 1.0;
    let mb = mean_b * 1.0;
    let sb = sd_b * 1.0;
    let thresh = homogeneity_threshold_pct * 1.0;

    if not _is_finite(ma) or not _is_finite(sa) or not _is_finite(mb) or not _is_finite(sb) or not _is_finite(thresh) {
        throw "cv_comparison_explorer: all inputs must be finite numbers";
    }
    if sa < 0.0 or sb < 0.0 {
        throw "cv_comparison_explorer: standard deviations sd_a and sd_b must be >= 0";
    }
    if thresh <= 0.0 {
        throw "cv_comparison_explorer: homogeneity_threshold_pct must be > 0";
    }

    let cv_a_ratio = if num_abs(ma) > 1.0e-15 { _clean_float(sa / num_abs(ma)) } else { nil };
    let cv_a_pct = if cv_a_ratio != nil { _clean_float(cv_a_ratio * 100.0) } else { nil };
    let cv_b_ratio = if num_abs(mb) > 1.0e-15 { _clean_float(sb / num_abs(mb)) } else { nil };
    let cv_b_pct = if cv_b_ratio != nil { _clean_float(cv_b_ratio * 100.0) } else { nil };

    let st_a = _classify_cv_status(cv_a_pct, thresh);
    let st_b = _classify_cv_status(cv_b_pct, thresh);

    let r3_a = [_clean_float(ma - 3.0 * sa), _clean_float(ma + 3.0 * sa)];
    let r3_b = [_clean_float(mb - 3.0 * sb), _clean_float(mb + 3.0 * sb)];

    let x_lo = _min_num(r3_a[0], r3_b[0]);
    let x_hi = _max_num(r3_a[1], r3_b[1]);
    if x_hi - x_lo < 1.0e-9 {
        x_lo = x_lo - 1.0;
        x_hi = x_hi + 1.0;
    }

    // Build grid merging uniform samples with exact Gaussian peaks & inflection points
    let raw_xs = [];
    let n_grid = 121;
    let gi = 0;
    while gi < n_grid {
        let xv = x_lo + ((x_hi - x_lo) * gi) / ((n_grid - 1) * 1.0);
        push(raw_xs, xv);
        gi = gi + 1;
    }
    let landmarks = [ma, ma - sa, ma + sa, mb, mb - sb, mb + sb];
    let li = 0;
    while li < len(landmarks) {
        push(raw_xs, landmarks[li]);
        li = li + 1;
    }
    let sorted_xs = _sort_numbers(raw_xs);
    let xs = [];
    let si = 0;
    while si < len(sorted_xs) {
        let xv = _clean_float(sorted_xs[si]);
        if len(xs) == 0 or num_abs(xv - xs[len(xs) - 1]) > 1.0e-9 {
            push(xs, xv);
        }
        si = si + 1;
    }

    let bell_a = [];
    let bell_b = [];
    let pdf_a = [];
    let pdf_b = [];
    let k = 0;
    while k < len(xs) {
        let xv = xs[k];
        if sa > 1.0e-15 {
            let za = (xv - ma) / sa;
            let ba = num_exp(-0.5 * za * za);
            push(bell_a, _clean_float(ba));
            push(pdf_a, _clean_float(ba / (sa * _SQRT_2PI)));
        } else {
            let ba = if num_abs(xv - ma) < 1.0e-9 { 1.0 } else { 0.0 };
            push(bell_a, ba);
            push(pdf_a, ba);
        }

        if sb > 1.0e-15 {
            let zb = (xv - mb) / sb;
            let bb = num_exp(-0.5 * zb * zb);
            push(bell_b, _clean_float(bb));
            push(pdf_b, _clean_float(bb / (sb * _SQRT_2PI)));
        } else {
            let bb = if num_abs(xv - mb) < 1.0e-9 { 1.0 } else { 0.0 };
            push(bell_b, bb);
            push(pdf_b, bb);
        }
        k = k + 1;
    }

    let infl_h = _clean_float(num_exp(-0.5));
    let infl_a = [
        [_clean_float(ma - sa), infl_h],
        [_clean_float(ma + sa), infl_h]
    ];
    let infl_b = [
        [_clean_float(mb - sb), infl_h],
        [_clean_float(mb + sb), infl_h]
    ];

    let comp_bars = [
        map{
            "label_el": "Ενεργό Δείγμα Α",
            "label_en": "Active Sample A",
            "value_pct": cv_a_pct,
            "status_el": st_a["el"],
            "status_en": st_a["en"]
        },
        map{
            "label_el": "Όριο Ομοιογένειας",
            "label_en": "Homogeneity Threshold",
            "value_pct": _clean_float(thresh),
            "status_el": "Όριο αναφοράς",
            "status_en": "Reference threshold"
        },
        map{
            "label_el": "Σύνολο Αναφοράς Β",
            "label_en": "Reference Set B",
            "value_pct": cv_b_pct,
            "status_el": st_b["el"],
            "status_en": st_b["en"]
        }
    ];

    let more_homog = "equal";
    if cv_a_pct != nil and cv_b_pct != nil {
        if cv_a_pct < cv_b_pct - 1.0e-12 { more_homog = "A"; }
        else if cv_b_pct < cv_a_pct - 1.0e-12 { more_homog = "B"; }
    }

    let insight_el = "Σύγκριση σχετικής διασποράς: Δείγμα Α (CV = " +
        (if cv_a_pct != nil { _fmt_fixed(cv_a_pct, 2) + "%" } else { "N/A" }) + ", " + st_a["el"] +
        ") έναντι Συνόλου Β (CV = " +
        (if cv_b_pct != nil { _fmt_fixed(cv_b_pct, 2) + "%" } else { "N/A" }) + ", " + st_b["el"] + ").";

    return map{
        "ok": true,
        "mean_a": _clean_float(ma),
        "sd_a": _clean_float(sa),
        "mean_b": _clean_float(mb),
        "sd_b": _clean_float(sb),
        "homogeneity_threshold_pct": _clean_float(thresh),
        "cv_a_ratio": cv_a_ratio,
        "cv_a_pct": cv_a_pct,
        "cv_b_ratio": cv_b_ratio,
        "cv_b_pct": cv_b_pct,
        "status_a_el": st_a["el"],
        "status_a_en": st_a["en"],
        "status_b_el": st_b["el"],
        "status_b_en": st_b["en"],
        "badge_a_el": st_a["el"],
        "badge_b_el": st_b["el"],
        "more_homogeneous": more_homog,
        "range_3sd_a": r3_a,
        "range_3sd_b": r3_b,
        "xs": xs,
        "bell_a": bell_a,
        "bell_b": bell_b,
        "pdf_a": pdf_a,
        "pdf_b": pdf_b,
        "inflection_points_a": infl_a,
        "inflection_points_b": infl_b,
        "comparison_bars": comp_bars,
        "insight_el": insight_el
    };
}

fn scale_invariance_explorer(base_mean = 8.0, base_var = 7.5, scale_k = 1.0) {
    let m0 = base_mean * 1.0;
    let v0 = base_var * 1.0;
    let k = scale_k * 1.0;

    if not _is_finite(m0) or not _is_finite(v0) or not _is_finite(k) {
        throw "scale_invariance_explorer: base_mean, base_var, and scale_k must be finite numbers";
    }
    if v0 < 0.0 {
        throw "scale_invariance_explorer: base_var must be >= 0";
    }
    if num_abs(k) <= 1.0e-15 {
        throw "scale_invariance_explorer: scale_k must be non-zero (k != 0)";
    }
    if num_abs(m0) <= 1.0e-15 {
        throw "scale_invariance_explorer: base_mean must be non-zero to compare CV, CV^2, and D";
    }

    let s0 = _clean_float(num_sqrt(v0));
    let mk = _clean_float(k * m0);
    let vk = _clean_float((k * k) * v0);
    let sk = _clean_float(num_abs(k) * s0);

    let cv_before = _clean_float(s0 / num_abs(m0));
    let cv_after = _clean_float(sk / num_abs(mk));

    let cv_sq_before = _clean_float(v0 / (m0 * m0));
    let cv_sq_after = _clean_float(vk / (mk * mk));

    let d_before = _clean_float(v0 / m0);
    let d_after = _clean_float(vk / mk);

    let cv_entry = map{
        "name": "CV",
        "formula": "s_k / |x̄_k|",
        "before": cv_before,
        "after": cv_after,
        "before_pct": _clean_float(cv_before * 100.0),
        "after_pct": _clean_float(cv_after * 100.0),
        "badge_el": "Αδιάστατο (Ανεξάρτητο μονάδων)",
        "badge_en": "Dimensionless (Unit-independent)",
        "unit_independent": true,
        "scale_factor_applied": 1.0
    };

    let cv_sq_entry = map{
        "name": "CV²",
        "formula": "s_k² / x̄_k²",
        "before": cv_sq_before,
        "after": cv_sq_after,
        "badge_el": "Αδιάστατο (Ανεξάρτητο μονάδων)",
        "badge_en": "Dimensionless (Unit-independent)",
        "unit_independent": true,
        "scale_factor_applied": 1.0
    };

    let d_entry = map{
        "name": "D",
        "formula": "s_k² / x̄_k",
        "before": d_before,
        "after": d_after,
        "badge_el": "Εξαρτώμενο από τις μονάδες",
        "badge_en": "Unit-dependent",
        "unit_independent": false,
        "scale_factor_applied": _clean_float(k)
    };

    let expl_el = "Υπό αλλαγή μονάδων μέτρησης X_k = k·X (με k = " + _fmt_smart(k, 4) +
        "), η μέση τιμή κλιμακώνεται γραμμικά (x̄_k = k·x̄), ενώ η διακύμανση κλιμακώνεται τετραγωνικά (s_k² = k²·s²). " +
        "Αν αντικαταστήσουμε την τυπική απόκλιση s με τη διακύμανση s² στον αριθμητή χωρίς να υψώσουμε στο τετράγωνο τον παρονομαστή, " +
        "προκύπτει ο Δείκτης Διασποράς D_k = s_k² / x̄_k = (k²·s²) / (k·x̄) = k·D, ο οποίος διατηρεί μονάδες μέτρησης και πολλαπλασιάζεται επί k! " +
        "Αντίθετα, τόσο ο Συντελεστής Μεταβλητότητας CV = |k|·s / (|k|·|x̄|) = s / |x̄| όσο και το τετράγωνό του CV² = (k²·s²) / (k²·x̄²) = s² / x̄² " +
        "απλοποιούν πλήρως τον παράγοντα k και παραμένουν γνήσια αδιάστατα μεγέθη.";

    let expl_en = "Under unit scaling X_k = k*X (k = " + _fmt_smart(k, 4) +
        "), the mean scales linearly (k*x̄) while variance scales quadratically (k²*s²). " +
        "Replacing s with s² in the numerator without squaring the denominator yields the unit-dependent Index of Dispersion " +
        "D_k = s_k² / x̄_k = k * (s² / x̄), whereas both CV = s / |x̄| and CV² = s² / x̄² cancel k completely and remain dimensionless.";

    return map{
        "ok": true,
        "scale_k": _clean_float(k),
        "base_mean": _clean_float(m0),
        "base_var": _clean_float(v0),
        "base_sd": s0,
        "scaled_mean": mk,
        "scaled_var": vk,
        "scaled_sd": sk,
        "cv": cv_entry,
        "cv_sq": cv_sq_entry,
        "dispersion_index_D": d_entry,
        "indices": map{
            "cv": cv_entry,
            "cv_sq": cv_sq_entry,
            "dispersion_index_D": d_entry
        },
        "explanation_el": expl_el,
        "explanation_en": expl_en
    };
}

fn _scale_vars_map(env_m, factor) {
    let out = map{};
    let ks = map_keys(env_m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = env_m[k] * factor;
        i = i + 1;
    }
    return out;
}

fn _shift_vars_map(env_m, delta) {
    let out = map{};
    let ks = map_keys(env_m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = env_m[k] + delta;
        i = i + 1;
    }
    return out;
}

fn formula_invariance_probe(expr, base_vars, scale_k = 10.0, shift_c = 5.0) {
    let ast = CAS.parse_math(expr);
    let k_req = scale_k * 1.0;
    let c_req = shift_c * 1.0;
    if not _is_finite(k_req) or num_abs(k_req) <= 1.0e-15 {
        throw "formula_invariance_probe: scale_k must be a finite non-zero number";
    }
    if not _is_finite(c_req) {
        throw "formula_invariance_probe: shift_c must be a finite number";
    }

    let env_base = map{};
    if base_vars != nil and type(base_vars) == "map" {
        let ks = map_keys(base_vars);
        let i = 0;
        while i < len(ks) {
            let kn = ks[i];
            env_base[kn] = base_vars[kn] * 1.0;
            i = i + 1;
        }
    }
    let fvs = CAS.free_vars(ast);
    let fi = 0;
    while fi < len(fvs) {
        let vn = fvs[fi];
        if not map_has(env_base, vn) {
            env_base[vn] = 2.3 + 1.4 * fi;
        }
        fi = fi + 1;
    }

    let f0 = CAS.eval_ast(ast, env_base);
    let fk_req = CAS.eval_ast(ast, _scale_vars_map(env_base, k_req));
    let fc_req = CAS.eval_ast(ast, _shift_vars_map(env_base, c_req));

    // Probe positive homogeneity f(k*x) = k^p * f(x) across TWO distinct positive k values!
    let probe_env = _copy_map(env_base);
    let f_probe0 = f0;
    if f_probe0 != nil and num_abs(f_probe0) <= 1.0e-13 and len(fvs) > 0 {
        // Perturb slightly if base point happens to lie on a nodal zero (e.g. x - y at x == y)
        probe_env[fvs[0]] = probe_env[fvs[0]] + 0.37;
        f_probe0 = CAS.eval_ast(ast, probe_env);
    }

    let k1 = if k_req > 0.0 and num_abs(k_req - 1.0) > 0.05 { k_req } else { 2.5 };
    let k2 = if num_abs(k1 - 3.5) > 0.4 { 3.5 } else { 7.0 };

    let fk1 = CAS.eval_ast(ast, _scale_vars_map(probe_env, k1));
    let fk2 = CAS.eval_ast(ast, _scale_vars_map(probe_env, k2));

    let is_homog = false;
    let homog_deg = nil;

    if f_probe0 != nil and fk1 != nil and fk2 != nil and _is_finite(f_probe0) and _is_finite(fk1) and _is_finite(fk2) {
        if num_abs(f_probe0) <= 1.0e-13 and num_abs(fk1) <= 1.0e-13 and num_abs(fk2) <= 1.0e-13 {
            is_homog = true;
            homog_deg = 0.0;
        } else if num_abs(f_probe0) > 1.0e-13 {
            let r1 = fk1 / f_probe0;
            let r2 = fk2 / f_probe0;
            if r1 > 0.0 and r2 > 0.0 {
                let p1 = num_ln(r1) / num_ln(k1);
                let p2 = num_ln(r2) / num_ln(k2);
                if num_abs(p1 - p2) <= 1.0e-6 * (1.0 + num_abs(p1)) {
                    let p_avg = 0.5 * (p1 + p2);
                    // Snap clean integer or half-integer homogeneity degrees
                    let p_half = num_round(p_avg * 2.0) / 2.0;
                    if num_abs(p_avg - p_half) < 1.0e-7 {
                        p_avg = p_half;
                    } else {
                        p_avg = _clean_float(p_avg);
                    }
                    let chk1 = num_pow(k1, p_avg) * f_probe0;
                    let chk2 = num_pow(k2, p_avg) * f_probe0;
                    if num_abs(fk1 - chk1) <= 1.0e-6 * (1.0 + num_abs(fk1)) and num_abs(fk2 - chk2) <= 1.0e-6 * (1.0 + num_abs(fk2)) {
                        is_homog = true;
                        homog_deg = _clean_float(p_avg);
                    }
                }
            }
        }
    }

    let scale_inv = false;
    if f0 != nil and fk_req != nil and _is_finite(f0) and _is_finite(fk_req) {
        let match_req = num_abs(fk_req - f0) <= 1.0e-7 * (1.0 + num_abs(f0));
        if match_req and is_homog and homog_deg != nil and num_abs(homog_deg) <= 1.0e-9 {
            scale_inv = true;
            homog_deg = 0.0;
        }
    }

    // Verify translation invariance f(x + c) = f(x) across two distinct shifts
    let c1 = if num_abs(c_req) > 1.0e-9 { c_req } else { 5.0 };
    let c2 = c1 * 1.73 + 1.19;
    let fc1 = CAS.eval_ast(ast, _shift_vars_map(probe_env, c1));
    let fc2 = CAS.eval_ast(ast, _shift_vars_map(probe_env, c2));

    let shift_inv = false;
    if f_probe0 != nil and fc1 != nil and fc2 != nil and _is_finite(f_probe0) and _is_finite(fc1) and _is_finite(fc2) {
        let tol_s = 1.0e-7 * (1.0 + num_abs(f_probe0));
        if num_abs(fc1 - f_probe0) <= tol_s and num_abs(fc2 - f_probe0) <= tol_s {
            if f0 != nil and fc_req != nil and num_abs(fc_req - f0) <= 1.0e-7 * (1.0 + num_abs(f0)) {
                shift_inv = true;
            }
        }
    }

    let cls_el = "Εξαρτώμενο από κλίμακα και μετατόπιση";
    let cls_en = "Scale- and shift-dependent";
    if scale_inv and shift_inv {
        cls_el = "Πλήρως αναλλοίωτο ως προς κλίμακα και μετατόπιση (Αφινικά αναλλοίωτο)";
        cls_en = "Scale- and shift-invariant (Affine invariant)";
    } else if scale_inv {
        cls_el = "Αναλλοίωτο κλίμακας / Αδιάστατο (ομογενές βαθμού p = 0)";
        cls_en = "Scale-invariant / Dimensionless (homogeneous of degree p = 0)";
    } else if shift_inv and is_homog {
        cls_el = "Αναλλοίωτο μετατόπισης & ομογενές βαθμού p = " + _fmt_smart(homog_deg, 4);
        cls_en = "Shift-invariant & homogeneous of degree p = " + _fmt_smart(homog_deg, 4);
    } else if shift_inv {
        cls_el = "Αναλλοίωτο μετατόπισης (εξαρτώμενο από την κλίμακα)";
        cls_en = "Shift-invariant (scale-dependent)";
    } else if is_homog {
        cls_el = "Ομογενής συνάρτηση βαθμού p = " + _fmt_smart(homog_deg, 4) + " (f(kx) = k^p·f(x))";
        cls_en = "Homogeneous of degree p = " + _fmt_smart(homog_deg, 4) + " (f(kx) = k^p*f(x))";
    }

    return map{
        "ok": true,
        "expr": str(expr),
        "ascii": CAS.to_ascii(ast),
        "latex": CAS.to_latex(ast),
        "base_vars": _copy_map(env_base),
        "base_value": if f0 != nil and _is_finite(f0) { _clean_float(f0) } else { nil },
        "scale_k": _clean_float(k_req),
        "scaled_value": if fk_req != nil and _is_finite(fk_req) { _clean_float(fk_req) } else { nil },
        "scale_invariant": scale_inv,
        "is_homogeneous": is_homog,
        "homogeneity_degree": homog_deg,
        "shift_c": _clean_float(c_req),
        "shifted_value": if fc_req != nil and _is_finite(fc_req) { _clean_float(fc_req) } else { nil },
        "shift_invariant": shift_inv,
        "affine_invariant": scale_inv and shift_inv,
        "verified_scales": [_clean_float(k1), _clean_float(k2)],
        "classification_el": cls_el,
        "classification_en": cls_en
    };
}

export LAB_VERSION;
export sparkline_unicode;
export create_lab;
export stddev_explorer, cv_comparison_explorer, scale_invariance_explorer, formula_invariance_probe;
