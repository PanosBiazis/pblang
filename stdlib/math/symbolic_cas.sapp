// stdlib/math/symbolic_cas.sapp
// Pure PBLang Symbolic Computer Algebra System (CAS), Step-by-Step Algebraic
// Transformer, Universal Equation/Inequality/System Solver & Vector SVG Plotter.
//
// Self-contained zero-dependency stdlib module with strict DoS bounds for safe
// untrusted formula evaluation in interactive, educational, and web applications.
//
// Import:
//   let cas = import("stdlib:math/symbolic_cas.sapp");
//   let node = cas.parse_math("2x² - 5x + 3 <= 0");
//   let tr   = cas.transform("(x^2 - 1)/(x - 1)", "simplify");
//   let sol  = cas.solve("(x^2 - 4)/(x - 1) >= 0");
//   let svg  = cas.plot_svg("1/(x - 1)", -6, 6);

// ── Adaptive Resource Governor & Legacy Exported Constants ────────────────────

let GOV = import("stdlib:math/resource_governor.sapp");
let CAS_VERSION = "2.7.0";
let MAX_INPUT_LEN = 8192;
let MAX_AST_DEPTH = 128;
let MAX_AST_NODES = 4096;
let MAX_REWRITE_STEPS = 512;
let MAX_EXPAND_DEGREE = 64;

let _PI_VAL = 3.141592653589793;
let _E_VAL = 2.718281828459045;
let _BI_ZERO = bigint(0);
let _BI_ONE = bigint(1);
let _BI_NEG_ONE = bigint(-1);
let _BI_TWO = bigint(2);
let _BI_TEN = bigint(10);

let _USER_FUNCS = map{};
let _EVAL_CALL_DEPTH = 0;
let _DIFF_CALL_DEPTH = 0;

// ── Numeric & BigInt Helpers ──────────────────────────────────────────────────

fn is_finite_num(v) {
    if type(v) != "number" { return false; }
    if not (v == v) { return false; }
    return (v - v) == 0;
}

fn _min_num(a, b) {
    if a < b { return a; }
    return b;
}

fn _max_num(a, b) {
    if a > b { return a; }
    return b;
}

fn _clamp_num(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _env1(k, v) {
    let m = map{};
    m[k] = v;
    return m;
}

fn to_bi(x) {
    let tx = type(x);
    if tx == "bigint" { return x; }
    if tx == "number" { return bigint(num_round(x)); }
    if tx == "string" { return bigint(x); }
    return _BI_ZERO;
}

fn bi_abs(a) {
    if a < _BI_ZERO { return _BI_ZERO - a; }
    return a;
}

fn bi_mod(a, b) {
    let q = a / b;
    return a - q * b;
}

fn bi_gcd(a, b) {
    let x = bi_abs(a);
    let y = bi_abs(b);
    let guard = 0;
    while y != _BI_ZERO and guard < 1024 {
        let r = bi_mod(x, y);
        x = y;
        y = r;
        guard = guard + 1;
    }
    if x == _BI_ZERO { return _BI_ONE; }
    return x;
}

fn bi_lcm(a, b) {
    let xa = bi_abs(a);
    let xb = bi_abs(b);
    if xa == _BI_ZERO or xb == _BI_ZERO { return _BI_ZERO; }
    return (xa / bi_gcd(xa, xb)) * xb;
}

fn bi_pow(base_bi, exp_int) {
    if exp_int <= 0 { return _BI_ONE; }
    let res = _BI_ONE;
    let b = base_bi;
    let e = exp_int;
    let guard = 0;
    while e > 0 and guard < 256 {
        let half = num_floor(e / 2);
        if e - half * 2 == 1 {
            res = res * b;
        }
        e = half;
        if e > 0 { b = b * b; }
        guard = guard + 1;
    }
    return res;
}

fn bi_to_float(b) {
    let v = parse_number(str(b));
    if v == nil { return 0.0; }
    return v;
}

// Exact integer square root floor(sqrt(n)) for n >= 0 using Newton's method.
fn bi_isqrt(n) {
    if n <= _BI_ZERO { return _BI_ZERO; }
    if n == _BI_ONE { return _BI_ONE; }
    let x = n;
    let y = (x + _BI_ONE) / _BI_TWO;
    let guard = 0;
    while y < x and guard < 512 {
        x = y;
        y = (x + n / x) / _BI_TWO;
        guard = guard + 1;
    }
    return x;
}

// Factor positive integer n = s^2 * rem where rem is as square-free as practical.
// Returns [s_bi, rem_bi].
fn bi_square_split(n) {
    if n <= _BI_ZERO { return [_BI_ZERO, _BI_ZERO]; }
    let r0 = bi_isqrt(n);
    if r0 * r0 == n { return [r0, _BI_ONE]; }
    let s = _BI_ONE;
    let rem = n;
    // Extract factor 2
    while bi_mod(rem, bigint(4)) == _BI_ZERO {
        s = s * _BI_TWO;
        rem = rem / bigint(4);
    }
    let d = bigint(3);
    let max_d = bigint(10000);
    let guard = 0;
    while d * d <= rem and d <= max_d and guard < 5005 {
        let d2 = d * d;
        while bi_mod(rem, d2) == _BI_ZERO {
            s = s * d;
            rem = rem / d2;
        }
        d = d + _BI_TWO;
        guard = guard + 1;
    }
    let r_tail = bi_isqrt(rem);
    if r_tail > _BI_ONE and r_tail * r_tail == rem {
        s = s * r_tail;
        rem = _BI_ONE;
    }
    return [s, rem];
}

// Positive integer divisors of |n| (bounded for DoS safety).
fn bi_divisors(n) {
    let m = bi_abs(n);
    if m == _BI_ZERO { return [_BI_ONE]; }
    let small = [];
    let large = [];
    let d = _BI_ONE;
    let max_iter = 2048;
    let steps = 0;
    while d * d <= m and steps < max_iter {
        if bi_mod(m, d) == _BI_ZERO {
            push(small, d);
            let q = m / d;
            if q != d {
                push(large, q);
            }
        }
        d = d + _BI_ONE;
        steps = steps + 1;
    }
    let i = len(large) - 1;
    while i >= 0 {
        push(small, large[i]);
        i = i - 1;
    }
    return small;
}

// ── Exact Rational Arithmetic Q = { kind: "rat", p: bigint, q: bigint } ───────

fn rat(p, q = 1) {
    let bp = to_bi(p);
    let bq = to_bi(q);
    if bq == _BI_ZERO {
        throw "CAS division by zero in rational number";
    }
    if bp == _BI_ZERO {
        return map{ "kind": "rat", "p": _BI_ZERO, "q": _BI_ONE };
    }
    if bq < _BI_ZERO {
        bp = _BI_ZERO - bp;
        bq = _BI_ZERO - bq;
    }
    let g = bi_gcd(bp, bq);
    if g > _BI_ONE {
        bp = bp / g;
        bq = bq / g;
    }
    return map{ "kind": "rat", "p": bp, "q": bq };
}

let RAT_ZERO = rat(0, 1);
let RAT_ONE = rat(1, 1);
let RAT_NEG_ONE = rat(-1, 1);
let RAT_TWO = rat(2, 1);
let RAT_HALF = rat(1, 2);

fn is_rat(node) {
    return type(node) == "map" and map_has(node, "kind") and node["kind"] == "rat";
}

fn rat_is_zero(r) { return r["p"] == _BI_ZERO; }
fn rat_is_one(r) { return r["p"] == _BI_ONE and r["q"] == _BI_ONE; }
fn rat_is_neg_one(r) { return r["p"] == _BI_NEG_ONE and r["q"] == _BI_ONE; }
fn rat_is_int(r) { return r["q"] == _BI_ONE; }
fn rat_is_neg(r) { return r["p"] < _BI_ZERO; }
fn rat_is_pos(r) { return r["p"] > _BI_ZERO; }

fn rat_neg(a) {
    return map{ "kind": "rat", "p": _BI_ZERO - a["p"], "q": a["q"] };
}

fn rat_abs(a) {
    if a["p"] < _BI_ZERO { return rat_neg(a); }
    return a;
}

fn rat_add(a, b) {
    if a["p"] == _BI_ZERO { return b; }
    if b["p"] == _BI_ZERO { return a; }
    if a["q"] == b["q"] {
        return rat(a["p"] + b["p"], a["q"]);
    }
    return rat(a["p"] * b["q"] + b["p"] * a["q"], a["q"] * b["q"]);
}

fn rat_sub(a, b) {
    if b["p"] == _BI_ZERO { return a; }
    if a["p"] == _BI_ZERO { return rat_neg(b); }
    if a["q"] == b["q"] {
        return rat(a["p"] - b["p"], a["q"]);
    }
    return rat(a["p"] * b["q"] - b["p"] * a["q"], a["q"] * b["q"]);
}

fn rat_mul(a, b) {
    if a["p"] == _BI_ZERO or b["p"] == _BI_ZERO { return RAT_ZERO; }
    return rat(a["p"] * b["p"], a["q"] * b["q"]);
}

fn rat_div(a, b) {
    if b["p"] == _BI_ZERO { throw "CAS division by zero"; }
    if a["p"] == _BI_ZERO { return RAT_ZERO; }
    return rat(a["p"] * b["q"], a["q"] * b["p"]);
}

fn rat_cmp(a, b) {
    let lhs = a["p"] * b["q"];
    let rhs = b["p"] * a["q"];
    if lhs < rhs { return -1; }
    if lhs > rhs { return 1; }
    return 0;
}

fn rat_eq(a, b) {
    return a["p"] == b["p"] and a["q"] == b["q"];
}

fn rat_pow_int(a, exp_int) {
    if exp_int == 0 { return RAT_ONE; }
    if a["p"] == _BI_ZERO {
        if exp_int < 0 { throw "CAS division by zero: 0 to negative power"; }
        return RAT_ZERO;
    }
    if exp_int > 0 {
        return rat(bi_pow(a["p"], exp_int), bi_pow(a["q"], exp_int));
    }
    let pos_e = 0 - exp_int;
    return rat(bi_pow(a["q"], pos_e), bi_pow(a["p"], pos_e));
}

fn rat_to_float(r) {
    let fp = bi_to_float(r["p"]);
    let fq = bi_to_float(r["q"]);
    if fq == 0 { return 0.0; }
    return fp / fq;
}

fn rat_to_str(r) {
    if r["q"] == _BI_ONE { return str(r["p"]); }
    return str(r["p"]) + "/" + str(r["q"]);
}

// Convert clean decimal or integer string to exact rational, or num float fallback.
fn parse_numeric_literal(tok) {
    let s = str_trim(tok);
    if str_contains(s, "e") or str_contains(s, "E") {
        let fv = parse_number(s);
        if fv == nil { throw "Invalid numeric literal: " + s; }
        return map{ "kind": "num", "val": fv };
    }
    let dot_idx = str_index_of(s, ".");
    if dot_idx < 0 {
        return rat(bigint(s), _BI_ONE);
    }
    let int_part = str_slice(s, 0, dot_idx);
    let frac_part = str_slice(s, dot_idx + 1, len(s));
    if len(frac_part) > 15 {
        let fv2 = parse_number(s);
        if fv2 == nil { throw "Invalid numeric literal: " + s; }
        return map{ "kind": "num", "val": fv2 };
    }
    let sign_bi = _BI_ONE;
    if str_starts_with(int_part, "-") {
        sign_bi = _BI_NEG_ONE;
        int_part = str_slice(int_part, 1, len(int_part));
    } else {
        if str_starts_with(int_part, "+") {
            int_part = str_slice(int_part, 1, len(int_part));
        }
    }
    if int_part == "" { int_part = "0"; }
    if frac_part == "" { frac_part = "0"; }
    let digits = int_part + frac_part;
    let den = bi_pow(_BI_TEN, len(frac_part));
    return rat(sign_bi * bigint(digits), den);
}

// Continued-fraction snap of float to small-denominator rational if within tol.
fn float_snap_rat(x, max_den = 10000, tol = 0.0000000001) {
    if not is_finite_num(x) { return nil; }
    let rx = num_round(x);
    if num_abs(x - rx) <= tol and num_abs(rx) < 1000000000 {
        return rat(rx, 1);
    }
    let sgn = 1;
    let ax = x;
    if ax < 0 { sgn = -1; ax = 0 - ax; }
    let p0 = 0; let q0 = 1;
    let p1 = 1; let q1 = 0;
    let rem = ax;
    let iter = 0;
    while iter < 24 {
        let a = num_floor(rem);
        let p2 = a * p1 + p0;
        let q2 = a * q1 + q0;
        if q2 > max_den { break; }
        p0 = p1; q0 = q1;
        p1 = p2; q1 = q2;
        if q1 > 0 and num_abs(ax - (p1 / q1)) <= tol {
            return rat(sgn * p1, q1);
        }
        let frac = rem - a;
        if frac <= 0.000000000001 { break; }
        rem = 1.0 / frac;
        iter = iter + 1;
    }
    return nil;
}

// Clean float string formatting without noisy trailing float artifacts.
fn fmt_float(v, digits = 10) {
    if not is_finite_num(v) { return str(v); }
    if num_abs(v) < 0.0000000000005 { return "0"; }
    let r_int = num_round(v);
    if num_abs(v - r_int) < 0.00000000001 and num_abs(r_int) < 1000000000000 {
        return str(r_int);
    }
    let scale = 10 ** digits;
    let rounded = num_round(v * scale) / scale;
    let s = str(rounded);
    return s;
}

// ── AST Constructors & Structural Inspection ──────────────────────────────────

fn ast_num(v) {
    if type(v) == "bigint" { return rat(v, _BI_ONE); }
    if type(v) == "number" {
        let r = num_round(v);
        if is_finite_num(v) and v == r and num_abs(v) < 9007199254740991 {
            return rat(r, 1);
        }
        return map{ "kind": "num", "val": v };
    }
    return RAT_ZERO;
}

fn ast_sym(name) { return map{ "kind": "sym", "name": name }; }
fn ast_neg(arg) { return map{ "kind": "neg", "arg": arg }; }
fn ast_add(args) {
    if len(args) == 0 { return RAT_ZERO; }
    if len(args) == 1 { return args[0]; }
    return map{ "kind": "add", "args": args };
}
fn ast_sub(lhs, rhs) { return map{ "kind": "sub", "left": lhs, "right": rhs }; }
fn ast_mul(args) {
    if len(args) == 0 { return RAT_ONE; }
    if len(args) == 1 { return args[0]; }
    return map{ "kind": "mul", "args": args };
}
fn ast_div(num_node, den_node) { return map{ "kind": "div", "num": num_node, "den": den_node }; }
fn ast_pow(base_node, exp_node) { return map{ "kind": "pow", "base": base_node, "exp": exp_node }; }
fn ast_call(fn_name, args) { return map{ "kind": "call", "fn_name": fn_name, "args": args }; }
fn ast_rel(op, lhs, rhs) { return map{ "kind": "rel", "op": op, "lhs": lhs, "rhs": rhs }; }

fn is_zero_node(n) {
    if n == nil or type(n) != "map" { return false; }
    if n["kind"] == "rat" { return n["p"] == _BI_ZERO; }
    if n["kind"] == "num" { return n["val"] == 0; }
    return false;
}

fn is_one_node(n) {
    if n == nil or type(n) != "map" { return false; }
    if n["kind"] == "rat" { return n["p"] == _BI_ONE and n["q"] == _BI_ONE; }
    if n["kind"] == "num" { return n["val"] == 1; }
    return false;
}

fn is_neg_one_node(n) {
    if n == nil or type(n) != "map" { return false; }
    if n["kind"] == "rat" { return n["p"] == _BI_NEG_ONE and n["q"] == _BI_ONE; }
    if n["kind"] == "num" { return n["val"] == -1; }
    return false;
}

fn is_int_node(n) {
    return n != nil and type(n) == "map" and n["kind"] == "rat" and n["q"] == _BI_ONE;
}

fn int_val_of(n) {
    return num_round(bi_to_float(n["p"]));
}

// Enforce adaptive max_ast_depth and max_ast_nodes on any AST node.
fn _measure_ast(node, depth, state) {
    if depth > state["lim_depth"] {
        throw "MathGovernor[symbolic_cas]: resource budget exceeded (AST depth > " + str(state["lim_depth"]) + ")";
    }
    state["count"] = state["count"] + 1;
    if state["count"] > state["lim_nodes"] {
        throw "MathGovernor[symbolic_cas]: resource budget exceeded (AST node count > " + str(state["lim_nodes"]) + ")";
    }
    if depth > state["max_depth"] { state["max_depth"] = depth; }
    if node == nil or type(node) != "map" or not map_has(node, "kind") {
        return;
    }
    let k = node["kind"];
    if k == "neg" {
        _measure_ast(node["arg"], depth + 1, state);
    } else if k == "sub" {
        _measure_ast(node["left"], depth + 1, state);
        _measure_ast(node["right"], depth + 1, state);
    } else if k == "div" {
        _measure_ast(node["num"], depth + 1, state);
        _measure_ast(node["den"], depth + 1, state);
    } else if k == "pow" {
        _measure_ast(node["base"], depth + 1, state);
        _measure_ast(node["exp"], depth + 1, state);
    } else if k == "add" or k == "mul" or k == "call" {
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            _measure_ast(arr[i], depth + 1, state);
            i = i + 1;
        }
    } else if k == "rel" {
        _measure_ast(node["lhs"], depth + 1, state);
        _measure_ast(node["rhs"], depth + 1, state);
    } else if k == "chain_rel" {
        let pts = node["parts"];
        let i = 0;
        while i < len(pts) {
            _measure_ast(pts[i], depth + 1, state);
            i = i + 1;
        }
    } else if k == "system" {
        let items = node["items"];
        let i = 0;
        while i < len(items) {
            _measure_ast(items[i], depth + 1, state);
            i = i + 1;
        }
    }
}

fn check_ast_bounds(node) {
    let lim = GOV.current_limits();
    let st = map{
        "count": 0,
        "max_depth": 0,
        "lim_depth": lim["max_ast_depth"],
        "lim_nodes": lim["max_ast_nodes"]
    };
    _measure_ast(node, 1, st);
    return st;
}

// Structural equality of AST nodes.
fn ast_eq(a, b) {
    if a == nil and b == nil { return true; }
    if a == nil or b == nil { return false; }
    if type(a) != "map" or type(b) != "map" { return a == b; }
    let ka = a["kind"];
    let kb = b["kind"];
    if ka != kb { return false; }
    if ka == "rat" { return a["p"] == b["p"] and a["q"] == b["q"]; }
    if ka == "num" { return a["val"] == b["val"]; }
    if ka == "sym" { return a["name"] == b["name"]; }
    if ka == "neg" { return ast_eq(a["arg"], b["arg"]); }
    if ka == "sub" { return ast_eq(a["left"], b["left"]) and ast_eq(a["right"], b["right"]); }
    if ka == "div" { return ast_eq(a["num"], b["num"]) and ast_eq(a["den"], b["den"]); }
    if ka == "pow" { return ast_eq(a["base"], b["base"]) and ast_eq(a["exp"], b["exp"]); }
    if ka == "add" or ka == "mul" {
        let aa = a["args"]; let bb = b["args"];
        if len(aa) != len(bb) { return false; }
        let i = 0;
        while i < len(aa) {
            if not ast_eq(aa[i], bb[i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if ka == "call" {
        if a["fn_name"] != b["fn_name"] { return false; }
        let aa = a["args"]; let bb = b["args"];
        if len(aa) != len(bb) { return false; }
        let i = 0;
        while i < len(aa) {
            if not ast_eq(aa[i], bb[i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if ka == "rel" {
        return a["op"] == b["op"] and ast_eq(a["lhs"], b["lhs"]) and ast_eq(a["rhs"], b["rhs"]);
    }
    return false;
}

fn _kind_rank(k) {
    if k == "rat" { return 1; }
    if k == "num" { return 2; }
    if k == "sym" { return 3; }
    if k == "pow" { return 4; }
    if k == "mul" { return 5; }
    if k == "div" { return 6; }
    if k == "add" { return 7; }
    if k == "sub" { return 8; }
    if k == "neg" { return 9; }
    if k == "call" { return 10; }
    return 20;
}

// Canonical ordering for commutative sorting:
// In polynomials/sums we prefer higher powers first when displaying, while inside
// products we put constants first, then symbols alphabetically, then functions/sums.
fn ast_cmp(a, b) {
    let ka = a["kind"];
    let kb = b["kind"];
    if ka != kb {
        let ra = _kind_rank(ka);
        let rb = _kind_rank(kb);
        if ra < rb { return -1; }
        if ra > rb { return 1; }
    }
    if ka == "rat" { return rat_cmp(a, b); }
    if ka == "num" {
        if a["val"] < b["val"] { return -1; }
        if a["val"] > b["val"] { return 1; }
        return 0;
    }
    if ka == "sym" {
        // Put constants (pi, e) before algebraic variables so 2*pi*x orders cleanly
        let ca = (a["name"] == "pi" or a["name"] == "e");
        let cb = (b["name"] == "pi" or b["name"] == "e");
        if ca and not cb { return -1; }
        if cb and not ca { return 1; }
        if a["name"] < b["name"] { return -1; }
        if a["name"] > b["name"] { return 1; }
        return 0;
    }
    if ka == "neg" { return ast_cmp(a["arg"], b["arg"]); }
    if ka == "pow" {
        let c = ast_cmp(a["base"], b["base"]);
        if c != 0 { return c; }
        return ast_cmp(a["exp"], b["exp"]);
    }
    if ka == "div" {
        let c = ast_cmp(a["num"], b["num"]);
        if c != 0 { return c; }
        return ast_cmp(a["den"], b["den"]);
    }
    if ka == "sub" {
        let c = ast_cmp(a["left"], b["left"]);
        if c != 0 { return c; }
        return ast_cmp(a["right"], b["right"]);
    }
    if ka == "call" {
        if a["fn_name"] < b["fn_name"] { return -1; }
        if a["fn_name"] > b["fn_name"] { return 1; }
    }
    if ka == "add" or ka == "mul" or ka == "call" {
        let aa = a["args"]; let bb = b["args"];
        let min_l = len(aa);
        if len(bb) < min_l { min_l = len(bb); }
        let i = 0;
        while i < min_l {
            let c = ast_cmp(aa[i], bb[i]);
            if c != 0 { return c; }
            i = i + 1;
        }
        if len(aa) < len(bb) { return -1; }
        if len(aa) > len(bb) { return 1; }
        return 0;
    }
    return 0;
}

fn is_const_sym(name) {
    return name == "pi" or name == "e" or name == "inf" or name == "i";
}

fn _collect_vars(node, seen) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return; }
    let k = node["kind"];
    if k == "sym" {
        let nm = node["name"];
        if not is_const_sym(nm) { seen[nm] = true; }
        return;
    }
    if k == "neg" { _collect_vars(node["arg"], seen); return; }
    if k == "sub" { _collect_vars(node["left"], seen); _collect_vars(node["right"], seen); return; }
    if k == "div" { _collect_vars(node["num"], seen); _collect_vars(node["den"], seen); return; }
    if k == "pow" { _collect_vars(node["base"], seen); _collect_vars(node["exp"], seen); return; }
    if k == "add" or k == "mul" or k == "call" {
        let arr = node["args"];
        let i = 0;
        while i < len(arr) { _collect_vars(arr[i], seen); i = i + 1; }
        return;
    }
    if k == "rel" { _collect_vars(node["lhs"], seen); _collect_vars(node["rhs"], seen); return; }
    if k == "chain_rel" {
        let pts = node["parts"];
        let i = 0;
        while i < len(pts) { _collect_vars(pts[i], seen); i = i + 1; }
        return;
    }
    if k == "system" {
        let items = node["items"];
        let i = 0;
        while i < len(items) { _collect_vars(items[i], seen); i = i + 1; }
        return;
    }
}

fn _sort_strings(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) { push(out, arr[i]); i = i + 1; }
    let n = len(out);
    let a = 1;
    while a < n {
        let key = out[a];
        let b = a - 1;
        while b >= 0 and out[b] > key {
            out[b + 1] = out[b];
            b = b - 1;
        }
        out[b + 1] = key;
        a = a + 1;
    }
    return out;
}

fn free_vars(node) {
    let seen = map{};
    _collect_vars(node, seen);
    return _sort_strings(map_keys(seen));
}

fn contains_var(node, v_name) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return false; }
    let k = node["kind"];
    if k == "sym" { return node["name"] == v_name; }
    if k == "neg" { return contains_var(node["arg"], v_name); }
    if k == "sub" { return contains_var(node["left"], v_name) or contains_var(node["right"], v_name); }
    if k == "div" { return contains_var(node["num"], v_name) or contains_var(node["den"], v_name); }
    if k == "pow" { return contains_var(node["base"], v_name) or contains_var(node["exp"], v_name); }
    if k == "add" or k == "mul" or k == "call" {
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            if contains_var(arr[i], v_name) { return true; }
            i = i + 1;
        }
        return false;
    }
    if k == "rel" { return contains_var(node["lhs"], v_name) or contains_var(node["rhs"], v_name); }
    return false;
}

// Substitute variable map { "x": replacement_node } into AST.
fn subst_ast(node, env) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return node; }
    let k = node["kind"];
    if k == "rat" or k == "num" { return node; }
    if k == "sym" {
        let nm = node["name"];
        if map_has(env, nm) {
            let v = env[nm];
            if type(v) == "number" or type(v) == "bigint" { return ast_num(v); }
            return v;
        }
        return node;
    }
    if k == "neg" { return ast_neg(subst_ast(node["arg"], env)); }
    if k == "sub" { return ast_sub(subst_ast(node["left"], env), subst_ast(node["right"], env)); }
    if k == "div" { return ast_div(subst_ast(node["num"], env), subst_ast(node["den"], env)); }
    if k == "pow" { return ast_pow(subst_ast(node["base"], env), subst_ast(node["exp"], env)); }
    if k == "add" or k == "mul" {
        let out = [];
        let arr = node["args"];
        let i = 0;
        while i < len(arr) { push(out, subst_ast(arr[i], env)); i = i + 1; }
        return map{ "kind": k, "args": out };
    }
    if k == "call" {
        let out = [];
        let arr = node["args"];
        let i = 0;
        while i < len(arr) { push(out, subst_ast(arr[i], env)); i = i + 1; }
        return ast_call(node["fn_name"], out);
    }
    if k == "rel" {
        return ast_rel(node["op"], subst_ast(node["lhs"], env), subst_ast(node["rhs"], env));
    }
    return node;
}

fn _parse_prime_fn_name(fn_nm) {
    let n = len(fn_nm);
    if n > 4 and str_slice(fn_nm, n - 4, n - 1) == "__d" {
        let ord_ch = str_slice(fn_nm, n - 1, n);
        if ord_ch == "1" { return map{ "base": str_slice(fn_nm, 0, n - 4), "order": 1 }; }
        if ord_ch == "2" { return map{ "base": str_slice(fn_nm, 0, n - 4), "order": 2 }; }
        if ord_ch == "3" { return map{ "base": str_slice(fn_nm, 0, n - 4), "order": 3 }; }
        if ord_ch == "4" { return map{ "base": str_slice(fn_nm, 0, n - 4), "order": 4 }; }
    }
    return map{ "base": fn_nm, "order": 0 };
}

fn _clone_env_with_params(base_env, params, vals) {
    let c = map{};
    if base_env != nil and type(base_env) == "map" {
        let ks = map_keys(base_env);
        let i = 0;
        while i < len(ks) {
            c[ks[i]] = base_env[ks[i]];
            i = i + 1;
        }
    }
    let j = 0;
    while j < len(params) and j < len(vals) {
        c[params[j]] = vals[j];
        j = j + 1;
    }
    return c;
}

fn _eval_rel_cond(cond_node, env) {
    if cond_node == nil or type(cond_node) != "map" { return false; }
    if cond_node["kind"] == "rel" {
        let lv = eval_ast(cond_node["lhs"], env);
        let rv = eval_ast(cond_node["rhs"], env);
        if lv == nil or rv == nil { return false; }
        let op = cond_node["op"];
        if op == "<" { return lv < rv; }
        if op == "<=" { return lv <= rv; }
        if op == ">" { return lv > rv; }
        if op == ">=" { return lv >= rv; }
        if op == "=" { return num_abs(lv - rv) <= 1.0e-12; }
        if op == "!=" { return num_abs(lv - rv) > 1.0e-12; }
        return false;
    }
    let v = eval_ast(cond_node, env);
    if v == nil { return false; }
    return num_abs(v) > 0.0;
}

// Safe floating-point evaluation of AST node under env map{ "x": 2.5 }.
// Returns nil on domain violation (sqrt(<0), ln(<=0), division by 0, unbound symbol).
fn eval_ast(node, env = nil) {
    if env == nil { env = map{}; }
    if node == nil or type(node) != "map" { return nil; }
    let k = node["kind"];
    if k == "rat" { return rat_to_float(node); }
    if k == "num" {
        if is_finite_num(node["val"]) { return node["val"]; }
        return nil;
    }
    if k == "sym" {
        let nm = node["name"];
        if map_has(env, nm) {
            let ev = env[nm];
            if type(ev) == "map" and map_has(ev, "kind") { return eval_ast(ev, env); }
            if type(ev) == "bigint" { return bi_to_float(ev); }
            if is_finite_num(ev) { return ev; }
            return nil;
        }
        if nm == "pi" { return _PI_VAL; }
        if nm == "e" { return _E_VAL; }
        return nil;
    }
    if k == "neg" {
        let v = eval_ast(node["arg"], env);
        if v == nil { return nil; }
        return 0.0 - v;
    }
    if k == "sub" {
        let l = eval_ast(node["left"], env);
        let r = eval_ast(node["right"], env);
        if l == nil or r == nil { return nil; }
        let res = l - r;
        if is_finite_num(res) { return res; }
        return nil;
    }
    if k == "div" {
        let n = eval_ast(node["num"], env);
        let d = eval_ast(node["den"], env);
        if n == nil or d == nil or num_abs(d) == 0.0 { return nil; }
        let res = try (n / d) catch nil;
        if res != nil and is_finite_num(res) { return res; }
        return nil;
    }
    if k == "add" {
        let sum = 0.0;
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            let v = eval_ast(arr[i], env);
            if v == nil { return nil; }
            sum = sum + v;
            i = i + 1;
        }
        if is_finite_num(sum) { return sum; }
        return nil;
    }
    if k == "mul" {
        let prod = 1.0;
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            let v = eval_ast(arr[i], env);
            if v == nil { return nil; }
            prod = prod * v;
            i = i + 1;
        }
        if is_finite_num(prod) { return prod; }
        return nil;
    }
    if k == "pow" {
        let b = eval_ast(node["base"], env);
        let e = eval_ast(node["exp"], env);
        if b == nil or e == nil { return nil; }
        if b == 0.0 and e < 0.0 { return nil; }
        if b < 0.0 {
            let er = num_round(e);
            if num_abs(e - er) > 0.000000000001 {
                // Check odd denominator rational exponent like cbrt
                if is_rat(node["exp"]) {
                    let q_int = num_round(bi_to_float(node["exp"]["q"]));
                    let p_int = num_round(bi_to_float(node["exp"]["p"]));
                    if q_int > 0 and (q_int - num_floor(q_int / 2) * 2) == 1 {
                        let mag = num_pow(0.0 - b, e);
                        if not is_finite_num(mag) { return nil; }
                        if (p_int - num_floor(p_int / 2) * 2) != 0 { return 0.0 - mag; }
                        return mag;
                    }
                }
                return nil;
            }
            let mag = num_pow(0.0 - b, er);
            if not is_finite_num(mag) { return nil; }
            let half = num_floor(er / 2);
            if er - half * 2 != 0 { return 0.0 - mag; }
            return mag;
        }
        let res = try num_pow(b, e) catch nil;
        if res != nil and is_finite_num(res) { return res; }
        return nil;
    }
    if k == "call" {
        let fn_nm = node["fn_name"];
        let args = node["args"];
        // 1. Short-circuit piecewise(cond1, val1, cond2, val2, ..., [default_val])
        if fn_nm == "piecewise" {
            let na = len(args);
            let pi_idx = 0;
            while pi_idx + 1 < na {
                if _eval_rel_cond(args[pi_idx], env) {
                    return eval_ast(args[pi_idx + 1], env);
                }
                pi_idx = pi_idx + 2;
            }
            if na - num_floor(na / 2) * 2 == 1 {
                return eval_ast(args[na - 1], env);
            }
            return nil;
        }
        // 2. User-defined functions & Lagrange prime derivatives f'(x), f''(x)
        let pf = _parse_prime_fn_name(fn_nm);
        if pf["order"] > 0 or map_has(_USER_FUNCS, fn_nm) {
            let arg_vals = [];
            let ai = 0;
            while ai < len(args) {
                let av = eval_ast(args[ai], env);
                if av == nil { return nil; }
                push(arg_vals, av);
                ai = ai + 1;
            }
            if _EVAL_CALL_DEPTH >= 64 {
                throw "MathGovernor[symbolic_cas]: maximum custom function recursion depth (64) exceeded in '" + pf["base"] + "'";
            }
            let b_nm = pf["base"];
            let d_ord = pf["order"];
            if map_has(_USER_FUNCS, b_nm) {
                let uf = _USER_FUNCS[b_nm];
                let p_names = uf["params"];
                if len(p_names) != len(arg_vals) { return nil; }
                let target_ast = uf["body_ast"];
                if d_ord > 0 {
                    if len(p_names) == 0 { return 0.0; }
                    let cache_k = "d" + str(d_ord) + "_ast";
                    if map_has(uf, cache_k) and uf[cache_k] != nil {
                        target_ast = uf[cache_k];
                    } else {
                        let cur_d = target_ast;
                        let di = 0;
                        while di < d_ord {
                            cur_d = diff_ast(cur_d, p_names[0]);
                            di = di + 1;
                        }
                        uf[cache_k] = cur_d;
                        target_ast = cur_d;
                    }
                }
                let call_env = _clone_env_with_params(env, p_names, arg_vals);
                _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH + 1;
                let r_uf = try eval_ast(target_ast, call_env) catch err {
                    _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH - 1;
                    throw err;
                };
                _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH - 1;
                return r_uf;
            } else if d_ord > 0 and _is_known_func(b_nm) and len(arg_vals) == 1 {
                let cur_d = ast_call(b_nm, [ast_sym("__p0")]);
                let di = 0;
                while di < d_ord {
                    cur_d = diff_ast(cur_d, "__p0");
                    di = di + 1;
                }
                let p_env = _env1("__p0", arg_vals[0]);
                _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH + 1;
                let r_bi = try eval_ast(cur_d, p_env) catch err {
                    _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH - 1;
                    throw err;
                };
                _EVAL_CALL_DEPTH = _EVAL_CALL_DEPTH - 1;
                return r_bi;
            }
            return nil;
        }
        if len(args) == 0 { return nil; }
        if fn_nm == "min" or fn_nm == "max" {
            let best = eval_ast(args[0], env);
            if best == nil { return nil; }
            let mi = 1;
            while mi < len(args) {
                let mv = eval_ast(args[mi], env);
                if mv == nil { return nil; }
                if fn_nm == "min" and mv < best { best = mv; }
                if fn_nm == "max" and mv > best { best = mv; }
                mi = mi + 1;
            }
            return best;
        }
        if fn_nm == "clamp" and len(args) == 3 {
            let xv = eval_ast(args[0], env);
            let lo_v = eval_ast(args[1], env);
            let hi_v = eval_ast(args[2], env);
            if xv == nil or lo_v == nil or hi_v == nil { return nil; }
            return _clamp_num(xv, lo_v, hi_v);
        }
        let u = eval_ast(args[0], env);
        if u == nil { return nil; }
        let res = nil;
        if fn_nm == "abs" { res = num_abs(u); }
        else if fn_nm == "heaviside" {
            let z_def = 0.5;
            if len(args) >= 2 {
                let zv = eval_ast(args[1], env);
                if zv == nil { return nil; }
                z_def = zv;
            }
            if u < 0.0 { res = 0.0; }
            else if u > 0.0 { res = 1.0; }
            else { res = z_def; }
        }
        else if fn_nm == "sign" {
            if u > 0.0 { res = 1.0; }
            else if u < 0.0 { res = -1.0; }
            else { res = 0.0; }
        }
        else if fn_nm == "round" { res = num_round(u); }
        else if fn_nm == "sinc" {
            if num_abs(u) < 1.0e-9 { res = 1.0 - (u * u) / 6.0; }
            else { res = num_sin(u) / u; }
        }
        else if fn_nm == "hypot" and len(args) >= 2 {
            let v2 = eval_ast(args[1], env);
            if v2 == nil { return nil; }
            res = num_sqrt(u * u + v2 * v2);
        }
        else if fn_nm == "mod" and len(args) >= 2 {
            let v2 = eval_ast(args[1], env);
            if v2 == nil or num_abs(v2) == 0.0 { return nil; }
            res = u - num_floor(u / v2) * v2;
        }
        else if fn_nm == "sqrt" {
            if u < -0.0000000000001 { return nil; }
            if u < 0.0 { u = 0.0; }
            res = num_sqrt(u);
        }
        else if fn_nm == "cbrt" {
            if u < 0.0 { res = 0.0 - num_pow(0.0 - u, 1.0 / 3.0); }
            else { res = num_pow(u, 1.0 / 3.0); }
        }
        else if fn_nm == "sin" { res = num_sin(u); }
        else if fn_nm == "cos" { res = num_cos(u); }
        else if fn_nm == "tan" {
            let cv = num_cos(u);
            if num_abs(cv) < 0.000000000001 { return nil; }
            res = num_sin(u) / cv;
        }
        else if fn_nm == "cot" {
            let sv = num_sin(u);
            if num_abs(sv) < 0.000000000001 { return nil; }
            res = num_cos(u) / sv;
        }
        else if fn_nm == "sec" {
            let cv = num_cos(u);
            if num_abs(cv) < 0.000000000001 { return nil; }
            res = 1.0 / cv;
        }
        else if fn_nm == "csc" {
            let sv = num_sin(u);
            if num_abs(sv) < 0.000000000001 { return nil; }
            res = 1.0 / sv;
        }
        else if fn_nm == "asin" {
            if u < -1.0 or u > 1.0 { return nil; }
            res = num_atan2(u, num_sqrt(_max_num(0.0, 1.0 - u * u)));
        }
        else if fn_nm == "acos" {
            if u < -1.0 or u > 1.0 { return nil; }
            res = (_PI_VAL / 2.0) - num_atan2(u, num_sqrt(_max_num(0.0, 1.0 - u * u)));
        }
        else if fn_nm == "atan" { res = num_atan2(u, 1.0); }
        else if fn_nm == "atan2" and len(args) >= 2 {
            let v2 = eval_ast(args[1], env);
            if v2 == nil { return nil; }
            res = num_atan2(u, v2);
        }
        else if fn_nm == "sinh" { res = (num_exp(u) - num_exp(0.0 - u)) / 2.0; }
        else if fn_nm == "cosh" { res = (num_exp(u) + num_exp(0.0 - u)) / 2.0; }
        else if fn_nm == "tanh" {
            let ep = num_exp(u); let em = num_exp(0.0 - u);
            res = (ep - em) / (ep + em);
        }
        else if fn_nm == "exp" { res = num_exp(u); }
        else if fn_nm == "ln" {
            if u <= 0.0 { return nil; }
            res = num_ln(u);
        }
        else if fn_nm == "log" or fn_nm == "log10" {
            if len(args) == 2 {
                let base_v = eval_ast(args[1], env);
                if u <= 0.0 or base_v == nil or base_v <= 0.0 or base_v == 1.0 { return nil; }
                res = num_ln(u) / num_ln(base_v);
            } else {
                if u <= 0.0 { return nil; }
                if fn_nm == "log10" { res = num_ln(u) / num_ln(10.0); }
                else { res = num_ln(u); }
            }
        }
        else if fn_nm == "log2" {
            if u <= 0.0 { return nil; }
            res = num_ln(u) / num_ln(2.0);
        }
        else if fn_nm == "floor" { res = num_floor(u); }
        else if fn_nm == "ceil" { res = num_ceil(u); }
        else if fn_nm == "erf" or fn_nm == "erfc" {
            let ax = num_abs(u);
            let erf_pos = 0.0;
            let erfc_pos = 1.0;
            if ax <= 2.5 {
                let term = ax;
                let s_er = ax;
                let u2 = ax * ax;
                let ki = 1;
                while ki <= 40 {
                    term = (0.0 - term * u2) / ki;
                    let contrib = term / (2 * ki + 1);
                    s_er = s_er + contrib;
                    if num_abs(contrib) < 1.0e-16 * num_abs(s_er) { break; }
                    ki = ki + 1;
                }
                erf_pos = (2.0 / num_sqrt(_PI_VAL)) * s_er;
                erfc_pos = 1.0 - erf_pos;
            } else if ax <= 28.0 {
                // Laplace continued fraction for erfc(ax): exp(-ax^2)/(sqrt(pi) * (ax + 0.5/(ax + 1/(ax + ...))))
                let cf = ax;
                let ki = 30;
                while ki >= 1 {
                    cf = ax + (0.5 * ki) / cf;
                    ki = ki - 1;
                }
                erfc_pos = num_exp(0.0 - ax * ax) / (num_sqrt(_PI_VAL) * cf);
                erf_pos = 1.0 - erfc_pos;
            } else {
                erf_pos = 1.0;
                erfc_pos = 0.0;
            }
            if fn_nm == "erf" {
                if u < 0.0 { res = 0.0 - erf_pos; } else { res = erf_pos; }
            } else {
                if u < 0.0 { res = 2.0 - erfc_pos; } else { res = erfc_pos; }
            }
        }
        else if fn_nm == "erfi" {
            if num_abs(u) <= 6.0 {
                let term = u;
                let s_ei = u;
                let u2 = u * u;
                let ki = 1;
                while ki <= 40 {
                    term = (term * u2) / ki;
                    s_ei = s_ei + term / (2 * ki + 1);
                    ki = ki + 1;
                }
                res = (2.0 / num_sqrt(_PI_VAL)) * s_ei;
            }
        }
        else if fn_nm == "gamma" {
            res = _num_gamma_eval(u);
        }
        else if fn_nm == "beta" and len(args) >= 2 {
            let v2 = eval_ast(args[1], env);
            if v2 != nil {
                let ga = _num_gamma_eval(u);
                let gb = _num_gamma_eval(v2);
                let gab = _num_gamma_eval(u + v2);
                if ga != nil and gb != nil and gab != nil and num_abs(gab) > 1e-300 {
                    res = (ga * gb) / gab;
                }
            }
        }
        else if fn_nm == "lambertw" {
            res = _num_lambertw0_eval(u);
        }
        else if fn_nm == "Li2" {
            if u <= 1.0 and num_abs(u) <= 0.999999 {
                let s_l2 = 0.0;
                let pk = u;
                let ki = 1;
                while ki <= 80 {
                    s_l2 = s_l2 + pk / (ki * ki);
                    pk = pk * u;
                    ki = ki + 1;
                }
                res = s_l2;
            } else if u == 1.0 {
                res = (_PI_VAL * _PI_VAL) / 6.0;
            }
        }
        else if fn_nm == "Si" {
            if num_abs(u) <= 25.0 {
                let term = u;
                let acc_si = u;
                let u2 = u * u;
                let ki = 1;
                while ki <= 45 {
                    term = (0.0 - term * u2) / ((2 * ki) * (2 * ki + 1));
                    acc_si = acc_si + term / (2 * ki + 1);
                    ki = ki + 1;
                }
                res = acc_si;
            }
        }
        else if fn_nm == "Ci" {
            if u > 0.0 and u <= 25.0 {
                let euler_gamma = 0.5772156649015329;
                let acc_ci = euler_gamma + num_ln(u);
                let u2 = u * u;
                let term = 1.0;
                let ki = 1;
                while ki <= 45 {
                    term = (0.0 - term * u2) / ((2 * ki - 1) * (2 * ki));
                    acc_ci = acc_ci + term / (2 * ki);
                    ki = ki + 1;
                }
                res = acc_ci;
            }
        }
        else if fn_nm == "Ei" {
            if u != 0.0 and num_abs(u) <= 30.0 {
                let euler_gamma = 0.5772156649015329;
                let acc_e = euler_gamma + num_ln(num_abs(u));
                let term = 1.0;
                let ki = 1;
                while ki <= 60 {
                    term = (term * u) / ki;
                    acc_e = acc_e + term / ki;
                    ki = ki + 1;
                }
                res = acc_e;
            }
        }
        else if fn_nm == "li" {
            if u > 0.0 and u != 1.0 {
                let lu = num_ln(u);
                if num_abs(lu) <= 30.0 {
                    res = eval_ast(ast_call("Ei", [ast_num(lu)]), map{});
                }
            }
        }
        else if fn_nm == "FresnelS" or fn_nm == "FresnelC" {
            if num_abs(u) <= 6.0 {
                // Composite Simpson integration on [0, u]
                let n_sp = 64;
                let h_sp = u / n_sp;
                let sum_sp = 0.0;
                let si = 0;
                while si <= n_sp {
                    let t_sp = si * h_sp;
                    let ang = 0.5 * _PI_VAL * t_sp * t_sp;
                    let fv = 0.0;
                    if fn_nm == "FresnelS" { fv = num_sin(ang); } else { fv = num_cos(ang); }
                    let wt = 2.0;
                    if si == 0 or si == n_sp { wt = 1.0; }
                    else if si - num_floor(si / 2) * 2 == 1 { wt = 4.0; }
                    sum_sp = sum_sp + wt * fv;
                    si = si + 1;
                }
                res = (h_sp / 3.0) * sum_sp;
            }
        }
        else if fn_nm == "zeta" {
            if u > 1.0 {
                let n_em = 32.0;
                let s_em = 0.0;
                let ki = 1;
                while ki < 32 {
                    s_em = s_em + 1.0 / num_pow(ki * 1.0, u);
                    ki = ki + 1;
                }
                let n_neg_s = num_pow(n_em, 0.0 - u);
                let inv_n2 = 1.0 / (n_em * n_em);
                let c2 = (u / 12.0) * (n_neg_s / n_em);
                let c4 = (u * (u + 1.0) * (u + 2.0) / 720.0) * (n_neg_s / n_em) * inv_n2;
                let c6 = (u * (u + 1.0) * (u + 2.0) * (u + 3.0) * (u + 4.0) / 30240.0) * (n_neg_s / n_em) * inv_n2 * inv_n2;
                res = s_em + (n_em * n_neg_s) / (u - 1.0) + 0.5 * n_neg_s + c2 - c4 + c6;
            }
        }
        else if fn_nm == "besselj" and len(args) >= 2 {
            let x_bj = eval_ast(args[1], env);
            if x_bj != nil and num_abs(u - num_round(u)) < 1e-9 and num_abs(x_bj) <= 25.0 {
                let n_ord = num_round(u);
                let m_abs = num_round(num_abs(n_ord));
                let half_x = 0.5 * x_bj;
                let term = num_pow(half_x, m_abs);
                let f_m = 1.0;
                let fi = 2;
                while fi <= m_abs { f_m = f_m * fi; fi = fi + 1; }
                term = term / f_m;
                let acc_bj = term;
                let ki = 1;
                while ki <= 40 {
                    term = (0.0 - term * half_x * half_x) / (ki * (ki + m_abs));
                    acc_bj = acc_bj + term;
                    ki = ki + 1;
                }
                if n_ord < 0 and (m_abs - num_floor(m_abs / 2) * 2 == 1) {
                    acc_bj = 0.0 - acc_bj;
                }
                res = acc_bj;
            }
        }
        if res != nil and is_finite_num(res) { return res; }
        return nil;
    }
    return nil;
}

fn _num_gamma_eval(z) {
    if z <= 0.0 and num_abs(z - num_round(z)) < 1e-12 { return nil; }
    if z < 0.5 {
        let g1 = _num_gamma_eval(1.0 - z);
        if g1 == nil { return nil; }
        let sv = num_sin(_PI_VAL * z);
        if num_abs(sv) < 1e-15 { return nil; }
        return _PI_VAL / (sv * g1);
    }
    let x = z - 1.0;
    let p0 = 0.99999999999980993;
    let coeffs = [
        676.5203681218851, -1259.1392167224028, 771.32342877765313,
        -176.61502916214059, 12.507343278686905, -0.13857109526572012,
        0.0000099843695780195716, 0.00000015056327351493116
    ];
    let acc = p0;
    let i = 0;
    while i < len(coeffs) {
        acc = acc + coeffs[i] / (x + i + 1.0);
        i = i + 1;
    }
    let t = x + 7.5;
    return num_sqrt(2.0 * _PI_VAL) * num_pow(t, x + 0.5) * num_exp(0.0 - t) * acc;
}

fn _num_lambertw0_eval(x) {
    let min_dom = -1.0 / _E_VAL;
    if x < min_dom - 1e-12 { return nil; }
    if num_abs(x - min_dom) <= 1e-12 { return -1.0; }
    let w = 0.0;
    if x < 1.0 { w = x; } else { w = num_ln(x + 1.0); }
    let it = 0;
    while it < 30 {
        let ew = num_exp(w);
        let wew = w * ew;
        let f = wew - x;
        if num_abs(f) < 1e-14 { return w; }
        let denom = ew * (w + 1.0) - ((w + 2.0) * f) / (2.0 * w + 2.0);
        if num_abs(denom) < 1e-15 { break; }
        w = w - f / denom;
        it = it + 1;
    }
    return w;
}

// Symbolic derivative d(node)/d(v_name) (raw AST; caller may simplify).
fn diff_ast(node, v_name) {
    if node == nil or type(node) != "map" { return RAT_ZERO; }
    if not contains_var(node, v_name) { return RAT_ZERO; }
    let k = node["kind"];
    if k == "sym" {
        if node["name"] == v_name { return RAT_ONE; }
        return RAT_ZERO;
    }
    if k == "neg" { return ast_neg(diff_ast(node["arg"], v_name)); }
    if k == "sub" { return ast_sub(diff_ast(node["left"], v_name), diff_ast(node["right"], v_name)); }
    if k == "add" {
        let terms = [];
        let arr = node["args"];
        let i = 0;
        while i < len(arr) { push(terms, diff_ast(arr[i], v_name)); i = i + 1; }
        return ast_add(terms);
    }
    if k == "mul" {
        let arr = node["args"];
        let terms = [];
        let i = 0;
        while i < len(arr) {
            if contains_var(arr[i], v_name) {
                let prod = [];
                let j = 0;
                while j < len(arr) {
                    if i == j { push(prod, diff_ast(arr[i], v_name)); }
                    else { push(prod, arr[j]); }
                    j = j + 1;
                }
                push(terms, ast_mul(prod));
            }
            i = i + 1;
        }
        return ast_add(terms);
    }
    if k == "div" {
        let u = node["num"]; let v = node["den"];
        let du = diff_ast(u, v_name); let dv = diff_ast(v, v_name);
        return ast_div(ast_sub(ast_mul([du, v]), ast_mul([u, dv])), ast_pow(v, RAT_TWO));
    }
    if k == "pow" {
        let b = node["base"]; let e = node["exp"];
        if not contains_var(e, v_name) {
            let e_m1 = ast_sub(e, RAT_ONE);
            return ast_mul([e, ast_pow(b, e_m1), diff_ast(b, v_name)]);
        }
        if not contains_var(b, v_name) {
            if b["kind"] == "sym" and b["name"] == "e" {
                return ast_mul([node, diff_ast(e, v_name)]);
            }
            return ast_mul([node, ast_call("ln", [b]), diff_ast(e, v_name)]);
        }
        return ast_mul([
            node,
            ast_add([
                ast_mul([diff_ast(e, v_name), ast_call("ln", [b])]),
                ast_div(ast_mul([e, diff_ast(b, v_name)]), b)
            ])
        ]);
    }
    if k == "call" {
        let fn_nm = node["fn_name"];
        let args = node["args"];
        if fn_nm == "piecewise" {
            let pw_out = [];
            let na = len(args);
            let pi_idx = 0;
            while pi_idx + 1 < na {
                push(pw_out, args[pi_idx]);
                push(pw_out, diff_ast(args[pi_idx + 1], v_name));
                pi_idx = pi_idx + 2;
            }
            if na - num_floor(na / 2) * 2 == 1 {
                push(pw_out, diff_ast(args[na - 1], v_name));
            }
            return ast_call("piecewise", pw_out);
        }
        // User-defined functions & Lagrange prime calls: apply exact multivariable Chain Rule!
        let pf = _parse_prime_fn_name(fn_nm);
        if pf["order"] > 0 or map_has(_USER_FUNCS, fn_nm) {
            if _DIFF_CALL_DEPTH >= 24 {
                throw "MathGovernor[symbolic_cas.diff]: maximum custom function derivative recursion depth (24) exceeded in '" + pf["base"] + "'";
            }
            let b_nm = pf["base"];
            let d_ord = pf["order"];
            if map_has(_USER_FUNCS, b_nm) {
                let uf = _USER_FUNCS[b_nm];
                let p_names = uf["params"];
                if len(p_names) != len(args) { return RAT_ZERO; }
                _DIFF_CALL_DEPTH = _DIFF_CALL_DEPTH + 1;
                let base_body = uf["body_ast"];
                let oi = 0;
                while oi < d_ord and len(p_names) > 0 {
                    base_body = diff_ast(base_body, p_names[0]);
                    oi = oi + 1;
                }
                let sub_map = map{};
                let si = 0;
                while si < len(p_names) {
                    sub_map[p_names[si]] = args[si];
                    si = si + 1;
                }
                let chain_terms = [];
                let pi = 0;
                while pi < len(p_names) {
                    let d_arg = diff_ast(args[pi], v_name);
                    if not is_zero_node(d_arg) {
                        let d_param = try diff_ast(base_body, p_names[pi]) catch err {
                            _DIFF_CALL_DEPTH = _DIFF_CALL_DEPTH - 1;
                            throw err;
                        };
                        let d_sub = subst_ast(d_param, sub_map);
                        push(chain_terms, ast_mul([d_sub, d_arg]));
                    }
                    pi = pi + 1;
                }
                _DIFF_CALL_DEPTH = _DIFF_CALL_DEPTH - 1;
                if len(chain_terms) == 0 { return RAT_ZERO; }
                if len(chain_terms) == 1 { return chain_terms[0]; }
                return ast_add(chain_terms);
            } else if d_ord > 0 and _is_known_func(b_nm) and len(args) == 1 {
                let cur_d = ast_call(b_nm, [ast_sym("__p0")]);
                let oi = 0;
                while oi <= d_ord {
                    cur_d = diff_ast(cur_d, "__p0");
                    oi = oi + 1;
                }
                let sub_d = subst_ast(cur_d, map{ "__p0": args[0] });
                return ast_mul([sub_d, diff_ast(args[0], v_name)]);
            } else if len(args) == 1 and d_ord < 4 {
                // Symbolic abstract function f(u(x)) -> f'(u(x)) * u'(x)
                let next_ord = d_ord + 1;
                return ast_mul([ast_call(b_nm + "__d" + str(next_ord), [args[0]]), diff_ast(args[0], v_name)]);
            }
            return RAT_ZERO;
        }
        if len(args) == 0 { return RAT_ZERO; }
        let u = args[0];
        let du = diff_ast(u, v_name);
        if fn_nm == "sin" { return ast_mul([ast_call("cos", [u]), du]); }
        if fn_nm == "cos" { return ast_neg(ast_mul([ast_call("sin", [u]), du])); }
        if fn_nm == "tan" { return ast_div(du, ast_pow(ast_call("cos", [u]), RAT_TWO)); }
        if fn_nm == "cot" { return ast_neg(ast_div(du, ast_pow(ast_call("sin", [u]), RAT_TWO))); }
        if fn_nm == "sinh" { return ast_mul([ast_call("cosh", [u]), du]); }
        if fn_nm == "cosh" { return ast_mul([ast_call("sinh", [u]), du]); }
        if fn_nm == "tanh" { return ast_div(du, ast_pow(ast_call("cosh", [u]), RAT_TWO)); }
        if fn_nm == "asin" { return ast_div(du, ast_call("sqrt", [ast_sub(RAT_ONE, ast_pow(u, RAT_TWO))])); }
        if fn_nm == "acos" { return ast_neg(ast_div(du, ast_call("sqrt", [ast_sub(RAT_ONE, ast_pow(u, RAT_TWO))]))); }
        if fn_nm == "atan" { return ast_div(du, ast_add([RAT_ONE, ast_pow(u, RAT_TWO)])); }
        if fn_nm == "sinc" {
            return ast_mul([ast_div(ast_sub(ast_mul([u, ast_call("cos", [u])]), ast_call("sin", [u])), ast_pow(u, RAT_TWO)), du]);
        }
        if fn_nm == "heaviside" or fn_nm == "sign" or fn_nm == "floor" or fn_nm == "ceil" or fn_nm == "round" {
            return RAT_ZERO;
        }
        if fn_nm == "exp" { return ast_mul([ast_call("exp", [u]), du]); }
        if fn_nm == "ln" or fn_nm == "log" { return ast_div(du, u); }
        if fn_nm == "sqrt" { return ast_div(du, ast_mul([RAT_TWO, ast_call("sqrt", [u])])); }
        if fn_nm == "abs" { return ast_div(ast_mul([u, du]), ast_call("abs", [u])); }
        if fn_nm == "erf" {
            return ast_mul([ast_div(RAT_TWO, ast_call("sqrt", [ast_sym("pi")])), ast_call("exp", [ast_neg(ast_pow(u, RAT_TWO))]), du]);
        }
        if fn_nm == "erfc" {
            return ast_neg(ast_mul([ast_div(RAT_TWO, ast_call("sqrt", [ast_sym("pi")])), ast_call("exp", [ast_neg(ast_pow(u, RAT_TWO))]), du]));
        }
        if fn_nm == "erfi" {
            return ast_mul([ast_div(RAT_TWO, ast_call("sqrt", [ast_sym("pi")])), ast_call("exp", [ast_pow(u, RAT_TWO)]), du]);
        }
        if fn_nm == "Ei" { return ast_mul([ast_div(ast_call("exp", [u]), u), du]); }
        if fn_nm == "li" { return ast_div(du, ast_call("ln", [u])); }
        if fn_nm == "Si" { return ast_mul([ast_div(ast_call("sin", [u]), u), du]); }
        if fn_nm == "Ci" { return ast_mul([ast_div(ast_call("cos", [u]), u), du]); }
        if fn_nm == "FresnelS" {
            return ast_mul([ast_call("sin", [ast_div(ast_mul([ast_sym("pi"), ast_pow(u, RAT_TWO)]), RAT_TWO)]), du]);
        }
        if fn_nm == "FresnelC" {
            return ast_mul([ast_call("cos", [ast_div(ast_mul([ast_sym("pi"), ast_pow(u, RAT_TWO)]), RAT_TWO)]), du]);
        }
        if fn_nm == "Li2" {
            return ast_mul([ast_neg(ast_div(ast_call("ln", [ast_sub(RAT_ONE, u)]), u)), du]);
        }
        if fn_nm == "lambertw" {
            let w_u = ast_call("lambertw", [u]);
            return ast_mul([ast_div(w_u, ast_mul([u, ast_add([RAT_ONE, w_u])])), du]);
        }
        if fn_nm == "igamma" and len(args) >= 2 and not contains_var(args[0], v_name) {
            let s_arg = args[0];
            let x_arg = args[1];
            return ast_neg(ast_mul([ast_pow(x_arg, ast_sub(s_arg, RAT_ONE)), ast_call("exp", [ast_neg(x_arg)]), diff_ast(x_arg, v_name)]));
        }
        if fn_nm == "besselj" and len(args) >= 2 and not contains_var(args[0], v_name) {
            let n_arg = args[0];
            let x_arg = args[1];
            return ast_mul([
                RAT_HALF,
                ast_sub(ast_call("besselj", [ast_sub(n_arg, RAT_ONE), x_arg]), ast_call("besselj", [ast_add([n_arg, RAT_ONE]), x_arg])),
                diff_ast(x_arg, v_name)
            ]);
        }
    }
    return RAT_ZERO;
}

// ── Natural Math, Unicode & LaTeX Normalizer + Parser ─────────────────────────

fn _is_known_func(nm) {
    return nm == "sin" or nm == "cos" or nm == "tan" or nm == "cot"
        or nm == "sec" or nm == "csc" or nm == "asin" or nm == "acos"
        or nm == "atan" or nm == "atan2" or nm == "sinh" or nm == "cosh"
        or nm == "tanh" or nm == "sqrt" or nm == "cbrt" or nm == "abs"
        or nm == "ln" or nm == "log" or nm == "log10" or nm == "log2"
        or nm == "exp" or nm == "floor" or nm == "ceil" or nm == "round"
        or nm == "piecewise" or nm == "heaviside" or nm == "sign"
        or nm == "min" or nm == "max" or nm == "clamp" or nm == "hypot"
        or nm == "mod" or nm == "sinc"
        or nm == "erf" or nm == "erfc" or nm == "erfi"
        or nm == "Ei" or nm == "li" or nm == "Si" or nm == "Ci"
        or nm == "FresnelS" or nm == "FresnelC"
        or nm == "Li2" or nm == "lambertw"
        or nm == "gamma" or nm == "igamma" or nm == "beta"
        or nm == "zeta" or nm == "besselj";
}

fn _is_callable_ident(nm) {
    let pf = _parse_prime_fn_name(nm);
    if pf["order"] > 0 { return true; }
    return _is_known_func(nm) or map_has(_USER_FUNCS, nm);
}

fn _has_top_comma_in_parens(toks, lparen_idx) {
    let n = len(toks);
    if lparen_idx < 0 or lparen_idx >= n or toks[lparen_idx]["t"] != "LPAREN" {
        return false;
    }
    let d = 1;
    let m = lparen_idx + 1;
    while m < n and d > 0 {
        let tt = toks[m]["t"];
        if tt == "LPAREN" { d = d + 1; }
        else if tt == "RPAREN" {
            d = d - 1;
            if d == 0 { return false; }
        } else if tt == "COMMA" and d == 1 {
            return true;
        }
        m = m + 1;
    }
    return false;
}

fn _superscript_char_map(cp) {
    if cp == 8304 { return "0"; }
    if cp == 185  { return "1"; }
    if cp == 178  { return "2"; }
    if cp == 179  { return "3"; }
    if cp == 8308 { return "4"; }
    if cp == 8309 { return "5"; }
    if cp == 8310 { return "6"; }
    if cp == 8311 { return "7"; }
    if cp == 8312 { return "8"; }
    if cp == 8313 { return "9"; }
    if cp == 8314 { return "+"; }
    if cp == 8315 { return "-"; }
    if cp == 8319 { return "n"; }
    return "";
}

fn _is_alpha_cp(cp) {
    return (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or cp == 95
        or (cp >= 913 and cp <= 969 and cp != 960);
}

fn _is_digit_cp(cp) {
    return cp >= 48 and cp <= 57;
}

// Extract balanced { ... } starting at index open_pos (where s[open_pos] == '{').
// Returns map{ content: string, next_pos: int }.
fn _extract_braced(s, open_pos) {
    let n = len(s);
    if open_pos >= n or str_slice(s, open_pos, open_pos + 1) != "{" {
        return nil;
    }
    let depth = 1;
    let i = open_pos + 1;
    while i < n and depth > 0 {
        let ch = str_slice(s, i, i + 1);
        if ch == "{" { depth = depth + 1; }
        else if ch == "}" { depth = depth - 1; }
        i = i + 1;
    }
    if depth != 0 {
        throw "Unbalanced '{' in LaTeX expression";
    }
    return map{
        "content": str_slice(s, open_pos + 1, i - 1),
        "next_pos": i
    };
}

fn _skip_spaces(s, pos) {
    let n = len(s);
    let i = pos;
    while i < n {
        let cp = strcharcodeat(s, i);
        if cp == 32 or cp == 9 or cp == 10 or cp == 13 { i = i + 1; }
        else { break; }
    }
    return i;
}

// Recursively rewrite LaTeX macros (\frac{A}{B}, \sqrt{A}, \sqrt[n]{A}, \left...\right, etc.)
fn _normalize_latex(s, depth = 0) {
    if depth > 32 { throw "CAS limit exceeded: nested LaTeX macro depth > 32"; }
    let out = "";
    let n = len(s);
    let i = 0;
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "\\" {
            let j = i + 1;
            while j < n and _is_alpha_cp(strcharcodeat(s, j)) {
                j = j + 1;
            }
            if j == i + 1 {
                // Escaped punctuation like \{, \}, \, , \;
                if j < n {
                    let esc = str_slice(s, j, j + 1);
                    if esc == "," or esc == ";" or esc == "!" or esc == " " {
                        out = out + " ";
                    } else {
                        out = out + esc;
                    }
                    i = j + 1;
                } else {
                    i = i + 1;
                }
            } else {
                let cmd = str_slice(s, i + 1, j);
                if cmd == "left" or cmd == "right" {
                    let k = _skip_spaces(s, j);
                    if k < n {
                        let delim = str_slice(s, k, k + 1);
                        if delim == "[" { out = out + "("; i = k + 1; }
                        else if delim == "]" { out = out + ")"; i = k + 1; }
                        else if delim == "(" or delim == ")" or delim == "|" {
                            out = out + delim;
                            i = k + 1;
                        } else if delim == "\\" and k + 5 <= n and str_slice(s, k, k + 5) == "\\vert" {
                            out = out + "|";
                            i = k + 5;
                        } else {
                            i = j;
                        }
                    } else {
                        i = j;
                    }
                } else if cmd == "frac" or cmd == "dfrac" or cmd == "tfrac" {
                    let k1 = _skip_spaces(s, j);
                    let g1 = _extract_braced(s, k1);
                    if g1 == nil { throw "Expected '{numerator}' after \\frac"; }
                    let k2 = _skip_spaces(s, g1["next_pos"]);
                    let g2 = _extract_braced(s, k2);
                    if g2 == nil { throw "Expected '{denominator}' after \\frac{...}"; }
                    let num_s = _normalize_latex(g1["content"], depth + 1);
                    let den_s = _normalize_latex(g2["content"], depth + 1);
                    out = out + "((" + num_s + ")/(" + den_s + "))";
                    i = g2["next_pos"];
                } else if cmd == "sqrt" {
                    let k1 = _skip_spaces(s, j);
                    if k1 < n and str_slice(s, k1, k1 + 1) == "[" {
                        let close_b = k1 + 1;
                        let b_depth = 1;
                        while close_b < n and b_depth > 0 {
                            let c2 = str_slice(s, close_b, close_b + 1);
                            if c2 == "[" { b_depth = b_depth + 1; }
                            else if c2 == "]" { b_depth = b_depth - 1; }
                            close_b = close_b + 1;
                        }
                        let root_deg = _normalize_latex(str_slice(s, k1 + 1, close_b - 1), depth + 1);
                        let k2 = _skip_spaces(s, close_b);
                        let g = _extract_braced(s, k2);
                        if g == nil { throw "Expected '{radicand}' after \\sqrt[...]"; }
                        let rad_s = _normalize_latex(g["content"], depth + 1);
                        out = out + "((" + rad_s + ")^(1/(" + root_deg + ")))";
                        i = g["next_pos"];
                    } else {
                        let g = _extract_braced(s, k1);
                        if g != nil {
                            let rad_s = _normalize_latex(g["content"], depth + 1);
                            out = out + "sqrt(" + rad_s + ")";
                            i = g["next_pos"];
                        } else {
                            out = out + "sqrt ";
                            i = j;
                        }
                    }
                } else if cmd == "operatorname" {
                    let k1 = _skip_spaces(s, j);
                    let g = _extract_braced(s, k1);
                    if g != nil {
                        let op_nm = str_trim(g["content"]);
                        let next_i = g["next_pos"];
                        if op_nm == "Li" and next_i + 1 < n and str_slice(s, next_i, next_i + 2) == "_2" {
                            op_nm = "Li2";
                            next_i = next_i + 2;
                        } else if op_nm == "Li" and next_i + 3 < n and str_slice(s, next_i, next_i + 4) == "_{2}" {
                            op_nm = "Li2";
                            next_i = next_i + 4;
                        }
                        out = out + " " + op_nm;
                        i = next_i;
                    } else {
                        i = j;
                    }
                } else if cmd == "Gamma" { out = out + " gamma"; i = j; }
                else if cmd == "zeta" { out = out + " zeta"; i = j; }
                else if cmd == "le" or cmd == "leq" { out = out + " <= "; i = j; }
                else if cmd == "ge" or cmd == "geq" { out = out + " >= "; i = j; }
                else if cmd == "ne" or cmd == "neq" { out = out + " != "; i = j; }
                else if cmd == "cdot" or cmd == "times" { out = out + " * "; i = j; }
                else if cmd == "div" { out = out + " / "; i = j; }
                else if cmd == "pi" { out = out + " pi "; i = j; }
                else if cmd == "infty" { out = out + " inf "; i = j; }
                else if cmd == "vert" { out = out + "|"; i = j; }
                else if cmd == "arcsin" { out = out + " asin "; i = j; }
                else if cmd == "arccos" { out = out + " acos "; i = j; }
                else if cmd == "arctan" { out = out + " atan "; i = j; }
                else if _is_known_func(cmd) {
                    out = out + " " + cmd;
                    i = j;
                } else {
                    out = out + " " + cmd + " ";
                    i = j;
                }
            }
        } else if ch == "{" {
            out = out + "(";
            i = i + 1;
        } else if ch == "}" {
            out = out + ")";
            i = i + 1;
        } else {
            out = out + ch;
            i = i + 1;
        }
    }
    return out;
}

// Normalize Unicode math symbols, superscripts, radicals, and LaTeX into clean ASCII tokens.
fn normalize_math_text(raw_s) {
    let s = str(raw_s);
    let max_in = GOV.current_limits()["max_ast_nodes"] * 4;
    if len(s) > max_in {
        throw "MathGovernor[symbolic_cas]: resource budget exceeded (input length " + str(len(s)) + " > " + str(max_in) + ")";
    }
    // Pass 1: Unicode scalar normalization + superscript grouping + √ handling
    let buf = "";
    let n = len(s);
    let i = 0;
    while i < n {
        let cp = strcharcodeat(s, i);
        let sup = _superscript_char_map(cp);
        if sup != "" {
            let sup_run = sup;
            i = i + 1;
            while i < n {
                let s2 = _superscript_char_map(strcharcodeat(s, i));
                if s2 == "" { break; }
                sup_run = sup_run + s2;
                i = i + 1;
            }
            buf = buf + "^(" + sup_run + ")";
        } else if cp == 8804 { buf = buf + " <= "; i = i + 1; }     // ≤
        else if cp == 8805 { buf = buf + " >= "; i = i + 1; }       // ≥
        else if cp == 8800 { buf = buf + " != "; i = i + 1; }       // ≠
        else if cp == 8722 or cp == 8211 { buf = buf + "-"; i = i + 1; } // −, –
        else if cp == 215 or cp == 183 or cp == 8901 { buf = buf + "*"; i = i + 1; } // ×, ·, ⋅
        else if cp == 247 { buf = buf + "/"; i = i + 1; }           // ÷
        else if cp == 960 { buf = buf + " pi "; i = i + 1; }        // π
        else if cp == 8734 { buf = buf + " inf "; i = i + 1; }      // ∞
        else if cp == 8730 {                                         // √
            i = i + 1;
            let k = _skip_spaces(s, i);
            if k < n {
                let next_ch = str_slice(s, k, k + 1);
                if next_ch == "(" or next_ch == "{" {
                    buf = buf + "sqrt";
                    i = k;
                } else {
                    // √x or √12 -> sqrt(atom)
                    let m = k;
                    while m < n {
                        let mcp = strcharcodeat(s, m);
                        if _is_alpha_cp(mcp) or _is_digit_cp(mcp) or mcp == 46 {
                            m = m + 1;
                        } else {
                            break;
                        }
                    }
                    if m > k {
                        buf = buf + "sqrt(" + str_slice(s, k, m) + ")";
                        i = m;
                    } else {
                        buf = buf + "sqrt";
                        i = k;
                    }
                }
            } else {
                buf = buf + "sqrt";
            }
        } else {
            buf = buf + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    // Pass 2: LaTeX macro expansion
    return _normalize_latex(buf, 0);
}

// Lex normalized string into raw tokens: NUM, IDENT, OP, LPAREN, RPAREN, COMMA, BAR, REL
fn _tokenize_raw(s) {
    let max_tok = GOV.current_limits()["max_ast_nodes"] * 2;
    let toks = [];
    let n = len(s);
    let i = 0;
    while i < n {
        let cp = strcharcodeat(s, i);
        if cp == 32 or cp == 9 or cp == 10 or cp == 13 {
            i = i + 1;
        } else if _is_digit_cp(cp) or (cp == 46 and i + 1 < n and _is_digit_cp(strcharcodeat(s, i + 1))) {
            let j = i;
            let saw_dot = false;
            while j < n {
                let c2 = strcharcodeat(s, j);
                if _is_digit_cp(c2) { j = j + 1; }
                else if c2 == 46 and not saw_dot { saw_dot = true; j = j + 1; }
                else { break; }
            }
            // Scientific notation 1.5e-3 ONLY when followed by +/-digits or digits (not 2e^x!)
            if j < n {
                let ec = str_slice(s, j, j + 1);
                if ec == "e" or ec == "E" {
                    let k = j + 1;
                    if k < n and (str_slice(s, k, k + 1) == "+" or str_slice(s, k, k + 1) == "-") {
                        k = k + 1;
                    }
                    if k < n and _is_digit_cp(strcharcodeat(s, k)) {
                        while k < n and _is_digit_cp(strcharcodeat(s, k)) { k = k + 1; }
                        j = k;
                    }
                }
            }
            push(toks, map{ "t": "NUM", "v": str_slice(s, i, j) });
            i = j;
        } else if _is_alpha_cp(cp) {
            let j = i + 1;
            while j < n {
                let c2 = strcharcodeat(s, j);
                if _is_alpha_cp(c2) or _is_digit_cp(c2) { j = j + 1; }
                else { break; }
            }
            let ident_nm = str_slice(s, i, j);
            // Support Lagrange prime derivative notation f'(x), f''(x), f'''(x)
            let p_cnt = 0;
            let pj = j;
            while pj < n and p_cnt < 4 {
                let pcp = strcharcodeat(s, pj);
                if pcp == 39 or pcp == 8242 {
                    p_cnt = p_cnt + 1;
                    pj = pj + 1;
                } else {
                    break;
                }
            }
            if p_cnt > 0 {
                ident_nm = ident_nm + "__d" + str(p_cnt);
                j = pj;
            }
            push(toks, map{ "t": "IDENT", "v": ident_nm });
            i = j;
        } else {
            let ch = str_slice(s, i, i + 1);
            let two = "";
            if i + 1 < n { two = str_slice(s, i, i + 2); }
            if two == "<=" or two == ">=" or two == "!=" or two == "==" {
                let opv = two;
                if opv == "==" { opv = "="; }
                push(toks, map{ "t": "REL", "v": opv });
                i = i + 2;
            } else if two == "**" {
                push(toks, map{ "t": "OP", "v": "^" });
                i = i + 2;
            } else if ch == "=" or ch == "<" or ch == ">" {
                push(toks, map{ "t": "REL", "v": ch });
                i = i + 1;
            } else if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "^" {
                push(toks, map{ "t": "OP", "v": ch });
                i = i + 1;
            } else if ch == "(" or ch == "[" {
                push(toks, map{ "t": "LPAREN", "v": "(" });
                i = i + 1;
            } else if ch == ")" or ch == "]" {
                push(toks, map{ "t": "RPAREN", "v": ")" });
                i = i + 1;
            } else if ch == "," {
                push(toks, map{ "t": "COMMA", "v": "," });
                i = i + 1;
            } else if ch == "|" {
                push(toks, map{ "t": "BAR", "v": "|" });
                i = i + 1;
            } else {
                throw "Unexpected character '" + ch + "' in math input";
            }
        }
        if len(toks) > max_tok {
            throw "MathGovernor[symbolic_cas]: resource budget exceeded (token count > " + str(max_tok) + ")";
        }
    }
    return toks;
}

// Rewrite matched |expr| token pairs into abs(expr) using context-sensitive bar stack.
fn _rewrite_abs_bars(toks) {
    let out = [];
    // Stack holds paren-depth at which an open '|' was started
    let bar_stack = [];
    let p_depth = 0;
    let prev_is_val = false;
    let i = 0;
    while i < len(toks) {
        let tk = toks[i];
        let tt = tk["t"];
        if tt == "LPAREN" {
            p_depth = p_depth + 1;
            push(out, tk);
            prev_is_val = false;
        } else if tt == "RPAREN" {
            p_depth = p_depth - 1;
            push(out, tk);
            prev_is_val = true;
        } else if tt == "BAR" {
            let can_close = prev_is_val and len(bar_stack) > 0 and bar_stack[len(bar_stack) - 1] == p_depth;
            if can_close {
                pop(bar_stack);
                push(out, map{ "t": "RPAREN", "v": ")" });
                prev_is_val = true;
            } else {
                push(bar_stack, p_depth);
                push(out, map{ "t": "IDENT", "v": "abs" });
                push(out, map{ "t": "LPAREN", "v": "(" });
                prev_is_val = false;
            }
        } else if tt == "NUM" or tt == "IDENT" {
            push(out, tk);
            prev_is_val = not (tt == "IDENT" and _is_callable_ident(tk["v"]) and i + 1 < len(toks) and (toks[i + 1]["t"] == "LPAREN" or (toks[i + 1]["t"] == "OP" and toks[i + 1]["v"] == "^")));
        } else {
            push(out, tk);
            prev_is_val = false;
        }
        i = i + 1;
    }
    if len(bar_stack) != 0 {
        throw "Unmatched '|' absolute-value bar in math input";
    }
    return out;
}

// Insert implicit '*' between adjacent multiplicative tokens:
// 2x -> 2*x, 3(x+1) -> 3*(x+1), (x-1)(x+2) -> (x-1)*(x+2), 2 sin(x) -> 2*sin(x), x y -> x*y, a(x+1) -> a*(x+1)
// Preserves registered custom functions f(x), prime derivatives f'(x), and multi-argument calls g(x, a)!
fn _insert_implicit_mul(toks) {
    if len(toks) <= 1 { return toks; }
    // Precompute matching LPAREN index for each RPAREN so \sin^{2}(x) -> sin^(2)(x) keeps (2) attached to (x)
    let open_stack = [];
    let match_open = map{};
    let k = 0;
    while k < len(toks) {
        if toks[k]["t"] == "LPAREN" {
            push(open_stack, k);
        } else if toks[k]["t"] == "RPAREN" and len(open_stack) > 0 {
            let oi = pop(open_stack);
            match_open[str(k)] = oi;
        }
        k = k + 1;
    }
    let out = [];
    let i = 0;
    while i < len(toks) {
        let cur = toks[i];
        push(out, cur);
        if i + 1 < len(toks) {
            let nxt = toks[i + 1];
            let ct = cur["t"];
            let nt = nxt["t"];
            let need_mul = false;
            let is_fn_exp = false;
            if i >= 2 and toks[i - 1]["t"] == "OP" and toks[i - 1]["v"] == "^" and toks[i - 2]["t"] == "IDENT" and _is_callable_ident(toks[i - 2]["v"]) {
                is_fn_exp = true;
            }
            if ct == "RPAREN" and map_has(match_open, str(i)) {
                let open_i = match_open[str(i)];
                if open_i >= 2 and toks[open_i - 1]["t"] == "OP" and toks[open_i - 1]["v"] == "^" and toks[open_i - 2]["t"] == "IDENT" and _is_callable_ident(toks[open_i - 2]["v"]) {
                    is_fn_exp = true;
                }
            }
            if not is_fn_exp {
                if ct == "NUM" {
                    if nt == "IDENT" or nt == "LPAREN" { need_mul = true; }
                } else if ct == "RPAREN" {
                    if nt == "NUM" or nt == "IDENT" or nt == "LPAREN" { need_mul = true; }
                } else if ct == "IDENT" {
                    let is_known = _is_known_func(cur["v"]);
                    let is_call_id = _is_callable_ident(cur["v"]);
                    if is_known {
                        need_mul = false;
                    } else if is_call_id {
                        if nt == "NUM" or nt == "IDENT" { need_mul = true; }
                    } else {
                        if nt == "LPAREN" and _has_top_comma_in_parens(toks, i + 1) {
                            need_mul = false;
                        } else if nt == "NUM" or nt == "IDENT" or nt == "LPAREN" {
                            need_mul = true;
                        }
                    }
                }
            }
            if need_mul {
                push(out, map{ "t": "OP", "v": "*" });
            }
        }
        i = i + 1;
    }
    return out;
}

// Recursive-descent parser over token array with state { toks, pos, depth }
fn _p_peek(st) {
    if st["pos"] >= len(st["toks"]) { return nil; }
    return st["toks"][st["pos"]];
}

fn _p_next(st) {
    let tk = _p_peek(st);
    st["pos"] = st["pos"] + 1;
    return tk;
}

fn _p_enter(st) {
    st["depth"] = st["depth"] + 1;
    let max_d = MAX_AST_DEPTH;
    if map_has(st, "max_depth") { max_d = st["max_depth"]; }
    if st["depth"] > max_d {
        throw "MathGovernor[symbolic_cas.parse]: resource budget exceeded (parse nesting depth > " + str(max_d) + ")";
    }
}

fn _p_leave(st) {
    st["depth"] = st["depth"] - 1;
}

fn _parse_primary(st) {
    _p_enter(st);
    let tk = _p_peek(st);
    if tk == nil {
        throw "Unexpected end of math expression";
    }
    let res = nil;
    if tk["t"] == "NUM" {
        _p_next(st);
        res = parse_numeric_literal(tk["v"]);
    } else if tk["t"] == "LPAREN" {
        _p_next(st);
        res = _parse_add(st);
        let cl = _p_peek(st);
        if cl == nil or cl["t"] != "RPAREN" {
            throw "Expected closing ')'";
        }
        _p_next(st);
    } else if tk["t"] == "IDENT" {
        _p_next(st);
        let nm = tk["v"];
        let nx = _p_peek(st);
        if _is_known_func(nm) {
            // Support sin^2(x) or sin^(2)(x) -> pow(call(sin, [x]), 2)
            if nx != nil and nx["t"] == "OP" and nx["v"] == "^" {
                _p_next(st);
                let fn_exp = _parse_atom_for_fn_exp(st);
                let lp = _p_peek(st);
                if lp != nil and lp["t"] == "LPAREN" {
                    let args = _parse_arg_list(st);
                    res = ast_pow(ast_call(nm, args), fn_exp);
                } else {
                    let arg1 = _parse_unary(st);
                    res = ast_pow(ast_call(nm, [arg1]), fn_exp);
                }
            } else if nx != nil and nx["t"] == "LPAREN" {
                let args = _parse_arg_list(st);
                res = ast_call(nm, args);
            } else if nx != nil and (nx["t"] == "IDENT" or nx["t"] == "NUM") {
                // LaTeX-style \sin x or \ln 2
                let arg1 = _parse_pow(st);
                res = ast_call(nm, [arg1]);
            } else {
                res = ast_sym(nm);
            }
        } else if _is_callable_ident(nm) {
            if nx != nil and nx["t"] == "OP" and nx["v"] == "^" {
                let saved_pos = st["pos"];
                _p_next(st);
                let fn_exp = _parse_atom_for_fn_exp(st);
                let lp = _p_peek(st);
                if lp != nil and lp["t"] == "LPAREN" {
                    let args = _parse_arg_list(st);
                    res = ast_pow(ast_call(nm, args), fn_exp);
                } else {
                    st["pos"] = saved_pos;
                    res = ast_sym(nm);
                }
            } else if nx != nil and nx["t"] == "LPAREN" {
                let args = _parse_arg_list(st);
                res = ast_call(nm, args);
            } else {
                res = ast_sym(nm);
            }
        } else if nx != nil and nx["t"] == "LPAREN" and _has_top_comma_in_parens(st["toks"], st["pos"]) {
            let args = _parse_arg_list(st);
            res = ast_call(nm, args);
        } else {
            res = ast_sym(nm);
        }
    } else {
        throw "Unexpected token '" + tk["v"] + "' in expression";
    }
    _p_leave(st);
    return res;
}

fn _parse_atom_for_fn_exp(st) {
    let tk = _p_peek(st);
    if tk != nil and tk["t"] == "OP" and tk["v"] == "-" {
        _p_next(st);
        return ast_neg(_parse_atom_for_fn_exp(st));
    }
    if tk != nil and tk["t"] == "NUM" {
        _p_next(st);
        return parse_numeric_literal(tk["v"]);
    }
    if tk != nil and tk["t"] == "LPAREN" {
        _p_next(st);
        let inner = _parse_add(st);
        let cl = _p_peek(st);
        if cl == nil or cl["t"] != "RPAREN" { throw "Expected ')' in function exponent"; }
        _p_next(st);
        return inner;
    }
    if tk != nil and tk["t"] == "IDENT" {
        _p_next(st);
        return ast_sym(tk["v"]);
    }
    throw "Expected exponent after function '^'";
}

fn _parse_arg_expr_or_rel(st) {
    let lhs = _parse_add(st);
    let pk = _p_peek(st);
    if pk != nil and pk["t"] == "REL" {
        let op = _p_next(st)["v"];
        let rhs = _parse_add(st);
        return ast_rel(op, lhs, rhs);
    }
    return lhs;
}

fn _parse_arg_list(st) {
    _p_next(st); // consume '('
    let args = [];
    let pk = _p_peek(st);
    if pk != nil and pk["t"] == "RPAREN" {
        _p_next(st);
        return args;
    }
    while true {
        push(args, _parse_arg_expr_or_rel(st));
        let sep = _p_peek(st);
        if sep != nil and sep["t"] == "COMMA" {
            _p_next(st);
        } else if sep != nil and sep["t"] == "RPAREN" {
            _p_next(st);
            break;
        } else {
            throw "Expected ',' or ')' in function call";
        }
    }
    return args;
}

// Right-associative power: primary ('^' unary)?
fn _parse_pow(st) {
    let base_n = _parse_primary(st);
    let tk = _p_peek(st);
    if tk != nil and tk["t"] == "OP" and tk["v"] == "^" {
        _p_next(st);
        let exp_n = _parse_unary(st);
        return ast_pow(base_n, exp_n);
    }
    return base_n;
}

// Unary +/- sits ABOVE power so -x^2 parses as -(x^2) while 2^-3 parses as 2^(-3)!
fn _parse_unary(st) {
    let tk = _p_peek(st);
    if tk != nil and tk["t"] == "OP" {
        if tk["v"] == "-" {
            _p_next(st);
            let inner = _parse_unary(st);
            if is_rat(inner) { return rat_neg(inner); }
            return ast_neg(inner);
        }
        if tk["v"] == "+" {
            _p_next(st);
            return _parse_unary(st);
        }
    }
    return _parse_pow(st);
}

fn _parse_mul(st) {
    let left = _parse_unary(st);
    while true {
        let tk = _p_peek(st);
        if tk != nil and tk["t"] == "OP" and (tk["v"] == "*" or tk["v"] == "/") {
            _p_next(st);
            let right = _parse_unary(st);
            if tk["v"] == "*" {
                if left["kind"] == "mul" {
                    let na = [];
                    let i = 0;
                    while i < len(left["args"]) { push(na, left["args"][i]); i = i + 1; }
                    push(na, right);
                    left = ast_mul(na);
                } else {
                    left = ast_mul([left, right]);
                }
            } else {
                left = ast_div(left, right);
            }
        } else {
            break;
        }
    }
    return left;
}

fn _parse_add(st) {
    let left = _parse_mul(st);
    while true {
        let tk = _p_peek(st);
        if tk != nil and tk["t"] == "OP" and (tk["v"] == "+" or tk["v"] == "-") {
            _p_next(st);
            let right = _parse_mul(st);
            let term = right;
            if tk["v"] == "-" {
                if is_rat(right) { term = rat_neg(right); }
                else { term = ast_neg(right); }
            }
            if left["kind"] == "add" {
                let na = [];
                let i = 0;
                while i < len(left["args"]) { push(na, left["args"][i]); i = i + 1; }
                push(na, term);
                left = ast_add(na);
            } else {
                left = ast_add([left, term]);
            }
        } else {
            break;
        }
    }
    return left;
}

fn _parse_relation_or_expr(st) {
    let first = _parse_add(st);
    let exprs = [first];
    let ops = [];
    while true {
        let tk = _p_peek(st);
        if tk != nil and tk["t"] == "REL" {
            _p_next(st);
            push(ops, tk["v"]);
            push(exprs, _parse_add(st));
        } else {
            break;
        }
    }
    if _p_peek(st) != nil {
        throw "Unexpected trailing token '" + _p_peek(st)["v"] + "'";
    }
    if len(ops) == 0 { return first; }
    if len(ops) == 1 { return ast_rel(ops[0], exprs[0], exprs[1]); }
    let parts = [];
    let i = 0;
    while i < len(ops) {
        push(parts, ast_rel(ops[i], exprs[i], exprs[i + 1]));
        i = i + 1;
    }
    return map{ "kind": "chain_rel", "parts": parts };
}

fn parse_math(input) {
    if input == nil { throw "parse_math: nil input"; }
    if type(input) == "map" and map_has(input, "kind") {
        check_ast_bounds(input);
        return input;
    }
    if type(input) == "number" or type(input) == "bigint" {
        return ast_num(input);
    }
    if type(input) == "array" {
        if len(input) == 0 { throw "parse_math: empty system array"; }
        if len(input) > 128 { throw "CAS limit exceeded: too many equations in system"; }
        let items = [];
        let i = 0;
        while i < len(input) {
            push(items, parse_math(input[i]));
            i = i + 1;
        }
        let sys_node = map{ "kind": "system", "items": items };
        check_ast_bounds(sys_node);
        return sys_node;
    }
    let raw = str_trim(str(input));
    if len(raw) == 0 { throw "parse_math: empty expression string"; }
    let lim = GOV.current_limits();
    if len(raw) > lim["max_input_len"] {
        throw "MathGovernor[symbolic_cas.parse]: resource budget exceeded (input length " + str(len(raw)) + " > " + str(lim["max_input_len"]) + ")";
    }
    if str_contains(raw, ";") {
        let raw_parts = str_split(raw, ";");
        let clean_parts = [];
        let i = 0;
        while i < len(raw_parts) {
            let p = str_trim(raw_parts[i]);
            if len(p) > 0 { push(clean_parts, p); }
            i = i + 1;
        }
        if len(clean_parts) > 1 {
            let items = [];
            let j = 0;
            while j < len(clean_parts) {
                push(items, parse_math(clean_parts[j]));
                j = j + 1;
            }
            let sys_node = map{ "kind": "system", "items": items };
            check_ast_bounds(sys_node);
            return sys_node;
        }
        if len(clean_parts) == 1 { raw = clean_parts[0]; }
    }
    let norm = normalize_math_text(raw);
    let raw_toks = _tokenize_raw(norm);
    if len(raw_toks) == 0 { throw "parse_math: no tokens found"; }
    let bar_toks = _rewrite_abs_bars(raw_toks);
    let mul_toks = _insert_implicit_mul(bar_toks);
    let st = map{ "toks": mul_toks, "pos": 0, "depth": 0, "max_depth": lim["max_ast_depth"] };
    let ast = _parse_relation_or_expr(st);
    check_ast_bounds(ast);
    return ast;
}

// ── Multi-Format Pretty Printers (to_ascii, to_unicode, to_latex) ─────────────

fn _prec_of(node) {
    if node == nil or type(node) != "map" { return 60; }
    let k = node["kind"];
    if k == "rel" or k == "chain_rel" { return 10; }
    if k == "add" or k == "sub" { return 20; }
    if k == "neg" { return 25; }
    if k == "mul" or k == "div" { return 30; }
    if k == "pow" { return 40; }
    if k == "rat" and node["q"] != _BI_ONE { return 30; }
    if k == "rat" and node["p"] < _BI_ZERO { return 25; }
    if k == "num" and node["val"] < 0 { return 25; }
    return 60;
}

// Extract leading negative sign from a term so `a + (-b)` prints cleanly as `a - b`.
// Returns [is_neg_bool, positive_node].
fn _split_term_sign(node) {
    if node == nil or type(node) != "map" { return [false, node]; }
    let k = node["kind"];
    if k == "neg" { return [true, node["arg"]]; }
    if k == "rat" and node["p"] < _BI_ZERO {
        return [true, rat_neg(node)];
    }
    if k == "num" and node["val"] < 0 {
        return [true, ast_num(0.0 - node["val"])];
    }
    if k == "mul" and len(node["args"]) >= 2 {
        let f0 = node["args"][0];
        if is_neg_one_node(f0) {
            let rest = [];
            let i = 1;
            while i < len(node["args"]) { push(rest, node["args"][i]); i = i + 1; }
            return [true, ast_mul(rest)];
        }
        if is_rat(f0) and f0["p"] < _BI_ZERO {
            let rest = [rat_neg(f0)];
            let i = 1;
            while i < len(node["args"]) { push(rest, node["args"][i]); i = i + 1; }
            return [true, ast_mul(rest)];
        }
    }
    if k == "div" {
        let sp = _split_term_sign(node["num"]);
        if sp[0] {
            return [true, ast_div(sp[1], node["den"])];
        }
    }
    return [false, node];
}

fn _int_to_superscript(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if ch == "0" { out = out + "⁰"; }
        else if ch == "1" { out = out + "¹"; }
        else if ch == "2" { out = out + "²"; }
        else if ch == "3" { out = out + "³"; }
        else if ch == "4" { out = out + "⁴"; }
        else if ch == "5" { out = out + "⁵"; }
        else if ch == "6" { out = out + "⁶"; }
        else if ch == "7" { out = out + "⁷"; }
        else if ch == "8" { out = out + "⁸"; }
        else if ch == "9" { out = out + "⁹"; }
        else if ch == "-" { out = out + "⁻"; }
        else if ch == "+" { out = out + "⁺"; }
        else { return ""; }
        i = i + 1;
    }
    return out;
}

fn _ascii_inner(node, parent_prec) {
    if node == nil { return "nil"; }
    if type(node) != "map" { return str(node); }
    let k = node["kind"];
    if k == "system" {
        let parts = [];
        let i = 0;
        while i < len(node["items"]) { push(parts, _ascii_inner(node["items"][i], 0)); i = i + 1; }
        let out = "";
        let j = 0;
        while j < len(parts) {
            if j > 0 { out = out + "; "; }
            out = out + parts[j];
            j = j + 1;
        }
        return out;
    }
    if k == "chain_rel" {
        let pts = node["parts"];
        let s = _ascii_inner(pts[0]["lhs"], 10);
        let i = 0;
        while i < len(pts) {
            s = s + " " + pts[i]["op"] + " " + _ascii_inner(pts[i]["rhs"], 10);
            i = i + 1;
        }
        return s;
    }
    if k == "rel" {
        return _ascii_inner(node["lhs"], 10) + " " + node["op"] + " " + _ascii_inner(node["rhs"], 10);
    }
    if k == "rat" {
        let s = rat_to_str(node);
        let pr = _prec_of(node);
        if pr < parent_prec { return "(" + s + ")"; }
        return s;
    }
    if k == "num" {
        let s = fmt_float(node["val"], 10);
        if node["val"] < 0 and parent_prec > 25 { return "(" + s + ")"; }
        return s;
    }
    if k == "sym" { return node["name"]; }
    if k == "neg" {
        let s = "-" + _ascii_inner(node["arg"], 35);
        if parent_prec > 25 { return "(" + s + ")"; }
        return s;
    }
    if k == "sub" {
        let s = _ascii_inner(node["left"], 20) + " - " + _ascii_inner(node["right"], 21);
        if parent_prec > 20 { return "(" + s + ")"; }
        return s;
    }
    if k == "add" {
        let arr = node["args"];
        if len(arr) == 0 { return "0"; }
        let s = "";
        let i = 0;
        while i < len(arr) {
            let sp = _split_term_sign(arr[i]);
            if i == 0 {
                if sp[0] { s = "-" + _ascii_inner(sp[1], 25); }
                else { s = _ascii_inner(arr[i], 20); }
            } else {
                if sp[0] { s = s + " - " + _ascii_inner(sp[1], 21); }
                else { s = s + " + " + _ascii_inner(arr[i], 20); }
            }
            i = i + 1;
        }
        if parent_prec > 20 { return "(" + s + ")"; }
        return s;
    }
    if k == "mul" {
        let arr = node["args"];
        if len(arr) == 0 { return "1"; }
        let sp = _split_term_sign(node);
        if sp[0] {
            let s_pos = _ascii_inner(sp[1], 30);
            let s_neg = "-" + s_pos;
            if parent_prec > 25 { return "(" + s_neg + ")"; }
            return s_neg;
        }
        let s = "";
        let i = 0;
        while i < len(arr) {
            if i > 0 { s = s + "*"; }
            s = s + _ascii_inner(arr[i], 30);
            i = i + 1;
        }
        if parent_prec > 30 { return "(" + s + ")"; }
        return s;
    }
    if k == "div" {
        let s = _ascii_inner(node["num"], 30) + "/" + _ascii_inner(node["den"], 31);
        if parent_prec > 30 { return "(" + s + ")"; }
        return s;
    }
    if k == "pow" {
        let bs = _ascii_inner(node["base"], 41);
        let es = _ascii_inner(node["exp"], 40);
        let s = bs + "^" + es;
        if parent_prec > 40 { return "(" + s + ")"; }
        return s;
    }
    if k == "call" {
        let args = node["args"];
        let pf = _parse_prime_fn_name(node["fn_name"]);
        let disp_fn = node["fn_name"];
        if pf["order"] > 0 {
            disp_fn = pf["base"];
            let pi = 0;
            while pi < pf["order"] { disp_fn = disp_fn + "'"; pi = pi + 1; }
        }
        let s = disp_fn + "(";
        let i = 0;
        while i < len(args) {
            if i > 0 { s = s + ", "; }
            s = s + _ascii_inner(args[i], 0);
            i = i + 1;
        }
        return s + ")";
    }
    return json_stringify(node);
}

fn to_ascii(node) {
    return _ascii_inner(node, 0);
}

fn _u_op(op) {
    if op == "<=" { return "≤"; }
    if op == ">=" { return "≥"; }
    if op == "!=" { return "≠"; }
    return op;
}

fn _starts_with_digit(s) {
    if len(s) == 0 { return false; }
    return _is_digit_cp(strcharcodeat(s, 0));
}

fn _unicode_inner(node, parent_prec) {
    if node == nil { return "nil"; }
    if type(node) != "map" { return str(node); }
    let k = node["kind"];
    if k == "system" {
        let out = "";
        let i = 0;
        while i < len(node["items"]) {
            if i > 0 { out = out + "; "; }
            out = out + _unicode_inner(node["items"][i], 0);
            i = i + 1;
        }
        return out;
    }
    if k == "chain_rel" {
        let pts = node["parts"];
        let s = _unicode_inner(pts[0]["lhs"], 10);
        let i = 0;
        while i < len(pts) {
            s = s + " " + _u_op(pts[i]["op"]) + " " + _unicode_inner(pts[i]["rhs"], 10);
            i = i + 1;
        }
        return s;
    }
    if k == "rel" {
        return _unicode_inner(node["lhs"], 10) + " " + _u_op(node["op"]) + " " + _unicode_inner(node["rhs"], 10);
    }
    if k == "rat" {
        let s = rat_to_str(node);
        let pr = _prec_of(node);
        if pr < parent_prec { return "(" + s + ")"; }
        return s;
    }
    if k == "num" {
        let s = fmt_float(node["val"], 10);
        if node["val"] < 0 and parent_prec > 25 { return "(" + s + ")"; }
        return s;
    }
    if k == "sym" {
        if node["name"] == "pi" { return "π"; }
        if node["name"] == "inf" { return "∞"; }
        return node["name"];
    }
    if k == "neg" {
        let s = "-" + _unicode_inner(node["arg"], 35);
        if parent_prec > 25 { return "(" + s + ")"; }
        return s;
    }
    if k == "sub" {
        let s = _unicode_inner(node["left"], 20) + " - " + _unicode_inner(node["right"], 21);
        if parent_prec > 20 { return "(" + s + ")"; }
        return s;
    }
    if k == "add" {
        let arr = node["args"];
        if len(arr) == 0 { return "0"; }
        let s = "";
        let i = 0;
        while i < len(arr) {
            let sp = _split_term_sign(arr[i]);
            if i == 0 {
                if sp[0] { s = "-" + _unicode_inner(sp[1], 25); }
                else { s = _unicode_inner(arr[i], 20); }
            } else {
                if sp[0] { s = s + " - " + _unicode_inner(sp[1], 21); }
                else { s = s + " + " + _unicode_inner(arr[i], 20); }
            }
            i = i + 1;
        }
        if parent_prec > 20 { return "(" + s + ")"; }
        return s;
    }
    if k == "mul" {
        let arr = node["args"];
        if len(arr) == 0 { return "1"; }
        let sp = _split_term_sign(node);
        if sp[0] {
            let s_neg = "-" + _unicode_inner(sp[1], 30);
            if parent_prec > 25 { return "(" + s_neg + ")"; }
            return s_neg;
        }
        let s = "";
        let i = 0;
        while i < len(arr) {
            let part = _unicode_inner(arr[i], 31);
            if i == 0 {
                s = part;
            } else {
                let prev_n = arr[i - 1];
                let cur_n = arr[i];
                // Decide whether implicit juxtaposition is unambiguous
                let need_dot = false;
                if _starts_with_digit(part) { need_dot = true; }
                else if prev_n["kind"] == "sym" and len(prev_n["name"]) > 1 and prev_n["name"] != "pi" { need_dot = true; }
                else if cur_n["kind"] == "sym" and prev_n["kind"] == "sym" and prev_n["name"] != "pi" and len(cur_n["name"]) > 1 { need_dot = true; }
                if need_dot { s = s + "·" + part; }
                else { s = s + part; }
            }
            i = i + 1;
        }
        if parent_prec > 30 { return "(" + s + ")"; }
        return s;
    }
    if k == "div" {
        let s = _unicode_inner(node["num"], 30) + "/" + _unicode_inner(node["den"], 31);
        if parent_prec > 30 { return "(" + s + ")"; }
        return s;
    }
    if k == "pow" {
        let bs = _unicode_inner(node["base"], 41);
        if is_int_node(node["exp"]) {
            let sup = _int_to_superscript(str(node["exp"]["p"]));
            if sup != "" {
                let s = bs + sup;
                if parent_prec > 40 { return "(" + s + ")"; }
                return s;
            }
        }
        let es = _unicode_inner(node["exp"], 40);
        let s = bs + "^" + es;
        if parent_prec > 40 { return "(" + s + ")"; }
        return s;
    }
    if k == "call" {
        let fn_nm = node["fn_name"];
        let args = node["args"];
        if fn_nm == "sqrt" and len(args) == 1 {
            let a0 = args[0];
            if (is_int_node(a0) and a0["p"] >= _BI_ZERO) or (a0["kind"] == "sym" and len(a0["name"]) == 1) {
                return "√" + _unicode_inner(a0, 60);
            }
            return "√(" + _unicode_inner(a0, 0) + ")";
        }
        if fn_nm == "abs" and len(args) == 1 {
            return "|" + _unicode_inner(args[0], 0) + "|";
        }
        if fn_nm == "gamma" and len(args) == 1 {
            return "Γ(" + _unicode_inner(args[0], 0) + ")";
        }
        if fn_nm == "igamma" and len(args) == 2 {
            return "Γ(" + _unicode_inner(args[0], 0) + ", " + _unicode_inner(args[1], 0) + ")";
        }
        if fn_nm == "zeta" and len(args) == 1 {
            return "ζ(" + _unicode_inner(args[0], 0) + ")";
        }
        if fn_nm == "lambertw" and len(args) == 1 {
            return "W₀(" + _unicode_inner(args[0], 0) + ")";
        }
        if fn_nm == "Li2" and len(args) == 1 {
            return "Li₂(" + _unicode_inner(args[0], 0) + ")";
        }
        if fn_nm == "besselj" and len(args) == 2 {
            return "J_" + _unicode_inner(args[0], 45) + "(" + _unicode_inner(args[1], 0) + ")";
        }
        let pf_u = _parse_prime_fn_name(fn_nm);
        let disp_u = fn_nm;
        if pf_u["order"] > 0 {
            disp_u = pf_u["base"];
            let pi = 0;
            while pi < pf_u["order"] { disp_u = disp_u + "'"; pi = pi + 1; }
        }
        let s = disp_u + "(";
        let i = 0;
        while i < len(args) {
            if i > 0 { s = s + ", "; }
            s = s + _unicode_inner(args[i], 0);
            i = i + 1;
        }
        return s + ")";
    }
    return _ascii_inner(node, parent_prec);
}

fn to_unicode(node) {
    return _unicode_inner(node, 0);
}

fn _latex_op(op) {
    if op == "<=" { return "\\le"; }
    if op == ">=" { return "\\ge"; }
    if op == "!=" { return "\\neq"; }
    return op;
}

fn _latex_func_cmd(fn_nm) {
    let pf = _parse_prime_fn_name(fn_nm);
    if pf["order"] > 0 {
        let base_cmd = pf["base"];
        if len(base_cmd) > 1 { base_cmd = _latex_func_cmd(base_cmd); }
        let pr_s = "";
        let pi = 0;
        while pi < pf["order"] { pr_s = pr_s + "'"; pi = pi + 1; }
        return base_cmd + pr_s;
    }
    if fn_nm == "sin" or fn_nm == "cos" or fn_nm == "tan" or fn_nm == "cot"
        or fn_nm == "sec" or fn_nm == "csc" or fn_nm == "sinh" or fn_nm == "cosh"
        or fn_nm == "tanh" or fn_nm == "ln" or fn_nm == "log" or fn_nm == "exp"
        or fn_nm == "min" or fn_nm == "max" {
        return "\\" + fn_nm;
    }
    if fn_nm == "asin" { return "\\arcsin"; }
    if fn_nm == "acos" { return "\\arccos"; }
    if fn_nm == "atan" { return "\\arctan"; }
    if fn_nm == "gamma" or fn_nm == "igamma" { return "\\Gamma"; }
    if fn_nm == "zeta" { return "\\zeta"; }
    if fn_nm == "Li2" { return "\\operatorname{Li}_{2}"; }
    if fn_nm == "lambertw" { return "W_{0}"; }
    if fn_nm == "beta" { return "\\mathrm{B}"; }
    if len(fn_nm) == 1 { return fn_nm; }
    return "\\operatorname{" + fn_nm + "}";
}

fn _latex_inner(node, parent_prec) {
    if node == nil { return ""; }
    if type(node) != "map" { return str(node); }
    let k = node["kind"];
    if k == "system" {
        let out = "\\begin{cases} ";
        let i = 0;
        while i < len(node["items"]) {
            if i > 0 { out = out + " \\\\ "; }
            out = out + _latex_inner(node["items"][i], 0);
            i = i + 1;
        }
        return out + " \\end{cases}";
    }
    if k == "chain_rel" {
        let pts = node["parts"];
        let s = _latex_inner(pts[0]["lhs"], 10);
        let i = 0;
        while i < len(pts) {
            s = s + " " + _latex_op(pts[i]["op"]) + " " + _latex_inner(pts[i]["rhs"], 10);
            i = i + 1;
        }
        return s;
    }
    if k == "rel" {
        return _latex_inner(node["lhs"], 10) + " " + _latex_op(node["op"]) + " " + _latex_inner(node["rhs"], 10);
    }
    if k == "rat" {
        if node["q"] == _BI_ONE {
            let s = str(node["p"]);
            if node["p"] < _BI_ZERO and parent_prec > 25 { return "\\left(" + s + "\\right)"; }
            return s;
        }
        if node["p"] < _BI_ZERO {
            let s = "-\\frac{" + str(_BI_ZERO - node["p"]) + "}{" + str(node["q"]) + "}";
            if parent_prec > 25 { return "\\left(" + s + "\\right)"; }
            return s;
        }
        return "\\frac{" + str(node["p"]) + "}{" + str(node["q"]) + "}";
    }
    if k == "num" {
        let s = fmt_float(node["val"], 10);
        if node["val"] < 0 and parent_prec > 25 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "sym" {
        if node["name"] == "pi" { return "\\pi"; }
        if node["name"] == "inf" { return "\\infty"; }
        return node["name"];
    }
    if k == "neg" {
        let s = "-" + _latex_inner(node["arg"], 35);
        if parent_prec > 25 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "sub" {
        let s = _latex_inner(node["left"], 20) + " - " + _latex_inner(node["right"], 21);
        if parent_prec > 20 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "add" {
        let arr = node["args"];
        if len(arr) == 0 { return "0"; }
        let s = "";
        let i = 0;
        while i < len(arr) {
            let sp = _split_term_sign(arr[i]);
            if i == 0 {
                if sp[0] { s = "-" + _latex_inner(sp[1], 25); }
                else { s = _latex_inner(arr[i], 20); }
            } else {
                if sp[0] { s = s + " - " + _latex_inner(sp[1], 21); }
                else { s = s + " + " + _latex_inner(arr[i], 20); }
            }
            i = i + 1;
        }
        if parent_prec > 20 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "mul" {
        let arr = node["args"];
        if len(arr) == 0 { return "1"; }
        let sp = _split_term_sign(node);
        if sp[0] {
            let s_neg = "-" + _latex_inner(sp[1], 30);
            if parent_prec > 25 { return "\\left(" + s_neg + "\\right)"; }
            return s_neg;
        }
        let s = "";
        let i = 0;
        while i < len(arr) {
            let part = _latex_inner(arr[i], 31);
            if i == 0 {
                s = part;
            } else {
                if _starts_with_digit(part) { s = s + " \\cdot " + part; }
                else { s = s + " " + part; }
            }
            i = i + 1;
        }
        if parent_prec > 30 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "div" {
        let s = "\\frac{" + _latex_inner(node["num"], 0) + "}{" + _latex_inner(node["den"], 0) + "}";
        if parent_prec > 35 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "pow" {
        let b = node["base"];
        // Print sin(x)^2 as \sin^{2}\left(x\right) or \left(...\right)^{...}
        let bs = _latex_inner(b, 41);
        if b["kind"] == "rat" and b["q"] != _BI_ONE {
            bs = "\\left(" + _latex_inner(b, 0) + "\\right)";
        }
        let es = _latex_inner(node["exp"], 0);
        let s = bs + "^{" + es + "}";
        if parent_prec > 40 { return "\\left(" + s + "\\right)"; }
        return s;
    }
    if k == "call" {
        let fn_nm = node["fn_name"];
        let args = node["args"];
        if fn_nm == "piecewise" and len(args) >= 2 {
            let pw_ltx = "\\begin{cases} ";
            let pi_idx = 0;
            let row_k = 0;
            while pi_idx + 1 < len(args) {
                if row_k > 0 { pw_ltx = pw_ltx + " \\\\ "; }
                pw_ltx = pw_ltx + _latex_inner(args[pi_idx + 1], 0) + " & " + _latex_inner(args[pi_idx], 0);
                pi_idx = pi_idx + 2;
                row_k = row_k + 1;
            }
            if len(args) - num_floor(len(args) / 2) * 2 == 1 {
                if row_k > 0 { pw_ltx = pw_ltx + " \\\\ "; }
                pw_ltx = pw_ltx + _latex_inner(args[len(args) - 1], 0) + " & \\text{otherwise}";
            }
            return pw_ltx + " \\end{cases}";
        }
        if fn_nm == "sqrt" and len(args) == 1 {
            return "\\sqrt{" + _latex_inner(args[0], 0) + "}";
        }
        if fn_nm == "abs" and len(args) == 1 {
            return "\\left|" + _latex_inner(args[0], 0) + "\\right|";
        }
        if fn_nm == "besselj" and len(args) == 2 {
            return "J_{" + _latex_inner(args[0], 0) + "}\\left(" + _latex_inner(args[1], 0) + "\\right)";
        }
        let cmd = _latex_func_cmd(fn_nm);
        let s = cmd + "\\left(";
        let i = 0;
        while i < len(args) {
            if i > 0 { s = s + ", "; }
            s = s + _latex_inner(args[i], 0);
            i = i + 1;
        }
        return s + "\\right)";
    }
    return _ascii_inner(node, parent_prec);
}

fn to_latex(node) {
    return _latex_inner(node, 0);
}

// ── Step-Trace & Domain-Guard Context ─────────────────────────────────────────

fn _new_ctx() {
    let lim = GOV.current_limits();
    return map{
        "steps": [],
        "guards": [],
        "guard_map": map{},
        "rewrites": 0,
        "lim": lim,
        "trk": GOV.new_tracker("symbolic_cas")
    };
}

fn _bump_rewrite(ctx) {
    if ctx == nil { return; }
    ctx["rewrites"] = ctx["rewrites"] + 1;
    GOV.tick(ctx["trk"], 1);
    let max_rw = MAX_REWRITE_STEPS;
    if map_has(ctx, "lim") { max_rw = ctx["lim"]["max_rewrite_steps"]; }
    if ctx["rewrites"] > max_rw {
        throw "MathGovernor[symbolic_cas]: resource budget exceeded (rewrite steps > " + str(max_rw) + ")";
    }
}

fn _add_guard(ctx, g_str) {
    if ctx == nil or g_str == nil or g_str == "" { return; }
    if not map_has(ctx["guard_map"], g_str) {
        ctx["guard_map"][g_str] = true;
        push(ctx["guards"], g_str);
    }
}

fn _guards_joined(ctx) {
    if ctx == nil or len(ctx["guards"]) == 0 { return nil; }
    let s = "";
    let i = 0;
    while i < len(ctx["guards"]) {
        if i > 0 { s = s + ", "; }
        s = s + ctx["guards"][i];
        i = i + 1;
    }
    return s;
}

fn _record_step(ctx, rule_desc, node, explicit_guard = nil) {
    if ctx == nil or node == nil { return; }
    let asc = to_ascii(node);
    let st_arr = ctx["steps"];
    let g_val = explicit_guard;
    if g_val == nil { g_val = _guards_joined(ctx); }
    if len(st_arr) > 0 {
        let prev = st_arr[len(st_arr) - 1];
        if prev["ascii"] == asc and prev["domain_guard"] == g_val {
            return;
        }
    }
    push(st_arr, map{
        "step": len(st_arr) + 1,
        "rule": rule_desc,
        "ascii": asc,
        "unicode": to_unicode(node),
        "latex": to_latex(node),
        "domain_guard": g_val
    });
}

// ── Exact Q Gauss-Jordan RREF Solver (shared by Partial Fractions & Systems) ──
// aug is M rows x (N + 1) cols of exact `rat` entries.
// Returns { status: "unique"|"inconsistent"|"infinite_parametric", rref, pivot_cols, free_cols, solution }
fn rref_rat(aug_in, n_vars) {
    let m_rows = len(aug_in);
    let mat = [];
    let r = 0;
    while r < m_rows {
        let row_copy = [];
        let c = 0;
        while c <= n_vars {
            push(row_copy, aug_in[r][c]);
            c = c + 1;
        }
        push(mat, row_copy);
        r = r + 1;
    }
    let piv_row = 0;
    let piv_cols = [];
    let col = 0;
    while col < n_vars and piv_row < m_rows {
        let sel = -1;
        let scan = piv_row;
        while scan < m_rows {
            if not rat_is_zero(mat[scan][col]) {
                sel = scan;
                break;
            }
            scan = scan + 1;
        }
        if sel >= 0 {
            if sel != piv_row {
                let tmp = mat[piv_row];
                mat[piv_row] = mat[sel];
                mat[sel] = tmp;
            }
            let piv_val = mat[piv_row][col];
            let j = col;
            while j <= n_vars {
                mat[piv_row][j] = rat_div(mat[piv_row][j], piv_val);
                j = j + 1;
            }
            let ii = 0;
            while ii < m_rows {
                if ii != piv_row and not rat_is_zero(mat[ii][col]) {
                    let factor = mat[ii][col];
                    let jj = col;
                    while jj <= n_vars {
                        mat[ii][jj] = rat_sub(mat[ii][jj], rat_mul(factor, mat[piv_row][jj]));
                        jj = jj + 1;
                    }
                }
                ii = ii + 1;
            }
            push(piv_cols, col);
            piv_row = piv_row + 1;
        }
        col = col + 1;
    }
    // Check for inconsistent 0 = nonzero row
    let check_r = 0;
    while check_r < m_rows {
        let all_z = true;
        let cc = 0;
        while cc < n_vars {
            if not rat_is_zero(mat[check_r][cc]) { all_z = false; break; }
            cc = cc + 1;
        }
        if all_z and not rat_is_zero(mat[check_r][n_vars]) {
            return map{
                "status": "inconsistent",
                "rref": mat,
                "pivot_cols": piv_cols,
                "free_cols": [],
                "solution": nil
            };
        }
        check_r = check_r + 1;
    }
    if len(piv_cols) < n_vars {
        let piv_set = map{};
        let pi = 0;
        while pi < len(piv_cols) { piv_set[str(piv_cols[pi])] = true; pi = pi + 1; }
        let free_cols = [];
        let cc = 0;
        while cc < n_vars {
            if not map_has(piv_set, str(cc)) { push(free_cols, cc); }
            cc = cc + 1;
        }
        return map{
            "status": "infinite_parametric",
            "rref": mat,
            "pivot_cols": piv_cols,
            "free_cols": free_cols,
            "solution": nil
        };
    }
    let sol = [];
    let k = 0;
    while k < n_vars {
        push(sol, mat[k][n_vars]);
        k = k + 1;
    }
    return map{
        "status": "unique",
        "rref": mat,
        "pivot_cols": piv_cols,
        "free_cols": [],
        "solution": sol
    };
}

// ── Exact Dense Univariate Polynomial Engine over Q[x] ───────────────────────
// Represented as array [c_0, c_1, ..., c_d] of `rat`, stripped of trailing zeros.

fn poly_trim(coeffs) {
    let n = len(coeffs);
    while n > 1 and rat_is_zero(coeffs[n - 1]) {
        n = n - 1;
    }
    if n == 0 { return [RAT_ZERO]; }
    let out = [];
    let i = 0;
    while i < n { push(out, coeffs[i]); i = i + 1; }
    return out;
}

fn poly_is_zero(p) {
    if p == nil { return false; }
    return len(p) == 1 and rat_is_zero(p[0]);
}

fn poly_deg(p) {
    if p == nil or poly_is_zero(p) { return -1; }
    return len(p) - 1;
}

fn poly_lc(p) {
    return p[len(p) - 1];
}

fn poly_add(a, b) {
    let m = len(a);
    if len(b) > m { m = len(b); }
    let out = [];
    let i = 0;
    while i < m {
        let ca = RAT_ZERO;
        let cb = RAT_ZERO;
        if i < len(a) { ca = a[i]; }
        if i < len(b) { cb = b[i]; }
        push(out, rat_add(ca, cb));
        i = i + 1;
    }
    return poly_trim(out);
}

fn poly_sub(a, b) {
    let m = len(a);
    if len(b) > m { m = len(b); }
    let out = [];
    let i = 0;
    while i < m {
        let ca = RAT_ZERO;
        let cb = RAT_ZERO;
        if i < len(a) { ca = a[i]; }
        if i < len(b) { cb = b[i]; }
        push(out, rat_sub(ca, cb));
        i = i + 1;
    }
    return poly_trim(out);
}

fn poly_scale(p, s_rat) {
    if rat_is_zero(s_rat) { return [RAT_ZERO]; }
    let out = [];
    let i = 0;
    while i < len(p) { push(out, rat_mul(p[i], s_rat)); i = i + 1; }
    return poly_trim(out);
}

fn poly_mul(a, b) {
    if poly_is_zero(a) or poly_is_zero(b) { return [RAT_ZERO]; }
    let da = len(a) - 1;
    let db = len(b) - 1;
    let max_deg = GOV.current_limits()["max_expand_degree"];
    if da + db > max_deg * 2 {
        throw "MathGovernor[symbolic_cas.poly_mul]: resource budget exceeded (polynomial degree > " + str(max_deg * 2) + ")";
    }
    let out = [];
    let k = 0;
    while k <= da + db { push(out, RAT_ZERO); k = k + 1; }
    let i = 0;
    while i <= da {
        if not rat_is_zero(a[i]) {
            let j = 0;
            while j <= db {
                if not rat_is_zero(b[j]) {
                    out[i + j] = rat_add(out[i + j], rat_mul(a[i], b[j]));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return poly_trim(out);
}

fn poly_pow(p, exp_int) {
    if exp_int < 0 { return nil; }
    if exp_int == 0 { return [RAT_ONE]; }
    let d = poly_deg(p);
    let max_deg = GOV.current_limits()["max_expand_degree"];
    if d > 0 and d * exp_int > max_deg {
        throw "MathGovernor[symbolic_cas.poly_pow]: resource budget exceeded (expansion degree " + str(d * exp_int) + " > " + str(max_deg) + ")";
    }
    let trk = GOV.new_tracker("symbolic_cas.poly_pow");
    let res = [RAT_ONE];
    let base_p = p;
    let e = exp_int;
    while e > 0 {
        GOV.tick(trk, len(res) + len(base_p));
        let half = num_floor(e / 2);
        if e - half * 2 == 1 { res = poly_mul(res, base_p); }
        e = half;
        if e > 0 { base_p = poly_mul(base_p, base_p); }
    }
    return res;
}

// Euclidean polynomial division over Q[x]: returns [quotient, remainder].
fn poly_divmod(a, b) {
    if poly_is_zero(b) { throw "CAS polynomial division by zero"; }
    let rem = poly_trim(a);
    let db = poly_deg(b);
    let da = poly_deg(rem);
    if da < db { return [[RAT_ZERO], rem]; }
    let q_len = da - db + 1;
    let quot = [];
    let i = 0;
    while i < q_len { push(quot, RAT_ZERO); i = i + 1; }
    let lc_b = poly_lc(b);
    let max_deg = GOV.current_limits()["max_expand_degree"];
    let guard = 0;
    while not poly_is_zero(rem) and poly_deg(rem) >= db and guard <= max_deg * 4 {
        let d_cur = poly_deg(rem);
        let shift = d_cur - db;
        let coeff = rat_div(poly_lc(rem), lc_b);
        quot[shift] = rat_add(quot[shift], coeff);
        let j = 0;
        while j <= db {
            let idx = j + shift;
            rem[idx] = rat_sub(rem[idx], rat_mul(coeff, b[j]));
            j = j + 1;
        }
        rem = poly_trim(rem);
        guard = guard + 1;
    }
    return [poly_trim(quot), rem];
}

fn poly_monic(p) {
    if poly_is_zero(p) { return [RAT_ZERO]; }
    return poly_scale(p, rat_div(RAT_ONE, poly_lc(p)));
}

fn poly_gcd(a, b) {
    let x = poly_trim(a);
    let y = poly_trim(b);
    let guard = 0;
    while not poly_is_zero(y) and guard < 256 {
        let dm = poly_divmod(x, y);
        x = y;
        y = dm[1];
        guard = guard + 1;
    }
    return poly_monic(x);
}

fn poly_eval_rat(p, x_rat) {
    let acc = RAT_ZERO;
    let i = len(p) - 1;
    while i >= 0 {
        acc = rat_add(rat_mul(acc, x_rat), p[i]);
        i = i - 1;
    }
    return acc;
}

fn poly_deriv(p) {
    if len(p) <= 1 { return [RAT_ZERO]; }
    let out = [];
    let i = 1;
    while i < len(p) {
        push(out, rat_mul(p[i], rat(i, 1)));
        i = i + 1;
    }
    return poly_trim(out);
}

// Convert AST node to exact Q[v_name] polynomial if possible; returns nil otherwise.
fn ast_to_poly(node, v_name) {
    if node == nil or type(node) != "map" { return nil; }
    let k = node["kind"];
    if k == "rat" { return [node]; }
    if k == "num" {
        let sr = float_snap_rat(node["val"], 1000000, 0.000000000001);
        if sr != nil { return [sr]; }
        return nil;
    }
    if k == "sym" {
        if node["name"] == v_name { return [RAT_ZERO, RAT_ONE]; }
        return nil;
    }
    if k == "neg" {
        let p = ast_to_poly(node["arg"], v_name);
        if p == nil { return nil; }
        return poly_scale(p, RAT_NEG_ONE);
    }
    if k == "sub" {
        let pl = ast_to_poly(node["left"], v_name);
        let pr = ast_to_poly(node["right"], v_name);
        if pl == nil or pr == nil { return nil; }
        return poly_sub(pl, pr);
    }
    if k == "add" {
        let acc = [RAT_ZERO];
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            let pi = ast_to_poly(arr[i], v_name);
            if pi == nil { return nil; }
            acc = poly_add(acc, pi);
            i = i + 1;
        }
        return acc;
    }
    if k == "mul" {
        let acc = [RAT_ONE];
        let arr = node["args"];
        let max_deg = GOV.current_limits()["max_expand_degree"];
        let i = 0;
        while i < len(arr) {
            let pi = ast_to_poly(arr[i], v_name);
            if pi == nil { return nil; }
            if poly_deg(acc) >= 0 and poly_deg(pi) >= 0 and poly_deg(acc) + poly_deg(pi) > max_deg {
                return nil;
            }
            acc = poly_mul(acc, pi);
            i = i + 1;
        }
        return acc;
    }
    if k == "div" {
        let pn = ast_to_poly(node["num"], v_name);
        let pd = ast_to_poly(node["den"], v_name);
        if pn == nil or pd == nil { return nil; }
        if poly_deg(pd) == 0 and not rat_is_zero(pd[0]) {
            return poly_scale(pn, rat_div(RAT_ONE, pd[0]));
        }
        return nil;
    }
    if k == "pow" {
        let pb = ast_to_poly(node["base"], v_name);
        if pb == nil { return nil; }
        if is_int_node(node["exp"]) {
            let ei = int_val_of(node["exp"]);
            if ei >= 0 {
                let d = poly_deg(pb);
                let max_deg = GOV.current_limits()["max_expand_degree"];
                if d > 0 and d * ei > max_deg {
                    throw "MathGovernor[symbolic_cas.ast_to_poly]: resource budget exceeded (polynomial power degree " + str(d * ei) + " > " + str(max_deg) + ")";
                }
                return poly_pow(pb, ei);
            }
        }
        return nil;
    }
    return nil;
}

// Convert Q[v_name] polynomial to canonical descending-degree AST.
fn poly_to_ast(poly, v_name) {
    if poly_is_zero(poly) { return RAT_ZERO; }
    let terms = [];
    let x_sym = ast_sym(v_name);
    let i = len(poly) - 1;
    while i >= 0 {
        let c = poly[i];
        if not rat_is_zero(c) {
            if i == 0 {
                push(terms, c);
            } else {
                let x_part = x_sym;
                if i > 1 { x_part = ast_pow(x_sym, rat(i, 1)); }
                if rat_is_one(c) { push(terms, x_part); }
                else if rat_is_neg_one(c) { push(terms, ast_neg(x_part)); }
                else { push(terms, ast_mul([c, x_part])); }
            }
        }
        i = i - 1;
    }
    if len(terms) == 0 { return RAT_ZERO; }
    return ast_add(terms);
}

// Extract rational content c in Q and primitive integer polynomial P_prim in Z[x] with lc > 0
// such that poly = c * P_prim.
fn poly_content_and_primitive(poly) {
    if poly_is_zero(poly) {
        return map{ "content": RAT_ZERO, "prim": [RAT_ZERO] };
    }
    let lcm_den = _BI_ONE;
    let i = 0;
    while i < len(poly) {
        if not rat_is_zero(poly[i]) {
            lcm_den = bi_lcm(lcm_den, poly[i]["q"]);
        }
        i = i + 1;
    }
    let int_coeffs = [];
    let gcd_num = _BI_ZERO;
    i = 0;
    while i < len(poly) {
        let ic = (poly[i]["p"] * lcm_den) / poly[i]["q"];
        push(int_coeffs, ic);
        if ic != _BI_ZERO {
            if gcd_num == _BI_ZERO { gcd_num = bi_abs(ic); }
            else { gcd_num = bi_gcd(gcd_num, ic); }
        }
        i = i + 1;
    }
    if gcd_num == _BI_ZERO { gcd_num = _BI_ONE; }
    let sgn = _BI_ONE;
    if int_coeffs[len(int_coeffs) - 1] < _BI_ZERO {
        sgn = _BI_NEG_ONE;
    }
    let content = rat(sgn * gcd_num, lcm_den);
    let prim = [];
    i = 0;
    while i < len(int_coeffs) {
        push(prim, rat(sgn * (int_coeffs[i] / gcd_num), _BI_ONE));
        i = i + 1;
    }
    return map{ "content": content, "prim": poly_trim(prim) };
}

// Find all distinct rational roots of polynomial p in sorted ascending order via Rational Root Theorem.
fn poly_rational_roots(poly) {
    if poly_is_zero(poly) or poly_deg(poly) <= 0 { return []; }
    let cp = poly_content_and_primitive(poly);
    let prim = cp["prim"];
    let roots = [];
    // Check x = 0 root
    let k0 = 0;
    while k0 < len(prim) and rat_is_zero(prim[k0]) { k0 = k0 + 1; }
    if k0 > 0 {
        push(roots, RAT_ZERO);
    }
    if k0 >= len(prim) - 1 { return roots; }
    let cur = [];
    let i = k0;
    while i < len(prim) { push(cur, prim[i]); i = i + 1; }
    let a0 = bi_abs(cur[0]["p"]);
    let an = bi_abs(cur[len(cur) - 1]["p"]);
    let p_divs = bi_divisors(a0);
    let q_divs = bi_divisors(an);
    let seen = map{};
    if k0 > 0 { seen["0"] = true; }
    let pi = 0;
    while pi < len(p_divs) {
        let qi = 0;
        while qi < len(q_divs) {
            if len(seen) > 1024 { break; }
            let cand_pos = rat(p_divs[pi], q_divs[qi]);
            let key_pos = rat_to_str(cand_pos);
            if not map_has(seen, key_pos) {
                seen[key_pos] = true;
                if rat_is_zero(poly_eval_rat(cur, cand_pos)) {
                    push(roots, cand_pos);
                }
                let cand_neg = rat_neg(cand_pos);
                if rat_is_zero(poly_eval_rat(cur, cand_neg)) {
                    push(roots, cand_neg);
                }
            }
            qi = qi + 1;
        }
        pi = pi + 1;
    }
    // Sort roots ascending
    let n = len(roots);
    let a = 1;
    while a < n {
        let kr = roots[a];
        let b = a - 1;
        while b >= 0 and rat_cmp(roots[b], kr) > 0 {
            roots[b + 1] = roots[b];
            b = b - 1;
        }
        roots[b + 1] = kr;
        a = a + 1;
    }
    return roots;
}

// Complete factorization over Z/Q:
// Extracts rational content, x^k, linear factors (qx - p)^m via Bezout synthetic division,
// and biquadratic factors (a x^4 + b x^2 + c) when factorable over Q!
fn poly_factor_Q(poly, v_name) {
    if poly_is_zero(poly) {
        return map{ "content": RAT_ZERO, "factors": [], "ast": RAT_ZERO };
    }
    if poly_deg(poly) == 0 {
        return map{ "content": poly[0], "factors": [], "ast": poly[0] };
    }
    let cp = poly_content_and_primitive(poly);
    let content = cp["content"];
    let cur = cp["prim"];
    let factors = []; // elements: { poly, mult }

    // 1. Extract x^k
    let x_mult = 0;
    while len(cur) > 1 and rat_is_zero(cur[0]) {
        let shifted = [];
        let i = 1;
        while i < len(cur) { push(shifted, cur[i]); i = i + 1; }
        cur = shifted;
        x_mult = x_mult + 1;
    }
    if x_mult > 0 {
        push(factors, map{ "poly": [RAT_ZERO, RAT_ONE], "mult": x_mult });
    }

    // 2. Extract rational linear factors (q*x - p) via Rational Root Theorem + synthetic division
    if poly_deg(cur) >= 1 {
        let r_list = poly_rational_roots(cur);
        let ri = 0;
        while ri < len(r_list) and poly_deg(cur) >= 1 {
            let r = r_list[ri];
            // Primitive integer linear factor is (q*x - p) where r = p/q
            let lin = [rat(_BI_ZERO - r["p"], _BI_ONE), rat(r["q"], _BI_ONE)];
            let m = 0;
            while poly_deg(cur) >= 1 and rat_is_zero(poly_eval_rat(cur, r)) {
                let dm = poly_divmod(cur, lin);
                if not poly_is_zero(dm[1]) { break; }
                cur = dm[0];
                m = m + 1;
            }
            if m > 0 {
                push(factors, map{ "poly": lin, "mult": m });
            }
            ri = ri + 1;
        }
    }

    // 3. Check biquadratic cur = a*x^4 + b*x^2 + c with rational roots in u = x^2
    if poly_deg(cur) == 4 and rat_is_zero(cur[1]) and rat_is_zero(cur[3]) {
        let u_poly = [cur[0], cur[2], cur[4]];
        let u_roots = poly_rational_roots(u_poly);
        if len(u_roots) > 0 {
            let u_rem = u_poly;
            let ui = 0;
            while ui < len(u_roots) {
                let ur = u_roots[ui];
                let u_lin = [rat(_BI_ZERO - ur["p"], _BI_ONE), rat(ur["q"], _BI_ONE)];
                let um = 0;
                while poly_deg(u_rem) >= 1 and rat_is_zero(poly_eval_rat(u_rem, ur)) {
                    let dm = poly_divmod(u_rem, u_lin);
                    if not poly_is_zero(dm[1]) { break; }
                    u_rem = dm[0];
                    um = um + 1;
                }
                if um > 0 {
                    let q_fac = [rat(_BI_ZERO - ur["p"], _BI_ONE), RAT_ZERO, rat(ur["q"], _BI_ONE)];
                    push(factors, map{ "poly": q_fac, "mult": um });
                }
                ui = ui + 1;
            }
            if poly_deg(u_rem) == 1 {
                let q_tail = [u_rem[0], RAT_ZERO, u_rem[1]];
                let c_tail = poly_content_and_primitive(q_tail);
                content = rat_mul(content, c_tail["content"]);
                push(factors, map{ "poly": c_tail["prim"], "mult": 1 });
                cur = [RAT_ONE];
            } else if poly_deg(u_rem) == 0 {
                content = rat_mul(content, u_rem[0]);
                cur = [RAT_ONE];
            }
        }
    }

    // 4. Remaining irreducible polynomial factor
    if poly_deg(cur) >= 1 {
        let cp_rem = poly_content_and_primitive(cur);
        content = rat_mul(content, cp_rem["content"]);
        push(factors, map{ "poly": cp_rem["prim"], "mult": 1 });
    } else if poly_deg(cur) == 0 {
        content = rat_mul(content, cur[0]);
    }

    // Build factored AST product
    let prod_args = [];
    let neg_lead = false;
    let abs_content = content;
    if rat_is_neg(content) {
        neg_lead = true;
        abs_content = rat_neg(content);
    }
    if not rat_is_one(abs_content) {
        push(prod_args, abs_content);
    }
    let fi = 0;
    while fi < len(factors) {
        let f_ast = poly_to_ast(factors[fi]["poly"], v_name);
        if factors[fi]["mult"] > 1 {
            f_ast = ast_pow(f_ast, rat(factors[fi]["mult"], 1));
        }
        factors[fi]["ast"] = f_ast;
        push(prod_args, f_ast);
        fi = fi + 1;
    }
    let res_ast = RAT_ONE;
    if len(prod_args) > 0 { res_ast = ast_mul(prod_args); }
    if neg_lead {
        if is_rat(res_ast) { res_ast = rat_neg(res_ast); }
        else { res_ast = ast_neg(res_ast); }
    }
    return map{
        "content": content,
        "factors": factors,
        "ast": res_ast
    };
}

// ── Exact Trigonometric Special Angle Evaluator ───────────────────────────────
// Recognizes k * pi / n (including 0) and evaluates sin, cos, tan to exact surd AST!

fn _extract_pi_multiple(node) {
    // Returns exact `rat` k if node == k * pi (or 0 if node == 0), else nil.
    if is_zero_node(node) { return RAT_ZERO; }
    if node["kind"] == "sym" and node["name"] == "pi" { return RAT_ONE; }
    if node["kind"] == "neg" {
        let inner = _extract_pi_multiple(node["arg"]);
        if inner != nil { return rat_neg(inner); }
        return nil;
    }
    if node["kind"] == "div" {
        let num_k = _extract_pi_multiple(node["num"]);
        if num_k != nil and is_rat(node["den"]) and not rat_is_zero(node["den"]) {
            return rat_div(num_k, node["den"]);
        }
        return nil;
    }
    if node["kind"] == "mul" {
        let coeff = RAT_ONE;
        let saw_pi = false;
        let arr = node["args"];
        let i = 0;
        while i < len(arr) {
            let f = arr[i];
            if is_rat(f) {
                coeff = rat_mul(coeff, f);
            } else if f["kind"] == "sym" and f["name"] == "pi" and not saw_pi {
                saw_pi = true;
            } else {
                return nil;
            }
            i = i + 1;
        }
        if saw_pi { return coeff; }
    }
    return nil;
}

// Exact sin(k * pi) for rational k with denominator dividing 12!
fn _exact_sin_pi_rat(k_rat) {
    // Reduce k modulo 2 into [0, 2)
    let p = k_rat["p"];
    let q = k_rat["q"];
    // Only exact table for denominators dividing 12 (1, 2, 3, 4, 6, 12)
    if bi_mod(bigint(12), q) != _BI_ZERO { return nil; }
    let scale = bigint(12) / q;
    let twelfths = bi_mod(p * scale, bigint(24));
    if twelfths < _BI_ZERO { twelfths = twelfths + bigint(24); }
    let idx = num_round(bi_to_float(twelfths));
    let neg_flag = false;
    if idx >= 12 {
        neg_flag = true;
        idx = idx - 12;
    }
    if idx > 6 {
        idx = 12 - idx;
    }
    // Now idx in 0..6 representing idx * pi / 12 in [0, pi/2]
    let val = nil;
    if idx == 0 { val = RAT_ZERO; }
    else if idx == 1 {
        // sin(pi/12) = (sqrt(6) - sqrt(2)) / 4
        val = ast_mul([rat(1, 4), ast_add([ast_call("sqrt", [rat(6, 1)]), ast_neg(ast_call("sqrt", [rat(2, 1)]))])]);
    }
    else if idx == 2 { val = RAT_HALF; } // pi/6 -> 1/2
    else if idx == 3 { val = ast_mul([RAT_HALF, ast_call("sqrt", [RAT_TWO])]); } // pi/4 -> sqrt(2)/2
    else if idx == 4 { val = ast_mul([RAT_HALF, ast_call("sqrt", [rat(3, 1)])]); } // pi/3 -> sqrt(3)/2
    else if idx == 5 {
        // sin(5*pi/12) = (sqrt(6) + sqrt(2)) / 4
        val = ast_mul([rat(1, 4), ast_add([ast_call("sqrt", [rat(6, 1)]), ast_call("sqrt", [rat(2, 1)])])]);
    }
    else if idx == 6 { val = RAT_ONE; } // pi/2 -> 1
    if val == nil { return nil; }
    if neg_flag {
        if is_rat(val) { return rat_neg(val); }
        return ast_neg(val);
    }
    return val;
}

fn _exact_cos_pi_rat(k_rat) {
    return _exact_sin_pi_rat(rat_sub(RAT_HALF, k_rat));
}

fn _exact_tan_pi_rat(k_rat) {
    let p = k_rat["p"];
    let q = k_rat["q"];
    if bi_mod(bigint(12), q) != _BI_ZERO { return nil; }
    let scale = bigint(12) / q;
    let twelfths = bi_mod(p * scale, bigint(12));
    if twelfths < _BI_ZERO { twelfths = twelfths + bigint(12); }
    let idx = num_round(bi_to_float(twelfths));
    if idx == 6 { return nil; } // pole at pi/2
    let neg_flag = false;
    if idx > 6 {
        neg_flag = true;
        idx = 12 - idx;
    }
    let val = nil;
    if idx == 0 { val = RAT_ZERO; }
    else if idx == 1 { val = ast_add([RAT_TWO, ast_neg(ast_call("sqrt", [rat(3, 1)]))]); } // 2 - sqrt(3)
    else if idx == 2 { val = ast_mul([rat(1, 3), ast_call("sqrt", [rat(3, 1)])]); }        // sqrt(3)/3
    else if idx == 3 { val = RAT_ONE; }                                                    // 1
    else if idx == 4 { val = ast_call("sqrt", [rat(3, 1)]); }                              // sqrt(3)
    else if idx == 5 { val = ast_add([RAT_TWO, ast_call("sqrt", [rat(3, 1)])]); }          // 2 + sqrt(3)
    if val == nil { return nil; }
    if neg_flag {
        if is_rat(val) { return rat_neg(val); }
        return ast_neg(val);
    }
    return val;
}

// ── Canonical Algebraic Simplifier ────────────────────────────────────────────

fn _degree_hint(node) {
    if node == nil or type(node) != "map" { return 0; }
    let k = node["kind"];
    if k == "rat" or k == "num" { return 0; }
    if k == "sym" {
        if is_const_sym(node["name"]) { return 0; }
        return 1;
    }
    if k == "pow" and is_int_node(node["exp"]) {
        return _degree_hint(node["base"]) * int_val_of(node["exp"]);
    }
    if k == "mul" {
        let d = 0;
        let i = 0;
        while i < len(node["args"]) { d = d + _degree_hint(node["args"][i]); i = i + 1; }
        return d;
    }
    if k == "neg" { return _degree_hint(node["arg"]); }
    return 1;
}

// Order sum terms so higher-degree algebraic terms appear first (e.g. x^2 - 5*x + 6)
fn _term_cmp_for_sum(a, b) {
    let da = _degree_hint(a);
    let db = _degree_hint(b);
    if da > db { return -1; }
    if da < db { return 1; }
    return ast_cmp(a, b);
}

fn _sort_nodes(arr, for_sum = false) {
    let out = [];
    let i = 0;
    while i < len(arr) { push(out, arr[i]); i = i + 1; }
    let n = len(out);
    let a = 1;
    while a < n {
        let key = out[a];
        let b = a - 1;
        while b >= 0 {
            let cmp = 0;
            if for_sum { cmp = _term_cmp_for_sum(out[b], key); }
            else { cmp = ast_cmp(out[b], key); }
            if cmp > 0 {
                out[b + 1] = out[b];
                b = b - 1;
            } else {
                break;
            }
        }
        out[b + 1] = key;
        a = a + 1;
    }
    return out;
}

// Decompose an additive term into [coeff_rat, body_node] where body_node has unit positive coeff.
fn _split_coeff_body(term) {
    if is_rat(term) { return [term, RAT_ONE]; }
    if term["kind"] == "num" {
        let sr = float_snap_rat(term["val"], 1000000, 0.000000000001);
        if sr != nil { return [sr, RAT_ONE]; }
        return [RAT_ONE, term];
    }
    if term["kind"] == "neg" {
        let sub_sp = _split_coeff_body(term["arg"]);
        return [rat_neg(sub_sp[0]), sub_sp[1]];
    }
    if term["kind"] == "mul" {
        let coeff = RAT_ONE;
        let rest = [];
        let arr = term["args"];
        let i = 0;
        while i < len(arr) {
            if is_rat(arr[i]) { coeff = rat_mul(coeff, arr[i]); }
            else { push(rest, arr[i]); }
            i = i + 1;
        }
        if len(rest) == 0 { return [coeff, RAT_ONE]; }
        return [coeff, ast_mul(rest)];
    }
    return [RAT_ONE, term];
}

// Decompose a multiplicative factor into [base_node, exp_node] for power folding.
fn _split_base_exp(fac) {
    if fac["kind"] == "pow" {
        return [fac["base"], fac["exp"]];
    }
    if fac["kind"] == "div" and is_one_node(fac["num"]) {
        if fac["den"]["kind"] == "pow" {
            return [fac["den"]["base"], ast_neg(fac["den"]["exp"])];
        }
        return [fac["den"], RAT_NEG_ONE];
    }
    return [fac, RAT_ONE];
}

// Simplify sqrt(arg) where arg is already simplified.
fn _simplify_sqrt(u, ctx) {
    if is_zero_node(u) { return RAT_ZERO; }
    if is_one_node(u) { return RAT_ONE; }
    if is_rat(u) and rat_is_pos(u) {
        // sqrt(p/q) = sqrt(p*q) / q
        let prod_pq = u["p"] * u["q"];
        let sp = bi_square_split(prod_pq);
        let s_out = sp[0];
        let rem = sp[1];
        let coeff = rat(s_out, u["q"]);
        if rem == _BI_ONE {
            return coeff;
        }
        let rad = ast_call("sqrt", [rat(rem, 1)]);
        if rat_is_one(coeff) { return rad; }
        return ast_mul([coeff, rad]);
    }
    // sqrt(u^2) -> abs(u), sqrt(u^(2k)) -> abs(u)^k (or u^k when k is even)
    if u["kind"] == "pow" and is_int_node(u["exp"]) {
        let ei = int_val_of(u["exp"]);
        let half = num_floor(ei / 2);
        if ei > 0 and ei - half * 2 == 0 {
            let abs_b = ast_call("abs", [u["base"]]);
            if half == 1 { return abs_b; }
            let quarter = num_floor(half / 2);
            if half - quarter * 2 == 0 {
                return ast_pow(u["base"], rat(half, 1));
            }
            return ast_pow(abs_b, rat(half, 1));
        }
    }
    // sqrt(c * A^2) for positive rational c -> simplify_sqrt(c) * simplify_sqrt(A^2)
    if u["kind"] == "mul" {
        let r_part = RAT_ONE;
        let sq_factors = [];
        let rem_factors = [];
        let arr = u["args"];
        let i = 0;
        while i < len(arr) {
            let fi = arr[i];
            if is_rat(fi) and rat_is_pos(fi) {
                r_part = rat_mul(r_part, fi);
            } else if fi["kind"] == "pow" and is_int_node(fi["exp"]) {
                let ei = int_val_of(fi["exp"]);
                let half = num_floor(ei / 2);
                if ei >= 2 and ei - half * 2 == 0 {
                    let abs_b = ast_call("abs", [fi["base"]]);
                    if half == 1 { push(sq_factors, abs_b); }
                    else { push(sq_factors, ast_pow(abs_b, rat(half, 1))); }
                } else {
                    push(rem_factors, fi);
                }
            } else {
                push(rem_factors, fi);
            }
            i = i + 1;
        }
        if not rat_is_one(r_part) or len(sq_factors) > 0 {
            let out_mul = [];
            if not rat_is_one(r_part) {
                push(out_mul, _simplify_sqrt(r_part, ctx));
            }
            let j = 0;
            while j < len(sq_factors) { push(out_mul, sq_factors[j]); j = j + 1; }
            if len(rem_factors) > 0 {
                push(out_mul, ast_call("sqrt", [ast_mul(rem_factors)]));
            }
            if len(out_mul) > 1 or len(rem_factors) == 0 {
                return simplify_node(ast_mul(out_mul), ctx);
            }
        }
    }
    return ast_call("sqrt", [u]);
}

fn _simplify_call(fn_nm, args, ctx) {
    if len(args) == 0 { return ast_call(fn_nm, args); }
    let u = args[0];
    if fn_nm == "sqrt" {
        return _simplify_sqrt(u, ctx);
    }
    if fn_nm == "abs" {
        if is_rat(u) { return rat_abs(u); }
        if u["kind"] == "num" { return ast_num(num_abs(u["val"])); }
        if u["kind"] == "neg" { return ast_call("abs", [u["arg"]]); }
        if u["kind"] == "call" and u["fn_name"] == "abs" { return u; }
        if u["kind"] == "mul" and len(u["args"]) >= 2 and is_rat(u["args"][0]) {
            let c_abs = rat_abs(u["args"][0]);
            let rest = [];
            let i = 1;
            while i < len(u["args"]) { push(rest, u["args"][i]); i = i + 1; }
            let inner_abs = ast_call("abs", [ast_mul(rest)]);
            if rat_is_one(c_abs) { return inner_abs; }
            return ast_mul([c_abs, inner_abs]);
        }
        return ast_call("abs", [u]);
    }
    if fn_nm == "ln" or fn_nm == "log" {
        if fn_nm == "ln" or (fn_nm == "log" and len(args) == 1) {
            if is_one_node(u) { return RAT_ZERO; }
            if u["kind"] == "sym" and u["name"] == "e" { return RAT_ONE; }
            if u["kind"] == "call" and u["fn_name"] == "exp" and len(u["args"]) == 1 {
                return u["args"][0];
            }
            if u["kind"] == "pow" and u["base"]["kind"] == "sym" and u["base"]["name"] == "e" {
                return u["exp"];
            }
        }
        return ast_call(fn_nm, args);
    }
    if fn_nm == "exp" {
        if is_zero_node(u) { return RAT_ONE; }
        if u["kind"] == "call" and u["fn_name"] == "ln" and len(u["args"]) == 1 {
            let inner = u["args"][0];
            if len(free_vars(inner)) > 0 { _add_guard(ctx, to_ascii(inner) + " > 0"); }
            return inner;
        }
        if u["kind"] == "mul" {
            // exp(k * ln(A)) -> A^k
            let arr = u["args"];
            let ln_arg = nil;
            let others = [];
            let i = 0;
            while i < len(arr) {
                if ln_arg == nil and arr[i]["kind"] == "call" and arr[i]["fn_name"] == "ln" and len(arr[i]["args"]) == 1 {
                    ln_arg = arr[i]["args"][0];
                } else {
                    push(others, arr[i]);
                }
                i = i + 1;
            }
            if ln_arg != nil {
                if len(free_vars(ln_arg)) > 0 { _add_guard(ctx, to_ascii(ln_arg) + " > 0"); }
                return simplify_node(ast_pow(ln_arg, ast_mul(others)), ctx);
            }
        }
        return ast_call("exp", [u]);
    }
    if fn_nm == "sin" or fn_nm == "cos" or fn_nm == "tan" {
        // Exact special angles k * pi / n
        let k_pi = _extract_pi_multiple(u);
        if k_pi != nil {
            let ex = nil;
            if fn_nm == "sin" { ex = _exact_sin_pi_rat(k_pi); }
            else if fn_nm == "cos" { ex = _exact_cos_pi_rat(k_pi); }
            else if fn_nm == "tan" { ex = _exact_tan_pi_rat(k_pi); }
            if ex != nil { return simplify_node(ex, ctx); }
        }
        // Odd/even parity normalization when leading term is negative
        let sp = _split_term_sign(u);
        if sp[0] {
            let pos_call = _simplify_call(fn_nm, [sp[1]], ctx);
            if fn_nm == "cos" { return pos_call; }
            return simplify_node(ast_neg(pos_call), ctx);
        }
    }
    return ast_call(fn_nm, args);
}

fn _simplify_pow(b, e, ctx) {
    if is_zero_node(e) {
        if not is_zero_node(b) and len(free_vars(b)) > 0 {
            _add_guard(ctx, to_ascii(b) + " != 0");
        }
        return RAT_ONE;
    }
    if is_one_node(e) { return b; }
    if is_one_node(b) { return RAT_ONE; }
    if is_zero_node(b) {
        if is_rat(e) and rat_is_pos(e) { return RAT_ZERO; }
        if e["kind"] == "num" and e["val"] > 0 { return RAT_ZERO; }
        return ast_pow(b, e);
    }
    // e^(ln(u)) -> u
    if b["kind"] == "sym" and b["name"] == "e" {
        if e["kind"] == "call" and e["fn_name"] == "ln" and len(e["args"]) == 1 {
            let inner = e["args"][0];
            if len(free_vars(inner)) > 0 { _add_guard(ctx, to_ascii(inner) + " > 0"); }
            return inner;
        }
    }
    // Rational base to integer power
    if is_rat(b) and is_int_node(e) {
        let ei = int_val_of(e);
        if num_abs(ei) <= 128 {
            return rat_pow_int(b, ei);
        }
    }
    // Rational base to 1/2 power -> sqrt
    if is_rat(e) and e["p"] == _BI_ONE and e["q"] == _BI_TWO {
        return _simplify_sqrt(b, ctx);
    }
    // Rational base to k/3 power when base is an exact rational cube (e.g. \sqrt[3]{8} -> 2)
    if is_rat(b) and is_rat(e) and e["q"] == bigint(3) {
        let cp = _bi_icbrt_exact(b["p"]);
        let cq = _bi_icbrt_exact(b["q"]);
        if cp != nil and cq != nil {
            let ek = num_round(bi_to_float(e["p"]));
            if num_abs(ek) <= 64 {
                return rat_pow_int(rat(cp, cq), ek);
            }
        }
    }
    // (sqrt(u))^n
    if b["kind"] == "call" and b["fn_name"] == "sqrt" and len(b["args"]) == 1 and is_int_node(e) {
        let ei = int_val_of(e);
        let u = b["args"][0];
        if ei >= 2 {
            let half = num_floor(ei / 2);
            if len(free_vars(u)) > 0 and (half - num_floor(half / 2) * 2 != 0) {
                _add_guard(ctx, to_ascii(u) + " >= 0");
            }
            if ei - half * 2 == 0 {
                return simplify_node(ast_pow(u, rat(half, 1)), ctx);
            }
            return simplify_node(ast_mul([ast_pow(u, rat(half, 1)), ast_call("sqrt", [u])]), ctx);
        }
    }
    // abs(u)^(2k) -> u^(2k)
    if b["kind"] == "call" and b["fn_name"] == "abs" and len(b["args"]) == 1 and is_int_node(e) {
        let ei = int_val_of(e);
        let half = num_floor(ei / 2);
        if ei >= 2 and ei - half * 2 == 0 {
            return simplify_node(ast_pow(b["args"][0], e), ctx);
        }
    }
    // (-u)^n for integer n
    let sp_b = _split_term_sign(b);
    if sp_b[0] and is_int_node(e) and b["kind"] != "add" {
        let ei = int_val_of(e);
        let half = num_floor(ei / 2);
        let pos_pow = _simplify_pow(sp_b[1], e, ctx);
        if ei - half * 2 == 0 { return pos_pow; }
        return simplify_node(ast_neg(pos_pow), ctx);
    }
    // (A * B)^n -> A^n * B^n for integer n
    let max_deg_p = GOV.current_limits()["max_expand_degree"];
    if ctx != nil and map_has(ctx, "lim") { max_deg_p = ctx["lim"]["max_expand_degree"]; }
    if b["kind"] == "mul" and is_int_node(e) {
        let ei = int_val_of(e);
        if num_abs(ei) <= max_deg_p {
            let parts = [];
            let i = 0;
            while i < len(b["args"]) {
                push(parts, _simplify_pow(b["args"][i], e, ctx));
                i = i + 1;
            }
            return simplify_node(ast_mul(parts), ctx);
        }
    }
    // (A / B)^n -> A^n / B^n for integer n
    if b["kind"] == "div" and is_int_node(e) {
        let ei = int_val_of(e);
        if num_abs(ei) <= max_deg_p {
            if ei > 0 {
                return simplify_node(ast_div(_simplify_pow(b["num"], e, ctx), _simplify_pow(b["den"], e, ctx)), ctx);
            }
            let pos_e = rat(0 - ei, 1);
            return simplify_node(ast_div(_simplify_pow(b["den"], pos_e, ctx), _simplify_pow(b["num"], pos_e, ctx)), ctx);
        }
    }
    // (x^a)^b -> x^(a*b) when b is integer (safe when a is integer or b is odd; note (x^2)^(1/2) is handled by sqrt(x^2)->abs(x)!)
    if b["kind"] == "pow" and is_int_node(e) {
        let prod_exp = simplify_node(ast_mul([b["exp"], e]), ctx);
        return _simplify_pow(b["base"], prod_exp, ctx);
    }
    return ast_pow(b, e);
}

fn _contains_div(node) {
    if node == nil or type(node) != "map" { return false; }
    let k = node["kind"];
    if k == "div" { return true; }
    if k == "neg" { return _contains_div(node["arg"]); }
    if k == "sub" { return _contains_div(node["left"]) or _contains_div(node["right"]); }
    if k == "pow" {
        if is_int_node(node["exp"]) and int_val_of(node["exp"]) < 0 { return true; }
        if is_int_node(node["exp"]) and int_val_of(node["exp"]) >= 0 { return _contains_div(node["base"]); }
        return false;
    }
    if k == "add" or k == "mul" {
        let i = 0;
        while i < len(node["args"]) {
            if _contains_div(node["args"][i]) { return true; }
            i = i + 1;
        }
    }
    return false;
}

fn _simplify_div(num_n, den_n, ctx) {
    if is_zero_node(den_n) {
        throw "CAS division by zero";
    }
    if is_zero_node(num_n) {
        if len(free_vars(den_n)) > 0 { _add_guard(ctx, to_ascii(den_n) + " != 0"); }
        return RAT_ZERO;
    }
    if is_one_node(den_n) { return num_n; }
    if is_neg_one_node(den_n) { return simplify_node(ast_neg(num_n), ctx); }
    if is_rat(num_n) and is_rat(den_n) {
        return rat_div(num_n, den_n);
    }
    if ast_eq(num_n, den_n) {
        if len(free_vars(den_n)) > 0 { _add_guard(ctx, to_ascii(den_n) + " != 0"); }
        return RAT_ONE;
    }
    // Collapse nested & compound fractions like (A/B) / (C/D) or (1/x + 1)/(x^2 - 1) -> (A*D)/(B*C)
    if _contains_div(num_n) or _contains_div(den_n) {
        let rn = to_rational_nd(num_n, ctx);
        let rd = to_rational_nd(den_n, ctx);
        if not is_one_node(rn["den"]) or not is_one_node(rd["den"]) {
            let oi = 0;
            while oi < len(rn["orig_dens"]) {
                if len(free_vars(rn["orig_dens"][oi])) > 0 { _add_guard(ctx, to_ascii(rn["orig_dens"][oi]) + " != 0"); }
                oi = oi + 1;
            }
            oi = 0;
            while oi < len(rd["orig_dens"]) {
                if len(free_vars(rd["orig_dens"][oi])) > 0 { _add_guard(ctx, to_ascii(rd["orig_dens"][oi]) + " != 0"); }
                oi = oi + 1;
            }
            let new_num = _expand_node(ast_mul([rn["num"], rd["den"]]), ctx);
            let new_den = _expand_node(ast_mul([rn["den"], rd["num"]]), ctx);
            if not _contains_div(new_num) and not _contains_div(new_den) {
                return simplify_node(ast_div(new_num, new_den), ctx);
            }
        }
    }

    // Univariate polynomial GCD cancellation over Q[x]!
    let vs_num = free_vars(num_n);
    let vs_den = free_vars(den_n);
    let all_vs_map = map{};
    let vi = 0;
    while vi < len(vs_num) { all_vs_map[vs_num[vi]] = true; vi = vi + 1; }
    vi = 0;
    while vi < len(vs_den) { all_vs_map[vs_den[vi]] = true; vi = vi + 1; }
    let all_vs = map_keys(all_vs_map);
    if len(all_vs) == 1 {
        let v = all_vs[0];
        let pn = ast_to_poly(num_n, v);
        let pd = ast_to_poly(den_n, v);
        if pn != nil and pd != nil and poly_deg(pd) >= 1 {
            let g = poly_gcd(pn, pd);
            if poly_deg(g) >= 1 {
                // Record exact domain guards for cancelled factor g(v) = 0!
                let g_roots = poly_rational_roots(g);
                if len(g_roots) > 0 and len(g_roots) == poly_deg(g) {
                    let ri = 0;
                    while ri < len(g_roots) {
                        _add_guard(ctx, v + " != " + rat_to_str(g_roots[ri]));
                        ri = ri + 1;
                    }
                } else {
                    _add_guard(ctx, to_ascii(poly_to_ast(g, v)) + " != 0");
                }
                let qn = poly_divmod(pn, g)[0];
                let qd = poly_divmod(pd, g)[0];
                if poly_deg(qd) == 0 {
                    let scaled = poly_scale(qn, rat_div(RAT_ONE, qd[0]));
                    return poly_to_ast(scaled, v);
                }
                let cn = poly_content_and_primitive(qn);
                let cd = poly_content_and_primitive(qd);
                let c_ratio = rat_div(cn["content"], cd["content"]);
                let num_clean = poly_scale(cn["prim"], rat(c_ratio["p"], 1));
                let den_clean = poly_scale(cd["prim"], rat(c_ratio["q"], 1));
                return ast_div(poly_to_ast(num_clean, v), poly_to_ast(den_clean, v));
            }
            // Even if gcd == 1, normalize negative leading denominator & rational contents!
            let cn0 = poly_content_and_primitive(pn);
            let cd0 = poly_content_and_primitive(pd);
            let cr0 = rat_div(cn0["content"], cd0["content"]);
            if not (rat_is_one(cn0["content"]) and rat_is_one(cd0["content"])) {
                let n_ast = poly_to_ast(poly_scale(cn0["prim"], rat(cr0["p"], 1)), v);
                let d_ast = poly_to_ast(poly_scale(cd0["prim"], rat(cr0["q"], 1)), v);
                if is_one_node(d_ast) { return n_ast; }
                return ast_div(n_ast, d_ast);
            }
        }
    }

    // General multiplicative factor & power cancellation between num and den
    let num_sp = _split_coeff_body(num_n);
    let den_sp = _split_coeff_body(den_n);
    let c_div = rat_div(num_sp[0], den_sp[0]);
    let n_facs = [];
    if num_sp[1]["kind"] == "mul" { n_facs = num_sp[1]["args"]; }
    else if not is_one_node(num_sp[1]) { n_facs = [num_sp[1]]; }
    let d_facs = [];
    if den_sp[1]["kind"] == "mul" { d_facs = den_sp[1]["args"]; }
    else if not is_one_node(den_sp[1]) { d_facs = [den_sp[1]]; }

    // Cancel matching base powers between n_facs and d_facs
    let used_d = [];
    let di = 0;
    while di < len(d_facs) { push(used_d, false); di = di + 1; }
    let rem_n = [];
    let rem_d = [];
    let cancelled_any = false;
    let ni = 0;
    while ni < len(n_facs) {
        let nb_ne = _split_base_exp(n_facs[ni]);
        let matched = false;
        di = 0;
        while di < len(d_facs) {
            if not used_d[di] {
                let db_de = _split_base_exp(d_facs[di]);
                if ast_eq(nb_ne[0], db_de[0]) and is_int_node(nb_ne[1]) and is_int_node(db_de[1]) {
                    used_d[di] = true;
                    matched = true;
                    cancelled_any = true;
                    if len(free_vars(nb_ne[0])) > 0 {
                        _add_guard(ctx, to_ascii(nb_ne[0]) + " != 0");
                    }
                    let diff_e = int_val_of(nb_ne[1]) - int_val_of(db_de[1]);
                    if diff_e > 0 {
                        push(rem_n, _simplify_pow(nb_ne[0], rat(diff_e, 1), ctx));
                    } else if diff_e < 0 {
                        push(rem_d, _simplify_pow(nb_ne[0], rat(0 - diff_e, 1), ctx));
                    }
                    break;
                }
            }
            di = di + 1;
        }
        if not matched { push(rem_n, n_facs[ni]); }
        ni = ni + 1;
    }
    di = 0;
    while di < len(d_facs) {
        if not used_d[di] { push(rem_d, d_facs[di]); }
        di = di + 1;
    }
    if cancelled_any or not rat_is_one(den_sp[0]) {
        if c_div["p"] != _BI_ONE or len(rem_n) == 0 {
            if not (c_div["p"] == _BI_ONE and len(rem_n) > 0) {
                let num_coeff = rat(c_div["p"], 1);
                if not rat_is_one(num_coeff) {
                    let nr = [num_coeff];
                    let t = 0;
                    while t < len(rem_n) { push(nr, rem_n[t]); t = t + 1; }
                    rem_n = nr;
                }
            }
        }
        if c_div["q"] != _BI_ONE {
            let dr = [rat(c_div["q"], 1)];
            let t = 0;
            while t < len(rem_d) { push(dr, rem_d[t]); t = t + 1; }
            rem_d = dr;
        }
        let final_n = simplify_node(ast_mul(rem_n), ctx);
        if len(rem_d) == 0 { return final_n; }
        let final_d = simplify_node(ast_mul(rem_d), ctx);
        if is_one_node(final_d) { return final_n; }
        return ast_div(final_n, final_d);
    }
    return ast_div(num_n, den_n);
}

fn _simplify_node_inner(node, ctx = nil) {
    if node == nil or type(node) != "map" { return node; }
    let k = node["kind"];
    if k == "rat" or k == "sym" { return node; }
    if k == "num" {
        let sr = float_snap_rat(node["val"], 1000000, 0.000000000001);
        if sr != nil { return sr; }
        return node;
    }
    if k == "rel" {
        return ast_rel(node["op"], simplify_node(node["lhs"], ctx), simplify_node(node["rhs"], ctx));
    }
    if k == "chain_rel" {
        let pts = [];
        let i = 0;
        while i < len(node["parts"]) { push(pts, simplify_node(node["parts"][i], ctx)); i = i + 1; }
        return map{ "kind": "chain_rel", "parts": pts };
    }
    if k == "system" {
        let items = [];
        let i = 0;
        while i < len(node["items"]) { push(items, simplify_node(node["items"][i], ctx)); i = i + 1; }
        return map{ "kind": "system", "items": items };
    }
    if k == "neg" {
        let u = simplify_node(node["arg"], ctx);
        if is_rat(u) { return rat_neg(u); }
        if u["kind"] == "num" { return ast_num(0.0 - u["val"]); }
        if u["kind"] == "neg" { return u["arg"]; }
        if u["kind"] == "mul" and len(u["args"]) >= 1 and is_rat(u["args"][0]) {
            let na = [rat_neg(u["args"][0])];
            let i = 1;
            while i < len(u["args"]) { push(na, u["args"][i]); i = i + 1; }
            return simplify_node(ast_mul(na), ctx);
        }
        if u["kind"] == "add" {
            let terms = [];
            let i = 0;
            while i < len(u["args"]) { push(terms, ast_neg(u["args"][i])); i = i + 1; }
            return simplify_node(ast_add(terms), ctx);
        }
        return ast_mul([RAT_NEG_ONE, u]);
    }
    if k == "sub" {
        return simplify_node(ast_add([node["left"], ast_neg(node["right"])]), ctx);
    }
    if k == "pow" {
        let b = simplify_node(node["base"], ctx);
        let e = simplify_node(node["exp"], ctx);
        return _simplify_pow(b, e, ctx);
    }
    if k == "call" {
        let s_args = [];
        let i = 0;
        while i < len(node["args"]) { push(s_args, simplify_node(node["args"][i], ctx)); i = i + 1; }
        return _simplify_call(node["fn_name"], s_args, ctx);
    }
    if k == "div" {
        let nn = simplify_node(node["num"], ctx);
        let dn = simplify_node(node["den"], ctx);
        return _simplify_div(nn, dn, ctx);
    }
    if k == "mul" {
        // Flatten mul, pull numerators & denominators, fold constants, radicals & like-base powers
        let flat = [];
        let num_extra = [];
        let den_extra = [];
        let i = 0;
        while i < len(node["args"]) {
            let s = simplify_node(node["args"][i], ctx);
            if s["kind"] == "mul" {
                let j = 0;
                while j < len(s["args"]) { push(flat, s["args"][j]); j = j + 1; }
            } else if s["kind"] == "neg" {
                push(flat, RAT_NEG_ONE);
                push(flat, s["arg"]);
            } else {
                push(flat, s);
            }
            i = i + 1;
        }
        let coeff = RAT_ONE;
        let sqrt_rat_prod = RAT_ONE;
        let has_div = false;
        let sym_facs = [];
        i = 0;
        while i < len(flat) {
            let f = flat[i];
            if is_zero_node(f) { return RAT_ZERO; }
            if is_rat(f) {
                coeff = rat_mul(coeff, f);
            } else if f["kind"] == "div" {
                has_div = true;
                push(num_extra, f["num"]);
                push(den_extra, f["den"]);
            } else if f["kind"] == "call" and f["fn_name"] == "sqrt" and len(f["args"]) == 1 and is_rat(f["args"][0]) and rat_is_pos(f["args"][0]) {
                sqrt_rat_prod = rat_mul(sqrt_rat_prod, f["args"][0]);
            } else {
                push(sym_facs, f);
            }
            i = i + 1;
        }
        if has_div {
            let all_n = [coeff];
            if not rat_is_one(sqrt_rat_prod) { push(all_n, _simplify_sqrt(sqrt_rat_prod, ctx)); }
            let t = 0;
            while t < len(sym_facs) { push(all_n, sym_facs[t]); t = t + 1; }
            t = 0;
            while t < len(num_extra) { push(all_n, num_extra[t]); t = t + 1; }
            return _simplify_div(simplify_node(ast_mul(all_n), ctx), simplify_node(ast_mul(den_extra), ctx), ctx);
        }
        if not rat_is_one(sqrt_rat_prod) {
            let sq_s = _simplify_sqrt(sqrt_rat_prod, ctx);
            if is_rat(sq_s) { coeff = rat_mul(coeff, sq_s); }
            else if sq_s["kind"] == "mul" {
                let t = 0;
                while t < len(sq_s["args"]) {
                    if is_rat(sq_s["args"][t]) { coeff = rat_mul(coeff, sq_s["args"][t]); }
                    else { push(sym_facs, sq_s["args"][t]); }
                    t = t + 1;
                }
            } else {
                push(sym_facs, sq_s);
            }
        }
        if rat_is_zero(coeff) { return RAT_ZERO; }
        // Fold powers with identical bases: base^e1 * base^e2 -> base^(e1 + e2)
        let bases = [];
        let exps = [];
        i = 0;
        while i < len(sym_facs) {
            let be = _split_base_exp(sym_facs[i]);
            let found = -1;
            let j = 0;
            while j < len(bases) {
                if ast_eq(bases[j], be[0]) { found = j; break; }
                j = j + 1;
            }
            if found >= 0 {
                exps[found] = simplify_node(ast_add([exps[found], be[1]]), ctx);
            } else {
                push(bases, be[0]);
                push(exps, be[1]);
            }
            i = i + 1;
        }
        let folded = [];
        i = 0;
        while i < len(bases) {
            if is_zero_node(exps[i]) {
                if len(free_vars(bases[i])) > 0 { _add_guard(ctx, to_ascii(bases[i]) + " != 0"); }
            } else {
                let p_node = _simplify_pow(bases[i], exps[i], ctx);
                if is_rat(p_node) { coeff = rat_mul(coeff, p_node); }
                else { push(folded, p_node); }
            }
            i = i + 1;
        }
        // Distribute rational constant into single sum if coeff == -1? Keep factored like 2*(x+1) unless -1?
        // Keeping coeff * sorted_factors is clean and canonical!
        let sorted_f = _sort_nodes(folded, false);
        if len(sorted_f) == 0 { return coeff; }
        if rat_is_one(coeff) { return ast_mul(sorted_f); }
        let res_args = [coeff];
        i = 0;
        while i < len(sorted_f) { push(res_args, sorted_f[i]); i = i + 1; }
        return ast_mul(res_args);
    }
    if k == "add" {
        let flat = [];
        let i = 0;
        while i < len(node["args"]) {
            let s = simplify_node(node["args"][i], ctx);
            if s["kind"] == "add" {
                let j = 0;
                while j < len(s["args"]) { push(flat, s["args"][j]); j = j + 1; }
            } else {
                push(flat, s);
            }
            i = i + 1;
        }
        // Group like monomial bodies and sum rational coefficients
        let bodies = [];
        let coeffs = [];
        let const_sum = RAT_ZERO;
        i = 0;
        while i < len(flat) {
            let t = flat[i];
            if is_rat(t) {
                const_sum = rat_add(const_sum, t);
            } else {
                let cb = _split_coeff_body(t);
                if is_one_node(cb[1]) {
                    const_sum = rat_add(const_sum, cb[0]);
                } else {
                    let found = -1;
                    let j = 0;
                    while j < len(bodies) {
                        if ast_eq(bodies[j], cb[1]) { found = j; break; }
                        j = j + 1;
                    }
                    if found >= 0 {
                        coeffs[found] = rat_add(coeffs[found], cb[0]);
                    } else {
                        push(bodies, cb[1]);
                        push(coeffs, cb[0]);
                    }
                }
            }
            i = i + 1;
        }
        let terms = [];
        i = 0;
        while i < len(bodies) {
            let c = coeffs[i];
            if not rat_is_zero(c) {
                if rat_is_one(c) {
                    push(terms, bodies[i]);
                } else if bodies[i]["kind"] == "mul" {
                    let ma = [c];
                    let m = 0;
                    while m < len(bodies[i]["args"]) { push(ma, bodies[i]["args"][m]); m = m + 1; }
                    push(terms, ast_mul(ma));
                } else {
                    push(terms, ast_mul([c, bodies[i]]));
                }
            }
            i = i + 1;
        }
        let sorted_terms = _sort_nodes(terms, true);
        if not rat_is_zero(const_sum) {
            push(sorted_terms, const_sum);
        }
        if len(sorted_terms) == 0 { return RAT_ZERO; }
        if len(sorted_terms) == 1 { return sorted_terms[0]; }
        return ast_add(sorted_terms);
    }
    return node;
}

fn simplify_node(node, ctx = nil) {
    if node == nil or type(node) != "map" { return node; }
    let k = node["kind"];
    if k == "rat" or k == "sym" { return node; }
    let out = _simplify_node_inner(node, ctx);
    if not ast_eq(out, node) {
        _bump_rewrite(ctx);
    }
    return out;
}

// Combine arbitrary algebraic expression into single common-denominator fraction { num, den, den_factors }!
fn to_rational_nd(node, ctx = nil) {
    if node == nil or type(node) != "map" {
        return map{ "num": RAT_ZERO, "den": RAT_ONE, "orig_dens": [] };
    }
    let k = node["kind"];
    if k == "rat" or k == "num" or k == "sym" or k == "call" {
        return map{ "num": node, "den": RAT_ONE, "orig_dens": [] };
    }
    if k == "neg" {
        let sub = to_rational_nd(node["arg"], ctx);
        return map{
            "num": simplify_node(ast_neg(sub["num"]), ctx),
            "den": sub["den"],
            "orig_dens": sub["orig_dens"]
        };
    }
    if k == "sub" {
        return to_rational_nd(ast_add([node["left"], ast_neg(node["right"])]), ctx);
    }
    if k == "div" {
        let rn = to_rational_nd(node["num"], ctx);
        let rd = to_rational_nd(node["den"], ctx);
        let od = [];
        let i = 0;
        while i < len(rn["orig_dens"]) { push(od, rn["orig_dens"][i]); i = i + 1; }
        i = 0;
        while i < len(rd["orig_dens"]) { push(od, rd["orig_dens"][i]); i = i + 1; }
        push(od, node["den"]);
        return map{
            "num": simplify_node(ast_mul([rn["num"], rd["den"]]), ctx),
            "den": simplify_node(ast_mul([rn["den"], rd["num"]]), ctx),
            "orig_dens": od
        };
    }
    if k == "pow" and is_int_node(node["exp"]) {
        let ei = int_val_of(node["exp"]);
        if ei < 0 {
            let pos_pow = ast_pow(node["base"], rat(0 - ei, 1));
            return map{ "num": RAT_ONE, "den": pos_pow, "orig_dens": [pos_pow] };
        }
        let max_deg_r = GOV.current_limits()["max_expand_degree"];
        if ctx != nil and map_has(ctx, "lim") { max_deg_r = ctx["lim"]["max_expand_degree"]; }
        if ei >= 0 and ei <= max_deg_r {
            let rb = to_rational_nd(node["base"], ctx);
            if not is_one_node(rb["den"]) {
                return map{
                    "num": simplify_node(ast_pow(rb["num"], node["exp"]), ctx),
                    "den": simplify_node(ast_pow(rb["den"], node["exp"]), ctx),
                    "orig_dens": rb["orig_dens"]
                };
            }
        }
        return map{ "num": node, "den": RAT_ONE, "orig_dens": [] };
    }
    if k == "mul" {
        let num_parts = [];
        let den_parts = [];
        let od = [];
        let i = 0;
        while i < len(node["args"]) {
            let ri = to_rational_nd(node["args"][i], ctx);
            push(num_parts, ri["num"]);
            if not is_one_node(ri["den"]) { push(den_parts, ri["den"]); }
            let j = 0;
            while j < len(ri["orig_dens"]) { push(od, ri["orig_dens"][j]); j = j + 1; }
            i = i + 1;
        }
        return map{
            "num": _expand_node(ast_mul(num_parts), ctx),
            "den": _expand_node(ast_mul(den_parts), ctx),
            "orig_dens": od
        };
    }
    if k == "add" {
        let cur_num = RAT_ZERO;
        let cur_den = RAT_ONE;
        let od = [];
        let i = 0;
        while i < len(node["args"]) {
            let ri = to_rational_nd(node["args"][i], ctx);
            let j = 0;
            while j < len(ri["orig_dens"]) { push(od, ri["orig_dens"][j]); j = j + 1; }
            if ast_eq(cur_den, ri["den"]) {
                cur_num = _expand_node(ast_add([cur_num, ri["num"]]), ctx);
            } else {
                cur_num = _expand_node(ast_add([
                    ast_mul([cur_num, ri["den"]]),
                    ast_mul([ri["num"], cur_den])
                ]), ctx);
                cur_den = _expand_node(ast_mul([cur_den, ri["den"]]), ctx);
            }
            i = i + 1;
        }
        return map{ "num": cur_num, "den": cur_den, "orig_dens": od };
    }
    return map{ "num": node, "den": RAT_ONE, "orig_dens": [] };
}

// ── Transformation Engines (Expand, Factor, Square, Apart, Trig, Log, Surd, Isolate) ──

fn _distribute_two(a, b, ctx) {
    let a_terms = [a];
    let b_terms = [b];
    if a["kind"] == "add" { a_terms = a["args"]; }
    if b["kind"] == "add" { b_terms = b["args"]; }
    let lim = nil;
    let trk = nil;
    if ctx != nil and map_has(ctx, "lim") {
        lim = ctx["lim"];
        trk = ctx["trk"];
    } else {
        lim = GOV.current_limits();
    }
    let prod_terms = len(a_terms) * len(b_terms);
    if trk != nil {
        GOV.check_swell(trk, prod_terms);
    }
    if prod_terms > lim["max_ast_nodes"] {
        throw "MathGovernor[symbolic_cas.expand]: resource budget exceeded (distributive expansion term blowup " + str(prod_terms) + " > " + str(lim["max_ast_nodes"]) + ")";
    }
    let out = [];
    let i = 0;
    while i < len(a_terms) {
        let j = 0;
        while j < len(b_terms) {
            if trk != nil { GOV.tick(trk, 1); }
            push(out, simplify_node(ast_mul([a_terms[i], b_terms[j]]), ctx));
            j = j + 1;
        }
        i = i + 1;
    }
    return simplify_node(ast_add(out), ctx);
}

fn _expand_node(node, ctx) {
    if node == nil or type(node) != "map" { return node; }
    _bump_rewrite(ctx);
    let k = node["kind"];
    if k == "rat" or k == "num" or k == "sym" { return simplify_node(node, ctx); }
    if k == "rel" {
        return ast_rel(node["op"], _expand_node(node["lhs"], ctx), _expand_node(node["rhs"], ctx));
    }
    if k == "neg" {
        return simplify_node(ast_neg(_expand_node(node["arg"], ctx)), ctx);
    }
    if k == "sub" {
        return _expand_node(ast_add([node["left"], ast_neg(node["right"])]), ctx);
    }
    if k == "add" {
        let out = [];
        let i = 0;
        while i < len(node["args"]) { push(out, _expand_node(node["args"][i], ctx)); i = i + 1; }
        return simplify_node(ast_add(out), ctx);
    }
    if k == "div" {
        let en = _expand_node(node["num"], ctx);
        let ed = _expand_node(node["den"], ctx);
        if is_rat(ed) and not rat_is_zero(ed) and en["kind"] == "add" {
            let inv_d = rat_div(RAT_ONE, ed);
            let terms = [];
            let i = 0;
            while i < len(en["args"]) { push(terms, ast_mul([inv_d, en["args"][i]])); i = i + 1; }
            return simplify_node(ast_add(terms), ctx);
        }
        return simplify_node(ast_div(en, ed), ctx);
    }
    if k == "pow" {
        let eb = _expand_node(node["base"], ctx);
        let ee = _expand_node(node["exp"], ctx);
        if is_int_node(ee) {
            let ei = int_val_of(ee);
            let max_deg_e = GOV.current_limits()["max_expand_degree"];
            if ctx != nil and map_has(ctx, "lim") { max_deg_e = ctx["lim"]["max_expand_degree"]; }
            if ei > max_deg_e {
                throw "MathGovernor[symbolic_cas.expand]: resource budget exceeded (expand exponent " + str(ei) + " > " + str(max_deg_e) + ")";
            }
            if ei >= 2 and eb["kind"] == "add" {
                // Fast exact BigInt polynomial power for univariate bases (e.g. (x + 1)^100 in < 10 ms!)
                let fvs_eb = free_vars(eb);
                if len(fvs_eb) == 1 {
                    let pb = ast_to_poly(eb, fvs_eb[0]);
                    if pb != nil {
                        return poly_to_ast(poly_pow(pb, ei), fvs_eb[0]);
                    }
                }
                // Multivariate binary exponentiation guarded by MathGovernor ticks & swell bounds
                let acc = RAT_ONE;
                let base_cur = eb;
                let rem_e = ei;
                while rem_e > 0 {
                    let half_e = num_floor(rem_e / 2);
                    if rem_e - half_e * 2 == 1 {
                        if is_one_node(acc) { acc = base_cur; }
                        else { acc = _distribute_two(acc, base_cur, ctx); }
                    }
                    rem_e = half_e;
                    if rem_e > 0 {
                        base_cur = _distribute_two(base_cur, base_cur, ctx);
                    }
                }
                return acc;
            }
        }
        return simplify_node(ast_pow(eb, ee), ctx);
    }
    if k == "mul" {
        let arr = node["args"];
        if len(arr) == 0 { return RAT_ONE; }
        let acc = _expand_node(arr[0], ctx);
        let i = 1;
        while i < len(arr) {
            let nxt = _expand_node(arr[i], ctx);
            acc = _distribute_two(acc, nxt, ctx);
            i = i + 1;
        }
        return acc;
    }
    if k == "call" {
        let oa = [];
        let i = 0;
        while i < len(node["args"]) { push(oa, _expand_node(node["args"][i], ctx)); i = i + 1; }
        return simplify_node(ast_call(node["fn_name"], oa), ctx);
    }
    return simplify_node(node, ctx);
}

// Helper: check if node is a perfect square over Q*monomials (returns sqrt AST if exact algebraic square, else nil)
fn _algebraic_sqrt_monomial(term) {
    let sp = _split_coeff_body(term);
    let c = sp[0];
    if not rat_is_pos(c) { return nil; }
    let sp_num = bi_isqrt(c["p"]);
    let sp_den = bi_isqrt(c["q"]);
    if sp_num * sp_num != c["p"] or sp_den * sp_den != c["q"] { return nil; }
    let c_root = rat(sp_num, sp_den);
    let body = sp[1];
    if is_one_node(body) { return c_root; }
    let facs = [body];
    if body["kind"] == "mul" { facs = body["args"]; }
    let root_facs = [];
    if not rat_is_one(c_root) { push(root_facs, c_root); }
    let i = 0;
    while i < len(facs) {
        let f = facs[i];
        if f["kind"] == "pow" and is_int_node(f["exp"]) {
            let ei = int_val_of(f["exp"]);
            let half = num_floor(ei / 2);
            if ei >= 2 and ei - half * 2 == 0 {
                if half == 1 { push(root_facs, f["base"]); }
                else { push(root_facs, ast_pow(f["base"], rat(half, 1))); }
            } else {
                return nil;
            }
        } else {
            return nil;
        }
        i = i + 1;
    }
    return ast_mul(root_facs);
}

// Helper: check if node is a perfect cube over Q*monomials (returns cbrt AST if exact cube, else nil)
fn _bi_icbrt_exact(n) {
    if n == _BI_ZERO { return _BI_ZERO; }
    let sgn = _BI_ONE;
    let m = n;
    if m < _BI_ZERO { sgn = _BI_NEG_ONE; m = _BI_ZERO - m; }
    let fv = num_round(num_pow(bi_to_float(m), 1.0 / 3.0));
    let cand = bigint(fv);
    let d = bigint(-2);
    while d <= bigint(2) {
        let t = cand + d;
        if t >= _BI_ZERO and t * t * t == m { return sgn * t; }
        d = d + _BI_ONE;
    }
    return nil;
}

fn _algebraic_cbrt_monomial(term) {
    let sp = _split_coeff_body(term);
    let c = sp[0];
    if rat_is_zero(c) { return nil; }
    let rp = _bi_icbrt_exact(c["p"]);
    let rq = _bi_icbrt_exact(c["q"]);
    if rp == nil or rq == nil { return nil; }
    let c_root = rat(rp, rq);
    let body = sp[1];
    if is_one_node(body) { return c_root; }
    let facs = [body];
    if body["kind"] == "mul" { facs = body["args"]; }
    let root_facs = [];
    if not rat_is_one(c_root) { push(root_facs, c_root); }
    let i = 0;
    while i < len(facs) {
        let f = facs[i];
        if f["kind"] == "pow" and is_int_node(f["exp"]) {
            let ei = int_val_of(f["exp"]);
            let third = num_floor(ei / 3);
            if ei >= 3 and ei - third * 3 == 0 {
                if third == 1 { push(root_facs, f["base"]); }
                else { push(root_facs, ast_pow(f["base"], rat(third, 1))); }
            } else {
                return nil;
            }
        } else {
            return nil;
        }
        i = i + 1;
    }
    return simplify_node(ast_mul(root_facs), nil);
}

// Factor arbitrary polynomial / algebraic expression over Z/Q!
fn _factor_expr(node, ctx) {
    let exp_n = _expand_node(node, ctx);
    if exp_n["kind"] == "rel" {
        let diff_f = _factor_expr(ast_sub(exp_n["lhs"], exp_n["rhs"]), ctx);
        return ast_rel(exp_n["op"], diff_f, RAT_ZERO);
    }
    if exp_n["kind"] == "div" {
        return _simplify_div(_factor_expr(exp_n["num"], ctx), _factor_expr(exp_n["den"], ctx), ctx);
    }
    let vs = free_vars(exp_n);
    if len(vs) == 1 {
        let v = vs[0];
        let p = ast_to_poly(exp_n, v);
        if p != nil and poly_deg(p) >= 1 {
            let fq = poly_factor_Q(p, v);
            return fq["ast"];
        }
    }
    // Multivariate difference of squares A^2 - B^2 and sum/difference of cubes A^3 +- B^3!
    if exp_n["kind"] == "add" and len(exp_n["args"]) == 2 {
        let t0 = exp_n["args"][0];
        let t1 = exp_n["args"][1];
        // Check difference of squares: t0 = A^2, t1 = -B^2 (or vice versa)
        let sp0 = _split_term_sign(t0);
        let sp1 = _split_term_sign(t1);
        if not sp0[0] and sp1[0] {
            let rA = _algebraic_sqrt_monomial(sp0[1]);
            let rB = _algebraic_sqrt_monomial(sp1[1]);
            if rA != nil and rB != nil {
                let f1 = _factor_expr(ast_sub(rA, rB), ctx);
                let f2 = _factor_expr(ast_add([rA, rB]), ctx);
                return ast_mul([f1, f2]);
            }
        }
        // Check sum or difference of cubes: A^3 + B^3 = (A + B)(A^2 - A*B + B^2)
        let cA = _algebraic_cbrt_monomial(t0);
        let cB = _algebraic_cbrt_monomial(t1);
        if cA != nil and cB != nil {
            let quad = simplify_node(ast_add([
                ast_pow(cA, RAT_TWO),
                ast_neg(ast_mul([cA, cB])),
                ast_pow(cB, RAT_TWO)
            ]), ctx);
            return ast_mul([simplify_node(ast_add([cA, cB]), ctx), quad]);
        }
    }
    // Bivariate homogeneous polynomial P(x, y): dehomogenize y=1, factor in Q[x], homogenize back!
    if len(vs) == 2 and exp_n["kind"] == "add" {
        let vx = vs[0]; let vy = vs[1];
        let sub1 = simplify_node(subst_ast(exp_n, _env1(vy, RAT_ONE)), ctx);
        let p1 = ast_to_poly(sub1, vx);
        let total_d = poly_deg(p1);
        if p1 != nil and total_d >= 2 {
            // Verify exp_n is actually homogeneous of degree total_d!
            let fq1 = poly_factor_Q(p1, vx);
            if len(fq1["factors"]) >= 2 or (len(fq1["factors"]) == 1 and fq1["factors"][0]["mult"] >= 2) {
                let h_args = [];
                let neg_c = rat_is_neg(fq1["content"]);
                let abs_c = rat_abs(fq1["content"]);
                if not rat_is_one(abs_c) { push(h_args, abs_c); }
                let fi = 0;
                while fi < len(fq1["factors"]) {
                    let fp = fq1["factors"][fi]["poly"];
                    let fd = poly_deg(fp);
                    let h_terms = [];
                    let ti = fd;
                    while ti >= 0 {
                        if not rat_is_zero(fp[ti]) {
                            let y_deg = fd - ti;
                            let m_parts = [];
                            if not rat_is_one(fp[ti]) and not rat_is_neg_one(fp[ti]) {
                                push(m_parts, fp[ti]);
                            }
                            if ti == 1 { push(m_parts, ast_sym(vx)); }
                            else if ti > 1 { push(m_parts, ast_pow(ast_sym(vx), rat(ti, 1))); }
                            if y_deg == 1 { push(m_parts, ast_sym(vy)); }
                            else if y_deg > 1 { push(m_parts, ast_pow(ast_sym(vy), rat(y_deg, 1))); }
                            let mono = ast_mul(m_parts);
                            if rat_is_neg_one(fp[ti]) { mono = ast_neg(mono); }
                            push(h_terms, mono);
                        }
                        ti = ti - 1;
                    }
                    let h_fac = ast_add(h_terms);
                    if fq1["factors"][fi]["mult"] > 1 {
                        h_fac = ast_pow(h_fac, rat(fq1["factors"][fi]["mult"], 1));
                    }
                    push(h_args, h_fac);
                    fi = fi + 1;
                }
                let candidate = ast_mul(h_args);
                if neg_c { candidate = ast_neg(candidate); }
                if ast_eq(_expand_node(candidate, ctx), exp_n) {
                    return candidate;
                }
            }
        }
    }
    return exp_n;
}

// Complete the square: a*x^2 + b*x + c -> a*(x + b/(2a))^2 + (c - b^2/(4a))
fn _complete_square_info(node, v_opt, ctx) {
    let expr = node;
    if node["kind"] == "rel" and node["op"] == "=" {
        expr = ast_sub(node["lhs"], node["rhs"]);
    }
    let exp_n = _expand_node(expr, ctx);
    let v = v_opt;
    if v == nil {
        let vs = free_vars(exp_n);
        if len(vs) == 0 { throw "complete_square: expression has no variable"; }
        v = vs[0];
    }
    let p = ast_to_poly(exp_n, v);
    if p == nil or poly_deg(p) != 2 {
        throw "complete_square requires a quadratic polynomial in " + v;
    }
    let c = p[0];
    let b = p[1];
    let a = p[2];
    // Vertex: h = -b / (2a), k = c - b^2 / (4a)
    let shift = rat_div(b, rat_mul(RAT_TWO, a));       // +b/(2a)
    let h = rat_neg(shift);                            // -b/(2a)
    let b2_4a = rat_div(rat_mul(b, b), rat_mul(rat(4, 1), a));
    let k_val = rat_sub(c, b2_4a);

    let x_sym = ast_sym(v);
    let inner_bin = x_sym;
    if not rat_is_zero(shift) {
        inner_bin = ast_add([x_sym, shift]);
    }
    let sq_part = ast_pow(inner_bin, RAT_TWO);
    if rat_is_neg_one(a) { sq_part = ast_neg(sq_part); }
    else if not rat_is_one(a) { sq_part = ast_mul([a, sq_part]); }

    let completed = sq_part;
    if not rat_is_zero(k_val) {
        completed = ast_add([sq_part, k_val]);
    }
    let ext_type = "min";
    if rat_is_neg(a) { ext_type = "max"; }
    return map{
        "ast": completed,
        "a": a,
        "h": h,
        "k": k_val,
        "vertex": [rat_to_float(h), rat_to_float(k_val)],
        "vertex_exact": [rat_to_str(h), rat_to_str(k_val)],
        "extremum_type": ext_type
    };
}

// Exact Partial Fraction Decomposition over Q(x) using Q-RREF!
fn _partial_fractions(node, v_opt, ctx) {
    let nd = to_rational_nd(node, ctx);
    let vs = free_vars(node);
    let v = v_opt;
    if v == nil {
        if len(vs) == 0 { return simplify_node(node, ctx); }
        v = vs[0];
    }
    let pn = ast_to_poly(nd["num"], v);
    let pd = ast_to_poly(nd["den"], v);
    if pn == nil or pd == nil or poly_deg(pd) <= 0 {
        return simplify_node(node, ctx);
    }
    // Cancel common GCD first (recording domain guards!)
    let g = poly_gcd(pn, pd);
    if poly_deg(g) >= 1 {
        let g_roots = poly_rational_roots(g);
        let ri = 0;
        while ri < len(g_roots) {
            _add_guard(ctx, v + " != " + rat_to_str(g_roots[ri]));
            ri = ri + 1;
        }
        pn = poly_divmod(pn, g)[0];
        pd = poly_divmod(pd, g)[0];
    }
    if poly_deg(pd) <= 0 {
        return poly_to_ast(poly_scale(pn, rat_div(RAT_ONE, pd[0])), v);
    }
    // 1. Euclidean division: P / Q = Q_poly + R / Q
    let dm = poly_divmod(pn, pd);
    let q_poly = dm[0];
    let r_poly = dm[1];
    if poly_is_zero(r_poly) {
        return poly_to_ast(q_poly, v);
    }
    // 2. Factor Q(x) over Q; convert each factor to monic so linear factors look like (x - r)^k!
    let fq = poly_factor_Q(pd, v);
    let lead_scalar = fq["content"];
    let monic_factors = [];
    let fi = 0;
    while fi < len(fq["factors"]) {
        let f_orig = fq["factors"][fi]["poly"];
        let mult = fq["factors"][fi]["mult"];
        let lc_f = poly_lc(f_orig);
        lead_scalar = rat_mul(lead_scalar, rat_pow_int(lc_f, mult));
        let f_mon = poly_monic(f_orig);
        push(monic_factors, map{ "poly": f_mon, "mult": mult });
        fi = fi + 1;
    }
    if len(monic_factors) == 1 and monic_factors[0]["mult"] == 1 {
        // Already a single irreducible denominator!
        let r_scaled = poly_scale(r_poly, rat_div(RAT_ONE, lead_scalar));
        let frac = ast_div(poly_to_ast(r_scaled, v), poly_to_ast(monic_factors[0]["poly"], v));
        if poly_is_zero(q_poly) { return frac; }
        return ast_add([poly_to_ast(q_poly, v), frac]);
    }
    let q_monic = poly_scale(pd, rat_div(RAT_ONE, lead_scalar));
    let r_target = poly_scale(r_poly, rat_div(RAT_ONE, lead_scalar));
    let deg_q = poly_deg(q_monic);

    // 3. Build basis polynomials for undetermined coefficients over Q
    // Each basis entry: { den_poly, den_pow, x_deg, basis_poly }
    let basis = [];
    fi = 0;
    while fi < len(monic_factors) {
        let f_mon = monic_factors[fi]["poly"];
        let mult = monic_factors[fi]["mult"];
        let d_f = poly_deg(f_mon);
        let k_pow = 1;
        while k_pow <= mult {
            let fk = poly_pow(f_mon, k_pow);
            let cofactor = poly_divmod(q_monic, fk)[0];
            let deg_num = 0;
            while deg_num < d_f {
                // Multiply cofactor by x^deg_num
                let x_mon = [];
                let z = 0;
                while z < deg_num { push(x_mon, RAT_ZERO); z = z + 1; }
                push(x_mon, RAT_ONE);
                let b_poly = poly_mul(cofactor, x_mon);
                push(basis, map{
                    "f_mon": f_mon,
                    "k_pow": k_pow,
                    "x_deg": deg_num,
                    "b_poly": b_poly
                });
                deg_num = deg_num + 1;
            }
            k_pow = k_pow + 1;
        }
        fi = fi + 1;
    }
    // 4. Assemble deg_q x (deg_q + 1) exact rational augmented matrix
    let aug = [];
    let row_d = 0;
    while row_d < deg_q {
        let row = [];
        let col_b = 0;
        while col_b < len(basis) {
            let bp = basis[col_b]["b_poly"];
            if row_d < len(bp) { push(row, bp[row_d]); }
            else { push(row, RAT_ZERO); }
            col_b = col_b + 1;
        }
        if row_d < len(r_target) { push(row, r_target[row_d]); }
        else { push(row, RAT_ZERO); }
        push(aug, row);
        row_d = row_d + 1;
    }
    let rref_res = rref_rat(aug, len(basis));
    if rref_res["status"] != "unique" {
        return simplify_node(node, ctx);
    }
    let coeffs = rref_res["solution"];

    // 5. Reassemble partial fraction terms grouped by (factor, k_pow)
    let out_terms = [];
    if not poly_is_zero(q_poly) {
        let qp_ast = poly_to_ast(q_poly, v);
        if qp_ast["kind"] == "add" {
            let qi = 0;
            while qi < len(qp_ast["args"]) { push(out_terms, qp_ast["args"][qi]); qi = qi + 1; }
        } else {
            push(out_terms, qp_ast);
        }
    }
    let bi = 0;
    while bi < len(basis) {
        let f_mon = basis[bi]["f_mon"];
        let k_pow = basis[bi]["k_pow"];
        let d_f = poly_deg(f_mon);
        let num_coeffs = [];
        let j = 0;
        while j < d_f {
            push(num_coeffs, coeffs[bi + j]);
            j = j + 1;
        }
        let num_p = poly_trim(num_coeffs);
        if not poly_is_zero(num_p) {
            let den_ast = poly_to_ast(f_mon, v);
            if k_pow > 1 { den_ast = ast_pow(den_ast, rat(k_pow, 1)); }
            // Format cleanly: if num_p is constant p/q, handle sign cleanly so -1/(2*(x+1)) or (1/2)/(x-1)
            let n_ast = poly_to_ast(num_p, v);
            if poly_deg(num_p) == 0 and rat_is_neg(num_p[0]) {
                push(out_terms, ast_neg(ast_div(rat_neg(num_p[0]), den_ast)));
            } else {
                push(out_terms, ast_div(n_ast, den_ast));
            }
        }
        bi = bi + d_f;
    }
    if len(out_terms) == 0 { return RAT_ZERO; }
    return ast_add(out_terms);
}

// Trigonometric simplification:
// sin^2(u) + cos^2(u) -> 1, 1 - sin^2(u) -> cos^2(u), 1 - cos^2(u) -> sin^2(u),
// sin(u)/cos(u) -> tan(u), 2*sin(u)*cos(u) -> sin(2*u), cos^2(u) - sin^2(u) -> cos(2*u)
fn _is_trig_sq(body, fn_target) {
    if body["kind"] == "pow" and is_int_node(body["exp"]) and int_val_of(body["exp"]) == 2 {
        let b = body["base"];
        if b["kind"] == "call" and b["fn_name"] == fn_target and len(b["args"]) == 1 {
            return b["args"][0];
        }
    }
    return nil;
}

fn _trig_simplify_node(node, ctx) {
    let s = simplify_node(node, ctx);
    if s == nil or type(s) != "map" { return s; }
    let k = s["kind"];
    if k == "rel" {
        return ast_rel(s["op"], _trig_simplify_node(s["lhs"], ctx), _trig_simplify_node(s["rhs"], ctx));
    }
    if k == "div" {
        let tn = _trig_simplify_node(s["num"], ctx);
        let td = _trig_simplify_node(s["den"], ctx);
        // sin(u)/cos(u) -> tan(u) and sin(u)^m / cos(u)^m -> tan(u)^m
        let sp_n = _split_coeff_body(tn);
        let sp_d = _split_coeff_body(td);
        let be_n = _split_base_exp(sp_n[1]);
        let be_d = _split_base_exp(sp_d[1]);
        if be_n[0]["kind"] == "call" and be_n[0]["fn_name"] == "sin" and be_d[0]["kind"] == "call" and be_d[0]["fn_name"] == "cos" {
            if len(be_n[0]["args"]) == 1 and len(be_d[0]["args"]) == 1 and ast_eq(be_n[0]["args"][0], be_d[0]["args"][0]) and ast_eq(be_n[1], be_d[1]) {
                let u_arg = be_n[0]["args"][0];
                _add_guard(ctx, "cos(" + to_ascii(u_arg) + ") != 0");
                let c_rat = rat_div(sp_n[0], sp_d[0]);
                let tan_node = ast_call("tan", [u_arg]);
                if not is_one_node(be_n[1]) { tan_node = ast_pow(tan_node, be_n[1]); }
                return simplify_node(ast_mul([c_rat, tan_node]), ctx);
            }
        }
        return simplify_node(ast_div(tn, td), ctx);
    }
    if k == "mul" {
        let oa = [];
        let i = 0;
        while i < len(s["args"]) { push(oa, _trig_simplify_node(s["args"][i], ctx)); i = i + 1; }
        let m = simplify_node(ast_mul(oa), ctx);
        if m["kind"] == "mul" {
            let sp = _split_coeff_body(m);
            let c = sp[0];
            let facs = [sp[1]];
            if sp[1]["kind"] == "mul" { facs = sp[1]["args"]; }

            // Cancel reciprocal & quotient pairs:
            //   tan(u)*cos(u) -> sin(u)  [cos(u) != 0]
            //   cot(u)*sin(u) -> cos(u)  [sin(u) != 0]
            //   sec(u)*cos(u) -> 1       [cos(u) != 0]
            //   csc(u)*sin(u) -> 1       [sin(u) != 0]
            //   tan(u)*cot(u) -> 1       [sin(u) != 0, cos(u) != 0]
            let used_f = [];
            let fi = 0;
            while fi < len(facs) { push(used_f, false); fi = fi + 1; }
            let out_f = [];
            let did_pair = false;
            fi = 0;
            while fi < len(facs) {
                if not used_f[fi] {
                    let fa = facs[fi];
                    let paired = false;
                    if fa["kind"] == "call" and len(fa["args"]) == 1 {
                        let fna = fa["fn_name"];
                        let ua = fa["args"][0];
                        let fj = fi + 1;
                        while fj < len(facs) {
                            if not used_f[fj] and facs[fj]["kind"] == "call" and len(facs[fj]["args"]) == 1 and ast_eq(ua, facs[fj]["args"][0]) {
                                let fnb = facs[fj]["fn_name"];
                                if (fna == "tan" and fnb == "cos") or (fna == "cos" and fnb == "tan") {
                                    _add_guard(ctx, "cos(" + to_ascii(ua) + ") != 0");
                                    push(out_f, ast_call("sin", [ua]));
                                    used_f[fi] = true; used_f[fj] = true; paired = true; did_pair = true; break;
                                }
                                if (fna == "cot" and fnb == "sin") or (fna == "sin" and fnb == "cot") {
                                    _add_guard(ctx, "sin(" + to_ascii(ua) + ") != 0");
                                    push(out_f, ast_call("cos", [ua]));
                                    used_f[fi] = true; used_f[fj] = true; paired = true; did_pair = true; break;
                                }
                                if (fna == "sec" and fnb == "cos") or (fna == "cos" and fnb == "sec") {
                                    _add_guard(ctx, "cos(" + to_ascii(ua) + ") != 0");
                                    used_f[fi] = true; used_f[fj] = true; paired = true; did_pair = true; break;
                                }
                                if (fna == "csc" and fnb == "sin") or (fna == "sin" and fnb == "csc") {
                                    _add_guard(ctx, "sin(" + to_ascii(ua) + ") != 0");
                                    used_f[fi] = true; used_f[fj] = true; paired = true; did_pair = true; break;
                                }
                                if (fna == "tan" and fnb == "cot") or (fna == "cot" and fnb == "tan") {
                                    _add_guard(ctx, "sin(" + to_ascii(ua) + ") != 0");
                                    _add_guard(ctx, "cos(" + to_ascii(ua) + ") != 0");
                                    used_f[fi] = true; used_f[fj] = true; paired = true; did_pair = true; break;
                                }
                            }
                            fj = fj + 1;
                        }
                    }
                    if not paired {
                        push(out_f, fa);
                    }
                }
                fi = fi + 1;
            }
            if did_pair {
                let rebuilt = [c];
                let ri = 0;
                while ri < len(out_f) { push(rebuilt, out_f[ri]); ri = ri + 1; }
                m = simplify_node(ast_mul(rebuilt), ctx);
                if m["kind"] != "mul" { return m; }
                sp = _split_coeff_body(m);
                c = sp[0];
                facs = [sp[1]];
                if sp[1]["kind"] == "mul" { facs = sp[1]["args"]; }
            }

            // Contract 2 * sin(u) * cos(u) -> sin(2*u)
            let sin_idx = -1; let cos_idx = -1; let u_match = nil;
            let a = 0;
            while a < len(facs) {
                if facs[a]["kind"] == "call" and facs[a]["fn_name"] == "sin" and len(facs[a]["args"]) == 1 {
                    let b = 0;
                    while b < len(facs) {
                        if facs[b]["kind"] == "call" and facs[b]["fn_name"] == "cos" and len(facs[b]["args"]) == 1 {
                            if ast_eq(facs[a]["args"][0], facs[b]["args"][0]) {
                                sin_idx = a; cos_idx = b; u_match = facs[a]["args"][0];
                                break;
                            }
                        }
                        b = b + 1;
                    }
                }
                if sin_idx >= 0 { break; }
                a = a + 1;
            }
            if sin_idx >= 0 and bi_mod(c["p"], _BI_TWO) == _BI_ZERO {
                let half_c = rat_div(c, RAT_TWO);
                let new_facs = [half_c, ast_call("sin", [simplify_node(ast_mul([RAT_TWO, u_match]), ctx)])];
                let t = 0;
                while t < len(facs) {
                    if t != sin_idx and t != cos_idx { push(new_facs, facs[t]); }
                    t = t + 1;
                }
                return simplify_node(ast_mul(new_facs), ctx);
            }
        }
        return m;
    }
    if k == "add" {
        let terms = [];
        let i = 0;
        while i < len(s["args"]) { push(terms, _trig_simplify_node(s["args"][i], ctx)); i = i + 1; }
        let cur = simplify_node(ast_add(terms), ctx);
        if cur["kind"] != "add" { return cur; }
        let arr = cur["args"];
        let used = [];
        i = 0;
        while i < len(arr) { push(used, false); i = i + 1; }
        let out_terms = [];
        let changed = false;
        i = 0;
        while i < len(arr) {
            if not used[i] {
                let sp_i = _split_coeff_body(arr[i]);
                let u_sin = _is_trig_sq(sp_i[1], "sin");
                let u_cos = _is_trig_sq(sp_i[1], "cos");
                if u_sin != nil or u_cos != nil {
                    let u_arg = u_sin;
                    let target_fn = "cos";
                    if u_sin == nil { u_arg = u_cos; target_fn = "sin"; }
                    let j = i + 1;
                    let matched = false;
                    while j < len(arr) {
                        if not used[j] {
                            let sp_j = _split_coeff_body(arr[j]);
                            let u_other = _is_trig_sq(sp_j[1], target_fn);
                            if u_other != nil and ast_eq(u_arg, u_other) {
                                if rat_eq(sp_i[0], sp_j[0]) {
                                    // c*sin^2(u) + c*cos^2(u) -> c
                                    used[i] = true; used[j] = true;
                                    push(out_terms, sp_i[0]);
                                    matched = true; changed = true;
                                    break;
                                } else if rat_eq(sp_i[0], rat_neg(sp_j[0])) {
                                    // c*cos^2(u) - c*sin^2(u) -> c*cos(2*u)
                                    let cos_coeff = sp_i[0];
                                    if u_cos == nil { cos_coeff = sp_j[0]; }
                                    used[i] = true; used[j] = true;
                                    push(out_terms, ast_mul([cos_coeff, ast_call("cos", [simplify_node(ast_mul([RAT_TWO, u_arg]), ctx)])]));
                                    matched = true; changed = true;
                                    break;
                                }
                            } else if is_one_node(sp_j[1]) and rat_eq(sp_j[0], rat_neg(sp_i[0])) {
                                // c - c*sin^2(u) -> c*cos^2(u), c - c*cos^2(u) -> c*sin^2(u)
                                used[i] = true; used[j] = true;
                                push(out_terms, ast_mul([sp_j[0], ast_pow(ast_call(target_fn, [u_arg]), RAT_TWO)]));
                                matched = true; changed = true;
                                break;
                            }
                        }
                        j = j + 1;
                    }
                    if not matched {
                        // Also check if constant preceded sin^2/cos^2
                        push(out_terms, arr[i]);
                    }
                } else if is_rat(arr[i]) {
                    let c_const = arr[i];
                    let j = i + 1;
                    let matched = false;
                    while j < len(arr) {
                        if not used[j] {
                            let sp_j = _split_coeff_body(arr[j]);
                            let u_s = _is_trig_sq(sp_j[1], "sin");
                            let u_c = _is_trig_sq(sp_j[1], "cos");
                            if (u_s != nil or u_c != nil) and rat_eq(c_const, rat_neg(sp_j[0])) {
                                used[i] = true; used[j] = true;
                                let other_fn = "cos";
                                let u_a = u_s;
                                if u_s == nil { other_fn = "sin"; u_a = u_c; }
                                push(out_terms, ast_mul([c_const, ast_pow(ast_call(other_fn, [u_a]), RAT_TWO)]));
                                matched = true; changed = true;
                                break;
                            }
                        }
                        j = j + 1;
                    }
                    if not matched { push(out_terms, arr[i]); }
                } else {
                    push(out_terms, arr[i]);
                }
            }
            i = i + 1;
        }
        if changed { return simplify_node(ast_add(out_terms), ctx); }
        return cur;
    }
    if k == "pow" {
        return simplify_node(ast_pow(_trig_simplify_node(s["base"], ctx), _trig_simplify_node(s["exp"], ctx)), ctx);
    }
    if k == "neg" {
        return simplify_node(ast_neg(_trig_simplify_node(s["arg"], ctx)), ctx);
    }
    return s;
}

// Trigonometric expansion: sin(A+B), cos(A+B), sin(2u) -> 2 sin(u) cos(u), cos(2u) -> cos^2(u) - sin^2(u)
fn _trig_expand_node(node, ctx) {
    let s = simplify_node(node, ctx);
    if s == nil or type(s) != "map" { return s; }
    let k = s["kind"];
    if k == "rel" {
        return ast_rel(s["op"], _trig_expand_node(s["lhs"], ctx), _trig_expand_node(s["rhs"], ctx));
    }
    if k == "call" and (s["fn_name"] == "sin" or s["fn_name"] == "cos") and len(s["args"]) == 1 {
        let u = s["args"][0];
        let fn_nm = s["fn_name"];
        // Sum/difference of angles: sin(A + B), cos(A + B)
        if u["kind"] == "add" and len(u["args"]) >= 2 {
            let a = u["args"][0];
            let rest = [];
            let i = 1;
            while i < len(u["args"]) { push(rest, u["args"][i]); i = i + 1; }
            let b = ast_add(rest);
            let sa = _trig_expand_node(ast_call("sin", [a]), ctx);
            let ca = _trig_expand_node(ast_call("cos", [a]), ctx);
            let sb = _trig_expand_node(ast_call("sin", [b]), ctx);
            let cb = _trig_expand_node(ast_call("cos", [b]), ctx);
            if fn_nm == "sin" {
                return _expand_node(ast_add([ast_mul([sa, cb]), ast_mul([ca, sb])]), ctx);
            }
            return _expand_node(ast_sub(ast_mul([ca, cb]), ast_mul([sa, sb])), ctx);
        }
        // Multiple angle: sin(n * w), cos(n * w) for small integer n in 2..6
        let sp = _split_coeff_body(u);
        if is_int_node(sp[0]) and not is_one_node(sp[1]) {
            let n_int = int_val_of(sp[0]);
            if n_int == 2 {
                let sw = _trig_expand_node(ast_call("sin", [sp[1]]), ctx);
                let cw = _trig_expand_node(ast_call("cos", [sp[1]]), ctx);
                if fn_nm == "sin" {
                    return simplify_node(ast_mul([RAT_TWO, sw, cw]), ctx);
                }
                return simplify_node(ast_sub(ast_pow(cw, RAT_TWO), ast_pow(sw, RAT_TWO)), ctx);
            }
            if n_int > 2 and n_int <= 6 {
                // Split n*w = w + (n-1)*w
                let split_sum = ast_add([sp[1], ast_mul([rat(n_int - 1, 1), sp[1]])]);
                return _trig_expand_node(ast_call(fn_nm, [split_sum]), ctx);
            }
        }
        return s;
    }
    if k == "add" or k == "mul" {
        let oa = [];
        let i = 0;
        while i < len(s["args"]) { push(oa, _trig_expand_node(s["args"][i], ctx)); i = i + 1; }
        return _expand_node(map{ "kind": k, "args": oa }, ctx);
    }
    if k == "div" {
        return simplify_node(ast_div(_trig_expand_node(s["num"], ctx), _trig_expand_node(s["den"], ctx)), ctx);
    }
    if k == "pow" {
        return _expand_node(ast_pow(_trig_expand_node(s["base"], ctx), _trig_expand_node(s["exp"], ctx)), ctx);
    }
    if k == "neg" {
        return simplify_node(ast_neg(_trig_expand_node(s["arg"], ctx)), ctx);
    }
    return s;
}

// Logarithm expansion: ln(A*B) -> ln(A) + ln(B), ln(A/B) -> ln(A) - ln(B), ln(A^k) -> k*ln(A)
fn _log_expand_node(node, ctx) {
    let s = simplify_node(node, ctx);
    if s == nil or type(s) != "map" { return s; }
    let k = s["kind"];
    if k == "rel" {
        return ast_rel(s["op"], _log_expand_node(s["lhs"], ctx), _log_expand_node(s["rhs"], ctx));
    }
    if k == "call" and s["fn_name"] == "ln" and len(s["args"]) == 1 {
        let u = s["args"][0];
        if u["kind"] == "div" {
            if len(free_vars(u["num"])) > 0 { _add_guard(ctx, to_ascii(u["num"]) + " > 0"); }
            if len(free_vars(u["den"])) > 0 { _add_guard(ctx, to_ascii(u["den"]) + " > 0"); }
            return simplify_node(ast_sub(
                _log_expand_node(ast_call("ln", [u["num"]]), ctx),
                _log_expand_node(ast_call("ln", [u["den"]]), ctx)
            ), ctx);
        }
        if u["kind"] == "mul" {
            let terms = [];
            let i = 0;
            while i < len(u["args"]) {
                let fi = u["args"][i];
                if len(free_vars(fi)) > 0 { _add_guard(ctx, to_ascii(fi) + " > 0"); }
                push(terms, _log_expand_node(ast_call("ln", [fi]), ctx));
                i = i + 1;
            }
            return simplify_node(ast_add(terms), ctx);
        }
        if u["kind"] == "pow" {
            if len(free_vars(u["base"])) > 0 { _add_guard(ctx, to_ascii(u["base"]) + " > 0"); }
            return simplify_node(ast_mul([
                u["exp"],
                _log_expand_node(ast_call("ln", [u["base"]]), ctx)
            ]), ctx);
        }
        if u["kind"] == "call" and u["fn_name"] == "sqrt" and len(u["args"]) == 1 {
            if len(free_vars(u["args"][0])) > 0 { _add_guard(ctx, to_ascii(u["args"][0]) + " > 0"); }
            return simplify_node(ast_mul([RAT_HALF, _log_expand_node(ast_call("ln", [u["args"][0]]), ctx)]), ctx);
        }
        return s;
    }
    if k == "add" or k == "mul" {
        let oa = [];
        let i = 0;
        while i < len(s["args"]) { push(oa, _log_expand_node(s["args"][i], ctx)); i = i + 1; }
        return simplify_node(map{ "kind": k, "args": oa }, ctx);
    }
    if k == "div" {
        return simplify_node(ast_div(_log_expand_node(s["num"], ctx), _log_expand_node(s["den"], ctx)), ctx);
    }
    if k == "neg" {
        return simplify_node(ast_neg(_log_expand_node(s["arg"], ctx)), ctx);
    }
    return s;
}

// Logarithm combination: c1*ln(A) + c2*ln(B) -> ln(A^c1 * B^c2) with domain guards A > 0, B > 0!
fn _log_combine_node(node, ctx) {
    let s = simplify_node(node, ctx);
    if s == nil or type(s) != "map" { return s; }
    let k = s["kind"];
    if k == "rel" {
        return ast_rel(s["op"], _log_combine_node(s["lhs"], ctx), _log_combine_node(s["rhs"], ctx));
    }
    if k == "mul" {
        // k * ln(A) -> ln(A^k)
        let arr = s["args"];
        let ln_arg = nil;
        let coeff_parts = [];
        let i = 0;
        while i < len(arr) {
            if ln_arg == nil and arr[i]["kind"] == "call" and arr[i]["fn_name"] == "ln" and len(arr[i]["args"]) == 1 {
                ln_arg = arr[i]["args"][0];
            } else {
                push(coeff_parts, arr[i]);
            }
            i = i + 1;
        }
        if ln_arg != nil and len(coeff_parts) > 0 {
            if len(free_vars(ln_arg)) > 0 { _add_guard(ctx, to_ascii(ln_arg) + " > 0"); }
            let exp_c = simplify_node(ast_mul(coeff_parts), ctx);
            return ast_call("ln", [simplify_node(ast_pow(ln_arg, exp_c), ctx)]);
        }
        return s;
    }
    if k == "add" {
        let num_factors = [];
        let den_factors = [];
        let other_terms = [];
        let i = 0;
        while i < len(s["args"]) {
            let ti = s["args"][i];
            let sp = _split_coeff_body(ti);
            if sp[1]["kind"] == "call" and sp[1]["fn_name"] == "ln" and len(sp[1]["args"]) == 1 {
                let arg_u = sp[1]["args"][0];
                if len(free_vars(arg_u)) > 0 { _add_guard(ctx, to_ascii(arg_u) + " > 0"); }
                let c = sp[0];
                if rat_is_pos(c) {
                    if rat_is_one(c) { push(num_factors, arg_u); }
                    else { push(num_factors, ast_pow(arg_u, c)); }
                } else if rat_is_neg(c) {
                    let pos_c = rat_neg(c);
                    if rat_is_one(pos_c) { push(den_factors, arg_u); }
                    else { push(den_factors, ast_pow(arg_u, pos_c)); }
                }
            } else {
                push(other_terms, _log_combine_node(ti, ctx));
            }
            i = i + 1;
        }
        if len(num_factors) > 0 or len(den_factors) > 0 {
            let num_e = simplify_node(ast_mul(num_factors), ctx);
            let combined_arg = num_e;
            if len(den_factors) > 0 {
                let den_e = simplify_node(ast_mul(den_factors), ctx);
                combined_arg = simplify_node(ast_div(num_e, den_e), ctx);
            }
            let ln_node = simplify_node(ast_call("ln", [combined_arg]), ctx);
            push(other_terms, ln_node);
            return simplify_node(ast_add(other_terms), ctx);
        }
        return s;
    }
    return s;
}

// Surd denominator rationalization:
// c / sqrt(d) -> c*sqrt(d)/d, and c / (A + B*sqrt(d)) -> c*(A - B*sqrt(d)) / (A^2 - B^2*d)
fn _rationalize_node(node, ctx) {
    let s = simplify_node(node, ctx);
    if s == nil or type(s) != "map" { return s; }
    if s["kind"] == "div" {
        let num_n = _rationalize_node(s["num"], ctx);
        let den_n = _rationalize_node(s["den"], ctx);
        // Case 1: den is k * sqrt(d) or sqrt(d)
        let sp_d = _split_coeff_body(den_n);
        if sp_d[1]["kind"] == "call" and sp_d[1]["fn_name"] == "sqrt" and len(sp_d[1]["args"]) == 1 {
            let rad = sp_d[1]["args"][0];
            let new_num = _expand_node(ast_mul([num_n, ast_call("sqrt", [rad])]), ctx);
            let new_den = simplify_node(ast_mul([sp_d[0], rad]), ctx);
            return simplify_node(ast_div(new_num, new_den), ctx);
        }
        // Case 2: den is a 2-term sum involving sqrt, e.g. A + B*sqrt(d) or c1*sqrt(d1) + c2*sqrt(d2)
        if den_n["kind"] == "add" and len(den_n["args"]) == 2 {
            let t0 = den_n["args"][0];
            let t1 = den_n["args"][1];
            let has_sq = (str_contains(to_ascii(t0), "sqrt(") or str_contains(to_ascii(t1), "sqrt("));
            if has_sq {
                let conj = ast_sub(t0, t1);
                let new_num = _expand_node(ast_mul([num_n, conj]), ctx);
                // (t0 + t1)*(t0 - t1) = t0^2 - t1^2
                let new_den = simplify_node(ast_sub(
                    _expand_node(ast_pow(t0, RAT_TWO), ctx),
                    _expand_node(ast_pow(t1, RAT_TWO), ctx)
                ), ctx);
                return simplify_node(ast_div(new_num, new_den), ctx);
            }
        }
        return simplify_node(ast_div(num_n, den_n), ctx);
    }
    if s["kind"] == "add" or s["kind"] == "mul" {
        let oa = [];
        let i = 0;
        while i < len(s["args"]) { push(oa, _rationalize_node(s["args"][i], ctx)); i = i + 1; }
        return simplify_node(map{ "kind": s["kind"], "args": oa }, ctx);
    }
    if s["kind"] == "neg" { return simplify_node(ast_neg(_rationalize_node(s["arg"], ctx)), ctx); }
    return s;
}

// Decompose an expanded expression linearly with respect to target variable `v`:
// Returns { is_linear: true, a: coeff_of_v, b: rest } such that expr == a*v + b, or { is_linear: false }.
fn _extract_linear_in_var(expr, v, ctx) {
    let exp_e = _expand_node(expr, ctx);
    let terms = [exp_e];
    if exp_e["kind"] == "add" { terms = exp_e["args"]; }
    let a_parts = [];
    let b_parts = [];
    let i = 0;
    while i < len(terms) {
        let t = terms[i];
        if not contains_var(t, v) {
            push(b_parts, t);
        } else if t["kind"] == "sym" and t["name"] == v {
            push(a_parts, RAT_ONE);
        } else if t["kind"] == "neg" and t["arg"]["kind"] == "sym" and t["arg"]["name"] == v {
            push(a_parts, RAT_NEG_ONE);
        } else if t["kind"] == "mul" {
            let v_count = 0;
            let rest = [];
            let j = 0;
            while j < len(t["args"]) {
                let fj = t["args"][j];
                if fj["kind"] == "sym" and fj["name"] == v {
                    v_count = v_count + 1;
                } else if contains_var(fj, v) {
                    return map{ "is_linear": false };
                } else {
                    push(rest, fj);
                }
                j = j + 1;
            }
            if v_count != 1 { return map{ "is_linear": false }; }
            push(a_parts, ast_mul(rest));
        } else {
            return map{ "is_linear": false };
        }
        i = i + 1;
    }
    return map{
        "is_linear": true,
        "a": simplify_node(ast_add(a_parts), ctx),
        "b": simplify_node(ast_add(b_parts), ctx)
    };
}

fn _flip_ineq_op(op) {
    if op == "<" { return ">"; }
    if op == "<=" { return ">="; }
    if op == ">" { return "<"; }
    if op == ">=" { return "<="; }
    return op;
}

// Smart Variable Isolator (`goal = "isolate"`):
// Handles symbolic/numeric linear equations & inequalities (with explicit inequality-flip step
// on negative divisor!) and fractional/rational linear equations like `1/R = 1/R1 + 1/R2`!
fn _isolate_var(rel_node, target_v, ctx) {
    let rel = rel_node;
    if rel["kind"] != "rel" {
        rel = ast_rel("=", rel, RAT_ZERO);
    }
    let op = rel["op"];
    let lhs = simplify_node(rel["lhs"], ctx);
    let rhs = simplify_node(rel["rhs"], ctx);

    // First try direct polynomial-linear isolation (preserves inequality signs cleanly!)
    let lin_l = _extract_linear_in_var(lhs, target_v, ctx);
    let lin_r = _extract_linear_in_var(rhs, target_v, ctx);
    if lin_l["is_linear"] and lin_r["is_linear"] {
        // Move v-terms to LHS and non-v terms to RHS: (aL - aR)*v [op] (bR - bL)
        let a_net = simplify_node(ast_sub(lin_l["a"], lin_r["a"]), ctx);
        let b_net = simplify_node(ast_sub(lin_r["b"], lin_l["b"]), ctx);
        if is_zero_node(a_net) {
            throw "isolate: variable '" + target_v + "' cancels out completely";
        }
        let mid_lhs = simplify_node(ast_mul([a_net, ast_sym(target_v)]), ctx);
        let mid_rel = ast_rel(op, mid_lhs, b_net);
        _record_step(ctx, "collect_" + target_v + "_terms_on_lhs", mid_rel);

        if is_one_node(a_net) {
            return ast_rel(op, ast_sym(target_v), b_net);
        }
        // Check sign of a_net for inequalities!
        if op != "=" and op != "!=" {
            let a_val = eval_ast(a_net, map{});
            if a_val != nil {
                if a_val < 0 {
                    let flipped = _flip_ineq_op(op);
                    let isolated_rhs = simplify_node(ast_div(b_net, a_net), ctx);
                    let res_rel = ast_rel(flipped, ast_sym(target_v), isolated_rhs);
                    _record_step(ctx, "divide_by_negative_flip_inequality (" + to_ascii(a_net) + " < 0: flip " + op + " to " + flipped + ")", res_rel);
                    return res_rel;
                } else {
                    let isolated_rhs = simplify_node(ast_div(b_net, a_net), ctx);
                    let res_rel = ast_rel(op, ast_sym(target_v), isolated_rhs);
                    _record_step(ctx, "divide_by_positive (" + to_ascii(a_net) + " > 0)", res_rel);
                    return res_rel;
                }
            } else {
                _add_guard(ctx, to_ascii(a_net) + " > 0 (flip inequality if " + to_ascii(a_net) + " < 0)");
            }
        } else {
            if len(free_vars(a_net)) > 0 {
                _add_guard(ctx, to_ascii(a_net) + " != 0");
            }
        }
        let iso_rhs = simplify_node(ast_div(b_net, a_net), ctx);
        let final_rel = ast_rel(op, ast_sym(target_v), iso_rhs);
        _record_step(ctx, "divide_both_sides_by_" + to_ascii(a_net), final_rel);
        return final_rel;
    }

    // Rational / fractional equation isolation (e.g., 1/R = 1/R1 + 1/R2 or (a*x+b)/(c*x+d) = y)
    if op == "=" or op == "!=" {
        let diff_nd = to_rational_nd(ast_sub(lhs, rhs), ctx);
        let d = 0;
        while d < len(diff_nd["orig_dens"]) {
            let den_d = simplify_node(diff_nd["orig_dens"][d], ctx);
            if len(free_vars(den_d)) > 0 {
                _add_guard(ctx, to_ascii(den_d) + " != 0");
            }
            d = d + 1;
        }
        let num_zero = ast_rel(op, diff_nd["num"], RAT_ZERO);
        _record_step(ctx, "clear_common_denominator", num_zero);
        let lin_num = _extract_linear_in_var(diff_nd["num"], target_v, ctx);
        if lin_num["is_linear"] and not is_zero_node(lin_num["a"]) {
            let a_c = lin_num["a"];
            let rhs_c = simplify_node(ast_neg(lin_num["b"]), ctx);
            // Normalize signs if both a_c and rhs_c have leading minus (e.g. -(R1+R2)*R = -R1*R2)
            let sp_a = _split_term_sign(a_c);
            let sp_r = _split_term_sign(rhs_c);
            if sp_a[0] and sp_r[0] {
                a_c = sp_a[1];
                rhs_c = sp_r[1];
            } else if a_c["kind"] == "add" {
                // Check if every term in a_c is negative (like -R1 - R2)
                let all_neg = true;
                let k = 0;
                while k < len(a_c["args"]) {
                    if not _split_term_sign(a_c["args"][k])[0] { all_neg = false; break; }
                    k = k + 1;
                }
                if all_neg {
                    a_c = simplify_node(ast_neg(a_c), ctx);
                    rhs_c = simplify_node(ast_neg(rhs_c), ctx);
                }
            }
            if len(free_vars(a_c)) > 0 {
                _add_guard(ctx, to_ascii(a_c) + " != 0");
            }
            let iso = simplify_node(ast_div(rhs_c, a_c), ctx);
            let final_rel = ast_rel(op, ast_sym(target_v), iso);
            _record_step(ctx, "isolate_" + target_v, final_rel);
            return final_rel;
        }
    }
    throw "isolate: expression is non-linear in target variable '" + target_v + "'";
}

// Public Smart Symbolic Transformer (`transform(input, goal = "auto", opts = nil)`)
fn transform(input, goal = "auto", opts = nil) {
    if opts == nil { opts = map{}; }
    if goal == nil or goal == "" { goal = "auto"; }
    let g = str_lower(str(goal));
    let ctx = _new_ctx();
    let parsed = parse_math(input);
    _record_step(ctx, "input_parsed", parsed);
    if not (map_has(opts, "keep_custom") and opts["keep_custom"]) and _contains_user_or_prime_call(parsed) {
        let exp_u = expand_user_functions(parsed, 0);
        if not ast_eq(exp_u, parsed) {
            parsed = exp_u;
            _record_step(ctx, "expand_custom_functions", parsed);
        }
    }

    let result_ast = parsed;
    let extra = map{};

    if g == "simplify" {
        result_ast = simplify_node(parsed, ctx);
        _record_step(ctx, "canonical_simplify", result_ast);
    } else if g == "expand" {
        result_ast = _expand_node(parsed, ctx);
        _record_step(ctx, "algebraic_expand", result_ast);
    } else if g == "factor" {
        let simp = simplify_node(parsed, ctx);
        _record_step(ctx, "simplify_before_factor", simp);
        result_ast = _factor_expr(simp, ctx);
        _record_step(ctx, "factor_over_Q", result_ast);
    } else if g == "complete_square" {
        let v_opt = nil;
        if map_has(opts, "var") { v_opt = opts["var"]; }
        let cs = _complete_square_info(parsed, v_opt, ctx);
        result_ast = cs["ast"];
        extra["vertex"] = cs["vertex"];
        extra["vertex_exact"] = cs["vertex_exact"];
        extra["extremum_type"] = cs["extremum_type"];
        _record_step(ctx, "complete_the_square", result_ast);
    } else if g == "apart" {
        let v_opt = nil;
        if map_has(opts, "var") { v_opt = opts["var"]; }
        let simp = simplify_node(parsed, ctx);
        _record_step(ctx, "simplify_rational", simp);
        result_ast = _partial_fractions(simp, v_opt, ctx);
        _record_step(ctx, "partial_fraction_decomposition", result_ast);
    } else if g == "trig_simplify" {
        result_ast = _trig_simplify_node(parsed, ctx);
        _record_step(ctx, "trig_simplify", result_ast);
    } else if g == "trig_expand" {
        result_ast = _trig_expand_node(parsed, ctx);
        _record_step(ctx, "trig_expand", result_ast);
    } else if g == "log_expand" {
        result_ast = _log_expand_node(parsed, ctx);
        _record_step(ctx, "log_expand", result_ast);
    } else if g == "log_combine" {
        result_ast = _log_combine_node(parsed, ctx);
        _record_step(ctx, "log_combine", result_ast);
    } else if g == "rationalize" {
        result_ast = _rationalize_node(parsed, ctx);
        _record_step(ctx, "rationalize_denominator", result_ast);
    } else if g == "isolate" {
        let v_target = nil;
        if map_has(opts, "var") { v_target = opts["var"]; }
        else if map_has(opts, "target") { v_target = opts["target"]; }
        if v_target == nil {
            let fvs = free_vars(parsed);
            if len(fvs) > 0 { v_target = fvs[0]; }
            else { throw "isolate: no target variable specified or found"; }
        }
        result_ast = _isolate_var(parsed, v_target, ctx);
        extra["isolated_var"] = v_target;
        extra["rhs"] = result_ast["rhs"];
        extra["rhs_ascii"] = to_ascii(result_ast["rhs"]);
        extra["rhs_unicode"] = to_unicode(result_ast["rhs"]);
        extra["rhs_latex"] = to_latex(result_ast["rhs"]);
    } else if g == "auto" {
        let raw_s = to_ascii(parsed);
        if parsed["kind"] == "rel" {
            let fvs = free_vars(parsed);
            if len(fvs) == 1 {
                let try_iso = try _isolate_var(parsed, fvs[0], ctx) catch nil;
                if try_iso != nil {
                    result_ast = try_iso;
                } else {
                    result_ast = simplify_node(parsed, ctx);
                    _record_step(ctx, "canonical_simplify", result_ast);
                }
            } else {
                result_ast = simplify_node(parsed, ctx);
                _record_step(ctx, "canonical_simplify", result_ast);
            }
        } else {
            result_ast = simplify_node(parsed, ctx);
            _record_step(ctx, "canonical_simplify", result_ast);
            if str_contains(raw_s, "sin(") or str_contains(raw_s, "cos(") or str_contains(raw_s, "tan(") {
                result_ast = _trig_simplify_node(result_ast, ctx);
                _record_step(ctx, "trig_simplify", result_ast);
            }
            if str_contains(raw_s, "ln(") {
                let lc = _log_combine_node(result_ast, ctx);
                if not ast_eq(lc, result_ast) {
                    result_ast = lc;
                    _record_step(ctx, "log_combine", result_ast);
                }
            }
            let exp_form = try _expand_node(result_ast, _new_ctx()) catch result_ast;
            let fac_form = try _factor_expr(result_ast, _new_ctx()) catch result_ast;
            extra["expanded_ascii"] = to_ascii(exp_form);
            extra["expanded_unicode"] = to_unicode(exp_form);
            extra["expanded_latex"] = to_latex(exp_form);
            extra["factored_ascii"] = to_ascii(fac_form);
            extra["factored_unicode"] = to_unicode(fac_form);
            extra["factored_latex"] = to_latex(fac_form);
        }
    } else {
        throw "Unknown transform goal: '" + goal + "'";
    }

    let out = map{
        "ok": true,
        "goal": g,
        "ast": result_ast,
        "ascii": to_ascii(result_ast),
        "unicode": to_unicode(result_ast),
        "latex": to_latex(result_ast),
        "domain_guards": ctx["guards"],
        "domain_guard": _guards_joined(ctx),
        "steps": ctx["steps"]
    };
    let ek = map_keys(extra);
    let ei = 0;
    while ei < len(ek) {
        out[ek[ei]] = extra[ek[ei]];
        ei = ei + 1;
    }
    return out;
}

// ── Universal Equation, Inequality & System Solver ────────────────────────────

fn _make_real_sol(ast_node, val_num = nil) {
    let clean_ast = simplify_node(ast_node, nil);
    let fv = val_num;
    if fv == nil { fv = eval_ast(clean_ast, map{}); }
    return map{
        "kind": "real",
        "value": fv,
        "exact": to_ascii(clean_ast),
        "ascii": to_ascii(clean_ast),
        "unicode": to_unicode(clean_ast),
        "latex": to_latex(clean_ast),
        "ast": clean_ast
    };
}

fn _make_complex_sol(re_val, im_val, re_ast = nil, im_abs_ast = nil) {
    let sign_op = " + ";
    if im_val < 0 { sign_op = " - "; }
    let re_a = fmt_float(re_val, 10);
    let re_u = re_a;
    let re_l = re_a;
    if re_ast != nil {
        re_a = to_ascii(re_ast);
        re_u = to_unicode(re_ast);
        re_l = to_latex(re_ast);
    }
    let im_mag = num_abs(im_val);
    let im_a = fmt_float(im_mag, 10);
    let im_u = im_a;
    let im_l = im_a;
    if im_abs_ast != nil {
        im_a = to_ascii(im_abs_ast);
        im_u = to_unicode(im_abs_ast);
        im_l = to_latex(im_abs_ast);
    }
    let i_part_a = im_a + "*i";
    let i_part_u = im_u + "i";
    let i_part_l = im_l + " i";
    if im_a == "1" {
        i_part_a = "i"; i_part_u = "i"; i_part_l = "i";
    } else if str_contains(im_a, "/") or str_contains(im_a, "+") or str_contains(im_a, "-") {
        i_part_a = "(" + im_a + ")*i";
        i_part_u = "(" + im_u + ")i";
    }
    let full_a = ""; let full_u = ""; let full_l = "";
    if num_abs(re_val) < 0.000000000001 {
        if im_val < 0 {
            full_a = "-" + i_part_a; full_u = "-" + i_part_u; full_l = "-" + i_part_l;
        } else {
            full_a = i_part_a; full_u = i_part_u; full_l = i_part_l;
        }
    } else {
        full_a = re_a + sign_op + i_part_a;
        full_u = re_u + sign_op + i_part_u;
        full_l = re_l + sign_op + i_part_l;
    }
    return map{
        "kind": "complex",
        "re": re_val,
        "im": im_val,
        "ascii": full_a,
        "unicode": full_u,
        "latex": full_l
    };
}

fn _sort_real_sols(sols) {
    let out = [];
    let i = 0;
    while i < len(sols) { push(out, sols[i]); i = i + 1; }
    let n = len(out);
    let a = 1;
    while a < n {
        let key = out[a];
        let kv = key["value"];
        let b = a - 1;
        while b >= 0 and out[b]["value"] != nil and kv != nil and out[b]["value"] > kv {
            out[b + 1] = out[b];
            b = b - 1;
        }
        out[b + 1] = key;
        a = a + 1;
    }
    // Deduplicate roots closer than 1e-9 (preferring exact non-num AST over float num AST)
    let dedup = [];
    i = 0;
    while i < len(out) {
        let cur = out[i];
        if len(dedup) == 0 {
            push(dedup, cur);
        } else {
            let prev = dedup[len(dedup) - 1];
            if prev["value"] != nil and cur["value"] != nil and num_abs(prev["value"] - cur["value"]) < 0.000000001 {
                if prev["ast"]["kind"] == "num" and cur["ast"]["kind"] != "num" {
                    dedup[len(dedup) - 1] = cur;
                }
            } else {
                push(dedup, cur);
            }
        }
        i = i + 1;
    }
    return dedup;
}

// Exact Quadratic Solver over Q: c_0 + c_1*x + c_2*x^2 = 0
// Returns { real_sols: [...], complex_sols: [...] }
fn _solve_quadratic_exact(p_quad) {
    let cp = poly_content_and_primitive(p_quad);
    let prim = cp["prim"]; // integer coefficients with prim[2] > 0!
    let c_bi = prim[0]["p"];
    let b_bi = prim[1]["p"];
    let a_bi = prim[2]["p"];
    let two_a = _BI_TWO * a_bi;
    let disc = b_bi * b_bi - bigint(4) * a_bi * c_bi;

    if disc == _BI_ZERO {
        let r0 = rat(_BI_ZERO - b_bi, two_a);
        return map{ "real_sols": [_make_real_sol(r0)], "complex_sols": [], "discriminant": 0 };
    }
    if disc > _BI_ZERO {
        let sp = bi_square_split(disc);
        let s_bi = sp[0];
        let d_bi = sp[1];
        if d_bi == _BI_ONE {
            let r1 = rat((_BI_ZERO - b_bi) - s_bi, two_a);
            let r2 = rat((_BI_ZERO - b_bi) + s_bi, two_a);
            return map{
                "real_sols": _sort_real_sols([_make_real_sol(r1), _make_real_sol(r2)]),
                "complex_sols": [],
                "discriminant": bi_to_float(disc)
            };
        }
        // Reduce (-b +- s*sqrt(d)) / (2a) by gcd(|b|, s, 2a)!
        let g = bi_gcd(bi_gcd(b_bi, s_bi), two_a);
        let nb = (_BI_ZERO - b_bi) / g;
        let ns = s_bi / g;
        let den = two_a / g;
        let rad = ast_call("sqrt", [rat(d_bi, 1)]);
        let surd_term = rad;
        if ns > _BI_ONE { surd_term = ast_mul([rat(ns, 1), rad]); }

        let num_minus = ast_neg(surd_term);
        let num_plus = surd_term;
        if nb != _BI_ZERO {
            num_minus = ast_sub(rat(nb, 1), surd_term);
            num_plus = ast_add([rat(nb, 1), surd_term]);
        }
        let ast_m = num_minus;
        let ast_p = num_plus;
        if den > _BI_ONE {
            ast_m = ast_div(num_minus, rat(den, 1));
            ast_p = ast_div(num_plus, rat(den, 1));
        }
        let fv_d = num_sqrt(bi_to_float(d_bi));
        let fv_m = (bi_to_float(nb) - bi_to_float(ns) * fv_d) / bi_to_float(den);
        let fv_p = (bi_to_float(nb) + bi_to_float(ns) * fv_d) / bi_to_float(den);
        let s1 = map{
            "kind": "real",
            "value": fv_m,
            "exact": to_ascii(ast_m),
            "ascii": to_ascii(ast_m),
            "unicode": to_unicode(ast_m),
            "latex": to_latex(ast_m),
            "ast": ast_m
        };
        let s2 = map{
            "kind": "real",
            "value": fv_p,
            "exact": to_ascii(ast_p),
            "ascii": to_ascii(ast_p),
            "unicode": to_unicode(ast_p),
            "latex": to_latex(ast_p),
            "ast": ast_p
        };
        return map{
            "real_sols": [s1, s2],
            "complex_sols": [],
            "discriminant": bi_to_float(disc)
        };
    }
    // disc < 0 -> exact complex conjugate roots!
    let abs_disc = _BI_ZERO - disc;
    let sp = bi_square_split(abs_disc);
    let s_bi = sp[0];
    let d_bi = sp[1];
    let re_rat = rat(_BI_ZERO - b_bi, two_a);
    let re_f = rat_to_float(re_rat);
    let im_abs_ast = nil;
    if d_bi == _BI_ONE {
        im_abs_ast = rat(s_bi, two_a);
    } else {
        let g = bi_gcd(s_bi, two_a);
        let ns = s_bi / g;
        let den = two_a / g;
        let rad = ast_call("sqrt", [rat(d_bi, 1)]);
        let num_im = rad;
        if ns > _BI_ONE { num_im = ast_mul([rat(ns, 1), rad]); }
        if den == _BI_ONE { im_abs_ast = num_im; }
        else { im_abs_ast = ast_div(num_im, rat(den, 1)); }
    }
    let im_f = eval_ast(im_abs_ast, map{});
    return map{
        "real_sols": [],
        "complex_sols": [
            _make_complex_sol(re_f, 0.0 - im_f, re_rat, im_abs_ast),
            _make_complex_sol(re_f, im_f, re_rat, im_abs_ast)
        ],
        "discriminant": bi_to_float(disc)
    };
}

// Cardano / Viète Exact & High-Precision Cubic Solver for a*x^3 + b*x^2 + c*x + d = 0
fn _solve_cubic_cardano(poly) {
    let mon = poly_monic(poly);
    let c0 = rat_to_float(mon[0]);
    let c1 = rat_to_float(mon[1]);
    let c2 = rat_to_float(mon[2]);
    // Depressed cubic x = t - c2/3 => t^3 + p*t + q = 0
    let shift = c2 / 3.0;
    let p = c1 - (c2 * c2) / 3.0;
    let q = (2.0 * c2 * c2 * c2) / 27.0 - (c2 * c1) / 3.0 + c0;
    let delta = (q * q) / 4.0 + (p * p * p) / 27.0;
    let real_s = [];
    let comp_s = [];

    if num_abs(delta) <= 0.00000000000001 {
        if num_abs(p) <= 0.00000000000001 and num_abs(q) <= 0.00000000000001 {
            let r = 0.0 - shift;
            let sr = float_snap_rat(r);
            if sr != nil and rat_is_zero(poly_eval_rat(poly, sr)) { push(real_s, _make_real_sol(sr)); }
            else { push(real_s, _make_real_sol(ast_num(r), r)); }
        } else {
            let u = 0.0;
            let half_q = 0.0 - q / 2.0;
            if half_q < 0.0 { u = 0.0 - num_pow(0.0 - half_q, 1.0 / 3.0); }
            else { u = num_pow(half_q, 1.0 / 3.0); }
            let r1 = 2.0 * u - shift;
            let r2 = (0.0 - u) - shift;
            push(real_s, _make_real_sol(ast_num(r1), r1));
            push(real_s, _make_real_sol(ast_num(r2), r2));
        }
    } else if delta > 0.0 {
        let sq = num_sqrt(delta);
        let u_arg = (0.0 - q / 2.0) + sq;
        let v_arg = (0.0 - q / 2.0) - sq;
        let u = 0.0; let v = 0.0;
        if u_arg < 0.0 { u = 0.0 - num_pow(0.0 - u_arg, 1.0 / 3.0); }
        else if u_arg > 0.0 { u = num_pow(u_arg, 1.0 / 3.0); }
        if v_arg < 0.0 { v = 0.0 - num_pow(0.0 - v_arg, 1.0 / 3.0); }
        else if v_arg > 0.0 { v = num_pow(v_arg, 1.0 / 3.0); }
        let r1 = (u + v) - shift;
        push(real_s, _make_real_sol(ast_num(r1), r1));
        let re_c = (0.0 - (u + v) / 2.0) - shift;
        let im_c = num_abs((num_sqrt(3.0) / 2.0) * (u - v));
        push(comp_s, _make_complex_sol(re_c, 0.0 - im_c));
        push(comp_s, _make_complex_sol(re_c, im_c));
    } else {
        // Casus irreducibilis: Viète trigonometric formula for 3 distinct real roots!
        let r_mag = 2.0 * num_sqrt((0.0 - p) / 3.0);
        let cos_arg = _clamp_num((3.0 * q) / (p * r_mag), -1.0, 1.0);
        let phi = (_PI_VAL / 2.0) - num_atan2(cos_arg, num_sqrt(_max_num(0.0, 1.0 - cos_arg * cos_arg)));
        let k = 0;
        while k < 3 {
            let tk = r_mag * num_cos((phi + 2.0 * _PI_VAL * k) / 3.0) - shift;
            push(real_s, _make_real_sol(ast_num(tk), tk));
            k = k + 1;
        }
    }
    return map{ "real_sols": _sort_real_sols(real_s), "complex_sols": comp_s };
}

// Aberth-Ehrlich Simultaneous Complex All-Roots Solver for degree-N polynomials!
fn _c_eval_poly_and_deriv(f_coeffs, zr, zi) {
    // f_coeffs = [c_0, c_1, ..., c_n] as floats
    let n = len(f_coeffs) - 1;
    let pr = f_coeffs[n]; let pi = 0.0;
    let dr = 0.0; let di = 0.0;
    let k = n - 1;
    while k >= 0 {
        // d = d * z + p
        let ndr = dr * zr - di * zi + pr;
        let ndi = dr * zi + di * zr + pi;
        dr = ndr; di = ndi;
        // p = p * z + f_coeffs[k]
        let npr = pr * zr - pi * zi + f_coeffs[k];
        let npi = pr * zi + pi * zr;
        pr = npr; pi = npi;
        k = k - 1;
    }
    return [pr, pi, dr, di];
}

fn _polish_real_poly_root(f_coeffs, x0) {
    let x = x0;
    let n = len(f_coeffs) - 1;
    let iter = 0;
    while iter < 16 {
        let pv = f_coeffs[n];
        let dv = 0.0;
        let k = n - 1;
        while k >= 0 {
            dv = dv * x + pv;
            pv = pv * x + f_coeffs[k];
            k = k - 1;
        }
        if num_abs(pv) < 0.000000000000001 { break; }
        if num_abs(dv) < 0.000000000001 { break; }
        x = x - (pv / dv);
        iter = iter + 1;
    }
    return x;
}

fn _solve_aberth_ehrlich(poly) {
    let mon = poly_monic(poly);
    let n = poly_deg(mon);
    if n <= 0 { return map{ "real_sols": [], "complex_sols": [] }; }
    let fc = [];
    let max_c = 0.0;
    let i = 0;
    while i <= n {
        let v = rat_to_float(mon[i]);
        push(fc, v);
        if i < n and num_abs(v) > max_c { max_c = num_abs(v); }
        i = i + 1;
    }
    // Cauchy root radius bound
    let radius = 1.0 + max_c;
    if radius > 100.0 { radius = num_pow(radius, 1.0 / n) + 1.0; }
    let zr = [];
    let zi = [];
    let k = 0;
    while k < n {
        let ang = (2.0 * _PI_VAL * k) / n + 0.37129;
        let rk = radius * (0.85 + 0.15 * (k / n));
        push(zr, rk * num_cos(ang));
        push(zi, rk * num_sin(ang));
        k = k + 1;
    }
    let iter = 0;
    while iter < 96 {
        let max_step = 0.0;
        k = 0;
        while k < n {
            let pd = _c_eval_poly_and_deriv(fc, zr[k], zi[k]);
            let pr = pd[0]; let pi = pd[1];
            let dr = pd[2]; let di = pd[3];
            let p_norm = num_sqrt(pr * pr + pi * pi);
            if p_norm > 0.00000000000001 {
                let d_mag2 = dr * dr + di * di;
                if d_mag2 > 0.00000000000000000001 {
                    // w0 = P(z_k) / P'(z_k)
                    let w0r = (pr * dr + pi * di) / d_mag2;
                    let w0i = (pi * dr - pr * di) / d_mag2;
                    // sum_{j != k} 1 / (z_k - z_j)
                    let sr = 0.0; let si = 0.0;
                    let j = 0;
                    while j < n {
                        if j != k {
                            let dx = zr[k] - zr[j];
                            let dy = zi[k] - zi[j];
                            let m2 = dx * dx + dy * dy;
                            if m2 > 0.00000000000000000001 {
                                sr = sr + dx / m2;
                                si = si - dy / m2;
                            }
                        }
                        j = j + 1;
                    }
                    // denom = 1 - w0 * s
                    let den_r = 1.0 - (w0r * sr - w0i * si);
                    let den_i = 0.0 - (w0r * si + w0i * sr);
                    let den_m2 = den_r * den_r + den_i * den_i;
                    if den_m2 > 0.00000000000000000001 {
                        let step_r = (w0r * den_r + w0i * den_i) / den_m2;
                        let step_i = (w0i * den_r - w0r * den_i) / den_m2;
                        zr[k] = zr[k] - step_r;
                        zi[k] = zi[k] - step_i;
                        let st_m = num_sqrt(step_r * step_r + step_i * step_i);
                        if st_m > max_step { max_step = st_m; }
                    }
                }
            }
            k = k + 1;
        }
        if max_step < 0.00000000000005 { break; }
        iter = iter + 1;
    }

    let real_s = [];
    let comp_s = [];
    k = 0;
    while k < n {
        if num_abs(zi[k]) < 0.00000001 {
            let rx = _polish_real_poly_root(fc, zr[k]);
            let sr = float_snap_rat(rx, 10000, 0.00000000001);
            if sr != nil and rat_is_zero(poly_eval_rat(poly, sr)) {
                push(real_s, _make_real_sol(sr));
            } else {
                push(real_s, _make_real_sol(ast_num(rx), rx));
            }
        } else {
            push(comp_s, _make_complex_sol(zr[k], zi[k]));
        }
        k = k + 1;
    }
    return map{ "real_sols": _sort_real_sols(real_s), "complex_sols": comp_s };
}

// Solve arbitrary univariate polynomial P(x) = 0 over Q[x]:
// Combines exact Rational Root Theorem factorization + exact Quadratic + Cardano Cubic + Aberth-Ehrlich!
fn solve_polynomial_all(poly, v_name) {
    let d = poly_deg(poly);
    if d <= 0 {
        return map{ "real_sols": [], "complex_sols": [] };
    }
    if d == 1 {
        let r = rat_neg(rat_div(poly[0], poly[1]));
        return map{ "real_sols": [_make_real_sol(r)], "complex_sols": [] };
    }
    if d == 2 {
        return _solve_quadratic_exact(poly);
    }
    let fq = poly_factor_Q(poly, v_name);
    let real_all = [];
    let comp_all = [];
    let fi = 0;
    while fi < len(fq["factors"]) {
        let fp = fq["factors"][fi]["poly"];
        let fd = poly_deg(fp);
        if fd == 1 {
            let r = rat_neg(rat_div(fp[0], fp[1]));
            push(real_all, _make_real_sol(r));
        } else if fd == 2 {
            let qres = _solve_quadratic_exact(fp);
            let j = 0;
            while j < len(qres["real_sols"]) { push(real_all, qres["real_sols"][j]); j = j + 1; }
            j = 0;
            while j < len(qres["complex_sols"]) { push(comp_all, qres["complex_sols"][j]); j = j + 1; }
        } else if fd == 3 {
            let cres = _solve_cubic_cardano(fp);
            let j = 0;
            while j < len(cres["real_sols"]) { push(real_all, cres["real_sols"][j]); j = j + 1; }
            j = 0;
            while j < len(cres["complex_sols"]) { push(comp_all, cres["complex_sols"][j]); j = j + 1; }
        } else {
            let ares = _solve_aberth_ehrlich(fp);
            let j = 0;
            while j < len(ares["real_sols"]) { push(real_all, ares["real_sols"][j]); j = j + 1; }
            j = 0;
            while j < len(ares["complex_sols"]) { push(comp_all, ares["complex_sols"][j]); j = j + 1; }
        }
        fi = fi + 1;
    }
    return map{
        "real_sols": _sort_real_sols(real_all),
        "complex_sols": comp_all
    };
}

// ── Specialized Single-Variable Solvers (Radical, Abs, Log, Exp, Trig, Numeric) ──

fn _find_call_nodes(node, target_names, v_name, out_list) {
    if node == nil or type(node) != "map" { return; }
    let k = node["kind"];
    if k == "call" {
        let nm = node["fn_name"];
        let ti = 0;
        while ti < len(target_names) {
            if nm == target_names[ti] and contains_var(node, v_name) {
                push(out_list, node);
            }
            ti = ti + 1;
        }
        let i = 0;
        while i < len(node["args"]) { _find_call_nodes(node["args"][i], target_names, v_name, out_list); i = i + 1; }
        return;
    }
    if k == "neg" { _find_call_nodes(node["arg"], target_names, v_name, out_list); return; }
    if k == "sub" { _find_call_nodes(node["left"], target_names, v_name, out_list); _find_call_nodes(node["right"], target_names, v_name, out_list); return; }
    if k == "div" { _find_call_nodes(node["num"], target_names, v_name, out_list); _find_call_nodes(node["den"], target_names, v_name, out_list); return; }
    if k == "pow" { _find_call_nodes(node["base"], target_names, v_name, out_list); _find_call_nodes(node["exp"], target_names, v_name, out_list); return; }
    if k == "add" or k == "mul" {
        let i = 0;
        while i < len(node["args"]) { _find_call_nodes(node["args"][i], target_names, v_name, out_list); i = i + 1; }
    }
}

// Isolate one occurrence of `target_call` in `diff_expr == 0` as `coeff * target_call = rhs_rest`.
fn _isolate_subexpr_linear(diff_expr, target_call, ctx) {
    let exp_d = simplify_node(diff_expr, ctx);
    let terms = [exp_d];
    if exp_d["kind"] == "add" { terms = exp_d["args"]; }
    let c_parts = [];
    let r_parts = [];
    let i = 0;
    while i < len(terms) {
        let t = terms[i];
        if ast_eq(t, target_call) {
            push(c_parts, RAT_ONE);
        } else if t["kind"] == "neg" and ast_eq(t["arg"], target_call) {
            push(c_parts, RAT_NEG_ONE);
        } else if t["kind"] == "mul" {
            let found_idx = -1;
            let rest = [];
            let j = 0;
            while j < len(t["args"]) {
                if found_idx < 0 and ast_eq(t["args"][j], target_call) {
                    found_idx = j;
                } else {
                    push(rest, t["args"][j]);
                }
                j = j + 1;
            }
            if found_idx >= 0 {
                push(c_parts, ast_mul(rest));
            } else {
                push(r_parts, ast_neg(t));
            }
        } else {
            push(r_parts, ast_neg(t));
        }
        i = i + 1;
    }
    if len(c_parts) == 0 { return nil; }
    return map{
        "coeff": simplify_node(ast_add(c_parts), ctx),
        "rhs": simplify_node(ast_add(r_parts), ctx)
    };
}

// Numerical Brent-Dekker + Newton-Raphson 1D root polisher on [a, b] where f(a)*f(b) <= 0
fn _brent_polish_1d(expr, v_name, a_in, b_in, fa_in, fb_in) {
    let a = a_in; let b = b_in;
    let fa = fa_in; let fb = fb_in;
    if num_abs(fa) == 0.0 { return a; }
    if num_abs(fb) == 0.0 { return b; }
    let c = a; let fc = fa;
    let d = b - a; let e = d;
    let iter = 0;
    while iter < 80 {
        if (fb > 0.0 and fc > 0.0) or (fb < 0.0 and fc < 0.0) {
            c = a; fc = fa; d = b - a; e = d;
        }
        if num_abs(fc) < num_abs(fb) {
            a = b; b = c; c = a;
            fa = fb; fb = fc; fc = fa;
        }
        let tol = 0.00000000000002 * num_abs(b) + 0.000000000000005;
        let xm = 0.5 * (c - b);
        if num_abs(xm) <= tol or num_abs(fb) < 0.000000000000001 {
            return b;
        }
        if num_abs(e) >= tol and num_abs(fa) > num_abs(fb) {
            let s = fb / fa;
            let p = 0.0; let q = 0.0;
            if a == c {
                p = 2.0 * xm * s;
                q = 1.0 - s;
            } else {
                q = fa / fc;
                let r = fb / fc;
                p = s * (2.0 * xm * q * (q - r) - (b - a) * (r - 1.0));
                q = (q - 1.0) * (r - 1.0) * (s - 1.0);
            }
            if p > 0.0 { q = 0.0 - q; }
            p = num_abs(p);
            let min1 = 3.0 * xm * q - num_abs(tol * q);
            let min2 = num_abs(e * q);
            let best = min1;
            if min2 < best { best = min2; }
            if 2.0 * p < best {
                e = d; d = p / q;
            } else {
                d = xm; e = d;
            }
        } else {
            d = xm; e = d;
        }
        a = b; fa = fb;
        if num_abs(d) > tol { b = b + d; }
        else {
            if xm >= 0.0 { b = b + tol; }
            else { b = b - tol; }
        }
        fb = eval_ast(expr, _env1(v_name, b));
        if fb == nil {
            // Domain boundary hit inside step; fall back to midpoint
            b = 0.5 * (a + c);
            fb = eval_ast(expr, _env1(v_name, b));
            if fb == nil { return nil; }
        }
        iter = iter + 1;
    }
    return b;
}

// General Transcendental 1D Solver: multi-scale grid bracketing + Brent-Dekker + Newton polish!
fn _solve_transcendental_1d(diff_expr, orig_lhs, orig_rhs, v_name, xmin = -40.0, xmax = 40.0) {
    let grid = [];
    // Coarse-fine grid over [xmin, xmax] PLUS logarithmic positive points near 0+ for ln(x)
    let n_main = 640;
    let i = 0;
    while i <= n_main {
        let x = xmin + ((xmax - xmin) * i) / n_main;
        push(grid, x);
        i = i + 1;
    }
    if xmin <= 0.0 and xmax > 0.0 {
        let log_pts = [0.00001, 0.0001, 0.001, 0.005, 0.01, 0.02, 0.05, 0.1, 0.2, 0.35, 0.5, 0.75, 1.0, 1.5, 2.0, 2.5, 3.0];
        let j = 0;
        while j < len(log_pts) {
            if log_pts[j] <= xmax { push(grid, log_pts[j]); }
            j = j + 1;
        }
    }
    // Sort grid ascending
    let ng = len(grid);
    let a = 1;
    while a < ng {
        let kv = grid[a];
        let b = a - 1;
        while b >= 0 and grid[b] > kv {
            grid[b + 1] = grid[b];
            b = b - 1;
        }
        grid[b + 1] = kv;
        a = a + 1;
    }
    let sols = [];
    let d_ast = simplify_node(diff_ast(diff_expr, v_name), nil);
    let k = 0;
    let prev_x = nil;
    let prev_f = nil;
    while k < len(grid) {
        let x = grid[k];
        if prev_x == nil or (x - prev_x) > 0.000000001 {
            let fx = eval_ast(diff_expr, _env1(v_name, x));
            if fx != nil {
                if num_abs(fx) < 0.000000000001 {
                    push(sols, _make_real_sol(ast_num(x), x));
                } else if prev_f != nil and ((prev_f < 0.0 and fx > 0.0) or (prev_f > 0.0 and fx < 0.0)) {
                    // Guard against vertical asymptote sign flips by checking midpoint finiteness & magnitude
                    let mid = 0.5 * (prev_x + x);
                    let fmid = eval_ast(diff_expr, _env1(v_name, mid));
                    if fmid != nil and num_abs(fmid) <= _max_num(num_abs(prev_f), num_abs(fx)) * 10.0 + 10.0 {
                        let root = _brent_polish_1d(diff_expr, v_name, prev_x, x, prev_f, fx);
                        if root != nil {
                            // Extra 3 Newton-Raphson polish iterations for < 1e-14 accuracy
                            let ni = 0;
                            while ni < 4 {
                                let fv = eval_ast(diff_expr, _env1(v_name, root));
                                let dv = eval_ast(d_ast, _env1(v_name, root));
                                if fv != nil and dv != nil and num_abs(dv) > 0.0000000001 {
                                    let cand = root - fv / dv;
                                    let fc = eval_ast(diff_expr, _env1(v_name, cand));
                                    if fc != nil and num_abs(fc) <= num_abs(fv) { root = cand; }
                                }
                                ni = ni + 1;
                            }
                            let lv = eval_ast(orig_lhs, _env1(v_name, root));
                            let rv = eval_ast(orig_rhs, _env1(v_name, root));
                            if lv != nil and rv != nil and num_abs(lv - rv) < 0.0000000001 * _max_num(1.0, num_abs(lv) + num_abs(rv)) {
                                let sr = float_snap_rat(root, 1000, 0.000000000001);
                                if sr != nil {
                                    let sl = eval_ast(orig_lhs, _env1(v_name, rat_to_float(sr)));
                                    let srr = eval_ast(orig_rhs, _env1(v_name, rat_to_float(sr)));
                                    if sl != nil and srr != nil and num_abs(sl - srr) < 0.0000000000001 {
                                        push(sols, _make_real_sol(sr));
                                    } else {
                                        push(sols, _make_real_sol(ast_num(root), root));
                                    }
                                } else {
                                    push(sols, _make_real_sol(ast_num(root), root));
                                }
                            }
                        }
                    }
                }
                prev_x = x;
                prev_f = fx;
            } else {
                prev_x = nil;
                prev_f = nil;
            }
        }
        k = k + 1;
    }
    return _sort_real_sols(sols);
}

// Rewrite exp(m*v) / b^(m*v) into dummy variable u^m to detect polynomial-in-exponential equations!
fn _subst_exp_to_poly_var(node, v_name, base_node, u_sym) {
    if node == nil or type(node) != "map" { return node; }
    if not contains_var(node, v_name) { return node; }
    let k = node["kind"];
    if k == "call" and node["fn_name"] == "exp" and len(node["args"]) == 1 {
        if base_node["kind"] == "sym" and base_node["name"] == "e" {
            let lin = _extract_linear_in_var(node["args"][0], v_name, nil);
            if lin["is_linear"] and is_int_node(lin["a"]) {
                let m = int_val_of(lin["a"]);
                let c_part = ast_ONE_or_exp(base_node, lin["b"]);
                return ast_mul([c_part, ast_pow(u_sym, rat(m, 1))]);
            }
        }
        return nil;
    }
    if k == "pow" and ast_eq(node["base"], base_node) {
        let lin = _extract_linear_in_var(node["exp"], v_name, nil);
        if lin["is_linear"] and is_int_node(lin["a"]) {
            let m = int_val_of(lin["a"]);
            let c_part = ast_ONE_or_exp(base_node, lin["b"]);
            return ast_mul([c_part, ast_pow(u_sym, rat(m, 1))]);
        }
        return nil;
    }
    if k == "neg" {
        let s = _subst_exp_to_poly_var(node["arg"], v_name, base_node, u_sym);
        if s == nil { return nil; }
        return ast_neg(s);
    }
    if k == "sub" {
        let sl = _subst_exp_to_poly_var(node["left"], v_name, base_node, u_sym);
        let sr = _subst_exp_to_poly_var(node["right"], v_name, base_node, u_sym);
        if sl == nil or sr == nil { return nil; }
        return ast_sub(sl, sr);
    }
    if k == "add" or k == "mul" {
        let oa = [];
        let i = 0;
        while i < len(node["args"]) {
            let si = _subst_exp_to_poly_var(node["args"][i], v_name, base_node, u_sym);
            if si == nil { return nil; }
            push(oa, si);
            i = i + 1;
        }
        return map{ "kind": k, "args": oa };
    }
    if k == "div" {
        let sn = _subst_exp_to_poly_var(node["num"], v_name, base_node, u_sym);
        let sd = _subst_exp_to_poly_var(node["den"], v_name, base_node, u_sym);
        if sn == nil or sd == nil { return nil; }
        return ast_div(sn, sd);
    }
    return nil;
}

fn ast_ONE_or_exp(base_node, b_const) {
    if is_zero_node(b_const) { return RAT_ONE; }
    return simplify_node(ast_pow(base_node, b_const), nil);
}

// Detect exact integer power log_b(target) if target == b^k for integer k in -32..32
fn _exact_int_log(base_rat, target_rat) {
    if not is_rat(base_rat) or not is_rat(target_rat) { return nil; }
    if not rat_is_pos(base_rat) or rat_is_one(base_rat) or not rat_is_pos(target_rat) { return nil; }
    if rat_is_one(target_rat) { return RAT_ZERO; }
    let k = -24;
    while k <= 24 {
        if rat_eq(rat_pow_int(base_rat, k), target_rat) {
            return rat(k, 1);
        }
        k = k + 1;
    }
    return nil;
}

fn _try_solve_exponential(lhs, rhs, v_name, ctx) {
    let diff = simplify_node(ast_sub(lhs, rhs), ctx);
    // Collect candidate exponential bases (e or rational > 0)
    let bases = [];
    let raw_s = to_ascii(diff);
    if str_contains(raw_s, "exp(") or contains_var(diff, v_name) {
        // Scan AST for pow(base, expr_with_v) or call("exp", [expr_with_v])
        let scan_stack = [diff];
        while len(scan_stack) > 0 {
            let cur = pop(scan_stack);
            if cur != nil and type(cur) == "map" {
                let ck = cur["kind"];
                if ck == "call" and cur["fn_name"] == "exp" and contains_var(cur, v_name) {
                    push(bases, ast_sym("e"));
                } else if ck == "pow" and not contains_var(cur["base"], v_name) and contains_var(cur["exp"], v_name) {
                    push(bases, cur["base"]);
                }
                if ck == "neg" { push(scan_stack, cur["arg"]); }
                else if ck == "sub" { push(scan_stack, cur["left"]); push(scan_stack, cur["right"]); }
                else if ck == "div" { push(scan_stack, cur["num"]); push(scan_stack, cur["den"]); }
                else if ck == "pow" { push(scan_stack, cur["base"]); push(scan_stack, cur["exp"]); }
                else if ck == "add" or ck == "mul" or ck == "call" {
                    let i = 0;
                    while i < len(cur["args"]) { push(scan_stack, cur["args"][i]); i = i + 1; }
                }
            }
        }
    }
    if len(bases) == 0 { return nil; }
    let base_b = bases[0];
    let b_val = eval_ast(base_b, map{});
    if b_val == nil or b_val <= 0.0 or b_val == 1.0 { return nil; }

    // 1. Check direct single exponential: coeff * b^(E(x)) = const_rhs
    let terms = [diff];
    if diff["kind"] == "add" { terms = diff["args"]; }
    if len(terms) <= 2 {
        let exp_node = nil;
        let coeff_exp = RAT_ONE;
        let const_sum = RAT_ZERO;
        let ok_direct = true;
        let ti = 0;
        while ti < len(terms) {
            let t = terms[ti];
            if not contains_var(t, v_name) {
                const_sum = simplify_node(ast_add([const_sum, t]), ctx);
            } else {
                let sp = _split_coeff_body(t);
                let body = sp[1];
                if body["kind"] == "pow" and ast_eq(body["base"], base_b) and exp_node == nil {
                    exp_node = body["exp"];
                    coeff_exp = sp[0];
                } else if body["kind"] == "call" and body["fn_name"] == "exp" and len(body["args"]) == 1 and base_b["kind"] == "sym" and base_b["name"] == "e" and exp_node == nil {
                    exp_node = body["args"][0];
                    coeff_exp = sp[0];
                } else {
                    ok_direct = false;
                }
            }
            ti = ti + 1;
        }
        if ok_direct and exp_node != nil {
            let target = simplify_node(ast_div(ast_neg(const_sum), coeff_exp), ctx);
            let t_val = eval_ast(target, map{});
            if t_val != nil and t_val <= 0.0 {
                _record_step(ctx, "exponential_strictly_positive_no_real_root", ast_rel("=", ast_pow(base_b, exp_node), target));
                return [];
            }
            let rhs_exp = nil;
            let exact_k = _exact_int_log(base_b, target);
            if exact_k != nil {
                rhs_exp = exact_k;
            } else if base_b["kind"] == "sym" and base_b["name"] == "e" {
                rhs_exp = simplify_node(ast_call("ln", [target]), ctx);
            } else {
                rhs_exp = simplify_node(ast_div(ast_call("ln", [target]), ast_call("ln", [base_b])), ctx);
            }
            let sub_eq = ast_rel("=", exp_node, rhs_exp);
            _record_step(ctx, "take_logarithm_base_" + to_ascii(base_b), sub_eq);
            let sub_res = _solve_single_eq(exp_node, rhs_exp, v_name, ctx, 1);
            return sub_res["solutions"];
        }
    }

    // 2. Polynomial in u = b^v_name (e.g. e^(2x) - 5*e^x + 6 = 0)!
    let u_name = "__u_exp";
    let u_sym = ast_sym(u_name);
    let u_expr = _subst_exp_to_poly_var(diff, v_name, base_b, u_sym);
    if u_expr != nil and not contains_var(u_expr, v_name) {
        let u_nd = to_rational_nd(u_expr, ctx);
        let u_poly = ast_to_poly(u_nd["num"], u_name);
        if u_poly != nil and poly_deg(u_poly) >= 1 {
            _record_step(ctx, "substitute_u_equals_" + to_ascii(base_b) + "^" + v_name, ast_rel("=", poly_to_ast(u_poly, "u"), RAT_ZERO));
            let u_roots = solve_polynomial_all(u_poly, u_name)["real_sols"];
            let x_sols = [];
            let ui = 0;
            while ui < len(u_roots) {
                let ur = u_roots[ui];
                if ur["value"] != nil and ur["value"] > 0.00000000001 {
                    let u_ast = ur["ast"];
                    let x_ast = nil;
                    let ex_k = _exact_int_log(base_b, u_ast);
                    if ex_k != nil {
                        x_ast = ex_k;
                    } else if base_b["kind"] == "sym" and base_b["name"] == "e" {
                        x_ast = simplify_node(ast_call("ln", [u_ast]), ctx);
                    } else {
                        x_ast = simplify_node(ast_div(ast_call("ln", [u_ast]), ast_call("ln", [base_b])), ctx);
                    }
                    push(x_sols, _make_real_sol(x_ast));
                }
                ui = ui + 1;
            }
            return _sort_real_sols(x_sols);
        }
    }
    return nil;
}

// Match trig value c against exact inverse trig table -> returns exact k_rat such that angle == k_rat * pi!
fn _exact_inverse_trig_pi_rat(fn_nm, c_val) {
    let candidates = [
        rat(-1, 2), rat(-1, 3), rat(-1, 4), rat(-1, 6),
        RAT_ZERO,
        rat(1, 6), rat(1, 4), rat(1, 3), rat(1, 2),
        rat(2, 3), rat(3, 4), rat(5, 6), RAT_ONE
    ];
    let i = 0;
    while i < len(candidates) {
        let kr = candidates[i];
        let ang = rat_to_float(kr) * _PI_VAL;
        if fn_nm == "sin" and ang >= (0.0 - _PI_VAL / 2.0 - 0.0001) and ang <= (_PI_VAL / 2.0 + 0.0001) {
            if num_abs(num_sin(ang) - c_val) < 0.00000000001 { return kr; }
        } else if fn_nm == "cos" and ang >= -0.0001 and ang <= (_PI_VAL + 0.0001) {
            if num_abs(num_cos(ang) - c_val) < 0.00000000001 { return kr; }
        } else if fn_nm == "tan" and ang > (0.0 - _PI_VAL / 2.0 + 0.0001) and ang < (_PI_VAL / 2.0 - 0.0001) {
            if num_abs((num_sin(ang) / num_cos(ang)) - c_val) < 0.00000000001 { return kr; }
        }
        i = i + 1;
    }
    return nil;
}

fn _pi_rat_to_ast(kr) {
    if rat_is_zero(kr) { return RAT_ZERO; }
    if rat_is_one(kr) { return ast_sym("pi"); }
    if rat_is_neg_one(kr) { return ast_neg(ast_sym("pi")); }
    if kr["q"] == _BI_ONE { return ast_mul([kr, ast_sym("pi")]); }
    if kr["p"] == _BI_ONE { return ast_div(ast_sym("pi"), rat(kr["q"], 1)); }
    if kr["p"] == _BI_NEG_ONE { return ast_neg(ast_div(ast_sym("pi"), rat(kr["q"], 1))); }
    return ast_div(ast_mul([rat(kr["p"], 1), ast_sym("pi")]), rat(kr["q"], 1));
}

fn _try_solve_trig(lhs, rhs, v_name, ctx) {
    let diff = simplify_node(ast_sub(lhs, rhs), ctx);
    let trig_calls = [];
    _find_call_nodes(diff, ["sin", "cos", "tan"], v_name, trig_calls);
    if len(trig_calls) != 1 { return nil; }
    let tc = trig_calls[0];
    let fn_nm = tc["fn_name"];
    if len(tc["args"]) != 1 { return nil; }
    let inner_u = tc["args"][0];
    let lin_u = _extract_linear_in_var(inner_u, v_name, ctx);
    if not lin_u["is_linear"] or contains_var(lin_u["a"], v_name) { return nil; }
    let a_u = lin_u["a"];
    let b_u = lin_u["b"];
    let iso = _isolate_subexpr_linear(diff, tc, ctx);
    if iso == nil or contains_var(iso["coeff"], v_name) or contains_var(iso["rhs"], v_name) {
        return nil;
    }
    let c_node = simplify_node(ast_div(iso["rhs"], iso["coeff"]), ctx);
    let c_val = eval_ast(c_node, map{});
    if c_val == nil { return nil; }
    _record_step(ctx, "isolate_trig_call", ast_rel("=", tc, c_node));

    if (fn_nm == "sin" or fn_nm == "cos") and num_abs(c_val) > 1.00000000001 {
        return map{
            "is_trig": true,
            "solutions": [],
            "principal_solutions": [],
            "general_families": []
        };
    }

    // Build base angle branches for inner_u = base_angle + base_period * k
    let u_branches = []; // elements: { base_ast, period_pi_rat }
    let kr = _exact_inverse_trig_pi_rat(fn_nm, c_val);
    if fn_nm == "sin" {
        if kr != nil {
            if rat_eq(kr, RAT_HALF) or rat_eq(kr, rat(-1, 2)) {
                push(u_branches, map{ "base": _pi_rat_to_ast(kr), "period_pi": RAT_TWO });
            } else if rat_is_zero(kr) {
                push(u_branches, map{ "base": RAT_ZERO, "period_pi": RAT_ONE });
            } else {
                let kr2 = rat_sub(RAT_ONE, kr);
                push(u_branches, map{ "base": _pi_rat_to_ast(kr), "period_pi": RAT_TWO });
                push(u_branches, map{ "base": _pi_rat_to_ast(kr2), "period_pi": RAT_TWO });
            }
        } else {
            let a0 = num_atan2(c_val, num_sqrt(_max_num(0.0, 1.0 - c_val * c_val)));
            push(u_branches, map{ "base": ast_num(a0), "period_pi": RAT_TWO });
            push(u_branches, map{ "base": ast_num(_PI_VAL - a0), "period_pi": RAT_TWO });
        }
    } else if fn_nm == "cos" {
        if kr != nil {
            if rat_is_zero(kr) or rat_is_one(kr) {
                push(u_branches, map{ "base": _pi_rat_to_ast(kr), "period_pi": RAT_TWO });
            } else if rat_eq(kr, RAT_HALF) {
                push(u_branches, map{ "base": _pi_rat_to_ast(RAT_HALF), "period_pi": RAT_ONE });
            } else {
                push(u_branches, map{ "base": _pi_rat_to_ast(kr), "period_pi": RAT_TWO });
                push(u_branches, map{ "base": _pi_rat_to_ast(rat_neg(kr)), "period_pi": RAT_TWO });
            }
        } else {
            let a0 = (_PI_VAL / 2.0) - num_atan2(c_val, num_sqrt(_max_num(0.0, 1.0 - c_val * c_val)));
            push(u_branches, map{ "base": ast_num(a0), "period_pi": RAT_TWO });
            push(u_branches, map{ "base": ast_num(0.0 - a0), "period_pi": RAT_TWO });
        }
    } else if fn_nm == "tan" {
        if kr != nil {
            push(u_branches, map{ "base": _pi_rat_to_ast(kr), "period_pi": RAT_ONE });
        } else {
            push(u_branches, map{ "base": ast_num(num_atan2(c_val, 1.0)), "period_pi": RAT_ONE });
        }
    }

    // Solve a_u * x + b_u = base + period * k => x = (base - b_u)/a_u + (period / |a_u|) * k
    let principal = [];
    let families = [];
    let in_two_pi = [];
    let bi = 0;
    while bi < len(u_branches) {
        let br = u_branches[bi];
        let x0_ast = simplify_node(ast_div(ast_sub(br["base"], b_u), a_u), ctx);
        let p_ast = simplify_node(ast_div(_pi_rat_to_ast(br["period_pi"]), ast_call("abs", [a_u])), ctx);
        push(principal, _make_real_sol(x0_ast));
        let fam_ast = simplify_node(ast_add([x0_ast, ast_mul([ast_sym("k"), p_ast])]), ctx);
        push(families, map{
            "ascii": to_ascii(fam_ast),
            "unicode": to_unicode(fam_ast),
            "latex": to_latex(fam_ast)
        });
        // Enumerate all solutions in [0, 2*pi]
        let x0_v = eval_ast(x0_ast, map{});
        let p_v = eval_ast(p_ast, map{});
        let kk = -8;
        while kk <= 8 {
            if x0_v != nil and p_v != nil {
                let approx_v = x0_v + kk * p_v;
                if approx_v >= -0.00000000001 and approx_v <= (2.0 * _PI_VAL + 0.00000000001) {
                    let raw_xk = ast_add([x0_ast, ast_mul([rat(kk, 1), p_ast])]);
                    let nd_xk = to_rational_nd(raw_xk, ctx);
                    let xk_ast = simplify_node(ast_div(nd_xk["num"], nd_xk["den"]), ctx);
                    let xk_val = eval_ast(xk_ast, map{});
                    if xk_val != nil {
                        push(in_two_pi, _make_real_sol(xk_ast, xk_val));
                    }
                }
            }
            kk = kk + 1;
        }
        bi = bi + 1;
    }
    let sorted_period = _sort_real_sols(in_two_pi);
    return map{
        "is_trig": true,
        "solutions": sorted_period,
        "principal_solutions": _sort_real_sols(principal),
        "general_families": families
    };
}

// Core Single-Variable Equation Solver (handles symbolic parametric, abs, radical, log, exp, trig, rational, poly, transcendental)
fn _solve_single_eq(lhs_in, rhs_in, v_name, ctx, rec_depth = 0) {
    if rec_depth > 6 {
        return map{ "solutions": [], "complex_solutions": [], "excluded_poles": [], "rejected_extraneous": [] };
    }
    let lhs = simplify_node(lhs_in, ctx);
    let rhs = simplify_node(rhs_in, ctx);

    // Check if symbolic parameters besides v_name exist -> solve parametrically for v_name!
    let fvs_l = free_vars(lhs);
    let fvs_r = free_vars(rhs);
    let other_params = [];
    let i = 0;
    while i < len(fvs_l) { if fvs_l[i] != v_name { push(other_params, fvs_l[i]); } i = i + 1; }
    i = 0;
    while i < len(fvs_r) { if fvs_r[i] != v_name { push(other_params, fvs_r[i]); } i = i + 1; }
    if len(other_params) > 0 {
        let iso_rel = _isolate_var(ast_rel("=", lhs, rhs), v_name, ctx);
        let sol_node = iso_rel["rhs"];
        return map{
            "parametric": true,
            "solutions": [_make_real_sol(sol_node, nil)],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": []
        };
    }

    let diff = simplify_node(ast_sub(lhs, rhs), ctx);
    if is_zero_node(diff) {
        return map{
            "identity": true,
            "solutions": [],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": []
        };
    }

    // 1. Absolute-Value Equation: |U(x)| = V(x)
    let abs_calls = [];
    _find_call_nodes(diff, ["abs"], v_name, abs_calls);
    if len(abs_calls) >= 1 and rec_depth <= 3 {
        let ac = abs_calls[0];
        let iso_a = _isolate_subexpr_linear(diff, ac, ctx);
        if iso_a != nil and not is_zero_node(iso_a["coeff"]) {
            let rhs_v = simplify_node(ast_div(iso_a["rhs"], iso_a["coeff"]), ctx);
            if not contains_var(rhs_v, v_name) {
                let rv_num = eval_ast(rhs_v, map{});
                if rv_num != nil and rv_num < -0.00000000001 {
                    _record_step(ctx, "abs_equals_negative_impossible", ast_rel("=", ac, rhs_v));
                    return map{ "solutions": [], "complex_solutions": [], "excluded_poles": [], "rejected_extraneous": [] };
                }
            }
            let inner_u = ac["args"][0];
            _record_step(ctx, "branch_absolute_value", ast_rel("=", ac, rhs_v));
            let b1 = _solve_single_eq(inner_u, rhs_v, v_name, ctx, rec_depth + 1);
            let b2 = _solve_single_eq(inner_u, ast_neg(rhs_v), v_name, ctx, rec_depth + 1);
            let cand_all = [];
            let j = 0;
            while j < len(b1["solutions"]) { push(cand_all, b1["solutions"][j]); j = j + 1; }
            j = 0;
            while j < len(b2["solutions"]) { push(cand_all, b2["solutions"][j]); j = j + 1; }
            let valid = [];
            let rej = [];
            j = 0;
            while j < len(cand_all) {
                let c = cand_all[j];
                let xv = c["value"];
                let lv = eval_ast(lhs_in, _env1(v_name, xv));
                let rv = eval_ast(rhs_in, _env1(v_name, xv));
                if lv != nil and rv != nil and num_abs(lv - rv) <= 0.00000001 * _max_num(1.0, num_abs(lv) + num_abs(rv)) {
                    push(valid, c);
                } else {
                    push(rej, xv);
                }
                j = j + 1;
            }
            return map{
                "solutions": _sort_real_sols(valid),
                "complex_solutions": [],
                "excluded_poles": [],
                "rejected_extraneous": rej
            };
        }
    }

    // 2. Radical Equation: isolate sqrt(U(x)), square both sides, strictly reject extraneous roots!
    let sqrt_calls = [];
    _find_call_nodes(diff, ["sqrt"], v_name, sqrt_calls);
    if len(sqrt_calls) >= 1 and rec_depth <= 3 {
        let sc = sqrt_calls[0];
        let iso_s = _isolate_subexpr_linear(diff, sc, ctx);
        if iso_s != nil and not is_zero_node(iso_s["coeff"]) {
            let sq_lhs = _expand_node(ast_mul([ast_pow(iso_s["coeff"], RAT_TWO), sc["args"][0]]), ctx);
            let sq_rhs = _expand_node(ast_pow(iso_s["rhs"], RAT_TWO), ctx);
            _record_step(ctx, "isolate_radical_and_square_both_sides", ast_rel("=", sq_lhs, sq_rhs));
            let sub = _solve_single_eq(sq_lhs, sq_rhs, v_name, ctx, rec_depth + 1);
            let valid = [];
            let rej = [];
            let j = 0;
            while j < len(sub["solutions"]) {
                let cand = sub["solutions"][j];
                let xv = cand["value"];
                let lv = eval_ast(lhs_in, _env1(v_name, xv));
                let rv = eval_ast(rhs_in, _env1(v_name, xv));
                if lv != nil and rv != nil and num_abs(lv - rv) <= 0.00000001 * _max_num(1.0, num_abs(lv) + num_abs(rv)) {
                    push(valid, cand);
                } else {
                    push(rej, cand["value"]);
                    _record_step(ctx, "reject_extraneous_radical_root (" + v_name + " = " + cand["exact"] + " fails original equation)", ast_rel("!=", ast_num(lv), ast_num(rv)));
                }
                j = j + 1;
            }
            return map{
                "solutions": _sort_real_sols(valid),
                "complex_solutions": [],
                "excluded_poles": sub["excluded_poles"],
                "rejected_extraneous": rej
            };
        }
    }

    // 3. Logarithmic Equation: combine logs, exponentiate, and check ALL original log arguments > 0!
    let log_calls = [];
    _find_call_nodes(lhs_in, ["ln", "log"], v_name, log_calls);
    _find_call_nodes(rhs_in, ["ln", "log"], v_name, log_calls);
    if len(log_calls) >= 1 and rec_depth <= 2 {
        let lc_lhs = _log_combine_node(lhs, ctx);
        let lc_rhs = _log_combine_node(rhs, ctx);
        let lc_diff = _log_combine_node(ast_sub(lc_lhs, lc_rhs), ctx);
        // Either lc_lhs == ln(A) and lc_rhs == ln(B), or lc_diff == ln(R) + K = 0 -> ln(R) = -K -> R = exp(-K)
        let alg_lhs = nil;
        let alg_rhs = nil;
        if lc_lhs["kind"] == "call" and lc_lhs["fn_name"] == "ln" and lc_rhs["kind"] == "call" and lc_rhs["fn_name"] == "ln" {
            alg_lhs = lc_lhs["args"][0];
            alg_rhs = lc_rhs["args"][0];
        } else {
            let comb_calls = [];
            _find_call_nodes(lc_diff, ["ln"], v_name, comb_calls);
            if len(comb_calls) == 1 {
                let iso_l = _isolate_subexpr_linear(lc_diff, comb_calls[0], ctx);
                if iso_l != nil and not contains_var(iso_l["coeff"], v_name) and not contains_var(iso_l["rhs"], v_name) {
                    let k_rhs = simplify_node(ast_div(iso_l["rhs"], iso_l["coeff"]), ctx);
                    alg_lhs = comb_calls[0]["args"][0];
                    alg_rhs = simplify_node(ast_call("exp", [k_rhs]), ctx);
                }
            }
        }
        if alg_lhs != nil {
            _record_step(ctx, "combine_logarithms_and_exponentiate", ast_rel("=", alg_lhs, alg_rhs));
            let sub = _solve_single_eq(alg_lhs, alg_rhs, v_name, ctx, rec_depth + 1);
            let valid = [];
            let rej = [];
            let j = 0;
            while j < len(sub["solutions"]) {
                let cand = sub["solutions"][j];
                let xv = cand["value"];
                let dom_ok = true;
                let li = 0;
                while li < len(log_calls) {
                    let arg_v = eval_ast(log_calls[li]["args"][0], _env1(v_name, xv));
                    if arg_v == nil or arg_v <= 0.0000000001 {
                        dom_ok = false;
                        break;
                    }
                    li = li + 1;
                }
                if dom_ok {
                    let lv = eval_ast(lhs_in, _env1(v_name, xv));
                    let rv = eval_ast(rhs_in, _env1(v_name, xv));
                    if lv != nil and rv != nil and num_abs(lv - rv) <= 0.00000001 * _max_num(1.0, num_abs(lv) + num_abs(rv)) {
                        push(valid, cand);
                    } else {
                        push(rej, xv);
                    }
                } else {
                    push(rej, xv);
                    _record_step(ctx, "reject_log_domain_violation (" + v_name + " = " + cand["exact"] + " makes log argument <= 0)", ast_sym("domain_rejected"));
                }
                j = j + 1;
            }
            return map{
                "solutions": _sort_real_sols(valid),
                "complex_solutions": [],
                "excluded_poles": sub["excluded_poles"],
                "rejected_extraneous": rej
            };
        }
    }

    // 4. Exponential Equation (`2^(x + 1) = 16`, `e^(2x) - 5*e^x + 6 = 0`)
    let exp_sols = _try_solve_exponential(lhs, rhs, v_name, ctx);
    if exp_sols != nil {
        return map{
            "solutions": exp_sols,
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": []
        };
    }

    // 5. Trigonometric Equation (`sin(2x) = 1/2`, `2*cos(x) - 1 = 0`, `tan(x) = 1`)
    let trig_res = _try_solve_trig(lhs, rhs, v_name, ctx);
    if trig_res != nil {
        return map{
            "is_trig": true,
            "solutions": trig_res["solutions"],
            "principal_solutions": trig_res["principal_solutions"],
            "general_families": trig_res["general_families"],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": []
        };
    }

    // 6. Rational & Polynomial Equations over Q(x): N(x) / D(x) = 0 with strict pole rejection!
    let nd = to_rational_nd(ast_sub(lhs_in, rhs_in), ctx);
    let p_num = ast_to_poly(nd["num"], v_name);
    let p_den = ast_to_poly(nd["den"], v_name);
    if p_num != nil and p_den != nil {
        if not is_one_node(nd["den"]) {
            _record_step(ctx, "combine_rational_equation_over_common_denominator", ast_rel("=", ast_div(nd["num"], nd["den"]), RAT_ZERO));
        } else {
            _record_step(ctx, "standard_polynomial_form", ast_rel("=", poly_to_ast(p_num, v_name), RAT_ZERO));
        }
        if poly_is_zero(p_num) {
            return map{
                "identity": true,
                "solutions": [],
                "complex_solutions": [],
                "excluded_poles": [],
                "rejected_extraneous": []
            };
        }
        let all_roots = solve_polynomial_all(p_num, v_name);
        let valid_real = [];
        let poles = [];
        let ri = 0;
        while ri < len(all_roots["real_sols"]) {
            let cand = all_roots["real_sols"][ri];
            let rv = cand["value"];
            let is_pole = false;
            let dv_main = eval_ast(nd["den"], _env1(v_name, rv));
            if dv_main == nil or num_abs(dv_main) < 0.0000000001 { is_pole = true; }
            let odi = 0;
            while odi < len(nd["orig_dens"]) and not is_pole {
                let odv = eval_ast(nd["orig_dens"][odi], _env1(v_name, rv));
                if odv == nil or num_abs(odv) < 0.0000000001 { is_pole = true; }
                odi = odi + 1;
            }
            if is_pole {
                push(poles, rv);
                _record_step(ctx, "reject_excluded_pole (" + v_name + " = " + cand["exact"] + " makes denominator 0)", ast_rel("!=", ast_sym(v_name), cand["ast"]));
            } else {
                push(valid_real, cand);
            }
            ri = ri + 1;
        }
        return map{
            "solutions": _sort_real_sols(valid_real),
            "complex_solutions": all_roots["complex_sols"],
            "excluded_poles": poles,
            "rejected_extraneous": []
        };
    }

    // 7. General Transcendental Equation Fallback (`cos(x) = x`, `exp(-x) = x`, `x*ln(x) = 2`)
    _record_step(ctx, "numerical_bracketing_and_brent_newton_polish", ast_rel("=", diff, RAT_ZERO));
    let trans_sols = _solve_transcendental_1d(diff, lhs_in, rhs_in, v_name, -50.0, 50.0);
    return map{
        "transcendental": true,
        "solutions": trans_sols,
        "complex_solutions": [],
        "excluded_poles": [],
        "rejected_extraneous": []
    };
}

// ── Interval Arithmetic & 1D Inequality Solver ────────────────────────────────

fn _make_interval(lo_v, hi_v, lo_inf, hi_inf, lo_closed, hi_closed, lo_u, hi_u, lo_l, hi_l, lo_a, hi_a) {
    return map{
        "lo": lo_v,
        "hi": hi_v,
        "lo_inf": lo_inf,
        "hi_inf": hi_inf,
        "lo_closed": lo_closed,
        "hi_closed": hi_closed,
        "lo_unicode": lo_u,
        "hi_unicode": hi_u,
        "lo_latex": lo_l,
        "hi_latex": hi_l,
        "lo_ascii": lo_a,
        "hi_ascii": hi_a
    };
}

fn _format_iv_one(iv, fmt_mode) {
    // Single-point interval [a, a] -> {a} or [a, a]
    if not iv["lo_inf"] and not iv["hi_inf"] and iv["lo_closed"] and iv["hi_closed"] and num_abs(iv["lo"] - iv["hi"]) < 0.0000000001 {
        if fmt_mode == "latex" { return "\\{" + iv["lo_latex"] + "\\}"; }
        return "{" + iv["lo_unicode"] + "}";
    }
    let lb = "(";
    if iv["lo_closed"] and not iv["lo_inf"] { lb = "["; }
    let rb = ")";
    if iv["hi_closed"] and not iv["hi_inf"] { rb = "]"; }
    if fmt_mode == "unicode" {
        let ls = iv["lo_unicode"]; if iv["lo_inf"] { ls = "-∞"; }
        let hs = iv["hi_unicode"]; if iv["hi_inf"] { hs = "+∞"; }
        return lb + ls + ", " + hs + rb;
    }
    if fmt_mode == "latex" {
        let ls = iv["lo_latex"]; if iv["lo_inf"] { ls = "-\\infty"; }
        let hs = iv["hi_latex"]; if iv["hi_inf"] { hs = "+\\infty"; }
        return lb + ls + ", " + hs + rb;
    }
    let ls = iv["lo_ascii"]; if iv["lo_inf"] { ls = "-inf"; }
    let hs = iv["hi_ascii"]; if iv["hi_inf"] { hs = "+inf"; }
    return lb + ls + ", " + hs + rb;
}

fn _format_intervals(ivs, fmt_mode) {
    if len(ivs) == 0 {
        if fmt_mode == "unicode" { return "∅"; }
        if fmt_mode == "latex" { return "\\emptyset"; }
        return "empty";
    }
    let sep = " U ";
    if fmt_mode == "unicode" { sep = " ∪ "; }
    else if fmt_mode == "latex" { sep = " \\cup "; }
    let out = "";
    let i = 0;
    while i < len(ivs) {
        if i > 0 { out = out + sep; }
        out = out + _format_iv_one(ivs[i], fmt_mode);
        i = i + 1;
    }
    return out;
}

// Merge adjacent touching or overlapping sorted intervals!
fn _merge_intervals(ivs) {
    if len(ivs) <= 1 { return ivs; }
    let out = [ivs[0]];
    let i = 1;
    while i < len(ivs) {
        let prev = out[len(out) - 1];
        let cur = ivs[i];
        let can_merge = false;
        if prev["hi_inf"] {
            can_merge = true;
        } else if not cur["lo_inf"] {
            if cur["lo"] < prev["hi"] - 0.0000000001 {
                can_merge = true;
            } else if num_abs(cur["lo"] - prev["hi"]) <= 0.0000000001 and (prev["hi_closed"] or cur["lo_closed"]) {
                can_merge = true;
            }
        }
        if can_merge {
            let new_hi = prev["hi"];
            let new_hi_inf = prev["hi_inf"];
            let new_hi_c = prev["hi_closed"];
            let new_hi_u = prev["hi_unicode"];
            let new_hi_l = prev["hi_latex"];
            let new_hi_a = prev["hi_ascii"];
            if cur["hi_inf"] and not prev["hi_inf"] {
                new_hi_inf = true; new_hi_c = false;
                new_hi_u = "+∞"; new_hi_l = "+\\infty"; new_hi_a = "+inf";
            } else if not prev["hi_inf"] and not cur["hi_inf"] {
                if cur["hi"] > prev["hi"] + 0.0000000001 {
                    new_hi = cur["hi"]; new_hi_c = cur["hi_closed"];
                    new_hi_u = cur["hi_unicode"]; new_hi_l = cur["hi_latex"]; new_hi_a = cur["hi_ascii"];
                } else if num_abs(cur["hi"] - prev["hi"]) <= 0.0000000001 {
                    new_hi_c = (prev["hi_closed"] or cur["hi_closed"]);
                }
            }
            out[len(out) - 1] = _make_interval(
                prev["lo"], new_hi, prev["lo_inf"], new_hi_inf, prev["lo_closed"], new_hi_c,
                prev["lo_unicode"], new_hi_u, prev["lo_latex"], new_hi_l, prev["lo_ascii"], new_hi_a
            );
        } else {
            push(out, cur);
        }
        i = i + 1;
    }
    return out;
}

// Exact pairwise intersection of two sorted disjoint interval sets!
fn _intersect_two_ivs(a, b) {
    // Max of lower bounds
    let lo_inf = false; let lo_v = 0.0; let lo_c = false;
    let lo_u = ""; let lo_l = ""; let lo_a = "";
    if a["lo_inf"] and b["lo_inf"] {
        lo_inf = true; lo_c = false; lo_u = "-∞"; lo_l = "-\\infty"; lo_a = "-inf";
    } else if a["lo_inf"] {
        lo_v = b["lo"]; lo_c = b["lo_closed"]; lo_u = b["lo_unicode"]; lo_l = b["lo_latex"]; lo_a = b["lo_ascii"];
    } else if b["lo_inf"] {
        lo_v = a["lo"]; lo_c = a["lo_closed"]; lo_u = a["lo_unicode"]; lo_l = a["lo_latex"]; lo_a = a["lo_ascii"];
    } else if a["lo"] > b["lo"] + 0.0000000001 {
        lo_v = a["lo"]; lo_c = a["lo_closed"]; lo_u = a["lo_unicode"]; lo_l = a["lo_latex"]; lo_a = a["lo_ascii"];
    } else if b["lo"] > a["lo"] + 0.0000000001 {
        lo_v = b["lo"]; lo_c = b["lo_closed"]; lo_u = b["lo_unicode"]; lo_l = b["lo_latex"]; lo_a = b["lo_ascii"];
    } else {
        lo_v = a["lo"]; lo_c = (a["lo_closed"] and b["lo_closed"]);
        lo_u = a["lo_unicode"]; lo_l = a["lo_latex"]; lo_a = a["lo_ascii"];
    }

    // Min of upper bounds
    let hi_inf = false; let hi_v = 0.0; let hi_c = false;
    let hi_u = ""; let hi_l = ""; let hi_a = "";
    if a["hi_inf"] and b["hi_inf"] {
        hi_inf = true; hi_c = false; hi_u = "+∞"; hi_l = "+\\infty"; hi_a = "+inf";
    } else if a["hi_inf"] {
        hi_v = b["hi"]; hi_c = b["hi_closed"]; hi_u = b["hi_unicode"]; hi_l = b["hi_latex"]; hi_a = b["hi_ascii"];
    } else if b["hi_inf"] {
        hi_v = a["hi"]; hi_c = a["hi_closed"]; hi_u = a["hi_unicode"]; hi_l = a["hi_latex"]; hi_a = a["hi_ascii"];
    } else if a["hi"] < b["hi"] - 0.0000000001 {
        hi_v = a["hi"]; hi_c = a["hi_closed"]; hi_u = a["hi_unicode"]; hi_l = a["hi_latex"]; hi_a = a["hi_ascii"];
    } else if b["hi"] < a["hi"] - 0.0000000001 {
        hi_v = b["hi"]; hi_c = b["hi_closed"]; hi_u = b["hi_unicode"]; hi_l = b["hi_latex"]; hi_a = b["hi_ascii"];
    } else {
        hi_v = a["hi"]; hi_c = (a["hi_closed"] and b["hi_closed"]);
        hi_u = a["hi_unicode"]; hi_l = a["hi_latex"]; hi_a = a["hi_ascii"];
    }

    if not lo_inf and not hi_inf {
        if lo_v > hi_v + 0.0000000001 { return nil; }
        if num_abs(lo_v - hi_v) <= 0.0000000001 and not (lo_c and hi_c) { return nil; }
    }
    return _make_interval(lo_v, hi_v, lo_inf, hi_inf, lo_c, hi_c, lo_u, hi_u, lo_l, hi_l, lo_a, hi_a);
}

fn interval_set_intersect(set_a, set_b) {
    let out = [];
    let i = 0;
    while i < len(set_a) {
        let j = 0;
        while j < len(set_b) {
            let inter = _intersect_two_ivs(set_a[i], set_b[j]);
            if inter != nil { push(out, inter); }
            j = j + 1;
        }
        i = i + 1;
    }
    return _merge_intervals(out);
}

fn _sign_satisfies(sgn_str, op) {
    if sgn_str == "undef" { return false; } // Poles NEVER satisfy any inequality!
    if op == "<" { return sgn_str == "-"; }
    if op == "<=" { return sgn_str == "-" or sgn_str == "0"; }
    if op == ">" { return sgn_str == "+"; }
    if op == ">=" { return sgn_str == "+" or sgn_str == "0"; }
    if op == "!=" { return sgn_str == "-" or sgn_str == "+"; }
    return false;
}

// Solve 1D Polynomial, Rational, or Absolute-Value Inequality `lhs [op] rhs`!
fn _solve_single_inequality(rel_node, v_name, ctx) {
    let op = rel_node["op"];
    let lhs = rel_node["lhs"];
    let rhs = rel_node["rhs"];
    let diff = simplify_node(ast_sub(lhs, rhs), ctx);
    _record_step(ctx, "move_terms_to_lhs", ast_rel(op, diff, RAT_ZERO));

    let nd = to_rational_nd(ast_sub(lhs, rhs), ctx);
    if not is_one_node(nd["den"]) {
        _record_step(ctx, "combine_over_common_denominator", ast_rel(op, ast_div(nd["num"], nd["den"]), RAT_ZERO));
    }

    // Collect ALL critical points: zeros of numerator, zeros of denominator (poles!), and inner zeros of abs(...)!
    let crit_candidates = [];
    let num_eq = _solve_single_eq(nd["num"], RAT_ZERO, v_name, _new_ctx(), 1);
    let i = 0;
    while i < len(num_eq["solutions"]) { push(crit_candidates, num_eq["solutions"][i]); i = i + 1; }

    let pole_vals = [];
    if not is_one_node(nd["den"]) {
        let den_eq = _solve_single_eq(nd["den"], RAT_ZERO, v_name, _new_ctx(), 1);
        i = 0;
        while i < len(den_eq["solutions"]) {
            push(crit_candidates, den_eq["solutions"][i]);
            push(pole_vals, den_eq["solutions"][i]["value"]);
            i = i + 1;
        }
    }
    let odi = 0;
    while odi < len(nd["orig_dens"]) {
        let od_eq = _solve_single_eq(nd["orig_dens"][odi], RAT_ZERO, v_name, _new_ctx(), 1);
        i = 0;
        while i < len(od_eq["solutions"]) {
            push(crit_candidates, od_eq["solutions"][i]);
            push(pole_vals, od_eq["solutions"][i]["value"]);
            i = i + 1;
        }
        odi = odi + 1;
    }
    // Also add inner corners of any abs(arg) so piecewise-linear / abs inequalities split cleanly!
    let abs_list = [];
    _find_call_nodes(diff, ["abs"], v_name, abs_list);
    i = 0;
    while i < len(abs_list) {
        let corner_eq = _solve_single_eq(abs_list[i]["args"][0], RAT_ZERO, v_name, _new_ctx(), 2);
        let j = 0;
        while j < len(corner_eq["solutions"]) { push(crit_candidates, corner_eq["solutions"][j]); j = j + 1; }
        i = i + 1;
    }

    let crits = _sort_real_sols(crit_candidates);
    let eval_target = ast_sub(lhs, rhs);
    let sign_table = [];
    let raw_ivs = [];

    if len(crits) == 0 {
        let tv = eval_ast(eval_target, _env1(v_name, 0.0));
        if tv == nil { tv = eval_ast(eval_target, _env1(v_name, 1.0)); }
        let sgn = "undef";
        if tv != nil {
            if num_abs(tv) < 0.00000000001 { sgn = "0"; }
            else if tv > 0.0 { sgn = "+"; }
            else { sgn = "-"; }
        }
        push(sign_table, map{ "region": "(-inf, +inf)", "test_x": 0.0, "sign": sgn });
        if _sign_satisfies(sgn, op) {
            push(raw_ivs, _make_interval(0.0, 0.0, true, true, false, false, "-∞", "+∞", "-\\infty", "+\\infty", "-inf", "+inf"));
        }
    } else {
        let m = len(crits);
        // Classify each critical point: pole ("undef") vs zero ("0") vs corner sign
        let cp_signs = [];
        i = 0;
        while i < m {
            let cv = crits[i]["value"];
            let is_p = false;
            let pi = 0;
            while pi < len(pole_vals) {
                if num_abs(pole_vals[pi] - cv) < 0.000000001 { is_p = true; break; }
                pi = pi + 1;
            }
            if is_p {
                push(cp_signs, "undef");
            } else {
                let fv = eval_ast(eval_target, _env1(v_name, cv));
                if fv == nil { push(cp_signs, "undef"); }
                else if num_abs(fv) < 0.000000001 { push(cp_signs, "0"); }
                else if fv > 0.0 { push(cp_signs, "+"); }
                else { push(cp_signs, "-"); }
            }
            i = i + 1;
        }

        // Open subintervals: (-inf, c_0), (c_0, c_1), ..., (c_{m-1}, +inf)
        let idx = 0;
        while idx <= m {
            let test_x = 0.0;
            let reg_label = "";
            if idx == 0 {
                test_x = crits[0]["value"] - _max_num(1.0, num_abs(crits[0]["value"]) * 0.5 + 1.0);
                reg_label = "(-inf, " + crits[0]["ascii"] + ")";
            } else if idx == m {
                test_x = crits[m - 1]["value"] + _max_num(1.0, num_abs(crits[m - 1]["value"]) * 0.5 + 1.0);
                reg_label = "(" + crits[m - 1]["ascii"] + ", +inf)";
            } else {
                test_x = 0.5 * (crits[idx - 1]["value"] + crits[idx]["value"]);
                reg_label = "(" + crits[idx - 1]["ascii"] + ", " + crits[idx]["ascii"] + ")";
            }
            let fv = eval_ast(eval_target, _env1(v_name, test_x));
            let sgn = "undef";
            if fv != nil {
                if num_abs(fv) < 0.000000000001 { sgn = "0"; }
                else if fv > 0.0 { sgn = "+"; }
                else { sgn = "-"; }
            }
            push(sign_table, map{ "region": reg_label, "test_x": test_x, "sign": sgn });
            if _sign_satisfies(sgn, op) {
                if idx == 0 {
                    let hi_c = _sign_satisfies(cp_signs[0], op);
                    push(raw_ivs, _make_interval(
                        0.0, crits[0]["value"], true, false, false, hi_c,
                        "-∞", crits[0]["unicode"], "-\\infty", crits[0]["latex"], "-inf", crits[0]["ascii"]
                    ));
                } else if idx == m {
                    let lo_c = _sign_satisfies(cp_signs[m - 1], op);
                    push(raw_ivs, _make_interval(
                        crits[m - 1]["value"], 0.0, false, true, lo_c, false,
                        crits[m - 1]["unicode"], "+∞", crits[m - 1]["latex"], "+\\infty", crits[m - 1]["ascii"], "+inf"
                    ));
                } else {
                    let lo_c = _sign_satisfies(cp_signs[idx - 1], op);
                    let hi_c = _sign_satisfies(cp_signs[idx], op);
                    push(raw_ivs, _make_interval(
                        crits[idx - 1]["value"], crits[idx]["value"], false, false, lo_c, hi_c,
                        crits[idx - 1]["unicode"], crits[idx]["unicode"], crits[idx - 1]["latex"], crits[idx]["latex"],
                        crits[idx - 1]["ascii"], crits[idx]["ascii"]
                    ));
                }
            }
            if idx < m {
                let cp = crits[idx];
                push(sign_table, map{ "region": v_name + " = " + cp["ascii"], "test_x": cp["value"], "sign": cp_signs[idx] });
                // Isolated satisfied point (e.g. (x - 2)^2 <= 0 -> {2})
                if _sign_satisfies(cp_signs[idx], op) {
                    push(raw_ivs, _make_interval(
                        cp["value"], cp["value"], false, false, true, true,
                        cp["unicode"], cp["unicode"], cp["latex"], cp["latex"], cp["ascii"], cp["ascii"]
                    ));
                }
            }
            idx = idx + 1;
        }
    }

    let merged = _merge_intervals(raw_ivs);
    let u_str = _format_intervals(merged, "unicode");
    let l_str = _format_intervals(merged, "latex");
    let a_str = _format_intervals(merged, "ascii");
    _record_step(ctx, "sign_chart_interval_solution", ast_sym(a_str));

    return map{
        "ok": true,
        "kind": "inequality",
        "var": v_name,
        "intervals": merged,
        "ascii": a_str,
        "unicode": u_str,
        "latex": l_str,
        "sign_table": sign_table,
        "steps": ctx["steps"]
    };
}

// ── Multivariate Linear & Nonlinear System Solvers ────────────────────────────

// Extract exact rational linear row [c_0, ..., c_{n-1}, rhs_const] for equation `lhs = rhs` in `vars`.
// Returns nil if equation is nonlinear!
fn _extract_linear_system_row(eq_node, vars, ctx) {
    let diff = _expand_node(ast_sub(eq_node["lhs"], eq_node["rhs"]), ctx);
    let terms = [diff];
    if diff["kind"] == "add" { terms = diff["args"]; }
    let coeffs = [];
    let vi = 0;
    while vi < len(vars) { push(coeffs, RAT_ZERO); vi = vi + 1; }
    let const_rhs = RAT_ZERO;

    let ti = 0;
    while ti < len(terms) {
        let t = terms[ti];
        let tvars = free_vars(t);
        if len(tvars) == 0 {
            if is_rat(t) { const_rhs = rat_sub(const_rhs, t); }
            else {
                let fv = eval_ast(t, map{});
                let sr = float_snap_rat(fv, 1000000, 0.000000000001);
                if sr == nil { return nil; }
                const_rhs = rat_sub(const_rhs, sr);
            }
        } else if len(tvars) == 1 {
            let v_hit = tvars[0];
            let col_idx = -1;
            let k = 0;
            while k < len(vars) {
                if vars[k] == v_hit { col_idx = k; break; }
                k = k + 1;
            }
            if col_idx < 0 { return nil; }
            let lin = _extract_linear_in_var(t, v_hit, ctx);
            if not lin["is_linear"] or not is_zero_node(lin["b"]) { return nil; }
            if not is_rat(lin["a"]) { return nil; }
            coeffs[col_idx] = rat_add(coeffs[col_idx], lin["a"]);
        } else {
            return nil; // product of multiple variables like x*y -> nonlinear!
        }
        ti = ti + 1;
    }
    push(coeffs, const_rhs);
    return coeffs;
}

// Dense float linear solver A * dx = rhs for Damped Newton-Raphson Jacobian step
fn _solve_float_linear(mat_a, rhs_b, n) {
    let aug = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n { push(row, mat_a[i][j]); j = j + 1; }
        push(row, rhs_b[i]);
        push(aug, row);
        i = i + 1;
    }
    let col = 0;
    while col < n {
        let best_r = col;
        let best_v = num_abs(aug[col][col]);
        let r = col + 1;
        while r < n {
            let av = num_abs(aug[r][col]);
            if av > best_v { best_v = av; best_r = r; }
            r = r + 1;
        }
        if best_v < 0.000000000001 { return nil; }
        if best_r != col {
            let tmp = aug[col]; aug[col] = aug[best_r]; aug[best_r] = tmp;
        }
        let piv = aug[col][col];
        let c = col;
        while c <= n { aug[col][c] = aug[col][c] / piv; c = c + 1; }
        r = 0;
        while r < n {
            if r != col and num_abs(aug[r][col]) > 0.0 {
                let fac = aug[r][col];
                let cc = col;
                while cc <= n {
                    aug[r][cc] = aug[r][cc] - fac * aug[col][cc];
                    cc = cc + 1;
                }
            }
            r = r + 1;
        }
        col = col + 1;
    }
    let x = [];
    i = 0;
    while i < n { push(x, aug[i][n]); i = i + 1; }
    return x;
}

// Multi-Start Damped Newton-Raphson Nonlinear System Solver (2D / ND with exact symbolic Jacobian!)
fn _solve_nonlinear_system(eqs, vars, ctx) {
    let m = len(eqs);
    let n = len(vars);
    let funcs = [];
    let jac = [];
    let i = 0;
    while i < m {
        let fi = simplify_node(ast_sub(eqs[i]["lhs"], eqs[i]["rhs"]), ctx);
        push(funcs, fi);
        let j_row = [];
        let j = 0;
        while j < n {
            push(j_row, simplify_node(diff_ast(fi, vars[j]), nil));
            j = j + 1;
        }
        push(jac, j_row);
        i = i + 1;
    }

    // Build deterministic asymmetric multi-start seed grid
    let seeds = [];
    if n == 2 {
        let g1 = [-7.3, -3.7, -1.6, -0.4, 0.6, 1.9, 3.8, 7.4];
        let a = 0;
        while a < len(g1) {
            let b = 0;
            while b < len(g1) {
                push(seeds, [g1[a], g1[b]]);
                b = b + 1;
            }
            a = a + 1;
        }
    } else if n == 3 {
        let g3 = [-4.3, -1.2, 0.7, 3.6];
        let a = 0;
        while a < len(g3) {
            let b = 0;
            while b < len(g3) {
                let c = 0;
                while c < len(g3) {
                    push(seeds, [g3[a], g3[b], g3[c]]);
                    c = c + 1;
                }
                b = b + 1;
            }
            a = a + 1;
        }
    } else {
        let s_idx = -4;
        while s_idx <= 4 {
            let pt = [];
            let d = 0;
            while d < n {
                push(pt, s_idx * 1.37 + d * 0.41);
                d = d + 1;
            }
            push(seeds, pt);
            s_idx = s_idx + 1;
        }
    }

    let found_pts = [];
    let si = 0;
    while si < len(seeds) {
        let x = [];
        let d = 0;
        while d < n { push(x, seeds[si][d]); d = d + 1; }
        let converged = false;
        let iter = 0;
        while iter < 42 {
            let env = map{};
            d = 0;
            while d < n { env[vars[d]] = x[d]; d = d + 1; }
            let f_vec = [];
            let norm2 = 0.0;
            let eval_ok = true;
            i = 0;
            while i < m {
                let fv = eval_ast(funcs[i], env);
                if fv == nil { eval_ok = false; break; }
                push(f_vec, fv);
                norm2 = norm2 + fv * fv;
                i = i + 1;
            }
            if not eval_ok { break; }
            if num_sqrt(norm2) < 0.000000000001 {
                converged = true;
                break;
            }
            if m != n { break; }
            let j_mat = [];
            let neg_f = [];
            i = 0;
            while i < n {
                let jr = [];
                let j = 0;
                while j < n {
                    let jv = eval_ast(jac[i][j], env);
                    if jv == nil { eval_ok = false; break; }
                    push(jr, jv);
                    j = j + 1;
                }
                if not eval_ok { break; }
                push(j_mat, jr);
                push(neg_f, 0.0 - f_vec[i]);
                i = i + 1;
            }
            if not eval_ok { break; }
            let dx = _solve_float_linear(j_mat, neg_f, n);
            if dx == nil { break; }

            // Armijo backtracking damping line search
            let alpha = 1.0;
            let accepted = false;
            let ls = 0;
            while ls < 8 {
                let cand_x = [];
                let cand_env = map{};
                d = 0;
                while d < n {
                    let xv = x[d] + alpha * dx[d];
                    push(cand_x, xv);
                    cand_env[vars[d]] = xv;
                    d = d + 1;
                }
                let cand_n2 = 0.0;
                let c_ok = true;
                i = 0;
                while i < m {
                    let cfv = eval_ast(funcs[i], cand_env);
                    if cfv == nil { c_ok = false; break; }
                    cand_n2 = cand_n2 + cfv * cfv;
                    i = i + 1;
                }
                if c_ok and cand_n2 < norm2 {
                    x = cand_x;
                    accepted = true;
                    break;
                }
                alpha = alpha * 0.5;
                ls = ls + 1;
            }
            if not accepted { break; }
            iter = iter + 1;
        }

        if converged {
            // Check if snapping to exact small rationals gives zero residual!
            let snapped_pt = [];
            let snap_env = map{};
            let all_snapped = true;
            d = 0;
            while d < n {
                let sr = float_snap_rat(x[d], 1000, 0.00000001);
                if sr != nil {
                    push(snapped_pt, sr);
                    snap_env[vars[d]] = rat_to_float(sr);
                } else {
                    all_snapped = false;
                }
                d = d + 1;
            }
            if all_snapped {
                let snap_res2 = 0.0;
                i = 0;
                while i < m {
                    let sf = eval_ast(funcs[i], snap_env);
                    if sf == nil { snap_res2 = 1.0; break; }
                    snap_res2 = snap_res2 + sf * sf;
                    i = i + 1;
                }
                if snap_res2 < 0.00000000000000000001 {
                    d = 0;
                    while d < n { x[d] = rat_to_float(snapped_pt[d]); d = d + 1; }
                }
            }
            // Deduplicate against already found points
            let dup = false;
            let fi = 0;
            while fi < len(found_pts) {
                let dist2 = 0.0;
                d = 0;
                while d < n {
                    let diff_d = found_pts[fi][d] - x[d];
                    dist2 = dist2 + diff_d * diff_d;
                    d = d + 1;
                }
                if num_sqrt(dist2) < 0.000001 { dup = true; break; }
                fi = fi + 1;
            }
            if not dup { push(found_pts, x); }
        }
        si = si + 1;
    }

    // Sort solutions lexicographically by first coordinate
    let ns = len(found_pts);
    let a = 1;
    while a < ns {
        let kp = found_pts[a];
        let b = a - 1;
        while b >= 0 and found_pts[b][0] > kp[0] + 0.0000001 {
            found_pts[b + 1] = found_pts[b];
            b = b - 1;
        }
        found_pts[b + 1] = kp;
        a = a + 1;
    }

    let sol_maps = [];
    let k = 0;
    while k < len(found_pts) {
        let pt = found_pts[k];
        let sm = map{};
        let d = 0;
        while d < n {
            sm[vars[d]] = pt[d];
            d = d + 1;
        }
        push(sol_maps, sm);
        k = k + 1;
    }
    _record_step(ctx, "multistart_damped_newton_raphson (" + str(len(sol_maps)) + " solutions)", ast_sym("converged"));
    return map{
        "ok": true,
        "kind": "nonlinear_system",
        "status": "solved",
        "vars": vars,
        "solutions": sol_maps,
        "steps": ctx["steps"]
    };
}

// Natural variable ordering for multivariate systems: prefer x, y, z, w, t, u, v before alphabetical!
fn _order_system_vars(raw_vars) {
    let pref = ["x", "y", "z", "w", "t", "u", "v"];
    let out = [];
    let used = map{};
    let pi = 0;
    while pi < len(pref) {
        let ri = 0;
        while ri < len(raw_vars) {
            if raw_vars[ri] == pref[pi] {
                push(out, pref[pi]);
                used[pref[pi]] = true;
            }
            ri = ri + 1;
        }
        pi = pi + 1;
    }
    let sorted = _sort_strings(raw_vars);
    let si = 0;
    while si < len(sorted) {
        if not map_has(used, sorted[si]) { push(out, sorted[si]); }
        si = si + 1;
    }
    return out;
}

// ── Parametric Case-Splitting & Guarded Indeterminacy Classifiers (v2.7.0) ────

fn _extract_poly_coeffs_in_var(expr, v, ctx) {
    let exp_e = _expand_node(expr, ctx);
    let terms = [exp_e];
    if exp_e["kind"] == "add" { terms = exp_e["args"]; }
    let deg_buckets = map{};
    let max_d = 0;
    let i = 0;
    while i < len(terms) {
        let t = terms[i];
        if not contains_var(t, v) {
            if not map_has(deg_buckets, "0") { deg_buckets["0"] = []; }
            push(deg_buckets["0"], t);
        } else if t["kind"] == "sym" and t["name"] == v {
            if not map_has(deg_buckets, "1") { deg_buckets["1"] = []; }
            push(deg_buckets["1"], RAT_ONE);
            if 1 > max_d { max_d = 1; }
        } else if t["kind"] == "neg" and t["arg"]["kind"] == "sym" and t["arg"]["name"] == v {
            if not map_has(deg_buckets, "1") { deg_buckets["1"] = []; }
            push(deg_buckets["1"], RAT_NEG_ONE);
            if 1 > max_d { max_d = 1; }
        } else if t["kind"] == "pow" and t["base"]["kind"] == "sym" and t["base"]["name"] == v and is_int_node(t["exp"]) {
            let dk = int_val_of(t["exp"]);
            if dk < 0 or dk > 16 { return nil; }
            let ks = str(dk);
            if not map_has(deg_buckets, ks) { deg_buckets[ks] = []; }
            push(deg_buckets[ks], RAT_ONE);
            if dk > max_d { max_d = dk; }
        } else if t["kind"] == "neg" and t["arg"]["kind"] == "pow" and t["arg"]["base"]["kind"] == "sym" and t["arg"]["base"]["name"] == v and is_int_node(t["arg"]["exp"]) {
            let dk = int_val_of(t["arg"]["exp"]);
            if dk < 0 or dk > 16 { return nil; }
            let ks = str(dk);
            if not map_has(deg_buckets, ks) { deg_buckets[ks] = []; }
            push(deg_buckets[ks], RAT_NEG_ONE);
            if dk > max_d { max_d = dk; }
        } else if t["kind"] == "mul" {
            let deg_t = 0;
            let rest = [];
            let j = 0;
            while j < len(t["args"]) {
                let fj = t["args"][j];
                if fj["kind"] == "sym" and fj["name"] == v {
                    deg_t = deg_t + 1;
                } else if fj["kind"] == "pow" and fj["base"]["kind"] == "sym" and fj["base"]["name"] == v and is_int_node(fj["exp"]) {
                    let ek = int_val_of(fj["exp"]);
                    if ek < 0 { return nil; }
                    deg_t = deg_t + ek;
                } else if contains_var(fj, v) {
                    return nil;
                } else {
                    push(rest, fj);
                }
                j = j + 1;
            }
            if deg_t > 16 { return nil; }
            let ks = str(deg_t);
            if not map_has(deg_buckets, ks) { deg_buckets[ks] = []; }
            push(deg_buckets[ks], ast_mul(rest));
            if deg_t > max_d { max_d = deg_t; }
        } else {
            return nil;
        }
        i = i + 1;
    }
    let coeffs = [];
    let d = 0;
    while d <= max_d {
        let ks = str(d);
        if map_has(deg_buckets, ks) {
            push(coeffs, simplify_node(ast_add(deg_buckets[ks]), ctx));
        } else {
            push(coeffs, RAT_ZERO);
        }
        d = d + 1;
    }
    while len(coeffs) > 1 and is_zero_node(coeffs[len(coeffs) - 1]) {
        let trimmed = [];
        let ti = 0;
        while ti < len(coeffs) - 1 { push(trimmed, coeffs[ti]); ti = ti + 1; }
        coeffs = trimmed;
    }
    return coeffs;
}

fn _normalize_lead_pair(a_in, b_in) {
    let a_c = simplify_node(a_in, nil);
    let b_c = simplify_node(b_in, nil);
    let sp_a = _split_term_sign(a_c);
    let sp_b = _split_term_sign(b_c);
    if sp_a[0] and sp_b[0] {
        return [simplify_node(sp_a[1], nil), simplify_node(sp_b[1], nil)];
    }
    if a_c["kind"] == "add" {
        let all_neg = true;
        let k = 0;
        while k < len(a_c["args"]) {
            if not _split_term_sign(a_c["args"][k])[0] { all_neg = false; break; }
            k = k + 1;
        }
        if all_neg {
            return [simplify_node(ast_neg(a_c), nil), simplify_node(ast_neg(b_c), nil)];
        }
    }
    return [a_c, b_c];
}

fn _intervals_to_param_cond(ivs, p_name) {
    if ivs == nil or len(ivs) == 0 { return nil; }
    let p_ltx = to_latex(ast_sym(p_name));
    if len(ivs) == 1 {
        let iv = ivs[0];
        if iv["lo_inf"] and iv["hi_inf"] {
            return map{
                "ascii": p_name + " in (-inf, +inf)",
                "unicode": p_name + " ∈ ℝ",
                "latex": p_ltx + " \\in \\mathbb{R}"
            };
        }
        if iv["lo_inf"] {
            let oa = "<"; let ou = "<"; let ol = "<";
            if iv["hi_closed"] { oa = "<="; ou = "≤"; ol = "\\le"; }
            return map{
                "ascii": p_name + " " + oa + " " + iv["hi_ascii"],
                "unicode": p_name + " " + ou + " " + iv["hi_unicode"],
                "latex": p_ltx + " " + ol + " " + iv["hi_latex"]
            };
        }
        if iv["hi_inf"] {
            let oa = ">"; let ou = ">"; let ol = ">";
            if iv["lo_closed"] { oa = ">="; ou = "≥"; ol = "\\ge"; }
            return map{
                "ascii": p_name + " " + oa + " " + iv["lo_ascii"],
                "unicode": p_name + " " + ou + " " + iv["lo_unicode"],
                "latex": p_ltx + " " + ol + " " + iv["lo_latex"]
            };
        }
        let o1a = "<"; let o1u = "<"; let o1l = "<";
        if iv["lo_closed"] { o1a = "<="; o1u = "≤"; o1l = "\\le"; }
        let o2a = "<"; let o2u = "<"; let o2l = "<";
        if iv["hi_closed"] { o2a = "<="; o2u = "≤"; o2l = "\\le"; }
        return map{
            "ascii": iv["lo_ascii"] + " " + o1a + " " + p_name + " " + o2a + " " + iv["hi_ascii"],
            "unicode": iv["lo_unicode"] + " " + o1u + " " + p_name + " " + o2u + " " + iv["hi_unicode"],
            "latex": iv["lo_latex"] + " " + o1l + " " + p_ltx + " " + o2l + " " + iv["hi_latex"]
        };
    }
    if len(ivs) == 2 {
        let iv0 = ivs[0];
        let iv1 = ivs[1];
        // Punctured interval at single excluded point r: (..., r) U (r, ...)
        if not iv0["hi_closed"] and not iv1["lo_closed"] and iv0["hi_ascii"] == iv1["lo_ascii"] {
            let r_a = iv0["hi_ascii"];
            let r_u = iv0["hi_unicode"];
            let r_l = iv0["hi_latex"];
            if iv0["lo_inf"] and iv1["hi_inf"] {
                return map{
                    "ascii": p_name + " != " + r_a,
                    "unicode": p_name + " ≠ " + r_u,
                    "latex": p_ltx + " \\neq " + r_l
                };
            }
            if iv0["lo_inf"] and not iv1["hi_inf"] {
                let oa = "<"; let ou = "<"; let ol = "<";
                if iv1["hi_closed"] { oa = "<="; ou = "≤"; ol = "\\le"; }
                return map{
                    "ascii": p_name + " " + oa + " " + iv1["hi_ascii"] + " and " + p_name + " != " + r_a,
                    "unicode": p_name + " " + ou + " " + iv1["hi_unicode"] + " ∧ " + p_name + " ≠ " + r_u,
                    "latex": p_ltx + " " + ol + " " + iv1["hi_latex"] + " \\land " + p_ltx + " \\neq " + r_l
                };
            }
            if not iv0["lo_inf"] and iv1["hi_inf"] {
                let oa = ">"; let ou = ">"; let ol = ">";
                if iv0["lo_closed"] { oa = ">="; ou = "≥"; ol = "\\ge"; }
                return map{
                    "ascii": p_name + " " + oa + " " + iv0["lo_ascii"] + " and " + p_name + " != " + r_a,
                    "unicode": p_name + " " + ou + " " + iv0["lo_unicode"] + " ∧ " + p_name + " ≠ " + r_u,
                    "latex": p_ltx + " " + ol + " " + iv0["lo_latex"] + " \\land " + p_ltx + " \\neq " + r_l
                };
            }
        }
        // Disjoint rays: (-inf, a) U (b, +inf)
        if iv0["lo_inf"] and iv1["hi_inf"] {
            let o1a = "<"; let o1u = "<"; let o1l = "<";
            if iv0["hi_closed"] { o1a = "<="; o1u = "≤"; o1l = "\\le"; }
            let o2a = ">"; let o2u = ">"; let o2l = ">";
            if iv1["lo_closed"] { o2a = ">="; o2u = "≥"; o2l = "\\ge"; }
            return map{
                "ascii": p_name + " " + o1a + " " + iv0["hi_ascii"] + " or " + p_name + " " + o2a + " " + iv1["lo_ascii"],
                "unicode": p_name + " " + o1u + " " + iv0["hi_unicode"] + " ∨ " + p_name + " " + o2u + " " + iv1["lo_unicode"],
                "latex": p_ltx + " " + o1l + " " + iv0["hi_latex"] + " \\lor " + p_ltx + " " + o2l + " " + iv1["lo_latex"]
            };
        }
    }
    return map{
        "ascii": p_name + " in " + _format_intervals(ivs, "ascii"),
        "unicode": p_name + " ∈ " + _format_intervals(ivs, "unicode"),
        "latex": p_ltx + " \\in " + _format_intervals(ivs, "latex")
    };
}

fn _ineq_ray_strings(op, bound_node) {
    let ba = to_ascii(bound_node);
    let bu = to_unicode(bound_node);
    let bl = to_latex(bound_node);
    if op == "<" {
        return map{ "ascii": "(-inf, " + ba + ")", "unicode": "(-∞, " + bu + ")", "latex": "(-\\infty, " + bl + ")" };
    }
    if op == "<=" {
        return map{ "ascii": "(-inf, " + ba + "]", "unicode": "(-∞, " + bu + "]", "latex": "(-\\infty, " + bl + "]" };
    }
    if op == ">" {
        return map{ "ascii": "(" + ba + ", +inf)", "unicode": "(" + bu + ", +∞)", "latex": "(" + bl + ", +\\infty)" };
    }
    if op == ">=" {
        return map{ "ascii": "[" + ba + ", +inf)", "unicode": "[" + bu + ", +∞)", "latex": "[" + bl + ", +\\infty)" };
    }
    return map{ "ascii": "(-inf, " + ba + ") U (" + ba + ", +inf)", "unicode": "(-∞, " + bu + ") ∪ (" + bu + ", +∞)", "latex": "(-\\infty, " + bl + ") \\cup (" + bl + ", +\\infty)" };
}

fn _zero_lhs_holds_num(op, b_val) {
    if op == "<" { return b_val > 1.0e-12; }
    if op == "<=" { return b_val >= -1.0e-12; }
    if op == ">" { return b_val < -1.0e-12; }
    if op == ">=" { return b_val <= 1.0e-12; }
    if op == "!=" { return num_abs(b_val) > 1.0e-12; }
    return false;
}

fn _solve_parametric_inequality_cases(rel_node, target_v, param_vars, ctx) {
    let op = rel_node["op"];
    let lhs = simplify_node(rel_node["lhs"], ctx);
    let rhs = simplify_node(rel_node["rhs"], ctx);
    let lin_l = _extract_linear_in_var(lhs, target_v, ctx);
    let lin_r = _extract_linear_in_var(rhs, target_v, ctx);
    if not (lin_l["is_linear"] and lin_r["is_linear"]) {
        return [];
    }
    let A = simplify_node(ast_sub(lin_l["a"], lin_r["a"]), ctx);
    let B = simplify_node(ast_sub(lin_r["b"], lin_l["b"]), ctx);
    let cases = [];
    let v_ltx = to_latex(ast_sym(target_v));

    // Determine condition on B for `0 [op] B` to hold when A = 0
    let b_true_op = ">=";
    let b_false_op = "<";
    if op == "<" { b_true_op = ">"; b_false_op = "<="; }
    else if op == "<=" { b_true_op = ">="; b_false_op = "<"; }
    else if op == ">" { b_true_op = "<"; b_false_op = ">="; }
    else if op == ">=" { b_true_op = "<="; b_false_op = ">"; }
    else if op == "!=" { b_true_op = "!="; b_false_op = "="; }

    if is_zero_node(A) {
        let bv = eval_ast(B, map{});
        if bv != nil {
            if _zero_lhs_holds_num(op, bv) {
                push(cases, map{
                    "condition": "always",
                    "condition_unicode": "∀",
                    "condition_latex": "\\text{always}",
                    "regime": "indeterminate_always_true",
                    "status": "indeterminate_always_true",
                    "infinite_solutions": true,
                    "solutions": "all_real_numbers",
                    "interval_ascii": "(-inf, +inf)",
                    "interval_unicode": "(-∞, +∞)",
                    "interval_latex": "(-\\infty, +\\infty)"
                });
            } else {
                push(cases, map{
                    "condition": "always",
                    "condition_unicode": "∀",
                    "condition_latex": "\\text{always}",
                    "regime": "impossible_never_true",
                    "status": "impossible_never_true",
                    "infinite_solutions": false,
                    "solutions": [],
                    "interval_ascii": "empty",
                    "interval_unicode": "∅",
                    "interval_latex": "\\emptyset"
                });
            }
            return cases;
        }
        let cond_t = ast_rel(b_true_op, B, RAT_ZERO);
        let cond_f = ast_rel(b_false_op, B, RAT_ZERO);
        push(cases, map{
            "condition": to_ascii(cond_t),
            "condition_unicode": to_unicode(cond_t),
            "condition_latex": to_latex(cond_t),
            "regime": "indeterminate_always_true",
            "status": "indeterminate_always_true",
            "infinite_solutions": true,
            "solutions": "all_real_numbers",
            "interval_ascii": "(-inf, +inf)",
            "interval_unicode": "(-∞, +∞)",
            "interval_latex": "(-\\infty, +\\infty)"
        });
        push(cases, map{
            "condition": to_ascii(cond_f),
            "condition_unicode": to_unicode(cond_f),
            "condition_latex": to_latex(cond_f),
            "regime": "impossible_never_true",
            "status": "impossible_never_true",
            "infinite_solutions": false,
            "solutions": [],
            "interval_ascii": "empty",
            "interval_unicode": "∅",
            "interval_latex": "\\emptyset"
        });
        return cases;
    }

    let q_bound = simplify_node(ast_div(B, A), nil);
    let fl_op = _flip_ineq_op(op);
    let ray_pos = _ineq_ray_strings(op, q_bound);
    let ray_neg = _ineq_ray_strings(fl_op, q_bound);
    let sol_pos_ast = ast_rel(op, ast_sym(target_v), q_bound);
    let sol_neg_ast = ast_rel(fl_op, ast_sym(target_v), q_bound);

    // 1. Positive leading coefficient regime: A > 0 (inequality direction preserved)
    if len(param_vars) == 1 {
        let p = param_vars[0];
        let pos_in = try _solve_single_inequality(ast_rel(">", A, RAT_ZERO), p, _new_ctx()) catch nil;
        if pos_in != nil and len(pos_in["intervals"]) > 0 {
            let pc = _intervals_to_param_cond(pos_in["intervals"], p);
            push(cases, map{
                "condition": pc["ascii"],
                "condition_unicode": pc["unicode"],
                "condition_latex": pc["latex"],
                "regime": "positive_lead_preserved",
                "status": "unique_interval",
                "direction_flipped": false,
                "ascii": to_ascii(sol_pos_ast),
                "unicode": to_unicode(sol_pos_ast),
                "latex": to_latex(sol_pos_ast),
                "solutions": to_ascii(sol_pos_ast),
                "interval_ascii": ray_pos["ascii"],
                "interval_unicode": ray_pos["unicode"],
                "interval_latex": ray_pos["latex"]
            });
        }
        let neg_in = try _solve_single_inequality(ast_rel("<", A, RAT_ZERO), p, _new_ctx()) catch nil;
        if neg_in != nil and len(neg_in["intervals"]) > 0 {
            let nc = _intervals_to_param_cond(neg_in["intervals"], p);
            push(cases, map{
                "condition": nc["ascii"],
                "condition_unicode": nc["unicode"],
                "condition_latex": nc["latex"],
                "regime": "negative_lead_flipped",
                "status": "unique_interval_flipped",
                "direction_flipped": (op != "!="),
                "ascii": to_ascii(sol_neg_ast),
                "unicode": to_unicode(sol_neg_ast),
                "latex": to_latex(sol_neg_ast),
                "solutions": to_ascii(sol_neg_ast),
                "interval_ascii": ray_neg["ascii"],
                "interval_unicode": ray_neg["unicode"],
                "interval_latex": ray_neg["latex"]
            });
        }
        // Zero leading coefficient roots: A(p) = 0
        let z_eq = try _solve_single_eq(A, RAT_ZERO, p, _new_ctx(), 1) catch nil;
        if z_eq != nil and len(z_eq["solutions"]) > 0 {
            let zi = 0;
            while zi < len(z_eq["solutions"]) {
                let zs = z_eq["solutions"][zi];
                let b_sub = simplify_node(subst_ast(B, _env1(p, zs["ast"])), nil);
                let bv = eval_ast(b_sub, map{});
                let c_asc = p + " = " + zs["ascii"];
                let c_uni = p + " = " + zs["unicode"];
                let c_ltx = to_latex(ast_sym(p)) + " = " + zs["latex"];
                if bv != nil and _zero_lhs_holds_num(op, bv) {
                    push(cases, map{
                        "condition": c_asc,
                        "condition_unicode": c_uni,
                        "condition_latex": c_ltx,
                        "regime": "indeterminate_always_true",
                        "status": "indeterminate_always_true",
                        "infinite_solutions": true,
                        "solutions": "all_real_numbers",
                        "ascii": target_v + " in (-inf, +inf)",
                        "unicode": target_v + " ∈ ℝ",
                        "latex": v_ltx + " \\in \\mathbb{R}",
                        "interval_ascii": "(-inf, +inf)",
                        "interval_unicode": "(-∞, +∞)",
                        "interval_latex": "(-\\infty, +\\infty)"
                    });
                } else {
                    push(cases, map{
                        "condition": c_asc,
                        "condition_unicode": c_uni,
                        "condition_latex": c_ltx,
                        "regime": "impossible_never_true",
                        "status": "impossible_never_true",
                        "infinite_solutions": false,
                        "solutions": [],
                        "ascii": "no solution",
                        "unicode": "∅",
                        "latex": "\\emptyset",
                        "interval_ascii": "empty",
                        "interval_unicode": "∅",
                        "interval_latex": "\\emptyset"
                    });
                }
                zi = zi + 1;
            }
        }
        return cases;
    }

    // Multi-parameter linear inequality (e.g., `a*x <= b`)
    let c_pos = ast_rel(">", A, RAT_ZERO);
    let c_neg = ast_rel("<", A, RAT_ZERO);
    let c_zero = ast_rel("=", A, RAT_ZERO);
    push(cases, map{
        "condition": to_ascii(c_pos),
        "condition_unicode": to_unicode(c_pos),
        "condition_latex": to_latex(c_pos),
        "regime": "positive_lead_preserved",
        "status": "unique_interval",
        "direction_flipped": false,
        "ascii": to_ascii(sol_pos_ast),
        "unicode": to_unicode(sol_pos_ast),
        "latex": to_latex(sol_pos_ast),
        "solutions": to_ascii(sol_pos_ast),
        "interval_ascii": ray_pos["ascii"],
        "interval_unicode": ray_pos["unicode"],
        "interval_latex": ray_pos["latex"]
    });
    push(cases, map{
        "condition": to_ascii(c_neg),
        "condition_unicode": to_unicode(c_neg),
        "condition_latex": to_latex(c_neg),
        "regime": "negative_lead_flipped",
        "status": "unique_interval_flipped",
        "direction_flipped": (op != "!="),
        "ascii": to_ascii(sol_neg_ast),
        "unicode": to_unicode(sol_neg_ast),
        "latex": to_latex(sol_neg_ast),
        "solutions": to_ascii(sol_neg_ast),
        "interval_ascii": ray_neg["ascii"],
        "interval_unicode": ray_neg["unicode"],
        "interval_latex": ray_neg["latex"]
    });
    let b_const = eval_ast(B, map{});
    if b_const != nil {
        if _zero_lhs_holds_num(op, b_const) {
            push(cases, map{
                "condition": to_ascii(c_zero),
                "condition_unicode": to_unicode(c_zero),
                "condition_latex": to_latex(c_zero),
                "regime": "indeterminate_always_true",
                "status": "indeterminate_always_true",
                "infinite_solutions": true,
                "solutions": "all_real_numbers",
                "interval_ascii": "(-inf, +inf)",
                "interval_unicode": "(-∞, +∞)",
                "interval_latex": "(-\\infty, +\\infty)"
            });
        } else {
            push(cases, map{
                "condition": to_ascii(c_zero),
                "condition_unicode": to_unicode(c_zero),
                "condition_latex": to_latex(c_zero),
                "regime": "impossible_never_true",
                "status": "impossible_never_true",
                "infinite_solutions": false,
                "solutions": [],
                "interval_ascii": "empty",
                "interval_unicode": "∅",
                "interval_latex": "\\emptyset"
            });
        }
    } else {
        let bt_rel = ast_rel(b_true_op, B, RAT_ZERO);
        let bf_rel = ast_rel(b_false_op, B, RAT_ZERO);
        push(cases, map{
            "condition": to_ascii(c_zero) + " and " + to_ascii(bt_rel),
            "condition_unicode": to_unicode(c_zero) + " ∧ " + to_unicode(bt_rel),
            "condition_latex": to_latex(c_zero) + " \\land " + to_latex(bt_rel),
            "regime": "indeterminate_always_true",
            "status": "indeterminate_always_true",
            "infinite_solutions": true,
            "solutions": "all_real_numbers",
            "ascii": target_v + " in (-inf, +inf)",
            "unicode": target_v + " ∈ ℝ",
            "latex": v_ltx + " \\in \\mathbb{R}",
            "interval_ascii": "(-inf, +inf)",
            "interval_unicode": "(-∞, +∞)",
            "interval_latex": "(-\\infty, +\\infty)"
        });
        push(cases, map{
            "condition": to_ascii(c_zero) + " and " + to_ascii(bf_rel),
            "condition_unicode": to_unicode(c_zero) + " ∧ " + to_unicode(bf_rel),
            "condition_latex": to_latex(c_zero) + " \\land " + to_latex(bf_rel),
            "regime": "impossible_never_true",
            "status": "impossible_never_true",
            "infinite_solutions": false,
            "solutions": [],
            "ascii": "no solution",
            "unicode": "∅",
            "latex": "\\emptyset",
            "interval_ascii": "empty",
            "interval_unicode": "∅",
            "interval_latex": "\\emptyset"
        });
    }
    return cases;
}

fn _solve_parametric_equation_full(lhs_in, rhs_in, target_v, param_vars, ctx) {
    let diff_nd = to_rational_nd(ast_sub(lhs_in, rhs_in), ctx);
    let od_i = 0;
    while od_i < len(diff_nd["orig_dens"]) {
        let den_d = simplify_node(diff_nd["orig_dens"][od_i], ctx);
        if len(free_vars(den_d)) > 0 {
            _add_guard(ctx, to_ascii(den_d) + " != 0");
        }
        od_i = od_i + 1;
    }
    let coeffs = _extract_poly_coeffs_in_var(diff_nd["num"], target_v, ctx);
    let v_ltx = to_latex(ast_sym(target_v));

    // Degree 0 in target_v: C0(params) = 0
    if coeffs != nil and len(coeffs) == 1 {
        let c0 = coeffs[0];
        if is_zero_node(c0) {
            let c_id = map{
                "condition": "always",
                "condition_unicode": "∀",
                "condition_latex": "\\text{always}",
                "regime": "indeterminate_identity",
                "status": "indeterminate_identity",
                "infinite_solutions": true,
                "solutions": "all_real_numbers"
            };
            return map{
                "ok": true,
                "kind": "parametric_equation",
                "status": "indeterminate_identity",
                "infinite_solutions": true,
                "var": target_v,
                "parameters": param_vars,
                "solutions": [],
                "values": [],
                "exact_solutions": [],
                "complex_solutions": [],
                "excluded_poles": [],
                "rejected_extraneous": [],
                "parametric_cases": [c_id],
                "cases": [c_id],
                "domain_guards": ctx["guards"],
                "domain_guard": _guards_joined(ctx),
                "steps": ctx["steps"]
            };
        }
        let c_imp = map{
            "condition": to_ascii(ast_rel("!=", c0, RAT_ZERO)),
            "condition_unicode": to_unicode(ast_rel("!=", c0, RAT_ZERO)),
            "condition_latex": to_latex(ast_rel("!=", c0, RAT_ZERO)),
            "regime": "inconsistent_impossible",
            "status": "inconsistent_impossible",
            "infinite_solutions": false,
            "solutions": []
        };
        let p_cases = [c_imp];
        if len(free_vars(c0)) > 0 {
            push(p_cases, map{
                "condition": to_ascii(ast_rel("=", c0, RAT_ZERO)),
                "condition_unicode": to_unicode(ast_rel("=", c0, RAT_ZERO)),
                "condition_latex": to_latex(ast_rel("=", c0, RAT_ZERO)),
                "regime": "indeterminate_identity",
                "status": "indeterminate_identity",
                "infinite_solutions": true,
                "solutions": "all_real_numbers"
            });
        }
        return map{
            "ok": true,
            "kind": "parametric_equation",
            "status": "parametric_branched",
            "var": target_v,
            "parameters": param_vars,
            "solutions": [],
            "values": [],
            "exact_solutions": [],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": [],
            "parametric_cases": p_cases,
            "cases": p_cases,
            "domain_guards": ctx["guards"],
            "domain_guard": _guards_joined(ctx),
            "steps": ctx["steps"]
        };
    }

    // Degree 1 in target_v: A(p)*x + C0(p) = 0  <=>  A(p)*x = B(p)
    if coeffs != nil and len(coeffs) == 2 {
        let ab = _normalize_lead_pair(coeffs[1], simplify_node(ast_neg(coeffs[0]), ctx));
        let A = ab[0];
        let B = ab[1];
        let q_sol = simplify_node(ast_div(B, A), nil);
        let gen_sol = _make_real_sol(q_sol, nil);
        let p_cases = [];

        if len(free_vars(A)) == 0 {
            // Leading coefficient A is a non-zero constant!
            push(p_cases, map{
                "condition": "always",
                "condition_unicode": "∀",
                "condition_latex": "\\text{always}",
                "regime": "unique_solution",
                "status": "unique_solution",
                "solutions": [gen_sol["ascii"]],
                "solution_ast": q_sol,
                "ascii": target_v + " = " + gen_sol["ascii"],
                "unicode": target_v + " = " + gen_sol["unicode"],
                "latex": v_ltx + " = " + gen_sol["latex"]
            });
        } else if len(param_vars) == 1 {
            let p = param_vars[0];
            let p_ltx = to_latex(ast_sym(p));
            _add_guard(ctx, to_ascii(A) + " != 0");
            let a_eq = try _solve_single_eq(A, RAT_ZERO, p, _new_ctx(), 1) catch nil;
            let a_roots = [];
            if a_eq != nil { a_roots = a_eq["solutions"]; }

            let neq_a_parts = [];
            let neq_u_parts = [];
            let neq_l_parts = [];
            let ri = 0;
            while ri < len(a_roots) {
                let rs = a_roots[ri];
                let b_at_r = simplify_node(subst_ast(B, _env1(p, rs["ast"])), nil);
                let bv = eval_ast(b_at_r, map{});
                let is_b_zero = is_zero_node(b_at_r) or (bv != nil and num_abs(bv) <= 1.0e-11);
                let c_asc = p + " = " + rs["ascii"];
                let c_uni = p + " = " + rs["unicode"];
                let c_ltx = p_ltx + " = " + rs["latex"];
                push(neq_a_parts, p + " != " + rs["ascii"]);
                push(neq_u_parts, p + " ≠ " + rs["unicode"]);
                push(neq_l_parts, p_ltx + " \\neq " + rs["latex"]);
                if is_b_zero {
                    push(p_cases, map{
                        "condition": c_asc,
                        "condition_unicode": c_uni,
                        "condition_latex": c_ltx,
                        "regime": "indeterminate_identity",
                        "status": "indeterminate_identity",
                        "infinite_solutions": true,
                        "solutions": "all_real_numbers",
                        "ascii": target_v + " in (-inf, +inf)",
                        "unicode": target_v + " ∈ ℝ",
                        "latex": v_ltx + " \\in \\mathbb{R}",
                        "meaning_el": "Αόριστη εξίσωση (0·" + target_v + " = 0) — ταυτότητα για κάθε " + target_v + " ∈ ℝ"
                    });
                } else {
                    push(p_cases, map{
                        "condition": c_asc,
                        "condition_unicode": c_uni,
                        "condition_latex": c_ltx,
                        "regime": "inconsistent_impossible",
                        "status": "inconsistent_impossible",
                        "infinite_solutions": false,
                        "solutions": [],
                        "ascii": "no solution",
                        "unicode": "∅",
                        "latex": "\\emptyset",
                        "meaning_el": "Αδύνατη εξίσωση (0·" + target_v + " = " + to_unicode(b_at_r) + " ≠ 0) — καμία λύση"
                    });
                }
                ri = ri + 1;
            }

            let gen_cond_a = to_ascii(A) + " != 0";
            let gen_cond_u = to_unicode(A) + " ≠ 0";
            let gen_cond_l = to_latex(A) + " \\neq 0";
            if len(neq_a_parts) > 0 {
                gen_cond_a = ""; gen_cond_u = ""; gen_cond_l = "";
                let ni = 0;
                while ni < len(neq_a_parts) {
                    if ni > 0 {
                        gen_cond_a = gen_cond_a + " and ";
                        gen_cond_u = gen_cond_u + " ∧ ";
                        gen_cond_l = gen_cond_l + " \\land ";
                    }
                    gen_cond_a = gen_cond_a + neq_a_parts[ni];
                    gen_cond_u = gen_cond_u + neq_u_parts[ni];
                    gen_cond_l = gen_cond_l + neq_l_parts[ni];
                    ni = ni + 1;
                }
            } else if a_eq != nil and len(a_eq["complex_solutions"]) > 0 {
                gen_cond_a = p + " in (-inf, +inf)";
                gen_cond_u = p + " ∈ ℝ";
                gen_cond_l = p_ltx + " \\in \\mathbb{R}";
            }
            push(p_cases, map{
                "condition": gen_cond_a,
                "condition_unicode": gen_cond_u,
                "condition_latex": gen_cond_l,
                "regime": "unique_solution",
                "status": "unique_solution",
                "solutions": [gen_sol["ascii"]],
                "solution_ast": q_sol,
                "ascii": target_v + " = " + gen_sol["ascii"],
                "unicode": target_v + " = " + gen_sol["unicode"],
                "latex": v_ltx + " = " + gen_sol["latex"],
                "meaning_el": "Μοναδική λύση"
            });
        } else {
            // Multi-parameter linear equation (e.g. a*x = b)
            _add_guard(ctx, to_ascii(A) + " != 0");
            let a_nz = ast_rel("!=", A, RAT_ZERO);
            let a_z = ast_rel("=", A, RAT_ZERO);
            push(p_cases, map{
                "condition": to_ascii(a_nz),
                "condition_unicode": to_unicode(a_nz),
                "condition_latex": to_latex(a_nz),
                "regime": "unique_solution",
                "status": "unique_solution",
                "solutions": [gen_sol["ascii"]],
                "solution_ast": q_sol,
                "ascii": target_v + " = " + gen_sol["ascii"],
                "unicode": target_v + " = " + gen_sol["unicode"],
                "latex": v_ltx + " = " + gen_sol["latex"]
            });
            if is_zero_node(B) {
                push(p_cases, map{
                    "condition": to_ascii(a_z),
                    "condition_unicode": to_unicode(a_z),
                    "condition_latex": to_latex(a_z),
                    "regime": "indeterminate_identity",
                    "status": "indeterminate_identity",
                    "infinite_solutions": true,
                    "solutions": "all_real_numbers"
                });
            } else if len(free_vars(B)) == 0 {
                push(p_cases, map{
                    "condition": to_ascii(a_z),
                    "condition_unicode": to_unicode(a_z),
                    "condition_latex": to_latex(a_z),
                    "regime": "inconsistent_impossible",
                    "status": "inconsistent_impossible",
                    "infinite_solutions": false,
                    "solutions": []
                });
            } else {
                let b_z = ast_rel("=", B, RAT_ZERO);
                let b_nz = ast_rel("!=", B, RAT_ZERO);
                push(p_cases, map{
                    "condition": to_ascii(a_z) + " and " + to_ascii(b_z),
                    "condition_unicode": to_unicode(a_z) + " ∧ " + to_unicode(b_z),
                    "condition_latex": to_latex(a_z) + " \\land " + to_latex(b_z),
                    "regime": "indeterminate_identity",
                    "status": "indeterminate_identity",
                    "infinite_solutions": true,
                    "solutions": "all_real_numbers"
                });
                push(p_cases, map{
                    "condition": to_ascii(a_z) + " and " + to_ascii(b_nz),
                    "condition_unicode": to_unicode(a_z) + " ∧ " + to_unicode(b_nz),
                    "condition_latex": to_latex(a_z) + " \\land " + to_latex(b_nz),
                    "regime": "inconsistent_impossible",
                    "status": "inconsistent_impossible",
                    "infinite_solutions": false,
                    "solutions": []
                });
            }
        }

        _record_step(ctx, "parametric_linear_case_split", ast_rel("=", ast_sym(target_v), q_sol));
        return map{
            "ok": true,
            "kind": "parametric_equation",
            "status": "parametric_branched",
            "degree": 1,
            "var": target_v,
            "parameters": param_vars,
            "solutions": [gen_sol],
            "values": [],
            "exact_solutions": [gen_sol["exact"]],
            "rhs_ascii": gen_sol["ascii"],
            "rhs_unicode": gen_sol["unicode"],
            "rhs_latex": gen_sol["latex"],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": [],
            "parametric_cases": p_cases,
            "cases": p_cases,
            "domain_guards": ctx["guards"],
            "domain_guard": _guards_joined(ctx),
            "steps": ctx["steps"]
        };
    }

    // Degree 2 in target_v: A(p)*x^2 + B(p)*x + C(p) = 0
    if coeffs != nil and len(coeffs) == 3 {
        let A = coeffs[2];
        let B = coeffs[1];
        let C = coeffs[0];
        let disc = simplify_node(_expand_node(ast_sub(ast_pow(B, RAT_TWO), ast_mul([rat(4, 1), A, C])), ctx), ctx);
        let neg_b = simplify_node(ast_neg(B), ctx);
        let two_a = simplify_node(ast_mul([RAT_TWO, A]), ctx);
        let x_dbl_gen = simplify_node(ast_div(neg_b, two_a), nil);
        let r_minus = simplify_node(ast_div(ast_sub(neg_b, ast_call("sqrt", [disc])), two_a), nil);
        let r_plus = simplify_node(ast_div(ast_add([neg_b, ast_call("sqrt", [disc])]), two_a), nil);
        let neg_disc = simplify_node(ast_neg(disc), nil);
        let c_minus_str = "(" + to_ascii(neg_b) + " - i*sqrt(" + to_ascii(neg_disc) + "))/(" + to_ascii(two_a) + ")";
        let c_plus_str = "(" + to_ascii(neg_b) + " + i*sqrt(" + to_ascii(neg_disc) + "))/(" + to_ascii(two_a) + ")";
        if is_zero_node(neg_b) {
            c_minus_str = "-i*sqrt(" + to_ascii(neg_disc) + ")/(" + to_ascii(two_a) + ")";
            c_plus_str = "i*sqrt(" + to_ascii(neg_disc) + ")/(" + to_ascii(two_a) + ")";
        }

        let p_cases = [];
        if len(param_vars) == 1 {
            let p = param_vars[0];
            let p_ltx = to_latex(ast_sym(p));
            let a_deg_vals = [];

            // 1. Linear degeneration A(p) = 0
            if len(free_vars(A)) > 0 {
                let a_eq = try _solve_single_eq(A, RAT_ZERO, p, _new_ctx(), 1) catch nil;
                if a_eq != nil {
                    let ai = 0;
                    while ai < len(a_eq["solutions"]) {
                        let asol = a_eq["solutions"][ai];
                        if asol["value"] != nil { push(a_deg_vals, asol["value"]); }
                        let b_sub = simplify_node(subst_ast(B, _env1(p, asol["ast"])), nil);
                        let c_sub = simplify_node(subst_ast(C, _env1(p, asol["ast"])), nil);
                        let c_asc = p + " = " + asol["ascii"];
                        let c_uni = p + " = " + asol["unicode"];
                        let c_ltx = p_ltx + " = " + asol["latex"];
                        if is_zero_node(b_sub) and is_zero_node(c_sub) {
                            push(p_cases, map{
                                "condition": c_asc,
                                "condition_unicode": c_uni,
                                "condition_latex": c_ltx,
                                "regime": "indeterminate_identity",
                                "status": "indeterminate_identity",
                                "infinite_solutions": true,
                                "solutions": "all_real_numbers"
                            });
                        } else if is_zero_node(b_sub) {
                            push(p_cases, map{
                                "condition": c_asc,
                                "condition_unicode": c_uni,
                                "condition_latex": c_ltx,
                                "regime": "inconsistent_impossible",
                                "status": "inconsistent_impossible",
                                "infinite_solutions": false,
                                "solutions": []
                            });
                        } else {
                            let lin_x = simplify_node(ast_div(ast_neg(c_sub), b_sub), nil);
                            push(p_cases, map{
                                "condition": c_asc,
                                "condition_unicode": c_uni,
                                "condition_latex": c_ltx,
                                "regime": "linear_degeneration",
                                "status": "linear_degeneration",
                                "degree": 1,
                                "solutions": [to_ascii(lin_x)],
                                "solution_ast": lin_x,
                                "ascii": target_v + " = " + to_ascii(lin_x),
                                "unicode": target_v + " = " + to_unicode(lin_x),
                                "latex": v_ltx + " = " + to_latex(lin_x),
                                "meaning_el": "Εκφυλισμός σε πρωτοβάθμια εξίσωση — μοναδική πραγματική ρίζα"
                            });
                        }
                        ai = ai + 1;
                    }
                }
            }

            // Non-zero leading mask A(p) != 0
            let a_nz_ivs = nil;
            if len(free_vars(A)) > 0 {
                let anz = try _solve_single_inequality(ast_rel("!=", A, RAT_ZERO), p, _new_ctx()) catch nil;
                if anz != nil { a_nz_ivs = anz["intervals"]; }
            }

            // 2. Discriminant Delta(p) = 0 -> Double real root
            if is_zero_node(disc) {
                let dbl_cond = map{ "ascii": p + " in (-inf, +inf)", "unicode": p + " ∈ ℝ", "latex": p_ltx + " \\in \\mathbb{R}" };
                if a_nz_ivs != nil {
                    let c_tmp = _intervals_to_param_cond(a_nz_ivs, p);
                    if c_tmp != nil { dbl_cond = c_tmp; }
                }
                push(p_cases, map{
                    "condition": dbl_cond["ascii"],
                    "condition_unicode": dbl_cond["unicode"],
                    "condition_latex": dbl_cond["latex"],
                    "regime": "double_real_root",
                    "status": "double_real_root",
                    "multiplicity": 2,
                    "solutions": [to_ascii(x_dbl_gen)],
                    "ascii": target_v + " = " + to_ascii(x_dbl_gen),
                    "unicode": target_v + " = " + to_unicode(x_dbl_gen),
                    "latex": v_ltx + " = " + to_latex(x_dbl_gen)
                });
            } else {
                let d_eq = try _solve_single_eq(disc, RAT_ZERO, p, _new_ctx(), 1) catch nil;
                if d_eq != nil {
                    let di = 0;
                    while di < len(d_eq["solutions"]) {
                        let dsol = d_eq["solutions"][di];
                        let collides_a = false;
                        if dsol["value"] != nil {
                            let k = 0;
                            while k < len(a_deg_vals) {
                                if num_abs(dsol["value"] - a_deg_vals[k]) <= 1.0e-10 { collides_a = true; }
                                k = k + 1;
                            }
                        }
                        if not collides_a {
                            let dbl_sub = simplify_node(subst_ast(x_dbl_gen, _env1(p, dsol["ast"])), nil);
                            push(p_cases, map{
                                "condition": p + " = " + dsol["ascii"],
                                "condition_unicode": p + " = " + dsol["unicode"],
                                "condition_latex": p_ltx + " = " + dsol["latex"],
                                "regime": "double_real_root",
                                "status": "double_real_root",
                                "multiplicity": 2,
                                "solutions": [to_ascii(dbl_sub)],
                                "solution_ast": dbl_sub,
                                "ascii": target_v + " = " + to_ascii(dbl_sub),
                                "unicode": target_v + " = " + to_unicode(dbl_sub),
                                "latex": v_ltx + " = " + to_latex(dbl_sub),
                                "meaning_el": "Διπλή πραγματική ρίζα (Δ = 0)"
                            });
                        }
                        di = di + 1;
                    }
                }

                // 3. Discriminant Delta(p) > 0 and A(p) != 0 -> Two distinct real roots
                let d_pos = try _solve_single_inequality(ast_rel(">", disc, RAT_ZERO), p, _new_ctx()) catch nil;
                if d_pos != nil {
                    let pos_ivs = d_pos["intervals"];
                    if a_nz_ivs != nil { pos_ivs = interval_set_intersect(pos_ivs, a_nz_ivs); }
                    if len(pos_ivs) > 0 {
                        let pc = _intervals_to_param_cond(pos_ivs, p);
                        push(p_cases, map{
                            "condition": pc["ascii"],
                            "condition_unicode": pc["unicode"],
                            "condition_latex": pc["latex"],
                            "interval_unicode": _format_intervals(pos_ivs, "unicode"),
                            "regime": "two_distinct_real_roots",
                            "status": "two_distinct_real_roots",
                            "solutions": [to_ascii(r_minus), to_ascii(r_plus)],
                            "ascii": target_v + " = " + to_ascii(r_minus) + ", " + to_ascii(r_plus),
                            "unicode": target_v + " = " + to_unicode(r_minus) + ", " + to_unicode(r_plus),
                            "latex": v_ltx + " = " + to_latex(r_minus) + ", " + to_latex(r_plus),
                            "meaning_el": "Δύο άνισες πραγματικές ρίζες (Δ > 0)"
                        });
                    }
                }

                // 4. Discriminant Delta(p) < 0 and A(p) != 0 -> Complex conjugate roots
                let d_neg = try _solve_single_inequality(ast_rel("<", disc, RAT_ZERO), p, _new_ctx()) catch nil;
                if d_neg != nil {
                    let neg_ivs = d_neg["intervals"];
                    if a_nz_ivs != nil { neg_ivs = interval_set_intersect(neg_ivs, a_nz_ivs); }
                    if len(neg_ivs) > 0 {
                        let nc = _intervals_to_param_cond(neg_ivs, p);
                        push(p_cases, map{
                            "condition": nc["ascii"],
                            "condition_unicode": nc["unicode"],
                            "condition_latex": nc["latex"],
                            "interval_unicode": _format_intervals(neg_ivs, "unicode"),
                            "regime": "complex_conjugate_roots",
                            "status": "complex_conjugate_roots",
                            "real_solutions": [],
                            "solutions": [],
                            "complex_solutions": [c_minus_str, c_plus_str],
                            "meaning_el": "Δύο συζυγείς μιγαδικές ρίζες / καμία πραγματική ρίζα (Δ < 0)"
                        });
                    }
                }
            }
        } else {
            // Multi-parameter quadratic equation (e.g. a*x^2 + b*x + c = 0)
            if len(free_vars(A)) > 0 {
                push(p_cases, map{
                    "condition": to_ascii(A) + " = 0 and " + to_ascii(B) + " != 0",
                    "regime": "linear_degeneration",
                    "status": "linear_degeneration",
                    "solutions": [to_ascii(simplify_node(ast_div(ast_neg(C), B), nil))]
                });
            }
            let a_guard = "";
            if len(free_vars(A)) > 0 { a_guard = to_ascii(A) + " != 0 and "; }
            push(p_cases, map{
                "condition": a_guard + to_ascii(disc) + " = 0",
                "regime": "double_real_root",
                "status": "double_real_root",
                "multiplicity": 2,
                "solutions": [to_ascii(x_dbl_gen)]
            });
            push(p_cases, map{
                "condition": a_guard + to_ascii(disc) + " > 0",
                "regime": "two_distinct_real_roots",
                "status": "two_distinct_real_roots",
                "solutions": [to_ascii(r_minus), to_ascii(r_plus)]
            });
            push(p_cases, map{
                "condition": a_guard + to_ascii(disc) + " < 0",
                "regime": "complex_conjugate_roots",
                "status": "complex_conjugate_roots",
                "real_solutions": [],
                "solutions": [],
                "complex_solutions": [c_minus_str, c_plus_str]
            });
        }

        let s1 = _make_real_sol(r_minus, nil);
        let s2 = _make_real_sol(r_plus, nil);
        _record_step(ctx, "parametric_quadratic_discriminant_analysis", disc);
        return map{
            "ok": true,
            "kind": "parametric_equation",
            "status": "parametric_branched",
            "degree": 2,
            "var": target_v,
            "parameters": param_vars,
            "discriminant": to_ascii(disc),
            "discriminant_unicode": to_unicode(disc),
            "discriminant_latex": to_latex(disc),
            "solutions": [s1, s2],
            "values": [],
            "exact_solutions": [s1["exact"], s2["exact"]],
            "rhs_ascii": s1["ascii"] + ", " + s2["ascii"],
            "rhs_unicode": s1["unicode"] + ", " + s2["unicode"],
            "rhs_latex": s1["latex"] + ", " + s2["latex"],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": [],
            "parametric_cases": p_cases,
            "cases": p_cases,
            "domain_guards": ctx["guards"],
            "domain_guard": _guards_joined(ctx),
            "steps": ctx["steps"]
        };
    }

    // Fallback for nonlinear / transcendental parametric formulas solvable via _isolate_var
    let iso_rel = try _isolate_var(ast_rel("=", lhs_in, rhs_in), target_v, ctx) catch nil;
    if iso_rel != nil {
        let sol_n = _make_real_sol(iso_rel["rhs"], nil);
        let g_cond = _guards_joined(ctx);
        if g_cond == nil or g_cond == "" { g_cond = "domain_valid"; }
        let fb_case = map{
            "condition": g_cond,
            "regime": "unique_solution",
            "status": "unique_solution",
            "solutions": [sol_n["ascii"]],
            "ascii": target_v + " = " + sol_n["ascii"],
            "unicode": target_v + " = " + sol_n["unicode"],
            "latex": v_ltx + " = " + sol_n["latex"]
        };
        return map{
            "ok": true,
            "kind": "parametric_equation",
            "status": "parametric_branched",
            "var": target_v,
            "parameters": param_vars,
            "solutions": [sol_n],
            "values": [],
            "exact_solutions": [sol_n["exact"]],
            "rhs_ascii": sol_n["ascii"],
            "rhs_unicode": sol_n["unicode"],
            "rhs_latex": sol_n["latex"],
            "complex_solutions": [],
            "excluded_poles": [],
            "rejected_extraneous": [],
            "parametric_cases": [fb_case],
            "cases": [fb_case],
            "domain_guards": ctx["guards"],
            "domain_guard": _guards_joined(ctx),
            "steps": ctx["steps"]
        };
    }
    return nil;
}

// Public Universal Solver (`solve(input, vars = nil, opts = nil)`)
fn solve(input, vars = nil, opts = nil) {
    if opts == nil { opts = map{}; }
    let ctx = _new_ctx();
    let parsed = parse_math(input);
    _record_step(ctx, "input_parsed", parsed);
    if not (map_has(opts, "keep_custom") and opts["keep_custom"]) and _contains_user_or_prime_call(parsed) {
        let exp_u = expand_user_functions(parsed, 0);
        if not ast_eq(exp_u, parsed) {
            parsed = exp_u;
            _record_step(ctx, "expand_custom_functions", parsed);
        }
    }

    // 1. System of equations or 1D inequalities
    if parsed["kind"] == "system" {
        let items = parsed["items"];
        let all_ineq = true;
        let i = 0;
        while i < len(items) {
            if items[i]["kind"] != "rel" or items[i]["op"] == "=" {
                all_ineq = false;
            }
            i = i + 1;
        }
        let sys_vars = nil;
        if type(vars) == "array" and len(vars) > 0 { sys_vars = vars; }
        else if type(vars) == "string" and vars != "" { sys_vars = [vars]; }
        else { sys_vars = _order_system_vars(free_vars(parsed)); }

        if all_ineq and len(sys_vars) == 1 {
            let v1 = sys_vars[0];
            let cur_ivs = nil;
            i = 0;
            while i < len(items) {
                let sub_in = _solve_single_inequality(items[i], v1, ctx);
                if cur_ivs == nil { cur_ivs = sub_in["intervals"]; }
                else { cur_ivs = interval_set_intersect(cur_ivs, sub_in["intervals"]); }
                i = i + 1;
            }
            if cur_ivs == nil { cur_ivs = []; }
            return map{
                "ok": true,
                "kind": "inequality_system",
                "var": v1,
                "intervals": cur_ivs,
                "ascii": _format_intervals(cur_ivs, "ascii"),
                "unicode": _format_intervals(cur_ivs, "unicode"),
                "latex": _format_intervals(cur_ivs, "latex"),
                "steps": ctx["steps"]
            };
        }

        // Normalize bare expressions in equation system to expr = 0
        let eq_items = [];
        i = 0;
        while i < len(items) {
            if items[i]["kind"] == "rel" { push(eq_items, items[i]); }
            else { push(eq_items, ast_rel("=", items[i], RAT_ZERO)); }
            i = i + 1;
        }

        // Check if linear over Q in sys_vars!
        let aug = [];
        let is_lin_sys = true;
        i = 0;
        while i < len(eq_items) {
            let row = _extract_linear_system_row(eq_items[i], sys_vars, ctx);
            if row == nil { is_lin_sys = false; break; }
            push(aug, row);
            i = i + 1;
        }
        if is_lin_sys {
            let rr = rref_rat(aug, len(sys_vars));
            _record_step(ctx, "exact_rational_gauss_jordan_rref (" + rr["status"] + ")", ast_sym(rr["status"]));
            if rr["status"] == "inconsistent" {
                return map{
                    "ok": true,
                    "kind": "linear_system",
                    "status": "inconsistent",
                    "vars": sys_vars,
                    "solutions": [],
                    "steps": ctx["steps"]
                };
            }
            if rr["status"] == "infinite_parametric" {
                let free_names = [];
                let param_map = map{};
                let fi = 0;
                while fi < len(rr["free_cols"]) {
                    let fc = rr["free_cols"][fi];
                    let t_sym = "t" + str(fi + 1);
                    push(free_names, sys_vars[fc]);
                    param_map[sys_vars[fc]] = t_sym;
                    fi = fi + 1;
                }
                let pr = 0;
                while pr < len(rr["pivot_cols"]) {
                    let pc = rr["pivot_cols"][pr];
                    let rhs_r = rr["rref"][pr][len(sys_vars)];
                    let expr_terms = [];
                    if not rat_is_zero(rhs_r) { push(expr_terms, rhs_r); }
                    fi = 0;
                    while fi < len(rr["free_cols"]) {
                        let fc = rr["free_cols"][fi];
                        let coeff_f = rr["rref"][pr][fc];
                        if not rat_is_zero(coeff_f) {
                            push(expr_terms, ast_mul([rat_neg(coeff_f), ast_sym("t" + str(fi + 1))]));
                        }
                        fi = fi + 1;
                    }
                    param_map[sys_vars[pc]] = to_ascii(simplify_node(ast_add(expr_terms), nil));
                    pr = pr + 1;
                }
                return map{
                    "ok": true,
                    "kind": "linear_system",
                    "status": "infinite_parametric",
                    "vars": sys_vars,
                    "free_vars": free_names,
                    "parametric": param_map,
                    "solutions": [],
                    "steps": ctx["steps"]
                };
            }
            // Unique exact rational solution!
            let sol_vals = map{};
            let sol_exact = map{};
            let k = 0;
            while k < len(sys_vars) {
                let r_val = rr["solution"][k];
                sol_vals[sys_vars[k]] = rat_to_float(r_val);
                sol_exact[sys_vars[k]] = rat_to_str(r_val);
                k = k + 1;
            }
            return map{
                "ok": true,
                "kind": "linear_system",
                "status": "unique",
                "vars": sys_vars,
                "solution": sol_vals,
                "exact": sol_exact,
                "exact_solution": sol_exact,
                "solutions": [sol_vals],
                "steps": ctx["steps"]
            };
        }

        // Nonlinear multivariate system!
        return _solve_nonlinear_system(eq_items, sys_vars, ctx);
    }

    // 2. Chained Inequality (`-3 < 2x + 1 <= 7`)
    if parsed["kind"] == "chain_rel" {
        let fvs = free_vars(parsed);
        let v_ch = "x";
        if type(vars) == "string" and vars != "" { v_ch = vars; }
        else if len(fvs) > 0 { v_ch = fvs[0]; }
        let pts = parsed["parts"];
        let cur_ivs = nil;
        let i = 0;
        while i < len(pts) {
            let sub_r = _solve_single_inequality(pts[i], v_ch, ctx);
            if cur_ivs == nil { cur_ivs = sub_r["intervals"]; }
            else { cur_ivs = interval_set_intersect(cur_ivs, sub_r["intervals"]); }
            i = i + 1;
        }
        if cur_ivs == nil { cur_ivs = []; }
        return map{
            "ok": true,
            "kind": "inequality",
            "chained": true,
            "var": v_ch,
            "intervals": cur_ivs,
            "ascii": _format_intervals(cur_ivs, "ascii"),
            "unicode": _format_intervals(cur_ivs, "unicode"),
            "latex": _format_intervals(cur_ivs, "latex"),
            "steps": ctx["steps"]
        };
    }

    // Determine single target variable & auxiliary symbolic parameters
    let all_fvs = free_vars(parsed);
    let target_v = nil;
    if type(vars) == "string" and vars != "" { target_v = vars; }
    else if type(vars) == "array" and len(vars) > 0 { target_v = vars[0]; }
    else if map_has(opts, "var") { target_v = opts["var"]; }
    else {
        if len(all_fvs) == 1 { target_v = all_fvs[0]; }
        else if len(all_fvs) > 1 {
            // Prefer canonical unknown ("x", "y", "z", "t") when solving parametrically
            let pref = ["x", "y", "z", "t"];
            let pi = 0;
            while pi < len(pref) and target_v == nil {
                let j = 0;
                while j < len(all_fvs) {
                    if all_fvs[j] == pref[pi] { target_v = pref[pi]; break; }
                    j = j + 1;
                }
                pi = pi + 1;
            }
            if target_v == nil { target_v = all_fvs[0]; }
        } else {
            target_v = "x";
        }
    }
    let param_vars = [];
    let pvi = 0;
    while pvi < len(all_fvs) {
        if all_fvs[pvi] != target_v { push(param_vars, all_fvs[pvi]); }
        pvi = pvi + 1;
    }
    param_vars = _sort_strings(param_vars);

    // 3. Single Inequality (`<`, `<=`, `>`, `>=`, `!=`)
    if parsed["kind"] == "rel" and parsed["op"] != "=" {
        if len(param_vars) > 0 {
            let p_cases = _solve_parametric_inequality_cases(parsed, target_v, param_vars, ctx);
            let iso = try _isolate_var(parsed, target_v, ctx) catch parsed;
            return map{
                "ok": true,
                "kind": "parametric_inequality",
                "status": "parametric_branched",
                "var": target_v,
                "parameters": param_vars,
                "ast": iso,
                "ascii": to_ascii(iso),
                "unicode": to_unicode(iso),
                "latex": to_latex(iso),
                "parametric_cases": p_cases,
                "cases": p_cases,
                "domain_guard": _guards_joined(ctx),
                "steps": ctx["steps"]
            };
        }
        return _solve_single_inequality(parsed, target_v, ctx);
    }

    // 4. Single-Variable or Parametric Equation
    let lhs_e = parsed;
    let rhs_e = RAT_ZERO;
    if parsed["kind"] == "rel" {
        lhs_e = parsed["lhs"];
        rhs_e = parsed["rhs"];
    }
    if len(param_vars) > 0 {
        let param_res = _solve_parametric_equation_full(lhs_e, rhs_e, target_v, param_vars, ctx);
        if param_res != nil {
            return param_res;
        }
    }

    let eq_res = _solve_single_eq(lhs_e, rhs_e, target_v, ctx, 0);
    let sols = eq_res["solutions"];
    let vals = [];
    let exacts = [];
    let si = 0;
    while si < len(sols) {
        if sols[si]["value"] != nil { push(vals, sols[si]["value"]); }
        push(exacts, sols[si]["exact"]);
        si = si + 1;
    }

    let out = map{
        "ok": true,
        "kind": "equation",
        "status": "solved",
        "infinite_solutions": false,
        "var": target_v,
        "solutions": sols,
        "values": vals,
        "exact_solutions": exacts,
        "complex_solutions": eq_res["complex_solutions"],
        "excluded_poles": eq_res["excluded_poles"],
        "rejected_extraneous": eq_res["rejected_extraneous"],
        "domain_guards": ctx["guards"],
        "domain_guard": _guards_joined(ctx),
        "steps": ctx["steps"]
    };
    if map_has(eq_res, "parametric") and eq_res["parametric"] {
        out["kind"] = "parametric_equation";
        out["rhs_ascii"] = sols[0]["ascii"];
        out["rhs_unicode"] = sols[0]["unicode"];
        out["rhs_latex"] = sols[0]["latex"];
    }
    if map_has(eq_res, "is_trig") and eq_res["is_trig"] {
        out["kind"] = "trig_equation";
        out["principal_solutions"] = eq_res["principal_solutions"];
        out["general_families"] = eq_res["general_families"];
    }
    if map_has(eq_res, "identity") and eq_res["identity"] {
        out["status"] = "indeterminate_identity";
        out["solution_set"] = "all_reals";
        out["infinite_solutions"] = true;
        out["interval_ascii"] = "(-inf, +inf)";
        out["interval_unicode"] = "(-∞, +∞)";
        out["interval_latex"] = "(-\\infty, +\\infty)";
        out["meaning_el"] = "Αόριστη εξίσωση / Ταυτότητα — αληθεύει για κάθε πραγματικό αριθμό";
    } else if len(sols) == 0 and len(eq_res["complex_solutions"]) == 0 and not (map_has(eq_res, "is_trig") and eq_res["is_trig"]) {
        out["status"] = "inconsistent_impossible";
        out["infinite_solutions"] = false;
        out["meaning_el"] = "Αδύνατη εξίσωση — καμία λύση";
    }
    return out;
}

// Explicit Parametric Branching Entrypoint (`solve_parametric(input, vars = nil, opts = nil)`)
fn solve_parametric(input, vars = nil, opts = nil) {
    let res = solve(input, vars, opts);
    if not map_has(res, "parametric_cases") {
        let syn_cases = [];
        if map_has(res, "status") and res["status"] == "indeterminate_identity" {
            push(syn_cases, map{
                "condition": "always",
                "regime": "indeterminate_identity",
                "status": "indeterminate_identity",
                "infinite_solutions": true,
                "solutions": "all_real_numbers"
            });
        } else if map_has(res, "status") and res["status"] == "inconsistent_impossible" {
            push(syn_cases, map{
                "condition": "always",
                "regime": "inconsistent_impossible",
                "status": "inconsistent_impossible",
                "infinite_solutions": false,
                "solutions": []
            });
        } else if map_has(res, "exact_solutions") {
            push(syn_cases, map{
                "condition": "always",
                "regime": "solved",
                "status": "solved",
                "solutions": res["exact_solutions"]
            });
        }
        res["parametric_cases"] = syn_cases;
        res["cases"] = syn_cases;
    }
    return res;
}

// ── Guarded Algebraic Indeterminacy Classifier (`analyze_indeterminacy`) ──────

fn _classify_tendency_seq(v1, v2, v3) {
    if v3 == nil or v3 != v3 { return map{ "kind": "undef", "label": "undefined" }; }
    if v3 > 1.0e150 { return map{ "kind": "+inf", "label": "+inf", "sign": 1 }; }
    if v3 < -1.0e150 { return map{ "kind": "-inf", "label": "-inf", "sign": -1 }; }
    if v1 == nil or v2 == nil or v1 != v1 or v2 != v2 {
        if v3 > 1.0e7 { return map{ "kind": "+inf", "label": "+inf", "sign": 1 }; }
        if v3 < -1.0e7 { return map{ "kind": "-inf", "label": "-inf", "sign": -1 }; }
        if num_abs(v3) < 1.0e-5 { return map{ "kind": "zero", "val": 0.0, "label": 0 }; }
        if num_abs(v3 - 1.0) < 1.0e-5 { return map{ "kind": "one", "val": 1.0, "label": 1 }; }
        return map{ "kind": "finite", "val": v3, "label": v3 };
    }
    let d1 = v2 - v1;
    let d2 = v3 - v2;
    let ad1 = num_abs(d1);
    let ad2 = num_abs(d2);

    // 1. Divergence to ±infinity (covers fast power/pole/exp growth AND logarithmic growth!)
    let fast_div = (num_abs(v3) > 500.0 and num_abs(v3) > 4.0 * num_abs(v2) and num_abs(v2) > 4.0 * num_abs(v1));
    let log_div = (num_abs(v3) > 5.0 and d1 * d2 > 0.0 and ad1 > 0.15 and ad2 >= 0.70 * ad1);
    if fast_div or log_div {
        if v3 > 0.0 { return map{ "kind": "+inf", "label": "+inf", "sign": 1 }; }
        return map{ "kind": "-inf", "label": "-inf", "sign": -1 };
    }

    // 2. Convergence to zero (covers polynomial, radical, and 1/ln(x) decay)
    if (num_abs(v3) < 1.0e-6 and ad2 < 1.0e-5)
        or (num_abs(v3) < 0.08 and num_abs(v3) < 0.80 * num_abs(v2) and num_abs(v2) < 0.80 * num_abs(v1)) {
        return map{ "kind": "zero", "val": 0.0, "label": 0 };
    }

    // 3. Convergence to finite non-zero limit
    let snapped = num_round(v3);
    if num_abs(v3 - snapped) < 1.0e-4 and (ad2 < 1.0e-4 or num_abs(v3 - snapped) <= 0.25 * num_abs(v2 - snapped) + 1.0e-12) {
        if snapped == 0 { return map{ "kind": "zero", "val": 0.0, "label": 0 }; }
        if snapped == 1 { return map{ "kind": "one", "val": 1.0, "label": 1 }; }
        return map{ "kind": "finite", "val": snapped * 1.0, "label": snapped };
    }
    return map{ "kind": "finite", "val": v3, "label": v3 };
}

fn _eval_tendency_pts(node, v_name, pts, base_env) {
    if v_name == nil or pts == nil or len(pts) == 0 {
        let v0 = eval_ast(node, base_env);
        return _classify_tendency_seq(v0, v0, v0);
    }
    let e1 = map{}; let e2 = map{}; let e3 = map{};
    let ks = map_keys(base_env);
    let i = 0;
    while i < len(ks) {
        e1[ks[i]] = base_env[ks[i]];
        e2[ks[i]] = base_env[ks[i]];
        e3[ks[i]] = base_env[ks[i]];
        i = i + 1;
    }
    e1[v_name] = pts[0];
    e2[v_name] = pts[1];
    e3[v_name] = pts[2];
    let v1 = eval_ast(node, e1);
    let v2 = eval_ast(node, e2);
    let v3 = eval_ast(node, e3);
    return _classify_tendency_seq(v1, v2, v3);
}

fn _is_inf_tend(t) {
    return t != nil and (t["kind"] == "+inf" or t["kind"] == "-inf");
}

fn _indet_metadata(form_str) {
    if form_str == "0/0" {
        return map{
            "lattice_form": "0/0",
            "meaning_el": "Απροσδιόριστη μορφή 0/0 (μηδέν διά μηδέν)",
            "meaning_en": "Indeterminate form 0/0",
            "suggested_resolution": "factor_cancel_or_lhopital_or_taylor"
        };
    }
    if form_str == "inf/inf" {
        return map{
            "lattice_form": "inf/inf",
            "meaning_el": "Απροσδιόριστη μορφή ∞/∞ (άπειρο διά άπειρο)",
            "meaning_en": "Indeterminate form inf/inf",
            "suggested_resolution": "dominant_term_extraction_or_lhopital"
        };
    }
    if form_str == "0 * inf" {
        return map{
            "lattice_form": "0*inf",
            "meaning_el": "Απροσδιόριστη μορφή 0·∞ (μηδέν επί άπειρο)",
            "meaning_en": "Indeterminate form 0 * inf",
            "suggested_resolution": "rewrite_as_quotient_0_over_0_or_inf_over_inf"
        };
    }
    if form_str == "inf - inf" {
        return map{
            "lattice_form": "inf-inf",
            "meaning_el": "Απροσδιόριστη μορφή ∞ - ∞ (διαφορά απείρων)",
            "meaning_en": "Indeterminate form inf - inf",
            "suggested_resolution": "common_denominator_or_algebraic_conjugate"
        };
    }
    if form_str == "0^0" {
        return map{
            "lattice_form": "0^0",
            "meaning_el": "Απροσδιόριστη εκθετική μορφή 0⁰ (στην ανάλυση· στην άλγεβρα/συνδυαστική ισούται με 1)",
            "meaning_en": "Analytic indeterminate exponential form 0^0 (1 in combinatorial/polynomial algebra)",
            "suggested_resolution": "logarithmic_transform_exp_g_ln_f"
        };
    }
    if form_str == "1^inf" {
        return map{
            "lattice_form": "1^inf",
            "meaning_el": "Απροσδιόριστη εκθετική μορφή 1^∞ (τύπου Euler)",
            "meaning_en": "Indeterminate exponential form 1^inf",
            "suggested_resolution": "logarithmic_transform_exp_lim_g_times_f_minus_1"
        };
    }
    if form_str == "inf^0" {
        return map{
            "lattice_form": "inf^0",
            "meaning_el": "Απροσδιόριστη εκθετική μορφή ∞⁰",
            "meaning_en": "Indeterminate exponential form inf^0",
            "suggested_resolution": "logarithmic_transform_exp_g_ln_f"
        };
    }
    return map{
        "lattice_form": form_str,
        "meaning_el": "Μαθηματική έκφραση",
        "meaning_en": "Mathematical expression",
        "suggested_resolution": "direct_evaluation"
    };
}

fn _classify_ast_on_pts(raw_ast, v_name, pts, base_env) {
    if raw_ast == nil or type(raw_ast) != "map" { return nil; }
    let k = raw_ast["kind"];

    if k == "div" {
        let tn = _eval_tendency_pts(raw_ast["num"], v_name, pts, base_env);
        let td = _eval_tendency_pts(raw_ast["den"], v_name, pts, base_env);
        if tn["kind"] == "zero" and td["kind"] == "zero" {
            return map{ "indeterminate": true, "form": "0/0", "num_t": tn, "den_t": td };
        }
        if _is_inf_tend(tn) and _is_inf_tend(td) {
            return map{ "indeterminate": true, "form": "inf/inf", "num_t": tn, "den_t": td };
        }
        if td["kind"] == "zero" and tn["kind"] != "undef" and tn["kind"] != "zero" {
            return map{ "indeterminate": false, "form": "pole_singularity", "num_t": tn, "den_t": td };
        }
    }

    if k == "pow" {
        let tb = _eval_tendency_pts(raw_ast["base"], v_name, pts, base_env);
        let te = _eval_tendency_pts(raw_ast["exp"], v_name, pts, base_env);
        if tb["kind"] == "zero" and te["kind"] == "zero" {
            return map{ "indeterminate": true, "form": "0^0", "base_t": tb, "exp_t": te };
        }
        if tb["kind"] == "one" and _is_inf_tend(te) {
            return map{ "indeterminate": true, "form": "1^inf", "base_t": tb, "exp_t": te };
        }
        if _is_inf_tend(tb) and te["kind"] == "zero" {
            return map{ "indeterminate": true, "form": "inf^0", "base_t": tb, "exp_t": te };
        }
    }

    if k == "mul" {
        let has_z = false;
        let has_inf = false;
        let i = 0;
        while i < len(raw_ast["args"]) {
            let ti = _eval_tendency_pts(raw_ast["args"][i], v_name, pts, base_env);
            if ti["kind"] == "zero" { has_z = true; }
            if _is_inf_tend(ti) { has_inf = true; }
            i = i + 1;
        }
        if has_z and has_inf {
            return map{ "indeterminate": true, "form": "0 * inf" };
        }
    }

    if k == "add" or k == "sub" {
        let terms = [];
        if k == "sub" { terms = [raw_ast["left"], ast_neg(raw_ast["right"])]; }
        else { terms = raw_ast["args"]; }
        let has_pinf = false;
        let has_ninf = false;
        let i = 0;
        while i < len(terms) {
            let ti = _eval_tendency_pts(terms[i], v_name, pts, base_env);
            if ti["kind"] == "+inf" { has_pinf = true; }
            if ti["kind"] == "-inf" { has_ninf = true; }
            i = i + 1;
        }
        if has_pinf and has_ninf {
            return map{ "indeterminate": true, "form": "inf - inf" };
        }
    }

    return nil;
}

fn analyze_indeterminacy(expr_str, env = nil) {
    let raw_ast = parse_math(expr_str);
    let expr_ascii = to_ascii(raw_ast);
    let fvs = free_vars(raw_ast);

    let v_name = nil;
    let target_mode = "static"; // "static" | "finite" | "+inf" | "-inf"
    let x0 = 0.0;
    let target_label = nil;
    let base_env = map{};

    if env != nil and type(env) == "map" {
        let ks = map_keys(env);
        if len(ks) > 0 {
            v_name = ks[0];
            let tv = env[v_name];
            let ki = 1;
            while ki < len(ks) {
                if type(env[ks[ki]]) == "number" or type(env[ks[ki]]) == "bigint" {
                    base_env[ks[ki]] = env[ks[ki]] * 1.0;
                }
                ki = ki + 1;
            }
            if type(tv) == "string" {
                let ts = str_lower(str_trim(tv));
                if ts == "inf" or ts == "+inf" or ts == "infinity" or ts == "+infinity" or ts == "∞" or ts == "+∞" {
                    target_mode = "+inf";
                    target_label = "+inf";
                } else if ts == "-inf" or ts == "-infinity" or ts == "-∞" {
                    target_mode = "-inf";
                    target_label = "-inf";
                } else {
                    let parsed_tv = eval_ast(parse_math(tv), map{});
                    x0 = 0.0;
                    if parsed_tv != nil { x0 = parsed_tv * 1.0; }
                    target_mode = "finite";
                    target_label = x0;
                }
            } else if type(tv) == "number" or type(tv) == "bigint" {
                x0 = tv * 1.0;
                target_mode = "finite";
                target_label = tv;
            }
        }
    } else if env != nil and (type(env) == "number" or type(env) == "bigint") {
        if len(fvs) > 0 { v_name = fvs[0]; } else { v_name = "x"; }
        x0 = env * 1.0;
        target_mode = "finite";
        target_label = env;
    } else {
        // Auto-detect literal `inf` symbol (e.g. "1^inf", "inf - inf", "0 * inf") or default x -> 0
        let has_inf_sym = false;
        let i = 0;
        while i < len(fvs) {
            if fvs[i] == "inf" { has_inf_sym = true; }
            i = i + 1;
        }
        if has_inf_sym {
            v_name = "inf";
            target_mode = "+inf";
            target_label = "+inf";
        } else if len(fvs) > 0 {
            v_name = fvs[0];
            x0 = 0.0;
            target_mode = "finite";
            target_label = 0;
        }
    }

    let pts_right = [];
    let pts_left = [];
    if target_mode == "+inf" {
        pts_right = [10000.0, 1000000.0, 100000000.0];
    } else if target_mode == "-inf" {
        pts_right = [-10000.0, -1000000.0, -100000000.0];
    } else if target_mode == "finite" {
        pts_right = [x0 + 0.001, x0 + 0.00001, x0 + 0.0000001];
        pts_left = [x0 - 0.001, x0 - 0.00001, x0 - 0.0000001];
    }

    let cls = _classify_ast_on_pts(raw_ast, v_name, pts_right, base_env);
    if cls == nil and len(pts_left) > 0 {
        cls = _classify_ast_on_pts(raw_ast, v_name, pts_left, base_env);
    }

    if cls != nil and cls["indeterminate"] {
        let fm = cls["form"];
        let meta = _indet_metadata(fm);
        let lat = GOV.indeterminate(meta["lattice_form"], expr_ascii, "analytic");
        let out_ind = map{
            "ok": true,
            "input": str(expr_str),
            "expression": expr_ascii,
            "var": v_name,
            "point": target_label,
            "indeterminate": true,
            "form": fm,
            "lattice_form": meta["lattice_form"],
            "meaning_el": meta["meaning_el"],
            "meaning_en": meta["meaning_en"],
            "suggested_resolution": meta["suggested_resolution"],
            "governor_lattice": lat
        };
        if map_has(cls, "num_t") {
            out_ind["numerator_limit"] = cls["num_t"]["label"];
            out_ind["denominator_limit"] = cls["den_t"]["label"];
        }
        return out_ind;
    }

    // Check pole singularity (e.g. 1/x at x = 0, tan(pi/2), etc.)
    let right_whole = _eval_tendency_pts(raw_ast, v_name, pts_right, base_env);
    let left_whole = right_whole;
    if len(pts_left) > 0 {
        left_whole = _eval_tendency_pts(raw_ast, v_name, pts_left, base_env);
    }
    if (cls != nil and cls["form"] == "pole_singularity")
        or (target_mode == "finite" and (_is_inf_tend(right_whole) or _is_inf_tend(left_whole))) {
        let two_sided_lbl = "does_not_exist_jump_infinity";
        if left_whole["label"] == right_whole["label"] {
            two_sided_lbl = right_whole["label"];
        }
        let out_pole = map{
            "ok": true,
            "input": str(expr_str),
            "expression": expr_ascii,
            "var": v_name,
            "point": target_label,
            "indeterminate": false,
            "form": "pole_singularity",
            "left_limit": left_whole["label"],
            "right_limit": right_whole["label"],
            "two_sided_limit": two_sided_lbl,
            "meaning_el": "Πόλος / Ασυμπτωτική απειρία (μη απροσδιόριστη μορφή c/0 με c ≠ 0)",
            "meaning_en": "Determinate pole / infinite asymptotic singularity (c/0 with c != 0)",
            "suggested_resolution": "evaluate_one_sided_limits"
        };
        if cls != nil and map_has(cls, "num_t") {
            out_pole["numerator_limit"] = cls["num_t"]["label"];
            out_pole["denominator_limit"] = cls["den_t"]["label"];
        }
        return out_pole;
    }

    return map{
        "ok": true,
        "input": str(expr_str),
        "expression": expr_ascii,
        "var": v_name,
        "point": target_label,
        "indeterminate": false,
        "form": "determinate",
        "value": right_whole["label"],
        "left_limit": left_whole["label"],
        "right_limit": right_whole["label"],
        "meaning_el": "Ορισμένη / Προσδιορισμένη τιμή",
        "meaning_en": "Determinate expression value"
    };
}

// ── Crisp Self-Contained Vector SVG Plotter (`plot_svg`) ──────────────────────

fn svg_escape(raw) {
    let s = str(raw);
    s = str_replace_all(s, "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    s = str_replace_all(s, "\"", "&quot;");
    s = str_replace_all(s, "'", "&#39;");
    return s;
}

fn _nice_tick_step(span) {
    if span <= 0.0 { return 1.0; }
    let raw = span / 8.0;
    let exp10 = num_pow(10.0, num_floor(num_ln(raw) / num_ln(10.0)));
    let frac = raw / exp10;
    if frac < 1.5 { return 1.0 * exp10; }
    if frac < 3.5 { return 2.0 * exp10; }
    if frac < 7.5 { return 5.0 * exp10; }
    return 10.0 * exp10;
}

fn _sort_floats(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) { push(out, arr[i]); i = i + 1; }
    let n = len(out);
    let a = 1;
    while a < n {
        let kv = out[a];
        let b = a - 1;
        while b >= 0 and out[b] > kv {
            out[b + 1] = out[b];
            b = b - 1;
        }
        out[b + 1] = kv;
        a = a + 1;
    }
    return out;
}

fn plot_svg_report(expr_or_list, xmin = -10, xmax = 10, opts = nil) {
    if opts == nil { opts = map{}; }
    if xmin >= xmax { throw "plot_svg: xmin must be strictly less than xmax"; }
    let x_lo = xmin * 1.0;
    let x_hi = xmax * 1.0;

    let raw_list = [];
    if type(expr_or_list) == "array" {
        let i = 0;
        while i < len(expr_or_list) { push(raw_list, expr_or_list[i]); i = i + 1; }
    } else {
        push(raw_list, expr_or_list);
    }
    if len(raw_list) == 0 { throw "plot_svg: empty expression list"; }
    if len(raw_list) > 12 { throw "plot_svg: maximum 12 series supported"; }

    let palette = ["#2563eb", "#dc2626", "#16a34a", "#9333ea", "#ea580c", "#0891b2"];
    let w = 720.0;
    let h = 440.0;
    let pad_l = 58.0;
    let pad_r = 28.0;
    let pad_t = 32.0;
    let pad_b = 46.0;
    let pw = w - pad_l - pad_r;
    let ph = h - pad_t - pad_b;

    let series = [];
    let all_valid_y = [];
    let n_samples = 480;
    if map_has(opts, "samples") and opts["samples"] >= 64 and opts["samples"] <= 2000 {
        n_samples = opts["samples"];
    }

    let si = 0;
    while si < len(raw_list) {
        let ast = parse_math(raw_list[si]);
        let fvs = free_vars(ast);
        let v_plot = "x";
        if len(fvs) > 0 { v_plot = fvs[0]; }
        let plot_expr = ast;
        let is_ineq = false;
        let ineq_ivs = [];
        let roots = [];
        let poles = [];

        if ast["kind"] == "rel" {
            plot_expr = ast_sub(ast["lhs"], ast["rhs"]);
            if ast["op"] != "=" {
                is_ineq = true;
                let ineq_sol = try solve(ast, v_plot) catch nil;
                if ineq_sol != nil and map_has(ineq_sol, "intervals") {
                    ineq_ivs = ineq_sol["intervals"];
                }
            }
        }
        // Find roots and poles within [x_lo, x_hi] for highlighting!
        let eq_sol = try solve(ast_rel("=", plot_expr, RAT_ZERO), v_plot) catch nil;
        if eq_sol != nil {
            if map_has(eq_sol, "values") {
                let ri = 0;
                while ri < len(eq_sol["values"]) {
                    let rv = eq_sol["values"][ri];
                    if rv >= x_lo and rv <= x_hi { push(roots, rv); }
                    ri = ri + 1;
                }
            }
            if map_has(eq_sol, "excluded_poles") {
                let pi = 0;
                while pi < len(eq_sol["excluded_poles"]) {
                    let pv = eq_sol["excluded_poles"][pi];
                    if pv >= x_lo and pv <= x_hi { push(poles, pv); }
                    pi = pi + 1;
                }
            }
        }
        // Also detect denominator poles even when numerator doesn't vanish there (e.g. 1/(x - 1))!
        let nd_p = try to_rational_nd(plot_expr, nil) catch nil;
        if nd_p != nil and not is_one_node(nd_p["den"]) {
            let den_sol = try solve(ast_rel("=", nd_p["den"], RAT_ZERO), v_plot) catch nil;
            if den_sol != nil and map_has(den_sol, "values") {
                let di = 0;
                while di < len(den_sol["values"]) {
                    let pv = den_sol["values"][di];
                    if pv >= x_lo and pv <= x_hi { push(poles, pv); }
                    di = di + 1;
                }
            }
        }

        let xs = [];
        let ys = [];
        let k = 0;
        while k <= n_samples {
            let xk = x_lo + ((x_hi - x_lo) * k) / n_samples;
            let yk = eval_ast(plot_expr, _env1(v_plot, xk));
            push(xs, xk);
            push(ys, yk);
            if yk != nil and num_abs(yk) < 1000000.0 {
                push(all_valid_y, yk);
            }
            k = k + 1;
        }
        push(series, map{
            "label": to_unicode(ast),
            "color": palette[si - num_floor(si / len(palette)) * len(palette)],
            "xs": xs,
            "ys": ys,
            "roots": roots,
            "poles": poles,
            "is_ineq": is_ineq,
            "intervals": ineq_ivs
        });
        si = si + 1;
    }

    // Robust y-range computation (clips asymptotic spikes cleanly via 5th-95th percentile when needed)
    let y_lo = -10.0;
    let y_hi = 10.0;
    if map_has(opts, "ymin") and map_has(opts, "ymax") and opts["ymin"] < opts["ymax"] {
        y_lo = opts["ymin"] * 1.0;
        y_hi = opts["ymax"] * 1.0;
    } else if len(all_valid_y) > 4 {
        let sy = _sort_floats(all_valid_y);
        let ny = len(sy);
        let min_all = sy[0];
        let max_all = sy[ny - 1];
        let p05 = sy[num_floor(ny * 0.05)];
        let p95 = sy[num_floor(ny * 0.95)];
        // If extreme values are > 4x wider than 5th..95th range, clamp to robust asymptotic window!
        let core_span = _max_num(1.0, p95 - p05);
        if (max_all - min_all) > core_span * 5.0 {
            y_lo = p05 - 0.35 * core_span;
            y_hi = p95 + 0.35 * core_span;
        } else {
            let span0 = _max_num(1.0, max_all - min_all);
            y_lo = min_all - 0.12 * span0;
            y_hi = max_all + 0.12 * span0;
        }
        // Always include y=0 if reasonably close so roots & shaded intervals are visible
        if y_lo > 0.0 and y_lo < (y_hi - y_lo) { y_lo = -0.1 * (y_hi - y_lo); }
        if y_hi < 0.0 and (0.0 - y_hi) < (y_hi - y_lo) { y_hi = 0.1 * (y_hi - y_lo); }
    }
    if num_abs(y_hi - y_lo) < 0.000001 { y_lo = y_lo - 1.0; y_hi = y_hi + 1.0; }
    let y_span = y_hi - y_lo;
    let x_span = x_hi - x_lo;

    let svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 440\" width=\"720\" height=\"440\" role=\"img\" aria-label=\"Symbolic CAS Plot\">";
    svg = svg + "<defs><clipPath id=\"cas-plot-clip\"><rect x=\"" + fmt_float(pad_l, 2) + "\" y=\"" + fmt_float(pad_t, 2) + "\" width=\"" + fmt_float(pw, 2) + "\" height=\"" + fmt_float(ph, 2) + "\"/></clipPath></defs>";
    svg = svg + "<rect x=\"0\" y=\"0\" width=\"720\" height=\"440\" rx=\"10\" fill=\"#ffffff\" stroke=\"#e2e8f0\" stroke-width=\"1.5\"/>";
    svg = svg + "<rect x=\"" + fmt_float(pad_l, 2) + "\" y=\"" + fmt_float(pad_t, 2) + "\" width=\"" + fmt_float(pw, 2) + "\" height=\"" + fmt_float(ph, 2) + "\" fill=\"#f8fafc\" stroke=\"#cbd5e1\" stroke-width=\"1\"/>";

    // Coordinate Grid & Tick Labels
    let x_step = _nice_tick_step(x_span);
    let y_step = _nice_tick_step(y_span);

    let y_axis_px = pad_t + ph - ((0.0 - y_lo) / y_span) * ph;
    let y_axis_clamped = _clamp_num(y_axis_px, pad_t, pad_t + ph);
    let x_axis_px = pad_l + ((0.0 - x_lo) / x_span) * pw;
    let x_axis_clamped = _clamp_num(x_axis_px, pad_l, pad_l + pw);

    let tx = num_ceil(x_lo / x_step) * x_step;
    let g_guard = 0;
    while tx <= x_hi + 0.0000001 and g_guard < 64 {
        let px = pad_l + ((tx - x_lo) / x_span) * pw;
        svg = svg + "<line x1=\"" + fmt_float(px, 2) + "\" y1=\"" + fmt_float(pad_t, 2) + "\" x2=\"" + fmt_float(px, 2) + "\" y2=\"" + fmt_float(pad_t + ph, 2) + "\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>";
        svg = svg + "<text x=\"" + fmt_float(px, 2) + "\" y=\"" + fmt_float(pad_t + ph + 18.0, 2) + "\" text-anchor=\"middle\" font-family=\"system-ui, sans-serif\" font-size=\"11\" fill=\"#475569\">" + svg_escape(fmt_float(tx, 4)) + "</text>";
        tx = tx + x_step;
        g_guard = g_guard + 1;
    }

    let ty = num_ceil(y_lo / y_step) * y_step;
    g_guard = 0;
    while ty <= y_hi + 0.0000001 and g_guard < 64 {
        let py = pad_t + ph - ((ty - y_lo) / y_span) * ph;
        svg = svg + "<line x1=\"" + fmt_float(pad_l, 2) + "\" y1=\"" + fmt_float(py, 2) + "\" x2=\"" + fmt_float(pad_l + pw, 2) + "\" y2=\"" + fmt_float(py, 2) + "\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>";
        svg = svg + "<text x=\"" + fmt_float(pad_l - 8.0, 2) + "\" y=\"" + fmt_float(py + 4.0, 2) + "\" text-anchor=\"end\" font-family=\"system-ui, sans-serif\" font-size=\"11\" fill=\"#475569\">" + svg_escape(fmt_float(ty, 4)) + "</text>";
        ty = ty + y_step;
        g_guard = g_guard + 1;
    }

    // Principal x=0 and y=0 Axes
    if 0.0 >= y_lo and 0.0 <= y_hi {
        svg = svg + "<line x1=\"" + fmt_float(pad_l, 2) + "\" y1=\"" + fmt_float(y_axis_px, 2) + "\" x2=\"" + fmt_float(pad_l + pw, 2) + "\" y2=\"" + fmt_float(y_axis_px, 2) + "\" stroke=\"#334155\" stroke-width=\"1.5\"/>";
    }
    if 0.0 >= x_lo and 0.0 <= x_hi {
        svg = svg + "<line x1=\"" + fmt_float(x_axis_px, 2) + "\" y1=\"" + fmt_float(pad_t, 2) + "\" x2=\"" + fmt_float(x_axis_px, 2) + "\" y2=\"" + fmt_float(pad_t + ph, 2) + "\" stroke=\"#334155\" stroke-width=\"1.5\"/>";
    }

    // Clipped plot layer: inequality shading, vertical asymptote lines, and asymptote-split polylines!
    svg = svg + "<g clip-path=\"url(#cas-plot-clip)\">";
    si = 0;
    while si < len(series) {
        let sr = series[si];
        let col = sr["color"];

        // Shaded inequality feasible intervals along x-axis!
        if sr["is_ineq"] {
            let ii = 0;
            while ii < len(sr["intervals"]) {
                let iv = sr["intervals"][ii];
                let a_x = x_lo;
                if not iv["lo_inf"] { a_x = _max_num(x_lo, iv["lo"]); }
                let b_x = x_hi;
                if not iv["hi_inf"] { b_x = _min_num(x_hi, iv["hi"]); }
                if b_x >= a_x {
                    let px1 = pad_l + ((a_x - x_lo) / x_span) * pw;
                    let px2 = pad_l + ((b_x - x_lo) / x_span) * pw;
                    svg = svg + "<rect x=\"" + fmt_float(px1, 2) + "\" y=\"" + fmt_float(y_axis_clamped - 8.0, 2) + "\" width=\"" + fmt_float(_max_num(2.0, px2 - px1), 2) + "\" height=\"16\" fill=\"" + col + "\" fill-opacity=\"0.22\"/>";
                    svg = svg + "<line x1=\"" + fmt_float(px1, 2) + "\" y1=\"" + fmt_float(y_axis_clamped, 2) + "\" x2=\"" + fmt_float(px2, 2) + "\" y2=\"" + fmt_float(y_axis_clamped, 2) + "\" stroke=\"" + col + "\" stroke-width=\"4\" stroke-opacity=\"0.65\"/>";
                }
                ii = ii + 1;
            }
        }

        // Dashed vertical asymptotes at poles
        let pi = 0;
        while pi < len(sr["poles"]) {
            let p_px = pad_l + ((sr["poles"][pi] - x_lo) / x_span) * pw;
            svg = svg + "<line x1=\"" + fmt_float(p_px, 2) + "\" y1=\"" + fmt_float(pad_t, 2) + "\" x2=\"" + fmt_float(p_px, 2) + "\" y2=\"" + fmt_float(pad_t + ph, 2) + "\" stroke=\"#94a3b8\" stroke-width=\"1.2\" stroke-dasharray=\"5,4\"/>";
            pi = pi + 1;
        }

        // Asymptote-splitting polyline builder!
        let cur_pts = "";
        let cur_cnt = 0;
        let prev_y = nil;
        let prev_x = nil;
        let k = 0;
        while k < len(sr["xs"]) {
            let xk = sr["xs"][k];
            let yk = sr["ys"][k];
            let valid_pt = (yk != nil and yk >= (y_lo - y_span * 1.5) and yk <= (y_hi + y_span * 1.5));
            // Split if segment crosses a known pole OR jumps violently with opposite signs across an asymptote!
            let crossed_pole = false;
            if valid_pt and prev_y != nil {
                let p_idx = 0;
                while p_idx < len(sr["poles"]) {
                    let pv = sr["poles"][p_idx];
                    if prev_x <= pv and xk >= pv { crossed_pole = true; break; }
                    p_idx = p_idx + 1;
                }
                if not crossed_pole and ((prev_y < 0.0 and yk > 0.0) or (prev_y > 0.0 and yk < 0.0)) and num_abs(yk - prev_y) > 0.65 * y_span {
                    crossed_pole = true;
                }
            }
            if not valid_pt or crossed_pole {
                if cur_cnt >= 2 {
                    svg = svg + "<polyline fill=\"none\" stroke=\"" + col + "\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" points=\"" + cur_pts + "\"/>";
                }
                cur_pts = "";
                cur_cnt = 0;
                prev_y = nil;
                prev_x = nil;
            }
            if valid_pt {
                let px = pad_l + ((xk - x_lo) / x_span) * pw;
                let py = pad_t + ph - ((yk - y_lo) / y_span) * ph;
                if cur_cnt > 0 { cur_pts = cur_pts + " "; }
                cur_pts = cur_pts + fmt_float(px, 2) + "," + fmt_float(py, 2);
                cur_cnt = cur_cnt + 1;
                prev_y = yk;
                prev_x = xk;
            }
            k = k + 1;
        }
        if cur_cnt >= 2 {
            svg = svg + "<polyline fill=\"none\" stroke=\"" + col + "\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" points=\"" + cur_pts + "\"/>";
        }

        // Highlighted solid root dots on x-axis
        let ri = 0;
        while ri < len(sr["roots"]) {
            let rx = pad_l + ((sr["roots"][ri] - x_lo) / x_span) * pw;
            svg = svg + "<circle class=\"cas-root\" cx=\"" + fmt_float(rx, 2) + "\" cy=\"" + fmt_float(y_axis_clamped, 2) + "\" r=\"4.5\" fill=\"" + col + "\" stroke=\"#ffffff\" stroke-width=\"1.5\"/>";
            ri = ri + 1;
        }

        // Highlighted hollow circles at excluded poles on x-axis
        pi = 0;
        while pi < len(sr["poles"]) {
            let px = pad_l + ((sr["poles"][pi] - x_lo) / x_span) * pw;
            svg = svg + "<circle class=\"cas-pole\" cx=\"" + fmt_float(px, 2) + "\" cy=\"" + fmt_float(y_axis_clamped, 2) + "\" r=\"5\" fill=\"#ffffff\" stroke=\"" + col + "\" stroke-width=\"2\"/>";
            pi = pi + 1;
        }
        si = si + 1;
    }
    svg = svg + "</g>";

    // Legend Box (XML-escaped against XSS!)
    let leg_x = pad_l + 12.0;
    let leg_y = pad_t + 10.0;
    let leg_h = len(series) * 20.0 + 10.0;
    svg = svg + "<rect x=\"" + fmt_float(leg_x, 2) + "\" y=\"" + fmt_float(leg_y, 2) + "\" width=\"220\" height=\"" + fmt_float(leg_h, 2) + "\" rx=\"6\" fill=\"#ffffff\" fill-opacity=\"0.9\" stroke=\"#cbd5e1\" stroke-width=\"1\"/>";
    si = 0;
    while si < len(series) {
        let row_y = leg_y + 16.0 + si * 20.0;
        let sr = series[si];
        let lbl = sr["label"];
        if map_has(opts, "title") and opts["title"] != nil and len(series) == 1 { lbl = opts["title"]; }
        svg = svg + "<line x1=\"" + fmt_float(leg_x + 10.0, 2) + "\" y1=\"" + fmt_float(row_y - 4.0, 2) + "\" x2=\"" + fmt_float(leg_x + 28.0, 2) + "\" y2=\"" + fmt_float(row_y - 4.0, 2) + "\" stroke=\"" + sr["color"] + "\" stroke-width=\"2.5\"/>";
        svg = svg + "<text x=\"" + fmt_float(leg_x + 34.0, 2) + "\" y=\"" + fmt_float(row_y, 2) + "\" font-family=\"system-ui, sans-serif\" font-size=\"12\" fill=\"#1e293b\">" + svg_escape(lbl) + "</text>";
        si = si + 1;
    }
    if map_has(opts, "title") and opts["title"] != nil and str(opts["title"]) != "" {
        svg = svg + "<text x=\"" + fmt_float(w / 2.0, 2) + "\" y=\"20\" text-anchor=\"middle\" font-family=\"system-ui, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0f172a\">" + svg_escape(str(opts["title"])) + "</text>";
    }
    svg = svg + "</svg>";

    return map{
        "ok": true,
        "svg": svg,
        "bounds": map{ "xmin": x_lo, "xmax": x_hi, "ymin": y_lo, "ymax": y_hi },
        "series_count": len(series)
    };
}

fn plot_svg(expr_or_list, xmin = -10, xmax = 10, opts = nil) {
    let rep = plot_svg_report(expr_or_list, xmin, xmax, opts);
    return rep["svg"];
}

// ── User-Defined Custom Function Registry & Symbolic Composition Engine ──────

fn _ast_calls_fn(node, target_nm) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return false; }
    let k = node["kind"];
    if k == "call" {
        let pf = _parse_prime_fn_name(node["fn_name"]);
        if node["fn_name"] == target_nm or pf["base"] == target_nm { return true; }
        let i = 0;
        while i < len(node["args"]) {
            if _ast_calls_fn(node["args"][i], target_nm) { return true; }
            i = i + 1;
        }
        return false;
    }
    if k == "neg" { return _ast_calls_fn(node["arg"], target_nm); }
    if k == "sub" { return _ast_calls_fn(node["left"], target_nm) or _ast_calls_fn(node["right"], target_nm); }
    if k == "div" { return _ast_calls_fn(node["num"], target_nm) or _ast_calls_fn(node["den"], target_nm); }
    if k == "pow" { return _ast_calls_fn(node["base"], target_nm) or _ast_calls_fn(node["exp"], target_nm); }
    if k == "rel" { return _ast_calls_fn(node["lhs"], target_nm) or _ast_calls_fn(node["rhs"], target_nm); }
    if k == "add" or k == "mul" {
        let i = 0;
        while i < len(node["args"]) {
            if _ast_calls_fn(node["args"][i], target_nm) { return true; }
            i = i + 1;
        }
    }
    return false;
}

fn _contains_user_or_prime_call(node) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return false; }
    let k = node["kind"];
    if k == "call" {
        let pf = _parse_prime_fn_name(node["fn_name"]);
        if pf["order"] > 0 or map_has(_USER_FUNCS, node["fn_name"]) { return true; }
        let i = 0;
        while i < len(node["args"]) {
            if _contains_user_or_prime_call(node["args"][i]) { return true; }
            i = i + 1;
        }
        return false;
    }
    if k == "neg" { return _contains_user_or_prime_call(node["arg"]); }
    if k == "sub" { return _contains_user_or_prime_call(node["left"]) or _contains_user_or_prime_call(node["right"]); }
    if k == "div" { return _contains_user_or_prime_call(node["num"]) or _contains_user_or_prime_call(node["den"]); }
    if k == "pow" { return _contains_user_or_prime_call(node["base"]) or _contains_user_or_prime_call(node["exp"]); }
    if k == "rel" { return _contains_user_or_prime_call(node["lhs"]) or _contains_user_or_prime_call(node["rhs"]); }
    if k == "chain_rel" {
        let i = 0;
        while i < len(node["parts"]) {
            if _contains_user_or_prime_call(node["parts"][i]) { return true; }
            i = i + 1;
        }
        return false;
    }
    if k == "system" {
        let i = 0;
        while i < len(node["items"]) {
            if _contains_user_or_prime_call(node["items"][i]) { return true; }
            i = i + 1;
        }
        return false;
    }
    if k == "add" or k == "mul" {
        let i = 0;
        while i < len(node["args"]) {
            if _contains_user_or_prime_call(node["args"][i]) { return true; }
            i = i + 1;
        }
    }
    return false;
}

fn expand_user_functions(node, depth = 0) {
    if node == nil or type(node) != "map" or not map_has(node, "kind") { return node; }
    if depth > 24 {
        throw "MathGovernor[symbolic_cas]: cyclic or excessive custom function expansion depth (> 24)";
    }
    let k = node["kind"];
    if k == "rat" or k == "num" or k == "sym" { return node; }
    if k == "neg" { return ast_neg(expand_user_functions(node["arg"], depth)); }
    if k == "sub" { return ast_sub(expand_user_functions(node["left"], depth), expand_user_functions(node["right"], depth)); }
    if k == "div" { return ast_div(expand_user_functions(node["num"], depth), expand_user_functions(node["den"], depth)); }
    if k == "pow" { return ast_pow(expand_user_functions(node["base"], depth), expand_user_functions(node["exp"], depth)); }
    if k == "rel" { return ast_rel(node["op"], expand_user_functions(node["lhs"], depth), expand_user_functions(node["rhs"], depth)); }
    if k == "chain_rel" {
        let pts = [];
        let i = 0;
        while i < len(node["parts"]) { push(pts, expand_user_functions(node["parts"][i], depth)); i = i + 1; }
        return map{ "kind": "chain_rel", "parts": pts };
    }
    if k == "system" {
        let items = [];
        let i = 0;
        while i < len(node["items"]) { push(items, expand_user_functions(node["items"][i], depth)); i = i + 1; }
        return map{ "kind": "system", "items": items };
    }
    if k == "add" or k == "mul" {
        let out = [];
        let i = 0;
        while i < len(node["args"]) { push(out, expand_user_functions(node["args"][i], depth)); i = i + 1; }
        return map{ "kind": k, "args": out };
    }
    if k == "call" {
        let exp_args = [];
        let i = 0;
        while i < len(node["args"]) {
            push(exp_args, expand_user_functions(node["args"][i], depth));
            i = i + 1;
        }
        let fn_nm = node["fn_name"];
        let pf = _parse_prime_fn_name(fn_nm);
        let b_nm = pf["base"];
        let d_ord = pf["order"];
        if map_has(_USER_FUNCS, b_nm) {
            let uf = _USER_FUNCS[b_nm];
            if uf["is_piecewise_rec"] {
                return ast_call(fn_nm, exp_args);
            }
            let p_names = uf["params"];
            if len(p_names) == len(exp_args) {
                let target_body = uf["body_ast"];
                if d_ord > 0 and len(p_names) > 0 {
                    let oi = 0;
                    while oi < d_ord {
                        target_body = diff_ast(target_body, p_names[0]);
                        oi = oi + 1;
                    }
                }
                let sub_m = map{};
                let pi = 0;
                while pi < len(p_names) {
                    sub_m[p_names[pi]] = exp_args[pi];
                    pi = pi + 1;
                }
                let inlined = subst_ast(target_body, sub_m);
                let expanded_inner = expand_user_functions(inlined, depth + 1);
                check_ast_bounds(expanded_inner);
                return expanded_inner;
            }
        } else if d_ord > 0 and _is_known_func(b_nm) and len(exp_args) == 1 {
            let cur_d = ast_call(b_nm, [ast_sym("__p0")]);
            let oi = 0;
            while oi < d_ord {
                cur_d = diff_ast(cur_d, "__p0");
                oi = oi + 1;
            }
            return subst_ast(cur_d, map{ "__p0": exp_args[0] });
        }
        return ast_call(fn_nm, exp_args);
    }
    return node;
}

fn _invalidate_user_func_caches() {
    let ks = map_keys(_USER_FUNCS);
    let i = 0;
    while i < len(ks) {
        let e = _USER_FUNCS[ks[i]];
        e["d1_ast"] = nil;
        e["d2_ast"] = nil;
        e["d3_ast"] = nil;
        e["d4_ast"] = nil;
        i = i + 1;
    }
}

fn define_function(def_or_name, params_opt = nil, body_opt = nil) {
    let fn_nm = "";
    let params = [];
    let rhs_str = "";

    if body_opt != nil {
        fn_nm = str_trim(str(def_or_name));
        if type(params_opt) == "array" {
            let i = 0;
            while i < len(params_opt) { push(params, str_trim(str(params_opt[i]))); i = i + 1; }
        } else if type(params_opt) == "string" and str_trim(params_opt) != "" {
            let sp = str_split(params_opt, ",");
            let i = 0;
            while i < len(sp) { push(params, str_trim(sp[i])); i = i + 1; }
        }
        rhs_str = str_trim(str(body_opt));
    } else {
        let s = str_trim(str(def_or_name));
        // Split on top-level ':=' or '=' (outside parentheses so piecewise(x <= 0, ...) on RHS is untouched!)
        let eq_pos = -1;
        let eq_len = 1;
        let p_depth = 0;
        let idx = 0;
        while idx < len(s) {
            let ch = str_slice(s, idx, idx + 1);
            if ch == "(" or ch == "[" { p_depth = p_depth + 1; }
            else if ch == ")" or ch == "]" { if p_depth > 0 { p_depth = p_depth - 1; } }
            else if p_depth == 0 {
                if idx + 1 < len(s) and str_slice(s, idx, idx + 2) == ":=" {
                    eq_pos = idx;
                    eq_len = 2;
                    break;
                }
                if ch == "=" {
                    let prev_c = if idx > 0 { str_slice(s, idx - 1, idx) } else { "" };
                    let next_c = if idx + 1 < len(s) { str_slice(s, idx + 1, idx + 2) } else { "" };
                    if prev_c != "<" and prev_c != ">" and prev_c != "!" and prev_c != "=" and next_c != "=" {
                        eq_pos = idx;
                        eq_len = 1;
                        break;
                    }
                }
            }
            idx = idx + 1;
        }
        if eq_pos <= 0 {
            throw "define_function: expected 'name(p1, ...) = expression', got '" + s + "'";
        }
        let lhs_sig = str_trim(str_slice(s, 0, eq_pos));
        rhs_str = str_trim(str_slice(s, eq_pos + eq_len, len(s)));
        let lp = str_index_of(lhs_sig, "(");
        let rp = len(lhs_sig) - 1;
        if lp <= 0 or str_slice(lhs_sig, rp, rp + 1) != ")" {
            throw "define_function: invalid signature '" + lhs_sig + "' (expected f(x) or g(x, y))";
        }
        fn_nm = str_trim(str_slice(lhs_sig, 0, lp));
        let p_inner = str_trim(str_slice(lhs_sig, lp + 1, rp));
        if p_inner != "" {
            let raw_ps = str_split(p_inner, ",");
            let pi = 0;
            while pi < len(raw_ps) {
                let pn = str_trim(raw_ps[pi]);
                if pn == "" { throw "define_function: empty parameter name in '" + lhs_sig + "'"; }
                push(params, pn);
                pi = pi + 1;
            }
        }
    }

    if fn_nm == "" or is_const_sym(fn_nm) or _is_known_func(fn_nm) {
        throw "define_function: cannot redefine reserved math symbol or built-in function '" + fn_nm + "'";
    }

    let had_prev = map_has(_USER_FUNCS, fn_nm);
    let prev_entry = if had_prev { _USER_FUNCS[fn_nm] } else { nil };

    // Register placeholder so self-recursive piecewise functions parse self-calls cleanly!
    _USER_FUNCS[fn_nm] = map{
        "name": fn_nm,
        "params": params,
        "body_str": rhs_str,
        "body_ast": RAT_ZERO,
        "is_piecewise_rec": false,
        "d1_ast": nil,
        "d2_ast": nil
    };

    let body_ast = try parse_math(rhs_str) catch err {
        if had_prev { _USER_FUNCS[fn_nm] = prev_entry; }
        else { map_remove(_USER_FUNCS, fn_nm); }
        throw err;
    };

    let self_rec = _ast_calls_fn(body_ast, fn_nm);
    let has_pw = _ast_calls_fn(body_ast, "piecewise");
    let entry = map{
        "ok": true,
        "name": fn_nm,
        "params": params,
        "signature": fn_nm + "(" + str_replace_all(str_replace_all(str_replace_all(json_stringify(params), "[", ""), "]", ""), "\"", "") + ")",
        "body_str": rhs_str,
        "body_ast": body_ast,
        "ascii": to_ascii(body_ast),
        "unicode": to_unicode(body_ast),
        "latex": to_latex(body_ast),
        "is_recursive": self_rec,
        "is_piecewise_rec": self_rec and has_pw,
        "d1_ast": nil,
        "d2_ast": nil
    };
    _USER_FUNCS[fn_nm] = entry;
    _invalidate_user_func_caches();
    return entry;
}

fn undefine_function(fn_nm) {
    let nm = str_trim(str(fn_nm));
    if map_has(_USER_FUNCS, nm) {
        map_remove(_USER_FUNCS, nm);
        _invalidate_user_func_caches();
        return true;
    }
    return false;
}

fn clear_functions() {
    _USER_FUNCS = map{};
    return true;
}

fn get_function(fn_nm) {
    let nm = str_trim(str(fn_nm));
    if map_has(_USER_FUNCS, nm) { return _USER_FUNCS[nm]; }
    return nil;
}

fn list_functions() {
    let ks = _sort_strings(map_keys(_USER_FUNCS));
    let out = [];
    let i = 0;
    while i < len(ks) {
        let uf = _USER_FUNCS[ks[i]];
        push(out, map{
            "name": uf["name"],
            "params": uf["params"],
            "body_str": uf["body_str"],
            "ascii": uf["ascii"],
            "unicode": uf["unicode"],
            "latex": uf["latex"],
            "is_recursive": uf["is_recursive"]
        });
        i = i + 1;
    }
    return out;
}

// Convenience top-level wrappers
fn simplify(input) { return transform(input, "simplify"); }
fn expand(input) { return transform(input, "expand"); }
fn factor(input) { return transform(input, "factor"); }
fn diff(input, v_name = "x") {
    let parsed = parse_math(input);
    let d_raw = diff_ast(parsed, v_name);
    if _contains_user_or_prime_call(d_raw) {
        d_raw = expand_user_functions(d_raw, 0);
    }
    let ctx = _new_ctx();
    let d_simp = simplify_node(d_raw, ctx);
    return map{
        "ok": true,
        "var": v_name,
        "ast": d_simp,
        "ascii": to_ascii(d_simp),
        "unicode": to_unicode(d_simp),
        "latex": to_latex(d_simp)
    };
}

export CAS_VERSION, MAX_INPUT_LEN, MAX_AST_DEPTH, MAX_AST_NODES, MAX_REWRITE_STEPS, MAX_EXPAND_DEGREE;
export rat, rat_add, rat_sub, rat_mul, rat_div, rat_neg, rat_pow_int, rat_cmp, rat_eq, rat_to_float, rat_to_str;
export normalize_math_text, parse_math, check_ast_bounds, free_vars, subst_ast, eval_ast, diff_ast, diff;
export define_function, undefine_function, clear_functions, get_function, list_functions, expand_user_functions;
export to_ascii, to_unicode, to_latex;
export simplify_node, to_rational_nd, rref_rat, poly_gcd, poly_factor_Q, solve_polynomial_all;
export transform, simplify, expand, factor, solve, solve_parametric, analyze_indeterminacy, plot_svg, plot_svg_report, svg_escape;

