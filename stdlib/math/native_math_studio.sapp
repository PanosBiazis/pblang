// ============================================================================
// 2. Exact Greek Statistical Engine & SVG Concept Dashboard (`960x1180`)
// ============================================================================

fn compute_statistical_summary(raw_values, is_sample = true, scale_k = 2.5, mean_shift = 0.0, spread_mult = 1.0) {
    let base_vals = if is_array(raw_values) and len(raw_values) > 0 { raw_values } else { [13.0, 14.0, 15.0, 15.0, 16.0, 17.0] };
    let n = len(base_vals);
    let raw_sum = 0.0;
    let i = 0;
    while i < n { raw_sum = raw_sum + _num_or(base_vals[i], 0.0); i = i + 1; }
    let raw_mean = raw_sum / n;

    // Apply interactive mean_shift and spread_mult around raw_mean
    let vals = [];
    let sum_v = 0.0;
    i = 0;
    while i < n {
        let adjusted = (raw_mean + mean_shift) + (_num_or(base_vals[i], 0.0) - raw_mean) * spread_mult;
        array_push(vals, adjusted);
        sum_v = sum_v + adjusted;
        i = i + 1;
    }
    let mean_v = sum_v / n;
    let ss = 0.0;
    let rows = [];
    i = 0;
    while i < n {
        let xi = vals[i];
        let dev = xi - mean_v;
        let dev2 = dev * dev;
        ss = ss + dev2;
        array_push(rows, map{ idx: i + 1, xi: xi, dev: dev, dev2: dev2 });
        i = i + 1;
    }
    let denom = if is_sample and n > 1 { (n - 1) * 1.0 } else { _max(1.0, n * 1.0) };
    let variance = ss / denom;
    let sd = num_sqrt(_max(0.0, variance));
    let safe_mean = if _abs(mean_v) > 1e-9 { _abs(mean_v) } else { 1e-9 };
    let cv_raw = sd / safe_mean;
    let cv_pct = cv_raw * 100.0;
    let cv2_raw = cv_raw * cv_raw;
    let disp_d = variance / safe_mean;

    let k = if _abs(scale_k) > 1e-6 { scale_k } else { 1.0 };
    let ak = _abs(k);
    let after_cv = cv_raw;
    let after_cv2 = cv2_raw;
    let after_d = disp_d * ak;

    let hom_label = "● Ομοιογενές";
    let hom_tier = "emerald";
    if cv_pct >= 30.0 {
        hom_label = "● Ανομοιογενές";
        hom_tier = "coral";
    } else if cv_pct >= 15.0 {
        hom_label = "● Μέτρια Διασπορά";
        hom_tier = "amber";
    }

    i = 0;
    while i < len(rows) {
        rows[i].pct_ss = if ss > 1e-12 { (rows[i].dev2 / ss) * 100.0 } else { 0.0 };
        rows[i].z_score = if sd > 1e-12 { rows[i].dev / sd } else { 0.0 };
        i = i + 1;
    }

    return map{
        n: n,
        is_sample: is_sample,
        denom: denom,
        values: vals,
        mean: mean_v,
        ss: ss,
        variance: variance,
        sd: sd,
        cv_raw: cv_raw,
        cv_pct: cv_pct,
        cv2_raw: cv2_raw,
        dispersion_d: disp_d,
        scale_k: k,
        after_mean: mean_v * k,
        after_sd: sd * ak,
        after_cv: after_cv,
        after_cv2: after_cv2,
        after_d: after_d,
        homogeneity_badge: hom_label,
        homogeneity_tier: hom_tier,
        rows: rows
    };
}

// Renders the complete 960x1180 Obsidian-Dark Greek Statistical Concept Dashboard SVG
fn render_statistical_concept_svg(dataset_or_opts = nil) {
    let opts = map{};
    let vals_a = [13.0, 14.0, 15.0, 15.0, 16.0, 17.0];
    let vals_b = [10.0, 12.5, 15.0, 17.5, 20.0, 22.5];
    if is_array(dataset_or_opts) {
        vals_a = dataset_or_opts;
    } else if is_map(dataset_or_opts) {
        opts = dataset_or_opts;
        if map_has(opts, "values") and is_array(opts.values) { vals_a = opts.values; }
        if map_has(opts, "values_b") and is_array(opts.values_b) { vals_b = opts.values_b; }
    }

    let is_sample = _is_true(try opts.is_sample catch true);
    let scale_k = _num_or(try opts.scale_k catch 2.5, 2.5);
    let dark_mode = not _is_true(try opts.light_mode catch false);
    let w = _max(760, _int_or(try opts.width catch 960, 960));
    let h = _max(960, _int_or(try opts.height catch 1180, 1180));
    let th = if dark_mode { studio_theme_dark() } else { studio_theme_light() };
    let hx = th.hex;

    let st_a = compute_statistical_summary(vals_a, is_sample, scale_k, 0.0, 1.0);
    let st_b = compute_statistical_summary(vals_b, is_sample, scale_k, 0.0, 1.0);
    let esc = ODG.svg_escape;

    let badge_bg = hx.emerald_soft;
    let badge_fg = hx.emerald;
    if st_a.homogeneity_tier == "amber" { badge_bg = hx.amber_soft; badge_fg = hx.amber; }
    else if st_a.homogeneity_tier == "coral" { badge_bg = hx.coral_soft; badge_fg = hx.coral; }

    let mode_txt = if is_sample { "Δείγμα (n - 1 = " + _fmt(st_a.denom, 0) + ")" } else { "Πληθυσμός (N = " + str(st_a.n) + ")" };
    let title_str = esc(str(try opts.title catch "Στατιστική Ανάλυση Διασποράς, Κανονικής Κατανομής & Συντελεστή Μεταβλητότητας (CV%)"));

    let svg = [];
    array_push(svg, "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" font-family=\"system-ui, -apple-system, Segoe UI, Noto Sans, sans-serif\">");
    array_push(svg, "  <rect x=\"0\" y=\"0\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" fill=\"" + hx.bg + "\"/>");

    // 1. Header Bar
    array_push(svg, "  <rect x=\"20\" y=\"16\" width=\"" + str(w - 40) + "\" height=\"68\" rx=\"10\" fill=\"" + hx.header_bg + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"38\" y=\"44\" fill=\"" + hx.emerald + "\" font-size=\"18\" font-weight=\"700\">" + title_str + "</text>");
    array_push(svg, "  <text x=\"38\" y=\"68\" fill=\"" + hx.text_muted + "\" font-size=\"12\">Λειτουργία: " + esc(mode_txt) + "  •  Συντελεστής Κλίμακας k = " + _fmt(scale_k, 2) + "  •  CV = (s / |x̄|)·100% (Αδιάστατο) vs D = s²/x̄ (Εξαρτώμενο από τις μονάδες)</text>");
    array_push(svg, "  <rect x=\"" + str(w - 196) + "\" y=\"30\" width=\"160\" height=\"30\" rx=\"15\" fill=\"" + badge_bg + "\" stroke=\"" + badge_fg + "\"/>");
    array_push(svg, "  <text x=\"" + str(w - 116) + "\" y=\"50\" fill=\"" + badge_fg + "\" font-size=\"13\" font-weight=\"700\" text-anchor=\"middle\">" + esc(st_a.homogeneity_badge) + "</text>");

    // 2. Five KPI Cards Row (y = 98, h = 108)
    let kpi_y = 98;
    let kpi_gap = 12;
    let kpi_w = num_floor((w - 40 - 4 * kpi_gap) / 5);
    let kpis = [
        map{ title: "Μέση Τιμή (x̄)", val: _fmt(st_a.mean, 2), sub: "Εξαρτώμενο από τις μονάδες", col: hx.emerald },
        map{ title: "Άθροισμα Τετρ. (SS)", val: _fmt(st_a.ss, 2), sub: "Σ(xᵢ − x̄)² (n = " + str(st_a.n) + ")", col: hx.cyan },
        map{ title: "Διακύμανση s²", val: _fmt(st_a.variance, 2), sub: "Εξαρτώμενο από τις μονάδες²", col: hx.periwinkle },
        map{ title: "Τυπική Απόκλιση s", val: _fmt(st_a.sd, 2), sub: "Εξαρτώμενο από τις μονάδες", col: hx.amber },
        map{ title: "Μεταβλητότητα CV%", val: _fmt(st_a.cv_pct, 2) + "%", sub: st_a.homogeneity_badge + " (Αδιάστατο)", col: badge_fg }
    ];
    let ki = 0;
    while ki < 5 {
        let kx = 20 + ki * (kpi_w + kpi_gap);
        let kp = kpis[ki];
        array_push(svg, "  <rect x=\"" + str(kx) + "\" y=\"" + str(kpi_y) + "\" width=\"" + str(kpi_w) + "\" height=\"108\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
        array_push(svg, "  <text x=\"" + str(kx + 14) + "\" y=\"" + str(kpi_y + 26) + "\" fill=\"" + hx.text_muted + "\" font-size=\"12\">" + esc(kp.title) + "</text>");
        array_push(svg, "  <text x=\"" + str(kx + 14) + "\" y=\"" + str(kpi_y + 62) + "\" fill=\"" + kp.col + "\" font-size=\"24\" font-weight=\"700\">" + esc(kp.val) + "</text>");
        array_push(svg, "  <text x=\"" + str(kx + 14) + "\" y=\"" + str(kpi_y + 90) + "\" fill=\"" + hx.text_secondary + "\" font-size=\"11\">" + esc(kp.sub) + "</text>");
        ki = ki + 1;
    }

    // 3. Row 2: Left Card = Κατανομή Τιμών & Ζώνη Τυπικής Απόκλισης | Right Card = Κανονική Κατανομή Δείγματος Α & Β
    let row2_y = 222;
    let row2_h = 285;
    let half_w = num_floor((w - 56) / 2);

    // Card 3A: Κατανομή Τιμών & Ζώνη Τυπικής Απόκλισης
    array_push(svg, "  <rect x=\"20\" y=\"" + str(row2_y) + "\" width=\"" + str(half_w) + "\" height=\"" + str(row2_h) + "\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"36\" y=\"" + str(row2_y + 26) + "\" fill=\"" + hx.text_primary + "\" font-size=\"14\" font-weight=\"700\">Κατανομή Τιμών &amp; Ζώνη Τυπικής Απόκλισης (±1s)</text>");
    let c1_x = 52.0; let c1_y = row2_y + 44.0; let c1_w = half_w - 52.0; let c1_h = row2_h - 74.0;
    let vmax_a = st_a.mean + st_a.sd;
    let idx = 0;
    while idx < len(st_a.values) {
        if st_a.values[idx] > vmax_a { vmax_a = st_a.values[idx]; }
        idx = idx + 1;
    }
    let y_top_val = vmax_a * 1.18 + 0.5;
    let y_mean = c1_y + c1_h - (st_a.mean / y_top_val) * c1_h;
    let y_hi_s = c1_y + c1_h - ((st_a.mean + st_a.sd) / y_top_val) * c1_h;
    let y_lo_s = c1_y + c1_h - (_max(0.0, st_a.mean - st_a.sd) / y_top_val) * c1_h;
    array_push(svg, "  <rect x=\"" + _fmt(c1_x, 1) + "\" y=\"" + _fmt(y_hi_s, 1) + "\" width=\"" + _fmt(c1_w, 1) + "\" height=\"" + _fmt(_max(2.0, y_lo_s - y_hi_s), 1) + "\" fill=\"" + hx.emerald + "\" fill-opacity=\"0.15\"/>");
    let slot_w = c1_w / st_a.n;
    let bar_w = _clamp(slot_w * 0.48, 10.0, 42.0);
    idx = 0;
    while idx < len(st_a.rows) {
        let rw = st_a.rows[idx];
        let bx_c = c1_x + (idx + 0.5) * slot_w;
        let by_v = c1_y + c1_h - (rw.xi / y_top_val) * c1_h;
        let bh_v = _max(2.0, (c1_y + c1_h) - by_v);
        let tip = "Σημείο x" + str(rw.idx) + " = " + _fmt(rw.xi, 2) + " | Απόκλιση = " + _fmt(rw.dev, 2) + " | Τετράγωνο = " + _fmt(rw.dev2, 2);
        array_push(svg, "  <rect x=\"" + _fmt(bx_c - bar_w * 0.5, 1) + "\" y=\"" + _fmt(by_v, 1) + "\" width=\"" + _fmt(bar_w, 1) + "\" height=\"" + _fmt(bh_v, 1) + "\" rx=\"4\" fill=\"" + hx.periwinkle + "\" fill-opacity=\"0.68\" stroke=\"" + hx.periwinkle + "\"><title>" + esc(tip) + "</title></rect>");
        array_push(svg, "  <line x1=\"" + _fmt(bx_c, 1) + "\" y1=\"" + _fmt(by_v, 1) + "\" x2=\"" + _fmt(bx_c, 1) + "\" y2=\"" + _fmt(y_mean, 1) + "\" stroke=\"" + hx.amber + "\" stroke-width=\"1.8\" stroke-dasharray=\"4,3\"/>");
        array_push(svg, "  <circle cx=\"" + _fmt(bx_c, 1) + "\" cy=\"" + _fmt(by_v, 1) + "\" r=\"4.2\" fill=\"" + hx.cyan + "\"><title>" + esc(tip) + "</title></circle>");
        array_push(svg, "  <text x=\"" + _fmt(bx_c, 1) + "\" y=\"" + _fmt(c1_y + c1_h + 16.0, 1) + "\" fill=\"" + hx.text_muted + "\" font-size=\"11\" text-anchor=\"middle\">x" + str(rw.idx) + "</text>");
        idx = idx + 1;
    }
    array_push(svg, "  <line x1=\"" + _fmt(c1_x, 1) + "\" y1=\"" + _fmt(y_mean, 1) + "\" x2=\"" + _fmt(c1_x + c1_w, 1) + "\" y2=\"" + _fmt(y_mean, 1) + "\" stroke=\"" + hx.emerald + "\" stroke-width=\"2.4\"/>");
    array_push(svg, "  <text x=\"" + _fmt(c1_x + 6.0, 1) + "\" y=\"" + _fmt(y_mean - 6.0, 1) + "\" fill=\"" + hx.emerald + "\" font-size=\"11\" font-weight=\"700\">x̄ = " + _fmt(st_a.mean, 2) + " (±s = " + _fmt(st_a.sd, 2) + ")</text>");

    // Card 3B: Κανονική Κατανομή Δείγματος Α & Β (Dual Gaussian Bell Curves)
    let c2_card_x = 36 + half_w;
    array_push(svg, "  <rect x=\"" + str(c2_card_x) + "\" y=\"" + str(row2_y) + "\" width=\"" + str(half_w) + "\" height=\"" + str(row2_h) + "\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"" + str(c2_card_x + 16) + "\" y=\"" + str(row2_y + 26) + "\" fill=\"" + hx.text_primary + "\" font-size=\"14\" font-weight=\"700\">Κανονική Κατανομή Δείγματος Α &amp; Β</text>");
    let g_x = c2_card_x + 28.0; let g_y = row2_y + 46.0; let g_w = half_w - 48.0; let g_h = row2_h - 76.0;
    let sd_a_safe = _max(0.25, st_a.sd);
    let sd_b_safe = _max(0.25, st_b.sd);
    let gx_min = _min(st_a.mean - 3.6 * sd_a_safe, st_b.mean - 3.6 * sd_b_safe);
    let gx_max = _max(st_a.mean + 3.6 * sd_a_safe, st_b.mean + 3.6 * sd_b_safe);
    let peak_a = 0.39894228 / sd_a_safe;
    let peak_b = 0.39894228 / sd_b_safe;
    let g_ymax = _max(peak_a, peak_b) * 1.14;
    let pts_ga = [_fmt(g_x, 1) + "," + _fmt(g_y + g_h, 1)];
    let pts_gb = [_fmt(g_x, 1) + "," + _fmt(g_y + g_h, 1)];
    let gs = 0;
    let g_steps = 72;
    while gs <= g_steps {
        let xv = gx_min + (gx_max - gx_min) * gs / g_steps;
        let ua = (xv - st_a.mean) / sd_a_safe;
        let ub = (xv - st_b.mean) / sd_b_safe;
        let ya = (0.39894228 / sd_a_safe) * num_exp(-0.5 * ua * ua);
        let yb = (0.39894228 / sd_b_safe) * num_exp(-0.5 * ub * ub);
        let px = g_x + ((xv - gx_min) / (gx_max - gx_min)) * g_w;
        let pya = g_y + g_h - (ya / g_ymax) * g_h;
        let pyb = g_y + g_h - (yb / g_ymax) * g_h;
        array_push(pts_ga, _fmt(px, 1) + "," + _fmt(pya, 1));
        array_push(pts_gb, _fmt(px, 1) + "," + _fmt(pyb, 1));
        gs = gs + 1;
    }
    array_push(pts_ga, _fmt(g_x + g_w, 1) + "," + _fmt(g_y + g_h, 1));
    array_push(pts_gb, _fmt(g_x + g_w, 1) + "," + _fmt(g_y + g_h, 1));
    array_push(svg, "  <polygon points=\"" + str_join(pts_gb, " ") + "\" fill=\"" + hx.periwinkle + "\" fill-opacity=\"0.18\" stroke=\"" + hx.periwinkle + "\" stroke-width=\"2.0\"/>");
    array_push(svg, "  <polygon points=\"" + str_join(pts_ga, " ") + "\" fill=\"" + hx.emerald + "\" fill-opacity=\"0.22\" stroke=\"" + hx.emerald + "\" stroke-width=\"2.3\"/>");
    array_push(svg, "  <text x=\"" + str(c2_card_x + 24) + "\" y=\"" + str(row2_y + row2_h - 10) + "\" fill=\"" + hx.emerald + "\" font-size=\"11\">● Δείγμα Α (CV=" + _fmt(st_a.cv_pct, 1) + "%)</text>");
    array_push(svg, "  <text x=\"" + str(c2_card_x + 200) + "\" y=\"" + str(row2_y + row2_h - 10) + "\" fill=\"" + hx.periwinkle + "\" font-size=\"11\">● Δείγμα Β (CV=" + _fmt(st_b.cv_pct, 1) + "%)</text>");

    // 4. Row 3: Σύγκριση Πριν (k=1) & Μετά την Αλλαγή Κλίμακας (CV, CV², D)
    let row3_y = 523;
    let row3_h = 250;
    array_push(svg, "  <rect x=\"20\" y=\"" + str(row3_y) + "\" width=\"" + str(w - 40) + "\" height=\"" + str(row3_h) + "\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"36\" y=\"" + str(row3_y + 28) + "\" fill=\"" + hx.text_primary + "\" font-size=\"15\" font-weight=\"700\">Σύγκριση Πριν (k=1) &amp; Μετά την Αλλαγή Κλίμακας (CV, CV², D) — yᵢ = " + _fmt(scale_k, 2) + "·xᵢ</text>");
    array_push(svg, "  <text x=\"36\" y=\"" + str(row3_y + 48) + "\" fill=\"" + hx.text_muted + "\" font-size=\"12\">Τα CV και CV² παραμένουν αναλλοίωτα (αδιάστατα), ενώ ο δείκτης D = s²/x̄ είναι Εξαρτώμενο από τις μονάδες (πολλαπλασιάζεται επί k)!</text>");

    let metrics_cmp = [
        map{ name: "CV = s / x̄", before: st_a.cv_raw, after: st_a.after_cv, note: "Ανεξάρτητο μονάδων" },
        map{ name: "CV² = s² / x̄²", before: st_a.cv2_raw, after: st_a.after_cv2, note: "Ανεξάρτητο μονάδων" },
        map{ name: "D = s² / x̄", before: st_a.dispersion_d, after: st_a.after_d, note: "Εξαρτώμενο από τις μονάδες" }
    ];
    let max_cmp = _max(0.2, _max(st_a.cv_raw, _max(st_a.dispersion_d, st_a.after_d))) * 1.25;
    let base_bar_y = row3_y + row3_h - 38.0;
    let max_bar_h = row3_h - 108.0;
    let grp_span = (w - 120.0) / 3.0;
    let mi = 0;
    while mi < 3 {
        let mc = metrics_cmp[mi];
        let gx0 = 68.0 + mi * grp_span;
        let h_bef = _max(4.0, (mc.before / max_cmp) * max_bar_h);
        let h_aft = _max(4.0, (mc.after / max_cmp) * max_bar_h);
        array_push(svg, "  <rect x=\"" + _fmt(gx0, 1) + "\" y=\"" + _fmt(base_bar_y - h_bef, 1) + "\" width=\"54\" height=\"" + _fmt(h_bef, 1) + "\" rx=\"4\" fill=\"" + hx.cyan + "\" fill-opacity=\"0.82\"/>");
        array_push(svg, "  <text x=\"" + _fmt(gx0 + 27.0, 1) + "\" y=\"" + _fmt(base_bar_y - h_bef - 6.0, 1) + "\" fill=\"" + hx.cyan + "\" font-size=\"11\" text-anchor=\"middle\">Πριν: " + _fmt(mc.before, 3) + "</text>");
        let after_col = if mi == 2 { hx.coral } else { hx.emerald };
        array_push(svg, "  <rect x=\"" + _fmt(gx0 + 66.0, 1) + "\" y=\"" + _fmt(base_bar_y - h_aft, 1) + "\" width=\"54\" height=\"" + _fmt(h_aft, 1) + "\" rx=\"4\" fill=\"" + after_col + "\" fill-opacity=\"0.85\"/>");
        array_push(svg, "  <text x=\"" + _fmt(gx0 + 93.0, 1) + "\" y=\"" + _fmt(base_bar_y - h_aft - 6.0, 1) + "\" fill=\"" + after_col + "\" font-size=\"11\" text-anchor=\"middle\">Μετά: " + _fmt(mc.after, 3) + "</text>");
        array_push(svg, "  <text x=\"" + _fmt(gx0 + 60.0, 1) + "\" y=\"" + _fmt(base_bar_y + 16.0, 1) + "\" fill=\"" + hx.text_primary + "\" font-size=\"12\" font-weight=\"700\" text-anchor=\"middle\">" + esc(mc.name) + "</text>");
        array_push(svg, "  <text x=\"" + _fmt(gx0 + 60.0, 1) + "\" y=\"" + _fmt(base_bar_y + 30.0, 1) + "\" fill=\"" + hx.text_muted + "\" font-size=\"10\" text-anchor=\"middle\">" + esc(mc.note) + "</text>");
        mi = mi + 1;
    }

    // 5. Row 4: Αναλυτικός Πίνακας Αποκλίσεων
    let row4_y = 789;
    let row4_h = h - row4_y - 20;
    array_push(svg, "  <rect x=\"20\" y=\"" + str(row4_y) + "\" width=\"" + str(w - 40) + "\" height=\"" + str(row4_h) + "\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"36\" y=\"" + str(row4_y + 28) + "\" fill=\"" + hx.text_primary + "\" font-size=\"15\" font-weight=\"700\">Αναλυτικός Πίνακας Αποκλίσεων</text>");

    let th_y = row4_y + 42;
    array_push(svg, "  <rect x=\"36\" y=\"" + str(th_y) + "\" width=\"" + str(w - 72) + "\" height=\"28\" rx=\"5\" fill=\"" + hx.surface_alt + "\"/>");
    array_push(svg, "  <text x=\"56\" y=\"" + str(th_y + 19) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\"># (i)</text>");
    array_push(svg, "  <text x=\"180\" y=\"" + str(th_y + 19) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">Παρατήρηση xᵢ</text>");
    array_push(svg, "  <text x=\"370\" y=\"" + str(th_y + 19) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">Απόκλιση (xᵢ − x̄)</text>");
    array_push(svg, "  <text x=\"570\" y=\"" + str(th_y + 19) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">Τετράγωνο (xᵢ − x̄)²</text>");
    array_push(svg, "  <text x=\"770\" y=\"" + str(th_y + 19) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">z-score / %SS</text>");

    let max_rows = _min(len(st_a.rows), num_floor((row4_h - 112) / 28));
    let ri = 0;
    while ri < max_rows {
        let rw = st_a.rows[ri];
        let ry = th_y + 32 + ri * 28;
        if num_mod(ri, 2) == 1 {
            array_push(svg, "  <rect x=\"36\" y=\"" + str(ry) + "\" width=\"" + str(w - 72) + "\" height=\"26\" rx=\"4\" fill=\"" + hx.surface_alt + "\" fill-opacity=\"0.55\"/>");
        }
        let d_col = if rw.dev >= 0.0 { hx.cyan } else { hx.coral };
        array_push(svg, "  <text x=\"56\" y=\"" + str(ry + 18) + "\" fill=\"" + hx.text_muted + "\" font-size=\"12\">x" + str(rw.idx) + "</text>");
        array_push(svg, "  <text x=\"180\" y=\"" + str(ry + 18) + "\" fill=\"" + hx.text_primary + "\" font-size=\"12\">" + _fmt(rw.xi, 2) + "</text>");
        array_push(svg, "  <text x=\"370\" y=\"" + str(ry + 18) + "\" fill=\"" + d_col + "\" font-size=\"12\">" + (if rw.dev >= 0.0 { "+" } else { "" }) + _fmt(rw.dev, 2) + "</text>");
        array_push(svg, "  <text x=\"570\" y=\"" + str(ry + 18) + "\" fill=\"" + hx.amber + "\" font-size=\"12\">" + _fmt(rw.dev2, 3) + "</text>");
        array_push(svg, "  <text x=\"770\" y=\"" + str(ry + 18) + "\" fill=\"" + hx.text_secondary + "\" font-size=\"12\">z=" + _fmt(rw.z_score, 2) + " (" + _fmt(rw.pct_ss, 1) + "%)</text>");
        ri = ri + 1;
    }

    let sum_y = th_y + 38 + max_rows * 28;
    array_push(svg, "  <line x1=\"36\" y1=\"" + str(sum_y - 4) + "\" x2=\"" + str(w - 36) + "\" y2=\"" + str(sum_y - 4) + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"56\" y=\"" + str(sum_y + 16) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">Σύνοψη:</text>");
    array_push(svg, "  <text x=\"180\" y=\"" + str(sum_y + 16) + "\" fill=\"" + hx.emerald + "\" font-size=\"12\" font-weight=\"700\">x̄ = " + _fmt(st_a.mean, 2) + "</text>");
    array_push(svg, "  <text x=\"370\" y=\"" + str(sum_y + 16) + "\" fill=\"" + hx.text_muted + "\" font-size=\"12\">Σ(xᵢ − x̄) = 0.00</text>");
    array_push(svg, "  <text x=\"570\" y=\"" + str(sum_y + 16) + "\" fill=\"" + hx.amber + "\" font-size=\"12\" font-weight=\"700\">SS = " + _fmt(st_a.ss, 3) + "</text>");
    array_push(svg, "  <text x=\"770\" y=\"" + str(sum_y + 16) + "\" fill=\"" + badge_fg + "\" font-size=\"12\" font-weight=\"700\">s²=" + _fmt(st_a.variance, 2) + ", CV=" + _fmt(st_a.cv_pct, 1) + "%</text>");

    array_push(svg, "</svg>");
    return str_join(svg, "\n");
}

// ============================================================================
// 2B. Universal Concept Cards & SI / Buckingham Π Domain Engine + SVG Wrapper
// ============================================================================

fn _compute_universal_domain_state(domain_idx, scale_k = 2.5, sim_t = 0.35) {
    let k = if _abs(scale_k) > 1e-6 { _abs(scale_k) } else { 1.0 };
    let idx = _clamp(_int_or(domain_idx, 0), 0, 5);
    let presets = universal_concept_presets();
    let p_meta = presets[idx];

    if idx == 0 {
        let x0 = 0.8;
        let sinc_bef = num_sin(x0) / x0;
        let sinc_zero = 1.0;
        let ray_bef = 2.20;
        let quad_bef = x0 * x0;
        let quad_aft = (k * x0) * (k * x0);
        return map{
            domain_idx: idx,
            preset_label: p_meta.label,
            title_el: "Συνάρτηση & Λογισμός — Ομογένεια Euler f(kx) = kᵖ·f(x)",
            formula_main: "lim_{x→0} sin(kx)/(kx) = 1   vs   g(kx) = k²·x²",
            badge_el: "● Αδιάστατο (p = 0)",
            is_invariant: true,
            homogeneity_p: 0.0,
            si_dim: "[1] (M⁰·L⁰·T⁰)",
            pi_summary: "Π₁ = sin(θ)/θ (θ αδιάστατη γωνία rad, rank r=0, Π-ομάδες = 1)",
            pi_groups: ["Π₁ = x / L₀  [1]", "Π₂ = sin(x/L₀) / (x/L₀)  [1]", "Euler: x·f'(x) = 0·f(x) στο όριο x→0"],
            kpis: [
                map{ title: "Όριο sinc(0)", val: "1.000", sub: "● Αδιάστατο (p=0)", tier: "emerald" },
                map{ title: "Παράγωγος g'(0.8)", val: _fmt(2.0 * x0, 2), sub: "d/dx(x²) = 2x", tier: "cyan" },
                map{ title: "Rayleigh R(kx)", val: _fmt(ray_bef, 2), sub: "● Αδιάστατο (p=0)", tier: "emerald" },
                map{ title: "Τετραγωνικό g(kx)", val: _fmt(quad_aft, 2), sub: "● Εξαρτώμενο (×k²)", tier: "coral" },
                map{ title: "Βαθμός Euler p", val: "p=0 / p=2", sub: "x·∇f = p·f(x)", tier: "periwinkle" }
            ],
            bars: [
                map{ name: "lim sinc(kx)", before: sinc_zero, after: sinc_zero, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "R(kx) = xᵀAx/xᵀx", before: ray_bef, after: ray_bef, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "g(kx) = (kx)²", before: quad_bef, after: quad_aft, invariant: false, p_deg: "p = 2", note: "Εξαρτώμενο (×k²)" }
            ],
            steps: [
                map{ badge: "Βήμα 1 • Ορισμός & Πεδίο", eq: "sinc(x) = sin(x)/x,  R(x) = (xᵀAx)/(xᵀx),  g(x) = x²", note: "Έλεγχος αλλαγής κλίμακας x ↦ k·x (k = " + _fmt(k, 2) + ")", col: "cyan" },
                map{ badge: "Βήμα 2 • Θεώρημα Euler", eq: "x·∇R(x) = 0·R(x) ⇒ p = 0  |  x·g'(x) = 2·g(x) ⇒ p = 2", note: "Ο βαθμός ομογένειας p καθορίζει την εξάρτηση μονάδων", col: "periwinkle" },
                map{ badge: "Βήμα 3 • Αναλλοίωτο vs Κλιμάκωση", eq: "R(kx) = k²(xᵀAx) / k²(xᵀx) = R(x)  (Αδιάστατο!)", note: "Ο παράγοντας k² απλοποιείται πλήρως στον λόγο Rayleigh", col: "emerald" },
                map{ badge: "Βήμα 4 • Συμπέρασμα SI", eq: "g(kx) = " + _fmt(quad_aft, 3) + " = k²·" + _fmt(quad_bef, 3) + "  (Εξαρτώμενο [L²])", note: "Τα μεγέθη με p ≠ 0 αλλάζουν αριθμητική τιμή με τις μονάδες!", col: "amber" }
            ]
        };
    }

    if idx == 1 {
        // Matrix A = [[4, 1], [1, 2]] => trace=6, det=7, eig = 3 +/- sqrt(2)
        let l1 = 3.0 + num_sqrt(2.0);
        let l2 = 3.0 - num_sqrt(2.0);
        let cond_a = l1 / l2;
        let det_bef = 7.0;
        let det_aft = 7.0 * k * k;
        let tr_bef = 6.0;
        let tr_aft = 6.0 * k;
        return map{
            domain_idx: idx,
            preset_label: p_meta.label,
            title_el: "Γραμμική Άλγεβρα — Δείκτης Κατάστασης κ₂(kA) vs Ορίζουσα det(kA)",
            formula_main: "κ₂(kA) = ‖kA‖₂·‖(kA)⁻¹‖₂ = κ₂(A)   vs   det(kA) = kⁿ·det(A)",
            badge_el: "● Αδιάστατο κ₂ (p = 0)",
            is_invariant: true,
            homogeneity_p: 0.0,
            si_dim: "κ₂: [1]  |  det(A₂ₓ₂): [μονάδα²]",
            pi_summary: "Π₁ = κ₂(A) = σ_max/σ_min = " + _fmt(cond_a, 3) + " (Αδιάστατο), n=2 ⇒ det(kA)=k²det(A)",
            pi_groups: ["Π₁ = κ₂(A) = σ₁ / σ₂ = 2.784  [1]", "Π₂ = tr(A)² / det(A) = 36 / 7 = 5.143  [1]", "det(kA) = k²·det(A) (βαθμός p = n = 2)"],
            kpis: [
                map{ title: "Δείκτης κ₂(kA)", val: _fmt(cond_a, 3), sub: "● Αδιάστατο (p=0)", tier: "emerald" },
                map{ title: "Λόγος tr²/det", val: _fmt(36.0 / 7.0, 3), sub: "● Αδιάστατο (p=0)", tier: "emerald" },
                map{ title: "Ίχνος tr(kA)", val: _fmt(tr_aft, 2), sub: "● Εξαρτώμενο (×k¹)", tier: "amber" },
                map{ title: "Ορίζουσα det(kA)", val: _fmt(det_aft, 2), sub: "● Εξαρτώμενο (×k²)", tier: "coral" },
                map{ title: "Ιδιοτιμές λ₁, λ₂", val: _fmt(l1 * k, 1) + "/" + _fmt(l2 * k, 1), sub: "λᵢ(kA) = k·λᵢ(A)", tier: "cyan" }
            ],
            bars: [
                map{ name: "κ₂(A) = σ₁/σ₂", before: cond_a, after: cond_a, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "Π₂ = tr(A)²/det(A)", before: 36.0 / 7.0, after: 36.0 / 7.0, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "det(kA) / 7", before: det_bef / 7.0, after: det_aft / 7.0, invariant: false, p_deg: "p = 2", note: "Εξαρτώμενο (×k²)" }
            ],
            steps: [
                map{ badge: "Βήμα 1 • Πίνακας A (2×2)", eq: "A = [[4, 1], [1, 2]],  tr(A) = 6,  det(A) = 7", note: "Μετασχηματισμός κλίμακας A ↦ k·A με k = " + _fmt(k, 2), col: "cyan" },
                map{ badge: "Βήμα 2 • Ιδιοτιμές & Ιδιάζουσες", eq: "σ₁(kA) = |k|·(3+√2),  σ₂(kA) = |k|·(3-√2)", note: "Όλες οι ιδιάζουσες τιμές πολλαπλασιάζονται επί |k|", col: "periwinkle" },
                map{ badge: "Βήμα 3 • Ακύρωση Κλίμακας σε κ₂", eq: "κ₂(kA) = (|k|·σ₁) / (|k|·σ₂) = σ₁/σ₂ = " + _fmt(cond_a, 3), note: "Η ευστάθεια συστήματος Ax=b είναι ανεξάρτητη μονάδων!", col: "emerald" },
                map{ badge: "Βήμα 4 • Εξάρτηση Ορίζουσας", eq: "det(kA) = k²·det(A) = " + _fmt(det_aft, 2) + " ≠ 7.00", note: "Η ορίζουσα ΔΕΝ αποτελεί αδιάστατο μέτρο ευστάθειας!", col: "coral" }
            ]
        };
    }

    if idx == 2 {
        // Fluid SI & Buckingham Pi: Re = rho * v * L / mu
        // Under unit rescaling (e.g. L' = k*L, v' = k*v, rho' = rho/k^3, mu' = mu/k => Re' = Re!)
        // While dynamic head / kinematic viscosity nu = mu/rho scales with unit choice L'=k*L => nu' = k^2 * nu
        let re_norm = 2.40; // Re / 1000 (1000 * 2.4 * 1.0 / 1.0 = 2400 -> 2.40 x 10^3)
        let eu_num = 0.85;  // Euler number DeltaP / (rho * v^2)
        let q_dyn_bef = 1.20;
        let q_dyn_aft = 1.20 * k * k;
        return map{
            domain_idx: idx,
            preset_label: p_meta.label,
            title_el: "Φυσική SI & Θεώρημα Buckingham Π — Αριθμός Reynolds (Re)",
            formula_main: "Π₁ = Re = (ρ·v·L) / μ  [M⁰·L⁰·T⁰]   vs   q = ½·ρ·v²  [M¹·L⁻¹·T⁻²]",
            badge_el: "● Αδιάστατο Π₁ (SI [1])",
            is_invariant: true,
            homogeneity_p: 0.0,
            si_dim: "Re: [1]  |  q: [kg·m⁻¹·s⁻²]",
            pi_summary: "n = 5 μεταβλητές (ρ, v, L, μ, Δp) − rank(D) = 3 (M, L, T) ⇒ 2 ομάδες Π (Re, Eu)",
            pi_groups: ["Π₁ = Re = ρ¹·v¹·L¹·μ⁻¹  →  [M¹⁻¹, L⁻³⁺¹⁺¹⁺¹, T⁻¹⁺¹] = [1]", "Π₂ = Eu = Δp·ρ⁻¹·v⁻²  →  [M¹⁻¹, L⁻¹⁺³⁻², T⁻²⁺²] = [1]", "Πίνακας SI (M,L,T): rank r = 3, dim(ker D) = 5 − 3 = 2"],
            kpis: [
                map{ title: "Reynolds Re (×10³)", val: _fmt(re_norm, 2) + "k", sub: "● Αδιάστατο [1]", tier: "emerald" },
                map{ title: "Αριθμός Euler Eu", val: _fmt(eu_num, 2), sub: "● Αδιάστατο [1]", tier: "emerald" },
                map{ title: "Βαθμός Πίνακα SI", val: "r = 3", sub: "Βάση {kg, m, s}", tier: "cyan" },
                map{ title: "Ομάδες Π = n − r", val: "2 ομάδες", sub: "Buckingham Π", tier: "periwinkle" },
                map{ title: "Πίεση q(k·v) kPa", val: _fmt(q_dyn_aft, 2), sub: "● Εξαρτώμενο [Pa]", tier: "coral" }
            ],
            bars: [
                map{ name: "Π₁ = Re/10³", before: re_norm, after: re_norm, invariant: true, p_deg: "[1] SI", note: "Αδιάστατο Π₁" },
                map{ name: "Π₂ = Eu = Δp/ρv²", before: eu_num, after: eu_num, invariant: true, p_deg: "[1] SI", note: "Αδιάστατο Π₂" },
                map{ name: "q = ½ρ(kv)²", before: q_dyn_bef, after: q_dyn_aft, invariant: false, p_deg: "[Pa]", note: "Εξαρτώμενο (×k²)" }
            ],
            steps: [
                map{ badge: "Βήμα 1 • Διαστάσεις SI", eq: "[ρ]=M·L⁻³,  [v]=L·T⁻¹,  [L]=L,  [μ]=M·L⁻¹·T⁻¹", note: "Καταγραφή εκθετών βάσης SI [M, L, T]", col: "cyan" },
                map{ badge: "Βήμα 2 • Πυρήνας Πίνακα D", eq: "D·α = 0  ⇒  α₁+α₄=0, -3α₁+α₂+α₃-α₄=0, -α₂-α₄=0", note: "Rank(D) = 3, χώρος λύσεων διάστασης n − r = 1 (ή 2 με Δp)", col: "periwinkle" },
                map{ badge: "Βήμα 3 • Ακύρωση Μονάδων Re", eq: "[ρvL/μ] = M^(1-1) · L^(-3+1+1+1) · T^(-1+1) = M⁰L⁰T⁰ = [1]", note: "Ίδια τιμή Re σε SI (kg,m,s) και CGS (g,cm,s)!", col: "emerald" },
                map{ badge: "Βήμα 4 • Δυναμική Πίεση q", eq: "[½ρv²] = M·L⁻¹·T⁻² (Pascal) ⇒ q' = " + _fmt(q_dyn_aft, 2) + " ≠ " + _fmt(q_dyn_bef, 2), note: "Εξαρτάται από τις μονάδες και κλιμακώνεται με k²!", col: "amber" }
            ]
        };
    }

    if idx == 3 {
        // ODE & PID: m x'' + c x' + k_s x = 0 => zeta = c / (2*sqrt(m*k_s)) vs wn = sqrt(k_s/m)
        let zeta = 0.35;
        let mp_overshoot = num_exp((-PI * zeta) / num_sqrt(1.0 - zeta * zeta));
        let wn_bef = 2.0;
        let wn_aft = 2.0 * k;
        return map{
            domain_idx: idx,
            preset_label: p_meta.label,
            title_el: "ΣΔΕ & Έλεγχος PID — Λόγος Απόσβεσης ζ vs Φυσική Συχνότητα ωₙ",
            formula_main: "ζ = c / (2·√(m·kₛ))  [1]   vs   ωₙ = √(kₛ / m)  [rad·s⁻¹]",
            badge_el: "● Αδιάστατο ζ & Mₚ",
            is_invariant: true,
            homogeneity_p: 0.0,
            si_dim: "ζ: [1]  |  ωₙ: [T⁻¹]",
            pi_summary: "n = 3 παράμετροι (m, c, kₛ), rank = 2 (M, T) ⇒ Π₁ = ζ = c / (2√(mkₛ)) αδιάστατο!",
            pi_groups: ["Π₁ = ζ = c / (2·√(m·kₛ)) = 0.350  [1]", "Π₂ = Mₚ = exp(-πζ/√(1-ζ²)) = 30.9%  [1]", "ωₙ = √(kₛ/m)  [s⁻¹] (αλλάζει με την κλίμακα χρόνου t'=t/k)"],
            kpis: [
                map{ title: "Απόσβεση ζ", val: _fmt(zeta, 3), sub: "● Αδιάστατο [1]", tier: "emerald" },
                map{ title: "Υπερύψωση Mₚ", val: _fmt(mp_overshoot * 100.0, 1) + "%", sub: "● Αδιάστατο [1]", tier: "emerald" },
                map{ title: "Συχνότητα ωₙ'", val: _fmt(wn_aft, 2) + " s⁻¹", sub: "● Εξαρτώμενο [T⁻¹]", tier: "amber" },
                map{ title: "Χρόνος Κορυφής tₚ", val: _fmt(PI / (wn_aft * num_sqrt(1.0 - zeta * zeta)), 2) + " s", sub: "● Εξαρτώμενο [T¹]", tier: "coral" },
                map{ title: "Ευστάθεια Routh", val: "Re(s) < 0", sub: "Ευσταθές (ζ > 0)", tier: "cyan" }
            ],
            bars: [
                map{ name: "ζ = c/(2√mkₛ)", before: zeta, after: zeta, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "Υπερύψωση Mₚ", before: mp_overshoot, after: mp_overshoot, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "ωₙ (κλίμακα ×k)", before: wn_bef, after: wn_aft, invariant: false, p_deg: "[T⁻¹]", note: "Εξαρτώμενο (×k)" }
            ],
            steps: [
                map{ badge: "Βήμα 1 • Ταλαντωτής 2ης Τάξης", eq: "m·x'' + c·x' + kₛ·x = 0   ([m]=M, [c]=M·T⁻¹, [kₛ]=M·T⁻²)", note: "Τυπική μορφή: x'' + 2·ζ·ωₙ·x' + ωₙ²·x = 0", col: "cyan" },
                map{ badge: "Βήμα 2 • Διαστατικός Έλεγχος ζ", eq: "[c / √(m·kₛ)] = (M·T⁻¹) / √(M · M·T⁻²) = (M·T⁻¹)/(M·T⁻¹) = [1]", note: "Ο λόγος απόσβεσης ζ είναι καθαρός αριθμός!", col: "periwinkle" },
                map{ badge: "Βήμα 3 • Αναλλοίωτο Υπερύψωσης", eq: "Mₚ = exp(-πζ / √(1 − ζ²)) = " + _fmt(mp_overshoot * 100.0, 1) + "%", note: "Ανεξάρτητο μονάδων μάζας (kg/g) και χρόνου (s/ms)!", col: "emerald" },
                map{ badge: "Βήμα 4 • Εξάρτηση Συχνότητας ωₙ", eq: "[ωₙ] = [√(kₛ/m)] = T⁻¹  ⇒  ωₙ' = " + _fmt(wn_aft, 2) + " rad/s", note: "Η φυσική συχνότητα εξαρτάται από τη μονάδα χρόνου!", col: "amber" }
            ]
        };
    }

    if idx == 4 {
        // Geometry Euler Line: OG:GH = 1:2 under similarity scaling k
        let eu = compute_euler_triangle(sim_t);
        let ratio_gh_og = eu.gh_to_og_ratio;
        let r_bef = eu.circum_r;
        let r_aft = eu.circum_r * k;
        let area_bef = 0.5 * _abs(eu.A[0] * (eu.B[1] - eu.C[1]) + eu.B[0] * (eu.C[1] - eu.A[1]) + eu.C[0] * (eu.A[1] - eu.B[1]));
        let area_aft = area_bef * k * k;
        return map{
            domain_idx: idx,
            preset_label: p_meta.label,
            title_el: "Ευκλείδεια Γεωμετρία — Αναλλοίωτο Ομοιότητας Ευθείας Euler (|GH|/|OG| = 2)",
            formula_main: "|GH| / |OG| = 2.000  [1]   vs   R(k·△) = k·R  [L¹],  Ε(k·△) = k²·Ε  [L²]",
            badge_el: "● Αδιάστατο Ομοιότητας",
            is_invariant: true,
            homogeneity_p: 0.0,
            si_dim: "|GH|/|OG|: [1]  |  R: [m], Ε: [m²]",
            pi_summary: "Ομοιοθεσία P' = k·P: όλοι οι λόγοι τμημάτων & γωνίες έχουν βαθμό p = 0!",
            pi_groups: ["Π₁ = |GH| / |OG| = 2.000  [L¹/L¹ = 1]", "Π₂ = Ε / R² = " + _fmt(area_bef / _max(1e-6, r_bef * r_bef), 3) + "  [L²/L² = 1]", "R' = k·R [L¹] (p=1),  Ε' = k²·Ε [L²] (p=2)"],
            kpis: [
                map{ title: "Λόγος |GH|/|OG|", val: _fmt(ratio_gh_og, 3), sub: "● Αδιάστατο (2.000)", tier: "emerald" },
                map{ title: "Λόγος Ε / R²", val: _fmt(area_bef / _max(1e-6, r_bef * r_bef), 3), sub: "● Αδιάστατο [1]", tier: "emerald" },
                map{ title: "Ακτίνα R(k·△)", val: _fmt(r_aft, 2) + " m", sub: "● Εξαρτώμενο (×k¹)", tier: "amber" },
                map{ title: "Εμβαδόν Ε(k·△)", val: _fmt(area_aft, 2) + " m²", sub: "● Εξαρτώμενο (×k²)", tier: "coral" },
                map{ title: "Συνευθειακότητα", val: "H = 3G − 2O", sub: "Θεώρημα Euler", tier: "cyan" }
            ],
            bars: [
                map{ name: "|GH| / |OG|", before: ratio_gh_og, after: ratio_gh_og, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "Π₂ = Ε / R²", before: area_bef / _max(1e-6, r_bef * r_bef), after: area_aft / _max(1e-6, r_aft * r_aft), invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
                map{ name: "Ακτίνα R(k·△)", before: r_bef, after: r_aft, invariant: false, p_deg: "p = 1", note: "Εξαρτώμενο [m]" }
            ],
            steps: [
                map{ badge: "Βήμα 1 • Κέντρα Τριγώνου △ABC", eq: "Περίκεντρο O, Βαρύκεντρο G=(A+B+C)/3, Ορθόκεντρο H", note: "Ομοιοθεσία κορυφών A'=kA, B'=kB, C'=kC (k = " + _fmt(k, 2) + ")", col: "cyan" },
                map{ badge: "Βήμα 2 • Ταυτότητα Διανυσμάτων Euler", eq: "OH = 3·OG  ⇒  GH = 2·OG  ⇒  |GH| / |OG| = 2", note: "Κάθε κέντρο μετασχηματίζεται γραμμικά: O'=kO, G'=kG, H'=kH", col: "periwinkle" },
                map{ badge: "Βήμα 3 • Αναλλοίωτο Κλίμακας (p=0)", eq: "|G'H'| / |O'G'| = (|k|·|GH|) / (|k|·|OG|) = 2.000", note: "Ανεξάρτητο από m, cm, mm ή μεγέθυνση καμβά!", col: "emerald" },
                map{ badge: "Βήμα 4 • Μήκος (p=1) & Εμβαδόν (p=2)", eq: "R' = " + _fmt(r_aft, 2) + " (×k),  Ε' = " + _fmt(area_aft, 2) + " (×k²)", note: "Μήκη και εμβαδά κλιμακώνονται με k¹ και k² αντίστοιχα!", col: "coral" }
            ]
        };
    }

    // idx == 5: Finance Black-Scholes & Capital Budgeting (IRR / Delta vs Call C & NPV)
    // S=100, K=100, r=0.05, sigma=0.20, T=1.0 => d1 = (0.05 + 0.02)/0.20 = 0.35 => N(0.35) ≈ 0.6368, C ≈ 10.45
    let delta_bs = 0.6368;
    let irr_val = 0.184;
    let call_bef = 10.45;
    let call_aft = 10.45 * k;
    return map{
        domain_idx: 5,
        preset_label: p_meta.label,
        title_el: "Οικονομικά & Black-Scholes — Αδιάστατα Δ = ∂C/∂S & IRR vs Καθαρή Αξία NPV",
        formula_main: "C(kS, kK) = k·C(S, K) (p=1)  ⇒  Δ = ∂C/∂S = N(d₁) (p=0, Αδιάστατο!)",
        badge_el: "● Αδιάστατο Δ & IRR",
        is_invariant: true,
        homogeneity_p: 0.0,
        si_dim: "Δ: [1], IRR: [έτος⁻¹]  |  C, NPV: [Νόμισμα¹]",
        pi_summary: "Αλλαγή νομισματικής μονάδας (€ ↦ k·€, π.χ. cents): d₁ = [ln(S/K)+(r+σ²/2)T]/(σ√T) αδιάστατο!",
        pi_groups: ["Π₁ = S / K = 1.000  [€ / € = 1] (Moneyness)", "Π₂ = Δ = N(d₁) = 0.637  [€ / € = 1] (Hedge Ratio)", "C(kS, kK) = k·C(S, K) & NPV(k·CF) = k·NPV(CF)  [€¹] (p = 1)"],
        kpis: [
            map{ title: "Hedge Ratio Δ", val: _fmt(delta_bs, 3), sub: "● Αδιάστατο N(d₁)", tier: "emerald" },
            map{ title: "Απόδοση IRR", val: _fmt(irr_val * 100.0, 1) + "%", sub: "● Ανεξάρτητο € (p=0)", tier: "emerald" },
            map{ title: "Moneyness S/K", val: "1.000", sub: "● Αδιάστατο [1]", tier: "cyan" },
            map{ title: "Τιμή Call C(kS,kK)", val: _fmt(call_aft, 2) + " €", sub: "● Εξαρτώμενο (×k¹)", tier: "amber" },
            map{ title: "Κλιμάκωση NPV", val: _fmt(24.0 * k, 1) + " €", sub: "● Εξαρτώμενο (×k¹)", tier: "coral" }
        ],
        bars: [
            map{ name: "Δ = ∂C/∂S = N(d₁)", before: delta_bs, after: delta_bs, invariant: true, p_deg: "p = 0", note: "Αδιάστατο [1]" },
            map{ name: "IRR (Σ(CF/(1+r)ᵗ)=0)", before: irr_val, after: irr_val, invariant: true, p_deg: "p = 0", note: "Ανεξάρτητο €" },
            map{ name: "C(kS,kK) / 10", before: call_bef / 10.0, after: call_aft / 10.0, invariant: false, p_deg: "p = 1", note: "Εξαρτώμενο [€]" }
        ],
        steps: [
            map{ badge: "Βήμα 1 • Ομογένεια Black-Scholes", eq: "C(S, K) = S·N(d₁) − K·e⁻ʳᵀ·N(d₂),   d₁ = [ln(S/K)+(r+σ²/2)T]/(σ√T)", note: "Μετατροπή νομίσματος S'=kS, K'=kK (π.χ. k = " + _fmt(k, 2) + ")", col: "cyan" },
            map{ badge: "Βήμα 2 • Ακύρωση Μονάδας σε d₁ & IRR", eq: "ln(kS / kK) = ln(S / K)  &  Σ (k·CFₜ)/(1+IRR)ᵗ = 0 ⇔ IRR σταθερό", note: "Ο λόγος S/K και η ρίζα IRR είναι βαθμού ομογένειας p = 0!", col: "periwinkle" },
            map{ badge: "Βήμα 3 • Θεώρημα Euler (p=1 ⇒ ∂C/∂S p=0)", eq: "S·(∂C/∂S) + K·(∂C/∂K) = 1·C(S,K)  ⇒  Δ(kS,kK) = 0.637", note: "Η παράγωγος ομογενούς συνάρτησης βαθμού 1 έχει βαθμό 0!", col: "emerald" },
            map{ badge: "Βήμα 4 • Τιμή Δικαιώματος & NPV", eq: "C(kS, kK) = " + _fmt(call_aft, 2) + " = k·10.45  (Εξαρτώμενο νομίσματος)", note: "Οι χρηματικές αξίες C και NPV πολλαπλασιάζονται επί k!", col: "amber" }
        ]
    };
}

// Convenience wrapper delegating to `universal_concept_cards.sapp` (with statistical & built-in SVG fallback)
fn render_any_concept_svg(input, opts = nil) {
    let uc = _lazy_universal_cards();
    if uc != nil {
        let fn_svg = try uc.render_universal_concept_card_svg catch nil;
        if fn_svg != nil {
            let delegated = try fn_svg(input, opts) catch nil;
            if delegated != nil and type(delegated) == "string" and str_starts_with(delegated, "<svg") {
                return delegated;
            }
        }
    }
    if is_array(input) {
        return render_statistical_concept_svg(input);
    }
    if is_map(input) and map_has(input, "values") and is_array(input.values) {
        return render_statistical_concept_svg(input);
    }

    // Built-in Universal Concept Card SVG fallback when `universal_concept_cards.sapp` is still loading
    let cfg = if is_map(opts) { opts } else { map{} };
    let w = _max(720, _int_or(try cfg.width catch 960, 960));
    let h = _max(540, _int_or(try cfg.height catch 680, 680));
    let dark_mode = not _is_true(try cfg.light_mode catch false);
    let th = if dark_mode { studio_theme_dark() } else { studio_theme_light() };
    let hx = th.hex;
    let esc = ODG.svg_escape;
    let k = _num_or(try cfg.scale_k catch 2.5, 2.5);
    let expr_str = if is_map(input) { str(try input.expr catch (try input.formula catch "sin(x)/x")) } else { str(input) };

    // Probe scale invariance numerically via ODG expression compiler
    let comp = ODG.compile_math_expr(expr_str);
    let v1 = if _is_true(comp.ok) { _num_or(ODG.eval_compiled_expr(comp, map{ x: 1.2, y: 0.8, a: 1.0, k: 1.0 }), 1.0) } else { 1.0 };
    let vk = if _is_true(comp.ok) { _num_or(ODG.eval_compiled_expr(comp, map{ x: 1.2 * k, y: 0.8 * k, a: 1.0, k: k }), v1) } else { v1 };
    let is_inv = _abs(vk - v1) <= 1e-5 * _max(1.0, _abs(v1));
    let badge_txt = if is_inv { "● Αδιάστατο" } else { "● Εξαρτώμενο" };
    let badge_fg = if is_inv { hx.emerald } else { hx.amber };
    let badge_bg = if is_inv { hx.emerald_soft } else { hx.amber_soft };

    let dom = _compute_universal_domain_state(0, k, 0.35);
    let svg = [];
    array_push(svg, "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + str(w) + " " + str(h) + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" font-family=\"system-ui, -apple-system, Segoe UI, Noto Sans, sans-serif\">");
    array_push(svg, "  <rect x=\"0\" y=\"0\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" fill=\"" + hx.bg + "\"/>");
    array_push(svg, "  <rect x=\"20\" y=\"16\" width=\"" + str(w - 40) + "\" height=\"64\" rx=\"10\" fill=\"" + hx.header_bg + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"36\" y=\"43\" fill=\"" + hx.emerald + "\" font-size=\"17\" font-weight=\"700\">Κάρτα Έννοιας &amp; Διαστατικής Ανάλυσης SI: " + esc(expr_str) + "</text>");
    array_push(svg, "  <text x=\"36\" y=\"65\" fill=\"" + hx.text_muted + "\" font-size=\"12\">Κλίμακα k = " + _fmt(k, 2) + "  •  f(x₀) = " + _fmt(v1, 4) + "  •  f(k·x₀) = " + _fmt(vk, 4) + "</text>");
    array_push(svg, "  <rect x=\"" + str(w - 190) + "\" y=\"30\" width=\"154\" height=\"30\" rx=\"15\" fill=\"" + badge_bg + "\" stroke=\"" + badge_fg + "\"/>");
    array_push(svg, "  <text x=\"" + str(w - 113) + "\" y=\"50\" fill=\"" + badge_fg + "\" font-size=\"13\" font-weight=\"700\" text-anchor=\"middle\">" + esc(badge_txt) + "</text>");

    let kw = num_floor((w - 40 - 48) / 5);
    let ki = 0;
    while ki < 5 {
        let kp = dom.kpis[ki];
        let kx = 20 + ki * (kw + 12);
        let col = if kp.tier == "emerald" { hx.emerald } else if kp.tier == "amber" { hx.amber } else if kp.tier == "coral" { hx.coral } else { hx.cyan };
        array_push(svg, "  <rect x=\"" + str(kx) + "\" y=\"94\" width=\"" + str(kw) + "\" height=\"92\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
        array_push(svg, "  <text x=\"" + str(kx + 12) + "\" y=\"118\" fill=\"" + hx.text_muted + "\" font-size=\"11\">" + esc(kp.title) + "</text>");
        array_push(svg, "  <text x=\"" + str(kx + 12) + "\" y=\"150\" fill=\"" + col + "\" font-size=\"20\" font-weight=\"700\">" + esc(kp.val) + "</text>");
        array_push(svg, "  <text x=\"" + str(kx + 12) + "\" y=\"174\" fill=\"" + hx.text_secondary + "\" font-size=\"10\">" + esc(kp.sub) + "</text>");
        ki = ki + 1;
    }

    array_push(svg, "  <rect x=\"20\" y=\"200\" width=\"" + str(w - 40) + "\" height=\"" + str(h - 220) + "\" rx=\"10\" fill=\"" + hx.surface + "\" stroke=\"" + hx.border + "\"/>");
    array_push(svg, "  <text x=\"36\" y=\"228\" fill=\"" + hx.text_primary + "\" font-size=\"15\" font-weight=\"700\">Σύγκριση Πριν (k=1) &amp; Μετά (k=" + _fmt(k, 2) + ") + Βήματα Ανάλυσης (Βήμα 1..4)</text>");
    let si = 0;
    while si < len(dom.steps) {
        let stp = dom.steps[si];
        let sy = 246 + si * 96;
        array_push(svg, "  <rect x=\"36\" y=\"" + str(sy) + "\" width=\"" + str(w - 72) + "\" height=\"84\" rx=\"8\" fill=\"" + hx.surface_alt + "\" stroke=\"" + hx.border + "\"/>");
        array_push(svg, "  <text x=\"52\" y=\"" + str(sy + 24) + "\" fill=\"" + hx.cyan + "\" font-size=\"12\" font-weight=\"700\">" + esc(stp.badge) + "</text>");
        array_push(svg, "  <text x=\"52\" y=\"" + str(sy + 48) + "\" fill=\"" + hx.text_primary + "\" font-size=\"13\">" + esc(stp.eq) + "</text>");
        array_push(svg, "  <text x=\"52\" y=\"" + str(sy + 70) + "\" fill=\"" + hx.text_secondary + "\" font-size=\"11\">" + esc(stp.note) + "</text>");
        si = si + 1;
    }
    array_push(svg, "</svg>");
    return str_join(svg, "\n");
}

// ============================================================================
// 3. GeoGebra Euler-Line Solver & MATLAB Closed-Loop PID Step Simulator
// ============================================================================

fn compute_euler_triangle(t_sec) {
    // Animated non-equilateral acute/scalene triangle so O, G, H are distinct and collinear!
    let ax = -0.35 + 1.15 * num_cos(t_sec * 0.9);
    let ay = 1.95 + 0.35 * num_sin(t_sec * 1.3);
    let bx = -2.3; let by = -1.35;
    let cx = 2.45; let cy = -1.15;

    // Centroid G = (A + B + C) / 3
    let gx = (ax + bx + cx) / 3.0;
    let gy = (ay + by + cy) / 3.0;

    // Circumcenter O
    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
    let safe_d = if _abs(d) > 1e-6 { d } else { 1e-6 };
    let a2 = ax * ax + ay * ay;
    let b2 = bx * bx + by * by;
    let c2 = cx * cx + cy * cy;
    let ox = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / safe_d;
    let oy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / safe_d;
    let circum_r = num_sqrt((ax - ox) * (ax - ox) + (ay - oy) * (ay - oy));

    // Euler's Theorem: H = 3*G - 2*O (exact Orthocenter!)
    let hx = 3.0 * gx - 2.0 * ox;
    let hy = 3.0 * gy - 2.0 * oy;

    let og_len = num_sqrt((gx - ox) * (gx - ox) + (gy - oy) * (gy - oy));
    let gh_len = num_sqrt((hx - gx) * (hx - gx) + (hy - gy) * (hy - gy));
    let ratio = if og_len > 1e-6 { gh_len / og_len } else { 2.0 };

    return map{
        A: [ax, ay], B: [bx, by], C: [cx, cy],
        G: [gx, gy], O: [ox, oy], H: [hx, hy],
        circum_r: circum_r,
        gh_to_og_ratio: ratio
    };
}

// Closed-loop 2nd-order plant y'' + 2*zeta*wn*y' + wn^2*y = wn^2 * u_pid(t)
fn simulate_pid_step_response(kp = 2.4, ki = 1.6, kd = 0.65, t_end = 8.0, steps = 160) {
    let dt = t_end / steps;
    let wn = 2.2;
    let zeta = 0.35;
    let y = 0.0;
    let v = 0.0;
    let integ = 0.0;
    let prev_err = 1.0;
    let ts = [];
    let ys = [];
    let peak_y = 0.0;
    let rise_t = t_end;
    let crossed_90 = false;
    let settle_t = t_end;

    let k = 0;
    while k <= steps {
        let t_cur = k * dt;
        array_push(ts, t_cur);
        array_push(ys, y);
        if y > peak_y { peak_y = y; }
        if not crossed_90 and y >= 0.90 {
            rise_t = t_cur;
            crossed_90 = true;
        }
        if _abs(1.0 - y) > 0.02 {
            settle_t = t_cur;
        }
        let err = 1.0 - y;
        integ = _clamp(integ + err * dt, -4.0, 4.0);
        let deriv = if k == 0 { 0.0 } else { (err - prev_err) / dt };
        prev_err = err;
        let u = _clamp(kp * err + ki * integ + kd * deriv, -8.0, 8.0);

        // RK2 midpoint step on (y, v)
        let a1 = wn * wn * u - 2.0 * zeta * wn * v - wn * wn * y;
        let ym = y + 0.5 * dt * v;
        let vm = v + 0.5 * dt * a1;
        let am = wn * wn * u - 2.0 * zeta * wn * vm - wn * wn * ym;
        y = y + dt * vm;
        v = v + dt * am;
        k = k + 1;
    }

    let overshoot_pct = _max(0.0, (peak_y - 1.0) * 100.0);
    let ss_err = _abs(1.0 - ys[len(ys) - 1]);
    return map{
        ts: ts,
        ys: ys,
        rise_time: rise_t,
        overshoot_pct: overshoot_pct,
        settling_time: settle_t,
        ss_error: ss_err
    };
}

// ============================================================================
// 4. Native OS Window Canvas Adapter (X11 / Win32 / Headless Framebuffer)
// ============================================================================

fn _resolve_ui_font_path() {
    let custom = try env_get("PBLANG_FONT") catch nil;
    if custom != nil and str_trim(str(custom)) != "" {
        return str_trim(str(custom));
    }
    let candidates = [
        "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf",
        "/System/Library/Fonts/Helvetica.ttc",
        "C:/Windows/Fonts/segoeui.ttf",
        "C:/Windows/Fonts/arial.ttf"
    ];
    let i = 0;
    while i < len(candidates) {
        if _is_true(try fs_exists(candidates[i]) catch false) {
            return candidates[i];
        }
        i = i + 1;
    }
    return "";
}

fn _open_native_or_virtual_surface(title, w, h, force_virtual) {
    if not force_virtual {
        // Primary signature: gfxcreatewindow(title, width, height)
        let h1 = try gfxcreatewindow(title, w, h) catch nil;
        if h1 != nil {
            return map{ is_virtual: false, handle: h1, w: w, h: h, draw_ops: 0 };
        }
        // Secondary fallback signature if host build uses (w, h, title)
        let h2 = try gfxcreatewindow(w, h, title) catch nil;
        if h2 != nil {
            return map{ is_virtual: false, handle: h2, w: w, h: h, draw_ops: 0 };
        }
    }
    return map{ is_virtual: true, handle: nil, w: w, h: h, draw_ops: 0 };
}

fn _surf_size(surf) {
    if surf.is_virtual { return map{ w: surf.w, h: surf.h }; }
    let sz = try gfxsize(surf.handle) catch nil;
    if is_array(sz) and len(sz) >= 2 {
        return map{ w: _int_or(sz[0], surf.w), h: _int_or(sz[1], surf.h) };
    }
    if is_map(sz) {
        return map{ w: _int_or(try sz.w catch surf.w, surf.w), h: _int_or(try sz.h catch surf.h, surf.h) };
    }
    return map{ w: surf.w, h: surf.h };
}

fn _surf_is_open(surf) {
    if surf.is_virtual { return true; }
    return _is_true(try gfxisopen(surf.handle) catch true);
}

fn _surf_poll(surf) {
    if surf.is_virtual { return []; }
    let evs = try gfxpollevents(surf.handle) catch [];
    if is_array(evs) { return evs; }
    return [];
}

fn _surf_clear(surf, rgba) {
    surf.draw_ops = surf.draw_ops + 1;
    if not surf.is_virtual { gfxclear(surf.handle, rgba); }
}

fn _surf_rects(surf, rects, rgba) {
    if len(rects) == 0 { return; }
    surf.draw_ops = surf.draw_ops + len(rects);
    if not surf.is_virtual { gfxdrawrects(surf.handle, rects, rgba); }
}

fn _surf_line(surf, x1, y1, x2, y2, rgba) {
    surf.draw_ops = surf.draw_ops + 1;
    if not surf.is_virtual {
        gfxdrawline(surf.handle, num_floor(x1), num_floor(y1), num_floor(x2), num_floor(y2), rgba);
    }
}

fn _surf_dashed_line(surf, x1, y1, x2, y2, rgba) {
    let dx = x2 - x1; let dy = y2 - y1;
    let dist = num_sqrt(dx * dx + dy * dy);
    if dist < 2.0 { _surf_line(surf, x1, y1, x2, y2, rgba); return; }
    let segs = _max(1, num_floor(dist / 6.0));
    let k = 0;
    while k < segs {
        if num_mod(k, 2) == 0 {
            let t0 = (k * 1.0) / segs;
            let t1 = _min(1.0, (k + 0.65) / segs);
            _surf_line(surf, x1 + dx * t0, y1 + dy * t0, x1 + dx * t1, y1 + dy * t1, rgba);
        }
        k = k + 1;
    }
}

fn _surf_text(surf, fp, x, y, text, rgba, px) {
    let s = str(text);
    if s == "" { return; }
    surf.draw_ops = surf.draw_ops + 1;
    if surf.is_virtual { return; }
    if fp != "" {
        let res = try gfxdrawtextaa(surf.handle, num_floor(x), num_floor(y), s, rgba, px, fp, 0) catch nil;
        if res != nil and _is_true(try res.ok catch false) { return; }
    }
    BF.draw_text(fn(px_x, px_y, c) { gfxdrawpoint(surf.handle, px_x, px_y, c); }, num_floor(x), num_floor(y), s, rgba);
}

fn _surf_present(surf) {
    if not surf.is_virtual { gfxpresent(surf.handle); }
}

fn _surf_close(surf) {
    if not surf.is_virtual and surf.handle != nil {
        try gfxclosewindow(surf.handle) catch (try gfxclose(surf.handle) catch nil);
    }
}

// Fast horizontal scanline triangle fill into batched rects for 3D surface quads in `gfx*`
fn _fill_triangle_rects(p0, p1, p2) {
    let pts = [p0, p1, p2];
    if pts[0][1] > pts[1][1] { let t = pts[0]; pts[0] = pts[1]; pts[1] = t; }
    if pts[1][1] > pts[2][1] { let t = pts[1]; pts[1] = pts[2]; pts[2] = t; }
    if pts[0][1] > pts[1][1] { let t = pts[0]; pts[0] = pts[1]; pts[1] = t; }
    let y0 = num_floor(pts[0][1]);
    let y1 = num_floor(pts[1][1]);
    let y2 = num_floor(pts[2][1]);
    if y2 <= y0 { return []; }
    let out = [];
    let total_h = _max(1.0, pts[2][1] - pts[0][1]);
    let y = y0;
    while y <= y2 {
        let second_half = y > y1 or y1 == y0;
        let seg_h = if second_half { _max(1.0, pts[2][1] - pts[1][1]) } else { _max(1.0, pts[1][1] - pts[0][1]) };
        let alpha = (y - pts[0][1]) / total_h;
        let beta = if second_half { (y - pts[1][1]) / seg_h } else { (y - pts[0][1]) / seg_h };
        alpha = _clamp(alpha, 0.0, 1.0);
        beta = _clamp(beta, 0.0, 1.0);
        let ax = pts[0][0] + (pts[2][0] - pts[0][0]) * alpha;
        let bx = if second_half { pts[1][0] + (pts[2][0] - pts[1][0]) * beta } else { pts[0][0] + (pts[1][0] - pts[0][0]) * beta };
        let lx = num_floor(_min(ax, bx));
        let rx = num_ceil(_max(ax, bx));
        if rx > lx {
            array_push(out, map{ x: lx, y: y, w: rx - lx, h: 1 });
        }
        y = y + 1;
    }
    return out;
}

// Bridge: Paints any `ODG.compile_primitives(vw, vh, env)` display list onto native `gfx*` at offset (ox, oy)
fn _paint_odg_primitives(surf, fp, prims, ox, oy) {
    let ri = 0;
    while ri < len(prims.rects) {
        let rc = prims.rects[ri];
        let rad = num_floor(_num_or(try rc.radius catch 0, 0));
        let rlist = UIK.rounded_rect(num_floor(ox + rc.x), num_floor(oy + rc.y), _max(1, num_floor(rc.w)), _max(1, num_floor(rc.h)), rad);
        _surf_rects(surf, rlist, rc.color);
        ri = ri + 1;
    }

    let pi = 0;
    while pi < len(prims.polygons) {
        let pg = prims.polygons[pi];
        let pts = pg.points;
        if len(pts) >= 3 {
            let shifted = [];
            let k = 0;
            while k < len(pts) {
                array_push(shifted, [ox + pts[k][0], oy + pts[k][1]]);
                k = k + 1;
            }
            if pg.fill_color[3] > 20 {
                let spans = [];
                k = 1;
                while k + 1 < len(shifted) {
                    let tri = _fill_triangle_rects(shifted[0], shifted[k], shifted[k + 1]);
                    let ti = 0;
                    while ti < len(tri) { array_push(spans, tri[ti]); ti = ti + 1; }
                    k = k + 1;
                }
                _surf_rects(surf, spans, pg.fill_color);
            }
            k = 0;
            while k < len(shifted) {
                let nxt = shifted[num_mod(k + 1, len(shifted))];
                _surf_line(surf, shifted[k][0], shifted[k][1], nxt[0], nxt[1], pg.stroke_color);
                k = k + 1;
            }
        }
        pi = pi + 1;
    }

    let li = 0;
    while li < len(prims.lines) {
        let ln = prims.lines[li];
        if _is_true(try ln.dashed catch false) {
            _surf_dashed_line(surf, ox + ln.x1, oy + ln.y1, ox + ln.x2, oy + ln.y2, ln.color);
        } else {
            _surf_line(surf, ox + ln.x1, oy + ln.y1, ox + ln.x2, oy + ln.y2, ln.color);
        }
        li = li + 1;
    }

    let ci = 0;
    while ci < len(prims.circles) {
        let cc = prims.circles[ci];
        let r = _max(2, num_floor(cc.r));
        let bx = num_floor(ox + cc.cx - r);
        let by = num_floor(oy + cc.cy - r);
        let d = r * 2;
        if _is_true(try cc.hollow catch false) {
            let c_card = UIK.card(bx, by, d, d, r, 2);
            _surf_rects(surf, c_card.border, cc.stroke_color);
        } else {
            _surf_rects(surf, UIK.rounded_rect(bx, by, d, d, r), cc.fill_color);
        }
        ci = ci + 1;
    }

    let ti = 0;
    while ti < len(prims.texts) {
        let tx = prims.texts[ti];
        let al = str(try tx.align catch "left");
        let s = str(tx.text);
        let px_sz = _int_or(try tx.px catch 11, 11);
        let dx = ox + tx.x;
        if al == "right" { dx = dx - len(s) * 6.2; }
        else if al == "center" { dx = dx - len(s) * 3.1; }
        _surf_text(surf, fp, dx, oy + tx.y, s, tx.color, px_sz);
        ti = ti + 1;
    }
}
// ============================================================================
// 5. Sleek Native Widgets, 6 Interactive Tab Views & 60-FPS Event Loop
// ============================================================================

fn _pt_in_rect(mx, my, rc) {
    if rc == nil { return false; }
    return mx >= rc.x and mx <= (rc.x + rc.w) and my >= rc.y and my <= (rc.y + rc.h);
}

fn _draw_card(surf, th, x, y, w, h, radius = 10, fill_override = nil, border_override = nil) {
    let fill_c = if fill_override != nil { fill_override } else { th.rgb.surface };
    let bord_c = if border_override != nil { border_override } else { th.rgb.border };
    let c = UIK.card(num_floor(x), num_floor(y), _max(4, num_floor(w)), _max(4, num_floor(h)), radius, 1);
    _surf_rects(surf, c.fill, fill_c);
    _surf_rects(surf, c.border, bord_c);
}

fn _draw_pill(surf, fp, th, x, y, w, h, label, active, accent_fg = nil, accent_bg = nil) {
    let fg = if active {
        if accent_fg != nil { accent_fg } else { th.rgb.emerald }
    } else {
        th.rgb.text_secondary
    };
    let bg = if active {
        if accent_bg != nil { accent_bg } else { th.rgb.emerald_soft }
    } else {
        th.rgb.surface_alt
    };
    let brd = if active { fg } else { th.rgb.border };
    let c = UIK.card(num_floor(x), num_floor(y), _max(8, num_floor(w)), _max(8, num_floor(h)), num_floor(h / 2), 1);
    _surf_rects(surf, c.fill, bg);
    _surf_rects(surf, c.border, brd);
    let tx = x + 10;
    let ty = y + num_floor((h - 12) / 2);
    _surf_text(surf, fp, tx, ty, label, fg, 12);
    return map{ x: x, y: y, w: w, h: h };
}

fn _draw_slider(surf, fp, th, x, y, w, label, val, lo, hi, accent_rgba, digits = 2) {
    let span = if (hi - lo) > 1e-9 { hi - lo } else { 1.0 };
    let ratio = _clamp((val - lo) / span, 0.0, 1.0);
    _surf_text(surf, fp, x, y, label, th.rgb.text_secondary, 11);
    let val_txt = _fmt(val, digits);
    _surf_text(surf, fp, x + w - len(val_txt) * 6.6, y, val_txt, accent_rgba, 11);

    let ty = y + 17;
    let th_h = 6;
    _surf_rects(surf, UIK.rounded_rect(num_floor(x), num_floor(ty), _max(8, num_floor(w)), th_h, 3), th.rgb.track);
    let fill_w = _max(4, num_floor(w * ratio));
    _surf_rects(surf, UIK.rounded_rect(num_floor(x), num_floor(ty), fill_w, th_h, 3), accent_rgba);
    let kx = num_floor(x + w * ratio) - 6;
    let ky = ty - 4;
    _surf_rects(surf, UIK.rounded_rect(kx, ky, 12, 14, 6), th.rgb.text_primary);
    return map{ x: x - 4, y: ty - 8, w: w + 8, h: 24, track_x: x, track_w: w, lo: lo, hi: hi };
}

fn _default_6d_dataset() {
    return [
        map{ label: "Alpha", group: "Cluster-A", values: [8.6, 7.8, 9.1, 2.4, 8.2, 7.9] },
        map{ label: "Beta",  group: "Cluster-A", values: [8.1, 8.3, 8.7, 2.9, 7.8, 8.4] },
        map{ label: "Gamma", group: "Cluster-A", values: [7.5, 7.9, 8.4, 3.2, 7.5, 7.6] },
        map{ label: "Delta", group: "Cluster-B", values: [4.8, 6.4, 5.2, 6.8, 5.4, 6.1] },
        map{ label: "Eps",   group: "Cluster-B", values: [5.3, 5.9, 4.9, 7.2, 5.9, 5.7] },
        map{ label: "Zeta",  group: "Cluster-B", values: [4.5, 6.1, 5.6, 6.4, 4.8, 6.3] },
        map{ label: "Eta",   group: "Cluster-C", values: [2.1, 3.0, 2.5, 9.1, 2.8, 3.2] },
        map{ label: "Theta", group: "Cluster-C", values: [2.7, 2.6, 3.1, 8.7, 3.1, 2.7] }
    ];
}

fn _init_studio_state(opts) {
    let theme_mode = str(try opts.theme catch "dark");
    if _is_true(try opts.light_mode catch false) { theme_mode = "light"; }
    if theme_mode != "light" { theme_mode = "dark"; }
    let raw_tab = try opts.start_tab catch (try opts.initial_tab catch 0);
    let start_tab = _clamp(_int_or(raw_tab, 0), 0, 6);
    let raw_dom = try opts.uc_domain_idx catch (try opts.uc_domain catch 0);
    let playing = _is_true(try opts.auto_play catch false);

    return map{
        theme_mode: theme_mode,
        active_tab: start_tab,
        playing: playing,
        sim_t: 0.35,
        anim_dir: 1.0,
        anim_mode: "ping_pong", // "ping_pong" | "loop" | "once"

        // Tab 0: Greek Statistics & CV%
        stat_is_sample: true,
        stat_preset_idx: 0,
        stat_mean_shift: 0.0,
        stat_spread_mult: 1.0,
        stat_scale_k: 2.5,

        // Tab 1: 2D Explicit / Polar / Implicit + Formula Bar
        formula_str: "a * sin(w * x + phi) * cos(0.35 * x)",
        formula_focused: false,
        formula_valid: true,
        amp_a: 1.85,
        freq_w: 1.40,
        phase_phi: 0.65,
        pan_2d_x: 0.0,
        pan_2d_y: 0.0,
        zoom_2d: 1.0,

        // Tab 2: 3D Surface + Lorenz Attractor
        yaw_3d: 38.0,
        pitch_3d: 26.0,
        zoom_3d: 1.05,
        pan_3d_x: 0.0,
        pan_3d_y: 0.0,

        // Tab 3: 4D SO(4) Hyperspace & Cross-Section Slicer
        poly4d_kind: "tesseract",
        rot_xw: 0.52,
        rot_yw: 0.34,
        rot_zw: 0.21,
        slice_w0: 0.15,

        // Tab 4: N-D Multi-Variate (6D)
        nd_mode: "parallel", // "parallel" | "radar" | "pca" | "andrews" | "hypercube"
        nd_brush_hi: 9.5,
        nd_rot_angle: 0.42,

        // Tab 5: PhotoMath • GeoGebra • MATLAB
        pid_kp: 2.40,
        pid_ki: 1.60,
        pid_kd: 0.65,

        // Tab 6: Universal Concept Cards & SI Dimensional / Buckingham Pi Studio
        uc_domain_idx: _clamp(_int_or(raw_dom, 0), 0, 5),
        uc_scale_k: _clamp(_num_or(try opts.uc_scale_k catch 2.5, 2.5), 0.50, 5.00),

        // Mouse & Drag state
        mouse_x: 0,
        mouse_y: 0,
        mouse_down_left: false,
        mouse_down_right: false,
        active_slider_id: "",
        dragging_3d: false,
        panning_view: false,
        last_drag_x: 0,
        last_drag_y: 0,

        // Rebuilt each frame for hit-testing
        hitboxes: map{}
    };
}

fn _current_theme(state) {
    if state.theme_mode == "light" { return studio_theme_light(); }
    return studio_theme_dark();
}

fn _odg_theme_name(state) {
    if state.theme_mode == "light" { return "light"; }
    return "dark";
}

// ----------------------------------------------------------------------------
// Tab 0 Renderer: 1. Στατιστική & CV% (x̄, s, D)
// ----------------------------------------------------------------------------
fn _paint_tab_stats(surf, fp, th, state, cx, cy, cw, ch) {
    let presets = stat_presets();
    let p_idx = _clamp(state.stat_preset_idx, 0, len(presets) - 1);
    let preset = presets[p_idx];
    let st = compute_statistical_summary(preset.values, state.stat_is_sample, state.stat_scale_k, state.stat_mean_shift, state.stat_spread_mult);
    let st_b = compute_statistical_summary(preset.values_b, state.stat_is_sample, state.stat_scale_k, state.stat_mean_shift, 1.0);

    // Row 1: 4 KPI Cards
    let gap = 10;
    let kw = num_floor((cw - gap * 3) / 4);
    let kh = 76;
    _draw_card(surf, th, cx, cy, kw, kh, 10);
    _surf_text(surf, fp, cx + 12, cy + 10, "Μέση Τιμή (x̄)", th.rgb.text_muted, 11);
    _surf_text(surf, fp, cx + 12, cy + 30, _fmt(st.mean, 2), th.rgb.cyan, 20);
    _surf_text(surf, fp, cx + 12, cy + 54, "Μετά k=" + _fmt(st.scale_k, 1) + ": " + _fmt(st.after_mean, 2), th.rgb.text_secondary, 11);

    let k2x = cx + kw + gap;
    _draw_card(surf, th, k2x, cy, kw, kh, 10);
    _surf_text(surf, fp, k2x + 12, cy + 10, "Τυπική Απόκλιση (s)", th.rgb.text_muted, 11);
    _surf_text(surf, fp, k2x + 12, cy + 30, _fmt(st.sd, 3), th.rgb.periwinkle, 20);
    _surf_text(surf, fp, k2x + 12, cy + 54, "s²=" + _fmt(st.variance, 2) + " | SS=" + _fmt(st.ss, 2), th.rgb.text_secondary, 11);

    let k3x = cx + (kw + gap) * 2;
    _draw_card(surf, th, k3x, cy, kw, kh, 10);
    _surf_text(surf, fp, k3x + 12, cy + 10, "Μεταβλητότητα (CV%)", th.rgb.text_muted, 11);
    let badge_fg = if st.homogeneity_tier == "emerald" { th.rgb.emerald } else if st.homogeneity_tier == "amber" { th.rgb.amber } else { th.rgb.coral };
    let badge_bg = if st.homogeneity_tier == "emerald" { th.rgb.emerald_soft } else if st.homogeneity_tier == "amber" { th.rgb.amber_soft } else { th.rgb.coral_soft };
    _surf_text(surf, fp, k3x + 12, cy + 30, _fmt(st.cv_pct, 2) + "%", badge_fg, 20);
    _draw_pill(surf, fp, th, k3x + kw - 128, cy + 46, 118, 22, st.homogeneity_badge, true, badge_fg, badge_bg);

    let k4x = cx + (kw + gap) * 3;
    _draw_card(surf, th, k4x, cy, cw - (kw + gap) * 3, kh, 10);
    _surf_text(surf, fp, k4x + 12, cy + 10, "Δείκτης Διασποράς D = s²/x̄", th.rgb.text_muted, 11);
    _surf_text(surf, fp, k4x + 12, cy + 30, _fmt(st.dispersion_d, 3), th.rgb.amber, 20);
    _surf_text(surf, fp, k4x + 12, cy + 54, "Μετά k: D'=" + _fmt(st.after_d, 3) + " (×|k|)", th.rgb.coral, 11);

    // Row 2: Controls Strip (Sample/Pop toggle + 3 Presets + 3 Sliders)
    let c_y = cy + kh + 10;
    let c_h = 84;
    _draw_card(surf, th, cx, c_y, cw, c_h, 10);
    state.hitboxes.stat_sample = _draw_pill(surf, fp, th, cx + 12, c_y + 10, 122, 26, "Δείγμα (n-1)", state.stat_is_sample, th.rgb.emerald, th.rgb.emerald_soft);
    state.hitboxes.stat_pop = _draw_pill(surf, fp, th, cx + 140, c_y + 10, 126, 26, "Πληθυσμός (N)", not state.stat_is_sample, th.rgb.cyan, th.rgb.cyan_soft);

    state.hitboxes.preset_0 = _draw_pill(surf, fp, th, cx + 12, c_y + 46, 78, 26, "Βασικό", p_idx == 0, th.rgb.periwinkle, th.rgb.periwinkle_soft);
    state.hitboxes.preset_1 = _draw_pill(surf, fp, th, cx + 96, c_y + 46, 128, 26, "Μικρή διασπορά", p_idx == 1, th.rgb.periwinkle, th.rgb.periwinkle_soft);
    state.hitboxes.preset_2 = _draw_pill(surf, fp, th, cx + 230, c_y + 46, 108, 26, "Ακραία τιμή", p_idx == 2, th.rgb.coral, th.rgb.coral_soft);

    let sl_x0 = cx + 360;
    let sl_w = _max(140, num_floor((cw - 380 - 32) / 3));
    state.hitboxes.sl_stat_mean = _draw_slider(surf, fp, th, sl_x0, c_y + 20, sl_w, "Μετατόπιση x̄", state.stat_mean_shift, -8.0, 12.0, th.rgb.cyan, 2);
    state.hitboxes.sl_stat_spread = _draw_slider(surf, fp, th, sl_x0 + sl_w + 16, c_y + 20, sl_w, "Εύρος Διασποράς (×s)", state.stat_spread_mult, 0.25, 2.80, th.rgb.periwinkle, 2);
    state.hitboxes.sl_stat_k = _draw_slider(surf, fp, th, sl_x0 + (sl_w + 16) * 2, c_y + 20, sl_w, "Συντελεστής Κλίμακας k", state.stat_scale_k, 0.50, 5.00, th.rgb.amber, 2);

    // Row 3: Left Split (Deviation Bars + Dual Gaussian Curves) & Right Split (Scale Comparison + Deviation Table)
    let body_y = c_y + c_h + 10;
    let body_h = _max(220, ch - (kh + c_h + 20));
    let left_w = num_floor((cw - 12) * 0.52);
    let right_x = cx + left_w + 12;
    let right_w = cw - left_w - 12;
    let top_h = num_floor((body_h - 10) * 0.52);
    let bot_y = body_y + top_h + 10;
    let bot_h = body_h - top_h - 10;

    // Top-Left: ODG Deviation Bars + ±1s Zone
    let sc_dev = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Κατανομή Τιμών & Ζώνη Τυπικής Απόκλισης (±1s)",
        x_label: "Παρατήρηση i",
        y_label: "Τιμή xi"
    });
    sc_dev.add_layer(ODG.layer_deviation_bars(st.values, state.stat_is_sample, map{}));
    _paint_odg_primitives(surf, fp, sc_dev.compile_primitives(left_w, top_h, nil), cx, body_y);

    // Bottom-Left: Dual Gaussian Bell Curves (Sample A vs Sample B)
    let sd_a = _max(0.22, st.sd);
    let sd_b = _max(0.22, st_b.sd);
    let lo_g = _min(st.mean - 3.5 * sd_a, st_b.mean - 3.5 * sd_b);
    let hi_g = _max(st.mean + 3.5 * sd_a, st_b.mean + 3.5 * sd_b);
    let sc_bell = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Κανονική Κατανομή Δείγματος Α (x̄=" + _fmt(st.mean, 1) + ") & Β",
        xmin: lo_g, xmax: hi_g, ymin: 0.0, ymax: _max(0.45, 1.0 / (sd_a * 2.2)),
        x_label: "x", y_label: "f(x)"
    });
    sc_bell.add_layer(ODG.layer_2d_explicit("(1 / (sa * sqrt(2*pi))) * exp(-0.5 * ((x - ma) / sa)^2)", lo_g, hi_g, map{
        label: "Δείγμα Α", color: th.hex.emerald, samples: 140
    }));
    sc_bell.add_layer(ODG.layer_2d_explicit("(1 / (sb * sqrt(2*pi))) * exp(-0.5 * ((x - mb) / sb)^2)", lo_g, hi_g, map{
        label: "Δείγμα Β", color: th.hex.amber, samples: 140
    }));
    let bell_env = map{ ma: st.mean, sa: sd_a, mb: st_b.mean, sb: sd_b };
    _paint_odg_primitives(surf, fp, sc_bell.compile_primitives(left_w, bot_h, bell_env), cx, bot_y);

    // Top-Right: Scale-Invariance Comparison Grouped Bars (CV, CV², D before vs after k)
    let sc_cmp = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Σύγκριση Πριν (k=1) & Μετά (k=" + _fmt(st.scale_k, 1) + "): CV, CV², D",
        y_label: "Τιμή Δείκτη"
    });
    sc_cmp.add_layer(ODG.layer_bar_grouped(["CV", "CV^2", "D=s^2/x̄"], [
        map{ label: "Πριν (k=1)", values: [st.cv_raw, st.cv2_raw, st.dispersion_d], color: th.hex.cyan },
        map{ label: "Μετά (×k)", values: [st.after_cv, st.after_cv2, st.after_d], color: th.hex.amber }
    ], false, map{}));
    _paint_odg_primitives(surf, fp, sc_cmp.compile_primitives(right_w, top_h, nil), right_x, body_y);

    // Bottom-Right: Αναλυτικός Πίνακας Αποκλίσεων
    _draw_card(surf, th, right_x, bot_y, right_w, bot_h, 10);
    _surf_text(surf, fp, right_x + 12, bot_y + 10, "Αναλυτικός Πίνακας Αποκλίσεων (SS = " + _fmt(st.ss, 2) + ")", th.rgb.text_primary, 12);
    let hdr_y = bot_y + 32;
    _surf_rects(surf, UIK.rounded_rect(right_x + 8, hdr_y - 3, right_w - 16, 20, 4), th.rgb.surface_alt);
    let col_step = num_floor((right_w - 28) / 5);
    _surf_text(surf, fp, right_x + 14, hdr_y, "i", th.rgb.text_muted, 11);
    _surf_text(surf, fp, right_x + 14 + col_step, hdr_y, "xi", th.rgb.text_muted, 11);
    _surf_text(surf, fp, right_x + 14 + col_step * 2, hdr_y, "xi - x̄", th.rgb.text_muted, 11);
    _surf_text(surf, fp, right_x + 14 + col_step * 3, hdr_y, "(xi - x̄)²", th.rgb.text_muted, 11);
    _surf_text(surf, fp, right_x + 14 + col_step * 4, hdr_y, "% SS", th.rgb.text_muted, 11);

    let max_rows = _min(len(st.rows), _max(3, num_floor((bot_h - 60) / 20)));
    let ri = 0;
    while ri < max_rows {
        let rw = st.rows[ri];
        let ry = hdr_y + 22 + ri * 20;
        let dev_c = if _abs(rw.dev) < 1e-6 { th.rgb.text_muted } else if rw.dev > 0.0 { th.rgb.emerald } else { th.rgb.coral };
        _surf_text(surf, fp, right_x + 14, ry, "#" + str(rw.idx), th.rgb.text_secondary, 11);
        _surf_text(surf, fp, right_x + 14 + col_step, ry, _fmt(rw.xi, 2), th.rgb.text_primary, 11);
        _surf_text(surf, fp, right_x + 14 + col_step * 2, ry, (if rw.dev >= 0.0 { "+" } else { "" }) + _fmt(rw.dev, 2), dev_c, 11);
        _surf_text(surf, fp, right_x + 14 + col_step * 3, ry, _fmt(rw.dev2, 2), th.rgb.periwinkle, 11);
        _surf_text(surf, fp, right_x + 14 + col_step * 4, ry, _fmt(rw.pct_ss, 1) + "%", th.rgb.amber, 11);
        ri = ri + 1;
    }
}

// ----------------------------------------------------------------------------
// Tab 1 Renderer: 2. 2D Συναρτήσεις & Live Sliders
// ----------------------------------------------------------------------------
fn _paint_tab_2d_live(surf, fp, th, state, cx, cy, cw, ch) {
    // Formula Input Bar + Animation Mode Control
    let bar_h = 84;
    _draw_card(surf, th, cx, cy, cw, bar_h, 10);
    let fbox_w = _max(260, cw - 330);
    let fbox_brd = if state.formula_focused { th.rgb.cyan } else if not state.formula_valid { th.rgb.coral } else { th.rgb.border };
    _draw_card(surf, th, cx + 12, cy + 10, fbox_w, 30, 6, th.rgb.surface_alt, fbox_brd);
    state.hitboxes.formula_box = map{ x: cx + 12, y: cy + 10, w: fbox_w, h: 30 };
    let cursor_ch = if state.formula_focused { "▌" } else { "" };
    _surf_text(surf, fp, cx + 20, cy + 18, "f(x) = " + state.formula_str + cursor_ch, th.rgb.text_primary, 12);

    let mode_lbl = "Mode [M]: " + (if state.anim_mode == "ping_pong" { "Ping-Pong" } else if state.anim_mode == "loop" { "Loop" } else { "Once" });
    state.hitboxes.anim_mode_btn = _draw_pill(surf, fp, th, cx + fbox_w + 22, cy + 12, 168, 26, mode_lbl, true, th.rgb.cyan, th.rgb.cyan_soft);
    state.hitboxes.reset_2d_btn = _draw_pill(surf, fp, th, cx + fbox_w + 198, cy + 12, 112, 26, "Reset Όρια", false, th.rgb.amber, th.rgb.amber_soft);

    let sl_w = num_floor((cw - 56) / 3);
    state.hitboxes.sl_2d_a = _draw_slider(surf, fp, th, cx + 12, cy + 46, sl_w, "Πλάτος a", state.amp_a, 0.20, 3.80, th.rgb.emerald, 2);
    state.hitboxes.sl_2d_w = _draw_slider(surf, fp, th, cx + 28 + sl_w, cy + 46, sl_w, "Συχνότητα w", state.freq_w, 0.30, 4.00, th.rgb.cyan, 2);
    state.hitboxes.sl_2d_phi = _draw_slider(surf, fp, th, cx + 44 + sl_w * 2, cy + 46, sl_w, "Φάση φ(t)", state.phase_phi, -PI, PI, th.rgb.amber, 2);

    let plot_y = cy + bar_h + 10;
    let plot_h = _max(220, ch - bar_h - 10);
    let main_w = num_floor((cw - 12) * 0.62);
    let side_x = cx + main_w + 12;
    let side_w = cw - main_w - 12;

    let span_x = 6.0 / _max(0.25, state.zoom_2d);
    let span_y = 4.2 / _max(0.25, state.zoom_2d);
    let sc_main = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "2D Συνάρτηση, Ολοκλήρωμα [-2, 2], Εφαπτομένη & Ρίζες",
        xmin: state.pan_2d_x - span_x, xmax: state.pan_2d_x + span_x,
        ymin: state.pan_2d_y - span_y, ymax: state.pan_2d_y + span_y,
        x_label: "x", y_label: "f(x)"
    });
    let expr_use = if state.formula_valid and str_trim(state.formula_str) != "" { state.formula_str } else { "a * sin(w * x + phi)" };
    sc_main.add_layer(ODG.layer_2d_explicit(expr_use, state.pan_2d_x - span_x, state.pan_2d_x + span_x, map{
        label: "f(x)",
        color: th.hex.emerald,
        samples: 220,
        integral_range: [-2.0, 2.0],
        tangent_x: 1.1 * num_sin(state.phase_phi),
        show_roots: true
    }));
    let env_2d = map{ a: state.amp_a, w: state.freq_w, phi: state.phase_phi, t: state.sim_t };
    _paint_odg_primitives(surf, fp, sc_main.compile_primitives(main_w, plot_h, env_2d), cx, plot_y);
    state.hitboxes.viewport_2d = map{ x: cx, y: plot_y, w: main_w, h: plot_h };

    // Top-Right: Polar Rose Curve r(θ)
    let half_h = num_floor((plot_h - 10) / 2);
    let sc_pol = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Πολική Καμπύλη r(θ) = a·cos(3θ + φ)",
        xmin: -3.8, xmax: 3.8, ymin: -3.2, ymax: 3.2
    });
    sc_pol.add_layer(ODG.layer_2d_polar("a * cos(3 * theta + phi)", "theta", 0.0, TAU, 180, map{
        color: th.hex.cyan, label: "r(θ)"
    }));
    _paint_odg_primitives(surf, fp, sc_pol.compile_primitives(side_w, half_h, env_2d), side_x, plot_y);

    // Bottom-Right: Implicit Marching-Squares Lemniscate F(x,y) = 0
    let sc_imp = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Πεπλεγμένη Καμπύλη Marching-Squares F(x,y)=0",
        xmin: -2.4, xmax: 2.4, ymin: -1.8, ymax: 1.8
    });
    sc_imp.add_layer(ODG.layer_2d_implicit("(x^2 + y^2)^2 - a * (x^2 - y^2)", -2.4, 2.4, -1.8, 1.8, 32, map{
        color: th.hex.amber, label: "Lemniscate"
    }));
    _paint_odg_primitives(surf, fp, sc_imp.compile_primitives(side_w, plot_h - half_h - 10, env_2d), side_x, plot_y + half_h + 10);
}

// ----------------------------------------------------------------------------
// Tab 2 Renderer: 3. 3D Επιφάνειες & Ελκυστές (Orbit / Zoom / Live Wave)
// ----------------------------------------------------------------------------
fn _paint_tab_3d_surfaces(surf, fp, th, state, cx, cy, cw, ch) {
    let hud_h = 54;
    _draw_card(surf, th, cx, cy, cw, hud_h, 10);
    _surf_text(surf, fp, cx + 14, cy + 10, "3D Κάμερα Orbit (Αριστερό Drag: Περιστροφή | Ροδέλα: Zoom | Space: Live Κύμα)", th.rgb.text_primary, 12);
    _surf_text(surf, fp, cx + 14, cy + 30, "Yaw: " + _fmt(state.yaw_3d, 1) + "°   Pitch: " + _fmt(state.pitch_3d, 1) + "°   Zoom: " + _fmt(state.zoom_3d, 2) + "×   t = " + _fmt(state.sim_t, 2) + "s", th.rgb.cyan, 11);
    state.hitboxes.reset_3d_btn = _draw_pill(surf, fp, th, cx + cw - 142, cy + 14, 128, 26, "Reset Κάμερας", false, th.rgb.emerald, th.rgb.emerald_soft);

    let plot_y = cy + hud_h + 10;
    let plot_h = _max(240, ch - hud_h - 10);
    let left_w = num_floor((cw - 12) * 0.56);
    let right_x = cx + left_w + 12;
    let right_w = cw - left_w - 12;

    let sc_surf = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "3D Κυματική Επιφάνεια z = cos(r - ωt)·exp(-0.15r)"
    });
    sc_surf.set_camera_3d(state.yaw_3d, state.pitch_3d, 0.0, state.zoom_3d, true);
    sc_surf.add_layer(ODG.layer_3d_surface("cos(sqrt(x^2 + y^2) - 2.6 * t) * exp(-0.15 * sqrt(x^2 + y^2))", -4.2, 4.2, -4.2, 4.2, 18, 18, map{}));
    _paint_odg_primitives(surf, fp, sc_surf.compile_primitives(left_w, plot_h, map{ t: state.sim_t }), cx, plot_y);
    state.hitboxes.viewport_3d = map{ x: cx, y: plot_y, w: cw, h: plot_h };

    let sc_lor = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Χαοτικός Ελκυστής Lorenz 3D (RK4 Trajectory)"
    });
    sc_lor.set_camera_3d(state.yaw_3d + state.sim_t * 18.0, state.pitch_3d * 0.7, 0.0, state.zoom_3d, true);
    sc_lor.add_layer(ODG.layer_3d_parametric_curve("lorenz", nil, nil, "u", 0.0, TAU, 550, map{
        color: th.hex.cyan
    }));
    _paint_odg_primitives(surf, fp, sc_lor.compile_primitives(right_w, plot_h, nil), right_x, plot_y);
}

// ----------------------------------------------------------------------------
// Tab 3 Renderer: 4. 4D Υπερχώρος (Tesseract SO(4) & Τομές Υπερεπιπέδου)
// ----------------------------------------------------------------------------
fn _paint_tab_4d_hyperspace(surf, fp, th, state, cx, cy, cw, ch) {
    let ctl_h = 88;
    _draw_card(surf, th, cx, cy, cw, ctl_h, 10);
    state.hitboxes.p4_tess = _draw_pill(surf, fp, th, cx + 12, cy + 10, 128, 26, "Tesseract (8-Cell)", state.poly4d_kind == "tesseract", th.rgb.emerald, th.rgb.emerald_soft);
    state.hitboxes.p4_16 = _draw_pill(surf, fp, th, cx + 148, cy + 10, 96, 26, "16-Cell", state.poly4d_kind == "16cell", th.rgb.cyan, th.rgb.cyan_soft);
    state.hitboxes.p4_24 = _draw_pill(surf, fp, th, cx + 252, cy + 10, 96, 26, "24-Cell", state.poly4d_kind == "24cell", th.rgb.periwinkle, th.rgb.periwinkle_soft);
    state.hitboxes.p4_cliff = _draw_pill(surf, fp, th, cx + 356, cy + 10, 132, 26, "Clifford Torus", state.poly4d_kind == "clifford_torus", th.rgb.amber, th.rgb.amber_soft);

    let sl_w = num_floor((cw - 68) / 4);
    state.hitboxes.sl_4d_xw = _draw_slider(surf, fp, th, cx + 12, cy + 46, sl_w, "Περιστροφή XW", state.rot_xw, -PI, PI, th.rgb.emerald, 2);
    state.hitboxes.sl_4d_yw = _draw_slider(surf, fp, th, cx + 26 + sl_w, cy + 46, sl_w, "Περιστροφή YW", state.rot_yw, -PI, PI, th.rgb.cyan, 2);
    state.hitboxes.sl_4d_zw = _draw_slider(surf, fp, th, cx + 40 + sl_w * 2, cy + 46, sl_w, "Περιστροφή ZW", state.rot_zw, -PI, PI, th.rgb.periwinkle, 2);
    state.hitboxes.sl_4d_slice = _draw_slider(surf, fp, th, cx + 54 + sl_w * 3, cy + 46, sl_w, "Τομή w = w₀", state.slice_w0, -1.25, 1.25, th.rgb.coral, 2);

    let plot_y = cy + ctl_h + 10;
    let plot_h = _max(240, ch - ctl_h - 10);
    let left_w = num_floor((cw - 12) * 0.56);
    let right_x = cx + left_w + 12;
    let right_w = cw - left_w - 12;

    let sc_4d = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "4D Στερεογραφική Προβολή SO(4) (" + state.poly4d_kind + ") & Τομή w₀=" + _fmt(state.slice_w0, 2)
    });
    sc_4d.rotate_4d("xw", state.rot_xw);
    sc_4d.rotate_4d("yw", state.rot_yw);
    sc_4d.rotate_4d("zw", state.rot_zw);
    sc_4d.set_slice("w", state.slice_w0);
    sc_4d.add_layer(ODG.layer_4d_polytope(state.poly4d_kind, map{ slice_w: state.slice_w0 }));
    _paint_odg_primitives(surf, fp, sc_4d.compile_primitives(left_w, plot_h, nil), cx, plot_y);

    let sc_slice = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "4D Υπερεπιφάνεια F(x,y,z,w₀)=0 (Τομή 3D)",
        xmin: -2.0, xmax: 2.0, ymin: -2.0, ymax: 2.0
    });
    sc_slice.set_camera_3d(34.0, 24.0, 0.0, 1.0, true);
    sc_slice.set_slice("w", state.slice_w0);
    sc_slice.add_layer(ODG.layer_4d_hypersurface_slice("sin(x) * cos(y) + 0.35 * z", map{ xmin: -2.2, xmax: 2.2, ymin: -2.2, ymax: 2.2, zmin: -2.2, zmax: 2.2 }, "z", state.slice_w0, 18, map{}));
    _paint_odg_primitives(surf, fp, sc_slice.compile_primitives(right_w, plot_h, map{ w: state.slice_w0 }), right_x, plot_y);
}

// ----------------------------------------------------------------------------
// Tab 4 Renderer: 5. N-D Πολυδιάστατα (Parallel / Radar / PCA / Andrews / 6D)
// ----------------------------------------------------------------------------
fn _paint_tab_nd_multivariate(surf, fp, th, state, cx, cy, cw, ch) {
    let ctl_h = 84;
    _draw_card(surf, th, cx, cy, cw, ctl_h, 10);
    state.hitboxes.nd_par = _draw_pill(surf, fp, th, cx + 12, cy + 10, 142, 26, "Parallel Coords 6D", state.nd_mode == "parallel", th.rgb.emerald, th.rgb.emerald_soft);
    state.hitboxes.nd_rad = _draw_pill(surf, fp, th, cx + 162, cy + 10, 118, 26, "Radar Star 6D", state.nd_mode == "radar", th.rgb.cyan, th.rgb.cyan_soft);
    state.hitboxes.nd_pca = _draw_pill(surf, fp, th, cx + 288, cy + 10, 134, 26, "PCA Subspace 3D", state.nd_mode == "pca", th.rgb.periwinkle, th.rgb.periwinkle_soft);
    state.hitboxes.nd_and = _draw_pill(surf, fp, th, cx + 430, cy + 10, 132, 26, "Andrews Curves", state.nd_mode == "andrews", th.rgb.amber, th.rgb.amber_soft);
    state.hitboxes.nd_hyp = _draw_pill(surf, fp, th, cx + 570, cy + 10, 126, 26, "6D Hypercube", state.nd_mode == "hypercube", th.rgb.coral, th.rgb.coral_soft);

    let sl_w = num_floor((cw - 48) / 2);
    state.hitboxes.sl_nd_brush = _draw_slider(surf, fp, th, cx + 12, cy + 46, sl_w, "Φίλτρο Brush Άξονα D1 (max)", state.nd_brush_hi, 3.0, 10.0, th.rgb.emerald, 2);
    state.hitboxes.sl_nd_rot = _draw_slider(surf, fp, th, cx + 28 + sl_w, cy + 46, sl_w, "Γωνία Ρότορα SO(6) (D0↔D4)", state.nd_rot_angle, -PI, PI, th.rgb.cyan, 2);

    let ds = _default_6d_dataset();
    let axes = ["Ισχύς", "Απόδοση", "Ακρίβεια", "Καθυστέρηση", "Ασφάλεια", "Κλίμακα"];
    let raw_mat = [];
    let labels = [];
    let k = 0;
    while k < len(ds) {
        array_push(raw_mat, ds[k].values);
        array_push(labels, ds[k].group);
        k = k + 1;
    }

    let plot_y = cy + ctl_h + 10;
    let plot_h = _max(240, ch - ctl_h - 10);
    let sc_nd = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Πολυδιάστατη Ανάλυση 6D — Λειτουργία [V]: " + state.nd_mode
    });

    if state.nd_mode == "parallel" {
        sc_nd.set_brush(0, 0.0, state.nd_brush_hi);
        sc_nd.add_layer(ODG.layer_nd_parallel_coords(raw_mat, axes, map{}));
    } else if state.nd_mode == "radar" {
        sc_nd.add_layer(ODG.layer_nd_radar([raw_mat[0], raw_mat[3], raw_mat[6]], axes, map{}));
    } else if state.nd_mode == "pca" {
        sc_nd.set_camera_3d(32.0 + state.nd_rot_angle * 35.0, 22.0, 0.0, 1.0, true);
        sc_nd.add_layer(ODG.layer_nd_pca_projection(raw_mat, labels, 3, map{}));
    } else if state.nd_mode == "andrews" {
        sc_nd.set_bounds_2d(-PI, PI, -18.0, 26.0);
        sc_nd.add_layer(ODG.layer_nd_andrews_curves(raw_mat, 80, map{}));
    } else {
        sc_nd.rotate_nd(0, 4, state.nd_rot_angle);
        sc_nd.rotate_nd(1, 5, state.nd_rot_angle * 0.7);
        sc_nd.add_layer(ODG.layer_nd_hypercube(6, map{}));
    }
    _paint_odg_primitives(surf, fp, sc_nd.compile_primitives(cw, plot_h, nil), cx, plot_y);
}

// ----------------------------------------------------------------------------
// Tab 5 Renderer: 6. PhotoMath • GeoGebra • MATLAB Unified Flagship Suite
// ----------------------------------------------------------------------------
fn _paint_tab_flagship(surf, fp, th, state, cx, cy, cw, ch) {
    // Optional enrichment probe of sibling flagship module (lazy & safe)
    let _fs_mod = _lazy_flagship_suites();
    let _il_mod = _lazy_interactive_lab();

    let col_gap = 10;
    let col_w = num_floor((cw - col_gap * 2) / 3);

    // Column 1: PhotoMath Symbolic Step-by-Step Solver Cards
    let c1x = cx;
    _draw_card(surf, th, c1x, cy, col_w, ch, 10);
    _surf_text(surf, fp, c1x + 14, cy + 12, "PhotoMath — Βήμα-προς-Βήμα Επίλυση", th.rgb.emerald, 13);
    _surf_text(surf, fp, c1x + 14, cy + 32, "Συμβολικός Παράγωγος & Ορισμένο Ολοκλήρωμα", th.rgb.text_muted, 11);

    let steps_cards = [
        map{ badge: "Βήμα 1 • Παράσταση", eq: "f(x) = x³ - 3x² + 2x", note: "Πολυώνυμο 3ου βαθμού με ρίζες x ∈ {0, 1, 2}", col: th.rgb.cyan },
        map{ badge: "Βήμα 2 • Κανόνας Δύναμης", eq: "f'(x) = d/dx(x³) - 3·d/dx(x²) + 2·d/dx(x)", note: "Εφαρμογή (xⁿ)' = n·xⁿ⁻¹ ανά όρο", col: th.rgb.periwinkle },
        map{ badge: "Βήμα 3 • Παράγωγος & Ακρότατα", eq: "f'(x) = 3x² - 6x + 2  ⇒  x* = 1 ± √3/3", note: "Τοπικό μέγιστο στο 0.423, ελάχιστο στο 1.577", col: th.rgb.emerald },
        map{ badge: "Βήμα 4 • Θεμελιώδες Θεώρημα (FTC)", eq: "∫₀² (x³ - 3x² + 2x) dx = [x⁴/4 - x³ + x²]₀² = 0", note: "Συμμετρική προσημασμένη επιφάνεια (+1/4 και -1/4)", col: th.rgb.amber },
        map{ badge: "Βήμα 5 • 2η Παράγωγος & Καμπυλότητα", eq: "f''(x) = 6x - 6 = 0  ⇒  Σημείο Καμπής x = 1", note: "Κοίλη για x < 1, Κυρτή για x > 1", col: th.rgb.coral }
    ];
    let si = 0;
    let card_h = _max(68, num_floor((ch - 72) / 5) - 6);
    while si < len(steps_cards) {
        let sc_item = steps_cards[si];
        let sy = cy + 56 + si * (card_h + 6);
        _draw_card(surf, th, c1x + 10, sy, col_w - 20, card_h, 8, th.rgb.surface_alt, th.rgb.border);
        _surf_text(surf, fp, c1x + 18, sy + 8, sc_item.badge, sc_item.col, 11);
        _surf_text(surf, fp, c1x + 18, sy + 26, sc_item.eq, th.rgb.text_primary, 12);
        _surf_text(surf, fp, c1x + 18, sy + 46, sc_item.note, th.rgb.text_secondary, 10);
        si = si + 1;
    }

    // Column 2: GeoGebra Dynamic Geometry — Live Euler Line (O - G - H)
    let c2x = cx + col_w + col_gap;
    _draw_card(surf, th, c2x, cy, col_w, ch, 10);
    let eu = compute_euler_triangle(state.sim_t);
    _surf_text(surf, fp, c2x + 14, cy + 12, "GeoGebra — Δυναμική Ευθεία Euler (O–G–H)", th.rgb.cyan, 13);
    _surf_text(surf, fp, c2x + 14, cy + 32, "Λόγος |GH| / |OG| = " + _fmt(eu.gh_to_og_ratio, 2) + " (Θεωρητικό: 2.00)", th.rgb.emerald, 11);

    let geo_h = _max(220, ch - 118);
    let sc_geo = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "Περίκεντρο O, Βαρύκεντρο G, Ορθόκεντρο H",
        xmin: -3.6, xmax: 3.6, ymin: -3.2, ymax: 3.4
    });
    // Circumcircle parametric curve
    sc_geo.add_layer(ODG.layer_2d_parametric("ox + cr * cos(u)", "oy + cr * sin(u)", "u", 0.0, TAU, 120, map{
        color: th.hex.periwinkle, label: "Περιγεγραμμένος"
    }));
    let geo_prims = sc_geo.compile_primitives(col_w - 16, geo_h, map{
        ox: eu.O[0], oy: eu.O[1], cr: eu.circum_r
    });
    _paint_odg_primitives(surf, fp, geo_prims, c2x + 8, cy + 54);

    // Overlay exact screen-projected triangle edges + Euler line O-G-H + labeled centers
    let pad_l = 58.0; let pad_r = 22.0; let pad_t = 38.0; let pad_b = 42.0;
    let pw = (col_w - 16) - pad_l - pad_r;
    let ph = geo_h - pad_t - pad_b;
    let map_gx = fn(wx) { return c2x + 8 + pad_l + ((wx - (-3.6)) / 7.2) * pw; };
    let map_gy = fn(wy) { return cy + 54 + pad_t + ph - ((wy - (-3.2)) / 6.6) * ph; };

    _surf_line(surf, map_gx(eu.A[0]), map_gy(eu.A[1]), map_gx(eu.B[0]), map_gy(eu.B[1]), th.rgb.cyan);
    _surf_line(surf, map_gx(eu.B[0]), map_gy(eu.B[1]), map_gx(eu.C[0]), map_gy(eu.C[1]), th.rgb.cyan);
    _surf_line(surf, map_gx(eu.C[0]), map_gy(eu.C[1]), map_gx(eu.A[0]), map_gy(eu.A[1]), th.rgb.cyan);
    // Extended Euler line passing through O -> G -> H
    _surf_dashed_line(surf, map_gx(eu.O[0]), map_gy(eu.O[1]), map_gx(eu.H[0]), map_gy(eu.H[1]), th.rgb.coral);

    _surf_rects(surf, UIK.rounded_rect(num_floor(map_gx(eu.O[0])) - 4, num_floor(map_gy(eu.O[1])) - 4, 8, 8, 4), th.rgb.cyan);
    _surf_rects(surf, UIK.rounded_rect(num_floor(map_gx(eu.G[0])) - 5, num_floor(map_gy(eu.G[1])) - 5, 10, 10, 5), th.rgb.emerald);
    _surf_rects(surf, UIK.rounded_rect(num_floor(map_gx(eu.H[0])) - 4, num_floor(map_gy(eu.H[1])) - 4, 8, 8, 4), th.rgb.coral);
    _surf_text(surf, fp, map_gx(eu.O[0]) + 6, map_gy(eu.O[1]) - 12, "O", th.rgb.cyan, 11);
    _surf_text(surf, fp, map_gx(eu.G[0]) + 6, map_gy(eu.G[1]) - 12, "G", th.rgb.emerald, 11);
    _surf_text(surf, fp, map_gx(eu.H[0]) + 6, map_gy(eu.H[1]) - 12, "H", th.rgb.coral, 11);

    let g_foot = cy + 60 + geo_h;
    _surf_text(surf, fp, c2x + 14, g_foot, "G=(" + _fmt(eu.G[0], 2) + "," + _fmt(eu.G[1], 2) + ")  O=(" + _fmt(eu.O[0], 2) + "," + _fmt(eu.O[1], 2) + ")", th.rgb.text_secondary, 11);
    _surf_text(surf, fp, c2x + 14, g_foot + 20, "H=(" + _fmt(eu.H[0], 2) + "," + _fmt(eu.H[1], 2) + ")  R=" + _fmt(eu.circum_r, 2) + " (H = 3G - 2O)", th.rgb.amber, 11);

    // Column 3: MATLAB Control Systems — Closed-Loop PID Step Response
    let c3x = cx + (col_w + col_gap) * 2;
    let c3w = cw - (col_w + col_gap) * 2;
    _draw_card(surf, th, c3x, cy, c3w, ch, 10);
    _surf_text(surf, fp, c3x + 14, cy + 12, "MATLAB — Απόκριση Βήματος Ελεγκτή PID", th.rgb.amber, 13);

    let pid = simulate_pid_step_response(state.pid_kp, state.pid_ki, state.pid_kd, 8.0, 140);
    _surf_text(surf, fp, c3x + 14, cy + 32, "Rise: " + _fmt(pid.rise_time, 2) + "s | Overshoot: " + _fmt(pid.overshoot_pct, 1) + "% | SS Err: " + _fmt(pid.ss_error, 3), th.rgb.text_secondary, 11);

    state.hitboxes.sl_pid_kp = _draw_slider(surf, fp, th, c3x + 14, cy + 56, c3w - 28, "Κέρδος Αναλογικού Kp", state.pid_kp, 0.20, 6.00, th.rgb.emerald, 2);
    state.hitboxes.sl_pid_ki = _draw_slider(surf, fp, th, c3x + 14, cy + 92, c3w - 28, "Κέρδος Ολοκληρωτικού Ki", state.pid_ki, 0.00, 4.50, th.rgb.cyan, 2);
    state.hitboxes.sl_pid_kd = _draw_slider(surf, fp, th, c3x + 14, cy + 128, c3w - 28, "Κέρδος Παραγωγικού Kd", state.pid_kd, 0.00, 2.50, th.rgb.amber, 2);

    let pid_plot_y = cy + 168;
    let pid_plot_h = _max(180, ch - 178);
    let sc_pid = ODG.create_scene(map{
        theme: _odg_theme_name(state),
        title: "y(t) vs Αναφορά r(t)=1.0",
        xmin: 0.0, xmax: 8.0, ymin: 0.0, ymax: 1.55,
        x_label: "t (sec)", y_label: "y(t)"
    });
    sc_pid.add_layer(ODG.layer_2d_explicit("1.0", 0.0, 8.0, map{ color: th.hex.coral, samples: 30, label: "r(t)=1" }));
    sc_pid.add_layer(ODG.layer_scatter_regression(pid.ts, pid.ys, 0, map{
        color: th.hex.emerald, connect_line: true, point_radius: 2, label: "PID y(t)"
    }));
    _paint_odg_primitives(surf, fp, sc_pid.compile_primitives(c3w - 16, pid_plot_h, nil), c3x + 8, pid_plot_y);
}

// ----------------------------------------------------------------------------
// Tab 6 Renderer: 7. Κάρτες Εννοιών & SI (Universal Cards & Π)
// ----------------------------------------------------------------------------
fn _paint_tab_universal_cards(surf, fp, th, state, cx, cy, cw, ch) {
    // Optional lazy probe of sibling universal_concept_cards.sapp module
    let _uc_mod = _lazy_universal_cards();
    let presets = universal_concept_presets();
    let d_idx = _clamp(state.uc_domain_idx, 0, len(presets) - 1);
    let dom = _compute_universal_domain_state(d_idx, state.uc_scale_k, state.sim_t);

    // 1. Domain Selector Pills Strip + Live Scale Slider k (84px)
    let ctl_h = 82;
    _draw_card(surf, th, cx, cy, cw, ctl_h, 10);
    let pill_gap = 6;
    let cycle_w = 108;
    let avail_pills_w = cw - 24 - cycle_w - pill_gap * 6;
    let pw = _max(92, num_floor(avail_pills_w / 6));
    let pi = 0;
    while pi < len(presets) {
        let px = cx + 12 + pi * (pw + pill_gap);
        let hb = _draw_pill(surf, fp, th, px, cy + 8, pw, 26, presets[pi].pill, d_idx == pi, th.rgb.emerald, th.rgb.emerald_soft);
        state.hitboxes["uc_dom_" + str(pi)] = hb;
        pi = pi + 1;
    }
    state.hitboxes.uc_cycle_btn = _draw_pill(surf, fp, th, cx + cw - cycle_w - 12, cy + 8, cycle_w, 26, "[D] Πεδίο ↻", false, th.rgb.cyan, th.rgb.cyan_soft);

    // Active preset full title + SI badge + Scale k slider
    _surf_text(surf, fp, cx + 14, cy + 44, dom.preset_label, th.rgb.emerald, 12);
    _surf_text(surf, fp, cx + 14, cy + 61, dom.formula_main, th.rgb.text_secondary, 11);

    let sl_w = _clamp(num_floor(cw * 0.28), 180, 340);
    let sl_x = cx + cw - sl_w - 190;
    state.hitboxes.sl_uc_k = _draw_slider(surf, fp, th, sl_x, cy + 42, sl_w, "Κλίμακα / Μονάδες k", state.uc_scale_k, 0.50, 5.00, th.rgb.amber, 2);
    _draw_pill(surf, fp, th, cx + cw - 172, cy + 45, 160, 26, dom.badge_el, true, th.rgb.emerald, th.rgb.emerald_soft);

    // 2. Five KPI Tiles Row (74px)
    let kpi_y = cy + ctl_h + 8;
    let kpi_h = 74;
    let kpi_gap = 8;
    let kpi_w = num_floor((cw - kpi_gap * 4) / 5);
    let ki = 0;
    while ki < 5 {
        let kp = dom.kpis[ki];
        let kx = cx + ki * (kpi_w + kpi_gap);
        let kw_use = if ki == 4 { cw - (kpi_w + kpi_gap) * 4 } else { kpi_w };
        let kcol = if kp.tier == "emerald" { th.rgb.emerald }
            else if kp.tier == "amber" { th.rgb.amber }
            else if kp.tier == "coral" { th.rgb.coral }
            else if kp.tier == "periwinkle" { th.rgb.periwinkle }
            else { th.rgb.cyan };
        _draw_card(surf, th, kx, kpi_y, kw_use, kpi_h, 10);
        _surf_text(surf, fp, kx + 10, kpi_y + 8, kp.title, th.rgb.text_muted, 11);
        _surf_text(surf, fp, kx + 10, kpi_y + 27, kp.val, kcol, 18);
        _surf_text(surf, fp, kx + 10, kpi_y + 52, kp.sub, kcol, 10);
        ki = ki + 1;
    }

    // 3. Lower Split: Left = Live Scale/SI Invariance Bars | Right = Buckingham Pi + Βήμα 1..4 Cards
    let body_y = kpi_y + kpi_h + 8;
    let body_h = _max(210, ch - (ctl_h + kpi_h + 16));
    let left_w = num_floor((cw - 10) * 0.46);
    let right_x = cx + left_w + 10;
    let right_w = cw - left_w - 10;

    // Left Card: Πριν (k=1) vs Μετά (k=...) Comparison Bars (Emerald Invariant vs Coral/Amber Dependent!)
    _draw_card(surf, th, cx, body_y, left_w, body_h, 10);
    _surf_text(surf, fp, cx + 14, body_y + 10, "Πριν (k=1) vs Μετά (k=" + _fmt(state.uc_scale_k, 2) + ") — Έλεγχος Αναλλοίωτου", th.rgb.text_primary, 13);
    _surf_text(surf, fp, cx + 14, body_y + 28, "Σμαραγδί = Αδιάστατο (p=0, SI [1])  •  Κεχριμπάρι/Κοράλλι = Εξαρτώμενο (p≠0)", th.rgb.text_muted, 10);

    let max_bval = 0.25;
    let bi = 0;
    while bi < len(dom.bars) {
        if _abs(dom.bars[bi].before) > max_bval { max_bval = _abs(dom.bars[bi].before); }
        if _abs(dom.bars[bi].after) > max_bval { max_bval = _abs(dom.bars[bi].after); }
        bi = bi + 1;
    }
    max_bval = max_bval * 1.22;

    let chart_bot = body_y + body_h - 68;
    let chart_max_h = _max(60, body_h - 132);
    _surf_line(surf, cx + 18, chart_bot, cx + left_w - 18, chart_bot, th.rgb.border);

    let grp_w = num_floor((left_w - 36) / 3);
    let bar_each_w = _clamp(num_floor(grp_w * 0.32), 18, 44);
    bi = 0;
    while bi < len(dom.bars) {
        let br = dom.bars[bi];
        let gx = cx + 22 + bi * grp_w;
        let h_bef = _max(6, num_floor((_abs(br.before) / max_bval) * chart_max_h));
        let h_aft = _max(6, num_floor((_abs(br.after) / max_bval) * chart_max_h));
        let aft_col = if br.invariant { th.rgb.emerald } else { th.rgb.coral };
        let aft_soft = if br.invariant { th.rgb.emerald_soft } else { th.rgb.amber_soft };

        // Before bar (k = 1)
        _surf_rects(surf, UIK.rounded_rect(gx, chart_bot - h_bef, bar_each_w, h_bef, 4), th.rgb.cyan);
        _surf_text(surf, fp, gx - 2, chart_bot - h_bef - 14, _fmt(br.before, 2), th.rgb.cyan, 10);

        // After bar (k = uc_scale_k)
        let gx2 = gx + bar_each_w + 8;
        _surf_rects(surf, UIK.rounded_rect(gx2, chart_bot - h_aft, bar_each_w, h_aft, 4), aft_col);
        _surf_text(surf, fp, gx2 - 2, chart_bot - h_aft - 14, _fmt(br.after, 2), aft_col, 10);

        // Metric name + Invariance pill
        _surf_text(surf, fp, gx - 2, chart_bot + 6, br.name, th.rgb.text_primary, 10);
        _draw_pill(surf, fp, th, gx - 4, chart_bot + 22, _min(grp_w - 8, 126), 20, br.note, true, aft_col, aft_soft);
        bi = bi + 1;
    }
    _surf_text(surf, fp, cx + 14, body_y + body_h - 18, "Διαστάσεις SI: " + dom.si_dim, th.rgb.periwinkle, 11);

    // Right Top Card: Buckingham Pi Groups & Euler Homogeneity Degree p
    let pi_box_h = 98;
    _draw_card(surf, th, right_x, body_y, right_w, pi_box_h, 10);
    _surf_text(surf, fp, right_x + 12, body_y + 8, "Θεώρημα Buckingham Π & Ομογένεια Euler (x·∇f = p·f)", th.rgb.cyan, 12);
    _surf_text(surf, fp, right_x + 12, body_y + 26, dom.pi_summary, th.rgb.text_secondary, 10);
    let gi = 0;
    while gi < len(dom.pi_groups) and gi < 3 {
        let gy = body_y + 44 + gi * 16;
        let gcol = if gi < 2 { th.rgb.emerald } else { th.rgb.amber };
        _surf_text(surf, fp, right_x + 14, gy, "• " + dom.pi_groups[gi], gcol, 10);
        gi = gi + 1;
    }

    // Right Bottom Card: Βήμα 1..4 Pedagogical Summary Cards
    let st_box_y = body_y + pi_box_h + 8;
    let st_box_h = _max(110, body_h - pi_box_h - 8);
    _draw_card(surf, th, right_x, st_box_y, right_w, st_box_h, 10);
    _surf_text(surf, fp, right_x + 12, st_box_y + 8, "Αναλυτική Απόδειξη & Ερμηνεία (Βήμα 1..4)", th.rgb.emerald, 12);

    let step_avail_h = st_box_h - 32;
    let step_card_h = _max(38, num_floor((step_avail_h - 18) / 4));
    let si = 0;
    while si < len(dom.steps) and si < 4 {
        let st_it = dom.steps[si];
        let sy = st_box_y + 28 + si * (step_card_h + 4);
        let scol = if st_it.col == "emerald" { th.rgb.emerald }
            else if st_it.col == "amber" { th.rgb.amber }
            else if st_it.col == "coral" { th.rgb.coral }
            else if st_it.col == "periwinkle" { th.rgb.periwinkle }
            else { th.rgb.cyan };
        _draw_card(surf, th, right_x + 10, sy, right_w - 20, step_card_h, 6, th.rgb.surface_alt, th.rgb.border);
        _surf_text(surf, fp, right_x + 18, sy + 4, st_it.badge + "  |  " + st_it.eq, scol, 10);
        if step_card_h >= 34 {
            _surf_text(surf, fp, right_x + 18, sy + 20, st_it.note, th.rgb.text_secondary, 10);
        }
        si = si + 1;
    }
}

// ----------------------------------------------------------------------------
// Master Frame Painter + Input/Physics Dispatcher
// ----------------------------------------------------------------------------
fn _paint_math_studio_frame(surf, fp, state) {
    let sz = _surf_size(surf);
    let win_w = _max(640, sz.w);
    let win_h = _max(480, sz.h);
    let th = _current_theme(state);
    state.hitboxes = map{ tabs: [] };

    _surf_clear(surf, th.rgb.bg);

    // Top Header Bar (0..44)
    _surf_rects(surf, [map{ x: 0, y: 0, w: win_w, h: 44 }], th.rgb.header_bg);
    _surf_rects(surf, [map{ x: 0, y: 44, w: win_w, h: 1 }], th.rgb.border);
    _surf_text(surf, fp, 16, 14, MATH_STUDIO_TITLE, th.rgb.text_primary, 14);

    let play_lbl = if state.playing { "⏸ Pause [Space]" } else { "▶ Play 60FPS [Space]" };
    state.hitboxes.play_btn = _draw_pill(surf, fp, th, win_w - 344, 9, 164, 26, play_lbl, state.playing, th.rgb.emerald, th.rgb.emerald_soft);
    let th_lbl = if state.theme_mode == "dark" { "[T] Obsidian Dark" } else { "[T] Alabaster Light" };
    state.hitboxes.theme_btn = _draw_pill(surf, fp, th, win_w - 172, 9, 156, 26, th_lbl, false, th.rgb.cyan, th.rgb.cyan_soft);

    // 7-Tab Navigation Bar (50..82)
    let tabs = math_studio_tabs();
    let tab_margin = 12;
    let tab_gap = 6;
    let tab_w = num_floor((win_w - tab_margin * 2 - tab_gap * (len(tabs) - 1)) / len(tabs));
    let max_tab_chars = _max(10, num_floor((tab_w - 18) / 6.3));
    let ti = 0;
    while ti < len(tabs) {
        let tx = tab_margin + ti * (tab_w + tab_gap);
        let disp_lbl = tabs[ti].label;
        if len(disp_lbl) > max_tab_chars and map_has(tabs[ti], "short_label") {
            disp_lbl = tabs[ti].short_label;
        }
        if len(disp_lbl) > max_tab_chars {
            disp_lbl = str_slice(disp_lbl, 0, max_tab_chars);
        }
        let hb = _draw_pill(surf, fp, th, tx, 52, tab_w, 28, disp_lbl, state.active_tab == ti, th.rgb.emerald, th.rgb.emerald_soft);
        array_push(state.hitboxes.tabs, hb);
        ti = ti + 1;
    }

    // Content Workspace Area
    let cx = 12;
    let cy = 88;
    let cw = win_w - 24;
    let ch = win_h - 98;

    if state.active_tab == 0 {
        _paint_tab_stats(surf, fp, th, state, cx, cy, cw, ch);
    } else if state.active_tab == 1 {
        _paint_tab_2d_live(surf, fp, th, state, cx, cy, cw, ch);
    } else if state.active_tab == 2 {
        _paint_tab_3d_surfaces(surf, fp, th, state, cx, cy, cw, ch);
    } else if state.active_tab == 3 {
        _paint_tab_4d_hyperspace(surf, fp, th, state, cx, cy, cw, ch);
    } else if state.active_tab == 4 {
        _paint_tab_nd_multivariate(surf, fp, th, state, cx, cy, cw, ch);
    } else if state.active_tab == 5 {
        _paint_tab_flagship(surf, fp, th, state, cx, cy, cw, ch);
    } else {
        _paint_tab_universal_cards(surf, fp, th, state, cx, cy, cw, ch);
    }

    _surf_present(surf);
}

fn _apply_slider_drag(state, slider_id, mx) {
    if slider_id == "" or not map_has(state.hitboxes, slider_id) { return false; }
    let sl = state.hitboxes[slider_id];
    if sl == nil { return false; }
    let ratio = _clamp((mx - sl.track_x) / _max(1.0, sl.track_w * 1.0), 0.0, 1.0);
    let val = sl.lo + (sl.hi - sl.lo) * ratio;
    if slider_id == "sl_stat_mean" { state.stat_mean_shift = val; }
    else if slider_id == "sl_stat_spread" { state.stat_spread_mult = val; }
    else if slider_id == "sl_stat_k" { state.stat_scale_k = val; }
    else if slider_id == "sl_2d_a" { state.amp_a = val; }
    else if slider_id == "sl_2d_w" { state.freq_w = val; }
    else if slider_id == "sl_2d_phi" { state.phase_phi = val; }
    else if slider_id == "sl_4d_xw" { state.rot_xw = val; }
    else if slider_id == "sl_4d_yw" { state.rot_yw = val; }
    else if slider_id == "sl_4d_zw" { state.rot_zw = val; }
    else if slider_id == "sl_4d_slice" { state.slice_w0 = val; }
    else if slider_id == "sl_nd_brush" { state.nd_brush_hi = val; }
    else if slider_id == "sl_nd_rot" { state.nd_rot_angle = val; }
    else if slider_id == "sl_pid_kp" { state.pid_kp = val; }
    else if slider_id == "sl_pid_ki" { state.pid_ki = val; }
    else if slider_id == "sl_pid_kd" { state.pid_kd = val; }
    else if slider_id == "sl_uc_k" { state.uc_scale_k = val; }
    return true;
}

fn _step_studio_animation(state, dt_sec) {
    state.sim_t = state.sim_t + dt_sec;

    // Advance Tab 1 phase slider according to Ping-Pong / Loop / Once mode
    let speed = 1.65;
    if state.anim_mode == "ping_pong" {
        state.phase_phi = state.phase_phi + state.anim_dir * speed * dt_sec;
        if state.phase_phi > PI { state.phase_phi = PI; state.anim_dir = -1.0; }
        if state.phase_phi < -PI { state.phase_phi = -PI; state.anim_dir = 1.0; }
    } else if state.anim_mode == "loop" {
        state.phase_phi = state.phase_phi + speed * dt_sec;
        if state.phase_phi > PI { state.phase_phi = -PI; }
    } else {
        state.phase_phi = _min(PI, state.phase_phi + speed * dt_sec);
        if state.phase_phi >= PI { state.playing = false; }
    }

    // Advance 4D SO(4) & N-D smooth rotors when playing
    state.rot_xw = num_mod(state.rot_xw + 0.55 * dt_sec + PI, TAU) - PI;
    state.rot_yw = num_mod(state.rot_yw + 0.37 * dt_sec + PI, TAU) - PI;
    state.nd_rot_angle = num_mod(state.nd_rot_angle + 0.45 * dt_sec + PI, TAU) - PI;
}

fn _handle_studio_events(state, events) {
    let dirty = false;
    let should_quit = false;
    let slider_ids = [
        "sl_stat_mean", "sl_stat_spread", "sl_stat_k",
        "sl_2d_a", "sl_2d_w", "sl_2d_phi",
        "sl_4d_xw", "sl_4d_yw", "sl_4d_zw", "sl_4d_slice",
        "sl_nd_brush", "sl_nd_rot",
        "sl_pid_kp", "sl_pid_ki", "sl_pid_kd",
        "sl_uc_k"
    ];

    let ei = 0;
    while ei < len(events) {
        let ev = events[ei];
        let kind = str_lower(str(try ev.type catch (try ev.kind catch "")));

        if kind == "quit" or kind == "close" {
            should_quit = true;
        } else if kind == "resize" or kind == "expose" {
            dirty = true;
        } else if kind == "wheel" or kind == "scroll" {
            let dy = _num_or(try ev.dy catch (try ev.delta catch 0.0), 0.0);
            let factor = if dy > 0.0 { 1.12 } else { 0.89 };
            if state.active_tab == 2 { state.zoom_3d = _clamp(state.zoom_3d * factor, 0.35, 3.5); }
            else { state.zoom_2d = _clamp(state.zoom_2d * factor, 0.25, 6.0); }
            dirty = true;
        } else if kind == "mousedown" or kind == "buttondown" {
            let mx = _num_or(try ev.x catch state.mouse_x, state.mouse_x);
            let my = _num_or(try ev.y catch state.mouse_y, state.mouse_y);
            let btn = _int_or(try ev.button catch 1, 1);
            state.mouse_x = mx; state.mouse_y = my;
            state.last_drag_x = mx; state.last_drag_y = my;

            if btn == 3 {
                state.panning_view = true;
            } else {
                state.mouse_down_left = true;
                state.formula_focused = false;

                // Top header buttons
                if _pt_in_rect(mx, my, try state.hitboxes.play_btn catch nil) {
                    state.playing = not state.playing; dirty = true;
                } else if _pt_in_rect(mx, my, try state.hitboxes.theme_btn catch nil) {
                    state.theme_mode = if state.theme_mode == "dark" { "light" } else { "dark" }; dirty = true;
                }

                // 7 Tabs
                let tabs_hb = try state.hitboxes.tabs catch [];
                let ti = 0;
                while ti < len(tabs_hb) {
                    if _pt_in_rect(mx, my, tabs_hb[ti]) { state.active_tab = ti; dirty = true; }
                    ti = ti + 1;
                }

                // Tab-specific pills & sliders
                if _pt_in_rect(mx, my, try state.hitboxes.stat_sample catch nil) { state.stat_is_sample = true; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.stat_pop catch nil) { state.stat_is_sample = false; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.preset_0 catch nil) { state.stat_preset_idx = 0; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.preset_1 catch nil) { state.stat_preset_idx = 1; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.preset_2 catch nil) { state.stat_preset_idx = 2; dirty = true; }

                if _pt_in_rect(mx, my, try state.hitboxes.formula_box catch nil) { state.formula_focused = true; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.anim_mode_btn catch nil) {
                    state.anim_mode = if state.anim_mode == "ping_pong" { "loop" } else if state.anim_mode == "loop" { "once" } else { "ping_pong" };
                    dirty = true;
                }
                if _pt_in_rect(mx, my, try state.hitboxes.reset_2d_btn catch nil) {
                    state.pan_2d_x = 0.0; state.pan_2d_y = 0.0; state.zoom_2d = 1.0; dirty = true;
                }
                if _pt_in_rect(mx, my, try state.hitboxes.reset_3d_btn catch nil) {
                    state.yaw_3d = 38.0; state.pitch_3d = 26.0; state.zoom_3d = 1.05; dirty = true;
                }

                if _pt_in_rect(mx, my, try state.hitboxes.p4_tess catch nil) { state.poly4d_kind = "tesseract"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.p4_16 catch nil) { state.poly4d_kind = "16cell"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.p4_24 catch nil) { state.poly4d_kind = "24cell"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.p4_cliff catch nil) { state.poly4d_kind = "clifford_torus"; dirty = true; }

                if _pt_in_rect(mx, my, try state.hitboxes.nd_par catch nil) { state.nd_mode = "parallel"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.nd_rad catch nil) { state.nd_mode = "radar"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.nd_pca catch nil) { state.nd_mode = "pca"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.nd_and catch nil) { state.nd_mode = "andrews"; dirty = true; }
                if _pt_in_rect(mx, my, try state.hitboxes.nd_hyp catch nil) { state.nd_mode = "hypercube"; dirty = true; }

                // Tab 6 (7th tab) domain selector pills + cycle button
                let uci = 0;
                while uci < 6 {
                    let ukey = "uc_dom_" + str(uci);
                    if map_has(state.hitboxes, ukey) and _pt_in_rect(mx, my, state.hitboxes[ukey]) {
                        state.uc_domain_idx = uci;
                        dirty = true;
                    }
                    uci = uci + 1;
                }
                if _pt_in_rect(mx, my, try state.hitboxes.uc_cycle_btn catch nil) {
                    state.uc_domain_idx = num_mod(state.uc_domain_idx + 1, 6);
                    dirty = true;
                }

                // Check sliders
                let si = 0;
                while si < len(slider_ids) {
                    let sid = slider_ids[si];
                    if map_has(state.hitboxes, sid) and _pt_in_rect(mx, my, state.hitboxes[sid]) {
                        state.active_slider_id = sid;
                        _apply_slider_drag(state, sid, mx);
                        dirty = true;
                    }
                    si = si + 1;
                }

                // 3D Orbit drag if clicked inside 3D viewport
                if state.active_slider_id == "" and state.active_tab == 2 and _pt_in_rect(mx, my, try state.hitboxes.viewport_3d catch nil) {
                    state.dragging_3d = true;
                }
            }
        } else if kind == "mouseup" or kind == "buttonup" {
            state.mouse_down_left = false;
            state.active_slider_id = "";
            state.dragging_3d = false;
            state.panning_view = false;
        } else if kind == "mousemove" or kind == "motion" {
            let mx = _num_or(try ev.x catch state.mouse_x, state.mouse_x);
            let my = _num_or(try ev.y catch state.mouse_y, state.mouse_y);
            let dx = mx - state.last_drag_x;
            let dy = my - state.last_drag_y;
            state.last_drag_x = mx; state.last_drag_y = my;
            state.mouse_x = mx; state.mouse_y = my;

            if state.active_slider_id != "" {
                if _apply_slider_drag(state, state.active_slider_id, mx) { dirty = true; }
            } else if state.dragging_3d {
                state.yaw_3d = state.yaw_3d + dx * 0.55;
                state.pitch_3d = _clamp(state.pitch_3d + dy * 0.45, -85.0, 85.0);
                dirty = true;
            } else if state.panning_view {
                state.pan_2d_x = state.pan_2d_x - dx * 0.02 / _max(0.25, state.zoom_2d);
                state.pan_2d_y = state.pan_2d_y + dy * 0.02 / _max(0.25, state.zoom_2d);
                dirty = true;
            }
        } else if kind == "keydown" or kind == "key" {
            let key_s = str(try ev.key catch (try ev.text catch ""));
            let kl = str_lower(key_s);
            if kl == "escape" {
                if state.formula_focused { state.formula_focused = false; dirty = true; }
                else { should_quit = true; }
            } else if state.formula_focused {
                if kl == "backspace" {
                    if len(state.formula_str) > 0 {
                        state.formula_str = str_slice(state.formula_str, 0, len(state.formula_str) - 1);
                    }
                    let c_try = ODG.compile_math_expr(state.formula_str);
                    state.formula_valid = _is_true(c_try.ok);
                    dirty = true;
                } else if kl == "return" or kl == "enter" {
                    let c_try = ODG.compile_math_expr(state.formula_str);
                    state.formula_valid = _is_true(c_try.ok);
                    state.formula_focused = false;
                    dirty = true;
                } else if len(key_s) == 1 {
                    state.formula_str = state.formula_str + key_s;
                    let c_try = ODG.compile_math_expr(state.formula_str);
                    state.formula_valid = _is_true(c_try.ok);
                    dirty = true;
                }
            } else {
                if kl == " " or kl == "space" { state.playing = not state.playing; dirty = true; }
                else if kl == "t" { state.theme_mode = if state.theme_mode == "dark" { "light" } else { "dark" }; dirty = true; }
                else if kl == "1" { state.active_tab = 0; dirty = true; }
                else if kl == "2" { state.active_tab = 1; dirty = true; }
                else if kl == "3" { state.active_tab = 2; dirty = true; }
                else if kl == "4" { state.active_tab = 3; dirty = true; }
                else if kl == "5" { state.active_tab = 4; dirty = true; }
                else if kl == "6" { state.active_tab = 5; dirty = true; }
                else if kl == "7" { state.active_tab = 6; dirty = true; }
                else if kl == "d" {
                    state.uc_domain_idx = num_mod(state.uc_domain_idx + 1, 6);
                    dirty = true;
                }
                else if kl == "m" {
                    state.anim_mode = if state.anim_mode == "ping_pong" { "loop" } else if state.anim_mode == "loop" { "once" } else { "ping_pong" };
                    dirty = true;
                } else if kl == "v" {
                    state.nd_mode = if state.nd_mode == "parallel" { "radar" }
                        else if state.nd_mode == "radar" { "pca" }
                        else if state.nd_mode == "pca" { "andrews" }
                        else if state.nd_mode == "andrews" { "hypercube" }
                        else { "parallel" };
                    dirty = true;
                }
            }
        }
        ei = ei + 1;
    }

    return map{ dirty: dirty, should_quit: should_quit };
}

// Launches the Native Interactive Math & Statistics Studio (`gfx*` X11 / Win32 / Headless / Virtual)
fn run_native_math_studio(opts = nil) {
    let cfg = if is_map(opts) { opts } else { map{} };
    let win_w = _max(640, _int_or(try cfg.width catch 1200, 1200));
    let win_h = _max(480, _int_or(try cfg.height catch 760, 760));
    let title = str(try cfg.title catch MATH_STUDIO_TITLE);
    let max_frames = _int_or(try cfg.max_frames catch 0, 0);
    let max_ticks = _int_or(try cfg.max_ticks catch 0, 0);
    let cycle_tabs = _is_true(try cfg.cycle_tabs catch false);
    let force_virtual = _is_true(try cfg.virtual catch false);

    let hl_env = str_trim(str(try env_get("PBLANG_GFX_HEADLESS") catch ""));
    let is_headless = hl_env == "1" or str_lower(hl_env) == "true";

    let surf = _open_native_or_virtual_surface(title, win_w, win_h, force_virtual);
    let fp = _resolve_ui_font_path();
    let state = _init_studio_state(cfg);

    let num_tabs = len(math_studio_tabs());
    let rendered_frames = 0;
    let skipped_idle_ticks = 0;
    let total_ticks = 0;
    let tab_counts = [0, 0, 0, 0, 0, 0, 0];
    let tabs_visited = [];

    let mark_tab_visited = fn(t_idx) {
        if t_idx >= 0 and t_idx < len(tab_counts) {
            tab_counts[t_idx] = tab_counts[t_idx] + 1;
        }
        let found = false;
        let i = 0;
        while i < len(tabs_visited) {
            if tabs_visited[i] == t_idx { found = true; }
            i = i + 1;
        }
        if not found { array_push(tabs_visited, t_idx); }
    };

    let last_ms = now_ms();
    let dirty = true;

    while _surf_is_open(surf) {
        let frame_t0 = now_ms();
        let dt_sec = _clamp((frame_t0 - last_ms) / 1000.0, 0.004, 0.05);
        last_ms = frame_t0;

        let evs = _surf_poll(surf);
        let ev_res = _handle_studio_events(state, evs);
        if ev_res.should_quit { break; }
        if ev_res.dirty { dirty = true; }

        if cycle_tabs {
            state.active_tab = num_mod(rendered_frames, num_tabs);
            dirty = true;
        }

        if state.playing {
            _step_studio_animation(state, if max_frames > 0 { 0.04 } else { dt_sec });
            dirty = true;
        }

        if dirty {
            _paint_math_studio_frame(surf, fp, state);
            mark_tab_visited(state.active_tab);
            rendered_frames = rendered_frames + 1;
            dirty = false;
        } else {
            skipped_idle_ticks = skipped_idle_ticks + 1;
        }

        total_ticks = total_ticks + 1;
        if max_frames > 0 and rendered_frames >= max_frames { break; }
        if max_ticks > 0 and total_ticks >= max_ticks { break; }

        // Hardware Governor frame pacing (skip sleep during deterministic bounded test runs)
        if max_frames <= 0 {
            let elapsed_ms = now_ms() - frame_t0;
            let pace = Gov.govern_frame_pace(elapsed_ms, map{
                target_fps: if state.playing { 60 } else { 30 },
                idle: (not state.playing) and len(evs) == 0
            });
            let sleep_dur = _int_or(try pace.sleep_ms catch 16, 16);
            if sleep_dur > 0 { sleep_ms(_min(sleep_dur, 33)); }
        }
    }

    let final_sz = _surf_size(surf);
    _surf_close(surf);

    let mode_str = if surf.is_virtual { "virtual" } else if is_headless { "headless_gfx" } else { "native_gfx" };
    return map{
        ok: true,
        version: MATH_STUDIO_VERSION,
        title: title,
        mode: mode_str,
        headless: is_headless,
        is_virtual: surf.is_virtual,
        width: final_sz.w,
        height: final_sz.h,
        rendered_frames: rendered_frames,
        total_ticks: total_ticks,
        skipped_idle_ticks: skipped_idle_ticks,
        tabs_visited: tabs_visited,
        tab_render_counts: tab_counts,
        active_tab: state.active_tab,
        uc_domain_idx: state.uc_domain_idx,
        playing: state.playing,
        theme: state.theme_mode,
        draw_ops: surf.draw_ops
    };
}

export MATH_STUDIO_VERSION, MATH_STUDIO_TITLE,
       studio_theme_dark, studio_theme_light,
       math_studio_tabs, stat_presets, universal_concept_presets,
       compute_statistical_summary, render_statistical_concept_svg, render_any_concept_svg,
       compute_euler_triangle, simulate_pid_step_response,
       run_native_math_studio;
