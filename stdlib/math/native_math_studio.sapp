let MATH_STUDIO_VERSION = "2.6.0";
let MATH_STUDIO_TITLE = "PBLang v2.6.0 — Native Interactive Math & Statistics Studio";
let PI = 3.14159265358979323846;
let TAU = 6.28318530717958647692;

// Lazy loaders for sibling modules so concurrent testing never fails at import time
fn _lazy_interactive_lab() {
    return try import("stdlib:math/interactive_lab.sapp") catch (try import("stdlib/math/interactive_lab.sapp") catch nil);
}

fn _lazy_flagship_suites() {
    return try import("stdlib:math/flagship_suites.sapp") catch (try import("stdlib/math/flagship_suites.sapp") catch nil);
}

fn _lazy_universal_cards() {
    return try import("stdlib:math/universal_concept_cards.sapp") catch (try import("stdlib/math/universal_concept_cards.sapp") catch nil);
}

fn _lazy_math_facade() {
    return try import("stdlib:mathematics.sapp") catch (try import("stdlib/mathematics.sapp") catch nil);
}

// ============================================================================
// 1. Obsidian Dark & Alabaster Light WCAG AAA Design System + Helpers
// ============================================================================

fn _is_true(val) {
    if type(val) == "bool" { return val; }
    return false;
}

fn _min(a, b) { if a < b { return a; } return b; }
fn _max(a, b) { if a > b { return a; } return b; }

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _abs(v) {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

fn _num_or(v, fb) {
    if v == nil { return fb; }
    if type(v) == "number" {
        if v == v and (v - v) == 0 { return v; }
        return fb;
    }
    let n = try parse_number(str_trim(str(v))) catch nil;
    if n != nil and n == n and (n - n) == 0 { return n; }
    return fb;
}

fn _int_or(v, fb) {
    return num_floor(_num_or(v, fb));
}

fn _fmt(v, digits = 2) {
    if type(v) != "number" or not (v == v) or (v - v) != 0 { return "0.00"; }
    let av = _abs(v);
    let sc = 1.0;
    let d = 0;
    while d < digits { sc = sc * 10.0; d = d + 1; }
    let r = num_floor(av * sc + 0.5) / sc;
    let sgn = if v < -1e-11 and r > 0.0 { "-" } else { "" };
    let ip = num_floor(r);
    if digits <= 0 { return sgn + str(ip); }
    let rem = num_floor((r - ip) * sc + 0.5);
    if rem >= sc { ip = ip + 1; rem = 0; }
    let fs = str(rem);
    while len(fs) < digits { fs = "0" + fs; }
    return sgn + str(ip) + "." + fs;
}

