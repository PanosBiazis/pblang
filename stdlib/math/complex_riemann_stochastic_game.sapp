// stdlib/math/complex_riemann_stochastic_game.sapp
// Pure PBLang (v2.5.0) Sovereign Mathematical Engine — Wave 4:
//   1. Complex Analysis (MSC 30): Complex field arithmetic & elementary functions,
//      complex AST evaluator, symbolic Cauchy-Riemann holomorphicity verifier,
//      composite Gauss-Legendre & spectral periodic circle contour integration,
//      Laurent series coefficients, isolated singularity classification & residues
//      (removable, simple pole, order-m pole, essential singularity), Cauchy Residue
//      Theorem, Argument Principle winding count, and cross-ratio Mobius transformations.
//   2. Special Functions, Analytic Continuation & Orthogonal Polynomials (MSC 33):
//      Lanczos Gamma(z) over C \ {0, -1, -2, ...} via Euler reflection, lgamma,
//      digamma psi(x), Beta(a,b), lower/upper & regularized Incomplete Gamma,
//      Riemann Zeta zeta(s) over C \ {1} via Borwein Chebyshev Dirichlet-eta
//      acceleration + Riemann functional equation, Halley 3rd-order Lambert W_0 & W_-1,
//      Bessel J_n(x) & Modified Bessel I_n(x), Gauss AGM Complete Elliptic Integrals
//      K(m) & E(m) (with nonlinear pendulum period & exact ellipse perimeter), and
//      exact symbolic + numerical Orthogonal Polynomials (Legendre P_n, Chebyshev T_n/U_n,
//      Hermite H_n, Laguerre L_n).
//   3. Symbolic Riemannian Differential Geometry, Calculus of Variations & Chaos
//      (MSC 37, 49, 53, 83): Exact symbolic inverse metric g^{mu nu}, Christoffel
//      symbols Gamma^lambda_{mu nu}, Riemann tensor R^rho_{sigma mu nu}, Ricci tensor
//      R_{sigma nu}, Ricci scalar R, Einstein tensor G_{mu nu}, multivariate symbolic
//      Euler-Lagrange equations, 2D Poincaré-Lyapunov equilibrium classification, and
//      1D map + continuous ODE Benettin maximal Lyapunov exponents.
//   4. Stochastic Itô Calculus, Game Theory, Information/Coding Theory & Sparse
//      Krylov / Galerkin FEM / Integral Equations (MSC 28, 60, 65, 91, 94):
//      Symbolic Itô's Lemma, deterministic Box-Muller Euler-Maruyama & Strong Order-1.0
//      Milstein SDE integrators, Joe-Kuo Gray-code Sobol Quasi-Monte Carlo, complete
//      support-enumeration 2-player bimatrix Nash equilibria, exact Shapley values,
//      Shannon entropy / KL divergence / Mutual Information / Huffman coding,
//      Hamming(7,4) ECC, GF(2^8) (0x11D) Reed-Solomon codec (Berlekamp-Massey +
//      Chien search + Forney), CSR sparse Conjugate Gradient & BiCGSTAB, 1D Galerkin
//      hat-basis FEM BVP solver, and Nyström Gauss-Legendre Fredholm + Richardson-Trapezoidal
//      Volterra integral equation solvers.

let PI = 3.14159265358979323846;
let TWO_PI = 6.28318530717958647692;
let HALF_PI = 1.57079632679489661923;
let E_CONST = 2.71828182845904523536;
let INV_E = 0.36787944117144232160;
let LN2 = 0.69314718055994530942;
let EULER_GAMMA = 0.57721566490153286061;

// Resource & DoS safety caps
let MAX_CONTOUR_NODES = 8192;
let MAX_POLY_DEGREE = 128;
let MAX_TENSOR_DIM = 6;
let MAX_LYAPUNOV_STEPS = 100000;
let MAX_SDE_STEPS = 100000;
let MAX_QMC_POINTS = 131072;
let MAX_GAME_STRATEGIES = 10;
let MAX_SHAPLEY_PLAYERS = 16;
let MAX_KRYLOV_ITER = 10000;
let MAX_FEM_ELEMENTS = 8192;
let MAX_QUAD_NODES = 128;

let _MOD_CACHE = map{
    calc: nil,
    cas: nil
};

fn _calc() {
    if _MOD_CACHE.calc == nil {
        _MOD_CACHE.calc = import("stdlib:math/calculus_ode.sapp");
    }
    return _MOD_CACHE.calc;
}

fn _cas() {
    if _MOD_CACHE.cas == nil {
        _MOD_CACHE.cas = import("stdlib:math/symbolic_cas.sapp");
    }
    return _MOD_CACHE.cas;
}

// ============================================================================
// 0. Numeric, Rational & Small Dense Linear Algebra Helpers
// ============================================================================

fn _pos_inf() { return num_exp(1000.0); }
fn _neg_inf() { return 0.0 - num_exp(1000.0); }
fn _nan_val() { return num_ln(-1.0); }
fn _is_fn(f) {
    let t = type(f);
    return t == "fn" or t == "function" or t == "closure";
}

fn _is_finite(x) {
    if type(x) != "number" { return false; }
    if x != x { return false; }
    let s = str(x);
    if s == "inf" or s == "-inf" or s == "Infinity" or s == "-Infinity" or s == "NaN" {
        return false;
    }
    return num_abs(x) < 1e305;
}

fn _is_int_val(x) {
    if not _is_finite(x) { return false; }
    if num_abs(x) > 9007199254740991.0 { return false; }
    return num_abs(x - num_round(x)) < 1e-12;
}

fn _snap_scalar(x, tol = 1e-11) {
    if not _is_finite(x) { return x; }
    let rx = num_round(x);
    if num_abs(x - rx) < tol {
        if rx == 0 { return 0.0; }
        return rx * 1.0;
    }
    // Also snap small-denominator exact rationals p/q (q <= 24) when within 1e-12
    let q = 2;
    while q <= 24 {
        let p = num_round(x * q);
        let cand = (p * 1.0) / (q * 1.0);
        if num_abs(x - cand) < 1e-12 {
            return cand;
        }
        q = q + 1;
    }
    return x;
}

fn _gcd_int(a, b) {
    let x = num_round(num_abs(a));
    let y = num_round(num_abs(b));
    let guard = 0;
    while y > 0 and guard < 128 {
        let r = num_mod(x, y);
        x = y;
        y = r;
        guard = guard + 1;
    }
    if x == 0 { return 1; }
    return x;
}

fn _sinh_real(x) {
    if num_abs(x) < 1e-5 {
        let x2 = x * x;
        return x * (1.0 + x2 / 6.0 + (x2 * x2) / 120.0);
    }
    return 0.5 * (num_exp(x) - num_exp(0.0 - x));
}

fn _cosh_real(x) {
    return 0.5 * (num_exp(x) + num_exp(0.0 - x));
}

fn _hypot2(x, y) {
    let ax = num_abs(x);
    let ay = num_abs(y);
    if ax == 0.0 { return ay; }
    if ay == 0.0 { return ax; }
    if ax >= ay {
        let r = ay / ax;
        return ax * num_sqrt(1.0 + r * r);
    }
    let r2 = ax / ay;
    return ay * num_sqrt(1.0 + r2 * r2);
}

// Dense Gaussian elimination with partial pivoting; returns { ok, x, det, min_pivot }
fn _solve_dense_linear(A_in, b_in, pivot_tol = 1e-12) {
    let n = len(A_in);
    let M = [];
    let rhs = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, A_in[i][j] * 1.0);
            j = j + 1;
        }
        array_push(M, row);
        array_push(rhs, b_in[i] * 1.0);
        i = i + 1;
    }

    let det = 1.0;
    let min_piv = 1e300;
    let k = 0;
    while k < n {
        let piv_row = k;
        let piv_val = num_abs(M[k][k]);
        let r = k + 1;
        while r < n {
            let av = num_abs(M[r][k]);
            if av > piv_val {
                piv_val = av;
                piv_row = r;
            }
            r = r + 1;
        }
        if piv_val < min_piv { min_piv = piv_val; }
        if piv_val < pivot_tol {
            return map{ ok: false, x: [], det: 0.0, min_pivot: piv_val };
        }
        if piv_row != k {
            let tmp_row = M[k];
            M[k] = M[piv_row];
            M[piv_row] = tmp_row;
            let tmp_b = rhs[k];
            rhs[k] = rhs[piv_row];
            rhs[piv_row] = tmp_b;
            det = 0.0 - det;
        }
        let piv = M[k][k];
        det = det * piv;
        r = k + 1;
        while r < n {
            let fac = M[r][k] / piv;
            M[r][k] = 0.0;
            let c = k + 1;
            while c < n {
                M[r][c] = M[r][c] - fac * M[k][c];
                c = c + 1;
            }
            rhs[r] = rhs[r] - fac * rhs[k];
            r = r + 1;
        }
        k = k + 1;
    }

    let x = [];
    i = 0;
    while i < n { array_push(x, 0.0); i = i + 1; }
    let idx = n - 1;
    while idx >= 0 {
        let s = rhs[idx];
        let c = idx + 1;
        while c < n {
            s = s - M[idx][c] * x[c];
            c = c + 1;
        }
        x[idx] = s / M[idx][idx];
        idx = idx - 1;
    }
    return map{ ok: true, x: x, det: det, min_pivot: min_piv };
}

// Gauss-Legendre nodes & weights on [-1, 1] for arbitrary n (1 <= n <= MAX_QUAD_NODES)
let _GL_CACHE = map{};

fn _gauss_legendre_rule(n) {
    if n < 1 or n > MAX_QUAD_NODES {
        throw "complex_riemann_stochastic_game: invalid Gauss-Legendre order " + str(n);
    }
    let key = str(n);
    if map_has(_GL_CACHE, key) {
        return _GL_CACHE[key];
    }
    let nodes = [];
    let weights = [];
    let i = 0;
    while i < n {
        array_push(nodes, 0.0);
        array_push(weights, 0.0);
        i = i + 1;
    }
    let m = num_round(num_floor((n + 1) / 2.0));
    i = 0;
    while i < m {
        // Tricomi asymptotic initial approximation
        let z = num_cos(PI * ((i * 1.0 + 0.75) / (n * 1.0 + 0.5)));
        let iter = 0;
        let dp = 0.0;
        while iter < 32 {
            let p1 = 1.0;
            let p2 = 0.0;
            let j = 1;
            while j <= n {
                let p3 = p2;
                p2 = p1;
                p1 = (((2.0 * j - 1.0) * z * p2) - ((j - 1.0) * p3)) / (j * 1.0);
                j = j + 1;
            }
            dp = (n * 1.0 * (z * p1 - p2)) / (z * z - 1.0);
            let dz = p1 / dp;
            z = z - dz;
            if num_abs(dz) < 1e-15 { break; }
            iter = iter + 1;
        }
        let w = 2.0 / ((1.0 - z * z) * dp * dp);
        nodes[i] = 0.0 - z;
        nodes[n - 1 - i] = z;
        weights[i] = w;
        weights[n - 1 - i] = w;
        i = i + 1;
    }
    let rule = map{ nodes: nodes, weights: weights };
    _GL_CACHE[key] = rule;
    return rule;
}

// ============================================================================
// 1. Complex Analysis (MSC 30)
// ============================================================================

fn cplx(re, im = 0.0) {
    return map{ re: re * 1.0, im: im * 1.0 };
}

fn _c(z) {
    if type(z) == "number" {
        return map{ re: z * 1.0, im: 0.0 };
    }
    if type(z) == "array" and len(z) >= 2 {
        return map{ re: z[0] * 1.0, im: z[1] * 1.0 };
    }
    if type(z) == "map" and map_has(z, "re") and map_has(z, "im") {
        return map{ re: z.re * 1.0, im: z.im * 1.0 };
    }
    throw "complex_riemann_stochastic_game: expected complex {re, im} or number";
}

fn c_add(a, b) {
    let za = _c(a);
    let zb = _c(b);
    return map{ re: za.re + zb.re, im: za.im + zb.im };
}

fn c_sub(a, b) {
    let za = _c(a);
    let zb = _c(b);
    return map{ re: za.re - zb.re, im: za.im - zb.im };
}

fn c_neg(z) {
    let zz = _c(z);
    return map{ re: 0.0 - zz.re, im: 0.0 - zz.im };
}

fn c_conj(z) {
    let zz = _c(z);
    return map{ re: zz.re, im: 0.0 - zz.im };
}

fn c_abs(z) {
    let zz = _c(z);
    return _hypot2(zz.re, zz.im);
}

fn c_arg(z) {
    let zz = _c(z);
    return num_atan2(zz.im, zz.re);
}

fn c_mul(a, b) {
    let za = _c(a);
    let zb = _c(b);
    return map{
        re: za.re * zb.re - za.im * zb.im,
        im: za.re * zb.im + za.im * zb.re
    };
}

// Overflow-safe Smith's complex division algorithm
fn c_div(a, b) {
    let za = _c(a);
    let zb = _c(b);
    let abr = num_abs(zb.re);
    let abi = num_abs(zb.im);
    if abr == 0.0 and abi == 0.0 {
        throw "complex_riemann_stochastic_game: complex division by zero";
    }
    if abr >= abi {
        let r = zb.im / zb.re;
        let den = zb.re + zb.im * r;
        return map{
            re: (za.re + za.im * r) / den,
            im: (za.im - za.re * r) / den
        };
    }
    let r2 = zb.re / zb.im;
    let den2 = zb.im + zb.re * r2;
    return map{
        re: (za.re * r2 + za.im) / den2,
        im: (za.im * r2 - za.re) / den2
    };
}

fn c_exp(z) {
    let zz = _c(z);
    let ex = num_exp(zz.re);
    return map{
        re: ex * num_cos(zz.im),
        im: ex * num_sin(zz.im)
    };
}

fn c_ln(z) {
    let zz = _c(z);
    let r = _hypot2(zz.re, zz.im);
    if r == 0.0 {
        throw "complex_riemann_stochastic_game: c_ln(0) pole";
    }
    return map{
        re: num_ln(r),
        im: num_atan2(zz.im, zz.re)
    };
}

fn c_sin(z) {
    let zz = _c(z);
    return map{
        re: num_sin(zz.re) * _cosh_real(zz.im),
        im: num_cos(zz.re) * _sinh_real(zz.im)
    };
}

fn c_cos(z) {
    let zz = _c(z);
    return map{
        re: num_cos(zz.re) * _cosh_real(zz.im),
        im: 0.0 - num_sin(zz.re) * _sinh_real(zz.im)
    };
}

fn c_tan(z) {
    return c_div(c_sin(z), c_cos(z));
}

fn c_sinh(z) {
    let zz = _c(z);
    return map{
        re: _sinh_real(zz.re) * num_cos(zz.im),
        im: _cosh_real(zz.re) * num_sin(zz.im)
    };
}

fn c_cosh(z) {
    let zz = _c(z);
    return map{
        re: _cosh_real(zz.re) * num_cos(zz.im),
        im: _sinh_real(zz.re) * num_sin(zz.im)
    };
}

fn c_tanh(z) {
    return c_div(c_sinh(z), c_cosh(z));
}

// Numerically stable principal square root avoiding catastrophic cancellation
fn c_sqrt(z) {
    let zz = _c(z);
    if zz.re == 0.0 and zz.im == 0.0 {
        return map{ re: 0.0, im: 0.0 };
    }
    let r = _hypot2(zz.re, zz.im);
    if zz.re >= 0.0 {
        let u = num_sqrt(0.5 * (r + zz.re));
        return map{ re: u, im: zz.im / (2.0 * u) };
    }
    let v = num_sqrt(0.5 * (r - zz.re));
    if zz.im < 0.0 {
        return map{ re: num_abs(zz.im) / (2.0 * v), im: 0.0 - v };
    }
    return map{ re: zz.im / (2.0 * v), im: v };
}

fn _c_pow_int(base, n_int) {
    let k = num_round(n_int);
    if k == 0 { return map{ re: 1.0, im: 0.0 }; }
    let neg = k < 0;
    let e = num_round(num_abs(k));
    let acc = map{ re: 1.0, im: 0.0 };
    let cur = _c(base);
    while e > 0 {
        if num_mod(e, 2) == 1 {
            acc = c_mul(acc, cur);
        }
        e = num_round(num_floor(e / 2.0));
        if e > 0 {
            cur = c_mul(cur, cur);
        }
    }
    if neg {
        return c_div(map{ re: 1.0, im: 0.0 }, acc);
    }
    return acc;
}

fn c_pow(a, b) {
    let za = _c(a);
    let zb = _c(b);
    if num_abs(zb.im) < 1e-15 and _is_int_val(zb.re) and num_abs(zb.re) <= 65536 {
        return _c_pow_int(za, num_round(zb.re));
    }
    if za.re == 0.0 and za.im == 0.0 {
        if zb.re > 0.0 { return map{ re: 0.0, im: 0.0 }; }
        throw "complex_riemann_stochastic_game: 0^w undefined for Re(w) <= 0";
    }
    return c_exp(c_mul(zb, c_ln(za)));
}

// Complex AST evaluator using calculus_ode's expression parser
fn _eval_complex_ast(node, var_name, z_val, env, depth) {
    if depth > 128 {
        throw "complex_riemann_stochastic_game: MAX_DEPTH exceeded in eval_complex";
    }
    let k = node.kind;
    if k == "num" {
        return map{ re: node.val * 1.0, im: 0.0 };
    }
    if k == "sym" {
        let nm = node.name;
        if var_name != nil and nm == var_name and z_val != nil {
            return _c(z_val);
        }
        if type(env) == "map" and map_has(env, nm) {
            return _c(env[nm]);
        }
        if nm == "i" or nm == "I" { return map{ re: 0.0, im: 1.0 }; }
        if nm == "pi" { return map{ re: PI, im: 0.0 }; }
        if nm == "e" { return map{ re: E_CONST, im: 0.0 }; }
        throw "complex_riemann_stochastic_game: unbound complex symbol '" + nm + "'";
    }
    if k == "neg" {
        return c_neg(_eval_complex_ast(node.arg, var_name, z_val, env, depth + 1));
    }
    if k == "bin" {
        let lv = _eval_complex_ast(node.left, var_name, z_val, env, depth + 1);
        let rv = _eval_complex_ast(node.right, var_name, z_val, env, depth + 1);
        let op = node.op;
        if op == "+" { return c_add(lv, rv); }
        if op == "-" { return c_sub(lv, rv); }
        if op == "*" { return c_mul(lv, rv); }
        if op == "/" { return c_div(lv, rv); }
        if op == "^" { return c_pow(lv, rv); }
        throw "complex_riemann_stochastic_game: unknown binary operator '" + op + "'";
    }
    if k == "call" {
        let nm = node.name;
        let a0 = _eval_complex_ast(node.args[0], var_name, z_val, env, depth + 1);
        if nm == "sin" { return c_sin(a0); }
        if nm == "cos" { return c_cos(a0); }
        if nm == "tan" { return c_tan(a0); }
        if nm == "cot" { return c_div(c_cos(a0), c_sin(a0)); }
        if nm == "sec" { return c_div(cplx(1.0, 0.0), c_cos(a0)); }
        if nm == "csc" { return c_div(cplx(1.0, 0.0), c_sin(a0)); }
        if nm == "sinh" { return c_sinh(a0); }
        if nm == "cosh" { return c_cosh(a0); }
        if nm == "tanh" { return c_tanh(a0); }
        if nm == "exp" { return c_exp(a0); }
        if nm == "ln" or nm == "log" {
            if len(node.args) >= 2 {
                let b0 = _eval_complex_ast(node.args[1], var_name, z_val, env, depth + 1);
                return c_div(c_ln(a0), c_ln(b0));
            }
            return c_ln(a0);
        }
        if nm == "log10" { return c_div(c_ln(a0), cplx(num_ln(10.0), 0.0)); }
        if nm == "sqrt" { return c_sqrt(a0); }
        if nm == "abs" { return cplx(c_abs(a0), 0.0); }
        if nm == "conj" { return c_conj(a0); }
        if nm == "re" { return cplx(a0.re, 0.0); }
        if nm == "im" { return cplx(a0.im, 0.0); }
        throw "complex_riemann_stochastic_game: unknown complex function '" + nm + "'";
    }
    throw "complex_riemann_stochastic_game: invalid AST node";
}

fn eval_complex(expr_str, var_name = "z", z = nil, env = map{}) {
    if _is_fn(expr_str) {
        return _c(expr_str(_c(z)));
    }
    let ast = _calc().parse_expr(expr_str);
    let zv = if z == nil { nil } else { _c(z) };
    return _eval_complex_ast(ast, var_name, zv, env, 0);
}

fn _as_complex_fn(f_or_expr, var_name = "z") {
    if _is_fn(f_or_expr) {
        return fn(z) { return _c(f_or_expr(_c(z))); };
    }
    let ast = _calc().parse_expr(f_or_expr);
    return fn(z) { return _eval_complex_ast(ast, var_name, _c(z), map{}, 0); };
}

// Deep symbolic simplification combining calculus_ode.simplify + symbolic_cas rational/Pythagorean reduction
fn _replace_cos_sq_ast(node, depth) {
    if depth > 64 or node == nil or type(node) != "map" { return node; }
    let k = node.kind;
    if k == "num" or k == "sym" { return node; }
    if k == "neg" {
        return map{ kind: "neg", arg: _replace_cos_sq_ast(node.arg, depth + 1) };
    }
    if k == "call" {
        let nargs = [];
        let i = 0;
        while i < len(node.args) {
            array_push(nargs, _replace_cos_sq_ast(node.args[i], depth + 1));
            i = i + 1;
        }
        return map{ kind: "call", name: node.name, args: nargs };
    }
    if k == "bin" {
        let l = _replace_cos_sq_ast(node.left, depth + 1);
        let r = _replace_cos_sq_ast(node.right, depth + 1);
        if node.op == "^" and r.kind == "num" and _is_int_val(r.val) and num_round(r.val) >= 2 and num_mod(num_round(r.val), 2) == 0 {
            if l.kind == "call" and l.name == "cos" and len(l.args) == 1 {
                let half_e = num_round(r.val / 2.0);
                let sin_sq = map{
                    kind: "bin", op: "^",
                    left: map{ kind: "call", name: "sin", args: l.args },
                    right: map{ kind: "num", val: 2 }
                };
                let one_minus = map{
                    kind: "bin", op: "-",
                    left: map{ kind: "num", val: 1 },
                    right: sin_sq
                };
                if half_e == 1 { return one_minus; }
                return map{ kind: "bin", op: "^", left: one_minus, right: map{ kind: "num", val: half_e } };
            }
        }
        return map{ kind: "bin", op: node.op, left: l, right: r };
    }
    return node;
}

fn _sym_simplify_deep(expr_str, pretty_cot_tan = false) {
    let CALC = _calc();
    let s1_obj = CALC.simplify(expr_str);
    let s1 = s1_obj.ascii;
    if s1 == "0" or s1 == "1" or s1 == "-1" {
        return s1_obj;
    }

    let best_ascii = s1;
    // Combine rational fractions and expand numerators/denominators via symbolic_cas
    let cas_ok = try {
        let CAS = _cas();
        let p = CAS.parse_math(s1);
        let nd = CAS.to_rational_nd(p, nil);
        let n_asc = CAS.to_ascii(nd.num);
        let d_asc = CAS.to_ascii(nd.den);
        // Apply cos(u)^(2m) -> (1 - sin(u)^2)^m when trig powers appear
        if str_contains(n_asc, "cos(") or str_contains(d_asc, "cos(") {
            let n_rep = CALC.format_ascii(_replace_cos_sq_ast(CALC.parse_expr(n_asc), 0), 0);
            let d_rep = CALC.format_ascii(_replace_cos_sq_ast(CALC.parse_expr(d_asc), 0), 0);
            let n_exp = CAS.expand(n_rep).ascii;
            let d_exp = CAS.expand(d_rep).ascii;
            let combined_trig = if d_exp == "1" { n_exp } else { "(" + n_exp + ")/(" + d_exp + ")" };
            let c_simp = CAS.simplify(combined_trig).ascii;
            let c_calc = CALC.simplify(c_simp).ascii;
            if len(c_calc) <= len(best_ascii) + 4 {
                best_ascii = c_calc;
            }
        } else {
            let combined_alg = if d_asc == "1" { n_asc } else { "(" + n_asc + ")/(" + d_asc + ")" };
            let c_simp2 = CAS.simplify(combined_alg).ascii;
            let c_calc2 = CALC.simplify(c_simp2).ascii;
            if len(c_calc2) <= len(best_ascii) + 2 {
                best_ascii = c_calc2;
            }
        }
        true
    } catch false;

    let final_obj = CALC.simplify(best_ascii);
    if pretty_cot_tan {
        let ast = final_obj.ast;
        if ast.kind == "bin" and ast.op == "/" and ast.left.kind == "call" and ast.right.kind == "call" {
            if len(ast.left.args) == 1 and len(ast.right.args) == 1 {
                let arg_l = CALC.format_ascii(ast.left.args[0], 0);
                let arg_r = CALC.format_ascii(ast.right.args[0], 0);
                if arg_l == arg_r {
                    if ast.left.name == "cos" and ast.right.name == "sin" {
                        return CALC.simplify("cot(" + arg_l + ")");
                    }
                    if ast.left.name == "sin" and ast.right.name == "cos" {
                        return CALC.simplify("tan(" + arg_l + ")");
                    }
                }
            }
        }
    }
    return final_obj;
}

// Cauchy-Riemann holomorphicity check for f(x + i y) = u(x, y) + i v(x, y)
fn check_cauchy_riemann(u_expr, v_expr, x_var = "x", y_var = "y") {
    let CALC = _calc();
    let ux = CALC.diff(u_expr, x_var, 1);
    let uy = CALC.diff(u_expr, y_var, 1);
    let vx = CALC.diff(v_expr, x_var, 1);
    let vy = CALC.diff(v_expr, y_var, 1);

    let cr1 = _sym_simplify_deep("(" + ux.ascii + ") - (" + vy.ascii + ")", false);
    let cr2 = _sym_simplify_deep("(" + uy.ascii + ") + (" + vx.ascii + ")", false);

    let is_zero_1 = cr1.ascii == "0";
    let is_zero_2 = cr2.ascii == "0";

    // Fallback numeric verification at generic irrational probe points for exotic transcendental forms
    if not is_zero_1 or not is_zero_2 {
        let probes = [
            [0.371928, 0.814231],
            [-0.619402, 0.437119],
            [1.137291, -0.528417]
        ];
        let all_zero_1 = true;
        let all_zero_2 = true;
        let valid_probes = 0;
        let pi = 0;
        while pi < len(probes) {
            let env = map{};
            env[x_var] = probes[pi][0];
            env[y_var] = probes[pi][1];
            let v1 = try CALC.evaluate_expr(cr1.ast, env) catch _nan_val();
            let v2 = try CALC.evaluate_expr(cr2.ast, env) catch _nan_val();
            if _is_finite(v1) and _is_finite(v2) {
                valid_probes = valid_probes + 1;
                if num_abs(v1) > 1e-11 { all_zero_1 = false; }
                if num_abs(v2) > 1e-11 { all_zero_2 = false; }
            }
            pi = pi + 1;
        }
        if valid_probes >= 2 {
            if all_zero_1 { is_zero_1 = true; }
            if all_zero_2 { is_zero_2 = true; }
        }
    }

    let holo = is_zero_1 and is_zero_2;
    let f_prime = if vx.ascii == "0" {
        ux.ascii
    } else if ux.ascii == "0" {
        "i*(" + vx.ascii + ")"
    } else {
        "(" + ux.ascii + ") + i*(" + vx.ascii + ")"
    };

    return map{
        is_holomorphic: holo,
        du_dx: ux.ascii,
        du_dy: uy.ascii,
        dv_dx: vx.ascii,
        dv_dy: vy.ascii,
        cr1_ascii: cr1.ascii,
        cr2_ascii: cr2.ascii,
        f_prime_ascii: f_prime
    };
}

// Composite 8-point Gauss-Legendre contour quadrature along z(t), t in [t0, t1]
fn contour_integral(f_complex_or_expr, z_param_fn, dt_param_fn, t0, t1, n_panels = 24) {
    if n_panels < 1 or n_panels > 1024 {
        throw "complex_riemann_stochastic_game: contour_integral n_panels out of range";
    }
    let f_fn = _as_complex_fn(f_complex_or_expr, "z");
    let rule = _gauss_legendre_rule(8);
    let dt_panel = ((t1 * 1.0) - (t0 * 1.0)) / (n_panels * 1.0);
    let sum_re = 0.0;
    let sum_im = 0.0;

    let p = 0;
    while p < n_panels {
        let a = (t0 * 1.0) + p * dt_panel;
        let b = a + dt_panel;
        let mid = 0.5 * (a + b);
        let half = 0.5 * (b - a);
        let q = 0;
        while q < 8 {
            let t = mid + half * rule.nodes[q];
            let zt = _c(z_param_fn(t));
            let dzt = if dt_param_fn != nil {
                _c(dt_param_fn(t))
            } else {
                let h = 1e-7 * _hypot2(1.0, t);
                let zp = _c(z_param_fn(t + h));
                let zm = _c(z_param_fn(t - h));
                map{ re: (zp.re - zm.re) / (2.0 * h), im: (zp.im - zm.im) / (2.0 * h) }
            };
            let fz = f_fn(zt);
            let prod = c_mul(fz, dzt);
            let w = half * rule.weights[q];
            sum_re = sum_re + w * prod.re;
            sum_im = sum_im + w * prod.im;
            q = q + 1;
        }
        p = p + 1;
    }
    return map{ re: sum_re, im: sum_im };
}

// Exponentially accurate periodic trapezoidal spectral quadrature on |z - center| = radius
fn circle_contour_integral(f, center, radius, n_nodes = 256) {
    if radius <= 0.0 {
        throw "complex_riemann_stochastic_game: circle_contour_integral requires radius > 0";
    }
    if n_nodes < 8 or n_nodes > MAX_CONTOUR_NODES {
        throw "complex_riemann_stochastic_game: circle_contour_integral n_nodes out of range";
    }
    let f_fn = _as_complex_fn(f, "z");
    let z0 = _c(center);
    let r = radius * 1.0;
    let dtheta = TWO_PI / (n_nodes * 1.0);
    let sum_re = 0.0;
    let sum_im = 0.0;

    let k = 0;
    while k < n_nodes {
        let theta = k * dtheta;
        let ct = num_cos(theta);
        let st = num_sin(theta);
        let z = map{ re: z0.re + r * ct, im: z0.im + r * st };
        // dz/dtheta = i * r * (cos(theta) + i*sin(theta)) = r * (-sin(theta) + i*cos(theta))
        let dz_dtheta = map{ re: 0.0 - r * st, im: r * ct };
        let fz = f_fn(z);
        let integrand = c_mul(fz, dz_dtheta);
        sum_re = sum_re + integrand.re;
        sum_im = sum_im + integrand.im;
        k = k + 1;
    }
    return map{ re: sum_re * dtheta, im: sum_im * dtheta };
}

// Laurent coefficient a_n = (1 / 2pi i) * oint_{|z-z0|=r} f(z) / (z - z0)^(n + 1) dz
//                         = (1 / (N * r^n)) * sum_{k=0}^{N-1} f(z0 + r*e^{i theta_k}) * e^{-i n theta_k}
fn _laurent_samples_on_circle(f_fn, z0, r, n_nodes) {
    let samples = [];
    let max_abs = 0.0;
    let dtheta = TWO_PI / (n_nodes * 1.0);
    let k = 0;
    while k < n_nodes {
        let theta = k * dtheta;
        let z = map{ re: z0.re + r * num_cos(theta), im: z0.im + r * num_sin(theta) };
        let fz = f_fn(z);
        let m = c_abs(fz);
        if m > max_abs { max_abs = m; }
        array_push(samples, fz);
        k = k + 1;
    }
    return map{ samples: samples, max_abs: max_abs };
}

fn _laurent_from_samples(samples, r, n_idx) {
    let N = len(samples);
    let dtheta = TWO_PI / (N * 1.0);
    let sum_re = 0.0;
    let sum_im = 0.0;
    let k = 0;
    while k < N {
        let ang = (0.0 - (n_idx * 1.0)) * k * dtheta;
        let ca = num_cos(ang);
        let sa = num_sin(ang);
        let fz = samples[k];
        sum_re = sum_re + (fz.re * ca - fz.im * sa);
        sum_im = sum_im + (fz.re * sa + fz.im * ca);
        k = k + 1;
    }
    let scale = 1.0 / ((N * 1.0) * num_pow(r, n_idx * 1.0));
    return map{ re: sum_re * scale, im: sum_im * scale };
}

fn laurent_coeff(f, z0, n, radius = 0.1, n_nodes = 256) {
    if radius <= 0.0 {
        throw "complex_riemann_stochastic_game: laurent_coeff requires radius > 0";
    }
    if not _is_int_val(n) {
        throw "complex_riemann_stochastic_game: laurent_coeff index n must be an integer";
    }
    let f_fn = _as_complex_fn(f, "z");
    let c0 = _c(z0);
    let ring = _laurent_samples_on_circle(f_fn, c0, radius * 1.0, n_nodes);
    return _laurent_from_samples(ring.samples, radius * 1.0, num_round(n));
}

// Isolated singularity classification & Cauchy residue extraction
fn residue_at(f, z0, radius = 0.05) {
    if radius <= 0.0 {
        throw "complex_riemann_stochastic_game: residue_at requires radius > 0";
    }
    let f_fn = _as_complex_fn(f, "z");
    let c0 = _c(z0);
    let r_use = radius * 1.0;
    let N = 256;
    let ring1 = _laurent_samples_on_circle(f_fn, c0, r_use, N);
    let a_m1_r1 = _laurent_from_samples(ring1.samples, r_use, -1);

    // If |f| grows violently at tiny r (e.g., essential singularity exp(1/z) where exp(20) ~ 4.85e8),
    // probe a slightly wider concentric circle 5*r; if Cauchy's theorem holds (a_-1 agrees on r, 2.5r, 5r),
    // no other poles lie in the annulus and the wider circle improves floating-point conditioning by 10^6x!
    let ring = ring1;
    if ring1.max_abs > 1e5 and r_use <= 0.1 {
        let r_mid = r_use * 2.5;
        let r_wide = r_use * 5.0;
        let ok_probe = try {
            let rm = _laurent_samples_on_circle(f_fn, c0, r_mid, N);
            let rw = _laurent_samples_on_circle(f_fn, c0, r_wide, N);
            if _is_finite(rm.max_abs) and _is_finite(rw.max_abs) and rw.max_abs < ring1.max_abs * 0.01 {
                let am = _laurent_from_samples(rm.samples, r_mid, -1);
                let aw = _laurent_from_samples(rw.samples, r_wide, -1);
                let diff1 = c_abs(c_sub(a_m1_r1, am));
                let diff2 = c_abs(c_sub(am, aw));
                let tol_ann = 1e-6 * (1.0 + c_abs(aw));
                if diff1 < tol_ann and diff2 < tol_ann {
                    ring = rw;
                    r_use = r_wide;
                }
            }
            true
        } catch false;
    }

    // Compute principal-part Laurent modes a_{-1}, a_{-2}, ..., a_{-12}
    // Note: roundoff floor for a_{-k} on circle of radius r_use is ~ eps * max_abs * r_use^k.
    let K_MAX = 12;
    let neg_coeffs = [];
    let highest_nonzero = 0;
    let high_tail_count = 0; // count of nonzero modes in k = 7..12

    let k = 1;
    while k <= K_MAX {
        let ak = _laurent_from_samples(ring.samples, r_use, 0 - k);
        let mag = c_abs(ak);
        let noise_floor = 5e-13 * ring.max_abs * num_pow(r_use, k * 1.0) + 1e-13;
        let sig_thresh = if noise_floor > 1e-11 { noise_floor * 20.0 } else { 1e-11 };
        array_push(neg_coeffs, ak);
        if mag > sig_thresh {
            highest_nonzero = k;
            if k >= 7 {
                high_tail_count = high_tail_count + 1;
            }
        }
        k = k + 1;
    }

    let raw_res = neg_coeffs[0];
    let snapped_res = map{
        re: _snap_scalar(raw_res.re, 1e-9),
        im: _snap_scalar(raw_res.im, 1e-9)
    };

    let stype = "removable";
    let pole_order = 0;
    if high_tail_count >= 3 and highest_nonzero >= 9 {
        stype = "essential_singularity";
        pole_order = -1;
    } else if highest_nonzero == 0 {
        stype = "removable";
        pole_order = 0;
    } else if highest_nonzero == 1 {
        stype = "simple_pole";
        pole_order = 1;
    } else {
        stype = "pole_of_order_" + str(highest_nonzero);
        pole_order = highest_nonzero;
    }

    return map{
        re: snapped_res.re,
        im: snapped_res.im,
        residue: snapped_res,
        raw_residue: raw_res,
        singularity_type: stype,
        classification: stype,
        pole_order: pole_order,
        radius_used: r_use,
        principal_part: neg_coeffs
    };
}

// Cauchy's Residue Theorem: oint_{|z - center| = radius} f(z) dz = 2*pi*i * sum_{z_k in disk} Res(f, z_k)
fn residue_theorem_integral(f, center, radius, singularities) {
    if radius <= 0.0 {
        throw "complex_riemann_stochastic_game: residue_theorem_integral requires radius > 0";
    }
    let c0 = _c(center);
    let r_big = radius * 1.0;
    let interior = [];
    let i = 0;
    while i < len(singularities) {
        let sk = _c(singularities[i]);
        let d = c_abs(c_sub(sk, c0));
        if num_abs(d - r_big) < 1e-9 {
            throw "complex_riemann_stochastic_game: singularity lies directly on integration contour";
        }
        if d < r_big {
            array_push(interior, sk);
        }
        i = i + 1;
    }

    let sum_res = map{ re: 0.0, im: 0.0 };
    let details = [];
    i = 0;
    while i < len(interior) {
        let zk = interior[i];
        let min_sep = r_big - c_abs(c_sub(zk, c0));
        let j = 0;
        while j < len(singularities) {
            let zj = _c(singularities[j]);
            let dj = c_abs(c_sub(zk, zj));
            if dj > 1e-12 and dj < min_sep {
                min_sep = dj;
            }
            j = j + 1;
        }
        let rk = 0.25 * min_sep;
        if rk > 0.05 { rk = 0.05; }
        if rk < 1e-4 { rk = 1e-4; }
        let ri = residue_at(f, zk, rk);
        sum_res = c_add(sum_res, ri.residue);
        array_push(details, ri);
        i = i + 1;
    }

    // 2 * pi * i * (re + i*im) = (-2*pi*im) + i*(2*pi*re)
    let val = map{
        re: _snap_scalar(0.0 - TWO_PI * sum_res.im, 1e-9),
        im: _snap_scalar(TWO_PI * sum_res.re, 1e-9)
    };
    return map{
        re: val.re,
        im: val.im,
        value: val,
        sum_residues: sum_res,
        residues: details,
        interior_count: len(interior)
    };
}

// Argument Principle: (1 / 2pi i) oint_{|z - center| = radius} (f'(z) / f(z)) dz = Z - P
fn argument_principle_report(f, df, center, radius, n_nodes = 512) {
    let f_fn = _as_complex_fn(f, "z");
    let df_fn = nil;
    if df != nil {
        df_fn = _as_complex_fn(df, "z");
    } else if type(f) == "string" {
        let d_expr = _calc().diff(f, "z", 1).ascii;
        df_fn = _as_complex_fn(d_expr, "z");
    } else {
        df_fn = fn(z) {
            let h = 1e-7;
            let f1 = f_fn(map{ re: z.re + h, im: z.im });
            let f2 = f_fn(map{ re: z.re - h, im: z.im });
            return map{ re: (f1.re - f2.re) / (2.0 * h), im: (f1.im - f2.im) / (2.0 * h) };
        };
    }

    let log_deriv = fn(z) {
        let fz = f_fn(z);
        if c_abs(fz) < 1e-13 {
            throw "complex_riemann_stochastic_game: zero or pole lies on Argument Principle contour";
        }
        return c_div(df_fn(z), fz);
    };
    let raw_int = circle_contour_integral(log_deriv, center, radius, n_nodes);
    let winding = c_div(raw_int, map{ re: 0.0, im: TWO_PI });
    let count_int = num_round(winding.re);
    return map{
        count: count_int,
        zeros_minus_poles: count_int,
        winding: winding,
        winding_error: _hypot2(winding.re - count_int, winding.im)
    };
}

fn argument_principle_count(f, df, center, radius, n_nodes = 512) {
    return argument_principle_report(f, df, center, radius, n_nodes).count;
}

// Mobius transformation w = (a*z + b) / (c*z + d) & exact 3-point cross-ratio constructor
fn _is_c_inf(z) {
    if type(z) == "string" and (z == "inf" or z == "Infinity") { return true; }
    if type(z) == "map" and map_has(z, "infinity") and z.infinity == true { return true; }
    return false;
}

fn mobius_transform(z, a, b, c, d) {
    let ca = _c(a);
    let cb = _c(b);
    let cc = _c(c);
    let cd = _c(d);
    let det = c_sub(c_mul(ca, cd), c_mul(cb, cc));
    if c_abs(det) < 1e-14 {
        throw "complex_riemann_stochastic_game: degenerate Mobius transformation (ad - bc = 0)";
    }
    if _is_c_inf(z) {
        if c_abs(cc) < 1e-15 {
            return map{ infinity: true, re: _pos_inf(), im: 0.0 };
        }
        return c_div(ca, cc);
    }
    let zz = _c(z);
    let num_c = c_add(c_mul(ca, zz), cb);
    let den_c = c_add(c_mul(cc, zz), cd);
    if c_abs(den_c) < 1e-15 {
        return map{ infinity: true, re: _pos_inf(), im: 0.0 };
    }
    return c_div(num_c, den_c);
}

// Unique Mobius transformation sending (z1, z2, z3) -> (w1, w2, w3) via cross-ratio invariance:
// (w - w1)(w2 - w3) / ((w - w3)(w2 - w1)) = (z - z1)(z2 - z3) / ((z - z3)(z2 - z1))
fn mobius_from_3_points(z1, z2, z3, w1, w2, w3) {
    let cz1 = _c(z1); let cz2 = _c(z2); let cz3 = _c(z3);
    let cw1 = _c(w1); let cw2 = _c(w2); let cw3 = _c(w3);

    let alpha = c_mul(c_sub(cw2, cw1), c_sub(cz2, cz3));
    let beta  = c_mul(c_sub(cw2, cw3), c_sub(cz2, cz1));

    let a = c_sub(c_mul(cw1, beta), c_mul(cw3, alpha));
    let b = c_sub(c_mul(c_mul(cw3, alpha), cz1), c_mul(c_mul(cw1, beta), cz3));
    let c = c_sub(beta, alpha);
    let d = c_sub(c_mul(alpha, cz1), c_mul(beta, cz3));

    let det = c_sub(c_mul(a, d), c_mul(b, c));
    if c_abs(det) < 1e-14 {
        throw "complex_riemann_stochastic_game: mobius_from_3_points requires distinct triples";
    }
    return map{
        a: a,
        b: b,
        c: c,
        d: d,
        det: det,
        apply: fn(z) { return mobius_transform(z, a, b, c, d); }
    };
}

// ============================================================================
// 2. Special Functions, Analytic Continuation & Orthogonal Polynomials (MSC 33)
// ============================================================================

let _LANCZOS_P = [
    0.99999999999980993,
    676.5203681218851,
    -1259.1392167224028,
    771.32342877765313,
    -176.61502916214059,
    12.507343278686905,
    -0.13857109526572012,
    9.9843695780195716e-6,
    1.5056327351493116e-7
];

// Exact sin(pi * z) avoiding large-integer phase loss on real integer/half-integer inputs
fn _c_sin_pi(z) {
    let zz = _c(z);
    if num_abs(zz.im) < 1e-15 and _is_int_val(zz.re) {
        return map{ re: 0.0, im: 0.0 };
    }
    let rx = zz.re - 2.0 * num_floor(0.5 * zz.re);
    if num_abs(rx - 1.0) < 1e-15 and num_abs(zz.im) < 1e-15 {
        return map{ re: 0.0, im: 0.0 };
    }
    return c_sin(map{ re: PI * rx, im: PI * zz.im });
}

// Lanczos Gamma(z) over C \ {0, -1, -2, ...} with Euler reflection for Re(z) < 0.5
fn c_gamma(z) {
    let zz = _c(z);
    if num_abs(zz.im) < 1e-15 and _is_int_val(zz.re) {
        let ni = num_round(zz.re);
        if ni <= 0 {
            throw "complex_riemann_stochastic_game: Gamma pole at non-positive integer " + str(ni);
        }
        if ni <= 20 {
            let f = 1.0;
            let k = 2;
            while k < ni { f = f * k; k = k + 1; }
            return map{ re: f, im: 0.0 };
        }
    }

    if zz.re < 0.5 {
        // Euler reflection: Gamma(z) = pi / (sin(pi * z) * Gamma(1 - z))
        let sin_pz = _c_sin_pi(zz);
        if c_abs(sin_pz) < 1e-15 {
            throw "complex_riemann_stochastic_game: Gamma pole at non-positive integer";
        }
        let g_one_minus = c_gamma(map{ re: 1.0 - zz.re, im: 0.0 - zz.im });
        return c_div(map{ re: PI, im: 0.0 }, c_mul(sin_pz, g_one_minus));
    }

    let zm1 = map{ re: zz.re - 1.0, im: zz.im };
    let x_acc = map{ re: _LANCZOS_P[0], im: 0.0 };
    let i = 1;
    while i < len(_LANCZOS_P) {
        let denom = map{ re: zm1.re + (i * 1.0), im: zm1.im };
        x_acc = c_add(x_acc, c_div(map{ re: _LANCZOS_P[i], im: 0.0 }, denom));
        i = i + 1;
    }
    // g = 7 => t = zm1 + 7.5
    let t = map{ re: zm1.re + 7.5, im: zm1.im };
    let sqrt_2pi = 2.50662827463100050242;
    let pow_term = c_pow(t, map{ re: zm1.re + 0.5, im: zm1.im });
    let exp_term = c_exp(c_neg(t));
    return c_mul(map{ re: sqrt_2pi, im: 0.0 }, c_mul(pow_term, c_mul(exp_term, x_acc)));
}

fn gamma_complex(z) { return c_gamma(z); }

fn gamma_fn(z) {
    if type(z) == "number" {
        return c_gamma(map{ re: z * 1.0, im: 0.0 }).re;
    }
    return c_gamma(z);
}

// Log-Gamma ln(Gamma(x)) for x > 0 avoiding overflow for large x
fn lgamma(x) {
    let xv = x * 1.0;
    if xv <= 0.0 {
        if _is_int_val(xv) {
            throw "complex_riemann_stochastic_game: lgamma pole at non-positive integer";
        }
        // ln|Gamma(x)| = ln(pi) - ln|sin(pi*x)| - lgamma(1 - x)
        let sp = num_abs(_c_sin_pi(xv).re);
        return num_ln(PI) - num_ln(sp) - lgamma(1.0 - xv);
    }
    let zm1 = xv - 1.0;
    let acc = _LANCZOS_P[0];
    let i = 1;
    while i < len(_LANCZOS_P) {
        acc = acc + _LANCZOS_P[i] / (zm1 + (i * 1.0));
        i = i + 1;
    }
    let t = zm1 + 7.5;
    return 0.91893853320467274178 + (zm1 + 0.5) * num_ln(t) - t + num_ln(acc);
}

// Digamma psi(x) = d/dx ln(Gamma(x)) via recurrence + reflection + 14th-order Bernoulli expansion
fn digamma(x) {
    let xv = x * 1.0;
    if xv <= 0.0 and _is_int_val(xv) {
        throw "complex_riemann_stochastic_game: digamma pole at non-positive integer";
    }
    let result = 0.0;
    if xv < 0.0 {
        // Reflection: psi(x) = psi(1 - x) - pi * cot(pi * x)
        let rx = xv - num_floor(xv);
        let cot_px = num_cos(PI * rx) / num_sin(PI * rx);
        return digamma(1.0 - xv) - PI * cot_px;
    }
    while xv < 8.0 {
        result = result - (1.0 / xv);
        xv = xv + 1.0;
    }
    let inv = 1.0 / xv;
    let inv2 = inv * inv;
    // psi(x) ~ ln(x) - 1/(2x) - sum_{k=1}^7 B_{2k}/(2k * x^{2k})
    let asymp = num_ln(xv) - 0.5 * inv - inv2 * (
        (1.0 / 12.0) - inv2 * (
            (1.0 / 120.0) - inv2 * (
                (1.0 / 252.0) - inv2 * (
                    (1.0 / 240.0) - inv2 * (
                        (1.0 / 132.0) - inv2 * (
                            (691.0 / 32760.0) - inv2 * (1.0 / 12.0)
                        )
                    )
                )
            )
        )
    );
    return result + asymp;
}

fn beta_fn(a, b) {
    if type(a) == "number" and type(b) == "number" and a > 0.0 and b > 0.0 {
        return num_exp(lgamma(a) + lgamma(b) - lgamma(a + b));
    }
    return c_div(c_mul(c_gamma(a), c_gamma(b)), c_gamma(c_add(a, b)));
}

// Regularized & unregularized Incomplete Gamma via Taylor series (x < a + 1) and Legendre Lentz CF (x >= a + 1)
fn _gamma_reg_pair(a, x) {
    let av = a * 1.0;
    let xv = x * 1.0;
    if av <= 0.0 or xv < 0.0 {
        throw "complex_riemann_stochastic_game: incomplete gamma requires a > 0 and x >= 0";
    }
    if xv == 0.0 {
        return map{ P: 0.0, Q: 1.0 };
    }
    let lg_a = lgamma(av);
    if xv < av + 1.0 {
        // Series: P(a, x) = e^{-x} x^a * sum_{n=0}^inf x^n / Gamma(a + n + 1)
        let ap = av;
        let term = 1.0 / av;
        let sum_s = term;
        let n = 1;
        while n <= 500 {
            ap = ap + 1.0;
            term = term * (xv / ap);
            sum_s = sum_s + term;
            if num_abs(term) < num_abs(sum_s) * 1e-15 { break; }
            n = n + 1;
        }
        let log_pref = av * num_ln(xv) - xv - lg_a;
        let P = if log_pref < -700.0 { 0.0 } else { num_exp(log_pref) * sum_s };
        if P > 1.0 { P = 1.0; }
        return map{ P: P, Q: 1.0 - P };
    }

    // Modified Lentz algorithm for Legendre continued fraction of Q(a, x)
    let tiny = 1e-30;
    let b = xv + 1.0 - av;
    let c = 1.0 / tiny;
    let d = 1.0 / b;
    let h = d;
    let i = 1;
    while i <= 500 {
        let an = (0.0 - (i * 1.0)) * ((i * 1.0) - av);
        b = b + 2.0;
        d = an * d + b;
        if num_abs(d) < tiny { d = tiny; }
        c = b + an / c;
        if num_abs(c) < tiny { c = tiny; }
        d = 1.0 / d;
        let del = d * c;
        h = h * del;
        if num_abs(del - 1.0) < 1e-15 { break; }
        i = i + 1;
    }
    let log_pref2 = av * num_ln(xv) - xv - lg_a;
    let Q = if log_pref2 < -700.0 { 0.0 } else { num_exp(log_pref2) * h };
    if Q > 1.0 { Q = 1.0; }
    return map{ P: 1.0 - Q, Q: Q };
}

fn gamma_lower_reg(a, x) { return _gamma_reg_pair(a, x).P; }
fn gamma_upper_reg(a, x) { return _gamma_reg_pair(a, x).Q; }

fn gamma_lower(a, x, regularized = false) {
    let pq = _gamma_reg_pair(a, x);
    if regularized { return pq.P; }
    return pq.P * num_exp(lgamma(a));
}

fn gamma_upper(a, x, regularized = false) {
    let pq = _gamma_reg_pair(a, x);
    if regularized { return pq.Q; }
    return pq.Q * num_exp(lgamma(a));
}

// Riemann Zeta zeta(s) over C \ {1} via Borwein's Chebyshev Dirichlet-eta acceleration
// + Riemann's functional equation zeta(s) = 2^s pi^{s-1} sin(pi s / 2) Gamma(1 - s) zeta(1 - s)
let _BORWEIN_CACHE = map{};

// Returns normalized positive tail ratios w_k = 1 - d_k / d_n in (0, 1] for k = 0 .. n-1
fn _borwein_weights(n) {
    let key = str(n);
    if map_has(_BORWEIN_CACHE, key) {
        return _BORWEIN_CACHE[key];
    }
    // Positive terms t_i = n * (n + i - 1)! * 4^i / ((n - i)! * (2i)!)
    // Recurrence: t_0 = 1, t_i = t_{i-1} * 2*(n + i - 1)*(n - i + 1) / (i * (2i - 1))
    let terms = [1.0];
    let t = 1.0;
    let i = 1;
    while i <= n {
        t = t * ((2.0 * (n + i - 1.0) * (n - i + 1.0)) / ((i * 1.0) * (2.0 * i - 1.0)));
        array_push(terms, t);
        i = i + 1;
    }
    // Accumulate tail sums from i = n down to 0 (purely positive additions -> zero cancellation!)
    let tails = [];
    i = 0;
    while i <= n { array_push(tails, 0.0); i = i + 1; }
    let run = 0.0;
    let idx = n;
    while idx >= 0 {
        run = run + terms[idx];
        tails[idx] = run;
        idx = idx - 1;
    }
    let dn = tails[0];
    // d_n - d_k = sum_{i = k+1}^n t_i = tails[k + 1]
    let w = [];
    let k = 0;
    while k < n {
        array_push(w, tails[k + 1] / dn);
        k = k + 1;
    }
    _BORWEIN_CACHE[key] = w;
    return w;
}

fn c_zeta(s) {
    let cs = _c(s);
    if c_abs(c_sub(cs, map{ re: 1.0, im: 0.0 })) < 1e-14 {
        throw "complex_riemann_stochastic_game: Riemann zeta simple pole at s = 1";
    }

    // Exact trivial zeros at negative even integers -2, -4, -6, ...
    if num_abs(cs.im) < 1e-15 and cs.re < -0.5 and _is_int_val(cs.re) {
        let ni = num_round(cs.re);
        if num_mod(num_abs(ni), 2) == 0 {
            return map{ re: 0.0, im: 0.0 };
        }
    }

    // For Re(s) < 0.25 and outside |s| < 0.25 (so 1 - s stays well away from the pole at 1),
    // reflect to Re(1 - s) > 0.75 via Riemann's exact functional equation!
    if cs.re < 0.25 and c_abs(cs) >= 0.25 {
        let one_minus_s = map{ re: 1.0 - cs.re, im: 0.0 - cs.im };
        let two_pow_s = c_pow(map{ re: 2.0, im: 0.0 }, cs);
        let pi_pow_sm1 = c_pow(map{ re: PI, im: 0.0 }, map{ re: cs.re - 1.0, im: cs.im });
        let sin_half = _c_sin_pi(map{ re: 0.5 * cs.re, im: 0.5 * cs.im });
        let gam_1ms = c_gamma(one_minus_s);
        let zet_1ms = c_zeta(one_minus_s);
        return c_mul(two_pow_s, c_mul(pi_pow_sm1, c_mul(sin_half, c_mul(gam_1ms, zet_1ms))));
    }

    // Borwein Chebyshev acceleration of Dirichlet eta(s) = (1 - 2^{1-s}) * zeta(s):
    // eta(s) = sum_{k=0}^{n-1} (-1)^k * w_k * (k + 1)^{-s}
    let n_terms = num_round(26.0 + 1.15 * num_abs(cs.im));
    if n_terms < 36 { n_terms = 36; }
    if n_terms > 96 { n_terms = 96; }
    let w = _borwein_weights(n_terms);

    let eta_re = 0.0;
    let eta_im = 0.0;
    let k = 0;
    while k < n_terms {
        let ln_kp1 = num_ln((k + 1) * 1.0);
        let mag = num_exp((0.0 - cs.re) * ln_kp1);
        let ang = (0.0 - cs.im) * ln_kp1;
        let sgn = if num_mod(k, 2) == 0 { w[k] } else { 0.0 - w[k] };
        eta_re = eta_re + sgn * mag * num_cos(ang);
        eta_im = eta_im + sgn * mag * num_sin(ang);
        k = k + 1;
    }
    let eta = map{ re: eta_re, im: eta_im };
    // Factor 1 - 2^{1 - s} (note: vanishes at 1 + 2*pi*i*m / ln(2) where Re(s) = 1; if near a zero of 1 - 2^{1-s},
    // use 3-adic factor 1 - 3^{1-s} sum instead!)
    let one_minus_2 = c_sub(map{ re: 1.0, im: 0.0 }, c_pow(map{ re: 2.0, im: 0.0 }, map{ re: 1.0 - cs.re, im: 0.0 - cs.im }));
    if c_abs(one_minus_2) < 1e-7 {
        // Euler-Maclaurin direct evaluation when 2^{1-s} == 1 (s = 1 + i*2*pi*m/ln 2)
        let N_em = 24;
        let acc = map{ re: 0.0, im: 0.0 };
        let j = 1;
        while j < N_em {
            acc = c_add(acc, c_pow(map{ re: j * 1.0, im: 0.0 }, c_neg(cs)));
            j = j + 1;
        }
        let n_c = map{ re: N_em * 1.0, im: 0.0 };
        let n_ms = c_pow(n_c, c_neg(cs));
        let sm1 = c_sub(cs, map{ re: 1.0, im: 0.0 });
        acc = c_add(acc, c_div(c_mul(n_c, n_ms), sm1));
        acc = c_add(acc, c_mul(map{ re: 0.5, im: 0.0 }, n_ms));
        // Bernoulli correction terms B2/2!, B4/4!, B6/6!, B8/8!
        let b_coeffs = [1.0 / 12.0, -1.0 / 720.0, 1.0 / 30240.0, -1.0 / 1209600.0];
        let poch = cs;
        let inv_n2 = 1.0 / ((N_em * N_em) * 1.0);
        let cur_pow = c_div(n_ms, n_c);
        let bi = 0;
        while bi < len(b_coeffs) {
            acc = c_add(acc, c_mul(map{ re: b_coeffs[bi], im: 0.0 }, c_mul(poch, cur_pow)));
            let s1 = map{ re: cs.re + (2 * bi + 1), im: cs.im };
            let s2 = map{ re: cs.re + (2 * bi + 2), im: cs.im };
            poch = c_mul(poch, c_mul(s1, s2));
            cur_pow = c_mul(cur_pow, map{ re: inv_n2, im: 0.0 });
            bi = bi + 1;
        }
        return acc;
    }
    return c_div(eta, one_minus_2);
}

fn riemann_zeta(s) { return c_zeta(s); }

fn zeta(s) {
    if type(s) == "number" {
        return c_zeta(map{ re: s * 1.0, im: 0.0 }).re;
    }
    return c_zeta(s);
}

// Lambert W_0(x) and W_{-1}(x) via Halley's 3rd-order root-finding to 1e-15
fn _lambert_halley(x, w_init) {
    let w = w_init * 1.0;
    let iter = 0;
    while iter < 40 {
        let ew = num_exp(w);
        let wew = w * ew;
        let f = wew - x;
        if num_abs(f) <= 1e-15 * (1.0 + num_abs(x)) {
            break;
        }
        let wp1 = w + 1.0;
        let denom = ew * wp1 - ((w + 2.0) * f) / (2.0 * wp1);
        if num_abs(denom) < 1e-30 { break; }
        let dw = f / denom;
        w = w - dw;
        if num_abs(dw) <= 1e-15 * (1.0 + num_abs(w)) {
            break;
        }
        iter = iter + 1;
    }
    return w;
}

fn lambert_w0(x) {
    let xv = x * 1.0;
    if xv < (0.0 - INV_E) - 1e-15 {
        throw "complex_riemann_stochastic_game: lambert_w0 domain error (x < -1/e)";
    }
    if num_abs(xv + INV_E) <= 1e-15 { return -1.0; }
    if xv == 0.0 { return 0.0; }

    let w0 = 0.0;
    if xv < -0.25 {
        let p = num_sqrt(2.0 * (E_CONST * xv + 1.0));
        w0 = -1.0 + p * (1.0 - p / 3.0 + (11.0 / 72.0) * p * p);
    } else if xv < 1.5 {
        w0 = xv / (1.0 + 0.5 * xv);
    } else {
        let l1 = num_ln(xv);
        let l2 = num_ln(l1);
        w0 = l1 - l2 + l2 / l1;
    }
    return _lambert_halley(xv, w0);
}

fn lambert_wm1(x) {
    let xv = x * 1.0;
    if xv < (0.0 - INV_E) - 1e-15 or xv >= 0.0 {
        throw "complex_riemann_stochastic_game: lambert_wm1 domain error (requires -1/e <= x < 0)";
    }
    if num_abs(xv + INV_E) <= 1e-15 { return -1.0; }

    let w0 = -2.0;
    if xv > -0.25 {
        let p = num_sqrt(2.0 * (E_CONST * xv + 1.0));
        w0 = -1.0 - p - (p * p) / 3.0;
    } else {
        let l1 = num_ln(0.0 - xv);
        let l2 = num_ln(0.0 - l1);
        w0 = l1 - l2 + l2 / l1;
    }
    return _lambert_halley(xv, w0);
}

// Bessel J_n(x) and Modified Bessel I_n(x)
fn bessel_j(n, x) {
    let xv = x * 1.0;
    if _is_int_val(n) {
        let ni = num_round(n);
        if ni < 0 {
            let sgn = if num_mod(num_abs(ni), 2) == 1 { -1.0 } else { 1.0 };
            return sgn * bessel_j(0 - ni, xv);
        }
        if xv < 0.0 {
            let sgn2 = if num_mod(ni, 2) == 1 { -1.0 } else { 1.0 };
            return sgn2 * bessel_j(ni, 0.0 - xv);
        }
        if xv == 0.0 {
            return if ni == 0 { 1.0 } else { 0.0 };
        }
        // Convergent power series for moderate x <= 12 (zero instability)
        if xv <= 12.0 {
            let half_x = 0.5 * xv;
            let pref = num_pow(half_x, ni * 1.0) / num_exp(lgamma((ni + 1) * 1.0));
            let term = pref;
            let sum_j = term;
            let mh2 = 0.0 - (half_x * half_x);
            let k = 1;
            while k <= 120 {
                term = (term * mh2) / ((k * 1.0) * ((ni + k) * 1.0));
                sum_j = sum_j + term;
                if num_abs(term) <= 1e-16 * num_abs(sum_j) { break; }
                k = k + 1;
            }
            return sum_j;
        }
        // Miller's downward recurrence for xv > 12 (avoids alternating cancellation completely!)
        if xv <= 80.0 {
            let M = num_round(2.0 * xv + (ni * 1.0) + 44.0);
            if num_mod(M, 2) == 1 { M = M + 1; }
            let f_next = 0.0;
            let f_cur = 1e-30;
            let target_val = 0.0;
            let norm_sum = 0.0;
            let m = M;
            while m >= 1 {
                let f_prev = ((2.0 * m) / xv) * f_cur - f_next;
                if m - 1 == ni { target_val = f_prev; }
                if m - 1 == 0 {
                    norm_sum = norm_sum + f_prev;
                } else if num_mod(m - 1, 2) == 0 {
                    norm_sum = norm_sum + 2.0 * f_prev;
                }
                // Rescale if growing near overflow
                if num_abs(f_prev) > 1e100 {
                    f_prev = f_prev * 1e-100;
                    f_cur = f_cur * 1e-100;
                    target_val = target_val * 1e-100;
                    norm_sum = norm_sum * 1e-100;
                }
                f_next = f_cur;
                f_cur = f_prev;
                m = m - 1;
            }
            return target_val / norm_sum;
        }
        // Hankel asymptotic expansion for large xv > 80
        let mu = 4.0 * ni * ni;
        let chi = xv - (0.5 * ni + 0.25) * PI;
        let x8 = 8.0 * xv;
        let P = 1.0 - ((mu - 1.0) * (mu - 9.0)) / (2.0 * x8 * x8);
        let Q = (mu - 1.0) / x8 - ((mu - 1.0) * (mu - 9.0) * (mu - 25.0)) / (6.0 * x8 * x8 * x8);
        return num_sqrt(2.0 / (PI * xv)) * (P * num_cos(chi) - Q * num_sin(chi));
    }

    // Non-integer order nu >= 0
    let nu = n * 1.0;
    if xv < 0.0 or nu < 0.0 {
        throw "complex_riemann_stochastic_game: non-integer bessel_j requires nu >= 0, x >= 0";
    }
    if xv == 0.0 { return if nu == 0.0 { 1.0 } else { 0.0 }; }
    let half_x2 = 0.5 * xv;
    let term2 = num_exp(nu * num_ln(half_x2) - lgamma(nu + 1.0));
    let sum2 = term2;
    let mh2_b = 0.0 - (half_x2 * half_x2);
    let k2 = 1;
    while k2 <= 160 {
        term2 = (term2 * mh2_b) / ((k2 * 1.0) * (nu + (k2 * 1.0)));
        sum2 = sum2 + term2;
        if num_abs(term2) <= 1e-16 * num_abs(sum2) { break; }
        k2 = k2 + 1;
    }
    return sum2;
}

// Modified Bessel I_n(x): strictly positive series terms for x >= 0 (zero cancellation!)
fn bessel_i(n, x) {
    let xv = x * 1.0;
    let nu = n * 1.0;
    if _is_int_val(nu) and nu < 0.0 {
        nu = 0.0 - nu; // I_{-n}(x) = I_n(x) for integer n
    }
    if xv < 0.0 {
        if not _is_int_val(nu) {
            throw "complex_riemann_stochastic_game: non-integer bessel_i requires x >= 0";
        }
        let ni = num_round(nu);
        let sgn = if num_mod(ni, 2) == 1 { -1.0 } else { 1.0 };
        return sgn * bessel_i(ni, 0.0 - xv);
    }
    if xv == 0.0 {
        return if nu == 0.0 { 1.0 } else { 0.0 };
    }
    let half_x = 0.5 * xv;
    let term = num_exp(nu * num_ln(half_x) - lgamma(nu + 1.0));
    let sum_i = term;
    let h2 = half_x * half_x;
    let k = 1;
    while k <= 300 {
        term = (term * h2) / ((k * 1.0) * (nu + (k * 1.0)));
        sum_i = sum_i + term;
        if term <= 1e-16 * sum_i { break; }
        k = k + 1;
    }
    return sum_i;
}

// Complete Elliptic Integrals K(m) and E(m) (m = k^2 < 1) via Gauss AGM
fn _elliptic_agm_pair(m) {
    let mv = m * 1.0;
    if mv >= 1.0 {
        throw "complex_riemann_stochastic_game: elliptic_K domain error (m >= 1)";
    }
    let a = 1.0;
    let b = num_sqrt(1.0 - mv);
    // Track sum_{n=0}^inf 2^{n - 1} * c_n^2 where c_0^2 = m and c_n = (a_{n-1} - b_{n-1}) / 2 for n >= 1
    let sum_c = 0.5 * mv;
    let pow2 = 1.0;
    let iter = 0;
    while iter < 32 {
        let an = 0.5 * (a + b);
        let bn = num_sqrt(a * b);
        let cn = 0.5 * (a - b);
        sum_c = sum_c + pow2 * (cn * cn);
        a = an;
        b = bn;
        pow2 = pow2 * 2.0;
        if num_abs(cn) <= 1e-16 * a { break; }
        iter = iter + 1;
    }
    let K_val = HALF_PI / a;
    let E_val = K_val * (1.0 - sum_c);
    return map{ K: K_val, E: E_val, iterations: iter + 1 };
}

fn elliptic_K(m) {
    return _elliptic_agm_pair(m).K;
}

fn elliptic_E(m) {
    let mv = m * 1.0;
    if mv == 1.0 { return 1.0; }
    if mv > 1.0 {
        throw "complex_riemann_stochastic_game: elliptic_E domain error (m > 1)";
    }
    return _elliptic_agm_pair(mv).E;
}

fn nonlinear_pendulum_period(length_L, g_accel, theta0_rad) {
    if length_L <= 0.0 or g_accel <= 0.0 {
        throw "complex_riemann_stochastic_game: pendulum length and gravity must be > 0";
    }
    let s = num_sin(0.5 * theta0_rad);
    return 4.0 * num_sqrt((length_L * 1.0) / (g_accel * 1.0)) * elliptic_K(s * s);
}

fn ellipse_perimeter_exact(semi_a, semi_b) {
    if semi_a <= 0.0 or semi_b <= 0.0 {
        throw "complex_riemann_stochastic_game: ellipse semi-axes must be > 0";
    }
    let a = if semi_a >= semi_b { semi_a * 1.0 } else { semi_b * 1.0 };
    let b = if semi_a >= semi_b { semi_b * 1.0 } else { semi_a * 1.0 };
    let m = 1.0 - (b * b) / (a * a);
    return 4.0 * a * elliptic_E(m);
}

// Exact rational polynomial helpers for Symbolic + Numerical Orthogonal Polynomials
fn _r_norm(p, q) {
    if p == 0 { return map{ p: 0, q: 1 }; }
    let np = p;
    let nq = q;
    if nq < 0 { np = 0 - np; nq = 0 - nq; }
    let g = _gcd_int(np, nq);
    return map{ p: num_round(np / g), q: num_round(nq / g) };
}

fn _r_add(a, b) { return _r_norm(a.p * b.q + b.p * a.q, a.q * b.q); }
fn _r_sub(a, b) { return _r_norm(a.p * b.q - b.p * a.q, a.q * b.q); }
fn _r_mul(a, b) { return _r_norm(a.p * b.p, a.q * b.q); }

fn _rpoly_zero(deg) {
    let out = [];
    let i = 0;
    while i <= deg { array_push(out, map{ p: 0, q: 1 }); i = i + 1; }
    return out;
}

fn _rpoly_eval(coeffs, x) {
    let acc = 0.0;
    let i = len(coeffs) - 1;
    let xv = x * 1.0;
    while i >= 0 {
        let c = (coeffs[i].p * 1.0) / (coeffs[i].q * 1.0);
        acc = acc * xv + c;
        i = i - 1;
    }
    return acc;
}

fn _rpoly_to_calc_obj(coeffs, var_name) {
    let CALC = _calc();
    let terms = [];
    let i = len(coeffs) - 1;
    while i >= 0 {
        let c = coeffs[i];
        if c.p != 0 {
            let abs_p = num_round(num_abs(c.p));
            let c_str = if c.q == 1 { str(abs_p) } else { "(" + str(abs_p) + "/" + str(c.q) + ")" };
            let mono = "";
            if i == 0 {
                mono = if c.q == 1 { str(abs_p) } else { str(abs_p) + "/" + str(c.q) };
            } else {
                let xp = if i == 1 { var_name } else { var_name + "^" + str(i) };
                if abs_p == 1 and c.q == 1 {
                    mono = xp;
                } else {
                    mono = c_str + "*" + xp;
                }
            }
            array_push(terms, map{ neg: c.p < 0, txt: mono });
        }
        i = i - 1;
    }
    if len(terms) == 0 {
        return CALC.simplify("0");
    }
    let expr = if terms[0].neg { "-" + terms[0].txt } else { terms[0].txt };
    let k = 1;
    while k < len(terms) {
        if terms[k].neg {
            expr = expr + " - " + terms[k].txt;
        } else {
            expr = expr + " + " + terms[k].txt;
        }
        k = k + 1;
    }
    return CALC.simplify(expr);
}

fn _build_ortho_result(family, n, coeffs, x_or_var) {
    let v_name = if type(x_or_var) == "string" { x_or_var } else { "x" };
    let sym_obj = _rpoly_to_calc_obj(coeffs, v_name);
    let f_coeffs = [];
    let i = 0;
    while i < len(coeffs) {
        array_push(f_coeffs, (coeffs[i].p * 1.0) / (coeffs[i].q * 1.0));
        i = i + 1;
    }
    let val = if type(x_or_var) == "number" { _rpoly_eval(coeffs, x_or_var) } else { nil };
    return map{
        family: family,
        n: n,
        variable: v_name,
        expr: sym_obj.ascii,
        ascii: sym_obj.ascii,
        unicode: sym_obj.unicode,
        latex: sym_obj.latex,
        ast: sym_obj.ast,
        coeffs_asc: f_coeffs,
        value: val,
        evaluate: fn(xv) { return _rpoly_eval(coeffs, xv); }
    };
}

fn _check_ortho_deg(n, fn_name) {
    if not _is_int_val(n) or n < 0 or n > MAX_POLY_DEGREE {
        throw "complex_riemann_stochastic_game: " + fn_name + " degree n must be integer in [0, " + str(MAX_POLY_DEGREE) + "]";
    }
    return num_round(n);
}

// Legendre P_n(x): n P_n(x) = (2n - 1) x P_{n-1}(x) - (n - 1) P_{n-2}(x)
fn legendre_P(n, x_or_var = "x") {
    let deg = _check_ortho_deg(n, "legendre_P");
    if deg == 0 { return _build_ortho_result("legendre_P", 0, [_r_norm(1, 1)], x_or_var); }
    if deg == 1 { return _build_ortho_result("legendre_P", 1, [_r_norm(0, 1), _r_norm(1, 1)], x_or_var); }
    let pm2 = [_r_norm(1, 1)];
    let pm1 = [_r_norm(0, 1), _r_norm(1, 1)];
    let k = 2;
    while k <= deg {
        let cur = _rpoly_zero(k);
        let a_fac = _r_norm(2 * k - 1, k);
        let b_fac = _r_norm(k - 1, k);
        let j = 0;
        while j < len(pm1) {
            cur[j + 1] = _r_add(cur[j + 1], _r_mul(a_fac, pm1[j]));
            j = j + 1;
        }
        j = 0;
        while j < len(pm2) {
            cur[j] = _r_sub(cur[j], _r_mul(b_fac, pm2[j]));
            j = j + 1;
        }
        pm2 = pm1;
        pm1 = cur;
        k = k + 1;
    }
    return _build_ortho_result("legendre_P", deg, pm1, x_or_var);
}

// Chebyshev 1st kind T_n(x): T_0 = 1, T_1 = x, T_n = 2x T_{n-1} - T_{n-2}
fn chebyshev_T(n, x_or_var = "x") {
    let deg = _check_ortho_deg(n, "chebyshev_T");
    if deg == 0 { return _build_ortho_result("chebyshev_T", 0, [_r_norm(1, 1)], x_or_var); }
    if deg == 1 { return _build_ortho_result("chebyshev_T", 1, [_r_norm(0, 1), _r_norm(1, 1)], x_or_var); }
    let pm2 = [_r_norm(1, 1)];
    let pm1 = [_r_norm(0, 1), _r_norm(1, 1)];
    let two = _r_norm(2, 1);
    let k = 2;
    while k <= deg {
        let cur = _rpoly_zero(k);
        let j = 0;
        while j < len(pm1) {
            cur[j + 1] = _r_add(cur[j + 1], _r_mul(two, pm1[j]));
            j = j + 1;
        }
        j = 0;
        while j < len(pm2) {
            cur[j] = _r_sub(cur[j], pm2[j]);
            j = j + 1;
        }
        pm2 = pm1;
        pm1 = cur;
        k = k + 1;
    }
    return _build_ortho_result("chebyshev_T", deg, pm1, x_or_var);
}

// Chebyshev 2nd kind U_n(x): U_0 = 1, U_1 = 2x, U_n = 2x U_{n-1} - U_{n-2}
fn chebyshev_U(n, x_or_var = "x") {
    let deg = _check_ortho_deg(n, "chebyshev_U");
    if deg == 0 { return _build_ortho_result("chebyshev_U", 0, [_r_norm(1, 1)], x_or_var); }
    if deg == 1 { return _build_ortho_result("chebyshev_U", 1, [_r_norm(0, 1), _r_norm(2, 1)], x_or_var); }
    let pm2 = [_r_norm(1, 1)];
    let pm1 = [_r_norm(0, 1), _r_norm(2, 1)];
    let two = _r_norm(2, 1);
    let k = 2;
    while k <= deg {
        let cur = _rpoly_zero(k);
        let j = 0;
        while j < len(pm1) {
            cur[j + 1] = _r_add(cur[j + 1], _r_mul(two, pm1[j]));
            j = j + 1;
        }
        j = 0;
        while j < len(pm2) {
            cur[j] = _r_sub(cur[j], pm2[j]);
            j = j + 1;
        }
        pm2 = pm1;
        pm1 = cur;
        k = k + 1;
    }
    return _build_ortho_result("chebyshev_U", deg, pm1, x_or_var);
}

// Physicists' Hermite H_n(x): H_0 = 1, H_1 = 2x, H_n = 2x H_{n-1} - 2(n - 1) H_{n-2}
fn hermite_H(n, x_or_var = "x") {
    let deg = _check_ortho_deg(n, "hermite_H");
    if deg == 0 { return _build_ortho_result("hermite_H", 0, [_r_norm(1, 1)], x_or_var); }
    if deg == 1 { return _build_ortho_result("hermite_H", 1, [_r_norm(0, 1), _r_norm(2, 1)], x_or_var); }
    let pm2 = [_r_norm(1, 1)];
    let pm1 = [_r_norm(0, 1), _r_norm(2, 1)];
    let two = _r_norm(2, 1);
    let k = 2;
    while k <= deg {
        let cur = _rpoly_zero(k);
        let b_fac = _r_norm(2 * (k - 1), 1);
        let j = 0;
        while j < len(pm1) {
            cur[j + 1] = _r_add(cur[j + 1], _r_mul(two, pm1[j]));
            j = j + 1;
        }
        j = 0;
        while j < len(pm2) {
            cur[j] = _r_sub(cur[j], _r_mul(b_fac, pm2[j]));
            j = j + 1;
        }
        pm2 = pm1;
        pm1 = cur;
        k = k + 1;
    }
    return _build_ortho_result("hermite_H", deg, pm1, x_or_var);
}

// Laguerre L_n(x): L_0 = 1, L_1 = 1 - x, n L_n = (2n - 1 - x) L_{n-1} - (n - 1) L_{n-2}
fn laguerre_L(n, x_or_var = "x") {
    let deg = _check_ortho_deg(n, "laguerre_L");
    if deg == 0 { return _build_ortho_result("laguerre_L", 0, [_r_norm(1, 1)], x_or_var); }
    if deg == 1 { return _build_ortho_result("laguerre_L", 1, [_r_norm(1, 1), _r_norm(-1, 1)], x_or_var); }
    let pm2 = [_r_norm(1, 1)];
    let pm1 = [_r_norm(1, 1), _r_norm(-1, 1)];
    let k = 2;
    while k <= deg {
        let cur = _rpoly_zero(k);
        let a0 = _r_norm(2 * k - 1, k);
        let a1 = _r_norm(-1, k);
        let b0 = _r_norm(k - 1, k);
        let j = 0;
        while j < len(pm1) {
            cur[j] = _r_add(cur[j], _r_mul(a0, pm1[j]));
            cur[j + 1] = _r_add(cur[j + 1], _r_mul(a1, pm1[j]));
            j = j + 1;
        }
        j = 0;
        while j < len(pm2) {
            cur[j] = _r_sub(cur[j], _r_mul(b0, pm2[j]));
            j = j + 1;
        }
        pm2 = pm1;
        pm1 = cur;
        k = k + 1;
    }
    return _build_ortho_result("laguerre_L", deg, pm1, x_or_var);
}

// ============================================================================
// 3. Symbolic Riemannian Differential Geometry, Variations & Chaos (MSC 37, 49, 53, 83)
// ============================================================================

fn _s_add(a, b) {
    if a == "0" { return b; }
    if b == "0" { return a; }
    return _sym_simplify_deep("(" + a + ") + (" + b + ")", false).ascii;
}

fn _s_sub(a, b) {
    if b == "0" { return a; }
    if a == "0" { return _sym_simplify_deep("-(" + b + ")", false).ascii; }
    if a == b { return "0"; }
    return _sym_simplify_deep("(" + a + ") - (" + b + ")", false).ascii;
}

fn _s_mul(a, b) {
    if a == "0" or b == "0" { return "0"; }
    if a == "1" { return b; }
    if b == "1" { return a; }
    return _sym_simplify_deep("(" + a + ")*(" + b + ")", false).ascii;
}

fn _s_div(a, b) {
    if b == "0" { throw "complex_riemann_stochastic_game: symbolic division by zero"; }
    if a == "0" { return "0"; }
    if b == "1" { return a; }
    return _sym_simplify_deep("(" + a + ")/(" + b + ")", false).ascii;
}

fn _s_diff(expr, v) {
    if expr == "0" { return "0"; }
    let d = _calc().diff(expr, v, 1).ascii;
    if d == "0" { return "0"; }
    return _sym_simplify_deep(d, false).ascii;
}

// Symbolic determinant & inverse via diagonal fast-path + exact Laplace cofactor expansion
fn _sym_submatrix(M, skip_r, skip_c) {
    let n = len(M);
    let sub = [];
    let r = 0;
    while r < n {
        if r != skip_r {
            let row = [];
            let c = 0;
            while c < n {
                if c != skip_c {
                    array_push(row, M[r][c]);
                }
                c = c + 1;
            }
            array_push(sub, row);
        }
        r = r + 1;
    }
    return sub;
}

fn _sym_det(M) {
    let n = len(M);
    if n == 1 { return M[0][0]; }
    if n == 2 {
        return _s_sub(_s_mul(M[0][0], M[1][1]), _s_mul(M[0][1], M[1][0]));
    }
    let acc = "0";
    let c = 0;
    while c < n {
        let entry = M[0][c];
        if entry != "0" {
            let minor_det = _sym_det(_sym_submatrix(M, 0, c));
            let term = _s_mul(entry, minor_det);
            if num_mod(c, 2) == 0 {
                acc = _s_add(acc, term);
            } else {
                acc = _s_sub(acc, term);
            }
        }
        c = c + 1;
    }
    return acc;
}

fn _sym_inv_metric(g) {
    let n = len(g);
    // Check diagonal fast path
    let is_diag = true;
    let i = 0;
    while i < n {
        let j = 0;
        while j < n {
            if i != j and g[i][j] != "0" { is_diag = false; }
            j = j + 1;
        }
        i = i + 1;
    }

    if is_diag {
        let inv = [];
        let det = "1";
        i = 0;
        while i < n {
            if g[i][i] == "0" {
                throw "complex_riemann_stochastic_game: singular diagonal metric tensor";
            }
            det = _s_mul(det, g[i][i]);
            let row = [];
            let j = 0;
            while j < n {
                if i == j {
                    array_push(row, _s_div("1", g[i][i]));
                } else {
                    array_push(row, "0");
                }
                j = j + 1;
            }
            array_push(inv, row);
            i = i + 1;
        }
        return map{ inv: inv, det: det, is_diagonal: true };
    }

    let det_g = _sym_det(g);
    if det_g == "0" {
        throw "complex_riemann_stochastic_game: singular metric tensor (det = 0)";
    }
    if n == 1 {
        return map{ inv: [[_s_div("1", g[0][0])]], det: det_g, is_diagonal: true };
    }
    let inv_m = [];
    i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            // Adjugate entry (i, j) is cofactor (j, i)
            let minor_ji = _sym_det(_sym_submatrix(g, j, i));
            let cof = if num_mod(i + j, 2) == 0 { minor_ji } else { _s_sub("0", minor_ji) };
            array_push(row, _s_div(cof, det_g));
            j = j + 1;
        }
        array_push(inv_m, row);
        i = i + 1;
    }
    return map{ inv: inv_m, det: det_g, is_diagonal: false };
}

fn riemannian_geometry(metric_expr_matrix, coords) {
    let n = len(coords);
    if n < 1 or n > MAX_TENSOR_DIM or len(metric_expr_matrix) != n {
        throw "complex_riemann_stochastic_game: invalid metric dimension";
    }
    // Canonicalize metric entries keeping sin/cos un-contracted internally
    let g = [];
    let i = 0;
    while i < n {
        if len(metric_expr_matrix[i]) != n {
            throw "complex_riemann_stochastic_game: metric matrix must be square n x n";
        }
        let row = [];
        let j = 0;
        while j < n {
            array_push(row, _sym_simplify_deep(str(metric_expr_matrix[i][j]), false).ascii);
            j = j + 1;
        }
        array_push(g, row);
        i = i + 1;
    }

    let inv_info = _sym_inv_metric(g);
    let g_inv = inv_info.inv;

    // Precompute partial derivatives dg[sigma][mu][nu] = d(g_{sigma, mu}) / d(x^nu)
    let dg = [];
    let sig = 0;
    while sig < n {
        let dg_sig = [];
        let mu = 0;
        while mu < n {
            let dg_row = [];
            let nu = 0;
            while nu < n {
                array_push(dg_row, _s_diff(g[sig][mu], coords[nu]));
                nu = nu + 1;
            }
            array_push(dg_sig, dg_row);
            mu = mu + 1;
        }
        array_push(dg, dg_sig);
        sig = sig + 1;
    }

    // Christoffel symbols of the 2nd kind:
    // Gamma^lam_{mu nu} = 1/2 * sum_sig g^{lam sig} (d_nu g_{sig mu} + d_mu g_{sig nu} - d_sig g_{mu nu})
    let gamma_raw = [];
    let gamma_pretty = [];
    let lam = 0;
    while lam < n {
        let mat_raw = [];
        let mat_pretty = [];
        let mu = 0;
        while mu < n {
            let row_raw = [];
            let row_pretty = [];
            let nu = 0;
            while nu < n {
                if nu < mu {
                    // Torsion-free Levi-Civita symmetry Gamma^lam_{mu nu} == Gamma^lam_{nu mu}
                    array_push(row_raw, mat_raw[nu][mu]);
                    array_push(row_pretty, mat_pretty[nu][mu]);
                } else {
                    let sum_c = "0";
                    sig = 0;
                    while sig < n {
                        let g_up = g_inv[lam][sig];
                        if g_up != "0" {
                            let bracket = _s_sub(_s_add(dg[sig][mu][nu], dg[sig][nu][mu]), dg[mu][nu][sig]);
                            if bracket != "0" {
                                sum_c = _s_add(sum_c, _s_mul(g_up, bracket));
                            }
                        }
                        sig = sig + 1;
                    }
                    let val_raw = _s_div(sum_c, "2");
                    let val_pretty = _sym_simplify_deep(val_raw, true).ascii;
                    array_push(row_raw, val_raw);
                    array_push(row_pretty, val_pretty);
                }
                nu = nu + 1;
            }
            array_push(mat_raw, row_raw);
            array_push(mat_pretty, row_pretty);
            mu = mu + 1;
        }
        array_push(gamma_raw, mat_raw);
        array_push(gamma_pretty, mat_pretty);
        lam = lam + 1;
    }

    // Riemann curvature tensor:
    // R^rho_{sig mu nu} = d_mu Gamma^rho_{nu sig} - d_nu Gamma^rho_{mu sig}
    //                   + sum_lam (Gamma^rho_{mu lam} Gamma^lam_{nu sig} - Gamma^rho_{nu lam} Gamma^lam_{mu sig})
    let riemann = [];
    let rho = 0;
    while rho < n {
        let r_rho = [];
        sig = 0;
        while sig < n {
            let r_sig = [];
            let mu = 0;
            while mu < n {
                let r_mu = [];
                let nu = 0;
                while nu < n {
                    if mu == nu {
                        array_push(r_mu, "0"); // Antisymmetric in (mu, nu)
                    } else if nu < mu {
                        array_push(r_mu, _s_sub("0", r_sig[nu][mu]));
                    } else {
                        let t1 = _s_diff(gamma_raw[rho][nu][sig], coords[mu]);
                        let t2 = _s_diff(gamma_raw[rho][mu][sig], coords[nu]);
                        let acc = _s_sub(t1, t2);
                        lam = 0;
                        while lam < n {
                            let p1 = _s_mul(gamma_raw[rho][mu][lam], gamma_raw[lam][nu][sig]);
                            let p2 = _s_mul(gamma_raw[rho][nu][lam], gamma_raw[lam][mu][sig]);
                            acc = _s_add(acc, _s_sub(p1, p2));
                            lam = lam + 1;
                        }
                        array_push(r_mu, _sym_simplify_deep(acc, false).ascii);
                    }
                    nu = nu + 1;
                }
                array_push(r_sig, r_mu);
                mu = mu + 1;
            }
            array_push(r_rho, r_sig);
            sig = sig + 1;
        }
        array_push(riemann, r_rho);
        rho = rho + 1;
    }

    // Ricci tensor: R_{sig nu} = sum_rho R^rho_{sig rho nu}
    let ricci = [];
    sig = 0;
    while sig < n {
        let row = [];
        let nu = 0;
        while nu < n {
            let acc = "0";
            rho = 0;
            while rho < n {
                acc = _s_add(acc, riemann[rho][sig][rho][nu]);
                rho = rho + 1;
            }
            array_push(row, _sym_simplify_deep(acc, false).ascii);
            nu = nu + 1;
        }
        array_push(ricci, row);
        sig = sig + 1;
    }

    // Ricci scalar curvature: R = sum_{sig, nu} g^{sig nu} R_{sig nu}
    let R_scalar = "0";
    sig = 0;
    while sig < n {
        let nu = 0;
        while nu < n {
            if g_inv[sig][nu] != "0" and ricci[sig][nu] != "0" {
                R_scalar = _s_add(R_scalar, _s_mul(g_inv[sig][nu], ricci[sig][nu]));
            }
            nu = nu + 1;
        }
        sig = sig + 1;
    }
    R_scalar = _sym_simplify_deep(R_scalar, false).ascii;

    // Einstein tensor: G_{mu nu} = R_{mu nu} - (1/2) * R * g_{mu nu}
    let einstein = [];
    let half_R = _s_div(R_scalar, "2");
    let mu = 0;
    while mu < n {
        let row = [];
        let nu = 0;
        while nu < n {
            let term = _s_sub(ricci[mu][nu], _s_mul(half_R, g[mu][nu]));
            array_push(row, _sym_simplify_deep(term, false).ascii);
            nu = nu + 1;
        }
        array_push(einstein, row);
        mu = mu + 1;
    }

    return map{
        dimension: n,
        coords: coords,
        metric: g,
        inverse_metric: g_inv,
        metric_det: inv_info.det,
        is_diagonal: inv_info.is_diagonal,
        christoffel: gamma_pretty,
        christoffel_raw: gamma_raw,
        riemann_tensor: riemann,
        ricci_tensor: ricci,
        ricci_scalar: R_scalar,
        einstein_tensor: einstein
    };
}

// Calculus of Variations: Symbolic Euler-Lagrange Equations
// dL/dq_i - d/dt(dL/ddq_i) = 0
fn euler_lagrange(L_expr, q_vars, dq_vars, t_var = "t", ddq_vars = nil) {
    let qs = if type(q_vars) == "array" { q_vars } else { [str(q_vars)] };
    let dqs = if type(dq_vars) == "array" { dq_vars } else { [str(dq_vars)] };
    let m = len(qs);
    if m == 0 or len(dqs) != m or m > 16 {
        throw "complex_riemann_stochastic_game: euler_lagrange expects matching q_vars and dq_vars";
    }
    let ddqs = [];
    if ddq_vars != nil {
        let raw_dd = if type(ddq_vars) == "array" { ddq_vars } else { [str(ddq_vars)] };
        let i = 0;
        while i < m { array_push(ddqs, str(raw_dd[i])); i = i + 1; }
    } else {
        let i = 0;
        while i < m {
            let dqi = str(dqs[i]);
            if str_starts_with(dqi, "d") {
                array_push(ddqs, "d" + dqi); // e.g. dx -> ddx, dtheta -> ddtheta
            } else {
                array_push(ddqs, "dd" + str(qs[i]));
            }
            i = i + 1;
        }
    }

    let CALC = _calc();
    let L_clean = CALC.simplify(L_expr).ascii;
    let equations = [];
    let residuals = [];
    let momenta = [];
    let dL_dq_list = [];
    let d_dt_p_list = [];

    let i = 0;
    while i < m {
        let dL_dqi = _s_diff(L_clean, qs[i]);
        let p_i = _s_diff(L_clean, dqs[i]);

        // Total time derivative d/dt(p_i) = dp_i/dt + sum_j (dp_i/dq_j)*dq_j + sum_j (dp_i/ddq_j)*ddq_j
        let total_dt = _s_diff(p_i, t_var);
        let j = 0;
        while j < m {
            let dp_dqj = _s_diff(p_i, qs[j]);
            if dp_dqj != "0" {
                total_dt = _s_add(total_dt, _s_mul(dp_dqj, dqs[j]));
            }
            let dp_ddqj = _s_diff(p_i, dqs[j]);
            if dp_ddqj != "0" {
                total_dt = _s_add(total_dt, _s_mul(dp_ddqj, ddqs[j]));
            }
            j = j + 1;
        }
        let lhs = _s_sub(dL_dqi, total_dt);
        array_push(dL_dq_list, dL_dqi);
        array_push(momenta, p_i);
        array_push(d_dt_p_list, total_dt);
        array_push(residuals, lhs);
        array_push(equations, lhs + " = 0");
        i = i + 1;
    }

    return map{
        q_vars: qs,
        dq_vars: dqs,
        ddq_vars: ddqs,
        momenta: momenta,
        dL_dq: dL_dq_list,
        d_dt_dL_ddq: d_dt_p_list,
        residuals: residuals,
        equations: equations,
        lhs_ascii: residuals[0],
        equation_ascii: equations[0]
    };
}

// 2D Nonlinear Equilibrium Classification via Jacobian Poincaré-Lyapunov Invariants
fn classify_equilibrium_2d(fx_expr, fy_expr, x_var, y_var, eq_pt) {
    let CALC = _calc();
    let x0 = if type(eq_pt) == "array" { eq_pt[0] * 1.0 } else { eq_pt[x_var] * 1.0 };
    let y0 = if type(eq_pt) == "array" { eq_pt[1] * 1.0 } else { eq_pt[y_var] * 1.0 };
    let env = map{};
    env[x_var] = x0;
    env[y_var] = y0;

    let r_fx = CALC.evaluate_expr(fx_expr, env);
    let r_fy = CALC.evaluate_expr(fy_expr, env);
    let is_eq = _hypot2(r_fx, r_fy) < 1e-7;

    let dfx_dx = CALC.diff(fx_expr, x_var, 1);
    let dfx_dy = CALC.diff(fx_expr, y_var, 1);
    let dfy_dx = CALC.diff(fy_expr, x_var, 1);
    let dfy_dy = CALC.diff(fy_expr, y_var, 1);

    let j00 = CALC.evaluate_expr(dfx_dx.ast, env);
    let j01 = CALC.evaluate_expr(dfx_dy.ast, env);
    let j10 = CALC.evaluate_expr(dfy_dx.ast, env);
    let j11 = CALC.evaluate_expr(dfy_dy.ast, env);

    let tr = j00 + j11;
    let det = j00 * j11 - j01 * j10;
    let disc = tr * tr - 4.0 * det;

    let eig1 = map{ re: 0.0, im: 0.0 };
    let eig2 = map{ re: 0.0, im: 0.0 };
    if disc >= 0.0 {
        let sd = num_sqrt(disc);
        eig1 = map{ re: 0.5 * (tr + sd), im: 0.0 };
        eig2 = map{ re: 0.5 * (tr - sd), im: 0.0 };
    } else {
        let sd_im = num_sqrt(0.0 - disc);
        eig1 = map{ re: 0.5 * tr, im: 0.5 * sd_im };
        eig2 = map{ re: 0.5 * tr, im: 0.0 - 0.5 * sd_im };
    }

    let cls = "degenerate_indeterminate";
    if num_abs(det) < 1e-11 {
        cls = "degenerate_indeterminate";
    } else if det < 0.0 {
        cls = "saddle";
    } else if disc >= -1e-11 {
        if num_abs(tr) < 1e-11 {
            cls = "degenerate_indeterminate";
        } else if tr < 0.0 {
            cls = "stable_node";
        } else {
            cls = "unstable_node";
        }
    } else {
        if num_abs(tr) < 1e-11 {
            cls = "center";
        } else if tr < 0.0 {
            cls = "stable_spiral";
        } else {
            cls = "unstable_spiral";
        }
    }

    return map{
        point: [x0, y0],
        is_equilibrium: is_eq,
        residual: [r_fx, r_fy],
        jacobian: [[j00, j01], [j10, j11]],
        trace: tr,
        det: det,
        discriminant: disc,
        eigenvalues: [eig1, eig2],
        classification: cls
    };
}

// 1D Discrete Map Maximal Lyapunov Exponent
fn lyapunov_exponent_1d(map_fn, dmap_fn, x0, steps = 5000, transient = 500) {
    if steps < 10 or steps > MAX_LYAPUNOV_STEPS {
        throw "complex_riemann_stochastic_game: lyapunov_exponent_1d steps out of range";
    }
    let CALC = _calc();
    let f_eval = if _is_fn(map_fn) {
        map_fn
    } else {
        let ast_f = CALC.parse_expr(map_fn);
        fn(x) {
            let e = map{ x: x * 1.0 };
            return CALC.evaluate_expr(ast_f, e);
        }
    };
    let df_eval = nil;
    if dmap_fn != nil {
        if _is_fn(dmap_fn) {
            df_eval = dmap_fn;
        } else {
            let ast_df = CALC.parse_expr(dmap_fn);
            df_eval = fn(x) {
                let e = map{ x: x * 1.0 };
                return CALC.evaluate_expr(ast_df, e);
            };
        }
    } else if type(map_fn) == "string" {
        let d_obj = CALC.diff(map_fn, "x", 1);
        df_eval = fn(x) {
            let e = map{ x: x * 1.0 };
            return CALC.evaluate_expr(d_obj.ast, e);
        };
    } else {
        df_eval = fn(x) {
            let h = 1e-7;
            return (f_eval(x + h) - f_eval(x - h)) / (2.0 * h);
        };
    }

    let x = x0 * 1.0;
    let k = 0;
    while k < transient {
        x = f_eval(x);
        k = k + 1;
    }
    let sum_ln = 0.0;
    k = 0;
    while k < steps {
        let d = num_abs(df_eval(x));
        if d < 1e-300 { d = 1e-300; }
        sum_ln = sum_ln + num_ln(d);
        x = f_eval(x);
        k = k + 1;
    }
    let lam = sum_ln / (steps * 1.0);
    return map{
        exponent: lam,
        value: lam,
        is_chaotic: lam > 1e-3,
        steps: steps
    };
}

// Continuous-Time Autonomous/Non-Autonomous ODE Maximal Lyapunov Exponent (Benettin RK4 Renormalization)
fn _rk4_step_vec(rhs, t, y, dt) {
    let d = len(y);
    let half = 0.5 * dt;
    let k1 = rhs(t, y);
    let y2 = [];
    let i = 0;
    while i < d { array_push(y2, y[i] + half * k1[i]); i = i + 1; }
    let k2 = rhs(t + half, y2);
    let y3 = [];
    i = 0;
    while i < d { array_push(y3, y[i] + half * k2[i]); i = i + 1; }
    let k3 = rhs(t + half, y3);
    let y4 = [];
    i = 0;
    while i < d { array_push(y4, y[i] + dt * k3[i]); i = i + 1; }
    let k4 = rhs(t + dt, y4);
    let out = [];
    let sixth = dt / 6.0;
    i = 0;
    while i < d {
        array_push(out, y[i] + sixth * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]));
        i = i + 1;
    }
    return out;
}

fn lyapunov_exponent_ode(f_ode, y0, dt = 0.01, steps = 5000, transient = 1500) {
    if steps < 20 or steps > MAX_LYAPUNOV_STEPS or dt <= 0.0 {
        throw "complex_riemann_stochastic_game: invalid lyapunov_exponent_ode parameters";
    }
    let d = len(y0);
    // Support both fn(y) and fn(t, y) call signatures seamlessly
    let two_arg = true;
    let _probe = try f_ode(0.0, y0) catch { two_arg = false; nil };
    let rhs = if two_arg {
        f_ode
    } else {
        fn(t, y) { return f_ode(y); }
    };

    let y = [];
    let i = 0;
    while i < d { array_push(y, y0[i] * 1.0); i = i + 1; }
    let t = 0.0;
    let s = 0;
    while s < transient {
        y = _rk4_step_vec(rhs, t, y, dt);
        t = t + dt;
        s = s + 1;
    }

    let delta0 = 1e-8;
    let y_pert = [];
    let inv_sq = 1.0 / num_sqrt(d * 1.0);
    i = 0;
    while i < d {
        array_push(y_pert, y[i] + delta0 * inv_sq);
        i = i + 1;
    }

    let sum_log = 0.0;
    s = 0;
    while s < steps {
        y = _rk4_step_vec(rhs, t, y, dt);
        y_pert = _rk4_step_vec(rhs, t, y_pert, dt);
        t = t + dt;

        let norm2 = 0.0;
        i = 0;
        while i < d {
            let diff_i = y_pert[i] - y[i];
            norm2 = norm2 + diff_i * diff_i;
            i = i + 1;
        }
        let dist = num_sqrt(norm2);
        if dist < 1e-300 { dist = 1e-300; }
        sum_log = sum_log + num_ln(dist / delta0);
        let scale = delta0 / dist;
        i = 0;
        while i < d {
            y_pert[i] = y[i] + (y_pert[i] - y[i]) * scale;
            i = i + 1;
        }
        s = s + 1;
    }
    let lam = sum_log / ((steps * 1.0) * dt);
    return map{
        exponent: lam,
        value: lam,
        is_chaotic: lam > 0.05,
        final_state: y,
        total_time: steps * dt
    };
}

// ============================================================================
// 4. Stochastic Itô Calculus, Game Theory, Info/Coding Theory & FEM/Krylov/IE
// ============================================================================

// Symbolic Itô's Lemma for Y_t = f(t, X_t), dX_t = mu(t, X_t) dt + sigma(t, X_t) dW_t:
// df = (df/dt + mu * df/dx + 1/2 * sigma^2 * d^2f/dx^2) dt + (sigma * df/dx) dW_t
fn ito_lemma(f_expr, mu_expr, sigma_expr, t_var = "t", x_var = "x") {
    let CALC = _calc();
    let f_clean = CALC.simplify(f_expr).ascii;
    let mu_clean = CALC.simplify(mu_expr).ascii;
    let sig_clean = CALC.simplify(sigma_expr).ascii;

    let df_dt = _s_diff(f_clean, t_var);
    let df_dx = _s_diff(f_clean, x_var);
    let d2f_dx2 = _s_diff(df_dx, x_var);

    let mu_term = _s_mul(mu_clean, df_dx);
    let ito_corr = _s_div(_s_mul(_s_mul(sig_clean, sig_clean), d2f_dx2), "2");
    let drift_obj = _sym_simplify_deep(_s_add(df_dt, _s_add(mu_term, ito_corr)), false);
    let diff_obj = _sym_simplify_deep(_s_mul(sig_clean, df_dx), false);

    return map{
        df_dt: df_dt,
        df_dx: df_dx,
        d2f_dx2: d2f_dx2,
        ito_correction: ito_corr,
        drift: drift_obj.ascii,
        drift_ascii: drift_obj.ascii,
        drift_unicode: drift_obj.unicode,
        drift_latex: drift_obj.latex,
        diffusion: diff_obj.ascii,
        diffusion_ascii: diff_obj.ascii,
        diffusion_unicode: diff_obj.unicode,
        diffusion_latex: diff_obj.latex,
        sde_ascii: "(" + drift_obj.ascii + ")*dt + (" + diff_obj.ascii + ")*dW",
        evaluate_drift: fn(env) { return CALC.evaluate_expr(drift_obj.ast, env); },
        evaluate_diffusion: fn(env) { return CALC.evaluate_expr(diff_obj.ast, env); }
    };
}

// Deterministic Xorshift32 + Box-Muller Gaussian PRNG
fn _make_rng(seed) {
    let st = bit_and(num_round(num_abs(seed)) * 2654435761 + 1013904223, 2147483647);
    if st == 0 { st = 2463534242; }
    return map{ state: st, has_spare: false, spare: 0.0 };
}

fn _rng_u01(rng) {
    let x = rng.state;
    x = bit_and(bit_xor(x, bit_shl(x, 13)), 2147483647);
    x = bit_and(bit_xor(x, bit_shr(x, 17)), 2147483647);
    x = bit_and(bit_xor(x, bit_shl(x, 5)), 2147483647);
    if x == 0 { x = 123456789; }
    rng.state = x;
    return (x * 1.0) / 2147483648.0;
}

fn _rng_randn(rng) {
    if rng.has_spare {
        rng.has_spare = false;
        return rng.spare;
    }
    let u1 = _rng_u01(rng);
    if u1 < 1e-15 { u1 = 1e-15; }
    let u2 = _rng_u01(rng);
    let mag = num_sqrt(-2.0 * num_ln(u1));
    let ang = TWO_PI * u2;
    rng.spare = mag * num_sin(ang);
    rng.has_spare = true;
    return mag * num_cos(ang);
}

fn _coerce_sde_fn(f) {
    if _is_fn(f) {
        // Support both fn(t, x) and fn(x)
        let two_arg = true;
        let _p = try f(0.0, 1.0) catch { two_arg = false; nil };
        if two_arg { return f; }
        return fn(t, x) { return f(x); };
    }
    let ast = _calc().parse_expr(f);
    return fn(t, x) {
        return _calc().evaluate_expr(ast, map{ t: t * 1.0, x: x * 1.0 });
    };
}

// Euler-Maruyama SDE Integrator (Strong Order 0.5, Weak Order 1.0)
fn sde_euler_maruyama(mu_fn, sigma_fn, x0, t0, t1, n_steps, n_paths = 1, seed = 42) {
    if n_steps < 1 or n_steps > MAX_SDE_STEPS or n_paths < 1 or n_paths > 10000 {
        throw "complex_riemann_stochastic_game: sde_euler_maruyama bounds exceeded";
    }
    let mu = _coerce_sde_fn(mu_fn);
    let sig = _coerce_sde_fn(sigma_fn);
    let dt = ((t1 * 1.0) - (t0 * 1.0)) / (n_steps * 1.0);
    let sqrt_dt = num_sqrt(dt);
    let rng = _make_rng(seed);

    let finals = [];
    let w_totals = [];
    let first_path = [];
    let p = 0;
    while p < n_paths {
        let x = x0 * 1.0;
        let t = t0 * 1.0;
        let w_acc = 0.0;
        if p == 0 { array_push(first_path, x); }
        let k = 0;
        while k < n_steps {
            let dw = sqrt_dt * _rng_randn(rng);
            w_acc = w_acc + dw;
            x = x + mu(t, x) * dt + sig(t, x) * dw;
            t = t + dt;
            if p == 0 { array_push(first_path, x); }
            k = k + 1;
        }
        array_push(finals, x);
        array_push(w_totals, w_acc);
        p = p + 1;
    }

    let mean = 0.0;
    let i = 0;
    while i < n_paths { mean = mean + finals[i]; i = i + 1; }
    mean = mean / (n_paths * 1.0);
    let var_acc = 0.0;
    i = 0;
    while i < n_paths {
        let d = finals[i] - mean;
        var_acc = var_acc + d * d;
        i = i + 1;
    }
    let variance = if n_paths > 1 { var_acc / ((n_paths - 1) * 1.0) } else { 0.0 };
    return map{
        scheme: "euler_maruyama",
        dt: dt,
        final_values: finals,
        brownian_totals: w_totals,
        sample_path: first_path,
        mean: mean,
        variance: variance
    };
}

// Strong Order 1.0 Milstein SDE Integrator:
// X_{k+1} = X_k + mu*dt + sigma*dW + 1/2 * sigma * (d sigma / dx) * (dW^2 - dt)
fn sde_milstein(mu_fn, sigma_fn, dsigma_dx_fn, x0, t0, t1, n_steps, n_paths = 1, seed = 42) {
    if n_steps < 1 or n_steps > MAX_SDE_STEPS or n_paths < 1 or n_paths > 10000 {
        throw "complex_riemann_stochastic_game: sde_milstein bounds exceeded";
    }
    let mu = _coerce_sde_fn(mu_fn);
    let sig = _coerce_sde_fn(sigma_fn);
    let dsig = if dsigma_dx_fn != nil {
        _coerce_sde_fn(dsigma_dx_fn)
    } else if type(sigma_fn) == "string" {
        let d_str = _calc().diff(sigma_fn, "x", 1).ascii;
        _coerce_sde_fn(d_str)
    } else {
        fn(t, x) {
            let h = 1e-6 * (1.0 + num_abs(x));
            return (sig(t, x + h) - sig(t, x - h)) / (2.0 * h);
        }
    };

    let dt = ((t1 * 1.0) - (t0 * 1.0)) / (n_steps * 1.0);
    let sqrt_dt = num_sqrt(dt);
    let rng = _make_rng(seed);

    let finals = [];
    let w_totals = [];
    let first_path = [];
    let p = 0;
    while p < n_paths {
        let x = x0 * 1.0;
        let t = t0 * 1.0;
        let w_acc = 0.0;
        if p == 0 { array_push(first_path, x); }
        let k = 0;
        while k < n_steps {
            let dw = sqrt_dt * _rng_randn(rng);
            w_acc = w_acc + dw;
            let s_val = sig(t, x);
            let ds_val = dsig(t, x);
            x = x + mu(t, x) * dt + s_val * dw + 0.5 * s_val * ds_val * (dw * dw - dt);
            t = t + dt;
            if p == 0 { array_push(first_path, x); }
            k = k + 1;
        }
        array_push(finals, x);
        array_push(w_totals, w_acc);
        p = p + 1;
    }

    let mean = 0.0;
    let i = 0;
    while i < n_paths { mean = mean + finals[i]; i = i + 1; }
    mean = mean / (n_paths * 1.0);
    let var_acc = 0.0;
    i = 0;
    while i < n_paths {
        let d = finals[i] - mean;
        var_acc = var_acc + d * d;
        i = i + 1;
    }
    let variance = if n_paths > 1 { var_acc / ((n_paths - 1) * 1.0) } else { 0.0 };
    return map{
        scheme: "milstein",
        strong_order: 1.0,
        dt: dt,
        final_values: finals,
        brownian_totals: w_totals,
        sample_path: first_path,
        mean: mean,
        variance: variance
    };
}

// Joe-Kuo Gray-Code Sobol Low-Discrepancy Quasi-Monte Carlo Integrator (Dimensions 1..8)
let _SOBOL_POLYS = [
    // { s: degree, a: interior poly bits [a_1..a_{s-1}], m: odd initial direction numbers [m_1..m_s] }
    map{ s: 0, a: [], m: [] },                                      // dim 1: pure base-2 van der Corput
    map{ s: 1, a: [], m: [1] },                                     // dim 2: x + 1
    map{ s: 2, a: [1], m: [1, 3] },                                 // dim 3: x^2 + x + 1
    map{ s: 3, a: [0, 1], m: [1, 3, 1] },                           // dim 4: x^3 + x + 1
    map{ s: 3, a: [1, 0], m: [1, 1, 5] },                           // dim 5: x^3 + x^2 + 1
    map{ s: 4, a: [0, 0, 1], m: [1, 1, 5, 3] },                     // dim 6: x^4 + x + 1
    map{ s: 4, a: [1, 0, 0], m: [1, 3, 5, 13] },                    // dim 7: x^4 + x^3 + 1
    map{ s: 5, a: [0, 0, 1, 0], m: [1, 1, 5, 5, 17] }               // dim 8: x^5 + x^2 + 1
];

fn _sobol_direction_vectors(dim) {
    let B = 30; // 30-bit unsigned scaling (2^30 = 1073741824) avoids signed 32-bit overflow
    let dirs = [];
    let d = 0;
    while d < dim {
        let v = [0]; // 1-indexed k = 1..B
        if d == 0 {
            let k = 1;
            while k <= B {
                array_push(v, bit_shl(1, B - k));
                k = k + 1;
            }
        } else {
            let info = _SOBOL_POLYS[d];
            let s = info.s;
            let m_arr = [0];
            let k = 1;
            while k <= s {
                array_push(m_arr, info.m[k - 1]);
                k = k + 1;
            }
            while k <= B {
                let nxt = bit_xor(bit_shl(m_arr[k - s], s), m_arr[k - s]);
                let j = 1;
                while j < s {
                    if info.a[j - 1] == 1 {
                        nxt = bit_xor(nxt, bit_shl(m_arr[k - j], j));
                    }
                    j = j + 1;
                }
                array_push(m_arr, nxt);
                k = k + 1;
            }
            k = 1;
            while k <= B {
                array_push(v, bit_shl(m_arr[k], B - k));
                k = k + 1;
            }
        }
        array_push(dirs, v);
        d = d + 1;
    }
    return dirs;
}

fn _ctz_one_based(n) {
    // Index (1-based) of rightmost zero bit of n - 1, equivalently trailing zeros of n + 1
    let c = 1;
    let v = n;
    while bit_and(v, 1) == 1 {
        v = bit_shr(v, 1);
        c = c + 1;
    }
    return c;
}

fn qmc_sobol_integrate(f_fn, bounds, n_points = 1024) {
    let dim = len(bounds);
    if dim < 1 or dim > 8 {
        throw "complex_riemann_stochastic_game: qmc_sobol_integrate supports dimension 1..8";
    }
    if n_points < 1 or n_points > MAX_QMC_POINTS {
        throw "complex_riemann_stochastic_game: qmc_sobol_integrate n_points out of range";
    }
    let vol = 1.0;
    let d = 0;
    while d < dim {
        let span = (bounds[d][1] * 1.0) - (bounds[d][0] * 1.0);
        if span <= 0.0 {
            throw "complex_riemann_stochastic_game: invalid integration bounds";
        }
        vol = vol * span;
        d = d + 1;
    }

    let dirs = _sobol_direction_vectors(dim);
    let x_int = [];
    d = 0;
    while d < dim { array_push(x_int, 0); d = d + 1; }
    let inv_2p30 = 1.0 / 1073741824.0;

    let sum_f = 0.0;
    let i = 0;
    while i < n_points {
        // Advance Gray-code state before sampling so point 0 starts at midpoint 0.5^d inside (0,1)^d
        let bit_idx = _ctz_one_based(i);
        let pt = [];
        d = 0;
        while d < dim {
            x_int[d] = bit_xor(x_int[d], dirs[d][bit_idx]);
            let u = (x_int[d] * 1.0) * inv_2p30;
            let lo = bounds[d][0] * 1.0;
            let hi = bounds[d][1] * 1.0;
            array_push(pt, lo + (hi - lo) * u);
            d = d + 1;
        }
        let fv = if dim == 1 {
            let one_d_ok = try f_fn(pt) catch _nan_val();
            if _is_finite(one_d_ok) { one_d_ok } else { f_fn(pt[0]) }
        } else {
            f_fn(pt)
        };
        sum_f = sum_f + fv;
        i = i + 1;
    }

    let val = vol * (sum_f / (n_points * 1.0));
    return map{
        value: val,
        volume: vol,
        dimension: dim,
        n_points: n_points
    };
}

// Game Theory: 2-Player Bimatrix Support-Enumeration Nash Equilibria & Exact Shapley Value
fn _subsets_of_size(n, k) {
    let out = [];
    let rec = nil;
    rec = fn(start, cur) {
        if len(cur) == k {
            let cp = [];
            let i = 0;
            while i < len(cur) { array_push(cp, cur[i]); i = i + 1; }
            array_push(out, cp);
            return nil;
        }
        let idx = start;
        while idx <= n - (k - len(cur)) {
            let nxt = [];
            let i = 0;
            while i < len(cur) { array_push(nxt, cur[i]); i = i + 1; }
            array_push(nxt, idx);
            rec(idx + 1, nxt);
            idx = idx + 1;
        }
        return nil;
    };
    rec(0, []);
    return out;
}

fn nash_equilibria_2p(A, B) {
    let m = len(A);
    if m < 1 or m > MAX_GAME_STRATEGIES or len(B) != m {
        throw "complex_riemann_stochastic_game: invalid payoff matrix dimensions";
    }
    let n = len(A[0]);
    if n < 1 or n > MAX_GAME_STRATEGIES or len(B[0]) != n {
        throw "complex_riemann_stochastic_game: invalid payoff matrix column dimensions";
    }

    let equilibria = [];
    let pure_eq = [];
    let mixed_eq = [];

    // 1. Pure Nash equilibria (k = 1)
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            let pay1 = A[i][j] * 1.0;
            let pay2 = B[i][j] * 1.0;
            let br1 = true;
            let r = 0;
            while r < m {
                if A[r][j] * 1.0 > pay1 + 1e-11 { br1 = false; break; }
                r = r + 1;
            }
            let br2 = true;
            if br1 {
                let c = 0;
                while c < n {
                    if B[i][c] * 1.0 > pay2 + 1e-11 { br2 = false; break; }
                    c = c + 1;
                }
            }
            if br1 and br2 {
                let p_vec = [];
                r = 0;
                while r < m { array_push(p_vec, if r == i { 1.0 } else { 0.0 }); r = r + 1; }
                let q_vec = [];
                let c = 0;
                while c < n { array_push(q_vec, if c == j { 1.0 } else { 0.0 }); c = c + 1; }
                let eq = map{
                    kind: "pure",
                    strategy_indices: [i, j],
                    p: p_vec,
                    q: q_vec,
                    payoff_p1: pay1,
                    payoff_p2: pay2,
                    support_p1: [i],
                    support_p2: [j]
                };
                array_push(pure_eq, eq);
                array_push(equilibria, eq);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // 2. Support enumeration for mixed equilibria of support size k = 2 .. min(m, n)
    let k_max = if m < n { m } else { n };
    let k = 2;
    while k <= k_max {
        let subs1 = _subsets_of_size(m, k);
        let subs2 = _subsets_of_size(n, k);
        let s1_idx = 0;
        while s1_idx < len(subs1) {
            let S1 = subs1[s1_idx];
            let s2_idx = 0;
            while s2_idx < len(subs2) {
                let S2 = subs2[s2_idx];

                // Solve for q on S2 & u1: sum_{c in S2} A[r][c]*q_c - u1 = 0 (r in S1), sum q_c = 1
                let Mq = [];
                let bq = [];
                let r_pos = 0;
                while r_pos < k {
                    let row = [];
                    let c_pos = 0;
                    while c_pos < k {
                        array_push(row, A[S1[r_pos]][S2[c_pos]] * 1.0);
                        c_pos = c_pos + 1;
                    }
                    array_push(row, -1.0);
                    array_push(Mq, row);
                    array_push(bq, 0.0);
                    r_pos = r_pos + 1;
                }
                let sum_row_q = [];
                let c_pos2 = 0;
                while c_pos2 < k { array_push(sum_row_q, 1.0); c_pos2 = c_pos2 + 1; }
                array_push(sum_row_q, 0.0);
                array_push(Mq, sum_row_q);
                array_push(bq, 1.0);

                let sol_q = _solve_dense_linear(Mq, bq, 1e-11);
                if sol_q.ok {
                    // Check strict positivity of q on S2
                    let q_pos_ok = true;
                    let idx_c = 0;
                    while idx_c < k {
                        if sol_q.x[idx_c] <= 1e-9 { q_pos_ok = false; break; }
                        idx_c = idx_c + 1;
                    }
                    if q_pos_ok {
                        // Solve for p on S1 & u2: sum_{r in S1} B[r][c]*p_r - u2 = 0 (c in S2), sum p_r = 1
                        let Mp = [];
                        let bp = [];
                        let cp_i = 0;
                        while cp_i < k {
                            let row_p = [];
                            let rp_i = 0;
                            while rp_i < k {
                                array_push(row_p, B[S1[rp_i]][S2[cp_i]] * 1.0);
                                rp_i = rp_i + 1;
                            }
                            array_push(row_p, -1.0);
                            array_push(Mp, row_p);
                            array_push(bp, 0.0);
                            cp_i = cp_i + 1;
                        }
                        let sum_row_p = [];
                        let rp_i2 = 0;
                        while rp_i2 < k { array_push(sum_row_p, 1.0); rp_i2 = rp_i2 + 1; }
                        array_push(sum_row_p, 0.0);
                        array_push(Mp, sum_row_p);
                        array_push(bp, 1.0);

                        let sol_p = _solve_dense_linear(Mp, bp, 1e-11);
                        if sol_p.ok {
                            let p_pos_ok = true;
                            let idx_r = 0;
                            while idx_r < k {
                                if sol_p.x[idx_r] <= 1e-9 { p_pos_ok = false; break; }
                                idx_r = idx_r + 1;
                            }
                            if p_pos_ok {
                                let u1 = sol_q.x[k];
                                let u2 = sol_p.x[k];
                                let p_full = [];
                                let ri = 0;
                                while ri < m { array_push(p_full, 0.0); ri = ri + 1; }
                                idx_r = 0;
                                while idx_r < k {
                                    p_full[S1[idx_r]] = _snap_scalar(sol_p.x[idx_r], 1e-11);
                                    idx_r = idx_r + 1;
                                }
                                let q_full = [];
                                let ci = 0;
                                while ci < n { array_push(q_full, 0.0); ci = ci + 1; }
                                idx_c = 0;
                                while idx_c < k {
                                    q_full[S2[idx_c]] = _snap_scalar(sol_q.x[idx_c], 1e-11);
                                    idx_c = idx_c + 1;
                                }

                                // Verify best-response inequalities across ALL rows and columns
                                let br_all = true;
                                ri = 0;
                                while ri < m {
                                    let exp_r = 0.0;
                                    ci = 0;
                                    while ci < n {
                                        exp_r = exp_r + (A[ri][ci] * 1.0) * q_full[ci];
                                        ci = ci + 1;
                                    }
                                    if exp_r > u1 + 1e-9 { br_all = false; break; }
                                    ri = ri + 1;
                                }
                                if br_all {
                                    ci = 0;
                                    while ci < n {
                                        let exp_c = 0.0;
                                        ri = 0;
                                        while ri < m {
                                            exp_c = exp_c + (B[ri][ci] * 1.0) * p_full[ri];
                                            ri = ri + 1;
                                        }
                                        if exp_c > u2 + 1e-9 { br_all = false; break; }
                                        ci = ci + 1;
                                    }
                                }
                                if br_all {
                                    let eq_m = map{
                                        kind: "mixed",
                                        p: p_full,
                                        q: q_full,
                                        payoff_p1: _snap_scalar(u1, 1e-11),
                                        payoff_p2: _snap_scalar(u2, 1e-11),
                                        support_p1: S1,
                                        support_p2: S2
                                    };
                                    array_push(mixed_eq, eq_m);
                                    array_push(equilibria, eq_m);
                                }
                            }
                        }
                    }
                }
                s2_idx = s2_idx + 1;
            }
            s1_idx = s1_idx + 1;
        }
        k = k + 1;
    }

    return map{
        equilibria: equilibria,
        pure_equilibria: pure_eq,
        mixed_equilibria: mixed_eq,
        count: len(equilibria)
    };
}

// Exact Shapley Value for n-player cooperative game v(S)
fn shapley_value(n_players, characteristic_fn) {
    let n = num_round(n_players);
    if n < 1 or n > MAX_SHAPLEY_PLAYERS {
        throw "complex_riemann_stochastic_game: shapley_value n_players must be in [1, 16]";
    }
    let fact = [1.0];
    let i = 1;
    while i <= n {
        array_push(fact, fact[i - 1] * (i * 1.0));
        i = i + 1;
    }

    let total_masks = bit_shl(1, n);
    let v_vals = [];
    let pop_cnt = [];
    let mask = 0;
    while mask < total_masks {
        let coalition = [];
        let p = 0;
        while p < n {
            if bit_and(mask, bit_shl(1, p)) != 0 {
                array_push(coalition, p);
            }
            p = p + 1;
        }
        let val = if type(characteristic_fn) == "array" {
            characteristic_fn[mask] * 1.0
        } else {
            characteristic_fn(coalition) * 1.0
        };
        array_push(v_vals, val);
        array_push(pop_cnt, len(coalition));
        mask = mask + 1;
    }

    let phi = [];
    let fact_n = fact[n];
    i = 0;
    while i < n {
        let bit_i = bit_shl(1, i);
        let acc = 0.0;
        mask = 0;
        while mask < total_masks {
            if bit_and(mask, bit_i) == 0 {
                let s_sz = pop_cnt[mask];
                let w = (fact[s_sz] * fact[n - s_sz - 1]) / fact_n;
                let marg = v_vals[bit_or(mask, bit_i)] - v_vals[mask];
                acc = acc + w * marg;
            }
            mask = mask + 1;
        }
        array_push(phi, _snap_scalar(acc, 1e-12));
        i = i + 1;
    }

    let sum_phi = 0.0;
    i = 0;
    while i < n { sum_phi = sum_phi + phi[i]; i = i + 1; }
    return map{
        values: phi,
        grand_coalition_value: v_vals[total_masks - 1],
        empty_coalition_value: v_vals[0],
        sum_values: sum_phi,
        efficiency_verified: num_abs(sum_phi - (v_vals[total_masks - 1] - v_vals[0])) < 1e-10
    };
}

// Information Theory: Shannon Entropy, Guarded KL Divergence, Mutual Information & Huffman Coding
fn shannon_entropy(probs, base = 2.0) {
    if len(probs) == 0 or base <= 0.0 or base == 1.0 {
        throw "complex_riemann_stochastic_game: invalid shannon_entropy arguments";
    }
    let sum_p = 0.0;
    let h = 0.0;
    let inv_ln_b = 1.0 / num_ln(base * 1.0);
    let i = 0;
    while i < len(probs) {
        let p = probs[i] * 1.0;
        if p < -1e-12 {
            throw "complex_riemann_stochastic_game: negative probability in shannon_entropy";
        }
        if p > 0.0 {
            sum_p = sum_p + p;
            h = h - p * (num_ln(p) * inv_ln_b);
        }
        i = i + 1;
    }
    if num_abs(sum_p - 1.0) > 1e-6 {
        throw "complex_riemann_stochastic_game: probabilities must sum to 1";
    }
    return h;
}

fn kl_divergence(p, q, base = 2.0) {
    if len(p) == 0 or len(p) != len(q) or base <= 0.0 or base == 1.0 {
        throw "complex_riemann_stochastic_game: invalid kl_divergence distributions";
    }
    let inv_ln_b = 1.0 / num_ln(base * 1.0);
    let kl = 0.0;
    let i = 0;
    while i < len(p) {
        let pi = p[i] * 1.0;
        let qi = q[i] * 1.0;
        if pi < -1e-12 or qi < -1e-12 {
            throw "complex_riemann_stochastic_game: negative probability in kl_divergence";
        }
        if pi > 0.0 {
            if qi <= 0.0 {
                // Absolute continuity violated (p_i > 0 while q_i = 0) -> +Infinity
                return _pos_inf();
            }
            kl = kl + pi * (num_ln(pi / qi) * inv_ln_b);
        }
        i = i + 1;
    }
    if kl < 0.0 and kl > -1e-14 { return 0.0; }
    return kl;
}

fn mutual_information(joint_matrix, base = 2.0) {
    let rows = len(joint_matrix);
    if rows == 0 { throw "complex_riemann_stochastic_game: empty joint_matrix"; }
    let cols = len(joint_matrix[0]);
    let px = [];
    let py = [];
    let r = 0;
    while r < rows { array_push(px, 0.0); r = r + 1; }
    let c = 0;
    while c < cols { array_push(py, 0.0); c = c + 1; }

    let total = 0.0;
    r = 0;
    while r < rows {
        c = 0;
        while c < cols {
            let pij = joint_matrix[r][c] * 1.0;
            if pij < -1e-12 {
                throw "complex_riemann_stochastic_game: negative joint probability";
            }
            if pij > 0.0 {
                px[r] = px[r] + pij;
                py[c] = py[c] + pij;
                total = total + pij;
            }
            c = c + 1;
        }
        r = r + 1;
    }
    if num_abs(total - 1.0) > 1e-6 {
        throw "complex_riemann_stochastic_game: joint probabilities must sum to 1";
    }

    let inv_ln_b = 1.0 / num_ln(base * 1.0);
    let mi = 0.0;
    r = 0;
    while r < rows {
        c = 0;
        while c < cols {
            let pij = joint_matrix[r][c] * 1.0;
            if pij > 0.0 {
                mi = mi + pij * (num_ln(pij / (px[r] * py[c])) * inv_ln_b);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    if mi < 0.0 and mi > -1e-14 { return 0.0; }
    return mi;
}

// Optimal Prefix-Free Huffman Tree Construction
fn huffman_code(symbol_weights) {
    let items = [];
    if type(symbol_weights) == "map" {
        let ks = map_keys(symbol_weights);
        let i = 0;
        while i < len(ks) {
            let sym = ks[i];
            let w = symbol_weights[sym] * 1.0;
            if w > 0.0 {
                array_push(items, map{ leaf: true, sym: str(sym), key: str(sym), weight: w, left: nil, right: nil });
            }
            i = i + 1;
        }
    } else if type(symbol_weights) == "array" {
        let i = 0;
        while i < len(symbol_weights) {
            let el = symbol_weights[i];
            let sym = if type(el) == "array" { str(el[0]) } else { str(el.symbol) };
            let w = if type(el) == "array" { el[1] * 1.0 } else { el.weight * 1.0 };
            if w > 0.0 {
                array_push(items, map{ leaf: true, sym: sym, key: sym, weight: w, left: nil, right: nil });
            }
            i = i + 1;
        }
    } else {
        throw "complex_riemann_stochastic_game: huffman_code expects map or array";
    }

    if len(items) == 0 {
        throw "complex_riemann_stochastic_game: huffman_code requires at least one positive weight";
    }

    let total_w = 0.0;
    let orig_weights = map{};
    let i = 0;
    while i < len(items) {
        total_w = total_w + items[i].weight;
        orig_weights[items[i].sym] = items[i].weight;
        i = i + 1;
    }

    let pool = items;
    while len(pool) > 1 {
        // Deterministic sort by (weight ascending, lexicographic key ascending)
        let a = 1;
        while a < len(pool) {
            let kv = pool[a];
            let b = a - 1;
            while b >= 0 and (pool[b].weight > kv.weight or (pool[b].weight == kv.weight and pool[b].key > kv.key)) {
                pool[b + 1] = pool[b];
                b = b - 1;
            }
            pool[b + 1] = kv;
            a = a + 1;
        }
        let n0 = pool[0];
        let n1 = pool[1];
        let merged = map{
            leaf: false,
            sym: "",
            key: n0.key + "|" + n1.key,
            weight: n0.weight + n1.weight,
            left: n0,
            right: n1
        };
        let next_pool = [merged];
        let idx = 2;
        while idx < len(pool) {
            array_push(next_pool, pool[idx]);
            idx = idx + 1;
        }
        pool = next_pool;
    }

    let root = pool[0];
    let codes = map{};
    if root.leaf {
        codes[root.sym] = "0";
    } else {
        let walk = nil;
        walk = fn(nd, prefix) {
            if nd.leaf {
                codes[nd.sym] = prefix;
                return nil;
            }
            walk(nd.left, prefix + "0");
            walk(nd.right, prefix + "1");
            return nil;
        };
        walk(root, "");
    }

    let avg_len = 0.0;
    let ent = 0.0;
    let cks = map_keys(codes);
    i = 0;
    while i < len(cks) {
        let s = cks[i];
        let p = orig_weights[s] / total_w;
        avg_len = avg_len + p * (len(codes[s]) * 1.0);
        ent = ent - p * (num_ln(p) / LN2);
        i = i + 1;
    }

    return map{
        codes: codes,
        average_length: avg_len,
        entropy_bits: ent,
        efficiency: if avg_len > 0.0 { ent / avg_len } else { 1.0 },
        encode: fn(symbols) {
            let bits = "";
            let idx = 0;
            while idx < len(symbols) {
                let ch = if type(symbols) == "string" { str_slice(symbols, idx, idx + 1) } else { str(symbols[idx]) };
                bits = bits + codes[ch];
                idx = idx + 1;
            }
            return bits;
        },
        decode: fn(bitstr) {
            if root.leaf {
                let out_single = [];
                let k = 0;
                while k < len(bitstr) { array_push(out_single, root.sym); k = k + 1; }
                return out_single;
            }
            let decoded = [];
            let cur = root;
            let k = 0;
            while k < len(bitstr) {
                let bch = str_slice(bitstr, k, k + 1);
                cur = if bch == "0" { cur.left } else { cur.right };
                if cur.leaf {
                    array_push(decoded, cur.sym);
                    cur = root;
                }
                k = k + 1;
            }
            return decoded;
        }
    };
}

// Hamming(7, 4) Single-Error-Correcting Linear Block Code
// Bit layout (1-indexed positions 1..7): [p1, p2, d1, p4, d2, d3, d4]
fn hamming74_encode(bits4) {
    if len(bits4) != 4 {
        throw "complex_riemann_stochastic_game: hamming74_encode expects 4 bits";
    }
    let d1 = bit_and(num_round(bits4[0]), 1);
    let d2 = bit_and(num_round(bits4[1]), 1);
    let d3 = bit_and(num_round(bits4[2]), 1);
    let d4 = bit_and(num_round(bits4[3]), 1);

    let p1 = bit_xor(d1, bit_xor(d2, d4));
    let p2 = bit_xor(d1, bit_xor(d3, d4));
    let p4 = bit_xor(d2, bit_xor(d3, d4));
    return [p1, p2, d1, p4, d2, d3, d4];
}

fn hamming74_decode(bits7) {
    if len(bits7) != 7 {
        throw "complex_riemann_stochastic_game: hamming74_decode expects 7 bits";
    }
    let c = [];
    let i = 0;
    while i < 7 {
        array_push(c, bit_and(num_round(bits7[i]), 1));
        i = i + 1;
    }
    let s1 = bit_xor(bit_xor(c[0], c[2]), bit_xor(c[4], c[6]));
    let s2 = bit_xor(bit_xor(c[1], c[2]), bit_xor(c[5], c[6]));
    let s4 = bit_xor(bit_xor(c[3], c[4]), bit_xor(c[5], c[6]));
    let syndrome = s1 + 2 * s2 + 4 * s4;

    if syndrome > 0 {
        c[syndrome - 1] = bit_xor(c[syndrome - 1], 1);
    }
    return map{
        data: [c[2], c[4], c[5], c[6]],
        codeword: c,
        syndrome: syndrome,
        corrected_index: syndrome - 1,
        had_error: syndrome > 0
    };
}

// GF(2^8) Reed-Solomon Error-Correcting Code (Primitive polynomial 0x11D = x^8 + x^4 + x^3 + x^2 + 1)
let _GF256 = map{ ready: false, exp: [], log: [] };

fn _gf256_init() {
    if _GF256.ready { return nil; }
    let exp_t = [];
    let log_t = [];
    let i = 0;
    while i < 512 { array_push(exp_t, 0); i = i + 1; }
    i = 0;
    while i < 256 { array_push(log_t, 0); i = i + 1; }

    let x = 1;
    i = 0;
    while i < 255 {
        exp_t[i] = x;
        log_t[x] = i;
        x = bit_shl(x, 1);
        if x >= 256 {
            x = bit_xor(x, 0x11D);
        }
        i = i + 1;
    }
    i = 255;
    while i < 512 {
        exp_t[i] = exp_t[i - 255];
        i = i + 1;
    }
    _GF256.exp = exp_t;
    _GF256.log = log_t;
    _GF256.ready = true;
    return nil;
}

fn _gf_mul(a, b) {
    if a == 0 or b == 0 { return 0; }
    return _GF256.exp[_GF256.log[a] + _GF256.log[b]];
}

fn _gf_div(a, b) {
    if b == 0 { throw "complex_riemann_stochastic_game: GF(256) division by zero"; }
    if a == 0 { return 0; }
    return _GF256.exp[_GF256.log[a] + 255 - _GF256.log[b]];
}

fn _gf_inv(a) {
    if a == 0 { throw "complex_riemann_stochastic_game: GF(256) inverse of zero"; }
    return _GF256.exp[255 - _GF256.log[a]];
}

fn _gf_pow2(k) {
    let m = num_mod(k, 255);
    if m < 0 { m = m + 255; }
    return _GF256.exp[num_round(m)];
}

// Descending-degree GF(256) polynomial multiplication & evaluation
fn _gf_poly_mul_desc(p, q) {
    let out = [];
    let i = 0;
    while i < len(p) + len(q) - 1 { array_push(out, 0); i = i + 1; }
    i = 0;
    while i < len(p) {
        let j = 0;
        while j < len(q) {
            out[i + j] = bit_xor(out[i + j], _gf_mul(p[i], q[j]));
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _gf_poly_eval_desc(p, x) {
    let y = p[0];
    let i = 1;
    while i < len(p) {
        y = bit_xor(_gf_mul(y, x), p[i]);
        i = i + 1;
    }
    return y;
}

// Ascending-degree GF(256) polynomial evaluation: p[0] + p[1]*z + p[2]*z^2 + ...
fn _gf_poly_eval_asc(p, z) {
    let acc = 0;
    let zp = 1;
    let i = 0;
    while i < len(p) {
        acc = bit_xor(acc, _gf_mul(p[i], zp));
        zp = _gf_mul(zp, z);
        i = i + 1;
    }
    return acc;
}

fn _rs_generator_poly(nsym) {
    _gf256_init();
    let g = [1];
    let i = 0;
    while i < nsym {
        g = _gf_poly_mul_desc(g, [1, _gf_pow2(i)]);
        i = i + 1;
    }
    return g;
}

fn gf256_reed_solomon_encode(msg_bytes, nsym) {
    _gf256_init();
    let ns = num_round(nsym);
    if ns < 1 or ns >= 255 or len(msg_bytes) + ns > 255 {
        throw "complex_riemann_stochastic_game: Reed-Solomon codeword length must be <= 255";
    }
    let gen = _rs_generator_poly(ns);
    let buf = [];
    let i = 0;
    while i < len(msg_bytes) {
        array_push(buf, bit_and(num_round(msg_bytes[i]), 255));
        i = i + 1;
    }
    i = 0;
    while i < ns {
        array_push(buf, 0);
        i = i + 1;
    }

    // Synthetic polynomial division over GF(256)
    i = 0;
    while i < len(msg_bytes) {
        let coef = buf[i];
        if coef != 0 {
            let j = 1;
            while j < len(gen) {
                buf[i + j] = bit_xor(buf[i + j], _gf_mul(gen[j], coef));
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // Systematic codeword = original message bytes || remainder
    let out = [];
    i = 0;
    while i < len(msg_bytes) {
        array_push(out, bit_and(num_round(msg_bytes[i]), 255));
        i = i + 1;
    }
    i = len(msg_bytes);
    while i < len(buf) {
        array_push(out, buf[i]);
        i = i + 1;
    }
    return out;
}

// Reed-Solomon decoder via Berlekamp-Massey + Chien Search + Forney Error Evaluator
fn gf256_reed_solomon_decode(codeword, nsym) {
    _gf256_init();
    let ns = num_round(nsym);
    let n = len(codeword);
    if ns < 1 or n <= ns or n > 255 {
        throw "complex_riemann_stochastic_game: invalid Reed-Solomon codeword/nsym lengths";
    }
    let cw = [];
    let i = 0;
    while i < n {
        array_push(cw, bit_and(num_round(codeword[i]), 255));
        i = i + 1;
    }

    // 1. Syndromes S_i = r(2^i) for i = 0 .. ns - 1
    let synd = [];
    let has_err = false;
    i = 0;
    while i < ns {
        let si = _gf_poly_eval_desc(cw, _gf_pow2(i));
        if si != 0 { has_err = true; }
        array_push(synd, si);
        i = i + 1;
    }
    if not has_err {
        let msg0 = [];
        i = 0;
        while i < n - ns { array_push(msg0, cw[i]); i = i + 1; }
        return map{
            ok: true,
            message: msg0,
            codeword: cw,
            errors_corrected: 0,
            error_positions: []
        };
    }

    // 2. Berlekamp-Massey algorithm for error locator Lambda(z) = 1 + C[1]*z + ... + C[L]*z^L
    let C = [1];
    let B = [1];
    let L = 0;
    let step_shift = 1;
    let b_disc = 1;

    let m = 0;
    while m < ns {
        let d = synd[m];
        let j = 1;
        while j <= L {
            if j < len(C) {
                d = bit_xor(d, _gf_mul(C[j], synd[m - j]));
            }
            j = j + 1;
        }
        if d == 0 {
            step_shift = step_shift + 1;
        } else {
            let T = [];
            let ci = 0;
            while ci < len(C) { array_push(T, C[ci]); ci = ci + 1; }
            let need_len = len(B) + step_shift;
            while len(C) < need_len { array_push(C, 0); }
            let coef = _gf_div(d, b_disc);
            let bi = 0;
            while bi < len(B) {
                C[bi + step_shift] = bit_xor(C[bi + step_shift], _gf_mul(coef, B[bi]));
                bi = bi + 1;
            }
            if 2 * L <= m {
                L = m + 1 - L;
                B = T;
                b_disc = d;
                step_shift = 1;
            } else {
                step_shift = step_shift + 1;
            }
        }
        m = m + 1;
    }

    if 2 * L > ns {
        return map{ ok: false, status: "too_many_errors", errors_detected: L };
    }

    // 3. Chien search over all codeword positions pos = 0 .. n - 1
    // Position pos corresponds to X = 2^{n - 1 - pos}, root z = X^{-1} of Lambda(z) = 0
    let err_pos = [];
    let pos = 0;
    while pos < n {
        let X = _gf_pow2(n - 1 - pos);
        let z = _gf_inv(X);
        if _gf_poly_eval_asc(C, z) == 0 {
            array_push(err_pos, pos);
        }
        pos = pos + 1;
    }
    if len(err_pos) != L {
        return map{ ok: false, status: "chien_search_mismatch", errors_detected: L };
    }

    // 4. Forney error evaluator Omega(z) = S(z) * Lambda(z) mod z^{ns} (ascending z)
    let omega = [];
    i = 0;
    while i < ns {
        let acc = 0;
        let j = 0;
        while j < len(C) and j <= i {
            acc = bit_xor(acc, _gf_mul(C[j], synd[i - j]));
            j = j + 1;
        }
        array_push(omega, acc);
        i = i + 1;
    }

    // Formal derivative in GF(2^8): Lambda'(z) = sum_{j odd} C[j] * z^{j - 1}
    let lambda_prime = [];
    let j_odd = 1;
    while j_odd < len(C) {
        array_push(lambda_prime, C[j_odd]);
        if j_odd + 1 < len(C) {
            array_push(lambda_prime, 0);
        }
        j_odd = j_odd + 2;
    }

    // Error magnitude Y_k = X_k * Omega(X_k^{-1}) / Lambda'(X_k^{-1})
    let k = 0;
    while k < len(err_pos) {
        let p_idx = err_pos[k];
        let Xk = _gf_pow2(n - 1 - p_idx);
        let Xk_inv = _gf_inv(Xk);
        let om_val = _gf_poly_eval_asc(omega, Xk_inv);
        let lp_val = _gf_poly_eval_asc(lambda_prime, Xk_inv);
        if lp_val == 0 {
            return map{ ok: false, status: "forney_zero_derivative" };
        }
        let Yk = _gf_mul(Xk, _gf_div(om_val, lp_val));
        cw[p_idx] = bit_xor(cw[p_idx], Yk);
        k = k + 1;
    }

    // 5. Re-verify all syndromes vanish on corrected codeword
    i = 0;
    while i < ns {
        if _gf_poly_eval_desc(cw, _gf_pow2(i)) != 0 {
            return map{ ok: false, status: "post_decode_syndrome_nonzero" };
        }
        i = i + 1;
    }

    let msg = [];
    i = 0;
    while i < n - ns { array_push(msg, cw[i]); i = i + 1; }
    return map{
        ok: true,
        message: msg,
        codeword: cw,
        errors_corrected: len(err_pos),
        error_positions: err_pos
    };
}

// ============================================================================
// Sparse CSR Matrices, Krylov Solvers (CG & BiCGSTAB), 1D FEM & Integral Eqs
// ============================================================================

fn csr_new(rows, cols, values, col_indices, row_ptr) {
    if rows < 1 or cols < 1 or len(row_ptr) != rows + 1 or len(values) != len(col_indices) {
        throw "complex_riemann_stochastic_game: invalid CSR structure";
    }
    return map{
        rows: rows,
        cols: cols,
        nnz: len(values),
        values: values,
        col_indices: col_indices,
        row_ptr: row_ptr
    };
}

fn csr_from_dense(A, drop_tol = 1e-15) {
    let rows = len(A);
    let cols = len(A[0]);
    let vals = [];
    let cidx = [];
    let rptr = [0];
    let r = 0;
    while r < rows {
        let c = 0;
        while c < cols {
            let v = A[r][c] * 1.0;
            if num_abs(v) > drop_tol {
                array_push(vals, v);
                array_push(cidx, c);
            }
            c = c + 1;
        }
        array_push(rptr, len(vals));
        r = r + 1;
    }
    return csr_new(rows, cols, vals, cidx, rptr);
}

fn csr_to_dense(csr) {
    let out = [];
    let r = 0;
    while r < csr.rows {
        let row = [];
        let c = 0;
        while c < csr.cols { array_push(row, 0.0); c = c + 1; }
        let idx = csr.row_ptr[r];
        let stop = csr.row_ptr[r + 1];
        while idx < stop {
            row[csr.col_indices[idx]] = row[csr.col_indices[idx]] + csr.values[idx];
            idx = idx + 1;
        }
        array_push(out, row);
        r = r + 1;
    }
    return out;
}

fn csr_matvec(csr, x) {
    if len(x) != csr.cols {
        throw "complex_riemann_stochastic_game: csr_matvec dimension mismatch";
    }
    let y = [];
    let r = 0;
    while r < csr.rows {
        let s = 0.0;
        let idx = csr.row_ptr[r];
        let stop = csr.row_ptr[r + 1];
        while idx < stop {
            s = s + csr.values[idx] * (x[csr.col_indices[idx]] * 1.0);
            idx = idx + 1;
        }
        array_push(y, s);
        r = r + 1;
    }
    return y;
}

fn _v_dot(a, b) {
    let s = 0.0;
    let i = 0;
    while i < len(a) { s = s + a[i] * b[i]; i = i + 1; }
    return s;
}

fn _v_norm(a) { return num_sqrt(_v_dot(a, a)); }

// Sparse Conjugate Gradient (SPD systems)
fn sparse_cg(csr_A, b, tol = 1e-10, max_iter = 2000) {
    let n = csr_A.rows;
    if csr_A.cols != n or len(b) != n or max_iter > MAX_KRYLOV_ITER {
        throw "complex_riemann_stochastic_game: sparse_cg invalid dimensions";
    }
    let x = [];
    let r = [];
    let p = [];
    let i = 0;
    while i < n {
        array_push(x, 0.0);
        let bi = b[i] * 1.0;
        array_push(r, bi);
        array_push(p, bi);
        i = i + 1;
    }
    let rs_old = _v_dot(r, r);
    let b_norm = num_sqrt(rs_old);
    if b_norm == 0.0 {
        return map{ x: x, iterations: 0, residual_norm: 0.0, converged: true };
    }
    let thresh = tol * (1.0 + b_norm);
    if b_norm <= thresh {
        return map{ x: x, iterations: 0, residual_norm: b_norm, converged: true };
    }

    let iter = 0;
    let res_norm = b_norm;
    while iter < max_iter {
        let Ap = csr_matvec(csr_A, p);
        let pAp = _v_dot(p, Ap);
        if num_abs(pAp) < 1e-30 { break; }
        let alpha = rs_old / pAp;
        i = 0;
        while i < n {
            x[i] = x[i] + alpha * p[i];
            r[i] = r[i] - alpha * Ap[i];
            i = i + 1;
        }
        let rs_new = _v_dot(r, r);
        res_norm = num_sqrt(rs_new);
        iter = iter + 1;
        if res_norm <= thresh {
            return map{ x: x, iterations: iter, residual_norm: res_norm, converged: true };
        }
        let beta = rs_new / rs_old;
        i = 0;
        while i < n {
            p[i] = r[i] + beta * p[i];
            i = i + 1;
        }
        rs_old = rs_new;
    }
    return map{ x: x, iterations: iter, residual_norm: res_norm, converged: res_norm <= thresh };
}

// Van der Vorst's Sparse BiCGSTAB for general non-symmetric linear systems
fn sparse_bicgstab(csr_A, b, tol = 1e-10, max_iter = 2000) {
    let n = csr_A.rows;
    if csr_A.cols != n or len(b) != n or max_iter > MAX_KRYLOV_ITER {
        throw "complex_riemann_stochastic_game: sparse_bicgstab invalid dimensions";
    }
    let x = [];
    let r = [];
    let r_hat = [];
    let p = [];
    let v = [];
    let i = 0;
    while i < n {
        array_push(x, 0.0);
        let bi = b[i] * 1.0;
        array_push(r, bi);
        array_push(r_hat, bi);
        array_push(p, 0.0);
        array_push(v, 0.0);
        i = i + 1;
    }
    let b_norm = _v_norm(r);
    if b_norm == 0.0 {
        return map{ x: x, iterations: 0, residual_norm: 0.0, converged: true };
    }
    let thresh = tol * (1.0 + b_norm);
    if b_norm <= thresh {
        return map{ x: x, iterations: 0, residual_norm: b_norm, converged: true };
    }

    let rho_old = 1.0;
    let alpha = 1.0;
    let omega = 1.0;
    let iter = 0;
    let res_norm = b_norm;

    while iter < max_iter {
        let rho_new = _v_dot(r_hat, r);
        if num_abs(rho_new) < 1e-30 { break; }
        let beta = (rho_new / rho_old) * (alpha / omega);
        i = 0;
        while i < n {
            p[i] = r[i] + beta * (p[i] - omega * v[i]);
            i = i + 1;
        }
        v = csr_matvec(csr_A, p);
        let rhat_v = _v_dot(r_hat, v);
        if num_abs(rhat_v) < 1e-30 { break; }
        alpha = rho_new / rhat_v;

        let s = [];
        i = 0;
        while i < n {
            array_push(s, r[i] - alpha * v[i]);
            i = i + 1;
        }
        let s_norm = _v_norm(s);
        iter = iter + 1;
        if s_norm <= thresh {
            i = 0;
            while i < n { x[i] = x[i] + alpha * p[i]; i = i + 1; }
            return map{ x: x, iterations: iter, residual_norm: s_norm, converged: true };
        }

        let t = csr_matvec(csr_A, s);
        let tt = _v_dot(t, t);
        if tt < 1e-30 { break; }
        omega = _v_dot(t, s) / tt;

        i = 0;
        while i < n {
            x[i] = x[i] + alpha * p[i] + omega * s[i];
            r[i] = s[i] - omega * t[i];
            i = i + 1;
        }
        res_norm = _v_norm(r);
        if res_norm <= thresh or num_abs(omega) < 1e-30 {
            return map{ x: x, iterations: iter, residual_norm: res_norm, converged: res_norm <= thresh };
        }
        rho_old = rho_new;
    }
    return map{ x: x, iterations: iter, residual_norm: res_norm, converged: res_norm <= thresh };
}

// 1D Piecewise-Linear Hat-Basis Galerkin Finite Element Method (FEM)
// Solves -(p(x) u'(x))' + q(x) u(x) = f(x) on [a, b] with Dirichlet BCs u(a) = u_a, u(b) = u_b
fn _coerce_1d_fn(f) {
    if _is_fn(f) { return f; }
    if type(f) == "number" {
        let cv = f * 1.0;
        return fn(x) { return cv; };
    }
    let ast = _calc().parse_expr(f);
    return fn(x) { return _calc().evaluate_expr(ast, map{ x: x * 1.0 }); };
}

fn fem_1d_bvp(p_fn, q_fn, f_fn, a, b, u_a, u_b, n_elements = 64) {
    let N = num_round(n_elements);
    if N < 2 or N > MAX_FEM_ELEMENTS or b <= a {
        throw "complex_riemann_stochastic_game: invalid fem_1d_bvp parameters";
    }
    let pf = _coerce_1d_fn(p_fn);
    let qf = _coerce_1d_fn(q_fn);
    let ff = _coerce_1d_fn(f_fn);

    let h = ((b * 1.0) - (a * 1.0)) / (N * 1.0);
    let xs = [];
    let i = 0;
    while i <= N {
        array_push(xs, (a * 1.0) + i * h);
        i = i + 1;
    }

    // Global (N+1)x(N+1) tridiagonal assembly before lifting Dirichlet BCs
    let diag = [];
    let sub = [];
    let sup = [];
    let rhs = [];
    i = 0;
    while i <= N {
        array_push(diag, 0.0);
        array_push(rhs, 0.0);
        if i < N {
            array_push(sub, 0.0);
            array_push(sup, 0.0);
        }
        i = i + 1;
    }

    let rule = _gauss_legendre_rule(3);
    let inv_h = 1.0 / h;
    let half_h = 0.5 * h;

    let e = 0;
    while e < N {
        let xm = 0.5 * (xs[e] + xs[e + 1]);
        let ke00 = 0.0; let ke01 = 0.0; let ke11 = 0.0;
        let fe0 = 0.0;  let fe1 = 0.0;

        let g = 0;
        while g < 3 {
            let xi = rule.nodes[g];
            let w = half_h * rule.weights[g];
            let xq = xm + half_h * xi;
            let phi0 = 0.5 * (1.0 - xi);
            let phi1 = 0.5 * (1.0 + xi);
            let dphi0 = 0.0 - inv_h;
            let dphi1 = inv_h;

            let pv = pf(xq);
            let qv = qf(xq);
            let fv = ff(xq);

            ke00 = ke00 + w * (pv * dphi0 * dphi0 + qv * phi0 * phi0);
            ke01 = ke01 + w * (pv * dphi0 * dphi1 + qv * phi0 * phi1);
            ke11 = ke11 + w * (pv * dphi1 * dphi1 + qv * phi1 * phi1);
            fe0 = fe0 + w * fv * phi0;
            fe1 = fe1 + w * fv * phi1;
            g = g + 1;
        }

        diag[e] = diag[e] + ke00;
        diag[e + 1] = diag[e + 1] + ke11;
        sup[e] = sup[e] + ke01;
        sub[e] = sub[e] + ke01;
        rhs[e] = rhs[e] + fe0;
        rhs[e + 1] = rhs[e + 1] + fe1;
        e = e + 1;
    }

    // Lift essential Dirichlet boundary values u_0 = u_a, u_N = u_b onto interior nodes 1 .. N-1
    let m = N - 1;
    let td_a = []; // subdiagonal (length m, td_a[0] = 0)
    let td_b = []; // main diagonal (length m)
    let td_c = []; // superdiagonal (length m, td_c[m-1] = 0)
    let td_d = []; // load vector (length m)
    i = 0;
    while i < m {
        let node = i + 1;
        array_push(td_a, if i == 0 { 0.0 } else { sub[node - 1] });
        array_push(td_b, diag[node]);
        array_push(td_c, if i == m - 1 { 0.0 } else { sup[node] });
        let load = rhs[node];
        if i == 0 { load = load - sub[0] * (u_a * 1.0); }
        if i == m - 1 { load = load - sup[N - 1] * (u_b * 1.0); }
        array_push(td_d, load);
        i = i + 1;
    }

    // O(N) Thomas tridiagonal solver
    i = 1;
    while i < m {
        let w = td_a[i] / td_b[i - 1];
        td_b[i] = td_b[i] - w * td_c[i - 1];
        td_d[i] = td_d[i] - w * td_d[i - 1];
        i = i + 1;
    }
    let u_int = [];
    i = 0;
    while i < m { array_push(u_int, 0.0); i = i + 1; }
    u_int[m - 1] = td_d[m - 1] / td_b[m - 1];
    let idx = m - 2;
    while idx >= 0 {
        u_int[idx] = (td_d[idx] - td_c[idx] * u_int[idx + 1]) / td_b[idx];
        idx = idx - 1;
    }

    let us = [u_a * 1.0];
    i = 0;
    while i < m { array_push(us, u_int[i]); i = i + 1; }
    array_push(us, u_b * 1.0);

    let a_val = a * 1.0;
    let b_val = b * 1.0;
    return map{
        nodes: xs,
        values: us,
        h: h,
        n_elements: N,
        evaluate: fn(xv) {
            let xq = xv * 1.0;
            if xq <= a_val { return us[0]; }
            if xq >= b_val { return us[N]; }
            let pos = (xq - a_val) / h;
            let ei = num_round(num_floor(pos));
            if ei >= N { ei = N - 1; }
            let t_loc = pos - (ei * 1.0);
            return (1.0 - t_loc) * us[ei] + t_loc * us[ei + 1];
        }
    };
}

// Fredholm Integral Equation of the 2nd Kind: u(x) - lam * int_a^b K(x, t) u(t) dt = g(x)
// Solved via Nyström Gauss-Legendre quadrature + natural Nyström smooth interpolant
fn fredholm_2nd_kind(K_fn, g_fn, lam, a, b, n_nodes = 24) {
    let n = num_round(n_nodes);
    if n < 2 or n > MAX_QUAD_NODES or b <= a {
        throw "complex_riemann_stochastic_game: invalid fredholm_2nd_kind parameters";
    }
    let rule = _gauss_legendre_rule(n);
    let mid = 0.5 * ((a * 1.0) + (b * 1.0));
    let half = 0.5 * ((b * 1.0) - (a * 1.0));

    let ts = [];
    let ws = [];
    let i = 0;
    while i < n {
        array_push(ts, mid + half * rule.nodes[i]);
        array_push(ws, half * rule.weights[i]);
        i = i + 1;
    }

    let M = [];
    let rhs = [];
    i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            let entry = (0.0 - (lam * 1.0)) * ws[j] * (K_fn(ts[i], ts[j]) * 1.0);
            if i == j { entry = entry + 1.0; }
            array_push(row, entry);
            j = j + 1;
        }
        array_push(M, row);
        array_push(rhs, g_fn(ts[i]) * 1.0);
        i = i + 1;
    }

    let sol = _solve_dense_linear(M, rhs, 1e-10);
    if not sol.ok or num_abs(sol.det) < 1e-10 {
        return map{
            ok: false,
            status: "singular_eigenvalue",
            det: sol.det,
            min_pivot: sol.min_pivot,
            message: "Fredholm operator (I - lambda*K) is singular/indeterminate at eigenvalue lambda"
        };
    }

    let u_nodes = sol.x;
    let lam_v = lam * 1.0;
    return map{
        ok: true,
        status: "solved",
        nodes: ts,
        weights: ws,
        values: u_nodes,
        det: sol.det,
        evaluate: fn(x) {
            let xv = x * 1.0;
            let acc = g_fn(xv) * 1.0;
            let j = 0;
            while j < n {
                acc = acc + lam_v * ws[j] * (K_fn(xv, ts[j]) * 1.0) * u_nodes[j];
                j = j + 1;
            }
            return acc;
        }
    };
}

// Volterra Integral Equation of the 2nd Kind: u(x) - lam * int_a^x K(x, t) u(t) dt = g(x)
// Trapezoidal marching + 1-step Richardson extrapolation (O(h^4) accuracy!)
fn _volterra_trap_grid(K_fn, g_fn, a, b, N, lam) {
    let h = ((b * 1.0) - (a * 1.0)) / (N * 1.0);
    let xs = [];
    let i = 0;
    while i <= N { array_push(xs, (a * 1.0) + i * h); i = i + 1; }
    let us = [g_fn(xs[0]) * 1.0];
    i = 1;
    while i <= N {
        let xi = xs[i];
        let sum_hist = 0.5 * (K_fn(xi, xs[0]) * 1.0) * us[0];
        let j = 1;
        while j < i {
            sum_hist = sum_hist + (K_fn(xi, xs[j]) * 1.0) * us[j];
            j = j + 1;
        }
        let denom = 1.0 - 0.5 * lam * h * (K_fn(xi, xi) * 1.0);
        if num_abs(denom) < 1e-13 {
            throw "complex_riemann_stochastic_game: Volterra diagonal implicit step singular";
        }
        let ui = ((g_fn(xi) * 1.0) + lam * h * sum_hist) / denom;
        array_push(us, ui);
        i = i + 1;
    }
    return map{ xs: xs, us: us, h: h };
}

fn volterra_2nd_kind(K_fn, g_fn, a, b, n_steps = 100, lam = 1.0) {
    let N = num_round(n_steps);
    if N < 2 or N > 4096 or b <= a {
        throw "complex_riemann_stochastic_game: invalid volterra_2nd_kind parameters";
    }
    let coarse = _volterra_trap_grid(K_fn, g_fn, a, b, N, lam * 1.0);
    let fine = _volterra_trap_grid(K_fn, g_fn, a, b, 2 * N, lam * 1.0);

    let u_rich = [];
    let i = 0;
    while i <= N {
        // Richardson O(h^4) combination: (4 * u_{h/2}(x_i) - u_h(x_i)) / 3
        let val = (4.0 * fine.us[2 * i] - coarse.us[i]) / 3.0;
        array_push(u_rich, val);
        i = i + 1;
    }

    let a_v = a * 1.0;
    let b_v = b * 1.0;
    let h = coarse.h;
    return map{
        ok: true,
        nodes: coarse.xs,
        values: u_rich,
        h: h,
        n_steps: N,
        evaluate: fn(xv) {
            let xq = xv * 1.0;
            if xq <= a_v { return u_rich[0]; }
            if xq >= b_v { return u_rich[N]; }
            let pos = (xq - a_v) / h;
            let idx = num_round(num_floor(pos));
            if idx >= N { idx = N - 1; }
            let t_loc = pos - (idx * 1.0);
            return (1.0 - t_loc) * u_rich[idx] + t_loc * u_rich[idx + 1];
        }
    };
}

