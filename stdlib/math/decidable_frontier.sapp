// stdlib/math/decidable_frontier.sapp — Complete Decidable Mathematics Frontier Engine
// for PBLang v2.7.0 (100% pure PBLang, zero approximations, adaptive resource safety).
//
// Engines:
//   1. Tarski-Seidenberg Complete Quantifier Elimination & Cylindrical Algebraic
//      Decomposition (CAD) over Real Closed Fields (R, +, *, 0, 1, <) via exact
//      Subresultant PRS projection, Sturm chains, D5 dynamic algebraic towers &
//      Thom's Lemma quantifier-free formula synthesis.
//   2. Cooper's Complete Decision & Quantifier Elimination Algorithm for Presburger
//      Arithmetic (Z, +, -, <, =, equiv_m) with exact back-substituted Z-witnesses.
//   3. Diophantine Local-Global Obstruction & Modular Hasse-Minkowski Certificate
//      Engine (Archimedean R, Z-content GCD, p-adic valuation parity, separable
//      Z/mZ & Hensel prime-power residue certificates, bounded witness search).
//   4. Exact Algebraic Numbers Q-bar & Exact-Rational Lenstra-Lenstra-Lovasz (LLL)
//      Lattice Basis Reduction / Integer Relation & Minimal Polynomial Recovery.

let EX = import("stdlib:math/exact_algebra.sapp");
let GOV = import("stdlib:math/resource_governor.sapp");

let DECIDABLE_FRONTIER_VERSION = "2.7.0";
let MAX_CAD_VARS = 6;
let MAX_CAD_CELLS = 8192;
let MAX_PRESBURGER_MODULUS = 65536;
let MAX_LLL_DIM = 32;

let _B0 = bigint(0);
let _B1 = bigint(1);
let _B2 = bigint(2);
let _BM1 = bigint(-1);
let _B10 = bigint(10);

// ── Core String, Array, BigInt & Governor Helpers ─────────────────────────────

fn _guard_op(step_num, tag) {
    let lim = GOV.current_limits();
    if step_num > lim["max_steps"] {
        throw "MathGovernor[" + tag + "]: step count " + str(step_num) + " exceeds adaptive max_steps";
    }
}

fn _join_strs(arr, sep) {
    let out = "";
    let i = 0;
    while i < len(arr) {
        if i > 0 { out = out + sep; }
        out = out + str(arr[i]);
        i = i + 1;
    }
    return out;
}

fn _replace_all(src, pat, rep) {
    if len(pat) == 0 { return src; }
    let parts = str_split(src, pat);
    if len(parts) <= 1 { return src; }
    return _join_strs(parts, rep);
}

fn _arr_contains_str(arr, target) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == target { return true; }
        i = i + 1;
    }
    return false;
}

fn _arr_index_of_str(arr, target) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == target { return i; }
        i = i + 1;
    }
    return -1;
}

fn _copy_str_arr(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        push(out, arr[i]);
        i = i + 1;
    }
    return out;
}

fn _sort_strings(arr) {
    let out = _copy_str_arr(arr);
    let i = 1;
    while i < len(out) {
        let key = out[i];
        let j = i - 1;
        while j >= 0 and out[j] > key {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        i = i + 1;
    }
    return out;
}

fn _sort_ints(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        push(out, arr[i]);
        i = i + 1;
    }
    i = 1;
    while i < len(out) {
        let key = out[i];
        let j = i - 1;
        while j >= 0 and out[j] > key {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        i = i + 1;
    }
    return out;
}

fn _b_abs(x) {
    if x < _B0 { return _B0 - x; }
    return x;
}

fn _b_sign(x) {
    if x > _B0 { return 1; }
    if x < _B0 { return -1; }
    return 0;
}

fn _b_gcd(a, b) {
    let x = _b_abs(a);
    let y = _b_abs(b);
    let st = 0;
    while y != _B0 {
        st = st + 1;
        _guard_op(st, "bigint_gcd");
        let r = x % y;
        x = y;
        y = r;
    }
    return x;
}

fn _b_lcm(a, b) {
    if a == _B0 or b == _B0 { return _B0; }
    let g = _b_gcd(a, b);
    return _b_abs((a / g) * b);
}

fn _floor_div_bi(a, b) {
    let q = a / b;
    let r = a % b;
    if r < _B0 { return q - _B1; }
    return q;
}

fn _euclid_mod_bi(a, m) {
    let r = a % m;
    if r < _B0 { return r + m; }
    return r;
}

fn _bi_to_plain_int_or_bi(b) {
    let ab = _b_abs(b);
    if len(str(ab)) <= 14 {
        let nv = parse_number(str(b));
        if nv != nil { return nv; }
    }
    return b;
}

fn _to_bi_exact(v, ctx) {
    let tv = type(v);
    if tv == "bigint" { return v; }
    if tv == "number" {
        if num_floor(v) != v {
            throw ctx + ": expected exact integer, got " + str(v);
        }
        return bigint(v);
    }
    if tv == "string" {
        return bigint(str_trim(v));
    }
    if tv == "map" and map_has(v, "kind") and v["kind"] == "rat" {
        if v["den"] != _B1 {
            throw ctx + ": rational " + EX.rat_to_str(v) + " is not an integer";
        }
        return v["num"];
    }
    throw ctx + ": unsupported integer value of type " + tv;
}

// ── First-Order Logic & Polynomial Formula Lexer & Parser ─────────────────────

fn _normalize_unicode_formula(raw) {
    let s = str(raw);
    s = _replace_all(s, "∀", " forall ");
    s = _replace_all(s, "∃", " exists ");
    s = _replace_all(s, "≤", "<=");
    s = _replace_all(s, "≥", ">=");
    s = _replace_all(s, "≠", "!=");
    s = _replace_all(s, "∧", " and ");
    s = _replace_all(s, "∨", " or ");
    s = _replace_all(s, "¬", " not ");
    s = _replace_all(s, "↔", "<->");
    s = _replace_all(s, "⇔", "<->");
    s = _replace_all(s, "→", "->");
    s = _replace_all(s, "⇒", "->");
    s = _replace_all(s, "⊤", " true ");
    s = _replace_all(s, "⊥", " false ");
    s = _replace_all(s, "−", "-");
    s = _replace_all(s, "·", "*");
    s = _replace_all(s, "⁰", "^0");
    s = _replace_all(s, "¹", "^1");
    s = _replace_all(s, "²", "^2");
    s = _replace_all(s, "³", "^3");
    s = _replace_all(s, "⁴", "^4");
    s = _replace_all(s, "⁵", "^5");
    s = _replace_all(s, "⁶", "^6");
    s = _replace_all(s, "⁷", "^7");
    s = _replace_all(s, "⁸", "^8");
    s = _replace_all(s, "⁹", "^9");
    return s;
}

fn _is_alpha_ch(ch) {
    return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_";
}

fn _is_digit_ch(ch) {
    return ch >= "0" and ch <= "9";
}

fn _tokenize_fol(raw_str) {
    let s = _normalize_unicode_formula(raw_str);
    let n = len(s);
    if n > 16384 {
        throw "parse_first_order_formula: input length exceeds 16384 safety bound";
    }
    let toks = [];
    let i = 0;
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            i = i + 1;
        } else if _is_digit_ch(ch) {
            let start = i;
            while i < n and _is_digit_ch(str_slice(s, i, i + 1)) {
                i = i + 1;
            }
            if i < n and str_slice(s, i, i + 1) == "." {
                i = i + 1;
                while i < n and _is_digit_ch(str_slice(s, i, i + 1)) {
                    i = i + 1;
                }
            }
            push(toks, map{ kind: "NUM", val: str_slice(s, start, i) });
        } else if _is_alpha_ch(ch) {
            let start = i;
            while i < n {
                let c2 = str_slice(s, i, i + 1);
                if _is_alpha_ch(c2) or _is_digit_ch(c2) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            let word = str_slice(s, start, i);
            let lw = word;
            if word == "FORALL" or word == "Forall" { lw = "forall"; }
            else if word == "EXISTS" or word == "Exists" { lw = "exists"; }
            else if word == "AND" or word == "And" { lw = "and"; }
            else if word == "OR" or word == "Or" { lw = "or"; }
            else if word == "NOT" or word == "Not" { lw = "not"; }
            else if word == "IMPLIES" or word == "Implies" { lw = "implies"; }
            else if word == "IFF" or word == "Iff" { lw = "iff"; }
            else if word == "TRUE" or word == "True" { lw = "true"; }
            else if word == "FALSE" or word == "False" { lw = "false"; }

            if lw == "forall" or lw == "exists" or lw == "and" or lw == "or" or lw == "not" or lw == "implies" or lw == "iff" or lw == "true" or lw == "false" {
                push(toks, map{ kind: "KW", val: lw });
            } else {
                push(toks, map{ kind: "ID", val: word });
            }
        } else {
            let two = "";
            if i + 2 <= n { two = str_slice(s, i, i + 2); }
            let three = "";
            if i + 3 <= n { three = str_slice(s, i, i + 3); }

            if three == "<->" or three == "<=>" {
                push(toks, map{ kind: "KW", val: "iff" });
                i = i + 3;
            } else if two == "->" or two == "=>" {
                push(toks, map{ kind: "KW", val: "implies" });
                i = i + 2;
            } else if two == "&&" {
                push(toks, map{ kind: "KW", val: "and" });
                i = i + 2;
            } else if two == "||" {
                push(toks, map{ kind: "KW", val: "or" });
                i = i + 2;
            } else if two == "**" {
                push(toks, map{ kind: "OP", val: "^" });
                i = i + 2;
            } else if two == "==" {
                push(toks, map{ kind: "REL", val: "==" });
                i = i + 2;
            } else if two == "!=" or two == "<>" {
                push(toks, map{ kind: "REL", val: "!=" });
                i = i + 2;
            } else if two == "<=" {
                push(toks, map{ kind: "REL", val: "<=" });
                i = i + 2;
            } else if two == ">=" {
                push(toks, map{ kind: "REL", val: ">=" });
                i = i + 2;
            } else if ch == "<" or ch == ">" {
                push(toks, map{ kind: "REL", val: ch });
                i = i + 1;
            } else if ch == "=" {
                push(toks, map{ kind: "REL", val: "==" });
                i = i + 1;
            } else if ch == "!" {
                push(toks, map{ kind: "KW", val: "not" });
                i = i + 1;
            } else if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "^" {
                push(toks, map{ kind: "OP", val: ch });
                i = i + 1;
            } else if ch == "(" or ch == ")" or ch == ":" or ch == "," or ch == "." {
                push(toks, map{ kind: "PUNC", val: ch });
                i = i + 1;
            } else {
                throw "parse_first_order_formula: unexpected character '" + ch + "'";
            }
        }
    }
    push(toks, map{ kind: "EOF", val: "" });
    return toks;
}

fn _decimal_str_to_rat(num_str) {
    let dot = str_index_of(num_str, ".");
    if dot < 0 {
        return EX.rat(bigint(num_str), _B1);
    }
    let ip = str_slice(num_str, 0, dot);
    let fp = str_slice(num_str, dot + 1, len(num_str));
    if len(ip) == 0 { ip = "0"; }
    if len(fp) == 0 { return EX.rat(bigint(ip), _B1); }
    let den = _B1;
    let k = 0;
    while k < len(fp) {
        den = den * _B10;
        k = k + 1;
    }
    let digits = ip + fp;
    return EX.rat(bigint(digits), den);
}

fn _p_peek(st) {
    return st["toks"][st["pos"]];
}

fn _p_next(st) {
    let t = st["toks"][st["pos"]];
    if t["kind"] != "EOF" {
        st["pos"] = st["pos"] + 1;
    }
    return t;
}

fn _parse_alg_primary(st) {
    let t = _p_peek(st);
    if t["kind"] == "NUM" {
        _p_next(st);
        return map{ kind: "num", rat: _decimal_str_to_rat(t["val"]) };
    }
    if t["kind"] == "ID" {
        _p_next(st);
        let nm = t["val"];
        if _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "(" {
            _p_next(st);
            let args = [];
            if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")") {
                push(args, _parse_alg_expr(st));
                while _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "," {
                    _p_next(st);
                    push(args, _parse_alg_expr(st));
                }
            }
            if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")") {
                throw "parse_first_order_formula: expected ')' in call to " + nm;
            }
            _p_next(st);
            return map{ kind: "call", name: nm, args: args };
        }
        return map{ kind: "var", name: nm };
    }
    if t["kind"] == "PUNC" and t["val"] == "(" {
        _p_next(st);
        let inner = _parse_alg_expr(st);
        if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")") {
            throw "parse_first_order_formula: expected ')' in algebraic expression";
        }
        _p_next(st);
        return inner;
    }
    throw "parse_first_order_formula: expected algebraic term near '" + t["val"] + "'";
}

fn _parse_alg_pow(st) {
    let base_e = _parse_alg_primary(st);
    if _p_peek(st)["kind"] == "OP" and _p_peek(st)["val"] == "^" {
        _p_next(st);
        let exp_t = _p_peek(st);
        if exp_t["kind"] != "NUM" or str_index_of(exp_t["val"], ".") >= 0 {
            throw "parse_first_order_formula: polynomial exponent must be a non-negative integer";
        }
        _p_next(st);
        let exp_int = num_floor(parse_number(exp_t["val"]));
        if exp_int < 0 or exp_int > 128 {
            throw "parse_first_order_formula: exponent out of polynomial bounds";
        }
        return map{ kind: "pow", base: base_e, exp: exp_int };
    }
    return base_e;
}

fn _parse_alg_unary(st) {
    let t = _p_peek(st);
    if t["kind"] == "OP" and t["val"] == "-" {
        _p_next(st);
        return map{ kind: "neg", arg: _parse_alg_unary(st) };
    }
    if t["kind"] == "OP" and t["val"] == "+" {
        _p_next(st);
        return _parse_alg_unary(st);
    }
    return _parse_alg_pow(st);
}

fn _can_implicit_mul_rhs(prev_node, next_tok) {
    // Allow clean implicit multiplication like `2x` or `3(x + 1)` when LHS was numeric
    if prev_node["kind"] == "num" {
        if next_tok["kind"] == "ID" { return true; }
        if next_tok["kind"] == "PUNC" and next_tok["val"] == "(" { return true; }
    }
    return false;
}

fn _parse_alg_mul(st) {
    let acc = _parse_alg_unary(st);
    while true {
        let t = _p_peek(st);
        if t["kind"] == "OP" and (t["val"] == "*" or t["val"] == "/") {
            let op = t["val"];
            _p_next(st);
            let rhs = _parse_alg_unary(st);
            acc = map{ kind: op, left: acc, right: rhs };
        } else if _can_implicit_mul_rhs(acc, t) {
            let rhs2 = _parse_alg_unary(st);
            acc = map{ kind: "*", left: acc, right: rhs2 };
        } else {
            break;
        }
    }
    return acc;
}

fn _parse_alg_expr(st) {
    let acc = _parse_alg_mul(st);
    while _p_peek(st)["kind"] == "OP" and (_p_peek(st)["val"] == "+" or _p_peek(st)["val"] == "-") {
        let op = _p_next(st)["val"];
        let rhs = _parse_alg_mul(st);
        acc = map{ kind: op, left: acc, right: rhs };
    }
    return acc;
}

fn _parse_fol_atom(st) {
    let t = _p_peek(st);
    if t["kind"] == "KW" and (t["val"] == "true" or t["val"] == "false") {
        _p_next(st);
        return map{ kind: "bool", val: t["val"] == "true" };
    }
    // Check `divides(m, expr)` or `ndivides(m, expr)` predicate
    if t["kind"] == "ID" and (t["val"] == "divides" or t["val"] == "ndivides") {
        let pred_nm = _p_next(st)["val"];
        if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "(") {
            throw "parse_first_order_formula: expected '(' after " + pred_nm;
        }
        _p_next(st);
        let mod_expr = _parse_alg_expr(st);
        if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ",") {
            throw "parse_first_order_formula: expected ',' inside " + pred_nm + "(m, expr)";
        }
        _p_next(st);
        let target_expr = _parse_alg_expr(st);
        if not (_p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")") {
            throw "parse_first_order_formula: expected ')' closing " + pred_nm;
        }
        _p_next(st);
        let base_div = map{ kind: "divides", mod_expr: mod_expr, expr: target_expr };
        if pred_nm == "ndivides" {
            return map{ kind: "not", arg: base_div };
        }
        return base_div;
    }

    let lhs = _parse_alg_expr(st);
    let rt = _p_peek(st);
    if rt["kind"] != "REL" {
        throw "parse_first_order_formula: expected relational operator (==, !=, <, <=, >, >=), got '" + rt["val"] + "'";
    }
    _p_next(st);
    let rhs = _parse_alg_expr(st);
    return map{
        kind: "atom",
        op: rt["val"],
        lhs: lhs,
        rhs: rhs,
        diff: map{ kind: "-", left: lhs, right: rhs }
    };
}

fn _parse_fol_unary(st) {
    let t = _p_peek(st);
    if t["kind"] == "KW" and (t["val"] == "forall" or t["val"] == "exists") {
        let q_kind = _p_next(st)["val"];
        let q_vars = [];
        let wrapped_var_parens = false;
        if _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "(" {
            let save_vp = st["pos"];
            _p_next(st);
            if _p_peek(st)["kind"] == "ID" {
                let id_t = _p_next(st);
                if _p_peek(st)["kind"] == "PUNC" and (_p_peek(st)["val"] == ")" or _p_peek(st)["val"] == ",") {
                    push(q_vars, id_t["val"]);
                    while _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "," {
                        _p_next(st);
                        let vt2 = _p_next(st);
                        if vt2["kind"] != "ID" { throw "parse_first_order_formula: expected variable name"; }
                        push(q_vars, vt2["val"]);
                    }
                    if _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")" {
                        _p_next(st);
                        wrapped_var_parens = true;
                    } else {
                        st["pos"] = save_vp;
                        q_vars = [];
                    }
                } else {
                    st["pos"] = save_vp;
                }
            } else {
                st["pos"] = save_vp;
            }
        }
        let q_guards = [];
        if not wrapped_var_parens {
            let vt = _p_next(st);
            if vt["kind"] != "ID" {
                throw "parse_first_order_formula: expected bound variable after " + q_kind;
            }
            push(q_vars, vt["val"]);
            while _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == "," {
                _p_next(st);
                let vt2 = _p_next(st);
                if vt2["kind"] != "ID" {
                    throw "parse_first_order_formula: expected bound variable after ','";
                }
                push(q_vars, vt2["val"]);
            }
            if _p_peek(st)["kind"] == "REL" {
                let rel_op = _p_next(st)["val"];
                let bnd_rhs = _parse_alg_expr(st);
                let gi = 0;
                while gi < len(q_vars) {
                    let gv = map{ kind: "var", name: q_vars[gi] };
                    push(q_guards, map{
                        kind: "atom",
                        op: rel_op,
                        lhs: gv,
                        rhs: bnd_rhs,
                        diff: map{ kind: "-", left: gv, right: bnd_rhs }
                    });
                    gi = gi + 1;
                }
            }
        }
        if _p_peek(st)["kind"] == "PUNC" and (_p_peek(st)["val"] == ":" or _p_peek(st)["val"] == ".") {
            _p_next(st);
        }
        let body = _parse_fol_iff(st);
        if len(q_guards) > 0 {
            let g_conj = q_guards[0];
            let gk = 1;
            while gk < len(q_guards) {
                g_conj = map{ kind: "and", left: g_conj, right: q_guards[gk] };
                gk = gk + 1;
            }
            if q_kind == "forall" {
                body = map{ kind: "implies", left: g_conj, right: body };
            } else {
                body = map{ kind: "and", left: g_conj, right: body };
            }
        }
        let idx = len(q_vars) - 1;
        while idx >= 0 {
            body = map{ kind: q_kind, var_name: q_vars[idx], body: body };
            idx = idx - 1;
        }
        return body;
    }

    if t["kind"] == "KW" and t["val"] == "not" {
        _p_next(st);
        return map{ kind: "not", arg: _parse_fol_unary(st) };
    }

    if t["kind"] == "PUNC" and t["val"] == "(" {
        // Disambiguate parenthesized logical subformula `(A >= B)` vs algebraic `(x + 1)^2 >= 0`
        let saved = st["pos"];
        let ok_formula = false;
        let sub_f = nil;
        let _ = try {
            _p_next(st);
            let cand = _parse_fol_iff(st);
            if _p_peek(st)["kind"] == "PUNC" and _p_peek(st)["val"] == ")" {
                _p_next(st);
                let after = _p_peek(st);
                if after["kind"] != "OP" and after["kind"] != "REL" {
                    ok_formula = true;
                    sub_f = cand;
                }
            }
            nil
        } catch {
            ok_formula = false;
            nil
        };
        if ok_formula {
            return sub_f;
        }
        st["pos"] = saved;
    }

    return _parse_fol_atom(st);
}

fn _parse_fol_and(st) {
    let acc = _parse_fol_unary(st);
    while _p_peek(st)["kind"] == "KW" and _p_peek(st)["val"] == "and" {
        _p_next(st);
        let rhs = _parse_fol_unary(st);
        acc = map{ kind: "and", left: acc, right: rhs };
    }
    return acc;
}

fn _parse_fol_or(st) {
    let acc = _parse_fol_and(st);
    while _p_peek(st)["kind"] == "KW" and _p_peek(st)["val"] == "or" {
        _p_next(st);
        let rhs = _parse_fol_and(st);
        acc = map{ kind: "or", left: acc, right: rhs };
    }
    return acc;
}

fn _parse_fol_implies(st) {
    let lhs = _parse_fol_or(st);
    if _p_peek(st)["kind"] == "KW" and _p_peek(st)["val"] == "implies" {
        _p_next(st);
        let rhs = _parse_fol_implies(st);
        return map{ kind: "implies", left: lhs, right: rhs };
    }
    return lhs;
}

fn _parse_fol_iff(st) {
    let lhs = _parse_fol_implies(st);
    if _p_peek(st)["kind"] == "KW" and _p_peek(st)["val"] == "iff" {
        _p_next(st);
        let rhs = _parse_fol_iff(st);
        return map{ kind: "iff", left: lhs, right: rhs };
    }
    return lhs;
}

fn parse_first_order_formula(str_or_ast) {
    if type(str_or_ast) == "map" {
        if map_has(str_or_ast, "kind") {
            let k = str_or_ast["kind"];
            if (k == "forall" or k == "exists") and (not map_has(str_or_ast, "var_name")) and map_has(str_or_ast, "var") {
                let copy_q = map{
                    kind: k,
                    var_name: str(str_or_ast["var"]),
                    body: parse_first_order_formula(str_or_ast["body"])
                };
                return copy_q;
            }
            return str_or_ast;
        }
        if map_has(str_or_ast, "body") {
            let body_ast = parse_first_order_formula(str_or_ast["body"]);
            if map_has(str_or_ast, "quantifiers") and type(str_or_ast["quantifiers"]) == "array" {
                let qs = str_or_ast["quantifiers"];
                let idx = len(qs) - 1;
                while idx >= 0 {
                    let qi = qs[idx];
                    let qk = str(qi["q"]);
                    if qk == "∀" { qk = "forall"; }
                    if qk == "∃" { qk = "exists"; }
                    if qk != "forall" and qk != "exists" {
                        throw "parse_first_order_formula: unknown quantifier '" + qk + "'";
                    }
                    let vnm = "";
                    if map_has(qi, "var_name") { vnm = str(qi["var_name"]); }
                    else if map_has(qi, "var") { vnm = str(qi["var"]); }
                    else { throw "parse_first_order_formula: quantifier entry missing 'var'"; }
                    body_ast = map{ kind: qk, var_name: vnm, body: body_ast };
                    idx = idx - 1;
                }
            }
            return body_ast;
        }
        throw "parse_first_order_formula: unrecognized AST map structure";
    }
    if type(str_or_ast) != "string" {
        throw "parse_first_order_formula: expected string or AST map, got " + type(str_or_ast);
    }
    let toks = _tokenize_fol(str_or_ast);
    let st = map{ toks: toks, pos: 0 };
    let ast = _parse_fol_iff(st);
    if _p_peek(st)["kind"] != "EOF" {
        throw "parse_first_order_formula: unexpected trailing token '" + _p_peek(st)["val"] + "'";
    }
    return ast;
}

fn _alg_expr_vars(e, bound_arr, out_arr) {
    let k = e["kind"];
    if k == "num" { return; }
    if k == "var" {
        let nm = e["name"];
        if (not _arr_contains_str(bound_arr, nm)) and (not _arr_contains_str(out_arr, nm)) {
            push(out_arr, nm);
        }
        return;
    }
    if k == "neg" {
        _alg_expr_vars(e["arg"], bound_arr, out_arr);
        return;
    }
    if k == "pow" {
        _alg_expr_vars(e["base"], bound_arr, out_arr);
        return;
    }
    if k == "+" or k == "-" or k == "*" or k == "/" {
        _alg_expr_vars(e["left"], bound_arr, out_arr);
        _alg_expr_vars(e["right"], bound_arr, out_arr);
        return;
    }
    if k == "call" {
        let i = 0;
        while i < len(e["args"]) {
            _alg_expr_vars(e["args"][i], bound_arr, out_arr);
            i = i + 1;
        }
    }
}

fn _fol_collect_free_vars(f, bound_arr, out_arr) {
    let k = f["kind"];
    if k == "bool" { return; }
    if k == "atom" {
        _alg_expr_vars(f["lhs"], bound_arr, out_arr);
        _alg_expr_vars(f["rhs"], bound_arr, out_arr);
        return;
    }
    if k == "divides" {
        _alg_expr_vars(f["mod_expr"], bound_arr, out_arr);
        _alg_expr_vars(f["expr"], bound_arr, out_arr);
        return;
    }
    if k == "not" {
        _fol_collect_free_vars(f["arg"], bound_arr, out_arr);
        return;
    }
    if k == "and" or k == "or" or k == "implies" or k == "iff" {
        _fol_collect_free_vars(f["left"], bound_arr, out_arr);
        _fol_collect_free_vars(f["right"], bound_arr, out_arr);
        return;
    }
    if k == "forall" or k == "exists" {
        let b2 = _copy_str_arr(bound_arr);
        push(b2, f["var_name"]);
        _fol_collect_free_vars(f["body"], b2, out_arr);
        return;
    }
}

fn formula_free_vars(formula_or_str) {
    let ast = parse_first_order_formula(formula_or_str);
    let out = [];
    _fol_collect_free_vars(ast, [], out);
    return out;
}

fn _alg_rename_var(e, old_nm, new_nm) {
    let k = e["kind"];
    if k == "num" { return e; }
    if k == "var" {
        if e["name"] == old_nm { return map{ kind: "var", name: new_nm }; }
        return e;
    }
    if k == "neg" { return map{ kind: "neg", arg: _alg_rename_var(e["arg"], old_nm, new_nm) }; }
    if k == "pow" { return map{ kind: "pow", base: _alg_rename_var(e["base"], old_nm, new_nm), exp: e["exp"] }; }
    if k == "+" or k == "-" or k == "*" or k == "/" {
        return map{
            kind: k,
            left: _alg_rename_var(e["left"], old_nm, new_nm),
            right: _alg_rename_var(e["right"], old_nm, new_nm)
        };
    }
    if k == "call" {
        let na = [];
        let i = 0;
        while i < len(e["args"]) {
            push(na, _alg_rename_var(e["args"][i], old_nm, new_nm));
            i = i + 1;
        }
        return map{ kind: "call", name: e["name"], args: na };
    }
    return e;
}

fn _fol_rename_free(f, old_nm, new_nm) {
    let k = f["kind"];
    if k == "bool" { return f; }
    if k == "atom" {
        let nl = _alg_rename_var(f["lhs"], old_nm, new_nm);
        let nr = _alg_rename_var(f["rhs"], old_nm, new_nm);
        return map{ kind: "atom", op: f["op"], lhs: nl, rhs: nr, diff: map{ kind: "-", left: nl, right: nr } };
    }
    if k == "divides" {
        return map{
            kind: "divides",
            mod_expr: _alg_rename_var(f["mod_expr"], old_nm, new_nm),
            expr: _alg_rename_var(f["expr"], old_nm, new_nm)
        };
    }
    if k == "not" { return map{ kind: "not", arg: _fol_rename_free(f["arg"], old_nm, new_nm) }; }
    if k == "and" or k == "or" or k == "implies" or k == "iff" {
        return map{
            kind: k,
            left: _fol_rename_free(f["left"], old_nm, new_nm),
            right: _fol_rename_free(f["right"], old_nm, new_nm)
        };
    }
    if k == "forall" or k == "exists" {
        if f["var_name"] == old_nm { return f; }
        return map{ kind: k, var_name: f["var_name"], body: _fol_rename_free(f["body"], old_nm, new_nm) };
    }
    return f;
}

fn _negate_rel_op(op) {
    if op == "==" { return "!="; }
    if op == "!=" { return "=="; }
    if op == "<" { return ">="; }
    if op == "<=" { return ">"; }
    if op == ">" { return "<="; }
    if op == ">=" { return "<"; }
    throw "unknown relational op " + op;
}

fn _fol_to_nnf(f, neg) {
    let k = f["kind"];
    if k == "bool" {
        if neg { return map{ kind: "bool", val: not f["val"] }; }
        return f;
    }
    if k == "atom" {
        if neg {
            return map{
                kind: "atom",
                op: _negate_rel_op(f["op"]),
                lhs: f["lhs"],
                rhs: f["rhs"],
                diff: f["diff"]
            };
        }
        return f;
    }
    if k == "divides" {
        if neg { return map{ kind: "not", arg: f }; }
        return f;
    }
    if k == "not" {
        return _fol_to_nnf(f["arg"], not neg);
    }
    if k == "implies" {
        // A -> B == (~A) or B
        let eqv = map{ kind: "or", left: map{ kind: "not", arg: f["left"] }, right: f["right"] };
        return _fol_to_nnf(eqv, neg);
    }
    if k == "iff" {
        let both_t = map{ kind: "and", left: f["left"], right: f["right"] };
        let both_f = map{ kind: "and", left: map{ kind: "not", arg: f["left"] }, right: map{ kind: "not", arg: f["right"] } };
        return _fol_to_nnf(map{ kind: "or", left: both_t, right: both_f }, neg);
    }
    if k == "and" {
        if neg {
            return map{ kind: "or", left: _fol_to_nnf(f["left"], true), right: _fol_to_nnf(f["right"], true) };
        }
        return map{ kind: "and", left: _fol_to_nnf(f["left"], false), right: _fol_to_nnf(f["right"], false) };
    }
    if k == "or" {
        if neg {
            return map{ kind: "and", left: _fol_to_nnf(f["left"], true), right: _fol_to_nnf(f["right"], true) };
        }
        return map{ kind: "or", left: _fol_to_nnf(f["left"], false), right: _fol_to_nnf(f["right"], false) };
    }
    if k == "forall" {
        let nk = "forall";
        if neg { nk = "exists"; }
        return map{ kind: nk, var_name: f["var_name"], body: _fol_to_nnf(f["body"], neg) };
    }
    if k == "exists" {
        let nk = "exists";
        if neg { nk = "forall"; }
        return map{ kind: nk, var_name: f["var_name"], body: _fol_to_nnf(f["body"], neg) };
    }
    return f;
}

fn _prenex_uniquify_bound(f, used_Map, counter_box) {
    let k = f["kind"];
    if k == "bool" or k == "atom" or k == "divides" { return f; }
    if k == "not" {
        return map{ kind: "not", arg: _prenex_uniquify_bound(f["arg"], used_Map, counter_box) };
    }
    if k == "and" or k == "or" {
        return map{
            kind: k,
            left: _prenex_uniquify_bound(f["left"], used_Map, counter_box),
            right: _prenex_uniquify_bound(f["right"], used_Map, counter_box)
        };
    }
    if k == "forall" or k == "exists" {
        let v = f["var_name"];
        let body = f["body"];
        if map_has(used_Map, v) {
            counter_box["n"] = counter_box["n"] + 1;
            let fresh = v + "__q" + str(counter_box["n"]);
            while map_has(used_Map, fresh) {
                counter_box["n"] = counter_box["n"] + 1;
                fresh = v + "__q" + str(counter_box["n"]);
            }
            used_Map[fresh] = true;
            let renamed = _fol_rename_free(body, v, fresh);
            return map{ kind: k, var_name: fresh, body: _prenex_uniquify_bound(renamed, used_Map, counter_box) };
        }
        used_Map[v] = true;
        return map{ kind: k, var_name: v, body: _prenex_uniquify_bound(body, used_Map, counter_box) };
    }
    return f;
}

fn _pull_prenex(f) {
    let k = f["kind"];
    if k == "forall" or k == "exists" {
        let sub = _pull_prenex(f["body"]);
        let q_list = [map{ q: k, var_name: f["var_name"] }];
        let i = 0;
        while i < len(sub["quantifiers"]) {
            push(q_list, sub["quantifiers"][i]);
            i = i + 1;
        }
        return map{ quantifiers: q_list, matrix: sub["matrix"] };
    }
    if k == "and" or k == "or" {
        let L = _pull_prenex(f["left"]);
        let R = _pull_prenex(f["right"]);
        let q_list = [];
        let i = 0;
        while i < len(L["quantifiers"]) {
            push(q_list, L["quantifiers"][i]);
            i = i + 1;
        }
        i = 0;
        while i < len(R["quantifiers"]) {
            push(q_list, R["quantifiers"][i]);
            i = i + 1;
        }
        return map{
            quantifiers: q_list,
            matrix: map{ kind: k, left: L["matrix"], right: R["matrix"] }
        };
    }
    return map{ quantifiers: [], matrix: f };
}

fn formula_to_prenex(formula_or_str) {
    let ast = parse_first_order_formula(formula_or_str);
    let fvs = formula_free_vars(ast);
    let nnf = _fol_to_nnf(ast, false);
    let used = map{};
    let i = 0;
    while i < len(fvs) {
        used[fvs[i]] = true;
        i = i + 1;
    }
    let uniq = _prenex_uniquify_bound(nnf, used, map{ n: 0 });
    let pulled = _pull_prenex(uniq);
    return map{
        free_vars: fvs,
        quantifiers: pulled["quantifiers"],
        matrix: pulled["matrix"]
    };
}

// ── Recursive Multivariate Polynomial Ring Q[v_1, ..., v_k] ───────────────────
// Level 0: EX.rat(num, den)
// Level k >= 1: map{ level: k, coeffs: [c_0, ..., c_d] } where c_i has level k - 1,
// and either coeffs == [] (zero) or not rpoly_is_zero(coeffs[d]).

fn rpoly_zero(level) {
    if level == 0 { return EX.rat(0, 1); }
    return map{ level: level, coeffs: [] };
}

fn rpoly_one(level) {
    return rpoly_const_rat(level, EX.rat(1, 1));
}

fn rpoly_is_zero(p) {
    if type(p) == "map" and map_has(p, "kind") and p["kind"] == "rat" {
        return EX.rat_is_zero(p);
    }
    return len(p["coeffs"]) == 0;
}

fn rpoly_level(p) {
    if type(p) == "map" and map_has(p, "kind") and p["kind"] == "rat" {
        return 0;
    }
    return p["level"];
}

fn rpoly_const_rat(level, r) {
    if EX.rat_is_zero(r) { return rpoly_zero(level); }
    let cur = r;
    let lv = 1;
    while lv <= level {
        cur = map{ level: lv, coeffs: [cur] };
        lv = lv + 1;
    }
    return cur;
}

fn rpoly_lift_from(sub_p, target_level) {
    let cur_lv = rpoly_level(sub_p);
    if cur_lv == target_level { return sub_p; }
    if rpoly_is_zero(sub_p) { return rpoly_zero(target_level); }
    let cur = sub_p;
    while cur_lv < target_level {
        cur_lv = cur_lv + 1;
        cur = map{ level: cur_lv, coeffs: [cur] };
    }
    return cur;
}

fn rpoly_var(total_level, var_idx_1based) {
    // var_idx_1based in 1..total_level
    let base_x = map{
        level: var_idx_1based,
        coeffs: [rpoly_zero(var_idx_1based - 1), rpoly_one(var_idx_1based - 1)]
    };
    return rpoly_lift_from(base_x, total_level);
}

fn rpoly_trim(p) {
    let lv = rpoly_level(p);
    if lv == 0 { return p; }
    let cs = p["coeffs"];
    let hi = len(cs) - 1;
    while hi >= 0 and rpoly_is_zero(cs[hi]) {
        hi = hi - 1;
    }
    if hi < 0 { return rpoly_zero(lv); }
    let out = [];
    let i = 0;
    while i <= hi {
        push(out, cs[i]);
        i = i + 1;
    }
    return map{ level: lv, coeffs: out };
}

fn rpoly_deg(p) {
    if rpoly_is_zero(p) { return -1; }
    if rpoly_level(p) == 0 { return 0; }
    return len(p["coeffs"]) - 1;
}

fn rpoly_lc(p) {
    let d = rpoly_deg(p);
    if d < 0 { return rpoly_zero(rpoly_level(p) - 1); }
    return p["coeffs"][d];
}

fn rpoly_is_const_rat(p) {
    let lv = rpoly_level(p);
    if lv == 0 { return true; }
    if len(p["coeffs"]) == 0 { return true; }
    if len(p["coeffs"]) > 1 { return false; }
    return rpoly_is_const_rat(p["coeffs"][0]);
}

fn rpoly_get_const_rat(p) {
    let cur = p;
    while rpoly_level(cur) > 0 {
        if len(cur["coeffs"]) == 0 { return EX.rat(0, 1); }
        cur = cur["coeffs"][0];
    }
    return cur;
}

fn rpoly_neg(a) {
    let lv = rpoly_level(a);
    if lv == 0 { return EX.rat_neg(a); }
    if rpoly_is_zero(a) { return a; }
    let out = [];
    let i = 0;
    while i < len(a["coeffs"]) {
        push(out, rpoly_neg(a["coeffs"][i]));
        i = i + 1;
    }
    return map{ level: lv, coeffs: out };
}

fn rpoly_scale_rat(a, r) {
    let lv = rpoly_level(a);
    if EX.rat_is_zero(r) or rpoly_is_zero(a) { return rpoly_zero(lv); }
    if lv == 0 { return EX.rat_mul(a, r); }
    let out = [];
    let i = 0;
    while i < len(a["coeffs"]) {
        push(out, rpoly_scale_rat(a["coeffs"][i], r));
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

fn rpoly_add(a, b) {
    let lv = rpoly_level(a);
    if lv == 0 { return EX.rat_add(a, b); }
    let ca = a["coeffs"];
    let cb = b["coeffs"];
    let na = len(ca);
    let nb = len(cb);
    let mx = na;
    if nb > mx { mx = nb; }
    let out = [];
    let i = 0;
    while i < mx {
        let va = rpoly_zero(lv - 1);
        let vb = rpoly_zero(lv - 1);
        if i < na { va = ca[i]; }
        if i < nb { vb = cb[i]; }
        push(out, rpoly_add(va, vb));
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

fn rpoly_sub(a, b) {
    return rpoly_add(a, rpoly_neg(b));
}

fn rpoly_mul(a, b) {
    let lv = rpoly_level(a);
    if lv == 0 { return EX.rat_mul(a, b); }
    if rpoly_is_zero(a) or rpoly_is_zero(b) { return rpoly_zero(lv); }
    let ca = a["coeffs"];
    let cb = b["coeffs"];
    let na = len(ca);
    let nb = len(cb);
    let out = [];
    let k = 0;
    while k < na + nb - 1 {
        push(out, rpoly_zero(lv - 1));
        k = k + 1;
    }
    let i = 0;
    while i < na {
        if not rpoly_is_zero(ca[i]) {
            let j = 0;
            while j < nb {
                if not rpoly_is_zero(cb[j]) {
                    out[i + j] = rpoly_add(out[i + j], rpoly_mul(ca[i], cb[j]));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

fn rpoly_mul_coeff(p, c_sub) {
    // Multiply p at level lv by c_sub at level lv - 1
    let lv = rpoly_level(p);
    if rpoly_is_zero(p) or rpoly_is_zero(c_sub) { return rpoly_zero(lv); }
    let out = [];
    let i = 0;
    while i < len(p["coeffs"]) {
        push(out, rpoly_mul(p["coeffs"][i], c_sub));
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

fn rpoly_pow(base_p, exp_int) {
    let lv = rpoly_level(base_p);
    if exp_int == 0 { return rpoly_one(lv); }
    if rpoly_is_zero(base_p) { return rpoly_zero(lv); }
    let res = rpoly_one(lv);
    let cur = base_p;
    let e = exp_int;
    while e > 0 {
        let h = num_floor(e / 2);
        if e - 2 * h == 1 {
            res = rpoly_mul(res, cur);
        }
        e = h;
        if e > 0 { cur = rpoly_mul(cur, cur); }
    }
    return res;
}

fn rpoly_deriv_main(p) {
    let lv = rpoly_level(p);
    if lv == 0 or len(p["coeffs"]) <= 1 { return rpoly_zero(lv); }
    let out = [];
    let i = 1;
    while i < len(p["coeffs"]) {
        push(out, rpoly_scale_rat(p["coeffs"][i], EX.rat(i, 1)));
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

fn rpoly_deriv_var(p, var_idx_1based) {
    let lv = rpoly_level(p);
    if lv == 0 or rpoly_is_zero(p) { return rpoly_zero(lv); }
    if var_idx_1based == lv {
        return rpoly_deriv_main(p);
    }
    let out = [];
    let i = 0;
    while i < len(p["coeffs"]) {
        push(out, rpoly_deriv_var(p["coeffs"][i], var_idx_1based));
        i = i + 1;
    }
    return rpoly_trim(map{ level: lv, coeffs: out });
}

// Exact division A / B in integral domain Q[v_1, ..., v_lv] when B divides A exactly.
// Returns nil if B does not divide A cleanly.
fn rpoly_exact_div_opt(a, b) {
    let lv = rpoly_level(a);
    if rpoly_is_zero(b) { return nil; }
    if rpoly_is_zero(a) { return rpoly_zero(lv); }
    if lv == 0 { return EX.rat_div(a, b); }

    let db = rpoly_deg(b);
    if db == 0 {
        let b0 = b["coeffs"][0];
        let out0 = [];
        let i = 0;
        while i < len(a["coeffs"]) {
            let qi = rpoly_exact_div_opt(a["coeffs"][i], b0);
            if qi == nil { return nil; }
            push(out0, qi);
            i = i + 1;
        }
        return rpoly_trim(map{ level: lv, coeffs: out0 });
    }

    let rem = a;
    let da = rpoly_deg(rem);
    if da < db { return nil; }
    let q_coeffs = [];
    let k = 0;
    while k <= da - db {
        push(q_coeffs, rpoly_zero(lv - 1));
        k = k + 1;
    }
    let lcb = rpoly_lc(b);
    let guard = 0;
    while (not rpoly_is_zero(rem)) and rpoly_deg(rem) >= db {
        guard = guard + 1;
        _guard_op(guard, "rpoly_exact_div");
        let dr = rpoly_deg(rem);
        let shift = dr - db;
        let q_term = rpoly_exact_div_opt(rpoly_lc(rem), lcb);
        if q_term == nil { return nil; }
        q_coeffs[shift] = rpoly_add(q_coeffs[shift], q_term);
        // Subtract q_term * x^shift * b
        let sub_cs = [];
        let s = 0;
        while s < shift {
            push(sub_cs, rpoly_zero(lv - 1));
            s = s + 1;
        }
        let j = 0;
        while j < len(b["coeffs"]) {
            push(sub_cs, rpoly_mul(q_term, b["coeffs"][j]));
            j = j + 1;
        }
        rem = rpoly_sub(rem, rpoly_trim(map{ level: lv, coeffs: sub_cs }));
    }
    if not rpoly_is_zero(rem) { return nil; }
    return rpoly_trim(map{ level: lv, coeffs: q_coeffs });
}

fn rpoly_exact_div(a, b) {
    let q = rpoly_exact_div_opt(a, b);
    if q == nil {
        throw "rpoly_exact_div: non-exact polynomial division in Subresultant PRS";
    }
    return q;
}

// Exact pseudo-remainder prem(A, B) in D[x_lv] where D = Q[v_1..v_{lv-1}]:
// satisfies lc(B)^(deg(A) - deg(B) + 1) * A = Q * B + prem(A, B) with deg(prem) < deg(B).
fn rpoly_prem(a, b) {
    let lv = rpoly_level(a);
    let ma = rpoly_deg(a);
    let nb = rpoly_deg(b);
    if nb < 0 { throw "rpoly_prem: division by zero polynomial"; }
    if ma < nb { return a; }
    if nb == 0 { return rpoly_zero(lv); }

    let lcb = rpoly_lc(b);
    let rem = a;
    let e_rem = ma - nb + 1;
    let st = 0;
    while (not rpoly_is_zero(rem)) and rpoly_deg(rem) >= nb {
        st = st + 1;
        _guard_op(st, "rpoly_prem");
        let dr = rpoly_deg(rem);
        let shift = dr - nb;
        let lcr = rpoly_lc(rem);
        let scaled_rem = rpoly_mul_coeff(rem, lcb);
        let sub_cs = [];
        let s = 0;
        while s < shift {
            push(sub_cs, rpoly_zero(lv - 1));
            s = s + 1;
        }
        let j = 0;
        while j < len(b["coeffs"]) {
            push(sub_cs, rpoly_mul(lcr, b["coeffs"][j]));
            j = j + 1;
        }
        rem = rpoly_sub(scaled_rem, rpoly_trim(map{ level: lv, coeffs: sub_cs }));
        e_rem = e_rem - 1;
    }
    if e_rem > 0 and (not rpoly_is_zero(rem)) {
        let factor = rpoly_pow(lcb, e_rem);
        rem = rpoly_mul_coeff(rem, factor);
    }
    return rem;
}

// Collins-Brown Subresultant PRS over D = Q[v_1..v_{lv-1}].
// Returns map{ resultant: level-(lv-1) poly, last_nonzero: level-lv poly }.
// When resultant == 0, `last_nonzero` has degree >= 1 in x_lv and equals gcd(F, G) in Frac(D)[x_lv] up to D-content!
fn rpoly_subresultant_prs(F, G) {
    let lv = rpoly_level(F);
    if rpoly_is_zero(F) or rpoly_is_zero(G) {
        return map{ resultant: rpoly_zero(lv - 1), last_nonzero: rpoly_zero(lv) };
    }
    let A = F;
    let B = G;
    let sgn = 1;
    if rpoly_deg(A) < rpoly_deg(B) {
        if (rpoly_deg(A) % 2 == 1) and (rpoly_deg(B) % 2 == 1) {
            sgn = -1;
        }
        let tmp = A;
        A = B;
        B = tmp;
    }
    if rpoly_deg(B) == 0 {
        let b0 = B["coeffs"][0];
        let res0 = rpoly_pow(b0, rpoly_deg(A));
        if sgn < 0 { res0 = rpoly_neg(res0); }
        return map{ resultant: res0, last_nonzero: B };
    }

    let g = rpoly_one(lv - 1);
    let h = rpoly_one(lv - 1);
    let st = 0;
    while rpoly_deg(B) > 0 {
        st = st + 1;
        _guard_op(st, "subresultant_prs");
        let degA = rpoly_deg(A);
        let degB = rpoly_deg(B);
        let delta = degA - degB;
        if (degA % 2 == 1) and (degB % 2 == 1) {
            sgn = 0 - sgn;
        }
        let R = rpoly_prem(A, B);
        if rpoly_is_zero(R) {
            return map{ resultant: rpoly_zero(lv - 1), last_nonzero: B };
        }
        A = B;
        let denom_coeff = rpoly_mul(g, rpoly_pow(h, delta));
        let denom_lifted = rpoly_lift_from(denom_coeff, lv);
        B = rpoly_exact_div(R, denom_lifted);
        g = rpoly_lc(A);
        if delta == 0 {
            // h unchanged
        } else if delta == 1 {
            h = g;
        } else {
            h = rpoly_exact_div(rpoly_pow(g, delta), rpoly_pow(h, delta - 1));
        }
    }

    // Now deg(B) == 0 and B != 0, while deg(A) >= 1
    let dA = rpoly_deg(A);
    let b_const = B["coeffs"][0];
    let fin = b_const;
    if dA > 1 {
        fin = rpoly_exact_div(rpoly_pow(b_const, dA), rpoly_pow(h, dA - 1));
    }
    if sgn < 0 { fin = rpoly_neg(fin); }
    return map{ resultant: fin, last_nonzero: B };
}

fn _rpoly_collect_rats(p, out_rats) {
    let lv = rpoly_level(p);
    if lv == 0 {
        if not EX.rat_is_zero(p) { push(out_rats, p); }
        return;
    }
    let i = 0;
    while i < len(p["coeffs"]) {
        _rpoly_collect_rats(p["coeffs"][i], out_rats);
        i = i + 1;
    }
}

fn _rpoly_lead_rat_sign(p) {
    let cur = p;
    while rpoly_level(cur) > 0 {
        if len(cur["coeffs"]) == 0 { return 0; }
        cur = cur["coeffs"][len(cur["coeffs"]) - 1];
    }
    return _b_sign(cur["num"]);
}

// Primitive integer-content & positive-leading-term normalization over Q[v_1..v_k]
fn rpoly_primitive_norm(p) {
    if rpoly_is_zero(p) { return p; }
    let rats = [];
    _rpoly_collect_rats(p, rats);
    if len(rats) == 0 { return p; }
    let lcm_den = _B1;
    let gcd_num = _B0;
    let i = 0;
    while i < len(rats) {
        lcm_den = _b_lcm(lcm_den, rats[i]["den"]);
        i = i + 1;
    }
    i = 0;
    while i < len(rats) {
        let scaled_n = _b_abs(rats[i]["num"] * (lcm_den / rats[i]["den"]));
        gcd_num = _b_gcd(gcd_num, scaled_n);
        i = i + 1;
    }
    if gcd_num == _B0 { return p; }
    let scale = EX.rat(lcm_den, gcd_num);
    if _rpoly_lead_rat_sign(p) < 0 {
        scale = EX.rat_neg(scale);
    }
    return rpoly_scale_rat(p, scale);
}

fn rpoly_key(p) {
    let lv = rpoly_level(p);
    if lv == 0 { return EX.rat_to_str(p); }
    if len(p["coeffs"]) == 0 { return "0@" + str(lv); }
    let parts = [];
    let i = 0;
    while i < len(p["coeffs"]) {
        push(parts, rpoly_key(p["coeffs"][i]));
        i = i + 1;
    }
    return str(lv) + ":[" + _join_strs(parts, ",") + "]";
}

// Convert algebraic AST expression into RPoly over ordered `vars` [v_1, ..., v_n].
fn alg_expr_to_rpoly(expr, vars) {
    let lv = len(vars);
    let k = expr["kind"];
    if k == "num" {
        return rpoly_const_rat(lv, expr["rat"]);
    }
    if k == "var" {
        let idx = _arr_index_of_str(vars, expr["name"]);
        if idx < 0 {
            throw "alg_expr_to_rpoly: unbound variable '" + expr["name"] + "'";
        }
        return rpoly_var(lv, idx + 1);
    }
    if k == "neg" {
        return rpoly_neg(alg_expr_to_rpoly(expr["arg"], vars));
    }
    if k == "+" {
        return rpoly_add(alg_expr_to_rpoly(expr["left"], vars), alg_expr_to_rpoly(expr["right"], vars));
    }
    if k == "-" {
        return rpoly_sub(alg_expr_to_rpoly(expr["left"], vars), alg_expr_to_rpoly(expr["right"], vars));
    }
    if k == "*" {
        return rpoly_mul(alg_expr_to_rpoly(expr["left"], vars), alg_expr_to_rpoly(expr["right"], vars));
    }
    if k == "/" {
        let num_p = alg_expr_to_rpoly(expr["left"], vars);
        let den_p = alg_expr_to_rpoly(expr["right"], vars);
        if not rpoly_is_const_rat(den_p) {
            throw "Tarski-Seidenberg CAD requires polynomial denominators to be non-zero constants";
        }
        let cr = rpoly_get_const_rat(den_p);
        if EX.rat_is_zero(cr) {
            throw "alg_expr_to_rpoly: division by zero constant";
        }
        return rpoly_scale_rat(num_p, EX.rat_div(EX.rat(1, 1), cr));
    }
    if k == "pow" {
        return rpoly_pow(alg_expr_to_rpoly(expr["base"], vars), expr["exp"]);
    }
    throw "alg_expr_to_rpoly: unsupported operator '" + k + "' in polynomial atom";
}

// Flatten RPoly into sparse monomial list [{ coeff: rat, exps: [e_1..e_n] }] for formatting & evaluation
fn _rpoly_to_monomials_rec(p, prefix_exps, out_terms) {
    let lv = rpoly_level(p);
    if lv == 0 {
        if not EX.rat_is_zero(p) {
            let rev_exps = [];
            let i = len(prefix_exps) - 1;
            while i >= 0 {
                push(rev_exps, prefix_exps[i]);
                i = i - 1;
            }
            push(out_terms, map{ coeff: p, exps: rev_exps });
        }
        return;
    }
    let d = len(p["coeffs"]) - 1;
    while d >= 0 {
        let c = p["coeffs"][d];
        if not rpoly_is_zero(c) {
            let nxt = [];
            let j = 0;
            while j < len(prefix_exps) {
                push(nxt, prefix_exps[j]);
                j = j + 1;
            }
            push(nxt, d);
            _rpoly_to_monomials_rec(c, nxt, out_terms);
        }
        d = d - 1;
    }
}

fn rpoly_to_str(p, vars) {
    let terms = [];
    _rpoly_to_monomials_rec(p, [], terms);
    if len(terms) == 0 { return "0"; }
    // Sort terms by total degree descending, then lexicographically by variable exponents
    let i = 1;
    while i < len(terms) {
        let key = terms[i];
        let j = i - 1;
        while j >= 0 {
            let td_j = 0;
            let td_k = 0;
            let u = 0;
            while u < len(vars) {
                td_j = td_j + terms[j]["exps"][u];
                td_k = td_k + key["exps"][u];
                u = u + 1;
            }
            let swap_needed = false;
            if td_j < td_k {
                swap_needed = true;
            } else if td_j == td_k {
                u = 0;
                while u < len(vars) {
                    if terms[j]["exps"][u] < key["exps"][u] { swap_needed = true; break; }
                    if terms[j]["exps"][u] > key["exps"][u] { break; }
                    u = u + 1;
                }
            }
            if not swap_needed { break; }
            terms[j + 1] = terms[j];
            j = j - 1;
        }
        terms[j + 1] = key;
        i = i + 1;
    }

    let out = "";
    i = 0;
    while i < len(terms) {
        let tm = terms[i];
        let c = tm["coeff"];
        let neg = c["num"] < _B0;
        let ac = EX.rat_abs(c);
        let var_parts = [];
        let u = 0;
        while u < len(vars) {
            let eu = tm["exps"][u];
            if eu == 1 {
                push(var_parts, vars[u]);
            } else if eu > 1 {
                push(var_parts, vars[u] + "^" + str(eu));
            }
            u = u + 1;
        }
        let vstr = _join_strs(var_parts, "*");
        let cstr = EX.rat_to_str(ac);
        let body = "";
        if len(vstr) == 0 {
            body = cstr;
        } else if ac["num"] == _B1 and ac["den"] == _B1 {
            body = vstr;
        } else {
            body = cstr + "*" + vstr;
        }

        if i == 0 {
            if neg { out = "-" + body; }
            else { out = body; }
        } else {
            if neg { out = out + " - " + body; }
            else { out = out + " + " + body; }
        }
        i = i + 1;
    }
    return out;
}

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE 1: TARSKI-SEIDENBERG COMPLETE QUANTIFIER ELIMINATION & CAD OVER R
// ══════════════════════════════════════════════════════════════════════════════

// Exact Rational Interval [lo, hi] with lo, hi : EX.rat
fn _ri_new(lo, hi) {
    if EX.rat_cmp(lo, hi) > 0 { return map{ lo: hi, hi: lo }; }
    return map{ lo: lo, hi: hi };
}

fn _ri_point(r) {
    return map{ lo: r, hi: r };
}

fn _ri_add(a, b) {
    return map{ lo: EX.rat_add(a["lo"], b["lo"]), hi: EX.rat_add(a["hi"], b["hi"]) };
}

fn _ri_sub(a, b) {
    return map{ lo: EX.rat_sub(a["lo"], b["hi"]), hi: EX.rat_sub(a["hi"], b["lo"]) };
}

fn _ri_neg(a) {
    return map{ lo: EX.rat_neg(a["hi"]), hi: EX.rat_neg(a["lo"]) };
}

fn _ri_mul(a, b) {
    let p1 = EX.rat_mul(a["lo"], b["lo"]);
    let p2 = EX.rat_mul(a["lo"], b["hi"]);
    let p3 = EX.rat_mul(a["hi"], b["lo"]);
    let p4 = EX.rat_mul(a["hi"], b["hi"]);
    let mn = p1;
    let mx = p1;
    if EX.rat_cmp(p2, mn) < 0 { mn = p2; }
    if EX.rat_cmp(p3, mn) < 0 { mn = p3; }
    if EX.rat_cmp(p4, mn) < 0 { mn = p4; }
    if EX.rat_cmp(p2, mx) > 0 { mx = p2; }
    if EX.rat_cmp(p3, mx) > 0 { mx = p3; }
    if EX.rat_cmp(p4, mx) > 0 { mx = p4; }
    return map{ lo: mn, hi: mx };
}

fn _ri_sign_strict(iv) {
    // Returns +1 if iv.lo > 0, -1 if iv.hi < 0, else 0 (uncertain / contains 0)
    if iv["lo"]["num"] > _B0 { return 1; }
    if iv["hi"]["num"] < _B0 { return -1; }
    return 0;
}

// ── Parameterized Univariate Polynomials `fpoly` over Any Ordered Field `F` ───
// Representation: ascending array `[c_0, ..., c_d]` of F-elements, `[]` for zero.

fn _fp_trim(F, p) {
    let hi = len(p) - 1;
    while hi >= 0 and F["is_zero"](p[hi]) {
        hi = hi - 1;
    }
    if hi < 0 { return []; }
    let out = [];
    let i = 0;
    while i <= hi {
        push(out, p[i]);
        i = i + 1;
    }
    return out;
}

fn _fp_deg(p) {
    return len(p) - 1;
}

fn _fp_add(F, a, b) {
    let na = len(a);
    let nb = len(b);
    let mx = na;
    if nb > mx { mx = nb; }
    let out = [];
    let i = 0;
    while i < mx {
        let va = F["zero"];
        let vb = F["zero"];
        if i < na { va = a[i]; }
        if i < nb { vb = b[i]; }
        push(out, F["add"](va, vb));
        i = i + 1;
    }
    return _fp_trim(F, out);
}

fn _fp_sub(F, a, b) {
    let na = len(a);
    let nb = len(b);
    let mx = na;
    if nb > mx { mx = nb; }
    let out = [];
    let i = 0;
    while i < mx {
        let va = F["zero"];
        let vb = F["zero"];
        if i < na { va = a[i]; }
        if i < nb { vb = b[i]; }
        push(out, F["sub"](va, vb));
        i = i + 1;
    }
    return _fp_trim(F, out);
}

fn _fp_scale(F, a, s) {
    if len(a) == 0 or F["is_zero"](s) { return []; }
    let out = [];
    let i = 0;
    while i < len(a) {
        push(out, F["mul"](a[i], s));
        i = i + 1;
    }
    return _fp_trim(F, out);
}

fn _fp_monic(F, a) {
    let pa = _fp_trim(F, a);
    if len(pa) == 0 { return []; }
    let inv_lc = F["div"](F["one"], pa[len(pa) - 1]);
    return _fp_scale(F, pa, inv_lc);
}

fn _fp_mul(F, a, b) {
    if len(a) == 0 or len(b) == 0 { return []; }
    let na = len(a);
    let nb = len(b);
    let out = [];
    let k = 0;
    while k < na + nb - 1 {
        push(out, F["zero"]);
        k = k + 1;
    }
    let i = 0;
    while i < na {
        if not F["is_zero"](a[i]) {
            let j = 0;
            while j < nb {
                if not F["is_zero"](b[j]) {
                    out[i + j] = F["add"](out[i + j], F["mul"](a[i], b[j]));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return _fp_trim(F, out);
}

fn _fp_divmod(F, a, b) {
    let pa = _fp_trim(F, a);
    let pb = _fp_trim(F, b);
    if len(pb) == 0 { throw "_fp_divmod: division by zero polynomial"; }
    let db = len(pb) - 1;
    if len(pa) - 1 < db {
        return map{ quot: [], rem: pa };
    }
    let q_len = len(pa) - db;
    let q = [];
    let i = 0;
    while i < q_len {
        push(q, F["zero"]);
        i = i + 1;
    }
    let rem = pa;
    let lcb = pb[db];
    let st = 0;
    while len(rem) > 0 and (len(rem) - 1) >= db {
        st = st + 1;
        _guard_op(st, "_fp_divmod");
        let dr = len(rem) - 1;
        let shift = dr - db;
        let coef = F["div"](rem[dr], lcb);
        q[shift] = F["add"](q[shift], coef);
        let sub_p = [];
        let s = 0;
        while s < shift {
            push(sub_p, F["zero"]);
            s = s + 1;
        }
        let j = 0;
        while j <= db {
            push(sub_p, F["mul"](coef, pb[j]));
            j = j + 1;
        }
        rem = _fp_sub(F, rem, sub_p);
    }
    return map{ quot: _fp_trim(F, q), rem: rem };
}

fn _fp_gcd(F, a, b) {
    let x = _fp_trim(F, a);
    let y = _fp_trim(F, b);
    let st = 0;
    while len(y) > 0 {
        st = st + 1;
        _guard_op(st, "_fp_gcd");
        let r = _fp_divmod(F, x, y)["rem"];
        x = y;
        y = r;
    }
    return _fp_monic(F, x);
}

fn _fp_egcd(F, a, b) {
    let old_r = _fp_trim(F, a);
    let r = _fp_trim(F, b);
    let old_s = [F["one"]];
    let s = [];
    let old_t = [];
    let t = [F["one"]];
    let st = 0;
    while len(r) > 0 {
        st = st + 1;
        _guard_op(st, "_fp_egcd");
        let dm = _fp_divmod(F, old_r, r);
        let q = dm["quot"];
        old_r = r;
        r = dm["rem"];
        let nxt_s = _fp_sub(F, old_s, _fp_mul(F, q, s));
        old_s = s;
        s = nxt_s;
        let nxt_t = _fp_sub(F, old_t, _fp_mul(F, q, t));
        old_t = t;
        t = nxt_t;
    }
    if len(old_r) > 0 {
        let inv_c = F["div"](F["one"], old_r[len(old_r) - 1]);
        old_r = _fp_scale(F, old_r, inv_c);
        old_s = _fp_scale(F, old_s, inv_c);
        old_t = _fp_scale(F, old_t, inv_c);
    }
    return map{ g: old_r, s: old_s, t: old_t };
}

fn _fp_deriv(F, p) {
    if len(p) <= 1 { return []; }
    let out = [];
    let i = 1;
    while i < len(p) {
        push(out, F["mul"](p[i], F["from_rat"](EX.rat(i, 1))));
        i = i + 1;
    }
    return _fp_trim(F, out);
}

fn _fp_sqfree(F, p) {
    let pa = _fp_monic(F, p);
    if len(pa) <= 1 { return pa; }
    let g = _fp_gcd(F, pa, _fp_deriv(F, pa));
    if len(g) <= 1 { return pa; }
    return _fp_monic(F, _fp_divmod(F, pa, g)["quot"]);
}

fn _fp_eval_at_rat(F, p, r_val) {
    if len(p) == 0 { return F["zero"]; }
    let rx = F["from_rat"](r_val);
    let acc = F["zero"];
    let i = len(p) - 1;
    while i >= 0 {
        acc = F["add"](F["mul"](acc, rx), p[i]);
        i = i - 1;
    }
    return acc;
}

fn _fp_eval_ival(F, p, x_iv) {
    if len(p) == 0 { return _ri_point(EX.rat(0, 1)); }
    let acc = _ri_point(EX.rat(0, 1));
    let i = len(p) - 1;
    while i >= 0 {
        let c_iv = F["to_ival"](p[i]);
        acc = _ri_add(_ri_mul(acc, x_iv), c_iv);
        i = i - 1;
    }
    return acc;
}

fn _fp_sturm_chain(F, sqf_monic_p) {
    if len(sqf_monic_p) <= 1 { return [sqf_monic_p]; }
    let p1 = _fp_deriv(F, sqf_monic_p);
    let l1_sgn = F["sgn"](p1[len(p1) - 1]);
    let l1_abs = p1[len(p1) - 1];
    if l1_sgn < 0 { l1_abs = F["neg"](l1_abs); }
    p1 = _fp_scale(F, p1, F["div"](F["one"], l1_abs));
    let chain = [sqf_monic_p, p1];
    let st = 0;
    while len(chain[len(chain) - 1]) > 1 {
        st = st + 1;
        _guard_op(st, "_fp_sturm_chain");
        let n = len(chain);
        let rem = _fp_divmod(F, chain[n - 2], chain[n - 1])["rem"];
        if len(rem) == 0 { return chain; }
        let lc = rem[len(rem) - 1];
        let lc_abs = lc;
        if F["sgn"](lc) < 0 { lc_abs = F["neg"](lc); }
        let neg_scale = F["neg"](F["div"](F["one"], lc_abs));
        push(chain, _fp_scale(F, rem, neg_scale));
    }
    return chain;
}

fn _fp_sturm_variations_at_rat(F, chain, x_rat) {
    let prev = 0;
    let changes = 0;
    let i = 0;
    while i < len(chain) {
        let v = _fp_eval_at_rat(F, chain[i], x_rat);
        let sg = F["sgn"](v);
        if sg != 0 {
            if prev != 0 and sg != prev {
                changes = changes + 1;
            }
            prev = sg;
        }
        i = i + 1;
    }
    return changes;
}

fn _fp_sturm_count_half_open(F, sqf_p, lo_rat, hi_rat) {
    if EX.rat_cmp(lo_rat, hi_rat) >= 0 { return 0; }
    if len(sqf_p) <= 1 { return 0; }
    let mp = _fp_monic(F, sqf_p);
    let ch = _fp_sturm_chain(F, mp);
    return _fp_sturm_variations_at_rat(F, ch, lo_rat) - _fp_sturm_variations_at_rat(F, ch, hi_rat);
}

fn _fp_cauchy_bound_rat(F, monic_p) {
    // Upper bound on |root|: 1 + max_{0<=i<d} |c_i|_upper
    let max_b = _B1;
    let i = 0;
    while i < len(monic_p) - 1 {
        let iv = F["to_ival"](monic_p[i]);
        let a1 = EX.rat_ceil(EX.rat_abs(iv["lo"]));
        let a2 = EX.rat_ceil(EX.rat_abs(iv["hi"]));
        let m = a1;
        if a2 > m { m = a2; }
        if m + _B1 > max_b { max_b = m + _B1; }
        i = i + 1;
    }
    let pw = _B2;
    while pw <= max_b {
        pw = pw * _B2;
    }
    return EX.rat(pw, _B1);
}

// Ordered Field 0: Exact Rationals Q
fn _qf_make_Q() {
    let F = map{};
    F["level"] = 0;
    F["zero"] = EX.rat(0, 1);
    F["one"] = EX.rat(1, 1);
    F["from_rat"] = fn(r) { return r; };
    F["is_zero"] = fn(a) { return EX.rat_is_zero(a); };
    F["add"] = fn(a, b) { return EX.rat_add(a, b); };
    F["sub"] = fn(a, b) { return EX.rat_sub(a, b); };
    F["neg"] = fn(a) { return EX.rat_neg(a); };
    F["mul"] = fn(a, b) { return EX.rat_mul(a, b); };
    F["div"] = fn(a, b) { return EX.rat_div(a, b); };
    F["sgn"] = fn(a) { return _b_sign(a["num"]); };
    F["to_ival"] = fn(a) { return _ri_point(a); };
    F["refine"] = fn() { return; };
    F["to_float"] = fn(a) { return EX.rat_to_float(a); };
    return F;
}

// Ordered Field Extension K = BaseF[alpha] / (M(alpha)) with D5 Dynamic Splitting
// where `alpha` is the unique root of square-free monic `M` inside open rational interval `(lo, hi)`
// with `M(lo) * M(hi) < 0`.
fn _qf_make_ext(BaseF, sqf_monic_M, lo_rat, hi_rat) {
    let s_lo = BaseF["sgn"](_fp_eval_at_rat(BaseF, sqf_monic_M, lo_rat));
    let s_hi = BaseF["sgn"](_fp_eval_at_rat(BaseF, sqf_monic_M, hi_rat));
    let state = map{
        M: _fp_monic(BaseF, sqf_monic_M),
        lo: lo_rat,
        hi: hi_rat,
        s_lo: s_lo,
        s_hi: s_hi
    };

    let refine_once = fn() {
        BaseF["refine"]();
        let mid = EX.rat_mul(EX.rat_add(state["lo"], state["hi"]), EX.rat(1, 2));
        let mv = _fp_eval_at_rat(BaseF, state["M"], mid);
        let sm = BaseF["sgn"](mv);
        if sm == 0 {
            // Exact rational root discovered dynamically! Collapse M to (t - mid)
            state["M"] = [BaseF["neg"](BaseF["from_rat"](mid)), BaseF["one"]];
            state["lo"] = mid;
            state["hi"] = mid;
            state["s_lo"] = 0;
            state["s_hi"] = 0;
            return;
        }
        if sm == state["s_lo"] {
            state["lo"] = mid;
        } else {
            state["hi"] = mid;
        }
    };

    let reduce_mod = fn(poly_elem) {
        let tr = _fp_trim(BaseF, poly_elem);
        if len(tr) == 0 { return []; }
        if len(tr) < len(state["M"]) { return tr; }
        return _fp_divmod(BaseF, tr, state["M"])["rem"];
    };

    let is_zero_fn = fn(elem) {
        let r = reduce_mod(elem);
        if len(r) == 0 { return true; }
        // D5 check: could gcd(M, r) contain alpha?
        let g = _fp_gcd(BaseF, state["M"], r);
        if len(g) <= 1 { return false; }
        if EX.rat_eq(state["lo"], state["hi"]) {
            let v_pt = _fp_eval_at_rat(BaseF, g, state["lo"]);
            return BaseF["is_zero"](v_pt);
        }
        let cnt = _fp_sturm_count_half_open(BaseF, g, state["lo"], state["hi"]);
        if cnt >= 1 {
            // Dynamic split: alpha is a root of g!
            state["M"] = g;
            state["s_lo"] = BaseF["sgn"](_fp_eval_at_rat(BaseF, g, state["lo"]));
            state["s_hi"] = BaseF["sgn"](_fp_eval_at_rat(BaseF, g, state["hi"]));
            return true;
        } else {
            // Dynamic split: alpha is NOT a root of g, replace M by M / g!
            let qm = _fp_monic(BaseF, _fp_divmod(BaseF, state["M"], g)["quot"]);
            state["M"] = qm;
            state["s_lo"] = BaseF["sgn"](_fp_eval_at_rat(BaseF, qm, state["lo"]));
            state["s_hi"] = BaseF["sgn"](_fp_eval_at_rat(BaseF, qm, state["hi"]));
            return false;
        }
    };

    let inv_fn = fn(elem) {
        if is_zero_fn(elem) {
            throw "_qf_make_ext: division by zero algebraic element";
        }
        let r = reduce_mod(elem);
        let eg = _fp_egcd(BaseF, r, state["M"]);
        return reduce_mod(eg["s"]);
    };

    let to_ival_fn = fn(elem) {
        let r = reduce_mod(elem);
        let alpha_iv = _ri_new(state["lo"], state["hi"]);
        return _fp_eval_ival(BaseF, r, alpha_iv);
    };

    let sgn_fn = fn(elem) {
        if is_zero_fn(elem) { return 0; }
        // Guaranteed non-zero! Bisect (lo, hi) until exact rational interval excludes 0.
        let guard = 0;
        while guard < 256 {
            guard = guard + 1;
            let iv = to_ival_fn(elem);
            let sg = _ri_sign_strict(iv);
            if sg != 0 { return sg; }
            refine_once();
            if EX.rat_eq(state["lo"], state["hi"]) {
                let exact_v = _fp_eval_at_rat(BaseF, reduce_mod(elem), state["lo"]);
                return BaseF["sgn"](exact_v);
            }
        }
        let iv_last = to_ival_fn(elem);
        let mid_r = EX.rat_mul(EX.rat_add(iv_last["lo"], iv_last["hi"]), EX.rat(1, 2));
        return _b_sign(mid_r["num"]);
    };

    let to_float_fn = fn(elem) {
        let guard = 0;
        while guard < 52 and EX.rat_to_float(EX.rat_sub(state["hi"], state["lo"])) > 1e-14 {
            refine_once();
            guard = guard + 1;
        }
        let iv = to_ival_fn(elem);
        return 0.5 * (EX.rat_to_float(iv["lo"]) + EX.rat_to_float(iv["hi"]));
    };

    let K = map{};
    K["level"] = BaseF["level"] + 1;
    K["state"] = state;
    K["zero"] = [];
    K["one"] = [BaseF["one"]];
    K["alpha"] = [BaseF["zero"], BaseF["one"]];
    K["from_base"] = fn(b_val) {
        if BaseF["is_zero"](b_val) { return []; }
        return [b_val];
    };
    K["from_rat"] = fn(r_val) {
        if EX.rat_is_zero(r_val) { return []; }
        return [BaseF["from_rat"](r_val)];
    };
    K["is_zero"] = is_zero_fn;
    K["add"] = fn(a, b) { return reduce_mod(_fp_add(BaseF, a, b)); };
    K["sub"] = fn(a, b) { return reduce_mod(_fp_sub(BaseF, a, b)); };
    K["neg"] = fn(a) { return _fp_scale(BaseF, a, BaseF["neg"](BaseF["one"])); };
    K["mul"] = fn(a, b) { return reduce_mod(_fp_mul(BaseF, a, b)); };
    K["div"] = fn(a, b) { return reduce_mod(_fp_mul(BaseF, a, inv_fn(b))); };
    K["sgn"] = sgn_fn;
    K["to_ival"] = to_ival_fn;
    K["refine"] = refine_once;
    K["to_float"] = to_float_fn;
    return K;
}

// Pick clean exact rational inside open interval (lo_r, hi_r) with lo_r < hi_r
fn _pick_simple_rat_between(lo_r, hi_r) {
    // Check 0 first
    let z = EX.rat(0, 1);
    if EX.rat_cmp(lo_r, z) < 0 and EX.rat_cmp(z, hi_r) < 0 {
        return z;
    }
    // Check if an exact integer strictly inside (lo_r, hi_r) exists
    let min_int = EX.rat_floor(lo_r) + _B1;
    let max_int = EX.rat_ceil(hi_r) - _B1;
    if min_int <= max_int {
        // Pick integer closest to 0 inside [min_int, max_int]
        if min_int <= _B0 and max_int >= _B0 {
            return EX.rat(0, 1);
        }
        if min_int > _B0 {
            return EX.rat(min_int, _B1);
        }
        return EX.rat(max_int, _B1);
    }
    // Otherwise dyadic / exact midpoint
    return EX.rat_mul(EX.rat_add(lo_r, hi_r), EX.rat(1, 2));
}

fn _pick_simple_rat_below(hi_r) {
    let z = EX.rat(0, 1);
    if EX.rat_cmp(z, hi_r) < 0 {
        // Prefer -1 if hi_r <= 0, or 0 if hi_r > 0
        return z;
    }
    let k = EX.rat_ceil(hi_r) - _B1;
    return EX.rat(k, _B1);
}

fn _pick_simple_rat_above(lo_r) {
    let z = EX.rat(0, 1);
    if EX.rat_cmp(lo_r, z) < 0 {
        return z;
    }
    let k = EX.rat_floor(lo_r) + _B1;
    return EX.rat(k, _B1);
}

// Isolate ALL distinct real roots of square-free monic `sqf_p` over ordered field `F`.
// Returns sorted ascending array of root descriptors:
//   either `{ is_rat: true, rat: r, lo: r, hi: r, poly: [ -r, 1 ] }`
//   or     `{ is_rat: false, lo: lo_r, hi: hi_r, poly: factor_p }` with `lo_r < hi_r`
//   and strictly disjoint closed intervals (`root[i].hi < root[i+1].lo`)!
fn _isolate_roots_over_field(F, sqf_p) {
    let p_cur = _fp_sqfree(F, sqf_p);
    if len(p_cur) <= 1 { return []; }

    let roots = [];

    // Fast exact rational root extraction when F is Q (level 0)
    if F["level"] == 0 {
        let rr = EX.poly_rational_roots(p_cur);
        let i = 0;
        while i < len(rr["roots"]) {
            let rt = rr["roots"][i]["root"];
            push(roots, map{
                is_rat: true,
                rat: rt,
                lo: rt,
                hi: rt,
                poly: [EX.rat_neg(rt), EX.rat(1, 1)]
            });
            i = i + 1;
        }
        p_cur = _fp_monic(F, rr["quotient"]);
    }

    if len(p_cur) > 1 {
        let ch = _fp_sturm_chain(F, p_cur);
        let B = _fp_cauchy_bound_rat(F, p_cur);
        let neg_B = EX.rat_neg(B);
        let vlo = _fp_sturm_variations_at_rat(F, ch, neg_B);
        let vhi = _fp_sturm_variations_at_rat(F, ch, B);
        if vlo - vhi > 0 {
            let stack = [map{ lo: neg_B, hi: B, vlo: vlo, vhi: vhi }];
            let st = 0;
            while len(stack) > 0 {
                st = st + 1;
                _guard_op(st, "_isolate_roots_over_field");
                let seg = pop(stack);
                let cnt = seg["vlo"] - seg["vhi"];
                if cnt == 1 {
                    // Check if hi is an exact rational root of p_cur
                    let v_hi = _fp_eval_at_rat(F, p_cur, seg["hi"]);
                    if F["is_zero"](v_hi) {
                        let hr = seg["hi"];
                        push(roots, map{
                            is_rat: true,
                            rat: hr,
                            lo: hr,
                            hi: hr,
                            poly: [F["neg"](F["from_rat"](hr)), F["one"]]
                        });
                    } else {
                        // Ensure strict sign change on open interval (lo, hi)
                        let lr = seg["lo"];
                        let hr = seg["hi"];
                        while F["is_zero"](_fp_eval_at_rat(F, p_cur, lr)) {
                            lr = EX.rat_mul(EX.rat_add(lr, hr), EX.rat(1, 2));
                        }
                        // Pre-tighten to width <= 1/8 for clean sample separation
                        let s_l = F["sgn"](_fp_eval_at_rat(F, p_cur, lr));
                        let pre = 0;
                        let found_exact_mid = false;
                        while pre < 14 and EX.rat_cmp(EX.rat_sub(hr, lr), EX.rat(1, 8)) > 0 {
                            let mid = EX.rat_mul(EX.rat_add(lr, hr), EX.rat(1, 2));
                            let vm = _fp_eval_at_rat(F, p_cur, mid);
                            let sm = F["sgn"](vm);
                            if sm == 0 {
                                push(roots, map{
                                    is_rat: true,
                                    rat: mid,
                                    lo: mid,
                                    hi: mid,
                                    poly: [F["neg"](F["from_rat"](mid)), F["one"]]
                                });
                                found_exact_mid = true;
                                break;
                            }
                            if sm == s_l { lr = mid; }
                            else { hr = mid; }
                            pre = pre + 1;
                        }
                        if not found_exact_mid {
                            push(roots, map{
                                is_rat: false,
                                rat: nil,
                                lo: lr,
                                hi: hr,
                                poly: p_cur
                            });
                        }
                    }
                } else if cnt > 1 {
                    let mid = EX.rat_mul(EX.rat_add(seg["lo"], seg["hi"]), EX.rat(1, 2));
                    let vmid = _fp_sturm_variations_at_rat(F, ch, mid);
                    if vmid - seg["vhi"] > 0 {
                        push(stack, map{ lo: mid, hi: seg["hi"], vlo: vmid, vhi: seg["vhi"] });
                    }
                    if seg["vlo"] - vmid > 0 {
                        push(stack, map{ lo: seg["lo"], hi: mid, vlo: seg["vlo"], vhi: vmid });
                    }
                }
            }
        }
    }

    // Sort roots ascending by midpoint / rational bounds and enforce strict separation `roots[i].hi < roots[i+1].lo`
    let i = 1;
    while i < len(roots) {
        let key = roots[i];
        let km = EX.rat_mul(EX.rat_add(key["lo"], key["hi"]), EX.rat(1, 2));
        let j = i - 1;
        while j >= 0 {
            let jm = EX.rat_mul(EX.rat_add(roots[j]["lo"], roots[j]["hi"]), EX.rat(1, 2));
            if EX.rat_cmp(jm, km) <= 0 { break; }
            roots[j + 1] = roots[j];
            j = j - 1;
        }
        roots[j + 1] = key;
        i = i + 1;
    }

    // Enforce strict interval separation between adjacent roots
    i = 0;
    while i + 1 < len(roots) {
        let guard = 0;
        while EX.rat_cmp(roots[i]["hi"], roots[i + 1]["lo"]) >= 0 and guard < 128 {
            guard = guard + 1;
            if not roots[i]["is_rat"] {
                let p_i = roots[i]["poly"];
                let mid = EX.rat_mul(EX.rat_add(roots[i]["lo"], roots[i]["hi"]), EX.rat(1, 2));
                let sl = F["sgn"](_fp_eval_at_rat(F, p_i, roots[i]["lo"]));
                let sm = F["sgn"](_fp_eval_at_rat(F, p_i, mid));
                if sm == 0 {
                    roots[i]["is_rat"] = true;
                    roots[i]["rat"] = mid;
                    roots[i]["lo"] = mid;
                    roots[i]["hi"] = mid;
                } else if sm == sl {
                    roots[i]["lo"] = mid;
                } else {
                    roots[i]["hi"] = mid;
                }
            }
            if EX.rat_cmp(roots[i]["hi"], roots[i + 1]["lo"]) >= 0 and (not roots[i + 1]["is_rat"]) {
                let p_j = roots[i + 1]["poly"];
                let mid2 = EX.rat_mul(EX.rat_add(roots[i + 1]["lo"], roots[i + 1]["hi"]), EX.rat(1, 2));
                let sl2 = F["sgn"](_fp_eval_at_rat(F, p_j, roots[i + 1]["lo"]));
                let sm2 = F["sgn"](_fp_eval_at_rat(F, p_j, mid2));
                if sm2 == 0 {
                    roots[i + 1]["is_rat"] = true;
                    roots[i + 1]["rat"] = mid2;
                    roots[i + 1]["lo"] = mid2;
                    roots[i + 1]["hi"] = mid2;
                } else if sm2 == sl2 {
                    roots[i + 1]["lo"] = mid2;
                } else {
                    roots[i + 1]["hi"] = mid2;
                }
            }
        }
        i = i + 1;
    }

    return roots;
}

// Evaluate an RPoly `p` (level `k`) at prefix coordinates `coords[0..k-2]` in field `F`,
// producing a univariate `fpoly` over `F` in the k-th variable (or an `F`-element if `rpoly_level(p) < k`).
fn _rpoly_eval_full_in_field(F, p, coords) {
    let lv = rpoly_level(p);
    if lv == 0 {
        return F["from_rat"](p);
    }
    let cs = p["coeffs"];
    if len(cs) == 0 { return F["zero"]; }
    let x_val = coords[lv - 1];
    let acc = F["zero"];
    let i = len(cs) - 1;
    while i >= 0 {
        let c_val = _rpoly_eval_full_in_field(F, cs[i], coords);
        acc = F["add"](F["mul"](acc, x_val), c_val);
        i = i - 1;
    }
    return acc;
}

fn _rpoly_specialize_prefix_to_fpoly(F, p_level_k, prefix_coords) {
    // p_level_k has level k >= 1; prefix_coords has k - 1 elements in F
    if rpoly_is_zero(p_level_k) { return []; }
    let cs = p_level_k["coeffs"];
    let out = [];
    let i = 0;
    while i < len(cs) {
        push(out, _rpoly_eval_full_in_field(F, cs[i], prefix_coords));
        i = i + 1;
    }
    return _fp_trim(F, out);
}

// ── Collins / McCallum Projection Operator ────────────────────────────────────

fn _add_proj_poly_norm(p, seen_map, out_list) {
    if rpoly_is_zero(p) or rpoly_is_const_rat(p) { return; }
    let lv = rpoly_level(p);
    if lv == 1 {
        // Factor univariate Q[x_1] polynomials into exact monic irreducibles!
        let q_coeffs = [];
        let i = 0;
        while i < len(p["coeffs"]) {
            push(q_coeffs, p["coeffs"][i]);
            i = i + 1;
        }
        let fac = EX.poly_factor_Q(q_coeffs);
        let j = 0;
        while j < len(fac["factors"]) {
            let fp = fac["factors"][j]["poly"];
            let rp = rpoly_primitive_norm(map{ level: 1, coeffs: fp });
            let ky = rpoly_key(rp);
            if not map_has(seen_map, ky) {
                seen_map[ky] = true;
                push(out_list, rp);
            }
            j = j + 1;
        }
        return;
    }

    // Strip any pure power of main variable x_lv^m (if c_0 == 0) into x_lv and p / x_lv^m
    let cs = p["coeffs"];
    let z_ord = 0;
    while z_ord < len(cs) and rpoly_is_zero(cs[z_ord]) {
        z_ord = z_ord + 1;
    }
    if z_ord > 0 and z_ord < len(cs) {
        let x_main = rpoly_var(lv, lv);
        let kx = rpoly_key(x_main);
        if not map_has(seen_map, kx) {
            seen_map[kx] = true;
            push(out_list, x_main);
        }
        let shifted = [];
        let u = z_ord;
        while u < len(cs) {
            push(shifted, cs[u]);
            u = u + 1;
        }
        _add_proj_poly_norm(map{ level: lv, coeffs: shifted }, seen_map, out_list);
        return;
    }

    let np = rpoly_primitive_norm(p);
    if rpoly_is_zero(np) or rpoly_is_const_rat(np) { return; }
    let k = rpoly_key(np);
    if not map_has(seen_map, k) {
        seen_map[k] = true;
        push(out_list, np);
    }
}

// Make level-k set square-free wrt x_k using Subresultant PRS last_nonzero common factors
fn _close_level_sqfree(polys_k, lv) {
    let seen = map{};
    let work = [];
    let i = 0;
    while i < len(polys_k) {
        _add_proj_poly_norm(polys_k[i], seen, work);
        i = i + 1;
    }
    if lv <= 1 { return work; }

    let idx = 0;
    let guard = 0;
    while idx < len(work) and guard < 128 {
        guard = guard + 1;
        let P = work[idx];
        if rpoly_deg(P) >= 2 {
            let dP = rpoly_deriv_main(P);
            if not rpoly_is_zero(dP) {
                let prs = rpoly_subresultant_prs(P, dP);
                if rpoly_is_zero(prs["resultant"]) and rpoly_deg(prs["last_nonzero"]) >= 1 {
                    let G = rpoly_primitive_norm(prs["last_nonzero"]);
                    _add_proj_poly_norm(G, seen, work);
                    let q_opt = rpoly_exact_div_opt(P, G);
                    if q_opt != nil {
                        _add_proj_poly_norm(q_opt, seen, work);
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return work;
}

fn _cad_project_step(polys_k, lv) {
    // Projects level `lv` (>= 2) down to level `lv - 1`
    let closed = _close_level_sqfree(polys_k, lv);
    let next_seen = map{};
    let next_list = [];

    // Separate polynomials that actually depend on x_lv (deg >= 1) vs already in Q[x_1..x_{lv-1}] (deg == 0)
    let active = [];
    let i = 0;
    while i < len(closed) {
        let P = closed[i];
        let d = rpoly_deg(P);
        if d == 0 {
            _add_proj_poly_norm(P["coeffs"][0], next_seen, next_list);
        } else if d >= 1 {
            push(active, P);
            // Collins coefficient / reducta projection until a non-zero constant coefficient is reached
            let coeff_idx = d;
            while coeff_idx >= 0 {
                let ci = P["coeffs"][coeff_idx];
                if not rpoly_is_zero(ci) {
                    if rpoly_is_const_rat(ci) {
                        break;
                    }
                    _add_proj_poly_norm(ci, next_seen, next_list);
                }
                coeff_idx = coeff_idx - 1;
            }
            // Discriminant Res_{x_lv}(P, dP/dx_lv) for deg >= 2
            if d >= 2 {
                let dP = rpoly_deriv_main(P);
                if not rpoly_is_zero(dP) {
                    let prs = rpoly_subresultant_prs(P, dP);
                    if not rpoly_is_zero(prs["resultant"]) {
                        _add_proj_poly_norm(prs["resultant"], next_seen, next_list);
                    } else if rpoly_deg(prs["last_nonzero"]) >= 1 {
                        let G = prs["last_nonzero"];
                        _add_proj_poly_norm(rpoly_lc(G), next_seen, next_list);
                        if rpoly_deg(G) >= 2 {
                            let prsG = rpoly_subresultant_prs(G, rpoly_deriv_main(G));
                            _add_proj_poly_norm(prsG["resultant"], next_seen, next_list);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    // Pairwise resultants Res_{x_lv}(P_i, P_j)
    i = 0;
    while i < len(active) {
        let j = i + 1;
        while j < len(active) {
            let prs_ij = rpoly_subresultant_prs(active[i], active[j]);
            if not rpoly_is_zero(prs_ij["resultant"]) {
                _add_proj_poly_norm(prs_ij["resultant"], next_seen, next_list);
            } else if rpoly_deg(prs_ij["last_nonzero"]) >= 1 {
                let Gij = prs_ij["last_nonzero"];
                _add_proj_poly_norm(rpoly_lc(Gij), next_seen, next_list);
                if rpoly_deg(Gij) >= 2 {
                    let prsG2 = rpoly_subresultant_prs(Gij, rpoly_deriv_main(Gij));
                    _add_proj_poly_norm(prsG2["resultant"], next_seen, next_list);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return map{ closed_current: closed, projected_next: next_list };
}

fn _collect_matrix_polys(matrix_ast, vars, seen_map, out_list) {
    let k = matrix_ast["kind"];
    if k == "bool" { return; }
    if k == "atom" {
        let p = alg_expr_to_rpoly(matrix_ast["diff"], vars);
        _add_proj_poly_norm(p, seen_map, out_list);
        return;
    }
    if k == "not" {
        _collect_matrix_polys(matrix_ast["arg"], vars, seen_map, out_list);
        return;
    }
    if k == "and" or k == "or" or k == "implies" or k == "iff" {
        _collect_matrix_polys(matrix_ast["left"], vars, seen_map, out_list);
        _collect_matrix_polys(matrix_ast["right"], vars, seen_map, out_list);
        return;
    }
    throw "CAD does not support predicate '" + k + "' over R (use presburger_decide for divides)";
}

fn _lift_coords_to_ext(K_ext, old_coords) {
    let out = [];
    let i = 0;
    while i < len(old_coords) {
        push(out, K_ext["from_base"](old_coords[i]));
        i = i + 1;
    }
    return out;
}

// Build complete CAD tree for ordered `vars = [v_1, ..., v_n]` and `level_polys` (1-indexed by level 1..n)
fn _cad_lift_recursive(level_idx, max_level, F_cur, coords_cur, sample_info_cur, level_polys, cell_counter) {
    if level_idx > max_level {
        cell_counter["leaf_count"] = cell_counter["leaf_count"] + 1;
        return map{
            kind: "leaf",
            level: max_level,
            field: F_cur,
            coords: coords_cur,
            sample_info: sample_info_cur,
            children: []
        };
    }

    // Specialize level `level_idx` polynomials at `coords_cur` into univariate fpolys over `F_cur`
    let plist = level_polys[level_idx];
    let prod_sqf = [F_cur["one"]];
    let i = 0;
    while i < len(plist) {
        let fp = _rpoly_specialize_prefix_to_fpoly(F_cur, plist[i], coords_cur);
        if len(fp) > 1 {
            let sfp = _fp_sqfree(F_cur, fp);
            if len(sfp) > 1 {
                let g = _fp_gcd(F_cur, prod_sqf, sfp);
                let new_part = sfp;
                if len(g) > 1 {
                    new_part = _fp_divmod(F_cur, sfp, g)["quot"];
                }
                prod_sqf = _fp_mul(F_cur, prod_sqf, _fp_monic(F_cur, new_part));
            }
        }
        i = i + 1;
    }

    let roots = _isolate_roots_over_field(F_cur, prod_sqf);
    let m_roots = len(roots);

    // Build 2*m_roots + 1 fiber cells: sector_0, section_0, sector_1, ..., section_{m-1}, sector_m
    let children = [];
    let r_idx = 0;
    while r_idx <= m_roots {
        // 1. Open sector cell before root `r_idx` (or after last root when r_idx == m_roots)
        let sec_rat = EX.rat(0, 1);
        if m_roots == 0 {
            sec_rat = EX.rat(0, 1);
        } else if r_idx == 0 {
            sec_rat = _pick_simple_rat_below(roots[0]["lo"]);
        } else if r_idx == m_roots {
            sec_rat = _pick_simple_rat_above(roots[m_roots - 1]["hi"]);
        } else {
            sec_rat = _pick_simple_rat_between(roots[r_idx - 1]["hi"], roots[r_idx]["lo"]);
        }

        cell_counter["total"] = cell_counter["total"] + 1;
        if cell_counter["total"] > MAX_CAD_CELLS {
            throw "MathGovernor[cad]: cylindrical cell count exceeded MAX_CAD_CELLS (" + str(MAX_CAD_CELLS) + ")";
        }

        let next_coords_sec = [];
        let c_i = 0;
        while c_i < len(coords_cur) {
            push(next_coords_sec, coords_cur[c_i]);
            c_i = c_i + 1;
        }
        push(next_coords_sec, F_cur["from_rat"](sec_rat));

        let next_info_sec = [];
        c_i = 0;
        while c_i < len(sample_info_cur) {
            push(next_info_sec, sample_info_cur[c_i]);
            c_i = c_i + 1;
        }
        push(next_info_sec, map{
            cell_type: "sector",
            is_rational: true,
            rat: sec_rat,
            approx: EX.rat_to_float(sec_rat)
        });

        let sector_node = _cad_lift_recursive(
            level_idx + 1, max_level, F_cur, next_coords_sec, next_info_sec, level_polys, cell_counter
        );
        sector_node["cell_type"] = "sector";
        sector_node["coord_info"] = next_info_sec[len(next_info_sec) - 1];
        push(children, sector_node);

        // 2. Algebraic / rational section cell AT `roots[r_idx]`
        if r_idx < m_roots {
            let rt = roots[r_idx];
            cell_counter["total"] = cell_counter["total"] + 1;
            if cell_counter["total"] > MAX_CAD_CELLS {
                throw "MathGovernor[cad]: cylindrical cell count exceeded MAX_CAD_CELLS (" + str(MAX_CAD_CELLS) + ")";
            }

            if rt["is_rat"] {
                let r_exact = rt["rat"];
                let next_coords_rt = [];
                c_i = 0;
                while c_i < len(coords_cur) {
                    push(next_coords_rt, coords_cur[c_i]);
                    c_i = c_i + 1;
                }
                push(next_coords_rt, F_cur["from_rat"](r_exact));

                let next_info_rt = [];
                c_i = 0;
                while c_i < len(sample_info_cur) {
                    push(next_info_rt, sample_info_cur[c_i]);
                    c_i = c_i + 1;
                }
                push(next_info_rt, map{
                    cell_type: "section",
                    is_rational: true,
                    rat: r_exact,
                    approx: EX.rat_to_float(r_exact)
                });

                let sec_node_rat = _cad_lift_recursive(
                    level_idx + 1, max_level, F_cur, next_coords_rt, next_info_rt, level_polys, cell_counter
                );
                sec_node_rat["cell_type"] = "section";
                sec_node_rat["coord_info"] = next_info_rt[len(next_info_rt) - 1];
                push(children, sec_node_rat);
            } else {
                // Extend ordered field F_cur -> K_ext = F_cur[alpha] / (rt.poly(alpha))
                let K_ext = _qf_make_ext(F_cur, rt["poly"], rt["lo"], rt["hi"]);
                let lifted_coords = _lift_coords_to_ext(K_ext, coords_cur);
                push(lifted_coords, K_ext["alpha"]);
                let approx_val = K_ext["to_float"](K_ext["alpha"]);

                let next_info_alg = [];
                c_i = 0;
                while c_i < len(sample_info_cur) {
                    push(next_info_alg, sample_info_cur[c_i]);
                    c_i = c_i + 1;
                }
                push(next_info_alg, map{
                    cell_type: "section",
                    is_rational: false,
                    rat: nil,
                    lo: K_ext["state"]["lo"],
                    hi: K_ext["state"]["hi"],
                    approx: approx_val
                });

                let sec_node_alg = _cad_lift_recursive(
                    level_idx + 1, max_level, K_ext, lifted_coords, next_info_alg, level_polys, cell_counter
                );
                sec_node_alg["cell_type"] = "section";
                sec_node_alg["coord_info"] = next_info_alg[len(next_info_alg) - 1];
                push(children, sec_node_alg);
            }
        }

        r_idx = r_idx + 1;
    }

    return map{
        kind: "cylinder",
        level: level_idx - 1,
        field: F_cur,
        coords: coords_cur,
        sample_info: sample_info_cur,
        children: children
    };
}

fn _collect_leaf_cells(node, vars, out_leaves) {
    if node["kind"] == "leaf" {
        let pt_map = map{};
        let exact_map = map{};
        let i = 0;
        while i < len(vars) {
            let inf = node["sample_info"][i];
            pt_map[vars[i]] = inf["approx"];
            if inf["is_rational"] {
                exact_map[vars[i]] = inf["rat"];
            } else {
                exact_map[vars[i]] = map{ kind: "algebraic_interval", lo: inf["lo"], hi: inf["hi"], approx: inf["approx"] };
            }
            i = i + 1;
        }
        push(out_leaves, map{
            sample: pt_map,
            exact: exact_map,
            sample_info: node["sample_info"],
            field: node["field"],
            coords: node["coords"]
        });
        return;
    }
    let i = 0;
    while i < len(node["children"]) {
        _collect_leaf_cells(node["children"][i], vars, out_leaves);
        i = i + 1;
    }
}

// Public CAD Cell Builder (`cad_build_cells(polys_or_formula, vars = nil)`)
fn cad_build_cells(polys_or_formula, vars = nil) {
    let init_exprs = [];
    let deduced_vars = [];
    if type(polys_or_formula) == "array" {
        let i = 0;
        while i < len(polys_or_formula) {
            let item = polys_or_formula[i];
            if type(item) == "string" {
                // Parse `expr` as `expr == 0`
                let f_tmp = parse_first_order_formula("(" + item + ") == 0");
                push(init_exprs, f_tmp["diff"]);
                _alg_expr_vars(f_tmp["diff"], [], deduced_vars);
            } else if type(item) == "map" {
                push(init_exprs, item);
                _alg_expr_vars(item, [], deduced_vars);
            }
            i = i + 1;
        }
    } else {
        let pnf = formula_to_prenex(polys_or_formula);
        let i = 0;
        while i < len(pnf["free_vars"]) {
            push(deduced_vars, pnf["free_vars"][i]);
            i = i + 1;
        }
        i = 0;
        while i < len(pnf["quantifiers"]) {
            push(deduced_vars, pnf["quantifiers"][i]["var_name"]);
            i = i + 1;
        }
        let seen_tmp = map{};
        let list_tmp = [];
        let use_vars = vars;
        if use_vars == nil { use_vars = deduced_vars; }
        if len(use_vars) > MAX_CAD_VARS {
            throw "cad_build_cells: number of variables (" + str(len(use_vars)) + ") exceeds MAX_CAD_VARS (" + str(MAX_CAD_VARS) + ")";
        }
        _collect_matrix_polys(pnf["matrix"], use_vars, seen_tmp, list_tmp);
        return _cad_build_from_rpolys(list_tmp, use_vars);
    }

    let use_vars = vars;
    if use_vars == nil { use_vars = deduced_vars; }
    if len(use_vars) > MAX_CAD_VARS {
        throw "cad_build_cells: number of variables (" + str(len(use_vars)) + ") exceeds MAX_CAD_VARS";
    }
    let seen = map{};
    let top_polys = [];
    let i = 0;
    while i < len(init_exprs) {
        _add_proj_poly_norm(alg_expr_to_rpoly(init_exprs[i], use_vars), seen, top_polys);
        i = i + 1;
    }
    return _cad_build_from_rpolys(top_polys, use_vars);
}

fn _cad_build_from_rpolys(top_polys, vars) {
    let n = len(vars);
    let level_polys = map{};
    if n == 0 {
        return map{
            vars: [],
            level_polys: level_polys,
            projection_summary: [],
            tree: map{ kind: "leaf", level: 0, field: _qf_make_Q(), coords: [], sample_info: [], children: [] },
            cells: [map{ sample: map{}, exact: map{}, sample_info: [], field: _qf_make_Q(), coords: [] }],
            cell_count: 1,
            leaf_cell_count: 1
        };
    }

    let cur_polys = _close_level_sqfree(top_polys, n);
    level_polys[n] = cur_polys;
    let lv = n;
    while lv >= 2 {
        let step = _cad_project_step(level_polys[lv], lv);
        level_polys[lv] = step["closed_current"];
        level_polys[lv - 1] = _close_level_sqfree(step["projected_next"], lv - 1);
        lv = lv - 1;
    }
    level_polys[1] = _close_level_sqfree(level_polys[1], 1);

    let proj_summary = [];
    lv = 1;
    while lv <= n {
        let p_strs = [];
        let sub_vars = [];
        let u = 0;
        while u < lv {
            push(sub_vars, vars[u]);
            u = u + 1;
        }
        let j = 0;
        while j < len(level_polys[lv]) {
            push(p_strs, rpoly_to_str(level_polys[lv][j], sub_vars));
            j = j + 1;
        }
        push(proj_summary, map{
            level: lv,
            variable: vars[lv - 1],
            polynomial_count: len(level_polys[lv]),
            polynomials: p_strs
        });
        lv = lv + 1;
    }

    let counter = map{ total: 0, leaf_count: 0 };
    let F0 = _qf_make_Q();
    let tree = _cad_lift_recursive(1, n, F0, [], [], level_polys, counter);
    let leaves = [];
    _collect_leaf_cells(tree, vars, leaves);

    return map{
        vars: vars,
        level_polys: level_polys,
        projection_summary: proj_summary,
        tree: tree,
        cells: leaves,
        cell_count: counter["total"],
        leaf_cell_count: len(leaves)
    };
}

// ── Exact Matrix Evaluation & Bottom-Up Quantifier Evaluation over CAD Tree ───

fn _eval_matrix_on_cell(matrix_ast, vars, F_cell, coords_cell) {
    let k = matrix_ast["kind"];
    if k == "bool" { return matrix_ast["val"]; }
    if k == "atom" {
        let rp = alg_expr_to_rpoly(matrix_ast["diff"], vars);
        let val_F = _rpoly_eval_full_in_field(F_cell, rp, coords_cell);
        let sg = F_cell["sgn"](val_F);
        let op = matrix_ast["op"];
        if op == "==" { return sg == 0; }
        if op == "!=" { return sg != 0; }
        if op == "<" { return sg < 0; }
        if op == "<=" { return sg <= 0; }
        if op == ">" { return sg > 0; }
        if op == ">=" { return sg >= 0; }
        throw "unknown atom op: " + op;
    }
    if k == "not" {
        return not _eval_matrix_on_cell(matrix_ast["arg"], vars, F_cell, coords_cell);
    }
    if k == "and" {
        if not _eval_matrix_on_cell(matrix_ast["left"], vars, F_cell, coords_cell) { return false; }
        return _eval_matrix_on_cell(matrix_ast["right"], vars, F_cell, coords_cell);
    }
    if k == "or" {
        if _eval_matrix_on_cell(matrix_ast["left"], vars, F_cell, coords_cell) { return true; }
        return _eval_matrix_on_cell(matrix_ast["right"], vars, F_cell, coords_cell);
    }
    if k == "implies" {
        if not _eval_matrix_on_cell(matrix_ast["left"], vars, F_cell, coords_cell) { return true; }
        return _eval_matrix_on_cell(matrix_ast["right"], vars, F_cell, coords_cell);
    }
    if k == "iff" {
        let lv = _eval_matrix_on_cell(matrix_ast["left"], vars, F_cell, coords_cell);
        let rv = _eval_matrix_on_cell(matrix_ast["right"], vars, F_cell, coords_cell);
        return lv == rv;
    }
    throw "_eval_matrix_on_cell: unexpected node kind " + k;
}

fn _witness_score(sample_info) {
    // Higher score = cleaner witness/counterexample: prefer exact rationals, positive values, small integers
    let sc = 0;
    let i = 0;
    while i < len(sample_info) {
        let inf = sample_info[i];
        if inf["is_rational"] {
            sc = sc + 100;
            if inf["rat"]["den"] == _B1 { sc = sc + 50; }
        }
        if inf["approx"] > 0.0 { sc = sc + 10; }
        if num_abs(inf["approx"]) <= 4.0 { sc = sc + 5; }
        i = i + 1;
    }
    return sc;
}

// Evaluate CAD subtree at `node` (`node.level == depth`, `0 <= depth <= n`)
// `f_count` = number of free variables (`0..f_count-1`); `quantifiers` has length `n - f_count`.
fn _eval_cad_quantified_node(node, f_count, quantifiers, matrix_ast, all_vars, free_cell_out) {
    let depth = node["level"];
    let n = len(all_vars);

    if depth == n {
        let tv = _eval_matrix_on_cell(matrix_ast, all_vars, node["field"], node["coords"]);
        node["truth"] = tv;
        node["witness_info"] = node["sample_info"];
        if f_count == n {
            push(free_cell_out, node);
        }
        return tv;
    }

    if depth < f_count {
        // Still descending through free-variable cylinders
        let i = 0;
        while i < len(node["children"]) {
            let ch = node["children"][i];
            let sub_t = _eval_cad_quantified_node(ch, f_count, quantifiers, matrix_ast, all_vars, free_cell_out);
            ch["truth"] = sub_t;
            if depth + 1 == f_count and ch["kind"] != "leaf" {
                push(free_cell_out, ch);
            }
            i = i + 1;
        }
        return true;
    }

    // Quantified variable `quantifiers[depth - f_count]`
    let q_spec = quantifiers[depth - f_count];
    let qk = q_spec["q"];
    if qk == "forall" {
        let all_ok = true;
        let best_cex = nil;
        let best_sc = -999999;
        let i = 0;
        while i < len(node["children"]) {
            let ch = node["children"][i];
            let ct = _eval_cad_quantified_node(ch, f_count, quantifiers, matrix_ast, all_vars, free_cell_out);
            if not ct {
                all_ok = false;
                let cand_inf = ch["witness_info"];
                if cand_inf == nil { cand_inf = ch["sample_info"]; }
                let sc = _witness_score(cand_inf);
                if best_cex == nil or sc > best_sc {
                    best_cex = cand_inf;
                    best_sc = sc;
                }
            }
            i = i + 1;
        }
        node["truth"] = all_ok;
        node["witness_info"] = best_cex;
        return all_ok;
    } else {
        // exists
        let any_ok = false;
        let best_wit = nil;
        let best_sc = -999999;
        let i = 0;
        while i < len(node["children"]) {
            let ch = node["children"][i];
            let ct = _eval_cad_quantified_node(ch, f_count, quantifiers, matrix_ast, all_vars, free_cell_out);
            if ct {
                any_ok = true;
                let cand_inf = ch["witness_info"];
                if cand_inf == nil { cand_inf = ch["sample_info"]; }
                let sc = _witness_score(cand_inf);
                if best_wit == nil or sc > best_sc {
                    best_wit = cand_inf;
                    best_sc = sc;
                }
            }
            i = i + 1;
        }
        node["truth"] = any_ok;
        node["witness_info"] = best_wit;
        return any_ok;
    }
}

fn _format_witness_map(kind_label, sample_info, vars, limit_count) {
    if sample_info == nil { return nil; }
    let vals = map{};
    let exact_m = map{};
    let out = map{ kind: kind_label, values: vals, exact: exact_m };
    let cnt = len(sample_info);
    if limit_count < cnt { cnt = limit_count; }
    let i = 0;
    while i < cnt {
        let vnm = vars[i];
        let inf = sample_info[i];
        if inf["is_rational"] and inf["rat"]["den"] == _B1 {
            let iv = _bi_to_plain_int_or_bi(inf["rat"]["num"]);
            vals[vnm] = iv;
            exact_m[vnm] = inf["rat"];
            if vnm != "kind" and vnm != "values" and vnm != "exact" {
                out[vnm] = iv;
            }
        } else if inf["is_rational"] {
            let fv = EX.rat_to_float(inf["rat"]);
            vals[vnm] = fv;
            exact_m[vnm] = inf["rat"];
            if vnm != "kind" and vnm != "values" and vnm != "exact" {
                out[vnm] = fv;
            }
        } else {
            vals[vnm] = inf["approx"];
            exact_m[vnm] = map{ kind: "algebraic_interval", lo: inf["lo"], hi: inf["hi"], approx: inf["approx"] };
            if vnm != "kind" and vnm != "values" and vnm != "exact" {
                out[vnm] = inf["approx"];
            }
        }
        i = i + 1;
    }
    return out;
}

// ── Thom's Lemma Quantifier-Free Formula Synthesis over R^f ───────────────────

fn _mask_to_atom_str(poly_str, mask_bits) {
    // mask_bits: bit 1 = (-1), bit 2 = (0), bit 4 = (+1)
    if mask_bits == 7 { return "true"; }
    if mask_bits == 0 { return "false"; }
    if mask_bits == 4 { return poly_str + " > 0"; }
    if mask_bits == 2 { return poly_str + " == 0"; }
    if mask_bits == 1 { return poly_str + " < 0"; }
    if mask_bits == 6 { return poly_str + " >= 0"; }
    if mask_bits == 3 { return poly_str + " <= 0"; }
    if mask_bits == 5 { return poly_str + " != 0"; }
    return "true";
}

fn _sgn_to_bit(sg) {
    if sg < 0 { return 1; }
    if sg == 0 { return 2; }
    return 4;
}

fn _bit_and3(a, b) {
    let r = 0;
    if (a % 2 == 1) and (b % 2 == 1) { r = r + 1; }
    if (num_floor(a / 2) % 2 == 1) and (num_floor(b / 2) % 2 == 1) { r = r + 2; }
    if (num_floor(a / 4) % 2 == 1) and (num_floor(b / 4) % 2 == 1) { r = r + 4; }
    return r;
}

fn _bit_or3(a, b) {
    let r = 0;
    if (a % 2 == 1) or (b % 2 == 1) { r = r + 1; }
    if (num_floor(a / 2) % 2 == 1) or (num_floor(b / 2) % 2 == 1) { r = r + 2; }
    if (num_floor(a / 4) % 2 == 1) or (num_floor(b / 4) % 2 == 1) { r = r + 4; }
    return r;
}

fn _cube_covers_sig(cube_masks, sig_bits) {
    let i = 0;
    while i < len(cube_masks) {
        if _bit_and3(cube_masks[i], sig_bits[i]) == 0 { return false; }
        i = i + 1;
    }
    return true;
}

fn _cube_hits_any(cube_masks, sig_list) {
    let i = 0;
    while i < len(sig_list) {
        if _cube_covers_sig(cube_masks, sig_list[i]) { return true; }
        i = i + 1;
    }
    return false;
}

fn _synthesize_qf_formula_from_free_cells(free_cells, free_vars, level_polys) {
    if len(free_cells) == 0 { return "false"; }
    let true_cells = [];
    let false_cells = [];
    let i = 0;
    while i < len(free_cells) {
        if free_cells[i]["truth"] {
            push(true_cells, free_cells[i]);
        } else {
            push(false_cells, free_cells[i]);
        }
        i = i + 1;
    }
    if len(false_cells) == 0 { return "true"; }
    if len(true_cells) == 0 { return "false"; }

    let f = len(free_vars);
    // Collect all projection polynomials in Q[v_1..v_f] lifted to level f
    let seen = map{};
    let basis_polys = [];
    let lv = 1;
    while lv <= f {
        let plist = level_polys[lv];
        let j = 0;
        while j < len(plist) {
            let lifted = rpoly_primitive_norm(rpoly_lift_from(plist[j], f));
            if (not rpoly_is_zero(lifted)) and (not rpoly_is_const_rat(lifted)) {
                let s_chk = rpoly_to_str(lifted, free_vars);
                if len(s_chk) > 0 and str_slice(s_chk, 0, 1) == "-" {
                    lifted = rpoly_neg(lifted);
                }
                let ky = rpoly_key(lifted);
                if not map_has(seen, ky) {
                    seen[ky] = true;
                    push(basis_polys, lifted);
                }
            }
            j = j + 1;
        }
        lv = lv + 1;
    }

    // Evaluate sign signatures on true_cells & false_cells; if any collision exists,
    // close under Thom's Lemma partial derivatives until T and F signatures are 100% disjoint!
    let thom_round = 0;
    let t_sigs = [];
    let f_sigs = [];
    while thom_round < 6 {
        t_sigs = [];
        f_sigs = [];
        let t_keys = map{};
        i = 0;
        while i < len(true_cells) {
            let tc = true_cells[i];
            let sb = [];
            let j = 0;
            while j < len(basis_polys) {
                let vf = _rpoly_eval_full_in_field(tc["field"], basis_polys[j], tc["coords"]);
                push(sb, _sgn_to_bit(tc["field"]["sgn"](vf)));
                j = j + 1;
            }
            push(t_sigs, sb);
            t_keys[_join_strs(sb, ",")] = true;
            i = i + 1;
        }

        let collision = false;
        i = 0;
        while i < len(false_cells) {
            let fc = false_cells[i];
            let sb = [];
            let j = 0;
            while j < len(basis_polys) {
                let vf = _rpoly_eval_full_in_field(fc["field"], basis_polys[j], fc["coords"]);
                push(sb, _sgn_to_bit(fc["field"]["sgn"](vf)));
                j = j + 1;
            }
            push(f_sigs, sb);
            if map_has(t_keys, _join_strs(sb, ",")) {
                collision = true;
            }
            i = i + 1;
        }

        if not collision { break; }

        // Thom's Lemma derivative augmentation
        let cur_len = len(basis_polys);
        let j = 0;
        while j < cur_len {
            let v_idx = 1;
            while v_idx <= f {
                let dp = rpoly_primitive_norm(rpoly_deriv_var(basis_polys[j], v_idx));
                if (not rpoly_is_zero(dp)) and (not rpoly_is_const_rat(dp)) {
                    let kd = rpoly_key(dp);
                    if not map_has(seen, kd) {
                        seen[kd] = true;
                        push(basis_polys, dp);
                    }
                }
                v_idx = v_idx + 1;
            }
            j = j + 1;
        }
        thom_round = thom_round + 1;
    }

    let m = len(basis_polys);
    let poly_strs = [];
    i = 0;
    while i < m {
        push(poly_strs, rpoly_to_str(basis_polys[i], free_vars));
        i = i + 1;
    }

    // Fast Check 1: Single-polynomial exact separator (e.g. `b^2 - 4*c >= 0`!)
    let p_idx = 0;
    while p_idx < m {
        let union_t = 0;
        let union_f = 0;
        i = 0;
        while i < len(t_sigs) {
            union_t = _bit_or3(union_t, t_sigs[i][p_idx]);
            i = i + 1;
        }
        i = 0;
        while i < len(f_sigs) {
            union_f = _bit_or3(union_f, f_sigs[i][p_idx]);
            i = i + 1;
        }
        if _bit_and3(union_t, union_f) == 0 {
            // We can even expand union_t with any don't-care bits not in union_f if simpler (e.g. >0 vs >=0 is determined by F!)
            return _mask_to_atom_str(poly_strs[p_idx], union_t);
        }
        p_idx = p_idx + 1;
    }

    // General Ternary Prime-Implicant / Cube Generalization against F-signatures:
    // Deduplicate true signatures, then greedily generalize each true cube (widening each coordinate mask toward 7
    // whenever the widened cube still avoids ALL false cell signatures!) and drop redundant cubes.
    let cubes = [];
    let seen_t = map{};
    i = 0;
    while i < len(t_sigs) {
        let ks = _join_strs(t_sigs[i], ",");
        if not map_has(seen_t, ks) {
            seen_t[ks] = true;
            // Generalize t_sigs[i] maximally without hitting f_sigs
            let cb = [];
            let j = 0;
            while j < m { push(cb, t_sigs[i][j]); j = j + 1; }

            // First try dropping entire polynomials (widening to 7 = don't-care)
            j = 0;
            while j < m {
                let old_m = cb[j];
                cb[j] = 7;
                if _cube_hits_any(cb, f_sigs) {
                    cb[j] = old_m;
                }
                j = j + 1;
            }
            // Next try widening single-sign masks (1, 2, 4) to >=0 (6), <=0 (3), !=0 (5)
            j = 0;
            while j < m {
                if cb[j] != 7 {
                    let cands = [6, 3, 5];
                    let ci = 0;
                    while ci < 3 {
                        let cm = cands[ci];
                        if _bit_and3(cm, cb[j]) == cb[j] and cm != cb[j] {
                            let prev_m = cb[j];
                            cb[j] = cm;
                            if _cube_hits_any(cb, f_sigs) {
                                cb[j] = prev_m;
                            } else {
                                break;
                            }
                        }
                        ci = ci + 1;
                    }
                }
                j = j + 1;
            }
            push(cubes, cb);
        }
        i = i + 1;
    }

    // Deduplicate & greedily select minimal cover of `t_sigs`
    let uncovered = [];
    i = 0;
    while i < len(t_sigs) {
        push(uncovered, t_sigs[i]);
        i = i + 1;
    }
    let chosen_disjuncts = [];
    while len(uncovered) > 0 {
        let best_cb = cubes[0];
        let best_cov = -1;
        let best_lits = 999999;
        i = 0;
        while i < len(cubes) {
            let cov = 0;
            let u = 0;
            while u < len(uncovered) {
                if _cube_covers_sig(cubes[i], uncovered[u]) { cov = cov + 1; }
                u = u + 1;
            }
            let lits = 0;
            let j = 0;
            while j < m {
                if cubes[i][j] != 7 { lits = lits + 1; }
                j = j + 1;
            }
            if cov > best_cov or (cov == best_cov and lits < best_lits) {
                best_cb = cubes[i];
                best_cov = cov;
                best_lits = lits;
            }
            i = i + 1;
        }
        if best_cov <= 0 { break; }

        let next_uncov = [];
        let u = 0;
        while u < len(uncovered) {
            if not _cube_covers_sig(best_cb, uncovered[u]) {
                push(next_uncov, uncovered[u]);
            }
            u = u + 1;
        }
        uncovered = next_uncov;

        let conj_parts = [];
        let j = 0;
        while j < m {
            if best_cb[j] != 7 {
                push(conj_parts, _mask_to_atom_str(poly_strs[j], best_cb[j]));
            }
            j = j + 1;
        }
        if len(conj_parts) == 0 {
            return "true";
        } else if len(conj_parts) == 1 {
            push(chosen_disjuncts, conj_parts[0]);
        } else {
            push(chosen_disjuncts, "(" + _join_strs(conj_parts, " and ") + ")");
        }
    }

    if len(chosen_disjuncts) == 0 { return "false"; }
    if len(chosen_disjuncts) == 1 {
        let s0 = chosen_disjuncts[0];
        if len(s0) >= 2 and str_slice(s0, 0, 1) == "(" and str_slice(s0, len(s0) - 1, len(s0)) == ")" {
            return str_slice(s0, 1, len(s0) - 1);
        }
        return s0;
    }
    return _join_strs(chosen_disjuncts, " or ");
}

// Core Tarski-Seidenberg CAD Engine (`_run_cad_engine`)
fn _run_cad_engine(formula_or_str, explicit_free_vars = nil) {
    let pnf = formula_to_prenex(formula_or_str);
    let free_vars = pnf["free_vars"];
    if explicit_free_vars != nil {
        free_vars = _copy_str_arr(explicit_free_vars);
        // Ensure any remaining unmentioned free vars are appended safely
        let i = 0;
        while i < len(pnf["free_vars"]) {
            if not _arr_contains_str(free_vars, pnf["free_vars"][i]) {
                push(free_vars, pnf["free_vars"][i]);
            }
            i = i + 1;
        }
    }

    let all_vars = _copy_str_arr(free_vars);
    let i = 0;
    while i < len(pnf["quantifiers"]) {
        push(all_vars, pnf["quantifiers"][i]["var_name"]);
        i = i + 1;
    }
    if len(all_vars) > MAX_CAD_VARS {
        throw "Tarski-Seidenberg CAD: variable count (" + str(len(all_vars)) + ") exceeds MAX_CAD_VARS (" + str(MAX_CAD_VARS) + ")";
    }

    let seen_p = map{};
    let mat_polys = [];
    _collect_matrix_polys(pnf["matrix"], all_vars, seen_p, mat_polys);
    let cad = _cad_build_from_rpolys(mat_polys, all_vars);

    let f_count = len(free_vars);
    let free_cells = [];
    let root_truth = _eval_cad_quantified_node(
        cad["tree"], f_count, pnf["quantifiers"], pnf["matrix"], all_vars, free_cells
    );

    let truth_val = nil;
    let elim_str = "";
    let wit_or_cex = nil;

    if f_count == 0 {
        truth_val = root_truth;
        if root_truth { elim_str = "true"; }
        else { elim_str = "false"; }

        if len(pnf["quantifiers"]) > 0 {
            let first_q = pnf["quantifiers"][0]["q"];
            if first_q == "exists" and root_truth {
                // Count leading existential prefix
                let ex_len = 0;
                while ex_len < len(pnf["quantifiers"]) and pnf["quantifiers"][ex_len]["q"] == "exists" {
                    ex_len = ex_len + 1;
                }
                wit_or_cex = _format_witness_map("witness", cad["tree"]["witness_info"], all_vars, ex_len);
            } else if first_q == "forall" and (not root_truth) {
                let fa_len = 0;
                while fa_len < len(pnf["quantifiers"]) and pnf["quantifiers"][fa_len]["q"] == "forall" {
                    fa_len = fa_len + 1;
                }
                wit_or_cex = _format_witness_map("counterexample", cad["tree"]["witness_info"], all_vars, fa_len);
            }
        }
    } else {
        elim_str = _synthesize_qf_formula_from_free_cells(free_cells, free_vars, cad["level_polys"]);
        if elim_str == "true" { truth_val = true; }
        else if elim_str == "false" { truth_val = false; }
    }

    let elim_ast = parse_first_order_formula(elim_str);

    let cert_en = "Tarski-Seidenberg CAD over R^" + str(len(all_vars))
        + " constructed " + str(cad["cell_count"]) + " cylindrical cells ("
        + str(cad["leaf_cell_count"]) + " leaf cells) via exact Subresultant PRS & Sturm-D5 isolation; "
        + "eliminated formula: " + elim_str + ".";
    let cert_el = "Πλήρης Κυλινδρική Αλγεβρική Αποσύνθεση (Tarski-Seidenberg CAD) στον R^" + str(len(all_vars))
        + " με " + str(cad["cell_count"]) + " κυλινδρικά κελιά ("
        + str(cad["leaf_cell_count"]) + " φύλλα) μέσω ακριβούς Subresultant PRS & Sturm-D5· "
        + "ισοδύναμος τύπος χωρίς ποσοδείκτες: " + elim_str + ".";

    let ex_wit = nil;
    if wit_or_cex != nil {
        ex_wit = wit_or_cex["exact"];
    }

    return map{
        decidable: true,
        theory: "Tarski-Seidenberg Real Closed Field (CAD)",
        truth: truth_val,
        proved: truth_val == true,
        free_vars: free_vars,
        bound_vars: pnf["quantifiers"],
        eliminated_formula: elim_str,
        eliminated_ast: elim_ast,
        cell_count: cad["cell_count"],
        leaf_cell_count: cad["leaf_cell_count"],
        projection_levels: cad["projection_summary"],
        witness_or_counterexample: wit_or_cex,
        exact_witness: ex_wit,
        proof_certificate_el: cert_el,
        proof_certificate_en: cert_en
    };
}

fn cad_decide(formula_or_str) {
    return _run_cad_engine(formula_or_str, nil);
}

fn quantifier_eliminate_real(formula_or_str, free_vars = nil) {
    return _run_cad_engine(formula_or_str, free_vars);
}

fn prove_real_inequality(formula_or_str, hypotheses = nil) {
    let ast = parse_first_order_formula(formula_or_str);
    if hypotheses != nil and type(hypotheses) == "array" and len(hypotheses) > 0 {
        let hyp_ast = parse_first_order_formula(hypotheses[0]);
        let hi = 1;
        while hi < len(hypotheses) {
            hyp_ast = map{ kind: "and", left: hyp_ast, right: parse_first_order_formula(hypotheses[hi]) };
            hi = hi + 1;
        }
        ast = map{ kind: "implies", left: hyp_ast, right: ast };
    }
    let fvs = formula_free_vars(ast);
    let closed_ast = ast;
    let i = len(fvs) - 1;
    while i >= 0 {
        closed_ast = map{ kind: "forall", var_name: fvs[i], body: closed_ast };
        i = i - 1;
    }
    return _run_cad_engine(closed_ast, []);
}

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE 2: COOPER'S COMPLETE DECISION ALGORITHM FOR PRESBURGER ARITHMETIC (Z)
// ══════════════════════════════════════════════════════════════════════════════

fn _plin_const(c_bi) {
    return map{ c0: c_bi, coeffs: map{} };
}

fn _plin_var(nm) {
    let cs = map{};
    cs[nm] = _B1;
    return map{ c0: _B0, coeffs: cs };
}

fn _plin_is_const(L) {
    return len(map_keys(L["coeffs"])) == 0;
}

fn _plin_coeff(L, vnm) {
    if map_has(L["coeffs"], vnm) { return L["coeffs"][vnm]; }
    return _B0;
}

fn _plin_neg(L) {
    let cs = map{};
    let ks = map_keys(L["coeffs"]);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        cs[k] = _B0 - L["coeffs"][k];
        i = i + 1;
    }
    return map{ c0: _B0 - L["c0"], coeffs: cs };
}

fn _plin_scale(L, k_bi) {
    if k_bi == _B0 { return _plin_const(_B0); }
    let cs = map{};
    let ks = map_keys(L["coeffs"]);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        let v = L["coeffs"][k] * k_bi;
        if v != _B0 { cs[k] = v; }
        i = i + 1;
    }
    return map{ c0: L["c0"] * k_bi, coeffs: cs };
}

fn _plin_add(A, B) {
    let cs = map{};
    let ka = map_keys(A["coeffs"]);
    let i = 0;
    while i < len(ka) {
        let k = ka[i];
        cs[k] = A["coeffs"][k];
        i = i + 1;
    }
    let kb = map_keys(B["coeffs"]);
    i = 0;
    while i < len(kb) {
        let k = kb[i];
        let nv = _plin_coeff(A, k) + B["coeffs"][k];
        if nv != _B0 {
            cs[k] = nv;
        } else {
            // Rebuild without zero entry below
            cs[k] = _B0;
        }
        i = i + 1;
    }
    let clean = map{};
    let kc = map_keys(cs);
    i = 0;
    while i < len(kc) {
        let k = kc[i];
        if cs[k] != _B0 { clean[k] = cs[k]; }
        i = i + 1;
    }
    return map{ c0: A["c0"] + B["c0"], coeffs: clean };
}

fn _plin_sub(A, B) {
    return _plin_add(A, _plin_neg(B));
}

fn _plin_subst(L, vnm, rep_L) {
    let cv = _plin_coeff(L, vnm);
    if cv == _B0 { return L; }
    let base_cs = map{};
    let ks = map_keys(L["coeffs"]);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if k != vnm { base_cs[k] = L["coeffs"][k]; }
        i = i + 1;
    }
    let without_v = map{ c0: L["c0"], coeffs: base_cs };
    return _plin_add(without_v, _plin_scale(rep_L, cv));
}

fn _plin_key(L) {
    let ks = _sort_strings(map_keys(L["coeffs"]));
    let parts = [str(L["c0"])];
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        push(parts, k + ":" + str(L["coeffs"][k]));
        i = i + 1;
    }
    return _join_strs(parts, "|");
}

fn _plin_to_str(L) {
    let ks = _sort_strings(map_keys(L["coeffs"]));
    if len(ks) == 0 { return str(L["c0"]); }
    let out = "";
    let i = 0;
    while i < len(ks) {
        let v = ks[i];
        let c = L["coeffs"][v];
        let neg = c < _B0;
        let ac = _b_abs(c);
        let term = v;
        if ac != _B1 { term = str(ac) + "*" + v; }
        if i == 0 {
            if neg { out = "-" + term; }
            else { out = term; }
        } else {
            if neg { out = out + " - " + term; }
            else { out = out + " + " + term; }
        }
        i = i + 1;
    }
    if L["c0"] > _B0 {
        out = out + " + " + str(L["c0"]);
    } else if L["c0"] < _B0 {
        out = out + " - " + str(_b_abs(L["c0"]));
    }
    return out;
}

fn _alg_to_plin(expr) {
    let k = expr["kind"];
    if k == "num" {
        let r = expr["rat"];
        if r["den"] != _B1 {
            throw "Presburger arithmetic requires integer constants, got rational " + EX.rat_to_str(r);
        }
        return _plin_const(r["num"]);
    }
    if k == "var" { return _plin_var(expr["name"]); }
    if k == "neg" { return _plin_neg(_alg_to_plin(expr["arg"])); }
    if k == "+" { return _plin_add(_alg_to_plin(expr["left"]), _alg_to_plin(expr["right"])); }
    if k == "-" { return _plin_sub(_alg_to_plin(expr["left"]), _alg_to_plin(expr["right"])); }
    if k == "*" {
        let L = _alg_to_plin(expr["left"]);
        let R = _alg_to_plin(expr["right"]);
        if _plin_is_const(L) { return _plin_scale(R, L["c0"]); }
        if _plin_is_const(R) { return _plin_scale(L, R["c0"]); }
        throw "Presburger arithmetic requires linear expressions (non-linear product detected)";
    }
    if k == "pow" {
        let e = expr["exp"];
        if e == 0 { return _plin_const(_B1); }
        let B = _alg_to_plin(expr["base"]);
        if e == 1 { return B; }
        if _plin_is_const(B) {
            let acc = _B1;
            let u = 0;
            while u < e { acc = acc * B["c0"]; u = u + 1; }
            return _plin_const(acc);
        }
        throw "Presburger arithmetic requires linear expressions (exponent " + str(e) + " > 1 on variable)";
    }
    throw "Presburger arithmetic: unsupported algebraic term '" + k + "'";
}

// Canonical Atomic Constructors for Cooper Presburger Arithmetic
fn _pbf_bool(b) {
    return map{ kind: "bool", val: b, key: "B:" + str(b) };
}

// `0 < E` over Z, normalized by coefficient GCD
fn _pbf_make_lt(E) {
    let ks = map_keys(E["coeffs"]);
    if len(ks) == 0 {
        return _pbf_bool(E["c0"] > _B0);
    }
    let g = _B0;
    let i = 0;
    while i < len(ks) {
        g = _b_gcd(g, E["coeffs"][ks[i]]);
        i = i + 1;
    }
    let norm_E = E;
    if g > _B1 {
        // 0 < c0 + g*S  <==>  S > floor((-c0) / g)  <==>  0 < (-floor((-c0)/g)) + S
        let new_c0 = _B0 - _floor_div_bi(_B0 - E["c0"], g);
        let ncs = map{};
        i = 0;
        while i < len(ks) {
            let k = ks[i];
            ncs[k] = E["coeffs"][k] / g;
            i = i + 1;
        }
        norm_E = map{ c0: new_c0, coeffs: ncs };
    }
    return map{ kind: "lt", expr: norm_E, key: "LT:" + _plin_key(norm_E) };
}

// `m | E` (if is_pos == true) or `m !| E` (if is_pos == false)
fn _pbf_make_div(m_raw, E, is_pos) {
    let m = _b_abs(m_raw);
    if m == _B0 {
        // 0 | E  <==>  E == 0
        if is_pos {
            return _pbf_and([
                _pbf_make_lt(_plin_add(E, _plin_const(_B1))),
                _pbf_make_lt(_plin_add(_plin_neg(E), _plin_const(_B1)))
            ]);
        }
        return _pbf_or([_pbf_make_lt(E), _pbf_make_lt(_plin_neg(E))]);
    }
    if m == _B1 {
        return _pbf_bool(is_pos);
    }

    // Reduce coefficients modulo m (in symmetric range (-m/2, m/2] or [0, m-1]) and c0 into [0, m-1]
    let ks = map_keys(E["coeffs"]);
    let red_cs = map{};
    let g_all = m;
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        let r = _euclid_mod_bi(E["coeffs"][k], m);
        if r * _B2 > m { r = r - m; }
        if r != _B0 {
            red_cs[k] = r;
            g_all = _b_gcd(g_all, r);
        }
        i = i + 1;
    }
    let c0_mod = _euclid_mod_bi(E["c0"], m);

    if len(map_keys(red_cs)) == 0 {
        let div_ok = (c0_mod == _B0);
        if is_pos { return _pbf_bool(div_ok); }
        return _pbf_bool(not div_ok);
    }

    // Bézout / GCD solvability check: if gcd(m, coeffs) does not divide c0, m | E is IMPOSSIBLE!
    if (c0_mod % g_all) != _B0 {
        if is_pos { return _pbf_bool(false); }
        return _pbf_bool(true);
    }

    if g_all > _B1 {
        m = m / g_all;
        c0_mod = c0_mod / g_all;
        let rks = map_keys(red_cs);
        let scaled_cs = map{};
        i = 0;
        while i < len(rks) {
            let k = rks[i];
            scaled_cs[k] = red_cs[k] / g_all;
            i = i + 1;
        }
        red_cs = scaled_cs;
        if m == _B1 {
            return _pbf_bool(is_pos);
        }
    }

    // Canonicalize sign of leading variable in divisibility atom (since m | E <==> m | -E)
    let sks = _sort_strings(map_keys(red_cs));
    if len(sks) > 0 and red_cs[sks[0]] < _B0 {
        let flipped_cs = map{};
        i = 0;
        while i < len(sks) {
            let k = sks[i];
            flipped_cs[k] = _B0 - red_cs[k];
            i = i + 1;
        }
        red_cs = flipped_cs;
        c0_mod = _euclid_mod_bi(_B0 - c0_mod, m);
    }

    let norm_E = map{ c0: c0_mod, coeffs: red_cs };
    let kd = "div";
    let pfx = "DV:";
    if not is_pos {
        kd = "ndiv";
        pfx = "ND:";
    }
    return map{ kind: kd, modulus: m, expr: norm_E, key: pfx + str(m) + ":" + _plin_key(norm_E) };
}

fn _pbf_not(f) {
    let k = f["kind"];
    if k == "bool" { return _pbf_bool(not f["val"]); }
    if k == "lt" {
        // ~(0 < E)  <==>  E <= 0  <==>  0 < 1 - E
        return _pbf_make_lt(_plin_add(_plin_neg(f["expr"]), _plin_const(_B1)));
    }
    if k == "div" {
        return _pbf_make_div(f["modulus"], f["expr"], false);
    }
    if k == "ndiv" {
        return _pbf_make_div(f["modulus"], f["expr"], true);
    }
    if k == "and" {
        let items = [];
        let i = 0;
        while i < len(f["items"]) {
            push(items, _pbf_not(f["items"][i]));
            i = i + 1;
        }
        return _pbf_or(items);
    }
    if k == "or" {
        let items = [];
        let i = 0;
        while i < len(f["items"]) {
            push(items, _pbf_not(f["items"][i]));
            i = i + 1;
        }
        return _pbf_and(items);
    }
    throw "_pbf_not: unexpected kind " + k;
}

fn _pbf_and(raw_items) {
    let flat = [];
    let seen = map{};
    let i = 0;
    while i < len(raw_items) {
        let it = raw_items[i];
        if it["kind"] == "bool" {
            if not it["val"] { return _pbf_bool(false); }
        } else if it["kind"] == "and" {
            let j = 0;
            while j < len(it["items"]) {
                let sub = it["items"][j];
                if sub["kind"] == "bool" and (not sub["val"]) { return _pbf_bool(false); }
                if sub["kind"] != "bool" and (not map_has(seen, sub["key"])) {
                    seen[sub["key"]] = true;
                    push(flat, sub);
                }
                j = j + 1;
            }
        } else {
            if not map_has(seen, it["key"]) {
                seen[it["key"]] = true;
                push(flat, it);
            }
        }
        i = i + 1;
    }
    if len(flat) == 0 { return _pbf_bool(true); }
    // Check direct complement (e.g. div & ndiv or lt(E) & lt(1-E))
    i = 0;
    while i < len(flat) {
        let neg_k = _pbf_not(flat[i])["key"];
        if map_has(seen, neg_k) { return _pbf_bool(false); }
        i = i + 1;
    }
    if len(flat) == 1 { return flat[0]; }
    let keys = [];
    i = 0;
    while i < len(flat) { push(keys, flat[i]["key"]); i = i + 1; }
    keys = _sort_strings(keys);
    return map{ kind: "and", items: flat, key: "AND(" + _join_strs(keys, "&") + ")" };
}

fn _pbf_or(raw_items) {
    let flat = [];
    let seen = map{};
    let i = 0;
    while i < len(raw_items) {
        let it = raw_items[i];
        if it["kind"] == "bool" {
            if it["val"] { return _pbf_bool(true); }
        } else if it["kind"] == "or" {
            let j = 0;
            while j < len(it["items"]) {
                let sub = it["items"][j];
                if sub["kind"] == "bool" and sub["val"] { return _pbf_bool(true); }
                if sub["kind"] != "bool" and (not map_has(seen, sub["key"])) {
                    seen[sub["key"]] = true;
                    push(flat, sub);
                }
                j = j + 1;
            }
        } else {
            if not map_has(seen, it["key"]) {
                seen[it["key"]] = true;
                push(flat, it);
            }
        }
        i = i + 1;
    }
    if len(flat) == 0 { return _pbf_bool(false); }
    i = 0;
    while i < len(flat) {
        let neg_k = _pbf_not(flat[i])["key"];
        if map_has(seen, neg_k) { return _pbf_bool(true); }
        i = i + 1;
    }
    if len(flat) == 1 { return flat[0]; }
    let keys = [];
    i = 0;
    while i < len(flat) { push(keys, flat[i]["key"]); i = i + 1; }
    keys = _sort_strings(keys);
    return map{ kind: "or", items: flat, key: "OR(" + _join_strs(keys, "|") + ")" };
}

fn _pbf_mentions_var(f, vnm) {
    let k = f["kind"];
    if k == "bool" { return false; }
    if k == "lt" or k == "div" or k == "ndiv" {
        return _plin_coeff(f["expr"], vnm) != _B0;
    }
    let i = 0;
    while i < len(f["items"]) {
        if _pbf_mentions_var(f["items"][i], vnm) { return true; }
        i = i + 1;
    }
    return false;
}

fn _pbf_collect_var_coeffs(f, vnm, out_coeffs) {
    let k = f["kind"];
    if k == "bool" { return; }
    if k == "lt" or k == "div" or k == "ndiv" {
        let c = _plin_coeff(f["expr"], vnm);
        if c != _B0 { push(out_coeffs, _b_abs(c)); }
        return;
    }
    let i = 0;
    while i < len(f["items"]) {
        _pbf_collect_var_coeffs(f["items"][i], vnm, out_coeffs);
        i = i + 1;
    }
}

// Scale variable `vnm` to `y = L * vnm` across all atoms so every `lt` atom has coeff(vnm) in {-1, 0, +1}
fn _pbf_scale_var_unit(f, vnm, L_bi) {
    let k = f["kind"];
    if k == "bool" { return f; }
    if k == "lt" {
        let E = f["expr"];
        let a = _plin_coeff(E, vnm);
        if a == _B0 { return f; }
        let s = L_bi / _b_abs(a);
        // 0 < a*v + R  <==>  0 < s*a*v + s*R = sgn(a)*y + s*R
        let ncs = map{};
        let ks = map_keys(E["coeffs"]);
        let i = 0;
        while i < len(ks) {
            let key = ks[i];
            if key == vnm {
                if a > _B0 { ncs[key] = _B1; }
                else { ncs[key] = _BM1; }
            } else {
                ncs[key] = E["coeffs"][key] * s;
            }
            i = i + 1;
        }
        return map{
            kind: "lt",
            expr: map{ c0: E["c0"] * s, coeffs: ncs },
            key: "LT:" + _plin_key(map{ c0: E["c0"] * s, coeffs: ncs })
        };
    }
    if k == "div" or k == "ndiv" {
        let E = f["expr"];
        let m = f["modulus"];
        let a = _plin_coeff(E, vnm);
        if a == _B0 { return f; }
        let g = _b_gcd(L_bi, _b_abs(a));
        let s = L_bi / g;
        let k_coef = a / g;
        let ncs = map{};
        let ks = map_keys(E["coeffs"]);
        let i = 0;
        while i < len(ks) {
            let key = ks[i];
            if key == vnm {
                ncs[key] = k_coef;
            } else {
                ncs[key] = E["coeffs"][key] * s;
            }
            i = i + 1;
        }
        let scaled_E = map{ c0: E["c0"] * s, coeffs: ncs };
        return _pbf_make_div(m * s, scaled_E, k == "div");
    }
    let out = [];
    let i = 0;
    while i < len(f["items"]) {
        push(out, _pbf_scale_var_unit(f["items"][i], vnm, L_bi));
        i = i + 1;
    }
    if k == "and" { return _pbf_and(out); }
    return _pbf_or(out);
}

fn _pbf_collect_moduli_and_lower_bounds(f, vnm, mod_box, seen_b, b_list) {
    let k = f["kind"];
    if k == "bool" { return; }
    if k == "lt" {
        let E = f["expr"];
        let c = _plin_coeff(E, vnm);
        if c > _B0 {
            // Since unit-scaled, c == +1: E = y + R = y - (-R), so lower bound b = -R
            let rem_cs = map{};
            let ks = map_keys(E["coeffs"]);
            let i = 0;
            while i < len(ks) {
                let key = ks[i];
                if key != vnm { rem_cs[key] = _B0 - E["coeffs"][key]; }
                i = i + 1;
            }
            let b_lin = map{ c0: _B0 - E["c0"], coeffs: rem_cs };
            let bk = _plin_key(b_lin);
            if not map_has(seen_b, bk) {
                seen_b[bk] = true;
                push(b_list, b_lin);
            }
        }
        return;
    }
    if k == "div" or k == "ndiv" {
        if _plin_coeff(f["expr"], vnm) != _B0 {
            mod_box["delta"] = _b_lcm(mod_box["delta"], f["modulus"]);
        }
        return;
    }
    let i = 0;
    while i < len(f["items"]) {
        _pbf_collect_moduli_and_lower_bounds(f["items"][i], vnm, mod_box, seen_b, b_list);
        i = i + 1;
    }
}

fn _pbf_minus_inf_proj(f, vnm) {
    let k = f["kind"];
    if k == "bool" { return f; }
    if k == "lt" {
        let c = _plin_coeff(f["expr"], vnm);
        if c > _B0 { return _pbf_bool(false); }
        if c < _B0 { return _pbf_bool(true); }
        return f;
    }
    if k == "div" or k == "ndiv" { return f; }
    let out = [];
    let i = 0;
    while i < len(f["items"]) {
        push(out, _pbf_minus_inf_proj(f["items"][i], vnm));
        i = i + 1;
    }
    if k == "and" { return _pbf_and(out); }
    return _pbf_or(out);
}

fn _pbf_subst_var(f, vnm, rep_lin) {
    let k = f["kind"];
    if k == "bool" { return f; }
    if k == "lt" {
        if _plin_coeff(f["expr"], vnm) == _B0 { return f; }
        return _pbf_make_lt(_plin_subst(f["expr"], vnm, rep_lin));
    }
    if k == "div" or k == "ndiv" {
        if _plin_coeff(f["expr"], vnm) == _B0 { return f; }
        return _pbf_make_div(f["modulus"], _plin_subst(f["expr"], vnm, rep_lin), k == "div");
    }
    if k == "and" {
        let out = [];
        let i = 0;
        while i < len(f["items"]) {
            let sub = _pbf_subst_var(f["items"][i], vnm, rep_lin);
            if sub["kind"] == "bool" and (not sub["val"]) {
                return _pbf_bool(false);
            }
            push(out, sub);
            i = i + 1;
        }
        return _pbf_and(out);
    }
    let out_or = [];
    let i = 0;
    while i < len(f["items"]) {
        let sub = _pbf_subst_var(f["items"][i], vnm, rep_lin);
        if sub["kind"] == "bool" and sub["val"] {
            return _pbf_bool(true);
        }
        push(out_or, sub);
        i = i + 1;
    }
    return _pbf_or(out_or);
}

// Cooper's Exact Elimination of `exists vnm: phi`
fn _cooper_elim_exists(vnm, phi) {
    if phi["kind"] == "bool" { return phi; }
    if not _pbf_mentions_var(phi, vnm) { return phi; }

    // Distribute `exists` over top-level `or`
    if phi["kind"] == "or" {
        let disj = [];
        let i = 0;
        while i < len(phi["items"]) {
            let part = _cooper_elim_exists(vnm, phi["items"][i]);
            if part["kind"] == "bool" and part["val"] { return _pbf_bool(true); }
            push(disj, part);
            i = i + 1;
        }
        return _pbf_or(disj);
    }

    // Factor out vnm-free conjuncts of top-level `and`
    if phi["kind"] == "and" {
        let indep = [];
        let dep = [];
        let i = 0;
        while i < len(phi["items"]) {
            if _pbf_mentions_var(phi["items"][i], vnm) {
                push(dep, phi["items"][i]);
            } else {
                push(indep, phi["items"][i]);
            }
            i = i + 1;
        }
        if len(indep) > 0 {
            let elim_dep = _cooper_elim_exists(vnm, _pbf_and(dep));
            push(indep, elim_dep);
            return _pbf_and(indep);
        }
    }

    // Step 1: Compute LCM `L` of all |coeff(vnm)| in `phi`
    let raw_cs = [];
    _pbf_collect_var_coeffs(phi, vnm, raw_cs);
    let L = _B1;
    let i = 0;
    while i < len(raw_cs) {
        L = _b_lcm(L, raw_cs[i]);
        i = i + 1;
    }

    let norm_phi = phi;
    if L > _B1 {
        let scaled = _pbf_scale_var_unit(phi, vnm, L);
        let div_L = _pbf_make_div(L, _plin_var(vnm), true);
        norm_phi = _pbf_and([div_L, scaled]);
    } else {
        // Still normalize any negative -1 coefficients properly (already +-1 in lt!)
        norm_phi = _pbf_scale_var_unit(phi, vnm, _B1);
    }

    if norm_phi["kind"] == "bool" { return norm_phi; }

    // Step 2: Collect modulus delta and lower-bound set B
    let mod_box = map{ delta: _B1 };
    let seen_b = map{};
    let b_list = [];
    _pbf_collect_moduli_and_lower_bounds(norm_phi, vnm, mod_box, seen_b, b_list);

    let delta_bi = mod_box["delta"];
    if delta_bi > bigint(MAX_PRESBURGER_MODULUS) {
        throw "MathGovernor[presburger]: Cooper modulus " + str(delta_bi) + " exceeds MAX_PRESBURGER_MODULUS";
    }
    let delta_int = num_floor(parse_number(str(delta_bi)));

    let branches = [];
    let ops = 0;

    // Step 3a: -infinity projection F_{-inf}(j) for j = 1 .. delta
    let f_minf = _pbf_minus_inf_proj(norm_phi, vnm);
    if f_minf["kind"] == "bool" {
        if f_minf["val"] { return _pbf_bool(true); }
    } else if not _pbf_mentions_var(f_minf, vnm) {
        push(branches, f_minf);
    } else {
        let j = 1;
        while j <= delta_int {
            ops = ops + 1;
            _guard_op(ops, "cooper_minf");
            let sub_inf = _pbf_subst_var(f_minf, vnm, _plin_const(bigint(j)));
            if sub_inf["kind"] == "bool" and sub_inf["val"] {
                return _pbf_bool(true);
            }
            if not (sub_inf["kind"] == "bool" and (not sub_inf["val"])) {
                push(branches, sub_inf);
            }
            j = j + 1;
        }
    }

    // Step 3b: B-set substitutions y = b_i + j for b_i in B and j = 1 .. delta
    let bi_idx = 0;
    while bi_idx < len(b_list) {
        let b_expr = b_list[bi_idx];
        let j = 1;
        while j <= delta_int {
            ops = ops + 1;
            _guard_op(ops, "cooper_bset");
            let cand_y = _plin_add(b_expr, _plin_const(bigint(j)));
            let sub_b = _pbf_subst_var(norm_phi, vnm, cand_y);
            if sub_b["kind"] == "bool" and sub_b["val"] {
                return _pbf_bool(true);
            }
            if not (sub_b["kind"] == "bool" and (not sub_b["val"])) {
                push(branches, sub_b);
            }
            j = j + 1;
        }
        bi_idx = bi_idx + 1;
    }

    return _pbf_or(branches);
}

// Convert general FOL AST into quantifier-free canonical Presburger formula via recursive Cooper QE!
fn _fol_to_presburger_qf(ast) {
    let k = ast["kind"];
    if k == "bool" { return _pbf_bool(ast["val"]); }
    if k == "atom" {
        let L = _alg_to_plin(ast["lhs"]);
        let R = _alg_to_plin(ast["rhs"]);
        let op = ast["op"];
        if op == "<" {
            // L < R  <==>  0 < R - L
            return _pbf_make_lt(_plin_sub(R, L));
        }
        if op == "<=" {
            // L <= R  <==>  0 < R - L + 1
            return _pbf_make_lt(_plin_add(_plin_sub(R, L), _plin_const(_B1)));
        }
        if op == ">" {
            return _pbf_make_lt(_plin_sub(L, R));
        }
        if op == ">=" {
            return _pbf_make_lt(_plin_add(_plin_sub(L, R), _plin_const(_B1)));
        }
        if op == "==" {
            let D = _plin_sub(L, R);
            return _pbf_and([
                _pbf_make_lt(_plin_add(D, _plin_const(_B1))),
                _pbf_make_lt(_plin_add(_plin_neg(D), _plin_const(_B1)))
            ]);
        }
        if op == "!=" {
            let D = _plin_sub(L, R);
            return _pbf_or([_pbf_make_lt(D), _pbf_make_lt(_plin_neg(D))]);
        }
        throw "Presburger: unknown relational op " + op;
    }
    if k == "divides" {
        let m_lin = _alg_to_plin(ast["mod_expr"]);
        if not _plin_is_const(m_lin) {
            throw "Presburger arithmetic requires constant integer modulus m in divides(m, expr)";
        }
        let e_lin = _alg_to_plin(ast["expr"]);
        return _pbf_make_div(m_lin["c0"], e_lin, true);
    }
    if k == "not" {
        return _pbf_not(_fol_to_presburger_qf(ast["arg"]));
    }
    if k == "and" {
        let lf = _fol_to_presburger_qf(ast["left"]);
        if lf["kind"] == "bool" and (not lf["val"]) { return lf; }
        let rf = _fol_to_presburger_qf(ast["right"]);
        return _pbf_and([lf, rf]);
    }
    if k == "or" {
        let lf = _fol_to_presburger_qf(ast["left"]);
        if lf["kind"] == "bool" and lf["val"] { return lf; }
        let rf = _fol_to_presburger_qf(ast["right"]);
        return _pbf_or([lf, rf]);
    }
    if k == "implies" {
        let n_left = _pbf_not(_fol_to_presburger_qf(ast["left"]));
        if n_left["kind"] == "bool" and n_left["val"] { return n_left; }
        let rf = _fol_to_presburger_qf(ast["right"]);
        return _pbf_or([n_left, rf]);
    }
    if k == "iff" {
        let lf = _fol_to_presburger_qf(ast["left"]);
        let rf = _fol_to_presburger_qf(ast["right"]);
        return _pbf_or([
            _pbf_and([lf, rf]),
            _pbf_and([_pbf_not(lf), _pbf_not(rf)])
        ]);
    }
    if k == "exists" {
        let body_qf = _fol_to_presburger_qf(ast["body"]);
        return _cooper_elim_exists(ast["var_name"], body_qf);
    }
    if k == "forall" {
        // forall x: P(x)  <==>  not (exists x: not P(x))
        let not_body = _pbf_not(_fol_to_presburger_qf(ast["body"]));
        let ex_not = _cooper_elim_exists(ast["var_name"], not_body);
        return _pbf_not(ex_not);
    }
    throw "Presburger: unsupported AST kind " + k;
}

fn _pbf_to_str(f) {
    let k = f["kind"];
    if k == "bool" {
        if f["val"] { return "true"; }
        return "false";
    }
    if k == "lt" {
        // 0 < c0 + S  <==>  S >= 1 - c0
        let E = f["expr"];
        let rhs_c = _B1 - E["c0"];
        let no_c = map{ c0: _B0, coeffs: E["coeffs"] };
        return _plin_to_str(no_c) + " >= " + str(rhs_c);
    }
    if k == "div" {
        return "divides(" + str(f["modulus"]) + ", " + _plin_to_str(f["expr"]) + ")";
    }
    if k == "ndiv" {
        return "not divides(" + str(f["modulus"]) + ", " + _plin_to_str(f["expr"]) + ")";
    }
    if k == "and" or k == "or" {
        let parts = [];
        let i = 0;
        while i < len(f["items"]) {
            let sub = f["items"][i];
            let s = _pbf_to_str(sub);
            if sub["kind"] == "and" or sub["kind"] == "or" {
                s = "(" + s + ")";
            }
            push(parts, s);
            i = i + 1;
        }
        let sep = " and ";
        if k == "or" { sep = " or "; }
        return _join_strs(parts, sep);
    }
    return "false";
}

// Exact Cooper Witness Finder for 1-variable quantifier-free Presburger formula `theta(vnm)` known satisfiable
fn _cooper_find_1var_witness_bi(vnm, theta_qf) {
    // 1. Check small clean integers 0, 1, -1, 2, -2, ..., 40, -40 first
    let z0 = _pbf_subst_var(theta_qf, vnm, _plin_const(_B0));
    if z0["kind"] == "bool" and z0["val"] { return _B0; }
    let step = 1;
    while step <= 40 {
        let bp = bigint(step);
        let tp = _pbf_subst_var(theta_qf, vnm, _plin_const(bp));
        if tp["kind"] == "bool" and tp["val"] { return bp; }
        let bn = bigint(0 - step);
        let tn = _pbf_subst_var(theta_qf, vnm, _plin_const(bn));
        if tn["kind"] == "bool" and tn["val"] { return bn; }
        step = step + 1;
    }

    // 2. General exact Cooper B-set / -infinity back-substitution (finds witnesses of ANY magnitude!)
    let raw_cs = [];
    _pbf_collect_var_coeffs(theta_qf, vnm, raw_cs);
    let L = _B1;
    let i = 0;
    while i < len(raw_cs) { L = _b_lcm(L, raw_cs[i]); i = i + 1; }

    let norm_phi = _pbf_scale_var_unit(theta_qf, vnm, L);
    if L > _B1 {
        norm_phi = _pbf_and([_pbf_make_div(L, _plin_var(vnm), true), norm_phi]);
    }
    let mod_box = map{ delta: _B1 };
    let seen_b = map{};
    let b_list = [];
    _pbf_collect_moduli_and_lower_bounds(norm_phi, vnm, mod_box, seen_b, b_list);
    let delta_bi = mod_box["delta"];
    let delta_int = num_floor(parse_number(str(delta_bi)));

    let bi = 0;
    while bi < len(b_list) {
        let b_c0 = b_list[bi]["c0"];
        let j = 1;
        while j <= delta_int {
            let y_cand = b_c0 + bigint(j);
            if (y_cand % L) == _B0 {
                let x_cand = y_cand / L;
                let tv = _pbf_subst_var(theta_qf, vnm, _plin_const(x_cand));
                if tv["kind"] == "bool" and tv["val"] { return x_cand; }
            }
            j = j + 1;
        }
        bi = bi + 1;
    }

    // Otherwise satisfied in -infinity periodic region: choose K large enough below all upper bounds
    let min_u = _B0;
    let collect_u = fn(node, self_fn) {
        let kd = node["kind"];
        if kd == "lt" {
            if _plin_coeff(node["expr"], vnm) < _B0 {
                let u_val = node["expr"]["c0"];
                if u_val < min_u { min_u = u_val; }
            }
            return;
        }
        if kd == "and" or kd == "or" {
            let u = 0;
            while u < len(node["items"]) {
                self_fn(node["items"][u], self_fn);
                u = u + 1;
            }
        }
    };
    collect_u(norm_phi, collect_u);

    let j = 1;
    while j <= delta_int {
        let k_mult = (_b_abs(min_u) / delta_bi) + _B2;
        let y_cand = bigint(j) - k_mult * delta_bi;
        if (y_cand % L) == _B0 {
            let x_cand = y_cand / L;
            let tv = _pbf_subst_var(theta_qf, vnm, _plin_const(x_cand));
            if tv["kind"] == "bool" and tv["val"] { return x_cand; }
        }
        j = j + 1;
    }
    return _B0;
}

fn _presburger_extract_witness_or_cex(ast, truth_val) {
    let fvs = formula_free_vars(ast);
    if len(fvs) > 0 { return nil; }

    // Unwrap pure existential prefix when truth == true, or universal prefix when truth == false
    if ast["kind"] == "exists" and truth_val {
        let ex_vars = [];
        let cur = ast;
        while cur["kind"] == "exists" {
            push(ex_vars, cur["var_name"]);
            cur = cur["body"];
        }
        let cur_qf = _fol_to_presburger_qf(cur);
        let vals = map{};
        let exact_m = map{};
        let out = map{ kind: "witness", values: vals, exact: exact_m };
        let idx = 0;
        while idx < len(ex_vars) {
            let v_target = ex_vars[idx];
            // Eliminate remaining ex_vars[idx+1 .. end] to isolate 1-var condition on v_target
            let theta = cur_qf;
            let rem_i = len(ex_vars) - 1;
            while rem_i > idx {
                theta = _cooper_elim_exists(ex_vars[rem_i], theta);
                rem_i = rem_i - 1;
            }
            let w_bi = _cooper_find_1var_witness_bi(v_target, theta);
            let w_plain = _bi_to_plain_int_or_bi(w_bi);
            vals[v_target] = w_plain;
            exact_m[v_target] = w_bi;
            if v_target != "kind" and v_target != "values" and v_target != "exact" {
                out[v_target] = w_plain;
            }
            cur_qf = _pbf_subst_var(cur_qf, v_target, _plin_const(w_bi));
            idx = idx + 1;
        }
        return out;
    }

    if ast["kind"] == "forall" and (not truth_val) {
        let fa_vars = [];
        let cur = ast;
        while cur["kind"] == "forall" {
            push(fa_vars, cur["var_name"]);
            cur = cur["body"];
        }
        let neg_qf = _pbf_not(_fol_to_presburger_qf(cur));
        let vals = map{};
        let exact_m = map{};
        let out = map{ kind: "counterexample", values: vals, exact: exact_m };
        let idx = 0;
        while idx < len(fa_vars) {
            let v_target = fa_vars[idx];
            let theta = neg_qf;
            let rem_i = len(fa_vars) - 1;
            while rem_i > idx {
                theta = _cooper_elim_exists(fa_vars[rem_i], theta);
                rem_i = rem_i - 1;
            }
            let w_bi = _cooper_find_1var_witness_bi(v_target, theta);
            let w_plain = _bi_to_plain_int_or_bi(w_bi);
            vals[v_target] = w_plain;
            exact_m[v_target] = w_bi;
            if v_target != "kind" and v_target != "values" and v_target != "exact" {
                out[v_target] = w_plain;
            }
            neg_qf = _pbf_subst_var(neg_qf, v_target, _plin_const(w_bi));
            idx = idx + 1;
        }
        return out;
    }

    return nil;
}

fn presburger_eliminate(formula_or_str, free_vars = nil) {
    let ast = parse_first_order_formula(formula_or_str);
    let fvs = formula_free_vars(ast);
    if free_vars != nil and type(free_vars) == "array" {
        let merged = _copy_str_arr(free_vars);
        let i = 0;
        while i < len(fvs) {
            if not _arr_contains_str(merged, fvs[i]) {
                push(merged, fvs[i]);
            }
            i = i + 1;
        }
        fvs = merged;
    }
    let qf = _fol_to_presburger_qf(ast);
    let elim_str = _pbf_to_str(qf);
    let truth_val = nil;
    if qf["kind"] == "bool" {
        truth_val = qf["val"];
    }
    let cert_en = "Cooper's exact Presburger quantifier elimination over Z produced quantifier-free formula: " + elim_str;
    let cert_el = "Η απαλοιφή ποσοδεικτών Cooper στην αριθμητική Presburger (Z) παρήγαγε ισοδύναμο τύπο χωρίς ποσοδείκτες: " + elim_str;
    return map{
        decidable: true,
        theory: "Presburger Arithmetic (Cooper Quantifier Elimination over Z)",
        truth: truth_val,
        free_vars: fvs,
        eliminated_formula: elim_str,
        eliminated_ir: qf,
        proof_certificate_el: cert_el,
        proof_certificate_en: cert_en
    };
}

fn presburger_decide(formula_or_str) {
    let ast = parse_first_order_formula(formula_or_str);
    let fvs = formula_free_vars(ast);
    let qf = _fol_to_presburger_qf(ast);
    let elim_str = _pbf_to_str(qf);
    let truth_val = nil;
    if qf["kind"] == "bool" {
        truth_val = qf["val"];
    }
    let wit = nil;
    if truth_val != nil {
        wit = _presburger_extract_witness_or_cex(ast, truth_val);
    }

    let cert_en = "Cooper's exact Presburger quantifier elimination over Z reduced formula to '"
        + elim_str + "'";
    let cert_el = "Ο πλήρης αλγόριθμος απαλοιφής ποσοδεικτών του Cooper στην αριθμητική Presburger (Z) απλοποίησε τον τύπο σε '"
        + elim_str + "'";

    return map{
        decidable: true,
        theory: "Presburger Arithmetic (Cooper Quantifier Elimination over Z)",
        truth: truth_val,
        free_vars: fvs,
        eliminated_formula: elim_str,
        witness_or_counterexample: wit,
        witness: wit,
        proof_certificate_el: cert_el,
        proof_certificate_en: cert_en
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE 3: DIOPHANTINE LOCAL-GLOBAL OBSTRUCTION & HASSE-MINKOWSKI ENGINE
// ══════════════════════════════════════════════════════════════════════════════

let _LOCAL_MODULI = [
    map{ m: 2, p: 2, k: 1 },
    map{ m: 3, p: 3, k: 1 },
    map{ m: 4, p: 2, k: 2 },
    map{ m: 5, p: 5, k: 1 },
    map{ m: 7, p: 7, k: 1 },
    map{ m: 8, p: 2, k: 3 },
    map{ m: 9, p: 3, k: 2 },
    map{ m: 11, p: 11, k: 1 },
    map{ m: 13, p: 13, k: 1 },
    map{ m: 16, p: 2, k: 4 },
    map{ m: 25, p: 5, k: 2 },
    map{ m: 27, p: 3, k: 3 }
];

fn _parse_diophantine_poly_Z(poly_or_eq) {
    let f_ast = nil;
    if type(poly_or_eq) == "string" {
        let s = str_trim(poly_or_eq);
        if str_index_of(s, "=") >= 0 {
            f_ast = parse_first_order_formula(s);
        } else {
            f_ast = parse_first_order_formula("(" + s + ") == 0");
        }
    } else if type(poly_or_eq) == "map" {
        if map_has(poly_or_eq, "kind") and poly_or_eq["kind"] == "atom" {
            f_ast = poly_or_eq;
        } else {
            f_ast = map{
                kind: "atom",
                op: "==",
                lhs: poly_or_eq,
                rhs: map{ kind: "num", rat: EX.rat(0, 1) },
                diff: poly_or_eq
            };
        }
    } else {
        throw "diophantine_obstruction_audit: expected polynomial/equation string or AST";
    }

    if f_ast["kind"] != "atom" or f_ast["op"] != "==" {
        throw "diophantine_obstruction_audit: expected polynomial equality P(x_1, ..., x_n) == 0";
    }

    let raw_vars = [];
    _alg_expr_vars(f_ast["diff"], [], raw_vars);
    let vars = _sort_strings(raw_vars);
    let rp = alg_expr_to_rpoly(f_ast["diff"], vars);

    let rat_terms = [];
    _rpoly_to_monomials_rec(rp, [], rat_terms);

    // Clear rational denominators so P in Z[x_1, ..., x_n]
    let lcm_den = _B1;
    let i = 0;
    while i < len(rat_terms) {
        lcm_den = _b_lcm(lcm_den, rat_terms[i]["coeff"]["den"]);
        i = i + 1;
    }

    let z_terms = [];
    let c0_bi = _B0;
    let max_deg = 0;
    let min_nonconst_deg = 999999;
    i = 0;
    while i < len(rat_terms) {
        let rt = rat_terms[i]["coeff"];
        let c_bi = rt["num"] * (lcm_den / rt["den"]);
        let exps = rat_terms[i]["exps"];
        let tdeg = 0;
        let u = 0;
        while u < len(exps) {
            tdeg = tdeg + exps[u];
            u = u + 1;
        }
        if tdeg == 0 {
            c0_bi = c0_bi + c_bi;
        } else {
            if tdeg > max_deg { max_deg = tdeg; }
            if tdeg < min_nonconst_deg { min_nonconst_deg = tdeg; }
            push(z_terms, map{ coeff: c_bi, exps: exps, tdeg: tdeg });
        }
        i = i + 1;
    }

    let is_homog = (c0_bi == _B0) and (len(z_terms) > 0) and (max_deg >= 2) and (max_deg == min_nonconst_deg);

    return map{
        vars: vars,
        rpoly: rp,
        c0: c0_bi,
        nonconst_terms: z_terms,
        max_deg: max_deg,
        is_homogeneous: is_homog,
        poly_str: rpoly_to_str(rp, vars)
    };
}

fn _eval_dioph_z(parsed, pt_bi_arr) {
    let acc = parsed["c0"];
    let terms = parsed["nonconst_terms"];
    let i = 0;
    while i < len(terms) {
        let tm = terms[i];
        let mon = tm["coeff"];
        let exps = tm["exps"];
        let u = 0;
        while u < len(exps) {
            let e = exps[u];
            if e > 0 {
                let xv = pt_bi_arr[u];
                if xv == _B0 {
                    mon = _B0;
                    break;
                }
                let p_acc = _B1;
                let k = 0;
                while k < e {
                    p_acc = p_acc * xv;
                    k = k + 1;
                }
                mon = mon * p_acc;
            }
            u = u + 1;
        }
        acc = acc + mon;
        i = i + 1;
    }
    return acc;
}

fn _mod_pow_int(base_i, exp_i, m_i) {
    let res = 1 % m_i;
    let b = ((base_i % m_i) + m_i) % m_i;
    let e = exp_i;
    while e > 0 {
        let h = num_floor(e / 2);
        if e - 2 * h == 1 {
            res = (res * b) % m_i;
        }
        e = h;
        if e > 0 { b = (b * b) % m_i; }
    }
    return res;
}

fn _bool_set_to_int_list(bset, m_i) {
    let out = [];
    let r = 0;
    while r < m_i {
        if bset[r] { push(out, r); }
        r = r + 1;
    }
    return out;
}

fn _convolve_mod_sets(setA, setB, m_i) {
    let out = [];
    let r = 0;
    while r < m_i { push(out, false); r = r + 1; }
    let a = 0;
    while a < m_i {
        if setA[a] {
            let b = 0;
            while b < m_i {
                if setB[b] {
                    out[(a + b) % m_i] = true;
                }
                b = b + 1;
            }
        }
        a = a + 1;
    }
    return out;
}

// Connected variable components & exact residue-set convolution modulo m_i
fn _check_modular_obstruction(parsed, mod_spec, non_trivial) {
    let m_i = mod_spec["m"];
    let p_i = mod_spec["p"];
    let m_bi = bigint(m_i);
    let n_vars = len(parsed["vars"]);
    let c0_mod = num_floor(parse_number(str(_euclid_mod_bi(parsed["c0"], m_bi))));

    // Filter monomials with coeff % m != 0
    let active_terms = [];
    let var_used = [];
    let u = 0;
    while u < n_vars { push(var_used, false); u = u + 1; }

    let i = 0;
    while i < len(parsed["nonconst_terms"]) {
        let tm = parsed["nonconst_terms"][i];
        let c_m = num_floor(parse_number(str(_euclid_mod_bi(tm["coeff"], m_bi))));
        if c_m != 0 {
            let v_idxs = [];
            u = 0;
            while u < n_vars {
                if tm["exps"][u] > 0 {
                    var_used[u] = true;
                    push(v_idxs, u);
                }
                u = u + 1;
            }
            push(active_terms, map{ c_mod: c_m, exps: tm["exps"], vars: v_idxs });
        }
        i = i + 1;
    }

    if not non_trivial {
        // Partition active variables into connected components
        let visited = [];
        u = 0;
        while u < n_vars { push(visited, false); u = u + 1; }

        let total_set = [];
        let r = 0;
        while r < m_i { push(total_set, false); r = r + 1; }
        total_set[0] = true;

        let comp_Residues = [];
        let start_v = 0;
        while start_v < n_vars {
            if var_used[start_v] and (not visited[start_v]) {
                let comp_vars = [start_v];
                visited[start_v] = true;
                let q_idx = 0;
                while q_idx < len(comp_vars) {
                    let cur_v = comp_vars[q_idx];
                    let ti = 0;
                    while ti < len(active_terms) {
                        let tvars = active_terms[ti]["vars"];
                        let has_cur = false;
                        let vi = 0;
                        while vi < len(tvars) {
                            if tvars[vi] == cur_v { has_cur = true; break; }
                            vi = vi + 1;
                        }
                        if has_cur {
                            vi = 0;
                            while vi < len(tvars) {
                                let nb_v = tvars[vi];
                                if not visited[nb_v] {
                                    visited[nb_v] = true;
                                    push(comp_vars, nb_v);
                                }
                                vi = vi + 1;
                            }
                        }
                        ti = ti + 1;
                    }
                    q_idx = q_idx + 1;
                }

                // Collect terms belonging to this component
                let comp_terms = [];
                let ti = 0;
                while ti < len(active_terms) {
                    let v0 = active_terms[ti]["vars"][0];
                    let ci = 0;
                    while ci < len(comp_vars) {
                        if comp_vars[ci] == v0 {
                            push(comp_terms, active_terms[ti]);
                            break;
                        }
                        ci = ci + 1;
                    }
                    ti = ti + 1;
                }

                let kv = len(comp_vars);
                let tuple_cnt = 1;
                let pw = 0;
                while pw < kv and tuple_cnt <= 65536 {
                    tuple_cnt = tuple_cnt * m_i;
                    pw = pw + 1;
                }
                if tuple_cnt > 32768 {
                    // Component too large for exhaustive mod-m table; skip cleanly
                    return nil;
                }

                let c_set = [];
                r = 0;
                while r < m_i { push(c_set, false); r = r + 1; }

                let tup = [];
                pw = 0;
                while pw < kv { push(tup, 0); pw = pw + 1; }

                let idx_t = 0;
                while idx_t < tuple_cnt {
                    let sum_m = 0;
                    ti = 0;
                    while ti < len(comp_terms) {
                        let ctm = comp_terms[ti];
                        let prod_m = ctm["c_mod"];
                        let ci = 0;
                        while ci < kv {
                            let v_global = comp_vars[ci];
                            let ev = ctm["exps"][v_global];
                            if ev > 0 {
                                prod_m = (prod_m * _mod_pow_int(tup[ci], ev, m_i)) % m_i;
                            }
                            ci = ci + 1;
                        }
                        sum_m = (sum_m + prod_m) % m_i;
                        ti = ti + 1;
                    }
                    c_set[sum_m] = true;

                    // Increment base-m_i counter `tup`
                    let carry_pos = 0;
                    while carry_pos < kv {
                        tup[carry_pos] = tup[carry_pos] + 1;
                        if tup[carry_pos] < m_i { break; }
                        tup[carry_pos] = 0;
                        carry_pos = carry_pos + 1;
                    }
                    idx_t = idx_t + 1;
                }

                let c_vnames = [];
                let ci = 0;
                while ci < kv { push(c_vnames, parsed["vars"][comp_vars[ci]]); ci = ci + 1; }
                push(comp_Residues, map{
                    vars: c_vnames,
                    residues: _bool_set_to_int_list(c_set, m_i)
                });
                total_set = _convolve_mod_sets(total_set, c_set, m_i);
            }
            start_v = start_v + 1;
        }

        let target_neg_c0 = (m_i - c0_mod) % m_i;
        if not total_set[target_neg_c0] {
            let nonconst_residues = _bool_set_to_int_list(total_set, m_i);
            return map{
                obstructed: true,
                modulus: m_i,
                prime: p_i,
                exponent: mod_spec["k"],
                target_residue: target_neg_c0,
                achievable_nonconst_residues: nonconst_residues,
                component_residues: comp_Residues
            };
        }
        return nil;
    }

    // Primitive local check (`non_trivial == true` on homogeneous form):
    // Track `set_zero_p` (all component vars == 0 mod p_i) and `set_prim_p` (some var != 0 mod p_i)
    // Include unused variables too (an unused var could be chosen == 1 mod p_i, making `zero_p` liftable to `prim_p`!)
    let has_unused_var = false;
    u = 0;
    while u < n_vars {
        if not var_used[u] { has_unused_var = true; }
        u = u + 1;
    }
    if has_unused_var {
        // Setting unused var = 1 and all active vars = 0 gives (0,..,1,..,0) != 0 mod p with P == 0 mod m!
        return nil;
    }

    let visited = [];
    u = 0;
    while u < n_vars { push(visited, false); u = u + 1; }

    let tot_zero = [];
    let tot_prim = [];
    let r = 0;
    while r < m_i {
        push(tot_zero, false);
        push(tot_prim, false);
        r = r + 1;
    }
    tot_zero[0] = true;

    let start_v = 0;
    while start_v < n_vars {
        if not visited[start_v] {
            let comp_vars = [start_v];
            visited[start_v] = true;
            let q_idx = 0;
            while q_idx < len(comp_vars) {
                let cur_v = comp_vars[q_idx];
                let ti = 0;
                while ti < len(active_terms) {
                    let tvars = active_terms[ti]["vars"];
                    let has_cur = false;
                    let vi = 0;
                    while vi < len(tvars) {
                        if tvars[vi] == cur_v { has_cur = true; break; }
                        vi = vi + 1;
                    }
                    if has_cur {
                        vi = 0;
                        while vi < len(tvars) {
                            let nb_v = tvars[vi];
                            if not visited[nb_v] {
                                visited[nb_v] = true;
                                push(comp_vars, nb_v);
                            }
                            vi = vi + 1;
                        }
                    }
                    ti = ti + 1;
                }
                q_idx = q_idx + 1;
            }

            let comp_terms = [];
            let ti = 0;
            while ti < len(active_terms) {
                let v0 = active_terms[ti]["vars"][0];
                let ci = 0;
                while ci < len(comp_vars) {
                    if comp_vars[ci] == v0 {
                        push(comp_terms, active_terms[ti]);
                        break;
                    }
                    ci = ci + 1;
                }
                ti = ti + 1;
            }

            let kv = len(comp_vars);
            let tuple_cnt = 1;
            let pw = 0;
            while pw < kv and tuple_cnt <= 65536 {
                tuple_cnt = tuple_cnt * m_i;
                pw = pw + 1;
            }
            if tuple_cnt > 32768 { return nil; }

            let c_zero = [];
            let c_prim = [];
            r = 0;
            while r < m_i {
                push(c_zero, false);
                push(c_prim, false);
                r = r + 1;
            }

            let tup = [];
            pw = 0;
            while pw < kv { push(tup, 0); pw = pw + 1; }

            let idx_t = 0;
            while idx_t < tuple_cnt {
                let all_div_p = true;
                let ci = 0;
                while ci < kv {
                    if (tup[ci] % p_i) != 0 {
                        all_div_p = false;
                        break;
                    }
                    ci = ci + 1;
                }
                let sum_m = 0;
                ti = 0;
                while ti < len(comp_terms) {
                    let ctm = comp_terms[ti];
                    let prod_m = ctm["c_mod"];
                    ci = 0;
                    while ci < kv {
                        let v_global = comp_vars[ci];
                        let ev = ctm["exps"][v_global];
                        if ev > 0 {
                            prod_m = (prod_m * _mod_pow_int(tup[ci], ev, m_i)) % m_i;
                        }
                        ci = ci + 1;
                    }
                    sum_m = (sum_m + prod_m) % m_i;
                    ti = ti + 1;
                }
                if all_div_p { c_zero[sum_m] = true; }
                else { c_prim[sum_m] = true; }

                let carry_pos = 0;
                while carry_pos < kv {
                    tup[carry_pos] = tup[carry_pos] + 1;
                    if tup[carry_pos] < m_i { break; }
                    tup[carry_pos] = 0;
                    carry_pos = carry_pos + 1;
                }
                idx_t = idx_t + 1;
            }

            let next_zero = _convolve_mod_sets(tot_zero, c_zero, m_i);
            let p1 = _convolve_mod_sets(tot_zero, c_prim, m_i);
            let p2 = _convolve_mod_sets(tot_prim, c_zero, m_i);
            let p3 = _convolve_mod_sets(tot_prim, c_prim, m_i);
            let next_prim = [];
            r = 0;
            while r < m_i {
                push(next_prim, p1[r] or p2[r] or p3[r]);
                r = r + 1;
            }
            tot_zero = next_zero;
            tot_prim = next_prim;
        }
        start_v = start_v + 1;
    }

    let target_neg_c0 = (m_i - c0_mod) % m_i;
    if not tot_prim[target_neg_c0] {
        return map{
            obstructed: true,
            primitive_obstruction: true,
            modulus: m_i,
            prime: p_i,
            exponent: mod_spec["k"],
            target_residue: target_neg_c0,
            achievable_primitive_residues: _bool_set_to_int_list(tot_prim, m_i)
        };
    }
    return nil;
}

fn _vp_valuation(n_bi, p_bi) {
    let x = _b_abs(n_bi);
    if x == _B0 { return 999999; }
    let v = 0;
    while (x % p_bi) == _B0 {
        x = x / p_bi;
        v = v + 1;
    }
    return v;
}

fn diophantine_obstruction_audit(poly_or_eq, opts = nil) {
    let parsed = _parse_diophantine_poly_Z(poly_or_eq);
    let vars = parsed["vars"];
    let n = len(vars);
    let c0 = parsed["c0"];
    let terms = parsed["nonconst_terms"];

    let non_trivial = parsed["is_homogeneous"];
    if opts != nil and type(opts) == "map" and map_has(opts, "non_trivial") {
        non_trivial = opts["non_trivial"];
    }

    // Degenerate constant equation check
    if len(terms) == 0 {
        if c0 == _B0 {
            return map{
                status: "found_integer_witness",
                obstruction_type: "none",
                certificate: "Identically zero polynomial 0 == 0 holds for all integers.",
                witness: map{}
            };
        }
        return map{
            status: "proved_no_integer_solution",
            obstruction_type: "constant_contradiction",
            certificate: "Non-zero constant " + str(c0) + " == 0 has no solutions.",
            witness: nil
        };
    }

    // 1. Archimedean (R) Positivity / Negativity Obstruction
    if not non_trivial {
        let all_pos_even = (c0 > _B0);
        let all_neg_even = (c0 < _B0);
        let i = 0;
        while i < len(terms) {
            let tm = terms[i];
            let even_exps = true;
            let u = 0;
            while u < len(tm["exps"]) {
                if (tm["exps"][u] % 2) != 0 { even_exps = false; break; }
                u = u + 1;
            }
            if (not even_exps) or tm["coeff"] < _B0 { all_pos_even = false; }
            if (not even_exps) or tm["coeff"] > _B0 { all_neg_even = false; }
            i = i + 1;
        }
        if all_pos_even or all_neg_even {
            let dir_s = "> 0";
            if all_neg_even { dir_s = "< 0"; }
            let cert_r = "Archimedean (R) positivity obstruction: every variable monomial has even exponents with uniform sign, so "
                + parsed["poly_str"] + " " + dir_s + " for all real tuples in R^" + str(n) + " (hence ZERO integer solutions).";
            return map{
                status: "proved_no_integer_solution",
                obstruction_type: "archimedean_real",
                place: "R",
                certificate: cert_r,
                certificate_el: "Αρχιμήδειο εμπόδιο θετικότητας στον R: " + parsed["poly_str"] + " " + dir_s + " για κάθε πραγματική πλειάδα, άρα μηδέν ακέραιες λύσεις.",
                witness: nil
            };
        }
    }

    // Exact CAD Archimedean check for n <= 2 and degree <= 4
    if n >= 1 and n <= 2 and parsed["max_deg"] <= 4 {
        let r_query = "";
        if non_trivial {
            let nz_parts = [];
            let u = 0;
            while u < n { push(nz_parts, vars[u] + " != 0"); u = u + 1; }
            let q_pref = "";
            u = 0;
            while u < n { q_pref = q_pref + "exists " + vars[u] + ": "; u = u + 1; }
            r_query = q_pref + "((" + _join_strs(nz_parts, " or ") + ") and (" + parsed["poly_str"] + " == 0))";
        } else {
            let q_pref = "";
            let u = 0;
            while u < n { q_pref = q_pref + "exists " + vars[u] + ": "; u = u + 1; }
            r_query = q_pref + "(" + parsed["poly_str"] + " == 0)";
        }
        let cad_r = cad_decide(r_query);
        if cad_r["truth"] == false {
            let cert_cad = "Archimedean (R) Tarski-Seidenberg CAD obstruction: proved zero real solutions in R^"
                + str(n) + " across " + str(cad_r["cell_count"]) + " cylindrical cells, hence zero integer solutions.";
            return map{
                status: "proved_no_integer_solution",
                obstruction_type: "archimedean_real",
                place: "R",
                certificate: cert_cad,
                certificate_el: "Αρχιμήδειο εμπόδιο στον R μέσω πλήρους CAD: δεν υπάρχουν πραγματικές λύσεις, άρα ούτε ακέραιες.",
                witness: nil
            };
        }
    }

    // 2. Z-Content / Non-Constant Monomial GCD Obstruction
    if (not non_trivial) and c0 != _B0 {
        let g_nc = _B0;
        let i = 0;
        while i < len(terms) {
            g_nc = _b_gcd(g_nc, terms[i]["coeff"]);
            i = i + 1;
        }
        if g_nc > _B1 and (_b_abs(c0) % g_nc) != _B0 {
            let cert_gcd = "Z-content GCD obstruction: gcd of non-constant monomial coefficients is "
                + str(g_nc) + ", which does not divide constant term |" + str(c0) + "| (" + str(g_nc) + " !| " + str(_b_abs(c0)) + ").";
            return map{
                status: "proved_no_integer_solution",
                obstruction_type: "Z_gcd_content",
                place: "Z",
                gcd: _bi_to_plain_int_or_bi(g_nc),
                constant_term: _bi_to_plain_int_or_bi(c0),
                certificate: cert_gcd,
                certificate_el: "Εμπόδιο ΜΚΔ στον Z: ο ΜΚΔ των μη-σταθερών συντελεστών (" + str(g_nc) + ") δεν διαιρεί τον σταθερό όρο " + str(c0) + ".",
                witness: nil
            };
        }
    }

    // 3a. Exact p-adic Valuation Parity Certificate for 2-term homogeneous equations a*x^d + b*y^d == 0
    if non_trivial and c0 == _B0 and len(terms) == 2 and n == 2 {
        let t0 = terms[0];
        let t1 = terms[1];
        let d_deg = parsed["max_deg"];
        if ((t0["exps"][0] == d_deg and t1["exps"][1] == d_deg) or (t0["exps"][1] == d_deg and t1["exps"][0] == d_deg)) {
            let prod_ab = _b_abs(t0["coeff"] * t1["coeff"]);
            if prod_ab > _B1 {
                let pfacs = EX.prime_factorization(prod_ab);
                let fi = 0;
                while fi < len(pfacs) {
                    let p_bi = pfacs[fi]["prime"];
                    let va = _vp_valuation(t0["coeff"], p_bi);
                    let vb = _vp_valuation(t1["coeff"], p_bi);
                    if (va % d_deg) != (vb % d_deg) {
                        let p_num = _bi_to_plain_int_or_bi(p_bi);
                        let cert_vp = str(p_bi) + "-adic valuation parity obstruction: v_" + str(p_bi)
                            + "(" + str(t0["coeff"]) + ") = " + str(va) + " !== v_" + str(p_bi)
                            + "(" + str(_B0 - t1["coeff"]) + ") = " + str(vb) + " (mod " + str(d_deg)
                            + "), proving " + parsed["poly_str"] + " == 0 has NO non-trivial integer or Q_" + str(p_bi) + " solutions.";
                        return map{
                            status: "proved_no_integer_solution",
                            obstruction_type: "p_adic_valuation_parity",
                            place: "Q_" + str(p_bi),
                            prime: p_num,
                            modulus: p_num,
                            certificate: cert_vp,
                            certificate_el: "Εμπόδιο ισοτιμίας " + str(p_bi) + "-αδικής αποτίμησης: μηδέν μη-τετριμμένες λύσεις στο Z.",
                            witness: nil
                        };
                    }
                    fi = fi + 1;
                }
            }
        }
    }

    // 3b. Local Z/mZ & Prime-Power Hensel Residue Obstruction across m in {2,3,4,5,7,8,9,11,13,16,25,27}
    let solvable_prime_base = map{};
    let mi = 0;
    while mi < len(_LOCAL_MODULI) {
        let mspec = _LOCAL_MODULI[mi];
        let obs = _check_modular_obstruction(parsed, mspec, non_trivial);
        if obs != nil and obs["obstructed"] {
            let m_val = obs["modulus"];
            let p_val = obs["prime"];
            let k_val = obs["exponent"];
            let hensel_note = "";
            if k_val >= 2 and map_has(solvable_prime_base, str(p_val)) {
                hensel_note = " (Hensel lifting obstruction: solvable mod " + str(p_val) + " but singular roots fail to lift to Z/" + str(m_val) + "Z)";
            }

            let cert_mod = "";
            if map_has(obs, "primitive_obstruction") and obs["primitive_obstruction"] {
                cert_mod = "Local " + str(p_val) + "-adic / primitive mod " + str(m_val) + " Hasse-Minkowski obstruction" + hensel_note
                    + ": primitive tuple residues of " + parsed["poly_str"] + " modulo " + str(m_val)
                    + " are {" + _join_strs(obs["achievable_primitive_residues"], ", ")
                    + "}, excluding " + str(obs["target_residue"]) + " (mod " + str(m_val) + ").";
            } else {
                let comp_descs = [];
                let ci = 0;
                while ci < len(obs["component_residues"]) {
                    let cr = obs["component_residues"][ci];
                    push(comp_descs, "{" + _join_strs(cr["residues"], ", ") + "}");
                    ci = ci + 1;
                }
                cert_mod = "Local mod " + str(m_val) + " residue obstruction" + hensel_note + ": "
                    + _join_strs(comp_descs, " + ") + " == {"
                    + _join_strs(obs["achievable_nonconst_residues"], ", ") + "} != "
                    + str(obs["target_residue"]) + " (mod " + str(m_val) + "), proving ZERO integer solutions.";
            }

            return map{
                status: "proved_no_integer_solution",
                obstruction_type: "local_modular_obstruction",
                place: "Z/" + str(m_val) + "Z",
                modulus: m_val,
                prime: p_val,
                exponent: k_val,
                details: obs,
                certificate: cert_mod,
                certificate_el: "Τοπικό αριθμητικό εμπόδιο modulo " + str(m_val) + ": το σύνολο υπολοίπων αποκλείει το 0 (mod " + str(m_val) + "), άρα μηδέν ακέραιες λύσεις.",
                witness: nil
            };
        } else {
            if mspec["k"] == 1 {
                solvable_prime_base[str(mspec["p"])] = true;
            }
        }
        mi = mi + 1;
    }

    // 4. Locally Unobstructed: Run Smart Bounded Integer Witness Search
    let max_box = 12;
    if n == 1 { max_box = 200; }
    else if n == 2 { max_box = 50; }
    else if n == 3 { max_box = 14; }
    else if n >= 4 { max_box = 6; }
    if opts != nil and type(opts) == "map" and map_has(opts, "search_bound") {
        max_box = num_floor(opts["search_bound"]);
    }

    // Check if any variable appears ONLY linearly in a single monomial `a * x_lin` — if so, solve for it directly!
    let lin_var_idx = -1;
    let lin_var_coeff = _B0;
    let v_cand = n - 1;
    while v_cand >= 0 {
        let count_occ = 0;
        let deg1_ok = true;
        let coef_v = _B0;
        let ti = 0;
        while ti < len(terms) {
            let ev = terms[ti]["exps"][v_cand];
            if ev > 0 {
                count_occ = count_occ + 1;
                if ev != 1 or terms[ti]["tdeg"] != 1 {
                    deg1_ok = false;
                    break;
                }
                coef_v = terms[ti]["coeff"];
            }
            ti = ti + 1;
        }
        if count_occ == 1 and deg1_ok and coef_v != _B0 {
            lin_var_idx = v_cand;
            lin_var_coeff = coef_v;
            break;
        }
        v_cand = v_cand - 1;
    }

    // Build candidate coordinate list [0, 1, -1, 2, -2, ..., max_box, -max_box]
    let cands = [_B0];
    let b_step = 1;
    while b_step <= max_box {
        push(cands, bigint(b_step));
        push(cands, bigint(0 - b_step));
        b_step = b_step + 1;
    }

    let free_indices = [];
    let u = 0;
    while u < n {
        if u != lin_var_idx { push(free_indices, u); }
        u = u + 1;
    }

    let kf = len(free_indices);
    if kf == 0 and lin_var_idx >= 0 {
        if (_b_abs(c0) % _b_abs(lin_var_coeff)) == _B0 {
            let z_val = (_B0 - c0) / lin_var_coeff;
            if (not non_trivial) or z_val != _B0 {
                let wmap = map{};
                wmap[vars[lin_var_idx]] = _bi_to_plain_int_or_bi(z_val);
                return map{
                    status: "found_integer_witness",
                    obstruction_type: "none",
                    certificate: "Solved exact linear Diophantine witness.",
                    witness: wmap
                };
            }
        }
    } else {
        // Trim cands length if kf is large so total tuples <= 12000
        let use_cands = cands;
        let max_per_dim = len(cands);
        if kf == 3 and max_per_dim > 23 { max_per_dim = 23; }
        if kf == 4 and max_per_dim > 11 { max_per_dim = 11; }
        if kf >= 5 and max_per_dim > 5 { max_per_dim = 5; }
        if max_per_dim < len(cands) {
            use_cands = [];
            let ci = 0;
            while ci < max_per_dim { push(use_cands, cands[ci]); ci = ci + 1; }
        }

        let rad = len(use_cands);
        let total_t = 1;
        let pi = 0;
        while pi < kf and total_t <= 20000 {
            total_t = total_t * rad;
            pi = pi + 1;
        }

        if total_t <= 20000 {
            let dig = [];
            pi = 0;
            while pi < kf { push(dig, 0); pi = pi + 1; }
            let pt = [];
            u = 0;
            while u < n { push(pt, _B0); u = u + 1; }

            let it = 0;
            while it < total_t {
                pi = 0;
                while pi < kf {
                    pt[free_indices[pi]] = use_cands[dig[pi]];
                    pi = pi + 1;
                }
                if lin_var_idx >= 0 {
                    pt[lin_var_idx] = _B0;
                    let rem_val = _eval_dioph_z(parsed, pt);
                    if (_b_abs(rem_val) % _b_abs(lin_var_coeff)) == _B0 {
                        pt[lin_var_idx] = (_B0 - rem_val) / lin_var_coeff;
                        let ok_nt = true;
                        if non_trivial {
                            ok_nt = false;
                            u = 0;
                            while u < n {
                                if pt[u] != _B0 { ok_nt = true; break; }
                                u = u + 1;
                            }
                        }
                        if ok_nt and _eval_dioph_z(parsed, pt) == _B0 {
                            let wmap = map{};
                            u = 0;
                            while u < n {
                                wmap[vars[u]] = _bi_to_plain_int_or_bi(pt[u]);
                                u = u + 1;
                            }
                            return map{
                                status: "found_integer_witness",
                                obstruction_type: "none",
                                certificate: "Locally unobstructed and verified exact integer witness satisfying " + parsed["poly_str"] + " == 0.",
                                witness: wmap
                            };
                        }
                    }
                } else {
                    let ok_nt = true;
                    if non_trivial {
                        ok_nt = false;
                        u = 0;
                        while u < n {
                            if pt[u] != _B0 { ok_nt = true; break; }
                            u = u + 1;
                        }
                    }
                    if ok_nt and _eval_dioph_z(parsed, pt) == _B0 {
                        let wmap = map{};
                        u = 0;
                        while u < n {
                            wmap[vars[u]] = _bi_to_plain_int_or_bi(pt[u]);
                            u = u + 1;
                        }
                        return map{
                            status: "found_integer_witness",
                            obstruction_type: "none",
                            certificate: "Locally unobstructed and verified exact integer witness satisfying " + parsed["poly_str"] + " == 0.",
                            witness: wmap
                        };
                    }
                }

                let cpos = 0;
                while cpos < kf {
                    dig[cpos] = dig[cpos] + 1;
                    if dig[cpos] < rad { break; }
                    dig[cpos] = 0;
                    cpos = cpos + 1;
                }
                it = it + 1;
            }
        }
    }

    let cert_open = "Locally unobstructed across R, Z-content, and Z/mZ for m in {2,3,4,5,7,8,9,11,13,16,25,27}; "
        + "no witness in bounded box [-" + str(max_box) + ", " + str(max_box) + "]^" + str(n)
        + ". By Matiyasevich's MRDP Theorem (Hilbert's 10th Problem) & potential Hasse-Minkowski failures on degree >= 3 surfaces, general Z-solvability is undecidable without specialized global descent.";
    return map{
        status: "locally_unobstructed_undecidable_in_general",
        obstruction_type: "none_detected_locally",
        tested_moduli: [2, 3, 4, 5, 7, 8, 9, 11, 13, 16, 25, 27],
        certificate: cert_open,
        certificate_el: "Χωρίς τοπικό εμπόδιο στους R και Z/mZ· γενικά μη αποφασίσιμο βάσει θεωρήματος MRDP (10ο Πρόβλημα Hilbert) / πιθανής αστοχίας αρχής Hasse.",
        witness: nil
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// ENGINE 4: EXACT ALGEBRAIC NUMBERS Q-BAR & LLL / INTEGER RELATION FINDER
// ══════════════════════════════════════════════════════════════════════════════

fn _to_rat_elem(x) {
    let tx = type(x);
    if tx == "map" and map_has(x, "kind") and x["kind"] == "rat" { return x; }
    if tx == "bigint" { return EX.rat(x, _B1); }
    if tx == "number" {
        if num_floor(x) == x and num_abs(x) < 9007199254740991.0 {
            return EX.rat(bigint(x), _B1);
        }
        return EX.best_rational(x, 1000000000);
    }
    if tx == "string" { return EX.rat_from_str(x); }
    throw "_to_rat_elem: unsupported value type " + tx;
}

fn _vec_dot_rat(u, v) {
    let acc = EX.rat(0, 1);
    let i = 0;
    while i < len(u) {
        acc = EX.rat_add(acc, EX.rat_mul(u[i], v[i]));
        i = i + 1;
    }
    return acc;
}

fn _vec_sub_scaled_rat(u, v, scale_r) {
    if EX.rat_is_zero(scale_r) { return u; }
    let out = [];
    let i = 0;
    while i < len(u) {
        push(out, EX.rat_sub(u[i], EX.rat_mul(scale_r, v[i])));
        i = i + 1;
    }
    return out;
}

fn _compute_exact_gso(rows) {
    let m = len(rows);
    let b_star = [];
    let B_norms = [];
    let mu = [];
    let i = 0;
    while i < m {
        let mu_row = [];
        let j = 0;
        while j < m {
            if i == j { push(mu_row, EX.rat(1, 1)); }
            else { push(mu_row, EX.rat(0, 1)); }
            j = j + 1;
        }
        let v = rows[i];
        j = 0;
        while j < i {
            if not EX.rat_is_zero(B_norms[j]) {
                let mij = EX.rat_div(_vec_dot_rat(rows[i], b_star[j]), B_norms[j]);
                mu_row[j] = mij;
                v = _vec_sub_scaled_rat(v, b_star[j], mij);
            }
            j = j + 1;
        }
        push(b_star, v);
        push(B_norms, _vec_dot_rat(v, v));
        push(mu, mu_row);
        i = i + 1;
    }
    return map{ b_star: b_star, B: B_norms, mu: mu };
}

// Exact-Rational Lenstra-Lenstra-Lovasz (`LLL`, default delta = 3/4) Lattice Basis Reduction
// over Z^n or Q^n (zero floating-point cancellation at arbitrary bit-scales!).
fn lll_reduce(basis, delta = nil) {
    if type(basis) != "array" or len(basis) == 0 {
        throw "lll_reduce: expected non-empty array of basis vectors";
    }
    let m = len(basis);
    let n = len(basis[0]);
    if m > MAX_LLL_DIM or n > MAX_LLL_DIM {
        throw "lll_reduce: dimension exceeds MAX_LLL_DIM (" + str(MAX_LLL_DIM) + ")";
    }

    let delta_r = EX.rat(3, 4);
    if delta != nil {
        delta_r = _to_rat_elem(delta);
    }
    if EX.rat_cmp(delta_r, EX.rat(1, 4)) <= 0 or EX.rat_cmp(delta_r, EX.rat(1, 1)) >= 0 {
        throw "lll_reduce: Lovasz parameter delta must satisfy 1/4 < delta < 1";
    }

    let rows = [];
    let all_integral = true;
    let i = 0;
    while i < m {
        if len(basis[i]) != n {
            throw "lll_reduce: basis rows must have uniform length";
        }
        let r_vec = [];
        let j = 0;
        while j < n {
            let rv = _to_rat_elem(basis[i][j]);
            if rv["den"] != _B1 { all_integral = false; }
            push(r_vec, rv);
            j = j + 1;
        }
        push(rows, r_vec);
        i = i + 1;
    }

    let gso = _compute_exact_gso(rows);
    let B_norms = gso["B"];
    let mu = gso["mu"];
    let half_r = EX.rat(1, 2);

    let k = 1;
    let swaps = 0;
    let steps = 0;
    while k < m {
        steps = steps + 1;
        _guard_op(steps, "lll_reduce");

        // 1. Size reduction of b_k against b_{k-1}, ..., b_0
        let j = k - 1;
        while j >= 0 {
            let q_bi = EX.rat_floor(EX.rat_add(mu[k][j], half_r));
            if q_bi != _B0 {
                let q_r = EX.rat(q_bi, _B1);
                rows[k] = _vec_sub_scaled_rat(rows[k], rows[j], q_r);
                mu[k][j] = EX.rat_sub(mu[k][j], q_r);
                let l_idx = 0;
                while l_idx < j {
                    mu[k][l_idx] = EX.rat_sub(mu[k][l_idx], EX.rat_mul(q_r, mu[j][l_idx]));
                    l_idx = l_idx + 1;
                }
            }
            j = j - 1;
        }

        // 2. Lovasz Condition: B_k >= (delta - mu_{k, k-1}^2) * B_{k-1}
        let mu_kk1 = mu[k][k - 1];
        let mu_sq = EX.rat_mul(mu_kk1, mu_kk1);
        let rhs_lovasz = EX.rat_mul(EX.rat_sub(delta_r, mu_sq), B_norms[k - 1]);

        if EX.rat_cmp(B_norms[k], rhs_lovasz) >= 0 {
            k = k + 1;
        } else {
            let tmp = rows[k];
            rows[k] = rows[k - 1];
            rows[k - 1] = tmp;
            swaps = swaps + 1;
            gso = _compute_exact_gso(rows);
            B_norms = gso["B"];
            mu = gso["mu"];
            if k > 1 { k = k - 1; }
            else { k = 1; }
        }
    }

    let plain_rows = [];
    i = 0;
    while i < m {
        let pr = [];
        let j = 0;
        while j < n {
            let r_ij = rows[i][j];
            if all_integral and r_ij["den"] == _B1 {
                push(pr, _bi_to_plain_int_or_bi(r_ij["num"]));
            } else if r_ij["den"] == _B1 {
                push(pr, _bi_to_plain_int_or_bi(r_ij["num"]));
            } else {
                push(pr, EX.rat_to_float(r_ij));
            }
            j = j + 1;
        }
        push(plain_rows, pr);
        i = i + 1;
    }

    return map{
        basis: plain_rows,
        reduced_basis: plain_rows,
        exact_basis: rows,
        gram_schmidt_norms_sq: B_norms,
        delta: delta_r,
        swaps: swaps,
        lovasz_verified: true,
        is_lll_reduced: true
    };
}

// Integer Relation & Minimal Polynomial Recovery via Exact-Rational LLL (`find_integer_relation`)
fn find_integer_relation(real_vec, scale = 1e12) {
    let n = len(real_vec);
    if n < 2 {
        throw "find_integer_relation: real_vec must contain at least 2 elements";
    }
    if n + 1 > MAX_LLL_DIM {
        throw "find_integer_relation: vector length exceeds MAX_LLL_DIM";
    }

    // Support large scale cleanly in exact bigint
    let scale_bi = _B1;
    if type(scale) == "bigint" {
        scale_bi = _b_abs(scale);
    } else {
        scale_bi = bigint(num_round(scale));
    }
    if scale_bi < bigint(1000) { scale_bi = bigint(1000000000000); }

    let float_vals = [];
    let scaled_ints = [];
    let i = 0;
    while i < n {
        let xi = real_vec[i];
        if type(xi) == "number" {
            push(float_vals, xi);
            let ip_f = num_floor(xi);
            let fp_f = xi - ip_f;
            let two52_f = 4503599627370496.0;
            let two52_bi = bigint(4503599627370496);
            let dyadic_r = EX.rat_add(
                EX.rat(bigint(ip_f), _B1),
                EX.rat(bigint(num_round(fp_f * two52_f)), two52_bi)
            );
            let prod_r = EX.rat_mul(dyadic_r, EX.rat(scale_bi, _B1));
            let near_bi = EX.rat_floor(EX.rat_add(prod_r, EX.rat(1, 2)));
            push(scaled_ints, near_bi);
        } else {
            let rx = _to_rat_elem(xi);
            push(float_vals, EX.rat_to_float(rx));
            let prod_r = EX.rat_mul(rx, EX.rat(scale_bi, _B1));
            push(scaled_ints, EX.rat_floor(EX.rat_add(prod_r, EX.rat(1, 2))));
        }
        i = i + 1;
    }

    // Build n x (n + 1) integer lattice basis: [ e_i | round(scale * x_i) ]
    let lat = [];
    i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n {
            if i == j { push(row, _B1); }
            else { push(row, _B0); }
            j = j + 1;
        }
        push(row, scaled_ints[i]);
        push(lat, row);
        i = i + 1;
    }

    let red = lll_reduce(lat, EX.rat(3, 4));
    let e_basis = red["exact_basis"];

    // Pick shortest valid integer relation vector (first non-zero coeff prefix with minimal L2 coeff + residual)
    let best_rel_bi = nil;
    let best_score = 1e300;
    let r_idx = 0;
    while r_idx < len(e_basis) {
        let rvec = e_basis[r_idx];
        let g = _B0;
        let coeff_sq_sum = 0.0;
        i = 0;
        while i < n {
            let ci = rvec[i]["num"];
            g = _b_gcd(g, ci);
            let cf = EX.rat_to_float(rvec[i]);
            coeff_sq_sum = coeff_sq_sum + cf * cf;
            i = i + 1;
        }
        if g > _B0 {
            let norm_cs = [];
            let last_nz = 0;
            i = 0;
            while i < n {
                let ci = rvec[i]["num"] / g;
                push(norm_cs, ci);
                if ci != _B0 { last_nz = i; }
                i = i + 1;
            }
            if norm_cs[last_nz] < _B0 {
                i = 0;
                while i < n {
                    norm_cs[i] = _B0 - norm_cs[i];
                    i = i + 1;
                }
            }
            // Compute actual residual sum_i c_i * x_i
            let res_f = 0.0;
            i = 0;
            while i < n {
                res_f = res_f + (parse_number(str(norm_cs[i])) * float_vals[i]);
                i = i + 1;
            }
            let sc = num_sqrt(coeff_sq_sum) + num_abs(res_f) * 1e9;
            if best_rel_bi == nil or sc < best_score {
                best_rel_bi = norm_cs;
                best_score = sc;
            }
        }
        r_idx = r_idx + 1;
    }

    let plain_rel = [];
    let desc_rel = [];
    let rat_poly_asc = [];
    let res_check = 0.0;
    i = 0;
    while i < n {
        let pv = _bi_to_plain_int_or_bi(best_rel_bi[i]);
        push(plain_rel, pv);
        push(rat_poly_asc, EX.rat(best_rel_bi[i], _B1));
        res_check = res_check + (parse_number(str(best_rel_bi[i])) * float_vals[i]);
        i = i + 1;
    }
    i = n - 1;
    while i >= 0 {
        push(desc_rel, plain_rel[i]);
        i = i - 1;
    }

    let found_ok = num_abs(res_check) <= (1000.0 / EX.rat_to_float(EX.rat(scale_bi, _B1))) + 1e-7;

    return map{
        found: found_ok,
        relation: plain_rel,
        coeffs: plain_rel,
        coeffs_asc: plain_rel,
        coeffs_desc: desc_rel,
        residual: num_abs(res_check),
        polynomial_unicode: EX.poly_to_unicode(rat_poly_asc, "x"),
        polynomial_latex: EX.poly_to_latex(rat_poly_asc, "x")
    };
}

// ── Exact Real Algebraic Numbers `Q-bar cap R` (`algebraic_number`, `alg_*`) ──
// Canonical representation:
//   `map{ kind: "alg_num", minpoly: [c_0..c_d] (monic irreducible in Q[x]), lo: rat, hi: rat, is_rational: bool, rat: rat|nil }`

fn _alg_tighten_once(a) {
    if a["is_rational"] { return a; }
    let mp = a["minpoly"];
    let lo = a["lo"];
    let hi = a["hi"];
    let mid = EX.rat_mul(EX.rat_add(lo, hi), EX.rat(1, 2));
    let vm = EX.poly_eval_rat(mp, mid);
    if EX.rat_is_zero(vm) {
        return map{
            kind: "alg_num",
            minpoly: [EX.rat_neg(mid), EX.rat(1, 1)],
            lo: mid,
            hi: mid,
            is_rational: true,
            rat: mid
        };
    }
    let vlo = EX.poly_eval_rat(mp, lo);
    if _b_sign(vlo["num"]) == _b_sign(vm["num"]) {
        lo = mid;
    } else {
        hi = mid;
    }
    return map{
        kind: "alg_num",
        minpoly: mp,
        lo: lo,
        hi: hi,
        is_rational: false,
        rat: nil
    };
}

fn _alg_select_irreducible_factor(poly_q, lo_r, hi_r) {
    let pa = EX.poly_monic(EX.poly_sqfree(poly_q));
    if len(pa) <= 1 {
        throw "algebraic_number: constant polynomial has no roots";
    }
    // Check exact endpoints first
    if EX.rat_is_zero(EX.poly_eval_rat(pa, lo_r)) {
        return map{
            kind: "alg_num",
            minpoly: [EX.rat_neg(lo_r), EX.rat(1, 1)],
            lo: lo_r,
            hi: lo_r,
            is_rational: true,
            rat: lo_r
        };
    }
    if EX.rat_is_zero(EX.poly_eval_rat(pa, hi_r)) {
        return map{
            kind: "alg_num",
            minpoly: [EX.rat_neg(hi_r), EX.rat(1, 1)],
            lo: hi_r,
            hi: hi_r,
            is_rational: true,
            rat: hi_r
        };
    }

    let fac = EX.poly_factor_Q(pa);
    let i = 0;
    while i < len(fac["factors"]) {
        let fp = EX.poly_monic(fac["factors"][i]["poly"]);
        let cnt = EX.sturm_real_root_count(fp, lo_r, hi_r);
        if cnt == 1 {
            if len(fp) == 2 {
                let r_exact = EX.rat_neg(fp[0]);
                return map{
                    kind: "alg_num",
                    minpoly: fp,
                    lo: r_exact,
                    hi: r_exact,
                    is_rational: true,
                    rat: r_exact
                };
            }
            return map{
                kind: "alg_num",
                minpoly: fp,
                lo: lo_r,
                hi: hi_r,
                is_rational: false,
                rat: nil
            };
        }
        i = i + 1;
    }

    // Fallback when irreducible factor has degree >= 5 and unique root in (lo_r, hi_r)
    let cnt_all = EX.sturm_real_root_count(pa, lo_r, hi_r);
    if cnt_all != 1 {
        throw "algebraic_number: interval [" + EX.rat_to_str(lo_r) + ", " + EX.rat_to_str(hi_r)
            + "] contains " + str(cnt_all) + " roots (expected unique root == 1)";
    }
    return map{
        kind: "alg_num",
        minpoly: pa,
        lo: lo_r,
        hi: hi_r,
        is_rational: false,
        rat: nil
    };
}

fn alg_from_rat(r_in) {
    let r = _to_rat_elem(r_in);
    return map{
        kind: "alg_num",
        minpoly: [EX.rat_neg(r), EX.rat(1, 1)],
        lo: r,
        hi: r,
        is_rational: true,
        rat: r
    };
}

fn algebraic_number(spec_or_poly, lo = nil, hi = nil) {
    if type(spec_or_poly) == "map" and map_has(spec_or_poly, "kind") and spec_or_poly["kind"] == "alg_num" {
        return spec_or_poly;
    }
    if lo == nil and hi == nil {
        if type(spec_or_poly) == "number" or type(spec_or_poly) == "bigint" {
            return alg_from_rat(spec_or_poly);
        }
        if type(spec_or_poly) == "map" and map_has(spec_or_poly, "kind") and spec_or_poly["kind"] == "rat" {
            return alg_from_rat(spec_or_poly);
        }
        if type(spec_or_poly) == "map" and map_has(spec_or_poly, "poly") {
            return algebraic_number(spec_or_poly["poly"], spec_or_poly["lo"], spec_or_poly["hi"]);
        }
    }

    let q_poly = [];
    if type(spec_or_poly) == "string" {
        let f_tmp = parse_first_order_formula("(" + spec_or_poly + ") == 0");
        let v_tmp = [];
        _alg_expr_vars(f_tmp["diff"], [], v_tmp);
        if len(v_tmp) != 1 {
            throw "algebraic_number: polynomial string must be univariate";
        }
        let rp = alg_expr_to_rpoly(f_tmp["diff"], v_tmp);
        q_poly = rp["coeffs"];
    } else if type(spec_or_poly) == "array" {
        // Ascending rational coefficients `[c_0, c_1, ..., c_d]`
        q_poly = EX.poly_from_coeffs_asc(spec_or_poly);
    } else {
        throw "algebraic_number: unsupported polynomial specification";
    }

    let lo_r = _to_rat_elem(lo);
    let hi_r = _to_rat_elem(hi);
    if EX.rat_cmp(lo_r, hi_r) > 0 {
        let t = lo_r;
        lo_r = hi_r;
        hi_r = t;
    }
    return _alg_select_irreducible_factor(q_poly, lo_r, hi_r);
}

fn alg_sqrt(r_in) {
    let r = _to_rat_elem(r_in);
    if r["num"] < _B0 { throw "alg_sqrt: negative rational has no real square root"; }
    if r["num"] == _B0 { return alg_from_rat(0); }
    let p_sq = [EX.rat_neg(r), EX.rat(0, 1), EX.rat(1, 1)];
    let B = EX.rat_add(r, EX.rat(1, 1));
    return _alg_select_irreducible_factor(p_sq, EX.rat(0, 1), B);
}

fn alg_to_float(a_in, tol = 1e-14) {
    let a = algebraic_number(a_in);
    if a["is_rational"] { return EX.rat_to_float(a["rat"]); }
    let cur = a;
    let guard = 0;
    while guard < 64 and EX.rat_to_float(EX.rat_sub(cur["hi"], cur["lo"])) > tol {
        cur = _alg_tighten_once(cur);
        if cur["is_rational"] { return EX.rat_to_float(cur["rat"]); }
        guard = guard + 1;
    }
    return 0.5 * (EX.rat_to_float(cur["lo"]) + EX.rat_to_float(cur["hi"]));
}

fn alg_minpoly_coeffs_asc(a_in) {
    let a = algebraic_number(a_in);
    // Return primitive integer coefficients `[c_0, ..., c_d]` with c_d > 0!
    let mp = a["minpoly"];
    let lcm_d = _B1;
    let i = 0;
    while i < len(mp) {
        lcm_d = _b_lcm(lcm_d, mp[i]["den"]);
        i = i + 1;
    }
    let g_n = _B0;
    let zc = [];
    i = 0;
    while i < len(mp) {
        let zi = mp[i]["num"] * (lcm_d / mp[i]["den"]);
        push(zc, zi);
        g_n = _b_gcd(g_n, zi);
        i = i + 1;
    }
    let out = [];
    i = 0;
    while i < len(zc) {
        let v = zc[i] / g_n;
        push(out, _bi_to_plain_int_or_bi(v));
        i = i + 1;
    }
    return out;
}

fn alg_neg(a_in) {
    let a = algebraic_number(a_in);
    if a["is_rational"] { return alg_from_rat(EX.rat_neg(a["rat"])); }
    // M_{-a}(x) = (-1)^d * M_a(-x)
    let mp = a["minpoly"];
    let d = len(mp) - 1;
    let out = [];
    let i = 0;
    while i <= d {
        let c = mp[i];
        if (i % 2) == 1 { c = EX.rat_neg(c); }
        if (d % 2) == 1 { c = EX.rat_neg(c); }
        push(out, c);
        i = i + 1;
    }
    return map{
        kind: "alg_num",
        minpoly: out,
        lo: EX.rat_neg(a["hi"]),
        hi: EX.rat_neg(a["lo"]),
        is_rational: false,
        rat: nil
    };
}

fn alg_add(a_in, b_in) {
    let a = algebraic_number(a_in);
    let b = algebraic_number(b_in);
    if a["is_rational"] and b["is_rational"] {
        return alg_from_rat(EX.rat_add(a["rat"], b["rat"]));
    }

    // Build resultant Res_y(M_a(y), M_b(x - y)) in Q[x][y] (vars = ["x", "y"])
    let x_rp = rpoly_var(2, 1);
    let y_rp = rpoly_var(2, 2);
    let x_minus_y = rpoly_sub(x_rp, y_rp);

    let Pa = rpoly_zero(2);
    let i = len(a["minpoly"]) - 1;
    while i >= 0 {
        Pa = rpoly_add(rpoly_mul(Pa, y_rp), rpoly_const_rat(2, a["minpoly"][i]));
        i = i - 1;
    }

    let Pb = rpoly_zero(2);
    i = len(b["minpoly"]) - 1;
    while i >= 0 {
        Pb = rpoly_add(rpoly_mul(Pb, x_minus_y), rpoly_const_rat(2, b["minpoly"][i]));
        i = i - 1;
    }

    let res_rp = rpoly_subresultant_prs(Pa, Pb)["resultant"];
    let sqf_R = EX.poly_monic(EX.poly_sqfree(res_rp["coeffs"]));

    let ca = a;
    let cb = b;
    let guard = 0;
    while guard < 128 {
        let sum_iv = _ri_add(_ri_new(ca["lo"], ca["hi"]), _ri_new(cb["lo"], cb["hi"]));
        // Check exact rational root if interval collapsed or hit endpoint
        if EX.rat_eq(sum_iv["lo"], sum_iv["hi"]) {
            return alg_from_rat(sum_iv["lo"]);
        }
        // Shift endpoints slightly if either endpoint happens to be an exact root of sqf_R?
        // Actually if sqf_R(lo) == 0, tighten ca/cb one more step so open interval strictly brackets a + b!
        let lo_zero = EX.rat_is_zero(EX.poly_eval_rat(sqf_R, sum_iv["lo"]));
        let hi_zero = EX.rat_is_zero(EX.poly_eval_rat(sqf_R, sum_iv["hi"]));
        if (not lo_zero) and (not hi_zero) {
            let cnt = EX.sturm_real_root_count(sqf_R, sum_iv["lo"], sum_iv["hi"]);
            if cnt == 1 {
                return _alg_select_irreducible_factor(sqf_R, sum_iv["lo"], sum_iv["hi"]);
            }
        }
        ca = _alg_tighten_once(ca);
        cb = _alg_tighten_once(cb);
        guard = guard + 1;
    }
    let fin_iv = _ri_add(_ri_new(ca["lo"], ca["hi"]), _ri_new(cb["lo"], cb["hi"]));
    return _alg_select_irreducible_factor(sqf_R, fin_iv["lo"], fin_iv["hi"]);
}

fn alg_sub(a_in, b_in) {
    return alg_add(a_in, alg_neg(b_in));
}

fn alg_mul(a_in, b_in) {
    let a = algebraic_number(a_in);
    let b = algebraic_number(b_in);
    if (a["is_rational"] and EX.rat_is_zero(a["rat"])) or (b["is_rational"] and EX.rat_is_zero(b["rat"])) {
        return alg_from_rat(0);
    }
    if a["is_rational"] and b["is_rational"] {
        return alg_from_rat(EX.rat_mul(a["rat"], b["rat"]));
    }

    // Build resultant Res_y(M_a(y), y^{deg M_b} * M_b(x / y)) in Q[x][y]
    let x_rp = rpoly_var(2, 1);
    let y_rp = rpoly_var(2, 2);

    let Pa = rpoly_zero(2);
    let i = len(a["minpoly"]) - 1;
    while i >= 0 {
        Pa = rpoly_add(rpoly_mul(Pa, y_rp), rpoly_const_rat(2, a["minpoly"][i]));
        i = i - 1;
    }

    let db = len(b["minpoly"]) - 1;
    let Pb = rpoly_zero(2);
    let j = 0;
    while j <= db {
        let term = rpoly_mul(
            rpoly_const_rat(2, b["minpoly"][j]),
            rpoly_mul(rpoly_pow(x_rp, j), rpoly_pow(y_rp, db - j))
        );
        Pb = rpoly_add(Pb, term);
        j = j + 1;
    }

    let res_rp = rpoly_subresultant_prs(Pa, Pb)["resultant"];
    let sqf_R = EX.poly_monic(EX.poly_sqfree(res_rp["coeffs"]));

    let ca = a;
    let cb = b;
    let guard = 0;
    while guard < 128 {
        let prod_iv = _ri_mul(_ri_new(ca["lo"], ca["hi"]), _ri_new(cb["lo"], cb["hi"]));
        if EX.rat_eq(prod_iv["lo"], prod_iv["hi"]) {
            return alg_from_rat(prod_iv["lo"]);
        }
        let lo_zero = EX.rat_is_zero(EX.poly_eval_rat(sqf_R, prod_iv["lo"]));
        let hi_zero = EX.rat_is_zero(EX.poly_eval_rat(sqf_R, prod_iv["hi"]));
        if (not lo_zero) and (not hi_zero) {
            let cnt = EX.sturm_real_root_count(sqf_R, prod_iv["lo"], prod_iv["hi"]);
            if cnt == 1 {
                return _alg_select_irreducible_factor(sqf_R, prod_iv["lo"], prod_iv["hi"]);
            }
        }
        ca = _alg_tighten_once(ca);
        cb = _alg_tighten_once(cb);
        guard = guard + 1;
    }
    let fin_iv = _ri_mul(_ri_new(ca["lo"], ca["hi"]), _ri_new(cb["lo"], cb["hi"]));
    return _alg_select_irreducible_factor(sqf_R, fin_iv["lo"], fin_iv["hi"]);
}

fn alg_cmp(a_in, b_in) {
    let d = alg_sub(a_in, b_in);
    if d["is_rational"] {
        return _b_sign(d["rat"]["num"]);
    }
    // Non-rational algebraic number is guaranteed != 0! Tighten until 0 outside [lo, hi].
    let cur = d;
    let guard = 0;
    while guard < 128 {
        let sg = _ri_sign_strict(_ri_new(cur["lo"], cur["hi"]));
        if sg != 0 { return sg; }
        cur = _alg_tighten_once(cur);
        if cur["is_rational"] { return _b_sign(cur["rat"]["num"]); }
        guard = guard + 1;
    }
    return 0;
}

fn alg_eq(a_in, b_in) {
    return alg_cmp(a_in, b_in) == 0;
}

// ── Grouped Domain Namespaces & Public Exports ────────────────────────────────

let tarski_cad = map{
    parse_first_order_formula: parse_first_order_formula,
    formula_free_vars: formula_free_vars,
    formula_to_prenex: formula_to_prenex,
    cad_build_cells: cad_build_cells,
    cad_decide: cad_decide,
    quantifier_eliminate_real: quantifier_eliminate_real,
    prove_real_inequality: prove_real_inequality
};

let presburger = map{
    presburger_decide: presburger_decide,
    presburger_eliminate: presburger_eliminate
};

let diophantine = map{
    diophantine_obstruction_audit: diophantine_obstruction_audit
};

let lattice_algebraic = map{
