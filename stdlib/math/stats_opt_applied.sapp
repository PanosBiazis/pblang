// stdlib/math/stats_opt_applied.sapp — Applied Statistics, Bayesian Inference,
// Mathematical Optimization (LP / MILP / Brent / BFGS / Levenberg-Marquardt / ALM-KKT),
// Discrete Mathematics, Quine-McCluskey Boolean Minimization, Graph Theory,
// Quantitative Finance & Dimensional Unit / Uncertainty Propagation.
//
// 100% Pure PBLang (zero FFI, deterministic, bounded execution caps).
//
// Usage:
//   let soa = import("stdlib:math/stats_opt_applied.sapp");

let _PI = 3.141592653589793;
let _TWO_PI = 6.283185307179586;
let _SQRT2 = 1.4142135623730951;
let _SQRT2PI = 2.5066282746310002;
let _LN_SQRT2PI = 0.9189385332046727;
let _LN2 = 0.6931471805599453;
let _INF = 1e308;
let _NEG_INF = -1e308;

// Legacy exported constants (preserved for 100% backward compatibility; live budgets governed by GOV)
let GOV = import("stdlib:math/resource_governor.sapp");
let LG = import("stdlib:math/linalg_geometry.sapp");
let MAX_MILP_NODES = 4096;
let MAX_OPT_ITER = 2000;
let MAX_QM_VARS = 12;

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 0: Numerical Helpers, Special Functions & Dense Linear Algebra
// ══════════════════════════════════════════════════════════════════════════════

fn _min(a, b) { if a < b { return a; } return b; }
fn _max(a, b) { if a > b { return a; } return b; }
fn _clamp(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _zeros(n) {
    let out = [];
    let i = 0;
    while i < n { array_push(out, 0.0); i = i + 1; }
    return out;
}

fn _ones(n) {
    let out = [];
    let i = 0;
    while i < n { array_push(out, 1.0); i = i + 1; }
    return out;
}

fn _vec_copy(v) {
    let out = [];
    let i = 0;
    while i < len(v) { array_push(out, v[i]); i = i + 1; }
    return out;
}

fn _mat_zeros(rows, cols) {
    let m = [];
    let r = 0;
    while r < rows {
        array_push(m, _zeros(cols));
        r = r + 1;
    }
    return m;
}

fn _mat_eye(n) {
    let m = _mat_zeros(n, n);
    let i = 0;
    while i < n { m[i][i] = 1.0; i = i + 1; }
    return m;
}

fn _mat_copy(A) {
    let out = [];
    let r = 0;
    while r < len(A) {
        array_push(out, _vec_copy(A[r]));
        r = r + 1;
    }
    return out;
}

fn _dot(a, b) {
    let s = 0.0;
    let i = 0;
    while i < len(a) { s = s + a[i] * b[i]; i = i + 1; }
    return s;
}

fn _vec_norm(v) {
    return num_sqrt(_dot(v, v));
}

fn _vec_inf_norm(v) {
    let mx = 0.0;
    let i = 0;
    while i < len(v) {
        let a = num_abs(v[i]);
        if a > mx { mx = a; }
        i = i + 1;
    }
    return mx;
}

fn _mat_vec(A, x) {
    let out = [];
    let r = 0;
    while r < len(A) {
        array_push(out, _dot(A[r], x));
        r = r + 1;
    }
    return out;
}

fn _mat_mul(A, B) {
    let m = len(A);
    let k_len = len(B);
    let n = len(B[0]);
    let C = _mat_zeros(m, n);
    let i = 0;
    while i < m {
        let p = 0;
        while p < k_len {
            let a_ip = A[i][p];
            if a_ip != 0 {
                let j = 0;
                while j < n {
                    C[i][j] = C[i][j] + a_ip * B[p][j];
                    j = j + 1;
                }
            }
            p = p + 1;
        }
        i = i + 1;
    }
    return C;
}

fn _mat_transpose(A) {
    let m = len(A);
    if m == 0 { return []; }
    let n = len(A[0]);
    let T = _mat_zeros(n, m);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            T[j][i] = A[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return T;
}

// Gauss-Jordan linear solver and matrix inverse with partial pivoting.
// _lin_solve(A, b) -> x solving A * x = b
fn _lin_solve(A, b) {
    let n = len(A);
    let M = _mat_zeros(n, n + 1);
    let i = 0;
    while i < n {
        let j = 0;
        while j < n { M[i][j] = A[i][j]; j = j + 1; }
        M[i][n] = b[i];
        i = i + 1;
    }
    let col = 0;
    while col < n {
        let piv = col;
        let max_val = num_abs(M[col][col]);
        let r = col + 1;
        while r < n {
            let v = num_abs(M[r][col]);
            if v > max_val { max_val = v; piv = r; }
            r = r + 1;
        }
        if max_val < 1e-14 {
            return error("stats_opt_applied: singular or near-singular matrix");
        }
        if piv != col {
            let tmp = M[col];
            M[col] = M[piv];
            M[piv] = tmp;
        }
        let diag = M[col][col];
        let c = col;
        while c <= n { M[col][c] = M[col][c] / diag; c = c + 1; }
        r = 0;
        while r < n {
            if r != col {
                let factor = M[r][col];
                if factor != 0 {
                    c = col;
                    while c <= n {
                        M[r][c] = M[r][c] - factor * M[col][c];
                        c = c + 1;
                    }
                }
            }
            r = r + 1;
        }
        col = col + 1;
    }
    let x = [];
    i = 0;
    while i < n { array_push(x, M[i][n]); i = i + 1; }
    return x;
}

fn _mat_inv(A) {
    let n = len(A);
    let M = _mat_zeros(n, 2 * n);
    let i = 0;
    while i < n {
        let j = 0;
        while j < n { M[i][j] = A[i][j]; j = j + 1; }
        M[i][n + i] = 1.0;
        i = i + 1;
    }
    let col = 0;
    while col < n {
        let piv = col;
        let max_val = num_abs(M[col][col]);
        let r = col + 1;
        while r < n {
            let v = num_abs(M[r][col]);
            if v > max_val { max_val = v; piv = r; }
            r = r + 1;
        }
        if max_val < 1e-14 {
            return error("stats_opt_applied: matrix is singular and non-invertible");
        }
        if piv != col {
            let tmp = M[col];
            M[col] = M[piv];
            M[piv] = tmp;
        }
        let diag = M[col][col];
        let c = 0;
        while c < 2 * n { M[col][c] = M[col][c] / diag; c = c + 1; }
        r = 0;
        while r < n {
            if r != col {
                let factor = M[r][col];
                if factor != 0 {
                    c = 0;
                    while c < 2 * n {
                        M[r][c] = M[r][c] - factor * M[col][c];
                        c = c + 1;
                    }
                }
            }
            r = r + 1;
        }
        col = col + 1;
    }
    let inv = _mat_zeros(n, n);
    i = 0;
    while i < n {
        let j = 0;
        while j < n { inv[i][j] = M[i][n + j]; j = j + 1; }
        i = i + 1;
    }
    return inv;
}

// Cyclic Jacobi symmetric eigensolver: returns { eigenvalues, eigenvectors_cols }
// where A * v_k = lambda_k * v_k.
fn _jacobi_sym(A_in) {
    let n = len(A_in);
    if n == 0 { return map{ eigenvalues: [], eigenvectors: [] }; }
    let A = _mat_copy(A_in);
    let V = _mat_eye(n);
    if n == 1 {
        return map{ eigenvalues: [A[0][0]], eigenvectors: [[1.0]] };
    }
    let sweep = 0;
    while sweep < 120 {
        let off_norm = 0.0;
        let p = 0;
        while p < n {
            let q = p + 1;
            while q < n {
                off_norm = off_norm + A[p][q] * A[p][q];
                q = q + 1;
            }
            p = p + 1;
        }
        if num_sqrt(off_norm) < 1e-13 { break; }

        p = 0;
        while p < n - 1 {
            let q = p + 1;
            while q < n {
                let apq = A[p][q];
                if num_abs(apq) > 1e-15 {
                    let tau = (A[q][q] - A[p][p]) / (2.0 * apq);
                    let t = 0.0;
                    if tau >= 0 {
                        t = 1.0 / (tau + num_sqrt(1.0 + tau * tau));
                    } else {
                        t = 0.0 - 1.0 / ((0.0 - tau) + num_sqrt(1.0 + tau * tau));
                    }
                    let c = 1.0 / num_sqrt(1.0 + t * t);
                    let s = t * c;
                    A[p][p] = A[p][p] - t * apq;
                    A[q][q] = A[q][q] + t * apq;
                    A[p][q] = 0.0;
                    A[q][p] = 0.0;

                    let r = 0;
                    while r < n {
                        if r != p and r != q {
                            let arp = A[r][p];
                            let arq = A[r][q];
                            A[r][p] = c * arp - s * arq;
                            A[p][r] = A[r][p];
                            A[r][q] = s * arp + c * arq;
                            A[q][r] = A[r][q];
                        }
                        let vrp = V[r][p];
                        let vrq = V[r][q];
                        V[r][p] = c * vrp - s * vrq;
                        V[r][q] = s * vrp + c * vrq;
                        r = r + 1;
                    }
                }
                q = q + 1;
            }
            p = p + 1;
        }
        sweep = sweep + 1;
    }

    let evals = [];
    let evecs = [];
    let j = 0;
    while j < n {
        array_push(evals, A[j][j]);
        let vec = [];
        let r = 0;
        let max_abs = 0.0;
        let sign_ref = 1.0;
        while r < n {
            let val = V[r][j];
            array_push(vec, val);
            if num_abs(val) > max_abs {
                max_abs = num_abs(val);
                if val < 0 { sign_ref = -1.0; } else { sign_ref = 1.0; }
            }
            r = r + 1;
        }
        // Deterministic sign convention on eigenvectors
        r = 0;
        while r < n { vec[r] = vec[r] * sign_ref; r = r + 1; }
        array_push(evecs, vec);
        j = j + 1;
    }
    return map{ eigenvalues: evals, eigenvectors: evecs };
}

// ── Special Functions (15-digit Lanczos log-gamma, Incomplete Gamma & Beta) ──

fn gammln(z) {
    if z <= 0 { return error("gammln: z must be > 0"); }
    let c = [
        0.99999999999980993,
        676.5203681218851,
        -1259.1392167224028,
        771.32342877765313,
        -176.61502916214059,
        12.507343278686905,
        -0.13857109526572012,
        0.0000099843695780195716,
        0.00000015056327351493116
    ];
    let zz = z - 1.0;
    let ser = c[0];
    let i = 1;
    while i < 9 {
        ser = ser + c[i] / (zz + i);
        i = i + 1;
    }
    let t = zz + 7.5;
    return _LN_SQRT2PI + (zz + 0.5) * num_ln(t) - t + num_ln(ser);
}

fn _betaln(a, b) {
    return gammln(a) + gammln(b) - gammln(a + b);
}

fn _gser_raw(s, x) {
    if x <= 0 { return 0.0; }
    let ap = s;
    let total = 1.0 / s;
    let del = total;
    let n = 1;
    while n <= 600 {
        ap = ap + 1.0;
        del = del * x / ap;
        total = total + del;
        if num_abs(del) < num_abs(total) * 1e-15 { break; }
        n = n + 1;
    }
    return total * num_exp(0.0 - x + s * num_ln(x) - gammln(s));
}

fn _gcf_raw(s, x) {
    let fpmin = 1e-300;
    let b = x + 1.0 - s;
    let c = 1.0 / fpmin;
    let d = b;
    if num_abs(d) < fpmin { d = fpmin; }
    d = 1.0 / d;
    let h = d;
    let i = 1;
    while i <= 600 {
        let an = 0.0 - i * (i - s);
        b = b + 2.0;
        d = an * d + b;
        if num_abs(d) < fpmin { d = fpmin; }
        c = b + an / c;
        if num_abs(c) < fpmin { c = fpmin; }
        d = 1.0 / d;
        let del = d * c;
        h = h * del;
        if num_abs(del - 1.0) < 1e-15 { break; }
        i = i + 1;
    }
    return num_exp(0.0 - x + s * num_ln(x) - gammln(s)) * h;
}

// Regularized lower incomplete gamma P(s, x)
fn gammp(s, x) {
    if s <= 0 { return error("gammp: shape s must be > 0"); }
    if x < 0 { return error("gammp: x must be >= 0"); }
    if x == 0 { return 0.0; }
    if x < s + 1.0 { return _clamp(_gser_raw(s, x), 0.0, 1.0); }
    return _clamp(1.0 - _gcf_raw(s, x), 0.0, 1.0);
}

// Regularized upper incomplete gamma Q(s, x) = 1 - P(s, x)
fn gammq(s, x) {
    if s <= 0 { return error("gammq: shape s must be > 0"); }
    if x < 0 { return error("gammq: x must be >= 0"); }
    if x == 0 { return 1.0; }
    if x < s + 1.0 { return _clamp(1.0 - _gser_raw(s, x), 0.0, 1.0); }
    return _clamp(_gcf_raw(s, x), 0.0, 1.0);
}

fn _betacf(a, b, x) {
    let fpmin = 1e-300;
    let qab = a + b;
    let qap = a + 1.0;
    let qam = a - 1.0;
    let c = 1.0;
    let d = 1.0 - qab * x / qap;
    if num_abs(d) < fpmin { d = fpmin; }
    d = 1.0 / d;
    let h = d;
    let m = 1;
    while m <= 600 {
        let m2 = 2.0 * m;
        let aa = m * (b - m) * x / ((qam + m2) * (a + m2));
        d = 1.0 + aa * d;
        if num_abs(d) < fpmin { d = fpmin; }
        c = 1.0 + aa / c;
        if num_abs(c) < fpmin { c = fpmin; }
        d = 1.0 / d;
        h = h * d * c;
        aa = 0.0 - (a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
        d = 1.0 + aa * d;
        if num_abs(d) < fpmin { d = fpmin; }
        c = 1.0 + aa / c;
        if num_abs(c) < fpmin { c = fpmin; }
        d = 1.0 / d;
        let del = d * c;
        h = h * del;
        if num_abs(del - 1.0) < 1e-15 { break; }
        m = m + 1;
    }
    return h;
}

// Regularized incomplete beta I_x(a, b) — argument order (a, b, x)
fn betai(a, b, x) {
    if a <= 0 or b <= 0 { return error("betai: a and b must be > 0"); }
    if x < 0 or x > 1 { return error("betai: x must be in [0, 1]"); }
    if x == 0 { return 0.0; }
    if x == 1 { return 1.0; }
    let bt = num_exp(gammln(a + b) - gammln(a) - gammln(b) + a * num_ln(x) + b * num_ln(1.0 - x));
    if x < (a + 1.0) / (a + b + 2.0) {
        return _clamp(bt * _betacf(a, b, x) / a, 0.0, 1.0);
    }
    return _clamp(1.0 - bt * _betacf(b, a, 1.0 - x) / b, 0.0, 1.0);
}

fn erf(x) {
    if x == 0 { return 0.0; }
    let p = gammp(0.5, x * x);
    if x < 0 { return 0.0 - p; }
    return p;
}

fn erfc(x) {
    if x >= 0 { return gammq(0.5, x * x); }
    return 1.0 + gammp(0.5, x * x);
}

// Standard normal inverse CDF (Acklam rational approximation + Halley polish to ~1e-15)
fn norm_ppf(p) {
    if p < 0 or p > 1 { return error("norm_ppf: p must be in [0, 1]"); }
    if p == 0 { return _NEG_INF; }
    if p == 1 { return _INF; }
    if p == 0.5 { return 0.0; }

    let a1 = -39.69683028665376;  let a2 = 220.9460984245205;
    let a3 = -275.9285104469687;  let a4 = 138.3577518672690;
    let a5 = -30.66479806614716;  let a6 = 2.506628277459239;
    let b1 = -54.47609879822406;  let b2 = 161.5858368580409;
    let b3 = -155.6989798598866;  let b4 = 66.80131188771972;
    let b5 = -13.28068155288572;
    let c1 = -0.007784894002430293; let c2 = -0.3223964580411365;
    let c3 = -2.400758277161838;    let c4 = -2.549732539343734;
    let c5 = 4.374664141464968;     let c6 = 2.938163982698783;
    let d1 = 0.007784695709041462;  let d2 = 0.3224671290700398;
    let d3 = 2.445134137142996;     let d4 = 3.754408661907416;

    let z = 0.0;
    let p_low = 0.02425;
    let p_high = 1.0 - p_low;
    if p < p_low {
        let q = num_sqrt(0.0 - 2.0 * num_ln(p));
        z = (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
          / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0);
    } else if p <= p_high {
        let q = p - 0.5;
        let r = q * q;
        z = (((((a1 * r + a2) * r + a3) * r + a4) * r + a5) * r + a6) * q
          / (((((b1 * r + b2) * r + b3) * r + b4) * r + b5) * r + 1.0);
    } else {
        let q = num_sqrt(0.0 - 2.0 * num_ln(1.0 - p));
        z = 0.0 - (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
          / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0);
    }

    // Two Halley steps for full IEEE-754 precision
    let step = 0;
    while step < 2 {
        let cdf_z = 0.5 * erfc((0.0 - z) / _SQRT2);
        let err = cdf_z - p;
        let pdf_z = num_exp(-0.5 * z * z) / _SQRT2PI;
        if pdf_z > 0 {
            let u = err / pdf_z;
            z = z - u / (1.0 + 0.5 * z * u);
        }
        step = step + 1;
    }
    return z;
}

// Safeguarded bracketed Newton + bisection quantile solver for continuous distributions
fn _bracketed_newton_ppf(cdf_fn, pdf_fn, p, lo_init, hi_init, has_lower, lower_bound, has_upper, upper_bound, x0) {
    let lo = lo_init;
    let hi = hi_init;
    let it = 0;
    while cdf_fn(lo) > p and it < 80 {
        hi = lo;
        if has_lower {
            lo = lower_bound + 0.5 * (lo - lower_bound);
            if lo == hi { break; }
        } else {
            let span = _max(1.0, num_abs(lo));
            lo = lo - 2.0 * span;
        }
        it = it + 1;
    }
    it = 0;
    while cdf_fn(hi) < p and it < 80 {
        lo = hi;
        if has_upper {
            hi = upper_bound - 0.5 * (upper_bound - hi);
            if hi == lo { break; }
        } else {
            let span = _max(1.0, num_abs(hi));
            hi = hi + 2.0 * span;
        }
        it = it + 1;
    }

    let x = x0;
    if x <= lo or x >= hi { x = 0.5 * (lo + hi); }
    it = 0;
    while it < 100 {
        let fx = cdf_fn(x) - p;
        if num_abs(fx) < 1e-14 or (hi - lo) <= 1e-13 * _max(1.0, num_abs(x)) {
            return x;
        }
        if fx < 0 { lo = x; } else { hi = x; }
        let dfx = pdf_fn(x);
        let xn = 0.5 * (lo + hi);
        if dfx > 1e-300 {
            let cand = x - fx / dfx;
            if cand > lo and cand < hi {
                xn = cand;
            }
        }
        x = xn;
        it = it + 1;
    }
    return x;
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1: Distributions, Hypothesis Tests, Regression, PCA, Bayes & Markov
// ══════════════════════════════════════════════════════════════════════════════

// 1.1 Continuous & Discrete Probability Distributions

fn normal_pdf(x, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("normal_pdf: sigma must be > 0"); }
    let z = (x - mu) / sigma;
    return num_exp(-0.5 * z * z) / (sigma * _SQRT2PI);
}

fn normal_cdf(x, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("normal_cdf: sigma must be > 0"); }
    let z = (x - mu) / sigma;
    return 0.5 * erfc((0.0 - z) / _SQRT2);
}

fn normal_ppf(p, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("normal_ppf: sigma must be > 0"); }
    return mu + sigma * norm_ppf(p);
}

fn Normal(mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("Normal: sigma must be > 0"); }
    return map{
        name: "Normal",
        mu: mu,
        sigma: sigma,
        mean: mu,
        variance: sigma * sigma,
        pdf: fn(x) { return normal_pdf(x, mu, sigma); },
        cdf: fn(x) { return normal_cdf(x, mu, sigma); },
        ppf: fn(p) { return normal_ppf(p, mu, sigma); }
    };
}

fn student_t_pdf(x, df) {
    if df <= 0 { return error("student_t_pdf: df must be > 0"); }
    let log_c = gammln(0.5 * (df + 1.0)) - gammln(0.5 * df) - 0.5 * num_ln(df * _PI);
    return num_exp(log_c - 0.5 * (df + 1.0) * num_ln(1.0 + (x * x) / df));
}

fn student_t_cdf(x, df) {
    if df <= 0 { return error("student_t_cdf: df must be > 0"); }
    if x == 0 { return 0.5; }
    let ib = betai(0.5 * df, 0.5, df / (df + x * x));
    if x > 0 { return 1.0 - 0.5 * ib; }
    return 0.5 * ib;
}

fn student_t_ppf(p, df) {
    if df <= 0 { return error("student_t_ppf: df must be > 0"); }
    if p < 0 or p > 1 { return error("student_t_ppf: p must be in [0, 1]"); }
    if p == 0 { return _NEG_INF; }
    if p == 1 { return _INF; }
    if p == 0.5 { return 0.0; }
    let z0 = norm_ppf(p);
    return _bracketed_newton_ppf(
        fn(x) { return student_t_cdf(x, df); },
        fn(x) { return student_t_pdf(x, df); },
        p, -2.0, 2.0, false, 0.0, false, 0.0, z0
    );
}

fn StudentT(df) {
    if df <= 0 { return error("StudentT: df must be > 0"); }
    return map{
        name: "StudentT",
        df: df,
        pdf: fn(x) { return student_t_pdf(x, df); },
        cdf: fn(x) { return student_t_cdf(x, df); },
        ppf: fn(p) { return student_t_ppf(p, df); }
    };
}

fn chi2_pdf(x, df) {
    if df <= 0 { return error("chi2_pdf: df must be > 0"); }
    if x <= 0 {
        if x == 0 and df == 2 { return 0.5; }
        return 0.0;
    }
    let k2 = 0.5 * df;
    return num_exp((k2 - 1.0) * num_ln(x) - 0.5 * x - k2 * _LN2 - gammln(k2));
}

fn chi2_cdf(x, df) {
    if df <= 0 { return error("chi2_cdf: df must be > 0"); }
    if x <= 0 { return 0.0; }
    return gammp(0.5 * df, 0.5 * x);
}

fn chi2_ppf(p, df) {
    if df <= 0 { return error("chi2_ppf: df must be > 0"); }
    if p < 0 or p > 1 { return error("chi2_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return _INF; }
    let z = norm_ppf(p);
    let wh = 1.0 - 2.0 / (9.0 * df) + z * num_sqrt(2.0 / (9.0 * df));
    let x0 = df * wh * wh * wh;
    if x0 <= 0 { x0 = 0.5 * df; }
    return _bracketed_newton_ppf(
        fn(x) { return chi2_cdf(x, df); },
        fn(x) { return chi2_pdf(x, df); },
        p, _max(1e-12, 0.25 * x0), _max(1.0, 2.0 * x0), true, 0.0, false, 0.0, x0
    );
}

fn ChiSquare(df) {
    if df <= 0 { return error("ChiSquare: df must be > 0"); }
    return map{
        name: "ChiSquare",
        df: df,
        mean: df,
        variance: 2.0 * df,
        pdf: fn(x) { return chi2_pdf(x, df); },
        cdf: fn(x) { return chi2_cdf(x, df); },
        ppf: fn(p) { return chi2_ppf(p, df); }
    };
}

fn f_dist_pdf(x, d1, d2) {
    if d1 <= 0 or d2 <= 0 { return error("f_dist_pdf: d1 and d2 must be > 0"); }
    if x <= 0 { return 0.0; }
    let a = 0.5 * d1;
    let b = 0.5 * d2;
    let lp = a * num_ln(d1) + b * num_ln(d2) + (a - 1.0) * num_ln(x)
           - (a + b) * num_ln(d1 * x + d2) - _betaln(a, b);
    return num_exp(lp);
}

fn f_dist_cdf(x, d1, d2) {
    if d1 <= 0 or d2 <= 0 { return error("f_dist_cdf: d1 and d2 must be > 0"); }
    if x <= 0 { return 0.0; }
    return betai(0.5 * d1, 0.5 * d2, (d1 * x) / (d1 * x + d2));
}

fn f_dist_ppf(p, d1, d2) {
    if d1 <= 0 or d2 <= 0 { return error("f_dist_ppf: d1 and d2 must be > 0"); }
    if p < 0 or p > 1 { return error("f_dist_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return _INF; }
    let u = beta_dist_ppf(p, 0.5 * d1, 0.5 * d2);
    let x0 = (d2 * u) / (d1 * (1.0 - u));
    return _bracketed_newton_ppf(
        fn(x) { return f_dist_cdf(x, d1, d2); },
        fn(x) { return f_dist_pdf(x, d1, d2); },
        p, _max(1e-12, 0.5 * x0), _max(1.0, 2.0 * x0), true, 0.0, false, 0.0, x0
    );
}

fn FDist(d1, d2) {
    if d1 <= 0 or d2 <= 0 { return error("FDist: d1 and d2 must be > 0"); }
    return map{
        name: "FDist",
        d1: d1,
        d2: d2,
        pdf: fn(x) { return f_dist_pdf(x, d1, d2); },
        cdf: fn(x) { return f_dist_cdf(x, d1, d2); },
        ppf: fn(p) { return f_dist_ppf(p, d1, d2); }
    };
}

fn beta_dist_pdf(x, a, b) {
    if a <= 0 or b <= 0 { return error("beta_dist_pdf: a and b must be > 0"); }
    if x <= 0 or x >= 1 { return 0.0; }
    return num_exp((a - 1.0) * num_ln(x) + (b - 1.0) * num_ln(1.0 - x) - _betaln(a, b));
}

fn beta_dist_cdf(x, a, b) {
    if a <= 0 or b <= 0 { return error("beta_dist_cdf: a and b must be > 0"); }
    if x <= 0 { return 0.0; }
    if x >= 1 { return 1.0; }
    return betai(a, b, x);
}

fn beta_dist_ppf(p, a, b) {
    if a <= 0 or b <= 0 { return error("beta_dist_ppf: a and b must be > 0"); }
    if p < 0 or p > 1 { return error("beta_dist_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return 1.0; }
    let x0 = a / (a + b);
    return _bracketed_newton_ppf(
        fn(x) { return beta_dist_cdf(x, a, b); },
        fn(x) { return beta_dist_pdf(x, a, b); },
        p, 1e-12, 1.0 - 1e-12, true, 0.0, true, 1.0, x0
    );
}

fn BetaDist(a, b) {
    if a <= 0 or b <= 0 { return error("BetaDist: a and b must be > 0"); }
    return map{
        name: "BetaDist",
        a: a,
        b: b,
        mean: a / (a + b),
        pdf: fn(x) { return beta_dist_pdf(x, a, b); },
        cdf: fn(x) { return beta_dist_cdf(x, a, b); },
        ppf: fn(p) { return beta_dist_ppf(p, a, b); }
    };
}

// GammaDist parameterized by (shape, rate): E[X] = shape / rate
fn gamma_dist_pdf(x, shape, rate = 1.0) {
    if shape <= 0 or rate <= 0 { return error("gamma_dist_pdf: shape and rate must be > 0"); }
    if x <= 0 {
        if x == 0 and shape == 1 { return rate; }
        return 0.0;
    }
    return num_exp(shape * num_ln(rate) + (shape - 1.0) * num_ln(x) - rate * x - gammln(shape));
}

fn gamma_dist_cdf(x, shape, rate = 1.0) {
    if shape <= 0 or rate <= 0 { return error("gamma_dist_cdf: shape and rate must be > 0"); }
    if x <= 0 { return 0.0; }
    return gammp(shape, rate * x);
}

fn gamma_dist_ppf(p, shape, rate = 1.0) {
    if shape <= 0 or rate <= 0 { return error("gamma_dist_ppf: shape and rate must be > 0"); }
    if p < 0 or p > 1 { return error("gamma_dist_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return _INF; }
    return chi2_ppf(p, 2.0 * shape) / (2.0 * rate);
}

fn GammaDist(shape, rate = 1.0) {
    if shape <= 0 or rate <= 0 { return error("GammaDist: shape and rate must be > 0"); }
    return map{
        name: "GammaDist",
        shape: shape,
        rate: rate,
        mean: shape / rate,
        variance: shape / (rate * rate),
        pdf: fn(x) { return gamma_dist_pdf(x, shape, rate); },
        cdf: fn(x) { return gamma_dist_cdf(x, shape, rate); },
        ppf: fn(p) { return gamma_dist_ppf(p, shape, rate); }
    };
}

fn weibull_pdf(x, shape, scale = 1.0) {
    if shape <= 0 or scale <= 0 { return error("weibull_pdf: shape and scale must be > 0"); }
    if x < 0 { return 0.0; }
    if x == 0 {
        if shape == 1 { return 1.0 / scale; }
        return 0.0;
    }
    let u = x / scale;
    return (shape / scale) * num_pow(u, shape - 1.0) * num_exp(0.0 - num_pow(u, shape));
}

fn weibull_cdf(x, shape, scale = 1.0) {
    if shape <= 0 or scale <= 0 { return error("weibull_cdf: shape and scale must be > 0"); }
    if x <= 0 { return 0.0; }
    return 1.0 - num_exp(0.0 - num_pow(x / scale, shape));
}

fn weibull_ppf(p, shape, scale = 1.0) {
    if shape <= 0 or scale <= 0 { return error("weibull_ppf: shape and scale must be > 0"); }
    if p < 0 or p > 1 { return error("weibull_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return _INF; }
    return scale * num_pow(0.0 - num_ln(1.0 - p), 1.0 / shape);
}

fn Weibull(shape, scale = 1.0) {
    if shape <= 0 or scale <= 0 { return error("Weibull: shape and scale must be > 0"); }
    return map{
        name: "Weibull",
        shape: shape,
        scale: scale,
        pdf: fn(x) { return weibull_pdf(x, shape, scale); },
        cdf: fn(x) { return weibull_cdf(x, shape, scale); },
        ppf: fn(p) { return weibull_ppf(p, shape, scale); }
    };
}

fn lognormal_pdf(x, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("lognormal_pdf: sigma must be > 0"); }
    if x <= 0 { return 0.0; }
    let z = (num_ln(x) - mu) / sigma;
    return num_exp(-0.5 * z * z) / (x * sigma * _SQRT2PI);
}

fn lognormal_cdf(x, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("lognormal_cdf: sigma must be > 0"); }
    if x <= 0 { return 0.0; }
    return normal_cdf(num_ln(x), mu, sigma);
}

fn lognormal_ppf(p, mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("lognormal_ppf: sigma must be > 0"); }
    if p < 0 or p > 1 { return error("lognormal_ppf: p must be in [0, 1]"); }
    if p == 0 { return 0.0; }
    if p == 1 { return _INF; }
    return num_exp(normal_ppf(p, mu, sigma));
}

fn LogNormal(mu = 0.0, sigma = 1.0) {
    if sigma <= 0 { return error("LogNormal: sigma must be > 0"); }
    return map{
        name: "LogNormal",
        mu: mu,
        sigma: sigma,
        pdf: fn(x) { return lognormal_pdf(x, mu, sigma); },
        cdf: fn(x) { return lognormal_cdf(x, mu, sigma); },
        ppf: fn(p) { return lognormal_ppf(p, mu, sigma); }
    };
}

fn _ln_choose(n, k) {
    if k < 0 or k > n { return _NEG_INF; }
    if k == 0 or k == n { return 0.0; }
    return gammln(n + 1.0) - gammln(k + 1.0) - gammln(n - k + 1.0);
}

fn binomial_pmf(k, n, p) {
    if n < 0 or p < 0 or p > 1 { return error("binomial_pmf: invalid n or p"); }
    let ki = num_round(k);
    if ki != k or ki < 0 or ki > n { return 0.0; }
    if p == 0 { if ki == 0 { return 1.0; } return 0.0; }
    if p == 1 { if ki == n { return 1.0; } return 0.0; }
    return num_exp(_ln_choose(n, ki) + ki * num_ln(p) + (n - ki) * num_ln(1.0 - p));
}

fn binomial_cdf(k, n, p) {
    if n < 0 or p < 0 or p > 1 { return error("binomial_cdf: invalid n or p"); }
    let kf = num_floor(k);
    if kf < 0 { return 0.0; }
    if kf >= n { return 1.0; }
    if p == 0 { return 1.0; }
    if p == 1 { return 0.0; }
    return betai(n - kf, kf + 1.0, 1.0 - p);
}

fn binomial_ppf(q, n, p) {
    if n < 0 or p < 0 or p > 1 { return error("binomial_ppf: invalid n or p"); }
    if q < 0 or q > 1 { return error("binomial_ppf: q must be in [0, 1]"); }
    if q == 0 { return 0; }
    let lo = 0;
    let hi = n;
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if binomial_cdf(mid, n, p) >= q { hi = mid; } else { lo = mid + 1; }
    }
    return lo;
}

fn Binomial(n, p) {
    if n < 0 or p < 0 or p > 1 { return error("Binomial: invalid n or p"); }
    return map{
        name: "Binomial",
        n: n,
        p: p,
        mean: n * p,
        variance: n * p * (1.0 - p),
        pmf: fn(k) { return binomial_pmf(k, n, p); },
        pdf: fn(k) { return binomial_pmf(k, n, p); },
        cdf: fn(k) { return binomial_cdf(k, n, p); },
        ppf: fn(q) { return binomial_ppf(q, n, p); }
    };
}

fn poisson_pmf(k, lambda) {
    if lambda < 0 { return error("poisson_pmf: lambda must be >= 0"); }
    let ki = num_round(k);
    if ki != k or ki < 0 { return 0.0; }
    if lambda == 0 { if ki == 0 { return 1.0; } return 0.0; }
    return num_exp(ki * num_ln(lambda) - lambda - gammln(ki + 1.0));
}

fn poisson_cdf(k, lambda) {
    if lambda < 0 { return error("poisson_cdf: lambda must be >= 0"); }
    let kf = num_floor(k);
    if kf < 0 { return 0.0; }
    if lambda == 0 { return 1.0; }
    return gammq(kf + 1.0, lambda);
}

fn poisson_ppf(q, lambda) {
    if lambda < 0 { return error("poisson_ppf: lambda must be >= 0"); }
    if q < 0 or q > 1 { return error("poisson_ppf: q must be in [0, 1]"); }
    if q == 0 { return 0; }
    if q == 1 { return _INF; }
    if lambda == 0 { return 0; }
    let hi = _max(4, num_ceil(lambda + 6.0 * num_sqrt(lambda) + 10.0));
    while poisson_cdf(hi, lambda) < q {
        hi = hi * 2;
    }
    let lo = 0;
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if poisson_cdf(mid, lambda) >= q { hi = mid; } else { lo = mid + 1; }
    }
    return lo;
}

fn Poisson(lambda) {
    if lambda < 0 { return error("Poisson: lambda must be >= 0"); }
    return map{
        name: "Poisson",
        lambda: lambda,
        mean: lambda,
        variance: lambda,
        pmf: fn(k) { return poisson_pmf(k, lambda); },
        pdf: fn(k) { return poisson_pmf(k, lambda); },
        cdf: fn(k) { return poisson_cdf(k, lambda); },
        ppf: fn(q) { return poisson_ppf(q, lambda); }
    };
}

// Hypergeometric(N_pop, K_succ, n_draws)
fn hypergeom_pmf(k, N_pop, K_succ, n_draws) {
    if N_pop < 0 or K_succ < 0 or K_succ > N_pop or n_draws < 0 or n_draws > N_pop {
        return error("hypergeom_pmf: invalid parameters");
    }
    let ki = num_round(k);
    let k_min = _max(0, n_draws - (N_pop - K_succ));
    let k_max = _min(n_draws, K_succ);
    if ki != k or ki < k_min or ki > k_max { return 0.0; }
    return num_exp(_ln_choose(K_succ, ki) + _ln_choose(N_pop - K_succ, n_draws - ki) - _ln_choose(N_pop, n_draws));
}

fn hypergeom_cdf(k, N_pop, K_succ, n_draws) {
    if N_pop < 0 or K_succ < 0 or K_succ > N_pop or n_draws < 0 or n_draws > N_pop {
        return error("hypergeom_cdf: invalid parameters");
    }
    let kf = num_floor(k);
    let k_min = _max(0, n_draws - (N_pop - K_succ));
    let k_max = _min(n_draws, K_succ);
    if kf < k_min { return 0.0; }
    if kf >= k_max { return 1.0; }
    let acc = 0.0;
    let i = k_min;
    while i <= kf {
        acc = acc + hypergeom_pmf(i, N_pop, K_succ, n_draws);
        i = i + 1;
    }
    return _clamp(acc, 0.0, 1.0);
}

fn hypergeom_ppf(q, N_pop, K_succ, n_draws) {
    if q < 0 or q > 1 { return error("hypergeom_ppf: q must be in [0, 1]"); }
    let k_min = _max(0, n_draws - (N_pop - K_succ));
    let k_max = _min(n_draws, K_succ);
    if q == 0 { return k_min; }
    let lo = k_min;
    let hi = k_max;
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if hypergeom_cdf(mid, N_pop, K_succ, n_draws) >= q { hi = mid; } else { lo = mid + 1; }
    }
    return lo;
}

fn Hypergeometric(N_pop, K_succ, n_draws) {
    if N_pop < 0 or K_succ < 0 or K_succ > N_pop or n_draws < 0 or n_draws > N_pop {
        return error("Hypergeometric: invalid parameters");
    }
    return map{
        name: "Hypergeometric",
        N: N_pop,
        K: K_succ,
        n: n_draws,
        pmf: fn(k) { return hypergeom_pmf(k, N_pop, K_succ, n_draws); },
        pdf: fn(k) { return hypergeom_pmf(k, N_pop, K_succ, n_draws); },
        cdf: fn(k) { return hypergeom_cdf(k, N_pop, K_succ, n_draws); },
        ppf: fn(q) { return hypergeom_ppf(q, N_pop, K_succ, n_draws); }
    };
}

// 1.2 Parametric & Non-Parametric Hypothesis Tests

fn _sample_mean(arr) {
    let n = len(arr);
    if n == 0 { return error("stats_opt_applied: empty sample"); }
    let s = 0.0;
    let i = 0;
    while i < n { s = s + arr[i]; i = i + 1; }
    return s / n;
}

fn _sample_var(arr, m) {
    let n = len(arr);
    if n < 2 { return error("stats_opt_applied: sample size must be >= 2"); }
    let sq = 0.0;
    let i = 0;
    while i < n {
        let d = arr[i] - m;
        sq = sq + d * d;
        i = i + 1;
    }
    return sq / (n - 1.0);
}

fn t_test_1samp(sample, mu0) {
    let n = len(sample);
    if n < 2 { return error("t_test_1samp: sample size must be >= 2"); }
    let m = _sample_mean(sample);
    let v = _sample_var(sample, m);
    let se = num_sqrt(v / n);
    let df = n - 1.0;
    let t_stat = (m - mu0) / se;
    let p_val = 2.0 * (1.0 - student_t_cdf(num_abs(t_stat), df));
    let t_crit = student_t_ppf(0.975, df);
    return map{
        statistic: t_stat,
        df: df,
        p_value: p_val,
        ci_95: [m - t_crit * se, m + t_crit * se],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn t_test_2samp_welch(sample_a, sample_b) {
    let na = len(sample_a);
    let nb = len(sample_b);
    if na < 2 or nb < 2 { return error("t_test_2samp_welch: each sample must have >= 2 observations"); }
    let ma = _sample_mean(sample_a);
    let mb = _sample_mean(sample_b);
    let va = _sample_var(sample_a, ma) / na;
    let vb = _sample_var(sample_b, mb) / nb;
    let se = num_sqrt(va + vb);
    let diff = ma - mb;
    let df = ((va + vb) * (va + vb)) / ((va * va) / (na - 1.0) + (vb * vb) / (nb - 1.0));
    let t_stat = diff / se;
    let p_val = 2.0 * (1.0 - student_t_cdf(num_abs(t_stat), df));
    let t_crit = student_t_ppf(0.975, df);
    return map{
        statistic: t_stat,
        df: df,
        p_value: p_val,
        ci_95: [diff - t_crit * se, diff + t_crit * se],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn t_test_paired(before, after) {
    let n = len(before);
    if n != len(after) or n < 2 {
        return error("t_test_paired: samples must have equal length >= 2");
    }
    let diffs = [];
    let i = 0;
    while i < n {
        array_push(diffs, before[i] - after[i]);
        i = i + 1;
    }
    return t_test_1samp(diffs, 0.0);
}

fn z_test_proportions(x1, n1, x2, n2) {
    if n1 <= 0 or n2 <= 0 { return error("z_test_proportions: sample sizes must be > 0"); }
    let p1 = x1 / n1;
    let p2 = x2 / n2;
    let p_pool = (x1 + x2) / (n1 + n2);
    let se0 = num_sqrt(p_pool * (1.0 - p_pool) * (1.0 / n1 + 1.0 / n2));
    let diff = p1 - p2;
    let z_stat = diff / se0;
    let p_val = 2.0 * (1.0 - normal_cdf(num_abs(z_stat), 0.0, 1.0));
    let se_ci = num_sqrt((p1 * (1.0 - p1)) / n1 + (p2 * (1.0 - p2)) / n2);
    let z_crit = norm_ppf(0.975);
    return map{
        statistic: z_stat,
        df: nil,
        p_value: p_val,
        ci_95: [diff - z_crit * se_ci, diff + z_crit * se_ci],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn chi2_goodness_of_fit(observed, expected) {
    let k = len(observed);
    if k != len(expected) or k < 2 {
        return error("chi2_goodness_of_fit: observed and expected must have equal length >= 2");
    }
    let stat = 0.0;
    let i = 0;
    while i < k {
        if expected[i] <= 0 { return error("chi2_goodness_of_fit: expected frequencies must be > 0"); }
        let d = observed[i] - expected[i];
        stat = stat + (d * d) / expected[i];
        i = i + 1;
    }
    let df = k - 1.0;
    let p_val = gammq(0.5 * df, 0.5 * stat);
    return map{
        statistic: stat,
        df: df,
        p_value: p_val,
        ci_95: [0.0, chi2_ppf(0.95, df)],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn chi2_independence(contingency_matrix) {
    let R = len(contingency_matrix);
    if R < 2 { return error("chi2_independence: need >= 2 rows"); }
    let C = len(contingency_matrix[0]);
    if C < 2 { return error("chi2_independence: need >= 2 columns"); }

    let row_sums = _zeros(R);
    let col_sums = _zeros(C);
    let total = 0.0;
    let r = 0;
    while r < R {
        let c = 0;
        while c < C {
            let v = contingency_matrix[r][c];
            row_sums[r] = row_sums[r] + v;
            col_sums[c] = col_sums[c] + v;
            total = total + v;
            c = c + 1;
        }
        r = r + 1;
    }
    let stat = 0.0;
    r = 0;
    while r < R {
        let c = 0;
        while c < C {
            let exp_rc = (row_sums[r] * col_sums[c]) / total;
            if exp_rc <= 0 { return error("chi2_independence: zero expected cell frequency"); }
            let d = contingency_matrix[r][c] - exp_rc;
            stat = stat + (d * d) / exp_rc;
            c = c + 1;
        }
        r = r + 1;
    }
    let df = (R - 1.0) * (C - 1.0);
    let p_val = gammq(0.5 * df, 0.5 * stat);
    return map{
        statistic: stat,
        df: df,
        p_value: p_val,
        ci_95: [0.0, chi2_ppf(0.95, df)],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn anova_oneway(groups) {
    let k = len(groups);
    if k < 2 { return error("anova_oneway: need >= 2 groups"); }
    let N = 0;
    let grand_sum = 0.0;
    let group_means = [];
    let g = 0;
    while g < k {
        let grp = groups[g];
        let ng = len(grp);
        if ng == 0 { return error("anova_oneway: empty group"); }
        let mg = _sample_mean(grp);
        array_push(group_means, mg);
        grand_sum = grand_sum + mg * ng;
        N = N + ng;
        g = g + 1;
    }
    if N <= k { return error("anova_oneway: total observations must exceed group count"); }
    let grand_mean = grand_sum / N;
    let ss_between = 0.0;
    let ss_within = 0.0;
    g = 0;
    while g < k {
        let grp = groups[g];
        let ng = len(grp);
        let dm = group_means[g] - grand_mean;
        ss_between = ss_between + ng * dm * dm;
        let i = 0;
        while i < ng {
            let dw = grp[i] - group_means[g];
            ss_within = ss_within + dw * dw;
            i = i + 1;
        }
        g = g + 1;
    }
    let df1 = k - 1.0;
    let df2 = N - k;
    let ms_between = ss_between / df1;
    let ms_within = ss_within / df2;
    let f_stat = ms_between / ms_within;
    let p_val = 1.0 - f_dist_cdf(f_stat, df1, df2);
    return map{
        statistic: f_stat,
        df: [df1, df2],
        df_between: df1,
        df_within: df2,
        ss_between: ss_between,
        ss_within: ss_within,
        ms_between: ms_between,
        ms_within: ms_within,
        p_value: p_val,
        ci_95: [0.0, f_dist_ppf(0.95, df1, df2)],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn mann_whitney_u(a, b) {
    let n1 = len(a);
    let n2 = len(b);
    if n1 == 0 or n2 == 0 { return error("mann_whitney_u: samples must be non-empty"); }
    let n = n1 + n2;
    // Combine and sort values alongside group tag (0 for a, 1 for b)
    let vals = [];
    let tags = [];
    let i = 0;
    while i < n1 { array_push(vals, a[i]); array_push(tags, 0); i = i + 1; }
    i = 0;
    while i < n2 { array_push(vals, b[i]); array_push(tags, 1); i = i + 1; }

    // Insertion sort on (vals, tags)
    i = 1;
    while i < n {
        let kv = vals[i];
        let kt = tags[i];
        let j = i - 1;
        while j >= 0 and vals[j] > kv {
            vals[j + 1] = vals[j];
            tags[j + 1] = tags[j];
            j = j - 1;
        }
        vals[j + 1] = kv;
        tags[j + 1] = kt;
        i = i + 1;
    }

    let ranks = _zeros(n);
    let tie_corr = 0.0;
    i = 0;
    while i < n {
        let j = i + 1;
        while j < n and vals[j] == vals[i] { j = j + 1; }
        let avg_rank = 0.5 * ((i + 1.0) + j);
        let t_cnt = j - i;
        if t_cnt > 1 {
            tie_corr = tie_corr + (t_cnt * t_cnt * t_cnt - t_cnt);
        }
        let r = i;
        while r < j { ranks[r] = avg_rank; r = r + 1; }
        i = j;
    }

    let rank_sum_a = 0.0;
    i = 0;
    while i < n {
        if tags[i] == 0 { rank_sum_a = rank_sum_a + ranks[i]; }
        i = i + 1;
    }
    let u1 = rank_sum_a - 0.5 * n1 * (n1 + 1.0);
    let u2 = n1 * n2 - u1;
    let mu_u = 0.5 * n1 * n2;
    let var_u = (n1 * n2 / 12.0) * ((n + 1.0) - tie_corr / (n * (n - 1.0)));
    let p_val = 1.0;
    if var_u > 0 {
        let diff_u = num_abs(u1 - mu_u);
        let cc = _max(0.0, diff_u - 0.5);
        let z = cc / num_sqrt(var_u);
        p_val = 2.0 * (1.0 - normal_cdf(z, 0.0, 1.0));
    }

    // Hodges-Lehmann pairwise differences for location shift 95% CI
    let diffs = [];
    i = 0;
    while i < n1 {
        let j = 0;
        while j < n2 {
            array_push(diffs, a[i] - b[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    let sdiffs = array_sort(diffs);
    let m_pairs = len(sdiffs);
    let k_alpha = num_floor(mu_u - 0.5 - norm_ppf(0.975) * num_sqrt(_max(0.0, var_u)));
    let lo_idx = _clamp(k_alpha, 0, m_pairs - 1);
    let hi_idx = _clamp(m_pairs - 1 - lo_idx, 0, m_pairs - 1);

    return map{
        statistic: u1,
        u1: u1,
        u2: u2,
        df: nil,
        p_value: p_val,
        ci_95: [sdiffs[lo_idx], sdiffs[hi_idx]],
        reject_h0_at_0_05: p_val < 0.05
    };
}

fn ks_test_normal(sample, mu, sigma) {
    let n = len(sample);
    if n == 0 or sigma <= 0 { return error("ks_test_normal: require non-empty sample and sigma > 0"); }
    let xs = array_sort(sample);
    let d_max = 0.0;
    let i = 0;
    while i < n {
        let cdf_i = normal_cdf(xs[i], mu, sigma);
        let dp = (i + 1.0) / n - cdf_i;
        let dm = cdf_i - (i * 1.0) / n;
        if dp > d_max { d_max = dp; }
        if dm > d_max { d_max = dm; }
        i = i + 1;
    }
    let sqn = num_sqrt(n);
    let lam = (sqn + 0.12 + 0.11 / sqn) * d_max;
    let q_sum = 0.0;
    let k = 1;
    while k <= 100 {
        let sign = 1.0;
        if num_mod(k, 2) == 0 { sign = -1.0; }
        let term = sign * num_exp(-2.0 * k * k * lam * lam);
        q_sum = q_sum + term;
        if num_abs(term) < 1e-15 { break; }
        k = k + 1;
    }
    let p_val = _clamp(2.0 * q_sum, 0.0, 1.0);
    let crit_95 = 1.35810 / (sqn + 0.12 + 0.11 / sqn);
    return map{
        statistic: d_max,
        df: nil,
        p_value: p_val,
        ci_95: [0.0, crit_95],
        reject_h0_at_0_05: p_val < 0.05
    };
}

// 1.3 Multivariate Regression, Polynomial Regression, Logistic Regression & PCA

fn ols_fit(X_rows, y, add_intercept = true) {
    if type(X_rows) != "array" or type(y) != "array" {
        return error("ols_fit: X_rows and y must be arrays");
    }
    let n = len(X_rows);
    if n != len(y) or n < 1 {
        return error("ols_fit: mismatched or empty observations");
    }
    let use_intercept = true;
    if type(add_intercept) == "bool" {
        use_intercept = add_intercept;
    } else if type(add_intercept) == "map" and map_has(add_intercept, "add_intercept") {
        use_intercept = add_intercept["add_intercept"] == true;
    }

    let norm_rows = [];
    let ri = 0;
    while ri < n {
        if type(X_rows[ri]) == "array" {
            array_push(norm_rows, X_rows[ri]);
        } else {
            array_push(norm_rows, [X_rows[ri]]);
        }
        ri = ri + 1;
    }

    let d_raw = len(norm_rows[0]);
    let p = d_raw;
    if use_intercept { p = d_raw + 1; }
    if p < 1 {
        return error("ols_fit: design matrix must have at least 1 column");
    }

    let X = _mat_zeros(n, p);
    let i = 0;
    while i < n {
        if use_intercept {
            X[i][0] = 1.0;
            let j = 0;
            while j < d_raw { X[i][j + 1] = norm_rows[i][j] + 0.0; j = j + 1; }
        } else {
            let j = 0;
            while j < d_raw { X[i][j] = norm_rows[i][j] + 0.0; j = j + 1; }
        }
        i = i + 1;
    }

    let y_vec = [];
    i = 0;
    while i < n { array_push(y_vec, y[i] + 0.0); i = i + 1; }

    let svd_res = LG.svd(X);
    let eff_rank = svd_res.rank;
    let is_collinear = (eff_rank < p);
    let use_pinv = is_collinear or (n <= p) or (svd_res.cond_2 > 1e12);

    let beta = [];
    let cov_unscaled_diag = _zeros(p);
    let method_used = "normal_equations";

    if !use_pinv {
        let Xt = _mat_transpose(X);
        let XtX = _mat_mul(Xt, X);
        let Xty = _mat_vec(Xt, y_vec);
        let inv_ok = false;
        let inv_XtX = nil;
        try {
            inv_XtX = _mat_inv(XtX);
            inv_ok = true;
        } catch _e {
            inv_ok = false;
        }
        if inv_ok and inv_XtX != nil {
            beta = _mat_vec(inv_XtX, Xty);
            let jj = 0;
            while jj < p {
                cov_unscaled_diag[jj] = _max(0.0, inv_XtX[jj][jj]);
                jj = jj + 1;
            }
        } else {
            use_pinv = true;
            is_collinear = true;
        }
    }

    if use_pinv {
        method_used = "svd_moore_penrose_pinv";
        let X_pinv = LG.pinv(X);
        beta = _mat_vec(X_pinv, y_vec);
        let jj = 0;
        while jj < p {
            let sq_sum = 0.0;
            let kk = 0;
            while kk < n {
                let pv = X_pinv[jj][kk];
                sq_sum = sq_sum + pv * pv;
                kk = kk + 1;
            }
            cov_unscaled_diag[jj] = sq_sum;
            jj = jj + 1;
        }
    }

    let y_mean = _sample_mean(y_vec);
    let rss = 0.0;
    let tss = 0.0;
    let residuals = [];
    i = 0;
    while i < n {
        let y_hat = _dot(X[i], beta);
        let e = y_vec[i] - y_hat;
        array_push(residuals, e);
        rss = rss + e * e;
        if use_intercept {
            let dy = y_vec[i] - y_mean;
            tss = tss + dy * dy;
        } else {
            tss = tss + y_vec[i] * y_vec[i];
        }
        i = i + 1;
    }

    let df_resid = _max(0, n - eff_rank);
    let df_model = eff_rank;
    if use_intercept and df_model > 0 { df_model = df_model - 1; }
    let sigma2 = 0.0;
    if df_resid > 0 { sigma2 = rss / df_resid; }

    let std_errors = [];
    let t_stats = [];
    let p_values = [];
    let j = 0;
    while j < p {
        let se_j = 0.0;
        if df_resid > 0 {
            se_j = num_sqrt(_max(0.0, sigma2 * cov_unscaled_diag[j]));
        }
        array_push(std_errors, se_j);
        if se_j > 0.0 and df_resid > 0 {
            let tj = beta[j] / se_j;
            array_push(t_stats, tj);
            array_push(p_values, 2.0 * (1.0 - student_t_cdf(num_abs(tj), df_resid)));
        } else {
            array_push(t_stats, 0.0);
            array_push(p_values, 1.0);
        }
        j = j + 1;
    }

    let r2 = 1.0;
    if tss > 0.0 {
        r2 = 1.0 - rss / tss;
    } else if rss > 1e-24 {
        r2 = 0.0;
    }
    let adj_r2 = r2;
    if df_resid > 0 and n > 1 {
        adj_r2 = 1.0 - (1.0 - r2) * (n - 1.0) / df_resid;
    }
    let f_stat = 0.0;
    let f_p_value = 1.0;
    if df_model > 0 and df_resid > 0 and sigma2 > 0.0 {
        f_stat = ((_max(0.0, tss - rss)) / df_model) / sigma2;
        f_p_value = 1.0 - f_dist_cdf(_max(0.0, f_stat), df_model, df_resid);
    } else if df_model > 0 and df_resid > 0 and sigma2 == 0.0 {
        f_stat = _INF;
        f_p_value = 0.0;
    }

    let rss_safe = _max(rss, 1e-300);
    let ll = -0.5 * n * (num_ln(_TWO_PI) + num_ln(rss_safe / n) + 1.0);
    let k_eff = eff_rank + 1.0;
    let aic = -2.0 * ll + 2.0 * eff_rank;
    let bic = -2.0 * ll + eff_rank * num_ln(_max(1.0, n + 0.0));

    let pred_fn = fn(x_row) {
        if type(x_row) != "array" {
            if use_intercept and d_raw == 1 {
                return beta[0] + beta[1] * x_row;
            }
            return beta[0] * x_row;
        }
        if use_intercept and len(x_row) == d_raw {
            let acc = beta[0];
            let c = 0;
            while c < d_raw { acc = acc + beta[c + 1] * x_row[c]; c = c + 1; }
            return acc;
        }
        return _dot(x_row, beta);
    };

    return map{
        ok: true,
        method: method_used,
        indeterminate_collinear: is_collinear,
        rank_deficient_indeterminacy: (eff_rank < p),
        effective_rank: eff_rank,
        rank: eff_rank,
        num_parameters: p,
        singular_values: svd_res.singular_values,
        cond_number: svd_res.cond_2,
        coefficients: beta,
        beta: beta,
        params: beta,
        residuals: residuals,
        rss: rss,
        tss: tss,
        std_errors: std_errors,
        t_stats: t_stats,
        p_values: p_values,
        r2: r2,
        adj_r2: adj_r2,
        f_stat: f_stat,
        f_p_value: f_p_value,
        aic: aic,
        bic: bic,
        aic_full: -2.0 * ll + 2.0 * k_eff,
        df_resid: df_resid,
        predict: pred_fn
    };
}

fn multiple_linear_regression(X_rows, y, add_intercept = true) {
    return ols_fit(X_rows, y, add_intercept);
}

fn polynomial_regression(x, y, degree) {
    if degree < 1 { return error("polynomial_regression: degree must be >= 1"); }
    let n = len(x);
    let X_rows = [];
    let i = 0;
    while i < n {
        let row = [];
        let pw = 1.0;
        let d = 1;
        while d <= degree {
            pw = pw * x[i];
            array_push(row, pw);
            d = d + 1;
        }
        array_push(X_rows, row);
        i = i + 1;
    }
    let fit = multiple_linear_regression(X_rows, y, true);
    let coefs = fit.coefficients;
    fit["degree"] = degree;
    fit["predict"] = fn(x_in) {
        if type(x_in) == "array" {
            let xv = x_in[0];
            let s = coefs[0];
            let pw = 1.0;
            let d = 1;
            while d <= degree { pw = pw * xv; s = s + coefs[d] * pw; d = d + 1; }
            return s;
        }
        let s = coefs[0];
        let pw = 1.0;
        let d = 1;
        while d <= degree { pw = pw * x_in; s = s + coefs[d] * pw; d = d + 1; }
        return s;
    };
    return fit;
}

fn _sigmoid(z) {
    if z >= 0 {
        let ez = num_exp(0.0 - z);
        return 1.0 / (1.0 + ez);
    }
    let ez = num_exp(z);
    return ez / (1.0 + ez);
}

fn logistic_regression(X_rows, y_binary, add_intercept = true, l2_ridge = 1e-6) {
    let n = len(X_rows);
    if n != len(y_binary) or n == 0 {
        return error("logistic_regression: X_rows and y_binary must be same non-zero length");
    }
    let d_raw = len(X_rows[0]);
    let p = d_raw;
    if add_intercept { p = d_raw + 1; }

    let X = _mat_zeros(n, p);
    let i = 0;
    while i < n {
        if add_intercept {
            X[i][0] = 1.0;
            let j = 0;
            while j < d_raw { X[i][j + 1] = X_rows[i][j]; j = j + 1; }
        } else {
            let j = 0;
            while j < d_raw { X[i][j] = X_rows[i][j]; j = j + 1; }
        }
        i = i + 1;
    }

    let max_opt = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("stats_opt_applied.logistic_regression");
    let w = _zeros(p);
    let iter = 0;
    while iter < max_opt {
        GOV.tick(trk, n);
        let grad = _zeros(p);
        let H = _mat_zeros(p, p);
        i = 0;
        while i < n {
            let pr = _sigmoid(_dot(X[i], w));
            let diff = y_binary[i] - pr;
            let wt = _max(pr * (1.0 - pr), 1e-9);
            let j = 0;
            while j < p {
                grad[j] = grad[j] + X[i][j] * diff;
                let k = j;
                while k < p {
                    let v = wt * X[i][j] * X[i][k];
                    H[j][k] = H[j][k] + v;
                    if k != j { H[k][j] = H[j][k]; }
                    k = k + 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        let j0 = 0;
        if add_intercept { j0 = 1; }
        let j = j0;
        while j < p {
            grad[j] = grad[j] - l2_ridge * w[j];
            H[j][j] = H[j][j] + l2_ridge;
            j = j + 1;
        }
        if add_intercept { H[0][0] = H[0][0] + 1e-12; }

        let step = _lin_solve(H, grad);
        let j2 = 0;
        while j2 < p { w[j2] = w[j2] + step[j2]; j2 = j2 + 1; }
        iter = iter + 1;
        if _vec_inf_norm(step) < 1e-9 { break; }
    }

    let probs = [];
    let preds = [];
    let correct = 0;
    let nll = 0.0;
    i = 0;
    while i < n {
        let pr = _clamp(_sigmoid(_dot(X[i], w)), 1e-15, 1.0 - 1e-15);
        array_push(probs, pr);
        let pred = 0;
        if pr >= 0.5 { pred = 1; }
        array_push(preds, pred);
        if pred == y_binary[i] { correct = correct + 1; }
        nll = nll - (y_binary[i] * num_ln(pr) + (1.0 - y_binary[i]) * num_ln(1.0 - pr));
        i = i + 1;
    }

    let proba_fn = fn(x_row) {
        if add_intercept and len(x_row) == d_raw {
            let z = w[0];
            let c = 0;
            while c < d_raw { z = z + w[c + 1] * x_row[c]; c = c + 1; }
            return _sigmoid(z);
        }
        return _sigmoid(_dot(x_row, w));
    };

    return map{
        weights: w,
        probabilities: probs,
        predictions: preds,
        accuracy: (correct * 1.0) / n,
        log_loss: nll / n,
        iterations: iter,
        predict_proba: proba_fn,
        predict: fn(x_row) {
            if proba_fn(x_row) >= 0.5 { return 1; }
            return 0;
        }
    };
}

fn pca(X_rows, k_components = nil) {
    let n = len(X_rows);
    if n < 2 { return error("pca: need >= 2 rows"); }
    let d = len(X_rows[0]);
    let k = d;
    if k_components != nil { k = k_components; }
    if k < 1 or k > d { return error("pca: k_components must be in 1..d"); }

    let means = _zeros(d);
    let i = 0;
    while i < n {
        let j = 0;
        while j < d { means[j] = means[j] + X_rows[i][j]; j = j + 1; }
        i = i + 1;
    }
    let j = 0;
    while j < d { means[j] = means[j] / n; j = j + 1; }

    let Xc = _mat_zeros(n, d);
    i = 0;
    while i < n {
        j = 0;
        while j < d { Xc[i][j] = X_rows[i][j] - means[j]; j = j + 1; }
        i = i + 1;
    }

    let cov = _mat_zeros(d, d);
    i = 0;
    while i < n {
        let r = 0;
        while r < d {
            let c = r;
            while c < d {
                cov[r][c] = cov[r][c] + Xc[i][r] * Xc[i][c];
                c = c + 1;
            }
            r = r + 1;
        }
        i = i + 1;
    }
    let r = 0;
    while r < d {
        let c = r;
        while c < d {
            cov[r][c] = cov[r][c] / (n - 1.0);
            cov[c][r] = cov[r][c];
            c = c + 1;
        }
        r = r + 1;
    }

    let eig = _jacobi_sym(cov);
    let evals = eig.eigenvalues;
    let evecs = eig.eigenvectors;

    // Sort eigenvalues descending
    let a = 0;
    while a < d - 1 {
        let best = a;
        let b = a + 1;
        while b < d {
            if evals[b] > evals[best] { best = b; }
            b = b + 1;
        }
        if best != a {
            let tv = evals[a]; evals[a] = evals[best]; evals[best] = tv;
            let te = evecs[a]; evecs[a] = evecs[best]; evecs[best] = te;
        }
        a = a + 1;
    }

    let total_var = 0.0;
    j = 0;
    while j < d {
        if evals[j] < 0 and evals[j] > -1e-12 { evals[j] = 0.0; }
        total_var = total_var + _max(0.0, evals[j]);
        j = j + 1;
    }

    let components = [];
    let exp_var = [];
    let exp_ratio = [];
    j = 0;
    while j < k {
        array_push(components, evecs[j]);
        let ev = _max(0.0, evals[j]);
        array_push(exp_var, ev);
        if total_var > 0 { array_push(exp_ratio, ev / total_var); }
        else { array_push(exp_ratio, 0.0); }
        j = j + 1;
    }

    let transformed = _mat_zeros(n, k);
    i = 0;
    while i < n {
        j = 0;
        while j < k {
            transformed[i][j] = _dot(Xc[i], components[j]);
            j = j + 1;
        }
        i = i + 1;
    }

    return map{
        components: components,
        explained_variance: exp_var,
        explained_variance_ratio: exp_ratio,
        mean: means,
        transformed: transformed
    };
}

// 1.4 Bayesian Conjugate Inference & Markov Chains

fn bayes_beta_binomial(alpha0, beta0, successes, trials) {
    if alpha0 <= 0 or beta0 <= 0 or successes < 0 or trials < successes {
        return error("bayes_beta_binomial: invalid parameters");
    }
    let alpha = alpha0 + successes;
    let beta = beta0 + (trials - successes);
    let mean_val = alpha / (alpha + beta);
    let mode_val = nil;
    if alpha > 1 and beta > 1 {
        mode_val = (alpha - 1.0) / (alpha + beta - 2.0);
    } else if alpha <= 1 and beta > 1 {
        mode_val = 0.0;
    } else if alpha > 1 and beta <= 1 {
        mode_val = 1.0;
    }
    return map{
        alpha: alpha,
        beta: beta,
        mean: mean_val,
        mode: mode_val,
        variance: (alpha * beta) / ((alpha + beta) * (alpha + beta) * (alpha + beta + 1.0)),
        ci_95: [beta_dist_ppf(0.025, alpha, beta), beta_dist_ppf(0.975, alpha, beta)]
    };
}

fn bayes_normal_normal(mu0, sigma0, obs_array, obs_sigma) {
    if sigma0 <= 0 or obs_sigma <= 0 {
        return error("bayes_normal_normal: standard deviations must be > 0");
    }
    let n = len(obs_array);
    let prec0 = 1.0 / (sigma0 * sigma0);
    let prec_lik = (n * 1.0) / (obs_sigma * obs_sigma);
    let prec_post = prec0 + prec_lik;
    let obs_sum = 0.0;
    let i = 0;
    while i < n { obs_sum = obs_sum + obs_array[i]; i = i + 1; }
    let mu_post = (prec0 * mu0 + obs_sum / (obs_sigma * obs_sigma)) / prec_post;
    let sigma_post = num_sqrt(1.0 / prec_post);
    return map{
        mu: mu_post,
        sigma: sigma_post,
        mean: mu_post,
        mode: mu_post,
        variance: 1.0 / prec_post,
        ci_95: [normal_ppf(0.025, mu_post, sigma_post), normal_ppf(0.975, mu_post, sigma_post)]
    };
}

fn bayes_gamma_poisson(shape0, rate0, counts_array) {
    if shape0 <= 0 or rate0 <= 0 {
        return error("bayes_gamma_poisson: shape0 and rate0 must be > 0");
    }
    let n = len(counts_array);
    let s_cnt = 0.0;
    let i = 0;
    while i < n {
        if counts_array[i] < 0 { return error("bayes_gamma_poisson: counts must be >= 0"); }
        s_cnt = s_cnt + counts_array[i];
        i = i + 1;
    }
    let shape_post = shape0 + s_cnt;
    let rate_post = rate0 + n;
    let mode_val = 0.0;
    if shape_post > 1 { mode_val = (shape_post - 1.0) / rate_post; }
    return map{
        shape: shape_post,
        rate: rate_post,
        mean: shape_post / rate_post,
        mode: mode_val,
        variance: shape_post / (rate_post * rate_post),
        ci_95: [gamma_dist_ppf(0.025, shape_post, rate_post), gamma_dist_ppf(0.975, shape_post, rate_post)]
    };
}

fn markov_stationary(P) {
    let m = len(P);
    if m == 0 { return error("markov_stationary: empty matrix"); }
    if m == 1 { return [1.0]; }
    // Solve least-squares system [ (P^T - I); 1^T ] * pi = [ 0; ...; 0; 1 ]
    let A = _mat_zeros(m + 1, m);
    let b = _zeros(m + 1);
    let i = 0;
    while i < m {
        let j = 0;
        while j < m {
            A[i][j] = P[j][i];
            if i == j { A[i][j] = A[i][j] - 1.0; }
            j = j + 1;
        }
        A[m][i] = 1.0;
        i = i + 1;
    }
    b[m] = 1.0;
    let At = _mat_transpose(A);
    let AtA = _mat_mul(At, A);
    let Atb = _mat_vec(At, b);
    let pi_vec = _lin_solve(AtA, Atb);
    let total = 0.0;
    i = 0;
    while i < m {
        if pi_vec[i] < 0 and pi_vec[i] > -1e-12 { pi_vec[i] = 0.0; }
        total = total + pi_vec[i];
        i = i + 1;
    }
    i = 0;
    while i < m { pi_vec[i] = pi_vec[i] / total; i = i + 1; }
    return pi_vec;
}

fn markov_n_step(P, n) {
    if n < 0 { return error("markov_n_step: n must be >= 0"); }
    let m = len(P);
    let res = _mat_eye(m);
    let base = _mat_copy(P);
    let exp_n = num_floor(n);
    while exp_n > 0 {
        if num_mod(exp_n, 2) == 1 {
            res = _mat_mul(res, base);
        }
        exp_n = num_floor(exp_n / 2);
        if exp_n > 0 { base = _mat_mul(base, base); }
    }
    return res;
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2: Mathematical Optimization (Simplex LP, MILP, Brent, BFGS, LM, ALM)
// ══════════════════════════════════════════════════════════════════════════════

fn _simplex_pivot(T, basis, piv_row, piv_col) {
    let m = len(T) - 1;
    let cols = len(T[0]);
    let pv = T[piv_row][piv_col];
    let j = 0;
    while j < cols {
        T[piv_row][j] = T[piv_row][j] / pv;
        j = j + 1;
    }
    let i = 0;
    while i <= m {
        if i != piv_row {
            let factor = T[i][piv_col];
            if factor != 0 {
                j = 0;
                while j < cols {
                    T[i][j] = T[i][j] - factor * T[piv_row][j];
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    basis[piv_row] = piv_col;
}

// Runs simplex maximization on tableau T where last row T[m] stores reduced costs
// c_bar[j] (enter when c_bar[j] > eps) and T[i][rhs_col] >= 0 is RHS.
fn _simplex_run(T, basis, n_vars_active) {
    let m = len(T) - 1;
    let rhs_col = len(T[0]) - 1;
    let max_opt = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("stats_opt_applied.linprog_simplex");
    let iter = 0;
    while iter < max_opt {
        GOV.tick(trk, m + 1);
        let use_bland = iter > 40;
        let enter = -1;
        let best_rc = 1e-9;
        let j = 0;
        while j < n_vars_active {
            let rc = T[m][j];
            if use_bland {
                if rc > 1e-9 { enter = j; break; }
            } else {
                if rc > best_rc { best_rc = rc; enter = j; }
            }
            j = j + 1;
        }
        if enter == -1 { return "optimal"; }

        let leave = -1;
        let best_ratio = _INF;
        let i = 0;
        while i < m {
            let a_ij = T[i][enter];
            if a_ij > 1e-10 {
                let ratio = T[i][rhs_col] / a_ij;
                if leave == -1 or ratio < best_ratio - 1e-13
                   or (num_abs(ratio - best_ratio) <= 1e-13 and basis[i] < basis[leave]) {
                    best_ratio = ratio;
                    leave = i;
                }
            }
            i = i + 1;
        }
        if leave == -1 { return "unbounded"; }
        _simplex_pivot(T, basis, leave, enter);
        iter = iter + 1;
    }
    return error("MathGovernor[linprog_simplex]: exceeded adaptive max_opt_iter (" + str(max_opt) + ")");
}

// Two-Phase Simplex LP solver:
//   max/min c^T x  subject to  A_ub x <= b_ub,  A_eq x = b_eq,  x >= 0
fn linprog_simplex(c, A_ub, b_ub, A_eq = nil, b_eq = nil, maximize = true) {
    let n = len(c);
    let m_ub = 0;
    if A_ub != nil { m_ub = len(A_ub); }
    let m_eq = 0;
    if A_eq != nil { m_eq = len(A_eq); }
    let M = m_ub + m_eq;

    if M == 0 {
        let i = 0;
        while i < n {
            let cj = c[i];
            if !maximize { cj = 0.0 - cj; }
            if cj > 1e-12 {
                let inf_obj = _INF;
                if !maximize { inf_obj = 0.0 - inf_obj; }
                return map{ status: "unbounded", x: nil, objective: inf_obj, shadow_prices: [] };
            }
            i = i + 1;
        }
        return map{ status: "optimal", x: _zeros(n), objective: 0.0, shadow_prices: [] };
    }

    let n_real = n + m_ub;
    // Build original unflipped constraint matrix G_orig (M x n_real) for dual recovery
    let G_orig = _mat_zeros(M, n_real);
    let row_needs_art = [];
    let n_art = 0;

    let r = 0;
    while r < m_ub {
        let j = 0;
        while j < n { G_orig[r][j] = A_ub[r][j]; j = j + 1; }
        G_orig[r][n + r] = 1.0;
        if b_ub[r] < -1e-12 {
            array_push(row_needs_art, true);
            n_art = n_art + 1;
        } else {
            array_push(row_needs_art, false);
        }
        r = r + 1;
    }
    r = 0;
    while r < m_eq {
        let rr = m_ub + r;
        let j = 0;
        while j < n { G_orig[rr][j] = A_eq[r][j]; j = j + 1; }
        array_push(row_needs_art, true);
        n_art = n_art + 1;
        r = r + 1;
    }

    let total_cols = n_real + n_art + 1;
    let rhs_col = total_cols - 1;
    let T = _mat_zeros(M + 1, total_cols);
    let basis = [];
    let art_idx = 0;

    r = 0;
    while r < M {
        let raw_b = 0.0;
        if r < m_ub { raw_b = b_ub[r]; } else { raw_b = b_eq[r - m_ub]; }
        let flip = 1.0;
        if raw_b < -1e-12 { flip = -1.0; }
        let j = 0;
        while j < n_real { T[r][j] = flip * G_orig[r][j]; j = j + 1; }
        T[r][rhs_col] = _max(0.0, flip * raw_b);

        if row_needs_art[r] {
            let acol = n_real + art_idx;
            T[r][acol] = 1.0;
            array_push(basis, acol);
            art_idx = art_idx + 1;
        } else {
            array_push(basis, n + r);
        }
        r = r + 1;
    }

    // Phase I: maximize -sum(artificials)
    if n_art > 0 {
        let a = 0;
        while a < n_art { T[M][n_real + a] = -1.0; a = a + 1; }
        r = 0;
        while r < M {
            if basis[r] >= n_real {
                let j = 0;
                while j < total_cols {
                    T[M][j] = T[M][j] + T[r][j];
                    j = j + 1;
                }
            }
            r = r + 1;
        }
        let st1 = _simplex_run(T, basis, n_real + n_art);
        // Note: objective value of Phase I max(-w) equals -T[M][rhs_col]; feasible iff w <= 1e-7
        let w_opt = T[M][rhs_col];
        if st1 != "optimal" or w_opt > 1e-7 {
            return map{ status: "infeasible", x: nil, objective: nil, shadow_prices: nil };
        }

        // Drive degenerate artificials out of basis
        let keep_rows = [];
        let keep_orig_idx = [];
        r = 0;
        while r < M {
            if basis[r] >= n_real {
                let piv_c = -1;
                let j = 0;
                while j < n_real {
                    if num_abs(T[r][j]) > 1e-10 { piv_c = j; break; }
                    j = j + 1;
                }
                if piv_c != -1 {
                    _simplex_pivot(T, basis, r, piv_c);
                    array_push(keep_rows, r);
                    array_push(keep_orig_idx, r);
                }
                // else redundant 0 = 0 row, drop cleanly
            } else {
                array_push(keep_rows, r);
                array_push(keep_orig_idx, r);
            }
            r = r + 1;
        }

        // Rebuild compact Phase-II tableau without artificial columns
        let M2 = len(keep_rows);
        let T2 = _mat_zeros(M2 + 1, n_real + 1);
        let basis2 = [];
        let G2 = _mat_zeros(M2, n_real);
        let kr = 0;
        while kr < M2 {
            let old_r = keep_rows[kr];
            let j = 0;
            while j < n_real {
                T2[kr][j] = T[old_r][j];
                G2[kr][j] = G_orig[old_r][j];
                j = j + 1;
            }
            T2[kr][n_real] = _max(0.0, T[old_r][rhs_col]);
            array_push(basis2, basis[old_r]);
            kr = kr + 1;
        }
        T = T2;
        basis = basis2;
        G_orig = G2;
        M = M2;
        rhs_col = n_real;
    }

    // Phase II objective row: maximize c_eff^T x
    let c_eff = _zeros(n_real);
    let c_orig_ext = _zeros(n_real);
    let j = 0;
    while j < n {
        c_orig_ext[j] = c[j];
        if maximize { c_eff[j] = c[j]; } else { c_eff[j] = 0.0 - c[j]; }
        j = j + 1;
    }
    j = 0;
    while j <= n_real { T[M][j] = 0.0; j = j + 1; }
    j = 0;
    while j < n_real { T[M][j] = c_eff[j]; j = j + 1; }

    // Eliminate basic variables from Phase II objective row
    r = 0;
    while r < M {
        let bv = basis[r];
        let cb = c_eff[bv];
        if cb != 0 {
            j = 0;
            while j <= n_real {
                T[M][j] = T[M][j] - cb * T[r][j];
                j = j + 1;
            }
        }
        r = r + 1;
    }

    let st2 = _simplex_run(T, basis, n_real);
    if st2 == "unbounded" {
        let inf_obj = _INF;
        if !maximize { inf_obj = 0.0 - inf_obj; }
        return map{ status: "unbounded", x: nil, objective: inf_obj, shadow_prices: nil };
    }

    let x_full = _zeros(n_real);
    r = 0;
    while r < M {
        x_full[basis[r]] = _max(0.0, T[r][rhs_col]);
        r = r + 1;
    }
    let x_out = [];
    let obj = 0.0;
    j = 0;
    while j < n {
        array_push(x_out, x_full[j]);
        obj = obj + c[j] * x_full[j];
        j = j + 1;
    }

    // Shadow prices dz*/db via B_orig^T * y = c_B
    let shadow = _zeros(m_ub + m_eq);
    if M > 0 and M == m_ub + m_eq {
        let Bt = _mat_zeros(M, M);
        let cB = _zeros(M);
        r = 0;
        while r < M {
            let bv = basis[r];
            cB[r] = c_orig_ext[bv];
            let k = 0;
            while k < M {
                Bt[r][k] = G_orig[k][bv];
                k = k + 1;
            }
            r = r + 1;
        }
        try {
            shadow = _lin_solve(Bt, cB);
        } catch _e {
            // Fallback from slack reduced costs for inequality constraints
            let si = 0;
            while si < m_ub {
                let rc_s = 0.0 - T[M][n + si];
                if !maximize { rc_s = 0.0 - rc_s; }
                shadow[si] = rc_s;
                si = si + 1;
            }
        }
    }

    return map{
        status: "optimal",
        x: x_out,
        objective: obj,
        fun: obj,
        shadow_prices: shadow
    };
}

// Branch-and-Bound Mixed-Integer Linear Programming
fn milp_solve(c, A_ub, b_ub, int_indices, maximize = true) {
    let n = len(c);
    let best_x = nil;
    let best_obj = _NEG_INF;
    if !maximize { best_obj = _INF; }

    let max_nodes = GOV.current_limits()["max_milp_nodes"];
    let trk = GOV.new_tracker("stats_opt_applied.milp_solve");
    let stack = [map{ A: _mat_copy(A_ub), b: _vec_copy(b_ub) }];
    let nodes = 0;

    while len(stack) > 0 {
        nodes = nodes + 1;
        GOV.tick(trk, 1);
        if nodes > max_nodes {
            return error("MathGovernor[milp_solve]: exceeded adaptive max_milp_nodes cap (" + str(max_nodes) + ")");
        }
        let node = pop(stack);
        let lp = linprog_simplex(c, node.A, node.b, nil, nil, maximize);
        if lp.status != "optimal" {
            if lp.status == "unbounded" and len(int_indices) == 0 {
                return map{ status: "unbounded", x: nil, objective: lp.objective, nodes_explored: nodes };
            }
            continue;
        }

        // Bound pruning against current incumbent
        if best_x != nil {
            if maximize and lp.objective <= best_obj + 1e-9 { continue; }
            if !maximize and lp.objective >= best_obj - 1e-9 { continue; }
        }

        // Find most-fractional integer variable
        let branch_var = -1;
        let best_frac = 0.0;
        let k = 0;
        while k < len(int_indices) {
            let idx = int_indices[k];
            let val = lp.x[idx];
            let frac_dist = num_abs(val - num_round(val));
            if frac_dist > 1e-6 and frac_dist > best_frac {
                best_frac = frac_dist;
                branch_var = idx;
            }
            k = k + 1;
        }

        if branch_var == -1 {
            // Integral feasible solution found
            let cand_x = _vec_copy(lp.x);
            k = 0;
            while k < len(int_indices) {
                let idx = int_indices[k];
                cand_x[idx] = num_round(cand_x[idx]);
                k = k + 1;
            }
            let cand_obj = _dot(c, cand_x);
            if best_x == nil or (maximize and cand_obj > best_obj) or (!maximize and cand_obj < best_obj) {
                best_obj = cand_obj;
                best_x = cand_x;
            }
        } else {
            let xv = lp.x[branch_var];
            let fl = num_floor(xv);
            let cl = num_ceil(xv);
            if cl <= fl { cl = fl + 1.0; }

            // Branch 1: x[branch_var] <= floor(xv)
            let A_lo = _mat_copy(node.A);
            let b_lo = _vec_copy(node.b);
            let row_lo = _zeros(n);
            row_lo[branch_var] = 1.0;
            array_push(A_lo, row_lo);
            array_push(b_lo, fl);

            // Branch 2: x[branch_var] >= ceil(xv)  <==>  -x[branch_var] <= -ceil(xv)
            let A_hi = _mat_copy(node.A);
            let b_hi = _vec_copy(node.b);
            let row_hi = _zeros(n);
            row_hi[branch_var] = -1.0;
            array_push(A_hi, row_hi);
            array_push(b_hi, 0.0 - cl);

            // Push in order so closer branch is popped first
            if xv - fl < 0.5 {
                array_push(stack, map{ A: A_hi, b: b_hi });
                array_push(stack, map{ A: A_lo, b: b_lo });
            } else {
                array_push(stack, map{ A: A_lo, b: b_lo });
                array_push(stack, map{ A: A_hi, b: b_hi });
            }
        }
    }

    if best_x == nil {
        return map{ status: "infeasible", x: nil, objective: nil, nodes_explored: nodes };
    }
    return map{
        status: "optimal",
        x: best_x,
        objective: best_obj,
        fun: best_obj,
        nodes_explored: nodes
    };
}

// Brent's 1D derivative-free golden-section + parabolic minimization on [ax, bx]
fn minimize_1d_brent(f, ax, bx, tol = 1e-10) {
    let a = _min(ax, bx);
    let b = _max(ax, bx);
    let cgold = 0.3819660112501051; // (3 - sqrt(5)) / 2
    let zeps = 1e-13;

    let x = a + cgold * (b - a);
    let w = x;
    let v = x;
    let fx = f(x);
    let fw = fx;
    let fv = fx;
    let d = 0.0;
    let e = 0.0;

    let max_opt = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("stats_opt_applied.minimize_1d_brent");
    let iter = 0;
    while iter < max_opt {
        GOV.tick(trk, 1);
        let xm = 0.5 * (a + b);
        let tol1 = tol * num_abs(x) + zeps;
        let tol2 = 2.0 * tol1;
        if num_abs(x - xm) <= (tol2 - 0.5 * (b - a)) {
            return map{ x: x, fun: fx, iterations: iter, converged: true };
        }
        let use_golden = true;
        if num_abs(e) > tol1 {
            let r = (x - w) * (fx - fv);
            let q = (x - v) * (fx - fw);
            let p = (x - v) * q - (x - w) * r;
            q = 2.0 * (q - r);
            if q > 0 { p = 0.0 - p; }
            q = num_abs(q);
            let etemp = e;
            e = d;
            if num_abs(p) < num_abs(0.5 * q * etemp) and p > q * (a - x) and p < q * (b - x) {
                d = p / q;
                let u_try = x + d;
                if (u_try - a) < tol2 or (b - u_try) < tol2 {
                    if xm - x >= 0 { d = tol1; } else { d = 0.0 - tol1; }
                }
                use_golden = false;
            }
        }
        if use_golden {
            if x >= xm { e = a - x; } else { e = b - x; }
            d = cgold * e;
        }
        let u = x + d;
        if num_abs(d) < tol1 {
            if d >= 0 { u = x + tol1; } else { u = x - tol1; }
        }
        let fu = f(u);
        if fu <= fx {
            if u >= x { a = x; } else { b = x; }
            v = w; fv = fw;
            w = x; fw = fx;
            x = u; fx = fu;
        } else {
            if u < x { a = u; } else { b = u; }
            if fu <= fw or w == x {
                v = w; fv = fw;
                w = u; fw = fu;
            } else if fu <= fv or v == x or v == w {
                v = u; fv = fu;
            }
        }
        iter = iter + 1;
    }
    return map{ x: x, fun: fx, iterations: iter, converged: false };
}

fn _central_grad(f, x) {
    let n = len(x);
    let g = _zeros(n);
    let xp = _vec_copy(x);
    let i = 0;
    while i < n {
        let xi = x[i];
        let h = 1e-7 * _max(1.0, num_abs(xi));
        xp[i] = xi + h;
        let fp = f(xp);
        xp[i] = xi - h;
        let fm = f(xp);
        xp[i] = xi;
        g[i] = (fp - fm) / (2.0 * h);
        i = i + 1;
    }
    return g;
}

// Quasi-Newton BFGS with Armijo backtracking line search & central finite-difference gradient
fn minimize_bfgs(f, x0, tol = 1e-8) {
    let n = len(x0);
    let x = _vec_copy(x0);
    let fx = f(x);
    let g = _central_grad(f, x);
    let H = _mat_eye(n);

    let max_opt = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("stats_opt_applied.minimize_bfgs");
    let iter = 0;
    while iter < max_opt {
        GOV.tick(trk, n);
        let gnorm = _vec_inf_norm(g);
        if gnorm <= tol {
            return map{ x: x, fun: fx, grad_norm: gnorm, iterations: iter, converged: true };
        }

        // d = -H * g
        let d = _zeros(n);
        let i = 0;
        while i < n { d[i] = 0.0 - _dot(H[i], g); i = i + 1; }
        let slope = _dot(g, d);
        if slope >= 0 {
            H = _mat_eye(n);
            i = 0;
            while i < n { d[i] = 0.0 - g[i]; i = i + 1; }
            slope = _dot(g, d);
        }

        // Armijo backtracking line search
        let alpha = 1.0;
        let c1 = 1e-4;
        let x_new = _vec_copy(x);
        let f_new = fx;
        let ls = 0;
        let accepted = false;
        while ls < 55 {
            i = 0;
            while i < n { x_new[i] = x[i] + alpha * d[i]; i = i + 1; }
            f_new = f(x_new);
            if f_new <= fx + c1 * alpha * slope {
                accepted = true;
                break;
            }
            alpha = alpha * 0.5;
            ls = ls + 1;
        }
        if !accepted {
            if _vec_inf_norm(g) <= tol * 100.0 {
                return map{ x: x, fun: fx, grad_norm: _vec_inf_norm(g), iterations: iter, converged: true };
            }
            H = _mat_eye(n);
            i = 0;
            while i < n { x_new[i] = x[i] - 1e-8 * g[i]; i = i + 1; }
            f_new = f(x_new);
        }

        let g_new = _central_grad(f, x_new);
        let s = _zeros(n);
        let yv = _zeros(n);
        i = 0;
        while i < n {
            s[i] = x_new[i] - x[i];
            yv[i] = g_new[i] - g[i];
            i = i + 1;
        }

        let ys = _dot(yv, s);
        let sn = _vec_norm(s);
        let yn = _vec_norm(yv);
        if ys > 1e-14 * sn * yn {
            let rho = 1.0 / ys;
            let Hy = _mat_vec(H, yv);
            let yHy = _dot(yv, Hy);
            let c_ss = rho * (1.0 + rho * yHy);
            i = 0;
            while i < n {
                let j = 0;
                while j < n {
                    H[i][j] = H[i][j] - rho * (s[i] * Hy[j] + Hy[i] * s[j]) + c_ss * s[i] * s[j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }

        x = x_new;
        fx = f_new;
        g = g_new;
        iter = iter + 1;

        if sn <= 1e-14 * _max(1.0, _vec_norm(x)) and _vec_inf_norm(g) <= tol * 10.0 {
            return map{ x: x, fun: fx, grad_norm: _vec_inf_norm(g), iterations: iter, converged: true };
        }
    }
    return map{ x: x, fun: fx, grad_norm: _vec_inf_norm(g), iterations: iter, converged: _vec_inf_norm(g) <= tol };
}

// Levenberg-Marquardt damped nonlinear least squares for y_i = model_fn(x_i, params)
fn curve_fit_lm(model_fn, x_data, y_data, params0) {
    let n = len(x_data);
    let m = len(params0);
    if n != len(y_data) or n < m or m == 0 {
        return error("curve_fit_lm: invalid data or parameter dimensions");
    }

    let theta = _vec_copy(params0);
    let resid = _zeros(n);
    let ssr = 0.0;
    let i = 0;
    while i < n {
        resid[i] = y_data[i] - model_fn(x_data[i], theta);
        ssr = ssr + resid[i] * resid[i];
        i = i + 1;
    }

    let max_opt = GOV.current_limits()["max_opt_iter"];
    let trk = GOV.new_tracker("stats_opt_applied.curve_fit_lm");
    let lam = 1e-3;
    let iter = 0;
    let converged = false;

    while iter < max_opt {
        GOV.tick(trk, n);
        if ssr < 1e-28 { converged = true; break; }

        // Numerical Jacobian J[i][j] = d model_fn(x_i, theta) / d theta_j
        let J = _mat_zeros(n, m);
        let tp = _vec_copy(theta);
        let j = 0;
        while j < m {
            let tj = theta[j];
            let h = 1e-7 * _max(1.0, num_abs(tj));
            tp[j] = tj + h;
            let i2 = 0;
            while i2 < n { J[i2][j] = model_fn(x_data[i2], tp); i2 = i2 + 1; }
            tp[j] = tj - h;
            i2 = 0;
            while i2 < n {
                J[i2][j] = (J[i2][j] - model_fn(x_data[i2], tp)) / (2.0 * h);
                i2 = i2 + 1;
            }
            tp[j] = tj;
            j = j + 1;
        }

        let Jt = _mat_transpose(J);
        let JtJ = _mat_mul(Jt, J);
        let Jtr = _mat_vec(Jt, resid);

        if _vec_inf_norm(Jtr) < 1e-11 { converged = true; break; }

        let sub_attempt = 0;
        let step_accepted = false;
        while sub_attempt < 30 {
            let A = _mat_copy(JtJ);
            j = 0;
            while j < m {
                A[j][j] = A[j][j] + lam * _max(JtJ[j][j], 1e-3);
                j = j + 1;
            }
            let delta = nil;
            try {
                delta = _lin_solve(A, Jtr);
            } catch _e {
                delta = nil;
            }
            if delta != nil {
                let cand = _zeros(m);
                j = 0;
                while j < m { cand[j] = theta[j] + delta[j]; j = j + 1; }
                let cand_resid = _zeros(n);
                let cand_ssr = 0.0;
                i = 0;
                while i < n {
                    cand_resid[i] = y_data[i] - model_fn(x_data[i], cand);
                    cand_ssr = cand_ssr + cand_resid[i] * cand_resid[i];
                    i = i + 1;
                }
                if cand_ssr < ssr {
                    let ds = ssr - cand_ssr;
                    theta = cand;
                    resid = cand_resid;
                    ssr = cand_ssr;
                    lam = _max(lam / 3.0, 1e-12);
                    step_accepted = true;
                    if _vec_inf_norm(delta) < 1e-10 or ds <= 1e-15 * (1.0 + ssr) {
                        converged = true;
                    }
                    break;
                }
            }
            lam = lam * 5.0;
            if lam > 1e12 { break; }
            sub_attempt = sub_attempt + 1;
        }

        iter = iter + 1;
        if converged or !step_accepted { break; }
    }

    let y_mean = _sample_mean(y_data);
    let sst = 0.0;
    let preds = [];
    i = 0;
    while i < n {
        array_push(preds, y_data[i] - resid[i]);
        let dy = y_data[i] - y_mean;
        sst = sst + dy * dy;
        i = i + 1;
    }
    let r2 = 1.0;
    if sst > 0 { r2 = 1.0 - ssr / sst; }

    return map{
        params: theta,
        rmse: num_sqrt(ssr / n),
        r2: r2,
        predictions: preds,
        iterations: iter,
        converged: converged
    };
}

// Augmented Lagrangian + BFGS Constrained Nonlinear Optimization:
//   min f(x)  s.t.  eq_constraints[i](x) == 0,  ineq_constraints[j](x) <= 0
fn minimize_constrained(f, x0, eq_constraints = nil, ineq_constraints = nil) {
    let eqs = [];
    if eq_constraints != nil { eqs = eq_constraints; }
    let ineqs = [];
    if ineq_constraints != nil { ineqs = ineq_constraints; }
    let n_eq = len(eqs);
    let n_ineq = len(ineqs);

    if n_eq == 0 and n_ineq == 0 {
        let u = minimize_bfgs(f, x0, 1e-9);
        return map{
            x: u.x,
            fun: u.fun,
            eq_multipliers: [],
            ineq_multipliers: [],
            max_violation: 0.0,
            converged: u.converged
        };
    }

    let x = _vec_copy(x0);
    let lam = _zeros(n_eq);
    let mu = _zeros(n_ineq);
    let rho = 10.0;
    let prev_viol = _INF;
    let outer = 0;
    let converged = false;

    while outer < 25 {
        let inner_tol = _max(1e-9, 1e-3 / num_pow(10.0, _min(outer, 6)));
        let aug_fn = fn(xv) {
            let val = f(xv);
            let i = 0;
            while i < n_eq {
                let gi = eqs[i](xv);
                val = val + lam[i] * gi + 0.5 * rho * gi * gi;
                i = i + 1;
            }
            let j = 0;
            while j < n_ineq {
                let hj = ineqs[j](xv);
                let shifted = _max(0.0, mu[j] + rho * hj);
                val = val + (shifted * shifted - mu[j] * mu[j]) / (2.0 * rho);
                j = j + 1;
            }
            return val;
        };

        let sub = minimize_bfgs(aug_fn, x, inner_tol);
        x = sub.x;

        let viol = 0.0;
        let i = 0;
        while i < n_eq {
            let gi = eqs[i](x);
            if num_abs(gi) > viol { viol = num_abs(gi); }
            i = i + 1;
        }
        let j = 0;
        while j < n_ineq {
            let hj = ineqs[j](x);
            if hj > viol { viol = hj; }
            j = j + 1;
        }

        if viol < 1e-8 and sub.grad_norm < 1e-6 {
            i = 0;
            while i < n_eq { lam[i] = lam[i] + rho * eqs[i](x); i = i + 1; }
            j = 0;
            while j < n_ineq { mu[j] = _max(0.0, mu[j] + rho * ineqs[j](x)); j = j + 1; }
            prev_viol = viol;
            converged = true;
            break;
        }

        i = 0;
        while i < n_eq { lam[i] = lam[i] + rho * eqs[i](x); i = i + 1; }
        j = 0;
        while j < n_ineq { mu[j] = _max(0.0, mu[j] + rho * ineqs[j](x)); j = j + 1; }

        if viol > 0.25 * prev_viol {
            rho = _min(rho * 10.0, 1e8);
        }
        prev_viol = viol;
        outer = outer + 1;
    }

    return map{
        x: x,
        fun: f(x),
        eq_multipliers: lam,
        ineq_multipliers: mu,
        max_violation: prev_viol,
        converged: converged
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3: Discrete Math, Combinatorics, Boolean Quine-McCluskey & Graphs
// ══════════════════════════════════════════════════════════════════════════════

// 3.1 Set Algebra & Exact BigInt Combinatorics

fn _set_key(v) {
    return type(v) + ":" + json_stringify(v);
}

fn _dedup_set(arr) {
    let seen = map{};
    let out = [];
    let i = 0;
    while i < len(arr) {
        let k = _set_key(arr[i]);
        if !map_has(seen, k) {
            seen[k] = true;
            array_push(out, arr[i]);
        }
        i = i + 1;
    }
    return out;
}

fn set_union(a, b) {
    let combined = [];
    let i = 0;
    while i < len(a) { array_push(combined, a[i]); i = i + 1; }
    i = 0;
    while i < len(b) { array_push(combined, b[i]); i = i + 1; }
    return _dedup_set(combined);
}

fn set_intersect(a, b) {
    let b_map = map{};
    let i = 0;
    while i < len(b) { b_map[_set_key(b[i])] = true; i = i + 1; }
    let ua = _dedup_set(a);
    let out = [];
    i = 0;
    while i < len(ua) {
        if map_has(b_map, _set_key(ua[i])) { array_push(out, ua[i]); }
        i = i + 1;
    }
    return out;
}

fn set_diff(a, b) {
    let b_map = map{};
    let i = 0;
    while i < len(b) { b_map[_set_key(b[i])] = true; i = i + 1; }
    let ua = _dedup_set(a);
    let out = [];
    i = 0;
    while i < len(ua) {
        if !map_has(b_map, _set_key(ua[i])) { array_push(out, ua[i]); }
        i = i + 1;
    }
    return out;
}

fn set_symdiff(a, b) {
    return set_union(set_diff(a, b), set_diff(b, a));
}

fn cartesian_product(a, b) {
    let ua = _dedup_set(a);
    let ub = _dedup_set(b);
    let out = [];
    let i = 0;
    while i < len(ua) {
        let j = 0;
        while j < len(ub) {
            array_push(out, [ua[i], ub[j]]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn power_set(a) {
    let ua = _dedup_set(a);
    let n = len(ua);
    if n > 16 {
        return error("power_set: set cardinality exceeds bounded cap (16)");
    }
    let total = num_round(num_pow(2, n));
    let out = [];
    let mask = 0;
    while mask < total {
        let sub = [];
        let m = mask;
        let bit = 0;
        while bit < n {
            if num_mod(m, 2) == 1 { array_push(sub, ua[bit]); }
            m = num_floor(m / 2);
            bit = bit + 1;
        }
        array_push(out, sub);
        mask = mask + 1;
    }
    return out;
}

fn stirling_second(n, k) {
    if n < 0 or k < 0 or k > n { return bigint(0); }
    if n == 0 and k == 0 { return bigint(1); }
    if k == 0 { return bigint(0); }
    let dp = [];
    let j = 0;
    while j <= k { array_push(dp, bigint(0)); j = j + 1; }
    dp[0] = bigint(1);
    let i = 1;
    while i <= n {
        j = _min(i, k);
        while j >= 1 {
            dp[j] = bigint(j) * dp[j] + dp[j - 1];
            j = j - 1;
        }
        dp[0] = bigint(0);
        i = i + 1;
    }
    return dp[k];
}

fn stirling_first_unsigned(n, k) {
    if n < 0 or k < 0 or k > n { return bigint(0); }
    if n == 0 and k == 0 { return bigint(1); }
    if k == 0 { return bigint(0); }
    let dp = [];
    let j = 0;
    while j <= k { array_push(dp, bigint(0)); j = j + 1; }
    dp[0] = bigint(1);
    let i = 1;
    while i <= n {
        j = _min(i, k);
        while j >= 1 {
            dp[j] = bigint(i - 1) * dp[j] + dp[j - 1];
            j = j - 1;
        }
        dp[0] = bigint(0);
        i = i + 1;
    }
    return dp[k];
}

fn bell_number(n) {
    if n < 0 { return error("bell_number: n must be >= 0"); }
    if n == 0 { return bigint(1); }
    let prev = [bigint(1)];
    let r = 1;
    while r <= n {
        let curr = [prev[r - 1]];
        let c = 1;
        while c <= r {
            array_push(curr, curr[c - 1] + prev[c - 1]);
            c = c + 1;
        }
        prev = curr;
        r = r + 1;
    }
    return prev[0];
}

fn catalan_number(n) {
    if n < 0 { return error("catalan_number: n must be >= 0"); }
    let c = bigint(1);
    let i = 1;
    while i <= n {
        c = (c * bigint(4 * i - 2)) / bigint(i + 1);
        i = i + 1;
    }
    return c;
}

// Integer partitions p(n) via Euler's pentagonal number theorem:
// p(n) = sum_{k >= 1} (-1)^{k-1} [ p(n - k(3k-1)/2) + p(n - k(3k+1)/2) ]
fn partition_count(n) {
    if n < 0 { return bigint(0); }
    if n > 10000 { return error("partition_count: n exceeds bounded cap (10000)"); }
    let p = [bigint(1)];
    let m = 1;
    while m <= n {
        let acc = bigint(0);
        let k = 1;
        while true {
            let g1 = (k * (3 * k - 1)) / 2;
            if g1 > m { break; }
            if num_mod(k, 2) == 1 { acc = acc + p[m - g1]; }
            else { acc = acc - p[m - g1]; }

            let g2 = (k * (3 * k + 1)) / 2;
            if g2 <= m {
                if num_mod(k, 2) == 1 { acc = acc + p[m - g2]; }
                else { acc = acc - p[m - g2]; }
            }
            k = k + 1;
        }
        array_push(p, acc);
        m = m + 1;
    }
    return p[n];
}

fn derangements(n) {
    if n < 0 { return error("derangements: n must be >= 0"); }
    if n == 0 { return bigint(1); }
    if n == 1 { return bigint(0); }
    let d_prev2 = bigint(1);
    let d_prev1 = bigint(0);
    let i = 2;
    while i <= n {
        let d_cur = bigint(i - 1) * (d_prev1 + d_prev2);
        d_prev2 = d_prev1;
        d_prev1 = d_cur;
        i = i + 1;
    }
    return d_prev1;
}

fn _bi_mat_mul(A, B, k) {
    let C = [];
    let i = 0;
    while i < k {
        let row = [];
        let j = 0;
        while j < k { array_push(row, bigint(0)); j = j + 1; }
        array_push(C, row);
        i = i + 1;
    }
    i = 0;
    while i < k {
        let p = 0;
        while p < k {
            let a_ip = A[i][p];
            if a_ip != bigint(0) {
                let j = 0;
                while j < k {
                    C[i][j] = C[i][j] + a_ip * B[p][j];
                    j = j + 1;
                }
            }
            p = p + 1;
        }
        i = i + 1;
    }
    return C;
}

// Solves a_n = coeffs[0]*a_{n-1} + coeffs[1]*a_{n-2} + ... + coeffs[k-1]*a_{n-k}
// given init_vals = [a_0, a_1, ..., a_{k-1}] in O(k^3 log n) using BigInt matrix exponentiation.
fn solve_linear_recurrence(coeffs, init_vals, n) {
    let k = len(coeffs);
    if k == 0 or len(init_vals) != k or n < 0 {
        return error("solve_linear_recurrence: require len(coeffs) == len(init_vals) > 0 and n >= 0");
    }
    if n < k { return bigint(init_vals[n]); }

    let T = [];
    let res = [];
    let i = 0;
    while i < k {
        let rT = [];
        let rI = [];
        let j = 0;
        while j < k {
            if i == 0 { array_push(rT, bigint(coeffs[j])); }
            else if j == i - 1 { array_push(rT, bigint(1)); }
            else { array_push(rT, bigint(0)); }

            if i == j { array_push(rI, bigint(1)); }
            else { array_push(rI, bigint(0)); }
            j = j + 1;
        }
        array_push(T, rT);
        array_push(res, rI);
        i = i + 1;
    }

    let power = n - (k - 1);
    while power > 0 {
        if num_mod(power, 2) == 1 {
            res = _bi_mat_mul(res, T, k);
        }
        power = num_floor(power / 2);
        if power > 0 { T = _bi_mat_mul(T, T, k); }
    }

    let ans = bigint(0);
    let j = 0;
    while j < k {
        ans = ans + res[0][j] * bigint(init_vals[k - 1 - j]);
        j = j + 1;
    }
    return ans;
}

// 3.2 Boolean Expression Parser, Truth Table & Quine-McCluskey Minimizer

fn _is_alpha_char(ch) {
    return (ch >= "A" and ch <= "Z") or (ch >= "a" and ch <= "z") or ch == "_";
}

fn _is_alnum_char(ch) {
    return _is_alpha_char(ch) or (ch >= "0" and ch <= "9");
}

fn _bool_tokenize(expr_str) {
    let tokens = [];
    let vars_seen = map{};
    let raw_vars = [];
    let n = len(expr_str);
    let i = 0;
    while i < n {
        let ch = str_slice(expr_str, i, i + 1);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            i = i + 1;
        } else if ch == "(" {
            array_push(tokens, map{ kind: "LPAREN", val: "(" });
            i = i + 1;
        } else if ch == ")" {
            array_push(tokens, map{ kind: "RPAREN", val: ")" });
            i = i + 1;
        } else if i + 3 <= n and (str_slice(expr_str, i, i + 3) == "<->" or str_slice(expr_str, i, i + 3) == "<=>") {
            array_push(tokens, map{ kind: "IFF", val: "<->" });
            i = i + 3;
        } else if i + 2 <= n and (str_slice(expr_str, i, i + 2) == "->" or str_slice(expr_str, i, i + 2) == "=>") {
            array_push(tokens, map{ kind: "IMPLIES", val: "->" });
            i = i + 2;
        } else if i + 2 <= n and str_slice(expr_str, i, i + 2) == "&&" {
            array_push(tokens, map{ kind: "AND", val: "&" });
            i = i + 2;
        } else if i + 2 <= n and str_slice(expr_str, i, i + 2) == "||" {
            array_push(tokens, map{ kind: "OR", val: "|" });
            i = i + 2;
        } else if ch == "&" or ch == "*" {
            array_push(tokens, map{ kind: "AND", val: "&" });
            i = i + 1;
        } else if ch == "|" or ch == "+" {
            array_push(tokens, map{ kind: "OR", val: "|" });
            i = i + 1;
        } else if ch == "^" {
            array_push(tokens, map{ kind: "XOR", val: "^" });
            i = i + 1;
        } else if ch == "!" or ch == "~" {
            array_push(tokens, map{ kind: "NOT", val: "!" });
            i = i + 1;
        } else if ch == "0" or ch == "1" {
            array_push(tokens, map{ kind: "CONST", val: ch == "1" });
            i = i + 1;
        } else if _is_alpha_char(ch) {
            let j = i + 1;
            while j < n and _is_alnum_char(str_slice(expr_str, j, j + 1)) {
                j = j + 1;
            }
            let word = str_slice(expr_str, i, j);
            if word == "and" or word == "AND" {
                array_push(tokens, map{ kind: "AND", val: "&" });
            } else if word == "or" or word == "OR" {
                array_push(tokens, map{ kind: "OR", val: "|" });
            } else if word == "not" or word == "NOT" {
                array_push(tokens, map{ kind: "NOT", val: "!" });
            } else if word == "xor" or word == "XOR" {
                array_push(tokens, map{ kind: "XOR", val: "^" });
            } else if word == "true" or word == "TRUE" {
                array_push(tokens, map{ kind: "CONST", val: true });
            } else if word == "false" or word == "FALSE" {
                array_push(tokens, map{ kind: "CONST", val: false });
            } else {
                array_push(tokens, map{ kind: "VAR", val: word });
                if !map_has(vars_seen, word) {
                    vars_seen[word] = true;
                    array_push(raw_vars, word);
                }
            }
            i = j;
        } else {
            return error("boolean_analyze: unexpected character '" + ch + "'");
        }
    }
    array_push(tokens, map{ kind: "EOF", val: "" });
    return map{ tokens: tokens, vars: array_sort(raw_vars) };
}

fn _bparse_primary(st) {
    let tok = st.tokens[st.pos];
    if tok.kind == "NOT" {
        st["pos"] = st.pos + 1;
        return map{ op: "NOT", child: _bparse_primary(st) };
    }
    if tok.kind == "CONST" {
        st["pos"] = st.pos + 1;
        return map{ op: "CONST", val: tok.val };
    }
    if tok.kind == "VAR" {
        st["pos"] = st.pos + 1;
        return map{ op: "VAR", name: tok.val };
    }
    if tok.kind == "LPAREN" {
        st["pos"] = st.pos + 1;
        let inner = _bparse_iff(st);
        if st.tokens[st.pos].kind != "RPAREN" {
            return error("boolean_analyze: missing closing ')'");
        }
        st["pos"] = st.pos + 1;
        return inner;
    }
    return error("boolean_analyze: unexpected token '" + str(tok.val) + "'");
}

fn _bparse_and(st) {
    let node = _bparse_primary(st);
    while st.tokens[st.pos].kind == "AND" {
        st["pos"] = st.pos + 1;
        node = map{ op: "AND", left: node, right: _bparse_primary(st) };
    }
    return node;
}

fn _bparse_xor(st) {
    let node = _bparse_and(st);
    while st.tokens[st.pos].kind == "XOR" {
        st["pos"] = st.pos + 1;
        node = map{ op: "XOR", left: node, right: _bparse_and(st) };
    }
    return node;
}

fn _bparse_or(st) {
    let node = _bparse_xor(st);
    while st.tokens[st.pos].kind == "OR" {
        st["pos"] = st.pos + 1;
        node = map{ op: "OR", left: node, right: _bparse_xor(st) };
    }
    return node;
}

fn _bparse_implies(st) {
    let node = _bparse_or(st);
    if st.tokens[st.pos].kind == "IMPLIES" {
        st["pos"] = st.pos + 1;
        node = map{ op: "IMPLIES", left: node, right: _bparse_implies(st) };
    }
    return node;
}

fn _bparse_iff(st) {
    let node = _bparse_implies(st);
    while st.tokens[st.pos].kind == "IFF" {
        st["pos"] = st.pos + 1;
        node = map{ op: "IFF", left: node, right: _bparse_implies(st) };
    }
    return node;
}

fn _beval(ast, env) {
    let op = ast.op;
    if op == "CONST" { return ast.val; }
    if op == "VAR" { return env[ast.name]; }
    if op == "NOT" { return !_beval(ast.child, env); }
    let lv = _beval(ast.left, env);
    if op == "AND" { if !lv { return false; } return _beval(ast.right, env); }
    if op == "OR" { if lv { return true; } return _beval(ast.right, env); }
    let rv = _beval(ast.right, env);
    if op == "XOR" { return lv != rv; }
    if op == "IMPLIES" { return (!lv) or rv; }
    if op == "IFF" { return lv == rv; }
    return false;
}

fn _int_to_bitstr(idx, n_vars) {
    let bits = [];
    let v = idx;
    let b = 0;
    while b < n_vars {
        if num_mod(v, 2) == 1 { array_push(bits, "1"); } else { array_push(bits, "0"); }
        v = num_floor(v / 2);
        b = b + 1;
    }
    let s = "";
    let k = n_vars - 1;
    while k >= 0 {
        s = s + bits[k];
        k = k - 1;
    }
    return s;
}

fn _qm_combine_patterns(p1, p2) {
    let n = len(p1);
    let diffs = 0;
    let diff_pos = -1;
    let i = 0;
    while i < n {
        let c1 = str_slice(p1, i, i + 1);
        let c2 = str_slice(p2, i, i + 1);
        if c1 != c2 {
            if c1 == "-" or c2 == "-" { return nil; }
            diffs = diffs + 1;
            diff_pos = i;
            if diffs > 1 { return nil; }
        }
        i = i + 1;
    }
    if diffs != 1 { return nil; }
    return str_slice(p1, 0, diff_pos) + "-" + str_slice(p1, diff_pos + 1, n);
}

fn _qm_covers(pattern, minterm_bits) {
    let n = len(pattern);
    let i = 0;
    while i < n {
        let pc = str_slice(pattern, i, i + 1);
        if pc != "-" and pc != str_slice(minterm_bits, i, i + 1) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _qm_literal_count(pattern) {
    let cnt = 0;
    let i = 0;
    while i < len(pattern) {
        if str_slice(pattern, i, i + 1) != "-" { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

fn _qm_format_implicant(pattern, vars) {
    let lits = [];
    let i = 0;
    while i < len(pattern) {
        let ch = str_slice(pattern, i, i + 1);
        if ch == "1" { array_push(lits, vars[i]); }
        else if ch == "0" { array_push(lits, "!" + vars[i]); }
        i = i + 1;
    }
    if len(lits) == 0 { return "1"; }
    if len(lits) == 1 { return lits[0]; }
    let out = lits[0];
    i = 1;
    while i < len(lits) { out = out + " & " + lits[i]; i = i + 1; }
    return "(" + out + ")";
}

fn _quine_mccluskey(minterms, n_vars, vars) {
    let total_rows = num_round(num_pow(2, n_vars));
    if len(minterms) == 0 {
        return map{ minimal_sop: "0", prime_implicants: [], essential_prime_implicants: [] };
    }
    if len(minterms) == total_rows {
        return map{ minimal_sop: "1", prime_implicants: ["1"], essential_prime_implicants: ["1"] };
    }

    let minterm_bits = [];
    let current = [];
    let i = 0;
    while i < len(minterms) {
        let bs = _int_to_bitstr(minterms[i], n_vars);
        array_push(minterm_bits, bs);
        array_push(current, bs);
        i = i + 1;
    }

    // Iterative prime-implicant generation
    let prime_map = map{};
    let primes = [];
    while len(current) > 0 {
        let m = len(current);
        let used = [];
        i = 0;
        while i < m { array_push(used, false); i = i + 1; }
        let next_seen = map{};
        let next_gen = [];

        i = 0;
        while i < m {
            let j = i + 1;
            while j < m {
                let comb = _qm_combine_patterns(current[i], current[j]);
                if comb != nil {
                    used[i] = true;
                    used[j] = true;
                    if !map_has(next_seen, comb) {
                        next_seen[comb] = true;
                        array_push(next_gen, comb);
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < m {
            if !used[i] and !map_has(prime_map, current[i]) {
                prime_map[current[i]] = true;
                array_push(primes, current[i]);
            }
            i = i + 1;
        }
        current = next_gen;
    }

    // Extract essential prime implicants
    let n_mt = len(minterm_bits);
    let n_pi = len(primes);
    let mt_covered = [];
    i = 0;
    while i < n_mt { array_push(mt_covered, false); i = i + 1; }
    let pi_selected = [];
    i = 0;
    while i < n_pi { array_push(pi_selected, false); i = i + 1; }

    let essential_patterns = [];
    let m_idx = 0;
    while m_idx < n_mt {
        let cov_cnt = 0;
        let last_pi = -1;
        let p_idx = 0;
        while p_idx < n_pi {
            if _qm_covers(primes[p_idx], minterm_bits[m_idx]) {
                cov_cnt = cov_cnt + 1;
                last_pi = p_idx;
            }
            p_idx = p_idx + 1;
        }
        if cov_cnt == 1 and !pi_selected[last_pi] {
            pi_selected[last_pi] = true;
            array_push(essential_patterns, primes[last_pi]);
            let k = 0;
            while k < n_mt {
                if _qm_covers(primes[last_pi], minterm_bits[k]) {
                    mt_covered[k] = true;
                }
                k = k + 1;
            }
        }
        m_idx = m_idx + 1;
    }

    // Uncovered minterms after essential PIs -> exact minimal cover search (with greedy fallback if huge)
    let rem_mts = [];
    m_idx = 0;
    while m_idx < n_mt {
        if !mt_covered[m_idx] { array_push(rem_mts, minterm_bits[m_idx]); }
        m_idx = m_idx + 1;
    }

    if len(rem_mts) > 0 {
        let cand_pis = [];
        let p_idx = 0;
        while p_idx < n_pi {
            if !pi_selected[p_idx] {
                let any_cov = false;
                let r = 0;
                while r < len(rem_mts) {
                    if _qm_covers(primes[p_idx], rem_mts[r]) { any_cov = true; break; }
                    r = r + 1;
                }
                if any_cov { array_push(cand_pis, p_idx); }
            }
            p_idx = p_idx + 1;
        }

        // Exact recursive branch-and-bound on uncovered minterms (governed by adaptive max_milp_nodes)
        let max_bnb_nodes = GOV.current_limits()["max_milp_nodes"];
        let bnb_trk = GOV.new_tracker("stats_opt_applied.quine_mccluskey");
        let best_state = map{
            best_pick: nil,
            best_terms: 999999,
            best_lits: 999999,
            nodes: 0
        };

        let search_stack = [map{ cov_flags: _zeros(len(rem_mts)), picked: [], lits: 0 }];
        while len(search_stack) > 0 and best_state.nodes < max_bnb_nodes {
            GOV.tick(bnb_trk, 1);
            best_state["nodes"] = best_state.nodes + 1;
            let st = pop(search_stack);
            if len(st.picked) > best_state.best_terms { continue; }
            if len(st.picked) == best_state.best_terms and st.lits >= best_state.best_lits { continue; }

            // Pick first uncovered minterm
            let unc = -1;
            let r = 0;
            while r < len(rem_mts) {
                if st.cov_flags[r] == 0 { unc = r; break; }
                r = r + 1;
            }
            if unc == -1 {
                best_state["best_pick"] = st.picked;
                best_state["best_terms"] = len(st.picked);
                best_state["best_lits"] = st.lits;
                continue;
            }

            let c = len(cand_pis) - 1;
            while c >= 0 {
                let pidx = cand_pis[c];
                if _qm_covers(primes[pidx], rem_mts[unc]) {
                    let next_flags = _vec_copy(st.cov_flags);
                    let r2 = 0;
                    while r2 < len(rem_mts) {
                        if _qm_covers(primes[pidx], rem_mts[r2]) { next_flags[r2] = 1.0; }
                        r2 = r2 + 1;
                    }
                    let next_picked = _vec_copy(st.picked);
                    array_push(next_picked, pidx);
                    array_push(search_stack, map{
                        cov_flags: next_flags,
                        picked: next_picked,
                        lits: st.lits + _qm_literal_count(primes[pidx])
                    });
                }
                c = c - 1;
            }
        }

        if best_state.best_pick != nil {
            let b = 0;
            while b < len(best_state.best_pick) {
                pi_selected[best_state.best_pick[b]] = true;
                b = b + 1;
            }
        } else {
            // Greedy set-cover fallback if cap reached
            let rem_flags = _zeros(len(rem_mts));
            while true {
                let best_p = -1;
                let best_gain = 0;
                let c = 0;
                while c < len(cand_pis) {
                    let pidx = cand_pis[c];
                    if !pi_selected[pidx] {
                        let gain = 0;
                        let r2 = 0;
                        while r2 < len(rem_mts) {
                            if rem_flags[r2] == 0 and _qm_covers(primes[pidx], rem_mts[r2]) {
                                gain = gain + 1;
                            }
                            r2 = r2 + 1;
                        }
                        if gain > best_gain { best_gain = gain; best_p = pidx; }
                    }
                    c = c + 1;
                }
                if best_p == -1 { break; }
                pi_selected[best_p] = true;
                let r3 = 0;
                while r3 < len(rem_mts) {
                    if _qm_covers(primes[best_p], rem_mts[r3]) { rem_flags[r3] = 1.0; }
                    r3 = r3 + 1;
                }
            }
        }
    }

    let chosen_terms = [];
    let p_idx = 0;
    while p_idx < n_pi {
        if pi_selected[p_idx] {
            array_push(chosen_terms, _qm_format_implicant(primes[p_idx], vars));
        }
        p_idx = p_idx + 1;
    }
    let pi_formatted = [];
    p_idx = 0;
    while p_idx < n_pi {
        array_push(pi_formatted, _qm_format_implicant(primes[p_idx], vars));
        p_idx = p_idx + 1;
    }
    let epi_formatted = [];
    p_idx = 0;
    while p_idx < len(essential_patterns) {
        array_push(epi_formatted, _qm_format_implicant(essential_patterns[p_idx], vars));
        p_idx = p_idx + 1;
    }

    let sop = "";
    if len(chosen_terms) == 1 {
        let single = chosen_terms[0];
        if len(single) >= 2 and str_slice(single, 0, 1) == "(" and str_slice(single, len(single) - 1, len(single)) == ")" {
            sop = str_slice(single, 1, len(single) - 1);
        } else {
            sop = single;
        }
    } else {
        sop = chosen_terms[0];
        let k = 1;
        while k < len(chosen_terms) {
            sop = sop + " | " + chosen_terms[k];
            k = k + 1;
        }
    }

    return map{
        minimal_sop: sop,
        prime_implicants: pi_formatted,
        essential_prime_implicants: epi_formatted
    };
}

// ── Large-Scale Boolean Engine (> exact_qm_table_vars): Tseitin-DPLL + Espresso ──

fn _tseitin_alloc(st) {
    let v = st["next_var"];
    st["next_var"] = v + 1;
    return v;
}

fn _tseitin_encode(node, var_id_map, st) {
    let op = node.op;
    if op == "CONST" {
        if st["true_var"] == 0 {
            let tv = _tseitin_alloc(st);
            st["true_var"] = tv;
            array_push(st["clauses"], [tv]);
        }
        let tv2 = st["true_var"];
        if node.val { return tv2; }
        return 0 - tv2;
    }
    if op == "VAR" {
        return var_id_map[node.name];
    }
    if op == "NOT" {
        return 0 - _tseitin_encode(node.child, var_id_map, st);
    }
    let a = _tseitin_encode(node.left, var_id_map, st);
    let b = _tseitin_encode(node.right, var_id_map, st);
    let z = _tseitin_alloc(st);
    let cls = st["clauses"];
    if op == "AND" {
        array_push(cls, [0 - z, a]);
        array_push(cls, [0 - z, b]);
        array_push(cls, [z, 0 - a, 0 - b]);
        return z;
    }
    if op == "OR" {
        array_push(cls, [z, 0 - a]);
        array_push(cls, [z, 0 - b]);
        array_push(cls, [0 - z, a, b]);
        return z;
    }
    if op == "IMPLIES" {
        // z <-> (!a | b)
        array_push(cls, [z, a]);
        array_push(cls, [z, 0 - b]);
        array_push(cls, [0 - z, 0 - a, b]);
        return z;
    }
    if op == "XOR" {
        array_push(cls, [0 - z, a, b]);
        array_push(cls, [0 - z, 0 - a, 0 - b]);
        array_push(cls, [z, 0 - a, b]);
        array_push(cls, [z, a, 0 - b]);
        return z;
    }
    if op == "IFF" {
        array_push(cls, [0 - z, 0 - a, b]);
        array_push(cls, [0 - z, a, 0 - b]);
        array_push(cls, [z, a, b]);
        array_push(cls, [z, 0 - a, 0 - b]);
        return z;
    }
    return z;
}

fn _int_copy(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        array_push(out, arr[i]);
        i = i + 1;
    }
    return out;
}

fn _dpll_propagate(clauses, assign, trk) {
    let changed = true;
    while changed {
        changed = false;
        GOV.tick(trk, 1);
        let ci = 0;
        let n_cl = len(clauses);
        while ci < n_cl {
            let cl = clauses[ci];
            let sat_cl = false;
            let un_cnt = 0;
            let last_lit = 0;
            let li = 0;
            let cl_len = len(cl);
            while li < cl_len {
                let lit = cl[li];
                let v = lit;
                let want = 1;
                if lit < 0 { v = 0 - lit; want = -1; }
                let av = assign[v];
                if av == want {
                    sat_cl = true;
                    break;
                }
                if av == 0 {
                    un_cnt = un_cnt + 1;
                    last_lit = lit;
                }
                li = li + 1;
            }
            if !sat_cl {
                if un_cnt == 0 { return false; }
                if un_cnt == 1 {
                    let uv = last_lit;
                    let uw = 1;
                    if last_lit < 0 { uv = 0 - last_lit; uw = -1; }
                    assign[uv] = uw;
                    changed = true;
                }
            }
            ci = ci + 1;
        }
    }
    return true;
}

fn _dpll_rec(clauses, num_vars, assign, branch_lit, trk) {
    GOV.tick(trk, 1);
    if branch_lit != 0 {
        let bv = branch_lit;
        let bw = 1;
        if branch_lit < 0 { bv = 0 - branch_lit; bw = -1; }
        if assign[bv] != 0 and assign[bv] != bw {
            return map{ sat: false, assign: nil };
        }
        assign[bv] = bw;
    }
    if !_dpll_propagate(clauses, assign, trk) {
        return map{ sat: false, assign: nil };
    }

    // Check satisfaction and select unassigned literal from shortest active clause
    let best_len = 999999;
    let pick_lit = 0;
    let ci = 0;
    let n_cl = len(clauses);
    while ci < n_cl {
        let cl = clauses[ci];
        let sat_cl = false;
        let un_cnt = 0;
        let first_un = 0;
        let li = 0;
        let cl_len = len(cl);
        while li < cl_len {
            let lit = cl[li];
            let v = lit;
            let want = 1;
            if lit < 0 { v = 0 - lit; want = -1; }
            let av = assign[v];
            if av == want { sat_cl = true; break; }
            if av == 0 {
                if first_un == 0 { first_un = lit; }
                un_cnt = un_cnt + 1;
            }
            li = li + 1;
        }
        if !sat_cl {
            if un_cnt == 0 { return map{ sat: false, assign: nil }; }
            if un_cnt < best_len {
                best_len = un_cnt;
                pick_lit = first_un;
                if best_len <= 2 { break; }
            }
        }
        ci = ci + 1;
    }

    if pick_lit == 0 {
        return map{ sat: true, assign: assign };
    }

    let a1 = _int_copy(assign);
    let r1 = _dpll_rec(clauses, num_vars, a1, pick_lit, trk);
    if r1.sat { return r1; }

    let a2 = _int_copy(assign);
    return _dpll_rec(clauses, num_vars, a2, 0 - pick_lit, trk);
}

fn _dpll_solve(clauses, num_vars, assumptions, trk) {
    let assign = [];
    let i = 0;
    while i <= num_vars {
        array_push(assign, 0);
        i = i + 1;
    }
    let ai = 0;
    while ai < len(assumptions) {
        let lit = assumptions[ai];
        let v = lit;
        let w = 1;
        if lit < 0 { v = 0 - lit; w = -1; }
        if assign[v] != 0 and assign[v] != w {
            return map{ sat: false, assign: nil };
        }
        assign[v] = w;
        ai = ai + 1;
    }
    return _dpll_rec(clauses, num_vars, assign, 0, trk);
}

fn _ast_to_nnf(node, neg) {
    let op = node.op;
    if op == "CONST" {
        let v = node.val;
        if neg { v = !v; }
        return map{ op: "CONST", val: v };
    }
    if op == "VAR" {
        return map{ op: "LIT", name: node.name, pos: !neg };
    }
    if op == "NOT" {
        return _ast_to_nnf(node.child, !neg);
    }
    if op == "AND" {
        if !neg {
            return map{ op: "AND", left: _ast_to_nnf(node.left, false), right: _ast_to_nnf(node.right, false) };
        }
        return map{ op: "OR", left: _ast_to_nnf(node.left, true), right: _ast_to_nnf(node.right, true) };
    }
    if op == "OR" {
        if !neg {
            return map{ op: "OR", left: _ast_to_nnf(node.left, false), right: _ast_to_nnf(node.right, false) };
        }
        return map{ op: "AND", left: _ast_to_nnf(node.left, true), right: _ast_to_nnf(node.right, true) };
    }
    if op == "IMPLIES" {
        if !neg {
            return map{ op: "OR", left: _ast_to_nnf(node.left, true), right: _ast_to_nnf(node.right, false) };
        }
        return map{ op: "AND", left: _ast_to_nnf(node.left, false), right: _ast_to_nnf(node.right, true) };
    }
    // XOR / IFF
    let want_same = (op == "IFF" and !neg) or (op == "XOR" and neg);
    if want_same {
        return map{
            op: "OR",
            left: map{ op: "AND", left: _ast_to_nnf(node.left, false), right: _ast_to_nnf(node.right, false) },
            right: map{ op: "AND", left: _ast_to_nnf(node.left, true), right: _ast_to_nnf(node.right, true) }
        };
    }
    return map{
        op: "OR",
        left: map{ op: "AND", left: _ast_to_nnf(node.left, false), right: _ast_to_nnf(node.right, true) },
        right: map{ op: "AND", left: _ast_to_nnf(node.left, true), right: _ast_to_nnf(node.right, false) }
    };
}

fn _cube_empty(n_vars) {
    let c = [];
    let i = 0;
    while i < n_vars { array_push(c, 0); i = i + 1; }
    return c;
}

// True iff cube_a covers cube_b (cube_a is at least as general as cube_b)
fn _cube_covers(ca, cb, n_vars) {
    let i = 0;
    while i < n_vars {
        let va = ca[i];
        if va != 0 and va != cb[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn _cube_lit_count(c, n_vars) {
    let cnt = 0;
    let i = 0;
    while i < n_vars {
        if c[i] != 0 { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

fn _cube_to_pattern(c, n_vars) {
    let s = "";
    let i = 0;
    while i < n_vars {
        if c[i] == 1 { s = s + "1"; }
        else if c[i] == -1 { s = s + "0"; }
        else { s = s + "-"; }
        i = i + 1;
    }
    return s;
}

fn _cubes_absorb(cubes, n_vars, trk) {
    let m = len(cubes);
    if m <= 1 { return cubes; }
    let dead = [];
    let i = 0;
    while i < m { array_push(dead, false); i = i + 1; }
    i = 0;
    while i < m {
        if !dead[i] {
            GOV.tick(trk, 1);
            let j = 0;
            while j < m {
                if i != j and !dead[j] {
                    if _cube_covers(cubes[i], cubes[j], n_vars) {
                        dead[j] = true;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    let out = [];
    i = 0;
    while i < m {
        if !dead[i] { array_push(out, cubes[i]); }
        i = i + 1;
    }
    return out;
}

fn _cube_intersect(c1, c2, n_vars) {
    let out = [];
    let i = 0;
    while i < n_vars {
        let a = c1[i];
        let b = c2[i];
        if a == 0 {
            array_push(out, b);
        } else if b == 0 or a == b {
            array_push(out, a);
        } else {
            return nil; // contradiction x_i & !x_i
        }
        i = i + 1;
    }
    return out;
}

fn _nnf_to_cubes(nnf, var_idx_map, n_vars, max_cubes, trk) {
    GOV.tick(trk, 1);
    let op = nnf.op;
    if op == "CONST" {
        if nnf.val { return map{ ok: true, cubes: [_cube_empty(n_vars)] }; }
        return map{ ok: true, cubes: [] };
    }
    if op == "LIT" {
        let c = _cube_empty(n_vars);
        let idx = var_idx_map[nnf.name];
        if nnf.pos { c[idx] = 1; } else { c[idx] = -1; }
        return map{ ok: true, cubes: [c] };
    }
    if op == "OR" {
        let rl = _nnf_to_cubes(nnf.left, var_idx_map, n_vars, max_cubes, trk);
        if !rl.ok { return rl; }
        let rr = _nnf_to_cubes(nnf.right, var_idx_map, n_vars, max_cubes, trk);
        if !rr.ok { return rr; }
        let joined = [];
        let i = 0;
        while i < len(rl.cubes) { array_push(joined, rl.cubes[i]); i = i + 1; }
        i = 0;
        while i < len(rr.cubes) { array_push(joined, rr.cubes[i]); i = i + 1; }
        if len(joined) > max_cubes * 2 {
            joined = _cubes_absorb(joined, n_vars, trk);
        }
        if len(joined) > max_cubes {
            return map{ ok: false, cubes: [] };
        }
        return map{ ok: true, cubes: _cubes_absorb(joined, n_vars, trk) };
    }
    if op == "AND" {
        let rl = _nnf_to_cubes(nnf.left, var_idx_map, n_vars, max_cubes, trk);
        if !rl.ok { return rl; }
        let rr = _nnf_to_cubes(nnf.right, var_idx_map, n_vars, max_cubes, trk);
        if !rr.ok { return rr; }
        if len(rl.cubes) == 0 or len(rr.cubes) == 0 {
            return map{ ok: true, cubes: [] };
        }
        if len(rl.cubes) * len(rr.cubes) > max_cubes * 4 {
            return map{ ok: false, cubes: [] };
        }
        let prod = [];
        let i = 0;
        while i < len(rl.cubes) {
            let j = 0;
            while j < len(rr.cubes) {
                let m_cube = _cube_intersect(rl.cubes[i], rr.cubes[j], n_vars);
                if m_cube != nil {
                    array_push(prod, m_cube);
                    if len(prod) > max_cubes * 2 {
                        prod = _cubes_absorb(prod, n_vars, trk);
                        if len(prod) > max_cubes {
                            return map{ ok: false, cubes: [] };
                        }
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
        prod = _cubes_absorb(prod, n_vars, trk);
        if len(prod) > max_cubes {
            return map{ ok: false, cubes: [] };
        }
        return map{ ok: true, cubes: prod };
    }
    return map{ ok: false, cubes: [] };
}

fn _format_nnf_fallback(nnf) {
    let op = nnf.op;
    if op == "CONST" { if nnf.val { return "1"; } return "0"; }
    if op == "LIT" { if nnf.pos { return nnf.name; } return "!" + nnf.name; }
    if op == "AND" { return "(" + _format_nnf_fallback(nnf.left) + " & " + _format_nnf_fallback(nnf.right) + ")"; }
    if op == "OR" { return "(" + _format_nnf_fallback(nnf.left) + " | " + _format_nnf_fallback(nnf.right) + ")"; }
    return "?";
}

fn _boolean_analyze_large(ast, vars) {
    let trk = GOV.new_tracker("stats_opt_applied.boolean_analyze_large");
    let n_vars = len(vars);
    let var_id_map = map{};
    let var_idx_map = map{};
    let i = 0;
    while i < n_vars {
        var_id_map[vars[i]] = i + 1;
        var_idx_map[vars[i]] = i;
        i = i + 1;
    }

    // 1. Build linear-size Tseitin CNF and run exact DPLL SAT & Tautology checks
    let t_state = map{ next_var: n_vars + 1, clauses: [], true_var: 0 };
    let root_lit = _tseitin_encode(ast, var_id_map, t_state);
    let total_cnf_vars = t_state["next_var"] - 1;
    let base_clauses = t_state["clauses"];

    let sat_res = _dpll_solve(base_clauses, total_cnf_vars, [root_lit], trk);
    if !sat_res.sat {
        return map{
            ok: true,
            method: "espresso_dpll_large_scale",
            n_vars: n_vars,
            variables: vars,
            minimal_sop: "0",
            quine_mccluskey: "0",
            prime_implicants: [],
            essential_prime_implicants: [],
            is_tautology: false,
            is_contradiction: true,
            satisfiable: false,
            is_satisfiable: false,
            satisfying_assignment: nil,
            truth_table: nil
        };
    }

    let sat_env = map{};
    i = 0;
    while i < n_vars {
        let av = sat_res.assign[i + 1];
        sat_env[vars[i]] = (av == 1);
        i = i + 1;
    }

    let neg_sat_res = _dpll_solve(base_clauses, total_cnf_vars, [0 - root_lit], trk);
    if !neg_sat_res.sat {
        return map{
            ok: true,
            method: "espresso_dpll_large_scale",
            n_vars: n_vars,
            variables: vars,
            minimal_sop: "1",
            quine_mccluskey: "1",
            prime_implicants: ["1"],
            essential_prime_implicants: ["1"],
            is_tautology: true,
            is_contradiction: false,
            satisfiable: true,
            is_satisfiable: true,
            satisfying_assignment: sat_env,
            truth_table: nil
        };
    }

    // 2. Algebraic NNF + Bounded Cube Extraction + Espresso Prime-Expand & Irredundant Cover
    let nnf = _ast_to_nnf(ast, false);
    let cube_ext = _nnf_to_cubes(nnf, var_idx_map, n_vars, 384, trk);
    if !cube_ext.ok {
        let alg_str = _format_nnf_fallback(nnf);
        return map{
            ok: true,
            method: "espresso_dpll_large_scale",
            n_vars: n_vars,
            variables: vars,
            minimal_sop: alg_str,
            quine_mccluskey: alg_str,
            prime_implicants: [alg_str],
            essential_prime_implicants: [],
            is_tautology: false,
            is_contradiction: false,
            satisfiable: true,
            is_satisfiable: true,
            satisfying_assignment: sat_env,
            truth_table: nil
        };
    }

    let cubes = _cubes_absorb(cube_ext.cubes, n_vars, trk);

    // Phase A: Distance-1 algebraic merging pass
    let merged_changed = true;
    while merged_changed and len(cubes) > 1 {
        merged_changed = false;
        let m_len = len(cubes);
        let a_idx = 0;
        while a_idx < m_len and !merged_changed {
            let b_idx = a_idx + 1;
            while b_idx < m_len {
                let diffs = 0;
                let dpos = -1;
                let k = 0;
                while k < n_vars {
                    if cubes[a_idx][k] != cubes[b_idx][k] {
                        if cubes[a_idx][k] == 0 or cubes[b_idx][k] == 0 {
                            diffs = 2;
                            break;
                        }
                        diffs = diffs + 1;
                        dpos = k;
                        if diffs > 1 { break; }
                    }
                    k = k + 1;
                }
                if diffs == 1 {
                    let mc = _int_copy(cubes[a_idx]);
                    mc[dpos] = 0;
                    array_push(cubes, mc);
                    cubes = _cubes_absorb(cubes, n_vars, trk);
                    merged_changed = true;
                    break;
                }
                b_idx = b_idx + 1;
            }
            a_idx = a_idx + 1;
        }
    }

    // Phase B: Exact SAT-guided Espresso EXPAND (raise each cube to a Prime Implicant of F)
    let ci = 0;
    while ci < len(cubes) {
        let c_cur = cubes[ci];
        let v_idx = 0;
        while v_idx < n_vars {
            if c_cur[v_idx] != 0 {
                // Test if dropping literal v_idx still implies F (i.e. c' & !F is UNSAT)
                let assumps = [0 - root_lit];
                let u = 0;
                while u < n_vars {
                    if u != v_idx and c_cur[u] != 0 {
                        if c_cur[u] == 1 { array_push(assumps, u + 1); }
                        else { array_push(assumps, 0 - (u + 1)); }
                    }
                    u = u + 1;
                }
                let check = _dpll_solve(base_clauses, total_cnf_vars, assumps, trk);
                if !check.sat {
                    c_cur[v_idx] = 0;
                }
            }
            v_idx = v_idx + 1;
        }
        cubes[ci] = c_cur;
        ci = ci + 1;
    }
    cubes = _cubes_absorb(cubes, n_vars, trk);

    // Sort cubes descending by literal count so more specific/consensus cubes are tested for redundancy first
    let s1 = 1;
    while s1 < len(cubes) {
        let key_c = cubes[s1];
        let key_l = _cube_lit_count(key_c, n_vars);
        let s2 = s1 - 1;
        while s2 >= 0 and _cube_lit_count(cubes[s2], n_vars) < key_l {
            cubes[s2 + 1] = cubes[s2];
            s2 = s2 - 1;
        }
        cubes[s2 + 1] = key_c;
        s1 = s1 + 1;
    }

    // Phase C: Exact SAT-guided Espresso IRREDUNDANT cover (drop consensus/covered cubes)
    let active = [];
    ci = 0;
    while ci < len(cubes) { array_push(active, true); ci = ci + 1; }
    ci = 0;
    while ci < len(cubes) {
        let other_clauses = [];
        let cj = 0;
        while cj < len(cubes) {
            if cj != ci and active[cj] {
                // !(cube cj) is a disjunction of negated literals of cj
                let cl_neg = [];
                let v = 0;
                while v < n_vars {
                    if cubes[cj][v] == 1 { array_push(cl_neg, 0 - (v + 1)); }
                    else if cubes[cj][v] == -1 { array_push(cl_neg, v + 1); }
                    v = v + 1;
                }
                if len(cl_neg) == 0 {
                    // An empty negated clause means another cube is "1" (covers everything)
                    other_clauses = [[]];
                    break;
                }
                array_push(other_clauses, cl_neg);
            }
            cj = cj + 1;
        }
        if len(other_clauses) > 0 {
            let assumps_cov = [];
            let v = 0;
            while v < n_vars {
                if cubes[ci][v] == 1 { array_push(assumps_cov, v + 1); }
                else if cubes[ci][v] == -1 { array_push(assumps_cov, 0 - (v + 1)); }
                v = v + 1;
            }
            let red_check = _dpll_solve(other_clauses, n_vars, assumps_cov, trk);
            if !red_check.sat {
                active[ci] = false;
            }
        }
        ci = ci + 1;
    }

    // Collect minimal prime implicants in canonical lexicographical pattern order
    let pat_list = [];
    ci = 0;
    while ci < len(cubes) {
        if active[ci] {
            array_push(pat_list, _cube_to_pattern(cubes[ci], n_vars));
        }
        ci = ci + 1;
    }
    pat_list = array_sort(pat_list);
    // Reverse so '1' patterns precede '0'/'-' nicely
    let terms = [];
    let pi = len(pat_list) - 1;
    while pi >= 0 {
        array_push(terms, _qm_format_implicant(pat_list[pi], vars));
        pi = pi - 1;
    }

    let sop = "0";
    if len(terms) == 1 {
        let single = terms[0];
        if len(single) >= 2 and str_slice(single, 0, 1) == "(" and str_slice(single, len(single) - 1, len(single)) == ")" {
            sop = str_slice(single, 1, len(single) - 1);
        } else {
            sop = single;
        }
    } else if len(terms) > 1 {
        sop = terms[0];
        let ti = 1;
        while ti < len(terms) {
            sop = sop + " | " + terms[ti];
            ti = ti + 1;
        }
    }

    return map{
        ok: true,
        method: "espresso_dpll_large_scale",
        n_vars: n_vars,
        variables: vars,
        minimal_sop: sop,
        quine_mccluskey: sop,
        prime_implicants: terms,
        essential_prime_implicants: terms,
        is_tautology: false,
        is_contradiction: false,
        satisfiable: true,
        is_satisfiable: true,
        satisfying_assignment: sat_env,
        truth_table: nil
    };
}

fn boolean_analyze(expr_str) {
    let lex = _bool_tokenize(expr_str);
    let vars = lex.vars;
    let n_vars = len(vars);
    let st = map{ tokens: lex.tokens, pos: 0 };
    let ast = _bparse_iff(st);
    if st.tokens[st.pos].kind != "EOF" {
        return error("boolean_analyze: unexpected trailing token");
    }

    let qm_limit = GOV.current_limits()["exact_qm_table_vars"];
    if n_vars > qm_limit {
        return _boolean_analyze_large(ast, vars);
    }

    let trk = GOV.new_tracker("stats_opt_applied.boolean_analyze_qm");
    let total_rows = num_round(num_pow(2, n_vars));
    let truth_table = [];
    let minterms = [];
    let maxterms = [];
    let dnf_clauses = [];
    let cnf_clauses = [];
    let first_sat_env = nil;

    let idx = 0;
    while idx < total_rows {
        GOV.tick(trk, 1);
        let env = map{};
        let inputs = [];
        let bs = _int_to_bitstr(idx, n_vars);
        let v = 0;
        while v < n_vars {
            let bval = str_slice(bs, v, v + 1) == "1";
            env[vars[v]] = bval;
            array_push(inputs, bval);
            v = v + 1;
        }
        let out = _beval(ast, env);
        array_push(truth_table, map{ index: idx, inputs: inputs, assignment: env, output: out });
        if out {
            if first_sat_env == nil { first_sat_env = env; }
            array_push(minterms, idx);
            if n_vars > 0 {
                array_push(dnf_clauses, _qm_format_implicant(bs, vars));
            }
        } else {
            array_push(maxterms, idx);
            if n_vars > 0 {
                let cl_lits = [];
                v = 0;
                while v < n_vars {
                    if inputs[v] { array_push(cl_lits, "!" + vars[v]); }
                    else { array_push(cl_lits, vars[v]); }
                    v = v + 1;
                }
                let cl_str = cl_lits[0];
                let m = 1;
                while m < len(cl_lits) { cl_str = cl_str + " | " + cl_lits[m]; m = m + 1; }
                if len(cl_lits) > 1 { cl_str = "(" + cl_str + ")"; }
                array_push(cnf_clauses, cl_str);
            }
        }
        idx = idx + 1;
    }

    let dnf = "0";
    if len(minterms) == total_rows and n_vars == 0 { dnf = "1"; }
    else if len(dnf_clauses) > 0 {
        dnf = dnf_clauses[0];
        let k = 1;
        while k < len(dnf_clauses) { dnf = dnf + " | " + dnf_clauses[k]; k = k + 1; }
    }

    let cnf = "1";
    if len(maxterms) == total_rows and n_vars == 0 { cnf = "0"; }
    else if len(cnf_clauses) > 0 {
        cnf = cnf_clauses[0];
        let k = 1;
        while k < len(cnf_clauses) { cnf = cnf + " & " + cnf_clauses[k]; k = k + 1; }
    }

    let qm = _quine_mccluskey(minterms, n_vars, vars);

    return map{
        ok: true,
        method: "quine_mccluskey_exact",
        n_vars: n_vars,
        variables: vars,
        truth_table: truth_table,
        is_tautology: len(maxterms) == 0,
        satisfiable: len(minterms) > 0,
        is_satisfiable: len(minterms) > 0,
        satisfying_assignment: first_sat_env,
        is_contradiction: len(minterms) == 0,
        minterms: minterms,
        maxterms: maxterms,
        dnf: dnf,
        cnf: cnf,
        minimal_sop: qm.minimal_sop,
        quine_mccluskey: qm.minimal_sop,
        prime_implicants: qm.prime_implicants,
        essential_prime_implicants: qm.essential_prime_implicants
    };
}

// 3.3 Graph Theory Algorithms

fn _edge_u(e) {
    if type(e) == "map" {
        if map_has(e, "u") { return e.u; }
        return e.from;
    }
    return e[0];
}

fn _edge_v(e) {
    if type(e) == "map" {
        if map_has(e, "v") { return e.v; }
        return e["to"];
    }
    return e[1];
}

fn _edge_w(e) {
    if type(e) == "map" {
        if map_has(e, "weight") { return e.weight; }
        if map_has(e, "w") { return e.w; }
        return 1.0;
    }
    if len(e) >= 3 { return e[2]; }
    return 1.0;
}

fn _uf_find(parent, x) {
    let root = x;
    while parent[root] != root { root = parent[root]; }
    let cur = x;
    while cur != root {
        let nxt = parent[cur];
        parent[cur] = root;
        cur = nxt;
    }
    return root;
}

fn graph_mst_kruskal(n_vertices, edges) {
    let m = len(edges);
    let norm_edges = [];
    let i = 0;
    while i < m {
        array_push(norm_edges, [_edge_u(edges[i]), _edge_v(edges[i]), _edge_w(edges[i])]);
        i = i + 1;
    }
    // Insertion/shell sort edges by weight ascending
    let gap = num_floor(m / 2);
    while gap > 0 {
        i = gap;
        while i < m {
            let tmp = norm_edges[i];
            let j = i;
            while j >= gap and norm_edges[j - gap][2] > tmp[2] {
                norm_edges[j] = norm_edges[j - gap];
                j = j - gap;
            }
            norm_edges[j] = tmp;
            i = i + 1;
        }
        gap = num_floor(gap / 2);
    }

    let parent = [];
    let rank = [];
    i = 0;
    while i < n_vertices { array_push(parent, i); array_push(rank, 0); i = i + 1; }

    let total_weight = 0.0;
    let mst_edges = [];
    i = 0;
    while i < m and len(mst_edges) < n_vertices - 1 {
        let e = norm_edges[i];
        let ru = _uf_find(parent, e[0]);
        let rv = _uf_find(parent, e[1]);
        if ru != rv {
            if rank[ru] < rank[rv] { parent[ru] = rv; }
            else if rank[ru] > rank[rv] { parent[rv] = ru; }
            else { parent[rv] = ru; rank[ru] = rank[ru] + 1; }
            total_weight = total_weight + e[2];
            array_push(mst_edges, e);
        }
        i = i + 1;
    }

    return map{
        total_weight: total_weight,
        mst_edges: mst_edges,
        connected: (n_vertices <= 1 or len(mst_edges) == n_vertices - 1)
    };
}

fn graph_floyd_warshall(n_vertices, edges, directed = true) {
    let inf = 1e300;
    let dist = _mat_zeros(n_vertices, n_vertices);
    let i = 0;
    while i < n_vertices {
        let j = 0;
        while j < n_vertices {
            if i == j { dist[i][j] = 0.0; } else { dist[i][j] = inf; }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while i < len(edges) {
        let u = _edge_u(edges[i]);
        let v = _edge_v(edges[i]);
        let w = _edge_w(edges[i]);
        if w < dist[u][v] { dist[u][v] = w; }
        if !directed and w < dist[v][u] { dist[v][u] = w; }
        i = i + 1;
    }

    let k = 0;
    while k < n_vertices {
        i = 0;
        while i < n_vertices {
            if dist[i][k] < inf * 0.5 {
                let j = 0;
                while j < n_vertices {
                    if dist[k][j] < inf * 0.5 {
                        let cand = dist[i][k] + dist[k][j];
                        if cand < dist[i][j] { dist[i][j] = cand; }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }

    let has_neg_cycle = false;
    i = 0;
    while i < n_vertices {
        if dist[i][i] < -1e-12 { has_neg_cycle = true; }
        let j = 0;
        while j < n_vertices {
            if dist[i][j] >= inf * 0.5 { dist[i][j] = _INF; }
            j = j + 1;
        }
        i = i + 1;
    }

    return map{
        distances: dist,
        has_negative_cycle: has_neg_cycle
    };
}

fn graph_tarjan_scc(n_vertices, directed_edges) {
    let adj = [];
    let i = 0;
    while i < n_vertices { array_push(adj, []); i = i + 1; }
    i = 0;
    while i < len(directed_edges) {
        let u = _edge_u(directed_edges[i]);
        let v = _edge_v(directed_edges[i]);
        array_push(adj[u], v);
        i = i + 1;
    }

    let disc = [];
    let low = [];
    let on_stack = [];
    let comp_of = [];
    i = 0;
    while i < n_vertices {
        array_push(disc, -1);
        array_push(low, -1);
        array_push(on_stack, false);
        array_push(comp_of, -1);
        i = i + 1;
    }

    let scc_stack = [];
    let components = [];
    let timer = 0;

    // Iterative Tarjan DFS so deep graphs never hit call-stack limits
    let start = 0;
    while start < n_vertices {
        if disc[start] == -1 {
            let call_stack = [map{ u: start, ei: 0 }];
            disc[start] = timer;
            low[start] = timer;
            timer = timer + 1;
            array_push(scc_stack, start);
            on_stack[start] = true;

            while len(call_stack) > 0 {
                let top_idx = len(call_stack) - 1;
                let frame = call_stack[top_idx];
                let u = frame.u;
                let ei = frame.ei;
                if ei < len(adj[u]) {
                    frame["ei"] = ei + 1;
                    let v = adj[u][ei];
                    if disc[v] == -1 {
                        disc[v] = timer;
                        low[v] = timer;
                        timer = timer + 1;
                        array_push(scc_stack, v);
                        on_stack[v] = true;
                        array_push(call_stack, map{ u: v, ei: 0 });
                    } else if on_stack[v] {
                        if disc[v] < low[u] { low[u] = disc[v]; }
                    }
                } else {
                    pop(call_stack);
                    if len(call_stack) > 0 {
                        let parent_u = call_stack[len(call_stack) - 1].u;
                        if low[u] < low[parent_u] { low[parent_u] = low[u]; }
                    }
                    if low[u] == disc[u] {
                        let comp = [];
                        let cid = len(components);
                        while true {
                            let w = pop(scc_stack);
                            on_stack[w] = false;
                            comp_of[w] = cid;
                            array_push(comp, w);
                            if w == u { break; }
                        }
                        array_push(components, array_sort(comp));
                    }
                }
            }
        }
        start = start + 1;
    }

    return map{
        count: len(components),
        components: components,
        component_of: comp_of
    };
}

fn graph_bipartite_max_matching(n_left, n_right, adj_left) {
    let match_left = [];
    let match_right = [];
    let u = 0;
    while u < n_left { array_push(match_left, -1); u = u + 1; }
    let v = 0;
    while v < n_right { array_push(match_right, -1); v = v + 1; }

    // Kuhn augmenting-path DFS (recursive helper on visited right vertices)
    fn try_kuhn(u_node, visited_r) {
        let nbrs = adj_left[u_node];
        let k = 0;
        while k < len(nbrs) {
            let vr = nbrs[k];
            if vr >= 0 and vr < n_right and !visited_r[vr] {
                visited_r[vr] = true;
                if match_right[vr] == -1 or try_kuhn(match_right[vr], visited_r) {
                    match_right[vr] = u_node;
                    match_left[u_node] = vr;
                    return true;
                }
            }
            k = k + 1;
        }
        return false;
    }

    let count = 0;
    u = 0;
    while u < n_left {
        let vis = [];
        v = 0;
        while v < n_right { array_push(vis, false); v = v + 1; }
        if try_kuhn(u, vis) { count = count + 1; }
        u = u + 1;
    }

    let pairs = [];
    u = 0;
    while u < n_left {
        if match_left[u] != -1 {
            array_push(pairs, [u, match_left[u]]);
        }
        u = u + 1;
    }

    return map{
        max_matching: count,
        pairs: pairs,
        match_left: match_left,
        match_right: match_right
    };
}

fn graph_greedy_and_exact_coloring(n_vertices, edges) {
    if n_vertices <= 0 {
        return map{ chromatic_number: 0, coloring: [], greedy_chromatic: 0 };
    }
    let adj = [];
    let adj_mat = _mat_zeros(n_vertices, n_vertices);
    let i = 0;
    while i < n_vertices { array_push(adj, []); i = i + 1; }
    i = 0;
    while i < len(edges) {
        let u = _edge_u(edges[i]);
        let v = _edge_v(edges[i]);
        if u != v and adj_mat[u][v] == 0 {
            adj_mat[u][v] = 1.0;
            adj_mat[v][u] = 1.0;
            array_push(adj[u], v);
            array_push(adj[v], u);
        }
        i = i + 1;
    }

    // Step 1: DSATUR greedy coloring for tight initial upper bound
    let g_col = [];
    let colored = [];
    i = 0;
    while i < n_vertices { array_push(g_col, -1); array_push(colored, false); i = i + 1; }

    let step = 0;
    let greedy_max_c = 0;
    while step < n_vertices {
        let pick_v = -1;
        let best_sat = -1;
        let best_deg = -1;
        let v = 0;
        while v < n_vertices {
            if !colored[v] {
                let sat_seen = map{};
                let k = 0;
                while k < len(adj[v]) {
                    let nb = adj[v][k];
                    if g_col[nb] != -1 { sat_seen[str(g_col[nb])] = true; }
                    k = k + 1;
                }
                let sat = len(map_keys(sat_seen));
                let deg = len(adj[v]);
                if sat > best_sat or (sat == best_sat and deg > best_deg) {
                    best_sat = sat;
                    best_deg = deg;
                    pick_v = v;
                }
            }
            v = v + 1;
        }
        let used_c = map{};
        let k = 0;
        while k < len(adj[pick_v]) {
            let nb = adj[pick_v][k];
            if g_col[nb] != -1 { used_c[str(g_col[nb])] = true; }
            k = k + 1;
        }
        let c = 0;
        while map_has(used_c, str(c)) { c = c + 1; }
        g_col[pick_v] = c;
        colored[pick_v] = true;
        if c + 1 > greedy_max_c { greedy_max_c = c + 1; }
        step = step + 1;
    }

    // Order vertices by descending degree for exact branch-and-bound
    let order = [];
    i = 0;
    while i < n_vertices { array_push(order, i); i = i + 1; }
    i = 1;
    while i < n_vertices {
        let kv = order[i];
        let j = i - 1;
        while j >= 0 and len(adj[order[j]]) < len(adj[kv]) {
            order[j + 1] = order[j];
            j = j - 1;
        }
        order[j + 1] = kv;
        i = i + 1;
    }

    let state = map{
        best_k: greedy_max_c,
        best_coloring: _vec_copy(g_col),
        cur_coloring: [],
        nodes: 0
    };
    i = 0;
    while i < n_vertices { array_push(state.cur_coloring, -1); i = i + 1; }

    let max_col_nodes = GOV.current_limits()["max_milp_nodes"];
    let col_trk = GOV.new_tracker("stats_opt_applied.graph_coloring");

    fn bnb_color(idx, num_used) {
        state["nodes"] = state.nodes + 1;
        GOV.tick(col_trk, 1);
        if state.nodes > max_col_nodes { return nil; }
        if num_used >= state.best_k { return nil; }
        if idx == n_vertices {
            state["best_k"] = num_used;
            state["best_coloring"] = _vec_copy(state.cur_coloring);
            return nil;
        }
        let v = order[idx];
        let c = 0;
        while c <= num_used and c < state.best_k - 1 {
            let ok = true;
            let k = 0;
            while k < len(adj[v]) {
                let nb = adj[v][k];
                if state.cur_coloring[nb] == c { ok = false; break; }
                k = k + 1;
            }
            if ok {
                state.cur_coloring[v] = c;
                let next_used = num_used;
                if c + 1 > next_used { next_used = c + 1; }
                bnb_color(idx + 1, next_used);
                state.cur_coloring[v] = -1;
                if state.nodes > max_col_nodes { return nil; }
            }
            c = c + 1;
        }
        return nil;
    }

    bnb_color(0, 0);

    return map{
        chromatic_number: state.best_k,
        coloring: state.best_coloring,
        greedy_chromatic: greedy_max_c
    };
}

fn graph_laplacian_spectrum(n_vertices, edges) {
    let deg = _mat_zeros(n_vertices, n_vertices);
    let lap = _mat_zeros(n_vertices, n_vertices);
    let i = 0;
    while i < len(edges) {
        let u = _edge_u(edges[i]);
        let v = _edge_v(edges[i]);
        let w = _edge_w(edges[i]);
        if u != v {
            deg[u][u] = deg[u][u] + w;
            deg[v][v] = deg[v][v] + w;
            lap[u][u] = lap[u][u] + w;
            lap[v][v] = lap[v][v] + w;
            lap[u][v] = lap[u][v] - w;
            lap[v][u] = lap[v][u] - w;
        }
        i = i + 1;
    }

    let eig = _jacobi_sym(lap);
    let evals = eig.eigenvalues;
    let evecs = eig.eigenvectors;

    // Sort eigenvalues ascending: 0 = lambda_1 <= lambda_2 <= ... <= lambda_n
    let a = 0;
    while a < n_vertices - 1 {
        let best = a;
        let b = a + 1;
        while b < n_vertices {
            if evals[b] < evals[best] { best = b; }
            b = b + 1;
        }
        if best != a {
            let tv = evals[a]; evals[a] = evals[best]; evals[best] = tv;
            let te = evecs[a]; evecs[a] = evecs[best]; evecs[best] = te;
        }
        a = a + 1;
    }

    let n_comp = 0;
    i = 0;
    while i < n_vertices {
        if num_abs(evals[i]) < 1e-10 { evals[i] = 0.0; n_comp = n_comp + 1; }
        i = i + 1;
    }

    let alg_conn = 0.0;
    let fiedler = nil;
    if n_vertices >= 2 {
        alg_conn = _max(0.0, evals[1]);
        fiedler = evecs[1];
    }

    return map{
        degree_matrix: deg,
        laplacian: lap,
        eigenvalues: evals,
        algebraic_connectivity: alg_conn,
        fiedler_vector: fiedler,
        connected_components: n_comp
    };
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4: Quantitative Finance, Physical SI Units & Uncertainty Propagation
// ══════════════════════════════════════════════════════════════════════════════

// 4.1 Quantitative Finance & Actuarial Analytics

fn npv(rate, cashflows) {
    if rate <= -1.0 { return error("npv: discount rate must be > -1"); }
    let total = 0.0;
    let df = 1.0;
    let step = 1.0 + rate;
    let t = 0;
    while t < len(cashflows) {
        total = total + cashflows[t] / df;
        df = df * step;
        t = t + 1;
    }
    return total;
}

fn _npv_deriv(rate, cashflows) {
    let total = 0.0;
    let step = 1.0 + rate;
    let df = step * step;
    let t = 1;
    while t < len(cashflows) {
        total = total - (t * cashflows[t]) / df;
        df = df * step;
        t = t + 1;
    }
    return total;
}

// Internal Rate of Return: safeguarded Newton-Brent root of NPV(r) = 0
fn irr(cashflows) {
    if len(cashflows) < 2 { return error("irr: need >= 2 cashflows"); }

    // Locate bracket [lo, hi] across (-0.99, 100.0]
    let grid = [-0.99, -0.9, -0.75, -0.5, -0.25, -0.1, 0.0, 0.05, 0.1, 0.2, 0.5, 1.0, 2.0, 5.0, 10.0, 50.0, 100.0];
    let lo = -0.9;
    let hi = 1.0;
    let bracketed = false;
    let k = 0;
    while k < len(grid) - 1 {
        let f1 = npv(grid[k], cashflows);
        let f2 = npv(grid[k + 1], cashflows);
        if f1 == 0 { return grid[k]; }
        if (f1 < 0 and f2 > 0) or (f1 > 0 and f2 < 0) {
            lo = grid[k];
            hi = grid[k + 1];
            bracketed = true;
            break;
        }
        k = k + 1;
    }
    if !bracketed {
        return error("irr: no real sign-changing root found in (-0.99, 100]");
    }

    let flo = npv(lo, cashflows);
    let r = 0.5 * (lo + hi);
    if lo <= 0.1 and 0.1 <= hi { r = 0.1; }

    let it = 0;
    while it < 120 {
        let fr = npv(r, cashflows);
        if num_abs(fr) < 1e-13 or (hi - lo) < 1e-13 { return r; }
        if (flo < 0 and fr < 0) or (flo > 0 and fr > 0) {
            lo = r;
            flo = fr;
        } else {
            hi = r;
        }
        let dfr = _npv_deriv(r, cashflows);
        let rn = 0.5 * (lo + hi);
        if num_abs(dfr) > 1e-20 {
            let cand = r - fr / dfr;
            if cand > lo and cand < hi { rn = cand; }
        }
        r = rn;
        it = it + 1;
    }
    return r;
}

// Standard TVM payment solving PV + PMT * (1 - (1+r)^(-n))/r + FV * (1+r)^(-n) = 0
fn pmt(rate, nper, pv, fv = 0.0) {
    if nper <= 0 { return error("pmt: nper must be > 0"); }
    if num_abs(rate) < 1e-14 {
        return 0.0 - (pv + fv) / nper;
    }
    let factor = num_pow(1.0 + rate, nper);
    return 0.0 - (rate * (pv * factor + fv)) / (factor - 1.0);
}

fn loan_amortization(principal, annual_rate, months) {
    if principal < 0 or months <= 0 {
        return error("loan_amortization: require principal >= 0 and months > 0");
    }
    let r_m = annual_rate / 12.0;
    let payment = 0.0 - pmt(r_m, months, principal, 0.0);
    let balance = principal;
    let schedule = [];
    let total_interest = 0.0;
    let total_payment = 0.0;

    let m = 1;
    while m <= months {
        let interest = balance * r_m;
        let princ_paid = payment - interest;
        let pmt_m = payment;
        if m == months {
            princ_paid = balance;
            pmt_m = interest + princ_paid;
            balance = 0.0;
        } else {
            balance = _max(0.0, balance - princ_paid);
        }
        total_interest = total_interest + interest;
        total_payment = total_payment + pmt_m;
        array_push(schedule, map{
            month: m,
            payment: pmt_m,
            interest: interest,
            principal: princ_paid,
            balance: balance
        });
        m = m + 1;
    }

    return map{
        monthly_payment: payment,
        total_payment: total_payment,
        total_interest: total_interest,
        schedule: schedule
    };
}

fn bond_analytics(face, coupon_rate, ytm, years, freq = 2) {
    if face <= 0 or years <= 0 or freq <= 0 {
        return error("bond_analytics: face, years, and freq must be > 0");
    }
    let n_periods = num_round(years * freq);
    let y_p = ytm / freq;
    let c_p = (face * coupon_rate) / freq;

    let price = 0.0;
    let mac_num = 0.0;
    let conv_num = 0.0;
    let k = 1;
    while k <= n_periods {
        let cf = c_p;
        if k == n_periods { cf = cf + face; }
        let pv_k = cf / num_pow(1.0 + y_p, k);
        let t_years = (k * 1.0) / freq;
        price = price + pv_k;
        mac_num = mac_num + t_years * pv_k;
        conv_num = conv_num + k * (k + 1.0) * pv_k;
        k = k + 1;
    }

    let mac_dur = mac_num / price;
    let mod_dur = mac_dur / (1.0 + y_p);
    let convexity = conv_num / (price * (1.0 + y_p) * (1.0 + y_p) * freq * freq);

    return map{
        price: price,
        macaulay_duration: mac_dur,
        modified_duration: mod_dur,
        convexity: convexity
    };
}

fn black_scholes(S, K, T, r, sigma, option_type = "call") {
    if S <= 0 or K <= 0 or T <= 0 or sigma <= 0 {
        return error("black_scholes: S, K, T, and sigma must be > 0");
    }
    let sqT = num_sqrt(T);
    let d1 = (num_ln(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * sqT);
    let d2 = d1 - sigma * sqT;
    let pdf_d1 = normal_pdf(d1, 0.0, 1.0);
    let disc_K = K * num_exp(0.0 - r * T);

    let gamma_val = pdf_d1 / (S * sigma * sqT);
    let vega_val = S * pdf_d1 * sqT;

    if option_type == "call" {
        let nd1 = normal_cdf(d1, 0.0, 1.0);
        let nd2 = normal_cdf(d2, 0.0, 1.0);
        return map{
            option_type: "call",
            price: S * nd1 - disc_K * nd2,
            delta: nd1,
            gamma: gamma_val,
            vega: vega_val,
            theta: 0.0 - (S * pdf_d1 * sigma) / (2.0 * sqT) - r * disc_K * nd2,
            rho: K * T * num_exp(0.0 - r * T) * nd2
        };
    } else if option_type == "put" {
        let nmd1 = normal_cdf(0.0 - d1, 0.0, 1.0);
        let nmd2 = normal_cdf(0.0 - d2, 0.0, 1.0);
        return map{
            option_type: "put",
            price: disc_K * nmd2 - S * nmd1,
            delta: normal_cdf(d1, 0.0, 1.0) - 1.0,
            gamma: gamma_val,
            vega: vega_val,
            theta: 0.0 - (S * pdf_d1 * sigma) / (2.0 * sqT) + r * disc_K * nmd2,
            rho: 0.0 - K * T * num_exp(0.0 - r * T) * nmd2
        };
    }
    return error("black_scholes: option_type must be 'call' or 'put'");
}

// 4.2 Dimensional SI Unit Conversions & Uncertainty Propagation

