    // Area (SI base: m2)
    mm2:  map{ dim: "area", factor: 1e-6 },
    cm2:  map{ dim: "area", factor: 1e-4 },
    m2:   map{ dim: "area", factor: 1.0 },
    sqm:  map{ dim: "area", factor: 1.0 },
    ha:   map{ dim: "area", factor: 1e4 },
    km2:  map{ dim: "area", factor: 1e6 },
    sqkm: map{ dim: "area", factor: 1e6 },
    ft2:  map{ dim: "area", factor: 0.09290304 },
    sqft: map{ dim: "area", factor: 0.09290304 },
    acre: map{ dim: "area", factor: 4046.8564224 }
};

fn convert_units(val, from_unit, to_unit) {
    if !map_has(_UNIT_TABLE, from_unit) {
        return error("convert_units: unknown unit '" + str(from_unit) + "'");
    }
    if !map_has(_UNIT_TABLE, to_unit) {
        return error("convert_units: unknown unit '" + str(to_unit) + "'");
    }
    let uf = _UNIT_TABLE[from_unit];
    let ut = _UNIT_TABLE[to_unit];
    if uf.dim != ut.dim {
        return error("convert_units: incompatible dimensions '" + uf.dim + "' (" + from_unit + ") -> '" + ut.dim + "' (" + to_unit + ")");
    }
    if from_unit == to_unit { return val; }

    if uf.dim == "temperature" {
        let kelvin = val;
        if from_unit == "C" { kelvin = val + 273.15; }
        else if from_unit == "F" { kelvin = (val - 32.0) * (5.0 / 9.0) + 273.15; }

        if to_unit == "K" { return kelvin; }
        if to_unit == "C" { return kelvin - 273.15; }
        if to_unit == "F" { return (kelvin - 273.15) * (9.0 / 5.0) + 32.0; }
    }
    return (val * uf.factor) / ut.factor;
}

// First-order Gaussian error propagation + deterministic Box-Muller Monte-Carlo check
fn propagate_uncertainty(fn_handle, means, std_devs) {
    let d = len(means);
    if d != len(std_devs) or d == 0 {
        return error("propagate_uncertainty: means and std_devs must have equal non-zero length");
    }
    let nominal = fn_handle(means);
    let grad = _zeros(d);
    let xp = _vec_copy(means);
    let var_f = 0.0;
    let i = 0;
    while i < d {
        if std_devs[i] < 0 { return error("propagate_uncertainty: std_devs must be >= 0"); }
        let h = _max(1e-7 * _max(1.0, num_abs(means[i])), 1e-6 * std_devs[i]);
        xp[i] = means[i] + h;
        let fp = fn_handle(xp);
        xp[i] = means[i] - h;
        let fm = fn_handle(xp);
        xp[i] = means[i];
        grad[i] = (fp - fm) / (2.0 * h);
        let term = grad[i] * std_devs[i];
        var_f = var_f + term * term;
        i = i + 1;
    }
    let sigma_f = num_sqrt(var_f);
    let contribs = _zeros(d);
    if var_f > 0 {
        i = 0;
        while i < d {
            let term = grad[i] * std_devs[i];
            contribs[i] = (term * term) / var_f;
            i = i + 1;
        }
    }

    // Deterministic Monte-Carlo verification (2000 samples via LCG + Box-Muller)
    let n_mc = 2000;
    let seed = 123456789;
    let mc_sum = 0.0;
    let mc_sq = 0.0;
    let s = 0;
    let xs = _zeros(d);
    while s < n_mc {
        i = 0;
        while i < d {
            seed = num_mod(seed * 1664525 + 1013904223, 4294967296);
            let u1 = (seed + 1.0) / 4294967297.0;
            seed = num_mod(seed * 1664525 + 1013904223, 4294967296);
            let u2 = (seed + 1.0) / 4294967297.0;
            let z = num_sqrt(-2.0 * num_ln(u1)) * num_cos(_TWO_PI * u2);
            xs[i] = means[i] + std_devs[i] * z;
            i = i + 1;
        }
        let yv = fn_handle(xs);
        mc_sum = mc_sum + yv;
        mc_sq = mc_sq + yv * yv;
        s = s + 1;
    }
    let mc_mean = mc_sum / n_mc;
    let mc_var = _max(0.0, (mc_sq - n_mc * mc_mean * mc_mean) / (n_mc - 1.0));
    let mc_std = num_sqrt(mc_var);

    return map{
        value: nominal,
        std_dev: sigma_f,
        variance: var_f,
        gradient: grad,
        contributions: contribs,
        mc_mean: mc_mean,
        mc_std_dev: mc_std,
        ci_95: [nominal - 1.959963984540054 * sigma_f, nominal + 1.959963984540054 * sigma_f]
    };
}

