// Pure PBLang Flagship Mathematical Suites (v2.6.0):
//   1. PhotoMath Engine: 2D Spatial Bitmap Math-OCR, Multi-Method Bilingual Tutor & Function Investigator
//   2. GeoGebra Dynamic Geometry DAG & Desmos Nonlinear Curve Fitting (Levenberg-Marquardt)
//   3. MATLAB Vectorized Computing, Control Systems Toolbox (TF, Bode, Step, Root Locus) & Simulink Simulator
//   4. Mathematica / Wolfram Symbolic Pattern Matcher, Rule Rewriter, Functional Iterators & Pade Approximants
//
// 100% Pure PBLang (.sapp), zero external dependencies, zero host/network I/O.

let CAS  = import("stdlib:math/symbolic_cas.sapp");
let CALC = import("stdlib:math/calculus_ode.sapp");
let LA   = import("stdlib:math/linalg_geometry.sapp");
let EX   = import("stdlib:math/exact_algebra.sapp");
let GOV  = import("stdlib:math/resource_governor.sapp");

let FLAGSHIP_VERSION = "2.6.0";
let _PI = 3.141592653589793;
let _LN10 = 2.302585092994046;
let _BI0 = bigint(0);
let _BI1 = bigint(1);

// ============================================================================
// SECTION 0: Shared Numeric, String & AST Helpers
// ============================================================================

fn _is_finite_num(v) {
    if v == nil or type(v) != "number" { return false; }
    if v != v { return false; }
    let sv = str(v);
    if sv == "inf" or sv == "-inf" or sv == "Infinity" or sv == "-Infinity" or sv == "NaN" {
        return false;
    }
    return num_abs(v) < 1e300;
}

fn _nan_num() {
    return nil;
}

fn _min2(a, b) {
    if a < b { return a; }
    return b;
}

fn _max2(a, b) {
    if a > b { return a; }
    return b;
}

fn _clamp(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

fn _ends_with(s, suf) {
    let ls = len(s);
    let lf = len(suf);
    if lf > ls { return false; }
    return str_slice(s, ls - lf, ls) == suf;
}

fn _copy_env(src) {
    let out = map{};
    if src == nil or type(src) != "map" { return out; }
    let ks = map_keys(src);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = src[k];
        i = i + 1;
    }
    return out;
}

fn _fmt_num(x) {
    if not _is_finite_num(x) { return "NaN"; }
    if num_abs(x) < 1e-13 { return "0"; }
    let rx = num_round(x);
    if num_abs(x - rx) < 1e-11 { return str(rx); }
    let sc = num_round(x * 1000000.0) / 1000000.0;
    return str(sc);
}

fn _snap_clean(x) {
    if not _is_finite_num(x) { return x; }
    if num_abs(x) < 1e-12 { return 0.0; }
    let rx = num_round(x);
    if num_abs(x - rx) < 1e-10 { return rx * 1.0; }
    return x;
}

// AST constructors & structural equality matching symbolic_cas.sapp
fn _ast_num(v) {
    let rx = num_round(v);
    if _is_finite_num(v) and num_abs(v - rx) < 1e-12 and num_abs(rx) < 1e12 {
        return CAS.rat(bigint(rx), _BI1);
    }
    return map{ "kind": "num", "val": v * 1.0 };
}

fn _ast_sym(nm) { return map{ "kind": "sym", "name": nm }; }
fn _ast_neg(a) { return map{ "kind": "neg", "arg": a }; }
fn _ast_sub(a, b) { return map{ "kind": "sub", "left": a, "right": b }; }
fn _ast_div(a, b) { return map{ "kind": "div", "num": a, "den": b }; }
fn _ast_pow(b, e) { return map{ "kind": "pow", "base": b, "exp": e }; }
fn _ast_call(nm, args) { return map{ "kind": "call", "fn_name": nm, "args": args }; }
fn _ast_rel(op, l, r) { return map{ "kind": "rel", "op": op, "lhs": l, "rhs": r }; }

fn _ast_add(args) {
    if len(args) == 0 { return CAS.rat(0, 1); }
    if len(args) == 1 { return args[0]; }
    return map{ "kind": "add", "args": args };
}

fn _ast_mul(args) {
    if len(args) == 0 { return CAS.rat(1, 1); }
    if len(args) == 1 { return args[0]; }
    return map{ "kind": "mul", "args": args };
}

fn _is_numeric_ast(node) {
    if node == nil or type(node) != "map" { return false; }
    let k = node["kind"];
    if k == "rat" or k == "num" { return true; }
    if k == "neg" { return _is_numeric_ast(node["arg"]); }
    return false;
}

fn _numeric_ast_val(node) {
    if node == nil or type(node) != "map" { return _nan_num(); }
    let k = node["kind"];
    if k == "rat" { return CAS.rat_to_float(node); }
    if k == "num" { return node["val"] * 1.0; }
    if k == "neg" { return 0.0 - _numeric_ast_val(node["arg"]); }
    return _nan_num();
}

fn _ast_eq(a, b) {
    if a == nil and b == nil { return true; }
    if a == nil or b == nil { return false; }
    if type(a) != "map" or type(b) != "map" { return false; }
    let ka = a["kind"];
    let kb = b["kind"];
    if _is_numeric_ast(a) and _is_numeric_ast(b) {
        if ka == "rat" and kb == "rat" {
            return CAS.rat_eq(a, b);
        }
        return num_abs(_numeric_ast_val(a) - _numeric_ast_val(b)) < 1e-12;
    }
    if ka != kb { return false; }
    if ka == "sym" { return a["name"] == b["name"]; }
    if ka == "neg" { return _ast_eq(a["arg"], b["arg"]); }
    if ka == "sub" { return _ast_eq(a["left"], b["left"]) and _ast_eq(a["right"], b["right"]); }
    if ka == "div" { return _ast_eq(a["num"], b["num"]) and _ast_eq(a["den"], b["den"]); }
    if ka == "pow" { return _ast_eq(a["base"], b["base"]) and _ast_eq(a["exp"], b["exp"]); }
    if ka == "rel" { return a["op"] == b["op"] and _ast_eq(a["lhs"], b["lhs"]) and _ast_eq(a["rhs"], b["rhs"]); }
    if ka == "call" {
        if a["fn_name"] != b["fn_name"] { return false; }
        let aa = a["args"];
        let bb = b["args"];
        if len(aa) != len(bb) { return false; }
        let i = 0;
        while i < len(aa) {
            if not _ast_eq(aa[i], bb[i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if ka == "add" or ka == "mul" {
        let aa = a["args"];
        let bb = b["args"];
        if len(aa) != len(bb) { return false; }
        let i = 0;
        while i < len(aa) {
            if not _ast_eq(aa[i], bb[i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    return CAS.to_ascii(a) == CAS.to_ascii(b);
}

fn _eval_cas_safe(ast_node, env_map) {
    let v = try CAS.eval_ast(ast_node, env_map) catch _nan_num();
    if type(v) == "number" and _is_finite_num(v) { return v; }
    return _nan_num();
}

fn _eval_1d_safe(ast_node, var_name, x_val, base_env = nil) {
    let env = _copy_env(base_env);
    env[var_name] = x_val * 1.0;
    return _eval_cas_safe(ast_node, env);
}

