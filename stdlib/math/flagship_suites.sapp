            "##...##",
            ".#####.",
            "##...##",
            "##...##",
            "##...##",
            ".#####."
        ],
        "9": [
            ".#####.",
            "##...##",
            "##...##",
            "##...##",
            ".######",
            ".....##",
            ".....##",
            "....##.",
            ".####.."
        ],
        "x": [
            ".......",
            ".......",
            "##...##",
            ".##.##.",
            "..###..",
            "...#...",
            "..###..",
            ".##.##.",
            "##...##"
        ],
        "y": [
            ".......",
            ".......",
            "##...##",
            "##...##",
            ".##.##.",
            "..###..",
            "...##..",
            "..##...",
            "###...."
        ],
        "a": [
            ".......",
            ".......",
            ".####..",
            "....##.",
            ".#####.",
            "##..##.",
            "##..##.",
            "##..###",
            ".###.##"
        ],
        "b": [
