// Pure image framing geometry. Existing renderers retain their default fit.
fn mode(value) {
    if type(value)!="string" or (value!="contain" and value!="cover" and value!="stretch") {
        throw "image fit must be contain, cover or stretch";
    }
    return value;
}
fn _extent(value, zero) {
    if type(value)!="number" or not (value>=0 and value<=1000000)
        or value!=num_floor(value) or (not zero and value==0) {
        throw "image fit requires bounded integer dimensions";
    }
    return value;
}
fn layout(width,height,box_width,box_height,fit="contain") {
    mode(fit); _extent(width,false); _extent(height,false);
    _extent(box_width,true); _extent(box_height,true);
    let out=map{x:0,y:0,w:box_width,h:box_height,sx:0,sy:0,sw:width,sh:height};
    if box_width==0 or box_height==0 or fit=="stretch" {return out;}
    if fit=="contain" {
        let scale=num_min(box_width/width,box_height/height);
        out.w=num_max(1,num_floor(width*scale));
        out.h=num_max(1,num_floor(height*scale));
        out.x=num_floor((box_width-out.w)/2);out.y=num_floor((box_height-out.h)/2);
    } else {
        let scale=num_max(box_width/width,box_height/height);
        out.sw=box_width/scale;out.sh=box_height/scale;
        out.sx=(width-out.sw)/2;out.sy=(height-out.sh)/2;
    }
    return out;
}
fn rendering(value) {
    if value!="auto" and value!="pixelated" {throw "image_rendering must be auto or pixelated";}
    return value;
}
export mode,layout,rendering;
