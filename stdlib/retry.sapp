// stdlib/retry.sapp — generic retry-with-backoff for any operation.
//
// Re-runs a thunk until it succeeds or the attempt budget is exhausted. A thunk
// "fails" by throwing; success returns its value (nil is a valid success value, handled
// via an out-of-band sentinel since pblang `catch` doesn't bind the error).
//
//   let retry = import("stdlib:retry.sapp");
//   let r = retry.run(fn() { return risky(); }, map{ attempts: 5, delay_ms: 50, backoff: 2 });
//   if r.ok { use(r.value); } else { /* gave up after r.attempts tries */ }
//   let v = retry.run_or(fn() { return risky(); }, map{ attempts: 3 }, fallback);

fn _opt(o, k, d) {
    if o == nil { return d; }
    if not map_has(o, k) { return d; }
    return o[k];
}

// run(thunk, opts) — opts: { attempts=3, delay_ms=0, backoff=1 (multiplier) }.
// Returns { ok, value, attempts } on success, or { ok:false, attempts } if exhausted.
fn run(thunk, opts) {
    let max = _opt(opts, "attempts", 3);
    let delay = _opt(opts, "delay_ms", 0);
    let backoff = _opt(opts, "backoff", 1);
    let attempt = 0;
    let cur = delay;
    while attempt < max {
        attempt = attempt + 1;
        // map{v: ...} sentinel: a throw yields nil from catch, which the success wrapper
        // (always a map) can never equal — so a thunk returning nil still counts as ok.
        let wrapped = try map{ v: thunk() } catch nil;
        if wrapped != nil { return map{ ok: true, value: wrapped.v, attempts: attempt }; }
        if attempt < max and cur > 0 { sleep_ms(cur); cur = cur * backoff; }
    }
    return map{ ok: false, attempts: attempt };
}

// run_or(thunk, opts, default) — the value on success, else `default`.
fn run_or(thunk, opts, default) {
    let r = run(thunk, opts);
    if r.ok { return r.value; }
    return default;
}

// times(thunk, n) — shorthand for run with n attempts and no delay.
fn times(thunk, n) { return run(thunk, map{ attempts: n }); }

export run, run_or, times;
