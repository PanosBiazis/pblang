// Critical-path lower bound with unlimited workers and caller-supplied durations.
let Ops=import("stdlib:devops_pipeline.sapp");
let Serialization=import("stdlib:serialization.sapp");
fn analyze(jobs,durations,reveal_ids=false) {
    let order=Ops.order(jobs);
    if type(reveal_ids)!="bool" or type(durations)!="map" or len(durations)!=len(order) { throw "timing: invalid duration map"; }
    let deps=map{}; let successors=map{}; let earliest=map{}; let finish=map{}; let latest=map{};
    for id in order {
        if not map_has(durations,id) { throw "timing: missing duration"; }
        let d=durations[id];
        if type(d)!="number" or not (d>=0 and d<=86400000) or d!=num_floor(d) { throw "timing: invalid duration"; }
        successors[id]=[];
    }
    for job in jobs { deps[job.id]=job.needs; for parent in job.needs { array_push(successors[parent],job.id); } }
    let total=0; let end=0;
    for id in order {
        let start=0; for parent in deps[id] { start=num_max(start,finish[parent]); }
        earliest[id]=start; finish[id]=start+durations[id]; end=num_max(end,finish[id]); total=total+durations[id];
    }
    let index=len(order)-1;
    while index>=0 {
        let id=order[index]; let deadline=end;
        for child in successors[id] { deadline=num_min(deadline,latest[child]); }
        latest[id]=deadline-durations[id]; index=index-1;
    }
    let rows=[]; let critical=0;
    for id in order {
        let slack=latest[id]-earliest[id]; if slack==0 { critical=critical+1; }
        let row=map{index:len(rows),duration_ms:durations[id],earliest_start_ms:earliest[id],earliest_finish_ms:finish[id],
            latest_start_ms:latest[id],slack_ms:slack,critical:slack==0};
        if reveal_ids { row.id=id; } array_push(rows,row);
    }
    return map{format:"pblang.pipeline-timing.v1",ok:true,jobs:rows,job_count:len(rows),critical_job_count:critical,
        lower_bound_ms:end,serial_duration_ms:total,contains_job_ids:reveal_ids,
        assumptions:"unlimited-workers-fixed-durations-zero-overhead",execution_performed:false,production_ready:false};
}
fn _inspect(source,reveal_ids) {
        if type(reveal_ids)!="bool" { throw "invalid reveal flag"; }
        let parsed=Serialization.parse_safe(source,"json",map{max_input_bytes:65536,max_depth:5,max_items:2048,strict:true,reject_duplicate_keys:true});
        if not parsed.ok or not parsed.duplicate_keys_checked { throw "invalid JSON"; }
        let doc=parsed.value;
        if type(doc)!="map" or len(doc)!=3 or not map_has(doc,"format") or doc.format!="pblang.pipeline-estimate.v1"
            or not map_has(doc,"jobs") or not map_has(doc,"durations_ms") { throw "invalid document"; }
        return analyze(doc.jobs,doc.durations_ms,reveal_ids);
}
fn inspect_text(source,reveal_ids=false) {
    let result=try _inspect(source,reveal_ids) catch nil;
    if result==nil { return map{format:"pblang.pipeline-timing.v1",ok:false,error:"Invalid pipeline estimate.",jobs:[],job_count:0,
        contains_job_ids:false,execution_performed:false,production_ready:false}; }
    return result;
}
export analyze,inspect_text;
