// Shared unary memoization for functional.sapp and pipe.sapp.
// Cache only immutable scalar keys. Other inputs still invoke the callback.
// Retain at most 1024 scalar-key entries; oversized text keys bypass retention.
// Callback/result allocations are not bounded by these cache-entry limits.
fn _key(x) {
    let kind = type(x);
    if kind == "string" {
        if len(x) > 4096 { return nil; }
        return "s:" + x;
    }
    if kind == "bool" { return "b:" + str(x); }
    if kind == "nil" { return "z:"; }
    if kind == "number" {
        // Avoid NaN/infinity and signed-zero identity assumptions.
        if x == 0 or x != x or x - x != 0 { return nil; }
        return "n:" + str(x);
    }
    // Never stringify or recursively inspect mutable/callable inputs.
    return nil;
}

fn memoize(f) {
    let cache = map{};
    let state = [0];
    return fn(x) {
        let key = _key(x);
        if type(key) == "nil" { return f(x); }
        if map_has(cache, key) {
            let entry = cache[key];
            // A printed number can lose precision: a key hit alone is not proof.
            if entry.input == x { return entry.value; }
        }
        let value = f(x);
        // Publish only after success. A colliding textual bucket is replaced,
        // never returned for a different scalar input.
        if map_has(cache, key) {
            cache[key] = map{ input: x, value: value };
        } elif state[0] < 1024 {
            cache[key] = map{ input: x, value: value };
            state[0] = state[0] + 1;
        }
        return value;
    };
}

export memoize;
