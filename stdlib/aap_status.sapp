// stdlib/aap_status.sapp -- bounded AAP multi-project status runner.
//
// This module composes the safe project text audit and metadata-only portfolio
// planner into one report for all declared product roots under AAP/products.
// It reads only caller-approved, capped text-like files through
// project_text_audit and never prints raw finding lines.

let TA = import("stdlib:project_text_audit.sapp");
let INV = import("stdlib:project_inventory.sapp");
let SURVEY = import("stdlib:project_survey.sapp");

fn project(name, roots) {
    return map{ name: name, roots: roots };
}

fn default_projects() {
    return [
        project("pblang", ["."]),
        project("pbai", ["../pbai"]),
        project("pb-mcp-server", ["../pb-mcp-server"]),
        project("pbremote", ["../pbremote"]),
        project("pbspotit", ["../pbspotit"]),
        project("pbos", ["../pbos"]),
        project("pbide", ["../pbide"]),
        project("pboffice", ["../pboffice"]),
        project("pbwatermarks-remover", ["../pbwatermarks-remover"]),
        project("aipy", ["../aipy"]),
        project("pbnexus", ["../pbnexus"]),
        project("pbmedia", ["../pbmedia"]),
        project("pbcircuits", ["../pbcircuits"]),
        project("pbcomms", ["../pbcomms"]),
        project("pbgitcomms", ["../pbgitcomms"]),
        project("spotit", ["../spotit"])
    ];
}

fn _audit_options(options = nil) {
    if options == nil { options = map{}; }
    return map{
        max_depth: try options.max_depth catch 4,
        max_entries: try options.max_entries catch 600,
        max_children_per_dir: try options.max_children_per_dir catch 120,
        max_files: try options.max_files catch 60,
        max_file_bytes: try options.max_file_bytes catch 18000,
        max_findings: try options.max_findings catch 80,
        max_source_high: try options.max_source_high catch 0,
        max_source_medium: try options.max_source_medium catch 4,
        max_source_total: try options.max_source_total catch 40,
        suppress_test_fixtures: try options.suppress_test_fixtures catch true,
        source_only_blockers: try options.source_only_blockers catch true,
        backlog_limit: try options.backlog_limit catch 6
    };
}

fn _status_score(status) {
    if status == "blocked" { return 3; }
    if status == "needs-review" { return 2; }
    if status == "passed" { return 1; }
    return 0;
}

fn _worst_status(current, next) {
    if _status_score(next) > _status_score(current) { return next; }
    return current;
}

fn _all_roots(projects) {
    let roots = [];
    let i = 0;
    while projects != nil and i < len(projects) {
        let rs = try projects[i].roots catch [];
        let j = 0;
        while j < len(rs) {
            array_push(roots, rs[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return roots;
}

fn _cap_num(n, max) {
    if n == nil { return 0; }
    if n < 0 { return 0; }
    if n > max { return max; }
    return n;
}

fn _focus_category(counts) {
    let source = try counts.source catch 0;
    if source > 0 {
        if (try counts.source_security_high catch 0) > 0 { return "security"; }
        if (try counts.source_reliability_high catch 0) > 0 { return "reliability"; }
        if (try counts.source_performance_high catch 0) > 0 { return "performance"; }
        if (try counts.source_blocking catch 0) == 0 and (try counts.roadmap catch 0) > 0 { return "roadmap"; }
        if (try counts.source_blocking catch 0) == 0 and (try counts.incomplete catch 0) > 0 { return "implementation"; }
        return "source-review";
    }
    if (try counts.roadmap catch 0) > 0 { return "roadmap"; }
    if (try counts.docs catch 0) > 0 { return "docs"; }
    if (try counts.config catch 0) > 0 { return "config"; }
    if (try counts.test catch 0) > 0 { return "tests"; }
    if (try counts.incomplete catch 0) > 0 { return "implementation"; }
    if (try counts.security catch 0) > 0 { return "security"; }
    if (try counts.reliability catch 0) > 0 { return "reliability"; }
    if (try counts.performance catch 0) > 0 { return "performance"; }
    return "maintenance";
}

fn _focus_title(status, category) {
    if status == "blocked" {
        if category == "security" { return "Fix blocking security/source findings"; }
        if category == "reliability" { return "Replace panic-prone source paths with structured errors"; }
        if category == "performance" { return "Cap expensive work and add benchmark coverage"; }
        return "Fix blocking source findings";
    }
    if status == "needs-review" {
        if category == "security" { return "Review security findings and add redaction/gate tests"; }
        if category == "reliability" { return "Review reliability findings and add edge-case tests"; }
        if category == "performance" { return "Review performance findings and add caps/benchmarks"; }
        if category == "implementation" { return "Finish partial or placeholder implementation work"; }
        if category == "roadmap" { return "Convert roadmap gaps into tested exit tasks"; }
        if category == "docs" { return "Sync docs with current implementation state"; }
        return "Review findings and close highest-signal backlog";
    }
    return "Keep green and pick the next portfolio improvement";
}

fn _focus_for_report(rep) {
    let status = str(try rep.status catch "unknown");
    let gate = try rep.quality_gate catch map{};
    let counts = try gate.counts catch map{};
    let category = _focus_category(counts);
    let findings = try rep.audit.report.finding_count catch (try counts.total catch 0);
    let source_blocking = try counts.source_blocking catch 0;
    let source_high = try counts.source_high catch 0;
    let source_medium = try counts.source_medium catch 0;
    let score = 0;
    if status == "blocked" { score = score + 100; }
    else if status == "needs-review" { score = score + 60; }
    else if status == "passed" { score = score + 10; }
    score = score + (_cap_num(source_high, 20) * 12);
    score = score + (_cap_num(source_medium, 20) * 6);
    score = score + (_cap_num(try counts.high catch 0, 20) * 8);
    score = score + (_cap_num(try counts.medium catch 0, 20) * 3);
    score = score + _cap_num(findings, 30);
    let name = str(try rep.project catch "project");
    return map{
        format: "pblang.aap_status.focus.v1",
        project: name,
        status: status,
        category: category,
        score: score,
        title: _focus_title(status, category),
        source_high_medium: source_blocking,
        source_high: source_high,
        source_medium: source_medium,
        findings: findings,
        records: try rep.collected.record_count catch 0,
        recommended_command: "pblang run tools/pbaudit.sapp --project=" + name + " --max-depth=4 --max-files=40 --lines=18"
    };
}

fn _rank_focus(items, limit = 8) {
    if limit == nil or limit < 1 { limit = 8; }
    let ranked = [];
    let i = 0;
    while i < len(items) {
        let item = items[i];
        let placed = false;
        let next = [];
        let j = 0;
        while j < len(ranked) {
            if not placed and (try item.score catch 0) > (try ranked[j].score catch 0) {
                array_push(next, item);
                placed = true;
            }
            array_push(next, ranked[j]);
            j = j + 1;
        }
        if not placed { array_push(next, item); }
        ranked = next;
        i = i + 1;
    }
    let out = [];
    let k = 0;
    while k < len(ranked) and k < limit {
        array_push(out, ranked[k]);
        k = k + 1;
    }
    return out;
}

fn next_focus_from_reports(reports, limit = 8) {
    let focus = [];
    let i = 0;
    while reports != nil and i < len(reports) {
        array_push(focus, _focus_for_report(reports[i]));
        i = i + 1;
    }
    return _rank_focus(focus, limit);
}

fn _report_for_project(reports, project_name) {
    let i = 0;
    while reports != nil and i < len(reports) {
        let rep = reports[i];
        if str(try rep.project catch "") == str(project_name) { return rep; }
        i = i + 1;
    }
    return nil;
}

fn focus_detail(report, index = 0, limit = 10) {
    if index == nil or index < 0 { index = 0; }
    if limit == nil or limit < 1 { limit = 10; }
    let r = try report catch map{};
    let focus = try r.next_focus catch [];
    if len(focus) == 0 or index >= len(focus) {
        return map{
            format: "pblang.aap_status.focus_detail.v1",
            status: "empty",
            focus: nil,
            lines: ["AAP focus: none"],
            detail: "no focus entries available"
        };
    }
    let f = focus[index];
    let rep = _report_for_project(try r.reports catch [], try f.project catch "");
    let detail_lines = [];
    if rep != nil { detail_lines = TA.audit_lines(rep, limit); }
    return map{
        format: "pblang.aap_status.focus_detail.v1",
        status: try f.status catch "unknown",
        focus: f,
        project: try f.project catch "project",
        category: try f.category catch "maintenance",
        score: try f.score catch 0,
        command: try f.recommended_command catch "",
        records: try f.records catch 0,
        findings: try f.findings catch 0,
        source_high_medium: try f.source_high_medium catch 0,
        lines: detail_lines,
        detail: str(try f.title catch "review")
    };
}

fn focus_detail_lines(detail, limit = 18) {
    if limit == nil or limit < 1 { limit = 18; }
    let d = try detail catch map{};
    let f = try d.focus catch map{};
    let lines = [
        "AAP focus detail: " + str(try d.project catch "project") +
            "/" + str(try d.category catch "maintenance") +
            " · " + str(try d.status catch "unknown") +
            " score=" + str(try d.score catch 0),
        str(try d.detail catch "review"),
        "records=" + str(try d.records catch 0) +
            " findings=" + str(try d.findings catch 0) +
            " source_high_medium=" + str(try d.source_high_medium catch 0),
        "command: " + str(try d.command catch (try f.recommended_command catch ""))
    ];
    let body = try d.lines catch [];
    let i = 0;
    while i < len(body) and len(lines) < limit {
        array_push(lines, "  " + str(body[i]));
        i = i + 1;
    }
    return lines;
}

fn status_report(projects = nil, options = nil) {
    if projects == nil { projects = default_projects(); }
    if options == nil { options = map{}; }
    let audit_opts = _audit_options(options);
    let reports = [];
    let status = "passed";
    let blocked = 0;
    let needs_review = 0;
    let passed = 0;
    let total_findings = 0;
    let source_blocking = 0;
    let records = 0;
    let skipped = 0;

    let i = 0;
    while i < len(projects) {
        let spec = projects[i];
        let name = str(try spec.name catch "project");
        let roots = try spec.roots catch [];
        let rep = TA.audit_roots(name, roots, audit_opts);
        array_push(reports, rep);
        let s = str(try rep.status catch "unknown");
        status = _worst_status(status, s);
        if s == "blocked" { blocked = blocked + 1; }
        else if s == "needs-review" { needs_review = needs_review + 1; }
        else if s == "passed" { passed = passed + 1; }
        total_findings = total_findings + (try rep.audit.report.finding_count catch 0);
        source_blocking = source_blocking + (try rep.quality_gate.counts.source_blocking catch 0);
        records = records + (try rep.collected.record_count catch 0);
        skipped = skipped + (try rep.collected.skipped_count catch 0);
        i = i + 1;
    }

    let include_portfolio = try options.include_portfolio catch true;
    let portfolio = nil;
    if include_portfolio {
        portfolio = INV.portfolio_action_from_roots(_all_roots(projects), map{
            max_depth: try options.portfolio_max_depth catch 3,
            max_entries: try options.portfolio_max_entries catch 500,
            max_children_per_dir: try options.portfolio_max_children_per_dir catch 100,
            limit_per_project: try options.limit_per_project catch 3,
            line_limit: try options.portfolio_lines catch 10
        });
    }
    let focus_limit = try options.focus_limit catch 8;
    let next_focus = next_focus_from_reports(reports, focus_limit);

    return map{
        format: "pblang.aap_status.report.v1",
        status: status,
        project_count: len(projects),
        blocked_count: blocked,
        needs_review_count: needs_review,
        passed_count: passed,
        total_findings: total_findings,
        source_blocking: source_blocking,
        source_high_medium: source_blocking,
        record_count: records,
        skipped_count: skipped,
        reports: reports,
        next_focus: next_focus,
        focus_count: len(next_focus),
        portfolio: portfolio,
        policy: "bounded multi-project status; text reads are capped and summaries do not print raw source lines"
    };
}

fn status_lines(report, limit = 28) {
    if limit == nil or limit < 1 { limit = 28; }
    let r = try report catch map{};
    let lines = [
        "AAP status: " + str(try r.status catch "unknown") +
            " · projects=" + str(try r.project_count catch 0) +
            " blocked=" + str(try r.blocked_count catch 0) +
            " review=" + str(try r.needs_review_count catch 0) +
            " passed=" + str(try r.passed_count catch 0),
        "records=" + str(try r.record_count catch 0) +
            " findings=" + str(try r.total_findings catch 0) +
            " source_high_medium=" + str(try r.source_high_medium catch (try r.source_blocking catch 0)) +
            " skipped=" + str(try r.skipped_count catch 0),
        "policy: " + str(try r.policy catch "bounded")
    ];
    let reps = try r.reports catch [];
    let i = 0;
    while i < len(reps) and len(lines) < limit {
        let rep = reps[i];
        let gate = try rep.quality_gate catch map{};
        let counts = try gate.counts catch map{};
        array_push(lines,
            "- " + str(try rep.project catch "project") +
            ": " + str(try rep.status catch "unknown") +
            " records=" + str(try rep.collected.record_count catch 0) +
            " findings=" + str(try rep.audit.report.finding_count catch 0) +
            " source_high_medium=" + str(try counts.source_blocking catch 0)
        );
        i = i + 1;
    }
    let focus = try r.next_focus catch [];
    if len(focus) > 0 and len(lines) < limit {
        array_push(lines, "next focus:");
        let fidx = 0;
        while fidx < len(focus) and len(lines) < limit {
            let f = focus[fidx];
            array_push(lines,
                "  - " + str(try f.project catch "project") +
                "/" + str(try f.category catch "maintenance") +
                " score=" + str(try f.score catch 0) +
                " :: " + str(try f.title catch "review")
            );
            fidx = fidx + 1;
        }
    }
    let portfolio = try r.portfolio catch nil;
    if portfolio != nil and len(lines) < limit {
        array_push(lines, "portfolio:");
        let plines = try portfolio.lines catch SURVEY.portfolio_action_lines(portfolio.action_plan, 6);
        let j = 0;
        while j < len(plines) and len(lines) < limit {
            array_push(lines, "  " + str(plines[j]));
            j = j + 1;
        }
    }
    return lines;
}

export project, default_projects, status_report, status_lines, next_focus_from_reports, focus_detail, focus_detail_lines;
