// stdlib/llm_tokenizer_train.sapp -- corpus-scale tokenizer training helpers.

let tok = import("stdlib:llm_tokenizer.sapp");
let data = import("stdlib:llm_data.sapp");

fn collect_text(records, max_chars) {
    let out = "";
    let used = 0;
    let skipped = 0;
    let i = 0;
    while i < len(records) and used < max_chars {
        let r = records[i];
        if data.secret_name(r.path) {
            skipped = skipped + 1;
        } else {
            let remaining = max_chars - used;
            let chunk = r.text;
            if len(chunk) > remaining { chunk = str_slice(chunk, 0, remaining); }
            out = out + chunk;
            used = used + len(chunk);
        }
        i = i + 1;
    }
    return map{ text: out, chars: used, skipped: skipped };
}

fn train_bpe_records(records, vocab_limit, min_pair_count, max_chars) {
    let c = collect_text(records, max_chars);
    let tokenizer = tok.bpe_train(c.text, vocab_limit, min_pair_count);
    return map{
        format: "pblang.tokenizer.training.run.v1",
        tokenizer: tokenizer,
        summary: tok.summary(tokenizer),
        chars: c.chars,
        skipped: c.skipped
    };
}

fn train_bpe_paths(paths, vocab_limit, min_pair_count, max_chars_per_file, max_total_chars) {
    let records = [];
    let skipped = 0;
    let i = 0;
    while i < len(paths) {
        if data.secret_name(paths[i]) or not data.text_like(paths[i]) {
            skipped = skipped + 1;
        } else {
            let text = data.read_text_file(paths[i], max_chars_per_file);
            if text != "" { push(records, data.corpus_record(paths[i], text, "text")); }
            else { skipped = skipped + 1; }
        }
        i = i + 1;
    }
    let run = train_bpe_records(records, vocab_limit, min_pair_count, max_total_chars);
    run.path_skipped = skipped;
    run.records = len(records);
    return run;
}

export collect_text, train_bpe_records, train_bpe_paths;
