// stdlib/pbai_assets.sapp -- inventory for external pbAI data/reference assets.
//
// External folders are not pbAI and do not define pbAI's architecture. This module only
// makes useful data/reference inputs discoverable from pblang today: dataset roots,
// tokenizer experiments, prior checkpoint metadata, and files that can be used for
// baselines or conversion tests while the real pbAI model is redesigned from scratch.

let DEFAULT_ROOTS = [
    "../../ai",
    "../../ai/pbai",
    "../ai"
];

fn _join(a, b) {
    if str_slice(a, len(a) - 1, len(a)) == "/" { return a + b; }
    return a + "/" + b;
}

fn _exists(path) {
    return try fs_exists(path) catch false;
}

fn _read_json(path) {
    return try json_parse(fs_read(path)) catch nil;
}

fn _env_root() {
    let v = try env_get("PBAI_ASSET_ROOT") catch nil;
    if v == nil or v == "" { return nil; }
    return v;
}

fn candidate_roots() {
    let roots = [];
    let e = _env_root();
    if e != nil { push(roots, e); }
    for r in DEFAULT_ROOTS { push(roots, r); }
    return roots;
}

fn checkpoint_dir(root) {
    return _join(_join(root, "max"), "max_model");
}

fn find_root() {
    let roots = candidate_roots();
    for r in roots {
        let ckpt = checkpoint_dir(r);
        if _exists(_join(ckpt, "config.json")) and _exists(_join(ckpt, "tokenizer.json")) {
            return r;
        }
    }
    return nil;
}

fn _file_status(path) {
    return map{ path: path, exists: _exists(path) };
}

fn checkpoint_files(root = nil) {
    if root == nil { root = find_root(); }
    if root == nil { return map{ available: false, files: [] }; }
    let ckpt = checkpoint_dir(root);
    return map{
        available: true,
        root: root,
        checkpoint_dir: ckpt,
        files: [
            _file_status(_join(ckpt, "config.json")),
            _file_status(_join(ckpt, "tokenizer.json")),
            _file_status(_join(ckpt, "tokenizer_config.json")),
            _file_status(_join(ckpt, "generation_config.json")),
            _file_status(_join(ckpt, "model.safetensors"))
        ]
    };
}

fn load_config(root = nil) {
    if root == nil { root = find_root(); }
    if root == nil { return nil; }
    return _read_json(_join(checkpoint_dir(root), "config.json"));
}

fn model_summary(root = nil) {
    if root == nil { root = find_root(); }
    if root == nil {
        return map{ available: false, reason: "pbAI asset root not found" };
    }
    let cfg = load_config(root);
    if cfg == nil {
        return map{ available: false, root: root, reason: "config.json could not be parsed" };
    }
    return map{
        available: true,
        root: root,
        checkpoint_dir: checkpoint_dir(root),
        model_type: cfg.model_type,
        architecture: cfg.architectures[0],
        layers: cfg.n_layer,
        heads: cfg.n_head,
        embedding: cfg.n_embd,
        ffn: cfg.n_inner,
        context: cfg.n_positions,
        vocab_size: cfg.vocab_size,
        dtype: cfg.dtype,
        activation: cfg.activation_function,
        checkpoint_format: "safetensors"
    };
}

fn tokenizer_summary(root = nil) {
    if root == nil { root = find_root(); }
    if root == nil {
        return map{ available: false, reason: "pbAI asset root not found" };
    }
    let tok = _read_json(_join(checkpoint_dir(root), "tokenizer.json"));
    let cfg = _read_json(_join(checkpoint_dir(root), "tokenizer_config.json"));
    if tok == nil {
        return map{ available: false, root: root, reason: "tokenizer.json could not be parsed" };
    }
    let vocab_count = 0;
    let merge_count = 0;
    let model_type = "unknown";
    if tok.model != nil {
        model_type = tok.model.type;
        if tok.model.vocab != nil { vocab_count = len(map_keys(tok.model.vocab)); }
        if tok.model.merges != nil { merge_count = len(tok.model.merges); }
    }
    return map{
        available: true,
        root: root,
        checkpoint_dir: checkpoint_dir(root),
        tokenizer_type: model_type,
        backend: if cfg == nil { "unknown" } else { cfg.backend },
        vocab_size: vocab_count,
        merges: merge_count,
        bos_token: if cfg == nil { "[BOS]" } else { cfg.bos_token },
        eos_token: if cfg == nil { "[EOS]" } else { cfg.eos_token },
        unk_token: if cfg == nil { "[UNK]" } else { cfg.unk_token },
        pad_token: if cfg == nil { "[PAD]" } else { cfg.pad_token }
    };
}

fn implementation_plan(root = nil) {
    let m = model_summary(root);
    let t = tokenizer_summary(root);
    return map{
        ready: (try m.available catch false) and (try t.available catch false),
        model: m,
        tokenizer: t,
        next_steps: [
            "define the fresh pbAI tokenizer, weight format, decoder block interface, and metadata schema",
            "use tokenizer.json vocab + merges only as reference material for a versioned pblang-native tokenizer",
            "train the smallest fresh pbAI-Nano transformer on pblang/code data plus selected external corpora",
            "use old checkpoints only as baselines or regression fixtures, not as pbAI-Max or the runtime architecture"
        ]
    };
}

fn describe(root = nil) {
    let plan = implementation_plan(root);
    if not plan.ready {
        return "pbAI assets: not found. Set PBAI_ASSET_ROOT to the AAP/ai folder or keep it at ../../ai from this repo.";
    }
    let m = plan.model;
    let t = plan.tokenizer;
    return "pbAI external references: prior " + m.model_type + " " + str(m.layers) + "L/" + str(m.heads)
        + "H d=" + str(m.embedding) + " ctx=" + str(m.context) + " vocab=" + str(m.vocab_size)
        + "; tokenizer=" + t.tokenizer_type + " vocab=" + str(t.vocab_size)
        + " merges=" + str(t.merges) + "; baseline checkpoint=" + m.checkpoint_dir
        + "/model.safetensors; not the pbAI runtime model.";
}

export candidate_roots, find_root, checkpoint_dir, checkpoint_files, load_config,
    model_summary, tokenizer_summary, implementation_plan, describe;
