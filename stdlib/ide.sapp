// stdlib/ide.sapp — Self-contained Web IDE for pblang
//
// Provides a complete web-based code editor that works with `pblang serve`.
// Embeds HTML/CSS/JS directly in pblang string literals for true code-as-data.
//
// Features:
//   - Code editor with dark theme, monospace font
//   - Run button → POST /run to the backend
//   - Output panel for results and errors
//   - Syntax highlighting hints (keywords highlighted)
//   - File save/load using the IDE's built-in localStorage
//   - Responsive layout
//
// Usage:
//   let ide = import("stdlib:ide.sapp");
//   ide.start(8090);   // starts IDE backend on port 8090
//   // or just get HTML:
//   let html = ide.render_page();

// ── CSS styles ───────────────────────────────────────────────────────────
fn ide_css() {
    return "
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
  background: #0d1117;
  color: #c9d1d9;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

#toolbar {
  background: #161b22;
  padding: 8px 16px;
  display: flex;
  gap: 8px;
  align-items: center;
  border-bottom: 1px solid #21262d;
  flex-shrink: 0;
  flex-wrap: wrap;
}
#toolbar .brand {
  font-size: 15px;
  font-weight: 700;
  color: #58a6ff;
  margin-right: auto;
  letter-spacing: -0.5px;
}
#toolbar button {
  background: #21262d;
  color: #c9d1d9;
  border: 1px solid #30363d;
  padding: 6px 14px;
  border-radius: 6px;
  cursor: pointer;
  font-family: inherit;
  font-size: 12px;
  transition: all 0.15s;
}
#toolbar button:hover { background: #30363d; border-color: #58a6ff; }
#toolbar button.run {
  background: #1f6feb;
  border-color: #1f6feb;
  color: #fff;
  font-weight: 600;
}
#toolbar button.run:hover { background: #388bfd; }
#toolbar button.save { background: #238636; border-color: #238636; color: #fff; }
#toolbar button.save:hover { background: #2ea043; }

#main {
  display: flex;
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

#editor-wrap {
  flex: 1;
  position: relative;
  background: #0d1117;
  display: flex;
  min-width: 0;
}
#editor {
  flex: 1;
  background: transparent;
  color: transparent;
  caret-color: #58a6ff;
  border: none;
  padding: 16px;
  font-family: inherit;
  font-size: 13.5px;
  line-height: 1.6;
  resize: none;
  outline: none;
  tab-size: 4;
  position: absolute;
  inset: 0;
  z-index: 2;
  overflow-y: auto;
  white-space: pre-wrap;
  word-wrap: break-word;
}
#highlight-layer {
  position: absolute;
  inset: 0;
  padding: 16px;
  font-family: inherit;
  font-size: 13.5px;
  line-height: 1.6;
  pointer-events: none;
  z-index: 1;
  overflow-y: auto;
  white-space: pre-wrap;
  word-wrap: break-word;
  color: #c9d1d9;
}

#splitter {
  width: 5px;
  cursor: col-resize;
  background: #21262d;
  flex-shrink: 0;
  transition: background 0.1s;
}
#splitter:hover { background: #58a6ff; }

#output-pane {
  width: 380px;
  min-width: 200px;
  background: #161b22;
  border-left: 1px solid #21262d;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  overflow: hidden;
}
.pane-header {
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}
.pane-header.output-h { background: #161b22; color: #3fb950; border-bottom: 1px solid #21262d; }
.pane-header.error-h { background: #161b22; color: #f85149; border-bottom: 1px solid #21262d; }
.pane-header.info-h { background: #161b22; color: #d2991d; border-bottom: 1px solid #21262d; }
.pane-content {
  flex: 1;
  padding: 14px;
  overflow-y: auto;
  font-size: 13px;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.55;
  min-height: 0;
}
.error-line { color: #f85149; }
.info-line { color: #58a6ff; }
.dim { color: #8b949e; }

#statusbar {
  background: #161b22;
  padding: 4px 16px;
  font-size: 11px;
  color: #8b949e;
  display: flex;
  gap: 14px;
  border-top: 1px solid #21262d;
  flex-shrink: 0;
}
#statusbar span.good { color: #3fb950; }
#statusbar span.warn { color: #d2991d; }

#file-modal {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 100;
  align-items: center;
  justify-content: center;
}
#file-modal.show { display: flex; }
.modal-box {
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 8px;
  padding: 20px;
  min-width: 400px;
  max-width: 90vw;
}
.modal-box h3 { color: #58a6ff; margin-bottom: 12px; font-size: 14px; }
.modal-box input {
  width: 100%;
  padding: 8px 12px;
  background: #0d1117;
  border: 1px solid #30363d;
  color: #c9d1d9;
  font-family: inherit;
  font-size: 13px;
  border-radius: 6px;
  outline: none;
  margin-bottom: 10px;
}
.modal-box input:focus { border-color: #58a6ff; }
.modal-box .btns { display: flex; gap: 8px; justify-content: flex-end; }
.modal-box button {
  background: #21262d; color: #c9d1d9;
  border: 1px solid #30363d; padding: 6px 14px;
  border-radius: 6px; cursor: pointer; font-family: inherit; font-size: 12px;
}
.modal-box button.primary { background: #238636; border-color: #238636; color: #fff; }

@media (max-width: 768px) {
  #main { flex-direction: column; }
  #splitter { width: 100%; height: 5px; cursor: row-resize; }
  #output-pane { width: 100%; min-width: unset; max-height: 40vh; border-left: none; border-top: 1px solid #21262d; }
}
";
}

// ── JavaScript ───────────────────────────────────────────────────────────
fn ide_js() {
    return "
// ── Syntax highlighter ─────────────────────────────────────────────────
var KEYWORDS = ['fn','let','const','if','else','elif','while','for','in',
  'return','break','continue','import','export','throw','try','catch',
  'defer','true','false','nil','match','case','class','struct','enum',
  'spawn','join','loop','and','or','not','is','default','switch'];

var BUILTINS = ['print','len','str','type','map','array_push','str_split',
  'str_trim','str_contains','str_starts_with','str_slice','strfromcharcode',
  'strcharcodeat','map_keys','map_has','fs_read','fs_write','fs_exists',
  'fs_mkdir','fs_remove','fs_list','now_iso','num_pow','parse_number',
  'json_parse','json_stringify','http_get','http_post','sleep_ms',
  'array_pop','array_join','array_sort','array_reverse'];

function highlight(src) {
  // HTML-escape first
  var e = src.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  // Strings: \"...\"
  e = e.replace(/(\"(?:[^\"\\\\]|\\\\.)*\")/g, '<span class=\"hl-str\">$1</span>');
  // Comments: //... and /*...*/
  e = e.replace(new RegExp('//[^\\n]*', 'g'), '<span class=\"hl-com\">$1</span>');
  e = e.replace(new RegExp('/\\*[\\s\\S]*?\\*\\/', 'g'), '<span class=\"hl-com\">$1</span>');
  // Numbers
  e = e.replace(/\\b(-?\\d+\\.?\\d*(?:[eE][+-]?\\d+)?)\\b/g, '<span class=\"hl-num\">$1</span>');
  // Keywords
  for (var i=0; i<KEYWORDS.length; i++) {
    var re = new RegExp('\\\\b('+KEYWORDS[i]+')\\\\b','g');
    e = e.replace(re, '<span class=\"hl-kw\">$1</span>');
  }
  // Builtins
  for (var i=0; i<BUILTINS.length; i++) {
    var re2 = new RegExp('\\\\b('+BUILTINS[i]+')\\\\b','g');
    e = e.replace(re2, '<span class=\"hl-bi\">$1</span>');
  }
  return e;
}

function updateHighlight() {
  var ed = document.getElementById('editor');
  var hl = document.getElementById('highlight-layer');
  hl.innerHTML = highlight(ed.value);
  // Sync scroll
  hl.scrollTop = ed.scrollTop;
  hl.scrollLeft = ed.scrollLeft;
}

// ── Output helpers ─────────────────────────────────────────────────────
function clearOutput() {
  document.getElementById('output').innerHTML = '';
  document.getElementById('errors').innerHTML = '';
  document.getElementById('perf').textContent = '';
}
function appendOutput(txt, cls) {
  var d = document.createElement('div');
  d.className = cls || '';
  d.textContent = txt;
  document.getElementById('output').appendChild(d);
  var pane = document.getElementById('output');
  pane.scrollTop = pane.scrollHeight;
}
function appendError(txt) {
  var d = document.createElement('div');
  d.className = 'error-line';
  d.textContent = txt;
  document.getElementById('errors').appendChild(d);
}

// ── Run code ───────────────────────────────────────────────────────────
async function runCode() {
  clearOutput();
  var code = document.getElementById('editor').value;
  var start = performance.now();

  try {
    var resp = await fetch('/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code })
    });
    var data = await resp.json();
    var elapsed = (performance.now() - start).toFixed(0);
    document.getElementById('perf').textContent = elapsed + 'ms';

    if (data.ok) {
      appendOutput(data.output || '(no output)', '');
    } else {
      appendError('Error (' + data.stage + '): ' + (data.error || 'unknown'));
      if (data.diagnostics) {
        data.diagnostics.forEach(function(d) {
          appendError('  line ' + d.line + ': ' + d.message);
        });
      }
    }
  } catch(e) {
    appendError('Network error: ' + e.message);
    document.getElementById('perf').textContent = 'ERR';
  }
}

async function checkCode() {
  clearOutput();
  var code = document.getElementById('editor').value;
  try {
    var resp = await fetch('/check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code })
    });
    var data = await resp.json();
    if (data.ok && (!data.diagnostics || data.diagnostics.length===0)) {
      appendOutput('✓ No issues found', 'info-line');
    } else if (data.diagnostics) {
      data.diagnostics.forEach(function(d) {
        appendError('line ' + d.line + ': ' + d.message);
      });
    } else {
      appendError(data.error || 'Check failed');
    }
  } catch(e) { appendError('Network error: ' + e.message); }
}

async function formatCode() {
  var code = document.getElementById('editor').value;
  try {
    var resp = await fetch('/format', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code })
    });
    var data = await resp.json();
    if (data.ok) {
      document.getElementById('editor').value = data.code;
      updateHighlight();
      appendOutput('✓ Formatted', 'info-line');
    }
  } catch(e) {}
}

// ── File save/load using localStorage ──────────────────────────────────
var FILE_PREFIX = 'pblang_ide_file_';

function showSaveDialog() {
  document.getElementById('file-modal').classList.add('show');
  document.getElementById('file-name-input').value = '';
  document.getElementById('file-name-input').focus();
}
function hideDialog() {
  document.getElementById('file-modal').classList.remove('show');
}
function saveFile() {
  var name = document.getElementById('file-name-input').value.trim();
  if (!name) return;
  var code = document.getElementById('editor').value;
  localStorage.setItem(FILE_PREFIX + name, code);
  hideDialog();
  loadFileList();
  appendOutput('✓ Saved as: ' + name, 'info-line');
}
function loadFileList() {
  var sel = document.getElementById('file-list');
  var val = sel.value;
  sel.innerHTML = '<option value=\"\">-- load file --</option>';
  for (var i=0; i<localStorage.length; i++) {
    var key = localStorage.key(i);
    if (key && key.startsWith(FILE_PREFIX)) {
      var fname = key.substring(FILE_PREFIX.length);
      var opt = document.createElement('option');
      opt.value = fname;
      opt.textContent = fname;
      sel.appendChild(opt);
    }
  }
  sel.value = val;
}
function loadSelectedFile() {
  var sel = document.getElementById('file-list');
  var name = sel.value;
  if (!name) return;
  var code = localStorage.getItem(FILE_PREFIX + name);
  if (code !== null) {
    document.getElementById('editor').value = code;
    updateHighlight();
    appendOutput('✓ Loaded: ' + name, 'info-line');
  }
}
function deleteSelectedFile() {
  var sel = document.getElementById('file-list');
  var name = sel.value;
  if (!name) return;
  if (confirm('Delete \"' + name + '\"? This cannot be undone.')) {
    localStorage.removeItem(FILE_PREFIX + name);
    loadFileList();
    appendOutput('✓ Deleted: ' + name, 'info-line');
  }
}
function exportFile() {
  var code = document.getElementById('editor').value;
  var blob = new Blob([code], {type:'text/plain'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'program.sapp';
  a.click();
}

// ── Keyboard shortcuts ─────────────────────────────────────────────────
document.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') {
    e.preventDefault();
    if (e.shiftKey) { checkCode(); } else { runCode(); }
  }
  if (e.ctrlKey && e.key === 's') {
    e.preventDefault();
    showSaveDialog();
  }
  if (e.ctrlKey && e.key === 'f') {
    e.preventDefault();
    formatCode();
  }
});

// ── Init ───────────────────────────────────────────────────────────────
window.addEventListener('load', function() {
  var ed = document.getElementById('editor');
  ed.addEventListener('input', updateHighlight);
  ed.addEventListener('scroll', function() {
    document.getElementById('highlight-layer').scrollTop = ed.scrollTop;
    document.getElementById('highlight-layer').scrollLeft = ed.scrollLeft;
  });
  updateHighlight();
  loadFileList();
});
";
}

// ── HTML page ───────────────────────────────────────────────────────────
fn ide_html() {
    return "<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"UTF-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
<title>pblang Web IDE</title>
<style>\n" + ide_css() + "
/* syntax highlight colors */
.hl-kw { color: #ff7b72; font-weight: 600; }
.hl-bi { color: #79c0ff; }
.hl-str { color: #a5d6ff; }
.hl-com { color: #8b949e; font-style: italic; }
.hl-num { color: #79c0ff; }
</style>
</head>
<body>

<div id=\"toolbar\">
  <span class=\"brand\">⚡ pblang IDE</span>
  <button class=\"run\" onclick=\"runCode()\">▶ Run</button>
  <button onclick=\"checkCode()\">✓ Check</button>
  <button onclick=\"formatCode()\">🎨 Format</button>
  <select id=\"file-list\" onchange=\"loadSelectedFile()\">
    <option value=\"\">-- load file --</option>
  </select>
  <button onclick=\"showSaveDialog()\" class=\"save\">💾 Save</button>
  <button onclick=\"deleteSelectedFile()\">🗑 Delete</button>
  <button onclick=\"exportFile()\">📥 Export .sapp</button>
</div>

<div id=\"main\">
  <div id=\"editor-wrap\">
    <div id=\"highlight-layer\"></div>
    <textarea id=\"editor\" spellcheck=\"false\">// pblang Web IDE — Write, run, and explore!
// Keyboard: Ctrl+Enter = Run, Ctrl+Shift+Enter = Check

fn greet(name) {
    return \"Hello, \" + name + \"!\";
}

print greet(\"Developer\");
print \"2^10 = \" + str(num_pow(2, 10));

// Try writing your own code below!

</textarea>
  </div>
  <div id=\"splitter\"></div>
  <div id=\"output-pane\">
    <div class=\"pane-header output-h\">▶ Output</div>
    <div class=\"pane-content\" id=\"output\">
      <div class=\"dim\">Ready — press Run to execute your code</div>
    </div>
    <div class=\"pane-header error-h\">⚠ Errors</div>
    <div class=\"pane-content\" id=\"errors\"></div>
    <div class=\"pane-header info-h\">ℹ Diagnostics</div>
    <div class=\"pane-content\">
      <div class=\"dim\">Press Check for diagnostics</div>
    </div>
  </div>
</div>

<div id=\"statusbar\">
  <span>pblang IDE v0.6.0</span>
  <span class=\"good\" id=\"perf\"></span>
  <span id=\"cursor-pos\">line 1, col 1</span>
</div>

<div id=\"file-modal\">
  <div class=\"modal-box\">
    <h3>Save File</h3>
    <input id=\"file-name-input\" type=\"text\" placeholder=\"filename (e.g. my_program)\">
    <div class=\"btns\">
      <button onclick=\"hideDialog()\">Cancel</button>
      <button class=\"primary\" onclick=\"saveFile()\">Save</button>
    </div>
  </div>
</div>

<script>\n" + ide_js() + "
// ── Splitter drag ──────────────────────────────────────────────
(function() {
  var splitter = document.getElementById('splitter');
  var outputPane = document.getElementById('output-pane');
  var isDragging = false;
  splitter.addEventListener('mousedown', function(e) {
    isDragging = true;
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    e.preventDefault();
  });
  document.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    var main = document.getElementById('main');
    var rect = main.getBoundingClientRect();
    var w = rect.right - e.clientX;
    w = Math.max(200, Math.min(w, rect.width - 200));
    outputPane.style.width = w + 'px';
  });
  document.addEventListener('mouseup', function() {
    if (isDragging) {
      isDragging = false;
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
    }
  });
  // Cursor position tracker
  var editor = document.getElementById('editor');
  editor.addEventListener('click', updateCursorPos);
  editor.addEventListener('keyup', updateCursorPos);
  function updateCursorPos() {
    var text = editor.value.substring(0, editor.selectionStart);
    var lines = text.split('\\n');
    var line = lines.length;
    var col = lines[lines.length-1].length + 1;
    document.getElementById('cursor-pos').textContent = 'line ' + line + ', col ' + col;
  }
  updateCursorPos();
})();
</script>
</body>
</html>";
}

// ── Public API ──────────────────────────────────────────────────────────

/// Return the complete IDE page as a string (for use with HTTP servers).
fn render_page() {
    return ide_html();
}

/// Start the IDE server on the given port.
/// Uses the pblang serve infrastructure to serve this IDE.
fn start(port = 8090) {
    print("╔══════════════════════════════════════════════╗");
    print("║        pblang Web IDE                        ║");
    print("╠══════════════════════════════════════════════╣");
    print("║  To start the IDE, run:                      ║");
    print("║                                              ║");
    print("║    pblang serve --port " + str(port) + "                    ║");
    print("║                                              ║");
    print("║  Then open http://localhost:" + str(port) + " in your      ║");
    print("║  browser.                                     ║");
    print("║                                              ║");
    print("║  Or use this page content with any HTTP      ║");
    print("║  server:                                     ║");
    print("║    let page = ide.render_page();             ║");
    print("╚══════════════════════════════════════════════╝");

    return map{
        ok: true,
        port: port,
        url: "http://localhost:" + str(port),
        hint: "Run 'pblang serve --port " + str(port) + "' to start the server",
    };
}

/// Write the IDE HTML to a file that can be served by any HTTP server.
fn write_to_file(path = "ide.html") {
    let html = ide_html();
    let ok = fs_write(path, html);
    return map{
        ok: ok,
        path: path,
        size: len(html),
    };
}

export render_page, start, write_to_file, ide_css, ide_js, ide_html;
