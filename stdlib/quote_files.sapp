// Reuses the existing local file adapter; exclusive new copies, no overwrite.
let Q=import("stdlib:quote_document.sapp");let File=import("stdlib:secure_file.sapp");let Text=import("stdlib:text_document.sapp");
fn _path(path,ext) {
    if type(path)!="string" or len(path)<=len(ext) or len(path)>4096 or len(str_to_bytes(path))>4096 or not str_ends_with(str_lower(path),ext) {return false;}
    for i in range(0,len(path)) {let cp=strcharcodeat(path,i);if cp<32 or cp==127 {return false;}}
    return true;
}
fn open(path) {
    if not _path(path,".pbquote") {return map{ok:false,error:"Choose a .pbquote path."};}
    let read=try File.read_text(path,Q.MAX_FILE_BYTES,false) catch nil;
    if read==nil or not read.ok {return map{ok:false,error:"Could not read quote."};}
    let doc=try Q.decode(read.text) catch nil;
    if doc==nil {return map{ok:false,error:"Invalid quote format or limits."};}
    return map{ok:true,document:doc};
}
fn _encode(doc,kind) {
    if kind=="quote" {return Q.encode(doc);}
    if kind=="writer" {return Text.encode(Q.to_document(doc));}
    if kind=="text" {return Text.to_text(Q.to_document(doc));}
    throw "unsupported quote export";
}
fn save(path,doc,kind="quote") {
    let ext=map{quote:".pbquote",writer:".pbtext",text:".txt"};
    if type(kind)!="string" or not map_has(ext,kind) or not _path(path,ext[kind]) {return map{ok:false,error:"Use a new filename matching the export format."};}
    let text=try _encode(doc,kind) catch nil;
    if text==nil {return map{ok:false,error:"Invalid quote; nothing written."};}
    let write=try File.write_text_new_exclusive(path,text,false,false) catch nil;
    if write==nil or not write.ok {return map{ok:false,error:"Copy not confirmed. Use a new filename; failed copies may be incomplete."};}
    return map{ok:true,atomic_visibility:false};
}
export open,save;
