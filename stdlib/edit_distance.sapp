// Shared unit-cost Levenshtein implementation. No input mutation.
// Strings use Unicode scalar values; arrays retain element equality semantics.
fn _prepare(a, b) {
    if type(a)=="string" { a = str_split(a,""); }
    if type(b)=="string" { b = str_split(b,""); }
    if len(a)<len(b) { let swap=a; a=b; b=swap; }
    let rows=len(a); let cols=len(b); let start=0;
    while start<cols and a[start]==b[start] { start=start+1; }
    while cols>start and a[rows-1]==b[cols-1] { rows=rows-1; cols=cols-1; }
    return map{a:a,b:b,start:start,rows:rows-start,cols:cols-start};
}

fn distance(a, b) {
    if len(a)==0 { return len(b); }
    if len(b)==0 { return len(a); }
    if type(a)=="string" and type(b)=="string" and a==b { return 0; }
    let p=_prepare(a,b);
    if p.cols==0 { return p.rows; }
    let aa=p.a; let bb=p.b; let start=p.start; let rows=p.rows; let cols=p.cols;
    let row=[];
    for j cols+1 { push(row,j); }
    let i=1;
    while i<=rows {
        let diagonal=row[0]; row[0]=i;
        let ch=aa[start+i-1]; let j=1;
        while j<=cols {
            let above=row[j];
            let cost=1; if ch==bb[start+j-1] { cost=0; }
            let best=above+1;
            if row[j-1]+1<best { best=row[j-1]+1; }
            if diagonal+cost<best { best=diagonal+cost; }
            row[j]=best; diagonal=above; j=j+1;
        }
        i=i+1;
    }
    return row[cols];
}

// Exact distance when <= limit; otherwise limit+1 (not the actual distance).
// Explicit operation limits apply only to this new string-only API.
fn within(a, b, limit) {
    if type(a)!="string" or type(b)!="string" { throw "edit_distance.within: strings required"; }
    if type(limit)!="number" { throw "edit_distance.within: integer limit required"; }
    if limit!=limit or limit-limit!=0 or limit<0 or limit>4096 or num_floor(limit)!=limit {
        throw "edit_distance.within: limit must be an integer from 0 to 4096";
    }
    let la=len(a); let lb=len(b);
    if la>4096 or lb>4096 { throw "edit_distance.within: input exceeds 4096 characters"; }
    let exceeded=limit+1;
    if la-lb>limit or lb-la>limit { return exceeded; }
    if a==b { return 0; }
    let p=_prepare(a,b);
    if p.cols==0 { if p.rows>limit { return exceeded; } return p.rows; }
    let aa=p.a; let bb=p.b; let start=p.start; let rows=p.rows; let cols=p.cols;
    let previous=[]; let prev_lo=0; let prev_hi=cols;
    if limit<prev_hi { prev_hi=limit; }
    for j prev_hi+1 { push(previous,j); }
    let i=1;
    while i<=rows {
        let lo=i-limit; if lo<0 { lo=0; }
        let hi=i+limit; if hi>cols { hi=cols; }
        let current=[]; let row_min=exceeded; let j=lo;
        let ch=aa[start+i-1];
        while j<=hi {
            let best=exceeded;
            if j==0 { best=i; }
            else {
                if j>=prev_lo and j<=prev_hi { best=previous[j-prev_lo]+1; }
                if j>lo and current[j-lo-1]+1<best { best=current[j-lo-1]+1; }
                if j-1>=prev_lo and j-1<=prev_hi {
                    let cost=1; if ch==bb[start+j-1] { cost=0; }
                    let candidate=previous[j-1-prev_lo]+cost;
                    if candidate<best { best=candidate; }
                }
            }
            if best>exceeded { best=exceeded; }
            push(current,best); if best<row_min { row_min=best; }
            j=j+1;
        }
        if row_min>limit { return exceeded; }
        previous=current; prev_lo=lo; prev_hi=hi; i=i+1;
    }
    return previous[cols-prev_lo];
}

export distance, within;
