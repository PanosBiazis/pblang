// stdlib/timeseries.sapp — Time-series toolkit for pblang (pure pblang).
//
// Smoothing (simple & exponential moving averages), differencing, rolling
// statistics, autocorrelation, and RiskMetrics-style EWMA volatility. Pairs with
// stdlib:stat.sapp (descriptive), stdlib:prob.sapp (distributions/risk), and
// stdlib:inferential.sapp (tests/regression) for end-to-end quantitative work.
//
//   let ts = import("stdlib:timeseries.sapp");
//   ts.sma(prices, 20);              // 20-period simple moving average
//   ts.ewma_vol(returns, 0.94);      // RiskMetrics volatility series

fn _mean(a) {
    let s = 0;
    let i = 0;
    while i < len(a) { s = s + a[i]; i = i + 1; }
    return s / len(a);
}

// Only ordinary finite integer window sizes have a well-defined index range.
fn _window(window) {
    if type(window) != "number" { throw "timeseries: window must be a finite integer"; }
    if window * 0 != 0 or num_floor(window) != window {
        throw "timeseries: window must be a finite integer";
    }
}

// A conservative proof that every subset sum is exactly representable.
// Subtract from the budget before adding, so the proof cannot itself round up.
fn _exact_integer_sums(data) {
    let budget = 9007199254740991;
    let i = 0;
    while i < len(data) {
        let x = data[i];
        if type(x) != "number" { return false; }
        if x * 0 != 0 or num_floor(x) != x { return false; }
        let magnitude = num_abs(x);
        if magnitude > budget { return false; }
        budget = budget - magnitude;
        i = i + 1;
    }
    return true;
}

fn _rolling_total(data, window, average) {
    _window(window);
    let out = [];
    let n = len(data);
    if window <= 0 or window > n { return out; }
    // Small windows/few results do not repay a complete eligibility scan.
    if window >= 8 and n - window >= 7 and _exact_integer_sums(data) {
        let sum = 0;
        let i = 0;
        while i < window { sum = sum + data[i]; i = i + 1; }
        if average { push(out, sum / window); } else { push(out, sum); }
        while i < n {
            // Remove before adding: each intermediate remains a subset sum.
            sum = sum - data[i - window];
            sum = sum + data[i];
            if average { push(out, sum / window); } else { push(out, sum); }
            i = i + 1;
        }
        return out;
    }
    // Preserve left-to-right arithmetic, including rounding and NaN recovery.
    let i = 0;
    while i + window <= n {
        let sum = 0;
        let j = 0;
        while j < window { sum = sum + data[i + j]; j = j + 1; }
        if average { push(out, sum / window); } else { push(out, sum); }
        i = i + 1;
    }
    return out;
}

// sma(data, window) → simple moving averages (length n-window+1).
fn sma(data, window) { return _rolling_total(data, window, true); }

// ema(data, alpha) → exponential moving average (length n). Seeds with data[0];
// ema[i] = alpha*data[i] + (1-alpha)*ema[i-1]. Higher alpha = more reactive.
fn ema(data, alpha) {
    let out = [];
    let n = len(data);
    if n == 0 { return out; }
    let prev = data[0];
    push(out, prev);
    let i = 1;
    while i < n {
        prev = alpha * data[i] + (1 - alpha) * prev;
        push(out, prev);
        i = i + 1;
    }
    return out;
}

// diff(data) → first differences data[i+1]-data[i] (length n-1)
fn diff(data) {
    let out = [];
    let i = 1;
    while i < len(data) { push(out, data[i] - data[i - 1]); i = i + 1; }
    return out;
}

// cumsum(data) → running totals (length n)
fn cumsum(data) {
    let out = [];
    let acc = 0;
    let i = 0;
    while i < len(data) { acc = acc + data[i]; push(out, acc); i = i + 1; }
    return out;
}

// autocorr(data, lag) → autocorrelation coefficient at the given lag, in [-1,1].
// lag 0 is always 1. Uses the standard biased estimator (divide by n*variance).
fn autocorr(data, lag) {
    let n = len(data);
    let m = _mean(data);
    let denom = 0;
    let i = 0;
    while i < n { let d = data[i] - m; denom = denom + d * d; i = i + 1; }
    if denom == 0 { return 0; }
    let numer = 0;
    i = 0;
    while i < n - lag {
        numer = numer + (data[i] - m) * (data[i + lag] - m);
        i = i + 1;
    }
    return numer / denom;
}

// rolling_std(data, window) → rolling SAMPLE standard deviation (length n-window+1)
fn rolling_std(data, window) {
    _window(window);
    let out = [];
    let n = len(data);
    if window <= 1 or window > n { return out; }
    let i = 0;
    while i + window <= n {
        let sum = 0;
        let j = 0;
        while j < window { sum = sum + data[i + j]; j = j + 1; }
        let mean = sum / window;
        let sq = 0;
        j = 0;
        while j < window { let d = data[i + j] - mean; sq = sq + d * d; j = j + 1; }
        push(out, num_sqrt(sq / (window - 1)));
        i = i + 1;
    }
    return out;
}

// ewma_vol(returns, lambda) → RiskMetrics exponentially-weighted volatility
// series. var_t = lambda*var_{t-1} + (1-lambda)*r_t^2 (seeded var_0 = r_0^2);
// each element is sqrt(var_t). lambda ~ 0.94 is the RiskMetrics daily default.
fn ewma_vol(returns, lambda) {
    let out = [];
    let n = len(returns);
    if n == 0 { return out; }
    let var = returns[0] * returns[0];
    push(out, num_sqrt(var));
    let i = 1;
    while i < n {
        var = lambda * var + (1 - lambda) * returns[i] * returns[i];
        push(out, num_sqrt(var));
        i = i + 1;
    }
    return out;
}

// pct_change(data) → relative change between consecutive points (length n-1).
fn pct_change(data) {
    let out = [];
    let i = 1;
    while i < len(data) {
        let prev = data[i - 1];
        if prev == 0 { push(out, 0); } else { push(out, (data[i] - prev) / prev); }
        i = i + 1;
    }
    return out;
}

// lag(data, k) → series shifted right by k (front filled with nil); length n.
fn lag(data, k) {
    let out = [];
    let i = 0;
    while i < len(data) {
        if i < k { push(out, nil); } else { push(out, data[i - k]); }
        i = i + 1;
    }
    return out;
}

// zscore(data) → standardized values (x - mean) / population_std; zeros if std == 0.
fn zscore(data) {
    let n = len(data);
    let out = [];
    if n == 0 { return out; }
    let m = _mean(data);
    let varsum = 0;
    let i = 0;
    while i < n { let d = data[i] - m; varsum = varsum + d * d; i = i + 1; }
    let sd = num_sqrt(varsum / n);
    i = 0;
    while i < n {
        if sd == 0 { push(out, 0); } else { push(out, (data[i] - m) / sd); }
        i = i + 1;
    }
    return out;
}

// normalize(data) → min-max scaled to [0,1]; zeros if all values are equal.
fn normalize(data) {
    let n = len(data);
    let out = [];
    if n == 0 { return out; }
    let mn = data[0];
    let mx = data[0];
    let i = 1;
    while i < n { if data[i] < mn { mn = data[i]; } if data[i] > mx { mx = data[i]; } i = i + 1; }
    let rng = mx - mn;
    i = 0;
    while i < n {
        if rng == 0 { push(out, 0); } else { push(out, (data[i] - mn) / rng); }
        i = i + 1;
    }
    return out;
}

// rolling_sum(data, window) → windowed sums (length n-window+1).
fn rolling_sum(data, window) { return _rolling_total(data, window, false); }

// Bounded monotone index queue. Each index is inserted and removed at most once.
fn _rolling_extreme(data, window, maximum) {
    _window(window);
    if not is_array(data) { throw "timeseries: extrema require an array"; }
    let n = len(data);
    if n > 65536 { throw "timeseries: extrema input limit is 65536"; }
    let out = [];
    if window <= 0 or window > n { return out; }
    if window == 1 {
        for value in data {
            if type(value) != "number" { throw "timeseries: extrema require finite numbers"; }
            if value * 0 != 0 { throw "timeseries: extrema require finite numbers"; }
            push(out, value);
        }
        return out;
    }
    let queue = [];
    let head = 0;
    let i = 0;
    while i < n {
        let value = data[i];
        if type(value) != "number" { throw "timeseries: extrema require finite numbers"; }
        if value * 0 != 0 { throw "timeseries: extrema require finite numbers"; }
        if head < len(queue) and queue[head] <= i - window { head = head + 1; }
        while len(queue) > head {
            let last = data[queue[len(queue) - 1]];
            // Keep the earliest equal value, including its signed-zero identity.
            if (maximum and last < value) or (not maximum and last > value) {
                array_pop(queue);
            } else { break; }
        }
        push(queue, i);
        if i + 1 >= window { push(out, data[queue[head]]); }
        i = i + 1;
    }
    return out;
}

fn rolling_min(data, window) { return _rolling_extreme(data, window, false); }
fn rolling_max(data, window) { return _rolling_extreme(data, window, true); }

export sma, ema, diff, cumsum, autocorr, rolling_std, ewma_vol;
export pct_change, lag, zscore, normalize, rolling_sum, rolling_min, rolling_max;
