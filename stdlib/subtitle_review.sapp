// Compose existing subtitle metrics. Reports intentionally omit source cue text.
let Reading=import("stdlib:subtitle_reading.sapp");
let Timing=import("stdlib:subtitle_timing.sapp");
let Clip=import("stdlib:subtitle_clip.sapp");
let FORMAT="pblang.subtitle-review.v1";
fn analyze(doc,limit=20) {
 let reading=Reading.analyze(doc,limit);let timing=Timing.analyze(doc);let rows=[];let attention=0;
 for i in range(0,len(doc.cues)) {
  let cue=doc.cues[i];let metric=reading.cues[i];let overlap=timing.overlaps_by_index[i];
  let reasons=[];if metric.above_limit {array_push(reasons,"reading_rate");}if overlap>0 {array_push(reasons,"overlap");}
  if len(reasons)>0 {attention=attention+1;}
  array_push(rows,map{cue_index:i,start_ms:cue.start_ms,end_ms:cue.end_ms,duration_ms:metric.duration_ms,
   nonspace_codepoints:metric.nonspace_characters,characters_per_second:metric.characters_per_second,
   overlapping_cues:overlap,reasons:reasons});
 }
 return map{format:FORMAT,cue_count:len(rows),attention_count:attention,reading_limit:reading.limit,
  above_reading_limit:reading.above_limit,timing:timing,cues:rows,source_text_included:false,
  reading_measure:"nonspace_unicode_codepoints_per_second",human_readability_verified:false};
}
fn clip_review(doc,start_ms,end_ms,limit=20,zero=true) {
 let clipped=Clip.extract(doc,start_ms,end_ms,zero);let report=analyze(clipped,limit);let indices=[];
 for i in range(0,len(doc.cues)) {let cue=doc.cues[i];if cue.start_ms<end_ms and cue.end_ms>start_ms {array_push(indices,i);}}
 return map{format:"pblang.subtitle-clip-review.v1",window:map{start_ms:start_ms,end_ms:end_ms,zero_based:zero},
  source_indices:indices,report:report,source_text_included:false};
}
export FORMAT,analyze,clip_review;
