// Linux directory-handle filesystem confinement, implemented in PBLang.
//
// Every path component is opened relative to an already-open directory with
// O_NOFOLLOW. Actual byte I/O uses /proc/self/fd/<fd>, which names the held
// object rather than resolving the user-supplied path again. Namespace changes
// after validation therefore cannot redirect an operation outside the root.

let LIBC_PATHS = [
    "/usr/lib/x86_64-linux-gnu/libc.so.6", "/lib/x86_64-linux-gnu/libc.so.6",
    "/usr/lib/aarch64-linux-gnu/libc.so.6", "/lib/aarch64-linux-gnu/libc.so.6",
    "/usr/lib/i386-linux-gnu/libc.so.6", "/lib/i386-linux-gnu/libc.so.6",
    "/usr/lib/libc.so.6", "/lib/libc.so.6"
];

let RENAME_NOREPLACE = import("stdlib:linux_rename_noreplace.sapp");
let LINKAT_HELD = import("stdlib:linux_linkat_held.sapp");
let NATIVE_CRYPTO = import("stdlib:native_crypto_accel.sapp");

let AT_FDCWD = -100;
let AT_REMOVEDIR = 512;
let O_RDONLY = 0; let O_WRONLY = 1; let O_RDWR = 2;
let O_CREAT = 64; let O_EXCL = 128;
let O_NONBLOCK = 2048;
let O_DIRECTORY = 65536; let O_NOFOLLOW = 131072; let O_CLOEXEC = 524288;
let O_TMPFILE = 4259840;
let MFD_CLOEXEC = 1; let MFD_ALLOW_SEALING = 2;
let F_GETFD = 1; let F_SETFD = 2; let FD_CLOEXEC = 1;
let F_ADD_SEALS = 1033; let F_GET_SEALS = 1034;
let F_SEAL_SEAL = 1; let F_SEAL_SHRINK = 2;
let F_SEAL_GROW = 4; let F_SEAL_WRITE = 8;
let IMMUTABLE_SEALS = F_SEAL_SEAL + F_SEAL_SHRINK + F_SEAL_GROW + F_SEAL_WRITE;
let LOCK_EX = 2; let LOCK_NB = 4; let LOCK_UN = 8;
let MODE_FILE = 384; let MODE_DIR = 448;
let MAX_PATH = 4096; let MAX_COMPONENT = 255;
let _rename_noreplace_x64_cache = map{ known: false, supported: false };
let _linkat_empty_x64_cache = map{ known: false, supported: false };

fn _error(message) { return map{ ok: false, error: message }; }
fn _first_existing(paths) {
    let i = 0;
    while i < len(paths) { if try fs_exists(paths[i]) catch false { return paths[i]; } i = i + 1; }
    return nil;
}
fn available() {
    let libc = _first_existing(LIBC_PATHS);
    let proc_fd = try fs_exists("/proc/self/fd") catch false;
    let ffi_library_authority = false;
    if platform() == "linux" and libc != nil {
        let probe = try ffi_load(libc) catch nil;
        if probe != nil {
            ffi_library_authority = try { ffi_close(probe); true } catch false;
        }
    }
    // Loading and closing libc proves only the library-level grant. The VM's
    // current FFI policy does not expose a safe way to prove the complete
    // symbol + typed-signature contract required by this backend.
    let ffi_symbol_contract_verified = false;
    let library_ready = platform() == "linux" and libc != nil and proc_fd
        and ffi_library_authority;
    let reason = "ffi-symbol-contract-unverified";
    if platform() != "linux" { reason = "linux-required"; }
    elif libc == nil { reason = "trusted-libc-unavailable"; }
    elif not proc_fd { reason = "proc-fd-unavailable"; }
    elif not ffi_library_authority { reason = "ffi-library-authority-unavailable"; }
    return map{ ok: library_ready and ffi_symbol_contract_verified,
                library_ready: library_ready, libc: libc, proc_fd: proc_fd,
                ffi_library_authority: ffi_library_authority,
                ffi_symbol_contract_verified: ffi_symbol_contract_verified,
                reason: reason, contract: "pblang.linux-dirfs.v1" };
}

fn _components(path, allow_root = true) {
    if type(path) != "string" or len(path) > MAX_PATH or str_starts_with(path, "/") or
       str_contains(path, strfromcharcode(0)) { return nil; }
    if path == "" or path == "." or path == "root" { if allow_root { return []; } return nil; }
    let raw = str_split(path, "/"); let out = []; let i = 0;
    while i < len(raw) {
        let part = raw[i];
        if part == "" or part == "." or part == ".." or len(part) > MAX_COMPONENT { return nil; }
        array_push(out, part); i = i + 1;
    }
    return out;
}

fn _root_components(root) {
    if root == "." { return []; }
    return _components(root, false);
}

fn _absolute_components(path) {
    if type(path) != "string" or len(path) < 1 or len(path) > MAX_PATH
        or not str_starts_with(path, "/") or str_contains(path, strfromcharcode(0)) {
        return nil;
    }
    if path == "/" { return []; }
    let raw = str_split(path, "/"); let out = []; let i = 1;
    while i < len(raw) {
        let part = raw[i];
        if part == "" or part == "." or part == ".." or len(part) > MAX_COMPONENT { return nil; }
        array_push(out, part); i = i + 1;
    }
    if len(out) == 0 { return nil; }
    return out;
}

// The bootstrap typed-FFI table is process-global and temporarily removes a
// library handle while dispatching a call. Parallel isolated VMs can therefore
// observe the shared handle as unavailable. Keep the fast cached path, then use
// one independently loaded libc handle for this fixed call only.
fn _typed_call(fs, symbol, signature, args) {
    let direct = try map{ ok: true,
        value: ffi_call_typed(fs.libc, symbol, signature, args) }
        catch map{ ok: false };
    if direct.ok { return direct.value; }
    let libc_path = try fs.libc_path catch nil;
    if type(libc_path) != "string" or libc_path == "" { throw "linux_dirfs: libc handle unavailable"; }
    let transient = try ffi_load(libc_path) catch nil;
    if transient == nil { throw "linux_dirfs: transient libc handle unavailable"; }
    let fallback = try map{ ok: true,
        value: ffi_call_typed(transient, symbol, signature, args) }
        catch map{ ok: false };
    try ffi_close(transient) catch nil;
    if not fallback.ok { throw "linux_dirfs: typed libc call unavailable"; }
    return fallback.value;
}

fn _call(fs, symbol, signature, args) {
    // Keep every native symbol and ABI literal at the FFI boundary. The
    // caller-facing selector is accepted only for internal compatibility and
    // can never become an arbitrary dlsym target through tainted data.
    if symbol == "close" and signature == "i32->i32" {
        return try _typed_call(fs, "close", "i32->i32", args) catch -1;
    }
    if symbol == "strdup" and signature == "string->ptr" {
        return try _typed_call(fs, "strdup", "string->ptr", args) catch -1;
    }
    if symbol == "free" and signature == "ptr->void" {
        return try _typed_call(fs, "free", "ptr->void", args) catch -1;
    }
    if symbol == "calloc" and signature == "i64,i64->ptr" {
        return try _typed_call(fs, "calloc", "i64,i64->ptr", args) catch -1;
    }
    if symbol == "read" and signature == "i32,ptr,i64->i64" {
        return try _typed_call(fs, "read", "i32,ptr,i64->i64", args) catch -1;
    }
    if symbol == "pread" and signature == "i32,ptr,i64,i64->i64" {
        return try _typed_call(fs, "pread", "i32,ptr,i64,i64->i64", args) catch -1;
    }
    if symbol == "write" and signature == "i32,ptr,i64->i64" {
        return try _typed_call(fs, "write", "i32,ptr,i64->i64", args) catch -1;
    }
    if symbol == "fsync" and signature == "i32->i32" {
        return try _typed_call(fs, "fsync", "i32->i32", args) catch -1;
    }
    if symbol == "openat" and signature == "i32,ptr,i32,i32->i32" {
        return try _typed_call(fs, "openat", "i32,ptr,i32,i32->i32", args) catch -1;
    }
    if symbol == "mkdirat" and signature == "i32,ptr,i32->i32" {
        return try _typed_call(fs, "mkdirat", "i32,ptr,i32->i32", args) catch -1;
    }
    if symbol == "unlinkat" and signature == "i32,ptr,i32->i32" {
        return try _typed_call(fs, "unlinkat", "i32,ptr,i32->i32", args) catch -1;
    }
    if symbol == "renameat" and signature == "i32,ptr,i32,ptr->i32" {
        return try _typed_call(fs, "renameat", "i32,ptr,i32,ptr->i32", args) catch -1;
    }
    if symbol == "getpid" and signature == "->i32" {
        return try _typed_call(fs, "getpid", "->i32", args) catch -1;
    }
    if symbol == "getuid" and signature == "->i32" {
        return try _typed_call(fs, "getuid", "->i32", args) catch -1;
    }
    if symbol == "fchmod" and signature == "i32,i32->i32" {
        return try _typed_call(fs, "fchmod", "i32,i32->i32", args) catch -1;
    }
    if symbol == "flock" and signature == "i32,i32->i32" {
        return try _typed_call(fs, "flock", "i32,i32->i32", args) catch -1;
    }
    if symbol == "dup" and signature == "i32->i32" {
        return try _typed_call(fs, "dup", "i32->i32", args) catch -1;
    }
    if symbol == "fcntl" and signature == "i32,i32,i32->i32" {
        return try _typed_call(fs, "fcntl", "i32,i32,i32->i32", args) catch -1;
    }
    if symbol == "memfd_create" and signature == "string,i32->i32" {
        return try _typed_call(fs, "memfd_create", "string,i32->i32", args) catch -1;
    }
    if symbol == "sendfile" and signature == "i32,i32,ptr,i64->i64" {
        return try _typed_call(fs, "sendfile", "i32,i32,ptr,i64->i64", args) catch -1;
    }
    if symbol == "lseek" and signature == "i32,i64,i32->i64" {
        return try _typed_call(fs, "lseek", "i32,i64,i32->i64", args) catch -1;
    }
    return -1;
}
fn _i32(value) {
    // The current typed FFI uses an i64 trampoline for all integer returns.
    // A C function returning int writes EAX, so normalize its unsigned 32-bit
    // representation back to the signed result required by POSIX APIs.
    if value >= 2147483648 and value <= 4294967295 { return value - 4294967296; }
    return value;
}
fn _close_fd(fs, fd) {
    if fd < 0 { return true; }
    return _i32(_call(fs, "close", "i32->i32", [fd])) == 0;
}
fn _fd_path(fd) { return "/proc/self/fd/" + str(fd); }
fn _stat_program() {
    let candidates = ["/usr/bin/stat", "/bin/stat"];
    for i len(candidates) { if try fs_exists(candidates[i]) catch false { return candidates[i]; } }
    return nil;
}
fn sanitize_path(value) {
    if type(value) != "string" or len(value) > 128
        or not regex_match(value, "^/proc/[0-9]+/fd/[0-9]+$") {
        throw "linux_dirfs: invalid held-descriptor path";
    }
    return value;
}
fn _cstring(fs, value) { return _call(fs, "strdup", "string->ptr", [value]); }
fn _free(fs, pointer) { if pointer != nil and pointer != 0 { _call(fs, "free", "ptr->void", [pointer]); } }
fn _openat(fs, dirfd, name, flags, mode = 0) {
    let pointer = _cstring(fs, name); if pointer == nil or pointer == 0 { return -1; }
    let result = _i32(_call(fs, "openat", "i32,ptr,i32,i32->i32", [dirfd, pointer, flags, mode]));
    _free(fs, pointer); return result;
}
fn _mkdirat(fs, dirfd, name, mode) {
    let pointer = _cstring(fs, name); if pointer == nil or pointer == 0 { return -1; }
    let result = _i32(_call(fs, "mkdirat", "i32,ptr,i32->i32", [dirfd, pointer, mode]));
    _free(fs, pointer); return result;
}
fn _unlinkat(fs, dirfd, name, flags) {
    let pointer = _cstring(fs, name); if pointer == nil or pointer == 0 { return -1; }
    let result = _i32(_call(fs, "unlinkat", "i32,ptr,i32->i32", [dirfd, pointer, flags]));
    _free(fs, pointer); return result;
}
fn _renameat(fs, from_fd, from_name, to_fd, to_name) {
    let from_pointer = _cstring(fs, from_name); if from_pointer == nil or from_pointer == 0 { return -1; }
    let to_pointer = _cstring(fs, to_name);
    if to_pointer == nil or to_pointer == 0 { _free(fs, from_pointer); return -1; }
    let result = _i32(_call(fs, "renameat", "i32,ptr,i32,ptr->i32", [from_fd, from_pointer, to_fd, to_pointer]));
    _free(fs, to_pointer); _free(fs, from_pointer); return result;
}

fn _mode_verified(fs, fd, expected) {
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { return false; }
    let stat = _stat_program();
    if stat == nil { return false; }
    let path = sanitize_path("/proc/" + str(pid) + "/fd/" + str(fd));
    let checked = try proc_spawn_wait(stat, ["-L", "-c", "%a", path]) catch nil;
    return checked != nil and checked.exit_code == 0 and str_trim(checked.stdout) == expected;
}

fn _owner_verified(fs, fd) {
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    let uid = _i32(_call(fs, "getuid", "->i32", []));
    if pid <= 0 or uid < 0 { return map{ok:false}; }
    let stat = _stat_program(); if stat == nil { return map{ok:false}; }
    let path = sanitize_path("/proc/" + str(pid) + "/fd/" + str(fd));
    let checked = try proc_spawn_wait(stat, ["-L", "-c", "%u", path]) catch nil;
    if type(checked) != "map" { return map{ok:false}; }
    let observed = if checked.exit_code == 0 {
        _decimal(str_trim(checked.stdout))
    } else { nil };
    return map{ok:observed != nil and observed == uid,
        current_uid:uid,owner_uid:observed};
}

fn _decimal(value) {
    if type(value) != "string" or len(value) == 0 { return nil; }
    let negative = false; let i = 0;
    if strcharcodeat(value, 0) == 45 { negative = true; i = 1; }
    if i >= len(value) { return nil; }
    let out = 0;
    while i < len(value) {
        let code = strcharcodeat(value, i);
        if code < 48 or code > 57 { return nil; }
        out = out * 10 + code - 48; i = i + 1;
    }
    return if negative { 0 - out } else { out };
}

fn _hex(value) {
    if type(value) != "string" or len(value) == 0 { return nil; }
    let out = 0;
    for i len(value) {
        let code = strcharcodeat(value, i); let digit = -1;
        if code >= 48 and code <= 57 { digit = code - 48; }
        elif code >= 65 and code <= 70 { digit = code - 55; }
        elif code >= 97 and code <= 102 { digit = code - 87; }
        if digit < 0 { return nil; }
        out = out * 16 + digit;
    }
    return out;
}

fn _descriptor_metadata(fs, fd, path) {
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { return _error("process identity is unavailable"); }
    let stat = _stat_program();
    if stat == nil { return _error("descriptor metadata requires the stat utility"); }
    let held = sanitize_path("/proc/" + str(pid) + "/fd/" + str(fd));
    let checked = try proc_spawn_wait(stat, ["-L", "-c", "%f|%s|%Y|%u|%h", held]) catch nil;
    if checked == nil or checked.exit_code != 0 { return _error("held descriptor metadata is unavailable"); }
    let fields = str_split(str_trim(checked.stdout), "|");
    if len(fields) != 5 { return _error("held descriptor metadata is malformed"); }
    let mode = _hex(fields[0]); let size = _decimal(fields[1]); let modified = _decimal(fields[2]);
    let owner_uid = _decimal(fields[3]); let link_count = _decimal(fields[4]);
    let current_uid = _i32(_call(fs, "getuid", "->i32", []));
    if mode == nil or size == nil or size < 0 or modified == nil
       or owner_uid == nil or owner_uid < 0 or link_count == nil or link_count < 1
       or current_uid < 0 {
        return _error("held descriptor metadata contains invalid numeric fields");
    }
    if modified < 0 { modified = 0; }
    let file_type = bit_and(mode, 61440);
    let kind = "other";
    if file_type == 32768 { kind = "file"; }
    elif file_type == 16384 { kind = "directory"; }
    return map{
        ok: true, path: path, kind: kind, size: size,
        mtime_unix: modified, mtime_ms: modified * 1000,
        mode: mode, owner_uid: owner_uid, current_uid: current_uid,
        owner_current_user: owner_uid == current_uid, link_count: link_count,
        race_resistant: true, descriptor_bound: true
    };
}

fn open(root, create = true, protect_root = false) {
    let host = available(); if not host.library_ready { return _error(host.reason); }
    let parts = _root_components(root); if parts == nil { return _error("root must be a safe relative path"); }
    let libc = try ffi_load(host.libc) catch nil;
    if libc == nil { return _error("trusted libc cannot be loaded"); }
    let holder = map{ libc: libc, libc_path: host.libc };
    // Hold the current directory first, then resolve every caller-controlled
    // component relative to a held descriptor. O_NOFOLLOW on one multi-part
    // open protects only its final component and would leave intermediate
    // symlinks vulnerable to a check/use race.
    let current = _openat(holder, AT_FDCWD, ".", O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
    if current < 0 { ffi_close(libc); return _error("current directory cannot be opened"); }
    let i = 0;
    while i < len(parts) {
        let next = _openat(holder, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        if next < 0 and create {
            _mkdirat(holder, current, parts[i], MODE_DIR);
            // Always retry: another process may have won the mkdir race. The
            // descriptor open still rejects links and non-directories.
            next = _openat(holder, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        }
        _close_fd(holder, current);
        if next < 0 { ffi_close(libc); return _error("root component is missing, not a directory, or a symbolic link"); }
        current = next; i = i + 1;
    }
    if protect_root and len(parts) > 0 {
        if not _mode_verified(holder, current, "700")
           or not _owner_verified(holder, current).ok {
            _close_fd(holder, current); ffi_close(libc);
            return _error("relative root must already be current-user-owned mode 0700");
        }
    }
    return map{ ok: true, format: "pblang.linux-dirfs.v1", root: root, root_fd: current,
                libc: libc, libc_path: host.libc, closed: false,
                child_fds: map{}, lock_fds: map{} };
}

// Open a trusted absolute application-data root component-by-component. No
// component may be a symlink, and newly created directories are private from
// their first observable state. An existing protected root is verified without
// mutating its ownership or mode.
fn open_absolute(root, create = true, protect_root = true) {
    let host = available(); if not host.library_ready { return _error(host.reason); }
    let parts = _absolute_components(root); if parts == nil { return _error("root must be a safe absolute path"); }
    let libc = try ffi_load(host.libc) catch nil;
    if libc == nil { return _error("trusted libc cannot be loaded"); }
    let holder = map{ libc: libc, libc_path: host.libc };
    let current = _openat(holder, AT_FDCWD, "/", O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
    if current < 0 { ffi_close(libc); return _error("filesystem root cannot be opened"); }
    let i = 0;
    while i < len(parts) {
        let next = _openat(holder, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        if next < 0 and create {
            _mkdirat(holder, current, parts[i], MODE_DIR);
            next = _openat(holder, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        }
        _close_fd(holder, current);
        if next < 0 { ffi_close(libc); return _error("absolute path component is missing, not a directory, or a symbolic link"); }
        current = next; i = i + 1;
    }
    if protect_root {
        if not _mode_verified(holder, current, "700")
           or not _owner_verified(holder, current).ok {
            _close_fd(holder, current); ffi_close(libc);
            return _error("application root must already be current-user-owned mode 0700");
        }
    }
    return map{ ok: true, format: "pblang.linux-dirfs.v1", root: root, root_fd: current,
                libc: libc, libc_path: host.libc, closed: false, absolute: true,
                child_fds: map{}, lock_fds: map{} };
}

// Hold the current process' procfs network directory without traversing the
// `/proc/self` magic symlink. The PID comes only from libc, never caller input;
// open_absolute then resolves `/proc/<pid>/net` component-by-component with
// O_NOFOLLOW. This is the safe root for bounded `/proc/net`-style inspection
// in a process-specific network namespace.
fn open_current_process_net() {
    let host = available(); if not host.library_ready { return _error(host.reason); }
    let libc = try ffi_load(host.libc) catch nil;
    if libc == nil { return _error("trusted libc cannot be loaded"); }
    let holder = map{ libc: libc, libc_path: host.libc };
    let pid = _i32(_call(holder, "getpid", "->i32", []));
    ffi_close(libc);
    if pid <= 0 { return _error("current process identity is unavailable"); }
    let result = open_absolute("/proc/" + str(pid) + "/net", false, false);
    if result.ok { result.procfs_current_process = true; result.pid_exposed = false; }
    return result;
}

fn close(fs) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true) { return false; }
    let closed = true;
    let children = try fs.child_fds catch map{};
    let keys = map_keys(children);
    for i len(keys) {
        let fd = try parse_number(keys[i]) catch -1;
        if fd >= 0 and not _close_fd(fs, fd) { closed = false; }
    }
    fs.child_fds = map{};
    let locks = try fs.lock_fds catch map{};
    let lock_keys = map_keys(locks);
    for i len(lock_keys) {
        let fd = try parse_number(lock_keys[i]) catch -1;
        if fd >= 0 {
            _i32(_call(fs, "flock", "i32,i32->i32", [fd, LOCK_UN]));
            if not _close_fd(fs, fd) { closed = false; }
        }
    }
    fs.lock_fds = map{};
    if not _close_fd(fs, fs.root_fd) { closed = false; }
    let library_closed = try { ffi_close(fs.libc); true } catch false;
    fs.closed = true; fs.root_fd = -1;
    return closed and library_closed;
}

// Acquire an advisory exclusive lock on a descriptor-bound private file.
// A new inode is created mode-0600 with O_EXCL. An existing inode is never
// chmodded: it must be an owned, single-link regular file and, when the caller
// requires private state, must already be mode-0600.
// This prevents a preseeded hard link from turning lock setup into an external
// inode mutation. The kernel releases ownership if the process exits.
fn acquire_lock(fs, path, timeout_ms = 2000, poll_ms = 10, require_private = false) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true) {
        return _error("directory root is closed");
    }
    if type(timeout_ms) != "number" or timeout_ms != num_floor(timeout_ms)
       or timeout_ms < 0 or timeout_ms > 300000 {
        return _error("lock timeout_ms must be an integer in 0..300000");
    }
    if type(poll_ms) != "number" or poll_ms != num_floor(poll_ms)
       or poll_ms < 1 or poll_ms > 2000 {
        return _error("lock poll_ms must be an integer in 1..2000");
    }
    if type(require_private) != "bool" { return _error("lock require_private must be boolean"); }
    let parent = _parent(fs, path, true); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name,
        O_RDWR + O_CREAT + O_EXCL + O_NOFOLLOW + O_CLOEXEC, MODE_FILE);
    let created = fd >= 0;
    if fd < 0 {
        fd = _openat(fs, parent.fd, parent.name,
            O_RDWR + O_NOFOLLOW + O_CLOEXEC, 0);
    }
    _close_fd(fs, parent.fd);
    if fd < 0 { return _error("lock file cannot be opened without following links"); }
    if created {
        let protected = _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_FILE]));
        if protected != 0 {
            _close_fd(fs, fd); return _error("new lock file permissions cannot be requested");
        }
    }
    let lock_metadata = _descriptor_metadata(fs, fd, path);
    let safe_inode = lock_metadata.ok and lock_metadata.kind == "file"
        and lock_metadata.owner_current_user and lock_metadata.link_count == 1;
    let private_mode_verified = safe_inode and bit_and(lock_metadata.mode, 511) == MODE_FILE;
    if not safe_inode or (require_private and not private_mode_verified) {
        _close_fd(fs, fd);
        return _error("lock file does not satisfy owned single-link regular private policy");
    }
    let started = try now_ms() catch 0;
    let attempts = 0;
    // timeout_ms was admitted in 0..300000 above and remains immutable. Keeping
    // that contract in the loop condition also lets retained bootstrap linters
    // walk the body; elapsed time below is still the actual termination bound.
    while timeout_ms >= 0 {
        attempts = attempts + 1;
        let rc = _i32(_call(fs, "flock", "i32,i32->i32", [fd, LOCK_EX + LOCK_NB]));
        if rc == 0 {
            if not map_has(fs, "lock_fds") or type(fs.lock_fds) != "map" { fs.lock_fds = map{}; }
            fs.lock_fds[str(fd)] = true;
            let finished = try now_ms() catch started;
            let waited_ms = 0;
            if finished >= started { waited_ms = finished - started; }
            return map{
                ok: true, format: "pblang.linux-dirfs.lock.v1", path: path,
                fd: fd, owner_fd: fs.root_fd, active: true, exclusive: true,
                descriptor_bound: true, attempts: attempts,
                private_mode_verified: private_mode_verified,
                private_mode_required: require_private,
                exclusive_create: created, existing_inode_mutated: false,
                waited_ms: waited_ms
            };
        }
        let current = try now_ms() catch started + timeout_ms;
        let elapsed = timeout_ms;
        if current >= started { elapsed = current - started; }
        if elapsed >= timeout_ms {
            _close_fd(fs, fd);
            return map{ ok: false, error: "exclusive lock remained busy", timeout: true,
                        path: path, attempts: attempts, waited_ms: elapsed };
        }
        let delay = poll_ms;
        if delay > timeout_ms - elapsed { delay = timeout_ms - elapsed; }
        if delay > 0 { sleep_ms(delay); }
    }
}

fn release_lock(fs, lock) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or lock == nil or not is_map(lock) or not (try lock.active catch false)
       or (try lock.owner_fd catch -1) != (try fs.root_fd catch -2)
       or (try lock.fd catch -1) < 0
       or not map_has(try fs.lock_fds catch map{}, str(try lock.fd catch -1)) {
        return false;
    }
    let fd = lock.fd;
    let unlocked = _i32(_call(fs, "flock", "i32,i32->i32", [fd, LOCK_UN]));
    _close_fd(fs, fd); map_remove(fs.lock_fds, str(fd));
    lock.active = false; lock.fd = -1;
    return unlocked == 0;
}

// Expose only the kernel path of the already-held root. This is suitable for
// argv-only subprocess cwd arguments while the caller keeps the handle open;
// it never re-resolves the original caller-controlled namespace path.
fn descriptor_path(fs) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true) or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { return _error("process identity is unavailable"); }
    return map{ ok: true, path: "/proc/" + str(pid) + "/fd/" + str(fs.root_fd), descriptor_bound: true };
}

// Verify the held root without changing an existing caller directory.
fn private_root_status(fs) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    let owner = _owner_verified(fs, fs.root_fd);
    let mode_private = _mode_verified(fs, fs.root_fd, "700");
    return map{ok:type(owner) == "map" and owner.ok and mode_private,
        format:"pblang.linux-dirfs.private-root.v1",
        descriptor_bound:true,owned_by_current_uid:try owner.ok catch false,
        current_uid:try owner.current_uid catch nil,
        owner_uid:try owner.owner_uid catch nil,
        mode:"700",mode_private:mode_private};
}

// Duplicate a held directory descriptor for one child process. dup() clears
// FD_CLOEXEC by POSIX contract; fcntl verifies that postcondition instead of
// assuming it. The caller must keep `fs` open and close the returned handoff
// immediately after the synchronous child operation.
fn child_descriptor(fs) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    let fd = _i32(_call(fs, "dup", "i32->i32", [fs.root_fd]));
    if fd < 0 { return _error("directory descriptor cannot be duplicated for child handoff"); }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if flags < 0 {
        _close_fd(fs, fd); return _error("child descriptor flags cannot be read");
    }
    let inheritable_flags = flags - bit_and(flags, FD_CLOEXEC);
    if _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_SETFD, inheritable_flags])) != 0 {
        _close_fd(fs, fd); return _error("child descriptor cannot be made inheritable");
    }
    let verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if verified < 0 or bit_and(verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, fd); return _error("child descriptor inheritance postcondition failed");
    }
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { _close_fd(fs, fd); return _error("process identity is unavailable"); }
    if not map_has(fs, "child_fds") or type(fs.child_fds) != "map" { fs.child_fds = map{}; }
    fs.child_fds[str(fd)] = true;
    return map{
        ok: true, format: "pblang.linux-dirfs.child-descriptor.v1",
        fd: fd, owner_fd: fs.root_fd, active: true,
        inheritable: true, descriptor_bound: true
    };
}

// Adopt a directory descriptor inherited from a trusted parent process. The
// inherited descriptor is duplicated immediately so ownership stays local to
// this handle, and close-on-exec is restored on the duplicate before it can be
// exposed to any later subprocess. No namespace path is resolved.
fn adopt_inherited_directory(fd, protect_root = true) {
    if type(fd) != "number" or fd != num_floor(fd) or fd < 3 or fd > 4194304 {
        return _error("inherited directory descriptor is invalid");
    }
    let host = available();
    if not host.library_ready { return _error(host.reason); }
    let libc = try ffi_load(host.libc) catch nil;
    if libc == nil { return _error("trusted libc cannot be loaded"); }
    let holder = map{ libc: libc, libc_path: host.libc };
    let owned = _i32(_call(holder, "dup", "i32->i32", [fd]));
    if owned < 0 {
        ffi_close(libc); return _error("inherited directory descriptor cannot be duplicated");
    }
    let flags = _i32(_call(holder, "fcntl", "i32,i32,i32->i32", [owned, F_GETFD, 0]));
    let cloexec_flags = if flags >= 0 and bit_and(flags, FD_CLOEXEC) == 0 {
        flags + FD_CLOEXEC
    } else { flags };
    if flags < 0 or _i32(_call(holder, "fcntl", "i32,i32,i32->i32",
        [owned, F_SETFD, cloexec_flags])) != 0 {
        _close_fd(holder, owned); ffi_close(libc);
        return _error("adopted directory descriptor cannot be made close-on-exec");
    }
    let verified_flags = _i32(_call(holder, "fcntl", "i32,i32,i32->i32", [owned, F_GETFD, 0]));
    let metadata = _descriptor_metadata(holder, owned, ".");
    if verified_flags < 0 or bit_and(verified_flags, FD_CLOEXEC) == 0
       or not metadata.ok or metadata.kind != "directory" {
        _close_fd(holder, owned); ffi_close(libc);
        return _error("inherited descriptor is not a verified directory");
    }
    if protect_root {
        let protected = _i32(_call(holder, "fchmod", "i32,i32->i32", [owned, MODE_DIR]));
        if protected != 0 or not _mode_verified(holder, owned, "700") {
            _close_fd(holder, owned); ffi_close(libc);
            return _error("adopted directory permissions cannot be protected and verified");
        }
    }
    return map{
        ok: true, format: "pblang.linux-dirfs.v1", root: ".", root_fd: owned,
        libc: libc, libc_path: host.libc, closed: false,
        child_fds: map{}, lock_fds: map{}, inherited_descriptor: true,
        source_descriptor: fd, descriptor_bound: true, no_path_reopen: true
    };
}

fn child_file_descriptor(fs, path) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd);
    if fd < 0 { return _error("child input cannot be opened without following links"); }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if flags < 0 or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_SETFD, flags - bit_and(flags, FD_CLOEXEC)])) != 0 {
        _close_fd(fs, fd); return _error("child input cannot be made inheritable");
    }
    let verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if verified < 0 or bit_and(verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, fd); return _error("child input inheritance postcondition failed");
    }
    if not map_has(fs, "child_fds") or type(fs.child_fds) != "map" { fs.child_fds = map{}; }
    fs.child_fds[str(fd)] = true;
    return map{ ok: true, format: "pblang.linux-dirfs.child-file-descriptor.v1",
        fd: fd, owner_fd: fs.root_fd, active: true, inheritable: true,
        descriptor_bound: true, path: path };
}

fn _held_file_valid(fs, held) {
    return fs != nil and is_map(fs) and not (try fs.closed catch true)
        and held != nil and is_map(held) and (try held.active catch false)
        and (try held.owner_fd catch -1) == (try fs.root_fd catch -2)
        and (try held.fd catch -1) >= 0
        and map_has(try fs.child_fds catch map{}, str(try held.fd catch -1));
}

// Snapshot one no-follow regular file into an anonymous memfd, then seal every
// content mutation before returning it. Subsequent digest, probe and copy
// operations therefore observe one immutable object even if the namespace or
// original inode is changed concurrently.
fn sealed_snapshot_file_descriptor(fs, path, max_bytes = 268435456) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0
       or type(max_bytes) != "number" or max_bytes != num_floor(max_bytes)
       or max_bytes < 1 or max_bytes > 268435456 {
        return _error("invalid sealed snapshot policy");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let source = _openat(fs, parent.fd, parent.name,
        O_RDONLY + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd);
    if source < 0 { return _error("snapshot source cannot be opened without following links"); }
    let metadata = _descriptor_metadata(fs, source, path);
    let size = _call(fs, "lseek", "i32,i64,i32->i64", [source, 0, 2]);
    if not metadata.ok or (try metadata.kind catch "") != "file"
       or size < 1 or size > max_bytes
       or _call(fs, "lseek", "i32,i64,i32->i64", [source, 0, 0]) != 0 {
        _close_fd(fs, source); return _error("snapshot source is outside the regular-file policy");
    }
    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-sealed-file-snapshot", MFD_CLOEXEC + MFD_ALLOW_SEALING]));
    if snapshot < 0 {
        _close_fd(fs, source); return _error("sealed file snapshot is unavailable");
    }
    let copied = 0; let failed = false;
    while copied < size and not failed {
        let count = _call(fs, "sendfile", "i32,i32,ptr,i64->i64",
            [snapshot, source, 0, size - copied]);
        if count <= 0 or count > size - copied { failed = true; }
        else { copied = copied + count; }
    }
    let source_close_ok = _close_fd(fs, source);
    let protected = not failed and copied == size
        and _i32(_call(fs, "fchmod", "i32,i32->i32", [snapshot, MODE_FILE])) == 0
        and _mode_verified(fs, snapshot, "600")
        and _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 2]) == size
        and _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]) == 0
        and _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [snapshot, F_ADD_SEALS, IMMUTABLE_SEALS])) == 0;
    let seals = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [snapshot, F_GET_SEALS, 0]));
    if type(source_close_ok) != "bool" or not source_close_ok {
        _close_fd(fs, snapshot); return _error("snapshot source descriptor could not be closed");
    }
    if type(protected) != "bool" or not protected {
        _close_fd(fs, snapshot); return _error("file snapshot could not be copied and protected completely");
    }
    if seals < 0 or bit_and(seals, IMMUTABLE_SEALS) != IMMUTABLE_SEALS {
        _close_fd(fs, snapshot); return _error("file snapshot could not be copied and sealed completely");
    }
    if not map_has(fs, "child_fds") or type(fs.child_fds) != "map" { fs.child_fds = map{}; }
    fs.child_fds[str(snapshot)] = true;
    return map{
        ok: true, format: "pblang.linux-dirfs.sealed-file-snapshot.v1",
        fd: snapshot, owner_fd: fs.root_fd, active: true, inheritable: false,
        cloexec: true, descriptor_bound: true, nofollow: true,
        path_reopened: false, path: path, size: size, mode: "600",
        kernel_memory_backed: true, immutable: true, write_sealed: true,
        grow_sealed: true, shrink_sealed: true, further_seals_locked: true,
        seals: seals, bounded_memory: true
    };
}

fn held_base64_sha256(fs, held, offset = 0, count = nil) {
    if not _held_file_valid(fs, held) or not (try held.immutable catch false) {
        return _error("immutable held file descriptor is unavailable");
    }
    if count == nil { count = held.size - offset; }
    if type(offset) != "number" or offset != num_floor(offset) or offset < 0
       or type(count) != "number" or count != num_floor(count) or count < 0
       or offset > held.size or count > held.size - offset {
        return _error("held digest range is outside the immutable snapshot");
    }
    let crypto = NATIVE_CRYPTO.open();
    if not crypto.ok { return _error("trusted streaming crypto backend is unavailable"); }
    let result = NATIVE_CRYPTO.sha256_base64_fd_range(crypto, held.fd, offset, count);
    NATIVE_CRYPTO.close(crypto);
    if not result.ok { return _error(try result.error catch "held streaming digest failed"); }
    result.immutable_snapshot = true; result.path_reopened = false;
    return result;
}

fn held_magic_offsets(fs, held, magic, max_matches = 128) {
    if not _held_file_valid(fs, held) or not (try held.immutable catch false) {
        return _error("immutable held file descriptor is unavailable");
    }
    let crypto = NATIVE_CRYPTO.open();
    if not crypto.ok { return _error("trusted native scanner backend is unavailable"); }
    let result = NATIVE_CRYPTO.scan_fd_magic(crypto, held.fd, held.size,
        magic, max_matches);
    NATIVE_CRYPTO.close(crypto);
    if not result.ok { return _error(try result.error catch "held native scan failed"); }
    result.immutable_snapshot = true; result.path_reopened = false;
    return result;
}

fn read_held_range_bytes(fs, held, offset, count) {
    if not _held_file_valid(fs, held) or not (try held.immutable catch false)
       or type(offset) != "number" or offset != num_floor(offset) or offset < 0
       or type(count) != "number" or count != num_floor(count) or count < 0
       or count > 1048576 or offset > held.size or count > held.size - offset {
        return _error("held read range is outside policy");
    }
    if count == 0 { return map{ok:true,bytes:[],size:0,offset:offset,
        descriptor_bound:true,immutable_snapshot:true}; }
    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-held-range", MFD_CLOEXEC]));
    let buffer = _call(fs, "calloc", "i64,i64->ptr", [1, count]);
    if snapshot < 0 or buffer == nil or buffer == 0 {
        _close_fd(fs, snapshot); _free(fs, buffer);
        return _error("held range buffer is unavailable");
    }
    let loaded = 0; let failed = false;
    while loaded < count and not failed {
        let got = _call(fs, "pread", "i32,ptr,i64,i64->i64",
            [held.fd, buffer + loaded, count - loaded, offset + loaded]);
        if got <= 0 or got > count - loaded { failed = true; }
        else { loaded = loaded + got; }
    }
    let written = 0;
    while written < count and not failed {
        let n = _call(fs, "write", "i32,ptr,i64->i64",
            [snapshot, buffer + written, count - written]);
        if n <= 0 or n > count - written { failed = true; }
        else { written = written + n; }
    }
    _free(fs, buffer);
    if failed or _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]) != 0 {
        _close_fd(fs, snapshot); return _error("held range could not be copied completely");
    }
    let bytes = try fs_read_bytes(_fd_path(snapshot)) catch nil;
    _close_fd(fs, snapshot);
    if not is_array(bytes) or len(bytes) != count {
        return _error("held range could not be loaded consistently");
    }
    return map{ok:true,bytes:bytes,size:count,offset:offset,
        descriptor_bound:true,immutable_snapshot:true,path_reopened:false};
}

// Open, bound, and measure one exact executable object before handing that
// same descriptor to a child. The namespace path is never reopened after the
// digest check, so replacement of the directory entry cannot change what is
// executed.
fn verified_child_file_descriptor(fs, path, expected_sha256,
                                  max_bytes = 268435456, inheritable = true) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    if type(expected_sha256) != "string" or
       not regex_match(expected_sha256, "^[0-9a-f]{64}$") or
       type(max_bytes) != "number" or max_bytes != num_floor(max_bytes) or
       max_bytes < 1 or max_bytes > 268435456 or type(inheritable) != "bool" {
        return _error("invalid verified child descriptor policy");
    }
    let snapshot = sealed_snapshot_file_descriptor(fs, path, max_bytes);
    if not snapshot.ok { return snapshot; }
    let measured = held_base64_sha256(fs, snapshot, 0, snapshot.size);
    if not measured.ok or measured.sha256 != expected_sha256 {
        close_child_descriptor(fs, snapshot);
        return _error("verified child digest does not match policy");
    }
    let fd = snapshot.fd; let size = snapshot.size;
    if _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_DIR])) != 0
       or not _mode_verified(fs, fd, "700") {
        close_child_descriptor(fs, snapshot);
        return _error("verified child snapshot cannot be made executable");
    }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    let requested_flags = flags;
    if inheritable { requested_flags = flags - bit_and(flags, FD_CLOEXEC); }
    elif flags >= 0 and bit_and(flags, FD_CLOEXEC) == 0 {
        requested_flags = flags + FD_CLOEXEC;
    }
    if flags < 0 or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_SETFD, requested_flags])) != 0 {
        close_child_descriptor(fs, snapshot);
        return _error("verified child descriptor flags cannot be protected");
    }
    let verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if verified < 0 or (inheritable and bit_and(verified, FD_CLOEXEC) != 0) or
       (not inheritable and bit_and(verified, FD_CLOEXEC) == 0) {
        close_child_descriptor(fs, snapshot);
        return _error("verified child descriptor flag postcondition failed");
    }
    return map{ ok: true, format: "pblang.linux-dirfs.verified-child-descriptor.v1",
        fd: fd, owner_fd: fs.root_fd, active: true, inheritable: inheritable,
        cloexec: not inheritable,
        descriptor_bound: true, nofollow: true, path_reopened: false,
        path: path, size: size, sha256: expected_sha256,
        immutable: true, kernel_memory_backed: true, snapshot_before_digest: true,
        digest_encoding: "sha256(base64(bytes))", bounded_memory: true };
}

// Create one short-lived inheritable duplicate from a canonical CLOEXEC-held
// file descriptor. The duplicate shares the verified inode but has independent
// descriptor flags and ownership, so unrelated children cannot inherit the
// canonical descriptor.
fn duplicate_child_file_descriptor(fs, held) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true) or
       held == nil or not is_map(held) or not (try held.active catch false) or
       (try held.owner_fd catch -1) != (try fs.root_fd catch -2) or
       (try held.fd catch -1) < 0 or
       not map_has(try fs.child_fds catch map{}, str(try held.fd catch -1)) {
        return _error("held child descriptor is unavailable");
    }
    let fd = _i32(_call(fs, "dup", "i32->i32", [held.fd]));
    if fd < 0 { return _error("held child descriptor cannot be duplicated"); }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    let inheritable_flags = flags - bit_and(flags, FD_CLOEXEC);
    if flags < 0 or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_SETFD, inheritable_flags])) != 0 {
        _close_fd(fs, fd); return _error("child duplicate cannot be made inheritable");
    }
    let verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if verified < 0 or bit_and(verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, fd); return _error("child duplicate inheritance postcondition failed");
    }
    fs.child_fds[str(fd)] = true;
    return map{ ok: true, format: "pblang.linux-dirfs.child-file-duplicate.v1",
        fd: fd, owner_fd: fs.root_fd, active: true, inheritable: true,
        cloexec: false, descriptor_bound: true, duplicated_from: held.fd,
        size: try held.size catch nil, sha256: try held.sha256 catch nil };
}

// Publish caller-supplied bytes to one child as a kernel-backed immutable
// object. The descriptor is writable only while it is populated; all content
// and size mutations are then sealed and verified before FD_CLOEXEC is
// cleared. No mutable pathname exists in the filesystem namespace.
fn sealed_child_bytes(fs, name, bytes) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    if type(name) != "string" or len(name) < 1 or len(name) > 128
       or str_contains(name, strfromcharcode(0))
       or not regex_match(name, "^[A-Za-z0-9_.-]+$") {
        return _error("sealed child name must be a safe identifier");
    }
    if type(bytes) != "array" or len(bytes) > 67108864 {
        return _error("sealed child bytes must be an array up to 67108864 bytes");
    }
    for i len(bytes) {
        if type(bytes[i]) != "number" or bytes[i] != num_floor(bytes[i])
           or bytes[i] < 0 or bytes[i] > 255 {
            return _error("sealed child payload contains an invalid byte");
        }
    }
    let fd = _i32(_call(fs, "memfd_create", "string,i32->i32",
        [name, MFD_CLOEXEC + MFD_ALLOW_SEALING]));
    if fd < 0 { return _error("sealable kernel memory file is unavailable"); }
    let write_failed = try { fs_write_bytes(_fd_path(fd), bytes); false } catch true;
    if write_failed {
        _close_fd(fs, fd); return _error("sealed child payload cannot be populated");
    }
    if _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_FILE])) != 0
       or not _mode_verified(fs, fd, "600") {
        _close_fd(fs, fd); return _error("sealed child payload permissions cannot be protected");
    }
    let measured = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    if measured != len(bytes)
       or _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 0]) != 0 {
        _close_fd(fs, fd); return _error("sealed child payload size cannot be verified");
    }
    if _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_ADD_SEALS, IMMUTABLE_SEALS])) != 0 {
        _close_fd(fs, fd); return _error("kernel memory file cannot be sealed");
    }
    let seals = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GET_SEALS, 0]));
    if seals < 0 or bit_and(seals, IMMUTABLE_SEALS) != IMMUTABLE_SEALS {
        _close_fd(fs, fd); return _error("kernel memory file seal postcondition failed");
    }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if flags < 0 or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_SETFD, flags - bit_and(flags, FD_CLOEXEC)])) != 0 {
        _close_fd(fs, fd); return _error("sealed child descriptor cannot be made inheritable");
    }
    let verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if verified < 0 or bit_and(verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, fd); return _error("sealed child inheritance postcondition failed");
    }
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { _close_fd(fs, fd); return _error("process identity is unavailable"); }
    if not map_has(fs, "child_fds") or type(fs.child_fds) != "map" { fs.child_fds = map{}; }
    fs.child_fds[str(fd)] = true;
    return map{
        ok: true, format: "pblang.linux-dirfs.sealed-child-bytes.v1",
        fd: fd, owner_fd: fs.root_fd, active: true,
        path: _fd_path(fd), stable_path: "/proc/" + str(pid) + "/fd/" + str(fd),
        size: len(bytes), inheritable: true,
        descriptor_bound: true, kernel_memory_backed: true,
        immutable: true, write_sealed: true, grow_sealed: true,
        shrink_sealed: true, further_seals_locked: true, seals: seals,
        mode: "600", permission_private: true
    };
}

// Create an anonymous mutable snapshot for an in-process engine that insists
// on a writable file descriptor even when the caller uses it read-only. The
// object has no filesystem pathname and never aliases the source file. Unlike
// sealed_child_bytes, the consumer may mutate only this private copy.
fn mutable_snapshot_bytes(fs, name, bytes) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or (try fs.root_fd catch -1) < 0 {
        return _error("directory root is closed");
    }
    if type(name) != "string" or len(name) < 1 or len(name) > 128
       or str_contains(name, strfromcharcode(0))
       or not regex_match(name, "^[A-Za-z0-9_.-]+$") {
        return _error("mutable snapshot name must be a safe identifier");
    }
    if type(bytes) != "array" or len(bytes) > 67108864 {
        return _error("mutable snapshot bytes must be an array up to 67108864 bytes");
    }
    for i len(bytes) {
        if type(bytes[i]) != "number" or bytes[i] != num_floor(bytes[i])
           or bytes[i] < 0 or bytes[i] > 255 {
            return _error("mutable snapshot payload contains an invalid byte");
        }
    }
    let fd = _i32(_call(fs, "memfd_create", "string,i32->i32", [name, MFD_CLOEXEC]));
    if fd < 0 { return _error("anonymous mutable snapshot is unavailable"); }
    let write_failed = try { fs_write_bytes(_fd_path(fd), bytes); false } catch true;
    if write_failed {
        _close_fd(fs, fd); return _error("mutable snapshot cannot be populated");
    }
    if _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_FILE])) != 0
       or not _mode_verified(fs, fd, "600") {
        _close_fd(fs, fd); return _error("mutable snapshot permissions cannot be protected");
    }
    let measured = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    if measured != len(bytes)
       or _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 0]) != 0 {
        _close_fd(fs, fd); return _error("mutable snapshot size cannot be verified");
    }
    let flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if flags < 0 or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
        [fd, F_SETFD, flags - bit_and(flags, FD_CLOEXEC)])) != 0 {
        _close_fd(fs, fd); return _error("mutable snapshot cannot be made inheritable");
    }
    let inherited = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [fd, F_GETFD, 0]));
    if inherited < 0 or bit_and(inherited, FD_CLOEXEC) != 0 {
        _close_fd(fs, fd); return _error("mutable snapshot inheritance postcondition failed");
    }
    let pid = _i32(_call(fs, "getpid", "->i32", []));
    if pid <= 0 { _close_fd(fs, fd); return _error("process identity is unavailable"); }
    if not map_has(fs, "child_fds") or type(fs.child_fds) != "map" { fs.child_fds = map{}; }
    fs.child_fds[str(fd)] = true;
    return map{
        ok: true, format: "pblang.linux-dirfs.mutable-snapshot.v1",
        fd: fd, owner_fd: fs.root_fd, active: true, path: _fd_path(fd),
        stable_path: "/proc/" + str(pid) + "/fd/" + str(fd),
        size: len(bytes), descriptor_bound: true, kernel_memory_backed: true,
        anonymous: true, source_aliased: false, mutable_private_copy: true,
        inheritable: true, mode: "600", permission_private: true
    };
}

fn close_child_descriptor(fs, handoff) {
    if fs == nil or not is_map(fs) or (try fs.closed catch true)
       or handoff == nil or not is_map(handoff) or not (try handoff.active catch false)
       or (try handoff.owner_fd catch -1) != (try fs.root_fd catch -2)
       or (try handoff.fd catch -1) < 0
       or not map_has(try fs.child_fds catch map{}, str(try handoff.fd catch -1)) {
        return false;
    }
    let fd = handoff.fd;
    let closed_without_error = _close_fd(fs, fd);
    map_remove(fs.child_fds, str(fd));
    // Linux may release the descriptor even when close reports an error. Never
    // retry the same numeric fd after ownership has been consumed.
    handoff.active = false; handoff.fd = -1;
    handoff.close_attempted = true; handoff.close_reported_error = not closed_without_error;
    return closed_without_error;
}

fn _walk_dir(fs, parts, create) {
    if fs == nil or (try fs.closed catch true) { return _error("directory root is closed"); }
    let current = _i32(_call(fs, "dup", "i32->i32", [fs.root_fd]));
    if current < 0 { return _error("cannot duplicate root directory handle"); }
    let i = 0;
    while i < len(parts) {
        let next = _openat(fs, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        if next < 0 and create {
            _mkdirat(fs, current, parts[i], MODE_DIR);
            next = _openat(fs, current, parts[i], O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
        }
        _close_fd(fs, current);
        if next < 0 { return _error("path component is missing, not a directory, or a symbolic link"); }
        current = next; i = i + 1;
    }
    return map{ ok: true, fd: current };
}

fn _parent(fs, path, create) {
    let parts = _components(path, false); if parts == nil or len(parts) == 0 { return _error("a non-root path is required"); }
    let dirs = []; let i = 0;
    while i + 1 < len(parts) { array_push(dirs, parts[i]); i = i + 1; }
    let parent = _walk_dir(fs, dirs, create); if not parent.ok { return parent; }
    parent.name = parts[len(parts) - 1]; return parent;
}

fn mkdir(fs, path) {
    let parts = _components(path, false); if parts == nil or len(parts) == 0 { return _error("invalid directory path"); }
    let dir = _walk_dir(fs, parts, true); if not dir.ok { return dir; }
    _close_fd(fs, dir.fd); return map{ ok: true, path: path };
}

// Create the final directory component exactly once. Parent components may be
// created through the same no-follow walk, but an attacker-precreated final
// directory is a hard failure instead of being silently reused as staging.
fn mkdir_new(fs, path, create_parents = true) {
    let parent = _parent(fs, path, create_parents); if not parent.ok { return parent; }
    let made = _mkdirat(fs, parent.fd, parent.name, MODE_DIR);
    if made != 0 { _close_fd(fs, parent.fd); return _error("destination directory already exists or cannot be created exclusively"); }
    let fd = _openat(fs, parent.fd, parent.name,
        O_RDONLY + O_DIRECTORY + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd);
    if fd < 0 { return _error("exclusive directory cannot be reopened without following links"); }
    let protected = _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_DIR]));
    let verified = protected == 0 and _mode_verified(fs, fd, "700");
    _close_fd(fs, fd);
    return map{ ok: true, path: path, exclusive_create: true,
        descriptor_bound_parent: true, nofollow: true, requested_mode: MODE_DIR,
        permission_private: verified, permission_postcondition_verified: verified };
}

fn list(fs, path = "root", max_entries = 512) {
    let parts = _components(path, true); if parts == nil { return _error("invalid directory path"); }
    let dir = _walk_dir(fs, parts, false); if not dir.ok { return dir; }
    let entries = try fs_listdir(_fd_path(dir.fd)) catch nil; _close_fd(fs, dir.fd);
    if not is_array(entries) { return _error("path is not a readable directory"); }
    let limit = num_floor(max_entries); if limit < 1 { limit = 1; } if limit > 4096 { limit = 4096; }
    let out = []; let i = 0; while i < len(entries) and i < limit { array_push(out, entries[i]); i = i + 1; }
    return map{ ok: true, path: path, entries: out, truncated: len(entries) > limit };
}

fn read_bytes(fs, path, max_bytes = 4194304) {
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes)
        or max_bytes > 67108864 {
        return _error("invalid bounded read limit");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("file cannot be opened without following links"); }

    // fs_read_bytes has no length parameter. Reading the held source directly
    // would allocate the whole file before the post-read quota check. Copy at
    // most max_bytes+1 into an anonymous kernel file first; the VM can then
    // load only that bounded snapshot. This also remains bounded if another
    // process grows the source inode concurrently.
    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-bounded-read", MFD_CLOEXEC]));
    if snapshot < 0 { _close_fd(fs, fd); return _error("bounded snapshot is unavailable"); }
    let ceiling = max_bytes + 1; let copied = 0; let failed = false;
    while copied < ceiling and not failed {
        let count = _call(fs, "sendfile", "i32,i32,ptr,i64->i64",
            [snapshot, fd, 0, ceiling - copied]);
        if count < 0 { failed = true; }
        else if count == 0 { copied = ceiling; }
        else { copied = copied + count; }
    }
    _close_fd(fs, fd);
    if failed { _close_fd(fs, snapshot); return _error("bounded file snapshot failed"); }
    let snapshot_size = _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 2]);
    if snapshot_size < 0 { _close_fd(fs, snapshot); return _error("bounded snapshot size is unavailable"); }
    if snapshot_size > max_bytes {
        _close_fd(fs, snapshot); return _error("file exceeds byte limit");
    }
    _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]);
    let bytes = try fs_read_bytes(_fd_path(snapshot)) catch nil;
    _close_fd(fs, snapshot);
    if not is_array(bytes) { return _error("path is not a readable regular file"); }
    if len(bytes) != snapshot_size { return _error("bounded snapshot size changed"); }
    return map{ ok: true, path: path, bytes: bytes, size: len(bytes) };
}

// Snapshot at most max_bytes from a held regular-file descriptor. Unlike
// read_bytes, this operation intentionally succeeds for larger files and
// reports truncation. Size discovery and copying use the same descriptor, so
// replacing the path cannot make the size refer to a different inode.
fn read_prefix_bytes(fs, path, max_bytes = 1048576) {
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes)
        or max_bytes > 67108864 {
        return _error("invalid bounded prefix limit");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("file cannot be opened without following links"); }
    let source_info = _descriptor_metadata(fs, fd, path);
    if not source_info.ok or (try source_info.kind catch "") != "file" {
        _close_fd(fs, fd); return _error("path is not a descriptor-held regular file");
    }
    let source_size = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    if source_size < 0 { _close_fd(fs, fd); return _error("path is not a seekable regular file"); }
    if _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 0]) < 0 {
        _close_fd(fs, fd); return _error("regular file cannot be rewound");
    }

    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-prefix-read", MFD_CLOEXEC]));
    if snapshot < 0 { _close_fd(fs, fd); return _error("bounded prefix snapshot is unavailable"); }
    let ceiling = source_size;
    if ceiling > max_bytes { ceiling = max_bytes; }
    let copied = 0; let failed = false;
    while copied < ceiling and not failed {
        let count = _call(fs, "sendfile", "i32,i32,ptr,i64->i64",
            [snapshot, fd, 0, ceiling - copied]);
        if count < 0 { failed = true; }
        else if count == 0 { copied = ceiling; }
        else { copied = copied + count; }
    }
    _close_fd(fs, fd);
    if failed { _close_fd(fs, snapshot); return _error("bounded prefix snapshot failed"); }
    let snapshot_size = _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 2]);
    if snapshot_size < 0 or snapshot_size > max_bytes {
        _close_fd(fs, snapshot); return _error("bounded prefix snapshot size is invalid");
    }
    _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]);
    let bytes = try fs_read_bytes(_fd_path(snapshot)) catch nil;
    _close_fd(fs, snapshot);
    if not is_array(bytes) or len(bytes) != snapshot_size {
        return _error("bounded prefix snapshot cannot be loaded consistently");
    }
    return map{
        ok: true, path: path, bytes: bytes, size: len(bytes),
        source_size: source_size, truncated: source_size > len(bytes),
        kind: source_info.kind, mode: source_info.mode,
        descriptor_bound_metadata: true, race_resistant: true
    };
}

// Read one bounded byte range from a descriptor-held regular file. The source
// descriptor is opened once with O_NOFOLLOW, then used for size discovery,
// seeking, and copying. A large offset therefore does not allocate or scan the
// skipped prefix and path replacement cannot redirect the operation.
fn read_range_bytes(fs, path, offset, max_bytes = 65536) {
    if type(offset) != "number" or offset < 0 or offset != num_floor(offset)
        or offset > 9007199254740991 {
        return _error("invalid bounded range offset");
    }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes)
        or max_bytes > 67108864 {
        return _error("invalid bounded range limit");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("file cannot be opened without following links"); }
    let source_size = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    if source_size < 0 { _close_fd(fs, fd); return _error("path is not a seekable regular file"); }
    let start = offset; if start > source_size { start = source_size; }
    if _call(fs, "lseek", "i32,i64,i32->i64", [fd, start, 0]) < 0 {
        _close_fd(fs, fd); return _error("regular file range cannot be selected");
    }

    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-range-read", MFD_CLOEXEC]));
    if snapshot < 0 { _close_fd(fs, fd); return _error("bounded range snapshot is unavailable"); }
    let available = source_size - start;
    let ceiling = available; if ceiling > max_bytes { ceiling = max_bytes; }
    let copied = 0; let failed = false;
    while copied < ceiling and not failed {
        let count = _call(fs, "sendfile", "i32,i32,ptr,i64->i64",
            [snapshot, fd, 0, ceiling - copied]);
        if count < 0 { failed = true; }
        else if count == 0 { copied = ceiling; }
        else { copied = copied + count; }
    }
    _close_fd(fs, fd);
    if failed { _close_fd(fs, snapshot); return _error("bounded range snapshot failed"); }
    let snapshot_size = _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 2]);
    if snapshot_size < 0 or snapshot_size > max_bytes or snapshot_size > available {
        _close_fd(fs, snapshot); return _error("bounded range snapshot size is invalid");
    }
    _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]);
    let bytes = try fs_read_bytes(_fd_path(snapshot)) catch nil;
    _close_fd(fs, snapshot);
    if not is_array(bytes) or len(bytes) != snapshot_size {
        return _error("bounded range snapshot cannot be loaded consistently");
    }
    return map{
        ok: true, path: path, bytes: bytes, size: len(bytes),
        source_size: source_size, requested_offset: offset, offset: start,
        available_bytes: available, truncated: available > len(bytes),
        offset_past_end: offset > source_size, race_resistant: true
    };
}

// Bounded descriptor read for procfs and other non-seekable pseudo-files.
// Bytes flow from the held source FD into an anonymous memfd through one fixed
// native buffer. At most max_bytes+1 are copied, allowing exact truncation
// reporting without allocating the pseudo-file's unbounded logical content.
fn read_stream_bytes(fs, path, max_bytes = 1048576) {
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes)
        or max_bytes > 67108864 {
        return _error("invalid bounded stream limit");
    }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("stream cannot be opened without following links"); }
    let snapshot = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-bounded-stream", MFD_CLOEXEC]));
    if snapshot < 0 { _close_fd(fs, fd); return _error("bounded stream snapshot is unavailable"); }
    let chunk = 65536; let buffer = _call(fs, "calloc", "i64,i64->ptr", [1, chunk]);
    if buffer == nil or buffer == 0 {
        _close_fd(fs, snapshot); _close_fd(fs, fd); return _error("bounded stream buffer is unavailable");
    }
    let ceiling = max_bytes + 1; let copied = 0; let eof = false; let failed = false;
    while copied < ceiling and not eof and not failed {
        let wanted = ceiling - copied; if wanted > chunk { wanted = chunk; }
        let count = _call(fs, "read", "i32,ptr,i64->i64", [fd, buffer, wanted]);
        if count < 0 { failed = true; }
        elif count == 0 { eof = true; }
        else {
            let written = 0;
            while written < count and not failed {
                let n = _call(fs, "write", "i32,ptr,i64->i64",
                    [snapshot, buffer + written, count - written]);
                if n <= 0 { failed = true; } else { written = written + n; }
            }
            copied = copied + written;
        }
    }
    _free(fs, buffer); _close_fd(fs, fd);
    if failed { _close_fd(fs, snapshot); return _error("bounded stream snapshot failed"); }
    if _call(fs, "lseek", "i32,i64,i32->i64", [snapshot, 0, 0]) < 0 {
        _close_fd(fs, snapshot); return _error("bounded stream snapshot cannot be rewound");
    }
    let loaded = try fs_read_bytes(_fd_path(snapshot)) catch nil; _close_fd(fs, snapshot);
    if not is_array(loaded) or len(loaded) != copied {
        return _error("bounded stream snapshot cannot be loaded consistently");
    }
    let truncated = len(loaded) > max_bytes;
    let bytes = if truncated { slice(loaded, 0, max_bytes) } else { loaded };
    return map{ ok: true, path: path, bytes: bytes, size: len(bytes),
        truncated: truncated, descriptor_bound: true, bounded_stream: true,
        dynamic_source: true };
}

// Return the size of a held regular file without loading its contents. The
// final component is opened with O_NOFOLLOW relative to its held parent, and
// lseek operates on that descriptor, so path replacement cannot redirect the
// probe after validation. Directories and non-seekable special files fail.
fn file_size(fs, path) {
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("file cannot be opened without following links"); }
    let size = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    _close_fd(fs, fd);
    if size < 0 { return _error("path is not a seekable regular file"); }
    return map{ ok: true, path: path, size: size, race_resistant: true };
}

// Resolve a path component-by-component and obtain type, size and mtime from
// that same held object. The fixed-argv stat probe sees the parent's descriptor
// through /proc/<pid>/fd; no caller-controlled pathname reaches the subprocess.
fn metadata(fs, path) {
    let parts = _components(path, true); if parts == nil { return _error("invalid metadata path"); }
    let dir = _walk_dir(fs, parts, false);
    if dir.ok {
        let result = _descriptor_metadata(fs, dir.fd, path);
        _close_fd(fs, dir.fd); return result;
    }
    if len(parts) == 0 { return _error("root metadata cannot be resolved"); }
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("metadata target cannot be opened without following links"); }
    let result = _descriptor_metadata(fs, fd, path);
    _close_fd(fs, fd); return result;
}

fn protect_file(fs, path) {
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("file cannot be protected without following links"); }
    let protected = _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_FILE]));
    let verified = protected == 0 and _mode_verified(fs, fd, "600");
    _close_fd(fs, fd);
    if verified { return map{ ok: true, path: path, mode: MODE_FILE }; }
    return _error("file permissions cannot be protected and verified");
}

fn protect_executable(fs, path) {
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name, O_RDONLY + O_NONBLOCK + O_NOFOLLOW + O_CLOEXEC, 0);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("executable cannot be protected without following links"); }
    let protected = _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_DIR]));
    let verified = protected == 0 and _mode_verified(fs, fd, "700");
    _close_fd(fs, fd);
    if verified { return map{ ok: true, path: path, mode: MODE_DIR }; }
    return _error("executable permissions cannot be protected and verified");
}

fn _stage_name() { return ".pblang-stage-" + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 32); }

fn write_atomic(fs, path, bytes, create_parents = true) {
    if not is_array(bytes) { return _error("bytes must be an array"); }
    let parent = _parent(fs, path, create_parents); if not parent.ok { return parent; }
    let stage = _stage_name();
    let fd = _openat(fs, parent.fd, stage, O_WRONLY + O_CREAT + O_EXCL + O_NOFOLLOW + O_CLOEXEC, MODE_FILE);
    if fd < 0 { _close_fd(fs, parent.fd); return _error("cannot create an exclusive staging file"); }
    let write_failed = try { fs_write_bytes(_fd_path(fd), bytes); false } catch true;
    if write_failed {
        _close_fd(fs, fd); _unlinkat(fs, parent.fd, stage, 0);
        _close_fd(fs, parent.fd); return _error("cannot write staged bytes");
    }
    let file_synced = _i32(_call(fs, "fsync", "i32->i32", [fd])) == 0;
    let stage_closed = _close_fd(fs, fd);
    if type(file_synced) != "bool" or not file_synced {
        _unlinkat(fs, parent.fd, stage, 0);
        _close_fd(fs, parent.fd);
        return _error("cannot synchronize staged bytes");
    }
    if type(stage_closed) != "bool" or not stage_closed {
        _unlinkat(fs, parent.fd, stage, 0);
        _close_fd(fs, parent.fd);
        return _error("staging descriptor could not be closed");
    }
    let published = _renameat(fs, parent.fd, stage, parent.fd, parent.name);
    if published != 0 {
        _unlinkat(fs, parent.fd, stage, 0); _close_fd(fs, parent.fd);
        return _error("cannot publish staged file atomically");
    }
    let directory_synced = _i32(_call(fs, "fsync", "i32->i32", [parent.fd])) == 0;
    _close_fd(fs, parent.fd);
    if type(directory_synced) != "bool" or not directory_synced {
        return map{ok:false,error:"published file directory could not be synchronized",
            published:true,path:path,size:len(bytes),atomic:true,
            durability_verified:false};
    }
    return map{ok:true,path:path,size:len(bytes),atomic:true,
        fsync_before_publish:true,parent_fsync_after_publish:true,
        durability_verified:true};
}

// Append one UTF-8 byte batch while the caller holds any higher-level journal
// lock. The final file is opened with O_NOFOLLOW and its pre/post sizes are
// measured through that held descriptor, so the ceiling is a storage bound.
fn append_bytes_bounded(fs, path, bytes, max_bytes = 1048576, create_parents = true) {
    if not is_array(bytes) or type(max_bytes) != "number" or max_bytes < 1 or
       max_bytes != num_floor(max_bytes) or max_bytes > 67108864 {
        return _error("invalid bounded append arguments");
    }
    let text = try bytes_to_str(bytes) catch nil;
    if text == nil or len(str_to_bytes(text)) != len(bytes) {
        return _error("bounded append requires valid UTF-8 bytes");
    }
    let parent = _parent(fs, path, create_parents); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name,
        O_WRONLY + O_CREAT + O_NOFOLLOW + O_CLOEXEC, MODE_FILE);
    _close_fd(fs, parent.fd); if fd < 0 { return _error("append target cannot be opened without following links"); }
    let info = _descriptor_metadata(fs, fd, path);
    if not info.ok or (try info.kind catch "") != "file" {
        _close_fd(fs, fd); return _error("append target is not a regular file");
    }
    let before = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    if before < 0 or before + len(bytes) > max_bytes {
        _close_fd(fs, fd); return _error("append target would exceed its byte limit");
    }
    let protected = _i32(_call(fs, "fchmod", "i32,i32->i32", [fd, MODE_FILE]));
    if protected != 0 or not _mode_verified(fs, fd, "600") {
        _close_fd(fs, fd); return _error("append target permissions cannot be verified");
    }
    let write_failed = false;
    try { fs_append(_fd_path(fd), text); } catch { write_failed = true; }
    let after = _call(fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]);
    _close_fd(fs, fd);
    if write_failed or after != before + len(bytes) {
        return _error("bounded append did not publish the complete batch");
    }
    return map{ ok: true, path: path, appended_bytes: len(bytes),
        previous_size: before, size: after, mode: MODE_FILE,
        descriptor_bound: true, race_resistant: true };
}

// Create a destination exactly once without an exists-then-write race.
// O_EXCL makes namespace admission atomic and O_NOFOLLOW rejects a final
// symlink. Since the current four-argument typed FFI cannot call five-argument
// linkat/renameat2, readers may observe an in-progress write; expose that
// limitation instead of claiming atomic content visibility.
fn write_new_exclusive(fs, path, bytes, create_parents = true) {
    if not is_array(bytes) { return _error("bytes must be an array"); }
    let parent = _parent(fs, path, create_parents); if not parent.ok { return parent; }
    let fd = _openat(fs, parent.fd, parent.name,
        O_WRONLY + O_CREAT + O_EXCL + O_NOFOLLOW + O_CLOEXEC, MODE_FILE);
    if fd < 0 { _close_fd(fs, parent.fd); return _error("destination already exists or cannot be created exclusively"); }
    let write_failed = try { fs_write_bytes(_fd_path(fd), bytes); false } catch true;
    _close_fd(fs, fd);
    if write_failed { _unlinkat(fs, parent.fd, parent.name, 0); }
    _close_fd(fs, parent.fd);
    if write_failed { return _error("exclusive destination write failed and was removed"); }
    return map{ ok: true, path: path, size: len(bytes), no_replace: true,
                exclusive_create: true, descriptor_bound_parent: true,
                atomic_namespace_admission: true, atomic_visibility: false };
}

fn _rename_noreplace_parents(fs, source_fd, source_name, dest_fd, dest_name) {
    if not _rename_noreplace_x64_cache.known {
        let machine = try proc_spawn_wait("/usr/bin/uname", ["-m"]) catch nil;
        _rename_noreplace_x64_cache.supported = machine != nil and machine.exit_code == 0
            and (str_trim(machine.stdout) == "x86_64" or str_trim(machine.stdout) == "amd64");
        _rename_noreplace_x64_cache.known = true;
    }
    if not _rename_noreplace_x64_cache.supported {
        return _error("atomic no-replace rename currently requires Linux x86-64");
    }
    let source_child = _i32(_call(fs, "dup", "i32->i32", [source_fd]));
    let dest_child = _i32(_call(fs, "dup", "i32->i32", [dest_fd]));
    if source_child < 0 or dest_child < 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("rename parent descriptors cannot be duplicated");
    }
    let source_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [source_child, F_GETFD, 0]));
    let dest_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [dest_child, F_GETFD, 0]));
    let inheritance_failed = source_flags < 0 or dest_flags < 0
        or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [source_child, F_SETFD, source_flags - bit_and(source_flags, FD_CLOEXEC)])) != 0
        or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [dest_child, F_SETFD, dest_flags - bit_and(dest_flags, FD_CLOEXEC)])) != 0;
    let source_verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [source_child, F_GETFD, 0]));
    let dest_verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [dest_child, F_GETFD, 0]));
    if inheritance_failed or source_verified < 0 or dest_verified < 0
       or bit_and(source_verified, FD_CLOEXEC) != 0
       or bit_and(dest_verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("rename parent descriptors cannot be made inheritable");
    }
    let helper_bytes = try RENAME_NOREPLACE.build(source_child, source_name,
        dest_child, dest_name) catch nil;
    if helper_bytes == nil {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("atomic no-replace helper cannot be generated");
    }
    let helper_fd = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-rename-noreplace", MFD_CLOEXEC + MFD_ALLOW_SEALING]));
    if helper_fd < 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("atomic no-replace helper memfd is unavailable");
    }
    let prepared = (try { fs_write_bytes(_fd_path(helper_fd), helper_bytes); true } catch false)
        and _i32(_call(fs, "fchmod", "i32,i32->i32", [helper_fd, MODE_DIR])) == 0
        and _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [helper_fd, F_ADD_SEALS, IMMUTABLE_SEALS])) == 0;
    let helper_seals = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GET_SEALS, 0]));
    let helper_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GETFD, 0]));
    let executable = prepared and helper_seals >= 0
        and bit_and(helper_seals, IMMUTABLE_SEALS) == IMMUTABLE_SEALS
        and helper_flags >= 0
        and _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [helper_fd, F_SETFD, helper_flags - bit_and(helper_flags, FD_CLOEXEC)])) == 0;
    let executable_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GETFD, 0]));
    if executable_flags < 0 or bit_and(executable_flags, FD_CLOEXEC) != 0 { executable = false; }
    let result = nil;
    if executable { result = try proc_spawn_wait(_fd_path(helper_fd), []) catch nil; }
    _close_fd(fs, helper_fd); _close_fd(fs, source_child); _close_fd(fs, dest_child);
    if result == nil or result.exit_code != 0 {
        return _error("destination already exists or atomic no-replace rename failed");
    }
    return map{ ok: true, atomic: true, no_replace: true,
        descriptor_bound_parents: true, generated_pblang_syscall_helper: true,
        helper_sealed_before_execution: true };
}

fn _link_held_tmpfile_noreplace(fs, source_fd, dest_fd, dest_name) {
    if not _linkat_empty_x64_cache.known {
        let machine = try proc_spawn_wait("/usr/bin/uname", ["-m"]) catch nil;
        _linkat_empty_x64_cache.supported = machine != nil and machine.exit_code == 0
            and (str_trim(machine.stdout) == "x86_64" or str_trim(machine.stdout) == "amd64");
        _linkat_empty_x64_cache.known = true;
    }
    if not _linkat_empty_x64_cache.supported {
        return _error("exact-inode publication currently requires Linux x86-64");
    }
    let source_child = _i32(_call(fs, "dup", "i32->i32", [source_fd]));
    let dest_child = _i32(_call(fs, "dup", "i32->i32", [dest_fd]));
    if source_child < 0 or dest_child < 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("publication descriptors cannot be duplicated");
    }
    let source_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [source_child, F_GETFD, 0]));
    let dest_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [dest_child, F_GETFD, 0]));
    let inheritance_failed = source_flags < 0 or dest_flags < 0
        or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [source_child, F_SETFD, source_flags - bit_and(source_flags, FD_CLOEXEC)])) != 0
        or _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [dest_child, F_SETFD, dest_flags - bit_and(dest_flags, FD_CLOEXEC)])) != 0;
    let source_verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [source_child, F_GETFD, 0]));
    let dest_verified = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [dest_child, F_GETFD, 0]));
    if inheritance_failed or source_verified < 0 or dest_verified < 0
       or bit_and(source_verified, FD_CLOEXEC) != 0
       or bit_and(dest_verified, FD_CLOEXEC) != 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("publication descriptors cannot be made inheritable");
    }
    let helper_bytes = try LINKAT_HELD.build(source_child, dest_child, dest_name) catch nil;
    if helper_bytes == nil {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("exact-inode publication helper cannot be generated");
    }
    let helper_fd = _i32(_call(fs, "memfd_create", "string,i32->i32",
        ["pblang-linkat-empty", MFD_CLOEXEC + MFD_ALLOW_SEALING]));
    if helper_fd < 0 {
        _close_fd(fs, source_child); _close_fd(fs, dest_child);
        return _error("exact-inode publication helper memfd is unavailable");
    }
    let prepared = (try { fs_write_bytes(_fd_path(helper_fd), helper_bytes); true } catch false)
        and _i32(_call(fs, "fchmod", "i32,i32->i32", [helper_fd, MODE_DIR])) == 0
        and _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [helper_fd, F_ADD_SEALS, IMMUTABLE_SEALS])) == 0;
    let helper_seals = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GET_SEALS, 0]));
    let helper_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GETFD, 0]));
    let executable = prepared and helper_seals >= 0
        and bit_and(helper_seals, IMMUTABLE_SEALS) == IMMUTABLE_SEALS
        and helper_flags >= 0
        and _i32(_call(fs, "fcntl", "i32,i32,i32->i32",
            [helper_fd, F_SETFD, helper_flags - bit_and(helper_flags, FD_CLOEXEC)])) == 0;
    let executable_flags = _i32(_call(fs, "fcntl", "i32,i32,i32->i32", [helper_fd, F_GETFD, 0]));
    if executable_flags < 0 or bit_and(executable_flags, FD_CLOEXEC) != 0 { executable = false; }
    let result = nil;
    if executable { result = try proc_spawn_wait(_fd_path(helper_fd), []) catch nil; }
    _close_fd(fs, helper_fd); _close_fd(fs, source_child); _close_fd(fs, dest_child);
    if result == nil or result.exit_code != 0 {
        return _error("destination exists or exact-inode publication failed");
    }
    return map{ ok: true, atomic: true, no_replace: true,
        exact_held_inode: true, anonymous_source: true,
        descriptor_bound_parent: true, generated_pblang_syscall_helper: true,
        helper_sealed_before_execution: true };
}

// Publish complete bytes atomically while retaining no-replace semantics.
// A private exclusive stage is fully populated first, then renameat2 commits
// it only if the final name is absent. No reader can observe partial content.
fn write_new_atomic(fs, path, bytes, create_parents = true) {
    if not is_array(bytes) { return _error("bytes must be an array"); }
    let parent = _parent(fs, path, create_parents); if not parent.ok { return parent; }
    let stage = _stage_name();
    let fd = _openat(fs, parent.fd, stage,
        O_WRONLY + O_CREAT + O_EXCL + O_NOFOLLOW + O_CLOEXEC, MODE_FILE);
    if fd < 0 { _close_fd(fs, parent.fd); return _error("cannot create an exclusive atomic-new stage"); }
    let write_failed = try { fs_write_bytes(_fd_path(fd), bytes); false } catch true;
    if write_failed {
        _close_fd(fs, fd);
        _unlinkat(fs, parent.fd, stage, 0); _close_fd(fs, parent.fd);
        return _error("cannot populate atomic-new stage");
    }
    let file_synced = _i32(_call(fs, "fsync", "i32->i32", [fd])) == 0;
    let stage_closed = _close_fd(fs, fd);
    if not file_synced or not stage_closed {
        _unlinkat(fs, parent.fd, stage, 0); _close_fd(fs, parent.fd);
        return _error("cannot synchronize and close atomic-new stage");
    }
    let published = _rename_noreplace_parents(fs, parent.fd, stage, parent.fd, parent.name);
    if published.ok {
        let directory_synced = _i32(_call(fs, "fsync", "i32->i32", [parent.fd])) == 0;
        let parent_closed = _close_fd(fs, parent.fd);
        if not directory_synced or not parent_closed {
            return map{ ok: false, error: "published atomic-new directory could not be synchronized",
                published: true, retry_safe: false, path: path, size: len(bytes),
                atomic: true, atomic_visibility: true, durability_verified: false };
        }
        return map{
            ok: true, path: path, size: len(bytes), no_replace: true,
            atomic: true, atomic_visibility: true, exclusive_stage: true,
            descriptor_bound_parent: true, generated_pblang_syscall_helper: true,
            fsync_before_publish: true, parent_fsync_after_publish: true,
            durability_verified: true
        };
    } else {
        _unlinkat(fs, parent.fd, stage, 0); _close_fd(fs, parent.fd);
        return _error("destination exists or atomic-new publication failed");
    }
}

// Copy one authenticated range from an immutable held snapshot into an
// anonymous O_TMPFILE inode, then link that exact held inode into the namespace
// only when the destination is absent. No mutable stage name and no PBLang
// binary array exist anywhere in the publication path.
fn copy_held_range_new_atomic(source_fs, held, dest_fs, path, offset, count,
                              create_parents = true, executable = false) {
    if not _held_file_valid(source_fs, held) or not (try held.immutable catch false)
       or dest_fs == nil or not is_map(dest_fs) or (try dest_fs.closed catch true)
       or type(offset) != "number" or offset != num_floor(offset) or offset < 0
       or type(count) != "number" or count != num_floor(count)
       or count < 1 or count > 268435456 or offset > held.size
       or count > held.size - offset or type(executable) != "bool" {
        return _error("invalid immutable range publication request");
    }
    let parent = _parent(dest_fs, path, create_parents); if not parent.ok { return parent; }
    let fd = _openat(dest_fs, parent.fd, ".",
        O_WRONLY + O_TMPFILE + O_CLOEXEC, MODE_FILE);
    if fd < 0 {
        _close_fd(dest_fs, parent.fd);
        return _error("anonymous O_TMPFILE range publication is unavailable");
    }
    let chunk = 65536;
    let buffer = _call(dest_fs, "calloc", "i64,i64->ptr", [1, chunk]);
    let copied = 0; let failed = buffer == nil or buffer == 0;
    while copied < count and not failed {
        let wanted = count - copied; if wanted > chunk { wanted = chunk; }
        let loaded = 0;
        while loaded < wanted and not failed {
            let got = _call(dest_fs, "pread", "i32,ptr,i64,i64->i64",
                [held.fd, buffer + loaded, wanted - loaded, offset + copied + loaded]);
            if got <= 0 or got > wanted - loaded { failed = true; }
            else { loaded = loaded + got; }
        }
        let written = 0;
        while written < wanted and not failed {
            let n = _call(dest_fs, "write", "i32,ptr,i64->i64",
                [fd, buffer + written, wanted - written]);
            if n <= 0 or n > wanted - written { failed = true; }
            else { written = written + n; }
        }
        if not failed { copied = copied + wanted; }
    }
    _free(dest_fs, buffer);
    let requested_mode = if executable { MODE_DIR } else { MODE_FILE };
    let expected_mode = if executable { "700" } else { "600" };
    if failed or copied != count {
        _close_fd(dest_fs, fd);
        _close_fd(dest_fs, parent.fd);
        return _error("immutable anonymous range inode could not be populated completely");
    }
    if _i32(_call(dest_fs, "fchmod", "i32,i32->i32", [fd, requested_mode])) != 0
       or not _mode_verified(dest_fs, fd, expected_mode) {
        _close_fd(dest_fs, fd); _close_fd(dest_fs, parent.fd);
        return _error("immutable anonymous range inode mode could not be verified");
    }
    if _call(dest_fs, "lseek", "i32,i64,i32->i64", [fd, 0, 2]) != count {
        _close_fd(dest_fs, fd); _close_fd(dest_fs, parent.fd);
        return _error("immutable anonymous range inode size could not be verified");
    }
    if _i32(_call(dest_fs, "fsync", "i32->i32", [fd])) != 0 {
        _close_fd(dest_fs, fd); _close_fd(dest_fs, parent.fd);
        return _error("immutable anonymous range inode could not be synchronized");
    }
    // Keep the anonymous source inode held until linkat(AT_EMPTY_PATH) has
    // admitted that exact object into the destination namespace.
    let published = _link_held_tmpfile_noreplace(dest_fs, fd, parent.fd, parent.name);
    if type(published) != "map" or not published.ok {
        _close_fd(dest_fs, fd); _close_fd(dest_fs, parent.fd);
        return _error("destination exists or immutable range publication failed");
    }
    let directory_synced = _i32(_call(dest_fs, "fsync", "i32->i32", [parent.fd])) == 0;
    if not _close_fd(dest_fs, fd) {
        _close_fd(dest_fs, parent.fd);
        return _error("published anonymous range inode could not be closed");
    }
    _close_fd(dest_fs, parent.fd);
    if type(directory_synced) != "bool" or not directory_synced {
        return map{ok:false,error:"published range directory could not be synchronized",
            published:true,path:path,size:count,durability_verified:false};
    }
    return map{ok:true,path:path,size:count,source_offset:offset,no_replace:true,
        atomic:true,atomic_visibility:true,anonymous_stage:true,
        exact_inode_publication:true,
        descriptor_bound_source:true,descriptor_bound_parent:true,
        immutable_source:true,bounded_memory:true,chunk_bytes:chunk,
        executable:executable,mode:expected_mode,fsync_before_publish:true,
        parent_fsync_after_publish:true,durability_verified:true};
}

fn remove(fs, path) {
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let rc = _unlinkat(fs, parent.fd, parent.name, 0);
    if rc != 0 { rc = _unlinkat(fs, parent.fd, parent.name, AT_REMOVEDIR); }
    let parent_closed = _close_fd(fs, parent.fd);
    if rc == 0 and parent_closed { return map{ ok: true, path: path }; }
    return _error("file or empty directory removal could not be fully verified");
}

// Remove a non-directory entry only. Unlike remove(), this never retries with
// AT_REMOVEDIR, so a file-only caller cannot erase an empty directory after a
// namespace replacement. Symlink targets are never followed.
fn remove_file(fs, path) {
    let parent = _parent(fs, path, false); if not parent.ok { return parent; }
    let rc = _unlinkat(fs, parent.fd, parent.name, 0);
    let parent_closed = _close_fd(fs, parent.fd);
    if rc == 0 and parent_closed {
        return map{ ok: true, path: path, directory_removal: false,
                    descriptor_bound_parent: true, symlink_target_followed: false };
    }
    return _error("file entry removal could not be fully verified");
}

fn move(fs, from, to, create_parents = true) {
    let source = _parent(fs, from, false); if not source.ok { return source; }
    let dest = _parent(fs, to, create_parents);
    if not dest.ok { _close_fd(fs, source.fd); return dest; }
    let rc = _renameat(fs, source.fd, source.name, dest.fd, dest.name);
    _close_fd(fs, source.fd); _close_fd(fs, dest.fd);
    if rc != 0 { return _error("confined rename failed"); }
    return map{ ok: true, from: from, to: to, atomic: true };
}

// Atomically move one namespace entry only when the destination is absent.
// Linux renameat2 takes five arguments, beyond the current typed-FFI limit, so
// PBLang emits a tiny static x86-64 syscall ELF and executes it from a sealed
// memfd. Both parent directories are already held and are inherited only for
// this synchronous helper invocation.
fn move_new_exclusive(fs, from, to, create_parents = true) {
    let source = _parent(fs, from, false); if not source.ok { return source; }
    let dest = _parent(fs, to, create_parents);
    if not dest.ok { _close_fd(fs, source.fd); return dest; }
    let result = _rename_noreplace_parents(fs, source.fd, source.name, dest.fd, dest.name);
    _close_fd(fs, source.fd); _close_fd(fs, dest.fd);
    if not result.ok { return result; }
    result.from = from; result.to = to;
    return result;
}

fn status(fs) {
    return map{ format: "pblang.linux-dirfs.status.v1", available: fs != nil and not (try fs.closed catch true),
                component_openat: true, nofollow: true, cloexec: true, stable_proc_fd_io: true,
                atomic_renameat: true, exclusive_no_replace_openat: true,
                atomic_renameat2_noreplace_x86_64: true,
                atomic_no_replace_content_publication_x86_64: true,
                bounded_memfd_snapshot_reads: true,
                bounded_prefix_snapshot_reads: true,
                bounded_range_snapshot_reads: true,
                immutable_sealed_file_snapshots: true,
                streaming_base64_sha256_ranges: true,
                atomic_immutable_range_publication: true,
                anonymous_exact_inode_publication_x86_64: true,
                private_root_owner_mode_verification: true,
                descriptor_metadata: true,
                verified_child_descriptor_handoff: true,
                inherited_directory_adoption: true,
                sealed_immutable_child_handoff: true,
                anonymous_mutable_snapshot: true,
                anonymous_mutable_child_handoff: true,
                bounded_descriptor_locks: true,
                relative_root_component_walk: true,
                mkdir_race_reopen: true, permission_postcondition_verified: true,
                libc: try fs.libc_path catch nil };
}

export available, open, open_absolute, open_current_process_net, close, descriptor_path, private_root_status, child_descriptor,
       adopt_inherited_directory,
       child_file_descriptor, sealed_snapshot_file_descriptor,
       held_base64_sha256, held_magic_offsets, read_held_range_bytes,
       verified_child_file_descriptor,
       duplicate_child_file_descriptor,
       sealed_child_bytes, mutable_snapshot_bytes, close_child_descriptor,
       acquire_lock, release_lock,
       mkdir, mkdir_new, list,
       read_bytes, read_prefix_bytes, read_range_bytes, read_stream_bytes, file_size, metadata,
       protect_file, protect_executable, write_atomic, append_bytes_bounded,
       write_new_exclusive, write_new_atomic, copy_held_range_new_atomic,
       remove, remove_file, move, move_new_exclusive, status;
