// Explicit implementation selection for retained and replacement code.
// No imports, probes, native loads, retries or fallback occur in this module.
// Selection is local policy, not authorization or a sandbox.

// bind validates once and returns the selected callable without invoking it.
// The callable is captured by value; later replacement of the registry entry
// does not change this selection. Its own captured state remains its own.
fn bind(enabled, selected, factories) {
    if type(enabled) != "bool" { throw "implementation enablement must be boolean"; }
    if not enabled { throw "implementation disabled"; }
    if type(selected) != "string" or len(selected) < 1 or len(selected) > 64 {
        throw "invalid implementation selection";
    }
    let index = 0;
    while index < len(selected) {
        let ch = strcharcodeat(selected, index);
        if not ((ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95) {
            throw "invalid implementation selection";
        }
        index = index + 1;
    }
    if type(factories) != "map" or not map_has(factories, selected) {
        throw "selected implementation unavailable";
    }
    let factory = factories[selected];
    let kind = type(factory);
    if kind != "closure" and kind != "function" and kind != "builtin" {
        throw "selected implementation must be a lazy factory";
    }
    return factory;
}

// Compatibility entry point: select and invoke a zero-argument constructor.
// A constructor failure propagates unchanged, with no second invocation.
fn open(enabled, selected, factories) {
    let factory = bind(enabled, selected, factories);
    return factory();
}

export bind, open;
