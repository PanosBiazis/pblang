// stdlib/polyglot/index.sapp — Unified Sovereign Polyglot Block Runtime,
// C Header FFI Auto-Binder, Language Metadata Inspector & Security Auditor (PBLang v4.2.0)
//
// Unifies compiler-extracted @lang polyglot blocks (__polyglot / __polyglot_blocks from
// zr_compiler.h & zr_loader.h: @c, @sql, @python, @js, @wgsl, @glsl, @qasm, @html, etc.)
// with stdlib:polyglot_universal.sapp (in-memory pure-PBLang execution across 150+ languages)
// and stdlib:polyglot_ecosystem_bridge.sapp (C header ABI parser + argv-isolated IPC).

let Universal = import("stdlib:polyglot_universal.sapp");
let Bridge = import("stdlib:polyglot_ecosystem_bridge.sapp");
let CorePolyglot = import("stdlib:polyglot.sapp");

let POLYGLOT_NAMESPACE_VERSION = "4.2.0";
let FORMAT = "pblang.polyglot.namespace.v4.2";

fn _err(msg) {
    throw "polyglot/index: " + str(msg);
}

fn _opt(m, k, fb) {
    if m == nil or not is_map(m) { return fb; }
    if not map_has(m, k) { return fb; }
    let v = m[k];
    if v == nil { return fb; }
    return v;
}

// Normalizes __polyglot ({ blocks, by_name, by_lang }), __polyglot_blocks ([...]),
// a { name -> block } map, or a single block map into a uniform array of block maps.
fn _normalize_blocks_collection(blocks_source) {
    if blocks_source == nil { return []; }
    if is_array(blocks_source) { return blocks_source; }
    if is_map(blocks_source) {
        if map_has(blocks_source, "blocks") and is_array(blocks_source.blocks) {
            return blocks_source.blocks;
        }
        if map_has(blocks_source, "lang") and map_has(blocks_source, "code") {
            return [blocks_source];
        }
        if map_has(blocks_source, "by_name") and is_map(blocks_source.by_name) {
            let ks = map_keys(blocks_source.by_name);
            let out = [];
            let i = 0;
            while i < len(ks) {
                array_push(out, blocks_source.by_name[ks[i]]);
                i = i + 1;
            }
            return out;
        }
        let ks2 = map_keys(blocks_source);
        let out2 = [];
        let j = 0;
        while j < len(ks2) {
            let entry = blocks_source[ks2[j]];
            if is_map(entry) and map_has(entry, "code") {
                array_push(out2, entry);
            }
            j = j + 1;
        }
        return out2;
    }
    return [];
}

fn _resolve_target_block(block_or_name, opts) {
    if is_map(block_or_name) and map_has(block_or_name, "lang") and map_has(block_or_name, "code") {
        return block_or_name;
    }
    if is_string(block_or_name) {
        let pool = _opt(opts, "polyglot", _opt(opts, "blocks", nil));
        if is_map(pool) and map_has(pool, "by_name") and is_map(pool.by_name) {
            if map_has(pool.by_name, block_or_name) {
                return pool.by_name[block_or_name];
            }
        }
        let list = _normalize_blocks_collection(pool);
        let i = 0;
        while i < len(list) {
            if str(_opt(list[i], "name", "")) == block_or_name {
                return list[i];
            }
            i = i + 1;
        }
    }
    return nil;
}

// ============================================================================
// 1. Embedded Polyglot Block Inspector (`inspect_polyglot_blocks`)
// ============================================================================

fn inspect_polyglot_blocks(blocks_map) {
    let list = _normalize_blocks_collection(blocks_map);
    let entries = [];
    let by_lang_counts = map{};
    let native_count = 0;
    let c_ffi_count = 0;
    let ipc_count = 0;

    let i = 0;
    while i < len(list) {
        let blk = list[i];
        let raw_lang = str(_opt(blk, "lang", "unknown"));
        let canon = Universal.canonical_id(raw_lang);
        let desc = Universal.describe_language(raw_lang);
        let is_nat = is_map(desc) and _opt(desc, "native_engine", false) == true;
        let code_str = str(_opt(blk, "code", ""));
        let bname = str(_opt(blk, "name", "block_" + str(i)));
        let lines_arr = str_split(code_str, "\n");

        let exec_tier = "isolated_argv_ipc";
        if canon == "c" or raw_lang == "c_header" or raw_lang == "h" {
            exec_tier = "c_header_ffi_binder";
            c_ffi_count = c_ffi_count + 1;
        } elif is_nat {
            exec_tier = "pure_pblang_native";
            native_count = native_count + 1;
        } else {
            ipc_count = ipc_count + 1;
        }

        let prev_cnt = if map_has(by_lang_counts, canon) { by_lang_counts[canon] } else { 0 };
        by_lang_counts[canon] = prev_cnt + 1;

        array_push(entries, map{
            index: i,
            name: bname,
            raw_lang: raw_lang,
            canonical_lang: canon,
            era: if is_map(desc) { _opt(desc, "era", "custom") } else { "custom" },
            kind: if is_map(desc) { _opt(desc, "kind", "unknown") } else { "unknown" },
            execution_tier: exec_tier,
            native_engine: is_nat,
            line: _opt(blk, "line", 0),
            line_count: len(lines_arr),
            byte_length: len(str_to_bytes(code_str)),
            sha256: sha256(code_str),
            attrs: _opt(blk, "attrs", map{})
        });
        i = i + 1;
    }

    return map{
        ok: true,
        format: FORMAT + ".inspection",
        block_count: len(entries),
        pure_native_count: native_count,
        c_ffi_bindable_count: c_ffi_count,
        isolated_ipc_count: ipc_count,
        language_counts: by_lang_counts,
        blocks: entries
    };
}

// ============================================================================
// 2. Polyglot Block Security Auditor (`polyglot_security_audit`)
// ============================================================================

fn _audit_single_block(blk, idx) {
    let findings = [];
    let bname = str(_opt(blk, "name", "block_" + str(idx)));
    let lang = Universal.canonical_id(_opt(blk, "lang", ""));
    let code = str(_opt(blk, "code", ""));
    let low = str_lower(code);

    // 1. Shell injection & arbitrary command execution sinks
    if str_contains(low, "os.system(") or str_contains(low, "shell=true")
        or str_contains(low, "child_process.exec(") or str_contains(low, "/bin/sh -c")
        or str_contains(low, "cmd.exe /c") or str_contains(low, "popen(") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "critical",
            category: "shell_injection",
            detail: "Detected shell-spawning command execution sink inside polyglot block"
        });
    }
    if (lang == "c" or lang == "cpp") and regex_match(code, "(^|[^a-zA-Z0-9_])system\\s*\\(") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "critical",
            category: "shell_injection",
            detail: "Detected C libc system() shell invocation"
        });
    }

    // 2. Hardcoded secrets, private keys & cloud bearer credentials
    if str_contains(code, "BEGIN PRIVATE KEY") or str_contains(code, "BEGIN RSA PRIVATE KEY")
        or str_contains(code, "BEGIN OPENSSH PRIVATE KEY") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "critical",
            category: "hardcoded_secret",
            detail: "Embedded PEM/OpenSSH private key block detected"
        });
    }
    if regex_match(code, "AKIA[0-9A-Z]{16}") or str_contains(code, "ghp_") or str_contains(code, "sk_live_") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "critical",
            category: "hardcoded_secret",
            detail: "Hardcoded cloud/API secret token prefix detected"
        });
    }
    if regex_match(low, "(api_key|secret_key|password)\\s*[:=]\\s*[\"'][^\"']{8,}[\"']") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "high",
            category: "hardcoded_secret",
            detail: "Suspicious hardcoded credential literal assignment"
        });
    }

    // 3. Unsafe raw syscalls / ptrace / memory corruption primitives
    if str_contains(low, "ptrace(") or regex_match(low, "__asm__.*syscall") or str_contains(low, "asm volatile(\"syscall\"") {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "high",
            category: "unsafe_syscall",
            detail: "Direct kernel syscall or ptrace invocation detected"
        });
    }
    if (lang == "c" or lang == "cpp") and (str_contains(code, "gets(") or str_contains(code, "strcpy(")) {
        array_push(findings, map{
            block: bname,
            lang: lang,
            severity: "medium",
            category: "memory_safety",
            detail: "Unbounded C string write (gets/strcpy) detected; prefer bounded lengths"
        });
    }

    return findings;
}

fn polyglot_security_audit(blocks_map, opts = nil) {
    let list = _normalize_blocks_collection(blocks_map);
    let all_findings = [];
    let sev = map{ critical: 0, high: 0, medium: 0, low: 0 };

    let i = 0;
    while i < len(list) {
        let bf = _audit_single_block(list[i], i);
        let j = 0;
        while j < len(bf) {
            let item = bf[j];
            array_push(all_findings, item);
            let s = item.severity;
            if map_has(sev, s) { sev[s] = sev[s] + 1; }
            j = j + 1;
        }
        i = i + 1;
    }

    let passed = (sev.critical == 0 and sev.high == 0);
    return map{
        ok: passed,
        safe: len(all_findings) == 0,
        format: FORMAT + ".security_audit",
        audited_blocks: len(list),
        finding_count: len(all_findings),
        severity_counts: sev,
        findings: all_findings
    };
}

// ============================================================================
// 3. Automatic @c Polyglot Block Header Parser & Dynamic FFI Binder
// ============================================================================

// Converts C function definitions (e.g. `double add(double a, double b) { return a + b; }`)
// into clean header prototypes (`double add(double a, double b);`) so Bridge.parse_c_header
// handles both pure header declarations and inline C block definitions seamlessly!
fn _extract_c_prototypes_and_decls(c_code) {
    let out = "";
    let depth = 0;
    let in_str = false;
    let n = len(c_code);
    let i = 0;
    let saw_paren_at_top = false;

    while i < n {
        let ch = str_slice(c_code, i, i + 1);
        if in_str {
            if depth == 0 { out = out + ch; }
            if ch == "\\" and i + 1 < n {
                if depth == 0 { out = out + str_slice(c_code, i + 1, i + 2); }
                i = i + 2;
            } else {
                if ch == "\"" { in_str = false; }
                i = i + 1;
            }
        } else {
            if ch == "\"" {
                in_str = true;
                if depth == 0 { out = out + ch; }
                i = i + 1;
            } elif ch == "(" and depth == 0 {
                saw_paren_at_top = true;
                out = out + ch;
                i = i + 1;
            } elif ch == ";" and depth == 0 {
                saw_paren_at_top = false;
                out = out + ch;
                i = i + 1;
            } elif ch == "{" {
                if depth == 0 and saw_paren_at_top {
                    // Function body opening brace -> replace body with `;` prototype terminator!
                    out = out + ";";
                    depth = 1;
                    saw_paren_at_top = false;
                    i = i + 1;
                } elif depth == 0 {
                    // struct / enum body: preserve!
                    out = out + ch;
                    i = i + 1;
                } else {
                    depth = depth + 1;
                    i = i + 1;
                }
            } elif ch == "}" {
                if depth > 0 {
                    depth = depth - 1;
                } else {
                    out = out + ch;
                }
                i = i + 1;
            } else {
                if depth == 0 { out = out + ch; }
                i = i + 1;
            }
        }
    }
    return out;
}

fn bind_c_polyglot_block(block_or_name, opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let blk = _resolve_target_block(block_or_name, o);
    if blk == nil {
        _err("bind_c_polyglot_block could not resolve @c polyglot block");
    }
    let header_norm = _extract_c_prototypes_and_decls(str(_opt(blk, "code", "")));
    let parsed_abi = Bridge.parse_c_header(header_norm);
    let lib_spec = _opt(o, "library", nil);

    if lib_spec == nil or _opt(o, "dry_run", false) == true {
        return map{
            ok: true,
            bound_live: false,
            block_name: _opt(blk, "name", ""),
            header: parsed_abi,
            functions: parsed_abi.functions,
            structs: parsed_abi.structs,
            constants: parsed_abi.constants
        };
    }

    let bound_mod = Bridge.bind_c_header_library(lib_spec, header_norm);
    bound_mod._block_name = _opt(blk, "name", "");
    bound_mod.ok = true;
    bound_mod.bound_live = true;
    return bound_mod;
}

// ============================================================================
// 4. Unified `@lang` Polyglot Block Runner (`run_polyglot_block`)
// ============================================================================

fn run_polyglot_block(block_or_name, input = nil, opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let blk = _resolve_target_block(block_or_name, o);
    if blk == nil {
        return map{ ok: false, error: "polyglot block not found: " + str(block_or_name) };
    }

    // Pre-execution security gate (enabled by default!)
    if _opt(o, "audit", true) == true {
        let audit = polyglot_security_audit([blk]);
        if not audit.ok and _opt(o, "allow_unsafe_audit", false) != true {
            return map{
                ok: false,
                blocked_by_security_audit: true,
                error: "polyglot_security_audit blocked execution due to critical/high findings",
                audit: audit
            };
        }
    }

    let raw_lang = str(_opt(blk, "lang", ""));
    let canon = Universal.canonical_id(raw_lang);
    let code = str(_opt(blk, "code", ""));
    let desc = Universal.describe_language(raw_lang);

    // Tier 1: Pure-PBLang In-Engine Sovereign Evaluation (SQL, WGSL, GLSL, OpenQASM, HTML, JSON, LISP, Forth, Pascal, etc.)
    if is_map(desc) and _opt(desc, "native_engine", false) == true {
        let nat_res = Universal.eval_native(raw_lang, code, input);
        if is_map(nat_res) {
            nat_res.execution_mode = "pure_pblang_native";
            nat_res.block_name = _opt(blk, "name", "");
            nat_res.canonical_lang = canon;
        }
        return nat_res;
    }

    // Tier 2: @c block -> parse C ABI & optionally bind shared library
    if canon == "c" {
        return bind_c_polyglot_block(blk, o);
    }

    // Tier 3: Structured Shell-Free argv-Isolated IPC for @python & @javascript/@js
    if canon == "python" {
        let py_res = Bridge.python_invoke(str_trim(code), input, o);
        py_res.execution_mode = "argv_isolated_python_ipc";
        py_res.block_name = _opt(blk, "name", "");
        py_res.canonical_lang = canon;
        return py_res;
    }
    if canon == "javascript" {
        let js_res = Bridge.node_invoke(str_trim(code), input, o);
        js_res.execution_mode = "argv_isolated_node_ipc";
        js_res.block_name = _opt(blk, "name", "");
        js_res.canonical_lang = canon;
        return js_res;
    }

    return map{
        ok: false,
        canonical_lang: canon,
        block_name: _opt(blk, "name", ""),
        error: "external host execution for '" + canon + "' requires explicit polyglot_registry authorization"
    };
}

fn polyglot_namespace_manifest() {
    let summary = Universal.catalog_summary();
    return map{
        ok: true,
        namespace: "stdlib:polyglot",
        version: POLYGLOT_NAMESPACE_VERSION,
        universal_catalog: summary,
        bridge_manifest: Bridge.bridge_architecture_manifest()
    };
}

fn eval_native_code(lang, code, input = nil) {
    return Universal.eval_native(lang, code, input);
}

export POLYGLOT_NAMESPACE_VERSION, FORMAT;
export Universal, Bridge, CorePolyglot;
export polyglot_namespace_manifest;
export inspect_polyglot_blocks, polyglot_security_audit;
export bind_c_polyglot_block, run_polyglot_block;
export eval_native_code;
