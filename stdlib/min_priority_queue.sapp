//! A mutable binary min-priority queue implemented entirely in pblang.
//!
//! Values may have any pblang type; priorities must be finite numbers. Equal
//! priorities have unspecified order. `push` and `pop` are O(log n), `peek` is
//! O(1), and the backing array remains encapsulated by the queue map.

fn new() { return map{heap: []}; }
fn size(queue) { return len(queue.heap); }
fn is_empty(queue) { return len(queue.heap) == 0; }

fn _valid_priority(priority) {
    // Finite numbers multiplied by zero produce zero. NaN and infinities do not.
    return is_number(priority) and priority * 0 == 0;
}

fn push(queue, value, priority) {
    if not _valid_priority(priority) { throw "min_priority_queue.push: priority must be a finite number"; }
    let heap = queue.heap;
    array_push(heap, map{value: value, priority: priority});
    let i = len(heap) - 1;
    while i > 0 {
        let parent = num_floor((i - 1) / 2);
        if heap[parent].priority <= heap[i].priority { break; }
        let tmp = heap[parent];
        heap[parent] = heap[i];
        heap[i] = tmp;
        i = parent;
    }
    return len(heap);
}

fn peek(queue) {
    if len(queue.heap) == 0 { return nil; }
    return queue.heap[0];
}

fn pop(queue) {
    let heap = queue.heap;
    if len(heap) == 0 { return nil; }
    let root = heap[0];
    let last = array_pop(heap);
    if len(heap) > 0 {
        heap[0] = last;
        let i = 0;
        while i < len(heap) {
            let left = i * 2 + 1;
            if left >= len(heap) { break; }
            let right = left + 1;
            let best = left;
            if right < len(heap) and heap[right].priority < heap[left].priority { best = right; }
            if heap[i].priority <= heap[best].priority { break; }
            let tmp = heap[i];
            heap[i] = heap[best];
            heap[best] = tmp;
            i = best;
        }
    }
    return root;
}

fn clear(queue) {
    queue.heap = [];
    return queue;
}

export new;
export size;
export is_empty;
export push;
export peek;
export pop;
export clear;
