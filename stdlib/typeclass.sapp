// stdlib/typeclass.sapp - Haskell/Rust-style ad-hoc polymorphism for pblang.
//
// This is a runtime typeclass registry: a typeclass names required operations,
// implementations are selected by predicates, and generic code dispatches
// through call/call1/call2/call3. Optional laws make behavioral contracts
// executable in tests.

fn define(name, required_methods = nil) {
    if required_methods == nil { required_methods = []; }
    return map{
        __typeclass: true,
        name: name,
        required: required_methods,
        instances: [],
        laws: [],
    };
}

fn _method_missing(methods, required) {
    for i len(required) {
        if map_has(methods, required[i]) == false {
            return required[i];
        }
        if is_fn(methods[required[i]]) == false {
            return required[i];
        }
    }
    return nil;
}

fn instance_where(tc, label, pred, methods) {
    let missing = _method_missing(methods, tc.required);
    if missing != nil {
        throw "typeclass " + tc.name + " instance '" + label + "' missing method '" + missing + "'";
    }
    array_push(tc.instances, map{
        label: label,
        pred: pred,
        methods: methods,
    });
    return tc;
}

fn instance_for_type(tc, type_name, methods) {
    return instance_where(tc, type_name, fn(x) { return type(x) == type_name; }, methods);
}

fn instance_for_interface(tc, label, iface_pred, methods) {
    return instance_where(tc, label, fn(x) { return iface_pred(x); }, methods);
}

fn instance_for_class(tc, class_name, methods) {
    return instance_where(tc, class_name, fn(x) {
        return type(x) == "map" and (try x.__class_name catch nil) == class_name;
    }, methods);
}

fn instance_for(tc, value) {
    for i len(tc.instances) {
        let inst = tc.instances[i];
        let ok = try inst.pred(value) catch false;
        if ok { return inst; }
    }
    return nil;
}

fn implements(tc, value) {
    return instance_for(tc, value) != nil;
}

fn assert_implements(tc, value) {
    if implements(tc, value) == false {
        throw "typeclass " + tc.name + " has no instance for " + type(value);
    }
    return value;
}

fn method(tc, value, method_name) {
    let inst = instance_for(tc, value);
    if inst == nil {
        throw "typeclass " + tc.name + " has no instance for " + type(value);
    }
    let m = try inst.methods[method_name] catch nil;
    if m == nil {
        throw "typeclass " + tc.name + " instance '" + inst.label + "' has no method '" + method_name + "'";
    }
    return m;
}

fn call(tc, method_name, value) {
    return method(tc, value, method_name)(value);
}

fn call1(tc, method_name, value, a1) {
    return method(tc, value, method_name)(value, a1);
}

fn call2(tc, method_name, value, a1, a2) {
    return method(tc, value, method_name)(value, a1, a2);
}

fn call3(tc, method_name, value, a1, a2, a3) {
    return method(tc, value, method_name)(value, a1, a2, a3);
}

fn law(tc, name, law_fn) {
    array_push(tc.laws, map{ name: name, check: law_fn });
    return tc;
}

fn check_laws(tc, samples) {
    let failures = [];
    for i len(tc.laws) {
        let l = tc.laws[i];
        for j len(samples) {
            let sample = samples[j];
            if implements(tc, sample) {
                let ok = try l.check(tc, sample, samples) catch false;
                if ok == false {
                    array_push(failures, map{ law: l.name, sample: sample });
                }
            }
        }
    }
    return map{
        ok: len(failures) == 0,
        failures: failures,
    };
}

fn instance_labels(tc) {
    let out = [];
    for i len(tc.instances) {
        array_push(out, tc.instances[i].label);
    }
    return out;
}

fn _str_cmp(a, b) {
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i n {
        let ca = strcharcodeat(a, i);
        let cb = strcharcodeat(b, i);
        if ca < cb { return -1; }
        if ca > cb { return 1; }
    }
    if len(a) < len(b) { return -1; }
    if len(a) > len(b) { return 1; }
    return 0;
}

fn Show() {
    let tc = define("Show", ["show"]);
    instance_for_type(tc, "number", map{ show: fn(x) { return str(x); } });
    instance_for_type(tc, "string", map{ show: fn(x) { return x; } });
    instance_for_type(tc, "bool", map{ show: fn(x) { return str(x); } });
    instance_for_type(tc, "nil", map{ show: fn(x) { return "nil"; } });
    return tc;
}

fn Eq() {
    let tc = define("Eq", ["eq"]);
    instance_for_type(tc, "number", map{ eq: fn(a, b) { return a == b; } });
    instance_for_type(tc, "string", map{ eq: fn(a, b) { return a == b; } });
    instance_for_type(tc, "bool", map{ eq: fn(a, b) { return a == b; } });
    law(tc, "reflexive", fn(EqTc, x, samples) {
        return call1(EqTc, "eq", x, x);
    });
    law(tc, "symmetric", fn(EqTc, x, samples) {
        for i len(samples) {
            let y = samples[i];
            if implements(EqTc, y) {
                if call1(EqTc, "eq", x, y) != call1(EqTc, "eq", y, x) {
                    return false;
                }
            }
        }
        return true;
    });
    return tc;
}

fn Ord() {
    let tc = define("Ord", ["cmp"]);
    instance_for_type(tc, "number", map{
        cmp: fn(a, b) {
            if a < b { return -1; }
            if a > b { return 1; }
            return 0;
        }
    });
    instance_for_type(tc, "string", map{
        cmp: fn(a, b) {
            return _str_cmp(a, b);
        }
    });
    return tc;
}

fn Semigroup() {
    let tc = define("Semigroup", ["concat"]);
    instance_for_type(tc, "string", map{ concat: fn(a, b) { return a + b; } });
    instance_for_type(tc, "array", map{
        concat: fn(a, b) {
            let out = [];
            for i len(a) { array_push(out, a[i]); }
            for i len(b) { array_push(out, b[i]); }
            return out;
        }
    });
    return tc;
}

fn Monoid() {
    let tc = define("Monoid", ["empty", "concat"]);
    instance_for_type(tc, "string", map{
        empty: fn(x) { return ""; },
        concat: fn(a, b) { return a + b; },
    });
    instance_for_type(tc, "array", map{
        empty: fn(x) { return []; },
        concat: fn(a, b) {
            let out = [];
            for i len(a) { array_push(out, a[i]); }
            for i len(b) { array_push(out, b[i]); }
            return out;
        },
    });
    return tc;
}

export define, instance_where, instance_for_type, instance_for_interface, instance_for_class;
export instance_for, implements, assert_implements, method;
export call, call1, call2, call3, law, check_laws, instance_labels;
export Show, Eq, Ord, Semigroup, Monoid;
