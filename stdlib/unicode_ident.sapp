// stdlib/unicode_ident.sapp — UAX#31-style identifier classification for pblang.
//
// This is the reusable POLICY CORE for Unicode identifiers, written in pblang. It
// does not itself change the language grammar (identifiers are still lexed by the
// Rust `text::ident()`, which is ASCII-only); rather it is the classifier that a
// future lexer change — either the Rust lexer or the self-hosted
// `stdlib/compiler/tokenizer.sapp` — would consult to decide which codepoints may
// start/continue an identifier.
//
// Policy (matches the mainstream UAX#31 stance used by Rust/Python/Go):
//   * Unicode LETTERS (Latin incl. accents, Greek, Cyrillic, Armenian, Hebrew,
//     Arabic, Devanagari, Hiragana, Katakana, Hangul, CJK) are valid identifier
//     characters.
//   * '_' may start an identifier; digits and combining marks may continue one.
//   * EMOJI are NOT identifier characters by default (they are not letters). They
//     can be opted in (Swift-style) via the `allow_emoji` flag on
//     is_valid_identifier — off by default.
//
// Coverage note: this is a pragmatic subset of the (very large) full XID tables —
// the major letter scripts people actually write code in. Extend the ranges below
// as needed; the contract (letters yes, emoji no-by-default) is the stable part.

fn _in(cp, lo, hi) { return cp >= lo and cp <= hi; }

// Major emoji / pictograph blocks. Kept deliberately separate from letters so the
// identifier policy can include or exclude them explicitly.
fn is_emoji(cp) {
    return _in(cp, 0x1F300, 0x1FAFF)   // Misc Symbols & Pictographs .. Symbols Extended-A
        or _in(cp, 0x1F000, 0x1F0FF)   // Mahjong / Dominoes / Playing Cards
        or _in(cp, 0x1F1E6, 0x1F1FF)   // Regional indicator symbols (flags)
        or _in(cp, 0x2600, 0x27BF)     // Misc Symbols + Dingbats
        or _in(cp, 0x2B00, 0x2BFF)     // Misc Symbols & Arrows (stars, etc.)
        or cp == 0x203C or cp == 0x2049;  // ‼ ⁉
}

// Codepoints permitted to START an identifier: '_' plus Unicode letters.
fn is_xid_start(cp) {
    if cp == 0x5F { return true; }                 // '_'
    if _in(cp, 0x41, 0x5A) or _in(cp, 0x61, 0x7A) { return true; } // ASCII A-Z a-z
    // Latin-1 + Latin Extended letters
    if cp == 0xAA or cp == 0xB5 or cp == 0xBA { return true; }
    if _in(cp, 0xC0, 0xD6) or _in(cp, 0xD8, 0xF6) or _in(cp, 0xF8, 0x2FF) { return true; }
    if _in(cp, 0x1E00, 0x1EFF) { return true; }    // Latin Extended Additional
    // Greek, Cyrillic, Armenian, Hebrew, Arabic letters
    if _in(cp, 0x370, 0x3FF) { return true; }      // Greek & Coptic
    if _in(cp, 0x400, 0x4FF) { return true; }      // Cyrillic
    if _in(cp, 0x531, 0x556) or _in(cp, 0x561, 0x586) { return true; } // Armenian
    if _in(cp, 0x5D0, 0x5EA) { return true; }      // Hebrew letters
    if _in(cp, 0x620, 0x64A) or _in(cp, 0x66E, 0x6D3) { return true; } // Arabic letters
    if _in(cp, 0x904, 0x939) { return true; }      // Devanagari
    // CJK & Japanese & Korean
    if _in(cp, 0x3041, 0x3096) { return true; }    // Hiragana
    if _in(cp, 0x30A1, 0x30FA) { return true; }    // Katakana
    if _in(cp, 0x4E00, 0x9FFF) { return true; }    // CJK Unified Ideographs
    if _in(cp, 0x3400, 0x4DBF) { return true; }    // CJK Extension A
    if _in(cp, 0xAC00, 0xD7A3) { return true; }    // Hangul Syllables
    return false;
}

// Codepoints permitted to CONTINUE an identifier: everything that can start one,
// plus ASCII digits and combining marks.
fn is_xid_continue(cp) {
    if is_xid_start(cp) { return true; }
    if _in(cp, 0x30, 0x39) { return true; }        // ASCII digits 0-9
    if _in(cp, 0x300, 0x36F) { return true; }      // Combining Diacritical Marks
    if _in(cp, 0x1DC0, 0x1DFF) { return true; }    // Combining marks supplement
    return false;
}

// True if `s` is a valid identifier under the policy above. `allow_emoji` (default
// false) opts into Swift-style emoji identifiers.
fn is_valid_identifier(s, allow_emoji = false) {
    let n = len(s);
    if n == 0 { return false; }
    let c0 = strcharcodeat(s, 0);
    let start_ok = is_xid_start(c0) or (allow_emoji and is_emoji(c0));
    if not start_ok { return false; }
    let i = 1;
    while i < n {
        let c = strcharcodeat(s, i);
        let cont_ok = is_xid_continue(c) or (allow_emoji and is_emoji(c));
        if not cont_ok { return false; }
        i = i + 1;
    }
    return true;
}

export is_emoji, is_xid_start, is_xid_continue, is_valid_identifier;
