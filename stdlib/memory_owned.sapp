// Optional scalar-owner callback cleanup for retained and PBLang VMs.
// Import only when needed; ordinary memory.sapp users do not load these helpers.
// Callbacks are trusted, synchronous and must keep scalar values/replacements.
// Public numeric handles/raw builtins do not provide callback isolation.

// Run one callback with a checked borrow-lifetime boundary. Depth checks avoid
// popping the caller's scope after an unbalanced callback; token equality detects
// replacement of our scope. Mismatched scopes are reported, never auto-repaired.
fn _box_callback(handle, body_fn) {
    let depth = memory_stats().lifetime_depth;
    let token = push_lifetime();
    let outcome = try [true, body_fn(handle), false] catch [false, nil, false];
    let scope_ok = false;
    if memory_stats().lifetime_depth == depth + 1 {
        let popped = try pop_lifetime() catch 0;
        scope_ok = popped == token and memory_stats().lifetime_depth == depth;
    }
    outcome[2] = scope_ok;
    return outcome;
}

fn _free_box(handle) { memory_free(handle); return true; }

fn _with_box_state(value, mutable, body_fn) {
    // Match the self-host engine's scalar-only contract. Native composite alias
    // bookkeeping is not yet transactional; this helper does not certify it.
    let kind = type(value);
    if kind != "number" and kind != "string" and kind != "bool" and kind != "nil" {
        return [false, false, true, nil, "memory: owned callbacks require scalar values"];
    }
    // Keep the owner outside the borrow scope; free it after scoped borrows close.
    let handle = try memory_alloc(value, mutable) catch 0;
    if handle == 0 { return [false, false, true, nil, "memory: allocation failed"]; }
    let body = try _box_callback(handle, body_fn) catch [false, nil, false];
    let freed = try _free_box(handle) catch false;
    let clean = body[2] and freed;
    if not clean {
        return [true, body[0], false, nil, "memory: owned callback cleanup failed"];
    }
    if not body[0] { return [true, false, true, nil, "memory: owned callback failed"]; }
    return [true, true, true, body[1], nil];
}

// Opt-in automatic cleanup of exactly this helper's owner. The callback receives
// its handle; arbitrary allocations made by the callback remain its responsibility.
// Private tuple: allocation_ok, body_ok, cleanup_ok, value, error. Avoid public
// result maps for the throwing API; result APIs still expose named fields.
fn _result(state) {
    return map{ok:state[0] and state[1] and state[2], value:state[3], error:state[4],
        allocation_ok:state[0], body_ok:state[1], cleanup_ok:state[2]};
}
fn with_box_result(value, body_fn) { return _result(_with_box_state(value, true, body_fn)); }
fn with_box_immutable_result(value, body_fn) { return _result(_with_box_state(value, false, body_fn)); }
fn with_box(value, body_fn) {
    let state = _with_box_state(value, true, body_fn);
    if not (state[0] and state[1] and state[2]) { throw state[4]; }
    return state[3];
}
fn with_box_immutable(value, body_fn) {
    let state = _with_box_state(value, false, body_fn);
    if not (state[0] and state[1] and state[2]) { throw state[4]; }
    return state[3];
}

export with_box, with_box_result, with_box_immutable, with_box_immutable_result;
