let File=import("stdlib:secure_file.sapp");
let Subs=import("stdlib:subtitles.sapp");
fn _path(path,extension) {
    return type(path)=="string" and len(path)>len(extension) and len(path)<=4096
        and len(str_to_bytes(path))<=4096 and str_ends_with(str_lower(path),extension);
}
fn open(path) {
    if not _path(path,".srt") { return map{ok:false,error:"Choose an .srt path."}; }
    let read=try File.read_text(path,Subs.MAX_INPUT_BYTES,false) catch nil;
    if read==nil or not read.ok { return map{ok:false,error:"Could not read subtitles."}; }
    let doc=try Subs.parse_srt(read.text) catch nil;
    if doc==nil { return map{ok:false,error:"Invalid SRT or supported limits exceeded."}; }
    return map{ok:true,document:doc};
}
fn save(path,doc,format="srt") {
    if (format!="srt" and format!="vtt") or not _path(path,"."+format) { return map{ok:false,error:"Choose a new path matching the export format."}; }
    let text=try (if format=="srt" {Subs.to_srt(doc)} else {Subs.to_vtt(doc)}) catch nil;
    if text==nil { return map{ok:false,error:"Invalid subtitles; nothing written."}; }
    let result=try File.write_text_new_exclusive(path,text,false,false) catch nil;
    if result==nil or not result.ok { return map{ok:false,error:"Save not confirmed. Use a new filename in an existing folder; failed copies may be incomplete."}; }
    return map{ok:true,format:format,atomic_visibility:false};
}
export open,save;
