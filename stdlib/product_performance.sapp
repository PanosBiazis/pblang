// stdlib/product_performance.sapp -- shared pblang performance contracts.
//
// Products can supply measured baseline/candidate maps without coupling health
// collection to a benchmark runner. Missing or malformed samples fail closed;
// an omitted sample performs only a deterministic contract-engine self-check.

let BUDGET = import("stdlib:performance_budget.sapp");

fn standard_budgets() {
    return [
        map{ metric: "latency_ms", max_regression_percent: 5, lower_is_better: true },
        map{ metric: "memory_bytes", max_regression_percent: 5, lower_is_better: true },
        map{ metric: "artifact_bytes", max_regression_percent: 5, lower_is_better: true },
        map{ metric: "throughput_per_second", max_regression_percent: 5, lower_is_better: false }
    ];
}

fn evaluate(product, baseline, candidate, budgets, options = nil) {
    if options == nil { options = map{}; }
    let name = str(product);
    if str_trim(name) == "" { throw "product_performance.evaluate: product is required"; }
    let result = BUDGET.evaluate(baseline, candidate, budgets);
    return map{
        format: "pblang.product_performance.v1", product: name,
        status: if result.ok { "ready" } else { "blocked" }, ok: result.ok,
        sampled: try options.sampled catch true,
        baseline: baseline, candidate: candidate, budgets: budgets,
        checks: result.checks, failures: result.failures,
        source: str(try options.source catch "caller-measured"),
        policy: "all configured performance budgets must pass; missing metrics fail closed"
    };
}

fn self_check(product) {
    let baseline = map{ latency_ms: 1, memory_bytes: 1, artifact_bytes: 1, throughput_per_second: 1 };
    return evaluate(product, baseline, baseline, standard_budgets(), map{ sampled: false, source: "contract-self-check" });
}

fn resolve(product, sample = nil) {
    if sample == nil { return self_check(product); }
    if not is_map(sample) {
        return map{ format: "pblang.product_performance.v1", product: str(product), status: "blocked", ok: false, sampled: true, checks: [], failures: ["invalid-sample"], source: "caller-measured", policy: "invalid samples fail closed" };
    }
    return evaluate(product, try sample.baseline catch nil, try sample.candidate catch nil,
        try sample.budgets catch [], map{ sampled: true, source: try sample.source catch "caller-measured" });
}

fn summary(result) {
    let r = try result catch map{};
    return str(try r.product catch "unknown") + " performance=" + str(try r.status catch "blocked")
        + " sampled=" + str(try r.sampled catch false) + " checks=" + str(len(try r.checks catch []))
        + " failures=" + str(len(try r.failures catch []));
}

fn health_check(name, result, required = false) {
    let r = try result catch map{};
    return map{
        name: str(name), status: if try r.ok catch false { "ready" } else { "blocked" },
        detail: summary(r), required: required == true, category: "performance",
        evidence: if try r.sampled catch false { try r.failures catch [] } else { ["contract-self-check"] }
    };
}

fn suite(results) {
    if results == nil { results = []; }
    if len(results) > 128 { throw "product_performance.suite: at most 128 results are allowed"; }
    let passed = 0; let failed = 0; let sampled = 0; let i = 0;
    while i < len(results) {
        if (try results[i].format catch "") != "pblang.product_performance.v1" { throw "product_performance.suite: invalid result"; }
        if try results[i].ok catch false { passed = passed + 1; } else { failed = failed + 1; }
        if try results[i].sampled catch false { sampled = sampled + 1; }
        i = i + 1;
    }
    return map{ format: "pblang.product_performance.suite.v1", ok: failed == 0, passed: passed, failed: failed, sampled: sampled, results: results };
}

export standard_budgets, evaluate, self_check, resolve, summary, health_check, suite;
