// Writer document review. Exact block kind/text, explicit title comparison; no merge.
let Doc=import("stdlib:text_document.sapp");let Compare=import("stdlib:document_compare.sapp");let S=import("stdlib:serialization.sapp");
fn compare(before,after) {
 let result=Compare.compare(before,after);let rows=[];
 for item in result.entries {if item.kind!="title" {let operation="equal";if item.kind=="insert" {operation="add";}if item.kind=="delete" {operation="remove";}array_push(rows,map{operation:operation,before:item.left,after:item.right,kind:item.block.kind,text:item.block.text});}}
 return map{format:"pblang.document-review.v1",before_title:before.title,after_title:after.title,title_changed:result.title_changed,added:result.inserted,removed:result.deleted,unchanged:result.equal,rows:rows,contains_document_text:true,merged:false};
}
fn changed_blocks(before,after) {let report=compare(before,after);let indices=[];for row in report.rows {if row.operation=="add" {array_push(indices,row.after);}}return map{report:report,indices:indices};}
fn summary(before,after) {let r=compare(before,after);let title="Title unchanged";if r.title_changed {title="Title changed";}return title+" | +"+str(r.added)+" blocks / -"+str(r.removed)+" blocks | "+str(r.unchanged)+" unchanged";}
fn entries(before,after) {let report=compare(before,after);let out=[];if report.title_changed {array_push(out,map{label:"Title before",text:report.before_title});array_push(out,map{label:"Title after",text:report.after_title});}for row in report.rows {if row.operation!="equal" {let position=row.after;let side="New";if row.operation=="remove" {position=row.before;side="Old";}array_push(out,map{label:row.operation+" | "+side+" block "+str(position+1)+" | "+row.kind,text:row.text});}}if len(out)==0 {array_push(out,map{label:"No changes",text:"Both supported documents are identical."});}return out;}
fn encode(before,after) {let result=S.stringify_safe(compare(before,after),"json",map{max_output_bytes:524288,max_depth:5,max_items:4096,strict:true});if not result.ok {throw "review encoding failed";}return result.value;}
export compare,changed_blocks,summary,entries,encode;
