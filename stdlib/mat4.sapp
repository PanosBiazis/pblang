// stdlib/mat4.sapp — 4x4 matrix math for 3D (the transform2d analog, one dimension up).
//
// Model transforms (translate/scale/rotate), a view matrix (look_at), and projection
// (perspective/ortho) — the Model-View-Projection a GPU 3D pipeline (gpu3d.sapp) multiplies
// each vertex by. Storage is a flat 16-float list, ROW-major (m[row*4+col]); to_f32 emits
// COLUMN-major for GPU upload (wgpu/OpenGL convention). Pure + deterministic.

let MA = import("stdlib:math.sapp");   // sin/cos/tan/PI

fn deg(d) { return d * MA.PI / 180.0; }

fn zero() {
    let m = [];
    let i = 0;
    while i < 16 { array_push(m, 0.0); i = i + 1; }
    return m;
}
fn identity() {
    let m = zero();
    m[0] = 1.0; m[5] = 1.0; m[10] = 1.0; m[15] = 1.0;
    return m;
}
fn translate(tx, ty, tz) {
    let m = identity();
    m[3] = tx * 1.0; m[7] = ty * 1.0; m[11] = tz * 1.0;
    return m;
}
fn scale(sx, sy, sz) {
    let m = identity();
    m[0] = sx * 1.0; m[5] = sy * 1.0; m[10] = sz * 1.0;
    return m;
}
fn rotate_x(rad) {
    let m = identity();
    let c = MA.cos(rad);
    let s = MA.sin(rad);
    m[5] = c; m[6] = 0.0 - s; m[9] = s; m[10] = c;
    return m;
}
fn rotate_y(rad) {
    let m = identity();
    let c = MA.cos(rad);
    let s = MA.sin(rad);
    m[0] = c; m[2] = s; m[8] = 0.0 - s; m[10] = c;
    return m;
}
fn rotate_z(rad) {
    let m = identity();
    let c = MA.cos(rad);
    let s = MA.sin(rad);
    m[0] = c; m[1] = 0.0 - s; m[4] = s; m[5] = c;
    return m;
}

// multiply(A, B) = A*B (row-major).
fn multiply(A, B) {
    let C = zero();
    let i = 0;
    while i < 4 {
        let j = 0;
        while j < 4 {
            let sum = 0.0;
            let k = 0;
            while k < 4 { sum = sum + A[i * 4 + k] * B[k * 4 + j]; k = k + 1; }
            C[i * 4 + j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }
    return C;
}

// transform(m, x, y, z, w) -> {x,y,z,w}.
fn transform(m, x, y, z, w) {
    return map{
        x: m[0] * x + m[1] * y + m[2] * z + m[3] * w,
        y: m[4] * x + m[5] * y + m[6] * z + m[7] * w,
        z: m[8] * x + m[9] * y + m[10] * z + m[11] * w,
        w: m[12] * x + m[13] * y + m[14] * z + m[15] * w
    };
}

// ortho(l, r, b, t, n, f) — orthographic projection to NDC.
fn ortho(l, r, b, t, n, f) {
    let m = zero();
    m[0] = 2.0 / (r - l); m[3] = 0.0 - (r + l) / (r - l);
    m[5] = 2.0 / (t - b); m[7] = 0.0 - (t + b) / (t - b);
    m[10] = 0.0 - 2.0 / (f - n); m[11] = 0.0 - (f + n) / (f - n);
    m[15] = 1.0;
    return m;
}

// perspective(fovy_rad, aspect, near, far) — a right-handed perspective; w' = -z.
fn perspective(fovy, aspect, near, far) {
    let fx = 1.0 / MA.tan(fovy / 2.0);
    let m = zero();
    m[0] = fx / aspect;
    m[5] = fx;
    m[10] = (far + near) / (near - far);
    m[11] = (2.0 * far * near) / (near - far);
    m[14] = 0.0 - 1.0;
    return m;
}

fn _sub(a, b) { return map{ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }; }
fn _norm(v) {
    let ln = num_sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
    if ln == 0 { return v; }
    return map{ x: v.x / ln, y: v.y / ln, z: v.z / ln };
}
fn _cross(a, b) {
    return map{ x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x };
}
fn _dot(a, b) { return a.x * b.x + a.y * b.y + a.z * b.z; }

// look_at(eye, center, up) — a right-handed view matrix (eye/center/up are {x,y,z}).
fn look_at(eye, center, up) {
    let fwd = _norm(_sub(center, eye));
    let side = _norm(_cross(fwd, up));
    let u = _cross(side, fwd);
    let m = identity();
    m[0] = side.x; m[1] = side.y; m[2] = side.z; m[3] = 0.0 - _dot(side, eye);
    m[4] = u.x; m[5] = u.y; m[6] = u.z; m[7] = 0.0 - _dot(u, eye);
    m[8] = 0.0 - fwd.x; m[9] = 0.0 - fwd.y; m[10] = 0.0 - fwd.z; m[11] = _dot(fwd, eye);
    return m;
}

// to_f32(m) — 16 floats in COLUMN-major order for GPU upload.
fn to_f32(m) {
    let out = [];
    let c = 0;
    while c < 4 {
        let r = 0;
        while r < 4 { array_push(out, m[r * 4 + c]); r = r + 1; }
        c = c + 1;
    }
    return out;
}

export deg, identity, translate, scale, rotate_x, rotate_y, rotate_z;
export multiply, transform, ortho, perspective, look_at, to_f32;
