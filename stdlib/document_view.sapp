// Full document view plus bounded native paging; no silent block truncation.
let Text=import("stdlib:text_document.sapp");let Pages=import("stdlib:text_pages.sapp");let UI=import("stdlib:modern_ui.sapp");
fn pages(doc) {
 Text.validate(doc);let out=[];let page=[];let texts=[doc.title];
 for block in doc.blocks {array_push(texts,block.text);}
 for text in texts {for line in Pages.wrap(text,48) {
  if len(page)==10 {array_push(out,page);page=[];}
  array_push(page,line);
 }}
 if len(page)>0 {array_push(out,page);}return out;
}
fn create(doc,target="web") {
 if target!="native" and target!="web" and target!="android" {throw "unsupported document view target";}
 Text.validate(doc);let children=[UI.heading("PBLang document"),UI.text("Read-only document; no fields are evaluated here.")];
 let texts=[doc.title];for block in doc.blocks {array_push(texts,block.text);}
 for i in range(0,len(texts)) {
  let lines=Pages.wrap(texts[i],28);
  array_push(children,UI.area(if target=="native" {str_join(lines,"\n")} else {texts[i]},map{name:"block_"+str(i),readonly:true,enabled:false,h:num_max(60,len(lines)*24+24),min_h:num_max(60,len(lines)*24+24)}));
 }
 return UI.screen(children);
}
export pages,create;
