// Largest-remainder allocation. Exact bounded integer products; stable input ties.
let Sort=import("stdlib:functional_sort.sapp");
fn _integer(v,high) {return type(v)=="number" and v>=0 and v<=high and v==num_floor(v);}
fn _remainder_order(a,b) {return b.remainder-a.remainder;}
fn distribute(total,weights) {
    if not _integer(total,1000000) or type(weights)!="array" or len(weights)<1 or len(weights)>128 {throw "invalid allocation size";}
    let denominator=0;
    for weight in weights {if not _integer(weight,1000000) {throw "invalid allocation weight";}denominator=denominator+weight;}
    if denominator==0 {throw "allocation requires a positive weight";}
    let shares=[];let ranked=[];let assigned=0;
    for i in range(0,len(weights)) {
        let product=total*weights[i];let share=num_floor(product/denominator);
        array_push(shares,share);assigned=assigned+share;
        array_push(ranked,map{index:i,remainder:product-share*denominator});
    }
    let ordered=Sort.stable_sort_by(ranked,_remainder_order);
    for i in range(0,total-assigned) {let index=ordered[i].index;shares[index]=shares[index]+1;}
    return map{format:"pblang.integer-allocation.v1",total:total,shares:shares,method:"largest-remainder-input-order-ties"};
}
export distribute;
