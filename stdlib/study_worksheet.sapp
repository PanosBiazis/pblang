// Independent Writer worksheets; never change review progress or invent answers.
let Study=import("stdlib:study_cards.sapp");let D=import("stdlib:text_document.sapp");
let MAX_SELECTION=16;
fn create(deck,kind="questions",first=1,count=1) {
    Study.validate(deck);
    if kind!="questions" and kind!="answers" {throw "invalid worksheet kind";}
    if type(first)!="number" or not(first>=1 and first<=len(deck.cards)) or first!=num_floor(first)
        or type(count)!="number" or not(count>=1 and count<=MAX_SELECTION) or count!=num_floor(count)
        or first+count-1>len(deck.cards) {throw "choose an existing range of 1-16 cards";}
    let doc=map{format:D.FORMAT,title:deck.title,blocks:[]};
    for i in range(first-1,first-1+count) {
        let card=deck.cards[i];let heading="Question ";let body=card.prompt;
        if kind=="answers" {heading="Answer ";body=card.answer;}
        array_push(doc.blocks,map{kind:"heading",text:heading+str(i+1)+" | Card "+str(card.id)});
        for chunk in D.split_text(body) {array_push(doc.blocks,map{kind:"paragraph",text:chunk});}
        if kind=="questions" {array_push(doc.blocks,map{kind:"paragraph",text:"Response: ______________________________"});}
    }
    D.validate(doc);return doc;
}
export MAX_SELECTION,create;
