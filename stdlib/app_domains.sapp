// stdlib/app_domains.sapp -- bounded high-level domain application runner.
//
// app.sapp uses this module for game, multimedia, database, networking,
// automation, AI, and ML profiles. Each action receives the real lower-level
// PBLang modules in ctx.modules. Preview is plan-only unless preview_execute is
// explicit, and I/O profiles require allow_io before an action can execute.

let MAX_STEPS = 10000;
let MAX_COLLECTED = 1000;
let MAX_INPUT_ITEMS = 100000;
let MAX_INPUT_TEXT = 1048576;
let MAX_OPTIONS = 256;

let _GAME = nil;
let _IMAGE = nil;
let _DB = nil;
let _NETWORKING = nil;
let _HTTP = nil;
let _WORKFLOW = nil;
let _AI = nil;
let _ML = nil;
let _ML_METRICS = nil;

fn _get(row, key, fallback) {
    if is_map(row) and map_has(row, key) { return row[key]; }
    return fallback;
}

fn _has_control(text) {
    let i = 0;
    while i < len(text) {
        let code = strcharcodeat(text, i);
        if code < 32 or code == 127 { return true; }
        i = i + 1;
    }
    return false;
}

fn kinds() { return ["game", "multimedia", "database", "networking", "automation", "ai", "ml"]; }

fn supports(kind) {
    return kind == "game" or kind == "multimedia" or kind == "database"
        or kind == "networking" or kind == "automation" or kind == "ai" or kind == "ml";
}

fn _io_kind(kind) { return kind == "database" or kind == "networking" or kind == "ai"; }
fn _repeat_kind(kind) { return kind == "game" or kind == "automation"; }
fn _is_callable(value) {
    let kind = type(value);
    return kind == "fn" or kind == "closure" or kind == "builtin";
}

fn capabilities(kind) {
    if kind == "game" { return ["compute", "clock"]; }
    if kind == "multimedia" { return ["compute", "image"]; }
    if kind == "database" { return ["database", "filesystem"]; }
    if kind == "networking" { return ["network", "http"]; }
    if kind == "automation" { return ["compute", "workflow"]; }
    if kind == "ai" { return ["compute", "network", "ai-provider"]; }
    if kind == "ml" { return ["compute", "machine-learning"]; }
    return [];
}

fn _input_error(value) {
    if is_string(value) and len(value) > MAX_INPUT_TEXT { return "input text limit exceeded"; }
    if is_array(value) and len(value) > MAX_INPUT_ITEMS { return "input item limit exceeded"; }
    if is_map(value) and len(map_keys(value)) > MAX_INPUT_ITEMS { return "input field limit exceeded"; }
    return nil;
}

fn validate(spec) {
    let errors = [];
    if not is_map(spec) {
        array_push(errors, "domain application spec must be a map");
        return map{ ok: false, errors: errors };
    }
    let kind = str(_get(spec, "kind", ""));
    if not supports(kind) { array_push(errors, "unsupported domain application kind: " + kind); }
    let name = str(_get(spec, "name", "pblang " + kind));
    if len(name) == 0 or len(name) > 128 { array_push(errors, "domain application name must be 1..128 characters"); }
    elif _has_control(name) { array_push(errors, "domain application name contains control characters"); }
    let action = _get(spec, "action", nil);
    if not _is_callable(action) { array_push(errors, "domain application action must be callable"); }
    let preview = _get(spec, "preview", false);
    let preview_execute = _get(spec, "preview_execute", false);
    let allow_io = _get(spec, "allow_io", false);
    let collect = _get(spec, "collect", false);
    let side_effects = _get(spec, "side_effects", false);
    if type(preview) != "bool" { array_push(errors, "preview must be bool"); }
    if type(preview_execute) != "bool" { array_push(errors, "preview_execute must be bool"); }
    if type(allow_io) != "bool" { array_push(errors, "allow_io must be bool"); }
    if type(collect) != "bool" { array_push(errors, "collect must be bool"); }
    if type(side_effects) != "bool" { array_push(errors, "side_effects must be bool"); }
    let options = _get(spec, "options", map{});
    if not is_map(options) { array_push(errors, "options must be a map"); }
    elif len(map_keys(options)) > MAX_OPTIONS { array_push(errors, "options field limit exceeded"); }
    let steps = _get(spec, "steps", 1);
    if not is_number(steps) or steps < 1 or steps > MAX_STEPS or steps % 1 != 0 {
        array_push(errors, "steps must be an integer in 1.." + str(MAX_STEPS));
    } else {
        if not _repeat_kind(kind) and steps != 1 { array_push(errors, kind + " applications execute exactly one action"); }
        if collect and steps > MAX_COLLECTED { array_push(errors, "collected output step limit exceeded"); }
    }
    let input_error = _input_error(_get(spec, "input", nil));
    if input_error != nil { array_push(errors, input_error); }
    if side_effects == true and allow_io != true {
        array_push(errors, "side_effects require allow_io: true");
    }
    return map{ ok: len(errors) == 0, errors: errors, kind: kind, name: name };
}

fn plan(spec) {
    let checked = validate(spec);
    let kind = _get(spec, "kind", "");
    let preview = _get(spec, "preview", false);
    let preview_execute = _get(spec, "preview_execute", false);
    let will_execute = not preview or preview_execute;
    let io_allowed = _get(spec, "allow_io", false);
    let blocked = will_execute and _io_kind(kind) and io_allowed != true;
    let errors = [];
    let i = 0;
    while i < len(checked.errors) { array_push(errors, checked.errors[i]); i = i + 1; }
    if blocked { array_push(errors, kind + " execution requires allow_io: true"); }
    return map{
        format: "pblang.app.domain.plan.v1",
        ok: checked.ok and not blocked,
        errors: errors,
        kind: kind,
        name: _get(spec, "name", "pblang " + str(kind)),
        preview: preview,
        preview_execute: preview_execute,
        will_execute: will_execute,
        io_required: _io_kind(kind),
        io_allowed: io_allowed,
        steps: _get(spec, "steps", 1),
        collect: _get(spec, "collect", false),
        capabilities: capabilities(kind),
        implementation: "lazy pblang domain libraries"
    };
}

fn _game_module() { if _GAME == nil { _GAME = import("stdlib:game.sapp"); } return _GAME; }
fn _image_module() { if _IMAGE == nil { _IMAGE = import("stdlib:image_processing.sapp"); } return _IMAGE; }
fn _db_module() { if _DB == nil { _DB = import("stdlib:db.sapp"); } return _DB; }
fn _networking_module() { if _NETWORKING == nil { _NETWORKING = import("stdlib:networking.sapp"); } return _NETWORKING; }
fn _http_module() { if _HTTP == nil { _HTTP = import("stdlib:http_client.sapp"); } return _HTTP; }
fn _workflow_module() { if _WORKFLOW == nil { _WORKFLOW = import("stdlib:workflow.sapp"); } return _WORKFLOW; }
fn _ai_module() { if _AI == nil { _AI = import("stdlib:ai.sapp"); } return _AI; }
fn _ml_module() { if _ML == nil { _ML = import("stdlib:ml.sapp"); } return _ML; }
fn _ml_metrics_module() { if _ML_METRICS == nil { _ML_METRICS = import("stdlib:machine_learning.sapp"); } return _ML_METRICS; }

fn modules(kind) {
    if kind == "game" { return map{ game: _game_module() }; }
    if kind == "multimedia" { return map{ image: _image_module() }; }
    if kind == "database" { return map{ db: _db_module() }; }
    if kind == "networking" { return map{ networking: _networking_module(), http: _http_module() }; }
    if kind == "automation" { return map{ workflow: _workflow_module() }; }
    if kind == "ai" { return map{ ai: _ai_module() }; }
    if kind == "ml" { return map{ ml: _ml_module(), metrics: _ml_metrics_module() }; }
    throw "unsupported domain application kind: " + str(kind);
}

fn run(spec) {
    let execution = plan(spec);
    if not execution.ok { throw "invalid domain application: " + str_join(execution.errors, "; "); }
    if not execution.will_execute {
        return map{
            format: "pblang.app.domain.result.v1",
            kind: execution.kind, name: execution.name,
            preview: true, executed: false, planned: true,
            steps_executed: 0, value: nil, values: [], plan: execution
        };
    }

    let action = _get(spec, "action", nil);
    let loaded = modules(execution.kind);
    let state = _get(spec, "input", nil);
    let values = [];
    let step = 0;
    while step < execution.steps {
        let ctx = map{
            format: "pblang.app.domain.context.v1",
            kind: execution.kind,
            name: execution.name,
            step: step,
            steps: execution.steps,
            input: _get(spec, "input", nil),
            state: state,
            modules: loaded,
            options: _get(spec, "options", map{}),
            preview: execution.preview
        };
        state = action(ctx);
        if execution.collect { array_push(values, state); }
        step = step + 1;
    }
    return map{
        format: "pblang.app.domain.result.v1",
        kind: execution.kind, name: execution.name,
        preview: execution.preview, executed: true, planned: false,
        steps_executed: execution.steps, value: state, values: values, plan: execution
    };
}

export MAX_STEPS, MAX_COLLECTED, MAX_INPUT_ITEMS, MAX_INPUT_TEXT, MAX_OPTIONS;
export kinds, supports, capabilities, validate, plan, modules, run;
