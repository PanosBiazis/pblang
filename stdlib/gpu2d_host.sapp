// stdlib/gpu2d_host.sapp — pblang emits the POLYGLOT host glue for the 2D GPU rasterizer.
//
// Given gpu2d's instance buffer + gpu2d_shader's program, this generates the host-language
// code that builds the pipeline, uploads the buffer, binds the glyph atlas, and issues one
// instanced draw — in Rust (wgpu), C (OpenGL), Python (moderngl), and JS (WebGPU). The
// vertex attributes are DERIVED from gpu2d_shader.vertex_layout(), so all four hosts and
// both shader languages stay in lockstep from one source of truth.
//
// These are generated source strings (codegen, like the rest of the stack). Where a GPU +
// toolchain exists they are runnable via stdlib/polyglot (e.g. polyglot.run("python", ...)).
//
//   let H = import("stdlib/gpu2d_host.sapp");
//   H.emit("rust-wgpu");   // or c-opengl / python-moderngl / js-webgpu

let S = import("stdlib:gpu2d_shader.sapp");

fn targets() { return ["rust-wgpu", "c-opengl", "python-moderngl", "js-webgpu"]; }

// ── Rust / wgpu ─────────────────────────────────────────────────────────────────────
fn _wgpu_attrs() {
    let vl = S.vertex_layout();
    let lines = [];
    let i = 0;
    while i < len(vl.attributes) {
        let a = vl.attributes[i];
        let f = "wgpu::VertexFormat::Float32";
        if a.floats == 4 { f = "wgpu::VertexFormat::Float32x4"; }
        array_push(lines, "            wgpu::VertexAttribute { format: " + f +
            ", offset: " + str(a.offset) + ", shader_location: " + str(a.location) + " },");
        i = i + 1;
    }
    return str_join(lines, "\n");
}
fn emit_rust_wgpu() {
    let L = [
        "// gpu2d host — Rust / wgpu (generated by pblang stdlib/gpu2d_host.sapp).",
        "// Upload gpu2d.to_vertex_f32(dl) as the instance buffer; draw len/14 instances.",
        "pub const SHADER: &str = r#\"",
        S.wgsl(),
        "\"#;",
        "",
        "pub fn instance_layout() -> wgpu::VertexBufferLayout<'static> {",
        "    wgpu::VertexBufferLayout {",
        "        array_stride: 56,",
        "        step_mode: wgpu::VertexStepMode::Instance,",
        "        attributes: &[",
        _wgpu_attrs(),
        "        ],",
        "    }",
        "}",
        "",
        "pub fn build(device: &wgpu::Device, fmt: wgpu::TextureFormat) -> wgpu::RenderPipeline {",
        "    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {",
        "        label: Some(\"gpu2d\"), source: wgpu::ShaderSource::Wgsl(SHADER.into()),",
        "    });",
        "    device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {",
        "        label: Some(\"gpu2d\"), layout: None,",
        "        vertex: wgpu::VertexState { module: &module, entry_point: \"vs_main\", buffers: &[instance_layout()] },",
        "        fragment: Some(wgpu::FragmentState { module: &module, entry_point: \"fs_main\",",
        "            targets: &[Some(fmt.into())] }),",
        "        primitive: wgpu::PrimitiveState::default(),",
        "        depth_stencil: None, multisample: wgpu::MultisampleState::default(), multiview: None,",
        "    })",
        "}",
        "",
        "pub fn draw<'a>(pass: &mut wgpu::RenderPass<'a>, pipe: &'a wgpu::RenderPipeline,",
        "                instances: &'a wgpu::Buffer, count: u32) {",
        "    pass.set_pipeline(pipe);",
        "    pass.set_vertex_buffer(0, instances.slice(..));",
        "    pass.draw(0..6, 0..count);   // 6 verts per quad, `count` instances, one call",
        "}"
    ];
    return str_join(L, "\n");
}

// ── C / OpenGL ──────────────────────────────────────────────────────────────────────
fn _c_str(src) { return "\"" + str_replace_all(str_replace_all(src, "\"", "\\\""), "\n", "\\n\"\n\"") + "\""; }
fn _gl_attrs() {
    let vl = S.vertex_layout();
    let lines = [];
    let i = 0;
    while i < len(vl.attributes) {
        let a = vl.attributes[i];
        array_push(lines, "    glEnableVertexAttribArray(" + str(a.location) + ");");
        array_push(lines, "    glVertexAttribPointer(" + str(a.location) + ", " + str(a.floats) +
            ", GL_FLOAT, GL_FALSE, 56, (void*)" + str(a.offset) + ");");
        array_push(lines, "    glVertexAttribDivisor(" + str(a.location) + ", 1);");
        i = i + 1;
    }
    return str_join(lines, "\n");
}
fn emit_c_opengl() {
    let L = [
        "/* gpu2d host — C / OpenGL 3.3 (generated by pblang stdlib/gpu2d_host.sapp). */",
        "#include <GL/glew.h>",
        "static const char* VS = ",
        _c_str(S.glsl_vertex()),
        ";",
        "static const char* FS = ",
        _c_str(S.glsl_fragment()),
        ";",
        "static GLuint compile(GLenum type, const char* src) {",
        "    GLuint s = glCreateShader(type);",
        "    glShaderSource(s, 1, &src, NULL); glCompileShader(s); return s;",
        "}",
        "GLuint gpu2d_program(void) {",
        "    GLuint p = glCreateProgram();",
        "    glAttachShader(p, compile(GL_VERTEX_SHADER, VS));",
        "    glAttachShader(p, compile(GL_FRAGMENT_SHADER, FS));",
        "    glLinkProgram(p); return p;",
        "}",
        "void gpu2d_setup_attribs(void) {",
        _gl_attrs(),
        "}",
        "void gpu2d_draw(int count) {",
        "    glDrawArraysInstanced(GL_TRIANGLES, 0, 6, count);  /* one instanced call */",
        "}"
    ];
    return str_join(L, "\n");
}

// ── Python / moderngl ───────────────────────────────────────────────────────────────
fn emit_python_moderngl() {
    let L = [
        "# gpu2d host — Python / moderngl (generated by pblang stdlib/gpu2d_host.sapp).",
        "# instances = bytes from gpu2d.to_vertex_f32(dl) packed as little-endian f32.",
        "import moderngl, struct",
        "",
        "VERTEX = '''",
        S.glsl_vertex(),
        "'''",
        "FRAGMENT = '''",
        S.glsl_fragment(),
        "'''",
        "",
        "def build(ctx, instance_bytes, count, viewport):",
        "    prog = ctx.program(vertex_shader=VERTEX, fragment_shader=FRAGMENT)",
        "    prog['u_viewport'].value = viewport",
        "    vbo = ctx.buffer(instance_bytes)",
        "    # 56-byte stride, per-instance: rect/rad/color/uv/kind",
        "    vao = ctx.vertex_array(prog, [(vbo, '4f 1f 4f 4f 1f/i',",
        "        'i_rect', 'i_rad', 'i_color', 'i_uv', 'i_kind')])",
        "    return prog, vao",
        "",
        "def draw(vao, count):",
        "    vao.render(mode=moderngl.TRIANGLES, vertices=6, instances=count)"
    ];
    return str_join(L, "\n");
}

// ── JS / WebGPU ─────────────────────────────────────────────────────────────────────
fn emit_js_webgpu() {
    let vl = S.vertex_layout();
    let attrs = [];
    let i = 0;
    while i < len(vl.attributes) {
        let a = vl.attributes[i];
        let f = "float32";
        if a.floats == 4 { f = "float32x4"; }
        array_push(attrs, "      { shaderLocation: " + str(a.location) + ", offset: " + str(a.offset) +
            ", format: '" + f + "' },");
        i = i + 1;
    }
    let L = [
        "// gpu2d host — JS / WebGPU (generated by pblang stdlib/gpu2d_host.sapp).",
        "export const SHADER = `",
        S.wgsl(),
        "`;",
        "",
        "export function build(device, format) {",
        "  const module = device.createShaderModule({ code: SHADER });",
        "  return device.createRenderPipeline({",
        "    layout: 'auto',",
        "    vertex: { module, entryPoint: 'vs_main', buffers: [{",
        "      arrayStride: 56, stepMode: 'instance', attributes: [",
        str_join(attrs, "\n"),
        "      ] }] },",
        "    fragment: { module, entryPoint: 'fs_main', targets: [{ format }] },",
        "    primitive: { topology: 'triangle-list' },",
        "  });",
        "}",
        "",
        "export function draw(pass, pipeline, instanceBuffer, count) {",
        "  pass.setPipeline(pipeline);",
        "  pass.setVertexBuffer(0, instanceBuffer);",
        "  pass.draw(6, count);   // 6 verts per quad, count instances",
        "}"
    ];
    return str_join(L, "\n");
}

// emit(target) — dispatch by name.
fn emit(target) {
    if target == "rust-wgpu" { return emit_rust_wgpu(); }
    if target == "c-opengl" { return emit_c_opengl(); }
    if target == "python-moderngl" { return emit_python_moderngl(); }
    if target == "js-webgpu" { return emit_js_webgpu(); }
    throw "gpu2d_host: unknown target '" + str(target) + "'";
}

export targets, emit, emit_rust_wgpu, emit_c_opengl, emit_python_moderngl, emit_js_webgpu;
