// Explicit family declarations plus exact-context disjointness; no training or I/O.
fn _fields(value,names) {
 if type(value)!="map" or len(value)!=len(names) {throw "invalid curriculum fields";}
 for name in names {if not map_has(value,name) {throw "missing curriculum field";}}
}
fn _integer(value,low,high) {
 if type(value)!="number" {throw "invalid curriculum number";}
 if value!=value or value<low or value>high or value!=num_floor(value) {throw "curriculum number outside bounds";}
}
fn _family(value) {
 if type(value)!="string" or len(value)<1 or len(value)>48 {throw "invalid curriculum family";}
 for i len(value) {
  if not str_contains("abcdefghijklmnopqrstuvwxyz0123456789-",str_slice(value,i,i+1)) {throw "invalid curriculum family";}
 }
}
fn _prepare(vocab_size,context,groups,known_tasks) {
 _integer(vocab_size,2,256);_integer(context,1,16);
 if type(groups)!="array" or len(groups)<3 or len(groups)>12 {throw "expected 3..12 curriculum families";}
 let families=map{};let contexts=map{};let rows=map{training:[],validation:[],test:[]};
 let counts=map{training:0,validation:0,test:0};let test_families=[];let declarations=[];
 for group in groups {
  _fields(group,["family","split","examples"]);_family(group.family);
  if group.split!="training" and group.split!="validation" and group.split!="test" {throw "invalid curriculum split";}
  if not map_has(families,group.family) {families[group.family]=map{training:false,validation:false,test:false};}
  let family_splits=families[group.family];
  if family_splits[group.split] {throw "curriculum family/split reused";}
  if not known_tasks and (family_splits.training or family_splits.validation or family_splits.test) {throw "curriculum family reused";}
  family_splits[group.split]=true;families[group.family]=family_splits;
  counts[group.split]=counts[group.split]+1;if counts[group.split]>4 {throw "too many families per split";}
  if type(group.examples)!="array" or len(group.examples)<1 or len(group.examples)>32 {throw "expected 1..32 family examples";}
  if len(rows[group.split])+len(group.examples)>32 {throw "curriculum split exceeds 32 examples";}
  let detached=[];
  for example in group.examples {
   _fields(example,["x","y"]);_integer(example.y,0,vocab_size-1);
   if type(example.x)!="array" or len(example.x)<1 or len(example.x)>context {throw "invalid curriculum context";}
   let ids=[];for id in example.x {_integer(id,0,vocab_size-1);push(ids,if id==0 {0} else {id});}
   let key=json_stringify(ids);if map_has(contexts,key) {throw "curriculum context reused";}contexts[key]=true;
   let row=map{x:ids,y:if example.y==0 {0} else {example.y}};push(detached,row);push(rows[group.split],row);
  }
  push(declarations,map{family:group.family,split:group.split,examples:len(detached),digest:sha256(json_stringify(detached))});
  if group.split=="test" {push(test_families,map{family:group.family,examples:detached});}
 }
 for split in ["training","validation","test"] {if counts[split]==0 {throw "each curriculum split needs a family";}}
 if known_tasks {
  for family in map_keys(families) {
   let present=families[family];
   if not present.training or not present.validation or not present.test {throw "known task missing from a split";}
  }
 }
 let result=map{training:rows.training,validation:rows.validation,test_families:test_families,
  report:map{format:"pbai.curriculum.split.v1",vocab_size:vocab_size,context:context,families:declarations,
   training_examples:len(rows.training),validation_examples:len(rows.validation),test_examples:len(rows.test),
   declared_family_disjointness_checked:true,exact_context_disjointness_checked:true,
   semantic_family_identity_verified:false,independent_provenance_verified:false,
   snapshot_digest:sha256(json_stringify([vocab_size,context,declarations])),
   digest_scope:"ordered-validated-snapshot",training_performed:false,persists_data:false,authorizes_activation:false}};
 if known_tasks {
  result.report.format="pbai.curriculum.known-task-split.v1";
  result.report.declared_family_disjointness_checked=false;
  result.report.same_declared_families_in_all_splits=true;
  result.report.snapshot_digest=sha256(json_stringify(["known-task",vocab_size,context,declarations]));
 }
 return result;
}
fn prepare(vocab_size,context,groups) {return _prepare(vocab_size,context,groups,false);}
fn prepare_known_tasks(vocab_size,context,groups) {return _prepare(vocab_size,context,groups,true);}
export prepare, prepare_known_tasks;
