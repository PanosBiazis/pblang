// Local CRUD website with opt-in private persistent snapshots. No polyglot blocks or external assets.
let Records = import("stdlib:crud_records.sapp");
let HTML = import("stdlib:html.sapp");
let HTTP = import("stdlib:http_server.sapp");
fn form(body) {
    if type(body) != "string" or len(body) > 8192 or len(str_to_bytes(body)) > 8192 { throw "crud: form too large"; }
    let result = map{};
    if body == "" { return result; }
    let pairs = str_split(body, "&");
    if len(pairs) > 8 { throw "crud: too many fields"; }
    for pair in pairs {
        let pieces = str_split(pair, "=");
        if len(pieces) != 2 { throw "crud: invalid form"; }
        let key = url_decode(str_join(str_split(pieces[0], "+"), " "));
        let value = url_decode(str_join(str_split(pieces[1], "+"), " "));
        if not (key == "id" or key == "name" or key == "country" or key == "time"
            or key == "revision" or key == "csrf" or key == "confirmation" or key == "page" or key == "q")
            or map_has(result, key) { throw "crud: unknown or duplicate field"; }
        result[key] = value;
    }
    return result;
}
fn _response(status, body, kind = "text/html; charset=utf-8") {
    return map{ status: status, body: body, content_type: kind, headers: map{
        "Cache-Control": "no-store", "Referrer-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff", "Cross-Origin-Resource-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    } };
}
fn _hidden(name, value) { return "<input type=\"hidden\" name=\"" + name + "\" value=\"" + HTML.escape(value) + "\">"; }
fn _field(name, label, value = "", maximum = 240) {
    return "<label>" + label + "<input required name=\"" + name + "\" maxlength=\"" + str(maximum)
        + "\" value=\"" + HTML.escape(value) + "\"></label>";
}
fn stylesheet() {
    return "body{margin:0;background:#eff3f7;color:#172b3a;font:16px system-ui,sans-serif}main{max-width:72rem;margin:auto;padding:clamp(1rem,4vw,3rem)}header{display:flex;justify-content:space-between;align-items:center;gap:1rem}.badge{border:1px solid #96b1a9;padding:.4rem .8rem;border-radius:2rem;color:#155b48}h1{font-size:clamp(2rem,5vw,3.7rem);letter-spacing:-.045em;margin:.6rem 0}.lead{max-width:48rem;color:#516878}.card{background:white;border:1px solid #d7e2e9;border-radius:1rem;padding:1.4rem;margin:1.2rem 0;overflow:auto}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem}label{display:grid;gap:.4rem}input,button{font:inherit;border:1px solid #8aa0ae;border-radius:.4rem;padding:.7rem;min-width:0}button{cursor:pointer;background:#126b59;color:white;border-color:#126b59}button.danger{background:#9c3046;border-color:#9c3046}button:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid #bd7100;outline-offset:3px}table{border-collapse:collapse;width:100%;min-width:32rem}td,th{text-align:left;border-bottom:1px solid #d7e2e9;padding:.8rem}th{color:#506677}nav{display:flex;gap:1rem;margin:1rem 0}a{color:#126b59}small,footer{color:#516878}summary{cursor:pointer;font-weight:600}form{margin:.7rem 0}footer{padding:1rem 0}.actions{display:flex;gap:.5rem;flex-wrap:wrap}@media(prefers-color-scheme:dark){body{background:#111b24;color:#e4edf5}.card{background:#182936;border-color:#395061}.lead,small,footer,th{color:#b2c6d5}input{background:#111b24;color:#edf4fa}a,.badge{color:#8ddac4}}";
}
fn _page(store, csrf, page, query) {
    let info = store.info(); let listed = store.list((page - 1) * 25, 25, query);
    let persistent = try info.persistent catch false;
    let badge = if persistent { "Local · Saved on this device" } else { "Local · In memory" };
    let storage = if persistent { "Changes are saved to a private local snapshot." } else { "This preview forgets its data when it stops." };
    let guard = _hidden("csrf", csrf) + _hidden("revision", info.revision);
    let parts = ["<main><header><strong>PBLANG / LAB</strong><span class=\"badge\">" + badge + "</span></header><h1>Race records.</h1><p class=\"lead\">A small workspace for your next event. Create, browse, update and remove records. " + storage + "</p>",
        "<section class=\"card\"><h2>Add a contestant</h2><form method=\"post\" action=\"/create\">", guard,
        "<div class=\"grid\">", _field("id", "ID", "", 10), _field("name", "Name"), _field("country", "Country"), _field("time", "Time", "", 64),
        "</div><p><button>Add record</button></p></form></section><section class=\"card\"><h2>Results</h2><form method=\"get\" action=\"/\"><label>Search name, country or ID<input name=\"q\" maxlength=\"240\" value=\"", HTML.escape(query), "\"></label><p><button>Search</button> <a href=\"/\">Reset</a></p></form><p>", str(listed.matched), " matching records · Revision ", str(info.revision), "</p>"];
    let cells = []; for row in listed.rows { push(cells, [row.id, row.name, row.country, row.time]); }
    push(parts, HTML.table(["ID", "Name", "Country", "Time"], cells));
    push(parts, "<nav aria-label=\"Pagination\">");
    if page > 1 { push(parts, "<a href=\"/?page=" + str(page - 1) + "&amp;q=" + HTML.escape(url_encode(query)) + "\">Previous</a>"); }
    if page * 25 < listed.matched { push(parts, "<a href=\"/?page=" + str(page + 1) + "&amp;q=" + HTML.escape(url_encode(query)) + "\">Next</a>"); }
    push(parts, "</nav><small>Edits use the displayed revision. Refresh if another tab has changed the records.</small></section><section class=\"card\"><h2>Manage a record</h2><form method=\"post\" action=\"/update\">" + guard
        + "<div class=\"grid\">" + _field("id", "Existing ID", "", 10) + _field("name", "New name") + _field("country", "Country") + _field("time", "Time", "", 64)
        + "</div><p><button>Save changes</button></p></form><details><summary>Delete records</summary><form method=\"post\" action=\"/delete\">" + guard + _field("id", "ID to remove", "", 10)
        + "<p><button class=\"danger\">Delete this ID</button></p></form><form method=\"post\" action=\"/clear\">" + guard + _field("confirmation", "Type DELETE ALL to remove every record", "", 10)
        + "<p><button class=\"danger\">Delete all records</button></p></form></details></section><footer>No analytics or external assets. Use synthetic data. Other local applications can access this preview.</footer></main>");
    return HTML.page("Race records · PBLang", str_join(parts, ""), "<link rel=\"stylesheet\" href=\"/style.css\">");
}
fn _render(store, token, path_parts) {
    let query = if len(path_parts) == 2 { form(path_parts[1]) } else { map{} };
    for key in map_keys(query) { if key != "page" and key != "q" { throw "invalid query"; } }
    let page_text = try query.page catch "1";
    let query_text = try query.q catch "";
    return _page(store, token, Records.decimal(page_text, 1), query_text);
}
fn _mutate(store, path, fields) {
            let expected = Records.decimal(fields.revision);
            let allowed = ["csrf", "revision"];
            if path == "/clear" { push(allowed, "confirmation"); }
            else { push(allowed, "id"); }
            if path == "/create" or path == "/update" { push(allowed, "name"); push(allowed, "country"); push(allowed, "time"); }
            if len(map_keys(fields)) != len(allowed) { throw "invalid fields"; }
            for key in allowed { if not map_has(fields, key) { throw "missing field"; } }
            if path == "/clear" { store.clear(expected, fields.confirmation); }
            elif path == "/delete" { store.remove(Records.decimal(fields.id, 1), expected); }
            else {
                let row = map{ id: Records.decimal(fields.id, 1), name: fields.name, country: fields.country, time: fields.time };
                if path == "/create" { store.insert(row, expected); } else { store.update(row, expected); }
            }
    return true;
}
fn _create_with_store(port, store, persistent) {
    let token = sha256(json_stringify(random_bytes(32)));
    let host = "127.0.0.1:" + str(port);
    // pblang-security-ignore-next-line: network.plaintext-http reason=exact loopback-only preview origin; no remote binding or proxy support
    let expected_origin = "http://" + host;
    let handle = fn(req) {
        if HTTP.req_header(req, "host") != host { return _response(403, "Host rejected."); }
        let origin = HTTP.req_header(req, "origin");
        if origin != nil and origin != expected_origin { return _response(403, "Origin rejected."); }
        let site = HTTP.req_header(req, "sec-fetch-site");
        if site != nil and site != "none" and site != "same-origin" { return _response(403, "Cross-site request rejected."); }
        let path_parts = str_split(req.path, "?");
        let path = path_parts[0];
        if len(path_parts) > 2 { return _response(400, "Invalid path."); }
        if req.method == "GET" {
            if path == "/style.css" { return _response(200, stylesheet(), "text/css; charset=utf-8"); }
            if path != "/" { return _response(404, "Not found."); }
            if persistent {
                let refreshed = try store.refresh() catch false;
                if not refreshed { return _response(503, "Saved records unavailable. No changes were made by this request."); }
            }
            let rendered = try _render(store, token, path_parts) catch nil;
            if rendered == nil { return _response(400, "Invalid query. Return to the home page."); }
            return _response(200, rendered);
        }
        if req.method != "POST" { let out = _response(405, "Method not allowed."); out.headers["Allow"] = "GET, POST"; return out; }
        if not (path == "/create" or path == "/update" or path == "/delete" or path == "/clear") { return _response(404, "Not found."); }
        if len(path_parts) != 1 { return _response(400, "Unexpected query."); }
        if origin != expected_origin { return _response(403, "Same-origin form required."); }
        if HTTP.req_header(req, "content-type") != "application/x-www-form-urlencoded" { return _response(415, "Form encoding required."); }
        let fields = try form(req.body) catch nil;
        if fields == nil { return _response(400, "Invalid form."); }
        let provided = try fields.csrf catch "";
        if type(provided) != "string" or len(provided) != 64 or not constant_time_eq(provided, token) { return _response(403, "Request verification failed."); }
        let result = try _mutate(store, path, fields) catch false;
        if not result {
            let message = "Change rejected. Check the fields, capacity and revision; refresh before retrying.";
            if persistent { message = "Save unconfirmed or change rejected. A save may already have completed: refresh and inspect before submitting again."; }
            return _response(400, message);
        }
        let out = _response(303, "Saved. Return to the home page."); out.headers["Location"] = "/"; return out;
    };
    return map{ handle: handle, close: store.close, port: port };
}
fn create(port = 8765, max_records = 10000) {
    Records.integer(port, 1024, 65535);
    return _create_with_store(port, Records.create(max_records), false);
}
fn create_persistent(path, port = 8765, max_records = 10000, max_bytes = 1048576) {
    Records.integer(port, 1024, 65535);
    let Persistent = import("stdlib:crud_persistent.sapp");
    let store = Persistent.open(path, max_records, max_bytes);
    let app = try _create_with_store(port, store, true) catch nil;
    if app == nil { store.close(); throw "crud preview: initialization failed"; }
    return app;
}
fn _serve(app, max_connections) {
    let port = app.port;
    let options = map{
        request_timeout_ms: 2000, write_timeout_ms: 1000, accept_poll_ms: 25,
        max_inflight: 8, max_header_bytes: 8192, max_body_bytes: 8192,
        max_response_bytes: 131072, max_connections: max_connections
    };
    let failed = false;
    try HTTP.serve_forever_timeout("127.0.0.1:" + str(port), app.handle, options)
        catch { failed = true; };
    app.close();
    if failed { throw "crud preview: listener failed or this platform lacks the bounded transport"; }
}
fn serve(port = 8765, max_connections = nil) { return _serve(create(port), max_connections); }
fn serve_persistent(path, port = 8765, max_connections = nil) {
    return _serve(create_persistent(path, port), max_connections);
}
fn demo() {
    let store = Records.create(100);
    store.insert(map{ id: 1, name: "Demo rider", country: "Example", time: "01:23" }, 0);
    store.update(map{ id: 1, name: "Updated rider", country: "Example", time: "01:22" }, 1);
    let rows = store.list().rows;
    store.remove(1, 2); let empty = store.info().count == 0; store.close();
    return map{ ok: empty and len(rows) == 1, records_read: len(rows), native_pblang: true, persistent: false };
}
export create, create_persistent, serve, serve_persistent, demo, form, stylesheet;
