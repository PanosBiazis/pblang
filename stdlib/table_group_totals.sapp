// Optional margins over generated category counts; source text stays literal.
let G=import("stdlib:table_group.sapp");let S=import("stdlib:sheet_document.sapp");
fn _label(labels) {
 let used=map{};for label in labels {used[label]=true;}
 let label="Total";let index=1;
 while map_has(used,label) {label="Total ["+str(index)+"]";index=index+1;}
 return label;
}
fn counts(doc,column,header=false) {
 let out=G.counts(doc,column,header);
 if len(out.cells)>=S.MAX_ROWS {throw "count totals: at most 30 categories";}
 let labels=[];for i in range(1,len(out.cells)) {array_push(labels,out.cells[i][0]);}
 array_push(out.cells,[_label(labels),str(len(doc.cells)-(if header {1} else {0}))]);
 S.validate(out);return out;
}
fn cross(doc,row_column,column_column,header=false) {
 let out=G.cross(doc,row_column,column_column,header);
 if len(out.cells)>=S.MAX_ROWS or len(out.cells[0])>=S.MAX_COLUMNS {throw "cross totals: at most 30 row and 6 column categories";}
 let width=len(out.cells[0]);let column_totals=[];for c in range(1,width) {array_push(column_totals,0);}
 let labels=[];let grand=0;
 for r in range(1,len(out.cells)) {
  array_push(labels,out.cells[r][0]);let row_total=0;
  // These values were produced by G.cross, not parsed from caller cell text.
  for c in range(1,width) {let count=parse_number(out.cells[r][c]);row_total=row_total+count;column_totals[c-1]=column_totals[c-1]+count;}
  array_push(out.cells[r],str(row_total));grand=grand+row_total;
 }
 let heading=_label(out.cells[0]);array_push(out.cells[0],heading);
 let last=[_label(labels)];for value in column_totals {array_push(last,str(value));}array_push(last,str(grand));array_push(out.cells,last);
 S.validate(out);return out;
}
export counts,cross;
