// Canonical PBIDE identity and edition matrix. UI implementations consume this
// data instead of copying action/panel/version claims across native and web code.

let Editions = import("stdlib:product_editions.sapp");
let Forms = import("stdlib:ui_form_interchange.sapp");
let Effects = import("stdlib:pbide_effect_admission.sapp");
let FileBroker = import("stdlib:pbide_file_broker_core.sapp");

let VERSION = "0.5.7";
let RELEASE_CHANNEL = "alpha";
let BUILT_WITH_PBLANG = "0.6.0";

fn actions() {
    return [
        map{id:"run",label:"Run"}, map{id:"check",label:"Check"},
        map{id:"format",label:"Fmt"}, map{id:"fix",label:"Fix"},
        map{id:"examples",label:"Ex"}, map{id:"save",label:"Save"},
        map{id:"open",label:"Open"}, map{id:"preview",label:"Preview"},
        map{id:"mode",label:"Mode"}, map{id:"watch",label:"Watch"},
        map{id:"style",label:"Style"}, map{id:"theme",label:"Dark"}
    ];
}

fn panels() {
    return [
        map{id:"code",label:"Code"}, map{id:"term",label:"Term"},
        map{id:"ai",label:"AI"}, map{id:"design",label:"Designer"},
        map{id:"web",label:"Browser"}, map{id:"files",label:"Files"},
        map{id:"outline",label:"Out"}, map{id:"problems",label:"Prob"},
        map{id:"hist",label:"Hist"}, map{id:"manage",label:"Manage"},
        map{id:"settings",label:"Settings"}
    ];
}

fn core_capabilities() {
    return ["edit", "open", "save", "diagnostics", "format", "examples", "designer"];
}

fn _with(base, extras) {
    let out = [];
    for value in base { array_push(out, value); }
    for value in extras { array_push(out, value); }
    return out;
}

fn edition_contract() {
    let core = core_capabilities();
    let native = _with(core, ["run", "preview", "terminal", "ai", "browser", "files",
        "outline", "problems", "history", "management", "settings", "watcher",
        "designer-from-code"]);
    let web = _with(core, ["run-token", "browser", "ai-gateway", "designer-from-code",
        "circuit-designer", "quantum-designer"]);
    return Editions.contract("pbide", VERSION, RELEASE_CHANNEL, BUILT_WITH_PBLANG, [
        Editions.surface("cli", "pblang", ["linux", "windows", "macos"], "implemented",
            ["launch", "status"], map{evidence:["facade-tests"]}),
        Editions.surface("native-gui", "pblang", ["linux", "windows", "macos"], "implemented",
            native, map{evidence:["pure-ui-tests", "source-contract-tests"]}),
        Editions.surface("web-pblang", "pblang", ["browser", "pwa"], "preview",
            web, map{evidence:["generated-web-preview-tests"]}),
        Editions.surface("android", "pblang", ["android"], "contract",
            core, map{}),
        Editions.surface("ios", "pblang", ["ios"], "contract", core, map{})
    ]);
}

fn polyglot_editions() {
    return Editions.polyglot_catalog(map{web:"preview"});
}

fn status() {
    let contract = edition_contract();
    let parity = Editions.parity_subset(contract, ["native-gui", "web-pblang"], core_capabilities());
    let release = Editions.release_gate(contract);
    let effect_admission = Effects.status();
    let file_broker = FileBroker.status();
    let blockers = release.blockers;
    if not effect_admission.production_ready {
        array_push(blockers, "pbide-effect-broker-required");
    }
    return map{format:"pbide.product.status.v2", product:"pbide", version:VERSION,
        release_channel:RELEASE_CHANNEL, built_with_pblang:BUILT_WITH_PBLANG,
        version_is_independent:true, contract:contract, parity:parity,
        polyglot_editions:polyglot_editions(), ui_form_interchange:Forms.status(),
        effect_admission:effect_admission,file_broker:file_broker,
        production_ready:release.production_ready and effect_admission.production_ready
            and file_broker.production_ready,
        blockers:blockers};
}

fn form_formats() { return Forms.catalog(); }
fn form_conversion_plan(from_id, to_id) { return Forms.conversion_plan(from_id, to_id); }

export VERSION, RELEASE_CHANNEL, BUILT_WITH_PBLANG;
export actions, panels, core_capabilities, edition_contract, polyglot_editions, status;
export form_formats, form_conversion_plan;
