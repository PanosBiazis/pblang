// stdlib/astronomy.sapp -- bounded deterministic solar/civil-time planning.
// Solar events use a fractional-year approximation with the conventional
// 90.833-degree apparent zenith. This is not a high-precision ephemeris.

let Math = import("stdlib:math.sapp");

let FORMAT = "pblang.astronomy.solar.v1";
let APPARENT_ZENITH_DEGREES = 90.833;
let MAX_YEAR_SAMPLES = 366;

fn _finite(value, minimum, maximum, name) {
    if not is_number(value) or str_contains(str_lower(str(value)), "nan")
        or str_contains(str_lower(str(value)), "inf")
        or value < minimum or value > maximum {
        throw "astronomy: " + name + " must be finite and in "
            + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _integer(value, minimum, maximum, name) {
    value = _finite(value, minimum, maximum, name);
    if value != num_floor(value) { throw "astronomy: " + name + " must be a whole number"; }
    return value;
}

fn is_leap_year(year) {
    year = _integer(year, 1600, 9999, "year");
    return (num_mod(year, 4) == 0 and num_mod(year, 100) != 0)
        or num_mod(year, 400) == 0;
}

fn days_in_month(year, month) {
    year = _integer(year, 1600, 9999, "year");
    month = _integer(month, 1, 12, "month");
    if month == 2 { return if is_leap_year(year) { 29 } else { 28 }; }
    if month == 4 or month == 6 or month == 9 or month == 11 { return 30; }
    return 31;
}

fn validate_date(year, month, day) {
    year = _integer(year, 1600, 9999, "year");
    month = _integer(month, 1, 12, "month");
    day = _integer(day, 1, days_in_month(year, month), "day");
    return map{ year: year, month: month, day: day };
}

fn day_of_year(year, month, day) {
    let date = validate_date(year, month, day);
    let result = date.day;
    let current = 1;
    while current < date.month {
        result = result + days_in_month(date.year, current);
        current = current + 1;
    }
    return result;
}

fn _date_from_ordinal(year, ordinal) {
    year = _integer(year, 1600, 9999, "year");
    let maximum = if is_leap_year(year) { 366 } else { 365 };
    let remaining = _integer(ordinal, 1, maximum, "day of year");
    let month = 1;
    while remaining > days_in_month(year, month) {
        remaining = remaining - days_in_month(year, month);
        month = month + 1;
    }
    return map{ year: year, month: month, day: remaining };
}

fn location(latitude, longitude, utc_offset_minutes = 0) {
    let offset = _integer(utc_offset_minutes, -840, 840, "UTC offset minutes");
    return map{
        latitude: _finite(latitude, -90, 90, "latitude"),
        longitude: _finite(longitude, -180, 180, "longitude"),
        utc_offset_minutes: offset
    };
}

fn _pad2(value) { if value < 10 { return "0" + str(value); } return str(value); }
fn _date_text(date) {
    return str(date.year) + "-" + _pad2(date.month) + "-" + _pad2(date.day);
}

fn _civil_event(total_minutes) {
    let day_offset = num_floor(total_minutes / 1440);
    let minute = total_minutes - day_offset * 1440;
    let rounded = num_floor(minute + 0.5);
    if rounded >= 1440 { rounded = rounded - 1440; day_offset = day_offset + 1; }
    let hour = num_floor(rounded / 60);
    let clock_minute = rounded - hour * 60;
    return map{
        total_minutes: total_minutes, minute: minute, day_offset: day_offset,
        hour: hour, clock_minute: clock_minute,
        clock: _pad2(hour) + ":" + _pad2(clock_minute)
    };
}

fn solar_day(year, month, day, observer) {
    let date = validate_date(year, month, day);
    if not is_map(observer) { throw "astronomy: observer must be a location map"; }
    let site = location(try observer.latitude catch nil, try observer.longitude catch nil,
        try observer.utc_offset_minutes catch 0);
    let ordinal = day_of_year(date.year, date.month, date.day);
    let days = if is_leap_year(date.year) { 366 } else { 365 };
    let gamma = 2 * Math.PI / days * (ordinal - 1);
    let equation_minutes = 229.18 * (0.000075
        + 0.001868 * Math.cos(gamma) - 0.032077 * Math.sin(gamma)
        - 0.014615 * Math.cos(2 * gamma) - 0.040849 * Math.sin(2 * gamma));
    let declination = 0.006918 - 0.399912 * Math.cos(gamma)
        + 0.070257 * Math.sin(gamma) - 0.006758 * Math.cos(2 * gamma)
        + 0.000907 * Math.sin(2 * gamma) - 0.002697 * Math.cos(3 * gamma)
        + 0.00148 * Math.sin(3 * gamma);
    let latitude_radians = Math.deg_to_rad(site.latitude);
    let zenith_radians = Math.deg_to_rad(APPARENT_ZENITH_DEGREES);
    let denominator = Math.cos(latitude_radians) * Math.cos(declination);
    let hour_angle_cosine = (Math.cos(zenith_radians) / denominator)
        - Math.tan(latitude_radians) * Math.tan(declination);
    let solar_noon_minutes = 720 - 4 * site.longitude - equation_minutes
        + site.utc_offset_minutes;
    let noon = _civil_event(solar_noon_minutes);

    let status = "normal";
    let daylight_minutes = 0;
    let sunrise = nil;
    let sunset = nil;
    if hour_angle_cosine > 1 {
        status = "polar-night";
    } elif hour_angle_cosine < -1 {
        status = "polar-day";
        daylight_minutes = 1440;
    } else {
        let hour_angle_degrees = Math.rad_to_deg(Math.acos(hour_angle_cosine));
        daylight_minutes = hour_angle_degrees * 8;
        sunrise = _civil_event(solar_noon_minutes - hour_angle_degrees * 4);
        sunset = _civil_event(solar_noon_minutes + hour_angle_degrees * 4);
    }
    return map{
        ok: true, format: FORMAT, date: date, date_text: _date_text(date),
        observer: site, status: status, sunrise: sunrise, solar_noon: noon,
        sunset: sunset, daylight_minutes: daylight_minutes,
        equation_of_time_minutes: equation_minutes,
        solar_declination_degrees: Math.rad_to_deg(declination),
        lunar_events: map{
            supported: false, reason: "verified lunar ephemeris is not implemented"
        },
        approximation: "fractional-year-solar-v1", apparent_zenith_degrees: APPARENT_ZENITH_DEGREES,
        bounded: true, network_access: false, stored_coordinates: false
    };
}

fn year_series(year, observer, step_days = 1) {
    year = _integer(year, 1600, 9999, "year");
    step_days = _integer(step_days, 1, 31, "step days");
    let total_days = if is_leap_year(year) { 366 } else { 365 };
    let rows = [];
    let minimum = 1441;
    let maximum = -1;
    let shortest = nil;
    let longest = nil;
    let ordinal = 1;
    while ordinal <= total_days {
        if len(rows) >= MAX_YEAR_SAMPLES { throw "astronomy: sample count limit exceeded"; }
        let date = _date_from_ordinal(year, ordinal);
        let event = solar_day(date.year, date.month, date.day, observer);
        array_push(rows, map{
            ordinal: ordinal, date: event.date_text, status: event.status,
            sunrise: event.sunrise, solar_noon: event.solar_noon,
            sunset: event.sunset, daylight_minutes: event.daylight_minutes
        });
        if event.daylight_minutes < minimum { minimum = event.daylight_minutes; shortest = event; }
        if event.daylight_minutes > maximum { maximum = event.daylight_minutes; longest = event; }
        ordinal = ordinal + step_days;
    }
    return map{
        ok: true, format: "pblang.astronomy.solar-series.v1", year: year,
        observer: location(observer.latitude, observer.longitude, observer.utc_offset_minutes),
        step_days: step_days, samples: rows, sample_count: len(rows),
        shortest: shortest, longest: longest, minimum_daylight_minutes: minimum,
        maximum_daylight_minutes: maximum, bounded: true,
        complete_daily_year: step_days == 1 and len(rows) == total_days
    };
}

fn capabilities() {
    return map{
        solar_rise_set: true, civil_time_offsets: true, polar_day_night: true,
        yearly_series: true, lunar_rise_set: false, high_precision_ephemeris: false,
        network_required: false
    };
}

export FORMAT, APPARENT_ZENITH_DEGREES, MAX_YEAR_SAMPLES;
export is_leap_year, days_in_month, validate_date, day_of_year;
export location, solar_day, year_series, capabilities;
