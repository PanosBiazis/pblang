// stdlib/units.sapp — Unit conversion library for pblang.
//
// Comprehensive unit conversions across all major categories.
// All values use standard SI/metric as the intermediate representation.
//
// Usage:
//   let u = import("stdlib:units.sapp");
//   let km = u.length.miles_to_km(26.2);  // marathon → km
//   let f = u.temperature.c_to_f(100);     // boiling point
//   let kg = u.mass.lbs_to_kg(150);        // weight

// ── Length / Distance ─────────────────────────────────────────────────────────

fn mi_to_km(mi) { return mi * 1.609344; }
fn km_to_mi(km) { return km / 1.609344; }
fn ft_to_m(ft)  { return ft * 0.3048; }
fn m_to_ft(m)   { return m / 0.3048; }
fn in_to_cm(inch) { return inch * 2.54; }
fn cm_to_in(cm) { return cm / 2.54; }
fn yd_to_m(yd)  { return yd * 0.9144; }
fn m_to_yd(m)   { return m / 0.9144; }
fn nm_to_km(nm) { return nm * 1.852; }
fn km_to_nm(km) { return km / 1.852; }

// ── Mass / Weight ─────────────────────────────────────────────────────────────

fn lbs_to_kg(lbs) { return lbs * 0.45359237; }
fn kg_to_lbs(kg)  { return kg / 0.45359237; }
fn oz_to_g(oz)    { return oz * 28.3495231; }
fn g_to_oz(g)     { return g / 28.3495231; }
fn st_to_kg(st)   { return st * 6.35029318; }
fn kg_to_st(kg)   { return kg / 6.35029318; }

// ── Temperature ───────────────────────────────────────────────────────────────

fn c_to_f(c) { return c * 9 / 5 + 32; }
fn f_to_c(f) { return (f - 32) * 5 / 9; }
fn c_to_k(c) { return c + 273.15; }
fn k_to_c(k) { return k - 273.15; }
fn f_to_k(f) { return c_to_k(f_to_c(f)); }
fn k_to_f(k) { return c_to_f(k_to_c(k)); }

// ── Volume ────────────────────────────────────────────────────────────────────

fn gal_to_l(gal)  { return gal * 3.78541178; }
fn l_to_gal(l)    { return l / 3.78541178; }
fn qt_to_l(qt)    { return qt * 0.946352946; }
fn l_to_qt(l)     { return l / 0.946352946; }
fn floz_to_ml(oz) { return oz * 29.5735296; }
fn ml_to_floz(ml) { return ml / 29.5735296; }
fn cup_to_ml(cup) { return cup * 236.588236; }
fn ml_to_cup(ml)  { return ml / 236.588236; }
fn tbsp_to_ml(tbsp) { return tbsp * 14.7867648; }
fn ml_to_tbsp(ml)   { return ml / 14.7867648; }

// ── Speed ─────────────────────────────────────────────────────────────────────

fn mph_to_kph(mph) { return mph * 1.609344; }
fn kph_to_mph(kph) { return kph / 1.609344; }
fn mps_to_kph(mps) { return mps * 3.6; }
fn kph_to_mps(kph) { return kph / 3.6; }
fn knot_to_kph(kn) { return kn * 1.852; }
fn kph_to_knot(kph){ return kph / 1.852; }

// ── Area ──────────────────────────────────────────────────────────────────────

fn sqft_to_sqm(sqft)  { return sqft * 0.09290304; }
fn sqm_to_sqft(sqm)   { return sqm / 0.09290304; }
fn acre_to_sqm(acre)  { return acre * 4046.85642; }
fn sqm_to_acre(sqm)   { return sqm / 4046.85642; }
fn sqmi_to_sqkm(sqmi) { return sqmi * 2.58998811; }
fn sqkm_to_sqmi(sqkm) { return sqkm / 2.58998811; }

// ── Pressure ──────────────────────────────────────────────────────────────────

fn psi_to_kpa(psi)  { return psi * 6.89475729; }
fn kpa_to_psi(kpa)  { return kpa / 6.89475729; }
fn atm_to_kpa(atm)  { return atm * 101.325; }
fn kpa_to_atm(kpa)  { return kpa / 101.325; }
fn bar_to_kpa(bar)  { return bar * 100; }
fn kpa_to_bar(kpa)  { return kpa / 100; }

// ── Energy ────────────────────────────────────────────────────────────────────

fn cal_to_j(cal)   { return cal * 4.184; }
fn j_to_cal(j)     { return j / 4.184; }
fn kcal_to_kj(kcal){ return kcal * 4.184; }
fn kj_to_kcal(kj)  { return kj / 4.184; }
fn kwh_to_j(kwh)   { return kwh * 3600000; }
fn j_to_kwh(j)     { return j / 3600000; }
fn btu_to_kj(btu)  { return btu * 1.05505585; }
fn kj_to_btu(kj)   { return kj / 1.05505585; }

// ── Power ─────────────────────────────────────────────────────────────────────

fn hp_to_kw(hp) { return hp * 0.745699872; }
fn kw_to_hp(kw) { return kw / 0.745699872; }

// ── Data storage ──────────────────────────────────────────────────────────────

fn bytes_to_kb(b) { return b / 1024; }
fn kb_to_bytes(kb){ return kb * 1024; }
fn bytes_to_mb(b) { return b / 1048576; }
fn mb_to_bytes(mb){ return mb * 1048576; }
fn bytes_to_gb(b) { return b / 1073741824; }
fn gb_to_bytes(gb){ return gb * 1073741824; }

// ── Time ──────────────────────────────────────────────────────────────────────

fn ms_to_s(ms)     { return ms / 1000; }
fn s_to_ms(s)      { return s * 1000; }
fn min_to_s(min)   { return min * 60; }
fn s_to_min(s)     { return s / 60; }
fn hr_to_s(hr)     { return hr * 3600; }
fn s_to_hr(s)      { return s / 3600; }
fn days_to_s(days) { return days * 86400; }
fn s_to_days(s)    { return s / 86400; }
fn yr_to_s(yr)     { return yr * 31557600; }
fn s_to_yr(s)      { return s / 31557600; }

// ── Angle ─────────────────────────────────────────────────────────────────────

fn deg_to_rad(deg) { return deg * 0.0174532925; }
fn rad_to_deg(rad) { return rad * 57.2957795; }

// ── Fuel economy ──────────────────────────────────────────────────────────────

fn mpg_to_lp100km(mpg) { return 235.214583 / mpg; }
fn lp100km_to_mpg(lp100) { return 235.214583 / lp100; }

// ── Generic factor-table conversion ───────────────────────────────────────────
// Each unit maps to { cat, f } where f is its size in the category's SI base
// (length→m, mass→kg, time→s, data→bytes). convert() rejects cross-category pairs.

let _FACTORS = map{
    // length (meters)
    m:  map{ cat: "length", f: 1 },        km: map{ cat: "length", f: 1000 },
    cm: map{ cat: "length", f: 0.01 },     mm: map{ cat: "length", f: 0.001 },
    mi: map{ cat: "length", f: 1609.344 }, ft: map{ cat: "length", f: 0.3048 },
    in: map{ cat: "length", f: 0.0254 },   yd: map{ cat: "length", f: 0.9144 },
    nmi: map{ cat: "length", f: 1852 },
    // mass (kilograms)
    kg: map{ cat: "mass", f: 1 },          g:  map{ cat: "mass", f: 0.001 },
    mg: map{ cat: "mass", f: 0.000001 },   lb: map{ cat: "mass", f: 0.45359237 },
    oz: map{ cat: "mass", f: 0.0283495231 }, st: map{ cat: "mass", f: 6.35029318 },
    ton: map{ cat: "mass", f: 1000 },
    // time (seconds)
    s:   map{ cat: "time", f: 1 },         ms: map{ cat: "time", f: 0.001 },
    min: map{ cat: "time", f: 60 },        hr: map{ cat: "time", f: 3600 },
    day: map{ cat: "time", f: 86400 },     yr: map{ cat: "time", f: 31557600 },
    // data (bytes)
    b:  map{ cat: "data", f: 1 },          kb: map{ cat: "data", f: 1024 },
    mb: map{ cat: "data", f: 1048576 },    gb: map{ cat: "data", f: 1073741824 },
    tb: map{ cat: "data", f: 1099511627776 }
};

// convert(value, from, to) — generic conversion within one category.
fn convert(value, from, to) {
    if not map_has(_FACTORS, from) or not map_has(_FACTORS, to) {
        return error("units.convert: unknown unit (" + str(from) + " / " + str(to) + ")");
    }
    let a = _FACTORS[from];
    let b = _FACTORS[to];
    if a.cat != b.cat { return error("units.convert: incompatible categories " + a.cat + " vs " + b.cat); }
    return value * a.f / b.f;
}

// convert_temp(value, from, to) — temperature scales (C/F/K), which are affine.
fn convert_temp(value, from, to) {
    let c = value;
    if from == "C" { c = value; }
    else if from == "F" { c = f_to_c(value); }
    else if from == "K" { c = k_to_c(value); }
    else { return error("units.convert_temp: unknown unit " + str(from)); }
    if to == "C" { return c; }
    if to == "F" { return c_to_f(c); }
    if to == "K" { return c_to_k(c); }
    return error("units.convert_temp: unknown unit " + str(to));
}

// ── Cooking ───────────────────────────────────────────────────────────────────

fn fahrenheit_to_celsius(f) { return f_to_c(f); }
fn celsius_to_fahrenheit(c) { return c_to_f(c); }
fn cups_to_ml(cups) { return cup_to_ml(cups); }
fn ml_to_cups(ml) { return ml_to_cup(ml); }

export mi_to_km, km_to_mi, ft_to_m, m_to_ft, in_to_cm, cm_to_in, yd_to_m, m_to_yd, nm_to_km, km_to_nm;
export lbs_to_kg, kg_to_lbs, oz_to_g, g_to_oz, st_to_kg, kg_to_st;
export c_to_f, f_to_c, c_to_k, k_to_c, f_to_k, k_to_f;
export gal_to_l, l_to_gal, qt_to_l, l_to_qt, floz_to_ml, ml_to_floz, cup_to_ml, ml_to_cup, tbsp_to_ml, ml_to_tbsp;
export mph_to_kph, kph_to_mph, mps_to_kph, kph_to_mps, knot_to_kph, kph_to_knot;
export sqft_to_sqm, sqm_to_sqft, acre_to_sqm, sqm_to_acre, sqmi_to_sqkm, sqkm_to_sqmi;
export psi_to_kpa, kpa_to_psi, atm_to_kpa, kpa_to_atm, bar_to_kpa, kpa_to_bar;
export cal_to_j, j_to_cal, kcal_to_kj, kj_to_kcal, kwh_to_j, j_to_kwh, btu_to_kj, kj_to_btu;
export hp_to_kw, kw_to_hp;
export bytes_to_kb, kb_to_bytes, bytes_to_mb, mb_to_bytes, bytes_to_gb, gb_to_bytes;
export ms_to_s, s_to_ms, min_to_s, s_to_min, hr_to_s, s_to_hr, days_to_s, s_to_days, yr_to_s, s_to_yr;
export deg_to_rad, rad_to_deg;
export mpg_to_lp100km, lp100km_to_mpg;
export fahrenheit_to_celsius, celsius_to_fahrenheit, cups_to_ml, ml_to_cups;
export convert, convert_temp;


// Explicit engineering symbols. Legacy lowercase kb/mb/gb remain binary bytes.
let _ENGINEERING=map{
    V:map{cat:"voltage",f:1},mV:map{cat:"voltage",f:0.001},
    A:map{cat:"current",f:1},mA:map{cat:"current",f:0.001},uA:map{cat:"current",f:0.000001},
    ohm:map{cat:"resistance",f:1},kohm:map{cat:"resistance",f:1000},Mohm:map{cat:"resistance",f:1000000},
    W:map{cat:"power",f:1},mW:map{cat:"power",f:0.001},kW:map{cat:"power",f:1000},
    Hz:map{cat:"frequency",f:1},kHz:map{cat:"frequency",f:1000},MHz:map{cat:"frequency",f:1000000},
    F:map{cat:"capacitance",f:1},uF:map{cat:"capacitance",f:0.000001},nF:map{cat:"capacitance",f:0.000000001},pF:map{cat:"capacitance",f:0.000000000001},
    Pa:map{cat:"pressure",f:1},kPa:map{cat:"pressure",f:1000},bar:map{cat:"pressure",f:100000},
    J:map{cat:"energy",f:1},kJ:map{cat:"energy",f:1000},Wh:map{cat:"energy",f:3600},kWh:map{cat:"energy",f:3600000},
    L:map{cat:"volume",f:1},mL:map{cat:"volume",f:0.001},
    m2:map{cat:"area",f:1},cm2:map{cat:"area",f:0.0001},km2:map{cat:"area",f:1000000},
    B:map{cat:"data",f:1},kB:map{cat:"data",f:1000},MB:map{cat:"data",f:1000000},GB:map{cat:"data",f:1000000000},
    KiB:map{cat:"data",f:1024},MiB:map{cat:"data",f:1048576},GiB:map{cat:"data",f:1073741824}
};
for symbol in map_keys(_ENGINEERING) { _FACTORS[symbol]=_ENGINEERING[symbol]; }
let MAX_CHECKED_VALUE=1000000000000; let MAX_BATCH_VALUES=512;
fn _checked_number(value) {
    if type(value)!="number" or not (value>= -MAX_CHECKED_VALUE and value<=MAX_CHECKED_VALUE) {throw "units: expected finite value within +/- 1e12";}
}
fn describe_unit(symbol) {
    if type(symbol)!="string" or len(symbol)>16 {throw "units: invalid unit symbol";}
    if symbol=="degC" or symbol=="degF" or symbol=="K" {
        return map{symbol:symbol,category:"temperature",scale:if symbol=="degF" {5/9} else {1},affine:true};
    }
    if not map_has(_FACTORS,symbol) {throw "units: unknown unit symbol";}
    let item=_FACTORS[symbol];return map{symbol:symbol,category:item.cat,scale:item.f,affine:false};
}
fn catalog(category=nil) {
    if category!=nil and (type(category)!="string" or len(category)>32) {throw "units: invalid category";}
    let names=map_keys(_FACTORS);for name in ["degC","degF","K"] {array_push(names,name);}
    let out=[];for name in array_sort(names) {let info=describe_unit(name);if category==nil or info.category==category {array_push(out,info);}}
    return out;
}
fn _pair(from,to,mode) {
    if mode!="absolute" and mode!="difference" {throw "units: choose absolute or difference";}
    let a=describe_unit(from);let b=describe_unit(to);
    if a.category!=b.category {throw "units: incompatible categories";}return [a,b];
}
fn _checked_conversion(value,a,b,mode) {
    _checked_number(value);let out=0;
    if a.affine and mode=="absolute" {
        let kelvin=value;
        if a.symbol=="degC" {kelvin=value+273.15;}
        elif a.symbol=="degF" {kelvin=(value+459.67)*5/9;}
        if kelvin<0 {throw "units: temperature below absolute zero";}
        out=kelvin;
        if b.symbol=="degC" {out=kelvin-273.15;}
        elif b.symbol=="degF" {out=kelvin*9/5-459.67;}
        // Avoid subtracting large offsets for direct C/F conversions.
        if a.symbol=="degC" and b.symbol=="degF" {out=c_to_f(value);}
        elif a.symbol=="degF" and b.symbol=="degC" {out=f_to_c(value);}
    } else {
        out=value*(a.scale/b.scale);
        if value!=0 and out==0 {throw "units: conversion underflow";}
    }
    if a.symbol==b.symbol {out=value;}
    _checked_number(out);return out;
}
fn convert_checked(value,from,to,mode="absolute") {let pair=_pair(from,to,mode);return _checked_conversion(value,pair[0],pair[1],mode);}
// Resolve the pair once for homogeneous batches, while checking every value.
fn convert_many(values,from,to,mode="absolute") {
    if type(values)!="array" or len(values)>MAX_BATCH_VALUES {throw "units: batch limit";}
    let pair=_pair(from,to,mode);let out=[];
    for value in values {array_push(out,_checked_conversion(value,pair[0],pair[1],mode));}return out;
}
export MAX_CHECKED_VALUE,MAX_BATCH_VALUES,describe_unit,catalog,convert_checked,convert_many;
