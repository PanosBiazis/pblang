// stdlib/color.sapp — Color manipulation (RGB, HSL, hex, terminal ANSI).
fn hex_to_rgb(hex) {
    let h = hex;
    if str_starts_with(h, "#") { h = str_slice(h, 1, len(h)); }
    let r = try parse_number("0x" + str_slice(h, 0, 2)) catch 0;
    let g = try parse_number("0x" + str_slice(h, 2, 4)) catch 0;
    let b = try parse_number("0x" + str_slice(h, 4, 6)) catch 0;
    return map{ r: r, g: g, b: b };
}
fn rgb_to_hex(r, g, b) {
    fn _h(n) { let hex = "0123456789abcdef"; return str_slice(hex, num_floor(n/16), num_floor(n/16)+1) + str_slice(hex, n%16, (n%16)+1); }
    return "#" + _h(r) + _h(g) + _h(b);
}
fn lerp_color(c1, c2, t) {
    return map{
        r: num_floor(c1.r + (c2.r - c1.r) * t),
        g: num_floor(c1.g + (c2.g - c1.g) * t),
        b: num_floor(c1.b + (c2.b - c1.b) * t)
    };
}
fn ansi_fg(r, g, b) { return "\x1b[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"; }
fn ansi_bg(r, g, b) { return "\x1b[48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"; }
fn ansi_reset() { return "\x1b[0m"; }
fn bold() { return "\x1b[1m"; }
fn dim() { return "\x1b[2m"; }
fn underline() { return "\x1b[4m"; }
fn red(text) { return "\x1b[31m" + text + "\x1b[0m"; }
fn green(text) { return "\x1b[32m" + text + "\x1b[0m"; }
fn yellow(text) { return "\x1b[33m" + text + "\x1b[0m"; }
fn blue(text) { return "\x1b[34m" + text + "\x1b[0m"; }
fn cyan(text) { return "\x1b[36m" + text + "\x1b[0m"; }
fn magenta(text) { return "\x1b[35m" + text + "\x1b[0m"; }
export hex_to_rgb, rgb_to_hex, lerp_color, ansi_fg, ansi_bg, ansi_reset,
       bold, dim, underline, red, green, yellow, blue, cyan, magenta;
