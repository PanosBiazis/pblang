// stdlib/color.sapp -- deprecated compatibility layer.
//
// New code should import `stdlib:colors.sapp`. This module keeps the old API
// shape alive while delegating shared color math to the fuller colors library.

let COLORS = import("stdlib:colors.sapp");

fn deprecated_status() {
    return map{
        deprecated: true,
        replacement: "stdlib:colors.sapp",
        note: "stdlib/color.sapp is a compatibility shim; use colors.sapp for new color work"
    };
}

fn hex_to_rgb(hex) {
    let rgb = COLORS.hex_to_rgb(hex);
    if rgb == nil { return map{ r: 0, g: 0, b: 0 }; }
    return rgb;
}

fn rgb_to_hex(r, g, b) {
    return COLORS.rgb_to_hex(map{ r: r, g: g, b: b });
}

fn lerp_color(c1, c2, t) {
    return COLORS.mix(c1, c2, t);
}

fn ansi_fg(r, g, b) { return "\x1b[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"; }
fn ansi_bg(r, g, b) { return "\x1b[48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"; }
fn ansi_reset() { return "\x1b[0m"; }
fn bold() { return "\x1b[1m"; }
fn dim() { return "\x1b[2m"; }
fn underline() { return "\x1b[4m"; }
fn red(text) { return "\x1b[31m" + text + "\x1b[0m"; }
fn green(text) { return "\x1b[32m" + text + "\x1b[0m"; }
fn yellow(text) { return "\x1b[33m" + text + "\x1b[0m"; }
fn blue(text) { return "\x1b[34m" + text + "\x1b[0m"; }
fn cyan(text) { return "\x1b[36m" + text + "\x1b[0m"; }
fn magenta(text) { return "\x1b[35m" + text + "\x1b[0m"; }

export deprecated_status, hex_to_rgb, rgb_to_hex, lerp_color, ansi_fg, ansi_bg, ansi_reset,
       bold, dim, underline, red, green, yellow, blue, cyan, magenta;
