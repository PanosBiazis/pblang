// stdlib/llm_tokenizer.sapp -- pblang-native tokenizer primitives for LLM work.
//
// Provides a simple character tokenizer and a small trainable BPE tokenizer. This is
// a real tokenizer contract, not a provider wrapper: vocab, merges, encode, decode,
// save/load, and metadata are all pblang-native.

fn _chars(text) {
    let out = [];
    let i = 0;
    while i < len(text) {
        push(out, strfromcharcode(strcharcodeat(text, i)));
        i = i + 1;
    }
    return out;
}

fn _contains(arr, v) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == v { return true; }
        i = i + 1;
    }
    return false;
}

fn _add_token(vocab, id_to_token, token) {
    if not map_has(vocab, token) {
        vocab[token] = len(id_to_token);
        push(id_to_token, token);
    }
}

fn char_train(text) {
    let vocab = map{};
    let id_to_token = [];
    _add_token(vocab, id_to_token, "<pad>");
    _add_token(vocab, id_to_token, "<bos>");
    _add_token(vocab, id_to_token, "<eos>");
    _add_token(vocab, id_to_token, "<unk>");
    let cs = _chars(text);
    let i = 0;
    while i < len(cs) {
        _add_token(vocab, id_to_token, cs[i]);
        i = i + 1;
    }
    return map{
        format: "pblang.tokenizer.char.v1",
        kind: "char",
        vocab: vocab,
        id_to_token: id_to_token,
        merges: [],
        pad_id: 0,
        bos_id: 1,
        eos_id: 2,
        unk_id: 3
    };
}

let _PAIR_SEP = "<<<PBLANG_LLM_PAIR>>>";

fn _pair_key(a, b) { return a + _PAIR_SEP + b; }

fn _best_pair(seqs) {
    let counts = map{};
    let best = "";
    let best_count = 0;
    let s = 0;
    while s < len(seqs) {
        let toks = seqs[s];
        let i = 0;
        while i + 1 < len(toks) {
            let key = _pair_key(toks[i], toks[i + 1]);
            if not map_has(counts, key) { counts[key] = 0; }
            counts[key] = counts[key] + 1;
            if counts[key] > best_count {
                best_count = counts[key];
                best = key;
            }
            i = i + 1;
        }
        s = s + 1;
    }
    return map{ key: best, count: best_count };
}

fn _merge_seq(seq, left, right, merged) {
    let out = [];
    let i = 0;
    while i < len(seq) {
        if i + 1 < len(seq) and seq[i] == left and seq[i + 1] == right {
            push(out, merged);
            i = i + 2;
        } else {
            push(out, seq[i]);
            i = i + 1;
        }
    }
    return out;
}

fn _split_pair_key(key) {
    let idx = str_index_of(key, _PAIR_SEP);
    return [str_slice(key, 0, idx), str_slice(key, idx + len(_PAIR_SEP), len(key))];
}

fn bpe_train(text, vocab_limit = 256, min_pair_count = 2) {
    let base = char_train(text);
    let vocab = base.vocab;
    let id_to_token = base.id_to_token;
    let seqs = [_chars(text)];
    let merges = [];

    while len(id_to_token) < vocab_limit {
        let best = _best_pair(seqs);
        if best.key == "" or best.count < min_pair_count { break; }
        let pair = _split_pair_key(best.key);
        let left = pair[0];
        let right = pair[1];
        let merged = left + right;
        if map_has(vocab, merged) { break; }
        _add_token(vocab, id_to_token, merged);
        push(merges, [left, right, merged]);
        let next = [];
        let i = 0;
        while i < len(seqs) {
            push(next, _merge_seq(seqs[i], left, right, merged));
            i = i + 1;
        }
        seqs = next;
    }

    return map{
        format: "pblang.tokenizer.bpe.v1",
        kind: "bpe",
        vocab: vocab,
        id_to_token: id_to_token,
        merges: merges,
        pad_id: 0,
        bos_id: 1,
        eos_id: 2,
        unk_id: 3
    };
}

fn _apply_merges(tokens, merges) {
    let out = tokens;
    let i = 0;
    while i < len(merges) {
        out = _merge_seq(out, merges[i][0], merges[i][1], merges[i][2]);
        i = i + 1;
    }
    return out;
}

fn encode(tok, text, add_bos = false, add_eos = false) {
    let tokens = _chars(text);
    if tok.kind == "bpe" { tokens = _apply_merges(tokens, tok.merges); }
    let ids = [];
    if add_bos { push(ids, tok.bos_id); }
    let i = 0;
    while i < len(tokens) {
        if map_has(tok.vocab, tokens[i]) { push(ids, tok.vocab[tokens[i]]); }
        else { push(ids, tok.unk_id); }
        i = i + 1;
    }
    if add_eos { push(ids, tok.eos_id); }
    return ids;
}

fn decode(tok, ids, skip_special = true) {
    let out = "";
    let i = 0;
    while i < len(ids) {
        let id = ids[i];
        if id >= 0 and id < len(tok.id_to_token) {
            let t = tok.id_to_token[id];
            if not skip_special or (t != "<pad>" and t != "<bos>" and t != "<eos>" and t != "<unk>") {
                out = out + t;
            }
        }
        i = i + 1;
    }
    return out;
}

fn save(path, tok) { return fs_write(path, json_stringify(tok)); }
fn load(path) { return json_parse(fs_read(path)); }

fn summary(tok) {
    return map{
        format: tok.format,
        kind: tok.kind,
        vocab_size: len(tok.id_to_token),
        merges: len(tok.merges),
        pad_id: tok.pad_id,
        bos_id: tok.bos_id,
        eos_id: tok.eos_id,
        unk_id: tok.unk_id
    };
}

export char_train, bpe_train, encode, decode, save, load, summary;
