// Exact bounded integer apportionment presented as a literal Sheet.
let Allocate=import("stdlib:integer_allocation.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn integer(text){if type(text)!="string" or len(text)>64 or len(str_to_bytes(text))>64{throw "invalid integer text";}let token=str_trim(text);if len(token)<1 or len(token)>7{throw "expected integer 0..1000000";}for i in range(0,len(token)){if str_index_of("0123456789",str_slice(token,i,i+1))<0{throw "expected ASCII integer";}}let value=parse_number(token);if value>1000000{throw "integer exceeds limit";}return value;}
fn weights(text){if type(text)!="string" or len(text)>2048 or len(str_to_bytes(text))>2048{throw "invalid weight list";}let items=str_split(text,",");if len(items)<1 or len(items)>31{throw "at most 31 weights";}let values=[];for item in items{array_push(values,integer(item));}return values;}
fn create(labels,weights,total,unit="Units"){
 if type(labels)!="array" or len(labels)<1 or len(labels)>31 or type(weights)!="array" or len(weights)!=len(labels){throw "labels and weights must have equal bounded length";}
 if type(unit)!="string" or len(unit)>24 or len(str_to_bytes(unit))<1 or len(str_to_bytes(unit))>24 or str_trim(unit)==""{throw "invalid allocation unit";}for i in range(0,len(unit)){let c=strcharcodeat(unit,i);if c<32 or c==127{throw "invalid unit control";}}
 let report=Allocate.distribute(total,weights);let cells=[["Label","Weight",unit]];
 for i in range(0,len(labels)){if type(labels[i])!="string" or len(labels[i])>256 or len(str_to_bytes(labels[i]))>256 or str_trim(labels[i])==""{throw "nonblank labels required";}array_push(cells,[labels[i],str(weights[i]),str(report.shares[i])]);}
 let document=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(document);return map{format:"pblang.allocation-table.v1",document:document,total:report.total,rows:len(labels),unit:unit,method:report.method};
}
fn from_sheet(doc,total){let size=Sheet.validate(doc);if size.columns!=2 or size.rows<2 or doc.cells[0]!=["Label","Weight"]{throw "expected Label,Weight header and 1..31 rows";}let labels=[];let values=[];for i in range(1,size.rows){array_push(labels,doc.cells[i][0]);array_push(values,integer(doc.cells[i][1]));}return create(labels,values,total);}
export integer,weights,create,from_sheet;
