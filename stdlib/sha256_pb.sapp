// stdlib/sha256_pb.sapp — a PURE-pblang SHA-256 (FIPS 180-4), no native `sha256` builtin.
//
// Why: the native `sha256` builtin is a zero-returning stub in the C-transpiler runtime, so any
// program that hashes computes wrong results when native-compiled. This implementation uses only
// pblang's 32-bit bitwise builtins (bit_and/bit_or/bit_xor/bit_shl/bit_shr/bit_not) + str_to_bytes,
// so it transpiles to correct C and runs identically interpreted or native — a step toward
// "everything in pblang". Output is 64-char lowercase hex, byte-for-byte identical to the builtin.
//
//   let S = import("stdlib/sha256_pb.sapp");
//   S.sha256_hex("hello");   // "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"

let _MASK = 4294967295;   // 0xFFFFFFFF

// Round constants (first 32 bits of the fractional parts of the cube roots of the first 64 primes).
let _K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];

// 32-bit ops -------------------------------------------------------------------------------
fn _and(a, b) { return bit_and(a, b); }
fn _xor(a, b) { return bit_xor(a, b); }
// Right-rotate a 32-bit word. `bit_shl(x, 32-n)` alone can reach ~2^62 and lose f64 precision,
// so first isolate the low n bits (`x & (2^n - 1)`, computed as `_MASK >> (32-n)`); shifting THAT
// left by 32-n stays < 2^32 and is exact. No post-mask needed (both halves already fit 32 bits).
fn _rotr(x, n) {
    let low = bit_and(x, bit_shr(_MASK, 32 - n));
    return bit_or(bit_shr(x, n), bit_shl(low, 32 - n));
}
fn _shr(x, n) { return bit_shr(x, n); }
fn _not(x) { return bit_and(bit_not(x), _MASK); }
fn _add(a, b) { return bit_and(a + b, _MASK); }

fn _hex8(n) {
    let digits = "0123456789abcdef";
    let out = "";
    let i = 7;
    while i >= 0 {
        let nib = bit_and(bit_shr(n, i * 4), 15);
        out = out + str_slice(digits, nib, nib + 1);
        i = i - 1;
    }
    return out;
}

fn _compress(ctx, data, base) {
        let w = [];
        let t = 0;
        while t < 16 {
            let o = base + t * 4;
            let word = bit_and(bit_or(bit_or(bit_shl(data[o], 24), bit_shl(data[o + 1], 16)),
                                      bit_or(bit_shl(data[o + 2], 8), data[o + 3])), _MASK);
            push(w, word);
            t = t + 1;
        }
        t = 16;
        while t < 64 {
            let w15 = w[t - 15];
            let w2b = w[t - 2];
            let s0 = _xor(_xor(_rotr(w15, 7), _rotr(w15, 18)), _shr(w15, 3));
            let s1 = _xor(_xor(_rotr(w2b, 17), _rotr(w2b, 19)), _shr(w2b, 10));
            push(w, _add(_add(w[t - 16], s0), _add(w[t - 7], s1)));
            t = t + 1;
        }

        let a = ctx.h[0]; let b = ctx.h[1]; let c = ctx.h[2]; let d = ctx.h[3];
        let e = ctx.h[4]; let f = ctx.h[5]; let g = ctx.h[6]; let hh = ctx.h[7];
        t = 0;
        while t < 64 {
            let S1 = _xor(_xor(_rotr(e, 6), _rotr(e, 11)), _rotr(e, 25));
            let ch = _xor(_and(e, f), _and(_not(e), g));
            let temp1 = _add(_add(_add(hh, S1), _add(ch, _K[t])), w[t]);
            let S0 = _xor(_xor(_rotr(a, 2), _rotr(a, 13)), _rotr(a, 22));
            let maj = _xor(_xor(_and(a, b), _and(a, c)), _and(b, c));
            let temp2 = _add(S0, maj);
            hh = g; g = f; f = e; e = _add(d, temp1); d = c; c = b; b = a; a = _add(temp1, temp2);
            t = t + 1;
        }
        ctx.h[0] = _add(ctx.h[0], a); ctx.h[1] = _add(ctx.h[1], b);
        ctx.h[2] = _add(ctx.h[2], c); ctx.h[3] = _add(ctx.h[3], d);
        ctx.h[4] = _add(ctx.h[4], e); ctx.h[5] = _add(ctx.h[5], f);
        ctx.h[6] = _add(ctx.h[6], g); ctx.h[7] = _add(ctx.h[7], hh);
}

fn new() {
    return map{ format: "pblang.sha256-state.v1", total_bytes: 0, tail: [], finished: false,
        h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
            0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] };
}

fn update(ctx, bytes) {
    if type(ctx) != "map" or (try ctx.format catch "") != "pblang.sha256-state.v1"
        or (try ctx.finished catch true) or not is_array(bytes) {
        throw "sha256: invalid or finalized state";
    }
    let i = 0;
    while i < len(bytes) {
        let byte = bytes[i];
        if type(byte) != "number" or num_floor(byte) != byte or byte < 0 or byte > 255 {
            throw "sha256: invalid byte";
        }
        array_push(ctx.tail, byte); ctx.total_bytes = ctx.total_bytes + 1;
        if len(ctx.tail) == 64 { _compress(ctx, ctx.tail, 0); ctx.tail = []; }
        i = i + 1;
    }
    return ctx;
}

fn finish(ctx) {
    if type(ctx) != "map" or (try ctx.format catch "") != "pblang.sha256-state.v1"
        or (try ctx.finished catch true) { throw "sha256: invalid or finalized state"; }
    let data = [];
    for byte in ctx.tail { array_push(data, byte); }
    array_push(data, 0x80);
    while (len(data) % 64) != 56 { array_push(data, 0); }
    let ml_bits = ctx.total_bytes * 8;
    let hi = 0; let lo = ml_bits;
    if ml_bits >= 4294967296 {
        hi = num_floor(ml_bits / 4294967296); lo = ml_bits % 4294967296;
    }
    for value in [hi, lo] {
        array_push(data, bit_and(bit_shr(value, 24), 255));
        array_push(data, bit_and(bit_shr(value, 16), 255));
        array_push(data, bit_and(bit_shr(value, 8), 255));
        array_push(data, bit_and(value, 255));
    }
    let offset = 0;
    while offset < len(data) { _compress(ctx, data, offset); offset = offset + 64; }
    ctx.finished = true; ctx.tail = [];
    return _hex8(ctx.h[0]) + _hex8(ctx.h[1]) + _hex8(ctx.h[2]) + _hex8(ctx.h[3])
        + _hex8(ctx.h[4]) + _hex8(ctx.h[5]) + _hex8(ctx.h[6]) + _hex8(ctx.h[7]);
}

fn _sha256_hex_bytes(bytes) {
    let ctx = new(); update(ctx, bytes); return finish(ctx);
}

// sha256_hex_bytes(bytes) hashes arbitrary binary data without a UTF-8
// conversion. This keeps package and executable integrity checks PBLang-native.
fn sha256_hex_bytes(bytes) {
    if not is_array(bytes) { throw "sha256: expected a byte array"; }
    let i = 0;
    while i < len(bytes) {
        if type(bytes[i]) != "number" or num_floor(bytes[i]) != bytes[i]
            or bytes[i] < 0 or bytes[i] > 255 {
            throw "sha256: invalid byte";
        }
        i = i + 1;
    }
    return _sha256_hex_bytes(bytes);
}

// sha256_hex(msg) — the 64-char lowercase hex digest of the UTF-8 bytes of `msg`.
fn sha256_hex(msg) {
    return _sha256_hex_bytes(str_to_bytes(msg));
}

export sha256_hex, sha256_hex_bytes, new, update, finish;
