// stdlib/deque.sapp — O(1) double-ended queue backed by sparse slots.
//
//   let deque = import("stdlib:deque.sapp");
//   let dq = deque.new();
//   deque.push_back(dq, 1); deque.push_front(dq, 0); deque.push_back(dq, 2);
//   deque.to_array(dq)   // [0, 1, 2]
//   deque.pop_front(dq)  // 0
//   deque.pop_back(dq)   // 2

fn new() { return map{ data: map{}, head: 0, tail: 0 }; }

// Upgrade deque objects made by older releases, which stored a plain array.
fn _ensure(dq) {
    if map_has(dq, "head") { return dq; }
    let old = dq["data"];
    let slots = map{};
    let i = 0;
    while i < len(old) { slots[str(i)] = old[i]; i = i + 1; }
    dq["data"] = slots;
    dq["head"] = 0;
    dq["tail"] = len(old);
    return dq;
}

fn from_array(arr) {
    let dq = new();
    let slots = dq["data"];
    let i = 0;
    for v in arr { slots[str(i)] = v; i = i + 1; }
    dq["tail"] = i;
    return dq;
}

fn size(dq) { _ensure(dq); return dq["tail"] - dq["head"]; }
fn is_empty(dq) { return size(dq) == 0; }
fn clear(dq) { dq["data"] = map{}; dq["head"] = 0; dq["tail"] = 0; return dq; }

fn push_back(dq, v) {
    _ensure(dq);
    if dq["tail"] >= 9007199254740991 { _reserve(dq, 0, 1); }
    dq["data"][str(dq["tail"])] = v;
    dq["tail"] = dq["tail"] + 1;
    return dq;
}

fn push_front(dq, v) {
    _ensure(dq);
    if dq["head"] <= -9007199254740991 { _reserve(dq, 1, 0); }
    dq["head"] = dq["head"] - 1;
    dq["data"][str(dq["head"])] = v;
    return dq;
}

// Rebase active slots to [0, size), preserving payload identity and order.
// Construct first and publish last so failed reads do not partly reindex a queue.
fn compact(dq) {
    _ensure(dq);
    for index in [dq["head"], dq["tail"]] {
        if type(index) != "number" { throw "deque: invalid index"; }
        if index * 0 != 0 or num_floor(index) != index or num_abs(index) > 9007199254740991 {
            throw "deque: invalid index";
        }
    }
    let n = dq["tail"] - dq["head"];
    if n < 0 or n > 9007199254740991 { throw "deque: invalid index range"; }
    let slots = map{};
    let i = 0;
    while i < n {
        slots[str(i)] = dq["data"][str(dq["head"] + i)];
        i = i + 1;
    }
    dq["data"] = slots;
    dq["head"] = 0;
    dq["tail"] = n;
    return dq;
}

fn _reserve(dq, front, back) {
    let n = dq["tail"] - dq["head"];
    if n > 9007199254740991 - front - back {
        throw "deque: exact index range exhausted";
    }
    if dq["head"] < -9007199254740991 + front or
       dq["tail"] > 9007199254740991 - back { compact(dq); }
}

// Bulk calls accept at most 65536 values. Validate before changing the deque.
fn _batch(values) {
    if not is_array(values) { throw "deque: batch must be an array"; }
    if len(values) > 65536 { throw "deque: batch limit is 65536"; }
    return len(values);
}

fn extend_back(dq, values) {
    let n = _batch(values);
    _ensure(dq);
    if n == 0 { return dq; }
    _reserve(dq, 0, n);
    let slots = dq["data"];
    let tail = dq["tail"];
    let i = 0;
    while i < n { slots[str(tail + i)] = values[i]; i = i + 1; }
    dq["tail"] = tail + n;
    return dq;
}

// Preserve batch order: extend_front([a,b], [x,y]) gives [x,y,a,b].
fn extend_front(dq, values) {
    let n = _batch(values);
    _ensure(dq);
    if n == 0 { return dq; }
    _reserve(dq, n, 0);
    let slots = dq["data"];
    let head = dq["head"] - n;
    let i = 0;
    while i < n { slots[str(head + i)] = values[i]; i = i + 1; }
    dq["head"] = head;
    return dq;
}

fn pop_back(dq) {
    _ensure(dq);
    if dq["tail"] == dq["head"] { return nil; }
    dq["tail"] = dq["tail"] - 1;
    let key = str(dq["tail"]);
    let value = dq["data"][key];
    map_remove(dq["data"], key);
    if dq["tail"] == dq["head"] { clear(dq); }
    return value;
}

fn pop_front(dq) {
    _ensure(dq);
    if dq["tail"] == dq["head"] { return nil; }
    let key = str(dq["head"]);
    let value = dq["data"][key];
    map_remove(dq["data"], key);
    dq["head"] = dq["head"] + 1;
    if dq["tail"] == dq["head"] { clear(dq); }
    return value;
}

fn peek_front(dq) {
    _ensure(dq);
    if dq["tail"] == dq["head"] { return nil; }
    return dq["data"][str(dq["head"])];
}
fn peek_back(dq) {
    _ensure(dq);
    if dq["tail"] == dq["head"] { return nil; }
    return dq["data"][str(dq["tail"] - 1)];
}

fn to_array(dq) {
    _ensure(dq);
    let out = [];
    let i = dq["head"];
    while i < dq["tail"] { array_push(out, dq["data"][str(i)]); i = i + 1; }
    return out;
}

fn to_string(dq) {
    let values = to_array(dq);
    let parts = [];
    for value in values { array_push(parts, str(value)); }
    return "Deque[" + str_join(parts, ", ") + "]";
}

export new, from_array, size, is_empty, clear, push_back, push_front,
       pop_back, pop_front, peek_front, peek_back, to_array, to_string,
       compact, extend_back, extend_front;
