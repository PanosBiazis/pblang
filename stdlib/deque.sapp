// stdlib/deque.sapp — double-ended queue. A deque is map{ data: [] }; back
// operations are O(1), front operations rebuild the backing array (O(n)).
//
//   let deque = import("stdlib:deque.sapp");
//   let dq = deque.new();
//   deque.push_back(dq, 1); deque.push_front(dq, 0); deque.push_back(dq, 2);
//   deque.to_array(dq)   // [0, 1, 2]
//   deque.pop_front(dq)  // 0
//   deque.pop_back(dq)   // 2

fn new() { return map{ data: [] }; }
fn from_array(arr) {
    let dq = new();
    for v in arr { array_push(dq["data"], v); }
    return dq;
}

fn size(dq) { return len(dq["data"]); }
fn is_empty(dq) { return len(dq["data"]) == 0; }
fn clear(dq) { dq["data"] = []; return dq; }

fn push_back(dq, v) { array_push(dq["data"], v); return dq; }

fn push_front(dq, v) {
    let nd = [v];
    for x in dq["data"] { array_push(nd, x); }
    dq["data"] = nd;
    return dq;
}

fn pop_back(dq) {
    if len(dq["data"]) == 0 { return nil; }
    return array_pop(dq["data"]);
}

fn pop_front(dq) {
    let d = dq["data"];
    if len(d) == 0 { return nil; }
    let head = d[0];
    let nd = [];
    let i = 1;
    while i < len(d) { array_push(nd, d[i]); i = i + 1; }
    dq["data"] = nd;
    return head;
}

fn peek_front(dq) {
    if len(dq["data"]) == 0 { return nil; }
    return dq["data"][0];
}
fn peek_back(dq) {
    let d = dq["data"];
    if len(d) == 0 { return nil; }
    return d[len(d) - 1];
}

fn to_array(dq) {
    let out = [];
    for x in dq["data"] { array_push(out, x); }
    return out;
}

fn to_string(dq) {
    let d = dq["data"];
    let s = "Deque[";
    for i in 0 to len(d) - 1 {
        if i > 0 { s = s + ", "; }
        s = s + str(d[i]);
    }
    return s + "]";
}

export new, from_array, size, is_empty, clear, push_back, push_front,
       pop_back, pop_front, peek_front, peek_back, to_array, to_string;
