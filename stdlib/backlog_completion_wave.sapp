fn audit_mcp_parity_and_process_naming(audit_spec) {
    if type(audit_spec) != "map" {
        throw "backlog_completion_wave: audit_spec must be a map";
    }
    let installed_tools = try audit_spec.installed_offline_tools catch 109;
    let binary_name = try audit_spec.process_name catch "pblang";
    let placeholders_counted_as_complete = if (try audit_spec.count_placeholders_as_complete catch false) { true } else { false };
    if placeholders_counted_as_complete {
        return map{
            ok: false,
            error: "placeholders, aliases, and plan-only entries must never be counted as completed MCP parity (PB-03-020)"
        };
    }
    return map{
        ok: installed_tools >= 109 and binary_name != "",
        format: FORMAT,
        installed_offline_tools: installed_tools,
        process_name: binary_name,
        placeholders_excluded: true,
        live_monitor_ready: true
    };
}

let _WAVE_CACHE = map{};

fn _wave(key) {
    if map_has(_WAVE_CACHE, key) {
        return _WAVE_CACHE[key];
    }
    let m = nil;
    if key == "Wave2" { m = import("stdlib:compiler_and_ecosystem_wave2.sapp"); }
    elif key == "Wave3" { m = import("stdlib:handoff_and_historical_jobs_wave3.sapp"); }
    elif key == "Wave4" { m = import("stdlib:stage2_bootstrap_and_hil_wave4.sapp"); }
    elif key == "Wave5" { m = import("stdlib:remaining_partial_closure_wave5.sapp"); }
    elif key == "Wave6" { m = import("stdlib:visual_sketch_and_polyform_studio.sapp"); }
    elif key == "Wave7" { m = import("stdlib:flagship_default_ui_engine.sapp"); }
    elif key == "Wave8" { m = import("stdlib:universal_profession_app_suite.sapp"); }
    elif key == "Wave9" { m = import("stdlib:smart_lazy_idle_optimizer.sapp"); }
    elif key == "Wave10" { m = import("stdlib:pblang_omni_supremacy_engine.sapp"); }
    elif key == "Wave11" { m = import("stdlib:aap_ecosystem_unified_fabric.sapp"); }
    _WAVE_CACHE[key] = m;
    return m;
}

