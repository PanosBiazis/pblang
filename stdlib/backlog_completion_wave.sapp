    let level = try browser_spec.security_level catch "strict_sovereign";
    let adblock_on = if (try browser_spec.adblock_tracker_shield catch true) { true } else { false };
    let download_quarantine = if (try browser_spec.download_quarantine_check catch true) { true } else { false };
    return map{
        ok: adblock_on and download_quarantine,
        format: FORMAT,
        security_level: level,
        adblock_tracker_shield: adblock_on,
        download_quarantine_check: download_quarantine,
        network_route: try browser_spec.network_route catch "direct_tls13_or_tor_opt_in",
        custom_search_engines_supported: true,
        bidirectional_web_native_mobile_tree: true
    };
}

