// stdlib/struct.sapp — Rust-inspired immutable value types (structural records).
//
// Usage:
//   let s = import("stdlib:struct.sapp");
//   let Point = s.define("Point", ["x", "y"]);
//   let p = s.new(Point, map{ x: 3, y: 4 });
//   print p.x;                               // 3
//   let p2 = s.with(p, map{ x: 10 });        // {x: 10, y: 4}
//   print s.instanceof(p, Point);             // true

// define(name, field_names, defaults) — declare a struct type. `defaults`
// (optional map) supplies values for fields omitted at construction.
fn define(name, field_names, defaults = nil) {
    if type(field_names) != "array" {
        return error("struct.define: fields must be an array of strings");
    }
    return map{
        __struct_name: name,
        __fields: field_names,
        __defaults: defaults,
        __is_struct_def: true
    };
}

fn new(struct_type, values_map = nil) {
    if struct_type == nil {
        return error("struct.new: struct_type is nil");
    }
    if values_map == nil { values_map = map{}; }

    let fields = try struct_type.__fields catch [];
    let defaults = try struct_type.__defaults catch nil;

    // Build the struct instance (only allowed fields). A field absent from both
    // the values and the defaults is an error.
    let instance = map{
        __struct_name: struct_type.__struct_name,
        __is_struct: true
    };
    for i len(fields) {
        let f = fields[i];
        if map_has(values_map, f) {
            instance[f] = values_map[f];
        } else if defaults != nil and map_has(defaults, f) {
            instance[f] = defaults[f];
        } else {
            return error("struct.new: missing field '" + f + "' in " + str(struct_type.__struct_name));
        }
    }
    return instance;
}

// with(instance, updates) — create a modified copy (like Rust's struct update syntax)
fn with(instance, updates) {
    if type(instance) != "map" {
        return error("struct.with: instance must be a map");
    }
    let result = map{};
    // Copy all existing fields
    let keys = map_keys(instance);
    for i len(keys) {
        result[keys[i]] = instance[keys[i]];
    }
    // Apply updates
    if updates != nil {
        let ukeys = map_keys(updates);
        for i len(ukeys) {
            result[ukeys[i]] = updates[ukeys[i]];
        }
    }
    return result;
}

// get(instance, field) — safe field access
fn get(instance, field) {
    if type(instance) != "map" { return nil; }
    return try instance[field] catch nil;
}

// to_map(instance) — convert to plain map (removes __struct metadata)
fn to_map(instance) {
    if type(instance) != "map" { return map{}; }
    let result = map{};
    let keys = map_keys(instance);
    for i len(keys) {
        let k = keys[i];
        if str_starts_with(k, "__") == false {
            result[k] = instance[k];
        }
    }
    return result;
}

// from_map(struct_type, m) — construct struct from map, validating fields
fn from_map(struct_type, m) {
    return new(struct_type, m);
}

// instanceof(instance, struct_type) — check type membership
fn instanceof(instance, struct_type) {
    if type(instance) != "map" { return false; }
    let is_struct = try instance.__is_struct catch false;
    if is_struct == false { return false; }
    let name = try instance.__struct_name catch nil;
    let expected = try struct_type.__struct_name catch nil;
    return name == expected;
}

// eq(a, b) — deep equality for struct instances
fn eq(a, b) {
    if type(a) != "map" or type(b) != "map" { return a == b; }
    let an = try a.__struct_name catch nil;
    let bn = try b.__struct_name catch nil;
    if an != bn { return false; }
    let fields_a = map_keys(a);
    for i len(fields_a) {
        let k = fields_a[i];
        if str_starts_with(k, "__") { } // skip meta
        else if a[k] != b[k] { return false; }
    }
    return true;
}

// fields(struct_type) — the declared field-name list.
fn fields(struct_type) { return try struct_type.__fields catch []; }

// is_struct(v) — true if v is a struct instance (created via new/from_map).
fn is_struct(v) {
    if type(v) != "map" { return false; }
    return (try v.__is_struct catch false) == true;
}

// to_string(instance) — "Name { a: 1, b: 2 }" (fields in sorted order).
fn to_string(instance) {
    if type(instance) != "map" { return str(instance); }
    let name = try instance.__struct_name catch "struct";
    let body = "";
    let keys = map_keys(instance);
    let first = true;
    for i len(keys) {
        let k = keys[i];
        if str_starts_with(k, "__") == false {
            if not first { body = body + ", "; }
            body = body + k + ": " + str(instance[k]);
            first = false;
        }
    }
    return name + " { " + body + " }";
}

// validate(struct_type, values) — { ok, missing } shape check (no mutation).
fn validate(struct_type, values) {
    let flds = try struct_type.__fields catch [];
    let missing = [];
    for i len(flds) {
        if map_has(values, flds[i]) == false { array_push(missing, flds[i]); }
    }
    return map{ ok: len(missing) == 0, missing: missing };
}

export define, new, with, get, to_map, from_map, instanceof, eq,
       fields, is_struct, to_string, validate;
