// stdlib/pbai.sapp — pbAI: pblang's own AI assistant, written entirely in pblang.
//
// NO external model, NO network, NO Ollama — this IS pblang's intelligence. It pairs a
// small **neural intent classifier** (a `nn.sapp` MLP — the genuine pbAI model) with
// pblang-grounded **skills** that inspect the code and compose an answer. Its edge is
// that it knows pblang's *own* specifics (gotchas, idioms) an outside model wouldn't.
//
//   let pbai = import("stdlib/pbai.sapp");
//   pbai.respond("Explain what this does:\n\nfn main() { print \"hi\"; }");
//   pbai.respond_tool("ai_self_critique", promptText);   // tool hint overrides routing
//
// This is the pbAI foundation that backs the IDE 🤖 AI panel. Generative scale-up
// (a full pblang language model) is the roadmap (docs/pbAI.md); the assistant skills
// here are useful today and 100% pblang.

let nn = import("stdlib/nn.sapp");
let MCP = import("stdlib:pb_mcp.sapp");
let PBAI_ASSETS = import("stdlib/pbai_assets.sapp");
let PBAI_LM = import("stdlib/pbai_lm.sapp");
let P = import("stdlib:parallel.sapp");   // multi-core batch classification
let OS = import("stdlib:os.sapp");         // device detection
let MODEL_CACHE = import("stdlib:model_cache.sapp"); // validated user model cache
let W = import("stdlib:watch.sapp");       // GPU/hardware view
let ACC = import("stdlib:accelerator.sapp"); // CPU/GPU/NPU(AI accel) routing
let T = import("stdlib:tensor.sapp");              // matmul batch (auto-GPU under --features gpu)
let ENS = import("stdlib:pbai_ensemble.sapp"); // unified MLLM ensemble engine (shared)
let TUNE = import("stdlib:sampling_tune.sapp"); // context-adaptive sampling params (AutoTune-style)
let NORM = import("stdlib:text_normalize.sapp"); // response output normalizer (STM-style)
let DEOB = import("stdlib:deobfuscate.sapp");     // adversarial input de-obfuscation (Parseltongue inverse)
let PSAFE = import("stdlib:prompt_safety.sapp");   // defensive prompt-harm triage (content moderation)
let SMART = import("stdlib:pbai_dispatch.sapp");  // single-expert, on-demand execution policy

// ── Text utilities ───────────────────────────────────────────────────────────────────
fn _count(s, sub) {
    if sub == "" { return 0; }
    return len(str_split(s, sub)) - 1;
}

// ── Neural intent classifier (the pbAI model) ────────────────────────────────────────
// Bag-of-keywords features → an MLP → one of 5 intents. Trained once, in pblang.
// Discriminative bag-of-keywords. Grouped by the intent each word pulls toward so the
// MLP has strong, low-overlap signal: explain / bugs / improve / comment / general.
let _VOCAB = [
    // explain
    "explain", "what", "does", "describe", "step", "walk", "through", "trace",
    "understand", "overview", "summary", "means",
    // bugs
    "bug", "error", "wrong", "mistake", "fix", "issue", "throw", "crash", "fail",
    "exception", "broken", "debug", "panic", "problem",
    // improve
    "improve", "better", "optimize", "refactor", "faster", "cleaner", "performance",
    "speed", "simplify", "efficient",
    // comment
    "comment", "document", "docstring", "annotate",
    // general
    "how", "why", "generate", "write", "create", "build", "implement", "review",
    "security", "sandbox", "capability", "ide", "browser", "typeclass", "concurrency",
    "logic", "reactive"];

// intent ids: 0 explain  1 bugs  2 improve  3 comment  4 general
let _INTENTS = ["explain", "bugs", "improve", "comment", "general"];

fn _featurize(text) {
    let t = str_lower(text);
    let v = [];
    let i = 0;
    while i < len(_VOCAB) {
        if str_contains(t, _VOCAB[i]) { v[i] = 1; } else { v[i] = 0; }
        i = i + 1;
    }
    return v;
}

fn _onehot(idx, n) {
    let v = [];
    let i = 0;
    while i < n { if i == idx { v[i] = 1; } else { v[i] = 0; } i = i + 1; }
    return v;
}

// Trained weights are CACHED on disk so the model loads (fast) instead of retraining
// on every fresh process — train-once, load-forever. The cache is guarded by BOTH the
// vocabulary size AND a data version, so changing the training set (not just the vocab)
// invalidates the cache and forces a retrain.
let _BUNDLED_WPATH = "stdlib/pbai_model.json";
let _MODEL = nil;
let _MODEL_VERSION = 2;   // bump whenever _train_model's data/architecture changes

fn model_cache_path() {
    let name = "pbai-intent-v" + str(_MODEL_VERSION) + "-n" + str(len(_VOCAB)) + ".json";
    return MODEL_CACHE.path(name, "PBLANG_PBAI_MODEL_CACHE");
}

// _augment_data() — GENERATED training data: one single-keyword sample per strong,
// unambiguous keyword, mapped to its intent. This teaches every distinctive word's class
// directly (multi-word prompts then sum these signals), making the classifier robust to
// phrasings the hand-written sentences don't cover. Ambiguous words (what/how/why/write/
// create/review) are intentionally excluded so they don't get pinned to one intent.
fn _aug(out, words, intent) {
    let i = 0;
    while i < len(words) { array_push(out, nn.sample(_featurize(words[i]), _onehot(intent, 5))); i = i + 1; }
    return out;
}
fn _augment_data() {
    let out = [];
    _aug(out, ["explain", "describe", "walk", "through", "trace", "understand", "overview", "summary", "means", "step"], 0);
    _aug(out, ["bug", "error", "wrong", "mistake", "issue", "throw", "crash", "fail", "exception", "broken", "debug", "panic", "problem"], 1);
    _aug(out, ["improve", "optimize", "refactor", "faster", "cleaner", "performance", "speed", "simplify", "efficient", "better"], 2);
    _aug(out, ["comment", "document", "docstring", "annotate"], 3);
    _aug(out, ["typeclass", "concurrency", "security", "sandbox", "capability", "logic", "reactive", "implement", "generate", "build"], 4);
    return out;
}

fn _train_model() {
    let net = nn.mlp_new(len(_VOCAB), 16, 5, 42);
    let data = [
        // 0 explain
        nn.sample(_featurize("explain what this code does"), _onehot(0, 5)),
        nn.sample(_featurize("describe this program step by step"), _onehot(0, 5)),
        nn.sample(_featurize("what does this function do"), _onehot(0, 5)),
        nn.sample(_featurize("give an overview summary of this"), _onehot(0, 5)),
        nn.sample(_featurize("help me understand and trace through this logic"), _onehot(0, 5)),
        nn.sample(_featurize("walk through this step by step"), _onehot(0, 5)),
        // 1 bugs
        nn.sample(_featurize("find the bugs and errors in this"), _onehot(1, 5)),
        nn.sample(_featurize("what is wrong mistake issue with this code"), _onehot(1, 5)),
        nn.sample(_featurize("this code throws an exception and crashes"), _onehot(1, 5)),
        nn.sample(_featurize("debug why this fails and panics"), _onehot(1, 5)),
        nn.sample(_featurize("fix the broken function with the error"), _onehot(1, 5)),
        // 2 improve
        nn.sample(_featurize("improve and optimize refactor this code"), _onehot(2, 5)),
        nn.sample(_featurize("make this better"), _onehot(2, 5)),
        nn.sample(_featurize("rewrite this to be faster and cleaner"), _onehot(2, 5)),
        nn.sample(_featurize("simplify and speed up this for performance and efficient code"), _onehot(2, 5)),
        // 3 comment
        nn.sample(_featurize("add comments and document this code"), _onehot(3, 5)),
        nn.sample(_featurize("add a docstring and annotate this function"), _onehot(3, 5)),
        // 4 general
        nn.sample(_featurize("how does pblang work and why"), _onehot(4, 5)),
        nn.sample(_featurize("generate write create a program"), _onehot(4, 5)),
        nn.sample(_featurize("write and create a new function or script"), _onehot(4, 5)),
        nn.sample(_featurize("build and implement a new feature"), _onehot(4, 5)),
        nn.sample(_featurize("what is a typeclass and concurrency in pblang"), _onehot(4, 5)),
        nn.sample(_featurize("review the security sandbox capability of the ide browser"), _onehot(4, 5))
    ];
    // feed the GENERATED per-keyword samples alongside the hand-written sentences
    let aug = _augment_data();
    let ai = 0;
    while ai < len(aug) { array_push(data, aug[ai]); ai = ai + 1; }
    nn.train(net, data, 360, 0.3);
    net["pbai_version"] = _MODEL_VERSION;
    return net;
}
fn _model() {
    if _MODEL != nil { return _MODEL; }
    let cached = MODEL_CACHE.load_mlp(model_cache_path(), len(_VOCAB), 16, 5, _MODEL_VERSION);
    if cached != nil {
        _MODEL = cached;
        return cached;
    }
    let bundled = MODEL_CACHE.load_mlp(_BUNDLED_WPATH, len(_VOCAB), 16, 5, _MODEL_VERSION);
    if bundled != nil {
        _MODEL = bundled;
        return bundled;
    }
    let net = _train_model();
    MODEL_CACHE.store_json(model_cache_path(), net);
    _MODEL = net;
    return net;
}

// classify(prompt) — the pbAI model's intent prediction (0..4).
fn classify(prompt) {
    return nn.argmax(nn.predict(_model(), _featurize(prompt)));
}

fn classify_scores(prompt) {
    let y = nn.predict(_model(), _featurize(prompt));
    return map{
        intent: _INTENTS[nn.argmax(y)],
        scores: y,
    };
}

// ── Code inspection (grounded analysis) ──────────────────────────────────────────────
// Pull the code out of an IDE prompt: prefer the part after a fenced/labelled marker,
// else everything after the first blank line, else the whole text.
fn _extract_code(prompt) {
    let markers = ["--- pblang code ---", "```"];
    let i = 0;
    while i < len(markers) {
        let idx = str_index_of(prompt, markers[i]);
        if idx >= 0 {
            let rest = str_slice(prompt, idx + len(markers[i]), len(prompt));
            let close = str_index_of(rest, "```");
            if close >= 0 { return str_trim(str_slice(rest, 0, close)); }
            return str_trim(rest);
        }
        i = i + 1;
    }
    let nl = str_index_of(prompt, "

");
    if nl >= 0 { return str_trim(str_slice(prompt, nl, len(prompt))); }
    return str_trim(prompt);
}

fn _looks_like_map_index_read(code) {
    return (str_contains(code, "map{") or str_contains(code, "map =") or str_contains(code, "map="))
        and str_contains(code, "[")
        and not str_contains(code, "map_has");
}

fn _looks_like_missing_fn(code) {
    let t = str_trim(code);
    if str_starts_with(t, "fn ") or str_starts_with(t, "export fn ") { return false; }
    let paren = str_index_of(t, "(");
    let br = str_index_of(t, "{");
    return paren > 0 and br > paren;
}

fn _looks_like_missing_let_equals(code) {
    let parts = str_split(code, "let ");
    let i = 1;
    while i < len(parts) {
        let stmt = parts[i];
        let semi = str_index_of(stmt, ";");
        if semi >= 0 { stmt = str_slice(stmt, 0, semi); }
        if str_index_of(stmt, "=") < 0 and str_index_of(stmt, "(") > 0 { return true; }
        i = i + 1;
    }
    return false;
}

fn _looks_like_fs_name_typo(code) {
    return str_contains(code, "fs read(") or str_contains(code, "fs write(");
}

fn _repair_preview(code) {
    let out = str_trim(code);
    out = str_replace_all(out, "print(s);", "print s;");
    out = str_replace_all(out, "print(x);", "print x;");
    out = str_replace_all(out, "print(path);", "print path;");
    out = str_replace_all(out, "print(42);", "print 42;");
    out = str_replace_all(out, "fs read(", "fs_read(");
    out = str_replace_all(out, "fs write(", "fs_write(");
    out = str_replace_all(out, "let s  fs_read(", "let s = fs_read(");
    out = str_replace_all(out, "let s fs_read(", "let s = fs_read(");
    out = str_replace_all(out, "let s  fs_write(", "let s = fs_write(");
    out = str_replace_all(out, "let s fs_write(", "let s = fs_write(");
    // unambiguous cross-language swaps — these tokens are NEVER valid pblang, so the
    // rewrite is always safe (ambiguous ones like None/True/.length are flagged, not auto-rewritten).
    out = str_replace_all(out, "!==", "!=");
    out = str_replace_all(out, "===", "==");
    out = str_replace_all(out, "&&", "and");
    out = str_replace_all(out, "||", "or");
    out = str_replace_all(out, "null", "nil");
    if _looks_like_missing_fn(out) { out = "fn " + out; }
    return out;
}

fn _fn_names(code) {
    let parts = str_split(code, "fn ");
    let names = "";
    let i = 1;
    while i < len(parts) {
        let p = parts[i];
        let paren = str_index_of(p, "(");
        if paren > 0 {
            let nm = str_trim(str_slice(p, 0, paren));
            if nm != "" { if names == "" { names = nm; } else { names = names + ", " + nm; } }
        }
        i = i + 1;
    }
    return names;
}

// deepest `{` nesting depth — a proxy for cyclomatic complexity / readability.
fn _max_depth(code) {
    let d = 0; let mx = 0; let i = 0;
    while i < len(code) {
        let c = strcharcodeat(code, i);
        if c == 123 { d = d + 1; if d > mx { mx = d; } }   // '{'
        else if c == 125 { if d > 0 { d = d - 1; } }       // '}'
        i = i + 1;
    }
    return mx;
}
// heuristic: does any function call its own name inside its body? (recursion)
fn _has_recursion(code) {
    let parts = str_split(code, "fn ");
    let i = 1;
    while i < len(parts) {
        let p = parts[i];
        let paren = str_index_of(p, "(");
        let br = str_index_of(p, "{");
        if paren > 0 and br > paren {
            let nm = str_trim(str_slice(p, 0, paren));
            if nm != "" and str_contains(str_slice(p, br, len(p)), nm + "(") { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn _scan(code) {
    let lc = str_lower(code);
    return map{
        fns: _count(code, "fn "),
        lets: _count(code, "let ") + _count(code, "const "),
        whiles: _count(code, "while "),
        fors: _count(code, "for "),
        ifs: _count(code, "if "),
        structs: _count(code, "struct "),
        classes: _count(code, "class "),
        enums: _count(code, "enum "),
        matches: _count(code, "match "),
        prints: _count(code, "print"),
        tries: _count(code, "try "),
        imports: _count(code, "import("),
        closures: _count(code, "fn("),
        returns: _count(code, "return"),
        execs: _count(code, "proc_spawn") + _count(code, "exec(") + _count(code, "polyglot_exec"),
        ffi: _count(code, "ffi_") + _count(code, "import(\"stdlib:ffi"),
        http: _count(code, "http_get") + _count(code, "http_post") + _count(code, "import(\"stdlib:http"),
        fs: _count(code, "fs_read") + _count(code, "fs_write") + _count(code, "import(\"stdlib:fs"),
        env: _count(code, "env_get") + _count(code, "env_set"),
        todos: _count(lc, "todo") + _count(lc, "fixme"),
        open_brace: _count(code, "{"), close_brace: _count(code, "}"),
        open_paren: _count(code, "("), close_paren: _count(code, ")"),
        open_brack: _count(code, "["), close_brack: _count(code, "]"),
        lines: _count(code, "\n") + 1,
        depth: _max_depth(code),
        recursion: _has_recursion(code)
    };
}

fn _quality_score(s) {
    let score = 100;
    score = score - s.todos * 12;
    score = score - s.depth * 5;
    score = score - (s.whiles + s.fors) * 2;
    score = score - s.ifs;
    if s.open_brace != s.close_brace { score = score - 30; }
    if s.open_paren != s.close_paren { score = score - 30; }
    if s.open_brack != s.close_brack { score = score - 30; }
    if score < 0 { score = 0; }
    if score > 100 { score = 100; }
    return score;
}

fn _risk_summary(s) {
    let caps = [];
    if s.fs > 0 { array_push(caps, "fs"); }
    if s.http > 0 { array_push(caps, "http"); }
    if s.execs > 0 { array_push(caps, "exec"); }
    if s.ffi > 0 { array_push(caps, "ffi"); }
    if s.env > 0 { array_push(caps, "env"); }
    if len(caps) == 0 { return "no obvious sensitive capability use"; }
    let out = "";
    for i len(caps) {
        if i > 0 { out = out + ", "; }
        out = out + caps[i];
    }
    return "uses sensitive capability area(s): " + out;
}

fn analyze(prompt) {
    let code = _extract_code(prompt);
    let s = _scan(code);
    let c = classify_scores(prompt);
    return map{
        intent: c.intent,
        scores: c.scores,
        has_code: _has_code(code, s),
        quality: _quality_score(s),
        risk: _risk_summary(s),
        scan: s,
    };
}

// ── Skills ───────────────────────────────────────────────────────────────────────────
fn _explain(code, s) {
    let out = "pbAI: code overview\n";
    out = out + "- quality score: " + str(_quality_score(s)) + "/100; " + _risk_summary(s) + ".\n";
    if s.fns > 0 { out = out + "- " + str(s.fns) + " function(s): " + _fn_names(code) + "\n"; }
    else { out = out + "- top-level script (no function definitions)\n"; }
    out = out + "- " + str(s.lines) + " line(s), " + str(s.lets) + " binding(s)";
    let loops = s.whiles + s.fors;
    if loops > 0 { out = out + ", " + str(loops) + " loop(s)"; }
    if s.ifs > 0 { out = out + ", " + str(s.ifs) + " conditional(s)"; }
    if s.matches > 0 { out = out + ", " + str(s.matches) + " match"; }
    if s.structs > 0 { out = out + ", " + str(s.structs) + " struct(s)"; }
    if s.classes > 0 { out = out + ", " + str(s.classes) + " class(es)"; }
    if s.enums > 0 { out = out + ", " + str(s.enums) + " enum(s)"; }
    out = out + ".\n";
    if s.imports > 0 { out = out + "- pulls in " + str(s.imports) + " module(s) via import().\n"; }
    if s.recursion { out = out + "- uses RECURSION — verify the base case terminates.\n"; }
    if s.closures > 0 { out = out + "- defines " + str(s.closures) + " closure(s) (anonymous fn) — captured variables live on.\n"; }
    if s.tries > 0 { out = out + "- handles errors with try/catch (" + str(s.tries) + ").\n"; }
    if s.prints > 0 { out = out + "- produces output via print.\n"; }
    if loops > 0 { out = out + "- control flow is iterative; trace the loop variables to follow it.\n"; }
    if s.depth >= 4 { out = out + "- nesting depth " + str(s.depth) + " is deep; the hot path is buried inside several blocks.\n"; }
    return out;
}

fn _bugs(code, s) {
    let out = "pbAI: review (pblang-aware)\n";
    out = out + "- quality score: " + str(_quality_score(s)) + "/100; " + _risk_summary(s) + ".\n";
    let found = 0;
    if _looks_like_missing_fn(code) {
        out = out + "- missing `fn` before the function name.\n"; found = found + 1;
    }
    if _looks_like_missing_let_equals(code) {
        out = out + "- missing `=` in a `let` binding; write `let name = value;`.\n"; found = found + 1;
    }
    if _looks_like_fs_name_typo(code) {
        out = out + "- `fs read(...)` / `fs write(...)` are not pblang builtins; use `fs_read(...)` / `fs_write(...)`.\n"; found = found + 1;
    }
    if s.open_brace != s.close_brace {
        out = out + "! unbalanced braces: " + str(s.open_brace) + " '{' vs " + str(s.close_brace) + " '}'.\n"; found = found + 1;
    }
    if s.open_paren != s.close_paren {
        out = out + "! unbalanced parentheses: " + str(s.open_paren) + " '(' vs " + str(s.close_paren) + " ')'.\n"; found = found + 1;
    }
    if s.open_brack != s.close_brack {
        out = out + "! unbalanced brackets: " + str(s.open_brack) + " '[' vs " + str(s.close_brack) + " ']'.\n"; found = found + 1;
    }
    // pblang-specific gotchas this model knows (an outside model often gets these wrong):
    if str_contains(code, "print(") {
        out = out + "- `print(x)` is INVALID in pblang — print is a statement: write `print x;` (the paren form errors with 'undefined global print').\n"; found = found + 1;
    }
    if str_contains(code, ".method(") or _count(code, ").") > 0 {
        out = out + "- no UFCS: `obj.method(args)` is field access, not a call. Use a free function or colon-call `obj:method(args)`.\n"; found = found + 1;
    }
    if str_contains(code, "\" <") or str_contains(code, "\" >") or str_contains(code, "< \"") or str_contains(code, "> \"") {
        out = out + "- string `<`/`>` comparison is unsupported; compare via strcharcodeat / length.\n"; found = found + 1;
    }
    if _looks_like_map_index_read(code) {
        out = out + "- reading a MISSING map key RAISES (it is not nil); guard with `map_has(m, k)`.\n"; found = found + 1;
    }
    if str_contains(code, "while true") or str_contains(code, "while (true)") {
        if not str_contains(code, "break") { out = out + "- `while true` with no `break` is an infinite loop.\n"; found = found + 1; }
    }
    if str_contains(code, "/ 0") or str_contains(code, "/0") {
        out = out + "- possible division by zero — guard the denominator.\n"; found = found + 1;
    }
    if s.execs > 0 {
        out = out + "- exec/polyglot process calls require `--allow-exec`; never pass untrusted strings directly to a shell.\n"; found = found + 1;
    }
    if s.ffi > 0 {
        out = out + "- FFI loads code into the host process; treat `--allow-ffi` like arbitrary native-code permission.\n"; found = found + 1;
    }
    if s.env > 0 {
        out = out + "- env reads can expose secrets; use `--sandbox` or `--deny-env` for untrusted scripts.\n"; found = found + 1;
    }
    if s.fns > 0 and s.returns == 0 {
        out = out + "- functions defined but no `return` — they yield nil; confirm that's intended.\n"; found = found + 1;
    }
    if s.todos > 0 { out = out + "- " + str(s.todos) + " TODO/FIXME marker(s) still in the code.\n"; found = found + 1; }
    // more pblang gotchas an outside model (trained on other languages) gets wrong:
    if str_contains(code, "elif ") {
        out = out + "- pblang has no `elif`; use `else if`.\n"; found = found + 1;
    }
    if str_contains(code, "foreach") {
        out = out + "- no `foreach`; iterate with `for v in arr { ... }`.\n"; found = found + 1;
    }
    if str_contains(code, "++;") or str_contains(code, "++)") or str_contains(code, "--;") or str_contains(code, "--)") {
        out = out + "- pblang has no `++`/`--`; write `i = i + 1` / `i = i - 1`.\n"; found = found + 1;
    }
    if str_contains(code, "exit(") {
        out = out + "- there is no `exit()` builtin; `throw` to abort, or signal completion via a status file.\n"; found = found + 1;
    }
    if str_contains(code, "===") or str_contains(code, "!==") {
        out = out + "- pblang uses `==` / `!=`; there is no `===` / `!==`.\n"; found = found + 1;
    }
    if str_contains(code, "console.log") or str_contains(code, "printf(") or str_contains(code, "println") {
        out = out + "- output is `print x;` (a statement) — not console.log / printf / println.\n"; found = found + 1;
    }
    // cross-language gotchas — mistakes a model trained on JS/Python/C makes, that pbAI
    // knows are wrong because it knows pblang's OWN syntax:
    if str_contains(code, "&&") or str_contains(code, "||") {
        out = out + "- pblang's boolean operators are words: use `and` / `or` (and `not`), not `&&` / `||`.\n"; found = found + 1;
    }
    // `!` negation (but `!=` is valid) — match it only in clear negation positions.
    if str_contains(code, "!(") or str_contains(code, "if !") or str_contains(code, "while !") or str_contains(code, "= !") or str_contains(code, "return !") {
        out = out + "- pblang has no `!` negation; use `not x`.\n"; found = found + 1;
    }
    if str_contains(code, "null") or str_contains(code, "None") or str_contains(code, "undefined") {
        out = out + "- pblang's empty value is `nil`; use `nil` (not null / None / undefined).\n"; found = found + 1;
    }
    if str_contains(code, "True") or str_contains(code, "False") {
        out = out + "- booleans are lowercase `true`/`false` (not capitalized True/False).\n"; found = found + 1;
    }
    if str_contains(code, "function ") {
        out = out + "- pblang has no `function` keyword; define with `fn name(...) { ... }`.\n"; found = found + 1;
    }
    if str_contains(code, "=>") {
        out = out + "- no `=>` arrow functions; closures are `fn(x) { ... }`.\n"; found = found + 1;
    }
    if str_contains(code, "var ") {
        out = out + "- no `var`/`const` declaration keyword for that; bind with `let name = value;`.\n"; found = found + 1;
    }
    if str_contains(code, ".length") {
        out = out + "- there is no `.length` property; use `len(x)` for arrays/strings/maps.\n"; found = found + 1;
    }
    if str_contains(code, "${") {
        out = out + "- no string interpolation; concatenate with `+` (e.g. \"hi \" + name).\n"; found = found + 1;
    }
    if str_contains(code, "lambda ") {
        out = out + "- pblang has no `lambda`; an anonymous function is `fn(x) { ... }`.\n"; found = found + 1;
    }
    let fixed = _repair_preview(code);
    if fixed != str_trim(code) {
        out = out + "\nSuggested pblang fix:\n```pblang\n" + fixed + "\n```\n";
    }
    if found == 0 {
        out = out + "- no structural issues found. Check edge cases: empty inputs, off-by-one in loop bounds, missing-key map reads, and nil propagation.\n";
    }
    return out;
}

fn _improve(code, s) {
    let out = "pbAI: suggestions\n";
    out = out + "- target: raise quality score from " + str(_quality_score(s)) + "/100 by reducing nesting, TODOs, and unchecked capability use.\n";
    let fixed = _repair_preview(code);
    if fixed != str_trim(code) {
        out = out + "- apply this pblang syntax repair first:\n```pblang\n" + fixed + "\n```\n";
    }
    if s.fns == 0 { out = out + "- extract reusable logic into `fn`s for clarity and testing.\n"; }
    if s.whiles > 0 and s.fors == 0 { out = out + "- for a fixed count, `for i N { ... }` reads cleaner than `while` with a manual counter.\n"; }
    if s.lets > 12 { out = out + "- many bindings in one scope (" + str(s.lets) + ") — group related state into a `map`/`struct`.\n"; }
    if s.depth >= 4 { out = out + "- nesting depth " + str(s.depth) + ": flatten with early `return`/`continue` or extract inner blocks into functions.\n"; }
    if s.fns > 0 and (s.lines / (s.fns + 0)) > 40 { out = out + "- average function is long; split each into smaller single-purpose helpers.\n"; }
    if s.tries == 0 and (s.imports > 0 or str_contains(code, "fs_read") or str_contains(code, "http")) { out = out + "- I/O without try/catch — wrap fallible calls (fs/http/import) so failures don't abort the run.\n"; }
    if s.execs > 0 or s.ffi > 0 or s.env > 0 { out = out + "- isolate sensitive operations behind small wrapper functions and document required capabilities.\n"; }
    if _looks_like_map_index_read(code) { out = out + "- if reading dynamic map keys, add `map_has` guards before indexing.\n"; }
    out = out + "- name constants instead of magic numbers, keep functions to one job, and prefer `else if` chains over deep nesting.\n";
    out = out + "- F6 (check) runs the self-hosted linter for unreachable code + undefined names; F5 runs it.\n";
    return out;
}

// Generate suggested `///` doc headers, one per function (params listed).
fn _comment(code, s) {
    let out = "pbAI: documentation headers\n";
    let parts = str_split(code, "fn ");
    if len(parts) <= 1 {
        return out + "// top-level script — add a one-line purpose comment at the top, e.g.\n// <what this program does, and how to run it>\n";
    }
    let i = 1;
    while i < len(parts) {
        let p = parts[i];
        let paren = str_index_of(p, "(");
        let close = str_index_of(p, ")");
        if paren > 0 {
            let nm = str_trim(str_slice(p, 0, paren));
            let params = "";
            if close > paren { params = str_trim(str_slice(p, paren + 1, close)); }
            out = out + "/// " + nm + "(" + params + ") - TODO: describe what it does";
            if params != "" { out = out + " (args: " + params + ")"; }
            out = out + ".\n";
        }
        i = i + 1;
    }
    return out;
}

// ── pblang knowledge base (general questions) ─────────────────────────────────────────
// pbAI's edge: it knows pblang's OWN specifics, idioms, and gotchas. Matched most-specific
// first so a question about "missing map key" routes to the maps answer, etc.
fn _general(prompt) {
    let t = str_lower(prompt);
    if (str_contains(t, "generate") or str_contains(t, "write") or str_contains(t, "create"))
        and (str_contains(t, "code") or str_contains(t, "program") or str_contains(t, "function") or str_contains(t, "pblang")) {
        let gen = generate(prompt, 80);
        return "pbAI native generation (pbAI-Nano char LM, pblang source corpus):\n" + gen;
    }
    if str_contains(t, "pbai") and (str_contains(t, "asset") or str_contains(t, "checkpoint") or str_contains(t, "tokenizer") or str_contains(t, "model")) {
        return PBAI_ASSETS.describe();
    }
    if str_contains(t, "mcp") or str_contains(t, "tool") or str_contains(t, "workspace") {
        let ctx = try MCP.workspace_context() catch nil;
        if ctx != nil {
            return "pbAI tools: pblang-native pb_mcp bridge is active at " + str(ctx.root) + ". Safe core tools: workspace_context, read_file, read_file_tail, list_files, project_tree, grep_code. Use pbAI.tool_call(name, args) from pblang.";
        }
        return "pbAI tools: pb_mcp bridge is available as stdlib/pb_mcp.sapp; safe core tools include workspace_context/read_file/list_files/project_tree/grep_code.";
    }
    if str_contains(t, "self-host") or str_contains(t, "selfhost") or str_contains(t, "bootstrap") { return "pbAI: pblang is SELF-HOSTING — stdlib/compiler/ (tokenizer/parser/typeck/codegen/vm, all .sapp) compiles AND runs pblang. F5 in the IDE runs your buffer through it."; }
    if str_contains(t, "jit") or str_contains(t, "cranelift") or str_contains(t, "fast") or str_contains(t, "perf") or str_contains(t, "speed") { return "pbAI: perf — the VM is a Rust bytecode interpreter; a Cranelift JIT (gated by PBLANG_JIT) compiles loop-free/call-free numeric fns. For integer/float kernels you can also emit REAL native machine code (ask about 'native codegen'). Cache expensive work to disk; don't recompute per frame."; }
    if str_contains(t, "native") or str_contains(t, "machine code") or str_contains(t, "codegen") or str_contains(t, "compile to") or str_contains(t, "binary") or str_contains(t, "exe ") or str_contains(t, "assembl") { return "pbAI: native codegen (NO Rust) — emit REAL machine code: stdlib/codegen_x64 / codegen_x86 (i386) / codegen_arm64 cover arithmetic, loops, conditionals, functions, recursion, floats (SSE2) and syscalls; wrap as ELF/Mach-O/PE with stdlib/codegen_cross. Easiest paths: stdlib/native.sapp (run(ir)/run_value(ir) — JIT by exec), stdlib/native_studio.sapp (validate+optimize+cache+metrics; folded constants run in-process), and stdlib/native_lang.sapp lowers expression/variable ASTs to native. Functions get args+return+recursion via codegen_x64.compile_call_unit."; }
    if str_contains(t, "device") or str_contains(t, "driver") or str_contains(t, "hal") or str_contains(t, "gpio") or str_contains(t, "ioctl") or str_contains(t, "i2c") { return "pbAI: devices/drivers — use the current OS drivers from pblang. stdlib/device.sapp reads/writes /dev, /sys, /proc (e.g. random_uuid() via the kernel RNG driver; ⚠ never fs_read_bytes an UNBOUNDED device like /dev/urandom — do a sized read in generated native code instead). stdlib/hal.sapp is a HAL: a device catalog + common verbs (read/write/open/ioctl/...) mapped to Linux syscall numbers per arch, the Windows API, and ioctl request codes — hal.recipe(class, verb) gives the how-to. ioctl/mmap devices are driven by generated syscalls; GPU/NPU vendor stacks need FFI."; }
    if str_contains(t, "security") or str_contains(t, "capab") or str_contains(t, "permission") or str_contains(t, "allow") or str_contains(t, "sandbox") or str_contains(t, "exec") { return "pbAI: security — capabilities gate sensitive builtins. `--sandbox` denies risky defaults; `--allow-exec` and `--allow-ffi` are high-trust. env reads can expose secrets, so use `--deny-env` for untrusted scripts."; }
    if str_contains(t, "import") or str_contains(t, "module") { return "pbAI: modules — `let m = import(\"stdlib/foo.sapp\");` then `m.fn(...)`. Export with `export a, b;`. Keep imports at TOP level (lazy import() inside a fn resolves relative to the CWD)."; }
    if str_contains(t, "error") or str_contains(t, "try") or str_contains(t, "catch") or str_contains(t, "throw") { return "pbAI: errors — `try EXPR catch FALLBACK` (an expression); `throw v` raises; `error(\"msg\")` raises from a builtin. Missing map keys and bad index raise — wrap them."; }
    if str_contains(t, "async") or str_contains(t, "await") or str_contains(t, "concurren") or str_contains(t, "thread") or str_contains(t, "spawn") { return "pbAI: concurrency — `async fn`, `spawn`/`spawn_n` for parallel tasks, and a waitgroup in stdlib. The self-hosted compiler models async too."; }
    if str_contains(t, "bignum") or str_contains(t, "rational") or str_contains(t, "decimal") or str_contains(t, "precision") { return "pbAI: precision ladder — `bigint(n)` (arbitrary integers), `rational(a, b)` (exact fractions), `decimal(\"3.14\")` (fixed decimals). Arithmetic/compare operators work across them."; }
    if str_contains(t, "match") or str_contains(t, "enum") { return "pbAI: `match x { case 1: \"a\" case 2: \"b\" else: \"c\" }` is an expression; `enum` defines variants. Both self-host."; }
    if str_contains(t, "operator") or str_contains(t, "overload") or str_contains(t, "dunder") { return "pbAI: operator overloading via dunder methods on a map — `__add__`, `__lt__`, `__rmul__` (reflected), etc. `box(2) + box(4)` dispatches to `__add__`."; }
    if str_contains(t, "typeclass") or str_contains(t, "trait") { return "pbAI: typeclasses — `stdlib/typeclass.sapp` gives runtime ad-hoc polymorphism: define required methods, register instances by type/interface/class/predicate, then generic-dispatch with call/call1/call2. Eq includes executable law checks."; }
    if str_contains(t, "logic") or str_contains(t, "datalog") or str_contains(t, "relational") { return "pbAI: logic — `stdlib/logic.sapp` supports facts, variables (`?X`), rules, conjunctive queries, and projection. It renames rule variables hygienically before solving."; }
    if str_contains(t, "reactive") or str_contains(t, "stream") or str_contains(t, "observable") { return "pbAI: reactive — `stdlib/observable.sapp` has refs, computed values, batching, subjects, subscriptions, and map/filter/scan/take/merge/combine_latest streams."; }
    if str_contains(t, "array") or str_contains(t, "list") or str_contains(t, "slice") { return "pbAI: arrays — `[1, 2, 3]`, index `a[i]`, `len(a)`, `push(a, v)`/`pop(a)`, `slice(a, i, j)`. Iterate `for v in a { ... }`. Arrays are append-style (rebuild to insert/remove)."; }
    if str_contains(t, "map") or str_contains(t, "dict") or str_contains(t, "hash") { return "pbAI: maps — `map{ k: v }`; read `m[k]` (a MISSING key RAISES, it is not nil — use `map_has(m, k)`); `map_keys(m)`, `map_remove(m, k)`. Member sugar `m.k` works for ident keys."; }
    if str_contains(t, "loop") or str_contains(t, "while") or str_contains(t, "iterate") { return "pbAI: loops — `while cond { ... }`, `for i N { ... }` (i in 0..N), `for v in arr { ... }`. `break`/`continue` as usual."; }
    if str_contains(t, "function") or str_contains(t, "fn ") or str_contains(t, "closure") { return "pbAI: functions — `fn name(a, b = 1) { return a + b; }`; anonymous `fn(x) { ... }` are closures that capture their scope. No UFCS — `obj.f()` is field access, use a free fn or `obj:f()` colon-call."; }
    if str_contains(t, "struct") or str_contains(t, "class") or str_contains(t, "oop") or str_contains(t, "object") { return "pbAI: OOP — `struct Pt { x, y }` and `class` with methods both self-host; construct `Pt(1, 2)`, access `p.x`, call methods `obj:method(args)`."; }
    if str_contains(t, "string") or str_contains(t, "text") or str_contains(t, "char") { return "pbAI: strings are codepoint-based; `<`/`>` comparison is unsupported (use strcharcodeat/length). `+` concatenates; str_split/str_slice/str_index_of/str_contains/strcharcodeat/strfromcharcode are the workhorses."; }
    if str_contains(t, "print") or str_contains(t, "output") { return "pbAI: `print x;` is a STATEMENT (not a function) — `print(x)` errors. It writes a line to stdout; the IDE F5 captures printed values."; }
    if str_contains(t, "resize") or (str_contains(t, "window") and str_contains(t, "size")) { return "pbAI: window size — `win.size()` returns the FIXED framebuffer size, NOT the live OS-resized size (the graphics builtin never exposes it). Read the real resized window with `stdlib/window_probe.sapp`: `wp.size_by_title(title)` queries the WM (xwininfo/xdotool; needs --allow-exec). Poll it and relayout when `wp.changed(prev, cur)`."; }
    if str_contains(t, "graphics") or str_contains(t, "window") or str_contains(t, "draw") or str_contains(t, "gui") or str_contains(t, "canvas") { return "pbAI: graphics — `let gfx = import(\"stdlib/graphics.sapp\"); let win = gfx.Window(w, h, title);` then per frame `win.clear(c)`, `win.rect/line/point/text(...)`, `win.present()`, `win.pollEvents()`. `gfx.run(win, state, update, draw, fps)` drives the loop. Build a modern UI with `stdlib/ui_kit.sapp` (rounded cards/pills/scrollbar) + `stdlib/theme.sapp`."; }
    if str_contains(t, "test") or str_contains(t, "tdd") or str_contains(t, "assert") { return "pbAI: testing — add `*_test.sapp` files under tests/semantics that `print \"..._pass\"` on success and `throw` on failure (each defines `test_` cases or runs wholesale); run `pblang test semantics` or `pblang run tests/semantics/x_test.sapp --allow-all`. `stdlib/assert.sapp` has eq/gt/contains helpers. TDD: write the failing test FIRST, watch it fail, then implement."; }
    if str_contains(t, "package") or str_contains(t, "depend") or str_contains(t, "registry") or str_contains(t, "manifest") { return "pbAI: packages — a project carries a `pblang.toml` manifest; `pblang build` generates the lockfile + typechecks the entry, `pblang manifest-check` validates the manifest. Imports resolve `stdlib/...` and local modules — keep them at top level."; }
    if str_contains(t, "ide") or str_contains(t, "editor") or str_contains(t, "shortcut") or str_contains(t, "key") { return "pbAI: IDE — tabs CODE/TERMINAL/DESIGN/AI/BROWSER. In CODE: F5 run, F6 check, Ctrl+S save, Ctrl+F find, Ctrl+arrow word/fast move, Shift+arrow select. Launch with `pblang --ide`."; }
    if str_contains(t, "hello") or str_contains(t, "hi ") or t == "hi" or str_contains(t, "who are you") or str_contains(t, "what can you") { return "pbAI: I'm pblang's own assistant (a neural intent classifier + pblang-grounded skills; no network, no Ollama). Ask about the language, or use EXPLAIN/BUGS/IMPROVE/COMMENT on the code in your editor."; }
    return "pbAI (pblang's own assistant). Ask about pblang specifics (maps, loops, fns, OOP, strings, errors, imports, async, precision, JIT, capabilities), or use a quick action (explain / bugs / improve / comment) on your editor buffer.";
}

// Does the prompt actually carry pblang code worth analyzing? The code-skills
// (explain/bugs/improve/comment) are useless without it, so a free-text question that
// the classifier mis-routes to one of them is answered from the knowledge base instead.
fn _has_code(code, s) {
    return s.fns > 0 or s.lets > 0 or s.open_brace > 0 or s.whiles > 0 or s.fors > 0
        or str_contains(code, "print ") or str_contains(code, "import(") or str_contains(code, "return ");
}

// ── Entry points ─────────────────────────────────────────────────────────────────────
fn _run(intent, prompt) {
    let code = _extract_code(prompt);
    let s = _scan(code);
    if intent <= 3 and not _has_code(code, s) { return _general(prompt); }   // no code → answer the question
    if intent == 0 { return _explain(code, s); }
    if intent == 1 { return _bugs(code, s); }
    if intent == 2 { return _improve(code, s); }
    if intent == 3 { return _comment(code, s); }
    return _general(prompt);
}

fn _smart_parts(prompt, options = nil) {
    let scores = classify_scores(prompt);
    let confidence = scores.scores[0];
    let i = 1;
    while i < len(scores.scores) {
        if scores.scores[i] > confidence { confidence = scores.scores[i]; }
        i = i + 1;
    }
    return map{
        scores: scores,
        plan: SMART.plan(prompt, confidence, SMART.with_profile(options, "embedded"))
    };
}

// smart_plan/smart_respond keep the embedded assistant cheap: exactly one lane
// runs. The standalone product can honor heavier lanes; this compatibility layer
// degrades to a grounded skill whenever only the embedded model is available.
fn smart_plan(prompt, options = nil) { return _smart_parts(prompt, options).plan; }

fn smart_respond(prompt, options = nil) {
    let parts = _smart_parts(prompt, options);
    let routing = parts.plan;
    if not routing.ok or not routing.admitted {
        return map{
            format: "pbai.smart.response.v1", ok: false,
            text: "pbAI request requires explicit approval.", plan: routing, thought: nil
        };
    }
    // Keep the established response formatter for every embedded lane. For a
    // generation request the general skill invokes Nano exactly once and adds
    // the compatibility context expected by IDE/API callers.
    let text = _run(nn.argmax(parts.scores.scores), prompt);
    return map{
        format: "pbai.smart.response.v1", ok: true,
        text: text, plan: routing, thought: nil,
        verification: nil,
        verification_pending: routing.requires_independent_verifier,
        authorized_for_action: not routing.requires_independent_verifier,
        human_review_required: routing.requires_independent_verifier
    };
}

// Backward-compatible string API, now backed by the single-expert scheduler.
fn respond(prompt) { return smart_respond(prompt).text; }

// Direct skill entry points — run a specific code skill WITHOUT intent classification
// (handy for tools/agents that already know what they want, and for fast/deterministic
// use). Each extracts the code from the prompt and runs the grounded analyzer.
fn review(prompt) { let code = _extract_code(prompt); return _bugs(code, _scan(code)); }
fn suggest(prompt) { let code = _extract_code(prompt); return _improve(code, _scan(code)); }
fn explain_code(prompt) { let code = _extract_code(prompt); return _explain(code, _scan(code)); }
fn comment_code(prompt) { let code = _extract_code(prompt); return _comment(code, _scan(code)); }
// knowledge(prompt) — answer a pblang question directly from the grounded knowledge base
// (the _general skill), bypassing intent classification.
fn knowledge(prompt) { return _general(prompt); }

fn generate(prompt, n = 80) {
    let seed = _extract_code(prompt);
    if seed == "" or not _has_code(seed, _scan(seed)) {
        if str_contains(str_lower(prompt), "fn ") { seed = "fn "; }
        else if str_contains(str_lower(prompt), "let ") { seed = "let "; }
        else { seed = "fn "; }
    }
    let out = PBAI_LM.generate_nano(seed, n, 4);
    return out.text;
}

fn model_status() {
    let ckpt = PBAI_LM.train_nano(2, 0.2);
    return map{
        family: "pbAI",
        top: map{
            assistant: "stdlib/pbai.sapp",
            router: "neural intent classifier + grounded pblang skills",
            tools: "stdlib/pb_mcp.sapp bridge"
        },
        bottom: map{
            lm: "stdlib/pbai_lm.sapp",
            tier: ckpt.tier,
            format: ckpt.format,
            source: ckpt.source,
            architecture: ckpt.architecture,
            learns: ckpt.metrics.loss_after < ckpt.metrics.loss_before
        },
        references: PBAI_ASSETS.implementation_plan()
    };
}

// respond_tool(tool, prompt) — a tool name hint (from the gateway) overrides routing.
fn respond_tool(tool, prompt) {
    if tool == "ai_ollama_generate" { return generate(prompt, 80); } // replaced locally by native pbAI
    if tool == "ai_self_critique" { return _run(1, prompt); }       // critique ≈ find bugs
    if tool == "ai_structured_extract" { return _run(0, prompt); }  // extract ≈ explain
    return respond(prompt);
}

fn tool_catalog() {
    return MCP.tool_catalog();
}

fn tool_call(name, args = nil) {
    return MCP.call(name, args);
}

// intents() — the list of intent labels the classifier can produce.
fn intents() { return _INTENTS; }

// confidence(prompt) — the top (max) classification score for a prompt.
fn confidence(prompt) {
    let y = nn.predict(_model(), _featurize(prompt));
    let m = y[0];
    let i = 1;
    while i < len(y) { if y[i] > m { m = y[i]; } i = i + 1; }
    return m;
}

// top_intents(prompt, k) — the k highest-scoring intents as [{intent, score}], desc.
fn top_intents(prompt, k) {
    let y = nn.predict(_model(), _featurize(prompt));
    let pairs = [];
    let i = 0;
    while i < len(_INTENTS) and i < len(y) {
        array_push(pairs, map{ intent: _INTENTS[i], score: y[i] });
        i = i + 1;
    }
    let a = 1;
    while a < len(pairs) {
        let key = pairs[a];
        let b = a - 1;
        while b >= 0 and pairs[b].score < key.score { pairs[b + 1] = pairs[b]; b = b - 1; }
        pairs[b + 1] = key;
        a = a + 1;
    }
    if k > len(pairs) { k = len(pairs); }
    let out = [];
    let j = 0;
    while j < k { array_push(out, pairs[j]); j = j + 1; }
    return out;
}

// ── device-aware batch classification ─────────────────────────────────────────────────
// capabilities() — the compute power pbAI can use on this machine.
fn capabilities() {
    let cores = try OS.cpu_count() catch 1;
    let gpu = false;
    let g = try W.gpus() catch nil;
    if g != nil { let a = try g.available catch false; if a == true { gpu = true; } }
    return map{ cpu_cores: cores, gpu: gpu, parallel_batch: true,
        cpu_accel: try ACC.cpu_accel() catch map{},
        accelerators: try ACC.detect() catch [], best_device: try ACC.best() catch "cpu" };
}
// accelerators() — full CPU/GPU/NPU(AI accelerator) survey. best_device() — best USABLE one.
fn accelerators() { return ACC.detect(); }
fn best_device() { return ACC.best(); }
// register_accel(kind, fn) — plug a native (FFI) GPU/NPU runtime so pbAI offloads to it.
fn register_accel(kind, f) { return ACC.register_runtime(kind, f); }
// classify_batch_smart(prompts) — route to the AI accelerator if a runtime is plugged, else
// fan out across all CPU cores. "Use the full power of the device", honestly.
fn classify_batch_smart(prompts) {
    let d = ACC.best();
    if d != "cpu" {
        let r = ACC.run(d, prompts);
        if r != nil { return r; }
    }
    // Honest GPU path: on a `--features gpu` build the tensor matmul auto-offloads to the GPU.
    // (Returns plain intent strings, same shape as the CPU path.)
    let gpu = try W.compute().gpu_enabled catch false;
    if gpu == true {
        let conf = classify_batch_tensor(prompts);
        let out = [];
        let i = 0;
        while i < len(conf) { array_push(out, conf[i].intent); i = i + 1; }
        return out;
    }
    return classify_batch_parallel(prompts);
}
fn _intent_of(prompt) { return _INTENTS[classify(prompt)]; }
// classify_batch(prompts) — classify a list, sequentially.
fn classify_batch(prompts) {
    let out = [];
    let i = 0;
    while i < len(prompts) { array_push(out, _intent_of(prompts[i])); i = i + 1; }
    return out;
}
// classify_batch_parallel(prompts) — fan the batch out across ALL CPU cores. Each worker is
// SELF-CONTAINED (its argument + builtins only): the model weights + vocab are packed per
// chunk and the featurize+MLP-forward+argmax are inlined. Results match classify_batch.
fn classify_batch_parallel(prompts) {
    let net = _model();
    let cores = try OS.cpu_count() catch 1;
    if cores < 1 { cores = 1; }
    let per = num_floor((len(prompts) + cores - 1) / cores);
    if per < 1 { per = 1; }
    let jobs = [];
    let s = 0;
    while s < len(prompts) {
        let chunk = [];
        let j = 0;
        while j < per and s + j < len(prompts) { array_push(chunk, prompts[s + j]); j = j + 1; }
        array_push(jobs, map{ prompts: chunk, vocab: _VOCAB,
            l1w: net.l1.w, l1b: net.l1.b, l2w: net.l2.w, l2b: net.l2.b,
            nin: net.l1.n_in, nh: net.l1.n_out, no: net.l2.n_out });
        s = s + per;
    }
    let parts = P.par_map(jobs, fn(job) {
        let out = [];
        let pi = 0;
        while pi < len(job.prompts) {
            let t = str_lower(job.prompts[pi]);
            let x = [];
            let v = 0;
            while v < len(job.vocab) { if str_contains(t, job.vocab[v]) { array_push(x, 1); } else { array_push(x, 0); } v = v + 1; }
            let h = [];
            let o = 0;
            while o < job.nh { let acc = job.l1b[o]; let i = 0; while i < job.nin { acc = acc + job.l1w[o][i] * x[i]; i = i + 1; } array_push(h, 1 / (1 + num_exp(0 - acc))); o = o + 1; }
            let bi = 0; let bv = 0; let o2 = 0;
            while o2 < job.no {
                let acc2 = job.l2b[o2]; let k = 0; while k < job.nh { acc2 = acc2 + job.l2w[o2][k] * h[k]; k = k + 1; }
                let y = 1 / (1 + num_exp(0 - acc2));
                if o2 == 0 or y > bv { bv = y; bi = o2; }
                o2 = o2 + 1;
            }
            array_push(out, bi);
            pi = pi + 1;
        }
        return out;
    });
    let result = [];
    let c = 0;
    while c < len(parts) { let r = parts[c]; let j = 0; while j < len(r) { array_push(result, _INTENTS[r[j]]); j = j + 1; } c = c + 1; }
    return result;
}

// classify_batch_confident(prompts) — like classify_batch_parallel but each result carries the
// native softmax CONFIDENCE: [{intent, confidence}]. Confidence matches single-prompt
// confidence(). Same self-contained all-cores worker, now returning {idx, conf} per item.
fn classify_batch_confident(prompts) {
    let net = _model();
    let cores = try OS.cpu_count() catch 1;
    if cores < 1 { cores = 1; }
    let per = num_floor((len(prompts) + cores - 1) / cores);
    if per < 1 { per = 1; }
    let jobs = [];
    let s = 0;
    while s < len(prompts) {
        let chunk = [];
        let j = 0;
        while j < per and s + j < len(prompts) { array_push(chunk, prompts[s + j]); j = j + 1; }
        array_push(jobs, map{ prompts: chunk, vocab: _VOCAB,
            l1w: net.l1.w, l1b: net.l1.b, l2w: net.l2.w, l2b: net.l2.b,
            nin: net.l1.n_in, nh: net.l1.n_out, no: net.l2.n_out });
        s = s + per;
    }
    let parts = P.par_map(jobs, fn(job) {
        let out = [];
        let pi = 0;
        while pi < len(job.prompts) {
            let t = str_lower(job.prompts[pi]);
            let x = [];
            let v = 0;
            while v < len(job.vocab) { if str_contains(t, job.vocab[v]) { array_push(x, 1); } else { array_push(x, 0); } v = v + 1; }
            let h = [];
            let o = 0;
            while o < job.nh { let acc = job.l1b[o]; let i = 0; while i < job.nin { acc = acc + job.l1w[o][i] * x[i]; i = i + 1; } array_push(h, 1 / (1 + num_exp(0 - acc))); o = o + 1; }
            let bi = 0; let bv = 0; let o2 = 0;
            while o2 < job.no {
                let acc2 = job.l2b[o2]; let k = 0; while k < job.nh { acc2 = acc2 + job.l2w[o2][k] * h[k]; k = k + 1; }
                let y = 1 / (1 + num_exp(0 - acc2));
                if o2 == 0 or y > bv { bv = y; bi = o2; }
                o2 = o2 + 1;
            }
            array_push(out, map{ idx: bi, conf: bv });
            pi = pi + 1;
        }
        return out;
    });
    let result = [];
    let c = 0;
    while c < len(parts) { let r = parts[c]; let j = 0; while j < len(r) { array_push(result, map{ intent: _INTENTS[r[j].idx], confidence: r[j].conf }); j = j + 1; } c = c + 1; }
    return result;
}


// classify_batch_tensor(prompts) — the WHOLE batch forward as two matmuls + sigmoid. tensor.dot
// auto-offloads large matmuls to the GPU on a `--features gpu` build (f32) and fans over CPU
// cores otherwise, so this is the honest "use the accelerator" path — same math, real hardware,
// no FFI, no mock. Bias is folded in via an appended 1-column (X_aug · W_aug trick). Returns
// [{intent, confidence}], numerically identical to the scalar classifier.
fn classify_batch_tensor(prompts) {
    let N = len(prompts);
    if N == 0 { return []; }
    let net = _model();
    let nin = net.l1.n_in; let nh = net.l1.n_out; let no = net.l2.n_out;
    // X_aug: N x (nin+1), last column = 1 (the bias input)
    let xdata = [];
    let p = 0;
    while p < N {
        let t = str_lower(prompts[p]);
        let v = 0;
        while v < nin { if str_contains(t, _VOCAB[v]) { array_push(xdata, 1); } else { array_push(xdata, 0); } v = v + 1; }
        array_push(xdata, 1);
        p = p + 1;
    }
    let X = T.tensor([N, nin + 1], xdata);
    // W1_aug: (nin+1) x nh — rows are inputs, last row is the bias; W1a[i][o] = w[o][i]
    let w1 = [];
    let i1 = 0;
    while i1 < nin { let o = 0; while o < nh { array_push(w1, net.l1.w[o][i1]); o = o + 1; } i1 = i1 + 1; }
    let ob1 = 0; while ob1 < nh { array_push(w1, net.l1.b[ob1]); ob1 = ob1 + 1; }
    let H = T.sigmoid(T.dot(X, T.tensor([nin + 1, nh], w1)));   // N x nh
    // H_aug: N x (nh+1) with a bias column
    let hdata = [];
    let r = 0;
    while r < N { let k = 0; while k < nh { array_push(hdata, T.get(H, [r, k])); k = k + 1; } array_push(hdata, 1); r = r + 1; }
    let Ha = T.tensor([N, nh + 1], hdata);
    let w2 = [];
    let k2 = 0;
    while k2 < nh { let o = 0; while o < no { array_push(w2, net.l2.w[o][k2]); o = o + 1; } k2 = k2 + 1; }
    let ob2 = 0; while ob2 < no { array_push(w2, net.l2.b[ob2]); ob2 = ob2 + 1; }
    let O = T.sigmoid(T.dot(Ha, T.tensor([nh + 1, no], w2)));   // N x no
    let out = [];
    let rr = 0;
    while rr < N {
        let bi = 0; let bv = T.get(O, [rr, 0]);
        let c = 1;
        while c < no { let y = T.get(O, [rr, c]); if y > bv { bv = y; bi = c; } c = c + 1; }
        array_push(out, map{ intent: _INTENTS[bi], confidence: bv });
        rr = rr + 1;
    }
    return out;
}

// is_intent(name) — is `name` a known classifier intent?
fn is_intent(name) {
    let i = 0;
    while i < len(_INTENTS) { if _INTENTS[i] == name { return true; } i = i + 1; }
    return false;
}

// _intent_index(name) — intent label -> classifier index (falls back to "general").
fn _intent_index(name) {
    let i = 0;
    while i < len(_INTENTS) { if _INTENTS[i] == name { return i; } i = i + 1; }
    return len(_INTENTS) - 1;
}

// respond_as(intent_name, prompt) — run the grounded skill for an ALREADY-decided intent
// (by label). This is the public hook ensemble hosts (combined_mllm) wire as responder.
fn respond_as(intent_name, prompt) { return _run(_intent_index(intent_name), prompt); }

// ── unified MLLM ensemble: delegate to the shared engine (stdlib/pbai_ensemble.sapp) ──
ENS.configure(classify_scores, _INTENTS);
// answer synthesis: the ensemble decides the intent, then pbAI's grounded skill for that
// intent produces the FULL text answer — the MLLM returns answers, not just labels.
ENS.set_responder(respond_as);
let ensemble = ENS.ensemble;
let ensemble_detail = ENS.ensemble_detail;
let ensemble_confidence = ENS.ensemble_confidence;
let ensemble_decide = ENS.ensemble_decide;
let ensemble_batch = ENS.ensemble_batch;
let register_voter = ENS.register_voter;
let register_voter_weighted = ENS.register_voter_weighted;
let register_model = ENS.register_model;
let clear_native_cache = ENS.clear_native_cache;
let evaluate = ENS.evaluate;
let calibrate = ENS.calibrate;
let calibration_report = ENS.calibration_report;
let set_routing = ENS.set_routing;
let reliability_for = ENS.reliability_for;
let tune_weights = ENS.tune_weights;
let set_voter_weight = ENS.set_voter_weight;
let auto_configure = ENS.auto_configure;
let set_responder = ENS.set_responder;
let answer = ENS.answer;
let set_fusion = ENS.set_fusion;
let explain_decision = ENS.explain_decision;
let explain_line = ENS.explain_line;
let uncertainty = ENS.uncertainty;
let decide_ex = ENS.decide_ex;
let set_native_weight = ENS.set_native_weight;
let voters = ENS.voters;
let clear_voters = ENS.clear_voters;
let llm_voter = ENS.llm_voter;
let reliability = ENS.reliability;
let set_adaptive = ENS.set_adaptive;
let reset_stats = ENS.reset_stats;
let record_outcome = ENS.record_outcome;
let save_stats = ENS.save_stats;
let load_stats = ENS.load_stats;
let memoize_voter = ENS.memoize_voter;
let clear_voter_cache = ENS.clear_voter_cache;
let voter_cache_stats = ENS.voter_cache_stats;
let set_parallel = ENS.set_parallel;
let ollama_available = ENS.ollama_available;
let ollama_voter = ENS.ollama_voter;
let use_ollama = ENS.use_ollama;

// ── sampling recommendation + answer cleanup (harvested from G0DM0D3) ──────────────
// pbAI can suggest per-prompt LLM sampling parameters (temperature/top_p/...) tuned to
// the prompt's context, and LEARN which settings worked via binary feedback. It can
// also normalize its own synthesized answers (strip preambles/hedging/formality).
let _SAMPLING = TUNE.new_state();
// recommend_sampling(prompt) — {context, params} for this prompt, using learned tuning.
fn recommend_sampling(prompt) { return TUNE.tune_learned(_SAMPLING, prompt); }
// sampling_context(prompt) — just the classified sampling context label.
fn sampling_context(prompt) { return TUNE.classify(prompt); }
// record_sampling(context, params, rating) — teach the tuner (rating 1 = params worked).
fn record_sampling(context, params, rating) { return TUNE.record(_SAMPLING, context, params, rating); }
// normalize_reply(text) — tidy a raw model reply (preambles/hedging/formality).
fn normalize_reply(text) { return NORM.normalize(text); }
// answer_clean(prompt, threshold) — like answer(), but its .text is normalized.
fn answer_clean(prompt, threshold = 0.6) {
    let a = answer(prompt, threshold);
    if map_has(a, "text") { a.text = NORM.normalize(a.text); }
    return a;
}

// ── adversarial input de-obfuscation (defensive: undo leetspeak/homoglyph/zero-width) ─
// sanitize_input(text) — the canonical form a guard/classifier should judge.
fn sanitize_input(text) { return DEOB.canonicalize(text); }
// input_risk(text) — obfuscation report {score, techniques, canonical, ...}.
fn input_risk(text) { return DEOB.detect(text); }
// classify_safe(prompt) — classify the DE-OBFUSCATED prompt so evasion can't reroute it.
fn classify_safe(prompt) { return classify(DEOB.canonicalize(prompt)); }
// assess_prompt(prompt) — defensive harm triage {category, score, matched, safe} for the
// prompt (de-obfuscated first). Route unsafe prompts to escalation/refusal, don't answer blind.
fn assess_prompt(prompt) { return PSAFE.classify(prompt); }
fn prompt_is_safe(prompt) { return PSAFE.is_safe(prompt); }

