    arg: complex_arg,
    exp: complex_exp,
    ln: complex_ln,
    pow_scalar: complex_pow_scalar,
    sqrt: complex_sqrt,
    abs: complex_abs,
    abs2: complex_abs2,
    modulus_scalar: complex_modulus_scalar,
    to_string: complex_to_string,
    interactive: complex_numbers
};

