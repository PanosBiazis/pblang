// ---------------- Linear algebra (arrays + arrays-of-arrays) ----------------

fn _la_assert_same_len(a, b) {
    if len(a) != len(b) { return nil; }
    return true;
}

fn la_vec_add(a, b) {
    _la_assert_same_len(a, b);
    if len(a) >= _MATH_NATIVE_VEC_THRESHOLD {
        let fast = _native_vec_add(a, b);
        if fast != nil { return fast; }
    }
    let out = [];
    for i len(a) { out[len(out)] = a[i] + b[i]; }
    return out;
}

fn la_vec_sub(a, b) {
    _la_assert_same_len(a, b);
    if len(a) >= _MATH_NATIVE_VEC_THRESHOLD {
        let fast = _native_vec_sub(a, b);
        if fast != nil { return fast; }
    }
    let out = [];
    for i len(a) { out[len(out)] = a[i] - b[i]; }
    return out;
}

fn la_vec_dot(a, b) {
    _la_assert_same_len(a, b);
    if len(a) >= _MATH_NATIVE_DOT_THRESHOLD {
        let fast = _native_vec_dot(a, b);
        if fast != nil { return fast; }
    }
    let s = 0;
    for i len(a) { s = s + a[i] * b[i]; }
    return s;
}

fn la_vec_scale(a, k) {
    if len(a) >= _MATH_NATIVE_VEC_THRESHOLD {
        let fast = _native_vec_scale(a, k);
        if fast != nil { return fast; }
    }
    let out = [];
    for i len(a) { out[len(out)] = a[i] * k; }
    return out;
}

fn la_mat_identity(n) {
    let m = [];
    for i n {
        let row = [];
        for j n {
            if i == j { row[len(row)] = 1; } else { row[len(row)] = 0; }
        }
        m[len(m)] = row;
    }
    return m;
}

fn la_mat_transpose(A) {
    if len(A) == 0 { return []; }
    let rows = len(A);
    let cols = len(A[0]);
    let out = [];
    for j cols {
        let row = [];
        for i rows {
            row[len(row)] = A[i][j];
        }
        out[len(out)] = row;
    }
    return out;
}

fn la_mat_mul(A, B) {
    if len(A) == 0 { return []; }
    if len(B) == 0 { return []; }
    let m = len(A);
    let n = len(A[0]);
    let p = len(B[0]);
    if m * n * p >= _MATH_NATIVE_MATMUL_THRESHOLD {
        let fast = _native_mat_mul(A, B);
        if fast != nil { return fast; }
    }
    let out = [];
    for i m {
        let row = [];
        for j p {
            let s = 0;
            for k n { s = s + A[i][k] * B[k][j]; }
            row[len(row)] = s;
        }
        out[len(out)] = row;
    }
    return out;
}

fn la_mat_vec_mul(A, x) {
    if len(A) > 0 and len(A) * len(x) >= _MATH_NATIVE_MATMUL_THRESHOLD {
        let col = [];
        for i len(x) { col[len(col)] = [x[i]]; }
        let fast = _native_mat_mul(A, col);
        if fast != nil {
            let out_fast = [];
            for i len(fast) { out_fast[len(out_fast)] = fast[i][0]; }
            return out_fast;
        }
    }
    let out = [];
    for i len(A) {
        out[len(out)] = la_vec_dot(A[i], x);
    }
    return out;
}

fn la_det2(A) {
    // [[a,b],[c,d]] -> ad - bc
    return A[0][0] * A[1][1] - A[0][1] * A[1][0];
}

fn la_solve2(A, b) {
    // Solve 2x2: A x = b
    let det = la_det2(A);
    if det == 0 { return nil; }
    let x0 = (b[0] * A[1][1] - A[0][1] * b[1]) / det;
    let x1 = (A[0][0] * b[1] - b[0] * A[1][0]) / det;
    return [x0, x1];
}

let la = map{
    vec_add: la_vec_add,
    vec_sub: la_vec_sub,
    vec_dot: la_vec_dot,
    vec_scale: la_vec_scale,
    mat_identity: la_mat_identity,
    mat_transpose: la_mat_transpose,
    mat_mul: la_mat_mul,
    mat_vec_mul: la_mat_vec_mul,
    det2: la_det2,
    solve2: la_solve2
};

// ---- Utility scalar helpers (G3-beta) ----

fn util_clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn util_lerp(a, b, t) {
    return a + (b - a) * t;
}

fn util_smoothstep(edge0, edge1, x) {
    let t = util_clamp((x - edge0) / (edge1 - edge0), 0, 1);
    return t * t * (3 - 2 * t);
}

let util = map{
    clamp: util_clamp,
    lerp: util_lerp,
    smoothstep: util_smoothstep
};

let stats = map{
    sum: sum,
    mean: mean,
    median: median,
    variance: variance,
    stddev: stddev,
    min: min,
    max: max,
    range: range
};

// --- Numeric helpers ---
let abs = num_abs;
let max = num_max;
let min = num_min;

export complex, logic, algorithms, la, main_menu, run, util, stats, abs, max, min;
