// Math stdlib module (interactive + library APIs).
//
// Import:
//   let math = import("stdlib:math.sapp");
//   let c = math.complex.new(1, 2);
//   print math.complex.to_string(c);

// ---------------- Complex numbers (as map{ re, im }) ----------------

fn complex_new(re, im) {
    return map{ re: re, im: im };
}

fn complex_add(a, b) {
    return complex_new(a.re + b.re, a.im + b.im);
}

fn complex_sub(a, b) {
    return complex_new(a.re - b.re, a.im - b.im);
}

fn complex_mul(a, b) {
    return complex_new(
        a.re * b.re - a.im * b.im,
        a.re * b.im + a.im * b.re
    );
}

fn complex_conj(a) {
    return complex_new(a.re, 0 - a.im);
}

fn complex_abs2(a) {
    return a.re * a.re + a.im * a.im;
}

fn complex_abs(a) {
    return num_sqrt(complex_abs2(a));
}

fn complex_norm(a) {
    return complex_abs(a);
}

fn complex_div_scalar(a, s) {
    return complex_new(a.re / s, a.im / s);
}

fn complex_arg(a) {
    return num_atan2(a.im, a.re);
}

// NOTE: this matches the provided Rust code (component-wise),
// not the mathematical complex exp/ln/pow.
fn complex_exp(a) {
    return complex_new(num_exp(a.re), num_exp(a.im));
}

fn complex_ln(a) {
    return complex_new(num_ln(a.re), num_ln(a.im));
}

fn complex_pow_scalar(a, p) {
    return complex_new(num_pow(a.re, p), num_pow(a.im, p));
}

fn complex_sqrt(a) {
    return complex_new(num_sqrt(a.re), num_sqrt(a.im));
}

fn complex_modulus_scalar(a, m) {
    return complex_new(num_mod(a.re, m), num_mod(a.im, m));
}

fn complex_to_string(a) {
    if a.im < 0 {
        return str(a.re) + " - " + str(0 - a.im) + "i";
    }
    return str(a.re) + " + " + str(a.im) + "i";
}

fn _read_number(prompt) {
    while true {
        print prompt;
        let s = read_line();
        if s == nil { return nil; }
        let n = try parse_number(str_trim(s)) catch nil;
        if n != nil { return n; }
        print "Please enter a valid number.";
    }
}

fn complex_numbers() {
    print "=== First Complex Number ===";
    let a = _read_number("Enter real part:");
    if a == nil { return nil; }
    let b = _read_number("Enter imaginary part:");
    if b == nil { return nil; }
    let c = complex_new(a, b);
    print "First Complex Number: " + complex_to_string(c);

    print "=== Second Complex Number ===";
    let d = _read_number("Enter real part:");
    if d == nil { return nil; }
    let e = _read_number("Enter imaginary part:");
    if e == nil { return nil; }
    let f = complex_new(d, e);
    print "Second Complex Number: " + complex_to_string(f);

    return complex_calculus_menu(c, f);
}

fn complex_calculus_menu(c, f) {
    while true {
        print "=== Complex Operations Between Two Numbers ===";
        print "First Number:  " + complex_to_string(c);
        print "Second Number: " + complex_to_string(f);
        print "Operations:";
        print " 1. Addition (c + f)";
        print " 2. Subtraction (c - f)";
        print " 3. Multiplication (c * f)";
        print " 4. Division (c / f.norm())";
        print " 5. Exponentiation (c ^ f.re)";
        print " 6. Square Root of c";
        print " 7. Absolute Value of c";
        print " 8. Modulus (c % f.re)";
        print " 9. Conjugate of c";
        print "10. Argument of c";
        print "11. Natural Log of c";
        print "12. Exponential of c";
        print "13. Magnitude^2 of c";
        print "14. Input New Complex Numbers";
        print "15. Go back to Main Menu";
        print "16. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            print "Addition: " + complex_to_string(complex_add(c, f));
        } else {
            if choice == 2 {
                print "Subtraction: " + complex_to_string(complex_sub(c, f));
            } else {
                if choice == 3 {
                    print "Multiplication: " + complex_to_string(complex_mul(c, f));
                } else {
                    if choice == 4 {
                        print "Division: " + complex_to_string(complex_div_scalar(c, complex_norm(f)));
                    } else {
                        if choice == 5 {
                            print "Exponentiation: " + complex_to_string(complex_pow_scalar(c, f.re));
                        } else {
                            if choice == 6 {
                                print "Square Root: " + complex_to_string(complex_sqrt(c));
                            } else {
                                if choice == 7 {
                                    print "Absolute Value: " + str(complex_abs(c));
                                } else {
                                    if choice == 8 {
                                        print "Modulus: " + complex_to_string(complex_modulus_scalar(c, f.re));
                                    } else {
                                        if choice == 9 {
                                            print "Conjugate: " + complex_to_string(complex_conj(c));
                                        } else {
                                            if choice == 10 {
                                                print "Argument: " + str(complex_arg(c));
                                            } else {
                                                if choice == 11 {
                                                    print "Natural Log: " + complex_to_string(complex_ln(c));
                                                } else {
                                                    if choice == 12 {
                                                        print "Exponential: " + complex_to_string(complex_exp(c));
                                                    } else {
                                                        if choice == 13 {
                                                            print "Magnitude^2: " + str(complex_abs2(c));
                                                        } else {
                                                            if choice == 14 {
                                                                return complex_numbers();
                                                            } else {
                                                                if choice == 15 {
                                                                    return main_menu();
                                                                } else {
                                                                    if choice == 16 {
                                                                        return nil;
                                                                    } else {
                                                                        print "Invalid input.";
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------- Logical algebra ----------------

fn conjunction(p, q) { return p and q; }
fn disjunction(p, q) { return p or q; }
fn negation(p) { return p == false; }
fn entailment2(p, q) { return (p == false) or q; }
fn contrapositive(p, q) { return entailment2(q == false, p == false); }

fn read_bool(prompt) {
    while true {
        print prompt;
        let s = read_line();
        if s == nil { return nil; }
        let b = try parse_bool(str_trim(s)) catch nil;
        if b != nil { return b; }
        print "Please enter true or false.";
    }
}

fn truth_table() {
    print "Truth Table:";
    for pi 2 {
        for qi 2 {
            let p = (pi == 0);
            let q = (qi == 0);
            let row = map{
                p: p,
                q: q,
                not_p: negation(p),
                not_q: negation(q),
                p_implies_q: entailment2(p, q),
                contra: contrapositive(p, q),
                p_and_q: conjunction(p, q),
                p_or_q: disjunction(p, q)
            };
            print row;
        }
    }
    return nil;
}

fn logic_algebra() {
    while true {
        print "Logic Algebra Operations:";
        print "1. Entailment (p -> q)";
        print "2. Conjunction (p and q)";
        print "3. Disjunction (p or q)";
        print "4. Negation (not p)";
        print "5. Contrapositive (not q -> not p)";
        print "6. Truth Table";
        print "7. Multiple Calculations";
        print "8. Go back to Main Menu";
        print "9. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            let p = read_bool("Enter p (true/false):");
            if p == nil { return nil; }
            let q = read_bool("Enter q (true/false):");
            if q == nil { return nil; }
            print "p -> q = " + str(entailment2(p, q));
        } else {
            if choice == 2 {
                let p = read_bool("Enter p (true/false):");
                if p == nil { return nil; }
                let q = read_bool("Enter q (true/false):");
                if q == nil { return nil; }
                print "p and q = " + str(conjunction(p, q));
            } else {
                if choice == 3 {
                    let p = read_bool("Enter p (true/false):");
                    if p == nil { return nil; }
                    let q = read_bool("Enter q (true/false):");
                    if q == nil { return nil; }
                    print "p or q = " + str(disjunction(p, q));
                } else {
                    if choice == 4 {
                        let p = read_bool("Enter p (true/false):");
                        if p == nil { return nil; }
                        print "not p = " + str(negation(p));
                    } else {
                        if choice == 5 {
                            let p = read_bool("Enter p (true/false):");
                            if p == nil { return nil; }
                            let q = read_bool("Enter q (true/false):");
                            if q == nil { return nil; }
                            print "not q -> not p = " + str(contrapositive(p, q));
                        } else {
                            if choice == 6 {
                                truth_table();
                            } else {
                                if choice == 7 {
                                    multiple_calculations_la();
                                } else {
                                    if choice == 8 {
                                        return nil;
                                    } else {
                                        if choice == 9 {
                                            return nil;
                                        } else {
                                            print "Invalid choice.";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn _split_ws(s) {
    let parts = str_split(s, " ");
    let out = [];
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" {
            out[len(out)] = p;
        }
    }
    return out;
}

fn multiple_calculations_la() {
    while true {
        print "Enter ops (e.g. \"1 2\") or q to quit:";
        let line = read_line();
        if line == nil { return nil; }
        let input = str_trim(line);
        if input == "q" or input == "Q" { return nil; }

        let choices = _split_ws(input);

        // always need p; need q for ops other than "4"
        let need_q = false;
        for i len(choices) {
            if choices[i] != "4" { need_q = true; }
        }

        let p = read_bool("Enter p (true/false):");
        if p == nil { return nil; }
        let q = false;
        if need_q {
            q = read_bool("Enter q (true/false):");
            if q == nil { return nil; }
        }

        let results = [];
        for i len(choices) {
            let c = choices[i];
            let r = nil;
            if c == "1" {
                r = entailment2(p, q);
            } else {
                if c == "2" {
                    r = conjunction(p, q);
                } else {
                    if c == "3" {
                        r = disjunction(p, q);
                    } else {
                        if c == "4" {
                            r = negation(p);
                        } else {
                            if c == "5" {
                                r = contrapositive(p, q);
                            } else {
                                print "Invalid: " + c;
                            }
                        }
                    }
                }
            }
            if r != nil {
                print "Result " + c + " = " + str(r);
                results[len(results)] = r;
            }
        }

        if len(results) > 0 {
            let all_true = true;
            for i len(results) {
                if results[i] == false { all_true = false; }
            }
            print "All true? " + str(all_true);
        }
    }
}

// ---------------- Algorithms ----------------

fn gcd(a, b) {
    while b != 0 {
        let t = b;
        b = num_mod(a, b);
        a = t;
    }
    return a;
}

fn sieve_of_eratosthenes(n) {
    let size = n + 1;
    let primes = [];
    for i size { primes[len(primes)] = true; }
    if size > 0 { primes[0] = false; }
    if size > 1 { primes[1] = false; }

    let p = 2;
    while p * p <= n {
        if primes[p] {
            let i = p * p;
            while i <= n {
                primes[i] = false;
                i = i + p;
            }
        }
        p = p + 1;
    }

    let out = [];
    let x = 2;
    while x <= n {
        if primes[x] {
            out[len(out)] = x;
        }
        x = x + 1;
    }
    return out;
}

fn sequential_search(arr, target) {
    for i len(arr) {
        if arr[i] == target { return i; }
    }
    return nil;
}

fn _parse_int_list(s) {
    let parts = str_split(s, ",");
    let out = [];
    for i len(parts) {
        let v = try parse_number(str_trim(parts[i])) catch nil;
        if v != nil {
            out[len(out)] = v;
        }
    }
    return out;
}

fn algorithms_menu() {
    while true {
        print "Algorithms Menu:";
        print "1. GCD (Euclid's)";
        print "2. Sieve (Eratosthenes)";
        print "3. Sequential Search (Linear Search)";
        print "4. Back";
        print "5. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            let a = _read_number("First number:");
            if a == nil { return nil; }
            let b = _read_number("Second number:");
            if b == nil { return nil; }
            print "GCD = " + str(gcd(a, b));
        } else {
            if choice == 2 {
                let n = _read_number("Enter n:");
                if n == nil { return nil; }
                print sieve_of_eratosthenes(n);
            } else {
                if choice == 3 {
                    print "Enter array (comma-separated):";
                    let arr_line = read_line();
                    if arr_line == nil { return nil; }
                    let arr = _parse_int_list(str_trim(arr_line));
                    print "Enter target:";
                    let target_line = read_line();
                    if target_line == nil { return nil; }
                    let target = try parse_number(str_trim(target_line)) catch nil;
                    if target == nil {
                        print "Invalid target";
                    } else {
                        let idx = sequential_search(arr, target);
                        if idx == nil {
                            print "Target not found in array";
                        } else {
                            print "Target found at index " + str(idx);
                        }
                    }
                } else {
                    if choice == 4 {
                        return nil;
                    } else {
                        if choice == 5 {
                            return nil;
                        } else {
                            print "Invalid choice.";
                        }
                    }
                }
            }
        }
    }
}

// ---------------- Main menu ----------------

fn main_menu() {
    while true {
        print "=== Mathematical Program ===";
        print "1. Logic Algebra";
        print "2. Algorithms";
        print "3. Complex Calculus";
        print "4. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            logic_algebra();
        } else {
            if choice == 2 {
                algorithms_menu();
            } else {
                if choice == 3 {
                    complex_numbers();
                } else {
                    if choice == 4 {
                        return nil;
                    } else {
                        print "Invalid input.";
                    }
                }
            }
        }
    }
}

fn run() { return main_menu(); }

let complex = map{
    new: complex_new,
    add: complex_add,
    sub: complex_sub,
    mul: complex_mul,
    conj: complex_conj,
    norm: complex_norm,
    div_scalar: complex_div_scalar,
    arg: complex_arg,
    exp: complex_exp,
    ln: complex_ln,
    pow_scalar: complex_pow_scalar,
    sqrt: complex_sqrt,
    abs: complex_abs,
    abs2: complex_abs2,
    modulus_scalar: complex_modulus_scalar,
    to_string: complex_to_string,
    interactive: complex_numbers
};

let logic = map{
    entailment: entailment2,
    conjunction: conjunction,
    disjunction: disjunction,
    negation: negation,
    contrapositive: contrapositive,
    truth_table: truth_table,
    interactive: logic_algebra
};

let algorithms = map{
    gcd: gcd,
    sieve: sieve_of_eratosthenes,
    sequential_search: sequential_search,
    interactive: algorithms_menu
};

// ---------------- Linear algebra (arrays + arrays-of-arrays) ----------------

fn _la_assert_same_len(a, b) {
    if len(a) != len(b) { return nil; }
    return true;
}

fn la_vec_add(a, b) {
    _la_assert_same_len(a, b);
    let out = [];
    for i len(a) { out[len(out)] = a[i] + b[i]; }
    return out;
}

fn la_vec_sub(a, b) {
    _la_assert_same_len(a, b);
    let out = [];
    for i len(a) { out[len(out)] = a[i] - b[i]; }
    return out;
}

fn la_vec_dot(a, b) {
    _la_assert_same_len(a, b);
    let s = 0;
    for i len(a) { s = s + a[i] * b[i]; }
    return s;
}

fn la_vec_scale(a, k) {
    let out = [];
    for i len(a) { out[len(out)] = a[i] * k; }
    return out;
}

fn la_mat_identity(n) {
    let m = [];
    for i n {
        let row = [];
        for j n {
            if i == j { row[len(row)] = 1; } else { row[len(row)] = 0; }
        }
        m[len(m)] = row;
    }
    return m;
}

fn la_mat_transpose(A) {
    if len(A) == 0 { return []; }
    let rows = len(A);
    let cols = len(A[0]);
    let out = [];
    for j cols {
        let row = [];
        for i rows {
            row[len(row)] = A[i][j];
        }
        out[len(out)] = row;
    }
    return out;
}

fn la_mat_mul(A, B) {
    if len(A) == 0 { return []; }
    if len(B) == 0 { return []; }
    let m = len(A);
    let n = len(A[0]);
    let p = len(B[0]);
    let out = [];
    for i m {
        let row = [];
        for j p {
            let s = 0;
            for k n { s = s + A[i][k] * B[k][j]; }
            row[len(row)] = s;
        }
        out[len(out)] = row;
    }
    return out;
}

fn la_mat_vec_mul(A, x) {
    let out = [];
    for i len(A) {
        out[len(out)] = la_vec_dot(A[i], x);
    }
    return out;
}

fn la_det2(A) {
    // [[a,b],[c,d]] -> ad - bc
    return A[0][0] * A[1][1] - A[0][1] * A[1][0];
}

fn la_solve2(A, b) {
    // Solve 2x2: A x = b
    let det = la_det2(A);
    if det == 0 { return nil; }
    let x0 = (b[0] * A[1][1] - A[0][1] * b[1]) / det;
    let x1 = (A[0][0] * b[1] - b[0] * A[1][0]) / det;
    return [x0, x1];
}

let la = map{
    vec_add: la_vec_add,
    vec_sub: la_vec_sub,
    vec_dot: la_vec_dot,
    vec_scale: la_vec_scale,
    mat_identity: la_mat_identity,
    mat_transpose: la_mat_transpose,
    mat_mul: la_mat_mul,
    mat_vec_mul: la_mat_vec_mul,
    det2: la_det2,
    solve2: la_solve2
};

// ---- Utility scalar helpers (G3-beta) ----

fn util_clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn util_lerp(a, b, t) {
    return a + (b - a) * t;
}

fn util_smoothstep(edge0, edge1, x) {
    let t = util_clamp((x - edge0) / (edge1 - edge0), 0, 1);
    return t * t * (3 - 2 * t);
}

let util = map{
    clamp: util_clamp,
    lerp: util_lerp,
    smoothstep: util_smoothstep
};


// --- Numeric helpers ---
let abs = num_abs;
let max = num_max;
let min = num_min;

export complex, logic, algorithms, la, main_menu, run, util, abs, max, min;
