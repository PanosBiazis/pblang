// Math stdlib module (interactive + library APIs).
//
// Import:
//   let math = import("stdlib:math.sapp");
//   let c = math.complex.new(1, 2);
//   print math.complex.to_string(c);
//   print math.PI;
//   print math.sin(1.57);
//   print math.stats.mean([1,2,3,4,5]);

// ── Mathematical constants ────────────────────────────────────────────────────

let PI = 3.141592653589793;
let E = 2.718281828459045;
let TAU = 6.283185307179586;
let PHI = 1.618033988749895;  // golden ratio
let SQRT2 = 1.4142135623730951;
let LN2 = 0.6931471805599453;
let LN10 = 2.302585092994046;

let _MATH_NATIVE_VEC_THRESHOLD = 512;
let _MATH_NATIVE_DOT_THRESHOLD = 256;
let _MATH_NATIVE_MATMUL_THRESHOLD = 2048;

// ── Trigonometry (radians) ────────────────────────────────────────────────────

fn sin(x) {
    // Taylor series approximation for sin(x)
    // sin(x) = x - x^3/3! + x^5/5! - x^7/7! + ...
    let x = num_mod(x, 2 * PI);  // Reduce to [-2π, 2π]
    let result = x;
    let term = x;
    let n = 1;
    // Use 10 terms for good precision
    for i in 1 to 10 {
        n = n + 1;
        term = term * (0 - x * x) / ((2 * i) * (2 * i + 1));
        result = result + term;
    }
    return result;
}

fn cos(x) {
    return sin(PI / 2 - x);
}

fn tan(x) {
    return sin(x) / cos(x);
}

fn asin(x) {
    // Simple approximation for |x| <= 1
    if x < -1 or x > 1 { return 0 / 0; } // NaN
    return x + x * x * x / 6 + 3 * x * x * x * x * x / 40;
}

fn acos(x) {
    return PI / 2 - asin(x);
}

fn atan(x) {
    return num_atan2(x, 1);
}

fn atan2(y, x) {
    return num_atan2(y, x);
}

// ── Hyperbolic functions ──────────────────────────────────────────────────────

fn sinh(x) {
    return (num_exp(x) - num_exp(0 - x)) / 2;
}

fn cosh(x) {
    return (num_exp(x) + num_exp(0 - x)) / 2;
}

fn tanh(x) {
    return sinh(x) / cosh(x);
}

// ── Degree/radian conversion ──────────────────────────────────────────────────

fn deg_to_rad(d) {
    return d * PI / 180;
}

fn rad_to_deg(r) {
    return r * 180 / PI;
}

// ── Logarithmic functions ─────────────────────────────────────────────────────

fn log2(x) {
    return num_ln(x) / LN2;
}

fn log10(x) {
    return num_ln(x) / LN10;
}

fn log(base, x) {
    return num_ln(x) / num_ln(base);
}

// ── Rounding utilities ────────────────────────────────────────────────────────

fn round(x) {
    return num_floor(x + 0.5);
}

fn trunc(x) {
    if x >= 0 { return num_floor(x); }
    return num_ceil(x);
}

fn fract(x) {
    return x - trunc(x);
}

// ── Number theory ─────────────────────────────────────────────────────────────

fn abs(x) {
    if x < 0 { return 0 - x; }
    return x;
}

fn sign(x) {
    if x > 0 { return 1; }
    if x < 0 { return -1; }
    return 0;
}

fn gcd(a, b) {
    a = abs(a);
    b = abs(b);
    while b != 0 {
        let t = b;
        b = num_mod(a, b);
        a = t;
    }
    return a;
}

fn lcm(a, b) {
    return abs(a * b) / gcd(a, b);
}

fn is_prime(n) {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if num_mod(n, 2) == 0 { return false; }
    let limit = num_sqrt(n);
    for i in 3 to trunc(limit) + 1 {
        if num_mod(n, i) == 0 { return false; }
        i = i + 1; // skip even numbers
    }
    return true;
}

// ── Interpolation / mapping ───────────────────────────────────────────────────

fn lerp(a, b, t) {
    return a + (b - a) * t;
}

fn clamp(x, min_val, max_val) {
    if x < min_val { return min_val; }
    if x > max_val { return max_val; }
    return x;
}

fn normalize(x, min_val, max_val) {
    return (x - min_val) / (max_val - min_val);
}

fn map_range(x, in_min, in_max, out_min, out_max) {
    return out_min + (out_max - out_min) * normalize(x, in_min, in_max);
}

// ── Native tensor bridge helpers ──────────────────────────────────────────────

fn _tensor1(v) {
    return map{ shape: [len(v)], data: v, dtype: "f32" };
}

fn _tensor1_row(v) {
    return map{ shape: [1, len(v)], data: v, dtype: "f32" };
}

fn _shape2(m) {
    if len(m) == 0 { return [0, 0]; }
    return [len(m), len(m[0])];
}

fn _flatten2(m) {
    let out = [];
    for i len(m) {
        for j len(m[i]) {
            push(out, m[i][j]);
        }
    }
    return out;
}

fn _tensor2(m) {
    return map{ shape: _shape2(m), data: _flatten2(m), dtype: "f32" };
}

fn _unflatten2(data, rows, cols) {
    let out = [];
    for i rows {
        let row = [];
        for j cols {
            push(row, data[i * cols + j]);
        }
        push(out, row);
    }
    return out;
}

fn _native_vec_add(a, b) {
    let r = try tensor_add(_tensor1(a), _tensor1(b)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn _native_vec_sub(a, b) {
    let r = try tensor_sub(_tensor1(a), _tensor1(b)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn _native_vec_scale(a, k) {
    let r = try tensor_scale(_tensor1(a), k) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn _native_vec_dot(a, b) {
    return try tensor_dot(_tensor1(a), _tensor1(b)) catch nil;
}

fn _native_mat_mul(A, B) {
    if len(A) == 0 or len(B) == 0 { return []; }
    let r = try tensor_matmul(_tensor2(A), _tensor2(B)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return _unflatten2(r.data, r.shape[0], r.shape[1]);
}

fn _native_vec_mat(v, M) {
    if len(M) == 0 { return []; }
    let r = try tensor_matmul(_tensor1_row(v), _tensor2(M)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

// ── Statistics ────────────────────────────────────────────────────────────────

fn sum(arr) {
    if len(arr) >= _MATH_NATIVE_VEC_THRESHOLD {
        let r = try tensor_sum(_tensor1(arr)) catch nil;
        if r != nil { return r; }
    }
    let s = 0;
    for v in arr { s = s + v; }
    return s;
}

fn mean(arr) {
    if len(arr) == 0 { return 0; }
    return sum(arr) / len(arr);
}

fn median(arr) {
    if len(arr) == 0 { return 0; }
    let sorted = array_sort(arr);
    let mid = len(sorted) / 2;
    if num_mod(len(sorted), 2) == 0 {
        return (sorted[mid - 1] + sorted[mid]) / 2;
    }
    return sorted[trunc(mid)];
}

fn variance(arr) {
    if len(arr) < 2 { return 0; }
    let m = mean(arr);
    let sq_sum = 0;
    for v in arr {
        sq_sum = sq_sum + (v - m) * (v - m);
    }
    return sq_sum / (len(arr) - 1);
}

fn stddev(arr) {
    return num_sqrt(variance(arr));
}

fn min(arr) {
    if len(arr) == 0 { return 0; }
    let fast = try min_of(arr) catch nil;
    if fast != nil { return fast; }
    let m = arr[0];
    for v in arr { if v < m { m = v; } }
    return m;
}

fn max(arr) {
    if len(arr) == 0 { return 0; }
    let fast = try max_of(arr) catch nil;
    if fast != nil { return fast; }
    let m = arr[0];
    for v in arr { if v > m { m = v; } }
    return m;
}

fn range(arr) {
    if len(arr) == 0 { return 0; }
    let lo = try min_of(arr) catch nil;
    let hi = try max_of(arr) catch nil;
    if lo != nil and hi != nil { return hi - lo; }
    let low = arr[0];
    let high = arr[0];
    for v in arr {
        if v < low { low = v; }
        if v > high { high = v; }
    }
    return high - low;
}

// ── Linear algebra ────────────────────────────────────────────────────────────

fn dot(a, b) {
    if len(a) == len(b) and len(a) >= _MATH_NATIVE_DOT_THRESHOLD {
        let fast = _native_vec_dot(a, b);
        if fast != nil { return fast; }
    }
    let result = 0;
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i in 0 to n - 1 {
        result = result + a[i] * b[i];
    }
    return result;
}

fn mat_mul(a, b) {
    // a: m×n, b: n×p → result: m×p
    if len(a) == 0 or len(b) == 0 { return []; }
    let m = len(a);
    let n = len(b);
    let p = len(b[0]);
    if m * n * p >= _MATH_NATIVE_MATMUL_THRESHOLD {
        let fast = _native_mat_mul(a, b);
        if fast != nil { return fast; }
    }
    let result = [];
    for i in 0 to m - 1 {
        let row = [];
        for j in 0 to p - 1 {
            let s = 0;
            for k in 0 to n - 1 {
                s = s + a[i][k] * b[k][j];
            }
            push(row, s);
        }
        push(result, row);
    }
    return result;
}

fn vec_norm(v) {
    return num_sqrt(dot(v, v));
}

fn vec_normalize(v) {
    let n = vec_norm(v);
    if n == 0 { return v; }
    let fast = _native_vec_scale(v, 1 / n);
    if fast != nil { return fast; }
    return la_vec_scale(v, 1 / n);
}

// ───────────────────────────────────────────────────────────────────────────────
// Complex numbers (as map{ re, im })
// ───────────────────────────────────────────────────────────────────────────────

fn complex_new(re, im) {
    return map{ re: re, im: im };
}

fn complex_add(a, b) {
    return complex_new(a.re + b.re, a.im + b.im);
}

fn complex_sub(a, b) {
    return complex_new(a.re - b.re, a.im - b.im);
}

fn complex_mul(a, b) {
    return complex_new(
        a.re * b.re - a.im * b.im,
        a.re * b.im + a.im * b.re
    );
}

fn complex_conj(a) {
    return complex_new(a.re, 0 - a.im);
}

fn complex_abs2(a) {
    return a.re * a.re + a.im * a.im;
}

fn complex_abs(a) {
    return num_sqrt(complex_abs2(a));
}

fn complex_norm(a) {
    return complex_abs(a);
}

fn complex_div_scalar(a, s) {
    return complex_new(a.re / s, a.im / s);
}

fn complex_arg(a) {
    return num_atan2(a.im, a.re);
}

// NOTE: this matches the provided Rust code (component-wise),
// not the mathematical complex exp/ln/pow.
fn complex_exp(a) {
    return complex_new(num_exp(a.re), num_exp(a.im));
}

fn complex_ln(a) {
    return complex_new(num_ln(a.re), num_ln(a.im));
}

fn complex_pow_scalar(a, p) {
    return complex_new(num_pow(a.re, p), num_pow(a.im, p));
}

fn complex_sqrt(a) {
    return complex_new(num_sqrt(a.re), num_sqrt(a.im));
}

fn complex_modulus_scalar(a, m) {
    return complex_new(num_mod(a.re, m), num_mod(a.im, m));
}

fn complex_to_string(a) {
    if a.im < 0 {
        return str(a.re) + " - " + str(0 - a.im) + "i";
    }
    return str(a.re) + " + " + str(a.im) + "i";
}

fn _read_number(prompt) {
    while true {
        print prompt;
        let s = read_line();
        if s == nil { return nil; }
        let n = try parse_number(str_trim(s)) catch nil;
        if n != nil { return n; }
        print "Please enter a valid number.";
    }
}

fn complex_numbers() {
    print "=== First Complex Number ===";
    let a = _read_number("Enter real part:");
    if a == nil { return nil; }
    let b = _read_number("Enter imaginary part:");
    if b == nil { return nil; }
    let c = complex_new(a, b);
    print "First Complex Number: " + complex_to_string(c);

    print "=== Second Complex Number ===";
    let d = _read_number("Enter real part:");
    if d == nil { return nil; }
    let e = _read_number("Enter imaginary part:");
    if e == nil { return nil; }
    let f = complex_new(d, e);
    print "Second Complex Number: " + complex_to_string(f);

    return complex_calculus_menu(c, f);
}

fn complex_calculus_menu(c, f) {
    while true {
        print "=== Complex Operations Between Two Numbers ===";
        print "First Number:  " + complex_to_string(c);
        print "Second Number: " + complex_to_string(f);
        print "Operations:";
        print " 1. Addition (c + f)";
        print " 2. Subtraction (c - f)";
        print " 3. Multiplication (c * f)";
        print " 4. Division (c / f.norm())";
        print " 5. Exponentiation (c ^ f.re)";
        print " 6. Square Root of c";
        print " 7. Absolute Value of c";
        print " 8. Modulus (c % f.re)";
        print " 9. Conjugate of c";
        print "10. Argument of c";
        print "11. Natural Log of c";
        print "12. Exponential of c";
        print "13. Magnitude^2 of c";
        print "14. Input New Complex Numbers";
        print "15. Go back to Main Menu";
        print "16. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            print "Addition: " + complex_to_string(complex_add(c, f));
        } else {
            if choice == 2 {
                print "Subtraction: " + complex_to_string(complex_sub(c, f));
            } else {
                if choice == 3 {
                    print "Multiplication: " + complex_to_string(complex_mul(c, f));
                } else {
                    if choice == 4 {
                        print "Division: " + complex_to_string(complex_div_scalar(c, complex_norm(f)));
                    } else {
                        if choice == 5 {
                            print "Exponentiation: " + complex_to_string(complex_pow_scalar(c, f.re));
                        } else {
                            if choice == 6 {
                                print "Square Root: " + complex_to_string(complex_sqrt(c));
                            } else {
                                if choice == 7 {
                                    print "Absolute Value: " + str(complex_abs(c));
                                } else {
                                    if choice == 8 {
                                        print "Modulus: " + complex_to_string(complex_modulus_scalar(c, f.re));
                                    } else {
                                        if choice == 9 {
                                            print "Conjugate: " + complex_to_string(complex_conj(c));
                                        } else {
                                            if choice == 10 {
                                                print "Argument: " + str(complex_arg(c));
                                            } else {
                                                if choice == 11 {
                                                    print "Natural Log: " + complex_to_string(complex_ln(c));
                                                } else {
                                                    if choice == 12 {
                                                        print "Exponential: " + complex_to_string(complex_exp(c));
                                                    } else {
                                                        if choice == 13 {
                                                            print "Magnitude^2: " + str(complex_abs2(c));
                                                        } else {
                                                            if choice == 14 {
                                                                return complex_numbers();
                                                            } else {
                                                                if choice == 15 {
                                                                    return main_menu();
                                                                } else {
                                                                    if choice == 16 {
                                                                        return nil;
                                                                    } else {
                                                                        print "Invalid input.";
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------- Logical algebra ----------------

fn conjunction(p, q) { return p and q; }
fn disjunction(p, q) { return p or q; }
fn negation(p) { return p == false; }
fn entailment2(p, q) { return (p == false) or q; }
fn contrapositive(p, q) { return entailment2(q == false, p == false); }

fn read_bool(prompt) {
    while true {
        print prompt;
        let s = read_line();
        if s == nil { return nil; }
        let b = try parse_bool(str_trim(s)) catch nil;
        if b != nil { return b; }
        print "Please enter true or false.";
    }
}

fn truth_table() {
    print "Truth Table:";
    for pi 2 {
        for qi 2 {
            let p = (pi == 0);
            let q = (qi == 0);
            let row = map{
                p: p,
                q: q,
                not_p: negation(p),
                not_q: negation(q),
                p_implies_q: entailment2(p, q),
                contra: contrapositive(p, q),
                p_and_q: conjunction(p, q),
                p_or_q: disjunction(p, q)
            };
            print row;
        }
    }
    return nil;
}

fn logic_algebra() {
    while true {
        print "Logic Algebra Operations:";
        print "1. Entailment (p -> q)";
        print "2. Conjunction (p and q)";
        print "3. Disjunction (p or q)";
        print "4. Negation (not p)";
        print "5. Contrapositive (not q -> not p)";
        print "6. Truth Table";
        print "7. Multiple Calculations";
        print "8. Go back to Main Menu";
        print "9. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            let p = read_bool("Enter p (true/false):");
            if p == nil { return nil; }
            let q = read_bool("Enter q (true/false):");
            if q == nil { return nil; }
            print "p -> q = " + str(entailment2(p, q));
        } else {
            if choice == 2 {
                let p = read_bool("Enter p (true/false):");
                if p == nil { return nil; }
                let q = read_bool("Enter q (true/false):");
                if q == nil { return nil; }
                print "p and q = " + str(conjunction(p, q));
            } else {
                if choice == 3 {
                    let p = read_bool("Enter p (true/false):");
                    if p == nil { return nil; }
                    let q = read_bool("Enter q (true/false):");
                    if q == nil { return nil; }
                    print "p or q = " + str(disjunction(p, q));
                } else {
                    if choice == 4 {
                        let p = read_bool("Enter p (true/false):");
                        if p == nil { return nil; }
                        print "not p = " + str(negation(p));
                    } else {
                        if choice == 5 {
                            let p = read_bool("Enter p (true/false):");
                            if p == nil { return nil; }
                            let q = read_bool("Enter q (true/false):");
                            if q == nil { return nil; }
                            print "not q -> not p = " + str(contrapositive(p, q));
                        } else {
                            if choice == 6 {
                                truth_table();
                            } else {
                                if choice == 7 {
                                    multiple_calculations_la();
                                } else {
                                    if choice == 8 {
                                        return nil;
                                    } else {
                                        if choice == 9 {
                                            return nil;
                                        } else {
                                            print "Invalid choice.";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn _split_ws(s) {
    let parts = str_split(s, " ");
    let out = [];
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" {
            out[len(out)] = p;
        }
    }
    return out;
}

fn multiple_calculations_la() {
    while true {
        print "Enter ops (e.g. \"1 2\") or q to quit:";
        let line = read_line();
        if line == nil { return nil; }
        let input = str_trim(line);
        if input == "q" or input == "Q" { return nil; }

        let choices = _split_ws(input);

        // always need p; need q for ops other than "4"
        let need_q = false;
        for i len(choices) {
            if choices[i] != "4" { need_q = true; }
        }

        let p = read_bool("Enter p (true/false):");
        if p == nil { return nil; }
        let q = false;
        if need_q {
            q = read_bool("Enter q (true/false):");
            if q == nil { return nil; }
        }

        let results = [];
        for i len(choices) {
            let c = choices[i];
            let r = nil;
            if c == "1" {
                r = entailment2(p, q);
            } else {
                if c == "2" {
                    r = conjunction(p, q);
                } else {
                    if c == "3" {
                        r = disjunction(p, q);
                    } else {
                        if c == "4" {
                            r = negation(p);
                        } else {
                            if c == "5" {
                                r = contrapositive(p, q);
                            } else {
                                print "Invalid: " + c;
                            }
                        }
                    }
                }
            }
            if r != nil {
                print "Result " + c + " = " + str(r);
                results[len(results)] = r;
            }
        }

        if len(results) > 0 {
            let all_true = true;
            for i len(results) {
                if results[i] == false { all_true = false; }
            }
            print "All true? " + str(all_true);
        }
    }
}

// ---------------- Algorithms ----------------

fn sieve_of_eratosthenes(n) {
    let size = n + 1;
    let primes = [];
    for i size { primes[len(primes)] = true; }
    if size > 0 { primes[0] = false; }
    if size > 1 { primes[1] = false; }

    let p = 2;
    while p * p <= n {
        if primes[p] {
            let i = p * p;
            while i <= n {
                primes[i] = false;
                i = i + p;
            }
        }
        p = p + 1;
    }

    let out = [];
    let x = 2;
    while x <= n {
        if primes[x] {
            out[len(out)] = x;
        }
        x = x + 1;
    }
    return out;
}

fn sequential_search(arr, target) {
    for i len(arr) {
        if arr[i] == target { return i; }
    }
    return nil;
}

fn _parse_int_list(s) {
    let parts = str_split(s, ",");
    let out = [];
    for i len(parts) {
        let v = try parse_number(str_trim(parts[i])) catch nil;
        if v != nil {
            out[len(out)] = v;
        }
    }
    return out;
}

fn algorithms_menu() {
    while true {
        print "Algorithms Menu:";
        print "1. GCD (Euclid's)";
        print "2. Sieve (Eratosthenes)";
        print "3. Sequential Search (Linear Search)";
        print "4. Back";
        print "5. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            let a = _read_number("First number:");
            if a == nil { return nil; }
            let b = _read_number("Second number:");
            if b == nil { return nil; }
            print "GCD = " + str(gcd(a, b));
        } else {
            if choice == 2 {
                let n = _read_number("Enter n:");
                if n == nil { return nil; }
                print sieve_of_eratosthenes(n);
            } else {
                if choice == 3 {
                    print "Enter array (comma-separated):";
                    let arr_line = read_line();
                    if arr_line == nil { return nil; }
                    let arr = _parse_int_list(str_trim(arr_line));
                    print "Enter target:";
                    let target_line = read_line();
                    if target_line == nil { return nil; }
                    let target = try parse_number(str_trim(target_line)) catch nil;
                    if target == nil {
                        print "Invalid target";
                    } else {
                        let idx = sequential_search(arr, target);
                        if idx == nil {
                            print "Target not found in array";
                        } else {
                            print "Target found at index " + str(idx);
                        }
                    }
                } else {
                    if choice == 4 {
                        return nil;
                    } else {
                        if choice == 5 {
                            return nil;
                        } else {
                            print "Invalid choice.";
                        }
                    }
                }
            }
        }
    }
}

// ---------------- Main menu ----------------

fn main_menu() {
    while true {
        print "=== Mathematical Program ===";
        print "1. Logic Algebra";
        print "2. Algorithms";
        print "3. Complex Calculus";
        print "4. Exit";

        let choice = _read_number("Enter your choice:");
        if choice == nil { return nil; }

        if choice == 1 {
            logic_algebra();
        } else {
            if choice == 2 {
                algorithms_menu();
            } else {
                if choice == 3 {
                    complex_numbers();
                } else {
                    if choice == 4 {
                        return nil;
                    } else {
                        print "Invalid input.";
                    }
                }
            }
        }
    }
}

fn run() { return main_menu(); }

