// Atomic text-field edits shared by plan editors. No partial metadata changes.
let Plan=import("stdlib:task_plan.sapp");
fn _index(doc,id) {for i in range(0,len(doc.tasks)) {if doc.tasks[i].id==id {return i;}}throw "unknown task id";}
fn read(doc,id) {
 Plan.validate(doc);let task=doc.tasks[_index(doc,id)];
 return map{title:doc.title,start:doc.start,label:task.label,days:str(task.days),needs:str_join(task.needs,",")};
}
fn pending(doc,id,fields) {return fields!=read(doc,id);}
fn apply(doc,id,fields) {
 if type(fields)!="map" or len(fields)!=5 {throw "invalid plan fields";}
 for key in ["title","start","label","days","needs"] {if not map_has(fields,key) or type(fields[key])!="string" {throw "invalid plan field type";}}
 if len(fields.days)<1 or len(fields.days)>3 or len(fields.needs)>783 or len(str_to_bytes(fields.needs))>783 {throw "plan field limit";}
 for i in range(0,len(fields.days)) {if not str_contains("0123456789",str_slice(fields.days,i,i+1)) {throw "invalid duration";}}
 let needs=[];let raw=str_trim(fields.needs);
 if raw!="" {for parent in str_split(raw,",") {array_push(needs,str_trim(parent));}}
 if len(needs)>16 {throw "too many prerequisites";}
 let out=Plan.copy(doc);let index=_index(out,id);
 out.title=fields.title;out.start=fields.start;out.tasks[index].label=fields.label;
 out.tasks[index].days=parse_number(fields.days);out.tasks[index].needs=needs;
 Plan.validate(out);return out;
}
export read,pending,apply;
