// Strict, bounded literal CSV interchange. No header inference, typing or I/O.
let Sheet=import("stdlib:sheet_document.sapp");
let MAX_INPUT_BYTES=65536;

fn _append(state,byte) {
    if len(state.field)>=Sheet.MAX_CELL_BYTES or state.total>=Sheet.MAX_TOTAL_BYTES {
        throw "CSV sheet text limit exceeded";
    }
    array_push(state.field,byte); state.total=state.total+1;
}
fn _cell(state) {
    if len(state.row)>=Sheet.MAX_COLUMNS { throw "CSV sheet column limit exceeded"; }
    array_push(state.row,bytes_to_str(state.field)); state.field=[];
}
fn _row(state) {
    if len(state.rows)>=Sheet.MAX_ROWS { throw "CSV sheet row limit exceeded"; }
    if len(state.rows)>0 and len(state.row)!=len(state.rows[0]) {
        throw "CSV sheet rows must be rectangular";
    }
    array_push(state.rows,state.row); state.row=[];
}
fn decode(text,delimiter=",") {
    if type(delimiter)!="string" or (delimiter!="," and delimiter!=";" and delimiter!="\t") {
        throw "unsupported sheet delimiter";
    }
    let separator=44;
    if delimiter==";" { separator=59; }
    if delimiter=="\t" { separator=9; }
    if type(text)!="string" or len(text)==0 or len(text)>MAX_INPUT_BYTES
        or str_contains(text,"\u0000") { throw "invalid CSV sheet input"; }
    let bytes=str_to_bytes(text);
    if len(bytes)>MAX_INPUT_BYTES { throw "CSV sheet input limit exceeded"; }
    let i=0;
    // Consume only one transport BOM at absolute offset zero. Later BOMs are data.
    if len(bytes)>=3 and bytes[0]==239 and bytes[1]==187 and bytes[2]==191 { i=3; }
    if i==len(bytes) { throw "CSV sheet has no records"; }
    let state=map{rows:[],row:[],field:[],total:0};
    let mode="bare"; let pending=false;
    while i<len(bytes) {
        let byte=bytes[i];
        if mode=="quoted" {
            if byte==34 {
                if i+1<len(bytes) and bytes[i+1]==34 { _append(state,34); i=i+2; }
                else { mode="closed"; i=i+1; }
            } else { _append(state,byte); i=i+1; }
            continue;
        }
        if byte==separator {
            _cell(state); mode="bare"; pending=true; i=i+1; continue;
        }
        if byte==10 or byte==13 {
            if byte==13 {
                if i+1>=len(bytes) or bytes[i+1]!=10 { throw "invalid CSV sheet record ending"; }
                i=i+1;
            }
            _cell(state); _row(state); mode="bare"; pending=false; i=i+1; continue;
        }
        if mode=="closed" { throw "unexpected text after CSV closing quote"; }
        if byte==34 {
            if len(state.field)!=0 { throw "unexpected quote in CSV field"; }
            mode="quoted";
        } else { _append(state,byte); }
        pending=true; i=i+1;
    }
    if mode=="quoted" { throw "unclosed CSV field"; }
    if pending { _cell(state); _row(state); }
    return Sheet.copy(map{format:Sheet.FORMAT,cells:state.rows});
}

fn encode(doc,delimiter=",") {
    Sheet.validate(doc);
    if type(delimiter)!="string" or (delimiter!="," and delimiter!=";" and delimiter!="\t") { throw "unsupported sheet delimiter"; }
    let lines=[];
    for row in doc.cells {
        let fields=[];
        for cell in row { array_push(fields,"\""+str_join(str_split(cell,"\""),"\"\"")+"\""); }
        array_push(lines,str_join(fields,delimiter));
    }
    let text=str_join(lines,"\r\n")+"\r\n";
    if len(str_to_bytes(text))>MAX_INPUT_BYTES { throw "CSV output limit exceeded"; }
    return text;
}
export MAX_INPUT_BYTES,decode,encode;
