// stdlib/text_normalize.sapp — model-response output normalizer.
//
// Harvested from the G0DM0D3 "Semantic Transformation Modules (STM)": a sequential
// pipeline that strips PREAMBLES ("Sure! ...", "Certainly, ..."), HEDGING ("I think",
// "perhaps"), and FORMALITY fillers ("please note that", "I hope this helps") from a
// model reply, leaving the substance. Pure + deterministic. Used to tidy pbAI answer
// synthesis before it reaches the user.
//
//   let N = import("stdlib/text_normalize.sapp");
//   N.normalize("Sure! I think it is 42. I hope this helps!");  // -> "it is 42."
//   N.normalize_opts(text, map{ formality: false });            // per-stage toggles
//
// The phrase banks are curated multiword markers; removal is longest-phrase-first so
// specific markers win over their own substrings ("as an ai language model" before
// "as an ai"). It normalizes surface filler, not meaning — content is left verbatim.

// leading-only fillers (a bare "sure" mid-sentence is meaningful, so only strip at the front)
fn _preambles() {
    return ["i'd be happy to help", "i would be happy to help", "here you go", "great question",
        "happy to help", "no problem", "of course", "absolutely", "certainly", "sure"];
}
// tentative qualifiers stripped from the start of the text
fn _hedges() {
    return ["as far as i know", "in my opinion", "it seems that", "i would say", "i believe",
        "i think", "it seems", "arguably", "perhaps", "maybe"];
}
// filler phrases removed anywhere (incl. a trailing "I hope this helps!" sentence)
fn _formality() {
    return ["as an ai language model", "as an ai assistant", "it is worth noting that",
        "it's worth noting that", "please note that", "i hope this helps", "i hope that helps",
        "hope this helps", "as an ai"];
}

fn _is_punct(c) { return c == "." or c == "!" or c == "," or c == ";" or c == ":" or c == "?"; }

// strip a leading run of spaces + sentence punctuation
fn _lstrip_punct(s) {
    let out = s;
    while len(out) > 0 {
        let c = str_slice(out, 0, 1);
        if c == " " or _is_punct(c) or c == "-" { out = str_slice(out, 1, len(out)); }
        else { return out; }
    }
    return out;
}

// does `phrase` sit on a word boundary at the front of `low` (next char absent or non-letter)?
fn _boundary_after(low, phrase) {
    let pos = len(phrase);
    if pos >= len(low) { return true; }
    let c = str_slice(low, pos, pos + 1);
    if c == " " or _is_punct(c) or c == "-" { return true; }
    return false;
}

// remove leading phrases from a bank, looping so stacked markers all go.
fn _strip_leading(text, bank) {
    let t = str_trim(text);
    let changed = true;
    while changed {
        changed = false;
        let low = str_lower(t);
        for i len(bank) {
            let p = bank[i];
            if str_starts_with(low, p) {
                if _boundary_after(low, p) {
                    t = _lstrip_punct(str_slice(t, len(p), len(t)));
                    changed = true;
                }
            }
        }
    }
    return t;
}

// remove one occurrence of `phrase` (already lowercase) anywhere, eating trailing
// punctuation and one preceding space so no dangling "  ." is left.
fn _remove_span_once(text, phrase) {
    let idx = str_index_of(str_lower(text), phrase);
    if idx < 0 { return text; }
    let start = idx;
    let end = idx + len(phrase);
    let go = true;
    while go and end < len(text) {
        let c = str_slice(text, end, end + 1);
        if _is_punct(c) { end = end + 1; } else { go = false; }
    }
    if start > 0 {
        let pc = str_slice(text, start - 1, start);
        if pc == " " { start = start - 1; }
    }
    return str_slice(text, 0, start) + str_slice(text, end, len(text));
}

// collapse double spaces, drop space-before-punctuation, trim.
fn _tidy(s) {
    let out = str_trim(s);
    while str_index_of(out, "  ") >= 0 { out = str_replace_all(out, "  ", " "); }
    out = str_replace_all(out, " .", ".");
    out = str_replace_all(out, " ,", ",");
    out = str_replace_all(out, " !", "!");
    out = str_replace_all(out, " ?", "?");
    out = str_replace_all(out, " ;", ";");
    return str_trim(out);
}

// ── public stage functions ─────────────────────────────────────────────────────────
fn strip_preamble(text) { return _strip_leading(text, _preambles()); }
fn strip_hedging(text)  { return _strip_leading(text, _hedges()); }

fn strip_formality(text) {
    let t = text;
    let bank = _formality();
    for i len(bank) {
        let p = bank[i];
        while str_index_of(str_lower(t), p) >= 0 { t = _remove_span_once(t, p); }
    }
    return _tidy(t);
}

// ── pipeline ────────────────────────────────────────────────────────────────────────
fn _opt(o, k) { if o == nil { return true; } if map_has(o, k) { return o[k]; } return true; }

// normalize_opts(text, opts) — opts.preamble/hedging/formality (default true) toggle stages.
fn normalize_opts(text, opts) {
    let t = text;
    if _opt(opts, "preamble") == true { t = strip_preamble(t); }
    if _opt(opts, "hedging") == true  { t = strip_hedging(t); }
    if _opt(opts, "formality") == true { t = strip_formality(t); }
    return _tidy(t);
}

// normalize(text) — the full pipeline.
fn normalize(text) { return normalize_opts(text, nil); }

export strip_preamble, strip_hedging, strip_formality, normalize, normalize_opts;
