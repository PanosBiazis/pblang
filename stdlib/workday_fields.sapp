// Human-facing one-based weekdays; shared calendar remains Monday=0.
let Date=import("stdlib:civil_date.sapp");let Work=import("stdlib:work_calendar.sapp");
fn parse(week_text,closed_text=""){
 if type(week_text)!="string" or len(str_to_bytes(week_text))>64 or type(closed_text)!="string" or len(str_to_bytes(closed_text))>4096{throw "invalid calendar fields";}
 let tokens=str_split(week_text,",");if len(tokens)>7{throw "too many weekdays";}let week=[];
 for token in tokens{let value=str_trim(token);if len(value)!=1 or not str_contains("1234567",value){throw "weekdays must be 1..7";}array_push(week,parse_number(value)-1);}
 let closed=[];if str_trim(closed_text)!=""{let items=str_split(str_replace_all(closed_text,"\n",","),",");if len(items)>366{throw "too many closed dates";}for item in items{let date=str_trim(item);Date.ordinal(date);array_push(closed,date);}}
 Work.is_workday("2000-01-01",week,closed);return map{weekdays:week,closed:closed};
}
export parse;
