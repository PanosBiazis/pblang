//! Efficient incremental string construction.
//!
//! Appending directly to a string copies its existing contents on every write.
//! This builder stores chunks in O(1) amortized time and joins them once.

fn new(max_chars = nil) {
    if max_chars != nil and max_chars < 0 { throw "string_builder.new: max_chars must be >= 0"; }
    return map{ chunks: [], length: 0, max_chars: max_chars };
}

fn _check_capacity(builder, added) {
    if builder.max_chars != nil and builder.length + added > builder.max_chars {
        throw "string_builder: output exceeds max_chars=" + str(builder.max_chars);
    }
}

fn write(builder, value) {
    let chunk = str(value);
    if chunk == "" { return builder; }
    _check_capacity(builder, len(chunk));
    array_push(builder.chunks, chunk);
    builder.length = builder.length + len(chunk);
    return builder;
}

fn write_line(builder, value = "") {
    write(builder, value);
    return write(builder, "\n");
}

fn write_all(builder, values) {
    return write_join(builder, values, "");
}

fn write_join(builder, values, separator = "") {
    let parts = [];
    let i = 0;
    while i < len(values) {
        array_push(parts, str(values[i]));
        i = i + 1;
    }
    return write(builder, str_join(parts, str(separator)));
}

fn length(builder) { return builder.length; }
fn chunk_count(builder) { return len(builder.chunks); }
fn is_empty(builder) { return builder.length == 0; }

fn finish(builder) { return str_join(builder.chunks, ""); }

fn clear(builder) {
    builder.chunks = [];
    builder.length = 0;
    return builder;
}

fn take(builder) {
    let result = finish(builder);
    clear(builder);
    return result;
}

export new, write, write_line, write_all, write_join,
       length, chunk_count, is_empty, finish, clear, take;
