// stdlib/tls.sapp — TLS/HTTPS support (W4-gamma Stage A + Stage B ready).
//
// Uses the tcp_listen_tls / tcp_connect_tls VM builtins when available.
// Falls back to stub error map when the runtime was built without rustls.
//
// See docs/TLS_notes.md for implementation details.
//
// Usage (server):
//   let tls = import("stdlib:tls.sapp");
//   let l = tls.listen_tls("0.0.0.0:443", "/certs/server.crt", "/certs/server.key");
//   if map_has(l, "error") { print "TLS unavailable: " + l.error; }
//   else {
//     let s = tcp_accept(l);
//     // ... use tcp_read / tcp_write as normal
//   }
//
// Usage (client HTTPS):
//   let tls = import("stdlib:tls.sapp");
//   let conn = tls.connect_tls("example.com", 443);
//   if conn.error == nil { tcp_write(conn.handle, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"); }

let HTTPClient = import("stdlib:http_client.sapp");
let HTTPServer = import("stdlib:http_server.sapp");

// listen_tls(addr, cert_path, key_path) — create a TLS listener
// Returns a handle on success, or map{error:...} on failure
fn _provider_ready() {
    let selected = try env_get("PBLANG_TLS_PROVIDER_READY") catch "";
    return selected == "ring" or selected == "aws-lc-rs";
}

fn _provider_error() {
    return "TLS is default-disabled because this runtime has conflicting Rustls crypto providers; " +
           "an embedding host must install exactly one provider and set PBLANG_TLS_PROVIDER_READY";
}

fn listen_tls(addr, cert_path, key_path) {
    if not _provider_ready() { return map{ error: _provider_error() }; }
    let result = try tcp_listen_tls(addr, cert_path, key_path) catch nil;
    if result == nil {
        return map{ error: "tcp_listen_tls not available in this build. Use tcp_listen for plain TCP or install with TLS support." };
    }
    return result;
}

// connect_tls(host, port) — connect to a TLS server. Always returns a normalized
// { handle, error } map: handle is the TCP handle on success (error nil); on
// failure handle is nil and error is set. (Previously it returned the raw builtin
// result, so the documented conn.handle / conn.error usage didn't work.)
fn connect_tls(host, port) {
    if not _provider_ready() { return map{ handle: nil, error: _provider_error() }; }
    let result = try tcp_connect_tls(host, port) catch "__threw__";
    if result == "__threw__" {
        return map{ handle: nil, error: "tcp_connect_tls failed (host/port unreachable, or TLS handshake error)" };
    }
    if type(result) == "map" {
        // Builtin already returned a shaped map — fill in any missing slot.
        if map_has(result, "handle") or map_has(result, "error") {
            if not map_has(result, "handle") { result.handle = nil; }
            if not map_has(result, "error") { result.error = nil; }
            return result;
        }
        return map{ handle: result, error: nil };
    }
    return map{ handle: result, error: nil };   // raw TCP handle
}

// serve_once_tls(addr, cert_path, key_path, handler) — accept one TLS connection
fn serve_once_tls(addr, cert_path, key_path, handler) {
    let l = listen_tls(addr, cert_path, key_path);
    if map_has(l, "error") { return l; }
    let s = tcp_accept(l);
    let raw = tcp_read_until(s, "\r\n\r\n", 65536);
    let req = http_parse_request(raw);
    let resp = handler(req);
    tcp_write(s, resp);
    tcp_close(s);
    tcp_close(l);
    return map{ ok: true };
}

// serve_forever_tls(addr, cert_path, key_path, handler) — accept TLS connections in a loop
// handler(req) should return the HTTP response string
fn serve_forever_tls(addr, cert_path, key_path, handler) {
    let l = listen_tls(addr, cert_path, key_path);
    if map_has(l, "error") { return l; }
    while true {
        let s = tcp_accept(l);
        let raw = tcp_read_until(s, "\r\n\r\n", 65536);
        let req = http_parse_request(raw);
        let resp = handler(req);
        tcp_write(s, resp);
        tcp_close(s);
    }
    return map{ ok: true };
}

// wrap_tls(tcp_handle, cert_path, key_path) — upgrade existing TCP handle to TLS
fn wrap_tls(tcp_handle, cert_path, key_path) {
    if not _provider_ready() { return map{ error: _provider_error() }; }
    let result = try tcp_wrap_tls(tcp_handle, cert_path, key_path) catch nil;
    if result == nil {
        return map{ error: "tcp_wrap_tls not available in this build." };
    }
    return result;
}

// is_available() reports safe high-level availability, not just whether symbols
// were compiled. A runtime with no selected CryptoProvider must fail closed.
fn is_available() {
    return _provider_ready();
}

fn provider_status() { return map{ available: is_available(), selected: try env_get("PBLANG_TLS_PROVIDER_READY") catch "",
    fail_closed: true, reason: if is_available() { nil } else { _provider_error() } }; }

// ── high-level HTTPS client ─────────────────────────────────────────────────────
// request_https(method, url, headers, body) → { ok, status, status_text, headers,
// body } (via http_client.parse_response) or { ok:false, error }. Connects with TLS,
// sends one request (Connection: close), reads the full response. Never throws.
fn request_https(method, url, headers, body, max_response_chars = 8388608) {
    if not str_starts_with(url, "https://") {
        return map{ ok: false, error: "request_https: URL must start with https://" };
    }
    if type(max_response_chars) != "number"
        or num_floor(max_response_chars) != max_response_chars
        or max_response_chars < 1024 or max_response_chars > 67108864 {
        return map{ ok: false, error: "request_https: invalid response bound" };
    }
    let rest = str_slice(url, 8, len(url));
    let slash = str_index_of(rest, "/");
    let authority = rest;
    let path = "/";
    if slash >= 0 { authority = str_slice(rest, 0, slash); path = str_slice(rest, slash, len(rest)); }
    let host = authority;
    let port = 443;
    let colon = str_index_of(authority, ":");
    if colon >= 0 {
        host = str_slice(authority, 0, colon);
        port = try parse_number(str_slice(authority, colon + 1, len(authority))) catch 443;
    }

    let conn = connect_tls(host, port);
    if conn.error != nil { return map{ ok: false, error: conn.error }; }
    let h = conn.handle;

    let b = body;
    if b == nil { b = ""; }
    let req = method + " " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n";
    if headers != nil {
        let ks = map_keys(headers);
        let i = 0;
        while i < len(ks) { req = req + ks[i] + ": " + str(headers[ks[i]]) + "\r\n"; i = i + 1; }
    }
    if b != "" { req = req + "Content-Length: " + str(len(b)) + "\r\n"; }
    req = req + "\r\n" + b;

    let wrote = try tcp_write(h, req) catch nil;
    if wrote == nil { try tcp_close(h) catch nil; return map{ ok: false, error: "request_https: write failed" }; }

    // Read until the server closes the connection (Connection: close).
    let raw = "";
    let chunk = try tcp_read(h, 65536) catch nil;
    while chunk != nil and chunk != "" {
        if len(raw) + len(chunk) > max_response_chars {
            try tcp_close(h) catch nil;
            return map{ ok: false, error: "request_https: response exceeds configured bound" };
        }
        raw = raw + chunk;
        chunk = try tcp_read(h, 65536) catch nil;
    }
    try tcp_close(h) catch nil;

    let resp = HTTPClient.parse_response(raw);
    return resp;
}

// get_https(url) — convenience GET.
fn get_https(url) { return request_https("GET", url, nil, nil); }

// post_https(url, body, headers) — convenience POST.
fn post_https(url, body, headers) { return request_https("POST", url, headers, body); }

// serve_app_tls(addr, cert, key, app) — serve an http_server app (app_handle) over
// TLS. Returns { error } if the listener can't start (e.g. bad cert).
fn serve_app_tls(addr, cert_path, key_path, app) {
    return serve_forever_tls(addr, cert_path, key_path, fn(req) {
        return HTTPServer.to_http_response(HTTPServer.app_handle(app, req));
    });
}

export listen_tls, connect_tls, serve_once_tls, serve_forever_tls, serve_app_tls,
       wrap_tls, is_available, provider_status, request_https, get_https, post_https;
