// stdlib/bioinformatics_dna.sapp — Real Bioinformatics & Computational Genomics Suite (v1.5.0)
// Implements Needleman-Wunsch global alignment, Smith-Waterman local alignment,
// GC content + reverse complement + 64-codon ORF finder, and De Bruijn Eulerian assembly.

fn _normalize_dna(seq) {
    let s = str_upper(str_trim(str(seq)));
    return str_replace_all(s, "U", "T");
}

fn _rev_join(chars) {
    let out = "";
    let k = len(chars) - 1;
    while k >= 0 {
        out = out + chars[k];
        k = k - 1;
    }
    return out;
}

// ── 1. Needleman-Wunsch Exact Global Sequence Alignment ─────────────────────
fn needleman_wunsch(seq_a, seq_b, match_score = 1, mismatch_penalty = nil, gap_penalty = nil) {
    let mis_pen = if mismatch_penalty == nil { 0 - 1 } else { mismatch_penalty };
    let gap_pen = if gap_penalty == nil { 0 - 2 } else { gap_penalty };
    let a = _normalize_dna(seq_a);
    let b = _normalize_dna(seq_b);
    let m = len(a);
    let n = len(b);

    let dp = [];
    let ptr = [];
    let i = 0;
    while i <= m {
        let row = [];
        let prow = [];
        let j = 0;
        while j <= n {
            push(row, 0);
            push(prow, 0);
            j = j + 1;
        }
        push(dp, row);
        push(ptr, prow);
        i = i + 1;
    }

    i = 1;
    while i <= m {
        dp[i][0] = i * gap_pen;
        ptr[i][0] = 2; // up
        i = i + 1;
    }
    let j = 1;
    while j <= n {
        dp[0][j] = j * gap_pen;
        ptr[0][j] = 3; // left
        j = j + 1;
    }

    i = 1;
    while i <= m {
        let ca = strcharcodeat(a, i - 1);
        j = 1;
        while j <= n {
            let cb = strcharcodeat(b, j - 1);
            let sub = if ca == cb { match_score } else { mis_pen };
            let diag = dp[i - 1][j - 1] + sub;
            let up = dp[i - 1][j] + gap_pen;
            let left = dp[i][j - 1] + gap_pen;

            if diag >= up and diag >= left {
                dp[i][j] = diag;
                ptr[i][j] = 1;
            } else if up >= left {
                dp[i][j] = up;
                ptr[i][j] = 2;
            } else {
                dp[i][j] = left;
                ptr[i][j] = 3;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let rev_a = [];
    let rev_b = [];
    let matches = 0;
    let ci = m;
    let cj = n;
    while ci > 0 or cj > 0 {
        let mv = ptr[ci][cj];
        if ci > 0 and cj > 0 and mv == 1 {
            let cha = str_slice(a, ci - 1, ci);
            let chb = str_slice(b, cj - 1, cj);
            if cha == chb { matches = matches + 1; }
            push(rev_a, cha);
            push(rev_b, chb);
            ci = ci - 1;
            cj = cj - 1;
        } else if ci > 0 and (cj == 0 or mv == 2) {
            push(rev_a, str_slice(a, ci - 1, ci));
            push(rev_b, "-");
            ci = ci - 1;
        } else {
            push(rev_a, "-");
            push(rev_b, str_slice(b, cj - 1, cj));
            cj = cj - 1;
        }
    }

    let aln_a = _rev_join(rev_a);
    let aln_b = _rev_join(rev_b);
    let aln_len = len(aln_a);
    let ident = if aln_len > 0 { (matches * 1.0) / aln_len } else { 1.0 };

    return map{
        ok: true,
        score: dp[m][n],
        aligned_a: aln_a,
        aligned_b: aln_b,
        matches: matches,
        alignment_length: aln_len,
        identity: ident
    };
}

// ── 2. Smith-Waterman Exact Local Sequence Alignment ────────────────────────
fn smith_waterman(seq_a, seq_b, match_score = 2, mismatch_penalty = nil, gap_penalty = nil) {
    let mis_pen = if mismatch_penalty == nil { 0 - 1 } else { mismatch_penalty };
    let gap_pen = if gap_penalty == nil { 0 - 2 } else { gap_penalty };
    let a = _normalize_dna(seq_a);
    let b = _normalize_dna(seq_b);
    let m = len(a);
    let n = len(b);

    let dp = [];
    let ptr = [];
    let i = 0;
    while i <= m {
        let row = [];
        let prow = [];
        let j = 0;
        while j <= n {
            push(row, 0);
            push(prow, 0);
            j = j + 1;
        }
        push(dp, row);
        push(ptr, prow);
        i = i + 1;
    }

    let best_score = 0;
    let best_i = 0;
    let best_j = 0;

    i = 1;
    while i <= m {
        let ca = strcharcodeat(a, i - 1);
        let j = 1;
        while j <= n {
            let cb = strcharcodeat(b, j - 1);
            let sub = if ca == cb { match_score } else { mis_pen };
            let diag = dp[i - 1][j - 1] + sub;
            let up = dp[i - 1][j] + gap_pen;
            let left = dp[i][j - 1] + gap_pen;

            let cell = 0;
            let dir = 0;
            if diag > cell { cell = diag; dir = 1; }
            if up > cell { cell = up; dir = 2; }
            if left > cell { cell = left; dir = 3; }

            dp[i][j] = cell;
            ptr[i][j] = dir;
            if cell > best_score {
                best_score = cell;
                best_i = i;
                best_j = j;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let rev_a = [];
    let rev_b = [];
    let matches = 0;
    let ci = best_i;
    let cj = best_j;
    while ci > 0 and cj > 0 and dp[ci][cj] > 0 {
        let mv = ptr[ci][cj];
        if mv == 1 {
            let cha = str_slice(a, ci - 1, ci);
            let chb = str_slice(b, cj - 1, cj);
            if cha == chb { matches = matches + 1; }
            push(rev_a, cha);
            push(rev_b, chb);
            ci = ci - 1;
            cj = cj - 1;
        } else if mv == 2 {
            push(rev_a, str_slice(a, ci - 1, ci));
            push(rev_b, "-");
            ci = ci - 1;
        } else if mv == 3 {
            push(rev_a, "-");
            push(rev_b, str_slice(b, cj - 1, cj));
            cj = cj - 1;
        } else {
            break;
        }
    }

    let aln_a = _rev_join(rev_a);
    let aln_b = _rev_join(rev_b);
    let aln_len = len(aln_a);
    let ident = if aln_len > 0 { (matches * 1.0) / aln_len } else { 0.0 };

    return map{
        ok: true,
        score: best_score,
        aligned_a: aln_a,
        aligned_b: aln_b,
        start_a: ci,
        end_a: best_i,
        start_b: cj,
        end_b: best_j,
        matches: matches,
        identity: ident
    };
}

// ── 3. GC Content, Reverse Complement & Standard Genetic Code ORF Finder ────
let _CODON_TABLE = map{
    "TTT": "F", "TTC": "F", "TTA": "L", "TTG": "L",
    "CTT": "L", "CTC": "L", "CTA": "L", "CTG": "L",
    "ATT": "I", "ATC": "I", "ATA": "I", "ATG": "M",
    "GTT": "V", "GTC": "V", "GTA": "V", "GTG": "V",
    "TCT": "S", "TCC": "S", "TCA": "S", "TCG": "S",
    "CCT": "P", "CCC": "P", "CCA": "P", "CCG": "P",
    "ACT": "T", "ACC": "T", "ACA": "T", "ACG": "T",
    "GCT": "A", "GCC": "A", "GCA": "A", "GCG": "A",
    "TAT": "Y", "TAC": "Y", "TAA": "*", "TAG": "*",
    "CAT": "H", "CAC": "H", "CAA": "Q", "CAG": "Q",
    "AAT": "N", "AAC": "N", "AAA": "K", "AAG": "K",
    "GAT": "D", "GAC": "D", "GAA": "E", "GAG": "E",
    "TGT": "C", "TGC": "C", "TGA": "*", "TGG": "W",
    "CGT": "R", "CGC": "R", "CGA": "R", "CGG": "R",
    "AGT": "S", "AGC": "S", "AGA": "R", "AGG": "R",
    "GGT": "G", "GGC": "G", "GGA": "G", "GGG": "G"
};

fn reverse_complement(dna_seq) {
    let s = _normalize_dna(dna_seq);
    let out = "";
    let i = len(s) - 1;
    while i >= 0 {
        let ch = str_slice(s, i, i + 1);
        if ch == "A" { out = out + "T"; }
        else if ch == "T" { out = out + "A"; }
        else if ch == "C" { out = out + "G"; }
        else if ch == "G" { out = out + "C"; }
        else { out = out + "N"; }
        i = i - 1;
    }
    return out;
}

fn translate_dna(dna_seq) {
    let s = _normalize_dna(dna_seq);
    let aa = "";
    let i = 0;
    while i + 3 <= len(s) {
        let codon = str_slice(s, i, i + 3);
        let res = if map_has(_CODON_TABLE, codon) { _CODON_TABLE[codon] } else { "X" };
        if res == "*" { break; }
        aa = aa + res;
        i = i + 3;
    }
    return aa;
}

fn gc_content_and_orfs(dna_seq, min_aa_len = 1) {
    let s = _normalize_dna(dna_seq);
    let n = len(s);
    let gc = 0;
    let i = 0;
    while i < n {
        let code = strcharcodeat(s, i);
        // 'G' = 71, 'C' = 67
        if code == 71 or code == 67 {
            gc = gc + 1;
        }
        i = i + 1;
    }
    let gc_frac = if n > 0 { (gc * 1.0) / n } else { 0.0 };

    let orfs = [];
    let frame = 0;
    while frame < 3 {
        let pos = frame;
        while pos + 3 <= n {
            let codon = str_slice(s, pos, pos + 3);
            if codon == "ATG" {
                let aa = "M";
                let cursor = pos + 3;
                let stopped = false;
                while cursor + 3 <= n {
                    let next_c = str_slice(s, cursor, cursor + 3);
                    let tr = if map_has(_CODON_TABLE, next_c) { _CODON_TABLE[next_c] } else { "X" };
                    if tr == "*" {
                        stopped = true;
                        cursor = cursor + 3;
                        break;
                    }
                    aa = aa + tr;
                    cursor = cursor + 3;
                }
                if stopped and len(aa) >= min_aa_len {
                    push(orfs, map{
                        frame: frame,
                        start: pos,
                        end: cursor,
                        nt_length: cursor - pos,
                        aa_length: len(aa),
                        protein: aa,
                        sequence: str_slice(s, pos, cursor)
                    });
                    pos = cursor;
                } else {
                    pos = pos + 3;
                }
            } else {
                pos = pos + 3;
            }
        }
        frame = frame + 1;
    }

    return map{
        ok: true,
        length: n,
        gc_count: gc,
        gc_content: gc_frac,
        reverse_complement: reverse_complement(s),
        orfs: orfs,
        orf_count: len(orfs)
    };
}

// ── 4. De Bruijn Graph Genome Assembler (Hierholzer Eulerian Path) ──────────
fn debruijn_assemble(reads, k, deduplicate = nil) {
    if k < 2 { throw "debruijn_assemble: k must be >= 2"; }
    let dedup = false;
    if deduplicate != nil {
        dedup = deduplicate;
    } else {
        let rc = 0;
        while rc < len(reads) {
            if len(_normalize_dna(reads[rc])) > k {
                dedup = true;
                break;
            }
            rc = rc + 1;
        }
    }

    let adj = map{};
    let indeg = map{};
    let outdeg = map{};
    let nodes_map = map{};
    let seen_kmers = map{};
    let num_kmers = 0;

    let r = 0;
    while r < len(reads) {
        let seq = _normalize_dna(reads[r]);
        let i = 0;
        while i + k <= len(seq) {
            let kmer = str_slice(seq, i, i + k);
            if (not dedup) or (not map_has(seen_kmers, kmer)) {
                seen_kmers[kmer] = true;
                let u = str_slice(kmer, 0, k - 1);
                let v = str_slice(kmer, 1, k);
                nodes_map[u] = true;
                nodes_map[v] = true;
                if not map_has(adj, u) { adj[u] = []; }
                push(adj[u], v);
                outdeg[u] = (if map_has(outdeg, u) { outdeg[u] } else { 0 }) + 1;
                indeg[v] = (if map_has(indeg, v) { indeg[v] } else { 0 }) + 1;
                if not map_has(outdeg, v) { outdeg[v] = 0; }
                if not map_has(indeg, u) { indeg[u] = 0; }
                num_kmers = num_kmers + 1;
            }
            i = i + 1;
        }
        r = r + 1;
    }

    let nodes = array_sort(map_keys(nodes_map));
    if len(nodes) == 0 {
        return map{ ok: false, contig: "", contigs: [], k: k, num_kmers: 0, num_nodes: 0 };
    }

    // Sort adjacency lists in reverse lexicographical order so `pop()` visits smallest first deterministically
    let idx = 0;
    while idx < len(nodes) {
        let u = nodes[idx];
        if map_has(adj, u) {
            let sorted_nbrs = array_sort(adj[u]);
            let rev_nbrs = [];
            let m = len(sorted_nbrs) - 1;
            while m >= 0 {
                push(rev_nbrs, sorted_nbrs[m]);
                m = m - 1;
            }
            adj[u] = rev_nbrs;
        } else {
            adj[u] = [];
        }
        idx = idx + 1;
    }

    // Choose Eulerian start node: outdeg - indeg == 1, else first node with outdeg > 0
    let start_node = nodes[0];
    idx = 0;
    while idx < len(nodes) {
        let u = nodes[idx];
        if outdeg[u] > 0 {
            start_node = u;
            break;
        }
        idx = idx + 1;
    }
    idx = 0;
    while idx < len(nodes) {
        let u = nodes[idx];
        if outdeg[u] - indeg[u] == 1 {
            start_node = u;
            break;
        }
        idx = idx + 1;
    }

    // Hierholzer's algorithm
    let stack = [start_node];
    let rev_trail = [];
    while len(stack) > 0 {
        let top = stack[len(stack) - 1];
        if len(adj[top]) > 0 {
            let nxt = pop(adj[top]);
            push(stack, nxt);
        } else {
            push(rev_trail, pop(stack));
        }
    }

    let contig = rev_trail[len(rev_trail) - 1];
    let p = len(rev_trail) - 2;
    while p >= 0 {
        let node_str = rev_trail[p];
        contig = contig + str_slice(node_str, len(node_str) - 1, len(node_str));
        p = p - 1;
    }

    return map{
        ok: len(contig) >= k,
        contig: contig,
        contigs: [contig],
        k: k,
        num_kmers: num_kmers,
        num_nodes: len(nodes)
    };
}

export needleman_wunsch, smith_waterman,
       reverse_complement, translate_dna, gc_content_and_orfs,
       debruijn_assemble;
