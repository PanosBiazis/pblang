// stdlib/complex.sapp — complex numbers as map{ re, im }. Self-contained
// (its own range-reduced sin/cos for exp/from_polar), so it needs no other
// module.
//
//   let cx = import("stdlib:complex.sapp");
//   cx.abs(cx.new(3, 4))                 // 5
//   cx.to_string(cx.mul(cx.new(1,2), cx.new(3,4)))   // "-5+10i"
//   cx.to_string(cx.sqrt(cx.new(3, 4)))  // "2+1i"

let _PI = 3.141592653589793;
let _TWO_PI = 6.283185307179586;

// A complex number carries operator-overloading dunders so natural syntax works
// (`a + b`, `2 * z`, `z - 1`, `-z`, `a == b`) alongside the function API
// (`add`/`mul`/…). Each dunder handles both complex (map) and scalar (number)
// operands; reflected variants (`__radd__`/`__rmul__`/`__rsub__`) cover
// `scalar OP complex` and unary minus (`-z` desugars to `0 - z`). The closures
// reference module globals (`add`, `new`, …) resolved at call time.
fn new(re_v, im_v) {
    return map{
        re: re_v, im: im_v,
        __add__:  fn(self, o) { if is_map(o) { return add(self, o); } return new(self["re"] + o, self["im"]); },
        __radd__: fn(self, o) { return new(self["re"] + o, self["im"]); },
        __sub__:  fn(self, o) { if is_map(o) { return sub(self, o); } return new(self["re"] - o, self["im"]); },
        __rsub__: fn(self, o) { return new(o - self["re"], 0 - self["im"]); },
        __mul__:  fn(self, o) { if is_map(o) { return mul(self, o); } return scale(self, o); },
        __rmul__: fn(self, o) { return scale(self, o); },
        __div__:  fn(self, o) { if is_map(o) { return div(self, o); } return scale(self, 1 / o); },
        __eq__:   fn(self, o) { if is_map(o) { return self["re"] == o["re"] and self["im"] == o["im"]; } return self["im"] == 0 and self["re"] == o; }
    };
}
fn of(re_v, im_v) { return new(re_v, im_v); }
fn from_real(x) { return new(x, 0); }
fn zero() { return new(0, 0); }
fn one() { return new(1, 0); }
fn i_unit() { return new(0, 1); }

fn re(z) { return z["re"]; }
fn im(z) { return z["im"]; }

fn add(a, b) { return new(a["re"] + b["re"], a["im"] + b["im"]); }
fn sub(a, b) { return new(a["re"] - b["re"], a["im"] - b["im"]); }
fn neg(z) { return new(0 - z["re"], 0 - z["im"]); }
fn conj(z) { return new(z["re"], 0 - z["im"]); }
fn scale(z, k) { return new(z["re"] * k, z["im"] * k); }

fn mul(a, b) {
    return new(
        a["re"] * b["re"] - a["im"] * b["im"],
        a["re"] * b["im"] + a["im"] * b["re"]
    );
}

fn abs_sq(z) { return z["re"] * z["re"] + z["im"] * z["im"]; }
fn abs(z) { return num_sqrt(abs_sq(z)); }
fn arg(z) { return num_atan2(z["im"], z["re"]); }

fn div(a, b) {
    let d = abs_sq(b);
    if d == 0 { return error("complex: division by zero"); }
    return new(
        (a["re"] * b["re"] + a["im"] * b["im"]) / d,
        (a["im"] * b["re"] - a["re"] * b["im"]) / d
    );
}

fn inv(z) {
    let d = abs_sq(z);
    if d == 0 { return error("complex: inverse of zero"); }
    return new(z["re"] / d, (0 - z["im"]) / d);
}

// Integer power (negative exponents allowed via inverse).
fn pow_int(z, n) {
    if n == 0 { return one(); }
    let neg = n < 0;
    let e = n;
    if neg { e = 0 - n; }
    let result = one();
    let base = z;
    let k = 0;
    while k < e { result = mul(result, base); k = k + 1; }
    if neg { return inv(result); }
    return result;
}

// Principal square root.
fn sqrt(z) {
    let a = z["re"];
    let b = z["im"];
    if b == 0 {
        if a >= 0 { return new(num_sqrt(a), 0); }
        return new(0, num_sqrt(0 - a));
    }
    let m = abs(z);
    let re_p = num_sqrt((m + a) / 2.0);
    let im_p = num_sqrt((m - a) / 2.0);
    if b < 0 { im_p = 0 - im_p; }
    return new(re_p, im_p);
}

fn _reduce(x) {
    let t = x;
    while t > _PI { t = t - _TWO_PI; }
    while t < (0 - _PI) { t = t + _TWO_PI; }
    return t;
}
fn _sin(x) {
    let t = _reduce(x);
    let term = t;
    let sum = t;
    let n = 1;
    while n <= 12 {
        term = term * (0 - t * t) / ((2 * n) * (2 * n + 1));
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}
fn _cos(x) {
    let t = _reduce(x);
    let term = 1;
    let sum = 1;
    let n = 1;
    while n <= 12 {
        term = term * (0 - t * t) / ((2 * n - 1) * (2 * n));
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

// e^z = e^a (cos b + i sin b)
fn exp(z) {
    let ea = num_exp(z["re"]);
    return new(ea * _cos(z["im"]), ea * _sin(z["im"]));
}

// r (cos θ + i sin θ)
fn from_polar(r, theta) { return new(r * _cos(theta), r * _sin(theta)); }

// to_polar(z) → { r, theta } — magnitude and principal argument.
fn to_polar(z) { return map{ r: abs(z), theta: arg(z) }; }

// log(z) — principal natural logarithm: ln|z| + i·arg(z).
fn log(z) {
    let d = abs_sq(z);
    if d == 0 { return error("complex: log of zero"); }
    return new(num_ln(abs(z)), arg(z));
}

// pow(z, w) — complex power z^w (w may be complex or a real scalar).
fn pow(z, w) {
    if is_map(w) { return exp(mul(w, log(z))); }
    return exp(scale(log(z), w));
}

fn _cosh(x) { let e = num_exp(x); return (e + 1 / e) / 2; }
fn _sinh(x) { let e = num_exp(x); return (e - 1 / e) / 2; }

// Complex trig: sin(a+bi) = sin a cosh b + i cos a sinh b, etc.
fn sin(z) { return new(_sin(z["re"]) * _cosh(z["im"]), _cos(z["re"]) * _sinh(z["im"])); }
fn cos(z) { return new(_cos(z["re"]) * _cosh(z["im"]), 0 - _sin(z["re"]) * _sinh(z["im"])); }
fn tan(z) { return div(sin(z), cos(z)); }

fn equals(a, b) { return a["re"] == b["re"] and a["im"] == b["im"]; }
fn equals_approx(a, b, eps) {
    return num_abs(a["re"] - b["re"]) <= eps and num_abs(a["im"] - b["im"]) <= eps;
}

fn to_string(z) {
    let r = z["re"];
    let im_v = z["im"];
    if im_v >= 0 { return str(r) + "+" + str(im_v) + "i"; }
    return str(r) + "-" + str(0 - im_v) + "i";
}

export new, of, from_real, zero, one, i_unit, re, im, add, sub, neg, conj,
       scale, mul, abs_sq, abs, arg, div, inv, pow_int, sqrt, exp, from_polar,
       to_polar, log, pow, sin, cos, tan,
       equals, equals_approx, to_string;
