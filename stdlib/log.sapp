// stdlib/log.sapp — Structured, leveled logging for pblang.
//
// Supports: DEBUG, INFO, WARN, ERROR levels. JSON and text output formats.
// Global logger + per-module loggers.
//
// Usage:
//   let log = import("stdlib:log.sapp");
//   log.info("Server started", map{ port: 8080 });
//   log.error("Database error", map{ query: "SELECT ...", err: "timeout" });
//   let mylog = log.new_logger("my-module", "json");
//   mylog.debug("Detailed trace");

let _LEVEL_DEBUG = 0;
let _LEVEL_INFO  = 1;
let _LEVEL_WARN  = 2;
let _LEVEL_ERROR = 3;

let _level_names = ["DEBUG", "INFO", "WARN", "ERROR"];

// Global state
let _global_min_level = _LEVEL_INFO;
let _global_format = "text";   // "text" or "json"
let _global_output = "stdout"; // "stdout", "stderr", or a file path
let _log_file_path = nil;

// set_level(level) — set global minimum level. Level: "debug","info","warn","error"
fn set_level(level) {
    let lower = str_lower(level);
    if lower == "debug" { _global_min_level = _LEVEL_DEBUG; }
    else if lower == "info"  { _global_min_level = _LEVEL_INFO; }
    else if lower == "warn"  { _global_min_level = _LEVEL_WARN; }
    else if lower == "error" { _global_min_level = _LEVEL_ERROR; }
}

// set_format(format) — "text" or "json"
fn set_format(format) {
    _global_format = format;
}

// set_output(output) — "stdout", "stderr", or a file path
fn set_output(output) {
    _global_output = output;
    if output != "stdout" and output != "stderr" {
        _log_file_path = output;
    } else {
        _log_file_path = nil;
    }
}

fn _now_iso() {
    return try now_iso() catch str(clock());
}

fn _format_text(level_name, message, fields) {
    let ts = _now_iso();
    let line = "[" + ts + "] [" + level_name + "] " + message;
    if fields != nil {
        let keys = map_keys(fields);
        for i len(keys) {
            line = line + " " + keys[i] + "=" + str(fields[keys[i]]);
        }
    }
    return line;
}

fn _format_json(level_name, message, fields, source) {
    let entry = map{ ts: _now_iso(), level: level_name, msg: message };
    if source != nil { entry.source = source; }
    if fields != nil {
        let keys = map_keys(fields);
        for i len(keys) {
            entry[keys[i]] = fields[keys[i]];
        }
    }
    return json_stringify(entry);
}

fn _write_log(level_num, level_name, message, fields, source, format, output) {
    if level_num < _global_min_level { return; }
    let line = "";
    if format == "json" {
        line = _format_json(level_name, message, fields, source);
    } else {
        line = _format_text(level_name, message, fields);
    }
    if _log_file_path != nil {
        try fs_append(_log_file_path, line + "\n") catch nil;
    } else {
        print line;
    }
}

// debug(msg, fields) — log at DEBUG level
fn debug(msg, fields) {
    _write_log(_LEVEL_DEBUG, "DEBUG", msg, fields, nil, _global_format, _global_output);
}

// info(msg, fields) — log at INFO level
fn info(msg, fields) {
    _write_log(_LEVEL_INFO, "INFO", msg, fields, nil, _global_format, _global_output);
}

// warn(msg, fields) — log at WARN level
fn warn(msg, fields) {
    _write_log(_LEVEL_WARN, "WARN", msg, fields, nil, _global_format, _global_output);
}

// error(msg, fields) — log at ERROR level
fn log_error(msg, fields) {
    _write_log(_LEVEL_ERROR, "ERROR", msg, fields, nil, _global_format, _global_output);
}

// new_logger(source, format) — create a named logger
fn new_logger(source, format) {
    if format == nil { format = _global_format; }
    return map{
        source: source,
        format: format,
        min_level: _global_min_level,
        debug: fn(msg, fields) {
            _write_log(_LEVEL_DEBUG, "DEBUG", msg, fields, source, format, _global_output);
        },
        info: fn(msg, fields) {
            _write_log(_LEVEL_INFO, "INFO", msg, fields, source, format, _global_output);
        },
        warn: fn(msg, fields) {
            _write_log(_LEVEL_WARN, "WARN", msg, fields, source, format, _global_output);
        },
        error: fn(msg, fields) {
            _write_log(_LEVEL_ERROR, "ERROR", msg, fields, source, format, _global_output);
        }
    };
}

// timed(label, fn) — measure and log execution time
fn timed(label, fn_) {
    let start = clock();
    let result = fn_();
    let elapsed_ms = (clock() - start) * 1000.0;
    _write_log(_LEVEL_INFO, "INFO", label, map{ elapsed_ms: elapsed_ms }, nil, _global_format, _global_output);
    return result;
}

export set_level, set_format, set_output,
       debug, info, warn, log_error,
       new_logger, timed;
