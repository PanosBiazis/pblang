let Tables=import("stdlib:table_files.sapp");let Allocation=import("stdlib:allocation_table.sapp");
fn open(path,total,delimiter=","){let loaded=Tables.open(path,delimiter);if not loaded.ok{return loaded;}let report=try Allocation.from_sheet(loaded.document,total) catch nil;if report==nil{return map{ok:false,error:"Expected Label,Weight headers, nonblank labels, integer weights and a valid total; output must fit Sheets limits."};}return map{ok:true,report:report};}
fn save(path,report,delimiter=","){if type(report)!="map" or not map_has(report,"document"){return map{ok:false,error:"No allocation table."};}return Tables.save(path,report.document,if type(path)=="string" and str_ends_with(str_lower(path),".pbsheet") {"sheet"} else {"csv"},delimiter);}
fn run(input,output,total,delimiter=","){let loaded=open(input,total,delimiter);if not loaded.ok{return loaded;}let saved=save(output,loaded.report,delimiter);if not saved.ok{return saved;}return map{ok:true,total:loaded.report.total,rows:loaded.report.rows,method:loaded.report.method,atomic_visibility:false};}
export open,save,run;
