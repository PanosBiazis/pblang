// stdlib/sovereign_studio_ui.sapp — Sovereign Studio Cross-Platform Explainable UI (v2.0.0)
//
// Aesthetic & Engineering Design System:
//   * Obsidian & Emerald/Cyan High-Contrast Design System (theme_dark() & theme_light(), WCAG AAA).
//   * 4 Interactive Tabs:
//       1. Επισκόπηση (Sovereign Overview)
//       2. Υλικό & Επιταχυντές (CPU/GPU/NPU/TPU)
//       3. Μεταγλωττιστές (Zero-Rust & Path B Native)
//       4. Εξηγησιμότητα & Πόροι (Explainable Governor)
//   * Dual Rendering Modes:
//       1. run_native_studio_window(opts): Native OS window (1080x680) with event-driven dirty-flag
//          zero-idle rendering via hardware_governor.govern_frame_pace(), gfxdrawrects batching,
//          gfxdrawline sparklines, and gfxdrawtextaa anti-aliased Greek & English typography.
//       2. render_studio_html(hw_profile, plan) & export_studio_html(out_path, hw_profile, plan):
//          Self-contained, 100% offline, zero-external-CDN HTML5 + CSS Grid + inline SVG Studio
//          Dashboard with Dark/Light switcher, EL/EN bilingual toggle, live SVG gauges (including
//          320 KB vs 42,000 KB = 99.2% binary reduction), interactive workload simulator, and
//          explainable governor decision trace.

let Gov = try import("stdlib/hardware_governor.sapp") catch (try import("hardware_governor.sapp") catch import("stdlib:hardware_governor.sapp"));
let BF = try import("stdlib/bitmap_font.sapp") catch (try import("bitmap_font.sapp") catch import("stdlib:bitmap_font.sapp"));
let UIK = try import("stdlib/ui_kit.sapp") catch (try import("ui_kit.sapp") catch import("stdlib:ui_kit.sapp"));

let STUDIO_VERSION = "2.3.0";
let STUDIO_WINDOW_TITLE = "PBLang 2.0 Sovereign Studio — Zero-Rust Architecture";
let SOVEREIGN_BINARY_KB = 320;
let LEGACY_BINARY_KB = 42000;
let BINARY_REDUCTION_PCT = 99.2;

fn _is_true(val) {
    if type(val) == "bool" { return val; }
    return false;
}

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _min(a, b) {
    if a < b { return a; }
    return b;
}

fn _max(a, b) {
    if a > b { return a; }
    return b;
}

fn _int_or(v, fb) {
    if v == nil { return fb; }
    let n = try parse_number(str_trim(str(v))) catch nil;
    if n == nil { return fb; }
    return num_floor(n);
}

// ── Obsidian & Emerald/Cyan WCAG AAA Design System ──────────────────────────

