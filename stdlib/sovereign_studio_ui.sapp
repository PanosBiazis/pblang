// ── Native OS Window Renderer Helpers (Batched Rects + AA Text + Sparklines) ─

fn _resolve_ui_font_path() {
    let custom = try env_get("PBLANG_FONT") catch nil;
    if custom != nil and str_trim(str(custom)) != "" {
        return str_trim(str(custom));
    }
    let candidates = [
        "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf",
        "/System/Library/Fonts/Helvetica.ttc",
        "C:/Windows/Fonts/segoeui.ttf",
        "C:/Windows/Fonts/arial.ttf"
    ];
    let i = 0;
    while i < len(candidates) {
        if _is_true(try fs_exists(candidates[i]) catch false) {
            return candidates[i];
        }
        i = i + 1;
    }
    return "";
}

fn _size_changed(prev, cur) {
    if prev == nil or cur == nil { return true; }
    let pw = _int_or(try prev.w catch 0, 0);
    let ph = _int_or(try prev.h catch 0, 0);
    let cw = _int_or(try cur.w catch 0, 0);
    let ch = _int_or(try cur.h catch 0, 0);
    return pw != cw or ph != ch;
}

fn _draw_text_crisp(handle, font_path, x, y, text, color, px) {
    let s = str(text);
    if font_path != "" {
        let res = try gfxdrawtextaa(handle, num_floor(x), num_floor(y), s, color, px, font_path, 0) catch nil;
        if res != nil and _is_true(try res.ok catch false) {
            return;
        }
    }
    BF.draw_text(fn(px_x, px_y, c) { gfxdrawpoint(handle, px_x, px_y, c); }, num_floor(x), num_floor(y), s, color);
}

fn _draw_card(handle, th, x, y, w, h, radius) {
    let sh = UIK.elevation(x, y, w, h, 2);
    gfxdrawrects(handle, sh, th.rgb.shadow);
    let c = UIK.card(x, y, w, h, radius, 1);
    gfxdrawrects(handle, c.border, th.rgb.border);
    gfxdrawrects(handle, c.fill, th.rgb.surface);
}

fn _draw_pill_badge(handle, font_path, x, y, w, h, text, bg_col, fg_col) {
    let rects = UIK.pill(x, y, w, h);
    gfxdrawrects(handle, rects, bg_col);
    _draw_text_crisp(handle, font_path, x + 10, y + 5, text, fg_col, 13);
}

fn _draw_progress_bar(handle, th, x, y, w, h, frac, fill_col) {
    let f = _clamp(frac, 0, 1);
    let bar = UIK.progress(x, y, w, h, f);
    gfxdrawrects(handle, UIK.rounded_rect(bar.track.x, bar.track.y, bar.track.w, bar.track.h, 4), th.rgb.track);
    if bar.fill.w > 2 {
        gfxdrawrects(handle, UIK.rounded_rect(bar.fill.x, bar.fill.y, bar.fill.w, bar.fill.h, 4), fill_col);
    }
}

fn _draw_sparkline(handle, th, x, y, w, h, samples, line_col) {
    gfxdrawrects(handle, UIK.rounded_rect(x, y, w, h, 6), th.rgb.surface_alt);
    let n = len(samples);
    if n < 2 { return; }
    let max_v = 1;
    let i = 0;
    while i < n {
        if samples[i] > max_v { max_v = samples[i]; }
        i = i + 1;
    }
    let step_x = (w - 16) / (n - 1);
    let k = 1;
    while k < n {
        let x1 = num_floor(x + 8 + (k - 1) * step_x);
        let y1 = num_floor(y + h - 8 - ((samples[k - 1] / max_v) * (h - 16)));
        let x2 = num_floor(x + 8 + k * step_x);
        let y2 = num_floor(y + h - 8 - ((samples[k] / max_v) * (h - 16)));
        gfxdrawline(handle, x1, y1, x2, y2, line_col);
        k = k + 1;
    }
}

fn _truncate_text(s, max_chars) {
    let t = str(s);
    if len(t) <= max_chars { return t; }
    return str_slice(t, 0, max_chars - 1) + "…";
}

fn _build_hit_boxes(w) {
    let pad = 20;
    let tabs = studio_tabs();
    let tab_rects = UIK.segmented(pad, 64, w - 2 * pad, 36, len(tabs), 8);
    let btn_theme = map{ x: w - 310, y: 16, w: 92, h: 32, id: "btn_theme" };
    let btn_work = map{ x: w - 210, y: 16, w: 92, h: 32, id: "btn_work" };
    let btn_refresh = map{ x: w - 110, y: 16, w: 90, h: 32, id: "btn_refresh" };
    return map{
        tabs: tab_rects,
        btn_theme: btn_theme,
        btn_work: btn_work,
        btn_refresh: btn_refresh
    };
}

fn _paint_studio_frame(handle, state) {
    let sz = gfxsize(handle);
    let w = _max(640, _int_or(try sz.w catch 1080, 1080));
    let h = _max(480, _int_or(try sz.h catch 680, 680));
    let th = theme_dark();
    if not state.dark_mode { th = theme_light(); }
    let fp = state.font_path;
    let hw = state.hw;
    let plan = state.plan;

    gfxclear(handle, th.rgb.bg);

    // Header Bar (batched fill + bottom hairline)
    gfxdrawrects(handle, [
        map{ x: 0, y: 0, w: w, h: 56 },
        UIK.divider_h(0, 56, w, 1)
    ], th.rgb.header_bg);
    gfxdrawrects(handle, [UIK.divider_h(0, 56, w, 1)], th.rgb.border);

    _draw_text_crisp(handle, fp, 20, 14, "PBLang 2.0 Sovereign Studio", th.rgb.emerald, 19);
    _draw_text_crisp(handle, fp, 20, 36, "Zero-Rust Architecture  •  WCAG AAA  •  Zero-Idle Event Governor (~0.0% Idle CPU)", th.rgb.text_muted, 12);

    let hits = _build_hit_boxes(w);
    let th_label = "[T] Light";
    if not state.dark_mode { th_label = "[T] Dark"; }
    _draw_pill_badge(handle, fp, hits.btn_theme.x, hits.btn_theme.y, hits.btn_theme.w, hits.btn_theme.h, th_label, th.rgb.surface_alt, th.rgb.text_primary);
    _draw_pill_badge(handle, fp, hits.btn_work.x, hits.btn_work.y, hits.btn_work.w, hits.btn_work.h, "[W] " + state.workload, th.rgb.cyan_soft, th.rgb.cyan);
    _draw_pill_badge(handle, fp, hits.btn_refresh.x, hits.btn_refresh.y, hits.btn_refresh.w, hits.btn_refresh.h, "[R] Ανανέωση", th.rgb.emerald_soft, th.rgb.emerald);

    // Interactive Tab Bar
    let tabs = studio_tabs();
    let ti = 0;
    while ti < len(tabs) {
        let tr = hits.tabs[ti];
        let is_act = ti == state.active_tab;
        let fill_c = th.rgb.surface;
        let text_c = th.rgb.text_secondary;
        if is_act {
            fill_c = th.rgb.surface_alt;
            text_c = th.rgb.emerald;
        } else if state.hover_id == ("tab_" + str(ti)) {
            fill_c = th.rgb.surface_hover;
        }
        gfxdrawrects(handle, UIK.rounded_rect(tr.x, tr.y, tr.w, tr.h, 6), fill_c);
        if is_act {
            gfxdrawrects(handle, [UIK.bottom_accent(tr.x + 8, tr.y, tr.w - 16, tr.h, 3)], th.rgb.emerald);
        }
        _draw_text_crisp(handle, fp, tr.x + 10, tr.y + 10, _truncate_text(tabs[ti].label, 34), text_c, 13);
        ti = ti + 1;
    }

    let content_y = 114;
    let content_h = h - content_y - 40;
    let col_gap = 16;
    let col_w = num_floor((w - 40 - col_gap) / 2);

    if state.active_tab == 0 {
        // TAB 1: Επισκόπηση (Sovereign Overview)
        let kpi_rects = UIK.grid_cells(20, content_y, w - 40, 120, 4, 1, 12);
        let k0 = kpi_rects[0];
        let k1 = kpi_rects[1];
        let k2 = kpi_rects[2];
        let k3 = kpi_rects[3];

        _draw_card(handle, th, k0.x, k0.y, k0.w, k0.h, 8);
        _draw_text_crisp(handle, fp, k0.x + 14, k0.y + 12, "Πυρήνες CPU / Νήματα", th.rgb.text_muted, 12);
        _draw_text_crisp(handle, fp, k0.x + 14, k0.y + 36, str(hw.cpu.logical_cores) + " cores -> " + str(plan.worker_threads) + " workers", th.rgb.emerald, 18);
        _draw_progress_bar(handle, th, k0.x + 14, k0.y + 78, k0.w - 28, 10, plan.worker_threads / _max(1, hw.cpu.logical_cores), th.rgb.emerald);

        _draw_card(handle, th, k1.x, k1.y, k1.w, k1.h, 8);
        _draw_text_crisp(handle, fp, k1.x + 14, k1.y + 12, "Μνήμη RAM (" + hw.pressure_tier + ")", th.rgb.text_muted, 12);
        _draw_text_crisp(handle, fp, k1.x + 14, k1.y + 36, str(hw.ram_available_mb) + " / " + str(hw.ram_total_mb) + " MiB free", th.rgb.cyan, 18);
        _draw_progress_bar(handle, th, k1.x + 14, k1.y + 78, k1.w - 28, 10, hw.ram_used_pct / 100, th.rgb.cyan);

        _draw_card(handle, th, k2.x, k2.y, k2.w, k2.h, 8);
        _draw_text_crisp(handle, fp, k2.x + 14, k2.y + 12, "Αποτύπωμα Εκτελέσιμου", th.rgb.text_muted, 12);
        _draw_text_crisp(handle, fp, k2.x + 14, k2.y + 36, "320 KB (-99.2%)", th.rgb.emerald, 18);
        _draw_text_crisp(handle, fp, k2.x + 14, k2.y + 68, "έναντι 42,000 KB Legacy", th.rgb.text_secondary, 12);
        _draw_progress_bar(handle, th, k2.x + 14, k2.y + 90, k2.w - 28, 8, 0.04, th.rgb.emerald);

        _draw_card(handle, th, k3.x, k3.y, k3.w, k3.h, 8);
        _draw_text_crisp(handle, fp, k3.x + 14, k3.y + 12, "Διαδρομή & Ρυθμός UI", th.rgb.text_muted, 12);
        _draw_text_crisp(handle, fp, k3.x + 14, k3.y + 36, plan.accelerator_route + " @ " + str(plan.ui_fps_cap) + " FPS", th.rgb.amber, 18);
        _draw_text_crisp(handle, fp, k3.x + 14, k3.y + 68, "Power: " + hw.power_mode + " | ~0% Idle", th.rgb.text_secondary, 12);

        let lower_y = content_y + 136;
        let lower_h = _max(180, content_h - 136);
        _draw_card(handle, th, 20, lower_y, col_w, lower_h, 8);
        _draw_text_crisp(handle, fp, 36, lower_y + 14, "Κυρίαρχη Τοπική Εκτέλεση & Προαιρετικοί Frontier Κόμβοι", th.rgb.text_primary, 15);
        _draw_text_crisp(handle, fp, 36, lower_y + 42, "• 100% Τοπική Ιδιωτικότητα: Μηδενικά εξωτερικά CDNs, μηδενική διαρροή τηλεμετρίας.", th.rgb.emerald, 13);
        _draw_text_crisp(handle, fp, 36, lower_y + 66, "• Αλυσίδα Επιτάχυνσης: " + str_join(plan.fallback_chain, " -> "), th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, 36, lower_y + 90, "• Όριο GC: " + str(plan.gc_watermark_mb) + " MiB  |  Sparse Hive LRU: " + str(plan.sparse_hive_lru_cells) + " cells", th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, 36, lower_y + 118, "• Υβριδική Σύγκριση Frontier LLMs (Nov 2026):", th.rgb.cyan, 13);
        _draw_text_crisp(handle, fp, 36, lower_y + 140, "  " + str_join(frontier_llm_catalog(), " · "), th.rgb.text_muted, 12);

        let rx = 20 + col_w + col_gap;
        _draw_card(handle, th, rx, lower_y, col_w, lower_h, 8);
        _draw_text_crisp(handle, fp, rx + 16, lower_y + 14, "Ζωντανή Καμπύλη Χρόνου Καρέ & Zero-Idle Governor (ms)", th.rgb.text_primary, 15);
        _draw_sparkline(handle, th, rx + 16, lower_y + 44, col_w - 32, _max(80, lower_h - 92), state.sparkline, th.rgb.emerald);
        _draw_text_crisp(handle, fp, rx + 16, lower_y + lower_h - 34, "Σχεδιασμένα καρέ: " + str(state.rendered_frames) + "  |  Παραλειφθέντα τικ αδράνειας: " + str(state.skipped_idle_ticks), th.rgb.text_muted, 12);
    } else if state.active_tab == 1 {
        // TAB 2: Υλικό & Επιταχυντές (CPU/GPU/NPU/TPU)
        _draw_card(handle, th, 20, content_y, col_w, content_h, 8);
        _draw_text_crisp(handle, fp, 36, content_y + 16, "Επεξεργαστής, SIMD & Θερμικό Προφίλ", th.rgb.emerald, 16);
        _draw_text_crisp(handle, fp, 36, content_y + 46, "Μοντέλο: " + _truncate_text(hw.cpu.model_name, 52), th.rgb.text_primary, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 70, "Αρχιτεκτονική: " + hw.cpu.arch + "  |  Λογικοί Πυρήνες: " + str(hw.cpu.logical_cores), th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 94, "Governor: " + hw.cpu.governor + "  |  Συχνότητα: " + str(hw.cpu.cur_freq_khz) + " kHz", th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 118, "Επεκτάσεις SIMD: " + str_join(hw.cpu.simd.extensions, ", "), th.rgb.cyan, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 148, "Αποθήκευση Block: " + str(hw.storage.count) + " δίσκοι (" + str(hw.storage.total_gb) + " GB, NVMe=" + str(hw.storage.has_nvme) + ")", th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 172, "Περιφερειακά Edge I/O: Serial/MCU=" + str(len(hw.peripherals.serial_mcu)) + ", I2C=" + str(len(hw.peripherals.i2c)) + ", V4L2=" + str(len(hw.peripherals.cameras)) + ", ALSA=" + str(len(hw.peripherals.audio_pcm)), th.rgb.text_muted, 12);

        let rx = 20 + col_w + col_gap;
        _draw_card(handle, th, rx, content_y, col_w, content_h, 8);
        _draw_text_crisp(handle, fp, rx + 16, content_y + 16, "Ειλικρινής Χαρτογράφηση GPU / NPU / TPU", th.rgb.cyan, 16);
        let gpu_line = "GPU: Απούσα (present=false)";
        if hw.gpu.present and len(hw.gpus) > 0 {
            gpu_line = "GPU: Παρούσα (" + str(hw.gpus[0].vendor) + ", VRAM=" + str(hw.gpus[0].vram_mb) + " MiB, node=" + str(hw.gpus[0].render_node) + ")";
        }
        _draw_text_crisp(handle, fp, rx + 16, content_y + 50, gpu_line, th.rgb.text_primary, 13);
        _draw_text_crisp(handle, fp, rx + 16, content_y + 82, "NPU (/dev/accel, Hailo): present=" + str(hw.npu.present) + " (συσκευές=" + str(hw.npu.count) + ")", th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, rx + 16, content_y + 114, "TPU (Coral Edge / Cloud): present=" + str(hw.tpu.present) + " (συσκευές=" + str(hw.tpu.count) + ")", th.rgb.text_secondary, 13);
        _draw_text_crisp(handle, fp, rx + 16, content_y + 154, "Επιλεγμένη Διαδρομή Εκτέλεσης: " + plan.accelerator_route, th.rgb.emerald, 15);
    } else if state.active_tab == 2 {
        // TAB 3: Μεταγλωττιστές (Zero-Rust & Path B Native)
        _draw_card(handle, th, 20, content_y, w - 40, content_h, 8);
        _draw_text_crisp(handle, fp, 36, content_y + 18, "Αρχιτεκτονική Zero-Rust v2.0.0 & Path B Απευθείας Κώδικας Μηχανής", th.rgb.emerald, 17);
        _draw_text_crisp(handle, fp, 36, content_y + 52, "1. Pure-PBLang Frontend & Bytecode Compiler (.sapp -> .pbck v1): 100% αυτοφιλοξενούμενος.", th.rgb.text_primary, 14);
        _draw_text_crisp(handle, fp, 36, content_y + 80, "2. Stage-3 Zero-Rust C99 Bytecode VM: 0 σύμβολα Rust στο nm, ντετερμινιστική ισοτιμία stdout.", th.rgb.text_primary, 14);
        _draw_text_crisp(handle, fp, 36, content_y + 108, "3. Path B Native ELF64 / PE64 Emitters (x86_64 & aarch64): αυτόνομα εκτελέσιμα χωρίς εξωτερικό linker.", th.rgb.text_primary, 14);
        _draw_text_crisp(handle, fp, 36, content_y + 150, "Σύγκριση Μεγέθους Δυαδικού Αρχείου (99.2% μείωση):", th.rgb.cyan, 15);
        _draw_text_crisp(handle, fp, 36, content_y + 178, "Sovereign Zero-Rust / Path B: 320 KB", th.rgb.emerald, 13);
        _draw_progress_bar(handle, th, 320, content_y + 180, w - 380, 12, 0.03, th.rgb.emerald);
        _draw_text_crisp(handle, fp, 36, content_y + 208, "Legacy Monolithic Toolchain:  42,000 KB", th.rgb.coral, 13);
        _draw_progress_bar(handle, th, 320, content_y + 210, w - 380, 12, 1.0, th.rgb.coral);
    } else {
        // TAB 4: Εξηγησιμότητα & Πόροι (Explainable Governor)
        _draw_card(handle, th, 20, content_y, w - 40, content_h, 8);
        _draw_text_crisp(handle, fp, 36, content_y + 16, "Διαφανής Αιτιολόγηση Κυβερνήτη Πόρων (EL / EN)", th.rgb.emerald, 16);
        _draw_text_crisp(handle, fp, 36, content_y + 48, "EL: " + _truncate_text(plan.explanation_el, 118), th.rgb.text_primary, 13);
        _draw_text_crisp(handle, fp, 36, content_y + 72, "EN: " + _truncate_text(plan.explanation_en, 118), th.rgb.text_secondary, 13);
        let fy = content_y + 108;
        let fi = 0;
        while fi < len(plan.decision_factors) {
            let df = plan.decision_factors[fi];
            _draw_text_crisp(handle, fp, 36, fy + fi * 44, "• [" + df.factor + "] " + df.observed, th.rgb.cyan, 13);
            _draw_text_crisp(handle, fp, 52, fy + fi * 44 + 18, "-> " + df.decision, th.rgb.text_primary, 12);
            fi = fi + 1;
        }
    }

    // Footer Status Bar
    gfxdrawrects(handle, [UIK.divider_h(0, h - 32, w, 1)], th.rgb.border);
    _draw_text_crisp(handle, fp, 20, h - 24, "Πλήκτρα: [1..4/Tab] Καρτέλες  •  [T] Θέμα  •  [W] Φορτίο  •  [R] Ζωντανή Μέτρηση  •  [Q/Esc] Έξοδος", th.rgb.text_muted, 12);

    gfxpresent(handle);
}

fn _detect_headless_linux() {
    let os_name = Gov.detect_os();
    if os_name != "linux" { return false; }
    let d1 = try env_get("DISPLAY") catch nil;
    if d1 != nil and str_trim(str(d1)) != "" { return false; }
    let d2 = try env_get("WAYLAND_DISPLAY") catch nil;
    if d2 != nil and str_trim(str(d2)) != "" { return false; }
    return true;
}

fn _next_workload(cur) {
    if cur == "ui_studio" { return "ai_infer"; }
    if cur == "ai_infer" { return "compile"; }
    if cur == "compile" { return "batch_data"; }
    return "ui_studio";
}

// Opens the native OS Sovereign Studio window with dirty-flag event-driven rendering.
fn run_native_studio_window(opts = nil) {
    if opts == nil { opts = map{}; }
    let req_w = _max(640, _int_or(try opts.width catch 1080, 1080));
    let req_h = _max(480, _int_or(try opts.height catch 680, 680));
    let headless_ok = _is_true(try opts.headless_ok catch true);
    let max_frames = _int_or(try opts.max_frames catch 0, 0);
    let max_ticks = _int_or(try opts.max_ticks catch 0, 0);

    let hw = try opts.hw_profile catch nil;
    if hw == nil { hw = Gov.discover_hardware(); }
    let workload = str(try opts.workload catch "ui_studio");
    let plan = Gov.plan_execution(workload, hw);

    if _is_true(try opts.force_headless catch false) or (headless_ok and _detect_headless_linux()) {
        return map{
            ok: true,
            mode: "headless_fallback",
            headless: true,
            title: STUDIO_WINDOW_TITLE,
            tabs_count: len(studio_tabs()),
            plan: plan
        };
    }

    let handle = try gfxcreatewindow(req_w, req_h, STUDIO_WINDOW_TITLE) catch nil;
    if handle == nil {
        if headless_ok {
            return map{
                ok: true,
                mode: "headless_fallback",
                headless: true,
                title: STUDIO_WINDOW_TITLE,
                tabs_count: len(studio_tabs()),
                plan: plan
            };
        }
        return error("sovereign_studio_ui: unable to open native graphics window");
    }

    let state = map{
        active_tab: _clamp(_int_or(try opts.initial_tab catch 0, 0), 0, 3),
        dark_mode: not _is_true(try opts.light_mode catch false),
        workload: workload,
        hw: hw,
        plan: plan,
        is_dirty: true,
        hover_id: "",
        rendered_frames: 0,
        skipped_idle_ticks: 0,
        sparkline: [16, 16, 0, 0, 0, 16, 0, 0, 0, 0, 16, 0],
        font_path: _resolve_ui_font_path()
    };

    let last_sz = gfxsize(handle);
    let ticks = 0;
    let running = true;

    while running and gfxisopen(handle) {
        let events = gfxpollevents(handle);
        let cur_sz = gfxsize(handle);
        if _size_changed(last_sz, cur_sz) {
            last_sz = cur_sz;
            state.is_dirty = true;
        }

        let hits = _build_hit_boxes(_max(640, _int_or(try cur_sz.w catch req_w, req_w)));
        let ei = 0;
        while ei < len(events) {
            let ev = events[ei];
            let et = str(try ev.type catch "");
            if et == "close" {
                running = false;
            } else if et == "resize" {
                state.is_dirty = true;
            } else if et == "mousemove" {
                let mx = _int_or(try ev.x catch 0, 0);
                let my = _int_or(try ev.y catch 0, 0);
                let new_hover = "";
                let ti = 0;
                while ti < len(hits.tabs) {
                    if UIK.contains(hits.tabs[ti], mx, my) {
                        new_hover = "tab_" + str(ti);
                    }
                    ti = ti + 1;
                }
                if new_hover != state.hover_id {
                    state.hover_id = new_hover;
                    state.is_dirty = true;
                }
            } else if et == "mousedown" and str(try ev.button catch "") == "Left" {
                let cx = _int_or(try ev.x catch 0, 0);
                let cy = _int_or(try ev.y catch 0, 0);
                let ti = 0;
                while ti < len(hits.tabs) {
                    if UIK.contains(hits.tabs[ti], cx, cy) and state.active_tab != ti {
                        state.active_tab = ti;
                        state.is_dirty = true;
                    }
                    ti = ti + 1;
                }
                if UIK.contains(hits.btn_theme, cx, cy) {
                    state.dark_mode = not state.dark_mode;
                    state.is_dirty = true;
                } else if UIK.contains(hits.btn_work, cx, cy) {
                    state.workload = _next_workload(state.workload);
                    state.plan = Gov.plan_execution(state.workload, state.hw);
                    state.is_dirty = true;
                } else if UIK.contains(hits.btn_refresh, cx, cy) {
                    state.hw = Gov.discover_hardware();
                    state.plan = Gov.plan_execution(state.workload, state.hw);
                    state.is_dirty = true;
                }
            } else if et == "keydown" {
                let k = str_lower(str(try ev.key catch ""));
                if k == "escape" or k == "q" {
                    running = false;
                } else if k == "key1" or k == "num1" or k == "1" {
                    state.active_tab = 0;
                    state.is_dirty = true;
                } else if k == "key2" or k == "num2" or k == "2" {
                    state.active_tab = 1;
                    state.is_dirty = true;
                } else if k == "key3" or k == "num3" or k == "3" {
                    state.active_tab = 2;
                    state.is_dirty = true;
                } else if k == "key4" or k == "num4" or k == "4" {
                    state.active_tab = 3;
                    state.is_dirty = true;
                } else if k == "tab" {
                    state.active_tab = num_mod(state.active_tab + 1, 4);
                    state.is_dirty = true;
                } else if k == "t" {
                    state.dark_mode = not state.dark_mode;
                    state.is_dirty = true;
                } else if k == "w" {
                    state.workload = _next_workload(state.workload);
                    state.plan = Gov.plan_execution(state.workload, state.hw);
                    state.is_dirty = true;
                } else if k == "r" {
                    state.hw = Gov.discover_hardware();
                    state.plan = Gov.plan_execution(state.workload, state.hw);
                    state.is_dirty = true;
                }
            }
            ei = ei + 1;
        }

        if not running { break; }

        let pace = Gov.govern_frame_pace(state.is_dirty, state.hw);
        if pace.render_frame {
            let t0 = try now_ms() catch 0;
            _paint_studio_frame(handle, state);
            let dt = _max(1, (try now_ms() catch t0) - t0);
            state.rendered_frames = state.rendered_frames + 1;
            state.is_dirty = false;
            state.sparkline = slice(state.sparkline, 1, len(state.sparkline));
            array_push(state.sparkline, dt);
        } else {
            state.skipped_idle_ticks = state.skipped_idle_ticks + 1;
            state.sparkline = slice(state.sparkline, 1, len(state.sparkline));
            array_push(state.sparkline, 0);
        }

        ticks = ticks + 1;
        if max_frames > 0 and state.rendered_frames >= max_frames {
            running = false;
        } else if max_ticks > 0 and ticks >= max_ticks {
            running = false;
        } else {
            sleep_ms(pace.sleep_ms);
        }
    }

    try gfxclosewindow(handle) catch (try gfxclose(handle) catch nil);

    return map{
        ok: true,
        mode: "native_window",
        headless: false,
        title: STUDIO_WINDOW_TITLE,
        rendered_frames: state.rendered_frames,
        skipped_idle_ticks: state.skipped_idle_ticks,
        active_tab: state.active_tab,
        plan: state.plan
    };
}

// ── Self-Contained 100% Offline HTML5 + CSS Grid + SVG Studio Dashboard ──────

fn _html_esc(value) {
    let out = str_replace_all(str(value), "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    out = str_replace_all(out, "'", "&#39;");
    return out;
}

fn _svg_radial_gauge(pct_val, label_top, label_sub, stroke_var) {
    let pct = _clamp(pct_val, 0, 100);
    // Circle radius r=44 -> circumference ~ 276.46
    let dash = num_floor((pct * 276.46) / 100);
    return "<svg class=\"gauge-svg\" viewBox=\"0 0 120 120\" role=\"img\" aria-label=\"" + _html_esc(label_top) + "\">"
        + "<circle cx=\"60\" cy=\"60\" r=\"44\" fill=\"none\" stroke=\"var(--track)\" stroke-width=\"10\"/>"
        + "<circle cx=\"60\" cy=\"60\" r=\"44\" fill=\"none\" stroke=\"" + stroke_var + "\" stroke-width=\"10\" "
        + "stroke-linecap=\"round\" stroke-dasharray=\"" + str(dash) + " 277\" transform=\"rotate(-90 60 60)\"/>"
        + "<text x=\"60\" y=\"58\" text-anchor=\"middle\" fill=\"var(--text-primary)\" font-size=\"17\" font-weight=\"700\">" + _html_esc(label_top) + "</text>"
        + "<text x=\"60\" y=\"76\" text-anchor=\"middle\" fill=\"var(--text-muted)\" font-size=\"10\">" + _html_esc(label_sub) + "</text>"
        + "</svg>";
}

fn render_studio_html(hw_profile = nil, plan = nil) {
    let hw = hw_profile;
    if hw == nil { hw = Gov.discover_hardware(); }
    let exec_plan = plan;
    if exec_plan == nil { exec_plan = Gov.plan_execution("ui_studio", hw); }

    let cores = _max(1, _int_or(try hw.cpu.logical_cores catch 1, 1));
    let worker_pct = num_floor((exec_plan.worker_threads * 100) / cores);
    let ram_pct = _clamp(try hw.ram_used_pct catch 50, 0, 100);
    let simd_list = try hw.cpu.simd.extensions catch [];
    let simd_badges = "";
    if len(simd_list) == 0 {
        simd_badges = "<span class=\"pill pill-muted\">scalar</span>";
    } else {
        let si = 0;
        while si < len(simd_list) {
            simd_badges = simd_badges + "<span class=\"pill pill-cyan\">" + _html_esc(simd_list[si]) + "</span> ";
            si = si + 1;
        }
    }

    let gpu_status = "Absent (present: false)";
    if _is_true(try hw.gpu.present catch false) and len(hw.gpus) > 0 {
        gpu_status = "Present — " + str(hw.gpus[0].vendor) + " (" + str(hw.gpus[0].vram_mb) + " MiB VRAM, " + str(hw.gpus[0].render_node) + ")";
    }
    let npu_status = "Absent (present: false — honest probe)";
    if _is_true(try hw.npu.present catch false) {
        npu_status = "Present (" + str(hw.npu.count) + " accelerator node)";
    }
    let tpu_status = "Absent (present: false — honest probe)";
    if _is_true(try hw.tpu.present catch false) {
        tpu_status = "Present (" + str(hw.tpu.count) + " Edge/Cloud TPU)";
    }

    let factor_rows = "";
    let fi = 0;
    while fi < len(exec_plan.decision_factors) {
        let df = exec_plan.decision_factors[fi];
        factor_rows = factor_rows + "<tr><td><code>" + _html_esc(df.factor) + "</code></td><td>"
            + _html_esc(df.observed) + "</td><td class=\"emerald-txt\">" + _html_esc(df.decision) + "</td></tr>";
        fi = fi + 1;
    }

    let frontier_pills = "";
    let fl = frontier_llm_catalog();
    let li = 0;
    while li < len(fl) {
        frontier_pills = frontier_pills + "<span class=\"pill pill-outline\">" + _html_esc(fl[li]) + "</span> ";
        li = li + 1;
    }

    let live_json = json_stringify(map{
        cores: cores,
        ram_total_mb: hw.ram_total_mb,
        ram_available_mb: hw.ram_available_mb,
        ram_used_pct: ram_pct,
        pressure_tier: hw.pressure_tier,
        power_mode: hw.power_mode,
        route: exec_plan.accelerator_route,
        chain: exec_plan.fallback_chain,
        sovereign_binary_kb: SOVEREIGN_BINARY_KB,
        legacy_binary_kb: LEGACY_BINARY_KB,
        reduction_pct: BINARY_REDUCTION_PCT
    });

    let parts = [
        "<!DOCTYPE html>\n<html lang=\"el\" data-theme=\"dark\" data-lang=\"both\">\n<head>\n",
        "<meta charset=\"utf-8\">\n",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n",
        "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\">\n",
        "<title>PBLang 2.0 Sovereign Studio — Zero-Rust &amp; Explainable Governor</title>\n",
        "<style>\n",
        ":root,[data-theme='dark']{--bg:#0B0F14;--header:#0E141C;--surface:#121922;--surface-alt:#18222E;--border:#283A4E;--text-primary:#F2F7FC;--text-secondary:#BCCEDE;--text-muted:#92A8BE;--emerald:#10E59B;--emerald-bg:rgba(16,229,155,0.13);--cyan:#22D3EE;--cyan-bg:rgba(34,211,238,0.13);--amber:#FBBF24;--coral:#FB7185;--track:#1C2734;}\n",
        "[data-theme='light']{--bg:#F4F8FC;--header:#EAF1F8;--surface:#FFFFFF;--surface-alt:#EEF4FA;--border:#BACCDE;--text-primary:#0B131E;--text-secondary:#1C2E42;--text-muted:#344C66;--emerald:#047857;--emerald-bg:rgba(4,120,87,0.12);--cyan:#0E7490;--cyan-bg:rgba(14,116,144,0.12);--amber:#B45309;--coral:#BE123C;--track:#D8E4F0;}\n",
        "*{box-sizing:border-box;margin:0;padding:0}\n",
        "body{background:var(--bg);color:var(--text-primary);font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Noto Sans',Ubuntu,sans-serif;line-height:1.55;min-height:100vh;display:flex;flex-direction:column}\n",
        "code,pre,.mono{font-family:'JetBrains Mono','Fira Code',ui-monospace,monospace}\n",
        "[data-lang='el'] .lang-en{display:none}[data-lang='en'] .lang-el{display:none}\n",
        "header{background:var(--header);border-bottom:1px solid var(--border);padding:16px 28px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px}\n",
        ".brand-title{font-size:1.28rem;font-weight:800;letter-spacing:-0.02em;color:var(--emerald)}\n",
        ".brand-sub{font-size:0.82rem;color:var(--text-muted)}\n",
        ".toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n",
        "button,select{background:var(--surface-alt);color:var(--text-primary);border:1px solid var(--border);border-radius:8px;padding:7px 13px;font-size:0.84rem;font-weight:600;cursor:pointer}\n",
        "button:hover,select:hover{border-color:var(--emerald)}\n",
        ".tabs{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;padding:16px 28px 0}\n",
        ".tab-btn{text-align:left;padding:11px 14px;border-radius:10px;background:var(--surface);border:1px solid var(--border);color:var(--text-secondary);transition:all .15s}\n",
        ".tab-btn.active{background:var(--surface-alt);color:var(--emerald);border-color:var(--emerald);box-shadow:inset 0 -3px 0 var(--emerald)}\n",
        "main{padding:20px 28px 36px;max-width:1440px;width:100%;margin:0 auto;flex:1}\n",
        ".tab-panel{display:none;animation:fadeIn .16s ease-out}.tab-panel.active{display:block}\n",
        "@keyframes fadeIn{from{opacity:.4;transform:translateY(3px)}to{opacity:1;transform:none}}\n",
        ".grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-bottom:18px}\n",
        ".grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:18px;margin-bottom:18px}\n",
        ".card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px}\n",
        ".card h3{font-size:0.98rem;margin-bottom:10px;color:var(--text-primary)}\n",
        ".kpi-row{display:flex;align-items:center;justify-content:space-between;gap:12px}\n",
        ".gauge-svg{width:96px;height:96px;flex-shrink:0}\n",
        ".pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:0.76rem;font-weight:700;margin:2px}\n",
        ".pill-emerald{background:var(--emerald-bg);color:var(--emerald)}\n",
        ".pill-cyan{background:var(--cyan-bg);color:var(--cyan)}\n",
        ".pill-outline{border:1px solid var(--border);color:var(--text-secondary)}\n",
        ".pill-muted{background:var(--surface-alt);color:var(--text-muted)}\n",
        ".bar-wrap{margin:10px 0}.bar-track{height:12px;background:var(--track);border-radius:999px;overflow:hidden}\n",
        ".bar-fill{height:100%;border-radius:999px}\n",
        "table{width:100%;border-collapse:collapse;font-size:0.86rem;margin-top:8px}\n",
        "th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--border)}\n",
        "th{color:var(--text-muted);font-weight:600}\n",
        ".emerald-txt{color:var(--emerald);font-weight:700}\n",
        ".explain-box{background:var(--surface-alt);border-left:4px solid var(--emerald);padding:14px 16px;border-radius:8px;margin-top:10px;font-size:0.9rem}\n",
        "footer{border-top:1px solid var(--border);padding:12px 28px;font-size:0.78rem;color:var(--text-muted);display:flex;justify-content:space-between;flex-wrap:wrap}\n",
        "</style>\n</head>\n<body>\n",
        "<header>\n",
        "  <div>\n",
        "    <div class=\"brand-title\">PBLang 2.0 Sovereign Studio</div>\n",
        "    <div class=\"brand-sub\"><span class=\"lang-el\">Μηδενικό Rust • Έξυπνος Κυβερνήτης Υλικού • 100% Τοπική Ιδιωτικότητα (WCAG AAA)</span> <span class=\"lang-en\">Zero-Rust Architecture • Smart Hardware Governor • 100% Offline Privacy</span></div>\n",
        "  </div>\n",
        "  <div class=\"toolbar\">\n",
        "    <button type=\"button\" id=\"themeToggle\" onclick=\"toggleTheme()\">Theme: Obsidian Dark</button>\n",
        "    <button type=\"button\" id=\"langToggle\" onclick=\"cycleLang()\">Γλώσσα / Lang: EL+EN</button>\n",
        "  </div>\n",
        "</header>\n",
        "<nav class=\"tabs\" aria-label=\"Sovereign Studio Sections\">\n",
        "  <button type=\"button\" class=\"tab-btn active\" onclick=\"selectTab(0)\">1. Επισκόπηση (Sovereign Overview)</button>\n",
        "  <button type=\"button\" class=\"tab-btn\" onclick=\"selectTab(1)\">2. Υλικό &amp; Επιταχυντές (CPU/GPU/NPU/TPU)</button>\n",
        "  <button type=\"button\" class=\"tab-btn\" onclick=\"selectTab(2)\">3. Μεταγλωττιστές (Zero-Rust &amp; Path B Native)</button>\n",
        "  <button type=\"button\" class=\"tab-btn\" onclick=\"selectTab(3)\">4. Εξηγησιμότητα &amp; Πόροι (Explainable Governor)</button>\n",
        "</nav>\n",
        "<main>\n",
        "  <section id=\"panel-0\" class=\"tab-panel active\">\n",
        "    <div class=\"grid-4\">\n",
        "      <div class=\"card kpi-row\"><div><h3><span class=\"lang-el\">Μνήμη RAM</span> <span class=\"lang-en\">RAM Pressure</span></h3><p class=\"mono\">" + str(hw.ram_available_mb) + " / " + str(hw.ram_total_mb) + " MiB free</p><span class=\"pill pill-emerald\">" + _html_esc(hw.pressure_tier) + "</span></div>" + _svg_radial_gauge(ram_pct, str(ram_pct) + "%", "RAM Used", "var(--cyan)") + "</div>\n",
        "      <div class=\"card kpi-row\"><div><h3><span class=\"lang-el\">Νήματα Εργασίας</span> <span class=\"lang-en\">CPU Workers</span></h3><p class=\"mono\">" + str(exec_plan.worker_threads) + " / " + str(cores) + " cores</p><span class=\"pill pill-cyan\">" + _html_esc(hw.cpu.arch) + "</span></div>" + _svg_radial_gauge(worker_pct, str(exec_plan.worker_threads) + "T", "of " + str(cores) + "C", "var(--emerald)") + "</div>\n",
        "      <div class=\"card kpi-row\"><div><h3><span class=\"lang-el\">Μέγεθος Εκτελέσιμου</span> <span class=\"lang-en\">Binary Size</span></h3><p class=\"mono\">320 KB vs 42,000 KB</p><span class=\"pill pill-emerald\">-99.2% reduction</span></div>" + _svg_radial_gauge(99, "-99.2%", "320 KB ELF", "var(--emerald)") + "</div>\n",
        "      <div class=\"card\"><h3><span class=\"lang-el\">Ρυθμός Zero-Idle UI</span> <span class=\"lang-en\">Zero-Idle UI Governor</span></h3><p class=\"mono emerald-txt\">~0.0% Idle CPU (" + str(exec_plan.idle_sleep_ms) + " ms sleep)</p><p style=\"font-size:0.84rem;color:var(--text-secondary);margin-top:6px\">Active Cap: " + str(exec_plan.ui_fps_cap) + " FPS • Power: <code>" + _html_esc(hw.power_mode) + "</code></p><svg viewBox=\"0 0 220 44\" style=\"width:100%;height:42px;margin-top:8px\"><polyline fill=\"none\" stroke=\"var(--emerald)\" stroke-width=\"2.5\" points=\"4,36 30,36 56,10 82,36 108,36 134,36 160,12 186,36 214,36\"/></svg></div>\n",
        "    </div>\n",
        "    <div class=\"grid-2\">\n",
        "      <div class=\"card\"><h3><span class=\"lang-el\">Κυρίαρχη Τοπική Εκτέλεση &amp; Σύγκριση Frontier ΤΝ</span> <span class=\"lang-en\">Sovereign Local Execution &amp; Frontier Cloud Reference</span></h3><p style=\"color:var(--text-secondary);font-size:0.9rem;margin-bottom:10px\"><span class=\"lang-el\">Το PBLang 2.0 εκτελείται 100% τοπικά στη συσκευή σας (διαδρομή: <b>" + _html_esc(exec_plan.accelerator_route) + "</b>) χωρίς εξωτερικές συνδέσεις. Για υβριδικές ροές εργασίας υποστηρίζεται προαιρετική δρομολόγηση αποκλειστικά προς τα κορυφαία τωρινά μοντέλα ΤΝ:</span> <span class=\"lang-en\">PBLang 2.0 executes 100% locally via <b>" + _html_esc(exec_plan.accelerator_route) + "</b> with zero external network calls, while supporting optional hybrid routing to current frontier cloud reasoning models:</span></p><div>" + frontier_pills + "</div></div>\n",
        "      <div class=\"card\"><h3><span class=\"lang-el\">Σύνοψη Προϋπολογισμού Πόρων</span> <span class=\"lang-en\">Active Resource Budget Summary</span></h3><table><tr><th>Metric</th><th>Value</th></tr><tr><td>GC Watermark</td><td class=\"mono\">" + str(exec_plan.gc_watermark_mb) + " MiB</td></tr><tr><td>Sparse Hive LRU Cells</td><td class=\"mono\">" + str(exec_plan.sparse_hive_lru_cells) + " cells</td></tr><tr><td>Max Heap Safety Budget</td><td class=\"mono\">" + str(exec_plan.max_heap_budget_mb) + " MiB</td></tr><tr><td>Fallback Chain</td><td class=\"mono\">" + _html_esc(str_join(exec_plan.fallback_chain, " -> ")) + "</td></tr></table></div>\n",
        "    </div>\n",
        "  </section>\n",
        "  <section id=\"panel-1\" class=\"tab-panel\">\n",
        "    <div class=\"grid-2\">\n",
        "      <div class=\"card\"><h3>CPU, ISA/SIMD &amp; Thermal Telemetry</h3><table><tr><td>Model</td><td>" + _html_esc(hw.cpu.model_name) + "</td></tr><tr><td>Logical Cores / Arch</td><td class=\"mono\">" + str(cores) + " / " + _html_esc(hw.cpu.arch) + "</td></tr><tr><td>Governor / Live Freq</td><td class=\"mono\">" + _html_esc(hw.cpu.governor) + " @ " + str(hw.cpu.cur_freq_khz) + " kHz</td></tr><tr><td>SIMD Vector Extensions</td><td>" + simd_badges + "</td></tr><tr><td>Power &amp; Thermal</td><td class=\"mono\">" + _html_esc(hw.power_mode) + " (throttled=" + str(hw.power.thermal_throttled) + ")</td></tr></table></div>\n",
        "      <div class=\"card\"><h3>GPU, NPU, TPU &amp; Edge Peripherals (Zero Fake Numbers)</h3><table><tr><td>GPU Fabric</td><td>" + _html_esc(gpu_status) + "</td></tr><tr><td>NPU Accelerator</td><td>" + _html_esc(npu_status) + "</td></tr><tr><td>TPU Accelerator</td><td>" + _html_esc(tpu_status) + "</td></tr><tr><td>Storage Block Media</td><td class=\"mono\">" + str(hw.storage.count) + " drives (" + str(hw.storage.total_gb) + " GB, NVMe=" + str(hw.storage.has_nvme) + ", SSD=" + str(hw.storage.has_ssd) + ")</td></tr><tr><td>Edge I/O Nodes</td><td class=\"mono\">Serial=" + str(len(hw.peripherals.serial_mcu)) + " I2C=" + str(len(hw.peripherals.i2c)) + " SPI=" + str(len(hw.peripherals.spi)) + " V4L2=" + str(len(hw.peripherals.cameras)) + " ALSA=" + str(len(hw.peripherals.audio_pcm)) + "</td></tr></table></div>\n",
        "    </div>\n",
        "  </section>\n",
        "  <section id=\"panel-2\" class=\"tab-panel\">\n",
        "    <div class=\"card\"><h3><span class=\"lang-el\">Μεταγλωττιστές Zero-Rust &amp; Path B Native Machine Code (320 KB vs 42,000 KB)</span> <span class=\"lang-en\">Zero-Rust &amp; Path B Native Compilers (99.2% Footprint Reduction)</span></h3>\n",
        "      <div class=\"bar-wrap\"><div style=\"display:flex;justify-content:space-between;font-size:0.86rem;margin-bottom:4px\"><span><b>PBLang 2.0 Sovereign Native / C99 Zero-Rust VM</b> (0 Rust symbols)</span><span class=\"emerald-txt mono\">320 KB (-99.2%)</span></div><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:2.5%;background:var(--emerald)\"></div></div></div>\n",
        "      <div class=\"bar-wrap\" style=\"margin-top:16px\"><div style=\"display:flex;justify-content:space-between;font-size:0.86rem;margin-bottom:4px\"><span>Legacy Monolithic Compiler Binary</span><span class=\"mono\" style=\"color:var(--coral)\">42,000 KB (100%)</span></div><div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:100%;background:var(--coral)\"></div></div></div>\n",
        "      <table style=\"margin-top:18px\"><tr><th>Pipeline Stage</th><th>Artifact</th><th>Verification</th></tr><tr><td>Self-Hosted Frontend</td><td class=\"mono\">.sapp -&gt; .pbck v1</td><td><span class=\"pill pill-emerald\">Deterministic</span></td></tr><tr><td>Stage-3 Zero-Rust Host VM</td><td class=\"mono\">C99 Stack/Closure/GC VM</td><td><span class=\"pill pill-emerald\">0 Rust Symbols (nm)</span></td></tr><tr><td>Path B Direct Native Codegen</td><td class=\"mono\">ELF64 / PE64 (x86_64 &amp; aarch64)</td><td><span class=\"pill pill-cyan\">Zero External Linker</span></td></tr></table>\n",
        "    </div>\n",
        "  </section>\n",
        "  <section id=\"panel-3\" class=\"tab-panel\">\n",
        "    <div class=\"grid-2\">\n",
        "      <div class=\"card\"><h3><span class=\"lang-el\">Διαδραστικός Προσομοιωτής Συσκευών &amp; Φορτίων</span> <span class=\"lang-en\">Interactive Multi-Device Workload Simulator</span></h3>\n",
        "        <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin:12px 0\">\n",
        "          <select id=\"simDevice\" onchange=\"runSim()\"><option value=\"live\">Live Detected Machine</option><option value=\"sbc2g\">2 GB Edge SBC (Battery Constrained)</option><option value=\"laptop4g\">4 GB Low-Power Laptop</option><option value=\"ws32g\">32 GB Workstation (GPU + NPU)</option></select>\n",
        "          <select id=\"simTask\" onchange=\"runSim()\"><option value=\"ui_studio\">UI Studio</option><option value=\"ai_infer\">AI Inference</option><option value=\"compile\">Native Compile</option><option value=\"micro_io\">Micro Edge I/O</option></select>\n",
        "        </div>\n",
        "        <div id=\"simMetrics\" class=\"mono\" style=\"font-size:0.88rem;padding:10px;background:var(--surface-alt);border-radius:8px\"></div>\n",
        "        <div id=\"simExplainEl\" class=\"explain-box lang-el\">" + _html_esc(exec_plan.explanation_el) + "</div>\n",
        "        <div id=\"simExplainEn\" class=\"explain-box lang-en\">" + _html_esc(exec_plan.explanation_en) + "</div>\n",
        "      </div>\n",
        "      <div class=\"card\"><h3><span class=\"lang-el\">Παράγοντες Απόφασης Κυβερνήτη</span> <span class=\"lang-en\">Explainable Governor Decision Trace</span></h3><table><thead><tr><th>Factor</th><th>Observed</th><th>Decision</th></tr></thead><tbody>" + factor_rows + "</tbody></table></div>\n",
        "    </div>\n",
        "  </section>\n",
        "</main>\n",
        "<footer><span>PBLang v" + STUDIO_VERSION + " Sovereign Studio • 100% Offline Self-Contained HTML5</span><span>Zero External CDNs • Zero Idle Polling</span></footer>\n",
        "<script>\n",
        "const LIVE_HW = " + live_json + ";\n",
        "function selectTab(idx){const bs=document.querySelectorAll('.tab-btn'),ps=document.querySelectorAll('.tab-panel');bs.forEach((b,i)=>b.classList.toggle('active',i===idx));ps.forEach((p,i)=>p.classList.toggle('active',i===idx));}\n",
        "function toggleTheme(){const r=document.documentElement,nx=r.getAttribute('data-theme')==='dark'?'light':'dark';r.setAttribute('data-theme',nx);document.getElementById('themeToggle').textContent='Theme: '+(nx==='dark'?'Obsidian Dark':'Alabaster Light');}\n",
        "function cycleLang(){const r=document.documentElement,order=['both','el','en'],cur=r.getAttribute('data-lang')||'both',nx=order[(order.indexOf(cur)+1)%3];r.setAttribute('data-lang',nx);document.getElementById('langToggle').textContent='Γλώσσα / Lang: '+nx.toUpperCase();}\n",
        "function runSim(){const dev=document.getElementById('simDevice').value,task=document.getElementById('simTask').value;let d={cores:LIVE_HW.cores,ram:LIVE_HW.ram_total_mb,tier:LIVE_HW.pressure_tier,pmode:LIVE_HW.power_mode,route:LIVE_HW.route};if(dev==='sbc2g')d={cores:4,ram:2048,tier:'constrained',pmode:'battery_eco',route:'cpu-neon'};if(dev==='laptop4g')d={cores:4,ram:4096,tier:'balanced',pmode:'battery_eco',route:'cpu-avx2'};if(dev==='ws32g')d={cores:16,ram:32768,tier:'optimal',pmode:'desktop_steady',route:'npu'};let w=Math.max(1,d.cores-1);if(task==='micro_io'||d.tier==='critical'||(d.pmode==='battery_eco'&&d.ram<=2560))w=1;else if(d.pmode==='battery_eco'||d.tier==='constrained')w=Math.max(1,Math.floor(d.cores/2));else if(d.ram<=4608)w=Math.min(w,3);let gc=d.ram<=4608||d.tier==='constrained'?2:(d.ram<=12288?4:(d.ram<=24576?8:16));let fps=d.pmode==='battery_eco'?30:60;let slp=d.pmode==='battery_eco'?40:25;document.getElementById('simMetrics').textContent='workers='+w+' | gc_watermark_mb='+gc+' MiB | sparse_hive_lru_cells='+gc+' | route='+d.route+' | ui_fps_cap='+fps+' FPS | idle_sleep_ms='+slp+' ms';document.getElementById('simExplainEl').textContent='Προσομοίωση ['+dev+' / '+task+']: Επιλέχθηκαν '+w+' νήματα, όριο GC '+gc+' MiB, διαδρομή '+d.route+' και ρυθμός '+fps+' FPS ('+slp+' ms ύπνος αδράνειας για ~0.0% CPU).';document.getElementById('simExplainEn').textContent='Simulation ['+dev+' / '+task+']: Selected '+w+' worker threads, '+gc+' MiB GC watermark, '+d.route+' accelerator route, and '+fps+' FPS cap ('+slp+' ms idle sleep for ~0.0% CPU).';}\n",
        "runSim();\n",
        "</script>\n</body>\n</html>\n"
    ];

    return str_join(parts, "");
}

fn export_studio_html(out_path, hw_profile = nil, plan = nil) {
    let html = render_studio_html(hw_profile, plan);
    fs_write(out_path, html);
    return map{
        ok: true,
        path: out_path,
        bytes: len(str_to_bytes(html)),
        offline_self_contained: true
    };
}

export STUDIO_VERSION, STUDIO_WINDOW_TITLE, SOVEREIGN_BINARY_KB, LEGACY_BINARY_KB, BINARY_REDUCTION_PCT,
       theme_dark, theme_light, studio_tabs, frontier_llm_catalog,
       run_native_studio_window, render_studio_html, export_studio_html;
