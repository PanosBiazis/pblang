// stdlib/gpu3d_host.sapp — polyglot host codegen for the 3D pipeline (gpu2d_host analog).
//
// Emits Rust/wgpu, C/OpenGL, Python/moderngl, JS/WebGPU glue that uploads gpu3d's 40-byte
// mesh buffer + an MVP matrix uniform (mat4.to_f32) and draws the mesh. Attributes are
// derived from gpu3d.vertex_layout(), the shaders from gpu3d.wgsl/glsl_*. Codegen only —
// returns strings; run guarded via polyglot_policy where a GPU + toolchain exists.

let G3 = import("stdlib:gpu3d.sapp");

fn targets() { return ["rust-wgpu", "c-opengl", "python-moderngl", "js-webgpu"]; }

fn _wgpu_attrs() {
    let vl = G3.vertex_layout();
    let lines = [];
    let i = 0;
    while i < len(vl.attributes) {
        let a = vl.attributes[i];
        let f = "wgpu::VertexFormat::Float32x3";
        if a.floats == 4 { f = "wgpu::VertexFormat::Float32x4"; }
        array_push(lines, "            wgpu::VertexAttribute { format: " + f +
            ", offset: " + str(a.offset) + ", shader_location: " + str(a.location) + " },");
        i = i + 1;
    }
    return str_join(lines, "\n");
}
fn emit_rust_wgpu() {
    let L = [
        "// gpu3d host — Rust / wgpu (generated by pblang stdlib/gpu3d_host.sapp).",
        "// Upload gpu3d.to_vertex_f32(mesh) as the vertex buffer; set U.mvp = mat4.to_f32(mvp).",
        "pub const SHADER: &str = r#\"",
        G3.wgsl(),
        "\"#;",
        "pub fn vertex_layout() -> wgpu::VertexBufferLayout<'static> {",
        "    wgpu::VertexBufferLayout { array_stride: 40, step_mode: wgpu::VertexStepMode::Vertex,",
        "        attributes: &[",
        _wgpu_attrs(),
        "        ] }",
        "}",
        "pub fn build(device: &wgpu::Device, fmt: wgpu::TextureFormat) -> wgpu::RenderPipeline {",
        "    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {",
        "        label: Some(\"gpu3d\"), source: wgpu::ShaderSource::Wgsl(SHADER.into()) });",
        "    device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {",
        "        label: Some(\"gpu3d\"), layout: None,",
        "        vertex: wgpu::VertexState { module: &module, entry_point: \"vs_main\", buffers: &[vertex_layout()] },",
        "        fragment: Some(wgpu::FragmentState { module: &module, entry_point: \"fs_main\", targets: &[Some(fmt.into())] }),",
        "        primitive: wgpu::PrimitiveState { cull_mode: Some(wgpu::Face::Back), ..Default::default() },",
        "        depth_stencil: None, multisample: wgpu::MultisampleState::default(), multiview: None })",
        "}",
        "pub fn draw<'a>(pass: &mut wgpu::RenderPass<'a>, pipe: &'a wgpu::RenderPipeline, verts: &'a wgpu::Buffer, count: u32) {",
        "    pass.set_pipeline(pipe); pass.set_vertex_buffer(0, verts.slice(..)); pass.draw(0..count, 0..1);",
        "}"
    ];
    return str_join(L, "\n");
}

fn _c_str(src) { return "\"" + str_replace_all(str_replace_all(src, "\"", "\\\""), "\n", "\\n\"\n\"") + "\""; }
fn emit_c_opengl() {
    let L = [
        "/* gpu3d host — C / OpenGL 3.3 (generated by pblang stdlib/gpu3d_host.sapp). */",
        "#include <GL/glew.h>",
        "static const char* VS = ",
        _c_str(G3.glsl_vertex()),
        ";",
        "static const char* FS = ",
        _c_str(G3.glsl_fragment()),
        ";",
        "static GLuint compile(GLenum t, const char* s){ GLuint x=glCreateShader(t); glShaderSource(x,1,&s,0); glCompileShader(x); return x; }",
        "GLuint gpu3d_program(void){ GLuint p=glCreateProgram(); glAttachShader(p,compile(GL_VERTEX_SHADER,VS)); glAttachShader(p,compile(GL_FRAGMENT_SHADER,FS)); glLinkProgram(p); return p; }",
        "void gpu3d_set_mvp(GLuint prog, const float* mvp){ glUniformMatrix4fv(glGetUniformLocation(prog,\"u_mvp\"), 1, GL_FALSE, mvp); }",
        "void gpu3d_setup_attribs(void){",
        "    glEnableVertexAttribArray(0); glVertexAttribPointer(0,3,GL_FLOAT,GL_FALSE,40,(void*)0);",
        "    glEnableVertexAttribArray(1); glVertexAttribPointer(1,3,GL_FLOAT,GL_FALSE,40,(void*)12);",
        "    glEnableVertexAttribArray(2); glVertexAttribPointer(2,4,GL_FLOAT,GL_FALSE,40,(void*)24);",
        "}",
        "void gpu3d_draw(int count){ glDrawArrays(GL_TRIANGLES, 0, count); }"
    ];
    return str_join(L, "\n");
}

fn emit_python_moderngl() {
    let L = [
        "# gpu3d host — Python / moderngl (generated by pblang stdlib/gpu3d_host.sapp).",
        "import moderngl, struct",
        "VERTEX = '''",
        G3.glsl_vertex(),
        "'''",
        "FRAGMENT = '''",
        G3.glsl_fragment(),
        "'''",
        "def build(ctx, vbytes, mvp16, light3):",
        "    prog = ctx.program(vertex_shader=VERTEX, fragment_shader=FRAGMENT)",
        "    prog['u_mvp'].write(struct.pack('16f', *mvp16))",
        "    prog['u_light'].value = light3",
        "    vbo = ctx.buffer(vbytes)",
        "    vao = ctx.vertex_array(prog, [(vbo, '3f 3f 4f', 'i_pos', 'i_normal', 'i_color')])",
        "    return prog, vao",
        "def draw(vao, count):",
        "    vao.render(mode=moderngl.TRIANGLES, vertices=count)"
    ];
    return str_join(L, "\n");
}

fn emit_js_webgpu() {
    let L = [
        "// gpu3d host — JS / WebGPU (generated by pblang stdlib/gpu3d_host.sapp).",
        "export const SHADER = `",
        G3.wgsl(),
        "`;",
        "export function build(device, format) {",
        "  const module = device.createShaderModule({ code: SHADER });",
        "  return device.createRenderPipeline({ layout: 'auto',",
        "    vertex: { module, entryPoint: 'vs_main', buffers: [{ arrayStride: 40, attributes: [",
        "      { shaderLocation: 0, offset: 0, format: 'float32x3' },",
        "      { shaderLocation: 1, offset: 12, format: 'float32x3' },",
        "      { shaderLocation: 2, offset: 24, format: 'float32x4' } ] }] },",
        "    fragment: { module, entryPoint: 'fs_main', targets: [{ format }] },",
        "    primitive: { topology: 'triangle-list', cullMode: 'back' },",
        "    depthStencil: { format: 'depth24plus', depthWriteEnabled: true, depthCompare: 'less' } });",
        "}"
    ];
    return str_join(L, "\n");
}

fn emit(target) {
    if target == "rust-wgpu" { return emit_rust_wgpu(); }
    if target == "c-opengl" { return emit_c_opengl(); }
    if target == "python-moderngl" { return emit_python_moderngl(); }
    if target == "js-webgpu" { return emit_js_webgpu(); }
    throw "gpu3d_host: unknown target '" + str(target) + "'";
}

export targets, emit, emit_rust_wgpu, emit_c_opengl, emit_python_moderngl, emit_js_webgpu;
