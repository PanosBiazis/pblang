let Tables=import("stdlib:table_files.sapp");let I=import("stdlib:interpolation_table.sapp");
fn open(samples_path,queries_path,delimiter=","){let samples=Tables.open(samples_path,delimiter);if not samples.ok{return samples;}let queries=Tables.open(queries_path,delimiter);if not queries.ok{return queries;}let r=try I.create(samples.document,queries.document) catch nil;if r==nil{return map{ok:false,error:"Expected increasing X,Value samples and in-range Query rows; numeric and table limits apply."};}return map{ok:true,report:r};}
fn save(path,report,delimiter=","){if type(path)!="string" or type(report)!="map" or not map_has(report,"document"){return map{ok:false,error:"Choose a new output and calculate first."};}return Tables.save(path,report.document,if str_ends_with(str_lower(path),".pbsheet"){"sheet"}else{"csv"},delimiter);}
fn run(samples_path,queries_path,output,delimiter=","){let result=open(samples_path,queries_path,delimiter);if not result.ok{return result;}return save(output,result.report,delimiter);}
export open,save,run;
