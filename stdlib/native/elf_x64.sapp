// elf_x64.sapp — pblang emits a runnable Linux x86-64 executable as RAW MACHINE CODE.
// No C, no assembler, no linker, no other language: pblang writes the ELF bytes itself.
// This is the foundational proof that pblang can target the machine directly.

// Append the low `n` bytes of integer `v` to byte array `a` (little-endian).
fn le(a, v, n) {
    let i = 0;
    while i < n {
        let b = v % 256;
        if b < 0 { b = b + 256; }        // two's-complement: a negative immediate encodes as unsigned bytes
        push(a, b);
        v = (v - b) / 256;
        i = i + 1;
    }
}

// Build a static ELF64 executable whose entry does: write(1, msg, len); exit(code).
// Returns the whole file as a byte array (0..255 numbers).
fn emit_write_exit(msg, code) {
    let VBASE = 4194304;          // 0x400000 load address
    let EHSIZE = 64;              // ELF header size
    let PHSIZE = 56;              // one program header
    let code_off = EHSIZE + PHSIZE;   // 120 (0x78): where machine code begins

    // ---- machine code (x86-64 Linux syscall ABI: rax=nr, rdi,rsi,rdx=args) ----
    let text = [];
    push(text, 184); le(text, 1, 4);        // mov eax, 1          (sys_write)
    push(text, 191); le(text, 1, 4);        // mov edi, 1          (fd = stdout)
    push(text, 72); push(text, 190);        // movabs rsi, imm64   (message addr)
    let rsi_at = len(text);
    le(text, 0, 8);                          //   placeholder addr, patched below
    push(text, 186); le(text, len(msg), 4); // mov edx, len        (byte count)
    push(text, 15); push(text, 5);          // syscall
    push(text, 184); le(text, 60, 4);       // mov eax, 60         (sys_exit)
    push(text, 191); le(text, code, 4);     // mov edi, code       (exit status)
    push(text, 15); push(text, 5);          // syscall

    let code_len = len(text);
    let msg_off = code_off + code_len;
    let msg_vaddr = VBASE + msg_off;

    // patch the movabs with the real message virtual address (8 bytes, little-endian)
    let v = msg_vaddr;
    let k = 0;
    while k < 8 { let b = v % 256; text[rsi_at + k] = b; v = (v - b) / 256; k = k + 1; }

    let total = code_off + code_len + len(msg);
    let entry = VBASE + code_off;

    // ---- ELF header (64 bytes) ----
    let f = [];
    push(f, 127); push(f, 69); push(f, 76); push(f, 70);  // 0x7F 'E' 'L' 'F'
    push(f, 2); push(f, 1); push(f, 1); push(f, 0);       // 64-bit, LE, v1, SysV
    let z = 0; while z < 8 { push(f, 0); z = z + 1; }     // pad e_ident to 16
    le(f, 2, 2);        // e_type    = ET_EXEC
    le(f, 62, 2);       // e_machine = EM_X86_64
    le(f, 1, 4);        // e_version
    le(f, entry, 8);    // e_entry
    le(f, EHSIZE, 8);   // e_phoff (program header right after ELF header)
    le(f, 0, 8);        // e_shoff (no sections)
    le(f, 0, 4);        // e_flags
    le(f, EHSIZE, 2);   // e_ehsize
    le(f, PHSIZE, 2);   // e_phentsize
    le(f, 1, 2);        // e_phnum
    le(f, 0, 2);        // e_shentsize
    le(f, 0, 2);        // e_shnum
    le(f, 0, 2);        // e_shstrndx

    // ---- program header (56 bytes): one R+X PT_LOAD covering the whole file ----
    le(f, 1, 4);        // p_type  = PT_LOAD
    le(f, 5, 4);        // p_flags = R + X
    le(f, 0, 8);        // p_offset
    le(f, VBASE, 8);    // p_vaddr
    le(f, VBASE, 8);    // p_paddr
    le(f, total, 8);    // p_filesz
    le(f, total, 8);    // p_memsz
    le(f, 4096, 8);     // p_align

    // ---- machine code + message bytes ----
    let i = 0; while i < len(text) { push(f, text[i]); i = i + 1; }
    let j = 0; while j < len(msg) { push(f, strcharcodeat(msg, j)); j = j + 1; }
    return f;
}

// wrap_elf(text) — wrap an already-assembled x86-64 code byte array (entry at its
// start) in a minimal static ELF64 executable. Returns the whole file as bytes.
fn wrap_elf(text) {
    let VBASE = 4194304;
    let EHSIZE = 64;
    let PHSIZE = 56;
    let code_off = EHSIZE + PHSIZE;
    let total = code_off + len(text);
    let entry = VBASE + code_off;
    let f = [];
    push(f, 127); push(f, 69); push(f, 76); push(f, 70);
    push(f, 2); push(f, 1); push(f, 1); push(f, 0);
    let z = 0; while z < 8 { push(f, 0); z = z + 1; }
    le(f, 2, 2); le(f, 62, 2); le(f, 1, 4); le(f, entry, 8);
    le(f, EHSIZE, 8); le(f, 0, 8); le(f, 0, 4);
    le(f, EHSIZE, 2); le(f, PHSIZE, 2); le(f, 1, 2);
    le(f, 0, 2); le(f, 0, 2); le(f, 0, 2);
    le(f, 1, 4); le(f, 5, 4); le(f, 0, 8);
    le(f, VBASE, 8); le(f, VBASE, 8);
    le(f, total, 8); le(f, total, 8); le(f, 4096, 8);
    let i = 0; while i < len(text) { push(f, text[i]); i = i + 1; }
    return f;
}

// emit_sum_loop(n) — REAL compute + control flow in raw x86-64: sum 1..n in a
// loop, then exit(sum). Demonstrates a loop, comparison, conditional/uncond jumps,
// and integer arithmetic emitted as machine code (n must be < 128 for the imm8).
// The whole program runs at native CPU speed — the seed of a pblang code generator.
fn emit_sum_loop(n) {
    let t = [];
    push(t, 49); push(t, 192);                   // xor eax, eax        sum = 0
    push(t, 185); le(t, 1, 4);                    // mov ecx, 1          i = 1
    // .loop (offset 7):
    push(t, 131); push(t, 249); push(t, n);       // cmp ecx, n          (83 F9 ib)
    push(t, 127); push(t, 6);                     // jg .done  (+6)      (7F 06)
    push(t, 1); push(t, 200);                     // add eax, ecx        sum += i
    push(t, 255); push(t, 193);                   // inc ecx             i++
    push(t, 235); push(t, 245);                   // jmp .loop (-11)     (EB F5)
    // .done (offset 18):
    push(t, 137); push(t, 199);                   // mov edi, eax        status = sum
    push(t, 184); le(t, 60, 4);                   // mov eax, 60         sys_exit
    push(t, 15); push(t, 5);                      // syscall
    return wrap_elf(t);
}

export le, emit_write_exit, wrap_elf, emit_sum_loop;
