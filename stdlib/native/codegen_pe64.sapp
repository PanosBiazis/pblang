    push(code, 76); push(code, 137); push(code, 240);                         // rax = i
    push(code, 65); push(code, 94); push(code, 65); push(code, 93); push(code, 65); push(code, 92); push(code, 91); push(code, 195);
    _patch32(code, jmfn, len(code) - (jmfn + 4));
    push(code, 72); push(code, 199); push(code, 192); _elf.le(code, 0 - 1, 4);
    push(code, 65); push(code, 94); push(code, 65); push(code, 93); push(code, 65); push(code, 92); push(code, 91); push(code, 195);

