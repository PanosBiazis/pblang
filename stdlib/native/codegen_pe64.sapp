// stdlib/native/codegen_pe64.sapp — Pure-PBLang Windows x86-64 PE32+ (.exe) Native Compiler.
//
// Cross-compiles PBLang source directly into a native 64-bit Windows executable (`PE32+`,
// `IMAGE_FILE_MACHINE_AMD64 = 0x8664`, `IMAGE_SUBSYSTEM_WINDOWS_CUI = 3`) with ZERO C,
// ZERO Rust, ZERO MinGW, and ZERO external assembler/linker.
//
// Architectural highlights:
// - 100% RIP-relative addressing (`[rip + disp32]`) for IAT calls, `.rodata` string literals,
//   closure code pointers, `try/catch` landing pads, and RW globals — works at `ImageBase`
//   (`0x140000000`) AND under arbitrary Windows 10/11 ASLR relocation without `.reloc` fixups.
// - Strict Microsoft x64 ABI compliance (`rcx, rdx, r8, r9` + 32-byte shadow space + guaranteed
//   16-byte stack alignment prior to every `KERNEL32.dll` IAT call).
// - Full runtime support: recursion, first-class closures + mutable `TAG_BOX` upvalues,
//   hardware stack-unwinding `try / catch / throw` + `caught_error()`, strings, dynamic arrays,
//   auto-growing dynamic maps (`map_has`, `map_keys`, `map_values`, `map_remove`, `for`),
//   and direct `KERNEL32.dll` I/O (`print`, `fs_write`, `fs_read`, `fs_exists`, `fs_remove`,
//   `time_ms`, `sleep_ms`, `os_exit`).

let _SOURCE = import("../compiler/checked_source.sapp");
let _elf = import("./elf_x64.sapp");

fn _align_up(v, a) {
    let r = v % a;
    if r == 0 { return v; }
    return v + (a - r);
}

fn _push_bytes(dst, src) {
    let i = 0;
    while i < len(src) { push(dst, src[i]); i = i + 1; }
}

fn _push_zeros(dst, n) {
    let i = 0;
    while i < n { push(dst, 0); i = i + 1; }
}

fn _patch32(buf, pos, val) {
    let tmp = [];
    _elf.le(tmp, val, 4);
    buf[pos] = tmp[0]; buf[pos + 1] = tmp[1]; buf[pos + 2] = tmp[2]; buf[pos + 3] = tmp[3];
}

fn _stmts_of(b) {
    if b == nil { return []; }
    if is_array(b) { return b; }
    if is_map(b) { let s = try b.stmts catch nil; if s != nil { return s; } }
    return [b];
}

fn _param_name(p) {
    if is_string(p) { return p; }
    if is_map(p) { return p.name; }
    return str(p);
}

// Record a RIP-relative fixup against a symbolic target (`kind`: "iat", "ro_str", "ro_bounds_lo",
// "ro_bounds_hi", "rw", "fn", "lbl"). Resolved once `.text`, `.rodata`, and `.idata` RVAs are finalized.
fn _add_rip_fix(fixes, disp_pos, kind, key) {
    push(fixes, map{ pos: disp_pos, kind: kind, key: key });
}

fn _emit_call_rel(code, calls, name) {
    push(code, 232); let at = len(code); _elf.le(code, 0, 4);
    push(calls, map{ at: at, name: name });
}

fn _emit_win32_call(code, fixes, api_name) {
    push(code, 255); push(code, 21); let at = len(code); _elf.le(code, 0, 4); // call qword [rip + disp32]
    _add_rip_fix(fixes, at, "iat", api_name);
}

fn _emit_mov_rax_rw(code, fixes, rw_key) {
    push(code, 72); push(code, 139); push(code, 5); let at = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(fixes, at, "rw", rw_key);
}

fn _emit_mov_rw_rax(code, fixes, rw_key) {
    push(code, 72); push(code, 137); push(code, 5); let at = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(fixes, at, "rw", rw_key);
}

fn _emit_lea_rcx_rw(code, fixes, rw_key) {
    push(code, 72); push(code, 141); push(code, 13); let at = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(fixes, at, "rw", rw_key);
}

fn _intern_ro_str(st, s) {
    if map_has(st.str_idx, s) { return st.str_idx[s]; }
    let id = len(st.str_list);
    st.str_idx[s] = id;
    push(st.str_list, s);
    return id;
}

// ── Closure & Mutable Upvalue (`TAG_BOX`) Static Analysis ─────────────────────────────
fn _is_builtin_pe(nm) {
    return nm == "len" or nm == "push" or nm == "array_push" or nm == "pop" or nm == "array_pop"
        or nm == "str" or nm == "str_slice" or nm == "slice" or nm == "str_split"
        or nm == "strcharcodeat" or nm == "strfromcharcode" or nm == "parse_number"
        or nm == "is_string" or nm == "is_array" or nm == "is_map" or nm == "is_number"
        or nm == "map_has" or nm == "map_keys" or nm == "map_values" or nm == "map_remove" or nm == "delete"
        or nm == "caught_error" or nm == "fs_write" or nm == "fs_read" or nm == "fs_exists" or nm == "fs_remove"
        or nm == "time_ms" or nm == "now_ms" or nm == "sleep_ms" or nm == "os_exit"
        or nm == "bit_and" or nm == "bit_or" or nm == "bit_xor" or nm == "bit_shl" or nm == "bit_shr" or nm == "bit_not";
}

fn _copy_set(m) {
    let out = map{};
    if m == nil { return out; }
    let ks = map_keys(m); let i = 0;
    while i < len(ks) { out[ks[i]] = m[ks[i]]; i = i + 1; }
    return out;
}

fn _fv_expr(node, bound, out, seen) {
    if not is_map(node) { return; }
    let k = try node.kind catch nil;
    if k == "ident" {
        let nm = node.name;
        if (not map_has(bound, nm)) and (not map_has(seen, nm)) and (not _is_builtin_pe(nm)) {
            seen[nm] = true; push(out, nm);
        }
        return;
    }
    if k == "binary" { _fv_expr(node.left, bound, out, seen); _fv_expr(node.right, bound, out, seen); return; }
    if k == "unary" { _fv_expr(node.operand, bound, out, seen); return; }
    if k == "assign" {
        let nm = node.name;
        if (not map_has(bound, nm)) and (not map_has(seen, nm)) and (not _is_builtin_pe(nm)) {
            seen[nm] = true; push(out, nm);
        }
        _fv_expr(node.value, bound, out, seen);
        return;
    }
    if k == "assign_to" { _fv_expr(node.target, bound, out, seen); _fv_expr(node.value, bound, out, seen); return; }
    if k == "call" {
        _fv_expr(node.func, bound, out, seen);
        let i = 0; while i < len(node.args) { _fv_expr(node.args[i], bound, out, seen); i = i + 1; }
        return;
    }
    if k == "index" { _fv_expr(node.obj, bound, out, seen); _fv_expr(node.index, bound, out, seen); return; }
    if k == "member" { _fv_expr(node.obj, bound, out, seen); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _fv_expr(node.items[i], bound, out, seen); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _fv_expr(node.entries[i].value, bound, out, seen); i = i + 1; } return; }
    if k == "try" { _fv_expr(node.body, bound, out, seen); if node.handler != nil { _fv_expr(node.handler, bound, out, seen); } return; }
    if k == "throw" { let v = try node.value catch nil; if v == nil { v = try node.expr catch nil; } _fv_expr(v, bound, out, seen); return; }
    if k == "if_expr" {
        _fv_expr(node.cond, bound, out, seen);
        _fv_stmts(_stmts_of(node.then), _copy_set(bound), out, seen);
        let el = try node.else catch nil;
        if el != nil { _fv_stmts(_stmts_of(el), _copy_set(bound), out, seen); }
        return;
    }
    if k == "fn_lit" {
        let b2 = _copy_set(bound);
        let i = 0; while i < len(node.params) { b2[_param_name(node.params[i])] = true; i = i + 1; }
        _fv_stmts(_stmts_of(node.body), b2, out, seen);
        return;
    }
}

fn _fv_stmts(stmts, bound, out, seen) {
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" {
            let v = try s.value catch nil;
            if v != nil { _fv_expr(v, bound, out, seen); }
            bound[s.name] = true;
        } elif k == "return" or k == "print" {
            let v = try s.value catch nil;
            if v != nil { _fv_expr(v, bound, out, seen); }
        } elif k == "expr_stmt" { _fv_expr(s.expr, bound, out, seen); }
        elif k == "assign" {
            if (not map_has(bound, s.name)) and (not map_has(seen, s.name)) and (not _is_builtin_pe(s.name)) {
                seen[s.name] = true; push(out, s.name);
            }
            _fv_expr(s.value, bound, out, seen);
        } elif k == "block" { _fv_stmts(_stmts_of(s), _copy_set(bound), out, seen); }
        elif k == "if" {
            _fv_expr(s.cond, bound, out, seen);
            _fv_stmts(_stmts_of(s.then), _copy_set(bound), out, seen);
            let el = try s.elifs catch nil;
            if el != nil { let j = 0; while j < len(el) { _fv_expr(el[j].cond, bound, out, seen); _fv_stmts(_stmts_of(el[j].body), _copy_set(bound), out, seen); j = j + 1; } }
            let e = try s.else catch nil;
            if e != nil { _fv_stmts(_stmts_of(e), _copy_set(bound), out, seen); }
        } elif k == "while" {
            _fv_expr(s.cond, bound, out, seen);
            _fv_stmts(_stmts_of(s.body), _copy_set(bound), out, seen);
        } elif k == "for_in" {
            _fv_expr(s.iter, bound, out, seen);
            let b2 = _copy_set(bound); b2[s.name] = true;
            _fv_stmts(_stmts_of(s.body), b2, out, seen);
        } elif k == "for_range" {
            _fv_expr(s.start, bound, out, seen); _fv_expr(s.end, bound, out, seen);
            let b2 = _copy_set(bound); b2[s.name] = true;
            _fv_stmts(_stmts_of(s.body), b2, out, seen);
        }
        i = i + 1;
    }
}

fn _free_vars_pe(params, body, skip) {
    let bound = _copy_set(skip);
    let i = 0; while i < len(params) { bound[_param_name(params[i])] = true; i = i + 1; }
    let out = []; let seen = map{};
    _fv_stmts(body, bound, out, seen);
    return out;
}

fn _scan_caps_muts_expr(node, capset, mutset, skip) {
    if not is_map(node) { return; }
    let k = try node.kind catch nil;
    if k == "fn_lit" {
        let fvs = _free_vars_pe(node.params, _stmts_of(node.body), skip);
        let i = 0; while i < len(fvs) { capset[fvs[i]] = true; i = i + 1; }
        _scan_caps_muts_stmts(_stmts_of(node.body), capset, mutset, skip);
        return;
    }
    if k == "assign" { mutset[node.name] = true; _scan_caps_muts_expr(node.value, capset, mutset, skip); return; }
    if k == "assign_to" { _scan_caps_muts_expr(node.target, capset, mutset, skip); _scan_caps_muts_expr(node.value, capset, mutset, skip); return; }
    if k == "binary" { _scan_caps_muts_expr(node.left, capset, mutset, skip); _scan_caps_muts_expr(node.right, capset, mutset, skip); return; }
    if k == "unary" { _scan_caps_muts_expr(node.operand, capset, mutset, skip); return; }
    if k == "call" { _scan_caps_muts_expr(node.func, capset, mutset, skip); let i = 0; while i < len(node.args) { _scan_caps_muts_expr(node.args[i], capset, mutset, skip); i = i + 1; } return; }
    if k == "index" { _scan_caps_muts_expr(node.obj, capset, mutset, skip); _scan_caps_muts_expr(node.index, capset, mutset, skip); return; }
    if k == "member" { _scan_caps_muts_expr(node.obj, capset, mutset, skip); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _scan_caps_muts_expr(node.items[i], capset, mutset, skip); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _scan_caps_muts_expr(node.entries[i].value, capset, mutset, skip); i = i + 1; } return; }
    if k == "try" { _scan_caps_muts_expr(node.body, capset, mutset, skip); if node.handler != nil { _scan_caps_muts_expr(node.handler, capset, mutset, skip); } return; }
    if k == "throw" { let v = try node.value catch nil; if v == nil { v = try node.expr catch nil; } _scan_caps_muts_expr(v, capset, mutset, skip); return; }
    if k == "if_expr" { _scan_caps_muts_expr(node.cond, capset, mutset, skip); _scan_caps_muts_stmts(_stmts_of(node.then), capset, mutset, skip); let el = try node.else catch nil; if el != nil { _scan_caps_muts_stmts(_stmts_of(el), capset, mutset, skip); } return; }
}

fn _scan_caps_muts_stmts(stmts, capset, mutset, skip) {
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" or k == "return" or k == "print" { let v = try s.value catch nil; if v != nil { _scan_caps_muts_expr(v, capset, mutset, skip); } }
        elif k == "expr_stmt" { _scan_caps_muts_expr(s.expr, capset, mutset, skip); }
        elif k == "assign" { mutset[s.name] = true; _scan_caps_muts_expr(s.value, capset, mutset, skip); }
        elif k == "block" { _scan_caps_muts_stmts(_stmts_of(s), capset, mutset, skip); }
        elif k == "if" {
            _scan_caps_muts_expr(s.cond, capset, mutset, skip);
            _scan_caps_muts_stmts(_stmts_of(s.then), capset, mutset, skip);
            let el = try s.elifs catch nil;
            if el != nil { let j = 0; while j < len(el) { _scan_caps_muts_expr(el[j].cond, capset, mutset, skip); _scan_caps_muts_stmts(_stmts_of(el[j].body), capset, mutset, skip); j = j + 1; } }
            let e = try s.else catch nil; if e != nil { _scan_caps_muts_stmts(_stmts_of(e), capset, mutset, skip); }
        } elif k == "while" { _scan_caps_muts_expr(s.cond, capset, mutset, skip); _scan_caps_muts_stmts(_stmts_of(s.body), capset, mutset, skip); }
        elif k == "for_in" { _scan_caps_muts_expr(s.iter, capset, mutset, skip); _scan_caps_muts_stmts(_stmts_of(s.body), capset, mutset, skip); }
        elif k == "for_range" { _scan_caps_muts_expr(s.start, capset, mutset, skip); _scan_caps_muts_expr(s.end, capset, mutset, skip); _scan_caps_muts_stmts(_stmts_of(s.body), capset, mutset, skip); }
        i = i + 1;
    }
}

fn _collect_local_decls(stmts, out) {
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" { out[s.name] = true; }
        elif k == "block" { _collect_local_decls(_stmts_of(s), out); }
        elif k == "if" {
            _collect_local_decls(_stmts_of(s.then), out);
            let el = try s.elifs catch nil;
            if el != nil { let j = 0; while j < len(el) { _collect_local_decls(_stmts_of(el[j].body), out); j = j + 1; } }
            let e = try s.else catch nil; if e != nil { _collect_local_decls(_stmts_of(e), out); }
        } elif k == "while" { _collect_local_decls(_stmts_of(s.body), out); }
        elif k == "for_in" or k == "for_range" { out[s.name] = true; _collect_local_decls(_stmts_of(s.body), out); }
        i = i + 1;
    }
}

fn _find_boxed_pe(params, stmts, skip) {
    let capset = map{}; let mutset = map{};
    _scan_caps_muts_stmts(stmts, capset, mutset, skip);
    let decls = map{};
    let i = 0; while i < len(params) { decls[_param_name(params[i])] = true; i = i + 1; }
    _collect_local_decls(stmts, decls);
    let boxed = map{};
    let ks = map_keys(capset); let j = 0;
    while j < len(ks) {
        let nm = ks[j];
        if map_has(mutset, nm) and map_has(decls, nm) and (not map_has(skip, nm)) { boxed[nm] = true; }
        j = j + 1;
    }
    return boxed;
}

// ── Stack Slot & Variable Access Helpers ──────────────────────────────────────────────
fn _alloc_slot(env, name) {
    if map_has(env.slots, name) { return env.slots[name]; }
    let idx = env.nslots;
    env.slots[name] = idx;
    env.nslots = idx + 1;
    return idx;
}

fn _emit_load_slot_rax(code, idx) {
    let disp = 0 - 8 * (idx + 1);
    push(code, 72); push(code, 139); push(code, 133); _elf.le(code, disp, 4); // mov rax, [rbp + disp32]
}

fn _emit_store_slot_rax(code, idx) {
    let disp = 0 - 8 * (idx + 1);
    push(code, 72); push(code, 137); push(code, 133); _elf.le(code, disp, 4); // mov [rbp + disp32], rax
}

fn _emit_alloc_box_rax(code) {
    push(code, 72); push(code, 137); push(code, 194);                         // mov rdx, rax
    push(code, 76); push(code, 137); push(code, 248);                         // mov rax, r15
    push(code, 73); push(code, 131); push(code, 199); push(code, 16);         // add r15, 16
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 5, 4);      // mov qword [rax], TAG_BOX (5)
    push(code, 72); push(code, 137); push(code, 80); push(code, 8);           // mov [rax+8], rdx
}

fn _pop_argreg_pe(code, idx) {
    if idx == 0 { push(code, 95); return; }                 // pop rdi
    if idx == 1 { push(code, 94); return; }                 // pop rsi
    if idx == 2 { push(code, 90); return; }                 // pop rdx
    if idx == 3 { push(code, 89); return; }                 // pop rcx
    if idx == 4 { push(code, 65); push(code, 88); return; } // pop r8
    if idx == 5 { push(code, 65); push(code, 89); return; } // pop r9
    throw "codegen_pe64: max 6 call arguments supported";
}

fn _emit_spill_argreg_to_rax(code, idx) {
    if idx == 0 { push(code, 72); push(code, 137); push(code, 248); return; } // mov rax, rdi
    if idx == 1 { push(code, 72); push(code, 137); push(code, 240); return; } // mov rax, rsi
    if idx == 2 { push(code, 72); push(code, 137); push(code, 208); return; } // mov rax, rdx
    if idx == 3 { push(code, 72); push(code, 137); push(code, 200); return; } // mov rax, rcx
    if idx == 4 { push(code, 76); push(code, 137); push(code, 192); return; } // mov rax, r8
    if idx == 5 { push(code, 76); push(code, 137); push(code, 200); return; } // mov rax, r9
}

// ── AST Expression & Statement Code Generation ────────────────────────────────────────
fn _emit_expr(node, code, env, st) {
    if node == nil { push(code, 49); push(code, 192); return; }
    let k = node.kind;
    if k == "nil" { push(code, 49); push(code, 192); return; }
    if k == "bool" {
        if node.value { push(code, 184); _elf.le(code, 1, 4); }
        else { push(code, 49); push(code, 192); }
        return;
    }
    if k == "number" {
        let v = parse_number(node.value);
        if v == 0 { push(code, 49); push(code, 192); return; }
        if v > 0 and v <= 2147483647 { push(code, 184); _elf.le(code, v, 4); return; }
        if v >= 0 - 2147483648 and v < 0 { push(code, 72); push(code, 199); push(code, 192); _elf.le(code, v, 4); return; }
        push(code, 72); push(code, 184); _elf.le(code, v, 8);
        return;
    }
    if k == "string" {
        let sid = _intern_ro_str(st, node.value);
        push(code, 72); push(code, 141); push(code, 5); let at = len(code); _elf.le(code, 0, 4); // lea rax, [rip + disp32]
        _add_rip_fix(st.fixes, at, "ro_str", str(sid));
        return;
    }
    if k == "ident" {
        let nm = node.name;
        if map_has(env.slots, nm) {
            _emit_load_slot_rax(code, env.slots[nm]);
            if map_has(env.boxed, nm) or map_has(env.boxcaps, nm) {
                push(code, 72); push(code, 139); push(code, 64); push(code, 8); // mov rax, [rax+8]
            }
            return;
        }
        if map_has(st.globals, nm) {
            _emit_mov_rax_rw(code, st.fixes, "g_" + nm);
            return;
        }
        if map_has(st.fnnames, nm) {
            // Wrap named function as 0-capture TAG_CLO [4, code_ptr, 0]
            push(code, 72); push(code, 141); push(code, 13); let at = len(code); _elf.le(code, 0, 4);
            _add_rip_fix(st.fixes, at, "fn", nm);
            push(code, 76); push(code, 137); push(code, 248);                 // mov rax, r15
            push(code, 73); push(code, 131); push(code, 199); push(code, 24); // add r15, 24
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 4, 4);
            push(code, 72); push(code, 137); push(code, 72); push(code, 8);
            push(code, 72); push(code, 199); push(code, 64); push(code, 16); _elf.le(code, 0, 4);
            return;
        }
        throw "codegen_pe64: undefined identifier '" + nm + "'";
    }
    if k == "unary" {
        _emit_expr(node.operand, code, env, st);
        if node.op == "-" { push(code, 72); push(code, 247); push(code, 216); return; }
        if node.op == "not" or node.op == "!" {
            push(code, 72); push(code, 133); push(code, 192);
            push(code, 15); push(code, 148); push(code, 192); // sete al
            push(code, 15); push(code, 182); push(code, 192); // movzx eax, al
            return;
        }
        throw "codegen_pe64: unsupported unary op " + node.op;
    }
    if k == "binary" {
        let op = node.op;
        if op == "and" {
            _emit_expr(node.left, code, env, st);
            push(code, 72); push(code, 133); push(code, 192);
            push(code, 15); push(code, 132); let jz = len(code); _elf.le(code, 0, 4);
            _emit_expr(node.right, code, env, st);
            push(code, 72); push(code, 133); push(code, 192);
            push(code, 15); push(code, 149); push(code, 192);
            push(code, 15); push(code, 182); push(code, 192);
            _patch32(code, jz, len(code) - (jz + 4));
            return;
        }
        if op == "or" {
            _emit_expr(node.left, code, env, st);
            push(code, 72); push(code, 133); push(code, 192);
            push(code, 15); push(code, 133); let jnz = len(code); _elf.le(code, 0, 4);
            _emit_expr(node.right, code, env, st);
            push(code, 72); push(code, 133); push(code, 192);
            push(code, 15); push(code, 149); push(code, 192);
            push(code, 15); push(code, 182); push(code, 192);
            push(code, 233); let jend = len(code); _elf.le(code, 0, 4);
            _patch32(code, jnz, len(code) - (jnz + 4));
            push(code, 184); _elf.le(code, 1, 4);
            _patch32(code, jend, len(code) - (jend + 4));
            return;
        }
        _emit_expr(node.left, code, env, st);
        push(code, 80);                                                       // push left
        _emit_expr(node.right, code, env, st);
        push(code, 72); push(code, 137); push(code, 194);                     // mov rdx, rax (right)
        push(code, 89);                                                       // pop rcx      (left)
        if op == "+" { _emit_call_rel(code, st.calls, "__pe_add"); return; }
        if op == "==" { _emit_call_rel(code, st.calls, "__pe_eq"); return; }
        if op == "!=" {
            _emit_call_rel(code, st.calls, "__pe_eq");
            push(code, 72); push(code, 131); push(code, 240); push(code, 1);  // xor rax, 1
            return;
        }
        push(code, 72); push(code, 137); push(code, 200);                     // mov rax, rcx (left)
        if op == "-" { push(code, 72); push(code, 41); push(code, 208); return; }
        if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 194); return; }
        if op == "/" or op == "%" {
            push(code, 73); push(code, 137); push(code, 210);                 // mov r10, rdx (divisor)
            push(code, 72); push(code, 153);                                  // cqo
            push(code, 73); push(code, 247); push(code, 250);                 // idiv r10
            if op == "%" { push(code, 72); push(code, 137); push(code, 208); } // mov rax, rdx
            return;
        }
        push(code, 72); push(code, 57); push(code, 208);                      // cmp rax, rdx
        if op == "<"  { push(code, 15); push(code, 156); push(code, 192); }
        elif op == "<=" { push(code, 15); push(code, 158); push(code, 192); }
        elif op == ">"  { push(code, 15); push(code, 159); push(code, 192); }
        elif op == ">=" { push(code, 15); push(code, 157); push(code, 192); }
        else { throw "codegen_pe64: unsupported binary op " + op; }
        push(code, 15); push(code, 182); push(code, 192);
        return;
    }
    if k == "assign" {
        _emit_expr(node.value, code, env, st);
        _emit_assign_name(node.name, code, env, st);
        return;
    }
    if k == "assign_to" {
        let tgt = node.target;
        if tgt.kind == "member" {
            _emit_expr(tgt.obj, code, env, st); push(code, 80);
            let sid = _intern_ro_str(st, tgt.name);
            push(code, 72); push(code, 141); push(code, 5); let at = len(code); _elf.le(code, 0, 4);
            _add_rip_fix(st.fixes, at, "ro_str", str(sid));
            push(code, 80);
            _emit_expr(node.value, code, env, st);
            push(code, 73); push(code, 137); push(code, 192);                 // mov r8, rax (val)
            push(code, 90);                                                   // pop rdx (key)
            push(code, 89);                                                   // pop rcx (map)
            _emit_call_rel(code, st.calls, "__pe_map_set");
            return;
        }
        if tgt.kind == "index" {
            _emit_expr(tgt.obj, code, env, st); push(code, 80);
            _emit_expr(tgt.index, code, env, st); push(code, 80);
            _emit_expr(node.value, code, env, st);
            push(code, 73); push(code, 137); push(code, 192);                 // mov r8, rax (val)
            push(code, 90);                                                   // pop rdx (idx/key)
            push(code, 89);                                                   // pop rcx (obj)
            _emit_call_rel(code, st.calls, "__pe_idx_set");
            return;
        }
        throw "codegen_pe64: unsupported assign_to target";
    }
    if k == "array" {
        let n = len(node.items);
        let cap = if n < 8 { 8 } else { n * 2 };
        // Evaluate items onto stack first so nested allocations don't interleave
        let i = 0;
        while i < n { _emit_expr(node.items[i], code, env, st); push(code, 80); i = i + 1; }
        push(code, 76); push(code, 137); push(code, 248);                     // mov rax, r15 (arr header)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 32 + cap * 8, 4); // add r15, 32+cap*8
        push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4);  // [rax] = TAG_ARR (2)
        push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, n, 4);   // len
        push(code, 72); push(code, 199); push(code, 64); push(code, 16); _elf.le(code, cap, 4);// cap
        push(code, 72); push(code, 141); push(code, 72); push(code, 32);      // lea rcx, [rax+32]
        push(code, 72); push(code, 137); push(code, 72); push(code, 24);      // [rax+24] = data_ptr
        let j = n - 1;
        while j >= 0 {
            push(code, 90);                                                   // pop rdx
            push(code, 72); push(code, 137); push(code, 145); _elf.le(code, j * 8, 4); // mov [rcx+j*8], rdx
            j = j - 1;
        }
        return;
    }
    if k == "map" {
        let n = len(node.entries);
        let cap = if n < 8 { 8 } else { n * 2 };
        push(code, 76); push(code, 137); push(code, 248);                     // mov rax, r15 (map header)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 32 + cap * 16, 4);
        push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 3, 4);  // [rax] = TAG_MAP (3)
        push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 0, 4);
        push(code, 72); push(code, 199); push(code, 64); push(code, 16); _elf.le(code, cap, 4);
        push(code, 72); push(code, 141); push(code, 72); push(code, 32);
        push(code, 72); push(code, 137); push(code, 72); push(code, 24);
        let i = 0;
        while i < n {
            push(code, 80);                                                   // save map ptr
            let e = node.entries[i];
            let sid = _intern_ro_str(st, e.key);
            _emit_expr(e.value, code, env, st);
            push(code, 73); push(code, 137); push(code, 192);                 // mov r8, rax (val)
            push(code, 72); push(code, 141); push(code, 21); let at = len(code); _elf.le(code, 0, 4); // lea rdx, [rip+disp32]
            _add_rip_fix(st.fixes, at, "ro_str", str(sid));
            push(code, 89);                                                   // pop rcx (map)
            push(code, 81);                                                   // keep map on stack
            _emit_call_rel(code, st.calls, "__pe_map_set");
            push(code, 88);                                                   // pop rax (map)
            i = i + 1;
        }
        return;
    }
    if k == "member" {
        _emit_expr(node.obj, code, env, st);
        push(code, 72); push(code, 137); push(code, 193);                     // mov rcx, rax (map)
        let sid = _intern_ro_str(st, node.name);
        push(code, 72); push(code, 141); push(code, 21); let at = len(code); _elf.le(code, 0, 4); // lea rdx, [rip+disp32]
        _add_rip_fix(st.fixes, at, "ro_str", str(sid));
        _emit_call_rel(code, st.calls, "__pe_map_get");
        return;
    }
    if k == "index" {
        _emit_expr(node.obj, code, env, st); push(code, 80);
        _emit_expr(node.index, code, env, st);
        push(code, 72); push(code, 137); push(code, 194);                     // mov rdx, rax (idx/key)
        push(code, 89);                                                       // pop rcx (obj)
        _emit_call_rel(code, st.calls, "__pe_idx_get");
        return;
    }
    if k == "fn_lit" {
        let skip = _copy_set(st.fnnames);
        let gks = map_keys(st.globals); let gi = 0;
        while gi < len(gks) {
            if not map_has(env.slots, gks[gi]) { skip[gks[gi]] = true; }
            gi = gi + 1;
        }
        let caps = _free_vars_pe(node.params, _stmts_of(node.body), skip);
        let child_boxcaps = map{};
        let ci = 0;
        while ci < len(caps) {
            let cn = caps[ci];
            if map_has(env.boxed, cn) or map_has(env.boxcaps, cn) { child_boxcaps[cn] = true; }
            ci = ci + 1;
        }
        let fid = len(st.funlits);
        let lbl = "__fnlit_" + str(fid);
        push(st.funlits, map{ lbl: lbl, params: node.params, body: _stmts_of(node.body), caps: caps, boxcaps: child_boxcaps });
        // Push captured values/boxes first, then allocate [TAG_CLO=4, code_ptr, ncaps, cap0...]
        let j = 0;
        while j < len(caps) {
            let cn = caps[j];
            _emit_load_slot_rax(code, env.slots[cn]);
            push(code, 80);
            j = j + 1;
        }
        let nc = len(caps);
        push(code, 76); push(code, 137); push(code, 248);                     // mov rax, r15
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 24 + nc * 8, 4);
        push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 4, 4);  // TAG_CLO = 4
        push(code, 72); push(code, 141); push(code, 13); let at = len(code); _elf.le(code, 0, 4);
        _add_rip_fix(st.fixes, at, "lbl", lbl);
        push(code, 72); push(code, 137); push(code, 72); push(code, 8);       // [rax+8] = code_ptr
        push(code, 72); push(code, 199); push(code, 64); push(code, 16); _elf.le(code, nc, 4);
        let m = nc - 1;
        while m >= 0 {
            push(code, 90);
            push(code, 72); push(code, 137); push(code, 144); _elf.le(code, 24 + m * 8, 4);
            m = m - 1;
        }
        return;
    }
    if k == "throw" {
        let v = try node.value catch nil;
        if v == nil { v = try node.expr catch nil; }
        _emit_expr(v, code, env, st);
        push(code, 72); push(code, 137); push(code, 193);                     // mov rcx, rax
        _emit_call_rel(code, st.calls, "__pe_throw");
        return;
    }
    if k == "try" {
        let tid = st.ntry; st.ntry = tid + 1;
        let catch_lbl = "__catch_" + str(tid);
        // Push 32-byte frame: [prev, outer_rsp, rbp, catch_rip]
        push(code, 72); push(code, 141); push(code, 5); let at = len(code); _elf.le(code, 0, 4); // lea rax, [rip + catch_lbl]
        _add_rip_fix(st.fixes, at, "lbl", catch_lbl);
        push(code, 80);                                                       // [rsp+24] = catch_rip
        push(code, 85);                                                       // [rsp+16] = rbp
        push(code, 72); push(code, 141); push(code, 68); push(code, 36); push(code, 16); // lea rax, [rsp+16] (outer_rsp)
        push(code, 80);                                                       // [rsp+8] = outer_rsp
        _emit_mov_rax_rw(code, st.fixes, "exc_top");
        push(code, 80);                                                       // [rsp+0] = prev
        push(code, 72); push(code, 137); push(code, 224);                     // mov rax, rsp
        _emit_mov_rw_rax(code, st.fixes, "exc_top");
        env.try_depth = env.try_depth + 1;
        _emit_expr(node.body, code, env, st);
        env.try_depth = env.try_depth - 1;
        // Normal exit: unlink handler and pop 32B frame while preserving rax!
        push(code, 72); push(code, 137); push(code, 194);                     // mov rdx, rax (save result)
        push(code, 72); push(code, 139); push(code, 4); push(code, 36);       // mov rax, [rsp] (prev)
        _emit_mov_rw_rax(code, st.fixes, "exc_top");
        push(code, 72); push(code, 131); push(code, 196); push(code, 32);     // add rsp, 32
        push(code, 72); push(code, 137); push(code, 208);                     // mov rax, rdx (restore result)
        push(code, 233); let jdone = len(code); _elf.le(code, 0, 4);
        st.labels[catch_lbl] = len(code);
        if node.handler != nil { _emit_expr(node.handler, code, env, st); }
        else { push(code, 49); push(code, 192); }
        _patch32(code, jdone, len(code) - (jdone + 4));
        return;
    }
    if k == "if_expr" {
        _emit_expr(node.cond, code, env, st);
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 132); let jelse = len(code); _elf.le(code, 0, 4);
        _emit_block_expr(node.then, code, env, st);
        push(code, 233); let jend = len(code); _elf.le(code, 0, 4);
        _patch32(code, jelse, len(code) - (jelse + 4));
        let el = try node.else catch nil;
        if el != nil { _emit_block_expr(el, code, env, st); }
        else { push(code, 49); push(code, 192); }
        _patch32(code, jend, len(code) - (jend + 4));
        return;
    }
    if k == "call" {
        // Parser block expression `{ stmt; ...; expr }` lowers as `call` with `block_expr == true`
        if (try node.block_expr catch false) {
            let bst = _stmts_of(node.func.body);
            let bi = 0;
            while bi < len(bst) {
                let s = bst[bi];
                if bi == len(bst) - 1 and s.kind == "return" and (try node.block_tail catch false) {
                    _emit_expr(s.value, code, env, st);
                } else {
                    _emit_stmt(s, code, env, st);
                    if bi == len(bst) - 1 { push(code, 49); push(code, 192); }
                }
                bi = bi + 1;
            }
            if len(bst) == 0 { push(code, 49); push(code, 192); }
            return;
        }
        if node.func.kind == "ident" and _emit_builtin_call_pe(node.func.name, node.args, code, env, st) {
            return;
        }
        // Direct call to known user function (when not shadowed by a local/closure variable)
        if node.func.kind == "ident" and map_has(st.fnnames, node.func.name) and (not map_has(env.slots, node.func.name)) {
            let na = len(node.args);
            let ai = 0;
            while ai < na { _emit_expr(node.args[ai], code, env, st); push(code, 80); ai = ai + 1; }
            let aj = na - 1;
            while aj >= 0 { _pop_argreg_pe(code, aj); aj = aj - 1; }
            _emit_call_rel(code, st.calls, "fn$" + node.func.name);
            return;
        }
        // Indirect closure call (`TAG_CLO = 4`: `[4, code_ptr, ncaps, cap0...]`)
        _emit_expr(node.func, code, env, st);
        push(code, 80);                                                       // push closure ptr
        let na = len(node.args);
        let ai = 0;
        while ai < na { _emit_expr(node.args[ai], code, env, st); push(code, 80); ai = ai + 1; }
        let aj = na - 1;
        while aj >= 0 { _pop_argreg_pe(code, aj); aj = aj - 1; }
        push(code, 65); push(code, 91);                                       // pop r11 (closure ptr)
        push(code, 65); push(code, 255); push(code, 83); push(code, 8);       // call qword [r11+8]
        return;
    }
    throw "codegen_pe64: unsupported expr kind " + str(k);
}

fn _emit_block_expr(b, code, env, st) {
    let stmts = _stmts_of(b);
    let n = len(stmts);
    if n == 0 { push(code, 49); push(code, 192); return; }
    let i = 0;
    while i < n - 1 { _emit_stmt(stmts[i], code, env, st); i = i + 1; }
    let last = stmts[n - 1];
    if last.kind == "expr_stmt" { _emit_expr(last.expr, code, env, st); }
    else { _emit_stmt(last, code, env, st); push(code, 49); push(code, 192); }
}

fn _emit_builtin_call_pe(nm, args, code, env, st) {
    let na = len(args);
    if (nm == "println" or nm == "print") and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);                     // mov rcx, rax
        _emit_call_rel(code, st.calls, "__pe_print_val");
        push(code, 49); push(code, 192);                                      // xor eax, eax
        return true;
    }
    if nm == "len" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 139); push(code, 64); push(code, 8);       // mov rax, [rax+8]
        return true;
    }
    if (nm == "push" or nm == "array_push") and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);                     // mov rdx, rax (val)
        push(code, 89);                                                       // pop rcx (arr)
        _emit_call_rel(code, st.calls, "__pe_arr_push");
        return true;
    }
    if (nm == "pop" or nm == "array_pop") and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 255); push(code, 72); push(code, 8);       // dec qword [rax+8]
        push(code, 72); push(code, 139); push(code, 72); push(code, 8);       // mov rcx, [rax+8]
        push(code, 72); push(code, 139); push(code, 80); push(code, 24);      // mov rdx, [rax+24]
        push(code, 72); push(code, 139); push(code, 4); push(code, 202);      // mov rax, [rdx+rcx*8]
        return true;
    }
    if nm == "str" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_to_str");
        return true;
    }
    if (nm == "str_slice" or nm == "slice") and na == 3 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 80);
        _emit_expr(args[2], code, env, st);
        push(code, 73); push(code, 137); push(code, 192);                     // mov r8, rax
        push(code, 90);                                                       // pop rdx
        push(code, 89);                                                       // pop rcx
        _emit_call_rel(code, st.calls, "__pe_str_slice");
        return true;
    }
    if nm == "strcharcodeat" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);
        push(code, 89);
        push(code, 15); push(code, 182); push(code, 68); push(code, 17); push(code, 16); // movzx eax, byte [rcx+rdx+16]
        return true;
    }
    if nm == "strfromcharcode" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);
        push(code, 76); push(code, 137); push(code, 248);
        push(code, 73); push(code, 131); push(code, 199); push(code, 24);
        push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);
        push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 1, 4);
        push(code, 136); push(code, 80); push(code, 16);                      // mov [rax+16], dl
        push(code, 198); push(code, 64); push(code, 17); push(code, 0);       // mov byte [rax+17], 0
        return true;
    }
    if nm == "parse_number" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_parse_num");
        return true;
    }
    if nm == "map_has" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);
        push(code, 89);
        _emit_call_rel(code, st.calls, "__pe_map_has");
        return true;
    }
    if nm == "map_keys" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_map_keys");
        return true;
    }
    if nm == "map_values" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_map_values");
        return true;
    }
    if (nm == "map_remove" or nm == "delete") and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);
        push(code, 89);
        _emit_call_rel(code, st.calls, "__pe_map_remove");
        return true;
    }
    if nm == "is_string" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_obj_tag");
        push(code, 72); push(code, 131); push(code, 248); push(code, 1);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "is_array" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_obj_tag");
        push(code, 72); push(code, 131); push(code, 248); push(code, 2);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "is_map" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_obj_tag");
        push(code, 72); push(code, 131); push(code, 248); push(code, 3);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "is_number" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_obj_tag");
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "caught_error" and na == 0 {
        _emit_mov_rax_rw(code, st.fixes, "exc_val");
        return true;
    }
    if nm == "fs_write" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st);
        push(code, 72); push(code, 137); push(code, 194);
        push(code, 89);
        _emit_call_rel(code, st.calls, "__pe_fs_write");
        return true;
    }
    if nm == "fs_read" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_fs_read");
        return true;
    }
    if nm == "fs_exists" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_fs_exists");
        return true;
    }
    if nm == "fs_remove" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_fs_remove");
        return true;
    }
    if (nm == "time_ms" or nm == "now_ms") and na == 0 {
        _emit_call_rel(code, st.calls, "__pe_time_ms");
        return true;
    }
    if nm == "sleep_ms" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_sleep_ms");
        return true;
    }
    if nm == "os_exit" and na == 1 {
        _emit_expr(args[0], code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_exit");
        return true;
    }
    if nm == "bit_and" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 91); push(code, 72); push(code, 33); push(code, 216);
        return true;
    }
    if nm == "bit_or" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 91); push(code, 72); push(code, 9); push(code, 216);
        return true;
    }
    if nm == "bit_xor" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 91); push(code, 72); push(code, 49); push(code, 216);
        return true;
    }
    if nm == "bit_shl" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 72); push(code, 137); push(code, 193); push(code, 88);
        push(code, 72); push(code, 211); push(code, 224);
        return true;
    }
    if nm == "bit_shr" and na == 2 {
        _emit_expr(args[0], code, env, st); push(code, 80);
        _emit_expr(args[1], code, env, st); push(code, 72); push(code, 137); push(code, 193); push(code, 88);
        push(code, 72); push(code, 211); push(code, 232);
        return true;
    }
    return false;
}

fn _emit_assign_name(nm, code, env, st) {
    if map_has(env.slots, nm) {
        if map_has(env.boxed, nm) or map_has(env.boxcaps, nm) {
            push(code, 72); push(code, 137); push(code, 194);                 // mov rdx, rax
            _emit_load_slot_rax(code, env.slots[nm]);
            push(code, 72); push(code, 137); push(code, 80); push(code, 8);   // mov [rax+8], rdx
            push(code, 72); push(code, 137); push(code, 208);                 // mov rax, rdx
        } else {
            _emit_store_slot_rax(code, env.slots[nm]);
        }
        return;
    }
    if map_has(st.globals, nm) {
        _emit_mov_rw_rax(code, st.fixes, "g_" + nm);
        return;
    }
    throw "codegen_pe64: assignment to undefined variable '" + nm + "'";
}

fn _emit_unlink_tries(code, count, st) {
    let i = 0;
    while i < count {
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);       // mov rcx, [rsp]
        push(code, 72); push(code, 137); push(code, 13); let at = len(code); _elf.le(code, 0, 4);
        _add_rip_fix(st.fixes, at, "rw", "exc_top");
        push(code, 72); push(code, 131); push(code, 196); push(code, 32);      // add rsp, 32
        i = i + 1;
    }
}

fn _emit_stmt(s, code, env, st) {
    let k = s.kind;
    if k == "let" or k == "const" {
        if s.value != nil { _emit_expr(s.value, code, env, st); }
        else { push(code, 49); push(code, 192); }
        if env.top_level and env.scope_depth == 0 and map_has(st.globals, s.name) {
            _emit_mov_rw_rax(code, st.fixes, "g_" + s.name);
            return;
        }
        let idx = _alloc_slot(env, s.name);
        if map_has(env.boxed, s.name) { _emit_alloc_box_rax(code); }
        _emit_store_slot_rax(code, idx);
        return;
    }
    if k == "assign" {
        _emit_expr(s.value, code, env, st);
        _emit_assign_name(s.name, code, env, st);
        return;
    }
    if k == "expr_stmt" {
        _emit_expr(s.expr, code, env, st);
        return;
    }
    if k == "print" {
        _emit_expr(s.value, code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_print_val");
        return;
    }
    if k == "return" {
        if s.value != nil { _emit_expr(s.value, code, env, st); }
        else { push(code, 49); push(code, 192); }
        if env.try_depth > 0 { _emit_unlink_tries(code, env.try_depth, st); }
        if env.top_level {
            push(code, 72); push(code, 137); push(code, 193);
            _emit_call_rel(code, st.calls, "__pe_exit");
        } else {
            push(code, 72); push(code, 137); push(code, 236);                 // mov rsp, rbp
            push(code, 93);                                                   // pop rbp
            push(code, 195);                                                  // ret
        }
        return;
    }
    if k == "block" {
        env.scope_depth = env.scope_depth + 1;
        let bs = _stmts_of(s); let i = 0;
        while i < len(bs) { _emit_stmt(bs[i], code, env, st); i = i + 1; }
        env.scope_depth = env.scope_depth - 1;
        return;
    }
    if k == "if" {
        let end_patches = [];
        _emit_expr(s.cond, code, env, st);
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 132); let jnext = len(code); _elf.le(code, 0, 4);
        env.scope_depth = env.scope_depth + 1;
        let ts = _stmts_of(s.then); let ti = 0;
        while ti < len(ts) { _emit_stmt(ts[ti], code, env, st); ti = ti + 1; }
        env.scope_depth = env.scope_depth - 1;
        push(code, 233); push(end_patches, len(code)); _elf.le(code, 0, 4);
        _patch32(code, jnext, len(code) - (jnext + 4));

        let el = try s.elifs catch nil;
        if el != nil {
            let ei = 0;
            while ei < len(el) {
                _emit_expr(el[ei].cond, code, env, st);
                push(code, 72); push(code, 133); push(code, 192);
                push(code, 15); push(code, 132); let jnx = len(code); _elf.le(code, 0, 4);
                env.scope_depth = env.scope_depth + 1;
                let ebs = _stmts_of(el[ei].body); let bi = 0;
                while bi < len(ebs) { _emit_stmt(ebs[bi], code, env, st); bi = bi + 1; }
                env.scope_depth = env.scope_depth - 1;
                push(code, 233); push(end_patches, len(code)); _elf.le(code, 0, 4);
                _patch32(code, jnx, len(code) - (jnx + 4));
                ei = ei + 1;
            }
        }
        let els = try s.else catch nil;
        if els != nil {
            env.scope_depth = env.scope_depth + 1;
            let es = _stmts_of(els); let si = 0;
            while si < len(es) { _emit_stmt(es[si], code, env, st); si = si + 1; }
            env.scope_depth = env.scope_depth - 1;
        }
        let pi = 0;
        while pi < len(end_patches) {
            let p = end_patches[pi];
            _patch32(code, p, len(code) - (p + 4));
            pi = pi + 1;
        }
        return;
    }
    if k == "while" {
        let ltop = len(code);
        let lp = map{ breaks: [], conts: [], cont_target: ltop, try_base: env.try_depth };
        push(env.loops, lp);
        _emit_expr(s.cond, code, env, st);
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 132); let jexit = len(code); _elf.le(code, 0, 4);
        env.scope_depth = env.scope_depth + 1;
        let bs = _stmts_of(s.body); let bi = 0;
        while bi < len(bs) { _emit_stmt(bs[bi], code, env, st); bi = bi + 1; }
        env.scope_depth = env.scope_depth - 1;
        push(code, 233); let jb = len(code); _elf.le(code, 0, 4); _patch32(code, jb, ltop - (jb + 4));
        _patch32(code, jexit, len(code) - (jexit + 4));
        pop(env.loops);
        let k1 = 0; while k1 < len(lp.breaks) { let p = lp.breaks[k1]; _patch32(code, p, len(code) - (p + 4)); k1 = k1 + 1; }
        let k2 = 0; while k2 < len(lp.conts) { let p = lp.conts[k2]; _patch32(code, p, ltop - (p + 4)); k2 = k2 + 1; }
        return;
    }
    if k == "for_in" {
        // Desugar `for x in seq` over arrays or maps (via __pe_iter_seq)
        _emit_expr(s.iter, code, env, st);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_call_rel(code, st.calls, "__pe_iter_seq");
        let seq_slot = _alloc_slot(env, "__for_seq_" + str(env.nslots));
        _emit_store_slot_rax(code, seq_slot);
        let idx_slot = _alloc_slot(env, "__for_idx_" + str(env.nslots));
        push(code, 49); push(code, 192);
        _emit_store_slot_rax(code, idx_slot);
        let var_slot = _alloc_slot(env, s.name);

        let ltop = len(code);
        let lp = map{ breaks: [], conts: [], cont_target: 0 - 1, try_base: env.try_depth };
        push(env.loops, lp);
        _emit_load_slot_rax(code, seq_slot);
        push(code, 72); push(code, 139); push(code, 72); push(code, 8);       // rcx = len(seq)
        _emit_load_slot_rax(code, idx_slot);
        push(code, 72); push(code, 57); push(code, 200);                      // cmp rax, rcx
        push(code, 15); push(code, 131); let jexit = len(code); _elf.le(code, 0, 4);
        push(code, 72); push(code, 137); push(code, 194);                     // rdx = idx
        _emit_load_slot_rax(code, seq_slot);
        push(code, 72); push(code, 139); push(code, 64); push(code, 24);      // rax = data_ptr
        push(code, 72); push(code, 139); push(code, 4); push(code, 208);      // rax = data_ptr[rdx]
        if map_has(env.boxed, s.name) { _emit_alloc_box_rax(code); }
        _emit_store_slot_rax(code, var_slot);

        env.scope_depth = env.scope_depth + 1;
        let bs = _stmts_of(s.body); let bi = 0;
        while bi < len(bs) { _emit_stmt(bs[bi], code, env, st); bi = bi + 1; }
        env.scope_depth = env.scope_depth - 1;

        let step_pos = len(code);
        _emit_load_slot_rax(code, idx_slot);
        push(code, 72); push(code, 255); push(code, 192);                     // inc rax
        _emit_store_slot_rax(code, idx_slot);
        push(code, 233); let jb = len(code); _elf.le(code, 0, 4); _patch32(code, jb, ltop - (jb + 4));
        _patch32(code, jexit, len(code) - (jexit + 4));
        pop(env.loops);
        let k1 = 0; while k1 < len(lp.breaks) { let p = lp.breaks[k1]; _patch32(code, p, len(code) - (p + 4)); k1 = k1 + 1; }
        let k2 = 0; while k2 < len(lp.conts) { let p = lp.conts[k2]; _patch32(code, p, step_pos - (p + 4)); k2 = k2 + 1; }
        return;
    }
    if k == "for_range" {
        _emit_expr(s.start, code, env, st);
        let idx_slot = _alloc_slot(env, s.name);
        if map_has(env.boxed, s.name) { _emit_alloc_box_rax(code); }
        _emit_store_slot_rax(code, idx_slot);
        _emit_expr(s.end, code, env, st);
        let end_slot = _alloc_slot(env, "__for_end_" + str(env.nslots));
        _emit_store_slot_rax(code, end_slot);

        let ltop = len(code);
        let lp = map{ breaks: [], conts: [], cont_target: 0 - 1, try_base: env.try_depth };
        push(env.loops, lp);
        _emit_load_slot_rax(code, end_slot);
        push(code, 72); push(code, 137); push(code, 193);
        _emit_load_slot_rax(code, idx_slot);
        if map_has(env.boxed, s.name) { push(code, 72); push(code, 139); push(code, 64); push(code, 8); }
        push(code, 72); push(code, 57); push(code, 200);
        push(code, 15); push(code, 141); let jexit = len(code); _elf.le(code, 0, 4); // jge exit

        env.scope_depth = env.scope_depth + 1;
        let bs = _stmts_of(s.body); let bi = 0;
        while bi < len(bs) { _emit_stmt(bs[bi], code, env, st); bi = bi + 1; }
        env.scope_depth = env.scope_depth - 1;

        let step_pos = len(code);
        _emit_load_slot_rax(code, idx_slot);
        if map_has(env.boxed, s.name) {
            push(code, 72); push(code, 255); push(code, 64); push(code, 8);
        } else {
            push(code, 72); push(code, 255); push(code, 192);
            _emit_store_slot_rax(code, idx_slot);
        }
        push(code, 233); let jb = len(code); _elf.le(code, 0, 4); _patch32(code, jb, ltop - (jb + 4));
        _patch32(code, jexit, len(code) - (jexit + 4));
        pop(env.loops);
        let k1 = 0; while k1 < len(lp.breaks) { let p = lp.breaks[k1]; _patch32(code, p, len(code) - (p + 4)); k1 = k1 + 1; }
        let k2 = 0; while k2 < len(lp.conts) { let p = lp.conts[k2]; _patch32(code, p, step_pos - (p + 4)); k2 = k2 + 1; }
        return;
    }
    if k == "break" {
        let lp = env.loops[len(env.loops) - 1];
        if env.try_depth > lp.try_base { _emit_unlink_tries(code, env.try_depth - lp.try_base, st); }
        push(code, 233); push(lp.breaks, len(code)); _elf.le(code, 0, 4);
        return;
    }
    if k == "continue" {
        let lp = env.loops[len(env.loops) - 1];
        if env.try_depth > lp.try_base { _emit_unlink_tries(code, env.try_depth - lp.try_base, st); }
        push(code, 233); push(lp.conts, len(code)); _elf.le(code, 0, 4);
        return;
    }
    if k == "fn" { return; }
    throw "codegen_pe64: unsupported stmt kind " + str(k);
}

fn _emit_fn_pe(code, lbl_name, params, body, caps, boxcaps, st) {
    st.labels[lbl_name] = len(code);
    push(code, 85);                                                           // push rbp
    push(code, 72); push(code, 137); push(code, 229);                         // mov rbp, rsp
    push(code, 72); push(code, 129); push(code, 236); let frame_at = len(code); _elf.le(code, 64, 4); // sub rsp, <frame>

    let skip = _copy_set(st.fnnames);
    let gks = map_keys(st.globals); let gi = 0;
    while gi < len(gks) { skip[gks[gi]] = true; gi = gi + 1; }
    let pi = 0; while pi < len(params) { if map_has(skip, _param_name(params[pi])) { map_remove(skip, _param_name(params[pi])); } pi = pi + 1; }
    let ci = 0; while ci < len(caps) { if map_has(skip, caps[ci]) { map_remove(skip, caps[ci]); } ci = ci + 1; }
    let boxed = _find_boxed_pe(params, body, skip);

    let env = map{
        slots: map{}, nslots: 0, boxed: boxed, boxcaps: boxcaps,
        loops: [], try_depth: 0, top_level: false, scope_depth: 1
    };

    // Spill captured upvalues from r11 (`[r11 + 24 + c*8]`)
    let c = 0;
    while c < len(caps) {
        let cslot = _alloc_slot(env, caps[c]);
        push(code, 73); push(code, 139); push(code, 131); _elf.le(code, 24 + c * 8, 4); // mov rax, [r11 + 24 + c*8]
        _emit_store_slot_rax(code, cslot);
        c = c + 1;
    }

    // Spill parameters from rdi, rsi, rdx, rcx, r8, r9 (boxing if mutated inside inner closure)
    let p = 0;
    while p < len(params) {
        let pnm = _param_name(params[p]);
        let pslot = _alloc_slot(env, pnm);
        _emit_spill_argreg_to_rax(code, p);
        if map_has(boxed, pnm) { _emit_alloc_box_rax(code); }
        _emit_store_slot_rax(code, pslot);
        p = p + 1;
    }

    let bi = 0;
    while bi < len(body) { _emit_stmt(body[bi], code, env, st); bi = bi + 1; }

    let frame = _align_up(env.nslots * 8, 16);
    _patch32(code, frame_at, frame);
    push(code, 49); push(code, 192);                                          // default nil (0)
    push(code, 72); push(code, 137); push(code, 236);                         // mov rsp, rbp
    push(code, 93);                                                           // pop rbp
    push(code, 195);                                                          // ret
}

// ── Windows x64 Runtime Helpers (`KERNEL32.dll` + Tagged Heap Ops) ────────────────────
fn _emit_pe_runtime(code, st) {
    // 1. __pe_obj_tag(rcx) -> rax = tag (1..5) if rcx is an 8B-aligned pointer inside [arena_base, r15) or [ro_lo, ro_hi), else 0!
    st.labels["__pe_obj_tag"] = len(code);
    push(code, 246); push(code, 193); push(code, 7);                          // test cl, 7
    push(code, 15); push(code, 133); let jnot0 = len(code); _elf.le(code, 0, 4);
    _emit_mov_rax_rw(code, st.fixes, "arena_base");
    push(code, 72); push(code, 57); push(code, 193);                          // cmp rcx, rax
    push(code, 15); push(code, 130); let jchkro = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 57); push(code, 249);                          // cmp rcx, r15
    push(code, 15); push(code, 130); let jisobj = len(code); _elf.le(code, 0, 4);
    _patch32(code, jchkro, len(code) - (jchkro + 4));
    push(code, 72); push(code, 141); push(code, 5); let rlo = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, rlo, "ro_bounds_lo", "");
    push(code, 72); push(code, 57); push(code, 193);                          // cmp rcx, ro_lo
    push(code, 15); push(code, 130); let jnot1 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 141); push(code, 5); let rhi = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, rhi, "ro_bounds_hi", "");
    push(code, 72); push(code, 57); push(code, 193);                          // cmp rcx, ro_hi
    push(code, 15); push(code, 131); let jnot2 = len(code); _elf.le(code, 0, 4);
    _patch32(code, jisobj, len(code) - (jisobj + 4));
    push(code, 72); push(code, 139); push(code, 1);                           // mov rax, [rcx]
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 15); push(code, 140); let jnot3 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 131); push(code, 248); push(code, 5);
    push(code, 15); push(code, 143); let jnot4 = len(code); _elf.le(code, 0, 4);
    push(code, 195);                                                          // ret (rax = 1..5)
    _patch32(code, jnot0, len(code) - (jnot0 + 4));
    _patch32(code, jnot1, len(code) - (jnot1 + 4));
    _patch32(code, jnot2, len(code) - (jnot2 + 4));
    _patch32(code, jnot3, len(code) - (jnot3 + 4));
    _patch32(code, jnot4, len(code) - (jnot4 + 4));
    push(code, 49); push(code, 192);                                          // xor eax, eax
    push(code, 195);

    // 2. __pe_to_str(rcx = val) -> rax = TAG_STR
    st.labels["__pe_to_str"] = len(code);
    push(code, 83);                                                           // push rbx
    push(code, 72); push(code, 137); push(code, 203);                         // mov rbx, rcx
    _emit_call_rel(code, st.calls, "__pe_obj_tag");
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 117); push(code, 5);
    push(code, 72); push(code, 137); push(code, 216);                         // mov rax, rbx (already TAG_STR)
    push(code, 91); push(code, 195);
    // Convert signed 64-bit integer in rbx to TAG_STR on r15
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);         // sub rsp, 32 (digit scratch)
    push(code, 76); push(code, 141); push(code, 68); push(code, 36); push(code, 31); // lea r8, [rsp+31]
    push(code, 65); push(code, 198); push(code, 0); push(code, 0);            // mov byte [r8], 0
    push(code, 76); push(code, 137); push(code, 193);                         // mov rcx, r8 (end)
    push(code, 69); push(code, 49); push(code, 201);                          // xor r9d, r9d (neg_flag)
    push(code, 72); push(code, 137); push(code, 216);                         // mov rax, rbx
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 121); push(code, 6);                                           // jns +6
    push(code, 72); push(code, 247); push(code, 216);                         // neg rax (3B)
    push(code, 65); push(code, 177); push(code, 1);                           // mov r9b, 1 (3B)
    push(code, 65); push(code, 186); _elf.le(code, 10, 4);                    // mov r10d, 10
    let dlp = len(code);
    push(code, 73); push(code, 255); push(code, 200);                         // .dlp: dec r8
    push(code, 49); push(code, 210);                                          // xor edx, edx
    push(code, 73); push(code, 247); push(code, 242);                         // div r10
    push(code, 128); push(code, 194); push(code, 48);                         // add dl, '0'
    push(code, 65); push(code, 136); push(code, 16);                          // mov [r8], dl
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 117); push(code, dlp - (len(code) + 1) + 256);
    push(code, 69); push(code, 132); push(code, 201);                         // test r9b, r9b
    push(code, 116); push(code, 7);                                           // jz +7
    push(code, 73); push(code, 255); push(code, 200);                         // dec r8 (3B)
    push(code, 65); push(code, 198); push(code, 0); push(code, 45);           // mov byte [r8], '-' (4B)
    push(code, 76); push(code, 41); push(code, 193);                          // sub rcx, r8 (rcx = slen)
    push(code, 76); push(code, 137); push(code, 248);                         // mov rax, r15 (str header)
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);      // [rax] = TAG_STR (1)
    push(code, 72); push(code, 137); push(code, 72); push(code, 8);           // [rax+8] = slen
    push(code, 72); push(code, 141); push(code, 80); push(code, 16);          // lea rdx, [rax+16]
    let clp = len(code);
    push(code, 72); push(code, 133); push(code, 201);                         // test rcx, rcx
    push(code, 15); push(code, 132); let jcld = len(code); _elf.le(code, 0, 4); // jz done
    push(code, 69); push(code, 138); push(code, 16);                          // mov r10b, [r8]
    push(code, 68); push(code, 136); push(code, 18);                          // mov [rdx], r10b
    push(code, 73); push(code, 255); push(code, 192);                         // inc r8
    push(code, 72); push(code, 255); push(code, 194);                         // inc rdx
    push(code, 72); push(code, 255); push(code, 201);                         // dec rcx
    push(code, 233); let jclb = len(code); _elf.le(code, 0, 4);
    _patch32(code, jclb, clp - (jclb + 4));
    _patch32(code, jcld, len(code) - (jcld + 4));
    push(code, 198); push(code, 2); push(code, 0);                            // mov byte [rdx], 0
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);           // mov rcx, [rax+8]
    push(code, 73); push(code, 141); push(code, 76); push(code, 15); push(code, 24); // lea rcx, [r15+rcx+24]
    push(code, 72); push(code, 131); push(code, 225); push(code, 248);        // and rcx, -8
    push(code, 73); push(code, 137); push(code, 207);                         // mov r15, rcx
    push(code, 72); push(code, 131); push(code, 196); push(code, 32);         // add rsp, 32
    push(code, 91); push(code, 195);

    // 3. __pe_add(rcx = left, rdx = right) -> integer add OR string concat if either is TAG_STR!
    st.labels["__pe_add"] = len(code);
    push(code, 83); push(code, 65); push(code, 84);                           // push rbx; push r12
    push(code, 72); push(code, 137); push(code, 203);                         // mov rbx, rcx (left)
    push(code, 73); push(code, 137); push(code, 212);                         // mov r12, rdx (right)
    _emit_call_rel(code, st.calls, "__pe_obj_tag");
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 15); push(code, 132); let jcat = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 137); push(code, 225);                         // mov rcx, r12
    _emit_call_rel(code, st.calls, "__pe_obj_tag");
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 15); push(code, 132); let jcat2 = len(code); _elf.le(code, 0, 4);
    // Plain integer addition
    push(code, 72); push(code, 137); push(code, 216);                         // mov rax, rbx
    push(code, 76); push(code, 1); push(code, 224);                           // add rax, r12
    push(code, 65); push(code, 92); push(code, 91); push(code, 195);
    _patch32(code, jcat, len(code) - (jcat + 4));
    _patch32(code, jcat2, len(code) - (jcat2 + 4));
    push(code, 72); push(code, 137); push(code, 217);                         // mov rcx, rbx
    _emit_call_rel(code, st.calls, "__pe_to_str");
    push(code, 72); push(code, 137); push(code, 195);                         // rbx = left str
    push(code, 76); push(code, 137); push(code, 225);                         // mov rcx, r12
    _emit_call_rel(code, st.calls, "__pe_to_str");
    push(code, 73); push(code, 137); push(code, 196);                         // r12 = right str
    push(code, 72); push(code, 139); push(code, 75); push(code, 8);           // rcx = len1
    push(code, 73); push(code, 139); push(code, 84); push(code, 36); push(code, 8); // rdx = len2 ([r12+8])
    push(code, 76); push(code, 141); push(code, 4); push(code, 17);           // lea r8, [rcx+rdx] (total)
    push(code, 76); push(code, 137); push(code, 248);                         // mov rax, r15
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);
    push(code, 76); push(code, 137); push(code, 64); push(code, 8);           // [rax+8] = total
    push(code, 87); push(code, 86);                                           // push rdi; push rsi
    push(code, 72); push(code, 141); push(code, 120); push(code, 16);         // lea rdi, [rax+16]
    push(code, 72); push(code, 141); push(code, 115); push(code, 16);         // lea rsi, [rbx+16]
    push(code, 252); push(code, 243); push(code, 164);                        // cld; rep movsb
    push(code, 72); push(code, 137); push(code, 209);                         // mov rcx, rdx (len2)
    push(code, 73); push(code, 141); push(code, 116); push(code, 36); push(code, 16); // lea rsi, [r12+16]
    push(code, 243); push(code, 164);                                         // rep movsb
    push(code, 198); push(code, 7); push(code, 0);                            // mov byte [rdi], 0
    push(code, 94); push(code, 95);                                           // pop rsi; pop rdi
    push(code, 79); push(code, 141); push(code, 76); push(code, 7); push(code, 24); // lea r9, [r15+r8+24]
    push(code, 73); push(code, 131); push(code, 225); push(code, 248);        // and r9, -8
    push(code, 77); push(code, 137); push(code, 207);                         // mov r15, r9
    push(code, 65); push(code, 92); push(code, 91); push(code, 195);

    // 4. __pe_eq(rcx = a, rdx = b) -> 1 if equal (pointer/int eq OR byte-equal TAG_STR), else 0
    st.labels["__pe_eq"] = len(code);
    push(code, 72); push(code, 57); push(code, 209);                          // cmp rcx, rdx
    push(code, 117); push(code, 6);
    push(code, 184); _elf.le(code, 1, 4); push(code, 195);
    push(code, 83); push(code, 65); push(code, 84);
    push(code, 72); push(code, 137); push(code, 203);                         // rbx = a
    push(code, 73); push(code, 137); push(code, 212);                         // r12 = b
    _emit_call_rel(code, st.calls, "__pe_obj_tag");
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 15); push(code, 133); let jne1 = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 137); push(code, 225);
    _emit_call_rel(code, st.calls, "__pe_obj_tag");
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);
    push(code, 15); push(code, 133); let jne2 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 75); push(code, 8);           // rcx = [rbx+8]
    push(code, 73); push(code, 59); push(code, 76); push(code, 36); push(code, 8); // cmp rcx, [r12+8]
    push(code, 15); push(code, 133); let jne3 = len(code); _elf.le(code, 0, 4);
    push(code, 87); push(code, 86);
    push(code, 72); push(code, 141); push(code, 115); push(code, 16);
    push(code, 73); push(code, 141); push(code, 124); push(code, 36); push(code, 16);
    push(code, 252); push(code, 243); push(code, 166);                        // cld; repe cmpsb
    push(code, 15); push(code, 148); push(code, 192);
    push(code, 15); push(code, 182); push(code, 192);
    push(code, 94); push(code, 95);
    push(code, 65); push(code, 92); push(code, 91); push(code, 195);
    _patch32(code, jne1, len(code) - (jne1 + 4));
    _patch32(code, jne2, len(code) - (jne2 + 4));
    _patch32(code, jne3, len(code) - (jne3 + 4));
    push(code, 49); push(code, 192);
    push(code, 65); push(code, 92); push(code, 91); push(code, 195);

    // 5. __pe_arr_push(rcx = arr, rdx = val) -> grows cap*2+8 if len >= cap
    st.labels["__pe_arr_push"] = len(code);
    push(code, 72); push(code, 139); push(code, 65); push(code, 8);           // rax = len
    push(code, 72); push(code, 59); push(code, 65); push(code, 16);           // cmp rax, cap
    push(code, 15); push(code, 140); let jap = len(code); _elf.le(code, 0, 4);
    push(code, 87); push(code, 86); push(code, 82); push(code, 81);           // push rdi, rsi, rdx, rcx
    push(code, 72); push(code, 139); push(code, 81); push(code, 16);          // rdx = old_cap
    push(code, 72); push(code, 209); push(code, 226);                         // shl rdx, 1
    push(code, 72); push(code, 131); push(code, 194); push(code, 8);          // add rdx, 8 (new_cap)
    push(code, 72); push(code, 137); push(code, 81); push(code, 16);          // [rcx+16] = new_cap
    push(code, 76); push(code, 137); push(code, 255);                         // mov rdi, r15 (new data_ptr)
    push(code, 72); push(code, 193); push(code, 226); push(code, 3);          // shl rdx, 3 (bytes)
    push(code, 73); push(code, 1); push(code, 215);                           // add r15, rdx
    push(code, 72); push(code, 139); push(code, 113); push(code, 24);         // mov rsi, [rcx+24] (old data_ptr)
    push(code, 72); push(code, 137); push(code, 121); push(code, 24);         // [rcx+24] = rdi
    push(code, 72); push(code, 139); push(code, 73); push(code, 8);           // mov rcx, len
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);        // cld; rep movsq
    push(code, 89); push(code, 90); push(code, 94); push(code, 95);           // pop rcx, rdx, rsi, rdi
    _patch32(code, jap, len(code) - (jap + 4));
    push(code, 72); push(code, 139); push(code, 65); push(code, 8);           // mov rax, [rcx+8] (len)
    push(code, 76); push(code, 139); push(code, 65); push(code, 24);          // mov r8, [rcx+24] (data_ptr)
    push(code, 73); push(code, 137); push(code, 20); push(code, 192);         // mov [r8+rax*8], rdx
    push(code, 72); push(code, 255); push(code, 65); push(code, 8);           // inc qword [rcx+8]
    push(code, 72); push(code, 137); push(code, 200);                         // mov rax, rcx
    push(code, 195);

    // 6. __pe_str_slice(rcx = str, rdx = start, r8 = end) -> rax = TAG_STR
    st.labels["__pe_str_slice"] = len(code);
    push(code, 87); push(code, 86);
    push(code, 76); push(code, 139); push(code, 73); push(code, 8);           // mov r9, [rcx+8]
    push(code, 72); push(code, 133); push(code, 210);                         // if start < 0 -> 0
    push(code, 121); push(code, 2); push(code, 49); push(code, 210);
    push(code, 77); push(code, 57); push(code, 200);                          // cmp r8, r9 (end > slen?)
    push(code, 126); push(code, 3); push(code, 77); push(code, 137); push(code, 200); // jle +3; mov r8, r9
    push(code, 73); push(code, 41); push(code, 208);                          // sub r8, rdx (sub_len = end - start)
    push(code, 121); push(code, 3); push(code, 69); push(code, 49); push(code, 192);  // jns +3; xor r8d, r8d
    push(code, 76); push(code, 137); push(code, 248);                         // mov rax, r15
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);
    push(code, 76); push(code, 137); push(code, 64); push(code, 8);           // [rax+8] = r8
    push(code, 72); push(code, 141); push(code, 116); push(code, 17); push(code, 16); // lea rsi, [rcx+rdx+16]
    push(code, 72); push(code, 141); push(code, 120); push(code, 16);         // lea rdi, [rax+16]
    push(code, 76); push(code, 137); push(code, 193);                         // mov rcx, r8
    push(code, 252); push(code, 243); push(code, 164);                        // cld; rep movsb
    push(code, 198); push(code, 7); push(code, 0);                            // trailing NUL
    push(code, 79); push(code, 141); push(code, 76); push(code, 7); push(code, 24); // lea r9, [r15+r8+24]
    push(code, 73); push(code, 131); push(code, 225); push(code, 248);
    push(code, 77); push(code, 137); push(code, 207);
    push(code, 94); push(code, 95); push(code, 195);

    // 7. __pe_parse_num(rcx = TAG_STR) -> rax = signed i64
    st.labels["__pe_parse_num"] = len(code);
    push(code, 72); push(code, 139); push(code, 81); push(code, 8);           // rdx = slen
    push(code, 72); push(code, 141); push(code, 73); push(code, 16);          // rcx = ptr
    push(code, 49); push(code, 192);                                          // rax = 0
    push(code, 69); push(code, 49); push(code, 192);                          // r8d = neg (0)
    push(code, 72); push(code, 133); push(code, 210);
    push(code, 15); push(code, 132); let jpnd = len(code); _elf.le(code, 0, 4);
    push(code, 128); push(code, 57); push(code, 45);                          // cmp byte [rcx], '-'
    push(code, 117); push(code, 9);
    push(code, 65); push(code, 176); push(code, 1);                           // mov r8b, 1 (3B)
    push(code, 72); push(code, 255); push(code, 193);                         // inc rcx (3B)
    push(code, 72); push(code, 255); push(code, 202);                         // dec rdx (3B)
    let pnlp = len(code);
    push(code, 72); push(code, 133); push(code, 210);
    push(code, 15); push(code, 132); let jpne = len(code); _elf.le(code, 0, 4);
    push(code, 68); push(code, 15); push(code, 182); push(code, 9);           // movzx r9d, byte [rcx]
