    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 133); let jmff = len(code); _elf.le(code, 0, 4);
    push(code, 73); push(code, 255); push(code, 198);                         // inc r14
    push(code, 233); let jmfb = len(code); _elf.le(code, 0, 4); _patch32(code, jmfb, mflp - (jmfb + 4));
