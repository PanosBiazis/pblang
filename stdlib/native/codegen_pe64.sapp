    push(code, 72); push(code, 107); push(code, 192); push(code, 10);         // imul rax, rax, 10
    push(code, 76); push(code, 1); push(code, 200);                           // add rax, r9
    push(code, 72); push(code, 255); push(code, 193);
    push(code, 72); push(code, 255); push(code, 202);
    push(code, 233); let jpnb = len(code); _elf.le(code, 0, 4); _patch32(code, jpnb, pnlp - (jpnb + 4));
    _patch32(code, jpne, len(code) - (jpne + 4));
