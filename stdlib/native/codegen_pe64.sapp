    push(code, 72); push(code, 139); push(code, 75); push(code, 24);
    push(code, 76); push(code, 137); push(code, 108); push(code, 1); push(code, 8); // [rcx+rax+8] = r13
    push(code, 76); push(code, 137); push(code, 232);
    push(code, 65); push(code, 93); push(code, 65); push(code, 92); push(code, 91); push(code, 195);
    _patch32(code, jmsn, len(code) - (jmsn + 4));
    // New key: check count < cap
    push(code, 72); push(code, 139); push(code, 67); push(code, 8);           // rax = count
    push(code, 72); push(code, 59); push(code, 67); push(code, 16);           // cmp rax, cap
    push(code, 15); push(code, 140); let jmsa = len(code); _elf.le(code, 0, 4);
    push(code, 87); push(code, 86);                                           // push rdi, rsi
    push(code, 72); push(code, 139); push(code, 83); push(code, 16);          // rdx = old_cap
    push(code, 72); push(code, 209); push(code, 226);                         // shl rdx, 1
    push(code, 72); push(code, 131); push(code, 194); push(code, 8);          // add rdx, 8
    push(code, 72); push(code, 137); push(code, 83); push(code, 16);          // [rbx+16] = new_cap
    push(code, 76); push(code, 137); push(code, 255);                         // rdi = r15
    push(code, 72); push(code, 193); push(code, 226); push(code, 4);          // shl rdx, 4 (bytes)
    push(code, 73); push(code, 1); push(code, 215);                           // add r15, rdx
    push(code, 72); push(code, 139); push(code, 115); push(code, 24);         // rsi = old entries
    push(code, 72); push(code, 137); push(code, 123); push(code, 24);         // [rbx+24] = rdi
    push(code, 72); push(code, 139); push(code, 75); push(code, 8);           // rcx = count
    push(code, 72); push(code, 209); push(code, 225);                         // shl rcx, 1 (count*2 qwords)
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);
    push(code, 94); push(code, 95);
    _patch32(code, jmsa, len(code) - (jmsa + 4));
    push(code, 72); push(code, 139); push(code, 67); push(code, 8);           // rax = count
    push(code, 72); push(code, 193); push(code, 224); push(code, 4);
    push(code, 72); push(code, 139); push(code, 75); push(code, 24);
    push(code, 76); push(code, 137); push(code, 36); push(code, 1);           // [rcx+rax] = r12 (key)
    push(code, 76); push(code, 137); push(code, 108); push(code, 1); push(code, 8); // [rcx+rax+8] = r13 (val)
    push(code, 72); push(code, 255); push(code, 67); push(code, 8);           // inc count
    push(code, 76); push(code, 137); push(code, 232);
    push(code, 65); push(code, 93); push(code, 65); push(code, 92); push(code, 91); push(code, 195);

    // __pe_map_remove(rcx = map, rdx = key) -> rax = 1 if removed else 0
    st.labels["__pe_map_remove"] = len(code);
    push(code, 83); push(code, 87); push(code, 86);
    push(code, 72); push(code, 137); push(code, 203);                         // rbx = map
    _emit_call_rel(code, st.calls, "__pe_map_find");
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 136); let jmrn = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 75); push(code, 8);           // rcx = count
    push(code, 72); push(code, 255); push(code, 201);                         // count - 1
    push(code, 72); push(code, 137); push(code, 75); push(code, 8);           // [rbx+8] = count - 1
    push(code, 72); push(code, 41); push(code, 193);                          // rcx = (count - 1) - idx (tail entries)
    push(code, 72); push(code, 209); push(code, 225);                         // shl rcx, 1 (tail qwords)
    push(code, 72); push(code, 193); push(code, 224); push(code, 4);          // idx * 16
    push(code, 72); push(code, 139); push(code, 123); push(code, 24);         // entries_ptr
    push(code, 72); push(code, 1); push(code, 199);                           // rdi = &entries[idx]
    push(code, 72); push(code, 141); push(code, 119); push(code, 16);         // rsi = &entries[idx+1]
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);
    push(code, 184); _elf.le(code, 1, 4);
    push(code, 94); push(code, 95); push(code, 91); push(code, 195);
    _patch32(code, jmrn, len(code) - (jmrn + 4));
    push(code, 49); push(code, 192);
    push(code, 94); push(code, 95); push(code, 91); push(code, 195);

    // __pe_map_keys(rcx = map) / __pe_map_values(rcx = map) -> TAG_ARR
    st.labels["__pe_map_keys"] = len(code);
    push(code, 49); push(code, 210);                                          // edx = 0 (offset 0 = key)
    push(code, 235); push(code, 5);
    st.labels["__pe_map_values"] = len(code);
    push(code, 186); _elf.le(code, 8, 4);                                     // edx = 8 (offset 8 = val)
    push(code, 76); push(code, 139); push(code, 65); push(code, 8);           // mov r8, [rcx+8] (count)
    push(code, 77); push(code, 141); push(code, 72); push(code, 8);           // lea r9, [r8+8] (cap)
    push(code, 76); push(code, 137); push(code, 248);                         // rax = r15
    push(code, 77); push(code, 137); push(code, 202);                         // mov r10, r9
    push(code, 73); push(code, 193); push(code, 226); push(code, 3);          // shl r10, 3
    push(code, 73); push(code, 131); push(code, 194); push(code, 32);         // add r10, 32
    push(code, 77); push(code, 1); push(code, 215);                           // add r15, r10
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4);      // TAG_ARR = 2
    push(code, 76); push(code, 137); push(code, 64); push(code, 8);           // len = r8
    push(code, 76); push(code, 137); push(code, 72); push(code, 16);          // cap = r9
    push(code, 76); push(code, 141); push(code, 80); push(code, 32);          // lea r10, [rax+32]
    push(code, 76); push(code, 137); push(code, 80); push(code, 24);          // data_ptr = r10
    push(code, 72); push(code, 139); push(code, 73); push(code, 24);          // rcx = entries_ptr
    push(code, 72); push(code, 1); push(code, 209);                           // add rcx, rdx (offset 0 or 8)
    let mkvlp = len(code);
    push(code, 77); push(code, 133); push(code, 192);                         // test r8, r8
    push(code, 15); push(code, 132); let jmkvd = len(code); _elf.le(code, 0, 4); // jz done
    push(code, 76); push(code, 139); push(code, 9);                           // mov r9, [rcx]
    push(code, 77); push(code, 137); push(code, 10);                          // mov [r10], r9
    push(code, 72); push(code, 131); push(code, 193); push(code, 16);         // add rcx, 16
    push(code, 73); push(code, 131); push(code, 194); push(code, 8);          // add r10, 8
    push(code, 73); push(code, 255); push(code, 200);                         // dec r8
    push(code, 233); let jmkvb = len(code); _elf.le(code, 0, 4); _patch32(code, jmkvb, mkvlp - (jmkvb + 4));
    _patch32(code, jmkvd, len(code) - (jmkvd + 4));
    push(code, 195);

    // 9. __pe_idx_get(rcx = obj, rdx = idx_or_key), __pe_idx_set(rcx = obj, rdx = idx_or_key, r8 = val), __pe_iter_seq(rcx = obj)
    st.labels["__pe_idx_get"] = len(code);
    push(code, 72); push(code, 139); push(code, 1);                           // rax = [rcx] (tag)
    push(code, 72); push(code, 131); push(code, 248); push(code, 3);          // TAG_MAP?
    push(code, 15); push(code, 132); let jigm = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);          // TAG_STR?
    push(code, 15); push(code, 132); let jigs = len(code); _elf.le(code, 0, 4);
    // TAG_ARR bounds-checked read
    push(code, 72); push(code, 133); push(code, 210);
    push(code, 15); push(code, 136); let jigo1 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 59); push(code, 81); push(code, 8);
    push(code, 15); push(code, 131); let jigo2 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 65); push(code, 24);
    push(code, 72); push(code, 139); push(code, 4); push(code, 208);
    push(code, 195);
    _patch32(code, jigm, len(code) - (jigm + 4));
    _emit_call_rel(code, st.calls, "__pe_map_get");
    push(code, 195);
    _patch32(code, jigs, len(code) - (jigs + 4));
    push(code, 76); push(code, 141); push(code, 66); push(code, 1);           // lea r8, [rdx+1]
    _emit_call_rel(code, st.calls, "__pe_str_slice");
    push(code, 195);
    _patch32(code, jigo1, len(code) - (jigo1 + 4));
    _patch32(code, jigo2, len(code) - (jigo2 + 4));
    let oob_sid = _intern_ro_str(st, "array index out of bounds");
    push(code, 72); push(code, 141); push(code, 13); let oat = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, oat, "ro_str", str(oob_sid));
    _emit_call_rel(code, st.calls, "__pe_throw");

    st.labels["__pe_idx_set"] = len(code);
    push(code, 72); push(code, 139); push(code, 1);
    push(code, 72); push(code, 131); push(code, 248); push(code, 3);
    push(code, 15); push(code, 132); let jism = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 133); push(code, 210);
    push(code, 15); push(code, 136); let jiso1 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 59); push(code, 81); push(code, 8);
    push(code, 15); push(code, 131); let jiso2 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 65); push(code, 24);
    push(code, 76); push(code, 137); push(code, 4); push(code, 208);          // mov [rax+rdx*8], r8
    push(code, 76); push(code, 137); push(code, 192);
    push(code, 195);
    _patch32(code, jism, len(code) - (jism + 4));
    _emit_call_rel(code, st.calls, "__pe_map_set");
    push(code, 195);
    _patch32(code, jiso1, len(code) - (jiso1 + 4));
    _patch32(code, jiso2, len(code) - (jiso2 + 4));
    push(code, 72); push(code, 141); push(code, 13); let oat2 = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, oat2, "ro_str", str(oob_sid));
    _emit_call_rel(code, st.calls, "__pe_throw");

    st.labels["__pe_iter_seq"] = len(code);
    push(code, 72); push(code, 139); push(code, 1);
    push(code, 72); push(code, 131); push(code, 248); push(code, 3);
    push(code, 117); push(code, 6);
    _emit_call_rel(code, st.calls, "__pe_map_keys");
    push(code, 195);
    push(code, 72); push(code, 137); push(code, 200);
    push(code, 195);

    // 10. __pe_throw(rcx = err_val) -> unwinds [prev, outer_rsp, rbp, catch_rip] or ExitProcess(70)
    st.labels["__pe_throw"] = len(code);
    push(code, 72); push(code, 137); push(code, 200);                         // mov rax, rcx
    _emit_mov_rw_rax(code, st.fixes, "exc_val");
    _emit_mov_rax_rw(code, st.fixes, "exc_top");
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 132); let junc = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 137); push(code, 194);                         // rdx = frame
    push(code, 72); push(code, 139); push(code, 2);                           // rax = [rdx+0] (prev)
    _emit_mov_rw_rax(code, st.fixes, "exc_top");
    push(code, 72); push(code, 139); push(code, 106); push(code, 16);         // rbp = [rdx+16]
    push(code, 72); push(code, 139); push(code, 66); push(code, 24);          // rax = [rdx+24] (catch_rip)
    push(code, 72); push(code, 139); push(code, 98); push(code, 8);           // rsp = [rdx+8]  (outer_rsp)
    push(code, 255); push(code, 224);                                         // jmp rax
    _patch32(code, junc, len(code) - (junc + 4));
    push(code, 185); _elf.le(code, 70, 4);                                    // ecx = 70 (uncaught throw)
    _emit_call_rel(code, st.calls, "__pe_exit");

    // 11. Microsoft x64 ABI Win32 Wrappers (strict 16B stack alignment + 32B shadow space!)
    // __pe_write_stdout(rcx = buf_ptr, rdx = byte_len)
    st.labels["__pe_write_stdout"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);        // and rsp, -16
    push(code, 72); push(code, 131); push(code, 236); push(code, 64);         // sub rsp, 64
    push(code, 73); push(code, 137); push(code, 208);                         // mov r8, rdx (len)
    push(code, 72); push(code, 137); push(code, 202);                         // mov rdx, rcx (buf)
    _emit_mov_rax_rw(code, st.fixes, "stdout_h");
    push(code, 72); push(code, 137); push(code, 193);                         // mov rcx, stdout_h
    push(code, 76); push(code, 141); push(code, 13); let wat = len(code); _elf.le(code, 0, 4); // lea r9, [rip + written_dw]
    _add_rip_fix(st.fixes, wat, "rw", "written_dw");
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 32); _elf.le(code, 0, 4); // [rsp+32] = NULL
    _emit_win32_call(code, st.fixes, "WriteFile");
    push(code, 72); push(code, 137); push(code, 236); push(code, 93); push(code, 195);

    // __pe_print_val(rcx = val) -> prints TAG_STR or signed i64 + '\n'
    st.labels["__pe_print_val"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 83); push(code, 72); push(code, 131); push(code, 236); push(code, 24);
    _emit_call_rel(code, st.calls, "__pe_to_str");
    push(code, 72); push(code, 137); push(code, 195);                         // rbx = str
    push(code, 72); push(code, 141); push(code, 75); push(code, 16);          // rcx = &str[16]
    push(code, 72); push(code, 139); push(code, 83); push(code, 8);           // rdx = len
    _emit_call_rel(code, st.calls, "__pe_write_stdout");
    push(code, 198); push(code, 69); push(code, 240); push(code, 10);         // mov byte [rbp-16], '\n'
    push(code, 72); push(code, 141); push(code, 77); push(code, 240);         // lea rcx, [rbp-16]
    push(code, 186); _elf.le(code, 1, 4);                                     // edx = 1
    _emit_call_rel(code, st.calls, "__pe_write_stdout");
    push(code, 72); push(code, 131); push(code, 196); push(code, 24); push(code, 91); push(code, 93); push(code, 195);

    // __pe_fs_write(rcx = path_str, rdx = content_str) -> rax = 1/0
    st.labels["__pe_fs_write"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 83); push(code, 65); push(code, 84);                           // push rbx; push r12
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 64);
    push(code, 73); push(code, 137); push(code, 212);                         // r12 = content_str
    push(code, 72); push(code, 141); push(code, 73); push(code, 16);          // rcx = &path[16]
    push(code, 186); _elf.le(code, 1073741824, 4);                            // edx = GENERIC_WRITE (0x40000000)
    push(code, 69); push(code, 49); push(code, 192);                          // r8d = 0
    push(code, 69); push(code, 49); push(code, 201);                          // r9d = 0
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 32); _elf.le(code, 2, 4);   // CREATE_ALWAYS
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 40); _elf.le(code, 128, 4); // FILE_ATTRIBUTE_NORMAL
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 48); _elf.le(code, 0, 4);   // NULL
    _emit_win32_call(code, st.fixes, "CreateFileA");
    push(code, 72); push(code, 131); push(code, 248); push(code, 255);        // cmp rax, -1 (INVALID_HANDLE_VALUE)
    push(code, 15); push(code, 132); let jfwe = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 137); push(code, 195);                         // rbx = hFile
    push(code, 72); push(code, 137); push(code, 217);                         // rcx = hFile
    push(code, 73); push(code, 141); push(code, 84); push(code, 36); push(code, 16); // rdx = &content[16]
    push(code, 77); push(code, 139); push(code, 68); push(code, 36); push(code, 8);  // r8 = content.len
    push(code, 76); push(code, 141); push(code, 13); let wat2 = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, wat2, "rw", "written_dw");
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 32); _elf.le(code, 0, 4);
    _emit_win32_call(code, st.fixes, "WriteFile");
    push(code, 72); push(code, 137); push(code, 217);                         // rcx = hFile
    _emit_win32_call(code, st.fixes, "CloseHandle");
    push(code, 184); _elf.le(code, 1, 4);
    push(code, 233); let jfwd = len(code); _elf.le(code, 0, 4);
    _patch32(code, jfwe, len(code) - (jfwe + 4));
    push(code, 49); push(code, 192);
    _patch32(code, jfwd, len(code) - (jfwd + 4));
    push(code, 72); push(code, 141); push(code, 101); push(code, 240);        // lea rsp, [rbp-16]
    push(code, 65); push(code, 92); push(code, 91); push(code, 93); push(code, 195);

    // __pe_fs_read(rcx = path_str) -> rax = TAG_STR
    st.labels["__pe_fs_read"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 83); push(code, 65); push(code, 84);                           // push rbx; push r12
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 64);
    push(code, 72); push(code, 141); push(code, 73); push(code, 16);          // rcx = &path[16]
    push(code, 186); _elf.le(code, 0 - 2147483648, 4);                        // edx = GENERIC_READ (0x80000000)
    push(code, 65); push(code, 184); _elf.le(code, 1, 4);                     // r8d = FILE_SHARE_READ (1)
    push(code, 69); push(code, 49); push(code, 201);                          // r9d = 0
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 32); _elf.le(code, 3, 4);   // OPEN_EXISTING
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 40); _elf.le(code, 128, 4); // FILE_ATTRIBUTE_NORMAL
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 48); _elf.le(code, 0, 4);
    _emit_win32_call(code, st.fixes, "CreateFileA");
    push(code, 72); push(code, 131); push(code, 248); push(code, 255);
    push(code, 15); push(code, 132); let jfre = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 137); push(code, 195);                         // rbx = hFile
    push(code, 77); push(code, 137); push(code, 252);                         // r12 = r15 (TAG_STR dst)
    push(code, 49); push(code, 192);
    _emit_mov_rw_rax(code, st.fixes, "written_dw");
    push(code, 72); push(code, 137); push(code, 217);                         // rcx = hFile
    push(code, 73); push(code, 141); push(code, 84); push(code, 36); push(code, 16); // rdx = &r12[16]
    push(code, 65); push(code, 184); _elf.le(code, 65536, 4);                 // r8d = 65536
    push(code, 76); push(code, 141); push(code, 13); let rat = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, rat, "rw", "written_dw");
    push(code, 72); push(code, 199); push(code, 68); push(code, 36); push(code, 32); _elf.le(code, 0, 4);
    _emit_win32_call(code, st.fixes, "ReadFile");
    push(code, 72); push(code, 137); push(code, 217);
    _emit_win32_call(code, st.fixes, "CloseHandle");
    push(code, 139); push(code, 5); let rat2 = len(code); _elf.le(code, 0, 4); // mov eax, dword [rip + written_dw]
    _add_rip_fix(st.fixes, rat2, "rw", "written_dw");
    push(code, 73); push(code, 199); push(code, 4); push(code, 36); _elf.le(code, 1, 4); // [r12] = TAG_STR (1)
    push(code, 73); push(code, 137); push(code, 68); push(code, 36); push(code, 8);      // [r12+8] = bytes_read
    push(code, 65); push(code, 198); push(code, 68); push(code, 4); push(code, 16); push(code, 0); // [r12+rax+16] = 0
    push(code, 73); push(code, 141); push(code, 76); push(code, 4); push(code, 24);      // lea rcx, [r12+rax+24]
    push(code, 72); push(code, 131); push(code, 225); push(code, 248);
    push(code, 73); push(code, 137); push(code, 207);                         // mov r15, rcx
    push(code, 76); push(code, 137); push(code, 224);                         // mov rax, r12
    push(code, 72); push(code, 141); push(code, 101); push(code, 240);
    push(code, 65); push(code, 92); push(code, 91); push(code, 93); push(code, 195);
    _patch32(code, jfre, len(code) - (jfre + 4));
    push(code, 72); push(code, 141); push(code, 101); push(code, 240);
    push(code, 65); push(code, 92); push(code, 91); push(code, 93);
    let rerr_sid = _intern_ro_str(st, "fs_read failed");
    push(code, 72); push(code, 141); push(code, 13); let reat = len(code); _elf.le(code, 0, 4);
    _add_rip_fix(st.fixes, reat, "ro_str", str(rerr_sid));
    _emit_call_rel(code, st.calls, "__pe_throw");

    // __pe_fs_exists(rcx = path_str) -> rax = 1/0
    st.labels["__pe_fs_exists"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);
    push(code, 72); push(code, 141); push(code, 73); push(code, 16);
    _emit_win32_call(code, st.fixes, "GetFileAttributesA");
    push(code, 131); push(code, 248); push(code, 255);                        // cmp eax, -1 (0xFFFFFFFF)
    push(code, 15); push(code, 149); push(code, 192);                         // setne al
    push(code, 15); push(code, 182); push(code, 192);
    push(code, 72); push(code, 137); push(code, 236); push(code, 93); push(code, 195);

    // __pe_fs_remove(rcx = path_str) -> rax = 1/0
    st.labels["__pe_fs_remove"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);
    push(code, 72); push(code, 141); push(code, 73); push(code, 16);
    _emit_win32_call(code, st.fixes, "DeleteFileA");
    push(code, 133); push(code, 192);
    push(code, 15); push(code, 149); push(code, 192);
    push(code, 15); push(code, 182); push(code, 192);
    push(code, 72); push(code, 137); push(code, 236); push(code, 93); push(code, 195);

    // __pe_time_ms() -> rax = GetTickCount64()
    st.labels["__pe_time_ms"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);
    _emit_win32_call(code, st.fixes, "GetTickCount64");
    push(code, 72); push(code, 137); push(code, 236); push(code, 93); push(code, 195);

    // __pe_sleep_ms(rcx = ms) -> rax = 0
    st.labels["__pe_sleep_ms"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);
    _emit_win32_call(code, st.fixes, "Sleep");
    push(code, 49); push(code, 192);
    push(code, 72); push(code, 137); push(code, 236); push(code, 93); push(code, 195);

    // __pe_exit(rcx = exit_code) -> ExitProcess(ecx)
    st.labels["__pe_exit"] = len(code);
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);
    _emit_win32_call(code, st.fixes, "ExitProcess");
    push(code, 15); push(code, 11);                                           // ud2 (unreachable)
}

// ── PE32+ Container Assembly (`MZ` + `PE\0\0` + `.text` + `.idata`) ──────────────────
fn _emit_sec_hdr(buf, name8, virt_sz, rva, raw_sz, raw_ptr, chars) {
    let b = str_to_bytes(name8);
    let i = 0;
    while i < 8 {
        if i < len(b) { push(buf, b[i]); } else { push(buf, 0); }
        i = i + 1;
    }
    _elf.le(buf, virt_sz, 4);
    _elf.le(buf, rva, 4);
    _elf.le(buf, raw_sz, 4);
    _elf.le(buf, raw_ptr, 4);
    _elf.le(buf, 0, 4);         // PointerToRelocations
    _elf.le(buf, 0, 4);         // PointerToLinenumbers
    _elf.le(buf, 0, 2);         // NumberOfRelocations
    _elf.le(buf, 0, 2);         // NumberOfLinenumbers
    _elf.le(buf, chars, 4);
}

// Compile PBLang source `src` into a standalone 64-bit Windows `PE32+` executable (`.exe` byte array).
fn compile_pe64(src) {
    let ast = _SOURCE.parse_source(src);
    let fns = [];
    let fnnames = map{};
    let globals = map{};
    let main_stmts = [];

    let i = 0;
    while i < len(ast.stmts) {
        let s = ast.stmts[i];
        if s.kind == "fn" {
            push(fns, s);
            fnnames[s.name] = true;
        } else {
            push(main_stmts, s);
            if (s.kind == "let" or s.kind == "const") and (not map_has(globals, s.name)) {
                globals[s.name] = len(globals);
            }
        }
        i = i + 1;
    }

    let st = map{
        calls: [], fixes: [], labels: map{},
        str_idx: map{}, str_list: [],
        funlits: [], globals: globals, fnnames: fnnames, ntry: 0
    };

    let code = [];
    // ---- Entry point `_start` at TEXT_RVA (0x1000) ----
    push(code, 85); push(code, 72); push(code, 137); push(code, 229);         // push rbp; mov rbp, rsp
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);        // and rsp, -16
    push(code, 72); push(code, 129); push(code, 236); let main_frame_at = len(code); _elf.le(code, 64, 4);

    // Allocate 64 MiB RW arena via VirtualAlloc(NULL, 64 MiB, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=4)
    push(code, 72); push(code, 131); push(code, 236); push(code, 32);         // 32B Win32 shadow space
    push(code, 49); push(code, 201);                                          // xor ecx, ecx
    push(code, 186); _elf.le(code, 67108864, 4);                              // mov edx, 64 MiB
    push(code, 65); push(code, 184); _elf.le(code, 12288, 4);                 // mov r8d, 0x3000
    push(code, 65); push(code, 185); _elf.le(code, 4, 4);                     // mov r9d, PAGE_READWRITE (4)
    _emit_win32_call(code, st.fixes, "VirtualAlloc");
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 117); push(code, 10);                                          // jnz +10
    push(code, 185); _elf.le(code, 134, 4);                                   // mov ecx, 134 (5B)
    _emit_call_rel(code, st.calls, "__pe_exit");                              // call __pe_exit (5B)
    push(code, 73); push(code, 137); push(code, 199);                         // mov r15, rax
    _emit_mov_rw_rax(code, st.fixes, "arena_base");

    // Cache GetStdHandle(STD_OUTPUT_HANDLE = -11)
    push(code, 185); _elf.le(code, 0 - 11, 4);                                // mov ecx, -11 (0xFFFFFFF5)
    _emit_win32_call(code, st.fixes, "GetStdHandle");
    _emit_mov_rw_rax(code, st.fixes, "stdout_h");
    push(code, 72); push(code, 131); push(code, 196); push(code, 32);         // add rsp, 32

    // Compile top-level statements
    let mskip = _copy_set(fnnames);
    let gks = map_keys(globals); let gi = 0;
    while gi < len(gks) { mskip[gks[gi]] = true; gi = gi + 1; }
    let mboxed = _find_boxed_pe([], main_stmts, mskip);
    let menv = map{
        slots: map{}, nslots: 0, boxed: mboxed, boxcaps: map{},
        loops: [], try_depth: 0, top_level: true, scope_depth: 0
    };
    let mi = 0;
    while mi < len(main_stmts) { _emit_stmt(main_stmts[mi], code, menv, st); mi = mi + 1; }
    _patch32(code, main_frame_at, _align_up(menv.nslots * 8, 16));

    if len(main_stmts) == 0 and map_has(st.fnnames, "main") {
        _emit_call_rel(code, st.calls, "fn$main");
        push(code, 72); push(code, 137); push(code, 193);                     // mov rcx, rax
        _emit_call_rel(code, st.calls, "__pe_exit");
    } else {
        // Default clean exit: ExitProcess(0)
        push(code, 49); push(code, 201);
        _emit_call_rel(code, st.calls, "__pe_exit");
    }

    // Compile user functions
    let fi = 0;
    while fi < len(fns) {
        let f = fns[fi];
        _emit_fn_pe(code, "fn$" + f.name, f.params, _stmts_of(f.body), [], map{}, st);
        fi = fi + 1;
    }

    // Compile closure literals (including nested closures discovered during outer closure emission!)
    let fli = 0;
    while fli < len(st.funlits) {
        let fl = st.funlits[fli];
        _emit_fn_pe(code, fl.lbl, fl.params, fl.body, fl.caps, fl.boxcaps, st);
        fli = fli + 1;
    }

    // Emit runtime helpers (note: runtime helpers may intern error message literals into st.str_list!)
    _emit_pe_runtime(code, st);

    // Append 8-byte aligned `.rodata` TAG_STR pool inside `.text` section
    while (len(code) % 8) != 0 { push(code, 0); }
    let TEXT_RVA = 4096; // 0x1000
    let ro_lo_rva = TEXT_RVA + len(code);
    let ro_str_rvas = map{};
    let si = 0;
    while si < len(st.str_list) {
        ro_str_rvas[str(si)] = TEXT_RVA + len(code);
        let sb = str_to_bytes(st.str_list[si]);
        _elf.le(code, 1, 8);             // TAG_STR = 1
        _elf.le(code, len(sb), 8);       // byte length
        _push_bytes(code, sb);
        push(code, 0);                   // NUL terminator for Win32 ANSI APIs!
        while (len(code) % 8) != 0 { push(code, 0); }
        si = si + 1;
    }
    let ro_hi_rva = TEXT_RVA + len(code);
    if ro_hi_rva == ro_lo_rva {
        _push_zeros(code, 8);
        ro_hi_rva = TEXT_RVA + len(code);
    }

    let text_virt_sz = len(code);
    let text_raw_sz = _align_up(text_virt_sz, 512);
    let IDATA_RVA = TEXT_RVA + _align_up(text_virt_sz, 4096);

    // ---- Build `.idata` (KERNEL32.dll Import Table + IAT + RW Runtime & Program Globals) ----
    let api_names = [
        "GetStdHandle", "WriteFile", "CreateFileA", "ReadFile", "CloseHandle",
        "GetFileAttributesA", "DeleteFileA", "VirtualAlloc", "GetTickCount64",
        "Sleep", "ExitProcess"
    ];
    let napi = len(api_names);
    let imp_dir_sz = 40;                  // 2 x 20B IMAGE_IMPORT_DESCRIPTOR
    let ilt_off = imp_dir_sz;             // 40
    let ilt_sz = (napi + 1) * 8;          // 96
    let iat_off = ilt_off + ilt_sz;       // 136
    let iat_sz = (napi + 1) * 8;          // 96
    let names_off = iat_off + iat_sz;     // 232

    let names_blob = [];
    let dll_name_rel = len(names_blob);
    _push_bytes(names_blob, str_to_bytes("KERNEL32.dll"));
    push(names_blob, 0);
    if (len(names_blob) % 2) != 0 { push(names_blob, 0); }

    let hn_rvas = [];
    let iat_rvas = map{};
    let ai = 0;
    while ai < napi {
        let nm = api_names[ai];
        let hn_rva = IDATA_RVA + names_off + len(names_blob);
        push(hn_rvas, hn_rva);
        iat_rvas[nm] = IDATA_RVA + iat_off + ai * 8;
        _elf.le(names_blob, 0, 2);        // Hint = 0
        _push_bytes(names_blob, str_to_bytes(nm));
        push(names_blob, 0);
        if (len(names_blob) % 2) != 0 { push(names_blob, 0); }
        ai = ai + 1;
    }

    let idata = [];
    // Import Descriptor 0: KERNEL32.dll
    _elf.le(idata, IDATA_RVA + ilt_off, 4);                // OriginalFirstThunk (ILT RVA)
    _elf.le(idata, 0, 4);                                  // TimeDateStamp
    _elf.le(idata, 0, 4);                                  // ForwarderChain
    _elf.le(idata, IDATA_RVA + names_off + dll_name_rel, 4); // Name RVA
    _elf.le(idata, IDATA_RVA + iat_off, 4);                // FirstThunk (IAT RVA)
    // Import Descriptor 1: Null terminator (20B)
    _push_zeros(idata, 20);

    // ILT (64-bit Hint/Name RVAs + trailing 0)
    let k1 = 0;
    while k1 < napi { _elf.le(idata, hn_rvas[k1], 8); k1 = k1 + 1; }
    _elf.le(idata, 0, 8);

    // IAT (identical 64-bit Hint/Name RVAs before loader binding + trailing 0)
    let k2 = 0;
    while k2 < napi { _elf.le(idata, hn_rvas[k2], 8); k2 = k2 + 1; }
    _elf.le(idata, 0, 8);

    _push_bytes(idata, names_blob);
    while (len(idata) % 8) != 0 { push(idata, 0); }

    // RW Runtime Slots + Program Globals (zero-initialized inside `.idata` RW section!)
    let rw_rvas = map{};
    let sys_keys = ["exc_top", "exc_val", "arena_base", "stdout_h", "written_dw"];
    let sk = 0;
    while sk < len(sys_keys) {
        rw_rvas[sys_keys[sk]] = IDATA_RVA + len(idata);
        _push_zeros(idata, 8);
        sk = sk + 1;
    }
    let gk = 0;
    while gk < len(gks) {
        rw_rvas["g_" + gks[gk]] = IDATA_RVA + len(idata);
        _push_zeros(idata, 8);
        gk = gk + 1;
    }

    let idata_virt_sz = len(idata);
    let idata_raw_sz = _align_up(idata_virt_sz, 512);

    // ---- Resolve all relative `call rel32` and RIP-relative `[rip + disp32]` fixups ----
    let ci = 0;
    while ci < len(st.calls) {
        let c = st.calls[ci];
        if not map_has(st.labels, c.name) { throw "codegen_pe64: unresolved call target " + c.name; }
        let tgt_off = st.labels[c.name];
        _patch32(code, c.at, tgt_off - (c.at + 4));
        ci = ci + 1;
    }

    let fxi = 0;
    while fxi < len(st.fixes) {
        let fx = st.fixes[fxi];
        let next_rip_rva = TEXT_RVA + fx.pos + 4;
        let tgt_rva = 0;
        if fx.kind == "iat" { tgt_rva = iat_rvas[fx.key]; }
        elif fx.kind == "ro_str" { tgt_rva = ro_str_rvas[fx.key]; }
        elif fx.kind == "ro_bounds_lo" { tgt_rva = ro_lo_rva; }
        elif fx.kind == "ro_bounds_hi" { tgt_rva = ro_hi_rva; }
        elif fx.kind == "rw" { tgt_rva = rw_rvas[fx.key]; }
        elif fx.kind == "fn" { tgt_rva = TEXT_RVA + st.labels["fn$" + fx.key]; }
        elif fx.kind == "lbl" { tgt_rva = TEXT_RVA + st.labels[fx.key]; }
        else { throw "codegen_pe64: unknown fixup kind " + fx.kind; }
        _patch32(code, fx.pos, tgt_rva - next_rip_rva);
        fxi = fxi + 1;
    }

    // ---- Assemble PE32+ Executable Image ----
    let HDR_RAW_SZ = 1024; // 0x400
    let size_of_image = IDATA_RVA + _align_up(idata_virt_sz, 4096);
    let pe = [];

    // 1. MS-DOS Header (`MZ`, `e_lfanew = 0x80` at offset `0x3C`, padded to 128 bytes)
    push(pe, 77); push(pe, 90);                   // 'M', 'Z'
    _push_zeros(pe, 58);                          // 0x02 .. 0x3B
    _elf.le(pe, 128, 4);                          // 0x3C: e_lfanew = 0x80
    _push_zeros(pe, 64);                          // 0x40 .. 0x7F (minimal DOS stub space)

    // 2. PE Signature (`"PE\0\0"` at 0x80)
    push(pe, 80); push(pe, 69); push(pe, 0); push(pe, 0);

    // 3. COFF File Header (20 bytes)
    _elf.le(pe, 34404, 2);                        // Machine = IMAGE_FILE_MACHINE_AMD64 (0x8664)
    _elf.le(pe, 2, 2);                            // NumberOfSections = 2 (.text, .idata)
    _elf.le(pe, 0, 4);                            // TimeDateStamp
    _elf.le(pe, 0, 4);                            // PointerToSymbolTable
    _elf.le(pe, 0, 4);                            // NumberOfSymbols
    _elf.le(pe, 240, 2);                          // SizeOfOptionalHeader = 240 (0xF0)
    _elf.le(pe, 35, 2);                           // Characteristics = 0x0023 (RELOCS_STRIPPED | EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE)

    // 4. Optional Header PE32+ (240 bytes)
    _elf.le(pe, 523, 2);                          // Magic = PE32+ (0x020B)
    push(pe, 14); push(pe, 0);                    // LinkerVersion 14.0
    _elf.le(pe, text_raw_sz, 4);                  // SizeOfCode
    _elf.le(pe, idata_raw_sz, 4);                 // SizeOfInitializedData
    _elf.le(pe, 0, 4);                            // SizeOfUninitializedData
    _elf.le(pe, TEXT_RVA, 4);                     // AddressOfEntryPoint = 0x1000
    _elf.le(pe, TEXT_RVA, 4);                     // BaseOfCode = 0x1000
    _elf.le(pe, 0, 4); _elf.le(pe, 1, 4);         // ImageBase = 0x0000000140000000
    _elf.le(pe, 4096, 4);                         // SectionAlignment = 0x1000
    _elf.le(pe, 512, 4);                          // FileAlignment = 0x0200
    _elf.le(pe, 6, 2); _elf.le(pe, 0, 2);         // OperatingSystemVersion = 6.0
    _elf.le(pe, 0, 2); _elf.le(pe, 0, 2);         // ImageVersion = 0.0
    _elf.le(pe, 6, 2); _elf.le(pe, 0, 2);         // SubsystemVersion = 6.0 (Windows Vista/7/10/11)
    _elf.le(pe, 0, 4);                            // Win32VersionValue = 0
    _elf.le(pe, size_of_image, 4);                // SizeOfImage
    _elf.le(pe, HDR_RAW_SZ, 4);                   // SizeOfHeaders = 0x0400
    _elf.le(pe, 0, 4);                            // CheckSum = 0
    _elf.le(pe, 3, 2);                            // Subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI (3)
    _elf.le(pe, 0, 2);                            // DllCharacteristics = 0 (plus 100% RIP-relative PIC!)
    _elf.le(pe, 8388608, 8);                      // SizeOfStackReserve = 8 MiB
    _elf.le(pe, 65536, 8);                        // SizeOfStackCommit = 64 KiB
    _elf.le(pe, 1048576, 8);                      // SizeOfHeapReserve = 1 MiB
    _elf.le(pe, 4096, 8);                         // SizeOfHeapCommit = 4 KiB
    _elf.le(pe, 0, 4);                            // LoaderFlags = 0
    _elf.le(pe, 16, 4);                           // NumberOfRvaAndSizes = 16

    // 16 Data Directories (16 x 8 = 128 bytes)
    _elf.le(pe, 0, 8);                                                // [0] Export
    _elf.le(pe, IDATA_RVA, 4); _elf.le(pe, imp_dir_sz, 4);            // [1] Import Table
    let dd = 2;
    while dd < 12 { _elf.le(pe, 0, 8); dd = dd + 1; }                 // [2..11]
    _elf.le(pe, IDATA_RVA + iat_off, 4); _elf.le(pe, iat_sz, 4);      // [12] IAT
    _elf.le(pe, 0, 8); _elf.le(pe, 0, 8); _elf.le(pe, 0, 8);          // [13..15]

    // 5. Section Headers (2 x 40 = 80 bytes)
    // .text: 0x60000020 (CNT_CODE | MEM_EXECUTE | MEM_READ = 1610612768)
    _emit_sec_hdr(pe, ".text", text_virt_sz, TEXT_RVA, text_raw_sz, HDR_RAW_SZ, 1610612768);
    // .idata: 0xC0000040 (CNT_INITIALIZED_DATA | MEM_READ | MEM_WRITE = -1073741760 signed i32)
    _emit_sec_hdr(pe, ".idata", idata_virt_sz, IDATA_RVA, idata_raw_sz, HDR_RAW_SZ + text_raw_sz, 0 - 1073741760);

    // Pad headers to 0x400
    while len(pe) < HDR_RAW_SZ { push(pe, 0); }

    // 6. Emit `.text` padded to `text_raw_sz` and `.idata` padded to `idata_raw_sz`
    _push_bytes(pe, code);
    _push_zeros(pe, text_raw_sz - len(code));
    _push_bytes(pe, idata);
    _push_zeros(pe, idata_raw_sz - len(idata));
    return pe;
}

fn compile_fns(src) { return compile_pe64(src); }

export compile_pe64, compile_fns;
