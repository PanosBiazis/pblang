    push(code, 15); push(code, 157); push(code, 192);                         // setge al
    push(code, 15); push(code, 182); push(code, 192);
    push(code, 195);

    // __pe_map_set(rcx = map, rdx = key, r8 = val) -> rax = val (grows cap*2+8 if full)
    st.labels["__pe_map_set"] = len(code);
    push(code, 83); push(code, 65); push(code, 84); push(code, 65); push(code, 85); // push rbx, r12, r13
    push(code, 72); push(code, 137); push(code, 203);                         // rbx = map
    push(code, 73); push(code, 137); push(code, 212);                         // r12 = key
