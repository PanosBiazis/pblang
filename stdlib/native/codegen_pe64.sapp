    push(code, 116); push(code, 3);
    push(code, 72); push(code, 247); push(code, 216);                         // neg rax
    _patch32(code, jpnd, len(code) - (jpnd + 4));
    push(code, 195);

    // 8. Map helpers: __pe_map_find(rcx = map, rdx = key_str) -> rax = index (0..count-1) or -1
    st.labels["__pe_map_find"] = len(code);
    push(code, 83); push(code, 65); push(code, 84); push(code, 65); push(code, 85); push(code, 65); push(code, 86); // push rbx, r12, r13, r14
    push(code, 72); push(code, 137); push(code, 203);                         // rbx = map
    push(code, 73); push(code, 137); push(code, 212);                         // r12 = key
    push(code, 76); push(code, 139); push(code, 107); push(code, 8);          // r13 = count
    push(code, 69); push(code, 49); push(code, 246);                          // r14 = i = 0
    let mflp = len(code);
    push(code, 77); push(code, 57); push(code, 238);                          // cmp r14, r13
    push(code, 15); push(code, 131); let jmfn = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 67); push(code, 24);          // rax = entries_ptr
    push(code, 76); push(code, 137); push(code, 241);                         // rcx = i
    push(code, 72); push(code, 193); push(code, 225); push(code, 4);          // shl rcx, 4
    push(code, 72); push(code, 139); push(code, 12); push(code, 8);           // rcx = entries[i].key
    push(code, 76); push(code, 137); push(code, 226);                         // rdx = key
