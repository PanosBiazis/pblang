    let ranked = [];
    while len(ranked) < len(cands) {
        let best = 0 - 1; let bi = 0 - 1; let ci = 0;
        while ci < len(cands) {
            let nm = cands[ci];
            if not map_has(have, nm) {
                let already = false; let z = 0; while z < len(ranked) { if ranked[z] == nm { already = true; } z = z + 1; }
                if not already { let sc = try score[nm] catch 0; if sc > best { best = sc; bi = ci; } }
            }
