        // register (r10 at depth 0, r9 at depth 1) instead of the memory stack — as long as the right operand
        // invokes no call (which would clobber caller-saved regs; then we use the memory stack, always safe).
        // Each depth uses a DISTINCT register (r14→r10→r9), so nested temps never collide; depth ≥2 → memory.
        let tb = -1;
        if td == 0 { tb = 2; }        // r10  (low 3 bits = 2)
        elif td == 1 { tb = 1; }      // r9   (low 3 bits = 1)
        if tb >= 0 and not _deep_has_call(node.right) {
            _ge_rax(node.left, code, slots, calls);                     // rax = left
            push(code, 73); push(code, 137); push(code, 192 + tb);      // mov r(8+tb), rax   (49 89 C0+tb)
            slots.tmpd = td + 1;
            _ge_rax(node.right, code, slots, calls);                    // rax = right
            slots.tmpd = td;
            // rax=right, r(8+tb)=left. Operate DIRECTLY against the temp register (like the r14 level above)
            // instead of shuffling through rbx — saves two movs (6 bytes) on +/*/cmp. `+`/`*` are commutative;
            // `-` and comparisons need left as the minuend, so do them the r(8+tb)-first way to keep semantics.
            if op == "+" { push(code, 76); push(code, 1); push(code, 192 + tb * 8); _ovf(code); return true; }              // add rax, r(8+tb)
            if op == "*" { push(code, 73); push(code, 15); push(code, 175); push(code, 192 + tb); _ovf(code); return true; } // imul rax, r(8+tb)
            if op == "-" { push(code, 73); push(code, 41); push(code, 192 + tb); push(code, 76); push(code, 137); push(code, 192 + tb * 8); _ovf(code); return true; } // sub r(8+tb),rax ; mov rax,r(8+tb)
            push(code, 73); push(code, 57); push(code, 192 + tb);       // cmp r(8+tb), rax  (flags = left - right)
            _setcc(code, op); return true;
        }
        _ge_rax(node.left, code, slots, calls);
        push(code, 80);                                     // push rax  (save left across right)
        _ge_rax(node.right, code, slots, calls);
        push(code, 72); push(code, 137); push(code, 195);   // mov rbx, rax   (rbx = right)
        push(code, 88);                                     // pop rax        (rax = left)
        if op == "+" { push(code, 72); push(code, 1); push(code, 216); _ovf(code); return true; }
        if op == "-" { push(code, 72); push(code, 41); push(code, 216); _ovf(code); return true; }
        if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 195); _ovf(code); return true; }
        push(code, 72); push(code, 57); push(code, 216);    // cmp rax, rbx
        _setcc(code, op); return true;
    }
    if k == "array" {
        // A dynamic array is a HANDLE [TAG_ARR, len, cap, dataptr] (32-byte header) plus a separately-
        // allocated element buffer of cap slots. push() can reallocate the buffer and update dataptr WITHOUT
        // moving the header, so in-place mutation semantics survive growth (this is exactly how a Vec works).
        let n = len(node.items);
        let cap = n + 8;                                                     // initial spare capacity
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15  (header ptr)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 32 + cap * 8, 4); // add r15, 32+cap*8
        push(code, 80);                                                      // push rax  (save header)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]  (header)
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 2, 4); // mov qword [rcx], TAG_ARR
        push(code, 72); push(code, 199); push(code, 65); push(code, 8); _elf.le(code, n, 4);  // mov qword [rcx+8], n  (len)
        push(code, 72); push(code, 199); push(code, 65); push(code, 16); _elf.le(code, cap, 4); // mov qword [rcx+16], cap
        push(code, 72); push(code, 141); push(code, 81); push(code, 32);     // lea rdx, [rcx+32]  (data = header+32)
        push(code, 72); push(code, 137); push(code, 81); push(code, 24);     // mov [rcx+24], rdx  (dataptr)
        let i = 0;
        while i < n {
            _ge_rax(node.items[i], code, slots, calls);                      // element → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]     (header)
            push(code, 72); push(code, 139); push(code, 81); push(code, 24); // mov rdx, [rcx+24]  (dataptr)
            push(code, 72); push(code, 137); push(code, 130); _elf.le(code, 8 * i, 4); // mov [rdx+8*i], rax
            i = i + 1;
        }
        push(code, 88);                                                      // pop rax  (header → result)
        return true;
    }
    if k == "map" {
        // heap-allocate [TAG_MAP, count, cap, keyptr0, v0, keyptr1, v1, ...] via r15 with spare capacity for
        // runtime inserts. Keys are heap-STRING pointers (compared with __streq); pairs start at offset 24.
        let n = len(node.entries);
        let cap = n + 8;                                                     // room for 8 dynamic inserts
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 24 + cap * 16, 4);  // add r15, 24+cap*16
        push(code, 80);                                                      // push rax (base)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 3, 4); // mov qword [rcx], TAG_MAP
        push(code, 72); push(code, 199); push(code, 65); push(code, 8); _elf.le(code, n, 4);  // mov qword [rcx+8], n  (count)
        push(code, 72); push(code, 199); push(code, 65); push(code, 16); _elf.le(code, cap, 4); // mov qword [rcx+16], cap
        let i = 0;
        while i < n {
            let ent = node.entries[i];
            _ge_rax(_str_node(ent.key), code, slots, calls);                 // key string → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]  (header)
            push(code, 72); push(code, 137); push(code, 129); _elf.le(code, 24 + i * 16, 4); // mov [rcx+off], rax (keyptr)
            _ge_rax(ent.value, code, slots, calls);                          // value → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]
            push(code, 72); push(code, 137); push(code, 129); _elf.le(code, 32 + i * 16, 4); // mov [rcx+off], rax (value)
            i = i + 1;
        }
        push(code, 88);                                                      // pop rax (base)
        return true;
    }
    if k == "member" {
        _emit_map_get_access(code, node.obj, _str_node(node.name), nil, slots, calls);  // m.key (trap on miss)
        return true;
    }
    if k == "fn_lit" {
        // A closure value = a heap object [TAG_CLO, code_ptr, cap0, cap1, …]. The captured variables are
        // read from the enclosing scope here and stored into the object; the code_ptr is backpatched once
        // the (deferred) body is emitted. Non-capturing function literals are just [TAG_CLO, code_ptr].
        let body = _stmts_of2(node.body);
        let caps = _free_vars(node.params, body);
        let nc = len(caps);
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15  (base)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 16 + nc * 8, 4); // add r15, 16+nc*8
        push(code, 80);                                                      // push rax (base)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 4, 4); // mov qword [rcx], TAG_CLO
        push(code, 72); push(code, 184); let at = len(code); _elf.le(code, 0, 8);  // movabs rax, <fn addr>
        push(code, 72); push(code, 137); push(code, 65); push(code, 8);      // mov [rcx+8], rax  (code ptr)
        let ci = 0;
        while ci < nc {
            _ge_rax(map{ kind: "ident", name: caps[ci] }, code, slots, calls); // capture value → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]
            push(code, 72); push(code, 137); push(code, 129); _elf.le(code, 16 + 8 * ci, 4); // mov [rcx+off], rax
            ci = ci + 1;
        }
        push(code, 88);                                                      // pop rax (closure ptr)
        // record which captures are string-typed in THIS (enclosing) scope, so the closure body treats
        // them as heap strings too (interprocedural propagation through captures).
        // type the closure's own params AND captures from its body (enclosing-string caps ∪ unification)
        let ftypes = _infer_funlit_types(node, slots);
        push(slots.funlits, map{ params: node.params, body: body, at: at, caps: caps, scaps: ftypes.scaps, spars: ftypes.spars });
        return true;
    }
    if k == "index" {
        if node.index.kind == "string" {                                     // map access m["literal"]
            _emit_map_get_access(code, node.obj, node.index, nil, slots, calls);
            return true;
        }
        if node.obj.kind == "string" {
            // STRING LITERAL indexing "abc"[i] → a fresh 1-char heap string. Only a string LITERAL takes the
            // static path — a string-TYPED variable might actually be an array/map at runtime (a polymorphic
            // evaluator value), so those go through runtime tag-dispatch below (which handles TAG_STR too).
            _ge_rax(node.obj, code, slots, calls);                           // rax = string ptr
            push(code, 80);                                                  // push
            _ge_rax(node.index, code, slots, calls);                        // rax = index
            push(code, 72); push(code, 137); push(code, 193);              // mov rcx, rax
            push(code, 88);                                                 // pop rax (string ptr)
            push(code, 72); push(code, 59); push(code, 72); push(code, 8); // cmp rcx, [rax+8]  (len)
            push(code, 114); push(code, 12);                               // jb +12
            push(code, 191); _elf.le(code, 134, 4);                        // mov edi, 134
            push(code, 184); _elf.le(code, 60, 4);                         // mov eax, 60
            push(code, 15); push(code, 5);                                 // syscall (trap)
            push(code, 15); push(code, 182); push(code, 84); push(code, 8); push(code, 16); // movzx edx, byte [rax+rcx+16]
            push(code, 76); push(code, 137); push(code, 248);              // mov rax, r15   (new 1-char string)
            push(code, 73); push(code, 131); push(code, 199); push(code, 24); // add r15, 24
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4); // mov qword [rax], TAG_STR
            push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 1, 4); // mov qword [rax+8], 1 (len)
            push(code, 136); push(code, 80); push(code, 16);              // mov [rax+16], dl
            return true;
        }
        if _known_map(node.obj, slots) {                                     // known map, runtime key → m[key]
            _emit_map_get_access(code, node.obj, node.index, nil, slots, calls);
            return true;
        }
        if not _known_array(node.obj, slots) {
            // object type not statically known → dispatch on its runtime tag (array / map / string). NOTE:
            // we key off the OBJECT type, not the index type — a string-TYPED index (e.g. a polymorphic
            // evaluator value that's actually a number) must NOT force map access on an array.
            _emit_index_dynamic(code, node.obj, node.index, slots, calls);
            return true;
        }
        _ge_rax(node.obj, code, slots, calls);                               // rax = array pointer
        push(code, 80);                                                      // push rax
        _ge_rax(node.index, code, slots, calls);                             // rax = index
        push(code, 72); push(code, 137); push(code, 193);                    // mov rcx, rax  (index)
        push(code, 88);                                                      // pop rax  (pointer)
        // MEMORY SAFETY: bounds-check `index < len` (unsigned — also traps negatives). Out of range
        // → exit(134). Then load element from the dataptr buffer at [dataptr + rcx*8].
        push(code, 72); push(code, 59); push(code, 72); push(code, 8);       // cmp rcx, [rax+8]  (len)
        push(code, 114); push(code, 12);                                     // jb +12  (in bounds → skip trap)
        push(code, 191); _elf.le(code, 134, 4);                              // mov edi, 134
        push(code, 184); _elf.le(code, 60, 4);                               // mov eax, 60
        push(code, 15); push(code, 5);                                       // syscall  (exit)
        push(code, 72); push(code, 139); push(code, 64); push(code, 24);     // mov rax, [rax+24]  (dataptr)
        push(code, 72); push(code, 139); push(code, 4); push(code, 200);     // mov rax, [rax+rcx*8]  (element)
        return true;
    }
    throw "codegen: cannot compile expr kind " + k;
}

// GLOBAL variables (top-level let/const) live at a FIXED heap address so every function can reach them by
// absolute address (there is no register to spare for a globals base). The heap is mmap'd MAP_FIXED at
// _GBASE, with the first nglobals*8 bytes reserved for globals; global #idx is at [_GBASE + idx*8].
//
// WHY 0x4000_0000_0000 (64 TiB) and not a low address: values and heap pointers share one 64-bit slot, and the
// runtime tells them apart by a single range test "is x in [GBASE, GBASE+HEAPSZ)?" (used by the `+` string/number
// dispatch, ==, is_string/is_map, print). If a plain NUMBER lands in that window it is mistaken for a pointer and
// dereferenced → segfault. At the old base of 4 GiB that happened for any integer ≥ 4e9 (e.g. a running sum),
// crashing long loops. Pushing the arena to 64 TiB — still a canonical 47-bit user address MAP_FIXED can place —
// moves accidental collisions to 64 TiB, but user-controlled integers can still
// deliberately collide. Sound separation requires value tagging or another
// representation change. All base uses are 64-bit movabs; only the arena size
// uses a 32-bit immediate, bounded to 1 GiB.
fn _GBASE() { return 70368744177664; }   // 0x4000_0000_0000 (64 TiB); integers can still collide with this range
// Arena size (bytes). MAP_ANON is lazy → this is a VIRTUAL reservation; RSS only grows with pages actually
// written. 1 GiB gives long self-hosting loops headroom; arena_mark/arena_reset reclaim within it. The
// is_type heap-membership check uses this exact bound, so both read it from here (they must never drift).
let _heap_state = map{ bytes: 1073741824 };
fn _HEAPSZ() { return _heap_state.bytes; }
fn heap_reserve_bytes() { return _heap_state.bytes; }
fn set_heap_reserve(bytes) {
    if not is_number(bytes) { throw "codegen: heap reserve must be a byte count"; }
    let n = try num_floor(bytes) catch 0;
    let valid = try n >= 1048576 and n <= 1073741824 catch false;
    if not valid { throw "codegen: heap reserve must be between 1 MiB and 1 GiB"; }
    n = num_floor((n + 4095) / 4096) * 4096;
    let rounded_valid = try n >= 1048576 and n <= 1073741824 and n % 4096 == 0 catch false;
    if not rounded_valid { throw "codegen: invalid rounded heap reserve"; }
    _heap_state.bytes = n;
    return n;
}
fn _emit_global_load(code, idx) {
    push(code, 72); push(code, 184); _elf.le(code, _GBASE() + idx * 8, 8);   // movabs rax, GBASE+idx*8
    push(code, 72); push(code, 139); push(code, 0);                          // mov rax, [rax]
}
fn _emit_global_store(code, idx) {
    push(code, 72); push(code, 185); _elf.le(code, _GBASE() + idx * 8, 8);   // movabs rcx, GBASE+idx*8
    push(code, 72); push(code, 137); push(code, 1);                          // mov [rcx], rax
}

// add/sub r(12+ri), imm (imm8 if it fits, else imm32; negative folds to sub via sign-extension).
fn _emit_add_reg_imm(code, ri, c) {
    if c >= 0 - 128 and c <= 127 { let b = c; if b < 0 { b = b + 256; } push(code, 73); push(code, 131); push(code, 196 + ri); push(code, b); }  // add r,imm8 (49 83 /0)
    else { push(code, 73); push(code, 129); push(code, 196 + ri); _elf.le(code, c, 4); }                                                        // add r,imm32 (49 81 /0)
}
fn _emit_reg_rax(code, ri, op) {
    push(code, 73);                                 // REX.WB
    if op == "+" { push(code, 1); } else { push(code, 41); } // add/sub r/m64, r64
    push(code, 196 + ri);                           // r12/r13/r14, source rax
}
// IN-PLACE UPDATE: `regvar = regvar ± const` → `add/sub reg, imm` directly, instead of eval-into-rax + mov-back.
// The classic loop counter `i = i + 1`. Flags are clobbered but dead (every conditional re-emits its own cmp).
fn _try_inplace_assign(code, slots, calls, name, value, allow_expr) {
    if _ovf_state.on { return false; }               // safe mode wants the checked add on the general path
    let ri = _reg_of(slots, name);
    if ri < 0 { return false; }                      // target must live in a register
    let v = _fold(value);
    if v.kind != "binary" or (v.op != "+" and v.op != "-") { return false; }
    if v.left.kind != "ident" or v.left.name != name { return false; }
    if v.right.kind != "number" {
        if not allow_expr { return false; }
        _ge_rax(v.right, code, slots, calls);
        _emit_reg_rax(code, ri, v.op);
        return true;
    }
    let c = parse_number(v.right.value);
    if c < 0 - 2147483648 or c > 2147483647 { return false; }
    if v.op == "-" { c = 0 - c; }
    _emit_add_reg_imm(code, ri, c); return true;
}
fn _store_rax_slot(code, slots, name) {
    let ri = _reg_of(slots, name);
    if ri >= 0 { _reg_st(code, ri); return; }               // register-allocated local
    let g = try slots.globals catch nil;                    // a top-level global (not shadowed by a local)
    if g != nil and map_has(g, name) and not map_has(slots.names, name) { _emit_global_store(code, g[name]); return; }
    let i = _slot_of(slots, name);
    push(code, 72); push(code, 137); push(code, 133);       // mov [rbp+disp32], rax
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
}

// ── REGISTER ALLOCATION for locals ────────────────────────────────────────────
// The first few `let`/`const` locals in a function are pinned to callee-saved registers r12/r13/r14
// (r15 is the heap pointer, rbx is the codegen's scratch), saved/restored ONCE per function in a
// reserved frame area. A loop then keeps its counters/accumulators in registers — no per-iteration
// memory traffic — while the one-time save/restore is amortized across all iterations.
fn _reg_ld(code, idx) {   // rax = r(12+idx)
    if idx == 0 { push(code, 76); push(code, 137); push(code, 224); }        // mov rax, r12
    else { if idx == 1 { push(code, 76); push(code, 137); push(code, 232); } // mov rax, r13
    else { push(code, 76); push(code, 137); push(code, 240); } }             // mov rax, r14
}
fn _reg_st(code, idx) {   // r(12+idx) = rax
    if idx == 0 { push(code, 73); push(code, 137); push(code, 196); }        // mov r12, rax
    else { if idx == 1 { push(code, 73); push(code, 137); push(code, 197); } // mov r13, rax
    else { push(code, 73); push(code, 137); push(code, 198); } }             // mov r14, rax
}
// dst = r(12+idx) + disp, in ONE instruction (`lea dst, [reg+disp]`). Collapses the common `mov rax,reg;
// add/sub rax,const` (regvar ± literal — array indices, loop math, `f(n-1)` call args) into a single lea.
// `dstf` is the destination's ModRM reg field (rax=0, rdi=7). Base r12/r13/r14 → REX.WB=0x49; r12 (rm=4)
// needs a SIB byte (0x24). ModRM = mod*64 + dstf*8 + rm; mod=1 (disp8) or 2 (disp32).
fn _emit_lea_reg_dst(code, dstf, idx, disp) {
    let d8 = disp >= -128 and disp <= 127;
    let mod = 2; if d8 { mod = 1; }
    let rm = 4; if idx == 1 { rm = 5; } if idx == 2 { rm = 6; }   // r12→4(SIB), r13→5, r14→6
    push(code, 73); push(code, 141);                             // REX.WB, 8D (lea)
    push(code, mod * 64 + dstf * 8 + rm);                        // ModRM
    if idx == 0 { push(code, 36); }                              // SIB 0x24 for [r12+disp]
    if d8 { _elf.le(code, disp, 1); } else { _elf.le(code, disp, 4); }
}
fn _emit_lea_reg(code, idx, disp) { _emit_lea_reg_dst(code, 0, idx, disp); }   // → rax
// If `arg` is `regvar ± const`, load it straight into a target arg register via lea and return true.
// dstf = that register's ModRM reg field (rdi=7). Saves the intermediate `mov argreg, rax`.
fn _try_lea_arg(code, arg, dstf, slots) {
    let n = _fold(arg);
    if n.kind == "ident" { let ri = _reg_of(slots, n.name); if ri >= 0 { _emit_lea_reg_dst(code, dstf, ri, 0); return true; } return false; }
    if n.kind == "binary" and (n.op == "+" or n.op == "-") and n.left.kind == "ident" and n.right.kind == "number" {
        let ri = _reg_of(slots, n.left.name);
        if ri >= 0 { let d = parse_number(n.right.value); if n.op == "-" { d = 0 - d; } _emit_lea_reg_dst(code, dstf, ri, d); return true; }
    }
    return false;
}
// Callee-saved spills now live at the TOP of the frame, as reserved slot `idx` ([rbp-8*(idx+1)] = _slot_disp(idx)),
// so they are COUNTED in slots.n and the frame can be sized exactly (was pinned at a fixed [rbp-512+…], which
// forced every frame to a flat 512B). Prologues reserve the first _regsave_reserve() slots for these.
fn _reg_save(code, idx) {  // [rbp-8*(idx+1)] = r(12+idx)
    if idx == 0 { push(code, 76); push(code, 137); push(code, 165); }        // mov [rbp+d], r12
    else { if idx == 1 { push(code, 76); push(code, 137); push(code, 173); } // r13
    else { push(code, 76); push(code, 137); push(code, 181); } }             // r14
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(idx));
}
fn _reg_restore(code, idx) {  // r(12+idx) = [rbp-8*(idx+1)]
    if idx == 0 { push(code, 76); push(code, 139); push(code, 165); }        // mov r12, [rbp+d]
    else { if idx == 1 { push(code, 76); push(code, 139); push(code, 173); } // r13
    else { push(code, 76); push(code, 139); push(code, 181); } }             // r14
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(idx));
}
// How many top slots a prologue must reserve for callee-saved spills: the register-var count, bumped to 3 when
// r14 is used as the expression temp (r14 spills to slot index 2). 0 → the fn saves no callee-saved regs.
fn _regsave_reserve(slots) {
    let r = _reg_count(slots);
    if _uses_r14_tmp(slots) and r < 3 { r = 3; }
    return r;
}
// FRAME-POINTER OMISSION support. A "frame-free" fn (0 memory slots, no captures, no tail-call teardown) saves
// its callee-saved regs by PUSH/POP instead of to frame slots, and needs no rbp/sub-rsp/leave at all — matching
// what gcc emits for a leaf-of-registers recursion. These push/pop the used r12/r13/r14 (pop in reverse order).
fn _reg_push_all(code, slots) {
    let n = _reg_count(slots); let i = 0;
    while i < n { push(code, 65); push(code, 84 + i); i = i + 1; }        // push r(12+i)  (41 54/55/56)
    if _uses_r14_tmp(slots) { push(code, 65); push(code, 86); }           // push r14
}
fn _reg_pop_all(code, slots) {   // exact reverse of _reg_push_all
    if _uses_r14_tmp(slots) { push(code, 65); push(code, 94); }           // pop r14  (41 5E)
    let n = _reg_count(slots); let i = n - 1;
    while i >= 0 { push(code, 65); push(code, 92 + i); i = i - 1; }        // pop r(12+i)  (41 5C/5D/5E)
}
// ── SHRINK-WRAPPING ────────────────────────────────────────────────────────────────────────────────────────
// A frame-free fn whose body opens with `if <cmp> { return <e>; }` (no else), where the compared operands and the
// returned value are all params (in arg registers, index<4) or integer constants, can check that base case BEFORE
// saving callee-saved regs — its base path becomes `cmp; jcc; mov rax,arg; ret` with NO push/pop. gcc does this;
// for fib it removes 4 memory ops on ~half of all calls (the n<2 leaves).
fn _param_index(params, name) {
    let i = 0; while i < len(params) { if _param_name(params[i]) == name { return i; } i = i + 1; } return 0 - 1;
}
fn _sw_leaf_ok(n, params) {   // a guard leaf must be a constant or an arg-register param (index < 4)
    if n.kind == "number" { return true; }
    if n.kind == "ident" { let pi = _param_index(params, n.name); return pi >= 0 and pi < 4; }
    return false;
}
// Returns {cond, ret} for a shrink-wrappable opening guard, or nil.
fn _shrinkwrap_guard(body, params) {
    if len(body) == 0 { return nil; }
    let s = body[0];
    if s.kind != "if" { return nil; }
    if (try s.else catch nil) != nil { return nil; }
    let then = _stmts_of2(s.then);
    if len(then) != 1 or then[0].kind != "return" { return nil; }
    let ret = try then[0].value catch nil;
    if ret == nil { return nil; }
    ret = _fold(ret);
    let cond = _fold(s.cond);
    if cond.kind != "binary" or _cond_skip_cc(cond.op) == 0 { return nil; }   // must be a comparison
    if not _sw_leaf_ok(cond.left, params) or not _sw_leaf_ok(cond.right, params) or not _sw_leaf_ok(ret, params) { return nil; }
    return map{ cond: cond, ret: ret };
}
fn _argreg_rm(argidx) {   // ModRM rm-byte (mod=11, r/m=arg register) for `<op> rax, argN`
    if argidx == 0 { return 248; }   // rdi (F8)
    if argidx == 1 { return 240; }   // rsi (F0)
    if argidx == 2 { return 208; }   // rdx (D0)
    return 200;                       // rcx (C8)
}
fn _argreg_code(argidx) {   // Hardware register number for the first four SysV integer arguments.
    if argidx == 0 { return 7; }      // rdi
    if argidx == 1 { return 6; }      // rsi
    if argidx == 2 { return 2; }      // rdx
    return 1;                         // rcx
}
fn _sw_operand_to_rax(code, n, params) {   // load a guard leaf (const or arg-register param) into rax
    if n.kind == "number" {
        let v = parse_number(n.value);
        if v == 0 { push(code, 72); push(code, 49); push(code, 192); }             // xor rax, rax
        elif v >= 0 and v < 4294967296 { push(code, 184); _elf.le(code, v, 4); }   // mov eax, imm32
        else { push(code, 72); push(code, 184); _elf.le(code, v, 8); }             // movabs rax, imm64
    } else {
        push(code, 72); push(code, 137); push(code, _argreg_rm(_param_index(params, n.name)));  // mov rax, argreg
    }
}
// Compare an argument register in place. This avoids a move to rax and selects the shortest safe immediate
// encoding. Returning false lets unusual operands use the general fallback below.
fn _sw_direct_cmp(code, left, right, params) {
    if left.kind != "ident" { return false; }
    let li = _param_index(params, left.name);
    if li < 0 or li >= 4 { return false; }
    let lr = _argreg_code(li);
    if right.kind == "number" {
        let rv = parse_number(right.value);
        if rv == 0 {
            push(code, 72); push(code, 133); push(code, 192 + lr * 9);             // test arg, arg
        } elif rv >= 0 - 128 and rv <= 127 {
            let b = rv; if b < 0 { b = b + 256; }
            push(code, 72); push(code, 131); push(code, 248 + lr); push(code, b); // cmp arg, imm8
        } elif rv >= 0 - 2147483648 and rv <= 2147483647 {
            push(code, 72); push(code, 129); push(code, 248 + lr); _elf.le(code, rv, 4); // cmp arg, imm32
        } else { return false; }
        return true;
    }
    if right.kind == "ident" {
        let ri = _param_index(params, right.name);
        if ri < 0 or ri >= 4 { return false; }
        let rr = _argreg_code(ri);
        push(code, 72); push(code, 57); push(code, 192 + rr * 8 + lr);             // cmp left, right
        return true;
    }
    return false;
}
// Emit the guard (base case) BEFORE the reg-save pushes: eval left→rax, cmp with right, jump-if-false past the
// return, then `mov rax,<ret>; ret`. Falls through to the caller-supplied prologue when the guard is false.
fn _emit_shrinkwrap_guard(code, guard, params) {
    if not _sw_direct_cmp(code, guard.cond.left, guard.cond.right, params) {
        _sw_operand_to_rax(code, guard.cond.left, params);
        let r = guard.cond.right;
        if r.kind == "number" {
            let rv = parse_number(r.value);
            if rv == 0 { push(code, 72); push(code, 133); push(code, 192); }       // test rax, rax
            else { push(code, 72); push(code, 61); _elf.le(code, rv, 4); }         // cmp rax, imm32
        } else {
            push(code, 72); push(code, 57); push(code, _argreg_rm(_param_index(params, r.name))); // cmp rax, argreg
        }
    }
    let leaf = [];
    _sw_operand_to_rax(leaf, guard.ret, params);
    push(leaf, 195);                                                               // ret (base case, no regs saved)
    push(code, _cond_skip_cc(guard.cond.op) - 16); push(code, len(leaf));          // short j<inverse> → .cont
    let i = 0; while i < len(leaf) { push(code, leaf[i]); i = i + 1; }
}
// Does the body contain a TAIL-positioned call to a top-level fn (`return f(args)`)? Such a call lowers to a
// frame-teardown (`leave`/reg-restore) that assumes a framed exit, so a fn containing one is NOT frame-free.
fn _has_gen_tailcall(stmts, fnnames) {
    if fnnames == nil { return false; }
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "return" {
            let v = try s.value catch nil;
            if v != nil and v.kind == "call" and v.func.kind == "ident" and map_has(fnnames, v.func.name) { return true; }
        } elif k == "if" {
            if _has_gen_tailcall(_stmts_of2(s.then), fnnames) { return true; }
            let e = try s.else catch nil; if e != nil and _has_gen_tailcall(_stmts_of2(e), fnnames) { return true; }
        } elif k == "while" { if _has_gen_tailcall(_stmts_of2(s.body), fnnames) { return true; } }
        i = i + 1;
    }
    return false;
}
// Collect up to 3 top-level (incl. nested-in-if/while) let/const names → register index 0..2.
// ── HOTNESS-WEIGHTED register promotion ──────────────────────────────────────────────────────────────────────
// Score each variable use by loop nesting (×32 per level), so a HOT loop counter beats a cold var declared
// earlier for the 3 callee-saved slots. A single hot var spilled to memory/global costs ~7× (it also kills the
// recurrence collapse, which needs its vars register-resident) — so picking the right 3 is worth a real pass.
fn _score_expr(node, w, score) {
    if node == nil { return nil; }
    let k = try node.kind catch nil; if k == nil { return nil; }
    if k == "ident" { score[node.name] = (try score[node.name] catch 0) + w; return nil; }
    if k == "binary" { _score_expr(node.left, w, score); _score_expr(node.right, w, score); return nil; }
