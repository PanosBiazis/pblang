// __pb_tcp_connect: rdi = ip (dotted TAG_STR e.g. "127.0.0.1" OR host u32 e.g. 0x7f000001), rsi = port → fd or -1.
fn _emit_rt_tcp_connect(code) {
    let off = len(code);
    push(code, 65); push(code, 84); push(code, 65); push(code, 85);          // push r12; push r13
    push(code, 73); push(code, 137); push(code, 245);                        // mov r13, rsi (port)
    push(code, 72); push(code, 137); push(code, 250);                        // mov rdx, rdi
    push(code, 72); push(code, 193); push(code, 234); push(code, 32);        // shr rdx, 32
    push(code, 15); push(code, 133); let jchk = len(code); _elf.le(code, 0, 4); // jnz .check_tag (heap > 4 GiB)
    push(code, 72); push(code, 129); push(code, 255); _elf.le(code, 4194304, 4); // cmp rdi, 0x400000 (.rodata base)
    push(code, 15); push(code, 130); let jint = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 129); push(code, 255); _elf.le(code, 33554432, 4); // cmp rdi, 0x02000000 (.rodata top)
    push(code, 15); push(code, 131); let jint3 = len(code); _elf.le(code, 0, 4);
    _patch32(code, jchk, len(code) - (jchk + 4));
    push(code, 72); push(code, 131); push(code, 63); push(code, 1);          // cmp qword [rdi], TAG_STR
    push(code, 15); push(code, 133); let jint2 = len(code); _elf.le(code, 0, 4);
    // Parse dotted IPv4 string at [rdi+16], len [rdi+8] → r12d (network byte order)
    push(code, 72); push(code, 139); push(code, 79); push(code, 8);          // mov rcx, [rdi+8]
    push(code, 72); push(code, 141); push(code, 119); push(code, 16);        // lea rsi, [rdi+16]
    push(code, 69); push(code, 49); push(code, 192);                         // xor r8d, r8d (shift = 0)
    push(code, 49); push(code, 210);                                         // xor edx, edx (octet = 0)
    push(code, 69); push(code, 49); push(code, 228);                         // xor r12d, r12d (net_ip = 0)
    let plp = len(code);
    push(code, 72); push(code, 133); push(code, 201);                        // .plp: test rcx, rcx
    push(code, 15); push(code, 132); let jpend = len(code); _elf.le(code, 0, 4); // jz .pend
    push(code, 15); push(code, 182); push(code, 6);                          // movzx eax, byte [rsi]
    push(code, 60); push(code, 46);                                          // cmp al, '.'
    push(code, 15); push(code, 133); let jdig = len(code); _elf.le(code, 0, 4);  // jne .digit
    push(code, 81);                                                          // push rcx
    push(code, 68); push(code, 137); push(code, 193);                        // mov ecx, r8d
    push(code, 211); push(code, 226);                                        // shl edx, cl
    push(code, 65); push(code, 9); push(code, 212);                          // or r12d, edx
    push(code, 65); push(code, 131); push(code, 192); push(code, 8);         // add r8d, 8
    push(code, 49); push(code, 210);                                         // xor edx, edx
    push(code, 89);                                                          // pop rcx
    push(code, 233); let jpnx = len(code); _elf.le(code, 0, 4);              // jmp .pnext
    _patch32(code, jdig, len(code) - (jdig + 4));                            // .digit:
    push(code, 107); push(code, 210); push(code, 10);                        // imul edx, edx, 10
    push(code, 131); push(code, 232); push(code, 48);                        // sub eax, 48
    push(code, 1); push(code, 194);                                          // add edx, eax
    _patch32(code, jpnx, len(code) - (jpnx + 4));                            // .pnext:
    push(code, 72); push(code, 255); push(code, 198);                        // inc rsi
    push(code, 72); push(code, 255); push(code, 201);                        // dec rcx
    push(code, 233); let jplb = len(code); _elf.le(code, 0, 4);              // jmp .plp
    _patch32(code, jplb, plp - (jplb + 4));
    _patch32(code, jpend, len(code) - (jpend + 4));                          // .pend:
    push(code, 68); push(code, 137); push(code, 193);                        // mov ecx, r8d
    push(code, 211); push(code, 226);                                        // shl edx, cl
    push(code, 65); push(code, 9); push(code, 212);                          // or r12d, edx
    push(code, 233); let jhip = len(code); _elf.le(code, 0, 4);              // jmp .have_ip
    _patch32(code, jint, len(code) - (jint + 4));
    _patch32(code, jint2, len(code) - (jint2 + 4));
    _patch32(code, jint3, len(code) - (jint3 + 4));
    push(code, 137); push(code, 248);                                        // mov eax, edi
    push(code, 15); push(code, 200);                                         // bswap eax
    push(code, 65); push(code, 137); push(code, 196);                        // mov r12d, eax
    _patch32(code, jhip, len(code) - (jhip + 4));                            // .have_ip:
    // .have_ip: r12d = net_ip, r13 = port
    push(code, 191); _elf.le(code, 2, 4);
    push(code, 190); _elf.le(code, 1, 4);
    push(code, 49); push(code, 210);
    push(code, 184); _elf.le(code, 41, 4);                                   // SYS_socket
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 136); let jfe = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 131); push(code, 236); push(code, 16);        // sub rsp, 16
    push(code, 49); push(code, 201);
    push(code, 72); push(code, 137); push(code, 12); push(code, 36);
    push(code, 72); push(code, 137); push(code, 76); push(code, 36); push(code, 8);
    push(code, 198); push(code, 4); push(code, 36); push(code, 2);           // AF_INET
    push(code, 76); push(code, 137); push(code, 233);                        // mov rcx, r13 (port)
    push(code, 136); push(code, 76); push(code, 36); push(code, 3);
    push(code, 193); push(code, 233); push(code, 8);
    push(code, 136); push(code, 76); push(code, 36); push(code, 2);
    push(code, 68); push(code, 137); push(code, 100); push(code, 36); push(code, 4); // mov [rsp+4], r12d (sin_addr)
    push(code, 73); push(code, 137); push(code, 196);                        // mov r12, rax (fd)
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12
    push(code, 72); push(code, 137); push(code, 230);                        // mov rsi, rsp
    push(code, 186); _elf.le(code, 16, 4);
    push(code, 184); _elf.le(code, 42, 4);                                   // SYS_connect
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 131); push(code, 196); push(code, 16);        // add rsp, 16
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 136); let jcf = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 137); push(code, 224);                        // mov rax, r12
    push(code, 65); push(code, 93); push(code, 65); push(code, 92);
    push(code, 195);
    _patch32(code, jcf, len(code) - (jcf + 4));
    push(code, 76); push(code, 137); push(code, 231);
    push(code, 184); _elf.le(code, 3, 4);
    push(code, 15); push(code, 5);
    _patch32(code, jfe, len(code) - (jfe + 4));
    push(code, 72); push(code, 199); push(code, 192); _elf.le(code, 0 - 1, 4);
    push(code, 65); push(code, 93); push(code, 65); push(code, 92);
    push(code, 195);
    return off;
}
// __pb_tcp_read: rdi = fd, rsi = max_len → returns TAG_STR in rax.
fn _emit_rt_tcp_read(code) {
    let off = len(code);
    push(code, 65); push(code, 86);                                          // push r14
    push(code, 77); push(code, 137); push(code, 254);                        // mov r14, r15
    push(code, 72); push(code, 137); push(code, 242);                        // mov rdx, rsi (max_len)
    push(code, 73); push(code, 141); push(code, 118); push(code, 16);        // lea rsi, [r14+16]
    push(code, 49); push(code, 192);                                         // xor eax, eax (SYS_read)
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 133); push(code, 192);                        // test rax, rax
    push(code, 121); push(code, 2);                                          // jns +2
    push(code, 49); push(code, 192);                                         // xor eax, eax
    push(code, 73); push(code, 199); push(code, 6); _elf.le(code, 1, 4);     // mov qword [r14], TAG_STR
    push(code, 73); push(code, 137); push(code, 70); push(code, 8);          // mov [r14+8], rax
    push(code, 65); push(code, 198); push(code, 68); push(code, 6); push(code, 16); push(code, 0); // mov byte [r14+rax+16], 0
    push(code, 73); push(code, 141); push(code, 76); push(code, 6); push(code, 24); // lea rcx, [r14+rax+24]
    push(code, 72); push(code, 131); push(code, 225); push(code, 248);       // and rcx, -8
    push(code, 73); push(code, 137); push(code, 207);                        // mov r15, rcx
    push(code, 76); push(code, 137); push(code, 240);                        // mov rax, r14
    push(code, 65); push(code, 94);                                          // pop r14
    push(code, 195);                                                         // ret
    return off;
}

// Cheney semi-space compacting collector + slide-back + SYS_madvise(MADV_DONTNEED=4) RSS release!
// r8=arena_base, r9=old_r15, r10=to_base, r11=free_ptr, rbx=delta(to_base-arena_base); r14 scratch in evac_slot.
fn _emit_rt_evac_slot(code) {
    let off = len(code);
    push(code, 72); push(code, 139); push(code, 7);                          // mov rax, [rdi]
    push(code, 76); push(code, 57); push(code, 192);                         // cmp rax, r8 (arena_base)
    push(code, 15); push(code, 130); let jr0 = len(code); _elf.le(code, 0, 4); // jb .ret
    push(code, 76); push(code, 57); push(code, 200);                         // cmp rax, r9 (old_r15)
    push(code, 15); push(code, 131); let jr1 = len(code); _elf.le(code, 0, 4); // jae .ret
    push(code, 168); push(code, 7);                                          // test al, 7
    push(code, 15); push(code, 133); let jr2 = len(code); _elf.le(code, 0, 4); // jnz .ret
    push(code, 72); push(code, 139); push(code, 8);                          // mov rcx, [rax] (tag)
    push(code, 72); push(code, 131); push(code, 249); push(code, 99);        // cmp rcx, 99 (forwarded?)
    push(code, 117); push(code, 8);                                          // jne .notfwd (+8)
    push(code, 72); push(code, 139); push(code, 80); push(code, 8);          // mov rdx, [rax+8]
    push(code, 72); push(code, 137); push(code, 23);                         // mov [rdi], rdx
    push(code, 195);                                                         // ret
    // .notfwd:
    push(code, 72); push(code, 131); push(code, 249); push(code, 1);         // cmp rcx, 1
    push(code, 15); push(code, 130); let jr3 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 131); push(code, 249); push(code, 5);         // cmp rcx, 5
    push(code, 15); push(code, 135); let jr4 = len(code); _elf.le(code, 0, 4);
    push(code, 77); push(code, 137); push(code, 222);                        // mov r14, r11 (dst in to-space)
    push(code, 76); push(code, 137); push(code, 218);                        // mov rdx, r11
    push(code, 72); push(code, 41); push(code, 218);                         // sub rdx, rbx (final_addr)
    push(code, 72); push(code, 137); push(code, 23);                         // mov [rdi], rdx
    // Dispatch on tag rcx in 1..5
    push(code, 72); push(code, 131); push(code, 249); push(code, 1);         // TAG_STR = 1
    push(code, 15); push(code, 133); let jt2 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 112); push(code, 8);         // mov rsi, [rax+8] (slen)
    push(code, 72); push(code, 141); push(code, 78); push(code, 24);         // lea rcx, [rsi+24]
    push(code, 72); push(code, 131); push(code, 225); push(code, 248);       // and rcx, -8
    push(code, 73); push(code, 1); push(code, 203);                          // add r11, rcx
    push(code, 72); push(code, 193); push(code, 233); push(code, 3);         // shr rcx, 3
    push(code, 72); push(code, 137); push(code, 198);                        // mov rsi, rax
    push(code, 76); push(code, 137); push(code, 247);                        // mov rdi, r14
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);       // cld; rep movsq
    push(code, 233); let jfw1 = len(code); _elf.le(code, 0, 4);

