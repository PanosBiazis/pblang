    let names = map_keys(helpers);
    let uses_maps = len(str_split(src, "map{")) > 1 or len(str_split(src, "[")) > 1 or len(str_split(src, "str_split")) > 1 or len(str_split(src, "map_remove")) > 1 or len(str_split(src, "delete(")) > 1;
