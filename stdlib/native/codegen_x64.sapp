}
fn _emit_rt_gc_collect(code, nglobals, init_rsp_addr, arena_base_addr, exc_val_addr, calls) {
    let evac_off = _emit_rt_evac_slot(code);
    let off = len(code);
    push(code, 83); push(code, 85); push(code, 65); push(code, 84); push(code, 65); push(code, 85); push(code, 65); push(code, 86); // push rbx, rbp, r12, r13, r14
    push(code, 73); push(code, 137); push(code, 229);                        // mov r13, rsp (stack scan start)
    push(code, 72); push(code, 184); _elf.le(code, arena_base_addr, 8);      // movabs rax, arena_base_addr
    push(code, 76); push(code, 139); push(code, 0);                          // mov r8, [rax] (arena_base)
    push(code, 77); push(code, 137); push(code, 249);                        // mov r9, r15   (old_r15)
    push(code, 77); push(code, 57); push(code, 193);                         // cmp r9, r8
    push(code, 15); push(code, 134); let jempty = len(code); _elf.le(code, 0, 4); // jbe .empty
    // to_base = (old_r15 + 4095) & -4096
    push(code, 73); push(code, 141); push(code, 129); _elf.le(code, 4095, 4);// lea rax, [r9+4095]
    push(code, 72); push(code, 37); _elf.le(code, 0 - 4096, 4);              // and rax, -4096
    push(code, 73); push(code, 137); push(code, 194);                        // mov r10, rax (to_base)
    push(code, 73); push(code, 137); push(code, 195);                        // mov r11, rax (free_ptr)
    push(code, 72); push(code, 137); push(code, 195);                        // mov rbx, rax
    push(code, 76); push(code, 41); push(code, 195);                         // sub rbx, r8  (delta = to_base - arena_base)

    // 1. Scan global variable slots [_GBASE .. _GBASE + nglobals*8)
    if nglobals > 0 {
        push(code, 72); push(code, 189); _elf.le(code, _GBASE(), 8);         // movabs rbp, GBASE
        push(code, 73); push(code, 188); _elf.le(code, _GBASE() + nglobals * 8, 8); // movabs r12, GBASE+nglobals*8
        let glp = len(code);
        push(code, 76); push(code, 57); push(code, 229);                     // .glp: cmp rbp, r12
        push(code, 15); push(code, 131); let jgd = len(code); _elf.le(code, 0, 4);
        push(code, 72); push(code, 137); push(code, 239);                    // mov rdi, rbp
        push(code, 232); let ce1 = len(code); _elf.le(code, 0, 4); _patch32(code, ce1, evac_off - (ce1 + 4));
        push(code, 72); push(code, 131); push(code, 197); push(code, 8);     // add rbp, 8
        push(code, 233); let jgb = len(code); _elf.le(code, 0, 4); _patch32(code, jgb, glp - (jgb + 4));
        _patch32(code, jgd, len(code) - (jgd + 4));
