    _patch32(code, jerr, len(code) - (jerr + 4));
    push(code, 65); push(code, 94); push(code, 65); push(code, 93); push(code, 65); push(code, 92);
    if uses_exc {
        push(code, 184); _elf.le(code, 2, 4);                                // mov eax, 2 (ENOENT)
        push(code, 233); let jt = len(code); _elf.le(code, 0, 4);
