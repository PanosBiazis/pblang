}
fn _store_rax_slot(code, slots, name) {
    let ri = _reg_of(slots, name);
    if ri >= 0 { _reg_st(code, ri); return; }               // register-allocated local
    let g = try slots.globals catch nil;                    // a top-level global (not shadowed by a local)
    if g != nil and map_has(g, name) and not map_has(slots.names, name) { _emit_global_store(code, g[name]); return; }
    let i = _slot_of(slots, name);
