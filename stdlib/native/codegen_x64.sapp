fn _reg_pop_all(code, slots) {   // exact reverse of _reg_push_all
    if _uses_r14_tmp(slots) { push(code, 65); push(code, 94); }           // pop r14  (41 5E)
    let n = _reg_count(slots); let i = n - 1;
    while i >= 0 { push(code, 65); push(code, 92 + i); i = i - 1; }        // pop r(12+i)  (41 5C/5D/5E)
