    push(code, 72); push(code, 131); push(code, 248); push(code, 3);
    push(code, 15); push(code, 133); let jct4 = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 141); push(code, 101); push(code, 32);        // lea r12, [rbp+32]
    push(code, 76); push(code, 139); push(code, 109); push(code, 8);         // mov r13, [rbp+8] (count)
    push(code, 73); push(code, 209); push(code, 229);                        // shl r13, 1 (count*2 qwords)
    let cmlp = len(code);
    push(code, 77); push(code, 133); push(code, 237);
    push(code, 116); push(code, 17);
    push(code, 76); push(code, 137); push(code, 231);
    push(code, 232); let cem = len(code); _elf.le(code, 0, 4); _patch32(code, cem, evac_off - (cem + 4));
    push(code, 73); push(code, 131); push(code, 196); push(code, 8);
    push(code, 73); push(code, 255); push(code, 205);
    push(code, 235); push(code, cmlp - (len(code) + 1) + 256);
    push(code, 72); push(code, 139); push(code, 77); push(code, 16);         // mov rcx, [rbp+16] (cap)
    push(code, 72); push(code, 193); push(code, 225); push(code, 4);         // shl rcx, 4
    push(code, 72); push(code, 131); push(code, 193); push(code, 32);        // add rcx, 32
    push(code, 72); push(code, 1); push(code, 205);                          // add rbp, rcx
    push(code, 233); let jcb3 = len(code); _elf.le(code, 0, 4); _patch32(code, jcb3, clp - (jcb3 + 4));

