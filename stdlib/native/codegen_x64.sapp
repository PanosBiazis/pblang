// Compile `src` into raw x86-64 `.text + .rodata` bytes starting at virtual address `code_vaddr`.
// `dyn_plt` is nil for static freestanding ELF64, or `map{ dlopen, dlsym, dlclose }` for dynamic ELF64 (`elf_dyn_x64`).
fn compile_x64_raw(src, code_vaddr, dyn_plt) {
    let ast = _SOURCE.parse_source(src);
    let code = [];
    let calls = [];
    let labels = map{};
    let fns = [];
    let inlines = map{};
    let p = 0;
    while p < len(ast.stmts) {
        let s = ast.stmts[p];
        if s.kind == "fn" {
            push(fns, s);
            let e = _inlinable_expr(s);
            if e != nil { inlines[s.name] = map{ params: s.params, expr: e }; }
        }
        p = p + 1;
    }
    let defined = map{}; let di = 0;
    while di < len(fns) { defined[fns[di].name] = true; di = di + 1; }
    _inject_prelude(src, fns, inlines, defined);
    let strings = map{ data: [], patches: [] };
    let keyids = map{};
    let funlits = [];
    let globals = map{}; let gp = 0;
    while gp < len(ast.stmts) {
        let s = ast.stmts[gp];
        if (s.kind == "let" or s.kind == "const") and not map_has(globals, s.name) { globals[s.name] = len(globals); }
        gp = gp + 1;
    }
    let nglobals = len(globals);
    let sl = _collect_strlits(ast.stmts, fns);
    let strlits = sl.idx; let litlist = sl.list; let nlits = len(litlist);
    let fnnames = map{}; let fni = 0; while fni < len(fns) { fnnames[fns[fni].name] = true; fni = fni + 1; }

    // Demand-detect exception unwinding, GC compaction, and CLI argv capture so minimal programs (e.g. fib) pay zero bytes.
    let mainstmts = [];
    let mj = 0;
    while mj < len(ast.stmts) { if ast.stmts[mj].kind != "fn" { push(mainstmts, ast.stmts[mj]); } mj = mj + 1; }
    let uses_exc = _stmts_have_general_try(mainstmts) or len(str_split(src, "caught_error")) > 1;
    let fxi = 0;
    while fxi < len(fns) and not uses_exc {
        if _stmts_have_general_try(_stmts_of2(fns[fxi].body)) { uses_exc = true; }
        fxi = fxi + 1;
    }
    let uses_gc = len(str_split(src, "gc_collect")) > 1 or len(str_split(src, "gc_reset_scratch")) > 1;
    let uses_arena_used = uses_gc or len(str_split(src, "gc_arena_used")) > 1;
    let uses_os_args = len(str_split(src, "os_args")) > 1 or len(str_split(src, "args(")) > 1;
    let need_init_rsp = uses_gc or uses_os_args;

    let nsys = 0;
    let init_rsp_addr = 0;
    let arena_base_addr = 0;
    let exc_top_addr = 0;
    let exc_val_addr = 0;
    if need_init_rsp { init_rsp_addr = _GBASE() + (nglobals + nlits + nsys) * 8; nsys = nsys + 1; }
    if uses_arena_used { arena_base_addr = _GBASE() + (nglobals + nlits + nsys) * 8; nsys = nsys + 1; }
    if uses_exc {
        exc_top_addr = _GBASE() + (nglobals + nlits + nsys) * 8; nsys = nsys + 1;
        exc_val_addr = _GBASE() + (nglobals + nlits + nsys) * 8; nsys = nsys + 1;
    }

    let ctx = map{
        calls: calls, inlines: inlines, strings: strings, keyids: keyids, funlits: funlits,
        globals: globals, fnnames: fnnames, strlits: strlits, litbase: nglobals,
        uses_exc: uses_exc, uses_gc: uses_gc,
        init_rsp_addr: init_rsp_addr, arena_base_addr: arena_base_addr,
        exc_top_addr: exc_top_addr, exc_val_addr: exc_val_addr,
        dyn_plt: dyn_plt
    };

    // Save initial stack pointer (`[argc, argv...]`) before mmap if needed.
    if need_init_rsp { push(code, 84); }                                     // push rsp
    // ---- heap: mmap 1 GiB arena at _GBASE (MAP_FIXED, lazy) + contiguous fail-closed mmap_guard ----
    push(code, 72); push(code, 191); _elf.le(code, _GBASE(), 8);            // movabs rdi, GBASE
    push(code, 190); _elf.le(code, _HEAPSZ(), 4);                           // mov esi, arena size
    push(code, 106); push(code, 3); push(code, 90);                          // push 3; pop rdx
    push(code, 106); push(code, 50); push(code, 65); push(code, 90);         // push 50; pop r10
    push(code, 106); push(code, 255); push(code, 65); push(code, 88);        // push -1; pop r8
    push(code, 69); push(code, 49); push(code, 201);                        // xor r9d, r9d
    push(code, 184); _elf.le(code, 9, 4);                                   // mov eax, 9 (SYS_mmap)
    push(code, 15); push(code, 5);                                         // syscall
    push(code, 72); push(code, 133); push(code, 192);                       // test rax, rax
    push(code, 121); push(code, 2);                                        // jns +2
    push(code, 15); push(code, 11);                                        // ud2 (mapping failure)
    push(code, 73); push(code, 137); push(code, 199);                       // mov r15, rax
    let nreserve = nglobals + nlits + nsys;
    if nreserve > 0 { push(code, 73); push(code, 129); push(code, 199); _elf.le(code, nreserve * 8, 4); }
    if need_init_rsp {
        push(code, 88);                                                      // pop rax (initial rsp)
        push(code, 72); push(code, 185); _elf.le(code, init_rsp_addr, 8);
        push(code, 72); push(code, 137); push(code, 1);                      // mov [init_rsp_addr], rax
    }
    let li = 0;
    while li < nlits { _emit_intern_one(code, litlist[li], _GBASE() + (nglobals + li) * 8); li = li + 1; }
    if uses_arena_used {
        push(code, 72); push(code, 185); _elf.le(code, arena_base_addr, 8);
        push(code, 76); push(code, 137); push(code, 57);                     // mov [rcx], r15 (arena_base after interned lits)
    }

    let strtypes = _analyze_str_types(mainstmts, fns);
    ctx.fnstr = strtypes.fnstr;
    let strfields = _collect_strfields(mainstmts, fns, strtypes);
    ctx.strfields = strfields;

    let mboxed = _find_boxed_vars([], mainstmts, globals);
    let mregvars = map{};
    if not _stmts_have_general_try(mainstmts) {
        let fn_refs = map{}; let fri = 0;
        while fri < len(fns) { _ai_stmts(_stmts_of2(fns[fri].body), fn_refs); fri = fri + 1; }
        _funlit_idents_stmts(mainstmts, fn_refs);
        let mranked = _ranked_locals(mainstmts, _copy_bmap(mboxed)); let mri = 0;
        while mri < len(mranked) and len(mregvars) < 3 {
            let nm = mranked[mri];
            let promotable = (not map_has(globals, nm)) or (not map_has(fn_refs, nm));
            if promotable and not map_has(mboxed, nm) { mregvars[nm] = len(mregvars); }
            mri = mri + 1;
        }
    }
    push(code, 72); push(code, 137); push(code, 229);                       // mov rbp, rsp
    push(code, 72); push(code, 129); push(code, 236); let mframe_at = len(code); _elf.le(code, 512, 4);
    let mzero_at = 0 - 1;
    if uses_gc {
        push(code, 49); push(code, 192);                                    // xor eax, eax
        push(code, 65); push(code, 186); mzero_at = len(code); _elf.le(code, 1, 4); // mov r10d, <qwords> (backpatched)
        push(code, 74); push(code, 137); push(code, 68); push(code, 212); push(code, 248); // .zl: mov [rsp+r10*8-8], rax
        push(code, 73); push(code, 255); push(code, 202);                   // dec r10
        push(code, 117); push(code, 246);                                   // jnz .zl (-10)
        push(code, 69); push(code, 49); push(code, 228);                    // xor r12d, r12d
        push(code, 69); push(code, 49); push(code, 237);                    // xor r13d, r13d
        push(code, 69); push(code, 49); push(code, 246);                    // xor r14d, r14d
    }
    let mslots = map{
        names: map{}, n: 0, inlines: inlines, strings: strings, regvars: mregvars,
        uses_tmp: _stmts_use_tmp(mainstmts), tmpd: 0, keyids: keyids, funlits: funlits,
        strvars: map{}, ranges: map{}, fnstr: strtypes.fnstr, loops: [], try_stack: [],
        globals: globals, fnnames: fnnames, strfields: strfields, strlits: strlits,
        litbase: nglobals, boxed: mboxed, boxcaps: map{},
        uses_exc: uses_exc, exc_top_addr: exc_top_addr, exc_val_addr: exc_val_addr,
        arena_base_addr: arena_base_addr, dyn_plt: dyn_plt
    };
    mslots.n = _regsave_reserve(mslots);
    if uses_gc and mslots.n == 0 { mslots.n = 2; }                          // ensure >=16B when mzero loop present
    _reg_save_all(code, mslots);
    let i = 0;
    while i < len(ast.stmts) {
        let s = ast.stmts[i];
        if s.kind != "fn" { _gsr(s, code, mslots, calls, false); }
        i = i + 1;
    }
    _check_frame(mslots.n, "<main>");
    let mframe = 8 * mslots.n; if mframe % 16 != 0 { mframe = mframe + (16 - (mframe % 16)); }
    _patch32(code, mframe_at, mframe);
    if mzero_at >= 0 { _patch32(code, mzero_at, (mframe - (mframe % 8)) / 8); }
    push(code, 191); _elf.le(code, 0, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // exit(0)

    let fi = 0;
    while fi < len(fns) {
        let fn_node = fns[fi];
        let spars = try strtypes.fnspars[fn_node.name] catch map{};
        labels[fn_node.name] = _emit_fn(code, fn_node.params, _stmts_of2(fn_node.body), ctx, [], map{ spars: spars, fnname: fn_node.name });
        fi = fi + 1;
    }
    let fp = 0;
    while fp < len(funlits) {
        let fl = funlits[fp];
        let foff = _emit_fn(code, fl.params, fl.body, ctx, fl.caps, map{ scaps: try fl.scaps catch map{}, spars: try fl.spars catch map{}, boxcaps: try fl.boxcaps catch map{} });
        let addr = code_vaddr + foff;
        let v = addr; let bx = 0;
        while bx < 8 { let bb = v % 256; code[fl.at + bx] = bb; v = (v - bb) / 256; bx = bx + 1; }
        fp = fp + 1;
    }

    // ---- Emit only referenced freestanding x86-64 runtime routines ----
    // Order handles internal helper dependencies (__pb_fs_read_bytes -> __pb_fs_read -> __pb_throw; __pb_os_args -> __pb_cstr_read; __pb_trap134 -> __pb_throw).
    if _calls_have(calls, "__pb_fs_read_bytes") { labels["__pb_fs_read_bytes"] = _emit_rt_fs_read_bytes(code, calls); }
    if _calls_have(calls, "__pb_fs_read") { labels["__pb_fs_read"] = _emit_rt_fs_read(code, uses_exc, calls); }
    if _calls_have(calls, "__pb_fs_write") { labels["__pb_fs_write"] = _emit_rt_fs_write(code); }
    if _calls_have(calls, "__pb_fs_write_bytes") { labels["__pb_fs_write_bytes"] = _emit_rt_fs_write_bytes(code); }
    if _calls_have(calls, "__pb_os_args") { labels["__pb_os_args"] = _emit_rt_os_args(code, init_rsp_addr, calls); }
    if _calls_have(calls, "__pb_cstr_read") { labels["__pb_cstr_read"] = _emit_rt_cstr_read(code); }
    if _calls_have(calls, "__pb_tcp_listen") { labels["__pb_tcp_listen"] = _emit_rt_tcp_listen(code); }
    if _calls_have(calls, "__pb_tcp_connect") { labels["__pb_tcp_connect"] = _emit_rt_tcp_connect(code); }
    if _calls_have(calls, "__pb_tcp_read") { labels["__pb_tcp_read"] = _emit_rt_tcp_read(code); }
    if _calls_have(calls, "__pb_gc_collect") { labels["__pb_gc_collect"] = _emit_rt_gc_collect(code, nglobals, init_rsp_addr, arena_base_addr, exc_val_addr, calls); }
    if _calls_have(calls, "__pb_trap134") { labels["__pb_trap134"] = _emit_rt_trap134(code, exc_top_addr, calls); }
    if _calls_have(calls, "__pb_throw") { labels["__pb_throw"] = _emit_rt_throw(code, exc_top_addr, exc_val_addr); }

    let ci = 0;
    while ci < len(calls) {
        let c = calls[ci];
        let target = try labels[c.name] catch nil;
        if target == nil { throw "codegen: call to undefined fn " + c.name; }
        _patch32(code, c.at, target - (c.at + 4));
        ci = ci + 1;
    }
    let dbase = code_vaddr + len(code);
    let si = 0;
    while si < len(strings.patches) {
        let pt = strings.patches[si];
        let v = dbase + pt.off; let bi = 0;
        while bi < 8 { let bb = v % 256; code[pt.at + bi] = bb; v = (v - bb) / 256; bi = bi + 1; }
        si = si + 1;
    }
    let ddi = 0;
    while ddi < len(strings.data) { push(code, strings.data[ddi]); ddi = ddi + 1; }
    return code;
}

fn compile_fns(src) {
    return _elf.wrap_elf(compile_x64_raw(src, 4194304 + 120, nil));
}

// ── SAFETY PASS ───────────────────────────────────────────────────────────────
fn compile_safe(src) {
    let bin = compile_fns(src);
    return map{
        binary: bin,
        safe: true,
        safety_scope: "selected_runtime_checks",
        memory_safety_certified: false,
        runtime_isolated: false,
        heap_reserve_bytes: _HEAPSZ(),
        guarantees: [
            "array reads and writes through valid generated handles check bounds (exit 134)",
            "map access through valid generated handles checks for missing keys",
            "stack frames are size-guarded — refuses >1024 slots instead of smashing the stack",
            "heap mmap failure is checked before the returned address becomes the allocation pointer",
            "type predicates require all eight tag bytes to fit in the mapped arena"
        ],
        limitations: [
            "numbers, booleans, nil and pointers do not have distinct runtime tags",
            "dynamic headers and forged or interior object pointers are not authenticated",
            "arena reset marks and object lifetimes are not validated",
            "hard heap, stack and wall-clock isolation is not established"
        ]
    };
}

export compile_expr_exit, compile_program, compile_fns, compile_x64_raw, compile_safe, set_overflow_check;
export heap_reserve_bytes, set_heap_reserve;

