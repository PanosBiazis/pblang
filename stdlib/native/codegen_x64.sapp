    push(code, 72); push(code, 139); push(code, 18);                         // mov rdx, [rdx] (prev)
    push(code, 72); push(code, 185); _elf.le(code, exc_top, 8);              // movabs rcx, _G_EXC_TOP
    push(code, 72); push(code, 137); push(code, 17);                         // mov [rcx], rdx
}

// Is `node` STATICALLY a boolean (always evaluates to 0/1 that should print as true/false)?
fn _is_bool_expr(node) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "bool" { return true; }
    if k == "unary" and (node.op == "not" or node.op == "!") { return true; }
    if k == "binary" {
        let op = node.op;
        return op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!=";
    }
    return false;
}
fn _is_str(node, slots) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "string" { return true; }
    if k == "ident" { let sv = try slots.strvars catch nil; if sv != nil and map_has(sv, node.name) { return true; } return false; }
    if k == "binary" and node.op == "+" { return _is_str(node.left, slots) and _is_str(node.right, slots); }
    if k == "index" and node.index.kind != "string" {
        if _is_str(node.obj, slots) { return true; }                        // s[i] of a string → 1-char string
        let sa = try slots.strarrs catch nil;                               // arr[i] of a string-array
        if sa != nil and node.obj.kind == "ident" and map_has(sa, node.obj.name) { return true; }
        return false;
    }
    if k == "member" {
        let sf0 = try slots.strfields catch nil;
        if sf0 != nil and map_has(sf0, node.name) { return true; }
        return false;
    }
    if k == "index" and node.index.kind == "string" {
        let sf1 = try slots.strfields catch nil;
        if sf1 != nil and map_has(sf1, node.index.value) { return true; }
        return false;
    }
    if k == "call" and (try node.block_expr catch false) {
        if not (try node.block_tail catch false) { return false; }
        let bst = _stmts_of2(node.func.body);
        if len(bst) > 0 and bst[len(bst) - 1].kind == "return" { return _is_str(bst[len(bst) - 1].value, slots); }
        return false;
    }
    if k == "call" and node.func.kind == "ident" {
        let fnm = node.func.name;
        if fnm == "str" or fnm == "str_slice" or fnm == "slice" or fnm == "strfromcharcode"
           or fnm == "fs_read" or fnm == "tcp_read" or fnm == "cstr_read" or fnm == "cstr_to_str" or fnm == "caught_error" { return true; }
        let fs = try slots.fnstr catch nil;
        if fs != nil and map_has(fs, fnm) { return true; }
    }
    if k == "try" {
        if _is_str(node.body, slots) { return true; }
        if node.handler != nil and _is_str(node.handler, slots) { return true; }
        return false;
    }
    if k == "if_expr" {
        let tv = _block_val_expr(node.then); let els = try node.else catch nil;
        if tv == nil or els == nil { return false; }
        let ev = _block_val_expr(els); if ev == nil { return false; }
        return _is_str(tv, slots) and _is_str(ev, slots);
    }
    return false;
}

// ── INTERPROCEDURAL STRING-TYPE INFERENCE ─────────────────────────────────────
fn _expr_is_str(node, env, fnstr) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "string" { return true; }
    if k == "ident" { let v = try env[node.name] catch nil; if v == true { return true; } return false; }
    if k == "binary" and node.op == "+" { return _expr_is_str(node.left, env, fnstr) and _expr_is_str(node.right, env, fnstr); }
    if k == "call" and (try node.block_expr catch false) {
        if not (try node.block_tail catch false) { return false; }
        let bst = _stmts_of2(node.func.body);
        if len(bst) > 0 and bst[len(bst) - 1].kind == "return" { return _expr_is_str(bst[len(bst) - 1].value, env, fnstr); }
        return false;
    }
    if k == "call" and node.func.kind == "ident" {
        let fnm = node.func.name;
        if fnm == "str" or fnm == "str_slice" or fnm == "slice" or fnm == "strfromcharcode"
           or fnm == "fs_read" or fnm == "tcp_read" or fnm == "cstr_read" or fnm == "cstr_to_str" or fnm == "caught_error" { return true; }
        if map_has(fnstr, fnm) { return true; }
    }
    if k == "try" {
        if _expr_is_str(node.body, env, fnstr) { return true; }
        if node.handler != nil and _expr_is_str(node.handler, env, fnstr) { return true; }
        return false;
    }
    return false;
}
fn _unify_expr(node, env, fnstr) {
    if not is_map(node) { return nil; }
    let k = try node.kind catch nil;
    if k == "binary" {
        _unify_expr(node.left, env, fnstr); _unify_expr(node.right, env, fnstr);
        if node.op == "+" or node.op == "==" or node.op == "!=" {
            if _expr_is_str(node.left, env, fnstr) and node.right.kind == "ident" { env[node.right.name] = true; }
            if _expr_is_str(node.right, env, fnstr) and node.left.kind == "ident" { env[node.left.name] = true; }
        }
        return nil;
    }
    if k == "unary" { _unify_expr(node.operand, env, fnstr); return nil; }
    if k == "call" { let i = 0; while i < len(node.args) { _unify_expr(node.args[i], env, fnstr); i = i + 1; } return nil; }
    if k == "index" { _unify_expr(node.obj, env, fnstr); _unify_expr(node.index, env, fnstr); return nil; }
    if k == "member" { _unify_expr(node.obj, env, fnstr); return nil; }
    if k == "array" { let i = 0; while i < len(node.items) { _unify_expr(node.items[i], env, fnstr); i = i + 1; } return nil; }
    if k == "try" { _unify_expr(node.body, env, fnstr); if node.handler != nil { _unify_expr(node.handler, env, fnstr); } return nil; }
    return nil;
}
fn _mark_calls_str(node, env, fnstr, strparams) {
    if not is_map(node) { return nil; }
    let k = try node.kind catch nil;
    if k == "call" {
        if node.func.kind == "ident" {
            let fname = node.func.name; let i = 0;
            while i < len(node.args) {
                if _expr_is_str(node.args[i], env, fnstr) {
                    let sp = try strparams[fname] catch nil;
                    if sp == nil { sp = map{}; strparams[fname] = sp; }
                    sp[str(i)] = true;
                }
                i = i + 1;
            }
        }
        let j = 0; while j < len(node.args) { _mark_calls_str(node.args[j], env, fnstr, strparams); j = j + 1; }
        _mark_calls_str(node.func, env, fnstr, strparams); return nil;
    }
    if k == "binary" { _mark_calls_str(node.left, env, fnstr, strparams); _mark_calls_str(node.right, env, fnstr, strparams); return nil; }
    if k == "unary" { _mark_calls_str(node.operand, env, fnstr, strparams); return nil; }
    if k == "index" { _mark_calls_str(node.obj, env, fnstr, strparams); _mark_calls_str(node.index, env, fnstr, strparams); return nil; }
    if k == "member" { _mark_calls_str(node.obj, env, fnstr, strparams); return nil; }
    if k == "array" { let i = 0; while i < len(node.items) { _mark_calls_str(node.items[i], env, fnstr, strparams); i = i + 1; } return nil; }
    if k == "try" { _mark_calls_str(node.body, env, fnstr, strparams); if node.handler != nil { _mark_calls_str(node.handler, env, fnstr, strparams); } return nil; }
    return nil;
}
fn _return_fnlit(body) {
    let stmts = _stmts_of2(body); let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        if s.kind == "return" { let v = try s.value catch nil; if is_map(v) and (try v.kind catch nil) == "fn_lit" { return v; } }
        i = i + 1;
    }
    return nil;
}
fn _scan_stmts_str(stmts, env, fnstr, strparams) {
    let ret_str = false; let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" {
            let v = try s.value catch nil;
            if v != nil {
                _mark_calls_str(v, env, fnstr, strparams); _unify_expr(v, env, fnstr);
                if is_map(v) and (try v.kind catch nil) == "fn_lit" {
                    let fvb = _stmts_of2(v.body);
                    let fvs = _free_vars(v.params, fvb); let cenv = map{}; let fj = 0;
                    while fj < len(fvs) { if (try env[fvs[fj]] catch nil) == true { cenv[fvs[fj]] = true; } fj = fj + 1; }
                    if _scan_stmts_str(fvb, cenv, fnstr, strparams) { fnstr[s.name] = true; }
                    let rfl2 = _return_fnlit(v.body);
                    if rfl2 != nil {
                        let rvs2 = _free_vars(rfl2.params, _stmts_of2(rfl2.body)); let cen2 = map{}; let rk = 0;
                        while rk < len(rvs2) { if (try cenv[rvs2[rk]] catch nil) == true { cen2[rvs2[rk]] = true; } rk = rk + 1; }
                        if _scan_stmts_str(_stmts_of2(rfl2.body), cen2, fnstr, strparams) { fnstr["@factory@" + s.name] = true; }
                    }
                }
                if is_map(v) and (try v.kind catch nil) == "call" and v.func.kind == "ident" and map_has(fnstr, "@factory@" + v.func.name) { fnstr[s.name] = true; }
                env[s.name] = _expr_is_str(v, env, fnstr);
            }
        } else { if k == "return" {
            let v = try s.value catch nil;
            if v != nil { _mark_calls_str(v, env, fnstr, strparams); _unify_expr(v, env, fnstr); if _expr_is_str(v, env, fnstr) { ret_str = true; } }
        } else { if k == "print" {
            let v = try s.value catch nil; if v != nil { _mark_calls_str(v, env, fnstr, strparams); _unify_expr(v, env, fnstr); }
        } else { if k == "expr_stmt" {
            let v = try s.expr catch nil; if v != nil { _mark_calls_str(v, env, fnstr, strparams); _unify_expr(v, env, fnstr); }
        } else { if k == "assign" {
            let v = try s.value catch nil; if v != nil { _mark_calls_str(v, env, fnstr, strparams); _unify_expr(v, env, fnstr); }
        } else { if k == "if" {
            _mark_calls_str(s.cond, env, fnstr, strparams); _unify_expr(s.cond, env, fnstr);
            if _scan_stmts_str(_stmts_of2(s.then), env, fnstr, strparams) { ret_str = true; }
            let elifs = try s.elifs catch nil;
            if elifs != nil { let ei = 0; while ei < len(elifs) {
                _mark_calls_str(elifs[ei].cond, env, fnstr, strparams); _unify_expr(elifs[ei].cond, env, fnstr);
                if _scan_stmts_str(_stmts_of2(elifs[ei].body), env, fnstr, strparams) { ret_str = true; }
                ei = ei + 1; } }
            let els = try s.else catch nil;
            if els != nil { if _scan_stmts_str(_stmts_of2(els), env, fnstr, strparams) { ret_str = true; } }
        } else { if k == "while" {
            _mark_calls_str(s.cond, env, fnstr, strparams); _unify_expr(s.cond, env, fnstr);
            if _scan_stmts_str(_stmts_of2(s.body), env, fnstr, strparams) { ret_str = true; }
        } else { if k == "for_in" or k == "for" or k == "for_range" {
            let it = try s.iter catch nil; if it != nil { _mark_calls_str(it, env, fnstr, strparams); _unify_expr(it, env, fnstr); }
            let st = try s.start catch nil; if st != nil { _mark_calls_str(st, env, fnstr, strparams); }
            let en = try s.end catch nil; if en != nil { _mark_calls_str(en, env, fnstr, strparams); }
            if _scan_stmts_str(_stmts_of2(s.body), env, fnstr, strparams) { ret_str = true; }
        } } } } } } } }
        i = i + 1;
    }
    return ret_str;
}
fn _analyze_str_types(mainstmts, fns) {
    let fnstr = map{}; let strparams = map{}; let fnspars = map{};
    let iter = 0;
    while iter < 6 {
        _scan_stmts_str(mainstmts, map{}, fnstr, strparams);
        let fi = 0;
        while fi < len(fns) {
            let f = fns[fi]; let env = map{};
            let sp = try strparams[f.name] catch nil;
            let pi = 0;
            while pi < len(f.params) {
                let pn = _param_name(f.params[pi]);
                if sp != nil and map_has(sp, str(pi)) { env[pn] = true; }
                pi = pi + 1;
            }
            if _scan_stmts_str(_stmts_of2(f.body), env, fnstr, strparams) { fnstr[f.name] = true; }
            let rfl = _return_fnlit(f.body);
            if rfl != nil {
                let rvs = _free_vars(rfl.params, _stmts_of2(rfl.body)); let cenv = map{}; let rj = 0;
                while rj < len(rvs) { if (try env[rvs[rj]] catch nil) == true { cenv[rvs[rj]] = true; } rj = rj + 1; }
                if _scan_stmts_str(_stmts_of2(rfl.body), cenv, fnstr, strparams) { fnstr["@factory@" + f.name] = true; }
            }
            let ps = map{}; let qi = 0;
            while qi < len(f.params) { let pn = _param_name(f.params[qi]); if (try env[pn] catch nil) == true { ps[pn] = true; } qi = qi + 1; }
            fnspars[f.name] = ps;
            fi = fi + 1;
        }
        iter = iter + 1;
    }
    return map{ fnstr: fnstr, fnspars: fnspars };
}
fn _walk_maps(node, env, fnstr, strfields) {
    if not is_map(node) { return nil; }
    let k = try node.kind catch nil;
    if k == "map" {
        let i = 0;
        while i < len(node.entries) { if _expr_is_str(node.entries[i].value, env, fnstr) { strfields[node.entries[i].key] = true; } i = i + 1; }
    }
    let keys = map_keys(node); let ki = 0;
    while ki < len(keys) {
        let v = node[keys[ki]];
        if is_map(v) { _walk_maps(v, env, fnstr, strfields); }
        else { if is_array(v) { let j = 0; while j < len(v) { _walk_maps(v[j], env, fnstr, strfields); j = j + 1; } } }
        ki = ki + 1;
    }
    return nil;
}
fn _collect_strfields(mainstmts, fns, strtypes) {
    let strfields = map{}; let fnstr = strtypes.fnstr;
    let i = 0; while i < len(mainstmts) { _walk_maps(mainstmts[i], map{}, fnstr, strfields); i = i + 1; }
    let fi = 0;
    while fi < len(fns) {
        let f = fns[fi]; let env = map{};
        let sp = try strtypes.fnspars[f.name] catch nil;
        if sp != nil { let pk = 0; while pk < len(f.params) { let pn = _param_name(f.params[pk]); if map_has(sp, pn) { env[pn] = true; } pk = pk + 1; } }
        let bs = _stmts_of2(f.body); let bi = 0;
        while bi < len(bs) { _walk_maps(bs[bi], env, fnstr, strfields); bi = bi + 1; }
        fi = fi + 1;
    }
    return strfields;
}
fn _infer_funlit_types(node, slots) {
    let body = _stmts_of2(node.body);
    let fnstr = try slots.fnstr catch map{};
    let env = map{};
    let fvs = _free_vars_scoped(node.params, body, _closure_skip_set(slots)); let i = 0;
    while i < len(fvs) { if _is_str(map{ kind: "ident", name: fvs[i] }, slots) { env[fvs[i]] = true; } i = i + 1; }
    let sink = map{}; let iter = 0;
    while iter < 4 { _scan_stmts_str(body, env, fnstr, sink); iter = iter + 1; }
    let spars = map{}; let p = 0;
    while p < len(node.params) { let pn = _param_name(node.params[p]); if (try env[pn] catch nil) == true { spars[pn] = true; } p = p + 1; }
    let scaps = map{}; let j = 0;
    while j < len(fvs) { if (try env[fvs[j]] catch nil) == true { scaps[fvs[j]] = true; } j = j + 1; }
    return map{ spars: spars, scaps: scaps };
}

fn _free_vars(params, body) {
    return _free_vars_scoped(params, body, nil);
}

fn _reg_of(slots, name) {   // register index for a var, or -1
    let rv = try slots.regvars catch nil;
    if rv == nil { return -1; }
    let r = try rv[name] catch nil;
    if r == nil { return -1; }
    return r;
}
fn _reg_from_argreg(code, regidx, argidx) {
    let src = 7; if argidx == 1 { src = 6; } if argidx == 2 { src = 2; } if argidx == 3 { src = 1; }
    push(code, 73); push(code, 137); push(code, 192 + src * 8 + (regidx + 4));
}
fn _reg_count(slots) { let rv = try slots.regvars catch nil; if rv == nil { return 0; } return len(rv); }
fn _uses_r14_tmp(slots) { let ut = try slots.uses_tmp catch false; return ut and _reg_count(slots) <= 2; }
fn _reg_save_all(code, slots) {
    let n = _reg_count(slots); let i = 0; while i < n { _reg_save(code, i); i = i + 1; }
    if _uses_r14_tmp(slots) { _reg_save(code, 2); }
}
fn _reg_restore_all(code, slots) {
    let n = _reg_count(slots); let i = 0; while i < n { _reg_restore(code, i); i = i + 1; }
    if _uses_r14_tmp(slots) { _reg_restore(code, 2); }
}

fn _cond_skip_cc(op) {
    if op == "<"  { return 141; }   // jge
    if op == ">"  { return 142; }   // jle
    if op == "<=" { return 143; }   // jg
    if op == ">=" { return 140; }   // jl
    if op == "==" { return 133; }   // jne
    if op == "!=" { return 132; }   // je
    return 0;
}
fn _emit_cond_skip(cond0, code, slots, calls) {
    let cond = _fold(cond0);
    let str_eq = cond.kind == "binary" and (cond.op == "==" or cond.op == "!=") and _is_str(cond.left, slots) and _is_str(cond.right, slots);
    if cond.kind == "binary" and not str_eq {
        let cc = _cond_skip_cc(cond.op);
        if cc != 0 {
            if cond.right.kind == "number" {
                let cv = parse_number(cond.right.value);
                let lri = 0 - 1;
                if cond.left.kind == "ident" { lri = _reg_of(slots, cond.left.name); }
                if lri >= 0 {
                    if cv == 0 { push(code, 77); push(code, 133); push(code, 192 + (4 + lri) * 9); }
                    elif cv >= 0 - 128 and cv <= 127 { let b = cv; if b < 0 { b = b + 256; } push(code, 73); push(code, 131); push(code, 252 + lri); push(code, b); }
                    else { push(code, 73); push(code, 129); push(code, 252 + lri); _elf.le(code, cv, 4); }
                } else {
                    _ge_rax(cond.left, code, slots, calls);
                    if cv == 0 { push(code, 72); push(code, 133); push(code, 192); }
                    else { push(code, 72); push(code, 61); _elf.le(code, cv, 4); }
                }
            } elif cond.right.kind == "ident" and _reg_of(slots, cond.right.name) >= 0 {
                let rri = _reg_of(slots, cond.right.name);
                _ge_rax(cond.left, code, slots, calls);
                push(code, 76); push(code, 57); push(code, 192 + (4 + rri) * 8);
            } else {
                _ge_rax(cond.left, code, slots, calls);
                push(code, 80);
                _ge_rax(cond.right, code, slots, calls);
                push(code, 72); push(code, 137); push(code, 195);
                push(code, 88);
                push(code, 72); push(code, 57); push(code, 216);
            }
            push(code, 15); push(code, cc); let at = len(code); _elf.le(code, 0, 4);
            return at;
        }
    }
    _ge_rax(cond, code, slots, calls);
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 132); let at = len(code); _elf.le(code, 0, 4);
    return at;
}

fn _n_num(v)          { return map{ kind: "number", value: str(v) }; }
fn _n_id(name)        { return map{ kind: "ident", name: name }; }
fn _n_bin(op, l, r)   { return map{ kind: "binary", op: op, left: l, right: r }; }
fn _n_let(name, val)  { return map{ kind: "let", name: name, value: val }; }
fn _n_assign(nm, val) { return map{ kind: "expr_stmt", expr: map{ kind: "assign", name: nm, value: val } }; }
fn _n_index(o, i)     { return map{ kind: "index", obj: o, index: i }; }
fn _n_call(fn_, args) { return map{ kind: "call", func: map{ kind: "ident", name: fn_ }, args: args }; }
fn _n_while(cond, ss) { return map{ kind: "while", cond: cond, body: map{ kind: "block", stmts: ss } }; }
fn _n_bool(v)         { return map{ kind: "bool", value: v }; }
fn _n_ifbrk(cond)     { return map{ kind: "if", cond: cond, then: map{ kind: "block", stmts: [ map{ kind: "break" } ] } }; }
fn _n_neg1()          { return _n_bin("-", _n_num(0), _n_num(1)); }

fn _ge_block_value(block, code, slots, calls) {
    let stmts = _stmts_of2(block);
    let n = len(stmts);
    if n == 0 { push(code, 49); push(code, 192); return nil; }
    let i = 0;
    while i < n - 1 { _gsr(stmts[i], code, slots, calls, true); i = i + 1; }
    let last = stmts[n - 1];
    if last.kind == "expr_stmt" { _ge_rax(last.expr, code, slots, calls); }
    else { _gsr(last, code, slots, calls, true); push(code, 49); push(code, 192); }
    return nil;
}
fn _block_val_expr(block) {
    let stmts = _stmts_of2(block); let n = len(stmts);
    if n > 0 and stmts[n - 1].kind == "expr_stmt" { return stmts[n - 1].expr; }
    return nil;
}

// ── AFFINE-RECURRENCE COLLAPSE (LLVM Scalar-Evolution style) ─────────────────────────────────────────────────
fn _lin_form(expr, acc, var) {
    let k = expr.kind;
    if k == "number" { return map{ ca: 0, cv: 0, cc: parse_number(expr.value) }; }
    if k == "ident" {
        if expr.name == acc { return map{ ca: 1, cv: 0, cc: 0 }; }
        if expr.name == var { return map{ ca: 0, cv: 1, cc: 0 }; }
        return nil;
    }
    if k == "unary" and expr.op == "-" { let o = _lin_form(expr.operand, acc, var); if o == nil { return nil; } return map{ ca: 0 - o.ca, cv: 0 - o.cv, cc: 0 - o.cc }; }
    if k == "binary" {
