    push(code, 235); push(code, cclp - (len(code) + 1) + 256);
    push(code, 72); push(code, 139); push(code, 77); push(code, 16);         // mov rcx, [rbp+16]
    push(code, 72); push(code, 141); push(code, 108); push(code, 205); push(code, 24); // lea rbp, [rbp+rcx*8+24]
    push(code, 233); let jcb4 = len(code); _elf.le(code, 0, 4); _patch32(code, jcb4, clp - (jcb4 + 4));

