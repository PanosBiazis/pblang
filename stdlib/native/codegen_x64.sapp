// codegen_x64.sapp — a REAL (if minimal) pblang → x86-64 machine-code compiler.
//
// Unlike a fixed template, this lowers an arbitrary arithmetic AST (from the
// self-hosting parser) to machine code using a simple stack machine on the CPU
// stack: each sub-expression leaves its value on top of the stack, binary ops
// pop two and push the result. No register allocator needed yet. The emitted
// code runs at native CPU speed. This is the first real step of a pblang-written
// native backend that will grow to whole functions, calls, and more ISAs.

let _tok = import("../compiler/tokenizer.sapp");
let _par = import("../compiler/parser.sapp");
let _SOURCE = import("../compiler/checked_source.sapp");
let _elf = import("./elf_x64.sapp");

// Emit code that computes `node` and leaves the result on the CPU stack (top).
fn _emit_expr(node, code) {
    let k = node.kind;
    if k == "number" {
        // mov eax, imm32 ; push rax     (integer literal onto the stack)
        push(code, 184); _elf.le(code, parse_number(node.value), 4);   // B8 <le32>
        push(code, 80);                                                // push rax
        return code;
    }
    if k == "unary" and node.op == "-" {
        _emit_expr(node.operand, code);
        push(code, 88);                    // pop rax
        push(code, 72); push(code, 247); push(code, 216); _ovf(code);   // neg rax  (48 F7 D8) — traps on i64::MIN in safe mode
        push(code, 80);                    // push rax
        return code;
    }
    if k == "binary" {
        _emit_expr(node.left, code);
        _emit_expr(node.right, code);
        push(code, 91);                    // pop rbx   (= right)
        push(code, 88);                    // pop rax   (= left)
        let op = node.op;
        if op == "+" { push(code, 72); push(code, 1); push(code, 216); _ovf(code); }        // add rax, rbx  48 01 D8
        else { if op == "-" { push(code, 72); push(code, 41); push(code, 216); _ovf(code); } // sub rax, rbx  48 29 D8
        else { if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 195); _ovf(code); } // imul rax,rbx 48 0F AF C3
        else { throw "codegen: unsupported op " + op; } } }
        push(code, 80);                    // push rax
        return code;
    }
    throw "codegen: cannot compile expr kind " + k;
}

// Extract the arithmetic expression from the first parsed statement.
fn _first_expr(ast) {
    let s = ast.stmts[0];
    if s.kind == "expr_stmt" { return s.expr; }
    if s.kind == "print" { return s.value; }
    if s.kind == "let" or s.kind == "const" { return s.value; }
    throw "codegen: expected an expression statement";
}

// compile_expr_exit(src) — compile a single pblang arithmetic expression to a
// native x86-64 ELF that computes it and exit()s with the result (low 8 bits).
// Returns the ELF file as a byte array.
fn compile_expr_exit(src) {
    let ast = _SOURCE.parse_source(src);
    let code = [];
    _emit_expr(_first_expr(ast), code);
    push(code, 88);                                 // pop rax   (final result)
    push(code, 137); push(code, 199);               // mov edi, eax   (exit status)
    push(code, 184); _elf.le(code, 60, 4);          // mov eax, 60    (sys_exit)
    push(code, 15); push(code, 5);                  // syscall
    return _elf.wrap_elf(code);
}

// ─────────────────────────────────────────────────────────────────────────────
// Fuller compiler: variables (rbp-relative stack slots), comparisons, and
// if/while control flow (with jump backpatching). Compiles a whole pblang
// program to x86-64 that runs at native speed and exit()s via `return <expr>;`.
// ─────────────────────────────────────────────────────────────────────────────

fn _u32(v) { if v < 0 { return v + 4294967296; } return v; }

// write signed 32-bit value `val` as 4 little-endian bytes at index `at` in code
fn _patch32(code, at, val) {
    let v = _u32(val);
    let i = 0;
    while i < 4 { let b = v % 256; code[at + i] = b; v = (v - b) / 256; i = i + 1; }
}

// slot index for a variable name (allocate on first use)
fn _slot_of(slots, name) {
    let have = try slots.names[name] catch nil;
    if have != nil { return have; }
    let idx = slots.n;
    slots.names[name] = idx;
    slots.n = idx + 1;
    return idx;
}

// displacement of local slot i relative to rbp: [rbp - 8*(i+1)]
fn _slot_disp(i) { return 0 - (8 * (i + 1)); }

fn _emit_expr2(node, code, slots) {
    let k = node.kind;
    if k == "number" {
        push(code, 184); _elf.le(code, parse_number(node.value), 4);   // mov eax, imm ; push
        push(code, 80);
        return true;
    }
    if k == "ident" {
        let i = _slot_of(slots, node.name);
        push(code, 72); push(code, 139); push(code, 133);              // mov rax, [rbp+disp32]
        let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
        push(code, 80);                                                // push rax
        return true;
    }
    if k == "unary" and node.op == "-" {
        _emit_expr2(node.operand, code, slots);
        push(code, 88); push(code, 72); push(code, 247); push(code, 216); _ovf(code); push(code, 80); // pop;neg;push
        return true;
    }
    if k == "binary" {
        let op = node.op;
        _emit_expr2(node.left, code, slots);
        _emit_expr2(node.right, code, slots);
        push(code, 91); push(code, 88);                                // pop rbx(=r) ; pop rax(=l)
        if op == "+" { push(code, 72); push(code, 1); push(code, 216); push(code, 80); return true; }
        if op == "-" { push(code, 72); push(code, 41); push(code, 216); push(code, 80); return true; }
        if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 195); push(code, 80); return true; }
        // comparisons: cmp rax,rbx ; setCC al ; movzx eax,al ; push rax
        push(code, 72); push(code, 57); push(code, 216);               // cmp rax, rbx
        let cc = 0;
        if op == "<"  { cc = 156; }
        if op == ">"  { cc = 159; }
        if op == "<=" { cc = 158; }
        if op == ">=" { cc = 157; }
        if op == "==" { cc = 148; }
        if op == "!=" { cc = 149; }
        if cc == 0 { throw "codegen: unsupported op " + op; }
        push(code, 15); push(code, cc); push(code, 192);               // setCC al  (0F <cc> C0)
        push(code, 15); push(code, 182); push(code, 192);              // movzx eax, al
        push(code, 80);                                                // push rax
        return true;
    }
    throw "codegen: cannot compile expr kind " + k;
}

fn _stmts_of2(block) {
    if is_array(block) { return block; }
    let s = try block.stmts catch nil;
    if s != nil { return s; }
    return [];
}

fn _emit_stmt2(node, code, slots) {
    let k = node.kind;
    if k == "let" or k == "const" {
        let i = _slot_of(slots, node.name);
        if node.value != nil { _emit_expr2(node.value, code, slots); } else { push(code, 106); push(code, 0); }
        push(code, 88);                                                // pop rax
        push(code, 72); push(code, 137); push(code, 133);              // mov [rbp+disp32], rax
        let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
        return true;
    }
    if k == "expr_stmt" {
        let e = node.expr;
        if e.kind == "assign" {
            let i = _slot_of(slots, e.name);
            _emit_expr2(e.value, code, slots);
            push(code, 88);                                            // pop rax
            push(code, 72); push(code, 137); push(code, 133);          // mov [rbp+disp32], rax
            let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
            return true;
        }
        _emit_expr2(e, code, slots); push(code, 88);                   // eval and discard
        return true;
    }
    if k == "return" {
        if node.value != nil { _emit_expr2(node.value, code, slots); } else { push(code, 106); push(code, 0); }
        push(code, 88);                                                // pop rax
        push(code, 137); push(code, 199);                             // mov edi, eax
        push(code, 184); _elf.le(code, 60, 4);                        // mov eax, 60
        push(code, 15); push(code, 5);                               // syscall
        return true;
    }
    if k == "if" {
        _emit_expr2(node.cond, code, slots);
        push(code, 88); push(code, 72); push(code, 133); push(code, 192);  // pop rax ; test rax,rax
        push(code, 15); push(code, 132);                              // jz rel32
        let jz_at = len(code); _elf.le(code, 0, 4);
        let body = _stmts_of2(node.then); let bi = 0;
        while bi < len(body) { _emit_stmt2(body[bi], code, slots); bi = bi + 1; }
        _patch32(code, jz_at, len(code) - (jz_at + 4));               // forward patch
        let els = try node.else catch nil;
        if els != nil {
            // (compiled after the then-block; entered only when cond true falls through — for a full
            // if/else we'd add a jmp over the else. Kept simple: else handled by a trailing jmp.)
            let b2 = _stmts_of2(els); let j = 0;
            while j < len(b2) { _emit_stmt2(b2[j], code, slots); j = j + 1; }
        }
        return true;
    }
    if k == "while" {
        let loop_start = len(code);
        _emit_expr2(node.cond, code, slots);
        push(code, 88); push(code, 72); push(code, 133); push(code, 192);  // pop rax ; test rax,rax
        push(code, 15); push(code, 132);                              // jz rel32 (exit loop)
        let jz_at = len(code); _elf.le(code, 0, 4);
        let body = _stmts_of2(node.body); let bi = 0;
        while bi < len(body) { _emit_stmt2(body[bi], code, slots); bi = bi + 1; }
        push(code, 233);                                              // jmp rel32 (back to start)
        let jmp_at = len(code); _elf.le(code, 0, 4);
        _patch32(code, jmp_at, loop_start - (jmp_at + 4));            // backward
        _patch32(code, jz_at, len(code) - (jz_at + 4));              // forward exit
        return true;
    }
    if k == "fn" or k == "import" or k == "export" { return true; }   // skip (top-level only for now)
    throw "codegen: cannot compile stmt kind " + k;
}

// compile_program(src) — compile a whole pblang program (let/assign/if/while +
// `return <expr>;`) to a native x86-64 ELF. The program exits with its returned
// value (low 8 bits). Variables live in rbp-relative stack slots.
fn compile_program(src) {
    let ast = _SOURCE.parse_source(src);
    let code = [];
    // prologue: mov rbp, rsp ; sub rsp, 512   (reserve 64 local slots)
    push(code, 72); push(code, 137); push(code, 229);                 // mov rbp, rsp
    push(code, 72); push(code, 129); push(code, 236); _elf.le(code, 512, 4);  // sub rsp, 512
    let slots = map{ names: map{}, n: 0 };
    let i = 0;
    while i < len(ast.stmts) { _emit_stmt2(ast.stmts[i], code, slots); i = i + 1; }
    _check_frame(slots.n, "<program>");
    // default epilogue if no return hit: exit(0)
    push(code, 191); _elf.le(code, 0, 4);                             // mov edi, 0
    push(code, 184); _elf.le(code, 60, 4);                            // mov eax, 60
    push(code, 15); push(code, 5);                                   // syscall
    return _elf.wrap_elf(code);
}

// ─────────────────────────────────────────────────────────────────────────────
// Functions + calls (System V AMD64 ABI): compile whole pblang programs WITH
// user functions, including recursion, to x86-64 machine code. Integer args pass
// in rdi/rsi/rdx/rcx/r8/r9; return value in rax; each call gets its own rbp frame.
// This is what compiles `fib` itself to native code.
// ─────────────────────────────────────────────────────────────────────────────

fn _param_name(p) { if is_map(p) { return p.name; } return p; }

// SAFETY: the frame is sized to exactly `slots.n` eight-byte slots (16-aligned), reg-save spills at the top
// ([rbp-8]..) then locals. A function exceeding the sanity cap below (a codegen bug, not real code) is refused
// (fail loud) rather than emitting this specific out-of-frame write. Other memory boundaries remain unchecked.
fn _check_frame(nslots, where) {
    // The frame is now sized to nslots (16-aligned), so this is a runaway-allocation sanity cap, not a hard
    // 64-slot frame limit. 1024 slots = an 8KB frame — far beyond any real function; a higher count signals a bug.
    if nslots > 1024 { throw "codegen: too many locals (" + str(nslots) + ") in " + where + " — over 1024-slot sanity cap (likely a codegen bug)"; }
}

// ── INLINING ──────────────────────────────────────────────────────────────────
// Does an expression contain a call anywhere? (a leaf expr = safe to inline)
fn _has_call(node) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "call" { return true; }
    if k == "binary" { return _has_call(node.left) or _has_call(node.right); }
    if k == "unary" { return _has_call(node.operand); }
    return false;
}
// THOROUGH call detection through EVERY sub-position (index/member/array/map/args/ternary/try), used to gate
// the register-stack temp: r9/r10 are caller-saved, so if the right operand can invoke anything that emits a
// `call` (or an inline builtin that touches those regs), we must NOT park a temp there — fall to the memory
// stack instead. Conservative: treats every `call` node (incl. desugared bitwise) as clobbering, so it never
// keeps a register temp live across one. (Distinct from `_has_call`, which only walks binary/unary.)
fn _deep_has_call(node) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "call" { return true; }
    if k == "binary" { return _deep_has_call(node.left) or _deep_has_call(node.right); }
    if k == "unary" { return _deep_has_call(node.operand); }
    if k == "index" { return _deep_has_call(node.obj) or _deep_has_call(node.index); }
    if k == "member" { return _deep_has_call(node.obj); }
    if k == "array" { let i = 0; while i < len(node.items) { if _deep_has_call(node.items[i]) { return true; } i = i + 1; } return false; }
    if k == "map" { let i = 0; while i < len(node.entries) { if _deep_has_call(node.entries[i].value) { return true; } i = i + 1; } return false; }
    if k == "if_expr" { return _deep_has_call(node.cond) or _deep_has_call(node.then) or _deep_has_call(node.else); }
    if k == "try" { return _deep_has_call(node.body) or _deep_has_call(node.handler); }
    return false;
}
// True if the expression tree constructs a closure anywhere. Inlining a function
// whose body builds a fn_lit is UNSAFE: the closure captures the callee's params by
// scope, but inlining substitutes them syntactically into the caller — where those
// names don't live — so the capture reads a garbage slot. Keep such fns out-of-line.
fn _has_fnlit(node) {
    if not is_map(node) { return false; }
    let k = try node.kind catch nil;
    if k == "fn_lit" { return true; }
    if k == "binary" { return _has_fnlit(node.left) or _has_fnlit(node.right); }
    if k == "unary" { return _has_fnlit(node.operand); }
    if k == "index" { return _has_fnlit(node.obj) or _has_fnlit(node.index); }
    if k == "member" { return _has_fnlit(node.obj); }
    if k == "array" { let i = 0; while i < len(node.items) { if _has_fnlit(node.items[i]) { return true; } i = i + 1; } return false; }
    if k == "call" { let i = 0; while i < len(node.args) { if _has_fnlit(node.args[i]) { return true; } i = i + 1; } return _has_fnlit(node.func); }
    return false;
}
// Beta-reduction: return a COPY of `node` with any ident named in `m` replaced by
// its argument AST. Used to inline `f(args)` where f's body is `return E` — E with
// the params substituted by the (simple) arguments.
fn _subst(node, m) {
    let k = node.kind;
    if k == "ident" { let r = try m[node.name] catch nil; if r != nil { return r; } return node; }
    if k == "binary" { return map{ kind: "binary", op: node.op, left: _subst(node.left, m), right: _subst(node.right, m) }; }
    if k == "unary" { return map{ kind: "unary", op: node.op, operand: _subst(node.operand, m) }; }
    // MUST recurse into every sub-expression that can hold a parameter, else inlining leaves the callee's
    // param name unsubstituted and it resolves against the CALLER's scope (the `K[a]`-in-`try` bug).
    if k == "index" { return map{ kind: "index", obj: _subst(node.obj, m), index: _subst(node.index, m) }; }
    if k == "member" { return map{ kind: "member", obj: _subst(node.obj, m), name: node.name }; }
    if k == "try" { return map{ kind: "try", body: _subst(node.body, m), handler: _subst(node.handler, m) }; }
    if k == "call" { let a = []; let i = 0; while i < len(node.args) { push(a, _subst(node.args[i], m)); i = i + 1; } return map{ kind: "call", func: _subst(node.func, m), args: a }; }
    if k == "array" { let it = []; let i = 0; while i < len(node.items) { push(it, _subst(node.items[i], m)); i = i + 1; } return map{ kind: "array", items: it }; }
    if k == "map" { let e = []; let i = 0; while i < len(node.entries) { push(e, map{ key: node.entries[i].key, value: _subst(node.entries[i].value, m) }); i = i + 1; } return map{ kind: "map", entries: e }; }
    if k == "if_expr" { return map{ kind: "if_expr", cond: _subst(node.cond, m), then: node.then, else: node.else }; }
    return node;   // number/string/bool/nil — atoms
}
// If a function is a single-`return` leaf (`return E;`, E has no calls), return E; else nil.
fn _inlinable_expr(fn_node) {
    let body = _stmts_of2(fn_node.body);
    if len(body) != 1 { return nil; }
    if body[0].kind != "return" { return nil; }
    let e = try body[0].value catch nil;
    if e == nil { return nil; }
    if _has_call(e) { return nil; }
    if _has_fnlit(e) { return nil; }   // never inline a closure-constructing fn (capture breaks)
    return e;
}

// >6 args (SysV): args 0-5 in rdi,rsi,rdx,rcx,r8,r9; args 6+ on the stack at [rsp,#8*(j-6)] at call time.
// All n arg temps were pushed L→R, so arg j sits at [rsp + 8*(n-1-j)] before carving. Carve the outgoing
// area below the temps, copy the stack args into place, load the 6 registers from the temps. The caller
// emits `call`, then `_free_args_stack` with the returned byte count (outgoing area + all temps).
fn _emit_sub_rsp(code, bytes) {
    if bytes < 0 { throw "codegen_x64: negative stack allocation"; }
    if bytes == 0 { return true; }
    if bytes <= 127 {
        push(code, 72); push(code, 131); push(code, 236); push(code, bytes);     // sub rsp, imm8
    } else {
        push(code, 72); push(code, 129); push(code, 236); _elf.le(code, bytes, 4); // sub rsp, imm32
    }
    return true;
}
fn _emit_add_rsp(code, bytes) {
    if bytes < 0 { throw "codegen_x64: negative stack release"; }
    if bytes == 0 { return true; }
    if bytes <= 127 {
        push(code, 72); push(code, 131); push(code, 196); push(code, bytes);     // add rsp, imm8
    } else {
        push(code, 72); push(code, 129); push(code, 196); _elf.le(code, bytes, 4); // add rsp, imm32
    }
    return true;
}
fn _stage_args_stack(code, n) {
    let kk = 8 * (n - 6);
    _emit_sub_rsp(code, kk);
    let j = 6;
    while j < n {
        push(code, 72); push(code, 139); push(code, 132); push(code, 36); _elf.le(code, kk + 8 * (n - 1 - j), 4);  // mov rax, [rsp+K+8*(n-1-j)]
        push(code, 72); push(code, 137); push(code, 132); push(code, 36); _elf.le(code, 8 * (j - 6), 4);           // mov [rsp+8*(j-6)], rax
        j = j + 1;
    }
    j = 0;
    while j < 6 {
        if j == 0 { push(code, 72); push(code, 139); push(code, 188); }      // mov rdi, [rsp+d]
        elif j == 1 { push(code, 72); push(code, 139); push(code, 180); }    // mov rsi, [rsp+d]
        elif j == 2 { push(code, 72); push(code, 139); push(code, 148); }    // mov rdx, [rsp+d]
        elif j == 3 { push(code, 72); push(code, 139); push(code, 140); }    // mov rcx, [rsp+d]
        elif j == 4 { push(code, 76); push(code, 139); push(code, 132); }    // mov r8,  [rsp+d]
        else { push(code, 76); push(code, 139); push(code, 140); }           // mov r9,  [rsp+d]
        push(code, 36); _elf.le(code, kk + 8 * (n - 1 - j), 4);
        j = j + 1;
    }
    return kk + 8 * n;
}
fn _free_args_stack(code, bytes) { _emit_add_rsp(code, bytes); }

// pop the i-th argument register (0=rdi..5=r9)
fn _pop_argreg(code, i) {
    if i == 0 { push(code, 95); return true; }            // pop rdi
    if i == 1 { push(code, 94); return true; }            // pop rsi
    if i == 2 { push(code, 90); return true; }            // pop rdx
    if i == 3 { push(code, 89); return true; }            // pop rcx
    if i == 4 { push(code, 65); push(code, 88); return true; }   // pop r8
    push(code, 65); push(code, 89); return true;          // pop r9
}
// _try_push_imm(code, node) — push a small integer constant DIRECTLY via `push imm8/imm32` (sign-extended to
// 64 bits) instead of `mov eax,imm ; push rax`. Used for constant call arguments and stack operands: the value
// only needs to reach the stack before it is popped into a register. Saves 4 bytes (imm8) or 1 byte (imm32) per
// constant. Returns false (caller emits the general eval+push) when the value doesn't fit a sign-extended imm32.
fn _try_push_imm(code, node) {
    if node.kind != "number" { return false; }
    let v = parse_number(node.value);
    if v >= 0 - 128 and v <= 127 { let b = v; if b < 0 { b = b + 256; } push(code, 106); push(code, b); return true; }   // push imm8 (6A ib)
    if v >= 0 - 2147483648 and v <= 2147483647 { push(code, 104); _elf.le(code, v, 4); return true; }                    // push imm32 (68 id)
    return false;
}
// mov [rbp+disp32], <i-th arg register>  — spill an incoming parameter to its slot
fn _store_argreg(code, i, disp) {
    if i == 0 { push(code, 72); push(code, 137); push(code, 189); }       // mov [rbp+d], rdi
    else { if i == 1 { push(code, 72); push(code, 137); push(code, 181); } // rsi
    else { if i == 2 { push(code, 72); push(code, 137); push(code, 149); } // rdx
    else { if i == 3 { push(code, 72); push(code, 137); push(code, 141); } // rcx
    else { if i == 4 { push(code, 76); push(code, 137); push(code, 133); } // r8
    else { push(code, 76); push(code, 137); push(code, 141); } } } } }     // r9
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, disp);
}

// gen expression → result on CPU stack. `calls` collects {at,name} call backpatches.
fn _ge(node, code, slots, calls) {
    let k = node.kind;
    if k == "number" {
        if _try_push_imm(code, node) { return true; }                                 // push imm8/imm32 (2–5B, no rax)
        let v = parse_number(node.value);
        if v == 0 { push(code, 49); push(code, 192); }                                // xor eax,eax (2B vs 5B; also faster)
        elif v >= 0 and v < 4294967296 { push(code, 184); _elf.le(code, v, 4); }      // mov eax, imm32
        else { push(code, 72); push(code, 184); _elf.le(code, v, 8); }                // movabs rax, imm64 (>= 2^32)
        push(code, 80); return true;                                                  // push rax
    }
    if k == "ident" {
        let i = _slot_of(slots, node.name);
        push(code, 72); push(code, 139); push(code, 133);
        let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
        push(code, 80); return true;
    }
    if k == "unary" and node.op == "-" {
        _ge(node.operand, code, slots, calls);
        push(code, 88); push(code, 72); push(code, 247); push(code, 216); _ovf(code); push(code, 80); return true;
    }
    if k == "call" {
        let a = node.args; let ai = 0;
        while ai < len(a) { _ge(a[ai], code, slots, calls); ai = ai + 1; }   // push args L→R
        if len(a) > 6 {                                                      // args 6+ go on the stack (SysV)
            let freeb = _stage_args_stack(code, len(a));
            push(code, 232); let at6 = len(code); _elf.le(code, 0, 4);
            push(calls, map{ at: at6, name: node.func.name });
            _free_args_stack(code, freeb);
            push(code, 80);                                                  // push rax (result)
            return true;
        }
        let j = len(a) - 1;
        while j >= 0 { _pop_argreg(code, j); j = j - 1; }                    // pop into arg regs
        push(code, 232);                                                     // call rel32
        let at = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: at, name: node.func.name });
        push(code, 80);                                                      // push rax (result)
        return true;
    }
    if k == "binary" {
        let op = node.op;
        // OPTIMIZATION: constant right operand → immediate-form instruction (no push/pop of the
        // constant). Big win for the ubiquitous `x OP const` (fib's n-1, n-2, n<2).
        if node.right.kind == "number" {
            let val = parse_number(node.right.value);
            _ge(node.left, code, slots, calls);
            push(code, 88);                                                  // pop rax  (left)
            if op == "+" { if val >= 0 and val <= 127 { push(code, 72); push(code, 131); push(code, 192); push(code, val); } else { push(code, 72); push(code, 5); _elf.le(code, val, 4); } _ovf(code); push(code, 80); return true; }   // add rax, imm8/imm32
            if op == "-" { if val >= 0 and val <= 127 { push(code, 72); push(code, 131); push(code, 232); push(code, val); } else { push(code, 72); push(code, 45); _elf.le(code, val, 4); } _ovf(code); push(code, 80); return true; }  // sub rax, imm8/imm32
            if op == "*" { _emit_mul_const(code, val); push(code, 80); return true; } // strength reduction, then push result
            if val == 0 { push(code, 72); push(code, 133); push(code, 192); }              // test rax,rax (3B vs 7B, same flags)
            else { push(code, 72); push(code, 61); _elf.le(code, val, 4); }                // cmp rax, imm32
            let cci = 0;
            if op == "<" { cci = 156; } if op == ">" { cci = 159; }
            if op == "<=" { cci = 158; } if op == ">=" { cci = 157; }
            if op == "==" { cci = 148; } if op == "!=" { cci = 149; }
            if cci == 0 { throw "codegen: unsupported op " + op; }
            push(code, 15); push(code, cci); push(code, 192);
            push(code, 15); push(code, 182); push(code, 192);
            push(code, 80); return true;
        }
        _ge(node.left, code, slots, calls);
        _ge(node.right, code, slots, calls);
        push(code, 91); push(code, 88);                                      // pop rbx ; pop rax
        if op == "+" { push(code, 72); push(code, 1); push(code, 216); push(code, 80); return true; }
        if op == "-" { push(code, 72); push(code, 41); push(code, 216); push(code, 80); return true; }
        if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 195); push(code, 80); return true; }
        push(code, 72); push(code, 57); push(code, 216);                     // cmp rax, rbx
        let cc = 0;
        if op == "<" { cc = 156; } if op == ">" { cc = 159; }
        if op == "<=" { cc = 158; } if op == ">=" { cc = 157; }
        if op == "==" { cc = 148; } if op == "!=" { cc = 149; }
        if cc == 0 { throw "codegen: unsupported op " + op; }
        push(code, 15); push(code, cc); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        push(code, 80); return true;
    }
    throw "codegen: cannot compile expr kind " + k;
}

// gen statement. in_fn=true → `return` is a function return (leave/ret); else exit().
fn _gs(node, code, slots, calls, in_fn) {
    let k = node.kind;
    if k == "let" or k == "const" {
        let i = _slot_of(slots, node.name);
        if node.value != nil { _ge(node.value, code, slots, calls); } else { push(code, 106); push(code, 0); }
        push(code, 88); push(code, 72); push(code, 137); push(code, 133);
        let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
        return true;
    }
    if k == "expr_stmt" {
        let e = node.expr;
        if e.kind == "assign" {
            let i = _slot_of(slots, e.name);
            _ge(e.value, code, slots, calls);
            push(code, 88); push(code, 72); push(code, 137); push(code, 133);
            let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
            return true;
        }
        _ge(e, code, slots, calls); push(code, 88); return true;
    }
    if k == "return" {
        if node.value != nil { _ge(node.value, code, slots, calls); } else { push(code, 106); push(code, 0); }
        push(code, 88);                                                      // pop rax
        if in_fn { push(code, 201); push(code, 195); }                      // leave ; ret
        else { push(code, 137); push(code, 199); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); }
        return true;
    }
    if k == "if" {
        _ge(node.cond, code, slots, calls);
        push(code, 88); push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 132); let jz = len(code); _elf.le(code, 0, 4);
        let b = _stmts_of2(node.then); let bi = 0;
        while bi < len(b) { _gs(b[bi], code, slots, calls, in_fn); bi = bi + 1; }
        _patch32(code, jz, len(code) - (jz + 4));
        let els = try node.else catch nil;
        if els != nil { let b2 = _stmts_of2(els); let j = 0; while j < len(b2) { _gs(b2[j], code, slots, calls, in_fn); j = j + 1; } }
        return true;
    }
    if k == "while" {
        let start = len(code);
        _ge(node.cond, code, slots, calls);
        push(code, 88); push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 132); let jz = len(code); _elf.le(code, 0, 4);
        let b = _stmts_of2(node.body); let bi = 0;
        while bi < len(b) { _gs(b[bi], code, slots, calls, in_fn); bi = bi + 1; }
        push(code, 233); let jm = len(code); _elf.le(code, 0, 4);
        _patch32(code, jm, start - (jm + 4));
        _patch32(code, jz, len(code) - (jz + 4));
        return true;
    }
    if k == "fn" or k == "import" or k == "export" { return true; }
    throw "codegen: cannot compile stmt kind " + k;
}

// ── register-oriented codegen (result-in-rax): far less stack traffic ──────────
fn _setcc(code, op) {
    let cc = 0;
    if op == "<" { cc = 156; } if op == ">" { cc = 159; }
    if op == "<=" { cc = 158; } if op == ">=" { cc = 157; }
    if op == "==" { cc = 148; } if op == "!=" { cc = 149; }
    if cc == 0 { throw "codegen: unsupported op " + op; }
    push(code, 15); push(code, cc); push(code, 192);        // setCC al
    push(code, 15); push(code, 182); push(code, 192);       // movzx eax, al
}

// CONSTANT FOLDING: evaluate constant sub-expressions at compile time, so the
// emitted code loads the result directly (e.g. `2 + 3*4` → `14`, `x + (2*5)` → `x + 10`).
// OVERFLOW-CHECKED ARITHMETIC (opt-in "safe mode"): when enabled, every add/sub/imul is followed by a compact
// `jno +2 ; ud2` (4 bytes) — on SIGNED overflow the ud2 raises SIGILL (exit 132) instead of silently wrapping to
// a wrong result. OFF by default so the standard backend keeps its tiny binaries + VM parity; toggle before a
// compile with set_overflow_check(true). (A map so the flag is mutable across the imported module.)
let _ovf_state = map{ on: false };
fn set_overflow_check(on) { _ovf_state.on = on; }
fn _ovf(code) {
    if _ovf_state.on { push(code, 113); push(code, 2); push(code, 15); push(code, 11); }   // jno +2 ; ud2 (SIGILL on overflow)
}
// _div0(code) — in checked mode, trap on division by zero with the SAME mechanism as _ovf (ud2 → SIGILL,
// exit 132) instead of the raw hardware #DE (SIGFPE, exit 136). Emitted right before `div rbx`, where the
// divisor is in rbx. Completes checked arithmetic: + - * neg / % all trap consistently in safe mode.
fn _div0(code) {
    if _ovf_state.on { push(code, 72); push(code, 133); push(code, 219); push(code, 117); push(code, 2); push(code, 15); push(code, 11); }  // test rbx,rbx ; jnz +2 ; ud2
}

fn _numlit(n) { return map{ kind: "number", value: str(n) }; }
// exponent if v is a power of two (>= 2), else -1 — for strength reduction (x*2^k → shl x, k).
fn _log2_pow2(v) {
    if v < 2 { return -1; }
    let e = 0; let x = v;
    while x > 1 {
        if x % 2 != 0 { return -1; }
        x = (x - (x % 2)) / 2;
        e = e + 1;
    }
    return e;
}
// STRENGTH REDUCTION for `rax = rax * val` (val already known to fit signed-32). We only apply reductions
// that collapse the multiply to ONE cheap 1-µop instruction: `x*2^k → shl` and `x*{3,5,9} → lea`. We do NOT
// decompose e.g. `x*31 → (x<<5)-x`: on modern x86, `imul r,r,imm` is 3-cycle-latency / 1-µop / fully
// pipelined, so a 3-µop shift+sub is actually SLOWER on throughput-bound loops (measured: 266ms vs 227ms at
// 200M iters). Verified against gcc/clang's own policy — they only reduce to shl / single-lea, never multi-op.
fn _emit_mul_const(code, val) {
    if val == 0 { push(code, 72); push(code, 49); push(code, 192); return; }    // xor rax, rax
    if val == 1 { return; }                                                     // x*1 = x (no-op)
    // In overflow-check mode the shl/lea strength reductions are skipped: they don't set OF, so a checked
    // multiply must use imul (which does) + the `jno;ud2` trap. Correctness (safe mode) beats the peephole.
    if not _ovf_state.on and val > 1 {
        let sh = _log2_pow2(val);
        if sh >= 0 { push(code, 72); push(code, 193); push(code, 224); push(code, sh); return; }  // shl rax, k  (x*2^k)
        if val == 3 { push(code, 72); push(code, 141); push(code, 4); push(code, 64);  return; }  // lea rax,[rax+rax*2]  (x*3)
        if val == 5 { push(code, 72); push(code, 141); push(code, 4); push(code, 128); return; }  // lea rax,[rax+rax*4]  (x*5)
        if val == 9 { push(code, 72); push(code, 141); push(code, 4); push(code, 192); return; }  // lea rax,[rax+rax*8]  (x*9)
    }
    push(code, 72); push(code, 105); push(code, 192); _elf.le(code, val, 4);     // imul rax, rax, imm32 (fast default)
    _ovf(code);
}
fn _fold(node) {
    let k = node.kind;
    if k == "unary" {
        let o = _fold(node.operand);
        if node.op == "-" and o.kind == "number" { return _numlit(0 - parse_number(o.value)); }
        return map{ kind: "unary", op: node.op, operand: o };
    }
    if k == "binary" {
        let l = _fold(node.left);
        let r = _fold(node.right);
        if l.kind == "number" and r.kind == "number" {
            let a = parse_number(l.value); let b = parse_number(r.value); let op = node.op;
            if op == "+" { return _numlit(a + b); }
            if op == "-" { return _numlit(a - b); }
            if op == "*" { return _numlit(a * b); }
            // NOTE: native division is INTEGER (unsigned div) — do NOT fold `/` with pblang's float `/`
            // (100/7 would fold to 14.2857 and break integer byte emission). Modulo stays integer.
            if op == "%" and b != 0 { return _numlit(a % b); }
            // comparisons fold to 0/1 (kept as number literals — the codegen has no bool node)
            if op == "<"  { if a < b  { return _numlit(1); } return _numlit(0); }
            if op == ">"  { if a > b  { return _numlit(1); } return _numlit(0); }
            if op == "<=" { if a <= b { return _numlit(1); } return _numlit(0); }
            if op == ">=" { if a >= b { return _numlit(1); } return _numlit(0); }
            if op == "==" { if a == b { return _numlit(1); } return _numlit(0); }
            if op == "!=" { if a != b { return _numlit(1); } return _numlit(0); }
        }
        // ALGEBRAIC IDENTITIES: drop no-op arithmetic so it emits nothing (x+0, x-0, x*1, 0+x, 1*x).
        let op = node.op;
        if r.kind == "number" {
            let rv = parse_number(r.value);
            if op == "+" and rv == 0 { return l; }
            if op == "-" and rv == 0 { return l; }
            if op == "*" and rv == 1 { return l; }
        }
        if l.kind == "number" {
            let lv = parse_number(l.value);
            if op == "+" and lv == 0 { return r; }
            if op == "*" and lv == 1 { return r; }
            // 0 - x  →  -x  (a single `neg` instead of `mov rax,0; ...; sub`). Safe: x is still evaluated,
            // so any side effect in x is preserved (unlike x*0 → 0, which we do NOT fold).
            if op == "-" and lv == 0 { return map{ kind: "unary", op: "-", operand: r }; }
        }
        return map{ kind: "binary", op: node.op, left: l, right: r };
    }
    if k == "call" {
        let fa = []; let i = 0;
        while i < len(node.args) { push(fa, _fold(node.args[i])); i = i + 1; }
        return map{ kind: "call", func: node.func, args: fa };
    }
    return node;   // number / ident / string / bool / nil — atoms
}

// Emit an itoa+write for the value currently in RAX: print it as a decimal integer + newline,
// using the stack red zone as a digit buffer (no allocation; safe across the write syscall).
fn _emit_print_num(code) {
    // SIGNED print: the VM prints integers signed (−8, not 2^64−8), so match it. Record the sign in r8,
    // take the magnitude (unsigned itoa needs a non-negative dividend), and prepend '-' after the digits.
    push(code, 77); push(code, 49); push(code, 192);        // xor r8, r8   (r8 = 0: non-negative)
    push(code, 72); push(code, 133); push(code, 192);       // test rax, rax
    push(code, 121); push(code, 10);                        // jns +10  (skip neg + set-flag if sign clear)
    push(code, 72); push(code, 247); push(code, 216);       // neg rax   (rax = |rax|)
    push(code, 73); push(code, 199); push(code, 192); _elf.le(code, 1, 4); // mov r8, 1  (was negative)
    push(code, 185); _elf.le(code, 10, 4);                  // mov ecx, 10  (divisor)
    push(code, 72); push(code, 141); push(code, 116); push(code, 36); push(code, 255); // lea rsi, [rsp-1]
    push(code, 198); push(code, 6); push(code, 10);         // mov byte [rsi], 10  (newline)
    // do { rsi--; rax = rax/10, dl = rax%10 + '0'; [rsi]=dl; } while (rax != 0)
    push(code, 72); push(code, 255); push(code, 206);       // dec rsi
    push(code, 72); push(code, 49); push(code, 210);        // xor rdx, rdx
    push(code, 72); push(code, 247); push(code, 241);       // div rcx
    push(code, 128); push(code, 194); push(code, 48);       // add dl, '0'
    push(code, 136); push(code, 22);                        // mov [rsi], dl
    push(code, 72); push(code, 133); push(code, 192);       // test rax, rax
    push(code, 117); push(code, 237);                       // jnz -19  (back to `dec rsi`)
    push(code, 77); push(code, 133); push(code, 192);       // test r8, r8
    push(code, 116); push(code, 6);                         // jz +6  (skip minus if non-negative)
    push(code, 72); push(code, 255); push(code, 206);       // dec rsi
    push(code, 198); push(code, 6); push(code, 45);         // mov byte [rsi], '-'  (0x2D)
    push(code, 72); push(code, 137); push(code, 226);       // mov rdx, rsp
    push(code, 72); push(code, 41); push(code, 242);        // sub rdx, rsi   (len = rsp - rsi)
    push(code, 191); _elf.le(code, 1, 4);                   // mov edi, 1
    push(code, 184); _elf.le(code, 1, 4);                   // mov eax, 1  (write; rsi already = start)
    push(code, 15); push(code, 5);                          // syscall
}
// print a boolean in RAX (0 or 1) as "false"/"true" + newline — matches the VM, which prints `true`/`false`
// (not 1/0) for comparison results. Parks the two words in the data section; picks one with test+jz.
fn _emit_print_bool(code, slots) {
    let strs = try slots.strings catch nil;
    if strs == nil { _emit_print_num(code); return; }          // no data section → fall back to 1/0
    let toff = len(strs.data);
    let tb = str_to_bytes("true"); let j = 0; while j < len(tb) { push(strs.data, tb[j]); j = j + 1; } push(strs.data, 10);
    let tlen = len(strs.data) - toff;                          // 5  ("true\n")
    let foff = len(strs.data);
    let fb = str_to_bytes("false"); j = 0; while j < len(fb) { push(strs.data, fb[j]); j = j + 1; } push(strs.data, 10);
    let flen = len(strs.data) - foff;                          // 6  ("false\n")
    push(code, 72); push(code, 133); push(code, 192);          // test rax, rax
    push(code, 116); push(code, 29);                           // jz +29 → .false (over the 27-byte true-write + 2-byte jmp)
    push(code, 72); push(code, 190); let a1 = len(code); _elf.le(code, 0, 8); push(strs.patches, map{ at: a1, off: toff }); // movabs rsi, &"true\n"
    push(code, 186); _elf.le(code, tlen, 4);                   // mov edx, tlen
    push(code, 191); _elf.le(code, 1, 4);                      // mov edi, 1
    push(code, 184); _elf.le(code, 1, 4);                      // mov eax, 1 (write)
    push(code, 15); push(code, 5);                             // syscall
    push(code, 235); push(code, 27);                           // jmp +27 → .end (over the 27-byte false-write)
    push(code, 72); push(code, 190); let a2 = len(code); _elf.le(code, 0, 8); push(strs.patches, map{ at: a2, off: foff }); // movabs rsi, &"false\n"
    push(code, 186); _elf.le(code, flen, 4);                   // mov edx, flen
    push(code, 191); _elf.le(code, 1, 4);                      // mov edi, 1
    push(code, 184); _elf.le(code, 1, 4);                      // mov eax, 1
    push(code, 15); push(code, 5);                             // syscall
}
// print a heap string whose pointer is already in RAX (bytes at [rax+16], len [rax+8]) + a newline.
fn _emit_print_heapstr(code) {
    push(code, 72); push(code, 139); push(code, 80); push(code, 8);   // mov rdx, [rax+8]  (len)
    push(code, 72); push(code, 141); push(code, 112); push(code, 16); // lea rsi, [rax+16] (bytes)
    push(code, 191); _elf.le(code, 1, 4);                   // mov edi, 1
    push(code, 184); _elf.le(code, 1, 4);                   // mov eax, 1 (write)
    push(code, 15); push(code, 5);                          // syscall
    push(code, 198); push(code, 68); push(code, 36); push(code, 255); push(code, 10); // mov byte [rsp-1], 10
    push(code, 72); push(code, 141); push(code, 116); push(code, 36); push(code, 255);// lea rsi, [rsp-1]
    push(code, 186); _elf.le(code, 1, 4);                   // mov edx, 1
    push(code, 191); _elf.le(code, 1, 4);                   // mov edi, 1
    push(code, 184); _elf.le(code, 1, 4);                   // mov eax, 1
    push(code, 15); push(code, 5);                          // syscall (newline)
}
// RUNTIME-DISPATCHED print of the value in RAX: if it's a heap string (tag == TAG_STR) print its bytes,
// otherwise print it as a decimal integer. Lets the codegen print DYNAMICALLY-typed values correctly (the
// self-hosted evaluator's `print v`, where v is a number or a string only known at runtime). This is the
// tagged-value dividend — before tags, a mis-typed value printed as the wrong kind (a number-as-pointer
// segfaulted). Numbers/nil/negatives fail the heap-range check and take the integer path.
fn _emit_print_dynamic(code) {
    push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);      // movabs rcx, GBASE
    push(code, 72); push(code, 137); push(code, 194);                // mov rdx, rax
    push(code, 72); push(code, 41); push(code, 202);                 // sub rdx, rcx   (rdx = x - GBASE)
    push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ(), 8);    // movabs rcx, arena size
    push(code, 72); push(code, 57); push(code, 202);                 // cmp rdx, rcx
    push(code, 15); push(code, 131); let j1 = len(code); _elf.le(code, 0, 4);  // jae .num (not heap)
    push(code, 72); push(code, 139); push(code, 8);                  // mov rcx, [rax]  (tag word)
    push(code, 72); push(code, 131); push(code, 249); push(code, 1); // cmp rcx, TAG_STR
    push(code, 15); push(code, 133); let j2 = len(code); _elf.le(code, 0, 4);  // jne .num
    _emit_print_heapstr(code);                                       // string branch (rax = ptr)
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);        // jmp .done
    _patch32(code, j1, len(code) - (j1 + 4));                        // .num:
    _patch32(code, j2, len(code) - (j2 + 4));
    _emit_print_num(code);                                           // integer branch (rax = value)
    _patch32(code, jd, len(code) - (jd + 4));                        // .done:
}

// ── MAPS ──────────────────────────────────────────────────────────────────────
// Keys are compile-time strings, so they're interned to small integer IDs at compile time and the
// map stores (key_id, value) pairs — get/set compare integers (no runtime string compare). A map is
// heap-allocated as [count, id0, v0, id1, v1, …]; access is a short linear scan (structs are small).
fn _keyid(slots, name) {
    let ki = slots.keyids;
    if map_has(ki, name) { return ki[name]; }
    let id = len(ki); ki[name] = id; return id;
}
// Maps are STRING-KEYED: a pair is [keyptr, value] (16 bytes), keyptr a heap-string pointer. Key
// comparison is real string equality (via the injected __streq), so both literal keys (m.x) and runtime
// keys (m[word]) work uniformly. Pairs start at offset 16; count at [base], cap at [base+8].

// map ptr in rax, key string ptr in rbx → value in rax, or (handler==nil) trap / else handler value.
fn _emit_map_get_str(code, handler, slots, calls) {
    push(code, 83);                                                  // push rbx  (save query key)
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);  // mov rcx, [rax+8]  (count)
    push(code, 72); push(code, 141); push(code, 80); push(code, 24); // lea rdx, [rax+24] (first pair)
    let scan = len(code);
    push(code, 72); push(code, 133); push(code, 201);                // .scan: test rcx, rcx
    push(code, 15); push(code, 132); let jnf = len(code); _elf.le(code, 0, 4);  // jz notfound (rel32)
    push(code, 81); push(code, 82);                                  // push rcx ; push rdx
    push(code, 72); push(code, 139); push(code, 58);                 // mov rdi, [rdx]     (stored keyptr = arg0)
    push(code, 72); push(code, 139); push(code, 116); push(code, 36); push(code, 16); // mov rsi, [rsp+16] (query = arg1)
    push(code, 232); let ca = len(code); _elf.le(code, 0, 4); push(calls, map{ at: ca, name: "__streq" }); // call __streq
    push(code, 90); push(code, 89);                                  // pop rdx ; pop rcx
    push(code, 72); push(code, 133); push(code, 192);                // test rax, rax
    push(code, 15); push(code, 133); let jm = len(code); _elf.le(code, 0, 4);   // jnz match (rel32)
    push(code, 72); push(code, 131); push(code, 194); push(code, 16);// add rdx, 16
    push(code, 72); push(code, 255); push(code, 201);                // dec rcx
    push(code, 233); let jsb = len(code); _elf.le(code, 0, 4); _patch32(code, jsb, scan - (jsb + 4)); // jmp .scan
    _patch32(code, jm, len(code) - (jm + 4));                        // match:
    push(code, 72); push(code, 139); push(code, 66); push(code, 8);  // mov rax, [rdx+8]  (value)
    push(code, 72); push(code, 131); push(code, 196); push(code, 8); // add rsp, 8  (drop query key)
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);        // jmp done
    _patch32(code, jnf, len(code) - (jnf + 4));                      // notfound:
    push(code, 72); push(code, 131); push(code, 196); push(code, 8); // add rsp, 8  (drop query key)
    if handler == nil {
        push(code, 191); _elf.le(code, 134, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // trap
    } else { _ge_rax(handler, code, slots, calls); }
    _patch32(code, jd, len(code) - (jd + 4));                        // done:
}
// map ptr in rax, key string ptr in rbx → 1 if the key is present, else 0 (for map_has).
fn _emit_map_has(code, calls) {
    push(code, 83);                                                  // push rbx  (save query key)
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);  // mov rcx, [rax+8]  (count)
    push(code, 72); push(code, 141); push(code, 80); push(code, 24); // lea rdx, [rax+24] (first pair)
    let scan = len(code);
    push(code, 72); push(code, 133); push(code, 201);                // .scan: test rcx, rcx
    push(code, 15); push(code, 132); let jnf = len(code); _elf.le(code, 0, 4);  // jz notfound (rel32)
    push(code, 81); push(code, 82);                                  // push rcx ; push rdx
    push(code, 72); push(code, 139); push(code, 58);                 // mov rdi, [rdx]     (stored keyptr)
    push(code, 72); push(code, 139); push(code, 116); push(code, 36); push(code, 16); // mov rsi, [rsp+16] (query)
    push(code, 232); let ca = len(code); _elf.le(code, 0, 4); push(calls, map{ at: ca, name: "__streq" }); // call __streq
    push(code, 90); push(code, 89);                                  // pop rdx ; pop rcx
    push(code, 72); push(code, 133); push(code, 192);                // test rax, rax
    push(code, 15); push(code, 133); let jm = len(code); _elf.le(code, 0, 4);   // jnz found (rel32)
    push(code, 72); push(code, 131); push(code, 194); push(code, 16);// add rdx, 16
    push(code, 72); push(code, 255); push(code, 201);                // dec rcx
    push(code, 233); let jsb = len(code); _elf.le(code, 0, 4); _patch32(code, jsb, scan - (jsb + 4)); // jmp .scan
    _patch32(code, jm, len(code) - (jm + 4));                        // found:
    push(code, 184); _elf.le(code, 1, 4);                            // mov eax, 1
    push(code, 72); push(code, 131); push(code, 196); push(code, 8); // add rsp, 8
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);        // jmp done
    _patch32(code, jnf, len(code) - (jnf + 4));                      // notfound:
    push(code, 72); push(code, 131); push(code, 196); push(code, 8); // add rsp, 8
    push(code, 49); push(code, 192);                                 // xor eax, eax
    _patch32(code, jd, len(code) - (jd + 4));                        // done:
}
// map ptr in rax, value on TOP OF STACK, key string ptr in rbx → set-or-append (traps if cap exhausted).
fn _emit_map_set_str(code, calls) {
    push(code, 83);                                                  // push rbx  (save query key)
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);  // mov rcx, [rax+8]  (count)
    push(code, 72); push(code, 141); push(code, 80); push(code, 24); // lea rdx, [rax+24] (first pair)
    let scan = len(code);
    push(code, 72); push(code, 133); push(code, 201);                // .scan: test rcx, rcx
    push(code, 15); push(code, 132); let jnf = len(code); _elf.le(code, 0, 4);  // jz notfound (rel32)
    push(code, 80); push(code, 81); push(code, 82);                  // push rax ; push rcx ; push rdx
    push(code, 72); push(code, 139); push(code, 58);                 // mov rdi, [rdx]     (stored keyptr)
    push(code, 72); push(code, 139); push(code, 116); push(code, 36); push(code, 24); // mov rsi, [rsp+24] (query)
    push(code, 232); let ca = len(code); _elf.le(code, 0, 4); push(calls, map{ at: ca, name: "__streq" }); // call __streq
    push(code, 90); push(code, 89);                                  // pop rdx ; pop rcx
    push(code, 72); push(code, 133); push(code, 192);                // test rax, rax  (the __streq RESULT)
    push(code, 88);                                                  // pop rax  (restore map — flags survive)
    push(code, 15); push(code, 133); let jm = len(code); _elf.le(code, 0, 4);   // jnz found (rel32)
    push(code, 72); push(code, 131); push(code, 194); push(code, 16);// add rdx, 16
    push(code, 72); push(code, 255); push(code, 201);                // dec rcx
    push(code, 233); let jsb = len(code); _elf.le(code, 0, 4); _patch32(code, jsb, scan - (jsb + 4)); // jmp .scan
    // notfound → append (rax = map ptr again; recompute pair slot at end)
    _patch32(code, jnf, len(code) - (jnf + 4));
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);  // mov rcx, [rax+8]  (count)
    push(code, 72); push(code, 59); push(code, 72); push(code, 16);  // cmp rcx, [rax+16] (cap)
    push(code, 114); push(code, 12);                                 // jb +12 → do-append
    push(code, 191); _elf.le(code, 134, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // trap (full)
    push(code, 72); push(code, 137); push(code, 202);                // mov rdx, rcx
    push(code, 72); push(code, 193); push(code, 226); push(code, 4); // shl rdx, 4   (count*16)
    push(code, 72); push(code, 1); push(code, 194);                  // add rdx, rax  (= rax + count*16)
    push(code, 91);                                                  // pop rbx  (query key ptr)
    push(code, 72); push(code, 137); push(code, 90); push(code, 24); // mov [rdx+24], rbx  (keyptr)
    push(code, 94);                                                  // pop rsi  (value)
    push(code, 72); push(code, 137); push(code, 114); push(code, 32);// mov [rdx+32], rsi  (value)
    push(code, 72); push(code, 255); push(code, 64); push(code, 8);  // inc qword [rax+8]  (count++)
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);        // jmp done
    _patch32(code, jm, len(code) - (jm + 4));                        // found:
    push(code, 72); push(code, 131); push(code, 196); push(code, 8); // add rsp, 8  (drop query key)
    push(code, 94);                                                  // pop rsi  (value)
    push(code, 72); push(code, 137); push(code, 114); push(code, 8); // mov [rdx+8], rsi
    _patch32(code, jd, len(code) - (jd + 4));                        // done:
}
// Emit `obj[key]` map read: eval the map, eval/materialize the key string, then scan by string equality.
fn _emit_map_get_access(code, obj, keynode, handler, slots, calls) {
    _ge_rax(obj, code, slots, calls);                   // rax = map ptr
    push(code, 80);                                     // push map
    _ge_rax(keynode, code, slots, calls);               // rax = key string ptr
    push(code, 72); push(code, 137); push(code, 195);   // mov rbx, rax  (key)
    push(code, 88);                                     // pop rax  (map)
    _emit_map_get_str(code, handler, slots, calls);
}
// Emit `obj[key] = val` map write (value first so it survives the key/map evaluation on the stack).
fn _emit_map_set_access(code, obj, keynode, valnode, slots, calls) {
    _ge_rax(valnode, code, slots, calls); push(code, 80);   // value → stack
    _ge_rax(obj, code, slots, calls); push(code, 80);       // map → stack
    _ge_rax(keynode, code, slots, calls);                   // key → rax
    push(code, 72); push(code, 137); push(code, 195);       // mov rbx, rax  (key)
    push(code, 88);                                         // pop rax  (map)
    _emit_map_set_str(code, calls);                         // value still on the stack
}
// A string-literal AST node for a member/literal key.
fn _str_node(s) { return map{ kind: "string", value: s }; }

// Is `objnode` provably an ARRAY at compile time? (an array literal, or a var typed as one via strarrs /
// arrvars) — lets `obj[idx]` keep the fast static array path. Anything else is compiled with runtime
// tag-dispatch so a map or string obj also works. Keeps numeric array loops zero-overhead.
fn _known_array(objnode, slots) {
    if objnode.kind == "array" { return true; }
    if objnode.kind == "ident" {
        let sa = try slots.strarrs catch nil; if sa != nil and map_has(sa, objnode.name) { return true; }
        let av = try slots.arrvars catch nil; if av != nil and map_has(av, objnode.name) { return true; }
    }
    return false;
}
// Is `objnode` provably a MAP at compile time? (a map literal, or a var typed as one) — lets `m[key]` keep
// the fast static string-keyed path. Anything else with a runtime string key is compiled with tag-dispatch.
fn _known_map(objnode, slots) {
    if objnode.kind == "map" { return true; }
    if objnode.kind == "ident" {
        let mv = try slots.mapvars catch nil; if mv != nil and map_has(mv, objnode.name) { return true; }
    }
    return false;
}

// ── RUNTIME-TAG-DISPATCHED INDEX ──────────────────────────────────────────────────────────────────────
// `obj[idx]` where the object's type isn't statically known (a dynamically-typed value — the self-hosted
// evaluator's `obj[idx]` and env maps). Dispatch on the object's TAG at runtime: TAG_ARR → array element,
// TAG_MAP → string-keyed get (idx is a key pointer), TAG_STR → 1-char string. This is what lets pblang's
// own interpreter — where a value is an array OR a map OR a string only at runtime — compile to native.
fn _emit_index_dynamic(code, objnode, idxnode, slots, calls) {
    _ge_rax(objnode, code, slots, calls); push(code, 80);            // obj → push
    _ge_rax(idxnode, code, slots, calls);                           // idx → rax
    push(code, 72); push(code, 137); push(code, 195);               // mov rbx, rax  (idx/key)
    push(code, 88);                                                 // pop rax  (obj)
    push(code, 72); push(code, 139); push(code, 8);                 // mov rcx, [rax]  (tag)
    push(code, 72); push(code, 131); push(code, 249); push(code, 3);// cmp rcx, TAG_MAP
    push(code, 15); push(code, 132); let jmap = len(code); _elf.le(code, 0, 4);  // je .map
    push(code, 72); push(code, 131); push(code, 249); push(code, 1);// cmp rcx, TAG_STR
    push(code, 15); push(code, 132); let jstr = len(code); _elf.le(code, 0, 4);  // je .str
    // .arr:  rax = array handle, rbx = index
    push(code, 72); push(code, 59); push(code, 88); push(code, 8);  // cmp rbx, [rax+8]  (len)
    push(code, 114); push(code, 12);                                // jb +12
    push(code, 191); _elf.le(code, 134, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // trap 134
    push(code, 72); push(code, 139); push(code, 64); push(code, 24);// mov rax, [rax+24]  (dataptr)
    push(code, 72); push(code, 139); push(code, 4); push(code, 216);// mov rax, [rax+rbx*8]
    push(code, 233); let jd1 = len(code); _elf.le(code, 0, 4);      // jmp .done
    // .map:  rax = map, rbx = key pointer
    _patch32(code, jmap, len(code) - (jmap + 4));
    _emit_map_get_str(code, nil, slots, calls);                     // value → rax (traps on miss)
    push(code, 233); let jd2 = len(code); _elf.le(code, 0, 4);      // jmp .done
    // .str:  rax = string, rbx = index → fresh 1-char string
    _patch32(code, jstr, len(code) - (jstr + 4));
    push(code, 72); push(code, 59); push(code, 88); push(code, 8);  // cmp rbx, [rax+8]  (len)
    push(code, 114); push(code, 12);                                // jb +12
    push(code, 191); _elf.le(code, 134, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // trap 134
    push(code, 15); push(code, 182); push(code, 84); push(code, 24); push(code, 16); // movzx edx, byte [rax+rbx+16]
    push(code, 76); push(code, 137); push(code, 248);              // mov rax, r15
    push(code, 73); push(code, 131); push(code, 199); push(code, 24); // add r15, 24
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);  // mov qword [rax], TAG_STR
    push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 1, 4); // mov qword [rax+8], 1
    push(code, 136); push(code, 80); push(code, 16);              // mov [rax+16], dl
    // .done:
    _patch32(code, jd1, len(code) - (jd1 + 4));
    _patch32(code, jd2, len(code) - (jd2 + 4));
}
// `obj[idx] = val` with a runtime-unknown object type. TAG_MAP → string-keyed set; else → array store.
fn _emit_index_set_dynamic(code, objnode, idxnode, valnode, slots, calls) {
    _ge_rax(valnode, code, slots, calls); push(code, 80);          // value → push
    _ge_rax(objnode, code, slots, calls); push(code, 80);          // obj → push
    _ge_rax(idxnode, code, slots, calls);                          // idx → rax
    push(code, 72); push(code, 137); push(code, 195);              // mov rbx, rax  (idx/key)
    push(code, 88);                                                // pop rax  (obj)
    push(code, 72); push(code, 139); push(code, 8);                // mov rcx, [rax]  (tag)
    push(code, 72); push(code, 131); push(code, 249); push(code, 3);// cmp rcx, TAG_MAP
    push(code, 15); push(code, 132); let jmap = len(code); _elf.le(code, 0, 4);  // je .map
    // .arr:  value on stack, rax = array handle, rbx = index
    push(code, 72); push(code, 59); push(code, 88); push(code, 8); // cmp rbx, [rax+8]  (len)
    push(code, 114); push(code, 12);                               // jb +12
    push(code, 191); _elf.le(code, 134, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // trap 134
    push(code, 90);                                                // pop rdx  (value)
    push(code, 72); push(code, 139); push(code, 64); push(code, 24);// mov rax, [rax+24]  (dataptr)
    push(code, 72); push(code, 137); push(code, 20); push(code, 216);// mov [rax+rbx*8], rdx
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);      // jmp .done
    // .map:  value on stack, rax = map, rbx = key pointer
    _patch32(code, jmap, len(code) - (jmap + 4));
    _emit_map_set_str(code, calls);                                // consumes value on stack
    // .done:
    _patch32(code, jd, len(code) - (jd + 4));
}

// ── HEAP STRINGS ──────────────────────────────────────────────────────────────
// A string is a TAGGED heap object [TAG_STR, len, bytes…] (tag at [ptr], len at [ptr+8], bytes at
// [ptr+16]). Concatenation copies both operands into a fresh object using `rep movsb`.
fn _emit_str_concat(left, right, code, slots, calls) {
    _ge_rax(left, code, slots, calls);                  // rax = s1 ptr
    push(code, 80);                                     // push s1
    _ge_rax(right, code, slots, calls);                 // rax = s2 ptr
    push(code, 72); push(code, 137); push(code, 195);   // mov rbx, rax   (s2)
    push(code, 88);                                     // pop rax        (s1)
    _emit_concat_rr(code);
}
// Concatenate the strings whose pointers are in RAX (s1) and RBX (s2) → fresh string in RAX. The
// register-based core of string `+`, reused by both static concat and the runtime-dispatched `+`.
fn _emit_concat_rr(code) {
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);   // mov rcx, [rax+8]  (len1)
    push(code, 72); push(code, 3); push(code, 75); push(code, 8);     // add rcx, [rbx+8]  (rcx = total len)
    push(code, 76); push(code, 137); push(code, 250);   // mov rdx, r15    (result base)
    push(code, 72); push(code, 199); push(code, 2); _elf.le(code, 1, 4);  // mov qword [rdx], TAG_STR
    push(code, 72); push(code, 137); push(code, 74); push(code, 8);   // mov [rdx+8], rcx  (total len)
    push(code, 73); push(code, 1); push(code, 207);     // add r15, rcx
    push(code, 73); push(code, 131); push(code, 199); push(code, 23); // add r15, 23  (16 header + 7 align)
    push(code, 73); push(code, 131); push(code, 231); push(code, 248);// and r15, -8   (realign)
    push(code, 252);                                    // cld
    push(code, 72); push(code, 141); push(code, 112); push(code, 16); // lea rsi, [rax+16] (s1 bytes)
    push(code, 72); push(code, 141); push(code, 122); push(code, 16); // lea rdi, [rdx+16] (dst)
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);   // mov rcx, [rax+8]  (len1)
    push(code, 243); push(code, 164);                   // rep movsb
    push(code, 72); push(code, 141); push(code, 115); push(code, 16); // lea rsi, [rbx+16] (s2 bytes)
    push(code, 72); push(code, 139); push(code, 75); push(code, 8);   // mov rcx, [rbx+8]  (len2)
    push(code, 243); push(code, 164);                   // rep movsb  (rdi continues past s1)
    push(code, 72); push(code, 137); push(code, 208);   // mov rax, rdx   (result ptr)
}

// String equality: s1 in RAX, s2 in RBX → leaves 1/0 in RAX (0/1 if `negate`, i.e. `!=`). Compares the
// length words, then bytes one at a time. All jumps are fixed-size rel8 (offsets computed by hand).
// RUNTIME-DISPATCHED equality: left in RAX, right in RBX → 1/0 (negated for `!=`). If BOTH operands are
// heap strings, compare bytes; otherwise compare the raw 64-bit values (correct for numbers, and for a
// number-vs-string which are never equal). Lets the self-hosted evaluator's `l == r` — where l,r are only
// typed at runtime — work: `5 == 5` true, `"a" == "a"` true by content, `5 == "5"` false.
fn _emit_eq_dynamic(code, negate) {
    let raws = [];   // patch points that branch to the raw-compare path
    // left a heap string?  (range check + tag == TAG_STR)
    push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);   // movabs rcx, GBASE
    push(code, 72); push(code, 137); push(code, 194);             // mov rdx, rax
    push(code, 72); push(code, 41); push(code, 202);              // sub rdx, rcx
    push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ(), 8);  // movabs rcx, arena size
    push(code, 72); push(code, 57); push(code, 202);              // cmp rdx, rcx
    push(code, 15); push(code, 131); let r1 = len(code); _elf.le(code, 0, 4); push(raws, r1);  // jae .raw
    push(code, 72); push(code, 139); push(code, 8);               // mov rcx, [rax]
    push(code, 72); push(code, 131); push(code, 249); push(code, 1);// cmp rcx, TAG_STR
    push(code, 15); push(code, 133); let r2 = len(code); _elf.le(code, 0, 4); push(raws, r2);  // jne .raw
    // right a heap string?
    push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);   // movabs rcx, GBASE
    push(code, 72); push(code, 137); push(code, 218);             // mov rdx, rbx
    push(code, 72); push(code, 41); push(code, 202);              // sub rdx, rcx
    push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ(), 8);  // movabs rcx, arena size
    push(code, 72); push(code, 57); push(code, 202);              // cmp rdx, rcx
    push(code, 15); push(code, 131); let r3 = len(code); _elf.le(code, 0, 4); push(raws, r3);  // jae .raw
    push(code, 72); push(code, 139); push(code, 11);              // mov rcx, [rbx]
    push(code, 72); push(code, 131); push(code, 249); push(code, 1);// cmp rcx, TAG_STR
    push(code, 15); push(code, 133); let r4 = len(code); _elf.le(code, 0, 4); push(raws, r4);  // jne .raw
    // both strings → byte compare (rax=s1, rbx=s2)
    _emit_str_eq(code, negate);
    push(code, 233); let jd = len(code); _elf.le(code, 0, 4);     // jmp .done
    // .raw: compare the two raw values
    let ri = 0; while ri < len(raws) { _patch32(code, raws[ri], len(code) - (raws[ri] + 4)); ri = ri + 1; }
    push(code, 72); push(code, 57); push(code, 216);             // cmp rax, rbx
    if negate { push(code, 15); push(code, 149); push(code, 192); } else { push(code, 15); push(code, 148); push(code, 192); } // setne/sete al
    push(code, 15); push(code, 182); push(code, 192);            // movzx eax, al
    _patch32(code, jd, len(code) - (jd + 4));                    // .done:
}
fn _emit_str_eq(code, negate) {
    let eqval = 1; let neqval = 0;
    if negate { eqval = 0; neqval = 1; }
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);    // mov rcx, [rax+8] (len1)
    push(code, 72); push(code, 59); push(code, 75); push(code, 8);     // cmp rcx, [rbx+8] (len2)
    push(code, 117); push(code, 32);                                   // jne .neq (+32)
    push(code, 72); push(code, 49); push(code, 210);                   // xor rdx, rdx     (index)
    push(code, 72); push(code, 57); push(code, 202);                   // .loop: cmp rdx, rcx
    push(code, 115); push(code, 17);                                   // jae .eq (+17)
    push(code, 64); push(code, 138); push(code, 116); push(code, 16); push(code, 16); // mov sil, [rax+rdx+16]
    push(code, 64); push(code, 58); push(code, 116); push(code, 19); push(code, 16);  // cmp sil, [rbx+rdx+16]
    push(code, 117); push(code, 12);                                   // jne .neq (+12)
    push(code, 72); push(code, 255); push(code, 194);                 // inc rdx
    push(code, 235); push(code, 234);                                 // jmp .loop (-22)
    push(code, 184); _elf.le(code, eqval, 4);                         // .eq:  mov eax, eqval
    push(code, 235); push(code, 5);                                  // jmp .done (+5)
    push(code, 184); _elf.le(code, neqval, 4);                        // .neq: mov eax, neqval
}

// str(n): number in RAX → a fresh heap string [len, digit-bytes…]. Digits are generated (reverse) into
// the stack red zone with the same unsigned itoa loop as _emit_print_num, then copied into a heap
// [len, bytes] object via rep movsb. (Unsigned, matching print; negatives print as their 2's-complement.)
fn _emit_str_from_num(code) {
    push(code, 72); push(code, 141); push(code, 52); push(code, 36);   // lea rsi, [rsp]   (scratch top)
    push(code, 185); _elf.le(code, 10, 4);                             // mov ecx, 10  (divisor)
    push(code, 72); push(code, 255); push(code, 206);                  // .loop: dec rsi
    push(code, 72); push(code, 49); push(code, 210);                   // xor rdx, rdx
    push(code, 72); push(code, 247); push(code, 241);                  // div rcx
    push(code, 128); push(code, 194); push(code, 48);                  // add dl, '0'
    push(code, 136); push(code, 22);                                   // mov [rsi], dl
    push(code, 72); push(code, 133); push(code, 192);                  // test rax, rax
    push(code, 117); push(code, 237);                                  // jnz -19 → .loop
    push(code, 72); push(code, 137); push(code, 226);                  // mov rdx, rsp
    push(code, 72); push(code, 41); push(code, 242);                   // sub rdx, rsi   (rdx = len)
    push(code, 76); push(code, 137); push(code, 248);                  // mov rax, r15   (result base)
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4); // mov qword [rax], TAG_STR
    push(code, 73); push(code, 131); push(code, 199); push(code, 16);  // add r15, 16
    push(code, 73); push(code, 1); push(code, 215);                    // add r15, rdx
    push(code, 73); push(code, 131); push(code, 199); push(code, 7);   // add r15, 7
    push(code, 73); push(code, 131); push(code, 231); push(code, 248); // and r15, -8   (realign)
    push(code, 72); push(code, 137); push(code, 80); push(code, 8);    // mov [rax+8], rdx (store len)
    push(code, 72); push(code, 141); push(code, 120); push(code, 16);  // lea rdi, [rax+16] (dst bytes)
    push(code, 72); push(code, 137); push(code, 209);                  // mov rcx, rdx    (count)
    push(code, 252);                                                   // cld
    push(code, 243); push(code, 164);                                  // rep movsb  (rsi already = src)
    // rax still = result base
}

// is_map / is_array / is_string: probe one eight-byte tag only when the entire
// read fits in the mapped arena. The last seven bytes cannot start a tag read.
// Unsigned subtraction also rejects addresses below the arena (including nil
// and negative values). This checks read bounds, not allocation provenance:
// integers and heap pointers still share the same untagged value lane.
fn _emit_is_type(code, tag) {
    push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);      // movabs rcx, GBASE
    push(code, 72); push(code, 137); push(code, 194);                // mov rdx, rax
    push(code, 72); push(code, 41); push(code, 202);                 // sub rdx, rcx   (rdx = x - GBASE)
    push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ() - 7, 8); // movabs rcx, exclusive tag-start bound
    push(code, 72); push(code, 57); push(code, 202);                 // cmp rdx, rcx
    push(code, 115); push(code, 15);                                 // jae notheap (+15)
    push(code, 72); push(code, 139); push(code, 0);                  // mov rax, [rax]  (tag word)
    push(code, 72); push(code, 131); push(code, 248); push(code, tag);// cmp rax, tag
    push(code, 15); push(code, 148); push(code, 192);                // sete al
    push(code, 15); push(code, 182); push(code, 192);                // movzx eax, al
    push(code, 235); push(code, 2);                                  // jmp done (+2)
    push(code, 49); push(code, 192);                                 // notheap: xor eax, eax
    // done:
}

// Conservative unsigned range facts used only to select semantics-preserving machine-code
// strength reductions. A missing fact always falls back to the existing 64-bit path.
// Facts are intentionally capped below 2^32: every arithmetic operation in this analysis
// therefore remains exact in PBLang's numeric implementation, and the generated reciprocal
// multiply cannot overflow its 64-bit product.
fn _range_copy(src) {
    let out = map{};
    if src == nil { return out; }
    let keys = map_keys(src); let i = 0;
    while i < len(keys) { let r = src[keys[i]]; out[keys[i]] = map{ lo: r.lo, hi: r.hi }; i = i + 1; }
    return out;
}
fn _range_expr(node0, slots) {
    if node0 == nil { return nil; }
    let node = _fold(node0); let k = node.kind; let MAX = 4294967295;
    if k == "number" {
        let v = parse_number(node.value);
        if v == num_floor(v) and v >= 0 and v <= MAX { return map{ lo: v, hi: v }; }
        return nil;
    }
    if k == "bool" { let v = 0; if node.value { v = 1; } return map{ lo: v, hi: v }; }
    if k == "nil" { return map{ lo: 0, hi: 0 }; }
    if k == "ident" {
        let ranges = try slots.ranges catch nil;
        if ranges != nil and map_has(ranges, node.name) { return ranges[node.name]; }
        return nil;
    }
    if k == "unary" and (node.op == "not" or node.op == "!") { return map{ lo: 0, hi: 1 }; }
    if k == "binary" {
        let op = node.op;
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" {
            return map{ lo: 0, hi: 1 };
        }
        let a = _range_expr(node.left, slots); let b = _range_expr(node.right, slots);
        if a == nil or b == nil { return nil; }
        if op == "+" {
            let hi = a.hi + b.hi;
            if hi <= MAX { return map{ lo: a.lo + b.lo, hi: hi }; }
            return nil;
        }
        if op == "-" {
            if a.lo >= b.hi { return map{ lo: a.lo - b.hi, hi: a.hi - b.lo }; }
            return nil;
        }
        if op == "*" {
            let hi = a.hi * b.hi;
            if hi <= MAX { return map{ lo: a.lo * b.lo, hi: hi }; }
            return nil;
        }
        if (op == "/" or op == "%") and node.right.kind == "number" {
            let d = parse_number(node.right.value);
            if d == num_floor(d) and d > 0 {
                if op == "/" { return map{ lo: num_floor(a.lo / d), hi: num_floor(a.hi / d) }; }
                let hi = d - 1; if a.hi < hi { hi = a.hi; }
                return map{ lo: 0, hi: hi };
            }
        }
        if (op == "&" or op == "bit_and") and node.right.kind == "number" {
            let mask = parse_number(node.right.value);
            if mask == num_floor(mask) and mask >= 0 and mask <= MAX {
                let hi = mask; if a.hi < hi { hi = a.hi; }
                return map{ lo: 0, hi: hi };
            }
        }
        return nil;
    }
    if k == "call" and node.func.kind == "ident" and node.func.name == "bit_and" and len(node.args) == 2 and node.args[1].kind == "number" {
        let a = _range_expr(node.args[0], slots); let mask = parse_number(node.args[1].value);
        if a != nil and mask == num_floor(mask) and mask >= 0 and mask <= MAX {
            let hi = mask; if a.hi < hi { hi = a.hi; }
            return map{ lo: 0, hi: hi };
        }
    }
    return nil;
}
fn _range_store(slots, name, r) {
    let ranges = try slots.ranges catch nil;
    if ranges == nil { return; }
    if r == nil { if map_has(ranges, name) { map_remove(ranges, name); } }
    else { ranges[name] = map{ lo: r.lo, hi: r.hi }; }
}
fn _range_assignment(st) {
    if st.kind == "let" or st.kind == "const" { return map{ name: st.name, value: st.value }; }
    if st.kind == "expr_stmt" and st.expr.kind == "assign" { return map{ name: st.expr.name, value: st.expr.value }; }
    if st.kind == "expr_stmt" and st.expr.kind == "assign_to" and st.expr.target.kind == "ident" {
        return map{ name: st.expr.target.name, value: st.expr.value };
    }
    return nil;
}
fn _range_collect_assigned(stmts, out) {
    let i = 0;
    while i < len(stmts) {
        let st = stmts[i]; let a = _range_assignment(st);
        if a != nil { out[a.name] = true; }
        if st.kind == "while" or st.kind == "for" or st.kind == "for_range" or st.kind == "for_in" {
            _range_collect_assigned(_stmts_of2(st.body), out);
        }
        if st.kind == "if" {
            _range_collect_assigned(_stmts_of2(st.then), out);
            let es = try st.elifs catch nil; let ei = 0;
            if es != nil { while ei < len(es) { _range_collect_assigned(_stmts_of2(es[ei].body), out); ei = ei + 1; } }
            let els = try st.else catch nil; if els != nil { _range_collect_assigned(_stmts_of2(els), out); }
        }
        i = i + 1;
    }
}
fn _range_invalidate_assigned(ranges, stmts) {
    if ranges == nil { return; }
    let changed = map{}; _range_collect_assigned(stmts, changed);
    let keys = map_keys(changed); let i = 0;
    while i < len(keys) { if map_has(ranges, keys[i]) { map_remove(ranges, keys[i]); } i = i + 1; }
}
fn _range_assignment_profile(stmts, name) {
    let profile = map{ count: 0, value: nil, nested: false };
    let i = 0;
    while i < len(stmts) {
        let st = stmts[i]; let a = _range_assignment(st);
        if a != nil and a.name == name { profile.count = profile.count + 1; profile.value = a.value; }
        if st.kind == "while" or st.kind == "for" or st.kind == "for_range" or st.kind == "for_in" or st.kind == "if" {
            let nested = map{};
            if st.kind == "if" {
                _range_collect_assigned(_stmts_of2(st.then), nested);
                let es = try st.elifs catch nil; let ei = 0;
                if es != nil { while ei < len(es) { _range_collect_assigned(_stmts_of2(es[ei].body), nested); ei = ei + 1; } }
                let els = try st.else catch nil; if els != nil { _range_collect_assigned(_stmts_of2(els), nested); }
            } else { _range_collect_assigned(_stmts_of2(st.body), nested); }
            if map_has(nested, name) { profile.nested = true; }
        }
        i = i + 1;
    }
    return profile;
}
fn _range_is_positive_counter(stmts, name) {
    let p = _range_assignment_profile(stmts, name);
    if p.count != 1 or p.nested or p.value == nil { return false; }
    let v = _fold(p.value);
    if v.kind != "binary" or v.op != "+" or v.left.kind != "ident" or v.left.name != name or v.right.kind != "number" { return false; }
    let step = parse_number(v.right.value);
    return step == num_floor(step) and step > 0 and step <= 2147483647;
}
fn _range_prepare_loop(node, slots) {
    let outer = try slots.ranges catch map{};
    let loop_ranges = _range_copy(outer); slots.ranges = loop_ranges;
    let body = _stmts_of2(node.body);
    // Pre-loop facts are not automatically loop invariants. Remove every value
    // written by the body, then reconstruct only facts with an inductive proof.
    _range_invalidate_assigned(loop_ranges, body);
    let c = _fold(node.cond);
    if c.kind == "binary" and (c.op == "<" or c.op == "<=") and c.left.kind == "ident" and c.right.kind == "number" {
        let bound = parse_number(c.right.value); if c.op == "<" { bound = bound - 1; }
        if bound == num_floor(bound) and bound >= 0 and bound <= 4294967295 and map_has(outer, c.left.name) and _range_is_positive_counter(body, c.left.name) {
            let old = outer[c.left.name];
            if old.lo >= 0 and old.lo <= bound { loop_ranges[c.left.name] = map{ lo: old.lo, hi: bound }; }
        }
    }
    // A modulo assignment establishes a loop invariant independent of the number of iterations.
    // Repeat a few times so mutually ordered direct assignments can consume earlier invariants.
    let pass = 0;
    while pass < 4 {
        let i = 0;
        while i < len(body) {
            let a = _range_assignment(body[i]);
            if a != nil {
                let rhs = _fold(a.value);
                let profile = _range_assignment_profile(body, a.name);
                if profile.count == 1 and not profile.nested and rhs.kind == "binary" and rhs.op == "%" and rhs.right.kind == "number" {
                    let d = parse_number(rhs.right.value);
                    if d == num_floor(d) and d > 0 and d <= 4294967296 and map_has(outer, a.name) and outer[a.name].lo >= 0 {
                        // Across an arbitrary number of iterations the pre-modulo value can grow toward
                        // the divisor even when the first few abstract iterations are much smaller. Use
                        // the full modulo invariant, never a finite-iteration underestimate.
                        let hi = d - 1;
                        let before = outer[a.name]; if before.hi > hi { hi = before.hi; }
                        loop_ranges[a.name] = map{ lo: 0, hi: hi };
                        // Inductive step: under the candidate invariant, the pre-modulo expression must
                        // itself remain a proven non-negative u32 value. Otherwise discard the candidate.
                        let left = _range_expr(rhs.left, slots);
                        if left == nil or left.lo < 0 { map_remove(loop_ranges, a.name); }
                    }
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return outer;
}

// Exact reciprocal for unsigned 32-bit division. floor(2^32/d) is corrected with
// exact products <=2^33 so compile-time floating rounding can never alter the integer.
fn _u32_reciprocal(d) {
    let BASE = 4294967296; let m = num_floor(BASE / d);
    while m * d > BASE { m = m - 1; }
    while (m + 1) * d <= BASE { m = m + 1; }
    return m;
}
fn _emit_cmp_rcx_imm(code, d) {
    if d <= 127 { push(code, 72); push(code, 131); push(code, 249); push(code, d); }
    else { push(code, 72); push(code, 129); push(code, 249); _elf.le(code, d, 4); }
}
fn _emit_sub_rcx_imm(code, d) {
    if d <= 127 { push(code, 72); push(code, 131); push(code, 233); push(code, d); }
    else { push(code, 72); push(code, 129); push(code, 233); _elf.le(code, d, 4); }
}
fn _emit_cmp_rax_imm(code, d) {
    if d <= 127 { push(code, 72); push(code, 131); push(code, 248); push(code, d); }
    else { push(code, 72); push(code, 61); _elf.le(code, d, 4); }
}
fn _emit_sub_rax_imm(code, d) {
    if d <= 127 { push(code, 72); push(code, 131); push(code, 232); push(code, d); }
    else { push(code, 72); push(code, 45); _elf.le(code, d, 4); }
}
fn _emit_udivmod_const_u32(code, d, want_remainder) {
    let m = _u32_reciprocal(d);
    push(code, 80);                                                   // push rax (original dividend)
    push(code, 185); _elf.le(code, m, 4);                            // mov ecx, reciprocal
    push(code, 72); push(code, 15); push(code, 175); push(code, 193);// imul rax, rcx
    push(code, 72); push(code, 193); push(code, 232); push(code, 32);// shr rax, 32 (q0)
    push(code, 89);                                                   // pop rcx (original dividend)
    if want_remainder {
        push(code, 72); push(code, 105); push(code, 192); _elf.le(code, d, 4); // imul rax,rax,d
        push(code, 72); push(code, 41); push(code, 193);              // sub rcx,rax (candidate remainder)
        _emit_cmp_rcx_imm(code, d);
        let skip = 4; if d > 127 { skip = 7; }
        push(code, 114); push(code, skip);                            // jb done-correction
        _emit_sub_rcx_imm(code, d);                                  // one correction is sufficient
        push(code, 72); push(code, 137); push(code, 200);            // mov rax,rcx
    } else {
        push(code, 72); push(code, 137); push(code, 194);            // mov rdx,rax (q0)
        push(code, 72); push(code, 105); push(code, 210); _elf.le(code, d, 4); // imul rdx,rdx,d
        push(code, 72); push(code, 41); push(code, 209);              // sub rcx,rdx (candidate remainder)
        _emit_cmp_rcx_imm(code, d);
        push(code, 114); push(code, 3);                              // jb done
        push(code, 72); push(code, 255); push(code, 192);            // inc rax
    }
}

// emit code that leaves the value of `node` in RAX (does NOT push it)
fn _ge_rax(node0, code, slots, calls) {
    let node = _fold(node0);
    let k = node.kind;
    if k == "number" {
        // mov eax, imm32 zero-extends into rax and covers 0..2^32-1. A literal >= 2^32 (e.g. a 64-bit mask
        // or timestamp) would be TRUNCATED to its low 32 bits, so use movabs rax, imm64 for those.
        let v = parse_number(node.value);
        if v == 0 { push(code, 49); push(code, 192); }                                // xor eax,eax (2B vs 5B; also faster)
        elif v >= 0 and v < 4294967296 { push(code, 184); _elf.le(code, v, 4); }      // mov eax, imm32
        else { push(code, 72); push(code, 184); _elf.le(code, v, 8); }                // movabs rax, imm64
        return true;
    }
    if k == "bool" { let bv = 0; if node.value { bv = 1; } push(code, 184); _elf.le(code, bv, 4); return true; }  // true→1 / false→0
    if k == "nil" { push(code, 49); push(code, 192); return true; }                                              // nil → 0
    if k == "throw" {
        // no exception propagation in the minimal runtime — a throw ABORTS (exit 70). Valid programs never
        // reach a throw; it marks an unrecoverable error (undefined var, bad op, …).
        let v = try node.value catch nil; if v == nil { v = try node.expr catch nil; }
        if v != nil { _ge_rax(v, code, slots, calls); }   // evaluate the message (its side effects), then abort
        push(code, 191); _elf.le(code, 70, 4);            // mov edi, 70
        push(code, 184); _elf.le(code, 60, 4);            // mov eax, 60 (exit)
        push(code, 15); push(code, 5);                    // syscall
        return true;
    }
    if k == "try" {
        // `try MAP[key] catch DEFAULT` / `try MAP.key catch DEFAULT` → map get-or-default (no trap on miss).
        // (General exception catching isn't possible in the minimal runtime — a trap exits the process — so
        // only this get-or-default shape is supported; a `try` over a non-trapping body is just the body.)
        let b = node.body;
        if b.kind == "member" {
            _emit_map_get_access(code, b.obj, _str_node(b.name), node.handler, slots, calls);
            return true;
        }
        if b.kind == "index" and b.index.kind == "string" {
            _emit_map_get_access(code, b.obj, _str_node(b.index.value), node.handler, slots, calls);
            return true;
        }
        if b.kind == "index" and _is_str(b.index, slots) {                    // try m[runtimeKey] catch d
            _emit_map_get_access(code, b.obj, b.index, node.handler, slots, calls);
            return true;
        }
        _ge_rax(b, code, slots, calls);   // non-trapping body → the handler is unreachable
        return true;
    }
    if k == "if_expr" {
        // `if c { A } else { B }` as a VALUE: A/B are block-exprs whose value is their last expression.
        let jz = _emit_cond_skip(node.cond, code, slots, calls);        // jz → else
        _ge_block_value(node.then, code, slots, calls);                 // then value → rax
        push(code, 233); let jd = len(code); _elf.le(code, 0, 4);       // jmp done (rel32)
        _patch32(code, jz, len(code) - (jz + 4));                       // else lands here
        let els = try node.else catch nil;
        if els != nil { _ge_block_value(els, code, slots, calls); } else { push(code, 49); push(code, 192); }
        _patch32(code, jd, len(code) - (jd + 4));                       // done
        return true;
    }
    if k == "string" {
        // interned literal: load the pointer materialized once at startup (no per-eval allocation → no leak)
        let lits = try slots.strlits catch nil;
        if lits != nil and map_has(lits, node.value) {
            let slotaddr = _GBASE() + ((try slots.litbase catch 0) + lits[node.value]) * 8;
            push(code, 72); push(code, 184); _elf.le(code, slotaddr, 8);         // movabs rax, &slot
            push(code, 72); push(code, 139); push(code, 0);                      // mov rax, [rax]
            return true;
        }
        // fallback: materialize a heap string [len, bytes…] fresh (only if not interned, e.g. dynamic paths)
        let bytes = str_to_bytes(node.value); let sl = len(bytes);
        let alloc = 16 + sl; let rr = alloc % 8; if rr != 0 { alloc = alloc + (8 - rr); }   // TAG,len,bytes@16
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, alloc, 4);  // add r15, alloc
        push(code, 80);                                                      // push rax (base)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 1, 4); // mov qword [rcx], TAG_STR
        push(code, 72); push(code, 199); push(code, 65); push(code, 8); _elf.le(code, sl, 4); // mov qword [rcx+8], len
        let j = 0;
        while j < sl {
            push(code, 198); push(code, 129); _elf.le(code, 16 + j, 4); push(code, bytes[j]); // mov byte [rcx+16+j], b
            j = j + 1;
        }
        push(code, 88);                                                      // pop rax (string ptr)
        return true;
    }
    if k == "ident" {
        // captured variable → read it from the closure object via the saved closure pointer
        let cm = try slots.capmap catch nil;
        if cm != nil and map_has(cm, node.name) {
            push(code, 72); push(code, 139); push(code, 133); let ca = len(code); _elf.le(code, 0, 4); _patch32(code, ca, _slot_disp(slots.cslot)); // mov rax, [rbp+cslot]
            push(code, 72); push(code, 139); push(code, 128); _elf.le(code, 16 + 8 * cm[node.name], 4);  // mov rax, [rax + 16 + 8*idx]
            return true;
        }
        let ri = _reg_of(slots, node.name);
        if ri >= 0 { _reg_ld(code, ri); return true; }      // register-allocated local
        let g = try slots.globals catch nil;                // top-level global (unless a local shadows it)
        if g != nil and map_has(g, node.name) and not map_has(slots.names, node.name) { _emit_global_load(code, g[node.name]); return true; }
        let i = _slot_of(slots, node.name);
        push(code, 72); push(code, 139); push(code, 133);
        let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
        return true;                                        // mov rax, [rbp+disp]
    }
    if k == "unary" and node.op == "-" {
        _ge_rax(node.operand, code, slots, calls);
        push(code, 72); push(code, 247); push(code, 216); _ovf(code); return true;   // neg rax
    }
    if k == "unary" and (node.op == "not" or node.op == "!") {
        _ge_rax(node.operand, code, slots, calls);
        push(code, 72); push(code, 133); push(code, 192);                // test rax, rax
        push(code, 15); push(code, 148); push(code, 192);                // sete al
        push(code, 15); push(code, 182); push(code, 192); return true;   // movzx eax, al  (0/1)
    }
    if k == "call" {
        // len(arr) → load the length word stored at the array base ([rax])
        if node.func.kind == "ident" and node.func.name == "len" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);       // rax = heap object pointer
            push(code, 72); push(code, 139); push(code, 64); push(code, 8);  // mov rax, [rax+8]  (length/count)
            return true;
        }
        // is_string(x) / is_array(x) / is_map(x) → 1/0 via the leading type tag (TAG_STR=1, TAG_ARR=2, TAG_MAP=3).
        if node.func.kind == "ident" and node.func.name == "is_string" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls); _emit_is_type(code, 1); return true;
        }
        if node.func.kind == "ident" and node.func.name == "is_array" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls); _emit_is_type(code, 2); return true;
        }
        if node.func.kind == "ident" and node.func.name == "is_map" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls); _emit_is_type(code, 3); return true;
        }
        // ── ARENA (region) memory management ─────────────────────────────────────────────────────────────
        // arena_mark() → the current bump pointer (r15). arena_reset(m) → rewind r15 to a saved mark,
        // reclaiming every object allocated since arena_mark() in O(1). CONTRACT: nothing allocated after the
        // mark may still be referenced past the reset (classic region discipline). Misuse stays arena-confined
        // — the pages are never unmapped, so a stale ref reads stale-but-mapped memory, never a wild pointer.
        if node.func.kind == "ident" and node.func.name == "arena_mark" and len(node.args) == 0 {
            push(code, 76); push(code, 137); push(code, 248);            // mov rax, r15  (current bump ptr)
            return true;
        }
        if node.func.kind == "ident" and node.func.name == "arena_reset" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);                   // rax = saved mark
            push(code, 73); push(code, 137); push(code, 199);            // mov r15, rax  (rewind bump ptr)
            return true;                                                 // returns the mark (rax unchanged)
        }
        // ── BITWISE ─────────────────────────────────────────────────────────────────────────────────────
        // The parser desugars a&b / a|b / a^b / a<<b / a>>b to bit_and/or/xor/shl/shr(a,b) calls; ~a → bit_not.
        // The direct backend implements them on FULL 64-bit integer registers (exact — no f64 >2^53 precision
        // loss the interpreter suffers), unblocking native hashing / crypto / bit-manipulation code.
        if node.func.kind == "ident" and node.func.name == "bit_not" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);
            push(code, 72); push(code, 247); push(code, 208);            // not rax
            return true;
        }
        if node.func.kind == "ident" and (node.func.name == "bit_and" or node.func.name == "bit_or" or node.func.name == "bit_xor") and len(node.args) == 2 {
            // CONSTANT MASK fast path: `x & 65535`, `x | flag`, `x ^ k` → one immediate-form instruction, no
            // stack spill. This is exactly the `& 0xFFFF` in rolling-hash loops — the old path push/popped.
            if node.args[1].kind == "number" {
                let bv = parse_number(node.args[1].value);
                if bv >= 0 - 2147483648 and bv <= 2147483647 {
                    _ge_rax(node.args[0], code, slots, calls);
                    if node.func.name == "bit_and" { push(code, 72); push(code, 37); _elf.le(code, bv, 4); }       // and rax, imm32
                    elif node.func.name == "bit_or" { push(code, 72); push(code, 13); _elf.le(code, bv, 4); }      // or  rax, imm32
                    else { push(code, 72); push(code, 53); _elf.le(code, bv, 4); }                                 // xor rax, imm32
                    return true;
                }
            }
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);   // a → push
            _ge_rax(node.args[1], code, slots, calls);                   // b → rax
            push(code, 72); push(code, 137); push(code, 195);           // mov rbx, rax  (b)
            push(code, 88);                                             // pop rax  (a)
            if node.func.name == "bit_and" { push(code, 72); push(code, 33); push(code, 216); }   // and rax, rbx
            elif node.func.name == "bit_or" { push(code, 72); push(code, 9); push(code, 216); }    // or  rax, rbx
            else { push(code, 72); push(code, 49); push(code, 216); }                              // xor rax, rbx
            return true;
        }
        if node.func.kind == "ident" and (node.func.name == "bit_shl" or node.func.name == "bit_shr") and len(node.args) == 2 {
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);   // a → push
            _ge_rax(node.args[1], code, slots, calls);                   // b (shift count) → rax
            push(code, 72); push(code, 137); push(code, 193);           // mov rcx, rax  (count → cl)
            push(code, 88);                                             // pop rax  (a)
            if node.func.name == "bit_shl" { push(code, 72); push(code, 211); push(code, 224); }   // shl rax, cl
            else { push(code, 72); push(code, 211); push(code, 232); }                             // shr rax, cl
            return true;
        }
        // str_to_bytes(s) → a fresh ARRAY of the string's byte values (0..255 each). Unblocks native crypto /
        // encoding / binary code (e.g. SHA-256) that walks a message as bytes.
        if node.func.kind == "ident" and node.func.name == "str_to_bytes" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);                   // rax = string ptr
            push(code, 72); push(code, 137); push(code, 195);           // mov rbx, rax   (string ptr)
            push(code, 72); push(code, 139); push(code, 75); push(code, 8);  // mov rcx, [rbx+8]  (len)
            push(code, 76); push(code, 137); push(code, 248);           // mov rax, r15   (array header base)
            push(code, 72); push(code, 137); push(code, 202);           // mov rdx, rcx
            push(code, 72); push(code, 193); push(code, 226); push(code, 3);  // shl rdx, 3     (len*8)
            push(code, 72); push(code, 131); push(code, 194); push(code, 32);// add rdx, 32    (+ 32-byte header)
            push(code, 73); push(code, 1); push(code, 215);             // add r15, rdx   (bump)
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4);  // mov qword [rax], TAG_ARR
            push(code, 72); push(code, 137); push(code, 72); push(code, 8);  // mov [rax+8], rcx   (len)
            push(code, 72); push(code, 137); push(code, 72); push(code, 16); // mov [rax+16], rcx  (cap)
            push(code, 72); push(code, 141); push(code, 80); push(code, 32); // lea rdx, [rax+32]  (dataptr)
            push(code, 72); push(code, 137); push(code, 80); push(code, 24); // mov [rax+24], rdx
            push(code, 72); push(code, 137); push(code, 214);           // mov rsi, rdx   (dst = dataptr)
            push(code, 72); push(code, 141); push(code, 123); push(code, 16);// lea rdi, [rbx+16]  (src = string bytes)
            push(code, 80);                                             // push rax  (save header)
            push(code, 72); push(code, 133); push(code, 201);           // test rcx, rcx
            push(code, 116); push(code, 18);                            // jz +18  (empty → skip copy)
            push(code, 15); push(code, 182); push(code, 23);            // .loop: movzx edx, byte [rdi]
            push(code, 72); push(code, 137); push(code, 22);            // mov [rsi], rdx
            push(code, 72); push(code, 255); push(code, 199);           // inc rdi
            push(code, 72); push(code, 131); push(code, 198); push(code, 8);  // add rsi, 8
            push(code, 72); push(code, 255); push(code, 201);           // dec rcx
            push(code, 117); push(code, 238);                          // jnz .loop (-18)
            push(code, 88);                                             // pop rax  (array header → result)
            return true;
        }
        // map_keys(m) → a fresh [TAG_ARR,len,cap,dataptr] array of the map's key-string pointers (insertion order).
        if node.func.kind == "ident" and node.func.name == "map_keys" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);                      // rax = map ptr
            push(code, 72); push(code, 139); push(code, 72); push(code, 8);// mov rcx, [rax+8]  (count)
            push(code, 72); push(code, 137); push(code, 195);              // mov rbx, rax    (save map)
            push(code, 76); push(code, 137); push(code, 248);              // mov rax, r15    (array header)
            push(code, 72); push(code, 137); push(code, 202);              // mov rdx, rcx
            push(code, 72); push(code, 193); push(code, 226); push(code, 3); // shl rdx, 3   (count*8)
            push(code, 73); push(code, 131); push(code, 199); push(code, 32); // add r15, 32
            push(code, 73); push(code, 1); push(code, 215);                // add r15, rdx
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4); // mov qword [rax], TAG_ARR
            push(code, 72); push(code, 137); push(code, 72); push(code, 8);// mov [rax+8], rcx  (len)
            push(code, 72); push(code, 137); push(code, 72); push(code, 16);// mov [rax+16], rcx (cap)
            push(code, 72); push(code, 141); push(code, 80); push(code, 32);// lea rdx, [rax+32] (dataptr)
            push(code, 72); push(code, 137); push(code, 80); push(code, 24);// mov [rax+24], rdx
            push(code, 80);                                                // push rax   (result)
            push(code, 72); push(code, 141); push(code, 115); push(code, 24);// lea rsi, [rbx+24] (first pair)
            push(code, 72); push(code, 137); push(code, 215);              // mov rdi, rdx     (dest)
            push(code, 72); push(code, 133); push(code, 201);              // .loop: test rcx, rcx
            push(code, 116); push(code, 19);                               // jz done (+19)
            push(code, 76); push(code, 139); push(code, 6);                // mov r8, [rsi]   (keyptr)
            push(code, 76); push(code, 137); push(code, 7);                // mov [rdi], r8
            push(code, 72); push(code, 131); push(code, 198); push(code, 16);// add rsi, 16
            push(code, 72); push(code, 131); push(code, 199); push(code, 8); // add rdi, 8
            push(code, 72); push(code, 255); push(code, 201);              // dec rcx
            push(code, 235); push(code, 232);                              // jmp .loop (-24)
            push(code, 88);                                                // done: pop rax (result)
            return true;
        }
        // map_has(m, key) → 1 if key present, else 0.
        if node.func.kind == "ident" and node.func.name == "map_has" and len(node.args) == 2 {
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);   // map → push
            _ge_rax(node.args[1], code, slots, calls);                   // key → rax
            push(code, 72); push(code, 137); push(code, 195);            // mov rbx, rax
            push(code, 88);                                              // pop rax (map)
            _emit_map_has(code, calls);
            return true;
        }
        // str(x) → heap string. If x is already string-typed, it's the identity; otherwise itoa the
        // number in rax into a fresh [len, digits…] object.
        if node.func.kind == "ident" and node.func.name == "str" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);        // rax = value
            if not _is_str(node.args[0], slots) { _emit_str_from_num(code); }
            return true;
        }
        // strcharcodeat(s, i) → the byte value at index i of heap string s (bytes start at [s+8]).
        if node.func.kind == "ident" and node.func.name == "strcharcodeat" and len(node.args) == 2 {
            _ge_rax(node.args[0], code, slots, calls);        // rax = string ptr
            push(code, 80);                                   // push rax
            _ge_rax(node.args[1], code, slots, calls);        // rax = index
            push(code, 72); push(code, 137); push(code, 193); // mov rcx, rax   (index)
            push(code, 88);                                   // pop rax  (string ptr)
            push(code, 15); push(code, 182); push(code, 68); push(code, 8); push(code, 16); // movzx eax, byte [rax+rcx+16]
            return true;
        }
        // strfromcharcode(c) → a fresh 1-char heap string [TAG_STR, len=1, byte] (24 bytes aligned).
        if node.func.kind == "ident" and node.func.name == "strfromcharcode" and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);        // rax = code
            push(code, 72); push(code, 137); push(code, 194); // mov rdx, rax
            push(code, 76); push(code, 137); push(code, 248); // mov rax, r15
            push(code, 73); push(code, 131); push(code, 199); push(code, 24); // add r15, 24
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4); // mov qword [rax], TAG_STR
            push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 1, 4); // mov qword [rax+8], 1 (len)
            push(code, 136); push(code, 80); push(code, 16);  // mov [rax+16], dl
            return true;
        }
        // push(arr, x) → append x to a dynamic array in place; returns the array. When the buffer is
        // full it reallocates a doubled buffer (r15 bump), copies the elements (rep movsq), and updates
        // the handle's dataptr/cap — the header never moves, so all references stay valid.
        if node.func.kind == "ident" and (node.func.name == "push" or node.func.name == "array_push") and len(node.args) == 2 {
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);   // push header ptr
            _ge_rax(node.args[1], code, slots, calls);                   // rax = value
            push(code, 72); push(code, 137); push(code, 194);           // mov rdx, rax  (value)
            push(code, 88);                                             // pop rax  (header ptr)
            push(code, 72); push(code, 139); push(code, 72); push(code, 8); // mov rcx, [rax+8]    (len)
            push(code, 72); push(code, 59); push(code, 72); push(code, 16); // cmp rcx, [rax+16]  (cap)
            push(code, 15); push(code, 130); let jroom = len(code); _elf.le(code, 0, 4);   // jb .append (room)
            // --- GROW ---
            push(code, 76); push(code, 139); push(code, 64); push(code, 16); // mov r8, [rax+16]   (old cap)
            push(code, 72); push(code, 139); push(code, 88); push(code, 24); // mov rbx, [rax+24]  (old data)
            // IN-PLACE fast path: if this buffer sits at the arena top (data+cap*8 == r15), just extend it —
            // no new allocation, no copy, no dead buffer. In a build loop nothing else allocates, so EVERY grow
            // takes this path: the whole build allocates exactly its final size and copies zero elements.
            push(code, 74); push(code, 141); push(code, 12); push(code, 195); // lea rcx, [rbx + r8*8]  (buffer end)
            push(code, 76); push(code, 57); push(code, 249);                  // cmp rcx, r15
            push(code, 15); push(code, 133); let jcopy = len(code); _elf.le(code, 0, 4);   // jne .copygrow
            push(code, 76); push(code, 137); push(code, 193);                 // mov rcx, r8
            push(code, 72); push(code, 193); push(code, 225); push(code, 3);  // shl rcx, 3   (oldcap*8 bytes)
            push(code, 73); push(code, 1); push(code, 207);                   // add r15, rcx  (extend in place)
            push(code, 75); push(code, 141); push(code, 60); push(code, 0);   // lea rdi, [r8+r8]  (newcap = 2*cap)
            push(code, 72); push(code, 137); push(code, 120); push(code, 16); // mov [rax+16], rdi  (cap; dataptr unchanged)
            push(code, 233); let jinpl = len(code); _elf.le(code, 0, 4);      // jmp .append
            // .copygrow: allocate a doubled buffer, copy, repoint the handle (buffer was not at the arena top)
            _patch32(code, jcopy, len(code) - (jcopy + 4));
            push(code, 76); push(code, 137); push(code, 254);          // mov rsi, r15   (new data)
            push(code, 76); push(code, 137); push(code, 199);          // mov rdi, r8
            push(code, 72); push(code, 193); push(code, 231); push(code, 4);  // shl rdi, 4   (cap*16 bytes = 2*cap qwords)
            push(code, 73); push(code, 1); push(code, 255);            // add r15, rdi   (bump heap)
            push(code, 72); push(code, 137); push(code, 112); push(code, 24); // mov [rax+24], rsi  (dataptr = new)
            push(code, 75); push(code, 141); push(code, 60); push(code, 0);   // lea rdi, [r8+r8]   (newcap = 2*cap)
            push(code, 72); push(code, 137); push(code, 120); push(code, 16); // mov [rax+16], rdi  (cap = newcap)
            push(code, 80); push(code, 82);                            // push rax ; push rdx  (save across movsq)
            push(code, 76); push(code, 137); push(code, 193);          // mov rcx, r8    (count = old cap)
            push(code, 72); push(code, 137); push(code, 247);          // mov rdi, rsi   (dst = new)
            push(code, 72); push(code, 137); push(code, 222);          // mov rsi, rbx   (src = old)
            push(code, 252);                                           // cld
            push(code, 243); push(code, 72); push(code, 165);          // rep movsq
            push(code, 90); push(code, 88);                            // pop rdx ; pop rax
            // --- APPEND (rax = header, rdx = value) ---  (jroom and jinpl both land here)
            _patch32(code, jroom, len(code) - (jroom + 4));
            _patch32(code, jinpl, len(code) - (jinpl + 4));
            push(code, 72); push(code, 139); push(code, 72); push(code, 8); // mov rcx, [rax+8]   (len, reload)
            push(code, 72); push(code, 139); push(code, 112); push(code, 24); // mov rsi, [rax+24]  (dataptr)
            push(code, 72); push(code, 137); push(code, 20); push(code, 206); // mov [rsi+rcx*8], rdx
            push(code, 72); push(code, 255); push(code, 64); push(code, 8); // inc qword [rax+8]  (len++)
            return true;                                              // rax = header (push returns the array)
        }
        // pop(arr) / array_pop(arr) → remove and RETURN the last element (in place). Traps (134) on empty,
        // matching the bounds-check discipline. The buffer isn't shrunk — only the length decrements.
        if node.func.kind == "ident" and (node.func.name == "pop" or node.func.name == "array_pop") and len(node.args) == 1 {
            _ge_rax(node.args[0], code, slots, calls);                   // rax = array header
            push(code, 72); push(code, 139); push(code, 72); push(code, 8);  // mov rcx, [rax+8]  (len)
            push(code, 72); push(code, 133); push(code, 201);            // test rcx, rcx
            push(code, 117); push(code, 12);                             // jnz +12  (non-empty → skip trap)
            push(code, 191); _elf.le(code, 134, 4);                      // mov edi, 134
            push(code, 184); _elf.le(code, 60, 4);                       // mov eax, 60
            push(code, 15); push(code, 5);                              // syscall (trap on pop of empty)
            push(code, 72); push(code, 255); push(code, 201);           // dec rcx           (new len)
            push(code, 72); push(code, 137); push(code, 72); push(code, 8);  // mov [rax+8], rcx  (store len-1)
            push(code, 72); push(code, 139); push(code, 80); push(code, 24); // mov rdx, [rax+24] (dataptr)
            push(code, 72); push(code, 139); push(code, 4); push(code, 202); // mov rax, [rdx+rcx*8] (last elem)
            return true;
        }
        // str_slice(s, start, end) → a fresh heap string with bytes [start, end) copied from s.
        if node.func.kind == "ident" and (node.func.name == "str_slice" or node.func.name == "slice") and len(node.args) == 3 {
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);   // push s
            _ge_rax(node.args[1], code, slots, calls); push(code, 80);   // push start
            _ge_rax(node.args[2], code, slots, calls);                   // rax = end
            push(code, 90);                                             // pop rdx  (start)
            push(code, 91);                                             // pop rbx  (string ptr)
            push(code, 72); push(code, 137); push(code, 193);          // mov rcx, rax   (end)
            push(code, 72); push(code, 41); push(code, 209);           // sub rcx, rdx   (rcx = end-start = len)
            push(code, 76); push(code, 137); push(code, 248);          // mov rax, r15   (result base)
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4); // mov qword [rax], TAG_STR
            push(code, 73); push(code, 131); push(code, 199); push(code, 16);  // add r15, 16
            push(code, 73); push(code, 1); push(code, 207);            // add r15, rcx
            push(code, 73); push(code, 131); push(code, 199); push(code, 7);   // add r15, 7
            push(code, 73); push(code, 131); push(code, 231); push(code, 248); // and r15, -8
            push(code, 72); push(code, 137); push(code, 72); push(code, 8);    // mov [rax+8], rcx (store len)
            push(code, 72); push(code, 141); push(code, 116); push(code, 19); push(code, 16); // lea rsi, [rbx+rdx+16]
            push(code, 72); push(code, 141); push(code, 120); push(code, 16);  // lea rdi, [rax+16]
            push(code, 252);                                           // cld
            push(code, 243); push(code, 164);                          // rep movsb  (rax preserved)
            return true;
        }
        // INLINING: if the callee is a single-return leaf function and every argument is simple
        // (an ident or literal — safe to duplicate), substitute its body inline and skip the call
        // entirely. Removes the whole prologue/args/call/ret per invocation.
        let inl = try slots.inlines catch nil;
        if inl != nil {
            let entry = try inl[node.func.name] catch nil;
            if entry != nil and len(node.args) == len(entry.params) {
                let simple = true; let ci = 0;
                while ci < len(node.args) { let ak = node.args[ci].kind; if ak != "ident" and ak != "number" { simple = false; } ci = ci + 1; }
                if simple {
                    let m = map{}; let pi = 0;
                    while pi < len(entry.params) { m[_param_name(entry.params[pi])] = node.args[pi]; pi = pi + 1; }
                    _ge_rax(_subst(entry.expr, m), code, slots, calls);
                    return true;
                }
            }
        }
        // INDIRECT CALL: the callee is a function VALUE (a local variable holding a closure/fn ptr, or
        // any non-name expression) rather than a named top-level function → load it and `call rax`.
        let _gc = try slots.globals catch nil;              // a global holding a closure/fn value → indirect
        if (node.func.kind != "ident") or map_has(slots.names, node.func.name) or _reg_of(slots, node.func.name) >= 0
           or (_gc != nil and map_has(_gc, node.func.name)) {
            _ge_rax(node.func, code, slots, calls);         // rax = closure pointer
            push(code, 80);                                 // push closure ptr
            let ia = 0;
            while ia < len(node.args) { if not _try_push_imm(code, _fold(node.args[ia])) { _ge_rax(node.args[ia], code, slots, calls); push(code, 80); } ia = ia + 1; }
            let ij = len(node.args) - 1;
            while ij >= 0 { _pop_argreg(code, ij); ij = ij - 1; }
            push(code, 88);                                 // pop rax (closure ptr)
            push(code, 73); push(code, 137); push(code, 195);   // mov r11, rax   (closure ptr for the body)
            push(code, 73); push(code, 139); push(code, 67); push(code, 8); // mov rax, [r11+8] (code ptr)
            push(code, 255); push(code, 208);               // call rax
            return true;
        }
        let a = node.args;
        if len(a) == 1 {
            // single arg → straight to rdi. `regvar ± const` leas directly into rdi (skips mov rax + mov rdi).
            let fa0 = _fold(a[0]);
            let cv0 = 0; let is_c0 = false;
            if fa0.kind == "number" { cv0 = parse_number(fa0.value); if cv0 >= 0 and cv0 < 4294967296 { is_c0 = true; } }
            if is_c0 and cv0 == 0 { push(code, 49); push(code, 255); }                       // xor edi, edi  (arg = 0)
            elif is_c0 { push(code, 191); _elf.le(code, cv0, 4); }                           // mov edi, imm32 (zero-extends; skips mov rax + mov rdi)
            elif not _try_lea_arg(code, a[0], 7, slots) {
                _ge_rax(a[0], code, slots, calls);
                push(code, 72); push(code, 137); push(code, 199);  // mov rdi, rax
            }
        } else {
            // multiple args: eval all onto the stack (a later arg may clobber an earlier arg reg),
            // then pop into the argument registers in reverse.
            let ai = 0;
            while ai < len(a) { if not _try_push_imm(code, _fold(a[ai])) { _ge_rax(a[ai], code, slots, calls); push(code, 80); } ai = ai + 1; }
            if len(a) > 6 {                                 // args 6+ go on the stack (SysV)
                let freeb = _stage_args_stack(code, len(a));
                push(code, 232); let at6 = len(code); _elf.le(code, 0, 4);
                push(calls, map{ at: at6, name: node.func.name });
                _free_args_stack(code, freeb);
                return true;
            }
            let j = len(a) - 1;
            while j >= 0 { _pop_argreg(code, j); j = j - 1; }
        }
        push(code, 232); let at = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: at, name: node.func.name });
        return true;                                        // result already in rax
    }
    if k == "binary" {
        let op = node.op;
        if op == "and" or op == "or" {
            // SHORT-CIRCUIT: `a and b` = a if a is falsy else b; `a or b` = a if a is truthy else b.
            _ge_rax(node.left, code, slots, calls);                          // rax = left
            push(code, 72); push(code, 133); push(code, 192);               // test rax, rax
            push(code, 15);                                                 // (near cond jump)
            if op == "and" { push(code, 132); } else { push(code, 133); }   // jz (and) / jnz (or) → done
            let jd = len(code); _elf.le(code, 0, 4);
            _ge_rax(node.right, code, slots, calls);                        // rax = right
            _patch32(code, jd, len(code) - (jd + 4));
            return true;
        }
        if op == "+" and _is_str(node.left, slots) and _is_str(node.right, slots) {
            // Both operands are string-TYPED. Two string literals are DEFINITELY strings → static concat.
            if node.left.kind == "string" and node.right.kind == "string" {
                _emit_str_concat(node.left, node.right, code, slots, calls);
                return true;
            }
            // Otherwise an operand may be a runtime NUMBER (a dynamically-typed source, e.g. an evaluator
            // function that returns a string on one path and a number on another). Dispatch on the left
            // operand's runtime tag: heap string → concatenate; else → integer add. This makes `+` correct
            // for dynamically-typed values WITHOUT touching purely-numeric code (fib's `+` isn't string-typed,
            // so it never reaches here). The check is a few instructions only on string-typed `+`.
            _ge_rax(node.left, code, slots, calls); push(code, 80);          // push left
            _ge_rax(node.right, code, slots, calls);                        // rax = right
            push(code, 72); push(code, 137); push(code, 195);              // mov rbx, rax  (right)
            push(code, 88);                                                // pop rax  (left)
            push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);    // movabs rcx, GBASE
            push(code, 72); push(code, 137); push(code, 194);              // mov rdx, rax
            push(code, 72); push(code, 41); push(code, 202);               // sub rdx, rcx   (left - GBASE)
            push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ(), 8);   // movabs rcx, arena size
            push(code, 72); push(code, 57); push(code, 202);               // cmp rdx, rcx
            push(code, 15); push(code, 131); let ja = len(code); _elf.le(code, 0, 4);  // jae .add
            push(code, 72); push(code, 139); push(code, 8);                // mov rcx, [rax]  (tag)
            push(code, 72); push(code, 131); push(code, 249); push(code, 1);// cmp rcx, TAG_STR
            push(code, 15); push(code, 133); let jn = len(code); _elf.le(code, 0, 4);  // jne .add
            _emit_concat_rr(code);                                         // concat left(rax)+right(rbx) → rax
            push(code, 233); let jd = len(code); _elf.le(code, 0, 4);       // jmp .done
            _patch32(code, ja, len(code) - (ja + 4));                       // .add:
            _patch32(code, jn, len(code) - (jn + 4));
            push(code, 72); push(code, 1); push(code, 216);                // add rax, rbx
            _patch32(code, jd, len(code) - (jd + 4));                       // .done:
            return true;
        }
        if (op == "==" or op == "!=") and _is_str(node.left, slots) and _is_str(node.right, slots) {
            _ge_rax(node.left, code, slots, calls); push(code, 80);           // push s1
            _ge_rax(node.right, code, slots, calls);                         // rax = s2
            push(code, 72); push(code, 137); push(code, 195);               // mov rbx, rax  (s2)
            push(code, 88);                                                 // pop rax  (s1)
            // A string LITERAL operand is definitely a string → static byte compare. Otherwise a value could
            // be a runtime number (dynamically-typed source) → dispatch on both operands' tags.
            if node.left.kind == "string" or node.right.kind == "string" {
                _emit_str_eq(code, op == "!=");                              // static string compare
            } else {
                _emit_eq_dynamic(code, op == "!=");                         // runtime: both-strings→bytes, else raw
            }
            return true;
        }
        if op == "/" or op == "%" {
            // STRENGTH REDUCTION: unsigned divide/modulo by a constant power of two → shr / and. `div` is
            // ~20-40 cycles; `shr` and `and` are 1. Exactly matches this backend's UNSIGNED div semantics
            // (x/2^k = x>>k, x%2^k = x&(2^k-1) for non-negative x), so results are identical — just faster.
            if node.right.kind == "number" {
                let dv = parse_number(node.right.value);
                let sh = _log2_pow2(dv);
                if sh >= 1 and sh <= 31 {
                    _ge_rax(node.left, code, slots, calls);                          // rax = dividend
                    if op == "/" { push(code, 72); push(code, 193); push(code, 232); push(code, sh); return true; }  // shr rax, k
                    push(code, 72); push(code, 37); _elf.le(code, dv - 1, 4); return true;                           // and rax, 2^k-1
                }
                if dv == 1 {
                    _ge_rax(node.left, code, slots, calls);
                    if op == "%" { push(code, 49); push(code, 192); }
                    return true;
                }
                let lr = _range_expr(node.left, slots);
                if dv == num_floor(dv) and dv >= 3 and dv <= 2147483647 and lr != nil and lr.lo >= 0 and lr.hi <= 4294967295 {
                    // A proven narrow dividend needs no reciprocal at all. This is especially useful for
                    // normalized accumulators (`x = expr % d`) whose next value is known to stay near d.
                    if lr.hi < dv {
                        _ge_rax(node.left, code, slots, calls);
                        if op == "/" { push(code, 49); push(code, 192); }
                        return true;
                    }
                    if lr.hi < dv * 2 {
                        _ge_rax(node.left, code, slots, calls);
                        _emit_cmp_rax_imm(code, dv);
                        if op == "%" {
                            let skip = 4; if dv > 127 { skip = 6; }
                            push(code, 114); push(code, skip);                // jb done
