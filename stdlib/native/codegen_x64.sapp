    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(i));
}

// ── REGISTER ALLOCATION for locals ────────────────────────────────────────────
// The first few `let`/`const` locals in a function are pinned to callee-saved registers r12/r13/r14
// (r15 is the heap pointer, rbx is the codegen's scratch), saved/restored ONCE per function in a
// reserved frame area. A loop then keeps its counters/accumulators in registers — no per-iteration
// memory traffic — while the one-time save/restore is amortized across all iterations.
fn _reg_ld(code, idx) {   // rax = r(12+idx)
    if idx == 0 { push(code, 76); push(code, 137); push(code, 224); }        // mov rax, r12
    else { if idx == 1 { push(code, 76); push(code, 137); push(code, 232); } // mov rax, r13
    else { push(code, 76); push(code, 137); push(code, 240); } }             // mov rax, r14
}
fn _reg_st(code, idx) {   // r(12+idx) = rax
    if idx == 0 { push(code, 73); push(code, 137); push(code, 196); }        // mov r12, rax
    else { if idx == 1 { push(code, 73); push(code, 137); push(code, 197); } // mov r13, rax
    else { push(code, 73); push(code, 137); push(code, 198); } }             // mov r14, rax
}
// dst = r(12+idx) + disp, in ONE instruction (`lea dst, [reg+disp]`). Collapses the common `mov rax,reg;
// add/sub rax,const` (regvar ± literal — array indices, loop math, `f(n-1)` call args) into a single lea.
// `dstf` is the destination's ModRM reg field (rax=0, rdi=7). Base r12/r13/r14 → REX.WB=0x49; r12 (rm=4)
// needs a SIB byte (0x24). ModRM = mod*64 + dstf*8 + rm; mod=1 (disp8) or 2 (disp32).
fn _emit_lea_reg_dst(code, dstf, idx, disp) {
    let d8 = disp >= -128 and disp <= 127;
    let mod = 2; if d8 { mod = 1; }
    let rm = 4; if idx == 1 { rm = 5; } if idx == 2 { rm = 6; }   // r12→4(SIB), r13→5, r14→6
    push(code, 73); push(code, 141);                             // REX.WB, 8D (lea)
    push(code, mod * 64 + dstf * 8 + rm);                        // ModRM
    if idx == 0 { push(code, 36); }                              // SIB 0x24 for [r12+disp]
    if d8 { _elf.le(code, disp, 1); } else { _elf.le(code, disp, 4); }
}
fn _emit_lea_reg(code, idx, disp) { _emit_lea_reg_dst(code, 0, idx, disp); }   // → rax
// If `arg` is `regvar ± const`, load it straight into a target arg register via lea and return true.
// dstf = that register's ModRM reg field (rdi=7). Saves the intermediate `mov argreg, rax`.
fn _try_lea_arg(code, arg, dstf, slots) {
    let n = _fold(arg);
    if n.kind == "ident" { let ri = _reg_of(slots, n.name); if ri >= 0 { _emit_lea_reg_dst(code, dstf, ri, 0); return true; } return false; }
    if n.kind == "binary" and (n.op == "+" or n.op == "-") and n.left.kind == "ident" and n.right.kind == "number" {
