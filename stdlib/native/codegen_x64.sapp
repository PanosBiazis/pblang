    _patch32(code, jr1, len(code) - (jr1 + 4));
    _patch32(code, jr2, len(code) - (jr2 + 4));
    _patch32(code, jr3, len(code) - (jr3 + 4));
    _patch32(code, jr4, len(code) - (jr4 + 4));
    push(code, 195);                                                         // .ret: ret
