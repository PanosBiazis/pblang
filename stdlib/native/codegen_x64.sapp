    throw "codegen: cannot compile stmt kind " + k;
}

// Emit one function body (named function or function literal) and return its code offset. ctx carries
// the shared { calls, inlines, strings, keyids, funlits }. Params ≤3 go in r12/r13/r14, rest in slots.
// Build the per-function slot/state map (fresh names, n=0) with interprocedural string-type seeding.
fn _build_fslots(params, body, ctx, strinfo, caps) {
    let fregvars = map{};
    let rpi = 0;
    while rpi < len(params) and len(fregvars) < 3 and rpi < 4 { fregvars[_param_name(params[rpi])] = len(fregvars); rpi = rpi + 1; }
    _reg_scan(body, fregvars);
    let fslots = map{ names: map{}, n: 0, inlines: ctx.inlines, strings: ctx.strings, regvars: fregvars, uses_tmp: _stmts_use_tmp(body), tmpd: 0, keyids: ctx.keyids, funlits: ctx.funlits, strvars: map{}, ranges: map{}, fnstr: try ctx.fnstr catch map{}, loops: [], globals: try ctx.globals catch map{}, strfields: try ctx.strfields catch map{}, fnnames: try ctx.fnnames catch map{}, strlits: try ctx.strlits catch map{}, litbase: try ctx.litbase catch 0 };
    if strinfo != nil {
        let sp = try strinfo.spars catch nil;
        if sp != nil { let pk = 0; while pk < len(params) { let pn = _param_name(params[pk]); if map_has(sp, pn) { fslots.strvars[pn] = true; } pk = pk + 1; } }
        let sc = try strinfo.scaps catch nil;
        if sc != nil { let sk = 0; while sk < len(caps) { if map_has(sc, caps[sk]) { fslots.strvars[caps[sk]] = true; } sk = sk + 1; } }
    }
    return fslots;
}
// Emit closure-capture spill + parameter spills + self-tail-call target + the body. Shared by the scratch
// slot-counting pass and the real emission, so both allocate slots identically (faithful frame-free decision).
fn _emit_fn_inner(code, fslots, params, body, caps, ctx, fnname) {
    if len(caps) > 0 {
        let cslot = _slot_of(fslots, "__closure");
        push(code, 76); push(code, 137); push(code, 157); let ca = len(code); _elf.le(code, 0, 4); _patch32(code, ca, _slot_disp(cslot)); // mov [rbp+disp], r11
        let cm = map{}; let cci = 0; while cci < len(caps) { cm[caps[cci]] = cci; cci = cci + 1; }
        fslots.capmap = cm; fslots.cslot = cslot;
    }
    let pi = 0;
    while pi < len(params) {
        let pn = _param_name(params[pi]);
        let reg = _reg_of(fslots, pn);
        if reg >= 0 and pi < 4 { _reg_from_argreg(code, reg, pi); }
        elif pi >= 6 {                                       // incoming stack arg pi at [rbp+16+8*(pi-6)] → slot
            let slot6 = _slot_of(fslots, pn);
            push(code, 72); push(code, 139); push(code, 133); _elf.le(code, 16 + 8 * (pi - 6), 4);                        // mov rax, [rbp+d]
            push(code, 72); push(code, 137); push(code, 133); let sa6 = len(code); _elf.le(code, 0, 4); _patch32(code, sa6, _slot_disp(slot6));  // mov [rbp+slot], rax
        }
        else { let slot = _slot_of(fslots, pn); _store_argreg(code, pi, _slot_disp(slot)); }
        pi = pi + 1;
    }
    if fnname != nil and len(caps) == 0 {
        fslots.tco_name = fnname; fslots.tco_params = params; fslots.tco_target = len(code);
    }
    let bi = 0;
    while bi < len(body) { _gsr(body[bi], code, fslots, ctx.calls, true); bi = bi + 1; }
}
fn _rest_stmts(body) { let out = []; let i = 1; while i < len(body) { push(out, body[i]); i = i + 1; } return out; }
// Conservative control-flow proof used only to omit an unreachable implicit `return 0`. Unknown constructs
// return false, preserving the compatibility epilogue. A sequence returns once one statement cannot fall through.
fn _stmt_always_returns(s) {
    if s.kind == "return" { return true; }
    if s.kind == "while" and (try s.no_fallthrough catch false) { return true; }
    if s.kind != "if" { return false; }
    let els = try s.else catch nil;
    if els == nil or not _stmts_always_return(_stmts_of2(els)) { return false; }
    if not _stmts_always_return(_stmts_of2(s.then)) { return false; }
    let arms = try s.elifs catch nil;
    if arms != nil {
        let i = 0;
        while i < len(arms) {
            if not _stmts_always_return(_stmts_of2(arms[i].body)) { return false; }
            i = i + 1;
        }
    }
    return true;
}
fn _stmts_always_return(stmts) {
    let i = 0;
    while i < len(stmts) {
        if _stmt_always_returns(stmts[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// Exact second-order additive recurrence lowering. This deliberately accepts
// only the side-effect-free canonical shape
//
//   if n < 2 { return n; }
//   return self(n - 1) + self(n - 2);
//
// (the recursive terms may be swapped). It is then equivalent, modulo the
// backend's unchecked 64-bit arithmetic, to a three-register linear loop. The
// checked-overflow mode keeps the recursive tree so the first trap and its
// evaluation order remain unchanged. Near matches fail closed to TRMA/general
// codegen rather than receiving a speculative transformation.
fn _self_param_minus(node, fnname, param, delta) {
    if node.kind != "call" or node.func.kind != "ident" or node.func.name != fnname or len(node.args) != 1 { return false; }
    let a = node.args[0];
    if a.kind != "binary" or a.op != "-" or a.left.kind != "ident" or a.left.name != param or a.right.kind != "number" { return false; }
    return parse_number(a.right.value) == delta;
}
fn _is_linear_add_recurrence(body, params, fnname, caps) {
    if _ovf_state.on or fnname == nil or len(caps) != 0 or len(params) != 1 or len(body) != 2 { return false; }
    let param = _param_name(params[0]);
    let guard = _shrinkwrap_guard(body, params);
    if guard == nil or guard.cond.op != "<" { return false; }
    if guard.cond.left.kind != "ident" or guard.cond.left.name != param or guard.cond.right.kind != "number" { return false; }
    if parse_number(guard.cond.right.value) != 2 or guard.ret.kind != "ident" or guard.ret.name != param { return false; }
    let ret = body[1];
    if ret.kind != "return" { return false; }
    let sum = try ret.value catch nil;
    if sum == nil or sum.kind != "binary" or sum.op != "+" { return false; }
    let canonical = _self_param_minus(sum.left, fnname, param, 1) and _self_param_minus(sum.right, fnname, param, 2);
    let swapped = _self_param_minus(sum.left, fnname, param, 2) and _self_param_minus(sum.right, fnname, param, 1);
    return canonical or swapped;
}
// Direct SysV AMD64 lowering for the proven recurrence. Input n is in rdi;
// rax/rcx are caller-saved and hold adjacent sequence values. No frame, heap,
// spills, fixups, or callee-saved traffic is needed.
fn _emit_linear_add_recurrence(code) {
    push(code, 72); push(code, 131); push(code, 255); push(code, 2); // cmp rdi, 2
    push(code, 125); push(code, 4);                                 // jge .init
    push(code, 72); push(code, 137); push(code, 248); push(code, 195); // mov rax,rdi; ret
    push(code, 49); push(code, 192);                                // .init: xor eax,eax (a=0)
    push(code, 185); _elf.le(code, 1, 4);                            // mov ecx,1 (b=1)
    push(code, 72); push(code, 1); push(code, 193);                  // .loop: add rcx,rax (next)
    push(code, 72); push(code, 145);                                // xchg rax,rcx (a=next,b=old-a)
    push(code, 72); push(code, 255); push(code, 207);                // dec rdi
    push(code, 117); push(code, 246);                               // jnz .loop (-10)
    push(code, 195);                                                // ret
}

// Tail recursion modulo addition (TRMA). For the tightly proven shape
//
//   if base { return value; }
//   return self(left) + self(right);
//
// preserve the left-to-right evaluation order but execute the right recursive
// branch by looping in the current frame. This is valid for the integer native
// backend because addition is associative modulo the machine word. Requiring
// exactly these two statements prevents local state or body side effects from
// leaking between logical invocations.
fn _trma_body(body, params, fnname, caps) {
    if _ovf_state.on or fnname == nil or len(caps) != 0 or len(params) != 1 or len(body) != 2 { return nil; }
    let guard = _shrinkwrap_guard(body, params);
    if guard == nil { return nil; }
    let ret = body[1];
    if ret.kind != "return" { return nil; }
    let sum = try ret.value catch nil;
    if sum == nil or sum.kind != "binary" or sum.op != "+" { return nil; }
    let left = sum.left; let right = sum.right;
    if left.kind != "call" or right.kind != "call" { return nil; }
    if left.func.kind != "ident" or right.func.kind != "ident" { return nil; }
    if left.func.name != fnname or right.func.name != fnname { return nil; }
    if len(left.args) != 1 or len(right.args) != 1 { return nil; }

    let param = _param_name(params[0]);
    let acc = "__pb_trma_acc";
    if param == acc { return nil; }
    let base_return = map{ kind: "return", value: _n_bin("+", guard.ret, _n_id(acc)) };
    base_return.no_tmp = true;
    let loop_guard = map{ kind: "if", cond: guard.cond,
        then: map{ kind: "block", stmts: [base_return] } };
    let acc_update = _n_assign(acc, _n_bin("+", _n_id(acc), left));
    acc_update.inplace_reg_op = true;
    let loop_body = [ loop_guard, acc_update, _n_assign(param, right.args[0]) ];
    let loop = _n_while(_n_bool(true), loop_body);
    loop.no_fallthrough = true;
    return [ _n_let(acc, _n_num(0)), loop ];
}

fn _emit_fn(code, params, body, ctx, caps, strinfo) {
    let off = len(code);
    let fnname = try strinfo.fnname catch nil;
    let linear_recurrence = _is_linear_add_recurrence(body, params, fnname, caps);
    if linear_recurrence { _emit_linear_add_recurrence(code); return off; }
    let emit_body = body;
    let trma = _trma_body(body, params, fnname, caps);
    if trma != nil { emit_body = trma; }
    // ── SCRATCH PASS: count regular memory slots to decide frame-freeness. Emit to a throwaway buffer; the body
    //    may append to the shared calls/funlits/string arrays, so snapshot their lengths and truncate back after.
    let c0 = len(ctx.calls); let fl0 = len(ctx.funlits); let sd0 = len(ctx.strings.data); let sp0 = len(ctx.strings.patches);
    let sfslots = _build_fslots(params, emit_body, ctx, strinfo, caps);
    _emit_fn_inner([], sfslots, params, emit_body, caps, ctx, fnname);
    let regular_slots = sfslots.n;
    let framed_reserve = _regsave_reserve(sfslots);
    let framed_slots = regular_slots + framed_reserve;
    let framed_bytes = 8 * framed_slots;
    if framed_bytes % 16 != 0 { framed_bytes = framed_bytes + (16 - (framed_bytes % 16)); }
    while len(ctx.calls) > c0 { pop(ctx.calls); }
    while len(ctx.funlits) > fl0 { pop(ctx.funlits); }
    while len(ctx.strings.data) > sd0 { pop(ctx.strings.data); }
    while len(ctx.strings.patches) > sp0 { pop(ctx.strings.patches); }
    // FRAME-FREE = zero memory slots, no captures, and no tail-positioned call (its teardown assumes a frame).
    // Such a fn (e.g. fib) keeps all state in registers → gcc-style prologue: push callee-saved regs; body; pop; ret.
    let frame_free = regular_slots == 0 and len(caps) == 0 and len(params) <= 6 and not _has_gen_tailcall(emit_body, try ctx.fnnames catch nil);   // >6 params need rbp to reach stack args
    // ── REAL PASS
    let fslots = _build_fslots(params, emit_body, ctx, strinfo, caps);
    fslots.frame_free = frame_free;
    let body2 = emit_body;
    if frame_free {
        // SHRINK-WRAP: a base-case guard (`if <cmp-on-params> { return <param/const>; }`) runs BEFORE the pushes,
        // so leaf calls skip the callee-saved save/restore entirely. The guard `if` is then dropped from the body.
        let guard = _shrinkwrap_guard(body, params);
        if guard != nil {
            _emit_shrinkwrap_guard(code, guard, params);
            if trma == nil { body2 = _rest_stmts(body); }
        }
        _reg_push_all(code, fslots);                                     // save callee-saved via push — NO rbp, NO sub rsp
    } else {
        push(code, 85);                                                  // push rbp
        push(code, 72); push(code, 137); push(code, 229);                // mov rbp, rsp
        _emit_sub_rsp(code, framed_bytes);                               // shortest safe sub rsp encoding; omitted for zero
        fslots.n = framed_reserve;                                       // reserve top slots for reg-save spills
        _reg_save_all(code, fslots);
    }
    _emit_fn_inner(code, fslots, params, body2, caps, ctx, fnname);
    _check_frame(fslots.n, "fn");
    let complete = _stmts_always_return(body2);
    if frame_free {
        if not complete { push(code, 49); push(code, 192); _reg_pop_all(code, fslots); push(code, 195); } // implicit return 0
    } else {
        if fslots.n != framed_slots { throw "codegen_x64: frame sizing pass drift"; }
        if not complete { push(code, 49); push(code, 192); _reg_restore_all(code, fslots); push(code, 201); push(code, 195); } // implicit return 0
    }
    return off;
}

// compile_fns(src) — compile a program with user functions (+ recursion) to a
// native x86-64 ELF. Top-level `return <expr>;` exits with the value (low 8 bits).
// pblang-written stdlib helpers, compiled on demand when a program references them. Single-char
// separator for str_split (native subset); returns an array of substrings.
fn _prelude_helpers() {
    return map{
        str_split: "fn str_split(s, sep) { let parts = []; if len(sep) == 0 { let j = 0; while j < len(s) { push(parts, s[j]); j = j + 1; } return parts; } let start = 0; let i = 0; let n = len(s); while i < n { if s[i] == sep { push(parts, str_slice(s, start, i)); start = i + 1; } i = i + 1; } push(parts, str_slice(s, start, n)); return parts; }",
        // runtime string equality — used by the string-keyed map scan (so `m[runtimeKey]` works)
        __streq: "fn __streq(a, b) { if len(a) != len(b) { return 0; } let i = 0; while i < len(a) { if strcharcodeat(a, i) != strcharcodeat(b, i) { return 0; } i = i + 1; } return 1; }",
        // integer atoi (native codegen is integer-only). Parses an optional leading '-' then decimal digits;
        // used by the self-hosted evaluator to turn a number literal's source TEXT into a value.
        parse_number: "fn parse_number(s) { let n = 0; let i = 0; let neg = 0; if len(s) > 0 { if strcharcodeat(s, 0) == 45 { neg = 1; i = 1; } } while i < len(s) { let c = strcharcodeat(s, i); if c >= 48 { if c <= 57 { n = n * 10 + (c - 48); } } i = i + 1; } if neg == 1 { return 0 - n; } return n; }",
        // common global string builtins (match the Rust VM), written in pblang and injected on reference
        str_starts_with: "fn str_starts_with(s, pre) { if len(pre) > len(s) { return false; } let i = 0; while i < len(pre) { if strcharcodeat(s, i) != strcharcodeat(pre, i) { return false; } i = i + 1; } return true; }",
        str_trim: "fn str_trim(s) { let n = len(s); let a = 0; while a < n { let c = strcharcodeat(s, a); if c == 32 or c == 9 or c == 10 or c == 13 { a = a + 1; } else { break; } } let b = n; while b > a { let c = strcharcodeat(s, b - 1); if c == 32 or c == 9 or c == 10 or c == 13 { b = b - 1; } else { break; } } return str_slice(s, a, b); }",
        str_replace_all: "fn str_replace_all(s, from, to) { if len(from) == 0 { return s; } let out = \"\"; let i = 0; let n = len(s); let m = len(from); while i < n { let matched = true; if i + m <= n { let j = 0; while j < m { if strcharcodeat(s, i + j) != strcharcodeat(from, j) { matched = false; j = m; } else { j = j + 1; } } } else { matched = false; } if matched { out = out + to; i = i + m; } else { out = out + str_slice(s, i, i + 1); i = i + 1; } } return out; }",
        // integer exponentiation — the parser desugars `a ** b` to num_pow(a, b). Integer (matches the VM for
        // whole results); a negative exponent yields 1 here vs a fraction in the float VM (rare).
        num_pow: "fn num_pow(base, exp) { let r = 1; let i = 0; while i < exp { r = r * base; i = i + 1; } return r; }"
    };
}
fn _inject_prelude(src, fns, inlines, defined) {
    let helpers = _prelude_helpers();
    let names = map_keys(helpers);
    // __streq is needed by the string-keyed map scan — reached by any map literal AND by the runtime
    // index-dispatch path (`obj[idx]` on a non-statically-array object emits the map branch, which calls
    // __streq even when that branch is unreachable at runtime). So inject it whenever the source maps OR
    // indexes with `[`.
    // …and str_split is an injected helper that itself indexes `s[j]` (→ dynamic dispatch → __streq), so its
    // use also forces __streq even when the user source has no literal `[`.
    let uses_maps = len(str_split(src, "map{")) > 1 or len(str_split(src, "[")) > 1 or len(str_split(src, "str_split")) > 1;
    let i = 0;
    while i < len(names) {
        let nm = names[i];
        // inject a helper if the source references it by name, OR (for __streq) if maps/indexing are used
        let want = len(str_split(src, nm)) > 1;
        if nm == "__streq" and uses_maps { want = true; }
        if nm == "num_pow" and len(str_split(src, "**")) > 1 { want = true; }   // `a ** b` desugars to num_pow
        if not map_has(defined, nm) and want {
            let past = _par.parse(_tok.tokenize(helpers[nm]));
            let s = 0;
            while s < len(past.stmts) {
                let st = past.stmts[s];
                if st.kind == "fn" and not map_has(defined, st.name) {
                    push(fns, st); defined[st.name] = true;
                    let e = _inlinable_expr(st);
                    if e != nil { inlines[st.name] = map{ params: st.params, expr: e }; }
                }
                s = s + 1;
            }
        }
        i = i + 1;
    }
    return nil;
}

// ── LOOP REGISTER PROMOTION support: which globals are touched by a callable? ──────────────────────────
// A top-level global normally lives at a FIXED memory address so functions can read it. But a global that
// NO function (and no closure) ever references is "main-private" — only straight-line top-level code uses
// it — so main can keep it in a callee-saved register (r12/r13/r14) exactly like a local, turning a hot
// loop's per-iteration movabs+load/store into register ops. These scanners collect every identifier that
// appears inside any named-fn body or any function literal; a global absent from that set is safe to promote.
fn _ai_expr(node, out) {   // collect ALL ident names in an expression subtree (recurses INTO fn_lit bodies)
    if not is_map(node) { return; }
    let k = try node.kind catch nil;
    if k == "ident" { out[node.name] = true; return; }
    if k == "binary" { _ai_expr(node.left, out); _ai_expr(node.right, out); return; }
    if k == "unary" { _ai_expr(node.operand, out); return; }
    if k == "call" { _ai_expr(node.func, out); let i = 0; while i < len(node.args) { _ai_expr(node.args[i], out); i = i + 1; } return; }
    if k == "index" { _ai_expr(node.obj, out); _ai_expr(node.index, out); return; }
    if k == "member" { _ai_expr(node.obj, out); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _ai_expr(node.items[i], out); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _ai_expr(node.entries[i].value, out); i = i + 1; } return; }
    if k == "if_expr" { _ai_expr(node.cond, out); _ai_expr(node.then, out); _ai_expr(node.else, out); return; }
    if k == "try" { _ai_expr(node.body, out); _ai_expr(node.handler, out); return; }
    if k == "assign" { _ai_expr(node.value, out); out[node.name] = true; return; }
    if k == "assign_to" { _ai_expr(node.value, out); _ai_expr(node.target, out); return; }
    if k == "fn_lit" { _ai_stmts(_stmts_of2(node.body), out); return; }
}
fn _ai_stmts(stmts, out) {
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" or k == "return" or k == "print" { let v = try s.value catch nil; if v != nil { _ai_expr(v, out); } }
        if k == "expr_stmt" { _ai_expr(s.expr, out); }
        if k == "if" { _ai_expr(s.cond, out); _ai_stmts(_stmts_of2(s.then), out); let e = try s.else catch nil; if e != nil { _ai_stmts(_stmts_of2(e), out); } let ei = try s.elifs catch nil; if ei != nil { let j = 0; while j < len(ei) { _ai_expr(ei[j].cond, out); _ai_stmts(_stmts_of2(ei[j].body), out); j = j + 1; } } }
        if k == "while" { _ai_expr(s.cond, out); _ai_stmts(_stmts_of2(s.body), out); }
        i = i + 1;
    }
}
fn _fl_expr(node, out) {   // collect idents that appear only INSIDE a fn_lit (skip the surrounding expr's own idents)
    if not is_map(node) { return; }
    let k = try node.kind catch nil;
    if k == "fn_lit" { _ai_stmts(_stmts_of2(node.body), out); return; }
    if k == "binary" { _fl_expr(node.left, out); _fl_expr(node.right, out); return; }
    if k == "unary" { _fl_expr(node.operand, out); return; }
    if k == "call" { _fl_expr(node.func, out); let i = 0; while i < len(node.args) { _fl_expr(node.args[i], out); i = i + 1; } return; }
    if k == "index" { _fl_expr(node.obj, out); _fl_expr(node.index, out); return; }
    if k == "member" { _fl_expr(node.obj, out); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _fl_expr(node.items[i], out); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _fl_expr(node.entries[i].value, out); i = i + 1; } return; }
    if k == "if_expr" { _fl_expr(node.cond, out); _fl_expr(node.then, out); _fl_expr(node.else, out); return; }
    if k == "try" { _fl_expr(node.body, out); _fl_expr(node.handler, out); return; }
    if k == "assign" { _fl_expr(node.value, out); return; }
    if k == "assign_to" { _fl_expr(node.value, out); _fl_expr(node.target, out); return; }
}
fn _funlit_idents_stmts(stmts, out) {   // idents inside any fn_lit within main (main's own direct idents are fine)
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i]; let k = s.kind;
        if k == "let" or k == "const" or k == "return" or k == "print" { let v = try s.value catch nil; if v != nil { _fl_expr(v, out); } }
        if k == "expr_stmt" { _fl_expr(s.expr, out); }
        if k == "if" { _fl_expr(s.cond, out); _funlit_idents_stmts(_stmts_of2(s.then), out); let e = try s.else catch nil; if e != nil { _funlit_idents_stmts(_stmts_of2(e), out); } let ei = try s.elifs catch nil; if ei != nil { let j = 0; while j < len(ei) { _fl_expr(ei[j].cond, out); _funlit_idents_stmts(_stmts_of2(ei[j].body), out); j = j + 1; } } }
        if k == "while" { _fl_expr(s.cond, out); _funlit_idents_stmts(_stmts_of2(s.body), out); }
        i = i + 1;
    }
}

// ── string-literal interning ────────────────────────────────────────────────────────────────────────────────
// A string literal used to be re-materialized into the arena on EVERY evaluation (mov rax,r15; add r15,alloc; …).
// In a loop that is a per-iteration leak — and the self-hosted evaluator, which dispatches with dozens of
// `k == "binary"`-style literal comparisons per statement, leaked ~2.5 KB/iter and eventually exhausted the arena.
// Fix: collect every distinct literal, give each a fixed slot in the globals region, materialize it ONCE at
// startup, and load the cached pointer on use. Strings are immutable, so sharing one copy is always safe.
fn _add_lit(v, acc, list) { if not map_has(acc, v) { acc[v] = len(list); push(list, v); } }
fn _collect_strlits_node(node, acc, list) {
    if is_array(node) { let i = 0; while i < len(node) { _collect_strlits_node(node[i], acc, list); i = i + 1; } return; }
    if not is_map(node) { return; }
    let kd = try node.kind catch nil;
    if kd == "string" { _add_lit(node.value, acc, list); return; }
    // synthesized keys — the codegen builds these with _str_node() and they never appear as {kind:"string"} in the
    // source AST, so intern them here too: `m.field` (read/write) → the field NAME; `map{ k: v }` → each KEY.
    if kd == "member" { let nm = try node.name catch nil; if nm != nil { _add_lit(nm, acc, list); } }
    if kd == "map" {
        let ents = try node.entries catch nil;
        if is_array(ents) { let ei = 0; while ei < len(ents) { let ky = try ents[ei].key catch nil; if ky != nil { _add_lit(ky, acc, list); } ei = ei + 1; } }
    }
    let ks = map_keys(node); let i = 0;
    while i < len(ks) {
        let ch = node[ks[i]];
        if is_array(ch) or is_map(ch) { _collect_strlits_node(ch, acc, list); }
        i = i + 1;
    }
}
fn _collect_strlits(stmts, fns) {
    let acc = map{}; let list = [];
    _collect_strlits_node(stmts, acc, list);
    let f = 0; while f < len(fns) { _collect_strlits_node(fns[f].body, acc, list); f = f + 1; }
    return map{ idx: acc, list: list };
}
// Emit, at startup, one tagged heap string [TAG_STR,len,bytes@16] into the arena and store its pointer into the
// global slot at [GBASE + slot*8]. rax/rcx are free here (nothing live yet).
fn _emit_intern_one(code, s, slotaddr) {
    let bytes = str_to_bytes(s); let sl = len(bytes);
    let alloc = 16 + sl; let rr = alloc % 8; if rr != 0 { alloc = alloc + (8 - rr); }
    push(code, 76); push(code, 137); push(code, 248);                        // mov rax, r15   (string base)
    push(code, 73); push(code, 129); push(code, 199); _elf.le(code, alloc, 4);  // add r15, alloc
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);     // mov qword [rax], TAG_STR
    push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, sl, 4); // mov qword [rax+8], len
    let j = 0;
    while j < sl { push(code, 198); push(code, 128); _elf.le(code, 16 + j, 4); push(code, bytes[j]); j = j + 1; } // mov byte [rax+16+j], b
    push(code, 72); push(code, 185); _elf.le(code, slotaddr, 8);             // movabs rcx, &slot
    push(code, 72); push(code, 137); push(code, 1);                          // mov [rcx], rax
}

fn compile_fns(src) {
    let ast = _SOURCE.parse_source(src);
    let code = [];
    let calls = [];
    let labels = map{};
    // ---- pass 1: collect functions and build the inline registry (single-return leaf fns) ----
    let fns = [];
    let inlines = map{};
    let p = 0;
    while p < len(ast.stmts) {
        let s = ast.stmts[p];
        if s.kind == "fn" {
            push(fns, s);
            let e = _inlinable_expr(s);
            if e != nil { inlines[s.name] = map{ params: s.params, expr: e }; }
        }
        p = p + 1;
    }
    // ---- pass 1b: inject pblang-written stdlib helpers the program references but doesn't define ----
    // (e.g. str_split). They compile like any user function — reusing s[i], str_slice, push, arrays.
    let defined = map{}; let di = 0;
    while di < len(fns) { defined[fns[di].name] = true; di = di + 1; }
    _inject_prelude(src, fns, inlines, defined);
    // string-literal bytes are collected here and appended as a data section at the end
    let strings = map{ data: [], patches: [] };
    let keyids = map{};   // compile-time interning of map keys → integer ids (shared program-wide)
    let funlits = [];     // function literals collected during emission (emitted after named fns)
    // ---- globals: every TOP-LEVEL let/const gets a fixed heap slot so functions can read it ----
    let globals = map{}; let gp = 0;
    while gp < len(ast.stmts) {
        let s = ast.stmts[gp];
        if (s.kind == "let" or s.kind == "const") and not map_has(globals, s.name) { globals[s.name] = len(globals); }
        gp = gp + 1;
    }
    let nglobals = len(globals);
    // intern every distinct string literal into a fixed slot right after the globals region ([GBASE+(nglobals+i)*8])
    let sl = _collect_strlits(ast.stmts, fns);
    let strlits = sl.idx; let litlist = sl.list; let nlits = len(litlist);
    // set of ALL named user functions (incl. injected prelude helpers) — used to recognize a GENERAL tail call
    // `return g(args)` as jmp-able (g is a real fn label, not a builtin/closure/inline).
    let fnnames = map{}; let fni = 0; while fni < len(fns) { fnnames[fns[fni].name] = true; fni = fni + 1; }
    let ctx = map{ calls: calls, inlines: inlines, strings: strings, keyids: keyids, funlits: funlits, globals: globals, fnnames: fnnames, strlits: strlits, litbase: nglobals };
    // ---- heap: mmap the 1 GiB arena at the FIXED address _GBASE (MAP_FIXED, lazy) so global slots have known
    //      absolute addresses; the first nglobals*8 bytes are the globals region, then nlits*8 bytes of interned
    //      string-literal slots, then r15 bump-allocates. ----
    push(code, 72); push(code, 191); _elf.le(code, _GBASE(), 8);            // movabs rdi, GBASE (fixed addr)
    push(code, 190); _elf.le(code, _HEAPSZ(), 4);                           // mov esi, arena size (lazy)
    push(code, 106); push(code, 3); push(code, 90);                          // push 3; pop rdx (PROT_READ|WRITE)
    push(code, 106); push(code, 50); push(code, 65); push(code, 90);         // push 50; pop r10 (MAP_PRIVATE|ANON|FIXED)
    push(code, 106); push(code, 255); push(code, 65); push(code, 88);        // push -1; pop r8 (fd)
    push(code, 69); push(code, 49); push(code, 201);                        // xor r9d, r9d   (offset = 0)
    push(code, 184); _elf.le(code, 9, 4);                                   // mov eax, 9     (mmap)
    push(code, 15); push(code, 5);                                         // syscall
    // Linux syscalls return -errno in RAX. Never reinterpret a failed mapping
    // as the heap pointer: fail closed before any generated allocation can write.
    push(code, 72); push(code, 133); push(code, 192);                       // test rax, rax
    push(code, 121); push(code, 2);                                        // jns +2
    push(code, 15); push(code, 11);                                        // ud2 (mapping failure)
    push(code, 73); push(code, 137); push(code, 199);                       // mov r15, rax   (heap ptr = GBASE)
    let nreserve = nglobals + nlits;                                          // globals + one slot per interned literal
    if nreserve > 0 { push(code, 73); push(code, 129); push(code, 199); _elf.le(code, nreserve * 8, 4); } // add r15, (nglobals+nlits)*8
    // materialize each interned string literal ONCE, storing its pointer into slot (nglobals+idx)
    let li = 0;
    while li < nlits { _emit_intern_one(code, litlist[li], _GBASE() + (nglobals + li) * 8); li = li + 1; }
    // ---- entry: main = the top-level non-fn statements ----
    let mainstmts = [];
    let mj = 0;
    while mj < len(ast.stmts) { if ast.stmts[mj].kind != "fn" { push(mainstmts, ast.stmts[mj]); } mj = mj + 1; }
    // interprocedural string-type inference (which fns return strings, which params receive strings)
    let strtypes = _analyze_str_types(mainstmts, fns);
    ctx.fnstr = strtypes.fnstr;
    let strfields = _collect_strfields(mainstmts, fns, strtypes);   // map fields whose values are strings
    ctx.strfields = strfields;
    // LOOP REGISTER PROMOTION: a global may ALSO go in a register — but ONLY if no function/closure references
    // it (functions read globals from the fixed address, so a register copy would diverge). Compute the set of
    // global names any callable touches; a global absent from it is main-private and safe to keep in a register.
    let fn_refs = map{}; let fri = 0;
    while fri < len(fns) { _ai_stmts(_stmts_of2(fns[fri].body), fn_refs); fri = fri + 1; }
    _funlit_idents_stmts(mainstmts, fn_refs);                   // + any closure built in main
    // pin the 3 HOTTEST promotable top-level vars to r12/r13/r14 (loop-weighted) — rank ALL of them, not the
    // first 3 in source order, so a hot loop counter never loses a register to a cold var declared earlier.
    let mregvars = map{};
    let mranked = _ranked_locals(mainstmts, map{}); let mri = 0;
    while mri < len(mranked) and len(mregvars) < 3 {
        let nm = mranked[mri];
        let promotable = (not map_has(globals, nm)) or (not map_has(fn_refs, nm));  // local, or main-private global
        if promotable { mregvars[nm] = len(mregvars); }
        mri = mri + 1;
    }
    push(code, 72); push(code, 137); push(code, 229);                       // mov rbp, rsp
    push(code, 72); push(code, 129); push(code, 236); let mframe_at = len(code); _elf.le(code, 512, 4); // sub rsp, <frame> — backpatched
    let mslots = map{ names: map{}, n: 0, inlines: inlines, strings: strings, regvars: mregvars, uses_tmp: _stmts_use_tmp(mainstmts), tmpd: 0, keyids: keyids, funlits: funlits, strvars: map{}, ranges: map{}, fnstr: strtypes.fnstr, loops: [], globals: globals, strfields: strfields, strlits: strlits, litbase: nglobals };
    mslots.n = _regsave_reserve(mslots);                     // reserve top slots for callee-saved spills
    _reg_save_all(code, mslots);                              // save callee-saved r12-14 once
    let i = 0;
    while i < len(ast.stmts) {
        let s = ast.stmts[i];
        if s.kind != "fn" { _gsr(s, code, mslots, calls, false); }
        i = i + 1;
    }
    _check_frame(mslots.n, "<main>");
    let mframe = 8 * mslots.n; if mframe % 16 != 0 { mframe = mframe + (16 - (mframe % 16)); }
    _patch32(code, mframe_at, mframe);
    push(code, 191); _elf.le(code, 0, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5); // exit(0)
    // ---- each named function body ----
    let fi = 0;
    while fi < len(fns) {
        let fn_node = fns[fi];
        // this fn's string-param name set from the interprocedural analysis (call sites ∪ unification)
        let spars = try strtypes.fnspars[fn_node.name] catch map{};
        labels[fn_node.name] = _emit_fn(code, fn_node.params, _stmts_of2(fn_node.body), ctx, [], map{ spars: spars, fnname: fn_node.name });
        fi = fi + 1;
    }
    // ---- function literals (closures, Layer 1): emit each body, backpatch its `movabs` with the
    //      absolute code address. Emitting one may append more funlits, so loop until drained. ----
    let fp = 0;
    while fp < len(funlits) {
        let fl = funlits[fp];
        let foff = _emit_fn(code, fl.params, fl.body, ctx, fl.caps, map{ scaps: try fl.scaps catch map{}, spars: try fl.spars catch map{} });
        let addr = 4194304 + 120 + foff;
        let v = addr; let bx = 0;
        while bx < 8 { let bb = v % 256; code[fl.at + bx] = bb; v = (v - bb) / 256; bx = bx + 1; }  // patch movabs imm64
        fp = fp + 1;
    }
    // ---- backpatch call targets ----
    let ci = 0;
    while ci < len(calls) {
        let c = calls[ci];
        let target = try labels[c.name] catch nil;
        if target == nil { throw "codegen: call to undefined fn " + c.name; }
        _patch32(code, c.at, target - (c.at + 4));
        ci = ci + 1;
    }
    // ---- data section: append collected string bytes and backpatch their addresses ----
    // A byte at index `x` in `code` maps to virtual address 0x400000 + 120 + x (120 = ELF+program
    // headers), and the whole file is one R+X PT_LOAD, so the appended strings are readable.
    let dbase = 4194304 + 120 + len(code);          // vaddr of the first data byte
    let si = 0;
    while si < len(strings.patches) {
        let pt = strings.patches[si];
        let v = dbase + pt.off; let bi = 0;
        while bi < 8 { let bb = v % 256; code[pt.at + bi] = bb; v = (v - bb) / 256; bi = bi + 1; }  // patch movabs imm64
        si = si + 1;
    }
    let di = 0;
    while di < len(strings.data) { push(code, strings.data[di]); di = di + 1; }
    return _elf.wrap_elf(code);
}

// ── SAFETY PASS ───────────────────────────────────────────────────────────────
// compile_safe is a compatibility name for compilation with selected guards.
// The legacy `safe` flag is deprecated: it does not certify hostile source or
// runtime isolation. Scalar/pointer aliasing and unvalidated dynamic headers
// remain; callers must inspect the explicit scope and negative certification.
fn compile_safe(src) {
    let bin = compile_fns(src);
    return map{
        binary: bin,
        safe: true,
        safety_scope: "selected_runtime_checks",
        memory_safety_certified: false,
        runtime_isolated: false,
        heap_reserve_bytes: _HEAPSZ(),
        guarantees: [
            "array reads and writes through valid generated handles check bounds (exit 134)",
            "map access through valid generated handles checks for missing keys",
            "stack frames are size-guarded — refuses >1024 slots instead of smashing the stack",
            "heap mmap failure is checked before the returned address becomes the allocation pointer",
            "type predicates require all eight tag bytes to fit in the mapped arena"
        ],
        limitations: [
            "numbers, booleans, nil and pointers do not have distinct runtime tags",
            "dynamic headers and forged or interior object pointers are not authenticated",
            "arena reset marks and object lifetimes are not validated",
            "hard heap, stack and wall-clock isolation is not established"
        ]
    };
}

export compile_expr_exit, compile_program, compile_fns, compile_safe, set_overflow_check;
export heap_reserve_bytes, set_heap_reserve;
