// ── DEMAND-EMITTED FREESTANDING x86-64 RUNTIME HELPERS (zero libc, zero Rust) ────────────────────────────
fn _calls_have(calls, nm) {
    let i = 0;
    while i < len(calls) { if calls[i].name == nm { return true; } i = i + 1; }
