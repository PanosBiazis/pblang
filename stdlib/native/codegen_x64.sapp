    if k == "binary" { _ai_expr(node.left, out); _ai_expr(node.right, out); return; }
    if k == "unary" { _ai_expr(node.operand, out); return; }
    if k == "call" { _ai_expr(node.func, out); let i = 0; while i < len(node.args) { _ai_expr(node.args[i], out); i = i + 1; } return; }
    if k == "index" { _ai_expr(node.obj, out); _ai_expr(node.index, out); return; }
    if k == "member" { _ai_expr(node.obj, out); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _ai_expr(node.items[i], out); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _ai_expr(node.entries[i].value, out); i = i + 1; } return; }
    if k == "if_expr" { _ai_expr(node.cond, out); _ai_expr(node.then, out); _ai_expr(node.else, out); return; }
    if k == "try" { _ai_expr(node.body, out); _ai_expr(node.handler, out); return; }
    if k == "throw" { let v = try node.value catch nil; if v == nil { v = try node.expr catch nil; } _ai_expr(v, out); return; }
