        if k == "for_in" or k == "for_map" { _fl_expr(s.iter, out); _funlit_idents_stmts(_stmts_of2(s.body), out); }
        if k == "for_range" { _fl_expr(s.start, out); _fl_expr(s.end, out); _funlit_idents_stmts(_stmts_of2(s.body), out); }
