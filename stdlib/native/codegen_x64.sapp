        if k == "while" { _collect_lets(_stmts_of2(s.body), out, seen); }
        if k == "if" { _collect_lets(_stmts_of2(s.then), out, seen); let el = try s.elifs catch nil; if el != nil { let z = 0; while z < len(el) { _collect_lets(_stmts_of2(el[z].body), out, seen); z = z + 1; } } let e = try s.else catch nil; if e != nil { _collect_lets(_stmts_of2(e), out, seen); } }
        if k == "block" { _collect_lets(_stmts_of2(s), out, seen); }
