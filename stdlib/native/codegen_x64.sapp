        push(code, 72); push(code, 191); _elf.le(code, exc_val_addr, 8);     // movabs rdi, exc_val_addr
        push(code, 232); let ce2 = len(code); _elf.le(code, 0, 4); _patch32(code, ce2, evac_off - (ce2 + 4));
    }
    // 3. Scan stack roots [r13 (saved regs + frames) .. init_rsp)
    push(code, 76); push(code, 137); push(code, 237);                        // mov rbp, r13
    push(code, 72); push(code, 184); _elf.le(code, init_rsp_addr, 8);        // movabs rax, init_rsp_addr
    push(code, 76); push(code, 139); push(code, 32);                         // mov r12, [rax] (init_rsp)
    let slp = len(code);
    push(code, 76); push(code, 57); push(code, 229);                         // .slp: cmp rbp, r12
    push(code, 15); push(code, 131); let jsd = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 137); push(code, 239);                        // mov rdi, rbp
    push(code, 232); let ce3 = len(code); _elf.le(code, 0, 4); _patch32(code, ce3, evac_off - (ce3 + 4));
    push(code, 72); push(code, 131); push(code, 197); push(code, 8);         // add rbp, 8
    push(code, 233); let jsb = len(code); _elf.le(code, 0, 4); _patch32(code, jsb, slp - (jsb + 4));
    _patch32(code, jsd, len(code) - (jsd + 4));

    // 4. Cheney breadth-first scan of [to_base (r10) .. free_ptr (r11))
    push(code, 76); push(code, 137); push(code, 213);                        // mov rbp, r10 (scan)
    let clp = len(code);
    push(code, 76); push(code, 57); push(code, 221);                         // .clp: cmp rbp, r11
    push(code, 15); push(code, 131); let jcd = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 69); push(code, 0);          // mov rax, [rbp+0] (tag)
    push(code, 72); push(code, 131); push(code, 248); push(code, 1);         // TAG_STR = 1
    push(code, 117); push(code, 20);                                         // jne .ct2 (+20: 4+4+4+3+5)
    push(code, 72); push(code, 139); push(code, 77); push(code, 8);          // mov rcx, [rbp+8] (4B)
    push(code, 72); push(code, 131); push(code, 193); push(code, 24);        // add rcx, 24 (4B)
    push(code, 72); push(code, 131); push(code, 225); push(code, 248);       // and rcx, -8 (4B)
    push(code, 72); push(code, 1); push(code, 205);                          // add rbp, rcx (3B)
    push(code, 233); let jcb1 = len(code); _elf.le(code, 0, 4);              // jmp .clp (5B)
    _patch32(code, jcb1, clp - (jcb1 + 4));

    // .ct2: TAG_ARR = 2
    push(code, 72); push(code, 131); push(code, 248); push(code, 2);
    push(code, 15); push(code, 133); let jct3 = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 141); push(code, 101); push(code, 32);        // lea r12, [rbp+32]
    push(code, 76); push(code, 139); push(code, 109); push(code, 8);         // mov r13, [rbp+8] (len)
    let calp = len(code);
    push(code, 77); push(code, 133); push(code, 237);                        // test r13, r13
    push(code, 116); push(code, 17);                                         // jz .cadone (+17)
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12 (3B)
    push(code, 232); let cea = len(code); _elf.le(code, 0, 4); _patch32(code, cea, evac_off - (cea + 4)); // call (5B)
    push(code, 73); push(code, 131); push(code, 196); push(code, 8);         // add r12, 8 (4B)
    push(code, 73); push(code, 255); push(code, 205);                        // dec r13 (3B)
    push(code, 235); push(code, calp - (len(code) + 1) + 256);               // jmp (2B -> 3+5+4+3+2=17!)
    // .cadone:
