        elif k == "expr_stmt" { _score_expr(s.expr, w, score); }
        elif k == "return" { _score_expr(try s.value catch nil, w, score); }
        elif k == "while" { _score_expr(s.cond, w, score); _score_stmts(_stmts_of2(s.body), w * 32, score); }
        elif k == "if" {
