    push(code, 72); push(code, 141); push(code, 108); push(code, 205); push(code, 32); // lea rbp, [rbp+rcx*8+32]
    push(code, 233); let jcb2 = len(code); _elf.le(code, 0, 4); _patch32(code, jcb2, clp - (jcb2 + 4));

    // .ct3: TAG_MAP = 3
