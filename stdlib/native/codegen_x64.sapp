    push(code, 72); push(code, 137); push(code, 247);                        // mov rdi, rsi
    push(code, 72); push(code, 193); push(code, 231); push(code, 3);         // shl rdi, 3
    push(code, 72); push(code, 131); push(code, 199); push(code, 32);        // add rdi, 32
    push(code, 73); push(code, 1); push(code, 251);                          // add r11, rdi
    push(code, 73); push(code, 199); push(code, 6); _elf.le(code, 2, 4);     // mov qword [r14], 2
    push(code, 73); push(code, 137); push(code, 78); push(code, 8);          // mov [r14+8], rcx
    push(code, 73); push(code, 137); push(code, 118); push(code, 16);        // mov [r14+16], rsi
    push(code, 72); push(code, 141); push(code, 122); push(code, 32);        // lea rdi, [rdx+32]
    push(code, 73); push(code, 137); push(code, 126); push(code, 24);        // mov [r14+24], rdi
    push(code, 72); push(code, 139); push(code, 112); push(code, 24);        // mov rsi, [rax+24]
    push(code, 73); push(code, 141); push(code, 126); push(code, 32);        // lea rdi, [r14+32]
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);       // cld; rep movsq
    push(code, 233); let jfw2 = len(code); _elf.le(code, 0, 4);

    _patch32(code, jt3, len(code) - (jt3 + 4));
    push(code, 72); push(code, 131); push(code, 249); push(code, 3);         // TAG_MAP = 3
    push(code, 15); push(code, 133); let jt4 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);          // mov rcx, [rax+8] (count)
    push(code, 72); push(code, 141); push(code, 113); push(code, 8);         // lea rsi, [rcx+8] (new_cap)
    push(code, 72); push(code, 137); push(code, 247);                        // mov rdi, rsi
    push(code, 72); push(code, 193); push(code, 231); push(code, 4);         // shl rdi, 4
    push(code, 72); push(code, 131); push(code, 199); push(code, 32);        // add rdi, 32
    push(code, 73); push(code, 1); push(code, 251);                          // add r11, rdi
    push(code, 73); push(code, 199); push(code, 6); _elf.le(code, 3, 4);     // mov qword [r14], 3
    push(code, 73); push(code, 137); push(code, 78); push(code, 8);          // mov [r14+8], rcx
    push(code, 73); push(code, 137); push(code, 118); push(code, 16);        // mov [r14+16], rsi
    push(code, 72); push(code, 141); push(code, 122); push(code, 32);        // lea rdi, [rdx+32]
    push(code, 73); push(code, 137); push(code, 126); push(code, 24);        // mov [r14+24], rdi
    push(code, 72); push(code, 209); push(code, 225);                        // shl rcx, 1 (count*2 qwords)
    push(code, 72); push(code, 139); push(code, 112); push(code, 24);        // mov rsi, [rax+24]
    push(code, 73); push(code, 141); push(code, 126); push(code, 32);        // lea rdi, [r14+32]
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);       // cld; rep movsq
    push(code, 233); let jfw3 = len(code); _elf.le(code, 0, 4);

    _patch32(code, jt4, len(code) - (jt4 + 4));
    push(code, 72); push(code, 131); push(code, 249); push(code, 4);         // TAG_CLO = 4
    push(code, 15); push(code, 133); let jt5 = len(code); _elf.le(code, 0, 4);
    push(code, 72); push(code, 139); push(code, 72); push(code, 16);         // mov rcx, [rax+16] (ncaps)
    push(code, 72); push(code, 131); push(code, 193); push(code, 3);         // add rcx, 3
    push(code, 72); push(code, 137); push(code, 207);                        // mov rdi, rcx
    push(code, 72); push(code, 193); push(code, 231); push(code, 3);         // shl rdi, 3
    push(code, 73); push(code, 1); push(code, 251);                          // add r11, rdi
    push(code, 72); push(code, 137); push(code, 198);                        // mov rsi, rax
    push(code, 76); push(code, 137); push(code, 247);                        // mov rdi, r14
    push(code, 252); push(code, 243); push(code, 72); push(code, 165);       // cld; rep movsq
    push(code, 233); let jfw4 = len(code); _elf.le(code, 0, 4);

    _patch32(code, jt5, len(code) - (jt5 + 4));                              // TAG_BOX = 5
    push(code, 73); push(code, 131); push(code, 195); push(code, 16);        // add r11, 16
    push(code, 73); push(code, 199); push(code, 6); _elf.le(code, 5, 4);     // mov qword [r14], 5
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);          // mov rcx, [rax+8]
    push(code, 73); push(code, 137); push(code, 78); push(code, 8);          // mov [r14+8], rcx

    _patch32(code, jfw1, len(code) - (jfw1 + 4));
    _patch32(code, jfw2, len(code) - (jfw2 + 4));
    _patch32(code, jfw3, len(code) - (jfw3 + 4));
    _patch32(code, jfw4, len(code) - (jfw4 + 4));
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 99, 4);    // mov qword [rax], 99 (FWD)
    push(code, 72); push(code, 137); push(code, 80); push(code, 8);          // mov [rax+8], rdx
