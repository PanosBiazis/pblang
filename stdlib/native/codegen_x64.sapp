            let el = try s.elifs catch nil; if el != nil { let z = 0; while z < len(el) { _score_expr(el[z].cond, w, score); _score_stmts(_stmts_of2(el[z].body), w, score); z = z + 1; } }
            let e = try s.else catch nil; if e != nil { _score_stmts(_stmts_of2(e), w, score); }
