        if k == "let" or k == "const" or k == "return" or k == "print" { let v = try s.value catch nil; if v != nil { _ai_expr(v, out); } }
        if k == "expr_stmt" { _ai_expr(s.expr, out); }
        if k == "assign" { out[s.name] = true; _ai_expr(s.value, out); }
        if k == "block" { _ai_stmts(_stmts_of2(s), out); }
        if k == "if" { _ai_expr(s.cond, out); _ai_stmts(_stmts_of2(s.then), out); let e = try s.else catch nil; if e != nil { _ai_stmts(_stmts_of2(e), out); } let ei = try s.elifs catch nil; if ei != nil { let j = 0; while j < len(ei) { _ai_expr(ei[j].cond, out); _ai_stmts(_stmts_of2(ei[j].body), out); j = j + 1; } } }
        if k == "while" { _ai_expr(s.cond, out); _ai_stmts(_stmts_of2(s.body), out); }
        if k == "for_in" or k == "for_map" { _ai_expr(s.iter, out); _ai_stmts(_stmts_of2(s.body), out); }
        if k == "for_range" { _ai_expr(s.start, out); _ai_expr(s.end, out); _ai_stmts(_stmts_of2(s.body), out); }
        if k == "for" { _ai_expr(s.end, out); _ai_stmts(_stmts_of2(s.body), out); }
