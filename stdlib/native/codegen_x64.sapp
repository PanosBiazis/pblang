            // destination, so operate the other way (r14 op rax) to keep `left OP right` semantics.
            if op == "+" { push(code, 76); push(code, 1); push(code, 240); _ovf(code); return true; }             // add rax, r14
            if op == "*" { push(code, 73); push(code, 15); push(code, 175); push(code, 198); _ovf(code); return true; } // imul rax, r14 (REX.WB=49)
            if op == "-" { push(code, 73); push(code, 41); push(code, 198); push(code, 76); push(code, 137); push(code, 240); _ovf(code); return true; } // sub r14,rax ; mov rax,r14
            push(code, 73); push(code, 57); push(code, 198);    // cmp r14, rax   (= left - right → correct flags)
            _setcc(code, op); return true;
        }
