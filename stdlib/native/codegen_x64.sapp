        str_split: "fn str_split(s, sep) { let parts = []; if len(sep) == 0 { let j = 0; while j < len(s) { push(parts, s[j]); j = j + 1; } return parts; } let start = 0; let i = 0; let n = len(s); while i < n { if s[i] == sep { push(parts, str_slice(s, start, i)); start = i + 1; } i = i + 1; } push(parts, str_slice(s, start, n)); return parts; }",
        __streq: "fn __streq(a, b) { if len(a) != len(b) { return 0; } let i = 0; while i < len(a) { if strcharcodeat(a, i) != strcharcodeat(b, i) { return 0; } i = i + 1; } return 1; }",
        parse_number: "fn parse_number(s) { let n = 0; let i = 0; let neg = 0; if len(s) > 0 { if strcharcodeat(s, 0) == 45 { neg = 1; i = 1; } } while i < len(s) { let c = strcharcodeat(s, i); if c >= 48 { if c <= 57 { n = n * 10 + (c - 48); } } i = i + 1; } if neg == 1 { return 0 - n; } return n; }",
        str_starts_with: "fn str_starts_with(s, pre) { if len(pre) > len(s) { return false; } let i = 0; while i < len(pre) { if strcharcodeat(s, i) != strcharcodeat(pre, i) { return false; } i = i + 1; } return true; }",
        str_trim: "fn str_trim(s) { let n = len(s); let a = 0; while a < n { let c = strcharcodeat(s, a); if c == 32 or c == 9 or c == 10 or c == 13 { a = a + 1; } else { break; } } let b = n; while b > a { let c = strcharcodeat(s, b - 1); if c == 32 or c == 9 or c == 10 or c == 13 { b = b - 1; } else { break; } } return str_slice(s, a, b); }",
        str_replace_all: "fn str_replace_all(s, from, to) { if len(from) == 0 { return s; } let out = \"\"; let i = 0; let n = len(s); let m = len(from); while i < n { let matched = true; if i + m <= n { let j = 0; while j < m { if strcharcodeat(s, i + j) != strcharcodeat(from, j) { matched = false; j = m; } else { j = j + 1; } } } else { matched = false; } if matched { out = out + to; i = i + m; } else { out = out + str_slice(s, i, i + 1); i = i + 1; } } return out; }",
        num_pow: "fn num_pow(base, exp) { let r = 1; let i = 0; while i < exp { r = r * base; i = i + 1; } return r; }",
        num_floor: "fn num_floor(x) { return x; }",
        is_number: "fn is_number(x) { if is_string(x) { return false; } if is_array(x) { return false; } if is_map(x) { return false; } return true; }"
    };
}
