    push(code, 72); push(code, 193); push(code, 233); push(code, 3);         // shr rcx, 3 (live_qwords)
    push(code, 76); push(code, 137); push(code, 214);                        // mov rsi, r10 (src = to_base)
    push(code, 76); push(code, 137); push(code, 199);                        // mov rdi, r8  (dst = arena_base)
