    if k == "binary" { _fl_expr(node.left, out); _fl_expr(node.right, out); return; }
    if k == "unary" { _fl_expr(node.operand, out); return; }
    if k == "call" { _fl_expr(node.func, out); let i = 0; while i < len(node.args) { _fl_expr(node.args[i], out); i = i + 1; } return; }
    if k == "index" { _fl_expr(node.obj, out); _fl_expr(node.index, out); return; }
    if k == "member" { _fl_expr(node.obj, out); return; }
    if k == "array" { let i = 0; while i < len(node.items) { _fl_expr(node.items[i], out); i = i + 1; } return; }
    if k == "map" { let i = 0; while i < len(node.entries) { _fl_expr(node.entries[i].value, out); i = i + 1; } return; }
    if k == "if_expr" { _fl_expr(node.cond, out); _fl_expr(node.then, out); _fl_expr(node.else, out); return; }
