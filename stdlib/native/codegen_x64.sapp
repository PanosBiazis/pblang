                let rvs = _free_vars(rfl.params, _stmts_of2(rfl.body)); let cenv = map{}; let rj = 0;
                while rj < len(rvs) { if (try env[rvs[rj]] catch nil) == true { cenv[rvs[rj]] = true; } rj = rj + 1; }
                if _scan_stmts_str(_stmts_of2(rfl.body), cenv, fnstr, strparams) { fnstr["@factory@" + f.name] = true; }
            }
            let ps = map{}; let qi = 0;
            while qi < len(f.params) { let pn = _param_name(f.params[qi]); if (try env[pn] catch nil) == true { ps[pn] = true; } qi = qi + 1; }
            fnspars[f.name] = ps;
            fi = fi + 1;
        }
        iter = iter + 1;
    }
    return map{ fnstr: fnstr, fnspars: fnspars };
}
// Recursively find every map literal in `node`; a field whose value is string-typed (in `env`) is
// recorded in `strfields`, so `m.field` / `m["field"]` reads are treated as strings program-wide.
fn _walk_maps(node, env, fnstr, strfields) {
    if not is_map(node) { return nil; }
    let k = try node.kind catch nil;
    if k == "map" {
        let i = 0;
        while i < len(node.entries) { if _expr_is_str(node.entries[i].value, env, fnstr) { strfields[node.entries[i].key] = true; } i = i + 1; }
    }
    let keys = map_keys(node); let ki = 0;
    while ki < len(keys) {
        let v = node[keys[ki]];
        if is_map(v) { _walk_maps(v, env, fnstr, strfields); }
        else { if is_array(v) { let j = 0; while j < len(v) { _walk_maps(v[j], env, fnstr, strfields); j = j + 1; } } }
        ki = ki + 1;
    }
    return nil;
}
// Collect the set of map-field names whose values are strings, across every map literal in the program
// (using each function's inferred string params as the value-typing context — covers make_token-style
// constructors: `map{ kind: kind, text: text, line: line }` → {kind, text} are string fields).
fn _collect_strfields(mainstmts, fns, strtypes) {
    let strfields = map{}; let fnstr = strtypes.fnstr;
    let i = 0; while i < len(mainstmts) { _walk_maps(mainstmts[i], map{}, fnstr, strfields); i = i + 1; }
    let fi = 0;
    while fi < len(fns) {
        let f = fns[fi]; let env = map{};
        let sp = try strtypes.fnspars[f.name] catch nil;
        if sp != nil { let pk = 0; while pk < len(f.params) { let pn = _param_name(f.params[pk]); if map_has(sp, pn) { env[pn] = true; } pk = pk + 1; } }
        let bs = _stmts_of2(f.body); let bi = 0;
        while bi < len(bs) { _walk_maps(bs[bi], env, fnstr, strfields); bi = bi + 1; }
        fi = fi + 1;
    }
    return strfields;
}
// Infer a function-literal's string PARAMS and string CAPTURES from its body. Captures known-string in
// the enclosing scope seed the env; `+`-unification then types both params and captures straight from
// the body (e.g. `str(v) + unit` forces the capture `unit` to be a string). Returns {spars, scaps}.
fn _infer_funlit_types(node, slots) {
    let body = _stmts_of2(node.body);
    let fnstr = try slots.fnstr catch map{};
    let env = map{};
    let fvs = _free_vars(node.params, body); let i = 0;
    while i < len(fvs) { if _is_str(map{ kind: "ident", name: fvs[i] }, slots) { env[fvs[i]] = true; } i = i + 1; }
    let sink = map{}; let iter = 0;
    while iter < 4 { _scan_stmts_str(body, env, fnstr, sink); iter = iter + 1; }
    let spars = map{}; let p = 0;
    while p < len(node.params) { let pn = _param_name(node.params[p]); if (try env[pn] catch nil) == true { spars[pn] = true; } p = p + 1; }
    let scaps = map{}; let j = 0;
    while j < len(fvs) { if (try env[fvs[j]] catch nil) == true { scaps[fvs[j]] = true; } j = j + 1; }
    return map{ spars: spars, scaps: scaps };
}

fn _free_vars(params, body) {
    let bound = map{}; let i = 0; while i < len(params) { bound[_param_name(params[i])] = true; i = i + 1; }
    let out = []; let seen = map{};
    _fv_stmts(body, bound, out, seen);
    return out;
}

fn _reg_of(slots, name) {   // register index for a var, or -1
    let rv = try slots.regvars catch nil;
    if rv == nil { return -1; }
    let r = try rv[name] catch nil;
    if r == nil { return -1; }
    return r;
}
// mov r(12+regidx), <arg register argidx>  (argidx 0..3 = rdi/rsi/rdx/rcx)
fn _reg_from_argreg(code, regidx, argidx) {
    let src = 7; if argidx == 1 { src = 6; } if argidx == 2 { src = 2; } if argidx == 3 { src = 1; }
    push(code, 73); push(code, 137); push(code, 192 + src * 8 + (regidx + 4));
}
fn _reg_count(slots) { let rv = try slots.regvars catch nil; if rv == nil { return 0; } return len(rv); }
fn _uses_r14_tmp(slots) { let ut = try slots.uses_tmp catch false; return ut and _reg_count(slots) <= 2; }
fn _reg_save_all(code, slots) {
    let n = _reg_count(slots); let i = 0; while i < n { _reg_save(code, i); i = i + 1; }
    if _uses_r14_tmp(slots) { _reg_save(code, 2); }   // r14 is the expression temp register
}
fn _reg_restore_all(code, slots) {
    let n = _reg_count(slots); let i = 0; while i < n { _reg_restore(code, i); i = i + 1; }
    if _uses_r14_tmp(slots) { _reg_restore(code, 2); }
}

// COMPARE-AND-BRANCH: for `if <cmp> {…}` / `while <cmp> {…}`, jump on the comparison flags directly
// instead of materializing a 0/1 boolean (cmp+setcc+movzx+test+jz → cmp+j<inverse>). The condition
// runs on every loop/recursion, so this removes ~3 instructions per iteration on the hottest path.
// Returns the 0F-prefixed opcode of the jump taken when the condition is FALSE (i.e. skip the body).
fn _cond_skip_cc(op) {
    if op == "<"  { return 141; }   // jge  (skip when !(a<b))
    if op == ">"  { return 142; }   // jle
    if op == "<=" { return 143; }   // jg
    if op == ">=" { return 140; }   // jl
    if op == "==" { return 133; }   // jne
    if op == "!=" { return 132; }   // je
    return 0;
}
// Emit the condition and a rel32 "skip the body when false" jump; return the byte index to backpatch.
fn _emit_cond_skip(cond0, code, slots, calls) {
    let cond = _fold(cond0);
    // string == / != must use the byte-comparison routine (materialize the bool), NOT a pointer cmp.
    let str_eq = cond.kind == "binary" and (cond.op == "==" or cond.op == "!=") and _is_str(cond.left, slots) and _is_str(cond.right, slots);
    if cond.kind == "binary" and not str_eq {
        let cc = _cond_skip_cc(cond.op);
        if cc != 0 {
            if cond.right.kind == "number" {
                let cv = parse_number(cond.right.value);
                let lri = 0 - 1;
                if cond.left.kind == "ident" { lri = _reg_of(slots, cond.left.name); }
                if lri >= 0 {
                    // left operand is register-resident (the ubiquitous `while i < CONST`) → compare the register
                    // DIRECTLY against the immediate, skipping the `mov rax, reg` the general path would emit.
                    if cv == 0 { push(code, 77); push(code, 133); push(code, 192 + (4 + lri) * 9); }                                   // test r(12+lri),r(12+lri)
                    elif cv >= 0 - 128 and cv <= 127 { let b = cv; if b < 0 { b = b + 256; } push(code, 73); push(code, 131); push(code, 252 + lri); push(code, b); }  // cmp r,imm8
                    else { push(code, 73); push(code, 129); push(code, 252 + lri); _elf.le(code, cv, 4); }                            // cmp r(12+lri),imm32
                } else {
                    _ge_rax(cond.left, code, slots, calls);
                    if cv == 0 { push(code, 72); push(code, 133); push(code, 192); }        // test rax,rax (3B vs 7B)
                    else { push(code, 72); push(code, 61); _elf.le(code, cv, 4); }          // cmp rax, imm32
                }
            } elif cond.right.kind == "ident" and _reg_of(slots, cond.right.name) >= 0 {
                // right operand is register-resident (e.g. the hoisted `n` in `while i < n`) → compare rax
                // directly against the register, skipping the push/mov/pop spill of the general path.
                let rri = _reg_of(slots, cond.right.name);
                _ge_rax(cond.left, code, slots, calls);                                     // rax = left
                push(code, 76); push(code, 57); push(code, 192 + (4 + rri) * 8);           // cmp rax, r(12+rri)
            } else {
                _ge_rax(cond.left, code, slots, calls);
                push(code, 80);                                       // push rax (left)
                _ge_rax(cond.right, code, slots, calls);
                push(code, 72); push(code, 137); push(code, 195);    // mov rbx, rax (right)
                push(code, 88);                                      // pop rax (left)
                push(code, 72); push(code, 57); push(code, 216);    // cmp rax, rbx
            }
            push(code, 15); push(code, cc); let at = len(code); _elf.le(code, 0, 4);  // j<inverse> rel32
            return at;
        }
    }
    // fallback: materialize the boolean, then test + jz (jump when zero/false)
    _ge_rax(cond, code, slots, calls);
    push(code, 72); push(code, 133); push(code, 192);       // test rax, rax
    push(code, 15); push(code, 132); let at = len(code); _elf.le(code, 0, 4);  // jz rel32
    return at;
}

// statement gen with the rax convention. in_fn=true → return is leave/ret; else exit().
// ── tiny AST builders — used to DESUGAR `for` loops into `while` loops, so for-loops reuse all the
//    existing while/array/index codegen instead of new machine code. (number `value` is source TEXT.)
fn _n_num(v)          { return map{ kind: "number", value: str(v) }; }
fn _n_id(name)        { return map{ kind: "ident", name: name }; }
fn _n_bin(op, l, r)   { return map{ kind: "binary", op: op, left: l, right: r }; }
fn _n_let(name, val)  { return map{ kind: "let", name: name, value: val }; }
fn _n_assign(nm, val) { return map{ kind: "expr_stmt", expr: map{ kind: "assign", name: nm, value: val } }; }
fn _n_index(o, i)     { return map{ kind: "index", obj: o, index: i }; }
fn _n_call(fn_, args) { return map{ kind: "call", func: map{ kind: "ident", name: fn_ }, args: args }; }
fn _n_while(cond, ss) { return map{ kind: "while", cond: cond, body: map{ kind: "block", stmts: ss } }; }
fn _n_bool(v)         { return map{ kind: "bool", value: v }; }
fn _n_ifbrk(cond)     { return map{ kind: "if", cond: cond, then: map{ kind: "block", stmts: [ map{ kind: "break" } ] } }; }
fn _n_neg1()          { return _n_bin("-", _n_num(0), _n_num(1)); }   // the literal -1, built without a negative literal

// Evaluate a block-expr, leaving its VALUE (the last statement's expression) in rax. Earlier statements
// run for their side effects. Used by `if_expr` branches.
fn _ge_block_value(block, code, slots, calls) {
    let stmts = _stmts_of2(block);
    let n = len(stmts);
    if n == 0 { push(code, 49); push(code, 192); return nil; }          // empty → 0
    let i = 0;
    while i < n - 1 { _gsr(stmts[i], code, slots, calls, true); i = i + 1; }
    let last = stmts[n - 1];
    if last.kind == "expr_stmt" { _ge_rax(last.expr, code, slots, calls); }
    else { _gsr(last, code, slots, calls, true); push(code, 49); push(code, 192); }
    return nil;
}
// The value-expression of a block-expr (its last expr_stmt's expr), or nil — for string-type inference.
fn _block_val_expr(block) {
    let stmts = _stmts_of2(block); let n = len(stmts);
    if n > 0 and stmts[n - 1].kind == "expr_stmt" { return stmts[n - 1].expr; }
    return nil;
}

// ── AFFINE-RECURRENCE COLLAPSE (LLVM Scalar-Evolution style) ─────────────────────────────────────────────────
// Recognize `while var < N { acc = (A·acc + cv·var + cc) & MASK; var = var + STEP; }` and fold m iterations into
// one: acc_{+m} = A^m·acc + (cv·P)·var + (cv·STEP·Q + cc·P), where P=Σ A^t, Q=Σ j·A^{m-1-j} (all mod 2^k). This
// breaks the multiply-LATENCY chain (one imul by A^m per m steps). Emits a stride-m loop + the original as the
// remainder. All coefficients are reduced mod MASK+1 (kept <2^32 → exact in the f64 the codegen runs on); the
// masked runtime result stays correct under i64 wraparound because `& MASK` only reads the low k bits.
fn _lin_form(expr, acc, var) {   // {ca,cv,cc} with expr == ca*acc + cv*var + cc (linear in acc,var only), or nil
    let k = expr.kind;
    if k == "number" { return map{ ca: 0, cv: 0, cc: parse_number(expr.value) }; }
    if k == "ident" {
        if expr.name == acc { return map{ ca: 1, cv: 0, cc: 0 }; }
        if expr.name == var { return map{ ca: 0, cv: 1, cc: 0 }; }
        return nil;
    }
    if k == "unary" and expr.op == "-" { let o = _lin_form(expr.operand, acc, var); if o == nil { return nil; } return map{ ca: 0 - o.ca, cv: 0 - o.cv, cc: 0 - o.cc }; }
    if k == "binary" {
        let l = _lin_form(expr.left, acc, var); if l == nil { return nil; }
        let r = _lin_form(expr.right, acc, var); if r == nil { return nil; }
        if expr.op == "+" { return map{ ca: l.ca + r.ca, cv: l.cv + r.cv, cc: l.cc + r.cc }; }
        if expr.op == "-" { return map{ ca: l.ca - r.ca, cv: l.cv - r.cv, cc: l.cc - r.cc }; }
        if expr.op == "*" {
            if l.ca == 0 and l.cv == 0 { return map{ ca: l.cc * r.ca, cv: l.cc * r.cv, cc: l.cc * r.cc }; }
            if r.ca == 0 and r.cv == 0 { return map{ ca: r.cc * l.ca, cv: r.cc * l.cv, cc: r.cc * l.cc }; }
            return nil;
        }
        return nil;
    }
    return nil;
}
fn _imod(x, m) { let r = x % m; if r < 0 { r = r + m; } return r; }
fn _fits_f64(x) { let a = x; if a < 0 { a = 0 - a; } return a < 4503599627370496; }   // |x| < 2^52 → exact in f64
// m-step collapse coefficients for acc' = A·acc + cv·var + cc. MOD>0 → reduce mod MOD (masked, always fits);
// MOD==0 → unmasked: compute raw and BAIL (nil) if any value leaves f64's exact range (then the pass skips).
fn _collapse_coeffs(A, cv, cc, STEP, m, MOD) {
    let masked = MOD > 0;
    let Am = 1; let P = 0; let t = 0;
    while t < m {
        P = P + Am; Am = Am * A;
        if masked { P = _imod(P, MOD); Am = _imod(Am, MOD); }
        elif not _fits_f64(Am) or not _fits_f64(P) { return nil; }
        t = t + 1;
    }
    let Q = 0; let pw = 1; let j = m - 1;
    while j >= 0 {
        let term = j * pw; if masked { term = _imod(term, MOD); }
        Q = Q + term; pw = pw * A;
        if masked { Q = _imod(Q, MOD); pw = _imod(pw, MOD); }
        elif not _fits_f64(Q) or not _fits_f64(pw) { return nil; }
        j = j - 1;
    }
    let CV = cv * P; let t2 = cv * STEP * Q; let t3 = cc * P; let CC = t2 + t3;
    if masked { CV = _imod(CV, MOD); CC = _imod(CC, MOD); }
    elif not _fits_f64(CV) or not _fits_f64(t2) or not _fits_f64(t3) or not _fits_f64(CC) { return nil; }
    return map{ Am: Am, CV: CV, CC: CC };
}
// ── polynomial-in-var machinery (extends the collapse from f(var)=cv·var+cc to any polynomial) ──
fn _poly_neg(p) { let o = []; let i = 0; while i < len(p) { push(o, 0 - p[i]); i = i + 1; } return o; }
fn _poly_add(a, b) { let n = len(a); if len(b) > n { n = len(b); } let o = []; let i = 0;
    while i < n { let x = 0; if i < len(a) { x = x + a[i]; } if i < len(b) { x = x + b[i]; } push(o, x); i = i + 1; } return o; }
fn _poly_scale(p, s) { let o = []; let i = 0; while i < len(p) { push(o, p[i] * s); i = i + 1; } return o; }
fn _poly_mul(a, b) { let o = []; let i = 0; while i < len(a) + len(b) - 1 { push(o, 0); i = i + 1; }
    i = 0; while i < len(a) { let j = 0; while j < len(b) { o[i + j] = o[i + j] + a[i] * b[j]; j = j + 1; } i = i + 1; } return o; }
// expr as {ca (coeff of acc), poly:[c0,c1,…] (coeffs of var^0,var^1,…)}, or nil if not of that shape (acc must be
// linear with a CONSTANT coefficient; acc·var, acc·acc, or a third variable → nil).
fn _poly_form(expr, acc, var) {
    let k = expr.kind;
    if k == "number" { return map{ ca: 0, poly: [parse_number(expr.value)] }; }
    if k == "ident" {
        if expr.name == acc { return map{ ca: 1, poly: [0] }; }
        if expr.name == var { return map{ ca: 0, poly: [0, 1] }; }
        return nil;
    }
    if k == "unary" and expr.op == "-" { let o = _poly_form(expr.operand, acc, var); if o == nil { return nil; } return map{ ca: 0 - o.ca, poly: _poly_neg(o.poly) }; }
    if k == "binary" {
        let l = _poly_form(expr.left, acc, var); if l == nil { return nil; }
        let r = _poly_form(expr.right, acc, var); if r == nil { return nil; }
        if expr.op == "+" { return map{ ca: l.ca + r.ca, poly: _poly_add(l.poly, r.poly) }; }
        if expr.op == "-" { return map{ ca: l.ca - r.ca, poly: _poly_add(l.poly, _poly_neg(r.poly)) }; }
        if expr.op == "*" {
            if l.ca == 0 and len(l.poly) == 1 { return map{ ca: r.ca * l.poly[0], poly: _poly_scale(r.poly, l.poly[0]) }; }   // const * X
            if r.ca == 0 and len(r.poly) == 1 { return map{ ca: l.ca * r.poly[0], poly: _poly_scale(l.poly, r.poly[0]) }; }   // X * const
            if l.ca == 0 and r.ca == 0 { return map{ ca: 0, poly: _poly_mul(l.poly, r.poly) }; }                             // var-poly * var-poly
            return nil;   // acc·var / acc·acc → nonlinear in acc
        }
        return nil;
    }
    return nil;
}
fn _ipow_c(base, exp, mod, masked) { let r = 1; let e = 0; while e < exp { r = r * base; if masked { r = _imod(r, mod); } e = e + 1; } return r; }
fn _binom(n, kk) { if kk < 0 or kk > n { return 0; } let r = 1; let i = 0; while i < kk { r = r * (n - i); r = r / (i + 1); i = i + 1; } return r; }
// Fold m steps of acc' = A·acc + f(var), f given by `poly`. Returns {Am, coeffs:[C0,C1,…]} (mod MOD if masked;
// nil if unmasked and any coefficient escapes f64's exact range). Degree capped at 4.
fn _collapse_poly(A, poly, STEP, m, MOD) {
    let d = len(poly) - 1;
    if d > 4 { return nil; }
    let masked = MOD > 0;
    let Am = _ipow_c(A, m, MOD, masked);
    if not masked and not _fits_f64(Am) { return nil; }
    // moments M[r] = Σ_{j=0}^{m-1} A^{m-1-j} · j^r
    let M = []; let r = 0; while r <= d { push(M, 0); r = r + 1; }
    let pw = 1; let j = m - 1;
    while j >= 0 {
        let jr = 1; let rr = 0;
        while rr <= d {
            M[rr] = M[rr] + pw * jr; if masked { M[rr] = _imod(M[rr], MOD); } elif not _fits_f64(M[rr]) { return nil; }
            jr = jr * j; if masked { jr = _imod(jr, MOD); }
            rr = rr + 1;
        }
        pw = pw * A; if masked { pw = _imod(pw, MOD); }
        j = j - 1;
    }
    // C_p = Σ_{e>=p} c_e · C(e,p) · S^{e-p} · M[e-p]
    let C = []; let p = 0; while p <= d { push(C, 0); p = p + 1; }
    p = 0;
    while p <= d {
        let e = p;
        while e <= d {
            let term = poly[e] * _binom(e, p) * _ipow_c(STEP, e - p, MOD, masked) * M[e - p];
            if masked { term = _imod(term, MOD); }
            C[p] = C[p] + term; if masked { C[p] = _imod(C[p], MOD); } elif not _fits_f64(C[p]) { return nil; }
            e = e + 1;
        }
        p = p + 1;
    }
    return map{ Am: Am, coeffs: C };
}
// Parse one accumulator update `acc = [bit_and](A·acc + cv·var + cc [, MASK])`. Returns {acc,A,cv,cc,MOD,MASK} or
// nil. _lin_form returns nil if the rhs mentions any ident other than acc and var — that ENFORCES independence:
// a second accumulator reading the first will not parse, so only genuinely parallel recurrences collapse.
fn _parse_acc_update(st, var, slots) {
    if st.kind != "expr_stmt" or st.expr.kind != "assign" { return nil; }
    let acc = st.expr.name;
    if acc == var or _reg_of(slots, acc) < 0 { return nil; }
    // The update MUST be masked (`& MASK`): the mask keeps the accumulator < 2^k, the regime where pblang's f64
    // number semantics and the native i64 arithmetic agree. An UNMASKED recurrence can exceed 2^53, where the VM
    // (f64, loses precision) and native (i64, wraps) already diverge — so collapsing it would be "correct" only
    // against i64, not against the language. Refuse those; they fall through to the normal scalar loop.
    let rhs = st.expr.value; let MOD = 0; let MASK = 0;
    if rhs.kind != "call" or rhs.func.kind != "ident" or rhs.func.name != "bit_and" or len(rhs.args) != 2 or rhs.args[1].kind != "number" { return nil; }
    MASK = parse_number(rhs.args[1].value); MOD = MASK + 1;
    if MOD <= 1 or _log2_pow2(MOD) < 0 or MOD > 4294967296 { return nil; }
    rhs = rhs.args[0];
    let pf = _poly_form(rhs, acc, var);
    if pf == nil or pf.ca == 0 { return nil; }                                        // acc' = A·acc + poly(var), A!=0
    return map{ acc: acc, A: pf.ca, poly: pf.poly, MOD: MOD, MASK: MASK };
}
fn _try_collapse(node, slots) {
    if try node.no_collapse catch false { return nil; }
    let c = node.cond;
    if c.kind != "binary" or c.op != "<" or c.left.kind != "ident" or c.right.kind != "number" { return nil; }
    let var = c.left.name;
    if _reg_of(slots, var) < 0 { return nil; }
    let N = parse_number(c.right.value);
    let b = _stmts_of2(node.body);
    let nb = len(b);
    if nb < 2 { return nil; }                                             // ≥1 accumulator update + the increment
    // last statement must be `var = var + STEP` (positive constant stride)
    let last = b[nb - 1];
    if last.kind != "expr_stmt" or last.expr.kind != "assign" or last.expr.name != var { return nil; }
