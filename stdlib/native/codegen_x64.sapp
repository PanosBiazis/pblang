    if k == "unary" { return _expr_uses_tmp(node.operand); }
    if k == "call" { let i = 0; while i < len(node.args) { if _expr_uses_tmp(node.args[i]) { return true; } i = i + 1; } return false; }
    if k == "index" { return _expr_uses_tmp(node.obj) or _expr_uses_tmp(node.index); }
