    push(code, 73); push(code, 141); push(code, 179); _elf.le(code, 4095, 4);// lea rsi, [r11+4095]
    push(code, 72); push(code, 129); push(code, 230); _elf.le(code, 0 - 4096, 4); // and rsi, -4096 (release_end)
    push(code, 72); push(code, 41); push(code, 254);                         // sub rsi, rdi (release_len)
    push(code, 126); push(code, 12);                                         // jle .skip_madv (+12)
