    } else {
        push(code, 191); _elf.le(code, 70, 4); push(code, 184); _elf.le(code, 60, 4); push(code, 15); push(code, 5);
    }
    return off;
}
// __pb_fs_read_bytes: rdi = path TAG_STR → returns TAG_ARR of byte values (0..255).
fn _emit_rt_fs_read_bytes(code, calls) {
    let off = len(code);
    push(code, 232); let ca = len(code); _elf.le(code, 0, 4); push(calls, map{ at: ca, name: "__pb_fs_read" });
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);          // mov rcx, [rax+8] (len)
    push(code, 72); push(code, 141); push(code, 120); push(code, 16);        // lea rdi, [rax+16] (src bytes)
    push(code, 76); push(code, 137); push(code, 248);                        // mov rax, r15 (arr hdr)
    push(code, 72); push(code, 141); push(code, 81); push(code, 8);          // lea rdx, [rcx+8] (cap)
    push(code, 72); push(code, 137); push(code, 80); push(code, 16);         // mov [rax+16], rdx
    push(code, 72); push(code, 193); push(code, 226); push(code, 3);         // shl rdx, 3
    push(code, 72); push(code, 131); push(code, 194); push(code, 32);        // add rdx, 32
    push(code, 73); push(code, 1); push(code, 215);                          // add r15, rdx
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4);     // mov qword [rax], TAG_ARR
    push(code, 72); push(code, 137); push(code, 72); push(code, 8);          // mov [rax+8], rcx
    push(code, 72); push(code, 141); push(code, 112); push(code, 32);        // lea rsi, [rax+32]
    push(code, 72); push(code, 137); push(code, 112); push(code, 24);        // mov [rax+24], rsi
    push(code, 72); push(code, 133); push(code, 201);                        // test rcx, rcx
    push(code, 116); push(code, 18);                                         // jz .done (+18)
    push(code, 15); push(code, 182); push(code, 23);                         // .lp: movzx edx, byte [rdi]
    push(code, 72); push(code, 137); push(code, 22);                         // mov [rsi], rdx
    push(code, 72); push(code, 255); push(code, 199);                        // inc rdi
    push(code, 72); push(code, 131); push(code, 198); push(code, 8);         // add rsi, 8
    push(code, 72); push(code, 255); push(code, 201);                        // dec rcx
    push(code, 117); push(code, 238);                                        // jnz .lp (-18)
    push(code, 195);                                                         // .done: ret
