                push(code, 72); push(code, 137); push(code, 199);  // mov rdi, rax
            }
        } else {
            // multiple args: eval all onto the stack (a later arg may clobber an earlier arg reg),
            // then pop into the argument registers in reverse.
            let ai = 0;
            while ai < len(a) { if not _try_push_imm(code, _fold(a[ai])) { _ge_rax(a[ai], code, slots, calls); push(code, 80); } ai = ai + 1; }
            if len(a) > 6 {                                 // args 6+ go on the stack (SysV)
                let freeb = _stage_args_stack(code, len(a));
                push(code, 232); let at6 = len(code); _elf.le(code, 0, 4);
                push(calls, map{ at: at6, name: node.func.name });
                _free_args_stack(code, freeb);
                return true;
            }
            let j = len(a) - 1;
            while j >= 0 { _pop_argreg(code, j); j = j - 1; }
        }
        push(code, 232); let at = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: at, name: node.func.name });
        return true;                                        // result already in rax
    }
    if k == "binary" {
        let op = node.op;
        if op == "and" or op == "or" {
            // SHORT-CIRCUIT: `a and b` = a if a is falsy else b; `a or b` = a if a is truthy else b.
            _ge_rax(node.left, code, slots, calls);                          // rax = left
            push(code, 72); push(code, 133); push(code, 192);               // test rax, rax
            push(code, 15);                                                 // (near cond jump)
            if op == "and" { push(code, 132); } else { push(code, 133); }   // jz (and) / jnz (or) → done
            let jd = len(code); _elf.le(code, 0, 4);
            _ge_rax(node.right, code, slots, calls);                        // rax = right
            _patch32(code, jd, len(code) - (jd + 4));
            return true;
        }
        if op == "+" and _is_str(node.left, slots) and _is_str(node.right, slots) {
            // Both operands are string-TYPED. Two string literals are DEFINITELY strings → static concat.
            if node.left.kind == "string" and node.right.kind == "string" {
                _emit_str_concat(node.left, node.right, code, slots, calls);
                return true;
            }
            // Otherwise an operand may be a runtime NUMBER (a dynamically-typed source, e.g. an evaluator
            // function that returns a string on one path and a number on another). Dispatch on the left
            // operand's runtime tag: heap string → concatenate; else → integer add. This makes `+` correct
            // for dynamically-typed values WITHOUT touching purely-numeric code (fib's `+` isn't string-typed,
            // so it never reaches here). The check is a few instructions only on string-typed `+`.
            _ge_rax(node.left, code, slots, calls); push(code, 80);          // push left
            _ge_rax(node.right, code, slots, calls);                        // rax = right
            push(code, 72); push(code, 137); push(code, 195);              // mov rbx, rax  (right)
            push(code, 88);                                                // pop rax  (left)
            push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);    // movabs rcx, GBASE
            push(code, 72); push(code, 137); push(code, 194);              // mov rdx, rax
            push(code, 72); push(code, 41); push(code, 202);               // sub rdx, rcx   (left - GBASE)
            push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ(), 8);   // movabs rcx, arena size
            push(code, 72); push(code, 57); push(code, 202);               // cmp rdx, rcx
            push(code, 15); push(code, 131); let ja = len(code); _elf.le(code, 0, 4);  // jae .add
            push(code, 72); push(code, 139); push(code, 8);                // mov rcx, [rax]  (tag)
            push(code, 72); push(code, 131); push(code, 249); push(code, 1);// cmp rcx, TAG_STR
            push(code, 15); push(code, 133); let jn = len(code); _elf.le(code, 0, 4);  // jne .add
            _emit_concat_rr(code);                                         // concat left(rax)+right(rbx) → rax
            push(code, 233); let jd = len(code); _elf.le(code, 0, 4);       // jmp .done
            _patch32(code, ja, len(code) - (ja + 4));                       // .add:
            _patch32(code, jn, len(code) - (jn + 4));
            push(code, 72); push(code, 1); push(code, 216);                // add rax, rbx
            _patch32(code, jd, len(code) - (jd + 4));                       // .done:
            return true;
        }
        if (op == "==" or op == "!=") and _is_str(node.left, slots) and _is_str(node.right, slots) {
            _ge_rax(node.left, code, slots, calls); push(code, 80);           // push s1
            _ge_rax(node.right, code, slots, calls);                         // rax = s2
            push(code, 72); push(code, 137); push(code, 195);               // mov rbx, rax  (s2)
            push(code, 88);                                                 // pop rax  (s1)
            // A string LITERAL operand is definitely a string → static byte compare. Otherwise a value could
            // be a runtime number (dynamically-typed source) → dispatch on both operands' tags.
            if node.left.kind == "string" or node.right.kind == "string" {
                _emit_str_eq(code, op == "!=");                              // static string compare
            } else {
                _emit_eq_dynamic(code, op == "!=");                         // runtime: both-strings→bytes, else raw
            }
            return true;
        }
        if op == "/" or op == "%" {
            // STRENGTH REDUCTION: unsigned divide/modulo by a constant power of two → shr / and. `div` is
            // ~20-40 cycles; `shr` and `and` are 1. Exactly matches this backend's UNSIGNED div semantics
            // (x/2^k = x>>k, x%2^k = x&(2^k-1) for non-negative x), so results are identical — just faster.
            if node.right.kind == "number" {
                let dv = parse_number(node.right.value);
                let sh = _log2_pow2(dv);
                if sh >= 1 and sh <= 31 {
                    _ge_rax(node.left, code, slots, calls);                          // rax = dividend
                    if op == "/" { push(code, 72); push(code, 193); push(code, 232); push(code, sh); return true; }  // shr rax, k
                    push(code, 72); push(code, 37); _elf.le(code, dv - 1, 4); return true;                           // and rax, 2^k-1
                }
                if dv == 1 {
                    _ge_rax(node.left, code, slots, calls);
                    if op == "%" { push(code, 49); push(code, 192); }
                    return true;
                }
                let lr = _range_expr(node.left, slots);
                if dv == num_floor(dv) and dv >= 3 and dv <= 2147483647 and lr != nil and lr.lo >= 0 and lr.hi <= 4294967295 {
                    // A proven narrow dividend needs no reciprocal at all. This is especially useful for
                    // normalized accumulators (`x = expr % d`) whose next value is known to stay near d.
                    if lr.hi < dv {
                        _ge_rax(node.left, code, slots, calls);
                        if op == "/" { push(code, 49); push(code, 192); }
                        return true;
                    }
                    if lr.hi < dv * 2 {
                        _ge_rax(node.left, code, slots, calls);
                        _emit_cmp_rax_imm(code, dv);
                        if op == "%" {
                            let skip = 4; if dv > 127 { skip = 6; }
                            push(code, 114); push(code, skip);                // jb done
                            _emit_sub_rax_imm(code, dv);
                        } else {
                            push(code, 15); push(code, 147); push(code, 192);// setae al
                            push(code, 15); push(code, 182); push(code, 192);// movzx eax,al
                        }
                        return true;
                    }
                    _ge_rax(node.left, code, slots, calls);
                    _emit_udivmod_const_u32(code, dv, op == "%");
                    return true;
                }
            }
            // unsigned division: dividend in rax, divisor in rbx → quotient in rax, remainder in rdx.
            // (Kept out of the fast paths since div uses the fixed rdx:rax pair.)
            _ge_rax(node.left, code, slots, calls); push(code, 80);          // push left (dividend)
            _ge_rax(node.right, code, slots, calls);                         // rax = right (divisor)
            push(code, 72); push(code, 137); push(code, 195);              // mov rbx, rax
            push(code, 88);                                                 // pop rax (dividend)
            push(code, 72); push(code, 49); push(code, 210);               // xor rdx, rdx
            _div0(code);                                                    // checked mode: trap div-by-zero (ud2) before the raw #DE
            push(code, 72); push(code, 247); push(code, 243);              // div rbx
            if op == "%" { push(code, 72); push(code, 137); push(code, 208); }  // mov rax, rdx (remainder)
            return true;
        }
        if op == "+" and node.left.kind == "number" and node.right.kind != "number" {
            return _ge_rax(map{ kind: "binary", op: "+", left: node.right, right: node.left }, code, slots, calls);
        }
        if node.right.kind == "number" {
            let val = parse_number(node.right.value);
            // These folds all use a 32-bit immediate (add/sub/cmp sign-extend it; lea disp is 32-bit; imul
            // imm32). A constant outside signed-32 range would be truncated, so only fold when it FITS —
            // otherwise fall through to the general path, which materialises the constant with movabs (exact).
            if val >= 0 - 2147483648 and val <= 2147483647 {
                if val == 0 and not _ovf_state.on and (op == "+" or op == "-") {
                    _ge_rax(node.left, code, slots, calls);
                    return true;
                }
                // LEA FOLD: `regvar ± const` → one `lea rax, [reg±disp]` (saves the mov+add). Only for a left
                // operand already pinned to a register (r12/r13/r14) and only for +/- (lea can't multiply here).
                if (op == "+" or op == "-") and node.left.kind == "ident" {
                    let lri = _reg_of(slots, node.left.name);
                    if lri >= 0 {
                        let disp = val; if op == "-" { disp = 0 - val; }
                        _emit_lea_reg(code, lri, disp); return true;
                    }
                }
                // IMUL FOLD: `regvar * const` (non-strength-reducible) → one `imul rax, reg, imm32`, skipping the
                // `mov rax, reg`. Powers of two and 3/5/9 keep the shl/lea reduction (lower latency); safe mode
                // routes through _emit_mul_const (which forces imul + the overflow check).
                if op == "*" and node.left.kind == "ident" {
                    let lri = _reg_of(slots, node.left.name);
                    let sh = _log2_pow2(val);
                    if lri >= 0 and not _ovf_state.on and sh < 0 and val != 3 and val != 5 and val != 9 {
                        push(code, 73); push(code, 105); push(code, 196 + lri); _elf.le(code, val, 4); return true;   // imul rax, r(12+lri), imm32
                    }
                }
                _ge_rax(node.left, code, slots, calls);
                if op == "+" { if val >= 0 and val <= 127 { push(code, 72); push(code, 131); push(code, 192); push(code, val); } else { push(code, 72); push(code, 5); _elf.le(code, val, 4); } _ovf(code); return true; }    // add rax, imm8/imm32
                if op == "-" { if val >= 0 and val <= 127 { push(code, 72); push(code, 131); push(code, 232); push(code, val); } else { push(code, 72); push(code, 45); _elf.le(code, val, 4); } _ovf(code); return true; }   // sub rax, imm8/imm32
                if op == "*" { _emit_mul_const(code, val); return true; }   // strength reduction (shl/lea/shift±x) — _emit_mul_const forces imul + _ovf under safe mode
                if val == 0 { push(code, 72); push(code, 133); push(code, 192); }          // test rax,rax (3B vs 7B, same flags)
                else { push(code, 72); push(code, 61); _elf.le(code, val, 4); }            // cmp rax, imm32
                _setcc(code, op); return true;
            }
        }
        // REGISTER-VAR RIGHT OPERAND: `expr OP regvar` → evaluate left into rax and operate directly against
        // the register (add/sub/imul/cmp rax, r12|r13|r14). No push/pop, no r14 temp — this is what turns
        // `s + i` and `h*31 + i` (i register-resident) into a single instruction instead of a spill pair.
        if node.right.kind == "ident" {
            let rri = _reg_of(slots, node.right.name);
            if rri >= 0 {
                _ge_rax(node.left, code, slots, calls);                 // rax = left
                let m = 192 + (4 + rri) * 8;                            // ModRM for `op rax, r(12+rri)`
                if op == "+" { push(code, 76); push(code, 1); push(code, m); _ovf(code); return true; }         // add rax, reg
                if op == "-" { push(code, 76); push(code, 41); push(code, m); _ovf(code); return true; }        // sub rax, reg
                if op == "*" { push(code, 73); push(code, 15); push(code, 175); push(code, 192 + (4 + rri)); _ovf(code); return true; } // imul rax, reg
                push(code, 76); push(code, 57); push(code, m);          // cmp rax, reg
                _setcc(code, op); return true;
            }
        }
        // TEMPORARY IN A REGISTER: hold the left operand in the callee-saved r14 across the right's
        // evaluation instead of push/pop, when r14 is free here (not reg-allocated) and not already
        // holding an outer temporary. Deeper nesting falls back to the stack.
        let td = try slots.tmpd catch 0;
        if _uses_r14_tmp(slots) and td == 0 {
            _ge_rax(node.left, code, slots, calls);
            push(code, 73); push(code, 137); push(code, 198);   // mov r14, rax   (r14 = left)
            slots.tmpd = 1;
            _ge_rax(node.right, code, slots, calls);            // rax = right
            slots.tmpd = 0;
            // rax=right, r14=left. `+`/`*` are commutative; `-` and comparisons need left as the
            // destination, so operate the other way (r14 op rax) to keep `left OP right` semantics.
            if op == "+" { push(code, 76); push(code, 1); push(code, 240); _ovf(code); return true; }             // add rax, r14
            if op == "*" { push(code, 73); push(code, 15); push(code, 175); push(code, 198); _ovf(code); return true; } // imul rax, r14 (REX.WB=49)
            if op == "-" { push(code, 73); push(code, 41); push(code, 198); push(code, 76); push(code, 137); push(code, 240); _ovf(code); return true; } // sub r14,rax ; mov rax,r14
            push(code, 73); push(code, 57); push(code, 198);    // cmp r14, rax   (= left - right → correct flags)
            _setcc(code, op); return true;
        }
        // REGISTER-STACK for deeper temps: past the single r14 level, park the left operand in a caller-saved
        // register (r10 at depth 0, r9 at depth 1) instead of the memory stack — as long as the right operand
        // invokes no call (which would clobber caller-saved regs; then we use the memory stack, always safe).
        // Each depth uses a DISTINCT register (r14→r10→r9), so nested temps never collide; depth ≥2 → memory.
        let tb = -1;
        if td == 0 { tb = 2; }        // r10  (low 3 bits = 2)
        elif td == 1 { tb = 1; }      // r9   (low 3 bits = 1)
        if tb >= 0 and not _deep_has_call(node.right) {
            _ge_rax(node.left, code, slots, calls);                     // rax = left
            push(code, 73); push(code, 137); push(code, 192 + tb);      // mov r(8+tb), rax   (49 89 C0+tb)
            slots.tmpd = td + 1;
            _ge_rax(node.right, code, slots, calls);                    // rax = right
            slots.tmpd = td;
            // rax=right, r(8+tb)=left. Operate DIRECTLY against the temp register (like the r14 level above)
            // instead of shuffling through rbx — saves two movs (6 bytes) on +/*/cmp. `+`/`*` are commutative;
            // `-` and comparisons need left as the minuend, so do them the r(8+tb)-first way to keep semantics.
            if op == "+" { push(code, 76); push(code, 1); push(code, 192 + tb * 8); _ovf(code); return true; }              // add rax, r(8+tb)
            if op == "*" { push(code, 73); push(code, 15); push(code, 175); push(code, 192 + tb); _ovf(code); return true; } // imul rax, r(8+tb)
            if op == "-" { push(code, 73); push(code, 41); push(code, 192 + tb); push(code, 76); push(code, 137); push(code, 192 + tb * 8); _ovf(code); return true; } // sub r(8+tb),rax ; mov rax,r(8+tb)
            push(code, 73); push(code, 57); push(code, 192 + tb);       // cmp r(8+tb), rax  (flags = left - right)
            _setcc(code, op); return true;
        }
        _ge_rax(node.left, code, slots, calls);
        push(code, 80);                                     // push rax  (save left across right)
        _ge_rax(node.right, code, slots, calls);
        push(code, 72); push(code, 137); push(code, 195);   // mov rbx, rax   (rbx = right)
        push(code, 88);                                     // pop rax        (rax = left)
        if op == "+" { push(code, 72); push(code, 1); push(code, 216); _ovf(code); return true; }
        if op == "-" { push(code, 72); push(code, 41); push(code, 216); _ovf(code); return true; }
        if op == "*" { push(code, 72); push(code, 15); push(code, 175); push(code, 195); _ovf(code); return true; }
        push(code, 72); push(code, 57); push(code, 216);    // cmp rax, rbx
        _setcc(code, op); return true;
    }
    if k == "array" {
        // A dynamic array is a HANDLE [TAG_ARR, len, cap, dataptr] (32-byte header) plus a separately-
        // allocated element buffer of cap slots. push() can reallocate the buffer and update dataptr WITHOUT
        // moving the header, so in-place mutation semantics survive growth (this is exactly how a Vec works).
        let n = len(node.items);
        let cap = n + 8;                                                     // initial spare capacity
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15  (header ptr)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 32 + cap * 8, 4); // add r15, 32+cap*8
        push(code, 80);                                                      // push rax  (save header)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]  (header)
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 2, 4); // mov qword [rcx], TAG_ARR
        push(code, 72); push(code, 199); push(code, 65); push(code, 8); _elf.le(code, n, 4);  // mov qword [rcx+8], n  (len)
        push(code, 72); push(code, 199); push(code, 65); push(code, 16); _elf.le(code, cap, 4); // mov qword [rcx+16], cap
        push(code, 72); push(code, 141); push(code, 81); push(code, 32);     // lea rdx, [rcx+32]  (data = header+32)
        push(code, 72); push(code, 137); push(code, 81); push(code, 24);     // mov [rcx+24], rdx  (dataptr)
        let i = 0;
        while i < n {
            _ge_rax(node.items[i], code, slots, calls);                      // element → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]     (header)
            push(code, 72); push(code, 139); push(code, 81); push(code, 24); // mov rdx, [rcx+24]  (dataptr)
            push(code, 72); push(code, 137); push(code, 130); _elf.le(code, 8 * i, 4); // mov [rdx+8*i], rax
            i = i + 1;
        }
        push(code, 88);                                                      // pop rax  (header → result)
        return true;
    }
    if k == "map" {
        // Indirect dynamic map [TAG_MAP=3, count, cap, entries_ptr] (32B header + cap*16B entries buffer).
        let n = len(node.entries);
        let cap = n + 8;
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 32 + cap * 16, 4);  // add r15, 32+cap*16
        push(code, 80);                                                      // push rax (header)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 3, 4); // mov qword [rcx], TAG_MAP
        push(code, 72); push(code, 199); push(code, 65); push(code, 8); _elf.le(code, n, 4);  // mov qword [rcx+8], n
        push(code, 72); push(code, 199); push(code, 65); push(code, 16); _elf.le(code, cap, 4); // mov qword [rcx+16], cap
        push(code, 72); push(code, 141); push(code, 81); push(code, 32);     // lea rdx, [rcx+32]
        push(code, 72); push(code, 137); push(code, 81); push(code, 24);     // mov [rcx+24], rdx (entries_ptr)
        let i = 0;
        while i < n {
            let ent = node.entries[i];
            _ge_rax(_str_node(ent.key), code, slots, calls);                 // key string → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]
            push(code, 72); push(code, 139); push(code, 81); push(code, 24); // mov rdx, [rcx+24]
            push(code, 72); push(code, 137); push(code, 130); _elf.le(code, i * 16, 4);     // mov [rdx+i*16], rax
            _ge_rax(ent.value, code, slots, calls);                          // value → rax
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]
            push(code, 72); push(code, 139); push(code, 81); push(code, 24); // mov rdx, [rcx+24]
            push(code, 72); push(code, 137); push(code, 130); _elf.le(code, i * 16 + 8, 4); // mov [rdx+i*16+8], rax
            i = i + 1;
        }
        push(code, 88);                                                      // pop rax (header)
        return true;
    }
    if k == "member" {
        _emit_map_get_access(code, node.obj, _str_node(node.name), nil, slots, calls);  // m.key (trap on miss)
        return true;
    }
    if k == "fn_lit" {
        // Self-describing closure [TAG_CLO=4, code_ptr, ncaps, cap0, ...] (24 + ncaps*8 bytes).
        // Captures that are TAG_BOXed in the enclosing scope copy the shared TAG_BOX pointer directly.
        let body = _stmts_of2(node.body);
        let skip_fv = _closure_skip_set(slots);
        let caps = _free_vars_scoped(node.params, body, skip_fv);
        let nc = len(caps);
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15  (base)
        push(code, 73); push(code, 129); push(code, 199); _elf.le(code, 24 + nc * 8, 4); // add r15, 24+nc*8
        push(code, 80);                                                      // push rax (base)
        push(code, 72); push(code, 139); push(code, 12); push(code, 36);     // mov rcx, [rsp]
        push(code, 72); push(code, 199); push(code, 1); _elf.le(code, 4, 4); // mov qword [rcx], TAG_CLO
        push(code, 72); push(code, 184); let at = len(code); _elf.le(code, 0, 8);  // movabs rax, <fn addr>
        push(code, 72); push(code, 137); push(code, 65); push(code, 8);      // mov [rcx+8], rax  (code ptr)
        push(code, 72); push(code, 199); push(code, 65); push(code, 16); _elf.le(code, nc, 4); // mov qword [rcx+16], nc
        let child_boxcaps = map{};
        let p_bx = try slots.boxed catch nil;
        let p_bc = try slots.boxcaps catch nil;
        let p_cm = try slots.capmap catch nil;
        let ci = 0;
        while ci < nc {
            let cnm = caps[ci];
            if p_bx != nil and map_has(p_bx, cnm) {
                let bsl = _slot_of(slots, cnm);
                push(code, 72); push(code, 139); push(code, 133);
                let ba = len(code); _elf.le(code, 0, 4); _patch32(code, ba, _slot_disp(bsl)); // mov rax, [rbp+disp] (raw box ptr)
                child_boxcaps[cnm] = true;
            } elif p_bc != nil and map_has(p_bc, cnm) and p_cm != nil and map_has(p_cm, cnm) {
                push(code, 72); push(code, 139); push(code, 133);
                let ca2 = len(code); _elf.le(code, 0, 4); _patch32(code, ca2, _slot_disp(slots.cslot)); // mov rax, [rbp+cslot]
                push(code, 72); push(code, 139); push(code, 128); _elf.le(code, 24 + 8 * p_cm[cnm], 4); // mov rax, [rax+24+8*idx] (raw box ptr)
                child_boxcaps[cnm] = true;
            } else {
                _ge_rax(map{ kind: "ident", name: cnm }, code, slots, calls); // capture value → rax
            }
            push(code, 72); push(code, 139); push(code, 12); push(code, 36); // mov rcx, [rsp]
            push(code, 72); push(code, 137); push(code, 129); _elf.le(code, 24 + 8 * ci, 4); // mov [rcx+24+8*ci], rax
            ci = ci + 1;
        }
        push(code, 88);                                                      // pop rax (closure ptr)
        let ftypes = _infer_funlit_types(node, slots);
        push(slots.funlits, map{ params: node.params, body: body, at: at, caps: caps, boxcaps: child_boxcaps, scaps: ftypes.scaps, spars: ftypes.spars });
        return true;
    }
    if k == "index" {
        if node.index.kind == "string" {                                     // map access m["literal"]
            _emit_map_get_access(code, node.obj, node.index, nil, slots, calls);
            return true;
        }
        if node.obj.kind == "string" {
            // STRING LITERAL indexing "abc"[i] → a fresh 1-char NUL-terminated heap string.
            _ge_rax(node.obj, code, slots, calls);                           // rax = string ptr
            push(code, 80);                                                  // push
            _ge_rax(node.index, code, slots, calls);                        // rax = index
            push(code, 72); push(code, 137); push(code, 193);              // mov rcx, rax
            push(code, 88);                                                 // pop rax (string ptr)
            push(code, 72); push(code, 59); push(code, 72); push(code, 8); // cmp rcx, [rax+8]  (len)
            _emit_jb_over_trap134(code, slots, calls);
            push(code, 15); push(code, 182); push(code, 84); push(code, 8); push(code, 16); // movzx edx, byte [rax+rcx+16]
            push(code, 76); push(code, 137); push(code, 248);              // mov rax, r15   (new 1-char string)
            push(code, 73); push(code, 131); push(code, 199); push(code, 24); // add r15, 24
            push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4); // mov qword [rax], TAG_STR
            push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 1, 4); // mov qword [rax+8], 1 (len)
            push(code, 136); push(code, 80); push(code, 16);              // mov [rax+16], dl
            push(code, 198); push(code, 64); push(code, 17); push(code, 0); // mov byte [rax+17], 0
            return true;
        }
        if _known_map(node.obj, slots) {                                     // known map, runtime key → m[key]
            _emit_map_get_access(code, node.obj, node.index, nil, slots, calls);
            return true;
        }
        if not _known_array(node.obj, slots) {
            _emit_index_dynamic(code, node.obj, node.index, slots, calls);
            return true;
        }
        _ge_rax(node.obj, code, slots, calls);                               // rax = array pointer
        push(code, 80);                                                      // push rax
        _ge_rax(node.index, code, slots, calls);                             // rax = index
        push(code, 72); push(code, 137); push(code, 193);                    // mov rcx, rax  (index)
        push(code, 88);                                                      // pop rax  (pointer)
        push(code, 72); push(code, 59); push(code, 72); push(code, 8);       // cmp rcx, [rax+8]  (len)
        _emit_jb_over_trap134(code, slots, calls);
        push(code, 72); push(code, 139); push(code, 64); push(code, 24);     // mov rax, [rax+24]  (dataptr)
        push(code, 72); push(code, 139); push(code, 4); push(code, 200);     // mov rax, [rax+rcx*8]  (element)
        return true;
    }
    throw "codegen: cannot compile expr kind " + k;
}

// Extract keys (is_vals=false) or values (is_vals=true) from TAG_MAP in rax into a fresh TAG_ARR in rax.
fn _emit_extract_map_part(code, is_vals) {
    push(code, 72); push(code, 139); push(code, 72); push(code, 8);          // mov rcx, [rax+8]  (count)
    push(code, 72); push(code, 137); push(code, 195);                        // mov rbx, rax      (save map)
    push(code, 76); push(code, 137); push(code, 248);                        // mov rax, r15      (array header)
    push(code, 72); push(code, 137); push(code, 202);                        // mov rdx, rcx
    push(code, 72); push(code, 193); push(code, 226); push(code, 3);         // shl rdx, 3        (count*8)
    push(code, 73); push(code, 131); push(code, 199); push(code, 32);        // add r15, 32
    push(code, 73); push(code, 1); push(code, 215);                          // add r15, rdx
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 2, 4);     // mov qword [rax], TAG_ARR
    push(code, 72); push(code, 137); push(code, 72); push(code, 8);          // mov [rax+8], rcx  (len)
    push(code, 72); push(code, 137); push(code, 72); push(code, 16);         // mov [rax+16], rcx (cap)
    push(code, 72); push(code, 141); push(code, 80); push(code, 32);         // lea rdx, [rax+32] (dataptr)
    push(code, 72); push(code, 137); push(code, 80); push(code, 24);         // mov [rax+24], rdx
    push(code, 80);                                                          // push rax          (result)
    push(code, 72); push(code, 139); push(code, 115); push(code, 24);        // mov rsi, [rbx+24] (entries_ptr)
    if is_vals { push(code, 72); push(code, 131); push(code, 198); push(code, 8); } // add rsi, 8 (values)
    push(code, 72); push(code, 137); push(code, 215);                        // mov rdi, rdx      (dest)
    push(code, 72); push(code, 133); push(code, 201);                        // .loop: test rcx, rcx
    push(code, 116); push(code, 19);                                         // jz done (+19)
    push(code, 76); push(code, 139); push(code, 6);                          // mov r8, [rsi]
    push(code, 76); push(code, 137); push(code, 7);                          // mov [rdi], r8
    push(code, 72); push(code, 131); push(code, 198); push(code, 16);        // add rsi, 16
    push(code, 72); push(code, 131); push(code, 199); push(code, 8);         // add rdi, 8
    push(code, 72); push(code, 255); push(code, 201);                        // dec rcx
    push(code, 235); push(code, 232);                                        // jmp .loop (-24)
    push(code, 88);                                                          // done: pop rax
}

// Auto-coerce a TAG_STR pointer in rax to `rax + 16` (NUL-terminated C string) for dl_* FFI calls.
fn _emit_dl_coerce_rax(code) {
    push(code, 72); push(code, 185); _elf.le(code, _GBASE(), 8);             // movabs rcx, GBASE
    push(code, 72); push(code, 137); push(code, 194);                        // mov rdx, rax
    push(code, 72); push(code, 41); push(code, 202);                         // sub rdx, rcx
    push(code, 72); push(code, 185); _elf.le(code, _HEAPSZ() - 16, 8);       // movabs rcx, HEAPSZ-16
    push(code, 72); push(code, 57); push(code, 202);                         // cmp rdx, rcx
    push(code, 115); push(code, 10);                                         // jae +10
    push(code, 72); push(code, 131); push(code, 56); push(code, 1);          // cmp qword [rax], 1
    push(code, 117); push(code, 4);                                          // jne +4
    push(code, 72); push(code, 131); push(code, 192); push(code, 16);        // add rax, 16
}

// Call target in r10 with 16-byte stack alignment (required by glibc/SSE2 SysV AMD64 C-ABI).
fn _emit_aligned_call_r10(code) {
    push(code, 83);                                                          // push rbx
    push(code, 72); push(code, 137); push(code, 227);                        // mov rbx, rsp
    push(code, 72); push(code, 131); push(code, 228); push(code, 240);       // and rsp, -16
    push(code, 49); push(code, 192);                                         // xor eax, eax
    push(code, 65); push(code, 255); push(code, 210);                        // call r10
    push(code, 72); push(code, 137); push(code, 220);                        // mov rsp, rbx
    push(code, 91);                                                          // pop rbx
}

fn _try_emit_sys_or_ffi_call(node, code, slots, calls) {
    let nm = node.func.name;
    let na = len(node.args);
    // ── Direct Linux x86-64 filesystem / time / process syscalls (zero libc) ──
    if nm == "fs_exists" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 141); push(code, 120); push(code, 16);    // lea rdi, [rax+16]
        push(code, 49); push(code, 246);                                     // xor esi, esi (F_OK)
        push(code, 184); _elf.le(code, 21, 4);                               // mov eax, 21 (SYS_access)
        push(code, 15); push(code, 5);                                       // syscall
        push(code, 72); push(code, 133); push(code, 192);                    // test rax, rax
        push(code, 15); push(code, 148); push(code, 192);                    // sete al
        push(code, 15); push(code, 182); push(code, 192);                    // movzx eax, al
        return true;
    }
    if nm == "fs_remove" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 141); push(code, 120); push(code, 16);    // lea rdi, [rax+16]
        push(code, 184); _elf.le(code, 87, 4);                               // mov eax, 87 (SYS_unlink)
        push(code, 15); push(code, 5);
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "fs_chmod" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);
        _ge_rax(node.args[1], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (mode)
        push(code, 88);                                                      // pop rax (path)
        push(code, 72); push(code, 141); push(code, 120); push(code, 16);    // lea rdi, [rax+16]
        push(code, 184); _elf.le(code, 90, 4);                               // mov eax, 90 (SYS_chmod)
        push(code, 15); push(code, 5);
        push(code, 72); push(code, 133); push(code, 192);
        push(code, 15); push(code, 148); push(code, 192);
        push(code, 15); push(code, 182); push(code, 192);
        return true;
    }
    if nm == "fs_read" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_fs_read" });
        return true;
    }
    if nm == "fs_read_bytes" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_fs_read_bytes" });
        return true;
    }
    if nm == "fs_write" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);
        _ge_rax(node.args[1], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (content)
        push(code, 95);                                                      // pop rdi (path)
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_fs_write" });
        return true;
    }
    if nm == "fs_write_bytes" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);
        _ge_rax(node.args[1], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (byte_arr)
        push(code, 95);                                                      // pop rdi (path)
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_fs_write_bytes" });
        return true;
    }
    if (nm == "time_ms" or nm == "now_ms") and na == 0 {
        push(code, 72); push(code, 131); push(code, 236); push(code, 16);    // sub rsp, 16
        push(code, 49); push(code, 255);                                     // xor edi, edi (CLOCK_REALTIME=0)
        push(code, 72); push(code, 137); push(code, 230);                    // mov rsi, rsp
        push(code, 184); _elf.le(code, 228, 4);                              // mov eax, 228 (SYS_clock_gettime)
        push(code, 15); push(code, 5);
        push(code, 72); push(code, 105); push(code, 12); push(code, 36); _elf.le(code, 1000, 4); // imul rcx, [rsp], 1000
        push(code, 72); push(code, 139); push(code, 68); push(code, 36); push(code, 8); // mov rax, [rsp+8]
        push(code, 49); push(code, 210);                                     // xor edx, edx
        push(code, 190); _elf.le(code, 1000000, 4);                          // mov esi, 1000000
        push(code, 72); push(code, 247); push(code, 246);                    // div rsi
        push(code, 72); push(code, 1); push(code, 200);                      // add rax, rcx
        push(code, 72); push(code, 131); push(code, 196); push(code, 16);    // add rsp, 16
        return true;
    }
    if nm == "sleep_ms" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 49); push(code, 210);                                     // xor edx, edx
        push(code, 185); _elf.le(code, 1000, 4);                             // mov ecx, 1000
        push(code, 72); push(code, 247); push(code, 241);                    // div rcx  (rax=sec, rdx=ms)
        push(code, 72); push(code, 105); push(code, 210); _elf.le(code, 1000000, 4); // imul rdx, rdx, 1000000
        push(code, 82); push(code, 80);                                      // push rdx (nsec); push rax (sec)
        push(code, 72); push(code, 137); push(code, 231);                    // mov rdi, rsp
        push(code, 49); push(code, 246);                                     // xor esi, esi
        push(code, 184); _elf.le(code, 35, 4);                               // mov eax, 35 (SYS_nanosleep)
        push(code, 15); push(code, 5);
        push(code, 72); push(code, 131); push(code, 196); push(code, 16);    // add rsp, 16
        push(code, 49); push(code, 192);                                     // xor eax, eax
        return true;
    }
    if nm == "os_exit" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 137); push(code, 199);                                    // mov edi, eax
        push(code, 184); _elf.le(code, 60, 4);                               // mov eax, 60 (SYS_exit)
        push(code, 15); push(code, 5);
        return true;
    }
    if (nm == "os_args" or nm == "args") and na == 0 {
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_os_args" });
        return true;
    }
    if nm == "sys_fork" and na == 0 {
        push(code, 191); _elf.le(code, 17, 4);                               // mov edi, 17 (SIGCHLD)
        push(code, 49); push(code, 246);                                     // xor esi, esi
        push(code, 49); push(code, 210);                                     // xor edx, edx
        push(code, 65); push(code, 186); _elf.le(code, 0, 4);                // mov r10d, 0
        push(code, 65); push(code, 184); _elf.le(code, 0, 4);                // mov r8d, 0
        push(code, 184); _elf.le(code, 56, 4);                               // mov eax, 56 (SYS_clone)
        push(code, 15); push(code, 5);
        return true;
    }
    if nm == "sys_waitpid" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax (pid)
        push(code, 49); push(code, 192); push(code, 80);                     // xor eax, eax; push rax (wstatus=0)
        push(code, 72); push(code, 137); push(code, 230);                    // mov rsi, rsp
        push(code, 49); push(code, 210);                                     // xor edx, edx
        push(code, 65); push(code, 186); _elf.le(code, 0, 4);                // mov r10d, 0
        push(code, 184); _elf.le(code, 61, 4);                               // mov eax, 61 (SYS_wait4)
        push(code, 15); push(code, 5);
        push(code, 89);                                                      // pop rcx (wstatus)
        push(code, 72); push(code, 193); push(code, 233); push(code, 8);     // shr rcx, 8
        push(code, 129); push(code, 225); _elf.le(code, 255, 4);             // and ecx, 255
        push(code, 72); push(code, 137); push(code, 200);                    // mov rax, rcx
        return true;
    }
    // ── Direct Linux x86-64 TCP Socket Builtins (zero libc) ──
    if nm == "tcp_listen_port" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax (port)
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_tcp_listen" });
        return true;
    }
    if nm == "tcp_accept" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax (listen_fd)
        push(code, 49); push(code, 246);                                     // xor esi, esi
        push(code, 49); push(code, 210);                                     // xor edx, edx
        push(code, 184); _elf.le(code, 43, 4);                               // mov eax, 43 (SYS_accept)
        push(code, 15); push(code, 5);
        return true;
    }
    if nm == "tcp_connect_ipv4" and (na == 1 or na == 2) {
        if na == 1 {
            _ge_rax(node.args[0], code, slots, calls);
            push(code, 72); push(code, 137); push(code, 198);                // mov rsi, rax (port)
            push(code, 191); _elf.le(code, 2130706433, 4);                   // mov edi, 0x7f000001 (127.0.0.1)
        } else {
            _ge_rax(node.args[0], code, slots, calls); push(code, 80);
            _ge_rax(node.args[1], code, slots, calls);
            push(code, 72); push(code, 137); push(code, 198);                // mov rsi, rax (port)
            push(code, 95);                                                  // pop rdi (ip u32 or dotted str)
        }
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_tcp_connect" });
        return true;
    }
    if nm == "tcp_read" and (na == 1 or na == 2) {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);
        if na == 2 { _ge_rax(node.args[1], code, slots, calls); }
        else { push(code, 184); _elf.le(code, 4096, 4); }
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (max_len)
        push(code, 95);                                                      // pop rdi (fd)
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_tcp_read" });
        return true;
    }
    if nm == "tcp_write" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);           // push fd
        _ge_rax(node.args[1], code, slots, calls);                           // rax = data_str
        push(code, 72); push(code, 139); push(code, 80); push(code, 8);      // mov rdx, [rax+8]  (len)
        push(code, 72); push(code, 141); push(code, 112); push(code, 16);    // lea rsi, [rax+16] (bytes)
        push(code, 95);                                                      // pop rdi (fd)
        push(code, 184); _elf.le(code, 1, 4);                                // mov eax, 1 (SYS_write)
        push(code, 15); push(code, 5);
        return true;
    }
    if nm == "tcp_close" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax (fd)
        push(code, 184); _elf.le(code, 3, 4);                                // mov eax, 3 (SYS_close)
        push(code, 15); push(code, 5);
        return true;
    }
    // ── Dynamic ELF64 Raw Pointer & dlopen/dlsym C-ABI FFI Builtins ──
    if nm == "cstr_ptr" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 131); push(code, 192); push(code, 16);    // add rax, 16
        return true;
    }
    if (nm == "cstr_read" or nm == "cstr_to_str") and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax
        push(code, 232); let ca = len(code); _elf.le(code, 0, 4);
        push(calls, map{ at: ca, name: "__pb_cstr_read" });
        return true;
    }
    if nm == "ptr_buf8" and na == 0 {
        // Allocate 16 bytes [0, 0] on r15, return rax = slot ptr (tag word is 0 so GC ignores raw C pointers).
        push(code, 76); push(code, 137); push(code, 248);                    // mov rax, r15
        push(code, 73); push(code, 131); push(code, 199); push(code, 16);    // add r15, 16
        push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 0, 4); // mov qword [rax], 0
        push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, 0, 4); // mov qword [rax+8], 0
        return true;
    }
    if nm == "ptr_load64" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 139); push(code, 0);                      // mov rax, [rax]
        return true;
    }
    if nm == "ptr_store64" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);
        _ge_rax(node.args[1], code, slots, calls);
        push(code, 89);                                                      // pop rcx (ptr)
        push(code, 72); push(code, 137); push(code, 1);                      // mov [rcx], rax
        return true;
    }
    if nm == "fn_code_ptr" and na == 1 {
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 139); push(code, 64); push(code, 8);      // mov rax, [rax+8]
        return true;
    }
    let plt = try slots.dyn_plt catch nil;
    if nm == "dl_open" and (na == 1 or na == 2) {
        if plt == nil { throw "codegen_x64: dl_open requires dynamic ELF target (elf_dyn_x64)"; }
        _ge_rax(node.args[0], code, slots, calls); _emit_dl_coerce_rax(code); push(code, 80);
        if na == 2 { _ge_rax(node.args[1], code, slots, calls); push(code, 72); push(code, 137); push(code, 198); }
        else { push(code, 190); _elf.le(code, 2, 4); }                       // mov esi, RTLD_NOW (2)
        push(code, 95);                                                      // pop rdi (filename)
        push(code, 73); push(code, 186); _elf.le(code, plt.dlopen, 8);       // movabs r10, plt.dlopen
        _emit_aligned_call_r10(code);
        return true;
    }
    if nm == "dl_sym" and na == 2 {
        if plt == nil { throw "codegen_x64: dl_sym requires dynamic ELF target (elf_dyn_x64)"; }
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);           // push handle
        _ge_rax(node.args[1], code, slots, calls); _emit_dl_coerce_rax(code);
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (symbol cstr)
        push(code, 95);                                                      // pop rdi (handle)
        push(code, 73); push(code, 186); _elf.le(code, plt.dlsym, 8);        // movabs r10, plt.dlsym
        _emit_aligned_call_r10(code);
        return true;
    }
    if nm == "dl_close" and na == 1 {
        if plt == nil { throw "codegen_x64: dl_close requires dynamic ELF target (elf_dyn_x64)"; }
        _ge_rax(node.args[0], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax (handle)
        push(code, 73); push(code, 186); _elf.le(code, plt.dlclose, 8);      // movabs r10, plt.dlclose
        _emit_aligned_call_r10(code);
        return true;
    }
    if (nm == "dl_call0" and na == 1) or (nm == "dl_call1" and na == 2) or (nm == "dl_call2" and na == 3)
       or (nm == "dl_call3" and na == 4) or (nm == "dl_call4" and na == 5) or (nm == "dl_call5" and na == 6)
       or (nm == "dl_call6" and na == 7) {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);           // push fnptr
        let ca = 1;
        while ca < na {
            _ge_rax(node.args[ca], code, slots, calls);
            _emit_dl_coerce_rax(code);
            push(code, 80);
            ca = ca + 1;
        }
        let cj = na - 2;
        while cj >= 0 { _pop_argreg(code, cj); cj = cj - 1; }
        push(code, 65); push(code, 90);                                      // pop r10 (fnptr)
        _emit_aligned_call_r10(code);
        return true;
    }
    // IEEE-754 double C-ABI calls (e.g. libm.so.6 sqrt/hypot/pow): int args → xmm0[,xmm1] → call → int64 rax.
    if nm == "dl_call_f64_1" and na == 2 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);           // push fnptr
        _ge_rax(node.args[1], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 199);                    // mov rdi, rax
        push(code, 65); push(code, 90);                                      // pop r10 (fnptr)
        push(code, 83); push(code, 72); push(code, 137); push(code, 227);    // push rbx; mov rbx, rsp
        push(code, 72); push(code, 131); push(code, 228); push(code, 240);   // and rsp, -16
        push(code, 242); push(code, 72); push(code, 15); push(code, 42); push(code, 199); // cvtsi2sd xmm0, rdi
        push(code, 184); _elf.le(code, 1, 4);                                // mov eax, 1 (1 xmm reg)
        push(code, 65); push(code, 255); push(code, 210);                    // call r10
        push(code, 242); push(code, 72); push(code, 15); push(code, 45); push(code, 192); // cvtsd2si rax, xmm0
        push(code, 72); push(code, 137); push(code, 220); push(code, 91);    // mov rsp, rbx; pop rbx
        return true;
    }
    if nm == "dl_call_f64_2" and na == 3 {
        _ge_rax(node.args[0], code, slots, calls); push(code, 80);           // push fnptr
        _ge_rax(node.args[1], code, slots, calls); push(code, 80);           // push arg0
        _ge_rax(node.args[2], code, slots, calls);
        push(code, 72); push(code, 137); push(code, 198);                    // mov rsi, rax (arg1)
        push(code, 95);                                                      // pop rdi (arg0)
        push(code, 65); push(code, 90);                                      // pop r10 (fnptr)
        push(code, 83); push(code, 72); push(code, 137); push(code, 227);    // push rbx; mov rbx, rsp
        push(code, 72); push(code, 131); push(code, 228); push(code, 240);   // and rsp, -16
        push(code, 242); push(code, 72); push(code, 15); push(code, 42); push(code, 199); // cvtsi2sd xmm0, rdi
        push(code, 242); push(code, 72); push(code, 15); push(code, 42); push(code, 206); // cvtsi2sd xmm1, rsi
        push(code, 184); _elf.le(code, 2, 4);                                // mov eax, 2 (2 xmm regs)
        push(code, 65); push(code, 255); push(code, 210);                    // call r10
        push(code, 242); push(code, 72); push(code, 15); push(code, 45); push(code, 192); // cvtsd2si rax, xmm0
        push(code, 72); push(code, 137); push(code, 220); push(code, 91);    // mov rsp, rbx; pop rbx
        return true;
    }
    return false;
}

// GLOBAL variables (top-level let/const) live at a FIXED heap address so every function can reach them by
// absolute address (there is no register to spare for a globals base). The heap is mmap'd MAP_FIXED at
// _GBASE, with the first nglobals*8 bytes reserved for globals; global #idx is at [_GBASE + idx*8].
//
// WHY 0x4000_0000_0000 (64 TiB) and not a low address: values and heap pointers share one 64-bit slot, and the
// runtime tells them apart by a single range test "is x in [GBASE, GBASE+HEAPSZ)?" (used by the `+` string/number
// dispatch, ==, is_string/is_map, print). If a plain NUMBER lands in that window it is mistaken for a pointer and
// dereferenced → segfault. At the old base of 4 GiB that happened for any integer ≥ 4e9 (e.g. a running sum),
// crashing long loops. Pushing the arena to 64 TiB — still a canonical 47-bit user address MAP_FIXED can place —
// moves accidental collisions to 64 TiB, but user-controlled integers can still
// deliberately collide. Sound separation requires value tagging or another
// representation change. All base uses are 64-bit movabs; only the arena size
// uses a 32-bit immediate, bounded to 1 GiB.
fn _GBASE() { return 70368744177664; }   // 0x4000_0000_0000 (64 TiB); integers can still collide with this range
// Arena size (bytes). MAP_ANON is lazy → this is a VIRTUAL reservation; RSS only grows with pages actually
// written. 1 GiB gives long self-hosting loops headroom; arena_mark/arena_reset reclaim within it. The
// is_type heap-membership check uses this exact bound, so both read it from here (they must never drift).
let _heap_state = map{ bytes: 1073741824 };
fn _HEAPSZ() { return _heap_state.bytes; }
fn heap_reserve_bytes() { return _heap_state.bytes; }
fn set_heap_reserve(bytes) {
    if not is_number(bytes) { throw "codegen: heap reserve must be a byte count"; }
    let n = try num_floor(bytes) catch 0;
    let valid = try n >= 1048576 and n <= 1073741824 catch false;
    if not valid { throw "codegen: heap reserve must be between 1 MiB and 1 GiB"; }
    n = num_floor((n + 4095) / 4096) * 4096;
    let rounded_valid = try n >= 1048576 and n <= 1073741824 and n % 4096 == 0 catch false;
    if not rounded_valid { throw "codegen: invalid rounded heap reserve"; }
    _heap_state.bytes = n;
    return n;
}
fn _emit_global_load(code, idx) {
    push(code, 72); push(code, 184); _elf.le(code, _GBASE() + idx * 8, 8);   // movabs rax, GBASE+idx*8
    push(code, 72); push(code, 139); push(code, 0);                          // mov rax, [rax]
}
fn _emit_global_store(code, idx) {
    push(code, 72); push(code, 185); _elf.le(code, _GBASE() + idx * 8, 8);   // movabs rcx, GBASE+idx*8
    push(code, 72); push(code, 137); push(code, 1);                          // mov [rcx], rax
