        if k == "let" or k == "const" or k == "return" or k == "print" { let v = try s.value catch nil; if v != nil { _fl_expr(v, out); } }
        if k == "expr_stmt" { _fl_expr(s.expr, out); }
        if k == "assign" { _fl_expr(s.value, out); }
        if k == "block" { _funlit_idents_stmts(_stmts_of2(s), out); }
        if k == "if" { _fl_expr(s.cond, out); _funlit_idents_stmts(_stmts_of2(s.then), out); let e = try s.else catch nil; if e != nil { _funlit_idents_stmts(_stmts_of2(e), out); } let ei = try s.elifs catch nil; if ei != nil { let j = 0; while j < len(ei) { _fl_expr(ei[j].cond, out); _funlit_idents_stmts(_stmts_of2(ei[j].body), out); j = j + 1; } } }
