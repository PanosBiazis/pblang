// Emit, at startup, one NUL-terminated tagged heap string [TAG_STR, len, bytes@16, 0] into the arena.
fn _emit_intern_one(code, s, slotaddr) {
    let bytes = str_to_bytes(s); let sl = len(bytes);
    let alloc = 16 + sl + 1; let rr = alloc % 8; if rr != 0 { alloc = alloc + (8 - rr); }
    push(code, 76); push(code, 137); push(code, 248);                        // mov rax, r15   (string base)
    push(code, 73); push(code, 129); push(code, 199); _elf.le(code, alloc, 4);  // add r15, alloc
    push(code, 72); push(code, 199); push(code, 0); _elf.le(code, 1, 4);     // mov qword [rax], TAG_STR
    push(code, 72); push(code, 199); push(code, 64); push(code, 8); _elf.le(code, sl, 4); // mov qword [rax+8], len
    let j = 0;
    while j < sl { push(code, 198); push(code, 128); _elf.le(code, 16 + j, 4); push(code, bytes[j]); j = j + 1; } // mov byte [rax+16+j], b
    push(code, 198); push(code, 128); _elf.le(code, 16 + sl, 4); push(code, 0); // mov byte [rax+16+sl], 0
