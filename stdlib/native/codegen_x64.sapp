    if k == "ident" { score[node.name] = (try score[node.name] catch 0) + w; return nil; }
    if k == "binary" { _score_expr(node.left, w, score); _score_expr(node.right, w, score); return nil; }
    if k == "unary" { _score_expr(node.operand, w, score); return nil; }
    if k == "assign" { score[node.name] = (try score[node.name] catch 0) + w; _score_expr(node.value, w, score); return nil; }
    if k == "call" { let a = node.args; let i = 0; while i < len(a) { _score_expr(a[i], w, score); i = i + 1; } return nil; }
    if k == "index" { _score_expr(node.obj, w, score); _score_expr(node.index, w, score); return nil; }
    if k == "member" { _score_expr(node.obj, w, score); return nil; }
    if k == "array" { let it = node.items; let i = 0; while i < len(it) { _score_expr(it[i], w, score); i = i + 1; } return nil; }
    if k == "if_expr" { _score_expr(node.cond, w, score); _score_expr(try node.then catch nil, w, score); _score_expr(try node.else catch nil, w, score); return nil; }
