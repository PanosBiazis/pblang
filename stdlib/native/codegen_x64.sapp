}
// Callee-saved spills now live at the TOP of the frame, as reserved slot `idx` ([rbp-8*(idx+1)] = _slot_disp(idx)),
// so they are COUNTED in slots.n and the frame can be sized exactly (was pinned at a fixed [rbp-512+…], which
// forced every frame to a flat 512B). Prologues reserve the first _regsave_reserve() slots for these.
fn _reg_save(code, idx) {  // [rbp-8*(idx+1)] = r(12+idx)
    if idx == 0 { push(code, 76); push(code, 137); push(code, 165); }        // mov [rbp+d], r12
    else { if idx == 1 { push(code, 76); push(code, 137); push(code, 173); } // r13
    else { push(code, 76); push(code, 137); push(code, 181); } }             // r14
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(idx));
}
fn _reg_restore(code, idx) {  // r(12+idx) = [rbp-8*(idx+1)]
    if idx == 0 { push(code, 76); push(code, 139); push(code, 165); }        // mov r12, [rbp+d]
    else { if idx == 1 { push(code, 76); push(code, 139); push(code, 173); } // r13
    else { push(code, 76); push(code, 139); push(code, 181); } }             // r14
    let at = len(code); _elf.le(code, 0, 4); _patch32(code, at, _slot_disp(idx));
}
// How many top slots a prologue must reserve for callee-saved spills: the register-var count, bumped to 3 when
// r14 is used as the expression temp (r14 spills to slot index 2). 0 → the fn saves no callee-saved regs.
fn _regsave_reserve(slots) {
    let r = _reg_count(slots);
    if _uses_r14_tmp(slots) and r < 3 { r = 3; }
    return r;
}
