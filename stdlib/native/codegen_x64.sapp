}
// Helper: write `r13` bytes starting at `r14` to file path C-string `rdi` (mode 0755 = 493 so emitted ELFs can run or chmod).
fn _emit_write_raw_buf(code) {
    // expects rdi = path cstr, r14 = buf, r13 = len; pops r14, r13, r12 and returns 1/0 in rax.
    push(code, 190); _elf.le(code, 577, 4);                                  // mov esi, O_WRONLY|O_CREAT|O_TRUNC
    push(code, 186); _elf.le(code, 420, 4);                                  // mov edx, 0644
    push(code, 184); _elf.le(code, 2, 4);                                    // mov eax, 2 (SYS_open)
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 133); push(code, 192);                        // test rax, rax
    push(code, 15); push(code, 136); let jerr = len(code); _elf.le(code, 0, 4);
    push(code, 73); push(code, 137); push(code, 196);                        // mov r12, rax (fd)
    let wlp = len(code);
    push(code, 77); push(code, 133); push(code, 237);                        // .wlp: test r13, r13
    push(code, 116); push(code, 25);                                         // jz .wdone (+25)
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12 (3B)
    push(code, 76); push(code, 137); push(code, 246);                        // mov rsi, r14 (3B)
    push(code, 76); push(code, 137); push(code, 234);                        // mov rdx, r13 (3B)
    push(code, 184); _elf.le(code, 1, 4);                                    // mov eax, 1   (5B)
    push(code, 15); push(code, 5);                                           // syscall      (2B)
    push(code, 72); push(code, 133); push(code, 192);                        // test rax,rax (3B)
    push(code, 126); push(code, 8);                                          // jle .wdone   (2B)
    push(code, 73); push(code, 1); push(code, 198);                          // add r14, rax (3B)
    push(code, 73); push(code, 41); push(code, 197);                         // sub r13, rax (3B)
    push(code, 235); push(code, wlp - (len(code) + 1) + 256);                // jmp .wlp     (2B)
    code[wlp + 4] = len(code) - (wlp + 5);                                   // patch jz .wdone
    code[len(code) - 9] = len(code) - (len(code) - 8);                       // patch jle .wdone
    // .wdone:
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12
    push(code, 184); _elf.le(code, 3, 4);                                    // mov eax, 3 (SYS_close)
    push(code, 15); push(code, 5);
    push(code, 184); _elf.le(code, 1, 4);                                    // mov eax, 1
    push(code, 65); push(code, 94); push(code, 65); push(code, 93); push(code, 65); push(code, 92);
    push(code, 195);
    _patch32(code, jerr, len(code) - (jerr + 4));
    push(code, 49); push(code, 192);
    push(code, 65); push(code, 94); push(code, 65); push(code, 93); push(code, 65); push(code, 92);
    push(code, 195);
}
// __pb_fs_write: rdi = path TAG_STR, rsi = content TAG_STR
fn _emit_rt_fs_write(code) {
    let off = len(code);
    push(code, 65); push(code, 84); push(code, 65); push(code, 85); push(code, 65); push(code, 86); // push r12, r13, r14
    push(code, 76); push(code, 139); push(code, 110); push(code, 8);         // mov r13, [rsi+8] (len)
    push(code, 76); push(code, 141); push(code, 118); push(code, 16);        // lea r14, [rsi+16] (bytes)
    push(code, 72); push(code, 141); push(code, 127); push(code, 16);        // lea rdi, [rdi+16] (path cstr)
    _emit_write_raw_buf(code);
    return off;
}
// __pb_fs_write_bytes: rdi = path TAG_STR, rsi = byte TAG_ARR (packs bytes into scratch [r15..r15+len) without leaking r15)
fn _emit_rt_fs_write_bytes(code) {
    let off = len(code);
    push(code, 65); push(code, 84); push(code, 65); push(code, 85); push(code, 65); push(code, 86); // push r12, r13, r14
    push(code, 76); push(code, 139); push(code, 110); push(code, 8);         // mov r13, [rsi+8]  (len)
    push(code, 72); push(code, 139); push(code, 118); push(code, 24);        // mov rsi, [rsi+24] (dataptr)
    push(code, 77); push(code, 137); push(code, 254);                        // mov r14, r15      (scratch byte buf)
    push(code, 76); push(code, 137); push(code, 233);                        // mov rcx, r13
    push(code, 76); push(code, 137); push(code, 242);                        // mov rdx, r14
    push(code, 72); push(code, 133); push(code, 201);                        // test rcx, rcx
    push(code, 116); push(code, 17);                                         // jz .packed (+17)
    push(code, 72); push(code, 139); push(code, 6);                          // .pk: mov rax, [rsi]
    push(code, 136); push(code, 2);                                          // mov [rdx], al
    push(code, 72); push(code, 131); push(code, 198); push(code, 8);         // add rsi, 8
    push(code, 72); push(code, 255); push(code, 194);                        // inc rdx
    push(code, 72); push(code, 255); push(code, 201);                        // dec rcx
    push(code, 117); push(code, 239);                                        // jnz .pk (-17)
    push(code, 72); push(code, 141); push(code, 127); push(code, 16);        // .packed: lea rdi, [rdi+16]
    _emit_write_raw_buf(code);
    return off;
}
// __pb_tcp_listen: rdi = port → returns listen_fd or -1 on error.
fn _emit_rt_tcp_listen(code) {
    let off = len(code);
    push(code, 65); push(code, 84);                                          // push r12
    push(code, 87);                                                          // push rdi (port)
    push(code, 191); _elf.le(code, 2, 4);                                    // mov edi, 2 (AF_INET)
    push(code, 190); _elf.le(code, 1, 4);                                    // mov esi, 1 (SOCK_STREAM)
    push(code, 49); push(code, 210);                                         // xor edx, edx
    push(code, 184); _elf.le(code, 41, 4);                                   // mov eax, 41 (SYS_socket)
    push(code, 15); push(code, 5);
    push(code, 89);                                                          // pop rcx (port)
    push(code, 72); push(code, 133); push(code, 192);                        // test rax, rax
    push(code, 15); push(code, 136); let jfe = len(code); _elf.le(code, 0, 4);
    push(code, 73); push(code, 137); push(code, 196);                        // mov r12, rax (fd)
    push(code, 81);                                                          // push rcx (port)
    push(code, 72); push(code, 131); push(code, 236); push(code, 16);        // sub rsp, 16
    push(code, 199); push(code, 4); push(code, 36); _elf.le(code, 1, 4);     // mov dword [rsp], 1
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12
    push(code, 190); _elf.le(code, 1, 4);                                    // SOL_SOCKET
    push(code, 186); _elf.le(code, 2, 4);                                    // SO_REUSEADDR
    push(code, 73); push(code, 137); push(code, 226);                        // mov r10, rsp
    push(code, 65); push(code, 184); _elf.le(code, 4, 4);                    // mov r8d, 4
    push(code, 184); _elf.le(code, 54, 4);                                   // SYS_setsockopt
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 131); push(code, 196); push(code, 16);        // add rsp, 16
    push(code, 89);                                                          // pop rcx (port)
    push(code, 72); push(code, 131); push(code, 236); push(code, 16);        // sub rsp, 16 (sockaddr_in)
    push(code, 49); push(code, 192);
    push(code, 72); push(code, 137); push(code, 4); push(code, 36);
    push(code, 72); push(code, 137); push(code, 68); push(code, 36); push(code, 8);
    push(code, 198); push(code, 4); push(code, 36); push(code, 2);           // sin_family = AF_INET (2)
    push(code, 136); push(code, 76); push(code, 36); push(code, 3);          // [rsp+3] = port & 0xFF
    push(code, 193); push(code, 233); push(code, 8);                         // shr ecx, 8
    push(code, 136); push(code, 76); push(code, 36); push(code, 2);          // [rsp+2] = (port >> 8) & 0xFF
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12
    push(code, 72); push(code, 137); push(code, 230);                        // mov rsi, rsp
    push(code, 186); _elf.le(code, 16, 4);
    push(code, 184); _elf.le(code, 49, 4);                                   // SYS_bind
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 131); push(code, 196); push(code, 16);        // add rsp, 16
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 136); let jcf1 = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 137); push(code, 231);                        // mov rdi, r12
    push(code, 190); _elf.le(code, 16, 4);
    push(code, 184); _elf.le(code, 50, 4);                                   // SYS_listen
    push(code, 15); push(code, 5);
    push(code, 72); push(code, 133); push(code, 192);
    push(code, 15); push(code, 136); let jcf2 = len(code); _elf.le(code, 0, 4);
    push(code, 76); push(code, 137); push(code, 224);                        // mov rax, r12
    push(code, 65); push(code, 92);                                          // pop r12
    push(code, 195);
    _patch32(code, jcf1, len(code) - (jcf1 + 4));
    _patch32(code, jcf2, len(code) - (jcf2 + 4));
    push(code, 76); push(code, 137); push(code, 231);
    push(code, 184); _elf.le(code, 3, 4);
    push(code, 15); push(code, 5);
