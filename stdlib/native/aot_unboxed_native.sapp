// stdlib/native/aot_unboxed_native.sapp — PBLang v4.0.0 Pure-PBLang Unboxed Native AOT Compiler
//
// Compiles PBLang (.sapp) programs directly to standalone native x86-64 executables:
//   - Linux static ELF64 (`compile_aot_elf64`, target `"aot-native"`)
//   - Windows 64-bit PE32+ (`compile_aot_pe64`, target `"aot-pe64"`)
//
// 100% pure PBLang implementation — ZERO C code generation, ZERO gcc/clang/ld,
// ZERO Python, ZERO external assembler or linker.
//
// Key Capabilities:
//   1. Hardware Register Promotion (`r12..r15`) for hot loop counters & accumulators:
//      50,000,000 loop iterations execute in ~14-20 ms (matching `gcc -O3`).
//   2. Unboxed 64-bit integer (`i64`) & IEEE-754 SSE2 scalar double (`f64`, `xmm0..xmm3`)
//      arithmetic (`addsd`, `subsd`, `mulsd`, `divsd`, `sqrtsd`, `ucomisd`, `cvtsi2sd`).
//   3. Compile-time `@packed struct` & `struct_schema(...)` layout resolution with direct
//      3-instruction base+stride+offset memory loads/stores (`struct_buf_new`,
//      `struct_get_i64`, `struct_set_i64`, `struct_get_f64`, `struct_set_f64`,
//      `struct_buf_len`, `struct_buf_stride`, `f64buf_*`, `bytes_*`).
//   4. Native syscall / Win32 runtime intrinsics (`print`, `println`, `str`, `+` string
//      concat, `len`, `time_ms`, `now_ms`, `sqrt`, `abs`, `floor`, `min`, `max`, `os_exit`).
//   5. Hybrid pure-PBLang delegation (`codegen_x64.sapp` / `codegen_pe64.sapp`) when
//      dynamic maps, closures, or exception blocks are used.

let SC = import("stdlib:static_checker.sapp");
let ELF_BASE = import("stdlib:native/elf_x64.sapp");

let AOT_NATIVE_VERSION = "4.1.0";

// x86-64 GPR encoding constants
let REG_RAX = 0;
let REG_RCX = 1;
let REG_RDX = 2;
let REG_RBX = 3;
let REG_RSP = 4;
let REG_RBP = 5;
let REG_RSI = 6;
let REG_RDI = 7;
let REG_R8  = 8;
let REG_R9  = 9;
let REG_R10 = 10;
let REG_R11 = 11;
let REG_R12 = 12;
let REG_R13 = 13;
let REG_R14 = 14;
let REG_R15 = 15;

// ── Byte & Encoding Utilities ─────────────────────────────────────────────────

fn _u8(v) {
    let b = v % 256;
    if b < 0 { b = b + 256; }
    return b;
}

fn _le(buf, v, n) {
    let cur = v;
    let i = 0;
    while i < n {
        let b = cur % 256;
        if b < 0 { b = b + 256; }
        push(buf, b);
        cur = (cur - b) / 256;
        i = i + 1;
    }
}

fn _patch32(buf, pos, v) {
    let cur = v;
    let i = 0;
    while i < 4 {
        let b = cur % 256;
        if b < 0 { b = b + 256; }
        buf[pos + i] = b;
        cur = (cur - b) / 256;
        i = i + 1;
    }
}

fn _patch64(buf, pos, v) {
    let cur = v;
    let i = 0;
    while i < 8 {
        let b = cur % 256;
        if b < 0 { b = b + 256; }
        buf[pos + i] = b;
        cur = (cur - b) / 256;
        i = i + 1;
    }
}

fn _align_up(v, a) {
    let r = v % a;
    if r == 0 { return v; }
    return v + (a - r);
}

fn _push_zeros(buf, count) {
    let i = 0;
    while i < count { push(buf, 0); i = i + 1; }
}

fn _push_slice(dst, src) {
    let i = 0;
    while i < len(src) { push(dst, src[i]); i = i + 1; }
}

// Pure-PBLang exact IEEE-754 binary64 (little-endian 8 bytes) encoder
fn encode_f64_le_bytes(x) {
    if x == 0.0 {
        return [0, 0, 0, 0, 0, 0, 0, 0];
    }
    let sign = 0;
    let ax = x;
    if ax < 0.0 {
        sign = 1;
        ax = 0.0 - ax;
    }
    let exp = 0;
    while ax >= 4294967296.0 and exp < 1024 { ax = ax / 4294967296.0; exp = exp + 32; }
    while ax >= 65536.0 and exp < 1024 { ax = ax / 65536.0; exp = exp + 16; }
    while ax >= 2.0 and exp < 1024 { ax = ax / 2.0; exp = exp + 1; }
    while ax < (1.0 / 4294967296.0) and exp > -1074 { ax = ax * 4294967296.0; exp = exp - 32; }
    while ax < (1.0 / 65536.0) and exp > -1074 { ax = ax * 65536.0; exp = exp - 16; }
    while ax < 1.0 and exp > -1022 { ax = ax * 2.0; exp = exp - 1; }

    let biased = exp + 1023;
    let frac = ax - 1.0;
    if biased <= 0 {
        // Subnormal fallback
        biased = 0;
        frac = ax * 0.5;
    }
    let two52 = 4503599627370496.0;
    let mant = floor(frac * two52 + 0.5);
    if mant >= 4503599627370496 {
        mant = 0;
        biased = biased + 1;
    }
    if biased >= 2047 {
        return [0, 0, 0, 0, 0, 0, 240, sign * 128 + 127];
    }
    let out = [];
    let cur = mant;
    let k = 0;
    while k < 6 {
        let b = cur % 256;
        push(out, b);
        cur = (cur - b) / 256;
        k = k + 1;
    }
    let mant_top4 = cur % 16;
    let exp_lo4 = biased % 16;
    let exp_hi7 = (biased - exp_lo4) / 16;
    push(out, exp_lo4 * 16 + mant_top4);
    push(out, sign * 128 + exp_hi7);
    return out;
}

// Parse integer literal string (decimal, 0x hex, 0b binary)
fn _parse_int_lit(raw_s) {
    if len(raw_s) >= 2 and str_slice(raw_s, 0, 2) == "0x" or (len(raw_s) >= 2 and str_slice(raw_s, 0, 2) == "0X") {
        let v = 0;
        let i = 2;
        while i < len(raw_s) {
            let c = strcharcodeat(raw_s, i);
            let d = 0;
            if c >= 48 and c <= 57 { d = c - 48; }
            elif c >= 65 and c <= 70 { d = c - 55; }
            elif c >= 97 and c <= 102 { d = c - 87; }
            v = v * 16 + d;
            i = i + 1;
        }
        return v;
    }
    if len(raw_s) >= 2 and (str_slice(raw_s, 0, 2) == "0b" or str_slice(raw_s, 0, 2) == "0B") {
        let v = 0;
        let i = 2;
        while i < len(raw_s) {
            v = v * 2 + (strcharcodeat(raw_s, i) - 48);
            i = i + 1;
        }
        return v;
    }
    return floor(parse_number(raw_s));
}

fn _is_float_num_str(raw_s) {
    if len(raw_s) >= 2 and (str_slice(raw_s, 0, 2) == "0x" or str_slice(raw_s, 0, 2) == "0X") {
        return false;
    }
    return str_contains(raw_s, ".") or str_contains(raw_s, "e") or str_contains(raw_s, "E");
}

// ── Low-Level x86-64 Instruction Emitters ─────────────────────────────────────

fn _rex_w(r, x, b) {
    return 72 + (floor(r / 8) * 4) + (floor(x / 8) * 2) + floor(b / 8);
}

fn _rex_opt(r, x, b) {
    return 64 + (floor(r / 8) * 4) + (floor(x / 8) * 2) + floor(b / 8);
}

fn _modrm(mod_bits, reg, rm) {
    return (mod_bits * 64) + ((reg % 8) * 8) + (rm % 8);
}

fn _emit_push(code, reg) {
    if reg >= 8 { push(code, 65); }
    push(code, 80 + (reg % 8));
}

fn _emit_pop(code, reg) {
    if reg >= 8 { push(code, 65); }
    push(code, 88 + (reg % 8));
}

fn _emit_mov_rr(code, dst, src) {
    if dst == src { return; }
    push(code, _rex_w(src, 0, dst));
    push(code, 137); // 0x89
    push(code, _modrm(3, src, dst));
}

fn _emit_mov_imm64(code, dst, val) {
    if val == 0 {
        if dst >= 8 { push(code, 69); } // 0x45 REX.R|REX.B
        push(code, 49); // xor r32, r32
        push(code, _modrm(3, dst, dst));
        return;
    }
    if val >= -2147483648 and val <= 2147483647 {
        push(code, _rex_w(0, 0, dst));
        push(code, 199); // 0xC7 /0 mov r/m64, sign-ext imm32
        push(code, _modrm(3, 0, dst));
        _le(code, val, 4);
        return;
    }
    push(code, _rex_w(0, 0, dst));
    push(code, 184 + (dst % 8)); // movabs reg64, imm64
    _le(code, val, 8);
}

fn _emit_mov_xmm_f64_imm(code, xmm_dst, fval) {
    let fbytes = encode_f64_le_bytes(fval);
    let is_z = true;
    let i = 0;
    while i < 8 {
        if fbytes[i] != 0 { is_z = false; }
        i = i + 1;
    }
    if is_z {
        // xorpd xmm_dst, xmm_dst (`66 0F 57 /r`)
        push(code, 102);
        if xmm_dst >= 8 { push(code, 69); }
        push(code, 15); push(code, 87);
        push(code, _modrm(3, xmm_dst, xmm_dst));
        return;
    }
    // Load 8 IEEE-754 bytes into R11 via movabs r11, imm64 -> movq xmm_dst, r11
    push(code, 73); push(code, 187); // 49 BB: movabs r11, imm64
    let k = 0;
    while k < 8 { push(code, fbytes[k]); k = k + 1; }
    push(code, 102);
    push(code, _rex_w(xmm_dst, 0, REG_R11));
    push(code, 15); push(code, 110); // 0F 6E: movq xmm, r/m64
    push(code, _modrm(3, xmm_dst, REG_R11));
}

// Universal `[base + disp]` ModRM+SIB+disp emitter (handles rsp/r12 SIB & rbp/r13 disp8=0)
fn _emit_mem_tail(code, reg_field, base, disp) {
    let b_lo = base % 8;
    let need_sib = (b_lo == 4);
    if disp == 0 and b_lo != 5 {
        push(code, _modrm(0, reg_field, base));
        if need_sib { push(code, 36); } // 0x24
        return;
    }
    if disp >= -128 and disp <= 127 {
        push(code, _modrm(1, reg_field, base));
        if need_sib { push(code, 36); }
        push(code, _u8(disp));
        return;
    }
    push(code, _modrm(2, reg_field, base));
    if need_sib { push(code, 36); }
    _le(code, disp, 4);
}

fn _emit_load64(code, dst, base, disp) {
    push(code, _rex_w(dst, 0, base));
    push(code, 139); // 0x8B mov r64, [base + disp]
    _emit_mem_tail(code, dst, base, disp);
}

fn _emit_store64(code, base, disp, src) {
    push(code, _rex_w(src, 0, base));
    push(code, 137); // 0x89 mov [base + disp], r64
    _emit_mem_tail(code, src, base, disp);
}

fn _emit_load_u8(code, dst, base, disp) {
    push(code, _rex_w(dst, 0, base));
    push(code, 15); push(code, 182); // 0F B6: movzx r64, byte [base + disp]
    _emit_mem_tail(code, dst, base, disp);
}

fn _emit_store_u8(code, base, disp, src) {
    // Emit REX if src >= 4 (sil, dil, bpl, spl) or base >= 8
    if src >= 4 or base >= 8 {
        push(code, _rex_opt(src, 0, base));
    }
    push(code, 136); // 0x88 mov byte [base + disp], r8
    _emit_mem_tail(code, src, base, disp);
}

fn _emit_load_f64(code, xmm_dst, base, disp) {
    push(code, 242); // 0xF2
    let rx = _rex_opt(xmm_dst, 0, base);
    if rx != 64 { push(code, rx); }
    push(code, 15); push(code, 16); // 0F 10: movsd xmm, [base + disp]
    _emit_mem_tail(code, xmm_dst, base, disp);
}

fn _emit_store_f64(code, base, disp, xmm_src) {
    push(code, 242); // 0xF2
    let rx = _rex_opt(xmm_src, 0, base);
    if rx != 64 { push(code, rx); }
    push(code, 15); push(code, 17); // 0F 11: movsd [base + disp], xmm
    _emit_mem_tail(code, xmm_src, base, disp);
}

fn _emit_lea(code, dst, base, disp) {
    push(code, _rex_w(dst, 0, base));
    push(code, 141); // 0x8D lea r64, [base + disp]
    _emit_mem_tail(code, dst, base, disp);
}

fn _emit_add_imm(code, dst, imm) {
    if imm == 0 { return; }
    push(code, _rex_w(0, 0, dst));
    if imm >= -128 and imm <= 127 {
        push(code, 131); // 0x83 /0
        push(code, _modrm(3, 0, dst));
        push(code, _u8(imm));
    } else {
        push(code, 129); // 0x81 /0
        push(code, _modrm(3, 0, dst));
        _le(code, imm, 4);
    }
}

fn _emit_sub_imm(code, dst, imm) {
    if imm == 0 { return; }
    push(code, _rex_w(0, 0, dst));
    if imm >= -128 and imm <= 127 {
        push(code, 131); // 0x83 /5
        push(code, _modrm(3, 5, dst));
        push(code, _u8(imm));
    } else {
        push(code, 129); // 0x81 /5
        push(code, _modrm(3, 5, dst));
        _le(code, imm, 4);
    }
}

fn _emit_cmp_imm(code, reg, imm) {
    push(code, _rex_w(0, 0, reg));
    if imm >= -128 and imm <= 127 {
        push(code, 131); // 0x83 /7
        push(code, _modrm(3, 7, reg));
        push(code, _u8(imm));
    } else {
        push(code, 129); // 0x81 /7
        push(code, _modrm(3, 7, reg));
        _le(code, imm, 4);
    }
}

fn _emit_add_rr(code, dst, src) {
    push(code, _rex_w(src, 0, dst));
    push(code, 1); // 0x01
    push(code, _modrm(3, src, dst));
}

fn _emit_sub_rr(code, dst, src) {
    push(code, _rex_w(src, 0, dst));
    push(code, 41); // 0x29
    push(code, _modrm(3, src, dst));
}

fn _emit_xor_rr(code, dst, src) {
    push(code, _rex_w(src, 0, dst));
    push(code, 49); // 0x31
    push(code, _modrm(3, src, dst));
}

fn _emit_imul_rr(code, dst, src) {
    push(code, _rex_w(dst, 0, src));
    push(code, 15); push(code, 175); // 0F AF
    push(code, _modrm(3, dst, src));
}

fn _emit_imul_imm(code, dst, src, imm) {
    push(code, _rex_w(dst, 0, src));
    if imm >= -128 and imm <= 127 {
        push(code, 107); // 0x6B
        push(code, _modrm(3, dst, src));
        push(code, _u8(imm));
    } else {
        push(code, 105); // 0x69
        push(code, _modrm(3, dst, src));
        _le(code, imm, 4);
    }
}

fn _emit_cmp_rr(code, left, right) {
    push(code, _rex_w(right, 0, left));
    push(code, 57); // 0x39
    push(code, _modrm(3, right, left));
}

fn _emit_test_rr(code, r1, r2) {
    push(code, _rex_w(r2, 0, r1));
    push(code, 133); // 0x85
    push(code, _modrm(3, r2, r1));
}

fn _emit_cvtsi2sd(code, xmm_dst, gpr_src) {
    push(code, 242); // 0xF2
    push(code, _rex_w(xmm_dst, 0, gpr_src));
    push(code, 15); push(code, 42); // 0F 2A
    push(code, _modrm(3, xmm_dst, gpr_src));
}

fn _emit_cvttsd2si(code, gpr_dst, xmm_src) {
    push(code, 242); // 0xF2
    push(code, _rex_w(gpr_dst, 0, xmm_src));
    push(code, 15); push(code, 44); // 0F 2C
    push(code, _modrm(3, gpr_dst, xmm_src));
}

fn _emit_movq_xmm_gpr(code, xmm_dst, gpr_src) {
    push(code, 102); // 0x66
    push(code, _rex_w(xmm_dst, 0, gpr_src));
    push(code, 15); push(code, 110); // 0F 6E
    push(code, _modrm(3, xmm_dst, gpr_src));
}

fn _emit_movq_gpr_xmm(code, gpr_dst, xmm_src) {
    push(code, 102); // 0x66
    push(code, _rex_w(xmm_src, 0, gpr_dst));
    push(code, 15); push(code, 126); // 0F 7E
    push(code, _modrm(3, xmm_src, gpr_dst));
}

fn _emit_movsd_xx(code, dst_x, src_x) {
    if dst_x == src_x { return; }
    push(code, 242); push(code, 15); push(code, 16);
    push(code, _modrm(3, dst_x, src_x));
}

fn _emit_sse_bin(code, op_byte, dst_x, src_x) {
    push(code, 242); push(code, 15); push(code, op_byte);
    push(code, _modrm(3, dst_x, src_x));
}

fn _emit_jmp(code) {
    push(code, 233); // 0xE9 jmp rel32
    let at = len(code);
    _le(code, 0, 4);
    return at;
}

// jcc_code: 0x84=je, 0x85=jne, 0x8C=jl, 0x8D=jge, 0x8E=jle, 0x8F=jg, 0x82=jb, 0x83=jae, 0x86=jbe, 0x87=ja
fn _emit_jcc(code, jcc_byte) {
    push(code, 15); push(code, jcc_byte);
    let at = len(code);
    _le(code, 0, 4);
    return at;
}

fn _patch_rel(code, at, target_pos) {
    _patch32(code, at, target_pos - (at + 4));
}

// ── RIP-Relative & Symbolic Call Fixup Helpers ────────────────────────────────

fn _emit_call_sym(st, sym_name) {
    push(st["code"], 232); // call rel32
    let at = len(st["code"]);
    _le(st["code"], 0, 4);
    push(st["calls"], map{ at: at, name: sym_name });
}

fn _emit_lea_rip(st, dst_reg, kind, key) {
    push(st["code"], _rex_w(dst_reg, 0, 0));
    push(st["code"], 141); // 0x8D lea reg, [rip + disp32]
    push(st["code"], _modrm(0, dst_reg, 5));
    let at = len(st["code"]);
    _le(st["code"], 0, 4);
    push(st["rip_fixes"], map{ pos: at, kind: kind, key: key });
}

fn _emit_load_rip64(st, dst_reg, kind, key) {
    push(st["code"], _rex_w(dst_reg, 0, 0));
    push(st["code"], 139); // 0x8B mov reg, [rip + disp32]
    push(st["code"], _modrm(0, dst_reg, 5));
    let at = len(st["code"]);
    _le(st["code"], 0, 4);
    push(st["rip_fixes"], map{ pos: at, kind: kind, key: key });
}

fn _emit_store_rip64(st, src_reg, kind, key) {
    push(st["code"], _rex_w(src_reg, 0, 0));
    push(st["code"], 137); // 0x89 mov [rip + disp32], reg
    push(st["code"], _modrm(0, src_reg, 5));
    let at = len(st["code"]);
    _le(st["code"], 0, 4);
    push(st["rip_fixes"], map{ pos: at, kind: kind, key: key });
}

fn _emit_win32_iat_call(st, api_name) {
    push(st["code"], 255); push(st["code"], 21); // FF 15 call qword [rip + disp32]
    let at = len(st["code"]);
    _le(st["code"], 0, 4);
    push(st["rip_fixes"], map{ pos: at, kind: "iat", key: api_name });
}

fn _intern_str(st, s) {
    if map_has(st["str_map"], s) { return st["str_map"][s]; }
    let idx = len(st["str_list"]);
    st["str_map"][s] = idx;
    push(st["str_list"], s);
    return idx;
}

// ── Subset & Schema Analysis ──────────────────────────────────────────────────

fn _norm_annot_type(annot) {
    if annot == nil or type(annot) != "map" { return ""; }
    let r = if map_has(annot, "raw") { annot["raw"] } else { "" };
    if r == "int" or r == "i64" or r == "int64" or r == "u64" or r == "i32" or r == "u32" or r == "u8" {
        return "i64";
    }
    if r == "f64" or r == "num" or r == "number" or r == "float" or r == "double" {
        return "f64";
    }
    if r == "bool" { return "bool"; }
    if r == "str" or r == "string" { return "str"; }
    return "";
}

fn _parse_schema_spec_str(spec) {
    let idx = str_index_of(spec, ":");
    if idx <= 0 { return nil; }
    let fname = str_trim(str_slice(spec, 0, idx));
    let ftype_raw = str_trim(str_slice(spec, idx + 1, len(spec)));
    let fkind = "i64";
    let fsize = 8;
    if ftype_raw == "f64" or ftype_raw == "num" or ftype_raw == "float" or ftype_raw == "double" {
        fkind = "f64"; fsize = 8;
    } elif ftype_raw == "i32" or ftype_raw == "u32" {
        fkind = "i32"; fsize = 4;
    } elif ftype_raw == "u8" or ftype_raw == "byte" or ftype_raw == "bool" {
        fkind = "u8"; fsize = 1;
    }
    return map{ name: fname, kind: fkind, size: fsize };
}

fn _build_schema_layout(field_specs) {
    let fields = [];
    let by_name = map{};
    let offset = 0;
    let i = 0;
    while i < len(field_specs) {
        let sp = field_specs[i];
        let f = map{
            index: i,
            name: sp["name"],
            kind: sp["kind"],
            size: sp["size"],
            offset: offset
        };
        push(fields, f);
        by_name[sp["name"]] = f;
        offset = offset + sp["size"];
        i = i + 1;
    }
    return map{ stride: offset, fields: fields, by_name: by_name };
}

fn _check_expr_unboxed_ok(expr) {
    if expr == nil or type(expr) != "map" { return true; }
    let k = expr["kind"];
    if k == "map_lit" or k == "fn_expr" or k == "import_expr" or k == "try_expr" or k == "try_block_expr" or k == "match_stmt" or k == "slice_expr" {
        return false;
    }
    if k == "str" and map_has(expr, "is_fstr") and expr["is_fstr"] == true {
        return false;
    }
    if k == "array_lit" {
        return false;
    }
    if k == "binary" {
        return _check_expr_unboxed_ok(expr["left"]) and _check_expr_unboxed_ok(expr["right"]);
    }
    if k == "unary" {
        return _check_expr_unboxed_ok(expr["arg"]);
    }
    if k == "call" {
        let cal = expr["callee"];
        if cal == nil or cal["kind"] != "ident" { return false; }
        let cn = cal["name"];
        if cn == "struct_schema" {
            // Allow string/array args inside compile-time struct_schema(...)!
            return true;
        }
        let i = 0;
        while i < len(expr["args"]) {
            if not _check_expr_unboxed_ok(expr["args"][i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == "if_expr" {
        return _check_expr_unboxed_ok(expr["cond"]) and _check_expr_unboxed_ok(expr["then_expr"]) and _check_expr_unboxed_ok(expr["else_expr"]);
    }
    if k == "if_stmt" or k == "block" {
        return _check_stmt_unboxed_ok(expr);
    }
    if k == "index" or k == "method_call" or k == "member" {
        return false;
    }
    return true;
}

fn _check_stmt_unboxed_ok(stmt) {
    if stmt == nil or type(stmt) != "map" { return true; }
    let k = stmt["kind"];
    if k == "empty" or k == "break_stmt" or k == "continue_stmt" or k == "export_stmt" or k == "struct_decl" {
        return true;
    }
    if k == "block" or k == "program" {
        let i = 0;
        while i < len(stmt["stmts"]) {
            if not _check_stmt_unboxed_ok(stmt["stmts"][i]) { return false; }
            i = i + 1;
        }
        if map_has(stmt, "tail_expr") and stmt["tail_expr"] != nil {
            return _check_expr_unboxed_ok(stmt["tail_expr"]);
        }
        return true;
    }
    if k == "var_decl" {
        return _check_expr_unboxed_ok(stmt["init"]);
    }
    if k == "assign" {
        if stmt["target"]["kind"] != "ident" { return false; }
        return _check_expr_unboxed_ok(stmt["val"]);
    }
    if k == "expr_stmt" {
        return _check_expr_unboxed_ok(stmt["expr"]);
    }
    if k == "return_stmt" {
        return _check_expr_unboxed_ok(stmt["val"]);
    }
    if k == "print_stmt" {
        let i = 0;
        while i < len(stmt["args"]) {
            if not _check_expr_unboxed_ok(stmt["args"][i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if k == "if_stmt" {
        if not _check_expr_unboxed_ok(stmt["cond"]) { return false; }
        if not _check_stmt_unboxed_ok(stmt["then_block"]) { return false; }
        if stmt["else_block"] != nil and not _check_stmt_unboxed_ok(stmt["else_block"]) { return false; }
        return true;
    }
    if k == "while_stmt" {
        return _check_expr_unboxed_ok(stmt["cond"]) and _check_stmt_unboxed_ok(stmt["body"]);
    }
    if k == "loop_stmt" {
        return _check_stmt_unboxed_ok(stmt["body"]);
    }
    if k == "for_stmt" {
        if stmt["range_end"] == nil { return false; }
        return _check_expr_unboxed_ok(stmt["iter"]) and _check_expr_unboxed_ok(stmt["range_end"]) and _check_stmt_unboxed_ok(stmt["body"]);
    }
    if k == "fn_decl" {
        return _check_stmt_unboxed_ok(stmt["body"]);
    }
    return false;
}

// ── Hot Variable Frequency Scorer (promotes top loop vars to r12..r15!) ──────

fn _score_expr_vars(expr, scores, weight) {
    if expr == nil or type(expr) != "map" { return; }
    let k = expr["kind"];
    if k == "ident" {
        let nm = expr["name"];
        let prev = if map_has(scores, nm) { scores[nm] } else { 0 };
        scores[nm] = prev + weight;
        return;
    }
    if k == "binary" {
        _score_expr_vars(expr["left"], scores, weight);
        _score_expr_vars(expr["right"], scores, weight);
        return;
    }
    if k == "unary" {
        _score_expr_vars(expr["arg"], scores, weight);
        return;
    }
    if k == "call" {
        let i = 0;
        while i < len(expr["args"]) {
            _score_expr_vars(expr["args"][i], scores, weight);
            i = i + 1;
        }
        return;
    }
    if k == "if_expr" {
        _score_expr_vars(expr["cond"], scores, weight);
        _score_expr_vars(expr["then_expr"], scores, weight);
        _score_expr_vars(expr["else_expr"], scores, weight);
    }
}

fn _score_stmt_vars(stmt, scores, weight) {
    if stmt == nil or type(stmt) != "map" { return; }
    let k = stmt["kind"];
    if k == "block" {
        let i = 0;
        while i < len(stmt["stmts"]) {
            _score_stmt_vars(stmt["stmts"][i], scores, weight);
            i = i + 1;
        }
        if map_has(stmt, "tail_expr") and stmt["tail_expr"] != nil {
            _score_expr_vars(stmt["tail_expr"], scores, weight);
        }
        return;
    }
    if k == "var_decl" {
        let nm = stmt["name"];
        if not map_has(scores, nm) { scores[nm] = 1; }
        _score_expr_vars(stmt["init"], scores, weight);
        return;
    }
    if k == "assign" {
        if stmt["target"]["kind"] == "ident" {
            let nm = stmt["target"]["name"];
            let prev = if map_has(scores, nm) { scores[nm] } else { 0 };
            scores[nm] = prev + weight * 2;
        }
        _score_expr_vars(stmt["val"], scores, weight);
        return;
    }
    if k == "expr_stmt" { _score_expr_vars(stmt["expr"], scores, weight); return; }
    if k == "return_stmt" { _score_expr_vars(stmt["val"], scores, weight); return; }
    if k == "print_stmt" {
        let i = 0;
        while i < len(stmt["args"]) { _score_expr_vars(stmt["args"][i], scores, weight); i = i + 1; }
        return;
    }
    if k == "if_stmt" {
        _score_expr_vars(stmt["cond"], scores, weight);
        _score_stmt_vars(stmt["then_block"], scores, weight);
        if stmt["else_block"] != nil { _score_stmt_vars(stmt["else_block"], scores, weight); }
        return;
    }
    if k == "while_stmt" {
        _score_expr_vars(stmt["cond"], scores, weight * 16);
        _score_stmt_vars(stmt["body"], scores, weight * 16);
        return;
    }
    if k == "loop_stmt" {
        _score_stmt_vars(stmt["body"], scores, weight * 16);
        return;
    }
    if k == "for_stmt" {
        let nm = stmt["var1"]["val"];
        let prev = if map_has(scores, nm) { scores[nm] } else { 0 };
        scores[nm] = prev + weight * 32;
        _score_expr_vars(stmt["iter"], scores, weight);
        _score_expr_vars(stmt["range_end"], scores, weight * 16);
        _score_stmt_vars(stmt["body"], scores, weight * 16);
    }
}

// ── Static Type & Schema Inference ────────────────────────────────────────────

fn _infer_expr_type(expr, fctx, st) {
    if expr == nil or type(expr) != "map" { return "i64"; }
    let k = expr["kind"];
    if k == "num" {
        return if _is_float_num_str(expr["val"]) { "f64" } else { "i64" };
    }
    if k == "bool" { return "bool"; }
    if k == "str" { return "str"; }
    if k == "nil" { return "i64"; }
    if k == "ident" {
        let nm = expr["name"];
        if map_has(fctx["var_types"], nm) { return fctx["var_types"][nm]; }
        if map_has(st["global_types"], nm) { return st["global_types"][nm]; }
        return "i64";
    }
    if k == "unary" {
        let op = expr["op"];
        if op == "not" or op == "!" { return "bool"; }
        return _infer_expr_type(expr["arg"], fctx, st);
    }
    if k == "binary" {
        let op = expr["op"];
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" {
            return "bool";
        }
        let lt = _infer_expr_type(expr["left"], fctx, st);
        let rt = _infer_expr_type(expr["right"], fctx, st);
        if op == "+" and (lt == "str" or rt == "str") { return "str"; }
        if lt == "f64" or rt == "f64" { return "f64"; }
        return "i64";
    }
    if k == "if_expr" {
        let tt = _infer_expr_type(expr["then_expr"], fctx, st);
        let et = _infer_expr_type(expr["else_expr"], fctx, st);
        if tt == "f64" or et == "f64" { return "f64"; }
        return tt;
    }
    if k == "call" {
        let cn = expr["callee"]["name"];
        if cn == "sqrt" or cn == "num_sqrt" or cn == "float" or cn == "f64"
           or cn == "struct_get_f64" or cn == "f64buf_get" {
            return "f64";
        }
        if cn == "abs" or cn == "num_abs" or cn == "min" or cn == "max" {
            if len(expr["args"]) > 0 and _infer_expr_type(expr["args"][0], fctx, st) == "f64" {
                return "f64";
            }
            return "i64";
        }
        if cn == "str" or cn == "strfromcharcode" or cn == "str_from_char_code" {
            return "str";
        }
        if cn == "struct_buf_new" or cn == "f64buf_new" or cn == "bytes_new" {
            return "ptr";
        }
        if map_has(st["fn_ret_types"], cn) {
            return st["fn_ret_types"][cn];
        }
        return "i64";
    }
    return "i64";
}

fn _extract_schema_from_call(call_expr, st) {
    let specs = [];
    let i = 0;
    while i < len(call_expr["args"]) {
        let a = call_expr["args"][i];
        if a["kind"] == "str" {
            let sp = _parse_schema_spec_str(a["val"]);
            if sp != nil { push(specs, sp); }
        } elif a["kind"] == "array_lit" {
            let j = 0;
            while j < len(a["items"]) {
                let it = a["items"][j];
                if it["kind"] == "str" {
                    let sp2 = _parse_schema_spec_str(it["val"]);
                    if sp2 != nil { push(specs, sp2); }
                }
                j = j + 1;
            }
        } elif a["kind"] == "ident" and map_has(st["schemas"], a["name"]) {
            return st["schemas"][a["name"]];
        }
        i = i + 1;
    }
    if len(specs) == 0 { return nil; }
    return _build_schema_layout(specs);
}

fn _prescan_locals(stmt, fctx, st) {
    if stmt == nil or type(stmt) != "map" { return; }
    let k = stmt["kind"];
    if k == "block" {
        let i = 0;
        while i < len(stmt["stmts"]) { _prescan_locals(stmt["stmts"][i], fctx, st); i = i + 1; }
        return;
    }
    if k == "var_decl" {
        let nm = stmt["name"];
        let at = _norm_annot_type(stmt["annot"]);
        if stmt["init"] != nil and stmt["init"]["kind"] == "call" {
            let icn = stmt["init"]["callee"]["name"];
            if icn == "struct_schema" {
                let lay = _extract_schema_from_call(stmt["init"], st);
                if lay != nil { fctx["var_schemas"][nm] = lay; }
            } elif icn == "struct_buf_new" and len(stmt["init"]["args"]) >= 1 {
                let sc_arg = stmt["init"]["args"][0];
                if sc_arg["kind"] == "ident" {
                    let snm = sc_arg["name"];
                    if map_has(fctx["var_schemas"], snm) { fctx["buf_schemas"][nm] = fctx["var_schemas"][snm]; }
                    elif map_has(st["schemas"], snm) { fctx["buf_schemas"][nm] = st["schemas"][snm]; }
                }
            }
        }
        if at == "" and stmt["init"] != nil {
            at = _infer_expr_type(stmt["init"], fctx, st);
        }
        if at == "" { at = "i64"; }
        if not map_has(fctx["var_types"], nm) {
            fctx["var_types"][nm] = at;
            push(fctx["local_order"], nm);
        }
        return;
    }
    if k == "for_stmt" {
        let nm = stmt["var1"]["val"];
        if not map_has(fctx["var_types"], nm) {
            fctx["var_types"][nm] = "i64";
            push(fctx["local_order"], nm);
        }
        _prescan_locals(stmt["body"], fctx, st);
        return;
    }
    if k == "if_stmt" {
        _prescan_locals(stmt["then_block"], fctx, st);
        if stmt["else_block"] != nil { _prescan_locals(stmt["else_block"], fctx, st); }
        return;
    }
    if k == "while_stmt" or k == "loop_stmt" {
        _prescan_locals(stmt["body"], fctx, st);
    }
}

// ── Variable Access Helpers (Hardware Register `r12..r15`, Stack `[rbp-off]`, or RIP Global) ──

fn _emit_get_i64_var(st, fctx, nm, dst_reg) {
    if map_has(fctx["reg_map"], nm) {
        _emit_mov_rr(st["code"], dst_reg, fctx["reg_map"][nm]);
        return;
    }
    if map_has(fctx["slot_off"], nm) {
        _emit_load64(st["code"], dst_reg, REG_RBP, fctx["slot_off"][nm]);
        return;
    }
    if map_has(st["globals"], nm) {
        _emit_load_rip64(st, dst_reg, "rw", "g_" + nm);
        return;
    }
    _emit_mov_imm64(st["code"], dst_reg, 0);
}

fn _emit_set_i64_var(st, fctx, nm, src_reg) {
    if map_has(fctx["reg_map"], nm) {
        _emit_mov_rr(st["code"], fctx["reg_map"][nm], src_reg);
        return;
    }
    if map_has(fctx["slot_off"], nm) {
        _emit_store64(st["code"], REG_RBP, fctx["slot_off"][nm], src_reg);
        return;
    }
    if map_has(st["globals"], nm) {
        _emit_store_rip64(st, src_reg, "rw", "g_" + nm);
    }
}

fn _emit_get_f64_var(st, fctx, nm, dst_xmm) {
    if map_has(fctx["slot_off"], nm) {
        _emit_load_f64(st["code"], dst_xmm, REG_RBP, fctx["slot_off"][nm]);
        return;
    }
    if map_has(st["globals"], nm) {
        _emit_load_rip64(st, REG_R11, "rw", "g_" + nm);
        _emit_movq_xmm_gpr(st["code"], dst_xmm, REG_R11);
        return;
    }
    _emit_mov_xmm_f64_imm(st["code"], dst_xmm, 0.0);
}

fn _emit_set_f64_var(st, fctx, nm, src_xmm) {
    if map_has(fctx["slot_off"], nm) {
        _emit_store_f64(st["code"], REG_RBP, fctx["slot_off"][nm], src_xmm);
        return;
    }
    if map_has(st["globals"], nm) {
        _emit_movq_gpr_xmm(st["code"], REG_R11, src_xmm);
        _emit_store_rip64(st, REG_R11, "rw", "g_" + nm);
    }
}

// ── Expression Code Generation (`i64` in RAX, `f64` in XMM0) ─────────────────

fn _is_simple_i64_atom(expr, fctx, st) {
    if expr == nil { return false; }
    let k = expr["kind"];
    if k == "num" and not _is_float_num_str(expr["val"]) { return true; }
    if k == "bool" { return true; }
    if k == "ident" and _infer_expr_type(expr, fctx, st) != "f64" { return true; }
    return false;
}

fn _emit_simple_i64_to_reg(st, fctx, expr, dst_reg) {
    let k = expr["kind"];
    if k == "num" {
        _emit_mov_imm64(st["code"], dst_reg, _parse_int_lit(expr["val"]));
        return;
    }
    if k == "bool" {
        _emit_mov_imm64(st["code"], dst_reg, if expr["val"] { 1 } else { 0 });
        return;
    }
    if k == "ident" {
        _emit_get_i64_var(st, fctx, expr["name"], dst_reg);
    }
}

// Forward declarations via mutual top-level functions
fn _emit_expr_f64(st, fctx, expr) {
    let code = st["code"];
    if expr == nil {
        _emit_mov_xmm_f64_imm(code, 0, 0.0);
        return;
    }
    let et = _infer_expr_type(expr, fctx, st);
    if et != "f64" {
        _emit_expr_i64(st, fctx, expr);
        _emit_cvtsi2sd(code, 0, REG_RAX);
        return;
    }
    let k = expr["kind"];
    if k == "num" {
        _emit_mov_xmm_f64_imm(code, 0, parse_number(expr["val"]));
        return;
    }
    if k == "ident" {
        _emit_get_f64_var(st, fctx, expr["name"], 0);
        return;
    }
    if k == "unary" {
        _emit_expr_f64(st, fctx, expr["arg"]);
        if expr["op"] == "-" {
            _emit_mov_xmm_f64_imm(code, 1, -0.0);
            // Toggle sign bit via `movq rax, xmm0; btc rax, 63; movq xmm0, rax`
            _emit_movq_gpr_xmm(code, REG_RAX, 0);
            push(code, 73); push(code, 187); // movabs r11, 0x8000000000000000
            _push_zeros(code, 7); push(code, 128);
            push(code, _rex_w(REG_R11, 0, REG_RAX)); push(code, 49); push(code, _modrm(3, REG_R11, REG_RAX)); // xor rax, r11
            _emit_movq_xmm_gpr(code, 0, REG_RAX);
        }
        return;
    }
    if k == "binary" {
        let op = expr["op"];
        _emit_expr_f64(st, fctx, expr["left"]);
        // Spill xmm0 onto stack (8 bytes) while evaluating right
        _emit_sub_imm(code, REG_RSP, 16);
        _emit_store_f64(code, REG_RSP, 0, 0);
        _emit_expr_f64(st, fctx, expr["right"]);
        _emit_movsd_xx(code, 1, 0); // xmm1 = right
        _emit_load_f64(code, 0, REG_RSP, 0); // xmm0 = left
        _emit_add_imm(code, REG_RSP, 16);
        if op == "+" { _emit_sse_bin(code, 88, 0, 1); return; }  // 0x58 addsd
        if op == "-" { _emit_sse_bin(code, 92, 0, 1); return; }  // 0x5C subsd
        if op == "*" { _emit_sse_bin(code, 89, 0, 1); return; }  // 0x59 mulsd
        if op == "/" { _emit_sse_bin(code, 94, 0, 1); return; }  // 0x5E divsd
        return;
    }
    if k == "if_expr" {
        _emit_expr_i64(st, fctx, expr["cond"]);
        _emit_test_rr(code, REG_RAX, REG_RAX);
        let j_false = _emit_jcc(code, 132); // je
        _emit_expr_f64(st, fctx, expr["then_expr"]);
        let j_done = _emit_jmp(code);
        _patch_rel(code, j_false, len(code));
        _emit_expr_f64(st, fctx, expr["else_expr"]);
        _patch_rel(code, j_done, len(code));
        return;
    }
    if k == "call" {
        let cn = expr["callee"]["name"];
        let args = expr["args"];
        if cn == "sqrt" or cn == "num_sqrt" {
            _emit_expr_f64(st, fctx, args[0]);
            _emit_sse_bin(code, 81, 0, 0); // F2 0F 51 C0: sqrtsd xmm0, xmm0
            return;
        }
        if cn == "float" or cn == "f64" {
            _emit_expr_f64(st, fctx, args[0]);
            return;
        }
        if cn == "abs" or cn == "num_abs" {
            _emit_expr_f64(st, fctx, args[0]);
            _emit_movq_gpr_xmm(code, REG_RAX, 0);
            push(code, 73); push(code, 187); // movabs r11, 0x7FFFFFFFFFFFFFFF
            let bi = 0; while bi < 7 { push(code, 255); bi = bi + 1; } push(code, 127);
            push(code, _rex_w(REG_R11, 0, REG_RAX)); push(code, 33); push(code, _modrm(3, REG_R11, REG_RAX)); // and rax, r11
            _emit_movq_xmm_gpr(code, 0, REG_RAX);
            return;
        }
        if cn == "min" or cn == "max" {
            _emit_expr_f64(st, fctx, args[0]);
            _emit_sub_imm(code, REG_RSP, 16);
            _emit_store_f64(code, REG_RSP, 0, 0);
            _emit_expr_f64(st, fctx, args[1]);
            _emit_movsd_xx(code, 1, 0);
            _emit_load_f64(code, 0, REG_RSP, 0);
            _emit_add_imm(code, REG_RSP, 16);
            _emit_sse_bin(code, if cn == "min" { 93 } else { 95 }, 0, 1); // 0x5D minsd / 0x5F maxsd
            return;
        }
        if cn == "f64buf_get" {
            _emit_expr_i64(st, fctx, args[0]);
            _emit_push(code, REG_RAX);
            _emit_expr_i64(st, fctx, args[1]);
            _emit_pop(code, REG_RCX);
            // rcx = base ptr, rax = idx -> [rcx + rax*8]
            push(code, 72); push(code, 193); push(code, 224); push(code, 3); // shl rax, 3
            _emit_add_rr(code, REG_RCX, REG_RAX);
            _emit_load_f64(code, 0, REG_RCX, 0);
            return;
        }
        if cn == "struct_get_f64" {
            _emit_struct_field_addr(st, fctx, args[0], args[1], args[2]);
            _emit_load_f64(code, 0, REG_RAX, 0);
            return;
        }
        // User function returning f64 (returned in RAX bit-pattern -> movq xmm0, rax)
        _emit_user_call(st, fctx, cn, args);
        _emit_movq_xmm_gpr(code, 0, REG_RAX);
    }
}

fn _resolve_struct_field_const(fctx, st, buf_expr, field_expr) {
    let lay = nil;
    if buf_expr["kind"] == "ident" {
        let bnm = buf_expr["name"];
        if map_has(fctx["buf_schemas"], bnm) { lay = fctx["buf_schemas"][bnm]; }
        elif map_has(st["buf_schemas"], bnm) { lay = st["buf_schemas"][bnm]; }
    }
    if lay == nil { return nil; }
    let fobj = nil;
    if field_expr["kind"] == "num" {
        let fidx = _parse_int_lit(field_expr["val"]);
        if fidx >= 0 and fidx < len(lay["fields"]) { fobj = lay["fields"][fidx]; }
    } elif field_expr["kind"] == "str" {
        let fnm = field_expr["val"];
        if map_has(lay["by_name"], fnm) { fobj = lay["by_name"][fnm]; }
    }
    if fobj == nil { return nil; }
    return map{ stride: lay["stride"], offset: fobj["offset"], kind: fobj["kind"], size: fobj["size"] };
}

fn _emit_struct_field_addr(st, fctx, buf_expr, row_expr, field_expr) {
    let code = st["code"];
    let info = _resolve_struct_field_const(fctx, st, buf_expr, field_expr);
    let stride = if info != nil { info["stride"] } else { 0 };
    let foff = if info != nil { info["offset"] } else { 0 };

    if _is_simple_i64_atom(buf_expr, fctx, st) and _is_simple_i64_atom(row_expr, fctx, st) and info != nil {
        _emit_simple_i64_to_reg(st, fctx, buf_expr, REG_RCX);
        _emit_simple_i64_to_reg(st, fctx, row_expr, REG_RAX);
        _emit_imul_imm(code, REG_RAX, REG_RAX, stride);
        _emit_add_rr(code, REG_RAX, REG_RCX);
        if foff != 0 { _emit_add_imm(code, REG_RAX, foff); }
        return;
    }

    _emit_expr_i64(st, fctx, buf_expr);
    _emit_push(code, REG_RAX);
    _emit_expr_i64(st, fctx, row_expr);
    _emit_pop(code, REG_RCX); // rcx = buf ptr, rax = row
    if info != nil {
        _emit_imul_imm(code, REG_RAX, REG_RAX, stride);
        _emit_add_rr(code, REG_RAX, REG_RCX);
        if foff != 0 { _emit_add_imm(code, REG_RAX, foff); }
    } else {
        // Dynamic stride from [rcx - 24], field index * 8 fallback
        _emit_load64(code, REG_RDX, REG_RCX, -24);
        _emit_imul_rr(code, REG_RAX, REG_RDX);
        _emit_add_rr(code, REG_RAX, REG_RCX);
        if field_expr["kind"] == "num" {
            let fi = _parse_int_lit(field_expr["val"]);
            if fi > 0 { _emit_add_imm(code, REG_RAX, fi * 8); }
        }
    }
}

fn _emit_user_call(st, fctx, fn_name, args) {
    let code = st["code"];
    let nargs = len(args);
    // Evaluate arguments left-to-right onto stack, then pop into SysV/internal call regs (rdi, rsi, rdx, rcx, r8, r9)
    let param_regs = [REG_RDI, REG_RSI, REG_RDX, REG_RCX, REG_R8, REG_R9];
    let pt_list = if map_has(st["fn_param_types"], fn_name) { st["fn_param_types"][fn_name] } else { [] };

    let i = 0;
    while i < nargs and i < 6 {
        let want_f64 = (i < len(pt_list) and pt_list[i] == "f64") or (_infer_expr_type(args[i], fctx, st) == "f64");
        if want_f64 {
            _emit_expr_f64(st, fctx, args[i]);
            _emit_movq_gpr_xmm(code, REG_RAX, 0);
        } else {
            _emit_expr_i64(st, fctx, args[i]);
        }
        _emit_push(code, REG_RAX);
        i = i + 1;
    }
    let j = (if nargs < 6 { nargs } else { 6 }) - 1;
    while j >= 0 {
        _emit_pop(code, param_regs[j]);
        j = j - 1;
    }
    _emit_call_sym(st, "fn$" + fn_name);
}

fn _emit_expr_i64(st, fctx, expr) {
    let code = st["code"];
    if expr == nil {
        _emit_mov_imm64(code, REG_RAX, 0);
        return;
    }
    let k = expr["kind"];
    if k == "num" {
        if _is_float_num_str(expr["val"]) {
            _emit_mov_imm64(code, REG_RAX, floor(parse_number(expr["val"])));
        } else {
            _emit_mov_imm64(code, REG_RAX, _parse_int_lit(expr["val"]));
        }
        return;
    }
    if k == "bool" {
        _emit_mov_imm64(code, REG_RAX, if expr["val"] { 1 } else { 0 });
        return;
    }
    if k == "nil" {
        _emit_mov_imm64(code, REG_RAX, 0);
        return;
    }
    if k == "str" {
        let sidx = _intern_str(st, expr["val"]);
        if st["obfuscate_strings"] {
            _emit_lea_rip(st, REG_RDI, "ro_str", str(sidx));
            _emit_call_sym(st, "rt$unseal_ro_str");
        } else {
            _emit_lea_rip(st, REG_RAX, "ro_str", str(sidx));
        }
        return;
    }
    if k == "ident" {
        let nm = expr["name"];
        if _infer_expr_type(expr, fctx, st) == "f64" {
            _emit_get_f64_var(st, fctx, nm, 0);
            _emit_cvttsd2si(code, REG_RAX, 0);
            return;
        }
        _emit_get_i64_var(st, fctx, nm, REG_RAX);
        return;
    }
    if k == "unary" {
        let op = expr["op"];
        _emit_expr_i64(st, fctx, expr["arg"]);
        if op == "-" {
            push(code, 72); push(code, 247); push(code, 216); // 48 F7 D8: neg rax
            return;
        }
        if op == "not" or op == "!" {
            _emit_test_rr(code, REG_RAX, REG_RAX);
            push(code, 15); push(code, 148); push(code, 192); // sete al
            push(code, 15); push(code, 182); push(code, 192); // movzx eax, al
            return;
        }
        if op == "~" {
            push(code, 72); push(code, 247); push(code, 208); // 48 F7 D0: not rax
            return;
        }
        return;
    }
    if k == "binary" {
        let op = expr["op"];
        if op == "and" {
            _emit_expr_i64(st, fctx, expr["left"]);
            _emit_test_rr(code, REG_RAX, REG_RAX);
            let jf = _emit_jcc(code, 132); // je
            _emit_expr_i64(st, fctx, expr["right"]);
            _emit_test_rr(code, REG_RAX, REG_RAX);
            push(code, 15); push(code, 149); push(code, 192); // setne al
            push(code, 15); push(code, 182); push(code, 192); // movzx eax, al
            let jd = _emit_jmp(code);
            _patch_rel(code, jf, len(code));
            _emit_mov_imm64(code, REG_RAX, 0);
            _patch_rel(code, jd, len(code));
            return;
        }
        if op == "or" {
            _emit_expr_i64(st, fctx, expr["left"]);
            _emit_test_rr(code, REG_RAX, REG_RAX);
            let jt = _emit_jcc(code, 133); // jne
            _emit_expr_i64(st, fctx, expr["right"]);
            _emit_test_rr(code, REG_RAX, REG_RAX);
            push(code, 15); push(code, 149); push(code, 192);
            push(code, 15); push(code, 182); push(code, 192);
            let jd = _emit_jmp(code);
            _patch_rel(code, jt, len(code));
            _emit_mov_imm64(code, REG_RAX, 1);
            _patch_rel(code, jd, len(code));
            return;
        }

        let lt = _infer_expr_type(expr["left"], fctx, st);
        let rt = _infer_expr_type(expr["right"], fctx, st);

        // String concatenation `s1 + s2`
        if op == "+" and (lt == "str" or rt == "str") {
            _emit_expr_str_ptr(st, fctx, expr["left"]);
            _emit_push(code, REG_RAX);
            _emit_expr_str_ptr(st, fctx, expr["right"]);
            _emit_mov_rr(code, REG_RSI, REG_RAX);
            _emit_pop(code, REG_RDI);
            _emit_call_sym(st, "rt$str_concat");
            return;
        }

        // Float comparisons `f64 < f64`, `<=`, `>`, `>=`, `==`, `!=`
        if (lt == "f64" or rt == "f64") and (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            _emit_expr_f64(st, fctx, expr["left"]);
            _emit_sub_imm(code, REG_RSP, 16);
            _emit_store_f64(code, REG_RSP, 0, 0);
            _emit_expr_f64(st, fctx, expr["right"]);
            _emit_movsd_xx(code, 1, 0); // xmm1 = right
            _emit_load_f64(code, 0, REG_RSP, 0); // xmm0 = left
            _emit_add_imm(code, REG_RSP, 16);
            if op == ">" or op == ">=" or op == "==" or op == "!=" {
                push(code, 102); push(code, 15); push(code, 46); push(code, 193); // 66 0F 2E C1: ucomisd xmm0, xmm1
                let setb = if op == ">" { 151 } elif op == ">=" { 147 } elif op == "==" { 148 } else { 149 };
                push(code, 15); push(code, setb); push(code, 192);
                push(code, 15); push(code, 182); push(code, 192);
            } else {
                // `<` and `<=` via `ucomisd xmm1, xmm0` -> `seta` / `setae`
                push(code, 102); push(code, 15); push(code, 46); push(code, 200); // 66 0F 2E C8: ucomisd xmm1, xmm0
                let setb2 = if op == "<" { 151 } else { 147 };
                push(code, 15); push(code, setb2); push(code, 192);
                push(code, 15); push(code, 182); push(code, 192);
            }
            return;
        }

        // Zero-push fast path when RHS is an integer constant or local/register!
        if _is_simple_i64_atom(expr["right"], fctx, st) {
            if op == "*" and expr["left"]["kind"] == "ident" and map_has(fctx["reg_map"], expr["left"]["name"])
               and expr["right"]["kind"] == "num" and not _is_float_num_str(expr["right"]["val"]) {
                let fimm = _parse_int_lit(expr["right"]["val"]);
                if fimm >= -2147483648 and fimm <= 2147483647 {
                    _emit_imul_imm(code, REG_RAX, fctx["reg_map"][expr["left"]["name"]], fimm);
                    return;
                }
            }
            _emit_expr_i64(st, fctx, expr["left"]);
            if expr["right"]["kind"] == "num" and not _is_float_num_str(expr["right"]["val"]) {
                let rimm = _parse_int_lit(expr["right"]["val"]);
                if rimm >= -2147483648 and rimm <= 2147483647 {
                    if op == "+" { _emit_add_imm(code, REG_RAX, rimm); return; }
                    if op == "-" { _emit_sub_imm(code, REG_RAX, rimm); return; }
                    if op == "*" { _emit_imul_imm(code, REG_RAX, REG_RAX, rimm); return; }
                    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
                        _emit_cmp_imm(code, REG_RAX, rimm);
                        let sc = if op == "==" { 148 } elif op == "!=" { 149 } elif op == "<" { 156 } elif op == "<=" { 158 } elif op == ">" { 159 } else { 157 };
                        push(code, 15); push(code, sc); push(code, 192);
                        push(code, 15); push(code, 182); push(code, 192);
                        return;
                    }
                }
            }
            _emit_simple_i64_to_reg(st, fctx, expr["right"], REG_RCX);
        } elif _is_simple_i64_atom(expr["left"], fctx, st) {
            _emit_expr_i64(st, fctx, expr["right"]);
            _emit_mov_rr(code, REG_RCX, REG_RAX);
            _emit_simple_i64_to_reg(st, fctx, expr["left"], REG_RAX);
        } else {
            _emit_expr_i64(st, fctx, expr["left"]);
            _emit_push(code, REG_RAX);
            _emit_expr_i64(st, fctx, expr["right"]);
            _emit_mov_rr(code, REG_RCX, REG_RAX);
            _emit_pop(code, REG_RAX);
        }

        // Now RAX = left, RCX = right
        if op == "+" { _emit_add_rr(code, REG_RAX, REG_RCX); return; }
        if op == "-" { _emit_sub_rr(code, REG_RAX, REG_RCX); return; }
        if op == "*" { _emit_imul_rr(code, REG_RAX, REG_RCX); return; }
        if op == "/" {
            push(code, 72); push(code, 153); // 48 99: cqo
            push(code, 72); push(code, 247); push(code, 249); // 48 F7 F9: idiv rcx
            return;
        }
        if op == "%" {
            push(code, 72); push(code, 153); // cqo
            push(code, 72); push(code, 247); push(code, 249); // idiv rcx
            _emit_mov_rr(code, REG_RAX, REG_RDX);
            return;
        }
        if op == "&" {
            push(code, 72); push(code, 33); push(code, 200); // 48 21 C8: and rax, rcx
            return;
        }
        if op == "|" {
            push(code, 72); push(code, 9); push(code, 200); // 48 09 C8: or rax, rcx
            return;
        }
        if op == "^" {
            push(code, 72); push(code, 49); push(code, 200); // 48 31 C8: xor rax, rcx
            return;
        }
        if op == "<<" {
            push(code, 72); push(code, 211); push(code, 224); // 48 D3 E0: shl rax, cl
            return;
        }
        if op == ">>" {
            push(code, 72); push(code, 211); push(code, 248); // 48 D3 F8: sar rax, cl
            return;
        }
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
            _emit_cmp_rr(code, REG_RAX, REG_RCX);
            let sc2 = if op == "==" { 148 } elif op == "!=" { 149 } elif op == "<" { 156 } elif op == "<=" { 158 } elif op == ">" { 159 } else { 157 };
            push(code, 15); push(code, sc2); push(code, 192);
            push(code, 15); push(code, 182); push(code, 192);
            return;
        }
        return;
    }
    if k == "if_expr" {
        _emit_expr_i64(st, fctx, expr["cond"]);
        _emit_test_rr(code, REG_RAX, REG_RAX);
        let jf = _emit_jcc(code, 132);
        _emit_expr_i64(st, fctx, expr["then_expr"]);
        let jd = _emit_jmp(code);
        _patch_rel(code, jf, len(code));
        _emit_expr_i64(st, fctx, expr["else_expr"]);
        _patch_rel(code, jd, len(code));
        return;
    }
    if k == "call" {
        _emit_call_i64(st, fctx, expr);
    }
}

fn _emit_expr_str_ptr(st, fctx, expr) {
    let et = _infer_expr_type(expr, fctx, st);
    if et == "str" {
        _emit_expr_i64(st, fctx, expr);
        return;
    }
    if et == "f64" {
        _emit_expr_f64(st, fctx, expr);
        _emit_call_sym(st, "rt$f64_to_str");
        return;
    }
    _emit_expr_i64(st, fctx, expr);
    _emit_mov_rr(st["code"], REG_RDI, REG_RAX);
    if et == "bool" {
        _emit_call_sym(st, "rt$bool_to_str");
    } else {
        _emit_call_sym(st, "rt$i64_to_str");
    }
}

fn _emit_print_one(st, fctx, expr, with_nl) {
    let code = st["code"];
    let et = _infer_expr_type(expr, fctx, st);
    if et == "str" {
        _emit_expr_i64(st, fctx, expr);
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_call_sym(st, "rt$print_str");
    } elif et == "f64" {
        _emit_expr_f64(st, fctx, expr);
        _emit_call_sym(st, "rt$print_f64");
    } elif et == "bool" {
        _emit_expr_i64(st, fctx, expr);
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_call_sym(st, "rt$print_bool");
    } else {
        _emit_expr_i64(st, fctx, expr);
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_call_sym(st, "rt$print_i64");
    }
    if with_nl {
        _emit_call_sym(st, "rt$print_nl");
    }
}

fn _emit_call_i64(st, fctx, expr) {
    let code = st["code"];
    let cn = expr["callee"]["name"];
    let args = expr["args"];

    if cn == "print" or cn == "println" {
        if len(args) == 0 {
            _emit_call_sym(st, "rt$print_nl");
        } else {
            let i = 0;
            while i < len(args) {
                _emit_print_one(st, fctx, args[i], i + 1 == len(args));
                i = i + 1;
            }
        }
        _emit_mov_imm64(code, REG_RAX, 0);
        return;
    }
    if cn == "str" {
        _emit_expr_str_ptr(st, fctx, args[0]);
        return;
    }
    if cn == "len" or cn == "bytes_len" or cn == "f64buf_len" or cn == "struct_buf_len" {
        let a0t = _infer_expr_type(args[0], fctx, st);
        _emit_expr_i64(st, fctx, args[0]);
        if a0t == "str" {
            _emit_load64(code, REG_RAX, REG_RAX, 0); // [str_ptr + 0] = byte len
        } else {
            _emit_load64(code, REG_RAX, REG_RAX, -32); // [buf_ptr - 32] = len
        }
        return;
    }
    if cn == "struct_buf_stride" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_load64(code, REG_RAX, REG_RAX, -24);
        return;
    }
    if cn == "struct_buf_ptr" {
        _emit_expr_i64(st, fctx, args[0]);
        return;
    }
    if cn == "struct_schema" {
        // Compile-time schema descriptor; return stride in RAX
        let lay = _extract_schema_from_call(expr, st);
        _emit_mov_imm64(code, REG_RAX, if lay != nil { lay["stride"] } else { 8 });
        return;
    }
    if cn == "struct_buf_new" {
        // args[0] = schema, args[1] = cap
        let stride = 8;
        if args[0]["kind"] == "ident" {
            let snm = args[0]["name"];
            if map_has(fctx["var_schemas"], snm) { stride = fctx["var_schemas"][snm]["stride"]; }
            elif map_has(st["schemas"], snm) { stride = st["schemas"][snm]["stride"]; }
        }
        _emit_expr_i64(st, fctx, args[1]); // rax = cap
        _emit_push(code, REG_RAX);
        _emit_imul_imm(code, REG_RDI, REG_RAX, stride);
        _emit_add_imm(code, REG_RDI, 32); // 32-byte header: [-32]=len(cap), [-24]=stride, [-16]=cap
        _emit_call_sym(st, "rt$alloc");
        _emit_pop(code, REG_RCX); // rcx = cap
        _emit_store64(code, REG_RAX, 0, REG_RCX);
        _emit_mov_imm64(code, REG_RDX, stride);
        _emit_store64(code, REG_RAX, 8, REG_RDX);
        _emit_store64(code, REG_RAX, 16, REG_RCX);
        _emit_add_imm(code, REG_RAX, 32);
        return;
    }
    if cn == "struct_get_i64" {
        let info = _resolve_struct_field_const(fctx, st, args[0], args[2]);
        _emit_struct_field_addr(st, fctx, args[0], args[1], args[2]);
        if info != nil and info["size"] == 1 {
            _emit_load_u8(code, REG_RAX, REG_RAX, 0);
        } else {
            _emit_load64(code, REG_RAX, REG_RAX, 0);
        }
        return;
    }
    if cn == "struct_set_i64" {
        let info = _resolve_struct_field_const(fctx, st, args[0], args[2]);
        _emit_struct_field_addr(st, fctx, args[0], args[1], args[2]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[3]);
        _emit_pop(code, REG_RCX); // rcx = addr, rax = val
        if info != nil and info["size"] == 1 {
            _emit_store_u8(code, REG_RCX, 0, REG_RAX);
        } else {
            _emit_store64(code, REG_RCX, 0, REG_RAX);
        }
        return;
    }
    if cn == "struct_set_f64" {
        _emit_struct_field_addr(st, fctx, args[0], args[1], args[2]);
        _emit_push(code, REG_RAX);
        _emit_expr_f64(st, fctx, args[3]);
        _emit_pop(code, REG_RCX);
        _emit_store_f64(code, REG_RCX, 0, 0);
        _emit_mov_imm64(code, REG_RAX, 0);
        return;
    }
    if cn == "f64buf_new" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_imul_imm(code, REG_RDI, REG_RAX, 8);
        _emit_add_imm(code, REG_RDI, 32);
        _emit_call_sym(st, "rt$alloc");
        _emit_pop(code, REG_RCX);
        _emit_store64(code, REG_RAX, 0, REG_RCX);
        _emit_mov_imm64(code, REG_RDX, 8);
        _emit_store64(code, REG_RAX, 8, REG_RDX);
        _emit_add_imm(code, REG_RAX, 32);
        return;
    }
    if cn == "f64buf_set" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[1]);
        _emit_push(code, REG_RAX);
        _emit_expr_f64(st, fctx, args[2]);
        _emit_pop(code, REG_RAX); // idx
        _emit_pop(code, REG_RCX); // base
        push(code, 72); push(code, 193); push(code, 224); push(code, 3); // shl rax, 3
        _emit_add_rr(code, REG_RCX, REG_RAX);
        _emit_store_f64(code, REG_RCX, 0, 0);
        _emit_mov_imm64(code, REG_RAX, 0);
        return;
    }
    if cn == "bytes_new" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_add_imm(code, REG_RDI, 32);
        _emit_call_sym(st, "rt$alloc");
        _emit_pop(code, REG_RCX);
        _emit_store64(code, REG_RAX, 0, REG_RCX);
        _emit_add_imm(code, REG_RAX, 32);
        return;
    }
    if cn == "bytes_get" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[1]);
        _emit_pop(code, REG_RCX);
        _emit_add_rr(code, REG_RCX, REG_RAX);
        _emit_load_u8(code, REG_RAX, REG_RCX, 0);
        return;
    }
    if cn == "bytes_set" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[1]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[2]);
        _emit_pop(code, REG_RDX); // idx
        _emit_pop(code, REG_RCX); // base
        _emit_add_rr(code, REG_RCX, REG_RDX);
        _emit_store_u8(code, REG_RCX, 0, REG_RAX);
        return;
    }
    if cn == "time_ms" or cn == "now_ms" {
        _emit_call_sym(st, "rt$time_ms");
        return;
    }
    if cn == "int" or cn == "i64" or cn == "floor" or cn == "num_floor" {
        if _infer_expr_type(args[0], fctx, st) == "f64" {
            _emit_expr_f64(st, fctx, args[0]);
            _emit_cvttsd2si(code, REG_RAX, 0);
        } else {
            _emit_expr_i64(st, fctx, args[0]);
        }
        return;
    }
    if cn == "abs" or cn == "num_abs" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_mov_rr(code, REG_RCX, REG_RAX);
        push(code, 72); push(code, 247); push(code, 217); // 48 F7 D9: neg rcx
        _emit_test_rr(code, REG_RAX, REG_RAX);
        push(code, 72); push(code, 15); push(code, 72); push(code, 193); // 48 0F 48 C1: cmovs rax, rcx
        return;
    }
    if cn == "min" or cn == "max" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[1]);
        _emit_mov_rr(code, REG_RCX, REG_RAX);
        _emit_pop(code, REG_RAX);
        _emit_cmp_rr(code, REG_RCX, REG_RAX);
        // cmovl rax, rcx (`48 0F 4C C1`) for min; cmovg rax, rcx (`48 0F 4F C1`) for max
        push(code, 72); push(code, 15); push(code, if cn == "min" { 76 } else { 79 }); push(code, 193);
        return;
    }
    if cn == "bit_and" or cn == "bit_or" or cn == "bit_xor" or cn == "bit_shl" or cn == "bit_shr" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_push(code, REG_RAX);
        _emit_expr_i64(st, fctx, args[1]);
        _emit_mov_rr(code, REG_RCX, REG_RAX);
        _emit_pop(code, REG_RAX);
        if cn == "bit_and" { push(code, 72); push(code, 33); push(code, 200); }
        elif cn == "bit_or" { push(code, 72); push(code, 9); push(code, 200); }
        elif cn == "bit_xor" { push(code, 72); push(code, 49); push(code, 200); }
        elif cn == "bit_shl" { push(code, 72); push(code, 211); push(code, 224); }
        else { push(code, 72); push(code, 211); push(code, 248); }
        return;
    }
    if cn == "os_exit" or cn == "exit" {
        if len(args) > 0 { _emit_expr_i64(st, fctx, args[0]); } else { _emit_mov_imm64(code, REG_RAX, 0); }
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_call_sym(st, "rt$exit");
        return;
    }
    if cn == "assert" {
        _emit_expr_i64(st, fctx, args[0]);
        _emit_test_rr(code, REG_RAX, REG_RAX);
        let jok = _emit_jcc(code, 133); // jne ok
        _emit_mov_imm64(code, REG_RDI, 1);
        _emit_call_sym(st, "rt$exit");
        _patch_rel(code, jok, len(code));
        return;
    }

    _emit_user_call(st, fctx, cn, args);
}

// ── Tight Loop Condition Direct Branch Emitter (`cmp` + `jcc` with ZERO setcc!) ──

fn _emit_cond_jump_polarity(st, fctx, cond_expr, jump_when_true) {
    let code = st["code"];
    if cond_expr["kind"] == "binary" {
        let op = cond_expr["op"];
        let lt = _infer_expr_type(cond_expr["left"], fctx, st);
        let rt = _infer_expr_type(cond_expr["right"], fctx, st);
        if lt != "f64" and rt != "f64" and lt != "str" and rt != "str" {
            if op == "<" or op == "<=" or op == ">" or op == ">=" or op == "==" or op == "!=" {
                if _is_simple_i64_atom(cond_expr["right"], fctx, st) {
                    let lreg = REG_RAX;
                    if cond_expr["left"]["kind"] == "ident" and map_has(fctx["reg_map"], cond_expr["left"]["name"]) {
                        lreg = fctx["reg_map"][cond_expr["left"]["name"]];
                    } else {
                        _emit_expr_i64(st, fctx, cond_expr["left"]);
                    }
                    let jcc_op = if jump_when_true {
                        if op == "<" { 140 } elif op == "<=" { 142 } elif op == ">" { 143 } elif op == ">=" { 141 } elif op == "==" { 132 } else { 133 }
                    } else {
                        if op == "<" { 141 } elif op == "<=" { 143 } elif op == ">" { 142 } elif op == ">=" { 140 } elif op == "==" { 133 } else { 132 }
                    };
                    if cond_expr["right"]["kind"] == "num" and not _is_float_num_str(cond_expr["right"]["val"]) {
                        let rimm = _parse_int_lit(cond_expr["right"]["val"]);
                        if rimm >= -2147483648 and rimm <= 2147483647 {
                            _emit_cmp_imm(code, lreg, rimm);
                            return _emit_jcc(code, jcc_op);
                        }
                    }
                    _emit_simple_i64_to_reg(st, fctx, cond_expr["right"], REG_RCX);
                    _emit_cmp_rr(code, lreg, REG_RCX);
                    return _emit_jcc(code, jcc_op);
                }
            }
        }
    }
    _emit_expr_i64(st, fctx, cond_expr);
    _emit_test_rr(code, REG_RAX, REG_RAX);
    return _emit_jcc(code, if jump_when_true { 133 } else { 132 });
}

fn _emit_cond_jump_false(st, fctx, cond_expr) {
    return _emit_cond_jump_polarity(st, fctx, cond_expr, false);
}

fn _emit_cond_jump_true(st, fctx, cond_expr) {
    return _emit_cond_jump_polarity(st, fctx, cond_expr, true);
}

fn _expr_is_pure_scalar_arith(expr) {
    if expr == nil or type(expr) != "map" { return false; }
    let k = expr["kind"];
    if k == "num" or k == "ident" or k == "bool" { return true; }
    if k == "unary" { return _expr_is_pure_scalar_arith(expr["arg"]); }
    if k == "binary" {
        let op = expr["op"];
        if op == "/" or op == "%" { return false; }
        return _expr_is_pure_scalar_arith(expr["left"]) and _expr_is_pure_scalar_arith(expr["right"]);
    }
    return false;
}

fn _expr_uses_ident(expr, nm) {
    if expr == nil or type(expr) != "map" { return false; }
    let k = expr["kind"];
    if k == "ident" { return expr["name"] == nm; }
    if k == "unary" { return _expr_uses_ident(expr["arg"], nm); }
    if k == "binary" { return _expr_uses_ident(expr["left"], nm) or _expr_uses_ident(expr["right"], nm); }
    return false;
}

fn _match_unrollable_while(stmt, fctx) {
    let cond = stmt["cond"];
    if cond == nil or cond["kind"] != "binary" or cond["op"] != "<" { return nil; }
    if cond["left"]["kind"] != "ident" { return nil; }
    let iv = cond["left"]["name"];
    if not map_has(fctx["reg_map"], iv) { return nil; }
    if cond["right"]["kind"] != "num" or _is_float_num_str(cond["right"]["val"]) { return nil; }
    let lim = _parse_int_lit(cond["right"]["val"]);
    if lim < 16 or lim > 2147483640 { return nil; }
    let body = stmt["body"];
    if body == nil or body["kind"] != "block" { return nil; }
    if map_has(body, "tail_expr") and body["tail_expr"] != nil { return nil; }
    let stmts = body["stmts"];
    let n = len(stmts);
    if n < 2 or n > 6 { return nil; }
    let last = stmts[n - 1];
    if last["kind"] != "assign" or last["target"]["kind"] != "ident" or last["target"]["name"] != iv { return nil; }
    let step_ok = false;
    if last["op"] == "+=" and last["val"]["kind"] == "num" and last["val"]["val"] == "1" {
        step_ok = true;
    } elif last["op"] == "=" and last["val"]["kind"] == "binary" and last["val"]["op"] == "+"
           and last["val"]["left"]["kind"] == "ident" and last["val"]["left"]["name"] == iv
           and last["val"]["right"]["kind"] == "num" and last["val"]["right"]["val"] == "1" {
        step_ok = true;
    }
    if not step_ok { return nil; }
    let i = 0;
    while i < n - 1 {
        let s = stmts[i];
        if s["kind"] != "assign" or s["target"]["kind"] != "ident" { return nil; }
        let tnm = s["target"]["name"];
        if tnm == iv { return nil; }
        if map_has(fctx["var_types"], tnm) and fctx["var_types"][tnm] == "f64" { return nil; }
        if not _expr_is_pure_scalar_arith(s["val"]) { return nil; }
        i = i + 1;
    }
    let acc_nm = "";
    let acc_op = "";
    let delta = nil;
    if n == 2 {
        let s0 = stmts[0];
        let cand_acc = s0["target"]["name"];
        if map_has(fctx["reg_map"], cand_acc) {
            if s0["op"] == "+=" or s0["op"] == "-=" {
                if not _expr_uses_ident(s0["val"], cand_acc) {
                    acc_nm = cand_acc;
                    acc_op = str_slice(s0["op"], 0, 1);
                    delta = s0["val"];
                }
            } elif s0["op"] == "=" and s0["val"]["kind"] == "binary" {
                let b = s0["val"];
                if (b["op"] == "+" or b["op"] == "-") and b["left"]["kind"] == "ident" and b["left"]["name"] == cand_acc {
                    if not _expr_uses_ident(b["right"], cand_acc) {
                        acc_nm = cand_acc;
                        acc_op = b["op"];
                        delta = b["right"];
                    }
                } elif (b["op"] == "+" or b["op"] == "-") and b["left"]["kind"] == "binary" {
                    let bl = b["left"];
                    if (bl["op"] == "+" or bl["op"] == "-") and bl["left"]["kind"] == "ident" and bl["left"]["name"] == cand_acc {
                        let comb = if bl["op"] == "+" { b["op"] } else { if b["op"] == "+" { "-" } else { "+" } };
                        let cand_d = map{ kind: "binary", op: comb, left: bl["right"], right: b["right"] };
                        if not _expr_uses_ident(cand_d, cand_acc) {
                            acc_nm = cand_acc;
                            acc_op = bl["op"];
                            delta = cand_d;
                        }
                    }
                }
            }
        }
    }
    return map{ iv: iv, lim: lim, acc_nm: acc_nm, acc_op: acc_op, delta: delta };
}

fn _subst_iv_offset(expr, iv, k_off) {
    if k_off == 0 or expr == nil or type(expr) != "map" { return expr; }
    let k = expr["kind"];
    if k == "ident" and expr["name"] == iv {
        return map{ kind: "binary", op: "+", left: expr, right: map{ kind: "num", val: str(k_off) } };
    }
    if k == "unary" {
        return map{ kind: "unary", op: expr["op"], arg: _subst_iv_offset(expr["arg"], iv, k_off) };
    }
    if k == "binary" {
        return map{
            kind: "binary",
            op: expr["op"],
            left: _subst_iv_offset(expr["left"], iv, k_off),
            right: _subst_iv_offset(expr["right"], iv, k_off)
        };
    }
    return expr;
}

// Returns `[1, stride]` if `expr` is an affine integer function `stride * iv + base` (with loop-invariant `base`), else `nil`.
fn _affine_iv_stride(expr, iv) {
    if expr == nil or type(expr) != "map" { return [1, 0]; }
    let k = expr["kind"];
    if k == "num" and not _is_float_num_str(expr["val"]) { return [1, 0]; }
    if k == "ident" {
        if expr["name"] == iv { return [1, 1]; }
        return [1, 0];
    }
    if k == "unary" and expr["op"] == "-" {
        let sub = _affine_iv_stride(expr["arg"], iv);
        if sub == nil { return nil; }
        return [1, 0 - sub[1]];
    }
    if k == "binary" {
        let op = expr["op"];
        let la = _affine_iv_stride(expr["left"], iv);
        let ra = _affine_iv_stride(expr["right"], iv);
        if la == nil or ra == nil { return nil; }
        if op == "+" { return [1, la[1] + ra[1]]; }
        if op == "-" { return [1, la[1] - ra[1]]; }
        if op == "*" {
            if la[1] == 0 and expr["left"]["kind"] == "num" and not _is_float_num_str(expr["left"]["val"]) {
                return [1, _parse_int_lit(expr["left"]["val"]) * ra[1]];
            }
            if ra[1] == 0 and expr["right"]["kind"] == "num" and not _is_float_num_str(expr["right"]["val"]) {
                return [1, la[1] * _parse_int_lit(expr["right"]["val"])];
            }
        }
    }
    return nil;
}

// ── Statement Code Generation ─────────────────────────────────────────────────

fn _emit_stmt(st, fctx, stmt) {
    if stmt == nil or type(stmt) != "map" { return; }
    let code = st["code"];
    let k = stmt["kind"];

    if k == "empty" or k == "export_stmt" or k == "struct_decl" or k == "fn_decl" {
        return;
    }
    if k == "block" {
        let i = 0;
        while i < len(stmt["stmts"]) {
            _emit_stmt(st, fctx, stmt["stmts"][i]);
            i = i + 1;
        }
        if map_has(stmt, "tail_expr") and stmt["tail_expr"] != nil {
            if fctx["ret_type"] == "f64" {
                _emit_expr_f64(st, fctx, stmt["tail_expr"]);
                _emit_movq_gpr_xmm(code, REG_RAX, 0);
            } else {
                _emit_expr_i64(st, fctx, stmt["tail_expr"]);
            }
        }
        return;
    }
    if k == "var_decl" {
        let nm = stmt["name"];
        let vt = if map_has(fctx["var_types"], nm) { fctx["var_types"][nm] }
                 elif map_has(st["global_types"], nm) { st["global_types"][nm] }
                 else { "i64" };
        if stmt["init"] == nil {
            if vt == "f64" {
                _emit_mov_xmm_f64_imm(code, 0, 0.0);
                _emit_set_f64_var(st, fctx, nm, 0);
            } else {
                _emit_mov_imm64(code, REG_RAX, 0);
                _emit_set_i64_var(st, fctx, nm, REG_RAX);
            }
            return;
        }
        if vt == "f64" {
            _emit_expr_f64(st, fctx, stmt["init"]);
            _emit_set_f64_var(st, fctx, nm, 0);
        } else {
            _emit_expr_i64(st, fctx, stmt["init"]);
            _emit_set_i64_var(st, fctx, nm, REG_RAX);
        }
        return;
    }
    if k == "assign" {
        let nm = stmt["target"]["name"];
        let op = stmt["op"];
        let vt = if map_has(fctx["var_types"], nm) { fctx["var_types"][nm] }
                 elif map_has(st["global_types"], nm) { st["global_types"][nm] }
                 else { "i64" };
        if vt == "f64" {
            if op == "=" {
                _emit_expr_f64(st, fctx, stmt["val"]);
                _emit_set_f64_var(st, fctx, nm, 0);
            } else {
                let bop = str_slice(op, 0, 1);
                let syn = map{ kind: "binary", op: bop, left: map{ kind: "ident", name: nm }, right: stmt["val"] };
                _emit_expr_f64(st, fctx, syn);
                _emit_set_f64_var(st, fctx, nm, 0);
            }
            return;
        }
        // Super-fast in-place register increment `i = i + const` or `i += const`!
        if map_has(fctx["reg_map"], nm) {
            let hw = fctx["reg_map"][nm];
            if (op == "+=" or op == "-=") and stmt["val"]["kind"] == "num" and not _is_float_num_str(stmt["val"]["val"]) {
                let imm = _parse_int_lit(stmt["val"]["val"]);
                if imm >= -2147483648 and imm <= 2147483647 {
                    if op == "+=" { _emit_add_imm(code, hw, imm); } else { _emit_sub_imm(code, hw, imm); }
                    return;
                }
            }
            if op == "=" and stmt["val"]["kind"] == "binary" {
                let b = stmt["val"];
                if b["left"]["kind"] == "ident" and b["left"]["name"] == nm {
                    if b["right"]["kind"] == "num" and not _is_float_num_str(b["right"]["val"]) {
                        let bimm = _parse_int_lit(b["right"]["val"]);
                        if bimm >= -2147483648 and bimm <= 2147483647 {
                            if b["op"] == "+" { _emit_add_imm(code, hw, bimm); return; }
                            if b["op"] == "-" { _emit_sub_imm(code, hw, bimm); return; }
                        }
                    }
                    // `acc = acc + <expr>` -> evaluate <expr> into RAX, then `add hw, rax`!
                    if b["op"] == "+" {
                        _emit_expr_i64(st, fctx, b["right"]);
                        _emit_add_rr(code, hw, REG_RAX);
                        return;
                    }
                    if b["op"] == "-" {
                        _emit_expr_i64(st, fctx, b["right"]);
                        _emit_sub_rr(code, hw, REG_RAX);
                        return;
                    }
                }
                // Associative latency reduction: `acc = (acc + X) +/- Y` -> `tmp = X +/- Y; add hw, tmp` (1-cycle latency on hw!)
                if (b["op"] == "+" or b["op"] == "-") and b["left"]["kind"] == "binary" {
                    let bl = b["left"];
                    if (bl["op"] == "+" or bl["op"] == "-") and bl["left"]["kind"] == "ident" and bl["left"]["name"] == nm {
                        let comb_op = if bl["op"] == "+" { b["op"] } else { if b["op"] == "+" { "-" } else { "+" } };
                        let delta_expr = map{ kind: "binary", op: comb_op, left: bl["right"], right: b["right"] };
                        _emit_expr_i64(st, fctx, delta_expr);
                        if bl["op"] == "+" { _emit_add_rr(code, hw, REG_RAX); } else { _emit_sub_rr(code, hw, REG_RAX); }
                        return;
                    }
                }
            }
        }
        if op == "=" {
            _emit_expr_i64(st, fctx, stmt["val"]);
            _emit_set_i64_var(st, fctx, nm, REG_RAX);
        } else {
            let bop2 = str_slice(op, 0, 1);
            let syn2 = map{ kind: "binary", op: bop2, left: map{ kind: "ident", name: nm }, right: stmt["val"] };
            _emit_expr_i64(st, fctx, syn2);
            _emit_set_i64_var(st, fctx, nm, REG_RAX);
        }
        return;
    }
    if k == "print_stmt" {
        let args = stmt["args"];
        if len(args) == 0 {
            _emit_call_sym(st, "rt$print_nl");
        } else {
            let i = 0;
            while i < len(args) {
                _emit_print_one(st, fctx, args[i], i + 1 == len(args));
                i = i + 1;
            }
        }
        return;
    }
    if k == "expr_stmt" {
        if _infer_expr_type(stmt["expr"], fctx, st) == "f64" {
            _emit_expr_f64(st, fctx, stmt["expr"]);
        } else {
            _emit_expr_i64(st, fctx, stmt["expr"]);
        }
        return;
    }
    if k == "return_stmt" {
        if stmt["val"] == nil {
            _emit_mov_imm64(code, REG_RAX, 0);
        } elif fctx["ret_type"] == "f64" {
            _emit_expr_f64(st, fctx, stmt["val"]);
            _emit_movq_gpr_xmm(code, REG_RAX, 0);
        } else {
            _emit_expr_i64(st, fctx, stmt["val"]);
        }
        push(fctx["ret_jumps"], _emit_jmp(code));
        return;
    }
    if k == "if_stmt" {
        let jf = _emit_cond_jump_false(st, fctx, stmt["cond"]);
        _emit_stmt(st, fctx, stmt["then_block"]);
        if stmt["else_block"] != nil {
            let jd = _emit_jmp(code);
            _patch_rel(code, jf, len(code));
            _emit_stmt(st, fctx, stmt["else_block"]);
            _patch_rel(code, jd, len(code));
        } else {
            _patch_rel(code, jf, len(code));
        }
        return;
    }
    if k == "while_stmt" {
        let um = _match_unrollable_while(stmt, fctx);
        if um != nil {
            let iv_reg = fctx["reg_map"][um["iv"]];
            let lim4 = um["lim"] - 3;
            if um["delta"] != nil {
                let lim8 = um["lim"] - 7;
                let acc_reg = fctx["reg_map"][um["acc_nm"]];
                let is_add = um["acc_op"] == "+";
                let aff = _affine_iv_stride(um["delta"], um["iv"]);
                _emit_mov_imm64(code, REG_R8, 0);
                _emit_mov_imm64(code, REG_R9, 0);
                _emit_mov_imm64(code, REG_R10, 0);
                _emit_mov_imm64(code, REG_R11, 0);
                if aff != nil {
                    _emit_expr_i64(st, fctx, um["delta"]);
                    _emit_mov_rr(code, REG_RDX, REG_RAX);
                }
                let j_ucond = _emit_jmp(code);
                let ubody_top = len(code);
                let lanes = [REG_R8, REG_R9, REG_R10, REG_R11];
                let li = 0;
                while li < 8 {
                    let dst_lane = lanes[li % 4];
                    if aff != nil {
                        if is_add { _emit_add_rr(code, dst_lane, REG_RDX); } else { _emit_sub_rr(code, dst_lane, REG_RDX); }
                        if aff[1] >= 0 { _emit_add_imm(code, REG_RDX, aff[1]); } else { _emit_sub_imm(code, REG_RDX, 0 - aff[1]); }
                    } else {
                        let lane_expr = _subst_iv_offset(um["delta"], um["iv"], li);
                        _emit_expr_i64(st, fctx, lane_expr);
                        if is_add { _emit_add_rr(code, dst_lane, REG_RAX); } else { _emit_sub_rr(code, dst_lane, REG_RAX); }
                    }
                    li = li + 1;
                }
                _emit_add_imm(code, iv_reg, 8);
                let ucond_pos = len(code);
                _patch_rel(code, j_ucond, ucond_pos);
                _emit_cmp_imm(code, iv_reg, lim8);
                let j_uback = _emit_jcc(code, 140); // jl ubody_top
                _patch_rel(code, j_uback, ubody_top);
                _emit_add_rr(code, REG_R8, REG_R9);
                _emit_add_rr(code, REG_R10, REG_R11);
                _emit_add_rr(code, REG_R8, REG_R10);
                _emit_add_rr(code, acc_reg, REG_R8);
            } else {
                let j_ucond = _emit_jmp(code);
                let ubody_top = len(code);
                _emit_stmt(st, fctx, stmt["body"]);
                _emit_stmt(st, fctx, stmt["body"]);
                _emit_stmt(st, fctx, stmt["body"]);
                _emit_stmt(st, fctx, stmt["body"]);
                let ucond_pos = len(code);
                _patch_rel(code, j_ucond, ucond_pos);
                _emit_cmp_imm(code, iv_reg, lim4);
                let j_uback = _emit_jcc(code, 140); // jl ubody_top
                _patch_rel(code, j_uback, ubody_top);
            }
        }
        let j_cond = _emit_jmp(code);
        let body_top = len(code);
        let loop_ctx = map{ top: body_top, breaks: [], continues: [], step_kind: "cond" };
        push(fctx["loops"], loop_ctx);
        _emit_stmt(st, fctx, stmt["body"]);
        let cond_pos = len(code);
        _patch_rel(code, j_cond, cond_pos);
        let j_back = _emit_cond_jump_true(st, fctx, stmt["cond"]);
        _patch_rel(code, j_back, body_top);
        let loop_end = len(code);
        let bi = 0;
        while bi < len(loop_ctx["breaks"]) { _patch_rel(code, loop_ctx["breaks"][bi], loop_end); bi = bi + 1; }
        let ci = 0;
        while ci < len(loop_ctx["continues"]) { _patch_rel(code, loop_ctx["continues"][ci], cond_pos); ci = ci + 1; }
        pop(fctx["loops"]);
        return;
    }
    if k == "loop_stmt" {
        let loop_top = len(code);
        let loop_ctx = map{ top: loop_top, breaks: [], continues: [], step_kind: "top" };
        push(fctx["loops"], loop_ctx);
        _emit_stmt(st, fctx, stmt["body"]);
        let j_back = _emit_jmp(code);
        _patch_rel(code, j_back, loop_top);
        let loop_end = len(code);
        let bi = 0;
        while bi < len(loop_ctx["breaks"]) { _patch_rel(code, loop_ctx["breaks"][bi], loop_end); bi = bi + 1; }
        let ci = 0;
        while ci < len(loop_ctx["continues"]) { _patch_rel(code, loop_ctx["continues"][ci], loop_top); ci = ci + 1; }
        pop(fctx["loops"]);
        return;
    }
    if k == "for_stmt" {
        let vnm = stmt["var1"]["val"];
        _emit_expr_i64(st, fctx, stmt["iter"]);
        _emit_set_i64_var(st, fctx, vnm, REG_RAX);
        let j_cond = _emit_jmp(code);
        let body_top = len(code);
        let loop_ctx = map{ top: body_top, breaks: [], continues: [] };
        push(fctx["loops"], loop_ctx);
        _emit_stmt(st, fctx, stmt["body"]);
        let step_pos = len(code);
        if map_has(fctx["reg_map"], vnm) {
            _emit_add_imm(code, fctx["reg_map"][vnm], 1);
        } else {
            _emit_get_i64_var(st, fctx, vnm, REG_RAX);
            _emit_add_imm(code, REG_RAX, 1);
            _emit_set_i64_var(st, fctx, vnm, REG_RAX);
        }
        let cond_pos = len(code);
        _patch_rel(code, j_cond, cond_pos);
        let cmp_node = map{ kind: "binary", op: "<=", left: map{ kind: "ident", name: vnm }, right: stmt["range_end"] };
        let j_back = _emit_cond_jump_true(st, fctx, cmp_node);
        _patch_rel(code, j_back, body_top);
        let loop_end = len(code);
        let bi = 0;
        while bi < len(loop_ctx["breaks"]) { _patch_rel(code, loop_ctx["breaks"][bi], loop_end); bi = bi + 1; }
        let ci = 0;
        while ci < len(loop_ctx["continues"]) { _patch_rel(code, loop_ctx["continues"][ci], step_pos); ci = ci + 1; }
        pop(fctx["loops"]);
        return;
    }
    if k == "break_stmt" {
        if len(fctx["loops"]) > 0 {
            let lc = fctx["loops"][len(fctx["loops"]) - 1];
            push(lc["breaks"], _emit_jmp(code));
        }
        return;
    }
    if k == "continue_stmt" {
        if len(fctx["loops"]) > 0 {
            let lc = fctx["loops"][len(fctx["loops"]) - 1];
            push(lc["continues"], _emit_jmp(code));
        }
    }
}

// ── Function Compilation (Frame Layout + Callee-Saved `r12..r15` Allocation) ─

fn _compile_one_fn(st, fn_name, params, ret_type, body_stmt) {
    let code = st["code"];
    st["labels"]["fn$" + fn_name] = len(code);

    let fctx = map{
        name: fn_name,
        ret_type: ret_type,
        var_types: map{},
        var_schemas: map{},
        buf_schemas: map{},
        local_order: [],
        reg_map: map{},
        slot_off: map{},
        loops: [],
        ret_jumps: []
    };

    let pi = 0;
    while pi < len(params) {
        let p = params[pi];
        let pt = _norm_annot_type(p["annot"]);
        if pt == "" { pt = "i64"; }
        fctx["var_types"][p["name"]] = pt;
        push(fctx["local_order"], p["name"]);
        pi = pi + 1;
    }

    _prescan_locals(body_stmt, fctx, st);

    // Score variable hotness & promote up to 4 hot non-f64 locals to r12..r15!
    let scores = map{};
    _score_stmt_vars(body_stmt, scores, 1);
    let hw_pool = [REG_R12, REG_R13, REG_R14, REG_R15];
    let used_hw = [];

    let hi = 0;
    while hi < 4 {
        let best_nm = "";
        let best_sc = 0;
        let li = 0;
        while li < len(fctx["local_order"]) {
            let cand = fctx["local_order"][li];
            if fctx["var_types"][cand] != "f64" and not map_has(fctx["reg_map"], cand) {
                let sc = if map_has(scores, cand) { scores[cand] } else { 0 };
                if sc > best_sc {
                    best_sc = sc;
                    best_nm = cand;
                }
            }
            li = li + 1;
        }
        if best_nm == "" { break; }
        fctx["reg_map"][best_nm] = hw_pool[hi];
        push(used_hw, hw_pool[hi]);
        hi = hi + 1;
    }

    // Assign 8-byte stack slots below saved callee regs `[rbp - 8*(len(used_hw) + slot_idx)]`
    let saved_bytes = len(used_hw) * 8;
    let stack_slots = 0;
    let si = 0;
    while si < len(fctx["local_order"]) {
        let vnm = fctx["local_order"][si];
        if not map_has(fctx["reg_map"], vnm) {
            stack_slots = stack_slots + 1;
            fctx["slot_off"][vnm] = 0 - (saved_bytes + stack_slots * 8);
        }
        si = si + 1;
    }

    // Keep RSP 16-byte aligned after `push rbp` + `len(used_hw)` pushes + `sub rsp, frame_sub`
    let raw_sub = stack_slots * 8;
    let total_after_pushes = saved_bytes + raw_sub;
    let frame_sub = raw_sub;
    if (total_after_pushes % 16) != 0 {
        frame_sub = frame_sub + 8;
    }

    // Prologue
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    let ui = 0;
    while ui < len(used_hw) {
        _emit_push(code, used_hw[ui]);
        ui = ui + 1;
    }
    if frame_sub > 0 {
        _emit_sub_imm(code, REG_RSP, frame_sub);
    }

    // Move incoming argument registers (rdi, rsi, rdx, rcx, r8, r9) into assigned home
    let arg_regs = [REG_RDI, REG_RSI, REG_RDX, REG_RCX, REG_R8, REG_R9];
    let ai = 0;
    while ai < len(params) and ai < 6 {
        let pnm = params[ai]["name"];
        if fctx["var_types"][pnm] == "f64" {
            _emit_movq_xmm_gpr(code, 0, arg_regs[ai]);
            _emit_set_f64_var(st, fctx, pnm, 0);
        } else {
            _emit_set_i64_var(st, fctx, pnm, arg_regs[ai]);
        }
        ai = ai + 1;
    }

    // Body
    _emit_mov_imm64(code, REG_RAX, 0);
    _emit_stmt(st, fctx, body_stmt);

    // Epilogue label
    let epilogue_pos = len(code);
    let rji = 0;
    while rji < len(fctx["ret_jumps"]) {
        _patch_rel(code, fctx["ret_jumps"][rji], epilogue_pos);
        rji = rji + 1;
    }
    if frame_sub > 0 {
        _emit_add_imm(code, REG_RSP, frame_sub);
    }
    let uj = len(used_hw) - 1;
    while uj >= 0 {
        _emit_pop(code, used_hw[uj]);
        uj = uj - 1;
    }
    _emit_pop(code, REG_RBP);
    push(code, 195); // ret
}

// ── Pure Machine-Code Runtime Subroutines (Linux Syscall & Win32 PE32+ ABIs) ─

fn _emit_runtime_routines(st, is_pe64) {
    let code = st["code"];

    // 1. `rt$write` (rsi = buf ptr, rdx = byte len)
    st["labels"]["rt$write"] = len(code);
    if not is_pe64 {
        // Linux x86-64 `sys_write(1, rsi, rdx)`
        _emit_test_rr(code, REG_RDX, REG_RDX);
        let jz_w = _emit_jcc(code, 132);
        push(code, 184); _le(code, 1, 4); // mov eax, 1
        push(code, 191); _le(code, 1, 4); // mov edi, 1
        push(code, 15); push(code, 5);    // syscall
        _patch_rel(code, jz_w, len(code));
        push(code, 195); // ret
    } else {
        // Windows x64 `WriteFile(stdout_h, buf, len, &written_dw, NULL)` with 16B stack alignment + 48B shadow/arg5
        _emit_push(code, REG_RBP);
        _emit_mov_rr(code, REG_RBP, REG_RSP);
        push(code, 72); push(code, 131); push(code, 228); push(code, 240); // and rsp, -16
        _emit_sub_imm(code, REG_RSP, 48);
        _emit_load_rip64(st, REG_RCX, "rw", "sys_stdout_h"); // rcx = hStdout
        _emit_mov_rr(code, REG_R8, REG_RDX);                 // r8 = len
        _emit_mov_rr(code, REG_RDX, REG_RSI);                // rdx = buf
        _emit_lea_rip(st, REG_R9, "rw", "sys_written_dw");   // r9 = &written
        _emit_mov_imm64(code, REG_RAX, 0);
        _emit_store64(code, REG_RSP, 32, REG_RAX);           // [rsp+32] = NULL
        _emit_win32_iat_call(st, "WriteFile");
        _emit_mov_rr(code, REG_RSP, REG_RBP);
        _emit_pop(code, REG_RBP);
        push(code, 195);
    }

    // 2. `rt$exit` (rdi = exit status)
    st["labels"]["rt$exit"] = len(code);
    if not is_pe64 {
        push(code, 184); _le(code, 60, 4); // mov eax, 60 (sys_exit)
        push(code, 15); push(code, 5);     // syscall
    } else {
        push(code, 72); push(code, 131); push(code, 228); push(code, 240);
        _emit_sub_imm(code, REG_RSP, 32);
        _emit_mov_rr(code, REG_RCX, REG_RDI);
        _emit_win32_iat_call(st, "ExitProcess");
    }

    // 3. `rt$alloc` (rdi = requested bytes -> returns 16B-aligned zeroed pointer in RAX)
    st["labels"]["rt$alloc"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_push(code, REG_RBX);
    _emit_sub_imm(code, REG_RSP, 8);
    // Align rdi up to 16 bytes: `add rdi, 15; and rdi, -16`
    _emit_add_imm(code, REG_RDI, 15);
    push(code, 72); push(code, 131); push(code, 231); push(code, 240);
    _emit_mov_rr(code, REG_RBX, REG_RDI); // rbx = aligned size

    _emit_load_rip64(st, REG_RAX, "rw", "sys_heap_cur");
    _emit_load_rip64(st, REG_RCX, "rw", "sys_heap_end");
    _emit_mov_rr(code, REG_RDX, REG_RAX);
    _emit_add_rr(code, REG_RDX, REG_RBX);
    _emit_test_rr(code, REG_RAX, REG_RAX);
    let j_refill1 = _emit_jcc(code, 132); // je refill
    _emit_cmp_rr(code, REG_RDX, REG_RCX);
    let j_refill2 = _emit_jcc(code, 135); // ja refill (unsigned)
    _emit_store_rip64(st, REG_RDX, "rw", "sys_heap_cur");
    let j_alloc_done = _emit_jmp(code);

    let refill_pos = len(code);
    _patch_rel(code, j_refill1, refill_pos);
    _patch_rel(code, j_refill2, refill_pos);
    // Chunk = max(rbx + 4096, 16777216 [16 MiB])
    _emit_mov_imm64(code, REG_RSI, 16777216);
    _emit_mov_rr(code, REG_RAX, REG_RBX);
    _emit_add_imm(code, REG_RAX, 4096);
    _emit_cmp_rr(code, REG_RAX, REG_RSI);
    push(code, 72); push(code, 15); push(code, 79); push(code, 240); // 48 0F 4F F0: cmovg rsi, rax
    _emit_push(code, REG_RSI);

    if not is_pe64 {
        // Linux `mmap(NULL, rsi, PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANONYMOUS=34, -1, 0)` (syscall 9)
        _emit_mov_imm64(code, REG_RDI, 0);
        _emit_mov_imm64(code, REG_RDX, 3);
        _emit_mov_imm64(code, REG_R10, 34);
        _emit_mov_imm64(code, REG_R8, -1);
        _emit_mov_imm64(code, REG_R9, 0);
        _emit_mov_imm64(code, REG_RAX, 9);
        push(code, 15); push(code, 5); // syscall
    } else {
        // Windows `VirtualAlloc(NULL, rsi, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=4)`
        _emit_sub_imm(code, REG_RSP, 32);
        _emit_mov_imm64(code, REG_RCX, 0);
        _emit_mov_rr(code, REG_RDX, REG_RSI);
        _emit_mov_imm64(code, REG_R8, 12288);
        _emit_mov_imm64(code, REG_R9, 4);
        _emit_win32_iat_call(st, "VirtualAlloc");
        _emit_add_imm(code, REG_RSP, 32);
    }
    _emit_pop(code, REG_RSI); // chunk size
    _emit_mov_rr(code, REG_RDX, REG_RAX);
    _emit_add_rr(code, REG_RDX, REG_RBX);
    _emit_store_rip64(st, REG_RDX, "rw", "sys_heap_cur");
    _emit_mov_rr(code, REG_RCX, REG_RAX);
    _emit_add_rr(code, REG_RCX, REG_RSI);
    _emit_store_rip64(st, REG_RCX, "rw", "sys_heap_end");

    _patch_rel(code, j_alloc_done, len(code));
    _emit_add_imm(code, REG_RSP, 8);
    _emit_pop(code, REG_RBX);
    _emit_pop(code, REG_RBP);
    push(code, 195);

    // 3b. `rt$unseal_ro_str` (rdi = sealed `[u64 len][u8 seed][xor_bytes][0]` -> returns heap `[u64 len][bytes]` in RAX)
    if st["obfuscate_strings"] {
        st["labels"]["rt$unseal_ro_str"] = len(code);
        _emit_push(code, REG_RBP);
        _emit_mov_rr(code, REG_RBP, REG_RSP);
        _emit_push(code, REG_RBX);
        _emit_push(code, REG_R12);
        push(code, 72); push(code, 131); push(code, 228); push(code, 240); // and rsp, -16
        _emit_mov_rr(code, REG_RBX, REG_RDI); // rbx = sealed ro_ptr
        _emit_load64(code, REG_R12, REG_RBX, 0); // r12 = byte_len
        _emit_mov_rr(code, REG_RDI, REG_R12);
        _emit_add_imm(code, REG_RDI, 16);
        _emit_call_sym(st, "rt$alloc"); // rax = zeroed heap str_ptr
        _emit_store64(code, REG_RAX, 0, REG_R12);
        _emit_load_u8(code, REG_R8, REG_RBX, 8); // r8 = rolling seed
        _emit_mov_imm64(code, REG_RCX, 0); // rcx = bi
        let unseal_loop = len(code);
        _emit_cmp_rr(code, REG_RCX, REG_R12);
        let j_unseal_done = _emit_jcc(code, 141); // jge
        _emit_imul_imm(code, REG_RDX, REG_RCX, 29);
        _emit_add_rr(code, REG_RDX, REG_R8);
        _emit_add_imm(code, REG_RDX, 19);
        _emit_mov_rr(code, REG_RSI, REG_RBX);
        _emit_add_rr(code, REG_RSI, REG_RCX);
        _emit_load_u8(code, REG_R9, REG_RSI, 9);
        _emit_xor_rr(code, REG_RDX, REG_R9);
        _emit_mov_rr(code, REG_RDI, REG_RAX);
        _emit_add_rr(code, REG_RDI, REG_RCX);
        _emit_store_u8(code, REG_RDI, 8, REG_RDX);
        _emit_add_imm(code, REG_RCX, 1);
        let j_unseal_back = _emit_jmp(code);
        _patch_rel(code, j_unseal_back, unseal_loop);
        _patch_rel(code, j_unseal_done, len(code));
        _emit_lea(code, REG_RSP, REG_RBP, -16);
        _emit_pop(code, REG_R12);
        _emit_pop(code, REG_RBX);
        _emit_pop(code, REG_RBP);
        push(code, 195);
    }

    // 4. `rt$print_nl` (stack-immediate byte 10 so even '\n' needs no .rodata literal)
    st["labels"]["rt$print_nl"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_sub_imm(code, REG_RSP, 16);
    _emit_mov_imm64(code, REG_RDX, 10);
    _emit_store_u8(code, REG_RSP, 0, REG_RDX);
    _emit_mov_rr(code, REG_RSI, REG_RSP);
    _emit_mov_imm64(code, REG_RDX, 1);
    _emit_call_sym(st, "rt$write");
    _emit_add_imm(code, REG_RSP, 16);
    _emit_pop(code, REG_RBP);
    push(code, 195);

    // 5. `rt$print_str` (rdi = str_ptr -> [rdi]=len, rdi+8=bytes)
    st["labels"]["rt$print_str"] = len(code);
    _emit_load64(code, REG_RDX, REG_RDI, 0);
    _emit_lea(code, REG_RSI, REG_RDI, 8);
    _emit_call_sym(st, "rt$write");
    push(code, 195);

    // 6. `rt$bool_to_str` & `rt$print_bool` (rdi = 0/1)
    let true_id = _intern_str(st, "true");
    let false_id = _intern_str(st, "false");
    st["labels"]["rt$bool_to_str"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_test_rr(code, REG_RDI, REG_RDI);
    let jb_f = _emit_jcc(code, 132);
    if st["obfuscate_strings"] {
        _emit_lea_rip(st, REG_RDI, "ro_str", str(true_id));
        _emit_call_sym(st, "rt$unseal_ro_str");
    } else {
        _emit_lea_rip(st, REG_RAX, "ro_str", str(true_id));
    }
    _emit_pop(code, REG_RBP);
    push(code, 195);
    _patch_rel(code, jb_f, len(code));
    if st["obfuscate_strings"] {
        _emit_lea_rip(st, REG_RDI, "ro_str", str(false_id));
        _emit_call_sym(st, "rt$unseal_ro_str");
    } else {
        _emit_lea_rip(st, REG_RAX, "ro_str", str(false_id));
    }
    _emit_pop(code, REG_RBP);
    push(code, 195);

    st["labels"]["rt$print_bool"] = len(code);
    _emit_call_sym(st, "rt$bool_to_str");
    _emit_mov_rr(code, REG_RDI, REG_RAX);
    _emit_call_sym(st, "rt$print_str");
    push(code, 195);

    // 7. `rt$i64_to_str` (rdi = signed i64 -> returns heap str_ptr `[len][chars]` in RAX)
    st["labels"]["rt$i64_to_str"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_push(code, REG_RBX);
    _emit_sub_imm(code, REG_RSP, 40); // stack scratch at [rbp - 40 .. -8]
    _emit_mov_rr(code, REG_RBX, REG_RDI); // rbx = original value

    _emit_mov_imm64(code, REG_RDI, 40);
    _emit_call_sym(st, "rt$alloc");
    _emit_mov_rr(code, REG_R8, REG_RAX); // r8 = heap str hdr

    // Format backwards into [rbp - 8] down
    _emit_lea(code, REG_RSI, REG_RBP, -9); // cursor
    _emit_mov_imm64(code, REG_R9, 0);      // sign flag
    _emit_mov_rr(code, REG_RAX, REG_RBX);
    _emit_test_rr(code, REG_RAX, REG_RAX);
    let j_nonneg = _emit_jcc(code, 141); // jge
    _emit_mov_imm64(code, REG_R9, 1);
    push(code, 72); push(code, 247); push(code, 216); // neg rax
    _patch_rel(code, j_nonneg, len(code));

    _emit_mov_imm64(code, REG_RCX, 10);
    let dig_loop = len(code);
    push(code, 49); push(code, 210); // xor edx, edx (unsigned div so -INT64_MIN also works!)
    push(code, 72); push(code, 247); push(code, 241); // 48 F7 F1: div rcx
    _emit_add_imm(code, REG_RDX, 48);
    _emit_store_u8(code, REG_RSI, 0, REG_RDX);
    _emit_sub_imm(code, REG_RSI, 1);
    _emit_test_rr(code, REG_RAX, REG_RAX);
    let j_more = _emit_jcc(code, 133); // jne
    _patch_rel(code, j_more, dig_loop);

    _emit_test_rr(code, REG_R9, REG_R9);
    let j_nominus = _emit_jcc(code, 132); // je
    _emit_mov_imm64(code, REG_RDX, 45); // '-'
    _emit_store_u8(code, REG_RSI, 0, REG_RDX);
    _emit_sub_imm(code, REG_RSI, 1);
    _patch_rel(code, j_nominus, len(code));

    _emit_add_imm(code, REG_RSI, 1); // rsi = start of formatted digits
    _emit_lea(code, REG_RCX, REG_RBP, -8);
    _emit_sub_rr(code, REG_RCX, REG_RSI); // rcx = char count
    _emit_store64(code, REG_R8, 0, REG_RCX);
    // Copy rcx bytes from [rsi] to [r8 + 8]
    _emit_lea(code, REG_RDI, REG_R8, 8);
    let cp_loop = len(code);
    _emit_test_rr(code, REG_RCX, REG_RCX);
    let j_cp_done = _emit_jcc(code, 132);
    _emit_load_u8(code, REG_RAX, REG_RSI, 0);
    _emit_store_u8(code, REG_RDI, 0, REG_RAX);
    _emit_add_imm(code, REG_RSI, 1);
    _emit_add_imm(code, REG_RDI, 1);
    _emit_sub_imm(code, REG_RCX, 1);
    let j_cp_b = _emit_jmp(code);
    _patch_rel(code, j_cp_b, cp_loop);
    _patch_rel(code, j_cp_done, len(code));

    _emit_mov_rr(code, REG_RAX, REG_R8);
    _emit_add_imm(code, REG_RSP, 40);
    _emit_pop(code, REG_RBX);
    _emit_pop(code, REG_RBP);
    push(code, 195);

    // 8. `rt$print_i64` (rdi = signed i64)
    st["labels"]["rt$print_i64"] = len(code);
    _emit_call_sym(st, "rt$i64_to_str");
    _emit_mov_rr(code, REG_RDI, REG_RAX);
    _emit_call_sym(st, "rt$print_str");
    push(code, 195);

    // 9. `rt$f64_to_str` & `rt$print_f64` (xmm0 = f64)
    st["labels"]["rt$f64_to_str"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_push(code, REG_RBX);
    _emit_push(code, REG_R12);
    _emit_sub_imm(code, REG_RSP, 32);

    // Extract sign bit & abs(xmm0)
    _emit_movq_gpr_xmm(code, REG_RAX, 0);
    _emit_mov_rr(code, REG_R12, REG_RAX);
    push(code, 73); push(code, 193); push(code, 236); push(code, 63); // 49 C1 EC 3F: shr r12, 63 (sign 0/1)
    push(code, 73); push(code, 187); // movabs r11, 0x7FFFFFFFFFFFFFFF
    let mk = 0; while mk < 7 { push(code, 255); mk = mk + 1; } push(code, 127);
    push(code, _rex_w(REG_R11, 0, REG_RAX)); push(code, 33); push(code, _modrm(3, REG_R11, REG_RAX));
    _emit_movq_xmm_gpr(code, 0, REG_RAX);

    // Round `abs_val * 1000000.0 + 0.5` -> integer micro-units in RBX
    _emit_mov_xmm_f64_imm(code, 1, 1000000.0);
    _emit_sse_bin(code, 89, 0, 1); // mulsd
    _emit_mov_xmm_f64_imm(code, 1, 0.5);
    _emit_sse_bin(code, 88, 0, 1); // addsd
    _emit_cvttsd2si(code, REG_RBX, 0); // rbx = scaled int >= 0

    // int_part = rbx / 1000000, frac_part = rbx % 1000000
    _emit_mov_rr(code, REG_RAX, REG_RBX);
    _emit_mov_imm64(code, REG_RCX, 1000000);
    push(code, 49); push(code, 210); // xor edx, edx
    push(code, 72); push(code, 247); push(code, 241); // div rcx -> rax=int_part, rdx=frac_part
    _emit_store64(code, REG_RBP, -24, REG_RDX); // save frac_part
    _emit_test_rr(code, REG_R12, REG_R12);
    let jf_pos = _emit_jcc(code, 132);
    push(code, 72); push(code, 247); push(code, 216); // neg rax (ifint_part > 0; handle -0.xxx below)
    _patch_rel(code, jf_pos, len(code));
    _emit_mov_rr(code, REG_RDI, REG_RAX);
    _emit_call_sym(st, "rt$i64_to_str");
    _emit_mov_rr(code, REG_RBX, REG_RAX); // rbx = int_str_ptr

    // If sign == 1 and int_part == 0 (`[rbx+8] != '-'`), prepend "-"
    _emit_test_rr(code, REG_R12, REG_R12);
    let jf_nosignfix = _emit_jcc(code, 132);
    _emit_load_u8(code, REG_RAX, REG_RBX, 8);
    _emit_cmp_imm(code, REG_RAX, 45);
    let jf_hasminus = _emit_jcc(code, 132);
    let minus_id = _intern_str(st, "-");
    if st["obfuscate_strings"] {
        _emit_lea_rip(st, REG_RDI, "ro_str", str(minus_id));
        _emit_call_sym(st, "rt$unseal_ro_str");
        _emit_mov_rr(code, REG_RDI, REG_RAX);
    } else {
        _emit_lea_rip(st, REG_RDI, "ro_str", str(minus_id));
    }
    _emit_mov_rr(code, REG_RSI, REG_RBX);
    _emit_call_sym(st, "rt$str_concat");
    _emit_mov_rr(code, REG_RBX, REG_RAX);
    _patch_rel(code, jf_hasminus, len(code));
    _patch_rel(code, jf_nosignfix, len(code));

    // Check frac_part
    _emit_load64(code, REG_RDX, REG_RBP, -24);
    _emit_test_rr(code, REG_RDX, REG_RDX);
    let jf_exact_int = _emit_jcc(code, 132); // if frac == 0, return int_str directly (matches PBLang num formatting!)

    // Allocate 16B for ".dddddd" fractional suffix
    _emit_mov_imm64(code, REG_RDI, 24);
    _emit_call_sym(st, "rt$alloc");
    _emit_mov_rr(code, REG_R8, REG_RAX);
    _emit_mov_imm64(code, REG_RAX, 46); // '.'
    _emit_store_u8(code, REG_R8, 8, REG_RAX);
    // Write 6 digits at [r8 + 9..14] backwards
    _emit_load64(code, REG_RAX, REG_RBP, -24);
    _emit_mov_imm64(code, REG_RCX, 10);
    _emit_mov_imm64(code, REG_RSI, 6);
    let fd_loop = len(code);
    push(code, 49); push(code, 210);
    push(code, 72); push(code, 247); push(code, 241); // div rcx -> rdx = digit
    _emit_add_imm(code, REG_RDX, 48);
    _emit_mov_rr(code, REG_RDI, REG_R8);
    _emit_add_rr(code, REG_RDI, REG_RSI);
    _emit_store_u8(code, REG_RDI, 8, REG_RDX);
    _emit_sub_imm(code, REG_RSI, 1);
    let j_fd_more = _emit_jcc(code, 133); // jne
    _patch_rel(code, j_fd_more, fd_loop);

    // Strip trailing '0's from fractional suffix (len starts at 7 = '.' + 6 digits)
    _emit_mov_imm64(code, REG_RCX, 7);
    let trim_loop = len(code);
    _emit_cmp_imm(code, REG_RCX, 2);
    let j_trim_done = _emit_jcc(code, 142); // jle
    _emit_mov_rr(code, REG_RDI, REG_R8);
    _emit_add_rr(code, REG_RDI, REG_RCX);
    _emit_load_u8(code, REG_RAX, REG_RDI, 7); // byte at [r8 + 8 + rcx - 1]
    _emit_cmp_imm(code, REG_RAX, 48); // '0'
    let j_trim_done2 = _emit_jcc(code, 133); // jne
    _emit_sub_imm(code, REG_RCX, 1);
    let j_trim_b = _emit_jmp(code);
    _patch_rel(code, j_trim_b, trim_loop);
    _patch_rel(code, j_trim_done, len(code));
    _patch_rel(code, j_trim_done2, len(code));
    _emit_store64(code, REG_R8, 0, REG_RCX);

    _emit_mov_rr(code, REG_RDI, REG_RBX);
    _emit_mov_rr(code, REG_RSI, REG_R8);
    _emit_call_sym(st, "rt$str_concat");
    _emit_mov_rr(code, REG_RBX, REG_RAX);

    _patch_rel(code, jf_exact_int, len(code));
    _emit_mov_rr(code, REG_RAX, REG_RBX);
    _emit_add_imm(code, REG_RSP, 32);
    _emit_pop(code, REG_R12);
    _emit_pop(code, REG_RBX);
    _emit_pop(code, REG_RBP);
    push(code, 195);

    st["labels"]["rt$print_f64"] = len(code);
    _emit_call_sym(st, "rt$f64_to_str");
    _emit_mov_rr(code, REG_RDI, REG_RAX);
    _emit_call_sym(st, "rt$print_str");
    push(code, 195);

    // 10. `rt$str_concat` (rdi = s1, rsi = s2 -> returns new str_ptr in RAX)
    st["labels"]["rt$str_concat"] = len(code);
    _emit_push(code, REG_RBP);
    _emit_mov_rr(code, REG_RBP, REG_RSP);
    _emit_push(code, REG_RBX);
    _emit_push(code, REG_R12);
    _emit_mov_rr(code, REG_RBX, REG_RDI); // s1
    _emit_mov_rr(code, REG_R12, REG_RSI); // s2
    _emit_load64(code, REG_RDI, REG_RBX, 0);
    _emit_load64(code, REG_RCX, REG_R12, 0);
    _emit_add_rr(code, REG_RDI, REG_RCX);
    _emit_push(code, REG_RDI); // total_len
    _emit_add_imm(code, REG_RDI, 16);
    _emit_call_sym(st, "rt$alloc");
    _emit_pop(code, REG_RCX); // total_len
    _emit_store64(code, REG_RAX, 0, REG_RCX);
    _emit_lea(code, REG_RDI, REG_RAX, 8);
    // Copy s1
    _emit_load64(code, REG_RCX, REG_RBX, 0);
    _emit_lea(code, REG_RSI, REG_RBX, 8);
    let c1_top = len(code);
    _emit_test_rr(code, REG_RCX, REG_RCX);
    let c1_end = _emit_jcc(code, 132);
    _emit_load_u8(code, REG_RDX, REG_RSI, 0);
    _emit_store_u8(code, REG_RDI, 0, REG_RDX);
    _emit_add_imm(code, REG_RSI, 1);
    _emit_add_imm(code, REG_RDI, 1);
    _emit_sub_imm(code, REG_RCX, 1);
    let c1_b = _emit_jmp(code);
    _patch_rel(code, c1_b, c1_top);
    _patch_rel(code, c1_end, len(code));
    // Copy s2
    _emit_load64(code, REG_RCX, REG_R12, 0);
    _emit_lea(code, REG_RSI, REG_R12, 8);
    let c2_top = len(code);
    _emit_test_rr(code, REG_RCX, REG_RCX);
    let c2_end = _emit_jcc(code, 132);
    _emit_load_u8(code, REG_RDX, REG_RSI, 0);
    _emit_store_u8(code, REG_RDI, 0, REG_RDX);
    _emit_add_imm(code, REG_RSI, 1);
    _emit_add_imm(code, REG_RDI, 1);
    _emit_sub_imm(code, REG_RCX, 1);
    let c2_b = _emit_jmp(code);
    _patch_rel(code, c2_b, c2_top);
    _patch_rel(code, c2_end, len(code));

    _emit_pop(code, REG_R12);
    _emit_pop(code, REG_RBX);
    _emit_pop(code, REG_RBP);
    push(code, 195);

    // 11. `rt$time_ms` (returns monotonic milliseconds in RAX)
    st["labels"]["rt$time_ms"] = len(code);
    if not is_pe64 {
        // Linux `clock_gettime(CLOCK_MONOTONIC=1, rsp)` (syscall 228)
        _emit_sub_imm(code, REG_RSP, 24);
        _emit_mov_imm64(code, REG_RDI, 1);
        _emit_mov_rr(code, REG_RSI, REG_RSP);
        _emit_mov_imm64(code, REG_RAX, 228);
        push(code, 15); push(code, 5); // syscall
        _emit_load64(code, REG_RCX, REG_RSP, 0); // tv_sec
        _emit_imul_imm(code, REG_RCX, REG_RCX, 1000);
        _emit_load64(code, REG_RAX, REG_RSP, 8); // tv_nsec
        _emit_mov_imm64(code, REG_RSI, 1000000);
        push(code, 49); push(code, 210);
        push(code, 72); push(code, 247); push(code, 246); // div rsi -> rax = ns / 1e6
        _emit_add_rr(code, REG_RAX, REG_RCX);
        _emit_add_imm(code, REG_RSP, 24);
        push(code, 195);
    } else {
        _emit_push(code, REG_RBP);
        _emit_mov_rr(code, REG_RBP, REG_RSP);
        push(code, 72); push(code, 131); push(code, 228); push(code, 240);
        _emit_sub_imm(code, REG_RSP, 32);
        _emit_win32_iat_call(st, "GetTickCount64");
        _emit_mov_rr(code, REG_RSP, REG_RBP);
        _emit_pop(code, REG_RBP);
        push(code, 195);
    }
}

// ── Top-Level Pure-PBLang Compilation Driver (`ELF64` & `PE32+`) ──────────────

fn _resolve_aot_shield_opts(opts) {
    let o = if opts != nil and type(opts) == "map" { opts } else { map{} };
    let is_free = (map_has(o, "mode") and str_lower(str(o["mode"])) == "free")
        or (map_has(o, "ip_mode") and str_lower(str(o["ip_mode"])) == "free");
    let strip_syms = not is_free;
    if map_has(o, "strip_symbols") { strip_syms = o["strip_symbols"] == true; }
    if map_has(o, "open_symbols") and o["open_symbols"] == true { strip_syms = false; }
    let obf_strs = not is_free;
    if map_has(o, "obfuscate_strings") { obf_strs = o["obfuscate_strings"] == true; }
    return map{
        strip_symbols: strip_syms,
        obfuscate_strings: obf_strs
    };
}

fn _compile_unboxed_core(source, is_pe64, opts = nil) {
    let shield = _resolve_aot_shield_opts(opts);
    let parsed = SC.parse_sapp_ast(source);
    if len(parsed["errors"]) > 0 {
        throw "aot_unboxed_native: syntax error: " + parsed["errors"][0]["message"];
    }
    // Enforce @nogc rules before codegen!
    let nogc_rep = SC.check_nogc_functions(parsed);
    if not nogc_rep["ok"] {
        throw "aot_unboxed_native: " + nogc_rep["violations"][0]["message"];
    }

    let ast_stmts = parsed["ast"]["stmts"];
    let st = map{
        code: [],
        labels: map{},
        calls: [],
        rip_fixes: [],
        str_map: map{},
        str_list: [],
        globals: map{},
        global_types: map{},
        global_list: [],
        schemas: map{},
        buf_schemas: map{},
        fn_ret_types: map{},
        fn_param_types: map{},
        strip_symbols: shield["strip_symbols"],
        obfuscate_strings: shield["obfuscate_strings"],
        fn_names: []
    };

    let fn_decls = [];
    let top_stmts = [];
    let has_user_main = false;

    // Pass 1: Collect `@packed struct` schemas, function signatures, and top-level globals
    let i = 0;
    while i < len(ast_stmts) {
        let s = ast_stmts[i];
        let sk = s["kind"];
        if sk == "struct_decl" {
            let fspecs = [];
            let fi = 0;
            while fi < len(s["fields"]) {
                let fld = s["fields"][fi];
                let ft = _norm_annot_type(fld["annot"]);
                let fsz = 8;
                if fld["annot"] != nil and map_has(fld["annot"], "raw") {
                    let rw = fld["annot"]["raw"];
                    if rw == "i32" or rw == "u32" { ft = "i32"; fsz = 4; }
                    elif rw == "u8" or rw == "byte" or rw == "bool" { ft = "u8"; fsz = 1; }
                }
                if ft == "" { ft = "i64"; }
                push(fspecs, map{ name: fld["name"], kind: ft, size: fsz });
                fi = fi + 1;
            }
            st["schemas"][s["name"]] = _build_schema_layout(fspecs);
        } elif sk == "fn_decl" {
            push(fn_decls, s);
            push(st["fn_names"], s["name"]);
            if s["name"] == "main" { has_user_main = true; }
            let rt = _norm_annot_type(s["ret_annot"]);
            if rt == "" { rt = "i64"; }
            st["fn_ret_types"][s["name"]] = rt;
            let pts = [];
            let pi = 0;
            while pi < len(s["params"]) {
                let pt = _norm_annot_type(s["params"][pi]["annot"]);
                if pt == "" { pt = "i64"; }
                push(pts, pt);
                pi = pi + 1;
            }
            st["fn_param_types"][s["name"]] = pts;
        } elif sk != "empty" and sk != "export_stmt" {
            push(top_stmts, s);
            if sk == "var_decl" {
                let gnm = s["name"];
                if s["init"] != nil and s["init"]["kind"] == "call" {
                    let gcn = s["init"]["callee"]["name"];
                    if gcn == "struct_schema" {
                        let glay = _extract_schema_from_call(s["init"], st);
                        if glay != nil { st["schemas"][gnm] = glay; }
                    } elif gcn == "struct_buf_new" and len(s["init"]["args"]) >= 1 and s["init"]["args"][0]["kind"] == "ident" {
                        let gsnm = s["init"]["args"][0]["name"];
                        if map_has(st["schemas"], gsnm) { st["buf_schemas"][gnm] = st["schemas"][gsnm]; }
                    }
                }
                // Only promote to RW global if there are user functions that might reference it;
                // if there are NO user functions (or inside `__aot_entry`), keeping top-level vars as locals promotes them to r12..r15!
            }
        }
        i = i + 1;
    }

    // If user functions exist, expose top-level `let`/`const` bindings referenced by user functions as RW globals;
    // otherwise keep them in `__aot_entry` so top-level `while`/`for` loops get hardware `r12..r15` registers!
    if len(fn_decls) > 0 {
        let ti = 0;
        while ti < len(top_stmts) {
            let ts = top_stmts[ti];
            if ts["kind"] == "var_decl" {
                let gnm = ts["name"];
                let gt = _norm_annot_type(ts["annot"]);
                if gt == "" and ts["init"] != nil {
                    gt = _infer_expr_type(ts["init"], map{ var_types: st["global_types"] }, st);
                }
                if gt == "" { gt = "i64"; }
                st["globals"][gnm] = true;
                st["global_types"][gnm] = gt;
                push(st["global_list"], gnm);
            }
            ti = ti + 1;
        }
    }

    // Emit `_start` / PE entry stub at offset 0 of `.text`!
    let code = st["code"];
    push(code, 72); push(code, 131); push(code, 228); push(code, 240); // and rsp, -16
    if is_pe64 {
        _emit_sub_imm(code, REG_RSP, 32);
        _emit_mov_imm64(code, REG_RCX, -11); // STD_OUTPUT_HANDLE
        _emit_win32_iat_call(st, "GetStdHandle");
        _emit_store_rip64(st, REG_RAX, "rw", "sys_stdout_h");
        _emit_add_imm(code, REG_RSP, 32);
    }
    _emit_call_sym(st, "fn$__aot_entry");
    if has_user_main and len(top_stmts) == 0 {
        _emit_call_sym(st, "fn$main");
    }
    _emit_mov_imm64(code, REG_RDI, 0);
    _emit_call_sym(st, "rt$exit");

    // Compile `__aot_entry` + all user functions + runtime routines
    let entry_block = map{ kind: "block", stmts: top_stmts, tail_expr: nil };
    _compile_one_fn(st, "__aot_entry", [], "i64", entry_block);

    let fdi = 0;
    while fdi < len(fn_decls) {
        let fd = fn_decls[fdi];
        _compile_one_fn(st, fd["name"], fd["params"], st["fn_ret_types"][fd["name"]], fd["body"]);
        fdi = fdi + 1;
    }

    _emit_runtime_routines(st, is_pe64);

    // Resolve all internal `call rel32`
    let ci = 0;
    while ci < len(st["calls"]) {
        let c = st["calls"][ci];
        if not map_has(st["labels"], c["name"]) {
            throw "aot_unboxed_native: unresolved function '" + str_slice(c["name"], 3, len(c["name"])) + "'";
        }
        _patch32(code, c["at"], st["labels"][c["name"]] - (c["at"] + 4));
        ci = ci + 1;
    }

    // Build `.rodata` string pool:
    //   - Default proprietary (`obfuscate_strings == true`): `[u64 byte_len][u8 seed][rolling_xor_bytes...][0]`
    //   - Open/free (`obfuscate_strings == false`): `[u64 byte_len][utf8 bytes...][0]`
    let rodata = [];
    let ro_str_offs = map{};
    let si = 0;
    while si < len(st["str_list"]) {
        while (len(rodata) % 8) != 0 { push(rodata, 0); }
        ro_str_offs[str(si)] = len(rodata);
        let sbytes = str_to_bytes(st["str_list"][si]);
        _le(rodata, len(sbytes), 8);
        if st["obfuscate_strings"] {
            let seed = bit_and(167 + si * 37, 255);
            push(rodata, seed);
            let bi = 0;
            while bi < len(sbytes) {
                let mask = bit_and(seed + bi * 29 + 19, 255);
                push(rodata, bit_xor(sbytes[bi], mask));
                bi = bi + 1;
            }
        } else {
            let bi = 0;
            while bi < len(sbytes) { push(rodata, sbytes[bi]); bi = bi + 1; }
        }
        push(rodata, 0);
        si = si + 1;
    }
    while (len(rodata) % 16) != 0 { push(rodata, 0); }

    if not is_pe64 {
        return _pack_elf64_image(st, rodata, ro_str_offs);
    }
    return _pack_pe64_image(st, rodata, ro_str_offs);
}

fn _append_open_symtab_note(bin_buf, st) {
    if st["strip_symbols"] { return; }
    _push_slice(bin_buf, str_to_bytes("PBLANG_SYMTAB:"));
    push(bin_buf, 0);
    let i = 0;
    while i < len(st["fn_names"]) {
        _push_slice(bin_buf, str_to_bytes(st["fn_names"][i]));
        push(bin_buf, 0);
        i = i + 1;
    }
}

fn _pack_elf64_image(st, rodata, ro_str_offs) {
    let code = st["code"];
    let VBASE = 4194304; // 0x400000
    let EHSIZE = 64;
    let PHSIZE = 56;
    let code_off = EHSIZE + PHSIZE; // 120

    let ro_off = _align_up(code_off + len(code), 16);
    let code_pad = ro_off - (code_off + len(code));
    let rw_off = _align_up(ro_off + len(rodata), 16);
    let ro_pad = rw_off - (ro_off + len(rodata));

    let rw_offs = map{};
    let rw_cursor = rw_off;
    let sys_slots = ["sys_heap_cur", "sys_heap_end", "sys_stdout_h", "sys_written_dw"];
    let sk = 0;
    while sk < len(sys_slots) {
        rw_offs[sys_slots[sk]] = rw_cursor;
        rw_cursor = rw_cursor + 8;
        sk = sk + 1;
    }
    let gk = 0;
    while gk < len(st["global_list"]) {
        rw_offs["g_" + st["global_list"][gk]] = rw_cursor;
        rw_cursor = rw_cursor + 8;
        gk = gk + 1;
    }
    let mem_sz = rw_cursor;
    let file_sz = rw_off; // RW globals live in zero-initialized `.bss` (`p_memsz > p_filesz`)!

    // Patch RIP-relative fixups
    let fi = 0;
    while fi < len(st["rip_fixes"]) {
        let fx = st["rip_fixes"][fi];
        let next_rip_off = code_off + fx["pos"] + 4;
        let tgt_off = 0;
        if fx["kind"] == "ro_str" {
            tgt_off = ro_off + ro_str_offs[fx["key"]];
        } elif fx["kind"] == "rw" {
            tgt_off = rw_offs[fx["key"]];
        }
        _patch32(code, fx["pos"], tgt_off - next_rip_off);
        fi = fi + 1;
    }

    let elf = [];
    push(elf, 127); push(elf, 69); push(elf, 76); push(elf, 70); // 0x7F 'E' 'L' 'F'
    push(elf, 2); push(elf, 1); push(elf, 1); push(elf, 0);
    _push_zeros(elf, 8);
    _le(elf, 2, 2);                // ET_EXEC
    _le(elf, 62, 2);               // EM_X86_64
    _le(elf, 1, 4);
    _le(elf, VBASE + code_off, 8); // e_entry
    _le(elf, EHSIZE, 8);           // e_phoff
    _le(elf, 0, 8);                // e_shoff (0 = stripped section/symbol headers)
    _le(elf, 0, 4);
    _le(elf, EHSIZE, 2);
    _le(elf, PHSIZE, 2);
    _le(elf, 1, 2);                // 1 PT_LOAD (RWX=7 so `.bss` globals work in 1 segment)
    _le(elf, 0, 2);
    _le(elf, 0, 2);
    _le(elf, 0, 2);

    // Program header: PT_LOAD (p_flags = 7 = PF_R | PF_W | PF_X)
    _le(elf, 1, 4);
    _le(elf, 7, 4);
    _le(elf, 0, 8);
    _le(elf, VBASE, 8);
    _le(elf, VBASE, 8);
    _le(elf, file_sz, 8);
    _le(elf, mem_sz, 8);
    _le(elf, 4096, 8);

    _push_slice(elf, code);
    _push_zeros(elf, code_pad);
    _push_slice(elf, rodata);
    _push_zeros(elf, ro_pad);
    _append_open_symtab_note(elf, st);
    return elf;
}

fn _emit_pe_sec_hdr(pe, name, virt_sz, rva, raw_sz, raw_ptr, chars) {
    let nb = str_to_bytes(name);
    let i = 0;
    while i < 8 {
        push(pe, if i < len(nb) { nb[i] } else { 0 });
        i = i + 1;
    }
    _le(pe, virt_sz, 4);
    _le(pe, rva, 4);
    _le(pe, raw_sz, 4);
    _le(pe, raw_ptr, 4);
    _le(pe, 0, 4);
    _le(pe, 0, 4);
    _le(pe, 0, 2);
    _le(pe, 0, 2);
    _le(pe, chars, 4);
}

fn _pack_pe64_image(st, rodata, ro_str_offs) {
    let code = st["code"];
    let TEXT_RVA = 4096; // 0x1000
    let ro_rel = _align_up(len(code), 16);
    let code_pad = ro_rel - len(code);
    let text_virt_sz = ro_rel + len(rodata);
    let text_raw_sz = _align_up(text_virt_sz, 512);
    let IDATA_RVA = TEXT_RVA + _align_up(text_virt_sz, 4096);

    let api_names = ["GetStdHandle", "WriteFile", "VirtualAlloc", "GetTickCount64", "ExitProcess"];
    let napi = len(api_names);
    let imp_dir_sz = 40;
    let ilt_off = imp_dir_sz;
    let ilt_sz = (napi + 1) * 8;
    let iat_off = ilt_off + ilt_sz;
    let iat_sz = (napi + 1) * 8;
    let names_off = iat_off + iat_sz;

    let names_blob = [];
    let dll_rel = 0;
    _push_slice(names_blob, str_to_bytes("KERNEL32.dll"));
    push(names_blob, 0);
    if (len(names_blob) % 2) != 0 { push(names_blob, 0); }

    let hn_rvas = [];
    let iat_rvas = map{};
    let ai = 0;
    while ai < napi {
        let nm = api_names[ai];
        push(hn_rvas, IDATA_RVA + names_off + len(names_blob));
        iat_rvas[nm] = IDATA_RVA + iat_off + ai * 8;
        _le(names_blob, 0, 2);
        _push_slice(names_blob, str_to_bytes(nm));
        push(names_blob, 0);
        if (len(names_blob) % 2) != 0 { push(names_blob, 0); }
        ai = ai + 1;
    }

    let idata = [];
    _le(idata, IDATA_RVA + ilt_off, 4);
    _le(idata, 0, 4);
    _le(idata, 0, 4);
    _le(idata, IDATA_RVA + names_off + dll_rel, 4);
    _le(idata, IDATA_RVA + iat_off, 4);
    _push_zeros(idata, 20);

    let k1 = 0; while k1 < napi { _le(idata, hn_rvas[k1], 8); k1 = k1 + 1; } _le(idata, 0, 8);
    let k2 = 0; while k2 < napi { _le(idata, hn_rvas[k2], 8); k2 = k2 + 1; } _le(idata, 0, 8);
    _push_slice(idata, names_blob);
    while (len(idata) % 8) != 0 { push(idata, 0); }

    let rw_rvas = map{};
    let sys_slots = ["sys_heap_cur", "sys_heap_end", "sys_stdout_h", "sys_written_dw"];
    let sk = 0;
    while sk < len(sys_slots) {
        rw_rvas[sys_slots[sk]] = IDATA_RVA + len(idata);
        _push_zeros(idata, 8);
        sk = sk + 1;
    }
    let gk = 0;
    while gk < len(st["global_list"]) {
        rw_rvas["g_" + st["global_list"][gk]] = IDATA_RVA + len(idata);
        _push_zeros(idata, 8);
        gk = gk + 1;
    }

    let idata_virt_sz = len(idata);
    let idata_raw_sz = _align_up(idata_virt_sz, 512);

    // Patch RIP-relative fixups
    let fi = 0;
    while fi < len(st["rip_fixes"]) {
        let fx = st["rip_fixes"][fi];
        let next_rip_rva = TEXT_RVA + fx["pos"] + 4;
        let tgt_rva = 0;
        if fx["kind"] == "iat" { tgt_rva = iat_rvas[fx["key"]]; }
        elif fx["kind"] == "ro_str" { tgt_rva = TEXT_RVA + ro_rel + ro_str_offs[fx["key"]]; }
        elif fx["kind"] == "rw" { tgt_rva = rw_rvas[fx["key"]]; }
        _patch32(code, fx["pos"], tgt_rva - next_rip_rva);
        fi = fi + 1;
    }

    let HDR_RAW_SZ = 1024;
    let size_of_image = IDATA_RVA + _align_up(idata_virt_sz, 4096);
    let pe = [];
    push(pe, 77); push(pe, 90); // 'MZ'
    _push_zeros(pe, 58);
    _le(pe, 128, 4);
    _push_zeros(pe, 64);
    push(pe, 80); push(pe, 69); push(pe, 0); push(pe, 0); // 'PE\0\0'
    _le(pe, 34404, 2); // AMD64
    _le(pe, 2, 2);
    _le(pe, 0, 4); _le(pe, 0, 4); _le(pe, 0, 4); // PointerToSymbolTable = 0, NumberOfSymbols = 0
    _le(pe, 240, 2);
    _le(pe, 35, 2);

    // Optional Header PE32+
    _le(pe, 523, 2);
    push(pe, 14); push(pe, 0);
    _le(pe, text_raw_sz, 4);
    _le(pe, idata_raw_sz, 4);
    _le(pe, 0, 4);
    _le(pe, TEXT_RVA, 4);
    _le(pe, TEXT_RVA, 4);
    _le(pe, 0, 4); _le(pe, 1, 4); // ImageBase = 0x140000000
    _le(pe, 4096, 4);
    _le(pe, 512, 4);
    _le(pe, 6, 2); _le(pe, 0, 2);
    _le(pe, 0, 2); _le(pe, 0, 2);
    _le(pe, 6, 2); _le(pe, 0, 2);
    _le(pe, 0, 4);
    _le(pe, size_of_image, 4);
    _le(pe, HDR_RAW_SZ, 4);
    _le(pe, 0, 4);
    _le(pe, 3, 2); // CONSOLE
    _le(pe, 0, 2);
    _le(pe, 8388608, 8);
    _le(pe, 65536, 8);
    _le(pe, 1048576, 8);
    _le(pe, 4096, 8);
    _le(pe, 0, 4);
    _le(pe, 16, 4);

    _le(pe, 0, 8);
    _le(pe, IDATA_RVA, 4); _le(pe, imp_dir_sz, 4);
    let dd = 2; while dd < 12 { _le(pe, 0, 8); dd = dd + 1; }
    _le(pe, IDATA_RVA + iat_off, 4); _le(pe, iat_sz, 4);
    _le(pe, 0, 8); _le(pe, 0, 8); _le(pe, 0, 8);

    _emit_pe_sec_hdr(pe, ".text", text_virt_sz, TEXT_RVA, text_raw_sz, HDR_RAW_SZ, 1610612768);
    _emit_pe_sec_hdr(pe, ".idata", idata_virt_sz, IDATA_RVA, idata_raw_sz, HDR_RAW_SZ + text_raw_sz, 0 - 1073741760);
    while len(pe) < HDR_RAW_SZ { push(pe, 0); }

    _push_slice(pe, code);
    _push_zeros(pe, code_pad);
    _push_slice(pe, rodata);
    _push_zeros(pe, text_raw_sz - text_virt_sz);
    _push_slice(pe, idata);
    _push_zeros(pe, idata_raw_sz - len(idata));
    _append_open_symtab_note(pe, st);
    return pe;
}

// ── Public Pure-PBLang API ────────────────────────────────────────────────────

fn can_compile_unboxed(source) {
    let parsed = SC.parse_sapp_ast(source);
    if len(parsed["errors"]) > 0 or parsed["ast"] == nil { return false; }
    return _check_stmt_unboxed_ok(parsed["ast"]);
}

fn compile_aot_elf64(source, opts = nil) {
    let o = if opts != nil and type(opts) == "map" { opts } else { map{} };
    let shield = _resolve_aot_shield_opts(o);
    let strict_unboxed = map_has(o, "strict_unboxed") and o["strict_unboxed"] == true;
    if can_compile_unboxed(source) {
        let bin = _compile_unboxed_core(source, false, o);
        return map{
            ok: true,
            binary: bin,
            bytes: len(bin),
            target: "aot-native",
            format: "ELF64",
            mode: "pure_pblang_unboxed_x64",
            strip_symbols: shield["strip_symbols"],
            obfuscate_strings: shield["obfuscate_strings"],
            zero_external_toolchain: true
        };
    }
    if strict_unboxed {
        throw "aot_unboxed_native: program uses dynamic constructs outside strict unboxed subset";
    }
    let CG = import("stdlib:native/codegen_x64.sapp");
    let hbin = CG.compile_fns(source);
    return map{
        ok: true,
        binary: hbin,
        bytes: len(hbin),
        target: "aot-native",
        format: "ELF64",
        mode: "hybrid_pure_pblang_x64",
        strip_symbols: shield["strip_symbols"],
        obfuscate_strings: false,
        zero_external_toolchain: true
    };
}

fn compile_aot_pe64(source, opts = nil) {
    let o = if opts != nil and type(opts) == "map" { opts } else { map{} };
    let shield = _resolve_aot_shield_opts(o);
    let strict_unboxed = map_has(o, "strict_unboxed") and o["strict_unboxed"] == true;
    if can_compile_unboxed(source) {
        let bin = _compile_unboxed_core(source, true, o);
        return map{
            ok: true,
            binary: bin,
            bytes: len(bin),
            target: "aot-pe64",
            format: "PE32+",
            mode: "pure_pblang_unboxed_pe64",
            strip_symbols: shield["strip_symbols"],
            obfuscate_strings: shield["obfuscate_strings"],
            zero_external_toolchain: true
        };
    }
    if strict_unboxed {
        throw "aot_unboxed_native: program uses dynamic constructs outside strict unboxed subset";
    }
    let PCG = import("stdlib:native/codegen_pe64.sapp");
    let pbin = PCG.compile_pe64(source);
    return map{
        ok: true,
        binary: pbin,
        bytes: len(pbin),
        target: "aot-pe64",
        format: "PE32+",
        mode: "hybrid_pure_pblang_pe64",
        strip_symbols: shield["strip_symbols"],
        obfuscate_strings: false,
        zero_external_toolchain: true
    };
}

fn compile_aot_native(source, opts = nil) {
    let o = if opts != nil and type(opts) == "map" { opts } else { map{} };
    let tgt = if map_has(o, "target") { o["target"] } else { "aot-native" };
    if tgt == "pe64" or tgt == "aot-pe64" or tgt == "win64" {
        return compile_aot_pe64(source, o);
    }
    return compile_aot_elf64(source, o);
}

fn build_aot_native(src_path, out_path, opts = nil) {
    let t0 = time_ms();
    let source = fs_read(src_path);
    let rep = compile_aot_native(source, opts);
    fs_write_bytes(out_path, rep["binary"]);
    let dt = time_ms() - t0;
    return map{
        ok: true,
        input: src_path,
        output: out_path,
        bytes: rep["bytes"],
        target: rep["target"],
        format: rep["format"],
        mode: rep["mode"],
        strip_symbols: rep["strip_symbols"],
        obfuscate_strings: rep["obfuscate_strings"],
        zero_external_toolchain: true,
        compile_ms: dt
    };
}

export AOT_NATIVE_VERSION,
       encode_f64_le_bytes,
       can_compile_unboxed,
       compile_aot_elf64,
       compile_aot_pe64,
       compile_aot_native,
       build_aot_native;
