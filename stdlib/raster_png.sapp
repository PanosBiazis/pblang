// Bounded RGB raster drawing and PNG encoding in pure PBLang.

let FLATE = import("stdlib:flate.sapp");
let FONT = import("stdlib:bitmap_font.sapp");

let MAX_WIDTH = 1600;
let MAX_HEIGHT = 1200;
let MAX_PIXELS = 1920000;

fn _byte(value) {
    let n = try parse_number(str(value)) catch nil;
    if n == nil { throw "raster_png: color channel must be numeric"; }
    n = num_floor(n);
    if n < 0 { return 0; }
    if n > 255 { return 255; }
    return n;
}

fn _color(value) {
    if type(value) != "array" or len(value) < 3 { throw "raster_png: RGB color requires three channels"; }
    return [_byte(value[0]), _byte(value[1]), _byte(value[2])];
}

fn create(width, height, background = nil) {
    if background == nil { background = [255,255,255]; }
    if type(width) != "number" or width != num_floor(width) or width < 1 or width > MAX_WIDTH or
       type(height) != "number" or height != num_floor(height) or height < 1 or height > MAX_HEIGHT or
       width * height > MAX_PIXELS { throw "raster_png: dimensions exceed 1600x1200 or 1,920,000 pixels"; }
    let color = _color(background); let stride = width * 3 + 1; let raw = [];
    for y height {
        raw[len(raw)] = 0;
        for x width { raw[len(raw)] = color[0]; raw[len(raw)] = color[1]; raw[len(raw)] = color[2]; }
    }
    return map{ format: "pblang.raster.rgb8.v1", width: width, height: height,
        stride: stride, raw: raw, channels: 3 };
}

fn set_pixel(surface, x, y, color) {
    x = num_floor(x); y = num_floor(y);
    if x < 0 or y < 0 or x >= surface.width or y >= surface.height { return false; }
    let rgb = _color(color); let at = y * surface.stride + 1 + x * 3;
    surface.raw[at] = rgb[0]; surface.raw[at + 1] = rgb[1]; surface.raw[at + 2] = rgb[2];
    return true;
}

fn fill_rect(surface, x, y, width, height, color) {
    x = num_floor(x); y = num_floor(y); width = num_floor(width); height = num_floor(height);
    if width <= 0 or height <= 0 { return surface; }
    let x0 = if x < 0 { 0 } else { x }; let y0 = if y < 0 { 0 } else { y };
    let x1 = if x + width > surface.width { surface.width } else { x + width };
    let y1 = if y + height > surface.height { surface.height } else { y + height };
    let rgb = _color(color); let py = y0;
    while py < y1 {
        let at = py * surface.stride + 1 + x0 * 3; let px = x0;
        while px < x1 {
            surface.raw[at] = rgb[0]; surface.raw[at + 1] = rgb[1]; surface.raw[at + 2] = rgb[2];
            at = at + 3; px = px + 1;
        }
        py = py + 1;
    }
    return surface;
}

fn stroke_rect(surface, x, y, width, height, color, thickness = 1) {
    thickness = num_floor(thickness); if thickness < 1 { thickness = 1; }
    fill_rect(surface, x, y, width, thickness, color);
    fill_rect(surface, x, y + height - thickness, width, thickness, color);
    fill_rect(surface, x, y, thickness, height, color);
    fill_rect(surface, x + width - thickness, y, thickness, height, color);
    return surface;
}

fn draw_text(surface, x, y, text, color, scale = 1) {
    scale = num_floor(scale); if scale < 1 or scale > 4 { throw "raster_png: text scale must be 1..4"; }
    let rgb = _color(color); let cx = num_floor(x);
    for i len(str(text)) {
        let code = strcharcodeat(str(text), i); let glyph = FONT.glyph(code);
        if glyph == nil { glyph = [31,17,17,17,17,17,31]; }
        for row 7 {
            for col 5 {
                if bit_and(bit_shr(glyph[row], 4 - col), 1) == 1 {
                    fill_rect(surface, cx + col * scale, y + row * scale, scale, scale, rgb);
                }
            }
        }
        cx = cx + 6 * scale;
        if cx >= surface.width { break; }
    }
    return cx;
}

fn _append(dst, src) { for i len(src) { dst[len(dst)] = src[i]; } return dst; }
fn _be32(n) { return [num_mod(num_floor(n / 16777216),256), num_mod(num_floor(n / 65536),256), num_mod(num_floor(n / 256),256), num_mod(n,256)]; }
fn _chunk(kind, data) {
    let type_bytes = str_to_bytes(kind); let body = []; _append(body, type_bytes); _append(body, data);
    let out = []; _append(out, _be32(len(data))); _append(out, body);
    _append(out, _be32(FLATE.crc32(body))); return out;
}

fn encode(surface) {
    if type(surface) != "map" or (try surface.format catch "") != "pblang.raster.rgb8.v1" or
       len(surface.raw) != surface.stride * surface.height { throw "raster_png: invalid RGB surface"; }
    let ihdr = []; _append(ihdr, _be32(surface.width)); _append(ihdr, _be32(surface.height));
    _append(ihdr, [8,2,0,0,0]);
    let out = [137,80,78,71,13,10,26,10]; _append(out, _chunk("IHDR", ihdr));
    _append(out, _chunk("IDAT", FLATE.zlib_encode(surface.raw)));
    _append(out, _chunk("IEND", [])); return out;
}

export MAX_WIDTH, MAX_HEIGHT, MAX_PIXELS, create, set_pixel, fill_rect,
       stroke_rect, draw_text, encode;
