// stdlib/pbconfig.sapp — one place for pblang's configuration (flags & env vars).
//
// pblang grew many env vars (PBLANG_GPU, PBLANG_GFX, PBLANG_ALLOW_ALL, PBIDE_SCALE, ...).
// This consolidates them: every setting is CATALOGUED with a tier (beginner/intermediate/
// pro) so newcomers see only what matters, and PROFILES set many at once so a user picks
// ONE thing — PBLANG_PROFILE=beginner|pro|secure|fast — instead of memorising ten vars.
//
// Resolution precedence (most specific wins): explicit env var  >  profile preset  >  the
// built-in default. The env getter is injectable, so resolution is testable and pure.
//
//   let C = import("stdlib/pbconfig.sapp");
//   C.effective(C.env_getter(), "beginner");   // the whole resolved config
//   C.resolve("gpu", C.env_getter(), "fast");   // one value, honouring any explicit override
//   C.by_tier("beginner");                       // just what a newcomer needs to know

let _CATALOG = nil;
fn catalog() {
    if _CATALOG != nil { return _CATALOG; }
    _CATALOG = [
        map{ name: "allow_all", env: "PBLANG_ALLOW_ALL", default: "0", tier: "beginner", category: "security", type: "bool", desc: "grant all capabilities at once (off = least privilege, the safe default)" },
        map{ name: "ide_scale", env: "PBIDE_SCALE", default: "0", tier: "beginner", category: "ide", type: "int", desc: "IDE UI scale 1..8 (0 = auto-detect from the display)" },
        map{ name: "gpu", env: "PBLANG_GPU", default: "auto", tier: "intermediate", category: "compute", type: "enum", desc: "GPU acceleration for tensor math: auto / on / off" },
        map{ name: "gfx", env: "PBLANG_GFX", default: "", tier: "intermediate", category: "graphics", type: "enum", desc: "graphics backend: (empty) = minifb CPU, sdl2 = GPU texture present" },
        map{ name: "network", env: "PBLANG_NETWORK_PROFILE", default: "local", tier: "intermediate", category: "security", type: "enum", desc: "network exposure for the MCP server: local / public" },
        map{ name: "gpu_min", env: "PBLANG_GPU_MIN", default: "0", tier: "pro", category: "compute", type: "int", desc: "minimum matrix size before a matmul is routed to the GPU" },
        map{ name: "gfx_software", env: "PBLANG_GFX_SOFTWARE", default: "0", tier: "pro", category: "graphics", type: "bool", desc: "force the software present path even under sdl2" },
        map{ name: "idle_redraw_ms", env: "PBIDE_IDLE_REDRAW_MS", default: "500", tier: "pro", category: "ide", type: "int", desc: "IDE idle repaint cadence in ms (0 = never repaint when idle)" },
        map{ name: "window_probe", env: "PBIDE_WINDOW_PROBE", default: "1", tier: "pro", category: "ide", type: "bool", desc: "live OS window-size probing for cross-screen autoscale" },
        map{ name: "window_probe_ms", env: "PBIDE_WINDOW_PROBE_MS", default: "1200", tier: "pro", category: "ide", type: "int", desc: "window-probe interval in ms" }
    ];
    return _CATALOG;
}

fn _spec(name) {
    let c = catalog();
    let i = 0;
    while i < len(c) { if c[i].name == name { return c[i]; } i = i + 1; }
    return nil;
}
// explain(name) -> the setting spec (throws if unknown).
fn explain(name) {
    let s = _spec(name);
    if s == nil { throw "pbconfig: unknown setting '" + str(name) + "'"; }
    return s;
}
fn tiers() { return ["beginner", "intermediate", "pro"]; }
// by_tier(t) -> the settings at tier t (progressive disclosure: beginners see few).
fn by_tier(t) {
    let c = catalog();
    let out = [];
    let i = 0;
    while i < len(c) { if c[i].tier == t { array_push(out, c[i]); } i = i + 1; }
    return out;
}

fn profiles() { return ["beginner", "pro", "secure", "fast"]; }
// profile_settings(name) -> env-keyed preset overrides (throws if unknown).
fn profile_settings(name) {
    if name == "beginner" { return map{ PBLANG_ALLOW_ALL: "0", PBLANG_GPU: "auto", PBIDE_SCALE: "0", PBLANG_NETWORK_PROFILE: "local", PBLANG_GFX: "" }; }
    if name == "pro" { return map{ PBLANG_ALLOW_ALL: "0", PBLANG_GPU: "on", PBLANG_GFX: "sdl2", PBIDE_WINDOW_PROBE: "1", PBLANG_NETWORK_PROFILE: "local" }; }
    if name == "secure" { return map{ PBLANG_ALLOW_ALL: "0", PBLANG_GPU: "off", PBLANG_GFX_SOFTWARE: "1", PBLANG_NETWORK_PROFILE: "local", PBIDE_WINDOW_PROBE: "0" }; }
    if name == "fast" { return map{ PBLANG_GPU: "on", PBLANG_GFX: "sdl2", PBLANG_GPU_MIN: "0", PBIDE_IDLE_REDRAW_MS: "1000", PBLANG_ALLOW_ALL: "0" }; }
    throw "pbconfig: unknown profile '" + str(name) + "'";
}

// resolve(name, getter, profile) -> the effective value. getter(env_name) returns the
// explicit value or nil/"". Precedence: explicit env > profile preset > default.
fn resolve(name, getter, profile) {
    let spec = explain(name);              // throws on unknown setting
    let prof = profile_settings(profile);  // throws on unknown profile
    let raw = getter(spec.env);
    if raw != nil and raw != "" { return raw; }
    if map_has(prof, spec.env) { return prof[spec.env]; }
    return spec.default;
}

// effective(getter, profile) -> every setting resolved, keyed by name.
fn effective(getter, profile) {
    let c = catalog();
    let out = map{};
    let i = 0;
    while i < len(c) { out[c[i].name] = resolve(c[i].name, getter, profile); i = i + 1; }
    return out;
}

// ── real-environment convenience ────────────────────────────────────────────────────
fn _get(name) { return try env_get(name) catch nil; }
fn env_getter() { return _get; }
// active_profile() -> PBLANG_PROFILE or "beginner".
fn active_profile() {
    let p = try env_get("PBLANG_PROFILE") catch "";
    if p == nil or p == "" { return "beginner"; }
    return p;
}
// current() -> the resolved config for the active profile, reading the real environment.
fn current() { return effective(_get, active_profile()); }

export catalog, explain, tiers, by_tier, profiles, profile_settings;
export resolve, effective, env_getter, active_profile, current;
