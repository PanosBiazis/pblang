// stdlib/net.sapp — TCP networking toolkit.
//
// Re-exports the raw tcp_* builtins and adds address helpers, high-level read
// helpers, and generic accept loops built on those primitives.
//
// Both plain and TLS clients are available. Prefer tcp_connect_tls for traffic
// that leaves a trusted local network; its certificate verification is enabled.

// ── raw builtins (TCP + TLS) ─────────────────────────────────────────────────────
let tcp_listen = tcp_listen;
let tcp_connect = tcp_connect;
let tcp_accept = tcp_accept;
let tcp_read = tcp_read;
let tcp_read_until = tcp_read_until;
let tcp_write = tcp_write;
let tcp_close = tcp_close;
let tcp_local_addr = tcp_local_addr;
let tcp_connect_tls = tcp_connect_tls;
let tcp_listen_tls = tcp_listen_tls;
let tcp_wrap_tls = tcp_wrap_tls;

// ── address helpers ──────────────────────────────────────────────────────────────
// parse_addr("host:port") → { host, port }. IPv6-aware ([::1]:port keeps its
// brackets in host); a missing/non-numeric port is nil (never throws).
fn parse_addr(s) {
    let host = s;
    let port = nil;
    if str_starts_with(s, "[") {
        let rb = str_index_of(s, "]");
        if rb >= 0 {
            host = str_slice(s, 0, rb + 1);   // keep the brackets
            let after = str_slice(s, rb + 1, len(s));
            if str_starts_with(after, ":") { port = try parse_number(str_slice(after, 1, len(after))) catch nil; }
        }
    } else {
        let colon = str_index_of(s, ":");
        if colon >= 0 {
            host = str_slice(s, 0, colon);
            port = try parse_number(str_slice(s, colon + 1, len(s))) catch nil;
        }
    }
    return map{ host: host, port: port };
}

// host_port(host, port) → "host:port". A bare IPv6 host (contains ":" and isn't
// already bracketed) is wrapped in []; a nil port yields just the host.
fn host_port(host, port) {
    let h = str(host);
    if str_contains(h, ":") and not str_starts_with(h, "[") { h = "[" + h + "]"; }
    if port == nil { return h; }
    return h + ":" + str(port);
}

// ── read helpers ─────────────────────────────────────────────────────────────────
// read_n(handle, n) → exactly n bytes (looping), or fewer if the peer closes first.
// n <= 0 returns "" without touching the handle.
fn read_n(handle, n) {
    if n <= 0 { return ""; }
    let buf = "";
    while len(buf) < n {
        let chunk = try tcp_read(handle, n - len(buf)) catch nil;
        if chunk == nil or chunk == "" { break; }
        buf = buf + chunk;
    }
    return buf;
}

// read_all(handle) → read until the peer closes the connection.
fn read_all(handle) {
    let buf = "";
    let chunk = try tcp_read(handle, 65536) catch nil;
    while chunk != nil and chunk != "" {
        buf = buf + chunk;
        chunk = try tcp_read(handle, 65536) catch nil;
    }
    return buf;
}

// read_line(handle) → read through the next "\n" (inclusive), or "" on error.
fn read_line(handle) {
    return try tcp_read_until(handle, "\n", 65536) catch "";
}

// ── accept loops ─────────────────────────────────────────────────────────────────
// with_listener(addr, body) → open a listener, run body(listener), always close it,
// return body's result.
fn with_listener(addr, body) {
    let l = tcp_listen(addr);
    let r = try body(l) catch nil;
    try tcp_close(l) catch nil;
    return r;
}

// serve_once(addr, handler) → accept ONE connection, run handler(conn), close both.
// Returns the actually-bound address (handy with port 0).
fn serve_once(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    let s = tcp_accept(l);
    handler(s);
    try tcp_close(s) catch nil;
    try tcp_close(l) catch nil;
    return actual;
}

// serve(addr, handler) → accept connections forever, running handler(conn) each.
fn serve(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    print actual;
    while true {
        let s = tcp_accept(l);
        try handler(s) catch nil;
        try tcp_close(s) catch nil;
    }
    return actual;
}

export tcp_listen, tcp_connect, tcp_accept, tcp_read, tcp_read_until, tcp_write, tcp_close, tcp_local_addr,
       tcp_connect_tls, tcp_listen_tls, tcp_wrap_tls,
       parse_addr, host_port, read_n, read_all, read_line,
       with_listener, serve_once, serve;
