// stdlib/generics.sapp — Parametric generics for pblang.
//
// pblang is dynamically typed, so "generics" are expressed as first-class
// *type descriptors* — composable predicates — plus *typed containers*
// parameterised by them. The parametric core is the family of type
// CONSTRUCTORS (`T_list_of`, `T_map_of`, `T_optional`, `T_union`, `T_conforms`)
// that build new types out of existing ones, exactly like `List<T>` / `Map<K,V>`
// / `Optional<T>` in nominally-typed languages — but checked at runtime.
//
//   let g = import("stdlib:generics.sapp");
//   let IntList = g.T_list_of(g.T_number());     // a parametric type: list<number>
//   g.check(IntList, [1, 2, 3]);                  // true
//   g.check(IntList, [1, "x"]);                   // false
//
//   let xs = g.typed_list(g.T_number());          // a container parameterised by T
//   g.tl_push(xs, 5);                             // ok
//   g.tl_push(xs, "no");                          // throws: type error
//
// Implemented entirely in pblang (no Rust).

// ── Base type descriptors: { name, check } ───────────────────────────────────────
// `check` is a 1-ary predicate (plain function, not a method — no self).

fn T_any()    { return map{ name: "any",    check: fn(x) { return true; } }; }
fn T_number() { return map{ name: "number", check: fn(x) { return is_number(x); } }; }
fn T_string() { return map{ name: "string", check: fn(x) { return is_string(x); } }; }
fn T_bool()   { return map{ name: "bool",   check: fn(x) { return is_bool(x); } }; }
fn T_fn()     { return map{ name: "fn",     check: fn(x) { return is_fn(x); } }; }
fn T_array()  { return map{ name: "array",  check: fn(x) { return is_array(x); } }; }
fn T_map()    { return map{ name: "map",    check: fn(x) { return is_map(x); } }; }

// ── Parametric type CONSTRUCTORS (the heart of "parametric generics") ─────────────

// T_list_of(elem) — list<elem>: an array whose every element satisfies `elem`.
fn T_list_of(elem) {
    return map{
        name: "list<" + elem.name + ">",
        check: fn(x) {
            if is_array(x) == false { return false; }
            for e in x { if elem.check(e) == false { return false; } }
            return true;
        }
    };
}

// T_map_of(kT, vT) — map<kT, vT>: a map whose keys/values satisfy kT/vT.
fn T_map_of(kT, vT) {
    return map{
        name: "map<" + kT.name + "," + vT.name + ">",
        check: fn(x) {
            if is_map(x) == false { return false; }
            let ks = map_keys(x);
            for k in ks {
                if kT.check(k) == false { return false; }
                if vT.check(x[k]) == false { return false; }
            }
            return true;
        }
    };
}

// T_optional(inner) — inner?: inner-or-nil.
fn T_optional(inner) {
    return map{
        name: inner.name + "?",
        check: fn(x) { if is_nil(x) { return true; } return inner.check(x); }
    };
}

// T_union(a, b) — a|b: either type.
fn T_union(a, b) {
    return map{
        name: a.name + "|" + b.name,
        check: fn(x) { return a.check(x) or b.check(x); }
    };
}

// T_conforms(iface_pred, label) — generic over a STRUCTURAL INTERFACE (§50):
// any value the `interface` predicate accepts. Bridges generics ↔ interfaces, so
// `T_list_of(T_conforms(Drawable, "Drawable"))` is "list of things that draw".
fn T_conforms(iface_pred, label) {
    return map{ name: label, check: fn(x) { return iface_pred(x); } };
}

// ── Type operations ──────────────────────────────────────────────────────────────

fn check(T, value) { return T.check(value); }
fn type_name(T) { return T.name; }

fn assert_type(T, value) {
    if T.check(value) == false {
        throw "type error: expected " + T.name + ", got " + type(value);
    }
    return value;
}

// ── Generic typed containers (parameterised by a type descriptor) ─────────────────

fn typed_list(T) { return map{ __gen: "typed_list", __elem: T, items: [] }; }

fn tl_push(tl, x) { assert_type(tl.__elem, x); push(tl.items, x); return tl; }
fn tl_get(tl, i) { return tl.items[i]; }
fn tl_len(tl) { return len(tl.items); }
fn tl_items(tl) { return tl.items; }
fn tl_elem_type(tl) { return tl.__elem; }

// tl_map(tl, result_T, f) — generic map preserving "typed-ness": produce a new
// typed_list<result_T> by applying f to each element.
fn tl_map(tl, result_T, f) {
    let out = typed_list(result_T);
    for x in tl.items { tl_push(out, f(x)); }
    return out;
}

// tl_filter(tl, pred) — keep elements matching pred; result keeps the same type.
fn tl_filter(tl, pred) {
    let out = typed_list(tl.__elem);
    for x in tl.items { if pred(x) { tl_push(out, x); } }
    return out;
}

fn typed_map(kT, vT) { return map{ __gen: "typed_map", __k: kT, __v: vT, data: map{} }; }

fn tm_set(tm, k, v) {
    assert_type(tm.__k, k);
    assert_type(tm.__v, v);
    tm.data[k] = v;
    return tm;
}
fn tm_get(tm, k) { return tm.data[k]; }
fn tm_has(tm, k) { return map_has(tm.data, k); }

// ── Generic value containers ─────────────────────────────────────────────────────

// box(T, v) — a typed single-value cell; rejects values not of type T.
fn box(T, v) { assert_type(T, v); return map{ __gen: "box", __T: T, value: v }; }
fn unbox(b) { return b.value; }
fn box_map(b, result_T, f) { return box(result_T, f(b.value)); }

// pair(a, b) / triple(a, b, c) — fully generic tuples (any element types).
fn pair(a, b) { return map{ __gen: "pair", first: a, second: b }; }
fn fst(p) { return p.first; }
fn snd(p) { return p.second; }
fn triple(a, b, c) { return map{ __gen: "triple", first: a, second: b, third: c }; }

// ── Generic Option<T> (parametric optional) ──────────────────────────────────────

fn some(v) { return map{ __gen: "option", present: true, value: v }; }
fn none() { return map{ __gen: "option", present: false }; }
fn is_some(o) { return o.present; }
fn is_none(o) { return o.present == false; }
fn opt_get(o, default) { if o.present { return o.value; } return default; }
fn opt_map(o, f) { if o.present { return some(f(o.value)); } return o; }

export T_any, T_number, T_string, T_bool, T_fn, T_array, T_map;
export T_list_of, T_map_of, T_optional, T_union, T_conforms;
export check, type_name, assert_type;
export typed_list, tl_push, tl_get, tl_len, tl_items, tl_elem_type, tl_map, tl_filter;
export typed_map, tm_set, tm_get, tm_has;
export box, unbox, box_map, pair, fst, snd, triple;
export some, none, is_some, is_none, opt_get, opt_map;
