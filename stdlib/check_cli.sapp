// stdlib/check_cli.sapp — driver for `pblang check`.
//
// Runs the self-hosted smart diagnostics engine (stdlib/diagnostics.sapp) over one or
// more source files and prints Rust-style results. The Rust `check` subcommand simply
// runs this script, passing paths as actual arguments after `--`. Its child process
// exits unsuccessfully on diagnostics; no status-file write is required.
//
// Standalone use:
//   pblang run stdlib/check_cli.sapp -- file1.sapp file2.sapp

let DX = import("stdlib:diagnostics.sapp");
// Top-level imports preserve the trusted driver origin on the retained host.
// Do not load these checkers lazily from check_files (caller cwd may differ).
let RETAINED = import("stdlib:compiler/retained_source_check.sapp");
let ORIGIN = import("stdlib:compiler/import_origin_check.sapp");

fn _arg_files() {
    // The environment encoding cannot distinguish a newline inside a filename
    // from a second argument. Trimming also changes the requested file identity.
    // Keep the actual argv tail intact; no separator means no filenames.
    let raw = os_args();
    let out = [];
    let after_separator = false;
    let i = 0;
    while i < len(raw) {
        if after_separator { array_push(out, raw[i]); }
        elif raw[i] == "--" { after_separator = true; }
        i = i + 1;
    }
    return out;
}

fn check_files(files, retained_source=false, import_origin=false) {
    let total_err = 0;
    let total_warn = 0;
    let i = 0;
    while i < len(files) {
        let path = files[i];
        let src = try fs_read(path) catch nil;
        if src == nil {
            print "error: cannot read file `" + path + "`";
            total_err = total_err + 1;
        } else {
            if retained_source {
                let admission=RETAINED.check(src);
                if not admission.ok {
                    print "error["+admission.code+"]: "+admission.message;
                    total_err=total_err+1;i=i+1;continue;
                }
            }
            if import_origin {
                let admission=ORIGIN.check(src);
                if not admission.ok {
                    print "error["+admission.code+"]: "+admission.message;
                    total_err=total_err+1;i=i+1;continue;
                }
            }
            let r = DX.diagnose_checked(src);
            print "── " + path + " ──";
            if r.counts.error > 0 or r.counts.warning > 0 { print DX.format(r); }
            total_err = total_err + r.counts.error;
            if r.counts.error == 0 and r.counts.warning == 0 { print "no issues found"; }
            total_warn = total_warn + r.counts.warning;
        }
        i = i + 1;
    }
    return map{ errors: total_err, warnings: total_warn };
}

// A thrown failure propagates through the retained driver's child exit code.
// No status-file write is needed, including for direct script invocation.
fn main() {
    let arguments = _arg_files();let files=[];let retained_source=false;let flag_seen=false;let import_origin=false;let origin_seen=false;
    let profile=env_get("PBLANG_CHECK_PROFILE") ?? "";
    if profile!="" and profile!="default" and profile!="retained-source" and profile!="import-origin" {
        throw "pblang check: unknown source profile";
    }
    if profile=="retained-source" {retained_source=true;}
    if profile=="import-origin" {import_origin=true;}
    for argument in arguments {
        if argument=="--retained-source" {
            if flag_seen {throw "pblang check: duplicate retained source option";}
            retained_source=true;flag_seen=true;
        } elif argument=="--import-origin" {
            if origin_seen {throw "pblang check: duplicate import origin option";}
            import_origin=true;origin_seen=true;
        } else {push(files,argument);}
    }
    if len(files) == 0 {
        print "pblang check: pass one or more .sapp files";
        throw "pblang check: source files required";
    }
    let summary = check_files(files,retained_source,import_origin);
    print "checked " + str(len(files)) + " file(s): "
          + str(summary.errors) + " error(s), " + str(summary.warnings) + " warning(s)";
    if summary.errors > 0 { throw "pblang check: source check failed"; }
}

main();

export check_files;
