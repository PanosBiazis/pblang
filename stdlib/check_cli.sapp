// stdlib/check_cli.sapp — driver for `pblang check`.
//
// Runs the self-hosted smart diagnostics engine (stdlib/diagnostics.sapp) over one or
// more source files and prints Rust-style results. The Rust `check` subcommand simply
// runs this script, passing the target paths via PBLANG_SCRIPT_ARGS — so all analysis
// logic stays in one place (no Rust/self-hosted duplication).
//
// Standalone use:
//   pblang run stdlib/check_cli.sapp -- file1.sapp file2.sapp

let DX = import("stdlib:diagnostics.sapp");

fn _arg_files() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if raw == nil or raw == "" { return []; }
    let parts = str_split(raw, "\n");
    let out = [];
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if p != "" { array_push(out, p); }
        i = i + 1;
    }
    return out;
}

fn check_files(files) {
    let total_err = 0;
    let total_warn = 0;
    let i = 0;
    while i < len(files) {
        let path = files[i];
        let src = try fs_read(path) catch nil;
        if src == nil {
            print "error: cannot read file `" + path + "`";
            total_err = total_err + 1;
        } else {
            let r = DX.diagnose(src);
            print "── " + path + " ──";
            print DX.format(r);
            total_err = total_err + r.counts.error;
            total_warn = total_warn + r.counts.warning;
        }
        i = i + 1;
    }
    return map{ errors: total_err, warnings: total_warn };
}

// Communicate the error count back to the Rust `check` wrapper (which owns the
// process exit code) by writing it to the path in PBLANG_CHECK_STATUS_FILE, if set.
// pblang scripts have no exit() builtin, so this avoids fragile output parsing.
fn _write_status(errors) {
    let f = try env_get("PBLANG_CHECK_STATUS_FILE") catch nil;
    if f != nil and f != "" { let _ = try fs_write(f, str(errors)) catch nil; }
}

fn main() {
    let files = _arg_files();
    if len(files) == 0 {
        print "pblang check: pass one or more .sapp files";
        _write_status(1);
        return;
    }
    let summary = check_files(files);
    print "checked " + str(len(files)) + " file(s): "
          + str(summary.errors) + " error(s), " + str(summary.warnings) + " warning(s)";
    _write_status(summary.errors);
}

main();

export check_files;
