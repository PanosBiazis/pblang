// stdlib/check_cli.sapp — driver for `pblang check`.
//
// Runs the self-hosted smart diagnostics engine (stdlib/diagnostics.sapp) over one or
// more source files and prints Rust-style results. The Rust `check` subcommand simply
// runs this script, passing paths as actual arguments after `--`. Its child process
// exits unsuccessfully on diagnostics; no status-file write is required.
//
// Standalone use:
//   pblang run stdlib/check_cli.sapp -- file1.sapp file2.sapp

let DX = import("stdlib:diagnostics.sapp");
// Top-level imports preserve the trusted driver origin on the retained host.
// Do not load these checkers lazily from check_files (caller cwd may differ).
let RETAINED = import("stdlib:compiler/retained_source_check.sapp");
let ORIGIN = import("stdlib:compiler/import_origin_check.sapp");
let BOUNDED = import("stdlib:compiler/bounded_source.sapp");

fn _arg_files() {
    // The environment encoding cannot distinguish a newline inside a filename
    // from a second argument. Trimming also changes the requested file identity.
    // Keep the actual argv tail intact; no separator means no filenames.
    let raw = os_args();
    let out = [];
    let after_separator = false;
    let i = 0;
    while i < len(raw) {
        if after_separator { array_push(out, raw[i]); }
        elif raw[i] == "--" { after_separator = true; }
        i = i + 1;
    }
    return out;
}

// One per-invocation budget, including implicit print newlines. The final
// marker and main's truthful summary together have a separate 512-byte reserve.
fn _count(value) {
    if type(value)!="number" or not (value>=0 and value<=9007199254740991) or num_floor(value)!=value {
        throw "pblang check: invalid diagnostic count";
    }
    return value;
}
fn _count_add(a,b) {
    _count(a);_count(b);
    if b>9007199254740991-a {throw "pblang check: diagnostic count overflow";}
    return a+b;
}
fn _emit_result(output,result) {
    output.truncated=output.truncated or result.truncated;
    print result.text;
    output.remaining=output.remaining-result.bytes-1;
}
fn _emit_parts(output,parts) {
    if output.remaining<1 {output.truncated=true;return;}
    _emit_result(output,DX.format_text_bounded(parts,output.remaining-1));
}
fn check_files(files, retained_source=false, import_origin=false, bounded_source=false) {
    _count(len(files));
    if bounded_source and len(files)>64 {throw "pblang check: bounded source accepts at most 64 files";}
    if bounded_source and platform()!="linux" {throw "pblang check: bounded source requires Linux";}
    let source_remaining=4194304;
    let total_err=0;let total_warn=0;let i=0;
    let output=map{remaining:15872,truncated:false};
    while i<len(files) {
        let path=files[i];let src:any=nil;
        if bounded_source {
            if source_remaining==0 {
                total_err=_count_add(total_err,1);
                _emit_parts(output,["error[bounded-source]: aggregate source byte budget exhausted; file not read"]);
                i=i+1;continue;
            }
            let allowance=if source_remaining<1048576 {source_remaining} else {1048576};
            let loaded=try BOUNDED.read_source(path,allowance) catch nil;
            if loaded==nil or not loaded.ok {
                // A rejected read may already have copied allowance+1 bytes.
                // Charge the full allowance; never refund unknown partial work.
                source_remaining=source_remaining-allowance;
                total_err=_count_add(total_err,1);
                _emit_parts(output,["error[bounded-source]: source admission rejected"]);
                i=i+1;continue;
            }
            source_remaining=source_remaining-loaded.size;
            src=loaded.source;
        } else {src=try fs_read(path) catch nil;}
        if src==nil {
            total_err=_count_add(total_err,1);
            _emit_parts(output,["error: cannot read file `",path,"`"]);
        } else {
            if retained_source {
                let admission=RETAINED.check(src);
                if not admission.ok {
                    total_err=_count_add(total_err,1);
                    _emit_parts(output,["error[",admission.code,"]: ",admission.message]);
                    i=i+1;continue;
                }
            }
            if import_origin {
                let admission=ORIGIN.check(src);
                if not admission.ok {
                    total_err=_count_add(total_err,1);
                    _emit_parts(output,["error[",admission.code,"]: ",admission.message]);
                    i=i+1;continue;
                }
            }
            let r=DX.diagnose_checked(src);
            // Validate and count before rendering, even after detail exhaustion.
            total_err=_count_add(total_err,r.counts.error);
            total_warn=_count_add(total_warn,r.counts.warning);
            _emit_parts(output,["── ",path," ──"]);
            if r.counts.error>0 or r.counts.warning>0 {
                if output.remaining<1 {output.truncated=true;}
                else {_emit_result(output,DX.format_bounded(r,output.remaining-1));}
            }
            if r.counts.error==0 and r.counts.warning==0 {_emit_parts(output,["no issues found"]);}
        }
        i=i+1;
    }
    if output.truncated {print "[diagnostic output truncated; final counts remain complete]";}
    return map{errors:total_err,warnings:total_warn};
}

// A thrown failure propagates through the retained driver's child exit code.
// No status-file write is needed, including for direct script invocation.
fn main() {
    let arguments = _arg_files();let files=[];let retained_source=false;let flag_seen=false;let import_origin=false;let origin_seen=false;let bounded_source=false;let bounded_seen=false;
    let profile=env_get("PBLANG_CHECK_PROFILE") ?? "";
    if profile!="" and profile!="default" and profile!="retained-source" and profile!="import-origin" and profile!="bounded-source" {
        throw "pblang check: unknown source profile";
    }
    if profile=="retained-source" {retained_source=true;}
    if profile=="import-origin" {import_origin=true;}
    if profile=="bounded-source" {bounded_source=true;}
    for argument in arguments {
        if argument=="--retained-source" {
            if flag_seen {throw "pblang check: duplicate retained source option";}
            retained_source=true;flag_seen=true;
        } elif argument=="--import-origin" {
            if origin_seen {throw "pblang check: duplicate import origin option";}
            import_origin=true;origin_seen=true;
        } elif argument=="--bounded-source" {
            if bounded_seen {throw "pblang check: duplicate bounded source option";}
            bounded_source=true;bounded_seen=true;
        } else {push(files,argument);}
    }
    if len(files) == 0 {
        print "pblang check: pass one or more .sapp files";
        throw "pblang check: source files required";
    }
    let summary = check_files(files,retained_source,import_origin,bounded_source);
    // Three validated <=2^53-1 integers plus fixed ASCII labels and newline
    // fit within 256 bytes, leaving ample room for the single fixed marker.
    let footer=DX.format_text_bounded(["checked ",str(_count(len(files)))," file(s): ",
        str(_count(summary.errors))," error(s), ",str(_count(summary.warnings))," warning(s)"],255);
    if footer.truncated {throw "pblang check: summary overflow";}
    print footer.text;
    if summary.errors > 0 { throw "pblang check: source check failed"; }
}

main();

export check_files;
