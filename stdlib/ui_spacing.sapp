// Optional density presets are ordinary Modern UI container options.
fn validate(options) {
    if type(options)!="map" {throw "ui_spacing expects an options map";}
    for key in ["gap","padding"] {
        if map_has(options,key) {
            let value=options[key];
            if type(value)!="number" or not (value>=0 and value<=8192) or value!=num_floor(value) {
                throw "ui_spacing "+key+" must be an integer from 0 to 8192";
            }
        }
    }
    return true;
}
fn preset(name="comfortable",overrides=nil) {
    let gap=12;let padding=20;
    if name=="compact" {gap=6;padding=12;}
    elif name=="spacious" {gap=20;padding=28;}
    elif name!="comfortable" {throw "unknown ui_spacing preset";}
    let out=map{gap:gap,padding:padding};
    if overrides!=nil {
        if type(overrides)!="map" {throw "ui_spacing overrides must be a map";}
        for key in map_keys(overrides) {out[key]=overrides[key];}
    }
    validate(out);return out;
}
export validate,preset;
