let Review=import("stdlib:table_lookup_review.sapp");let Writer=import("stdlib:text_document_files.sapp");
// File adapter for the existing exact many-to-one lookup contract.
let Files=import("stdlib:table_files.sapp");let Lookup=import("stdlib:table_lookup.sapp");
fn open(left_path,right_path,left_key,right_key,columns,mode="left",delimiter=","){
 let left=Files.open(left_path,delimiter);if not left.ok{return map{ok:false,error:"Could not open the left table."};}
 let right=Files.open(right_path,delimiter);if not right.ok{return map{ok:false,error:"Could not open the reference table."};}
 let result=try Lookup.join(left.document,right.document,left_key,right_key,columns,mode) catch nil;
 if result==nil{return map{ok:false,error:"Join refused. Check columns, unique nonblank reference keys, nonblank left keys and output limits."};}
 return map{ok:true,report:result};
}
fn save(path,report,delimiter=","){
 // Revalidate through the existing Sheet export boundary.
 if type(report)!="map" or not map_has(report,"document"){return map{ok:false,error:"No joined table to export."};}
 return Files.save(path,report.document,if type(path)=="string" and str_ends_with(str_lower(path),".pbsheet") {"sheet"} else {"csv"},delimiter);
}
fn run(left_path,right_path,output,left_key,right_key,columns,mode="left",delimiter=","){
 let loaded=open(left_path,right_path,left_key,right_key,columns,mode,delimiter);if not loaded.ok{return loaded;}
 let saved=save(output,loaded.report,delimiter);if not saved.ok{return saved;}
 return map{ok:true,matched:loaded.report.matched,unmatched:loaded.report.unmatched,rows:len(loaded.report.document.cells)-1,atomic_visibility:false};
}
fn save_review(path,report,title="Table join review") {
 let document=try Review.to_document(report,title) catch nil;
 if document==nil {return map{ok:false,error:"Invalid join mapping or review title. Recompute the join; nothing written."};}
 return Writer.save_copy(path,document);
}
fn review(left_path,right_path,output,left_key,right_key,columns,mode="left",delimiter=",") {
 let loaded=open(left_path,right_path,left_key,right_key,columns,mode,delimiter);if not loaded.ok {return loaded;}
 let saved=save_review(output,loaded.report);if not saved.ok {return saved;}
 return map{ok:true,matched:loaded.report.matched,unmatched:loaded.report.unmatched,rows:len(loaded.report.document.cells)-1,atomic_visibility:false};
}
export open,save,run,save_review,review;
