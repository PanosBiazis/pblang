let Series=import("stdlib:sample_series.sapp");let Sheet=import("stdlib:sheet_document.sapp");let Decimal=import("stdlib:measure_table.sapp");
fn create(samples,queries){
 let s=Sheet.validate(samples);let q=Sheet.validate(queries);
 if s.columns!=2 or s.rows<3 or samples.cells[0]!=["X","Value"] {throw "two or more X,Value samples required";}
 if q.columns!=1 or q.rows<2 or queries.cells[0]!=["Query"] {throw "one or more Query rows required";}
 let xs=[];let ys=[];let positions=[];
 for i in range(1,s.rows){array_push(xs,Decimal.parse_value(samples.cells[i][0]));array_push(ys,Decimal.parse_value(samples.cells[i][1]));}
 for i in range(1,q.rows){array_push(positions,Decimal.parse_value(queries.cells[i][0]));}
 let values=Series.interpolate(xs,ys,positions);let doc=Sheet.create(q.rows,2);doc.cells[0]=["Query","Value"];
 for i in range(0,len(values)){doc.cells[i+1]=[queries.cells[i+1][0],str(values[i])];}Sheet.validate(doc);
 return map{format:"pblang.interpolation-table.v1",document:doc,samples:len(xs),rows:len(positions),minimum_x:xs[0],maximum_x:xs[len(xs)-1]};
}
export create;
