// stdlib/unicode.sapp — small Unicode scalar helpers for pblang source/tools.
//
// pblang strings are Unicode-scalar indexed by the VM string builtins. This module
// exposes common inspection helpers for IDEs, preprocessors, tests, and text tooling.

fn codepoint_at(s, i) {
    return strcharcodeat(str(s), i);
}

fn from_codepoint(cp) {
    return strfromcharcode(cp);
}

fn codepoints(s) {
    let out = [];
    let i = 0;
    let text = str(s);
    while i < len(text) {
        push(out, strcharcodeat(text, i));
        i = i + 1;
    }
    return out;
}

fn is_valid_scalar(cp) {
    return cp >= 0 and cp <= 1114111 and not (cp >= 55296 and cp <= 57343);
}

fn is_control(cp) {
    return (cp >= 0 and cp < 32) or (cp >= 127 and cp <= 159);
}

fn is_ascii(cp) {
    return cp >= 0 and cp <= 127;
}

fn is_math_symbol(cp) {
    return (cp >= 8704 and cp <= 8959) or (cp >= 8592 and cp <= 8703);
}

fn is_emoji(cp) {
    return (cp >= 127744 and cp <= 128591)      // pictographs, faces, transport
        or (cp >= 128640 and cp <= 128767)      // transport/map symbols
        or (cp >= 129280 and cp <= 129791)      // supplemental symbols/pictographs
        or (cp >= 9728 and cp <= 9983)          // dingbats/weather-ish symbols
        or (cp >= 10084 and cp <= 10084);       // heart
}

fn classify_codepoint(cp) {
    if not is_valid_scalar(cp) { return "invalid"; }
    if is_control(cp) { return "control"; }
    if is_ascii(cp) { return "ascii"; }
    if is_emoji(cp) { return "emoji"; }
    if is_math_symbol(cp) { return "math"; }
    return "unicode";
}

fn contains_emoji(s) {
    let cps = codepoints(s);
    for cp in cps {
        if is_emoji(cp) { return true; }
    }
    return false;
}

// Unicode White_Space code points. This intentionally excludes zero-width
// format controls: treating them as ordinary spacing can hide source text.
fn is_whitespace(cp) {
    return (cp >= 9 and cp <= 13) or cp == 32 or cp == 133 or cp == 160
        or cp == 5760 or (cp >= 8192 and cp <= 8202) or cp == 8232
        or cp == 8233 or cp == 8239 or cp == 8287 or cp == 12288;
}

// Decimal digit blocks contain ten consecutive scalars. Mathematical digits
// contain five adjacent ten-scalar styles and are handled as one bounded range.
fn is_decimal_digit(cp) {
    let starts = [
        48, 1632, 1776, 1984, 2406, 2534, 2662, 2790, 2918, 3046,
        3174, 3302, 3430, 3558, 3664, 3792, 3872, 4160, 4240, 6112,
        6160, 6470, 6608, 6784, 6800, 6992, 7088, 7232, 7248, 42528,
        43216, 43264, 43472, 43504, 43600, 44016, 65296, 66720, 68912,
        69734, 69942, 70096, 70384, 70736, 70864, 71248, 71360, 71472,
        71904, 72016, 72784, 73040, 73120, 92768, 93008, 93024, 94176,
        123200, 123632, 125264, 125552
    ];
    let i = 0;
    while i < len(starts) {
        if cp >= starts[i] and cp <= starts[i] + 9 { return true; }
        i = i + 1;
    }
    return cp >= 120782 and cp <= 120831;
}

// A cased letter is detected through the runtime's Unicode case mapping. This
// is deliberately named: scripts without letter case remain "unicode" rather
// than being incorrectly claimed as non-letters.
fn is_cased_letter(ch) {
    if type(ch) != "string" or len(ch) != 1 { return false; }
    return str_lower(ch) != str_upper(ch);
}

fn classify_character(ch) {
    if type(ch) != "string" or len(ch) != 1 { return "invalid"; }
    let cp = codepoint_at(ch, 0);
    if not is_valid_scalar(cp) { return "invalid"; }
    if is_whitespace(cp) { return "whitespace"; }
    if is_control(cp) { return "control"; }
    if is_decimal_digit(cp) { return "digit"; }
    if is_cased_letter(ch) {
        if ch == str_lower(ch) { return "lowercase"; }
        if ch == str_upper(ch) { return "uppercase"; }
        return "cased-letter";
    }
    if is_emoji(cp) { return "emoji"; }
    if is_math_symbol(cp) { return "math"; }
    if is_ascii(cp) { return "punctuation"; }
    return "unicode";
}

fn classify_text(value) {
    let text = str(value);
    let out = [];
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        push(out, map{
            index: i,
            character: ch,
            codepoint: codepoint_at(ch, 0),
            kind: classify_character(ch)
        });
        i = i + 1;
    }
    return out;
}

fn _hex_digit(n) {
    if n < 10 { return str(n); }
    return strfromcharcode(55 + n);
}

fn hex_codepoint(cp) {
    if cp == 0 { return "0"; }
    let n = cp;
    let out = "";
    while n > 0 {
        let d = num_mod(n, 16);
        out = _hex_digit(d) + out;
        n = num_floor(n / 16);
    }
    return out;
}

fn escape_codepoint(cp) {
    return "\\u{" + hex_codepoint(cp) + "}";
}

fn escape_string(s) {
    let out = "";
    let text = str(s);
    let i = 0;
    while i < len(text) {
        let cp = strcharcodeat(text, i);
        if cp == 10 { out = out + "\\n"; }
        else if cp == 9 { out = out + "\\t"; }
        else if cp == 13 { out = out + "\\r"; }
        else if cp == 34 { out = out + "\\\""; }
        else if cp == 92 { out = out + "\\\\"; }
        else if is_control(cp) { out = out + escape_codepoint(cp); }
        else { out = out + strfromcharcode(cp); }
        i = i + 1;
    }
    return out;
}

export codepoint_at, from_codepoint, codepoints, is_valid_scalar, is_control,
       is_ascii, is_math_symbol, is_emoji, classify_codepoint, contains_emoji,
       is_whitespace, is_decimal_digit, is_cased_letter, classify_character,
       classify_text, hex_codepoint, escape_codepoint, escape_string;
