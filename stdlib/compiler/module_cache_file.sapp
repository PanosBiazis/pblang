// Internal Linux private-file adapter for the compiler module cache.
// Keep the cache independent of secure_file's scanner, snapshot and other
// platform backends. Operations retain the secure_file private-parent contract;
// differential tests cover this specialization. No ordinary path I/O fallback.
let LinuxDirFS = import("stdlib:linux_dirfs.sapp");
let MAX_PATH = 4096;
fn _error(message) { return map{ ok: false, error: message }; }

fn _map_bool(value, key) {
    if type(value) != "map" or not map_has(value, key) { return false; }
    let flag = try value[key] catch nil;
    return type(flag) == "bool" and flag;
}

fn _not_ok(value) {
    return not _map_bool(value, "ok");
}

fn _reply_valid(result) {
    return type(result) == "map" and map_has(result, "ok") and type(try result.ok catch nil) == "bool";
}

fn _not_reply_valid(result) {
    return not _reply_valid(result);
}

// A close is attempted once. Failure or an opaque cleanup exception cannot
// certify release; do not retry a potentially consumed native descriptor.
fn _close_verified(fs) {
    let closed = try LinuxDirFS.close(fs) catch false;
    return type(closed) == "bool" and closed;
}

// Exception-path cleanup. `guard.pending` is cleared once the guarded backend
// call returns, so the normal path keeps its single verified close in _finish.
// When the call throws instead, the deferred guard performs the one close and
// swallows any cleanup failure so the primary exception propagates unchanged
// (defer runs during unwinding; a throwing defer never replaces the error).
fn _close_pending(fs, guard) {
    if guard.pending {
        guard.pending = false;
        _close_verified(fs);
    }
}

fn _finish(fs, result, publication = false) {
    if _close_verified(fs) {
        if _not_reply_valid(result) {
            return map{ ok: false, error: "module cache operation returned an invalid backend reply",
                parent_close_confirmed: true };
        }
        return result;
    }
    // Retain a known primary failure, including its publication/durability flags.
    if _reply_valid(result) and _not_ok(result) {
        result.cleanup_uncertain = true;
        result.parent_close_confirmed = false;
        return result;
    }
    return map{ ok: false, error: "module cache parent cleanup could not be verified",
        cleanup_uncertain: true, parent_close_confirmed: false,
        operation_completed: _map_bool(result, "ok"),
        publication_may_have_occurred: publication };
}

fn _parts(path) {
    if type(path) != "string" or path == "" or len(path) > MAX_PATH
        or str_contains(path, strfromcharcode(0)) or str_ends_with(path, "/") {
        return nil;
    }
    let name = "";
    try { name = path_basename(path); } catch { name = ""; }
    if name == "" or name == "." or name == ".." or str_contains(name, "/")
        or str_contains(name, "\\") {
        return nil;
    }
    let parent_path = "";
    try { parent_path = path_dirname(path); } catch { parent_path = ""; }
    if parent_path == "" { parent_path = "."; }
    return map{ parent: parent_path, name: name,
        absolute: str_starts_with(parent_path, "/") };
}

fn _create_parent(path) {
    if type(path) != "string" or path == "" or path == "." or path == "/"
       or len(path) > MAX_PATH or str_contains(path, strfromcharcode(0)) {
        return _error("invalid private directory path");
    }
    let parts = _parts(path);
    if parts == nil { return _error("private directory parent is unavailable"); }
    let parent = if parts.absolute {
        LinuxDirFS.open_absolute(parts.parent, false, false)
    } else { LinuxDirFS.open(parts.parent, false, false) };
    if _not_ok(parent) { return _error("private directory parent is unavailable"); }
    let parent_guard = map{ pending: true };
    defer _close_pending(parent, parent_guard);
    let created = LinuxDirFS.mkdir_new(parent, parts.name, false);
    parent_guard.pending = false;
    if not _close_verified(parent) {
        return map{ ok: false, error: "private directory parent cleanup could not be verified",
            cleanup_uncertain: true, parent_close_confirmed: false };
    }
    if _not_ok(created) {
        return _error("private directory must be newly created");
    }
    let fs = if str_starts_with(path, "/") {
        LinuxDirFS.open_absolute(path, false, false)
    } else { LinuxDirFS.open(path, false, false) };
    if _not_ok(fs) { return _error("new private directory cannot be reopened securely"); }
    let fs_guard = map{ pending: true };
    defer _close_pending(fs, fs_guard);
    let policy = LinuxDirFS.private_root_status(fs);
    fs_guard.pending = false;
    if not _close_verified(fs) {
        return map{ ok: false, error: "private directory ownership or mode cannot be verified",
            cleanup_uncertain: true, parent_close_confirmed: false };
    }
    if _not_ok(policy) {
        return _error("private directory ownership or mode cannot be verified");
    }
    return map{ ok: true };
}

fn _open_parent(path, create) {
    let parts = _parts(path);
    if parts == nil { return _error("invalid secure file path"); }
    let fs = if parts.absolute {
        LinuxDirFS.open_absolute(parts.parent, false, false)
    } else { LinuxDirFS.open(parts.parent, false, false) };
    if _not_ok(fs) and create {
        let created = _create_parent(parts.parent);
        if _not_ok(created) {
            let failed = _error("private parent must exist or be exclusively creatable");
            if _map_bool(created, "cleanup_uncertain") {
                failed.cleanup_uncertain = true;
                failed.parent_close_confirmed = false;
            }
            return failed;
        }
        fs = if parts.absolute {
            LinuxDirFS.open_absolute(parts.parent, false, false)
        } else { LinuxDirFS.open(parts.parent, false, false) };
    }
    if _not_ok(fs) { return _error("private parent directory is unavailable"); }
    let guard = map{ pending: true };
    defer _close_pending(fs, guard);
    let policy = LinuxDirFS.private_root_status(fs);
    guard.pending = false;
    if _not_ok(policy) {
        return _finish(fs, _error("private parent must already be current-user-owned mode 0700"));
    }
    return map{ ok: true, fs: fs, name: parts.name, private_parent_verified: true };
}

fn read_bytes(path, max_bytes) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes) {
        return _error("invalid secure read limit");
    }
    let parent = _open_parent(path, false); if _not_ok(parent) { return parent; }
    let guard = map{ pending: true };
    defer _close_pending(parent.fs, guard);
    let result = LinuxDirFS.read_bytes(parent.fs, parent.name, max_bytes);
    guard.pending = false;
    return _finish(parent.fs, result);
}

fn read_text(path, max_bytes) {
    let result = read_bytes(path, max_bytes); if _not_ok(result) { return result; }
    if type(try result.bytes catch nil) != "array" or type(try result.size catch nil) != "number" {
        return _error("module cache read returned an invalid byte payload");
    }
    let text = try bytes_to_str(result.bytes) catch nil;
    if text == nil { return _error("secure file is not valid UTF-8"); }
    return map{ ok: true, text: text, size: result.size };
}

fn write_atomic(path, bytes) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    if type(bytes) != "array" { return _error("secure file bytes must be an array"); }
    let parent = _open_parent(path, true); if _not_ok(parent) { return parent; }
    let guard = map{ pending: true };
    defer _close_pending(parent.fs, guard);
    let result = LinuxDirFS.write_atomic(parent.fs, parent.name, bytes, false);
    guard.pending = false;
    return _finish(parent.fs, result, true);
}

fn write_text_atomic(path, text) {
    if type(text) != "string" { return _error("secure file text must be a string"); }
    return write_atomic(path, str_to_bytes(text));
}

fn remove(path) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    let parent = _open_parent(path, false); if _not_ok(parent) { return parent; }
    let guard = map{ pending: true };
    defer _close_pending(parent.fs, guard);
    let result = LinuxDirFS.remove(parent.fs, parent.name);
    guard.pending = false;
    return _finish(parent.fs, result);
}

export read_bytes, read_text, write_atomic, write_text_atomic, remove;
