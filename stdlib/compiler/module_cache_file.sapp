// Internal Linux private-file adapter for the compiler module cache.
// Keep the cache independent of secure_file's scanner, snapshot and other
// platform backends. Operations retain the secure_file private-parent contract;
// differential tests cover this specialization. No ordinary path I/O fallback.
let LinuxDirFS = import("stdlib:linux_dirfs.sapp");
let MAX_PATH = 4096;
fn _error(message) { return map{ ok: false, error: message }; }

fn _parts(path) {
    if type(path) != "string" or path == "" or len(path) > MAX_PATH
        or str_contains(path, strfromcharcode(0)) or str_ends_with(path, "/") {
        return nil;
    }
    let name = "";
    try { name = path_basename(path); } catch { name = ""; }
    if name == "" or name == "." or name == ".." or str_contains(name, "/")
        or str_contains(name, "\\") {
        return nil;
    }
    let parent_path = "";
    try { parent_path = path_dirname(path); } catch { parent_path = ""; }
    if parent_path == "" { parent_path = "."; }
    return map{ parent: parent_path, name: name,
        absolute: str_starts_with(parent_path, "/") };
}

fn _create_parent(path) {
    if type(path) != "string" or path == "" or path == "." or path == "/"
       or len(path) > MAX_PATH or str_contains(path, strfromcharcode(0)) {
        return _error("invalid private directory path");
    }
    let parts = _parts(path);
    if parts == nil { return _error("private directory parent is unavailable"); }
    let parent = if parts.absolute {
        LinuxDirFS.open_absolute(parts.parent, false, false)
    } else { LinuxDirFS.open(parts.parent, false, false) };
    if not parent.ok { return _error("private directory parent is unavailable"); }
    let created = LinuxDirFS.mkdir_new(parent, parts.name, false);
    LinuxDirFS.close(parent);
    if type(created) != "map" or not created.ok {
        return _error("private directory must be newly created");
    }
    let fs = if str_starts_with(path, "/") {
        LinuxDirFS.open_absolute(path, false, false)
    } else { LinuxDirFS.open(path, false, false) };
    if not fs.ok { return _error("new private directory cannot be reopened securely"); }
    let policy = LinuxDirFS.private_root_status(fs);
    let closed = LinuxDirFS.close(fs);
    if type(policy) != "map" or not policy.ok or type(closed) != "bool" or not closed {
        return _error("private directory ownership or mode cannot be verified");
    }
    return map{ ok: true };
}

fn _open_parent(path, create) {
    let parts = _parts(path);
    if parts == nil { return _error("invalid secure file path"); }
    let fs = if parts.absolute {
        LinuxDirFS.open_absolute(parts.parent, false, false)
    } else { LinuxDirFS.open(parts.parent, false, false) };
    if not fs.ok and create {
        if not _create_parent(parts.parent).ok { return _error("private parent must exist or be exclusively creatable"); }
        fs = if parts.absolute {
            LinuxDirFS.open_absolute(parts.parent, false, false)
        } else { LinuxDirFS.open(parts.parent, false, false) };
    }
    if not fs.ok { return _error("private parent directory is unavailable"); }
    if not LinuxDirFS.private_root_status(fs).ok {
        LinuxDirFS.close(fs);
        return _error("private parent must already be current-user-owned mode 0700");
    }
    return map{ ok: true, fs: fs, name: parts.name, private_parent_verified: true };
}

fn read_bytes(path, max_bytes) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes) {
        return _error("invalid secure read limit");
    }
    let parent = _open_parent(path, false); if not parent.ok { return parent; }
    let result = LinuxDirFS.read_bytes(parent.fs, parent.name, max_bytes);
    LinuxDirFS.close(parent.fs); return result;
}

fn read_text(path, max_bytes) {
    let result = read_bytes(path, max_bytes); if not result.ok { return result; }
    let text = try bytes_to_str(result.bytes) catch nil;
    if text == nil { return _error("secure file is not valid UTF-8"); }
    return map{ ok: true, text: text, size: result.size };
}

fn write_atomic(path, bytes) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    if type(bytes) != "array" { return _error("secure file bytes must be an array"); }
    let parent = _open_parent(path, true); if not parent.ok { return parent; }
    let result = LinuxDirFS.write_atomic(parent.fs, parent.name, bytes, false);
    LinuxDirFS.close(parent.fs); return result;
}

fn write_text_atomic(path, text) {
    if type(text) != "string" { return _error("secure file text must be a string"); }
    return write_atomic(path, str_to_bytes(text));
}

fn remove(path) {
    if platform() != "linux" { return _error("module cache private files require Linux"); }
    let parent = _open_parent(path, false); if not parent.ok { return parent; }
    let result = LinuxDirFS.remove(parent.fs, parent.name);
    LinuxDirFS.close(parent.fs); return result;
}

export read_bytes, read_text, write_atomic, write_text_atomic, remove;
