//! compiler/typeck.sapp — Self-hosting type checker for pblang
//! Completes the 4-stage compiler pipeline: tokenizer → parser → type_checker → codegen

fn Ty(kind, inner) { return map{ kind: kind, inner: inner }; }
fn ty_any() { return Ty("any", nil); }
fn ty_number() { return Ty("number", nil); }
fn ty_bool() { return Ty("bool", nil); }
fn ty_string() { return Ty("string", nil); }
fn ty_nil() { return Ty("nil", nil); }
fn ty_array(inner) { return Ty("array", inner); }
fn ty_map(k, v) { return Ty("map", map{ key: k, value: v }); }
fn ty_fn(params, ret) { return Ty("fn", map{ params: params, ret: ret }); }
fn ty_option(inner) { return Ty("option", inner); }
fn ty_generic(name) { return Ty("generic", name); }

fn ty_to_string(t) {
    if t["kind"] == "any" { return "any"; }
    if t["kind"] == "number" { return "number"; }
    if t["kind"] == "bool" { return "bool"; }
    if t["kind"] == "string" { return "string"; }
    if t["kind"] == "nil" { return "nil"; }
    if t["kind"] == "array" { return "array<" + ty_to_string(t["inner"]) + ">"; }
    if t["kind"] == "map" {
        return "map<" + ty_to_string(t["inner"]["key"]) + "," + ty_to_string(t["inner"]["value"]) + ">";
    }
    if t["kind"] == "fn" {
        let ps = ""; let i = 0;
        while i < len(t["inner"]["params"]) {
            if i > 0 { ps = ps + ","; }
            ps = ps + ty_to_string(t["inner"]["params"][i]);
            i = i + 1;
        }
        return "fn(" + ps + ")->" + ty_to_string(t["inner"]["ret"]);
    }
    if t["kind"] == "option" { return ty_to_string(t["inner"]) + "?"; }
    if t["kind"] == "generic" { return t["inner"]; }
    return "?";
}

fn ty_eq(a, b) {
    if a["kind"] == "any" or b["kind"] == "any" { return true; }
    if a["kind"] == b["kind"] {
        if a["kind"] == "number" or a["kind"] == "bool" or a["kind"] == "string" or a["kind"] == "nil" { return true; }
        if a["kind"] == "array" { return ty_eq(a["inner"], b["inner"]); }
        if a["kind"] == "map" { return ty_eq(a["inner"]["key"], b["inner"]["key"]) and ty_eq(a["inner"]["value"], b["inner"]["value"]); }
        if a["kind"] == "fn" {
            if len(a["inner"]["params"]) != len(b["inner"]["params"]) { return false; }
            let i = 0;
            while i < len(a["inner"]["params"]) {
                if not ty_eq(a["inner"]["params"][i], b["inner"]["params"][i]) { return false; }
                i = i + 1;
            }
            return ty_eq(a["inner"]["ret"], b["inner"]["ret"]);
        }
        if a["kind"] == "option" { return ty_eq(a["inner"], b["inner"]); }
        if a["kind"] == "generic" { return a["inner"] == b["inner"]; }
    }
    if a["kind"] == "nil" and b["kind"] == "option" { return true; }
    return false;
}

fn TypeEnv() {
    return map{ generics: map{}, diagnostics: [] };
}

fn env_bind(env, name, ty) { env["generics"][name] = ty; }

fn env_resolve(env, ty) {
    if ty["kind"] == "generic" {
        let b = env["generics"][ty["inner"]];
        if b != nil { return b; }
    }
    if ty["kind"] == "array" { return ty_array(env_resolve(env, ty["inner"])); }
    if ty["kind"] == "map" { return ty_map(env_resolve(env, ty["inner"]["key"]), env_resolve(env, ty["inner"]["value"])); }
    if ty["kind"] == "fn" {
        let rp = []; let i = 0;
        while i < len(ty["inner"]["params"]) { array_push(rp, env_resolve(env, ty["inner"]["params"][i])); i = i + 1; }
        return ty_fn(rp, env_resolve(env, ty["inner"]["ret"]));
    }
    if ty["kind"] == "option" { return ty_option(env_resolve(env, ty["inner"])); }
    return ty;
}

fn env_err(env, msg, span) { array_push(env["diagnostics"], map{ message: msg, span: span }); }

fn infer_expr(env, node) {
    if node == nil { return ty_nil(); }
    let k = node["kind"];
    if k == "number" { return ty_number(); }
    if k == "string" { return ty_string(); }
    if k == "bool" { return ty_bool(); }
    if k == "nil" { return ty_nil(); }
    // The parser emits "ident" for variable references; this simple checker does
    // not track per-variable types, so a reference infers to `any`.
    if k == "ident" { return ty_any(); }
    if k == "binary" {
        let op = node["op"];
        if op == "+" or op == "-" or op == "*" or op == "/" { return ty_number(); }
        if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or" { return ty_bool(); }
        return ty_any();
    }
    if k == "call" {
        let ft = infer_expr(env, node["func"]);
        if ft["kind"] == "fn" {
            let i = 0;
            while i < len(node["args"]) and i < len(ft["inner"]["params"]) {
                let at = infer_expr(env, node["args"][i]);
                let pt = ft["inner"]["params"][i];
                if pt["kind"] == "generic" { env_bind(env, pt["inner"], at); }
                i = i + 1;
            }
            return env_resolve(env, ft["inner"]["ret"]);
        }
        return ty_any();
    }
    if k == "array" {
        if len(node["items"]) == 0 { return ty_array(ty_any()); }
        return ty_array(infer_expr(env, node["items"][0]));
    }
    if k == "map" {
        if len(node["entries"]) == 0 { return ty_map(ty_any(), ty_any()); }
        return ty_map(infer_expr(env, node["entries"][0]["key"]), infer_expr(env, node["entries"][0]["value"]));
    }
    return ty_any();
}

// Parser type annotations are plain strings ("number", "string", …), not Ty
// maps. Only the scalar names are unambiguous enough to compare safely; complex
// annotations vary in spelling, so we don't flag them (avoids false positives).
fn _is_scalar_ty_name(s) {
    return s == "number" or s == "string" or s == "bool" or s == "nil";
}

// Walk a `block` node's statements. The parser gives fn/if/while/else bodies as
// block nodes (`{ kind: "block", stmts: [...] }`), NOT bare statement lists.
fn check_block_node(env, blk) {
    if blk == nil { return; }
    if not map_has(blk, "stmts") { return; }
    let stmts = blk["stmts"];
    if stmts == nil { return; }
    let i = 0;
    while i < len(stmts) { check_stmt(env, stmts[i]); i = i + 1; }
}

fn check_stmt(env, stmt) {
    if stmt == nil { return; }
    let k = stmt["kind"];

    if k == "let" or k == "const" {
        let vt = infer_expr(env, stmt["value"]);
        let at = stmt["type"]; // a type-name string, or nil
        // Flag only a concrete scalar-vs-scalar disagreement; skip when the
        // value type is unknown (`any`) so untyped/complex values never
        // false-positive.
        if at != nil and _is_scalar_ty_name(at) {
            let vts = ty_to_string(vt);
            if _is_scalar_ty_name(vts) and vts != at {
                // Parser nodes don't carry a `span` field; read it defensively.
                let sp = if map_has(stmt, "span") { stmt["span"] } else { nil };
                env_err(env, "type mismatch: declared " + at + " but value is " + vts, sp);
            }
        }
        return;
    }

    if k == "fn" {
        let be = TypeEnv();
        let i = 0;
        while i < len(stmt["params"]) {
            let p = stmt["params"][i];
            // Params may be maps {name,type} or bare name strings.
            let pname = if type(p) == "map" { p["name"] } else { p };
            env_bind(be, pname, ty_any());
            i = i + 1;
        }
        check_block_node(be, stmt["body"]);
        let d = 0;
        while d < len(be["diagnostics"]) { array_push(env["diagnostics"], be["diagnostics"][d]); d = d + 1; }
        return;
    }

    if k == "if" {
        let _ = infer_expr(env, stmt["cond"]);
        check_block_node(env, stmt["then"]);
        let elifs = stmt["elifs"];
        if elifs != nil {
            let ei = 0;
            while ei < len(elifs) {
                let _e = infer_expr(env, elifs[ei]["cond"]);
                check_block_node(env, elifs[ei]["body"]);
                ei = ei + 1;
            }
        }
        if stmt["else"] != nil { check_block_node(env, stmt["else"]); }
        return;
    }

    if k == "while" {
        let _ = infer_expr(env, stmt["cond"]);
        check_block_node(env, stmt["body"]);
        return;
    }

    if k == "return" {
        if stmt["value"] != nil { let _ = infer_expr(env, stmt["value"]); }
        return;
    }

    if k == "expr_stmt" { let _ = infer_expr(env, stmt["expr"]); return; }

    if k == "block" {
        let i = 0;
        while i < len(stmt["stmts"]) { check_stmt(env, stmt["stmts"][i]); i = i + 1; }
        return;
    }
}

fn type_check(stmts) {
    let env = TypeEnv();
    let i = 0;
    while i < len(stmts) { check_stmt(env, stmts[i]); i = i + 1; }
    return env["diagnostics"];
}

export Ty; export ty_any; export ty_number; export ty_bool; export ty_string; export ty_nil;
export ty_array; export ty_map; export ty_fn; export ty_option; export ty_generic;
export ty_to_string; export ty_eq;
export TypeEnv; export env_bind; export env_resolve; export env_err;
export infer_expr; export check_stmt; export type_check;
