//! Builtin names recognized and dispatched by the PBLang bytecode VM.
//! Some implementations, including wall time, delegate to the retained host.
//!
//! This intentionally differs from `builtins_list.sapp`, which describes the
//! complete host VM. Keeping this subset shared by codegen and `vm.sapp` lets
//! direct calls carry safe optional metadata without duplicating the list.

// Metadata must not import the ownership engine: code generation only needs
// names. Fresh maps preserve the caller-mutable registry contract.
fn memory_registry() {
    return map{allocate:true, memory_alloc:true, deallocate:true, memory_free:true,
        load:true, memory_get:true, store:true, memory_set:true,
        borrow_immutable:true, borrow_mutable:true, borrow_unique:true,
        memory_borrow:true, release_borrow:true, memory_release:true,
        push_lifetime:true, pop_lifetime:true, memory_stats:true};
}


fn registry() {
    let names = [
        "len", "str", "print", "array_push", "array_pop", "array_sort",
        "str_split", "str_upper", "str_lower", "str_slice", "slice",
        "str_trim", "str_contains", "str_starts_with", "str_ends_with",
        "str_index_of", "str_join", "str_to_bytes", "parse_number", "parse_bool",
        "num_floor", "num_abs", "num_sqrt", "num_mod", "num_max",
        "num_min", "num_pow", "num_ceil", "map_has", "map_keys",
        "map_remove", "strcharcodeat", "strfromcharcode",
        "str_from_char_code", "str_repeat", "is_map", "is_array",
        "is_string", "is_number", "is_nil", "type", "has_member",
        "bit_and", "bit_or", "bit_xor", "bit_not", "bit_shl", "bit_shr",
        "bigint", "rational", "decimal", "num_exp", "num_ln",
        "str_replace_all", "str_pad_left", "str_pad_right", "push", "pop",
        "import", "error", "clock", "now_ms", "now_iso"
    ];
    let result = map{};
    let i = 0;
    while i < len(names) {
        result[names[i]] = true;
        i = i + 1;
    }
    for name in map_keys(memory_registry()) { result[name] = true; }
    return result;
}

export registry, memory_registry;
