// Source-only checking: no VM, code generator, optimizer or module loader.
// Same tokenizer/parser/type checker as selfhost_frontend; parity-tested facade.
// Keep this small entry independent: importing it into the full frontend added
// startup overhead on the retained host.
let _TOKENIZER = import("stdlib:compiler/tokenizer.sapp");
let _PARSER = import("stdlib:compiler/parser.sapp");
let _TYPECHECK = import("stdlib:compiler/typeck.sapp");

fn lexical_errors(tokens) {
    let errors = [];
    for token in tokens {
        if token.kind == "invalid" {
            array_push(errors, "invalid number literal at line " + str(token.line) + ":" + str(token.col));
        }
        if map_has(token, "unterminated") and token.unterminated == true {
            array_push(errors, "unterminated " + token.kind + " starting at line " + str(token.line));
        }
    }
    return errors;
}

fn parse_tokens_checked(tokens) {
    let lexical = lexical_errors(tokens);
    // Do not build a recovered numeric AST or duplicate parser diagnostics.
    // Existing unterminated-string/comment recovery remains available to tools.
    if len(lexical) > 0 {
        for token in tokens {
            if token.kind == "invalid" { return map{ stmts: [], errors: lexical }; }
        }
    }
    let ast = _PARSER.parse(tokens);
    for message in lexical { array_push(ast.errors, message); }
    return ast;
}

fn analyze(source) {
    if source == nil {
        return map{
            ok: false,
            error: "frontend_analyze: source is nil",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
    }

    if str_trim(source) == "" {
        return map{
            ok: false,
            error: "frontend_analyze: source is empty",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
            tokens: [],
        };
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = parse_tokens_checked(tokens);
    let errors = ast.errors;
    // Analysis is used by the public self-hosted check. A parsed AST alone
    // cannot certify calls, names or operand types. Editors needing parse-only
    // recovery retain frontend_parse_full/frontend_parse_safe.
    let diagnostics = [];
    if len(errors) == 0 {
        diagnostics = _TYPECHECK.type_check(ast.stmts);
        for diagnostic in diagnostics { array_push(errors, diagnostic.message); }
    }
    let stmt_count = len(ast.stmts);
    let ok = len(tokens) > 0 and stmt_count > 0 and len(errors) == 0;

    return map{
        ok: ok,
        tokens_count: len(tokens),
        stmt_count: stmt_count,
        diagnostics: diagnostics,
        errors: errors,
        tokens: tokens,
    };
}

export analyze;
