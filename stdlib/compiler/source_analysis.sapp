// Source-only checking: no VM, code generator, optimizer or module loader.
// Same tokenizer/parser/type checker as selfhost_frontend; parity-tested facade.
// Keep this small entry independent: importing it into the full frontend added
// startup overhead on the retained host.
let _TOKENIZER = import("stdlib:compiler/tokenizer.sapp");
let _PARSER = import("stdlib:compiler/parser.sapp");
let _TYPECHECK = import("stdlib:compiler/typeck.sapp");

fn lexical_errors(tokens) {
    let errors = [];
    for token in tokens {
        if token.kind == "invalid" {
            array_push(errors, "invalid number literal at line " + str(token.line) + ":" + str(token.col));
        }
        if map_has(token, "unterminated") and token.unterminated == true {
            array_push(errors, "unterminated " + token.kind + " starting at line " + str(token.line));
        }
    }
    return errors;
}

fn parse_tokens_checked(tokens) {
    let lexical = lexical_errors(tokens);
    // Do not build a recovered numeric AST or duplicate parser diagnostics.
    // Existing unterminated-string/comment recovery remains available to tools.
    if len(lexical) > 0 {
        for token in tokens {
            if token.kind == "invalid" {
                _PARSER.discard_state();
                return map{ stmts: [], errors: lexical };
            }
        }
    }
    let ast = _PARSER.parse(tokens);
    for message in lexical { array_push(ast.errors, message); }
    return ast;
}

fn analyze(source, include_tokens = true) {
    if type(include_tokens) != "bool" { throw "source_analysis: include_tokens must be boolean"; }
    if source == nil {
        _PARSER.discard_state();
        return map{
            ok: false,
            error: "frontend_analyze: source is nil",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
    }

    if str_trim(source) == "" {
        _PARSER.discard_state();
        let result = map{
            ok: false,
            error: "frontend_analyze: source is empty",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
        if include_tokens { result.tokens = []; }
        return result;
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = parse_tokens_checked(tokens);
    let tokens_count = len(tokens);
    // The parser has released its own references. CLI gates do not consume
    // tokens, so stop retaining them before allocating type-checker state.
    if not include_tokens { tokens = []; }
    let errors = ast.errors;
    // Analysis is used by the public self-hosted check. A parsed AST alone
    // cannot certify calls, names or operand types. Editors needing parse-only
    // recovery retain frontend_parse_full/frontend_parse_safe.
    let diagnostics = [];
    if len(errors) == 0 {
        diagnostics = _TYPECHECK.type_check(ast.stmts);
        for diagnostic in diagnostics { array_push(errors, diagnostic.message); }
    }
    let stmt_count = len(ast.stmts);
    let ok = tokens_count > 0 and stmt_count > 0 and len(errors) == 0;

    let result = map{
        ok: ok,
        tokens_count: tokens_count,
        stmt_count: stmt_count,
        diagnostics: diagnostics,
        errors: errors,
    };
    if include_tokens { result.tokens = tokens; }
    return result;
}

// Parse/type facades for diagnostics consumers that do not execute source.
// Structured outputs intentionally match selfhost_frontend; parity tests guard
// the separate small facade so full-runtime imports do not become mandatory.
fn _parse_full(source) {
    if source == nil or source == "" {
        return map{
            ok: false,
            error: "frontend_parse_full: source is empty",
            ast: nil,
        };
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = parse_tokens_checked(tokens);

    let errors = ast.errors;

    return map{
        // A recovered AST is successful only when non-empty and error-free.
        ok: len(ast.stmts) > 0 and len(errors) == 0,
        ast: ast,
        tokens_count: len(tokens),
        errors: errors,
    };
}

/// Safe parser wrapper for tools/AI callers.
/// Parser/tokenizer exceptions become structured diagnostics. This does not
/// establish an execution-time or memory budget for supplied source.
fn parse_safe(source) {
    if source == nil or source == "" {
        _PARSER.discard_state();
        return map{
            format: "pblang.frontend.parse_safe.v1",
            ok: false,
            reason: "empty_source",
            ast: nil,
            tokens_count: 0,
            errors: ["frontend_parse_safe: source is empty"],
        };
    }
    let parsed = try _parse_full(source) catch nil;
    if parsed == nil {
        _PARSER.discard_state();
        return map{
            format: "pblang.frontend.parse_safe.v1",
            ok: false,
            reason: "parser_exception",
            ast: nil,
            tokens_count: 0,
            errors: ["frontend parser threw while parsing source"],
        };
    }
    let errors = try parsed.errors catch [];
    let ok = (try parsed.ok catch false) and len(errors) == 0;
    return map{
        format: "pblang.frontend.parse_safe.v1",
        ok: ok,
        reason: if ok { "parsed" } else { "parser_reported_errors" },
        ast: try parsed.ast catch nil,
        tokens_count: try parsed.tokens_count catch 0,
        errors: errors,
    };
}

/// Run type checking on an AST.
/// Returns an ok flag and the diagnostics array. Expects the parser's AST schema.
fn typecheck(ast) {
    if ast == nil {
        return map{
            ok: false,
            error: "frontend_typecheck: ast is nil",
            diagnostics: [],
        };
    }

    let stmts = ast.stmts;
    if stmts == nil { stmts = []; }

    let diagnostics = _TYPECHECK.type_check(stmts);

    return map{
        ok: len(diagnostics) == 0,
        diagnostics: diagnostics,
    };
}

export analyze, parse_safe, typecheck;
