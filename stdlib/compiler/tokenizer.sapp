// stdlib/compiler/tokenizer.sapp — pblang tokenizer written IN pblang itself.
//
// This is the first step toward self-hosting: a pblang source code tokenizer
// that breaks .sapp source into tokens. Future self-hosting milestones:
//   Tokenizer ✅ → Parser → Type Checker → Compiler → Full Bootstrap
//
// Token types recognized:
//   keyword   — fn, let, const, if, else, elif, while, for, in, return,
//               break, continue, import, export, throw, try, catch, defer,
//               true, false, nil, match, case, class, struct, enum, spawn, join,
//               loop, and, or, not
//   ident     — variable names, function names
//   number    — integer and decimal literals (42, 3.14, -1.5, 1e10)
//   string    — "double-quoted strings"
//   operator  — + - * / % ** == != < > <= >= = += -= *= /= && || ! ?? ?. ?[
//   punct     — ( ) { } [ ] , ; : . .. # @ ->
//   comment   — // single-line, /* block */
//   invalid   — malformed numeric literal (fixed diagnostic text)
//   eof       — end of file
//
// Usage:
//   let tok = import("stdlib/compiler/tokenizer.sapp");
//   let tokens = tok.tokenize(source_code);
//   for t in tokens { print(t.kind + ": " + t.text); }

fn make_token(kind, text, line, col) {
    return map{
        kind: kind,
        text: text,
        line: line,
        col: col,
    };
}

fn push(arr, value) {
    array_push(arr, value);
}

let KEYWORDS = map{
    "fn": true,       "let": true,      "const": true,
    "if": true,       "else": true,     "elif": true,
    "while": true,    "for": true,      "in": true,
    "return": true,   "break": true,    "continue": true,
    "import": true,   "export": true,   "throw": true,
    "try": true,      "catch": true,    "defer": true,
    "true": true,     "false": true,    "nil": true,
    "match": true,    "case": true,     "class": true,
    "struct": true,   "enum": true,     "loop": true,
    "and": true,      "or": true,       "not": true,
    "is": true,       "interface": true,
    // NOTE: `spawn`/`join` are NOT keywords — they are ordinary global builtins
    // (as in the Rust frontend), so `spawn(f)`/`join(t)` parse as normal calls and
    // the `async`/`await` desugar (§48 port) resolves them at runtime.
};

fn is_keyword(word) {
    return (try KEYWORDS[word] catch nil) != nil;
}

fn is_alpha(c) {
    let code = strcharcodeat(c, 0);
    if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95 { return true; }
    if code < 128 { return false; }
    // Unicode letters (UAX#31 subset) — parity with the Rust lexer's
    // is_ident_start_char and stdlib/unicode_ident.sapp. Lets the self-hosted
    // compiler accept café/π/λ/変数 identifiers like `pblang run` does.
    return (code >= 0xC0 and code <= 0xD6) or (code >= 0xD8 and code <= 0xF6)
        or (code >= 0xF8 and code <= 0x2FF) or (code >= 0x1E00 and code <= 0x1EFF)
        or (code >= 0x370 and code <= 0x3FF) or (code >= 0x400 and code <= 0x4FF)
        or (code >= 0x531 and code <= 0x556) or (code >= 0x561 and code <= 0x586)
        or (code >= 0x5D0 and code <= 0x5EA) or (code >= 0x620 and code <= 0x64A)
        or (code >= 0x66E and code <= 0x6D3) or (code >= 0x904 and code <= 0x939)
        or (code >= 0x3041 and code <= 0x3096) or (code >= 0x30A1 and code <= 0x30FA)
        or (code >= 0x3400 and code <= 0x4DBF) or (code >= 0x4E00 and code <= 0x9FFF)
        or (code >= 0xAC00 and code <= 0xD7A3)
        or code == 0xAA or code == 0xB5 or code == 0xBA;
}

// True if the last significant token ENDS A VALUE, so a following `-` is binary
// subtraction (e.g. `n - 1`), NOT the sign of a negative literal. Without this,
// `n-1` (no spaces) mis-lexes `-1` as a negative number and drops the subtraction.
// Comments are skipped. Value-enders: number/string/identifier and `)` / `]`.
fn _prev_ends_value(tokens) {
    let i = len(tokens) - 1;
    while i >= 0 {
        let t = tokens[i];
        if t.kind == "comment" { i = i - 1; }
        else {
            if t.kind == "number" or t.kind == "string" or t.kind == "ident" { return true; }
            if t.kind == "punct" and (t.text == ")" or t.text == "]") { return true; }
            return false;
        }
    }
    return false;
}

fn is_digit(c) {
    let code = strcharcodeat(c, 0);
    return code >= 48 and code <= 57;
}

// Value of a radix digit `c` in the given base (2/8/16), or -1 if not a digit
// of that base. Used for `0x..` / `0b..` / `0o..` literals (§47 port).
fn _radix_digit_val(c, base) {
    let code = strcharcodeat(c, 0);
    let v = -1;
    if code >= 48 and code <= 57 { v = code - 48; }        // 0-9
    else if code >= 97 and code <= 102 { v = code - 97 + 10; } // a-f
    else if code >= 65 and code <= 70 { v = code - 65 + 10; }  // A-F
    if v < 0 { return -1; }
    if v >= base { return -1; }
    return v;
}

fn is_alnum(c) {
    if is_alpha(c) or is_digit(c) { return true; }
    // Combining marks may continue an identifier (decomposed accents).
    let code = strcharcodeat(c, 0);
    return (code >= 0x300 and code <= 0x36F) or (code >= 0x1DC0 and code <= 0x1DFF);
}

fn is_space(c) {
    return c == " " or c == "\t" or c == "\r" or c == "\n";
}

fn char_at(s, i) {
    // Use `slice` for substring output. `strcharcodeat` is now codepoint-indexed
    // too, but it returns a scalar number, not a string. (O(i) for UTF-8;
    // `tokenize` pre-splits into a char array and uses `_cat` for O(1) access.)
    return slice(s, i, i + 1);
}

fn _hex_val(c) {
    let code = strcharcodeat(c, 0);
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 65 and code <= 70 { return code - 65 + 10; }
    if code >= 97 and code <= 102 { return code - 97 + 10; }
    return -1;
}

fn _valid_scalar(cp) {
    return cp >= 0 and cp <= 1114111 and not (cp >= 55296 and cp <= 57343);
}

fn _hex_to_scalar(hex) {
    let cp = 0;
    let i = 0;
    while i < len(hex) {
        let v = _hex_val(char_at(hex, i));
        if v < 0 { return 65533; }
        cp = cp * 16 + v;
        i = i + 1;
    }
    if not _valid_scalar(cp) { return 65533; }
    return cp;
}

fn _decode_escape(chars, pos, n) {
    let esc = _cat(chars, pos);
    if esc == "n" { return map{ text: "\n", end: pos + 1 }; }
    if esc == "t" { return map{ text: "\t", end: pos + 1 }; }
    if esc == "r" { return map{ text: "\r", end: pos + 1 }; }
    if esc == "\"" { return map{ text: "\"", end: pos + 1 }; }
    if esc == "\\" { return map{ text: "\\", end: pos + 1 }; }
    if esc == "0" { return map{ text: strfromcharcode(0), end: pos + 1 }; }
    if esc == "{" { return map{ text: "{", end: pos + 1 }; }
    if esc == "}" { return map{ text: "}", end: pos + 1 }; }
    if esc == "x" and pos + 2 < n {
        let a = _hex_val(_cat(chars, pos + 1));
        let b = _hex_val(_cat(chars, pos + 2));
        if a >= 0 and b >= 0 { return map{ text: strfromcharcode(a * 16 + b), end: pos + 3 }; }
    }
    if esc == "u" {
        if pos + 2 < n and _cat(chars, pos + 1) == "{" {
            let i = pos + 2;
            let hex = "";
            while i < n and _cat(chars, i) != "}" and len(hex) < 6 {
                if _hex_val(_cat(chars, i)) < 0 { break; }
                hex = hex + _cat(chars, i);
                i = i + 1;
            }
            if len(hex) > 0 and i < n and _cat(chars, i) == "}" {
                return map{ text: strfromcharcode(_hex_to_scalar(hex)), end: i + 1 };
            }
        }
        if pos + 4 < n {
            let hex4 = "";
            let j = pos + 1;
            while j < pos + 5 and _hex_val(_cat(chars, j)) >= 0 {
                hex4 = hex4 + _cat(chars, j);
                j = j + 1;
            }
            if len(hex4) == 4 {
                return map{ text: strfromcharcode(_hex_to_scalar(hex4)), end: pos + 5 };
            }
        }
    }
    return map{ text: esc, end: pos + 1 };
}

// O(1) bounds-safe char access into a pre-split char array (str_split(s, "")).
// Out-of-range reads return "" (matching slice-past-end), so `pos + 1` lookups
// at the end of input are safe.
fn _cat(chars, i) {
    if i >= 0 and i < len(chars) { return chars[i]; }
    return "";
}

fn tokenize(source, identifier_spans = false) {
    return _tokenize(source, identifier_spans, nil);
}

// Opt-in token allocation budget. Callers must separately bound source bytes;
// the character array and one long token are not bounded by token count alone.
fn tokenize_bounded(source, max_tokens, identifier_spans = false) {
    let invalid = type(source) != "string" or type(identifier_spans) != "bool";
    if type(max_tokens) != "number" { invalid = true; }
    elif max_tokens != max_tokens or max_tokens - max_tokens != 0 { invalid = true; }
    elif max_tokens < 1 or max_tokens > 1048576 or max_tokens != num_floor(max_tokens) { invalid = true; }
    if invalid {
        return map{ ok: false, tokens: [], token_count: 0, limit_exceeded: false,
            error: "bounded tokenizer requires text, boolean spans and a finite integer token cap in 1..1048576" };
    }
    let tokens = _tokenize(source, identifier_spans, max_tokens);
    if tokens == nil {
        return map{ ok: false, tokens: [], token_count: 0, limit_exceeded: true,
            error: "token limit exceeded" };
    }
    return map{ ok: true, tokens: tokens, token_count: len(tokens), limit_exceeded: false, error: "" };
}

fn _tokenize(source, identifier_spans, max_tokens) {
    let tokens = [];
    let token_count = 0;
    let pos = 0;
    let len = len(source);
    let chars = str_split(source, "");
    let line = 1;
    let col = 1;

    while pos < len {
        // Skip whitespace
        while pos < len and is_space(_cat(chars, pos)) {
            if _cat(chars, pos) == "\n" {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
            pos = pos + 1;
        }
        if pos >= len { break; }

        // Reserve EOF, then reject before allocating the next token or its
        // text. Every branch below emits exactly one non-EOF token.
        if max_tokens != nil {
            if token_count + 1 >= max_tokens { return nil; }
            token_count = token_count + 1;
        }

        let start_line = line;
        let start_col = col;
        let ch = _cat(chars, pos);

        // String literal
        if ch == "\"" {
            pos = pos + 1;
            col = col + 1;
            let text = "";
            while pos < len and _cat(chars, pos) != "\"" {
                if _cat(chars, pos) == "\\" {
                    pos = pos + 1; col = col + 1;
                    if pos < len {
                        let decoded = _decode_escape(chars, pos, len);
                        text = text + decoded.text;
                        // Count physical source newlines, not decoded escapes
                        // such as backslash-n or a Unicode newline scalar.
                        if _cat(chars, pos) == "\n" {
                            line = line + 1; col = 1;
                        } else { col = col + (decoded.end - pos); }
                        pos = decoded.end;
                    }
                } else {
                    text = text + _cat(chars, pos);
                    if _cat(chars, pos) == "\n" {
                        line = line + 1; col = 1;
                    } else { col = col + 1; }
                    pos = pos + 1;
                }
            }
            // The loop above stops at the closing quote OR at EOF. If we're at
            // EOF, the string was never closed — flag it so the parser/frontend
            // reports an error instead of silently accepting the truncated text.
            let closed = pos < len;
            if closed {
                pos = pos + 1; col = col + 1; // skip closing quote
            }
            let stok = make_token("string", text, start_line, start_col);
            if not closed { stok.unterminated = true; }
            push(tokens, stok);
            continue;
        }

        // Number (including a leading-minus negative literal, but ONLY in unary
        // position — when the previous token does not end a value, so `n-1` is the
        // subtraction `n - 1` while `-1` / `(-1)` / `f(-1)` stay negative literals).
        if is_digit(ch) or (ch == "-" and pos + 1 < len and is_digit(_cat(chars, pos + 1)) and not _prev_ends_value(tokens)) {
            let number_start = pos;
            let neg = false;
            if ch == "-" {
                neg = true;
                pos = pos + 1; col = col + 1;
            }
            // Radix literals: 0x.. (hex) / 0b.. (binary) / 0o.. (octal). §47 port.
            if _cat(chars, pos) == "0" and pos + 1 < len {
                let p2 = _cat(chars, pos + 1);
                let base = 0;
                if p2 == "x" or p2 == "X" { base = 16; }
                if p2 == "b" or p2 == "B" { base = 2; }
                if p2 == "o" or p2 == "O" { base = 8; }
                if base > 0 {
                    pos = pos + 2; col = col + 2;   // consume the 0x / 0b / 0o
                    let digits_start = pos;
                    let value = 0;
                    while pos < len and _radix_digit_val(_cat(chars, pos), base) >= 0 {
                        value = value * base + _radix_digit_val(_cat(chars, pos), base);
                        pos = pos + 1; col = col + 1;
                    }
                    let invalid = pos == digits_start;
                    // A contiguous out-of-base digit/name belongs to this bad
                    // literal, not to a second expression (e.g. 0b102).
                    while pos < len and is_alnum(_cat(chars, pos)) {
                        invalid = true;
                        pos = pos + 1; col = col + 1;
                    }
                    if invalid {
                        push(tokens, make_token("invalid", "invalid number literal", start_line, start_col));
                    } else {
                        if neg { value = 0 - value; }
                        push(tokens, make_token("number", str(value), start_line, start_col));
                    }
                    continue;
                }
            }
            while pos < len and is_digit(_cat(chars, pos)) {
                pos = pos + 1; col = col + 1;
            }
            // A `.` starts a fraction only when NOT followed by another `.` —
            // `1..3` is the range `1 .. 3` (slice sugar), not the float `1.`
            // followed by `.3` (mirrors the Rust lexer's lookahead).
            if pos < len and _cat(chars, pos) == "."
               and not (pos + 1 < len and _cat(chars, pos + 1) == ".") {
                pos = pos + 1; col = col + 1;
                while pos < len and is_digit(_cat(chars, pos)) {
                    pos = pos + 1; col = col + 1;
                }
            }
            let invalid = false;
            if pos < len and (_cat(chars, pos) == "e" or _cat(chars, pos) == "E") {
                pos = pos + 1; col = col + 1;
                if _cat(chars, pos) == "+" or _cat(chars, pos) == "-" {
                    pos = pos + 1; col = col + 1;
                }
                let exponent_start = pos;
                while pos < len and is_digit(_cat(chars, pos)) {
                    pos = pos + 1; col = col + 1;
                }
                invalid = pos == exponent_start;
            }
            // A number cannot run directly into a word/identifier continuation.
            // Keep the whole malformed spelling in one token (1e2name, 123_).
            while pos < len and is_alnum(_cat(chars, pos)) {
                invalid = true;
                pos = pos + 1; col = col + 1;
            }
            if invalid {
                push(tokens, make_token("invalid", "invalid number literal", start_line, start_col));
                continue;
            }
            let text = if pos == number_start + 1 { chars[number_start] }
                else { str_join(slice(chars, number_start, pos), "") };
            push(tokens, make_token("number", text, start_line, start_col));
            continue;
        }

        // Identifier or keyword
        if is_alpha(ch) {
            let start_pos = pos;
            while pos < len and is_alnum(_cat(chars, pos)) {
                pos = pos + 1; col = col + 1;
            }
            // Join the existing scalar span once; do not repeatedly grow text
            // or rescan a UTF-8 source prefix for each token.
            let text = if pos == start_pos + 1 { chars[start_pos] }
                else { str_join(slice(chars, start_pos, pos), "") };
            let kind = "ident";
            if is_keyword(text) { kind = "keyword"; }
            let token = make_token(kind, text, start_line, start_col);
            // Opt-in scalar offsets: ordinary token schemas remain unchanged.
            if identifier_spans == true {
                token.source_start = start_pos;
                token.source_end = pos;
            }
            push(tokens, token);
            continue;
        }

        // Single-line comment //
        if ch == "/" and pos + 1 < len and _cat(chars, pos + 1) == "/" {
            pos = pos + 2; col = col + 2;
            let comment_start = pos;
            while pos < len and _cat(chars, pos) != "\n" {
                pos = pos + 1; col = col + 1;
            }
            let text = str_join(slice(chars, comment_start, pos), "");
            push(tokens, make_token("comment", text, start_line, start_col));
            continue;
        }

        // Block comment /* */
        if ch == "/" and pos + 1 < len and _cat(chars, pos + 1) == "*" {
            pos = pos + 2; col = col + 2;
            let comment_start = pos;
            let closed = false;
            while pos < len {
                if _cat(chars, pos) == "*" and pos + 1 < len and _cat(chars, pos + 1) == "/" {
                    pos = pos + 2; col = col + 2;
                    closed = true;
                    break;
                }
                if _cat(chars, pos) == "\n" { line = line + 1; col = 1; }
                else { col = col + 1; }
                pos = pos + 1;
            }
            let comment_end = if closed { pos - 2 } else { pos };
            let text = str_join(slice(chars, comment_start, comment_end), "");
            // Reached EOF without a `*/` → unterminated block comment.
            let ctok = make_token("comment", text, start_line, start_col);
            if not closed { ctok.unterminated = true; }
            push(tokens, ctok);
            continue;
        }

        // Two-char operators and punct
        let two_char = ch + (if pos + 1 < len { _cat(chars, pos + 1) } else { "" });
        if two_char == "==" or two_char == "!=" or two_char == "<=" or two_char == ">="
           or two_char == "+=" or two_char == "-=" or two_char == "*=" or two_char == "/=" or two_char == "%="
           or two_char == "**" or two_char == "->" or two_char == "?."
           or two_char == "?[" or two_char == "??" or two_char == "||"
           or two_char == "&&" or two_char == ".."
           or two_char == "<<" or two_char == ">>" {   // bitwise shifts (§47 port)
            push(tokens, make_token("operator", two_char, start_line, start_col));
            pos = pos + 2; col = col + 2;
            continue;
        }

        // Single-char operators and punctuation (incl. bitwise & | ^ ~ — §47 port)
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%"
           or ch == "=" or ch == "<" or ch == ">" or ch == "!" or ch == "?"
           or ch == "&" or ch == "|" or ch == "^" or ch == "~" {
            push(tokens, make_token("operator", ch, start_line, start_col));
        } else {
            push(tokens, make_token("punct", ch, start_line, start_col));
        }
        pos = pos + 1; col = col + 1;
    }

    push(tokens, make_token("eof", "", line, col));
    return tokens;
}

fn format_tokens(tokens) {
    let out = "";
    for t in tokens {
        if t.kind != "eof" {
            out = out + t.kind + ":" + str(t.line) + ":" + str(t.col) + "  " + t.text + "\n";
        }
    }
    return out;
}

export tokenize, tokenize_bounded, format_tokens, make_token, is_keyword;
