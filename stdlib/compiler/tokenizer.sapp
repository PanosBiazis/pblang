// stdlib/compiler/tokenizer.sapp — pblang tokenizer written IN pblang itself.
//
// This is the first step toward self-hosting: a pblang source code tokenizer
// that breaks .sapp source into tokens. Future self-hosting milestones:
//   Tokenizer ✅ → Parser → Type Checker → Compiler → Full Bootstrap
//
// Token types recognized:
//   keyword   — fn, let, const, if, else, elif, while, for, in, return,
//               break, continue, import, export, throw, try, catch, defer,
//               true, false, nil, match, case, class, struct, enum, spawn, join,
//               loop, and, or, not
//   ident     — variable names, function names
//   number    — integer and decimal literals (42, 3.14, -1.5, 1e10)
//   string    — "double-quoted strings"
//   operator  — + - * / % ** == != < > <= >= = += -= *= /= && || ! ?? ?. ?[
//   punct     — ( ) { } [ ] , ; : . .. # @ ->
//   comment   — // single-line, /* block */
//   eof       — end of file
//
// Usage:
//   let tok = import("stdlib/compiler/tokenizer.sapp");
//   let tokens = tok.tokenize(source_code);
//   for t in tokens { print(t.kind + ": " + t.text); }

fn make_token(kind, text, line, col) {
    return map{
        kind: kind,
        text: text,
        line: line,
        col: col,
    };
}

fn push(arr, value) {
    array_push(arr, value);
}

let KEYWORDS = map{
    "fn": true,       "let": true,      "const": true,
    "if": true,       "else": true,     "elif": true,
    "while": true,    "for": true,      "in": true,
    "return": true,   "break": true,    "continue": true,
    "import": true,   "export": true,   "throw": true,
    "try": true,      "catch": true,    "defer": true,
    "true": true,     "false": true,    "nil": true,
    "match": true,    "case": true,     "class": true,
    "struct": true,   "enum": true,     "spawn": true,
    "join": true,     "loop": true,     "and": true,
    "or": true,       "not": true,      "is": true,
};

fn is_keyword(word) {
    return (try KEYWORDS[word] catch nil) != nil;
}

fn is_alpha(c) {
    let code = strcharcodeat(c, 0);
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95;
}

fn is_digit(c) {
    let code = strcharcodeat(c, 0);
    return code >= 48 and code <= 57;
}

fn is_alnum(c) {
    return is_alpha(c) or is_digit(c);
}

fn is_space(c) {
    return c == " " or c == "\t" or c == "\r" or c == "\n";
}

fn char_at(s, i) {
    return strfromcharcode(strcharcodeat(s, i));
}

fn tokenize(source) {
    let tokens = [];
    let pos = 0;
    let len = len(source);
    let line = 1;
    let col = 1;

    while pos < len {
        // Skip whitespace
        while pos < len and is_space(char_at(source, pos)) {
            if char_at(source, pos) == "\n" {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
            pos = pos + 1;
        }
        if pos >= len { break; }

        let start_line = line;
        let start_col = col;
        let ch = char_at(source, pos);

        // String literal
        if ch == "\"" {
            pos = pos + 1;
            col = col + 1;
            let text = "";
            while pos < len and char_at(source, pos) != "\"" {
                if char_at(source, pos) == "\\" {
                    pos = pos + 1; col = col + 1;
                    if pos < len {
                        text = text + char_at(source, pos);
                        pos = pos + 1; col = col + 1;
                    }
                } else {
                    text = text + char_at(source, pos);
                    pos = pos + 1; col = col + 1;
                }
            }
            if pos < len {
                pos = pos + 1; col = col + 1; // skip closing quote
            }
            push(tokens, make_token("string", text, start_line, start_col));
            continue;
        }

        // Number (including negative)
        if is_digit(ch) or (ch == "-" and pos + 1 < len and is_digit(char_at(source, pos + 1))) {
            let text = "";
            if ch == "-" {
                text = "-";
                pos = pos + 1; col = col + 1;
            }
            while pos < len and is_digit(char_at(source, pos)) {
                text = text + char_at(source, pos);
                pos = pos + 1; col = col + 1;
            }
            if pos < len and char_at(source, pos) == "." {
                text = text + ".";
                pos = pos + 1; col = col + 1;
                while pos < len and is_digit(char_at(source, pos)) {
                    text = text + char_at(source, pos);
                    pos = pos + 1; col = col + 1;
                }
            }
            if pos < len and (char_at(source, pos) == "e" or char_at(source, pos) == "E") {
                text = text + char_at(source, pos);
                pos = pos + 1; col = col + 1;
                if char_at(source, pos) == "+" or char_at(source, pos) == "-" {
                    text = text + char_at(source, pos);
                    pos = pos + 1; col = col + 1;
                }
                while pos < len and is_digit(char_at(source, pos)) {
                    text = text + char_at(source, pos);
                    pos = pos + 1; col = col + 1;
                }
            }
            push(tokens, make_token("number", text, start_line, start_col));
            continue;
        }

        // Identifier or keyword
        if is_alpha(ch) {
            let text = "";
            while pos < len and is_alnum(char_at(source, pos)) {
                text = text + char_at(source, pos);
                pos = pos + 1; col = col + 1;
            }
            let kind = "ident";
            if is_keyword(text) { kind = "keyword"; }
            push(tokens, make_token(kind, text, start_line, start_col));
            continue;
        }

        // Single-line comment //
        if ch == "/" and pos + 1 < len and char_at(source, pos + 1) == "/" {
            pos = pos + 2; col = col + 2;
            let text = "";
            while pos < len and char_at(source, pos) != "\n" {
                text = text + char_at(source, pos);
                pos = pos + 1; col = col + 1;
            }
            push(tokens, make_token("comment", text, start_line, start_col));
            continue;
        }

        // Block comment /* */
        if ch == "/" and pos + 1 < len and char_at(source, pos + 1) == "*" {
            pos = pos + 2; col = col + 2;
            let text = "";
            while pos < len {
                if char_at(source, pos) == "*" and pos + 1 < len and char_at(source, pos + 1) == "/" {
                    pos = pos + 2; col = col + 2;
                    break;
                }
                if char_at(source, pos) == "\n" { line = line + 1; col = 1; }
                else { col = col + 1; }
                text = text + char_at(source, pos);
                pos = pos + 1;
            }
            push(tokens, make_token("comment", text, start_line, start_col));
            continue;
        }

        // Two-char operators and punct
        let two_char = ch + (if pos + 1 < len { char_at(source, pos + 1) } else { "" });
        if two_char == "==" or two_char == "!=" or two_char == "<=" or two_char == ">="
           or two_char == "+=" or two_char == "-=" or two_char == "*=" or two_char == "/="
           or two_char == "**" or two_char == "->" or two_char == "?."
           or two_char == "?[" or two_char == "??" or two_char == "||"
           or two_char == "&&" or two_char == ".." {
            push(tokens, make_token("operator", two_char, start_line, start_col));
            pos = pos + 2; col = col + 2;
            continue;
        }

        // Single-char operators and punctuation
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%"
           or ch == "=" or ch == "<" or ch == ">" or ch == "!" or ch == "?" {
            push(tokens, make_token("operator", ch, start_line, start_col));
        } else {
            push(tokens, make_token("punct", ch, start_line, start_col));
        }
        pos = pos + 1; col = col + 1;
    }

    push(tokens, make_token("eof", "", line, col));
    return tokens;
}

fn format_tokens(tokens) {
    let out = "";
    for t in tokens {
        if t.kind != "eof" {
            out = out + t.kind + ":" + str(t.line) + ":" + str(t.col) + "  " + t.text + "\n";
        }
    }
    return out;
}

export tokenize, format_tokens, make_token, is_keyword;
