// stdlib/compiler/optimizer.sapp — Peephole optimizer for pblang bytecode
//
// Self-hosting milestone: bytecode optimization passes.
//
// Optimizations:
//   1. Constant folding   — evaluate arithmetic at compile time (2+3 → 5)
//   2. Dead code elimination — remove unreachable instructions after return/jump
//   3. Jump optimization  — jump-to-jump simplification
//   4. Strength reduction — mul 2 → add self, power-of-2 operations
//
// Usage:
//   let opt = import("stdlib/compiler/optimizer.sapp");
//   let result = opt.optimize(chunk);
//   print opt.stats_to_string(result.stats);

let OP_CONSTANT = 0;
let OP_ADD = 1;
let OP_SUB = 2;
let OP_MUL = 3;
let OP_DIV = 4;
let OP_MOD = 31;   // modulo (matches codegen.sapp / vm.sapp numbering)
let OP_EQ = 5;
let OP_NOT_EQ = 6;
let OP_GT = 7;
let OP_GE = 8;
let OP_LT = 9;
let OP_LE = 10;
let OP_POP = 11;
let OP_PRINT = 12;
let OP_DEFINE_GLOBAL = 13;
let OP_GET_GLOBAL = 14;
let OP_SET_GLOBAL = 15;
let OP_GET_LOCAL = 16;
let OP_SET_LOCAL = 17;
let OP_CALL = 18;
let OP_RETURN = 19;
let OP_JUMP = 20;
let OP_JUMP_IF_FALSE = 21;
let OP_JUMP_IF_TRUE = 22;
let OP_NOT = 23;
let OP_CLOSURE = 24;
let OP_MAKE_ARRAY = 25;
let OP_MAKE_MAP = 26;
let OP_GET_INDEX = 27;
let OP_SET_INDEX = 28;
let OP_GET_ATTR = 29;
let OP_SET_ATTR = 30;
// Short-circuit / nil-coalescing peek-jumps (must be remapped after any pass
// that removes instructions, exactly like the plain jumps above).
let OP_JUMP_IF_FALSE_PEEK = 33;
let OP_JUMP_IF_TRUE_PEEK = 34;

// opcode_name(op) — debug name for every opcode this optimizer reasons about
// (turns the constant table into a real tracing surface for stats output).
fn opcode_name(op) {
    if op == OP_CONSTANT { return "OpConstant"; }
    if op == OP_ADD { return "OpAdd"; }
    if op == OP_SUB { return "OpSub"; }
    if op == OP_MUL { return "OpMul"; }
    if op == OP_DIV { return "OpDiv"; }
    if op == OP_MOD { return "OpMod"; }
    if op == OP_EQ { return "OpEq"; }
    if op == OP_NOT_EQ { return "OpNotEq"; }
    if op == OP_GT { return "OpGt"; }
    if op == OP_GE { return "OpGe"; }
    if op == OP_LT { return "OpLt"; }
    if op == OP_LE { return "OpLe"; }
    if op == OP_POP { return "OpPop"; }
    if op == OP_PRINT { return "OpPrint"; }
    if op == OP_DEFINE_GLOBAL { return "OpDefineGlobal"; }
    if op == OP_GET_GLOBAL { return "OpGetGlobal"; }
    if op == OP_SET_GLOBAL { return "OpSetGlobal"; }
    if op == OP_GET_LOCAL { return "OpGetLocal"; }
    if op == OP_SET_LOCAL { return "OpSetLocal"; }
    if op == OP_CALL { return "OpCall"; }
    if op == OP_RETURN { return "OpReturn"; }
    if op == OP_JUMP { return "OpJump"; }
    if op == OP_JUMP_IF_FALSE { return "OpJumpIfFalse"; }
    if op == OP_JUMP_IF_TRUE { return "OpJumpIfTrue"; }
    if op == OP_NOT { return "OpNot"; }
    if op == OP_CLOSURE { return "OpClosure"; }
    if op == OP_MAKE_ARRAY { return "OpMakeArray"; }
    if op == OP_MAKE_MAP { return "OpMakeMap"; }
    if op == OP_GET_INDEX { return "OpGetIndex"; }
    if op == OP_SET_INDEX { return "OpSetIndex"; }
    if op == OP_GET_ATTR { return "OpGetAttr"; }
    if op == OP_SET_ATTR { return "OpSetAttr"; }
    if op == OP_JUMP_IF_FALSE_PEEK { return "OpJumpIfFalsePeek"; }
    if op == OP_JUMP_IF_TRUE_PEEK { return "OpJumpIfTruePeek"; }
    return "Op?" + str(op);
}
let OP_JUMP_IF_NIL_PEEK = 36;
let OP_JUMP_IF_NOT_NIL_PEEK = 37;

fn make_inst(op, operand) {
    return map{ op: op, operand: operand };
}

fn copy_instructions(src) {
    let out = [];
    let i = 0;
    while i < len(src) {
        let inst = src[i];
        array_push(out, map{ op: inst.op, operand: inst.operand });
        i = i + 1;
    }
    return out;
}

fn copy_constants(src) {
    let out = [];
    let i = 0;
    while i < len(src) {
        array_push(out, src[i]);
        i = i + 1;
    }
    return out;
}

fn copy_chunk(chunk) {
    return map{
        instructions: copy_instructions(chunk.instructions),
        constants: copy_constants(chunk.constants),
    };
}

fn chunk_len(chunk) {
    return len(chunk.instructions);
}

fn inst_at(chunk, idx) {
    if idx < 0 or idx >= len(chunk.instructions) { return nil; }
    return chunk.instructions[idx];
}

fn set_inst(chunk, idx, inst) {
    if idx >= 0 and idx < len(chunk.instructions) {
        chunk.instructions[idx] = inst;
    }
}

fn constant_at(chunk, idx) {
    if idx < 0 or idx >= len(chunk.constants) { return nil; }
    return chunk.constants[idx];
}

fn add_constant(chunk, value) {
    array_push(chunk.constants, value);
    return len(chunk.constants) - 1;
}

fn is_number(val) {
    return type(val) == "number";
}

// True for every opcode whose operand is an absolute instruction index (a jump
// target). These MUST be remapped whenever instructions are removed.
fn _is_jump_op(op) {
    return op == OP_JUMP
        or op == OP_JUMP_IF_FALSE or op == OP_JUMP_IF_TRUE
        or op == OP_JUMP_IF_FALSE_PEEK or op == OP_JUMP_IF_TRUE_PEEK
        or op == OP_JUMP_IF_NIL_PEEK or op == OP_JUMP_IF_NOT_NIL_PEEK;
}

// Compact `chunk.instructions` by dropping every instruction marked with op == -1,
// then rewrite all jump operands so they still point at the right instruction.
// Removing instructions shifts indices, so without this fix any surviving jump
// (especially short-circuit `and`/`or` peek-jumps) would point at the wrong slot
// — or off the end of the chunk, silently skipping code. Deleted slots map to the
// next surviving instruction; index == len maps to the new length (so "jump to
// end" stays "jump to end").
fn _compact_and_remap(chunk) {
    let old = chunk.instructions;
    let n = len(old);
    let new_index = [];
    let count = 0;
    let i = 0;
    while i < n {
        array_push(new_index, count);
        if old[i].op != (-1) { count = count + 1; }
        i = i + 1;
    }
    array_push(new_index, count); // map for index == n (one-past-the-end)

    let cleaned = [];
    let j = 0;
    while j < n {
        if old[j].op != (-1) { array_push(cleaned, old[j]); }
        j = j + 1;
    }

    let k = 0;
    while k < len(cleaned) {
        if _is_jump_op(cleaned[k].op) {
            let tgt = cleaned[k].operand;
            if tgt >= 0 and tgt <= n { cleaned[k].operand = new_index[tgt]; }
        }
        k = k + 1;
    }
    chunk.instructions = cleaned;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pass 1: Constant folding
// Pattern: OP_CONSTANT(a) OP_CONSTANT(b) OP_BINARY  →  OP_CONSTANT(eval(a op b))
// ═══════════════════════════════════════════════════════════════════════════════

fn try_eval_binary(a_val, b_val, op) {
    if not is_number(a_val) or not is_number(b_val) { return nil; }
    if op == OP_ADD { return a_val + b_val; }
    if op == OP_SUB { return a_val - b_val; }
    if op == OP_MUL { return a_val * b_val; }
    if op == OP_DIV {
        if b_val == 0 { return nil; }
        return a_val / b_val;
    }
    // Modulo: same engine as the VM's OP_MOD, so folding `a % b` is exact. Like
    // division, leave `% 0` for the runtime rather than baking in a value.
    if op == OP_MOD {
        if b_val == 0 { return nil; }
        return a_val % b_val;
    }
    // Comparisons must fold to BOOLEANS (not 1/0) — the VM's comparison opcodes
    // push bools, so folding `5 == 5` to a number would change observable type.
    if op == OP_EQ { return a_val == b_val; }
    if op == OP_NOT_EQ { return a_val != b_val; }
    if op == OP_LT { return a_val < b_val; }
    if op == OP_LE { return a_val <= b_val; }
    if op == OP_GT { return a_val > b_val; }
    if op == OP_GE { return a_val >= b_val; }
    return nil;
}

fn is_binary_op(op) {
    return op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or op == OP_MOD
        or op == OP_EQ or op == OP_NOT_EQ or op == OP_LT or op == OP_LE
        or op == OP_GT or op == OP_GE;
}

// Collect the set of absolute instruction indices that some jump targets, keyed
// by str(index). Folding a CONST/CONST/BINOP triple is only sound INSIDE one
// basic block; if a jump lands on the middle or the operator of the triple, the
// three instructions are NOT executed as a unit, and folding them collapses two
// basic blocks. This is the exact bug that made `(try X catch <n>) <op> <n>`
// mis-evaluate (the try/catch success jump targets the RHS constant). Mirrors
// the Rust constant-folder guard in crates/pblang-compiler/src/lib.rs.
fn _jump_target_set(chunk) {
    let targets = map{};
    let i = 0;
    let n = len(chunk.instructions);
    while i < n {
        let inst = chunk.instructions[i];
        if _is_jump_op(inst.op) {
            targets[str(inst.operand)] = true;
        }
        i = i + 1;
    }
    return targets;
}

fn constant_folding_pass(chunk) {
    let folded = 0;
    let targets = _jump_target_set(chunk);
    let i = 0;
    while i + 2 < chunk_len(chunk) {
        // Never fold across a basic-block boundary: if a jump targets the second
        // constant or the operator, the triple isn't a straight-line unit.
        if map_has(targets, str(i + 1)) or map_has(targets, str(i + 2)) {
            i = i + 1;
            continue;
        }
        let a_inst = inst_at(chunk, i);
        let b_inst = inst_at(chunk, i + 1);
        let op_inst = inst_at(chunk, i + 2);

        if a_inst != nil and b_inst != nil and op_inst != nil
           and a_inst.op == OP_CONSTANT and b_inst.op == OP_CONSTANT
           and is_binary_op(op_inst.op) {

            let a_val = constant_at(chunk, a_inst.operand);
            let b_val = constant_at(chunk, b_inst.operand);
            let result = try_eval_binary(a_val, b_val, op_inst.op);

            if result != nil {
                let result_idx = add_constant(chunk, result);
                // Mark all three for deletion, replace third with constant
                set_inst(chunk, i, make_inst(-1, 0));
                set_inst(chunk, i + 1, make_inst(-1, 0));
                set_inst(chunk, i + 2, make_inst(OP_CONSTANT, result_idx));
                folded = folded + 1;
                i = i + 2; // skip past the new constant
            }
        }
        i = i + 1;
    }

    // Clean up instructions marked with op == -1, remapping jump targets so the
    // folded-away CONSTANT/CONSTANT pairs don't desync `and`/`or` short-circuit
    // jumps (this was the cause of `(a and b) or c` returning the wrong value /
    // skipping the following statement entirely).
    _compact_and_remap(chunk);
    return folded;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pass 2: Dead code elimination
// Remove unreachable instructions after OP_RETURN (conservative)
// ═══════════════════════════════════════════════════════════════════════════════

fn dead_code_pass(chunk) {
    let removed = 0;
    // Instructions that some jump targets are REACHABLE even after a return — do
    // not mark them (or anything past them) dead. Without this guard an early
    // `return` inside an if/else wrongly strips the else branch (its JUMP_IF_FALSE
    // target), leaving a dangling out-of-bounds jump. Targets use pre-compaction
    // indices, matching the `j` scan below.
    let targets = _jump_target_set(chunk);
    let i = 0;
    let n = chunk_len(chunk);
    while i < n {
        let inst = inst_at(chunk, i);
        if inst != nil and inst.op == OP_RETURN {
            // Scan forward: mark instructions dead until we see a potential
            // entry point (OP_CLOSURE, OP_DEFINE_GLOBAL) or a jump target.
            let j = i + 1;
            while j < n {
                let nxt = inst_at(chunk, j);
                if nxt == nil { break; }
                if nxt.op == OP_CLOSURE or nxt.op == OP_DEFINE_GLOBAL { break; }
                if map_has(targets, str(j)) { break; }
                // Mark dead (op == -1); compaction + jump remap happens below so
                // surviving jumps don't shift onto the wrong target.
                set_inst(chunk, j, make_inst(-1, 0));
                removed = removed + 1;
                j = j + 1;
            }
        }
        i = i + 1;
    }
    if removed > 0 { _compact_and_remap(chunk); }
    return removed;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pass 3: Jump optimization — jump-to-jump simplification
// OP_JUMP(A) → target at A is OP_JUMP(B) → OP_JUMP(B)
// ═══════════════════════════════════════════════════════════════════════════════

fn jump_optimization_pass(chunk) {
    let optimized = 0;
    let changed = true;

    // Iterate to resolve chains
    let max_iters = 10;
    let iter = 0;
    while changed and iter < max_iters {
        changed = false;
        let i = 0;
        while i < chunk_len(chunk) {
            let inst = inst_at(chunk, i);
            // Thread ANY jump (conditional/peek too, not just OP_JUMP) whose target
            // is an intermediate UNCONDITIONAL OP_JUMP: retarget straight to that
            // jump's destination. Sound because OP_JUMP has no stack effect, so the
            // destination's stack state is identical either way; the jump's own
            // type/pop behaviour is preserved (only its operand changes).
            if inst != nil and _is_jump_op(inst.op) {
                let target_idx = inst.operand;
                let target_inst = inst_at(chunk, target_idx);
                if target_inst != nil and target_inst.op == OP_JUMP
                   and target_inst.operand != target_idx {
                    set_inst(chunk, i, make_inst(inst.op, target_inst.operand));
                    optimized = optimized + 1;
                    changed = true;
                }
            }
            i = i + 1;
        }
        iter = iter + 1;
    }

    return optimized;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pass 4: Strength reduction
// OP_CONSTANT(1) OP_MUL  →  no-op (already handled by constant folding)
// OP_CONSTANT(0) OP_ADD  →  no-op
// OP_CONSTANT(2) OP_MUL  →  (keep as mul for now, no DUP instruction)
// ═══════════════════════════════════════════════════════════════════════════════

fn strength_reduction_pass(chunk) {
    let reduced = 0;
    let i = 0;
    while i + 1 < chunk_len(chunk) {
        let prev_inst = inst_at(chunk, i);
        let op_inst = inst_at(chunk, i + 1);

        if prev_inst != nil and op_inst != nil {
            // x * 0 → 0 (pop x, push 0)
            if prev_inst.op == OP_CONSTANT and op_inst.op == OP_MUL {
                let val = constant_at(chunk, prev_inst.operand);
                if val == 0 {
                    // Remove constant, replace mul with pop+constant(0)
                    set_inst(chunk, i, make_inst(OP_POP, 0));
                    set_inst(chunk, i + 1, make_inst(OP_CONSTANT, prev_inst.operand));
                    reduced = reduced + 1;
                }
            }

            // x + 0 → x (pop constant, no-op)
            if prev_inst.op == OP_CONSTANT and op_inst.op == OP_ADD {
                let val = constant_at(chunk, prev_inst.operand);
                if val == 0 {
                    set_inst(chunk, i, make_inst(-1, 0));
                    set_inst(chunk, i + 1, make_inst(-1, 0));
                    reduced = reduced + 1;
                }
            }

            // x - 0 → x (pop constant, no-op)
            if prev_inst.op == OP_CONSTANT and op_inst.op == OP_SUB {
                let val = constant_at(chunk, prev_inst.operand);
                if val == 0 {
                    set_inst(chunk, i, make_inst(-1, 0));
                    set_inst(chunk, i + 1, make_inst(-1, 0));
                    reduced = reduced + 1;
                }
            }
        }
        i = i + 1;
    }

    // Clean up -1 markers
    let cleaned = [];
    let j = 0;
    while j < len(chunk.instructions) {
        let inst = chunk.instructions[j];
        if inst.op != (-1) {
            array_push(cleaned, inst);
        }
        j = j + 1;
    }
    chunk.instructions = cleaned;

    return reduced;
}

// Remove unconditional OP_JUMP instructions that target the immediately following
// instruction — a pure no-op (fall-through). Only OP_JUMP qualifies: conditional
// jumps pop a value, so a JIF-to-next is NOT a no-op. Compaction remaps any jump
// that targeted the removed slot to the next live instruction. Shrinks bytecode
// emitted by if/else and short-circuit lowering (fewer dispatches at run time).
fn jump_to_next_pass(chunk) {
    let removed = 0;
    let n = chunk_len(chunk);
    let i = 0;
    while i < n {
        let inst = inst_at(chunk, i);
        if inst != nil and inst.op == OP_JUMP and inst.operand == i + 1 {
            set_inst(chunk, i, make_inst(-1, 0));
            removed = removed + 1;
        }
        i = i + 1;
    }
    if removed > 0 { _compact_and_remap(chunk); }
    return removed;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Main optimize entry point: run all passes
// ═══════════════════════════════════════════════════════════════════════════════

// Run the semantics-preserving passes to a FIXPOINT: each pass can expose work
// for the others (dead code → jump-to-next, jump threading → dead code, folding →
// dead code), so iterating until a round changes nothing applies all cascading
// optimizations. `max_iters` caps it (each pass only removes/simplifies, so it
// converges quickly). Returns the per-pass totals across all rounds.
fn _optimize_fixpoint(working, stats, max_iters) {
    let iters = 0;
    while iters < max_iters {
        let cf = constant_folding_pass(working);
        let dc = dead_code_pass(working);
        let jo = jump_optimization_pass(working);
        let jn = jump_to_next_pass(working);
        stats.constant_folded = stats.constant_folded + cf;
        stats.dead_code_removed = stats.dead_code_removed + dc;
        stats.jumps_optimized = stats.jumps_optimized + jo + jn;
        if cf + dc + jo + jn == 0 { return; }
        iters = iters + 1;
    }
}

fn optimize(chunk) {
    let working = copy_chunk(chunk);
    let stats = map{
        constant_folded: 0,
        dead_code_removed: 0,
        jumps_optimized: 0,
        strength_reduced: 0,
    };
    _optimize_fixpoint(working, stats, 6);
    // Strength reduction is unsound under operator overloading, so it runs last
    // and only in the non-safe variant.
    stats.strength_reduced = strength_reduction_pass(working);
    return map{
        chunk: working,
        stats: stats,
    };
}

// optimize_safe(chunk) — like optimize() but WITHOUT strength reduction. Strength
// reduction (`x*0 → 0`, `x+0 → x`) is unsound under operator overloading (`vec*0`
// must dispatch `__mul__`, not collapse to 0), so this variant is safe to apply
// to ARBITRARY code. The remaining passes — constant folding of literal pairs,
// dead-code elimination, jump simplification — only rewrite provably-equivalent
// sequences. Used by frontend_run to speed up self-hosted code without risk.
fn optimize_safe(chunk) {
    let working = copy_chunk(chunk);
    let stats = map{ constant_folded: 0, dead_code_removed: 0, jumps_optimized: 0, strength_reduced: 0 };
    _optimize_fixpoint(working, stats, 6);
    return map{ chunk: working, stats: stats };
}

fn stats_to_string(stats) {
    return "folded:" + str(stats.constant_folded)
        + " dead:" + str(stats.dead_code_removed)
        + " jumps:" + str(stats.jumps_optimized)
        + " strength:" + str(stats.strength_reduced);
}

export optimize, optimize_safe, constant_folding_pass, dead_code_pass, jump_optimization_pass;
export opcode_name;
export jump_to_next_pass, strength_reduction_pass, stats_to_string, copy_chunk;
