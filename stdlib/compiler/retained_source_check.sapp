// Conservative opt-in gate for the retained source compiler's implicit capture
// defect. It neither executes source nor qualifies all other compiler behavior.
let SOURCE=import("stdlib:compiler/checked_source.sapp");
fn _reject(code,message) {return map{ok:false,code:code,message:message};}
fn check(source) {
    let ast=try SOURCE.parse_source(source) catch nil;
    if ast==nil or len(ast.stmts)==0 {return _reject("retained-invalid-source","source admission failed");}
    let pending=[[ast,false,0]];let admitted=1;
    while len(pending)>0 {
        let item=array_pop(pending);let node=item[0];let scoped=item[1];let depth=item[2];
        if depth>128 {return _reject("retained-scan-limit","source analysis depth exceeded");}
        let children=[];
        if type(node)=="map" {
            let kind=try node.kind catch "";
            if kind=="try" and scoped {
                return _reject("retained-nested-try","nested try is unsupported by the retained source profile; compile with the PBLang PBCK route");
            }
            if kind=="import" or (kind=="ident" and node.name=="import") {
                return _reject("retained-unchecked-import","imports require separate dependency qualification; use an explicit static PBCK bundle");
            }
            if kind=="block" or kind=="fn" or kind=="fn_lit" {scoped=true;}
            for key in map_keys(node) {push(children,node[key]);}
        } elif type(node)=="array" {children=node;}
        for child in children {
            if type(child)=="map" or type(child)=="array" {
                if admitted>=262144 {return _reject("retained-scan-limit","source analysis node limit exceeded");}
                admitted=admitted+1;push(pending,[child,scoped,depth+1]);
            }
        }
    }
    return map{ok:true,code:nil,message:nil};
}
export check;
