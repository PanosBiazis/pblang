// stdlib/compiler/selfhost_frontend.sapp
//
// Pblang-owned frontend driver with deterministic source analysis and
// structured diagnostics from the real self-hosted tokenizer/parser.

let _DIAGNOSTIC_SUGGEST = import("stdlib:compiler/diagnostic_suggestions.sapp");
// Resolve compiler components at the module root. Lazy path imports inside a
// function are CWD-relative in older hosts, which made dependency consumers
// fail when they invoked the frontend outside the pblang checkout.
let _TOKENIZER = import("stdlib:compiler/tokenizer.sapp");
let _PARSER = import("stdlib:compiler/parser.sapp");
let _TYPECHECK = import("stdlib:compiler/typeck.sapp");
let _CODEGEN = import("stdlib:compiler/codegen.sapp");
let _OPTIMIZER = import("stdlib:compiler/optimizer.sapp");
let _MODULE_CACHE = import("stdlib:compiler/module_cache.sapp");
let _GUARD_PREPROCESSOR = import("stdlib:compiler/guard_preprocessor.sapp");
let _VM = import("stdlib:compiler/vm.sapp");
let _SEMANTIC = import("stdlib:compiler/semantic.sapp");
let _BUILTINS_LIST = import("stdlib:compiler/builtins_list.sapp");

// Keep recovery ASTs available to editors, but attach lexical failures to the
// same error list every compiler route uses to decide whether codegen is allowed.
fn _lexical_errors(tokens) {
    let errors = [];
    for token in tokens {
        if token.kind == "invalid" {
            array_push(errors, "invalid number literal at line " + str(token.line) + ":" + str(token.col));
        }
        if (try token.unterminated catch nil) == true {
            array_push(errors, "unterminated " + token.kind + " starting at line " + str(token.line));
        }
    }
    return errors;
}

fn _parse_tokens_checked(tokens) {
    let lexical = _lexical_errors(tokens);
    // Do not build a recovered numeric AST or duplicate parser diagnostics.
    // Existing unterminated-string/comment recovery remains available to tools.
    if len(lexical) > 0 {
        for token in tokens {
            if token.kind == "invalid" { return map{ stmts: [], errors: lexical }; }
        }
    }
    let ast = _PARSER.parse(tokens);
    for message in lexical { array_push(ast.errors, message); }
    return ast;
}

// A text rewrite must never erase malformed raw input. Leave it untouched so
// checked parsing reports the original lexical diagnostic instead.
fn _preprocess_checked(source) {
    if len(_lexical_errors(_TOKENIZER.tokenize(source))) > 0 { return source; }
    return _GUARD_PREPROCESSOR.preprocess(source);
}

fn _preprocess_stats_checked(source) {
    let out = _preprocess_checked(source);
    return map{ source: out, changed: out != source, size_before: len(source), size_after: len(out) };
}

fn frontend_analyze(source) {
    if source == nil {
        return map{
            ok: false,
            error: "frontend_analyze: source is nil",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
    }

    if str_trim(source) == "" {
        return map{
            ok: false,
            error: "frontend_analyze: source is empty",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
            tokens: [],
        };
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = _parse_tokens_checked(tokens);
    let errors = ast.errors;
    // Analysis is used by the public self-hosted check. A parsed AST alone
    // cannot certify calls, names or operand types. Editors needing parse-only
    // recovery retain frontend_parse_full/frontend_parse_safe.
    let diagnostics = [];
    if len(errors) == 0 {
        diagnostics = _TYPECHECK.type_check(ast.stmts);
        for diagnostic in diagnostics { array_push(errors, diagnostic.message); }
    }
    let stmt_count = len(ast.stmts);
    let ok = len(tokens) > 0 and stmt_count > 0 and len(errors) == 0;

    return map{
        ok: ok,
        tokens_count: len(tokens),
        stmt_count: stmt_count,
        diagnostics: diagnostics,
        errors: errors,
        tokens: tokens,
    };
}

fn frontend_parse_file(path) {
    if path == nil or path == "" {
        return map{
            ok: false,
            error: "frontend_parse_file: path is empty",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
    }
    let src = fs_read(path);
    if src == nil or src == "" {
        return map{
            ok: false,
            error: "frontend_parse_file: cannot read file",
            tokens_count: 0,
            stmt_count: 0,
            errors: [],
        };
    }
    return frontend_analyze(src);
}

fn frontend_smoke() {
    let sample = "let x = 1; print x;";
    let res = frontend_analyze(sample);
    return res.ok == true and res.stmt_count >= 1 and res.tokens_count >= 2;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Full compiler pipeline functions
// ═══════════════════════════════════════════════════════════════════════════════

/// Parse source using the full parser (instead of lightweight tokenizer).
/// Returns the AST from the parser module (map with stmts and errors).
fn frontend_parse_full(source) {
    if source == nil or source == "" {
        return map{
            ok: false,
            error: "frontend_parse_full: source is empty",
            ast: nil,
        };
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = _parse_tokens_checked(tokens);

    let errors = ast.errors;

    return map{
        // `ok` requires a non-empty AST AND zero diagnostics — previously it
        // ignored parser errors, so broken input (e.g. an unclosed block) still
        // reported ok=true.
        ok: len(ast.stmts) > 0 and len(errors) == 0,
        ast: ast,
        tokens_count: len(tokens),
        errors: errors,
    };
}

/// Safe parser wrapper for tools/AI callers.
/// It never throws parser/tokenizer exceptions to the caller; failures are
/// returned as structured diagnostics so generated code can be rejected or
/// repaired deterministically.
fn frontend_parse_safe(source) {
    if source == nil or source == "" {
        return map{
            format: "pblang.frontend.parse_safe.v1",
            ok: false,
            reason: "empty_source",
            ast: nil,
            tokens_count: 0,
            errors: ["frontend_parse_safe: source is empty"],
        };
    }
    let parsed = try frontend_parse_full(source) catch nil;
    if parsed == nil {
        return map{
            format: "pblang.frontend.parse_safe.v1",
            ok: false,
            reason: "parser_exception",
            ast: nil,
            tokens_count: 0,
            errors: ["frontend parser threw while parsing source"],
        };
    }
    let errors = try parsed.errors catch [];
    let ok = (try parsed.ok catch false) and len(errors) == 0;
    return map{
        format: "pblang.frontend.parse_safe.v1",
        ok: ok,
        reason: if ok { "parsed" } else { "parser_reported_errors" },
        ast: try parsed.ast catch nil,
        tokens_count: try parsed.tokens_count catch 0,
        errors: errors,
    };
}

/// Run type checking on an AST.
/// Returns diagnostics array from the type checker.
fn frontend_typecheck(ast) {
    if ast == nil {
        return map{
            ok: false,
            error: "frontend_typecheck: ast is nil",
            diagnostics: [],
        };
    }

    let stmts = ast.stmts;
    if stmts == nil { stmts = []; }

    let diagnostics = _TYPECHECK.type_check(stmts);

    return map{
        ok: len(diagnostics) == 0,
        diagnostics: diagnostics,
    };
}

/// Full end-to-end compilation: source → tokens → AST → bytecode chunk.
/// Returns the codegen chunk, AST, and diagnostics.
fn frontend_compile(source) {
    if source == nil or source == "" {
        return map{
            ok: false,
            error: "frontend_compile: source is empty",
            ast: nil,
            chunk: nil,
            diagnostics: [],
        };
    }

    let tokens = _TOKENIZER.tokenize(source);
    let ast = _parse_tokens_checked(tokens);
    let diagnostics = [];
    if ast.errors != nil {
        let ei = 0;
        while ei < len(ast.errors) {
            array_push(diagnostics, map{ stage: "parse", code: "parse-error", message: ast.errors[ei] });
            ei = ei + 1;
        }
    }
    if len(diagnostics) == 0 and ast.stmts != nil { diagnostics = _TYPECHECK.type_check(ast.stmts); }

    // Preserve bytecode for well-parsed programs even when static diagnostics
    // exist. Low-level VM/debugging tools may inspect it explicitly, while `ok`
    // remains false and frontend_run refuses to execute it implicitly.
    let chunk = if ast.errors == nil or len(ast.errors) == 0 { _CODEGEN.compile_stmts(ast.stmts) } else { _CODEGEN.Chunk() };

    return map{
        ok: len(ast.stmts) > 0 and len(chunk.instructions) > 0 and len(diagnostics) == 0,
        ast: ast,
        chunk: chunk,
        tokens: tokens,
        diagnostics: diagnostics,
    };
}

/// Compile a batch of independent source strings, returning one frontend_compile()
/// result per input, in input order. Per-source compilation shares no mutable state
/// (each produces its own chunk), so the batch fans out across CPU cores via
/// spawn/join — the textbook per-translation-unit parallelism. Each spawned closure
/// captures the shared read-only `sources` array plus its own index; frontend_compile
/// is a module-level function (resolved as a global, not a transferred upvalue), so
/// the spawn is accepted. If the runtime rejects the spawned closures, this falls back
/// to sequential compilation, so correctness never depends on threading.
fn frontend_compile_many(sources) {
    let n = len(sources);
    let results = [];
    if n == 0 { return results; }
    if n == 1 {
        array_push(results, frontend_compile(sources[0]));
        return results;
    }

    // Spawn one compile per source. Spawn rejection is deterministic on the closure
    // shape, so it is all-or-nothing: either every spawn succeeds or the first fails.
    let handles = [];
    let parallel = true;
    let i = 0;
    while i < n {
        let idx = i;
        let h = try spawn(fn() { return frontend_compile(sources[idx]); }) catch nil;
        if h == nil { parallel = false; break; }
        array_push(handles, h);
        i = i + 1;
    }

    if parallel and len(handles) == n {
        let j = 0;
        while j < len(handles) {
            let v = try join(handles[j]) catch nil;
            if v == nil { parallel = false; break; }
            array_push(results, v);
            j = j + 1;
        }
        if parallel { return results; }
        results = [];   // a join failed: recompute sequentially for a complete result
    }

    // Sequential fallback (threading unavailable or a join failed).
    let k = 0;
    while k < n {
        array_push(results, frontend_compile(sources[k]));
        k = k + 1;
    }
    return results;
}

/// Run the optimizer on a chunk, returning optimized chunk and stats.
fn frontend_optimize(chunk) {
    return _OPTIMIZER.optimize(chunk);
}

/// Compile AND execute `source` end-to-end through the fully self-hosted
/// pipeline (pblang tokenizer → parser → typecheck → codegen → pblang bytecode
/// VM in stdlib/compiler/vm.sapp). Returns { ok, output, chunk } where `output`
/// is the array of values the program printed. This closes the self-hosting
/// loop for the supported language subset.
// ── Module resolution for the self-hosted runtime ───────────────────────────────
// frontend_run pre-resolves the `import("...")` references in a program into a
// module cache (path -> exports map) that the self-hosted VM reads at runtime
// (vm.sapp's `import` builtin looks up globals["__import_cache__"]). Each module
// is itself compiled + run through the self-hosted pipeline, so the WHOLE program
// — main source plus imported stdlib modules — executes on the pblang VM. This is
// the multi-file step toward a self-hosted toolchain that can build real projects.

// "stdlib:foo.sapp" -> "stdlib/foo.sapp"; other path forms used as-is.
fn _resolve_import_path(s) {
    if str_starts_with(s, "stdlib:") { return "stdlib/" + str_slice(s, 7, len(s)); }
    return s;
}

// Scan `source` for one `import` marker form, appending PATH strings to `paths`.
fn _find_imports_marker(source, marker, paths) {
    let rest = source;
    let guard = 0;
    while guard < 4000 {
        let idx = str_index_of(rest, marker);
        if idx < 0 { break; }
        let after = str_slice(rest, idx + len(marker), len(rest));
        let endq = str_index_of(after, "\"");
        if endq < 0 { break; }
        array_push(paths, str_slice(after, 0, endq));
        rest = str_slice(after, endq + 1, len(after));
        guard = guard + 1;
    }
    return paths;
}

// Scan `source` for `import("PATH")` calls AND `import "PATH";` statements
// (both are legal — the statement form desugars to a call binding the module
// under its basename), returning the PATH strings.
fn _find_imports(source) {
    let paths = [];
    _find_imports_marker(source, "import(\"", paths);
    _find_imports_marker(source, "import \"", paths);
    return paths;
}

// Recursively compile+run the module at `path`, memoizing its exports (all of its
// top-level globals) into `cache`. Dependencies are resolved first; failures
// leave an empty exports map (graceful). `cache[path]` is pre-set empty as a
// cycle guard.
fn _frontend_limit(options, key, fallback, hard_max) {
    let value = fallback;
    if options != nil and is_map(options) and map_has(options, key) { value = options[key]; }
    if not is_number(value) or value < 1 or value != num_floor(value) or value > hard_max {
        throw "frontend_run_bounded: " + key + " must be a positive integer <= " + str(hard_max);
    }
    return value;
}

fn _module_cache_state(options) {
    if options == nil or not is_map(options) { return nil; }
    let enabled = map_has(options, "module_cache") and options.module_cache == true;
    let root = nil;
    if map_has(options, "module_cache_root") {
        root = options.module_cache_root;
        if type(root) != "string" or root == "" or len(root) > 4096 {
            throw "frontend_run_bounded: module_cache_root must be non-empty text <= 4096 bytes";
        }
        enabled = true;
    }
    if not enabled { return nil; }
    return map{ context: _MODULE_CACHE.context(root) };
}

fn _resolve_module(path, cache, runtime_options = nil, bytecode_cache = nil, execution = nil) {
    if map_has(cache, path) { return cache[path]; }
    let max_modules = _frontend_limit(runtime_options, "max_modules", 256, 4096);
    if len(map_keys(cache)) >= max_modules { throw "frontend_run_bounded: module limit exceeded"; }
    cache[path] = map{};
    let file = _resolve_import_path(path);
    // `_find_imports` is a naive text scan that also matches `import("...")`
    // occurrences inside comments/strings (e.g. illustrative `import("__FILE__")`
    // or `import("...")` in doc comments). Guard the read so a non-existent
    // module resolves to empty exports instead of throwing — this is the
    // documented "failures leave an empty exports map (graceful)" behavior.
    if not fs_exists(file) { return cache[path]; }
    let src = fs_read(file);
    if src == nil or src == "" { return cache[path]; }
    let source_limit = _frontend_limit(runtime_options, "max_source_bytes", 1048576, 16777216);
    if len(str_to_bytes(src)) > source_limit {
        throw "frontend_run_bounded: imported module source limit exceeded";
    }
    if len(_lexical_errors(_TOKENIZER.tokenize(src))) > 0 { return cache[path]; }
    let deps = _find_imports(src);
    let di = 0;
    while di < len(deps) {
        if not map_has(cache, deps[di]) { _resolve_module(deps[di], cache, runtime_options, bytecode_cache, execution); }
        di = di + 1;
    }
    let processed = _preprocess_checked(src);
    // Revalidate before a cache hit too: older caches may contain recovered ASTs.
    let checked = _parse_tokens_checked(_TOKENIZER.tokenize(processed));
    if len(checked.errors) > 0 { return cache[path]; }
    let chunk = nil;
    let key = nil;
    if bytecode_cache != nil {
        key = _MODULE_CACHE.cache_key(bytecode_cache.context, file, processed);
        let cached = _MODULE_CACHE.load(bytecode_cache.context, key);
        if cached.hit { chunk = cached.chunk; }
    }
    if chunk == nil {
        let cr = frontend_compile(processed);
        if not cr.ok { return cache[path]; }
        chunk = cr.chunk;
        if bytecode_cache != nil {
            // Cache publication is an optimization. A read-only cache directory or
            // interrupted writer must never change otherwise-correct execution.
            try _MODULE_CACHE.store(bytecode_cache.context, key, chunk) catch nil;
        }
    }
    let res = if runtime_options == nil {
        _VM.run_seeded(chunk, map{ __import_cache__: cache }, execution)
    } else {
        _VM.run_seeded_bounded(chunk, map{ __import_cache__: cache }, runtime_options, execution)
    };
    let exports = map{};
    // Real `export` semantics: if the module declared `__exports__` (a list of
    // exported names), expose ONLY those. Otherwise (no export statement) fall
    // back to exposing all top-level globals.
    if map_has(res.globals, "__exports__") {
        let names = res.globals["__exports__"];
        let ni = 0;
        while ni < len(names) {
            let nm = names[ni];
            if map_has(res.globals, nm) { exports[nm] = res.globals[nm]; }
            ni = ni + 1;
        }
    } else {
        let gkeys = map_keys(res.globals);
        let gi = 0;
        while gi < len(gkeys) {
            if gkeys[gi] != "__import_cache__" { exports[gkeys[gi]] = res.globals[gkeys[gi]]; }
            gi = gi + 1;
        }
    }
    cache[path] = exports;
    return exports;
}

// Build the import cache for `source` (resolves every imported module).
fn _build_import_cache_state(source, runtime_options = nil, execution = nil) {
    let cache = map{};
    let bytecode_cache = _module_cache_state(runtime_options);
    let paths = _find_imports(source);
    let i = 0;
    while i < len(paths) {
        _resolve_module(paths[i], cache, runtime_options, bytecode_cache, execution);
        i = i + 1;
    }
    return map{ modules: cache, bytecode_cache: bytecode_cache };
}

fn _build_import_cache(source, runtime_options = nil, execution = nil) {
    return _build_import_cache_state(source, runtime_options, execution).modules;
}

// Read a .sapp file from disk and run it end-to-end through the self-hosted
// pipeline (guard preprocess → tokenize → parse → typecheck → codegen → optimize
// → run), resolving its `import("...")`s along the way. This is the self-hosted
// analog of the Rust CLI's `run` — a real `.sapp` file executed entirely on the
// pblang toolchain.
// ── Static linter (frontend_lint) ────────────────────────────────────────────────
// A self-hosted static analyzer: catches issues the dynamic runtime would miss
// until (or never) hit. Sound checks that need no builtin allowlist —
// unreachable code after return/break/continue — plus the semantic analyzer's
// warnings (e.g. assignment to an undeclared variable). A step toward static
// safety + tooling, and the basis for IDE diagnostics. All pblang.

fn _lint_block_node(blk, diags) {
    if blk == nil { return; }
    let stmts = try blk.stmts catch nil;
    if stmts != nil { _lint_stmt_list(stmts, diags); }
}

fn _lint_stmt_list(stmts, diags) {
    let terminated = false;
    let reported = false;
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        if terminated and not reported {
            array_push(diags, map{ kind: "warning", message: "unreachable code after return/break/continue" });
            reported = true; // further terminators cannot make this block reachable
        }
        let k = s.kind;
        if k == "return" or k == "break" or k == "continue" { terminated = true; }
        _lint_stmt(s, diags);
        i = i + 1;
    }
}

fn _lint_stmt(s, diags) {
    let k = s.kind;
    if k == "fn" { _lint_block_node(try s.body catch nil, diags); return; }
    if k == "while" { _lint_block_node(try s.body catch nil, diags); return; }
    if k == "for" { _lint_block_node(try s.body catch nil, diags); return; }
    if k == "for_in" { _lint_block_node(try s.body catch nil, diags); return; }
    if k == "for_range" { _lint_block_node(try s.body catch nil, diags); return; }
    if k == "block" { _lint_stmt_list(try s.stmts catch [], diags); return; }
    if k == "if" {
        _lint_block_node(try s.then catch nil, diags);
        let elifs = try s.elifs catch nil;
        if elifs != nil {
            let ei = 0;
            while ei < len(elifs) {
                // Canonical parser branches are {cond, body}; retain the older
                // field fallbacks without silently skipping current elif bodies.
                let blk = try elifs[ei].body catch nil;
                if blk == nil { blk = try elifs[ei].block catch nil; }
                if blk == nil { blk = try elifs[ei].then catch nil; }
                _lint_block_node(blk, diags);
                ei = ei + 1;
            }
        }
        let els = try s.else catch nil;
        if els != nil { _lint_block_node(els, diags); }
        return;
    }
}

// Collect the names declared at the top level (hoisted): fn/let/const — which
// also covers struct/interface (→ fn nodes) and class/enum (→ let nodes) after
// parsing. Used to filter forward-referenced globals out of "undefined".
fn _collect_global_decls(stmts) {
    let decls = map{};
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let k = s.kind;
        if k == "fn" or k == "let" or k == "const" {
            let nm = try s.name catch nil;
            if nm != nil { decls[nm] = true; }
        }
        i = i + 1;
    }
    return decls;
}

fn _collect_lint_scope_names(scope, candidates, seen) {
    if scope == nil or len(candidates) >= _DIAGNOSTIC_SUGGEST.MAX_CANDIDATES { return; }
    let symbols = try scope.symbols catch map{};
    let names = map_keys(symbols); let i = 0;
    while i < len(names) and len(candidates) < _DIAGNOSTIC_SUGGEST.MAX_CANDIDATES {
        if not map_has(seen, names[i]) {
            seen[names[i]] = true; array_push(candidates, names[i]);
        }
        i = i + 1;
    }
    let children = try scope.children catch []; i = 0;
    while i < len(children) and len(candidates) < _DIAGNOSTIC_SUGGEST.MAX_CANDIDATES {
        _collect_lint_scope_names(children[i], candidates, seen); i = i + 1;
    }
}

fn _lint_name_candidates(builtins, decls, table) {
    let candidates = []; let seen = map{};
    let sources = [map_keys(builtins), map_keys(decls)]; let si = 0;
    while si < len(sources) {
        let names = sources[si]; let i = 0;
        while i < len(names) and len(candidates) < _DIAGNOSTIC_SUGGEST.MAX_CANDIDATES {
            if not map_has(seen, names[i]) {
                seen[names[i]] = true; array_push(candidates, names[i]);
            }
            i = i + 1;
        }
        si = si + 1;
    }
    if table != nil {
        _collect_lint_scope_names(try table.global_scope catch nil, candidates, seen);
    }
    return candidates;
}

// frontend_lint(source) — returns { ok, diagnostics:[{kind,message}], count }.
fn frontend_lint(source) {
    // Lexical rejection is independent of the optional editor recovery path.
    if is_string(source) {
        let lexical_diags = [];
        for message in _lexical_errors(_TOKENIZER.tokenize(_preprocess_checked(source))) {
            array_push(lexical_diags, map{ kind: "error", code: "parse-error", message: message });
        }
        if len(lexical_diags) > 0 {
            return map{ ok: false, diagnostics: lexical_diags, count: len(lexical_diags) };
        }
    }
    if not is_string(source) {
        return map{ ok: false, count: 1, diagnostics: [map{
            kind: "error", code: "invalid-source", message: "lint source must be text"
        }] };
    }
    let processed = try _preprocess_checked(source) catch nil;
    if processed == nil {
        return map{ ok: false, count: 1, diagnostics: [map{
            kind: "error", code: "parse-error", message: "source preprocessing failed"
        }] };
    }
    // An empty editor buffer is valid for lint, unlike an executable program.
    if str_trim(processed) == "" { return map{ ok: true, diagnostics: [], count: 0 }; }
    let parsed = frontend_parse_safe(processed);
    let ast = parsed.ast;
    let diags = [];
    // Do not run semantic analysis on a recovered/partial syntax tree. The safe
    // parser also surfaces unterminated tokens that the raw parser can accept.
    if ast == nil or len(parsed.errors) > 0 {
        for message in parsed.errors {
            array_push(diags, map{ kind: "error", code: "parse-error", message: message });
        }
        if len(diags) == 0 {
            array_push(diags, map{ kind: "error", code: "parse-error", message: "source could not be parsed" });
        }
        return map{ ok: false, diagnostics: diags, count: len(diags) };
    }
    // Complete comments (or empty statements) need no semantic symbol table.
    if len(ast.stmts) == 0 { return map{ ok: true, diagnostics: [], count: 0 }; }
    let stmts = try ast.stmts catch nil;
    if stmts != nil { _lint_stmt_list(stmts, diags); }

    // Undefined-name detection: a free variable (used but never bound in any
    // scope) that is neither a host builtin nor a hoisted top-level declaration
    // is genuinely undefined (typo / missing import). Sound — uses the generated
    // builtin set (kept in sync with the Rust table by tests/builtins_list_drift.rs),
    // so no false positives on real builtins.
    if stmts != nil {
        let builtins = _BUILTINS_LIST.builtin_set();
        let decls = _collect_global_decls(stmts);
        let tbl_u = try _SEMANTIC.analyze(ast) catch nil;
        if tbl_u != nil {
            let candidates = _lint_name_candidates(builtins, decls, tbl_u);
            let fvs = try tbl_u.free_variables catch nil;
            if fvs != nil {
                let fi = 0;
                while fi < len(fvs) {
                    let nm = fvs[fi];
                    let is_b = (try builtins[nm] catch nil) == true;
                    let is_d = (try decls[nm] catch nil) == true;
                    if not is_b and not is_d {
                        let suggestion = _DIAGNOSTIC_SUGGEST.suggest_name(nm, candidates);
                        let diagnostic = map{
                            kind: "error", code: "undefined-name",
                            message: "undefined name '" + nm + "'", name: nm,
                            suggestion: suggestion,
                            help: _DIAGNOSTIC_SUGGEST.help_for(suggestion),
                            fix: nil,
                        };
                        if suggestion != nil {
                            diagnostic.fix = map{ kind: "replace_identifier", from: nm, to: suggestion };
                        }
                        array_push(diags, diagnostic);
                    }
                    fi = fi + 1;
                }
            }
        }
    }
    // Fold in the semantic analyzer's warnings/errors (undeclared assignment, …).
    let tbl = try _SEMANTIC.analyze(ast) catch nil;
    if tbl != nil {
        let d = try tbl.diagnostics catch nil;
        if d != nil {
            let di = 0;
            while di < len(d) {
                let e = d[di];
                let kk = try e.kind catch "info";
                if kk == "error" or kk == "warning" {
                    array_push(diags, map{ kind: kk, message: try e.message catch "diagnostic" });
                }
                di = di + 1;
            }
        }
    }
    return map{ ok: len(diags) == 0, diagnostics: diags, count: len(diags) };
}

fn frontend_run_file(path) {
    if path == nil or path == "" {
        return map{ ok: false, error: "frontend_run_file: path is empty" };
    }
    let src = fs_read(path);
    if src == nil or src == "" {
        return map{ ok: false, error: "frontend_run_file: cannot read file: " + path };
    }
    return frontend_run(_preprocess_checked(src));
}

fn frontend_run(source) {
    let r = frontend_compile(source);
    if not r.ok {
        return map{ ok: false, error: "frontend_run: compilation failed", output: [], chunk: r.chunk };
    }
    // Apply the SAFE optimizer passes (constant folding of literal pairs,
    // dead-code elimination, jump simplification) — these only rewrite
    // provably-equivalent bytecode, so they're correct even with operator
    // overloading. (Strength reduction is excluded: it's unsound for overloaded
    // types; see optimize_safe.)
    let chunk = _OPTIMIZER.optimize_safe(r.chunk).chunk;
    // Pre-resolve imported modules so the program's `import(...)` calls find them.
    let execution = _VM.execution_context();
    let cache = _build_import_cache(source, nil, execution);
    let res = _VM.run_seeded(chunk, map{ __import_cache__: cache }, execution);
    _VM.close_execution(execution);
    return map{
        ok: true,
        output: res.output,
        locals: res.locals,
        globals: res.globals,
        chunk: chunk,
    };
}

fn frontend_run_bounded(source, options = nil) {
    if not is_string(source) { throw "frontend_run_bounded: source must be text"; }
    if options != nil and not is_map(options) { throw "frontend_run_bounded: options must be a map"; }
    let source_limit = _frontend_limit(options, "max_source_bytes", 1048576, 16777216);
    if len(str_to_bytes(source)) > source_limit { throw "frontend_run_bounded: source limit exceeded"; }
    let r = frontend_compile(source);
    if not r.ok {
        return map{ ok: false, error: "frontend_run_bounded: compilation failed", output: [], chunk: r.chunk, diagnostics: r.diagnostics };
    }
    let optimized = _OPTIMIZER.optimize_safe(r.chunk);
    let execution = _VM.execution_context();
    let cache_state = _build_import_cache_state(source, options, execution);
    let cache = cache_state.modules;
    let res = _VM.run_seeded_bounded(optimized.chunk, map{ __import_cache__: cache }, options, execution);
    _VM.close_execution(execution);
    return map{
        ok: true, output: res.output, locals: res.locals, globals: res.globals,
        value: res.value, runtime: res.runtime, chunk: optimized.chunk,
        optimization: optimized.stats,
        module_cache: if cache_state.bytecode_cache == nil {
            map{
                enabled: false, hits: 0, misses: 0, stores: 0, corruptions: 0,
                store_failures: 0, last_error: ""
            }
        } else {
            _MODULE_CACHE.snapshot(cache_state.bytecode_cache.context)
        }
    };
}

fn frontend_run_file_bounded(path, options = nil) {
    if path == nil or path == "" { return map{ ok: false, error: "frontend_run_file_bounded: path is empty" }; }
    let src = fs_read(path);
    if src == nil or src == "" { return map{ ok: false, error: "frontend_run_file_bounded: cannot read file: " + path }; }
    return frontend_run_bounded(_preprocess_checked(src), options);
}

// ═══════════════════════════════════════════════════════════════════════════════
// File-level and project-level compilation
// ═══════════════════════════════════════════════════════════════════════════════

/// Compile a single .sapp file from disk: read → preprocess → tokenize → parse → typecheck → codegen
fn frontend_compile_file(path, type_options = nil) {
    if path == nil or path == "" {
        return map{
            ok: false,
            error: "frontend_compile_file: path is empty",
        };
    }

    let src = fs_read(path);
    if src == nil or src == "" {
        return map{
            ok: false,
            error: "frontend_compile_file: cannot read file: " + path,
        };
    }

    // Run guard preprocessor on source before compilation
    let processed_src = _preprocess_checked(src);

    let tokens = _TOKENIZER.tokenize(processed_src);
    let ast = _parse_tokens_checked(tokens);

    let diagnostics = [];
    if ast.errors != nil {
        let ei = 0;
        while ei < len(ast.errors) {
            array_push(diagnostics, map{ stage: "parse", message: ast.errors[ei] });
            ei = ei + 1;
        }
    }

    if len(ast.errors) == 0 and ast.stmts != nil {
        // The checker returns structured diagnostics, including malformed-AST and
        // resource-limit failures. Do not turn an internal failure into success.
        let type_diags = _TYPECHECK.type_check(ast.stmts, type_options);
        let ti = 0;
        while ti < len(type_diags) {
            array_push(diagnostics, type_diags[ti]);
            ti = ti + 1;
        }
    }

    let chunk = if len(ast.errors) == 0 { _CODEGEN.compile_stmts(ast.stmts) } else { _CODEGEN.Chunk() };

    // Run semantic analysis (advisory: the self-hosted analyzer is partial, so a gap
    // in it must not abort compilation of an otherwise-valid file).
    let sym_table = if len(ast.errors) == 0 { try _SEMANTIC.analyze(ast) catch nil } else { nil };

    return map{
        ok: len(diagnostics) == 0,
        path: path,
        src_size: len(src),
        tokens_count: len(tokens),
        stmt_count: len(ast.stmts),
        diagnostics: diagnostics,
        chunk: chunk,
        symbol_table: sym_table,
        was_preprocessed: processed_src != src,
    };
}

// A frontend_compile_file() result holds a `symbol_table` that can be a *cyclic*
// graph (scopes carry parent back-pointers), which cannot cross the spawn/join wire
// boundary — serializing a cycle would otherwise be unbounded. For batch compilation
// we drop that table; every other field is preserved. Single-file callers of
// frontend_compile_file still receive the full result (no wire transfer is involved).
fn _file_result_wire_safe(r) {
    if not map_has(r, "chunk") { return r; }   // error-shaped result: already small/safe
    return map{
        ok: r.ok,
        path: r.path,
        src_size: r.src_size,
        tokens_count: r.tokens_count,
        stmt_count: r.stmt_count,
        diagnostics: r.diagnostics,
        chunk: r.chunk,
        symbol_table: nil,
        was_preprocessed: r.was_preprocessed,
    };
}

/// Compile a batch of files by path, one wire-safe frontend_compile_file() result per
/// input, in order. Files are independent translation units, so the batch fans out
/// across CPU cores via spawn/join; each spawned closure captures the shared read-only
/// `paths` array plus its own index. Falls back to sequential compilation if the
/// runtime rejects the spawned closures, so correctness never depends on threading.
/// Results omit `symbol_table` (see _file_result_wire_safe).
fn frontend_compile_file_many(paths, type_options = nil) {
    let n = len(paths);
    let results = [];
    if n == 0 { return results; }
    if n == 1 {
        array_push(results, _file_result_wire_safe(frontend_compile_file(paths[0], type_options)));
        return results;
    }

    let handles = [];
    let parallel = true;
    let i = 0;
    while i < n {
        let idx = i;
        let h = try spawn(fn() { return _file_result_wire_safe(frontend_compile_file(paths[idx], type_options)); }) catch nil;
        if h == nil { parallel = false; break; }
        array_push(handles, h);
        i = i + 1;
    }

    if parallel and len(handles) == n {
        let j = 0;
        while j < len(handles) {
            let v = try join(handles[j]) catch nil;
            if v == nil { parallel = false; break; }
            array_push(results, v);
            j = j + 1;
        }
        if parallel { return results; }
        results = [];
    }

    let k = 0;
    while k < n {
        array_push(results, _file_result_wire_safe(frontend_compile_file(paths[k], type_options)));
        k = k + 1;
    }
    return results;
}

fn _project_external_names(paths) {
    let names = map{}; let ordered = []; let limit = 16384;
    let i = 0;
    while i < len(paths) {
        let source = try fs_read(paths[i]) catch nil;
        if source != nil and source != "" {
            let ast = try _parse_tokens_checked(_TOKENIZER.tokenize(_preprocess_checked(source))) catch nil;
            if ast != nil and len(ast.errors) == 0 {
                let declarations = _collect_global_decls(try ast.stmts catch []);
                let declared = map_keys(declarations); let j = 0;
                while j < len(declared) {
                    if not map_has(names, declared[j]) {
                        names[declared[j]] = true; array_push(ordered, declared[j]);
                        if len(ordered) > limit { return ordered; }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return ordered;
}

/// Compile a project directory: find all .sapp files and compile them.
fn frontend_compile_project(dir) {
    if dir == nil or dir == "" {
        return map{
            ok: false,
            error: "frontend_compile_project: dir is empty",
        };
    }

    let results = [];
    let total_ok = 0;
    let total_fail = 0;

    // List .sapp files in the directory. The builtin is `fs_listdir` (returns
    // bare filenames); `fs_list` does not exist, so the old name threw
    // "undefined global 'fs_list'" on every call.
    let files = try fs_listdir(dir) catch nil;
    if files == nil {
        return map{
            ok: false,
            error: "frontend_compile_project: cannot list directory: " + dir,
        };
    }

    // Collect the .sapp files first, then compile them in parallel — each file is an
    // independent translation unit, so the whole directory fans out across CPU cores.
    let names = [];
    let paths = [];
    let fi = 0;
    while fi < len(files) {
        let f = files[fi];
        if str_ends_with(f, ".sapp") {
            array_push(names, f);
            array_push(paths, dir + "/" + f);
        }
        fi = fi + 1;
    }

    // The files remain separate translation units, but the type checker receives
    // a bounded project symbol index so valid cross-file references are not
    // mistaken for typos. Actual linker/module resolution remains a later stage.
    let external_names = _project_external_names(paths);
    let compiled = frontend_compile_file_many(paths, map{ extern_names: external_names });
    let ci = 0;
    while ci < len(compiled) {
        let result = compiled[ci];
        array_push(results, map{
            file: names[ci],
            ok: result.ok,
            diagnostics: result.diagnostics,
        });
        if result.ok { total_ok = total_ok + 1; }
        else { total_fail = total_fail + 1; }
        ci = ci + 1;
    }

    return map{
        ok: total_fail == 0,
        dir: dir,
        files_compiled: len(results),
        ok_count: total_ok,
        fail_count: total_fail,
        results: results,
    };
}

/// Full diagnostic analysis of a file: parse + typecheck + semantic.
fn frontend_analyze_file(path) {
    if path == nil or path == "" {
        return map{
            ok: false,
            error: "frontend_analyze_file: path is empty",
            diagnostics: [],
        };
    }

    let src = fs_read(path);
    if src == nil or src == "" {
        return map{
            ok: false,
            error: "frontend_analyze_file: cannot read file: " + path,
            diagnostics: [],
        };
    }

    let processed_src = _preprocess_checked(src);

    let tokens = _TOKENIZER.tokenize(processed_src);
    let ast = _parse_tokens_checked(tokens);

    let diagnostics = [];

    // Parse errors
    if ast.errors != nil {
        let ei = 0;
        while ei < len(ast.errors) {
            array_push(diagnostics, map{
                stage: "parse",
                message: ast.errors[ei],
                severity: "error",
            });
            ei = ei + 1;
        }
    }

    // Type errors
    if len(ast.errors) == 0 and ast.stmts != nil {
        let type_diags = _TYPECHECK.type_check(ast.stmts);
        let ti = 0;
        while ti < len(type_diags) {
            let td = type_diags[ti];
            array_push(diagnostics, map{
                stage: "type",
                message: td.message,
                severity: "error",
                span: td.span,
            });
            ti = ti + 1;
        }
    }

    // Semantic analysis diagnostics
    let sym_table = if len(ast.errors) == 0 { _SEMANTIC.analyze(ast) } else { nil };
    let si = 0;
    while sym_table != nil and si < len(sym_table.diagnostics) {
        let sd = sym_table.diagnostics[si];
        array_push(diagnostics, map{
            stage: "semantic",
            message: sd.message,
            severity: sd.kind,
        });
        si = si + 1;
    }

    let error_count = 0;
    let warning_count = 0;
    let di = 0;
    while di < len(diagnostics) {
        let d = diagnostics[di];
        if d.severity == "error" { error_count = error_count + 1; }
        if d.severity == "warning" { warning_count = warning_count + 1; }
        di = di + 1;
    }

    return map{
        ok: error_count == 0,
        path: path,
        tokens_count: len(tokens),
        stmt_count: if ast.stmts != nil { len(ast.stmts) } else { 0 },
        diagnostics: diagnostics,
        error_count: error_count,
        warning_count: warning_count,
        symbol_table: sym_table,
    };
}

/// Run the guard preprocessor as part of the pipeline and compile.
fn frontend_compile_with_guard_prep(source) {
    let stats = _preprocess_stats_checked(source);
    let processed = stats.source;

    let tokens = _TOKENIZER.tokenize(processed);
    let ast = _parse_tokens_checked(tokens);
    let diagnostics = [];

    if ast.errors != nil {
        let ei = 0;
        while ei < len(ast.errors) {
            array_push(diagnostics, ast.errors[ei]);
            ei = ei + 1;
        }
    }

    if len(ast.errors) == 0 and ast.stmts != nil {
        let type_diags = _TYPECHECK.type_check(ast.stmts);
        let ti = 0;
        while ti < len(type_diags) {
            array_push(diagnostics, type_diags[ti]);
            ti = ti + 1;
        }
    }

    let chunk = if len(ast.errors) == 0 { _CODEGEN.compile_stmts(ast.stmts) } else { _CODEGEN.Chunk() };

    return map{
        ok: len(diagnostics) == 0,
        ast: ast,
        chunk: chunk,
        diagnostics: diagnostics,
        preprocess_stats: stats,
    };
}

export frontend_analyze, frontend_parse_file, frontend_smoke;
export frontend_parse_full, frontend_parse_safe, frontend_typecheck, frontend_compile, frontend_compile_many, frontend_optimize;
export frontend_compile_file, frontend_compile_file_many, frontend_compile_project, frontend_analyze_file;
export frontend_compile_with_guard_prep;
export frontend_run, frontend_run_file, frontend_lint;
export frontend_run_bounded, frontend_run_file_bounded;
