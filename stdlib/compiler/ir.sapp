// stdlib/compiler/ir.sapp — Intermediate Representation for pblang bytecode
//
// Self-hosting milestone: IR analysis infrastructure.
//
// Features:
//   - SSA-based IR with basic blocks
//   - CFG (Control Flow Graph) construction from bytecode
//   - Dominator tree computation
//   - Loop detection (natural loops via back edges)
//
// Usage:
//   let ir = import("stdlib/compiler/ir.sapp");
//   let cfg = ir.build_cfg(chunk);
//   let doms = ir.compute_dominators(cfg);
//   let loops = ir.detect_loops(cfg, doms);

let OP_JUMP = 20;
let OP_JUMP_IF_FALSE = 21;
let OP_JUMP_IF_TRUE = 22;
let OP_RETURN = 19;
// Short-circuit / nil-coalescing peek-jumps (and / or / ??). These ARE control
// flow — the CFG must treat them like conditional jumps. Numbering matches
// codegen.sapp / vm.sapp.
let OP_JUMP_IF_FALSE_PEEK = 33;
let OP_JUMP_IF_TRUE_PEEK = 34;
let OP_JUMP_IF_NIL_PEEK = 36;
let OP_JUMP_IF_NOT_NIL_PEEK = 37;

// True for any opcode that transfers control to its operand (a jump target).
fn _is_cond_jump(op) {
    return op == OP_JUMP_IF_FALSE or op == OP_JUMP_IF_TRUE
        or op == OP_JUMP_IF_FALSE_PEEK or op == OP_JUMP_IF_TRUE_PEEK
        or op == OP_JUMP_IF_NIL_PEEK or op == OP_JUMP_IF_NOT_NIL_PEEK;
}
fn _is_any_jump(op) { return op == OP_JUMP or _is_cond_jump(op); }

// ═══════════════════════════════════════════════════════════════════════════════
// Basic types
// ═══════════════════════════════════════════════════════════════════════════════

fn make_block(id, start_idx, end_idx) {
    return map{
        id: id,
        start_idx: start_idx,
        end_idx: end_idx,
        instructions: [],
        successors: [],
        predecessors: [],
    };
}

fn make_instruction(idx, op, operand) {
    return map{ idx: idx, op: op, operand: operand };
}

// ═══════════════════════════════════════════════════════════════════════════════
// CFG Construction: identify basic blocks from bytecode
//
// A basic block is a straight-line sequence of instructions with:
//   - One entry point (first instruction)
//   - One exit point (last instruction)
//   - No jumps into the middle
//
// Leaders are:
//   1. The first instruction
//   2. Any instruction targeted by a jump
//   3. Any instruction following a jump/return
// ═══════════════════════════════════════════════════════════════════════════════

fn find_leaders(chunk) {
    let instructions = chunk.instructions;
    let leader_set = map{};
    let len_insts = len(instructions);

    if len_insts == 0 { return []; }

    // Leader 0: first instruction is always a leader
    leader_set["0"] = true;

    let i = 0;
    while i < len_insts {
        let inst = instructions[i];
        if inst == nil { i = i + 1; continue; }

        // Jump targets are leaders (incl. the short-circuit peek-jumps).
        if _is_any_jump(inst.op) {
            let target = inst.operand;
            if target >= 0 and target < len_insts {
                leader_set[str(target)] = true;
            }
        }

        // The instruction AFTER any jump (conditional or not) or a return starts
        // a new block — for a conditional jump that is the fall-through block, so
        // build_cfg can give it the two-successor edges.
        if _is_any_jump(inst.op) or inst.op == OP_RETURN {
            if i + 1 < len_insts {
                leader_set[str(i + 1)] = true;
            }
        }

        i = i + 1;
    }

    // Convert leader set to sorted array
    let leaders = [];
    let j = 0;
    while j < len_insts {
        if map_has(leader_set, str(j)) {
            array_push(leaders, j);
        }
        j = j + 1;
    }

    return leaders;
}

fn build_cfg(chunk) {
    let instructions = chunk.instructions;
    let leaders = find_leaders(chunk);
    let num_leaders = len(leaders);
    let blocks = [];

    if num_leaders == 0 {
        return map{ blocks: [], entry: 0 };
    }

    // Group instructions into blocks between leaders
    let b = 0;
    while b < num_leaders {
        let start = leaders[b];
        let end = if b + 1 < num_leaders { leaders[b + 1] - 1 } else { len(instructions) - 1 };

        let block = make_block(b, start, end);

        // Copy instructions into block
        let k = start;
        while k <= end {
            array_push(block.instructions, instructions[k]);
            k = k + 1;
        }

        array_push(blocks, block);
        b = b + 1;
    }

    // Build successor/predecessor edges
    let bi = 0;
    while bi < num_leaders {
        let block = blocks[bi];
        if block == nil { bi = bi + 1; continue; }

        let last_inst = block.instructions[len(block.instructions) - 1];
        if last_inst == nil { bi = bi + 1; continue; }

        // Conditional jump (incl. short-circuit peek-jumps): two successors.
        if _is_cond_jump(last_inst.op) {
            let target = last_inst.operand;
            // find_block_for returns a block INDEX, not the block map.
            let target_block = find_block_for(blocks, target);
            if target_block != nil {
                array_push(block.successors, target_block);
                array_push(blocks[target_block].predecessors, bi);
            }
            // Fall-through to next block
            if bi + 1 < num_leaders {
                array_push(block.successors, bi + 1);
                let next_block = blocks[bi + 1];
                if next_block != nil {
                    array_push(next_block.predecessors, bi);
                }
            }
        }
        // Unconditional jump: one successor
        elif last_inst.op == OP_JUMP {
            let target = last_inst.operand;
            let target_block = find_block_for(blocks, target);
            if target_block != nil {
                array_push(block.successors, target_block);
                array_push(blocks[target_block].predecessors, bi);
            }
        }
        // Return: no successors
        elif last_inst.op == OP_RETURN {
            // terminal, no successors
        }
        // Fall-through only (no jump/return at end): successor is next block
        else {
            if bi + 1 < num_leaders {
                array_push(block.successors, bi + 1);
                let next_block = blocks[bi + 1];
                if next_block != nil {
                    array_push(next_block.predecessors, bi);
                }
            }
        }

        bi = bi + 1;
    }

    return map{ blocks: blocks, entry: 0 };
}

fn find_block_for(blocks, inst_idx) {
    let i = len(blocks) - 1;
    while i >= 0 {
        let block = blocks[i];
        if block != nil and inst_idx >= block.start_idx and inst_idx <= block.end_idx {
            return i;
        }
        i = i - 1;
    }
    return nil;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Dominator tree computation
//
// DOM[n] = {n} ∪ ∩{DOM[p] for p in preds[n]}
// Using iterative data-flow algorithm (Cooper, Harvey, Kennedy)
// ═══════════════════════════════════════════════════════════════════════════════

fn compute_dominators(cfg) {
    let blocks = cfg.blocks;
    let num_blocks = len(blocks);
    if num_blocks == 0 {
        return map{ dominators: [], idom: [], dom_tree: [] };
    }

    // Initialize: DOM[0] = {0}, DOM[i] = all blocks for i > 0
    let doms = [];
    let i = 0;
    while i < num_blocks {
        if i == 0 {
            let entry = map{};
            entry[str(0)] = true;
            array_push(doms, entry);
        } else {
            let all_set = map{};
            let j = 0;
            while j < num_blocks {
                all_set[str(j)] = true;
                j = j + 1;
            }
            array_push(doms, all_set);
        }
        i = i + 1;
    }

    // Iterate until convergence
    let changed = true;
    let max_iters = num_blocks * 2;
    let iter = 0;
    while changed and iter < max_iters {
        changed = false;
        i = 1; // skip entry block
        while i < num_blocks {
            let block = blocks[i];
            if block == nil { i = i + 1; continue; }

            let new_dom = map{};
            let has_preds = false;

            // Start with intersection of all predecessors' dom sets
            let preds = block.predecessors;
            let p = 0;
            while p < len(preds) {
                let pred_idx = preds[p];
                if doms[pred_idx] != nil {
                    if not has_preds {
                        new_dom = copy_set(doms[pred_idx]);
                        has_preds = true;
                    } else {
                        new_dom = intersect_sets(new_dom, doms[pred_idx]);
                    }
                }
                p = p + 1;
            }

            // If no predecessors, keep current
            if not has_preds {
                new_dom = map{};
            }

            // Add self
            new_dom[str(i)] = true;

            // Check for change
            if not sets_equal(doms[i], new_dom) {
                doms[i] = new_dom;
                changed = true;
            }

            i = i + 1;
        }
        iter = iter + 1;
    }

    // Compute immediate dominators
    let idom = [];
    idom[0] = -1; // entry has no idom

    let d = 1;
    while d < num_blocks {
        idom[d] = compute_idom(doms, d, num_blocks);
        d = d + 1;
    }

    // Build dominator tree children list
    let dom_tree = [];
    let t = 0;
    while t < num_blocks {
        array_push(dom_tree, []);
        t = t + 1;
    }

    let c = 1;
    while c < num_blocks {
        let parent = idom[c];
        if parent >= 0 {
            array_push(dom_tree[parent], c);
        }
        c = c + 1;
    }

    return map{
        dominators: doms,
        idom: idom,
        dom_tree: dom_tree,
    };
}

fn copy_set(s) {
    let out = map{};
    let keys = map_keys(s);
    let i = 0;
    while i < len(keys) {
        out[keys[i]] = true;
        i = i + 1;
    }
    return out;
}

fn intersect_sets(a, b) {
    let result = map{};
    let keys = map_keys(a);
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        if map_has(b, k) {
            result[k] = true;
        }
        i = i + 1;
    }
    return result;
}

fn sets_equal(a, b) {
    let keys_a = map_keys(a);
    let keys_b = map_keys(b);
    if len(keys_a) != len(keys_b) { return false; }
    let i = 0;
    while i < len(keys_a) {
        if not map_has(b, keys_a[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn compute_idom(doms, node, num_blocks) {
    let node_dom = doms[node];
    if node_dom == nil { return -1; }

    let candidates = map_keys(node_dom);
    let strict_doms = [];
    let i = 0;
    while i < len(candidates) {
        let c = candidates[i];
        if c != str(node) {
            array_push(strict_doms, c);
        }
        i = i + 1;
    }

    // Among strict dominators, find the one that is not dominated by any other
    let best = "-1";
    let j = 0;
    while j < len(strict_doms) {
        let candidate = strict_doms[j];
        let is_closest = true;
        let k = 0;
        while k < len(strict_doms) {
            if j != k {
                let other = strict_doms[k];
                // `doms` is an array indexed by block number; `other` is a
                // string key, so convert it before indexing.
                let other_dom = doms[str_to_int(other)];
                if other_dom != nil and map_has(other_dom, candidate) {
                    is_closest = false;
                    break;
                }
            }
            k = k + 1;
        }
        if is_closest {
            best = candidate;
            break;
        }
        j = j + 1;
    }

    return str_to_int(best);
}

fn str_to_int(s) {
    if s == nil or s == "" { return -1; }
    let i = 0;
    let result = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c >= 48 and c <= 57 {
            result = result * 10 + (c - 48);
        } else {
            return result;
        }
        i = i + 1;
    }
    return result;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Loop detection: find natural loops via back edges
//
// A back edge is an edge n → d where d dominates n.
// The natural loop of back edge n → d is: d plus all nodes that can reach n
// without going through d.
// ═══════════════════════════════════════════════════════════════════════════════

fn detect_loops(cfg, dominators_info) {
    let blocks = cfg.blocks;
    let num_blocks = len(blocks);
    let doms = dominators_info.dominators;
    let loops = [];

    // Find back edges: edge n → d where d dominates n
    let i = 0;
    while i < num_blocks {
        let block = blocks[i];
        if block == nil { i = i + 1; continue; }

        let s = 0;
        while s < len(block.successors) {
            let succ = block.successors[s];
            if doms[i] != nil and map_has(doms[i], str(succ)) {
                // Back edge found: i → succ
                let loop_blocks = natural_loop_for(blocks, i, succ, num_blocks);
                if len(loop_blocks) > 0 {
                    array_push(loops, map{
                        header: succ,
                        latch: i,
                        blocks: loop_blocks,
                    });
                }
            }
            s = s + 1;
        }

        i = i + 1;
    }

    return map{ loops: loops, count: len(loops) };
}

fn natural_loop_for(blocks, latch, header, num_blocks) {
    let stack = [];
    let in_loop = map{};

    // Start with latch
    array_push(stack, latch);
    in_loop[str(latch)] = true;

    // Header is always in the loop
    in_loop[str(header)] = true;

    // DFS backwards from predecessors, stopping at header
    while len(stack) > 0 {
        let current = stack[len(stack) - 1];
        array_pop(stack);

        let block = blocks[current];
        if block == nil { continue; }

        let p = 0;
        while p < len(block.predecessors) {
            let pred = block.predecessors[p];
            if not map_has(in_loop, str(pred)) {
                in_loop[str(pred)] = true;
                array_push(stack, pred);
            }
            p = p + 1;
        }
    }

    // Convert to sorted array of block indices
    let result = [];
    let i = 0;
    while i < num_blocks {
        if map_has(in_loop, str(i)) {
            array_push(result, i);
        }
        i = i + 1;
    }
    return result;
}

// ═══════════════════════════════════════════════════════════════════════════════
// Utility: print CFG summary
// ═══════════════════════════════════════════════════════════════════════════════

fn cfg_to_string(cfg) {
    let out = "CFG: " + str(len(cfg.blocks)) + " blocks\n";
    let i = 0;
    while i < len(cfg.blocks) {
        let block = cfg.blocks[i];
        if block == nil { i = i + 1; continue; }

        out = out + "  B" + str(i) + " [" + str(block.start_idx) + "-" + str(block.end_idx) + "]";
        out = out + "  succ:";

        let s = 0;
        while s < len(block.successors) {
            out = out + " B" + str(block.successors[s]);
            s = s + 1;
        }

        out = out + "  pred:";
        let p = 0;
        while p < len(block.predecessors) {
            out = out + " B" + str(block.predecessors[p]);
            p = p + 1;
        }

        out = out + "\n";
        i = i + 1;
    }
    return out;
}

fn loops_to_string(loops_info) {
    let out = "Loops: " + str(loops_info.count) + "\n";
    let i = 0;
    while i < len(loops_info.loops) {
        let lp = loops_info.loops[i];
        out = out + "  header=B" + str(lp.header)
            + " latch=B" + str(lp.latch)
            + " blocks=";

        let j = 0;
        while j < len(lp.blocks) {
            if j > 0 { out = out + ","; }
            out = out + "B" + str(lp.blocks[j]);
            j = j + 1;
        }
        out = out + "\n";
        i = i + 1;
    }
    return out;
}

export build_cfg, compute_dominators, detect_loops;
export find_leaders, find_block_for;
export cfg_to_string, loops_to_string;
