// PBLang-native source-to-PBCS compiler surface shared by the CLI and bootstrap.

let Frontend = import("stdlib/compiler/selfhost_frontend.sapp");
let PBCK = import("stdlib/selfhost_pbck.sapp");
let Loader = import("stdlib/selfhost_loader.sapp");

fn compile_source(source) {
    if type(source) != "string" or source == "" {
        return map{ ok: false, stage: "input", error: "source must not be empty" };
    }
    let compiled = try Frontend.frontend_compile(source) catch nil;
    if compiled == nil {
        return map{ ok: false, stage: "compile", error: "self-host frontend failed" };
    }
    if not compiled.ok {
        return map{ ok: false, stage: "compile",
            error: "self-host diagnostics rejected the source",
            diagnostics: compiled.diagnostics };
    }
    let bytes = try PBCK.serialize_chunk(compiled.chunk) catch nil;
    if not is_array(bytes) {
        return map{ ok: false, stage: "serialize",
            error: "self-host artifact serialization failed" };
    }
    let decoded = try PBCK.deserialize_chunk(bytes) catch nil;
    if decoded == nil {
        return map{ ok: false, stage: "verify",
            error: "serialized self-host artifact did not round-trip" };
    }
    return map{
        ok: true, format: "pblang.selfhost.compile.v1",
        bytes: bytes, byte_count: len(bytes),
        instructions: len(decoded.instructions),
        constants: len(decoded.constants),
        digest: sha256(base64_encode_bytes(bytes))
    };
}

fn compile_file(input, output) {
    if type(input) != "string" or type(output) != "string"
        or input == "" or output == "" or input == output {
        return map{ ok: false, stage: "input",
            error: "input and output must be distinct non-empty paths" };
    }
    let source = try fs_read(input) catch nil;
    if type(source) != "string" {
        return map{ ok: false, stage: "read", error: "cannot read source" };
    }
    let result = compile_source(source);
    if not result.ok { return result; }
    let staging = output + ".tmp-" + str(num_floor(now_ms()));
    let wrote = try { fs_write_bytes(staging, result.bytes); true } catch false;
    if not wrote {
        try fs_remove(staging) catch nil;
        return map{ ok: false, stage: "write", error: "cannot stage artifact" };
    }
    let inspected = Loader.inspect_pbck(staging);
    if not inspected.ok {
        try fs_remove(staging) catch nil;
        return map{ ok: false, stage: "verify", error: inspected.error };
    }
    let published = try { fs_rename(staging, output); true } catch false;
    if not published {
        try fs_remove(staging) catch nil;
        return map{ ok: false, stage: "publish",
            error: "cannot atomically publish artifact" };
    }
    result.output = output;
    result.bytes = nil;
    return result;
}

export compile_source, compile_file;
