// Checked source -> retained native PBCK. Compilation is PBLang-owned;
// execution still needs the native VM and its separately granted capabilities.
let SOURCE = import("stdlib:compiler/checked_source.sapp");
let TYPES = import("stdlib:compiler/typeck.sapp");
let CODE = import("stdlib:compiler/codegen.sapp");
let PBCK = import("stdlib:selfhost_to_pbck.sapp");

fn _checked_chunk(source, entry_name=nil, cleanup_name=nil) {
    let ast = SOURCE.parse_source(source);
    if len(ast.stmts) == 0 { throw "native_pbck: source is empty"; }
    if entry_name != nil {
        let entries = 0; let cleanups = 0;
        for statement in ast.stmts {
            if statement.kind == "fn" and (statement.name == entry_name or statement.name == cleanup_name) {
                if len(statement.params) != 0 { throw "native_pbck: callbacks must take zero arguments"; }
                if statement.name == entry_name { entries = entries + 1; }
                if statement.name == cleanup_name { cleanups = cleanups + 1; }
            }
        }
        if entries != 1 or cleanups != 1 { throw "native_pbck: callbacks require distinct top-level functions"; }
    }
    let diagnostics = TYPES.type_check(ast.stmts);
    // Never emit the frontend's inspectable-but-invalid diagnostic chunk.
    // A fixed message also keeps source literals out of this public failure.
    if len(diagnostics) != 0 { throw "native_pbck: source check failed"; }
    return CODE.compile_stmts(ast.stmts);
}

fn compile_source(source) { return PBCK.translate(_checked_chunk(source)); }

fn _entry_name(name) {
    if type(name) != "string" or len(name) < 1 or len(name) > 128 {
        throw "native_pbck: invalid entry or cleanup name";
    }
    let index = 0;
    for ch in str_split(name, "") {
        let n = strcharcodeat(ch, 0);
        if not ((n >= 65 and n <= 90) or (n >= 97 and n <= 122) or n == 95)
            and (index == 0 or n < 48 or n > 57) {
            throw "native_pbck: invalid entry or cleanup name";
        }
        index = index + 1;
    }
}

// Initialization runs first, then entry() under one cleanup boundary. Both
// functions take zero arguments. Initialization/OS termination/native crashes
// are outside this boundary. Existing compile_source behavior stays unchanged.
fn checked_cleanup_chunk(source, entry_name, cleanup_name) {
    _entry_name(entry_name); _entry_name(cleanup_name);
    if entry_name == cleanup_name { throw "native_pbck: entry and cleanup must differ"; }
    if type(source) != "string" or len(source) > SOURCE.MAX_SOURCE_BYTES {
        throw "native_pbck: invalid guarded source";
    }
    // Names cannot inject syntax; newline terminates a trailing line comment.
    // Admission applies to the complete generated source, not separately to
    // fragments. No output is emitted before type checking both calls.
    let chunk = _checked_chunk(source + "\ntry " + entry_name + "() catch " + cleanup_name + "();", entry_name, cleanup_name);
    let index = len(chunk.instructions) - 2;
    if index < 0 or chunk.instructions[index].op != 35 or chunk.instructions[index + 1].op != 11 {
        throw "native_pbck: unsupported cleanup boundary shape";
    }
    return chunk;
}

fn compile_source_with_cleanup(source, entry_name, cleanup_name) {
    let chunk=checked_cleanup_chunk(source,entry_name,cleanup_name);
    return PBCK.translate_guarded(chunk,len(chunk.instructions)-2);
}

export compile_source, compile_source_with_cleanup;

// Compiler integration helper; returns checked IR, never executes callbacks.
export checked_cleanup_chunk;
