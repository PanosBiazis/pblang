        "str_slice": true, "str_split": true, "str_starts_with": true, "str_to_bytes": true, "str_trim": true, "str_upper": true,
        "strcharcodeat": true, "strfromcharcode": true, "sum": true, "tcp_accept": true, "tcp_close": true, "tcp_connect_tls": true,
        "tcp_listen": true, "tcp_listen_tls": true, "tcp_local_addr": true, "tcp_read": true, "tcp_read_until": true, "tcp_wrap_tls": true,
