        "polyglot_exec_compiled": true, "polyglot_exec_with_input": true, "pop": true, "pop_lifetime": true, "print": true, "proc_spawn_wait": true,
        "product": true, "push": true, "push_lifetime": true, "quantum_backends": true, "quantum_run": true, "quantum_simulate": true,
        "quantum_statevector": true, "random_bytes": true, "random_float": true, "range": true, "rational": true, "read_line": true,
        "recv": true, "recv_timeout": true, "regex_capture": true, "regex_find": true, "regex_find_all": true, "regex_match": true,
        "regex_replace": true, "regex_replace_all": true, "regex_split": true, "release_borrow": true, "require_type": true, "rwlock_new": true,
        "rwlock_read": true, "rwlock_unlock": true, "rwlock_write": true, "select": true, "select_with_timeout": true, "self": true,
        "send": true, "sha256": true, "sleep_ms": true, "slice": true, "spawn": true, "spawn_n": true,
