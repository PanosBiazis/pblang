        "ffi_call_typed": true, "ffi_close": true, "ffi_load": true, "freeze": true, "fs_append": true, "fs_copy": true,
        "fs_exists": true, "fs_listdir": true, "fs_mkdirs": true, "fs_read": true, "fs_read_bytes": true, "fs_remove": true,
        "fs_rename": true, "fs_write": true, "fs_write_bytes": true, "gc_collect": true, "gc_stats": true, "has_member": true,
        "hex_decode": true, "hex_encode": true, "hmac_sha256": true, "http_get": true, "http_get_auth": true, "http_parse_request": true,
        "http_post": true, "http_post_auth": true, "http_response": true, "http_response_ct": true, "http_response_json": true, "import": true,
        "is_array": true, "is_bool": true, "is_fn": true, "is_frozen": true, "is_map": true, "is_nil": true,
        "is_number": true, "is_string": true, "join": true, "join_all": true, "json_parse": true, "json_stringify": true,
        "len": true, "load": true, "map_has": true, "map_keys": true, "map_remove": true, "max_of": true,
