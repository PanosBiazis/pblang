        "memory_stats": true, "min_of": true, "mutex_lock": true, "mutex_new": true, "mutex_try_lock": true, "mutex_unlock": true,
        "nil": true, "now_iso": true, "now_ms": true, "num_abs": true, "num_atan2": true, "num_ceil": true,
        "num_exp": true, "num_floor": true, "num_ln": true, "num_max": true, "num_min": true, "num_mod": true,
        "num_pow": true, "num_sqrt": true, "once_is_done": true, "once_new": true, "onnx_infer": true, "os_args": true,
