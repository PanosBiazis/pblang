//! compiler/codegen.sapp — Self-hosting bytecode code generator for pblang
//! Part of the self-hosting compiler: tokenizer → parser → type_checker → codegen
//! Generates bytecode instructions from parsed AST.
//! WARNING: This is a simplified MVP — full codegen requires the complete type system.

let _vm_builtin_module = import("stdlib/compiler/vm_builtins.sapp");
let _VM_BUILTINS = _vm_builtin_module.registry();

// ── OpCode Constants ────────────────────────────────────────────────────
const OP_CONSTANT = 0;
const OP_ADD = 1;
const OP_SUB = 2;
const OP_MUL = 3;
const OP_DIV = 4;
const OP_EQ = 5;
const OP_NOT_EQ = 6;
const OP_GT = 7;
const OP_GE = 8;
const OP_LT = 9;
const OP_LE = 10;
const OP_POP = 11;
const OP_PRINT = 12;
const OP_DEFINE_GLOBAL = 13;
const OP_GET_GLOBAL = 14;
const OP_SET_GLOBAL = 15;
const OP_GET_LOCAL = 16;
const OP_SET_LOCAL = 17;
const OP_CALL = 18;
const OP_RETURN = 19;
const OP_JUMP = 20;
const OP_JUMP_IF_FALSE = 21;
const OP_JUMP_IF_TRUE = 22;
const OP_NOT = 23;
const OP_CLOSURE = 24;
const OP_MAKE_ARRAY = 25;
const OP_MAKE_MAP = 26;
const OP_GET_INDEX = 27;
const OP_SET_INDEX = 28;
const OP_GET_ATTR = 29;
const OP_SET_ATTR = 30;
const OP_MOD = 31;
const OP_LEN = 32;
const OP_JUMP_IF_FALSE_PEEK = 33;   // short-circuit: jump if top is falsy, do NOT pop
const OP_JUMP_IF_TRUE_PEEK = 34;    // short-circuit: jump if top is truthy, do NOT pop
const OP_TRY = 35;                  // try/catch: operand is a {try_chunk, catch_chunk} constant
const OP_JUMP_IF_NIL_PEEK = 36;     // jump if top is nil, do NOT pop
const OP_JUMP_IF_NOT_NIL_PEEK = 37; // jump if top is not nil, do NOT pop
const OP_GET_UPVALUE = 38;          // push the closure's captured upvalue[operand]
const OP_SET_UPVALUE = 39;          // store top into the closure's upvalue[operand]
const OP_THROW = 40;                // raise the top-of-stack value (caught by OP_TRY)
const OP_ADD_LOCAL_CONST = 41;      // optimizer-only: local[slot] += constant
const OP_ADD_LOCAL_LOCAL = 42;      // optimizer-only: local[slot] += local[rhs]

// ── Chunk ───────────────────────────────────────────────────────────────
fn Chunk() {
    return map{
        instructions: [],
        constants: [],
    };
}

fn chunk_add_constant(chunk, value) {
    array_push(chunk.constants, value);
    return len(chunk.constants) - 1;
}

fn chunk_write(chunk, instruction) {
    array_push(chunk.instructions, instruction);
}

fn chunk_write_op(chunk, opcode, operand) {
    array_push(chunk.instructions, map{op: opcode, operand: operand});
}

// ── Code Generator ──────────────────────────────────────────────────────
fn CodeGen() {
    return map{
        chunk: Chunk(),
        globals: map{},     // name → constant_index
        locals: [],      // [{name, depth}]
        scope_depth: 0,
        loops: [],       // stack of { breaks: [jump_idx...], continues: [jump_idx...] }
        is_module: false, // true for the top-level/main chunk (module scoping)
        next_slot: 0,     // monotonic local-slot counter (slots are never reused)
        parent: nil,      // enclosing CodeGen (for upvalue resolution), nil at top
        upvalues: [],     // [{index, is_local}] captured by THIS function
        exports: [],      // names listed in `export ...;` statements (module API)
    };
}

// Is the current position the module's top level (top-level `let`/`const` here
// become globals, visible to every function in the module)?
fn _at_module_top(cg) { return cg.is_module and cg.scope_depth == 1; }

// Local `let`/`const`: evaluate the value FIRST (so a same-named outer binding or
// builtin in the initializer resolves correctly — e.g. `let len = len(source)`),
// THEN declare the local and store into its slot.
fn codegen_local_let(cg, node) {
    if node.value != nil {
        codegen_expr(cg, node.value);
    } else {
        let idx_nil = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx_nil);
    }
    let slot = codegen_declare_local(cg, node.name);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, slot);
}

// Top-level `let`/`const`: evaluate the value and DEFINE it as a global.
fn codegen_global_let(cg, node) {
    if node.value != nil {
        codegen_expr(cg, node.value);
    } else {
        let idx_nil = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx_nil);
    }
    let name_idx = codegen_intern_global(cg, node.name);
    chunk_write_op(cg.chunk, OP_DEFINE_GLOBAL, name_idx);
}

// ── Loop control (break/continue) bookkeeping ───────────────────────────
fn _loop_push(cg) { array_push(cg.loops, map{ breaks: [], continues: [] }); }
fn _loop_pop(cg) { return array_pop(cg.loops); }
fn _loop_cur(cg) { return cg.loops[len(cg.loops) - 1]; }

// Patch a list of placeholder JUMP instructions to `target`.
fn _patch_all(cg, idxs, target) {
    let i = 0;
    while i < len(idxs) { cg.chunk.instructions[idxs[i]].operand = target; i = i + 1; }
}

fn codegen_break(cg) {
    if len(cg.loops) == 0 { return; }
    let idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP, 0);
    array_push(_loop_cur(cg).breaks, idx);
}
fn codegen_continue(cg) {
    if len(cg.loops) == 0 { return; }
    let idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP, 0);
    array_push(_loop_cur(cg).continues, idx);
}

/// Intern a global name string
fn codegen_intern_global(cg, name) {
    if not map_has(cg.globals, name) {
        let idx = chunk_add_constant(cg.chunk, name);
        cg.globals[name] = idx;
    }
    return cg.globals[name];
}

/// Begin a new scope
fn codegen_begin_scope(cg) {
    cg.scope_depth = cg.scope_depth + 1;
}

/// End current scope (pop locals)
fn codegen_end_scope(cg) {
    let i = len(cg.locals) - 1;
    while i >= 0 {
        if cg.locals[i].depth == cg.scope_depth {
            array_pop(cg.locals);
        }
        i = i - 1;
    }
    cg.scope_depth = cg.scope_depth - 1;
}

/// Declare a local variable. Each gets a unique, never-reused slot so sibling
/// scopes (e.g. two branches of an `if`, or successive blocks in a big function)
/// can't alias the same runtime slot.
fn codegen_declare_local(cg, name) {
    let slot = cg.next_slot;
    cg.next_slot = cg.next_slot + 1;
    array_push(cg.locals, map{name: name, depth: cg.scope_depth, slot: slot});
    return slot;
}

/// Look up `name` among a CodeGen's own locals only (no parent walk). Returns the
/// slot, or -1 if not a local of this function.
fn _resolve_local_only(cg, name) {
    let i = len(cg.locals) - 1;
    while i >= 0 {
        if cg.locals[i].name == name { return cg.locals[i].slot; }
        i = i - 1;
    }
    return -1;
}

/// Record that `cg` captures an upvalue (deduplicated). `index`/`is_local` say
/// where it comes from in the ENCLOSING frame: a parent local slot (is_local) or
/// the parent's own upvalue slot (transitive capture). Returns this function's
/// upvalue index.
fn _add_upvalue(cg, index, is_local) {
    let i = 0;
    while i < len(cg.upvalues) {
        if cg.upvalues[i].index == index and cg.upvalues[i].is_local == is_local { return i; }
        i = i + 1;
    }
    array_push(cg.upvalues, map{index: index, is_local: is_local});
    return len(cg.upvalues) - 1;
}

/// Resolve `name` as an upvalue of `cg` by walking the enclosing chain. Returns
/// the upvalue index in `cg`, or -1 if `name` is not an enclosing local/upvalue.
fn codegen_resolve_upvalue(cg, name) {
    if cg.parent == nil { return -1; }
    // Captured directly from the enclosing function's locals?
    let plocal = _resolve_local_only(cg.parent, name);
    if plocal >= 0 { return _add_upvalue(cg, plocal, true); }
    // Otherwise, captured transitively through the enclosing function's upvalues.
    let puv = codegen_resolve_upvalue(cg.parent, name);
    if puv >= 0 { return _add_upvalue(cg, puv, false); }
    return -1;
}

/// Resolve a variable name → {kind: "local"|"upvalue"|"global", index}.
/// Lexical order: own local → enclosing-scope capture (upvalue) → global.
fn codegen_resolve(cg, name) {
    // Check locals (reverse order for shadowing)
    let local = _resolve_local_only(cg, name);
    if local >= 0 { return map{kind: "local", index: local}; }
    // Captured from an enclosing function (closure upvalue)
    if cg.parent != nil {
        let uv = codegen_resolve_upvalue(cg, name);
        if uv >= 0 { return map{kind: "upvalue", index: uv}; }
    }
    // Global
    let const_idx = codegen_intern_global(cg, name);
    return map{kind: "global", index: const_idx};
}

// ── Expression Compilation ──────────────────────────────────────────────

/// Compile a literal expression
fn codegen_literal(cg, node) {
    // node = map{kind: "number"|"string"|"bool"|"nil", value: ...}
    let kind = node.kind;
    if kind == "number" {
        // The tokenizer carries the numeric literal as its source text; intern
        // it as a real number so arithmetic works (otherwise `1 + 2` would
        // string-concat to "12").
        let idx = chunk_add_constant(cg.chunk, parse_number(node.value));
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
        return;
    }
    if kind == "string" {
        let idx = chunk_add_constant(cg.chunk, node.value);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
        return;
    }
    if kind == "bool" {
        // Intern the real boolean (not 1/0) so `x == true` and friends work.
        let idx = chunk_add_constant(cg.chunk, node.value);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
        return;
    }
    if kind == "nil" {
        let idx = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
        return;
    }
}

/// Compile a variable reference
fn codegen_var(cg, node) {
    // node = map{kind: "var", name: "x"}
    let resolved = codegen_resolve(cg, node.name);
    if resolved.kind == "local" {
        chunk_write_op(cg.chunk, OP_GET_LOCAL, resolved.index);
    } else if resolved.kind == "upvalue" {
        chunk_write_op(cg.chunk, OP_GET_UPVALUE, resolved.index);
    } else {
        chunk_write_op(cg.chunk, OP_GET_GLOBAL, resolved.index);
    }
}

/// Compile a binary operation
fn codegen_binary(cg, node) {
    // node = map{kind: "binary", op: "+"|"-"|"*"|"/"|"=="|"!="|"<"|">"|"<="|">=", left, right}
    codegen_expr(cg, node.left);
    codegen_expr(cg, node.right);
    
    let op = node.op;
    if op == "+" { chunk_write_op(cg.chunk, OP_ADD, 0); return; }
    if op == "-" { chunk_write_op(cg.chunk, OP_SUB, 0); return; }
    if op == "*" { chunk_write_op(cg.chunk, OP_MUL, 0); return; }
    if op == "/" { chunk_write_op(cg.chunk, OP_DIV, 0); return; }
    if op == "%" { chunk_write_op(cg.chunk, OP_MOD, 0); return; }
    if op == "==" { chunk_write_op(cg.chunk, OP_EQ, 0); return; }
    if op == "!=" { chunk_write_op(cg.chunk, OP_NOT_EQ, 0); return; }
    if op == "<" { chunk_write_op(cg.chunk, OP_LT, 0); return; }
    if op == ">" { chunk_write_op(cg.chunk, OP_GT, 0); return; }
    if op == "<=" { chunk_write_op(cg.chunk, OP_LE, 0); return; }
    if op == ">=" { chunk_write_op(cg.chunk, OP_GE, 0); return; }
}

/// Compile `try <body> catch <handler>`. The body and handler are each compiled
/// into their own sub-chunk that SHARES the enclosing local slots (so they can
/// read variables in scope); at runtime OP_TRY executes the body sub-chunk inside
/// the interpreter's own pblang try/catch, falling back to the handler sub-chunk.
fn _copy_locals(locals) {
    let out = [];
    let i = 0;
    while i < len(locals) { array_push(out, locals[i]); i = i + 1; }
    return out;
}

fn codegen_try(cg, node) {
    let body_cg = CodeGen();
    body_cg.locals = _copy_locals(cg.locals);
    body_cg.scope_depth = cg.scope_depth;
    codegen_expr(body_cg, node.body);
    chunk_write_op(body_cg.chunk, OP_RETURN, 0);

    let handler_cg = CodeGen();
    handler_cg.locals = _copy_locals(cg.locals);
    handler_cg.scope_depth = cg.scope_depth;
    codegen_expr(handler_cg, node.handler);
    chunk_write_op(handler_cg.chunk, OP_RETURN, 0);

    let idx = chunk_add_constant(cg.chunk, map{ try_chunk: body_cg.chunk, catch_chunk: handler_cg.chunk });
    chunk_write_op(cg.chunk, OP_TRY, idx);
}

/// Compile a block so that it leaves its VALUE on the stack (the value of its
/// last statement if that is an expression statement, else nil). Used by the
/// expression form of `if`.
fn codegen_block_expr(cg, block) {
    let stmts = block;
    if is_map(block) { stmts = block.stmts; }

    codegen_begin_scope(cg);
    if len(stmts) == 0 {
        let idx = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
    } else {
        let i = 0;
        while i < len(stmts) - 1 { codegen_stmt(cg, stmts[i]); i = i + 1; }
        let last = stmts[len(stmts) - 1];
        if is_map(last) and last.kind == "expr_stmt" {
            codegen_expr(cg, last.expr);   // leave its value on the stack
        } else if is_map(last) and last.kind == "if" {
            // A trailing `if` statement is value-producing in this position
            // (matches the Rust VM); emit it as a value, not a void statement.
            codegen_if_stmt_as_value(cg, last);
        } else {
            codegen_stmt(cg, last);
            let idx = chunk_add_constant(cg.chunk, nil);
            chunk_write_op(cg.chunk, OP_CONSTANT, idx);
        }
    }
    codegen_end_scope(cg);
}

/// `if <cond> { ... } else { ... }` as an expression — leaves the chosen branch's
/// value on the stack. `else` may be another if-expr (else if) or a block.
// match expression — desugars to: store scrutinee in a temp local, then an
// if-else chain testing each arm in order. Literal arms compare with `==`; bind
// arms copy the scrutinee into a named local (always match, unless guarded);
// wildcard `_` always matches. The first matching arm's body is the result;
// `else`/no-match yields the else body, or nil.
fn codegen_match(cg, node) {
    codegen_begin_scope(cg);   // temp + bound names live only inside the match
    codegen_expr(cg, node["scrutinee"]);
    let tmp = codegen_declare_local(cg, "__match_scrut");
    chunk_write_op(cg.chunk, OP_SET_LOCAL, tmp);

    let end_jumps = [];   // JUMP-to-end instruction indices, patched at the end
    let arms = node["arms"];
    let ai = 0;
    while ai < len(arms) {
        let arm = arms[ai];
        let pat = arm["pattern"];
        let pt = pat["ptype"];
        let next_jump = 0 - 1;   // conditional jump to the next arm (-1 = none)

        if pt == "literal" {
            chunk_write_op(cg.chunk, OP_GET_LOCAL, tmp);
            codegen_expr(cg, pat["value"]);
            chunk_write_op(cg.chunk, OP_EQ, 0);
            next_jump = len(cg.chunk.instructions);
            chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
        } else if pt == "bind" {
            let bslot = codegen_declare_local(cg, pat["name"]);
            chunk_write_op(cg.chunk, OP_GET_LOCAL, tmp);
            chunk_write_op(cg.chunk, OP_SET_LOCAL, bslot);
            if arm["guard"] != nil {
                codegen_expr(cg, arm["guard"]);
                next_jump = len(cg.chunk.instructions);
                chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
            }
        } else {
            // wildcard "_" — always matches (a guard may still gate it)
            if arm["guard"] != nil {
                codegen_expr(cg, arm["guard"]);
                next_jump = len(cg.chunk.instructions);
                chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
            }
        }

        codegen_expr(cg, arm["body"]);
        let ej = len(cg.chunk.instructions);
        chunk_write_op(cg.chunk, OP_JUMP, 0);
        array_push(end_jumps, ej);

        if next_jump >= 0 {
            cg.chunk.instructions[next_jump]["operand"] = len(cg.chunk.instructions);
        }
        ai = ai + 1;
    }

    let els = node["melse"];
    if els == nil {
        let idx = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
    } else {
        codegen_expr(cg, els);
    }

    let ei = 0;
    while ei < len(end_jumps) {
        cg.chunk.instructions[end_jumps[ei]]["operand"] = len(cg.chunk.instructions);
        ei = ei + 1;
    }
    codegen_end_scope(cg);
}

fn codegen_if_expr(cg, node) {
    codegen_expr(cg, node["cond"]);
    let else_jump = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);

    codegen_block_expr(cg, node["then"]);
    let end_jump = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP, 0);

    cg.chunk.instructions[else_jump].operand = len(cg.chunk.instructions);
    let els = node["else"];
    if els == nil {
        let idx = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);
    } else if is_map(els) and els.kind == "if_expr" {
        codegen_if_expr(cg, els);          // nested else-if
    } else {
        codegen_block_expr(cg, els);
    }
    cg.chunk.instructions[end_jump].operand = len(cg.chunk.instructions);
}

/// Emit an `if` STATEMENT node `{cond, then, elifs, else}` in VALUE position —
/// leaves the chosen branch's value on the stack (nil if no branch is taken).
/// Used when an if-statement is the tail of a value block (e.g. an if-expression
/// branch whose last statement is an `if`); the Rust VM treats that as a value,
/// so the self-hosted compiler must too. Unlike `codegen_if_expr`, this handles
/// the `elifs` list that the if-statement grammar produces.
fn codegen_if_stmt_as_value(cg, node) {
    let end_jumps = [];

    codegen_expr(cg, node["cond"]);
    let else_jump = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
    codegen_block_expr(cg, node["then"]);
    let ej0 = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP, 0);
    array_push(end_jumps, ej0);
    cg.chunk.instructions[else_jump].operand = len(cg.chunk.instructions);

    let elifs = node["elifs"];
    if elifs != nil {
        let i = 0;
        while i < len(elifs) {
            codegen_expr(cg, elifs[i]["cond"]);
            let nx = len(cg.chunk.instructions);
            chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
            codegen_block_expr(cg, elifs[i]["body"]);
            let ej = len(cg.chunk.instructions);
            chunk_write_op(cg.chunk, OP_JUMP, 0);
            array_push(end_jumps, ej);
            cg.chunk.instructions[nx].operand = len(cg.chunk.instructions);
            i = i + 1;
        }
    }

    if node["else"] == nil {
        let idx = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx);   // no branch taken → nil
    } else {
        codegen_block_expr(cg, node["else"]);
    }

    let k = 0;
    while k < len(end_jumps) {
        cg.chunk.instructions[end_jumps[k]].operand = len(cg.chunk.instructions);
        k = k + 1;
    }
}

/// Short-circuit `and`/`or` via peek-jumps (the operand stays on the stack when
/// the result is determined by the left side).
fn codegen_logical(cg, node) {
    codegen_expr(cg, node.left);
    let jidx = len(cg.chunk.instructions);
    if node.op == "and" {
        chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE_PEEK, 0);
    } else {
        chunk_write_op(cg.chunk, OP_JUMP_IF_TRUE_PEEK, 0);
    }
    chunk_write_op(cg.chunk, OP_POP, 0);     // discard left; result is the right side
    codegen_expr(cg, node.right);
    cg.chunk.instructions[jidx].operand = len(cg.chunk.instructions);
}

/// Compile a function call
fn codegen_call(cg, node) {
    // Parser AST: call = { func: <expr>, args: [...] }. Stack layout matches the
    // native Rust VM's calling convention: the CALLEE is pushed FIRST, then the
    // args (arg0..argN-1) on top. This shared convention lets self-hosted-compiled
    // bytecode run unchanged on the Rust VM (see stdlib/selfhost_to_pbck.sapp).

    // Callee. An ident is resolved by name (this also routes host builtins, which
    // the VM recognizes on OP_GET_GLOBAL). Any other callable expression — a
    // member `obj.f(...)`, an index `tbl[i](...)`, a parenthesized fn, a call
    // result — is code-generated normally so its value lands on the stack.
    let fn_node = node.func;
    if fn_node.kind == "ident" {
        let resolved = codegen_resolve(cg, fn_node.name);
        if resolved.kind == "local" {
            chunk_write_op(cg.chunk, OP_GET_LOCAL, resolved.index);
        } else if resolved.kind == "upvalue" {
            // A captured function used as a callee (e.g. `g(x)` inside
            // `fn(x){ return g(x); }` where g is an enclosing param). Without this
            // branch the upvalue index was misemitted as OP_GET_GLOBAL.
            chunk_write_op(cg.chunk, OP_GET_UPVALUE, resolved.index);
        } else {
            let direct_idx = len(cg.chunk.instructions);
            chunk_write_op(cg.chunk, OP_GET_GLOBAL, resolved.index);
            // Optional metadata for the pure-pblang VM. The opcode/operand stay
            // unchanged, so Rust VM and serialized bytecode compatibility are
            // preserved. At runtime this is used only when the global is absent
            // and the name resolves to a host builtin.
            if map_has(_VM_BUILTINS, fn_node.name) {
                cg.chunk.instructions[direct_idx].direct_builtin_call = map{ __bi: fn_node.name };
            }
        }
    } else {
        codegen_expr(cg, fn_node);
    }

    // Args, left-to-right, on top of the callee.
    let i = 0;
    while i < len(node.args) {
        codegen_expr(cg, node.args[i]);
        i = i + 1;
    }

    chunk_write_op(cg.chunk, OP_CALL, len(node.args));
}

/// Compile an array literal
fn codegen_array(cg, node) {
    // Parser AST: array = { items: [...] }.
    let i = 0;
    while i < len(node.items) {
        codegen_expr(cg, node.items[i]);
        i = i + 1;
    }
    chunk_write_op(cg.chunk, OP_MAKE_ARRAY, len(node.items));
}

/// Compile a map literal
fn codegen_map(cg, node) {
    // Parser AST: map = { entries: [{ key: <string>, value: <expr> }, ...] }.
    // The key is a literal name, so push it as a string constant (not codegen_expr).
    let i = 0;
    while i < len(node.entries) {
        let key_idx = chunk_add_constant(cg.chunk, node.entries[i].key);
        chunk_write_op(cg.chunk, OP_CONSTANT, key_idx);
        codegen_expr(cg, node.entries[i].value);
        i = i + 1;
    }
    chunk_write_op(cg.chunk, OP_MAKE_MAP, len(node.entries));
}

/// Compile any expression
fn codegen_expr(cg, node) {
    if node == nil { return; }
    let kind = node.kind;
    
    if kind == "number" or kind == "string" or kind == "bool" or kind == "nil" {
        codegen_literal(cg, node);
        return;
    }
    if kind == "ident" {
        codegen_var(cg, node);
        return;
    }
    if kind == "binary" {
        if node.op == "and" or node.op == "or" { codegen_logical(cg, node); }
        else { codegen_binary(cg, node); }
        return;
    }
    if kind == "call" {
        codegen_call(cg, node);
        return;
    }
    if kind == "array" {
        codegen_array(cg, node);
        return;
    }
    if kind == "map" {
        codegen_map(cg, node);
        return;
    }
    if kind == "fn_lit" {
        codegen_fnlit(cg, node);
        return;
    }
    if kind == "throw" {
        // Evaluate the thrown value, then OP_THROW raises it; OP_TRY (host
        // try/catch in vm.sapp) catches and runs the handler.
        codegen_expr(cg, node.value);
        chunk_write_op(cg.chunk, OP_THROW, 0);
        return;
    }
    if kind == "try" {
        codegen_try(cg, node);
        return;
    }
    if kind == "if_expr" {
        codegen_if_expr(cg, node);
        return;
    }
    if kind == "match" {
        codegen_match(cg, node);
        return;
    }
    if kind == "unary" {
        // parser AST: unary = { op, operand }
        if node.op == "-" {
            let zero_idx = chunk_add_constant(cg.chunk, 0);
            chunk_write_op(cg.chunk, OP_CONSTANT, zero_idx);
            codegen_expr(cg, node.operand);
            chunk_write_op(cg.chunk, OP_SUB, 0);
        } else if node.op == "not" or node.op == "!" {
            codegen_expr(cg, node.operand);
            chunk_write_op(cg.chunk, OP_NOT, 0);
        }
        return;
    }
    if kind == "index" {
        codegen_expr(cg, node.obj);
        codegen_expr(cg, node.index);
        chunk_write_op(cg.chunk, OP_GET_INDEX, 0);
        return;
    }
    if kind == "member" {
        codegen_expr(cg, node.obj);
        let name_idx = chunk_add_constant(cg.chunk, node.name);
        chunk_write_op(cg.chunk, OP_GET_ATTR, name_idx);
        return;
    }
    if kind == "coalesce" {
        // a ?? b : a unless a is nil, else b (short-circuit, b not evaluated if a != nil)
        codegen_expr(cg, node["left"]);
        let jnn = len(cg.chunk.instructions);
        chunk_write_op(cg.chunk, OP_JUMP_IF_NOT_NIL_PEEK, 0);
        chunk_write_op(cg.chunk, OP_POP, 0);
        codegen_expr(cg, node["right"]);
        cg.chunk.instructions[jnn]["operand"] = len(cg.chunk.instructions);
        return;
    }
    if kind == "opt_member" {
        // a?.b : nil if a is nil, else a.b
        codegen_expr(cg, node["obj"]);
        let jn = len(cg.chunk.instructions);
        chunk_write_op(cg.chunk, OP_JUMP_IF_NIL_PEEK, 0);
        let nidx = chunk_add_constant(cg.chunk, node["name"]);
        chunk_write_op(cg.chunk, OP_GET_ATTR, nidx);
        cg.chunk.instructions[jn]["operand"] = len(cg.chunk.instructions);
        return;
    }
    if kind == "opt_index" {
        // a?[i] : nil if a is nil, else a[i]
        codegen_expr(cg, node["obj"]);
        let jn = len(cg.chunk.instructions);
        chunk_write_op(cg.chunk, OP_JUMP_IF_NIL_PEEK, 0);
        codegen_expr(cg, node["index"]);
        chunk_write_op(cg.chunk, OP_GET_INDEX, 0);
        cg.chunk.instructions[jn]["operand"] = len(cg.chunk.instructions);
        return;
    }
}

// ── Statement Compilation ───────────────────────────────────────────────

/// Compile a let statement
fn codegen_let(cg, node) {
    // node = map{kind: "let", name: "x", value: <expr>}
    if node.value != nil {
        codegen_expr(cg, node.value);
    } else {
        let idx_nil = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx_nil);
    }
    
    let resolved = codegen_resolve(cg, node.name);
    if resolved.kind == "local" {
        chunk_write_op(cg.chunk, OP_SET_LOCAL, resolved.index);
    } else {
        chunk_write_op(cg.chunk, OP_SET_GLOBAL, resolved.index);
    }
}

/// Compile a const statement (same as let but marks as const)
fn codegen_const(cg, node) {
    codegen_let(cg, node); // same bytecode, const-check is compile-time only
}

/// Compile a return statement
fn codegen_return(cg, node) {
    if node.value != nil {
        codegen_expr(cg, node.value);
    } else {
        let idx_nil = chunk_add_constant(cg.chunk, nil);
        chunk_write_op(cg.chunk, OP_CONSTANT, idx_nil);
    }
    chunk_write_op(cg.chunk, OP_RETURN, 0);
}

/// Compile an if/else statement
fn codegen_if(cg, node) {
    // Parser AST (parser.sapp::stmt_if): { cond, then, elifs, else }, where
    // `then`/`else`/elif bodies are block nodes. Lowered as a chain:
    //   cond? then : (elif_cond? elif_body : ... : else). Each arm jumps to the
    //   shared end after running. `else` is bracket-accessed (keyword).
    let end_jumps = [];   // JUMP-to-end instruction indices to backpatch

    // Primary `if`
    codegen_expr(cg, node["cond"]);
    let next_idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
    codegen_block(cg, node["then"]);
    array_push(end_jumps, len(cg.chunk.instructions));
    chunk_write_op(cg.chunk, OP_JUMP, 0);
    cg.chunk.instructions[next_idx].operand = len(cg.chunk.instructions);

    // `elif` arms
    let elifs = node["elifs"];
    if elifs != nil {
        let i = 0;
        while i < len(elifs) {
            let e = elifs[i];
            codegen_expr(cg, e["cond"]);
            let n2 = len(cg.chunk.instructions);
            chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);
            codegen_block(cg, e["body"]);
            array_push(end_jumps, len(cg.chunk.instructions));
            chunk_write_op(cg.chunk, OP_JUMP, 0);
            cg.chunk.instructions[n2].operand = len(cg.chunk.instructions);
            i = i + 1;
        }
    }

    // `else`
    if node["else"] != nil { codegen_block(cg, node["else"]); }

    // Backpatch every arm's end-jump to here.
    let endpos = len(cg.chunk.instructions);
    let k = 0;
    while k < len(end_jumps) {
        cg.chunk.instructions[end_jumps[k]].operand = endpos;
        k = k + 1;
    }
}

/// Compile a while loop
fn codegen_while(cg, node) {
    // Parser AST (parser.sapp::stmt_while): { cond, body } (body is a stmt list).
    let loop_start = len(cg.chunk.instructions);

    codegen_expr(cg, node["cond"]);
    
    let jump_exit_idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0); // placeholder

    _loop_push(cg);
    codegen_block(cg, node.body);
    let lc = _loop_pop(cg);
    _patch_all(cg, lc.continues, loop_start);    // continue → re-check condition

    chunk_write_op(cg.chunk, OP_JUMP, loop_start);

    let loop_end = len(cg.chunk.instructions);
    cg.chunk.instructions[jump_exit_idx].operand = loop_end;
    _patch_all(cg, lc.breaks, loop_end);         // break → after loop
}

/// Compile a count loop `for <name> <end> { body }`, lowered to
/// `name = 0; while name < end { body; name = name + 1; }` (name in 0..end-1).
fn codegen_for(cg, node) {
    let slot = codegen_declare_local(cg, node.name);
    let zero_idx = chunk_add_constant(cg.chunk, 0);
    chunk_write_op(cg.chunk, OP_CONSTANT, zero_idx);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, slot);

    let loop_start = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_GET_LOCAL, slot);
    codegen_expr(cg, node.end);
    chunk_write_op(cg.chunk, OP_LT, 0);
    let exit_idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);

    _loop_push(cg);
    codegen_block(cg, node.body);
    let lc = _loop_pop(cg);
    _patch_all(cg, lc.continues, len(cg.chunk.instructions));   // continue → increment

    chunk_write_op(cg.chunk, OP_GET_LOCAL, slot);
    let one_idx = chunk_add_constant(cg.chunk, 1);
    chunk_write_op(cg.chunk, OP_CONSTANT, one_idx);
    chunk_write_op(cg.chunk, OP_ADD, 0);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, slot);
    chunk_write_op(cg.chunk, OP_JUMP, loop_start);

    let loop_end = len(cg.chunk.instructions);
    cg.chunk.instructions[exit_idx].operand = loop_end;
    _patch_all(cg, lc.breaks, loop_end);
}

/// Compile `for <name> in <iter> { body }`, lowered to:
///   __arr = iter; __i = 0; while __i < len(__arr) { name = __arr[__i]; body; __i = __i + 1; }
fn codegen_for_in(cg, node) {
    let arr_slot = codegen_declare_local(cg, "__forin_arr");
    codegen_expr(cg, node.iter);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, arr_slot);

    let idx_slot = codegen_declare_local(cg, "__forin_idx");
    let zero_idx = chunk_add_constant(cg.chunk, 0);
    chunk_write_op(cg.chunk, OP_CONSTANT, zero_idx);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, idx_slot);

    let var_slot = codegen_declare_local(cg, node.name);

    let loop_start = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_GET_LOCAL, idx_slot);
    chunk_write_op(cg.chunk, OP_GET_LOCAL, arr_slot);
    chunk_write_op(cg.chunk, OP_LEN, 0);
    chunk_write_op(cg.chunk, OP_LT, 0);
    let exit_idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);

    // name = __arr[__i]
    chunk_write_op(cg.chunk, OP_GET_LOCAL, arr_slot);
    chunk_write_op(cg.chunk, OP_GET_LOCAL, idx_slot);
    chunk_write_op(cg.chunk, OP_GET_INDEX, 0);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, var_slot);

    _loop_push(cg);
    codegen_block(cg, node.body);
    let lc = _loop_pop(cg);
    _patch_all(cg, lc.continues, len(cg.chunk.instructions));   // continue → increment

    // __i = __i + 1
    chunk_write_op(cg.chunk, OP_GET_LOCAL, idx_slot);
    let one_idx = chunk_add_constant(cg.chunk, 1);
    chunk_write_op(cg.chunk, OP_CONSTANT, one_idx);
    chunk_write_op(cg.chunk, OP_ADD, 0);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, idx_slot);
    chunk_write_op(cg.chunk, OP_JUMP, loop_start);

    let loop_end = len(cg.chunk.instructions);
    cg.chunk.instructions[exit_idx].operand = loop_end;
    _patch_all(cg, lc.breaks, loop_end);
}

/// Compile `for <name> in <start> to <end> { body }` (inclusive range), lowered
/// to `name = start; while name <= end { body; name = name + 1; }`.
fn codegen_for_range(cg, node) {
    let slot = codegen_declare_local(cg, node.name);
    codegen_expr(cg, node.start);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, slot);

    let loop_start = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_GET_LOCAL, slot);
    codegen_expr(cg, node.end);
    chunk_write_op(cg.chunk, OP_LE, 0);   // inclusive
    let exit_idx = len(cg.chunk.instructions);
    chunk_write_op(cg.chunk, OP_JUMP_IF_FALSE, 0);

    _loop_push(cg);
    codegen_block(cg, node.body);
    let lc = _loop_pop(cg);
    _patch_all(cg, lc.continues, len(cg.chunk.instructions));

    chunk_write_op(cg.chunk, OP_GET_LOCAL, slot);
    let one_idx = chunk_add_constant(cg.chunk, 1);
    chunk_write_op(cg.chunk, OP_CONSTANT, one_idx);
    chunk_write_op(cg.chunk, OP_ADD, 0);
    chunk_write_op(cg.chunk, OP_SET_LOCAL, slot);
    chunk_write_op(cg.chunk, OP_JUMP, loop_start);

    let loop_end = len(cg.chunk.instructions);
    cg.chunk.instructions[exit_idx].operand = loop_end;
    _patch_all(cg, lc.breaks, loop_end);
}

// Fill omitted params (which arrive nil) with their default expression.
fn codegen_fill_defaults(inner_cg, params, param_slots) {
    let di = 0;
    while di < len(params) {
        let dflt = params[di]["default"];
        if dflt != nil {
            chunk_write_op(inner_cg.chunk, OP_GET_LOCAL, param_slots[di]);
            let nidx = chunk_add_constant(inner_cg.chunk, nil);
            chunk_write_op(inner_cg.chunk, OP_CONSTANT, nidx);
            chunk_write_op(inner_cg.chunk, OP_EQ, 0);
            let jf = len(inner_cg.chunk.instructions);
            chunk_write_op(inner_cg.chunk, OP_JUMP_IF_FALSE, 0);
            codegen_expr(inner_cg, dflt);
            chunk_write_op(inner_cg.chunk, OP_SET_LOCAL, param_slots[di]);
            inner_cg.chunk.instructions[jf]["operand"] = len(inner_cg.chunk.instructions);
        }
        di = di + 1;
    }
}

/// Compile an anonymous function literal `fn(params) { body }`. Unlike a fn
/// declaration, it leaves the closure VALUE on the operand stack (no global
/// binding) so it can be used as a map value, call argument, etc. Its params
/// are plain strings (parser.sapp::expr_fnlit), not {name,type,default} maps.
fn codegen_fnlit(cg, node) {
    let inner_cg = CodeGen();
    inner_cg.parent = cg;   // enables capturing enclosing vars as upvalues

    let k = 0;
    while k < len(node["params"]) {
        codegen_declare_local(inner_cg, node["params"][k]);
        k = k + 1;
    }

    codegen_block(inner_cg, node["body"]);

    // Implicit return nil at end
    if len(inner_cg.chunk.instructions) == 0 or
       inner_cg.chunk.instructions[len(inner_cg.chunk.instructions) - 1].op != OP_RETURN {
        let idx_nil = chunk_add_constant(inner_cg.chunk, nil);
        chunk_write_op(inner_cg.chunk, OP_CONSTANT, idx_nil);
        chunk_write_op(inner_cg.chunk, OP_RETURN, 0);
    }

    let fn_const_idx = chunk_add_constant(cg.chunk, map{
        arity: len(node["params"]),
        min_arity: len(node["params"]),   // fn-literal params have no defaults
        chunk: inner_cg.chunk,
        upvalues: inner_cg.upvalues,   // [{index, is_local}] for OP_CLOSURE capture
    });
    chunk_write_op(cg.chunk, OP_CLOSURE, fn_const_idx);
}

/// Compile a function definition
fn codegen_fn(cg, node) {
    // node = map{kind: "fn", name: "myfn", params: [...], body: [...]}
    let inner_cg = CodeGen();
    inner_cg.parent = cg;   // a nested named fn may capture enclosing vars too

    let param_slots = [];
    let k = 0;
    while k < len(node.params) {
        array_push(param_slots, codegen_declare_local(inner_cg, node.params[k].name));
        k = k + 1;
    }
    codegen_fill_defaults(inner_cg, node.params, param_slots);

    codegen_block(inner_cg, node.body);

    // Implicit return nil at end
    if len(inner_cg.chunk.instructions) == 0 or
       inner_cg.chunk.instructions[len(inner_cg.chunk.instructions) - 1].op != OP_RETURN {
        let idx_nil = chunk_add_constant(inner_cg.chunk, nil);
        chunk_write_op(inner_cg.chunk, OP_CONSTANT, idx_nil);
        chunk_write_op(inner_cg.chunk, OP_RETURN, 0);
    }

    // Required-argument count = leading params with no default (defaults trail).
    // Recorded so a non-self-hosted backend (e.g. the .pbck translator) can set
    // up default-fill; the self-hosted VM ignores it (the body fills defaults).
    let min_arity = 0;
    while min_arity < len(node.params) and node.params[min_arity].default == nil {
        min_arity = min_arity + 1;
    }

    // Store function as constant in parent chunk
    let fn_const_idx = chunk_add_constant(cg.chunk, map{
        arity: len(node["params"]),
        min_arity: min_arity,
        chunk: inner_cg.chunk,
        upvalues: inner_cg.upvalues,
    });

    chunk_write_op(cg.chunk, OP_CLOSURE, fn_const_idx);

    // Bind function name as a global (DEFINE_GLOBAL consumes the closure value).
    let name_idx = codegen_intern_global(cg, node.name);
    chunk_write_op(cg.chunk, OP_DEFINE_GLOBAL, name_idx);
}

/// Compile an expression statement
fn codegen_expr_stmt(cg, node) {
    let e = node.expr;
    // Assignment statement (parser wraps `x = v` as expr_stmt{ assign{name,value} }).
    // Evaluate the value and store it; SET_* consumes the value, so no POP.
    if is_map(e) and e.kind == "assign" {
        codegen_expr(cg, e.value);
        let r = codegen_resolve(cg, e.name);
        if r.kind == "local" { chunk_write_op(cg.chunk, OP_SET_LOCAL, r.index); }
        else if r.kind == "upvalue" { chunk_write_op(cg.chunk, OP_SET_UPVALUE, r.index); }
        else { chunk_write_op(cg.chunk, OP_SET_GLOBAL, r.index); }
        return;
    }
    // Index / member assignment: `a[i] = v` / `obj.k = v` (target is an index or
    // member expression; the obj chain may itself be nested).
    if is_map(e) and e.kind == "assign_to" {
        let tgt = e.target;
        if tgt.kind == "index" {
            codegen_expr(cg, tgt.obj);
            codegen_expr(cg, tgt.index);
            codegen_expr(cg, e.value);
            chunk_write_op(cg.chunk, OP_SET_INDEX, 0);
        } else if tgt.kind == "member" {
            codegen_expr(cg, tgt.obj);
            codegen_expr(cg, e.value);
            let name_idx = chunk_add_constant(cg.chunk, tgt.name);
            chunk_write_op(cg.chunk, OP_SET_ATTR, name_idx);
        }
        return;
    }
    codegen_expr(cg, node.expr);
    chunk_write_op(cg.chunk, OP_POP, 0);
}

/// Compile a print statement
fn codegen_print(cg, node) {
    codegen_expr(cg, node.value);
    chunk_write_op(cg.chunk, OP_PRINT, 0);
}

/// Compile a block. Accepts either a raw statement list (top level) or a
/// parser block node `{kind:"block", stmts:[...]}` (parse_block's return, used
/// for if/while/fn bodies).
fn codegen_block(cg, block) {
    let stmts = block;
    if is_map(block) { stmts = block.stmts; }

    codegen_begin_scope(cg);

    let i = 0;
    while i < len(stmts) {
        codegen_stmt(cg, stmts[i]);
        i = i + 1;
    }

    codegen_end_scope(cg);
}

/// Compile a single statement
fn codegen_stmt(cg, stmt) {
    if stmt == nil { return; }
    let kind = stmt.kind;
    
    if kind == "let" {
        if _at_module_top(cg) { codegen_global_let(cg, stmt); return; }
        codegen_local_let(cg, stmt);
        return;
    }
    if kind == "const" {
        if _at_module_top(cg) { codegen_global_let(cg, stmt); return; }
        codegen_local_let(cg, stmt);
        return;
    }
    if kind == "return" { codegen_return(cg, stmt); return; }
    if kind == "if" { codegen_if(cg, stmt); return; }
    if kind == "while" { codegen_while(cg, stmt); return; }
    if kind == "for" { codegen_for(cg, stmt); return; }
    if kind == "for_in" { codegen_for_in(cg, stmt); return; }
    if kind == "for_range" { codegen_for_range(cg, stmt); return; }
    if kind == "break" { codegen_break(cg); return; }
    if kind == "continue" { codegen_continue(cg); return; }
    if kind == "fn" { codegen_fn(cg, stmt); return; }
    if kind == "expr_stmt" { codegen_expr_stmt(cg, stmt); return; }
    if kind == "print" { codegen_print(cg, stmt); return; }
    if kind == "block" { codegen_block(cg, stmt.stmts); return; }
    if kind == "export" {
        // Record exported names; emitted as the `__exports__` global at module end
        // so importers can restrict a module's surface to its declared API.
        let names = stmt.names;
        let k = 0;
        while k < len(names) { array_push(cg.exports, names[k]); k = k + 1; }
        return;
    }
    if kind == "import" { return; }   // `import(...)` is handled as a call expr; the
                                      // bare `import("...")` statement form is a no-op here.
}

/// Top-level compilation: stmts → chunk
fn compile_stmts(stmts) {
    let cg = CodeGen();
    cg.is_module = true;   // top-level let/const become module globals
    codegen_block(cg, stmts);
    // If the module declared `export ...`, emit `__exports__ = [names]` as a final
    // global so importers can expose only the declared API (real `export`
    // semantics — matches the Rust frontend). No exports → no marker → importer
    // falls back to exposing all globals.
    if len(cg.exports) > 0 {
        let k = 0;
        while k < len(cg.exports) {
            let nidx = chunk_add_constant(cg.chunk, cg.exports[k]);
            chunk_write_op(cg.chunk, OP_CONSTANT, nidx);
            k = k + 1;
        }
        chunk_write_op(cg.chunk, OP_MAKE_ARRAY, len(cg.exports));
        let ex_idx = codegen_intern_global(cg, "__exports__");
        chunk_write_op(cg.chunk, OP_DEFINE_GLOBAL, ex_idx);
    }
    return cg.chunk;
}

// ── Disassembler ────────────────────────────────────────────────────────

// op_display(op) — debug name for ANY opcode this codegen can emit. The old
// disasm indexed a 31-entry array, so a chunk containing OP_MOD/PEEK/TRY/
// UPVALUE ops (31..40) CRASHED the disassembler with index-out-of-bounds.
fn op_display(op) {
    let names = map{};
    names[str(OP_CONSTANT)] = "OpConstant";       names[str(OP_ADD)] = "OpAdd";
    names[str(OP_SUB)] = "OpSub";                 names[str(OP_MUL)] = "OpMul";
    names[str(OP_DIV)] = "OpDiv";                 names[str(OP_EQ)] = "OpEq";
    names[str(OP_NOT_EQ)] = "OpNotEq";            names[str(OP_GT)] = "OpGt";
    names[str(OP_GE)] = "OpGe";                   names[str(OP_LT)] = "OpLt";
    names[str(OP_LE)] = "OpLe";                   names[str(OP_POP)] = "OpPop";
    names[str(OP_PRINT)] = "OpPrint";             names[str(OP_DEFINE_GLOBAL)] = "OpDefineGlobal";
    names[str(OP_GET_GLOBAL)] = "OpGetGlobal";    names[str(OP_SET_GLOBAL)] = "OpSetGlobal";
    names[str(OP_GET_LOCAL)] = "OpGetLocal";      names[str(OP_SET_LOCAL)] = "OpSetLocal";
    names[str(OP_CALL)] = "OpCall";               names[str(OP_RETURN)] = "OpReturn";
    names[str(OP_JUMP)] = "OpJump";               names[str(OP_JUMP_IF_FALSE)] = "OpJumpIfFalse";
    names[str(OP_JUMP_IF_TRUE)] = "OpJumpIfTrue"; names[str(OP_NOT)] = "OpNot";
    names[str(OP_CLOSURE)] = "OpClosure";         names[str(OP_MAKE_ARRAY)] = "OpMakeArray";
    names[str(OP_MAKE_MAP)] = "OpMakeMap";        names[str(OP_GET_INDEX)] = "OpGetIndex";
    names[str(OP_SET_INDEX)] = "OpSetIndex";      names[str(OP_GET_ATTR)] = "OpGetAttr";
    names[str(OP_SET_ATTR)] = "OpSetAttr";        names[str(OP_MOD)] = "OpMod";
    names[str(OP_LEN)] = "OpLen";                 names[str(OP_JUMP_IF_FALSE_PEEK)] = "OpJumpIfFalsePeek";
    names[str(OP_JUMP_IF_TRUE_PEEK)] = "OpJumpIfTruePeek";
    names[str(OP_TRY)] = "OpTry";                 names[str(OP_JUMP_IF_NIL_PEEK)] = "OpJumpIfNilPeek";
    names[str(OP_JUMP_IF_NOT_NIL_PEEK)] = "OpJumpIfNotNilPeek";
    names[str(OP_GET_UPVALUE)] = "OpGetUpvalue";  names[str(OP_SET_UPVALUE)] = "OpSetUpvalue";
    names[str(OP_THROW)] = "OpThrow";
    names[str(OP_ADD_LOCAL_CONST)] = "OpAddLocalConst";
    names[str(OP_ADD_LOCAL_LOCAL)] = "OpAddLocalLocal";
    return try names[str(op)] catch "Op?" + str(op);
}

fn disasm_chunk(chunk) {
    print("=== constants (" + str(len(chunk.constants)) + ") ===");
    let i = 0;
    while i < len(chunk.constants) {
        print("  [" + str(i) + "] " + str(chunk.constants[i]));
        i = i + 1;
    }

    print("=== bytecode ===");
    let j = 0;
    while j < len(chunk.instructions) {
        let inst = chunk.instructions[j];
        print("  " + str(j) + " " + op_display(inst.op) + " " + str(inst.operand));
        j = j + 1;
    }
}

