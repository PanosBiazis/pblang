// stdlib/compiler/ctranspile.sapp — a self-hosted pblang→C transpiler (seed of
// the freestanding/OS-dev backend, and a rust→pblang move off the Rust
// ctranspiler).
//
// Compiling pblang to C is the path to GC-free, no-libc, bootable code: C lowers
// to native, and a freestanding profile (`-ffreestanding -nostdlib`, intrinsics→
// inline asm) makes kernels possible — which the bytecode VM never can (it needs
// a GC + heap runtime). This is the MINIMAL core: a numeric subset (numbers as
// C `double`, matching pblang's f64) covering functions, arithmetic, comparison,
// if/while, and return — enough to transpile real straight-line/looping/recursive
// code. Hosted numeric closures, arrays, maps, and strings are supported;
// general GC-managed values and freestanding closure lifetimes come later.
//
//   let ct = import("stdlib/compiler/ctranspile.sapp");
//   ct.transpile("fn add(a, b) { return a + b; }")   // -> C source string
//
// Implemented entirely in pblang.

let _NL = "
";
let _SOURCE_LINKER = import("stdlib:source_inliner.sapp");
let _SOURCE = import("stdlib:compiler/checked_source.sapp");
let _OS = import("stdlib/os.sapp");
let _UUID = import("stdlib/uuid.sapp");

// ── Struct/map field-layout registry ────────────────────────────────────────────────
// Structs desugar to string-keyed maps; to lower `obj.field` to a fixed C offset we
// assign each field NAME a stable slot index the first time it's seen (in a map
// literal or a member access). A map literal allocates a block sized to its max slot
// and stores values at their field slots; member access reads that slot. Reset per
// transpile so each translation unit has a consistent layout. (Module-level mutable
// state — `_FIELDS` is a shared map.)
let _FIELDS = map{ slots: map{}, next: 0 };

fn _reset_fields() { _FIELDS.slots = map{}; _FIELDS.next = 0; }

fn _field_slot(name) {
    if map_has(_FIELDS.slots, name) { return _FIELDS.slots[name]; }
    let s = _FIELDS.next;
    _FIELDS.slots[name] = s;
    _FIELDS.next = s + 1;
    return s;
}

// ── Numeric codegen mode ─────────────────────────────────────────────────────────────
// Numbers lower to C `double` by default (matching pblang's f64). The INTEGER mode
// lowers them to `long` (a signed integer the width of a pointer: 4 bytes on -m32,
// 8 on 64-bit) instead — making kernel code completely FLOAT-RUNTIME-FREE: no SSE,
// no soft-float libgcc (__adddf3/__fixunsdfsi/…), smaller and faster objects, AND it
// lets GCC interrupt handlers (which require -mgeneral-regs-only — i.e. NO floating
// point — for a correct ISR prologue) link and boot. In int mode `/` is integer
// division and the long-casts already on bitwise/% ops are harmless no-ops, which is
// exactly what OS code (ports, masks, addresses, slot indices) wants. (Module-level
// mutable state — `_MODE` is a shared map, set/reset per transpile.)
let _MODE = map{ intmode: false, hosted: false };
fn _set_intmode(b) { _MODE.intmode = b; }
fn _set_hosted(b) { _MODE.hosted = b; }

// The C type a pblang number lowers to.
fn _numty() { if _MODE.intmode { return "long"; } return "double"; }
// Pointer-cast prefix, paste before a parenthesised address expression:
// "(double*)(u64)" in float mode, "(long*)(u64)" in int mode.
fn _pcast() { if _MODE.intmode { return "(long*)(u64)"; } return "(double*)(u64)"; }
// Number-value cast — turn a pointer/integer back into a pblang number value:
// "(double)(u64)" in float mode, "(long)(u64)" in int mode.
fn _vcast() { if _MODE.intmode { return "(long)(u64)"; } return "(double)(u64)"; }

fn _array_runtime(fail_name) {
    let nt = _numty();
    let index_invalid = "_pb_i < 0";
    let length_invalid = "_pb_n < 0";
    if not _MODE.intmode {
        index_invalid = "!(_pb_i >= 0) || _pb_i > (" + nt + ")((long)(~0UL >> 1)) || _pb_i != (" + nt + ")(long)_pb_i";
        length_invalid = "!(_pb_n >= 0) || _pb_n > (" + nt + ")((long)(~0UL >> 1)) || _pb_n != (" + nt + ")(long)_pb_n";
    }
    return "static inline " + nt + "* pb_array_checked(" + nt + " _pb_raw){" + _NL
        + "    if (_pb_raw == (" + nt + ")0) " + fail_name + "();" + _NL
        + "    return (" + nt + "*)(u64)_pb_raw;" + _NL + "}" + _NL
        + "static inline long pb_index_offset(" + nt + "* _pb_a, " + nt + " _pb_i){" + _NL
        + "    " + nt + " _pb_n = _pb_a[0];" + _NL
        + "    if (" + index_invalid + " || " + length_invalid + ") " + fail_name + "();" + _NL
        + "    long _pb_j = (long)_pb_i; if (_pb_j >= (long)_pb_n) " + fail_name + "();" + _NL
        + "    return _pb_j;" + _NL + "}" + _NL
        + "static inline long pb_index_offset_long(" + nt + "* _pb_a, long _pb_i){" + _NL
        + "    " + nt + " _pb_n = _pb_a[0];" + _NL
        + "    if (_pb_i < 0 || " + length_invalid + ") " + fail_name + "();" + _NL
        + "    if (_pb_i >= (long)_pb_n) " + fail_name + "(); return _pb_i;" + _NL + "}" + _NL
        + "static inline " + nt + " pb_array_len(" + nt + " _pb_raw){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); " + nt + " _pb_n = _pb_a[0];" + _NL
        + "    if (" + length_invalid + ") " + fail_name + "(); return _pb_n;" + _NL + "}" + _NL
        + "static inline " + nt + " pb_index_get(" + nt + " _pb_raw, " + nt + " _pb_i){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); long _pb_j = pb_index_offset(_pb_a, _pb_i); return _pb_a[1 + _pb_j];" + _NL + "}" + _NL
        + "static inline " + nt + " pb_index_get_long(" + nt + " _pb_raw, long _pb_i){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); long _pb_j = pb_index_offset_long(_pb_a, _pb_i); return _pb_a[1 + _pb_j];" + _NL + "}" + _NL
        + "static inline " + nt + " pb_index_get_known(" + nt + " _pb_raw, long _pb_i, long _pb_expected){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); if (_pb_i < 0 || _pb_i >= _pb_expected || _pb_a[0] != (" + nt + ")_pb_expected) " + fail_name + "(); return _pb_a[1 + _pb_i];" + _NL + "}" + _NL
        + "static inline void pb_index_set(" + nt + " _pb_raw, " + nt + " _pb_i, " + nt + " _pb_v){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); long _pb_j = pb_index_offset(_pb_a, _pb_i); _pb_a[1 + _pb_j] = _pb_v;" + _NL + "}" + _NL
        + "static inline void pb_index_set_long(" + nt + " _pb_raw, long _pb_i, " + nt + " _pb_v){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); long _pb_j = pb_index_offset_long(_pb_a, _pb_i); _pb_a[1 + _pb_j] = _pb_v;" + _NL + "}" + _NL
        + "static inline void pb_index_set_known(" + nt + " _pb_raw, long _pb_i, " + nt + " _pb_v, long _pb_expected){" + _NL
        + "    " + nt + "* _pb_a = pb_array_checked(_pb_raw); if (_pb_i < 0 || _pb_i >= _pb_expected || _pb_a[0] != (" + nt + ")_pb_expected) " + fail_name + "(); _pb_a[1 + _pb_i] = _pb_v;" + _NL + "}" + _NL + _NL;
}

// Narrow proof for the cheaper checked helper. Modulo lowering already emits a
// C long, while integer numeric mode makes every numeric expression integral.
// Other float-mode expressions retain finite and fractional validation.
fn _integral_index_expr(node) {
    if _MODE.intmode { return true; }
    return (try node.kind catch "") == "binary" and (try node.op catch "") == "%";
}

// ── C identifier safety ──────────────────────────────────────────────────────────────
// A pblang identifier may be a C RESERVED WORD (`int`, `void`, `default`, ...) —
// valid pblang, but emitting it verbatim produces C that won't compile. `_cid`
// maps any such name to a safe, stable C identifier (suffix `_pbkw`); all other
// names — including the generated runtime/intrinsic symbols (outb, kmalloc, ...),
// which are never C keywords — pass through unchanged, so calls to them still
// resolve. Applied at EVERY identifier emission site (decl, use, params, fn name,
// for-loop var) so a name and its references mangle identically.
let _CKEYWORDS = map{
    auto: true, break: true, case: true, char: true, const: true, continue: true,
    default: true, do: true, double: true, else: true, enum: true, extern: true,
    float: true, for: true, goto: true, if: true, inline: true, int: true,
    long: true, register: true, restrict: true, return: true, short: true,
    signed: true, sizeof: true, static: true, struct: true, switch: true,
    typedef: true, union: true, unsigned: true, void: true, volatile: true,
    while: true, _Bool: true, _Complex: true, _Imaginary: true, _Alignas: true,
    _Alignof: true, _Atomic: true, _Generic: true, _Noreturn: true,
    _Static_assert: true, _Thread_local: true
};
fn _cid(name) {
    // A hosted translation unit owns the C `main` symbol. Keep a user pblang
    // `fn main()` callable without colliding with the generated entry point.
    if _MODE.hosted and name == "main" { return "pb_main"; }
    if map_has(_CKEYWORDS, name) { return name + "_pbkw"; }
    return name;
}

fn _unsupported(kind, category) {
    throw "ctranspile: unsupported " + category + " kind: " + str(kind);
}

// Hosted C99 closure conversion. Closure values are small validated numeric
// handles, never raw C pointers. Each function literal becomes a generated C
// function plus a heap environment containing captures by value. Captured
// writes update that private environment, matching the self-hosted VM.
let _CLOSURE = map{ next: 0, nodes: [], top_fns: map{}, top_nodes: map{}, top_values: map{}, named_values: map{}, needs_runtime: false };
let _EMIT_CTX = map{ stack: [] };
let _ARRAY_CTX = map{ stack: [] };

fn _map_copy(source) {
    let out = map{};
    let ks = map_keys(source);
    let i = 0;
    while i < len(ks) { out[ks[i]] = source[ks[i]]; i = i + 1; }
    return out;
}

fn _closure_reset() {
    _CLOSURE.next = 0;
    _CLOSURE.nodes = [];
    _CLOSURE.top_fns = map{};
    _CLOSURE.top_nodes = map{};
    _CLOSURE.top_values = map{};
    _CLOSURE.named_values = map{};
    _CLOSURE.needs_runtime = false;
    _EMIT_CTX.stack = [];
    _ARRAY_CTX.stack = [];
}

fn _analysis_ctx(locals, outer, capture_set, captures) {
    return map{ locals: locals, outer: outer, capture_set: capture_set, captures: captures };
}

fn _analysis_child_scope(ctx) {
    return _analysis_ctx(_map_copy(ctx.locals), ctx.outer, ctx.capture_set, ctx.captures);
}

fn _capture_name(ctx, name) {
    if map_has(ctx.locals, name) { return; }
    if map_has(ctx.outer, name) and not map_has(ctx.capture_set, name) {
        ctx.capture_set[name] = true;
        array_push(ctx.captures, name);
    }
}

fn _analyze_expr(node, ctx) {
    if node == nil { return; }
    let k = try node.kind catch "";
    if k == "ident" {
        if not map_has(ctx.locals, node.name) and not map_has(ctx.outer, node.name)
            and map_has(_CLOSURE.top_fns, node.name) {
            _CLOSURE.named_values[node.name] = true;
            _CLOSURE.needs_runtime = true;
            return;
        }
        _capture_name(ctx, node.name);
        return;
    }
    if k == "number" or k == "string" or k == "bool" or k == "nil" { return; }
    if k == "binary" { _analyze_expr(node.left, ctx); _analyze_expr(node.right, ctx); return; }
    if k == "unary" { _analyze_expr(node.operand, ctx); return; }
    if k == "assign" { _capture_name(ctx, node.name); _analyze_expr(node.value, ctx); return; }
    if k == "assign_to" { _analyze_expr(node.target, ctx); _analyze_expr(node.value, ctx); return; }
    if k == "index" { _analyze_expr(node.obj, ctx); _analyze_expr(node.index, ctx); return; }
    if k == "member" { _analyze_expr(node.obj, ctx); return; }
    if k == "array" {
        let items = try node.items catch [];
        let i = 0; while i < len(items) { _analyze_expr(items[i], ctx); i = i + 1; }
        return;
    }
    if k == "map" {
        let entries = try node.entries catch [];
        let i = 0; while i < len(entries) { _analyze_expr(entries[i].value, ctx); i = i + 1; }
        return;
    }
    if k == "call" {
        let fk = try node.func.kind catch "";
        let callee_name = try node.func.name catch "";
        let lexical_call = fk != "ident" or map_has(ctx.locals, callee_name)
            or map_has(ctx.outer, callee_name) or map_has(_CLOSURE.top_values, callee_name);
        if lexical_call {
            _CLOSURE.needs_runtime = true;
            _analyze_expr(node.func, ctx);
        }
        let args = try node.args catch [];
        let i = 0; while i < len(args) { _analyze_expr(args[i], ctx); i = i + 1; }
        return;
    }
    if k == "if_expr" {
        _analyze_expr(node.cond, ctx);
        _analyze_block(try node.then catch nil, _analysis_child_scope(ctx));
        let els = try node.else catch nil;
        if els != nil {
            if (try els.kind catch "") == "if_expr" { _analyze_expr(els, ctx); }
            else { _analyze_block(els, _analysis_child_scope(ctx)); }
        }
        return;
    }
    if k == "fn_lit" { _analyze_fnlit(node, ctx); return; }
}

fn _analyze_stmt(node, ctx) {
    let k = try node.kind catch "";
    if k == "let" or k == "const" {
        _analyze_expr(try node.value catch nil, ctx);
        ctx.locals[node.name] = true;
        return;
    }
    if k == "return" or k == "print" { _analyze_expr(try node.value catch nil, ctx); return; }
    if k == "expr_stmt" { _analyze_expr(node.expr, ctx); return; }
    if k == "if" {
        _analyze_expr(node.cond, ctx);
        _analyze_block(try node.then catch nil, _analysis_child_scope(ctx));
        let elifs = try node.elifs catch [];
        let i = 0;
        while i < len(elifs) {
            _analyze_expr(try elifs[i].cond catch nil, ctx);
            let b = try elifs[i].block catch nil;
            if b == nil { b = try elifs[i].then catch nil; }
            _analyze_block(b, _analysis_child_scope(ctx));
            i = i + 1;
        }
        let els = try node.else catch nil;
        if els != nil { _analyze_block(els, _analysis_child_scope(ctx)); }
        return;
    }
    if k == "while" {
        _analyze_expr(node.cond, ctx);
        _analyze_block(try node.body catch nil, _analysis_child_scope(ctx));
        return;
    }
    if k == "for" {
        _analyze_expr(try node.end catch nil, ctx);
        let child = _analysis_child_scope(ctx);
        child.locals[node.name] = true;
        _analyze_block(try node.body catch nil, child);
        return;
    }
    if k == "fn" { throw "hosted C99: nested named functions require fn literals"; }
}

fn _analyze_block(block, ctx) {
    if block == nil { return; }
    let stmts = try block.stmts catch [];
    let i = 0;
    while i < len(stmts) { _analyze_stmt(stmts[i], ctx); i = i + 1; }
}

fn _analyze_fnlit(node, parent) {
    let existing = try node.__c99_closure_id catch nil;
    if existing != nil { return; }
    let id = _CLOSURE.next;
    _CLOSURE.next = id + 1;
    _CLOSURE.needs_runtime = true;
    node.__c99_closure_id = id;

    let outer = _map_copy(parent.outer);
    let pks = map_keys(parent.locals);
    let oi = 0; while oi < len(pks) { outer[pks[oi]] = true; oi = oi + 1; }
    let locals = map{};
    let params = try node.params catch [];
    let pi = 0; while pi < len(params) { locals[params[pi]] = true; pi = pi + 1; }
    let child = _analysis_ctx(locals, outer, map{}, []);
    _analyze_block(try node.body catch nil, child);
    node.__c99_captures = child.captures;
    array_push(_CLOSURE.nodes, node);

    // A grandchild may need a variable from the parent's own outer scope. The
    // parent must capture it too so it can construct the child environment.
    let ci = 0;
    while ci < len(child.captures) {
        let name = child.captures[ci];
        if not map_has(parent.locals, name) { _capture_name(parent, name); }
        ci = ci + 1;
    }
}

fn _analyze_program(stmts) {
    _closure_reset();
    let i = 0;
    while i < len(stmts) {
        let kind = try stmts[i].kind catch "";
        if kind == "fn" {
            _CLOSURE.top_fns[stmts[i].name] = true;
            _CLOSURE.top_nodes[stmts[i].name] = stmts[i];
        } elif kind == "let" or kind == "const" {
            _CLOSURE.top_values[stmts[i].name] = true;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(stmts) {
        if (try stmts[i].kind catch "") == "fn" {
            let locals = map{};
            let params = try stmts[i].params catch [];
            let p = 0; while p < len(params) { locals[params[p].name] = true; p = p + 1; }
            _analyze_block(try stmts[i].body catch nil, _analysis_ctx(locals, map{}, map{}, []));
        }
        i = i + 1;
    }
    let main_ctx = _analysis_ctx(map{}, map{}, map{}, []);
    i = 0;
    while i < len(stmts) {
        let k = try stmts[i].kind catch "";
        if k != "fn" and k != "struct" and k != "export" and k != "import" {
            _analyze_stmt(stmts[i], main_ctx);
        }
        i = i + 1;
    }
}

fn _ctx_push(bindings) {
    array_push(_EMIT_CTX.stack, bindings);
    let inherited = map{};
    if len(_ARRAY_CTX.stack) > 0 {
        inherited = _map_copy(_ARRAY_CTX.stack[len(_ARRAY_CTX.stack) - 1]);
    }
    array_push(_ARRAY_CTX.stack, inherited);
}
fn _ctx_pop() {
    if len(_EMIT_CTX.stack) > 0 { array_pop(_EMIT_CTX.stack); }
    if len(_ARRAY_CTX.stack) > 0 { array_pop(_ARRAY_CTX.stack); }
}
fn _ctx_current() {
    if len(_EMIT_CTX.stack) == 0 { return nil; }
    return _EMIT_CTX.stack[len(_EMIT_CTX.stack) - 1];
}
fn _ctx_has(name) {
    let current = _ctx_current();
    return current != nil and map_has(current, name);
}
fn _ctx_resolve(name) {
    let current = _ctx_current();
    if current != nil and map_has(current, name) { return current[name]; }
    return _cid(name);
}
fn _ctx_bind(name, expression) {
    let current = _ctx_current();
    if current != nil { current[name] = expression; }
}
fn _array_bind(name, value_node) {
    if len(_ARRAY_CTX.stack) == 0 { return; }
    let current = _ARRAY_CTX.stack[len(_ARRAY_CTX.stack) - 1];
    if (try value_node.kind catch "") == "array" {
        current[name] = len(try value_node.items catch []);
    } else { map_remove(current, name); }
}
fn _known_array_length(object_node) {
    if (try object_node.kind catch "") != "ident" or len(_ARRAY_CTX.stack) == 0 { return nil; }
    let current = _ARRAY_CTX.stack[len(_ARRAY_CTX.stack) - 1];
    if map_has(current, object_node.name) { return current[object_node.name]; }
    return nil;
}

// Value-producing C conditional expressions are intentionally limited to
// single expression statements. More complex value blocks need scope/result
// lowering; rejecting them is safer than silently changing their semantics.
fn _value_block_expr(block) {
    let stmts = try block.stmts catch [];
    if len(stmts) != 1 or (try stmts[0].kind catch "") != "expr_stmt" {
        throw "ctranspile: if-expression branch must contain exactly one value expression";
    }
    return transpile_expr(stmts[0].expr);
}

// ── Expressions → C ────────────────────────────────────────────────────────────────
fn transpile_expr(node) {
    if node == nil { return "0"; }
    let k = node.kind;
    if k == "number" { return str(node.value); }
    if k == "ident" {
        if not _ctx_has(node.name) and _MODE.hosted and map_has(_CLOSURE.named_values, node.name) {
            return "pb_named_value_" + _cid(node.name) + "()";
        }
        return _ctx_resolve(node.name);
    }
    if k == "bool" { if node.value { return "1"; } return "0"; }
    if k == "nil" { return "0"; }
    // Array literal → a length-prefixed block on the bump allocator: slot 0 holds
    // the length, slots 1.. the elements. Value is the block address (as double).
    // Uses a GCC statement-expression (available under -ffreestanding).
    if k == "array" {
        let items = try node.items catch [];
        let n = len(items);
        // Slots are sized 8 bytes (exact for double / 64-bit long; over-allocated but
        // self-consistent for 32-bit long, since reads & writes share the same type).
        let s = "({ " + _numty() + "* _a = " + _pcast() + "kmalloc(" + str((n + 1) * 8) + "); _a[0]=" + str(n) + ";";
        let i = 0;
        while i < n {
            s = s + " _a[" + str(i + 1) + "]=" + transpile_expr(items[i]) + ";";
            i = i + 1;
        }
        return s + " " + _vcast() + "_a; })";
    }
    // Ordinary indexing is checked in every supported backend. Raw pointer
    // indexing remains available only through explicit low-level intrinsics.
    if k == "index" {
        if _integral_index_expr(node.index) {
            let known_length = _known_array_length(node.obj);
            if known_length != nil {
                return "pb_index_get_known(" + transpile_expr(node.obj) + ", "
                    + transpile_expr(node.index) + ", " + str(known_length) + ")";
            }
            return "pb_index_get_long(" + transpile_expr(node.obj) + ", "
                + transpile_expr(node.index) + ")";
        }
        return "pb_index_get(" + transpile_expr(node.obj) + ", " + transpile_expr(node.index) + ")";
    }
    // Map/struct literal → a block on the allocator; each field stored at its
    // registered slot. (Structs desugar to these; `__struct` tags are stored too.)
    if k == "map" {
        let entries = try node.entries catch [];
        let maxslot = 0 - 1;
        let i = 0;
        while i < len(entries) {
            let slot = _field_slot(entries[i].key);
            if slot > maxslot { maxslot = slot; }
            i = i + 1;
        }
        let nslots = maxslot + 1;
        if nslots < 1 { nslots = 1; }
        let s = "({ " + _numty() + "* _m = " + _pcast() + "kmalloc(" + str(nslots * 8) + ");";
        let j = 0;
        while j < len(entries) {
            let slot = _field_slot(entries[j].key);
            s = s + " _m[" + str(slot) + "]=" + transpile_expr(entries[j].value) + ";";
            j = j + 1;
        }
        return s + " " + _vcast() + "_m; })";
    }
    // Member access `obj.field` → the field's fixed slot in the block.
    if k == "member" {
        return "(" + _pcast() + "(" + transpile_expr(node.obj) + "))[" + str(_field_slot(node.name)) + "]";
    }
    // String literal → a null-terminated char block on the bump allocator; value
    // is its address. Read bytes with peek8(addr + i); terminator is 0.
    if k == "string" {
        let v = node.value;
        let n = len(v);
        let s = "({ char* _s = (char*)(u64)kmalloc(" + str(n + 1) + ");";
        let i = 0;
        while i < n {
            s = s + " _s[" + str(i) + "]=" + str(strcharcodeat(v, i)) + ";";
            i = i + 1;
        }
        return s + " _s[" + str(n) + "]=0; " + _vcast() + "_s; })";
    }
    if k == "binary" {
        let op = node.op;
        // C `%` is integer-only. Literal non-zero divisors stay visible to the
        // C optimizer; dynamic hosted divisors use the checked helper so zero
        // and LONG_MIN%-1 fail closed instead of invoking C undefined behavior.
        if op == "%" {
            let left = transpile_expr(node.left); let right = transpile_expr(node.right);
            if (try node.right.kind catch "") == "number" {
                let divisor = try parse_number(node.right.value) catch nil;
                if divisor == nil { throw "ctranspile: invalid numeric modulo divisor"; }
                if divisor == 0 { throw "ctranspile: modulo by literal zero"; }
                if _MODE.intmode { return "(" + left + " % " + right + ")"; }
                return "((long)" + left + " % (long)" + right + ")";
            }
            if _MODE.hosted {
                if _MODE.intmode { return "pb_mod_checked(" + left + ", " + right + ")"; }
                return "pb_mod_checked((long)" + left + ", (long)" + right + ")";
            }
            return "((long)" + left + " % (long)" + right + ")";
        }
        // Map pblang logical keywords to C operators.
        if op == "and" { op = "&&"; }
        if op == "or" { op = "||"; }
        return "(" + transpile_expr(node.left) + " " + op + " " + transpile_expr(node.right) + ")";
    }
    if k == "unary" {
        if node.op == "-" { return "(-" + transpile_expr(node.operand) + ")"; }
        if node.op == "not" or node.op == "!" { return "(!" + transpile_expr(node.operand) + ")"; }
        return _unsupported(node.op, "unary operator");
    }
    if k == "assign" {
        return "(" + _ctx_resolve(node.name) + " = " + transpile_expr(node.value) + ")";
    }
    if k == "assign_to" {
        let target_kind = try node.target.kind catch "";
        if target_kind != "index" and target_kind != "member" {
            return _unsupported(target_kind, "assignment target");
        }
        return "(" + transpile_expr(node.target) + " = " + transpile_expr(node.value) + ")";
    }
    if k == "if_expr" {
        let yes = _value_block_expr(node.then);
        let no = "0";
        let els = try node.else catch nil;
        if els != nil {
            if (try els.kind catch "") == "if_expr" { no = transpile_expr(els); }
            else { no = _value_block_expr(els); }
        }
        return "(" + transpile_expr(node.cond) + " ? " + yes + " : " + no + ")";
    }
    if k == "fn_lit" {
        if not _MODE.hosted { throw "ctranspile: closures require the hosted C99 runtime"; }
        let id = try node.__c99_closure_id catch nil;
        if id == nil { throw "hosted C99: closure was not analyzed"; }
        let captures = try node.__c99_captures catch [];
        let cap_values = "0";
        if len(captures) > 0 {
            cap_values = "(const " + _numty() + "[]){";
            let ci = 0;
            while ci < len(captures) {
                if ci > 0 { cap_values = cap_values + ", "; }
                cap_values = cap_values + _ctx_resolve(captures[ci]);
                ci = ci + 1;
            }
            cap_values = cap_values + "}";
        }
        return "pb_closure_new(pb_lambda_" + str(id) + ", "
            + str(len(try node.params catch [])) + ", " + str(len(captures))
            + ", " + cap_values + ")";
    }
    if k == "call" {
        let fname = "";
        if (try node.func.kind catch "") == "ident" { fname = node.func.name; }
        let args = try node.args catch [];
        if fname == "import" {
            throw "ctranspile: imports require prior module resolution/inlining";
        }
        // Bitwise / modulo builtins lower to C operators (integers via long casts),
        // so bit-twiddling and masks transpile to real native ops — essential for
        // OS code (ports, flags, addresses).
        if fname == "bit_and" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " & (long)" + transpile_expr(args[1]) + ")"; }
        if fname == "bit_or" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " | (long)" + transpile_expr(args[1]) + ")"; }
        if fname == "bit_xor" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " ^ (long)" + transpile_expr(args[1]) + ")"; }
        if fname == "bit_shl" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " << (long)" + transpile_expr(args[1]) + ")"; }
        if fname == "bit_shr" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " >> (long)" + transpile_expr(args[1]) + ")"; }
        if fname == "bit_not" and len(args) == 1 { return "(~(long)" + transpile_expr(args[0]) + ")"; }
        if fname == "num_mod" and len(args) == 2 { return "((long)" + transpile_expr(args[0]) + " % (long)" + transpile_expr(args[1]) + ")"; }
        // len(arr) validates the encoded handle and length prefix.
        if fname == "len" and len(args) == 1 { return "pb_array_len(" + transpile_expr(args[0]) + ")"; }
        // addr_of("fn") → the address of a function as a number — needed to put an
        // interrupt handler (or any function) into an IDT gate from pblang.
        if fname == "addr_of" and len(args) == 1 and (try args[0].kind catch "") == "string" {
            return _vcast() + "&" + _cid(args[0].value);
        }
        // An identifier bound in the current lexical context is a numeric
        // closure handle. Everything else keeps the direct C call path used by
        // named pblang functions and OS intrinsics.
        let dynamic = fname == "" or _ctx_has(fname) or map_has(_CLOSURE.top_values, fname);
        if dynamic {
            if not _MODE.hosted { throw "ctranspile: dynamic calls require the hosted C99 runtime"; }
            // GNU99 statement expression fixes pblang's callee-first,
            // left-to-right argument evaluation instead of relying on C's
            // unspecified function-argument order.
            let s = "({ " + _numty() + " _pb_fn = " + transpile_expr(node.func) + ";";
            if len(args) == 0 { return s + " pb_closure_call(_pb_fn, 0, 0); })"; }
            s = s + " " + _numty() + " _pb_args[" + str(len(args)) + "];";
            let i = 0;
            while i < len(args) {
                s = s + " _pb_args[" + str(i) + "] = " + transpile_expr(args[i]) + ";";
                i = i + 1;
            }
            return s + " pb_closure_call(_pb_fn, " + str(len(args)) + ", _pb_args); })";
        }
        let s = _cid(fname) + "(";
        let i = 0;
        while i < len(args) {
            if i > 0 { s = s + ", "; }
            s = s + transpile_expr(args[i]);
            i = i + 1;
        }
        return s + ")";
    }
    return _unsupported(k, "expression");
}

// ── Statements → C (indented) ──────────────────────────────────────────────────────
fn _indent(n) {
    let s = "";
    let i = 0;
    while i < n { s = s + "    "; i = i + 1; }
    return s;
}

fn transpile_stmt(node, depth) {
    let pad = _indent(depth);
    let k = node.kind;
    if k == "let" or k == "const" {
        let value = transpile_expr(try node.value catch nil);
        let cname = _cid(node.name);
        _ctx_bind(node.name, cname);
        _array_bind(node.name, try node.value catch nil);
        return pad + _numty() + " " + cname + " = " + value + ";";
    }
    if k == "return" {
        let rv = try node.value catch nil;
        if rv == nil { return pad + "return;"; }   // bare return (void-safe for ISRs)
        return pad + "return " + transpile_expr(rv) + ";";
    }
    if k == "print" {
        if not _MODE.hosted { throw "ctranspile: print requires the hosted C99 profile"; }
        let value = try node.value catch nil;
        if value == nil { return pad + "fputc('\\n', stdout);"; }
        // Literal strings retain their exact bytes through the existing
        // allocator-backed string lowering. Other supported expressions are
        // numbers and use enough digits to round-trip an IEEE-754 double.
        if (try value.kind catch "") == "string" {
            return pad + "puts((const char*)(uintptr_t)(" + transpile_expr(value) + "));";
        }
        if _MODE.intmode { return pad + "printf(\"%ld\\n\", (long)(" + transpile_expr(value) + "));"; }
        return pad + "printf(\"%.17g\\n\", (double)(" + transpile_expr(value) + "));";
    }
    if k == "expr_stmt" {
        let e = node.expr;
        if is_map(e) and (try e.kind catch "") == "assign" {
            _array_bind(e.name, try e.value catch nil);
            return pad + _ctx_resolve(e.name) + " = " + transpile_expr(e.value) + ";";
        }
        // `arr[i] = v` — index store into a length-prefixed array block.
        if is_map(e) and (try e.kind catch "") == "assign_to" {
            let tgt = e.target;
            if (try tgt.kind catch "") == "index" {
                if _integral_index_expr(tgt.index) {
                    let known_length = _known_array_length(tgt.obj);
                    if known_length != nil {
                        return pad + "pb_index_set_known(" + transpile_expr(tgt.obj) + ", "
                            + transpile_expr(tgt.index) + ", " + transpile_expr(e.value)
                            + ", " + str(known_length) + ");";
                    }
                    return pad + "pb_index_set_long(" + transpile_expr(tgt.obj) + ", "
                        + transpile_expr(tgt.index) + ", " + transpile_expr(e.value) + ");";
                }
                return pad + "pb_index_set(" + transpile_expr(tgt.obj) + ", "
                    + transpile_expr(tgt.index) + ", " + transpile_expr(e.value) + ");";
            }
            // `obj.field = v` — member store into a struct/map block at its slot.
            if (try tgt.kind catch "") == "member" {
                return pad + "(" + _pcast() + "(" + transpile_expr(tgt.obj) + "))["
                    + str(_field_slot(tgt.name)) + "] = " + transpile_expr(e.value) + ";";
            }
            return _unsupported(try tgt.kind catch "", "assignment target");
        }
        return pad + transpile_expr(e) + ";";
    }
    if k == "if" {
        let s = pad + "if (" + transpile_expr(node.cond) + ") {" + _NL;
        s = s + transpile_block(try node.then catch nil, depth + 1);
        s = s + pad + "}";
        // else-if chain
        let elifs = try node.elifs catch nil;
        if elifs != nil {
            let ei = 0;
            while ei < len(elifs) {
                let ec = try elifs[ei].cond catch nil;
                let eb = try elifs[ei].block catch nil;
                if eb == nil { eb = try elifs[ei].then catch nil; }
                s = s + " else if (" + transpile_expr(ec) + ") {" + _NL + transpile_block(eb, depth + 1) + pad + "}";
                ei = ei + 1;
            }
        }
        let els = try node.else catch nil;
        if els != nil {
            s = s + " else {" + _NL + transpile_block(els, depth + 1) + pad + "}";
        }
        return s;
    }
    if k == "for" {
        // `for i N { body }` iterates i in 0..N (exclusive) → a counted C for-loop.
        let iv = _cid(node.name);
        let s = pad + "for (" + _numty() + " " + iv + " = 0; " + iv + " < ("
            + transpile_expr(try node.end catch nil) + "); " + iv + " = " + iv + " + 1) {" + _NL;
        s = s + transpile_block(try node.body catch nil, depth + 1);
        s = s + pad + "}";
        return s;
    }
    if k == "while" {
        let s = pad + "while (" + transpile_expr(node.cond) + ") {" + _NL;
        s = s + transpile_block(try node.body catch nil, depth + 1);
        s = s + pad + "}";
        return s;
    }
    if k == "break" { return pad + "break;"; }
    if k == "continue" { return pad + "continue;"; }
    return _unsupported(k, "statement");
}

fn transpile_block(blk, depth) {
    if blk == nil { return ""; }
    let stmts = try blk.stmts catch nil;
    if stmts == nil { return ""; }
    let parent = _ctx_current();
    if parent == nil { _ctx_push(map{}); }
    else { _ctx_push(_map_copy(parent)); }
    let out = "";
    let i = 0;
    while i < len(stmts) {
        out = out + transpile_stmt(stmts[i], depth) + _NL;
        i = i + 1;
    }
    _ctx_pop();
    return out;
}

// ── Function → C (params and return as double) ──────────────────────────────────────
fn transpile_fn(node) {
    let name = node.name;
    // INTERRUPT HANDLERS: a pblang function named `isr...` (interrupt service
    // routine) is emitted as a GCC interrupt handler — `__attribute__((interrupt))`
    // void NAME(void* frame) — so it gets the correct prologue/epilogue and `iret`.
    // This is the language feature that makes IDT/exception/IRQ handlers writable
    // in pblang; the body uses the OS intrinsics (inb/outb/poke/peek) as usual.
    if str_starts_with(name, "isr") {
        _ctx_push(map{});
        let s = "__attribute__((interrupt)) void " + _cid(name) + "(void* _frame) {" + _NL;
        s = s + transpile_block(try node.body catch nil, 1);
        s = s + "}" + _NL;
        _ctx_pop();
        return s;
    }
    let bindings = map{};
    let s = _numty() + " " + _cid(name) + "(";
    let params = try node.params catch [];
    let i = 0;
    while i < len(params) {
        if i > 0 { s = s + ", "; }
        s = s + _numty() + " " + _cid(params[i].name);
        bindings[params[i].name] = _cid(params[i].name);
        i = i + 1;
    }
    s = s + ") {" + _NL;
    _ctx_push(bindings);
    s = s + transpile_block(try node.body catch nil, 1);
    // Falling off a pblang function yields nil; numeric C profiles represent
    // nil as zero. Emitting this explicitly avoids C undefined behavior.
    s = s + "    return 0;" + _NL;
    s = s + "}" + _NL;
    _ctx_pop();
    return s;
}

// _proto_fn(node) — a C forward declaration for a function, so functions may call
// each other in ANY order (and recurse mutually) without C's "implicit declaration"
// error. Mirrors transpile_fn's signature under the current numeric mode.
fn _proto_fn(node) {
    let name = node.name;
    if str_starts_with(name, "isr") {
        return "__attribute__((interrupt)) void " + _cid(name) + "(void* _frame);" + _NL;
    }
    let s = _numty() + " " + _cid(name) + "(";
    let params = try node.params catch [];
    let i = 0;
    while i < len(params) {
        if i > 0 { s = s + ", "; }
        s = s + _numty() + " " + _cid(params[i].name);
        i = i + 1;
    }
    return s + ");" + _NL;
}

fn _lambda_proto(node) {
    return "static " + _numty() + " pb_lambda_" + str(node.__c99_closure_id)
        + "(pb_closure* _cl, const " + _numty() + "* _args, size_t _argc);" + _NL;
}

fn _lambda_definition(node) {
    let captures = try node.__c99_captures catch [];
    let params = try node.params catch [];
    let bindings = map{};
    let i = 0;
    while i < len(captures) {
        bindings[captures[i]] = "_cl->caps[" + str(i) + "]";
        i = i + 1;
    }
    i = 0;
    while i < len(params) {
        bindings[params[i]] = "_args[" + str(i) + "]";
        i = i + 1;
    }
    _ctx_push(bindings);
    let out = "static " + _numty() + " pb_lambda_" + str(node.__c99_closure_id)
        + "(pb_closure* _cl, const " + _numty() + "* _args, size_t _argc) {" + _NL;
    out = out + "    (void)_argc;" + _NL;
    out = out + transpile_block(try node.body catch nil, 1);
    out = out + "    return 0;" + _NL + "}" + _NL;
    _ctx_pop();
    return out;
}

fn _named_adapter_proto(node) {
    let safe = _cid(node.name);
    return "static " + _numty() + " pb_named_adapter_" + safe
        + "(pb_closure* _cl, const " + _numty() + "* _args, size_t _argc);" + _NL
        + "static " + _numty() + " pb_named_value_" + safe + "(void);" + _NL;
}

fn _named_adapter_definition(node) {
    let safe = _cid(node.name);
    let params = try node.params catch [];
    let out = "static " + _numty() + " pb_named_adapter_" + safe
        + "(pb_closure* _cl, const " + _numty() + "* _args, size_t _argc) {" + _NL
        + "    (void)_cl; (void)_argc;" + _NL
        + "    return " + safe + "(";
    let i = 0;
    while i < len(params) {
        if i > 0 { out = out + ", "; }
        out = out + "_args[" + str(i) + "]";
        i = i + 1;
    }
    out = out + ");" + _NL + "}" + _NL;
    out = out + "static " + _numty() + " pb_named_value_" + safe + "(void) {" + _NL
        + "    static " + _numty() + " handle = 0;" + _NL
        + "    if (!handle) handle = pb_closure_new(pb_named_adapter_" + safe + ", "
        + str(len(params)) + ", 0, 0);" + _NL
        + "    return handle;" + _NL + "}" + _NL;
    return out;
}

// _emit_fns(source, preamble) — the shared core: parse `source`, emit `preamble`,
// then forward declarations for every top-level `fn`, then each `fn` transpiled under
// the CURRENT numeric mode. Callers set the mode (and compute the preamble under it)
// before calling. Non-fn top-level statements are dropped (a freestanding unit is
// functions).
fn _emit_fns(source, preamble) {
    let ast = _SOURCE.parse_source(source);
    _reset_fields();   // fresh field-layout per admitted translation unit
    let stmts = try ast.stmts catch [];
    let out = preamble;
    // forward declarations (any call order / mutual recursion)
    let i = 0;
    while i < len(stmts) {
        if stmts[i].kind == "fn" { out = out + _proto_fn(stmts[i]); }
        elif stmts[i].kind != "struct" and stmts[i].kind != "export" {
            throw "ctranspile: freestanding profile rejects top-level " + str(stmts[i].kind);
        }
        i = i + 1;
    }
    out = out + _NL;
    // definitions
    i = 0;
    while i < len(stmts) {
        if stmts[i].kind == "fn" { out = out + transpile_fn(stmts[i]) + _NL; }
        i = i + 1;
    }
    return out;
}

// transpile(source) — parse pblang and emit a C translation unit (the supported
// numeric subset, numbers as `double`). Returns the C source string.
fn transpile(source) {
    _set_intmode(false);
    _set_hosted(false);
    let out = nil; let failed = false;
    try { out = _emit_fns(source, "/* generated by stdlib/compiler/ctranspile.sapp (pblang -> C, numeric subset) */" + _NL); }
    catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "ctranspile: freestanding translation rejected source"; }
    return out;
}

// ── Hosted C99 profile ─────────────────────────────────────────────────────────────
// A complete userspace translation unit: libc-backed allocation, deterministic
// numeric/string printing, all top-level functions, and a generated C `main` for
// top-level pblang statements. This is intentionally separate from the freestanding
// and kernel profiles, which must never acquire a libc dependency.
fn _closure_runtime() {
    if not _CLOSURE.needs_runtime { return ""; }
    let nt = _numty();
    let handle_guard = "_pb_closure_count >= (size_t)9007199254740991ULL";
    if _MODE.intmode { handle_guard = "_pb_closure_count >= (size_t)LONG_MAX"; }
    return "typedef struct pb_closure pb_closure;" + _NL
        + "typedef " + nt + " (*pb_closure_code)(pb_closure*, const " + nt + "*, size_t);" + _NL
        + "struct pb_closure { pb_closure_code code; size_t arity; size_t capture_count; " + nt + " caps[]; };" + _NL
        + "static pb_closure** _pb_closure_table = 0;" + _NL
        + "static size_t _pb_closure_count = 0, _pb_closure_capacity = 0;" + _NL
        + "static int _pb_closure_cleanup_registered = 0;" + _NL
        + "static void pb_closure_fail(const char* why){ fputs(why, stderr); fputc('\\n', stderr); exit(72); }" + _NL
        + "static void pb_closure_cleanup(void){" + _NL
        + "    for (size_t i = 0; i < _pb_closure_count; ++i) free(_pb_closure_table[i]);" + _NL
        + "    free(_pb_closure_table); _pb_closure_table = 0; _pb_closure_count = 0; _pb_closure_capacity = 0;" + _NL
        + "}" + _NL
        + "static " + nt + " pb_closure_new(pb_closure_code code, size_t arity, size_t capture_count, const " + nt + "* captures){" + _NL
        + "    if (!code || (capture_count && !captures)) pb_closure_fail(\"pblang: invalid closure construction\");" + _NL
        + "    if (capture_count > (SIZE_MAX - sizeof(pb_closure)) / sizeof(" + nt + ")) pb_closure_fail(\"pblang: closure capture overflow\");" + _NL
        + "    if (" + handle_guard + ") pb_closure_fail(\"pblang: closure handle space exhausted\");" + _NL
        + "    if (!_pb_closure_cleanup_registered) { if (atexit(pb_closure_cleanup) != 0) pb_closure_fail(\"pblang: closure cleanup registration failed\"); _pb_closure_cleanup_registered = 1; }" + _NL
        + "    size_t bytes = sizeof(pb_closure) + capture_count * sizeof(" + nt + ");" + _NL
        + "    pb_closure* closure = (pb_closure*)(uintptr_t)kmalloc((" + nt + ")bytes);" + _NL
        + "    closure->code = code; closure->arity = arity; closure->capture_count = capture_count;" + _NL
        + "    for (size_t i = 0; i < capture_count; ++i) closure->caps[i] = captures[i];" + _NL
        + "    if (_pb_closure_count == _pb_closure_capacity) {" + _NL
        + "        size_t next = _pb_closure_capacity ? _pb_closure_capacity * 2 : 16;" + _NL
        + "        if (next < _pb_closure_capacity || next > SIZE_MAX / sizeof(*_pb_closure_table)) pb_closure_fail(\"pblang: closure table overflow\");" + _NL
        + "        void* grown = realloc(_pb_closure_table, next * sizeof(*_pb_closure_table));" + _NL
        + "        if (!grown) pb_closure_fail(\"pblang: closure table allocation failed\");" + _NL
        + "        _pb_closure_table = (pb_closure**)grown; _pb_closure_capacity = next;" + _NL
        + "    }" + _NL
        + "    _pb_closure_table[_pb_closure_count++] = closure;" + _NL
        + "    return (" + nt + ")_pb_closure_count;" + _NL
        + "}" + _NL
        + "static " + nt + " pb_closure_call(" + nt + " raw, size_t argc, const " + nt + "* args){" + _NL
        + "    if (!(raw >= (" + nt + ")1) || raw > (" + nt + ")_pb_closure_count || raw != (" + nt + ")(size_t)raw) pb_closure_fail(\"pblang: invalid closure handle\");" + _NL
        + "    pb_closure* closure = _pb_closure_table[(size_t)raw - 1];" + _NL
        + "    if (!closure || !closure->code || closure->arity != argc || (argc && !args)) pb_closure_fail(\"pblang: closure arity mismatch\");" + _NL
        + "    return closure->code(closure, args, argc);" + _NL
        + "}" + _NL + _NL;
}

fn hosted_preamble() {
    let nt = _numty();
    let allocation_guard = "n < 0 || (u64)n > (u64)SIZE_MAX";
    if not _MODE.intmode { allocation_guard = "!(n >= 0) || (long double)n > (long double)SIZE_MAX"; }
    return "/* generated by pblang self-hosted C99 backend (hosted numeric subset) */" + _NL
        + "#include <stdint.h>" + _NL
        + "#include <stddef.h>" + _NL
        + "#include <limits.h>" + _NL
        + "#include <stdio.h>" + _NL
        + "#include <stdlib.h>" + _NL
        + "typedef uintptr_t u64;" + _NL
        + "static inline long pb_mod_checked(long a, long b){" + _NL
        + "    if (b == 0 || (a == LONG_MIN && b == -1)) { fputs(\"pblang: invalid modulo\\n\", stderr); exit(73); }" + _NL
        + "    return a % b;" + _NL
        + "}" + _NL
        + "static " + nt + " kmalloc(" + nt + " n){" + _NL
        + "    if (" + allocation_guard + ") { fputs(\"pblang: invalid allocation\\n\", stderr); exit(70); }" + _NL
        + "    size_t z = (size_t)n; void* p = calloc(z ? z : 1, 1);" + _NL
        + "    if (!p) { fputs(\"pblang: out of memory\\n\", stderr); exit(71); }" + _NL
        + "    return (" + nt + ")(uintptr_t)p;" + _NL
        + "}" + _NL
        + "static void pb_index_fail(void){ fputs(\"pblang: array index out of bounds\\n\", stderr); exit(74); }" + _NL
        + _array_runtime("pb_index_fail")
        + _closure_runtime();
}

fn _validate_hosted_symbols(stmts) {
    let seen = map{};
    let reserved = map{
        u64: true, kmalloc: true, pb_mod_checked: true, pb_array_checked: true,
        pb_index_offset: true, pb_index_offset_long: true, pb_array_len: true,
        pb_index_get: true, pb_index_get_long: true, pb_index_get_known: true,
        pb_index_set: true, pb_index_set_long: true, pb_index_set_known: true,
        pb_index_fail: true, pb_closure: true, pb_closure_fail: true,
        pb_closure_cleanup: true, pb_closure_new: true, pb_closure_call: true
    };
    let i = 0;
    while i < len(stmts) {
        let kind = try stmts[i].kind catch "";
        if kind == "fn" or kind == "let" or kind == "const" {
            let source_name = stmts[i].name;
            let cname = _cid(source_name);
            if map_has(seen, cname) {
                throw "hosted C99: top-level C identifier collision between " + seen[cname] + " and " + source_name;
            }
            if map_has(reserved, cname) or str_starts_with(cname, "_pb_")
                or str_starts_with(cname, "pb_lambda_")
                or str_starts_with(cname, "pb_named_adapter_")
                or str_starts_with(cname, "pb_named_value_") {
                throw "hosted C99: top-level name conflicts with generated runtime: " + source_name;
            }
            seen[cname] = source_name;
        }
        i = i + 1;
    }
}

fn _emit_hosted(source) { return _emit_hosted_ast(_SOURCE.parse_source(source)); }

fn _emit_hosted_ast(ast) {
    _reset_fields();
    let stmts = try ast.stmts catch [];
    _analyze_program(stmts);
    _validate_hosted_symbols(stmts);
    let out = hosted_preamble();
    let has_pb_main = false;
    let pb_main_arity = 0;

    let i = 0;
    // Hosted pblang top-level bindings have translation-unit lifetime. They are
    // declared before functions so module and ordinary functions can read/write
    // them, then initialized in source order from generated main.
    while i < len(stmts) {
        let kind = try stmts[i].kind catch "";
        if kind == "let" or kind == "const" {
            out = out + "static " + _numty() + " " + _cid(stmts[i].name) + " = 0;" + _NL;
        }
        i = i + 1;
    }
    if len(map_keys(_CLOSURE.top_values)) > 0 { out = out + _NL; }
    i = 0;
    while i < len(stmts) {
        if stmts[i].kind == "fn" {
            out = out + _proto_fn(stmts[i]);
            if stmts[i].name == "main" {
                has_pb_main = true;
                pb_main_arity = len(try stmts[i].params catch []);
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < len(_CLOSURE.nodes) {
        out = out + _lambda_proto(_CLOSURE.nodes[i]);
        i = i + 1;
    }
    i = 0;
    while i < len(stmts) {
        if (try stmts[i].kind catch "") == "fn" and map_has(_CLOSURE.named_values, stmts[i].name) {
            out = out + _named_adapter_proto(stmts[i]);
        }
        i = i + 1;
    }
    out = out + _NL;
    i = 0;
    while i < len(_CLOSURE.nodes) {
        out = out + _lambda_definition(_CLOSURE.nodes[i]) + _NL;
        i = i + 1;
    }
    i = 0;
    while i < len(stmts) {
        if (try stmts[i].kind catch "") == "fn" and map_has(_CLOSURE.named_values, stmts[i].name) {
            out = out + _named_adapter_definition(stmts[i]) + _NL;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(stmts) {
        if stmts[i].kind == "fn" { out = out + transpile_fn(stmts[i]) + _NL; }
        i = i + 1;
    }

    let top_count = 0;
    out = out + "int main(void) {" + _NL;
    let global_bindings = map{};
    let global_names = map_keys(_CLOSURE.top_values);
    i = 0;
    while i < len(global_names) {
        global_bindings[global_names[i]] = _cid(global_names[i]);
        i = i + 1;
    }
    _ctx_push(global_bindings);
    i = 0;
    while i < len(stmts) {
        let kind = stmts[i].kind;
        if kind == "import" { throw "hosted C99: imports require prior module resolution/inlining"; }
        if kind == "let" or kind == "const" {
            out = out + "    " + _cid(stmts[i].name) + " = "
                + transpile_expr(try stmts[i].value catch nil) + ";" + _NL;
            top_count = top_count + 1;
        } elif kind != "fn" and kind != "struct" and kind != "export" {
            out = out + transpile_stmt(stmts[i], 1) + _NL;
            top_count = top_count + 1;
        }
        i = i + 1;
    }
    if top_count == 0 and has_pb_main {
        if pb_main_arity != 0 { throw "hosted C99: fn main must have zero parameters"; }
        out = out + "    return (int)pb_main();" + _NL;
    } else {
        out = out + "    return 0;" + _NL;
    }
    _ctx_pop();
    return out + "}" + _NL;
}

// transpile_program(source) — complete hosted C99 source, including `main`.
fn transpile_program(source) {
    _set_intmode(false);
    _set_hosted(true);
    let out = nil; let failed = false;
    try { out = _emit_hosted(source); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "hosted C99: translation rejected source"; }
    return out;
}

// Explicit integer-specialized hosted mode. It is never selected implicitly:
// division and non-integral values differ from normal f64 pblang semantics.
fn transpile_program_int(source) {
    _set_intmode(true);
    _set_hosted(true);
    let out = nil; let failed = false;
    try { out = _emit_hosted(source); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "hosted C99 integer: translation rejected source"; }
    return out;
}

// Explicit local single-source compilation. Budget selection never changes the
// strict default API or checked module-linking policy.
fn transpile_program_local(source, budget = nil, numeric = "float") {
    if numeric != "float" and numeric != "integer" { throw "local C99: invalid numeric profile"; }
    let ast = _SOURCE.parse_local_source(source, budget);
    _set_intmode(numeric == "integer"); _set_hosted(true);
    let out = try _emit_hosted_ast(ast) catch nil;
    _set_hosted(false); _set_intmode(false);
    if out == nil { throw "local C99: translation rejected source"; }
    return out;
}

// Resolve an immutable virtual project snapshot before hosted C99 lowering.
// Module top-level values use the same translation-unit storage and ordered
// initialization as ordinary hosted source. Linking remains an in-memory,
// capability-free operation; C lowering happens only after a successful link.
fn link_program(source, modules, options = nil) {
    let linked = _SOURCE_LINKER.link_modules(source, modules, options);
    return linked;
}

fn _link_summary(linked) {
    return map{ modules: linked.modules, module_order: linked.module_order,
        module_bytes: linked.module_bytes, input_bytes: linked.input_bytes,
        supplied_bytes: linked.supplied_bytes, output_bytes: linked.output_bytes,
        entry_path: linked.entry_path, namespace: linked.namespace, limits: linked.limits };
}

fn _compile_linked(source, modules, options) {
    let numeric = _option(options, "numeric", "float");
    if numeric != "float" and numeric != "integer" {
        return map{ ok: false, reason: "unknown numeric profile" };
    }
    let linked = try _SOURCE_LINKER.link_modules_checked(source, modules, options) catch nil;
    if linked == nil { return map{ ok: false, reason: "invalid checked link options" }; }
    if not linked.ok { return linked; }
    let ast = try _SOURCE.parse_linked_source(linked.source, linked.limits.max_linked_source_bytes) catch nil;
    if ast == nil { return map{ ok: false, reason: "C99 translation rejected linked source" }; }
    _set_intmode(numeric == "integer"); _set_hosted(true);
    let artifact = try _emit_hosted_ast(ast) catch nil;
    _set_hosted(false); _set_intmode(false);
    if artifact == nil { return map{ ok: false, reason: "C99 translation rejected linked source" }; }
    return map{ ok: true, source: artifact, linked: linked };
}

fn transpile_program_linked(source, modules, options = nil) {
    let compiled = _compile_linked(source, modules, options);
    if not compiled.ok { return compiled; }
    return map{ ok: true, source: compiled.source, link: _link_summary(compiled.linked) };
}

fn _option(options, key, fallback) {
    if options == nil or not is_map(options) or not map_has(options, key) { return fallback; }
    return options[key];
}

fn _bool_option(options, key) {
    let value = _option(options, key, false);
    if type(value) != "bool" { return false; }
    return value;
}

fn _safe_build_path(path) {
    if type(path) != "string" or len(path) == 0 { return false; }
    // c_path is passed in compiler option position. A leading dash would be
    // interpreted as an option even though process execution is argv-only.
    if str_starts_with(path, "-") { return false; }
    let i = 0;
    while i < len(path) {
        let c = strcharcodeat(path, i);
        if c == 0 or c == 10 or c == 13 { return false; }
        i = i + 1;
    }
    return true;
}

fn _compiler_works(name) {
    if not _safe_build_path(name) { return false; }
    let r = try proc_spawn_wait(name, ["--version"]) catch nil;
    return r != nil and (try r.exit_code catch 1) == 0;
}

// find_c_compiler(preferred) — exact executable/path only; no shell fragments.
fn find_c_compiler(preferred = nil) {
    if preferred != nil { if _compiler_works(preferred) { return preferred; } return nil; }
    let cc = try env_get("CC") catch nil;
    if cc != nil and _compiler_works(cc) { return cc; }
    let candidates = ["cc", "gcc", "clang"];
    let i = 0;
    while i < len(candidates) {
        if _compiler_works(candidates[i]) { return candidates[i]; }
        i = i + 1;
    }
    return nil;
}

fn _compile_args(profile, c_path, output, aggressive) {
    let args = ["-std=gnu99"];
    array_push(args, "-Werror=implicit-function-declaration");
    array_push(args, "-Werror=return-type");
    if profile == "size" {
        array_push(args, "-Os");
        if aggressive {
            array_push(args, "-flto"); array_push(args, "-ffunction-sections"); array_push(args, "-fdata-sections");
            array_push(args, "-Wl,--gc-sections"); array_push(args, "-s");
        }
    } elif profile == "portable" {
        array_push(args, "-O2");
    } else {
        array_push(args, "-O3");
        if aggressive { array_push(args, "-flto"); array_push(args, "-fomit-frame-pointer"); }
    }
    array_push(args, "-DNDEBUG");
    array_push(args, c_path);
    array_push(args, "-o");
    array_push(args, output);
    return args;
}

// build_program(source, output, options) — one-call pblang -> optimized native
// executable through the pblang-written C99 lowering. Process execution is argv-only.
// options: {profile:"speed"|"size"|"portable", numeric:"float"|"integer",
//           compiler, keep_c, c_path}. Integer mode is explicit because `/` differs.
fn build_program(source, output, options = nil) {
    if not _safe_build_path(output) { return map{ ok: false, error: "invalid output path" }; }
    let profile = _option(options, "profile", "speed");
    if profile != "speed" and profile != "size" and profile != "portable" {
        return map{ ok: false, error: "unknown build profile: " + str(profile) };
    }
    let c_path = _option(options, "c_path", output + ".c");
    if not _safe_build_path(c_path) { return map{ ok: false, error: "invalid C output path" }; }
    let numeric = _option(options, "numeric", "float");
    if numeric != "float" and numeric != "integer" {
        return map{ ok: false, error: "unknown numeric profile: " + str(numeric) };
    }
    let linked = nil; let build_source = source;
    let modules = _option(options, "modules", nil);
    let admission = _option(options, "admission", "strict");
    if admission != "strict" and admission != "local" { return map{ ok: false, error: "invalid source admission profile" }; }
    if admission == "local" and modules != nil { return map{ ok: false, error: "local admission requires a single source; use checked module linking for snapshots" }; }
    if admission == "strict" and is_map(options) and map_has(options, "source_budget") {
        return map{ ok: false, error: "source_budget requires local admission" };
    }
    let t0 = now_ms();
    let c_source = nil;
    if modules != nil {
        let compiled = _compile_linked(source, modules, options);
        if not compiled.ok { return map{ ok: false, error: "module linking or translation failed", reason: compiled.reason }; }
        linked = compiled.linked; build_source = linked.source; c_source = compiled.source;
    } elif admission == "local" {
        c_source = try transpile_program_local(source, _option(options, "source_budget", nil), numeric) catch nil;
    } elif numeric == "integer" { c_source = try transpile_program_int(source) catch nil; }
    else { c_source = try transpile_program(source) catch nil; }
    if c_source == nil {
        return map{ ok: false, error: "C99 translation rejected unsupported or invalid source" };
    }
    let transpile_ms = now_ms() - t0;
    let compiler = find_c_compiler(_option(options, "compiler", nil));
    if compiler == nil { return map{ ok: false, error: "no usable C99 compiler found" }; }
    let wrote = try fs_write(c_path, c_source) catch false;
    if type(wrote) == "bool" and not wrote {
        return map{ ok: false, error: "could not write generated C", c_path: c_path };
    }

    let c0 = now_ms();
    let args = _compile_args(profile, c_path, output, profile != "portable");
    let result = try proc_spawn_wait(compiler, args) catch nil;
    let fallback = false;
    if result == nil or (try result.exit_code catch 1) != 0 {
        fallback = profile != "portable";
        if fallback { result = try proc_spawn_wait(compiler, _compile_args("portable", c_path, output, false)) catch nil; }
    }
    let compile_ms = now_ms() - c0;
    let keep_c = _bool_option(options, "keep_c");
    if not keep_c { try fs_remove(c_path) catch nil; }
    if result == nil or (try result.exit_code catch 1) != 0 {
        try fs_remove(output) catch nil;
        return map{ ok: false, error: "C99 compiler failed", compiler: compiler,
            exit_code: try result.exit_code catch 0 - 1, stderr: try result.stderr catch "",
            transpile_ms: transpile_ms, compile_ms: compile_ms, c_path: c_path, kept_c: keep_c };
    }
    let artifact = try fs_read_bytes(output) catch [];
    return map{ ok: true, output: output, c_path: c_path, kept_c: keep_c,
        compiler: compiler, profile: profile, numeric: numeric, source_admission: admission, portable_fallback: fallback,
        root_source_bytes: len(source), source_bytes: len(build_source),
        c_bytes: len(c_source), artifact_bytes: len(artifact), link: if linked == nil { nil } else { _link_summary(linked) },
        transpile_ms: transpile_ms, compile_ms: compile_ms };
}

// run_program(source, options) — compile and run with an execution watchdog.
// Compilation has no watchdog here; `timeout` bounds generated-program execution.
// If unavailable, execution requires explicit allow_unbounded opt-in.
fn run_program(source, options = nil) {
    let timeout_ms = _option(options, "timeout_ms", 10000);
    let valid_timeout = try type(timeout_ms) == "number" and timeout_ms >= 1 and timeout_ms <= 300000 catch false;
    if not valid_timeout {
        return map{ ok: false, error: "timeout_ms must be between 1 and 300000" };
    }
    let output = _OS.temp_dir() + "/pblang_c99_" + _UUID.v4();
    let build_options = map{
        admission: _option(options, "admission", "strict"),
        profile: _option(options, "profile", "speed"),
        numeric: _option(options, "numeric", "float"),
        compiler: _option(options, "compiler", nil), keep_c: false,
        modules: _option(options, "modules", nil), entry_path: _option(options, "entry_path", "main.sapp"),
        max_modules: _option(options, "max_modules", 256),
        max_module_depth: _option(options, "max_module_depth", 64),
        max_module_source_bytes: _option(options, "max_module_source_bytes", 1048576),
        max_total_source_bytes: _option(options, "max_total_source_bytes", 8388608),
        max_linked_source_bytes: _option(options, "max_linked_source_bytes", 16777216),
        max_path_bytes: _option(options, "max_path_bytes", 1024)
    };
    if is_map(options) and map_has(options, "source_budget") {
        build_options.source_budget = options.source_budget;
    }
    let built = build_program(source, output, build_options);
    if not built.ok { return built; }

    let watchdog = find_c_compiler("timeout");
    let allow_unbounded = _bool_option(options, "allow_unbounded");
    let run = nil;
    let r0 = now_ms();
    if watchdog != nil {
        let seconds = str(timeout_ms / 1000);
        run = try proc_spawn_wait("timeout", ["--signal=TERM", "--kill-after=1s", seconds + "s", output]) catch nil;
    } elif allow_unbounded {
        run = try proc_spawn_wait(output, []) catch nil;
    }
    let run_ms = now_ms() - r0;
    try fs_remove(output) catch nil;
    if run == nil {
        return map{ ok: false, error: "bounded runner unavailable; install `timeout` or explicitly allow_unbounded", build: built };
    }
    let code = try run.exit_code catch 0 - 1;
    return map{ ok: code == 0, exit_code: code, stdout: try run.stdout catch "",
        stderr: try run.stderr catch "", timed_out: code == 124 or code == 137,
        run_ms: run_ms, build: built };
}

// ── Freestanding profile (OS-dev) ──────────────────────────────────────────────────
// The freestanding preamble: NO libc, fixed-width integer typedefs, and inline-asm
// intrinsics for the core OS primitives (port I/O, halt, interrupt flags). pblang
// code calling `outb(port, val)` / `inb(port)` / `hlt()` / `cli()` / `sti()`
// transpiles to these — real hardware access. Compile the result with
// `gcc -ffreestanding -nostdlib` (link with a kernel linker script for a bootable
// image). This is what makes a pblang kernel possible; the bytecode VM cannot.
fn freestanding_preamble() {
    return "/* pblang freestanding runtime — no libc (compile: gcc -ffreestanding -nostdlib) */" + _NL
        + "typedef unsigned char  u8;" + _NL
        + "typedef unsigned short u16;" + _NL
        + "typedef unsigned int   u32;" + _NL
        + "typedef unsigned long  u64;" + _NL
        + "typedef long           i64;" + _NL
        + "static inline void outb(u16 port, u8 val){ __asm__ volatile (\"outb %0, %1\" : : \"a\"(val), \"Nd\"(port)); }" + _NL
        + "static inline u8 inb(u16 port){ u8 r; __asm__ volatile (\"inb %1, %0\" : \"=a\"(r) : \"Nd\"(port)); return r; }" + _NL
        + "static inline void hlt(void){ __asm__ volatile (\"hlt\"); }" + _NL
        + "static inline void cli(void){ __asm__ volatile (\"cli\"); }" + _NL
        + "static inline void sti(void){ __asm__ volatile (\"sti\"); }" + _NL
        + "static void _pb_index_fail(void){ cli(); for(;;) hlt(); }" + _NL
        + _array_runtime("_pb_index_fail")
        + _NL;
}

// transpile_freestanding(source) — the freestanding C translation unit: the
// no-libc preamble + intrinsics, then the transpiled functions. Suitable for
// `gcc -ffreestanding -nostdlib`.
fn transpile_freestanding(source) {
    _set_intmode(false);
    _set_hosted(false);
    let out = nil; let failed = false;
    try { out = _emit_fns(source, freestanding_preamble()); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "ctranspile: freestanding translation rejected source"; }
    return out;
}

// ── Bootable kernel profile (multiboot + GC-free memory) ────────────────────────────
// Everything `transpile_freestanding` has, plus what makes an image GRUB/QEMU can
// boot: a multiboot1 header, a `_start` entry that sets up a stack and calls
// `kmain`, a GC-free **bump allocator** (kmalloc/kfree/kreset over a static heap —
// the no-GC memory model a kernel needs), and raw memory access (poke/peek) so
// pblang code can touch hardware memory (VGA, MMIO). 32-bit (multiboot1); build
// with `gcc -m32 -ffreestanding -nostdlib -fno-pie` then `ld -m elf_i386 -T <script>`.
fn kernel_preamble() {
    let nl = _NL;
    let s = "/* pblang bootable kernel (multiboot1, 32-bit, no libc, no GC) */" + nl;
    s = s + "/* build: gcc -m32 -ffreestanding -nostdlib -fno-pie -c k.c -o k.o */" + nl;
    s = s + "/*        ld -m elf_i386 -T kernel.ld -o kernel.elf k.o            */" + nl;
    s = s + "typedef unsigned char u8; typedef unsigned short u16;" + nl;
    s = s + "typedef unsigned int u32; typedef unsigned long u64;" + nl;
    // multiboot header (magic, flags=0, checksum)
    s = s + "__attribute__((section(\".multiboot\"))) const u32 _mb[] = { 0x1BADB002, 0, (u32)(0 - (0x1BADB002u + 0u)) };" + nl;
    // OS intrinsics
    s = s + "static inline void outb(u16 p,u8 v){ __asm__ volatile(\"outb %0,%1\"::\"a\"(v),\"Nd\"(p)); }" + nl;
    s = s + "static inline u8 inb(u16 p){ u8 r; __asm__ volatile(\"inb %1,%0\":\"=a\"(r):\"Nd\"(p)); return r; }" + nl;
    s = s + "static inline void hlt(void){ __asm__ volatile(\"hlt\"); }" + nl;
    s = s + "static inline void cli(void){ __asm__ volatile(\"cli\"); }" + nl;
    s = s + "static inline void sti(void){ __asm__ volatile(\"sti\"); }" + nl;
    // raw memory access (addresses pass as double → u64; fine for 32-bit MMIO/VGA)
    s = s + "static inline void poke8(u64 a,u8 v){ *(volatile u8*)(u64)a = v; }" + nl;
    s = s + "static inline u8 peek8(u64 a){ return *(volatile u8*)(u64)a; }" + nl;
    s = s + "static inline void poke16(u64 a,u16 v){ *(volatile u16*)(u64)a = v; }" + nl;
    s = s + "static inline void poke32(u64 a,u32 v){ *(volatile u32*)(u64)a = v; }" + nl;
    s = s + "static inline u32 peek32(u64 a){ return *(volatile u32*)(u64)a; }" + nl;
    // interrupt support: load IDT register, and a software-interrupt trigger (vec
    // 0x30) used to exercise a handler. `cli`/`sti` (above) gate interrupts.
    s = s + "static inline void lidt(u64 a){ __asm__ volatile(\"lidt (%0)\"::\"r\"((u32)(u64)a):\"memory\"); }" + nl;
    s = s + "static inline void swint(void){ __asm__ volatile(\"int $0x30\"); }" + nl;
    s = s + "static inline void swint80(void){ __asm__ volatile(\"int $0x80\"); }" + nl;   // syscall trap
    // usermode (ring-3) readiness: load the GDT register, load the task register (TSS
    // selector), and drop to ring 3 via iret. enter_user reloads the data segments to
    // the user data selector (0x23), then pushes a ring-3 iret frame (user SS 0x23,
    // user ESP, eflags, user CS 0x1B, entry) and irets — the standard ring0->ring3
    // transition. (Selectors assume the gdt.sapp layout: user code idx 3, user data
    // idx 4, both RPL 3.)
    s = s + "static inline void lgdt(u64 a){ __asm__ volatile(\"lgdt (%0)\"::\"r\"((u32)(u64)a):\"memory\"); }" + nl;
    s = s + "static inline void ltr(u32 sel){ __asm__ volatile(\"ltr %w0\"::\"r\"(sel)); }" + nl;
    s = s + "static inline void enter_user(u32 entry, u32 ustack){ __asm__ volatile(" + nl;
    s = s + "  \"movw $0x23, %%ax\\n movw %%ax, %%ds\\n movw %%ax, %%es\\n movw %%ax, %%fs\\n movw %%ax, %%gs\\n\"" + nl;
    s = s + "  \"pushl $0x23\\n pushl %1\\n pushl $0x2\\n pushl $0x1B\\n pushl %0\\n iret\\n\"" + nl;
    s = s + "  ::\"r\"(entry),\"r\"(ustack):\"eax\",\"memory\"); }" + nl;
    // read_cs() — the current code selector. Its low 2 bits are the CPL, so code can
    // check its own privilege level (0x1B = user code RPL 3; 0x08 = kernel RPL 0).
    s = s + "static inline u32 read_cs(void){ u16 r; __asm__ volatile(\"movw %%cs, %0\":\"=r\"(r)); return (u32)r; }" + nl;
    // paging (virtual memory): load the page-directory base into CR3, flip the paging
    // bit (CR0.PG) on, read the faulting address (CR2), and flush one TLB entry. With an
    // identity-mapped page directory installed first, enabling paging is seamless.
    s = s + "static inline void set_cr3(u32 pd){ __asm__ volatile(\"movl %0, %%cr3\"::\"r\"(pd):\"memory\"); }" + nl;
    s = s + "static inline void enable_paging(void){ __asm__ volatile(\"movl %%cr0, %%eax\\n orl $0x80000000, %%eax\\n movl %%eax, %%cr0\\n\":::\"eax\",\"memory\"); }" + nl;
    s = s + "static inline u32 read_cr2(void){ u32 r; __asm__ volatile(\"movl %%cr2, %0\":\"=r\"(r)); return r; }" + nl;
    s = s + "static inline void invlpg(u32 a){ __asm__ volatile(\"invlpg (%0)\"::\"r\"(a):\"memory\"); }" + nl;
    // cooperative context switch: save callee-saved regs + esp into *old_sp, load
    // new_sp and restore — the primitive a stackful scheduler is built on. Naked, cdecl
    // args at 4(%esp)/8(%esp). A fresh task's stack is primed as [ebx,esi,edi,ebp,entry]
    // so the first switch `ret`s straight into the task entry. (Both args u32 so the
    // pblang `long` values pass without pointer warnings.)
    s = s + "__attribute__((naked)) static void ctx_switch(u32 old_sp, u32 new_sp){ __asm__ volatile(" + nl;
    s = s + "  \"movl 4(%esp), %eax\\n movl 8(%esp), %edx\\n\"" + nl;
    s = s + "  \"pushl %ebx\\n pushl %esi\\n pushl %edi\\n pushl %ebp\\n\"" + nl;
    s = s + "  \"movl %esp, (%eax)\\n movl %edx, %esp\\n\"" + nl;
    s = s + "  \"popl %ebp\\n popl %edi\\n popl %esi\\n popl %ebx\\n ret\\n\"); }" + nl;
    // GC-free bump allocator over a static heap. Allocator math is done in u64 (mode-
    // independent); only the pblang-facing number type (n / return) follows the mode,
    // so an int-mode kernel never touches a float.
    let nt = _numty();
    s = s + "static u8 _kheap[262144]; static u64 _koff = 0;" + nl;
    s = s + "__attribute__((noreturn)) static void _kalloc_fail(void){ cli(); for(;;) hlt(); }" + nl;
    s = s + "__attribute__((noreturn)) static void _pb_index_fail(void){ _kalloc_fail(); }" + nl;
    let heap_guard = "n < 0 || (u64)n > 262144UL";
    if not _MODE.intmode { heap_guard = "!(n >= 0) || n > 262144"; }
    s = s + "static " + nt + " kmalloc(" + nt + " n){"
        + " if (" + heap_guard + ") _kalloc_fail();"
        + " u64 need=((u64)n + 7UL) & ~7UL;"
        + " if (need > 262144UL - _koff) _kalloc_fail();"
        + " u64 o=_koff; _koff += need; return (" + nt + ")(u64)&_kheap[o]; }" + nl;
    s = s + "static void kfree(" + nt + " p){ (void)p; }" + nl;       // bump: no per-object free
    s = s + "static void kreset(void){ _koff = 0; }" + nl;
    s = s + _array_runtime("_pb_index_fail");
    // stack + entry: _start sets esp, calls kmain, halts forever
    s = s + "static u8 _kstack[65536];" + nl;
    s = s + "__attribute__((naked)) void _start(void){ __asm__ volatile(\"mov $_kstack + 65536, %esp\\n call kmain\\n 1: hlt\\n jmp 1b\\n\"); }" + nl;
    s = s + nl;
    return s;
}

// transpile_kernel(source) — a full bootable multiboot kernel (numbers as `double`):
// kernel preamble (header, intrinsics, allocator, _start) + the transpiled
// functions. `source` must define `fn kmain() { ... }` (the kernel entry).
fn transpile_kernel(source) {
    _set_intmode(false);
    _set_hosted(false);
    let out = nil; let failed = false;
    try { out = _emit_fns(source, kernel_preamble()); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "ctranspile: kernel translation rejected source"; }
    return out;
}

// transpile_kernel_int(source) — the SAME bootable multiboot kernel, but in INTEGER
// codegen mode: every number lowers to `long` instead of `double`, so the kernel is
// completely float-runtime-free (no SSE, no soft-float libgcc). This is what lets a
// kernel that installs GCC interrupt handlers (`isr...` fns, which need
// -mgeneral-regs-only) actually LINK and BOOT — see PrjAnalysis §73. Build:
//   gcc -m32 -ffreestanding -nostdlib -fno-pie -mgeneral-regs-only -c k.c -o k.o
//   ld -m elf_i386 -T kernel.ld -o kernel.elf k.o
fn transpile_kernel_int(source) {
    _set_intmode(true);
    _set_hosted(false);
    let out = nil; let failed = false;
    try { out = _emit_fns(source, kernel_preamble()); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "ctranspile: integer kernel translation rejected source"; }
    return out;
}

// transpile_freestanding_int(source) — freestanding profile in integer mode (no
// multiboot/_start, but float-free). For OS object files compiled with
// `gcc -ffreestanding -nostdlib -mgeneral-regs-only`.
fn transpile_freestanding_int(source) {
    _set_intmode(true);
    _set_hosted(false);
    let out = nil; let failed = false;
    try { out = _emit_fns(source, freestanding_preamble()); } catch { failed = true; }
    _set_hosted(false); _set_intmode(false);
    if failed { throw "ctranspile: integer freestanding translation rejected source"; }
    return out;
}

// kernel_linker_script() — links the multiboot header first at 1 MiB, entry _start.
fn kernel_linker_script() {
    let nl = _NL;
    return "ENTRY(_start)" + nl
        + "SECTIONS {" + nl
        + "  . = 1M;" + nl
        + "  .text : { *(.multiboot) *(.text*) }" + nl
        + "  .rodata : { *(.rodata*) }" + nl
        + "  .data : { *(.data*) }" + nl
        + "  .bss : { *(.bss*) *(COMMON) }" + nl
        + "}" + nl;
}

export transpile_expr, transpile_stmt, transpile_block, transpile_fn, transpile;
export hosted_preamble, transpile_program, transpile_program_int, link_program, transpile_program_linked;
export find_c_compiler, build_program, run_program;
export freestanding_preamble, transpile_freestanding, transpile_freestanding_int;
export kernel_preamble, transpile_kernel, transpile_kernel_int, kernel_linker_script;
export _set_intmode, _numty;

export transpile_program_local;
