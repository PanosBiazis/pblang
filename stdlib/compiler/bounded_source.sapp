// Explicit Linux source admission. Reuses the bounded kernel snapshot reader;
// never falls back to whole-file I/O and never changes caller permissions.
let DIR = import("stdlib:linux_dirfs_read_core.sapp");
let MAX_BYTES = 1048576;
fn error(message) { return map{ok:false,error:message}; }

fn read_source(path, max_bytes = 1048576) {
    if platform() != "linux" { return error("bounded source requires Linux"); }
    if type(max_bytes) != "number" or max_bytes < 1 or max_bytes > MAX_BYTES
       or max_bytes != num_floor(max_bytes) { return error("invalid source byte limit"); }
    if type(path) != "string" or len(path) == 0 or len(path) > 4096
       or str_contains(path, strfromcharcode(0)) or str_ends_with(path, "/") {
        return error("invalid source path");
    }
    let name = try path_basename(path) catch "";
    let parent = try path_dirname(path) catch "";
    if name == "" or name == "." or name == ".." or str_contains(name, "\\") {
        return error("invalid source path or filesystem permission unavailable");
    }
    if parent == "" { parent = "."; }
    let handle = if str_starts_with(parent, "/") {
        DIR.open_absolute_readonly(parent)
    } else { DIR.open_readonly(parent) };
    if not handle.ok { return error(handle.error); }
    // Literal relative names preserve a source named "root". The backend copies
    // at most limit+1 bytes and rejects overflow before allocating VM bytes.
    let loaded = try DIR.read_bytes_relative(handle, name, max_bytes) catch nil;
    let closed = try DIR.close_readonly(handle) catch false;
    if not closed { return error("bounded source descriptor cleanup failed"); }
    if loaded == nil { return error("bounded source read failed"); }
    if not loaded.ok { return error(loaded.error); }
    let source = try bytes_to_str(loaded.bytes) catch nil;
    if source == nil { return error("source is not valid UTF-8"); }
    // The retained runtime decodes bytes lossily; round-trip to reject repairs.
    let encoded = str_to_bytes(source);
    if len(encoded) != len(loaded.bytes) { return error("source is not valid UTF-8"); }
    let i = 0;
    while i < len(encoded) {
        if encoded[i] != loaded.bytes[i] { return error("source is not valid UTF-8"); }
        i = i + 1;
    }
    return map{ok:true,source:source,size:loaded.size,max_bytes:max_bytes};
}
export read_source, MAX_BYTES;
