// stdlib/compiler/parser.sapp — pblang recursive-descent parser written IN pblang.
//
// Self-hosting milestone 2/4:
//   Tokenizer ✅ → Parser ✅ → Type Checker → Compiler → Full Bootstrap
//
// Parses pblang tokens into an AST (Abstract Syntax Tree). This parser
// implements a subset of the full pblang grammar sufficient to parse itself
// and other pblang source files.
//
// Grammar (subset):
//   program    = stmt*
//   stmt       = let_stmt | const_stmt | fn_decl | return_stmt | if_stmt
//              | while_stmt | for_stmt | expr_stmt | import_stmt | export_stmt
//   let_stmt   = "let" ident [":" type] "=" expr ";"
//   const_stmt = "const" ident [":" type] "=" expr ";"
//   fn_decl    = "fn" ident "(" params? ")" [":" type] block
//   return_stmt= "return" [expr] ";"
//   if_stmt    = "if" expr block ("elif" expr block)* ["else" block]
//   while_stmt = "while" expr block
//   for_stmt   = "for" ident expr block  |  "for" ident "in" expr block
//   expr_stmt  = expr ";"
//   import_stmt= "import" "(" string ")" ";"
//   export_stmt= "export" ident ("," ident)* ";"
//   block      = "{" stmt* "}"
//   expr       = assignment
//   assignment = ident "=" assignment | logical_or
//   logical_or = logical_and ("||" logical_and)*
//   logical_and= equality ("&&" equality)*
//   equality   = comparison (("==" | "!=") comparison)*
//   comparison = term (("<" | ">" | "<=" | ">=") term)*
//   term       = factor (("+" | "-") factor)*
//   factor     = unary (("*" | "/" | "%") unary)*
//   unary      = ("-" | "!") unary | call
//   call       = primary ("(" args? ")")*
//   primary    = number | string | ident | "true" | "false" | "nil"
//              | "(" expr ")" | array_lit | map_lit | fn_lit
//   array_lit  = "[" (expr ("," expr)*)? "]"
//   map_lit    = "map" "{" (ident ":" expr ("," ident ":" expr)*)? "}"
//
// Usage:
//   let tok = import("stdlib/compiler/tokenizer.sapp");
//   let par = import("stdlib/compiler/parser.sapp");
//   let tokens = tok.tokenize(source);
//   let ast = par.parse(tokens);

// ── AST Node constructors ─────────────────────────────────────────────────────
// Build every node once. The old generic helper allocated an `extra` map, then
// allocated a second map and copied every field through map_keys(). Direct map
// literals preserve the AST contract without that allocation and hash walk.

// Public compatibility helper. Internal constructors intentionally avoid it,
// but existing parser extensions may still import make_node().
fn make_node(kind, extra) {
    let node = map{ kind: kind };
    if extra != nil {
        for k in map_keys(extra) { node[k] = extra[k]; }
    }
    return node;
}

fn stmt_let(name, value, type_ann) {
    return map{ kind: "let", name: name, value: value, type: type_ann };
}
fn stmt_const(name, value, type_ann) {
    return map{ kind: "const", name: name, value: value, type: type_ann };
}
fn stmt_return(value) {
    return map{ kind: "return", value: value };
}
fn stmt_if(cond, then_block, elifs, else_block) {
    return map{ kind: "if", cond: cond, then: then_block, elifs: elifs, else: else_block };
}
fn stmt_while(cond, body) {
    return map{ kind: "while", cond: cond, body: body };
}
fn stmt_for(varname, end_expr, body) {
    return map{ kind: "for", name: varname, end: end_expr, body: body };
}
fn stmt_forin(varname, iterable, body) {
    return map{ kind: "for_in", name: varname, iter: iterable, body: body };
}
fn stmt_import(path) {
    return map{ kind: "import", path: path };
}
fn stmt_export(names) {
    return map{ kind: "export", names: names };
}
fn stmt_expr(expr) {
    return map{ kind: "expr_stmt", expr: expr };
}
fn stmt_fn(name, params, body, return_type) {
    return map{ kind: "fn", name: name, params: params, body: body, ret: return_type };
}
fn stmt_block(stmts) {
    return map{ kind: "block", stmts: stmts };
}

fn expr_number(val) {
    return map{ kind: "number", value: val };
}
fn expr_string(val) {
    return map{ kind: "string", value: val };
}
fn expr_ident(name) {
    return map{ kind: "ident", name: name };
}
fn _source_ident(token) {
    let node = expr_ident(token.text);
    if map_has(token, "source_start") and map_has(token, "source_end") {
        node.source_start = token.source_start;
        node.source_end = token.source_end;
    }
    return node;
}
fn expr_bool(val) {
    return map{ kind: "bool", value: val };
}
fn expr_nil() {
    return map{ kind: "nil" };
}
fn expr_binary(op, left, right) {
    return map{ kind: "binary", op: op, left: left, right: right };
}
fn expr_unary(op, operand) {
    return map{ kind: "unary", op: op, operand: operand };
}
fn expr_call(func, args) {
    return map{ kind: "call", func: func, args: args };
}
fn expr_array(items) {
    return map{ kind: "array", items: items };
}
fn expr_map(entries) {
    return map{ kind: "map", entries: entries };
}
fn expr_assign(name, value) {
    return map{ kind: "assign", name: name, value: value };
}
fn expr_fnlit(params, body) {
    return map{ kind: "fn_lit", params: params, body: body };
}
fn expr_index(obj, index) {
    return map{ kind: "index", obj: obj, index: index };
}
fn expr_member(obj, name) {
    return map{ kind: "member", obj: obj, name: name };
}

// _member_name() — the field name after `.`/`?.`. Accepts a keyword token as well as an
// ident, because pblang maps allow keyword keys (e.g. `voters[i].fn`, `m.type`) and the
// VM reads them fine — only this parser used to reject them, producing false check errors.
fn _member_name() {
    let t = current();
    if t.kind == "ident" or t.kind == "keyword" { return advance(); }
    return expect("ident", nil);
}

fn push(arr, value) {
    array_push(arr, value);
}

// ── Parser state ──────────────────────────────────────────────────────────────

let tokens = [];
let pos = 0;
let errors = [];

// Recursion-depth guard for the expression parser. A pathologically nested
// expression (e.g. `((((((…1…))))))`) would otherwise recurse until the VM's
// stack limit throws straight out of the parser. We cap it well below that and
// record a clean error instead (parity with the Rust frontend's nesting guard).
// 256 is far beyond any real expression yet safely under the VM frame budget.
let MAX_EXPR_DEPTH = 256;
let _expr_depth = 0;
let MAX_TYPE_DEPTH = 64;
let _type_depth = 0;
let _type_pending_gt = 0;

fn current() {
    if pos < len(tokens) { return tokens[pos]; }
    return map{ kind: "eof", text: "", line: 1, col: 1 };
}

fn peek(offset) {
    let idx = pos + offset;
    if idx < len(tokens) { return tokens[idx]; }
    return map{ kind: "eof", text: "", line: 1, col: 1 };
}

fn advance() {
    let t = current();
    pos = pos + 1;
    return t;
}

fn previous() {
    if pos > 0 and pos - 1 < len(tokens) { return tokens[pos - 1]; }
    return map{ kind: "eof", text: "", line: 1, col: 1 };
}

fn expect(kind, text) {
    let t = current();
    if t.kind == kind and (text == nil or t.text == text) {
        return advance();
    }
    let msg = "Expected " + kind;
    if text != nil { msg = msg + " '" + text + "'"; }
    msg = msg + " but got " + t.kind + " '" + t.text + "'";
    msg = msg + " at line " + str(t.line) + ":" + str(t.col);
    push(errors, msg);
    return nil;
}

fn match_token(kind, text) {
    let t = current();
    if t.kind == kind and (text == nil or t.text == text) {
        advance();
        return true;
    }
    return false;
}

fn is_at_end() {
    return current().kind == "eof";
}

// ── Main parser entry ─────────────────────────────────────────────────────────

fn parse(token_list) {
    // Strip comment tokens — the grammar ignores them. (The tokenizer emits
    // `comment` tokens for `//`, `///`, and `//!` lines.)
    let filtered = [];
    let ci = 0;
    while ci < len(token_list) {
        if token_list[ci].kind != "comment" { push(filtered, token_list[ci]); }
        ci = ci + 1;
    }
    tokens = filtered;
    pos = 0;
    errors = [];
    _expr_depth = 0;
    _type_depth = 0;
    _type_pending_gt = 0;

    let stmts = [];
    while not is_at_end() {
        let before = pos;
        let s = parse_stmt();
        if s != nil {
            push(stmts, s);
        }
        // Hard anti-stall guard: on malformed input, always consume at least one token.
        if pos == before and not is_at_end() {
            push(errors, "Parser stalled at token '" + current().text + "'; skipping");
            advance();
        }
    }
    return map{ stmts: stmts, errors: errors };
}

// ── Statement parsers ─────────────────────────────────────────────────────────

fn parse_stmt() {
    let t = current();

    if t.kind == "keyword" {
        if t.text == "let" { return parse_let(); }
        if t.text == "const" { return parse_const(); }
        if t.text == "fn" { return parse_fn_decl(); }
        if t.text == "struct" { return parse_struct(); }
        if t.text == "interface" { return parse_interface(); }
        if t.text == "enum" { return parse_enum(); }
        if t.text == "class" { return parse_class(); }
        if t.text == "return" { return parse_return(); }
        if t.text == "if" { return parse_if(); }
        if t.text == "while" { return parse_while(); }
        if t.text == "for" { return parse_for(); }
        if t.text == "import" { return parse_import(); }
        if t.text == "export" { return parse_export(); }
        if t.text == "break" { advance(); if match_token("punct", ";") { } return map{ kind: "break" }; }
        if t.text == "continue" { advance(); if match_token("punct", ";") { } return map{ kind: "continue" }; }
        if t.text == "loop" {
            // `loop { ... }` = infinite loop (Rust parser.rs loop_stmt), desugared
            // to `while true`. Any other follower means `loop` is a contextual
            // identifier (pbai.sapp binds its brain-loop result to `loop`).
            if peek(1).kind == "punct" and peek(1).text == "{" {
                advance();
                let body = parse_block();
                return stmt_while(expr_bool(true), body);
            }
            if peek(1).kind == "operator" and peek(1).text == "=" {
                advance();
                advance(); // '='
                let value = parse_expr();
                if match_token("punct", ";") { /* consume */ }
                return stmt_expr(expr_assign("loop", value));
            }
        }
    }

    // `async fn ...` — contextual: `async` is an ident, recognised only directly
    // before the `fn` keyword (§48 port). Anywhere else it's a normal identifier.
    if t.kind == "ident" and t.text == "async"
       and peek(1).kind == "keyword" and peek(1).text == "fn" {
        return parse_async_fn();
    }

    // `print` is reserved for the print statement (matches the Rust frontend);
    // recognise it in statement-leading position, except `print = ...` (assignment).
    if t.kind == "ident" and t.text == "print"
       and not (peek(1).kind == "operator" and peek(1).text == "=") {
        return parse_print();
    }

    if (t.kind == "ident" or _is_ctx_name_kw(t))
        and peek(1).kind == "operator" and _is_assign_op(peek(1).text) {
        return parse_assignment();
    }

    return parse_expr_stmt();
}

fn parse_let() {
    advance(); // skip 'let'
    let name_token = _expect_ctx_name();
    if name_token == nil { return nil; }
    let name = name_token.text;

    // Optional type annotation
    let ty = nil;
    if match_token("punct", ":") {
        ty = parse_type();
    }

    expect("operator", "=");
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    let s = stmt_let(name, value, ty);
    s.line = try name_token.line catch 0;   // diagnostics point at the declaration
    return s;
}

fn parse_const() {
    advance(); // skip 'const'
    let name_token = _expect_ctx_name();
    if name_token == nil { return nil; }
    let name = name_token.text;

    let ty = nil;
    if match_token("punct", ":") {
        ty = parse_type();
    }

    expect("operator", "=");
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    let s = stmt_const(name, value, ty);
    s.line = try name_token.line catch 0;
    return s;
}

// Keywords the Rust frontend accepts as plain NAMES in name-only positions
// (fn declarations, export lists): `fn match` (regex.sapp), `fn defer`
// (async_io.sapp — this parser has no defer statement), `fn nil` (blocks.sapp
// AST builders), and `interface` in name-only positions used by the Wayland
// protocol modules. Expression-position `nil` stays the literal.
fn _is_ctx_name_kw(t) {
    return t.kind == "keyword"
        and (t.text == "match" or t.text == "defer" or t.text == "nil"
             or t.text == "loop" or t.text == "interface");
}

fn _expect_ctx_name() {
    if current().kind == "ident" or _is_ctx_name_kw(current()) {
        return advance();
    }
    return expect("ident", nil);
}

// Keep the self-hosted checker aligned with the executable frontend. Runtime
// default parameters intentionally accept literals only; computed defaults
// belong in the function body behind a nil sentinel. Parse the full expression
// after reporting the mismatch so diagnostics can recover at the next comma or
// closing parenthesis instead of cascading through the rest of the file.
fn _parse_parameter_default() {
    let t = current();
    if t.kind == "number" { advance(); return expr_number(t.text); }
    if t.kind == "string" { advance(); return expr_string(t.text); }
    if t.kind == "keyword" and t.text == "true" { advance(); return expr_bool(true); }
    if t.kind == "keyword" and t.text == "false" { advance(); return expr_bool(false); }
    if t.kind == "keyword" and t.text == "nil" { advance(); return expr_nil(); }
    push(errors, "Default parameter values must be number, string, bool, or nil literals at line "
        + str(t.line) + ":" + str(t.col)
        + "; initialize computed defaults inside the function body");
    return parse_expr();
}

fn parse_fn_decl() {
    advance(); // skip 'fn'
    let name_token = _expect_ctx_name();
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "(");
    let params = [];
    if not match_token("punct", ")") {
        while true {
            let pname = _expect_ctx_name();
            if pname == nil { break; }
            let ptype = nil;
            if match_token("punct", ":") {
                ptype = parse_type();
            }
            // Default value: `fn f(a, b = 5)`
            let pdefault = nil;
            if current().kind == "operator" and current().text == "=" {
                advance();
                pdefault = _parse_parameter_default();
            }
            push(params, map{ name: pname.text, type: ptype, default: pdefault });
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == ")" { break; } // trailing comma
        }
        expect("punct", ")");
    }

    let ret_type = nil;
    if match_token("punct", ":") {
        ret_type = parse_type();
    }

    let body = parse_block();
    let s = stmt_fn(name, params, body, ret_type);
    s.line = try name_token.line catch 0;
    return s;
}

// `async fn f(p) { body }` — desugars to `fn f(p) { return spawn(fn() { body }); }`
// (mirrors the Rust §48 sugar): calling `f(...)` spawns the body as a task and
// returns the handle. Pure parser sugar over the global `spawn`/`join` builtins —
// no new IR. `async` is contextual (only recognised immediately before `fn`), so
// it stays usable as an ordinary identifier elsewhere.
fn parse_async_fn() {
    advance(); // skip 'async'
    let f = parse_fn_decl();
    if f == nil { return nil; }
    let inner = expr_fnlit([], f.body);            // fn() { <original body> }
    let spawn_call = expr_call(expr_ident("spawn"), [inner]);
    let new_body = stmt_block([stmt_return(spawn_call)]);
    return stmt_fn(f.name, f.params, new_body, f.ret);
}

// `struct Name { field [: type] (, field [: type])* }` — desugars to a typed
// constructor function `fn Name(fields...) { return map{ __struct: "Name",
// field: field, ... }; }`. Instances are tagged maps; fields via normal `p.x`.
// Type annotations are preserved on the generated constructor parameters so the
// self-hosted checker can validate construction and infer typed field access.
fn parse_struct() {
    advance(); // skip 'struct'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let params = [];
    let entries = [];
    push(entries, map{ key: "__struct", value: expr_string(name) });
    if not match_token("punct", "}") {
        while true {
            let fname_token = expect("ident", nil);
            if fname_token == nil { break; }
            let fname = fname_token.text;
            let ftype = nil;
            if match_token("punct", ":") { ftype = parse_type(); }
            push(params, map{ name: fname, type: ftype, default: nil });
            push(entries, map{ key: fname, value: expr_ident(fname) });
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing comma
        }
        expect("punct", "}");
    }

    let body = stmt_block([stmt_return(expr_map(entries))]);
    return stmt_fn(name, params, body, nil);
}

// `interface Name { m1; m2(a, b); m3(); }` — structural-conformance sugar (mirrors
// the Rust §50 implementation). Desugars to a PREDICATE function
// `fn Name(x) { return is_map(x) and has_member(x,"m1") and has_member(x,"m2") ...; }`.
// Bare members are field requirements; `m(params)` members parse the param list
// (discarded) and use only the name. This is the self-hosted parser learning a
// feature the Rust frontend already had — one step further on rust→pblang.
fn parse_interface() {
    advance(); // skip 'interface'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let members = [];
    if not match_token("punct", "}") {
        while true {
            if current().kind == "punct" and current().text == "}" { break; }
            let m_token = expect("ident", nil);
            if m_token == nil { break; }
            push(members, m_token.text);
            // optional `( params )` — parsed and discarded (name drives the check)
            if match_token("punct", "(") {
                while not (current().kind == "punct" and current().text == ")") {
                    if current().kind == "eof" { break; }
                    advance();
                }
                match_token("punct", ")");
            }
            if not match_token("punct", ";") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing ;
        }
        expect("punct", "}");
    }

    // Build `is_map(x) and has_member(x,"m1") and has_member(x,"m2") ...`
    let acc = expr_call(expr_ident("is_map"), [expr_ident("x")]);
    let i = 0;
    while i < len(members) {
        let has = expr_call(expr_ident("has_member"), [expr_ident("x"), expr_string(members[i])]);
        acc = expr_binary("and", acc, has);
        i = i + 1;
    }
    let body = stmt_block([stmt_return(acc)]);
    let params = [ map{ name: "x", type: nil, default: nil } ];
    return stmt_fn(name, params, body, nil);
}

// Build the constructor for an enum DATA variant `Variant(t0, t1, ...)`:
// an anonymous `fn(v0, v1, ...) { return map{ __enum: "E", __variant: "V",
// values: [v0, v1, ...] }; }`. fn_lit params are plain strings.
fn enum_data_ctor(enum_name, variant_name, param_types) {
    let params = [];
    let value_items = [];
    let i = 0;
    while i < len(param_types) {
        let pn = "v" + str(i);
        push(params, pn);
        push(value_items, expr_ident(pn));
        i = i + 1;
    }
    let entries = [];
    push(entries, map{ key: "__enum", value: expr_string(enum_name) });
    push(entries, map{ key: "__variant", value: expr_string(variant_name) });
    push(entries, map{ key: "values", value: expr_array(value_items) });
    let body = stmt_block([stmt_return(expr_map(entries))]);
    let ctor = expr_fnlit(params, body);
    // fn_lit params stay plain names for bytecode/codegen compatibility. These
    // parallel annotations are checker metadata and are ignored by the VM.
    ctor.param_types = param_types;
    ctor.enum_name = enum_name;
    ctor.variant_name = variant_name;
    return ctor;
}

// `enum Name { Variant [(types...)] (, ...)* }` — desugars to
// `let Name = map{ Variant: <tagged map | ctor fn>, ... }`. Unit variants are
// `{ __enum, __variant }` tagged maps; data variants are constructor functions
// returning `{ __enum, __variant, values: [...] }`. Matches the Rust desugaring.
fn parse_enum() {
    advance(); // skip 'enum'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let entries = [];
    if not match_token("punct", "}") {
        while true {
            let vname_token = expect("ident", nil);
            if vname_token == nil { break; }
            let vname = vname_token.text;
            if current().kind == "punct" and current().text == "(" {
                advance(); // consume '('
                let param_types = [];
                if not (current().kind == "punct" and current().text == ")") {
                    while true {
                        push(param_types, parse_type());
                        if not match_token("punct", ",") { break; }
                    }
                }
                expect("punct", ")");
                push(entries, map{ key: vname, value: enum_data_ctor(name, vname, param_types) });
            } else {
                let uentries = [];
                push(uentries, map{ key: "__enum", value: expr_string(name) });
                push(uentries, map{ key: "__variant", value: expr_string(vname) });
                push(entries, map{ key: vname, value: expr_map(uentries) });
            }
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing comma
        }
        expect("punct", "}");
    }

    return stmt_let(name, expr_map(entries), nil);
}

// `class Name { fn m(self, ...) { ... } ... }` — OOP sugar. Desugars to a class
// table `let Name = map{ __class_name, <method>: fn(self, ...){...}, ..., new }`.
// Methods are stored as named closures (first param is the receiver `self`).
// An auto-generated `new(__cls, <init args>)` allocates an instance
// `map{ __class: __cls }`, runs `init` if present, and returns it. Construct via
// the colon-call `Name:new(args)`; dispatch methods via `inst:method(args)`
// (see parse_call). Mirrors the Rust class desugaring's class-table + `__class`
// model, adapted to the self-hosted toolchain (no `__call`, no new0..new3).
fn parse_class() {
    advance(); // skip 'class'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let cname = name_token.text;

    expect("punct", "{");
    let entries = [];
    push(entries, map{ key: "__class_name", value: expr_string(cname) });
    let init_args = [];    // non-self param names of `init`
    let has_init = false;
    while not (current().kind == "punct" and current().text == "}") {
        if not (current().kind == "keyword" and current().text == "fn") { break; }
        advance(); // skip 'fn'
        let mname_token = expect("ident", nil);
        if mname_token == nil { break; }
        let mname = mname_token.text;
        expect("punct", "(");
        let params = [];   // plain strings, per expr_fnlit
        if not match_token("punct", ")") {
            while true {
                let pn = expect("ident", nil);
                if pn == nil { break; }
                if match_token("punct", ":") { parse_type(); }   // type ann (ignored)
                if current().kind == "operator" and current().text == "=" {
                    advance();
                    _parse_parameter_default(); // parsed for frontend parity; class lowering ignores it
                }
                push(params, pn.text);
                if not match_token("punct", ",") { break; }
                if current().kind == "punct" and current().text == ")" { break; } // trailing comma
            }
            expect("punct", ")");
        }
        if match_token("punct", ":") { parse_type(); }   // optional return type
        let body = parse_block();
        push(entries, map{ key: mname, value: expr_fnlit(params, body) });
        if mname == "init" {
            has_init = true;
            init_args = [];
            let pi = 1;   // skip self
            while pi < len(params) { push(init_args, params[pi]); pi = pi + 1; }
        }
        if current().kind == "punct" and current().text == ";" { advance(); }
    }
    expect("punct", "}");

    // new(__cls, <init args>) { let __o = map{ __class: __cls };
    //                           [__cls.init(__o, <init args>);] return __o; }
    let new_params = ["__cls"];
    if has_init {
        let ni = 0;
        while ni < len(init_args) { push(new_params, init_args[ni]); ni = ni + 1; }
    }
    let o_init = expr_map([ map{ key: "__class", value: expr_ident("__cls") } ]);
    let new_body = [ stmt_let("__o", o_init, nil) ];
    if has_init {
        let call_args = [ expr_ident("__o") ];
        let ci = 0;
        while ci < len(init_args) { push(call_args, expr_ident(init_args[ci])); ci = ci + 1; }
        push(new_body, stmt_expr(expr_call(expr_member(expr_ident("__cls"), "init"), call_args)));
    }
    push(new_body, stmt_return(expr_ident("__o")));
    push(entries, map{ key: "new", value: expr_fnlit(new_params, stmt_block(new_body)) });

    return stmt_let(cname, expr_map(entries), nil);
}

fn parse_return() {
    advance(); // skip 'return'
    let value = nil;
    if not match_token("punct", ";") {
        value = parse_expr();
        if match_token("punct", ";") { /* consume trailing ';' */ }
    }
    return stmt_return(value);
}

// `print EXPR ;` — pblang's print is a statement keyword (not a function), so the
// frontend must parse `print add(2,3)` / `print "hi"` as one print statement, not
// as two stray expression statements. Emits a {kind:"print", value} node that
// codegen_print lowers to OP_PRINT (captured into run output → drives F5 "run").
fn parse_print() {
    advance(); // skip 'print'
    let value = nil;
    if not match_token("punct", ";") {
        value = parse_expr();
        if match_token("punct", ";") { /* consume trailing ';' */ }
    }
    return map{ kind: "print", value: value };
}

// Parse a value-producing conditional chain after its first `if` keyword.
// `elif` and `else if` lower to one right-nested `if_expr` AST, so the VM,
// optimizer, type checker and C99 backend need no duplicate semantics. Parsing
// is iterative and bounded to avoid host-stack growth on adversarial input.
fn parse_if_expr_arm() {
    let arms = [];
    let else_blk: any = nil;
    let reading = true;
    while reading {
        if len(arms) >= MAX_EXPR_DEPTH {
            push(errors, "if expression has too many arms (max "
                + str(MAX_EXPR_DEPTH) + ") at line " + str(current().line)
                + ":" + str(current().col));
            reading = false;
        } else {
            let cond = parse_expr();
            let then_blk = parse_block();
            array_push(arms, map{ cond: cond, then: then_blk });
            if match_token("keyword", "elif") {
                // The next loop consumes the following condition and block.
            } elif match_token("keyword", "else") {
                if current().kind == "keyword" and current().text == "if" {
                    advance(); // normalize `else if` to another arm
                } else {
                    else_blk = parse_block(); reading = false;
                }
            } else {
                reading = false;
            }
        }
    }
    let nested: any = else_blk; let i = len(arms) - 1;
    while i >= 0 {
        nested = map{ kind: "if_expr", cond: arms[i].cond,
            then: arms[i].then, else: nested };
        i = i - 1;
    }
    return nested;
}

// `if <cond> { ... } elif <cond> { ... } else { ... }` used as an
// EXPRESSION. Each branch yields its final expression. A missing final `else`
// preserves the existing self-hosted behavior and yields nil when no arm wins.
fn parse_if_expr() {
    advance(); // skip 'if'
    return parse_if_expr_arm();
}

// A match arm's pattern: `_` (wildcard), an ident (binds the scrutinee), or a
// literal/constant expression (matched by `==`).
fn parse_match_pattern() {
    let t = current();
    if t.kind == "ident" and t.text == "_" {
        advance();
        return map{ ptype: "wildcard" };
    }
    if t.kind == "ident" {
        advance();
        return map{ ptype: "bind", name: t.text };
    }
    // number / string / true / false / nil / parenthesized constant
    let lit = parse_primary();
    return map{ ptype: "literal", value: lit };
}

// match expression:
//   match SCRUTINEE {
//       case PATTERN [if GUARD] : BODY ;
//       ...
//       else : BODY ;
//   }
// Patterns: `_` wildcard, ident bind, or literal (matched by `==`). Arms are
// tried top to bottom; the first matching arm's BODY is the value. `else` (or no
// match) yields the else body, or nil if absent.
fn parse_match() {
    advance(); // skip 'match'
    let scrut = parse_expr();
    expect("punct", "{");
    let arms = [];
    let melse = nil;
    while not (current().kind == "punct" and current().text == "}") {
        if current().kind == "keyword" and current().text == "else" {
            advance();
            if current().kind == "punct" and current().text == ":" { advance(); }
            melse = parse_expr();
            if current().kind == "punct" and current().text == ";" { advance(); }
        } else if current().kind == "keyword" and current().text == "case" {
            advance();
            let pat = parse_match_pattern();
            let guard = nil;
            if current().kind == "keyword" and current().text == "if" {
                advance();
                guard = parse_expr();
            }
            expect("punct", ":");
            let body = parse_expr();
            if current().kind == "punct" and current().text == ";" { advance(); }
            push(arms, map{ pattern: pat, guard: guard, body: body });
        } else {
            break; // unexpected token — stop to avoid an infinite loop
        }
    }
    expect("punct", "}");
    return map{ kind: "match", scrutinee: scrut, arms: arms, melse: melse };
}

fn parse_if() {
    advance(); // skip 'if'
    let cond = parse_expr();
    let then_block = parse_block();

    let elifs = [];
    while match_token("keyword", "elif") {
        let elif_cond = parse_expr();
        let elif_body = parse_block();
        push(elifs, map{ cond: elif_cond, body: elif_body });
    }

    let else_block = nil;
    if match_token("keyword", "else") {
        // `else if ...` — treat as an else-block holding a single nested if.
        if current().kind == "keyword" and current().text == "if" {
            else_block = stmt_block([parse_if()]);
        } else {
            else_block = parse_block();
        }
    }

    return stmt_if(cond, then_block, elifs, else_block);
}

fn parse_while() {
    advance(); // skip 'while'
    let cond = parse_expr();
    let body = parse_block();
    return stmt_while(cond, body);
}

fn parse_for() {
    advance(); // skip 'for'
    let varname = expect("ident", nil);
    if varname == nil { return nil; }

    // for k, v in map { }  — iterate a map's key/value pairs
    if match_token("punct", ",") {
        let valname = expect("ident", nil);
        if valname == nil { return nil; }
        expect("keyword", "in");
        let iterable = parse_expr();
        let body = parse_block();
        let fm = map{ kind: "for_map", key: varname.text, val: valname.text, iter: iterable, body: body };
        fm.line = try varname.line catch 0;
        return fm;
    }

    if match_token("keyword", "in") {
        let iterable = parse_expr();
        // for i in LO to HI { }  — inclusive numeric range (`to` is an ident)
        if current().kind == "ident" and current().text == "to" {
            advance();
            let end_expr = parse_expr();
            let body = parse_block();
            let fr = map{ kind: "for_range", name: varname.text, start: iterable, end: end_expr, body: body };
            fr.line = try varname.line catch 0;
            return fr;
        }
        // for x in expr { }  — iterate an array
        let body = parse_block();
        let fi = stmt_forin(varname.text, iterable, body);
        fi.line = try varname.line catch 0;
        return fi;
    } else {
        // for i N { }
        let end_expr = parse_expr();
        let body = parse_block();
        let fo = stmt_for(varname.text, end_expr, body);
        fo.line = try varname.line catch 0;
        return fo;
    }
}

// Binding name for the `import "path";` statement form (mirrors the Rust
// frontend): take the path after the last ':' (specifier prefix) and the last
// '/' or '\', strip the extension; empty -> "module".
fn _import_binding_name(path) {
    let s = path;
    let i = len(s) - 1;
    let cut = 0 - 1;
    while i >= 0 { if slice(s, i, i + 1) == ":" { cut = i; break; } i = i - 1; }
    if cut >= 0 { s = slice(s, cut + 1, len(s)); }
    i = len(s) - 1; cut = 0 - 1;
    while i >= 0 {
        let c = slice(s, i, i + 1);
        if c == "/" or c == "\\" { cut = i; break; }
        i = i - 1;
    }
    if cut >= 0 { s = slice(s, cut + 1, len(s)); }
    i = len(s) - 1; cut = 0 - 1;
    while i >= 0 { if slice(s, i, i + 1) == "." { cut = i; break; } i = i - 1; }
    if cut >= 0 { s = slice(s, 0, cut); }
    if len(s) == 0 { return "module"; }
    return s;
}

fn parse_import() {
    advance(); // skip 'import'
    // Statement form: `import "path";` — desugars to `let <basename> = import(path)`
    // exactly like the Rust frontend (which emits a call + define-global).
    if current().kind == "string" {
        let path_token = advance();
        if match_token("punct", ";") { /* consume */ }
        return stmt_let(_import_binding_name(path_token.text),
                        expr_call(expr_ident("import"), [expr_string(path_token.text)]),
                        nil);
    }
    expect("punct", "(");
    let path_token = expect("string", nil);
    if path_token == nil { return nil; }
    expect("punct", ")");
    if match_token("punct", ";") { /* consume */ }
    return stmt_import(path_token.text);
}

fn parse_export() {
    advance(); // skip 'export'
    let names = [];
    while true {
        let n = nil;
        if _is_ctx_name_kw(current()) { n = advance(); }
        else { n = expect("ident", nil); }
        if n == nil { break; }
        push(names, n.text);
        if not match_token("punct", ",") { break; }
    }
    if match_token("punct", ";") { /* consume */ }
    return stmt_export(names);
}

// `=` and the compound assignment operators.
fn _is_assign_op(op) {
    return op == "=" or op == "+=" or op == "-=" or op == "*=" or op == "/=" or op == "%=";
}
fn parse_assignment() {
    let name_token = _expect_ctx_name();
    if name_token == nil { return nil; }
    let op = peek(0).text;          // "=" or a compound op like "+="
    advance();                      // consume the assignment operator
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    if op == "=" {
        return stmt_expr(expr_assign(name_token.text, value));
    }
    // compound assignment desugars to plain assignment: `x OP= e`  →  `x = x OP e`. Nothing downstream
    // (interp / codegen) needs to change — they only ever see `assign` of a `binary`.
    let base = str_slice(op, 0, len(op) - 1);   // "+=" → "+"
    let combined = expr_binary(base, expr_ident(name_token.text), value);
    return stmt_expr(expr_assign(name_token.text, combined));
}

fn parse_expr_stmt() {
    let e = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    return stmt_expr(e);
}

fn parse_block() {
    expect("punct", "{");
    let stmts = [];
    while not is_at_end() and current().text != "}" {
        let before = pos;
        let s = parse_stmt();
        if s != nil {
            push(stmts, s);
        }
        if pos == before and not is_at_end() {
            push(errors, "Parser stalled in block at token '" + current().text + "'; skipping");
            advance();
        }
    }
    expect("punct", "}");
    return stmt_block(stmts);
}

// Expression block `{ stmt; stmt; tail? }` in expression position (the body of
// `try { ... } catch`, or bare). Mirrors the Rust frontend's BlockExpr: inner
// statements end with ';', an optional trailing expression is the block's
// value (none -> nil). Desugars to an immediately-invoked zero-arg fn literal
// — `(fn(){ stmts; return tail; })()` — so codegen and the VM need no new node;
// closures already capture the enclosing scope. (Deviation from Rust: a
// `return`/`break` INSIDE the block exits the block, not the enclosing
// function/loop — stdlib block-exprs are straight-line value blocks.)
fn parse_block_expr() {
    expect("punct", "{");
    let stmts = [];
    let tail = nil;
    while not is_at_end() and current().text != "}" {
        let t = current();
        let is_stmt_kw = t.kind == "keyword" and (t.text == "let" or t.text == "const"
            or t.text == "fn" or t.text == "return" or t.text == "if" or t.text == "while"
            or t.text == "for" or t.text == "break" or t.text == "continue"
            or t.text == "import" or t.text == "export" or t.text == "struct"
            or t.text == "enum" or t.text == "class" or t.text == "interface");
        let is_assign = (t.kind == "ident" or _is_ctx_name_kw(t))
            and peek(1).kind == "operator" and peek(1).text == "=";
        // `print` is a statement in leading position (examples wrap whole
        // programs in a bare block; parse_stmt applies the same rule).
        let is_print = t.kind == "ident" and t.text == "print"
            and not (peek(1).kind == "operator" and peek(1).text == "=");
        if is_stmt_kw or is_assign or is_print {
            let before = pos;
            let s = parse_stmt();
            if s != nil { push(stmts, s); }
            // The executable frontend requires every inner statement in a
            // value-producing block to end with `;`. Some self-hosted
            // statement parsers consume their terminator themselves, while
            // structured statements leave it for this expression-block
            // boundary. Check both forms so both frontends accept and reject
            // exactly the same source instead of reparsing `try`/`catch` as
            // identifiers after an ambiguous block.
            let terminated = previous().kind == "punct" and previous().text == ";";
            if not terminated and match_token("punct", ";") { terminated = true; }
            if not terminated {
                push(errors, "Expected ';' after statement in expression block at line "
                    + str(current().line) + ":" + str(current().col));
            }
            if pos == before and not is_at_end() {
                push(errors, "Parser stalled in block expression at token '"
                    + current().text + "'; skipping");
                advance();
            }
        } else {
            let e = parse_expr();
            if match_token("punct", ";") {
                push(stmts, stmt_expr(e));
            } else {
                tail = e;
                break;
            }
        }
    }
    expect("punct", "}");
    if tail != nil { push(stmts, stmt_return(tail)); }
    return expr_call(expr_fnlit([], stmt_block(stmts)), []);
}

// ── Expression parser (Pratt parser / precedence climbing) ────────────────────

fn parse_expr() {
    // Bound recursion so deeply nested expressions yield a recorded error
    // instead of exhausting the VM stack. The counter is balanced on both exit
    // paths and reset per `parse()`.
    _expr_depth = _expr_depth + 1;
    if _expr_depth > MAX_EXPR_DEPTH {
        _expr_depth = _expr_depth - 1;
        push(errors, "expression nested too deeply (max " + str(MAX_EXPR_DEPTH)
            + ") at line " + str(current().line) + ":" + str(current().col));
        return expr_nil();
    }
    let r = parse_assignment_expr();
    _expr_depth = _expr_depth - 1;
    return r;
}

// Null-coalescing: `a ?? b` -> a if a is not nil, else b.
fn parse_coalesce() {
    let left = parse_or();
    while current().kind == "operator" and current().text == "??" {
        advance();
        let right = parse_or();
        left = map{ kind: "coalesce", left: left, right: right };
    }
    return left;
}

// Ternary `cond ? a : b` — desugars to an if-expression with single-statement
// block arms (exactly the Rust frontend's lowering to IfExpr + BlockExpr).
// Non-nesting like the Rust grammar: chain with parentheses.
fn parse_ternary() {
    let cond = parse_coalesce();
    if current().kind == "operator" and current().text == "?" {
        advance();
        let then_e = parse_coalesce();
        expect("punct", ":");
        let else_e = parse_coalesce();
        return map{
            kind: "if_expr",
            cond: cond,
            then: stmt_block([stmt_expr(then_e)]),
            else: stmt_block([stmt_expr(else_e)]),
        };
    }
    return cond;
}

fn parse_assignment_expr() {
    let left = parse_ternary();
    // Assignment: <lvalue> = <expr>. The lvalue is a parsed postfix expression —
    // a bare ident, or an index/member chain (`a[i] = v`, `m.k = v`,
    // `cg.chunk.instructions[j].operand = x`).
    if current().kind == "operator" and current().text == "=" {
        advance();
        let value = parse_assignment_expr();   // right-associative
        if left.kind == "ident" {
            return expr_assign(left.name, value);
        }
        return map{ kind: "assign_to", target: left, value: value };
    }
    return left;
}

fn parse_or() {
    let left = parse_and();
    while (current().kind == "operator" and current().text == "||")
          or (current().kind == "keyword" and current().text == "or") {
        advance();
        let right = parse_and();
        left = expr_binary("or", left, right);
    }
    return left;
}

fn parse_and() {
    let left = parse_equality();
    while (current().kind == "operator" and current().text == "&&")
          or (current().kind == "keyword" and current().text == "and") {
        advance();
        let right = parse_equality();
        left = expr_binary("and", left, right);
    }
    return left;
}

fn parse_equality() {
    let left = parse_comparison();
    while current().kind == "operator" and (current().text == "==" or current().text == "!=") {
        let op = advance().text;
        let right = parse_comparison();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_comparison() {
    let left = parse_bitor();
    while current().kind == "operator"
          and (current().text == "<" or current().text == ">"
               or current().text == "<=" or current().text == ">=") {
        let op = advance().text;
        let right = parse_bitor();
        left = expr_binary(op, left, right);
    }
    return left;
}

// Bitwise infix ladder (§47 port), between comparison and additive, tightest
// last: `|` (loosest) → `^` → `&` → `<<`/`>>` (tightest, just looser than +/-).
// Each desugars to a call to the bit_* builtin (mirrors the Rust parser sugar).
fn parse_bitor() {
    let left = parse_bitxor();
    while current().kind == "operator" and current().text == "|" {
        advance();
        let right = parse_bitxor();
        left = expr_call(expr_ident("bit_or"), [left, right]);
    }
    return left;
}

fn parse_bitxor() {
    let left = parse_bitand();
    while current().kind == "operator" and current().text == "^" {
        advance();
        let right = parse_bitand();
        left = expr_call(expr_ident("bit_xor"), [left, right]);
    }
    return left;
}

fn parse_bitand() {
    let left = parse_shift();
    while current().kind == "operator" and current().text == "&" {
        advance();
        let right = parse_shift();
        left = expr_call(expr_ident("bit_and"), [left, right]);
    }
    return left;
}

fn parse_shift() {
    let left = parse_term();
    while current().kind == "operator"
          and (current().text == "<<" or current().text == ">>") {
        let op = advance().text;
        let right = parse_term();
        let fname = "bit_shl";
        if op == ">>" { fname = "bit_shr"; }
        left = expr_call(expr_ident(fname), [left, right]);
    }
    return left;
}

fn parse_term() {
    let left = parse_factor();
    while current().kind == "operator" and (current().text == "+" or current().text == "-") {
        let op = advance().text;
        let right = parse_factor();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_factor() {
    let left = parse_unary();
    while current().kind == "operator"
          and (current().text == "*" or current().text == "/" or current().text == "%") {
        let op = advance().text;
        let right = parse_unary();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_unary() {
    // `await EXPR` — desugars to `join(EXPR)` (§48 port). Contextual & whitespace-
    // guarded: `await x` / `await (e)` is the keyword, but `await(x)` with `(`
    // ADJACENT (no space) stays an ordinary call to a function named `await`, so
    // the concurrency stdlib's `fn await(...)` keeps working. Adjacency = the `(`
    // begins exactly where `await` ends (col + len("await") == 5).
    if current().kind == "ident" and current().text == "await" {
        let nxt = peek(1);
        let adjacent_call = nxt.kind == "punct" and nxt.text == "("
            and nxt.line == current().line and nxt.col == current().col + 5;
        if not adjacent_call {
            advance();
            let operand = parse_unary();
            return expr_call(expr_ident("join"), [operand]);
        }
    }
    if current().kind == "operator" and (current().text == "-" or current().text == "!") {
        let op = advance().text;
        let operand = parse_unary();
        return expr_unary(op, operand);
    }
    // Prefix `~` — bitwise NOT, desugars to a `bit_not(e)` call (§47 port).
    if current().kind == "operator" and current().text == "~" {
        advance();
        let operand = parse_unary();
        return expr_call(expr_ident("bit_not"), [operand]);
    }
    if current().kind == "keyword" and current().text == "not" {
        advance();
        let operand = parse_unary();
        return expr_unary("not", operand);
    }
    // `throw EXPR` — raise a value (caught by an enclosing `try ... catch`).
    // Parsed as a prefix so it works both as a statement and inside `(throw e)`.
    if current().kind == "keyword" and current().text == "throw" {
        advance();
        let operand = parse_unary();
        return map{ kind: "throw", value: operand };
    }
    return parse_power();
}

// `a ** b` — exponentiation, desugars to `num_pow(a, b)` (mirrors the Rust
// frontend). Right-associative and binds tighter than unary, so `2 ** 3 ** 2`
// is `2 ** (3 ** 2)` and `2 ** -3` parses (exponent goes through parse_unary).
fn parse_power() {
    let base = parse_call();
    if current().kind == "operator" and current().text == "**" {
        advance();
        let exp = parse_unary();
        return expr_call(expr_ident("num_pow"), [base, exp]);
    }
    return base;
}

fn parse_call() {
    let call_line = try current().line catch 0;
    let expr = parse_primary();
    let go = true;
    while go {
        if match_token("punct", "(") {
            let args = [];
            if not match_token("punct", ")") {
                while true {
                    push(args, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == ")" { break; } // trailing comma
                }
                expect("punct", ")");
            }
            let called = expr_call(expr, args);
            called.line = call_line;
            expr = called;
        } else if match_token("punct", "[") {
            // Range-slice sugar (mirrors the Rust frontend): `a[lo..hi]`,
            // `a[lo..]`, `a[..hi]`, `a[..]` all desugar to slice(a, lo, hi)
            // with an omitted bound becoming nil (slice reads nil as 0 / len).
            if match_token("operator", "..") {
                let hi = expr_nil();
                if not (current().kind == "punct" and current().text == "]") {
                    hi = parse_expr();
                }
                expect("punct", "]");
                expr = expr_call(expr_ident("slice"), [expr, expr_nil(), hi]);
            } else {
                let idx = parse_expr();
                if match_token("operator", "..") {
                    let hi = expr_nil();
                    if not (current().kind == "punct" and current().text == "]") {
                        hi = parse_expr();
                    }
                    expect("punct", "]");
                    expr = expr_call(expr_ident("slice"), [expr, idx, hi]);
                } else {
                    expect("punct", "]");
                    expr = expr_index(expr, idx);
                }
            }
        } else if match_token("punct", ".") {
            let nm = _member_name();
            if nm == nil { go = false; } else { expr = expr_member(expr, nm.text); }
        } else if match_token("operator", "?.") {
            // optional member: a?.b -> nil if a is nil
            let nm = _member_name();
            if nm == nil { go = false; } else { expr = map{ kind: "opt_member", obj: expr, name: nm.text }; }
        } else if match_token("operator", "?[") {
            // optional index: a?[i] -> nil if a is nil
            let idx = parse_expr();
            expect("punct", "]");
            expr = map{ kind: "opt_index", obj: expr, index: idx };
        } else if current().kind == "punct" and current().text == ":"
                  and peek(1).kind == "ident"
                  and peek(2).kind == "punct" and peek(2).text == "(" {
            // Colon-call (method dispatch with implicit self): `obj:method(a, b)`.
            // Desugars to `(obj.__class ?? obj).method(obj, a, b)` — the receiver
            // dispatches via its class table when it's a class instance (carries
            // `__class`), else via itself (a plain method-map). `??` is used (not
            // Rust's `try .. catch`) because the self-hosted VM returns nil — not
            // an error — for a missing map key. The receiver `expr` is inlined, so
            // it should be a simple, side-effect-free lvalue (the common case).
            advance();                       // consume ':'
            let mname = advance().text;       // method name
            advance();                        // consume '('
            let cargs = [];
            if not match_token("punct", ")") {
                while true {
                    push(cargs, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == ")" { break; } // trailing comma
                }
                expect("punct", ")");
            }
            let recv = map{ kind: "coalesce", left: expr_member(expr, "__class"), right: expr };
            let full_args = [expr];
            let ai = 0;
            while ai < len(cargs) { push(full_args, cargs[ai]); ai = ai + 1; }
            let called = expr_call(expr_member(recv, mname), full_args);
            called.line = call_line;
            expr = called;
        } else {
            go = false;
        }
    }
    return expr;
}

fn parse_primary() {
    let t = current();

    if t.kind == "number" {
        advance();
        return expr_number(t.text);
    }
    if t.kind == "string" {
        advance();
        return expr_string(t.text);
    }
    if t.kind == "ident" {
        advance();
        // `map { ... }` literal — the tokenizer emits `map` as an ident, so we
        // detect it here (the generic ident branch would otherwise swallow it).
        // Keys use `:` which the tokenizer classifies as punct.
        if t.text == "map" and current().kind == "punct" and current().text == "{" {
            advance(); // consume '{'
            let entries = [];
            if not match_token("punct", "}") {
                while true {
                    // key may be an ident, a string literal (`map{ "fn": true }`),
                    // or a keyword used as a name (`map{ else: x, then: y }`)
                    let key_str = nil;
                    if current().kind == "ident" or current().kind == "string" or current().kind == "keyword" {
                        key_str = advance().text;
                    } else {
                        break;
                    }
                    if match_token("punct", ":") {
                        let val = parse_expr();
                        push(entries, map{ key: key_str, value: val });
                    } else {
                        push(entries, map{ key: key_str, value: expr_ident(key_str) });
                    }
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == "}" { break; } // trailing comma
                }
                expect("punct", "}");
            }
            return expr_map(entries);
        }
        return _source_ident(t);
    }
    if t.kind == "keyword" {
        if t.text == "true" { advance(); return expr_bool(true); }
        if t.text == "false" { advance(); return expr_bool(false); }
        if t.text == "nil" { advance(); return expr_nil(); }
        if t.text == "interface" { advance(); return expr_ident("interface"); }
        if t.text == "import" { advance(); return expr_ident("import"); } // import(...) as expr
        if t.text == "defer" { advance(); return expr_ident("defer"); }   // no defer stmt here,
                                                                          // so it's a plain name
                                                                          // (async_io.sapp)
        if t.text == "loop" { advance(); return expr_ident("loop"); }     // `loop {` is only a
                                                                          // statement; in expression
                                                                          // position it's a name
        if t.text == "if" { return parse_if_expr(); }
        if t.text == "match" {
            // Contextual: `match` is only a match-expression when followed by a
            // scrutinee (`match <expr> { case ... }`). Followed by `(`, `,`, `)`,
            // `;`, `]`, `}`, `=` or an unambiguous member/optional-index
            // postfix (`.`, `?.`, `?[`) it's a plain identifier. For example,
            // linux_dirfs.sapp reads a local map with `match.admitted`.
            // regex.sapp defines
            // and calls `fn match(s, pat)`. (The Rust frontend gets this via
            // backtracking; known deviation: a parenthesized scrutinee
            // `match (x) { ... }` needs the parens dropped here.)
            let nx = peek(1);
            if (nx.kind == "punct" and (nx.text == "(" or nx.text == "," or nx.text == ")"
                    or nx.text == ";" or nx.text == "]" or nx.text == "}" or nx.text == "."))
               or (nx.kind == "operator" and (nx.text == "=" or nx.text == "?." or nx.text == "?[")) {
                advance();
                return expr_ident("match");
            }
            return parse_match();
        }
        if t.text == "try" {
            // `try <expr> catch <expr>` — an expression that yields the body's
            // value, or the handler's value if the body raises.
            advance();
            let body = parse_expr();
            let handler = expr_nil();
            if current().kind == "keyword" and current().text == "catch" {
                advance();
                handler = parse_expr();
            }
            return map{ kind: "try", body: body, handler: handler };
        }
        if t.text == "fn" {
            advance();
            expect("punct", "(");
            let params = [];
            if not match_token("punct", ")") {
                while true {
                    let pn = _expect_ctx_name();
                    if pn == nil { break; }
                    push(params, pn.text);
                    if not match_token("punct", ",") { break; }
                }
                expect("punct", ")");
            }
            let body = parse_block();
            return expr_fnlit(params, body);
        }
    }
    if t.kind == "punct" {
        if t.text == "{" { return parse_block_expr(); }
        if t.text == "(" {
            advance();
            let e = parse_expr();
            expect("punct", ")");
            return e;
        }
        if t.text == "[" {
            advance();
            let items = [];
            if not match_token("punct", "]") {
                while true {
                    push(items, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == "]" { break; } // trailing comma
                }
                expect("punct", "]");
            }
            return expr_array(items);
        }
    }
    if t.kind == "keyword" and t.text == "map" {
        advance();
        expect("punct", "{");
        let entries = [];
        if not match_token("punct", "}") {
            while true {
                let key_token = expect("ident", nil);
                if key_token == nil { break; }
                if match_token("operator", ":") {
                    let val = parse_expr();
                    push(entries, map{ key: key_token.text, value: val });
                } else {
                    push(entries, map{ key: key_token.text, value: expr_ident(key_token.text) });
                }
                if not match_token("punct", ",") { break; }
            }
            expect("punct", "}");
        }
        return expr_map(entries);
    }

    push(errors, "Unexpected token: " + t.kind + " '" + t.text + "' at " + str(t.line) + ":" + str(t.col));
    // Consume unexpected token to avoid infinite loops on malformed inputs.
    if not is_at_end() {
        advance();
    }
    return expr_nil();
}

fn _type_match(text) {
    // The tokenizer correctly emits `>>` as a shift operator. Inside a nested
    // type it represents two closing generic delimiters, so consume one now and
    // leave one synthetic `>` in the same token for the outer parse level.
    if text == ">" and _type_pending_gt > 0 {
        _type_pending_gt = _type_pending_gt - 1; return true;
    }
    let t = current();
    if text == ">" and t.kind == "operator" and t.text == ">>" {
        advance(); _type_pending_gt = _type_pending_gt + 1; return true;
    }
    if current().text == text { advance(); return true; }
    return false;
}

fn _type_expect(text) {
    if _type_match(text) { return true; }
    let t = current();
    push(errors, "Expected type symbol '" + text + "' but got " + t.kind
        + " '" + t.text + "' at line " + str(t.line) + ":" + str(t.col));
    return false;
}

fn _parse_type_primary() {
    let t = current();
    if t.kind == "punct" and t.text == "[" {
        advance();
        let inner = parse_type();
        _type_expect("]");
        return "array<" + inner + ">";
    }
    if t.kind != "ident" and t.kind != "keyword" {
        push(errors, "Expected type but got " + t.kind + " '" + t.text
            + "' at line " + str(t.line) + ":" + str(t.col));
        if t.text != ">" and t.text != "," and t.text != ")" and t.kind != "eof" { advance(); }
        return "any";
    }

    advance();
    let name = t.text;
    if name == "array" and _type_match("<") {
        let inner = parse_type();
        _type_expect(">");
        return "array<" + inner + ">";
    }
    if (name == "map" or name == "result") and _type_match("<") {
        let left = parse_type();
        _type_expect(",");
        let right = parse_type();
        _type_expect(">");
        return name + "<" + left + "," + right + ">";
    }
    return name;
}

fn parse_type() {
    _type_depth = _type_depth + 1;
    if _type_depth > MAX_TYPE_DEPTH {
        _type_depth = _type_depth - 1;
        let t = current();
        push(errors, "type nested too deeply (max " + str(MAX_TYPE_DEPTH)
            + ") at line " + str(t.line) + ":" + str(t.col));
        return "any";
    }
    let out = _parse_type_primary();
    if current().kind == "operator" and (current().text == "?" or current().text == "!") {
        out = out + advance().text;
    }
    _type_depth = _type_depth - 1;
    if _type_depth == 0 and _type_pending_gt > 0 {
        let t = current();
        push(errors, "unexpected extra '>' in type at line " + str(t.line) + ":" + str(t.col));
        _type_pending_gt = 0;
    }
    return out;
}

// ── Utility: print AST for debugging ──────────────────────────────────────────

fn print_ast(node, indent) {
    if indent == nil { indent = 0; }
    let pad = "";
    for _i in 0 to indent { pad = pad + "  "; }

    if node == nil {
        print (pad + "nil");
        return;
    }

    if node.kind == nil {
        print (pad + "<no kind>");
        return;
    }

    print (pad + node.kind);

    if node.kind == "number" { print (pad + "  " + node.value); }
    if node.kind == "string" { print (pad + "  \"" + node.value + "\""); }
    if node.kind == "ident" { print (pad + "  " + node.name); }
    if node.kind == "bool" { print (pad + "  " + str(node.value)); }

    if node.kind == "binary" {
        print (pad + "  op: " + node.op);
        print_ast(node.left, indent + 1);
        print_ast(node.right, indent + 1);
    }

    if node.kind == "unary" {
        print (pad + "  op: " + node.op);
        print_ast(node.operand, indent + 1);
    }

    if node.kind == "call" {
        print_ast(node.func, indent + 1);
        print (pad + "  args:");
        for a in node.args {
            print_ast(a, indent + 2);
        }
    }

    if node.kind == "let" or node.kind == "const" {
        print (pad + "  name: " + node.name);
        print_ast(node.value, indent + 1);
    }

    if node.kind == "fn" {
        print (pad + "  name: " + node.name);
        print (pad + "  params:");
        for p in node.params {
            if type(p) == "map" {
                print (pad + "    " + p.name);
            } else {
                print (pad + "    " + p);
            }
        }
        print_ast(node.body, indent + 1);
    }

    if node.kind == "if" {
        print (pad + "  cond:");
        print_ast(node.cond, indent + 1);
        print (pad + "  then:");
        print_ast(node.then, indent + 1);
    }

    if node.kind == "block" {
        for s in node.stmts {
            print_ast(s, indent + 1);
        }
    }

    if node.kind == "return" {
        if node.value != nil {
            print_ast(node.value, indent + 1);
        }
    }

    if node.kind == "array" {
        for item in node.items {
            print_ast(item, indent + 1);
        }
    }

    if node.kind == "assign" {
        print (pad + "  name: " + node.name);
        print_ast(node.value, indent + 1);
    }
}

// ── Self-test: parse this file itself ─────────────────────────────────────────

// Top-level import (was nested inside self_test, which blocked the source-level
// linker — it only inlines top-level `let X = import(...)`). Hoisting it lets the
// parser module flatten and native-compile.
let _selftest_tok = import("stdlib/compiler/tokenizer.sapp");

fn self_test() {
    let tokens = _selftest_tok.tokenize("fn add(a, b) { return a + b; } let x = add(1, 2);");
    let result = parse(tokens);
    if len(result.errors) > 0 {
        for e in result.errors {
            print ("ERROR: " + e);
        }
    } else {
        print ("Self-test: parsed successfully, " + str(len(result.stmts)) + " statements");
        for s in result.stmts {
            print_ast(s, 0);
        }
    }
    return result;
}

export parse, print_ast, self_test;
export make_node, stmt_let, stmt_const, stmt_return, stmt_if, stmt_while;
export stmt_for, stmt_forin, stmt_import, stmt_export, stmt_expr, stmt_fn, stmt_block;
export expr_number, expr_string, expr_ident, expr_bool, expr_nil;
export expr_binary, expr_unary, expr_call, expr_array, expr_map, expr_assign;
