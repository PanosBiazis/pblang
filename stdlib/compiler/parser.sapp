// stdlib/compiler/parser.sapp — pblang recursive-descent parser written IN pblang.
//
// Self-hosting milestone 2/4:
//   Tokenizer ✅ → Parser ✅ → Type Checker → Compiler → Full Bootstrap
//
// Parses pblang tokens into an AST (Abstract Syntax Tree). This parser
// implements a subset of the full pblang grammar sufficient to parse itself
// and other pblang source files.
//
// Grammar (subset):
//   program    = stmt*
//   stmt       = let_stmt | const_stmt | fn_decl | return_stmt | if_stmt
//              | while_stmt | for_stmt | expr_stmt | import_stmt | export_stmt
//   let_stmt   = "let" ident [":" type] "=" expr ";"
//   const_stmt = "const" ident [":" type] "=" expr ";"
//   fn_decl    = "fn" ident "(" params? ")" [":" type] block
//   return_stmt= "return" [expr] ";"
//   if_stmt    = "if" expr block ("elif" expr block)* ["else" block]
//   while_stmt = "while" expr block
//   for_stmt   = "for" ident expr block  |  "for" ident "in" expr block
//   expr_stmt  = expr ";"
//   import_stmt= "import" "(" string ")" ";"
//   export_stmt= "export" ident ("," ident)* ";"
//   block      = "{" stmt* "}"
//   expr       = assignment
//   assignment = ident "=" assignment | logical_or
//   logical_or = logical_and ("||" logical_and)*
//   logical_and= equality ("&&" equality)*
//   equality   = comparison (("==" | "!=") comparison)*
//   comparison = term (("<" | ">" | "<=" | ">=") term)*
//   term       = factor (("+" | "-") factor)*
//   factor     = unary (("*" | "/" | "%") unary)*
//   unary      = ("-" | "!") unary | call
//   call       = primary ("(" args? ")")*
//   primary    = number | string | ident | "true" | "false" | "nil"
//              | "(" expr ")" | array_lit | map_lit | fn_lit
//   array_lit  = "[" (expr ("," expr)*)? "]"
//   map_lit    = "map" "{" (ident ":" expr ("," ident ":" expr)*)? "}"
//
// Usage:
//   let tok = import("stdlib/compiler/tokenizer.sapp");
//   let par = import("stdlib/compiler/parser.sapp");
//   let tokens = tok.tokenize(source);
//   let ast = par.parse(tokens);

// ── AST Node constructors ─────────────────────────────────────────────────────

fn make_node(kind, extra) {
    let node = map{ kind: kind };
    if extra != nil {
        for k in map_keys(extra) {
            node[k] = extra[k];
        }
    }
    return node;
}

fn stmt_let(name, value, type_ann) {
    return make_node("let", map{ name: name, value: value, type: type_ann });
}
fn stmt_const(name, value, type_ann) {
    return make_node("const", map{ name: name, value: value, type: type_ann });
}
fn stmt_return(value) {
    return make_node("return", map{ value: value });
}
fn stmt_if(cond, then_block, elifs, else_block) {
    return make_node("if", map{ cond: cond, then: then_block, elifs: elifs, else: else_block });
}
fn stmt_while(cond, body) {
    return make_node("while", map{ cond: cond, body: body });
}
fn stmt_for(varname, end_expr, body) {
    return make_node("for", map{ name: varname, end: end_expr, body: body });
}
fn stmt_forin(varname, iterable, body) {
    return make_node("for_in", map{ name: varname, iter: iterable, body: body });
}
fn stmt_import(path) {
    return make_node("import", map{ path: path });
}
fn stmt_export(names) {
    return make_node("export", map{ names: names });
}
fn stmt_expr(expr) {
    return make_node("expr_stmt", map{ expr: expr });
}
fn stmt_fn(name, params, body, return_type) {
    return make_node("fn", map{ name: name, params: params, body: body, ret: return_type });
}
fn stmt_block(stmts) {
    return make_node("block", map{ stmts: stmts });
}

fn expr_number(val) {
    return make_node("number", map{ value: val });
}
fn expr_string(val) {
    return make_node("string", map{ value: val });
}
fn expr_ident(name) {
    return make_node("ident", map{ name: name });
}
fn expr_bool(val) {
    return make_node("bool", map{ value: val });
}
fn expr_nil() {
    return make_node("nil", map{});
}
fn expr_binary(op, left, right) {
    return make_node("binary", map{ op: op, left: left, right: right });
}
fn expr_unary(op, operand) {
    return make_node("unary", map{ op: op, operand: operand });
}
fn expr_call(func, args) {
    return make_node("call", map{ func: func, args: args });
}
fn expr_array(items) {
    return make_node("array", map{ items: items });
}
fn expr_map(entries) {
    return make_node("map", map{ entries: entries });
}
fn expr_assign(name, value) {
    return make_node("assign", map{ name: name, value: value });
}
fn expr_fnlit(params, body) {
    return make_node("fn_lit", map{ params: params, body: body });
}
fn expr_index(obj, index) {
    return make_node("index", map{ obj: obj, index: index });
}
fn expr_member(obj, name) {
    return make_node("member", map{ obj: obj, name: name });
}

fn push(arr, value) {
    array_push(arr, value);
}

// ── Parser state ──────────────────────────────────────────────────────────────

let tokens = [];
let pos = 0;
let errors = [];

// Recursion-depth guard for the expression parser. A pathologically nested
// expression (e.g. `((((((…1…))))))`) would otherwise recurse until the VM's
// stack limit throws straight out of the parser. We cap it well below that and
// record a clean error instead (parity with the Rust frontend's nesting guard).
// 256 is far beyond any real expression yet safely under the VM frame budget.
let MAX_EXPR_DEPTH = 256;
let _expr_depth = 0;

fn current() {
    if pos < len(tokens) { return tokens[pos]; }
    return map{ kind: "eof", text: "", line: 1, col: 1 };
}

fn peek(offset) {
    let idx = pos + offset;
    if idx < len(tokens) { return tokens[idx]; }
    return map{ kind: "eof", text: "", line: 1, col: 1 };
}

fn advance() {
    let t = current();
    pos = pos + 1;
    return t;
}

fn expect(kind, text) {
    let t = current();
    if t.kind == kind and (text == nil or t.text == text) {
        return advance();
    }
    let msg = "Expected " + kind;
    if text != nil { msg = msg + " '" + text + "'"; }
    msg = msg + " but got " + t.kind + " '" + t.text + "'";
    msg = msg + " at line " + str(t.line) + ":" + str(t.col);
    push(errors, msg);
    return nil;
}

fn match_token(kind, text) {
    let t = current();
    if t.kind == kind and (text == nil or t.text == text) {
        advance();
        return true;
    }
    return false;
}

fn is_at_end() {
    return current().kind == "eof";
}

// ── Main parser entry ─────────────────────────────────────────────────────────

fn parse(token_list) {
    // Strip comment tokens — the grammar ignores them. (The tokenizer emits
    // `comment` tokens for `//`, `///`, and `//!` lines.)
    let filtered = [];
    let ci = 0;
    while ci < len(token_list) {
        if token_list[ci].kind != "comment" { push(filtered, token_list[ci]); }
        ci = ci + 1;
    }
    tokens = filtered;
    pos = 0;
    errors = [];
    _expr_depth = 0;

    let stmts = [];
    while not is_at_end() {
        let before = pos;
        let s = parse_stmt();
        if s != nil {
            push(stmts, s);
        }
        // Hard anti-stall guard: on malformed input, always consume at least one token.
        if pos == before and not is_at_end() {
            push(errors, "Parser stalled at token '" + current().text + "'; skipping");
            advance();
        }
    }
    return map{ stmts: stmts, errors: errors };
}

// ── Statement parsers ─────────────────────────────────────────────────────────

fn parse_stmt() {
    let t = current();

    if t.kind == "keyword" {
        if t.text == "let" { return parse_let(); }
        if t.text == "const" { return parse_const(); }
        if t.text == "fn" { return parse_fn_decl(); }
        if t.text == "struct" { return parse_struct(); }
        if t.text == "interface" { return parse_interface(); }
        if t.text == "enum" { return parse_enum(); }
        if t.text == "class" { return parse_class(); }
        if t.text == "return" { return parse_return(); }
        if t.text == "if" { return parse_if(); }
        if t.text == "while" { return parse_while(); }
        if t.text == "for" { return parse_for(); }
        if t.text == "import" { return parse_import(); }
        if t.text == "export" { return parse_export(); }
        if t.text == "break" { advance(); if match_token("punct", ";") { } return make_node("break", nil); }
        if t.text == "continue" { advance(); if match_token("punct", ";") { } return make_node("continue", nil); }
    }

    // `async fn ...` — contextual: `async` is an ident, recognised only directly
    // before the `fn` keyword (§48 port). Anywhere else it's a normal identifier.
    if t.kind == "ident" and t.text == "async"
       and peek(1).kind == "keyword" and peek(1).text == "fn" {
        return parse_async_fn();
    }

    // `print` is reserved for the print statement (matches the Rust frontend);
    // recognise it in statement-leading position, except `print = ...` (assignment).
    if t.kind == "ident" and t.text == "print"
       and not (peek(1).kind == "operator" and peek(1).text == "=") {
        return parse_print();
    }

    if t.kind == "ident" and peek(1).kind == "operator" and peek(1).text == "=" {
        return parse_assignment();
    }

    return parse_expr_stmt();
}

fn parse_let() {
    advance(); // skip 'let'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    // Optional type annotation
    let ty = nil;
    if match_token("punct", ":") {
        ty = parse_type();
    }

    expect("operator", "=");
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    return stmt_let(name, value, ty);
}

fn parse_const() {
    advance(); // skip 'const'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    let ty = nil;
    if match_token("punct", ":") {
        ty = parse_type();
    }

    expect("operator", "=");
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    return stmt_const(name, value, ty);
}

fn parse_fn_decl() {
    advance(); // skip 'fn'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "(");
    let params = [];
    if not match_token("punct", ")") {
        while true {
            let pname = expect("ident", nil);
            if pname == nil { break; }
            let ptype = nil;
            if match_token("punct", ":") {
                ptype = parse_type();
            }
            // Default value: `fn f(a, b = 5)`
            let pdefault = nil;
            if current().kind == "operator" and current().text == "=" {
                advance();
                pdefault = parse_expr();
            }
            push(params, map{ name: pname.text, type: ptype, default: pdefault });
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == ")" { break; } // trailing comma
        }
        expect("punct", ")");
    }

    let ret_type = nil;
    if match_token("punct", ":") {
        ret_type = parse_type();
    }

    let body = parse_block();
    return stmt_fn(name, params, body, ret_type);
}

// `async fn f(p) { body }` — desugars to `fn f(p) { return spawn(fn() { body }); }`
// (mirrors the Rust §48 sugar): calling `f(...)` spawns the body as a task and
// returns the handle. Pure parser sugar over the global `spawn`/`join` builtins —
// no new IR. `async` is contextual (only recognised immediately before `fn`), so
// it stays usable as an ordinary identifier elsewhere.
fn parse_async_fn() {
    advance(); // skip 'async'
    let f = parse_fn_decl();
    if f == nil { return nil; }
    let inner = expr_fnlit([], f.body);            // fn() { <original body> }
    let spawn_call = expr_call(expr_ident("spawn"), [inner]);
    let new_body = stmt_block([stmt_return(spawn_call)]);
    return stmt_fn(f.name, f.params, new_body, f.ret);
}

// `struct Name { field [: type] (, field [: type])* }` — desugars to a typed
// constructor function `fn Name(fields...) { return map{ __struct: "Name",
// field: field, ... }; }`. Instances are tagged maps; fields via normal `p.x`.
// Type annotations are parsed and discarded (the constructor body just copies
// each field through). Mirrors the Rust parser-sugar approach.
fn parse_struct() {
    advance(); // skip 'struct'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let params = [];
    let entries = [];
    push(entries, map{ key: "__struct", value: expr_string(name) });
    if not match_token("punct", "}") {
        while true {
            let fname_token = expect("ident", nil);
            if fname_token == nil { break; }
            let fname = fname_token.text;
            if match_token("punct", ":") {
                parse_type();   // consumed, unused in the desugaring
            }
            push(params, map{ name: fname, type: nil, default: nil });
            push(entries, map{ key: fname, value: expr_ident(fname) });
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing comma
        }
        expect("punct", "}");
    }

    let body = stmt_block([stmt_return(expr_map(entries))]);
    return stmt_fn(name, params, body, nil);
}

// `interface Name { m1; m2(a, b); m3(); }` — structural-conformance sugar (mirrors
// the Rust §50 implementation). Desugars to a PREDICATE function
// `fn Name(x) { return is_map(x) and has_member(x,"m1") and has_member(x,"m2") ...; }`.
// Bare members are field requirements; `m(params)` members parse the param list
// (discarded) and use only the name. This is the self-hosted parser learning a
// feature the Rust frontend already had — one step further on rust→pblang.
fn parse_interface() {
    advance(); // skip 'interface'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let members = [];
    if not match_token("punct", "}") {
        while true {
            if current().kind == "punct" and current().text == "}" { break; }
            let m_token = expect("ident", nil);
            if m_token == nil { break; }
            push(members, m_token.text);
            // optional `( params )` — parsed and discarded (name drives the check)
            if match_token("punct", "(") {
                while not (current().kind == "punct" and current().text == ")") {
                    if current().kind == "eof" { break; }
                    advance();
                }
                match_token("punct", ")");
            }
            if not match_token("punct", ";") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing ;
        }
        expect("punct", "}");
    }

    // Build `is_map(x) and has_member(x,"m1") and has_member(x,"m2") ...`
    let acc = expr_call(expr_ident("is_map"), [expr_ident("x")]);
    let i = 0;
    while i < len(members) {
        let has = expr_call(expr_ident("has_member"), [expr_ident("x"), expr_string(members[i])]);
        acc = expr_binary("and", acc, has);
        i = i + 1;
    }
    let body = stmt_block([stmt_return(acc)]);
    let params = [ map{ name: "x", type: nil, default: nil } ];
    return stmt_fn(name, params, body, nil);
}

// Build the constructor for an enum DATA variant `Variant(t0, t1, ...)`:
// an anonymous `fn(v0, v1, ...) { return map{ __enum: "E", __variant: "V",
// values: [v0, v1, ...] }; }`. fn_lit params are plain strings.
fn enum_data_ctor(enum_name, variant_name, arity) {
    let params = [];
    let value_items = [];
    let i = 0;
    while i < arity {
        let pn = "v" + str(i);
        push(params, pn);
        push(value_items, expr_ident(pn));
        i = i + 1;
    }
    let entries = [];
    push(entries, map{ key: "__enum", value: expr_string(enum_name) });
    push(entries, map{ key: "__variant", value: expr_string(variant_name) });
    push(entries, map{ key: "values", value: expr_array(value_items) });
    let body = stmt_block([stmt_return(expr_map(entries))]);
    return expr_fnlit(params, body);
}

// `enum Name { Variant [(types...)] (, ...)* }` — desugars to
// `let Name = map{ Variant: <tagged map | ctor fn>, ... }`. Unit variants are
// `{ __enum, __variant }` tagged maps; data variants are constructor functions
// returning `{ __enum, __variant, values: [...] }`. Matches the Rust desugaring.
fn parse_enum() {
    advance(); // skip 'enum'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let name = name_token.text;

    expect("punct", "{");
    let entries = [];
    if not match_token("punct", "}") {
        while true {
            let vname_token = expect("ident", nil);
            if vname_token == nil { break; }
            let vname = vname_token.text;
            if current().kind == "punct" and current().text == "(" {
                advance(); // consume '('
                let arity = 0;
                if not (current().kind == "punct" and current().text == ")") {
                    while true {
                        parse_type();   // field type, counted for the ctor arity
                        arity = arity + 1;
                        if not match_token("punct", ",") { break; }
                    }
                }
                expect("punct", ")");
                push(entries, map{ key: vname, value: enum_data_ctor(name, vname, arity) });
            } else {
                let uentries = [];
                push(uentries, map{ key: "__enum", value: expr_string(name) });
                push(uentries, map{ key: "__variant", value: expr_string(vname) });
                push(entries, map{ key: vname, value: expr_map(uentries) });
            }
            if not match_token("punct", ",") { break; }
            if current().kind == "punct" and current().text == "}" { break; } // trailing comma
        }
        expect("punct", "}");
    }

    return stmt_let(name, expr_map(entries), nil);
}

// `class Name { fn m(self, ...) { ... } ... }` — OOP sugar. Desugars to a class
// table `let Name = map{ __class_name, <method>: fn(self, ...){...}, ..., new }`.
// Methods are stored as named closures (first param is the receiver `self`).
// An auto-generated `new(__cls, <init args>)` allocates an instance
// `map{ __class: __cls }`, runs `init` if present, and returns it. Construct via
// the colon-call `Name:new(args)`; dispatch methods via `inst:method(args)`
// (see parse_call). Mirrors the Rust class desugaring's class-table + `__class`
// model, adapted to the self-hosted toolchain (no `__call`, no new0..new3).
fn parse_class() {
    advance(); // skip 'class'
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    let cname = name_token.text;

    expect("punct", "{");
    let entries = [];
    push(entries, map{ key: "__class_name", value: expr_string(cname) });
    let init_args = nil;   // non-self param names of `init`, if a ctor is defined
    while not (current().kind == "punct" and current().text == "}") {
        if not (current().kind == "keyword" and current().text == "fn") { break; }
        advance(); // skip 'fn'
        let mname_token = expect("ident", nil);
        if mname_token == nil { break; }
        let mname = mname_token.text;
        expect("punct", "(");
        let params = [];   // plain strings, per expr_fnlit
        if not match_token("punct", ")") {
            while true {
                let pn = expect("ident", nil);
                if pn == nil { break; }
                if match_token("punct", ":") { parse_type(); }   // type ann (ignored)
                if current().kind == "operator" and current().text == "=" { advance(); parse_expr(); } // default (ignored)
                push(params, pn.text);
                if not match_token("punct", ",") { break; }
                if current().kind == "punct" and current().text == ")" { break; } // trailing comma
            }
            expect("punct", ")");
        }
        if match_token("punct", ":") { parse_type(); }   // optional return type
        let body = parse_block();
        push(entries, map{ key: mname, value: expr_fnlit(params, body) });
        if mname == "init" {
            init_args = [];
            let pi = 1;   // skip self
            while pi < len(params) { push(init_args, params[pi]); pi = pi + 1; }
        }
        if current().kind == "punct" and current().text == ";" { advance(); }
    }
    expect("punct", "}");

    // new(__cls, <init args>) { let __o = map{ __class: __cls };
    //                           [__cls.init(__o, <init args>);] return __o; }
    let new_params = ["__cls"];
    if init_args != nil {
        let ni = 0;
        while ni < len(init_args) { push(new_params, init_args[ni]); ni = ni + 1; }
    }
    let o_init = expr_map([ map{ key: "__class", value: expr_ident("__cls") } ]);
    let new_body = [ stmt_let("__o", o_init, nil) ];
    if init_args != nil {
        let call_args = [ expr_ident("__o") ];
        let ci = 0;
        while ci < len(init_args) { push(call_args, expr_ident(init_args[ci])); ci = ci + 1; }
        push(new_body, stmt_expr(expr_call(expr_member(expr_ident("__cls"), "init"), call_args)));
    }
    push(new_body, stmt_return(expr_ident("__o")));
    push(entries, map{ key: "new", value: expr_fnlit(new_params, stmt_block(new_body)) });

    return stmt_let(cname, expr_map(entries), nil);
}

fn parse_return() {
    advance(); // skip 'return'
    let value = nil;
    if not match_token("punct", ";") {
        value = parse_expr();
        if match_token("punct", ";") { /* consume trailing ';' */ }
    }
    return stmt_return(value);
}

// `print EXPR ;` — pblang's print is a statement keyword (not a function), so the
// frontend must parse `print add(2,3)` / `print "hi"` as one print statement, not
// as two stray expression statements. Emits a {kind:"print", value} node that
// codegen_print lowers to OP_PRINT (captured into run output → drives F5 "run").
fn parse_print() {
    advance(); // skip 'print'
    let value = nil;
    if not match_token("punct", ";") {
        value = parse_expr();
        if match_token("punct", ";") { /* consume trailing ';' */ }
    }
    return make_node("print", map{ value: value });
}

// `if <cond> { ... } else { ... }` used as an EXPRESSION (each branch is a block
// whose value is its last expression). Supports `else if` chains.
fn parse_if_expr() {
    advance(); // skip 'if'
    let cond = parse_expr();
    let then_blk = parse_block();
    let else_blk = nil;
    if match_token("keyword", "else") {
        if current().kind == "keyword" and current().text == "if" {
            else_blk = parse_if_expr();   // nested if-expr (else if)
        } else {
            else_blk = parse_block();
        }
    }
    return make_node("if_expr", map{ cond: cond, then: then_blk, else: else_blk });
}

// A match arm's pattern: `_` (wildcard), an ident (binds the scrutinee), or a
// literal/constant expression (matched by `==`).
fn parse_match_pattern() {
    let t = current();
    if t.kind == "ident" and t.text == "_" {
        advance();
        return map{ ptype: "wildcard" };
    }
    if t.kind == "ident" {
        advance();
        return map{ ptype: "bind", name: t.text };
    }
    // number / string / true / false / nil / parenthesized constant
    let lit = parse_primary();
    return map{ ptype: "literal", value: lit };
}

// match expression:
//   match SCRUTINEE {
//       case PATTERN [if GUARD] : BODY ;
//       ...
//       else : BODY ;
//   }
// Patterns: `_` wildcard, ident bind, or literal (matched by `==`). Arms are
// tried top to bottom; the first matching arm's BODY is the value. `else` (or no
// match) yields the else body, or nil if absent.
fn parse_match() {
    advance(); // skip 'match'
    let scrut = parse_expr();
    expect("punct", "{");
    let arms = [];
    let melse = nil;
    while not (current().kind == "punct" and current().text == "}") {
        if current().kind == "keyword" and current().text == "else" {
            advance();
            if current().kind == "punct" and current().text == ":" { advance(); }
            melse = parse_expr();
            if current().kind == "punct" and current().text == ";" { advance(); }
        } else if current().kind == "keyword" and current().text == "case" {
            advance();
            let pat = parse_match_pattern();
            let guard = nil;
            if current().kind == "keyword" and current().text == "if" {
                advance();
                guard = parse_expr();
            }
            expect("punct", ":");
            let body = parse_expr();
            if current().kind == "punct" and current().text == ";" { advance(); }
            push(arms, map{ pattern: pat, guard: guard, body: body });
        } else {
            break; // unexpected token — stop to avoid an infinite loop
        }
    }
    expect("punct", "}");
    return make_node("match", map{ scrutinee: scrut, arms: arms, melse: melse });
}

fn parse_if() {
    advance(); // skip 'if'
    let cond = parse_expr();
    let then_block = parse_block();

    let elifs = [];
    while match_token("keyword", "elif") {
        let elif_cond = parse_expr();
        let elif_body = parse_block();
        push(elifs, map{ cond: elif_cond, body: elif_body });
    }

    let else_block = nil;
    if match_token("keyword", "else") {
        // `else if ...` — treat as an else-block holding a single nested if.
        if current().kind == "keyword" and current().text == "if" {
            else_block = stmt_block([parse_if()]);
        } else {
            else_block = parse_block();
        }
    }

    return stmt_if(cond, then_block, elifs, else_block);
}

fn parse_while() {
    advance(); // skip 'while'
    let cond = parse_expr();
    let body = parse_block();
    return stmt_while(cond, body);
}

fn parse_for() {
    advance(); // skip 'for'
    let varname = expect("ident", nil);
    if varname == nil { return nil; }

    if match_token("keyword", "in") {
        let iterable = parse_expr();
        // for i in LO to HI { }  — inclusive numeric range (`to` is an ident)
        if current().kind == "ident" and current().text == "to" {
            advance();
            let end_expr = parse_expr();
            let body = parse_block();
            return make_node("for_range", map{ name: varname.text, start: iterable, end: end_expr, body: body });
        }
        // for x in expr { }  — iterate an array
        let body = parse_block();
        return stmt_forin(varname.text, iterable, body);
    } else {
        // for i N { }
        let end_expr = parse_expr();
        let body = parse_block();
        return stmt_for(varname.text, end_expr, body);
    }
}

fn parse_import() {
    advance(); // skip 'import'
    expect("punct", "(");
    let path_token = expect("string", nil);
    if path_token == nil { return nil; }
    expect("punct", ")");
    if match_token("punct", ";") { /* consume */ }
    return stmt_import(path_token.text);
}

fn parse_export() {
    advance(); // skip 'export'
    let names = [];
    while true {
        let n = expect("ident", nil);
        if n == nil { break; }
        push(names, n.text);
        if not match_token("punct", ",") { break; }
    }
    if match_token("punct", ";") { /* consume */ }
    return stmt_export(names);
}

fn parse_assignment() {
    let name_token = expect("ident", nil);
    if name_token == nil { return nil; }
    expect("operator", "=");
    let value = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    return stmt_expr(expr_assign(name_token.text, value));
}

fn parse_expr_stmt() {
    let e = parse_expr();
    if match_token("punct", ";") { /* consume */ }
    return stmt_expr(e);
}

fn parse_block() {
    expect("punct", "{");
    let stmts = [];
    while not is_at_end() and current().text != "}" {
        let before = pos;
        let s = parse_stmt();
        if s != nil {
            push(stmts, s);
        }
        if pos == before and not is_at_end() {
            push(errors, "Parser stalled in block at token '" + current().text + "'; skipping");
            advance();
        }
    }
    expect("punct", "}");
    return stmt_block(stmts);
}

// ── Expression parser (Pratt parser / precedence climbing) ────────────────────

fn parse_expr() {
    // Bound recursion so deeply nested expressions yield a recorded error
    // instead of exhausting the VM stack. The counter is balanced on both exit
    // paths and reset per `parse()`.
    _expr_depth = _expr_depth + 1;
    if _expr_depth > MAX_EXPR_DEPTH {
        _expr_depth = _expr_depth - 1;
        push(errors, "expression nested too deeply (max " + str(MAX_EXPR_DEPTH)
            + ") at line " + str(current().line) + ":" + str(current().col));
        return expr_nil();
    }
    let r = parse_assignment_expr();
    _expr_depth = _expr_depth - 1;
    return r;
}

// Null-coalescing: `a ?? b` -> a if a is not nil, else b.
fn parse_coalesce() {
    let left = parse_or();
    while current().kind == "operator" and current().text == "??" {
        advance();
        let right = parse_or();
        left = make_node("coalesce", map{ left: left, right: right });
    }
    return left;
}

fn parse_assignment_expr() {
    let left = parse_coalesce();
    // Assignment: <lvalue> = <expr>. The lvalue is a parsed postfix expression —
    // a bare ident, or an index/member chain (`a[i] = v`, `m.k = v`,
    // `cg.chunk.instructions[j].operand = x`).
    if current().kind == "operator" and current().text == "=" {
        advance();
        let value = parse_assignment_expr();   // right-associative
        if left.kind == "ident" {
            return expr_assign(left.name, value);
        }
        return make_node("assign_to", map{ target: left, value: value });
    }
    return left;
}

fn parse_or() {
    let left = parse_and();
    while (current().kind == "operator" and current().text == "||")
          or (current().kind == "keyword" and current().text == "or") {
        advance();
        let right = parse_and();
        left = expr_binary("or", left, right);
    }
    return left;
}

fn parse_and() {
    let left = parse_equality();
    while (current().kind == "operator" and current().text == "&&")
          or (current().kind == "keyword" and current().text == "and") {
        advance();
        let right = parse_equality();
        left = expr_binary("and", left, right);
    }
    return left;
}

fn parse_equality() {
    let left = parse_comparison();
    while current().kind == "operator" and (current().text == "==" or current().text == "!=") {
        let op = advance().text;
        let right = parse_comparison();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_comparison() {
    let left = parse_bitor();
    while current().kind == "operator"
          and (current().text == "<" or current().text == ">"
               or current().text == "<=" or current().text == ">=") {
        let op = advance().text;
        let right = parse_bitor();
        left = expr_binary(op, left, right);
    }
    return left;
}

// Bitwise infix ladder (§47 port), between comparison and additive, tightest
// last: `|` (loosest) → `^` → `&` → `<<`/`>>` (tightest, just looser than +/-).
// Each desugars to a call to the bit_* builtin (mirrors the Rust parser sugar).
fn parse_bitor() {
    let left = parse_bitxor();
    while current().kind == "operator" and current().text == "|" {
        advance();
        let right = parse_bitxor();
        left = expr_call(expr_ident("bit_or"), [left, right]);
    }
    return left;
}

fn parse_bitxor() {
    let left = parse_bitand();
    while current().kind == "operator" and current().text == "^" {
        advance();
        let right = parse_bitand();
        left = expr_call(expr_ident("bit_xor"), [left, right]);
    }
    return left;
}

fn parse_bitand() {
    let left = parse_shift();
    while current().kind == "operator" and current().text == "&" {
        advance();
        let right = parse_shift();
        left = expr_call(expr_ident("bit_and"), [left, right]);
    }
    return left;
}

fn parse_shift() {
    let left = parse_term();
    while current().kind == "operator"
          and (current().text == "<<" or current().text == ">>") {
        let op = advance().text;
        let right = parse_term();
        let fname = "bit_shl";
        if op == ">>" { fname = "bit_shr"; }
        left = expr_call(expr_ident(fname), [left, right]);
    }
    return left;
}

fn parse_term() {
    let left = parse_factor();
    while current().kind == "operator" and (current().text == "+" or current().text == "-") {
        let op = advance().text;
        let right = parse_factor();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_factor() {
    let left = parse_unary();
    while current().kind == "operator"
          and (current().text == "*" or current().text == "/" or current().text == "%") {
        let op = advance().text;
        let right = parse_unary();
        left = expr_binary(op, left, right);
    }
    return left;
}

fn parse_unary() {
    // `await EXPR` — desugars to `join(EXPR)` (§48 port). Contextual & whitespace-
    // guarded: `await x` / `await (e)` is the keyword, but `await(x)` with `(`
    // ADJACENT (no space) stays an ordinary call to a function named `await`, so
    // the concurrency stdlib's `fn await(...)` keeps working. Adjacency = the `(`
    // begins exactly where `await` ends (col + len("await") == 5).
    if current().kind == "ident" and current().text == "await" {
        let nxt = peek(1);
        let adjacent_call = nxt.kind == "punct" and nxt.text == "("
            and nxt.line == current().line and nxt.col == current().col + 5;
        if not adjacent_call {
            advance();
            let operand = parse_unary();
            return expr_call(expr_ident("join"), [operand]);
        }
    }
    if current().kind == "operator" and (current().text == "-" or current().text == "!") {
        let op = advance().text;
        let operand = parse_unary();
        return expr_unary(op, operand);
    }
    // Prefix `~` — bitwise NOT, desugars to a `bit_not(e)` call (§47 port).
    if current().kind == "operator" and current().text == "~" {
        advance();
        let operand = parse_unary();
        return expr_call(expr_ident("bit_not"), [operand]);
    }
    if current().kind == "keyword" and current().text == "not" {
        advance();
        let operand = parse_unary();
        return expr_unary("not", operand);
    }
    // `throw EXPR` — raise a value (caught by an enclosing `try ... catch`).
    // Parsed as a prefix so it works both as a statement and inside `(throw e)`.
    if current().kind == "keyword" and current().text == "throw" {
        advance();
        let operand = parse_unary();
        return make_node("throw", map{ value: operand });
    }
    return parse_power();
}

// `a ** b` — exponentiation, desugars to `num_pow(a, b)` (mirrors the Rust
// frontend). Right-associative and binds tighter than unary, so `2 ** 3 ** 2`
// is `2 ** (3 ** 2)` and `2 ** -3` parses (exponent goes through parse_unary).
fn parse_power() {
    let base = parse_call();
    if current().kind == "operator" and current().text == "**" {
        advance();
        let exp = parse_unary();
        return expr_call(expr_ident("num_pow"), [base, exp]);
    }
    return base;
}

fn parse_call() {
    let expr = parse_primary();
    let go = true;
    while go {
        if match_token("punct", "(") {
            let args = [];
            if not match_token("punct", ")") {
                while true {
                    push(args, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == ")" { break; } // trailing comma
                }
                expect("punct", ")");
            }
            expr = expr_call(expr, args);
        } else if match_token("punct", "[") {
            let idx = parse_expr();
            expect("punct", "]");
            expr = expr_index(expr, idx);
        } else if match_token("punct", ".") {
            let nm = expect("ident", nil);
            if nm == nil { go = false; } else { expr = expr_member(expr, nm.text); }
        } else if match_token("operator", "?.") {
            // optional member: a?.b -> nil if a is nil
            let nm = expect("ident", nil);
            if nm == nil { go = false; } else { expr = make_node("opt_member", map{ obj: expr, name: nm.text }); }
        } else if match_token("operator", "?[") {
            // optional index: a?[i] -> nil if a is nil
            let idx = parse_expr();
            expect("punct", "]");
            expr = make_node("opt_index", map{ obj: expr, index: idx });
        } else if current().kind == "punct" and current().text == ":"
                  and peek(1).kind == "ident"
                  and peek(2).kind == "punct" and peek(2).text == "(" {
            // Colon-call (method dispatch with implicit self): `obj:method(a, b)`.
            // Desugars to `(obj.__class ?? obj).method(obj, a, b)` — the receiver
            // dispatches via its class table when it's a class instance (carries
            // `__class`), else via itself (a plain method-map). `??` is used (not
            // Rust's `try .. catch`) because the self-hosted VM returns nil — not
            // an error — for a missing map key. The receiver `expr` is inlined, so
            // it should be a simple, side-effect-free lvalue (the common case).
            advance();                       // consume ':'
            let mname = advance().text;       // method name
            advance();                        // consume '('
            let cargs = [];
            if not match_token("punct", ")") {
                while true {
                    push(cargs, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == ")" { break; } // trailing comma
                }
                expect("punct", ")");
            }
            let recv = make_node("coalesce", map{ left: expr_member(expr, "__class"), right: expr });
            let full_args = [expr];
            let ai = 0;
            while ai < len(cargs) { push(full_args, cargs[ai]); ai = ai + 1; }
            expr = expr_call(expr_member(recv, mname), full_args);
        } else {
            go = false;
        }
    }
    return expr;
}

fn parse_primary() {
    let t = current();

    if t.kind == "number" {
        advance();
        return expr_number(t.text);
    }
    if t.kind == "string" {
        advance();
        return expr_string(t.text);
    }
    if t.kind == "ident" {
        advance();
        // `map { ... }` literal — the tokenizer emits `map` as an ident, so we
        // detect it here (the generic ident branch would otherwise swallow it).
        // Keys use `:` which the tokenizer classifies as punct.
        if t.text == "map" and current().kind == "punct" and current().text == "{" {
            advance(); // consume '{'
            let entries = [];
            if not match_token("punct", "}") {
                while true {
                    // key may be an ident, a string literal (`map{ "fn": true }`),
                    // or a keyword used as a name (`map{ else: x, then: y }`)
                    let key_str = nil;
                    if current().kind == "ident" or current().kind == "string" or current().kind == "keyword" {
                        key_str = advance().text;
                    } else {
                        break;
                    }
                    if match_token("punct", ":") {
                        let val = parse_expr();
                        push(entries, map{ key: key_str, value: val });
                    } else {
                        push(entries, map{ key: key_str, value: expr_ident(key_str) });
                    }
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == "}" { break; } // trailing comma
                }
                expect("punct", "}");
            }
            return expr_map(entries);
        }
        return expr_ident(t.text);
    }
    if t.kind == "keyword" {
        if t.text == "true" { advance(); return expr_bool(true); }
        if t.text == "false" { advance(); return expr_bool(false); }
        if t.text == "nil" { advance(); return expr_nil(); }
        if t.text == "import" { advance(); return expr_ident("import"); } // import(...) as expr
        if t.text == "if" { return parse_if_expr(); }
        if t.text == "match" { return parse_match(); }
        if t.text == "try" {
            // `try <expr> catch <expr>` — an expression that yields the body's
            // value, or the handler's value if the body raises.
            advance();
            let body = parse_expr();
            let handler = expr_nil();
            if current().kind == "keyword" and current().text == "catch" {
                advance();
                handler = parse_expr();
            }
            return make_node("try", map{ body: body, handler: handler });
        }
        if t.text == "fn" {
            advance();
            expect("punct", "(");
            let params = [];
            if not match_token("punct", ")") {
                while true {
                    let pn = expect("ident", nil);
                    if pn == nil { break; }
                    push(params, pn.text);
                    if not match_token("punct", ",") { break; }
                }
                expect("punct", ")");
            }
            let body = parse_block();
            return expr_fnlit(params, body);
        }
    }
    if t.kind == "punct" {
        if t.text == "(" {
            advance();
            let e = parse_expr();
            expect("punct", ")");
            return e;
        }
        if t.text == "[" {
            advance();
            let items = [];
            if not match_token("punct", "]") {
                while true {
                    push(items, parse_expr());
                    if not match_token("punct", ",") { break; }
                    if current().kind == "punct" and current().text == "]" { break; } // trailing comma
                }
                expect("punct", "]");
            }
            return expr_array(items);
        }
    }
    if t.kind == "keyword" and t.text == "map" {
        advance();
        expect("punct", "{");
        let entries = [];
        if not match_token("punct", "}") {
            while true {
                let key_token = expect("ident", nil);
                if key_token == nil { break; }
                if match_token("operator", ":") {
                    let val = parse_expr();
                    push(entries, map{ key: key_token.text, value: val });
                } else {
                    push(entries, map{ key: key_token.text, value: expr_ident(key_token.text) });
                }
                if not match_token("punct", ",") { break; }
            }
            expect("punct", "}");
        }
        return expr_map(entries);
    }

    push(errors, "Unexpected token: " + t.kind + " '" + t.text + "' at " + str(t.line) + ":" + str(t.col));
    // Consume unexpected token to avoid infinite loops on malformed inputs.
    if not is_at_end() {
        advance();
    }
    return expr_nil();
}

fn parse_type() {
    let t = current();
    if t.kind == "ident" {
        advance();
        return t.text;
    }
    if t.kind == "punct" and t.text == "[" {
        advance();
        let inner = parse_type();
        expect("punct", "]");
        return "array<" + inner + ">";
    }
    return "any";
}

// ── Utility: print AST for debugging ──────────────────────────────────────────

fn print_ast(node, indent) {
    if indent == nil { indent = 0; }
    let pad = "";
    for i in 0 to indent { pad = pad + "  "; }

    if node == nil {
        print(pad + "nil");
        return;
    }

    if node.kind == nil {
        print(pad + "<no kind>");
        return;
    }

    print(pad + node.kind);

    if node.kind == "number" { print(pad + "  " + node.value); }
    if node.kind == "string" { print(pad + "  \"" + node.value + "\""); }
    if node.kind == "ident" { print(pad + "  " + node.name); }
    if node.kind == "bool" { print(pad + "  " + str(node.value)); }

    if node.kind == "binary" {
        print(pad + "  op: " + node.op);
        print_ast(node.left, indent + 1);
        print_ast(node.right, indent + 1);
    }

    if node.kind == "unary" {
        print(pad + "  op: " + node.op);
        print_ast(node.operand, indent + 1);
    }

    if node.kind == "call" {
        print_ast(node.func, indent + 1);
        print(pad + "  args:");
        for a in node.args {
            print_ast(a, indent + 2);
        }
    }

    if node.kind == "let" or node.kind == "const" {
        print(pad + "  name: " + node.name);
        print_ast(node.value, indent + 1);
    }

    if node.kind == "fn" {
        print(pad + "  name: " + node.name);
        print(pad + "  params:");
        for p in node.params {
            if type(p) == "map" {
                print(pad + "    " + p.name);
            } else {
                print(pad + "    " + p);
            }
        }
        print_ast(node.body, indent + 1);
    }

    if node.kind == "if" {
        print(pad + "  cond:");
        print_ast(node.cond, indent + 1);
        print(pad + "  then:");
        print_ast(node.then, indent + 1);
    }

    if node.kind == "block" {
        for s in node.stmts {
            print_ast(s, indent + 1);
        }
    }

    if node.kind == "return" {
        if node.value != nil {
            print_ast(node.value, indent + 1);
        }
    }

    if node.kind == "array" {
        for item in node.items {
            print_ast(item, indent + 1);
        }
    }

    if node.kind == "assign" {
        print(pad + "  name: " + node.name);
        print_ast(node.value, indent + 1);
    }
}

// ── Self-test: parse this file itself ─────────────────────────────────────────

fn self_test() {
    // (Previously this read its own file via `fsread(import("__FILE__"))`, but
    // `__FILE__` is not a real module — and the self-hosted frontend's import
    // cache eagerly resolves every `import(...)` in the source, so that bogus
    // placeholder made the whole file unloadable. Parse a literal snippet.)
    let tok_mod = import("stdlib/compiler/tokenizer.sapp");
    let tokens = tok_mod.tokenize("fn add(a, b) { return a + b; } let x = add(1, 2);");
    let result = parse(tokens);
    if len(result.errors) > 0 {
        for e in result.errors {
            print("ERROR: " + e);
        }
    } else {
        print("Self-test: parsed successfully, " + str(len(result.stmts)) + " statements");
        for s in result.stmts {
            print_ast(s, 0);
        }
    }
    return result;
}

export parse, print_ast, self_test;
export make_node, stmt_let, stmt_const, stmt_return, stmt_if, stmt_while;
export stmt_for, stmt_forin, stmt_import, stmt_export, stmt_expr, stmt_fn, stmt_block;
export expr_number, expr_string, expr_ident, expr_bool, expr_nil;
export expr_binary, expr_unary, expr_call, expr_array, expr_map, expr_assign;
