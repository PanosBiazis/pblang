//! compiler/diagnostic_suggestions.sapp - bounded deterministic name suggestions.
//!
//! Compiler diagnostics must not turn an invalid identifier into an unbounded
//! CPU or memory workload.  This module keeps edit-distance work inside fixed
//! limits, rejects oversized inputs, de-duplicates candidates, and applies a
//! stable lexical tie-break so results do not depend on map iteration order.

let MAX_NAME_LENGTH = 128;
let MAX_CANDIDATE_LENGTH = 128;
let MAX_CANDIDATES = 4096;
let MAX_DISTANCE = 3;

fn _distance_limit(value) {
    if not is_number(value) or num_floor(value) != value or value < 0 { return 2; }
    if value > MAX_DISTANCE { return MAX_DISTANCE; }
    return value;
}

// Returns max_distance + 1 as soon as the strings are known to be farther
// apart.  Only two rows are retained, so memory is O(candidate length).
fn edit_distance_bounded(a, b, max_distance = 2) {
    max_distance = _distance_limit(max_distance);
    if not is_string(a) or not is_string(b) { return max_distance + 1; }
    let la = len(a); let lb = len(b);
    if la > MAX_NAME_LENGTH or lb > MAX_CANDIDATE_LENGTH { return max_distance + 1; }
    if num_abs(la - lb) > max_distance { return max_distance + 1; }
    if la == 0 { return if lb <= max_distance { lb } else { max_distance + 1 }; }
    if lb == 0 { return if la <= max_distance { la } else { max_distance + 1 }; }

    let prev = []; let j = 0;
    while j <= lb { array_push(prev, j); j = j + 1; }
    let i = 1;
    while i <= la {
        let cur = [i]; let row_min = i; j = 1;
        while j <= lb {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            let value = num_min(prev[j] + 1, num_min(cur[j - 1] + 1, prev[j - 1] + cost));
            array_push(cur, value);
            if value < row_min { row_min = value; }
            j = j + 1;
        }
        if row_min > max_distance { return max_distance + 1; }
        prev = cur; i = i + 1;
    }
    if prev[lb] > max_distance { return max_distance + 1; }
    return prev[lb];
}

fn _threshold(name, options) {
    let threshold = if len(name) <= 3 { 1 } else { 2 };
    if options != nil and is_map(options) and map_has(options, "max_distance") {
        threshold = _distance_limit(options.max_distance);
    }
    return threshold;
}

fn _lexically_before(a, b) {
    let common = num_min(len(a), len(b)); let i = 0;
    while i < common {
        let ac = strcharcodeat(a, i); let bc = strcharcodeat(b, i);
        if ac < bc { return true; }
        if ac > bc { return false; }
        i = i + 1;
    }
    return len(a) < len(b);
}

// Returns metadata for compiler callers that need to report resource bounds.
// `value` is nil when no safe, close candidate exists.
fn suggest(name, candidates, options = nil) {
    if not is_string(name) or len(name) == 0 or len(name) > MAX_NAME_LENGTH
       or type(candidates) != "array" {
        return map{ value: nil, distance: nil, considered: 0, truncated: false };
    }
    let threshold = _threshold(name, options);
    let limit = MAX_CANDIDATES;
    if options != nil and is_map(options) and map_has(options, "max_candidates") {
        let requested = options.max_candidates;
        if is_number(requested) and num_floor(requested) == requested and requested > 0 {
            limit = num_min(requested, MAX_CANDIDATES);
        }
    }

    let best = nil; let best_distance = threshold + 1;
    let seen = map{}; let considered = 0; let i = 0;
    while i < len(candidates) and considered < limit {
        let candidate = candidates[i];
        if is_string(candidate) and len(candidate) > 0 and len(candidate) <= MAX_CANDIDATE_LENGTH
           and candidate != name and not map_has(seen, candidate) {
            seen[candidate] = true; considered = considered + 1;
            let distance = edit_distance_bounded(name, candidate, threshold);
            if distance > 0 and distance <= threshold
               and (best == nil or distance < best_distance
                    or (distance == best_distance and _lexically_before(candidate, best))) {
                best = candidate; best_distance = distance;
            }
        }
        i = i + 1;
    }
    return map{
        value: best,
        distance: if best == nil { nil } else { best_distance },
        considered: considered,
        truncated: i < len(candidates),
    };
}

fn suggest_name(name, candidates, options = nil) {
    return suggest(name, candidates, options).value;
}

fn help_for(suggestion) {
    if suggestion == nil { return nil; }
    return "did you mean `" + suggestion + "`?";
}

export MAX_NAME_LENGTH, MAX_CANDIDATE_LENGTH, MAX_CANDIDATES, MAX_DISTANCE;
export edit_distance_bounded, suggest, suggest_name, help_for;
