// Source-only admission for the retained host's lost lazy-import origin.
// No dependency is resolved, loaded or executed; passing is not provenance.
let SOURCE=import("stdlib:compiler/checked_source.sapp");
let TOKENS=import("stdlib:compiler/tokenizer.sapp");

fn _result(code,counts) {
    let messages=map{
        "import-origin-invalid-source":"source admission failed",
        "import-origin-scan-limit":"source analysis limit exceeded",
        "import-origin-escaped":"import handles cannot escape a direct literal call",
        "import-origin-deferred":"imports inside function or try chunks lack a qualified retained origin; bind dependencies explicitly in trusted application setup",
        "import-origin-dynamic":"import requires one nonempty literal path",
        "import-origin-unclassified":"an import token was not represented by the checked AST",
    };
    let message:any=nil;
    if code!=nil {message=messages[code];}
    return map{ok:code==nil,code:code,message:message,
        counts:counts,dependencies_checked:false,execution_performed:false,runtime_origin_fixed:false};
}
fn _path(value) {
    return type(value)=="string" and len(value)>0 and len(value)<=4096
        and not str_contains(value,strfromcharcode(0));
}
fn check(source) {
    let counts=map{direct:0,deferred:0,dynamic:0,escaped:0};
    let ast=try SOURCE.parse_source(source) catch nil;
    if ast==nil or len(ast.stmts)==0 {return _result("import-origin-invalid-source",counts);}
    // Account for every keyword after parsing/desugaring, rather than
    // qualifying an AST which omitted or duplicated an import. Member/map-key keywords may be
    // conservatively refused as unclassified; no source spelling is returned.
    let lexed=TOKENS.tokenize_bounded(source,65536);let keywords=0;
    for token in lexed.tokens {
        if token.kind=="keyword" and token.text=="import" {keywords=keywords+1;}
    }
    let pending=[[ast,false,0]];let admitted=1;let represented=0;
    while len(pending)>0 {
        let item=array_pop(pending);let node=item[0];let deferred=item[1];let depth=item[2];
        if depth>128 {return _result("import-origin-scan-limit",counts);}
        let children=[];
        if type(node)=="map" {
            let kind=try node.kind catch "";let direct=false;
            if kind=="call" {
                direct=(try node.func.kind catch "")=="ident" and (try node.func.name catch "")=="import";
            }
            if kind=="import" or direct {
                represented=represented+1;
                if deferred {counts.deferred=counts.deferred+1;} else {counts.direct=counts.direct+1;}
                let valid=false;
                if kind=="import" {valid=_path(node.path);}
                elif len(node.args)==1 {
                    valid=(try node.args[0].kind catch "")=="string" and _path(try node.args[0].value catch nil);
                }
                if not valid {counts.dynamic=counts.dynamic+1;}
            } elif kind=="ident" and node.name=="import" {
                represented=represented+1;counts.escaped=counts.escaped+1;
            }
            if kind=="fn" or kind=="fn_lit" or kind=="try" or kind=="defer" {deferred=true;}
            for key in map_keys(node) {
                // Account for a direct import's callee only once. Its argument
                // expressions still need traversal, including nested imports.
                if not (direct and key=="func") {push(children,node[key]);}
            }
        } elif type(node)=="array" {children=node;}
        for child in children {
            if type(child)=="map" or type(child)=="array" {
                if admitted>=262144 {return _result("import-origin-scan-limit",counts);}
                admitted=admitted+1;push(pending,[child,deferred,depth+1]);
            }
        }
    }
    // Fixed precedence keeps diagnostics independent of map traversal order.
    if counts.escaped>0 {return _result("import-origin-escaped",counts);}
    if counts.deferred>0 {return _result("import-origin-deferred",counts);}
    if counts.dynamic>0 {return _result("import-origin-dynamic",counts);}
    if represented!=keywords {return _result("import-origin-unclassified",counts);}
    return _result(nil,counts);
}
export check;
