// Explicit static-linking profile, separate from the single-source compiler
// so callers of native_pbck do not load the optional linker and its dependencies.
let BUNDLE = import("stdlib:selfhost_bundle.sapp");
let PBCK = import("stdlib:selfhost_to_pbck.sapp");

// Resolver supplies trusted source text. Unsupported graphs fail closed;
// execution and capability grants remain the caller's separate responsibility.
fn compile_bundle(source, resolve) {
    let linked = BUNDLE.bundle(source, resolve);
    if not linked.ok { throw "native_bundle: static bundle rejected"; }
    return PBCK.translate(linked.chunk);
}
export compile_bundle;

// Trusted project convenience entry. Imports resolve against the working
// directory using the existing filesystem linker, not the entry's directory.
// Whole-file reads precede admission; this is not a filesystem sandbox.
fn compile_file(path) {
    let linked=BUNDLE.bundle_file(path);
    if not linked.ok { throw "native_bundle: static bundle rejected"; }
    return PBCK.translate(linked.chunk);
}
export compile_file;

fn _guarded_bytes(linked) {
    if not linked.ok {throw "native_bundle: guarded static bundle rejected";}
    let chunk=linked.chunk;let index=len(chunk.instructions)-2;
    if index<0 or chunk.instructions[index].op!=35 or chunk.instructions[index+1].op!=11 {
        throw "native_bundle: unsupported cleanup boundary shape";
    }
    return PBCK.translate_guarded(chunk,index);
}

fn compile_bundle_with_cleanup(source,resolve,entry,cleanup) {
    return _guarded_bytes(BUNDLE.bundle_with_cleanup(source,resolve,entry,cleanup));
}
fn compile_file_with_cleanup(path,entry,cleanup) {
    return _guarded_bytes(BUNDLE.bundle_file_with_cleanup(path,entry,cleanup));
}
export compile_bundle_with_cleanup,compile_file_with_cleanup;

fn compile_bundle_with_lifecycle(source,resolve,initialize,entry,cleanup) {
    return _guarded_bytes(BUNDLE.bundle_with_lifecycle(source,resolve,initialize,entry,cleanup));
}
fn compile_file_with_lifecycle(path,initialize,entry,cleanup) {
    return _guarded_bytes(BUNDLE.bundle_file_with_lifecycle(path,initialize,entry,cleanup));
}
export compile_bundle_with_lifecycle,compile_file_with_lifecycle;

fn compile_file_from_root(path, root_dir = ".") {
    let linked = BUNDLE.bundle_file_from_root(path, root_dir);
    if not linked.ok { throw "native_bundle: static bundle from root rejected"; }
    return PBCK.translate(linked.chunk);
}

fn publish_bundle_safe(main_path, out_path, root_dir = ".") {
    return BUNDLE.write_bundle_safe(main_path, out_path, root_dir);
}
export compile_file_from_root, publish_bundle_safe;

