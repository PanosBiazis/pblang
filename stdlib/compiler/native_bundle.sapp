// Explicit static-linking profile, separate from the single-source compiler
// so callers of native_pbck do not load the optional linker and its dependencies.
let BUNDLE = import("stdlib:selfhost_bundle.sapp");
let PBCK = import("stdlib:selfhost_to_pbck.sapp");

// Resolver supplies trusted source text. Unsupported graphs fail closed;
// execution and capability grants remain the caller's separate responsibility.
fn compile_bundle(source, resolve) {
    let linked = BUNDLE.bundle(source, resolve);
    if not linked.ok { throw "native_bundle: static bundle rejected"; }
    return PBCK.translate(linked.chunk);
}
export compile_bundle;

// Trusted project convenience entry. Imports resolve against the working
// directory using the existing filesystem linker, not the entry's directory.
// Whole-file reads precede admission; this is not a filesystem sandbox.
fn compile_file(path) {
    let linked=BUNDLE.bundle_file(path);
    if not linked.ok { throw "native_bundle: static bundle rejected"; }
    return PBCK.translate(linked.chunk);
}
export compile_file;
