// stdlib/compiler/guard_preprocessor.sapp
//
// Match Guard Preprocessor — converts match guard syntax into equivalent
// if/else chains, bypassing the chumsky parser's limitation with guard
// separators (~, #) in match expressions.
//
// This preprocessor transforms guarded match expressions into immediately-
// invoked function expressions (IIFEs) with if/else chains. The transformation
// happens at the source text level, BEFORE the tokenizer/parser sees the code.
//
// ── Transformation ──────────────────────────────────────────────────────
//
// Input:
//   match x {
//     case n if n > 0 ~ "positive";
//     case n if n < 0 ~ "negative";
//     else: "zero";
//   }
//
// Output:
//   (fn() {
//     let _guard_tmp = x;
//     let _guard_val = nil;
//     if _guard_tmp > 0 { _guard_val = "positive"; }
//     else if _guard_tmp < 0 { _guard_val = "negative"; }
//     else { _guard_val = "zero"; }
//     return _guard_val;
//   })()
//
// ── Supported patterns ──────────────────────────────────────────────────
//
//   case IDENT if CONDITION ~ BODY;
//   case IDENT if CONDITION # BODY;   (legacy separator)
//   else: DEFAULT_BODY;              (else clause)
//
// ── Usage ───────────────────────────────────────────────────────────────
//
//   let gp = import("stdlib/compiler/guard_preprocessor.sapp");
//   let source = "... match x { case n if n > 0 ~ ... } ...";
//   let processed = gp.preprocess(source);
//   // processed is safe to tokenize and parse

// ═══════════════════════════════════════════════════════════════════════════
// Helper: find matching close brace from a given position
// ═══════════════════════════════════════════════════════════════════════════

fn find_matching_brace(src, start) {
    // start is the position of the opening '{'
    // Returns the position of the matching '}' or -1
    let depth = 0;
    let i = start;
    while i < len(src) {
        let ch = str_slice(src, i, i + 1);
        if ch == "{" { depth = depth + 1; }
        if ch == "}" {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        // Skip strings to avoid false brace matches
        if ch == "\"" {
            i = i + 1;
            while i < len(src) and str_slice(src, i, i + 1) != "\"" {
                if str_slice(src, i, i + 1) == "\\" { i = i + 1; }
                i = i + 1;
            }
        }
        i = i + 1;
    }
    return -1;
}

// ═══════════════════════════════════════════════════════════════════════════
// Helper: find keyword in source from a given position
// ═══════════════════════════════════════════════════════════════════════════

fn is_ident_char(ch) {
    // ch is a single-char string
    let code = try strcharcodeat(ch, 0) catch 0;
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 95;
}

fn find_keyword_at(src, pos, keyword) {
    // Check if 'keyword' starts at pos in src, followed by a non-ident char
    let kw_len = len(keyword);
    if pos + kw_len > len(src) { return false; }
    let slice = str_slice(src, pos, pos + kw_len);
    if slice != keyword { return false; }

    // Must be followed by non-ident char (or end of string)
    if pos + kw_len < len(src) {
        let after = str_slice(src, pos + kw_len, pos + kw_len + 1);
        if is_ident_char(after) { return false; }
    }
    return true;
}

fn find_next_match(src, start_pos) {
    // Find the next "match" keyword after start_pos that's NOT inside a string
    let i = start_pos;
    while i < len(src) {
        // Skip strings
        let ch = str_slice(src, i, i + 1);
        if ch == "\"" {
            i = i + 1;
            while i < len(src) and str_slice(src, i, i + 1) != "\"" {
                if str_slice(src, i, i + 1) == "\\" { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
            continue;
        }
        // Skip single-line comments
        if ch == "/" and i + 1 < len(src) and str_slice(src, i + 1, i + 1 + 1) == "/" {
            while i < len(src) and str_slice(src, i, i + 1) != "\n" { i = i + 1; }
            i = i + 1;
            continue;
        }
        // Skip block comments
        if ch == "/" and i + 1 < len(src) and str_slice(src, i + 1, i + 1 + 1) == "*" {
            i = i + 2;
            while i + 1 < len(src) {
                if str_slice(src, i, i + 1) == "*" and str_slice(src, i + 1, i + 1 + 1) == "/" {
                    i = i + 2;
                    break;
                }
                i = i + 1;
            }
            continue;
        }

        if find_keyword_at(src, i, "match") {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ═══════════════════════════════════════════════════════════════════════════
// Core: transform match expression into IIFE
// ═══════════════════════════════════════════════════════════════════════════

fn transform_match(src, match_start) {
    // match_start is the position of the "match" keyword
    // Returns map{ transformed: string, end_pos: number }

    // Find the open brace after "match ..."
    let i = match_start + 5; // skip "match"
    // Skip whitespace
    while i < len(src) and (str_slice(src, i, i + 1) == " " or str_slice(src, i, i + 1) == "\t" or str_slice(src, i, i + 1) == "\n") {
        i = i + 1;
    }

    // Read the scrutinee expression (until '{')
    let scrutinee = "";
    let parens_depth = 0;
    while i < len(src) and (str_slice(src, i, i + 1) != "{" or parens_depth > 0) {
        let ch = str_slice(src, i, i + 1);
        if ch == "(" { parens_depth = parens_depth + 1; }
        if ch == ")" { parens_depth = parens_depth - 1; }
        if ch == "\"" {
            scrutinee = scrutinee + ch;
            i = i + 1;
            while i < len(src) and str_slice(src, i, i + 1) != "\"" {
                scrutinee = scrutinee + str_slice(src, i, i + 1);
                i = i + 1;
            }
            if i < len(src) { scrutinee = scrutinee + str_slice(src, i, i + 1); }
            i = i + 1;
            continue;
        }
        scrutinee = scrutinee + ch;
        i = i + 1;
    }

    if i >= len(src) { return nil; }

    // i is now at the '{' of match body
    let open_brace = i;
    let close_brace = find_matching_brace(src, open_brace);
    if close_brace < 0 { return nil; }

    // Extract match body (everything between { and })
    let body = str_slice(src, open_brace + 1, close_brace);

    // Parse match arms from body
    let arms = [];
    let default_body = nil;
    let pos = 0;
    while pos < len(body) {
        // Skip whitespace
        while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t" or str_slice(body, pos, pos + 1) == "\n" or str_slice(body, pos, pos + 1) == ";") {
            pos = pos + 1;
        }
        if pos >= len(body) or str_slice(body, pos, pos + 1) == "}" { break; }

        // Check for "else"
        if pos + 3 < len(body) and str_slice(body, pos, pos + 4) == "else" {
            pos = pos + 4;
            // Skip whitespace, optional ':'
            while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t" or str_slice(body, pos, pos + 1) == "\n" or str_slice(body, pos, pos + 1) == ":") {
                pos = pos + 1;
            }
            // Read default expression until ; or end
            let val = "";
            while pos < len(body) {
                let ch = str_slice(body, pos, pos + 1);
                if ch == "\"" {
                    val = val + ch;
                    pos = pos + 1;
                    while pos < len(body) and str_slice(body, pos, pos + 1) != "\"" {
                        val = val + str_slice(body, pos, pos + 1);
                        pos = pos + 1;
                    }
                    if pos < len(body) { val = val + str_slice(body, pos, pos + 1); }
                    pos = pos + 1;
                    continue;
                }
                if ch == ";" { break; }
                val = val + ch;
                pos = pos + 1;
            }
            default_body = str_trim(val);
            if str_ends_with(default_body, ";") {
                default_body = str_slice(default_body, 0, len(default_body) - 1);
            }
            break;
        }

        // Check for "case"
        if pos + 3 < len(body) and str_slice(body, pos, pos + 4) == "case" {
            pos = pos + 4;
            // Skip whitespace
            while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t") {
                pos = pos + 1;
            }
            // Read bind name
            let bind_name = "";
            while pos < len(body) and is_ident_char(str_slice(body, pos, pos + 1)) {
                bind_name = bind_name + str_slice(body, pos, pos + 1);
                pos = pos + 1;
            }

            // Skip whitespace
            while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t") {
                pos = pos + 1;
            }

            // Check for "if" (guarded arm)
            let guard = nil;
            if pos + 1 < len(body) and str_slice(body, pos, pos + 2) == "if" {
                let after_if = pos + 2;
                if after_if < len(body) and not is_ident_char(str_slice(body, after_if, after_if + 1)) {
                    pos = pos + 2;
                    // Read guard condition until ~, #, or end at ; boundary
                    while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t") {
                        pos = pos + 1;
                    }
                    guard = "";
                    while pos < len(body) {
                        let gc = str_slice(body, pos, pos + 1);
                        if gc == "~" or gc == "#" { pos = pos + 1; break; }
                        guard = guard + gc;
                        pos = pos + 1;
                    }
                }
            } else if pos + 0 < len(body) and str_slice(body, pos, pos + 1) == ":" {
                // unguarded arm: case name: body;
                pos = pos + 1;
            }

            if guard == nil { guard = ""; } // unguarded = always true

            // Skip whitespace/seps to body
            while pos < len(body) and (str_slice(body, pos, pos + 1) == " " or str_slice(body, pos, pos + 1) == "\t" or str_slice(body, pos, pos + 1) == "~" or str_slice(body, pos, pos + 1) == "#") {
                pos = pos + 1;
            }

            // Read body expression until ;
            let val = "";
            while pos < len(body) {
                let vc = str_slice(body, pos, pos + 1);
                if vc == "\"" {
                    val = val + vc;
                    pos = pos + 1;
                    while pos < len(body) and str_slice(body, pos, pos + 1) != "\"" {
                        val = val + str_slice(body, pos, pos + 1);
                        pos = pos + 1;
                    }
                    if pos < len(body) { val = val + str_slice(body, pos, pos + 1); }
                    pos = pos + 1;
                    continue;
                }
                if vc == ";" { pos = pos + 1; break; }
                val = val + vc;
                pos = pos + 1;
            }

            if bind_name != "" {
                let arm_body = str_trim(val);
                if str_ends_with(arm_body, ";") {
                    arm_body = str_slice(arm_body, 0, len(arm_body) - 1);
                }
                let condition = "";
                if guard == "" or str_trim(guard) == "" {
                    // Unguarded: bind the scrutinee value (no condition check needed)
                    // We still create a condition that's always true
                    condition = "true";
                } else {
                    // Replace bind name with _guard_tmp in the guard condition
                    condition = replace_ident(guard, bind_name, "_guard_tmp");
                }
                array_push(arms, map{
                    condition: str_trim(condition),
                    body: arm_body,
                    bind: bind_name,
                });
            }
        } else {
            // Skip unknown tokens
            pos = pos + 1;
        }
    }

    // Build the IIFE
    let result = "(fn() {\n";
    result = result + "  let _guard_tmp = " + str_trim(scrutinee) + ";\n";
    result = result + "  let _guard_val = nil;\n";

    let a_idx = 0;
    while a_idx < len(arms) {
        let arm = arms[a_idx];
        if a_idx == 0 {
            // If the guard is "" or unguarded, replace condition with "true"
            let cond = arm.condition;
            if cond == "" { cond = "true"; }
            result = result + "  if (" + cond + ") { _guard_val = " + arm.body + "; }\n";
        } else {
            let cond = arm.condition;
            if cond == "" { cond = "true"; }
            result = result + "  else if (" + cond + ") { _guard_val = " + arm.body + "; }\n";
        }
        a_idx = a_idx + 1;
    }

    if default_body != nil {
        result = result + "  else { _guard_val = " + default_body + "; }\n";
    }

    result = result + "  return _guard_val;\n";
    result = result + "})()";

    return map{ transformed: result, end_pos: close_brace + 1 };
}

// ═══════════════════════════════════════════════════════════════════════════
// Helper: replace all occurrences of an identifier in text
// ═══════════════════════════════════════════════════════════════════════════

fn replace_ident(text, old_name, new_name) {
    let out = "";
    let i = 0;
    while i < len(text) {
        if find_keyword_at(text, i, old_name) or (
            str_slice(text, i, i + len(old_name)) == old_name and
            (i + len(old_name) >= len(text) or not is_ident_char(str_slice(text, i + len(old_name), i + len(old_name) + 1)))
        ) {
            let before_ok = i == 0 or not is_ident_char(str_slice(text, i - 1, i));
            if before_ok {
                out = out + new_name;
                i = i + len(old_name);
                continue;
            }
        }
        out = out + str_slice(text, i, i + 1);
        i = i + 1;
    }
    return out;
}

// ═══════════════════════════════════════════════════════════════════════════
// Main preprocess function
// ═══════════════════════════════════════════════════════════════════════════

fn preprocess(source) {
    if source == nil or source == "" {
        return source;
    }

    // Only transform sources that use the LEGACY guard separators (` ~ ` / ` # `).
    // The self-hosted parser handles `match` natively — including `case PAT if
    // GUARD : BODY` and literal patterns — so a native colon-syntax match must be
    // left untouched. Transforming it would rewrite each `case LITERAL :` arm into
    // `if (true)`, making the first arm always win (a silent miscompile). This
    // preprocessor is a workaround for an obsolete parser limitation; gate it so
    // it is a no-op for everything except the legacy `~`/`#` guard syntax.
    if not has_guards(source) {
        return source;
    }

    let result = "";
    let pos = 0;
    let transformed_count = 0;

    while true {
        let match_pos = find_next_match(source, pos);
        if match_pos < 0 {
            // No more match expressions — copy remainder
            result = result + str_slice(source, pos, len(source));
            break;
        }

        // Copy everything before the match
        result = result + str_slice(source, pos, match_pos);

        // Try to transform
        let tf = transform_match(source, match_pos);
        if tf != nil {
            result = result + tf.transformed;
            pos = tf.end_pos;
            transformed_count = transformed_count + 1;
        } else {
            // Failed to transform — copy "match" literally and advance
            result = result + "match";
            pos = match_pos + 5;
        }
    }

    return result;
}

/// Check whether source contains match guard syntax that needs preprocessing.
fn has_guards(source) {
    return str_contains(source, " ~ ") or str_contains(source, " # ");
}

/// Preprocess and return stats about transformations performed.
fn preprocess_with_stats(source) {
    let out = preprocess(source);
    let changed = out != source;
    return map{
        source: out,
        changed: changed,
        size_before: len(source),
        size_after: len(out),
    };
}

export preprocess, has_guards, preprocess_with_stats, transform_match;
export find_matching_brace, find_next_match, replace_ident;
