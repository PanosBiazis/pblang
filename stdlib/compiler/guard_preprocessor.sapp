// stdlib/compiler/guard_preprocessor.sapp
//
// Match Guard Preprocessor — converts match guard syntax into equivalent
// if/else chains, bypassing the chumsky parser's limitation with guard
// separators (~, #) in match expressions.
//
// This preprocessor transforms guarded match expressions into immediately-
// invoked function expressions (IIFEs) with if/else chains. The transformation
// happens at the source text level, BEFORE the tokenizer/parser sees the code.
//
// ── Transformation ──────────────────────────────────────────────────────
//
// Input:
//   match x {
//     case n if n > 0 ~ "positive";
//     case n if n < 0 ~ "negative";
//     else: "zero";
//   }
//
// Output:
//   (fn() {
//     let _guard_tmp = x;
//     let _guard_val = nil;
//     if _guard_tmp > 0 { _guard_val = "positive"; }
//     else if _guard_tmp < 0 { _guard_val = "negative"; }
//     else { _guard_val = "zero"; }
//     return _guard_val;
//   })()
//
// ── Supported patterns ──────────────────────────────────────────────────
//
//   case IDENT if CONDITION ~ BODY;
//   case IDENT if CONDITION # BODY;   (legacy separator)
//   else: DEFAULT_BODY;              (else clause)
//
// ── Usage ───────────────────────────────────────────────────────────────
//
//   let gp = import("stdlib/compiler/guard_preprocessor.sapp");
//   let source = "... match x { case n if n > 0 ~ ... } ...";
//   let processed = gp.preprocess(source);
//   // Validate processed with the checked frontend before code generation.
//
// Partial legacy adapter: only guarded ASCII identifiers and an optional else
// are lowered. Unsupported comments/nesting/colon patterns remain unchanged.
// Generated-name hygiene and general expression semantics remain limited.

// ═══════════════════════════════════════════════════════════════════════════
// Helpers: quoted source spans and matching close braces
// ═══════════════════════════════════════════════════════════════════════════

// Exclusive end of a double-quoted source literal, without decoding its text.
// A backslash consumes the following scalar, so odd/even escape parity agrees
// with the tokenizer. Unterminated input never yields a usable end position.
fn _string_end(src, start) {
    let i = start + 1;
    while i < len(src) {
        let ch = str_slice(src, i, i + 1);
        if ch == "\\" {
            if i + 1 >= len(src) { return -1; }
            i = i + 2;
        } else if ch == "\"" {
            return i + 1;
        } else {
            i = i + 1;
        }
    }
    return -1;
}

let _TOKENIZER = import("stdlib:compiler/tokenizer.sapp");

// Comment discovery only. Transform admission conservatively rejects comments
// within an expression rather than attempting to reinterpret their contents.
fn _comment_end(src, pos) {
    let pair = str_slice(src, pos, pos + 2);
    if pair == "//" {
        let i = pos + 2;
        while i < len(src) and str_slice(src, i, i + 1) != "\n" { i = i + 1; }
        return i;
    }
    if pair == "/*" {
        let i = pos + 2;
        while i + 1 < len(src) {
            if str_slice(src, i, i + 2) == "*/" { return i + 2; }
            i = i + 1;
        }
        return -1;
    }
    return pos;
}

fn _word_char(ch) {
    // Conservatively keep non-ASCII neighbors attached to identifiers.
    return is_ident_char(ch) or (try strcharcodeat(ch, 0) catch 0) >= 128;
}

fn _word_at(src, pos, word) {
    if pos < 0 or str_slice(src, pos, pos + len(word)) != word { return false; }
    if pos > 0 and _word_char(str_slice(src, pos - 1, pos)) { return false; }
    let end = pos + len(word);
    return end >= len(src) or not _word_char(str_slice(src, end, end + 1));
}

fn _skip_space(src, pos) {
    while pos < len(src) {
        let ch = str_slice(src, pos, pos + 1);
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n" { break; }
        pos = pos + 1;
    }
    return pos;
}

// Read one supported expression up to its own top-level delimiter. Quoted
// slices and balanced ()/[] are opaque to separator discovery; braces/comments
// and misplaced delimiters reject the whole transform, not just a partial arm.
fn _legacy_expr(src, start, mode) {
    let i = start;
    let stack = [];
    while i < len(src) {
        let ch = str_slice(src, i, i + 1);
        if ch == "\"" {
            let end = _string_end(src, i);
            if end < 0 { return nil; }
            i = end; continue;
        }
        let pair = str_slice(src, i, i + 2);
        if pair == "//" or pair == "/*" { return nil; }
        if ch == "(" or ch == "[" {
            if len(stack) >= 64 { return nil; }
            array_push(stack, ch); i = i + 1; continue;
        }
        if ch == ")" or ch == "]" {
            if len(stack) == 0 { return nil; }
            let open = array_pop(stack);
            if (ch == ")" and open != "(") or (ch == "]" and open != "[") { return nil; }
            i = i + 1; continue;
        }
        let delimiter = (mode == "scrutinee" and ch == "{")
            or (mode == "guard" and (ch == "~" or ch == "#"))
            or (mode == "value" and ch == ";");
        if delimiter and len(stack) == 0 {
            let text = str_trim(str_slice(src, start, i));
            if text == "" { return nil; }
            return map{ text: text, end: i, delimiter: ch };
        }
        if ch == "{" or ch == "}" or ch == ":" or ch == ";" or ch == "~" or ch == "#" {
            return nil;
        }
        i = i + 1;
    }
    return nil;
}

fn find_matching_brace(src, start) {
    // start is the position of the opening '{'
    // Returns the position of the matching '}' or -1
    let depth = 0;
    let i = start;
    while i < len(src) {
        let ch = str_slice(src, i, i + 1);
        let comment_end = _comment_end(src, i);
        if comment_end < 0 { return -1; }
        if comment_end != i { i = comment_end; continue; }
        if ch == "{" { depth = depth + 1; }
        if ch == "}" {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        // Skip strings to avoid false brace matches
        if ch == "\"" {
            let end = _string_end(src, i);
            if end < 0 { return -1; }
            i = end;
            continue;
        }
        i = i + 1;
    }
    return -1;
}

// ═══════════════════════════════════════════════════════════════════════════
// Helper: find keyword in source from a given position
// ═══════════════════════════════════════════════════════════════════════════

fn is_ident_char(ch) {
    // ch is a single-char string
    let code = try strcharcodeat(ch, 0) catch 0;
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 95;
}

fn find_keyword_at(src, pos, keyword) {
    // Check if 'keyword' starts at pos in src, followed by a non-ident char
    let kw_len = len(keyword);
    if pos + kw_len > len(src) { return false; }
    let slice = str_slice(src, pos, pos + kw_len);
    if slice != keyword { return false; }

    // Must be followed by non-ident char (or end of string)
    if pos + kw_len < len(src) {
        let after = str_slice(src, pos + kw_len, pos + kw_len + 1);
        if is_ident_char(after) { return false; }
    }
    return true;
}

fn find_next_match(src, start_pos) {
    // Find the next "match" keyword after start_pos that's NOT inside a string
    let i = start_pos;
    while i < len(src) {
        // Skip strings
        let ch = str_slice(src, i, i + 1);
        if ch == "\"" {
            let end = _string_end(src, i);
            if end < 0 { return -1; }
            i = end;
            continue;
        }
        let comment_end = _comment_end(src, i);
        if comment_end < 0 { return -1; }
        if comment_end != i { i = comment_end; continue; }

        if _word_at(src, i, "match") {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ═══════════════════════════════════════════════════════════════════════════
// Core: transform match expression into IIFE
// ═══════════════════════════════════════════════════════════════════════════

fn transform_match(src, match_start) {
    // Only complete guarded-identifier legacy arms are admitted. Native colon
    // patterns and unsupported forms return nil with no partial generated code.
    if not _word_at(src, match_start, "match") { return nil; }
    let subject = _legacy_expr(src, match_start + 5, "scrutinee");
    if subject == nil { return nil; }
    let scrutinee = subject.text;
    let close_brace = find_matching_brace(src, subject.end);
    if close_brace < 0 { return nil; }
    let body = str_slice(src, subject.end + 1, close_brace);
    let arms = [];
    let default_body = "";
    let has_default_body = false;
    let pos = _skip_space(body, 0);
    while pos < len(body) {
        if _word_at(body, pos, "else") {
            if len(arms) == 0 { return nil; }
            pos = _skip_space(body, pos + 4);
            if str_slice(body, pos, pos + 1) != ":" { return nil; }
            let fallback = _legacy_expr(body, pos + 1, "value");
            if fallback == nil { return nil; }
            default_body = fallback.text;
            has_default_body = true;
            pos = _skip_space(body, fallback.end + 1);
            if pos != len(body) { return nil; }
            break;
        }
        if not _word_at(body, pos, "case") { return nil; }
        pos = _skip_space(body, pos + 4);
        let name_start = pos;
        let first = str_slice(body, pos, pos + 1);
        let code = try strcharcodeat(first, 0) catch 0;
        if not ((code >= 65 and code <= 90) or (code >= 97 and code <= 122) or code == 95) { return nil; }
        while pos < len(body) and is_ident_char(str_slice(body, pos, pos + 1)) { pos = pos + 1; }
        let bind_name = str_slice(body, name_start, pos);
        if _TOKENIZER.is_keyword(bind_name) { return nil; }
        pos = _skip_space(body, pos);
        if not _word_at(body, pos, "if") { return nil; }
        let guard = _legacy_expr(body, pos + 2, "guard");
        if guard == nil { return nil; }
        let value = _legacy_expr(body, guard.end + 1, "value");
        if value == nil { return nil; }
        array_push(arms, map{
            condition: str_trim(replace_ident(guard.text, bind_name, "_guard_tmp")),
            body: value.text,
            bind: bind_name
        });
        pos = _skip_space(body, value.end + 1);
    }
    if len(arms) == 0 { return nil; }

    // Build the IIFE
    let result = "(fn() {\n";
    result = result + "  let _guard_tmp = " + str_trim(scrutinee) + ";\n";
    result = result + "  let _guard_val = nil;\n";

    let a_idx = 0;
    while a_idx < len(arms) {
        let arm = arms[a_idx];
        if a_idx == 0 {
            // If the guard is "" or unguarded, replace condition with "true"
            let cond = arm.condition;
            if cond == "" { cond = "true"; }
            result = result + "  if (" + cond + ") { _guard_val = " + arm.body + "; }\n";
        } else {
            let cond = arm.condition;
            if cond == "" { cond = "true"; }
            result = result + "  else if (" + cond + ") { _guard_val = " + arm.body + "; }\n";
        }
        a_idx = a_idx + 1;
    }

    if has_default_body {
        result = result + "  else { _guard_val = " + default_body + "; }\n";
    }

    result = result + "  return _guard_val;\n";
    result = result + "})()";

    return map{ transformed: result, end_pos: close_brace + 1 };
}

// ═══════════════════════════════════════════════════════════════════════════
// Helper: replace all occurrences of an identifier in text
// ═══════════════════════════════════════════════════════════════════════════

fn replace_ident(text, old_name, new_name) {
    if old_name == "" { return text; }
    let out = "";
    let i = 0;
    while i < len(text) {
        if str_slice(text, i, i + 1) == "\"" {
            let end = _string_end(text, i);
            if end < 0 { return text; }
            out = out + str_slice(text, i, end);
            i = end;
            continue;
        }
        if _word_at(text, i, old_name) {
            out = out + new_name;
            i = i + len(old_name);
            continue;
        }
        out = out + str_slice(text, i, i + 1);
        i = i + 1;
    }
    return out;
}

// ═══════════════════════════════════════════════════════════════════════════
// Main preprocess function
// ═══════════════════════════════════════════════════════════════════════════

fn preprocess(source) {
    if source == nil or source == "" {
        return source;
    }

    // Coarse fast path only; transform_match validates each candidate independently.
    // Only transform sources that use the LEGACY guard separators (` ~ ` / ` # `).
    // The self-hosted parser handles `match` natively — including `case PAT if
    // GUARD : BODY` and literal patterns — so a native colon-syntax match must be
    // left untouched. Transforming it would rewrite each `case LITERAL :` arm into
    // `if (true)`, making the first arm always win (a silent miscompile). This
    // preprocessor is a workaround for an obsolete parser limitation; gate it so
    // it is a no-op for everything except the legacy `~`/`#` guard syntax.
    if not has_guards(source) {
        return source;
    }

    let result = "";
    let pos = 0;
    let transformed_count = 0;

    while true {
        let match_pos = find_next_match(source, pos);
        if match_pos < 0 {
            // No more match expressions — copy remainder
            result = result + str_slice(source, pos, len(source));
            break;
        }

        // Copy everything before the match
        result = result + str_slice(source, pos, match_pos);

        // Try to transform
        let tf = transform_match(source, match_pos);
        if tf != nil {
            result = result + tf.transformed;
            pos = tf.end_pos;
            transformed_count = transformed_count + 1;
        } else {
            // Failed to transform — copy "match" literally and advance
            result = result + "match";
            pos = match_pos + 5;
        }
    }

    return result;
}

/// Coarse candidate hint only; strings/comments can match. Not rewrite authority.
fn has_guards(source) {
    return str_contains(source, " ~ ") or str_contains(source, " # ");
}

/// Preprocess and return stats about transformations performed.
fn preprocess_with_stats(source) {
    let out = preprocess(source);
    let changed = out != source;
    return map{
        source: out,
        changed: changed,
        size_before: len(source),
        size_after: len(out),
    };
}

export preprocess, has_guards, preprocess_with_stats, transform_match;
export find_matching_brace, find_next_match, replace_ident;
