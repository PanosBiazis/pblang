// stdlib/compiler/vm.sapp — a stack-machine interpreter for the bytecode IR
// emitted by stdlib/compiler/codegen.sapp. This closes the self-hosting loop:
// pblang source -> pblang compiler (frontend_compile) -> THIS pblang VM -> output.
//
// The chunk shape is { instructions: [{op, operand}, ...], constants: [...] }.
// Opcode numbers MUST match codegen.sapp. `*_LOCAL` operands are slot indices;
// `*_GLOBAL` operands are constant indices holding the variable name; `JUMP*`
// operands are absolute instruction indices.

let _vm_builtin_module = import("stdlib/compiler/vm_builtins.sapp");
let _MEMORY = import("stdlib/compiler/vm_memory.sapp");
let _MEMORY_NAMES = _MEMORY.registry();

fn execution_context() { return map{memory:nil}; }
fn close_execution(execution) {
    if execution.memory != nil { _MEMORY.close(execution.memory); execution.memory = nil; }
}


let OP_CONSTANT = 0;
let OP_ADD = 1;
let OP_SUB = 2;
let OP_MUL = 3;
let OP_DIV = 4;
let OP_EQ = 5;
let OP_NOT_EQ = 6;
let OP_GT = 7;
let OP_GE = 8;
let OP_LT = 9;
let OP_LE = 10;
let OP_POP = 11;
let OP_PRINT = 12;
let OP_DEFINE_GLOBAL = 13;
let OP_GET_GLOBAL = 14;
let OP_SET_GLOBAL = 15;
let OP_GET_LOCAL = 16;
let OP_SET_LOCAL = 17;
let OP_CALL = 18;
let OP_RETURN = 19;
let OP_JUMP = 20;
let OP_JUMP_IF_FALSE = 21;
let OP_JUMP_IF_TRUE = 22;
let OP_NOT = 23;
let OP_CLOSURE = 24;
let OP_MAKE_ARRAY = 25;
let OP_MAKE_MAP = 26;
let OP_GET_INDEX = 27;
let OP_SET_INDEX = 28;
let OP_GET_ATTR = 29;
let OP_SET_ATTR = 30;
let OP_MOD = 31;
let OP_LEN = 32;
let OP_JUMP_IF_FALSE_PEEK = 33;
let OP_JUMP_IF_TRUE_PEEK = 34;
let OP_TRY = 35;
let OP_JUMP_IF_NIL_PEEK = 36;
let OP_JUMP_IF_NOT_NIL_PEEK = 37;
let OP_GET_UPVALUE = 38;
let OP_SET_UPVALUE = 39;
let OP_THROW = 40;
let OP_ADD_LOCAL_CONST = 41;
let OP_ADD_LOCAL_LOCAL = 42;

fn _option(options, key, fallback) {
    if options != nil and is_map(options) and map_has(options, key) { return options[key]; }
    return fallback;
}

fn _limit(options, key, fallback, hard_max) {
    let value = _option(options, key, fallback);
    if not is_number(value) or value < 1 or value != num_floor(value) or value > hard_max {
        throw "self-host VM: " + key + " must be a positive integer <= " + str(hard_max);
    }
    return value;
}

// Validated limits for untrusted or user-authored source. These protect VM-owned
// execution state; host kernel, driver, firmware and DMA isolation remain outside
// a language runtime's authority.
fn runtime_limits(options = nil) {
    if options != nil and not is_map(options) { throw "self-host VM: options must be a map"; }
    return map{
        max_steps: _limit(options, "max_steps", 1000000, 100000000),
        max_frames: _limit(options, "max_frames", 256, 4096),
        max_stack: _limit(options, "max_stack", 4096, 1048576),
        max_locals: _limit(options, "max_locals", 65536, 1048576),
        max_output: _limit(options, "max_output", 65536, 1048576),
        max_value_items: _limit(options, "max_value_items", 1048576, 16777216)
    };
}

fn _runtime(options) {
    let lim = runtime_limits(options);
    return map{
        max_steps: lim.max_steps, max_frames: lim.max_frames,
        max_stack: lim.max_stack, max_locals: lim.max_locals,
        max_output: lim.max_output, max_value_items: lim.max_value_items,
        steps: 0, peak_frames: 0, peak_stack: 0, peak_locals: 0, peak_output: 0,
        tripped: false, reason: ""
    };
}

fn _trip(runtime, reason) {
    runtime.tripped = true;
    runtime.reason = reason;
    throw "self-host VM: " + reason;
}

fn _guard_value(runtime, value) {
    if runtime == nil { return; }
    if (is_string(value) or is_array(value) or is_map(value)) and len(value) > runtime.max_value_items {
        _trip(runtime, "value size limit exceeded");
    }
}

fn _output_push(out, value, runtime) {
    if runtime != nil and len(out) >= runtime.max_output { _trip(runtime, "output limit exceeded"); }
    _guard_value(runtime, value);
    array_push(out, value);
    if runtime != nil and len(out) > runtime.peak_output { runtime.peak_output = len(out); }
}

fn _truthy(c) {
    if c == false or c == nil or c == 0 { return false; }
    return true;
}

// Host builtins callable from self-hosted code. Build the membership table once
// when the module loads; OP_GET_GLOBAL executes this lookup for every builtin
// call, so a hash lookup avoids repeatedly scanning a long string chain. The
// table stores booleans only: each lookup still creates its own mutable builtin
// descriptor, preserving the previous first-class-value semantics.
let _BUILTINS = _vm_builtin_module.registry();

fn _is_builtin(name) { return map_has(_BUILTINS, name); }

fn _guard_allocation(runtime, requested, label) {
    if runtime != nil and (not is_number(requested) or requested < 0 or requested > runtime.max_value_items) {
        _trip(runtime, label + " allocation limit exceeded");
    }
}

fn _guard_push(runtime, container, label) {
    if runtime != nil and len(container) >= runtime.max_value_items {
        _trip(runtime, label + " size limit exceeded");
    }
}

// Admission for mutation must precede the host write: SET consumes its target,
// so a later stack tick need not see the enlarged collection at all. Preserve
// the retained host's index typing, truncation and errors for non-growing writes.
fn _guard_index_growth(runtime, target, index) {
    if is_array(target) {
        // The host truncates number indices toward zero and permits append only
        // at len(target). Runtime limits are positive, so an empty-array append
        // (including host NaN/-fraction conversion to zero) cannot exceed them.
        let count = len(target);
        if count >= runtime.max_value_items and is_number(index)
            and index >= count and index < count + 1 {
            _trip(runtime, "array size limit exceeded");
        }
    } elif is_map(target) and is_string(index) {
        if len(target) >= runtime.max_value_items and not map_has(target,index) {
            _trip(runtime, "map size limit exceeded");
        }
    }
}

// Count only when the worst-case UTF-8 size does not already fit the caller's
// explicit budget. Split long strings so repeated scalar indexing cannot turn
// into a quadratic scan of the entire input. No output byte array is allocated.
fn _utf8_size(value, remaining, runtime) {
    let count = len(value);
    if count > remaining { _trip(runtime, "str_to_bytes allocation limit exceeded"); }
    if count > 128 {
        let middle = num_floor(count / 2);
        let first = _utf8_size(str_slice(value, 0, middle), remaining, runtime);
        return first + _utf8_size(str_slice(value, middle, count), remaining - first, runtime);
    }
    if runtime.tripped { throw "self-host VM: " + runtime.reason; }
    if count > runtime.max_steps - runtime.steps { _trip(runtime, "step limit exceeded"); }
    runtime.steps = runtime.steps + count;
    let bytes = 0;
    for i count {
        let cp = strcharcodeat(value, i);
        if cp < 128 { bytes = bytes + 1; }
        elif cp < 2048 { bytes = bytes + 2; }
        elif cp < 65536 { bytes = bytes + 3; }
        else { bytes = bytes + 4; }
        if bytes > remaining { _trip(runtime, "str_to_bytes allocation limit exceeded"); }
    }
    return bytes;
}

fn _string_bytes(value, runtime) {
    if type(value) != "string" { throw "str_to_bytes() expects a string"; }
    if runtime != nil {
        let count = len(value);
        _guard_allocation(runtime, count, "str_to_bytes");
        if count > num_floor(runtime.max_value_items / 4) {
            _utf8_size(value, runtime.max_value_items, runtime);
        }
    }
    return str_to_bytes(value);
}

fn _call_builtin(name, args, runtime = nil, execution = nil) {
    if map_has(_MEMORY_NAMES, name) {
        if execution == nil { throw "self-host memory: missing execution context"; }
        if execution.memory == nil { execution.memory = _MEMORY.new_state(); }
        if (name == "allocate" or name == "memory_alloc") and len(args) > 0 { _guard_value(runtime, args[0]); }
        if (name == "store" or name == "memory_set") and len(args) > 1 { _guard_value(runtime, args[1]); }
        return _MEMORY.dispatch(execution.memory, name, args, 1);
    }
    if name == "len" { return len(args[0]); }
    if name == "str" { return str(args[0]); }
    if name == "print" { return nil; }
    if name == "array_push" { _guard_push(runtime, args[0], "array"); return array_push(args[0], args[1]); }
    if name == "array_pop" { return array_pop(args[0]); }
    if name == "str_split" { return str_split(args[0], args[1]); }
    if name == "str_upper" { return str_upper(args[0]); }
    if name == "str_lower" { return str_lower(args[0]); }
    if name == "str_slice" { return str_slice(args[0], args[1], args[2]); }
    if name == "slice" { return slice(args[0], args[1], args[2]); }
    if name == "str_trim" { return str_trim(args[0]); }
    if name == "str_contains" { return str_contains(args[0], args[1]); }
    if name == "str_starts_with" { return str_starts_with(args[0], args[1]); }
    if name == "str_ends_with" { return str_ends_with(args[0], args[1]); }
    if name == "str_index_of" { return str_index_of(args[0], args[1]); }
    if name == "str_join" { return str_join(args[0], args[1]); }
    if name == "parse_number" { return parse_number(args[0]); }
    if name == "parse_bool" { return parse_bool(args[0]); }
    if name == "num_floor" { return num_floor(args[0]); }
    if name == "num_abs" { return num_abs(args[0]); }
    if name == "num_sqrt" { return num_sqrt(args[0]); }
    if name == "num_mod" { return num_mod(args[0], args[1]); }
    if name == "num_max" { return num_max(args[0], args[1]); }
    if name == "num_min" { return num_min(args[0], args[1]); }
    if name == "num_pow" { return num_pow(args[0], args[1]); }
    if name == "num_ceil" { return num_ceil(args[0]); }
    if name == "map_has" { return map_has(args[0], args[1]); }
    if name == "map_keys" { return map_keys(args[0]); }
    if name == "map_remove" { return map_remove(args[0], args[1]); }
    if name == "strcharcodeat" { return strcharcodeat(args[0], args[1]); }
    if name == "strfromcharcode" { return strfromcharcode(args[0]); }
    if name == "str_from_char_code" { return str_from_char_code(args[0]); }
    if name == "str_repeat" { _guard_allocation(runtime, len(args[0]) * args[1], "str_repeat"); return str_repeat(args[0], args[1]); }
    if name == "is_map" { return is_map(args[0]); }
    if name == "is_array" { return is_array(args[0]); }
    if name == "is_string" { return is_string(args[0]); }
    if name == "is_number" { return is_number(args[0]); }
    if name == "is_nil" { return is_nil(args[0]); }
    if name == "type" { return type(args[0]); }
    if name == "has_member" { return has_member(args[0], args[1]); }
    if name == "bit_and" { return bit_and(args[0], args[1]); }
    if name == "bit_or" { return bit_or(args[0], args[1]); }
    if name == "bit_xor" { return bit_xor(args[0], args[1]); }
    if name == "bit_not" { return bit_not(args[0]); }
    if name == "bit_shl" { return bit_shl(args[0], args[1]); }
    if name == "bit_shr" { return bit_shr(args[0], args[1]); }
    // Precision ladder: arbitrary-precision integers, exact rationals, and fixed
    // decimals. Arithmetic/comparison flow through the opcodes (which delegate to
    // the host), so only the constructors need wiring here.
    if name == "bigint" { return bigint(args[0]); }
    if name == "decimal" { return decimal(args[0]); }
    if name == "rational" {
        if len(args) == 2 { return rational(args[0], args[1]); }
        return rational(args[0]);
    }
    if name == "num_exp" { return num_exp(args[0]); }
    if name == "num_ln" { return num_ln(args[0]); }
    if name == "str_replace_all" { _guard_allocation(runtime, len(args[0]) * num_max(1, len(args[2])), "str_replace_all"); return str_replace_all(args[0], args[1], args[2]); }
    if name == "str_pad_left" { _guard_allocation(runtime, args[1], "str_pad_left"); return str_pad_left(args[0], args[1], args[2]); }
    if name == "str_pad_right" { _guard_allocation(runtime, args[1], "str_pad_right"); return str_pad_right(args[0], args[1], args[2]); }
    if name == "push" { _guard_push(runtime, args[0], "array"); return push(args[0], args[1]); }
    if name == "pop" { return pop(args[0]); }
    if name == "array_push" { _guard_push(runtime, args[0], "array"); return array_push(args[0], args[1]); }
    if name == "array_pop" { return array_pop(args[0]); }
    if name == "error" { return error(args[0]); }
    // Read-only host wall time. Keep strict zero arity and the retained host's
    // errors; these calls are not monotonic or deterministic guest clocks.
    if name == "clock" {
        if len(args) != 0 { throw "clock() takes no arguments"; }
        return clock();
    }
    if name == "now_ms" {
        if len(args) != 0 { throw "now_ms() takes no arguments"; }
        return now_ms();
    }
    if name == "now_iso" {
        if len(args) != 0 { throw "now_iso() takes no arguments"; }
        return now_iso();
    }
    if name == "array_sort" {
        if len(args) != 1 { throw "array_sort() expects 1 argument, got " + str(len(args)); }
        _guard_value(runtime, args[0]);
        return array_sort(args[0]);
    }
    if name == "str_to_bytes" {
        if len(args) != 1 { throw "str_to_bytes() expects 1 argument"; }
        return _string_bytes(args[0], runtime);
    }
    return error("self-host VM: unknown builtin '" + name + "'");
}

// Scalar dispatch for normal builtin arities. OP_CALL uses these paths before
// allocating a temporary argument array; unusual/mismatched arities retain the
// generic dispatcher and therefore the same errors as before.
fn _call_builtin1(name, a0, runtime = nil, execution = nil) {
    if name == "len" { return len(a0); }
    if name == "str" { return str(a0); }
    if name == "array_pop" { return array_pop(a0); }
    if name == "str_upper" { return str_upper(a0); }
    if name == "str_lower" { return str_lower(a0); }
    if name == "str_trim" { return str_trim(a0); }
    if name == "parse_number" { return parse_number(a0); }
    if name == "parse_bool" { return parse_bool(a0); }
    if name == "num_floor" { return num_floor(a0); }
    if name == "num_abs" { return num_abs(a0); }
    if name == "num_sqrt" { return num_sqrt(a0); }
    if name == "num_ceil" { return num_ceil(a0); }
    if name == "map_keys" { return map_keys(a0); }
    if name == "strfromcharcode" { return strfromcharcode(a0); }
    if name == "str_from_char_code" { return str_from_char_code(a0); }
    if name == "is_map" { return is_map(a0); }
    if name == "is_array" { return is_array(a0); }
    if name == "is_string" { return is_string(a0); }
    if name == "is_number" { return is_number(a0); }
    if name == "is_nil" { return is_nil(a0); }
    if name == "type" { return type(a0); }
    if name == "bit_not" { return bit_not(a0); }
    if name == "bigint" { return bigint(a0); }
    if name == "rational" { return rational(a0); }
    if name == "decimal" { return decimal(a0); }
    if name == "num_exp" { return num_exp(a0); }
    if name == "num_ln" { return num_ln(a0); }
    if name == "pop" { return pop(a0); }
    if name == "error" { return error(a0); }
    if name == "array_sort" { _guard_value(runtime, a0); return array_sort(a0); }
    if name == "str_to_bytes" { return _string_bytes(a0, runtime); }
    return _call_builtin(name, [a0], runtime, execution);
}

fn _call_builtin2(name, a0, a1, runtime = nil, execution = nil) {
    if name == "array_push" { _guard_push(runtime, a0, "array"); return array_push(a0, a1); }
    if name == "map_has" { return map_has(a0, a1); }
    if name == "bit_and" { return bit_and(a0, a1); }
    if name == "bit_or" { return bit_or(a0, a1); }
    if name == "bit_xor" { return bit_xor(a0, a1); }
    if name == "bit_shl" { return bit_shl(a0, a1); }
    if name == "bit_shr" { return bit_shr(a0, a1); }
    if name == "str_split" { return str_split(a0, a1); }
    if name == "str_contains" { return str_contains(a0, a1); }
    if name == "str_starts_with" { return str_starts_with(a0, a1); }
    if name == "str_ends_with" { return str_ends_with(a0, a1); }
    if name == "str_index_of" { return str_index_of(a0, a1); }
    if name == "str_join" { return str_join(a0, a1); }
    if name == "num_mod" { return num_mod(a0, a1); }
    if name == "num_max" { return num_max(a0, a1); }
    if name == "num_min" { return num_min(a0, a1); }
    if name == "num_pow" { return num_pow(a0, a1); }
    if name == "map_remove" { return map_remove(a0, a1); }
    if name == "strcharcodeat" { return strcharcodeat(a0, a1); }
    if name == "str_repeat" { _guard_allocation(runtime, len(a0) * a1, "str_repeat"); return str_repeat(a0, a1); }
    if name == "has_member" { return has_member(a0, a1); }
    if name == "rational" { return rational(a0, a1); }
    if name == "push" { _guard_push(runtime, a0, "array"); return push(a0, a1); }
    return _call_builtin(name, [a0, a1], runtime, execution);
}

fn _call_builtin3(name, a0, a1, a2, runtime = nil, execution = nil) {
    if name == "str_slice" { return str_slice(a0, a1, a2); }
    if name == "slice" { return slice(a0, a1, a2); }
    if name == "str_replace_all" { _guard_allocation(runtime, len(a0) * num_max(1, len(a2)), "str_replace_all"); return str_replace_all(a0, a1, a2); }
    if name == "str_pad_left" { _guard_allocation(runtime, a1, "str_pad_left"); return str_pad_left(a0, a1, a2); }
    if name == "str_pad_right" { _guard_allocation(runtime, a1, "str_pad_right"); return str_pad_right(a0, a1, a2); }
    return _call_builtin(name, [a0, a1, a2], runtime, execution);
}

// Grow `arr` to at least index i+1 (nil-filled), then set arr[i] = v.
fn _set_slot(arr, i, v, runtime = nil) {
    if i < 0 { throw "self-host VM: negative local slot"; }
    if runtime != nil {
        if i >= runtime.max_locals { _trip(runtime, "locals limit exceeded"); }
        _guard_value(runtime, v);
    }
    while len(arr) <= i { array_push(arr, nil); }
    arr[i] = v;
}

// ── Operator overloading (§51 parity) ────────────────────────────────────────
// Find a dunder method (`__add__`, `__lt__`, ...) on `val` or anywhere up its
// `__class` table chain; nil if absent. Bounded against cycles.
fn _lookup_member(val, name) {
    if not is_map(val) { return nil; }
    let cur = val;
    let depth = 0;
    while depth < 32 {
        if map_has(cur, name) { return cur[name]; }
        if map_has(cur, "__class") and is_map(cur["__class"]) { cur = cur["__class"]; }
        else { return nil; }
        depth = depth + 1;
    }
    return nil;
}

// Invoke a method value (closure object / raw fn const / builtin) with `args`.
fn _call_method(callee, args, globals, out, runtime, depth, execution) {
    if is_map(callee) and map_has(callee, "__bi") { return _call_builtin(callee["__bi"], args, runtime, execution); }
    let closure = is_map(callee) and map_has(callee, "__fn");
    let fnc = if closure { callee.__fn } else { callee };
    if not closure and not (is_map(fnc) and map_has(fnc, "chunk")) {
        return error("operator overload target is not callable");
    }
    // Match OP_CALL before guest code, default evaluation or global propagation.
    // Missing legacy metadata remains absent rather than inventing a minimum.
    let argc = len(args);
    if map_has(fnc, "min_arity") and argc < fnc.min_arity {
        throw "self-host VM: function expects at least " + str(fnc.min_arity) + " argument(s), got " + str(argc);
    }
    if map_has(fnc, "arity") and argc > fnc.arity {
        throw "self-host VM: function expects at most " + str(fnc.arity) + " argument(s), got " + str(argc);
    }
    if closure {
        let call_globals = globals;
        if map_has(callee, "__globals") { call_globals = callee["__globals"]; }
        if map_has(globals, "__import_cache__") and not map_has(call_globals, "__import_cache__") {
            call_globals["__import_cache__"] = globals["__import_cache__"];
        }
        return exec(fnc.chunk, args, call_globals, out, callee["__upvalues"], runtime, depth + 1, execution);
    }
    return exec(fnc.chunk, args, globals, out, [], runtime, depth + 1, execution);
}

// Operator slow paths return the method value directly. No temporary
// {found,value} envelope is allocated per operation; nil/false are valid results.
// A present forward method wins even if it throws or rejects its argument count.
// Scalar VM instructions already bypass these helpers.
fn _op_add(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__add__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__radd__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a + b;
}
fn _op_sub(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__sub__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__rsub__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a - b;
}
fn _op_mul(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__mul__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__rmul__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a * b;
}
fn _op_div(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__div__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__rdiv__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a / b;
}
fn _op_mod(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__mod__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__rmod__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return num_mod(a, b);
}
fn _op_eq(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__eq__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__eq__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a == b;
}
fn _op_ne(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__ne__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__ne__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a != b;
}
fn _op_gt(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__gt__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__lt__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a > b;
}
fn _op_ge(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__ge__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__le__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a >= b;
}
fn _op_lt(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__lt__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__gt__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a < b;
}
fn _op_le(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__le__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__ge__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a <= b;
}

// Execute one chunk with the given local slots and shared globals map. Printed
// values are appended to `out` (shared across calls). Returns the chunk's return
// value (the operand of OP_RETURN, or nil if execution falls off the end).
fn exec(chunk, locals, globals, out, upvalues, runtime = nil, depth = 0, execution = nil) {
    if execution == nil {
        let owned = execution_context();
        let value = exec(chunk, locals, globals, out, upvalues, runtime, depth, owned);
        close_execution(owned);
        return value;
    }
    let ins = chunk.instructions;
    let consts = chunk.constants;
    let stack = [];
    let ip = 0;
    let n = len(ins);

    if runtime != nil {
        if runtime.tripped { throw "self-host VM: " + runtime.reason; }
        if depth + 1 > runtime.max_frames { _trip(runtime, "frame limit exceeded"); }
        if depth + 1 > runtime.peak_frames { runtime.peak_frames = depth + 1; }
        if len(locals) > runtime.max_locals { _trip(runtime, "locals limit exceeded"); }
    }

    while ip < n {
        // Keep admission in this loop: no extra host call frame per guest step.
        if runtime != nil {
            if runtime.tripped { throw "self-host VM: " + runtime.reason; }
            if runtime.steps >= runtime.max_steps { _trip(runtime, "step limit exceeded"); }
            runtime.steps = runtime.steps + 1;
            // This tick invokes no guest callbacks and neither array changes here.
            // Reuse lengths within this tick only; the next instruction may mutate them.
            let stack_count = len(stack);
            if stack_count > runtime.max_stack { _trip(runtime, "stack limit exceeded"); }
            let local_count = len(locals);
            if local_count > runtime.max_locals { _trip(runtime, "locals limit exceeded"); }
            if stack_count > runtime.peak_stack { runtime.peak_stack = stack_count; }
            if local_count > runtime.peak_locals { runtime.peak_locals = local_count; }
            if stack_count > 0 {
                let top = stack[stack_count - 1];
                if (is_string(top) or is_array(top) or is_map(top)) and len(top) > runtime.max_value_items {
                    _trip(runtime, "value size limit exceeded");
                }
            }
        }
        let instr = ins[ip];
        let op = instr.op;
        let arg = instr.operand;
        ip = ip + 1;

        if op == OP_CONSTANT { array_push(stack, consts[arg]); }
        // Local access dominates compiled loops and recursive functions.
        // Keep these semantics-neutral handlers near the dispatch head so the
        // common path avoids walking the colder operator/object cases.
        else if op == OP_GET_LOCAL {
            if arg < len(locals) { array_push(stack, locals[arg]); }
            else { array_push(stack, nil); }
        }
        else if op == OP_SET_LOCAL { _set_slot(locals, arg, array_pop(stack), runtime); }
        // Group colder handlers by opcode range; each instruction still executes
        // the same handler and tick. Raw callers can use exact numeric values
        // (bigint/decimal/rational), which compare equal to ordinary opcodes.
        else if (is_number(op) or type(op) == "bigint" or type(op) == "decimal" or type(op) == "rational") and op >= 24 {
            if op >= 33 {
                if op == OP_GET_UPVALUE { array_push(stack, upvalues[arg]); }
                else if op == OP_SET_UPVALUE { upvalues[arg] = array_pop(stack); }
                else if op == OP_ADD_LOCAL_CONST {
                    let a = if arg.slot < len(locals) { locals[arg.slot] } else { nil };
                    let b = consts[arg.constant];
                    let value = if is_map(a) or is_map(b) { _op_add(a, b, globals, out, runtime, depth, execution) } else { a + b };
                    _set_slot(locals, arg.slot, value, runtime);
                }
                else if op == OP_ADD_LOCAL_LOCAL {
                    let a = if arg.slot < len(locals) { locals[arg.slot] } else { nil };
                    let b = if arg.rhs < len(locals) { locals[arg.rhs] } else { nil };
                    let value = if is_map(a) or is_map(b) { _op_add(a, b, globals, out, runtime, depth, execution) } else { a + b };
                    _set_slot(locals, arg.slot, value, runtime);
                }
                else if op == OP_JUMP_IF_FALSE_PEEK { if not _truthy(stack[len(stack) - 1]) { ip = arg; } }
                else if op == OP_JUMP_IF_TRUE_PEEK { if _truthy(stack[len(stack) - 1]) { ip = arg; } }
                else if op == OP_JUMP_IF_NIL_PEEK { if stack[len(stack) - 1] == nil { ip = arg; } }
                else if op == OP_JUMP_IF_NOT_NIL_PEEK { if stack[len(stack) - 1] != nil { ip = arg; } }
                else if op == OP_TRY {
                    // Run the body sub-chunk; on any raised error, fall back to the
                    // handler sub-chunk. Both share these locals/globals/upvalues.
                    // Host catch dispatch distinguishes exceptions from every valid
                    // body value, including nil, without a result envelope or sentinel.
                    // The host removes the body handler before evaluating catch, so a
                    // guest handler error propagates normally to the enclosing try.
                    let tc = consts[arg];
                    let r = try exec(tc.try_chunk, locals, globals, out, upvalues, runtime, depth + 1, execution)
                        catch exec(tc.catch_chunk, locals, globals, out, upvalues, runtime, depth + 1, execution);
                    array_push(stack, r);
                }
                else if op == OP_THROW { throw array_pop(stack); }
            } else {
                if op == OP_GET_INDEX {
                    let idx = array_pop(stack);
                    let obj = array_pop(stack);
                    array_push(stack, obj[idx]);
                }
                else if op == OP_SET_INDEX {
                    let value = array_pop(stack);
                    let idx = array_pop(stack);
                    let obj = array_pop(stack);
                    if runtime != nil { _guard_index_growth(runtime, obj, idx); }
                    obj[idx] = value;
                }
                else if op == OP_MOD {
                    let b = array_pop(stack); let a = array_pop(stack);
                    if is_map(a) or is_map(b) { array_push(stack, _op_mod(a, b, globals, out, runtime, depth, execution)); }
                    else { array_push(stack, num_mod(a, b)); }
                }
                else if op == OP_LEN { array_push(stack, len(array_pop(stack))); }
                else if op == OP_MAKE_ARRAY {
                    if runtime != nil and arg > runtime.max_value_items { _trip(runtime, "array size limit exceeded"); }
                    // Captured bindings use fresh one-element cells. Construct
                    // small arrays directly instead of filling nil slots and
                    // overwriting them; pop in reverse to preserve source order.
                    let items: any = nil;
                    // Exact numeric objects used as raw counts retain the
                    // generic host-index behavior, including its errors.
                    if arg == 1 and is_number(arg) { items = [array_pop(stack)]; }
                    else if arg == 0 and is_number(arg) { items = []; }
                    else if arg == 2 and is_number(arg) {
                        let a1 = array_pop(stack); let a0 = array_pop(stack);
                        items = [a0, a1];
                    } else if arg == 3 and is_number(arg) {
                        let a2 = array_pop(stack); let a1 = array_pop(stack); let a0 = array_pop(stack);
                        items = [a0, a1, a2];
                    } else {
                        items = [];
                        let k = 0;
                        while k < arg { array_push(items, nil); k = k + 1; }
                        let j = arg - 1;
                        while j >= 0 { items[j] = array_pop(stack); j = j - 1; }
                    }
                    array_push(stack, items);
                }
                else if op == OP_MAKE_MAP {
                    if runtime != nil and arg > runtime.max_value_items { _trip(runtime, "map size limit exceeded"); }
                    let m = map{};
                    let k = 0;
                    while k < arg {
                        let v = array_pop(stack);
                        let key = array_pop(stack);
                        m[key] = v;
                        k = k + 1;
                    }
                    array_push(stack, m);
                }
                else if op == OP_GET_ATTR {
                    let obj = array_pop(stack);
                    let name = consts[arg];
                    if is_map(obj) and map_has(obj, name) { array_push(stack, obj[name]); }
                    else { array_push(stack, nil); }
                }
                else if op == OP_SET_ATTR {
                    let value = array_pop(stack);
                    let obj = array_pop(stack);
                    if runtime != nil { _guard_index_growth(runtime, obj, consts[arg]); }
                    obj[consts[arg]] = value;
                }
                else if op == OP_CLOSURE {
                    // Build a closure value that bundles the function constant with the
                    // values of its captured upvalues, gathered from THIS frame: each
                    // descriptor is either a local slot of this frame (is_local) or one of
                    // this frame's own upvalues (transitive). Capture is by value.
                    let fnc = consts[arg];
                    let captured: any = nil;
                    if is_map(fnc) and map_has(fnc, "upvalues") {
                        let uvs = fnc.upvalues;
                        if len(uvs) == 1 {
                            // One captured reference needs one fresh slot, not
                            // a growable array populated by a one-turn loop.
                            let d = uvs[0];
                            let value = nil;
                            if d.is_local {
                                if d.index < len(locals) { value = locals[d.index]; }
                            } else { value = upvalues[d.index]; }
                            captured = [value];
                        } else {
                            captured = [];
                            let u = 0;
                            while u < len(uvs) {
                                let d = uvs[u];
                                if d.is_local {
                                    if d.index < len(locals) { array_push(captured, locals[d.index]); }
                                    else { array_push(captured, nil); }
                                } else {
                                    array_push(captured, upvalues[d.index]);
                                }
                                u = u + 1;
                            }
                        }
                    } else { captured = []; }
                    array_push(stack, map{ __fn: fnc, __upvalues: captured, __globals: globals });
                }
            }
        } else if (is_number(op) or type(op) == "bigint" or type(op) == "decimal" or type(op) == "rational") and op >= 18 {
            if op == OP_CALL {
                if not is_number(arg) { throw "self-host VM: invalid call argument count"; }
                if runtime != nil and arg > runtime.max_stack { _trip(runtime, "call argument limit exceeded"); }
                // Raw chunks may bypass the serialized-bytecode validator. Check
                // count and callee/argument availability before indexing or popping.
                if not (arg >= 0 and arg < len(stack)) or arg != num_floor(arg) {
                    throw "self-host VM: invalid call argument count or stack underflow";
                }
                // Callee sits below arg0..argN-1. Builtins with their normal scalar
                // arities can consume those values directly, avoiding an args-array
                // allocation in the dominant stdlib/loop path. Small-arity user
                // closures use a fixed-shape array and skip the generic
                // fill/reverse-pop loops while retaining the same frame contract.
                let direct = nil;
                let direct_closure = nil;
                let candidate = nil;
                if arg <= 3 { candidate = stack[len(stack) - arg - 1]; }
                if arg >= 1 and arg <= 3 {
                    if is_map(candidate) and map_has(candidate, "__bi") { direct = candidate; }
                }
                if is_map(candidate) and map_has(candidate, "__fn") and not map_has(candidate, "__bi") {
                    direct_closure = candidate;
                }
                if direct != nil and direct["__bi"] == "import" and arg != 1 { direct = nil; }

                if direct != nil {
                    let name = direct["__bi"];
                    if arg == 1 {
                        let a0 = array_pop(stack);
                        array_pop(stack); // callee descriptor
                        if name == "import" {
                            let cache = nil;
                            if map_has(globals, "__import_cache__") { cache = globals["__import_cache__"]; }
                            if cache != nil and map_has(cache, a0) { array_push(stack, cache[a0]); }
                            else { array_push(stack, error("self-host import: module not resolved: " + str(a0))); }
                        } else if name == "print" {
                            _output_push(out, a0, runtime);
                            array_push(stack, nil);
                        } else {
                            array_push(stack, _call_builtin1(name, a0, runtime, execution));
                        }
                    } else if arg == 2 {
                        let a1 = array_pop(stack);
                        let a0 = array_pop(stack);
                        array_pop(stack); // callee descriptor
                        if name == "print" {
                            _output_push(out, a0, runtime); _output_push(out, a1, runtime);
                            array_push(stack, nil);
                        } else {
                            array_push(stack, _call_builtin2(name, a0, a1, runtime, execution));
                        }
                    } else {
                        let a2 = array_pop(stack);
                        let a1 = array_pop(stack);
                        let a0 = array_pop(stack);
                        array_pop(stack); // callee descriptor
                        if name == "print" {
                            _output_push(out, a0, runtime); _output_push(out, a1, runtime); _output_push(out, a2, runtime);
                            array_push(stack, nil);
                        } else {
                            array_push(stack, _call_builtin3(name, a0, a1, a2, runtime, execution));
                        }
                    }
                } else if direct_closure != nil {
                    // Allocate only the argument array that this frame uses.
                    let callargs: any = nil;
                    if arg == 2 {
                        let a1 = array_pop(stack);
                        let a0 = array_pop(stack);
                        callargs = [a0, a1];
                    } else if arg == 0 { callargs = []; }
                    else if arg == 1 { callargs = [array_pop(stack)]; }
                    else {
                        let a2 = array_pop(stack);
                        let a1 = array_pop(stack);
                        let a0 = array_pop(stack);
                        callargs = [a0, a1, a2];
                    }
                    let callee = array_pop(stack);
                    let fnc = callee.__fn;
                    if map_has(fnc, "min_arity") and arg < fnc.min_arity {
                        throw "self-host VM: function expects at least " + str(fnc.min_arity) + " argument(s), got " + str(arg);
                    }
                    if map_has(fnc, "arity") and arg > fnc.arity {
                        throw "self-host VM: function expects at most " + str(fnc.arity) + " argument(s), got " + str(arg);
                    }
                    let call_globals = globals;
                    if map_has(callee, "__globals") { call_globals = callee.__globals; }
                    if map_has(globals, "__import_cache__") and not map_has(call_globals, "__import_cache__") {
                        call_globals["__import_cache__"] = globals["__import_cache__"];
                    }
                    array_push(stack, exec(fnc.chunk, callargs, call_globals, out, callee.__upvalues, runtime, depth + 1, execution));
                } else {
                    // General path for user closures, zero/large-arity builtins, and
                    // backward-compatible raw function constants.
                    let callargs = [];
                    let k = 0;
                    while k < arg { array_push(callargs, nil); k = k + 1; }
                    let j = arg - 1;
                    while j >= 0 { callargs[j] = array_pop(stack); j = j - 1; }
                    let callee = array_pop(stack);
                    if is_map(callee) and map_has(callee, "__bi") {
                        // `import(path)` resolves against a module cache that
                        // frontend_run pre-populates into globals["__import_cache__"].
                        if callee["__bi"] == "import" {
                            let cache = nil;
                            if map_has(globals, "__import_cache__") { cache = globals["__import_cache__"]; }
                            let p = callargs[0];
                            if cache != nil and map_has(cache, p) { array_push(stack, cache[p]); }
                            else { array_push(stack, error("self-host import: module not resolved: " + str(p))); }
                        } else if callee["__bi"] == "print" {
                            let pi = 0;
                            while pi < len(callargs) { _output_push(out, callargs[pi], runtime); pi = pi + 1; }
                            array_push(stack, nil);
                        } else {
                            array_push(stack, _call_builtin(callee["__bi"], callargs, runtime, execution));
                        }
                    } else if is_map(callee) and map_has(callee, "__fn") {
                        let __fnc = callee.__fn;
                        if map_has(__fnc, "min_arity") and arg < __fnc.min_arity {
                            throw "self-host VM: function expects at least " + str(__fnc.min_arity) + " argument(s), got " + str(arg);
                        }
                        if map_has(__fnc, "arity") and arg > __fnc.arity {
                            throw "self-host VM: function expects at most " + str(__fnc.arity) + " argument(s), got " + str(arg);
                        }
                        let call_globals = globals;
                        if map_has(callee, "__globals") { call_globals = callee.__globals; }
                        if map_has(globals, "__import_cache__") and not map_has(call_globals, "__import_cache__") {
                            call_globals["__import_cache__"] = globals["__import_cache__"];
                        }
                        array_push(stack, exec(callee.__fn.chunk, callargs, call_globals, out, callee.__upvalues, runtime, depth + 1, execution));
                    } else {
                        // Raw function constants carry the same optional arity
                        // contract as closures; do not bypass it on this route.
                        if is_map(callee) {
                            if map_has(callee, "min_arity") and arg < callee.min_arity {
                                throw "self-host VM: function expects at least " + str(callee.min_arity) + " argument(s), got " + str(arg);
                            }
                            if map_has(callee, "arity") and arg > callee.arity {
                                throw "self-host VM: function expects at most " + str(callee.arity) + " argument(s), got " + str(arg);
                            }
                        }
                        array_push(stack, exec(callee.chunk, callargs, globals, out, [], runtime, depth + 1, execution));
                    }
                }
            }
            else if op == OP_RETURN {
                let value = array_pop(stack);
                _guard_value(runtime, value);
                return value;
            }            else if op == OP_JUMP { ip = arg; }
            else if op == OP_JUMP_IF_FALSE { if not _truthy(array_pop(stack)) { ip = arg; } }
            else if op == OP_JUMP_IF_TRUE { if _truthy(array_pop(stack)) { ip = arg; } }
            else if op == OP_NOT { let a = array_pop(stack); array_push(stack, not _truthy(a)); }
        } else {
            if op == OP_ADD {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_add(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a + b); }
            }
            else if op == OP_SUB {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_sub(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a - b); }
            }
            else if op == OP_MUL {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_mul(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a * b); }
            }
            else if op == OP_DIV {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_div(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a / b); }
            }
            else if op == OP_EQ {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_eq(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a == b); }
            }
            else if op == OP_NOT_EQ {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_ne(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a != b); }
            }
            else if op == OP_GT {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_gt(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a > b); }
            }
            else if op == OP_GE {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_ge(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a >= b); }
            }
            else if op == OP_LT {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_lt(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a < b); }
            }
            else if op == OP_LE {
                let b = array_pop(stack); let a = array_pop(stack);
                if is_map(a) or is_map(b) { array_push(stack, _op_le(a, b, globals, out, runtime, depth, execution)); }
                else { array_push(stack, a <= b); }
            }
            else if op == OP_POP { array_pop(stack); }
            else if op == OP_PRINT { _output_push(out, array_pop(stack), runtime); }
            else if op == OP_GET_GLOBAL {
                let name = consts[arg];
                if map_has(globals, name) { array_push(stack, globals[name]); }
                else if map_has(instr, "direct_builtin_call") {
                    // The compiler marks only names in the shared VM builtin set.
                    // This private descriptor is consumed immediately by OP_CALL.
                    array_push(stack, instr.direct_builtin_call);
                }
                else if _is_builtin(name) {
                    array_push(stack, map{ __bi: name });
                }
                else { array_push(stack, nil); }
            }
            else if op == OP_DEFINE_GLOBAL {
                globals[consts[arg]] = array_pop(stack);
            }
            else if op == OP_SET_GLOBAL {
                globals[consts[arg]] = array_pop(stack);
            }
        }
    }
    if runtime != nil and len(stack) > runtime.max_stack { _trip(runtime, "stack limit exceeded"); }
    return nil;
}

// run(chunk) -> { output, locals, globals }.
//   output  — every value passed to `print(...)`, in call order. The self-hosted
//             parser compiles `print` as a builtin CALL (not OP_PRINT), so the
//             OP_CALL dispatch captures the args into this buffer (drives F5 run).
//   locals  — top-level local slots in declaration order (top-level `let`s).
//   globals — name → value (function definitions and global assignments).
fn run(chunk) {
    return run_seeded(chunk, map{});
}

// run_seeded — like run, but starts with a caller-provided globals map (used to
// inject `__import_cache__` for module/import support; see selfhost_frontend).
fn run_seeded(chunk, globals, execution = nil) {
    let owned = execution == nil;
    if owned { execution = execution_context(); }
    let out = [];
    let locals = [];
    exec(chunk, locals, globals, out, [], nil, 0, execution);
    if owned { close_execution(execution); }
    return map{ output: out, locals: locals, globals: globals };
}

// Bounded variants for IDE previews, agents, servers and untrusted source.
// The same runtime object is threaded through every call/closure/try frame so a
// recursive program cannot reset its budget at function boundaries.
fn run_bounded(chunk, options = nil) {
    return run_seeded_bounded(chunk, map{}, options);
}

fn run_seeded_bounded(chunk, globals, options = nil, execution = nil) {
    let owned = execution == nil;
    if owned { execution = execution_context(); }
    let out = [];
    let locals = [];
    let runtime = _runtime(options);
    let value = exec(chunk, locals, globals, out, [], runtime, 0, execution);
    if owned { close_execution(execution); }
    return map{ output: out, locals: locals, globals: globals, value: value, runtime: runtime };
}

export run, run_seeded, exec;
export run_bounded, run_seeded_bounded, runtime_limits;

// Internal orchestration API: contexts must never be injected into guest data.
export execution_context, close_execution;
