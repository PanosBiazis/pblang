fn _op_le(a, b, g, o, r, d, execution) {
    let method = _lookup_member(a, "__le__");
    if method != nil { return _call_method(method, [a, b], g, o, r, d, execution); }
    method = _lookup_member(b, "__ge__");
    if method != nil { return _call_method(method, [b, a], g, o, r, d, execution); }
    return a <= b;
