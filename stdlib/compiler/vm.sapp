// stdlib/compiler/vm.sapp — a stack-machine interpreter for the bytecode IR
// emitted by stdlib/compiler/codegen.sapp. This closes the self-hosting loop:
// pblang source -> pblang compiler (frontend_compile) -> THIS pblang VM -> output.
//
// The chunk shape is { instructions: [{op, operand}, ...], constants: [...] }.
// Opcode numbers MUST match codegen.sapp. `*_LOCAL` operands are slot indices;
// `*_GLOBAL` operands are constant indices holding the variable name; `JUMP*`
// operands are absolute instruction indices.

let _vm_builtin_module = import("stdlib/compiler/vm_builtins.sapp");
let _MEMORY = import("stdlib/compiler/vm_memory.sapp");
let _MEMORY_NAMES = _MEMORY.registry();
let _BUILTIN_ARITIES = _vm_builtin_module.fixed_arities();

// Orchestrators opt in only when an escaping guest throw ends the whole run.
// Borrowed contexts keep caller ownership by default.
fn execution_context(close_on_throw = false) {
    return map{memory:nil, close_on_throw:close_on_throw, handlers:0};
}
fn close_execution(execution) {
    if execution.memory != nil { _MEMORY.close(execution.memory); execution.memory = nil; }
}
fn _close_on_escape(execution) {
    if execution != nil and execution.close_on_throw and execution.handlers == 0 {
        // Cleanup invokes no guest callbacks. Preserve the original exception
        // even if a host failure interrupts the private state release.
        try close_execution(execution) catch nil;
    }
}

fn _raise(execution, message) {
    _close_on_escape(execution);
    throw message;
}
fn _raise_host(execution, message) {
    _close_on_escape(execution);
    return error(message);
}


let OP_CONSTANT = 0;
let OP_ADD = 1;
let OP_SUB = 2;
let OP_MUL = 3;
let OP_DIV = 4;
let OP_EQ = 5;
let OP_NOT_EQ = 6;
let OP_GT = 7;
let OP_GE = 8;
let OP_LT = 9;
let OP_LE = 10;
let OP_POP = 11;
let OP_PRINT = 12;
let OP_DEFINE_GLOBAL = 13;
let OP_GET_GLOBAL = 14;
let OP_SET_GLOBAL = 15;
let OP_GET_LOCAL = 16;
let OP_SET_LOCAL = 17;
let OP_CALL = 18;
let OP_RETURN = 19;
let OP_JUMP = 20;
let OP_JUMP_IF_FALSE = 21;
let OP_JUMP_IF_TRUE = 22;
let OP_NOT = 23;
let OP_CLOSURE = 24;
let OP_MAKE_ARRAY = 25;
let OP_MAKE_MAP = 26;
let OP_GET_INDEX = 27;
let OP_SET_INDEX = 28;
let OP_GET_ATTR = 29;
let OP_SET_ATTR = 30;
let OP_MOD = 31;
let OP_LEN = 32;
let OP_JUMP_IF_FALSE_PEEK = 33;
let OP_JUMP_IF_TRUE_PEEK = 34;
let OP_TRY = 35;
let OP_JUMP_IF_NIL_PEEK = 36;
let OP_JUMP_IF_NOT_NIL_PEEK = 37;
let OP_GET_UPVALUE = 38;
let OP_SET_UPVALUE = 39;
let OP_THROW = 40;
let OP_ADD_LOCAL_CONST = 41;
let OP_ADD_LOCAL_LOCAL = 42;

fn _option(options, key, fallback) {
    if options != nil and is_map(options) and map_has(options, key) { return options[key]; }
    return fallback;
}

fn _limit(options, key, fallback, hard_max) {
    let value = _option(options, key, fallback);
    if not is_number(value) or value < 1 or value != num_floor(value) or value > hard_max {
        throw "self-host VM: " + key + " must be a positive integer <= " + str(hard_max);
    }
    return value;
}

// Validated limits for untrusted or user-authored source. These protect VM-owned
// execution state; host kernel, driver, firmware and DMA isolation remain outside
// a language runtime's authority.
fn runtime_limits(options = nil) {
    if options != nil and not is_map(options) { throw "self-host VM: options must be a map"; }
    return map{
        max_steps: _limit(options, "max_steps", 1000000, 100000000),
        max_frames: _limit(options, "max_frames", 256, 4096),
        max_stack: _limit(options, "max_stack", 4096, 1048576),
        max_locals: _limit(options, "max_locals", 65536, 1048576),
        max_output: _limit(options, "max_output", 65536, 1048576),
        max_value_items: _limit(options, "max_value_items", 1048576, 16777216)
    };
}

fn _runtime(options) {
    let lim = runtime_limits(options);
    return map{
        max_steps: lim.max_steps, max_frames: lim.max_frames,
        max_stack: lim.max_stack, max_locals: lim.max_locals,
        max_output: lim.max_output, max_value_items: lim.max_value_items,
        steps: 0, peak_frames: 0, peak_stack: 0, peak_locals: 0, peak_output: 0,
        tripped: false, reason: ""
    };
}

fn _trip(runtime, reason, execution) {
    runtime.tripped = true;
    runtime.reason = reason;
    // Budget failures are sticky: no guest catch body may resume this run.
    // Keep the execution context out of the returned/public runtime counters.
    if execution != nil and execution.close_on_throw {
        try close_execution(execution) catch nil;
    }
    throw "self-host VM: " + reason;
}

fn _guard_value(runtime, value, execution) {
    if runtime == nil { return; }
    if (is_array(value) or is_map(value) or (is_string(value) and type(value) == "string")) and len(value) > runtime.max_value_items {
        _trip(runtime, "value size limit exceeded", execution);
    }
}

fn _output_push(out, value, runtime, execution) {
    if runtime != nil and len(out) >= runtime.max_output { _trip(runtime, "output limit exceeded", execution); }
    _guard_value(runtime, value, execution);
    array_push(out, value);
    if runtime != nil and len(out) > runtime.peak_output { runtime.peak_output = len(out); }
}

fn _truthy(c) {
    if c == false or c == nil or c == 0 { return false; }
    return true;
}

// Host builtins callable from self-hosted code. Build the membership table once
// when the module loads; OP_GET_GLOBAL executes this lookup for every builtin
// call, so a hash lookup avoids repeatedly scanning a long string chain. The
// table stores booleans only: each lookup still creates its own mutable builtin
// descriptor, preserving the previous first-class-value semantics.
let _BUILTINS = _vm_builtin_module.registry();

fn _is_builtin(name) { return map_has(_BUILTINS, name); }

fn _guard_allocation(runtime, requested, label, execution) {
    if runtime != nil and (not is_number(requested) or requested < 0 or requested > runtime.max_value_items) {
        _trip(runtime, label + " allocation limit exceeded", execution);
    }
}

fn _guard_push(runtime, container, label, execution) {
    // The host rejects a non-array before mutation. Preserve its own diagnostic
    // by letting that one primitive call fail after optional owner cleanup.
    // Do not call len() here on an invalid target, even in bounded execution.
    if not is_array(container) { _close_on_escape(execution); return nil; }
    if runtime != nil and len(container) >= runtime.max_value_items {
        _trip(runtime, label + " size limit exceeded", execution);
    }
}

// Inspect only contracts that reject before allocation or callbacks. On invalid
// arguments skip size arithmetic, close eligible scalar ownership, then let the
// caller invoke the original primitive once for its first diagnostic. The host
// is_string predicate includes boxed numeric objects; type is required here.
// Equality against abs rejects negative/NaN without an ordered NaN comparison,
// which the retained host itself raises on. Fractional and +infinite counts pass.
fn _guard_repeat(runtime, value, count, execution) {
    if type(value) != "string" or not is_number(count) or count != num_abs(count) {
        _close_on_escape(execution);
        return nil;
    }
    _guard_allocation(runtime, len(value) * count, "str_repeat", execution);
}

fn _guard_replace(runtime, value, from, to, execution) {
    if type(value) != "string" or type(from) != "string" or type(to) != "string" {
        _close_on_escape(execution);
        return nil;
    }
    if runtime == nil { return nil; }
    let count = len(value);
    // Empty search inserts at every Unicode scalar boundary, including both
    // ends (one insertion even for empty input). Count before the host allocates.
    if from == "" {
        _guard_allocation(runtime, count + (count + 1) * len(to), "str_replace_all", execution);
    } else {
        _guard_allocation(runtime, count * num_max(1, len(to)), "str_replace_all", execution);
    }
}

fn _guard_join(runtime, parts, separator, execution) {
    if not is_array(parts) or type(separator) != "string" {
        _close_on_escape(execution);
        return nil;
    }
    if runtime == nil { return nil; }
    let count = len(parts);
    let maximum = runtime.max_value_items;
    // These lengths are nonnegative ordinary numbers; argument admission above
    // already excludes every malformed shape. Reuse the immutable run limit.
    if count > maximum { _trip(runtime, "str_join allocation limit exceeded", execution); }
    // Admission scans no nested values and invokes no guest callbacks. Charge
    // the scan to the shared step budget before the host clones the parts.
    if count > runtime.max_steps - runtime.steps { _trip(runtime, "step limit exceeded", execution); }
    runtime.steps = runtime.steps + count;
    let requested = if count > 1 { (count - 1) * len(separator) } else { 0 };
    if requested > maximum { _trip(runtime, "str_join allocation limit exceeded", execution); }
    for part in parts {
        // The retained primitive treats every non-string member as empty,
        // including boxed numbers. Do not stringify or traverse private data.
        if type(part) == "string" {
            requested = requested + len(part);
            // Lengths and their running sum are nonnegative ordinary numbers.
            // Keep the same early rejection without a helper call per member.
            if requested > maximum { _trip(runtime, "str_join allocation limit exceeded", execution); }
        }
    }
}

fn _guard_pad(runtime, value, width, pad, label, execution) {
    if type(value) != "string" or not is_number(width) or type(pad) != "string" {
        _close_on_escape(execution);
        return nil;
    }
    // The retained primitive converts NaN width to zero and returns the source.
    // Ordered NaN comparisons themselves raise; test equality before admission.
    if width != width {
        if runtime != nil { _guard_allocation(runtime, len(value), label, execution); }
        return nil;
    }
    _guard_allocation(runtime, width, label, execution);
}

// Admission for mutation must precede the host write: SET consumes its target,
// so a later stack tick need not see the enlarged collection at all. Preserve
// the retained host's index typing, truncation and errors for non-growing writes.
fn _guard_index_growth(runtime, target, index, execution) {
    if is_array(target) {
        // The host truncates number indices toward zero and permits append only
        // at len(target). Runtime limits are positive, so an empty-array append
        // (including host NaN/-fraction conversion to zero) cannot exceed them.
        let count = len(target);
        if count >= runtime.max_value_items and is_number(index)
            and index >= count and index < count + 1 {
            _trip(runtime, "array size limit exceeded", execution);
        }
    } elif is_map(target) and type(index) == "string" {
        if len(target) >= runtime.max_value_items and not map_has(target,index) {
            _trip(runtime, "map size limit exceeded", execution);
        }
    }
}

// Count only when the worst-case UTF-8 size does not already fit the caller's
// explicit budget. Split long strings so repeated scalar indexing cannot turn
// into a quadratic scan of the entire input. No output byte array is allocated.
fn _utf8_size(value, remaining, runtime, execution) {
    let count = len(value);
    if count > remaining { _trip(runtime, "str_to_bytes allocation limit exceeded", execution); }
    if count > 128 {
        let middle = num_floor(count / 2);
        let first = _utf8_size(str_slice(value, 0, middle), remaining, runtime, execution);
        return first + _utf8_size(str_slice(value, middle, count), remaining - first, runtime, execution);
    }
    if runtime.tripped { _trip(runtime, runtime.reason, execution); }
    if count > runtime.max_steps - runtime.steps { _trip(runtime, "step limit exceeded", execution); }
    runtime.steps = runtime.steps + count;
    let bytes = 0;
    for i count {
        let cp = strcharcodeat(value, i);
        if cp < 128 { bytes = bytes + 1; }
        elif cp < 2048 { bytes = bytes + 2; }
        elif cp < 65536 { bytes = bytes + 3; }
        else { bytes = bytes + 4; }
        if bytes > remaining { _trip(runtime, "str_to_bytes allocation limit exceeded", execution); }
    }
    return bytes;
}

fn _string_bytes(value, runtime, execution) {
    if type(value) != "string" { _raise(execution, "str_to_bytes() expects a string"); }
    if runtime != nil {
        let count = len(value);
        _guard_allocation(runtime, count, "str_to_bytes", execution);
        if count > num_floor(runtime.max_value_items / 4) {
            _utf8_size(value, runtime.max_value_items, runtime, execution);
        }
    }
    return str_to_bytes(value);
}

// Check before indexing arguments or invoking a primitive with side effects.
// Normal scalar calls bypass this helper; only generic/fallback calls need it.
fn _check_builtin_arity(name, count, execution) {
    if map_has(_BUILTIN_ARITIES, name) {
        let expected = _BUILTIN_ARITIES[name];
        if count == expected { return nil; }
        // Preserve messages of the previously checked builtin contracts.
        if expected == 0 { _raise(execution, name + "() takes no arguments"); }
        if name == "array_sort" { _raise(execution, "array_sort() expects 1 argument, got " + str(count)); }
        if name == "str_to_bytes" { _raise(execution, "str_to_bytes() expects 1 argument"); }
        _raise(execution, "self-host VM: " + name + "() expects " + str(expected) + " argument(s), got " + str(count));
    }
    if name == "rational" and count != 1 and count != 2 {
        _raise(execution, "self-host VM: rational() expects 1 or 2 arguments, got " + str(count));
    }
}

// Collection type failures are predictable without executing user code. Close
// an owned unhandled scalar context before invoking the original rejecting host
// primitive once. Successful calls, borrowed contexts and guest catches retain
// their state. These guards do not cover arbitrary host failures or allocation
// failure; is_string alone cannot distinguish strings from exact numeric objects.
// String transforms/search/split use actual string tags for guaranteed type
// rejection; boxed exact numbers are not strings. Successful Unicode behavior
// and all original host diagnostics remain in the host primitive.
// The eight strict numeric builtins below reject non-number values. Close only
// on that guaranteed rejection, then invoke the unchanged host primitive once.
// num_mod/num_pow accept exact numeric objects and have value-dependent failures.
// They use the pure primitive retry helpers only for live unhandled owned state.
fn _call_builtin(name, args, runtime = nil, execution = nil) {
    if map_has(_MEMORY_NAMES, name) {
        if execution == nil { _raise(execution, "self-host memory: missing execution context"); }
        if execution.memory == nil { execution.memory = _MEMORY.new_state(); }
        if (name == "allocate" or name == "memory_alloc") and len(args) > 0 { _guard_value(runtime, args[0], execution); }
        if (name == "store" or name == "memory_set") and len(args) > 1 { _guard_value(runtime, args[1], execution); }
        return _MEMORY.dispatch(execution.memory, name, args, 1,
            execution.close_on_throw and execution.handlers == 0);
    }
    _check_builtin_arity(name, len(args), execution);
    if name == "len" {
        if execution != nil and execution.memory != nil and (not is_array(args[0]) and not is_map(args[0]) and type(args[0]) != "string") { _close_on_escape(execution); }
        return len(args[0]);
    }
    if name == "str" { return str(args[0]); }
    if name == "print" { return nil; }
    if name == "array_push" { _guard_push(runtime, args[0], "array", execution); return array_push(args[0], args[1]); }
    if name == "array_pop" {
        if execution != nil and execution.memory != nil and (not is_array(args[0])) { _close_on_escape(execution); }
        return array_pop(args[0]);
    }
    if name == "str_split" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string" or type(args[1]) != "string") { _close_on_escape(execution); }
        return str_split(args[0], args[1]);
    }
    if name == "str_upper" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string") { _close_on_escape(execution); }
        return str_upper(args[0]);
    }
    if name == "str_lower" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string") { _close_on_escape(execution); }
        return str_lower(args[0]);
    }
    if name == "str_slice" { return str_slice(args[0], args[1], args[2]); }
    if name == "slice" { return slice(args[0], args[1], args[2]); }
    if name == "str_trim" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string") { _close_on_escape(execution); }
        return str_trim(args[0]);
    }
    if name == "str_contains" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string" or type(args[1]) != "string") { _close_on_escape(execution); }
        return str_contains(args[0], args[1]);
    }
    if name == "str_starts_with" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string" or type(args[1]) != "string") { _close_on_escape(execution); }
        return str_starts_with(args[0], args[1]);
    }
    if name == "str_ends_with" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string" or type(args[1]) != "string") { _close_on_escape(execution); }
        return str_ends_with(args[0], args[1]);
    }
    if name == "str_index_of" {
        if execution != nil and execution.memory != nil and (type(args[0]) != "string" or type(args[1]) != "string") { _close_on_escape(execution); }
        return str_index_of(args[0], args[1]);
    }
    if name == "str_join" { _guard_join(runtime, args[0], args[1], execution); return str_join(args[0], args[1]); }
    if name == "parse_number" { return parse_number(args[0]); }
    if name == "parse_bool" { return parse_bool(args[0]); }
    if name == "num_floor" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_floor(args[0]);
    }
    if name == "num_abs" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_abs(args[0]);
    }
    if name == "num_sqrt" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_sqrt(args[0]);
    }
    if name == "num_mod" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _scalar_mod(args[0], args[1], execution);
        }
        return num_mod(args[0], args[1]);
    }
    if name == "num_max" {
        if execution != nil and execution.memory != nil and (not is_number(args[0]) or not is_number(args[1])) { _close_on_escape(execution); }
        return num_max(args[0], args[1]);
    }
    if name == "num_min" {
        if execution != nil and execution.memory != nil and (not is_number(args[0]) or not is_number(args[1])) { _close_on_escape(execution); }
        return num_min(args[0], args[1]);
    }
    if name == "num_pow" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _scalar_pow(args[0], args[1], execution);
        }
        return num_pow(args[0], args[1]);
    }
    if name == "num_ceil" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_ceil(args[0]);
    }
    if name == "map_has" {
        if execution != nil and execution.memory != nil and (not is_map(args[0]) or type(args[1]) != "string") { _close_on_escape(execution); }
        return map_has(args[0], args[1]);
    }
    if name == "map_keys" {
        if execution != nil and execution.memory != nil and (not is_map(args[0])) { _close_on_escape(execution); }
        return map_keys(args[0]);
    }
    if name == "map_remove" {
        if execution != nil and execution.memory != nil and (not is_map(args[0]) or type(args[1]) != "string") { _close_on_escape(execution); }
        return map_remove(args[0], args[1]);
    }
    if name == "strcharcodeat" { return strcharcodeat(args[0], args[1]); }
    if name == "strfromcharcode" { return strfromcharcode(args[0]); }
    if name == "str_from_char_code" { return str_from_char_code(args[0]); }
    if name == "str_repeat" { _guard_repeat(runtime, args[0], args[1], execution); return str_repeat(args[0], args[1]); }
    if name == "is_map" { return is_map(args[0]); }
    if name == "is_array" { return is_array(args[0]); }
    if name == "is_string" { return is_string(args[0]); }
    if name == "is_number" { return is_number(args[0]); }
    if name == "is_nil" { return is_nil(args[0]); }
    if name == "type" { return type(args[0]); }
    if name == "has_member" {
        if execution != nil and execution.memory != nil and (type(args[1]) != "string") { _close_on_escape(execution); }
        return has_member(args[0], args[1]);
    }
    if name == "bit_and" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_and(args[0], args[1], execution);
        }
        return bit_and(args[0], args[1]);
    }
    if name == "bit_or" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_or(args[0], args[1], execution);
        }
        return bit_or(args[0], args[1]);
    }
    if name == "bit_xor" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_xor(args[0], args[1], execution);
        }
        return bit_xor(args[0], args[1]);
    }
    if name == "bit_not" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_not(args[0], execution);
        }
        return bit_not(args[0]);
    }
    if name == "bit_shl" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_shl(args[0], args[1], execution);
        }
        return bit_shl(args[0], args[1]);
    }
    if name == "bit_shr" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            return _bit_shr(args[0], args[1], execution);
        }
        return bit_shr(args[0], args[1]);
    }
    // Precision ladder: arbitrary-precision integers, exact rationals, and fixed
    // decimals. Arithmetic/comparison flow through the opcodes (which delegate to
    // the host), so only the constructors need wiring here.
    if name == "bigint" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 { return _exact_bigint(args[0], execution); }
        return bigint(args[0]);
    }
    if name == "decimal" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 { return _exact_decimal(args[0], execution); }
        return decimal(args[0]);
    }
    if name == "rational" {
        if execution != nil and execution.memory != nil and execution.close_on_throw and execution.handlers == 0 {
            if len(args) == 2 { return _exact_rational2(args[0], args[1], execution); }
            return _exact_rational1(args[0], execution);
        }
        if len(args) == 2 { return rational(args[0], args[1]); }
        return rational(args[0]);
    }
    if name == "num_exp" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_exp(args[0]);
    }
    if name == "num_ln" {
        if execution != nil and execution.memory != nil and (not is_number(args[0])) { _close_on_escape(execution); }
        return num_ln(args[0]);
    }
    if name == "str_replace_all" { _guard_replace(runtime, args[0], args[1], args[2], execution); return str_replace_all(args[0], args[1], args[2]); }
    if name == "str_pad_left" { _guard_pad(runtime, args[0], args[1], args[2], "str_pad_left", execution); return str_pad_left(args[0], args[1], args[2]); }
    if name == "str_pad_right" { _guard_pad(runtime, args[0], args[1], args[2], "str_pad_right", execution); return str_pad_right(args[0], args[1], args[2]); }
    if name == "push" { _guard_push(runtime, args[0], "array", execution); return push(args[0], args[1]); }
    if name == "pop" {
        if execution != nil and execution.memory != nil and (not is_array(args[0])) { _close_on_escape(execution); }
        return pop(args[0]);
    }
    if name == "array_push" { _guard_push(runtime, args[0], "array", execution); return array_push(args[0], args[1]); }
