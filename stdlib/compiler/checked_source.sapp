// Bounded admission for source backends that must never compile a recovered AST.
// Keep the raw parser's editor/recovery contract separate from executable output.
let Tokens = import("stdlib:compiler/tokenizer.sapp");
let Parser = import("stdlib:compiler/parser.sapp");
let MAX_SOURCE_BYTES = 1048576;
let MAX_TOKENS = 65536;
let MAX_LINKED_SOURCE_BYTES = 16777216;
let MAX_LINKED_TOKENS = 1048576;

fn _check_cap(value, maximum) {
    if type(value) != "number" {
        throw "checked_source: invalid admission limit";
    }
    let valid = try value >= 1 and value <= maximum and value == num_floor(value) catch false;
    if not valid {
        throw "checked_source: invalid admission limit";
    }
}

fn _lex(source, max_tokens, local) {
    if local { return Tokens.tokenize_local(source, max_tokens); }
    return Tokens.tokenize_bounded(source, max_tokens);
}

fn _parse(source, max_source_bytes, max_tokens, local = false) {
    if type(source) != "string" { throw "checked_source: source must be text"; }
    // A scalar needs at most four UTF-8 bytes. Encode only near the byte limit,
    // after rejecting sources already too long even with one byte per scalar.
    let characters = len(source);
    if max_source_bytes != nil and characters > max_source_bytes {
        throw "checked_source: source byte limit exceeded";
    }
    if max_source_bytes != nil and characters > num_floor(max_source_bytes / 4)
        and len(str_to_bytes(source)) > max_source_bytes {
        throw "checked_source: source byte limit exceeded";
    }
    let lexed = try _lex(source, max_tokens, local) catch nil;
    if not is_map(lexed) { throw "checked_source: tokenization failed"; }
    if lexed.ok != true { throw "checked_source: token limit exceeded"; }
    for token in lexed.tokens {
        if token.kind == "invalid" or (try token.unterminated catch false) == true {
            throw "checked_source: invalid or unterminated token";
        }
    }
    let ast = try Parser.parse(lexed.tokens) catch nil;
    if not is_map(ast) { throw "checked_source: parsing failed"; }
    if not is_array(ast.stmts) or not is_array(ast.errors) {
        throw "checked_source: parsing failed";
    }
    if len(ast.errors) != 0 { throw "checked_source: syntax error"; }
    return ast;
}

fn parse_source(source, max_source_bytes = 1048576, max_tokens = 65536) {
    _check_cap(max_source_bytes, MAX_SOURCE_BYTES);
    _check_cap(max_tokens, MAX_TOKENS);
    return _parse(source, max_source_bytes, max_tokens);
}

// Explicit project-source profile; never widens the direct backend defaults.
fn parse_linked_source(source, max_source_bytes = 16777216, max_tokens = 1048576) {
    _check_cap(max_source_bytes, MAX_LINKED_SOURCE_BYTES);
    _check_cap(max_tokens, MAX_LINKED_TOKENS);
    return _parse(source, max_source_bytes, max_tokens);
}

export parse_source, MAX_SOURCE_BYTES, MAX_TOKENS;
export parse_linked_source, MAX_LINKED_SOURCE_BYTES, MAX_LINKED_TOKENS;

// Explicit developer-local policy. No ambient switch or process-wide mutation:
// hosted/untrusted callers continue to use parse_source/parse_linked_source.
fn local_budget(options = nil) {
    if options != nil and not is_map(options) { throw "checked_source: invalid local budget"; }
    let result = map{ max_source_bytes: nil, max_tokens: nil };
    if options == nil { return result; }
    for key in map_keys(options) {
        if key != "max_source_bytes" and key != "max_tokens" { throw "checked_source: unknown local budget option"; }
        let value = options[key];
        if value != nil {
            if type(value) != "number" { throw "checked_source: invalid local budget"; }
            let valid = try value >= 1 and value <= 9007199254740991 and value == num_floor(value) catch false;
            if not valid { throw "checked_source: invalid local budget"; }
        }
        result[key] = value;
    }
    return result;
}

fn parse_local_source(source, options = nil) {
    let budget = local_budget(options);
    return _parse(source, budget.max_source_bytes, budget.max_tokens, true);
}
export parse_local_source, local_budget;
