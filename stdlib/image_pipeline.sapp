// Bounded RGBA image transformations and PNG encoding in pure PBLang.

let PNG = import("stdlib:png.sapp");
let FLATE = import("stdlib:flate.sapp");
let IMAGE = import("stdlib:image_processing.sapp");
let FONT = import("stdlib:bitmap_font.sapp");

let FORMAT = "pblang.image-pipeline.rgba8.v1";
let MAX_INPUT_BYTES = 4194304;
let MAX_WIDTH = 4096;
let MAX_HEIGHT = 4096;
let MAX_PIXELS = 4194304;
let PI = 3.141592653589793;

fn _append(out, values) {
    for i len(values) { array_push(out, values[i]); }
    return out;
}

fn _be32(value) {
    return [
        num_mod(num_floor(value / 16777216), 256),
        num_mod(num_floor(value / 65536), 256),
        num_mod(num_floor(value / 256), 256),
        num_mod(value, 256)
    ];
}

fn _chunk(kind, data) {
    let body = []; _append(body, str_to_bytes(kind)); _append(body, data);
    let out = []; _append(out, _be32(len(data))); _append(out, body);
    _append(out, _be32(FLATE.crc32(body))); return out;
}

fn _byte(value) {
    if type(value) != "number" { throw "image_pipeline: channel must be numeric"; }
    value = num_floor(value);
    if value < 0 { return 0; }
    if value > 255 { return 255; }
    return value;
}

fn dimensions(image) {
    if type(image) != "array" or len(image) < 1 or type(image[0]) != "array"
       or len(image[0]) < 1 { throw "image_pipeline: image is empty"; }
    let width = len(image[0]); let height = len(image);
    if width > MAX_WIDTH or height > MAX_HEIGHT or width * height > MAX_PIXELS {
        throw "image_pipeline: dimensions exceed bounded RGBA limits";
    }
    for y height {
        if type(image[y]) != "array" or len(image[y]) != width {
            throw "image_pipeline: rows must have equal width";
        }
        for x width {
            let pixel = image[y][x];
            if type(pixel) != "array" or len(pixel) != 4 {
                throw "image_pipeline: every pixel must be RGBA";
            }
            for channel 4 { _byte(pixel[channel]); }
        }
    }
    return map{ width: width, height: height, pixels: width * height };
}

fn decode_png(bytes) {
    let decoded = PNG.decode(bytes, map{
        max_input_bytes: MAX_INPUT_BYTES, max_pixels: MAX_PIXELS,
        max_output_width: MAX_WIDTH, max_output_height: MAX_HEIGHT
    });
    if not decoded.ok { throw decoded.error; }
    if decoded.output_width != decoded.width or decoded.output_height != decoded.height {
        throw "image_pipeline: exact decode refused implicit downscaling";
    }
    dimensions(decoded.image);
    return map{ format: FORMAT, image: decoded.image, width: decoded.width,
        height: decoded.height, crc_verified: decoded.crc_verified,
        checksum_verified: decoded.checksum_verified };
}

fn encode_png(image) {
    let size = dimensions(image); let raw = [];
    for y size.height {
        array_push(raw, 0);
        for x size.width {
            let pixel = image[y][x];
            for channel 4 { array_push(raw, _byte(pixel[channel])); }
        }
    }
    let ihdr = []; _append(ihdr, _be32(size.width)); _append(ihdr, _be32(size.height));
    _append(ihdr, [8, 6, 0, 0, 0]);
    let out = [137, 80, 78, 71, 13, 10, 26, 10];
    _append(out, _chunk("IHDR", ihdr));
    _append(out, _chunk("IDAT", FLATE.zlib_encode(raw)));
    _append(out, _chunk("IEND", []));
    if len(out) > 16777216 { throw "image_pipeline: encoded PNG exceeds 16 MiB"; }
    return out;
}

fn resize(image, width, height) {
    if type(width) != "number" or width != num_floor(width) or width < 1 or width > MAX_WIDTH
       or type(height) != "number" or height != num_floor(height) or height < 1 or height > MAX_HEIGHT
       or width * height > MAX_PIXELS {
        throw "image_pipeline: resize dimensions exceed bounds";
    }
    dimensions(image); return IMAGE.resize_nearest(image, width, height);
}

fn crop(image, x, y, width, height) {
    let size = dimensions(image);
    for value in [x, y, width, height] {
        if type(value) != "number" or value != num_floor(value) or value < 0 {
            throw "image_pipeline: crop values must be non-negative integers";
        }
    }
    if width < 1 or height < 1 { throw "image_pipeline: crop dimensions must be positive"; }
    if x >= size.width or y >= size.height { throw "image_pipeline: crop origin is outside image"; }
    width = num_min(width, size.width - x); height = num_min(height, size.height - y);
    return map{ image: IMAGE.crop(image, x, y, width, height), x: x, y: y,
        width: width, height: height };
}

fn grayscale(image) {
    let size = dimensions(image); let out = [];
    for y size.height {
        let row = [];
        for x size.width {
            let pixel = image[y][x];
            let gray = _byte(pixel[0] * 0.299 + pixel[1] * 0.587 + pixel[2] * 0.114);
            array_push(row, [gray, gray, gray, pixel[3]]);
        }
        array_push(out, row);
    }
    return out;
}

fn threshold(image, level = 128) {
    let size = dimensions(image);
    if type(level) != "number" or level != num_floor(level) or level < 0 or level > 255 {
        throw "image_pipeline: threshold level must be an integer in 0..255";
    }
    let out = [];
    for y size.height {
        let row = [];
        for x size.width {
            let pixel = image[y][x];
            let luminance = _byte(pixel[0] * 0.299 + pixel[1] * 0.587 + pixel[2] * 0.114);
            let value = if luminance >= level { 255 } else { 0 };
            array_push(row, [value, value, value, pixel[3]]);
        }
        array_push(out, row);
    }
    return out;
}

fn despeckle(image) {
    let size = dimensions(image); let out = [];
    for y size.height {
        let row = [];
        for x size.width {
            let result = [0, 0, 0, image[y][x][3]];
            for channel 3 {
                let values = [];
                let yy = num_max(0, y - 1);
                while yy <= num_min(size.height - 1, y + 1) {
                    let xx = num_max(0, x - 1);
                    while xx <= num_min(size.width - 1, x + 1) {
                        array_push(values, image[yy][xx][channel]); xx = xx + 1;
                    }
                    yy = yy + 1;
                }
                values = array_sort(values); result[channel] = values[num_floor(len(values) / 2)];
            }
            array_push(row, result);
        }
        array_push(out, row);
    }
    return out;
}

fn sharpen(image) {
    let size = dimensions(image); let out = [];
    for y size.height {
        let row = [];
        for x size.width {
            let source = image[y][x]; let result = [source[0], source[1], source[2], source[3]];
            if x > 0 and y > 0 and x + 1 < size.width and y + 1 < size.height {
                for channel 3 {
                    result[channel] = _byte(source[channel] * 5
                        - image[y - 1][x][channel] - image[y + 1][x][channel]
                        - image[y][x - 1][channel] - image[y][x + 1][channel]);
                }
            }
            array_push(row, result);
        }
        array_push(out, row);
    }
    return out;
}

fn preprocess(image, operation) {
    operation = str_lower(str(operation)); let size = dimensions(image);
    if operation == "grayscale" { return grayscale(image); }
    if operation == "threshold" { return threshold(image, 128); }
    if operation == "despeckle" { return despeckle(image); }
    if operation == "sharpen" { return sharpen(image); }
    if operation == "resize2x" {
        if size.width * 2 > MAX_WIDTH or size.height * 2 > MAX_HEIGHT
           or size.pixels * 4 > MAX_PIXELS {
            throw "image_pipeline: resize2x output exceeds bounded RGBA limits";
        }
        return resize(image, size.width * 2, size.height * 2);
    }
    throw "image_pipeline: preprocess operation must be grayscale, threshold, despeckle, sharpen, or resize2x";
}

fn flip(image, horizontal) {
    dimensions(image);
    if type(horizontal) != "bool" { throw "image_pipeline: horizontal must be boolean"; }
    return if horizontal { IMAGE.flip_horizontal(image) } else { IMAGE.flip_vertical(image) };
}

fn _sin(value) {
    let x = num_mod(value, 2.0 * PI); let result = x; let term = x;
    for i in 1 to 11 {
        term = term * (0.0 - x * x) / ((2 * i) * (2 * i + 1));
        result = result + term;
    }
    return result;
}

fn _cos(value) { return _sin(PI / 2.0 - value); }

fn rotate(image, degrees) {
    let size = dimensions(image);
    if type(degrees) != "number" or degrees != degrees or degrees < -360000 or degrees > 360000 {
        throw "image_pipeline: degrees must be a finite bounded number";
    }
    let normalized = num_mod(degrees, 360.0); if normalized < 0 { normalized = normalized + 360.0; }
    if normalized == 0 { return image; }
    if normalized == 90 { return IMAGE.rotate90(image); }
    if normalized == 180 { return IMAGE.rotate180(image); }
    if normalized == 270 { return IMAGE.rotate90(IMAGE.rotate90(IMAGE.rotate90(image))); }
    let radians = normalized * PI / 180.0; let cosine = _cos(radians); let sine = _sin(radians);
    let new_width = num_ceil(num_abs(size.width * cosine) + num_abs(size.height * sine));
    let new_height = num_ceil(num_abs(size.width * sine) + num_abs(size.height * cosine));
    if new_width > MAX_WIDTH or new_height > MAX_HEIGHT or new_width * new_height > MAX_PIXELS {
        throw "image_pipeline: rotated output exceeds bounds";
    }
    let source_cx = (size.width - 1) / 2.0; let source_cy = (size.height - 1) / 2.0;
    let target_cx = (new_width - 1) / 2.0; let target_cy = (new_height - 1) / 2.0;
    let out = [];
    for y new_height {
        let row = [];
        for x new_width {
            let dx = x - target_cx; let dy = y - target_cy;
            let source_x = num_floor(cosine * dx + sine * dy + source_cx + 0.5);
            let source_y = num_floor((0.0 - sine) * dx + cosine * dy + source_cy + 0.5);
            if source_x >= 0 and source_y >= 0 and source_x < size.width and source_y < size.height {
                array_push(row, image[source_y][source_x]);
            } else { array_push(row, [0, 0, 0, 0]); }
        }
        array_push(out, row);
    }
    return out;
}

fn thumbnail(image, side) {
    let size = dimensions(image);
    if type(side) != "number" or side != num_floor(side) or side < 1 or side > MAX_WIDTH {
        throw "image_pipeline: thumbnail size must be 1..4096";
    }
    let scale = num_min(side / size.width, side / size.height);
    if scale > 1.0 { scale = 1.0; }
    let width = num_max(1, num_floor(size.width * scale));
    let height = num_max(1, num_floor(size.height * scale));
    return resize(image, width, height);
}

fn histogram(image) {
    let size = dimensions(image); let red = []; let green = []; let blue = []; let alpha = [];
    let bucket = 0;
    while bucket < 256 {
        array_push(red, 0); array_push(green, 0); array_push(blue, 0); array_push(alpha, 0);
        bucket = bucket + 1;
    }
    for y size.height { for x size.width {
        let pixel = image[y][x]; red[pixel[0]] = red[pixel[0]] + 1;
        green[pixel[1]] = green[pixel[1]] + 1; blue[pixel[2]] = blue[pixel[2]] + 1;
        alpha[pixel[3]] = alpha[pixel[3]] + 1;
    }}
    return map{ red: red, green: green, blue: blue, alpha: alpha,
        width: size.width, height: size.height, pixels: size.pixels };
}

fn compare(a, b) {
    let sa = dimensions(a); let sb = dimensions(b);
    if sa.width != sb.width or sa.height != sb.height {
        return map{ comparable: false, identical: false, dimensions_equal: false,
            width_a: sa.width, height_a: sa.height, width_b: sb.width, height_b: sb.height };
    }
    let difference = 0; let differing = 0;
    for y sa.height { for x sa.width {
        let changed = false;
        for channel 4 {
            let delta = num_abs(a[y][x][channel] - b[y][x][channel]);
            difference = difference + delta; if delta != 0 { changed = true; }
        }
        if changed { differing = differing + 1; }
    }}
    let mean = difference / (sa.pixels * 4.0);
    return map{ comparable: true, identical: differing == 0, dimensions_equal: true,
        width: sa.width, height: sa.height, pixels: sa.pixels,
        differing_pixels: differing, mean_absolute_channel_difference: mean,
        similarity: 1.0 - mean / 255.0 };
}

fn _blend(image, x, y, color, opacity) {
    if y < 0 or y >= len(image) or x < 0 or x >= len(image[y]) { return; }
    let pixel = image[y][x]; let alpha = opacity / 255.0;
    for channel 3 { pixel[channel] = _byte(pixel[channel] * (1.0 - alpha) + color[channel] * alpha); }
    image[y][x] = pixel;
}

fn pixel(image, x, y) {
    let size = dimensions(image);
    if type(x) != "number" or x != num_floor(x) or x < 0 or x >= size.width
       or type(y) != "number" or y != num_floor(y) or y < 0 or y >= size.height {
        throw "image_pipeline: pixel coordinates are outside the image";
    }
    let value = image[y][x];
    return map{ x: x, y: y, r: value[0], g: value[1], b: value[2], a: value[3],
        hex: "#" + _hex_byte(value[0]) + _hex_byte(value[1]) + _hex_byte(value[2]) };
}

fn _hex_byte(value) {
    let digits = "0123456789ABCDEF"; value = _byte(value);
    return str_slice(digits, num_floor(value / 16), num_floor(value / 16) + 1)
        + str_slice(digits, num_mod(value, 16), num_mod(value, 16) + 1);
}

fn _annotation_color(name) {
    name = str_lower(str(name));
    if name == "red" { return [239, 68, 68]; }
    if name == "green" { return [34, 197, 94]; }
    if name == "blue" { return [59, 130, 246]; }
    if name == "yellow" { return [250, 204, 21]; }
    if name == "white" { return [255, 255, 255]; }
    if name == "black" { return [0, 0, 0]; }
    throw "image_pipeline: annotation color is unsupported";
}

fn _draw_text(image, text, x, y, color, scale) {
    let cursor = x;
    for i len(text) {
        let glyph = FONT.glyph(strcharcodeat(text, i));
        if glyph == nil { glyph = [31, 17, 17, 17, 17, 17, 31]; }
        for row 7 { for column 5 {
            if bit_and(bit_shr(glyph[row], 4 - column), 1) == 1 {
                for sy scale { for sx scale {
                    _blend(image, cursor + column * scale + sx, y + row * scale + sy,
                        color, 255);
                }}
            }
        }}
        cursor = cursor + 6 * scale;
    }
}

fn annotate(image, annotations) {
    let size = dimensions(image);
    if type(annotations) != "array" or len(annotations) < 1 or len(annotations) > 64 {
        throw "image_pipeline: annotations must contain 1..64 entries";
    }
    for i len(annotations) {
        let item = annotations[i];
        if type(item) != "map" { throw "image_pipeline: annotation must be an object"; }
        let allowed = ["text", "x", "y", "width", "height", "color"];
        let keys = map_keys(item);
        for k len(keys) {
            let accepted = false;
            for a len(allowed) { if keys[k] == allowed[a] { accepted = true; break; } }
            if not accepted { throw "image_pipeline: unknown annotation field"; }
        }
        let x = try item.x catch nil; let y = try item.y catch nil;
        let width = try item.width catch nil; let height = try item.height catch nil;
        for value in [x, y, width, height] {
            if type(value) != "number" or value != num_floor(value) or value < 0 {
                throw "image_pipeline: annotation geometry must use non-negative integers";
            }
        }
        if width < 1 or height < 1 or x >= size.width or y >= size.height {
            throw "image_pipeline: annotation rectangle is outside the image";
        }
        let color = _annotation_color(try item.color catch "red");
        let right = num_min(size.width - 1, x + width - 1);
        let bottom = num_min(size.height - 1, y + height - 1);
        for stroke 2 {
            let top_y = num_min(bottom, y + stroke); let bottom_y = num_max(y, bottom - stroke);
            for px right - x + 1 {
                _blend(image, x + px, top_y, color, 255);
                _blend(image, x + px, bottom_y, color, 255);
            }
            let left_x = num_min(right, x + stroke); let right_x = num_max(x, right - stroke);
            for py bottom - y + 1 {
                _blend(image, left_x, y + py, color, 255);
                _blend(image, right_x, y + py, color, 255);
            }
        }
        let text = str(try item.text catch "");
        if len(str_to_bytes(text)) > 128 { throw "image_pipeline: annotation text exceeds 128 UTF-8 bytes"; }
        if text != "" {
            let text_y = if y >= 9 { y - 8 } else { num_min(size.height - 7, y + 3) };
            _draw_text(image, text, x, text_y, color, 1);
        }
    }
    return map{ image: image, annotation_count: len(annotations) };
}

fn watermark(image, text, position) {
    let size = dimensions(image); text = str(text);
    if text == "" or len(str_to_bytes(text)) > 512 { throw "image_pipeline: watermark text must be 1..512 UTF-8 bytes"; }
    position = str_lower(str(position));
    if position != "topleft" and position != "topright" and position != "bottomleft"
       and position != "bottomright" and position != "center" {
        throw "image_pipeline: unsupported watermark position";
    }
    let scale = 1; if size.width >= 800 and size.height >= 600 { scale = 2; }
    let text_width = len(text) * 6 * scale; let text_height = 7 * scale; let margin = 12;
    let x = margin; let y = margin;
    if str_contains(position, "right") { x = num_max(0, size.width - text_width - margin); }
    if str_contains(position, "bottom") { y = num_max(0, size.height - text_height - margin); }
    if position == "center" { x = num_max(0, num_floor((size.width - text_width) / 2)); y = num_max(0, num_floor((size.height - text_height) / 2)); }
    let cursor = x;
    for i len(text) {
        let glyph = FONT.glyph(strcharcodeat(text, i));
        if glyph == nil { glyph = [31, 17, 17, 17, 17, 17, 31]; }
        for row 7 { for column 5 {
            if bit_and(bit_shr(glyph[row], 4 - column), 1) == 1 {
                for sy scale { for sx scale { _blend(image, cursor + column * scale + sx, y + row * scale + sy, [255, 255, 255], 210); }}
            }
        }}
        cursor = cursor + 6 * scale; if cursor >= size.width { break; }
    }
    return map{ image: image, x: x, y: y, scale: scale };
}

export FORMAT, MAX_INPUT_BYTES, MAX_WIDTH, MAX_HEIGHT, MAX_PIXELS,
       dimensions, decode_png, encode_png, resize, crop, grayscale, threshold,
       despeckle, sharpen, preprocess, flip,
       rotate, thumbnail, histogram, compare, pixel, annotate, watermark;
