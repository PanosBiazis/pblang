// stdlib/renderer.sapp — pblang-level UX controls + status for the graphics backend.
//
// The graphics stack has two native backends (minifb CPU framebuffer; SDL2 with a GPU-
// accelerated present) plus a software-renderer override, selected by env at startup. A
// running process can't hot-swap its backend, so this module gives an app (e.g. PBIDE) the
// pieces it needs WITHOUT editing native code: the backend catalog, the env to relaunch with,
// live DPI scaling by resolution, current status, and a hardware-aware recommendation.
//
//   let r = import("stdlib/renderer.sapp");
//   r.recommend();            // "sdl2" if a GPU is present, else "minifb"
//   r.select("sdl2").env;     // { PBLANG_GFX: "sdl2" } — relaunch with these
//   r.scale_for(w, h);        // 1..4 UI scale for the resolution

let W = import("stdlib:watch.sapp");

fn backends() {
    return [
        map{ name: "minifb",   accel: "cpu",     desc: "pure-Rust software framebuffer (default); CPU blit" },
        map{ name: "sdl2",     accel: "gpu-blit", desc: "SDL2 with a GPU-accelerated present (PBLANG_GFX=sdl2)" },
        map{ name: "software", accel: "cpu",     desc: "force the software renderer (PBLANG_GFX_SOFTWARE=1)" }
    ];
}

// select(name) — the environment settings to relaunch the app with for `name`.
fn select(name) {
    if name == "minifb" { return map{ backend: "minifb", env: map{} }; }
    if name == "sdl2" { return map{ backend: "sdl2", env: map{ PBLANG_GFX: "sdl2" } }; }
    if name == "software" { return map{ backend: "software", env: map{ PBLANG_GFX_SOFTWARE: "1" } }; }
    throw "renderer: unknown backend '" + name + "'";
}

// current() — which backend the env selects right now.
fn current() {
    if (try env_get("PBLANG_GFX_SOFTWARE") catch "") == "1" { return "software"; }
    if (try env_get("PBLANG_GFX") catch "") == "sdl2" { return "sdl2"; }
    return "minifb";
}

// scale_for(w, h) — integer UI scale for a resolution (HiDPI/4K auto-scaling).
fn scale_for(w, h) {
    let d = w; if h > d { d = h; }     // use the larger dimension
    if d >= 3840 { return 3; }         // 4K and up
    if d >= 2560 { return 2; }         // 1440p / QHD
    if d >= 1920 { return 2; }         // 1080p benefits from 2x on small panels
    return 1;
}

// recommend() — pick a backend from detected hardware: SDL2 (GPU present) else minifb.
fn recommend() {
    let g = try W.gpus() catch nil;
    let ok = false;
    if g != nil { ok = try g.available catch false; if ok == nil { ok = false; } }
    if ok { return "sdl2"; }
    return "minifb";
}

// status(w, h) — a one-call snapshot for a settings panel.
fn status(w, h) {
    return map{
        backend: current(),
        recommended: recommend(),
        scale: scale_for(w, h),
        backends: backends()
    };
}

export backends, select, current, scale_for, recommend, status;
