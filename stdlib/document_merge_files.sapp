// Local explicit paths and new copies. All document encoding precedes batch writes.
let Check=import("stdlib:document_merge_check.sapp");
let Text=import("stdlib:text_document.sapp");let Store=import("stdlib:text_document_files.sapp");let Table=import("stdlib:table_files.sapp");let Merge=import("stdlib:document_merge.sapp");let File=import("stdlib:secure_file.sapp");
fn _path(path,ext="") {
 if type(path)!="string" or len(path)<=len(ext) or len(path)>4000 or len(str_to_bytes(path))>4000 or not str_ends_with(str_lower(path),ext) {return false;}
 for i in range(0,len(path)) {let c=strcharcodeat(path,i);if c<32 or c==127 {return false;}}
 return true;
}
fn _read(template_path,table_path,delimiter) {
 if not _path(template_path,".pbtext") {return map{ok:false,error:"Choose a .pbtext template."};}
 let input=try Store.open_document(template_path) catch nil;
 let table=try Table.open(table_path,delimiter) catch nil;
 if input==nil or not input.ok or table==nil or not table.ok {return map{ok:false,error:"Could not read template or table."};}
 return map{ok:true,template:input.document,table:table.document};
}
fn check(template_path,table_path,delimiter=",") {
 let input=_read(template_path,table_path,delimiter);if not input.ok {return input;}
 return map{ok:true,report:Check.inspect(input.template,input.table)};
}
fn load(template_path,table_path,delimiter=",") {
 let input=_read(template_path,table_path,delimiter);if not input.ok {return input;}
 let result=try Merge.render(input.template,input.table) catch nil;
 if result==nil {return map{ok:false,error:"Invalid fields, header names, data rows or output limits."};}
 return map{ok:true,result:result};
}
fn save(path,doc) {
 if not _path(path,".pbtext") {return map{ok:false,error:"Choose a new .pbtext path."};}
 return Store.save_copy(path,doc);
}
fn _encode_all(documents) {
 if type(documents)!="array" or len(documents)<1 or len(documents)>31 {throw "batch size";}
 let result=[];let text_bytes=0;let file_bytes=0;
 for doc in documents {
  text_bytes=text_bytes+Text.validate(doc).text_bytes;if text_bytes>Merge.MAX_BATCH_BYTES {throw "batch text limit";}
  let encoded=Text.encode(doc);file_bytes=file_bytes+len(str_to_bytes(encoded));if file_bytes>2097152 {throw "batch file limit";}
  array_push(result,encoded);
 }
 return result;
}
fn save_all(prefix,documents) {
 if not _path(prefix) {return map{ok:false,completed:0,error:"Choose an output filename prefix."};}
 let encoded=try _encode_all(documents) catch nil;
 if encoded==nil {return map{ok:false,completed:0,error:"Invalid batch; nothing written."};}
 for i in range(0,len(encoded)) {
  let number=str(i+1);while len(number)<3 {number="0"+number;}
  let write=try File.write_text_new_exclusive(prefix+"-"+number+".pbtext",encoded[i],false,false) catch nil;
  if write==nil or not write.ok {return map{ok:false,completed:i,failed_record:i+1,atomic_batch:false,error:"Batch stopped. Completed copies remain; the failed copy may be incomplete. Use a new prefix."};}
 }
 return map{ok:true,completed:len(encoded),atomic_batch:false};
}
export load,check,save,save_all;
