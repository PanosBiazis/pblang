// stdlib/crypto_quantum.sapp — quantum-safe / post-quantum cryptography concepts.
//
// This module exposes algorithm names and specs for:
// - QKD (Quantum Key Distribution): BB84, E91, etc.
// - PQC (Post-Quantum Cryptography): NIST-standardized KEMs and signatures.
// Implementations are intended to be provided by native libs or external services.

// QKD protocols (algorithm names for integration)
let QKD_PROTOCOLS = map{
    bb84: "BB84",
    e91: "E91",
    b92: "B92",
    description: "Quantum Key Distribution: key exchange with information-theoretic security under physical assumptions"
};

// NIST PQC (draft) standard names — KEMs
let PQC_KEM = map{
    kyber512: "Kyber-512",
    kyber768: "Kyber-768",
    kyber1024: "Kyber-1024",
    description: "Module-lattice KEM; NIST selected for standardization"
};

// NIST PQC — signatures
let PQC_SIGNATURE = map{
    dilithium2: "Dilithium2",
    dilithium3: "Dilithium3",
    dilithium5: "Dilithium5",
    description: "Module-lattice signature; NIST selected for standardization"
};

// Algorithm selection helper (returns name string)
fn kem_name(level) {
    return match level {
        case 1: "Kyber-512";
        case 2: "Kyber-768";
        case 3: "Kyber-1024";
        else: "Kyber-768";
    };
}

fn sig_name(level) {
    return match level {
        case 1: "Dilithium2";
        case 2: "Dilithium3";
        case 3: "Dilithium5";
        else: "Dilithium3";
    };
}

// ── Quantum gate / circuit helpers ──────────────────────────────────────
// These produce circuit description maps that can be serialized to JSON
// and sent to a simulator or hardware driver.

let GATES = map{
    // Single-qubit gates
    H:    map{ gate: "H",    qubits: 1, params: [] },
    X:    map{ gate: "X",    qubits: 1, params: [] },
    Y:    map{ gate: "Y",    qubits: 1, params: [] },
    Z:    map{ gate: "Z",    qubits: 1, params: [] },
    S:    map{ gate: "S",    qubits: 1, params: [] },
    T:    map{ gate: "T",    qubits: 1, params: [] },
    // Parameterized rotations
    RX:   map{ gate: "RX",   qubits: 1, params: ["theta"] },
    RY:   map{ gate: "RY",   qubits: 1, params: ["theta"] },
    RZ:   map{ gate: "RZ",   qubits: 1, params: ["theta"] },
    // Two-qubit gates
    CX:   map{ gate: "CX",   qubits: 2, params: [] },
    CZ:   map{ gate: "CZ",   qubits: 2, params: [] },
    SWAP: map{ gate: "SWAP", qubits: 2, params: [] },
    // Three-qubit gates (Toffoli and Fredkin)
    CCX:  map{ gate: "CCX",  qubits: 3, params: [] },
    CCZ:  map{ gate: "CCZ",  qubits: 3, params: [] },
    CSWAP: map{ gate: "CSWAP", qubits: 3, params: [] }
};

fn new_circuit(n_qubits) {
    return map{ n_qubits: n_qubits, ops: [], measurements: [] };
}

fn apply_gate(circuit, gate_name, qubits) {
    let op = map{ gate: gate_name, qubits: qubits, params: [] };
    array_push(circuit["ops"], op);
    return circuit;
}

fn apply_rotation(circuit, gate_name, qubit, theta) {
    let op = map{ gate: gate_name, qubits: [qubit], params: [theta] };
    array_push(circuit["ops"], op);
    return circuit;
}

fn measure(circuit, qubit, classical_bit) {
    let m = map{ qubit: qubit, cbit: classical_bit };
    array_push(circuit["measurements"], m);
    return circuit;
}

fn measure_all(circuit) {
    let i = 0;
    while i < circuit["n_qubits"] {
        measure(circuit, i, i);
        i = i + 1;
    }
    return circuit;
}

// Serialize a circuit to JSON for passing to a backend.
fn circuit_to_json(circuit) {
    return json_stringify(circuit);
}

// ── Statevector simulation (tiny, for debugging) ───────────────────────
// Returns a simulated statevector for very small circuits (≤10 qubits)
// by delegating to a native builtin or returning a stub.
fn simulate(circuit) {
    return map{
        circuit: circuit,
        backend: "stub",
        note: "statevector simulation requires a native quantum simulator plugin"
    };
}

// ── AI-bridge helper ───────────────────────────────────────────────────
// Encodes a circuit as a feature vector for ML-assisted transpilation
// or error-mitigation, suitable for feeding to tensor ops.
fn circuit_features(circuit) {
    let n = circuit["n_qubits"];
    let depth = len(circuit["ops"]);
    let n_meas = len(circuit["measurements"]);
    return map{
        n_qubits: n,
        depth: depth,
        n_measurements: n_meas,
        gate_counts: _count_gates(circuit)
    };
}

fn _count_gates(circuit) {
    let counts = map{};
    let i = 0;
    while i < len(circuit["ops"]) {
        let g = circuit["ops"][i]["gate"];
        if counts[g] == nil {
            counts[g] = 0;
        }
        counts[g] = counts[g] + 1;
        i = i + 1;
    }
    return counts;
}

export QKD_PROTOCOLS, PQC_KEM, PQC_SIGNATURE, kem_name, sig_name,
       GATES, new_circuit, apply_gate, apply_rotation, measure, measure_all,
       circuit_to_json, simulate, circuit_features;
