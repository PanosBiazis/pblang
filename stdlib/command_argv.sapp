// Bounded command-text to literal-argv conversion without shell evaluation.
// This compatibility parser supports whitespace, quotes, and conservative
// escaping. Shell operators, substitutions, redirects and controls fail closed.

let MAX_TEXT_BYTES = 65536;
let MAX_ARGS = 100;
let MAX_ARG_BYTES = 4096;

fn _error(message, offset = nil) {
    if offset == nil { offset = 0 - 1; }
    return map{ ok: false, format: "pblang.command-argv.v1", error: message,
        error_offset: offset, shell_evaluated: false };
}

fn _push(out, current, started, total_bytes) {
    if not started { return map{ ok: true, total_bytes: total_bytes }; }
    let bytes = len(str_to_bytes(current));
    if bytes > MAX_ARG_BYTES { return _error("one argument exceeds 4096 UTF-8 bytes"); }
    if len(out) >= MAX_ARGS { return _error("command contains more than 100 arguments"); }
    total_bytes = total_bytes + bytes;
    if total_bytes > MAX_TEXT_BYTES { return _error("argument bytes exceed 65536 bytes"); }
    array_push(out, current);
    return map{ ok: true, total_bytes: total_bytes };
}

fn parse(text) {
    if type(text) != "string" { return _error("command must be a string"); }
    let source_bytes = len(str_to_bytes(text));
    if source_bytes < 1 or source_bytes > MAX_TEXT_BYTES {
        return _error("command must contain 1..65536 UTF-8 bytes");
    }
    let out = []; let current = ""; let started = false; let quote = 0;
    let escaped = false; let total_bytes = 0; let i = 0;
    while i < len(text) {
        let code = strcharcodeat(text, i);
        if code == 0 or code == 10 or code == 13 or code < 9 or (code > 13 and code < 32) or code == 127 {
            return _error("control characters are not allowed", i);
        }
        if escaped {
            if code != 32 and code != 9 and code != 34 and code != 39 and code != 92 {
                return _error("unsupported backslash escape", i);
            }
            current = current + strfromcharcode(code); started = true; escaped = false;
        } elif quote == 39 {
            if code == 39 { quote = 0; }
            else { current = current + strfromcharcode(code); started = true; }
        } elif quote == 34 {
            if code == 34 { quote = 0; }
            elif code == 92 { escaped = true; }
            elif code == 36 or code == 96 { return _error("shell substitution is not allowed", i); }
            else { current = current + strfromcharcode(code); started = true; }
        } else {
            if code == 32 or code == 9 {
                let pushed = _push(out, current, started, total_bytes);
                if not pushed.ok { return pushed; }
                total_bytes = pushed.total_bytes; current = ""; started = false;
            } elif code == 39 or code == 34 {
                quote = code; started = true;
            } elif code == 92 {
                escaped = true; started = true;
            } elif code == 36 or code == 96 or code == 35 or code == 38 or code == 40
                   or code == 41 or code == 59 or code == 60 or code == 62 or code == 124 {
                return _error("shell operators, comments, and substitutions are not allowed", i);
            } else { current = current + strfromcharcode(code); started = true; }
        }
        i = i + 1;
    }
    if escaped { return _error("command ends with an incomplete escape", len(text)); }
    if quote != 0 { return _error("command has an unterminated quote", len(text)); }
    let pushed = _push(out, current, started, total_bytes);
    if not pushed.ok { return pushed; }
    if len(out) == 0 or out[0] == "" { return _error("command program is empty"); }
    return map{ ok: true, format: "pblang.command-argv.v1", argv: out,
        argument_count: len(out), source_bytes: source_bytes,
        argument_bytes: pushed.total_bytes, shell_evaluated: false,
        expansions_supported: false, operators_supported: false };
}

fn validate(argv) {
    if type(argv) != "array" or len(argv) < 1 or len(argv) > MAX_ARGS {
        return _error("argv must contain 1..100 strings");
    }
    let out = []; let total = 0;
    for i len(argv) {
        if type(argv[i]) != "string" or str_contains(argv[i], strfromcharcode(0)) {
            return _error("every argv element must be a NUL-free string", i);
        }
        let bytes = len(str_to_bytes(argv[i]));
        if bytes > MAX_ARG_BYTES { return _error("one argument exceeds 4096 UTF-8 bytes", i); }
        total = total + bytes;
        if total > MAX_TEXT_BYTES { return _error("argument bytes exceed 65536 bytes", i); }
        array_push(out, argv[i]);
    }
    if out[0] == "" or str_starts_with(out[0], "-") or str_contains(out[0], "/")
       or str_contains(out[0], "\\") {
        return _error("argv program must be a bare non-option name", 0);
    }
    return map{ ok: true, format: "pblang.command-argv.v1", argv: out,
        argument_count: len(out), argument_bytes: total,
        shell_evaluated: false, expansions_supported: false, operators_supported: false };
}

export parse, validate;
