// stdlib/harden.sapp — defensive hardening for pblang apps.
//
// HONEST SCOPE: reverse engineering can never be made impossible — anyone with the binary
// and enough time wins. What this removes are the EASY wins an RE/forensics tool relies on:
//   * scrub      — overwrite a secret byte buffer so it doesn't linger in memory ("no clues").
//                  pblang strings are immutable (the VM may keep copies), so hold secrets in
//                  MUTABLE byte arrays and scrub those — that is what's actually wipeable.
//   * constant_time_eq — compare secrets without an early-exit timing side channel.
//   * integrity_tag / verify_integrity — detect tampering of config/code/assets (sha256).
//   * native_is_stripped — confirm a generated ELF ships no symbol table / section headers,
//                  so nm/objdump/strings have nothing to latch onto. (The native codegen path
//                  is itself the strongest anti-RE option: it ships machine code, not source.)
//
//   let h = import("stdlib/harden.sapp");
//   h.with_secret(keybytes, fn(k){ ...use k... });   // k is wiped afterward

// ── secret hygiene ────────────────────────────────────────────────────────────────────
// scrub(buf) — overwrite every byte of a MUTABLE array with 0, in place. Returns the count.
fn scrub(buf) {
    let i = 0;
    while i < len(buf) { buf[i] = 0; i = i + 1; }
    return len(buf);
}

// with_secret(buf, body) — run body(buf), then scrub buf (best-effort: a throw inside body
// bypasses the wipe, so keep body total and let the caller scrub on its own error paths too).
fn with_secret(buf, body) {
    let r = body(buf);
    scrub(buf);
    return r;
}

// ── constant-time comparison ──────────────────────────────────────────────────────────
// constant_time_eq(a, b) — equality over byte arrays with NO early exit on the first
// mismatch (so timing doesn't leak how many leading bytes matched). A length difference is
// reported immediately (length is not usually the secret).
fn constant_time_eq(a, b) {
    if len(a) != len(b) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(a) {
        let x = a[i]; let y = b[i];
        let d = x - y;
        if d < 0 { d = 0 - d; }
        if d != 0 { diff = diff + 1; }   // accumulate, never branch out early
        i = i + 1;
    }
    return diff == 0;
}

// constant_time_eq_str(a, b) — same, over strings (compares codepoints).
fn constant_time_eq_str(a, b) {
    if len(a) != len(b) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(a) {
        if strcharcodeat(a, i) != strcharcodeat(b, i) { diff = diff + 1; }
        i = i + 1;
    }
    return diff == 0;
}

// ── integrity / tamper detection ──────────────────────────────────────────────────────
// integrity_tag(s) — a sha256 hex digest binding the exact bytes of `s`.
fn integrity_tag(s) { return sha256(s); }

// verify_integrity(s, tag) — does `s` still hash to `tag`? Constant-time compared so a
// tamper-and-time attack can't recover the expected digest byte by byte.
fn verify_integrity(s, tag) { return constant_time_eq_str(sha256(s), tag); }

// ── native binary anti-clue check ─────────────────────────────────────────────────────
fn _le_at(bytes, off, k) {
    let v = 0; let m = 1; let i = 0;
    while i < k { v = v + bytes[off + i] * m; m = m * 256; i = i + 1; }
    return v;
}
// native_is_stripped(elf) — true when the ELF64 has no section-header table (e_shoff==0)
// and no section entries (e_shnum==0): nothing for nm/objdump -h/readelf -S to enumerate.
fn native_is_stripped(elf) {
    if len(elf) < 64 { return false; }
    let e_shoff = _le_at(elf, 40, 8);
    let e_shnum = _le_at(elf, 60, 2);
    return e_shoff == 0 and e_shnum == 0;
}

export scrub, with_secret, constant_time_eq, constant_time_eq_str;
export integrity_tag, verify_integrity, native_is_stripped;
