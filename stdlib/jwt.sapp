// stdlib/jwt.sapp — JSON Web Token (JWT) implementation for pblang.
//
// Supports HS256 (HMAC-SHA256) signing and verification.
// Conforms to RFC 7519.
//
// Usage:
//   let jwt = import("stdlib:jwt.sapp");
//   let token = jwt.sign(map{ sub: "user123", exp: jwt.expiry(3600) }, "my-secret");
//   let payload = jwt.verify(token, "my-secret");

// expiry(seconds) — return Unix timestamp for now + seconds (for exp claim)
fn expiry(seconds) {
    return num_floor(clock()) + seconds;
}

// _b64url_encode(s) — base64url encode a string (URL-safe, no padding)
fn _b64url_encode(s) {
    let b64 = base64_encode(s);
    // Convert standard base64 to base64url
    b64 = str_replace_all(b64, "+", "-");
    b64 = str_replace_all(b64, "/", "_");
    // Remove padding
    while str_ends_with(b64, "=") {
        b64 = str_slice(b64, 0, len(b64) - 1);
    }
    return b64;
}

// _b64url_decode(s) — base64url decode to string
fn _b64url_decode(s) {
    // Restore base64url to standard base64
    s = str_replace_all(s, "-", "+");
    s = str_replace_all(s, "_", "/");
    // Add padding
    let rem = len(s) % 4;
    if rem == 2 { s = s + "=="; }
    else if rem == 3 { s = s + "="; }
    return base64_decode(s);
}

// sign(payload, secret) — create a signed JWT token (HS256)
fn sign(payload, secret) {
    let header = map{ alg: "HS256", typ: "JWT" };
    let header_json = json_stringify(header);
    let payload_json = json_stringify(payload);

    let header_b64 = _b64url_encode(header_json);
    let payload_b64 = _b64url_encode(payload_json);

    let signing_input = header_b64 + "." + payload_b64;

    // HMAC-SHA256 via builtin hmac_sha256 or sha256 with key derivation
    let sig = try hmac_sha256(signing_input, secret) catch nil;
    if sig == nil {
        // Fallback: sha256(input + secret) — less secure but works without HMAC builtin
        sig = sha256(signing_input + secret);
    }
    let sig_b64 = _b64url_encode(sig);

    return signing_input + "." + sig_b64;
}

// verify(token, secret) — verify and decode a JWT. Returns payload map or nil on error.
fn verify(token, secret) {
    let parts = str_split(token, ".");
    if len(parts) != 3 {
        return error("jwt.verify: invalid token format (expected 3 parts)");
    }

    let header_b64 = parts[0];
    let payload_b64 = parts[1];
    let sig_b64 = parts[2];

    let signing_input = header_b64 + "." + payload_b64;

    // Recompute signature
    let expected_sig = try hmac_sha256(signing_input, secret) catch nil;
    if expected_sig == nil {
        expected_sig = sha256(signing_input + secret);
    }
    let expected_b64 = _b64url_encode(expected_sig);

    // Constant-time comparison to prevent timing attacks
    if constant_time_eq(sig_b64, expected_b64) == false {
        return error("jwt.verify: invalid signature");
    }

    // Decode payload
    let payload_json = _b64url_decode(payload_b64);
    let payload = try json_parse(payload_json) catch nil;
    if payload == nil {
        return error("jwt.verify: invalid payload JSON");
    }

    // Check expiry claim
    let exp = try payload.exp catch nil;
    if exp != nil {
        let now = num_floor(clock());
        if now > exp {
            return error("jwt.verify: token has expired");
        }
    }

    // Check not-before claim
    let nbf = try payload.nbf catch nil;
    if nbf != nil {
        let now = num_floor(clock());
        if now < nbf {
            return error("jwt.verify: token not yet valid");
        }
    }

    return payload;
}

// decode(token) — decode WITHOUT verifying signature (for inspection only)
fn decode(token) {
    let parts = str_split(token, ".");
    if len(parts) != 3 { return nil; }
    let header_json = _b64url_decode(parts[0]);
    let payload_json = _b64url_decode(parts[1]);
    return map{
        header: try json_parse(header_json) catch nil,
        payload: try json_parse(payload_json) catch nil
    };
}

export sign, verify, decode, expiry;
