let Study=import("stdlib:study_cards.sapp");let Order=import("stdlib:seeded_order.sapp");
fn integer(text,maximum){if type(text)!="string" or len(text)<1 or len(text)>10 {throw "bounded unsigned integer required";}for i in range(0,len(text)){if not str_contains("0123456789",str_slice(text,i,i+1)){throw "unsigned decimal digits required";}}let n=parse_number(text);if n>maximum{throw "integer limit";}return n;}
fn parse_seed(text){return integer(text,4294967295);}
fn parse_count(text){let n=integer(text,64);if n<1{throw "count must be 1..64";}return n;}
fn create(deck,count,seed){let out=Study.copy(deck);if type(count)!="number" or count!=num_floor(count) or not(count>=1 and count<=len(out.cards)){throw "count exceeds available cards";}
 let order=Order.permutation(len(out.cards),seed);let cards=[];let ids=[];let positions=[];
 for i in range(0,count){let index=order[i];array_push(cards,out.cards[index]);array_push(ids,out.cards[index].id);array_push(positions,index+1);}out.cards=cards;Study.validate(out);
 return map{format:"pblang.study-mix.v1",deck:out,seed:seed,count:count,source_count:len(deck.cards),source_positions:positions,ids:ids};
}
fn summary(report){return map{seed:report.seed,count:report.count,source_count:report.source_count,ids:report.ids,source_positions:report.source_positions};}
export create,parse_seed,parse_count,summary;
