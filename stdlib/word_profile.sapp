let Text=import("stdlib:text_document.sapp");let Metrics=import("stdlib:text_metrics.sapp");let Sheet=import("stdlib:sheet_document.sapp");
let MAX_UNIQUE=256;let PAGE_SIZE=8;
fn analyze(doc){Text.validate(doc);let lookup=map{};let entries=[];let total=0;
 for b in range(0,len(doc.blocks)){for token in Metrics.tokens(doc.blocks[b].text){
  if len(str_to_bytes(token))>256 {throw "word profile: token exceeds 256 bytes";}
  total=total+1;let index=0;
  if map_has(lookup,token){index=lookup[token];} else {if len(entries)>=MAX_UNIQUE{throw "word profile: more than 256 distinct tokens";}index=len(entries);lookup[token]=index;array_push(entries,map{token:token,count:0,blocks:[]});}
  let entry=entries[index];entry.count=entry.count+1;
  if len(entry.blocks)==0 or entry.blocks[len(entry.blocks)-1]!=b {array_push(entry.blocks,b);}
 }}
 // Stable insertion sort retains first-seen order for equal frequencies.
 for i in range(1,len(entries)){let entry=entries[i];let j=i;while j>0 and entries[j-1].count<entry.count{entries[j]=entries[j-1];j=j-1;}entries[j]=entry;}
 return map{total:total,unique:len(entries),pages:num_max(1,num_ceil(len(entries)/PAGE_SIZE)),entries:entries};
}
fn _page(report,index){if type(index)!="number" or not(index>=0 and index<report.pages) or index!=num_floor(index){throw "word profile: page index";}
 let entries=[];for i in range(index*PAGE_SIZE,num_min((index+1)*PAGE_SIZE,report.unique)){array_push(entries,report.entries[i]);}
 return map{total:report.total,unique:report.unique,pages:report.pages,index:index,entries:entries};
}
fn page(doc,index=0){return _page(analyze(doc),index);}
// Exact form lookup using the same frequency order and a single analysis.
fn locate(doc,token){if type(token)!="string" or len(token)==0 or len(token)>256 or len(str_to_bytes(token))>256 or str_contains(token,"\u0000"){throw "word profile: nonempty token up to 256 bytes required";}
 let report=analyze(doc);for i in range(0,len(report.entries)){if report.entries[i].token==token{return map{found:true,position:i,page:_page(report,num_floor(i/PAGE_SIZE))};}}return map{found:false};
}
fn to_sheet(doc,index=0){let selected=page(doc,index);let cells=[["Token","Count","Writer blocks (1-based)","Page"]];
 for item in selected.entries{let blocks=[];for b in item.blocks{array_push(blocks,str(b+1));}array_push(cells,[item.token,str(item.count),str_join(blocks,", "),str(index+1)+" / "+str(selected.pages)]);}
 let sheet=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(sheet);return sheet;
}
export MAX_UNIQUE,PAGE_SIZE,analyze,page,locate,to_sheet;
