    map{ suffix: ".pl", label: "Perl Source", family: "source" },
    map{ suffix: ".lua", label: "Lua Source", family: "source" },
    map{ suffix: ".f90", label: "Fortran Source", family: "source" },
    map{ suffix: ".f95", label: "Fortran Source", family: "source" },
    map{ suffix: ".f", label: "Fortran Source", family: "source" },
    map{ suffix: ".pas", label: "Pascal Source", family: "source" },
    map{ suffix: ".pp", label: "Pascal Source", family: "source" },
    map{ suffix: ".cbl", label: "COBOL Source", family: "source" },
    map{ suffix: ".cob", label: "COBOL Source", family: "source" },
    map{ suffix: ".asm", label: "Assembly Source", family: "source" },
    map{ suffix: ".s", label: "Assembly Source", family: "source" },
    map{ suffix: ".inc", label: "Source Include", family: "source" },
    map{ suffix: ".qs", label: "Q# Source", family: "source" },
    map{ suffix: ".cs", label: "C# Source", family: "source" },
    map{ suffix: ".vb", label: "Visual Basic Source", family: "source" },
    map{ suffix: ".vbs", label: "Visual Basic Script", family: "source" },
    map{ suffix: ".php", label: "PHP Source", family: "source" },
    map{ suffix: ".js", label: "JavaScript Source", family: "source" },
    map{ suffix: ".mjs", label: "JavaScript Module", family: "source" },
    map{ suffix: ".cjs", label: "JavaScript Module", family: "source" },
    map{ suffix: ".ts", label: "TypeScript Source", family: "source" },
    map{ suffix: ".tsx", label: "TypeScript JSX", family: "source" },
    map{ suffix: ".jsx", label: "JavaScript JSX", family: "source" },
    map{ suffix: ".html", label: "HTML Document", family: "source" },
    map{ suffix: ".htm", label: "HTML Document", family: "source" },
    map{ suffix: ".css", label: "CSS Stylesheet", family: "source" },
    map{ suffix: ".scss", label: "SCSS Stylesheet", family: "source" },
    map{ suffix: ".sass", label: "Sass Stylesheet", family: "source" },
    map{ suffix: ".sh", label: "Shell Script", family: "source" },
    map{ suffix: ".bash", label: "Shell Script", family: "source" },
    map{ suffix: ".bat", label: "Batch Script", family: "source" },
    map{ suffix: ".cmd", label: "Batch Script", family: "source" },
    map{ suffix: ".ps1", label: "PowerShell Script", family: "source" },
    map{ suffix: ".r", label: "R Source", family: "source" },
    map{ suffix: ".hs", label: "Haskell Source", family: "source" },
    map{ suffix: ".lisp", label: "Lisp Source", family: "source" },
    map{ suffix: ".clj", label: "Clojure Source", family: "source" },
    map{ suffix: ".erl", label: "Erlang Source", family: "source" },
