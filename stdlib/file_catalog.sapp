    map{ suffix: ".toml", label: "TOML Configuration", family: "configuration" },
    map{ suffix: ".ini", label: "INI Configuration", family: "configuration" },
    map{ suffix: ".cfg", label: "Configuration File", family: "configuration" },
    map{ suffix: ".log", label: "Log File", family: "data" },
    map{ suffix: ".sql", label: "SQL Source", family: "database" },
    map{ suffix: ".sqlite3", label: "SQLite Database", family: "database" },
    map{ suffix: ".sqlite", label: "SQLite Database", family: "database" },
    map{ suffix: ".db", label: "Database File", family: "database" },
    map{ suffix: ".png", label: "PNG Image", family: "image" },
    map{ suffix: ".jpg", label: "JPEG Image", family: "image" },
    map{ suffix: ".jpeg", label: "JPEG Image", family: "image" },
