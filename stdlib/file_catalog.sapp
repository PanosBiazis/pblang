    map{ suffix: ".heif", label: "HEIF Image", family: "image" },
    map{ suffix: ".raw", label: "Raw Image", family: "image" },
    map{ suffix: ".mp3", label: "MP3 Audio", family: "audio" },
    map{ suffix: ".wav", label: "WAV Audio", family: "audio" },
    map{ suffix: ".flac", label: "FLAC Audio", family: "audio" },
    map{ suffix: ".ogg", label: "Ogg Audio", family: "audio" },
    map{ suffix: ".aac", label: "AAC Audio", family: "audio" },
    map{ suffix: ".m4a", label: "M4A Audio", family: "audio" },
    map{ suffix: ".opus", label: "Opus Audio", family: "audio" },
    map{ suffix: ".mp4", label: "MP4 Video", family: "video" },
    map{ suffix: ".mkv", label: "Matroska Video", family: "video" },
    map{ suffix: ".avi", label: "AVI Video", family: "video" },
    map{ suffix: ".mov", label: "QuickTime Video", family: "video" },
    map{ suffix: ".webm", label: "WebM Video", family: "video" },
    map{ suffix: ".mpeg", label: "MPEG Video", family: "video" },
    map{ suffix: ".mpg", label: "MPEG Video", family: "video" },
    map{ suffix: ".3gp", label: "3GP Video", family: "video" },
    map{ suffix: ".zip", label: "Zip Archive", family: "archive" },
    map{ suffix: ".tar", label: "Tar Archive", family: "archive" },
    map{ suffix: ".gz", label: "Gzip Archive", family: "archive" },
    map{ suffix: ".bz2", label: "Bzip2 Archive", family: "archive" },
    map{ suffix: ".xz", label: "Xz Archive", family: "archive" },
    map{ suffix: ".7z", label: "7-Zip Archive", family: "archive" },
    map{ suffix: ".rar", label: "RAR Archive", family: "archive" },
    map{ suffix: ".apk", label: "Android Package", family: "package" },
    map{ suffix: ".obb", label: "Android Expansion Package", family: "package" },
    map{ suffix: ".ipa", label: "iOS Package", family: "package" },
    map{ suffix: ".deb", label: "Debian Package", family: "package" },
    map{ suffix: ".rpm", label: "RPM Package", family: "package" },
    map{ suffix: ".msi", label: "Windows Installer", family: "package" },
    map{ suffix: ".exe", label: "Windows Executable", family: "executable" },
    map{ suffix: ".wasm", label: "WebAssembly Binary", family: "executable" },
    map{ suffix: ".bin", label: "Binary File", family: "binary" },
    map{ suffix: ".dll", label: "Shared Library", family: "binary" },
    map{ suffix: ".so", label: "Shared Library", family: "binary" },
    map{ suffix: ".dylib", label: "Shared Library", family: "binary" },
    map{ suffix: ".ttf", label: "TrueType Font", family: "font" },
    map{ suffix: ".otf", label: "OpenType Font", family: "font" },
    map{ suffix: ".woff", label: "Web Font", family: "font" },
    map{ suffix: ".woff2", label: "Web Font", family: "font" },
    map{ suffix: ".stl", label: "3D Model", family: "model-3d" },
    map{ suffix: ".obj", label: "3D Model or Object", family: "model-3d" },
    map{ suffix: ".fbx", label: "3D Model", family: "model-3d" },
    map{ suffix: ".blend", label: "Blender Project", family: "model-3d" },
    map{ suffix: ".vmdk", label: "Virtual Disk", family: "disk-image" },
    map{ suffix: ".vdi", label: "Virtual Disk", family: "disk-image" },
    map{ suffix: ".vhd", label: "Virtual Disk", family: "disk-image" },
    map{ suffix: ".img", label: "Disk Image", family: "disk-image" },
    map{ suffix: ".mod", label: "Module File", family: "source" },
    map{ suffix: ".lock", label: "Dependency Lock", family: "configuration" },
    map{ suffix: ".bak", label: "Backup File", family: "other" },
    map{ suffix: ".tmp", label: "Temporary File", family: "other" }
];

// Internal ordered buckets retain multipart precedence without scanning every rule.
fn _rule_index() {
    let index = map{};
    let maximum_key_length = 0;
    for rule in RULES {
        let parts = str_split(rule.suffix, ".");
        let key = parts[len(parts) - 1];
        maximum_key_length = num_max(maximum_key_length, len(key));
        if not map_has(index, key) { index[key] = []; }
        array_push(index[key], rule);
    }
    return map{ buckets: index, tail_length: maximum_key_length + 1 };
}
let RULE_INDEX = _rule_index();

fn _suffix_key(name) {
    // Inspect only the rule-derived tail. Dot-heavy names must not allocate
    // an array proportional to the whole input just to find a candidate bucket.
    let tail = name;
    if len(name) > RULE_INDEX.tail_length {
        tail = str_slice(name, len(name) - RULE_INDEX.tail_length, len(name));
    }
    let parts = str_split(tail, ".");
    if len(parts) < 2 { return ""; }
    return parts[len(parts) - 1];
}

// Metadata paths can originate on another OS. Never delegate this parsing to
// host filesystem semantics or request filesystem capability for classification.
fn _basename(path) {
    if str_contains(path, "/") or str_contains(path, "\\") {
        let normalized = str_replace_all(path, "\\", "/");
        let size = len(normalized);
        let width = num_min(64, size);
        let tail = str_slice(normalized, size - width, size);
        if width < size and not str_contains(tail, "/") {
            // A single directory prefix needs no repeated tail expansion.
            let remainder = str_slice(normalized, str_index_of(normalized, "/") + 1, size);
            if not str_contains(remainder, "/") { return remainder; }
        }
        // Expand only until the final separator is present. This preserves
        // arbitrary admitted basename lengths without splitting the full prefix.
        while width < size and not str_contains(tail, "/") {
            width = num_min(size, width * 2);
            tail = str_slice(normalized, size - width, size);
        }
        let parts = str_split(tail, "/");
        return parts[len(parts) - 1];
    }
    if len(path) >= 2 and strcharcodeat(path, 1) == 58 {
        let code = strcharcodeat(path, 0);
        if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) {
            return str_slice(path, 2, len(path));
        }
    }
    return path;
}

fn _special(lower) {
    if lower == "makefile" or lower == "dockerfile" or lower == "cmakelists.txt" {
        return map{ suffix: "", label: "Build Configuration", family: "configuration" };
    }
    if lower == ".gitignore" or lower == ".gitattributes" or lower == ".editorconfig" {
        return map{ suffix: "", label: "Repository Configuration", family: "configuration" };
    }
    return nil;
}

fn _extension(lower) {
    let dot = Strings.last_index_of(lower, ".");
    if dot <= 0 or dot >= len(lower) - 1 { return ""; }
    return str_slice(lower, dot, len(lower));
}

fn classify(path) {
    if type(path) != "string" or len(path) < 1 or len(path) > MAX_NAME_BYTES {
        throw "file_catalog: path must be a 1..4096 byte string";
    }
    let name = _basename(path);
    if name == "" or name == "." or name == ".." {
        throw "file_catalog: path must identify a file name";
    }
    let lower = str_lower(name);
    let selected = _special(lower);
    if selected == nil {
        let key = _suffix_key(lower);
        if map_has(RULE_INDEX.buckets, key) {
            let candidates = RULE_INDEX.buckets[key];
            let i = 0;
            while i < len(candidates) {
                if str_ends_with(lower, candidates[i].suffix) {
                    selected = candidates[i];
                    break;
                }
                i = i + 1;
            }
        }
    }
    if selected == nil {
        return map{ format: FORMAT, known: false, name: name,
            suffix: _extension(lower), label: "Unknown", family: "unknown" };
    }
    return map{ format: FORMAT, known: true, name: name,
        suffix: selected.suffix, label: selected.label, family: selected.family };
}

fn _rows(counts) {
    let rows = [];
    for key in array_sort(map_keys(counts)) {
        array_push(rows, map{ name: key, count: counts[key] });
    }
    return rows;
}

// Presence checks distinguish an absent option from an explicitly invalid nil
// on both retained and self-hosted map implementations.
fn _option(options, key, fallback) {
    if map_has(options, key) { return options[key]; }
    return fallback;
}

fn summarize(items, options = nil) {
    if type(items) != "array" { throw "file_catalog: items must be an array"; }
    if options == nil { options = map{}; }
    if type(options) != "map" { throw "file_catalog: options must be a map"; }
    let max_items = _option(options, "max_items", MAX_ITEMS);
    let include_names = _option(options, "include_names", false);
    if type(max_items) != "number" or max_items != num_floor(max_items)
       or max_items < 1 or max_items > MAX_ITEMS {
        throw "file_catalog: max_items must be an integer from 1 to 4096";
    }
    if type(include_names) != "bool" { throw "file_catalog: include_names must be boolean"; }
    if len(items) > max_items { throw "file_catalog: item limit exceeded"; }

    let labels = map{};
    let families = map{};
    let disclosed = [];
    let total = 0;
    let unknown = 0;
    let item_index = 0;
    while item_index < len(items) {
        let kind = if type(items[item_index]) == "map" {
            try items[item_index].kind catch "file"
        } else { "file" };
        if kind != "dir" {
            let name = if type(items[item_index]) == "map" {
                try items[item_index].name catch ""
            } else { items[item_index] };
            let entry = classify(name);
            labels[entry.label] = (try labels[entry.label] catch 0) + 1;
            families[entry.family] = (try families[entry.family] catch 0) + 1;
            total = total + 1;
            if not entry.known { unknown = unknown + 1; }
            if include_names { array_push(disclosed, entry); }
        }
        item_index = item_index + 1;
    }
    return map{
        format: "pblang.file-catalog.summary.v1",
        total_files: total,
        known_files: total - unknown,
        unknown_files: unknown,
        by_label: labels,
        by_family: families,
        label_rows: _rows(labels),
        family_rows: _rows(families),
        names_included: include_names,
        classified_items: disclosed,
        bounded: true,
        content_read: false,
        privacy: if include_names {
            "explicit basename disclosure enabled; directory paths and file contents are absent"
        } else {
            "aggregate counts only; names, directory paths and file contents are absent"
        }
    };
}

fn scan_directory(path, options = nil) {
    if type(path) != "string" or len(path) < 1 or len(path) > MAX_NAME_BYTES {
        throw "file_catalog: directory path must be a 1..4096 byte string";
    }
    if options == nil { options = map{}; }
    if type(options) != "map" { throw "file_catalog: options must be a map"; }
    let max_items = _option(options, "max_items", MAX_ITEMS);
    let include_names = _option(options, "include_names", false);
    if type(max_items) != "number" or max_items != num_floor(max_items)
       or max_items < 1 or max_items > MAX_ITEMS {
        throw "file_catalog: max_items must be an integer from 1 to 4096";
    }
    let inventory = Inventory.inventory_roots([path], map{
        max_depth: 1, max_entries: max_items, max_children_per_dir: max_items,
        include_files: true, include_dirs: false, max_runtime_ms: 10000
    });
    if inventory.scanned_dirs < 1 {
        throw "file_catalog: path is not an accessible directory";
    }
    let report = summarize(inventory.records, map{
        max_items: max_items, include_names: include_names
    });
    report.inventory_truncated = inventory.truncated;
    report.inventory_timed_out = inventory.timed_out;
    report.scanned_entries = inventory.scanned_entries;
    report.scan_scope = "one directory level, metadata only";
    return report;
}

fn visualization_plan(summary, width = 960, height = 540) {
    if type(summary) != "map" or (try summary.format catch "")
       != "pblang.file-catalog.summary.v1" {
        throw "file_catalog: summary report is required";
    }
    if type(width) != "number" or width != num_floor(width) or width < 240 or width > 4096
       or type(height) != "number" or height != num_floor(height) or height < 240 or height > 4096 {
        throw "file_catalog: visualization dimensions must be integers from 240 to 4096";
    }
    let rows = summary.family_rows;
    let maximum = 1;
    for row in rows { if row.count > maximum { maximum = row.count; } }
    let bars = [];
    let sectors = [];
    let radial = [];
    let count = len(rows);
    let slot = if count == 0 { width } else { width / count };
    let angle = 0;
    let i = 0;
    while i < count {
        let row = rows[i];
        let bar_height = num_floor((height - 80) * row.count / maximum);
        let sweep = if summary.total_files == 0 { 0 }
            else { 360 * row.count / summary.total_files };
        array_push(bars, map{ label: row.name, count: row.count,
            x: num_floor(i * slot + 4), y: height - 40 - bar_height,
            width: num_max(1, num_floor(slot - 8)), height: bar_height });
        array_push(sectors, map{ label: row.name, count: row.count,
            start_degrees: angle, end_degrees: angle + sweep });
        array_push(radial, map{ label: row.name, count: row.count,
            angle_degrees: angle + sweep / 2, normalized_height: row.count / maximum });
        angle = angle + sweep;
        i = i + 1;
    }
    return map{
        format: "pblang.file-catalog.visualization.v1",
        width: width, height: height, bars: bars, donut_sectors: sectors,
        radial_columns: radial, accessible_rows: rows,
        deterministic: true, renderer_required: true, foreign_runtime_required: false
    };
}

fn capabilities() {
    return map{
        format: "pblang.file-catalog.capabilities.v1",
        metadata_only: true, content_detection: false, magic_byte_detection: false,
        recursive_scan: false, case_insensitive_suffixes: true,
        multipart_suffixes: true, aggregate_privacy_default: true,
        maximum_items: MAX_ITEMS, rule_count: len(RULES)
    };
}

export classify, summarize, scan_directory, visualization_plan, capabilities;
