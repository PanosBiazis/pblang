// stdlib/file_catalog.sapp -- deterministic metadata-only file classification.

let Inventory = import("stdlib:project_inventory.sapp");
let Strings = import("stdlib:strings.sapp");

let FORMAT = "pblang.file-catalog.v1";
let MAX_NAME_BYTES = 4096;
let MAX_ITEMS = 4096;

// Rules are longest/specific suffix first. Ambiguous extensions use an honest
// shared label instead of depending on map iteration order.
let RULES = [
    map{ suffix: ".tar.bz2", label: "Tar+Bzip2 Archive", family: "archive" },
    map{ suffix: ".tar.gz", label: "Tar+Gzip Archive", family: "archive" },
    map{ suffix: ".tar.xz", label: "Tar+Xz Archive", family: "archive" },
    map{ suffix: ".d.ts", label: "TypeScript Declaration", family: "source" },
