// stdlib/source_inliner.sapp — a SOURCE-level linker for pblang.
//
// Inlines a multi-module program's import()ed modules into ONE self-contained
// pblang SOURCE string with no remaining import()/export statements, so the
// result can be fed to the C transpiler -> a true native binary for multi-file
// projects. (selfhost_bundle does the same at the BYTECODE level; this is needed
// because the C transpiler consumes source, not chunks.)
//
// Strategy = SHARED namespace, mirroring the bytecode bundler: each module's
// top-level definitions are concatenated (dependencies first), every
// `m.member` reference becomes the bare `member`, and the link is REJECTED
// (ok:false) for anything that could alias or break:
//   - a top-level name defined by two modules (or main),
//   - a module name shadowing a builtin,
//   - an unresolvable import, an import cycle,
//   - an import variable used bare (not as `var.member`),
//   - a non-top-level (nested) import.
//
//   inline_source(main_src, resolve) -> { ok, source, modules } | { ok:false, reason }
//   inline_file(main_path)           -> reads main + deps from disk
//
// resolve(path) returns the module source string, or nil if it can't be found.
//
// The transform is a single string/comment-aware scanner that tracks brace depth,
// so import/export statements are removed at the STATEMENT level (robust whether
// or not statements share a line) and `var.member` is rewritten outside of string
// literals and comments.

let _blt = import("stdlib/compiler/builtins_list.sapp");

let _ALPHA = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
let _DIGIT = "0123456789";
let _IMPORT_PREFIX_BYTES = str_to_bytes("import(\"");

fn _is_alpha(c) { return len(c) == 1 and str_index_of(_ALPHA, c) >= 0; }
fn _is_alnum(c) { return len(c) == 1 and (str_index_of(_ALPHA, c) >= 0 or str_index_of(_DIGIT, c) >= 0); }
fn _is_space(c) { return c == " " or c == "\t"; }
fn _b_alpha(c) { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95; }
fn _b_alnum(c) { return _b_alpha(c) or (c >= 48 and c <= 57); }
fn _b_space(c) { return c == 32 or c == 9; }
fn _b_text(bytes, start, finish) { return bytes_to_str(slice(bytes, start, finish)); }
fn _b_skip_spaces(bytes, at) {
    while at < len(bytes) and _b_space(bytes[at]) { at = at + 1; }
    return at;
}
fn _b_ident_end(bytes, at) {
    while at < len(bytes) and _b_alnum(bytes[at]) { at = at + 1; }
    return at;
}
fn _b_match(bytes, at, expected) {
    if at < 0 or at + len(expected) > len(bytes) { return false; }
    let i = 0;
    while i < len(expected) {
        if bytes[at + i] != expected[i] { return false; }
        i = i + 1;
    }
    return true;
}
fn _b_to_semi(bytes, at) {
    while at < len(bytes) and bytes[at] != 59 { at = at + 1; }
    if at < len(bytes) { at = at + 1; }
    return at;
}

fn _err(reason) { return map{ ok: false, reason: reason }; }
fn _contains(s, sub) { return str_index_of(s, sub) >= 0; }

fn _last_index_of(s, sub) {
    let n = len(s); let m = len(sub); let i = 0; let last = 0 - 1;
    while i + m <= n { if str_slice(s, i, i + m) == sub { last = i; } i = i + 1; }
    return last;
}

// The identifier `let|const <ident> = import(...)` binds, found by backtracking
// from the `import(` offset to the nearest preceding declaration keyword.
fn _var_before(src, idx) {
    let before = str_slice(src, 0, idx);
    let lp = _last_index_of(before, "let ");
    let cp = _last_index_of(before, "const ");
    let p = lp; let skip = 4;
    if cp > lp { p = cp; skip = 6; }
    if p < 0 { return nil; }
    let nn = len(before);
    let j = p + skip;
    while j < nn and str_slice(before, j, j + 1) == " " { j = j + 1; }
    let st = j;
    while j < nn and _is_alnum(str_slice(before, j, j + 1)) { j = j + 1; }
    return str_slice(before, st, j);
}

// Every REAL `import("PATH")` call site -> {var, path}, in source order. The scan
// SKIPS string literals and // and /* */ comments, so an import() written inside a
// comment or string (common in doc comments / examples) is NOT mistaken for a real
// import (which previously made the inliner try to resolve it and falsely reject,
// or pull in an unrelated module). Mirrors the comment/string handling in
// _transform.
fn _find_import_bindings(src) {
    let out = []; let bytes = str_to_bytes(src);
    let n = len(bytes); let i = 0;
    while i < n {
        let c = bytes[i];
        let c2 = 0 - 1;
        if i + 1 < n { c2 = bytes[i + 1]; }
        if c == 34 {
            i = i + 1;
            let go = true;
            while go and i < n {
                let d = bytes[i];
                if d == 92 and i + 1 < n { i = i + 2; }
                else { i = i + 1; if d == 34 { go = false; } }
            }
        } else if c == 47 and c2 == 47 {
            while i < n and bytes[i] != 10 { i = i + 1; }
        } else if c == 47 and c2 == 42 {
            i = i + 2;
            let go = true;
            while go and i < n {
                if bytes[i] == 42 and i + 1 < n and bytes[i + 1] == 47 {
                    i = i + 2; go = false;
                }
                else { i = i + 1; }
            }
        } else if _b_alpha(c) {
            let start = i; i = _b_ident_end(bytes, i);
            let id = _b_text(bytes, start, i);
            if id == "let" or id == "const" {
                let name_at = _b_skip_spaces(bytes, i);
                let name_end = _b_ident_end(bytes, name_at);
                let name = _b_text(bytes, name_at, name_end);
                let eq = _b_skip_spaces(bytes, name_end);
                let value = if eq < n and bytes[eq] == 61 {
                    _b_skip_spaces(bytes, eq + 1)
                } else { n };
                if name != "" and _b_match(bytes, value, _IMPORT_PREFIX_BYTES) {
                    let path_at = value + len(_IMPORT_PREFIX_BYTES);
                    let path_end = path_at;
                    while path_end < n and bytes[path_end] != 34 {
                        path_end = path_end + 1;
                    }
                    array_push(out, map{
                        var: name, path: _b_text(bytes, path_at, path_end)
                    });
                    i = path_end + 1;
                }
            }
        } else { i = i + 1; }
    }
    return out;
}

fn _skip_spaces(src, k) {
    let n = len(src);
    while k < n and _is_space(str_slice(src, k, k + 1)) { k = k + 1; }
    return k;
}
fn _read_ident(src, k) {
    let n = len(src); let st = k;
    while k < n and _is_alnum(str_slice(src, k, k + 1)) { k = k + 1; }
    return str_slice(src, st, k);
}
fn _to_semi(src, i) {
    let n = len(src);
    while i < n and str_slice(src, i, i + 1) != ";" { i = i + 1; }
    if i < n { i = i + 1; }
    return i;
}

// Single-pass transform: strip top-level import/export statements, rewrite
// var.member -> member, collect top-level fn/let names. Returns
// { body, names, bare, bare_name }.
fn _transform(src, varset) {
    let out = ""; let n = len(src); let i = 0; let depth = 0;
    let names = []; let bare = false; let bare_name = ""; let nested = false;
    while i < n {
        let c = str_slice(src, i, i + 1);
        let c2 = ""; if i + 1 < n { c2 = str_slice(src, i + 1, i + 2); }
        if c == "\"" {
            out = out + c; i = i + 1; let go = true;
            while go and i < n {
                let d = str_slice(src, i, i + 1);
                if d == "\\" and i + 1 < n { out = out + d + str_slice(src, i + 1, i + 2); i = i + 2; }
                else { out = out + d; i = i + 1; if d == "\"" { go = false; } }
            }
        } else if c == "/" and c2 == "/" {
            let go = true;
            while go and i < n { let d = str_slice(src, i, i + 1); out = out + d; i = i + 1; if d == "\n" { go = false; } }
        } else if c == "/" and c2 == "*" {
            out = out + c + c2; i = i + 2; let go = true;
            while go and i < n {
                let d = str_slice(src, i, i + 1);
                if d == "*" and i + 1 < n and str_slice(src, i + 1, i + 2) == "/" { out = out + "*/"; i = i + 2; go = false; }
                else { out = out + d; i = i + 1; }
            }
        } else if _is_alpha(c) {
            let start = i;
            while i < n and _is_alnum(str_slice(src, i, i + 1)) { i = i + 1; }
            let id = str_slice(src, start, i);
            if depth == 0 and id == "export" {
                i = _to_semi(src, i);                       // drop `export ...;`
            } else if depth == 0 and (id == "let" or id == "const") {
                let k = _skip_spaces(src, i);
                let nm = _read_ident(src, k);
                let k2 = _skip_spaces(src, k + len(nm));
                let is_import = false;
                if k2 < n and str_slice(src, k2, k2 + 1) == "=" {
                    let k3 = _skip_spaces(src, k2 + 1);
                    if k3 + 7 <= n and str_slice(src, k3, k3 + 7) == "import(" { is_import = true; }
                }
                if is_import {
                    i = _to_semi(src, i);                   // drop `let v = import(...);`
                } else {
                    out = out + id;                         // keep declaration, record the name
                    if nm != "" { array_push(names, nm); }
                }
            } else if depth == 0 and id == "fn" {
                out = out + id;
                let nm = _read_ident(src, _skip_spaces(src, i));
                if nm != "" { array_push(names, nm); }
            } else if id == "import" {
                // A real `import` token that SURVIVED top-level let-import stripping
                // (the `let v = import(...)` branch consumes those wholesale) — so it
                // is a nested/non-top-level import. Detected here (not via a text
                // scan of the body) so import() inside comments/strings is ignored.
                nested = true;
                out = out + id;
            } else if map_has(varset, id) {
                let k = _skip_spaces(src, i);
                if k < n and str_slice(src, k, k + 1) == "." { i = k + 1; }   // var.member -> member
                else { bare = true; bare_name = id; out = out + id; }
            } else {
                out = out + id;
            }
        } else if c == "{" { depth = depth + 1; out = out + c; i = i + 1; }
        else if c == "}" { depth = depth - 1; out = out + c; i = i + 1; }
        else { out = out + c; i = i + 1; }
    }
    return map{ body: out, names: names, bare: bare, bare_name: bare_name, nested: nested };
}

// Strip + collision-check + rewrite ONE file. Mutates all_names (name -> tag).
fn _process_one(src, tag, all_names) {
    let varset = map{};
    for v in _find_import_bindings(src) {
        if v.var != nil and v.var != "" { varset[v.var] = true; }
    }
    let t = _transform(src, varset);
    if t.bare { return _err("import variable used without .member access (unsupported): " + t.bare_name); }
    // Nested/non-top-level imports are detected by _transform (comment/string-aware),
    // not by scanning the body text — so an import() mention in a comment is inert.
    if t.nested { return _err("nested/non-top-level import unsupported (in " + tag + ")"); }
    for nm in t.names {
        if nm != "" {
            if _blt.is_builtin_name(nm) { return _err("inlined name shadows a builtin: " + nm); }
            if map_has(all_names, nm) { return _err("name collision across modules: " + nm + " (in " + tag + " and " + all_names[nm] + ")"); }
            all_names[nm] = tag;
        }
    }
    return map{ ok: true, body: t.body };
}

// DFS-resolve a module and its transitive imports, deps-first (post-order).
fn _collect(path, resolve, reg, visiting, order, errbox) {
    if errbox.err != nil { return; }
    if map_has(reg, path) { return; }
    if (try visiting[path] catch false) == true { errbox.err = "import cycle at " + path; return; }
    let src = resolve(path);
    if src == nil { errbox.err = "cannot resolve import: " + path; return; }
    visiting[path] = true;
    for imp in _find_import_bindings(src) {
        _collect(imp.path, resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return; }
    }
    visiting[path] = false;
    reg[path] = src;
    array_push(order, path);
}

fn inline_source(main_src, resolve) {
    let errbox = map{ err: nil };
    let reg = map{}; let visiting = map{}; let order = [];
    for imp in _find_import_bindings(main_src) {
        _collect(imp.path, resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return _err(errbox.err); }
    }
    let all_names = map{};
    let pieces = [];
    for p in order {
        let pr = _process_one(reg[p], p, all_names);
        if not pr.ok { return pr; }
        array_push(pieces, pr.body);
    }
    let mr = _process_one(main_src, "<main>", all_names);
    if not mr.ok { return mr; }
    array_push(pieces, mr.body);
    return map{ ok: true, source: str_join(pieces, "\n"), modules: len(order) };
}

// _read_module(p) — read a module's source, resolving the `stdlib:X` alias (an import of the
// pblang stdlib) to a real file. The direct path is tried first; on a `stdlib:` prefix we try
// $PBLANG_STDLIB_DIR then the usual sibling-checkout relative layouts. nil if unresolvable.
fn _safe_stdlib_rest(rest) {
    if rest == "" or str_starts_with(rest, "/") or _contains(rest, "\\") or _contains(rest, ":") {
        return false;
    }
    let parts = str_split(rest, "/"); let i = 0;
    while i < len(parts) {
        if parts[i] == "" or parts[i] == "." or parts[i] == ".." { return false; }
        let j = 0;
        while j < len(parts[i]) {
            let code = strcharcodeat(parts[i], j);
            if code < 32 or code == 127 { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

fn _stdlib_candidates(rest) {
    if not _safe_stdlib_rest(rest) { return []; }
    let cands = [];
    let dir = try env_get("PBLANG_STDLIB_DIR") catch nil;
    if dir != nil and dir != "" { push(cands, str(dir) + "/" + rest); }
    // Common AAP layouts: caller in products/<product>, products/pblang itself,
    // or an older pl-dev checkout. All candidates are fixed roots plus a
    // traversal-free stdlib-relative suffix.
    push(cands, "../pblang/stdlib/" + rest);
    push(cands, "../../pblang/stdlib/" + rest);
    push(cands, "../../pl-dev/pblang/stdlib/" + rest);
    push(cands, "../../../pl-dev/pblang/stdlib/" + rest);
    return cands;
}

fn _read_module(p) {
    let direct = try bytes_to_str(fs_read_bytes(p)) catch nil;
    if direct != nil { return direct; }
    if len(p) > 7 and str_slice(p, 0, 7) == "stdlib:" {
        let rest = str_slice(p, 7, len(p));
        let cands = _stdlib_candidates(rest);
        let i = 0;
        while i < len(cands) {
            let s = try bytes_to_str(fs_read_bytes(cands[i])) catch nil;
            if s != nil { return s; }
            i = i + 1;
        }
    }
    // `stdlib/X` (slash form): a bare stdlib import that the project doesn't shadow
    // (direct read above already tried project-relative). Fall back to the pblang
    // stdlib dir, exactly like the interpreter roots bare `stdlib/...` there.
    if len(p) > 7 and str_slice(p, 0, 7) == "stdlib/" {
        let rest = str_slice(p, 7, len(p));
        let cands = _stdlib_candidates(rest);
        let i = 0;
        while i < len(cands) {
            let s = try bytes_to_str(fs_read_bytes(cands[i])) catch nil;
            if s != nil { return s; }
            i = i + 1;
        }
    }
    return nil;
}

fn inline_file(main_path) {
    let src = _read_module(main_path);
    if src == nil { return _err("cannot read main: " + str(main_path)); }
    fn resolve(p) { return _read_module(p); }
    return inline_source(src, resolve);
}

// ═══ Prefixed namespacing — handles modules with COLLIDING top-level names ═══════════════
// inline_source (above) uses a SHARED namespace and rejects two modules that define the same
// top-level name (e.g. pbos's syscall_filter.new and audit_log.new). This variant instead gives
// each module a unique prefix and renames its top-level names + every reference to them, so
// colliding names coexist and whole-project native compilation becomes possible.
//
// SAFETY (correctness over reach — a linker that silently miscompiles is worse than one that
// cleanly rejects). Renaming is applied ONLY to a bare identifier that equals one of THIS
// module's top-level names and is NOT a member access (`x.name`) and NOT a map key (`name:`).
// That is correct only when no LOCAL binding (a fn parameter or a nested `let`) shadows a
// top-level name — otherwise a bare reference could mean the local, not the top-level. Any such
// shadowing is DETECTED and the link REJECTED. Import-var members (`L.member`) are rewritten to
// the imported module's prefix.

fn _module_prefix(idx) { return "__pbi" + str(idx) + "_"; }

// Collect param names of the fn whose '(' is at `op`, into `locals`. Returns index past ')'.
fn _collect_params(src, op, locals) {
    let bytes = str_to_bytes(src);
    return _collect_params_bytes(bytes, op, locals);
}

fn _collect_params_bytes(bytes, op, locals) {
    let n = len(bytes); let k = op + 1; let depth = 1; let want_name = true;
    while k < n and depth > 0 {
        let c = bytes[k];
        if c == 40 { depth = depth + 1; k = k + 1; }
        else if c == 41 { depth = depth - 1; k = k + 1; }
        else if c == 44 and depth == 1 { want_name = true; k = k + 1; }
        else if _b_alpha(c) {
            let st = k;
            k = _b_ident_end(bytes, k);
            if want_name { locals[_b_text(bytes, st, k)] = true; want_name = false; }
            // any further idents in this param slot are a default-value expr — ignore.
        } else { k = k + 1; }
    }
    return k;
}

// Scan a module (string/comment-aware): top-level fn/let names, all local binding names
// (fn params + nested lets), and whether a nested (non-top-level) import appears.
fn _scan_defs_and_locals(src) {
    let bytes = str_to_bytes(src);
    let n = len(bytes); let i = 0; let depth = 0;
    let toplevel = []; let top_values = []; let locals = map{}; let nested = false;
    while i < n {
        let c = bytes[i];
        let c2 = 0 - 1;
        if i + 1 < n { c2 = bytes[i + 1]; }
        if c == 34 {
            i = i + 1; let go = true;
            while go and i < n {
                let d = bytes[i];
                if d == 92 and i + 1 < n { i = i + 2; }
                else { i = i + 1; if d == 34 { go = false; } }
            }
        } else if c == 47 and c2 == 47 {
            while i < n and bytes[i] != 10 { i = i + 1; }
        } else if c == 47 and c2 == 42 {
            i = i + 2; let go = true;
            while go and i < n {
                if bytes[i] == 42 and i + 1 < n and bytes[i + 1] == 47 {
                    i = i + 2; go = false;
                }
                else { i = i + 1; }
            }
        } else if _b_alpha(c) {
            let start = i;
            i = _b_ident_end(bytes, i);
            let id = _b_text(bytes, start, i);
            if id == "fn" {
                let k = _b_skip_spaces(bytes, i);
                let end = _b_ident_end(bytes, k);
                let nm = _b_text(bytes, k, end);
                if depth == 0 and nm != "" { array_push(toplevel, nm); }
                let pk = _b_skip_spaces(bytes, end);
                if pk < n and bytes[pk] == 40 {
                    i = _collect_params_bytes(bytes, pk, locals);
                }
            } else if id == "let" or id == "const" {
                let k = _b_skip_spaces(bytes, i);
                let end = _b_ident_end(bytes, k);
                let nm = _b_text(bytes, k, end);
                let k2 = _b_skip_spaces(bytes, end);
                let is_imp = false;
                if k2 < n and bytes[k2] == 61 {
                    let k3 = _b_skip_spaces(bytes, k2 + 1);
                    if _b_match(bytes, k3, _IMPORT_PREFIX_BYTES) { is_imp = true; }
                }
                if depth == 0 {
                    if nm != "" and not is_imp {
                        array_push(toplevel, nm);
                        array_push(top_values, nm);
                    }
                }
                else { if nm != "" { locals[nm] = true; } }
            } else if id == "import" and depth > 0 {
                nested = true;
            }
        } else if c == 123 { depth = depth + 1; i = i + 1; }
        else if c == 125 { depth = depth - 1; i = i + 1; }
        else { i = i + 1; }
    }
    return map{ toplevel: toplevel, top_values: top_values, locals: locals, nested: nested };
}

fn _in_scopes(scopes, id) {
    let i = len(scopes) - 1;
    while i >= 0 { if map_has(scopes[i], id) { return true; } i = i - 1; }
    return false;
}

// Rewrite ONE module's source with `prefix` applied to its top-level names, `L.member`
// rewritten via `var2pref` (import-var -> imported module prefix), import/export stripped.
// `tl` is the set (map) of this module's top-level names. SCOPE-AWARE: a bare top-level name is
// renamed only where it is NOT shadowed by a local (fn param or nested `let`) in scope — so a
// local `let head` inside a function that also has a top-level `fn head` is left untouched.
// Param lists are emitted verbatim (their names become locals for the body); a default-value
// that references a top-level const is left unprefixed and would fail to COMPILE loudly (not a
// silent miscompile) — acceptable, and absent in the target code.
fn _transform_prefixed(src, prefix, var2pref, tl) {
    // Appending to one immutable string for every token/character makes this
    // pass quadratic on compiler-sized modules. Accumulate slices and join once.
    let bytes = str_to_bytes(src);
    let out = []; let n = len(bytes); let i = 0; let depth = 0;
    let scopes = [ map{} ];
    let pending = map{}; let have_pending = false;
    let preserve_builtin_alias = "";
    while i < n {
        let c = bytes[i];
        let c2 = 0 - 1;
        if i + 1 < n { c2 = bytes[i + 1]; }
        if c == 34 {
            let chunk_start = i; i = i + 1; let go = true;
            while go and i < n {
                let d = bytes[i];
                if d == 92 and i + 1 < n { i = i + 2; }
                else { i = i + 1; if d == 34 { go = false; } }
            }
            array_push(out, _b_text(bytes, chunk_start, i));
        } else if c == 47 and c2 == 47 {
            let chunk_start = i;
            while i < n and bytes[i] != 10 { i = i + 1; }
            if i < n { i = i + 1; }
            array_push(out, _b_text(bytes, chunk_start, i));
        } else if c == 47 and c2 == 42 {
            let chunk_start = i; i = i + 2; let go = true;
            while go and i < n {
                if bytes[i] == 42 and i + 1 < n and bytes[i + 1] == 47 {
                    i = i + 2; go = false;
                }
                else { i = i + 1; }
            }
            array_push(out, _b_text(bytes, chunk_start, i));
        } else if _b_alpha(c) {
            let start = i;
            let member = false;
            let b = start - 1;
            while b >= 0 and _b_space(bytes[b]) { b = b - 1; }
            if b >= 0 and bytes[b] == 46 { member = true; }
            i = _b_ident_end(bytes, i);
            let id = _b_text(bytes, start, i);
            if depth == 0 and id == "export" and (not member) {
                i = _b_to_semi(bytes, i);
            } else if id == "fn" and (not member) {
                // named or anonymous fn: prefix a TOP-LEVEL name; collect params (verbatim) as locals.
                let k = _b_skip_spaces(bytes, i);
                if k < n and bytes[k] == 40 {
                    array_push(out, "fn"); i = k;                                  // anonymous
                } else {
                    let name_end = _b_ident_end(bytes, k);
                    let nm = _b_text(bytes, k, name_end);
                    if depth == 0 { array_push(out, "fn " + prefix + nm); }
                    else { array_push(out, "fn " + nm); scopes[len(scopes) - 1][nm] = true; }
                    i = name_end;
                }
                let pk = _b_skip_spaces(bytes, i);
                if pk < n and bytes[pk] == 40 {
                    array_push(out, _b_text(bytes, i, pk));                   // spaces before '('
                    pending = map{};
                    let ep = _collect_params_bytes(bytes, pk, pending);
                    have_pending = true;
                    array_push(out, _b_text(bytes, pk, ep));                  // emit param list verbatim
                    i = ep;
                }
            } else if (id == "let" or id == "const") and (not member) {
                let k = _b_skip_spaces(bytes, i);
                let name_end = _b_ident_end(bytes, k);
                let nm = _b_text(bytes, k, name_end);
                let k2 = _b_skip_spaces(bytes, name_end);
                let is_imp = false;
                if k2 < n and bytes[k2] == 61 {
                    let k3 = _b_skip_spaces(bytes, k2 + 1);
                    if _b_match(bytes, k3, _IMPORT_PREFIX_BYTES) { is_imp = true; }
                }
                if depth == 0 {
                    if is_imp { i = _b_to_semi(bytes, i); }
                    else {
                        // `let cwd = cwd` exports a host builtin under a module
                        // member. Prefix the binding, but never turn its RHS
                        // into a self-reference (`let __pbi_cwd = __pbi_cwd`).
                        let eq = _b_skip_spaces(bytes, name_end);
                        if _blt.is_builtin_name(nm) and eq < n and bytes[eq] == 61 {
                            let rhs = _b_skip_spaces(bytes, eq + 1);
                            let rhs_end = _b_ident_end(bytes, rhs);
                            if _b_text(bytes, rhs, rhs_end) == nm { preserve_builtin_alias = nm; }
                        }
                        array_push(out, id + " " + prefix + nm); i = name_end;
                    }
                } else {
                    // local let: name stays as-is and shadows any top-level with that name.
                    if nm != "" { scopes[len(scopes) - 1][nm] = true; }
                    array_push(out, id + " " + nm); i = name_end;
                }
            } else if preserve_builtin_alias != "" and id == preserve_builtin_alias {
                array_push(out, id); preserve_builtin_alias = "";
            } else if (not member) and map_has(var2pref, id) and (not _in_scopes(scopes, id)) {
                let k = _b_skip_spaces(bytes, i);
                if k < n and bytes[k] == 46 {
                    let mk = _b_skip_spaces(bytes, k + 1);
                    let member_end = _b_ident_end(bytes, mk);
                    let mnm = _b_text(bytes, mk, member_end);
                    array_push(out, var2pref[id] + mnm); i = member_end;
                } else {
                    array_push(out, "\x00BARE\x00");
                }
            } else if (not member) and map_has(tl, id) and (not _in_scopes(scopes, id)) {
                let k = _b_skip_spaces(bytes, i);
                if k < n and bytes[k] == 58 { array_push(out, id); }   // map key
                else { array_push(out, prefix + id); }
            } else {
                array_push(out, id);
            }
        } else if c == 123 {
            depth = depth + 1; array_push(out, "{"); i = i + 1;
            let sc = map{};
            if have_pending {
                let pk = map_keys(pending); let pj = 0;
                while pj < len(pk) { sc[pk[pj]] = true; pj = pj + 1; }
                have_pending = false;
            }
            array_push(scopes, sc);
        } else if c == 125 {
            depth = depth - 1; array_push(out, "}"); i = i + 1;
            if len(scopes) > 1 { pop(scopes); }
        } else {
            // Copy punctuation and whitespace as one slice. Only identifiers,
            // braces, quotes and comments can affect renaming or scope state.
            let chunk_start = i; i = i + 1; let scanning = true;
            while scanning and i < n {
                let d = bytes[i];
                if d == 34 or d == 123 or d == 125 or d == 47 or _b_alpha(d) {
                    scanning = false;
                }
                else { i = i + 1; }
            }
            array_push(out, _b_text(bytes, chunk_start, i));
        }
    }
    return str_join(out, "");
}

// _prep_module(path→prefix): build var2pref for a module from its import bindings.
fn _var2pref(src, path2pref) {
    let m = map{};
    for v in _find_import_bindings(src) {
        if v.var != nil and v.var != "" {
            let pf = try path2pref[v.path] catch nil;
            if pf != nil { m[v.var] = pf; }
        }
    }
    return m;
}

// inline_source_prefixed(main_src, resolve) — like inline_source but with per-module prefixing,
// so modules with colliding top-level names link cleanly. Same { ok, source, modules } contract.
fn _inline_prefixed_collected(main_src, reg, order) {
    // assign a prefix per module path (dep order)
    let path2pref = map{};
    let idx = 0;
    while idx < len(order) { path2pref[order[idx]] = _module_prefix(idx); idx = idx + 1; }

    let pieces = [];
    let mi = 0;
    while mi < len(order) {
        let p = order[mi];
        let src = reg[p];
        let prefix = path2pref[p];
        let sc = _scan_defs_and_locals(src);
        if sc.nested { return _err("nested/non-top-level import unsupported (in " + p + ")"); }
        // build the top-level set + shadow / builtin checks
        let tl = map{};
        for nm in sc.toplevel {
            // A top-level def shadows the builtin of the same name for the WHOLE module (pblang
            // hoists top-level fns/lets), so every in-module bare reference to `nm` means the local
            // def — prefix it like any other top-level name. `_transform_prefixed` renames only
            // in-module references (via `tl`), leaving other modules' builtin uses untouched; the
            // fn DEFINITION is prefixed unconditionally. Modules that truly need the builtin use its
            // canonical name (e.g. `array_push`, not a redefined `push`). Previously this whole
            // module was rejected as "unsafe to prefix"; the prefixing is in fact correct, and this
            // is what lets the self-hosting compiler modules (tokenizer/parser/...) link natively.
            tl[nm] = true;
        }
        let body = _transform_prefixed(src, prefix, _var2pref(src, path2pref), tl);
        if _contains(body, "\x00BARE\x00") { return _err("import variable used without .member access (unsupported, in " + p + ")"); }
        array_push(pieces, body);
        mi = mi + 1;
    }
    // main: keep its own top-level names unprefixed (root), but rewrite import-var members.
    let msc = _scan_defs_and_locals(main_src);
    if msc.nested { return _err("nested/non-top-level import unsupported (in <main>)"); }
    let mtl = map{};   // empty: main names are not prefixed
    let mbody = _transform_prefixed(main_src, "", _var2pref(main_src, path2pref), mtl);
    if _contains(mbody, "\x00BARE\x00") { return _err("import variable used without .member access (unsupported, in <main>)"); }
    array_push(pieces, mbody);
    return map{ ok: true, source: str_join(pieces, "\n"), modules: len(order), module_order: order };
}

fn inline_source_prefixed(main_src, resolve) {
    let errbox = map{ err: nil };
    let reg = map{}; let visiting = map{}; let order = [];
    for imp in _find_import_bindings(main_src) {
        _collect(imp.path, resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return _err(errbox.err); }
    }
    return _inline_prefixed_collected(main_src, reg, order);
}

fn inline_file_prefixed(main_path) {
    let src = _read_module(main_path);
    if src == nil { return _err("cannot read main: " + str(main_path)); }
    fn resolve(p) { return _read_module(p); }
    return inline_source_prefixed(src, resolve);
}

// Recompute a prior file graph's content identity without running the expensive
// rename/link pass. Any edit to main or to a previously imported module changes
// the fingerprint; an added/removed import necessarily changes one of those
// source hashes and forces graph rediscovery on the next full link.
fn file_graph_fingerprint(main_path, module_order) {
    if not is_array(module_order) or len(module_order) > 4096 {
        return _err("invalid cached module order");
    }
    let main_src = _read_module(main_path);
    if main_src == nil { return _err("cannot read main: " + str(main_path)); }
    let parts = ["pblang.source.graph.v1", str(main_path), sha256(main_src)];
    let i = 0;
    while i < len(module_order) {
        let path = module_order[i];
        if not is_string(path) or path == "" { return _err("invalid cached module path"); }
        let src = _read_module(path);
        if src == nil { return _err("cannot resolve cached import: " + path); }
        array_push(parts, path); array_push(parts, sha256(src));
        i = i + 1;
    }
    return map{ ok: true, fingerprint: sha256(str_join(parts, "\n")),
        modules: len(module_order), module_order: module_order };
}

// ═══ Bounded product linker ═══════════════════════════════════════════════════
// The compatibility APIs above accept a resolver closure and retain their old
// behavior. Product code uses link_modules(), whose complete dependency graph is
// supplied as immutable in-memory text. Paths are canonical virtual paths, so no
// module can escape a project root or trigger filesystem/network access.

fn _link_option(options, key, fallback) {
    if options != nil and is_map(options) and map_has(options, key) { return options[key]; }
    return fallback;
}

fn _link_limit(options, key, fallback, hard_max) {
    let value = _link_option(options, key, fallback);
    if not is_number(value) or value < 1 or value != num_floor(value) or value > hard_max {
        throw "source linker: " + key + " must be a positive integer <= " + str(hard_max);
    }
    return value;
}

fn link_limits(options = nil) {
    if options != nil and not is_map(options) { throw "source linker: options must be a map"; }
    return map{
        max_modules: _link_limit(options, "max_modules", 256, 4096),
        max_module_depth: _link_limit(options, "max_module_depth", 64, 256),
        max_module_source_bytes: _link_limit(options, "max_module_source_bytes", 1048576, 16777216),
        max_total_source_bytes: _link_limit(options, "max_total_source_bytes", 8388608, 67108864),
        max_linked_source_bytes: _link_limit(options, "max_linked_source_bytes", 16777216, 134217728),
        max_path_bytes: _link_limit(options, "max_path_bytes", 1024, 4096)
    };
}

fn _virtual_dir(path) {
    let slash = _last_index_of(path, "/");
    if slash < 0 { return ""; }
    return str_slice(path, 0, slash);
}

// Resolve raw relative to importer while preserving the stdlib: virtual scheme.
// Absolute paths, backslashes, foreign schemes, controls, and root traversal are
// rejected. `a/../b.sapp` is canonicalized to `b.sapp`.
fn _canonical_module_path(raw, importer) {
    if not is_string(raw) or len(raw) == 0 or len(raw) > 4096 { return nil; }
    let i = 0;
    while i < len(raw) {
        let code = strcharcodeat(raw, i);
        if code < 32 or code == 127 { return nil; }
        i = i + 1;
    }
    if str_starts_with(raw, "/") or _contains(raw, "\\") { return nil; }

    let scheme = ""; let rel = raw; let parent = importer;
    if str_starts_with(raw, "stdlib:") {
        scheme = "stdlib:"; rel = str_slice(raw, 7, len(raw)); parent = "";
    } elif str_starts_with(raw, "stdlib/") {
        // Slash-form stdlib imports are rooted aliases too, not paths relative
        // to a module already located under stdlib/.
        scheme = "stdlib:"; rel = str_slice(raw, 7, len(raw)); parent = "";
    } elif str_starts_with(importer, "stdlib:") {
        scheme = "stdlib:"; parent = str_slice(importer, 7, len(importer));
    } elif _contains(raw, ":") {
        return nil;
    }
    let combined = rel;
    // PBLang bare imports are project-rooted. Only explicit ./ and ../ forms
    // resolve relative to the importing module.
    let base = if str_starts_with(raw, "./")
        or str_starts_with(raw, "../") { _virtual_dir(parent) } else { "" };
    if base != "" { combined = base + "/" + rel; }
    let parts = str_split(combined, "/");
    let clean = [];
    i = 0;
    while i < len(parts) {
        let part = parts[i];
        if part == "" or part == "." { /* normalize */ }
        elif part == ".." {
            if len(clean) == 0 { return nil; }
            array_pop(clean);
        } else {
            if part == "." or part == ".." or _contains(part, ":") { return nil; }
            array_push(clean, part);
        }
        i = i + 1;
    }
    if len(clean) == 0 { return nil; }
    return scheme + str_join(clean, "/");
}

fn _canonical_modules(modules, limits) {
    if not is_map(modules) { return _err("modules must be a map of virtual path -> source text"); }
    let out = map{};
    let keys = map_keys(modules);
    if len(keys) > limits.max_modules { return _err("supplied module count limit exceeded"); }
    let supplied_bytes = 0;
    let i = 0;
    while i < len(keys) {
        let path = _canonical_module_path(keys[i], "");
        if path == nil or len(path) > limits.max_path_bytes { return _err("invalid module path: " + str(keys[i])); }
        if map_has(out, path) { return _err("duplicate canonical module path: " + path); }
        if not is_string(modules[keys[i]]) { return _err("module source must be text: " + path); }
        if len(modules[keys[i]]) > limits.max_module_source_bytes { return _err("module source limit exceeded: " + path); }
        supplied_bytes = supplied_bytes + len(modules[keys[i]]);
        if supplied_bytes > limits.max_total_source_bytes { return _err("supplied module source limit exceeded"); }
        out[path] = modules[keys[i]];
        i = i + 1;
    }
    return map{ ok: true, modules: out, supplied_bytes: supplied_bytes };
}

fn _collect_bounded(raw_path, importer, modules, limits, state, depth) {
    if state.err != nil { return; }
    if depth > limits.max_module_depth { state.err = "module depth limit exceeded"; return; }
    let path = _canonical_module_path(raw_path, importer);
    if path == nil or len(path) > limits.max_path_bytes { state.err = "invalid or escaping import path: " + str(raw_path); return; }
    if map_has(state.reg, path) { return; }
    if try state.visiting[path] catch false { state.err = "import cycle at " + path; return; }
    if not map_has(state.discovered, path) {
        state.discovered[path] = true;
        state.module_count = state.module_count + 1;
        if state.module_count > limits.max_modules { state.err = "module count limit exceeded"; return; }
    }
    let src = try modules[path] catch nil;
    if src == nil { state.err = "cannot resolve import: " + path; return; }
    if len(src) > limits.max_module_source_bytes { state.err = "module source limit exceeded: " + path; return; }
    if state.total_bytes + len(src) > limits.max_total_source_bytes { state.err = "total module source limit exceeded"; return; }
    state.total_bytes = state.total_bytes + len(src);
    state.visiting[path] = true;
    for imp in _find_import_bindings(src) {
        _collect_bounded(imp.path, path, modules, limits, state, depth + 1);
        if state.err != nil { return; }
    }
    state.visiting[path] = false;
    state.reg[path] = src;
    state.module_bytes[path] = len(src);
    array_push(state.order, path);
}

fn _var2pref_canonical(src, importer, path2pref) {
    let out = map{};
    for binding in _find_import_bindings(src) {
        if binding.var != nil and binding.var != "" {
            let path = _canonical_module_path(binding.path, importer);
            let prefix = try path2pref[path] catch nil;
            if prefix != nil { out[binding.var] = prefix; }
        }
    }
    return out;
}

fn _reserved_toplevel(scan) {
    let i = 0;
    while i < len(scan.toplevel) {
        if str_starts_with(scan.toplevel[i], "__pbi") { return scan.toplevel[i]; }
        i = i + 1;
    }
    return nil;
}

// link_modules(main_source, modules, options) -> flattened, namespaced source.
// `modules` is an in-memory project snapshot; linking performs no I/O.
fn link_modules(main_source, modules, options = nil) {
    if not is_string(main_source) { return _err("main source must be text"); }
    let limits = link_limits(options);
    if len(main_source) > limits.max_module_source_bytes { return _err("main source limit exceeded"); }
    let prepared = _canonical_modules(modules, limits);
    if not prepared.ok { return prepared; }
    if len(main_source) + prepared.supplied_bytes > limits.max_total_source_bytes {
        return _err("total project source limit exceeded");
    }
    let entry_path = _canonical_module_path(_link_option(options, "entry_path", "main.sapp"), "");
    if entry_path == nil or len(entry_path) > limits.max_path_bytes { return _err("invalid entry_path"); }

    let state = map{ err: nil, reg: map{}, visiting: map{}, discovered: map{}, order: [],
        module_bytes: map{}, module_count: 0, total_bytes: len(main_source) };
    for imp in _find_import_bindings(main_source) {
        _collect_bounded(imp.path, entry_path, prepared.modules, limits, state, 1);
        if state.err != nil { return _err(state.err); }
    }

    let path2pref = map{};
    let i = 0;
    while i < len(state.order) { path2pref[state.order[i]] = _module_prefix(i); i = i + 1; }
    let pieces = []; let module_value_definitions = map{};
    let linked_bytes = 0;
    i = 0;
    while i < len(state.order) {
        let path = state.order[i]; let src = state.reg[path];
        let scan = _scan_defs_and_locals(src);
        if scan.nested { return _err("nested/non-top-level import unsupported (in " + path + ")"); }
        let reserved = _reserved_toplevel(scan);
        if reserved != nil { return _err("module uses reserved linker namespace: " + reserved); }
        if len(scan.top_values) > 0 { module_value_definitions[path] = scan.top_values; }
        let top = map{};
        for name in scan.toplevel { top[name] = true; }
        let body = _transform_prefixed(src, path2pref[path], _var2pref_canonical(src, path, path2pref), top);
        if _contains(body, "\x00BARE\x00") { return _err("import variable used without .member access (in " + path + ")"); }
        linked_bytes = linked_bytes + len(body) + 1;
        if linked_bytes > limits.max_linked_source_bytes { return _err("linked source limit exceeded"); }
        array_push(pieces, body);
        i = i + 1;
    }

    let main_scan = _scan_defs_and_locals(main_source);
    if main_scan.nested { return _err("nested/non-top-level import unsupported (in <main>)"); }
    let main_reserved = _reserved_toplevel(main_scan);
    if main_reserved != nil { return _err("main uses reserved linker namespace: " + main_reserved); }
    let main_body = _transform_prefixed(main_source, "", _var2pref_canonical(main_source, entry_path, path2pref), map{});
    if _contains(main_body, "\x00BARE\x00") { return _err("import variable used without .member access (in <main>)"); }
    linked_bytes = linked_bytes + len(main_body);
    if linked_bytes > limits.max_linked_source_bytes { return _err("linked source limit exceeded"); }
    array_push(pieces, main_body);
    return map{ ok: true, source: str_join(pieces, "\n"), modules: state.module_count,
        module_order: state.order, module_bytes: state.module_bytes,
        module_value_definitions: module_value_definitions,
        input_bytes: state.total_bytes, supplied_bytes: prepared.supplied_bytes,
        output_bytes: linked_bytes, entry_path: entry_path,
        namespace: "prefixed", limits: limits };
}

export inline_source, inline_file, inline_source_prefixed, inline_file_prefixed;
export file_graph_fingerprint, link_limits, link_modules;
