// stdlib/source_inliner.sapp — a SOURCE-level linker for pblang.
//
// Inlines a multi-module program's import()ed modules into ONE self-contained
// pblang SOURCE string with no remaining import()/export statements, so the
// result can be fed to the C transpiler -> a true native binary for multi-file
// projects. (selfhost_bundle does the same at the BYTECODE level; this is needed
// because the C transpiler consumes source, not chunks.)
//
// Strategy = SHARED namespace, mirroring the bytecode bundler: each module's
// top-level definitions are concatenated (dependencies first), every
// `m.member` reference becomes the bare `member`, and the link is REJECTED
// (ok:false) for anything that could alias or break:
//   - a top-level name defined by two modules (or main),
//   - a module name shadowing a builtin,
//   - an unresolvable import, an import cycle,
//   - an import variable used bare (not as `var.member`),
//   - a non-top-level (nested) import.
//
//   inline_source(main_src, resolve) -> { ok, source, modules } | { ok:false, reason }
//   inline_file(main_path)           -> reads main + deps from disk
//
// resolve(path) returns the module source string, or nil if it can't be found.
//
// The transform is a single string/comment-aware scanner that tracks brace depth,
// so import/export statements are removed at the STATEMENT level (robust whether
// or not statements share a line) and `var.member` is rewritten outside of string
// literals and comments.

let _blt = import("stdlib/compiler/builtins_list.sapp");

let _ALPHA = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
let _DIGIT = "0123456789";

fn _is_alpha(c) { return len(c) == 1 and str_index_of(_ALPHA, c) >= 0; }
fn _is_alnum(c) { return len(c) == 1 and (str_index_of(_ALPHA, c) >= 0 or str_index_of(_DIGIT, c) >= 0); }
fn _is_space(c) { return c == " " or c == "\t"; }

fn _err(reason) { return map{ ok: false, reason: reason }; }
fn _contains(s, sub) { return str_index_of(s, sub) >= 0; }

fn _last_index_of(s, sub) {
    let n = len(s); let m = len(sub); let i = 0; let last = 0 - 1;
    while i + m <= n { if str_slice(s, i, i + m) == sub { last = i; } i = i + 1; }
    return last;
}

// The identifier `let <ident> = import(...)` binds, found by backtracking from the
// `import(` offset to the nearest preceding `let `.
fn _var_before(src, idx) {
    let before = str_slice(src, 0, idx);
    let p = _last_index_of(before, "let ");
    if p < 0 { return nil; }
    let nn = len(before);
    let j = p + 4;
    while j < nn and str_slice(before, j, j + 1) == " " { j = j + 1; }
    let st = j;
    while j < nn and _is_alnum(str_slice(before, j, j + 1)) { j = j + 1; }
    return str_slice(before, st, j);
}

// Every REAL `import("PATH")` call site -> {var, path}, in source order. The scan
// SKIPS string literals and // and /* */ comments, so an import() written inside a
// comment or string (common in doc comments / examples) is NOT mistaken for a real
// import (which previously made the inliner try to resolve it and falsely reject,
// or pull in an unrelated module). Mirrors the comment/string handling in
// _transform.
fn _find_import_bindings(src) {
    let out = [];
    let marker = "import(\"";
    let n = len(src); let i = 0;
    while i < n {
        let c = str_slice(src, i, i + 1);
        let c2 = ""; if i + 1 < n { c2 = str_slice(src, i + 1, i + 2); }
        if c == "\"" {
            // skip a string literal (honoring backslash escapes)
            i = i + 1;
            let go = true;
            while go and i < n {
                let d = str_slice(src, i, i + 1);
                if d == "\\" and i + 1 < n { i = i + 2; }
                else { i = i + 1; if d == "\"" { go = false; } }
            }
        } else if c == "/" and c2 == "/" {
            while i < n and str_slice(src, i, i + 1) != "\n" { i = i + 1; }
        } else if c == "/" and c2 == "*" {
            i = i + 2;
            let go = true;
            while go and i < n {
                if str_slice(src, i, i + 1) == "*" and i + 1 < n and str_slice(src, i + 1, i + 2) == "/" { i = i + 2; go = false; }
                else { i = i + 1; }
            }
        } else if i + len(marker) <= n and str_slice(src, i, i + len(marker)) == marker {
            let j = i + len(marker); let start = j;
            while j < n and str_slice(src, j, j + 1) != "\"" { j = j + 1; }
            let path = str_slice(src, start, j);
            array_push(out, map{ var: _var_before(src, i), path: path });
            i = j + 1;
        } else { i = i + 1; }
    }
    return out;
}

fn _skip_spaces(src, k) {
    let n = len(src);
    while k < n and _is_space(str_slice(src, k, k + 1)) { k = k + 1; }
    return k;
}
fn _read_ident(src, k) {
    let n = len(src); let st = k;
    while k < n and _is_alnum(str_slice(src, k, k + 1)) { k = k + 1; }
    return str_slice(src, st, k);
}
fn _to_semi(src, i) {
    let n = len(src);
    while i < n and str_slice(src, i, i + 1) != ";" { i = i + 1; }
    if i < n { i = i + 1; }
    return i;
}

// Single-pass transform: strip top-level import/export statements, rewrite
// var.member -> member, collect top-level fn/let names. Returns
// { body, names, bare, bare_name }.
fn _transform(src, varset) {
    let out = ""; let n = len(src); let i = 0; let depth = 0;
    let names = []; let bare = false; let bare_name = ""; let nested = false;
    while i < n {
        let c = str_slice(src, i, i + 1);
        let c2 = ""; if i + 1 < n { c2 = str_slice(src, i + 1, i + 2); }
        if c == "\"" {
            out = out + c; i = i + 1; let go = true;
            while go and i < n {
                let d = str_slice(src, i, i + 1);
                if d == "\\" and i + 1 < n { out = out + d + str_slice(src, i + 1, i + 2); i = i + 2; }
                else { out = out + d; i = i + 1; if d == "\"" { go = false; } }
            }
        } else if c == "/" and c2 == "/" {
            let go = true;
            while go and i < n { let d = str_slice(src, i, i + 1); out = out + d; i = i + 1; if d == "\n" { go = false; } }
        } else if c == "/" and c2 == "*" {
            out = out + c + c2; i = i + 2; let go = true;
            while go and i < n {
                let d = str_slice(src, i, i + 1);
                if d == "*" and i + 1 < n and str_slice(src, i + 1, i + 2) == "/" { out = out + "*/"; i = i + 2; go = false; }
                else { out = out + d; i = i + 1; }
            }
        } else if _is_alpha(c) {
            let start = i;
            while i < n and _is_alnum(str_slice(src, i, i + 1)) { i = i + 1; }
            let id = str_slice(src, start, i);
            if depth == 0 and id == "export" {
                i = _to_semi(src, i);                       // drop `export ...;`
            } else if depth == 0 and id == "let" {
                let k = _skip_spaces(src, i);
                let nm = _read_ident(src, k);
                let k2 = _skip_spaces(src, k + len(nm));
                let is_import = false;
                if k2 < n and str_slice(src, k2, k2 + 1) == "=" {
                    let k3 = _skip_spaces(src, k2 + 1);
                    if k3 + 7 <= n and str_slice(src, k3, k3 + 7) == "import(" { is_import = true; }
                }
                if is_import {
                    i = _to_semi(src, i);                   // drop `let v = import(...);`
                } else {
                    out = out + id;                         // keep `let`, record the name
                    if nm != "" { array_push(names, nm); }
                }
            } else if depth == 0 and id == "fn" {
                out = out + id;
                let nm = _read_ident(src, _skip_spaces(src, i));
                if nm != "" { array_push(names, nm); }
            } else if id == "import" {
                // A real `import` token that SURVIVED top-level let-import stripping
                // (the `let v = import(...)` branch consumes those wholesale) — so it
                // is a nested/non-top-level import. Detected here (not via a text
                // scan of the body) so import() inside comments/strings is ignored.
                nested = true;
                out = out + id;
            } else if map_has(varset, id) {
                let k = _skip_spaces(src, i);
                if k < n and str_slice(src, k, k + 1) == "." { i = k + 1; }   // var.member -> member
                else { bare = true; bare_name = id; out = out + id; }
            } else {
                out = out + id;
            }
        } else if c == "{" { depth = depth + 1; out = out + c; i = i + 1; }
        else if c == "}" { depth = depth - 1; out = out + c; i = i + 1; }
        else { out = out + c; i = i + 1; }
    }
    return map{ body: out, names: names, bare: bare, bare_name: bare_name, nested: nested };
}

// Strip + collision-check + rewrite ONE file. Mutates all_names (name -> tag).
fn _process_one(src, tag, all_names) {
    let varset = map{};
    for v in _find_import_bindings(src) {
        if v.var != nil and v.var != "" { varset[v.var] = true; }
    }
    let t = _transform(src, varset);
    if t.bare { return _err("import variable used without .member access (unsupported): " + t.bare_name); }
    // Nested/non-top-level imports are detected by _transform (comment/string-aware),
    // not by scanning the body text — so an import() mention in a comment is inert.
    if t.nested { return _err("nested/non-top-level import unsupported (in " + tag + ")"); }
    for nm in t.names {
        if nm != "" {
            if _blt.is_builtin_name(nm) { return _err("inlined name shadows a builtin: " + nm); }
            if map_has(all_names, nm) { return _err("name collision across modules: " + nm + " (in " + tag + " and " + all_names[nm] + ")"); }
            all_names[nm] = tag;
        }
    }
    return map{ ok: true, body: t.body };
}

// DFS-resolve a module and its transitive imports, deps-first (post-order).
fn _collect(path, resolve, reg, visiting, order, errbox) {
    if errbox.err != nil { return; }
    if map_has(reg, path) { return; }
    if (try visiting[path] catch false) == true { errbox.err = "import cycle at " + path; return; }
    let src = resolve(path);
    if src == nil { errbox.err = "cannot resolve import: " + path; return; }
    visiting[path] = true;
    for imp in _find_import_bindings(src) {
        _collect(imp.path, resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return; }
    }
    visiting[path] = false;
    reg[path] = src;
    array_push(order, path);
}

fn inline_source(main_src, resolve) {
    let errbox = map{ err: nil };
    let reg = map{}; let visiting = map{}; let order = [];
    for imp in _find_import_bindings(main_src) {
        _collect(imp.path, resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return _err(errbox.err); }
    }
    let all_names = map{};
    let pieces = [];
    for p in order {
        let pr = _process_one(reg[p], p, all_names);
        if not pr.ok { return pr; }
        array_push(pieces, pr.body);
    }
    let mr = _process_one(main_src, "<main>", all_names);
    if not mr.ok { return mr; }
    array_push(pieces, mr.body);
    return map{ ok: true, source: str_join(pieces, "\n"), modules: len(order) };
}

fn inline_file(main_path) {
    let src = try bytes_to_str(fs_read_bytes(main_path)) catch nil;
    if src == nil { return _err("cannot read main: " + str(main_path)); }
    fn resolve(p) { return try bytes_to_str(fs_read_bytes(p)) catch nil; }
    return inline_source(src, resolve);
}

export inline_source, inline_file;
