// stdlib/format.sapp — Pretty printing: tables, colored output, progress bars, padding

// ESC character for ANSI codes
let ESC = strfromcharcode(27);

// ANSI color codes
let COLORS = map{
    reset:   ESC + "[0m",
    bold:    ESC + "[1m",
    dim:     ESC + "[2m",
    red:     ESC + "[31m",
    green:   ESC + "[32m",
    yellow:  ESC + "[33m",
    blue:    ESC + "[34m",
    magenta: ESC + "[35m",
    cyan:    ESC + "[36m",
    white:   ESC + "[37m",
    bright_red:     ESC + "[91m",
    bright_green:   ESC + "[92m",
    bright_yellow:  ESC + "[93m",
    bright_blue:    ESC + "[94m",
    bright_white:   ESC + "[97m"
};

// color(text, color_name) → ANSI colored string
fn color(text, color_name) {
    let code = COLORS[color_name] ?? "";
    let reset = COLORS["reset"];
    if code == "" { return text; }
    return code + text + reset;
}

// bold(text) → bold text
fn bold(text) { return COLORS["bold"] + text + COLORS["reset"]; }

// table(rows) → formatted ASCII table
// rows: array of arrays; first row is treated as header if header=true
fn table(rows) {
    if len(rows) == 0 { return ""; }
    let ncols = len(rows[0]);
    let col_widths = [];
    let i = 0;
    while i < ncols { array_push(col_widths, 0); i = i + 1; }

    // Calculate column widths
    let r = 0;
    while r < len(rows) {
        let c = 0;
        while c < len(rows[r]) and c < ncols {
            let cell_len = len(str(rows[r][c]));
            if cell_len > col_widths[c] { col_widths[c] = cell_len; }
            c = c + 1;
        }
        r = r + 1;
    }

    let result = "";
    let sep = "+";
    let ci = 0;
    while ci < ncols {
        sep = sep + str_repeat("-", col_widths[ci] + 2) + "+";
        ci = ci + 1;
    }
    sep = sep + "\n";

    result = result + sep;
    let ri = 0;
    while ri < len(rows) {
        let line = "|";
        let cj = 0;
        while cj < ncols {
            let cell = str(rows[ri][cj] ?? "");
            let padded = " " + str_pad_right(cell, col_widths[cj], " ") + " ";
            line = line + padded + "|";
            cj = cj + 1;
        }
        result = result + line + "\n";
        if ri == 0 { result = result + sep; }
        ri = ri + 1;
    }
    result = result + sep;
    return result;
}

// progress(current, total) → ASCII progress bar
fn progress(current, total) {
    let width = 40;
    let pct = 0;
    if total > 0 { pct = clamp(current / total * 100, 0, 100); }
    let filled = num_floor(pct / 100 * width);
    let bar = "[" + str_repeat("#", filled) + str_repeat(".", width - filled) + "]";
    return bar + " " + str(num_floor(pct)) + "%";
}

// center(text, width, fill) → center text in field of given width
fn center(text, width, fill) {
    let t = str(text);
    let n = len(t);
    if n >= width { return t; }
    let pad = width - n;
    let left = num_floor(pad / 2);
    let right = pad - left;
    return str_repeat(fill, left) + t + str_repeat(fill, right);
}

// truncate(text, max_len, suffix) → truncate with suffix if too long
fn truncate(text, max_len, suffix) {
    let t = str(text);
    let sfx = suffix ?? "...";
    if len(t) <= max_len { return t; }
    return str_slice(t, 0, max_len - len(sfx)) + sfx;
}

// number_format(n, decimals, thousands_sep, decimal_sep) → formatted number string
fn number_format(n, decimals, thousands_sep, decimal_sep) {
    let t_sep = thousands_sep ?? ",";
    let d_sep = decimal_sep ?? ".";
    let factor = 10 ** decimals;
    let rounded = num_floor(n * factor + 0.5) / factor;
    let int_part = num_floor(num_abs(rounded));
    let sign = "";
    if n < 0 { sign = "-"; }

    // Format integer part with thousands separators
    let int_str = str(int_part);
    let formatted_int = "";
    let pos = 0;
    let int_len = len(int_str);
    while pos < int_len {
        if pos > 0 and num_mod(int_len - pos, 3) == 0 {
            formatted_int = formatted_int + t_sep;
        }
        formatted_int = formatted_int + str_slice(int_str, pos, pos + 1);
        pos = pos + 1;
    }

    if decimals <= 0 { return sign + formatted_int; }

    // Decimal part
    let frac = num_abs(rounded) - int_part;
    let frac_factor = 10 ** decimals;
    let frac_int = num_floor(frac * frac_factor + 0.5);
    let frac_str = str_pad_left(str(frac_int), decimals, "0");

    return sign + formatted_int + d_sep + frac_str;
}

// bytes_human(n) → human-readable bytes (e.g. "1.5 MB")
fn bytes_human(n) {
    if n < 1024 { return str(n) + " B"; }
    if n < 1024 * 1024 { return number_format(n / 1024, 1, ",", ".") + " KB"; }
    if n < 1024 * 1024 * 1024 { return number_format(n / 1024 / 1024, 1, ",", ".") + " MB"; }
    return number_format(n / 1024 / 1024 / 1024, 2, ",", ".") + " GB";
}

// list(items, bullet) → formatted bullet list
fn list(items, bullet) {
    let b = bullet ?? "•";
    let result = "";
    let i = 0;
    while i < len(items) {
        result = result + b + " " + str(items[i]) + "\n";
        i = i + 1;
    }
    return result;
}

export color, bold, table, progress, center, truncate, number_format, bytes_human,
       list, COLORS;
