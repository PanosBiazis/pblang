// stdlib/format.sapp — Pretty printing: tables, colored output, progress bars, padding

// ESC character for ANSI codes
let ESC = strfromcharcode(27);

// ANSI color codes
let COLORS = map{
    reset:   ESC + "[0m",
    bold:    ESC + "[1m",
    dim:     ESC + "[2m",
    red:     ESC + "[31m",
    green:   ESC + "[32m",
    yellow:  ESC + "[33m",
    blue:    ESC + "[34m",
    magenta: ESC + "[35m",
    cyan:    ESC + "[36m",
    white:   ESC + "[37m",
    bright_red:     ESC + "[91m",
    bright_green:   ESC + "[92m",
    bright_yellow:  ESC + "[93m",
    bright_blue:    ESC + "[94m",
    bright_white:   ESC + "[97m"
};

// color(text, color_name) → ANSI colored string. An unknown name returns the
// text unchanged (indexing a missing map key throws, so ?? can't be relied on).
fn color(text, color_name) {
    if not map_has(COLORS, color_name) { return text; }
    return COLORS[color_name] + text + COLORS["reset"];
}

// rgb(text, r, g, b) → 24-bit truecolor ANSI string.
fn rgb(text, r, g, b) {
    return ESC + "[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m" + text + COLORS["reset"];
}

// strip_ansi(s) → s with all ANSI escape sequences (ESC[...m) removed.
fn strip_ansi(s) {
    let out = [];
    let i = 0;
    let n = len(s);
    let start = 0;
    while i < n {
        if strcharcodeat(s, i) == 27 {
            if i > start { array_push(out, str_slice(s, start, i)); }
            i = i + 1;
            while i < n and str_slice(s, i, i + 1) != "m" { i = i + 1; }
            i = i + 1;  // skip the 'm'
            start = i;
        } else {
            i = i + 1;
        }
    }
    if start < n { array_push(out, str_slice(s, start, n)); }
    return str_join(out, "");
}

// duration_human(seconds) → "1h 2m 3s" (omits leading zero units).
fn duration_human(seconds) {
    let s = num_floor(seconds);
    if s < 0 { s = 0; }
    let h = num_floor(s / 3600);
    let m = num_floor((s - h * 3600) / 60);
    let sec = s - h * 3600 - m * 60;
    let out = "";
    if h > 0 { out = out + str(h) + "h "; }
    if h > 0 or m > 0 { out = out + str(m) + "m "; }
    return out + str(sec) + "s";
}

// ordinal(n) → "1st", "2nd", "3rd", "11th", "22nd", ...
fn ordinal(n) {
    let i = num_floor(num_abs(n));
    let mod100 = num_mod(i, 100);
    let suffix = "th";
    if mod100 < 11 or mod100 > 13 {
        let mod10 = num_mod(i, 10);
        if mod10 == 1 { suffix = "st"; }
        else if mod10 == 2 { suffix = "nd"; }
        else if mod10 == 3 { suffix = "rd"; }
    }
    return str(i) + suffix;
}

// wrap(text, width) → word-wrapped text (greedy; words longer than width are kept).
fn wrap(text, width) {
    let words = str_split(text, " ");
    let lines = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = words[i];
        if cur == "" { cur = w; }
        else if len(cur) + 1 + len(w) <= width { cur = cur + " " + w; }
        else { array_push(lines, cur); cur = w; }
        i = i + 1;
    }
    if cur != "" { array_push(lines, cur); }
    return str_join(lines, "\n");
}

// bold(text) → bold text
fn bold(text) { return COLORS["bold"] + text + COLORS["reset"]; }

// table(rows) → formatted ASCII table
// rows: array of arrays; first row is treated as header if header=true
fn table(rows) {
    if len(rows) == 0 { return ""; }
    let ncols = len(rows[0]);
    let col_widths = [];
    let i = 0;
    while i < ncols { array_push(col_widths, 0); i = i + 1; }

    // Calculate column widths
    let r = 0;
    while r < len(rows) {
        let c = 0;
        while c < len(rows[r]) and c < ncols {
            let cell_len = len(str(rows[r][c]));
            if cell_len > col_widths[c] { col_widths[c] = cell_len; }
            c = c + 1;
        }
        r = r + 1;
    }

    let result = [];
    let sep = "+";
    let ci = 0;
    while ci < ncols {
        sep = sep + str_repeat("-", col_widths[ci] + 2) + "+";
        ci = ci + 1;
    }
    sep = sep + "\n";

    // Small tables are faster with direct concatenation; large tables use a
    // chunked outer result to avoid repeatedly copying all prior rows.
    if len(rows) * ncols <= 4096 {
        let small = sep;
        let sr = 0;
        while sr < len(rows) {
            let small_line = "|";
            let sc = 0;
            while sc < ncols {
                let cell = str(rows[sr][sc] ?? "");
                small_line = small_line + " " + str_pad_right(cell, col_widths[sc], " ") + " |";
                sc = sc + 1;
            }
            small = small + small_line + "\n";
            if sr == 0 { small = small + sep; }
            sr = sr + 1;
        }
        return small + sep;
    }

    array_push(result, sep);
    let ri = 0;
    while ri < len(rows) {
        let line = "|";
        let cj = 0;
        while cj < ncols {
            let cell = str(rows[ri][cj] ?? "");
            let padded = " " + str_pad_right(cell, col_widths[cj], " ") + " ";
            line = line + padded + "|";
            cj = cj + 1;
        }
        array_push(result, line + "\n");
        if ri == 0 { array_push(result, sep); }
        ri = ri + 1;
    }
    array_push(result, sep);
    return str_join(result, "");
}

// table_from_maps(rows, columns) — render records in one call. When columns
// are omitted, the first row defines their deterministic display order.
fn table_from_maps(rows, columns = nil) {
    if len(rows) == 0 {
        if columns == nil { return ""; }
        return table([columns]);
    }
    if columns == nil { columns = map_keys(rows[0]); }
    let matrix = [columns];
    let i = 0;
    while i < len(rows) {
        let line = [];
        let c = 0;
        while c < len(columns) {
            array_push(line, try rows[i][columns[c]] catch "");
            c = c + 1;
        }
        array_push(matrix, line);
        i = i + 1;
    }
    return table(matrix);
}

// progress(current, total) → ASCII progress bar
fn progress(current, total) {
    let width = 40;
    let pct = 0;
    if total > 0 { pct = clamp(current / total * 100, 0, 100); }
    let filled = num_floor(pct / 100 * width);
    let bar = "[" + str_repeat("#", filled) + str_repeat(".", width - filled) + "]";
    return bar + " " + str(num_floor(pct)) + "%";
}

// center(text, width, fill) → center text in field of given width
fn center(text, width, fill) {
    let t = str(text);
    let n = len(t);
    if n >= width { return t; }
    let pad = width - n;
    let left = num_floor(pad / 2);
    let right = pad - left;
    return str_repeat(fill, left) + t + str_repeat(fill, right);
}

// truncate(text, max_len, suffix) → truncate with suffix if too long
fn truncate(text, max_len, suffix) {
    let t = str(text);
    let sfx = suffix ?? "...";
    if len(t) <= max_len { return t; }
    return str_slice(t, 0, max_len - len(sfx)) + sfx;
}

// number_format(n, decimals, thousands_sep, decimal_sep) → formatted number string
fn number_format(n, decimals, thousands_sep, decimal_sep) {
    let t_sep = thousands_sep ?? ",";
    let d_sep = decimal_sep ?? ".";
    let factor = 10 ** decimals;
    let rounded = num_floor(n * factor + 0.5) / factor;
    let int_part = num_floor(num_abs(rounded));
    let sign = "";
    if n < 0 { sign = "-"; }

    // Format integer part with thousands separators
    let int_str = str(int_part);
    let formatted_int = "";
    let pos = 0;
    let int_len = len(int_str);
    while pos < int_len {
        if pos > 0 and num_mod(int_len - pos, 3) == 0 {
            formatted_int = formatted_int + t_sep;
        }
        formatted_int = formatted_int + str_slice(int_str, pos, pos + 1);
        pos = pos + 1;
    }

    if decimals <= 0 { return sign + formatted_int; }

    // Decimal part
    let frac = num_abs(rounded) - int_part;
    let frac_factor = 10 ** decimals;
    let frac_int = num_floor(frac * frac_factor + 0.5);
    let frac_str = str_pad_left(str(frac_int), decimals, "0");

    return sign + formatted_int + d_sep + frac_str;
}

// bytes_human(n) → human-readable bytes (e.g. "1.5 MB")
fn bytes_human(n) {
    if n < 1024 { return str(n) + " B"; }
    if n < 1024 * 1024 { return number_format(n / 1024, 1, ",", ".") + " KB"; }
    if n < 1024 * 1024 * 1024 { return number_format(n / 1024 / 1024, 1, ",", ".") + " MB"; }
    return number_format(n / 1024 / 1024 / 1024, 2, ",", ".") + " GB";
}

// list(items, bullet) → formatted bullet list
fn list(items, bullet) {
    let b = bullet ?? "•";
    let result = [];
    let i = 0;
    while i < len(items) {
        array_push(result, b + " " + str(items[i]) + "\n");
        i = i + 1;
    }
    return str_join(result, "");
}

export color, rgb, bold, strip_ansi, table, table_from_maps, progress, center, truncate,
       number_format, bytes_human, duration_human, ordinal, wrap, list, COLORS;
