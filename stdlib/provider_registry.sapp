// stdlib/provider_registry.sapp — AI provider registry (A4-beta)

let _registry = map{};

fn register(name, provider) {
    _registry[name] = provider;
}

fn get(name) {
    return try _registry[name] catch nil;
}

fn list() {
    return map_keys(_registry);
}

fn call_provider(name, method, args) {
    let p = get(name);
    if p == nil { return nil; }
    let fn_ref = try p[method] catch nil;
    if fn_ref == nil { return nil; }
    return fn_ref(args);
}

export register, get, list, call_provider;
