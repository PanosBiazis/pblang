// stdlib/provider_registry.sapp — AI provider registry (A4-beta)

let http = import("stdlib:http.sapp");

let _registry = [];
let _rr_cursor = 0;

// register(name, url, token) — add an HTTP AI provider
fn register(name, url, token) {
    let i = 0;
    while i < len(_registry) {
        if _registry[i].name == name {
            _registry[i] = map{ name: name, url: url, token: token };
            return true;
        }
        i = i + 1;
    }
    array_push(_registry, map{ name: name, url: url, token: token });
    return true;
}

fn get(name) {
    let i = 0;
    while i < len(_registry) {
        if _registry[i].name == name { return _registry[i]; }
        i = i + 1;
    }
    return nil;
}

fn list() {
    let names = [];
    let i = 0;
    while i < len(_registry) {
        array_push(names, _registry[i].name);
        i = i + 1;
    }
    return names;
}

fn unregister(name) {
    let i = 0;
    let next = [];
    let removed = false;
    while i < len(_registry) {
        if removed == false and _registry[i].name == name {
            removed = true;
        } else {
            array_push(next, _registry[i]);
        }
        i = i + 1;
    }
    _registry = next;
    if len(_registry) == 0 {
        _rr_cursor = 0;
    } else if _rr_cursor >= len(_registry) {
        _rr_cursor = 0;
    }
    return removed;
}

fn clear() {
    _registry = [];
    _rr_cursor = 0;
}

fn call_provider(name, message, model) {
    let p = get(name);
    if p == nil { return map{ error: "provider not found: " + name }; }
    let body = json_stringify(map{ model: model, messages: [map{ role: "user", content: message }] });
    // http.post_auth returns string "error: ..." on failure (no throw)
    let resp = try http.post_auth(p.url, body, p.token) catch nil;
    if resp == nil { return map{ error: "no response" }; }
    if type(resp) == "string" {
        if str_starts_with(resp, "error") { return map{ error: resp }; }
    }
    return resp;
}

// call_best: call first registered provider, or return error if none registered
fn call_best(message, model) {
    if len(_registry) == 0 {
        return map{ error: "no providers registered" };
    }
    return call_provider(_registry[0].name, message, model);
}

// call_with_fallback: try all providers, return aggregate error if all fail
fn call_with_fallback(message, model) {
    if len(_registry) == 0 {
        return map{ error: "no providers registered" };
    }
    let i = 0;
    let errors = [];
    while i < len(_registry) {
        let result = call_provider(_registry[i].name, message, model);
        if result != nil {
            let has_error = try map_has(result, "error") catch false;
            if has_error == false { return result; }
            array_push(errors, _registry[i].name + ": " + str(result.error));
        }
        i = i + 1;
    }
    return map{ error: "all providers failed", details: errors };
}

// next_provider_name: deterministic round-robin provider selection without network call.
fn next_provider_name() {
    if len(_registry) == 0 {
        return nil;
    }
    if _rr_cursor >= len(_registry) {
        _rr_cursor = 0;
    }
    let name = _registry[_rr_cursor].name;
    _rr_cursor = (_rr_cursor + 1) % len(_registry);
    return name;
}

// call_round_robin: rotates provider selection for load distribution.
fn call_round_robin(message, model) {
    let name = next_provider_name();
    if name == nil {
        return map{ error: "no providers registered" };
    }
    return call_provider(name, message, model);
}

// has(name) — is a provider registered under this name?
fn has(name) { return get(name) != nil; }

// count() — number of registered providers.
fn count() { return len(_registry); }

// providers() — provider records WITHOUT tokens (safe to log/display).
fn providers() {
    let out = [];
    let i = 0;
    while i < len(_registry) {
        array_push(out, map{ name: _registry[i].name, url: _registry[i].url });
        i = i + 1;
    }
    return out;
}

export register, get, list, unregister, clear, call_provider, call_best, call_with_fallback, next_provider_name, call_round_robin;
export has, count, providers;
