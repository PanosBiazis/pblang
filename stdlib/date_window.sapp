// Aggregate caller-provided dates; no clock, reminders, record content or I/O.
let Date=import("stdlib:civil_date.sapp");
fn summarize(dates,start,days=7) {
    let first=Date.ordinal(start);
    if type(days)!="number" or days<1 or days>366 or days!=num_floor(days) or first+days-1>3652058
        or type(dates)!="array" or len(dates)>10000 {throw "invalid date window";}
    let rows=[];for i in range(0,days) {array_push(rows,map{date:Date.from_ordinal(first+i),weekday:num_mod(first+i,7),count:0});}
    let cache=map{};let before=0;let after=0;let unspecified=0;let invalid=0;let inside=0;
    for text in dates {
        if type(text)!="string" {throw "date entries must be strings";}
        if text=="" {unspecified=unspecified+1;continue;}
        if len(text)!=10 {invalid=invalid+1;continue;}
        if not map_has(cache,text) {cache[text]=try Date.ordinal(text) catch nil;}
        let day=cache[text];
        if day==nil {invalid=invalid+1;}elif day<first {before=before+1;}elif day>=first+days {after=after+1;}
        else {let index=day-first;rows[index].count=rows[index].count+1;inside=inside+1;}
    }
    return map{format:"pblang.date-window.v1",start:start,days:days,total:len(dates),before:before,inside:inside,after:after,unspecified:unspecified,invalid_date:invalid,rows:rows,contains_record_text:false,safe_to_log:false};
}
export summarize;
