// stdlib/llm_binary.sapp -- binary token substrate for pblang-native LLMs.
//
// Tokens are normally handled as integer IDs. This module exposes the lower level
// bit representation so higher tiers can add bit features, packed data paths,
// binary embeddings, and future optimized kernels without changing tokenizer APIs.

fn bit_width(vocab_size) {
    let width = 0;
    let p = 1;
    while p < vocab_size {
        width = width + 1;
        p = p * 2;
    }
    if width < 1 { return 1; }
    return width;
}

fn _pow2(n) {
    let p = 1;
    let i = 0;
    while i < n {
        p = p * 2;
        i = i + 1;
    }
    return p;
}

fn id_to_bits(id, width) {
    let out = [];
    let i = 0;
    while i < width {
        let shift = width - i - 1;
        let p = _pow2(shift);
        push(out, num_floor(id / p) % 2);
        i = i + 1;
    }
    return out;
}

fn bits_to_id(bits) {
    let id = 0;
    let i = 0;
    while i < len(bits) {
        id = id * 2 + bits[i];
        i = i + 1;
    }
    return id;
}

fn ids_to_bits(ids, width) {
    let out = [];
    let i = 0;
    while i < len(ids) {
        push(out, id_to_bits(ids[i], width));
        i = i + 1;
    }
    return out;
}

fn ids_to_bitstream(ids, width) {
    let out = [];
    let i = 0;
    while i < len(ids) {
        let b = id_to_bits(ids[i], width);
        let j = 0;
        while j < len(b) {
            push(out, b[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn bitstream_to_ids(bits, width) {
    let out = [];
    let i = 0;
    while i + width <= len(bits) {
        let b = [];
        let j = 0;
        while j < width {
            push(b, bits[i + j]);
            j = j + 1;
        }
        push(out, bits_to_id(b));
        i = i + width;
    }
    return out;
}

fn hamming_weight(bits) {
    let n = 0;
    let i = 0;
    while i < len(bits) {
        if bits[i] != 0 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn hamming_distance(a, b) {
    let n = len(a);
    if len(b) < n { n = len(b); }
    let d = 0;
    let i = 0;
    while i < n {
        if a[i] != b[i] { d = d + 1; }
        i = i + 1;
    }
    return d + num_abs(len(a) - len(b));
}

fn transition_count(bits) {
    let n = 0;
    let i = 1;
    while i < len(bits) {
        if bits[i] != bits[i - 1] { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn token_binary_features(ids, vocab_size) {
    let width = bit_width(vocab_size);
    let stream = ids_to_bitstream(ids, width);
    let denom = len(stream);
    let density = 0.0;
    if denom > 0 { density = hamming_weight(stream) / denom; }
    return map{
        format: "pblang.llm.binary_features.v1",
        ids: len(ids),
        vocab_size: vocab_size,
        bit_width: width,
        bits: len(stream),
        ones: hamming_weight(stream),
        density: density,
        transitions: transition_count(stream)
    };
}

fn binary_lm_examples(examples, vocab_size, limit = 32) {
    let width = bit_width(vocab_size);
    let out = [];
    let i = 0;
    while i < len(examples) and i < limit {
        let ex = examples[i];
        push(out, map{
            format: "pblang.llm.binary_lm_example.v1",
            x: ex.x,
            y: ex.y,
            x_bits: ids_to_bits(ex.x, width),
            y_bits: id_to_bits(ex.y, width),
            features: token_binary_features(ex.x, vocab_size)
        });
        i = i + 1;
    }
    return out;
}

fn text_to_byte_bits(text) {
    let out = [];
    let i = 0;
    while i < len(text) {
        let code = strcharcodeat(text, i);
        let b = id_to_bits(code % 256, 8);
        let j = 0;
        while j < 8 {
            push(out, b[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn byte_bits_to_text(bits) {
    let s = "";
    let ids = bitstream_to_ids(bits, 8);
    let i = 0;
    while i < len(ids) {
        s = s + strfromcharcode(ids[i]);
        i = i + 1;
    }
    return s;
}

fn tokenizer_summary(tok) {
    let vocab_size = len(tok.id_to_token);
    let width = bit_width(vocab_size);
    return map{
        format: "pblang.llm.binary_token_summary.v1",
        token_format: tok.format,
        token_kind: tok.kind,
        vocab_size: vocab_size,
        bit_width: width,
        max_ids: _pow2(width),
        capacity_slack: _pow2(width) - vocab_size
    };
}

export bit_width, id_to_bits, bits_to_id, ids_to_bits, ids_to_bitstream, bitstream_to_ids;
export hamming_weight, hamming_distance, transition_count, token_binary_features;
export binary_lm_examples, text_to_byte_bits, byte_bits_to_text, tokenizer_summary;
