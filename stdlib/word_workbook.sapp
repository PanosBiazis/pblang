// Complete vocabulary interchange, independent of screen and Sheet row limits.
let Profile=import("stdlib:word_profile.sapp");
let CSV=import("stdlib:csv.sapp");
let MAX_OUTPUT_BYTES=262144;
let FORMAT="pblang.word-workbook.v1";

fn report(doc) {
    let source=Profile.analyze(doc);let entries=[];
    for i in range(0,len(source.entries)) {
        let item=source.entries[i];let blocks=[];
        for b in item.blocks {array_push(blocks,b+1);}
        array_push(entries,map{rank:i+1,token:item.token,count:item.count,blocks:blocks});
    }
    return map{format:FORMAT,total:source.total,unique:source.unique,entries:entries};
}
fn encode(doc,kind="csv") {
    if type(kind)!="string" or (kind!="csv" and kind!="json") {throw "word workbook: use csv or json";}
    let workbook=report(doc);let text="";
    if kind=="json" {text=json_stringify(workbook);}
    else {
        let rows=[["Rank","Token (prefixed with apostrophe)","Count","Writer blocks (1-based)"]];
        for item in workbook.entries {
            let blocks=[];for b in item.blocks {array_push(blocks,str(b));}
            // Every token gets the same text marker, including pre-existing quotes.
            // CSV consumers may retain this marker; JSON preserves exact tokens.
            array_push(rows,[str(item.rank),"'"+item.token,str(item.count),str_join(blocks,", ")]);
        }
        text=CSV.stringify(rows);
    }
    if len(str_to_bytes(text))>MAX_OUTPUT_BYTES {throw "word workbook: output byte limit";}
    return text;
}
export FORMAT,MAX_OUTPUT_BYTES,report,encode;
