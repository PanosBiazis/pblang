// Pure single-channel sensor diagnostic. No device, training or action authority.
fn _number(value,low,high) {
 return type(value)=="number" and value==value and value>=low and value<=high;
}
fn _valid(request) {
 if type(request)!="map" or len(request)!=4 {return false;}
 for key in ["values","period_seconds","sigma","absolute_tolerance"] {
  if not map_has(request,key) {return false;}
 }
 if type(request.values)!="array" or len(request.values)<4 or len(request.values)>256 {return false;}
 if not _number(request.period_seconds,1,86400) or request.period_seconds!=num_floor(request.period_seconds) {return false;}
 if not _number(request.sigma,1,10) or not _number(request.absolute_tolerance,0.000001,1000000) {return false;}
 for value in request.values {if not _number(value,-1000000,1000000) {return false;}}
 return true;
}
fn contract() {
 return map{format:"pbai.sensor.contract.v1",profile:"uniform-linear-last-point.v1",
  min_samples:4,max_samples:256,max_abs_value:1000000,
  period_seconds_min:1,period_seconds_max:86400,period_seconds_integer:true,
  sigma_min:1,sigma_max:10,absolute_tolerance_min:0.000001,absolute_tolerance_max:1000000,
  required_fields:["values","period_seconds","sigma","absolute_tolerance"],
  implementation_kind:"deterministic-specialist",trained_model:false,
  uniform_sampling:"caller-declared-unverified",device_access:false,
  persistence:false,network:false,authorizes_action:false};
}
fn _reply(status,value,error) {
 return map{format:"pbai.sensor.result.v1",status:status,value:value,error:error,
  implementation_kind:"deterministic-specialist",trained_model:false,
  external_effects:false,authorizes_action:false};
}
fn analyze(request) {
 if not _valid(request) {return _reply("error",nil,"invalid_request");}
 let values=request.values;let n=len(values)-1;
 // Fit only the prefix; the last observation never influences its own baseline.
 let mean=0;for i n {mean=mean+values[i];}mean=mean/n;
 let center=(n-1)/2;let xx=0;let xy=0;
 for i n {let x=i-center;xx=xx+x*x;xy=xy+x*(values[i]-mean);}
 let slope=xy/xx;let squared=0;
 for i n {let residual=values[i]-(mean+slope*(i-center));squared=squared+residual*residual;}
 let residual_sd=num_sqrt(squared/(n-2));
 let expected=mean+slope*(n-center);let deviation=values[n]-expected;
 // Explicit additive engineering tolerance, not a calibrated confidence interval.
 let threshold=request.absolute_tolerance+request.sigma*residual_sd;
 let outlier=deviation>threshold or deviation< -threshold;
 let direction="within-threshold";
 if outlier {direction=if deviation>0 {"above"} else {"below"};}
 return _reply("result",map{profile:"uniform-linear-last-point.v1",baseline_samples:n,
  baseline_mean:mean,slope_per_second:slope/request.period_seconds,
  residual_sd:residual_sd,expected_last:expected,deviation:deviation,
  threshold:threshold,outlier:outlier,
  direction:direction,
  uniform_sampling:"caller-declared-unverified",confidence_calibrated:false},nil);
}
export contract,analyze;
