// Bounded numeric samples: complete trailing windows and piecewise linear sampling.
fn _number(value) {return type(value)=="number" and value>= -1000000000 and value<=1000000000;}
fn _values(values,limit) {
    if type(values)!="array" or len(values)<1 or len(values)>limit {throw "sample count limit";}
    for value in values {if not _number(value) {throw "sample must be finite and within range";}}
}
// Grow a nonoverlapping expansion using error-free FastTwoSum. Every term
// remains represented; rounding a small term away never discards its residual.
fn _add_part(parts,value,limit) {
    let write=0;let count=len(parts);
    for index in range(0,count) {
        let other=parts[index];
        if num_abs(value)<num_abs(other) {let swap=value;value=other;other=swap;}
        let high=value+other;let low=other-(high-value);
        if low!=0 {parts[write]=low;write=write+1;}
        value=high;
    }
    while len(parts)>write {array_pop(parts);}
    if value!=0 {array_push(parts,value);}
    // A merge cannot have more components than current input samples.
    if len(parts)>limit {throw "sample expansion resource limit";}
}
fn _merge(tree,node,limit) {
    let parts=[];
    for term in tree[node*2] {_add_part(parts,term,limit);}
    for term in tree[node*2+1] {_add_part(parts,term,limit);}
    tree[node]=parts;
}
fn moving_mean(values,window) {
    _values(values,4096);
    if type(window)!="number" or not (window>=1 and window<=len(values)) or window!=num_floor(window) {throw "invalid sample window";}
    let results=[];
    if window==1 {
        // Identity includes signed zero and subnormal samples, in detached storage.
        for index in range(0,len(values)) {array_push(results,values[index]);}
    } else {
        let size=1;while size<window {size=size*2;}
        let tree=[];let slot=0;
        while slot<size*2 {array_push(tree,[]);slot=slot+1;}
        for index in range(0,len(values)) {
            let leaf=size+(index%window);tree[leaf]=[values[index]];
            let node=num_floor(leaf/2);
            while node>=1 {_merge(tree,node,window);node=num_floor(node/2);}
            if index+1>=window {
                let total=0;for part in tree[1] {total=total+part;}
                array_push(results,total/window);
            }
        }
    }
    return map{format:"pblang.moving-mean.v1",values:results,first_source_index:window-1,window:window};
}
// Strictly increasing x. Endpoints accepted; extrapolation is always rejected.
fn interpolate(xs,ys,queries) {
    _values(xs,256);_values(ys,256);_values(queries,4096);
    if len(xs)!=len(ys) or len(xs)<2 {throw "interpolation requires paired points";}
    for i in range(1,len(xs)) {if xs[i]<=xs[i-1] {throw "sample positions must increase";}}
    let out=[];
    for query in queries {
        if query<xs[0] or query>xs[len(xs)-1] {throw "interpolation does not extrapolate";}
        let low=0;let high=len(xs)-1;
        while high-low>1 {let mid=num_floor((low+high)/2);if xs[mid]<=query {low=mid;}else {high=mid;}}
        let ratio=(query-xs[low])/(xs[high]-xs[low]);
        // Preserve known samples exactly, avoiding endpoint cancellation.
        let value=ys[low];
        if query==xs[high] {value=ys[high];}
        if query!=xs[low] and query!=xs[high] {value=ys[low]+ratio*(ys[high]-ys[low]);}
        array_push(out,value);
    }
    return out;
}
export moving_mean,interpolate;
