// Exact bounded decimal statistics. No trimming, rounding, formulas or I/O.
let Sheet=import("stdlib:sheet_document.sapp");
let Group=import("stdlib:table_group.sapp");
// Optional minus, 1..12 integer digits, optional dot and 1..6 fractional digits.
// Validate before constructing the existing arbitrary-precision decimal type.
fn parse_value(text) {
    if type(text)!="string" or len(text)<1 or len(text)>20 {throw "table stats: expected bounded decimal text";}
    let start=if str_slice(text,0,1)=="-" {1} else {0};
    let whole=0; let fraction=0; let dot=false;
    for i in range(start,len(text)) {
        let ch=str_slice(text,i,i+1);
        if ch=="." and not dot and whole>0 {dot=true;}
        elif str_index_of("0123456789",ch)>=0 {
            if dot {fraction=fraction+1;} else {whole=whole+1;}
        } else {throw "table stats: invalid decimal text";}
    }
    if whole<1 or whole>12 or fraction>6 or (dot and fraction<1) {throw "table stats: decimal digit limits exceeded";}
    return decimal(text);
}
fn summarize(doc,category,value,header=false) {
    let size=Sheet.validate(doc);
    if type(value)!="number" {throw "table stats: invalid value column";}
    if value<0 or value!=num_floor(value) {throw "table stats: invalid value column";}
    if value>=size.columns {throw "table stats: invalid value column";}
    let axis=Group.group_rows(doc,category,header);
    if len(axis.labels)>31 {throw "table stats: at most 31 output categories";}
    let cells=[["Group","Count","Sum","Min","Max"]];
    for g in range(0,len(axis.labels)) {
        let total=decimal("0");let minimum=nil;let maximum=nil;
        for row in axis.rows[g] {
            let n=parse_value(doc.cells[row][value]);total=total+n;
            if minimum==nil or n<minimum {minimum=n;}
            if maximum==nil or n>maximum {maximum=n;}
        }
        array_push(cells,[axis.labels[g],str(len(axis.rows[g])),str(total),str(minimum),str(maximum)]);
    }
    let result=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(result);return result;
}
export parse_value,summarize;
