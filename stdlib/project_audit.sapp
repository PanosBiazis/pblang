// stdlib/project_audit.sapp -- pure project gap/security marker audit.
//
// This module is intentionally text-in/text-out. It does not walk the
// filesystem by itself; callers pass bounded records from an already-approved
// source. It turns TODO/stub/security/perf/reliability markers into structured,
// prioritized findings that PBIDE, pbAI, pbOS, and MCP tools can share.

let SECSCAN = import("stdlib:secscan.sapp");

fn _lower(x) { return str_lower(str(x ?? "")); }

fn _contains_any(text, needles) {
    let t = _lower(text);
    let i = 0;
    while i < len(needles) {
        if str_contains(t, _lower(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _capability_escalation_marker(l) {
    if _contains_any(l, [
        "pblang_allow_all=1", "pblang_allow_all: \"1\"", "pblang_allow_all: '1'",
        "pblang_allow_exec=1", "pblang_allow_exec: \"1\"", "pblang_allow_exec: '1'",
        "pblang_allow_ffi=1", "pblang_allow_ffi: \"1\"", "pblang_allow_ffi: '1'",
        "allow_all: true", "allow_exec: true", "allow_ffi: true"
    ]) {
        return true;
    }
    return false;
}

fn _host_process_marker(l) {
    if _contains_any(l, [
        "bash -lc", "sh -c", "shell -c", "cmd /c", "powershell -command",
        "start-process", "proc_spawn_wait(\"bash\"", "proc_spawn_wait(\"sh\"",
        "proc_spawn_wait(\"cmd\"", "proc_spawn_wait(\"powershell\"",
        "proc_spawn(\"bash\"", "proc_spawn(\"sh\"", "proc_spawn(\"cmd\"",
        "proc_spawn(\"powershell\""
    ]) {
        return true;
    }
    return false;
}

fn _host_renderer_marker(l) {
    if _contains_any(l, [
        "external browser process", "host browser process", "system browser process",
        "host renderer", "external renderer", "browser subprocess", "open in firefox",
        "open in chrome", "firefox render", "chrome render"
    ]) {
        return true;
    }
    return false;
}

fn _external_disk_write_marker(l) {
    if not str_contains(l, "ventoy") { return false; }
    if _contains_any(l, [
        "write", "fs_write", "copy", " cp ", "output_path", "destination",
        "target", "mkfs", "format", "mount", "dd if=", "dd of="
    ]) {
        return true;
    }
    return false;
}

fn _line_kind(line) {
    let l = _lower(line);
    // Detector implementations must be able to name the patterns they detect.
    // These syntax-specific exclusions do not suppress real assignments or
    // real panic-prone calls.
    if str_contains(l, "needle:") and _contains_any(l, ["private key", "authorization:"]) {
        return nil;
    }
    if str_contains(l, "str_contains(") and str_contains(l, "begin")
        and str_contains(l, "private key") {
        return nil;
    }
    if _contains_any(l, ["_contains(", "str_contains("])
        and _contains_any(l, ["\"unwrap()\"", "\"panic!\"", "\".expect(\""]) {
        return nil;
    }
    if str_contains(l, "_contains(diff,")
        and _contains_any(l, ["\"not implemented\"", "\"todo\"", "\"placeholder\""]) {
        return nil;
    }
    if str_contains(l, "_contains(c,")
        and _contains_any(l, ["\"sudo ", "\"runas\"", "start-process -verb runas"]) {
        return nil;
    }
    if str_contains(l, "allow_all: true") and str_contains(l, "no allowlist") {
        return nil;
    }
    if str_contains(l, "safety.expect(") {
        return nil;
    }
    if str_contains(l, "partial or placeholder implementation work") {
        return nil;
    }
    if str_contains(l, "prevent unbounded") or str_contains(l, "prevents unbounded") {
        return nil;
    }
    if _contains_any(l, ["avoid an infinite loop", "avoid infinite loop", "avoids infinite loop",
        "avoid infinite loops", "cannot deadlock", "prevent private keys",
        "read-only idea sources", "no block fits (out of memory)",
        "would make `continue` skip", "tail that re-indents to the same line"]) {
        return nil;
    }
    if str_contains(l, "out = out +") and str_contains(l, "is an infinite loop")
        and str_contains(l, "found = found +") { return nil; }
    if str_contains(l, "`loop") and str_contains(l, "desugared")
        and str_contains(l, "infinite loop") { return nil; }
    if str_contains(l, "fputs(") and str_contains(l, "out of memory") { return nil; }
    if (str_starts_with(str_trim(l), "//") or str_starts_with(str_trim(l), "/*"))
        and _contains_any(l, ["like rust's `.expect", "scan a file", "hostile input patterns",
            "defensive security only", "inline text for leaked secrets"]) {
        return nil;
    }
    if str_contains(l, "env-var equivalents:") { return nil; }
    if str_contains(l, "invaliddata") and str_contains(l, "no private key") { return nil; }
    if str_contains(l, "cannot create unbounded") or str_contains(l, "cannot create an unbounded") {
        return nil;
    }
    if str_contains(l, "partial results") or str_contains(l, "partial result") {
        return nil;
    }
    if str_contains(l, "not yet evicted") {
        return nil;
    }
    if str_contains(l, "blocked by browser policy") {
        return nil;
    }
    if str_contains(l, "source_only_blockers") or str_contains(l, "blocker_count") or str_contains(l, "summary.blocker_count") {
        return nil;
    }
    if str_contains(l, "let blockers =") or str_contains(l, "blockers = blockers +") or str_contains(l, "if blockers >") {
        return nil;
    }
    if str_contains(l, "convert roadmap gaps into tested exit tasks") {
        return nil;
    }
    if str_contains(l, "if sev == \"blocker\"") {
        return nil;
    }
    if str_contains(l, "phase-2 bootability waits on all phase-0 blocker contracts") {
        return nil;
    }
    if str_contains(l, "add every low-level pblang blocker as a separate, testable contract") {
        return nil;
    }
    if str_contains(l, "roadmap/blocker findings do not make pbos unimplemented core fail") {
        return nil;
    }
    if str_contains(l, "pbos roadmap/core changes must reduce or hold audit risk") {
        return nil;
    }
    if str_contains(l, "previously slipped past") and str_contains(l, "denylist") {
        return nil;
    }
    if str_contains(l, "previously held") and str_contains(l, "rust-style pseudocode") {
        return nil;
    }
    if str_contains(l, "did not parse as pblang") and _contains_any(l, [".unwrap()", "panic!"]) {
        return nil;
    }
    if _capability_escalation_marker(l) or _host_process_marker(l) or _host_renderer_marker(l) or _external_disk_write_marker(l) {
        return "security";
    }
    if _contains_any(l, [
        "private key", "authorization:",
        "access-control-allow-origin: *", "cors *", "--allow-all",
        "hardcoded secret", "hardcoded token", "leaked secret", "leaked token"
    ]) {
        return "security";
    }
    if _contains_any(l, [
        "pblang-stub",
        "boot stub",
        "multiboot/uefi stub",
        "uefi stub",
        "generate_c_stub",
        "self-extracting bundle launcher",
        "stub launcher",
        "pe-ish stub"
    ]) {
        return nil;
    }
    if str_contains(l, "todo =") or str_contains(l, "todo=\"") {
        return nil;
    }
    if str_contains(l, "partialeq") {
        return nil;
    }
    if _contains_any(l, ["not implemented", "todo", "fixme", "stub", "catalog-only", "planned only", "partial", "future work", "not yet"]) {
        return "incomplete";
    }
    if str_contains(l, "placeholder") and not str_contains(l, "placeholder=") and not str_contains(l, "placeholder =") {
        return "incomplete";
    }
    if _contains_any(l, [
        "prefer explicit error handling over",
        "bounded/unbounded channels",
        "deadlock detection",
        "deadlock diagnostic",
        "deadlock diagnostics",
        "timeout-based prevention",
        "backpressure handling"
    ]) {
        return nil;
    }
    if _contains_any(l, ["panic!", ".unwrap()", ".expect(", "unreachable!", "todo!(", "silent catch nil", "swallow error", "nil deref", "divide by zero"]) {
        return "reliability";
    }
    if _contains_any(l, ["preventing hanging operations", "timeout enforcement", "maximum duration for operations", "timeout handling"]) {
        return nil;
    }
    if str_contains(l, "prevent infinite loop")
        or (str_contains(l, "clear error") and str_contains(l, "instead of hanging")) {
        return nil;
    }
    if _contains_any(l, ["oom risk", "oom-risk", "out of memory", "unbounded", "infinite loop", "can hang", "may hang", "will hang", "cpu hang", "deadlock", "n^2", "o(n^2)", "o(n!)", "factorial-time", "factorial time", "factorial complexity", "slow path", "too slow"]) {
        return "performance";
    }
    if _contains_any(l, ["aspirational", "blocked by", "blocker", "roadmap gap", "pblang gap", "pblang gaps"]) {
        return "roadmap";
    }
    return nil;
}

fn _severity(kind, line) {
    let l = _lower(line);
    if kind == "security" {
        if _contains_any(l, ["private key", "hardcoded secret", "hardcoded token", "leaked secret", "leaked token"]) { return "high"; }
        if _capability_escalation_marker(l) or _external_disk_write_marker(l) { return "high"; }
        if _host_process_marker(l) or _host_renderer_marker(l) { return "medium"; }
        if _contains_any(l, ["authorization:", "--allow-all", "access-control-allow-origin: *", "cors *"]) { return "low"; }
        return "medium";
    }
    if kind == "performance" {
        if _contains_any(l, ["oom risk", "oom-risk", "out of memory", "infinite loop", "o(n!)", "factorial-time", "factorial time", "factorial complexity", "can hang", "may hang", "will hang", "cpu hang", "deadlock"]) { return "high"; }
        return "medium";
    }
    if kind == "reliability" {
        if _contains_any(l, ["panic!", ".unwrap()", ".expect(", "divide by zero"]) { return "high"; }
        return "medium";
    }
    if kind == "incomplete" {
        if _contains_any(l, ["not implemented", "stub", "placeholder"]) { return "medium"; }
        return "low";
    }
    return "info";
}

fn _score(severity) {
    if severity == "critical" { return 5; }
    if severity == "high" { return 4; }
    if severity == "medium" { return 3; }
    if severity == "low" { return 2; }
    return 1;
}

fn _path_ext(path) {
    let p = _lower(path);
    let i = len(p) - 1;
    while i >= 0 {
        if str_slice(p, i, i + 1) == "." { return str_slice(p, i, len(p)); }
        if str_slice(p, i, i + 1) == "/" { return ""; }
        i = i - 1;
    }
    return "";
}

fn _path_role(path) {
    let p = _lower(path);
    let ext = _path_ext(path);
    if str_contains(p, "/test") or str_contains(p, "tests/") or str_contains(p, "_test.") or
       str_contains(p, "/bench") or str_contains(p, "benches/") or str_contains(p, "/demo") or
       str_contains(p, "demo/") or str_contains(p, "fixtures/") or str_contains(p, "/examples/") or
       str_contains(p, "examples/") {
        return "test";
    }
    if str_contains(p, "/docs/") or str_starts_with(p, "docs/") or str_contains(p, "prjanalysis") or
       str_contains(p, "comprehensive_improvements") or str_contains(p, "readme") or
       str_contains(p, "changelog") or ext == ".md" or ext == ".rst" or ext == ".adoc" or ext == ".txt" {
        return "docs";
    }
    if ext == ".toml" or ext == ".json" or ext == ".yaml" or ext == ".yml" {
        return "config";
    }
    if ext == ".sapp" or ext == ".sap" or ext == ".bpx" or ext == ".rs" or ext == ".py" or
       ext == ".js" or ext == ".ts" or ext == ".html" or ext == ".css" or ext == ".c" or
       ext == ".h" or ext == ".cpp" or ext == ".hpp" or ext == ".sh" or ext == ".ps1" or
       ext == ".bat" {
        return "source";
    }
    return "unknown";
}

fn finding(path, line_no, line, kind) {
    let sev = _severity(kind, line);
    let role = _path_role(path);
    return map{
        format: "pblang.project_audit.finding.v1",
        path: str(path ?? "[input]"),
        line: line_no,
        kind: kind,
        severity: sev,
        role: role,
        score: _score(sev),
        text: str_trim(str(line)),
        recommendation: recommendation_for_kind(kind)
    };
}

fn recommendation_for_kind(kind) {
    if kind == "security" { return "gate, redact, deny-by-default, and add a regression test"; }
    if kind == "performance" { return "bound work, batch/cache hot paths, and add a benchmark or timeout test"; }
    if kind == "reliability" { return "replace panic-prone paths with structured errors and add edge-case tests"; }
    if kind == "incomplete" { return "either implement the behavior or mark it as honest roadmap/catalog-only metadata"; }
    if kind == "roadmap" { return "keep current-vs-roadmap docs explicit and attach an exit test"; }
    return "review and classify";
}

fn security_policy_markers() {
    return [
        map{ marker: "PBLANG_ALLOW_ALL=1", severity: "high", reason: "environment capability escalation can bypass least-privilege child launch policy" },
        map{ marker: "PBLANG_ALLOW_EXEC=1", severity: "high", reason: "process capability escalation must be explicit and scoped" },
        map{ marker: "PBLANG_ALLOW_FFI=1", severity: "high", reason: "native FFI capability escalation must be explicit and scoped" },
        map{ marker: "bash -lc / sh -c / cmd /c / powershell -command", severity: "medium", reason: "shell-mediated process launch needs strict argument, timeout, and capability gates" },
        map{ marker: "external browser process / host renderer", severity: "medium", reason: "host renderer fallback crosses the PBIDE browser sandbox boundary" },
        map{ marker: "Ventoy write/copy/format target", severity: "high", reason: "external boot media must stay read-only unless explicitly scoped by the operator" },
        map{ marker: "Access-Control-Allow-Origin: *", severity: "low", reason: "wildcard local API CORS must be reviewed before enabling browser callers" },
        map{ marker: "--allow-all", severity: "low", reason: "broad examples are review items and child apps should prefer least privilege" }
    ];
}

fn _path_has(path, needles) {
    let p = _lower(path);
    let i = 0;
    while i < len(needles) {
        if str_contains(p, _lower(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _path_matches_any(path, patterns) {
    let i = 0;
    while patterns != nil and i < len(patterns) {
        if str_contains(_lower(path), _lower(patterns[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _test_fixture_line(path, line) {
    let p = _lower(path);
    let l = _lower(line);
    let test_path = str_contains(p, "/test") or str_contains(p, "tests/") or str_contains(p, "_test.") or
        str_contains(p, "fixture") or str_contains(p, "/bench") or str_contains(p, "benches/") or
        str_contains(p, "/demo") or str_contains(p, "demo/");
    if not test_path { return false; }
    if _contains_any(l, ["ghp_1234567890", "akiaiosfodnn7example", "sk-test", "panic!(\"bad\")", "panic!(\\\"bad\\\")", "todo placeholder", "todo: placeholder", "todo:", "blocker:", "placeholder syscall", "example secret", "private keys", "begin openssh private key", "begin rsa private key", "--allow-all", "pblang_allow_all=1", "pblang_allow_exec=1", "pblang_allow_ffi=1", "bash -lc", "proc_spawn_wait", "proc_spawn(", "ventoy"]) {
        return true;
    }
    if _contains_any(l, [".unwrap()", ".expect(", "tokenizer", "tokenize", "tokens", "not implemented for platform"]) {
        return true;
    }
    return false;
}

fn _resolved_documentation_line(path, line) {
    let p = _lower(path);
    let l = _lower(line);
    let docs = str_contains(p, "/docs/") or str_contains(p, "docs/") or str_contains(p, "changelog") or str_contains(p, "prjanalysis");
    if not docs { return false; }
    if _contains_any(l, [
        "**fixed**", "| **fixed** |", "status | current implementation",
        "removed hardcoded", "replaced with placeholder", "fixed ",
        "was replaced with", "were replaced with", "do not panic", "does not panic",
        "without panicking", "instead of panicking", "avoid unwrap", "don't .unwrap",
        "fuzzing finding", "is a fuzzing finding", "every script error is recoverable",
        "set `vmlimits` before exposing untrusted code", "no limits ="
    ]) {
        return true;
    }
    return false;
}

fn _detector_or_catalog_literal(path, line) {
    let p = _lower(path); let l = _lower(line);
    if str_ends_with(p, "project_audit.sapp") or str_ends_with(p, "security_analysis.sapp")
        or str_ends_with(p, "secscan.sapp") {
        if _contains_any(l, ["patterns:", "needle:", "_contains_any(", "str_contains(",
            "pblang_allow_", "allow_all: true", "allow_exec: true", "allow_ffi: true",
            "private key", "hardcoded secret", "leaked secrets", "hostile input",
            "ventoy", "ghp_", "xox", "infinite loop", "out of memory",
            ".expect(", ".unwrap()", "deadlock"]) {
            return true;
        }
    }
    if str_ends_with(p, "generated_catalog.sapp") and str_contains(l, "description:") {
        return true;
    }
    return false;
}

fn _defensive_security_literal(line) {
    let l = _lower(str_trim(line));
    if str_contains(l, "no private key found")
        or (str_contains(l, "host.err") and _contains_any(l, ["open key:", "read key:"])) {
        return true;
    }
    let comment = str_starts_with(l, "//") or str_starts_with(l, "#");
    if comment and str_contains(l, "allow_all: true")
        and _contains_any(l, ["trusted embedding", "trusted context", "least privilege", "secure default"]) {
        return true;
    }
    return false;
}

fn suppression_reason(path, line, kind, options = nil) {
    if options == nil { options = map{}; }
    let l = _lower(line);
    if (try options.allow_inline_suppressions catch true) {
        if _contains_any(l, ["project-audit:ignore", "pb-audit-ignore", "audit-ignore"]) {
            return "inline suppression marker";
        }
    }
    if _path_matches_any(path, try options.suppress_paths catch []) {
        return "path suppression pattern";
    }
    if _resolved_documentation_line(path, line) {
        return "resolved historical documentation";
    }
    if _detector_or_catalog_literal(path, line) {
        return "detector or generated catalog literal";
    }
    if kind == "security" and _defensive_security_literal(line) {
        return "defensive security policy or structured error literal";
    }
    if (try options.suppress_test_fixtures catch false) and _test_fixture_line(path, line) {
        return "test fixture suppression";
    }
    return nil;
}

fn _suppressed_row(path, line_no, line, kind, reason) {
    return map{
        format: "pblang.project_audit.suppressed.v1",
        path: str(path ?? "[input]"),
        line: line_no,
        kind: kind,
        reason: reason,
        text: str_trim(str(line))
    };
}

fn _secret_detector_literal_line(line) {
    let l = _lower(line);
    if not _contains_any(l, ["str_contains(", "str_starts_with(", "needle:", "patterns:"]) {
        return false;
    }
    return _contains_any(l, [
        "begin private key", "begin rsa private key", "begin openssh private key",
        "begin ec private key", "ghp_", "github_pat_", "xoxb-", "xoxp-",
        "xoxa-", "xoxr-", "xoxs-",
        "akia", "asia", "aiza", "eyj", "sk-"
    ]);
}

// Keep legacy nil defaults, but never turn malformed budgets into clean reports.
// Array/report consumers have no shared error field: rejection must propagate.
fn _require_finding_limit(value, fallback) {
    if value == nil { return fallback; }
    if type(value) != "number" or value != value or value - value != 0
        or value < 1 or value > 4096 or value != num_floor(value) {
        throw "project audit max_findings must be a finite integer in 1..4096";
    }
    return value;
}

// Side-effect-free preflight for aggregate callers. The fallback is fixed;
// successful admission is a scalar value, not a reusable execution capability.
fn require_finding_limit(value = nil) {
    return _require_finding_limit(value, 500);
}

// Pure admission for pbaudit's non-finding numeric options, not scan authority.
// Empty error means accepted. Names/mode are exact; diagnostics never echo values.
fn pbaudit_numeric_error(name, value, module_mode = false) {
    if type(name) != "string" or type(module_mode) != "bool" {
        return "invalid numeric option";
    }
    let minimum = 1; let maximum = 0;
    if name == "max-depth" { minimum = 0; maximum = 32; }
    else if name == "max-entries" { maximum = 50000; }
    else if name == "max-children" { maximum = 4096; }
    else if name == "max-files" { maximum = if module_mode { 100000 } else { 10000 }; }
    else if name == "max-file-bytes" {
        minimum = 1000; maximum = if module_mode { 16777216 } else { 1048576 };
    }
    else if name == "max-runtime-ms" { minimum = 10; maximum = 300000; }
    else if name == "backlog-limit" or name == "lines" {
        // Display loops also stop at bounded findings/module arrays, so large
        // exact requests do not allocate or loop up to this scalar ceiling.
        maximum = 9007199254740991;
    } else { return "invalid numeric option"; }
    if type(value) != "number" or value != value or value - value != 0
        or value < minimum or value > maximum or value != num_floor(value) {
        return name + " must be a finite integer in " + str(minimum) + ".." + str(maximum);
    }
    return "";
}

fn scan_text_report(path, text, max_findings = 200, options = nil) {
    max_findings = _require_finding_limit(max_findings, 200);
    let out = [];
    let suppressed = [];
    let lines = str_split(str(text ?? ""), "\n");
    let deadline_ms = try options.deadline_ms catch 0;
    let timed_out = false;
    let i = 0;
    let pending_test_region = 0;
    let in_test_region = false;
    while i < len(lines) and len(out) < max_findings {
        if deadline_ms > 0 and i % 128 == 0 and now_ms() >= deadline_ms {
            timed_out = true; break;
        }
        let line = lines[i];
        let lower_line = _lower(line);
        if str_contains(lower_line, "#[cfg(test)]") { pending_test_region = 8; }
        if pending_test_region > 0 and str_contains(lower_line, "mod tests") {
            in_test_region = true;
        }
        let kind = _line_kind(line);
        if kind != nil {
            let reason_value = suppression_reason(path, line, kind, options);
            let reason = if reason_value == nil { "" } else { str(reason_value) };
            if reason == "" and in_test_region and (try options.suppress_test_fixtures catch false) {
                reason = "test-only source region";
            }
            if reason != "" {
                array_push(suppressed, _suppressed_row(path, i + 1, line, kind, reason));
            } else {
                array_push(out, finding(path, i + 1, line, kind));
            }
        }
        if pending_test_region > 0 { pending_test_region = pending_test_region - 1; }
        i = i + 1;
    }
    let secret_line = 0;
    while not timed_out and secret_line < len(lines) and len(out) < max_findings {
        if deadline_ms > 0 and secret_line % 128 == 0 and now_ms() >= deadline_ms {
            timed_out = true; break;
        }
        let secrets = SECSCAN.detect_secrets(lines[secret_line]);
        let si = 0;
        while si < len(secrets) and len(out) < max_findings {
            let stype = str(try secrets[si].type catch "secret");
            let sline = "detected secret-like token: " + stype;
            let sreason = "";
            if _secret_detector_literal_line(lines[secret_line])
                or _detector_or_catalog_literal(path, lines[secret_line]) {
                sreason = "secret detector pattern literal";
            } else if (try options.suppress_test_fixtures catch false)
                and _path_has(path, ["/test", "tests/", "_test.", "fixture"]) {
                sreason = "test fixture secret detector suppression";
            }
            if sreason != "" {
                array_push(suppressed, _suppressed_row(path, secret_line + 1, sline, "security", sreason));
            } else {
                array_push(out, map{
                    format: "pblang.project_audit.finding.v1",
                    path: str(path ?? "[input]"),
                    line: secret_line + 1,
                    kind: "security",
                    severity: "high",
                    role: _path_role(path),
                    score: 4,
                    text: sline,
                    recommendation: recommendation_for_kind("security")
                });
            }
            si = si + 1;
        }
        secret_line = secret_line + 1;
    }
    return map{
        format: "pblang.project_audit.text_report.v1",
        path: str(path ?? "[input]"),
        findings: out,
        finding_count: len(out),
        suppressed: suppressed,
        suppressed_count: len(suppressed),
        timed_out: timed_out,
        truncated: timed_out or len(out) >= max_findings
    };
}

fn scan_text(path, text, max_findings = 200, options = nil) {
    let report = scan_text_report(path, text, max_findings, options);
    return report.findings;
}

fn _count_suppressed(rows) {
    let counts = map{};
    let i = 0;
    while rows != nil and i < len(rows) {
        _count_inc(counts, rows[i].reason);
        i = i + 1;
    }
    return counts;
}

fn _merge_counts(dst, src) {
    let keys = map_keys(src);
    let i = 0;
    while i < len(keys) {
        dst[keys[i]] = (try dst[keys[i]] catch 0) + (try src[keys[i]] catch 0);
        i = i + 1;
    }
    return dst;
}

fn scan_records(records, max_findings = 500, options = nil) {
    max_findings = _require_finding_limit(max_findings, 500);
    if options == nil { options = map{}; }
    let findings = [];
    let suppressed = [];
    let counts_kind = map{};
    let counts_severity = map{};
    let counts_role = map{};
    let counts_role_severity = map{};
    let counts_role_kind_severity = map{};
    let counts_suppressed = map{};
    let truncated = false;
    let ri = 0;
    while records != nil and ri < len(records) and len(findings) < max_findings {
        let rec = records[ri];
        let path = str(try rec.path catch try rec.name catch "[record]");
        let text = str(try rec.text catch try rec.content catch "");
        let rec_opts = options;
        let rec_suppress = try rec.suppress_audit catch nil;
        if rec_suppress != nil {
            rec_opts = map{
                allow_inline_suppressions: try options.allow_inline_suppressions catch true,
                suppress_paths: try options.suppress_paths catch [],
                suppress_test_fixtures: rec_suppress
            };
        }
        let one_report = scan_text_report(path, text, max_findings - len(findings), rec_opts);
        if one_report.truncated { truncated = true; }
        let one = one_report.findings;
        let fi = 0;
        while fi < len(one) and len(findings) < max_findings {
            array_push(findings, one[fi]);
            _count_inc(counts_kind, one[fi].kind);
            _count_inc(counts_severity, one[fi].severity);
            let role = str(try one[fi].role catch "unknown");
            _count_inc(counts_role, role);
            _count_inc(counts_role_severity, role + ":" + str(try one[fi].severity catch "info"));
            _count_inc(counts_role_kind_severity, role + ":" + str(try one[fi].kind catch "unknown") + ":" + str(try one[fi].severity catch "info"));
            fi = fi + 1;
        }
        let si = 0;
        while si < len(one_report.suppressed) {
            array_push(suppressed, one_report.suppressed[si]);
            si = si + 1;
        }
        _merge_counts(counts_suppressed, _count_suppressed(one_report.suppressed));
        ri = ri + 1;
    }
    let ordered = _sort_findings(findings);
    return map{
        format: "pblang.project_audit.report.v1",
        records: ri,
        findings: ordered,
        finding_count: len(ordered),
        counts_kind: counts_kind,
        counts_severity: counts_severity,
        counts_role: counts_role,
        counts_role_severity: counts_role_severity,
        counts_role_kind_severity: counts_role_kind_severity,
        suppressed: suppressed,
        suppressed_count: len(suppressed),
        counts_suppressed: counts_suppressed,
        truncated: truncated or ri < len(records),
        passed: len(ordered) == 0,
        policy: "bounded caller-provided text only; no filesystem walking; suppressions are explicit and reported"
    };
}

fn explain_suppressions(report_or_project_report) {
    let report = _as_report(report_or_project_report);
    let rows = try report.suppressed catch [];
    let out = [];
    let i = 0;
    while i < len(rows) {
        let r = rows[i];
        array_push(out, str(try r.reason catch "suppressed") + " :: " + str(try r.path catch "[input]") + ":" + str(try r.line catch 0));
        i = i + 1;
    }
    return out;
}

fn _count_inc(counts, key) {
    let k = str(key);
    counts[k] = (try counts[k] catch 0) + 1;
}

fn _sort_findings(findings) {
    let out = [];
    let used = map{};
    while len(out) < len(findings) {
        let best = 0 - 1;
        let bi = 0;
        while bi < len(findings) {
            if not (try used[str(bi)] catch false) {
                if best < 0 or findings[bi].score > findings[best].score {
                    best = bi;
                }
            }
            bi = bi + 1;
        }
        if best < 0 { return out; }
        used[str(best)] = true;
        array_push(out, findings[best]);
    }
    return out;
}

fn project_recommendations(project, report) {
    let p = _lower(project);
    let counts = try report.counts_kind catch map{};
    let out = [];
    if (try counts.security catch 0) > 0 {
        array_push(out, "Security first: redact secrets, gate risky actions, and add regression fixtures before adding features.");
    }
    if (try counts.incomplete catch 0) > 0 {
        array_push(out, "Close incomplete/stub/placeholder items or relabel them as explicit roadmap contracts.");
    }
    if (try counts.performance catch 0) > 0 {
        array_push(out, "Add caps, batching, caching, and benchmark thresholds for slow or unbounded paths.");
    }
    if (try counts.reliability catch 0) > 0 {
        array_push(out, "Turn panic/unwrap/nil paths into structured errors and edge-case tests.");
    }
    if p == "pbide" {
        array_push(out, "Keep renderer/input changes in pure ide_features tests before touching the interactive draw loop.");
    } else if p == "pbai" {
        array_push(out, "Do not train on findings directly; convert verified fixes into curated corpus records after redaction.");
    } else if p == "pbos" {
        array_push(out, "Keep bootability claims blocked until freestanding/backend/QEMU exit tests pass.");
    } else if p == "pb-mcp-server" or p == "mcp" {
        array_push(out, "Every tool should declare read/write/network/destructive/secret-sensitive behavior.");
    } else if p == "pblang" {
        array_push(out, "Promote repeated findings into compiler/linter/stdlib contracts with semantic tests.");
    }
    return out;
}

fn audit_project(project, records, max_findings = 500, options = nil) {
    let report = scan_records(records, max_findings, options);
    return map{
        format: "pblang.project_audit.project_report.v1",
        project: project,
        report: report,
        recommendations: project_recommendations(project, report)
    };
}

fn _as_report(value) {
    let r = try value.report catch nil;
    if r != nil { return r; }
    return value;
}

fn _opt_num(opts, name, fallback) {
    let v = try opts[name] catch fallback;
    if v == nil { return fallback; }
    return v;
}

// Validate only the fixed gate inputs, not caller-sized maps or retained rows.
// Missing keys are sparse zeroes; a supplied nil is malformed, not absent.
fn _gate_count_number(value) {
    if type(value) != "number" or value != value or value - value != 0
        or value < 0 or value > 9007199254740991 or value != num_floor(value) {
        throw "project audit gate counters must be finite integers in 0..9007199254740991";
    }
    return value;
}

fn _gate_count(report, container, name) {
    if not map_has(report, container) { return 0; }
    let counts = report[container];
    if type(counts) != "map" { throw "project audit gate counter containers must be maps"; }
    if not map_has(counts, name) { return 0; }
    return _gate_count_number(counts[name]);
}

fn _gate_finding_count(report) {
    if map_has(report, "finding_count") { return _gate_count_number(report.finding_count); }
    if not map_has(report, "findings") { return 0; }
    if type(report.findings) != "array" { throw "project audit gate findings fallback must be an array"; }
    return _gate_count_number(len(report.findings));
}

fn _sev(report, name) {
    return _gate_count(report, "counts_severity", name);
}

fn _kind(report, name) {
    return _gate_count(report, "counts_kind", name);
}

fn _role(report, name) {
    return _gate_count(report, "counts_role", name);
}

fn _role_sev(report, role, severity) {
    return _gate_count(report, "counts_role_severity", role + ":" + severity);
}

fn _role_kind_sev(report, role, kind, severity) {
    return _gate_count(report, "counts_role_kind_severity", role + ":" + kind + ":" + severity);
}

// Gate policy is resolved before inspecting reports. Nil keeps legacy defaults;
// malformed policy must propagate, never become an apparently valid gate result.
fn _gate_num(opts, name, fallback) {
    let value = try opts[name] catch nil;
    if value == nil { return fallback; }
    if type(value) != "number" or value != value or value - value != 0
        or value < 0 or value > 9007199254740991 or value != num_floor(value) {
        throw "project audit gate numeric limits must be finite integers in 0..9007199254740991";
    }
    return value;
}

fn _gate_bool(opts, name, fallback) {
    let value = try opts[name] catch nil;
    if value == nil { return fallback; }
    if type(value) != "bool" { throw "project audit gate flags must be booleans"; }
    return value;
}

fn _quality_gate_options(options) {
    if options == nil {
        return map{max_high: 0, max_medium: 5, max_total: 50,
            max_source_high: 0, max_source_medium: 5, max_source_total: 50,
            source_only_blockers: false, allow_roadmap: true};
    }
    if type(options) != "map" { throw "project audit gate options must be a map or nil"; }
    let max_high = _gate_num(options, "max_high", 0);
    let max_medium = _gate_num(options, "max_medium", 5);
    let max_total = _gate_num(options, "max_total", 50);
    let max_source_high = _gate_num(options, "max_source_high", max_high);
    let max_source_medium = _gate_num(options, "max_source_medium", max_medium);
    let max_source_total = _gate_num(options, "max_source_total", max_total);
    let allow_roadmap = _gate_bool(options, "allow_roadmap", true);
    let source_only_blockers = _gate_bool(options, "source_only_blockers", false);
    return map{ max_high: max_high, max_medium: max_medium, max_total: max_total, max_source_high: max_source_high, max_source_medium: max_source_medium, max_source_total: max_source_total, source_only_blockers: source_only_blockers, allow_roadmap: allow_roadmap };
}

fn quality_gate(report_or_project_report, options = nil) {
    return _quality_gate_resolved(report_or_project_report, _quality_gate_options(options));
}

// Plain detached values for preflight callers, not a reusable authorization token.
// quality_gate always validates its input again, including maps returned here.
fn require_quality_gate_options(options = nil) {
    return _quality_gate_options(options);
}

fn _quality_gate_resolved(report_or_project_report, policy) {
    if type(report_or_project_report) != "map" { throw "project audit gate report must be a map"; }
    let max_high = policy.max_high;
    let max_medium = policy.max_medium;
    let max_total = policy.max_total;
    let max_source_high = policy.max_source_high;
    let max_source_medium = policy.max_source_medium;
    let max_source_total = policy.max_source_total;
    let allow_roadmap = policy.allow_roadmap;
    let source_only_blockers = policy.source_only_blockers;
    let report = if map_has(report_or_project_report, "report") {
        report_or_project_report.report
    } else { report_or_project_report };
    if type(report) != "map" { throw "project audit gate report must be a map"; }
    let findings = _gate_finding_count(report);
    let high = _sev(report, "high");
    let medium = _sev(report, "medium");
    let low = _sev(report, "low");
    let info = _sev(report, "info");
    let security = _kind(report, "security");
    let reliability = _kind(report, "reliability");
    let performance = _kind(report, "performance");
    let incomplete = _kind(report, "incomplete");
    let roadmap = _kind(report, "roadmap");
    let source_findings = _role(report, "source");
    let docs_findings = _role(report, "docs");
    let test_findings = _role(report, "test");
    let config_findings = _role(report, "config");
    let source_high = _role_sev(report, "source", "high");
    let source_medium = _role_sev(report, "source", "medium");
    if source_high > 9007199254740991 - source_medium {
        throw "project audit gate counters must be finite integers in 0..9007199254740991";
    }
    let source_blocking = source_high + source_medium;
    let source_security_high = _role_kind_sev(report, "source", "security", "high");
    let source_reliability_high = _role_kind_sev(report, "source", "reliability", "high");
    let source_performance_high = _role_kind_sev(report, "source", "performance", "high");
    let blockers = [];
    let warnings = [];
    if source_only_blockers {
        if source_high > max_source_high { array_push(blockers, "source high findings " + str(source_high) + " > " + str(max_source_high)); }
        if source_medium > max_source_medium { array_push(blockers, "source medium findings " + str(source_medium) + " > " + str(max_source_medium)); }
        if source_blocking > max_source_total { array_push(blockers, "source blocking findings " + str(source_blocking) + " > " + str(max_source_total)); }
    } else {
        if high > max_high { array_push(blockers, "high findings " + str(high) + " > " + str(max_high)); }
        if medium > max_medium { array_push(blockers, "medium findings " + str(medium) + " > " + str(max_medium)); }
        if findings > max_total { array_push(blockers, "total findings " + str(findings) + " > " + str(max_total)); }
    }
    if security > 0 and high > 0 and (not source_only_blockers or source_security_high > 0) { array_push(blockers, "high-severity security findings require fix/redaction"); }
    if reliability > 0 and high > 0 and (not source_only_blockers or source_reliability_high > 0) { array_push(blockers, "high-severity reliability findings require structured-error fixes"); }
    if performance > 0 and high > 0 and (not source_only_blockers or source_performance_high > 0) { array_push(blockers, "high-severity performance findings require caps/benchmarks"); }
    if not allow_roadmap and roadmap > 0 { array_push(blockers, "roadmap findings are not allowed for this gate"); }
    if incomplete > 0 { array_push(warnings, "incomplete/stub/placeholder findings need implementation or honest roadmap labels"); }
    if roadmap > 0 { array_push(warnings, "roadmap/blocker/gap findings need explicit exit tests"); }
    if docs_findings > 0 or test_findings > 0 or config_findings > 0 {
        array_push(warnings, "non-source findings: docs=" + str(docs_findings) + " test=" + str(test_findings) + " config=" + str(config_findings));
    }
    if low > 0 or info > 0 { array_push(warnings, "low/info findings should be triaged before release notes"); }
    let passed = len(blockers) == 0;
    let status = "passed";
    if findings > 0 { status = "needs-review"; }
    if not passed { status = "blocked"; }
    return map{
        format: "pblang.project_audit.quality_gate.v1",
        passed: passed,
        status: status,
        blockers: blockers,
        warnings: warnings,
        counts: map{
            total: findings,
            high: high,
            medium: medium,
            low: low,
            info: info,
            security: security,
            reliability: reliability,
            performance: performance,
            incomplete: incomplete,
            roadmap: roadmap,
            source: source_findings,
            source_blocking: source_blocking,
            docs: docs_findings,
            test: test_findings,
            config: config_findings,
            source_high: source_high,
            source_medium: source_medium,
            source_security_high: source_security_high,
            source_reliability_high: source_reliability_high,
            source_performance_high: source_performance_high
        },
        thresholds: policy,
        policy: "release gate over bounded caller-provided audit reports"
    };
}

fn backlog(report_or_project_report, limit = 20) {
    if limit == nil or limit < 1 { limit = 20; }
    let report = _as_report(report_or_project_report);
    let findings = try report.findings catch [];
    let tasks = [];
    let i = 0;
    while i < len(findings) and len(tasks) < limit {
        let f = findings[i];
        let id = "audit-" + str(i + 1);
        array_push(tasks, map{
            format: "pblang.project_audit.task.v1",
            id: id,
            title: str(try f.severity catch "info") + " " + str(try f.kind catch "finding") + " in " + str(try f.path catch "[input]"),
            severity: str(try f.severity catch "info"),
            kind: str(try f.kind catch "unknown"),
            role: str(try f.role catch "unknown"),
            path: str(try f.path catch "[input]"),
            line: try f.line catch 0,
            text: str(try f.text catch ""),
            recommendation: str(try f.recommendation catch "review"),
            status: "open"
        });
        i = i + 1;
    }
    return map{
        format: "pblang.project_audit.backlog.v1",
        tasks: tasks,
        task_count: len(tasks),
        source_findings: len(findings),
        truncated: len(tasks) < len(findings)
    };
}

fn finding_key(f) {
    let path = str(try f.path catch "[input]");
    let line = str(try f.line catch 0);
    let kind = str(try f.kind catch "unknown");
    let text = _lower(str_trim(str(try f.text catch "")));
    if len(text) > 160 { text = str_slice(text, 0, 160); }
    return path + ":" + line + ":" + kind + ":" + text;
}

fn _finding_map(rows) {
    let out = map{};
    let i = 0;
    while rows != nil and i < len(rows) {
        out[finding_key(rows[i])] = rows[i];
        i = i + 1;
    }
    return out;
}

fn _finding_diff(rows, other_map) {
    let out = [];
    let i = 0;
    while rows != nil and i < len(rows) {
        let key = finding_key(rows[i]);
        let found = try other_map[key] catch nil;
        if found == nil { array_push(out, rows[i]); }
        i = i + 1;
    }
    return out;
}

fn _finding_intersection(rows, other_map) {
    let out = [];
    let i = 0;
    while rows != nil and i < len(rows) {
        let key = finding_key(rows[i]);
        let found = try other_map[key] catch nil;
        if found != nil { array_push(out, rows[i]); }
        i = i + 1;
    }
    return out;
}

fn _row_field(row, field) {
    if field == "severity" { return str(try row.severity catch ""); }
    if field == "kind" { return str(try row.kind catch ""); }
    return str(try row[field] catch "");
}

fn _count_rows(rows, field, value) {
    let n = 0;
    let i = 0;
    while rows != nil and i < len(rows) {
        if _row_field(rows[i], field) == value { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn _counts_for_rows(rows) {
    let severity = map{};
    let kind = map{};
    let i = 0;
    while rows != nil and i < len(rows) {
        _count_inc(severity, str(try rows[i].severity catch "unknown"));
        _count_inc(kind, str(try rows[i].kind catch "unknown"));
        i = i + 1;
    }
    return map{ severity: severity, kind: kind };
}

fn compare_reports(before_report_or_project, after_report_or_project, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { throw "project audit gate options must be a map or nil"; }
    let max_new_total = _gate_num(options, "max_new_total", 0);
    let max_new_high = _gate_num(options, "max_new_high", 0);
    let max_new_medium = _gate_num(options, "max_new_medium", 0);
    let block_new_security = _gate_bool(options, "block_new_security", true);
    let block_new_reliability = _gate_bool(options, "block_new_reliability", true);
    let block_new_performance = _gate_bool(options, "block_new_performance", true);
    let before = _as_report(before_report_or_project);
    let after = _as_report(after_report_or_project);
    let before_rows = try before.findings catch [];
    let after_rows = try after.findings catch [];
    let before_map = _finding_map(before_rows);
    let after_map = _finding_map(after_rows);
    let fixed = _finding_diff(before_rows, after_map);
    let new_rows = _finding_diff(after_rows, before_map);
    let unchanged = _finding_intersection(after_rows, before_map);

    let new_high = _count_rows(new_rows, "severity", "high");
    let new_medium = _count_rows(new_rows, "severity", "medium");
    let new_security = _count_rows(new_rows, "kind", "security");
    let new_reliability = _count_rows(new_rows, "kind", "reliability");
    let new_performance = _count_rows(new_rows, "kind", "performance");
    let blockers = [];
    if len(new_rows) > max_new_total { array_push(blockers, "new findings " + str(len(new_rows)) + " > " + str(max_new_total)); }
    if new_high > max_new_high { array_push(blockers, "new high findings " + str(new_high) + " > " + str(max_new_high)); }
    if new_medium > max_new_medium { array_push(blockers, "new medium findings " + str(new_medium) + " > " + str(max_new_medium)); }
    if block_new_security and new_security > 0 { array_push(blockers, "new security findings require redaction/fix"); }
    if block_new_reliability and new_reliability > 0 { array_push(blockers, "new reliability findings require structured-error fix"); }
    if block_new_performance and new_performance > 0 { array_push(blockers, "new performance findings require cap/benchmark"); }

    let passed = len(blockers) == 0;
    let status = "stable";
    if (try after.finding_count catch len(after_rows)) == 0 and (try before.finding_count catch len(before_rows)) == 0 { status = "clean"; }
    if len(fixed) > 0 and len(new_rows) == 0 { status = "improved"; }
    if len(new_rows) > 0 and passed { status = "needs-review"; }
    if not passed { status = "regressed"; }

    return map{
        format: "pblang.project_audit.compare.v1",
        status: status,
        passed: passed,
        blockers: blockers,
        before_count: len(before_rows),
        after_count: len(after_rows),
        fixed_count: len(fixed),
        new_count: len(new_rows),
        unchanged_count: len(unchanged),
        delta: len(after_rows) - len(before_rows),
        fixed_findings: fixed,
        new_findings: new_rows,
        unchanged_findings: unchanged,
        new_counts: _counts_for_rows(new_rows),
        fixed_counts: _counts_for_rows(fixed),
        thresholds: map{
            max_new_total: max_new_total,
            max_new_high: max_new_high,
            max_new_medium: max_new_medium,
            block_new_security: block_new_security,
            block_new_reliability: block_new_reliability,
            block_new_performance: block_new_performance
        },
        policy: "compare bounded audit reports; fail by default on new findings"
    };
}

fn progress_gate(before_report_or_project, after_report_or_project, options = nil) {
    let cmp = compare_reports(before_report_or_project, after_report_or_project, options);
    return map{
        format: "pblang.project_audit.progress_gate.v1",
        passed: cmp.passed,
        status: cmp.status,
        blockers: cmp.blockers,
        compare: cmp,
        rule: "no new audit findings by default; tune thresholds explicitly for roadmap/low-risk noise"
    };
}

fn release_readiness(project, records, options = nil) {
    if options == nil { options = map{}; }
    let max_findings = require_finding_limit(_opt_num(options, "max_findings", 500));
    let gate_policy = _quality_gate_options(options);
    let audit = audit_project(project, records, max_findings, options);
    let gate = _quality_gate_resolved(audit.report, gate_policy);
    let tasks = backlog(audit.report, _opt_num(options, "backlog_limit", 20));
    let next = [
        "fix every blocker before accepting the build/checkpoint/release",
        "turn repeated findings into semantic/security/performance regression tests",
        "keep roadmap-only items documented separately from implemented features"
    ];
    if gate.status == "passed" {
        next = ["record verification evidence and keep the gate in CI or release scripts"];
    } else if gate.status == "needs-review" {
        array_push(next, "triage warnings and choose explicit deferral or implementation");
    }
    return map{
        format: "pblang.project_audit.release_readiness.v1",
        project: project,
        audit: audit,
        quality_gate: gate,
        backlog: tasks,
        recommendations: audit.recommendations,
        next_actions: next
    };
}

export require_finding_limit, require_quality_gate_options, pbaudit_numeric_error, finding, recommendation_for_kind, security_policy_markers, suppression_reason, scan_text_report, scan_text, scan_records,
       explain_suppressions, project_recommendations, audit_project, quality_gate, backlog,
       finding_key, compare_reports, progress_gate, release_readiness;
