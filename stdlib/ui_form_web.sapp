// Local transport/action boundary; pure schema and HTML live in ui_form_web_document.
let Document=import("stdlib:ui_form_web_document.sapp");
let HTTP=import("stdlib:http_server.sapp");
let MAX_BODY=65536;
fn _has(items,value) {for item in items {if item==value {return true;}}return false;}
fn _prop(widget,key,fallback) {return try widget.props[key] catch fallback;}
let stylesheet=Document.stylesheet;
let inspect=Document.inspect;
fn _response(status, body, kind="text/html; charset=utf-8") {
    return map{status:status, body:body, content_type:kind, headers:map{"Cache-Control":"no-store", "Referrer-Policy":"same-origin", "X-Content-Type-Options":"nosniff",
            "Cross-Origin-Opener-Policy":"same-origin", "Cross-Origin-Resource-Policy":"same-origin", "Cross-Origin-Embedder-Policy":"require-corp",
            "Permissions-Policy":"camera=(), microphone=(), geolocation=(), payment=(), usb=()", "X-Frame-Options":"DENY",
            "Content-Security-Policy":"default-src 'none'; style-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'"}};
}

fn _decode(text) {
    let i=0;
    while i < len(text) {
        if text[i] == "%" {
            if i + 2 >= len(text) or not str_contains("0123456789abcdefABCDEF", text[i + 1]) or not str_contains("0123456789abcdefABCDEF", text[i + 2]) { throw "invalid escape"; }
            i=i + 2;
        }
        i=i + 1;
    }
    let decoded=url_decode(str_join(str_split(text, "+"), " "));
    if str_contains(decoded, strfromcharcode(0)) { throw "invalid NUL"; } return decoded;
}

fn _values(schema, body) {
    if type(body) != "string" or len(body) > MAX_BODY or len(str_to_bytes(body)) > MAX_BODY { throw "invalid body"; }
    let raw=map{}; let pairs=str_split(body, "&");
    if len(pairs) > 515 { throw "too many fields"; }
    for pair in pairs {
        let bits=str_split(pair, "="); if len(bits) != 2 { throw "invalid pair"; }
        let key=_decode(bits[0]); let value=_decode(bits[1]);
        if map_has(raw, key) or not (_has(["action", "csrf", "revision"], key) or map_has(schema.fields, key)) or len(value) > 4096 { throw "invalid field"; }
        raw[key]=value;
    }
    let values=map{};
    for key in map_keys(schema.fields) {
        let widget=schema.fields[key]; let value=try raw[key] catch nil;
        if widget.kind == "checkbox" {
            if value != nil and value != "1" { throw "invalid checkbox"; } values[widget.id]=value == "1";
        } elif widget.kind == "select" {
            if value == nil { throw "missing selection"; }
            let options=_prop(widget, "options", []); let matched=value == ""; let index=0; let chosen=nil;
            for option in options { if value == str(index) { matched=true; chosen=option; } index=index + 1; }
            if not matched { throw "invalid selection"; }
            values[widget.id]=chosen;
        } else {
            if value == nil { throw "missing field"; } values[widget.id]=value;
        }
    }
    return map{raw:raw, values:values};
}

fn _handle(state, req) {
    if state.closed { return _response(503, "Preview closed."); }
    if state.busy { return _response(409, "Action already in progress."); }
    let names=map{};
    for key in map_keys(req.headers) { let lower=str_lower(key); if map_has(names, lower) { return _response(400, "Duplicate header."); } names[lower]=true; }
    if HTTP.req_header(req, "host") != state.host { return _response(403, "Host rejected."); }
    let origin=HTTP.req_header(req, "origin"); let site=HTTP.req_header(req, "sec-fetch-site");
    if (origin != nil and origin != state.origin) or (site != nil and site != "none" and site != "same-origin") { return _response(403, "Origin rejected."); }
    if req.method == "GET" {
        if req.path == "/style.css" { return _response(200, stylesheet(), "text/css; charset=utf-8"); }
        if req.path == "/" { return _response(200, Document.page(state)); }
        return _response(404, "Not found.");
    }
    if req.method != "POST" { return _response(405, "Use GET or POST."); }
    if req.path != "/action" { return _response(404, "Not found."); }
    if origin != state.origin { return _response(403, "Same-origin form required."); }
    if HTTP.req_header(req, "content-type") != "application/x-www-form-urlencoded" { return _response(415, "Form encoding required."); }
    let input=try _values(state.schema, req.body) catch nil;
    if input == nil { return _response(400, "Invalid fields."); }
    let token=try input.raw.csrf catch "";
    if len(token) != 64 or not constant_time_eq(token, state.csrf) { return _response(403, "Request verification failed."); }
    if (try input.raw.revision catch "") != str(state.revision) { return _response(409, "Stale form. Refresh before submitting again."); }
    let action=try input.raw.action catch "";
    if not map_has(state.schema.actions, action) { return _response(400, "Unbound action."); }
    if state.revision >= 9007199254740990 { state.closed=true; return _response(503, "Revision capacity reached."); }
    // Consume before invoking trusted code: an effect followed by an exception is not replayed.
    state.revision=state.revision + 1; state.busy=true;
    let result=try state.schema.actions[action](input.values) catch nil;
    state.busy=false;
    if state.closed { return _response(503, "Preview closed during action."); }
    if type(result) != "string" or len(result) > 4096 { return _response(500, "Action result unavailable. It may have taken effect; inspect before retrying."); }
    return _response(200, Document.page(state, result, input.raw));
}
// Voluntary crawler policy plus a per-preview request budget, NOT bot authentication.
// No UA fingerprinting, tracking cookies, external services or client-side traps.

fn _dispatch(state, req) {
    if not state.policy.discourage_scraping and not state.policy.throttle_rejected_requests { return _handle(state, req); }
    if state.closed { return _response(503, "Preview closed."); }
    let current=now_ms();
    if type(current) != "number" or not (current >= 0 and current <= 9007199254740991) or current < state.last_time {
        state.closed=true;return _response(503, "Clock unavailable. Restart preview.");
    }
    state.last_time=current;
    if current >= state.window + 60000 {state.window=current;state.requests=0;state.rejected=0;}
    let response=nil;
    if state.policy.throttle_rejected_requests and current < state.blocked_until {
        response=_response(429, "Rejected-request budget reached. Try later.");response.headers["Retry-After"]=str(num_ceil((state.blocked_until-current)/1000));
    } elif state.policy.discourage_scraping and state.requests >= 120 {
        response=_response(429, "Request budget reached. Try later.");response.headers["Retry-After"]="60";
    } else {
        state.requests=state.requests + 1;
        // The inert robots response contains no state; regular pages retain all guards.
        if state.policy.discourage_scraping and req.method == "GET" and req.path == "/robots.txt" and HTTP.req_header(req, "host") == state.host {
            response=_response(200, "User-agent: *\nDisallow: /\n", "text/plain; charset=utf-8");
        } else {response=_handle(state, req);}
    }
    if state.policy.throttle_rejected_requests and _has([400,403,404,405,415],response.status) {
        state.rejected=state.rejected+1;
        if state.rejected>=8 {state.blocked_until=current+30000;state.rejected=0;}
    }
    if state.policy.discourage_scraping {response.headers["X-Robots-Tag"]="noindex, nofollow, noarchive, nosnippet";}
    return response;
}

fn create(document, actions, port=8766, options=nil) {
    if type(port) != "number" or port != num_floor(port) or port < 1024 or port > 65535 { throw "ui_form_web: invalid port"; }
    let prepared=Document.prepare(document,actions,options); let policy=prepared.policy; let schema=prepared.schema; let host="127.0.0.1:" + str(port);
    // pblang-security-ignore-next-line: network.plaintext-http reason=exact loopback-only preview; remote serving requires a separate authenticated transport
    let origin="http://" + host;
    let state=map{schema:schema, host:host, origin:origin, csrf:sha256(json_stringify(random_bytes(32))), revision:0, busy:false, closed:false, policy:policy, window:0, requests:0, rejected:0, blocked_until:0, last_time:0};
    Document.page(state); // Validate output budget before publishing a handler.
    return map{handle:fn(req){return _dispatch(state, req);}, close:fn(){state.closed=true;state.csrf="";state.schema.actions=map{};return true;},
        port:port, imported_handlers:schema.imported_handlers, layout_preserved:false, foreign_handlers_executed:false};
}

fn serve(document, actions, port=8766, max_connections=nil, options=nil) {
    let app=create(document, actions, port, options); let failed=false;
    try HTTP.serve_forever_timeout("127.0.0.1:" + str(port), app.handle, map{request_timeout_ms:2000, write_timeout_ms:1000, accept_poll_ms:25, max_inflight:4, max_header_bytes:8192, max_body_bytes:MAX_BODY, max_response_bytes:1048576, max_connections:max_connections}) catch {failed=true;};
    app.close(); if failed { throw "ui_form_web: listener failed or bounded transport unavailable"; }
}
export create, serve, stylesheet, inspect;
