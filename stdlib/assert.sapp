// stdlib/assert.sapp — Assertion helpers for testing and contracts
//
// Usage:
//   let a = import("stdlib:assert.sapp");
//   a.eq(result, expected, "should equal");
//   a.ok(x > 0, "x must be positive");
//   a.throws(fn() { bad_fn(); }, "should raise");

// Pass/fail counters (module-level state)
let _passed = 0;
let _failed = 0;

// assert_ok(cond, msg) — assert that cond is truthy
fn ok(cond, msg) {
    if cond {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = ": " + str(msg); }
    print "FAIL" + label;
    return false;
}

// assert_eq(a, b, msg) — assert deep equality
fn eq(a, b, msg) {
    let passed = (a == b);
    if passed {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = " (" + str(msg) + ")"; }
    print "FAIL eq" + label + ": expected " + str(b) + " got " + str(a);
    return false;
}

// assert_ne(a, b, msg) — assert inequality
fn ne(a, b, msg) {
    let passed = (a != b);
    if passed {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = " (" + str(msg) + ")"; }
    print "FAIL ne" + label + ": expected not equal to " + str(b);
    return false;
}

// assert_nil(v, msg) — assert v is nil
fn is_nil(v, msg) {
    return ok(v == nil, msg);
}

// assert_not_nil(v, msg) — assert v is not nil
fn not_nil(v, msg) {
    return ok(v != nil, msg);
}

// assert_throws(fn, msg) — assert that fn() raises a runtime error
fn throws(f, msg) {
    let err = try f() catch nil;
    // If no exception was raised, err is the return value (not nil from catch)
    // We use a sentinel approach: try the fn, catch the error
    let raised = try { f(); false; } catch true;
    return ok(raised, msg);
}

// summary() — print pass/fail counts; return true if all passed
fn summary() {
    let total = _passed + _failed;
    print "Tests: " + str(_passed) + "/" + str(total) + " passed";
    return _failed == 0;
}

// reset() — reset counters
fn reset() {
    _passed = 0;
    _failed = 0;
}

export ok, eq, ne, is_nil, not_nil, throws, summary, reset;
