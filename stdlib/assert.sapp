// stdlib/assert.sapp — Assertion helpers for testing and contracts
//
// Usage:
//   let a = import("stdlib:assert.sapp");
//   a.eq(result, expected, "should equal");
//   a.ok(x > 0, "x must be positive");
//   a.throws(fn() { bad_fn(); }, "should raise");

// Pass/fail counters (module-level state)
let _passed = 0;
let _failed = 0;

// assert_ok(cond, msg) — assert that cond is truthy
fn ok(cond, msg) {
    if cond {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = ": " + str(msg); }
    print "FAIL" + label;
    return false;
}

// assert_eq(a, b, msg) — assert deep equality
fn eq(a, b, msg) {
    let passed = (a == b);
    if passed {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = " (" + str(msg) + ")"; }
    print "FAIL eq" + label + ": expected " + str(b) + " got " + str(a);
    return false;
}

// assert_ne(a, b, msg) — assert inequality
fn ne(a, b, msg) {
    let passed = (a != b);
    if passed {
        _passed = _passed + 1;
        return true;
    }
    _failed = _failed + 1;
    let label = "";
    if msg != nil { label = " (" + str(msg) + ")"; }
    print "FAIL ne" + label + ": expected not equal to " + str(b);
    return false;
}

// assert_nil(v, msg) — assert v is nil
fn is_nil(v, msg) {
    return ok(v == nil, msg);
}

// assert_not_nil(v, msg) — assert v is not nil
fn not_nil(v, msg) {
    return ok(v != nil, msg);
}

// assert_throws(fn, msg) — assert that fn() raises a runtime error
fn throws(f, msg) {
    // sentinel approach: run f exactly ONCE, catch tells us whether it raised
    let raised = try { f(); false; } catch true;
    return ok(raised, msg);
}

// summary() — print pass/fail counts; return true if all passed
fn summary() {
    let total = _passed + _failed;
    print "Tests: " + str(_passed) + "/" + str(total) + " passed";
    return _failed == 0;
}

// reset() — reset counters
fn reset() {
    _passed = 0;
    _failed = 0;
}

// ── comparison assertions ──────────────────────────────────────────────────────────
fn gt(a, b, msg)  { return ok(a > b, msg); }
fn lt(a, b, msg)  { return ok(a < b, msg); }
fn gte(a, b, msg) { return ok(a >= b, msg); }
fn lte(a, b, msg) { return ok(a <= b, msg); }

// ── boolean assertions ──────────────────────────────────────────────────────────────
fn is_true(v, msg)  { return ok(v == true, msg); }
fn is_false(v, msg) { return ok(v == false, msg); }

// approx(a, b, eps, msg) — assert |a - b| <= eps (float tolerance).
fn approx(a, b, eps, msg) { return ok(num_abs(a - b) <= eps, msg); }

// contains(coll, item, msg) — array element membership, or substring for a string.
fn contains(coll, item, msg) {
    if type(coll) == "string" { return ok(str_index_of(coll, item) >= 0, msg); }
    let i = 0;
    while i < len(coll) { if coll[i] == item { return ok(true, msg); } i = i + 1; }
    return ok(false, msg);
}

// len_eq(coll, n, msg) — assert len(coll) == n.
fn len_eq(coll, n, msg) { return ok(len(coll) == n, msg); }

// passed()/failed() — current tally (for programmatic checks).
fn passed() { return _passed; }
fn failed() { return _failed; }

export ok, eq, ne, is_nil, not_nil, throws, summary, reset;
export gt, lt, gte, lte, is_true, is_false, approx, contains, len_eq, passed, failed;
