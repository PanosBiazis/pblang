// Strict Wake-on-LAN packet construction and native UDP delivery.

let UDP = import("stdlib:native_udp.sapp");
let FORMAT = "pblang.wake-on-lan.v1";

fn _hex_octet(value) {
    if type(value) != "string" or len(value) != 2 { return nil; }
    let digits = "0123456789abcdef";
    let high = str_index_of(digits, str_lower(str_slice(value, 0, 1)));
    let low = str_index_of(digits, str_lower(str_slice(value, 1, 2)));
    if high < 0 or low < 0 { return nil; }
    return high * 16 + low;
}

fn parse_mac(value) {
    if type(value) != "string" { return map{ ok: false, error: "MAC address must be text" }; }
    let normalized = str_replace_all(str_trim(value), "-", ":");
    let parts = str_split(normalized, ":");
    if len(parts) != 6 { return map{ ok: false, error: "MAC address must contain exactly six octets" }; }
    let bytes = []; let canonical = [];
    let digits = "0123456789ABCDEF";
    for i 6 {
        let octet = _hex_octet(parts[i]);
        if octet == nil { return map{ ok: false, error: "MAC address contains a malformed octet" }; }
        array_push(bytes, octet);
        array_push(canonical, str_slice(digits, num_floor(octet / 16), num_floor(octet / 16) + 1)
            + str_slice(digits, num_mod(octet, 16), num_mod(octet, 16) + 1));
    }
    return map{ ok: true, bytes: bytes, canonical: str_join(canonical, ":") };
}

fn magic_packet(value) {
    let mac = parse_mac(value); if not mac.ok { return mac; }
    let bytes = [255,255,255,255,255,255];
    for _repeat 16 { for i 6 { array_push(bytes, mac.bytes[i]); } }
    return map{ ok: true, format: FORMAT, mac: mac.canonical, bytes: bytes,
        byte_count: len(bytes), sync_bytes: 6, repetitions: 16 };
}

fn send_ipv4(mac, destination = "255.255.255.255", port = 9, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { return map{ ok: false, error: "Wake-on-LAN options must be an object" }; }
    for key in map_keys(options) {
        if key != "timeout_ms" and key != "broadcast" {
            return map{ ok: false, error: "unknown Wake-on-LAN option: " + key };
        }
    }
    let packet = magic_packet(mac); if not packet.ok { return packet; }
    let timeout = try options.timeout_ms catch 500;
    let broadcast = try options.broadcast catch true;
    let sent = UDP.send_ipv4(destination, port, packet.bytes,
        map{ timeout_ms: timeout, broadcast: broadcast });
    if not sent.ok { sent.format = FORMAT; sent.mac = packet.mac; sent.destination = destination; return sent; }
    return map{ ok: true, sent: true, executed: true, format: FORMAT,
        mac: packet.mac, destination: destination, port: port, bytes: sent.bytes,
        magic_packet_bytes: packet.byte_count, broadcast: broadcast,
        elapsed_ms: sent.elapsed_ms, native_nonblocking: sent.nonblocking,
        cloexec: sent.cloexec, shell_used: false, fallback_attempted: false };
}

export FORMAT, parse_mac, magic_packet, send_ipv4;
