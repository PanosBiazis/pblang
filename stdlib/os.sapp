// stdlib/os.sapp

// Alias builtins into module exports without shadowing recursion.
let cwd = cwd;
let exec = exec;
let sleep_ms = sleep_ms;

let env_get = env_get;
let env_set = env_set;

// CLI arguments passed after -- on the command line.
fn args() {
    return os_args();
}

// Exit the process with the given exit code.
fn exit(code) {
    return os_exit(code);
}

// Signal trap stub (OS1-alpha).
// Register a Sapphire function to be called on SIGINT/SIGTERM.
// handler_fn receives the signal name string as its argument.
// Note: This is a stub - the builtin os_signal_trap may not be available in all builds.
fn signal_trap(sig, handler_fn) {
    let result = try os_signal_trap(sig, handler_fn) catch "stub";
    return result;
}

export cwd, exec, sleep_ms, env_get, env_set, args, exit, signal_trap;
