// stdlib/os.sapp — Operating system utilities.

let cwd       = cwd;
let exec      = exec;
let sleep_ms  = sleep_ms;
let env_get   = env_get;
let env_set   = env_set;

// args() — the raw CLI argv after the binary name, e.g.
// ["run", "main.sapp", "--allow-all", "list"]. For the arguments meant for
// YOUR SCRIPT use script_args() below.
fn args() { return os_args(); }

// script_args_from(argv) — extract the arguments intended for the script from
// a raw argv: drop everything up to and including the script path (first
// element ending in .sapp/.pbck), then skip leading `--flag` CLI options.
// A bare `--` ends option parsing so user args may start with dashes.
fn script_args_from(argv) {
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a = str(argv[i]);
        if a == "--" { i = i + 1; break; }
        if not str_starts_with(a, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n { push(out, argv[i]); i = i + 1; }
    return out;
}

// script_args() — arguments explicitly passed after `--`. The CLI publishes
// non-empty package-directory arguments in PBLANG_SCRIPT_ARGS. Fall back to
// argv parsing when that channel is absent/empty so legacy direct-file trailing
// arguments remain backward compatible.
fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if explicit != nil and explicit != "" {
        return str_split(explicit, "\n");
    }
    return script_args_from(os_args());
}

// exit(code) — exit the process
fn exit(code) { return os_exit(code); }

// signal_trap(sig, handler_fn) — install a real OS signal handler.
//
// `sig` is a name like "SIGINT", "SIGTERM", "SIGHUP", "SIGUSR1", "SIGUSR2",
// "SIGPIPE", "SIGQUIT". Case-insensitive; the leading "SIG" is optional.
// `handler_fn` is invoked the next time `os.signal_dispatch()` (below) is
// called *and* the OS has delivered the signal at least once.
//
// Returns map{ ok: bool, signal: string, signum: number } on success or
// map{ error: string } on unsupported platforms / unknown names.
fn signal_trap(sig, handler_fn) {
    let result = try os_signal_trap(sig, handler_fn) catch nil;
    if result == nil {
        return map{ error: "signal_trap not available on this platform" };
    }
    return result;
}

// signal_pending(sig) — drain pending count for the named signal.
// Returns the number of times the signal was received since last call (or
// since the program started). Always returns 0 on platforms that don't
// support the signal.
fn signal_pending(sig) {
    let result = try os_signal_pending(sig) catch 0;
    return result;
}

// signal_poll() — drain pending counts for every signal previously trapped.
// Returns a map{ signal_name -> count } of signals that have fired since the
// last call. Empty map means nothing pending.
fn signal_poll() {
    let result = try os_signal_poll() catch map{};
    return result;
}

// signal_dispatch() — drain pending signals and invoke each trapped handler
// exactly once per pending event. Returns the total number of handler
// invocations. Safe to call from your main loop.
fn signal_dispatch() {
    let pending = signal_poll();
    let names = map_keys(pending);
    let invoked = 0;
    let i = 0;
    while i < len(names) {
        let nm = names[i];
        let n = pending[nm];
        let handler = try os_signal_handler_get(nm) catch nil;
        if handler != nil {
            let j = 0;
            while j < n {
                try handler(nm) catch nil;
                j = j + 1;
                invoked = invoked + 1;
            }
        }
        i = i + 1;
    }
    return invoked;
}

// getenv(key, default) — get env var with fallback
fn getenv(key, default_val) {
    let v = env_get(key);
    if v == nil { return default_val; }
    return v;
}

// require_env(key) — get env var or raise error if missing
fn require_env(key) {
    let v = env_get(key);
    if v == nil {
        return error("Required environment variable not set: " + key);
    }
    return v;
}

// platform() — returns "linux", "windows", "macos", or "unknown"
fn platform() {
    // Best-effort: check PATH separator hint via env
    let path_sep = env_get("PATH");
    if path_sep == nil { return "unknown"; }
    // Windows uses semicolons in PATH; Unix uses colons
    if str_contains(path_sep, ";") { return "windows"; }
    // Check for macOS via OSTYPE or common macOS env
    let ostype = env_get("OSTYPE");
    if ostype != nil and str_contains(ostype, "darwin") { return "macos"; }
    return "linux";
}

// home_dir() — return user home directory
fn home_dir() {
    let h = env_get("HOME");
    if h != nil { return h; }
    return env_get("USERPROFILE");
}

// temp_dir() — return system temp directory
fn temp_dir() {
    let t = env_get("TMPDIR");
    if t != nil { return t; }
    let t2 = env_get("TEMP");
    if t2 != nil { return t2; }
    let t3 = env_get("TMP");
    if t3 != nil { return t3; }
    return "/tmp";
}

// _is_safe_cmd(cmd) — validate that cmd is a single bare executable name
// (no spaces, no shell metacharacters). Returns true if safe.
fn _is_safe_cmd(cmd) {
    if type(cmd) != "string" { return false; }
    if len(cmd) == 0 { return false; }
    // Reject anything with shell metacharacters or path separators
    let banned = [" ", "\t", "\n", ";", "&", "|", ">", "<", "`", "$",
                  "(", ")", "{", "}", "!", "#", "~", "'", "\"",
                  "\\", "/"];
    for i len(banned) {
        if str_contains(cmd, banned[i]) { return false; }
    }
    return true;
}

// which(cmd) — find executable in PATH.
// SECURITY: uses the os_which builtin (safe argument passing) instead of
// string-concatenating cmd into a shell command to prevent command injection.
fn which(cmd) {
    if _is_safe_cmd(cmd) == false {
        return error("os.which: unsafe command name: " + str(cmd));
    }
    // Use os_which builtin if available (passes cmd as argv, not shell string)
    let result = try os_which(cmd) catch nil;
    if result != nil { return str_trim(result); }
    // Fallback: try exec with explicit platform command (safe: cmd validated above)
    let p = platform();
    if p == "windows" {
        result = try exec("where " + cmd) catch nil;
    } else {
        result = try exec("which " + cmd) catch nil;
    }
    if result == nil { return nil; }
    return str_trim(result);
}

// is_executable(path) — check if a file is executable.
// SECURITY: was `exec("test -x " + path + ...)` which string-concatenates `path` into
// a shell command (command injection, e.g. path = "x; rm -rf ~"). Now uses argv-based
// proc_spawn_wait so the path can never be interpreted by a shell.
fn is_executable(path) {
    if type(path) != "string" or len(path) == 0 { return false; }
    let r = try proc_spawn_wait("test", ["-x", path]) catch nil;
    if r == nil { return false; }
    let ec = try r.exit_code catch 1;
    return ec == 0;
}

// Platform predicates derived from platform().
fn is_linux()   { return platform() == "linux"; }
fn is_windows() { return platform() == "windows"; }
fn is_macos()   { return platform() == "macos"; }

// path_sep() — PATH list separator for the platform (":" unix, ";" windows).
fn path_sep() { if is_windows() { return ";"; } return ":"; }

// line_sep() — newline convention for the platform.
fn line_sep() { if is_windows() { return "\r\n"; } return "\n"; }

// username() — best-effort current user from the environment.
fn username() {
    let u = env_get("USER");
    if u != nil { return u; }
    return env_get("USERNAME");
}

// cpu_count() — logical CPU count (via hwinfo); fail-safe to 1.
fn cpu_count() {
    let hw = try import("stdlib:hwinfo.sapp") catch nil;
    if hw == nil { return 1; }
    let c = try hw.cpu() catch nil;
    if c == nil { return 1; }
    let n = try c.logical_cores catch nil;
    if n == nil or n < 1 { return 1; }
    return n;
}

export cwd, exec, sleep_ms, env_get, env_set, args, script_args, script_args_from, exit, signal_trap,
       signal_pending, signal_poll, signal_dispatch,
       getenv, require_env, platform, home_dir, temp_dir, which,
       is_executable, _is_safe_cmd,
       is_linux, is_windows, is_macos, path_sep, line_sep, username, cpu_count;
