// stdlib/os.sapp — Operating system utilities.

let cwd       = cwd;
let exec      = exec;
let sleep_ms  = sleep_ms;
let env_get   = env_get;
let env_set   = env_set;

// args() — CLI arguments passed after -- on the command line
fn args() { return os_args(); }

// exit(code) — exit the process
fn exit(code) { return os_exit(code); }

// signal_trap(sig, handler_fn) — register signal handler (stub on unsupported platforms)
fn signal_trap(sig, handler_fn) {
    let result = try os_signal_trap(sig, handler_fn) catch nil;
    if result == nil {
        return map{ error: "signal_trap not available on this platform" };
    }
    return result;
}

// getenv(key, default) — get env var with fallback
fn getenv(key, default_val) {
    let v = env_get(key);
    if v == nil { return default_val; }
    return v;
}

// require_env(key) — get env var or raise error if missing
fn require_env(key) {
    let v = env_get(key);
    if v == nil {
        return error("Required environment variable not set: " + key);
    }
    return v;
}

// platform() — returns "linux", "windows", "macos", or "unknown"
fn platform() {
    // Best-effort: check PATH separator hint via env
    let path_sep = env_get("PATH");
    if path_sep == nil { return "unknown"; }
    // Windows uses semicolons in PATH; Unix uses colons
    if str_contains(path_sep, ";") { return "windows"; }
    // Check for macOS via OSTYPE or common macOS env
    let ostype = env_get("OSTYPE");
    if ostype != nil and str_contains(ostype, "darwin") { return "macos"; }
    return "linux";
}

// home_dir() — return user home directory
fn home_dir() {
    let h = env_get("HOME");
    if h != nil { return h; }
    return env_get("USERPROFILE");
}

// temp_dir() — return system temp directory
fn temp_dir() {
    let t = env_get("TMPDIR");
    if t != nil { return t; }
    let t2 = env_get("TEMP");
    if t2 != nil { return t2; }
    let t3 = env_get("TMP");
    if t3 != nil { return t3; }
    return "/tmp";
}

// which(cmd) — find executable in PATH (simplified: just tries exec)
fn which(cmd) {
    let result = try exec("which " + cmd) catch nil;
    if result == nil { return nil; }
    return str_trim(result);
}

export cwd, exec, sleep_ms, env_get, env_set, args, exit, signal_trap,
       getenv, require_env, platform, home_dir, temp_dir, which;
