// stdlib/logger.sapp — Structured logger with levels (debug/info/warn/error)
//
// Usage:
//   let log = import("stdlib:logger.sapp");
//   let l = log.new("MyApp");            // follows the global level
//   let v = log.new("Worker", "debug");  // per-instance level override
//   l.info("Server started");
//   l.warn("High memory usage: " + str(mem));
//   l.error("Connection failed");
//   log.set_level("warn"); // suppress debug and info globally
//
// For structured fields / JSON / redaction use stdlib:log.sapp; this module
// stays the tiny name-prefixed console logger.

let _logmod = import("stdlib:log.sapp");

// Global log level: 0=debug, 1=info, 2=warn, 3=error
let _level = 1;  // default: INFO

fn _level_num(lvl) {
    if lvl == "debug" { return 0; }
    if lvl == "info"  { return 1; }
    if lvl == "warn"  { return 2; }
    if lvl == "error" { return 3; }
    return 1;  // unknown → info
}

fn _level_tag(lvl) {
    if lvl == "debug" { return "[DEBUG]"; }
    if lvl == "info"  { return "[INFO] "; }
    if lvl == "warn"  { return "[WARN] "; }
    if lvl == "error" { return "[ERROR]"; }
    return "[LOG]  ";
}

// set_level(lvl) — set global minimum log level ("debug","info","warn","error")
fn set_level(lvl) {
    _level = _level_num(lvl);
}

// get_level() → string
fn get_level() {
    if _level == 0 { return "debug"; }
    if _level == 1 { return "info"; }
    if _level == 2 { return "warn"; }
    return "error";
}

// format_line(name, lvl, msg) → the exact line _log would print. Pure and
// injection-safe: the message is sanitized so a newline can't forge entries.
fn format_line(name, lvl, msg) {
    let tag = _level_tag(lvl);
    let ts = try str(now_ms()) catch "?";
    return tag + " " + ts + " [" + name + "] " + _logmod.sanitize(msg);
}

// _log(name, lvl, msg, own_level) — internal log emitter; own_level (number
// or nil) is the per-instance threshold override.
fn _log(name, lvl, msg, own_level = nil) {
    let threshold = _level;
    if own_level != nil { threshold = own_level; }
    let num = _level_num(lvl);
    if num < threshold { return nil; }
    print format_line(name, lvl, msg);
}

// new(name, level) → logger object. `level` ("debug".."error") pins THIS
// logger's threshold; nil follows the global level live.
fn new(name, level = nil) {
    let logger = map{};
    logger.name = name;
    logger.level = level;
    let own = nil;
    if level != nil { own = _level_num(level); }

    logger.debug = fn(msg) { _log(name, "debug", msg, own); };
    logger.info  = fn(msg) { _log(name, "info",  msg, own); };
    logger.warn  = fn(msg) { _log(name, "warn",  msg, own); };
    logger.error = fn(msg) { _log(name, "error", msg, own); };

    // log(level, msg) — dynamic level dispatch
    logger.log = fn(lvl, msg) { _log(name, lvl, msg, own); };

    // enabled(lvl) — would a message at lvl be emitted right now?
    logger.enabled = fn(lvl) {
        let threshold = _level;
        if own != nil { threshold = own; }
        return _level_num(lvl) >= threshold;
    };

    // child(sub_name) — child logger with prefixed name; inherits this
    // logger's instance level (nil = keeps following the global level)
    logger.child = fn(sub) { return new(name + "." + sub, level); };

    return logger;
}

// A convenience global "root" logger
let root = new("root");

export new, set_level, get_level, root, format_line;
