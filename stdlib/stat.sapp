// stdlib/stat.sapp — Statistics: mean, median, mode, std dev, variance, percentiles
//
// Usage:
//   let stat = import("stdlib:stat.sapp");
//   let m = stat.mean([1,2,3,4,5]);
//   let med = stat.median([3,1,4,1,5]);
//   print stat.std_dev(data);

// mean(arr) → arithmetic mean
fn mean(arr) {
    if len(arr) == 0 { return nil; }
    return sum(arr) / len(arr);
}

// median(arr) → middle value (sorts a copy)
fn median(arr) {
    let n = len(arr);
    if n == 0 { return nil; }
    let sorted = array_sort(arr);
    if num_mod(n, 2) == 1 {
        return sorted[num_floor(n / 2)];
    }
    let mid = n / 2;
    return (sorted[mid - 1] + sorted[mid]) / 2;
}

// mode(arr) → most frequent value (first one if tie)
fn mode(arr) {
    if len(arr) == 0 { return nil; }
    let counts = map{};
    let i = 0;
    while i < len(arr) {
        let k = str(arr[i]);
        if map_has(counts, k) { counts[k] = counts[k] + 1; }
        else { counts[k] = 1; }
        i = i + 1;
    }
    let best_key = nil;
    let best_cnt = 0;
    let ks = map_keys(counts);
    let j = 0;
    while j < len(ks) {
        if counts[ks[j]] > best_cnt {
            best_cnt = counts[ks[j]];
            best_key = ks[j];
        }
        j = j + 1;
    }
    // Find original value matching best_key
    let k2 = 0;
    while k2 < len(arr) {
        if str(arr[k2]) == best_key { return arr[k2]; }
        k2 = k2 + 1;
    }
    return nil;
}

// variance(arr) → population variance
fn variance(arr) {
    let n = len(arr);
    if n == 0 { return nil; }
    let m = mean(arr);
    let sq_sum = 0;
    let i = 0;
    while i < len(arr) {
        let d = arr[i] - m;
        sq_sum = sq_sum + d * d;
        i = i + 1;
    }
    return sq_sum / n;
}

// sample_variance(arr) → sample variance (Bessel's correction, n-1)
fn sample_variance(arr) {
    let n = len(arr);
    if n < 2 { return nil; }
    let m = mean(arr);
    let sq_sum = 0;
    let i = 0;
    while i < len(arr) {
        let d = arr[i] - m;
        sq_sum = sq_sum + d * d;
        i = i + 1;
    }
    return sq_sum / (n - 1);
}

// std_dev(arr) → population standard deviation
fn std_dev(arr) {
    let v = variance(arr);
    if v == nil { return nil; }
    return num_sqrt(v);
}

// sample_std_dev(arr) → sample standard deviation
fn sample_std_dev(arr) {
    let v = sample_variance(arr);
    if v == nil { return nil; }
    return num_sqrt(v);
}

// percentile(arr, p) → p-th percentile (0-100)
fn percentile(arr, p) {
    let n = len(arr);
    if n == 0 { return nil; }
    let sorted = array_sort(arr);
    if p <= 0 { return sorted[0]; }
    if p >= 100 { return sorted[n - 1]; }
    let rank = (p / 100) * (n - 1);
    let lo_idx = num_floor(rank);
    let hi_idx = lo_idx + 1;
    if hi_idx >= n { return sorted[n - 1]; }
    let frac = rank - lo_idx;
    return sorted[lo_idx] + frac * (sorted[hi_idx] - sorted[lo_idx]);
}

// iqr(arr) → interquartile range (Q3 - Q1)
fn iqr(arr) {
    let q1 = percentile(arr, 25);
    let q3 = percentile(arr, 75);
    if q1 == nil or q3 == nil { return nil; }
    return q3 - q1;
}

// zscore(arr) → array of z-scores
fn zscore(arr) {
    let m = mean(arr);
    let s = std_dev(arr);
    if m == nil or s == nil or s == 0 { return nil; }
    let result = [];
    let i = 0;
    while i < len(arr) {
        array_push(result, (arr[i] - m) / s);
        i = i + 1;
    }
    return result;
}

// correlation(x, y) → Pearson correlation coefficient
fn correlation(x, y) {
    let n = len(x);
    if n != len(y) or n == 0 { return nil; }
    let mx = mean(x);
    let my = mean(y);
    let num = 0;
    let dx2 = 0;
    let dy2 = 0;
    let i = 0;
    while i < n {
        let dx = x[i] - mx;
        let dy = y[i] - my;
        num = num + dx * dy;
        dx2 = dx2 + dx * dx;
        dy2 = dy2 + dy * dy;
        i = i + 1;
    }
    let denom = num_sqrt(dx2 * dy2);
    if denom == 0 { return 0; }
    return num / denom;
}

// describe(arr) → map with summary statistics
fn describe(arr) {
    return map{
        count: len(arr),
        mean: mean(arr),
        median: median(arr),
        std_dev: std_dev(arr),
        min: min_of(arr),
        max: max_of(arr),
        p25: percentile(arr, 25),
        p75: percentile(arr, 75)
    };
}

// covariance(x, y) — population covariance.
fn covariance(x, y) {
    let n = len(x);
    if n != len(y) or n == 0 { return nil; }
    let mx = mean(x);
    let my = mean(y);
    let s = 0;
    let i = 0;
    while i < n { s = s + (x[i] - mx) * (y[i] - my); i = i + 1; }
    return s / n;
}

// linear_regression(x, y) → { slope, intercept, r2 } — ordinary least squares.
fn linear_regression(x, y) {
    let n = len(x);
    if n != len(y) or n < 2 { return nil; }
    let mx = mean(x);
    let my = mean(y);
    let sxx = 0;
    let sxy = 0;
    let i = 0;
    while i < n {
        let dx = x[i] - mx;
        sxx = sxx + dx * dx;
        sxy = sxy + dx * (y[i] - my);
        i = i + 1;
    }
    if sxx == 0 { return nil; }
    let slope = sxy / sxx;
    let intercept = my - slope * mx;
    let r = correlation(x, y);
    return map{ slope: slope, intercept: intercept, r2: r * r };
}

// geometric_mean(arr) — nth root of the product (positive values only).
fn geometric_mean(arr) {
    let n = len(arr);
    if n == 0 { return nil; }
    let s = 0;
    let i = 0;
    while i < n {
        if arr[i] <= 0 { return error("stat: geometric_mean needs positive values"); }
        s = s + num_ln(arr[i]);
        i = i + 1;
    }
    return num_exp(s / n);
}

// harmonic_mean(arr) — n / sum(1/x_i) (non-zero values).
fn harmonic_mean(arr) {
    let n = len(arr);
    if n == 0 { return nil; }
    let s = 0;
    let i = 0;
    while i < n {
        if arr[i] == 0 { return error("stat: harmonic_mean undefined with zero"); }
        s = s + 1 / arr[i];
        i = i + 1;
    }
    return n / s;
}

// range(arr) — max - min.
fn range(arr) {
    if len(arr) == 0 { return nil; }
    return max_of(arr) - min_of(arr);
}

// quartiles(arr) → { q1, q2, q3 }.
fn quartiles(arr) {
    return map{ q1: percentile(arr, 25), q2: percentile(arr, 50), q3: percentile(arr, 75) };
}

// weighted_mean(values, weights) — sum(v*w) / sum(w).
fn weighted_mean(values, weights) {
    let n = len(values);
    if n != len(weights) or n == 0 { return nil; }
    let sw = 0;
    let swv = 0;
    let i = 0;
    while i < n { swv = swv + values[i] * weights[i]; sw = sw + weights[i]; i = i + 1; }
    if sw == 0 { return nil; }
    return swv / sw;
}

export mean, median, mode, variance, sample_variance, std_dev, sample_std_dev,
       percentile, iqr, zscore, correlation, describe,
       covariance, linear_regression, geometric_mean, harmonic_mean,
       range, quartiles, weighted_mean;
