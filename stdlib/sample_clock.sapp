// Relative time from caller-supplied wrapping counters; no clocks or device I/O.
fn _integer(value,low,high) {return type(value)=="number" and value==value and value-value==0 and value>=low and value<=high and num_floor(value)==value;}
fn timeline(ticks,bits,max_step) {
 if not _integer(bits,8,32) {throw "sample clock: invalid counter width";}
 let modulus=1;for i in range(0,bits) {modulus=modulus*2;}
 if not _integer(max_step,1,modulus/2-1) {throw "sample clock: invalid forward-step bound";}
 if type(ticks)!="array" or len(ticks)<1 or len(ticks)>256 {throw "sample clock: invalid sample count";}
 for tick in ticks {if not _integer(tick,0,modulus-1) {throw "sample clock: invalid counter value";}}
 let elapsed=[0];let deltas=[];let total=0;let wraps=0;
 for i in range(1,len(ticks)) {
  let delta=ticks[i]-ticks[i-1];if delta<0 {delta=delta+modulus;}
  if delta<1 or delta>max_step {throw "sample clock: duplicate or ambiguous step";}
  if ticks[i]<ticks[i-1] {wraps=wraps+1;}
  total=total+delta;array_push(elapsed,total);array_push(deltas,delta);
 }
 return map{format:"pblang.sample-clock.v1",elapsed_ticks:elapsed,deltas:deltas,total_ticks:total,inferred_wraps:wraps,assumes_forward_clock:true,raw_counters_included:false,physical_verified:false};
}
// Errors are observed interval minus expected interval, in caller-defined ticks.
fn period_review(ticks,bits,max_step,expected_step) {
 let clock=timeline(ticks,bits,max_step);
 if not _integer(expected_step,1,max_step) {throw "sample clock: invalid expected period";}
 let errors=[];let absolute=0;let squares=0;let maximum=0;
 for delta in clock.deltas {
  let error=delta-expected_step;let magnitude=num_abs(error);
  array_push(errors,error);absolute=absolute+magnitude;squares=squares+error*error;
  if magnitude>maximum {maximum=magnitude;}
 }
 let count=len(errors);
 return map{format:"pblang.sample-period-review.v1",interval_count:count,errors_ticks:errors,mean_abs_error_ticks:if count>0 {absolute/count} else {nil},rms_error_ticks:if count>0 {num_sqrt(squares/count)} else {nil},max_abs_error_ticks:if count>0 {maximum} else {nil},inferred_wraps:clock.inferred_wraps,missing_samples_inferred:false,clock_reset_verified:false,physical_verified:false};
}
export timeline,period_review;
