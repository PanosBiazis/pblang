// stdlib/zipfile.sapp — ZIP archive reader/writer in pure pblang.
//
// Built on stdlib:flate.sapp (pure-pblang DEFLATE), so pblang reads and writes
// .zip archives with zero external dependencies. Reader parses the central
// directory (the authoritative record), supports STORED (0) and DEFLATED (8)
// entries, and verifies each entry's CRC32. Writer picks DEFLATE per entry and
// falls back to STORED when compression doesn't help.
//
// Security: extract() refuses zip-slip names (absolute paths, `..` segments,
// backslash tricks, NUL bytes) and read()/extract() take an optional per-entry
// max_out byte cap as a decompression-bomb guard. Parsing also rejects ZIP64,
// encryption, trailing data, and inconsistent central/local headers.
//
//   let Z = import("stdlib:zipfile.sapp");
//   Z.entries(bytes);                 // [{name,size,csize,method,crc,offset}]
//   Z.read(bytes, "a/b.txt");         // byte array, CRC-checked
//   Z.extract(bytes, "/tmp/out");     // safe extraction, returns written paths
//   Z.create([map{name:"a.txt", data:str_to_bytes("hi")}]);   // zip bytes

let F = import("stdlib:flate.sapp");

fn _as_bytes(data) { if type(data) == "string" { return str_to_bytes(data); } return data; }
fn _u16(b, i) { return b[i] + b[i + 1] * 256; }
fn _u32(b, i) { return b[i] + b[i + 1] * 256 + b[i + 2] * 65536 + b[i + 3] * 16777216; }
fn _push_u16(out, v) {
    array_push(out, bit_and(v, 255));
    array_push(out, bit_and(bit_shr(v, 8), 255));
    return nil;
}
fn _push_u32(out, v) {
    array_push(out, bit_and(v, 255));
    array_push(out, bit_and(bit_shr(v, 8), 255));
    array_push(out, bit_and(bit_shr(v, 16), 255));
    array_push(out, bit_and(bit_shr(v, 24), 255));
    return nil;
}
fn _name_at(b, i, n) {
    let s = [];
    let k = 0;
    while k < n { array_push(s, b[i + k]); k = k + 1; }
    return bytes_to_str(s);
}

// ── central directory ────────────────────────────────────────────────────────
fn _find_eocd(b) {
    let n = len(b);
    if n < 22 { error("zipfile: data too short"); }
    let i = n - 22;
    let stop = n - 22 - 65535;
    if stop < 0 { stop = 0; }
    while i >= stop {
        if b[i] == 80 and b[i + 1] == 75 and b[i + 2] == 5 and b[i + 3] == 6 and
           i + 22 <= n and i + 22 + _u16(b, i + 20) == n { return i; }
        i = i - 1;
    }
    return error("zipfile: end-of-central-directory not found (not a zip?)");
}

// entries(data) — list the archive's central-directory entries.
fn entries_bounded(data, max_entries) {
    let b = _as_bytes(data);
    let e = _find_eocd(b);
    let count = _u16(b, e + 10);
    if type(max_entries) != "number" or num_floor(max_entries) != max_entries or
       max_entries < 0 or max_entries > 65535 { error("zipfile: invalid max_entries cap"); }
    if count > max_entries { error("zipfile: entry count exceeds max_entries cap"); }
    if _u16(b, e + 4) != 0 or _u16(b, e + 6) != 0 or _u16(b, e + 8) != count {
        error("zipfile: multi-disk archives are unsupported");
    }
    let central_size = _u32(b, e + 12);
    let p = _u32(b, e + 16);
    let central_start = p;
    let central_end = p + central_size;
    if count == 65535 or central_size == 4294967295 or p == 4294967295 {
        error("zipfile: ZIP64 archives are unsupported");
    }
    if p + central_size != e or p + central_size > len(b) {
        error("zipfile: central directory range is invalid");
    }
    let out = [];
    let k = 0;
    while k < count {
        if p + 46 > central_end { error("zipfile: truncated central directory"); }
        if b[p] != 80 or b[p + 1] != 75 or b[p + 2] != 1 or b[p + 3] != 2 {
            error("zipfile: bad central directory signature");
        }
        let nlen = _u16(b, p + 28);
        let elen = _u16(b, p + 30);
        let clen = _u16(b, p + 32);
        if p + 46 + nlen + elen + clen > len(b) or p + 46 + nlen + elen + clen > central_end {
            error("zipfile: truncated central directory entry");
        }
        if _u16(b, p + 34) != 0 { error("zipfile: entry on another disk"); }
        if _u32(b,p+20)==4294967295 or _u32(b,p+24)==4294967295 or _u32(b,p+42)==4294967295 {
            error("zipfile: ZIP64 entry unsupported");
        }
        array_push(out, map{
            data_limit: central_start,
            name: _name_at(b, p + 46, nlen),
            flags: _u16(b, p + 8),
            method: _u16(b, p + 10),
            crc: _u32(b, p + 16),
            csize: _u32(b, p + 20),
            size: _u32(b, p + 24),
            offset: _u32(b, p + 42),
            mode: bit_shr(_u32(b, p + 38), 16),
        });
        p = p + 46 + nlen + elen + clen;
        k = k + 1;
    }
    if p != central_end { error("zipfile: central directory size mismatch"); }
    return out;
}

// entries(data) preserves the original API while entries_bounded lets servers
// reject adversarial entry counts before allocating the result array.
fn entries(data) { return entries_bounded(data, 65535); }

fn _read_entry(b, ent, max_out) {
    for field in ["offset", "size", "csize", "flags", "method", "crc"] {
        let value = ent[field];
        if type(value) != "number" or not (value >= 0 and value <= 4294967295) or
           num_floor(value) != value { error("zipfile: invalid entry integer"); }
    }
    if max_out != nil and (type(max_out) != "number" or not (max_out >= 0 and max_out <= 4294967295) or
       num_floor(max_out) != max_out) { error("zipfile: invalid max_out cap"); }
    if max_out != nil and ent.size > max_out { error("zipfile: entry exceeds max_out cap"); }
    let limit = try ent.data_limit catch len(b);
    if type(limit)!="number" or not (limit>=0 and limit<=len(b)) or num_floor(limit)!=limit {
        error("zipfile: invalid data boundary");
    }
    let p = ent.offset;
    if p + 30 > limit { error("zipfile: truncated local header"); }
    if b[p] != 80 or b[p + 1] != 75 or b[p + 2] != 3 or b[p + 3] != 4 {
        error("zipfile: bad local header signature");
    }
    let local_flags = _u16(b, p + 6);
    let flags = try ent.flags catch 0;
    if bit_and(flags, 1) != 0 or bit_and(local_flags, 1) != 0 {
        error("zipfile: encrypted entries are unsupported");
    }
    if bit_and(flags, 63473) != 0 { error("zipfile: unsupported entry flags"); }
    if local_flags != flags { error("zipfile: local/central flag mismatch"); }
    if _u16(b, p + 8) != ent.method { error("zipfile: local/central method mismatch"); }
    let nlen = _u16(b, p + 26);
    let elen = _u16(b, p + 28);
    if p + 30 + nlen + elen > limit { error("zipfile: truncated local header fields"); }
    if _name_at(b, p + 30, nlen) != ent.name { error("zipfile: local/central name mismatch"); }
    if bit_and(flags, 8) == 0 and (_u32(b, p + 14) != ent.crc or
       _u32(b, p + 18) != ent.csize or _u32(b, p + 22) != ent.size) {
        error("zipfile: local/central size or CRC mismatch");
    }
    let dp = p + 30 + nlen + elen;
    if dp + ent.csize > limit { error("zipfile: truncated entry data"); }
    if bit_and(flags,8)!=0 {
        let descriptor = dp + ent.csize;
        if descriptor+4<=limit and _u32(b,descriptor)==134695760 { descriptor=descriptor+4; }
        if descriptor+12>limit or _u32(b,descriptor)!=ent.crc or
           _u32(b,descriptor+4)!=ent.csize or _u32(b,descriptor+8)!=ent.size {
            error("zipfile: invalid data descriptor");
        }
    }
    let out = [];
    if ent.method == 0 {
        if ent.csize != ent.size { error("zipfile: stored size mismatch"); }
        out = [];
        let k = 0;
        while k < ent.csize { array_push(out, b[dp + k]); k = k + 1; }
    } else {
        if ent.method != 8 { error("zipfile: unsupported method " + str(ent.method)); }
        out = F.inflate(slice(b, dp, dp + ent.csize), ent.size, true);
    }
    if len(out) != ent.size { error("zipfile: size mismatch for " + ent.name); }
    if F.crc32(out) != ent.crc { error("zipfile: CRC32 mismatch for " + ent.name); }
    return out;
}

// read(data, name, max_out?) — decompress one entry, CRC-verified.
fn read(data, name, max_out = nil) {
    let b = _as_bytes(data);
    let es = entries(b);
    let i = 0;
    while i < len(es) {
        if es[i].name == name { return _read_entry(b, es[i], max_out); }
        i = i + 1;
    }
    return error("zipfile: no entry named " + name);
}

// read_entry(data, entry, max_out?) avoids a second name lookup after callers
// have already performed a bounded central-directory pass. The supplied entry
// is still validated against the local header, exact size and CRC32.
fn read_entry(data, entry, max_out = nil) {
    if type(entry) != "map" or type(try entry.name catch nil) != "string" or
       type(try entry.offset catch nil) != "number" or
       type(try entry.size catch nil) != "number" or
       type(try entry.csize catch nil) != "number" or
       type(try entry.flags catch nil) != "number" or
       type(try entry.method catch nil) != "number" or
       type(try entry.crc catch nil) != "number" {
        error("zipfile: invalid entry descriptor");
    }
    return _read_entry(_as_bytes(data), entry, max_out);
}

// read_all(data, max_each?) — map of name -> bytes for every file entry.
fn read_all(data, max_each = nil) {
    let b = _as_bytes(data);
    let es = entries(b);
    let out = map{};
    let i = 0;
    while i < len(es) {
        let e = es[i];
        if not _is_dir_name(e.name) { out[e.name] = _read_entry(b, e, max_each); }
        i = i + 1;
    }
    return out;
}

// ── safe extraction ──────────────────────────────────────────────────────────
fn _is_dir_name(name) {
    return len(name) > 0 and name[len(name) - 1] == "/";
}

// _safe_name(name) — nil when the entry name is a traversal attempt.
fn _safe_name(name) {
    if len(name) == 0 { return nil; }
    let norm = "";
    let i = 0;
    while i < len(name) {
        let c = name[i];
        if c == str_from_char_code(0) { return nil; }
        if c == str_from_char_code(92) { norm = norm + "/"; } else { norm = norm + c; }
        i = i + 1;
    }
    if norm[0] == "/" { return nil; }
    // reject drive-letter prefixes like C:
    if len(norm) >= 2 and norm[1] == ":" { return nil; }
    let seg = "";
    i = 0;
    while i <= len(norm) {
        let end = i == len(norm);
        if end or norm[i] == "/" {
            if seg == ".." { return nil; }
            seg = "";
        } else { seg = seg + norm[i]; }
        i = i + 1;
    }
    return norm;
}

fn sanitize_path(path) {
    if type(path) != "string" or path == "" or len(path) > 4096
        or str_contains(path, strfromcharcode(0)) {
        error("zipfile: invalid extraction destination");
    }
    return path;
}

// extract(data, dest_dir, max_each?) — write all entries under dest_dir.
// Refuses zip-slip names; returns the list of written paths.
fn extract(data, dest_dir, max_each = nil) {
    let SecureFile = import("stdlib:secure_file.sapp");
    let b = _as_bytes(data);
    let es = entries(b);
    let written = [];
    let i = 0;
    while i < len(es) {
        let e = es[i];
        let safe = _safe_name(e.name);
        if safe == nil { error("zipfile: unsafe entry name refused: " + e.name); }
        if not _is_dir_name(safe) {
            let path = sanitize_path(dest_dir + "/" + safe);
            let stored = SecureFile.write_new_exclusive(
                path, _read_entry(b, e, max_each), true, false);
            if not stored.ok { error("zipfile: secure exclusive extraction failed"); }
            array_push(written, path);
        }
        i = i + 1;
    }
    return written;
}

// ── writer ───────────────────────────────────────────────────────────────────
fn _push_all(out, arr) {
    let i = 0;
    while i < len(arr) { array_push(out, arr[i]); i = i + 1; }
    return nil;
}

// create(files) — files: [map{name, data}]. DEFLATE per entry, STORED when
// compression doesn't shrink it. Returns the archive as a byte array.
fn create(files, mode = "auto") {
    if mode != "auto" and mode != "fast" and mode != "store" { error("zipfile: unsupported compression mode"); }
    let out = [];
    let centrals = [];
    let i = 0;
    while i < len(files) {
        let name = files[i].name;
        let data = _as_bytes(files[i].data);
        let nameb = str_to_bytes(name);
        let crc = F.crc32(data);
        let method = 8;
        let payload = data;
        if mode == "fast" { payload = F.deflate_fast(data); }
        else if mode == "auto" { payload = F.deflate(data); }
        if len(payload) >= len(data) { method = 0; payload = data; }
        let offset = len(out);
        _push_all(out, [80, 75, 3, 4, 20, 0, 0, 8]);
        _push_u16(out, method);
        _push_u32(out, 0);   // mod time + date
        _push_u32(out, crc);
        _push_u32(out, len(payload));
        _push_u32(out, len(data));
        _push_u16(out, len(nameb));
        _push_u16(out, 0);
        _push_all(out, nameb);
        _push_all(out, payload);
        let c = [80, 75, 1, 2, 20, 3, 20, 0, 0, 8];
        _push_u16(c, method);
        _push_u32(c, 0);
        _push_u32(c, crc);
        _push_u32(c, len(payload));
        _push_u32(c, len(data));
        _push_u16(c, len(nameb));
        _push_u16(c, 0);   // extra len
        _push_u16(c, 0);   // comment len
        _push_u16(c, 0);   // disk number
        _push_u16(c, 0);   // internal attrs
        let permissions = 33188;
        if _is_dir_name(name) { permissions = 16877; }
        _push_u32(c, permissions * 65536);   // external attrs: Unix -rw-r--r-- (0100644)
        _push_u32(c, offset);
        _push_all(c, nameb);
        array_push(centrals, c);
        i = i + 1;
    }
    let cd_off = len(out);
    i = 0;
    while i < len(centrals) { _push_all(out, centrals[i]); i = i + 1; }
    let cd_size = len(out) - cd_off;
    _push_all(out, [80, 75, 5, 6, 0, 0, 0, 0]);
    _push_u16(out, len(files));
    _push_u16(out, len(files));
    _push_u32(out, cd_size);
    _push_u32(out, cd_off);
    _push_u16(out, 0);
    return out;
}

// ── file helpers ─────────────────────────────────────────────────────────────
// create_file(path, files) — write a zip to disk; returns byte count.
fn create_file(path, files) {
    let blob = create(files);
    fs_write_bytes(path, blob);
    return len(blob);
}
// extract_file(path, dest_dir, max_each?) — extract a zip file from disk.
fn extract_file(path, dest_dir, max_each = nil) {
    return extract(fs_read_bytes(path), dest_dir, max_each);
}
// list_file(path) — entries() of a zip file on disk.
fn list_file(path) { return entries(fs_read_bytes(path)); }

export entries, entries_bounded, read, read_entry, read_all, extract, create, create_file, extract_file, list_file;
