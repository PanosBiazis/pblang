                let sym=_call(s.x,"XkbKeycodeToKeysym",[s.display,code,group,level]);
                if num_floor(state/2)%2==1 {sym=_call(s.k,if shift {"xkb_keysym_to_lower"} else {"xkb_keysym_to_upper"},[sym]);}
                let key=try s.pressed[id] catch nil;
                if key==nil {key=_key(s,base_sym,code);}
                let ctrl=num_floor(state/4)%2==1;let alt=num_floor(state/8)%2==1;let meta=num_floor(state/64)%2==1;
                let event=map{type:if kind==2 {"keydown"} else {"keyup"},key:key,shift:shift,ctrl:ctrl,alt:alt,meta:meta};
                if kind==2 {
                    s.pressed[id]=key;let cp=_call(s.k,"xkb_keysym_to_utf32",[sym]);
                    event.text=if not ctrl and not meta and not alt and num_floor(state/128)%2==0 and cp>=32 and cp<=1114111 and not (cp>=127 and cp<=159) and not (cp>=55296 and cp<=57343) {strfromcharcode(cp)} else {""};
                } elif map_has(s.pressed,id) {map_remove(s.pressed,id);}
