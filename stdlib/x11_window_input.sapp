fn _key(s,sym,code) {

    let name=ffi_call_typed(s.x,"XKeysymToString","i64->string",[sym]);
    if type(name)=="string" and map_has(_KEY_NAMES,name) {return _KEY_NAMES[name];}
    let cp=_call(s.k,"xkb_keysym_to_utf32",[sym]);
    if cp>=97 and cp<=122 {return strfromcharcode(cp-32);}
    if cp>=32 and cp<=126 {return strfromcharcode(cp);}
    if type(name)=="string" and name!="" {return name;}
    return "X11Key"+str(code);
}
fn poll(s) {
    if s==nil or s.closed {return [];}let events=[];let count=0;
    while count<64 and _call(s.x,"XPending",[s.display])>0 {
        _call(s.x,"XNextEvent",[s.display,s.buffer]);let data=_snapshot(s,s.buffer,192);count=count+1;
        let kind=_word(data,0,4);
        if kind==34 {_call(s.x,"XRefreshKeyboardMapping",[s.buffer]);}
        if _word(data,32,8)==s.window {
            if kind==10 {
                for code in map_keys(s.pressed) {push(events,map{type:"keyup",key:s.pressed[code],shift:false,ctrl:false,alt:false,meta:false});}
                s.pressed=map{};
            } elif (kind==2 or kind==3) and _word(data,16,4)==0 {
                let state=_word(data,80,4);let code=_word(data,84,4);
                if code<8 or code>255 {continue;}let id=str(code);
                let group=num_floor(state/8192)%4;let shift=state%2==1;
                let base_sym=_call(s.x,"XkbKeycodeToKeysym",[s.display,code,group,0]);
                let level=if shift {1} else {0};
