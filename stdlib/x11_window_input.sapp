let _KEY_NAMES=map{"BackSpace":"Backspace","Return":"Enter","KP_Enter":"Enter","space":"Space","Shift_L":"LeftShift","Shift_R":"RightShift","Control_L":"LeftCtrl","Control_R":"RightCtrl","Alt_L":"LeftAlt","Alt_R":"RightAlt","Super_L":"LeftSuper","Super_R":"RightSuper","Prior":"PageUp","Next":"PageDown","equal":"Equal","minus":"Minus","KP_Insert":"NumPad0","KP_End":"NumPad1","KP_Down":"NumPad2","KP_Next":"NumPad3","KP_Left":"NumPad4","KP_Begin":"NumPad5","KP_Right":"NumPad6","KP_Home":"NumPad7","KP_Up":"NumPad8","KP_Prior":"NumPad9","KP_Delete":"NumPadDot"};

// Optional ordered input for an owned minifb window, Linux x86_64 X11 only.
// No injection, root keyboard subscription, process execution or native callback.
// LP64 layouts are from Xlib.h, xcbext.h and xproto.h. FFI calls have <=4 args.
// The bounded XCB GetProperty request avoids Xlib's fatal BadWindow handler when
// an unrelated window disappears during the short creation-notification phase.
fn _call(lib,name,args) {
    let sig="";let i=0;while i<len(args) {if sig!="" {sig=sig+",";}sig=sig+"i64";i=i+1;}
    return ffi_call_typed(lib,name,sig+"->i64",args);
}
fn _free(s,p) {if p!=0 {ffi_call_typed(s.c,"free","ptr->void",[p]);}}
fn _word(bytes,offset,count) {
    let value=0;let scale=1;for i in range(count) {value=value+bytes[offset+i]*scale;scale=scale*256;}return value;
}
fn _put(bytes,offset,count,value) {for i in range(count) {bytes[offset+i]=value%256;value=num_floor(value/256);}}
fn _snapshot(s,p,count) {
    assert(count>=0 and count<=192,"X11 input snapshot bound");
    assert(_call(s.c,"ftruncate",[s.fd,0])==0 and _call(s.c,"lseek",[s.fd,0,0])==0,"X11 input snapshot reset");
    assert(_call(s.c,"write",[s.fd,p,count])==count,"X11 input snapshot write");
    let bytes=fs_read_bytes("/proc/self/fd/"+str(s.fd));assert(len(bytes)==count,"X11 input snapshot read");return bytes;
}
fn _owned_name(s,id) {
    // 24-byte descriptor, two reserved iovecs, one iovec, 24-byte request.
    let bytes=[];while len(bytes)<96 {push(bytes,0);}
    _put(bytes,0,8,1);_put(bytes,16,1,20); // one vector; core GetProperty
    _put(bytes,56,8,s.buffer+328);_put(bytes,64,8,24);
    _put(bytes,76,4,id);_put(bytes,80,4,39);_put(bytes,92,4,16); // WM_NAME, max 64 bytes
    fs_write_bytes("/proc/self/fd/"+str(s.fd),bytes);
    assert(_call(s.c,"lseek",[s.fd,0,0])==0 and _call(s.c,"read",[s.fd,s.buffer+256,96])==96,"X11 identity request");
    let cookie=_call(s.cb,"xcb_send_request",[s.connection,1,s.buffer+312,s.buffer+256]);
    if cookie==0 {return false;}
    let reply=_call(s.cb,"xcb_wait_for_reply",[s.connection,cookie,0]);if reply==0 {return false;}
    let matches=try _read_name(s,reply) catch nil;
    _free(s,reply);assert(matches!=nil,"X11 identity read");return matches;
}
fn _read_name(s,reply) {
    let head=_snapshot(s,reply,32);
    if head[0]!=1 or head[1]!=8 or _word(head,12,4)!=0 or _word(head,16,4)!=len(s.nonce) {return false;}
    let name="";for byte in _snapshot(s,reply+32,len(s.nonce)) {name=name+strfromcharcode(byte);}
    return name==s.nonce;
}

fn close(s) {
    if s==nil or s.closed {return true;}s.closed=true;let ok=true;
    if s.connection!=0 {if not (try {ffi_call_typed(s.cb,"xcb_disconnect","ptr->void",[s.connection]);true} catch false) {ok=false;}s.connection=0;}
    if s.display!=0 {if not (try {_call(s.x,"XCloseDisplay",[s.display]);true} catch false) {ok=false;}s.display=0;}
    if s.fd>=0 {if not (try {_call(s.c,"close",[s.fd])==0} catch false) {ok=false;}s.fd=-1;}
    if s.buffer!=0 {if not (try {_free(s,s.buffer);true} catch false) {ok=false;}s.buffer=0;}
    for lib in [s.k,s.cb,s.x,s.c] {if lib!=nil {if not (try {ffi_close(lib);true} catch false) {ok=false;}}}
    s.pressed=map{};return ok;
}
fn open(title) {
    // ASCII titles preserve the old WM_NAME fallback exactly. Other titles,
    // platforms, permissions and missing libraries keep the existing backend.
    if platform()!="linux" or type(title)!="string" or len(title)>128 {return nil;}
    for i in range(len(title)) {let cp=strcharcodeat(title,i);if cp<32 or cp>126 {return nil;}}
    let display=try env_get("DISPLAY") catch nil;
    if type(display)!="string" or not str_starts_with(display,":") {return nil;}
    let s=map{x:nil,c:nil,k:nil,cb:nil,connection:0,display:0,buffer:0,fd:-1,window:0,closed:false,pressed:map{},nonce:""};
    let ok=try _open_owned(s) catch false;
    if not ok {assert(close(s),"X11 input initialization cleanup failed");return nil;}return s;
}
fn _open_owned(s) {
        s.c=ffi_load("/usr/lib/x86_64-linux-gnu/libc.so.6");
        s.x=ffi_load("/usr/lib/x86_64-linux-gnu/libX11.so.6");
        s.cb=ffi_load("/usr/lib/x86_64-linux-gnu/libxcb.so.1");
        s.k=ffi_load("/usr/lib/x86_64-linux-gnu/libxkbcommon.so.0");
        _free(s,0);ffi_call_typed(s.c,"free","ptr->void",[0]);_call(s.c,"close",[-1]);
        assert(_call(s.x,"XInitThreads",[])!=0,"X11 threads");
        s.display=_call(s.x,"XOpenDisplay",[0]);assert(s.display>0,"X11 display");
        s.buffer=_call(s.c,"calloc",[1,512]);assert(s.buffer>0 and s.buffer<9007199254740480,"X11 input allocation");
        s.fd=ffi_call_typed(s.c,"memfd_create","string,i32->i64",["pblang-window-input",1]);
        if s.fd>=2147483648 {s.fd=-1;}assert(s.fd>=0,"X11 input memory descriptor");
        assert(_call(s.c,"fchmod",[s.fd,384])==0,"X11 input private descriptor");
        s.connection=_call(s.cb,"xcb_connect",[0,0]);assert(s.connection>0 and _call(s.cb,"xcb_connection_has_error",[s.connection])==0,"X11 identity connection");
        s.root=_call(s.x,"XDefaultRootWindow",[s.display]);
        s.nonce="pblang-owned-"+str_slice(sha256(base64_encode_bytes(random_bytes(24))),0,40);
        _call(s.x,"XSelectInput",[s.display,s.root,524288]); // creation metadata ONLY
        _call(s.x,"XSync",[s.display,0]);return true;
}
fn bind(s,title) {
    let ok=try _bind_owned(s,title) catch false;
    if not ok {assert(close(s),"X11 input binding cleanup failed");}return ok;
}
fn _bind_owned(s,title) {
        _call(s.x,"XSync",[s.display,0]);let count=0;
        while count<256 and _call(s.x,"XPending",[s.display])>0 {
            _call(s.x,"XNextEvent",[s.display,s.buffer]);let data=_snapshot(s,s.buffer,192);count=count+1;
            if _word(data,0,4)==16 and _word(data,32,8)==s.root {
                let id=_word(data,40,8);if _owned_name(s,id) {assert(s.window==0,"Ambiguous X11 identity");s.window=id;}
            }
        }
        _call(s.x,"XSelectInput",[s.display,s.root,0]);
        assert(s.window!=0 and _call(s.x,"XPending",[s.display])==0,"Owned X11 window unavailable");
        ffi_call_typed(s.cb,"xcb_disconnect","ptr->void",[s.connection]);s.connection=0;
        // Restore the ordinary title. ASCII-only admission preserves WM fallback.
        let text=ffi_call_typed(s.c,"strdup","string->ptr",[title]);assert(text>0,"X11 title allocation");
        let renamed=try {_call(s.x,"XStoreName",[s.display,s.window,text]);true} catch false;_free(s,text);assert(renamed,"X11 title restore");
        let name=ffi_call_typed(s.c,"strdup","string->ptr",["_NET_WM_NAME"]);assert(name>0,"X11 atom allocation");
        let atom=0;let interned=try {atom=_call(s.x,"XInternAtom",[s.display,name,0]);true} catch false;_free(s,name);assert(interned and atom!=0,"X11 title atom");
        _call(s.x,"XDeleteProperty",[s.display,s.window,atom]);
