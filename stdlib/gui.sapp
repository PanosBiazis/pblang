// stdlib/gui.sapp — a desktop GUI widget toolkit, in pblang.
//
// pblang has no native widget set and no text-render builtin — only a window with filled
// rects/lines (graphics.sapp) and a 5x7 bitmap font (bitmap_font.sapp). This module draws
// its own widgets from those primitives and hit-tests the mouse itself, giving a
// Delphi/Qt-style form: a `form` holds positioned `widgets`, `run` opens a window and
// drives the event loop, and event handlers ride as **closures stored in widget fields**.
//
//   let gui = import("stdlib/gui.sapp");
//   fn on_ok(ctx) { print gui.get(ctx, "name").value; }
//   fn build() {
//       let f = gui.form("Hello", 360, 200);
//       gui.add(f, gui.label("t", 20, 16, "Your name:"));
//       gui.add(f, gui.textbox("name", 20, 44, 220, 26, ""));
//       gui.add(f, gui.button("ok", 20, 84, 120, 30, "OK", on_ok));
//       return f;
//   }
//   fn main() { gui.run(build()); }  main();
//
// The interactive core (`handle_event`) is window-free so it is unit-testable headlessly;
// only `draw`/`run` touch a display. The designer's D3 GUI kind generates code against it.

let gfx  = import("stdlib/graphics.sapp");
let font = import("stdlib/bitmap_font.sapp");
let keys = import("stdlib/keymap.sapp");
let ui   = import("stdlib/ui_kit.sapp");
let Clip = import("stdlib:rect_clip.sapp");
let Style = import("stdlib:ui_style.sapp");
let ImageFit = import("stdlib:image_fit.sapp");

// ── metrics & theme ───────────────────────────────────────────────────────────────────
let SCALE = 2;          // bitmap-font pixel scale
let CW = 12;            // scaled char advance  (font.char_width()  * SCALE)
let CH = 16;            // scaled char height   (font.char_height() * SCALE)
let _C = map{
    bg:     gfx.rgb(30, 33, 48),
    panel:  gfx.rgb(44, 49, 70),
    field:  gfx.rgb(20, 22, 34),
    border: gfx.rgb(90, 100, 140),
    accent: gfx.rgb(108, 92, 231),
    text:   gfx.rgb(225, 230, 245),
    muted:  gfx.rgb(150, 160, 185),
    on_accent: gfx.rgb(255, 255, 255),
    selected: gfx.rgb(36, 164, 142),
    danger: gfx.rgb(220, 76, 86),
    focus: gfx.rgb(112, 168, 255)
};
let _LIGHT_C = map{
    bg:     gfx.rgb(248, 249, 252),
    panel:  gfx.rgb(235, 238, 246),
    field:  gfx.rgb(255, 255, 255),
    border: gfx.rgb(188, 197, 216),
    accent: gfx.rgb(80, 65, 190),
    text:   gfx.rgb(28, 32, 44),
    muted:  gfx.rgb(102, 112, 132),
    on_accent: gfx.rgb(255, 255, 255),
    selected: gfx.rgb(31, 137, 117),
    danger: gfx.rgb(180, 35, 24),
    focus: gfx.rgb(0, 95, 204)
};

fn _clone_palette(value) {
    let out = map{};
    for key in ["bg", "panel", "field", "border", "accent", "text", "muted",
                "on_accent", "selected", "danger", "focus"] {
        out[key] = value[key];
    }
    return out;
}

fn palette(name = "dark") {
    if str_lower(str(name)) == "light" { return _clone_palette(_LIGHT_C); }
    return _clone_palette(_C);
}

fn _valid_color(value) {
    if is_number(value) { return true; }
    if type(value) != "array" or (len(value) != 3 and len(value) != 4) { return false; }
    for channel in value {
        if not is_number(channel) or channel < 0 or channel > 255 { return false; }
    }
    return true;
}

fn custom_palette(base, overrides) {
    let out = palette(base);
    if overrides == nil { return out; }
    if type(overrides) != "map" { throw "gui custom palette overrides must be a map"; }
    let allowed = map{ bg: true, panel: true, field: true, border: true,
                       accent: true, text: true, muted: true,
                       on_accent: true, selected: true, danger: true, focus: true };
    for key in map_keys(overrides) {
        if not map_has(allowed, key) { throw "gui custom palette has unknown role: " + str(key); }
        if not _valid_color(overrides[key]) { throw "gui palette role must be an RGB/RGBA color: " + str(key); }
        out[key] = overrides[key];
    }
    return out;
}

fn theme() { return palette("dark"); }   // retained for backward compatibility

// ── widget constructors ───────────────────────────────────────────────────────────────
// Every widget is a map with at least {kind, name, x, y, w, h}. Auto-sized widgets
// (label/checkbox) compute w/h from their text so hit-testing has a real box.
fn label(name, x, y, text) {
    return map{ kind: "label", name: name, x: x, y: y, w: len(text) * CW, h: CH, text: text };
}
fn button(name, x, y, w, h, text, onclick) {
    return map{ kind: "button", name: name, x: x, y: y, w: w, h: h,
                text: text, onclick: onclick, enabled: true, selected: false,
                variant: "primary" };
}
fn textbox(name, x, y, w, h, value) {
    return map{ kind: "textbox", name: name, x: x, y: y, w: w, h: h, value: value,
                max_chars: 4096, readonly: false, visible: true };
}
fn checkbox(name, x, y, text, checked, onchange) {
    return map{ kind: "checkbox", name: name, x: x, y: y, w: CH + 6 + len(text) * CW, h: CH,
                text: text, checked: checked, onchange: onchange };
}
fn panel(name, x, y, w, h, title) {
    return map{ kind: "panel", name: name, x: x, y: y, w: w, h: h, title: title };
}
fn cube3d(name, x, y, w, h, text) {
    return map{ kind: "cube3d", name: name, x: x, y: y, w: w, h: h, text: text };
}
fn sphere3d(name, x, y, w, h, text) {
    return map{ kind: "sphere3d", name: name, x: x, y: y, w: w, h: h, text: text };
}
// image widget — img is a 2D pixel array (img[y][x] = packed gfx color), or nil for a
// placeholder. Nearest-neighbour scaled to the widget box at draw time. An optional
// callback receives (form, local_x, local_y) and enables coordinate-accurate canvases.
fn image(name, x, y, w, h, img, onclick = nil) {
    return map{ kind: "image", name: name, x: x, y: y, w: w, h: h,
                img: img, onclick: onclick, enabled: true };
}
// radio button: radios sharing `group` are mutually exclusive (selecting one clears its
// siblings). Auto-sized like checkbox.
fn radio(name, x, y, text, group, selected, onchange) {
    return map{ kind: "radio", name: name, x: x, y: y, w: CH + 6 + len(text) * CW, h: CH,
                text: text, group: group, selected: selected, onchange: onchange };
}
// select (cycle combo): clicking advances to the next option (wraps). `options` is a list
// of strings, `selected` an index. (A drawn-from-primitives GUI has no native popup, so
// this is an honest click-to-cycle select rather than a dropdown overlay.)
fn select(name, x, y, w, h, options, selected, onchange) {
    return map{ kind: "select", name: name, x: x, y: y, w: w, h: h,
                options: options, selected: selected, onchange: onchange };
}
// horizontal slider: drag the knob to set `value` in [min, max].
fn slider(name, x, y, w, h, value, min, max, onchange) {
    return map{ kind: "slider", name: name, x: x, y: y, w: w, h: h,
                value: value, min: min, max: max, onchange: onchange };
}

// ── form container ────────────────────────────────────────────────────────────────────
fn form(title, w, h) {
    return map{ kind: "form", title: title, w: w, h: h, widgets: [],
                focus: nil, shift: false, mouse: map{ x: 0, y: 0 }, pointer_known: false, model: map{},
                onscroll: nil,
                pressed_keys: map{},
                palette: palette("dark"),
                layout_fn: nil, layout_options: nil, onresize: nil,
                ontick: nil, tick_interval_ms: 0, next_tick_ms: 0,
                resize_count: 0, viewport: map{ width: w, height: h, ui_scale: 1,
                    font_pixel_scale: SCALE }, dirty: true,
                close_requested: false, native_window_closed: false,
                graphics_stop: false };
}
fn add(f, w) { array_push(f.widgets, w); _pull(f, w); f.dirty = true; return f; }

fn set_palette(f, value) {
    if type(value) != "map" { throw "gui palette must be a map"; }
    let checked = custom_palette("dark", value);
    f.palette = checked;
    f.dirty = true;
    return f;
}

// Legacy forms remain bitmap by default. Modern UI opts into the existing
// native font renderer with the same fixed advance used by editing/hit tests.
fn set_text_render(f, mode = "auto") {
    if mode != "auto" and mode != "bitmap" { throw "gui text renderer must be auto or bitmap"; }
    f.text_render=mode; f.dirty=true;
    return f;
}

fn fit_form(f, min_w = 360, min_h = 220, pad = 40) {
    let w = min_w;
    let h = min_h;
    let i = 0;
    while i < len(f.widgets) {
        let it = f.widgets[i];
        let right = (try it.x catch 0) + (try it.w catch 0) + pad;
        let bottom = (try it.y catch 0) + (try it.h catch 0) + pad;
        if right > w { w = right; }
        if bottom > h { h = bottom; }
        i = i + 1;
    }
    f.w = w;
    f.h = h;
    f.dirty = true;
    return f;
}
fn get(f, name) {
    let i = 0;
    while i < len(f.widgets) { if f.widgets[i].name == name { return f.widgets[i]; } i = i + 1; }
    return nil;
}

// ── data-binding (Visual_Designer §7) ─────────────────────────────────────────────────
// The form's `model` map is the source of truth. A widget bound to a model field (via
// `bind`) PUSHES its value into the model when the user changes it and PULLS the model's
// value on redraw / sync — so toggling a checkbox updates state, and a handler that writes
// the model re-displays in the bound widget. Two-way for inputs, one-way for labels.
fn bind(w, field) { w["bind"] = field; return w; }
fn set_model(f, m) { f["model"] = m; sync(f); return f; }
// which widget property mirrors the model for each kind ("" = not bindable)
fn _bound_key(w) {
    let k = w.kind;
    if k == "textbox" or k == "textarea" { return "value"; }
    if k == "checkbox" { return "checked"; }
    if k == "slider" { return "value"; }
    if k == "select" { return "selected"; }
    if k == "label" { return "text"; }
    return "";
}
fn _push(f, w) {                            // widget value -> model
    let b = try w.bind catch nil;
    if b == nil { return 0; }
    let key = _bound_key(w);
    if key != "" { f.model[b] = w[key]; }
    return 0;
}
fn _pull(f, w) {                            // model value -> widget
    let b = try w.bind catch nil;
    if b == nil { return 0; }
    if not map_has(f.model, b) { return 0; }
    let key = _bound_key(w);
    if key != "" { w[key] = f.model[b]; }
    return 0;
}
// sync(form) — refresh every bound widget from the model (call after a handler mutates it).
fn sync(f) {
    let i = 0;
    while i < len(f.widgets) { _pull(f, f.widgets[i]); i = i + 1; }
    f.dirty = true;
    return 0;
}

// ── interactive core (window-free → testable) ─────────────────────────────────────────
fn _in(w, x, y) {
    if (try w.visible catch true) == false { return false; }
    let clip=try w.clip_rect catch nil;
    if clip!=nil and not Clip.contains(clip,x,y) { return false; }
    return x >= w.x and x < w.x + w.w and y >= w.y and y < w.y + w.h;
}
fn _focused(f) { if f.focus == nil { return nil; } return get(f, f.focus); }

fn _focusable(w) {
    if w == nil or (try w.visible catch true) == false
        or not (try w.enabled catch true) { return false; }
    let clip=try w.clip_rect catch nil;
    if clip!=nil {
        let region=Clip.region(clip);
        if region.w==0 or region.h==0 or w.x+w.w<=region.x or w.y+w.h<=region.y
            or w.x>=region.x+region.w or w.y>=region.y+region.h { return false; }
    }
    let kind = try w.kind catch "";
    if kind == "textbox" or kind == "textarea" {
        return not (try w.readonly catch false);
    }
    return kind == "button" or kind == "checkbox" or kind == "radio"
        or kind == "select" or kind == "slider";
}

fn focus_next(f, reverse = false) {
    _cancel_drag(f);
    let count = len(f.widgets);
    if count == 0 { f.focus = nil; return nil; }
    let current = -1; let i = 0;
    while i < count {
        if f.widgets[i].name == f.focus { current = i; break; }
        i = i + 1;
    }
    let step = 1;
    if reverse { step = -1; }
    let at = current;
    if current < 0 { at = -1; if reverse { at = count; } }
    i = 0;
    while i < count {
        at = at + step;
        if at < 0 { at = count - 1; }
        if at >= count { at = 0; }
        if _focusable(f.widgets[at]) {
            f.focus = f.widgets[at].name;
            f.dirty = true;
            return f.focus;
        }
        i = i + 1;
    }
    f.focus = nil; f.dirty = true;
    return nil;
}

// hit_test(form, x, y) -> the topmost widget under (x, y), or nil. Last-added wins so
// widgets drawn on top of a panel take the click.
fn hit_test(f, x, y) {
    let hit = nil;
    let i = 0;
    while i < len(f.widgets) { if _in(f.widgets[i], x, y) { hit = f.widgets[i]; } i = i + 1; }
    return hit;
}

// Cursor state is transient widget state, never part of the bound model.
// External value replacement (page change, binding, Undo) invalidates it.
fn _textbox_cursor(w) {
    let n=len(w.value);
    if (try w.cursor_value catch nil)!=w.value {
        w.caret=n; w.selection_anchor=n; w.text_offset=0; w.cursor_value=w.value;
    }
    let at=try w.caret catch n;
    if type(at)!="number" or not (at>=0 and at<=n) or at!=num_floor(at) {
        at=n; w.selection_anchor=at;
    }
    w.caret=at;
    let anchor=try w.selection_anchor catch at;
    if type(anchor)!="number" or not (anchor>=0 and anchor<=n) or anchor!=num_floor(anchor) { anchor=at; }
    w.selection_anchor=anchor;
    return at;
}

fn _textbox_window(w, char_width) {
    let at=_textbox_cursor(w);
    let columns=num_max(1,num_floor((w.w-12)/char_width));
    let start=try w.text_offset catch 0;
    if type(start)!="number" or not (start>=0 and start<=len(w.value))
        or start!=num_floor(start) { start=0; }
    if at<start { start=at; }
    if at>=start+columns { start=at-columns+1; }
    w.text_offset=start;
    return map{start:start,caret:at,text:str_slice(w.value,start,num_min(len(w.value),start+columns))};
}

fn _text_modifier_down(f) {
    for pressed in map_keys(f.pressed_keys) {
        if keys.is_ctrl(pressed) or keys.is_meta(pressed) { return true; }
    }
    return false;
}

fn _cancel_drag(f) { f.drag=nil; f.text_drag_value=nil; }

fn _textbox_advance(f) {
    return 6*num_max(1,num_min(8,num_floor(try f.viewport.font_pixel_scale catch SCALE)));
}

fn _drag_at(f,x) {
    let name=try f.drag catch nil;
    if name==nil { return; }
    let w=get(f,name);
    if not _focusable(w) { _cancel_drag(f); return; }
    if w.kind=="slider" {
        _slider_set(w,x); _push(f,w); f.dirty=true;
        if w.onchange!=nil { w.onchange(f); }
        return;
    }
    if w.kind!="textbox" or f.focus!=name { _cancel_drag(f); return; }
    _pull(f,w);
    if type(w.value)!="string" or w.value!=(try f.text_drag_value catch nil) {
        _cancel_drag(f); return;
    }
    let advance=_textbox_advance(f); let view=_textbox_window(w,advance);
    let columns=num_max(1,num_floor((w.w-12)/advance));
    let at=view.start+num_floor((x-w.x-6)/advance+0.5);
    // At most one extra scalar beyond the currently visible edge per event.
    if x<w.x+6 { at=view.start-1; }
    elif x>w.x+w.w-6 { at=view.start+columns; }
    w.caret=num_max(0,num_min(len(w.value),at));
    _textbox_window(w,advance); f.dirty=true;
}

fn _type_into(f, w, key, shift) {
    if w == nil or (w.kind != "textbox" and w.kind != "textarea") { return 0; }
    if not _focusable(w) or type(w.value)!="string" { return 0; }
    let modified=_text_modifier_down(f);
    if w.kind=="textbox" {
        let at=_textbox_cursor(w); let n=len(w.value); let value=w.value;
        if modified {
            if key=="A" or key=="a" or key=="KeyA" {
                w.selection_anchor=0; w.caret=n; f.dirty=true;
            }
            return 0;
        }
        let anchor=w.selection_anchor;
        let first=num_min(anchor,at); let last=num_max(anchor,at);
        let moving=key=="Left" or key=="Right" or key=="Home" or key=="End";
        if moving {
            if key=="Left" {
                if not shift and first!=last { at=first; } else { at=num_max(0,at-1); }
            } elif key=="Right" {
                if not shift and first!=last { at=last; } else { at=num_min(n,at+1); }
            } elif key=="Home" { at=0; }
            else { at=n; }
            if not shift { anchor=at; }
        } elif (key=="Backspace" or key=="Delete") and first!=last {
            value=str_slice(value,0,first)+str_slice(value,last,n); at=first; anchor=at;
        } elif key=="Backspace" and at>0 {
            value=str_slice(value,0,at-1)+str_slice(value,at,n); at=at-1;
            anchor=at;
        } elif key=="Delete" and at<n {
            value=str_slice(value,0,at)+str_slice(value,at+1,n);
            anchor=at;
        } else {
            let ch=keys.key_to_char(key,shift);
            if ch!="" and n-(last-first)+len(ch)<=(try w.max_chars catch 4096) {
                value=str_slice(value,0,first)+ch+str_slice(value,last,n);
                at=first+len(ch); anchor=at;
            }
        }
        if at!=w.caret or anchor!=w.selection_anchor or value!=w.value { f.dirty=true; }
        if value!=w.value { w.value=value; _push(f,w); }
        w.caret=at; w.selection_anchor=anchor; w.cursor_value=w.value;
        return 0;
    }
    if modified { return 0; }
    if key == "Backspace" {
        if len(w.value) > 0 { w["value"] = str_slice(w.value, 0, len(w.value) - 1); _push(f, w); f.dirty = true; }
        return 0;
    }
    let ch = keys.key_to_char(key, shift);
    if w.kind == "textarea" and key == "Enter" { ch = "\n"; }
    let max_chars = try w.max_chars catch 4096;
    if ch != "" and len(w.value) < max_chars { w["value"] = w.value + ch; _push(f, w); f.dirty = true; }
    return 0;
}

// clamp helper
fn _clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }
// set a slider's value from an absolute mouse x (knob follows the cursor along the track).
fn _slider_set(w, x) {
    let span = w.w; if span <= 0 { span = 1; }
    let t = _clamp((x - w.x) / span, 0, 1);
    w["value"] = w.min + t * (w.max - w.min);
    return 0;
}
// select the radio `w` and clear every sibling in the same group.
fn _radio_pick(f, w) {
    let i = 0;
    while i < len(f.widgets) {
        let o = f.widgets[i];
        if o.kind == "radio" and o.group == w.group { o["selected"] = (o.name == w.name); }
        i = i + 1;
    }
    return 0;
}

fn _select_step(f, w, delta) {
    let count = len(w.options);
    if count <= 0 { return 0; }
    let selected = w.selected + delta;
    if selected < 0 { selected = count - 1; }
    if selected >= count { selected = 0; }
    w.selected = selected; _push(f, w); f.dirty = true;
    if w.onchange != nil { w.onchange(f); }
    return 0;
}

fn _slider_step(f, w, delta) {
    let step = try w.step catch ((w.max - w.min) / 20);
    if type(step) != "number" or step <= 0 { step = 1; }
    w.value = _clamp(w.value + step * delta, w.min, w.max);
    _push(f, w); f.dirty = true;
    if w.onchange != nil { w.onchange(f); }
    return 0;
}

fn _activate_keyboard(f, w, key) {
    if not _focusable(w) { return false; }
    if w.kind == "button" and (key == "Enter" or key == "Space") {
        if w.onclick != nil { w.onclick(f); }
        f.dirty = true; return true;
    }
    if w.kind == "checkbox" and (key == "Enter" or key == "Space") {
        w.checked = not w.checked; _push(f, w);
        if w.onchange != nil { w.onchange(f); }
        f.dirty = true; return true;
    }
    if w.kind == "radio" and (key == "Enter" or key == "Space") {
        _radio_pick(f, w); _push(f, w);
        if w.onchange != nil { w.onchange(f); }
        f.dirty = true; return true;
    }
    if w.kind == "select" {
        if key == "Right" or key == "Down" or key == "Enter" or key == "Space" {
            _select_step(f, w, 1); return true;
        }
        if key == "Left" or key == "Up" { _select_step(f, w, -1); return true; }
        if key == "Home" and len(w.options) > 0 {
            w.selected = 0; _push(f, w); f.dirty = true;
            if w.onchange != nil { w.onchange(f); }
            return true;
        }
        if key == "End" and len(w.options) > 0 {
            w.selected = len(w.options) - 1; _push(f, w); f.dirty = true;
            if w.onchange != nil { w.onchange(f); }
            return true;
        }
    }
    if w.kind == "slider" {
        if key == "Right" or key == "Up" { _slider_step(f, w, 1); return true; }
        if key == "Left" or key == "Down" { _slider_step(f, w, -1); return true; }
        if key == "Home" {
            w.value = w.min; _push(f, w); f.dirty = true;
            if w.onchange != nil { w.onchange(f); }
            return true;
        }
        if key == "End" {
            w.value = w.max; _push(f, w); f.dirty = true;
            if w.onchange != nil { w.onchange(f); }
            return true;
        }
    }
    return false;
}

fn _click_at(f, x, y) {
    f.dirty = true;
    let previous_focus=f.focus;
    f["focus"] = nil;                          // empty space clears focus
    let w = hit_test(f, x, y);
    if w == nil { return 0; }
    if not (try w.enabled catch true) { return 0; }
    if _focusable(w) { f["focus"] = w.name; }
    if w.kind=="textbox" and f.focus==w.name and type(w.value)=="string" {
        _textbox_cursor(w);
        let advance=_textbox_advance(f);
        let start=0;
        if previous_focus==w.name { start=_textbox_window(w,advance).start; }
        w.caret=num_max(0,num_min(len(w.value),start+num_floor((x-w.x-6)/advance+0.5)));
        if not f.shift or previous_focus!=w.name { w.selection_anchor=w.caret; }
        w.text_offset=start;
        f.drag=w.name; f.text_drag_value=w.value;
    }
    if w.kind == "textbox" or w.kind == "textarea" { return 0; }
    if w.kind == "checkbox" {
        w["checked"] = not w.checked;
        _push(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "radio" {
        _radio_pick(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "select" {
        let n = len(w.options);
        if n > 0 { w["selected"] = num_mod(w.selected + 1, n); _push(f, w); if w.onchange != nil { w.onchange(f); } }
    }
    else if w.kind == "slider" {
        _slider_set(w, x);
        _push(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "button" {
        if w.onclick != nil { w.onclick(f); }
    }
    else if w.kind == "image" {
        if w.onclick != nil { w.onclick(f, x - w.x, y - w.y); }
    }
    return 0;
}

// Native pointer coordinates use the signed 32-bit pixel domain. Explicit but
// incomplete/invalid coordinates never fall back to a different stale target.
fn _event_pointer(f, ev, legacy = false) {
    if not map_has(ev,"x") and not map_has(ev,"y") { return legacy; }
    let x=try ev.x catch nil; let y=try ev.y catch nil;
    if type(x)!="number" or type(y)!="number"
        or not (x>=-2147483648 and x<=2147483647 and y>=-2147483648 and y<=2147483647) {
        f.pointer_known=false;
        return false;
    }
    f.mouse=map{x:x,y:y};
    f.pointer_known=true;
    return true;
}

// handle_event(form, ev) — apply one gfxpollevents record. Prefer each click's
// coordinates; only legacy coordinate-free clicks use the tracked pointer.
// A press on a slider starts a drag (f.drag) so the knob tracks the cursor until release.
fn handle_event(f, ev) {
    let t = try ev.type catch "";
    if t == "scroll" {
        let callback=try f.onscroll catch nil;
        if callback==nil or (try f.close_requested catch false) { return 0; }
        let dx=try ev.dx catch nil; let dy=try ev.dy catch nil;
        if type(dx)!="number" or type(dy)!="number"
            or not (dx>=-1000 and dx<=1000 and dy>=-1000 and dy<=1000) { return 0; }
        let source="tracked";
        if map_has(ev,"x") or map_has(ev,"y") {
            if not _event_pointer(f,ev) { return 0; }
            source="event";
        } elif not (try f.pointer_known catch false) { return 0; }
        if dx==0 and dy==0 { return 0; }
        // Editing normalized event coordinates does not overwrite tracked pointer state.
        let changed=callback(f,map{type:"scroll",dx:dx,dy:dy,x:f.mouse.x,y:f.mouse.y,pointer_source:source});
        if changed==true { f.dirty=true; }
        return 0;
    }
    if t == "close" or t == "quit" {
        _cancel_drag(f);
        // Observed native close, not proof that its registry resource is freed.
        // graphics.run owns release on normal event-loop exit.
        f.close_requested = true; f.native_window_closed = true; f.dirty = true;
        return 0;
    }
    if t == "resize" {
        let width = try ev.w catch -1; let height = try ev.h catch -1;
        if type(width) != "number" or type(height) != "number" or width <= 0 or height <= 0 { return 0; }
        let previous_w = f.w; let previous_h = f.h;
        let previous_scale = try f.viewport.ui_scale catch 1;
        let event_options = _event_layout_options(f, ev);
        let profile = relayout(f, width, height, event_options);
        if profile.width != previous_w or profile.height != previous_h
            or profile.ui_scale != previous_scale {
            f.resize_count = (try f.resize_count catch 0) + 1;
            if (try f.onresize catch nil) != nil { f.onresize(f, profile); }
        }
        return 0;
    }
    if t == "moved" and type(try ev.display_h catch nil) == "number" {
        let previous_scale = try f.viewport.ui_scale catch 1;
        let profile = relayout(f, f.w, f.h, _event_layout_options(f, ev));
        if profile.ui_scale != previous_scale {
            f.resize_count = (try f.resize_count catch 0) + 1;
            if (try f.onresize catch nil) != nil { f.onresize(f, profile); }
        }
        return 0;
    }
    if t == "mousemove" {
        if not _event_pointer(f,ev) { _cancel_drag(f); return 0; }
        _drag_at(f,ev.x);
        return 0;
    }
    if t == "mousedown" {
        if (try ev.button catch "Left") != "Left" { return 0; }
        if not _event_pointer(f,ev,true) { _cancel_drag(f); return 0; }
        _cancel_drag(f);
        let hit = hit_test(f, f.mouse.x, f.mouse.y);
        if hit != nil and hit.kind == "slider" and _focusable(hit) { f["drag"] = hit.name; }
        _click_at(f, f.mouse.x, f.mouse.y);
        return 0;
    }
    if t == "mouseup" {
        if (try ev.button catch "Left")!="Left" { return 0; }
        if (try f.drag catch nil)!=nil {
            // Legacy coordinate-free release retains the last processed position.
            let previous=f.mouse;
            if (map_has(ev,"x") or map_has(ev,"y")) and _event_pointer(f,ev) {
                if f.mouse.x!=previous.x or f.mouse.y!=previous.y { _drag_at(f,ev.x); }
            }
            f.dirty=true;
        }
        _cancel_drag(f); return 0;
    }
    if t == "keydown" {
        let k = try ev.key catch "";
        if keys.is_shift(k) { f.pressed_keys[k]=true; f.shift=true; return 0; }
        _cancel_drag(f);
        let repeated = map_has(f.pressed_keys, k);
        if not repeated { f.pressed_keys[k] = true; }
        let focused = _focused(f);
        if repeated and focused != nil
            and (focused.kind == "textbox" or focused.kind == "textarea") {
            _type_into(f, focused, k, f.shift);
            return 0;
        }
        if repeated { return 0; }
        if k == "Tab" { focus_next(f, f.shift); return 0; }
        if k == "Escape" {
            if f.focus != nil { f.focus = nil; f.dirty = true; }
            else { request_close(f); }
            return 0;
        }
        if _activate_keyboard(f, focused, k) { return 0; }
        _type_into(f, focused, k, f.shift);
        return 0;
    }
    if t == "keyup" {
        let k = try ev.key catch "";
        if map_has(f.pressed_keys, k) { map_remove(f.pressed_keys, k); }
        if keys.is_shift(k) {
            f.shift=false;
            for pressed in map_keys(f.pressed_keys) {
                if keys.is_shift(pressed) { f.shift=true; }
            }
        }
        return 0;
    }
    return 0;
}

// ── rendering (display) ───────────────────────────────────────────────────────────────
fn _border(win, x, y, w, h, color) {
    win.line(x, y, x + w, y, color);
    win.line(x, y + h, x + w, y + h, color);
    win.line(x, y, x, y + h, color);
    win.line(x + w, y, x + w, y + h, color);
}

fn _fill_rects(win, rects, color) {
    let i = 0;
    while i < len(rects) {
        let r = rects[i];
        if r.w > 0 and r.h > 0 { win.rect(r.x, r.y, r.w, r.h, color); }
        i = i + 1;
    }
}

fn _card(win, x, y, w, h, radius, border, fill) {
    let shape = ui.card(x, y, w, h, radius, 1);
    _fill_rects(win, shape.border, border);
    _fill_rects(win, shape.fill, fill);
}
// scaled bitmap text: each lit 5x7 pixel becomes one SCALE×SCALE filled rect.
fn _text(win, x, y, s, color, pixel_scale) {
    let ps = num_floor(pixel_scale);
    if ps < 1 { ps = 1; } if ps > 8 { ps = 8; }
    let advance = 6 * ps;
    let smooth = try win.textAA catch nil;
    if smooth != nil {
        let result = try smooth(x, y - ps, s, color, 9 * ps, advance) catch nil;
        if result != nil and (try result.ok catch false) == true {
            return x + len(s) * advance;
        }
    }
    let cx = x;
    let i = 0;
    while i < len(s) {
        let code = strcharcodeat(s, i);
        if code != 32 {
            let g = font.glyph(code);
            if g == nil { g = [31, 17, 17, 17, 17, 17, 31]; }
            let r = 0;
            while r < 7 {
                let row = g[r];
                let c = 0;
                while c < 5 {
                    if bit_and(bit_shr(row, 4 - c), 1) == 1 {
                        win.rect(cx + c * ps, y + r * ps, ps, ps, color);
                    }
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        cx = cx + advance;
        i = i + 1;
    }
    return cx;
}

fn _fit_text(value, pixel_width, char_width) {
    let text = str(value);
    let chars = num_floor(pixel_width / char_width);
    if chars <= 0 { return ""; }
    if len(text) <= chars { return text; }
    if chars <= 3 { return str_slice(text, 0, chars); }
    return str_slice(text, 0, chars - 3) + "...";
}

fn _text_lines(win, x, y, w, h, value, color, pixel_scale) {
    let ps = num_floor(pixel_scale);
    if ps < 1 { ps = 1; } if ps > 8 { ps = 8; }
    let advance = 6 * ps; let line_height = 8 * ps;
    let lines = str_split(str(value), "\n");
    let max_rows = num_floor(h / line_height);
    let i = 0;
    while i < len(lines) and i < max_rows {
        _text(win, x, y + i * line_height,
            _fit_text(lines[i], w, advance), color, ps);
        i = i + 1;
    }
    return i;
}
fn _draw_image_widget(win, w, c, img, pixel_scale) {
    win.rect(w.x, w.y, w.w, w.h, c.field);
    let packed_format = "";
    if is_map(img) and map_has(img, "format") { packed_format = img.format; }
    let packed_channels = 0;
    if packed_format == "pblang.image.rgba8.v1" { packed_channels = 4; }
    elif packed_format == "pblang.image.rgb8.v1" { packed_channels = 3; }
    let packed = is_map(img) and packed_channels > 0
        and map_has(img, "width") and map_has(img, "height")
        and map_has(img, "bytes") and map_has(img, "offset") and map_has(img, "stride")
        and type(img.width) == "number" and type(img.height) == "number"
        and num_floor(img.width) == img.width
        and num_floor(img.height) == img.height
        and img.width > 0 and img.height > 0
        and is_array(img.bytes) and type(img.offset) == "number"
        and num_floor(img.offset) == img.offset and img.offset >= 0
        and type(img.stride) == "number"
        and num_floor(img.stride) == img.stride
        and img.stride >= img.width * packed_channels
        and len(img.bytes) == img.offset + img.height * img.stride;
    let planar = not packed and is_array(img) and len(img) > 0
        and is_array(img[0]) and len(img[0]) > 0;
    if packed or planar {
        let ih = 0; let iw = 0;
        if packed { ih = img.height; iw = img.width; }
        else { ih = len(img); iw = len(img[0]); }
        let fit=ImageFit.mode(try w.fit catch "stretch");
        let frame=map{x:0,y:0,w:w.w,h:w.h,sx:0,sy:0,sw:iw,sh:ih};
        if fit!="stretch" {
            frame=ImageFit.layout(iw,ih,num_max(0,num_floor(w.w)),num_max(0,num_floor(w.h)),fit);
        }
        if frame.sw <= frame.w and frame.sh <= frame.h {
            // Upscaling is proportional to source pixels, not viewport pixels.
            let sy = num_floor(frame.sy);
            while sy < num_min(ih,num_ceil(frame.sy+frame.sh)) {
                let y0 = num_max(0,num_floor((sy-frame.sy)*frame.h/frame.sh));
                let y1 = num_min(frame.h,num_floor((sy+1-frame.sy)*frame.h/frame.sh));
                let sx = num_floor(frame.sx);
                while sx < num_min(iw,num_ceil(frame.sx+frame.sw)) {
                    let x0 = num_max(0,num_floor((sx-frame.sx)*frame.w/frame.sw));
                    let x1 = num_min(frame.w,num_floor((sx+1-frame.sx)*frame.w/frame.sw));
                    let color = [0, 0, 0, 255];
                    if packed {
                        let at = img.offset + sy * img.stride + sx * packed_channels;
                        let alpha = 255;
                        if packed_channels == 4 { alpha = img.bytes[at + 3]; }
                        color = [img.bytes[at], img.bytes[at + 1], img.bytes[at + 2], alpha];
                    } else { color = img[sy][sx]; }
                    if x1>x0 and y1>y0 {
                        win.rect(w.x+frame.x+x0,w.y+frame.y+y0,x1-x0,y1-y0,color);
                    }
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
        } else {
            let py = 0;
            while py < frame.h {
                let sy = num_min(ih-1,num_floor(frame.sy+py*frame.sh/frame.h));
                let px = 0;
                while px < frame.w {
                    let sx = num_min(iw-1,num_floor(frame.sx+px*frame.sw/frame.w));
                    let color = [0, 0, 0, 255];
                    if packed {
                        let at = img.offset + sy * img.stride + sx * packed_channels;
                        let alpha = 255;
                        if packed_channels == 4 { alpha = img.bytes[at + 3]; }
                        color = [img.bytes[at], img.bytes[at + 1], img.bytes[at + 2], alpha];
                    } else { color = img[sy][sx]; }
                    win.point(w.x+frame.x+px,w.y+frame.y+py,color);
                    px = px + 1;
                }
                py = py + 1;
            }
        }
    } else {
        _text(win, w.x + 6, w.y + 6, "(no frame)", c.muted, pixel_scale);
    }
    _border(win, w.x, w.y, w.w, w.h, c.border);
}

fn _widget_image(w) {
    if is_map(w) and map_has(w, "img") { return w.img; }
    return nil;
}

fn _draw_widget(win, f, w) {
    if (try w.visible catch true) == false { return 0; }
    let clip=try w.clip_rect catch nil;
    if clip!=nil { win=Clip.canvas(win,clip); }
    let c = try f.palette catch _C;
    let pixel_scale = num_floor(try f.viewport.font_pixel_scale catch SCALE);
    if w.kind == "label" and (try w.text_role catch "") == "heading" {
        pixel_scale=num_ceil(pixel_scale*1.5);
    }
    if pixel_scale < 1 { pixel_scale = 1; } if pixel_scale > 8 { pixel_scale = 8; }
    let char_width = 6 * pixel_scale; let char_height = 8 * pixel_scale;
    _pull(f, w);                              // bound widgets mirror the model each frame
    let ty = w.y + (w.h - 7 * pixel_scale) / 2;
    if w.kind == "label" {
        _text(win, w.x, w.y, _fit_text(w.text, w.w, char_width),
            Style.tone(c,try w.tone catch "",c.text), pixel_scale);
    } else if w.kind == "button" {
        let enabled = try w.enabled catch true;
        let variant = try w.variant catch "primary";
        let style = Style.button(c,variant,try w.selected catch false,enabled);
        let fill=style.fill; let text_color=style.text; let button_border=style.border;
        _fill_rects(win, ui.elevation(w.x, w.y, w.w, w.h, 2), c.field);
        if not enabled { button_border = c.field; }
        if f.focus == w.name { button_border = c.focus; }
        _card(win, w.x, w.y, w.w, w.h, 6, button_border, fill);
        _text(win, w.x + 8, ty, _fit_text(w.text, w.w - 16, char_width),
            text_color, pixel_scale);
    } else if w.kind == "textbox" {
        let bc = c.border;
        if f.focus == w.name { bc = c.accent; }
        _card(win, w.x, w.y, w.w, w.h, 5, bc, c.field);
        let hint = w.value == "";
        let visible_text = if hint { str(try w.placeholder catch "") } else { w.value };
        let focused=f.focus==w.name and _focusable(w) and type(w.value)=="string";
        let text_view=nil;
        if focused {
            text_view=_textbox_window(w,char_width);
            if not hint { visible_text=text_view.text; }
        }
        _text(win, w.x + 6, ty, _fit_text(visible_text, w.w - 12, char_width),
            if hint { c.muted } else { c.text }, pixel_scale);
        if focused and w.w>12 and w.h>=7*pixel_scale {
            // Paint only the visible intersection; offsets remain scalar indexes.
            let first=num_max(text_view.start,num_min(w.selection_anchor,w.caret));
            let last=num_min(text_view.start+len(text_view.text),num_max(w.selection_anchor,w.caret));
            if last>first {
                let sx=w.x+6+(first-text_view.start)*char_width;
                win.rect(sx,ty,(last-first)*char_width,7*pixel_scale,c.accent);
                _text(win,sx,ty,str_slice(w.value,first,last),c.on_accent,pixel_scale);
            }
            let cx=w.x+6+(text_view.caret-text_view.start)*char_width;
            win.line(cx,ty,cx,ty+7*pixel_scale,c.accent);
        }
    } else if w.kind == "textarea" {
        let bc = c.border;
        if f.focus == w.name { bc = c.accent; }
        _card(win, w.x, w.y, w.w, w.h, 5, bc, c.field);
        _text_lines(win, w.x + 6, w.y + 6, w.w - 12, w.h - 12,
            w.value, c.text, pixel_scale);
    } else if w.kind == "checkbox" {
        _card(win, w.x, w.y, char_height, char_height, 4,
            if f.focus == w.name { c.accent } else { c.border }, c.field);
        if w.checked { _text(win, w.x + 3, w.y + 1, "X", c.accent, pixel_scale); }
        _text(win, w.x + char_height + 6, w.y + 1, w.text, c.text, pixel_scale);
    } else if w.kind == "panel" {
        _fill_rects(win, ui.elevation(w.x, w.y, w.w, w.h, 2), c.field);
        let radius=try f.card_radius catch nil;
        if radius==nil { radius=7; }
        else { radius=radius*(try f.viewport.ui_scale catch 1); }
        _card(win, w.x, w.y, w.w, w.h, radius, c.border, c.panel);
        if w.title != "" { _text(win, w.x + 8, w.y + 6, w.title, c.muted, pixel_scale); }
    } else if w.kind == "cube3d" {
        let off = 12;
        let face = c.accent;
        let side = gfx.rgb(50, 42, 118);
        let top = gfx.rgb(115, 103, 240);
        win.rect(w.x + off, w.y, w.w, w.h, top);
        win.rect(w.x, w.y + off, w.w, w.h, face);
        win.rect(w.x + w.w, w.y + off, off, w.h, side);
        _border(win, w.x, w.y + off, w.w, w.h, c.border);
        _border(win, w.x + off, w.y, w.w, w.h, c.muted);
        _text(win, w.x + 6, w.y + w.h + off + 6, w.text, c.text, pixel_scale);
    } else if w.kind == "sphere3d" {
        let steps = 7;
        let i = 0;
        while i < steps {
            let inset = i * 4;
            let shade = gfx.rgb(46 + i * 14, 224 - i * 19, 189 - i * 12);
            win.rect(w.x + inset, w.y + inset, w.w - inset * 2, w.h - inset * 2, shade);
            i = i + 1;
        }
        _border(win, w.x, w.y, w.w, w.h, c.border);
        _text(win, w.x + 6, w.y + w.h + 6, w.text, c.text, pixel_scale);
    } else if w.kind == "radio" {
        win.circle(w.x + char_height / 2, w.y + char_height / 2,
            char_height / 2 - 1,
            if f.focus == w.name { c.accent } else { c.border });
        if w.selected { win.rect(w.x + char_height / 2 - 3,
            w.y + char_height / 2 - 3, 6, 6, c.accent); }
        _text(win, w.x + char_height + 6, w.y + 1, w.text, c.text, pixel_scale);
    } else if w.kind == "select" {
        _card(win, w.x, w.y, w.w, w.h, 5, if f.focus == w.name { c.accent } else { c.border }, c.field);
        let opt = "";
        if len(w.options) > 0 and w.selected >= 0 and w.selected < len(w.options) { opt = w.options[w.selected]; }
        _text(win, w.x + 6, ty, _fit_text(opt, w.w - 24, char_width),
            c.text, pixel_scale);
        _text(win, w.x + w.w - 7 * pixel_scale, ty, "v", c.muted, pixel_scale);
    } else if w.kind == "slider" {
        let cy = w.y + w.h / 2;
        win.line(w.x, cy, w.x + w.w, cy, c.border);
        let span = w.max - w.min; if span == 0 { span = 1; }
        let t = _clamp((w.value - w.min) / span, 0, 1);
        let kx = w.x + t * w.w;
        _fill_rects(win, ui.pill(kx - 4, w.y + 2, 8, w.h - 4), c.accent);
        if f.focus == w.name { _border(win, w.x, w.y, w.w, w.h, c.accent); }
    } else if w.kind == "progress" {
        _fill_rects(win, ui.pill(w.x, w.y, w.w, w.h), c.field);
        let value = _clamp(try w.value catch 0, 0, 1);
        let filled = num_floor(w.w * value);
        if filled > 0 { _fill_rects(win, ui.pill(w.x, w.y, filled, w.h), c.accent); }
    } else if w.kind == "divider" {
        win.rect(w.x, w.y, w.w, w.h, c.border);
    } else if w.kind == "spacer" {
        return 0;
    } else if w.kind == "image" {
        _draw_image_widget(win, w, c, _widget_image(w), pixel_scale);
    }
}
fn draw(win, f) {
    // Do not mutate the caller's backend. Clipped canvases intentionally omit
    // textAA and retain their pixel-clipped bitmap path until glyph clipping exists.
    if (try f.text_render catch "bitmap") != "auto" and map_has(win,"textAA") {
        let legacy=map{};
        for key in map_keys(win) { if key != "textAA" { legacy[key]=win[key]; } }
        win=legacy;
    }
    let c = try f.palette catch _C;
    win.clear(c.bg);
    let i = 0;
    while i < len(f.widgets) { _draw_widget(win, f, f.widgets[i]); i = i + 1; }
    f.dirty = false;
    return true;
}

// ── run ───────────────────────────────────────────────────────────────────────────────
// The event loop polls at 30 Hz for responsive input but presents only dirty
// frames. Idle forms therefore avoid continuous full-framebuffer redraws.
fn run(f) {
    relayout(f, f.w, f.h);
    let win = gfx.Window(f.w, f.h, f.title);
    gfx.run(win, f,
        fn(s, evs) {
            if try s.close_requested catch false {
                if not (try s.native_window_closed catch false) { win.close(); }
                s.graphics_stop = true;
                return false;
            }
            let i = 0;
            while i < len(evs) {
                handle_event(s, evs[i]); i = i + 1;
                if try s.close_requested catch false { break; }
            }
            if try s.close_requested catch false {
                s.graphics_stop = true;
                return false;
            }
            poll_tick(s);
            return try s.dirty catch true;
        },
        fn(s, w2) { draw(w2, s); },
        30);
    return 0;
}

// request_close(form) asks the active native event loop to terminate on its
// next bounded poll. It does not kill the process and is safe in headless tests.
fn request_close(f) {
    _cancel_drag(f);
    f.close_requested = true;
    f.dirty = true;
    return true;
}

// progress_bar(name, x, y, w, h, value) — a progress widget (value in [0,1]).
fn progress_bar(name, x, y, w, h, value) {
    return map{ kind: "progress", name: name, x: x, y: y, w: w, h: h, value: value };
}

// widget_count(f) — number of widgets on a form.
fn widget_count(f) { return len(f.widgets); }

// ── wave 2: more widgets + form introspection/mutation ───────────────────────────

// divider(name, x, y, w) — a thin horizontal rule.
fn divider(name, x, y, w) { return map{ kind: "divider", name: name, x: x, y: y, w: w, h: 2 }; }

// spacer(name, x, y, w, h) — an invisible layout gap.
fn spacer(name, x, y, w, h) { return map{ kind: "spacer", name: name, x: x, y: y, w: w, h: h }; }

// textarea(name, x, y, w, h, value) — a multi-line text input.
fn textarea(name, x, y, w, h, value) {
    return map{ kind: "textarea", name: name, x: x, y: y, w: w, h: h, value: value,
                max_chars: 65536, readonly: false, visible: true };
}

// Deterministic viewport policy used at launch and for native live-resize
// events. It is independent of the display backend and therefore testable for
// portrait, landscape, compact and large screens.
fn _bounded_ui_scale(width, height, options) {
    let explicit = try options.ui_scale catch nil;
    if type(explicit) == "number" {
        let scale = num_floor(explicit);
        if scale < 1 { scale = 1; } if scale > 4 { scale = 4; }
        return map{ scale: scale, source: "explicit" };
    }
    let dpi = try options.dpi catch nil;
    if type(dpi) == "number" and dpi > 0 {
        let scale = 1;
        if dpi >= 288 { scale = 3; }
        elif dpi >= 168 { scale = 2; }
        return map{ scale: scale, source: "dpi" };
    }
    if (try options.auto_scale catch false) != true {
        return map{ scale: 1, source: "baseline" };
    }
    let basis_h = try options.display_height catch height;
    let scale = 1;
    if basis_h >= 3000 { scale = 3; }
    elif basis_h >= 1800 { scale = 2; }
    return map{ scale: scale, source: "display-resolution-fallback" };
}

fn layout_profile(width, height, options = nil) {
    let w = num_floor(width); let h = num_floor(height);
    if w < 320 { w = 320; } if w > 7680 { w = 7680; }
    if h < 240 { h = 240; } if h > 4320 { h = 4320; }
    let scaling = _bounded_ui_scale(w, h, options);
    let ui_scale = scaling.scale;
    let logical_w = num_floor(w / ui_scale);
    let logical_h = num_floor(h / ui_scale);
    let density = str_lower(str(try options.density catch "auto"));
    if density != "compact" and density != "comfortable" { density = "auto"; }
    let compact = logical_w < 900 or logical_h < 620;
    if density == "compact" { compact = true; }
    if density == "comfortable" { compact = false; }
    let logical_pad = if compact { 10 } else { 16 };
    let logical_gap = if compact { 8 } else { 12 };
    let pad = logical_pad * ui_scale; let gap = logical_gap * ui_scale;
    let columns = if logical_w >= 960 and logical_w >= logical_h { 2 } else { 1 };
    let breakpoint = "large";
    if logical_w < 600 { breakpoint = "small"; }
    elif logical_w < 1200 { breakpoint = "medium"; }
    let orientation = if logical_w >= logical_h { "landscape" } else { "portrait" };
    let resolved_density = if compact { "compact" } else { "comfortable" };
    return map{ format: "pblang.gui.layout.v1", width: w, height: h,
                logical_width: logical_w, logical_height: logical_h,
                ui_scale: ui_scale, scale_source: scaling.source,
                font_pixel_scale: SCALE * ui_scale,
                minimum_target: 44 * ui_scale,
                control_height: 28 * ui_scale, row_height: 32 * ui_scale,
                breakpoint: breakpoint, orientation: orientation,
                compact: compact, density: resolved_density,
                columns: columns, padding: pad, gap: gap,
                content_width: w - pad * 2, content_height: h - pad * 2 };
}

fn logical_layout_profile(profile) {
    let scale = try profile.ui_scale catch 1;
    if scale < 1 { scale = 1; }
    let pad = num_floor(profile.padding / scale);
    let gap = num_floor(profile.gap / scale);
    return map{ format: profile.format,
        width: profile.logical_width, height: profile.logical_height,
        physical_width: profile.width, physical_height: profile.height,
        logical_width: profile.logical_width, logical_height: profile.logical_height,
        ui_scale: scale, scale_source: profile.scale_source,
        font_pixel_scale: profile.font_pixel_scale,
        minimum_target: num_floor(profile.minimum_target / scale),
        control_height: num_floor(profile.control_height / scale),
        row_height: num_floor(profile.row_height / scale),
        breakpoint: profile.breakpoint, orientation: profile.orientation,
        compact: profile.compact, density: profile.density, columns: profile.columns,
        padding: pad, gap: gap,
        content_width: profile.logical_width - pad * 2,
        content_height: profile.logical_height - pad * 2 };
}

fn scale_layout(f, scale) {
    let s = num_floor(scale);
    if s <= 1 { return f; }
    if s > 4 { s = 4; }
    let i = 0;
    while i < len(f.widgets) {
        let widget = f.widgets[i];
        widget.x = num_floor((try widget.x catch 0) * s);
        widget.y = num_floor((try widget.y catch 0) * s);
        widget.w = num_max(1, num_floor((try widget.w catch 1) * s));
        widget.h = num_max(1, num_floor((try widget.h catch 1) * s));
        i = i + 1;
    }
    return f;
}

fn _event_layout_options(f, ev) {
    let out = map{};
    let current = try f.layout_options catch nil;
    if type(current) == "map" {
        for key in map_keys(current) { out[key] = current[key]; }
    }
    let display_w = try ev.display_w catch nil;
    let display_h = try ev.display_h catch nil;
    if type(display_w) == "number" and display_w > 0 { out.display_width = display_w; }
    if type(display_h) == "number" and display_h > 0 { out.display_height = display_h; }
    f.layout_options = out;
    return out;
}

fn set_layout(f, layout_fn, options = nil) {
    f.layout_fn = layout_fn;
    f.layout_options = options;
    return f;
}

fn set_layout_options(f, options = nil) { f.layout_options = options; return f; }
fn set_resize_handler(f, handler = nil) { f.onresize = handler; return f; }
// Opt-in only. No default wheel behavior for existing controls/forms.
fn set_scroll_handler(f, handler = nil) { f.onscroll = handler; return f; }

// A tick handler must remain non-blocking. It is intended for draining worker
// channels and advancing small state machines, never for network or disk I/O.
fn set_tick_handler(f, handler = nil, interval_ms = 50) {
    if handler == nil {
        f.ontick = nil; f.tick_interval_ms = 0; f.next_tick_ms = 0;
        return f;
    }
    if type(interval_ms) != "number" or num_floor(interval_ms) != interval_ms
        or interval_ms < 10 or interval_ms > 60000 {
        throw "gui tick interval must be an integer from 10 to 60000 milliseconds";
    }
    f.ontick = handler;
    f.tick_interval_ms = interval_ms;
    f.next_tick_ms = 0;
    return f;
}

// poll_tick is public so headless tests and alternative GUI backends can drive
// exactly the same deterministic polling contract.
fn poll_tick(f, at_ms = nil) {
    if (try f.ontick catch nil) == nil or (try f.tick_interval_ms catch 0) <= 0 {
        return false;
    }
    // Runtime clocks may retain sub-millisecond precision. The implicit GUI
    // clock is normalized once; explicit timestamps remain strict so tests and
    // alternative event loops keep deterministic scheduling semantics.
    if at_ms == nil { at_ms = num_floor(now_ms()); }
    if type(at_ms) != "number" or num_floor(at_ms) != at_ms or at_ms < 0 {
        throw "gui tick time must be a non-negative integer";
    }
    if at_ms < (try f.next_tick_ms catch 0) { return false; }
    f.next_tick_ms = at_ms + f.tick_interval_ms;
    let changed = f.ontick(f);
    if changed == true { f.dirty = true; }
    return changed == true;
}

fn set_visible(f, name, visible) {
    let widget = get(f, name);
    if widget == nil or type(visible) != "bool" { return false; }
    widget.visible = visible;
    f.dirty = true;
    if not visible and f.focus == name { f.focus = nil; }
    if not visible and (try f.drag catch nil) == name { _cancel_drag(f); }
    return true;
}

fn set_enabled(f, name, enabled) {
    let widget = get(f, name);
    if widget == nil or type(enabled) != "bool" { return false; }
    widget.enabled = enabled;
    f.dirty = true;
    if not enabled and f.focus == name { f.focus = nil; }
    if not enabled and (try f.drag catch nil) == name { _cancel_drag(f); }
    return true;
}

fn relayout(f, width, height, options = nil) {
    _cancel_drag(f);
    if options == nil { options = try f.layout_options catch nil; }
    let profile = layout_profile(width, height, options);
    f.w = profile.width; f.h = profile.height; f.viewport = profile;
    if f.layout_fn != nil {
        let callback_profile = profile;
        if (try options.logical_layout catch false) == true {
            callback_profile = logical_layout_profile(profile);
        }
        f.layout_fn(f, callback_profile);
        if (try options.logical_layout catch false) == true {
            scale_layout(f, profile.ui_scale);
        }
    }
    f.dirty = true;
    return profile;
}

// has_widget(f, name) — true if a widget with this name exists on the form.
fn has_widget(f, name) { return get(f, name) != nil; }

// set_prop(f, name, key, value) — set a property on a named widget; true if applied.
fn set_prop(f, name, key, value) {
    let wgt = get(f, name);
    if wgt == nil { return false; }
    wgt[key] = value;
    f.dirty = true;
    return true;
}

// widget_kinds(f) — the distinct widget kinds present on the form.
fn widget_kinds(f) {
    let out = [];
    let i = 0;
    while i < len(f.widgets) {
        let k = try f.widgets[i].kind catch nil;
        let seen = false;
        let j = 0;
        while j < len(out) { if out[j] == k { seen = true; break; } j = j + 1; }
        if not seen and k != nil { array_push(out, k); }
        i = i + 1;
    }
    return out;
}

// remove_widget(f, name) — drop the widget with the given name (if present).
fn remove_widget(f, name) {
    if (try f.drag catch nil)==name { _cancel_drag(f); }
    if f.focus==name { f.focus=nil; }
    let kept = [];
    let i = 0;
    while i < len(f.widgets) {
        if (try f.widgets[i].name catch nil) != name { array_push(kept, f.widgets[i]); }
        i = i + 1;
    }
    f.widgets = kept;
    f.dirty = true;
    return f;
}

export theme, palette, custom_palette, set_palette, set_text_render,
       label, button, textbox, checkbox, panel, cube3d, sphere3d, image, radio, select, slider,
       form, add, fit_form, get, bind, set_model, sync, hit_test, handle_event, draw, run,
       request_close,
       progress_bar, widget_count, remove_widget,
       divider, spacer, textarea, layout_profile, logical_layout_profile, scale_layout,
       set_layout, set_layout_options,
       set_resize_handler, set_scroll_handler, set_tick_handler, poll_tick,
       set_visible, set_enabled, relayout, focus_next,
       has_widget, set_prop, widget_kinds;
