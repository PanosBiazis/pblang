// stdlib/gui.sapp — a desktop GUI widget toolkit, in pblang.
//
// pblang has no native widget set and no text-render builtin — only a window with filled
// rects/lines (graphics.sapp) and a 5x7 bitmap font (bitmap_font.sapp). This module draws
// its own widgets from those primitives and hit-tests the mouse itself, giving a
// Delphi/Qt-style form: a `form` holds positioned `widgets`, `run` opens a window and
// drives the event loop, and event handlers ride as **closures stored in widget fields**.
//
//   let gui = import("stdlib/gui.sapp");
//   fn on_ok(ctx) { print gui.get(ctx, "name").value; }
//   fn build() {
//       let f = gui.form("Hello", 360, 200);
//       gui.add(f, gui.label("t", 20, 16, "Your name:"));
//       gui.add(f, gui.textbox("name", 20, 44, 220, 26, ""));
//       gui.add(f, gui.button("ok", 20, 84, 120, 30, "OK", on_ok));
//       return f;
//   }
//   fn main() { gui.run(build()); }  main();
//
// The interactive core (`handle_event`) is window-free so it is unit-testable headlessly;
// only `draw`/`run` touch a display. The designer's D3 GUI kind generates code against it.

let gfx  = import("stdlib/graphics.sapp");
let font = import("stdlib/bitmap_font.sapp");
let keys = import("stdlib/keymap.sapp");

// ── metrics & theme ───────────────────────────────────────────────────────────────────
let SCALE = 2;          // bitmap-font pixel scale
let CW = 12;            // scaled char advance  (font.char_width()  * SCALE)
let CH = 16;            // scaled char height   (font.char_height() * SCALE)
let _C = map{
    bg:     gfx.rgb(30, 33, 48),
    panel:  gfx.rgb(44, 49, 70),
    field:  gfx.rgb(20, 22, 34),
    border: gfx.rgb(90, 100, 140),
    accent: gfx.rgb(108, 92, 231),
    text:   gfx.rgb(225, 230, 245),
    muted:  gfx.rgb(150, 160, 185)
};
fn theme() { return _C; }   // exposed so apps can reuse the palette

// ── widget constructors ───────────────────────────────────────────────────────────────
// Every widget is a map with at least {kind, name, x, y, w, h}. Auto-sized widgets
// (label/checkbox) compute w/h from their text so hit-testing has a real box.
fn label(name, x, y, text) {
    return map{ kind: "label", name: name, x: x, y: y, w: len(text) * CW, h: CH, text: text };
}
fn button(name, x, y, w, h, text, onclick) {
    return map{ kind: "button", name: name, x: x, y: y, w: w, h: h, text: text, onclick: onclick };
}
fn textbox(name, x, y, w, h, value) {
    return map{ kind: "textbox", name: name, x: x, y: y, w: w, h: h, value: value,
                max_chars: 4096, readonly: false, visible: true };
}
fn checkbox(name, x, y, text, checked, onchange) {
    return map{ kind: "checkbox", name: name, x: x, y: y, w: CH + 6 + len(text) * CW, h: CH,
                text: text, checked: checked, onchange: onchange };
}
fn panel(name, x, y, w, h, title) {
    return map{ kind: "panel", name: name, x: x, y: y, w: w, h: h, title: title };
}
fn cube3d(name, x, y, w, h, text) {
    return map{ kind: "cube3d", name: name, x: x, y: y, w: w, h: h, text: text };
}
fn sphere3d(name, x, y, w, h, text) {
    return map{ kind: "sphere3d", name: name, x: x, y: y, w: w, h: h, text: text };
}
// image widget — img is a 2D pixel array (img[y][x] = packed gfx color), or nil for a
// placeholder. Nearest-neighbour scaled to the widget box at draw time.
fn image(name, x, y, w, h, img) {
    return map{ kind: "image", name: name, x: x, y: y, w: w, h: h, img: img };
}
// radio button: radios sharing `group` are mutually exclusive (selecting one clears its
// siblings). Auto-sized like checkbox.
fn radio(name, x, y, text, group, selected, onchange) {
    return map{ kind: "radio", name: name, x: x, y: y, w: CH + 6 + len(text) * CW, h: CH,
                text: text, group: group, selected: selected, onchange: onchange };
}
// select (cycle combo): clicking advances to the next option (wraps). `options` is a list
// of strings, `selected` an index. (A drawn-from-primitives GUI has no native popup, so
// this is an honest click-to-cycle select rather than a dropdown overlay.)
fn select(name, x, y, w, h, options, selected, onchange) {
    return map{ kind: "select", name: name, x: x, y: y, w: w, h: h,
                options: options, selected: selected, onchange: onchange };
}
// horizontal slider: drag the knob to set `value` in [min, max].
fn slider(name, x, y, w, h, value, min, max, onchange) {
    return map{ kind: "slider", name: name, x: x, y: y, w: w, h: h,
                value: value, min: min, max: max, onchange: onchange };
}

// ── form container ────────────────────────────────────────────────────────────────────
fn form(title, w, h) {
    return map{ kind: "form", title: title, w: w, h: h, widgets: [],
                focus: nil, shift: false, mouse: map{ x: 0, y: 0 }, model: map{},
                layout_fn: nil, layout_options: nil, onresize: nil,
                resize_count: 0, viewport: map{ width: w, height: h } };
}
fn add(f, w) { array_push(f.widgets, w); _pull(f, w); return f; }

fn fit_form(f, min_w = 360, min_h = 220, pad = 40) {
    let w = min_w;
    let h = min_h;
    let i = 0;
    while i < len(f.widgets) {
        let it = f.widgets[i];
        let right = (try it.x catch 0) + (try it.w catch 0) + pad;
        let bottom = (try it.y catch 0) + (try it.h catch 0) + pad;
        if right > w { w = right; }
        if bottom > h { h = bottom; }
        i = i + 1;
    }
    f.w = w;
    f.h = h;
    return f;
}
fn get(f, name) {
    let i = 0;
    while i < len(f.widgets) { if f.widgets[i].name == name { return f.widgets[i]; } i = i + 1; }
    return nil;
}

// ── data-binding (Visual_Designer §7) ─────────────────────────────────────────────────
// The form's `model` map is the source of truth. A widget bound to a model field (via
// `bind`) PUSHES its value into the model when the user changes it and PULLS the model's
// value on redraw / sync — so toggling a checkbox updates state, and a handler that writes
// the model re-displays in the bound widget. Two-way for inputs, one-way for labels.
fn bind(w, field) { w["bind"] = field; return w; }
fn set_model(f, m) { f["model"] = m; sync(f); return f; }
// which widget property mirrors the model for each kind ("" = not bindable)
fn _bound_key(w) {
    let k = w.kind;
    if k == "textbox" or k == "textarea" { return "value"; }
    if k == "checkbox" { return "checked"; }
    if k == "slider" { return "value"; }
    if k == "select" { return "selected"; }
    if k == "label" { return "text"; }
    return "";
}
fn _push(f, w) {                            // widget value -> model
    let b = try w.bind catch nil;
    if b == nil { return 0; }
    let key = _bound_key(w);
    if key != "" { f.model[b] = w[key]; }
    return 0;
}
fn _pull(f, w) {                            // model value -> widget
    let b = try w.bind catch nil;
    if b == nil { return 0; }
    if not map_has(f.model, b) { return 0; }
    let key = _bound_key(w);
    if key != "" { w[key] = f.model[b]; }
    return 0;
}
// sync(form) — refresh every bound widget from the model (call after a handler mutates it).
fn sync(f) {
    let i = 0;
    while i < len(f.widgets) { _pull(f, f.widgets[i]); i = i + 1; }
    return 0;
}

// ── interactive core (window-free → testable) ─────────────────────────────────────────
fn _in(w, x, y) {
    if (try w.visible catch true) == false { return false; }
    return x >= w.x and x < w.x + w.w and y >= w.y and y < w.y + w.h;
}
fn _focused(f) { if f.focus == nil { return nil; } return get(f, f.focus); }

// hit_test(form, x, y) -> the topmost widget under (x, y), or nil. Last-added wins so
// widgets drawn on top of a panel take the click.
fn hit_test(f, x, y) {
    let hit = nil;
    let i = 0;
    while i < len(f.widgets) { if _in(f.widgets[i], x, y) { hit = f.widgets[i]; } i = i + 1; }
    return hit;
}

fn _type_into(f, w, key, shift) {
    if w == nil or (w.kind != "textbox" and w.kind != "textarea") { return 0; }
    if try w.readonly catch false { return 0; }
    if key == "Backspace" {
        if len(w.value) > 0 { w["value"] = str_slice(w.value, 0, len(w.value) - 1); _push(f, w); }
        return 0;
    }
    let ch = keys.key_to_char(key, shift);
    if w.kind == "textarea" and key == "Enter" { ch = "\n"; }
    let max_chars = try w.max_chars catch 4096;
    if ch != "" and len(w.value) < max_chars { w["value"] = w.value + ch; _push(f, w); }
    return 0;
}

// clamp helper
fn _clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }
// set a slider's value from an absolute mouse x (knob follows the cursor along the track).
fn _slider_set(w, x) {
    let span = w.w; if span <= 0 { span = 1; }
    let t = _clamp((x - w.x) / span, 0, 1);
    w["value"] = w.min + t * (w.max - w.min);
    return 0;
}
// select the radio `w` and clear every sibling in the same group.
fn _radio_pick(f, w) {
    let i = 0;
    while i < len(f.widgets) {
        let o = f.widgets[i];
        if o.kind == "radio" and o.group == w.group { o["selected"] = (o.name == w.name); }
        i = i + 1;
    }
    return 0;
}

fn _click_at(f, x, y) {
    f["focus"] = nil;                          // empty space clears focus
    let w = hit_test(f, x, y);
    if w == nil { return 0; }
    if w.kind == "textbox" or w.kind == "textarea" { f["focus"] = w.name; }
    else if w.kind == "checkbox" {
        w["checked"] = not w.checked;
        _push(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "radio" {
        _radio_pick(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "select" {
        let n = len(w.options);
        if n > 0 { w["selected"] = num_mod(w.selected + 1, n); _push(f, w); if w.onchange != nil { w.onchange(f); } }
    }
    else if w.kind == "slider" {
        _slider_set(w, x);
        _push(f, w);
        if w.onchange != nil { w.onchange(f); }
    }
    else if w.kind == "button" {
        if w.onclick != nil { w.onclick(f); }
    }
    return 0;
}

// handle_event(form, ev) — apply one gfxpollevents record (mousemove/mousedown/mouseup/
// keydown/keyup). mousedown carries no coords, so we read the cursor tracked from mousemove.
// A press on a slider starts a drag (f.drag) so the knob tracks the cursor until release.
fn handle_event(f, ev) {
    let t = try ev.type catch "";
    if t == "resize" {
        let width = try ev.w catch -1; let height = try ev.h catch -1;
        if type(width) != "number" or type(height) != "number" or width <= 0 or height <= 0 { return 0; }
        let previous_w = f.w; let previous_h = f.h;
        let profile = relayout(f, width, height, try f.layout_options catch nil);
        if profile.width != previous_w or profile.height != previous_h {
            f.resize_count = (try f.resize_count catch 0) + 1;
            if (try f.onresize catch nil) != nil { f.onresize(f, profile); }
        }
        return 0;
    }
    if t == "mousemove" {
        f["mouse"] = map{ x: ev.x, y: ev.y };
        if (try f.drag catch nil) != nil {
            let w = get(f, f.drag);
            if w != nil and w.kind == "slider" { _slider_set(w, ev.x); _push(f, w); if w.onchange != nil { w.onchange(f); } }
        }
        return 0;
    }
    if t == "mousedown" {
        if (try ev.button catch "Left") != "Left" { return 0; }
        let hit = hit_test(f, f.mouse.x, f.mouse.y);
        if hit != nil and hit.kind == "slider" { f["drag"] = hit.name; }
        _click_at(f, f.mouse.x, f.mouse.y);
        return 0;
    }
    if t == "mouseup" { f["drag"] = nil; return 0; }
    if t == "keydown" {
        let k = try ev.key catch "";
        if keys.is_shift(k) { f["shift"] = true; return 0; }
        _type_into(f, _focused(f), k, f.shift);
        return 0;
    }
    if t == "keyup" {
        let k = try ev.key catch "";
        if keys.is_shift(k) { f["shift"] = false; }
        return 0;
    }
    return 0;
}

// ── rendering (display) ───────────────────────────────────────────────────────────────
fn _border(win, x, y, w, h, color) {
    win.line(x, y, x + w, y, color);
    win.line(x, y + h, x + w, y + h, color);
    win.line(x, y, x, y + h, color);
    win.line(x + w, y, x + w, y + h, color);
}
// scaled bitmap text: each lit 5x7 pixel becomes one SCALE×SCALE filled rect.
fn _text(win, x, y, s, color) {
    let cx = x;
    let i = 0;
    while i < len(s) {
        let code = strcharcodeat(s, i);
        if code != 32 {
            let g = font.glyph(code);
            if g == nil { g = [31, 17, 17, 17, 17, 17, 31]; }
            let r = 0;
            while r < 7 {
                let row = g[r];
                let c = 0;
                while c < 5 {
                    if bit_and(bit_shr(row, 4 - c), 1) == 1 {
                        win.rect(cx + c * SCALE, y + r * SCALE, SCALE, SCALE, color);
                    }
                    c = c + 1;
                }
                r = r + 1;
            }
        }
        cx = cx + CW;
        i = i + 1;
    }
    return cx;
}

fn _fit_text(value, pixel_width) {
    let text = str(value);
    let chars = num_floor(pixel_width / CW);
    if chars <= 0 { return ""; }
    if len(text) <= chars { return text; }
    if chars <= 3 { return str_slice(text, 0, chars); }
    return str_slice(text, 0, chars - 3) + "...";
}

fn _text_lines(win, x, y, w, h, value, color) {
    let lines = str_split(str(value), "\n");
    let max_rows = num_floor(h / CH);
    let i = 0;
    while i < len(lines) and i < max_rows {
        _text(win, x, y + i * CH, _fit_text(lines[i], w), color);
        i = i + 1;
    }
    return i;
}
fn _draw_widget(win, f, w) {
    if (try w.visible catch true) == false { return 0; }
    _pull(f, w);                              // bound widgets mirror the model each frame
    let ty = w.y + (w.h - 14) / 2;            // vertical text centering (glyph ≈ 14px tall)
    if w.kind == "label" {
        _text(win, w.x, w.y, _fit_text(w.text, w.w), _C.text);
    } else if w.kind == "button" {
        win.rect(w.x, w.y, w.w, w.h, _C.accent);
        _border(win, w.x, w.y, w.w, w.h, _C.border);
        _text(win, w.x + 8, ty, _fit_text(w.text, w.w - 16), _C.text);
    } else if w.kind == "textbox" {
        win.rect(w.x, w.y, w.w, w.h, _C.field);
        let bc = _C.border;
        if f.focus == w.name { bc = _C.accent; }
        _border(win, w.x, w.y, w.w, w.h, bc);
        _text(win, w.x + 6, ty, _fit_text(w.value, w.w - 12), _C.text);
    } else if w.kind == "textarea" {
        win.rect(w.x, w.y, w.w, w.h, _C.field);
        let bc = _C.border;
        if f.focus == w.name { bc = _C.accent; }
        _border(win, w.x, w.y, w.w, w.h, bc);
        _text_lines(win, w.x + 6, w.y + 6, w.w - 12, w.h - 12, w.value, _C.text);
    } else if w.kind == "checkbox" {
        win.rect(w.x, w.y, CH, CH, _C.field);
        _border(win, w.x, w.y, CH, CH, _C.border);
        if w.checked { _text(win, w.x + 3, w.y + 1, "X", _C.accent); }
        _text(win, w.x + CH + 6, w.y + 1, w.text, _C.text);
    } else if w.kind == "panel" {
        win.rect(w.x, w.y, w.w, w.h, _C.panel);
        _border(win, w.x, w.y, w.w, w.h, _C.border);
        if w.title != "" { _text(win, w.x + 6, w.y + 4, w.title, _C.muted); }
    } else if w.kind == "cube3d" {
        let off = 12;
        let face = _C.accent;
        let side = gfx.rgb(50, 42, 118);
        let top = gfx.rgb(115, 103, 240);
        win.rect(w.x + off, w.y, w.w, w.h, top);
        win.rect(w.x, w.y + off, w.w, w.h, face);
        win.rect(w.x + w.w, w.y + off, off, w.h, side);
        _border(win, w.x, w.y + off, w.w, w.h, _C.border);
        _border(win, w.x + off, w.y, w.w, w.h, _C.muted);
        _text(win, w.x + 6, w.y + w.h + off + 6, w.text, _C.text);
    } else if w.kind == "sphere3d" {
        let steps = 7;
        let i = 0;
        while i < steps {
            let inset = i * 4;
            let shade = gfx.rgb(46 + i * 14, 224 - i * 19, 189 - i * 12);
            win.rect(w.x + inset, w.y + inset, w.w - inset * 2, w.h - inset * 2, shade);
            i = i + 1;
        }
        _border(win, w.x, w.y, w.w, w.h, _C.border);
        _text(win, w.x + 6, w.y + w.h + 6, w.text, _C.text);
    } else if w.kind == "radio" {
        win.circle(w.x + CH / 2, w.y + CH / 2, CH / 2 - 1, _C.border);
        if w.selected { win.rect(w.x + CH / 2 - 3, w.y + CH / 2 - 3, 6, 6, _C.accent); }
        _text(win, w.x + CH + 6, w.y + 1, w.text, _C.text);
    } else if w.kind == "select" {
        win.rect(w.x, w.y, w.w, w.h, _C.field);
        _border(win, w.x, w.y, w.w, w.h, _C.border);
        let opt = "";
        if len(w.options) > 0 and w.selected >= 0 and w.selected < len(w.options) { opt = w.options[w.selected]; }
        _text(win, w.x + 6, ty, opt, _C.text);
        _text(win, w.x + w.w - 14, ty, "v", _C.muted);
    } else if w.kind == "slider" {
        let cy = w.y + w.h / 2;
        win.line(w.x, cy, w.x + w.w, cy, _C.border);
        let span = w.max - w.min; if span == 0 { span = 1; }
        let t = _clamp((w.value - w.min) / span, 0, 1);
        let kx = w.x + t * w.w;
        win.rect(kx - 4, w.y + 2, 8, w.h - 4, _C.accent);
    } else if w.kind == "progress" {
        win.rect(w.x, w.y, w.w, w.h, _C.field);
        let value = _clamp(try w.value catch 0, 0, 1);
        let filled = num_floor(w.w * value);
        if filled > 0 { win.rect(w.x, w.y, filled, w.h, _C.accent); }
        _border(win, w.x, w.y, w.w, w.h, _C.border);
    } else if w.kind == "divider" {
        win.rect(w.x, w.y, w.w, w.h, _C.border);
    } else if w.kind == "spacer" {
        return 0;
    } else if w.kind == "image" {
        win.rect(w.x, w.y, w.w, w.h, _C.field);
        let img = try w.img catch nil;
        if img != nil and len(img) > 0 and len(img[0]) > 0 {
            let ih = len(img);
            let iw = len(img[0]);
            let py = 0;
            while py < w.h {
                let sy = num_floor(py * ih / w.h);
                let px = 0;
                while px < w.w {
                    let sx = num_floor(px * iw / w.w);
                    win.point(w.x + px, w.y + py, img[sy][sx]);
                    px = px + 1;
                }
                py = py + 1;
            }
        } else {
            _text(win, w.x + 6, w.y + 6, "(no frame)", _C.muted);
        }
        _border(win, w.x, w.y, w.w, w.h, _C.border);
    }
}
fn draw(win, f) {
    win.clear(_C.bg);
    let i = 0;
    while i < len(f.widgets) { _draw_widget(win, f, f.widgets[i]); i = i + 1; }
    return 0;
}

// ── run ───────────────────────────────────────────────────────────────────────────────
// Open a window for the form and drive the 30 fps event loop. Blocks until the window
// closes. (draw/run are the only display-dependent parts of this module.)
fn run(f) {
    relayout(f, f.w, f.h);
    let win = gfx.Window(f.w, f.h, f.title);
    gfx.run(win, f,
        fn(s, evs) { let i = 0; while i < len(evs) { handle_event(s, evs[i]); i = i + 1; } },
        fn(s, w2) { draw(w2, s); },
        30);
    return 0;
}

// progress_bar(name, x, y, w, h, value) — a progress widget (value in [0,1]).
fn progress_bar(name, x, y, w, h, value) {
    return map{ kind: "progress", name: name, x: x, y: y, w: w, h: h, value: value };
}

// widget_count(f) — number of widgets on a form.
fn widget_count(f) { return len(f.widgets); }

// ── wave 2: more widgets + form introspection/mutation ───────────────────────────

// divider(name, x, y, w) — a thin horizontal rule.
fn divider(name, x, y, w) { return map{ kind: "divider", name: name, x: x, y: y, w: w, h: 2 }; }

// spacer(name, x, y, w, h) — an invisible layout gap.
fn spacer(name, x, y, w, h) { return map{ kind: "spacer", name: name, x: x, y: y, w: w, h: h }; }

// textarea(name, x, y, w, h, value) — a multi-line text input.
fn textarea(name, x, y, w, h, value) {
    return map{ kind: "textarea", name: name, x: x, y: y, w: w, h: h, value: value,
                max_chars: 65536, readonly: false, visible: true };
}

// Deterministic viewport policy used at launch and for native live-resize
// events. It is independent of the display backend and therefore testable for
// portrait, landscape, compact and large screens.
fn layout_profile(width, height, options = nil) {
    let w = num_floor(width); let h = num_floor(height);
    if w < 320 { w = 320; } if w > 7680 { w = 7680; }
    if h < 240 { h = 240; } if h > 4320 { h = 4320; }
    let density = str_lower(str(try options.density catch "auto"));
    if density != "compact" and density != "comfortable" { density = "auto"; }
    let compact = w < 900 or h < 620;
    if density == "compact" { compact = true; }
    if density == "comfortable" { compact = false; }
    let pad = if compact { 10 } else { 16 };
    let gap = if compact { 8 } else { 12 };
    let columns = if w >= 960 and w >= h { 2 } else { 1 };
    return map{ format: "pblang.gui.layout.v1", width: w, height: h,
                orientation: if w >= h { "landscape" } else { "portrait" },
                compact: compact, density: if compact { "compact" } else { "comfortable" },
                columns: columns, padding: pad, gap: gap,
                content_width: w - pad * 2, content_height: h - pad * 2 };
}

fn set_layout(f, layout_fn, options = nil) {
    f.layout_fn = layout_fn;
    f.layout_options = options;
    return f;
}

fn set_layout_options(f, options = nil) { f.layout_options = options; return f; }
fn set_resize_handler(f, handler = nil) { f.onresize = handler; return f; }

fn set_visible(f, name, visible) {
    let widget = get(f, name);
    if widget == nil or type(visible) != "bool" { return false; }
    widget.visible = visible;
    if not visible and f.focus == name { f.focus = nil; }
    return true;
}

fn relayout(f, width, height, options = nil) {
    if options == nil { options = try f.layout_options catch nil; }
    let profile = layout_profile(width, height, options);
    f.w = profile.width; f.h = profile.height; f.viewport = profile;
    if f.layout_fn != nil { f.layout_fn(f, profile); }
    return profile;
}

// has_widget(f, name) — true if a widget with this name exists on the form.
fn has_widget(f, name) { return get(f, name) != nil; }

// set_prop(f, name, key, value) — set a property on a named widget; true if applied.
fn set_prop(f, name, key, value) {
    let wgt = get(f, name);
    if wgt == nil { return false; }
    wgt[key] = value;
    return true;
}

// widget_kinds(f) — the distinct widget kinds present on the form.
fn widget_kinds(f) {
    let out = [];
    let i = 0;
    while i < len(f.widgets) {
        let k = try f.widgets[i].kind catch nil;
        let seen = false;
        let j = 0;
        while j < len(out) { if out[j] == k { seen = true; break; } j = j + 1; }
        if not seen and k != nil { array_push(out, k); }
        i = i + 1;
    }
    return out;
}

// remove_widget(f, name) — drop the widget with the given name (if present).
fn remove_widget(f, name) {
    let kept = [];
    let i = 0;
    while i < len(f.widgets) {
        if (try f.widgets[i].name catch nil) != name { array_push(kept, f.widgets[i]); }
        i = i + 1;
    }
    f.widgets = kept;
    return f;
}

export theme, label, button, textbox, checkbox, panel, cube3d, sphere3d, image, radio, select, slider,
       form, add, fit_form, get, bind, set_model, sync, hit_test, handle_event, draw, run,
       progress_bar, widget_count, remove_widget,
       divider, spacer, textarea, layout_profile, set_layout, set_layout_options,
       set_resize_handler, set_visible, relayout,
       has_widget, set_prop, widget_kinds;
