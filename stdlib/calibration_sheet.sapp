// Bounded caller-supplied reference points; no device I/O or certification.
let Samples=import("stdlib:sample_series.sapp");let Fields=import("stdlib:template_fields.sapp");
let FORMAT="pblang.calibration-sheet.v1";
fn _number(value) {return type(value)=="number" and value==value and value-value==0 and value>=-1000000000 and value<=1000000000;}
fn validate(model) {
 if type(model)!="map" or len(model)!=4 or (try model.format catch nil)!=FORMAT or not Fields.valid_name(try model.input_unit catch nil) or not Fields.valid_name(try model.output_unit catch nil) or type(try model.points catch nil)!="array" or len(model.points)<2 or len(model.points)>64 {throw "calibration: invalid model";}
 let previous=nil;
 for point in model.points {
  if type(point)!="map" or len(point)!=2 or not _number(try point.input catch nil) or not _number(try point.output catch nil) {throw "calibration: invalid reference point";}
  if previous!=nil and point.input<=previous {throw "calibration: reference inputs must increase";}previous=point.input;
 }
 return true;
}
fn make(points,input_unit,output_unit) {
 let model=map{format:FORMAT,input_unit:input_unit,output_unit:output_unit,points:points};validate(model);
 let copy=[];for point in points {array_push(copy,map{input:point.input,output:point.output});}model.points=copy;return model;
}
fn estimate(model,queries) {
 validate(model);
 if type(queries)!="array" or len(queries)<1 or len(queries)>256 {throw "calibration: query count limit";}
 for query in queries {if not _number(query) {throw "calibration: invalid query";}}
 let xs=[];let ys=[];for point in model.points {array_push(xs,point.input);array_push(ys,point.output);}
 return Samples.interpolate(xs,ys,queries);
}
fn review(model,checks) {
 validate(model);
 if type(checks)!="array" or len(checks)>256 {throw "calibration: check count limit";}
 let seen=map{};let queries=[];
 for check in checks {
  if type(check)!="map" or len(check)!=3 or not Fields.valid_name(try check.id catch nil) or not _number(try check.input catch nil) or not _number(try check.expected catch nil) {throw "calibration: invalid check";}
  if map_has(seen,check.id) {throw "calibration: duplicate check identifier";}seen[check.id]=true;array_push(queries,check.input);
 }
 let rows=[];let max_abs=0;let total=0;let squares=0;
 if len(checks)>0 {
  let values=estimate(model,queries);
  for i in range(0,len(checks)) {
   let residual=values[i]-checks[i].expected;let magnitude=num_abs(residual);total=total+magnitude;squares=squares+residual*residual;
   if magnitude>max_abs {max_abs=magnitude;}
   array_push(rows,map{id:checks[i].id,estimate:values[i],residual:residual});
  }
 }
 let mean_abs=if len(rows)>0 {total/len(rows)} else {nil};
 let rmse=if len(rows)>0 {num_sqrt(squares/len(rows))} else {nil};
 let maximum=if len(rows)>0 {max_abs} else {nil};
 return map{format:"pblang.calibration-review.v1",output_unit:model.output_unit,rows:rows,count:len(rows),max_abs_residual:maximum,mean_abs_residual:mean_abs,rmse:rmse,raw_checks_included:false,reference_points_included:false,physical_calibration_verified:false};
}
export FORMAT,validate,make,estimate,review;
