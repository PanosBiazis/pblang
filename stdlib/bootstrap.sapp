//! bootstrap.sapp — Self-hosting bootstrap script for pblang
//! Uses the 4-stage pblang compiler (tokenizer → parser → type_checker → codegen)
//! to compile pblang source files into bytecode, enabling full self-hosting.
//!
//! Usage: pblang run bootstrap.sapp -- --input <file.sapp> --output <file.pbc>
//!
//! Pipeline:
//!   1. Read source file
//!   2. Tokenize (compiler/tokenizer.sapp)
//!   3. Parse (compiler/parser.sapp)
//!   4. Type-check (compiler/typeck.sapp)
//!   5. Generate bytecode (compiler/codegen.sapp)
//!   6. Write bytecode file

let tokenizer = import("stdlib:compiler/tokenizer.sapp");
let parser_mod = import("stdlib:compiler/parser.sapp");
let typeck = import("stdlib:compiler/typeck.sapp");
let codegen = import("stdlib:compiler/codegen.sapp");

/// Bootstrap: compile a source file through all 4 stages
fn bootstrap_compile(source_path, output_path = nil) {
    if output_path == nil { output_path = source_path + ".pbc"; }

    // Stage 1: Read source
    let source = fs_read(source_path);
    if source == nil or source == "" {
        print("ERROR: cannot read " + source_path);
        return false;
    }
    
    // Stage 2: Tokenize
    let tokens = tokenizer.tokenize(source);
    print("Stage 1: Tokenized → " + str(len(tokens)) + " tokens");
    
    // Stage 3: Parse
    let ast = parser_mod.parse(tokens);
    print("Stage 2: Parsed → " + str(len(ast)) + " statements");
    
    // Stage 4: Type check
    let diagnostics = typeck.type_check(ast);
    if len(diagnostics) > 0 {
        print("Stage 3: Type errors found:");
        let i = 0;
        while i < len(diagnostics) {
            print("  " + diagnostics[i]["message"]);
            i = i + 1;
        }
        print("WARNING: Continuing with code generation despite type errors");
    } else {
        print("Stage 3: Type check passed ✓");
    }
    
    // Stage 5: Code generation
    let chunk = codegen.compile_stmts(ast);
    print("Stage 4: Generated bytecode → " + str(len(chunk["instructions"])) + " instructions, " + str(len(chunk["constants"])) + " constants");
    
    // Stage 6: Write output
    let output = json_stringify(chunk);
    let ok = fs_write(output_path, output);
    if ok {
        print("Bootstrap complete: " + output_path);
        return true;
    }
    print("ERROR: failed to write " + output_path);
    return false;
}

/// Bootstrap: compile all .sapp files in a directory
fn bootstrap_compile_dir(dir_path, output_dir = nil) {
    if output_dir == nil { output_dir = dir_path + "/../bootstrap_out"; }

    let files = fs_listdir(dir_path);
    if files == nil or len(files) == 0 {
        print("No files found in " + dir_path);
        return false;
    }
    
    let ok = fs_mkdirs(output_dir);
    
    let count = 0;
    let i = 0;
    while i < len(files) {
        let file = files[i];
        if str_contains(file, ".sapp") {
            let input = dir_path + "/" + file;
            let output = output_dir + "/" + file + ".pbc";
            let result = bootstrap_compile(input, output);
            if result { count = count + 1; }
        }
        i = i + 1;
    }
    
    print("Bootstrap directory complete: " + str(count) + " files compiled to " + output_dir);
    return count > 0;
}

/// Self-test: try to compile the compiler itself!
fn bootstrap_self_test() {
    print("=== BOOTSTRAP SELF-TEST ===");
    print("Attempting to compile the pblang compiler using itself...");
    
    let compiler_files = [
        "stdlib/compiler/tokenizer.sapp",
        "stdlib/compiler/parser.sapp",
        "stdlib/compiler/typeck.sapp",
        "stdlib/compiler/codegen.sapp"
    ];
    
    let ok = fs_mkdirs("bootstrap_out");
    
    let i = 0;
    while i < len(compiler_files) {
        let path = compiler_files[i];
        if fs_exists(path) {
            let out = "bootstrap_out/" + path;
            let parts = [];
            let cur = "";
            let j = 0;
            while j < len(out) {
                if out[j..(j+1)] == "/" { array_push(parts, cur); cur = ""; }
                else { cur = cur + out[j..(j+1)]; }
                j = j + 1;
            }
            // Ensure directory exists
            let dir = "";
            let k = 0;
            while k < len(parts) - 1 { dir = dir + "/" + parts[k]; k = k + 1; }
            if dir != "" { let _ = fs_mkdirs(dir); }
            
            print("Compiling " + path + " → " + out);
            bootstrap_compile(path, out);
        }
        i = i + 1;
    }
    
    print("=== SELF-TEST COMPLETE ===");
    print("Check bootstrap_out/ for compiled bytecode files");
}

// Parse command line args
fn main() {
    let args = [];
    // args would be populated from CLI in real usage
    
    print("pblang Bootstrap Compiler v0.5.7");
    print("4-stage pipeline: tokenize → parse → type-check → codegen");
    print("");
    print("Usage: pblang run bootstrap.sapp -- <file.sapp>");
    print("       pblang run bootstrap.sapp -- --dir <directory>");
    print("       pblang run bootstrap.sapp -- --self-test");
    print("");
    
    bootstrap_self_test();
}

main();

export bootstrap_compile;
export bootstrap_compile_dir;
export bootstrap_self_test;
