// stdlib/algo.sapp — Algorithms: sorting, searching, binary search, common patterns
//
// Usage:
//   let algo = import("stdlib:algo.sapp");
//   let idx = algo.binary_search(sorted_arr, 42);
//   let sorted = algo.merge_sort(arr);
//   let gcd = algo.gcd(48, 18);

// binary_search(arr, target) → index or -1 (requires sorted array)
fn binary_search(arr, target) {
    let lo = 0;
    let hi = len(arr) - 1;
    while lo <= hi {
        let mid = num_floor((lo + hi) / 2);
        if arr[mid] == target { return mid; }
        if arr[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

// lower_bound(arr, val) → first index where arr[i] >= val
fn lower_bound(arr, val) {
    let lo = 0;
    let hi = len(arr);
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if arr[mid] < val { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

// upper_bound(arr, val) → first index where arr[i] > val
fn upper_bound(arr, val) {
    let lo = 0;
    let hi = len(arr);
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if arr[mid] <= val { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

// gcd(a, b) → greatest common divisor (Euclidean algorithm)
fn gcd(a, b) {
    let x = num_abs(a);
    let y = num_abs(b);
    while y > 0 {
        let tmp = num_mod(x, y);
        x = y;
        y = tmp;
    }
    return x;
}

// lcm(a, b) → least common multiple
fn lcm(a, b) {
    if a == 0 or b == 0 { return 0; }
    return num_abs(a * b) / gcd(a, b);
}

// is_prime(n) → bool
fn is_prime(n) {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if num_mod(n, 2) == 0 { return false; }
    let i = 3;
    while i * i <= n {
        if num_mod(n, i) == 0 { return false; }
        i = i + 2;
    }
    return true;
}

// primes_up_to(n) → array of primes <= n (Sieve of Eratosthenes)
fn primes_up_to(n) {
    if n < 2 { return []; }
    // Simple trial division (sieve would require mutable array marking)
    let result = [];
    let i = 2;
    while i <= n {
        if is_prime(i) { array_push(result, i); }
        i = i + 1;
    }
    return result;
}

// fibonacci(n) → nth Fibonacci number (0-indexed: fib(0)=0, fib(1)=1)
fn fibonacci(n) {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    let a = 0;
    let b = 1;
    let i = 2;
    while i <= n {
        let c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

// factorial(n) → n!
fn factorial(n) {
    if n <= 1 { return 1; }
    let result = 1;
    let i = 2;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

// merge_sort(arr) → new sorted array (O(n log n))
fn merge_sort(arr) {
    let n = len(arr);
    if n <= 1 { return arr; }
    let mid = num_floor(n / 2);
    let left = merge_sort(array_take(arr, mid));
    let right = merge_sort(array_drop(arr, mid));
    return _merge(left, right);
}

fn _merge(a, b) {
    let result = [];
    let i = 0;
    let j = 0;
    while i < len(a) and j < len(b) {
        if a[i] <= b[j] {
            array_push(result, a[i]);
            i = i + 1;
        } else {
            array_push(result, b[j]);
            j = j + 1;
        }
    }
    while i < len(a) { array_push(result, a[i]); i = i + 1; }
    while j < len(b) { array_push(result, b[j]); j = j + 1; }
    return result;
}

// flatten(arr) → recursively flatten nested arrays
fn flatten(arr) {
    let result = [];
    let i = 0;
    while i < len(arr) {
        if is_array(arr[i]) {
            let sub = flatten(arr[i]);
            let j = 0;
            while j < len(sub) { array_push(result, sub[j]); j = j + 1; }
        } else {
            array_push(result, arr[i]);
        }
        i = i + 1;
    }
    return result;
}

// combinations(arr, k) → all k-length combinations
fn combinations(arr, k) {
    if k == 0 { return [[]]; }
    if len(arr) < k { return []; }
    let result = [];
    let head = arr[0];
    let tail = array_drop(arr, 1);
    // with head
    let with_head = combinations(tail, k - 1);
    let i = 0;
    while i < len(with_head) {
        let combo = [head];
        let j = 0;
        while j < len(with_head[i]) { array_push(combo, with_head[i][j]); j = j + 1; }
        array_push(result, combo);
        i = i + 1;
    }
    // without head
    let without = combinations(tail, k);
    let m = 0;
    while m < len(without) { array_push(result, without[m]); m = m + 1; }
    return result;
}

export binary_search, lower_bound, upper_bound, gcd, lcm, is_prime, primes_up_to,
       fibonacci, factorial, merge_sort, flatten, combinations;
