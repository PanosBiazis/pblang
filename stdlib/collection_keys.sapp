// Bounded scalar-key collection operations. See docs/COLLECTION_KEYS.md.
// Keys are finite f64 numbers, strings, booleans or nil; never stringify objects.
fn _bucket(value) {
    let kind = type(value);
    if kind == "string" {
        if len(value) > 4096 { throw "collection keys: text key limit exceeded"; }
        return "s:" + value;
    }
    if kind == "bool" { return "b:" + str(value); }
    if kind == "nil" { return "z:"; }
    if kind == "number" {
        if value != value or value - value != 0 { throw "collection keys: finite numeric key required"; }
        if value == 0 { return "n:0"; }
        return "n:" + str(value);
    }
    throw "collection keys: scalar key required; project objects to a scalar";
}

fn group_entries(arr, keyfn) {
    if not is_array(arr) { throw "collection keys: array input required"; }
    let n = len(arr);
    if n > 4096 { throw "collection keys: input item limit exceeded"; }
    let buckets = map{};
    let groups = [];
    let key_chars = 0;
    let comparisons = 0;
    let i = 0;
    while i < n {
        if len(arr) != n { throw "collection keys: input length changed"; }
        let value = arr[i];
        let key = keyfn(value);
        if len(arr) != n { throw "collection keys: input length changed"; }
        let bucket = _bucket(key);
        key_chars = key_chars + len(bucket);
        if key_chars > 65536 { throw "collection keys: aggregate key limit exceeded"; }
        if not map_has(buckets,bucket) { buckets[bucket] = []; }
        let candidates = buckets[bucket];
        let found = -1;
        let j = 0;
        while j < len(candidates) {
            comparisons = comparisons + 1;
            if comparisons > 65536 { throw "collection keys: comparison limit exceeded"; }
            let index = candidates[j];
            if groups[index].key == key { found = index; break; }
            j = j + 1;
        }
        if found < 0 {
            found = len(groups);
            push(groups,map{key:key,items:[]});
            push(candidates,found);
        }
        push(groups[found].items,value);
        i = i + 1;
    }
    return groups;
}

fn distinct_by(arr, keyfn) {
    let groups = group_entries(arr,keyfn);
    let result = [];
    for group in groups { push(result,group.items[0]); }
    return result;
}

export group_entries, distinct_by;
