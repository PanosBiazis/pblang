// stdlib/device.sapp — using device drivers from PURE pblang (no Rust).
//
// On Linux, most kernel drivers are exposed as FILES: character/block device nodes under
// /dev, and driver state under /sys (sysfs) and /proc (procfs). pblang's existing file
// builtins (fs_read / fs_read_bytes / fs_write_bytes / fs_exists) therefore already talk to
// those drivers — no Rust, no FFI. This module wraps that cleanly and is HONEST about the
// boundary it can't cross from pure pblang.
//
// REACHABLE from pure pblang here:
//   * char/block device nodes that work via read()/write()  (/dev/null, /dev/fb0 write,
//     serial /dev/ttyS*, etc.)
//   * sysfs attributes (sensors, backlight, thermal, net, drm info, GPIO legacy sysfs)
//   * procfs / kernel interfaces (/proc/*, /proc/sys/* — incl. the RNG driver's uuid)
//
// NOT reachable from pure pblang file I/O (needs more than read/write):
//   * ioctl / mmap drivers (modern GPIO /dev/gpiochip, I2C/SPI, framebuffer mmap) — these
//     need raw ioctl()/mmap() syscalls. The codegen backends CAN emit those syscalls
//     directly (machine code, still no Rust); the VM's file builtins cannot.
//   * vendor GPU/NPU USERSPACE driver stacks (CUDA/Vulkan/oneAPI) — closed native libraries
//     that require dynamic linking (dlopen/FFI). That is the irreducible native boundary.
//
//   let d = import("stdlib/device.sapp");
//   d.random_uuid();           // kernel RNG driver
//   d.discard(bytes);          // null driver
//   d.read_text("/sys/class/thermal/thermal_zone0/temp");   // a sensor driver

// CAUTION: never fs_read_bytes an UNBOUNDED device (e.g. /dev/urandom, /dev/zero) — it reads
// to EOF and will block. Use bounded interfaces (procfs uuid, sysfs attrs) or read via a
// generated native program that issues a sized read() syscall.

fn exists(path) { return try fs_exists(path) catch false; }

// read_text(path) — read a finite text interface (sysfs/procfs attribute).
fn read_text(path) { return fs_read(path); }

// read_bytes(path) — read a FINITE device/file as a byte array. Do NOT use on unbounded
// devices (see CAUTION above).
fn read_bytes(path) { return fs_read_bytes(path); }

// write_bytes(path, bytes) — write a byte array to a device node. Returns the count.
fn write_bytes(path, bytes) { fs_write_bytes(path, bytes); return len(bytes); }

// discard(bytes) — send bytes to the kernel null driver (/dev/null).
fn discard(bytes) { return write_bytes("/dev/null", bytes); }

// random_uuid() — one UUID from the kernel RNG driver (finite per read, never blocks).
fn random_uuid() { return str_trim(read_text("/proc/sys/kernel/random/uuid")); }

// sysfs(attr) — read a sysfs driver attribute (trimmed).
fn sysfs(attr) { return str_trim(read_text(attr)); }

// capabilities() — an HONEST map of what device access is reachable from pure pblang vs not.
fn capabilities() {
    return map{
        devfs_rw: true,                 // /dev char/block nodes via read()/write()
        sysfs: true,                    // /sys driver attributes
        procfs: true,                   // /proc kernel interfaces
        rng_driver: true,               // /proc/sys/kernel/random/uuid
        ioctl_via_pure_pblang: false,   // needs raw ioctl() — emit via codegen syscall
        mmap_via_pure_pblang: false,    // needs raw mmap()  — emit via codegen syscall
        gpu_vendor_libs: false          // CUDA/Vulkan/oneAPI need dynamic linking (FFI)
    };
}

export exists, read_text, read_bytes, write_bytes, discard, random_uuid, sysfs, capabilities;
