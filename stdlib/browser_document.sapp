            else {push(parts,"<p><button disabled>"+HTML.escape(b.text)+"</button> <span class=\"note\">Destination not exported</span></p>");}
        } else {push(parts,"<"+b.tag+">"+HTML.escape(b.text)+"</"+b.tag+">");}
    }
    push(parts,"</main>");
    return HTML.page(value.title,str_join(parts,""),"<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'\"><meta name=\"referrer\" content=\"no-referrer\"><style>"+Web.stylesheet()+"a{color:inherit;text-decoration:underline;text-underline-offset:.2em}article{display:grid;gap:1rem}</style>");
}
export MAX_SOURCE_BYTES,MAX_BLOCKS,address,create,inspect,import_html,export_html,page;
