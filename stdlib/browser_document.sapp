fn export_html(document) {
    let value=inspect(document);let parts=["<article><h1>"+HTML.escape(value.title)+"</h1>"];
    for b in value.blocks {
        if b.tag=="a" {push(parts,"<a href=\""+HTML.escape(b.href)+"\">"+HTML.escape(b.text)+"</a>");}
        else {push(parts,"<"+b.tag+">"+HTML.escape(b.text)+"</"+b.tag+">");}
    }
    push(parts,"</article>");return str_join(parts,"");
}
fn _decode(raw,maximum) {
