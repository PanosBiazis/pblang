// Normalization (NFC/NFD/NFKC/NFKD), UAX #29 Extended Grapheme Segmenter, Modern &
// Polytonic Greek Typographic Engine, & UTS #39 / CVE-2021-42574 Security Auditor.

let MODULE_VERSION = "5.0.0";
let UNICODE_STANDARD_VERSION = "16.0.0";

// Hangul Jamo & Syllable Constants (Unicode 16.0 Section 3.12)
let HANGUL_SBASE = 44032;  // 0xAC00
let HANGUL_LBASE = 4352;   // 0x1100
let HANGUL_VBASE = 4449;   // 0x1161
let HANGUL_TBASE = 4519;   // 0x11A7
let HANGUL_LCOUNT = 19;
let HANGUL_VCOUNT = 21;
let HANGUL_TCOUNT = 28;
let HANGUL_NCOUNT = 588;   // 21 * 28
let HANGUL_SCOUNT = 11172; // 19 * 588

// ── Scalar Validation & Strict UTF-8 / UTF-16LE / UTF-16BE Codecs ────────────

fn is_valid_unicode_scalar(cp) {
    if type(cp) != "number" or num_floor(cp) != cp { return false; }
    if cp < 0 or cp > 1114111 { return false; }
    if cp >= 55296 and cp <= 57343 { return false; } // U+D800..U+DFFF surrogates
    return true;
}

fn _is_utf8_cont(b) {
    return b >= 128 and b <= 191;
}

fn _bytes_from_any(raw_in) {
    if type(raw_in) == "bytes" { return raw_in; }
    if is_array(raw_in) {
        let n = len(raw_in);
        let out = bytes_new(n);
        let i = 0;
        while i < n {
            let v = raw_in[i];
            if type(v) != "number" or num_floor(v) != v or v < 0 or v > 255 {
                throw "unicode16: invalid byte value in array";
            }
            bytes_set(out, i, v);
            i = i + 1;
        }
        return out;
    }
    throw "unicode16: expected bytes or byte array";
}

fn validate_utf8_bytes(raw_bytes) {
    let b = _bytes_from_any(raw_bytes);
    let n = len(b);
    let cps = [];
    let i = 0;
    while i < n {
        let b0 = b[i];
        if b0 <= 127 {
            array_push(cps, b0);
            i = i + 1;
        } elif b0 >= 194 and b0 <= 223 {
            // Note: 0xC0 (192) and 0xC1 (193) are ALWAYS overlong 2-byte encodings!
            if i + 1 >= n or not _is_utf8_cont(b[i + 1]) {
                return map{ ok: false, error: "invalid_utf8_2byte_continuation", offset: i };
            }
            let cp2 = bit_or(bit_shl(bit_and(b0, 31), 6), bit_and(b[i + 1], 63));
            array_push(cps, cp2);
            i = i + 2;
        } elif b0 >= 224 and b0 <= 239 {
            if i + 2 >= n or not _is_utf8_cont(b[i + 1]) or not _is_utf8_cont(b[i + 2]) {
                return map{ ok: false, error: "invalid_utf8_3byte_continuation", offset: i };
            }
            let b1 = b[i + 1];
            if b0 == 224 and b1 < 160 {
                return map{ ok: false, error: "overlong_utf8_3byte_sequence", offset: i };
            }
            if b0 == 237 and b1 >= 160 {
                return map{ ok: false, error: "utf8_surrogate_codepoint_rejected", offset: i };
            }
            let cp3 = bit_or(bit_shl(bit_and(b0, 15), 12),
                             bit_or(bit_shl(bit_and(b1, 63), 6), bit_and(b[i + 2], 63)));
            array_push(cps, cp3);
            i = i + 3;
        } elif b0 >= 240 and b0 <= 244 {
            if i + 3 >= n or not _is_utf8_cont(b[i + 1]) or not _is_utf8_cont(b[i + 2]) or not _is_utf8_cont(b[i + 3]) {
                return map{ ok: false, error: "invalid_utf8_4byte_continuation", offset: i };
            }
            let b1 = b[i + 1];
            if b0 == 240 and b1 < 144 {
                return map{ ok: false, error: "overlong_utf8_4byte_sequence", offset: i };
            }
            if b0 == 244 and b1 > 143 {
                return map{ ok: false, error: "utf8_above_u10ffff_rejected", offset: i };
            }
            let cp4 = bit_or(bit_shl(bit_and(b0, 7), 18),
                      bit_or(bit_shl(bit_and(b1, 63), 12),
                      bit_or(bit_shl(bit_and(b[i + 2], 63), 6), bit_and(b[i + 3], 63))));
            array_push(cps, cp4);
            i = i + 4;
        } else {
            // Catches 0x80..0xBF stray continuations, 0xC0..0xC1 overlongs, and 0xF5..0xFF invalid leads
            if b0 == 192 or b0 == 193 {
                return map{ ok: false, error: "overlong_utf8_2byte_sequence", offset: i };
            }
            return map{ ok: false, error: "invalid_utf8_lead_byte", offset: i };
        }
    }
    return map{ ok: true, codepoints: cps, count: len(cps) };
}

fn utf8_to_codepoints(src) {
    if type(src) == "string" {
        let n = len(src);
        let cps = [];
        let i = 0;
        while i < n {
            let cp = strcharcodeat(src, i);
            if not is_valid_unicode_scalar(cp) {
                throw "unicode16: invalid Unicode scalar in string at index " + str(i);
            }
            array_push(cps, cp);
            i = i + 1;
        }
        return cps;
    }
    let res = validate_utf8_bytes(src);
    if not res.ok {
        throw "unicode16: " + res.error + " at byte " + str(res.offset);
    }
    return res.codepoints;
}

fn codepoints_to_utf8_bytes(cps) {
    if not is_array(cps) {
        throw "unicode16: codepoints_to_utf8_bytes expects array";
    }
    let out = [];
    let n = len(cps);
    let i = 0;
    while i < n {
        let cp = cps[i];
        if not is_valid_unicode_scalar(cp) {
            throw "unicode16: invalid scalar in codepoints_to_utf8_bytes: " + str(cp);
        }
        if cp <= 127 {
            array_push(out, cp);
        } elif cp <= 2047 {
            array_push(out, bit_or(192, bit_shr(cp, 6)));
            array_push(out, bit_or(128, bit_and(cp, 63)));
        } elif cp <= 65535 {
            array_push(out, bit_or(224, bit_shr(cp, 12)));
            array_push(out, bit_or(128, bit_and(bit_shr(cp, 6), 63)));
            array_push(out, bit_or(128, bit_and(cp, 63)));
        } else {
            array_push(out, bit_or(240, bit_shr(cp, 18)));
            array_push(out, bit_or(128, bit_and(bit_shr(cp, 12), 63)));
            array_push(out, bit_or(128, bit_and(bit_shr(cp, 6), 63)));
            array_push(out, bit_or(128, bit_and(cp, 63)));
        }
        i = i + 1;
    }
    let b = bytes_new(len(out));
    i = 0;
    while i < len(out) {
        bytes_set(b, i, out[i]);
        i = i + 1;
    }
    return b;
}

fn codepoints_to_utf8(cps) {
    let b = codepoints_to_utf8_bytes(cps);
    return bytes_to_str(b);
}

fn _encode_utf16_bytes(src, is_little) {
    let cps = utf8_to_codepoints(src);
    let raw = [];
    let i = 0;
    let n = len(cps);
    while i < n {
        let cp = cps[i];
        if cp <= 65535 {
            if is_little {
                array_push(raw, bit_and(cp, 255));
                array_push(raw, bit_and(bit_shr(cp, 8), 255));
            } else {
                array_push(raw, bit_and(bit_shr(cp, 8), 255));
                array_push(raw, bit_and(cp, 255));
            }
        } else {
            let u = cp - 65536;
            let hi_s = 55296 + bit_shr(u, 10);       // 0xD800..0xDBFF
            let lo_s = 56320 + bit_and(u, 1023);     // 0xDC00..0xDFFF
            if is_little {
                array_push(raw, bit_and(hi_s, 255));
                array_push(raw, bit_and(bit_shr(hi_s, 8), 255));
                array_push(raw, bit_and(lo_s, 255));
                array_push(raw, bit_and(bit_shr(lo_s, 8), 255));
            } else {
                array_push(raw, bit_and(bit_shr(hi_s, 8), 255));
                array_push(raw, bit_and(hi_s, 255));
                array_push(raw, bit_and(bit_shr(lo_s, 8), 255));
                array_push(raw, bit_and(lo_s, 255));
            }
        }
        i = i + 1;
    }
    let out = bytes_new(len(raw));
    i = 0;
    while i < len(raw) {
        bytes_set(out, i, raw[i]);
        i = i + 1;
    }
    return out;
}

fn _decode_utf16_bytes(u16_bytes, is_little) {
    let b = _bytes_from_any(u16_bytes);
    let n = len(b);
    if (n % 2) != 0 {
        throw "unicode16: UTF-16 byte buffer must have even length";
    }
    let cps = [];
    let i = 0;
    while i < n {
        let w1 = 0;
        if is_little {
            w1 = b[i] + b[i + 1] * 256;
        } else {
            w1 = b[i] * 256 + b[i + 1];
        }
        i = i + 2;
        if w1 >= 55296 and w1 <= 56319 {
            if i + 2 > n {
                throw "unicode16: truncated UTF-16 high surrogate at end of buffer";
            }
            let w2 = 0;
            if is_little {
                w2 = b[i] + b[i + 1] * 256;
            } else {
                w2 = b[i] * 256 + b[i + 1];
            }
            if w2 < 56320 or w2 > 57343 {
                throw "unicode16: invalid UTF-16 low surrogate pairing";
            }
            i = i + 2;
            let cp = 65536 + bit_shl(w1 - 55296, 10) + (w2 - 56320);
            array_push(cps, cp);
        } elif w1 >= 56320 and w1 <= 57343 {
            throw "unicode16: unpaired UTF-16 low surrogate rejected";
        } else {
            array_push(cps, w1);
        }
    }
    return codepoints_to_utf8(cps);
}

fn utf8_to_utf16le_bytes(text) { return _encode_utf16_bytes(text, true); }
fn utf16le_bytes_to_utf8(b) { return _decode_utf16_bytes(b, true); }
fn utf8_to_utf16be_bytes(text) { return _encode_utf16_bytes(text, false); }
fn utf16be_bytes_to_utf8(b) { return _decode_utf16_bytes(b, false); }

// ── Unicode 16.0 Canonical Combining Class (CCC) & Decomposition Engine ──────

fn combining_class_pure(cp) {
    if cp < 768 { return 0; }
    // Combining Diacritical Marks (U+0300..U+036F)
    if cp >= 768 and cp <= 879 {
        if cp == 820 or cp == 821 or cp == 822 or cp == 823 or cp == 824 { return 1; } // overlays
        if cp == 807 or cp == 808 { return 202; } // cedilla / ogonek attached below (0x0327, 0x0328)
        if cp >= 790 and cp <= 819 { return 220; } // below marks (0x0316..0x0333 except 202)
        if cp >= 825 and cp <= 828 { return 220; }
        if cp >= 839 and cp <= 841 { return 220; }
        if cp >= 851 and cp <= 854 { return 220; }
        if cp == 837 { return 240; } // U+0345 COMBINING GREEK YPOGEGRAMMENI (iota subscript = 240!)
        if cp == 860 or cp == 861 or cp == 862 { return 233; } // double below/above
        if cp == 836 { return 230; } // U+0344 COMBINING GREEK DIALYTIKA TONOS
        return 230; // Above marks: U+0300 varia, U+0301 tonos/oxia, U+0308 dialytika, U+0313 psili, U+0314 dasia, U+0342 perispomeni!
    }
    // Hebrew / Arabic / Devanagari / Thai / CJK combining classes
    if cp >= 1425 and cp <= 1469 { return 220; }
    if cp >= 1611 and cp <= 1618 { return 30; }
    if cp == 12441 or cp == 12442 { return 8; } // Kana voiced/semi-voiced marks
    return 0;
}

let _GREEK_POLY_VOWELS_LO = [945, 949, 951, 953, 959, 965, 969]; // α, ε, η, ι, ο, υ, ω
let _GREEK_POLY_VOWELS_HI = [913, 917, 919, 921, 927, 933, 937]; // Α, Ε, Η, Ι, Ο, Υ, Ω
let _GREEK_SUB_LO = [945, 951, 969]; // α, η, ω
let _GREEK_SUB_HI = [913, 919, 937]; // Α, Η, Ω
let _GREEK_1F70_VOWELS = [945, 949, 951, 953, 959, 965, 969];

fn _build_latin_and_greek_tables() {
    // Maps codepoint_str -> array of canonical decomposed codepoints,
    // and "base:comb" -> composed NFC codepoint (excluding Unicode composition exclusions!).
    let decomp = map{};
    let comp = map{};

    fn reg(pre, seq, allow_nfc) {
        decomp[str(pre)] = seq;
        if allow_nfc and len(seq) == 2 {
            comp[str(seq[0]) + ":" + str(seq[1])] = pre;
        }
    }

    // Modern Greek Tonos & Dialytika (U+0385..U+03CE)
    reg(901, [168, 769], true);    // ΅ = ¨ + ΄
    reg(902, [913, 769], true);    // Ά = Α + U+0301
    reg(904, [917, 769], true);    // Έ = Ε + U+0301
    reg(905, [919, 769], true);    // Ή = Η + U+0301
    reg(906, [921, 769], true);    // Ί = Ι + U+0301
    reg(908, [927, 769], true);    // Ό = Ο + U+0301
    reg(910, [933, 769], true);    // Ύ = Υ + U+0301
    reg(911, [937, 769], true);    // Ώ = Ω + U+0301
    reg(938, [921, 776], true);    // Ϊ = Ι + U+0308
    reg(939, [933, 776], true);    // Ϋ = Υ + U+0308
    reg(940, [945, 769], true);    // ά = α + U+0301
    reg(941, [949, 769], true);    // έ = ε + U+0301
    reg(942, [951, 769], true);    // ή = η + U+0301
    reg(943, [953, 769], true);    // ί = ι + U+0301
    reg(970, [953, 776], true);    // ϊ = ι + U+0308
    reg(971, [965, 776], true);    // ϋ = υ + U+0308
    reg(972, [959, 769], true);    // ό = ο + U+0301
    reg(973, [965, 769], true);    // ύ = υ + U+0301
    reg(974, [969, 769], true);    // ώ = ω + U+0301
    // Two-step ΐ (0x0390 = ϊ + 0x0301) and ΰ (0x03B0 = ϋ + 0x0301)
    reg(912, [970, 769], true);    // ΐ
    reg(944, [971, 769], true);    // ΰ

    // Unicode Canonical Singletons (excluded from NFC re-composition back to oxia!)
    reg(894, [59], false);         // U+037E GREEK QUESTION MARK -> ';'
    reg(903, [183], false);        // U+0387 GREEK ANO TELEIA -> '·'
    reg(836, [776, 769], false);   // U+0344 COMBINING DIALYTIKA TONOS -> U+0308 + U+0301
    reg(8125, [787], false);       // ᾽ -> U+0313
    reg(8190, [788], false);       // ῾ -> U+0314

    // Greek Extended U+1F00..U+1F6F: 7 vowels * 16 breathings/accents
    let breath_marks = [787, 788]; // 0x0313 psili, 0x0314 dasia
    let acc_marks = [0, 768, 769, 834]; // none, 0x0300 varia, 0x0301 oxia/tonos, 0x0342 perispomeni
    let g = 0;
    while g < 7 {
        let sub = 0;
        while sub < 16 {
            // Note: υ uppercase with psili (0x1F58, 0x1F5A, 0x1F5C, 0x1F5E) are unassigned in Unicode
            let cp = 7936 + g * 16 + sub;
            let is_hi = bit_and(sub, 8) != 0;
            let b_idx = bit_and(sub, 1);
            let a_idx = bit_shr(bit_and(sub, 6), 1);
            if not (g == 5 and is_hi and b_idx == 0) and not (g == 1 and a_idx == 3) and not (g == 4 and a_idx == 3) {
                let base_v = _GREEK_POLY_VOWELS_LO[g];
                if is_hi { base_v = _GREEK_POLY_VOWELS_HI[g]; }
                let b_mark = breath_marks[b_idx];
                if a_idx == 0 {
                    reg(cp, [base_v, b_mark], true);
                } else {
                    // Intermediate precomposed breathing char + accent mark enables 2-step NFC!
                    let breath_cp = 7936 + g * 16 + (if is_hi { 8 } else { 0 }) + b_idx;
                    reg(cp, [breath_cp, acc_marks[a_idx]], true);
                }
            }
            sub = sub + 1;
        }
        g = g + 1;
    }

    // U+1F70..U+1F7D: varia (even, NFC-allowed!) and oxia (odd -> canonical singleton to Modern Tonos!)
    let v_idx = 0;
    while v_idx < 7 {
        let base_lo = _GREEK_1F70_VOWELS[v_idx];
        let varia_cp = 8048 + v_idx * 2;
        let oxia_cp = varia_cp + 1;
        reg(varia_cp, [base_lo, 768], true);  // ὰ, ὲ, ὴ, ὶ, ὸ, ὺ, ὼ compose in NFC
        reg(oxia_cp, [base_lo, 769], false);  // ά..ώ normalize to Modern Greek ά..ώ in NFC!
        v_idx = v_idx + 1;
    }

    // U+1F80..U+1FAF: α/η/ω + breathing (+ accent) + ypogegrammeni (0x0345)
    let sg = 0;
    let orig_group = [0, 2, 6];
    while sg < 3 {
        let sub2 = 0;
        while sub2 < 16 {
            let cp_sub = 8064 + sg * 16 + sub2;
            let partner_cp = 7936 + orig_group[sg] * 16 + sub2;
            reg(cp_sub, [partner_cp, 837], true); // partner + U+0345
            sub2 = sub2 + 1;
        }
        sg = sg + 1;
    }

    // Additional Greek Extended U+1FB0..U+1FFF (vrachy, makron, perispomeni, ypogegrammeni, rho breathings)
    reg(8112, [945, 774], true);   // ᾰ
    reg(8113, [945, 772], true);   // ᾱ
    reg(8114, [8048, 837], true);  // ᾲ = ὰ + ͅ
    reg(8115, [945, 837], true);   // ᾳ = α + ͅ
    reg(8116, [940, 837], true);   // ᾴ = ά + ͅ
    reg(8118, [945, 834], true);   // ᾶ = α + ͂
    reg(8119, [8118, 837], true);  // ᾷ = ᾶ + ͅ
    reg(8120, [913, 774], true);   // Ᾰ
    reg(8121, [913, 772], true);   // Ᾱ
    reg(8122, [913, 768], true);   // Ὰ
    reg(8123, [913, 769], false);  // Ά -> Ά (0x0386)
    reg(8124, [913, 837], true);   // ᾼ

    reg(8130, [8052, 837], true);  // ῂ
    reg(8131, [951, 837], true);   // ῃ
    reg(8132, [942, 837], true);   // ῄ
    reg(8134, [951, 834], true);   // ῆ
    reg(8135, [8134, 837], true);  // ῇ
    reg(8136, [917, 768], true);   // Ὲ
    reg(8137, [917, 769], false);  // Έ -> Έ
    reg(8138, [919, 768], true);   // Ὴ
    reg(8139, [919, 769], false);  // Ή -> Ή
    reg(8140, [919, 837], true);   // ῌ

    reg(8144, [953, 774], true);   // ῐ
    reg(8145, [953, 772], true);   // ῑ
    reg(8146, [970, 768], true);   // ῒ
    reg(8147, [970, 769], false);  // ΐ -> ΐ (0x0390)
    reg(8150, [953, 834], true);   // ῖ
    reg(8151, [970, 834], true);   // ῗ
    reg(8152, [921, 774], true);   // Ῐ
    reg(8153, [921, 772], true);   // Ῑ
    reg(8154, [921, 768], true);   // Ὶ
    reg(8155, [921, 769], false);  // Ί -> Ί

    reg(8160, [965, 774], true);   // ῠ
    reg(8161, [965, 772], true);   // ῡ
    reg(8162, [971, 768], true);   // ῢ
    reg(8163, [971, 769], false);  // ΰ -> ΰ (0x03B0)
    reg(8164, [961, 787], true);   // ῤ = ρ + psili
    reg(8165, [961, 788], true);   // ῥ = ρ + dasia
    reg(8166, [965, 834], true);   // ῦ
    reg(8167, [971, 834], true);   // ῧ
    reg(8168, [933, 774], true);   // Ῠ
    reg(8169, [933, 772], true);   // Ῡ
    reg(8170, [933, 768], true);   // Ὺ
    reg(8171, [933, 769], false);  // Ύ -> Ύ
    reg(8172, [929, 788], true);   // Ῥ = Ρ + dasia

    reg(8178, [8060, 837], true);  // ῲ
    reg(8179, [969, 837], true);   // ῳ
    reg(8180, [974, 837], true);   // ῴ
    reg(8182, [969, 834], true);   // ῶ
    reg(8183, [8182, 837], true);  // ῷ
    reg(8184, [927, 768], true);   // Ὸ
    reg(8185, [927, 769], false);  // Ό -> Ό
    reg(8186, [937, 768], true);   // Ὼ
    reg(8187, [937, 769], false);  // Ώ -> Ώ
    reg(8188, [937, 837], true);   // ῼ
    reg(8189, [900], false);       // ´ -> ΄ (0x0384)

    // Latin-1 Supplement Accents (U+00C0..U+00FF) & Common Extended-A
    let lat_pairs = [
        [192, 65, 768], [193, 65, 769], [194, 65, 770], [195, 65, 771], [196, 65, 776], [197, 65, 778],
        [199, 67, 807], [200, 69, 768], [201, 69, 769], [202, 69, 770], [203, 69, 776],
        [204, 73, 768], [205, 73, 769], [206, 73, 770], [207, 73, 776], [209, 78, 771],
        [210, 79, 768], [211, 79, 769], [212, 79, 770], [213, 79, 771], [214, 79, 776],
        [217, 85, 768], [218, 85, 769], [219, 85, 770], [220, 85, 776], [221, 89, 769],
        [224, 97, 768], [225, 97, 769], [226, 97, 770], [227, 97, 771], [228, 97, 776], [229, 97, 778],
        [231, 99, 807], [232, 101, 768], [233, 101, 769], [234, 101, 770], [235, 101, 776],
        [236, 105, 768], [237, 105, 769], [238, 105, 770], [239, 105, 776], [241, 110, 771],
        [242, 111, 768], [243, 111, 769], [244, 111, 770], [245, 111, 771], [246, 111, 776],
        [249, 117, 768], [250, 117, 769], [251, 117, 770], [252, 117, 776], [253, 121, 769], [255, 121, 776],
        // Extended-A (Č, č, Š, š, Ž, ž, Ę, ę, Ē, ē, Ō, ō)
        [268, 67, 780], [269, 99, 780], [352, 83, 780], [353, 115, 780], [381, 90, 780], [382, 122, 780],
        [280, 69, 808], [281, 101, 808], [274, 69, 772], [275, 101, 772], [332, 79, 772], [333, 111, 772],
        // Angstrom sign U+212B -> Å (singleton -> A + ring)
        [8491, 197, 0]
    ];
    let li = 0;
    while li < len(lat_pairs) {
        let p = lat_pairs[li];
        if p[2] == 0 {
            reg(p[0], [p[1]], false);
        } else {
            reg(p[0], [p[1], p[2]], true);
        }
        li = li + 1;
    }

    return map{ decomp: decomp, comp: comp };
}

let _NORM_TABLES = _build_latin_and_greek_tables();

fn _compat_decompose_cp(cp) {
    // NFKD / NFKC compatibility mappings (ligatures, superscripts, fullwidth ASCII, Greek math variants)
    if cp == 160 { return [32]; }              // NBSP -> space
    if cp == 178 { return [50]; }              // ² -> 2
    if cp == 179 { return [51]; }              // ³ -> 3
    if cp == 185 { return [49]; }              // ¹ -> 1
    if cp == 188 { return [49, 8260, 52]; }    // ¼
    if cp == 189 { return [49, 8260, 50]; }    // ½
    if cp == 190 { return [51, 8260, 52]; }    // ¾
    if cp == 8482 { return [84, 77]; }         // ™ -> TM
    if cp == 64256 { return [102, 102]; }      // ﬀ -> ff
    if cp == 64257 { return [102, 105]; }      // ﬁ -> fi
    if cp == 64258 { return [102, 108]; }      // ﬂ -> fl
    if cp == 64259 { return [102, 102, 105]; } // ﬃ -> ffi
    if cp == 64260 { return [102, 102, 108]; } // ﬄ -> ffl
    // Fullwidth ASCII U+FF01..U+FF5E -> U+0021..U+007E
    if cp >= 65281 and cp <= 65374 { return [cp - 65248]; }
    // Greek compatibility variants (ϐ->β, ϑ->θ, ϒ->Υ, ϕ->φ, ϖ->π, ϰ->κ, ϱ->ρ, ϲ->ς, ϴ->Θ, ϵ->ε)
    if cp == 976 { return [946]; }
    if cp == 977 { return [952]; }
    if cp == 978 { return [933]; }
    if cp == 981 { return [966]; }
    if cp == 982 { return [960]; }
    if cp == 1008 { return [954]; }
    if cp == 1009 { return [961]; }
    if cp == 1010 { return [962]; }
    if cp == 1012 { return [920]; }
    if cp == 1013 { return [949]; }
    return nil;
}

fn _decompose_recursive(cp, use_compat, out) {
    // 1. Hangul Syllable SBase..SBase+SCount-1 algorithmic LV/LVT decomposition
    if cp >= HANGUL_SBASE and cp < (HANGUL_SBASE + HANGUL_SCOUNT) {
        let s_idx = cp - HANGUL_SBASE;
        let l_cp = HANGUL_LBASE + num_floor(s_idx / HANGUL_NCOUNT);
        let v_cp = HANGUL_VBASE + num_floor((s_idx % HANGUL_NCOUNT) / HANGUL_TCOUNT);
        let t_off = s_idx % HANGUL_TCOUNT;
        array_push(out, l_cp);
        array_push(out, v_cp);
        if t_off > 0 {
            array_push(out, HANGUL_TBASE + t_off);
        }
        return;
    }
    // 2. Canonical decomposition table
    let k = str(cp);
    if map_has(_NORM_TABLES.decomp, k) {
        let seq = _NORM_TABLES.decomp[k];
        let i = 0;
        while i < len(seq) {
            _decompose_recursive(seq[i], use_compat, out);
            i = i + 1;
        }
        return;
    }
    // 3. Optional NFKD/NFKC compatibility mapping
    if use_compat {
        let cseq = _compat_decompose_cp(cp);
        if cseq != nil {
            let j = 0;
            while j < len(cseq) {
                _decompose_recursive(cseq[j], use_compat, out);
                j = j + 1;
            }
            return;
        }
    }
    array_push(out, cp);
}

fn _canonical_ccc_sort(cps) {
    // Stable sort of contiguous runs of non-starter combining marks (CCC > 0)
    let n = len(cps);
    let i = 1;
    while i < n {
        let ccc_i = combining_class_pure(cps[i]);
        if ccc_i > 0 {
            let j = i;
            while j > 0 {
                let ccc_prev = combining_class_pure(cps[j - 1]);
                if ccc_prev == 0 or ccc_prev <= ccc_i {
                    break;
                }
                let tmp = cps[j - 1];
                cps[j - 1] = cps[j];
                cps[j] = tmp;
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return cps;
}

fn _canonical_compose(cps) {
    let n = len(cps);
    if n == 0 { return []; }
    let out = [cps[0]];
    let starter_pos = 0;
    let last_ccc = combining_class_pure(cps[0]);
    if last_ccc != 0 { starter_pos = -1; }

    let i = 1;
    while i < n {
        let ch = cps[i];
        let ch_ccc = combining_class_pure(ch);
        let composed = -1;

        if starter_pos >= 0 and (last_ccc < ch_ccc or last_ccc == 0) {
            let st_cp = out[starter_pos];
            // Check Hangul L+V and LV+T composition first!
            if st_cp >= HANGUL_LBASE and st_cp < (HANGUL_LBASE + HANGUL_LCOUNT) and
               ch >= HANGUL_VBASE and ch < (HANGUL_VBASE + HANGUL_VCOUNT) {
                composed = HANGUL_SBASE + ((st_cp - HANGUL_LBASE) * HANGUL_VCOUNT + (ch - HANGUL_VBASE)) * HANGUL_TCOUNT;
            } elif st_cp >= HANGUL_SBASE and st_cp < (HANGUL_SBASE + HANGUL_SCOUNT) and
                   ((st_cp - HANGUL_SBASE) % HANGUL_TCOUNT) == 0 and
                   ch > HANGUL_TBASE and ch < (HANGUL_TBASE + HANGUL_TCOUNT) {
                composed = st_cp + (ch - HANGUL_TBASE);
            } else {
                let pair_key = str(st_cp) + ":" + str(ch);
                if map_has(_NORM_TABLES.comp, pair_key) {
                    composed = _NORM_TABLES.comp[pair_key];
                }
            }
        }

        if composed >= 0 {
            out[starter_pos] = composed;
        } else {
            if ch_ccc == 0 {
                starter_pos = len(out);
                last_ccc = 0;
            } else {
                last_ccc = ch_ccc;
            }
            array_push(out, ch);
        }
        i = i + 1;
    }
    return out;
}

fn unicode_normalize_pure(text, form = "NFC") {
    let f = str_upper(str(form));
    if f != "NFC" and f != "NFD" and f != "NFKC" and f != "NFKD" {
        throw "unicode16: unsupported normalization form: " + str(form);
    }
    let use_compat = (f == "NFKC" or f == "NFKD");
    let do_compose = (f == "NFC" or f == "NFKC");

    let src_cps = utf8_to_codepoints(text);
    let decomp = [];
    let i = 0;
    while i < len(src_cps) {
        _decompose_recursive(src_cps[i], use_compat, decomp);
        i = i + 1;
    }
    _canonical_ccc_sort(decomp);
    if do_compose {
        return codepoints_to_utf8(_canonical_compose(decomp));
    }
    return codepoints_to_utf8(decomp);
}

// ── UAX #29 Extended Grapheme Cluster Segmenter ──────────────────────────────

fn _is_regional_indicator(cp) {
    return cp >= 127462 and cp <= 127487; // U+1F1E6..U+1F1FF (🇦..🇿)
}

fn _is_emoji_modifier(cp) {
    return cp >= 127995 and cp <= 127999; // U+1F3FB..U+1F3FF skin tones
}

fn _is_extended_pictographic(cp) {
    return (cp >= 127744 and cp <= 129791) // U+1F300..U+1FAFF (faces, people, symbols, supplemental)
        or (cp >= 9728 and cp <= 10175)    // U+2600..U+27BF (weather, hearts, dingbats)
        or cp == 8252 or cp == 8265
        or (cp >= 8986 and cp <= 9210);
}

fn _is_grapheme_extend(cp) {
    if combining_class_pure(cp) > 0 { return true; }
    if cp >= 768 and cp <= 879 { return true; }       // U+0300..U+036F
    if cp >= 6832 and cp <= 6911 { return true; }     // U+1AB0..U+1AFF
    if cp >= 7616 and cp <= 7679 { return true; }     // U+1DC0..U+1DFF
    if cp >= 8400 and cp <= 8447 { return true; }     // U+20D0..U+20FF
    if cp >= 65024 and cp <= 65039 { return true; }   // U+FE00..U+FE0F Variation Selectors
    if cp >= 65056 and cp <= 65071 { return true; }   // U+FE20..U+FE2F
    if cp >= 917760 and cp <= 917999 { return true; } // U+E0100..U+E01EF
    if _is_emoji_modifier(cp) { return true; }        // Emoji_Modifier attaches via GB9 Extend!
    if cp == 8204 { return true; }                    // U+200C ZWNJ
    return false;
}

fn _is_spacing_mark(cp) {
    // Indic / Thai / Myanmar spacing combining marks (GB9a)
    return (cp >= 2307 and cp <= 2307) or (cp >= 2366 and cp <= 2380) or (cp >= 3633 and cp <= 3635);
}

fn _hangul_jamo_kind(cp) {
    if cp >= 4352 and cp <= 4447 { return "L"; }
    if cp >= 4448 and cp <= 4519 { return "V"; }
    if cp >= 4520 and cp <= 4607 { return "T"; }
    if cp >= HANGUL_SBASE and cp < (HANGUL_SBASE + HANGUL_SCOUNT) {
        if ((cp - HANGUL_SBASE) % HANGUL_TCOUNT) == 0 { return "LV"; }
        return "LVT";
    }
    return "";
}

fn _is_gb_control(cp) {
    // Control excluding CR(13), LF(10), ZWJ(8205), ZWNJ(8204)
    if cp == 10 or cp == 13 or cp == 8204 or cp == 8205 { return false; }
    if cp < 32 or (cp >= 127 and cp <= 159) { return true; }
    if cp == 8232 or cp == 8233 { return true; } // Line/Paragraph separator
    return false;
}

fn unicode_graphemes_pure(text) {
    let cps = utf8_to_codepoints(text);
    let n = len(cps);
    if n == 0 { return []; }

    let clusters = [];
    let cur = [cps[0]];
    let ri_run = 0;
    if _is_regional_indicator(cps[0]) { ri_run = 1; }
    let saw_picto = _is_extended_pictographic(cps[0]);
    let after_picto_extend = saw_picto;

    let i = 1;
    while i < n {
        let prev = cps[i - 1];
        let ch = cps[i];
        let should_break = true;

        // GB3: CR × LF
        if prev == 13 and ch == 10 {
            should_break = false;
        } elif prev == 13 or prev == 10 or _is_gb_control(prev) {
            // GB4: (Control | CR | LF) ÷
            should_break = true;
        } elif ch == 13 or ch == 10 or _is_gb_control(ch) {
            // GB5: ÷ (Control | CR | LF)
            should_break = true;
        } else {
            let hk_prev = _hangul_jamo_kind(prev);
            let hk_cur = _hangul_jamo_kind(ch);
            // GB6..GB8: Hangul syllable sequences
            if hk_prev == "L" and (hk_cur == "L" or hk_cur == "V" or hk_cur == "LV" or hk_cur == "LVT") {
                should_break = false;
            } elif (hk_prev == "V" or hk_prev == "LV") and (hk_cur == "V" or hk_cur == "T") {
                should_break = false;
            } elif (hk_prev == "LVT" or hk_prev == "T") and hk_cur == "T" {
                should_break = false;
            } elif _is_grapheme_extend(ch) or ch == 8205 or _is_spacing_mark(ch) {
                // GB9 / GB9a: × (Extend | ZWJ | SpacingMark)
                should_break = false;
            } elif prev == 8205 and after_picto_extend and _is_extended_pictographic(ch) {
                // GB11: \p{Extended_Pictographic} Extend* ZWJ × \p{Extended_Pictographic}
                should_break = false;
            } elif _is_regional_indicator(prev) and _is_regional_indicator(ch) and (ri_run % 2) == 1 {
                // GB12 / GB13: pair Regional Indicators cleanly (🇬🇷 = 1, 🇬🇷🇺🇸 = 2)
                should_break = false;
            }
        }

        if should_break {
            array_push(clusters, codepoints_to_utf8(cur));
            cur = [ch];
            ri_run = if _is_regional_indicator(ch) { 1 } else { 0 };
            after_picto_extend = _is_extended_pictographic(ch);
        } else {
            array_push(cur, ch);
            if _is_regional_indicator(ch) {
                ri_run = ri_run + 1;
            } else {
                ri_run = 0;
            }
            if _is_extended_pictographic(ch) {
                after_picto_extend = true;
            } elif not _is_grapheme_extend(ch) and ch != 8205 {
                after_picto_extend = false;
            }
        }
        i = i + 1;
    }
    array_push(clusters, codepoints_to_utf8(cur));
    return clusters;
}

fn unicode_grapheme_count(text) {
    return len(unicode_graphemes_pure(text));
}

// ── Sovereign Greek Case, Polytonic/Tonos Accent Stripper & Collation ────────

fn _is_cased_cp(cp) {
    if (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) { return true; }
    if cp >= 192 and cp <= 255 and cp != 215 and cp != 247 { return true; }
    if cp >= 880 and cp <= 1023 {
        if cp == 894 or cp == 900 or cp == 901 or cp == 903 { return false; }
        return true;
    }
    if cp >= 7936 and cp <= 8190 { return true; }
    if cp >= 1024 and cp <= 1279 { return true; } // Cyrillic
    return false;
}

fn _is_case_ignorable_cp(cp) {
    if _is_grapheme_extend(cp) { return true; }
    // Apostrophe (39), Right single quote (8217), Greek koronis (8125), modifier apostrophe (700)
    if cp == 39 or cp == 8217 or cp == 8125 or cp == 700 or cp == 183 { return true; }
    return false;
}

fn _single_cp_to_lower(cp, is_word_final) {
    // Greek Capital Sigma U+03A3 (931): word-final -> ς (962), otherwise -> σ (963)!
    if cp == 931 {
        if is_word_final { return 962; }
        return 963;
    }
    // ASCII A..Z
    if cp >= 65 and cp <= 90 { return cp + 32; }
    // Basic Greek Α..Ω (913..937, excluding unassigned 930)
    if cp >= 913 and cp <= 937 and cp != 930 { return cp + 32; }
    // Modern Greek accented capitals Ά..Ώ, Ϊ, Ϋ
    if cp == 902 { return 940; } // Ά -> ά
    if cp == 904 { return 941; } // Έ -> έ
    if cp == 905 { return 942; } // Ή -> ή
    if cp == 906 { return 943; } // Ί -> ί
    if cp == 908 { return 972; } // Ό -> ό
    if cp == 910 { return 973; } // Ύ -> ύ
    if cp == 911 { return 974; } // Ώ -> ώ
    if cp == 938 { return 970; } // Ϊ -> ϊ
    if cp == 939 { return 971; } // Ϋ -> ϋ
    // Polytonic Greek Extended U+1F08..U+1F6F & U+1F88..U+1FAF (bit 3 = 8 is uppercase!)
    if cp >= 7936 and cp <= 8047 and bit_and(cp, 8) != 0 { return cp - 8; }
    if cp >= 8064 and cp <= 8111 and bit_and(cp, 8) != 0 { return cp - 8; }
    if cp >= 8120 and cp <= 8124 {
        if cp == 8120 { return 8112; }
        if cp == 8121 { return 8113; }
        if cp == 8122 { return 8048; }
        if cp == 8123 { return 940; }
        if cp == 8124 { return 8115; }
    }
    if cp == 8136 { return 8050; }
    if cp == 8137 { return 941; }
    if cp == 8138 { return 8052; }
    if cp == 8139 { return 942; }
    if cp == 8140 { return 8131; }
    if cp == 8152 { return 8144; }
    if cp == 8153 { return 8145; }
    if cp == 8154 { return 8054; }
    if cp == 8155 { return 943; }
    if cp == 8168 { return 8160; }
    if cp == 8169 { return 8161; }
    if cp == 8170 { return 8058; }
    if cp == 8171 { return 973; }
    if cp == 8172 { return 8165; } // Ῥ -> ῥ
    if cp == 8184 { return 8056; }
    if cp == 8185 { return 972; }
    if cp == 8186 { return 8060; }
    if cp == 8187 { return 974; }
    if cp == 8188 { return 8179; }
    // Latin-1 À..Þ
    if cp >= 192 and cp <= 222 and cp != 215 { return cp + 32; }
    return cp;
}

fn greek_to_lower(text) {
    let cps = utf8_to_codepoints(text);
    let n = len(cps);
    let out = [];
    let i = 0;
    while i < n {
        let cp = cps[i];
        let is_final = false;
        if cp == 931 {
            // Unicode Final_Sigma condition:
            // Preceded by Cased + Case_Ignorable*, AND NOT followed by Case_Ignorable* + Cased
            let p = i - 1;
            while p >= 0 and _is_case_ignorable_cp(cps[p]) { p = p - 1; }
            let has_prev_cased = (p >= 0 and _is_cased_cp(cps[p]));
            if has_prev_cased {
                let q = i + 1;
                while q < n and _is_case_ignorable_cp(cps[q]) { q = q + 1; }
                let has_next_cased = (q < n and _is_cased_cp(cps[q]));
                if not has_next_cased {
                    is_final = true;
                }
            }
        }
        array_push(out, _single_cp_to_lower(cp, is_final));
        i = i + 1;
    }
    return codepoints_to_utf8(out);
}

fn greek_strip_accents(text) {
    // NFD decompose, then strip all combining diacritical/breathing/subscript marks (U+0300..U+036F)
    let nfd = unicode_normalize_pure(text, "NFD");
    let cps = utf8_to_codepoints(nfd);
    let clean = [];
    let i = 0;
    while i < len(cps) {
        let cp = cps[i];
        if not (cp >= 768 and cp <= 879) and not (cp >= 7616 and cp <= 7679) {
            array_push(clean, cp);
        }
        i = i + 1;
    }
    return codepoints_to_utf8(clean);
}

fn _basic_cp_upper(cp) {
    if cp >= 97 and cp <= 122 { return cp - 32; }
    if cp == 962 { return 931; } // ς -> Σ
    if cp >= 945 and cp <= 969 { return cp - 32; } // α..ω -> Α..Ω
    if cp >= 224 and cp <= 254 and cp != 247 { return cp - 32; }
    return cp;
}

fn greek_to_upper_tonos_free(text) {
    // Official Modern Greek Uppercase Typographic Rule (CLDR el-Upper):
    // 1. Decompose to NFD so base vowels and tonos/breathings/dialytika are explicit.
    // 2. Strip tonos/varia/perispomeni/psili/dasia/ypogegrammeni, EXCEPT:
    //    - Preserve explicit dialytika (U+0308) on ι/υ -> Ϊ/Ϋ!
    //    - Preserve disjunctive hiatus dialytika on accented diphthong openings (άι->ΑΪ, έι->ΕΪ, όι->ΟΪ, άυ->ΑΫ, έυ->ΕΫ)!
    let nfd = unicode_normalize_pure(text, "NFD");
    let cps = utf8_to_codepoints(nfd);
    let n = len(cps);

    // Group into (base_cp, has_accent, has_dialytika, has_ypogegrammeni) units
    let units = [];
    let i = 0;
    while i < n {
        let b = cps[i];
        let acc = false;
        let dia = false;
        let ypo = false;
        let j = i + 1;
        while j < n and (cps[j] >= 768 and cps[j] <= 879) {
            let m = cps[j];
            if m == 768 or m == 769 or m == 834 { acc = true; }
            if m == 776 { dia = true; }
            if m == 837 { ypo = true; }
            j = j + 1;
        }
        array_push(units, map{ base: b, acc: acc, dia: dia, ypo: ypo });
        i = j;
    }

    let out = [];
    let u_len = len(units);
    let k = 0;
    while k < u_len {
        let u = units[k];
        let up = _basic_cp_upper(u.base);
        let emit_dia = u.dia;

        // Disjunctive hiatus check: if previous vowel was accented Α, Ε, Ο (or Η) and current is unaccented Ι or Υ!
        if not emit_dia and not u.acc and k > 0 {
            let prev = units[k - 1];
            let prev_up = _basic_cp_upper(prev.base);
            if prev.acc and not prev.dia {
                if up == 921 and (prev_up == 913 or prev_up == 917 or prev_up == 927 or prev_up == 933) {
                    emit_dia = true;
                } elif up == 933 and (prev_up == 913 or prev_up == 917 or prev_up == 919 or prev_up == 927) {
                    emit_dia = true;
                }
            }
        }

        if emit_dia and up == 921 {
            array_push(out, 938); // Ϊ
        } elif emit_dia and up == 933 {
            array_push(out, 939); // Ϋ
        } else {
            array_push(out, up);
        }
        let _unused_ypo = u.ypo;
        k = k + 1;
    }
    return codepoints_to_utf8(out);
}

fn _greek_primary_weight(base_upper_cp) {
    // Orders ASCII/punctuation < digits < Latin A..Z < Greek Α..Ω (913..937) < other scripts
    if base_upper_cp >= 913 and base_upper_cp <= 937 {
        // Greek alphabet Α(913)..Ρ(929), Σ(931)..Ω(937) -> contiguous weights 1000..1023
        if base_upper_cp < 930 { return 1000 + (base_upper_cp - 913); }
        return 1000 + (base_upper_cp - 914);
    }
    if base_upper_cp >= 65 and base_upper_cp <= 90 {
        return 500 + (base_upper_cp - 65);
    }
    if base_upper_cp >= 48 and base_upper_cp <= 57 {
        return 200 + (base_upper_cp - 48);
    }
    if base_upper_cp < 128 { return base_upper_cp; }
    return 2000 + base_upper_cp;
}

fn _build_collation_keys(s) {
    let nfd = unicode_normalize_pure(s, "NFD");
    let cps = utf8_to_codepoints(nfd);
    let n = len(cps);
    let l1 = [];
    let l2 = [];
    let l3 = [];
    let i = 0;
    while i < n {
        let cp = cps[i];
        let dia_w = 0;
        let j = i + 1;
        while j < n and (cps[j] >= 768 and cps[j] <= 879) {
            let m = cps[j];
            if m == 769 { dia_w = dia_w + 1; }
            elif m == 768 { dia_w = dia_w + 2; }
            elif m == 834 { dia_w = dia_w + 3; }
            elif m == 776 { dia_w = dia_w + 4; }
            else { dia_w = dia_w + 5; }
            j = j + 1;
        }
        let up = _basic_cp_upper(cp);
        array_push(l1, _greek_primary_weight(up));
        array_push(l2, dia_w);
        // Level 3: lowercase (0), final sigma ς (1), uppercase (2)
        let case_w = 0;
        if cp == 962 { case_w = 1; }
        elif cp == up and _is_cased_cp(cp) { case_w = 2; }
        array_push(l3, case_w);
        i = j;
    }
    return map{ l1: l1, l2: l2, l3: l3 };
}

fn _cmp_int_arrays(a, b) {
    let na = len(a);
    let nb = len(b);
    let lim = if na < nb { na } else { nb };
    let i = 0;
    while i < lim {
        if a[i] < b[i] { return -1; }
        if a[i] > b[i] { return 1; }
        i = i + 1;
    }
    if na < nb { return -1; }
    if na > nb { return 1; }
    return 0;
}

fn greek_collate_compare(a, b) {
    let ka = _build_collation_keys(str(a));
    let kb = _build_collation_keys(str(b));
    let c1 = _cmp_int_arrays(ka.l1, kb.l1);
    if c1 != 0 { return c1; }
    let c2 = _cmp_int_arrays(ka.l2, kb.l2);
    if c2 != 0 { return c2; }
    return _cmp_int_arrays(ka.l3, kb.l3);
}

fn _merge_sorted_greek(left_a, right_a) {
    let out = [];
    let i = 0;
    let j = 0;
    while i < len(left_a) and j < len(right_a) {
        if greek_collate_compare(left_a[i], right_a[j]) <= 0 {
            array_push(out, left_a[i]);
            i = i + 1;
        } else {
            array_push(out, right_a[j]);
            j = j + 1;
        }
    }
    while i < len(left_a) { array_push(out, left_a[i]); i = i + 1; }
    while j < len(right_a) { array_push(out, right_a[j]); j = j + 1; }
    return out;
}

fn greek_sort_strings(items) {
    if not is_array(items) { throw "unicode16: greek_sort_strings expects array"; }
    let n = len(items);
    if n <= 1 { return slice(items, 0, n); }
    let mid = num_floor(n / 2);
    let left_s = greek_sort_strings(slice(items, 0, mid));
    let right_s = greek_sort_strings(slice(items, mid, n));
    return _merge_sorted_greek(left_s, right_s);
}

// ── UTS #39 Mixed-Script Homoglyph & CVE-2021-42574 Trojan-Source Auditor ────

fn _script_of_cp(cp) {
    if (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or (cp >= 192 and cp <= 591) {
        return "Latin";
    }
    if (cp >= 880 and cp <= 1023) or (cp >= 7936 and cp <= 8191) {
        return "Greek";
    }
    if cp >= 1024 and cp <= 1327 {
        return "Cyrillic";
    }
    if cp >= 768 and cp <= 879 {
        return "Inherited";
    }
    return "Common";
}

fn _build_uts39_confusables() {
    // Maps Greek & Cyrillic visual homoglyphs -> ASCII Latin confusable skeleton scalar
    let m = map{};
    // Cyrillic lowercase confusables (а, с, е, і, ј, о, р, ѕ, у, х)
    m["1072"] = 97;  // 'а' U+0430 -> 'a'
    m["1089"] = 99;  // 'с' U+0441 -> 'c'
    m["1077"] = 101; // 'е' U+0435 -> 'e'
    m["1110"] = 105; // 'і' U+0456 -> 'i'
    m["1112"] = 106; // 'ј' U+0458 -> 'j'
    m["1086"] = 111; // 'о' U+043E -> 'o'
    m["1088"] = 112; // 'р' U+0440 -> 'p'
    m["1109"] = 115; // 'ѕ' U+0455 -> 's'
    m["1091"] = 121; // 'у' U+0443 -> 'y'
    m["1093"] = 120; // 'х' U+0445 -> 'x'
    // Cyrillic uppercase confusables (А, В, Е, К, М, Н, О, Р, С, Т, Х)
    m["1040"] = 65;  m["1042"] = 66;  m["1045"] = 69;  m["1050"] = 75;
    m["1052"] = 77;  m["1053"] = 72;  m["1054"] = 79;  m["1056"] = 80;
    m["1057"] = 67;  m["1058"] = 84;  m["1061"] = 88;
    // Greek lowercase & uppercase confusables (α, ε, ι, κ, ν, ο, ρ, υ, χ, Α, Β, Ε, Ζ, Η, Ι, Κ, Μ, Ν, Ο, Ρ, Τ, Υ, Χ)
    m["945"] = 97;   m["949"] = 101;  m["953"] = 105;  m["954"] = 107;
    m["957"] = 118;  m["959"] = 111;  m["961"] = 112;  m["965"] = 117;  m["967"] = 120;
    m["913"] = 65;   m["914"] = 66;   m["917"] = 69;   m["918"] = 90;
    m["919"] = 72;   m["921"] = 73;   m["922"] = 75;   m["924"] = 77;
    m["925"] = 78;   m["927"] = 79;   m["929"] = 80;   m["932"] = 84;
    m["933"] = 89;   m["935"] = 88;
    return m;
}

let _UTS39_CONFUSABLES = _build_uts39_confusables();

fn _is_zero_width_invisible(cp) {
    return cp == 173                      // U+00AD SOFT HYPHEN
        or (cp >= 8203 and cp <= 8207)    // U+200B..U+200F (ZWSP, ZWNJ, ZWJ, LRM, RLM)
        or (cp >= 8288 and cp <= 8292)    // U+2060..U+2064 (WJ, invisible operators)
        or cp == 65279                    // U+FEFF BOM / ZWNBSP
        or (cp >= 917504 and cp <= 917631); // U+E0000..U+E007F Tag characters
}

fn _is_bidi_control(cp) {
    return cp == 1564                     // U+061C ALM
        or cp == 8206 or cp == 8207       // U+200E LRM, U+200F RLM
        or (cp >= 8234 and cp <= 8238)    // U+202A..U+202E (LRE, RLE, PDF, LRO, RLO)
        or (cp >= 8294 and cp <= 8297);   // U+2066..U+2069 (LRI, RLI, FSI, PDI)
}

fn _is_token_delim(cp) {
    // Splits words/identifiers/hostnames (keeps '.' inside domain tokens AND checks label mixing!)
    return cp <= 32 or cp == 47 or cp == 58 or cp == 59 or cp == 44 or cp == 40 or cp == 41 or
           cp == 91 or cp == 93 or cp == 123 or cp == 125 or cp == 34 or cp == 39;
}

fn audit_unicode_security(text) {
    let cps = utf8_to_codepoints(text);
    let n = len(cps);
    let findings = [];
    let has_bidi_trojan = false;
    let has_unbalanced_bidi = false;
    let has_zero_width = false;
    let has_mixed_script_homoglyph = false;

    let embed_depth = 0;   // LRE/RLE/LRO/RLO closed by PDF (0x202C)
    let isolate_depth = 0; // LRI/RLI/FSI closed by PDI (0x2069)

    // Build confusable skeleton while auditing BiDi & invisible controls
    let skel_cps = [];
    let i = 0;
    while i < n {
        let cp = cps[i];
        if cp == 10 or cp == 13 {
            if embed_depth != 0 or isolate_depth != 0 {
                has_unbalanced_bidi = true;
                has_bidi_trojan = true;
                array_push(findings, map{
                    kind: "cve_2021_42574_unterminated_bidi_line",
                    index: i,
                    codepoint: cp
                });
                embed_depth = 0;
                isolate_depth = 0;
            }
        }
        if _is_bidi_control(cp) {
            has_bidi_trojan = true;
            if cp == 8237 or cp == 8238 { // LRO / RLO explicit override!
                embed_depth = embed_depth + 1;
                array_push(findings, map{ kind: "hostile_bidi_override", index: i, codepoint: cp });
            } elif cp == 8234 or cp == 8235 { // LRE / RLE
                embed_depth = embed_depth + 1;
                array_push(findings, map{ kind: "bidi_embedding", index: i, codepoint: cp });
            } elif cp == 8236 { // PDF
                if embed_depth <= 0 {
                    has_unbalanced_bidi = true;
                    array_push(findings, map{ kind: "unbalanced_bidi_pdf", index: i, codepoint: cp });
                } else {
                    embed_depth = embed_depth - 1;
                }
            } elif cp == 8294 or cp == 8295 or cp == 8296 { // LRI / RLI / FSI
                isolate_depth = isolate_depth + 1;
                array_push(findings, map{ kind: "bidi_isolate_open", index: i, codepoint: cp });
            } elif cp == 8297 { // PDI
                if isolate_depth <= 0 {
                    has_unbalanced_bidi = true;
                    array_push(findings, map{ kind: "unbalanced_bidi_pdi", index: i, codepoint: cp });
                } else {
                    isolate_depth = isolate_depth - 1;
                }
            } else {
                array_push(findings, map{ kind: "bidi_mark", index: i, codepoint: cp });
            }
        }
        if _is_zero_width_invisible(cp) {
            // Allow ZWJ only when sandwiched between Extended_Pictographic emoji!
            let emoji_zwj = (cp == 8205 and i > 0 and i + 1 < n and
                             (_is_extended_pictographic(cps[i - 1]) or _is_emoji_modifier(cps[i - 1])) and
                             _is_extended_pictographic(cps[i + 1]));
            if not emoji_zwj {
                has_zero_width = true;
                array_push(findings, map{ kind: "invisible_zero_width_char", index: i, codepoint: cp });
            }
        }

        let sk_key = str(cp);
        if map_has(_UTS39_CONFUSABLES, sk_key) {
            array_push(skel_cps, _UTS39_CONFUSABLES[sk_key]);
        } elif not _is_zero_width_invisible(cp) and not _is_bidi_control(cp) {
            array_push(skel_cps, cp);
        }
        i = i + 1;
    }

    if embed_depth != 0 or isolate_depth != 0 {
        has_unbalanced_bidi = true;
        has_bidi_trojan = true;
        array_push(findings, map{ kind: "unbalanced_bidi_eof", index: n, codepoint: -1 });
    }

    // Token-level UTS #39 Mixed-Script Homoglyph scan (e.g. "pаypal.com" or mixed identifier)
    let t_start = 0;
    while t_start < n {
        while t_start < n and _is_token_delim(cps[t_start]) { t_start = t_start + 1; }
        if t_start >= n { break; }
        let t_end = t_start;
        let saw_latin = false;
        let saw_greek = false;
        let saw_cyrillic = false;
        let saw_confusable = false;
        while t_end < n and not _is_token_delim(cps[t_end]) {
            let c = cps[t_end];
            let sc = _script_of_cp(c);
            if sc == "Latin" { saw_latin = true; }
            elif sc == "Greek" { saw_greek = true; }
            elif sc == "Cyrillic" { saw_cyrillic = true; }
            if map_has(_UTS39_CONFUSABLES, str(c)) { saw_confusable = true; }
            t_end = t_end + 1;
        }
        let script_cnt = (if saw_latin { 1 } else { 0 }) +
                         (if saw_greek { 1 } else { 0 }) +
                         (if saw_cyrillic { 1 } else { 0 });
        if script_cnt >= 2 {
            has_mixed_script_homoglyph = true;
            let tok_str = codepoints_to_utf8(slice(cps, t_start, t_end));
            array_push(findings, map{
                kind: "uts39_mixed_script_homoglyph",
                token: tok_str,
                index: t_start,
                has_confusable: saw_confusable
            });
        }
        t_start = t_end;
    }

    let safe = not (has_bidi_trojan or has_zero_width or has_mixed_script_homoglyph);
    let risk = "none";
    if has_bidi_trojan or has_mixed_script_homoglyph { risk = "critical"; }
    elif has_zero_width { risk = "high"; }

    return map{
        ok: true,
        safe: safe,
        risk_level: risk,
        has_bidi_trojan: has_bidi_trojan,
        has_unbalanced_bidi: has_unbalanced_bidi,
        has_zero_width: has_zero_width,
        has_mixed_script_homoglyph: has_mixed_script_homoglyph,
        skeleton: codepoints_to_utf8(skel_cps),
        finding_count: len(findings),
        findings: findings
    };
}

export MODULE_VERSION, UNICODE_STANDARD_VERSION;
export is_valid_unicode_scalar, validate_utf8_bytes;
export utf8_to_codepoints, codepoints_to_utf8, codepoints_to_utf8_bytes;
export utf8_to_utf16le_bytes, utf16le_bytes_to_utf8;
export utf8_to_utf16be_bytes, utf16be_bytes_to_utf8;
export combining_class_pure, unicode_normalize_pure;
export unicode_graphemes_pure, unicode_grapheme_count;
export greek_to_lower, greek_to_upper_tonos_free, greek_strip_accents;
export greek_collate_compare, greek_sort_strings;
export audit_unicode_security;
