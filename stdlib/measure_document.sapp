let Units=import("stdlib:units.sapp");let Serialization=import("stdlib:serialization.sapp");let Sheet=import("stdlib:sheet_document.sapp");
let FORMAT="pblang.measure-sheet.v1";let MAX_ROWS=31;let MAX_FILE_BYTES=65536;
fn _keys(value,keys) {if type(value)!="map" or len(value)!=len(keys) {return false;}for key in keys {if not map_has(value,key) {return false;}}return true;}
fn _text(value) {
    if type(value)!="string" or len(value)>60 or len(str_to_bytes(value))>120 or str_trim(value)=="" {throw "measure: short nonblank label required";}
    for i in range(0,len(value)) {let c=strcharcodeat(value,i);if c<32 or c==127 {throw "measure: control character";}}
}
fn _index(index,max) {if type(index)!="number" or not (index>=0 and index<=max) or index!=num_floor(index) {throw "measure: invalid row index";}}
fn _checked(doc,collect) {
    if not _keys(doc,["format","title","rows"]) or doc.format!=FORMAT or type(doc.rows)!="array" or len(doc.rows)<1 or len(doc.rows)>MAX_ROWS {throw "measure: invalid worksheet";}
    _text(doc.title);let values=[];
    for row in doc.rows {
        if not _keys(row,["label","value","from","to","mode"]) {throw "measure: invalid row";}
        _text(row.label);let value=Units.convert_checked(row.value,row.from,row.to,row.mode);
        if collect {array_push(values,value);}
    }
    return values;
}
fn validate(doc) {_checked(doc,false);return true;}
fn copy(doc) {
    validate(doc);let rows=[];for row in doc.rows {array_push(rows,map{label:row.label,value:row.value,from:row.from,to:row.to,mode:row.mode});}
    return map{format:FORMAT,title:doc.title,rows:rows};
}
fn create(title="Measurement worksheet") {let doc=map{format:FORMAT,title:title,rows:[map{label:"Length",value:1,from:"m",to:"cm",mode:"absolute"}]};validate(doc);return doc;}
fn set_row(doc,index,label,value,from,to,mode="absolute") {
    let out=copy(doc);_index(index,len(out.rows)-1);out.rows[index]=map{label:label,value:value,from:from,to:to,mode:mode};validate(out);return out;
}
fn append(doc) {let out=copy(doc);if len(out.rows)>=MAX_ROWS {throw "measure: row limit";}array_push(out.rows,map{label:"New conversion",value:1,from:"m",to:"cm",mode:"absolute"});return out;}
fn remove(doc,index) {
    let out=copy(doc);_index(index,len(out.rows)-1);if len(out.rows)==1 {throw "measure: keep one row";}let rows=[];
    for i in range(0,len(out.rows)) {if i!=index {array_push(rows,out.rows[i]);}}out.rows=rows;return out;
}
fn rename(doc,title) {let out=copy(doc);_text(title);out.title=title;return out;}
fn results(doc) {
    return _checked(doc,true);
}
// Reverse a stored conversion using its derived result as the new input.
fn reverse_row(doc,index) {
    let out=copy(doc);_index(index,len(out.rows)-1);let row=out.rows[index];
    let value=Units.convert_checked(row.value,row.from,row.to,row.mode);
    out.rows[index]=map{label:row.label,value:value,from:row.to,to:row.from,mode:row.mode};
    validate(out);return out;
}
fn to_sheet(doc) {
    let values=results(doc);let sheet=Sheet.create(len(doc.rows)+1,6);sheet.cells[0]=["Label","Value","From","To","Mode","Result"];
    for i in range(0,len(doc.rows)) {let row=doc.rows[i];sheet.cells[i+1]=[row.label,str(row.value),row.from,row.to,row.mode,str(values[i])];}
    Sheet.validate(sheet);return sheet;
}
fn _limits() {return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:1024,strict:true,reject_duplicate_keys:true};}
fn encode(doc) {let r=Serialization.stringify_safe(copy(doc),"json",_limits());if not r.ok {throw "measure: encoding failed";}return r.value;}
fn decode(text) {let r=Serialization.parse_safe(text,"json",_limits());if not r.ok or not r.duplicate_keys_checked {throw "measure: invalid document";}return copy(r.value);}
export FORMAT,MAX_ROWS,MAX_FILE_BYTES,validate,copy,create,set_row,append,remove,rename,results,reverse_row,to_sheet,encode,decode;
