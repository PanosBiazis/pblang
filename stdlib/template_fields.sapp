// Strict literal fields; separate opt-in grammar from the general template engine.
let FORMAT="pblang.template-fields.v1";
fn _text(value,limit) {
 if type(value)!="string" or len(value)>limit or len(str_to_bytes(value))>limit or str_contains(value,"\u0000") {throw "field text limit or type";}
}
fn valid_name(name) {
 if type(name)!="string" or len(name)<1 or len(name)>32 {return false;}
 for i in range(0,len(name)) {
  let c=strcharcodeat(name,i);let letter=(c>=65 and c<=90) or (c>=97 and c<=122) or c==95;
  if not letter and not (i>0 and c>=48 and c<=57) {return false;}
 }
 return true;
}
fn compile(source) {
 _text(source,4096);let tokens=[];let start=0;let i=0;let fields=0;
 while i<len(source) {
  let pair=str_slice(source,i,i+2);
  if pair=="{%" or pair=="{#" or pair=="}}" {throw "unsupported field syntax";}
  if pair=="{{" {
   if i>start {array_push(tokens,map{kind:"text",value:str_slice(source,start,i)});}
   let end=i+2;
   while end+1<len(source) and str_slice(source,end,end+2)!="}}" {end=end+1;}
   if end+1>=len(source) {throw "unclosed field";}
   let name=str_trim(str_slice(source,i+2,end));if not valid_name(name) {throw "invalid field name";}
   fields=fields+1;if fields>64 {throw "field count limit";}
   array_push(tokens,map{kind:"field",value:name});i=end+2;start=i;
  } else {i=i+1;}
 }
 if start<len(source) {array_push(tokens,map{kind:"text",value:str_slice(source,start,len(source))});}
 return map{format:FORMAT,tokens:tokens};
}
fn _plan(plan) {
 if type(plan)!="map" or len(plan)!=2 or (try plan.format catch nil)!=FORMAT or type(try plan.tokens catch nil)!="array" or len(plan.tokens)>129 {throw "invalid compiled fields";}
 let bytes=0;let fields=0;
 for token in plan.tokens {
  if type(token)!="map" or len(token)!=2 or not map_has(token,"kind") or not map_has(token,"value") {throw "invalid field token";}
  if token.kind=="field" {if not valid_name(token.value) {throw "invalid compiled name";}fields=fields+1;}
  elif token.kind=="text" {_text(token.value,4096);bytes=bytes+len(str_to_bytes(token.value));}
  else {throw "invalid token kind";}
 }
 if bytes>4096 or fields>64 {throw "compiled field limits";}
}
fn names(plan) {
 _plan(plan);let out=[];let seen=map{};
 for token in plan.tokens {if token.kind=="field" and not map_has(seen,token.value) {seen[token.value]=true;array_push(out,token.value);}}
 return out;
}
fn render_compiled(plan,context,limit=32768) {
 _plan(plan);
 if type(limit)!="number" or not (limit>=0 and limit<=32768) or limit!=num_floor(limit) or type(context)!="map" or len(context)>32 {throw "invalid field context or output limit";}
 let context_bytes=0;
 for key in map_keys(context) {if not valid_name(key) {throw "invalid context key";}_text(context[key],4096);context_bytes=context_bytes+len(str_to_bytes(context[key]));}
 if context_bytes>32768 {throw "context size limit";}
 let parts=[];let size=0;
 for token in plan.tokens {
  let piece=token.value;
  if token.kind=="field" {if not map_has(context,token.value) {throw "missing template field";}piece=context[token.value];}
  let bytes=len(str_to_bytes(piece));if bytes>limit-size {throw "rendered field output limit";}
  array_push(parts,piece);size=size+bytes;
 }
 return str_join(parts,"");
}
fn render(source,context,limit=32768) {return render_compiled(compile(source),context,limit);}
export FORMAT,valid_name,compile,names,render_compiled,render;
