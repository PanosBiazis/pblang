//! serialization.sapp — Multi-format serialization for pblang
//! Supports JSON (pretty/validate), TOML, YAML, CSV, XML escaping.
//! TOML/YAML are parsed natively in pblang — no external tools, no shelling
//! out (the old `exec(... | python3 ...)` path was both a non-pblang
//! dependency and a shell-injection vector on untrusted input).

let csv_mod = import("stdlib:csv.sapp");

// ---------------------------------------------------------------------------
// Shared scalar/structure helpers used by the native TOML + YAML parsers.
// ---------------------------------------------------------------------------

/// Count leading spaces (the indentation level) of a raw line.
fn _ser_indent(line) {
    let n = len(line);
    let i = 0;
    while i < n and str_slice(line, i, i + 1) == " " { i = i + 1; }
    return i;
}

/// True only if `s` is a plain numeric literal. `parse_number` THROWS on
/// non-numeric input, so we must gate the call rather than try/catch it.
fn _ser_is_num(s) {
    let n = len(s);
    if n == 0 { return false; }
    let i = 0;
    let digits = 0;
    let dots = 0;
    while i < n {
        let c = strcharcodeat(s, i);
        if c >= 48 and c <= 57 { digits = digits + 1; }
        else if c == 46 { dots = dots + 1; }
        else if c == 45 or c == 43 { if i != 0 { return false; } }
        else { return false; }
        i = i + 1;
    }
    return digits > 0 and dots <= 1;
}

/// Strip a matching pair of surrounding quotes from a key/identifier.
fn _ser_unquote_key(k) {
    let s = str_trim(k);
    let n = len(s);
    if n >= 2 {
        let f = str_slice(s, 0, 1);
        let l = str_slice(s, n - 1, n);
        if (f == "\"" and l == "\"") or (f == "'" and l == "'") {
            return str_slice(s, 1, n - 1);
        }
    }
    return s;
}

/// Interpret a raw scalar fragment as string / number / bool / null.
fn _ser_scalar(raw) {
    let s = str_trim(raw);
    let n = len(s);
    if n == 0 { return ""; }
    let first = str_slice(s, 0, 1);
    let last = str_slice(s, n - 1, n);
    if n >= 2 and ((first == "\"" and last == "\"") or (first == "'" and last == "'")) {
        return str_slice(s, 1, n - 1);
    }
    if s == "true" { return true; }
    if s == "false" { return false; }
    if s == "null" or s == "~" { return nil; }
    if _ser_is_num(s) { return parse_number(s); }
    return s;
}

/// Split on `sep` at the top level only (commas inside quotes are kept).
fn _ser_split_top(s, sep) {
    let out = [];
    let cur = "";
    let i = 0;
    let n = len(s);
    let inq = false;
    let qch = "";
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if inq {
            cur = cur + ch;
            if ch == qch { inq = false; }
        } else {
            if ch == "\"" or ch == "'" { inq = true; qch = ch; cur = cur + ch; }
            else if ch == sep { array_push(out, cur); cur = ""; }
            else { cur = cur + ch; }
        }
        i = i + 1;
    }
    array_push(out, cur);
    return out;
}

/// Drop an unquoted trailing `#` comment from a value fragment.
fn _ser_strip_comment(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    let inq = false;
    let qch = "";
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if inq {
            out = out + ch;
            if ch == qch { inq = false; }
        } else {
            if ch == "\"" or ch == "'" { inq = true; qch = ch; out = out + ch; }
            else if ch == "#" { i = n; }
            else { out = out + ch; }
        }
        i = i + 1;
    }
    return out;
}

/// Parse an inline `[a, b, c]` flow array into a pblang array.
fn _ser_flow_array(s) {
    let t = str_trim(s);
    let inner = str_slice(t, 1, len(t) - 1);
    let out = [];
    if str_trim(inner) == "" { return out; }
    let parts = _ser_split_top(inner, ",");
    let i = 0;
    while i < len(parts) {
        let p = str_trim(parts[i]);
        if p != "" { array_push(out, _ser_scalar(p)); }
        i = i + 1;
    }
    return out;
}

fn _ser_spaces(n) {
    let out = "";
    let i = 0;
    while i < n {
        out = out + " ";
        i = i + 1;
    }
    return out;
}

fn _ser_escape_string(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if ch == "\\" { out = out + "\\\\"; }
        else if ch == "\"" { out = out + "\\\""; }
        else if ch == "\n" { out = out + "\\n"; }
        else if ch == "\r" { out = out + "\\r"; }
        else if ch == "\t" { out = out + "\\t"; }
        else { out = out + ch; }
        i = i + 1;
    }
    return out;
}

fn _ser_quote(s) {
    return "\"" + _ser_escape_string(str(s)) + "\"";
}

fn _ser_is_scalar(v) {
    let t = type(v);
    return v == nil or t == "string" or t == "number" or t == "bool";
}

fn _ser_scalar_out(v) {
    if v == nil { return "null"; }
    let t = type(v);
    if t == "string" { return _ser_quote(v); }
    if t == "number" { return str(v); }
    if t == "bool" {
        if v == true { return "true"; }
        return "false";
    }
    return _ser_quote(str(v));
}

fn _ser_array_out(arr) {
    let out = "[";
    let i = 0;
    while i < len(arr) {
        if i > 0 { out = out + ", "; }
        if _ser_is_scalar(arr[i]) {
            out = out + _ser_scalar_out(arr[i]);
        } else {
            out = out + _ser_quote(str(arr[i]));
        }
        i = i + 1;
    }
    return out + "]";
}

/// Pretty-print JSON with indentation (2 spaces)
fn json_pretty(data) {
    let json_str = json_stringify(data);
    // Simple pretty-printing: add newlines and indentation
    let result = "";
    let indent = 0;
    let i = 0;
    let len = len(json_str);
    let in_string = false;
    let prev = "";
    
    while i < len {
        let ch = json_str[i..(i+1)];
        
        if ch == "\"" and prev != "\\" { in_string = not in_string; }
        
        if in_string {
            result = result + ch;
        } else {
            if ch == "{" or ch == "[" {
                result = result + ch + "\n";
                indent = indent + 2;
                let j = 0;
                while j < indent { result = result + " "; j = j + 1; }
            } else {
                if ch == "}" or ch == "]" {
                    indent = indent - 2;
                    result = result + "\n";
                    let j = 0;
                    while j < indent { result = result + " "; j = j + 1; }
                    result = result + ch;
                } else {
                    if ch == "," {
                        result = result + ch + "\n";
                        let j = 0;
                        while j < indent { result = result + " "; j = j + 1; }
                    } else {
                        if ch == ":" { result = result + ch + " "; }
                        else { result = result + ch; }
                    }
                }
            }
        }
        
        prev = ch;
        i = i + 1;
    }
    return result;
}

/// Validate if a string is valid JSON
fn json_validate(data) {
    let result = try json_parse(data) catch "__pblang_invalid_json__";
    return result != "__pblang_invalid_json__";
}

fn json_validate_detail(data) {
    let result = try json_parse(data) catch "__pblang_invalid_json__";
    if result == "__pblang_invalid_json__" {
        return map{ ok: false, error: "invalid JSON" };
    }
    return map{ ok: true, value: result };
}

/// Get or create the nested table for a (possibly dotted) `[section]` name.
fn _ser_toml_table(root, name) {
    let parts = _ser_split_top(name, ".");
    let cur = root;
    let i = 0;
    while i < len(parts) {
        let p = _ser_unquote_key(str_trim(parts[i]));
        if not map_has(cur, p) { cur[p] = map{}; }
        cur = cur[p];
        i = i + 1;
    }
    return cur;
}

/// Native TOML parser (subset: comments, [tables] incl. dotted, key = value,
/// strings/numbers/booleans, and inline `[a, b]` arrays). Returns a map.
fn toml_parse(data) {
    let result = map{};
    if data == nil or data == "" { return result; }
    let lines = str_split(data, "\n");
    let cur = result;
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        i = i + 1;
        if line == "" or str_slice(line, 0, 1) == "#" { continue; }
        if str_slice(line, 0, 1) == "[" {
            let close = str_index_of(line, "]");
            if close > 0 {
                let name = str_trim(str_slice(line, 1, close));
                // [[array of tables]] is treated as a plain table here.
                if str_slice(name, 0, 1) == "[" { name = str_trim(str_slice(name, 1, len(name))); }
                cur = _ser_toml_table(result, name);
            }
        } else {
            let eq = str_index_of(line, "=");
            if eq > 0 {
                let key = _ser_unquote_key(str_trim(str_slice(line, 0, eq)));
                let valc = str_trim(_ser_strip_comment(str_slice(line, eq + 1, len(line))));
                if len(valc) > 0 and str_slice(valc, 0, 1) == "[" {
                    cur[key] = _ser_flow_array(valc);
                } else {
                    cur[key] = _ser_scalar(valc);
                }
            }
        }
    }
    return result;
}

fn _toml_write_table(data, prefix) {
    let result = "";
    let nested = [];
    let keys = map_keys(data);
    let i = 0;
    while i < len(keys) {
        let key = keys[i];
        let val = data[key];
        let t = type(val);
        if t == "map" {
            array_push(nested, key);
        } else if t == "array" {
            result = result + key + " = " + _ser_array_out(val) + "\n";
        } else {
            result = result + key + " = " + _ser_scalar_out(val) + "\n";
        }
        i = i + 1;
    }
    let n = 0;
    while n < len(nested) {
        let key = nested[n];
        let table_name = key;
        if prefix != "" { table_name = prefix + "." + key; }
        if result != "" { result = result + "\n"; }
        result = result + "[" + table_name + "]\n";
        result = result + _toml_write_table(data[key], table_name);
        n = n + 1;
    }
    return result;
}

/// TOML stringify for scalar keys, arrays, and nested map tables.
fn toml_stringify(data) {
    if data == nil { return ""; }
    if type(data) != "map" { return ""; }
    return _toml_write_table(data, "");
}

/// Indentation of the next significant (non-blank, non-comment) line, or -1.
fn _yaml_next_indent(lines, start) {
    let n = len(lines);
    let i = start;
    while i < n {
        let t = str_trim(lines[i]);
        if t == "" or str_slice(t, 0, 1) == "#" { i = i + 1; }
        else { return _ser_indent(lines[i]); }
    }
    return -1;
}

/// Parse one YAML block (a run of lines sharing the indent of the first
/// significant line at/after `start`). Deeper lines recurse. Returns
/// map{ val, next } where `next` is the line index after the block.
fn _yaml_block(lines, start) {
    let n = len(lines);
    let i = start;
    while i < n {
        let t = str_trim(lines[i]);
        if t == "" or str_slice(t, 0, 1) == "#" { i = i + 1; } else { break; }
    }
    if i >= n { return map{ val: nil, next: i }; }

    let baseIndent = _ser_indent(lines[i]);
    let firstT = str_trim(lines[i]);
    let isList = (str_slice(firstT, 0, 2) == "- " or firstT == "-");

    if isList {
        let arr = [];
        while i < n {
            let raw = lines[i];
            let t = str_trim(raw);
            if t == "" or str_slice(t, 0, 1) == "#" { i = i + 1; continue; }
            let ind = _ser_indent(raw);
            if ind != baseIndent { break; }
            if not (str_slice(t, 0, 2) == "- " or t == "-") { break; }
            let item = str_trim(str_slice(t, 1, len(t)));
            i = i + 1;
            if item == "" {
                let sub = _yaml_block(lines, i);
                array_push(arr, sub["val"]);
                i = sub["next"];
            } else {
                let colon = str_index_of(item, ":");
                if colon > 0 {
                    let m = map{};
                    let k = _ser_unquote_key(str_trim(str_slice(item, 0, colon)));
                    let v = str_trim(str_slice(item, colon + 1, len(item)));
                    m[k] = _ser_scalar(v);
                    array_push(arr, m);
                } else {
                    array_push(arr, _ser_scalar(item));
                }
            }
        }
        return map{ val: arr, next: i };
    }

    let m = map{};
    while i < n {
        let raw = lines[i];
        let t = str_trim(raw);
        if t == "" or str_slice(t, 0, 1) == "#" { i = i + 1; continue; }
        let ind = _ser_indent(raw);
        if ind != baseIndent { break; }
        let line = str_trim(_ser_strip_comment(t));
        let colon = str_index_of(line, ":");
        if colon < 0 { i = i + 1; continue; }
        let key = _ser_unquote_key(str_trim(str_slice(line, 0, colon)));
        let valraw = str_trim(str_slice(line, colon + 1, len(line)));
        i = i + 1;
        if valraw == "" {
            if _yaml_next_indent(lines, i) > baseIndent {
                let sub = _yaml_block(lines, i);
                m[key] = sub["val"];
                i = sub["next"];
            } else {
                m[key] = nil;
            }
        } else if str_slice(valraw, 0, 1) == "[" {
            m[key] = _ser_flow_array(valraw);
        } else {
            m[key] = _ser_scalar(valraw);
        }
    }
    return map{ val: m, next: i };
}

/// Native YAML parser (subset: comments, nested maps by indentation, scalar
/// and `- ` sequences, inline `[a, b]` flow arrays, true/false/null). Returns
/// a map (or an array if the document's top level is a sequence).
fn yaml_parse(data) {
    if data == nil or data == "" { return map{}; }
    let lines = str_split(data, "\n");
    let res = _yaml_block(lines, 0);
    let v = res["val"];
    if v == nil { return map{}; }
    return v;
}

fn _yaml_write(data, indent) {
    let pad = _ser_spaces(indent);
    let t = type(data);
    if t == "map" {
        let result = "";
        let keys = map_keys(data);
        let i = 0;
        while i < len(keys) {
            let key = keys[i];
            let val = data[key];
            if _ser_is_scalar(val) {
                result = result + pad + key + ": " + _ser_scalar_out(val) + "\n";
            } else {
                result = result + pad + key + ":\n" + _yaml_write(val, indent + 2);
            }
            i = i + 1;
        }
        return result;
    }
    if t == "array" {
        let result = "";
        let i = 0;
        while i < len(data) {
            let val = data[i];
            if _ser_is_scalar(val) {
                result = result + pad + "- " + _ser_scalar_out(val) + "\n";
            } else {
                result = result + pad + "-\n" + _yaml_write(val, indent + 2);
            }
            i = i + 1;
        }
        return result;
    }
    return pad + _ser_scalar_out(data) + "\n";
}

/// YAML stringify for nested maps, arrays, and scalar values.
fn yaml_stringify(data) {
    if data == nil { return ""; }
    return _yaml_write(data, 0);
}

/// Parse CSV string into array of maps
fn csv_parse(text, delimiter = ",") {
    return csv_mod.parse_maps(text, delimiter);
}

/// Convert array of maps to CSV string
fn csv_stringify(rows, columns) {
    return csv_mod.stringify_maps(rows, ",", columns);
}

/// Escape special XML characters
fn xml_escape(text) {
    let result = "";
    let i = 0;
    while i < len(text) {
        let ch = text[i..(i+1)];
        if ch == "&" { result = result + "&amp;"; }
        else { if ch == "<" { result = result + "&lt;"; }
        else { if ch == ">" { result = result + "&gt;"; }
        else { if ch == "\"" { result = result + "&quot;"; }
        else { if ch == "'" { result = result + "&apos;"; }
        else { result = result + ch; } } } } }
        i = i + 1;
    }
    return result;
}

/// Unescape XML entities
fn xml_unescape(text) {
    let result = text;
    result = str_replace(result, "&amp;", "&");
    result = str_replace(result, "&lt;", "<");
    result = str_replace(result, "&gt;", ">");
    result = str_replace(result, "&quot;", "\"");
    result = str_replace(result, "&apos;", "'");
    return result;
}

fn detect_format(text) {
    let s = str_trim(text);
    if s == "" { return "text"; }
    let first = str_slice(s, 0, 1);
    if first == "{" or first == "[" { return "json"; }
    if first == "<" { return "xml"; }
    let first_line = s;
    let nl = str_index_of(s, "\n");
    if nl >= 0 { first_line = str_slice(s, 0, nl); }
    if str_index_of(first_line, ",") >= 0 { return "csv"; }
    if str_index_of(s, "=") >= 0 { return "toml"; }
    if str_index_of(s, ":") >= 0 { return "yaml"; }
    return "text";
}

fn parse_format(text, format = "auto") {
    let fmt = format;
    if fmt == nil or fmt == "" or fmt == "auto" { fmt = detect_format(text); }
    if fmt == "json" { return json_parse(text); }
    if fmt == "toml" { return toml_parse(text); }
    if fmt == "yaml" or fmt == "yml" { return yaml_parse(text); }
    if fmt == "csv" { return csv_parse(text, ","); }
    return text;
}

fn stringify_format(data, format = "json") {
    if format == "json" { return json_stringify(data); }
    if format == "json_pretty" or format == "pretty_json" { return json_pretty(data); }
    if format == "toml" { return toml_stringify(data); }
    if format == "yaml" or format == "yml" { return yaml_stringify(data); }
    if format == "csv" { return csv_stringify(data, nil); }
    if format == "xml_text" { return xml_escape(str(data)); }
    return str(data);
}

fn convert(text, from_format, to_format) {
    let data = parse_format(text, from_format);
    return stringify_format(data, to_format);
}

export json_pretty;
export json_validate;
export json_validate_detail;
export toml_parse;
export toml_stringify;
export yaml_parse;
export yaml_stringify;
export csv_parse;
export csv_stringify;
export xml_escape;
export xml_unescape;
export detect_format;
export parse_format;
export stringify_format;
export convert;
