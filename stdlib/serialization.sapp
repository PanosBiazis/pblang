//! serialization.sapp — Multi-format serialization for pblang
//! Supports JSON (pretty/validate), TOML, YAML, CSV, XML escaping.
//! Uses existing json builtins and system tools for TOML/YAML.

/// Pretty-print JSON with indentation (2 spaces)
fn json_pretty(data) {
    let json_str = json_stringify(data);
    // Simple pretty-printing: add newlines and indentation
    let result = "";
    let indent = 0;
    let i = 0;
    let len = len(json_str);
    let in_string = false;
    let prev = "";
    
    while i < len {
        let ch = json_str[i..(i+1)];
        
        if ch == "\"" and prev != "\\" { in_string = not in_string; }
        
        if in_string {
            result = result + ch;
        } else {
            if ch == "{" or ch == "[" {
                result = result + ch + "\n";
                indent = indent + 2;
                let j = 0;
                while j < indent { result = result + " "; j = j + 1; }
            } else {
                if ch == "}" or ch == "]" {
                    indent = indent - 2;
                    result = result + "\n";
                    let j = 0;
                    while j < indent { result = result + " "; j = j + 1; }
                    result = result + ch;
                } else {
                    if ch == "," {
                        result = result + ch + "\n";
                        let j = 0;
                        while j < indent { result = result + " "; j = j + 1; }
                    } else {
                        if ch == ":" { result = result + ch + " "; }
                        else { result = result + ch; }
                    }
                }
            }
        }
        
        prev = ch;
        i = i + 1;
    }
    return result;
}

/// Validate if a string is valid JSON
fn json_validate(data) {
    let result = json_parse(data);
    return result != nil;
}

/// TOML parse using system tool (if available)
fn toml_parse(data) {
    let result = exec("echo '" + data + "' | python3 -c \"import sys,json,tomllib; print(json.dumps(tomllib.loads(sys.stdin.read())))\" 2>/dev/null");
    if result == "" or result == nil { return {}; }
    return json_parse(result);
}

/// TOML stringify (simple key-value only)
fn toml_stringify(data) {
    if data == nil { return ""; }
    let result = "";
    let keys = map_keys(data);
    let i = 0;
    while i < len(keys) {
        let key = keys[i];
        let val = data[key];
        if val is string { result = result + key + " = \"" + val + "\"\n"; }
        else { if val is number { result = result + key + " = " + str(val) + "\n"; } }
        i = i + 1;
    }
    return result;
}

/// YAML parse using system tool (if available)  
fn yaml_parse(data) {
    let result = exec("echo '" + data + "' | python3 -c \"import sys,json,yaml; print(json.dumps(yaml.safe_load(sys.stdin.read())))\" 2>/dev/null");
    if result == "" or result == nil { return {}; }
    return json_parse(result);
}

/// YAML stringify (simple)
fn yaml_stringify(data) {
    if data == nil { return ""; }
    let result = "";
    let keys = map_keys(data);
    let i = 0;
    while i < len(keys) {
        let key = keys[i];
        let val = data[key];
        if val is string { result = result + key + ": \"" + val + "\"\n"; }
        else { if val is number { result = result + key + ": " + str(val) + "\n"; } }
        i = i + 1;
    }
    return result;
}

/// Parse CSV string into array of maps
fn csv_parse(text, delimiter = ",") {
    if text == "" or text == nil { return []; }
    
    let lines = [];
    let current = "";
    let i = 0;
    while i < len(text) {
        let ch = text[i..(i+1)];
        if ch == "\n" {
            array_push(lines, current);
            current = "";
        } else {
            current = current + ch;
        }
        i = i + 1;
    }
    if current != "" { array_push(lines, current); }
    
    if len(lines) == 0 { return []; }
    
    // Parse header
    let headers = [];
    let field = "";
    let j = 0;
    let header_line = lines[0];
    while j < len(header_line) {
        let ch = header_line[j..(j+1)];
        if ch == delimiter {
            array_push(headers, field);
            field = "";
        } else {
            field = field + ch;
        }
        j = j + 1;
    }
    array_push(headers, field);
    
    // Parse rows
    let rows = [];
    let k = 1;
    while k < len(lines) {
        let row = {};
        let field2 = "";
        let col = 0;
        let m = 0;
        let line = lines[k];
        while m < len(line) {
            let ch = line[m..(m+1)];
            if ch == delimiter {
                if col < len(headers) { row[headers[col]] = field2; }
                field2 = "";
                col = col + 1;
            } else {
                field2 = field2 + ch;
            }
            m = m + 1;
        }
        if col < len(headers) { row[headers[col]] = field2; }
        array_push(rows, row);
        k = k + 1;
    }
    
    return rows;
}

/// Convert array of maps to CSV string
fn csv_stringify(rows, columns) {
    if len(rows) == 0 { return ""; }
    
    if columns == nil {
        columns = map_keys(rows[0]);
    }
    
    // Header
    let result = "";
    let c = 0;
    while c < len(columns) {
        if c > 0 { result = result + ","; }
        result = result + columns[c];
        c = c + 1;
    }
    result = result + "\n";
    
    // Rows
    let r = 0;
    while r < len(rows) {
        let c2 = 0;
        while c2 < len(columns) {
            if c2 > 0 { result = result + ","; }
            let val = rows[r][columns[c2]];
            if val == nil { val = ""; }
            result = result + str(val);
            c2 = c2 + 1;
        }
        result = result + "\n";
        r = r + 1;
    }
    
    return result;
}

/// Escape special XML characters
fn xml_escape(text) {
    let result = "";
    let i = 0;
    while i < len(text) {
        let ch = text[i..(i+1)];
        if ch == "&" { result = result + "&amp;"; }
        else { if ch == "<" { result = result + "&lt;"; }
        else { if ch == ">" { result = result + "&gt;"; }
        else { if ch == "\"" { result = result + "&quot;"; }
        else { if ch == "'" { result = result + "&apos;"; }
        else { result = result + ch; } } } } }
        i = i + 1;
    }
    return result;
}

/// Unescape XML entities
fn xml_unescape(text) {
    let result = text;
    result = str_replace(result, "&amp;", "&");
    result = str_replace(result, "&lt;", "<");
    result = str_replace(result, "&gt;", ">");
    result = str_replace(result, "&quot;", "\"");
    result = str_replace(result, "&apos;", "'");
    return result;
}

export json_pretty;
export json_validate;
export toml_parse;
export toml_stringify;
export yaml_parse;
export yaml_stringify;
export csv_parse;
export csv_stringify;
export xml_escape;
export xml_unescape;
