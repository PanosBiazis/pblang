// stdlib/functional.sapp — Functional programming utilities for pblang.
//
// Higher-order functions, combinators, and functional patterns.
// Patterned after Rust's Iterator, Haskell's Prelude, and lodash.
//
// Usage:
//   let f = import("stdlib:functional.sapp");
//   let doubled = f.map([1,2,3], fn(x) { return x * 2; });

// ── Map / Filter / Reduce ─────────────────────────────────────────────────────

fn map(arr, f) {
    let result = [];
    for x in arr { push(result, f(x)); }
    return result;
}

fn filter(arr, pred) {
    let result = [];
    for x in arr {
        if pred(x) { push(result, x); }
    }
    return result;
}

fn reduce(arr, f, initial) {
    let acc = initial;
    for x in arr { acc = f(acc, x); }
    return acc;
}

fn foldl(arr, f, initial) { return reduce(arr, f, initial); }

fn foldr(arr, f, initial) {
    let acc = initial;
    let i = len(arr) - 1;
    while i >= 0 {
        acc = f(arr[i], acc);
        i = i - 1;
    }
    return acc;
}

// ── Combinators ────────────────────────────────────────────────────────────────

fn compose(f, g) {
    return fn(x) { return f(g(x)); };
}

fn pipe(fns) {
    return fn(x) {
        let result = x;
        for f in fns { result = f(result); }
        return result;
    };
}

fn memoize(f) {
    let cache = map{};
    return fn(x) {
        let key = str(x);
        if map_has(cache, key) { return cache[key]; }
        let result = f(x);
        cache[key] = result;
        return result;
    };
}

fn once(f) {
    let called = false;
    let result = nil;
    return fn(x) {
        if not called {
            called = true;
            result = f(x);
        }
        return result;
    };
}

fn curry(f, arity) {
    if arity == nil { arity = 2; }
    fn curried(args) {
        if len(args) >= arity {
            return f_apply(f, args);
        }
        return fn(x) {
            let new_args = array_copy(args);
            push(new_args, x);
            return curried(new_args);
        };
    }
    return curried([]);
}

fn f_apply(f, args) {
    if len(args) == 0 { return f(); }
    if len(args) == 1 { return f(args[0]); }
    if len(args) == 2 { return f(args[0], args[1]); }
    if len(args) == 3 { return f(args[0], args[1], args[2]); }
    return f(args[0], args[1], args[2], args[3]);
}

// ── List operations ───────────────────────────────────────────────────────────

fn take(arr, n) {
    let result = [];
    let limit = n;
    if limit > len(arr) { limit = len(arr); }
    for i in 0 to limit - 1 { push(result, arr[i]); }
    return result;
}

fn drop(arr, n) {
    let result = [];
    for i in n to len(arr) - 1 { push(result, arr[i]); }
    return result;
}

fn take_while(arr, pred) {
    let result = [];
    for x in arr {
        if pred(x) { push(result, x); }
        else { break; }
    }
    return result;
}

fn drop_while(arr, pred) {
    let i = 0;
    while i < len(arr) and pred(arr[i]) { i = i + 1; }
    return drop(arr, i);
}

fn zip(a, b) {
    let result = [];
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i in 0 to n - 1 {
        push(result, [a[i], b[i]]);
    }
    return result;
}

fn enumerate(arr) {
    let result = [];
    for i in 0 to len(arr) - 1 {
        push(result, [i, arr[i]]);
    }
    return result;
}

fn flatten(arr) {
    let result = [];
    for x in arr {
        if type(x) == "array" {
            for y in flatten(x) { push(result, y); }
        } else {
            push(result, x);
        }
    }
    return result;
}

fn partition(arr, pred) {
    let yes = [];
    let no = [];
    for x in arr {
        if pred(x) { push(yes, x); }
        else { push(no, x); }
    }
    return [yes, no];
}

fn group_by(arr, keyfn) {
    let groups = map{};
    for x in arr {
        let key = str(keyfn(x));
        if not map_has(groups, key) {
            groups[key] = [];
        }
        push(groups[key], x);
    }
    return groups;
}

fn unique(arr) {
    let seen = map{};
    let result = [];
    for x in arr {
        let key = str(x);
        if not map_has(seen, key) {
            seen[key] = true;
            push(result, x);
        }
    }
    return result;
}

fn find(arr, pred) {
    for x in arr {
        if pred(x) { return x; }
    }
    return nil;
}

fn all(arr, pred) {
    for x in arr { if not pred(x) { return false; } }
    return true;
}

fn any(arr, pred) {
    for x in arr { if pred(x) { return true; } }
    return false;
}

fn none(arr, pred) {
    return not any(arr, pred);
}

fn count(arr, pred) {
    let n = 0;
    for x in arr { if pred(x) { n = n + 1; } }
    return n;
}

// ── Sort utilities ────────────────────────────────────────────────────────────

fn sort_by(arr, cmp) {
    let sorted = array_copy(arr);
    for i in 0 to len(sorted) - 1 {
        for j in 0 to len(sorted) - i - 2 {
            if cmp(sorted[j], sorted[j + 1]) > 0 {
                let t = sorted[j];
                sorted[j] = sorted[j + 1];
                sorted[j + 1] = t;
            }
        }
    }
    return sorted;
}

fn sort_asc(arr) {
    return sort_by(arr, fn(a, b) {
        if a < b { return -1; }
        if a > b { return 1; }
        return 0;
    });
}

fn sort_desc(arr) {
    return sort_by(arr, fn(a, b) {
        if a > b { return -1; }
        if a < b { return 1; }
        return 0;
    });
}

// ── Point-free combinators ──────────────────────────────────────────────────────

fn identity(x) { return x; }                       // id : a -> a
fn constant(x) { return fn(ignored) { return x; }; } // const : a -> b -> a
fn flip(f) { return fn(a, b) { return f(b, a); }; }  // flip a 2-ary function's args
fn complement(pred) { return fn(x) { return not pred(x); }; } // negate a predicate

// partial(f, a) — bind the first argument, returning a 1- or 2-ary function.
fn partial(f, a) { return fn(b) { return f(a, b); }; }
fn partial2(f, a, b) { return fn(c) { return f(a, b, c); }; }

// tap(x, f) — run a side effect on x, return x unchanged (for pipelines/debug).
fn tap(x, f) { f(x); return x; }

// thread(x, fns) — thread a value left-to-right through fns (a.k.a. pipe applied now).
fn thread(x, fns) {
    let result = x;
    for f in fns { result = f(result); }
    return result;
}

// ── Mapping / expansion ──────────────────────────────────────────────────────────

// flat_map(arr, f) — map then flatten one level (f returns an array per element).
fn flat_map(arr, f) {
    let result = [];
    for x in arr {
        let ys = f(x);
        for y in ys { push(result, y); }
    }
    return result;
}

// zip_with(a, b, f) — combine two arrays elementwise with f.
fn zip_with(a, b, f) {
    let n = len(a);
    if len(b) < n { n = len(b); }
    let result = [];
    for i in 0 to n - 1 { push(result, f(a[i], b[i])); }
    return result;
}

// scan(arr, f, initial) — like reduce but collects every intermediate accumulator.
fn scan(arr, f, initial) {
    let acc = initial;
    let result = [initial];
    for x in arr { acc = f(acc, x); push(result, acc); }
    return result;
}

// ── Generators ───────────────────────────────────────────────────────────────────

// repeat(x, n) — array of n copies of x.
fn repeat(x, n) {
    let result = [];
    let i = 0;
    while i < n { push(result, x); i = i + 1; }
    return result;
}

// iterate(f, seed, n) — [seed, f(seed), f(f(seed)), ...] of length n.
fn iterate(f, seed, n) {
    let result = [];
    let cur = seed;
    let i = 0;
    while i < n { push(result, cur); cur = f(cur); i = i + 1; }
    return result;
}

// ── Windowing ────────────────────────────────────────────────────────────────────

// chunk(arr, size) — split into consecutive sub-arrays of at most `size`.
fn chunk(arr, size) {
    let result = [];
    let cur = [];
    for x in arr {
        push(cur, x);
        if len(cur) >= size { push(result, cur); cur = []; }
    }
    if len(cur) > 0 { push(result, cur); }
    return result;
}

// windows(arr, size) — all contiguous sub-arrays of exactly `size` (sliding).
fn windows(arr, size) {
    let result = [];
    let n = len(arr);
    if size <= 0 or size > n { return result; }
    for start in 0 to n - size {
        let w = [];
        for j in 0 to size - 1 { push(w, arr[start + j]); }
        push(result, w);
    }
    return result;
}

// ── Aggregation ──────────────────────────────────────────────────────────────────

fn sum(arr) { let s = 0; for x in arr { s = s + x; } return s; }
fn product(arr) { let p = 1; for x in arr { p = p * x; } return p; }
fn mean(arr) { if len(arr) == 0 { return 0; } return sum(arr) / len(arr); }

// max_by / min_by — element maximising / minimising key(x). nil for empty input.
fn max_by(arr, key) {
    if len(arr) == 0 { return nil; }
    let best = arr[0];
    let best_k = key(best);
    for x in arr { let k = key(x); if k > best_k { best = x; best_k = k; } }
    return best;
}
fn min_by(arr, key) {
    if len(arr) == 0 { return nil; }
    let best = arr[0];
    let best_k = key(best);
    for x in arr { let k = key(x); if k < best_k { best = x; best_k = k; } }
    return best;
}

// frequencies(arr) — map of value -> occurrence count (values must be string keys).
fn frequencies(arr) {
    let counts = map{};
    for x in arr {
        let k = str(x);
        if map_has(counts, k) { counts[k] = counts[k] + 1; } else { counts[k] = 1; }
    }
    return counts;
}

// ── Declarative control combinators ──────────────────────────────────────────────

// cond(pairs, x) — pairs is an array of [predicate, transform]; returns transform(x)
// for the first predicate that holds, else nil. A functional switch/case.
fn cond(pairs, x) {
    for pair in pairs {
        let pred = pair[0];
        if pred(x) { let f = pair[1]; return f(x); }
    }
    return nil;
}

// when_fn(pred, f) — returns g(x) = f(x) if pred(x) else x (identity otherwise).
fn when_fn(pred, f) { return fn(x) { if pred(x) { return f(x); } return x; }; }
fn unless_fn(pred, f) { return fn(x) { if pred(x) { return x; } return f(x); }; }

// juxt(fns) — apply several functions to one input, collecting results in an array.
fn juxt(fns) {
    return fn(x) {
        let out = [];
        for f in fns { push(out, f(x)); }
        return out;
    };
}

export map, filter, reduce, foldl, foldr;
export compose, pipe, memoize, once, curry;
export take, drop, take_while, drop_while, zip, enumerate, flatten;
export partition, group_by, unique, find, all, any, none, count;
export sort_by, sort_asc, sort_desc;
export identity, constant, flip, complement, partial, partial2, tap, thread;
export flat_map, zip_with, scan, repeat, iterate, chunk, windows;
export sum, product, mean, max_by, min_by, frequencies;
export cond, when_fn, unless_fn, juxt;
