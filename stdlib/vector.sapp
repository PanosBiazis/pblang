// stdlib/vector.sapp — n-dimensional numeric vectors, represented as plain
// arrays of numbers. Pure pblang; pairs with matrix.sapp.
//
//   let vec = import("stdlib:vector.sapp");
//   vec.norm([3, 4])              // 5
//   vec.dot([1,2,3], [4,5,6])     // 32
//   vec.cross([1,0,0], [0,1,0])   // [0, 0, 1]

fn _check(a, b) {
    if len(a) != len(b) { return error("vector: dimension mismatch"); }
    return true;
}

fn zeros(n) { let v = []; for i in 0 to n - 1 { array_push(v, 0); } return v; }
fn fill(n, x) { let v = []; for i in 0 to n - 1 { array_push(v, x); } return v; }
fn dim(v) { return len(v); }

fn add(a, b) {
    let _ = _check(a, b);
    let r = [];
    for i in 0 to len(a) - 1 { array_push(r, a[i] + b[i]); }
    return r;
}
fn sub(a, b) {
    let _ = _check(a, b);
    let r = [];
    for i in 0 to len(a) - 1 { array_push(r, a[i] - b[i]); }
    return r;
}
fn neg(a) {
    let r = [];
    for x in a { array_push(r, 0 - x); }
    return r;
}
fn scale(a, k) {
    let r = [];
    for x in a { array_push(r, x * k); }
    return r;
}
// Element-wise (Hadamard) product.
fn hadamard(a, b) {
    let _ = _check(a, b);
    let r = [];
    for i in 0 to len(a) - 1 { array_push(r, a[i] * b[i]); }
    return r;
}

fn dot(a, b) {
    let _ = _check(a, b);
    let s = 0;
    for i in 0 to len(a) - 1 { s = s + a[i] * b[i]; }
    return s;
}

// 3D cross product.
fn cross(a, b) {
    if len(a) != 3 or len(b) != 3 { return error("vector: cross requires 3D"); }
    return [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ];
}

fn norm_sq(a) { return dot(a, a); }
fn norm(a) { return num_sqrt(norm_sq(a)); }
fn l1_norm(a) { let s = 0; for x in a { s = s + num_abs(x); } return s; }
fn linf_norm(a) {
    let m = 0;
    for x in a { let ax = num_abs(x); if ax > m { m = ax; } }
    return m;
}

fn normalize(a) {
    let n = norm(a);
    if n == 0 { return error("vector: cannot normalize zero vector"); }
    return scale(a, 1.0 / n);
}

fn distance(a, b) { return norm(sub(a, b)); }
fn distance_sq(a, b) { return norm_sq(sub(a, b)); }

// Linear interpolation between vectors a and b at parameter t in [0,1].
fn lerp(a, b, t) { return add(scale(a, 1.0 - t), scale(b, t)); }

// cosine of the angle between a and b (dot / (|a||b|)).
fn cos_angle(a, b) {
    let d = norm(a) * norm(b);
    if d == 0 { return error("vector: angle with zero vector"); }
    return dot(a, b) / d;
}

// projection of a onto b.
fn project(a, b) {
    let bb = dot(b, b);
    if bb == 0 { return error("vector: project onto zero vector"); }
    return scale(b, dot(a, b) / bb);
}

fn sum(a) { let s = 0; for x in a { s = s + x; } return s; }
fn mean(a) { if len(a) == 0 { return 0; } return sum(a) / len(a); }

fn equals(a, b) {
    if len(a) != len(b) { return false; }
    for i in 0 to len(a) - 1 { if a[i] != b[i] { return false; } }
    return true;
}

fn to_string(a) {
    let s = "[";
    for i in 0 to len(a) - 1 {
        if i > 0 { s = s + ", "; }
        s = s + str(a[i]);
    }
    return s + "]";
}

export zeros, fill, dim, add, sub, neg, scale, hadamard, dot, cross,
       norm_sq, norm, l1_norm, linf_norm, normalize, distance, distance_sq,
       lerp, cos_angle, project, sum, mean, equals, to_string;
