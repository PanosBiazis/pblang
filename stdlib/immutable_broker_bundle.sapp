// Bounded, lock-verified, in-memory source closure for a future fixed broker.
//
// The result is data, not execution authority. PBLang cannot yet hand the
// source closure and runtime to a child as one immutable descriptor-bound unit.

let LINK = import("stdlib:source_inliner.sapp");
let FORMAT = "pblang.immutable-broker-bundle.v1";

fn _digest(value) {
    return type(value) == "string" and regex_match(value, "^[0-9a-f]{64}$");
}

fn build(entry_path, project_root = ".", options = nil) {
    let linked = LINK.inline_project_file_prefixed(entry_path, project_root, options);
    if not linked.ok {
        return map{ ok: false, format: FORMAT,
            error: "immutable closure link failed: " + str(try linked.reason catch "unknown") };
    }
    if not (try linked.lock_verified catch false)
        or not (try linked.immutable_snapshot catch false)
        or not (try linked.descriptor_confined_snapshot catch false)
        or not (try linked.content_hash_algorithm_verified catch false)
        or (try linked.content_hash_algorithm catch "") != "pblang-package-tree-v2"
        or not _digest(try linked.manifest_sha256 catch "")
        or not _digest(try linked.input_graph_sha256 catch "")
        or type(try linked.dependency_digests catch nil) != "map"
        or type(try linked.source catch nil) != "string" {
        return map{ ok: false, format: FORMAT, error: "incomplete immutable closure evidence" };
    }
    let dependency_names = array_sort(map_keys(linked.dependency_digests));
    let identity = [FORMAT, linked.entry_path, linked.manifest_sha256,
        linked.input_graph_sha256, sha256(linked.source), str(linked.output_bytes),
        str(linked.reachable_modules)];
    for name in dependency_names {
        let digest = linked.dependency_digests[name];
        if type(name) != "string" or not regex_match(name, "^[A-Za-z][A-Za-z0-9_-]*$")
            or not _digest(digest) {
            return map{ ok: false, format: FORMAT, error: "invalid dependency closure evidence" };
        }
        array_push(identity, name); array_push(identity, digest);
    }
    let source_sha256 = sha256(linked.source);
    return map{ ok: true, format: FORMAT, entry_path: linked.entry_path,
        source: linked.source, source_sha256: source_sha256,
        closure_sha256: sha256(str_join(identity, strfromcharcode(0))),
        manifest_sha256: linked.manifest_sha256,
        input_graph_sha256: linked.input_graph_sha256,
        dependency_digests: linked.dependency_digests,
        dependency_count: len(dependency_names),
        reachable_modules: linked.reachable_modules,
        available_modules: linked.available_modules,
        input_bytes: linked.input_bytes, output_bytes: linked.output_bytes,
        lock_verified: true, immutable_snapshot: true,
        descriptor_confined_snapshot: linked.descriptor_confined_snapshot,
        content_hash_algorithm: linked.content_hash_algorithm,
        content_hash_algorithm_verified: linked.content_hash_algorithm_verified,
        in_memory_only: true,
        executable: false, executed: false, effects_applied: false,
        immutable_runtime_handoff_verified: false,
        runtime_identity_verified: false,
        production_execution_ready: false };
}

fn status() {
    return map{ format: "pblang.immutable-broker-bundle.status.v1",
        lock_verified_snapshot_supported: platform() == "linux",
        bounded_in_memory_link_supported: platform() == "linux",
        immutable_runtime_handoff_verified: false,
        runtime_identity_verified: false,
        pathname_publication_allowed: false,
        production_execution_ready: false };
}

export FORMAT, build, status;
