// Four-block portable snapshot reader, shared by excerpts and sections.
let D=import("stdlib:text_document.sapp");
let UI=import("stdlib:modern_ui.sapp");
fn view(doc,page=0,label="PBExcerpt"){D.validate(doc);if type(page)!="number" or page<0 or page!=num_floor(page) or page>=num_ceil(len(doc.blocks)/4){throw "invalid excerpt page";}let children=[UI.heading(label),UI.text(doc.title+" | page "+str(page+1)+" / "+str(num_ceil(len(doc.blocks)/4)))];for i in range(page*4,num_min(page*4+4,len(doc.blocks))){let name="block_"+str(i);array_push(children,UI.text("Block "+str(i+1)+" | "+doc.blocks[i].kind));array_push(children,UI.area(doc.blocks[i].text,map{name:name,readonly:true,enabled:false,h:90}));array_push(children,UI.row([UI.button("Show",UI.action_set_text(name,doc.blocks[i].text)),UI.button("Hide",UI.action_set_text(name,"Text hidden."))]));}array_push(children,UI.text("Snapshot reader. Edit the exported document in Writer."));return UI.screen(children);}
export view;
