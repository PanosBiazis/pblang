// stdlib/tool_probe.sapp -- non-executing discovery for trusted system tools.
//
// Some daemon binaries (notably ydotoold) start their service when passed
// `--help`; a blocking proc_spawn_wait then holds the caller forever. Discovery
// therefore uses filesystem metadata only. Version/help execution is explicitly
// unavailable until the runtime has a pre-emptive process deadline and kill API.

let _TRUSTED_DIRS = ["/usr/bin", "/bin", "/usr/sbin", "/sbin"];
let _DAEMONS = [
    "ydotoold", "sshd", "dockerd", "containerd", "systemd", "dbus-daemon",
    "Xorg", "wayland", "weston", "nginx", "apache2", "httpd", "redis-server",
    "postgres", "mysqld"
];

fn _valid_name(name) {
    if not is_string(name) or len(name) == 0 or len(name) > 128 { return false; }
    if str_contains(name, "/") or str_contains(name, "\\") or str_contains(name, "\x00") { return false; }
    let i = 0;
    while i < len(name) {
        let c = strcharcodeat(name, i);
        let ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or
                 (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 95;
        if not ok { return false; }
        i = i + 1;
    }
    return true;
}

fn kind(name) {
    let i = 0; while i < len(_DAEMONS) { if name == _DAEMONS[i] { return "daemon"; } i = i + 1; }
    return "command";
}

fn trusted_path(name) {
    if not _valid_name(name) { return nil; }
    let i = 0;
    while i < len(_TRUSTED_DIRS) {
        let p = _TRUSTED_DIRS[i] + "/" + name;
        if try fs_exists(p) catch false { return p; }
        i = i + 1;
    }
    return nil;
}

fn describe(name) {
    let valid = _valid_name(name); let p = if valid { trusted_path(name) } else { nil };
    let k = if valid { kind(name) } else { "invalid" };
    let reason = "metadata-only discovery; runtime process timeout/kill is required before execution probing";
    if not valid { reason = "invalid tool name"; }
    elif k == "daemon" { reason = "daemon discovery is metadata-only; help/version execution is unsafe"; }
    return map{
        format: "pblang.tool-probe.v1", name: name, valid: valid,
        installed: p != nil, path: p, kind: k, executed: false,
        version_available: false,
        reason: reason
    };
}

fn version_probe(name) {
    let d = describe(name);
    return map{
        ok: false, skipped: true, name: name, installed: d.installed, path: d.path,
        kind: d.kind, executed: false, error: d.reason
    };
}

fn trusted_dirs() { return slice(_TRUSTED_DIRS, 0, len(_TRUSTED_DIRS)); }

export kind, trusted_path, describe, version_probe, trusted_dirs;
