// stdlib/di.sapp — Dependency Injection container for pblang.
//
// Provides: service registration, resolution, singleton/transient lifecycles,
// interface contracts, and auto-wiring.
//
// Usage:
//   let di = import("stdlib:di.sapp");
//   let container = di.create();
//   di.singleton(container, "db", fn() { return db_connect(); });
//   di.transient(container, "logger", fn() { return new_logger(); });
//   let db = di.resolve(container, "db");

fn create() {
    return map{
        _services: map{},
        _singletons: map{},
        _factories: map{}
    };
}

fn singleton(container, name, factory_fn) {
    container._services[name] = map{ lifecycle: "singleton", factory: factory_fn };
    return container;
}

fn transient(container, name, factory_fn) {
    container._services[name] = map{ lifecycle: "transient", factory: factory_fn };
    return container;
}

fn value(container, name, val) {
    container._singletons[name] = val;
    container._services[name] = map{ lifecycle: "value" };
    return container;
}

fn resolve(container, name) {
    let svc = try container._services[name] catch nil;
    if svc == nil { return error("di.resolve: service '" + name + "' not registered"); }
    if svc.lifecycle == "value" {
        return container._singletons[name];
    }
    if svc.lifecycle == "singleton" {
        let cached = try container._singletons[name] catch nil;
        if cached != nil { return cached; }
        let instance = svc.factory();
        container._singletons[name] = instance;
        return instance;
    }
    // transient — always create new
    return svc.factory();
}

fn has(container, name) {
    return map_has(container._services, name);
}

fn list_services(container) {
    return map_keys(container._services);
}

fn reset(container) {
    container._singletons = map{};
    return container;
}

// unregister(container, name) — remove a service and any cached singleton/value.
fn unregister(container, name) {
    if map_has(container._services, name) { map_remove(container._services, name); }
    if map_has(container._singletons, name) { map_remove(container._singletons, name); }
    return container;
}

// count(container) — number of registered services.
fn count(container) { return len(map_keys(container._services)); }

export create, singleton, transient, value, resolve, has, list_services, reset;
export unregister, count;
