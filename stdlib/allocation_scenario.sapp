// Compare the same weighted rows at two totals, without assuming monotonicity.
let Allocation=import("stdlib:allocation_table.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn compare(doc,before_total,after_total) {
 let before=Allocation.from_sheet(doc,before_total);let after=Allocation.from_sheet(doc,after_total);
 let cells=[["Label","Weight","Before ("+str(before_total)+")","After ("+str(after_total)+")","Change"]];
 let increased=0;let decreased=0;let unchanged=0;
 for i in range(1,len(before.document.cells)) {
  let a=before.document.cells[i];let b=after.document.cells[i];let change=parse_number(b[2])-parse_number(a[2]);
  if change>0{increased=increased+1;} elif change<0{decreased=decreased+1;} else {unchanged=unchanged+1;}
  array_push(cells,[a[0],a[1],a[2],b[2],str(change)]);
 }
 let document=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(document);
 return map{format:"pblang.allocation-scenario.v1",document:document,before_total:before_total,total:after_total,change:after_total-before_total,rows:before.rows,increased:increased,decreased:decreased,unchanged:unchanged,method:before.method};
}
export compare;
