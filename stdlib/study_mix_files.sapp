let Store=import("stdlib:study_files.sapp");let Mix=import("stdlib:study_mix.sapp");
fn open(path,count,seed){let loaded=Store.open_deck(path);if not loaded.ok{return loaded;}let r=try Mix.create(loaded.deck,count,seed) catch nil;if r==nil{return map{ok:false,error:"Invalid count, seed or deck. Source unchanged."};}return map{ok:true,report:r};}
fn run(path,count_text,seed_text,output){let count=try Mix.parse_count(count_text) catch nil;let seed=try Mix.parse_seed(seed_text) catch nil;if count==nil or seed==nil{return map{ok:false,error:"Use count 1..64 and seed 0..4294967295 in decimal digits."};}let r=open(path,count,seed);if not r.ok{return r;}let saved=Store.save_copy(output,r.report.deck);if saved.ok{saved.summary=Mix.summary(r.report);}return saved;}
export open,run;
