// stdlib/quantum_sim.sapp
// Pure-pblang single/2-qubit state-vector simulator.
// State: array of [re, im] amplitude pairs, length = 2^n_qubits.
// No VM core changes beyond random_float (builtin).

fn _complex_add(a, b) {
    return [a[0] + b[0], a[1] + b[1]];
}
fn _complex_sub(a, b) {
    return [a[0] - b[0], a[1] - b[1]];
}
fn _complex_scale(a, s) {
    return [a[0] * s, a[1] * s];
}
fn _prob(amp) {
    return amp[0] * amp[0] + amp[1] * amp[1];
}

fn zero_state(n_qubits) {
    let size = 1;
    let q = 0;
    while q < n_qubits {
        size = size * 2;
        q = q + 1;
    }
    let state = [];
    let i = 0;
    while i < size {
        if i == 0 {
            array_push(state, [1.0, 0.0]);
        } else {
            array_push(state, [0.0, 0.0]);
        }
        i = i + 1;
    }
    return state;
}

fn _mask(q) {
    return num_pow(2, q);
}
fn _bit_of(i, q) {
    let m = _mask(q);
    return num_mod(num_floor(i / m), 2);
}

fn h_gate(state, q) {
    let s = 0.7071067811865476;
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 0 {
            let m = _mask(q);
            let j = i + m;
            let a = state[i];
            let b = state[j];
            new_state[i] = _complex_scale(_complex_add(a, b), s);
            new_state[j] = _complex_scale(_complex_sub(a, b), s);
        }
        i = i + 1;
    }
    return new_state;
}

fn x_gate(state, q) {
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 0 {
            let m = _mask(q);
            let j = i + m;
            new_state[i] = state[j];
            new_state[j] = state[i];
        }
        i = i + 1;
    }
    return new_state;
}

fn cnot_gate(state, c, t) {
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, c) == 1 and _bit_of(i, t) == 0 {
            let m = _mask(t);
            let j = i + m;
            new_state[i] = state[j];
            new_state[j] = state[i];
        }
        i = i + 1;
    }
    return new_state;
}

fn measure(state, q) {
    let size = len(state);
    let prob1 = 0.0;
    let i = 0;
    while i < size {
        if _bit_of(i, q) == 1 {
            prob1 = prob1 + _prob(state[i]);
        }
        i = i + 1;
    }
    let r = random_float();
    let outcome = 0;
    if r < prob1 {
        outcome = 1;
    }
    let norm = 0.0;
    let j = 0;
    while j < size {
        if _bit_of(j, q) != outcome {
            state[j] = [0.0, 0.0];
        } else {
            norm = norm + _prob(state[j]);
        }
        j = j + 1;
    }
    let norm_factor = num_sqrt(norm);
    // Guard against division by zero (would propagate NaN through the state).
    if norm_factor == 0 { return outcome; }
    let k = 0;
    while k < size {
        state[k] = _complex_scale(state[k], 1.0 / norm_factor);
        k = k + 1;
    }
    return outcome;
}

// 3-qubit repetition code helpers (Q3-gamma)
// repetition_encode(bit) -> [bit, bit, bit]
fn repetition_encode(bit) {
    return [bit, bit, bit];
}

// repetition_decode(bits) -> corrected_bit via majority vote
fn repetition_decode(bits) {
    let i = 0;
    let ones = 0;
    while i < len(bits) {
        if bits[i] == 1 {
            ones = ones + 1;
        }
        i = i + 1;
    }
    if ones >= 2 {
        return 1;
    }
    return 0;
}

fn y_gate(state, q) {
    // Pauli-Y exactly: [a,b] -> [-i*b, i*a]. Relative phase matters when
    // this gate is composed with H, S, T, or controlled operations.
    let out = _clone_state(state);
    let size = len(state);
    let i = 0;
    while i < size {
        if _bit_of(i, q) == 0 {
            let j = i + _mask(q);
            let a = state[i];
            let b = state[j];
            out[i] = [b[1], 0.0 - b[0]];
            out[j] = [0.0 - a[1], a[0]];
        }
        i = i + 1;
    }
    return out;
}

fn z_gate(state, q) {
    // Apply Z gate: [[1, 0], [0, -1]]
    // Phase flip on |1⟩ component
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 1 {
            // Multiply by -1 (phase flip)
            new_state[i] = [0.0 - state[i][0], 0.0 - state[i][1]];
        }
        i = i + 1;
    }
    return new_state;
}

fn add_depolarizing_noise(circ, p) {
    // Add depolarizing noise to a circuit.
    // After each gate, with probability p, insert a random error gate (X, Y, or Z).
    // circ: array of gate operations, each is map{"gate": "h"/"x"/"y"/"z"/"cnot", "q": qubit, ...}
    // p: probability of error (0.0 to 1.0)
    // Returns: new circuit with potential error gates inserted
    let noisy_circ = [];
    let i = 0;
    while i < len(circ) {
        // Add the original gate
        array_push(noisy_circ, circ[i]);

        // With probability p, add a random error gate
        let r = random_float();
        if r < p {
            // Choose random error: X (0), Y (1), or Z (2)
            let error_choice = num_floor(random_float() * 3.0);
            let error_gate = "x";
            if error_choice == 1.0 {
                error_gate = "y";
            }
            if error_choice == 2.0 {
                error_gate = "z";
            }

            // Create error gate operation on the same qubit. Multi-qubit gates
            // (cx/cnot/swap) have no single "q" key — guard against a throw and
            // skip inserting single-qubit noise for them.
            let original_gate = circ[i];
            let tq = try original_gate["q"] catch nil;
            if tq != nil {
                let error_op = map{ "gate": error_gate, "q": tq };
                array_push(noisy_circ, error_op);
            }
        }
        i = i + 1;
    }
    return noisy_circ;
}

// _clone_state(state) — fresh copy of the amplitude array.
fn _clone_state(state) {
    let ns = [];
    let i = 0;
    while i < len(state) { array_push(ns, [state[i][0], state[i][1]]); i = i + 1; }
    return ns;
}

// s_gate(state, q) — phase gate S: |1> amplitude *= i  ([re,im] -> [-im,re]).
fn s_gate(state, q) {
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, q) == 1 { ns[i] = [0 - state[i][1], state[i][0]]; }
        i = i + 1;
    }
    return ns;
}

// t_gate(state, q) — phase gate T: |1> amplitude *= e^(iπ/4) = (√2/2)(1+i).
fn t_gate(state, q) {
    let s = 0.7071067811865476;
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, q) == 1 {
            let re = state[i][0];
            let im = state[i][1];
            ns[i] = [(re - im) * s, (re + im) * s];
        }
        i = i + 1;
    }
    return ns;
}

let _QS_PI = 3.141592653589793;
fn _qs_reduce(x) {
    let t = x;
    while t > _QS_PI { t = t - 2 * _QS_PI; }
    while t < (0 - _QS_PI) { t = t + 2 * _QS_PI; }
    return t;
}
fn _qs_sin(x) {
    let t = _qs_reduce(x);
    let term = t; let sum = t; let n = 1;
    while n <= 12 { term = term * (0 - t * t) / ((2 * n) * (2 * n + 1)); sum = sum + term; n = n + 1; }
    return sum;
}
fn _qs_cos(x) {
    let t = _qs_reduce(x);
    let term = 1; let sum = 1; let n = 1;
    while n <= 12 { term = term * (0 - t * t) / ((2 * n - 1) * (2 * n)); sum = sum + term; n = n + 1; }
    return sum;
}

// phase_gate(state, q, theta) — |1> amplitude *= e^(iθ) (S = phase(π/2), T = phase(π/4)).
fn phase_gate(state, q, theta) {
    let c = _qs_cos(theta);
    let sn = _qs_sin(theta);
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, q) == 1 {
            let re = state[i][0];
            let im = state[i][1];
            ns[i] = [re * c - im * sn, re * sn + im * c];
        }
        i = i + 1;
    }
    return ns;
}

// swap_gate(state, a, b) — exchange qubits a and b.
fn swap_gate(state, a, b) {
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, a) == 1 and _bit_of(i, b) == 0 {
            let j = i - _mask(a) + _mask(b);
            ns[i] = state[j];
            ns[j] = state[i];
        }
        i = i + 1;
    }
    return ns;
}

// probabilities(state) — array of measurement probabilities per basis state.
fn probabilities(state) {
    let out = [];
    let i = 0;
    while i < len(state) { array_push(out, _prob(state[i])); i = i + 1; }
    return out;
}

// expectation_z(state, q) — <Z> on qubit q = P(q=0) - P(q=1), in [-1, 1].
fn expectation_z(state, q) {
    let p0 = 0;
    let p1 = 0;
    let i = 0;
    while i < len(state) {
        if _bit_of(i, q) == 0 { p0 = p0 + _prob(state[i]); }
        else { p1 = p1 + _prob(state[i]); }
        i = i + 1;
    }
    return p0 - p1;
}

fn histogram(outcomes) {
    // Build a simple frequency map of measurement outcomes.
    // Keys are stringified outcomes ("0", "1", "2", ...), values are counts.
    let counts = map{};
    let i = 0;
    while i < len(outcomes) {
        let k = str(outcomes[i]);
        if map_has(counts, k) {
            counts[k] = counts[k] + 1;
        } else {
            counts[k] = 1;
        }
        i = i + 1;
    }
    return counts;
}

// ── enrichment: more gates, analysis, sampling ───────────────────────────────────

// cz_gate(state, a, b) — controlled-Z: flip the phase when both qubits are |1>.
fn cz_gate(state, a, b) {
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, a) == 1 and _bit_of(i, b) == 1 {
            ns[i] = [0 - state[i][0], 0 - state[i][1]];
        }
        i = i + 1;
    }
    return ns;
}

// state_norm(state) — total probability (should be ~1 for a valid state).
fn state_norm(state) {
    let s = 0;
    let i = 0;
    while i < len(state) { s = s + _prob(state[i]); i = i + 1; }
    return s;
}

// normalize(state) — rescale amplitudes to unit norm (returns a new state;
// an all-zero state is returned unchanged).
fn normalize(state) {
    let nf = num_sqrt(state_norm(state));
    let ns = _clone_state(state);
    if nf == 0 { return ns; }
    let i = 0;
    while i < len(ns) { ns[i] = _complex_scale(ns[i], 1.0 / nf); i = i + 1; }
    return ns;
}

// most_likely(state) — index of the basis state with the highest probability.
fn most_likely(state) {
    let best = 0;
    let bestp = 0 - 1;
    let i = 0;
    while i < len(state) {
        let p = _prob(state[i]);
        if p > bestp { bestp = p; best = i; }
        i = i + 1;
    }
    return best;
}

// sample(state) — sample a basis-state index from the probability distribution
// WITHOUT collapsing the state (unlike measure).
fn sample(state) {
    let r = random_float();
    let acc = 0;
    let i = 0;
    while i < len(state) {
        acc = acc + _prob(state[i]);
        if r < acc { return i; }
        i = i + 1;
    }
    return len(state) - 1;
}

// shannon_entropy(state) — entropy of the measurement distribution, in bits.
fn shannon_entropy(state) {
    let ln2 = num_ln(2);
    let h = 0;
    let i = 0;
    while i < len(state) {
        let p = _prob(state[i]);
        if p > 0 { h = h - p * (num_ln(p) / ln2); }
        i = i + 1;
    }
    return h;
}

// ── wave 2: multi-qubit gates + state algebra ────────────────────────────────────

// toffoli_gate(state, c1, c2, t) — CCX: flip target t iff both controls are |1>.
fn toffoli_gate(state, c1, c2, t) {
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, c1) == 1 and _bit_of(i, c2) == 1 and _bit_of(i, t) == 0 {
            let j = i + _mask(t);
            ns[i] = state[j];
            ns[j] = state[i];
        }
        i = i + 1;
    }
    return ns;
}

// controlled_phase(state, c, t, theta) — apply e^{i theta} to |...1...1...> (both set).
fn controlled_phase(state, c, t, theta) {
    let co = _qs_cos(theta);
    let sn = _qs_sin(theta);
    let ns = _clone_state(state);
    let i = 0;
    while i < len(state) {
        if _bit_of(i, c) == 1 and _bit_of(i, t) == 1 {
            let re = state[i][0];
            let im = state[i][1];
            ns[i] = [re * co - im * sn, re * sn + im * co];
        }
        i = i + 1;
    }
    return ns;
}

// bell_state() — the 2-qubit Bell pair (|00> + |11>)/sqrt(2).
fn bell_state() {
    let s = zero_state(2);
    s = h_gate(s, 0);
    s = cnot_gate(s, 0, 1);
    return s;
}

// fidelity(a, b) — |<a|b>|^2 between two pure states of equal size (in [0,1]).
fn fidelity(a, b) {
    let re = 0;
    let im = 0;
    let i = 0;
    while i < len(a) {
        let ar = a[i][0]; let ai = a[i][1];
        let br = b[i][0]; let bi = b[i][1];
        re = re + (ar * br + ai * bi);   // Re(conj(a)*b)
        im = im + (ar * bi - ai * br);   // Im(conj(a)*b)
        i = i + 1;
    }
    return re * re + im * im;
}

// tensor(a, b) — Kronecker product of two state vectors (combine subsystems).
fn tensor(a, b) {
    let out = [];
    let i = 0;
    while i < len(a) {
        let j = 0;
        while j < len(b) {
            let ar = a[i][0]; let ai = a[i][1];
            let br = b[j][0]; let bi = b[j][1];
            array_push(out, [ar * br - ai * bi, ar * bi + ai * br]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

export zero_state, h_gate, x_gate, y_gate, z_gate, cnot_gate, measure, repetition_encode, repetition_decode, histogram, add_depolarizing_noise,
       s_gate, t_gate, phase_gate, swap_gate, probabilities, expectation_z,
       cz_gate, state_norm, normalize, most_likely, sample, shannon_entropy,
       toffoli_gate, controlled_phase, bell_state, fidelity, tensor;
