// stdlib/quantum_sim.sapp
// Pure-Sapphire single/2-qubit state-vector simulator.
// State: array of [re, im] amplitude pairs, length = 2^n_qubits.
// No VM core changes beyond random_float (builtin).

fn _complex_add(a, b) {
    return [a[0] + b[0], a[1] + b[1]];
}
fn _complex_sub(a, b) {
    return [a[0] - b[0], a[1] - b[1]];
}
fn _complex_scale(a, s) {
    return [a[0] * s, a[1] * s];
}
fn _prob(amp) {
    return amp[0] * amp[0] + amp[1] * amp[1];
}

fn zero_state(n_qubits) {
    let size = 1;
    let q = 0;
    while q < n_qubits {
        size = size * 2;
        q = q + 1;
    }
    let state = [];
    let i = 0;
    while i < size {
        if i == 0 {
            array_push(state, [1.0, 0.0]);
        } else {
            array_push(state, [0.0, 0.0]);
        }
        i = i + 1;
    }
    return state;
}

fn _mask(q) {
    return num_pow(2, q);
}
fn _bit_of(i, q) {
    let m = _mask(q);
    return num_mod(num_floor(i / m), 2);
}

fn h_gate(state, q) {
    let s = 0.7071067811865476;
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 0 {
            let m = _mask(q);
            let j = i + m;
            let a = state[i];
            let b = state[j];
            new_state[i] = _complex_scale(_complex_add(a, b), s);
            new_state[j] = _complex_scale(_complex_sub(a, b), s);
        }
        i = i + 1;
    }
    return new_state;
}

fn x_gate(state, q) {
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 0 {
            let m = _mask(q);
            let j = i + m;
            new_state[i] = state[j];
            new_state[j] = state[i];
        }
        i = i + 1;
    }
    return new_state;
}

fn cnot_gate(state, c, t) {
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, c) == 1 and _bit_of(i, t) == 0 {
            let m = _mask(t);
            let j = i + m;
            new_state[i] = state[j];
            new_state[j] = state[i];
        }
        i = i + 1;
    }
    return new_state;
}

fn measure(state, q) {
    let size = len(state);
    let prob1 = 0.0;
    let i = 0;
    while i < size {
        if _bit_of(i, q) == 1 {
            prob1 = prob1 + _prob(state[i]);
        }
        i = i + 1;
    }
    let r = random_float();
    let outcome = 0;
    if r < prob1 {
        outcome = 1;
    }
    let norm = 0.0;
    let j = 0;
    while j < size {
        if _bit_of(j, q) != outcome {
            state[j] = [0.0, 0.0];
        } else {
            norm = norm + _prob(state[j]);
        }
        j = j + 1;
    }
    let norm_factor = num_sqrt(norm);
    let k = 0;
    while k < size {
        state[k] = _complex_scale(state[k], 1.0 / norm_factor);
        k = k + 1;
    }
    return outcome;
}

// 3-qubit repetition code helpers (Q3-gamma)
// repetition_encode(bit) -> [bit, bit, bit]
fn repetition_encode(bit) {
    return [bit, bit, bit];
}

// repetition_decode(bits) -> corrected_bit via majority vote
fn repetition_decode(bits) {
    let i = 0;
    let ones = 0;
    while i < len(bits) {
        if bits[i] == 1 {
            ones = ones + 1;
        }
        i = i + 1;
    }
    if ones >= 2 {
        return 1;
    }
    return 0;
}

fn y_gate(state, q) {
    // Apply Y gate: Y = i*X*Z = [[0, -i], [i, 0]]
    // Equivalent to bit flip + phase flip
    // Simplified as X followed by phase adjustment (ignoring global phase)
    let s = state;
    s = x_gate(s, q);
    // Phase flip on |1⟩ component (multiply by -1)
    let size = len(s);
    let i = 0;
    while i < size {
        if _bit_of(i, q) == 1 {
            s[i] = [0.0 - s[i][0], 0.0 - s[i][1]];
        }
        i = i + 1;
    }
    return s;
}

fn z_gate(state, q) {
    // Apply Z gate: [[1, 0], [0, -1]]
    // Phase flip on |1⟩ component
    let size = len(state);
    let new_state = [];
    let i = 0;
    while i < size {
        array_push(new_state, [state[i][0], state[i][1]]);
        i = i + 1;
    }
    i = 0;
    while i < size {
        if _bit_of(i, q) == 1 {
            // Multiply by -1 (phase flip)
            new_state[i] = [0.0 - state[i][0], 0.0 - state[i][1]];
        }
        i = i + 1;
    }
    return new_state;
}

fn add_depolarizing_noise(circ, p) {
    // Add depolarizing noise to a circuit.
    // After each gate, with probability p, insert a random error gate (X, Y, or Z).
    // circ: array of gate operations, each is map{"gate": "h"/"x"/"y"/"z"/"cnot", "q": qubit, ...}
    // p: probability of error (0.0 to 1.0)
    // Returns: new circuit with potential error gates inserted
    let noisy_circ = [];
    let i = 0;
    while i < len(circ) {
        // Add the original gate
        array_push(noisy_circ, circ[i]);

        // With probability p, add a random error gate
        let r = random_float();
        if r < p {
            // Choose random error: X (0), Y (1), or Z (2)
            let error_choice = num_floor(random_float() * 3.0);
            let error_gate = "x";
            if error_choice == 1.0 {
                error_gate = "y";
            }
            if error_choice == 2.0 {
                error_gate = "z";
            }

            // Create error gate operation on the same qubit(s)
            let original_gate = circ[i];
            let error_op = map{
                "gate": error_gate,
                "q": original_gate["q"]
            };
            array_push(noisy_circ, error_op);
        }
        i = i + 1;
    }
    return noisy_circ;
}

fn histogram(outcomes) {
    // Build a simple frequency map of measurement outcomes.
    // Keys are stringified outcomes ("0", "1", "2", ...), values are counts.
    let counts = map{};
    let i = 0;
    while i < len(outcomes) {
        let k = str(outcomes[i]);
        if map_has(counts, k) {
            counts[k] = counts[k] + 1;
        } else {
            counts[k] = 1;
        }
        i = i + 1;
    }
    return counts;
}

export zero_state, h_gate, x_gate, y_gate, z_gate, cnot_gate, measure, repetition_encode, repetition_decode, histogram, add_depolarizing_noise;
