// Read-only merge diagnostics. The canonical renderer remains the final authority.
let Text=import("stdlib:text_document.sapp");let Sheet=import("stdlib:sheet_document.sapp");
let Fields=import("stdlib:template_fields.sapp");let Merge=import("stdlib:document_merge.sapp");
let MAX_ISSUES=64;
fn _issue(result,level,code,message,row=0,column=0,block=nil) {
 if level=="error" {result.errors=result.errors+1;} else {result.warnings=result.warnings+1;}
 if len(result.issues)<MAX_ISSUES {array_push(result.issues,map{level:level,code:code,message:message,row:row,column:column,block:block});}
 else {result.omitted=result.omitted+1;}
}
fn inspect(template,table) {
 let result=map{format:"pblang.document-merge-check.v1",ready:false,records:0,fields:[],errors:0,warnings:0,issues:[],omitted:0,text_bytes:0,contains_source_text:true,safe_to_log:false};
 let doc_size=try Text.validate(template) catch nil;let table_size=try Sheet.validate(table) catch nil;
 if doc_size==nil {_issue(result,"error","invalid_template","Template is not a supported Writer document.");}
 if table_size==nil {_issue(result,"error","invalid_table","Table structure or text exceeds supported limits.");}
 if result.errors>0 {return result;}
 result.records=table_size.rows-1;
 if result.records==0 {_issue(result,"error","no_records","Add at least one data row below the header.");}
 let headers=table.cells[0];let columns=map{};
 for c in range(0,len(headers)) {
  if not Fields.valid_name(headers[c]) {_issue(result,"error","invalid_header","Use an exact ASCII field name in this header.",1,c+1);}
  elif map_has(columns,headers[c]) {_issue(result,"error","duplicate_header","This header repeats an earlier column name.",1,c+1);}
  else {columns[headers[c]]=c;}
 }
 let sources=[template.title];for block in template.blocks {array_push(sources,block.text);}
 let seen=map{};
 for part in range(0,len(sources)) {
  let plan=try Fields.compile(sources[part]) catch nil;
  if plan==nil {_issue(result,"error","invalid_fields","Use only closed {{field_name}} placeholders.",0,0,part);}
  else {for name in Fields.names(plan) {if not map_has(seen,name) {seen[name]=true;array_push(result.fields,name);
   if not map_has(columns,name) {_issue(result,"error","missing_column","Missing column for field: "+name,1,0,part);}
  }}}
 }
 if result.errors>0 {return result;}
 for c in range(0,len(headers)) {
  if not map_has(seen,headers[c]) {_issue(result,"warning","unused_column","This column is not used by the template.",1,c+1);}
  else {for r in range(1,table_size.rows) {if str_trim(table.cells[r][c])=="" {_issue(result,"warning","blank_value","A used field is empty or whitespace; its original value will be kept.",r+1,c+1);}}}
 }
 let merged=try Merge.render(template,table) catch nil;
 if merged!=nil {result.ready=true;result.text_bytes=merged.text_bytes;return result;}
 // Diagnose a failed batch without ever writing or returning partial documents.
 for r in range(1,table_size.rows) {
  let one=map{format:Sheet.FORMAT,cells:[headers,table.cells[r]]};
  if (try Merge.render(template,one) catch nil)==nil {_issue(result,"error","record_output_limit","This record exceeds a generated title, block or document limit.",r+1);}
 }
 if result.errors==0 {_issue(result,"error","batch_output_limit","Combined generated text exceeds the batch limit.");}
 return result;
}
fn summary(result) {
 return (if result.ready {"Ready"} else {"Needs correction"})+" | "+str(result.records)+" records | "+str(result.errors)+" errors | "+str(result.warnings)+" warnings";
}
fn describe(issue) {
 let where="";
 if issue.row>0 {where="Row "+str(issue.row);if issue.column>0 {where=where+", column "+str(issue.column);}where=where+": ";}
 elif issue.block==0 {where="Title: ";} elif issue.block!=nil and issue.block>0 {where="Block "+str(issue.block)+": ";}
 return issue.level+" | "+where+issue.message;
}
export MAX_ISSUES,inspect,summary,describe;
