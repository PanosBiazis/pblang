// stdlib/base32.sapp — RFC 4648 Base32 encode/decode (standard alphabet,
// "=" padding). Complements the built-in base64/hex codecs. Bit accumulation
// uses only small integers, so it is exact (no f64 rounding).
//
//   let b32 = import("stdlib:base32.sapp");
//   b32.encode("foobar")   // "MZXW6YTBOI======"
//   b32.decode("MY======") // "f"

let _ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";

fn _pow2(n) { let r = 1; for i in 0 to n - 1 { r = r * 2; } return r; }

fn _val(c) {
    for i in 0 to 31 { if _ALPHA[i] == c { return i; } }
    return error("base32: invalid character '" + c + "'");
}

// encode_bytes(arr) — encode an array of byte numbers (0..255) to Base32.
fn encode_bytes(bytes) {
    let out = "";
    let buffer = 0;
    let bits = 0;
    for b in bytes {
        buffer = buffer * 256 + b;
        bits = bits + 8;
        while bits >= 5 {
            bits = bits - 5;
            let p = _pow2(bits);
            let idx = num_floor(buffer / p) % 32;
            out = out + _ALPHA[idx];
            buffer = buffer % p;
        }
    }
    if bits > 0 {
        let idx = (buffer * _pow2(5 - bits)) % 32;
        out = out + _ALPHA[idx];
    }
    while len(out) % 8 != 0 { out = out + "="; }
    return out;
}

fn encode(s) { return encode_bytes(str_to_bytes(s)); }

// decode_to_bytes(b32) — decode Base32 text into an array of byte numbers.
fn decode_to_bytes(s) {
    let up = str_upper(s);
    let buffer = 0;
    let bits = 0;
    let out = [];
    for i in 0 to len(up) - 1 {
        let c = up[i];
        if c != "=" {
            let v = _val(c);
            buffer = buffer * 32 + v;
            bits = bits + 5;
            if bits >= 8 {
                bits = bits - 8;
                let p = _pow2(bits);
                array_push(out, num_floor(buffer / p) % 256);
                buffer = buffer % p;
            }
        }
    }
    return out;
}

fn decode(s) { return bytes_to_str(decode_to_bytes(s)); }

export encode, encode_bytes, decode, decode_to_bytes;
