// stdlib/base32.sapp — RFC 4648 Base32 encode/decode (standard alphabet,
// "=" padding). Complements the built-in base64/hex codecs. Bit accumulation
// uses only small integers, so it is exact (no f64 rounding).
//
//   let b32 = import("stdlib:base32.sapp");
//   b32.encode("foobar")   // "MZXW6YTBOI======"
//   b32.decode("MY======") // "f"

let _ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";         // RFC 4648 standard
let _ALPHA_HEX = "0123456789ABCDEFGHIJKLMNOPQRSTUV";       // RFC 4648 §7 base32hex

fn _pow2(n) { let r = 1; for i in 0 to n - 1 { r = r * 2; } return r; }

fn _val_in(alpha, c) {
    for i in 0 to 31 { if alpha[i] == c { return i; } }
    return error("base32: invalid character '" + c + "'");
}

// _encode_alpha(bytes, alpha, pad) — core encoder over a 32-char alphabet.
fn _encode_alpha(bytes, alpha, pad) {
    let out = "";
    let buffer = 0;
    let bits = 0;
    for b in bytes {
        buffer = buffer * 256 + b;
        bits = bits + 8;
        while bits >= 5 {
            bits = bits - 5;
            let p = _pow2(bits);
            let idx = num_floor(buffer / p) % 32;
            out = out + alpha[idx];
            buffer = buffer % p;
        }
    }
    if bits > 0 {
        let idx = (buffer * _pow2(5 - bits)) % 32;
        out = out + alpha[idx];
    }
    if pad { while len(out) % 8 != 0 { out = out + "="; } }
    return out;
}

// _decode_alpha(s, alpha) — core decoder; ignores "=" padding, case-insensitive.
fn _decode_alpha(s, alpha) {
    let up = str_upper(s);
    let buffer = 0;
    let bits = 0;
    let out = [];
    for i in 0 to len(up) - 1 {
        let c = up[i];
        if c != "=" {
            let v = _val_in(alpha, c);
            buffer = buffer * 32 + v;
            bits = bits + 5;
            if bits >= 8 {
                bits = bits - 8;
                let p = _pow2(bits);
                array_push(out, num_floor(buffer / p) % 256);
                buffer = buffer % p;
            }
        }
    }
    return out;
}

// ── standard alphabet (RFC 4648) ────────────────────────────────────────────────
fn encode_bytes(bytes) { return _encode_alpha(bytes, _ALPHA, true); }
fn encode(s) { return encode_bytes(str_to_bytes(s)); }
fn encode_nopad(s) { return _encode_alpha(str_to_bytes(s), _ALPHA, false); }
fn decode_to_bytes(s) { return _decode_alpha(s, _ALPHA); }
fn decode(s) { return bytes_to_str(decode_to_bytes(s)); }

// ── base32hex alphabet (RFC 4648 §7) — sorts in the same order as the data ───────
fn encode_hex_bytes(bytes) { return _encode_alpha(bytes, _ALPHA_HEX, true); }
fn encode_hex(s) { return encode_hex_bytes(str_to_bytes(s)); }
fn decode_hex_to_bytes(s) { return _decode_alpha(s, _ALPHA_HEX); }
fn decode_hex(s) { return bytes_to_str(decode_hex_to_bytes(s)); }

// is_valid(s) — true if every non-padding character is in the standard alphabet.
fn is_valid(s) {
    let up = str_upper(s);
    let i = 0;
    while i < len(up) {
        let c = up[i];
        if c != "=" {
            if str_index_of(_ALPHA, c) < 0 { return false; }
        }
        i = i + 1;
    }
    return true;
}

export encode, encode_bytes, encode_nopad, decode, decode_to_bytes,
       encode_hex, encode_hex_bytes, decode_hex, decode_hex_to_bytes,
       is_valid;
