// stdlib/canvas.sapp — a renderer-agnostic 2D draw-command buffer (pure pblang).
//
// You "draw" by appending commands to a canvas; a backend later REPLAYS them (the IDE's
// graphics.Window, a headless snapshot, or the built-in SVG exporter). This decouples
// what to draw from how it is drawn, and makes drawing code fully testable.
//
//   let canvas = import("stdlib:canvas.sapp");
//   let cv = canvas.new(200, 100);
//   canvas.fill_rect(cv, 0, 0, 200, 100, map{r:13,g:17,b:23});   // background
//   canvas.text(cv, 8, 8, "hello", map{r:220,g:228,b:240});
//   // replay: for c in canvas.commands(cv) { draw(c); }   OR  print canvas.to_svg(cv);
//
// Colors are {r,g,b} maps (pairs with stdlib:theme.sapp). Every command is a map with an
// `op` field, so a backend can switch on it.

fn new(width, height) { return map{ width: width, height: height, ops: [] }; }

fn _push(cv, cmd) { array_push(cv.ops, cmd); return cv; }

// fill_rect / rect (stroke) / line / circle / text — append a draw command.
fn fill_rect(cv, x, y, w, h, color) { return _push(cv, map{ op: "fill_rect", x: x, y: y, w: w, h: h, color: color }); }
fn rect(cv, x, y, w, h, color)      { return _push(cv, map{ op: "rect", x: x, y: y, w: w, h: h, color: color }); }
fn line(cv, x1, y1, x2, y2, color)  { return _push(cv, map{ op: "line", x1: x1, y1: y1, x2: x2, y2: y2, color: color }); }
fn circle(cv, cx, cy, r, color)     { return _push(cv, map{ op: "circle", cx: cx, cy: cy, r: r, color: color }); }
fn text(cv, x, y, s, color)         { return _push(cv, map{ op: "text", x: x, y: y, text: str(s), color: color }); }

// commands(cv) — the recorded draw commands (in order).
fn commands(cv) { return cv.ops; }

// count(cv) — number of recorded commands.
fn count(cv) { return len(cv.ops); }

// clear(cv) — drop all commands (keep the size).
fn clear(cv) { cv.ops = []; return cv; }

fn _css(c) {
    if c == nil { return "rgb(0,0,0)"; }
    return "rgb(" + str(try c.r catch 0) + "," + str(try c.g catch 0) + "," + str(try c.b catch 0) + ")";
}

fn _esc(s) {
    let t = str_replace_all(str(s), "&", "&amp;");
    t = str_replace_all(t, "<", "&lt;");
    return str_replace_all(t, ">", "&gt;");
}

// to_svg(cv) — render the command buffer to an SVG document string.
fn to_svg(cv) {
    let out = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + str(cv.width) + "\" height=\"" + str(cv.height) + "\">";
    let i = 0;
    while i < len(cv.ops) {
        let c = cv.ops[i];
        let op = c.op;
        if op == "fill_rect" {
            out = out + "<rect x=\"" + str(c.x) + "\" y=\"" + str(c.y) + "\" width=\"" + str(c.w) + "\" height=\"" + str(c.h) + "\" fill=\"" + _css(c.color) + "\"/>";
        } else if op == "rect" {
            out = out + "<rect x=\"" + str(c.x) + "\" y=\"" + str(c.y) + "\" width=\"" + str(c.w) + "\" height=\"" + str(c.h) + "\" fill=\"none\" stroke=\"" + _css(c.color) + "\"/>";
        } else if op == "line" {
            out = out + "<line x1=\"" + str(c.x1) + "\" y1=\"" + str(c.y1) + "\" x2=\"" + str(c.x2) + "\" y2=\"" + str(c.y2) + "\" stroke=\"" + _css(c.color) + "\"/>";
        } else if op == "circle" {
            out = out + "<circle cx=\"" + str(c.cx) + "\" cy=\"" + str(c.cy) + "\" r=\"" + str(c.r) + "\" fill=\"" + _css(c.color) + "\"/>";
        } else if op == "text" {
            out = out + "<text x=\"" + str(c.x) + "\" y=\"" + str(c.y) + "\" fill=\"" + _css(c.color) + "\">" + _esc(c.text) + "</text>";
        }
        i = i + 1;
    }
    return out + "</svg>";
}

export new, fill_rect, rect, line, circle, text, commands, count, clear, to_svg;
