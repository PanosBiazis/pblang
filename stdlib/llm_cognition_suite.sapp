       FORMAT_EPISTEMIC, FORMAT_DUALSTACK, FORMAT_VIEWPORT_DAG,
       FORMAT_DELPHI_BLAZOR, FORMAT_VON_NEUMANN_BPE, FORMAT_ATTENTION_CONTINUAL,
       FORMAT_CAUSAL_ALIGNMENT, FORMAT_CYBER_PQC, FORMAT_HISTORICAL_CYCLE,
       inspect_pblang_idioms, compile_orientation_brief,
       audit_ecosystem_topology, evaluate_epistemic_claims,
       verify_dualstack_and_commercial, audit_gui_viewport_and_plan,
       migrate_delphi_to_blazor, enforce_von_neumann_and_bpe_shield,
       guard_attention_and_continual_memory, evaluate_causal_world_and_alignment,
       audit_cyber_pqc_and_user_shield, resolve_historical_cycle_vs_live;


