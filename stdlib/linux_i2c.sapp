// Explicit-address, bounded Linux I2C discovery implemented in PBLang.
//
// A caller must name every unreserved 7-bit address. The module never performs
// an implicit whole-bus sweep because SMBus probes can mutate unusual devices.

let DEVICE=import("stdlib:linux_device_handle.sapp");
let FORMAT="pblang.linux-i2c-scan.v1";
let MAX_ADDRESSES=112;

fn _integer(value,minimum,maximum){return type(value)=="number" and value==num_floor(value)
    and value>=minimum and value<=maximum;}

fn normalize_addresses(value){
    if type(value)!="array" or len(value)<1 or len(value)>MAX_ADDRESSES{
        throw "addresses must contain 1 to 112 explicit I2C addresses";
    }
    let seen=map{};let out=[];
    for i len(value){let address=value[i];
        if not _integer(address,3,119){throw "I2C addresses must be unreserved integers from 3 to 119";}
        let key=str(address);if map_has(seen,key){throw "duplicate I2C address";}
        seen[key]=true;array_push(out,address);
    }
    return array_sort(out);
}

fn native_backend(){
    return map{
        open:fn(path){return DEVICE.open_device(path,"i2c","read-write");},
        capabilities:fn(handle){return DEVICE.ioctl_u64(handle,"I2C_FUNCS");},
        probe:fn(handle,address,mode){return DEVICE.i2c_probe(handle,address,mode);},
        close:fn(handle){return DEVICE.close(handle);}
    };
}

fn scan_with_backend(bus,addresses,mode,backend){
    if not _integer(bus,0,255){throw "bus must be an integer from 0 to 255";}
    if mode!="receive-byte" and mode!="quick-write"{
        throw "probe_mode must be receive-byte or quick-write";
    }
    let targets=normalize_addresses(addresses);let path="/dev/i2c-"+str(bus);
    let handle=backend.open(path);
    if not (try handle.ok catch false){return map{ok:false,executed:false,format:FORMAT,
        bus:bus,path:path,error:try handle.error catch "I2C bus open failed"};}
    let capabilities=backend.capabilities(handle);
    if not (try capabilities.ok catch false){backend.close(handle);return map{ok:false,
        executed:false,format:FORMAT,bus:bus,path:path,error:"I2C capabilities unavailable"};}
    let found=[];let probes=[];
    for i len(targets){let result=backend.probe(handle,targets[i],mode);
        let responded=(try result.ok catch false) and (try result.responded catch false);
        array_push(probes,map{address:targets[i],responded:responded,
            value:try result.value catch nil});
        if responded{array_push(found,targets[i]);}
    }
    let closed=backend.close(handle);
    return map{ok:true,executed:true,format:FORMAT,bus:bus,path:path,probe_mode:mode,
        requested_addresses:targets,probes:probes,found_addresses:found,
        requested_count:len(targets),found_count:len(found),
        adapter_functions:capabilities.value,descriptor_bound:true,
        descriptor_closed:try closed.closed catch try closed.ok catch false,
        implicit_full_bus_scan:false,shell_used:false};
}

fn scan(bus,addresses,mode="receive-byte"){
    if platform()!="linux"{return map{ok:false,executed:false,error:"Linux I2C backend unavailable"};}
    return scan_with_backend(bus,addresses,mode,native_backend());
}

export FORMAT, MAX_ADDRESSES, normalize_addresses, native_backend,
       scan_with_backend, scan;
