//! compression.sapp — Compression utilities for pblang
//! Provides gzip, zstd, brotli compression via system tools.
//! Uses exec builtin to call system compression utilities.

/// Gzip compress a string, returns base64-encoded compressed data
fn gzip_compress(data) {
    // Write data to temp file, compress, read back
    let tmp_in = "/tmp/pblang_gzip_in_" + str(random_bytes(4));
    let tmp_out = tmp_in + ".gz";
    
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("gzip_compress: failed to write temp file"); }
    
    let result = exec("gzip -c " + tmp_in);
    let ok2 = fs_delete(tmp_in);
    
    return result;
}

/// Gzip decompress a base64-encoded compressed string
fn gzip_decompress(data) {
    let tmp_in = "/tmp/pblang_gzdec_in_" + str(random_bytes(4));
    let tmp_out = tmp_in + ".dec";
    
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("gzip_decompress: failed to write temp file"); }
    
    let result = exec("gzip -d -c " + tmp_in);
    let ok2 = fs_delete(tmp_in);
    
    return result;
}

/// Zstd compress
fn zstd_compress(data, level = 3) {
    let tmp_in = "/tmp/pblang_zst_in_" + str(random_bytes(4));
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("zstd_compress: failed to write temp file"); }
    let result = exec("zstd -" + str(level) + " -c " + tmp_in + " 2>/dev/null");
    let ok2 = fs_delete(tmp_in);
    return result;
}

/// Zstd decompress
fn zstd_decompress(data) {
    let tmp_in = "/tmp/pblang_zstd_in_" + str(random_bytes(4));
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("zstd_decompress: failed to write temp file"); }
    let result = exec("zstd -d -c " + tmp_in + " 2>/dev/null");
    let ok2 = fs_delete(tmp_in);
    return result;
}

/// Brotli compress. Uses a temp file (not shell-piped echo) so payloads
/// containing apostrophes / shell metacharacters cannot inject commands.
fn brotli_compress(data, quality = 11) {
    let tmp_in = "/tmp/pblang_br_in_" + str(random_bytes(4));
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("brotli_compress: failed to write temp file"); }
    let result = exec("brotli -" + str(quality) + " -c " + tmp_in + " 2>/dev/null");
    let ok2 = fs_delete(tmp_in);
    return result;
}

/// Brotli decompress. Temp-file based for the same shell-safety reason.
fn brotli_decompress(data) {
    let tmp_in = "/tmp/pblang_brdec_in_" + str(random_bytes(4));
    let ok = fs_write_bytes(tmp_in, data);
    if not ok { return error("brotli_decompress: failed to write temp file"); }
    let result = exec("brotli -d -c " + tmp_in + " 2>/dev/null");
    let ok2 = fs_delete(tmp_in);
    return result;
}

/// Auto-detect compression format from magic bytes and decompress
fn auto_decompress(data) {
    let magic = "";
    if len(data) >= 2 { magic = data[0..2]; }
    
    // gzip magic: 0x1F 0x8B
    if len(data) >= 2 {
        // Check for gzip
        let b0 = data[0..1];
        let b1 = data[1..2];
        if b0 == "\x1f" and b1 == "\x8b" {
            return gzip_decompress(data);
        }
    }
    
    // zstd magic: 0x28 0xB5 0x2F 0xFD
    if len(data) >= 4 {
        let magic4 = data[0..4];
        if magic4 == "\x28\xb5\x2f\xfd" {
            return zstd_decompress(data);
        }
    }
    
    // Try brotli
    let result = brotli_decompress(data);
    if result != "" { return result; }
    
    // Try gzip
    let result2 = gzip_decompress(data);
    if result2 != "" { return result2; }
    
    // Try zstd
    let result3 = zstd_decompress(data);
    if result3 != "" { return result3; }
    
    return data; // no compression detected, return as-is
}

export gzip_compress;
export gzip_decompress;
export zstd_compress;
export zstd_decompress;
export brotli_compress;
export brotli_decompress;
export auto_decompress;
