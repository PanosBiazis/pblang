// A bounded view of stored due dates, not a prediction of future reviews.
let Study=import("stdlib:study_cards.sapp");let Date=import("stdlib:civil_date.sapp");
fn plan(deck,today,days=7) {
 Study.validate(deck);let start=Date.ordinal(today);
 if type(days)!="number" or not(days>=1 and days<=31) or days!=num_floor(days) {throw "choose 1-31 days";}
 Date.from_ordinal(start+days-1);
 let entries=[];for i in range(0,days) {array_push(entries,map{date:Date.from_ordinal(start+i),scheduled:0,due_by:0});}
 let overdue=0;let later=0;
 for card in deck.cards {
  let offset=Date.ordinal(card.due)-start;
  if offset<0 {overdue=overdue+1;}
  elif offset>=days {later=later+1;}
  else {entries[offset].scheduled=entries[offset].scheduled+1;}
 }
 let total=overdue;for i in range(0,days) {total=total+entries[i].scheduled;entries[i].due_by=total;}
 return map{format:"pblang.study-agenda.v1",start:today,days:days,total_cards:len(deck.cards),overdue:overdue,later:later,entries:entries,assumes_no_reviews:true,contains_card_text:false,safe_to_log:false};
}
fn select_due(deck,today) {
 let cards=Study.due(deck,today);if len(cards)==0 {throw "no cards due on this date";}
 return map{format:Study.FORMAT,title:deck.title,cards:cards};
}
export plan,select_due;
