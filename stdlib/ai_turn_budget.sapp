// Pure caller-priced accounting. No provider, tokenizer, content or I/O state.
// Categories are disjoint: input excludes cache-read and cache-write tokens.
let MAX_SAFE = 9007199254740991;
let MAX_TOKEN = 1000000000;
let KEYS = ["input", "output", "cache_read", "cache_write"];

fn limits() {
    return map{ max_tokens: MAX_TOKEN, max_rate: MAX_TOKEN, max_units: MAX_SAFE };
}

fn _integer(value, maximum) {
    if type(value) != "number" { throw "ai_turn_budget: expected ordinary integer"; }
    // Retained ordered comparisons can throw for NaN; reject that as out of range.
    if not (try value >= 0 and value <= maximum catch false) {
        throw "ai_turn_budget: integer out of range";
    }
    if num_floor(value) != value { throw "ai_turn_budget: expected integer"; }
    return value;
}

// Check cardinality before key access; no traversal/stringification of values.
fn _categories(record) {
    if not is_map(record) { throw "ai_turn_budget: expected four-category map"; }
    if len(record) != 4 { throw "ai_turn_budget: expected four-category map"; }
    for key in KEYS {
        if not map_has(record, key) { throw "ai_turn_budget: missing category"; }
        _integer(record[key], MAX_TOKEN);
    }
    return record;
}

fn rates(input, output, cache_read, cache_write) {
    return _categories(map{ input: input, output: output,
        cache_read: cache_read, cache_write: cache_write });
}

fn usage(input = 0, output = 0, cache_read = 0, cache_write = 0) {
    return _categories(map{ input: input, output: output,
        cache_read: cache_read, cache_write: cache_write });
}

fn _multiply(count, rate) {
    // Division may round up at the integer boundary. Check the product too:
    // every accepted integer <= MAX_SAFE is exactly representable in f64.
    if count != 0 and rate > num_floor(MAX_SAFE / count) {
        throw "ai_turn_budget: cost overflow";
    }
    let value = count * rate;
    if value > MAX_SAFE { throw "ai_turn_budget: cost overflow"; }
    return value;
}

fn _add(left, right) {
    if right > MAX_SAFE - left { throw "ai_turn_budget: cost overflow"; }
    return left + right;
}

fn _cost(prices, tokens) {
    let costs = map{};
    let total = 0;
    for key in KEYS {
        let value = _multiply(tokens[key], prices[key]);
        costs[key] = value;
        total = _add(total, value);
    }
    return map{ categories: costs, total_units: total };
}

fn cost(prices, tokens) {
    _categories(prices);
    _categories(tokens);
    return _cost(prices, tokens);
}

// Admission is an estimate only. It reserves nothing and causes no execution.
fn forecast(prices, planned, remaining_units) {
    _integer(remaining_units, MAX_SAFE);
    let estimate = cost(prices, planned);
    let allowed = estimate.total_units <= remaining_units;
    return map{ kind: "forecast", allowed: allowed, estimate: estimate,
        remaining_units: if allowed { remaining_units - estimate.total_units } else { 0 },
        shortfall_units: if allowed { 0 } else { estimate.total_units - remaining_units } };
}

// Supply only prompt categories (output must be zero). The explicit output cap
// bounds even free output. A denied prompt is distinct from zero affordable output.
fn affordable_output(prices, prompt, remaining_units, output_cap) {
    _categories(prices);
    _categories(prompt);
    _integer(remaining_units, MAX_SAFE);
    _integer(output_cap, MAX_TOKEN);
    if prompt.output != 0 { throw "ai_turn_budget: prompt output must be zero"; }
    let prompt_cost = _cost(prices, prompt).total_units;
    if prompt_cost > remaining_units {
        return map{ kind: "forecast", allowed: false, output_tokens: 0,
            prompt_units: prompt_cost, total_units: prompt_cost, remaining_units: 0,
            shortfall_units: prompt_cost - remaining_units };
    }
    let available = remaining_units - prompt_cost;
    let count = output_cap;
    if prices.output != 0 {
        count = num_min(output_cap, num_floor(available / prices.output));
        // Correct a quotient rounded up to the next integer before admitting it.
        // count <= 1e9, so division rounding can overestimate by at most one.
        if count * prices.output > available { count = count - 1; }
    }
    let total = _add(prompt_cost, _multiply(count, prices.output));
    return map{ kind: "forecast", allowed: true, output_tokens: count,
        prompt_units: prompt_cost, total_units: total,
        remaining_units: remaining_units - total, shortfall_units: 0 };
}

// Pure accounting: overspending is recorded, never silently rejected or clipped.
// The caller owns the returned spent value, deduplication and synchronization.
fn account(prices, actual, budget_units, spent_units = 0) {
    _integer(budget_units, MAX_SAFE);
    _integer(spent_units, MAX_SAFE);
    let measured = cost(prices, actual);
    let next = _add(spent_units, measured.total_units);
    let within = next <= budget_units;
    return map{ kind: "actual", cost: measured, spent_units: next,
        within_budget: within,
        remaining_units: if within { budget_units - next } else { 0 },
        excess_units: if within { 0 } else { next - budget_units } };
}

export limits, rates, usage, cost, forecast, affordable_output, account;
