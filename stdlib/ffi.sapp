// Minimal FFI stdlib (interop-first).
//
// Current MVP:
// - numbers only (f64) arguments and return value
// - up to 6 arguments
//
// Usage:
//   import "stdlib:ffi.sapp";
//   let lib = ffi.load("mylib.dll");
//   print lib.call("add2", [1, 2]);
//   lib.close();

fn load(path) {
    let h = ffi_load(path);
    return map{
        handle: h,
        call: fn(name, args) { return ffi_call(h, name, args); },
        close: fn() { return ffi_close(h); }
    };
}

export load;

