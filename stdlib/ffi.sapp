// FFI stdlib (interop-first).
//
// Two calling modes are supported:
//
// 1) Numeric-only (`ffi_call`) — fastest dispatch, accepts only `f64`
//    arguments and returns an `f64`. Suitable for math-heavy libraries.
//
// 2) Typed (`ffi_call_typed`) — accepts a signature string like
//    `"i64,string->i64"` and works with integers, doubles, strings, bools,
//    and opaque pointers. Use this for most real-world C interop.
//
// Usage:
//   import "stdlib:ffi.sapp";
//   let lib = ffi.load("./mylib.so");
//   // Numeric only:
//   print lib.call("add2", [1, 2]);
//   // Typed:
//   print lib.call_typed("greet", "string->string", ["world"]);
//   print lib.call_typed("strlen", "string->i64", ["hello"]);
//   lib.close();
//
// Supported types in `sig` (case-sensitive, comma-separated):
//   i64  i32  f64  f32  bool  string  ptr  void
// Up to four arguments per call. For more complex C ABIs, write a tiny C
// wrapper that bundles the call into one of the supported shapes.

fn load(path) {
    let h = ffi_load(path);
    return map{
        handle: h,
        call: fn(name, args) { return ffi_call(h, name, args); },
        call_typed: fn(name, sig, args) { return ffi_call_typed(h, name, sig, args); },
        close: fn() { return ffi_close(h); }
    };
}

// Convenience: call a function returning a string given a list of string args.
fn call_str(lib_or_handle, name, args) {
    let h = lib_or_handle;
    if is_map(lib_or_handle) { h = lib_or_handle.handle; }
    let sig = "";
    let i = 0;
    while i < len(args) {
        if i > 0 { sig = sig + ","; }
        sig = sig + "string";
        i = i + 1;
    }
    sig = sig + "->string";
    return ffi_call_typed(h, name, sig, args);
}

// Convenience: call a function returning an integer given a list of integer args.
fn call_int(lib_or_handle, name, args) {
    let h = lib_or_handle;
    if is_map(lib_or_handle) { h = lib_or_handle.handle; }
    let sig = "";
    let i = 0;
    while i < len(args) {
        if i > 0 { sig = sig + ","; }
        sig = sig + "i64";
        i = i + 1;
    }
    sig = sig + "->i64";
    return ffi_call_typed(h, name, sig, args);
}

export load, call_str, call_int;
