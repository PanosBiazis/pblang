// Portable block document; formatting is heading/paragraph/bullet, not rich text.
let Metrics=import("stdlib:text_metrics.sapp");
let Serialization=import("stdlib:serialization.sapp");
let Strings=import("stdlib:strings.sapp");
let FORMAT="pblang.text-document.v1";
let MAX_BLOCKS=64; let MAX_BLOCK_BYTES=1024; let MAX_TOTAL_BYTES=32768;
let MAX_FILE_BYTES=262144;
fn _text(text,limit) {
    if type(text)!="string" or len(text)>limit or len(str_to_bytes(text))>limit
        or str_contains(text,"\u0000") { throw "invalid document text or byte limit"; }
}
fn _block(block) {
    if type(block)!="map" or len(block)!=2 or not map_has(block,"kind") or not map_has(block,"text")
        or (block.kind!="paragraph" and block.kind!="heading" and block.kind!="bullet") {
        throw "invalid document block";
    }
    _text(block.text,MAX_BLOCK_BYTES);
}
fn validate(doc) {
    if type(doc)!="map" or len(doc)!=3 or not map_has(doc,"format") or doc.format!=FORMAT
        or not map_has(doc,"title") or not map_has(doc,"blocks") or type(doc.blocks)!="array"
        or len(doc.blocks)<1 or len(doc.blocks)>MAX_BLOCKS { throw "invalid text document"; }
    _text(doc.title,256); let total=len(str_to_bytes(doc.title));
    for block in doc.blocks {
        _block(block); total=total+len(str_to_bytes(block.text));
        if total>MAX_TOTAL_BYTES { throw "document total text limit exceeded"; }
    }
    return map{blocks:len(doc.blocks),text_bytes:total};
}
fn create(title="") { _text(title,256); return map{format:FORMAT,title:title,blocks:[map{kind:"paragraph",text:""}]}; }
fn copy(doc) {
    validate(doc); let blocks=[];
    for block in doc.blocks { array_push(blocks,map{kind:block.kind,text:block.text}); }
    return map{format:FORMAT,title:doc.title,blocks:blocks};
}
fn _index(index,maximum) {
    if type(index)!="number" or not (index>=0 and index<=maximum) or index!=num_floor(index) {
        throw "invalid document block index";
    }
}
fn set_block(doc,index,kind,text) {
    validate(doc); _index(index,len(doc.blocks)-1);
    let block=map{kind:kind,text:text}; _block(block);
    let out=copy(doc); out.blocks[index]=block; validate(out); return out;
}
fn insert_block(doc,index,kind="paragraph",text="") {
    validate(doc); _index(index,len(doc.blocks)); _block(map{kind:kind,text:text});
    if len(doc.blocks)>=MAX_BLOCKS { throw "document block limit exceeded"; }
    let out=copy(doc); out.blocks=[];
    for i in range(0,len(doc.blocks)+1) {
        if i==index { array_push(out.blocks,map{kind:kind,text:text}); }
        if i<len(doc.blocks) { array_push(out.blocks,map{kind:doc.blocks[i].kind,text:doc.blocks[i].text}); }
    }
    validate(out); return out;
}
// Explicit deletion, including nonempty text; callers must offer undo.
fn remove_block(doc,index) {
    validate(doc); _index(index,len(doc.blocks)-1);
    if len(doc.blocks)==1 { throw "document needs at least one block"; }
    let out=copy(doc); out.blocks=[];
    for i in range(0,len(doc.blocks)) {
        if i!=index { array_push(out.blocks,map{kind:doc.blocks[i].kind,text:doc.blocks[i].text}); }
    }
    return out;
}
fn _limits() {
    return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,
        max_depth:5,max_items:512,strict:true,reject_duplicate_keys:true};
}
fn encode(doc) {
    let result=Serialization.stringify_safe(copy(doc),"json",_limits());
    if not result.ok { throw "document serialization failed"; } return result.value;
}
fn decode(text) {
    let result=Serialization.parse_safe(text,"json",_limits());
    if not result.ok or result.duplicate_keys_checked!=true { throw "invalid text document file"; }
    return copy(result.value);
}
fn find(doc,query) {
    validate(doc); _text(query,256); if query=="" { throw "empty document search"; }
    let found=[];
    for i in range(0,len(doc.blocks)) { if str_contains(doc.blocks[i].text,query) { array_push(found,i); } }
    return found;
}
fn replace_all(doc,query,replacement) {
    validate(doc); _text(query,256); _text(replacement,1024);
    if query=="" { throw "empty document search"; }
    let out=copy(doc); let total=len(str_to_bytes(doc.title)); let replacements=0;
    let replacement_bytes=len(str_to_bytes(replacement));
    for b in range(0,len(doc.blocks)) {
        let source=doc.blocks[b].text; let parts=[]; let size=0; let i=0;
        while i<len(source) {
            let piece=""; let bytes=0;
            if str_slice(source,i,i+len(query))==query {
                piece=replacement; bytes=replacement_bytes; i=i+len(query); replacements=replacements+1;
            } else { piece=str_slice(source,i,i+1); bytes=len(str_to_bytes(piece)); i=i+1; }
            if bytes>MAX_BLOCK_BYTES-size or bytes>MAX_TOTAL_BYTES-total { throw "document replacement limit exceeded"; }
            array_push(parts,piece); size=size+bytes; total=total+bytes;
        }
        out.blocks[b].text=str_join(parts,"");
    }
    return map{document:out,replacements:replacements};
}
fn from_text(text,title="") {
    _text(text,MAX_TOTAL_BYTES); let lines=str_split(Strings.replace_all(text,"\r\n","\n"),"\n");
    if len(lines)>MAX_BLOCKS { throw "document block limit exceeded"; }
    let doc=create(title); doc.blocks=[];
    for line in lines { array_push(doc.blocks,map{kind:"paragraph",text:line}); }
    validate(doc); return doc;
}
fn to_text(doc) { validate(doc); let lines=[]; for block in doc.blocks { array_push(lines,block.text); } return str_join(lines,"\n"); }
fn statistics(doc) {
    let size=validate(doc); let words=0; let characters=0;
    for block in doc.blocks {
        let metrics=Metrics.count(block.text); characters=characters+metrics.characters; words=words+metrics.words;
    }
    return map{blocks:size.blocks,text_bytes:size.text_bytes,body_characters:characters,body_words:words};
}
export FORMAT,MAX_BLOCKS,MAX_BLOCK_BYTES,MAX_TOTAL_BYTES,MAX_FILE_BYTES;
export create,validate,copy,set_block,insert_block,remove_block,encode,decode,find,replace_all,from_text,to_text,statistics;
