// stdlib/tensor.sapp
// Typed tensor/buffer contract — thin wrapper for structured numeric data.
// Purpose: typed shape + flat data array for AI providers and inference.

// tensor(shape, data) → map{ "shape": array, "data": array, "dtype": "f32" }
// shape: e.g. [2, 3] for a 2×3 matrix; data: flat array, length = product(shape)
fn tensor(shape, data) {
  let expected = _shape_size(shape);
  if len(data) != expected {
    return map{ "error": "tensor: data length " + str(len(data)) + " does not match shape size " + str(expected) };
  }
  return map{ "shape": shape, "data": data, "dtype": "f32" };
}

// zeros(shape) → tensor of all 0.0
fn zeros(shape) {
  let size = _shape_size(shape);
  let data = [];
  let i = 0;
  while i < size {
    array_push(data, 0.0);
    i = i + 1;
  }
  return tensor(shape, data);
}

// ones(shape) → tensor of all 1.0
fn ones(shape) {
  let size = _shape_size(shape);
  let data = [];
  let i = 0;
  while i < size {
    array_push(data, 1.0);
    i = i + 1;
  }
  return tensor(shape, data);
}

// get(t, indices) → scalar at flat index (row-major)
fn get(t, indices) {
  let idx = _flat_index(t["shape"], indices);
  return t["data"][idx];
}

// set(t, indices, value) → new tensor with value at indices (does not mutate original)
fn set(t, indices, value) {
  let idx = _flat_index(t["shape"], indices);
  let old_data = t["data"];
  let data = [];
  let i = 0;
  while i < len(old_data) {
    array_push(data, old_data[i]);
    i = i + 1;
  }
  data[idx] = value;
  return tensor(t["shape"], data);
}

// shape(t) → array e.g. [2, 3]
fn shape(t) {
  return t["shape"];
}

// dtype(t) → "f32"
fn dtype(t) {
  return t["dtype"];
}

// to_request_body(t) → map suitable for JSON-encoding in AI provider calls
fn to_request_body(t) {
  return map{ "shape": t["shape"], "data": t["data"], "dtype": t["dtype"] };
}

// slice(t, start, end) → new 1D tensor with elements from index start to end-1
// For 1D tensors only. Handles edge cases: start < 0, end > len, start >= end.
fn slice(t, start, end) {
  let s = t["shape"];
  if len(s) != 1 {
    return map{ "error": "slice: only 1D tensors supported, got shape length " + str(len(s)) };
  }

  let length = s[0];

  // Clamp start to valid range
  let actual_start = start;
  if actual_start < 0 {
    actual_start = 0;
  }
  if actual_start > length {
    actual_start = length;
  }

  // Clamp end to valid range
  let actual_end = end;
  if actual_end < 0 {
    actual_end = 0;
  }
  if actual_end > length {
    actual_end = length;
  }

  // If start >= end, return empty tensor
  if actual_start >= actual_end {
    return map{ "shape": [0], "data": [], "dtype": "f32" };
  }

  let data = [];
  let i = actual_start;
  while i < actual_end {
    array_push(data, t["data"][i]);
    i = i + 1;
  }

  return map{ "shape": [actual_end - actual_start], "data": data, "dtype": "f32" };
}

// reshape(t, new_shape) → new tensor with given shape if sizes match
fn reshape(t, new_shape) {
	let old_size = _shape_size(t["shape"]);
	let new_size = _shape_size(new_shape);
	if old_size != new_size {
		return map{ "error": "reshape: size mismatch, old size " + str(old_size) + " != new size " + str(new_size) };
	}
	return map{ "shape": new_shape, "data": t["data"], "dtype": "f32" };
}

// dot(a, b) → matrix product [m×k] × [k×n] → [m×n] or vector dot product [n] × [n] → [1]
// Supports 1D tensors (vectors) and 2D tensors (matrices). Returns error if dimensions incompatible.
//
// Uses native Rust fast paths (tensor_dot, tensor_matmul) when available, falling back
// to the interpreter loops below. Fast paths are typically 10-100x faster on large shapes.
fn dot(a, b) {
  let shape_a = a["shape"];
  let shape_b = b["shape"];
  let dim_a = len(shape_a);
  let dim_b = len(shape_b);

  // Handle 1D × 1D (vector dot product)
  if dim_a == 1 and dim_b == 1 {
    let n1 = shape_a[0];
    let n2 = shape_b[0];
    if n1 != n2 {
      return map{ "error": "dot: vector dimensions must match, got [" + str(n1) + "] × [" + str(n2) + "]" };
    }
    let scalar = try tensor_dot(a, b) catch nil;
    if scalar != nil {
      return map{ "shape": [1], "data": [scalar], "dtype": "f32" };
    }
    let sum = 0.0;
    let i = 0;
    while i < n1 {
      sum = sum + a["data"][i] * b["data"][i];
      i = i + 1;
    }
    return map{ "shape": [1], "data": [sum], "dtype": "f32" };
  }

  // Handle 2D × 2D (matrix multiplication)
  if dim_a != 2 {
    return map{ "error": "dot: first argument must be 1D or 2D tensor, got " + str(dim_a) + "D" };
  }
  if dim_b != 2 {
    return map{ "error": "dot: second argument must be 1D or 2D tensor, got " + str(dim_b) + "D" };
  }
  let m = shape_a[0];
  let k1 = shape_a[1];
  let k2 = shape_b[0];
  let n = shape_b[1];
  if k1 != k2 {
    return map{ "error": "dot: incompatible dimensions, [" + str(m) + "×" + str(k1) + "] × [" + str(k2) + "×" + str(n) + "]" };
  }
  let fast = try tensor_matmul(a, b) catch nil;
  if fast != nil { return fast; }
  let k = k1;
  let data = [];
  let i = 0;
  while i < m {
    let j = 0;
    while j < n {
      let sum = 0.0;
      let p = 0;
      while p < k {
        let a_val = a["data"][i * k + p];
        let b_val = b["data"][p * n + j];
        sum = sum + a_val * b_val;
        p = p + 1;
      }
      array_push(data, sum);
      j = j + 1;
    }
    i = i + 1;
  }
  return map{ "shape": [m, n], "data": data, "dtype": "f32" };
}

// Helper: compute product of shape dimensions
fn _shape_size(shape) {
  let size = 1;
  let i = 0;
  while i < len(shape) {
    size = size * shape[i];
    i = i + 1;
  }
  return size;
}

// Helper: compute flat index from multi-dimensional indices (row-major order)
fn _flat_index(shape, indices) {
  let idx = 0;
  let stride = 1;
  let i = len(shape) - 1;
  while i >= 0 {
    idx = idx + indices[i] * stride;
    stride = stride * shape[i];
    i = i - 1;
  }
  return idx;
}

// Elementwise add(a, b): both tensors must have the same shape.
fn add(a, b) {
  let r = try tensor_add(a, b) catch nil;
  if r != nil { return r; }
  let sa = a["shape"];
  let sb = b["shape"];
  if len(sa) != len(sb) { return map{ "error": "tensor.add: rank mismatch" }; }
  let i = 0;
  while i < len(sa) {
    if sa[i] != sb[i] { return map{ "error": "tensor.add: shape mismatch" }; }
    i = i + 1;
  }
  let data = [];
  let j = 0;
  while j < len(a["data"]) {
    array_push(data, a["data"][j] + b["data"][j]);
    j = j + 1;
  }
  return map{ "shape": sa, "data": data, "dtype": "f32" };
}

// Elementwise subtract(a, b).
fn sub(a, b) {
  let r = try tensor_sub(a, b) catch nil;
  if r != nil { return r; }
  return map{ "error": "tensor.sub: native path unavailable" };
}

// Elementwise multiply(a, b).
fn mul(a, b) {
  let r = try tensor_mul(a, b) catch nil;
  if r != nil { return r; }
  return map{ "error": "tensor.mul: native path unavailable" };
}

// Scalar multiply: scale(t, k).
fn scale(t, k) {
  let r = try tensor_scale(t, k) catch nil;
  if r != nil { return r; }
  let data = [];
  let i = 0;
  while i < len(t["data"]) {
    array_push(data, t["data"][i] * k);
    i = i + 1;
  }
  return map{ "shape": t["shape"], "data": data, "dtype": "f32" };
}

// Activation functions for neural nets.
fn relu(t)    { return tensor_relu(t); }
fn sigmoid(t) { return tensor_sigmoid(t); }
fn tanh_(t)   { return tensor_tanh(t); }
fn softmax(t) { return tensor_softmax(t); }
fn gelu(t)    { return tensor_gelu(t); }
// leaky_relu(t) uses default slope 0.01; leaky_relu_a(t, slope) is the explicit form.
fn leaky_relu(t)            { return tensor_leaky_relu(t); }
fn leaky_relu_a(t, slope)   { return tensor_leaky_relu(t, slope); }
fn log_softmax(t)           { return tensor_log_softmax(t); }

// Normalization. layer_norm uses eps=1e-5 by default; layer_norm_e(t,eps) for custom.
fn layer_norm(t)            { return tensor_layer_norm(t); }
fn layer_norm_e(t, eps)     { return tensor_layer_norm(t, eps); }
fn batch_norm(t)            { return tensor_batch_norm(t); }
fn batch_norm_e(t, eps)     { return tensor_batch_norm(t, eps); }

// Convolutional / pooling primitives (4D NCHW tensors).
// conv2d(x, kernel) — stride=1, padding=0 by default; *_sp variants take strides/padding.
fn conv2d(x, kernel)                  { return tensor_conv2d(x, kernel); }
fn conv2d_s(x, kernel, stride)        { return tensor_conv2d(x, kernel, stride); }
fn conv2d_sp(x, kernel, stride, pad)  { return tensor_conv2d(x, kernel, stride, pad); }
fn maxpool2d(x, k)                    { return tensor_maxpool2d(x, k); }
fn maxpool2d_s(x, k, stride)          { return tensor_maxpool2d(x, k, stride); }
fn avgpool2d(x, k)                    { return tensor_avgpool2d(x, k); }
fn avgpool2d_s(x, k, stride)          { return tensor_avgpool2d(x, k, stride); }

// Embedding lookup: table[V,D] + indices[N] -> tensor[N,D].
fn embedding_lookup(table, idx) { return tensor_embedding_lookup(table, idx); }

// Losses.
fn cross_entropy(logits, targets) { return tensor_cross_entropy(logits, targets); }

// Reductions and shape ops.
fn sum_all(t)   { return tensor_sum(t); }
fn mean(t)      { return tensor_mean(t); }
fn argmax(t)    { return tensor_argmax(t); }
fn transpose(t) { return tensor_transpose2d(t); }

export tensor, zeros, ones, get, set, shape, dtype, to_request_body, slice, reshape, dot,
       add, sub, mul, scale,
       relu, sigmoid, tanh_, softmax, gelu, leaky_relu, leaky_relu_a, log_softmax,
       layer_norm, layer_norm_e, batch_norm, batch_norm_e,
       conv2d, conv2d_s, conv2d_sp, maxpool2d, maxpool2d_s, avgpool2d, avgpool2d_s,
       embedding_lookup, cross_entropy,
       sum_all, mean, argmax, transpose;
