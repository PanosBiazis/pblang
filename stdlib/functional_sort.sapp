// Additive stable ordering; legacy functional.sort_by retains its callback trace.
// Limits bound this algorithm, not callback work or borrowed payload sizes.
// See docs/FUNCTIONAL_SORT.md for the comparator and reference contract.
fn stable_sort_by(arr,cmp) {
    if type(arr) != "array" { throw "stable_sort_by: expected an array"; }
    let n=len(arr);
    if n>4096 { throw "stable_sort_by: at most 4096 elements"; }
    let source=slice(arr,0,n);
    if n<2 { return source; }
    let target=slice(arr,0,n);
    let width=1;
    while width<n {
        let start=0;
        while start<n {
            let middle=start+width;
            if middle>n {middle=n;}
            let end=start+width+width;
            if end>n {end=n;}
            let left=start;
            let right=middle;
            let out=start;
            while left<middle and right<end {
                let order=cmp(source[left],source[right]);
                if type(order)!="number" {throw "stable_sort_by: comparator must return a finite number";}
                if order*0!=0 {throw "stable_sort_by: comparator must return a finite number";}
                if order<=0 {
                    target[out]=source[left]; left=left+1;
                } else {
                    target[out]=source[right]; right=right+1;
                }
                out=out+1;
            }
            while left<middle {target[out]=source[left];left=left+1;out=out+1;}
            while right<end {target[out]=source[right];right=right+1;out=out+1;}
            start=end;
        }
        let previous=source; source=target; target=previous;
        width=width*2;
    }
    return source;
}

// Capture source slots before user projection callbacks can mutate the input.
// All keys are evaluated once in source order, before the first comparison.
fn _keyed_order(arr, keyfn, cmp) {
    if type(arr) != "array" { throw "stable key sort: expected an array"; }
    let n = len(arr);
    if n > 4096 { throw "stable key sort: at most 4096 elements"; }
    let values = slice(arr, 0, n);
    let entries = [];
    let i = 0;
    while i < n {
        let value = values[i];
        let key = keyfn(value);
        push(entries, map{key: key, value: value, index: i});
        i = i + 1;
    }
    return stable_sort_by(entries, fn(a,b) { return cmp(a.key,b.key); });
}

fn stable_sort_by_key(arr, keyfn, cmp) {
    let entries = _keyed_order(arr, keyfn, cmp);
    let out = [];
    for entry in entries { push(out, entry.value); }
    return out;
}

// Indices refer to the input slot snapshot at entry, even if a callback mutates arr.
fn stable_argsort_by_key(arr, keyfn, cmp) {
    let entries = _keyed_order(arr, keyfn, cmp);
    let out = [];
    for entry in entries { push(out, entry.index); }
    return out;
}

export stable_sort_by, stable_sort_by_key, stable_argsort_by_key;
