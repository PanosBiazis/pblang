// stdlib/graphics.sapp — High-level graphics API: native builtins (minifb) + event loop helpers

let _font = import("stdlib:bitmap_font.sapp");

// === Colors ===
let BLACK   = [0, 0, 0];
let WHITE   = [255, 255, 255];
let RED     = [255, 0, 0];
let GREEN   = [0, 255, 0];
let BLUE    = [0, 0, 255];
let YELLOW  = [255, 255, 0];
let CYAN    = [0, 255, 255];
let MAGENTA = [255, 0, 255];
let GRAY    = [128, 128, 128];
let ORANGE  = [255, 165, 0];
let PURPLE  = [128, 0, 128];
let LIME    = [0, 255, 0];
let NAVY    = [0, 0, 128];
let TEAL    = [0, 128, 128];
let SILVER  = [192, 192, 192];
let MAROON  = [128, 0, 0];
let OLIVE   = [128, 128, 0];

fn rgb(r, g, b) {
    return [r, g, b, 255];
}

fn rgba(r, g, b, a) {
    return [r, g, b, a];
}

// Grayscale: gray(0..255) -> [l, l, l, 255]
fn gray(l) {
    return [l, l, l, 255];
}

// HSL to RGB: h 0..360, s 0..1, l 0..1 -> [r,g,b,255]
fn hsl(h, s, l) {
    if s == 0 {
        let v = l * 255;
        if v < 0 { return [0, 0, 0, 255]; }
        if v > 255 { return [255, 255, 255, 255]; }
        return [v, v, v, 255];
    }
    let h = h - 360 * num_floor(h / 360);
    let d = 2 * l - 1;
    if d < 0 { d = -d; }
    let c = (1 - d) * s;
    let hp = h / 60;
    let k = num_floor(hp);
    let km = num_mod(hp, 2);
    let t = km - 1;
    if t < 0 { t = -t; }
    let x = c * (1 - t);
    let m = l - c / 2;
    let rp = 0;
    let gp = 0;
    let bp = 0;
    if k == 0 { rp = c; gp = x; bp = 0; }
    if k == 1 { rp = x; gp = c; bp = 0; }
    if k == 2 { rp = 0; gp = c; bp = x; }
    if k == 3 { rp = 0; gp = x; bp = c; }
    if k == 4 { rp = x; gp = 0; bp = c; }
    if k == 5 { rp = c; gp = 0; bp = x; }
    let r = (rp + m) * 255;
    let g = (gp + m) * 255;
    let b = (bp + m) * 255;
    if r < 0 { r = 0; }
    if r > 255 { r = 255; }
    if g < 0 { g = 0; }
    if g > 255 { g = 255; }
    if b < 0 { b = 0; }
    if b > 255 { b = 255; }
    return [r, g, b, 255];
}

// Linear interpolation between two colors; t in 0..1. Colors as [r,g,b] or [r,g,b,a].
fn lerpColor(c1, c2, t) {
    let a1 = 255;
    if len(c1) >= 4 { a1 = c1[3]; }
    let a2 = 255;
    if len(c2) >= 4 { a2 = c2[3]; }
    let r = c1[0] + (c2[0] - c1[0]) * t;
    let g = c1[1] + (c2[1] - c1[1]) * t;
    let b = c1[2] + (c2[2] - c1[2]) * t;
    let a = a1 + (a2 - a1) * t;
    if r < 0 { r = 0; }
    if r > 255 { r = 255; }
    if g < 0 { g = 0; }
    if g > 255 { g = 255; }
    if b < 0 { b = 0; }
    if b > 255 { b = 255; }
    if a < 0 { a = 0; }
    if a > 255 { a = 255; }
    return [r, g, b, a];
}

// Unit circle (16 points) for circle outline: x and y multipliers for radius 1
let _circle_x = [1, 0.924, 0.707, 0.383, 0, 0 - 0.383, 0 - 0.707, 0 - 0.924, 0 - 1, 0 - 0.924, 0 - 0.707, 0 - 0.383, 0, 0.383, 0.707, 0.924];
let _circle_y = [0, 0.383, 0.707, 0.924, 1, 0.924, 0.707, 0.383, 0, 0 - 0.383, 0 - 0.707, 0 - 0.924, 0 - 1, 0 - 0.924, 0 - 0.707, 0 - 0.383];

fn _circleOutline(handle, cx, cy, r, color) {
    let n = 16;
    let i = 0;
    while i < n {
        let x1 = cx + r * _circle_x[i];
        let y1 = cy + r * _circle_y[i];
        let j = i + 1;
        if j >= n { j = 0; }
        let x2 = cx + r * _circle_x[j];
        let y2 = cy + r * _circle_y[j];
        gfxdrawline(handle, x1, y1, x2, y2, color);
        i = i + 1;
    }
}

fn _segment_count(segments) {
    let n = segments;
    if n == nil { n = 24; }
    if n < 1 { n = 1; }
    if n > 512 { n = 512; }
    return n;
}

fn bezier_point(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
    if t < 0 { t = 0; }
    if t > 1 { t = 1; }
    let u = 1 - t;
    let uu = u * u;
    let tt = t * t;
    let uuu = uu * u;
    let ttt = tt * t;
    let x = uuu * x0 + 3 * uu * t * cx1 + 3 * u * tt * cx2 + ttt * x1;
    let y = uuu * y0 + 3 * uu * t * cy1 + 3 * u * tt * cy2 + ttt * y1;
    return [x, y];
}

fn bezier_points(x0, y0, cx1, cy1, cx2, cy2, x1, y1, segments) {
    let n = _segment_count(segments);
    let out = [];
    let i = 0;
    while i <= n {
        let t = i / n;
        array_push(out, bezier_point(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t));
        i = i + 1;
    }
    return out;
}

fn draw_polyline(handle, points, color) {
    let drawn = 0;
    let i = 1;
    while i < len(points) {
        gfxdrawline(handle, points[i - 1][0], points[i - 1][1], points[i][0], points[i][1], color);
        drawn = drawn + 1;
        i = i + 1;
    }
    return drawn;
}

fn polygon(handle, points, color) {
    let drawn = draw_polyline(handle, points, color);
    if len(points) > 2 {
        gfxdrawline(handle, points[len(points) - 1][0], points[len(points) - 1][1], points[0][0], points[0][1], color);
        drawn = drawn + 1;
    }
    return drawn;
}

fn bezier(handle, x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments) {
    let pts = bezier_points(x0, y0, cx1, cy1, cx2, cy2, x1, y1, segments);
    draw_polyline(handle, pts, color);
    return pts;
}

fn draw_text(handle, x, y, text, color) {
    return _font.draw_text(fn(px, py, c) { gfxdrawpoint(handle, px, py, c); }, x, y, text, color);
}

fn text_font_candidates() {
    return [
        // Standard readable UI Sans fonts first. Code editors can still force
        // monospace with PBIDE_FONT/PBLANG_FONT when fixed advance matters.
        "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        "/usr/share/fonts/truetype/freefont/FreeSans.ttf",
        "/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf",
        "/usr/share/fonts/opentype/cantarell/Cantarell-Regular.otf",
        "/usr/share/fonts/truetype/inter/Inter-Regular.ttf",
        "/System/Library/Fonts/SFNS.ttf",
        "/System/Library/Fonts/Helvetica.ttc",
        "/System/Library/Fonts/Arial.ttf",
        "C:/Windows/Fonts/segoeui.ttf",
        "C:/Windows/Fonts/calibri.ttf",
        "C:/Windows/Fonts/arial.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf"
    ];
}

fn _first_existing_font(paths) {
    let i = 0;
    while i < len(paths) {
        let p = str(paths[i]);
        let ok = try fs_exists(p) catch false;
        if ok { return p; }
        i = i + 1;
    }
    return "";
}

fn _text_font_path() {
    let p = try env_get("PBIDE_FONT") catch nil;
    if p != nil and str(p) != "" { return str(p); }
    p = try env_get("PBLANG_FONT") catch nil;
    if p != nil and str(p) != "" { return str(p); }
    return _first_existing_font(text_font_candidates());
}

let TEXT_FONT_PATH = _text_font_path();

fn text_font_path() {
    return TEXT_FONT_PATH;
}

fn draw_text_aa(handle, x, y, text, color, px, advance) {
    return gfxdrawtextaa(handle, x, y, str(text), color, px, TEXT_FONT_PATH, advance);
}

fn draw_rects(handle, rects, color) {
    return gfxdrawrects(handle, rects, color);
}

fn text_profile() {
    return try gfxtextprofile() catch map{
        format: "pblang.graphics.text.profile.v1",
        renderer: "bitmap-font",
        fallback: "bitmap-font",
        antialias: false,
        available: false,
        font: "",
        font_cache_size: 0,
        font_cache_hits: 0,
        font_cache_loads: 0,
        glyph_cache_size: 0,
        glyph_cache_hits: 0,
        glyph_cache_loads: 0
    };
}

fn text_render_plan(profile = nil, metrics = nil, options = nil) {
    if profile == nil { profile = text_profile(); }
    if metrics == nil { metrics = map{}; }
    if options == nil { options = map{}; }
    let mode = str_lower(str(try options.mode catch "auto"));
    let target_fps = try options.target_fps catch 60;
    if target_fps <= 0 { target_fps = 60; }
    let budget_ms = try options.budget_ms catch (1000 / target_fps);
    let avg_ms = try metrics.avg_draw_ms catch try metrics.draw_ms catch 0;
    let text_calls = try metrics.text_calls catch try metrics.command_count catch 0;
    let shape_cache = try options.shape_cache catch try metrics.shape_cache catch 0;
    let renderer = str(try profile.renderer catch "bitmap-font");
    let available = try profile.available catch false;
    let antialias = try profile.antialias catch false;
    let font_cache_size = try profile.font_cache_size catch 0;
    let font_cache_hits = try profile.font_cache_hits catch 0;
    let font_cache_loads = try profile.font_cache_loads catch 0;
    let glyph_cache_size = try profile.glyph_cache_size catch 0;
    let glyph_cache_hits = try profile.glyph_cache_hits catch 0;
    let glyph_cache_loads = try profile.glyph_cache_loads catch 0;
    let decision = "native-aa";
    let reason = "anti-aliased text is available";
    let warnings = [];
    if mode == "bitmap" or mode == "pixel" or mode == "off" {
        decision = "bitmap-forced";
        reason = "bitmap text forced by mode";
    } else if not available or not antialias {
        decision = "bitmap-fallback";
        reason = "native anti-aliased text renderer unavailable";
    } else if avg_ms > budget_ms * 1.5 and text_calls > 180 {
        decision = "bitmap-hot-path";
        reason = "frame is over budget with a high text-call count";
        array_push(warnings, "consider PBIDE_TEXT_RENDER=bitmap on slow/retro machines when text frames remain over budget after cache warmup");
    }
    let cache = "shape-cache";
    if available and antialias { cache = cache + "+native-font-cache+glyph-cache"; }
    return map{
        format: "pblang.graphics.text_render_plan.v1",
        renderer: renderer,
        available: available,
        antialias: antialias,
        requested_mode: mode,
        decision: decision,
        reason: reason,
        target_fps: target_fps,
        budget_ms: budget_ms,
        avg_draw_ms: avg_ms,
        text_calls: text_calls,
        shape_cache: shape_cache,
        font_cache_size: font_cache_size,
        font_cache_hits: font_cache_hits,
        font_cache_loads: font_cache_loads,
        glyph_cache_size: glyph_cache_size,
        glyph_cache_hits: glyph_cache_hits,
        glyph_cache_loads: glyph_cache_loads,
        font_path_cached: TEXT_FONT_PATH != "",
        cache: cache,
        safe_fallback: "bitmap-font",
        warnings: warnings
    };
}

fn text_render_status(plan = nil) {
    let p = plan;
    if p == nil { p = text_render_plan(nil, nil, nil); }
    return "text " + str(try p.decision catch "unknown") +
        " renderer=" + str(try p.renderer catch "?") +
        " avg=" + str(try p.avg_draw_ms catch 0) + "ms" +
        " budget=" + str(try p.budget_ms catch 0) + "ms" +
        " calls=" + str(try p.text_calls catch 0) +
        " shape-cache=" + str(try p.shape_cache catch 0) +
        " font-cache=" + str(try p.font_cache_size catch 0) +
        "/" + str(try p.font_cache_hits catch 0) +
        "/" + str(try p.font_cache_loads catch 0) +
        " glyph-cache=" + str(try p.glyph_cache_size catch 0) +
        "/" + str(try p.glyph_cache_hits catch 0) +
        "/" + str(try p.glyph_cache_loads catch 0);
}

// === Window "object" (handle + methods) ===
fn Window(w, h, title) {
    let handle = gfxcreatewindow(w, h, title);
    let lifetime = map{ closed: false };
    let obj = map{
        "handle": handle,
        "isOpen": fn() { if lifetime.closed { return false; } return gfxisopen(handle); },
        "close": fn() {
            if not lifetime.closed { gfxclose(handle); lifetime.closed = true; }
        },
        "size": fn() { return gfxsize(handle); },
        "clear": fn(color) { gfxclear(handle, color); },
        "rect": fn(x, y, rw, rh, color) { gfxdrawrect(handle, x, y, rw, rh, color); },
        "rects": fn(rects, color) { gfxdrawrects(handle, rects, color); },
        "point": fn(x, y, color) { gfxdrawpoint(handle, x, y, color); },
        "line": fn(x1, y1, x2, y2, color) { gfxdrawline(handle, x1, y1, x2, y2, color); },
        "circle": fn(cx, cy, r, color) { _circleOutline(handle, cx, cy, r, color); },
        "polyline": fn(points, color) { return draw_polyline(handle, points, color); },
        "polygon": fn(points, color) { return polygon(handle, points, color); },
        "bezier": fn(x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments) { return bezier(handle, x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments); },
        "text": fn(x, y, text, color) { return draw_text(handle, x, y, text, color); },
        "textAA": fn(x, y, text, color, px, advance) { return draw_text_aa(handle, x, y, text, color, px, advance); },
        "present": fn() { gfxpresent(handle); },
        "pollEvents": fn() { return gfxpollevents(handle); }
    };
    return obj;
}

// === Main loop: updateFn(state, events), drawFn(state, win); fps = target frames per second ===
fn _env_number(name, fallback) {
    let raw = try env_get(name) catch "";
    if raw == nil or str(raw) == "" { return fallback; }
    let n = try parse_number(str(raw)) catch fallback;
    if n == nil { return fallback; }
    return n;
}

// Frame pacing must not require process-execution authority. recv_timeout is a
// native scheduler wait and an empty retained channel is a bounded, allocation-
// free timer after lazy initialization. Keeping channel construction out of
// module initialization also makes graphics imports side-effect free for the
// self-hosted compiler/preview VM.
let _FRAME_WAIT_CHANNEL = map{};
fn _frame_wait(ms) {
    if ms <= 0 { return; }
    if not map_has(_FRAME_WAIT_CHANNEL, "receiver") { _FRAME_WAIT_CHANNEL = channel(); }
    recv_timeout(_FRAME_WAIT_CHANNEL.receiver, num_floor(ms));
}

fn idle_frame_delay(frame_ms, idle_frames) {
    if type(frame_ms) != "number" or frame_ms <= 0 { return 0; }
    if type(idle_frames) != "number" or idle_frames < 3 { return frame_ms; }
    let delay = frame_ms * 3;
    if delay > 80 { delay = 80; }
    return delay;
}

fn idle_event_pump_due(elapsed_ms, interval_ms = 120) {
    if type(elapsed_ms) != "number" or elapsed_ms < 0 { return false; }
    if type(interval_ms) != "number" or interval_ms < 16 { interval_ms = 16; }
    if interval_ms > 1000 { interval_ms = 1000; }
    return elapsed_ms >= interval_ms;
}

fn window_size_changed(previous, current) {
    if previous == nil or current == nil { return true; }
    let pw = try previous.w catch 0; let ph = try previous.h catch 0;
    let cw = try current.w catch 0; let ch = try current.h catch 0;
    return pw != cw or ph != ch;
}

fn has_resize_event(events) {
    let i = 0;
    while i < len(events) {
        if str(try events[i].type catch "") == "resize" { return true; }
        i = i + 1;
    }
    return false;
}

// Keep one authoritative resize record per frame. Window managers can emit a
// burst while maximizing, and the native backend can also observe a resize
// between event polling and presentation. The live size always wins.
fn coalesce_resize_events(events, live_size, force = false, emit_resize = true) {
    let out = [];
    let saw_resize = false;
    let i = 0;
    while i < len(events) {
        if str(try events[i].type catch "") == "resize" { saw_resize = true; }
        else { array_push(out, events[i]); }
        i = i + 1;
    }
    let w = try live_size.w catch 0; let h = try live_size.h catch 0;
    if emit_resize and (force or saw_resize) and type(w) == "number"
        and type(h) == "number" and w > 0 and h > 0 {
        array_push(out, map{ type: "resize", w: w, h: h });
    }
    return out;
}

// A maximize/restore operation is usually a burst, not one atomic size. Keep
// pumping input but wait for one unchanged poll before drawing into the new
// framebuffer. This avoids presenting the freshly allocated black buffer and
// bounds the delay to one event-loop iteration after geometry becomes stable.
fn resize_settle(previous, current, stable_polls = 0, pending = false,
    required_stable_polls = 1) {
    let w = try current.w catch 0; let h = try current.h catch 0;
    if type(w) != "number" or type(h) != "number" or w <= 0 or h <= 0 {
        return map{ valid: false, target: previous, changed: false,
            pending: pending, ready: false, stable_polls: stable_polls };
    }
    let changed = window_size_changed(previous, current);
    if changed {
        return map{ valid: true, target: map{ w: w, h: h }, changed: true,
            pending: true, ready: false, stable_polls: 0 };
    }
    if not pending {
        return map{ valid: true, target: map{ w: w, h: h }, changed: false,
            pending: false, ready: false, stable_polls: 0 };
    }
    let required = num_floor(required_stable_polls);
    if required < 1 { required = 1; }
    if required > 4 { required = 4; }
    let polls = stable_polls + 1;
    let ready = polls >= required;
    return map{ valid: true, target: map{ w: w, h: h }, changed: false,
        pending: not ready, ready: ready, stable_polls: if ready { 0 } else { polls } };
}

fn run(win, state, updateFn, drawFn, fps) {
    if fps == nil or fps <= 0 { fps = 60; }
    let frameMs = 1000 / fps;
    let started = clock();
    let frame = 0;
    let idleFrames = 0;
    let maxMs = _env_number("PBLANG_GRAPHICS_MAX_MS", 0);
    let maxFrames = _env_number("PBLANG_GRAPHICS_MAX_FRAMES", 0);
    let idlePumpMs = _env_number("PBLANG_GRAPHICS_IDLE_PUMP_MS", 120);
    let knownSize = win.size();
    let pendingResize = false;
    let resizeStablePolls = 0;
    let lastPresent = clock();
    while win.isOpen() {
        if maxMs > 0 and (clock() - started) * 1000 >= maxMs {
            break;
        }
        if maxFrames > 0 and frame >= maxFrames {
            break;
        }
        let t0 = clock();
        let events = win.pollEvents();
        let polledSize = win.size();
        let nativeResize = has_resize_event(events);
        // A backend can report a resize record whose dimensions already match
        // gfxsize. Treat it as the start of a burst, not as an immediately safe
        // present opportunity.
        let settlePrevious = knownSize;
        if nativeResize and not window_size_changed(knownSize, polledSize) {
            settlePrevious = nil;
        }
        let settle = resize_settle(settlePrevious, polledSize,
            resizeStablePolls, pendingResize, 1);
        knownSize = settle.target;
        pendingResize = settle.pending;
        resizeStablePolls = settle.stable_polls;
        let frameResize = settle.ready;
        events = coalesce_resize_events(events, polledSize, frameResize, frameResize);
        let shouldDraw = true;
        if updateFn != nil {
            let updateResult = updateFn(state, events);
            if updateResult == false { shouldDraw = false; }
        }
        // A resize invalidates every framebuffer pixel even when an app's
        // update callback normally skips unchanged frames.
        if frameResize { shouldDraw = true; }
        // While geometry is still moving, process input/close/tick callbacks but
        // retain the compositor's last valid frame instead of drawing or
        // presenting a partially resized framebuffer.
        if pendingResize and not frameResize { shouldDraw = false; }
        // A native close notification can leave a registered window resource.
        // Every normal exit is released below; Window.close is idempotent.
        if try state.graphics_stop catch false { break; }
        let pumpDue = idle_event_pump_due((clock() - lastPresent) * 1000, idlePumpMs);
        let shouldPresent = shouldDraw or pumpDue;
        if shouldDraw and drawFn != nil {
            let drawResult = drawFn(state, win);
            if drawResult == false {
                // minifb pumps OS events through present. A skipped redraw
                // must not starve close/resize/input delivery on idle editors.
                shouldPresent = pumpDue;
            }
        }
        if pendingResize or not settle.valid { shouldPresent = false; }
        // A resize can happen while a large frame is being drawn. gfxsize
        // synchronizes the native buffer; never present that newly allocated,
        // not-yet-drawn buffer as a black frame.
        let drawnSize = win.size();
        if window_size_changed(knownSize, drawnSize) {
            knownSize = drawnSize;
            pendingResize = true;
            resizeStablePolls = 0;
            shouldPresent = false;
        }
        if shouldPresent {
            win.present();
            lastPresent = clock();
            // The final race window is inside present itself. Detect a resize
            // consumed there and force an immediate full redraw next frame.
            let presentedSize = win.size();
            if window_size_changed(knownSize, presentedSize) {
                knownSize = presentedSize;
                pendingResize = true;
                resizeStablePolls = 0;
            }
        }
        if len(events) == 0 and not shouldDraw { idleFrames = idleFrames + 1; }
        else { idleFrames = 0; }
        let elapsedMs = (clock() - t0) * 1000;
        let waitMs = if pendingResize { 0 } else { idle_frame_delay(frameMs, idleFrames) };
        if elapsedMs < waitMs {
            _frame_wait(waitMs - elapsedMs);
        }
        frame = frame + 1;
    }
    win.close();
}

// Legacy alias (no state; updateFn(), drawFn(win))
fn runGameLoop(window, updateFn, drawFn, fps) {
    let state = map{};
    run(window, state, fn(s, events) { if updateFn != nil { updateFn(); } }, fn(s, win) { if drawFn != nil { drawFn(win); } }, fps);
}

fn backend_profile() {
    let requested = try env_get("PBLANG_GFX") catch "";
    if requested == nil { requested = ""; }
    requested = str(requested);
    let software = try env_get("PBLANG_GFX_SOFTWARE") catch "";
    if software == nil { software = ""; }
    software = str(software);
    let native = try gfxbackendprofile() catch nil;
    if native != nil {
        native.text_renderer = try text_profile().renderer catch "bitmap-font";
        native.text_antialias = try text_profile().antialias catch false;
        if (try native.present_copy catch nil) == nil { native.present_copy = "unknown"; }
        if (try native.event_pump catch nil) == nil { native.event_pump = "unknown"; }
        if (try native.rect_fill catch nil) == nil { native.rect_fill = "unknown"; }
        if (try native.event_contract catch nil) == nil { native.event_contract = "pblang.graphics.events.v1"; }
        if (try native.resize_events catch nil) == nil { native.resize_events = true; }
        if (try native.mouse_xy_events catch nil) == nil { native.mouse_xy_events = true; }
        if (try native.scroll_events catch nil) == nil { native.scroll_events = true; }
        if (try native.scroll_event catch nil) == nil { native.scroll_event = "scroll"; }
        if (try native.present_resize_sync catch nil) == nil { native.present_resize_sync = true; }
        if (try native.max_framebuffer_dim catch nil) == nil { native.max_framebuffer_dim = 8192; }
        if (try native.max_framebuffer_pixels catch nil) == nil { native.max_framebuffer_pixels = 8192 * 8192; }
        return native;
    }
    let backend = "minifb";
    let present = "cpu-framebuffer";
    let gpu_present = false;
    let note = "default native framebuffer; pure CPU present path";
    if requested == "sdl2" {
        note = "SDL2 requested, but this runtime cannot confirm the SDL2 compile feature; reporting CPU framebuffer";
    }
    return map{
        format: "pblang.graphics.backend.profile.v1",
        requested: requested,
        backend: backend,
        present: present,
        present_copy: "native-framebuffer",
        event_pump: "native-window-poll",
        rect_fill: "row-slice-fill",
        gpu_present: gpu_present,
        compiled_sdl2: false,
        text_renderer: try text_profile().renderer catch "bitmap-font",
        text_antialias: try text_profile().antialias catch false,
        cpu_raster_ui: true,
        idle_present_skip: true,
        present_resize_sync: true,
        max_framebuffer_dim: 8192,
        max_framebuffer_pixels: 8192 * 8192,
        event_contract: "pblang.graphics.events.v1",
        resize_events: true,
        mouse_xy_events: true,
        scroll_events: true,
        scroll_event: "scroll",
        software_forced: software == "1",
        note: note
    };
}

fn backend_status() {
    let p = backend_profile();
    let gpu = "cpu";
    if try p.gpu_present catch false { gpu = "gpu-present"; }
    return "gfx " + str(try p.backend catch "?") + " " + gpu + " (" + str(try p.present catch "?") + ")";
}

fn backend_event_status() {
    let p = backend_profile();
    let items = [];
    if try p.resize_events catch false { array_push(items, "resize"); }
    if try p.mouse_xy_events catch false { array_push(items, "mouse-xy"); }
    if try p.scroll_events catch false { array_push(items, str(try p.scroll_event catch "scroll")); }
    let body = "none";
    if len(items) > 0 { body = str_join(items, ","); }
    return "events " + str(try p.event_contract catch "unknown") + " [" + body + "] pump=" + str(try p.event_pump catch "unknown");
}

fn render_route_plan(profile = nil) {
    let p = profile;
    if p == nil { p = backend_profile(); }
    let route = "cpu-framebuffer";
    let device = "cpu";
    let present = str(try p.present catch "unknown");
    let notes = [];
    if try p.software_forced catch false {
        route = "software-forced";
        device = "cpu";
        array_push(notes, "software present forced by PBLANG_GFX_SOFTWARE");
    } else if try p.gpu_present catch false {
        route = "cpu-raster-gpu-present";
        device = "cpu+gpu-present";
        array_push(notes, "pblang draws a CPU framebuffer and presents through a GPU-backed surface");
    } else {
        array_push(notes, "portable CPU framebuffer path");
    }
    if try p.idle_present_skip catch false { array_push(notes, "idle frames skip present"); }
    if try p.text_antialias catch false { array_push(notes, "anti-aliased text available"); }
    return map{
        format: "pblang.graphics.render_route.v1",
        backend: str(try p.backend catch "unknown"),
        route: route,
        device: device,
        present: present,
        present_copy: str(try p.present_copy catch "unknown"),
        gpu_present: try p.gpu_present catch false,
        cpu_raster_ui: try p.cpu_raster_ui catch true,
        idle_present_skip: try p.idle_present_skip catch false,
        text_renderer: str(try p.text_renderer catch "bitmap-font"),
        text_antialias: try p.text_antialias catch false,
        notes: notes
    };
}

fn render_route_status(profile = nil) {
    let r = render_route_plan(profile);
    let note = "";
    if len(try r.notes catch []) > 0 { note = " · " + str_join(r.notes, " · "); }
    return "route " + str(r.route) + " device " + str(r.device) + " present " + str(r.present) + " copy " + str(r.present_copy) + note;
}

fn cpu_render_status(profile = nil) {
    let p = profile;
    if p == nil { p = backend_profile(); }
    let route = render_route_plan(p);
    let mode = str(try route.route catch "unknown");
    let health = "ok";
    if mode == "cpu-framebuffer" { health = "cpu framebuffer; sync=" + str(try p.present_resize_sync catch true); }
    else if mode == "cpu-raster-gpu-present" { health = "cpu raster + gpu present"; }
    else if mode == "software-forced" { health = "forced software present"; }
    return "cpu-render " + health +
        " rect-fill=" + str(try p.rect_fill catch "unknown") +
        " max=" + str(try p.max_framebuffer_dim catch "?") +
        " route=" + mode;
}

fn render_acceleration_plan(profile = nil) {
    let p = profile;
    if p == nil { p = backend_profile(); }
    let route = render_route_plan(p);
    let steps = [];
    let env = [];
    if try route.gpu_present catch false {
        array_push(steps, "use SDL2 GPU-present texture upload for final frame");
        array_push(steps, "use row-based ARGB8888 framebuffer copy to avoid per-pixel division/modulo during present");
    } else {
        array_push(steps, "build with --features pblang-graphics/sdl2 and run with PBLANG_GFX=sdl2");
        array_push(env, "PBLANG_GFX=sdl2");
    }
    if try p.software_forced catch false {
        array_push(steps, "unset PBLANG_GFX_SOFTWARE for hardware-present comparison");
        array_push(env, "PBLANG_GFX_SOFTWARE=0");
    }
    array_push(steps, "skip unchanged frames before present");
    array_push(steps, "fill large rectangles with row-slice kernels instead of per-pixel loops");
    array_push(steps, "cache repeated text shaping and rounded chrome geometry in pblang");
    array_push(steps, "use pblang parallel workers for background analysis/precompute, not concurrent UI drawing");
    array_push(steps, "use polyglot/native kernels only behind safe graphics builtins for text, image, or future batch primitives");
    return map{
        format: "pblang.graphics.acceleration.plan.v1",
        route: route.route,
        device: route.device,
        backend: try route.backend catch try p.backend catch "unknown",
        gpu_present: try route.gpu_present catch false,
        cpu_raster_ui: try route.cpu_raster_ui catch true,
        idle_present_skip: try route.idle_present_skip catch false,
        text_renderer: try route.text_renderer catch "bitmap-font",
        rect_fill: try p.rect_fill catch "unknown",
        polyglot_safe_path: "native graphics builtins / future batched draw kernels",
        parallel_safe_path: "background layout, analysis, search, diagnostics, cache precompute",
        env: env,
        steps: steps
    };
}

fn render_device_policy(profile = nil, options = nil) {
    if options == nil { options = map{}; }
    let p = profile;
    if p == nil { p = backend_profile(); }
    let route = render_route_plan(p);
    let accel = render_acceleration_plan(p);
    let target_fps = try options.target_fps catch 60;
    if target_fps == nil or target_fps < 1 { target_fps = 60; }
    let pressure = str(try options.pressure catch "ok");
    let prefer_gpu = try options.prefer_gpu_present catch true;
    let env = map{};
    let steps = [];
    let warnings = [];
    let status = "cpu-portable";
    let launch = "current";
    let recommended_fps = target_fps;
    if pressure == "critical" and recommended_fps > 30 { recommended_fps = 30; }
    elif pressure == "high" and recommended_fps > 45 { recommended_fps = 45; }

    if try p.software_forced catch false {
        status = "software-forced";
        launch = "current-forced-software";
        env["PBLANG_GFX_SOFTWARE"] = "0";
        array_push(steps, "unset PBLANG_GFX_SOFTWARE for hardware-present comparison");
        array_push(warnings, "software rendering is forced; GPU-present is intentionally disabled");
    } elif try route.gpu_present catch false {
        status = "gpu-present-active";
        launch = "current";
        array_push(steps, "keep SDL2 GPU-present active for final texture upload");
        array_push(steps, "keep UI raster on CPU until a true GPU UI renderer is selected");
    } elif prefer_gpu {
        status = "gpu-present-recommended";
        launch = "restart-with-sdl2";
        env["PBLANG_GFX"] = "sdl2";
        env["PBLANG_GFX_SOFTWARE"] = "0";
        array_push(steps, "restart with PBLANG_GFX=sdl2 when the SDL2 backend is compiled");
        array_push(steps, "keep CPU framebuffer fallback for old or headless machines");
        array_push(warnings, "current route has no GPU present; final frame upload may cost more CPU");
    } else {
        array_push(steps, "keep portable CPU framebuffer route");
    }

    array_push(steps, "skip unchanged frames before present");
    array_push(steps, "batch rectangles and cache shaped text before drawing");
    array_push(steps, "use pblang parallel workers for layout/search/cache precompute only");
    array_push(steps, "use polyglot/native kernels only through safe graphics builtins");

    return map{
        format: "pblang.graphics.render_device_policy.v1",
        status: status,
        launch: launch,
        backend: try route.backend catch try p.backend catch "unknown",
        route: route.route,
        device: route.device,
        present: route.present,
        present_copy: route.present_copy,
        gpu_present: try route.gpu_present catch false,
        cpu_raster_ui: try route.cpu_raster_ui catch true,
        gpu_raster_ui: false,
        idle_present_skip: try route.idle_present_skip catch false,
        target_fps: target_fps,
        recommended_fps: recommended_fps,
        pressure: pressure,
        env: env,
        steps: steps,
        warnings: warnings,
        parallel_safe_path: try accel.parallel_safe_path catch "background precompute",
        polyglot_safe_path: try accel.polyglot_safe_path catch "native graphics builtins",
        safe: true,
        portable: true,
        backward_compatible: true,
        summary: "device " + status + " route=" + str(route.route) + " gpu-present=" + str(try route.gpu_present catch false) + " ui-raster=cpu fps=" + str(recommended_fps)
    };
}

fn render_device_policy_status(policy = nil) {
    let p = policy;
    if p == nil { p = render_device_policy(nil, nil); }
    return "device-policy " + str(try p.status catch "unknown") +
        " route=" + str(try p.route catch "?") +
        " gpu-present=" + str(try p.gpu_present catch false) +
        " ui-raster=cpu" +
        " fps=" + str(try p.recommended_fps catch try p.target_fps catch "?") +
        " launch=" + str(try p.launch catch "current");
}

fn _render_startup_mode(mode) {
    let m = str_lower(str(try mode catch "auto"));
    if m == "" { return "auto"; }
    if m == "gpu" or m == "fast" { return "fast"; }
    if m == "cpu" or m == "portable" { return "cpu"; }
    if m == "software" or m == "retro" or m == "safe" { return "retro"; }
    return "auto";
}

fn render_startup_profile(mode = "auto", profile = nil, options = nil) {
    if options == nil { options = map{}; }
    let p = profile;
    if p == nil { p = backend_profile(); }
    let m = _render_startup_mode(mode);
    let pressure = str(try options.pressure catch "ok");
    let target_fps = try options.target_fps catch 60;
    if target_fps == nil or target_fps < 1 { target_fps = 60; }
    let policy = render_device_policy(p, map{ target_fps: target_fps, pressure: pressure, prefer_gpu_present: m != "cpu" and m != "retro" });
    let env = map{
        PBIDE_RENDER_PROFILE: m,
        PBIDE_IDLE_REDRAW_MS: "1000",
        PBIDE_TEXT_RENDER: "auto"
    };
    let notes = [];
    let can_attempt_gpu_build = false;
    let prefer_gpu_present = true;
    if m == "fast" or m == "auto" {
        env["PBLANG_GFX"] = "sdl2";
        env["PBLANG_GFX_SOFTWARE"] = "0";
        env["PBIDE_GPU_BUILD"] = "1";
        can_attempt_gpu_build = not (try p.compiled_sdl2 catch false);
        array_push(notes, "prefer SDL2 GPU-present and keep pblang CPU UI raster fallback");
    } elif m == "cpu" {
        prefer_gpu_present = false;
        env["PBLANG_GFX"] = "minifb";
        env["PBLANG_GFX_SOFTWARE"] = "0";
        env["PBIDE_GPU_BUILD"] = "0";
        env["PBIDE_IDLE_REDRAW_MS"] = "1200";
        array_push(notes, "portable CPU framebuffer path for older systems");
    } else {
        prefer_gpu_present = false;
        env["PBLANG_GFX"] = "minifb";
        env["PBLANG_GFX_SOFTWARE"] = "1";
        env["PBIDE_GPU_BUILD"] = "0";
        env["PBIDE_TEXT_RENDER"] = "bitmap";
        env["PBIDE_IDLE_REDRAW_MS"] = "1800";
        env["PBIDE_WINDOW_PROBE"] = "0";
        array_push(notes, "retro/diagnostic software path with bitmap text and low idle redraw");
    }
    array_push(notes, "input events remain immediate; background workers are for cache/precompute only");
    return map{
        format: "pblang.graphics.render_startup_profile.v1",
        mode: m,
        env: env,
        target_fps: target_fps,
        recommended_fps: try policy.recommended_fps catch target_fps,
        prefer_gpu_present: prefer_gpu_present,
        can_attempt_gpu_build: can_attempt_gpu_build,
        device_policy: policy,
        notes: notes,
        safe: true,
        portable: true,
        backward_compatible: true,
        summary: "startup " + m + " -> " + str(try policy.status catch "unknown") + " fps=" + str(try policy.recommended_fps catch target_fps)
    };
}

fn render_startup_env_lines(startup) {
    let s = try startup catch render_startup_profile("auto", nil, nil);
    let env = try s.env catch map{};
    let order = ["PBIDE_RENDER_PROFILE", "PBIDE_GPU_BUILD", "PBLANG_GFX", "PBLANG_GFX_SOFTWARE", "PBIDE_TEXT_RENDER", "PBIDE_IDLE_REDRAW_MS", "PBIDE_WINDOW_PROBE"];
    let lines = [];
    let i = 0;
    while i < len(order) {
        let k = order[i];
        if map_has(env, k) { array_push(lines, k + "=" + str(env[k])); }
        i = i + 1;
    }
    return lines;
}

fn render_startup_profile_status(startup = nil) {
    let s = startup;
    if s == nil { s = render_startup_profile("auto", nil, nil); }
    return str(try s.summary catch "startup unknown") +
        " env=[" + str_join(render_startup_env_lines(s), " ") + "]";
}

fn _frame_w(frame) { return try frame.w catch try frame[0] catch 0; }
fn _frame_h(frame) { return try frame.h catch try frame[1] catch 0; }

fn _rect_x(r) { return try r.x catch try r[0] catch 0; }
fn _rect_y(r) { return try r.y catch try r[1] catch 0; }
fn _rect_w(r) { return try r.w catch try r[2] catch 0; }
fn _rect_h(r) { return try r.h catch try r[3] catch 0; }

fn _clamp_rect_to_frame(r, fw, fh) {
    let x0 = _rect_x(r);
    let y0 = _rect_y(r);
    let x1 = x0 + _rect_w(r);
    let y1 = y0 + _rect_h(r);
    if x0 < 0 { x0 = 0; }
    if y0 < 0 { y0 = 0; }
    if x1 > fw { x1 = fw; }
    if y1 > fh { y1 = fh; }
    if x1 <= x0 or y1 <= y0 { return nil; }
    return map{ x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
}

fn dirty_region_plan(frame, rects, tile_size = 96, max_tiles = 4096) {
    let fw = _frame_w(frame);
    let fh = _frame_h(frame);
    if tile_size == nil or tile_size < 8 { tile_size = 96; }
    if tile_size > 512 { tile_size = 512; }
    if max_tiles == nil or max_tiles < 1 { max_tiles = 4096; }
    let tiles = [];
    let tile_seen = map{};
    let dirty_rects = [];
    let dirty_area = 0;
    let ri = 0;
    while rects != nil and ri < len(rects) and len(tiles) < max_tiles {
        let cr = _clamp_rect_to_frame(rects[ri], fw, fh);
        if cr != nil {
            array_push(dirty_rects, cr);
            dirty_area = dirty_area + cr.w * cr.h;
            let tx0 = num_floor(cr.x / tile_size);
            let ty0 = num_floor(cr.y / tile_size);
            let tx1 = num_floor((cr.x + cr.w - 1) / tile_size);
            let ty1 = num_floor((cr.y + cr.h - 1) / tile_size);
            let ty = ty0;
            while ty <= ty1 and len(tiles) < max_tiles {
                let tx = tx0;
                while tx <= tx1 and len(tiles) < max_tiles {
                    let key = str(tx) + ":" + str(ty);
                    if not (try tile_seen[key] catch false) {
                        tile_seen[key] = true;
                        let tw = tile_size;
                        let th = tile_size;
                        let x = tx * tile_size;
                        let y = ty * tile_size;
                        if x + tw > fw { tw = fw - x; }
                        if y + th > fh { th = fh - y; }
                        if tw > 0 and th > 0 { array_push(tiles, map{ x: x, y: y, w: tw, h: th }); }
                    }
                    tx = tx + 1;
                }
                ty = ty + 1;
            }
        }
        ri = ri + 1;
    }
    let frame_area = fw * fh;
    let tile_area = 0;
    let ti = 0;
    while ti < len(tiles) {
        tile_area = tile_area + tiles[ti].w * tiles[ti].h;
        ti = ti + 1;
    }
    let coverage = 0;
    if frame_area > 0 { coverage = tile_area * 100 / frame_area; }
    let mode = "partial";
    if len(dirty_rects) == 0 { mode = "skip-present"; }
    else if coverage >= 70 or len(tiles) >= max_tiles { mode = "full-frame"; }
    return map{
        format: "pblang.graphics.dirty_region_plan.v1",
        frame: map{ w: fw, h: fh },
        tile_size: tile_size,
        input_rects: if rects == nil { 0 } else { len(rects) },
        dirty_rects: dirty_rects,
        dirty_rect_count: len(dirty_rects),
        tiles: tiles,
        tile_count: len(tiles),
        dirty_area: dirty_area,
        tile_area: tile_area,
        coverage_percent: coverage,
        mode: mode,
        capped: rects != nil and len(tiles) >= max_tiles and ri < len(rects)
    };
}

fn render_batch_plan(commands, options = nil) {
    if options == nil { options = map{}; }
    let rect_ops = 0;
    let text_ops = 0;
    let line_ops = 0;
    let image_ops = 0;
    let other_ops = 0;
    let fill_area = 0;
    let i = 0;
    while commands != nil and i < len(commands) {
        let c = commands[i];
        let op = str(try c.op catch "");
        if op == "box" or op == "fill_rect" or op == "rect" {
            rect_ops = rect_ops + 1;
            fill_area = fill_area + (try c.w catch 0) * (try c.h catch 0);
        } else if op == "text" {
            text_ops = text_ops + 1;
        } else if op == "line" {
            line_ops = line_ops + 1;
        } else if op == "image" or op == "bitmap" {
            image_ops = image_ops + 1;
        } else {
            other_ops = other_ops + 1;
        }
        i = i + 1;
    }
    let weight = rect_ops + text_ops * 3 + line_ops * 2 + image_ops * 8 + other_ops * 2 + num_floor(fill_area / 8192);
    let strategy = "direct";
    if rect_ops >= 2 { strategy = "batched-rects"; }
    if text_ops > 64 { strategy = "batched-rects-text-cache"; }
    if image_ops > 0 { strategy = "batched-rects-text-cache-image-cache"; }
    return map{
        format: "pblang.graphics.render_batch_plan.v1",
        command_count: if commands == nil { 0 } else { len(commands) },
        rect_ops: rect_ops,
        text_ops: text_ops,
        line_ops: line_ops,
        image_ops: image_ops,
        other_ops: other_ops,
        fill_area: fill_area,
        weight: weight,
        strategy: strategy,
        native_rect_batch: rect_ops >= 2,
        text_cache_recommended: text_ops > 0,
        image_cache_recommended: image_ops > 0
    };
}

fn frame_schedule(profile, frame, dirty_rects, commands, options = nil) {
    if options == nil { options = map{}; }
    let p = profile;
    if p == nil { p = backend_profile(); }
    let route = render_route_plan(p);
    let dirty = dirty_region_plan(frame, dirty_rects, try options.tile_size catch 96, try options.max_tiles catch 4096);
    let batch = render_batch_plan(commands, options);
    let target_fps = try options.target_fps catch 60;
    if target_fps == nil or target_fps < 1 { target_fps = 60; }
    let budget_ms = 1000 / target_fps;
    let perf = try options.perf catch map{};
    let avg_draw_ms = try perf.avg_draw_ms catch try options.avg_draw_ms catch 0;
    let last_draw_ms = try perf.last_draw_ms catch try options.last_draw_ms catch 0;
    let skipped_frames = try perf.skips catch try options.skips catch 0;
    if avg_draw_ms == nil { avg_draw_ms = 0; }
    if last_draw_ms == nil { last_draw_ms = 0; }
    if skipped_frames == nil { skipped_frames = 0; }
    let parallel_prepare = batch.weight > 80 or batch.text_ops > 64 or batch.image_ops > 0;
    if try options.parallel catch false { parallel_prepare = true; }
    let present = "skip";
    if dirty.mode == "full-frame" { present = "full-frame-present"; }
    else if dirty.mode == "partial" { present = "dirty-region-present"; }
    if route.gpu_present and present != "skip" { present = present + "-gpu"; }
    let lanes = [];
    if parallel_prepare { array_push(lanes, "parallel layout/text-shape/cache precompute"); }
    if batch.native_rect_batch { array_push(lanes, "native gfxdrawrects rectangle batch"); }
    if batch.text_cache_recommended { array_push(lanes, "text shaping/cache lane"); }
    if batch.image_cache_recommended { array_push(lanes, "image decode/cache lane"); }
    if len(lanes) == 0 { array_push(lanes, "single-thread immediate draw"); }
    let warnings = [];
    if not route.gpu_present { array_push(warnings, "GPU-present unavailable: build/run SDL2 backend for hardware-present path"); }
    if dirty.mode == "full-frame" { array_push(warnings, "dirty coverage is high; full-frame redraw is cheaper than many tiny regions"); }
    let pressure = "ok";
    let adaptive_action = "steady";
    if avg_draw_ms > budget_ms * 2 {
        pressure = "critical";
        adaptive_action = "reduce-text-cost-and-skip-idle";
        array_push(warnings, "average draw time is over 2x frame budget; prefer cached text and fewer live panels");
    } else if avg_draw_ms > budget_ms {
        pressure = "over-budget";
        adaptive_action = "skip-idle-more";
        array_push(warnings, "average draw time exceeds target frame budget");
    } else if last_draw_ms > budget_ms * 2 {
        pressure = "spike";
        adaptive_action = "watch-draw-spikes";
    }
    if dirty.mode == "partial" and dirty.tile_count > 192 {
        adaptive_action = "prefer-full-frame";
        array_push(warnings, "many dirty tiles; full-frame present may be cheaper");
    }
    let recommended_fps = target_fps;
    if pressure == "critical" and target_fps > 30 { recommended_fps = 30; }
    else if pressure == "over-budget" and target_fps > 45 { recommended_fps = 45; }
    return map{
        format: "pblang.graphics.frame_schedule.v1",
        route: route,
        dirty: dirty,
        batch: batch,
        target_fps: target_fps,
        budget_ms: budget_ms,
        present: present,
        parallel_prepare: parallel_prepare,
        adaptive: map{
            format: "pblang.graphics.frame_adaptive.v1",
            pressure: pressure,
            action: adaptive_action,
            avg_draw_ms: avg_draw_ms,
            last_draw_ms: last_draw_ms,
            skipped_frames: skipped_frames,
            budget_ms: budget_ms,
            target_fps: target_fps,
            recommended_fps: recommended_fps,
            gpu_present: route.gpu_present
        },
        lanes: lanes,
        warnings: warnings,
        safe: true,
        portable: true,
        backward_compatible: true,
        policy: "pblang rasterizes visible UI; skip unchanged frames; batch rects; precompute heavy layout/text/image work safely"
    };
}

fn frame_schedule_status(schedule) {
    let s = schedule;
    return "frame " + str(try s.present catch "unknown") +
        " route=" + str(try s.route.route catch "?") +
        " dirty=" + str(try s.dirty.mode catch "?") +
        " tiles=" + str(try s.dirty.tile_count catch 0) +
        " batch=" + str(try s.batch.strategy catch "?") +
        " weight=" + str(try s.batch.weight catch 0) +
        " pressure=" + str(try s.adaptive.pressure catch "ok") +
        " action=" + str(try s.adaptive.action catch "steady");
}

export BLACK, WHITE, RED, GREEN, BLUE, YELLOW, CYAN, MAGENTA, GRAY, ORANGE, PURPLE, LIME, NAVY, TEAL, SILVER, MAROON, OLIVE;
// ── Pure geometry / collision helpers (points are [x, y]) ──────────────────────
fn distance(p1, p2) {
    let dx = p1[0] - p2[0];
    let dy = p1[1] - p2[1];
    return num_sqrt(dx * dx + dy * dy);
}
fn lerp_point(p1, p2, t) {
    return [p1[0] + (p2[0] - p1[0]) * t, p1[1] + (p2[1] - p1[1]) * t];
}
// point_in_rect(px,py, rx,ry,rw,rh) — half-open [rx, rx+rw) x [ry, ry+rh).
fn point_in_rect(px, py, rx, ry, rw, rh) {
    return px >= rx and px < rx + rw and py >= ry and py < ry + rh;
}
fn point_in_circle(px, py, cx, cy, r) {
    let dx = px - cx;
    let dy = py - cy;
    return dx * dx + dy * dy <= r * r;
}
// rect_intersect(ax,ay,aw,ah, bx,by,bw,bh) — axis-aligned bounding-box overlap.
fn rect_intersect(ax, ay, aw, ah, bx, by, bw, bh) {
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by;
}

// ── wave 2: scalar + polygon + rect-bbox helpers ─────────────────────────────────
fn clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }
fn lerp(a, b, t) { return a + (b - a) * t; }
// manhattan(p1, p2) — L1 distance between [x,y] points.
fn manhattan(p1, p2) { return num_abs(p1[0] - p2[0]) + num_abs(p1[1] - p2[1]); }
// rect_center(rx,ry,rw,rh) — [cx, cy].
fn rect_center(rx, ry, rw, rh) { return [rx + rw / 2, ry + rh / 2]; }
// rect_union(...) — smallest bounding box [x,y,w,h] covering both rects.
fn rect_union(ax, ay, aw, ah, bx, by, bw, bh) {
    let x0 = num_min(ax, bx);
    let y0 = num_min(ay, by);
    let x1 = num_max(ax + aw, bx + bw);
    let y1 = num_max(ay + ah, by + bh);
    return [x0, y0, x1 - x0, y1 - y0];
}
// point_in_polygon(px,py, poly) — ray-casting test; poly is an array of [x,y] vertices.
fn point_in_polygon(px, py, poly) {
    let inside = false;
    let n = len(poly);
    let i = 0;
    let j = n - 1;
    while i < n {
        let xi = poly[i][0]; let yi = poly[i][1];
        let xj = poly[j][0]; let yj = poly[j][1];
        if (yi > py) != (yj > py) {
            let xcross = (xj - xi) * (py - yi) / (yj - yi) + xi;
            if px < xcross { inside = not inside; }
        }
        j = i;
        i = i + 1;
    }
    return inside;
}

export clamp, lerp, manhattan, rect_center, rect_union, point_in_polygon;
export distance, lerp_point, point_in_rect, point_in_circle, rect_intersect;
export rgb, rgba, gray, hsl, lerpColor;
export bezier_point, bezier_points, draw_polyline, polygon, bezier, draw_text, draw_rects;
export draw_text_aa, text_font_candidates, text_font_path, text_profile, text_render_plan, text_render_status;
export Window, run, runGameLoop, backend_profile, backend_status, backend_event_status, render_route_plan, render_route_status, cpu_render_status, render_acceleration_plan, render_device_policy, render_device_policy_status, render_startup_profile, render_startup_env_lines, render_startup_profile_status;
export dirty_region_plan, render_batch_plan, frame_schedule, frame_schedule_status,
       idle_frame_delay, idle_event_pump_due, window_size_changed, coalesce_resize_events,
       resize_settle;
