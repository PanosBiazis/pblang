// stdlib/graphics.sapp — High-level graphics API: native builtins (minifb) + event loop helpers

let _font = import("stdlib:bitmap_font.sapp");

// === Colors ===
let BLACK   = [0, 0, 0];
let WHITE   = [255, 255, 255];
let RED     = [255, 0, 0];
let GREEN   = [0, 255, 0];
let BLUE    = [0, 0, 255];
let YELLOW  = [255, 255, 0];
let CYAN    = [0, 255, 255];
let MAGENTA = [255, 0, 255];
let GRAY    = [128, 128, 128];
let ORANGE  = [255, 165, 0];
let PURPLE  = [128, 0, 128];
let LIME    = [0, 255, 0];
let NAVY    = [0, 0, 128];
let TEAL    = [0, 128, 128];
let SILVER  = [192, 192, 192];
let MAROON  = [128, 0, 0];
let OLIVE   = [128, 128, 0];

fn rgb(r, g, b) {
    return [r, g, b, 255];
}

fn rgba(r, g, b, a) {
    return [r, g, b, a];
}

// Grayscale: gray(0..255) -> [l, l, l, 255]
fn gray(l) {
    return [l, l, l, 255];
}

// HSL to RGB: h 0..360, s 0..1, l 0..1 -> [r,g,b,255]
fn hsl(h, s, l) {
    if s == 0 {
        let v = l * 255;
        if v < 0 { return [0, 0, 0, 255]; }
        if v > 255 { return [255, 255, 255, 255]; }
        return [v, v, v, 255];
    }
    let h = h - 360 * num_floor(h / 360);
    let d = 2 * l - 1;
    if d < 0 { d = -d; }
    let c = (1 - d) * s;
    let hp = h / 60;
    let k = num_floor(hp);
    let km = num_mod(hp, 2);
    let t = km - 1;
    if t < 0 { t = -t; }
    let x = c * (1 - t);
    let m = l - c / 2;
    let rp = 0;
    let gp = 0;
    let bp = 0;
    if k == 0 { rp = c; gp = x; bp = 0; }
    if k == 1 { rp = x; gp = c; bp = 0; }
    if k == 2 { rp = 0; gp = c; bp = x; }
    if k == 3 { rp = 0; gp = x; bp = c; }
    if k == 4 { rp = x; gp = 0; bp = c; }
    if k == 5 { rp = c; gp = 0; bp = x; }
    let r = (rp + m) * 255;
    let g = (gp + m) * 255;
    let b = (bp + m) * 255;
    if r < 0 { r = 0; }
    if r > 255 { r = 255; }
    if g < 0 { g = 0; }
    if g > 255 { g = 255; }
    if b < 0 { b = 0; }
    if b > 255 { b = 255; }
    return [r, g, b, 255];
}

// Linear interpolation between two colors; t in 0..1. Colors as [r,g,b] or [r,g,b,a].
fn lerpColor(c1, c2, t) {
    let a1 = 255;
    if len(c1) >= 4 { a1 = c1[3]; }
    let a2 = 255;
    if len(c2) >= 4 { a2 = c2[3]; }
    let r = c1[0] + (c2[0] - c1[0]) * t;
    let g = c1[1] + (c2[1] - c1[1]) * t;
    let b = c1[2] + (c2[2] - c1[2]) * t;
    let a = a1 + (a2 - a1) * t;
    if r < 0 { r = 0; }
    if r > 255 { r = 255; }
    if g < 0 { g = 0; }
    if g > 255 { g = 255; }
    if b < 0 { b = 0; }
    if b > 255 { b = 255; }
    if a < 0 { a = 0; }
    if a > 255 { a = 255; }
    return [r, g, b, a];
}

// Unit circle (16 points) for circle outline: x and y multipliers for radius 1
let _circle_x = [1, 0.924, 0.707, 0.383, 0, 0 - 0.383, 0 - 0.707, 0 - 0.924, 0 - 1, 0 - 0.924, 0 - 0.707, 0 - 0.383, 0, 0.383, 0.707, 0.924];
let _circle_y = [0, 0.383, 0.707, 0.924, 1, 0.924, 0.707, 0.383, 0, 0 - 0.383, 0 - 0.707, 0 - 0.924, 0 - 1, 0 - 0.924, 0 - 0.707, 0 - 0.383];

fn _circleOutline(handle, cx, cy, r, color) {
    let n = 16;
    let i = 0;
    while i < n {
        let x1 = cx + r * _circle_x[i];
        let y1 = cy + r * _circle_y[i];
        let j = i + 1;
        if j >= n { j = 0; }
        let x2 = cx + r * _circle_x[j];
        let y2 = cy + r * _circle_y[j];
        gfxdrawline(handle, x1, y1, x2, y2, color);
        i = i + 1;
    }
}

fn _segment_count(segments) {
    let n = segments;
    if n == nil { n = 24; }
    if n < 1 { n = 1; }
    if n > 512 { n = 512; }
    return n;
}

fn bezier_point(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t) {
    if t < 0 { t = 0; }
    if t > 1 { t = 1; }
    let u = 1 - t;
    let uu = u * u;
    let tt = t * t;
    let uuu = uu * u;
    let ttt = tt * t;
    let x = uuu * x0 + 3 * uu * t * cx1 + 3 * u * tt * cx2 + ttt * x1;
    let y = uuu * y0 + 3 * uu * t * cy1 + 3 * u * tt * cy2 + ttt * y1;
    return [x, y];
}

fn bezier_points(x0, y0, cx1, cy1, cx2, cy2, x1, y1, segments) {
    let n = _segment_count(segments);
    let out = [];
    let i = 0;
    while i <= n {
        let t = i / n;
        array_push(out, bezier_point(x0, y0, cx1, cy1, cx2, cy2, x1, y1, t));
        i = i + 1;
    }
    return out;
}

fn draw_polyline(handle, points, color) {
    let drawn = 0;
    let i = 1;
    while i < len(points) {
        gfxdrawline(handle, points[i - 1][0], points[i - 1][1], points[i][0], points[i][1], color);
        drawn = drawn + 1;
        i = i + 1;
    }
    return drawn;
}

fn polygon(handle, points, color) {
    let drawn = draw_polyline(handle, points, color);
    if len(points) > 2 {
        gfxdrawline(handle, points[len(points) - 1][0], points[len(points) - 1][1], points[0][0], points[0][1], color);
        drawn = drawn + 1;
    }
    return drawn;
}

fn bezier(handle, x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments) {
    let pts = bezier_points(x0, y0, cx1, cy1, cx2, cy2, x1, y1, segments);
    draw_polyline(handle, pts, color);
    return pts;
}

fn draw_text(handle, x, y, text, color) {
    return _font.draw_text(fn(px, py, c) { gfxdrawpoint(handle, px, py, c); }, x, y, text, color);
}

// === Window "object" (handle + methods) ===
fn Window(w, h, title) {
    let handle = gfxcreatewindow(w, h, title);
    let obj = map{
        "handle": handle,
        "isOpen": fn() { return gfxisopen(handle); },
        "close": fn() { gfxclose(handle); },
        "size": fn() { return gfxsize(handle); },
        "clear": fn(color) { gfxclear(handle, color); },
        "rect": fn(x, y, rw, rh, color) { gfxdrawrect(handle, x, y, rw, rh, color); },
        "point": fn(x, y, color) { gfxdrawpoint(handle, x, y, color); },
        "line": fn(x1, y1, x2, y2, color) { gfxdrawline(handle, x1, y1, x2, y2, color); },
        "circle": fn(cx, cy, r, color) { _circleOutline(handle, cx, cy, r, color); },
        "polyline": fn(points, color) { return draw_polyline(handle, points, color); },
        "polygon": fn(points, color) { return polygon(handle, points, color); },
        "bezier": fn(x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments) { return bezier(handle, x0, y0, cx1, cy1, cx2, cy2, x1, y1, color, segments); },
        "text": fn(x, y, text, color) { return draw_text(handle, x, y, text, color); },
        "present": fn() { gfxpresent(handle); },
        "pollEvents": fn() { return gfxpollevents(handle); }
    };
    return obj;
}

// === Main loop: updateFn(state, events), drawFn(state, win); fps = target frames per second ===
fn run(win, state, updateFn, drawFn, fps) {
    let frameMs = 1000 / fps;
    while win.isOpen() {
        let t0 = clock();
        let events = win.pollEvents();
        if updateFn != nil {
            updateFn(state, events);
        }
        if drawFn != nil {
            drawFn(state, win);
        }
        win.present();
        let elapsedMs = (clock() - t0) * 1000;
        if elapsedMs < frameMs {
            sleep_ms(frameMs - elapsedMs);
        }
    }
}

// Legacy alias (no state; updateFn(), drawFn(win))
fn runGameLoop(window, updateFn, drawFn, fps) {
    let state = map{};
    run(window, state, fn(s, events) { if updateFn != nil { updateFn(); } }, fn(s, win) { if drawFn != nil { drawFn(win); } }, fps);
}

export BLACK, WHITE, RED, GREEN, BLUE, YELLOW, CYAN, MAGENTA, GRAY, ORANGE, PURPLE, LIME, NAVY, TEAL, SILVER, MAROON, OLIVE;
export rgb, rgba, gray, hsl, lerpColor;
export bezier_point, bezier_points, draw_polyline, polygon, bezier, draw_text;
export Window, run, runGameLoop;

