// stdlib/middleware.sapp — HTTP middleware helpers (W3)

fn wrap(handler, mw) {
    return fn(req) {
        let res = mw(req);
        if res != nil { return res; }
        return handler(req);
    };
}

fn chain(handler, mws) {
    return fn(req) {
        for i len(mws) {
            let res = mws[i](req);
            if res != nil { return res; }
        }
        return handler(req);
    };
}

fn mw_log() {
    return fn(req) {
        let method = try req["method"] catch "?";
        let path = try req["path"] catch "/";
        print method + " " + path;
        return nil;
    };
}

fn mw_require_auth(secret) {
    return fn(req) {
        let auth = try req["auth"] catch nil;
        if auth != secret {
            return map{ "status": 401, "body": "unauthorized" };
        }
        return nil;
    };
}

// Back-compatible aliases for W3-era code that used the old "stub" names.
fn mw_log_stub() { return mw_log(); }
fn mw_require_auth_stub(secret) { return mw_require_auth(secret); }

export wrap, chain, mw_log, mw_require_auth, mw_log_stub, mw_require_auth_stub;
