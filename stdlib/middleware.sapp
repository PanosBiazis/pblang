// stdlib/middleware.sapp — HTTP middleware helpers (W3)

fn wrap(handler, mw) {
    return fn(req) {
        let res = mw(req);
        if res != nil { return res; }
        return handler(req);
    };
}

fn chain(handler, mws) {
    return fn(req) {
        for i len(mws) {
            let res = mws[i](req);
            if res != nil { return res; }
        }
        return handler(req);
    };
}

fn mw_log() {
    return fn(req) {
        let method = try req["method"] catch "?";
        let path = try req["path"] catch "/";
        print method + " " + path;
        return nil;
    };
}

fn mw_require_auth(secret) {
    return fn(req) {
        let auth = try req["auth"] catch nil;
        if auth != secret {
            return map{ "status": 401, "body": "unauthorized" };
        }
        return nil;
    };
}

// compose(mws) — combine several request-phase guards into ONE middleware: runs
// them in order, returning the first non-nil (short-circuit) response, else nil.
// (chain wraps a handler; compose produces a reusable middleware.)
fn compose(mws) {
    return fn(req) {
        let i = 0;
        while i < len(mws) {
            let res = mws[i](req);
            if res != nil { return res; }
            i = i + 1;
        }
        return nil;
    };
}

// ── response helpers ───────────────────────────────────────────────────────────
// as_response(res) — normalize a handler return (string body OR a response map)
// into a response map { status, body, headers? } so response-phase middleware can
// uniformly read/modify it.
fn as_response(res) {
    if type(res) == "map" { return res; }
    return map{ status: 200, body: str(res) };
}

// set_header(res, name, value) — add/overwrite a header on a response map,
// creating its `headers` sub-map on first use. Returns the response.
fn set_header(res, name, value) {
    if not map_has(res, "headers") { res["headers"] = map{}; }
    res["headers"][name] = value;
    return res;
}

// after(handler, transform) — RESPONSE-phase middleware: run the handler, then
// pass its (normalized) response through transform(req, res). transform may mutate
// `res` in place and return nil, or return a replacement response. Enables headers,
// timing, logging-with-status, etc. — which guard-only middleware cannot do.
fn after(handler, transform) {
    return fn(req) {
        let res = as_response(handler(req));
        let t = transform(req, res);
        if t != nil { return t; }
        return res;
    };
}

// cors(handler, opts) — full CORS handling: answers an OPTIONS preflight with a 204
// + the Allow-* headers, and injects Access-Control-Allow-Origin into every other
// response. opts: { origin (default "*"), methods, headers }.
fn cors(handler, opts) {
    if opts == nil { opts = map{}; }
    let origin = try opts.origin catch "*";
    let methods = try opts.methods catch "GET, POST, PUT, PATCH, DELETE, OPTIONS";
    let allow_headers = try opts.headers catch "Content-Type, Authorization";
    return fn(req) {
        let method = try req["method"] catch "GET";
        if method == "OPTIONS" {
            return map{ status: 204, body: "", headers: map{
                "Access-Control-Allow-Origin": origin,
                "Access-Control-Allow-Methods": methods,
                "Access-Control-Allow-Headers": allow_headers
            } };
        }
        let res = as_response(handler(req));
        set_header(res, "Access-Control-Allow-Origin", origin);
        return res;
    };
}

// security_headers(handler) — add a baseline set of hardening response headers.
fn security_headers(handler) {
    return fn(req) {
        let res = as_response(handler(req));
        set_header(res, "X-Content-Type-Options", "nosniff");
        set_header(res, "X-Frame-Options", "DENY");
        set_header(res, "Referrer-Policy", "no-referrer");
        return res;
    };
}

// mw_bearer_auth(token) — request-phase guard that checks the Authorization header
// for "Bearer <token>" (case-insensitive header name). 401 if absent, 403 if wrong.
fn mw_bearer_auth(token) {
    return fn(req) {
        let h = try req["headers"] catch map{};
        let auth = try h["Authorization"] catch nil;
        if auth == nil { auth = try h["authorization"] catch nil; }
        if auth == nil { return map{ status: 401, body: "unauthorized" }; }
        if auth != "Bearer " + str(token) { return map{ status: 403, body: "forbidden" }; }
        return nil;
    };
}

// Back-compatible aliases for W3-era code that used the old "stub" names.
fn mw_log_stub() { return mw_log(); }
fn mw_require_auth_stub(secret) { return mw_require_auth(secret); }

export wrap, chain, compose, after, cors, security_headers,
       as_response, set_header,
       mw_log, mw_require_auth, mw_bearer_auth, mw_log_stub, mw_require_auth_stub;
