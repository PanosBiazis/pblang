// Explicit local file adapter; separate from the pure contract resolver.
let CORE=import("stdlib:controlled_modularity.sapp");
let SECURE=import("stdlib:secure_file.sapp");
let PATH=import("stdlib:path.sapp");
fn check(path,root,available=nil) {
    if available==nil {available=[];}
    let loaded=try SECURE.read_text(PATH.normalize(PATH.absolute(path)),CORE.MAX_BYTES,false) catch map{ok:false};
    if not loaded.ok {return map{ok:false,code:"contract_unavailable"};}
    let admitted=CORE.parse(loaded.text);
    if not admitted.ok {return map{ok:false,code:admitted.code};}
    return CORE.resolve(admitted.document,root,available);
}
export check;
