// stdlib/emulator_support.sapp -- shared bounds and validation for ISA models.

let DEFAULT_BUDGET = 1000000;

fn integer(value, low, high) {
    return is_number(value) and num_floor(value) == value and value >= low and value <= high;
}

fn byte(value) {
    if not integer(value, -2147483648, 2147483647) { throw "emulator: byte operand must be an integer"; }
    let result = value % 256;
    if result < 0 { result = result + 256; }
    return result;
}

fn signed_byte(value) {
    if not integer(value, 0, 255) { throw "emulator: signed byte source must be 0..255"; }
    if value >= 128 { return value - 256; }
    return value;
}

fn validate_bytes(code, max_bytes) {
    if not is_array(code) { return "code must be a byte array"; }
    if len(code) == 0 { return "code must not be empty"; }
    if len(code) > max_bytes { return "code exceeds " + str(max_bytes) + " bytes"; }
    let i = 0;
    while i < len(code) {
        if not integer(code[i], 0, 255) { return "invalid byte at offset " + str(i); }
        i = i + 1;
    }
    return nil;
}

fn program(instructions, max_bytes) {
    if not is_array(instructions) { throw "emulator.program: instruction list must be an array"; }
    let code = [];
    let i = 0;
    while i < len(instructions) {
        let instruction = instructions[i];
        if not is_array(instruction) { throw "emulator.program: each instruction must be a byte array"; }
        if len(code) + len(instruction) > max_bytes { throw "emulator.program: code size limit exceeded"; }
        let j = 0;
        while j < len(instruction) {
            if not integer(instruction[j], 0, 255) { throw "emulator.program: invalid byte"; }
            array_push(code, instruction[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return code;
}

fn validate_units(code, max_units, max_value, unit_name) {
    if not is_array(code) { return "code must be a " + unit_name + " array"; }
    if len(code) == 0 { return "code must not be empty"; }
    if len(code) > max_units { return "code exceeds " + str(max_units) + " " + unit_name + "s"; }
    let i = 0;
    while i < len(code) {
        if not integer(code[i], 0, max_value) { return "invalid " + unit_name + " at offset " + str(i); }
        i = i + 1;
    }
    return nil;
}

fn unit_program(instructions, max_units, max_value, unit_name) {
    if not is_array(instructions) { throw "emulator.program: instruction list must be an array"; }
    let code = [];
    let i = 0;
    while i < len(instructions) {
        let instruction = instructions[i];
        if not is_array(instruction) { throw "emulator.program: each instruction must be a " + unit_name + " array"; }
        if len(code) + len(instruction) > max_units { throw "emulator.program: code size limit exceeded"; }
        let j = 0;
        while j < len(instruction) {
            if not integer(instruction[j], 0, max_value) { throw "emulator.program: invalid " + unit_name; }
            array_push(code, instruction[j]); j = j + 1;
        }
        i = i + 1;
    }
    return code;
}

fn instruction_budget(options, limit) {
    if options == nil { return map{ ok: true, value: limit }; }
    if not is_map(options) { return map{ ok: false, error: "options must be a map" }; }
    let value = limit;
    if map_has(options, "instruction_budget") { value = options.instruction_budget; }
    if not integer(value, 1, limit) {
        return map{ ok: false, error: "instruction_budget must be 1.." + str(limit) };
    }
    return map{ ok: true, value: value };
}

fn failure(format, reason, pc, instructions) {
    return map{
        ok: false, format: format, error: reason, pc: pc,
        instructions: instructions, halted: false
    };
}

export DEFAULT_BUDGET, integer, byte, signed_byte, validate_bytes, program;
export validate_units, unit_program;
export instruction_budget, failure;
