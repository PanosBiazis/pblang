// stdlib/project_inventory.sapp -- bounded metadata-only filesystem inventory.
//
// This module walks directory names only. It never reads file contents. The
// output is safe path metadata for stdlib:project_survey.sapp, which can then
// produce cross-project readiness/action plans for every declared AAP product.

let SURVEY = import("stdlib:project_survey.sapp");
let SECURE = import("stdlib:secure_file.sapp");

let MAX_ROOTS_HARD = 64;
let MAX_DEPTH_HARD = 32;
let MAX_ENTRIES_HARD = 50000;
let MAX_CHILDREN_HARD = 4096;
let MAX_RUNTIME_MS_HARD = 300000;
let MAX_VISITED_HARD = 50000;
let MAX_PENDING_HARD = 8192;
let MAX_PAGE_RECORDS_HARD = 256;
let MAX_SESSIONS_HARD = 8;
let MAX_GLOBAL_PENDING_HARD = 16384;
let MAX_SESSION_TTL_MS = 600000;
let STABILITY_MAX_DEPTH = 8;
let STABILITY_MAX_ENTRIES = 1024;
let STABILITY_MAX_CHILDREN = 256;
let STABILITY_PASS_RUNTIME_MS = 5000;
let SESSION_FORMAT = "pblang.project_inventory.session.v1";
let CURSOR_FORMAT = "pblang.project_inventory.cursor.v1";
let _sessions = map{};
let _session_busy = false;

fn _str(x) { return str(x ?? ""); }

fn _base(path) {
    let parts = str_split(_str(path), "/");
    if len(parts) == 0 { return ""; }
    let b = parts[len(parts) - 1];
    if b == "" and len(parts) > 1 { b = parts[len(parts) - 2]; }
    return b;
}

fn _join(a, b) {
    let left = _str(a);
    let right = _str(b);
    if left == "" { return right; }
    if str_ends_with(left, "/") { return left + right; }
    return left + "/" + right;
}

fn _lower(x) { return str_lower(_str(x)); }

fn _contains_any(text, needles) {
    let t = _lower(text);
    let i = 0;
    while i < len(needles) {
        if str_contains(t, _lower(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _exact_option_fields(options, allowed) {
    if type(options) != "map" { return false; }
    for key in map_keys(options) {
        let known = false;
        for field in allowed { if key == field { known = true; } }
        if not known { return false; }
    }
    return true;
}

fn _safe_root(root) {
    if type(root) != "string" or root == "" or len(root) > 4096
    or str_contains(root, strfromcharcode(0)) { return false; }
    let i = 0;
    while i < len(root) {
        let c = strcharcodeat(root, i);
        if c < 32 or (c >= 127 and c <= 159)
        or (c >= 8234 and c <= 8238) or (c >= 8294 and c <= 8297) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _framed(values) {
    let parts = [];
    for value in values {
        let bytes = str_to_bytes(_str(value));
        array_push(parts, str(len(bytes)) + ":" + _str(value));
    }
    return str_join(parts, "|");
}

fn _root_digest(roots) { return sha256("roots-v1|" + _framed(roots)); }

fn _option_digest(options) {
    return sha256(_framed(["inventory-options-v1", options.max_depth,
    options.max_entries, options.max_children_per_dir, options.include_files,
    options.include_dirs, options.max_runtime_ms, options.page_records,
    options.max_pending, options.session_ttl_ms]));
}

fn _validated_request(roots, options, session_mode = false) {
    if roots == nil { roots = ["."]; }
    if options == nil { options = map{}; }
    let allowed = ["max_depth", "max_entries", "max_children_per_dir",
    "include_files", "include_dirs", "max_runtime_ms"];
    if session_mode {
        array_push(allowed, "page_records"); array_push(allowed, "max_pending");
        array_push(allowed, "session_ttl_ms");
    }
    let max_depth = try options.max_depth catch 4;
    let max_entries = try options.max_entries catch 1000;
    let max_children = try options.max_children_per_dir catch 200;
    let include_files = try options.include_files catch true;
    let include_dirs = try options.include_dirs catch true;
    let max_runtime_ms = try options.max_runtime_ms catch 30000;
    let page_records = try options.page_records catch 128;
    let max_pending = try options.max_pending catch 4096;
    let session_ttl_ms = try options.session_ttl_ms catch 300000;
    let valid_roots = type(roots) == "array" and len(roots) >= 1 and len(roots) <= MAX_ROOTS_HARD;
    if valid_roots { for root in roots { if not _safe_root(root) { valid_roots = false; } } }
    let valid = valid_roots and _exact_option_fields(options, allowed)
    and type(max_depth) == "number" and max_depth == num_floor(max_depth)
    and max_depth >= 0 and max_depth <= MAX_DEPTH_HARD
    and type(max_entries) == "number" and max_entries == num_floor(max_entries)
    and max_entries >= 1 and max_entries <= MAX_ENTRIES_HARD
    and type(max_children) == "number" and max_children == num_floor(max_children)
    and max_children >= 1 and max_children <= MAX_CHILDREN_HARD
    and type(include_files) == "bool" and type(include_dirs) == "bool"
    and (include_files or include_dirs)
    and type(max_runtime_ms) == "number" and max_runtime_ms == num_floor(max_runtime_ms)
    and max_runtime_ms >= 10 and max_runtime_ms <= MAX_RUNTIME_MS_HARD;
    if session_mode {
        valid = valid and type(page_records) == "number" and page_records == num_floor(page_records)
        and page_records >= 1 and page_records <= MAX_PAGE_RECORDS_HARD
        and type(max_pending) == "number" and max_pending == num_floor(max_pending)
        and max_pending >= 1 and max_pending <= MAX_PENDING_HARD
        and type(session_ttl_ms) == "number" and session_ttl_ms == num_floor(session_ttl_ms)
        and session_ttl_ms >= 1000 and session_ttl_ms <= MAX_SESSION_TTL_MS;
    }
    if not valid { return map{ ok:false, error:"invalid bounded inventory request" }; }
    let normalized = map{max_depth:max_depth, max_entries:max_entries,
        max_children_per_dir:max_children, include_files:include_files,
        include_dirs:include_dirs, max_runtime_ms:max_runtime_ms,
        page_records:page_records, max_pending:max_pending, session_ttl_ms:session_ttl_ms};
    return map{ok:true, roots:roots, options:normalized,
        roots_digest:_root_digest(roots), options_digest:_option_digest(normalized)};
}

fn _skip_name(name) {
    let n = _lower(name);
    if n == "" { return true; }
    if n == "." or n == ".." { return true; }
    if n == ".git" or n == ".svn" or n == ".hg" { return true; }
    if n == ".ssh" or n == ".gnupg" or n == ".cache" { return true; }
    if n == ".claude" or n == ".codex" { return true; }
    if n == "target" or n == "node_modules" or n == "__pycache__" or n == ".venv"
    or n == "venv" or str_ends_with(n, "-venv") or n == "site-packages" { return true; }
    if n == "vendor" or n == "pods" or n == ".gradle" or n == ".idea"
    or n == "deriveddata" { return true; }
    if n == ".obsidian" or n == ".next" or n == ".pytest_cache"
    or n == ".mypy_cache" or n == ".ruff_cache" or n == ".tox" or n == ".nox" { return true; }
    if n == "cache" or n == "tmp" or n == "temp" or n == "build" or n == "dist"
    or n == "obj" or n == "bin" or n == "out" or n == "coverage"
    or n == "artifacts" or n == "reports" or n == "logs" { return true; }
    if n == "graphify-out" { return true; }
    if str_contains(n, "credential") or str_contains(n, "password") or str_contains(n, "passwd") { return true; }
    if str_contains(n, "secret") or str_contains(n, "token") or str_contains(n, "openrouter") { return true; }
    if str_contains(n, "api_key") or str_contains(n, "access_key") { return true; }
    if str_starts_with(n, "id_ed25519") or str_starts_with(n, "id_rsa") { return true; }
    if str_ends_with(n, ".pem") or str_ends_with(n, ".p12") or str_ends_with(n, ".pfx") or str_ends_with(n, ".key") { return true; }
    return false;
}

fn _path_has_skipped_component(path) {
    let parts = str_split(_str(path), "/");
    let i = 0;
    while i < len(parts) {
        let n = _lower(parts[i]);
        if n != "" and n != "." and n != ".." and _skip_name(n) { return true; }
        i = i + 1;
    }
    return false;
}

fn should_skip_path(path) {
    let p = _str(path);
    if p == "." or p == "./" or p == ".." or p == "../" { return false; }
    if SURVEY.sensitive_path(path) { return true; }
    return _path_has_skipped_component(path);
}

fn _is_dir(path) {
    let listed = SECURE.list_directory(path, 1);
    return try listed.ok catch false;
}

fn _bounded_listdir(path, max_children) {
    let listed = SECURE.list_directory(path, max_children);
    if not (try listed.ok catch false) { return nil; }
    return map{ entries: _bounded_entries(listed.entries, max_children),
        truncated: try listed.truncated catch false };
}

fn _bounded_entries(raw, max_children) {
    if max_children == nil or max_children < 1 { max_children = 200; }
    let out = [];
    let i = 0;
    while i < len(raw) and i < max_children {
        array_push(out, raw[i]);
        i = i + 1;
    }
    return out;
}

fn _record(path, kind, depth, parent) {
    return map{
        format: "pblang.project_inventory.path.v1",
        path: path,
        name: _base(path),
        kind: kind,
        depth: depth,
        parent: parent,
        category: SURVEY.path_category(path),
        safe_for_ideas: not SURVEY.sensitive_path(path)
    };
}

fn _strict_record(path, kind, depth, parent, error_code = "") {
    return map{
        format: "pblang.project_inventory.strict-path.v1",
        path: path, name: _base(path), kind: kind, error_code: error_code,
        depth: depth, parent: parent, category: SURVEY.path_category(path),
        root_relative: true, contains_absolute_path: false,
        safe_for_ideas: false
    };
}

fn _strict_root_sensitive(root) {
    if type(root) != "string" { return true; }
    let parts = str_split(root, "/");
    for part in parts {
        let name = _lower(part);
        if name == ".ssh" or name == ".gnupg" or name == ".codex" or name == ".claude"
           or name == ".cache" or str_contains(name, "credential")
           or str_contains(name, "password") or str_contains(name, "passwd")
           or str_contains(name, "secret") or str_contains(name, "token")
           or str_contains(name, "openrouter") or str_contains(name, "api_key")
           or str_contains(name, "access_key") or str_starts_with(name, "id_ed25519")
           or str_starts_with(name, "id_rsa") or str_ends_with(name, ".pem")
           or str_ends_with(name, ".p12") or str_ends_with(name, ".pfx")
           or str_ends_with(name, ".key") { return true; }
    }
    return false;
}

fn _discard_strict_entry(handle, entry) {
    let ok = true;
    if (try entry.kind catch "") == "directory"
       and (try entry.traversable catch false) {
        ok = SECURE.discard_bounded_traversal(handle,
            try entry.traversal_token catch "") and ok;
    }
    if (try entry.kind catch "") == "file"
       and type(try entry.content_token catch nil) == "string"
       and (try entry.content_token catch "") != "" {
        ok = SECURE.discard_bounded_content(handle,
            try entry.content_token catch "") and ok;
    }
    return ok;
}

fn _discard_strict_entries(handle, entries, start) {
    let ok = true; let i = start;
    while i < len(entries) {
        if not _discard_strict_entry(handle, entries[i]) { ok = false; }
        i = i + 1;
    }
    return ok;
}

fn _inventory_strict_owned(handle, normalized) {
    let started = now_ms(); let deadline = started + normalized.max_runtime_ms;
    let queue = [map{ enum_path: "", report_path: ".", depth: 0,
        parent: "", traversal_token: nil }];
    let q = 0; let records = []; let skipped = []; let errors = [];
    let private_observations = [json_stringify([".", "directory", "", 0, ""])];
    let scanned_dirs = 0; let scanned_entries = 0; let visited = 0;
    let enqueued = 1; let truncated = false; let timed_out = false;
    while q < len(queue) and len(records) < normalized.max_entries
    and visited < MAX_VISITED_HARD and now_ms() < deadline {
        let item = queue[q]; q = q + 1; visited = visited + 1;
        let listing = SECURE.enumerate_bounded(handle, item.enum_path,
            normalized.max_children_per_dir, item.traversal_token);
        if not (try listing.ok catch false) {
            array_push(errors, map{ path: item.report_path,
                code: try listing.error catch "strict-enumeration-failed" });
            array_push(records, _strict_record(item.report_path, "error",
                item.depth, item.parent, "strict-enumeration-failed"));
            truncated = true;
            continue;
        }
        scanned_dirs = scanned_dirs + 1;
        if listing.truncated or not listing.complete { truncated = true; }
        let observation_i = 0;
        while observation_i < len(listing.entries) {
            let observed = listing.entries[observation_i];
            let observed_name = str(try observed.name catch "");
            let observed_path = if item.report_path == "." { observed_name }
                else { _join(item.report_path, observed_name) };
            let observed_kind = str(try observed.kind catch "error");
            let observed_error = str(try observed.error_code catch "");
            if not (try observed.name_available catch false) or observed_path == "" {
                observed_path = item.report_path + "/<unavailable>"
                    + str(observation_i);
            }
            array_push(private_observations, json_stringify([observed_path,
                observed_kind, observed_error, item.depth + 1, item.report_path]));
            observation_i = observation_i + 1;
        }
        if normalized.include_dirs and len(records) < normalized.max_entries {
            array_push(records, _strict_record(item.report_path, "directory",
                item.depth, item.parent));
        }
        if item.depth >= normalized.max_depth {
            if not _discard_strict_entries(handle, listing.entries, 0) {
                array_push(errors, map{ path: item.report_path, code: "traversal-token-discard-failed" });
                truncated = true;
            }
            continue;
        }
        let i = 0;
        while i < len(listing.entries) and len(records) < normalized.max_entries
        and visited < MAX_VISITED_HARD and now_ms() < deadline {
            let entry = listing.entries[i]; i = i + 1;
            scanned_entries = scanned_entries + 1; visited = visited + 1;
            let child_path = if item.report_path == "." {
                str(try entry.name catch "")
            } else { _join(item.report_path, try entry.name catch "") };
            let sensitive_name = (try entry.name_available catch false)
                and _skip_name(try entry.name catch "");
            let safe_report_path = if sensitive_name { item.report_path } else { child_path };
            let token_retained = false;
            if not (try entry.name_available catch false) or child_path == "" {
                array_push(errors, map{ path: item.report_path,
                    code: try entry.error_code catch "invalid-entry-name" });
                array_push(records, _strict_record(item.report_path, "error",
                    item.depth + 1, item.report_path, "invalid-entry-name"));
                truncated = true;
            } elif sensitive_name {
                // Retain only the already-approved parent. Even a skipped
                // basename can itself disclose a credential or account label.
                array_push(skipped, map{ path: item.report_path,
                    reason: "sensitive/pruned name" });
            } elif entry.kind == "error" {
                array_push(errors, map{ path: safe_report_path, code: entry.error_code });
                array_push(records, _strict_record(safe_report_path, "error",
                    item.depth + 1, item.report_path, entry.error_code));
                truncated = true;
            } elif entry.kind == "symlink" {
                array_push(records, _strict_record(child_path, "symlink",
                    item.depth + 1, item.report_path));
            } elif entry.kind == "file" {
                if normalized.include_files {
                    array_push(records, _strict_record(child_path, "file",
                        item.depth + 1, item.report_path));
                }
            } elif entry.kind == "directory" and entry.traversable {
                if item.depth + 1 < normalized.max_depth {
                    if len(queue) - q >= MAX_PENDING_HARD or enqueued >= MAX_VISITED_HARD {
                        truncated = true;
                    } else {
                        array_push(queue, map{ enum_path: child_path, report_path: child_path,
                            depth: item.depth + 1, parent: item.report_path,
                            traversal_token: entry.traversal_token });
                        enqueued = enqueued + 1; token_retained = true;
                    }
                } elif normalized.include_dirs {
                    array_push(records, _strict_record(child_path, "directory",
                        item.depth + 1, item.report_path));
                }
            } else {
                array_push(errors, map{ path: safe_report_path, code: "invalid-entry-state" });
                array_push(records, _strict_record(safe_report_path, "error",
                    item.depth + 1, item.report_path, "invalid-entry-state"));
                truncated = true;
            }
            if not token_retained and not _discard_strict_entry(handle, entry) {
                array_push(errors, map{ path: safe_report_path,
                    code: "traversal-token-discard-failed" });
                truncated = true;
            }
        }
        if not _discard_strict_entries(handle, listing.entries, i) {
            array_push(errors, map{ path: item.report_path, code: "traversal-token-discard-failed" });
            truncated = true;
        }
    }
    if now_ms() >= deadline { timed_out = true; truncated = true; }
    if q < len(queue) or visited >= MAX_VISITED_HARD
       or len(records) >= normalized.max_entries { truncated = true; }
    let pending = q;
    while pending < len(queue) {
        let token = try queue[pending].traversal_token catch nil;
        if type(token) == "string" and token != ""
           and not SECURE.discard_bounded_traversal(handle, token) {
            array_push(errors, map{ path: ".", code: "queued-traversal-token-discard-failed" });
            truncated = true;
        }
        pending = pending + 1;
    }
    return map{ ok: true, format: "pblang.project_inventory.strict-report.v1",
        roots: [], records: records, paths: [], record_count: len(records),
        scanned_dirs: scanned_dirs, scanned_entries: scanned_entries,
        visited_entries: visited, enqueued_directories: enqueued,
        skipped: skipped, skipped_count: len(skipped), errors: errors,
        timed_out: timed_out, duration_ms: now_ms() - started,
        max_runtime_ms: normalized.max_runtime_ms, truncated: truncated,
        complete: not truncated and not timed_out and len(errors) == 0,
        hard_wall_timeout: false, hard_heap_bound: false,
        directory_enumerator_allocation_bounded: true,
        stay_on_device_enforced: true, entry_kind_tristate_enforced: true,
        entry_kind_states: ["file", "directory", "symlink", "error"],
        snapshot_consistent: false, namespace_stability_verified: false,
        vm_typed_ffi_enforced: false, hostile_code_sandbox: false,
        contains_absolute_paths: false, contains_traversal_tokens: false,
        contains_content_tokens: false,
        _private_observation_keys: private_observations,
        safe_to_log: false, production_ready: false,
        policy: "one approved Linux root; descriptor-streamed N+1 enumeration; one-use root-bound traversal tokens; same-mount identity checks; relative metadata only; any error, truncation, timeout, or namespace ambiguity makes evidence incomplete" };
}

// Linux-only strict inventory of one caller-approved root. The absolute root is
// never reported or digested; traversal uses only root-relative paths plus
// one-use tokens returned by secure_file's descriptor enumerator.
fn inventory_strict_root(root, options = nil) {
    let checked = _validated_request([root], options, false);
    if platform() != "linux" or not checked.ok or type(root) != "string"
       or not str_starts_with(root, "/") or _strict_root_sensitive(root) {
        return map{ ok: false, format: "pblang.project_inventory.strict-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["strict inventory requires one non-sensitive absolute Linux root"],
            complete: false, truncated: true, timed_out: false,
            hard_wall_timeout: false, hard_heap_bound: false,
            directory_enumerator_allocation_bounded: false,
            stay_on_device_enforced: false, entry_kind_tristate_enforced: false,
            snapshot_consistent: false, contains_absolute_paths: false,
            contains_traversal_tokens: false, safe_to_log: false };
    }
    let normalized = checked.options;
    let handle = SECURE.open_bounded_enumerator(root, 600000);
    if not handle.ok {
        return map{ ok: false, format: "pblang.project_inventory.strict-report.v1",
            roots: [], records: [], paths: [],
            record_count: 0, errors: ["strict scan root could not be held"],
            complete: false, truncated: true, timed_out: false,
            hard_wall_timeout: false, hard_heap_bound: false,
            directory_enumerator_allocation_bounded: false,
            stay_on_device_enforced: false, entry_kind_tristate_enforced: false,
            snapshot_consistent: false, contains_absolute_paths: false,
            contains_traversal_tokens: false, safe_to_log: false };
    }
    let outcome = try { map{ ok: true, value: _inventory_strict_owned(handle, normalized) } }
        catch map{ ok: false };
    let closed = SECURE.close_bounded_enumerator(handle);
    if not outcome.ok {
        return map{ ok: false, format: "pblang.project_inventory.strict-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["strict inventory failed safely"], complete: false,
            truncated: true, timed_out: false, hard_wall_timeout: false,
            hard_heap_bound: false, directory_enumerator_allocation_bounded: true,
            stay_on_device_enforced: true, entry_kind_tristate_enforced: true,
            snapshot_consistent: false, contains_absolute_paths: false,
            contains_traversal_tokens: false, safe_to_log: false,
            enumerator_closed: closed, production_ready: false };
    }
    let report = outcome.value;
    if map_has(report, "_private_observation_keys") {
        map_remove(report, "_private_observation_keys");
    }
    if not closed { array_push(report.errors, map{ path: ".", code: "enumerator-close-failed" }); }
    report.ok = closed;
    report.complete = report.complete and closed;
    report.enumerator_closed = closed;
    return report;
}

// Observe one held namespace twice with a fresh traversal-token generation.
// Matching observations are useful change-detection evidence only: mutations
// can occur between passes and return to the same names (ABA), so snapshot and
// namespace-stability guarantees deliberately remain false.
fn _inventory_root_stability(root, options, require_mount_admission) {
    let total_started = now_ms();
    let checked = _validated_request([root], options, false);
    if platform() != "linux" or not checked.ok or type(root) != "string"
       or not str_starts_with(root, "/") or _strict_root_sensitive(root) {
        return map{ ok: false, format: "pblang.project_inventory.stability-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["strict stability observation requires one non-sensitive absolute Linux root"],
            complete: false, truncated: true, timed_out: false,
            passes_completed: 0, two_pass_stability_observed: false,
            namespace_change_observed: false, snapshot_consistent: false,
            namespace_stability_verified: false, hard_heap_bound: false,
            observation_inconclusive: true,
            hard_wall_timeout: false, total_wall_runtime_bounded: false,
            contains_absolute_paths: false, contains_traversal_tokens: false,
            safe_to_log: false, production_ready: false };
    }
    let normalized = checked.options;
    if normalized.max_depth > STABILITY_MAX_DEPTH
       or normalized.max_entries > STABILITY_MAX_ENTRIES
       or normalized.max_children_per_dir > STABILITY_MAX_CHILDREN {
        return map{ ok: false, format: "pblang.project_inventory.stability-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["strict stability observation bounds exceed the dedicated ceiling"],
            complete: false, truncated: true, timed_out: false,
            passes_completed: 0, two_pass_stability_observed: false,
            namespace_change_observed: false, snapshot_consistent: false,
            namespace_stability_verified: false, hard_heap_bound: false,
            observation_inconclusive: true,
            hard_wall_timeout: false, total_wall_runtime_bounded: false,
            contains_absolute_paths: false, contains_traversal_tokens: false,
            safe_to_log: false, production_ready: false };
    }
    let pass_options = map{};
    for key in ["max_depth", "max_entries", "max_children_per_dir",
        "include_files", "include_dirs", "max_runtime_ms"] {
        pass_options[key] = normalized[key];
    }
    if pass_options.max_runtime_ms > STABILITY_PASS_RUNTIME_MS {
        pass_options.max_runtime_ms = STABILITY_PASS_RUNTIME_MS;
    }
    let total_pass_runtime_budget_ms = pass_options.max_runtime_ms * 2;
    let handle = if require_mount_admission {
        SECURE.open_admitted_scan_enumerator(root, 600000)
    } else { SECURE.open_bounded_enumerator(root, 600000) };
    if not handle.ok {
        return map{ ok: false, format: "pblang.project_inventory.stability-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["strict stability root could not be held"], complete: false,
            truncated: true, timed_out: false, passes_completed: 0,
            two_pass_stability_observed: false, namespace_change_observed: false,
            snapshot_consistent: false, namespace_stability_verified: false,
            hard_heap_bound: false, contains_absolute_paths: false,
            observation_inconclusive: true,
            hard_wall_timeout: false, total_wall_runtime_bounded: false,
            duration_ms: now_ms() - total_started,
            max_runtime_ms: total_pass_runtime_budget_ms,
            contains_traversal_tokens: false, safe_to_log: false,
            production_ready: false };
    }
    let first_outcome = try { map{ ok: true,
        value: _inventory_strict_owned(handle, pass_options) } } catch map{ ok: false };
    if not first_outcome.ok {
        let closed = SECURE.close_bounded_enumerator(handle);
        return map{ ok: false, format: "pblang.project_inventory.stability-report.v1",
            roots: [], records: [], paths: [], record_count: 0,
            errors: ["first stability observation failed safely"], complete: false,
            truncated: true, timed_out: false, passes_completed: 0,
            two_pass_stability_observed: false, namespace_change_observed: false,
            snapshot_consistent: false, namespace_stability_verified: false,
            hard_heap_bound: false, contains_absolute_paths: false,
            observation_inconclusive: true,
            hard_wall_timeout: false, total_wall_runtime_bounded: false,
            duration_ms: now_ms() - total_started,
            max_runtime_ms: total_pass_runtime_budget_ms,
            contains_traversal_tokens: false, safe_to_log: false,
            enumerator_closed: closed, production_ready: false };
    }
    let first = first_outcome.value;
    let first_keys = try first._private_observation_keys catch [];
    map_remove(first, "_private_observation_keys");
    if not first.complete {
        let closed = SECURE.close_bounded_enumerator(handle);
        first.format = "pblang.project_inventory.stability-report.v1";
        first.passes_completed = 1; first.two_pass_stability_observed = false;
        first.namespace_change_observed = false; first.enumerator_closed = closed;
        first.observation_inconclusive = true;
        first.hard_wall_timeout = false; first.total_wall_runtime_bounded = false;
        first.duration_ms = now_ms() - total_started;
        first.max_runtime_ms = total_pass_runtime_budget_ms;
        first.ok = first.ok and closed; first.complete = false;
        return first;
    }
    let restarted = SECURE.restart_bounded_enumerator(handle);
    if not restarted.ok {
        let closed = if try restarted.handle_invalidated catch false {
            try restarted.enumerator_closed catch false
        } else { SECURE.close_bounded_enumerator(handle) };
        first.format = "pblang.project_inventory.stability-report.v1";
        array_push(first.errors, map{ path: ".", code: "enumeration-generation-restart-failed" });
        first.passes_completed = 1; first.two_pass_stability_observed = false;
        first.namespace_change_observed = false; first.observation_inconclusive = true;
        first.enumerator_closed = closed;
        first.hard_wall_timeout = false; first.total_wall_runtime_bounded = false;
        first.duration_ms = now_ms() - total_started;
        first.max_runtime_ms = total_pass_runtime_budget_ms;
        first.ok = false; first.complete = false; first.truncated = true;
        return first;
    }
    let second_outcome = try { map{ ok: true,
        value: _inventory_strict_owned(handle, pass_options) } } catch map{ ok: false };
    let post_mount = if require_mount_admission {
        SECURE.recheck_admitted_scan_enumerator(handle)
    } else { map{ ok: true, held_root_vfs_policy_admitted: false,
        mount_binding_rechecked: false } };
    let closed = if try post_mount.handle_invalidated catch false {
        try post_mount.enumerator_closed catch false
    } else { SECURE.close_bounded_enumerator(handle) };
    if not second_outcome.ok {
        first.format = "pblang.project_inventory.stability-report.v1";
        array_push(first.errors, map{ path: ".", code: "second-stability-observation-failed" });
        if require_mount_admission and not post_mount.ok {
            array_push(first.errors, map{ path: ".", code: "scan-mount-binding-recheck-failed" });
        }
        first.passes_completed = 1; first.two_pass_stability_observed = false;
        first.namespace_change_observed = false; first.observation_inconclusive = true;
        first.held_root_vfs_policy_admitted = false;
        first.mount_binding_rechecked = false;
        first.corroborating_source = false;
        first.enumerator_closed = closed;
        first.hard_wall_timeout = false; first.total_wall_runtime_bounded = false;
        first.duration_ms = now_ms() - total_started;
        first.max_runtime_ms = total_pass_runtime_budget_ms;
        first.ok = false; first.complete = false; first.truncated = true;
        return first;
    }
    let second = second_outcome.value;
    let second_keys = try second._private_observation_keys catch [];
    map_remove(second, "_private_observation_keys");
    let mount_binding_ok = not require_mount_admission or post_mount.ok;
    let observations_equal = first.complete and second.complete
        and array_sort(first_keys) == array_sort(second_keys);
    let stable = observations_equal and closed and mount_binding_ok;
    let namespace_changed = first.complete and second.complete
        and not observations_equal and closed and mount_binding_ok;
    second.format = "pblang.project_inventory.stability-report.v1";
    second.passes_completed = 2;
    second.two_pass_stability_observed = stable;
    second.namespace_change_observed = namespace_changed;
    second.observation_inconclusive = not closed
        or not first.complete or not second.complete or not mount_binding_ok;
    second.held_root_vfs_policy_admitted = require_mount_admission and post_mount.ok;
    second.mount_binding_rechecked = require_mount_admission and post_mount.ok;
    second.direct_vfs_type_allowlisted = require_mount_admission and post_mount.ok;
    second.direct_virtual_vfs_type_rejected = require_mount_admission and post_mount.ok;
    second.direct_network_vfs_type_rejected = require_mount_admission and post_mount.ok;
    second.direct_fuse_vfs_type_rejected = require_mount_admission and post_mount.ok;
    second.unknown_vfs_type_rejected = require_mount_admission and post_mount.ok;
    second.backing_storage_locality_verified = false;
    second.trusted_mount_namespace_verified = false;
    second.procfs_authenticity_verified = false;
    second.corroborating_source = false;
    second.contains_mount_identity = false;
    second.contains_filesystem_type = false;
    second.authorizes_idea_admission = false;
    second.snapshot_consistent = false;
    second.namespace_stability_verified = false;
    second.hard_heap_bound = false;
    second.hard_wall_timeout = false;
    second.total_wall_runtime_bounded = false;
    second.enumerator_closed = closed;
    second.duration_ms = now_ms() - total_started;
    second.max_runtime_ms = total_pass_runtime_budget_ms;
    if not closed {
        array_push(second.errors, map{ path: ".", code: "stability-enumerator-cleanup-failed" });
        second.complete = false; second.truncated = true;
    } elif not mount_binding_ok {
        array_push(second.errors, map{ path: ".", code: "scan-mount-binding-recheck-failed" });
        second.ok = false; second.complete = false; second.truncated = true;
    } elif namespace_changed {
        array_push(second.errors, map{ path: ".", code: "namespace-changed-between-observations" });
        second.complete = false; second.truncated = true;
    } elif not stable {
        array_push(second.errors, map{ path: ".", code: "stability-observation-inconclusive" });
        second.complete = false; second.truncated = true;
    }
    second.ok = second.ok and closed;
    second.complete = second.complete and closed;
    second.production_ready = false;
    return second;
}

fn inventory_strict_root_stability(root, options = nil) {
    return _inventory_root_stability(root, options, false);
}

// Scanner surface: the same two-pass observation plus descriptor-derived
// direct-VFS policy admission and a post-observation mount binding recheck.
fn inventory_admitted_root_stability(root, options = nil) {
    return _inventory_root_stability(root, options, true);
}

fn inventory_roots(roots, options = nil) {
    let checked = _validated_request(roots, options, false);
    if not checked.ok {
        return map{ format: "pblang.project_inventory.report.v1", roots: [], records: [], paths: [],
            record_count: 0, scanned_dirs: 0, scanned_entries: 0, skipped: [], skipped_count: 0,
            errors: ["invalid bounded inventory request"], timed_out: false, duration_ms: 0,
            max_runtime_ms: 0, truncated: true, complete: false,
            hard_wall_timeout:false, hard_heap_bound:false,
            directory_enumerator_allocation_bounded:false,
            stay_on_device_enforced:false, entry_kind_tristate_enforced:false,
            policy: "invalid requests fail closed before filesystem access" };
    }
    roots = checked.roots; let normalized = checked.options;
    let max_depth = normalized.max_depth; let max_entries = normalized.max_entries;
    let max_children = normalized.max_children_per_dir;
    let include_files = normalized.include_files; let include_dirs = normalized.include_dirs;
    let max_runtime_ms = normalized.max_runtime_ms;
    let started_ms = now_ms(); let deadline_ms = started_ms + max_runtime_ms;

    let records = [];
    let skipped = [];
    let errors = [];
    let queue = [];
    let ri = 0;
    while ri < len(roots) {
        let root = _str(roots[ri]);
        if root != "" {
            if should_skip_path(root) {
                array_push(skipped, map{ path: SURVEY.path_record(root).path, reason: "sensitive/pruned root" });
            } else {
                array_push(queue, map{ path: root, depth: 0, parent: "" });
            }
        }
        ri = ri + 1;
    }

    let q = 0;
    let scanned_dirs = 0;
    let scanned_entries = 0;
    let visited = 0;
    let enqueued = len(queue);
    let truncated = false;
    let timed_out = false;
    while q < len(queue) and len(records) < max_entries and visited < MAX_VISITED_HARD
    and now_ms() < deadline_ms {
        let cur = queue[q];
        q = q + 1;
        let path = _str(cur.path);
        let depth = try cur.depth catch 0;
        let parent = _str(try cur.parent catch "");
        let listing = try cur.listing catch nil;
        if type(listing) != "map" { listing = _bounded_listdir(path, max_children); }
        if listing == nil {
            visited = visited + 1;
            if include_files {
                array_push(records, _record(path, "file", depth, parent));
            }
            continue;
        }
        let entries = listing.entries;
        visited = visited + 1;
        if try listing.truncated catch false { truncated = true; }

        scanned_dirs = scanned_dirs + 1;
        if include_dirs {
            array_push(records, _record(path, "dir", depth, parent));
        }
        if len(records) >= max_entries { truncated = true; break; }
        if depth >= max_depth { continue; }

        let i = 0;
        while i < len(entries) and len(records) < max_entries
        and visited < MAX_VISITED_HARD and now_ms() < deadline_ms {
            let name = _str(entries[i]);
            let child = _join(path, name);
            scanned_entries = scanned_entries + 1;
            visited = visited + 1;
            if should_skip_path(child) {
                array_push(skipped, map{ path: SURVEY.path_record(child).path, reason: "sensitive/pruned path" });
                i = i + 1;
                continue;
            }
            let child_listing = _bounded_listdir(child, max_children);
            if type(child_listing) == "map" {
                if depth + 1 < max_depth {
                    if enqueued >= MAX_VISITED_HARD or len(queue) - q >= MAX_PENDING_HARD {
                        truncated = true;
                    } else {
                        array_push(queue, map{ path: child, depth: depth + 1, parent: path,
                            listing: child_listing });
                        enqueued = enqueued + 1;
                    }
                } else if include_dirs {
                    array_push(records, _record(child, "dir", depth + 1, path));
                }
            } else if include_files {
                array_push(records, _record(child, "file", depth + 1, path));
            }
            i = i + 1;
        }
        if now_ms() >= deadline_ms { timed_out = true; truncated = true; }
        if try listing.truncated catch false { truncated = true; }
    }
    if now_ms() >= deadline_ms { timed_out = true; truncated = true; }
    if q < len(queue) { truncated = true; }
    if visited >= MAX_VISITED_HARD { truncated = true; }

    return map{
        format: "pblang.project_inventory.report.v1",
        roots: roots,
        records: records,
        paths: inventory_paths(map{ records: records }),
        record_count: len(records),
        scanned_dirs: scanned_dirs,
        scanned_entries: scanned_entries,
        visited_entries: visited,
        enqueued_directories: enqueued,
        skipped: skipped,
        skipped_count: len(skipped),
        errors: errors,
        timed_out: timed_out,
        duration_ms: now_ms() - started_ms,
        max_runtime_ms: max_runtime_ms,
        truncated: truncated,
        complete: not truncated and len(errors) == 0,
        hard_wall_timeout: false,
        hard_heap_bound: false,
        directory_enumerator_allocation_bounded: false,
        stay_on_device_enforced: false,
        entry_kind_tristate_enforced: false,
        policy: "metadata-only no-follow directory inventory; no file contents are read; sensitive/cache/build/generated-output/local assistant and vendored dependency paths are skipped; traversal has hard visited/enqueued/pending/root/depth ceilings and a cooperative deadline; the underlying directory enumerator is not proven allocation-bounded"
    };
}

fn _purge_sessions() {
    let now = now_ms();
    for id in map_keys(_sessions) {
        if now >= (try _sessions[id].expires_ms catch 0) { map_remove(_sessions, id); }
    }
}

fn _pending_total() {
    let total=0;
    for id in map_keys(_sessions) {
        let state=_sessions[id];
        total=total + (len(state.queue) - state.q);
    }
    return total;
}

fn _cursor(state) {
    return map{format:CURSOR_FORMAT, scan_id:state.scan_id, generation:state.generation,
        options_digest:state.options_digest,
        expires_ms:state.expires_ms, complete:state.complete,
        contains_paths:false, persistable:false};
}

fn _session_error(reason) {
    return map{ok:false, format:"pblang.project_inventory.page.v1", error:reason,
        roots:[], records:[], paths:[], record_count:0, complete:false, resumable:false,
        cursor:nil, hard_wall_timeout:false, hard_heap_bound:false,
        directory_enumerator_allocation_bounded:false,
        stay_on_device_enforced:false, entry_kind_tristate_enforced:false};
}

fn _session_page(state) {
    let started = now_ms(); let deadline = started + state.options.max_runtime_ms;
    let records=[]; let skipped=[]; let timed_out=false; let page_truncated=false;
    while len(records) < state.options.page_records and not state.complete
    and state.visited < MAX_VISITED_HARD and state.emitted < state.options.max_entries
    and now_ms() < deadline {
        if state.current == nil {
            if state.q >= len(state.queue) {
                if state.enumerator_truncated {
                    state.limit_exhausted=true; state.complete=false; page_truncated=true;
                } else { state.complete=true; }
                break;
            }
            let item=state.queue[state.q]; state.q=state.q + 1;
            let listing=_bounded_listdir(item.path, state.options.max_children_per_dir);
            state.visited=state.visited + 1;
            if listing == nil {
                if state.options.include_files {
                    array_push(records, _record(item.path, "file", item.depth, item.parent));
                    state.emitted=state.emitted + 1;
                }
            } else {
                state.scanned_dirs=state.scanned_dirs + 1;
                if listing.truncated { state.enumerator_truncated=true; page_truncated=true; }
                state.current=map{path:item.path, depth:item.depth, parent:item.parent,
                    entries:listing.entries, index:0};
                if state.options.include_dirs {
                    array_push(records, _record(item.path, "dir", item.depth, item.parent));
                    state.emitted=state.emitted + 1;
                }
            }
        } else {
            let cur=state.current;
            if cur.index >= len(cur.entries) { state.current=nil; }
            else {
                let name=_str(cur.entries[cur.index]); cur.index=cur.index + 1;
                let child=_join(cur.path, name); state.scanned_entries=state.scanned_entries + 1;
                state.visited=state.visited + 1;
                if should_skip_path(child) {
                    array_push(skipped, map{path:SURVEY.path_record(child).path,
                        reason:"sensitive/pruned path"});
                } else {
                    let child_listing=_bounded_listdir(child, 1);
                    if type(child_listing) == "map" {
                        if cur.depth + 1 < state.options.max_depth {
                            if state.enqueued >= MAX_VISITED_HARD
                            or len(state.queue) - state.q >= state.options.max_pending {
                                state.limit_exhausted=true; page_truncated=true;
                            } elif _pending_total() >= MAX_GLOBAL_PENDING_HARD {
                                state.limit_exhausted=true; page_truncated=true;
                            } else {
                                array_push(state.queue, map{path:child, depth:cur.depth + 1, parent:cur.path});
                                state.enqueued=state.enqueued + 1;
                            }
                        } elif state.options.include_dirs {
                            array_push(records, _record(child, "dir", cur.depth + 1, cur.path));
                            state.emitted=state.emitted + 1;
                        }
                    } elif state.options.include_files {
                        array_push(records, _record(child, "file", cur.depth + 1, cur.path));
                        state.emitted=state.emitted + 1;
                    }
                }
            }
        }
        if state.limit_exhausted { break; }
    }
    if now_ms() >= deadline { timed_out=true; page_truncated=true; }
    if state.visited >= MAX_VISITED_HARD or state.emitted >= state.options.max_entries
    or state.limit_exhausted { state.complete=false; page_truncated=true; }
    if not state.complete and not state.limit_exhausted and state.visited < MAX_VISITED_HARD
    and state.emitted < state.options.max_entries {
        state.generation=state.generation + 1;
    }
    state.expires_ms=now_ms() + state.options.session_ttl_ms;
    if state.q > 0 and (state.q >= 1024 or state.q * 2 >= len(state.queue)) {
        state.queue=slice(state.queue, state.q, len(state.queue)); state.q=0;
    }
    let cursor=_cursor(state);
    if state.complete or state.limit_exhausted or state.visited >= MAX_VISITED_HARD
    or state.emitted >= state.options.max_entries { map_remove(_sessions, state.scan_id); }
    return map{ok:true, format:"pblang.project_inventory.page.v1", records:records,
        paths:inventory_paths(map{records:records}), record_count:len(records),
        skipped:skipped, skipped_count:len(skipped), scanned_dirs:state.scanned_dirs,
        scanned_entries:state.scanned_entries, visited_entries:state.visited,
        enqueued_directories:state.enqueued, timed_out:timed_out,
        truncated:page_truncated or not state.complete, complete:state.complete,
        resumable:not state.complete and not state.limit_exhausted
        and state.visited < MAX_VISITED_HARD and state.emitted < state.options.max_entries,
        cursor:cursor, contains_private_paths:true, cursor_contains_paths:false,
        cursor_persistable:false, snapshot_consistent:false,
        cursor_path_binding_private:true, session_serialized_by_in_flight_guard:true,
        hard_wall_timeout:false, hard_heap_bound:false,
        directory_enumerator_allocation_bounded:false,
        stay_on_device_enforced:false, entry_kind_tristate_enforced:false,
        policy:"ephemeral process-local paging; public cursor is opaque and path-free; no persistence or snapshot-consistency claim"};
}

fn _inventory_create(roots, options) {
    _purge_sessions();
    let checked=_validated_request(roots, options, true);
    if not checked.ok { return _session_error(checked.error); }
    if len(map_keys(_sessions)) >= MAX_SESSIONS_HARD { return _session_error("inventory session capacity reached"); }
    if len(checked.roots) > checked.options.max_pending
    or _pending_total() + len(checked.roots) > MAX_GLOBAL_PENDING_HARD {
        return _session_error("inventory pending capacity reached");
    }
    let scan_id=""; let collision_attempts=0;
    while collision_attempts < 4 {
        scan_id=str_slice(sha256(base64_encode_bytes(random_bytes(32)) + ":"
        + str(now_ms()) + ":" + str(collision_attempts)), 0, 48);
        if not map_has(_sessions, scan_id) { break; }
        collision_attempts=collision_attempts + 1;
    }
    if map_has(_sessions, scan_id) {
        return _session_error("inventory session identifier collision");
    }
    let queue=[];
    for root in checked.roots {
        if not should_skip_path(root) { array_push(queue, map{path:root, depth:0, parent:""}); }
    }
    let state=map{format:SESSION_FORMAT, scan_id:scan_id, generation:0,
        roots_digest:checked.roots_digest, options_digest:checked.options_digest,
        options:checked.options, queue:queue, q:0, current:nil, visited:0,
        emitted:0, enqueued:len(queue), scanned_dirs:0, scanned_entries:0,
        enumerator_truncated:false, limit_exhausted:false, complete:false,
        expires_ms:now_ms() + checked.options.session_ttl_ms};
    _sessions[scan_id]=state;
    return map{ok:true, scan_id:scan_id};
}

fn _inventory_resume(cursor, roots, options) {
    _purge_sessions();
    if type(cursor) != "map" or len(cursor) != 8 or cursor.format != CURSOR_FORMAT
    or type(cursor.scan_id) != "string" or not regex_match(cursor.scan_id, "^[0-9a-f]{48}$")
    or type(cursor.generation) != "number" or cursor.generation != num_floor(cursor.generation)
    or type(cursor.options_digest) != "string"
    or type(cursor.expires_ms) != "number" or type(cursor.complete) != "bool"
    or cursor.contains_paths or cursor.persistable {
        return _session_error("invalid opaque inventory cursor");
    }
    let checked=_validated_request(roots, options, true);
    if not checked.ok { return _session_error(checked.error); }
    if not map_has(_sessions, cursor.scan_id) { return _session_error("inventory session unavailable or expired"); }
    let state=_sessions[cursor.scan_id];
    if cursor.complete or cursor.generation != state.generation
    or checked.roots_digest != state.roots_digest
    or cursor.options_digest != checked.options_digest
    or cursor.options_digest != state.options_digest
    or cursor.expires_ms != state.expires_ms {
        return _session_error("stale, replayed, or mismatched inventory cursor");
    }
    return _session_page(state);
}

fn _inventory_close(cursor) {
    if type(cursor) != "map" or type(try cursor.scan_id catch nil) != "string" { return false; }
    if map_has(_sessions, cursor.scan_id) { map_remove(_sessions, cursor.scan_id); return true; }
    return false;
}

fn _serialized(operation) {
    if _session_busy { return _session_error("inventory session operation already in flight"); }
    _session_busy=true;
    let outcome=try { map{ok:true, value:operation()} } catch map{ok:false};
    _session_busy=false;
    if not outcome.ok { return _session_error("inventory session operation failed"); }
    return outcome.value;
}

fn _inventory_collect_pages(roots, options, max_pages) {
    if type(max_pages) != "number" or max_pages != num_floor(max_pages)
    or max_pages < 1 or max_pages > 64 {
        return _session_error("invalid inventory page count");
    }
    let created=_inventory_create(roots, options);
    if not created.ok { return created; }
    let owned_scan_id=created.scan_id;
    let outcome=try { map{ok:true, value:_inventory_collect_owned(
            owned_scan_id, roots, options, max_pages)} } catch map{ok:false};
    if map_has(_sessions, owned_scan_id) { map_remove(_sessions, owned_scan_id); }
    if not outcome.ok { return _session_error("inventory collection failed"); }
    return outcome.value;
}

fn _inventory_collect_owned(owned_scan_id, roots, options, max_pages) {
    if not map_has(_sessions, owned_scan_id) {
        return _session_error("owned inventory session unavailable");
    }
    let page=_session_page(_sessions[owned_scan_id]);
    if not page.ok { return page; }
    let records=[]; let skipped=[]; let pages=0; let last=page;
    while pages < max_pages {
        for record in last.records { array_push(records, record); }
        for row in last.skipped {
            if len(skipped) < 1024 { array_push(skipped, row); }
        }
        pages=pages + 1;
        if last.complete or not last.resumable or pages >= max_pages { break; }
        last=_inventory_resume(last.cursor, roots, options);
        if not last.ok { break; }
    }
    return map{ok:last.ok, format:"pblang.project_inventory.collected.v1",
        roots:roots, records:records, paths:inventory_paths(map{records:records}),
        record_count:len(records), skipped:skipped, skipped_count:len(skipped),
        pages_collected:pages, scanned_dirs:try last.scanned_dirs catch 0,
        scanned_entries:try last.scanned_entries catch 0,
        visited_entries:try last.visited_entries catch 0,
        enqueued_directories:try last.enqueued_directories catch 0,
        complete:try last.complete catch false,
        resumable_after_collection:false,
        truncated:not (try last.complete catch false),
        timed_out:try last.timed_out catch false,
        cursor:nil, checkpoint_persisted:false, snapshot_consistent:false,
        contains_private_paths:true, safe_to_log:false,
        public_cursor_api:false, internal_session_serialized:true,
        hard_wall_timeout:false, hard_heap_bound:false,
        directory_enumerator_allocation_bounded:false,
        stay_on_device_enforced:false, entry_kind_tristate_enforced:false,
        policy:"bounded ephemeral multi-page metadata collection; the collector closes unfinished sessions and never persists cursors or paths"};
}

fn inventory_collect_pages(roots, options = nil, max_pages = 4) {
    return _serialized(fn(){return _inventory_collect_pages(roots, options, max_pages);});
}

fn inventory_paths(report) {
    let out = [];
    let records = try report.records catch [];
    let i = 0;
    while i < len(records) {
        if (try records[i].safe_for_ideas catch false) {
            array_push(out, records[i].path);
        }
        i = i + 1;
    }
    return out;
}

fn inventory_lines(report, limit = 12) {
    if limit == nil or limit < 1 { limit = 12; }
    let r = try report catch map{};
    let lines = [
    "Project inventory: " + str(try r.record_count catch 0) + " metadata record(s)",
    "dirs=" + str(try r.scanned_dirs catch 0) + " entries=" + str(try r.scanned_entries catch 0) + " skipped=" + str(try r.skipped_count catch 0) + " truncated=" + str(try r.truncated catch false) + " timed_out=" + str(try r.timed_out catch false),
    "policy: " + str(try r.policy catch "metadata-only")
    ];
    let recs = try r.records catch [];
    let i = 0;
    while i < len(recs) and len(lines) < limit {
        let rec = recs[i];
        let raw_path = str(try rec.path catch "");
        let safe_path = "";
        let j = 0;
        while j < len(raw_path) {
            let c = strcharcodeat(raw_path, j);
            // Strip terminal controls, C1 controls and Unicode bidi controls.
            if c >= 32 and not (c >= 127 and c <= 159)
            and not (c >= 8234 and c <= 8238)
            and not (c >= 8294 and c <= 8297) {
                safe_path = safe_path + str_slice(raw_path, j, j + 1);
            }
            j = j + 1;
        }
        array_push(lines, "- " + str(try rec.kind catch "?") + " "
        + str(try rec.category catch "?") + " " + safe_path);
        i = i + 1;
    }
    return lines;
}

fn _bool_claim(inv, name, fallback) {
    let value=try inv[name] catch fallback;
    if type(value)!="bool" { return fallback; }
    return value;
}

fn _idea_admission(inv) {
    let blockers=[];
    let complete=_bool_claim(inv,"complete",false);
    let truncated=_bool_claim(inv,"truncated",true);
    let timed_out=_bool_claim(inv,"timed_out",false);
    let hard_heap=_bool_claim(inv,"hard_heap_bound",false);
    let enumerator=_bool_claim(inv,"directory_enumerator_allocation_bounded",false);
    let same_device=_bool_claim(inv,"stay_on_device_enforced",false);
    let tristate=_bool_claim(inv,"entry_kind_tristate_enforced",false);
    let snapshot=_bool_claim(inv,"snapshot_consistent",false);
    if not complete { array_push(blockers, "inventory is incomplete"); }
    if truncated { array_push(blockers, "inventory is truncated"); }
    if timed_out { array_push(blockers, "inventory timed out"); }
    if not hard_heap { array_push(blockers, "hard heap enforcement is absent"); }
    if not enumerator { array_push(blockers, "directory enumeration allocation is unbounded"); }
    if not same_device { array_push(blockers, "stay-on-device traversal is not enforced"); }
    if not tristate { array_push(blockers, "file-directory-symlink-error identity is not enforced"); }
    if not snapshot { array_push(blockers, "namespace snapshot consistency is not verified"); }
    return map{format:"pblang.project_inventory.idea-admission.v1",
        eligible:len(blockers) == 0, complete:complete, truncated:truncated,
        timed_out:timed_out, hard_heap_bound:hard_heap,
        directory_enumerator_allocation_bounded:enumerator,
        stay_on_device_enforced:same_device,
        entry_kind_tristate_enforced:tristate, snapshot_consistent:snapshot,
        blockers:blockers,
        repository_creation_allowed:false, implementation_allowed:false,
        training_allowed:false, external_effects_allowed:false};
}

fn _blocked_action_plan(admission) {
    return map{format:"pblang.project_survey.portfolio_action_plan.v1",
        projects:[], top_tasks:[], idea_admission:admission,
        policy:"inventory cannot influence tasks until the fail-closed idea admission gate passes"};
}

fn _blocked_proposals(admission) {
    return map{format:"pblang.project_survey.proposal_catalog.v1",
        proposals:[], proposal_count:0, repository_creation_allowed:false,
        implementation_allowed:false, complete:false, idea_admission:admission,
        policy:"inventory cannot produce proposals until the fail-closed idea admission gate passes"};
}

fn _blocked_lines(admission) {
    return ["idea admission: blocked",
    "blockers: " + str_join(admission.blockers, "; "),
    "policy: inventory coverage is observable but cannot influence projects, pbAI, training, or external effects"];
}

fn portfolio_action_from_roots(roots, options = nil) {
    if options == nil { options = map{}; }
    let inventory_options=map{};
    for key in ["max_depth", "max_entries", "max_children_per_dir", "include_files", "include_dirs", "max_runtime_ms"] {
        if map_has(options, key) { inventory_options[key]=options[key]; }
    }
    let pages=try options.pages catch 1;
    let inv=nil;
    if type(pages) != "number" or pages != num_floor(pages) or pages < 1 or pages > 64 {
        inv=_session_error("invalid inventory page count");
    } elif pages > 1 {
        for key in ["page_records", "max_pending", "session_ttl_ms"] {
            if map_has(options, key) { inventory_options[key]=options[key]; }
        }
        inv=inventory_collect_pages(roots, inventory_options, pages);
    } else { inv=inventory_roots(roots, inventory_options); }
    let projects = try options.projects catch nil;
    let limit = try options.limit_per_project catch 5;
    let admission=_idea_admission(inv);
    let plan=_blocked_action_plan(admission);
    let proposals=_blocked_proposals(admission);
    let lines=_blocked_lines(admission);
    if admission.eligible {
        plan=SURVEY.portfolio_action_plan(inv.paths, projects, limit);
        proposals=SURVEY.proposal_catalog(inv.records);
        lines=SURVEY.portfolio_action_lines(plan, try options.line_limit catch 18);
    }
    return map{
        format: "pblang.project_inventory.portfolio_action.v1",
        inventory: inv,
        action_plan: plan,
        proposals: proposals,
        idea_admission:admission,
        lines: lines
    };
}

fn _portfolio_summary_error(reason) {
    return map{format:"pblang.project_inventory.portfolio_summary.v1", ok:false,
        error:reason, inventory:map{format:"pblang.project_inventory.aggregate.v1",
            ok:false, record_count:0, skipped_count:0, complete:false, truncated:true,
            timed_out:false, contains_raw_paths:false, terminal_text_safe:true,
            safe_to_log:false}, action_plan:nil,
        proposals:map{format:"pblang.project_survey.proposal_catalog.v1",
            proposals:[], proposal_count:0, repository_creation_allowed:false,
            complete:false}, idea_admission:map{format:"pblang.project_inventory.idea-admission.v1",
            eligible:false, blockers:[reason], repository_creation_allowed:false,
            implementation_allowed:false, training_allowed:false, external_effects_allowed:false},
        lines:[], contains_raw_paths:false,
        terminal_text_safe:true, safe_to_log:false};
}

fn portfolio_action_summary_from_roots(roots, options = nil) {
    if options == nil { options = map{}; }
    let allowed=["max_depth", "max_entries", "max_children_per_dir", "include_files",
    "include_dirs", "max_runtime_ms", "pages", "page_records", "max_pending",
    "session_ttl_ms", "limit_per_project", "line_limit"];
    if not _exact_option_fields(options, allowed) {
        return _portfolio_summary_error("invalid aggregate portfolio options");
    }
    let limit=try options.limit_per_project catch 5;
    let line_limit=try options.line_limit catch 18;
    if type(limit) != "number" or limit != num_floor(limit) or limit < 1 or limit > 16
    or type(line_limit) != "number" or line_limit != num_floor(line_limit)
    or line_limit < 1 or line_limit > 256 {
        return _portfolio_summary_error("invalid aggregate portfolio bounds");
    }
    let inventory_options=map{};
    for key in ["max_depth", "max_entries", "max_children_per_dir", "include_files",
    "include_dirs", "max_runtime_ms"] {
        if map_has(options, key) { inventory_options[key]=options[key]; }
    }
    let pages=try options.pages catch 1;
    let inv=nil;
    if type(pages) != "number" or pages != num_floor(pages) or pages < 1 or pages > 64 {
        inv=_session_error("invalid inventory page count");
    } elif pages > 1 {
        for key in ["page_records", "max_pending", "session_ttl_ms"] {
            if map_has(options, key) { inventory_options[key]=options[key]; }
        }
        inv=inventory_collect_pages(roots, inventory_options, pages);
    } else { inv=inventory_roots(roots, inventory_options); }
    let operation_ok=false;
    if (try inv.format catch "") == "pblang.project_inventory.report.v1" {
        operation_ok=len(try inv.errors catch ["invalid inventory report"]) == 0;
    } elif (try inv.format catch "") == "pblang.project_inventory.collected.v1" {
        operation_ok=(try inv.ok catch false) == true;
    }
    if not operation_ok {
        return _portfolio_summary_error(try inv.error catch "invalid inventory operation");
    }
    let admission=_idea_admission(inv);
    let plan=_blocked_action_plan(admission);
    let proposals=_blocked_proposals(admission);
    if admission.eligible {
        plan=SURVEY.portfolio_action_plan(inv.paths, nil, limit);
        proposals=SURVEY.proposal_catalog(inv.records);
    }
    let projects=[]; let tasks=[];
    for project in try plan.projects catch [] {
        array_push(projects, map{format:project.format, project:project.project,
            focus:project.focus, present_focus:project.present_focus,
            missing_focus:project.missing_focus, tasks:project.tasks,
            task_count:project.task_count, generated_from:"private metadata aggregate"});
    }
    for task in try plan.top_tasks catch [] { array_push(tasks, task); }
    let inventory_summary=map{format:"pblang.project_inventory.aggregate.v1",
        ok:true, record_count:try inv.record_count catch 0,
        skipped_count:try inv.skipped_count catch 0,
        pages_collected:try inv.pages_collected catch 1,
        scanned_dirs:try inv.scanned_dirs catch 0,
        scanned_entries:try inv.scanned_entries catch 0,
        complete:try inv.complete catch false, truncated:try inv.truncated catch true,
        timed_out:try inv.timed_out catch false,
        hard_heap_bound:try inv.hard_heap_bound catch false,
        directory_enumerator_allocation_bounded:try inv.directory_enumerator_allocation_bounded catch false,
        stay_on_device_enforced:try inv.stay_on_device_enforced catch false,
        entry_kind_tristate_enforced:try inv.entry_kind_tristate_enforced catch false,
        snapshot_consistent:try inv.snapshot_consistent catch false,
        contains_raw_paths:false,
        terminal_text_safe:true, safe_to_log:false};
    return map{format:"pblang.project_inventory.portfolio_summary.v1",
        ok:true, inventory:inventory_summary,
        action_plan:map{format:"pblang.project_survey.portfolio_action_summary.v1",
            projects:projects, top_tasks:tasks, policy:"canonical-project aggregate from private metadata"},
        proposals:proposals, idea_admission:admission,
        lines:if admission.eligible { SURVEY.portfolio_action_lines(plan, line_limit) }
        else { _blocked_lines(admission) }, contains_raw_paths:false,
        terminal_text_safe:true, safe_to_log:false,
        policy:"path-free aggregate remains private because counts and category presence can fingerprint projects"};
}

export should_skip_path, inventory_roots, inventory_strict_root, inventory_collect_pages,
inventory_strict_root_stability, inventory_admitted_root_stability,
inventory_paths, inventory_lines,
portfolio_action_from_roots, portfolio_action_summary_from_roots;
