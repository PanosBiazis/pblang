// stdlib/project_inventory.sapp -- bounded metadata-only filesystem inventory.
//
// This module walks directory names only. It never reads file contents. The
// output is safe path metadata for stdlib:project_survey.sapp, which can then
// produce cross-project readiness/action plans for every declared AAP product.

let SURVEY = import("stdlib:project_survey.sapp");
let SECURE = import("stdlib:secure_file.sapp");

let MAX_ROOTS_HARD = 64;
let MAX_DEPTH_HARD = 32;
let MAX_ENTRIES_HARD = 50000;
let MAX_CHILDREN_HARD = 4096;
let MAX_RUNTIME_MS_HARD = 300000;

fn _str(x) { return str(x ?? ""); }

fn _base(path) {
    let parts = str_split(_str(path), "/");
    if len(parts) == 0 { return ""; }
    let b = parts[len(parts) - 1];
    if b == "" and len(parts) > 1 { b = parts[len(parts) - 2]; }
    return b;
}

fn _join(a, b) {
    let left = _str(a);
    let right = _str(b);
    if left == "" { return right; }
    if str_ends_with(left, "/") { return left + right; }
    return left + "/" + right;
}

fn _lower(x) { return str_lower(_str(x)); }

fn _contains_any(text, needles) {
    let t = _lower(text);
    let i = 0;
    while i < len(needles) {
        if str_contains(t, _lower(needles[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn _skip_name(name) {
    let n = _lower(name);
    if n == "" { return true; }
    if n == "." or n == ".." { return true; }
    if n == ".git" or n == ".svn" or n == ".hg" { return true; }
    if n == ".ssh" or n == ".gnupg" or n == ".cache" { return true; }
    if n == ".claude" or n == ".codex" { return true; }
    if n == "target" or n == "node_modules" or n == "__pycache__" or n == ".venv"
        or n == "venv" or str_ends_with(n, "-venv") or n == "site-packages" { return true; }
    if n == "vendor" or n == "pods" or n == ".gradle" or n == ".idea"
        or n == "deriveddata" { return true; }
    if n == ".obsidian" or n == ".next" or n == ".pytest_cache"
        or n == ".mypy_cache" or n == ".ruff_cache" or n == ".tox" or n == ".nox" { return true; }
    if n == "cache" or n == "tmp" or n == "temp" or n == "build" or n == "dist"
        or n == "obj" or n == "bin" or n == "out" or n == "coverage"
        or n == "artifacts" or n == "reports" or n == "logs" { return true; }
    if n == "graphify-out" { return true; }
    if str_contains(n, "credential") or str_contains(n, "password") or str_contains(n, "passwd") { return true; }
    if str_contains(n, "secret") or str_contains(n, "token") or str_contains(n, "openrouter") { return true; }
    if str_starts_with(n, "id_ed25519") or str_starts_with(n, "id_rsa") { return true; }
    if str_ends_with(n, ".pem") or str_ends_with(n, ".p12") or str_ends_with(n, ".pfx") or str_ends_with(n, ".key") { return true; }
    return false;
}

fn _path_has_skipped_component(path) {
    let parts = str_split(_str(path), "/");
    let i = 0;
    while i < len(parts) {
        let n = _lower(parts[i]);
        if n != "" and n != "." and n != ".." and _skip_name(n) { return true; }
        i = i + 1;
    }
    return false;
}

fn should_skip_path(path) {
    let p = _str(path);
    if p == "." or p == "./" or p == ".." or p == "../" { return false; }
    if SURVEY.sensitive_path(path) { return true; }
    return _path_has_skipped_component(path);
}

fn _is_dir(path) {
    let listed = SECURE.list_directory(path, 1);
    return try listed.ok catch false;
}

fn _bounded_listdir(path, max_children) {
    let listed = SECURE.list_directory(path, max_children);
    if not (try listed.ok catch false) { return nil; }
    return map{ entries: _bounded_entries(listed.entries, max_children),
        truncated: try listed.truncated catch false };
}

fn _bounded_entries(raw, max_children) {
    if max_children == nil or max_children < 1 { max_children = 200; }
    let out = [];
    let i = 0;
    while i < len(raw) and i < max_children {
        array_push(out, raw[i]);
        i = i + 1;
    }
    return out;
}

fn _record(path, kind, depth, parent) {
    return map{
        format: "pblang.project_inventory.path.v1",
        path: path,
        name: _base(path),
        kind: kind,
        depth: depth,
        parent: parent,
        category: SURVEY.path_category(path),
        safe_for_ideas: not SURVEY.sensitive_path(path)
    };
}

fn inventory_roots(roots, options = nil) {
    if roots == nil { roots = ["."]; }
    if options == nil { options = map{}; }
    let max_depth = try options.max_depth catch 4;
    let max_entries = try options.max_entries catch 1000;
    let max_children = try options.max_children_per_dir catch 200;
    let include_files = try options.include_files catch true;
    let include_dirs = try options.include_dirs catch true;
    let max_runtime_ms = try options.max_runtime_ms catch 30000;
    let valid_limits = type(roots) == "array" and len(roots) >= 1 and len(roots) <= MAX_ROOTS_HARD
        and type(max_depth) == "number" and max_depth == num_floor(max_depth)
        and max_depth >= 0 and max_depth <= MAX_DEPTH_HARD
        and type(max_entries) == "number" and max_entries == num_floor(max_entries)
        and max_entries >= 1 and max_entries <= MAX_ENTRIES_HARD
        and type(max_children) == "number" and max_children == num_floor(max_children)
        and max_children >= 1 and max_children <= MAX_CHILDREN_HARD
        and type(max_runtime_ms) == "number" and max_runtime_ms == num_floor(max_runtime_ms)
        and max_runtime_ms >= 10 and max_runtime_ms <= MAX_RUNTIME_MS_HARD;
    if not valid_limits {
        return map{ format: "pblang.project_inventory.report.v1", roots: [], records: [], paths: [],
            record_count: 0, scanned_dirs: 0, scanned_entries: 0, skipped: [], skipped_count: 0,
            errors: ["invalid bounded inventory request"], timed_out: false, duration_ms: 0,
            max_runtime_ms: 0, truncated: true, complete: false,
            policy: "invalid requests fail closed before filesystem access" };
    }
    let started_ms = now_ms(); let deadline_ms = started_ms + max_runtime_ms;

    let records = [];
    let skipped = [];
    let errors = [];
    let queue = [];
    let ri = 0;
    while ri < len(roots) {
        let root = _str(roots[ri]);
        if root != "" {
            if should_skip_path(root) {
                array_push(skipped, map{ path: SURVEY.path_record(root).path, reason: "sensitive/pruned root" });
            } else {
                array_push(queue, map{ path: root, depth: 0, parent: "" });
            }
        }
        ri = ri + 1;
    }

    let q = 0;
    let scanned_dirs = 0;
    let scanned_entries = 0;
    let truncated = false;
    let timed_out = false;
    while q < len(queue) and len(records) < max_entries and now_ms() < deadline_ms {
        let cur = queue[q];
        q = q + 1;
        let path = _str(cur.path);
        let depth = try cur.depth catch 0;
        let parent = _str(try cur.parent catch "");
        let listing = try cur.listing catch nil;
        if type(listing) != "map" { listing = _bounded_listdir(path, max_children); }
        if listing == nil {
            if include_files {
                array_push(records, _record(path, "file", depth, parent));
            }
            continue;
        }
        let entries = listing.entries;
        if try listing.truncated catch false { truncated = true; }

        scanned_dirs = scanned_dirs + 1;
        if include_dirs {
            array_push(records, _record(path, "dir", depth, parent));
        }
        if len(records) >= max_entries { truncated = true; break; }
        if depth >= max_depth { continue; }

        let i = 0;
        while i < len(entries) and len(records) < max_entries and now_ms() < deadline_ms {
            let name = _str(entries[i]);
            let child = _join(path, name);
            scanned_entries = scanned_entries + 1;
            if should_skip_path(child) {
                array_push(skipped, map{ path: SURVEY.path_record(child).path, reason: "sensitive/pruned path" });
                i = i + 1;
                continue;
            }
            let child_listing = _bounded_listdir(child, max_children);
            if type(child_listing) == "map" {
                if depth + 1 < max_depth {
                    array_push(queue, map{ path: child, depth: depth + 1, parent: path,
                        listing: child_listing });
                } else if include_dirs {
                    array_push(records, _record(child, "dir", depth + 1, path));
                }
            } else if include_files {
                array_push(records, _record(child, "file", depth + 1, path));
            }
            i = i + 1;
        }
        if now_ms() >= deadline_ms { timed_out = true; truncated = true; }
        if try listing.truncated catch false { truncated = true; }
    }
    if now_ms() >= deadline_ms { timed_out = true; truncated = true; }
    if q < len(queue) { truncated = true; }

    return map{
        format: "pblang.project_inventory.report.v1",
        roots: roots,
        records: records,
        paths: inventory_paths(map{ records: records }),
        record_count: len(records),
        scanned_dirs: scanned_dirs,
        scanned_entries: scanned_entries,
        skipped: skipped,
        skipped_count: len(skipped),
        errors: errors,
        timed_out: timed_out,
        duration_ms: now_ms() - started_ms,
        max_runtime_ms: max_runtime_ms,
        truncated: truncated,
        complete: not truncated and len(errors) == 0,
        policy: "metadata-only no-follow directory inventory; no file contents are read; sensitive/cache/build/generated-output/local assistant and vendored dependency paths are skipped; traversal has hard entry/root/depth limits and a cooperative deadline"
    };
}

fn inventory_paths(report) {
    let out = [];
    let records = try report.records catch [];
    let i = 0;
    while i < len(records) {
        if (try records[i].safe_for_ideas catch false) {
            array_push(out, records[i].path);
        }
        i = i + 1;
    }
    return out;
}

fn inventory_lines(report, limit = 12) {
    if limit == nil or limit < 1 { limit = 12; }
    let r = try report catch map{};
    let lines = [
        "Project inventory: " + str(try r.record_count catch 0) + " metadata record(s)",
        "dirs=" + str(try r.scanned_dirs catch 0) + " entries=" + str(try r.scanned_entries catch 0) + " skipped=" + str(try r.skipped_count catch 0) + " truncated=" + str(try r.truncated catch false) + " timed_out=" + str(try r.timed_out catch false),
        "policy: " + str(try r.policy catch "metadata-only")
    ];
    let recs = try r.records catch [];
    let i = 0;
    while i < len(recs) and len(lines) < limit {
        let rec = recs[i];
        let raw_path = str(try rec.path catch "");
        let safe_path = "";
        let j = 0;
        while j < len(raw_path) {
            let c = strcharcodeat(raw_path, j);
            // Strip terminal controls, C1 controls and Unicode bidi controls.
            if c >= 32 and not (c >= 127 and c <= 159)
               and not (c >= 8234 and c <= 8238)
               and not (c >= 8294 and c <= 8297) {
                safe_path = safe_path + str_slice(raw_path, j, j + 1);
            }
            j = j + 1;
        }
        array_push(lines, "- " + str(try rec.kind catch "?") + " "
            + str(try rec.category catch "?") + " " + safe_path);
        i = i + 1;
    }
    return lines;
}

fn portfolio_action_from_roots(roots, options = nil) {
    if options == nil { options = map{}; }
    let inv = inventory_roots(roots, options);
    let projects = try options.projects catch nil;
    let limit = try options.limit_per_project catch 5;
    let plan = SURVEY.portfolio_action_plan(inv.paths, projects, limit);
    return map{
        format: "pblang.project_inventory.portfolio_action.v1",
        inventory: inv,
        action_plan: plan,
        proposals: SURVEY.proposal_catalog(inv.records),
        lines: SURVEY.portfolio_action_lines(plan, try options.line_limit catch 18)
    };
}

export should_skip_path, inventory_roots, inventory_paths, inventory_lines, portfolio_action_from_roots;
