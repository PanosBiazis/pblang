// stdlib/img_load.sapp — load real pixels for the GUI image widget.
//
// pblang has no native image decoder, but a binary PPM (P6) is trivial to parse, and
// ImageMagick `convert` turns any format (PNG/JPEG/...) into a small PPM. So:
//   to_thumbnail(path, w, h) -> convert+resize to a tiny PPM, then load_ppm().
// Images are returned in the image_processing/gui format: a 2D array of rows of packed
// colors (gfx.rgb), i.e. img[y][x].

let gfx = import("stdlib:graphics.sapp");

// exit_code of a proc result (1 if missing). A standalone helper avoids a pblang parser
// issue with a parenthesized `try ... catch` inside a compound boolean condition.
fn _ec(r) { if r == nil { return 1; } let e = try r.exit_code catch 1; return e; }

fn _next_int(bytes, pos) {
    let n = len(bytes);
    while pos.i < n {
        let b = bytes[pos.i];
        if b == 35 {                                   // '#' comment to end of line
            while pos.i < n and bytes[pos.i] != 10 { pos.i = pos.i + 1; }
        } else if b == 32 or b == 9 or b == 10 or b == 13 {
            pos.i = pos.i + 1;
        } else { break; }
    }
    let v = 0;
    while pos.i < n and bytes[pos.i] >= 48 and bytes[pos.i] <= 57 {
        v = v * 10 + (bytes[pos.i] - 48);
        pos.i = pos.i + 1;
    }
    return v;
}

// Parse binary PPM (P6) bytes -> 2D pixel array (img[y][x] = gfx.rgb), or nil.
fn parse_ppm(bytes) {
    let n = len(bytes);
    if n < 2 or bytes[0] != 80 or bytes[1] != 54 { return nil; }   // "P6"
    let pos = map{ i: 2 };
    let w = _next_int(bytes, pos);
    let h = _next_int(bytes, pos);
    let maxv = _next_int(bytes, pos);
    if w <= 0 or h <= 0 or maxv <= 0 { return nil; }
    let idx = pos.i + 1;                                // single whitespace after maxval
    if idx + w * h * 3 > n { return nil; }              // truncated
    let img = [];
    let y = 0;
    while y < h {
        let row = [];
        let x = 0;
        while x < w {
            array_push(row, gfx.rgb(bytes[idx], bytes[idx + 1], bytes[idx + 2]));
            idx = idx + 3;
            x = x + 1;
        }
        array_push(img, row);
        y = y + 1;
    }
    return img;
}

fn load_ppm(path) {
    let bytes = try fs_read_bytes(path) catch nil;
    if bytes == nil { return nil; }
    return parse_ppm(bytes);
}

// Convert ANY image at `path` to an exact w×h PPM thumbnail via ImageMagick, then load.
// Returns nil if convert is unavailable/fails (caller shows a placeholder).
fn to_thumbnail(path, w, h) {
    let tmp = "/tmp/pb_thumb.ppm";
    // -depth 8 forces an 8-bit (maxval 255) PPM; without it ImageMagick may emit a
    // 16-bit PPM that the 8-bit parser would mis-read.
    let r = try proc_spawn_wait("convert", [path, "-resize", str(w) + "x" + str(h) + "!", "-depth", "8", tmp]) catch nil;
    if r == nil or _ec(r) != 0 { return nil; }
    return load_ppm(tmp);
}

// is_ppm(bytes) — true if the byte array starts with the binary PPM magic "P6".
fn is_ppm(bytes) {
    return len(bytes) >= 2 and bytes[0] == 80 and bytes[1] == 54;
}

// dimensions(img) — { width, height } of a parsed 2D image grid.
fn dimensions(img) {
    let h = len(img);
    let w = 0;
    if h > 0 { w = len(img[0]); }
    return map{ width: w, height: h };
}

// ── wave 2: magic-byte format detection + aspect ratio ───────────────────────────

fn _b(bytes, i) { if i >= len(bytes) { return -1; } return bytes[i]; }

// is_png(bytes) — PNG signature: 89 50 4E 47 0D 0A 1A 0A.
fn is_png(bytes) {
    return _b(bytes, 0) == 137 and _b(bytes, 1) == 80 and _b(bytes, 2) == 78 and _b(bytes, 3) == 71;
}

// is_jpeg(bytes) — JPEG SOI marker FF D8.
fn is_jpeg(bytes) { return _b(bytes, 0) == 255 and _b(bytes, 1) == 216; }

// is_gif(bytes) — "GIF8".
fn is_gif(bytes) {
    return _b(bytes, 0) == 71 and _b(bytes, 1) == 73 and _b(bytes, 2) == 70 and _b(bytes, 3) == 56;
}

// is_bmp(bytes) — "BM".
fn is_bmp(bytes) { return _b(bytes, 0) == 66 and _b(bytes, 1) == 77; }

// format_of(bytes) — detect image type from the leading magic bytes.
fn format_of(bytes) {
    if is_png(bytes) { return "png"; }
    if is_jpeg(bytes) { return "jpeg"; }
    if is_gif(bytes) { return "gif"; }
    if is_bmp(bytes) { return "bmp"; }
    if is_ppm(bytes) { return "ppm"; }
    return "unknown";
}

// aspect_ratio(img) — width / height of a parsed 2D image grid (0 if empty).
fn aspect_ratio(img) {
    let h = len(img);
    if h == 0 { return 0; }
    let w = len(img[0]);
    return w / h;
}

export parse_ppm, load_ppm, to_thumbnail, is_ppm, dimensions;
export is_png, is_jpeg, is_gif, is_bmp, format_of, aspect_ratio;
