//! registry_server.sapp — Simple package registry HTTP server for pblang

fn RegistryConfig(data_dir = "./registry_data") {
    return map{ data_dir: data_dir, packages_dir: data_dir + "/packages", index_file: data_dir + "/index.json" };
}

// fs_mkdirs returns nil and THROWS on failure — the old `let ok = fs_mkdirs(..)`
// bindings were always nil and init returned true even when nothing was created.
fn _make_dirs(config) {
    fs_mkdirs(config.data_dir);
    fs_mkdirs(config.packages_dir);
    return true;
}

fn registry_init(config) {
    if (try _make_dirs(config) catch false) != true { return false; }
    if not fs_exists(config.index_file) {
        fs_write(config.index_file, json_stringify(map{packages: [], updated: 0}));
    }
    return true;
}

fn registry_load_index(config) {
    if not fs_exists(config.index_file) { return map{packages: [], updated: 0}; }
    return json_parse(fs_read(config.index_file));
}

fn registry_save_index(config, index) {
    index.updated = now_ms();
    fs_write(config.index_file, json_stringify(index));
}

// _safe_component(s) — a package name/version must be a single safe path component
// (no separators, no "..", no NUL) so it can't escape packages_dir when used to build
// the destination filename.
fn _safe_component(s) {
    if type(s) != "string" or s == "" { return false; }
    if s == "." { return false; }
    if str_contains(s, "/") or str_contains(s, "\\") or str_contains(s, "..") or str_contains(s, "\x00") {
        return false;
    }
    return true;
}

fn registry_add_package(config, name, version, description, author, tarball) {
    // SECURITY: dest = packages_dir + "/" + name + "-" + version + ".tar.gz" is written
    // via fs_copy; an unvalidated name/version like "../evil" or "a/b" would let the
    // tarball be written OUTSIDE packages_dir (arbitrary file write). Reject up front.
    if not _safe_component(name) or not _safe_component(version) {
        return false;
    }
    let index = registry_load_index(config);
    let found = false;
    let i = 0;
    while i < len(index.packages) {
        if index.packages[i].name == name {
            index.packages[i].version = version;
            index.packages[i].description = description;
            index.packages[i].author = author;
            index.packages[i].updated = now_ms();
            found = true;
        }
        i = i + 1;
    }
    if not found {
        array_push(index.packages, map{name: name, version: version, description: description, author: author, created: now_ms(), updated: now_ms(), downloads: 0});
    }
    let dest = config.packages_dir + "/" + name + "-" + version + ".tar.gz";
    fs_copy(tarball, dest);
    registry_save_index(config, index);
    return true;
}

fn registry_search(config, query) {
    let index = registry_load_index(config);
    let results = [];
    let i = 0;
    while i < len(index.packages) {
        if str_contains(index.packages[i].name, query) { array_push(results, index.packages[i]); }
        i = i + 1;
    }
    return results;
}

fn registry_get_package(config, name) {
    let index = registry_load_index(config);
    let i = 0;
    while i < len(index.packages) {
        if index.packages[i].name == name { return index.packages[i]; }
        i = i + 1;
    }
    return nil;
}

fn registry_list_packages(config) { return registry_load_index(config).packages; }

// package_count(config) — number of packages in the index.
fn package_count(config) { return len(registry_load_index(config).packages); }

// has_package(config, name) — is a package with this name in the index?
fn has_package(config, name) {
    let pkgs = registry_load_index(config).packages;
    let i = 0;
    while i < len(pkgs) { if pkgs[i].name == name { return true; } i = i + 1; }
    return false;
}

fn registry_serve(config, port = 8099) {
    let addr = "0.0.0.0:" + str(port);
    let listener = tcp_listen(addr);
    if listener == nil { print("ERR: cannot listen on " + addr); return false; }
    print("pblang Registry http://" + addr);
    while true {
        let conn = tcp_accept(listener);
        if conn != nil {
            spawn(fn() {
                let raw = tcp_read(conn, 8192);
                if raw != "" and raw != nil {
                    let method = "";
                    let path = "";
                    let k = 0;
                    while k < len(raw) and raw[k..(k+1)] != " " { method = method + raw[k..(k+1)]; k = k + 1; }
                    k = k + 1;
                    while k < len(raw) and raw[k..(k+1)] != " " { path = path + raw[k..(k+1)]; k = k + 1; }
                    let body = "{}";
                    if path == "/packages" { body = json_stringify(registry_list_packages(config)); }
                    if str_starts_with(path, "/packages/") {
                        let name = path[10..];
                        let pkg = registry_get_package(config, name);
                        body = json_stringify(if pkg == nil { map{error: "not found"} } else { pkg });
                    }
                    if str_starts_with(path, "/search") {
                        let q = "";
                        if str_contains(path, "?q=") { q = path[str_index_of(path, "?q=") + 3..]; }
                        body = json_stringify(registry_search(config, q));
                    }
                    tcp_write(conn, "HTTP/1.1 200 OK
Content-Type: application/json
Access-Control-Allow-Origin: *
Content-Length: " + str(len(body)) + "

" + body);
                }
                tcp_close(conn);
            });
        }
    }
}

export RegistryConfig;
export registry_init;
export registry_add_package;
export registry_search;
export registry_get_package;
export registry_list_packages;
export registry_serve;
export package_count, has_package;
