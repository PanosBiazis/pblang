//! registry_server.sapp — Simple package registry HTTP server for pblang

fn RegistryConfig(data_dir) {
    if data_dir == nil { data_dir = "./registry_data"; }
    return map{ data_dir: data_dir, packages_dir: data_dir + "/packages", index_file: data_dir + "/index.json" };
}

fn registry_init(config) {
    let ok = fs_mkdir(config.data_dir);
    let ok2 = fs_mkdir(config.packages_dir);
    if not fs_exists(config.index_file) {
        fs_write(config.index_file, json_stringify({packages: [], updated: 0}));
    }
    return true;
}

fn registry_load_index(config) {
    if not fs_exists(config.index_file) { return map{packages: [], updated: 0}; }
    return json_parse(fs_read(config.index_file));
}

fn registry_save_index(config, index) {
    index.updated = time_now_ms();
    fs_write(config.index_file, json_stringify(index));
}

fn registry_add_package(config, name, version, description, author, tarball) {
    let index = registry_load_index(config);
    let found = false;
    let i = 0;
    while i < index.len(packages) {
        if index.packages[i].name == name {
            index.packages[i].version = version;
            index.packages[i].description = description;
            index.packages[i].author = author;
            index.packages[i].updated = time_now_ms();
            found = true;
        }
        i = i + 1;
    }
    if not found {
        index.array_push(packages, {name: name, version: version, description: description, author: author, created: time_now_ms(), updated: time_now_ms(), downloads: 0});
    }
    let dest = config.packages_dir + "/" + name + "-" + version + ".tar.gz";
    fs_copy(tarball, dest);
    registry_save_index(config, index);
    return true;
}

fn registry_search(config, query) {
    let index = registry_load_index(config);
    let results = [];
    let i = 0;
    while i < index.len(packages) {
        if index.packages[i].str_contains(name, query) { array_push(results, index.packages[i]); }
        i = i + 1;
    }
    return results;
}

fn registry_get_package(config, name) {
    let index = registry_load_index(config);
    let i = 0;
    while i < index.len(packages) {
        if index.packages[i].name == name { return index.packages[i]; }
        i = i + 1;
    }
    return nil;
}

fn registry_list_packages(config) { return registry_load_index(config).packages; }

fn registry_serve(config, port) {
    if port == nil { port = 8099; }
    let addr = "0.0.0.0:" + str(port);
    let listener = tcp_listen(addr);
    if listener == nil { print("ERR: cannot listen on " + addr); return false; }
    print("pblang Registry http://" + addr);
    while true {
        let conn = tcp_accept(listener);
        if conn != nil {
            spawn(fn() {
                let raw = tcp_read(conn, 8192);
                if raw != "" and raw != nil {
                    let method = "";
                    let path = "";
                    let k = 0;
                    while k < len(raw) and raw[k..(k+1)] != " " { method = method + raw[k..(k+1)]; k = k + 1; }
                    k = k + 1;
                    while k < len(raw) and raw[k..(k+1)] != " " { path = path + raw[k..(k+1)]; k = k + 1; }
                    let body = "{}";
                    if path == "/packages" { body = json_stringify(registry_list_packages(config)); }
                    if str_starts_with(path, "/packages/") {
                        let name = path[10..];
                        let pkg = registry_get_package(config, name);
                        body = json_stringify(if pkg == nil { {error: "not found"} } else { pkg });
                    }
                    if str_starts_with(path, "/search") {
                        let q = "";
                        if str_contains(path, "?q=") { q = path[str_index_of(path, "?q=") + 3..]; }
                        body = json_stringify(registry_search(config, q));
                    }
                    tcp_write(conn, "HTTP/1.1 200 OK
Content-Type: application/json
Access-Control-Allow-Origin: *
Content-Length: " + str(len(body)) + "

" + body);
                }
                tcp_close(conn);
            });
        }
    }
}

export RegistryConfig;
export registry_init;
export registry_add_package;
export registry_search;
export registry_get_package;
export registry_list_packages;
export registry_serve;
