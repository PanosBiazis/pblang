// stdlib/pkg.sapp — a package/manifest system for pblang (ecosystem foundation).
//
// pblang's biggest adoption gap is the lack of a package manager. This is the
// foundation: a manifest format, semantic-version handling, validation, and
// dependency resolution that builds on the import system (a dep is a module path
// that must exist on disk). A registry/fetch layer can be added on top later.
//
//   let pkg = import("stdlib:pkg.sapp");
//   let m = pkg.manifest("mylib", "1.2.0", ["stdlib:functional.sapp"]);
//   pkg.validate(m).ok                       // true
//   pkg.resolve(m).missing                   // []  (all deps found)
//   pkg.semver_satisfies("1.4.2", "^1.2.0")  // true
//
// Implemented entirely in pblang.

// ── Manifest ─────────────────────────────────────────────────────────────────────
// A manifest is a plain map; `manifest(...)` builds the canonical shape.
fn manifest(name, version, deps) {
    return map{ name: name, version: version, deps: deps, kind: "package" };
}

// ── Semantic versioning ────────────────────────────────────────────────────────────
// Parse "MAJOR.MINOR.PATCH" → [maj, min, patch]; missing parts default to 0.
fn semver_parse(v) {
    let parts = str_split(v, ".");
    let out = [0, 0, 0];
    let i = 0;
    while i < len(parts) and i < 3 {
        let n = try parse_number(parts[i]) catch nil;
        if is_number(n) { out[i] = num_floor(n); }
        i = i + 1;
    }
    return out;
}

// Compare two version strings: -1 if a<b, 0 if equal, 1 if a>b.
fn semver_compare(a, b) {
    let pa = semver_parse(a);
    let pb = semver_parse(b);
    let i = 0;
    while i < 3 {
        if pa[i] < pb[i] { return 0 - 1; }
        if pa[i] > pb[i] { return 1; }
        i = i + 1;
    }
    return 0;
}

// Does `version` satisfy `constraint`? Supports:
//   "1.2.3"   exact
//   "^1.2.3"  >=1.2.3 and <2.0.0   (compatible-with — caret)
//   "~1.2.3"  >=1.2.3 and <1.3.0   (approximately — tilde)
//   ">=1.2.3" at least
//   "*"       any
fn semver_satisfies(version, constraint) {
    if constraint == "*" or constraint == "" { return true; }
    let c0 = str_slice(constraint, 0, 1);
    if c0 == "^" {
        let base = str_slice(constraint, 1, len(constraint));
        let pb = semver_parse(base);
        let pv = semver_parse(version);
        if semver_compare(version, base) < 0 { return false; }   // >= base
        return pv[0] == pb[0];                                    // same major
    }
    if c0 == "~" {
        let base = str_slice(constraint, 1, len(constraint));
        let pb = semver_parse(base);
        let pv = semver_parse(version);
        if semver_compare(version, base) < 0 { return false; }
        return pv[0] == pb[0] and pv[1] == pb[1];                 // same major.minor
    }
    if str_starts_with(constraint, ">=") {
        let base = str_slice(constraint, 2, len(constraint));
        return semver_compare(version, base) >= 0;
    }
    return semver_compare(version, constraint) == 0;             // exact
}

// ── Validation ─────────────────────────────────────────────────────────────────────
fn _is_valid_semver(v) {
    if not is_string(v) { return false; }
    let parts = str_split(v, ".");
    if len(parts) < 1 { return false; }
    let i = 0;
    while i < len(parts) {
        let n = try parse_number(parts[i]) catch nil;
        if not is_number(n) { return false; }
        i = i + 1;
    }
    return true;
}

// validate(m) → { ok, errors }.
fn validate(m) {
    let errors = [];
    if not map_has(m, "name") or not is_string(m.name) or m.name == "" {
        push(errors, "manifest: missing or empty 'name'");
    }
    if not map_has(m, "version") or not _is_valid_semver(try m.version catch nil) {
        push(errors, "manifest: 'version' must be semver (e.g. 1.2.0)");
    }
    if not map_has(m, "deps") or not is_array(try m.deps catch nil) {
        push(errors, "manifest: 'deps' must be an array of module paths");
    }
    return map{ ok: len(errors) == 0, errors: errors };
}

// ── Dependency resolution ─────────────────────────────────────────────────────────
// Map a dependency token to a file path: "stdlib:foo.sapp" → "stdlib/foo.sapp".
fn dep_path(dep) {
    if str_starts_with(dep, "stdlib:") { return "stdlib/" + str_slice(dep, 7, len(dep)); }
    return dep;
}

// resolve(m) → { resolved: [paths], missing: [deps] } — checks each dep exists on
// disk (a dep that can't be read is "missing"). Foundation for a real installer.
fn resolve(m) {
    let resolved = [];
    let missing = [];
    let deps = try m.deps catch [];
    let i = 0;
    while i < len(deps) {
        let p = dep_path(deps[i]);
        let content = try fs_read(p) catch nil;   // fs_read throws if the file is absent
        if content == nil or content == "" { push(missing, deps[i]); }
        else { push(resolved, p); }
        i = i + 1;
    }
    return map{ resolved: resolved, missing: missing, ok: len(missing) == 0 };
}

// ── semver extras ────────────────────────────────────────────────────────────────
fn _all_digits(s) {
    if len(s) == 0 { return false; }
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

// semver_valid(v) — true for exactly three numeric, dot-separated components.
fn semver_valid(v) {
    let parts = str_split(v, ".");
    if len(parts) != 3 { return false; }
    let i = 0;
    while i < 3 { if not _all_digits(parts[i]) { return false; } i = i + 1; }
    return true;
}

// semver_inc(v, kind) — bump "major" | "minor" | "patch" (resets lower components).
fn semver_inc(v, kind) {
    let p = semver_parse(v);
    if kind == "major" { p = [p[0] + 1, 0, 0]; }
    else if kind == "minor" { p = [p[0], p[1] + 1, 0]; }
    else { p = [p[0], p[1], p[2] + 1]; }
    return str(p[0]) + "." + str(p[1]) + "." + str(p[2]);
}

// semver_max(list) — the highest version in a list (nil if empty).
fn semver_max(list) {
    if len(list) == 0 { return nil; }
    let best = list[0];
    let i = 1;
    while i < len(list) {
        if semver_compare(list[i], best) > 0 { best = list[i]; }
        i = i + 1;
    }
    return best;
}

// semver_parse_full(v) — full parse: { major, minor, patch, prerelease, build }.
// Splits "1.2.3-alpha.1+build.5" into core / -prerelease / +build (both "" if absent).
fn semver_parse_full(v) {
    let build = "";
    let core = v;
    let plus = str_index_of(v, "+");
    if plus >= 0 { core = str_slice(v, 0, plus); build = str_slice(v, plus + 1, len(v)); }
    let pre = "";
    let ver = core;
    let dash = str_index_of(core, "-");
    if dash >= 0 { ver = str_slice(core, 0, dash); pre = str_slice(core, dash + 1, len(core)); }
    let p = semver_parse(ver);
    return map{ major: p[0], minor: p[1], patch: p[2], prerelease: pre, build: build };
}

// semver_is_prerelease(v) — true if v carries a -prerelease tag.
fn semver_is_prerelease(v) { return semver_parse_full(v).prerelease != ""; }

export manifest, semver_parse, semver_compare, semver_satisfies;
export validate, dep_path, resolve;
export semver_valid, semver_inc, semver_max;
export semver_parse_full, semver_is_prerelease;
