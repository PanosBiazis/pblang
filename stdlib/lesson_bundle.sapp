// One source document and explicit initial date; slides/cards are derived, not duplicated.
let Text=import("stdlib:text_document.sapp"); let Slides=import("stdlib:slide_document.sapp");
let Study=import("stdlib:study_cards.sapp"); let Serialization=import("stdlib:serialization.sapp");
let FORMAT="pblang.lesson.v1"; let MAX_FILE_BYTES=262144;
fn create(document,date) {
    let doc=Text.copy(document); Slides.from_document(doc); Study.from_document(doc,date);
    return map{format:FORMAT,date:date,document:doc};
}
fn validate(bundle) {
    if type(bundle)!="map" or len(bundle)!=3 or not map_has(bundle,"format") or bundle.format!=FORMAT
        or not map_has(bundle,"date") or not map_has(bundle,"document") { throw "lesson: invalid bundle"; }
    create(bundle.document,bundle.date); return true;
}
fn slides(bundle) { validate(bundle); return Slides.from_document(bundle.document); }
fn cards(bundle) { validate(bundle); return Study.from_document(bundle.document,bundle.date); }
fn _limits() { return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:6,max_items:600,strict:true,reject_duplicate_keys:true}; }
fn encode(bundle) {
    validate(bundle); let r=Serialization.stringify_safe(bundle,"json",_limits()); if not r.ok { throw "lesson: encoding failed"; } return r.value;
}
fn decode(text) {
    let r=Serialization.parse_safe(text,"json",_limits()); if not r.ok or not r.duplicate_keys_checked { throw "lesson: invalid file"; }
    validate(r.value); return create(r.value.document,r.value.date);
}
export FORMAT,MAX_FILE_BYTES,create,validate,slides,cards,encode,decode;
