// Trusted application setup supplies a top-level imported native module.
// No imports, provider calls, model construction, paths or capability grants here.
fn _operations() {
 return ["train","predict","session","distill","distill_supervised",
  "student_encode","student_decode","student_load","student_continue",
  "student_history","student_history_encode","student_history_decode",
  "student_continue_reviewed","student_tool"];
}
fn _report() {
 return map{format:"pbai.neural.specialist-binding.v1",binding_scope:"explicit-trusted-host-module",
  operations:_operations(),exports_checked:true,validation:"native-module-callable-exports",
  provider_authenticated:false,numeric_inference_checked:false,provider_called_during_bind:false,
  automatic_training:false,automatic_persistence:false,globally_activated:false,authorizes_action:false};
}
fn bind(provider) {
 // Reject maps/callbacks/cyclic or serialized requests without inspecting their members.
 if type(provider)!="module" {throw "specialist binding requires a trusted native module";}
 // Snapshot only the fixed computational surface; never return a partial binding.
 let methods=try map{
  train:provider.train,predict:provider.predict,session:provider.session,
  distill:provider.distill,distill_supervised:provider.distill_supervised,
  student_encode:provider.student_encode,student_decode:provider.student_decode,
  student_load:provider.student_load,student_continue:provider.student_continue,
  student_history:provider.student_history,student_history_encode:provider.student_history_encode,
  student_history_decode:provider.student_history_decode,
  student_continue_reviewed:provider.student_continue_reviewed,student_tool:provider.student_tool
 } catch nil;
 if methods==nil {throw "incompatible specialist exports";}
 for name in _operations() {
  let kind=type(methods[name]);
  if kind!="fn" and kind!="closure" {throw "incompatible specialist exports";}
 }
 // Values are the selected provider's captured functions, with existing arity/defaults.
 // A fresh fixed report exposes no module paths, provider objects or request payloads.
 methods.report=_report;
 return methods;
}
export bind;

// Storage is opt-in and separate from the computation-only binding.
fn _checkpoint_report() {
 return map{format:"pbai.neural.checkpoint-binding.v1",binding_scope:"explicit-trusted-host-module",
  operations:["save_new","load_file"],exports_checked:true,validation:"native-module-callable-exports",
  provider_authenticated:false,storage_guarantees_verified:false,provider_called_during_bind:false,
  automatic_training:false,automatic_persistence:false,globally_activated:false,authorizes_action:false};
}
fn bind_checkpoint(provider) {
 if type(provider)!="module" {throw "checkpoint binding requires a trusted native module";}
 let methods=try map{save_new:provider.save_new,load_file:provider.load_file} catch nil;
 if methods==nil {throw "incompatible checkpoint exports";}
 for name in ["save_new","load_file"] {
  let kind=type(methods[name]);
  if kind!="fn" and kind!="closure" {throw "incompatible checkpoint exports";}
 }
 methods.report=_checkpoint_report;
 return methods;
}
export bind_checkpoint;

// Optional scope binding leaves the original two-method storage binding intact.
fn _checkpoint_scope_report() {
 let report=_checkpoint_report();report.format="pbai.neural.checkpoint-scope-binding.v1";
 report.operations=["with_file"];report.result_contract="resource_scope";
 report.cleanup_scope="one-loaded-handle";return report;
}
fn bind_checkpoint_scope(provider) {
 if type(provider)!="module" {throw "checkpoint scope binding requires a trusted native module";}
 let operation=try provider.with_file catch nil;let kind=type(operation);
 if kind!="fn" and kind!="closure" {throw "incompatible checkpoint scope exports";}
 return map{with_file:operation,report:_checkpoint_scope_report};
}
export bind_checkpoint_scope;

// Batch ownership is a separate opt-in surface; old scope providers still bind.
fn _checkpoint_batch_report() {
 let report=_checkpoint_report();report.format="pbai.neural.checkpoint-batch-binding.v1";
 report.operations=["with_files"];report.result_contract="resource_scope+acquisition-stage";
 report.cleanup_scope="one-to-eight-loaded-handles";report.max_files=8;return report;
}
fn bind_checkpoint_batch(provider) {
 if type(provider)!="module" {throw "checkpoint batch binding requires a trusted native module";}
 let operation=try provider.with_files catch nil;let kind=type(operation);
 if kind!="fn" and kind!="closure" {throw "incompatible checkpoint batch exports";}
 return map{with_files:operation,report:_checkpoint_batch_report};
}
export bind_checkpoint_batch;
