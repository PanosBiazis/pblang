// Effect-free web schema and renderer shared by preview, IDE and offline MCP.
let Doc=import("stdlib:ui_document.sapp");
let HTML=import("stdlib:html.sapp");
fn _has(items, value) { for item in items { if item == value { return true; } } return false; }

fn _prop(widget, key, fallback) { return try widget.props[key] catch fallback; }

fn _bool(widget, key, fallback) {
    let value = _prop(widget, key, fallback);
    if type(value) != "bool" { throw "ui_form_web: invalid boolean property"; } return value;
}

fn _text(widget, key, fallback) {
    let value = _prop(widget, key, fallback);
    if type(value) != "string" or len(value) > 4096 { throw "ui_form_web: invalid text property"; } return value;
}

fn _policy(options) {
    if options == nil {options=map{};}
    if type(options)!="map" or len(map_keys(options))>6 {throw "ui_form_web: invalid policy";}
    let out=map{discourage_scraping:true,hide_source_names:true,throttle_rejected_requests:true,
        rejected_request_limit:8,rejection_window_ms:60000,rejection_cooldown_ms:30000};
    for key in map_keys(options) {
        if not map_has(out,key) {throw "ui_form_web: unsupported policy";}
        let value=options[key];
        if _has(["discourage_scraping","hide_source_names","throttle_rejected_requests"],key) {
            if type(value)!="bool" {throw "ui_form_web: unsupported policy";}
        } else {
            let minimum=if key=="rejected_request_limit" {1} else {100};
            let maximum=if key=="rejected_request_limit" {10000} else {3600000};
            if type(value)!="number" or not (value>=minimum and value<=maximum) or value!=num_floor(value) {throw "ui_form_web: invalid rejection budget";}
        }
        out[key]=value;
    }
    return out;
}

fn _schema(document, actions, policy) {
    let checked = Doc.validate(document);
    if not checked.ok { throw "ui_form_web: invalid document"; }
    let doc = checked.document;
    if type(actions) != "map" or len(map_keys(actions)) > 128 { throw "ui_form_web: invalid actions"; }
    let ordinal=0; let widgets = map{}; let children = map{root:[]}; let fields = map{}; let buttons = map{}; let handlers = 0; let bound = map{};
    for widget in doc.widgets {
        if not _has(["panel", "label", "textbox", "textarea", "checkbox", "select", "button", "scatter"], widget.kind)
        or widget.bind != "" { throw "ui_form_web: unsupported control or binding"; }
        widgets[widget.id] = widget; children[widget.id] = [];
        ordinal=ordinal + 1;
        widget.web_name=if policy.hide_source_names { "f_" + str(ordinal) } else { "f_" + widget.id };
        widget.web_action=if policy.hide_source_names { "a_" + str(ordinal) } else { widget.id };
        widget.web_label=if policy.hide_source_names { "Field " + str(ordinal) } else { widget.id };
        let allowed = ["visible", "enabled"];
        if widget.kind == "scatter" {
            let Plot=import("stdlib:ui_scatter_plot.sapp");
            for key in ["points","title","x_label","y_label"] {push(allowed,key);}
            // Prepared once from the detached canonical document, never request data.
            widget.web_plot=Plot.render(_prop(widget,"points",nil),_text(widget,"title","Projection"),
                _text(widget,"x_label","X"),_text(widget,"y_label","Y"));
        }
        elif widget.kind == "panel" { push(allowed, "title"); _text(widget, "title", widget.id); }
        elif _has(["label", "checkbox", "button"], widget.kind) { push(allowed, "text"); _text(widget, "text", widget.id); }
        elif widget.kind == "select" {
            push(allowed, "options"); push(allowed, "selected");
            let options = _prop(widget, "options", []); let selected = _prop(widget, "selected", -1);
            if type(options) != "array" or len(options) > 256 or type(selected) != "number" or selected != num_floor(selected)
            or selected < -1 or selected >= len(options) { throw "ui_form_web: invalid choices"; }
            for option in options { if type(option) != "string" or len(option) > 4096 { throw "ui_form_web: invalid option"; } }
        } else {
            push(allowed, "value"); push(allowed, "read_only"); push(allowed, "hint");
            _text(widget, "value", ""); _text(widget, "hint", widget.id); _bool(widget, "read_only", false);
        }
        if widget.kind == "checkbox" { push(allowed, "checked"); _bool(widget, "checked", false); }
        if type(widget.props) != "map" { throw "ui_form_web: properties must be a map"; }
        for key in map_keys(widget.props) { if not _has(allowed, key) { throw "ui_form_web: unsupported property"; } }
        _bool(widget, "visible", true); _bool(widget, "enabled", true);
        handlers = handlers + len(map_keys(widget.events));
    }
    for widget in doc.widgets {
        if widget.parent != "root" and widgets[widget.parent].kind != "panel" { throw "ui_form_web: invalid container"; }
        push(children[widget.parent], widget.id);
        let visible = true; let enabled = true; let cursor = widget.id; let depth = 0;
        while cursor != "root" {
            depth = depth + 1; if depth > 16 { throw "ui_form_web: container depth exceeded"; }
            visible = visible and _bool(widgets[cursor], "visible", true);
            enabled = enabled and _bool(widgets[cursor], "enabled", true);
            cursor = widgets[cursor].parent;
        }
        widget.web_visible = visible; widget.web_enabled = enabled;
        if widget.kind == "button" { buttons[widget.id] = visible and enabled; }
        if visible and enabled and _has(["textbox", "textarea", "checkbox", "select"], widget.kind)
        and not _bool(widget, "read_only", false) { fields[widget.web_name] = widget; }
    }
    for id in map_keys(actions) {
        if not map_has(buttons, id) or not buttons[id] or not _has(["fn", "closure"], type(actions[id])) { throw "ui_form_web: action must name an active button"; }
        bound[widgets[id].web_action] = actions[id];
    }
    return map{doc:doc, widgets:widgets, children:children, fields:fields, actions:bound, imported_handlers:handlers};
}

fn stylesheet() {
    return ".pb-scatter{margin:0;min-width:0}.pb-scatter svg{display:block;width:100%;height:auto}.pb-scatter figcaption{font-weight:600}.pb-scatter table{border-collapse:collapse;width:100%}.pb-scatter th,.pb-scatter td{text-align:left;padding:.4rem;border-bottom:1px solid #718d9f}body{margin:0;background:#edf3f7;color:#172c3c;font:16px system-ui,sans-serif}main{max-width:60rem;margin:auto;padding:clamp(1rem,4vw,3rem)}form,fieldset{display:grid;gap:1rem}form{padding:clamp(1rem,3vw,2rem);background:white;border:1px solid #b8cbd9;border-radius:1rem}fieldset{min-width:0;border:1px solid #b8cbd9;border-radius:.7rem;padding:1rem}legend{font-weight:600}label{display:grid;gap:.4rem}input,textarea,select,button{font:inherit;padding:.7rem;border:1px solid #718d9f;border-radius:.4rem;min-width:0;max-width:100%;box-sizing:border-box}input[type=checkbox]{width:1.2rem;height:1.2rem}button{background:#146b59;color:white;cursor:pointer}button:disabled{opacity:.6;cursor:default}:focus-visible{outline:3px solid #be7600;outline-offset:3px}output{display:block;white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem}p{overflow-wrap:anywhere}.note{color:#526b7c;font-size:.9rem}@media(prefers-color-scheme:dark){body{background:#101b24;color:#e7f1f7}form{background:#1b2c38}input,textarea,select{background:#101b24;color:#e7f1f7}.note{color:#baceda}}";
}

fn _control(schema, id, submitted) {
    let widget = schema.widgets[id]; if not widget.web_visible { return ""; }
    let name = widget.web_name; let attr = " id=\"" + name + "\" name=\"" + name + "\"";
    if not widget.web_enabled { attr = attr + " disabled"; }
    let kind = widget.kind;
    if kind == "panel" {
        let parts = ["<fieldset><legend>" + HTML.escape(_prop(widget, "title", widget.web_label)) + "</legend>"];
        for child in schema.children[id] { push(parts, _control(schema, child, submitted)); }
        push(parts, "</fieldset>"); return str_join(parts, "");
    }
    if kind == "scatter" { return widget.web_plot; }
    if kind == "label" { return "<p>" + HTML.escape(_prop(widget, "text", widget.web_label)) + "</p>"; }
    if kind == "button" {
        let disabled = if widget.web_enabled and map_has(schema.actions, widget.web_action) { "" } else { " disabled" };
        return "<button type=\"submit\" name=\"action\" value=\"" + widget.web_action + "\"" + disabled + ">" + HTML.escape(_prop(widget, "text", widget.web_label)) + "</button>";
    }
    let label = HTML.escape(_prop(widget, "hint", widget.web_label)); let body = "";
    if kind == "checkbox" {
        label = HTML.escape(_prop(widget, "text", widget.web_label));
        let active=if submitted != nil and widget.web_enabled { map_has(submitted, name) } else { _prop(widget, "checked", false) };
        let checked = if active { " checked" } else { "" };
        body = "<input type=\"checkbox\" value=\"1\"" + attr + checked + ">";
    } elif kind == "select" {
        let parts = ["<select" + attr + "><option value=\"\">Choose an option</option>"];
        let options = _prop(widget, "options", []); let selected = if submitted != nil and map_has(submitted, name) { submitted[name] } else { str(_prop(widget, "selected", -1)) }; let index = 0;
        for option in options { push(parts, HTML.option(str(index), option, str(index) == selected)); index=index + 1; }
        push(parts, "</select>"); body = str_join(parts, "");
    } else {
        if _prop(widget, "read_only", false) { attr=attr + " readonly disabled"; }
        let value = HTML.escape(if submitted != nil and map_has(submitted, name) { submitted[name] } else { _prop(widget, "value", "") });
        if kind == "textarea" { body="<textarea maxlength=\"4096\"" + attr + ">" + value + "</textarea>"; }
        else { body="<input type=\"text\" maxlength=\"4096\" value=\"" + value + "\"" + attr + ">"; }
    }
    return "<label for=\"" + name + "\">" + label + body + "</label>";
}

fn page(state, message="", submitted=nil) {
    let schema=state.schema; let parts=["<main><h1>" + HTML.escape(schema.doc.form.title) + "</h1><p class=\"note\">Adapted layout. Imported event handlers are inactive; buttons require explicit PBLang actions.</p><form method=\"post\" action=\"/action\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"" + state.csrf + "\"><input type=\"hidden\" name=\"revision\" value=\"" + str(state.revision) + "\">"];
    for id in schema.children.root { push(parts, _control(schema, id, submitted)); }
    push(parts, "</form><output aria-live=\"polite\">" + HTML.escape(message) + "</output><p class=\"note\">Local preview; no account isolation. Use synthetic data.</p></main>");
    let page=HTML.page(schema.doc.form.title, str_join(parts, ""), "<link rel=\"stylesheet\" href=\"/style.css\">");
    if len(str_to_bytes(page)) > 1048576 { throw "ui_form_web: output budget exceeded"; } return page;
}

// Effect-free preflight for CLI/IDE/agent callers. Returns counts, never source data.
fn inspect(document) {
    let schema=try _schema(document,map{},_policy(nil)) catch nil;
    if schema==nil {return map{ok:false,error:"unsupported-web-document",renderable:false};}
    let preview=try page(map{schema:schema,csrf:str_repeat("0",64),revision:0}) catch nil;
    if preview==nil {return map{ok:false,error:"preview-output-budget",renderable:false};}
    let buttons=0;
    for widget in schema.doc.widgets {if widget.kind=="button" {buttons=buttons+1;}}
    return map{ok:true,renderable:true,widgets:len(schema.doc.widgets),input_fields:len(map_keys(schema.fields)),
        buttons:buttons,imported_handlers:schema.imported_handlers,layout_preserved:false,
        foreign_handlers_executed:false,conversion_complete:false};
}

fn prepare(document, actions, options=nil) {
    let policy=_policy(options);return map{policy:policy,schema:_schema(document,actions,policy)};
}
export prepare, page, inspect, stylesheet;
