// stdlib/semver.sapp — Semantic Versioning 2.0.0 parse / compare / ranges.
//
// A parsed version is a map:
//   { major, minor, patch, prerelease, build }   (prerelease/build are strings, "" if absent)
//
// Usage:
//   let semver = import("stdlib:semver.sapp");
//   let v = semver.parse("1.4.2-rc.1");
//   print semver.compare("1.2.0", "1.10.0");   // -1 (numeric, not lexical)
//   print semver.satisfies("1.4.2", "^1.2.0"); // true

fn _all_digits(s) {
    if s == "" { return false; }
    let i = 0;
    while i < len(s) {
        let code = strcharcodeat(s, i);
        if code < 48 or code > 57 { return false; }   // '0'..'9'
        i = i + 1;
    }
    return true;
}

// Lexical comparison by byte (pblang has no string `<`); returns -1/0/1.
fn _str_cmp(a, b) {
    let la = len(a);
    let lb = len(b);
    let n = la;
    if lb < la { n = lb; }
    let i = 0;
    while i < n {
        let ca = strcharcodeat(a, i);
        let cb = strcharcodeat(b, i);
        if ca < cb { return 0 - 1; }
        if ca > cb { return 1; }
        i = i + 1;
    }
    if la < lb { return 0 - 1; }
    if la > lb { return 1; }
    return 0;
}

// parse(s) → version map, or nil if `s` is not a valid version core.
fn parse(s) {
    let str_v = str_trim(s);
    if str_starts_with(str_v, "v") { str_v = str_slice(str_v, 1, len(str_v)); }

    let build = "";
    let plus = str_index_of(str_v, "+");
    if plus >= 0 {
        build = str_slice(str_v, plus + 1, len(str_v));
        str_v = str_v[0..plus];
    }

    let prerelease = "";
    let dash = str_index_of(str_v, "-");
    if dash >= 0 {
        prerelease = str_slice(str_v, dash + 1, len(str_v));
        str_v = str_v[0..dash];
    }

    let core = str_split(str_v, ".");
    if len(core) != 3 { return nil; }
    if not _all_digits(core[0]) or not _all_digits(core[1]) or not _all_digits(core[2]) {
        return nil;
    }
    return map{
        major: parse_number(core[0]),
        minor: parse_number(core[1]),
        patch: parse_number(core[2]),
        prerelease: prerelease,
        build: build
    };
}

fn valid(s) { return parse(s) != nil; }

// parse_strict(s) -> a SemVer 2.0.0 map, or nil.
//
// The legacy parse()/valid() API remains permissive for compatibility. Strict
// parsing is intended for package catalogs and release gates: it rejects a
// leading v, surrounding whitespace, empty identifiers, numeric leading zeros,
// unsupported characters and core numbers outside exact PBLang integer range.
fn _strict_core_number(s) {
    if not _all_digits(s) or len(s) > 15 { return false; }
    if len(s) > 1 and strcharcodeat(s, 0) == 48 { return false; }
    let value = parse_number(s);
    return value <= 9007199254740991;
}

fn _strict_identifier(part, prerelease) {
    if part == "" { return false; }
    let numeric = true;
    let i = 0;
    while i < len(part) {
        let c = strcharcodeat(part, i);
        if c < 48 or c > 57 { numeric = false; }
        if not (c >= 48 and c <= 57) and not (c >= 65 and c <= 90)
           and not (c >= 97 and c <= 122) and c != 45 { return false; }
        i = i + 1;
    }
    if prerelease and numeric and len(part) > 1 and strcharcodeat(part, 0) == 48 {
        return false;
    }
    return true;
}

fn _strict_identifiers(value, prerelease) {
    let parts = str_split(value, ".");
    if len(parts) == 0 { return false; }
    let i = 0;
    while i < len(parts) {
        if not _strict_identifier(parts[i], prerelease) { return false; }
        i = i + 1;
    }
    return true;
}

fn parse_strict(s) {
    if type(s) != "string" or len(s) < 5 or len(s) > 256 or str_trim(s) != s
       or str_starts_with(s, "v") {
        return nil;
    }
    let core_and_pre = s;
    let build = "";
    let plus = str_index_of(s, "+");
    if plus >= 0 {
        build = str_slice(s, plus + 1, len(s));
        core_and_pre = s[0..plus];
        if build == "" or str_contains(build, "+")
           or not _strict_identifiers(build, false) { return nil; }
    }
    let core_text = core_and_pre;
    let prerelease = "";
    let dash = str_index_of(core_and_pre, "-");
    if dash >= 0 {
        prerelease = str_slice(core_and_pre, dash + 1, len(core_and_pre));
        core_text = core_and_pre[0..dash];
        if prerelease == "" or not _strict_identifiers(prerelease, true) { return nil; }
    }
    let core = str_split(core_text, ".");
    if len(core) != 3 { return nil; }
    let i = 0;
    while i < len(core) {
        if not _strict_core_number(core[i]) { return nil; }
        i = i + 1;
    }
    return map{
        major: parse_number(core[0]), minor: parse_number(core[1]),
        patch: parse_number(core[2]), prerelease: prerelease, build: build
    };
}

fn valid_strict(s) { return parse_strict(s) != nil; }

fn format(v) {
    let out = str(v.major) + "." + str(v.minor) + "." + str(v.patch);
    if v.prerelease != "" { out = out + "-" + v.prerelease; }
    if v.build != "" { out = out + "+" + v.build; }
    return out;
}

// Compare two dot-separated prerelease strings per SemVer §11.
// Returns -1 / 0 / 1. Empty prerelease ("") has HIGHER precedence (no pre).
fn _cmp_prerelease(a, b) {
    if a == b { return 0; }
    if a == "" { return 1; }   // no prerelease > has prerelease
    if b == "" { return 0 - 1; }
    let pa = str_split(a, ".");
    let pb = str_split(b, ".");
    let i = 0;
    while i < len(pa) and i < len(pb) {
        let x = pa[i];
        let y = pb[i];
        let xnum = _all_digits(x);
        let ynum = _all_digits(y);
        if xnum and ynum {
            let nx = parse_number(x);
            let ny = parse_number(y);
            if nx < ny { return 0 - 1; }
            if nx > ny { return 1; }
        } else if xnum and not ynum {
            return 0 - 1;   // numeric identifiers < alphanumeric
        } else if not xnum and ynum {
            return 1;
        } else {
            let c = _str_cmp(x, y);
            if c != 0 { return c; }
        }
        i = i + 1;
    }
    if len(pa) < len(pb) { return 0 - 1; }
    if len(pa) > len(pb) { return 1; }
    return 0;
}

// compare(a, b) — accepts version strings or parsed maps. Returns -1/0/1.
fn _as_version(v) {
    if is_string(v) { return parse(v); }
    return v;
}
fn compare(a, b) {
    let va = _as_version(a);
    let vb = _as_version(b);
    if va == nil or vb == nil { return error("semver.compare: invalid version"); }
    if va.major != vb.major { if va.major < vb.major { return 0 - 1; } return 1; }
    if va.minor != vb.minor { if va.minor < vb.minor { return 0 - 1; } return 1; }
    if va.patch != vb.patch { if va.patch < vb.patch { return 0 - 1; } return 1; }
    return _cmp_prerelease(va.prerelease, vb.prerelease);
}

fn eq(a, b)  { return compare(a, b) == 0; }
fn gt(a, b)  { return compare(a, b) == 1; }
fn lt(a, b)  { return compare(a, b) == 0 - 1; }
fn gte(a, b) { return compare(a, b) >= 0; }
fn lte(a, b) { return compare(a, b) <= 0; }

// inc(v, part) — bump "major" | "minor" | "patch"; returns a new version map
// (prerelease/build cleared, per the usual release-bump semantics).
fn inc(v, part) {
    let ver = _as_version(v);
    if ver == nil { return nil; }
    if part == "major" { return map{ major: ver.major + 1, minor: 0, patch: 0, prerelease: "", build: "" }; }
    if part == "minor" { return map{ major: ver.major, minor: ver.minor + 1, patch: 0, prerelease: "", build: "" }; }
    if part == "patch" { return map{ major: ver.major, minor: ver.minor, patch: ver.patch + 1, prerelease: "", build: "" }; }
    return nil;
}

// Upper bound (exclusive) for a caret range ^X.Y.Z — pins the left-most
// non-zero element.
fn _caret_upper(v) {
    if v.major > 0 { return map{ major: v.major + 1, minor: 0, patch: 0, prerelease: "", build: "" }; }
    if v.minor > 0 { return map{ major: 0, minor: v.minor + 1, patch: 0, prerelease: "", build: "" }; }
    return map{ major: 0, minor: 0, patch: v.patch + 1, prerelease: "", build: "" };
}

// satisfies(version, range) → bool. Supports a single comparator:
//   "*" / ""            any
//   "1.2.3"             exact
//   "=1.2.3"            exact
//   "^1.2.3"            >=1.2.3 and < caret-upper
//   "~1.2.3"            >=1.2.3 and <1.3.0
//   ">=1.2.3" ">1.2.3" "<=1.2.3" "<1.2.3"
fn satisfies(version, range) {
    let v = _as_version(version);
    if v == nil { return false; }
    let r = str_trim(range);
    if r == "" or r == "*" { return true; }

    let op1 = r[0..1];
    let op2 = "";
    if len(r) >= 2 { op2 = r[0..2]; }

    if op2 == ">=" {
        let target = parse(str_trim(str_slice(r, 2, len(r))));
        if target == nil { return false; }
        return compare(v, target) >= 0;
    }
    if op2 == "<=" {
        let target = parse(str_trim(str_slice(r, 2, len(r))));
        if target == nil { return false; }
        return compare(v, target) <= 0;
    }
    if op1 == ">" {
        let target = parse(str_trim(str_slice(r, 1, len(r))));
        if target == nil { return false; }
        return compare(v, target) > 0;
    }
    if op1 == "<" {
        let target = parse(str_trim(str_slice(r, 1, len(r))));
        if target == nil { return false; }
        return compare(v, target) < 0;
    }
    if op1 == "=" {
        let target = parse(str_trim(str_slice(r, 1, len(r))));
        if target == nil { return false; }
        return compare(v, target) == 0;
    }
    if op1 == "^" {
        let lower = parse(str_trim(str_slice(r, 1, len(r))));
        if lower == nil { return false; }
        let upper = _caret_upper(lower);
        return compare(v, lower) >= 0 and compare(v, upper) < 0;
    }
    if op1 == "~" {
        let lower = parse(str_trim(str_slice(r, 1, len(r))));
        if lower == nil { return false; }
        let upper = map{ major: lower.major, minor: lower.minor + 1, patch: 0, prerelease: "", build: "" };
        return compare(v, lower) >= 0 and compare(v, upper) < 0;
    }
    // bare version → exact match
    let target = parse(r);
    if target == nil { return false; }
    return compare(v, target) == 0;
}

// is_stable(v) — valid and not a prerelease (a release-grade version).
fn is_stable(v) {
    let p = parse(v);
    if p == nil { return false; }
    return p.prerelease == "";
}

// max(list) / min(list) — the highest / lowest version (nil if empty).
fn max(list) {
    if len(list) == 0 { return nil; }
    let best = list[0];
    let i = 1;
    while i < len(list) { if compare(list[i], best) > 0 { best = list[i]; } i = i + 1; }
    return best;
}
fn min(list) {
    if len(list) == 0 { return nil; }
    let best = list[0];
    let i = 1;
    while i < len(list) { if compare(list[i], best) < 0 { best = list[i]; } i = i + 1; }
    return best;
}

// sort(list) — ascending copy by precedence (insertion sort over compare).
fn sort(list) {
    let out = [];
    let i = 0;
    while i < len(list) { array_push(out, list[i]); i = i + 1; }
    let a = 1;
    while a < len(out) {
        let key = out[a];
        let b = a - 1;
        while b >= 0 and compare(out[b], key) > 0 { out[b + 1] = out[b]; b = b - 1; }
        out[b + 1] = key;
        a = a + 1;
    }
    return out;
}

// diff(a, b) — the highest-precedence component that differs:
// "major" | "minor" | "patch" | "prerelease" | "none" (nil if either is invalid).
fn diff(a, b) {
    let pa = parse(a);
    let pb = parse(b);
    if pa == nil or pb == nil { return nil; }
    if pa.major != pb.major { return "major"; }
    if pa.minor != pb.minor { return "minor"; }
    if pa.patch != pb.patch { return "patch"; }
    if pa.prerelease != pb.prerelease { return "prerelease"; }
    return "none";
}

// sort_desc(list) — descending copy by precedence.
fn sort_desc(list) {
    let asc = sort(list);
    let out = [];
    let i = len(asc) - 1;
    while i >= 0 { array_push(out, asc[i]); i = i - 1; }
    return out;
}

export parse, valid, format, compare, eq, gt, lt, gte, lte, inc, satisfies;
export parse_strict, valid_strict;
export is_stable, max, min, sort, diff, sort_desc;
