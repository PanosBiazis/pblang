// stdlib/ui/index.sapp — Unified Sovereign UI, 3D PBR/Vulkan, Native Wayland/Desktop,
// Anti-Capture Privacy Shield, SVG Vector Charts & Responsive Layout Namespace (PBLang v4.2.0)

let EnterpriseUI = import("stdlib:enterprise_ui_framework.sapp");
let Gfx3D = import("stdlib:gfx3d_pbr_vulkan_engine.sapp");
let Desktop = import("stdlib:desktop_media/index.sapp");
let AntiCapture = import("stdlib:security/closed_source_shield.sapp");
let ScatterPlot = import("stdlib:ui_scatter_plot.sapp");
let GuiLayout = import("stdlib:gui_layout.sapp");
let FlowLayout = import("stdlib:layout.sapp");

let UI_NAMESPACE_VERSION = "4.2.0";
let THEMES = EnterpriseUI.THEMES;
let COMPONENT_CATALOG = EnterpriseUI.COMPONENT_CATALOG;

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _opt(m, k, fb) {
    if m == nil or not is_map(m) { return fb; }
    if not map_has(m, k) { return fb; }
    let v = m[k];
    if v == nil { return fb; }
    return v;
}

// ============================================================================
// 1. Publication-Ready SVG Charting Helpers (plot_svg + ui_scatter_plot unified)
// ============================================================================

fn render_line_chart_svg(series_values, opts = nil) {
    if not is_array(series_values) or len(series_values) == 0 {
        return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"180\"></svg>";
    }
    let o = if is_map(opts) { opts } else { map{} };
    let w = _clamp(num_floor(_opt(o, "width", 480)), 120, 4096);
    let h = _clamp(num_floor(_opt(o, "height", 240)), 80, 2160);
    let pad = 28;
    let stroke = EnterpriseUI.html_escape(_opt(o, "stroke", "#38BDF8"));
    let bg = EnterpriseUI.html_escape(_opt(o, "bg", "#111824"));
    let title = EnterpriseUI.html_escape(_opt(o, "title", ""));

    let n = len(series_values);
    let min_v = series_values[0] * 1.0;
    let max_v = series_values[0] * 1.0;
    let i = 1;
    while i < n {
        let v = series_values[i] * 1.0;
        if v < min_v { min_v = v; }
        if v > max_v { max_v = v; }
        i = i + 1;
    }
    let span = if max_v - min_v < 0.000001 { 1.0 } else { max_v - min_v };
    let inner_w = num_max(1, w - pad * 2);
    let inner_h = num_max(1, h - pad * 2);

    let pts = [];
    i = 0;
    while i < n {
        let x_ratio = if n <= 1 { 0.5 } else { (i * 1.0) / (n - 1) };
        let y_ratio = (series_values[i] - min_v) / span;
        let px = num_round((pad + x_ratio * inner_w) * 100.0) / 100.0;
        let py = num_round((pad + inner_h - y_ratio * inner_h) * 100.0) / 100.0;
        array_push(pts, str(px) + "," + str(py));
        i = i + 1;
    }

    let title_node = if title != "" {
        "<text x=\"" + str(pad) + "\" y=\"18\" fill=\"#F4F8FC\" font-size=\"13\" font-family=\"sans-serif\">" + title + "</text>"
    } else {
        ""
    };

    return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + str(w) + " " + str(h)
        + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\">"
        + "<rect x=\"0\" y=\"0\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" rx=\"8\" fill=\"" + bg + "\"/>"
        + title_node
        + "<polyline fill=\"none\" stroke=\"" + stroke + "\" stroke-width=\"2.5\" points=\"" + str_join(pts, " ") + "\"/>"
        + "</svg>";
}

fn render_bar_chart_svg(labels, values, opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let w = _clamp(num_floor(_opt(o, "width", 480)), 120, 4096);
    let h = _clamp(num_floor(_opt(o, "height", 240)), 80, 2160);
    let pad = 28;
    let fill_col = EnterpriseUI.html_escape(_opt(o, "fill", "#34D399"));
    let bg = EnterpriseUI.html_escape(_opt(o, "bg", "#111824"));
    if not is_array(values) or len(values) == 0 {
        return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + str(w) + "\" height=\"" + str(h) + "\"></svg>";
    }
    let n = len(values);
    let max_v = 0.000001;
    let i = 0;
    while i < n {
        if values[i] > max_v { max_v = values[i] * 1.0; }
        i = i + 1;
    }
    let inner_w = num_max(1, w - pad * 2);
    let inner_h = num_max(1, h - pad * 2);
    let slot_w = inner_w / (n * 1.0);
    let bar_w = num_max(2.0, slot_w * 0.72);

    let bars = [];
    i = 0;
    while i < n {
        let v = num_max(0.0, values[i] * 1.0);
        let bh = (v / max_v) * inner_h;
        let bx = num_round((pad + i * slot_w + (slot_w - bar_w) * 0.5) * 100.0) / 100.0;
        let by = num_round((pad + inner_h - bh) * 100.0) / 100.0;
        let bhr = num_round(bh * 100.0) / 100.0;
        let bwr = num_round(bar_w * 100.0) / 100.0;
        let lbl = if is_array(labels) and i < len(labels) { EnterpriseUI.html_escape(labels[i]) } else { str(i) };
        array_push(bars, "<rect data-label=\"" + lbl + "\" x=\"" + str(bx) + "\" y=\"" + str(by)
            + "\" width=\"" + str(bwr) + "\" height=\"" + str(bhr) + "\" rx=\"3\" fill=\"" + fill_col + "\"/>");
        i = i + 1;
    }
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + str(w) + " " + str(h)
        + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\">"
        + "<rect x=\"0\" y=\"0\" width=\"" + str(w) + "\" height=\"" + str(h) + "\" rx=\"8\" fill=\"" + bg + "\"/>"
        + str_join(bars, "")
        + "</svg>";
}

let Charts = map{
    render_scatter_ascii: ScatterPlot.render,
    render_line_svg: render_line_chart_svg,
    render_bar_svg: render_bar_chart_svg
};

// ============================================================================
// 2. Responsive Breakpoint & Adaptive Multi-Device Grid Engine
// ============================================================================

fn resolve_responsive_breakpoint(viewport_width_px) {
    let w = num_max(1, num_floor(viewport_width_px));
    if w < 640 {
        return map{ tier: "xs", device_class: "mobile_portrait", columns: 4, gutter_px: 12, margin_px: 16 };
    }
    if w < 768 {
        return map{ tier: "sm", device_class: "mobile_landscape", columns: 6, gutter_px: 16, margin_px: 20 };
    }
    if w < 1024 {
        return map{ tier: "md", device_class: "tablet", columns: 8, gutter_px: 20, margin_px: 24 };
    }
    if w < 1440 {
        return map{ tier: "lg", device_class: "laptop_desktop", columns: 12, gutter_px: 24, margin_px: 32 };
    }
    return map{ tier: "xl", device_class: "ultrawide_4k", columns: 12, gutter_px: 32, margin_px: 48 };
}

fn compute_responsive_grid(viewport_width_px, item_count, opts = nil) {
    let bp = resolve_responsive_breakpoint(viewport_width_px);
    let o = if is_map(opts) { opts } else { map{} };
    let cols = _clamp(num_floor(_opt(o, "columns", num_max(1, num_floor(bp.columns / 3)))), 1, 12);
    let gap = _clamp(num_floor(_opt(o, "gap_px", bp.gutter_px)), 0, 128);
    let row_h = _clamp(num_floor(_opt(o, "row_height_px", 140)), 24, 2048);
    let usable_w = num_max(cols, viewport_width_px - bp.margin_px * 2 - gap * (cols - 1));
    let cell_w = num_floor(usable_w / cols);

    let cells = [];
    let i = 0;
    while i < item_count {
        let col_idx = num_mod(i, cols);
        let row_idx = num_floor(i / cols);
        array_push(cells, map{
            index: i,
            row: row_idx,
            col: col_idx,
            x: bp.margin_px + col_idx * (cell_w + gap),
            y: bp.margin_px + row_idx * (row_h + gap),
            width: cell_w,
            height: row_h
        });
        i = i + 1;
    }
    return map{
        ok: true,
        breakpoint: bp,
        columns: cols,
        cell_width: cell_w,
        cells: cells
    };
}

let Responsive = map{
    resolve_breakpoint: resolve_responsive_breakpoint,
    compute_grid: compute_responsive_grid,
    compute_flex_dock_layout: EnterpriseUI.compute_flex_dock_layout,
    gui_layout_apply: GuiLayout.apply,
    flow_layout: FlowLayout.flow,
    hit_test: FlowLayout.hit_test
};

// ============================================================================
// 3. Top-Level Convenience Facades & Namespace Manifest
// ============================================================================

fn create_theme(spec) { return EnterpriseUI.create_theme(spec); }
fn ui_node(kind, props = nil, children = nil) { return EnterpriseUI.ui_node(kind, props, children); }
fn ui_app_shell(title, sidebar, content, opts = nil) { return EnterpriseUI.ui_app_shell(title, sidebar, content, opts); }
fn create_virtual_datagrid(rows, cols, opts = nil) { return EnterpriseUI.create_virtual_datagrid(rows, cols, opts); }
fn render_to_web_html(tree, theme = nil) { return EnterpriseUI.render_to_web_html(tree, theme); }
fn audit_accessibility_wcag(tree, theme = nil) { return EnterpriseUI.audit_accessibility_wcag(tree, theme); }

fn probe_gpu_3d_backends() { return Gfx3D.probe_gpu_3d_backends(); }
fn scene3d_new(opts = nil) { return Gfx3D.scene3d_new(opts); }
fn raytrace_scene(scene, w, h, opts = nil) { return Gfx3D.raytrace_scene(scene, w, h, opts); }
fn render_scene_raster(scene, w, h, opts = nil) { return Gfx3D.render_scene_raster(scene, w, h, opts); }

fn probe_display_gpu_stack() { return Desktop.probe_display_gpu_stack(); }
fn create_gpu_surface(opts = nil) { return Desktop.create_gpu_surface(opts); }
fn composite_layers_rgba(surface, layers, opts = nil) { return Desktop.composite_layers_rgba(surface, layers, opts); }

fn create_protection_policy(opts = nil) { return AntiCapture.create_protection_policy(opts); }

fn ui_namespace_manifest() {
    return map{
        ok: true,
        namespace: "stdlib:ui",
        version: UI_NAMESPACE_VERSION,
        submodules: [
            "EnterpriseUI (stdlib:enterprise_ui_framework.sapp)",
            "Gfx3D (stdlib:gfx3d_pbr_vulkan_engine.sapp)",
            "Desktop (stdlib:desktop_media/index.sapp)",
            "AntiCapture (stdlib:security/closed_source_shield.sapp)",
            "Charts (SVG Line/Bar + ScatterPlot)",
            "Responsive (Breakpoints, Multi-Column Grid, Flexbox/Dock)"
        ],
        enterprise_component_count: len(EnterpriseUI.list_all_components()),
        themes: map_keys(THEMES)
    };
}

export UI_NAMESPACE_VERSION, THEMES, COMPONENT_CATALOG;
export EnterpriseUI, Gfx3D, Desktop, AntiCapture, Charts, Responsive;
export ui_namespace_manifest;
export create_theme, ui_node, ui_app_shell, create_virtual_datagrid, render_to_web_html, audit_accessibility_wcag;
export probe_gpu_3d_backends, scene3d_new, raytrace_scene, render_scene_raster;
export probe_display_gpu_stack, create_gpu_surface, composite_layers_rgba;
export create_protection_policy;
export render_line_chart_svg, render_bar_chart_svg;
export resolve_responsive_breakpoint, compute_responsive_grid;
