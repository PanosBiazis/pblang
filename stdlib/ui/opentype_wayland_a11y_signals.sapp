// Subpixel SDF Glyph Atlas, Wayland DMA-BUF Wire Presenter, AT-SPI2 / Win32 UIA
// Accessibility Bridge, & Glitch-Free Fine-Grained Reactive Signals Engine (PBLang v5.0.0)

let U = import("stdlib:unicode.sapp");

let MODULE_VERSION = "5.0.0";
let SFNT_TRUETYPE_V1 = 65536;       // 0x00010000
let SFNT_OTTO_CFF = 1330926671;     // 0x4F54544F ("OTTO")
let SFNT_APPLE_TRUE = 1953658213;   // 0x74727565 ("true")
let HEAD_MAGIC_NUMBER = 1594834165; // 0x5F0F3CF5

// Wayland Core / XDG-Shell / Linux DMA-BUF v1 Opcodes
let WL_DISPLAY_SYNC = 0;
let WL_DISPLAY_GET_REGISTRY = 1;
let WL_REGISTRY_BIND = 0;
let WL_COMPOSITOR_CREATE_SURFACE = 0;
let XDG_WM_BASE_GET_XDG_SURFACE = 2;
let XDG_WM_BASE_PONG = 3;
let XDG_SURFACE_GET_TOPLEVEL = 1;
let XDG_SURFACE_ACK_CONFIGURE = 4;
let XDG_TOPLEVEL_SET_TITLE = 2;
let XDG_TOPLEVEL_SET_APP_ID = 3;
let ZWP_LINUX_DMABUF_V1_CREATE_PARAMS = 2;
let ZWP_LINUX_BUFFER_PARAMS_V1_ADD = 0;
let ZWP_LINUX_BUFFER_PARAMS_V1_CREATE_IMMED = 3;
let DRM_FORMAT_ARGB8888 = 875713089; // 'A','R','2','4' = 0x34325241

// Microsoft Windows UIAutomation ControlType & Pattern IDs
let UIA_BUTTON_CONTROL_TYPE_ID = 50000;
let UIA_CHECKBOX_CONTROL_TYPE_ID = 50002;
let UIA_COMBOBOX_CONTROL_TYPE_ID = 50003;
let UIA_EDIT_CONTROL_TYPE_ID = 50004;
let UIA_HYPERLINK_CONTROL_TYPE_ID = 50005;
let UIA_LIST_CONTROL_TYPE_ID = 50008;
let UIA_MENU_CONTROL_TYPE_ID = 50009;
let UIA_PROGRESSBAR_CONTROL_TYPE_ID = 50012;
let UIA_SLIDER_CONTROL_TYPE_ID = 50015;
let UIA_TEXT_CONTROL_TYPE_ID = 50020;
let UIA_DATAGRID_CONTROL_TYPE_ID = 50028;
let UIA_WINDOW_CONTROL_TYPE_ID = 50032;
let UIA_PANE_CONTROL_TYPE_ID = 50033;

let UIA_INVOKE_PATTERN_ID = 10000;
let UIA_VALUE_PATTERN_ID = 10002;
let UIA_RANGE_VALUE_PATTERN_ID = 10003;
let UIA_GRID_PATTERN_ID = 10006;
let UIA_TOGGLE_PATTERN_ID = 10015;

fn _opt(m, k, fb) {
    if m == nil or not is_map(m) { return fb; }
    if not map_has(m, k) { return fb; }
    let v = m[k];
    if v == nil { return fb; }
    return v;
}

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _append_bytes(dst, src) {
    let i = 0;
    let n = len(src);
    while i < n {
        array_push(dst, src[i]);
        i = i + 1;
    }
    return dst;
}

// Big-endian readers/writers (OpenType SFNT)
fn _u16_be(b, pos) {
    return b[pos] * 256 + b[pos + 1];
}

fn _i16_be(b, pos) {
    let v = _u16_be(b, pos);
    if v >= 32768 { return v - 65536; }
    return v;
}

fn _u32_be(b, pos) {
    return b[pos] * 16777216 + b[pos + 1] * 65536 + b[pos + 2] * 256 + b[pos + 3];
}

fn _push_u16_be(buf, val) {
    let v = num_mod(num_floor(val), 65536);
    if v < 0 { v = v + 65536; }
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(v, 255));
    return buf;
}

fn _push_i16_be(buf, val) {
    let v = num_floor(val);
    if v < 0 { v = 65536 + v; }
    return _push_u16_be(buf, v);
}

fn _push_u32_be(buf, val) {
    let v = num_mod(num_floor(val), 4294967296);
    if v < 0 { v = v + 4294967296; }
    array_push(buf, bit_and(num_floor(v / 16777216), 255));
    array_push(buf, bit_and(num_floor(v / 65536), 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(v, 255));
    return buf;
}

// Little-endian readers/writers (Wayland native wire protocol on x86_64/ARM64)
fn _u32_le(b, pos) {
    return b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216;
}

fn _push_u32_le(buf, val) {
    let v = num_mod(num_floor(val), 4294967296);
    if v < 0 { v = v + 4294967296; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(num_floor(v / 65536), 255));
    array_push(buf, bit_and(num_floor(v / 16777216), 255));
    return buf;
}

fn _xml_escape(s) {
    let out = str(s);
    out = str_replace_all(out, "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    out = str_replace_all(out, "'", "&apos;");
    return out;
}

// ============================================================================
// 1. OpenType Binary SFNT (`cmap` 4/12, `hmtx`, `kern`, `GSUB`, `GPOS`) & BiDi Shaper
// ============================================================================

fn _sfnt_checksum(table_bytes) {
    let sum = 0;
    let n = len(table_bytes);
    let i = 0;
    while i < n {
        let b0 = table_bytes[i];
        let b1 = if i + 1 < n { table_bytes[i + 1] } else { 0 };
        let b2 = if i + 2 < n { table_bytes[i + 2] } else { 0 };
        let b3 = if i + 3 < n { table_bytes[i + 3] } else { 0 };
        let word = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
        sum = num_mod(sum + word, 4294967296);
        i = i + 4;
    }
    return sum;
}

fn build_minimal_opentype_bytes(opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let is_cff = _opt(o, "flavor", "ttf") == "otf";
    let upem = _clamp(num_floor(_opt(o, "units_per_em", 1000)), 64, 16384);
    let ascent = num_floor(_opt(o, "ascent", 800));
    let descent = num_floor(_opt(o, "descent", -200));

    // Build `head` (54 bytes)
    let head_t = [];
    _push_u32_be(head_t, 65536);            // major=1, minor=0
    _push_u32_be(head_t, 65536);            // fontRevision 1.0
    _push_u32_be(head_t, 0);                // checkSumAdjustment
    _push_u32_be(head_t, HEAD_MAGIC_NUMBER);// 0x5F0F3CF5
    _push_u16_be(head_t, 3);                // flags
    _push_u16_be(head_t, upem);             // unitsPerEm
    let z = 0;
    while z < 16 { array_push(head_t, 0); z = z + 1; } // created/modified
    _push_i16_be(head_t, -100); _push_i16_be(head_t, -250);
    _push_i16_be(head_t, 1100); _push_i16_be(head_t, 950);
    _push_u16_be(head_t, 0);                // macStyle
    _push_u16_be(head_t, 8);                // lowestRecPPEM
    _push_i16_be(head_t, 2);                // fontDirectionHint
    _push_i16_be(head_t, 1);                // indexToLocFormat
    _push_i16_be(head_t, 0);                // glyphDataFormat

    // Build `hhea` (36 bytes) with 6 explicit hMetrics
    let num_hm = 6;
    let hhea_t = [];
    _push_u32_be(hhea_t, 65536);
    _push_i16_be(hhea_t, ascent);
    _push_i16_be(hhea_t, descent);
    _push_i16_be(hhea_t, 90);               // lineGap
    _push_u16_be(hhea_t, 680);              // advanceWidthMax
    _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 650);
    _push_i16_be(hhea_t, 1); _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 0);
    _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 0);
    _push_i16_be(hhea_t, 0); _push_i16_be(hhea_t, 0);
    _push_u16_be(hhea_t, num_hm);

    // Build `hmtx` (6 * 4 = 24 bytes)
    let hmtx_t = [];
    let advs = [500, 260, 560, 580, 620, 540];
    let mi = 0;
    while mi < num_hm {
        _push_u16_be(hmtx_t, advs[mi]);
        _push_i16_be(hmtx_t, 24);
        mi = mi + 1;
    }

    // Build `cmap` with Format 4 (BMP) + Format 12 (UCS-4 full Unicode)
    // Header: version=0, numTables=2; record0=(3,1,off4), record1=(3,10,off12)
    let sub4 = [];
    // Format 4 with 3 segments: [0x0020..0x007E], [0x0370..0x1FFF], [0xFFFF..0xFFFF]
    _push_u16_be(sub4, 4);                  // format = 4
    _push_u16_be(sub4, 32);                 // length = 16 + 4*2*3 = 40 -> wait: 14 + 2 + 4*6 = 40
    sub4[2] = 0; sub4[3] = 40;
    _push_u16_be(sub4, 0);                  // language
    _push_u16_be(sub4, 6);                  // segCountX2 = 3 * 2 = 6
    _push_u16_be(sub4, 4);                  // searchRange
    _push_u16_be(sub4, 1);                  // entrySelector
    _push_u16_be(sub4, 2);                  // rangeShift
    // endCode[3]
    _push_u16_be(sub4, 126); _push_u16_be(sub4, 8191); _push_u16_be(sub4, 65535);
    _push_u16_be(sub4, 0);                  // reservedPad
    // startCode[3]
    _push_u16_be(sub4, 32); _push_u16_be(sub4, 880); _push_u16_be(sub4, 65535);
    // idDelta[3]: gid = (cp + delta) mod 65536
    _push_i16_be(sub4, -30); _push_i16_be(sub4, -700); _push_i16_be(sub4, 1);
    // idRangeOffset[3] = 0, 0, 0
    _push_u16_be(sub4, 0); _push_u16_be(sub4, 0); _push_u16_be(sub4, 0);

    let sub12 = [];
    // Format 12: u16=12, u16=0, u32 length=16+12*3=52, u32 lang=0, u32 numGroups=3
    _push_u16_be(sub12, 12); _push_u16_be(sub12, 0);
    _push_u32_be(sub12, 52); _push_u32_be(sub12, 0); _push_u32_be(sub12, 3);
    // Group 0: ASCII [32..126] -> startGlyphID 2
    _push_u32_be(sub12, 32); _push_u32_be(sub12, 126); _push_u32_be(sub12, 2);
    // Group 1: Combining + Greek + Polytonic + RTL [768..8191] -> startGlyphID 180
    _push_u32_be(sub12, 768); _push_u32_be(sub12, 8191); _push_u32_be(sub12, 180);
    // Group 2: Supplemental / Symbols [64256..129000] -> startGlyphID 9000
    _push_u32_be(sub12, 64256); _push_u32_be(sub12, 129000); _push_u32_be(sub12, 9000);

    let cmap_t = [];
    _push_u16_be(cmap_t, 0); _push_u16_be(cmap_t, 2);
    let off4 = 20;
    let off12 = off4 + len(sub4);
    _push_u16_be(cmap_t, 3); _push_u16_be(cmap_t, 1); _push_u32_be(cmap_t, off4);
    _push_u16_be(cmap_t, 3); _push_u16_be(cmap_t, 10); _push_u32_be(cmap_t, off12);
    _append_bytes(cmap_t, sub4);
    _append_bytes(cmap_t, sub12);

    // Build `kern` v0 Format 0 with 2 pairs: ('A'=35,'V'=56 -> -55), ('Τ'=372,'α'=393 -> -40)
    let kern_t = [];
    _push_u16_be(kern_t, 0); _push_u16_be(kern_t, 1); // version=0, nTables=1
    _push_u16_be(kern_t, 0); _push_u16_be(kern_t, 26); _push_u16_be(kern_t, 1); // subtable header
    _push_u16_be(kern_t, 2); _push_u16_be(kern_t, 6); _push_u16_be(kern_t, 0); _push_u16_be(kern_t, 0);
    _push_u16_be(kern_t, 35); _push_u16_be(kern_t, 56); _push_i16_be(kern_t, -55);
    _push_u16_be(kern_t, 372); _push_u16_be(kern_t, 393); _push_i16_be(kern_t, -40);

    // Build `GSUB` v1.0 header + feature tags ('liga', 'calt')
    let gsub_t = [];
    _push_u16_be(gsub_t, 1); _push_u16_be(gsub_t, 0);
    _push_u16_be(gsub_t, 10); _push_u16_be(gsub_t, 14); _push_u16_be(gsub_t, 30);
    _push_u16_be(gsub_t, 2); _push_u16_be(gsub_t, 0); // scriptList stub
    _push_u16_be(gsub_t, 2); // 2 features: 'liga', 'calt'
    _append_bytes(gsub_t, str_to_bytes("liga")); _push_u16_be(gsub_t, 0);
    _append_bytes(gsub_t, str_to_bytes("calt")); _push_u16_be(gsub_t, 0);
    _push_u16_be(gsub_t, 2); // 2 lookups (Type 4 Ligature, Type 6 Contextual Greek)

    // Build `GPOS` v1.0 header + feature tags ('kern', 'mark')
    let gpos_t = [];
    _push_u16_be(gpos_t, 1); _push_u16_be(gpos_t, 0);
    _push_u16_be(gpos_t, 10); _push_u16_be(gpos_t, 14); _push_u16_be(gpos_t, 30);
    _push_u16_be(gpos_t, 2); _push_u16_be(gpos_t, 0);
    _push_u16_be(gpos_t, 2);
    _append_bytes(gpos_t, str_to_bytes("kern")); _push_u16_be(gpos_t, 0);
    _append_bytes(gpos_t, str_to_bytes("mark")); _push_u16_be(gpos_t, 0);
    _push_u16_be(gpos_t, 2); // PairPos + MarkBasePos

    let entries = [
        map{ tag: "GPOS", data: gpos_t },
        map{ tag: "GSUB", data: gsub_t },
        map{ tag: "cmap", data: cmap_t },
        map{ tag: "head", data: head_t },
        map{ tag: "hhea", data: hhea_t },
        map{ tag: "hmtx", data: hmtx_t },
        map{ tag: "kern", data: kern_t }
    ];
    let num_tables = len(entries);
    let out = [];
    _push_u32_be(out, if is_cff { SFNT_OTTO_CFF } else { SFNT_TRUETYPE_V1 });
    _push_u16_be(out, num_tables);
    _push_u16_be(out, 64);
    _push_u16_be(out, 2);
    _push_u16_be(out, num_tables * 16 - 64);

    let cur_off = 12 + num_tables * 16;
    let records_meta = [];
    let ti = 0;
    while ti < num_tables {
        let ent = entries[ti];
        let tlen = len(ent.data);
        let csum = _sfnt_checksum(ent.data);
        _append_bytes(out, str_to_bytes(ent.tag));
        _push_u32_be(out, csum);
        _push_u32_be(out, cur_off);
        _push_u32_be(out, tlen);
        array_push(records_meta, ent.data);
        let padded = tlen;
        while num_mod(padded, 4) != 0 { padded = padded + 1; }
        cur_off = cur_off + padded;
        ti = ti + 1;
    }
    ti = 0;
    while ti < len(records_meta) {
        let d = records_meta[ti];
        _append_bytes(out, d);
        while num_mod(len(out), 4) != 0 { array_push(out, 0); }
        ti = ti + 1;
    }
    return out;
}

fn _parse_cmap_table(b, tbl_off, tbl_len) {
    let end_lim = tbl_off + tbl_len;
    if tbl_len < 4 or end_lim > len(b) {
        return map{ format4_segments: [], format12_groups: [] };
    }
    let num_sub = _u16_be(b, tbl_off + 2);
    let fmt4_segs = [];
    let fmt12_grps = [];
    let s = 0;
    while s < num_sub and (tbl_off + 4 + (s + 1) * 8) <= end_lim {
        let rec_off = tbl_off + 4 + s * 8;
        let sub_rel = _u32_be(b, rec_off + 4);
        let sub_pos = tbl_off + sub_rel;
        if sub_pos + 4 <= end_lim {
            let fmt = _u16_be(b, sub_pos);
            if fmt == 4 and sub_pos + 16 <= end_lim {
                let seg_x2 = _u16_be(b, sub_pos + 6);
                let seg_cnt = num_floor(seg_x2 / 2);
                let end_arr = sub_pos + 14;
                let start_arr = end_arr + seg_x2 + 2;
                let delta_arr = start_arr + seg_x2;
                let roff_arr = delta_arr + seg_x2;
                if roff_arr + seg_x2 <= end_lim {
                    let k = 0;
                    while k < seg_cnt {
                        array_push(fmt4_segs, map{
                            start_code: _u16_be(b, start_arr + k * 2),
                            end_code: _u16_be(b, end_arr + k * 2),
                            id_delta: _i16_be(b, delta_arr + k * 2),
                            id_range_offset: _u16_be(b, roff_arr + k * 2)
                        });
                        k = k + 1;
                    }
                }
            } elif fmt == 12 and sub_pos + 16 <= end_lim {
                let n_groups = _u32_be(b, sub_pos + 12);
                let grp_pos = sub_pos + 16;
                let g = 0;
                while g < n_groups and g < 4096 and grp_pos + 12 <= end_lim {
                    array_push(fmt12_grps, map{
                        start_char: _u32_be(b, grp_pos),
                        end_char: _u32_be(b, grp_pos + 4),
                        start_glyph_id: _u32_be(b, grp_pos + 8)
                    });
                    grp_pos = grp_pos + 12;
                    g = g + 1;
                }
            }
        }
        s = s + 1;
    }
    return map{ format4_segments: fmt4_segs, format12_groups: fmt12_grps };
}

fn parse_opentype_sfnt(font_bytes) {
    if not is_array(font_bytes) or len(font_bytes) < 12 {
        throw "opentype: SFNT buffer too short (< 12 bytes)";
    }
    let total_len = len(font_bytes);
    let sfnt_ver = _u32_be(font_bytes, 0);
    if sfnt_ver != SFNT_TRUETYPE_V1 and sfnt_ver != SFNT_OTTO_CFF and sfnt_ver != SFNT_APPLE_TRUE {
        throw "opentype: unsupported SFNT version magic " + str(sfnt_ver);
    }
    let num_tables = _u16_be(font_bytes, 4);
    if num_tables > 256 or (12 + num_tables * 16) > total_len {
        throw "opentype: SFNT table directory exceeds buffer bounds";
    }
    let tables = map{};
    let i = 0;
    while i < num_tables {
        let rec = 12 + i * 16;
        let tag = U.from_codepoint(font_bytes[rec])
            + U.from_codepoint(font_bytes[rec + 1])
            + U.from_codepoint(font_bytes[rec + 2])
            + U.from_codepoint(font_bytes[rec + 3]);
        let csum = _u32_be(font_bytes, rec + 4);
        let toff = _u32_be(font_bytes, rec + 8);
        let tlen = _u32_be(font_bytes, rec + 12);
        if toff + tlen > total_len {
            throw "opentype: table '" + tag + "' exceeds font byte bounds";
        }
        tables[tag] = map{ tag: tag, checksum: csum, offset: toff, length: tlen };
        i = i + 1;
    }

    let units_per_em = 1000;
    let index_to_loc_fmt = 0;
    if map_has(tables, "head") and tables["head"].length >= 54 {
        let hoff = tables["head"].offset;
        let magic = _u32_be(font_bytes, hoff + 12);
        if magic != HEAD_MAGIC_NUMBER {
            throw "opentype: invalid 'head' magic number";
        }
        units_per_em = _u16_be(font_bytes, hoff + 18);
        index_to_loc_fmt = _i16_be(font_bytes, hoff + 50);
    }

    let ascent = 800;
    let descent = -200;
    let line_gap = 90;
    let num_hmetrics = 0;
    if map_has(tables, "hhea") and tables["hhea"].length >= 36 {
        let hhoff = tables["hhea"].offset;
        ascent = _i16_be(font_bytes, hhoff + 4);
        descent = _i16_be(font_bytes, hhoff + 6);
        line_gap = _i16_be(font_bytes, hhoff + 8);
        num_hmetrics = _u16_be(font_bytes, hhoff + 34);
    }

    let hmetrics = [];
    if map_has(tables, "hmtx") and num_hmetrics > 0 {
        let moff = tables["hmtx"].offset;
        let mlen = tables["hmtx"].length;
        let hi = 0;
        while hi < num_hmetrics and (hi + 1) * 4 <= mlen {
            array_push(hmetrics, map{
                advance_width: _u16_be(font_bytes, moff + hi * 4),
                lsb: _i16_be(font_bytes, moff + hi * 4 + 2)
            });
            hi = hi + 1;
        }
    }

    let cmap_parsed = if map_has(tables, "cmap") {
        _parse_cmap_table(font_bytes, tables["cmap"].offset, tables["cmap"].length)
    } else {
        map{ format4_segments: [], format12_groups: [] }
    };

    let kern_pairs = map{};
    if map_has(tables, "kern") and tables["kern"].length >= 18 {
        let koff = tables["kern"].offset;
        let klen = tables["kern"].length;
        let n_sub = _u16_be(font_bytes, koff + 2);
        if n_sub >= 1 and koff + 18 <= koff + klen {
            let npairs = _u16_be(font_bytes, koff + 10);
            let ppos = koff + 18;
            let pi = 0;
            while pi < npairs and ppos + 6 <= koff + klen {
                let left_g = _u16_be(font_bytes, ppos);
                let right_g = _u16_be(font_bytes, ppos + 2);
                let kval = _i16_be(font_bytes, ppos + 4);
                kern_pairs[str(left_g) + ":" + str(right_g)] = kval;
                ppos = ppos + 6;
                pi = pi + 1;
            }
        }
    }

    let gsub_features = [];
    if map_has(tables, "GSUB") and tables["GSUB"].length >= 10 {
        let goff = tables["GSUB"].offset;
        let glen = tables["GSUB"].length;
        let fl_off = goff + _u16_be(font_bytes, goff + 6);
        if fl_off + 2 <= goff + glen {
            let fcnt = _u16_be(font_bytes, fl_off);
            let fi = 0;
            while fi < fcnt and fl_off + 2 + (fi + 1) * 6 <= goff + glen {
                let fp = fl_off + 2 + fi * 6;
                let ftag = U.from_codepoint(font_bytes[fp]) + U.from_codepoint(font_bytes[fp + 1])
                    + U.from_codepoint(font_bytes[fp + 2]) + U.from_codepoint(font_bytes[fp + 3]);
                array_push(gsub_features, ftag);
                fi = fi + 1;
            }
        }
    }

    let gpos_features = [];
    if map_has(tables, "GPOS") and tables["GPOS"].length >= 10 {
        let poff = tables["GPOS"].offset;
        let plen = tables["GPOS"].length;
        let pfl_off = poff + _u16_be(font_bytes, poff + 6);
        if pfl_off + 2 <= poff + plen {
            let pfcnt = _u16_be(font_bytes, pfl_off);
            let pfi = 0;
            while pfi < pfcnt and pfl_off + 2 + (pfi + 1) * 6 <= poff + plen {
                let pfp = pfl_off + 2 + pfi * 6;
                let pftag = U.from_codepoint(font_bytes[pfp]) + U.from_codepoint(font_bytes[pfp + 1])
                    + U.from_codepoint(font_bytes[pfp + 2]) + U.from_codepoint(font_bytes[pfp + 3]);
                array_push(gpos_features, pftag);
                pfi = pfi + 1;
            }
        }
    }

    return map{
        ok: true,
        flavor: if sfnt_ver == SFNT_OTTO_CFF { "otf_cff" } else { "truetype" },
        sfnt_version: sfnt_ver,
        num_tables: num_tables,
        tables: tables,
        units_per_em: units_per_em,
        index_to_loc_format: index_to_loc_fmt,
        ascent: ascent,
        descent: descent,
        line_gap: line_gap,
        hmetrics: hmetrics,
        cmap: cmap_parsed,
        kern_pairs: kern_pairs,
        gsub_features: gsub_features,
        gpos_features: gpos_features
    };
}

fn _cmap_lookup_glyph(parsed_sfnt, cp) {
    if is_map(parsed_sfnt) and map_has(parsed_sfnt, "cmap") {
        let grps = parsed_sfnt.cmap.format12_groups;
        let i = 0;
        while i < len(grps) {
            let g = grps[i];
            if cp >= g.start_char and cp <= g.end_char {
                return g.start_glyph_id + (cp - g.start_char);
            }
            i = i + 1;
        }
        if cp <= 65535 {
            let segs = parsed_sfnt.cmap.format4_segments;
            let j = 0;
            while j < len(segs) {
                let s = segs[j];
                if cp >= s.start_code and cp <= s.end_code {
                    if cp == 65535 { return 0; }
                    return num_mod(cp + s.id_delta + 65536, 65536);
                }
                j = j + 1;
            }
        }
    }
    if cp == 0 { return 0; }
    return cp;
}

fn _is_combining_mark(cp) {
    return (cp >= 768 and cp <= 879)      // U+0300..U+036F Combining Diacritical Marks
        or (cp >= 1425 and cp <= 1479)    // Hebrew cantillation/points
        or (cp >= 1552 and cp <= 1562)    // Arabic marks
        or (cp >= 1611 and cp <= 1631)    // Arabic harakat
        or (cp >= 7616 and cp <= 7679);   // Combining Supplement
}

fn _is_greek_cp(cp) {
    return (cp >= 880 and cp <= 1023) or (cp >= 7936 and cp <= 8191);
}

fn _is_word_letter_cp(cp) {
    if (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) { return true; }
    if _is_greek_cp(cp) { return true; }
    if (cp >= 192 and cp <= 687) or (cp >= 1024 and cp <= 1791) { return true; }
    return false;
}

fn _bidi_char_class(cp) {
    if _is_combining_mark(cp) { return "NSM"; }
    // Explicit UAX #9 Isolate controls: LRI=0x2066, RLI=0x2067, FSI=0x2068, PDI=0x2069
    if cp == 8294 { return "LRI"; }
    if cp == 8295 { return "RLI"; }
    if cp == 8296 { return "FSI"; }
    if cp == 8297 { return "PDI"; }
    // Hebrew (0x0590..0x05FF), Arabic/Syriac/Thaana (0x0600..0x08FF), Presentation Forms
    if (cp >= 1424 and cp <= 2303) or (cp >= 64285 and cp <= 65023) or (cp >= 65136 and cp <= 65279) {
        return "R";
    }
    if (cp >= 48 and cp <= 57) or (cp >= 1632 and cp <= 1641) { return "EN"; }
    if _is_word_letter_cp(cp) { return "L"; }
    return "N";
}

fn analyze_bidi_runs(text, base_dir = "auto") {
    let cps = U.codepoints(str(text));
    let n = len(cps);
    if n == 0 {
        return map{ paragraph_level: 0, direction: "ltr", classes: [], levels: [], runs: [] };
    }
    let classes = [];
    let i = 0;
    while i < n {
        array_push(classes, _bidi_char_class(cps[i]));
        i = i + 1;
    }

    // UAX #9 P2/P3 Paragraph base level determination
    let para_level = 0;
    let bd = str_lower(str(base_dir));
    if bd == "rtl" {
        para_level = 1;
    } elif bd == "auto" {
        let p = 0;
        while p < n {
            if classes[p] == "R" { para_level = 1; break; }
            if classes[p] == "L" { para_level = 0; break; }
            p = p + 1;
        }
    }

    // UAX #9 BD2 Explicit isolate stack (bounded <= 125) + W1..N2/I1..I2 resolution
    let levels = [];
    let iso_stack = [];
    let cur_base = para_level;
    i = 0;
    while i < n {
        let cls = classes[i];
        if cls == "RLI" and len(iso_stack) < 125 {
            array_push(iso_stack, cur_base);
            cur_base = if num_mod(cur_base, 2) == 0 { cur_base + 1 } else { cur_base + 2 };
            array_push(levels, cur_base);
        } elif cls == "LRI" and len(iso_stack) < 125 {
            array_push(iso_stack, cur_base);
            cur_base = if num_mod(cur_base, 2) == 1 { cur_base + 1 } else { cur_base + 2 };
            array_push(levels, cur_base);
        } elif cls == "PDI" {
            if len(iso_stack) > 0 { cur_base = array_pop(iso_stack); }
            array_push(levels, cur_base);
        } elif cls == "NSM" and i > 0 {
            array_push(levels, levels[i - 1]);
        } elif cls == "R" {
            let r_lvl = if num_mod(cur_base, 2) == 1 { cur_base } else { cur_base + 1 };
            array_push(levels, r_lvl);
        } elif cls == "L" {
            let l_lvl = if num_mod(cur_base, 2) == 0 { cur_base } else { cur_base + 1 };
            array_push(levels, l_lvl);
        } elif cls == "EN" {
            // I1/I2: European/Arabic numbers inside RTL take level + 1 (even -> LTR digits inside RTL!)
            let prev_lvl = if i > 0 { levels[i - 1] } else { cur_base };
            let n_lvl = if num_mod(prev_lvl, 2) == 1 { prev_lvl + 1 } else { prev_lvl };
            array_push(levels, n_lvl);
        } else {
            // N1/N2 Neutral resolution: if surrounded by same direction, adopt it; else cur_base
            let prev_dir = if i > 0 { num_mod(levels[i - 1], 2) } else { num_mod(cur_base, 2) };
            let next_dir = num_mod(cur_base, 2);
            let look = i + 1;
            while look < n {
                if classes[look] == "R" { next_dir = 1; break; }
                if classes[look] == "L" { next_dir = 0; break; }
                look = look + 1;
            }
            if prev_dir == next_dir {
                let target_lvl = if num_mod(cur_base, 2) == prev_dir { cur_base } else { cur_base + 1 };
                array_push(levels, target_lvl);
            } else {
                array_push(levels, cur_base);
            }
        }
        i = i + 1;
    }

    let runs = [];
    let r_start = 0;
    let r_lvl = levels[0];
    i = 1;
    while i < n {
        if levels[i] != r_lvl {
            array_push(runs, map{
                start_cluster: r_start,
                end_cluster: i - 1,
                level: r_lvl,
                direction: if num_mod(r_lvl, 2) == 1 { "rtl" } else { "ltr" }
            });
            r_start = i;
            r_lvl = levels[i];
        }
        i = i + 1;
    }
    array_push(runs, map{
        start_cluster: r_start,
        end_cluster: n - 1,
        level: r_lvl,
        direction: if num_mod(r_lvl, 2) == 1 { "rtl" } else { "ltr" }
    });

    // UAX #9 L2 visual run ordering when paragraph_level == 1 (RTL base)
    let visual_runs = [];
    if para_level == 1 {
        let ri = len(runs) - 1;
        while ri >= 0 {
            array_push(visual_runs, runs[ri]);
            ri = ri - 1;
        }
    } else {
        visual_runs = runs;
    }

    return map{
        paragraph_level: para_level,
        direction: if para_level == 1 { "rtl" } else { "ltr" },
        classes: classes,
        levels: levels,
        runs: visual_runs
    };
}

fn _glyph_script_name(cp) {
    if _is_greek_cp(cp) {
        if cp >= 7936 and cp <= 8191 { return "Greek_Polytonic"; }
        return "Greek";
    }
    if (cp >= 1424 and cp <= 1535) { return "Hebrew"; }
    if (cp >= 1536 and cp <= 1791) { return "Arabic"; }
    if (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or (cp >= 64256 and cp <= 64262) {
        return "Latin";
    }
    if _is_combining_mark(cp) { return "Inherited"; }
    return "Common";
}

fn _base_advance_units(parsed_sfnt, cp, upem) {
    if cp == 32 { return num_floor(upem * 0.28); }
    if _is_combining_mark(cp) { return 0; }
    if cp == 105 or cp == 108 or cp == 953 or cp == 943 { return num_floor(upem * 0.32); } // i, l, ι, ί
    if cp == 109 or cp == 119 or cp == 969 or cp == 974 or cp == 8183 { return num_floor(upem * 0.76); } // m, w, ω, ώ, ῷ
    if cp >= 64257 and cp <= 64260 {
        return if cp >= 64259 { num_floor(upem * 0.82) } else { num_floor(upem * 0.56) };
    }
    if is_map(parsed_sfnt) and len(parsed_sfnt.hmetrics) > 0 {
        let slot = num_mod(cp, len(parsed_sfnt.hmetrics));
        return parsed_sfnt.hmetrics[slot].advance_width;
    }
    return num_floor(upem * 0.56);
}

fn _builtin_kern_delta(cp_left, cp_right, upem) {
    // Standard Latin & Greek GPOS/kern optical pairs (in font design units)
    if (cp_left == 65 and cp_right == 86) or (cp_left == 86 and cp_right == 65) { return num_floor(-0.06 * upem); } // AV / VA
    if cp_left == 84 and (cp_right == 111 or cp_right == 97 or cp_right == 101) { return num_floor(-0.05 * upem); } // To, Ta, Te
    if cp_left == 932 and (cp_right == 945 or cp_right == 940 or cp_right == 959) { return num_floor(-0.045 * upem); } // Τα, Τά, Το
    if cp_left == 928 and (cp_right == 945 or cp_right == 940) { return num_floor(-0.035 * upem); } // Πα, Πά
    if cp_left == 933 and (cp_right == 960 or cp_right == 960) { return num_floor(-0.04 * upem); } // Υπ
    return 0;
}

fn shape_opentype_text(text, font_opts = nil) {
    let o = if is_map(font_opts) { font_opts } else { map{} };
    let font_bytes = _opt(o, "font_bytes", nil);
    let parsed_sfnt = _opt(o, "sfnt", nil);
    if parsed_sfnt == nil and is_array(font_bytes) {
        parsed_sfnt = parse_opentype_sfnt(font_bytes);
    }
    let upem = if is_map(parsed_sfnt) { parsed_sfnt.units_per_em } else { _clamp(num_floor(_opt(o, "units_per_em", 1000)), 64, 16384) };
    let px_size = _clamp(_opt(o, "px_size", 32) * 1.0, 4.0, 512.0);
    let scale = px_size / (upem * 1.0);
    let enable_liga = _opt(o, "enable_ligatures", true) == true;
    let enable_kern = _opt(o, "enable_kerning", true) == true;
    let enable_calt = _opt(o, "enable_contextual_greek", true) == true;
    let base_dir = str(_opt(o, "direction", "auto"));

    let raw_str = str(text);
    let cps = U.codepoints(raw_str);
    let n = len(cps);
    let bidi = analyze_bidi_runs(raw_str, base_dir);

    // Step 1: Logical shaping per cluster (GSUB ligatures + contextual Greek final sigma + GPOS mark-to-base)
    let logical_items = [];
    let idx = 0;
    while idx < n {
        let cp = cps[idx];
        let bidi_lvl = bidi.levels[idx];
        let is_lig = false;
        let contextual_form = "isolated";
        let consumed = 1;

        // GSUB Lookup Type 4: Standard Latin Ligatures (ffi, ffl, fi, fl)
        if enable_liga and cp == 102 and idx + 1 < n and bidi.levels[idx + 1] == bidi_lvl {
            if idx + 2 < n and cps[idx + 1] == 102 and cps[idx + 2] == 105 {
                cp = 64259; // U+FB03 'ﬃ'
                is_lig = true;
                consumed = 3;
            } elif idx + 2 < n and cps[idx + 1] == 102 and cps[idx + 2] == 108 {
                cp = 64260; // U+FB04 'ﬄ'
                is_lig = true;
                consumed = 3;
            } elif cps[idx + 1] == 105 {
                cp = 64257; // U+FB01 'ﬁ'
                is_lig = true;
                consumed = 2;
            } elif cps[idx + 1] == 108 {
                cp = 64258; // U+FB02 'ﬂ'
                is_lig = true;
                consumed = 2;
            }
        }

        // GSUB Lookup Type 6: Contextual Greek Sigma (medial σ U+03C3 -> word-final ς U+03C2)
        if enable_calt and cp == 963 {
            let prev_letter = false;
            let p_scan = idx - 1;
            while p_scan >= 0 {
                if _is_combining_mark(cps[p_scan]) { p_scan = p_scan - 1; continue; }
                prev_letter = _is_word_letter_cp(cps[p_scan]);
                break;
            }
            let next_letter = false;
            let n_scan = idx + 1;
            while n_scan < n {
                if _is_combining_mark(cps[n_scan]) { n_scan = n_scan + 1; continue; }
                next_letter = _is_word_letter_cp(cps[n_scan]);
                break;
            }
            if prev_letter and not next_letter {
                cp = 962; // U+03C2 final sigma 'ς'
                contextual_form = "greek_final_sigma";
            } else {
                contextual_form = "greek_medial_sigma";
            }
        } elif cp == 962 {
            contextual_form = "greek_final_sigma";
        }

        let is_mark = _is_combining_mark(cp);
        let gid = _cmap_lookup_glyph(parsed_sfnt, cp);
        let adv_u = _base_advance_units(parsed_sfnt, cp, upem);
        let x_off_u = 0;
        let y_off_u = 0;

        // GPOS Lookup Type 4: Mark-to-Base Anchor Attachment
        if is_mark and len(logical_items) > 0 {
            let base_g = logical_items[len(logical_items) - 1];
            adv_u = 0;
            // Center mark horizontally over preceding base glyph; stack multiple marks vertically
            x_off_u = 0 - num_floor(base_g.raw_base_adv * 0.5);
            if cp == 837 or cp == 803 {
                // U+0345 combining Greek ypogegrammeni (iota subscript) / dot below
                y_off_u = num_floor(-0.18 * upem);
            } else {
                y_off_u = num_floor((0.68 + base_g.mark_stack_count * 0.16) * upem);
                base_g.mark_stack_count = base_g.mark_stack_count + 1;
            }
        }

        array_push(logical_items, map{
            glyph_id: gid,
            codepoint: cp,
            cluster: idx,
            cluster_span: consumed,
            script: _glyph_script_name(cp),
            bidi_level: bidi_lvl,
            is_ligature: is_lig,
            is_mark: is_mark,
            contextual_form: contextual_form,
            raw_base_adv: adv_u,
            mark_stack_count: 0,
            adv_units: adv_u,
            x_off_units: x_off_u,
            y_off_units: y_off_u
        });
        idx = idx + consumed;
    }

    // Step 2: GPOS / `kern` Pair Kerning between consecutive non-mark base glyphs
    if enable_kern and len(logical_items) > 1 {
        let prev_base_idx = -1;
        let m = 0;
        while m < len(logical_items) {
            if not logical_items[m].is_mark {
                if prev_base_idx >= 0 and logical_items[prev_base_idx].bidi_level == logical_items[m].bidi_level {
                    let g_left = logical_items[prev_base_idx];
                    let g_right = logical_items[m];
                    let k_delta = _builtin_kern_delta(g_left.codepoint, g_right.codepoint, upem);
                    if is_map(parsed_sfnt) and map_has(parsed_sfnt, "kern_pairs") {
                        let k_key = str(g_left.glyph_id) + ":" + str(g_right.glyph_id);
                        if map_has(parsed_sfnt.kern_pairs, k_key) {
                            k_delta = parsed_sfnt.kern_pairs[k_key];
                        }
                    }
                    g_left.adv_units = num_max(0, g_left.adv_units + k_delta);
                }
                prev_base_idx = m;
            }
            m = m + 1;
        }
    }

    // Step 3: UAX #9 BiDi Visual Reordering per Run (keep combining marks after their base!)
    let positioned = [];
    let total_adv_px = 0.0;
    let r_idx = 0;
    while r_idx < len(bidi.runs) {
        let run = bidi.runs[r_idx];
        // Group base + attached marks as atomic grapheme clusters inside this run
        let run_groups = [];
        let li = 0;
        while li < len(logical_items) {
            let item = logical_items[li];
            if item.cluster >= run.start_cluster and item.cluster <= run.end_cluster {
                if item.is_mark and len(run_groups) > 0 {
                    array_push(run_groups[len(run_groups) - 1], item);
                } else {
                    array_push(run_groups, [item]);
                }
            }
            li = li + 1;
        }
        if run.direction == "rtl" {
            let gi = len(run_groups) - 1;
            while gi >= 0 {
                let grp = run_groups[gi];
                let mj = 0;
                while mj < len(grp) { array_push(positioned, grp[mj]); mj = mj + 1; }
                gi = gi - 1;
            }
        } else {
            let gi2 = 0;
            while gi2 < len(run_groups) {
                let grp2 = run_groups[gi2];
                let mj2 = 0;
                while mj2 < len(grp2) { array_push(positioned, grp2[mj2]); mj2 = mj2 + 1; }
                gi2 = gi2 + 1;
            }
        }
        r_idx = r_idx + 1;
    }

    let out_glyphs = [];
    let pi = 0;
    while pi < len(positioned) {
        let g = positioned[pi];
        let x_adv_px = num_round(g.adv_units * scale * 100.0) / 100.0;
        let x_off_px = num_round(g.x_off_units * scale * 100.0) / 100.0;
        let y_off_px = num_round(g.y_off_units * scale * 100.0) / 100.0;
        total_adv_px = total_adv_px + x_adv_px;
        array_push(out_glyphs, map{
            glyph_id: g.glyph_id,
            codepoint: g.codepoint,
            cluster: g.cluster,
            script: g.script,
            bidi_level: g.bidi_level,
            is_ligature: g.is_ligature,
            is_mark: g.is_mark,
            contextual_form: g.contextual_form,
            x_advance: x_adv_px,
            y_advance: 0.0,
            x_offset: x_off_px,
            y_offset: y_off_px,
            advance_units: g.adv_units
        });
        pi = pi + 1;
    }

    return map{
        ok: true,
        text: raw_str,
        px_size: px_size,
        units_per_em: upem,
        direction: bidi.direction,
        runs: bidi.runs,
        glyph_count: len(out_glyphs),
        total_advance: num_round(total_adv_px * 100.0) / 100.0,
        glyphs: out_glyphs
    };
}

// ============================================================================
// 2. Subpixel Signed-Distance-Field (`SDF`) & Legacy Bitmap Glyph Atlas
// ============================================================================

fn _next_pow2(v) {
    let p = 16;
    while p < v and p < 4096 { p = p * 2; }
    return p;
}

fn _point_seg_dist(px, py, ax, ay, bx, by) {
    let vx = bx - ax;
    let vy = by - ay;
    let wx = px - ax;
    let wy = py - ay;
    let c1 = wx * vx + wy * vy;
    let c2 = vx * vx + vy * vy;
    let t = 0.0;
    if c2 > 0.000001 {
        t = _clamp(c1 / c2, 0.0, 1.0);
    }
    let dx = px - (ax + t * vx);
    let dy = py - (ay + t * vy);
    return num_sqrt(dx * dx + dy * dy);
}

// Evaluates signed distance (negative = inside stroke, positive = outside) in normalized [0..1]^2 cell
fn _sample_glyph_signed_distance(gid, norm_x, norm_y, stroke_r) {
    if gid == 0 or gid == 32 { return 1.0; }
    let seed = num_mod(gid * 1103515245 + 12345, 65536);
    let slant = ((num_mod(seed, 7) - 3) * 1.0) * 0.025;
    // Primary vertical/angled stem + crossbar/arch deterministic skeleton
    let d1 = _point_seg_dist(norm_x, norm_y, 0.28 + slant, 0.16, 0.28 - slant, 0.84);
    let d2 = _point_seg_dist(norm_x, norm_y, 0.28, 0.50, 0.72, 0.50);
    let d3 = _point_seg_dist(norm_x, norm_y, 0.72 - slant, 0.20, 0.72 + slant, 0.82);
    let min_d = num_min(d1, num_min(d2, d3));
    return min_d - stroke_r;
}

fn _sdf_dist_to_u8(signed_dist_px, spread_px) {
    // 128 = exact contour edge (distance 0); >128 = inside glyph; <128 = outside glyph
    let norm = 0.5 - (signed_dist_px / (2.0 * spread_px));
    return _clamp(num_round(norm * 255.0), 0, 255);
}

fn build_sdf_glyph_atlas(glyphs_or_shaped, px_size = 32, opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let glyph_list = if is_map(glyphs_or_shaped) and map_has(glyphs_or_shaped, "glyphs") {
        glyphs_or_shaped.glyphs
    } elif is_array(glyphs_or_shaped) {
        glyphs_or_shaped
    } else {
        []
    };

    let scale_factor = _clamp(_opt(o, "scale_factor", 1.0) * 1.0, 0.5, 4.0);
    let mode = str_lower(str(_opt(o, "mode", "lcd_rgb_sdf")));
    let legacy_display = _opt(o, "legacy_display", false) == true or mode == "bitmap_legacy";
    let base_px = _clamp(px_size * 1.0, 6.0, 128.0);
    // Cap per-cell raster resolution for deterministic memory safety while preserving exact HiDPI scale metadata
    let eff_px = _clamp(num_round(base_px * scale_factor), 8, 64);
    let spread_px = _clamp(num_floor(_opt(o, "spread_px", 4)), 2, 12);
    let cell_dim = eff_px + spread_px * 2;

    // Deduplicate glyph_ids
    let unique_gids = [];
    let seen = map{};
    let i = 0;
    while i < len(glyph_list) {
        let g = glyph_list[i];
        let gid = if is_map(g) { _opt(g, "glyph_id", 0) } else { num_floor(g) };
        let k = str(gid);
        if not map_has(seen, k) {
            seen[k] = true;
            array_push(unique_gids, gid);
        }
        i = i + 1;
    }
    if len(unique_gids) == 0 { array_push(unique_gids, 0); }

    let cols = num_max(1, num_ceil(num_sqrt(len(unique_gids) * 1.0)));
    let rows = num_max(1, num_ceil((len(unique_gids) * 1.0) / cols));
    let atlas_w = _next_pow2(cols * cell_dim);
    let atlas_h = _next_pow2(rows * cell_dim);
    let channels = if legacy_display { 1 } elif mode == "sdf8" { 1 } else { 3 };

    let total_bytes = atlas_w * atlas_h * channels;
    let atlas_buf = [];
    let bi = 0;
    while bi < total_bytes {
        array_push(atlas_buf, 0);
        bi = bi + 1;
    }

    let glyph_uvs = map{};
    let legacy_bitmaps = map{};
    let stroke_r = 0.095;
    let gi = 0;
    while gi < len(unique_gids) {
        let gid = unique_gids[gi];
        let col_idx = num_mod(gi, cols);
        let row_idx = num_floor(gi / cols);
        let ox = col_idx * cell_dim;
        let oy = row_idx * cell_dim;
        let bmp_rows = [];

        let py = 0;
        while py < cell_dim {
            let ny = (py + 0.5) / (cell_dim * 1.0);
            let bmp_bits = 0;
            let px = 0;
            while px < cell_dim {
                let dst_idx = ((oy + py) * atlas_w + (ox + px)) * channels;
                let nx_center = (px + 0.5) / (cell_dim * 1.0);
                let dist_center_px = _sample_glyph_signed_distance(gid, nx_center, ny, stroke_r) * (eff_px * 1.0);
                if dist_center_px <= 0.0 and px < 30 {
                    bmp_bits = bit_or(bmp_bits, bit_shl(1, px));
                }
                if legacy_display {
                    // Crisp integer-thresholded bitmap fallback for retro/low-end displays
                    atlas_buf[dst_idx] = if dist_center_px <= 0.0 { 255 } else { 0 };
                } elif channels == 1 {
                    atlas_buf[dst_idx] = _sdf_dist_to_u8(dist_center_px, spread_px * 1.0);
                } else {
                    // LCD-RGB 1/3-pixel subpixel horizontal offsets (-1/3 px R, 0 px G, +1/3 px B)
                    let sub_shift = 1.0 / (3.0 * cell_dim);
                    let d_r = _sample_glyph_signed_distance(gid, nx_center - sub_shift, ny, stroke_r) * (eff_px * 1.0);
                    let d_b = _sample_glyph_signed_distance(gid, nx_center + sub_shift, ny, stroke_r) * (eff_px * 1.0);
                    atlas_buf[dst_idx] = _sdf_dist_to_u8(d_r, spread_px * 1.0);
                    atlas_buf[dst_idx + 1] = _sdf_dist_to_u8(dist_center_px, spread_px * 1.0);
                    atlas_buf[dst_idx + 2] = _sdf_dist_to_u8(d_b, spread_px * 1.0);
                }
                px = px + 1;
            }
            array_push(bmp_rows, bmp_bits);
            py = py + 1;
        }

        legacy_bitmaps[str(gid)] = bmp_rows;
        glyph_uvs[str(gid)] = map{
            glyph_id: gid,
            x: ox,
            y: oy,
            w: cell_dim,
            h: cell_dim,
            u0: (ox * 1.0) / atlas_w,
            v0: (oy * 1.0) / atlas_h,
            u1: ((ox + cell_dim) * 1.0) / atlas_w,
            v1: ((oy + cell_dim) * 1.0) / atlas_h
        };
        gi = gi + 1;
    }

    return map{
        ok: true,
        mode: if legacy_display { "bitmap_legacy" } elif channels == 3 { "lcd_rgb_sdf" } else { "sdf8" },
        px_size: base_px,
        scale_factor: scale_factor,
        effective_px_size: eff_px,
        spread_px: spread_px,
        cell_dim: cell_dim,
        atlas_width: atlas_w,
        atlas_height: atlas_h,
        channels: channels,
        glyph_count: len(unique_gids),
        glyph_uvs: glyph_uvs,
        legacy_bitmap_fallback: legacy_bitmaps,
        bytes: atlas_buf
    };
}

// ============================================================================
// 3. Wayland Native Wire Protocol (`wl_display`/`xdg_shell`/`dmabuf`) & Presenter
// ============================================================================

fn _push_wl_string(payload, text) {
    let s = str(text);
    if str_contains(s, "\x00") {
        throw "wayland_wire: NUL byte forbidden inside Wayland string argument";
    }
    let utf8 = str_to_bytes(s);
    let len_with_nul = len(utf8) + 1; // Wayland wire string includes trailing NUL in length!
    _push_u32_le(payload, len_with_nul);
    _append_bytes(payload, utf8);
    array_push(payload, 0);
    while num_mod(len(payload), 4) != 0 {
        array_push(payload, 0);
    }
    return payload;
}

fn _finalize_wl_packet(object_id, opcode, payload_bytes) {
    if object_id <= 0 {
        throw "wayland_wire: object_id must be >= 1";
    }
    if num_mod(len(payload_bytes), 4) != 0 {
        throw "wayland_wire: payload must be 32-bit aligned";
    }
    let total_size = 8 + len(payload_bytes);
    if total_size > 65532 {
        throw "wayland_wire: message exceeds 16-bit Wayland size header";
    }
    let size_and_op = bit_or(bit_shl(total_size, 16), bit_and(opcode, 65535));
    let pkt = [];
    _push_u32_le(pkt, object_id);
    _push_u32_le(pkt, size_and_op);
    _append_bytes(pkt, payload_bytes);
    return map{
        ok: true,
        object_id: object_id,
        opcode: opcode,
        byte_length: total_size,
        header_word1: size_and_op,
        bytes: pkt
    };
}

fn build_wayland_xdg_wire_packet(message_type, args = nil) {
    let a = if is_map(args) { args } else { map{} };
    let kind = str(message_type);
    let payload = [];

    if kind == "wl_display.get_registry" {
        let obj_id = _opt(a, "object_id", 1);
        let reg_id = _opt(a, "registry_id", 2);
        _push_u32_le(payload, reg_id);
        return _finalize_wl_packet(obj_id, WL_DISPLAY_GET_REGISTRY, payload);
    }
    if kind == "wl_display.sync" {
        let obj_id = _opt(a, "object_id", 1);
        let cb_id = _opt(a, "callback_id", 3);
        _push_u32_le(payload, cb_id);
        return _finalize_wl_packet(obj_id, WL_DISPLAY_SYNC, payload);
    }
    if kind == "wl_registry.bind" {
        let obj_id = _opt(a, "object_id", 2);
        let global_name = _opt(a, "name", 1);
        let iface = str(_opt(a, "interface", "xdg_wm_base"));
        let ver = _opt(a, "version", 1);
        let new_id = _opt(a, "new_id", 4);
        // Wayland untyped new_id in wl_registry.bind encodes: name(u32), interface(str), version(u32), new_id(u32)
        _push_u32_le(payload, global_name);
        _push_wl_string(payload, iface);
        _push_u32_le(payload, ver);
        _push_u32_le(payload, new_id);
        return _finalize_wl_packet(obj_id, WL_REGISTRY_BIND, payload);
    }
    if kind == "wl_compositor.create_surface" {
        let obj_id = _opt(a, "object_id", 4);
        let surf_id = _opt(a, "surface_id", 5);
        _push_u32_le(payload, surf_id);
        return _finalize_wl_packet(obj_id, WL_COMPOSITOR_CREATE_SURFACE, payload);
    }
    if kind == "xdg_wm_base.get_xdg_surface" {
        let obj_id = _opt(a, "object_id", 6);
        let xdg_surf_id = _opt(a, "xdg_surface_id", 7);
        let wl_surf_id = _opt(a, "surface_id", 5);
        _push_u32_le(payload, xdg_surf_id);
        _push_u32_le(payload, wl_surf_id);
        return _finalize_wl_packet(obj_id, XDG_WM_BASE_GET_XDG_SURFACE, payload);
    }
    if kind == "xdg_wm_base.pong" {
        let obj_id = _opt(a, "object_id", 6);
        _push_u32_le(payload, _opt(a, "serial", 1));
        return _finalize_wl_packet(obj_id, XDG_WM_BASE_PONG, payload);
    }
    if kind == "xdg_surface.get_toplevel" {
        let obj_id = _opt(a, "object_id", 7);
        _push_u32_le(payload, _opt(a, "toplevel_id", 8));
        return _finalize_wl_packet(obj_id, XDG_SURFACE_GET_TOPLEVEL, payload);
    }
    if kind == "xdg_surface.ack_configure" {
        let obj_id = _opt(a, "object_id", 7);
        _push_u32_le(payload, _opt(a, "serial", 1));
        return _finalize_wl_packet(obj_id, XDG_SURFACE_ACK_CONFIGURE, payload);
    }
    if kind == "xdg_toplevel.set_title" {
        let obj_id = _opt(a, "object_id", 8);
        _push_wl_string(payload, _opt(a, "title", "PBLang Sovereign App"));
        return _finalize_wl_packet(obj_id, XDG_TOPLEVEL_SET_TITLE, payload);
    }
    if kind == "xdg_toplevel.set_app_id" {
        let obj_id = _opt(a, "object_id", 8);
        _push_wl_string(payload, _opt(a, "app_id", "org.pblang.app"));
        return _finalize_wl_packet(obj_id, XDG_TOPLEVEL_SET_APP_ID, payload);
    }
    if kind == "zwp_linux_dmabuf_v1.create_params" {
        let obj_id = _opt(a, "object_id", 9);
        _push_u32_le(payload, _opt(a, "params_id", 10));
        return _finalize_wl_packet(obj_id, ZWP_LINUX_DMABUF_V1_CREATE_PARAMS, payload);
    }
    if kind == "zwp_linux_buffer_params_v1.add" {
        // fd is passed out-of-band via SCM_RIGHTS cmsg; wire carries plane_idx, offset, stride, modifier_hi, modifier_lo
        let obj_id = _opt(a, "object_id", 10);
        _push_u32_le(payload, _opt(a, "plane_idx", 0));
        _push_u32_le(payload, _opt(a, "offset", 0));
        _push_u32_le(payload, _opt(a, "stride", 7680));
        _push_u32_le(payload, _opt(a, "modifier_hi", 0));
        _push_u32_le(payload, _opt(a, "modifier_lo", 0));
        return _finalize_wl_packet(obj_id, ZWP_LINUX_BUFFER_PARAMS_V1_ADD, payload);
    }
    if kind == "zwp_linux_buffer_params_v1.create_immed" {
        let obj_id = _opt(a, "object_id", 10);
        _push_u32_le(payload, _opt(a, "buffer_id", 11));
        _push_u32_le(payload, _opt(a, "width", 1920));
        _push_u32_le(payload, _opt(a, "height", 1080));
        _push_u32_le(payload, _opt(a, "format", DRM_FORMAT_ARGB8888));
        _push_u32_le(payload, _opt(a, "flags", 0));
        return _finalize_wl_packet(obj_id, ZWP_LINUX_BUFFER_PARAMS_V1_CREATE_IMMED, payload);
    }
    throw "wayland_wire: unsupported Wayland/XDG/DMA-BUF message '" + kind + "'";
}

fn parse_wayland_wire_packet(wire_bytes) {
    if not is_array(wire_bytes) or len(wire_bytes) < 8 {
        throw "wayland_wire: packet shorter than 8-byte header";
    }
    let obj_id = _u32_le(wire_bytes, 0);
    let w1 = _u32_le(wire_bytes, 4);
    let opcode = bit_and(w1, 65535);
    let size = bit_shr(w1, 16);
    if size < 8 or num_mod(size, 4) != 0 or size > len(wire_bytes) {
        throw "wayland_wire: malformed size field in wire header";
    }
    return map{
        ok: true,
        object_id: obj_id,
        opcode: opcode,
        size: size,
        payload_bytes: slice(wire_bytes, 8, size)
    };
}

fn select_display_presenter(env_opts = nil) {
    let o = if is_map(env_opts) { env_opts } else { map{} };
    let platform = str_lower(str(_opt(o, "platform", "linux")));
    let has_wayland = _opt(o, "wayland_available", platform == "linux") == true;
    let has_dmabuf = _opt(o, "dmabuf_v1", has_wayland) == true;
    let has_x11 = _opt(o, "x11_available", true) == true;
    let has_dcomp = _opt(o, "direct_composition", platform == "windows") == true;

    if platform == "windows" {
        if has_dcomp {
            return map{
                backend: "win32_directcomposition",
                zero_copy_gpu: true,
                protocol: "DXGI_SwapChain_Flip_Discard",
                fallback_chain: ["win32_directcomposition", "win32_gdi_dibsection"]
            };
        }
        return map{
            backend: "win32_gdi_dibsection",
            zero_copy_gpu: false,
            protocol: "Win32_BitBlt_DIBSection",
            fallback_chain: ["win32_gdi_dibsection"]
        };
    }
    if has_wayland and has_dmabuf {
        return map{
            backend: "wayland_dmabuf_v1",
            zero_copy_gpu: true,
            protocol: "zwp_linux_dmabuf_v1+xdg_shell",
            fallback_chain: ["wayland_dmabuf_v1", "wayland_wl_shm", "x11_mit_shm"]
        };
    }
    if has_wayland {
        return map{
            backend: "wayland_wl_shm",
            zero_copy_gpu: false,
            protocol: "wl_shm+xdg_shell",
            fallback_chain: ["wayland_wl_shm", "x11_mit_shm"]
        };
    }
    if has_x11 {
        return map{
            backend: "x11_mit_shm",
            zero_copy_gpu: false,
            protocol: "X11_MIT_SHM_PutImage",
            fallback_chain: ["x11_mit_shm", "x11_xputimage"]
        };
    }
    return map{
        backend: "software_framebuffer",
        zero_copy_gpu: false,
        protocol: "ARGB8888_Linear_Scanout",
        fallback_chain: ["software_framebuffer"]
    };
}

// ============================================================================
// 4. Screen-Reader Accessibility Tree (`AT-SPI2` D-Bus & Win32 `UIAutomation`)
// ============================================================================

fn _hex_nibble(c) {
    if c >= 48 and c <= 57 { return c - 48; }
    if c >= 65 and c <= 70 { return c - 55; }
    if c >= 97 and c <= 102 { return c - 87; }
    return 0;
}

fn _parse_hex_rgb(hex_str) {
    let s = str_trim(str(hex_str));
    if str_starts_with(s, "#") { s = str_slice(s, 1, len(s)); }
    if len(s) == 3 {
        let r3 = _hex_nibble(strcharcodeat(s, 0)) * 17;
        let g3 = _hex_nibble(strcharcodeat(s, 1)) * 17;
        let b3 = _hex_nibble(strcharcodeat(s, 2)) * 17;
        return [r3, g3, b3];
    }
    if len(s) < 6 { return [0, 0, 0]; }
    let r = _hex_nibble(strcharcodeat(s, 0)) * 16 + _hex_nibble(strcharcodeat(s, 1));
    let g = _hex_nibble(strcharcodeat(s, 2)) * 16 + _hex_nibble(strcharcodeat(s, 3));
    let b = _hex_nibble(strcharcodeat(s, 4)) * 16 + _hex_nibble(strcharcodeat(s, 5));
    return [r, g, b];
}

fn _srgb_channel_luminance(chan_u8) {
    let c = (chan_u8 * 1.0) / 255.0;
    if c <= 0.04045 { return c / 12.92; }
    return num_pow((c + 0.055) / 1.055, 2.4);
}

fn verify_wcag_aaa_contrast(fg_hex, bg_hex) {
    let fg = _parse_hex_rgb(fg_hex);
    let bg = _parse_hex_rgb(bg_hex);
    let lum_fg = 0.2126 * _srgb_channel_luminance(fg[0])
        + 0.7152 * _srgb_channel_luminance(fg[1])
        + 0.0722 * _srgb_channel_luminance(fg[2]);
    let lum_bg = 0.2126 * _srgb_channel_luminance(bg[0])
        + 0.7152 * _srgb_channel_luminance(bg[1])
        + 0.0722 * _srgb_channel_luminance(bg[2]);
    let hi = num_max(lum_fg, lum_bg);
    let lo = num_min(lum_fg, lum_bg);
    let ratio = num_round(((hi + 0.05) / (lo + 0.05)) * 100.0) / 100.0;
    return map{
        ratio: ratio,
        passes_aa: ratio >= 4.5,
        passes_aaa: ratio >= 7.0,
        passes_large_aaa: ratio >= 4.5
    };
}

fn _localized_role_label(role, locale) {
    let is_el = str_starts_with(str_lower(str(locale)), "el");
    if role == "button" { return if is_el { "Κουμπί" } else { "Button" }; }
    if role == "textbox" or role == "edit" { return if is_el { "Πεδίο κειμένου" } else { "Edit" }; }
    if role == "checkbox" { return if is_el { "Πλαίσιο ελέγχου" } else { "Check box" }; }
    if role == "combobox" { return if is_el { "Σύνθετο πλαίσιο" } else { "Combo box" }; }
    if role == "grid" or role == "table" { return if is_el { "Πλέγμα δεδομένων" } else { "Data grid" }; }
    if role == "heading" { return if is_el { "Επικεφαλίδα" } else { "Heading" }; }
    if role == "window" or role == "dialog" { return if is_el { "Παράθυρο" } else { "Window" }; }
    return if is_el { "Στοιχείο διεπαφής" } else { "Pane" };
}

fn _is_focusable_role(role, disabled, hidden) {
    if disabled or hidden { return false; }
    return role == "button" or role == "textbox" or role == "edit"
        or role == "checkbox" or role == "combobox" or role == "slider" or role == "link";
}

fn _walk_a11y_node(ui_node, state, locale, parent_id) {
    if not is_map(ui_node) { return nil; }
    let hidden = _opt(ui_node, "aria_hidden", false) == true;
    if hidden { return nil; }

    state.seq = state.seq + 1;
    let nid = str(_opt(ui_node, "id", "a11y_node_" + str(state.seq)));
    let raw_role = str_lower(str(_opt(ui_node, "role", _opt(ui_node, "kind", "region"))));
    let disabled = _opt(ui_node, "disabled", false) == true;
    let label_el = _opt(ui_node, "label_el", nil);
    let label_en = _opt(ui_node, "label_en", nil);
    let base_label = str(_opt(ui_node, "label", _opt(ui_node, "title", "")));
    let resolved_name = base_label;
    if str_starts_with(str_lower(locale), "el") and label_el != nil {
        resolved_name = str(label_el);
    } elif not str_starts_with(str_lower(locale), "el") and label_en != nil {
        resolved_name = str(label_en);
    }
    let focusable = _opt(ui_node, "focusable", _is_focusable_role(raw_role, disabled, false)) == true and not disabled;
    let tab_idx = -1;
    if focusable {
        tab_idx = len(state.tab_order);
        array_push(state.tab_order, nid);
    }

    let fg = str(_opt(ui_node, "fg", "#FFFFFF"));
    let bg = str(_opt(ui_node, "bg", "#0B1120"));
    let wcag = verify_wcag_aaa_contrast(fg, bg);
    if not wcag.passes_aaa {
        state.all_wcag_aaa = false;
        array_push(state.contrast_warnings, map{ id: nid, ratio: wcag.ratio });
    }

    let child_nodes = [];
    let raw_children = _opt(ui_node, "children", []);
    if is_array(raw_children) {
        let ci = 0;
        while ci < len(raw_children) {
            let built_c = _walk_a11y_node(raw_children[ci], state, locale, nid);
            if built_c != nil { array_push(child_nodes, built_c); }
            ci = ci + 1;
        }
    }

    let node_rec = map{
        id: nid,
        parent_id: parent_id,
        role: raw_role,
        localized_role: _localized_role_label(raw_role, locale),
        name: resolved_name,
        description: str(_opt(ui_node, "description", "")),
        value: _opt(ui_node, "value", nil),
        checked: _opt(ui_node, "checked", nil),
        disabled: disabled,
        focusable: focusable,
        tab_index: tab_idx,
        live_region: str(_opt(ui_node, "live", "off")),
        contrast_ratio: wcag.ratio,
        wcag_aaa: wcag.passes_aaa,
        children: child_nodes
    };
    array_push(state.flat_nodes, node_rec);
    return node_rec;
}

fn build_a11y_tree(ui_root, opts = nil) {
    let o = if is_map(opts) { opts } else { map{} };
    let locale = str(_opt(o, "locale", "el-GR"));
    let state = map{
        seq: 0,
        tab_order: [],
        flat_nodes: [],
        all_wcag_aaa: true,
        contrast_warnings: []
    };
    let root = _walk_a11y_node(ui_root, state, locale, nil);
    return map{
        ok: root != nil,
        locale: locale,
        node_count: len(state.flat_nodes),
        tab_order: state.tab_order,
        wcag_aaa_compliant: state.all_wcag_aaa,
        contrast_warnings: state.contrast_warnings,
        root: root,
        nodes: state.flat_nodes
    };
}

fn export_atspi2_dbus_introspection(a11y_tree) {
    let nodes = if is_map(a11y_tree) and is_array(_opt(a11y_tree, "nodes", nil)) { a11y_tree.nodes } else { [] };
    let xml_parts = [
        "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">",
        "<node name=\"/org/a11y/atspi/accessible/root\">",
        "  <interface name=\"org.a11y.atspi.Accessible\">",
        "    <property name=\"Name\" type=\"s\" access=\"read\"/>",
        "    <property name=\"Description\" type=\"s\" access=\"read\"/>",
        "    <property name=\"ChildCount\" type=\"i\" access=\"read\"/>",
        "    <method name=\"GetRole\"><arg direction=\"out\" type=\"u\"/></method>",
        "    <method name=\"GetLocalizedRoleName\"><arg direction=\"out\" type=\"s\"/></method>",
        "    <method name=\"GetState\"><arg direction=\"out\" type=\"au\"/></method>",
        "  </interface>",
        "  <interface name=\"org.a11y.atspi.Component\">",
        "    <method name=\"GrabFocus\"><arg direction=\"out\" type=\"b\"/></method>",
        "  </interface>",
        "  <interface name=\"org.a11y.atspi.Action\">",
        "    <method name=\"DoAction\"><arg direction=\"in\" name=\"index\" type=\"i\"/><arg direction=\"out\" type=\"b\"/></method>",
        "  </interface>"
    ];
    let i = 0;
    while i < len(nodes) {
        let nd = nodes[i];
        array_push(xml_parts, "  <node name=\"" + _xml_escape(nd.id) + "\" data-role=\""
            + _xml_escape(nd.role) + "\" data-localized-role=\"" + _xml_escape(nd.localized_role)
            + "\" data-name=\"" + _xml_escape(nd.name) + "\"/>");
        i = i + 1;
    }
    array_push(xml_parts, "</node>");
    return map{
        ok: true,
        bus_interface: "org.a11y.atspi.Accessible",
        object_path: "/org/a11y/atspi/accessible/root",
        node_count: len(nodes),
        xml: str_join(xml_parts, "\n")
    };
}

fn _map_uia_control_type(role) {
    if role == "button" { return UIA_BUTTON_CONTROL_TYPE_ID; }
    if role == "textbox" or role == "edit" { return UIA_EDIT_CONTROL_TYPE_ID; }
    if role == "checkbox" { return UIA_CHECKBOX_CONTROL_TYPE_ID; }
    if role == "combobox" { return UIA_COMBOBOX_CONTROL_TYPE_ID; }
    if role == "link" { return UIA_HYPERLINK_CONTROL_TYPE_ID; }
    if role == "list" { return UIA_LIST_CONTROL_TYPE_ID; }
    if role == "menu" { return UIA_MENU_CONTROL_TYPE_ID; }
    if role == "progressbar" { return UIA_PROGRESSBAR_CONTROL_TYPE_ID; }
    if role == "slider" { return UIA_SLIDER_CONTROL_TYPE_ID; }
    if role == "grid" or role == "table" { return UIA_DATAGRID_CONTROL_TYPE_ID; }
    if role == "heading" or role == "text" or role == "status" { return UIA_TEXT_CONTROL_TYPE_ID; }
    if role == "window" or role == "dialog" { return UIA_WINDOW_CONTROL_TYPE_ID; }
    return UIA_PANE_CONTROL_TYPE_ID;
}

fn _map_uia_patterns(nd) {
    let pats = [];
    if nd.role == "button" or nd.role == "link" { array_push(pats, UIA_INVOKE_PATTERN_ID); }
    if nd.role == "textbox" or nd.role == "edit" or nd.role == "combobox" { array_push(pats, UIA_VALUE_PATTERN_ID); }
    if nd.role == "checkbox" { array_push(pats, UIA_TOGGLE_PATTERN_ID); }
    if nd.role == "slider" or nd.role == "progressbar" { array_push(pats, UIA_RANGE_VALUE_PATTERN_ID); }
    if nd.role == "grid" or nd.role == "table" { array_push(pats, UIA_GRID_PATTERN_ID); }
    return pats;
}

fn _convert_uia_subtree(nd) {
    if nd == nil { return nil; }
    let ch_out = [];
    let i = 0;
    while i < len(nd.children) {
        array_push(ch_out, _convert_uia_subtree(nd.children[i]));
        i = i + 1;
    }
    return map{
        AutomationId: nd.id,
        ControlTypeId: _map_uia_control_type(nd.role),
        LocalizedControlType: nd.localized_role,
        Name: nd.name,
        HelpText: nd.description,
        IsEnabled: not nd.disabled,
        IsKeyboardFocusable: nd.focusable,
        TabIndex: nd.tab_index,
        SupportedPatterns: _map_uia_patterns(nd),
        Children: ch_out
    };
}

fn export_win32_uia_tree(a11y_tree) {
    let root = if is_map(a11y_tree) { _opt(a11y_tree, "root", nil) } else { nil };
    return map{
        ok: root != nil,
        provider_version: "UIAutomationCore_v3",
        tab_order: if is_map(a11y_tree) { _opt(a11y_tree, "tab_order", []) } else { [] },
        root: _convert_uia_subtree(root)
    };
}

// ============================================================================
// 5. Fine-Grained Glitch-Free Reactive Signals Engine ($O(1)$ Topological Push-Pull)
// ============================================================================

let _REACTIVE_RT = map{
    next_id: 1,
    active_observer: nil,
    batch_depth: 0,
    pending_effects: [],
    eval_depth: 0
};

fn _has_node_in_list(arr, target_id) {
    let i = 0;
    while i < len(arr) {
        if arr[i].id == target_id { return true; }
        i = i + 1;
    }
    return false;
}

fn _unlink_observer_sources(obs) {
    let i = 0;
    while i < len(obs.sources) {
        let src = obs.sources[i];
        let kept = [];
        let j = 0;
        while j < len(src.subscribers) {
            if src.subscribers[j].id != obs.id {
                array_push(kept, src.subscribers[j]);
            }
            j = j + 1;
        }
        src.subscribers = kept;
        i = i + 1;
    }
    obs.sources = [];
}

fn _track_dependency(source_node) {
    let obs = _REACTIVE_RT.active_observer;
    if obs == nil { return; }
    if not _has_node_in_list(obs.sources, source_node.id) {
        array_push(obs.sources, source_node);
    }
    if not _has_node_in_list(source_node.subscribers, obs.id) {
        array_push(source_node.subscribers, obs);
    }
    if source_node.topo_rank + 1 > obs.topo_rank {
        obs.topo_rank = source_node.topo_rank + 1;
    }
}

fn _schedule_effect(eff_node) {
    if eff_node.disposed { return; }
    if not _has_node_in_list(_REACTIVE_RT.pending_effects, eff_node.id) {
        array_push(_REACTIVE_RT.pending_effects, eff_node);
    }
}

fn _mark_subscribers_dirty(source_node) {
    let subs = slice(source_node.subscribers, 0, len(source_node.subscribers));
    let i = 0;
    while i < len(subs) {
        let sub = subs[i];
        if sub.node_kind == "computed" {
            if not sub.dirty {
                sub.dirty = true;
                _mark_subscribers_dirty(sub);
            }
        } elif sub.node_kind == "effect" {
            sub.dirty = true;
            _schedule_effect(sub);
        }
        i = i + 1;
    }
}

fn _flush_reactive_effects() {
    if _REACTIVE_RT.batch_depth > 0 { return; }
    let guard = 0;
    while len(_REACTIVE_RT.pending_effects) > 0 {
        guard = guard + 1;
        if guard > 4096 {
            _REACTIVE_RT.pending_effects = [];
            throw "reactive_signals: infinite effect cascade detected (> 4096 flushes)";
        }
        // Pop minimum topo_rank effect first so diamond graphs evaluate strictly glitch-free!
        let best_idx = 0;
        let best_rank = _REACTIVE_RT.pending_effects[0].topo_rank;
        let i = 1;
        while i < len(_REACTIVE_RT.pending_effects) {
            if _REACTIVE_RT.pending_effects[i].topo_rank < best_rank {
                best_rank = _REACTIVE_RT.pending_effects[i].topo_rank;
                best_idx = i;
            }
            i = i + 1;
        }
        let eff = _REACTIVE_RT.pending_effects[best_idx];
        let next_q = [];
        let k = 0;
        while k < len(_REACTIVE_RT.pending_effects) {
            if k != best_idx { array_push(next_q, _REACTIVE_RT.pending_effects[k]); }
            k = k + 1;
        }
        _REACTIVE_RT.pending_effects = next_q;
        if eff.dirty and not eff.disposed {
            eff.run();
        }
    }
}

fn create_signal(initial_value, opts = nil) {
    let id = _REACTIVE_RT.next_id;
    _REACTIVE_RT.next_id = id + 1;
    let eq_check = _opt(opts, "equals", true) == true;

    let node = map{
        id: id,
        node_kind: "signal",
        topo_rank: 0,
        value: initial_value,
        subscribers: []
    };

    let sig = map{
        id: id,
        kind: "pblang.ui.signal",
        get: fn() {
            _track_dependency(node);
            return node.value;
        },
        peek: fn() {
            return node.value;
        },
        set: fn(next_val) {
            if eq_check and node.value == next_val {
                return node.value;
            }
            node.value = next_val;
            _REACTIVE_RT.batch_depth = _REACTIVE_RT.batch_depth + 1;
            _mark_subscribers_dirty(node);
            _REACTIVE_RT.batch_depth = _REACTIVE_RT.batch_depth - 1;
            _flush_reactive_effects();
            return node.value;
        },
        update: fn(updater_fn) {
            return sig.set(updater_fn(node.value));
        },
        subscriber_count: fn() {
            return len(node.subscribers);
        }
    };
    return sig;
}

fn create_computed(compute_fn) {
    let id = _REACTIVE_RT.next_id;
    _REACTIVE_RT.next_id = id + 1;

    let node = map{
        id: id,
        node_kind: "computed",
        topo_rank: 1,
        dirty: true,
        computing: false,
        value: nil,
        sources: [],
        subscribers: []
    };

    let recompute = fn() {
        if node.computing {
            throw "reactive_signals: cyclic computed dependency detected";
        }
        if _REACTIVE_RT.eval_depth > 256 {
            throw "reactive_signals: maximum computed graph depth exceeded";
        }
        _unlink_observer_sources(node);
        node.topo_rank = 1;
        node.computing = true;
        let prev_obs = _REACTIVE_RT.active_observer;
        _REACTIVE_RT.active_observer = node;
        _REACTIVE_RT.eval_depth = _REACTIVE_RT.eval_depth + 1;
        let res = try map{ ok: true, v: compute_fn() } catch map{ ok: false, v: nil };
        _REACTIVE_RT.eval_depth = _REACTIVE_RT.eval_depth - 1;
        _REACTIVE_RT.active_observer = prev_obs;
        node.computing = false;
        if not res.ok {
            throw "reactive_signals: computed evaluation threw error";
        }
        node.value = res.v;
        node.dirty = false;
        return node.value;
    };

    return map{
        id: id,
        kind: "pblang.ui.computed",
        get: fn() {
            if node.dirty { recompute(); }
            _track_dependency(node);
            return node.value;
        },
        peek: fn() {
            if node.dirty { recompute(); }
            return node.value;
        }
    };
}

fn create_effect(effect_fn) {
    let id = _REACTIVE_RT.next_id;
    _REACTIVE_RT.next_id = id + 1;

    let node = map{
        id: id,
        node_kind: "effect",
        topo_rank: 1,
        dirty: true,
        disposed: false,
        run_count: 0,
        sources: []
    };

    node.run = fn() {
        if node.disposed { return; }
        _unlink_observer_sources(node);
        node.topo_rank = 1;
        node.dirty = false;
        let prev_obs = _REACTIVE_RT.active_observer;
        _REACTIVE_RT.active_observer = node;
        let ok = try { effect_fn(); true } catch false;
        _REACTIVE_RT.active_observer = prev_obs;
        if not ok {
            throw "reactive_signals: effect callback failed";
        }
        node.run_count = node.run_count + 1;
    };

    // Initial synchronous subscription pass
    node.run();

    return map{
        id: id,
        kind: "pblang.ui.effect",
        dispose: fn() {
            node.disposed = true;
            _unlink_observer_sources(node);
        },
        run_count: fn() {
            return node.run_count;
        }
    };
}

fn batch_signals(batch_fn) {
    _REACTIVE_RT.batch_depth = _REACTIVE_RT.batch_depth + 1;
    let res = try map{ ok: true, v: batch_fn() } catch map{ ok: false, v: nil };
    _REACTIVE_RT.batch_depth = _REACTIVE_RT.batch_depth - 1;
    if _REACTIVE_RT.batch_depth == 0 {
        _flush_reactive_effects();
    }
    if not res.ok {
        throw "reactive_signals: batch callback threw error";
    }
    return res.v;
}

fn untrack_signals(fn_body) {
    let prev = _REACTIVE_RT.active_observer;
    _REACTIVE_RT.active_observer = nil;
    let res = try map{ ok: true, v: fn_body() } catch map{ ok: false, v: nil };
    _REACTIVE_RT.active_observer = prev;
    if not res.ok {
        throw "reactive_signals: untrack callback threw error";
    }
    return res.v;
}

let UIA_ButtonControlTypeId = UIA_BUTTON_CONTROL_TYPE_ID;
let UIA_EditControlTypeId = UIA_EDIT_CONTROL_TYPE_ID;
let UIA_CheckBoxControlTypeId = UIA_CHECKBOX_CONTROL_TYPE_ID;
let UIA_ComboBoxControlTypeId = UIA_COMBOBOX_CONTROL_TYPE_ID;
let UIA_DataGridControlTypeId = UIA_DATAGRID_CONTROL_TYPE_ID;
let UIA_WindowControlTypeId = UIA_WINDOW_CONTROL_TYPE_ID;

