// PBLang-native Android WebView application generator.
// JVM class bytes are emitted directly; no Java/Kotlin source is generated.

let JVM = import("stdlib:jvm_classfile.sapp");
let Toolchain = import("stdlib:android_toolchain.sapp");

fn _ref(code, opcode, index) { JVM.emit(code, JVM.insn_u2(opcode, index)); }

fn _ldc(code, index) {
    if index < 1 or index > 65535 { throw "android_webview: invalid constant index"; }
    if index <= 255 { JVM.emit(code, [18, index]); }
    else { JVM.emit(code, JVM.insn_u2(19, index)); }
}

fn _ascii_identifier(value, dots) {
    let text = str(value);
    if text == "" or len(text) > 180 { return false; }
    let segment_start = true; let segments = 1; let i = 0;
    while i < len(text) {
        let c = strcharcodeat(text, i);
        if dots and c == 46 {
            if segment_start { return false; }
            segment_start = true; segments = segments + 1;
        } else {
            if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122)
               or (not segment_start and ((c >= 48 and c <= 57) or c == 95))) {
                return false;
            }
            segment_start = false;
        }
        i = i + 1;
    }
    return not segment_start and (not dots or segments >= 2);
}

fn _class_name(package_name) { return str_join(str_split(package_name, "."), "/") + "/MainActivity"; }

fn _url_char_allowed(code, character) {
    return (code >= 48 and code <= 57) or (code >= 65 and code <= 90)
        or (code >= 97 and code <= 122)
        or str_index_of("-._~/:?&=%", character) >= 0;
}

fn _safe_loopback_url(value) {
    let url = str(value);
    if len(url) < 18 or len(url) > 512 or str_contains(url, "\x00") { return false; }
    if not str_starts_with(url, "http://127.0.0.1:") { return false; }
    let rest = str_slice(url, len("http://127.0.0.1:"), len(url));
    let port_text = if str_index_of(rest, "/") < 0 { rest }
        else { str_slice(rest, 0, str_index_of(rest, "/")) };
    let port = try parse_number(port_text) catch nil;
    if port == nil or port != num_floor(port) or port < 1024 or port > 65535 { return false; }
    let i = 0;
    while i < len(rest) {
        if not _url_char_allowed(strcharcodeat(rest, i), str_slice(rest, i, i + 1)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _xml(value) {
    let out = ""; let i = 0; let text = str(value);
    while i < len(text) {
        let c = str_slice(text, i, i + 1);
        if c == "&" { out = out + "&amp;"; }
        elif c == "<" { out = out + "&lt;"; }
        elif c == ">" { out = out + "&gt;"; }
        elif c == "\"" { out = out + "&quot;"; }
        elif c == "'" { out = out + "&apos;"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

fn activity_class(package_name, url, options = nil) {
    if options == nil { options = map{}; }
    let javascript = try options.javascript catch true;
    if type(javascript) != "bool" { throw "android_webview: javascript must be boolean"; }
    if not _ascii_identifier(package_name, true) { throw "android_webview: invalid package"; }
    if not _safe_loopback_url(url) { throw "android_webview: only bounded 127.0.0.1 URLs are allowed"; }
    let class_name = _class_name(package_name);
    let c = JVM.new_class(class_name, "android/app/Activity");
    let activity_init = JVM.method_ref(c, "android/app/Activity", "<init>", "()V");
    let activity_create = JVM.method_ref(c, "android/app/Activity", "onCreate", "(Landroid/os/Bundle;)V");
    let set_content = JVM.method_ref(c, "android/app/Activity", "setContentView", "(Landroid/view/View;)V");
    let webview_class = JVM.class_ref(c, "android/webkit/WebView");
    let webview_init = JVM.method_ref(c, "android/webkit/WebView", "<init>", "(Landroid/content/Context;)V");
    let get_settings = JVM.method_ref(c, "android/webkit/WebView", "getSettings", "()Landroid/webkit/WebSettings;");
    let set_js = JVM.method_ref(c, "android/webkit/WebSettings", "setJavaScriptEnabled", "(Z)V");
    let set_file = JVM.method_ref(c, "android/webkit/WebSettings", "setAllowFileAccess", "(Z)V");
    let set_content_access = JVM.method_ref(c, "android/webkit/WebSettings", "setAllowContentAccess", "(Z)V");
    let client_class = JVM.class_ref(c, "android/webkit/WebViewClient");
    let client_init = JVM.method_ref(c, "android/webkit/WebViewClient", "<init>", "()V");
    let set_client = JVM.method_ref(c, "android/webkit/WebView", "setWebViewClient", "(Landroid/webkit/WebViewClient;)V");
    let load_url = JVM.method_ref(c, "android/webkit/WebView", "loadUrl", "(Ljava/lang/String;)V");

    let init = JVM.code_builder();
    JVM.emit_aload(init, 0); _ref(init, 183, activity_init); JVM.emit(init, 177);
    JVM.add_method(c, 1, "<init>", "()V", 1, 1, JVM.finish_code(init));

    let create = JVM.code_builder();
    JVM.emit_aload(create, 0); JVM.emit_aload(create, 1); _ref(create, 183, activity_create);
    _ref(create, 187, webview_class); JVM.emit(create, 89); JVM.emit_aload(create, 0);
    _ref(create, 183, webview_init); JVM.emit_astore(create, 2);
    JVM.emit_aload(create, 2); _ref(create, 182, get_settings); JVM.emit(create, if javascript { 4 } else { 3 }); _ref(create, 182, set_js);
    JVM.emit_aload(create, 2); _ref(create, 182, get_settings); JVM.emit(create, 3); _ref(create, 182, set_file);
    JVM.emit_aload(create, 2); _ref(create, 182, get_settings); JVM.emit(create, 3); _ref(create, 182, set_content_access);
    JVM.emit_aload(create, 2); _ref(create, 187, client_class); JVM.emit(create, 89); _ref(create, 183, client_init);
    _ref(create, 182, set_client);
    JVM.emit_aload(create, 2); _ldc(create, JVM.string_ref(c, url)); _ref(create, 182, load_url);
    JVM.emit_aload(create, 0); JVM.emit_aload(create, 2); _ref(create, 182, set_content); JVM.emit(create, 177);
    JVM.add_method(c, 4, "onCreate", "(Landroid/os/Bundle;)V", 4, 3, JVM.finish_code(create));
    return JVM.finish(c);
}

let RELEASE_CHANNEL = import("stdlib:release_channel.sapp");

fn _version_plan(options) {
    let plan = RELEASE_CHANNEL.resolve(str(try options.version catch "1.0.0"), options);
    if not plan.ok { throw "android_webview: " + plan.error; }
    return plan;
}

fn manifest(name, package_name, options = nil) {
    if options == nil { options = map{}; }
    if not _ascii_identifier(package_name, true) { throw "android_webview: invalid package"; }
    let min_sdk = num_floor(try options.min_sdk catch 21);
    let target_sdk = num_floor(try options.target_sdk catch 34);
    if min_sdk < 21 or min_sdk > target_sdk or target_sdk < 34 or target_sdk > 999 {
        throw "android_webview: invalid SDK range";
    }
    // pblang-security-ignore-next-line: network.plaintext-http reason=Android XML namespace identifier
    let xmlns = "http://schemas.android.com/apk/res/android";
    let release = _version_plan(options);
    return "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
        + "<manifest xmlns:android=\"" + xmlns + "\" package=\"" + package_name
        + "\" android:versionCode=\"" + str(num_floor(try options.version_code catch 1))
        + "\" android:versionName=\"" + _xml(release.application_version) + "\">\n"
        + "  <uses-sdk android:minSdkVersion=\"" + str(min_sdk) + "\" android:targetSdkVersion=\"" + str(target_sdk) + "\"/>\n"
        + "  <uses-permission android:name=\"android.permission.INTERNET\"/>\n"
        + "  <application android:allowBackup=\"false\" android:debuggable=\"true\" android:hardwareAccelerated=\"true\" "
        + "android:largeHeap=\"false\" android:label=\"" + _xml(name) + "\" android:usesCleartextTraffic=\"true\" "
        + "android:theme=\"@android:style/Theme.Material.NoActionBar\">\n"
        + "    <activity android:name=\".MainActivity\" android:exported=\"true\" android:screenOrientation=\"unspecified\" android:windowSoftInputMode=\"adjustResize\">\n"
        + "      <intent-filter><action android:name=\"android.intent.action.MAIN\"/><category android:name=\"android.intent.category.LAUNCHER\"/></intent-filter>\n"
        + "    </activity>\n  </application>\n</manifest>\n";
}

fn generate(name, options = nil) {
    if options == nil { options = map{}; }
    let package_name = str(try options.package catch "org.pblang.webviewapp");
    let url = str(try options.url catch "http://127.0.0.1:8766/");
    let release = _version_plan(options);
    let version = release.base_version;
    let version_code = num_floor(try options.version_code catch 1);
    let min_sdk = num_floor(try options.min_sdk catch 21);
    let target_sdk = num_floor(try options.target_sdk catch 34);
    return map{ format:"pblang.modern-ui.android.v1", name:str(name), package:package_name,
        activity:package_name + ".MainActivity", class_name:_class_name(package_name),
        class_bytes:activity_class(package_name, url, options), manifest:manifest(name, package_name, options),
        widgets:1, actions:0, version:version, display_version:release.application_version,
        release_channel:release.release_channel, version_code:version_code,
        min_sdk:min_sdk, target_sdk:target_sdk, url:url,
        runtime:"pblang-loopback-webview" };
}

fn build(name, options = nil) { return Toolchain.build(generate(name, options), options); }

export activity_class, manifest, generate, build;
