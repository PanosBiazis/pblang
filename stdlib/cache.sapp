// stdlib/cache.sapp — In-memory key-value cache with TTL support.
//
// Usage:
//   let c = cache.new(60000);          // default TTL 60 seconds in ms
//   cache.set(c, "key", "value");
//   let v = cache.get(c, "key");       // nil if expired or missing
//   cache.set_ttl(c, "key2", data, 5000); // custom 5s TTL

// new(default_ttl_ms) — create a cache; default_ttl_ms=0 means no expiry
fn new(default_ttl_ms) {
    return map{
        __data: map{},
        __expiry: map{},
        __ttl: default_ttl_ms
    };
}

// set(cache, key, value) — store with default TTL
fn set(cache_obj, key, value) {
    cache_obj.__data[key] = value;
    if cache_obj.__ttl > 0 {
        cache_obj.__expiry[key] = now_ms() + cache_obj.__ttl;
    } else {
        if map_has(cache_obj.__expiry, key) {
            map_remove(cache_obj.__expiry, key);
        }
    }
    return cache_obj;
}

// set_ttl(cache, key, value, ttl_ms) — store with custom TTL
fn set_ttl(cache_obj, key, value, ttl_ms) {
    cache_obj.__data[key] = value;
    if ttl_ms > 0 {
        cache_obj.__expiry[key] = now_ms() + ttl_ms;
    }
    return cache_obj;
}

// get(cache, key) — retrieve; returns nil if missing or expired
fn get(cache_obj, key) {
    if map_has(cache_obj.__data, key) == false { return nil; }
    // Check TTL
    if map_has(cache_obj.__expiry, key) {
        if now_ms() > cache_obj.__expiry[key] {
            // Expired — evict
            map_remove(cache_obj.__data, key);
            map_remove(cache_obj.__expiry, key);
            return nil;
        }
    }
    return cache_obj.__data[key];
}

// has(cache, key) — true if key exists and not expired
fn has(cache_obj, key) {
    return get(cache_obj, key) != nil;
}

// delete(cache, key) — remove a key
fn delete(cache_obj, key) {
    if map_has(cache_obj.__data, key) {
        map_remove(cache_obj.__data, key);
    }
    if map_has(cache_obj.__expiry, key) {
        map_remove(cache_obj.__expiry, key);
    }
    return cache_obj;
}

// clear(cache) — remove all entries
fn clear(cache_obj) {
    let ks = map_keys(cache_obj.__data);
    for i len(ks) {
        map_remove(cache_obj.__data, ks[i]);
    }
    let eks = map_keys(cache_obj.__expiry);
    for i len(eks) {
        map_remove(cache_obj.__expiry, eks[i]);
    }
    return cache_obj;
}

// size(cache) — number of entries (may include some expired, not yet evicted)
fn size(cache_obj) {
    return len(map_keys(cache_obj.__data));
}

// get_or_set(cache, key, fn) — return cached value; compute and store if missing
fn get_or_set(cache_obj, key, fn_val) {
    let v = get(cache_obj, key);
    if v != nil { return v; }
    let computed = fn_val();
    set(cache_obj, key, computed);
    return computed;
}

// evict_expired(cache) — remove all expired entries
fn evict_expired(cache_obj) {
    let now = now_ms();
    let eks = map_keys(cache_obj.__expiry);
    for i len(eks) {
        let k = eks[i];
        if now > cache_obj.__expiry[k] {
            map_remove(cache_obj.__data, k);
            map_remove(cache_obj.__expiry, k);
        }
    }
    return cache_obj;
}

export new, set, set_ttl, get, has, delete, clear, size, get_or_set, evict_expired;
