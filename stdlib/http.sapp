// stdlib/http.sapp — HTTP client utilities.
//
// Builtins: http_get(url), http_post(url, body[, content_type]),
// http_post_auth(url, headers_map, body)

let get = http_get;
let post = http_post;

fn _bearer_value(token) {
    let t = str(token);
    if str_starts_with(t, "Bearer ") { return t; }
    return "Bearer " + t;
}

fn _bearer_headers(token) {
    return map{
        "Authorization": _bearer_value(token),
        "Content-Type": "application/json"
    };
}

fn _stream_chunks(raw, on_chunk) {
    if raw == nil { return nil; }
    let parts = str_split(str(raw), "\n\n");
    for i len(parts) {
        if str_trim(parts[i]) != "" {
            on_chunk(parts[i] + "\n\n");
        }
    }
    return true;
}

// JSON helpers
fn get_json(url) {
    import "stdlib:json.sapp";
    return json.parse(get(url));
}

fn post_json(url, value) {
    import "stdlib:json.sapp";
    return post(url, json.stringify(value));
}

// Authenticated requests
fn post_auth(url, body, token) {
    return http_post_auth(url, _bearer_headers(token), body);
}

fn get_auth(url, token) {
    return http_get_auth(url, token);
}

fn post_json_auth(url, value, token) {
    import "stdlib:json.sapp";
    return post_auth(url, json.stringify(value), token);
}

// Streaming helpers are SSE-style shims: they fetch the full response today,
// then split on blank lines and invoke on_chunk per event-sized part.
fn get_stream(url, on_chunk) {
    return _stream_chunks(get(url), on_chunk);
}

fn post_stream(url, body, on_chunk) {
    return _stream_chunks(post(url, body), on_chunk);
}

fn post_stream_auth(url, body, token, on_chunk) {
    return _stream_chunks(post_auth(url, body, token), on_chunk);
}

// Parse a single Server-Sent Events line (WHATWG SSE field grammar). Handles
// "field:value" AND "field: value" (one optional leading space is stripped, per
// spec), and ":"-prefixed comment lines. Recognized fields: data, event, id,
// retry; anything else is "unknown".
fn parse_sse_line(line) {
    let trimmed = str_trim(line);
    if len(trimmed) == 0 { return nil; }
    // A line beginning with ':' is a comment (e.g. ": keepalive").
    if str_starts_with(trimmed, ":") {
        return map{ kind: "comment", value: str_trim(str_slice(trimmed, 1, len(trimmed))) };
    }
    let colon = str_index_of(trimmed, ":");
    let field = trimmed;
    let value = "";
    if colon >= 0 {
        field = str_slice(trimmed, 0, colon);
        value = str_slice(trimmed, colon + 1, len(trimmed));
        if str_starts_with(value, " ") { value = str_slice(value, 1, len(value)); }
    }
    if field == "data" { return map{ kind: "data", value: value }; }
    if field == "event" { return map{ kind: "event", value: value }; }
    if field == "id" { return map{ kind: "id", value: value }; }
    if field == "retry" { return map{ kind: "retry", value: value }; }
    return map{ kind: "unknown", value: trimmed };
}

// retry(fn, max_attempts, delay_ms) — retry a function up to max_attempts times
// fn must return a value (non-nil = success, nil or map{error} = failure)
fn retry(fn_val, max_attempts, delay_ms) {
    let attempt = 0;
    let last_result = nil;
    while attempt < max_attempts {
        let result = fn_val();
        if result != nil {
            if type(result) == "map" {
                if map_has(result, "error") == false { return result; }
            } else {
                return result;
            }
        }
        last_result = result;
        attempt = attempt + 1;
        if attempt < max_attempts { sleep_ms(delay_ms); }
    }
    return last_result;
}

// retry_backoff(fn, max_attempts, base_delay_ms) — like retry, but the delay
// DOUBLES after each failed attempt (exponential backoff: base, 2·base, 4·base…),
// the right strategy for rate-limited / flaky network calls. Same success rule as
// retry (non-nil and not a map carrying `error`).
fn retry_backoff(fn_val, max_attempts, base_delay_ms) {
    let attempt = 0;
    let last_result = nil;
    let delay = base_delay_ms;
    while attempt < max_attempts {
        let result = fn_val();
        if result != nil {
            if type(result) == "map" {
                if map_has(result, "error") == false { return result; }
            } else {
                return result;
            }
        }
        last_result = result;
        attempt = attempt + 1;
        if attempt < max_attempts { sleep_ms(delay); delay = delay * 2; }
    }
    return last_result;
}

// build_query_string(params_map) → "key1=val1&key2=val2", with keys AND values
// percent-encoded (url_encode). Encoding is mandatory: an unencoded value
// containing '&'/'='/space/'#' would corrupt the query and let an attacker inject
// extra parameters (e.g. {q:"a&admin=1"}). A LIST value emits one repeated key per
// element ("tag=x&tag=y").
fn build_query_string(params) {
    let keys = map_keys(params);
    let parts = [];
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        let v = params[k];
        if is_array(v) {
            let j = 0;
            while j < len(v) { array_push(parts, url_encode(k) + "=" + url_encode(str(v[j]))); j = j + 1; }
        } else {
            array_push(parts, url_encode(k) + "=" + url_encode(str(v)));
        }
        i = i + 1;
    }
    return str_join(parts, "&");
}

// encode_form(fields) → an application/x-www-form-urlencoded body string (same
// percent-encoding as a query string). Use with post() + the form content type.
fn encode_form(fields) { return build_query_string(fields); }

// post_form(url, fields) → POST `fields` as an x-www-form-urlencoded body.
fn post_form(url, fields) {
    return post(url, encode_form(fields), "application/x-www-form-urlencoded");
}

// get_with_params(base_url, params_map) — append query string to URL
fn get_with_params(base_url, params) {
    let qs = build_query_string(params);
    if len(qs) == 0 { return get(base_url); }
    return get(base_url + "?" + qs);
}

// parse_response_json(raw) — safely parse an HTTP response body as JSON. Truly
// safe: a malformed body makes json.parse THROW, so it is wrapped — invalid input
// yields an { error, raw } map instead of crashing the caller.
fn parse_response_json(raw) {
    import "stdlib:json.sapp";
    if raw == nil { return map{ error: "empty response" }; }
    let parsed = try json.parse(raw) catch nil;
    if parsed == nil { return map{ error: "invalid JSON response", raw: raw }; }
    return parsed;
}

export get, post, get_json, post_json, post_auth, get_auth, post_json_auth,
       get_stream, post_stream, post_stream_auth,
       parse_sse_line, retry, retry_backoff, build_query_string, encode_form, post_form,
       get_with_params, parse_response_json;
