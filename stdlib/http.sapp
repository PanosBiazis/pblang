// stdlib/http.sapp

let get = http_get;
let post = http_post;

// Helpers that assume JSON payloads
fn get_json(url) {
    import "stdlib:json.sapp";
    return json.parse(get(url));
}

fn post_json(url, value) {
    import "stdlib:json.sapp";
    return post(url, json.stringify(value));
}

export get, post, get_json, post_json;

