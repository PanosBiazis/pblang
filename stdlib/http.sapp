// stdlib/http.sapp — HTTP client utilities.
//
// Builtins: http_get(url), http_post(url, body), http_post_auth(url, body, token)

let get = http_get;
let post = http_post;

// JSON helpers
fn get_json(url) {
    import "stdlib:json.sapp";
    return json.parse(get(url));
}

fn post_json(url, value) {
    import "stdlib:json.sapp";
    return post(url, json.stringify(value));
}

// Authenticated requests
fn post_auth(url, body, token) {
    return http_post_auth(url, body, token);
}

fn get_auth(url, token) {
    return http_get_auth(url, token);
}

fn post_json_auth(url, value, token) {
    import "stdlib:json.sapp";
    return http_post_auth(url, json.stringify(value), token);
}

// Parse a single Server-Sent Events line.
fn parse_sse_line(line) {
    let trimmed = str_trim(line);
    if len(trimmed) == 0 { return nil; }
    if str_starts_with(trimmed, "#") { return nil; }
    if str_starts_with(trimmed, "data: ") {
        return map{ kind: "data", value: str_slice(trimmed, 6, len(trimmed)) };
    }
    if str_starts_with(trimmed, "event: ") {
        return map{ kind: "event", value: str_slice(trimmed, 7, len(trimmed)) };
    }
    if str_starts_with(trimmed, "id: ") {
        return map{ kind: "id", value: str_slice(trimmed, 4, len(trimmed)) };
    }
    return map{ kind: "unknown", value: trimmed };
}

// retry(fn, max_attempts, delay_ms) — retry a function up to max_attempts times
// fn must return a value (non-nil = success, nil or map{error} = failure)
fn retry(fn_val, max_attempts, delay_ms) {
    let attempt = 0;
    let last_result = nil;
    while attempt < max_attempts {
        let result = fn_val();
        if result != nil {
            if type(result) == "map" {
                if map_has(result, "error") == false { return result; }
            } else {
                return result;
            }
        }
        last_result = result;
        attempt = attempt + 1;
        if attempt < max_attempts { sleep_ms(delay_ms); }
    }
    return last_result;
}

// build_query_string(params_map) → "key1=val1&key2=val2"
fn build_query_string(params) {
    let keys = map_keys(params);
    let parts = [];
    for i len(keys) {
        let k = keys[i];
        array_push(parts, k + "=" + str(params[k]));
    }
    let result = "";
    for i len(parts) {
        if i == 0 { result = parts[0]; }
        else       { result = result + "&" + parts[i]; }
    }
    return result;
}

// get_with_params(base_url, params_map) — append query string to URL
fn get_with_params(base_url, params) {
    let qs = build_query_string(params);
    if len(qs) == 0 { return get(base_url); }
    return get(base_url + "?" + qs);
}

// parse_response_json(raw) — safely parse an HTTP response body as JSON
fn parse_response_json(raw) {
    import "stdlib:json.sapp";
    if raw == nil { return map{ error: "empty response" }; }
    let parsed = json.parse(raw);
    if parsed == nil { return map{ error: "invalid JSON response", raw: raw }; }
    return parsed;
}

export get, post, get_json, post_json, post_auth, get_auth, post_json_auth,
       parse_sse_line, retry, build_query_string, get_with_params, parse_response_json;
