// stdlib/llm_eval.sapp -- evaluation and benchmark helpers for LLM checkpoints.

let core = import("stdlib:llm_core.sapp");

fn evaluate(model, logits_fn, examples) {
    let total = 0.0;
    let correct = 0;
    let i = 0;
    while i < len(examples) {
        let logits = logits_fn(model, examples[i].x);
        total = total + core.cross_entropy_from_logits(logits, examples[i].y);
        if core.argmax(logits) == examples[i].y { correct = correct + 1; }
        i = i + 1;
    }
    let loss = 0.0;
    if len(examples) > 0 { loss = total / len(examples); }
    let acc = 0.0;
    if len(examples) > 0 { acc = correct / len(examples); }
    return map{
        format: "pblang.llm.eval.v1",
        examples: len(examples),
        loss: loss,
        perplexity: core.perplexity(loss),
        accuracy: acc
    };
}

fn sequence_evaluate(model, logits_fn, ids, context = 4) {
    if context < 1 { context = 1; }
    let total = 0.0;
    let correct = 0;
    let examples = 0;
    let i = 1;
    while i < len(ids) {
        let start = i - context;
        if start < 0 { start = 0; }
        let ctx = [];
        let j = start;
        while j < i {
            push(ctx, ids[j]);
            j = j + 1;
        }
        if len(ctx) > 0 {
            let logits = logits_fn(model, ctx);
            total = total + core.cross_entropy_from_logits(logits, ids[i]);
            if core.argmax(logits) == ids[i] { correct = correct + 1; }
            examples = examples + 1;
        }
        i = i + 1;
    }
    let loss = 0.0;
    if examples > 0 { loss = total / examples; }
    let acc = 0.0;
    if examples > 0 { acc = correct / examples; }
    return map{
        format: "pblang.llm.sequence_eval.v1",
        context: context,
        tokens: len(ids),
        examples: examples,
        loss: loss,
        perplexity: core.perplexity(loss),
        accuracy: acc
    };
}

fn regression_prompt(prompt, expected_contains) {
    return map{ prompt: prompt, expected_contains: expected_contains };
}

fn max_repetition_run(text) {
    let longest = 0;
    let current = 0;
    let prev = -1;
    let i = 0;
    while i < len(text) {
        let c = strcharcodeat(text, i);
        if c == prev { current = current + 1; }
        else { current = 1; prev = c; }
        if current > longest { longest = current; }
        i = i + 1;
    }
    return longest;
}

fn _is_alnum_code(c) {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
}

fn _is_space_code(c) {
    return c == 9 or c == 10 or c == 13 or c == 32;
}

fn _contains_forbidden_text(lower_text, forbidden) {
    let f = str_lower(str(forbidden));
    if f == "" { return false; }
    let base = 0;
    let rest = lower_text;
    while true {
        let pos = str_index_of(rest, f);
        if pos < 0 { return false; }
        let actual = base + pos;
        let ok = true;
        if _is_alnum_code(strcharcodeat(f, 0)) and actual > 0 and _is_alnum_code(strcharcodeat(lower_text, actual - 1)) {
            ok = false;
        }
        let end = actual + len(f);
        if _is_alnum_code(strcharcodeat(f, len(f) - 1)) and end < len(lower_text) and _is_alnum_code(strcharcodeat(lower_text, end)) {
            ok = false;
        }
        if ok { return true; }
        base = actual + 1;
        if base >= len(lower_text) { return false; }
        rest = str_slice(lower_text, base, len(lower_text));
    }
    return false;
}

fn text_shape(text) {
    let opens = 0;
    let closes = 0;
    let alnum = 0;
    let spaces = 0;
    let symbols = 0;
    let symbol_run = 0;
    let max_symbol_run = 0;
    let i = 0;
    while i < len(text) {
        let c = strcharcodeat(text, i);
        if c == 40 or c == 91 or c == 123 { opens = opens + 1; }
        if c == 41 or c == 93 or c == 125 { closes = closes + 1; }
        if _is_alnum_code(c) {
            alnum = alnum + 1;
            symbol_run = 0;
        } else if _is_space_code(c) {
            spaces = spaces + 1;
            symbol_run = 0;
        } else {
            symbols = symbols + 1;
            symbol_run = symbol_run + 1;
            if symbol_run > max_symbol_run { max_symbol_run = symbol_run; }
        }
        i = i + 1;
    }
    let imbalance = opens - closes;
    if imbalance < 0 { imbalance = 0 - imbalance; }
    let keyword_hits = 0;
    let lower = str_lower(text);
    let keywords = ["fn ", "let ", "return", "print ", "if ", "while ", "for ", "map{"];
    let k = 0;
    while k < len(keywords) {
        if str_contains(lower, keywords[k]) { keyword_hits = keyword_hits + 1; }
        k = k + 1;
    }
    let score = 1.0;
    if max_symbol_run > 2 { score = score - (max_symbol_run - 2) * 0.15; }
    if imbalance > 0 { score = score - imbalance * 0.08; }
    if keyword_hits > 0 { score = score + 0.10; }
    if alnum == 0 and len(text) > 0 { score = score - 0.40; }
    if score < 0.0 { score = 0.0; }
    if score > 1.0 { score = 1.0; }
    return map{
        format: "pblang.llm.text_shape.v1",
        score: score,
        chars: len(text),
        alnum: alnum,
        spaces: spaces,
        symbols: symbols,
        delimiter_imbalance: imbalance,
        max_symbol_run: max_symbol_run,
        keyword_hits: keyword_hits,
        passed: score >= 0.60
    };
}

fn generation_quality(prompt, text, expected = nil, forbidden = nil, min_generated = 1, max_repeat = 6) {
    if expected == nil { expected = []; }
    if forbidden == nil { forbidden = []; }
    let score = 0;
    let max_score = 0;
    let expected_hits = 0;
    let forbidden_hits = 0;
    let details = [];
    let lc = str_lower(str(text));
    let tail = "";
    if len(text) > len(prompt) { tail = str_slice(text, len(prompt), len(text)); }

    let i = 0;
    while i < len(expected) {
        max_score = max_score + 2;
        let e = str(expected[i]);
        if str_contains(lc, str_lower(e)) {
            score = score + 2;
            expected_hits = expected_hits + 1;
            push(details, "hit:" + e);
        } else {
            push(details, "miss:" + e);
        }
        i = i + 1;
    }

    let j = 0;
    while j < len(forbidden) {
        max_score = max_score + 2;
        let f = str(forbidden[j]);
        if _contains_forbidden_text(lc, f) {
            forbidden_hits = forbidden_hits + 1;
            push(details, "forbidden:" + f);
        } else {
            score = score + 2;
        }
        j = j + 1;
    }

    max_score = max_score + 1;
    if len(tail) >= min_generated {
        score = score + 1;
        push(details, "length-ok");
    } else {
        push(details, "too-short");
    }

    max_score = max_score + 1;
    if str_trim(tail) != "" {
        score = score + 1;
        push(details, "nonblank-tail");
    } else {
        push(details, "blank-tail");
    }

    max_score = max_score + 1;
    let run = max_repetition_run(tail);
    if run <= max_repeat {
        score = score + 1;
        push(details, "repetition-ok");
    } else {
        push(details, "repetition-run:" + str(run));
    }

    let normalized = 0.0;
    if max_score > 0 { normalized = score / max_score; }
    return map{
        format: "pblang.llm.generation_quality.v1",
        score: score,
        max_score: max_score,
        normalized: normalized,
        passed: normalized >= 0.60 and forbidden_hits == 0 and run <= max_repeat,
        expected_hits: expected_hits,
        forbidden_hits: forbidden_hits,
        repetition_run: run,
        generated_chars: len(tail),
        details: details
    };
}

fn choose_generation(prompt, texts, expected = nil, forbidden = nil, min_generated = 1, max_repeat = 6) {
    if expected == nil { expected = []; }
    if forbidden == nil { forbidden = []; }
    let candidates = [];
    let best_index = -1;
    let best_quality = nil;
    let i = 0;
    while i < len(texts) {
        let q = generation_quality(prompt, texts[i], expected, forbidden, min_generated, max_repeat);
        push(candidates, map{
            index: i,
            text: texts[i],
            quality: q
        });
        if best_index < 0
            or q.normalized > best_quality.normalized
            or (q.normalized == best_quality.normalized and q.repetition_run < best_quality.repetition_run)
            or (q.normalized == best_quality.normalized and q.repetition_run == best_quality.repetition_run and q.generated_chars > best_quality.generated_chars) {
            best_index = i;
            best_quality = q;
        }
        i = i + 1;
    }
    let best_text = "";
    if best_index >= 0 { best_text = texts[best_index]; }
    return map{
        format: "pblang.llm.generation_choice.v1",
        mode: "score-candidates-by-generation-quality",
        prompt: prompt,
        candidates: candidates,
        best_index: best_index,
        best_text: best_text,
        best_quality: best_quality
    };
}

fn teacher_record_quality(record, min_chars = 40, min_score = 0.65) {
    let text = str(try record.teacher_text catch "");
    let prompt = str(try record.prompt catch "");
    let expected = try record.expected catch [];
    let forbidden = try record.forbidden catch [];
    let source = str(try record.teacher_text_source catch "unknown");
    let chars = len(text);
    let q = generation_quality(prompt, text, expected, forbidden, 1, 8);
    let shape = text_shape(text);
    let length_score = 1.0;
    if chars < min_chars {
        length_score = chars / min_chars;
    }
    if length_score < 0.0 { length_score = 0.0; }
    if length_score > 1.0 { length_score = 1.0; }

    let score = q.normalized * 0.60 + shape.score * 0.30 + length_score * 0.10;
    let reasons = [];
    if chars < min_chars { push(reasons, "teacher-text-too-short"); }
    if q.forbidden_hits > 0 { push(reasons, "forbidden-token-hit"); }
    if not q.passed { push(reasons, "generation-quality-failed"); }
    if shape.score < 0.55 { push(reasons, "text-shape-weak"); }
    if score < min_score { push(reasons, "teacher-score-low"); }
    return map{
        format: "pblang.llm.teacher_record_quality.v1",
        source: source,
        chars: chars,
        min_chars: min_chars,
        score: score,
        min_score: min_score,
        passed: len(reasons) == 0,
        reasons: reasons,
        generation_quality: q,
        text_shape: shape
    };
}

fn teacher_dataset_quality(records, min_chars = 40, min_score = 0.65) {
    let qualities = [];
    let passed = 0;
    let failed = 0;
    let total_score = 0.0;
    let total_chars = 0;
    let min_seen_chars = 0;
    let i = 0;
    while i < len(records) {
        let q = teacher_record_quality(records[i], min_chars, min_score);
        push(qualities, q);
        total_score = total_score + q.score;
        total_chars = total_chars + q.chars;
        if i == 0 or q.chars < min_seen_chars { min_seen_chars = q.chars; }
        if q.passed { passed = passed + 1; }
        else { failed = failed + 1; }
        i = i + 1;
    }
    let avg_score = 0.0;
    let avg_chars = 0.0;
    if len(records) > 0 {
        avg_score = total_score / len(records);
        avg_chars = total_chars / len(records);
    }
    return map{
        format: "pblang.llm.teacher_dataset_quality.v1",
        records: len(records),
        passed_records: passed,
        failed_records: failed,
        min_chars: min_chars,
        min_score: min_score,
        min_seen_chars: min_seen_chars,
        avg_chars: avg_chars,
        avg_score: avg_score,
        passed: len(records) > 0 and failed == 0 and avg_score >= min_score,
        qualities: qualities,
        policy: "teacher data must be long enough, avoid forbidden tokens, and pass generation/text-shape checks before distillation"
    };
}

fn _abs_num(x) {
    if x < 0 { return 0 - x; }
    return x;
}

fn objective_component(name, value, target, direction = "higher", weight = 1.0) {
    let gap = 0.0;
    if direction == "lower" {
        if value > target { gap = value - target; }
    } else if direction == "near" {
        gap = _abs_num(value - target);
    } else {
        if value < target { gap = target - value; }
    }
    let scale = _abs_num(target);
    if scale < 1.0 { scale = 1.0; }
    let normalized = gap / scale;
    if normalized < 0.0 { normalized = 0.0; }
    let weighted = normalized * weight;
    return map{
        format: "pblang.llm.objective_component.v1",
        name: name,
        value: value,
        target: target,
        direction: direction,
        weight: weight,
        gap: gap,
        normalized_gap: normalized,
        weighted_gap: weighted,
        passed: gap <= 0.0
    };
}

fn objective_distance(components) {
    let total_weight = 0.0;
    let total_gap = 0.0;
    let passed = 0;
    let failed = 0;
    let i = 0;
    while i < len(components) {
        total_weight = total_weight + components[i].weight;
        total_gap = total_gap + components[i].weighted_gap;
        if components[i].passed { passed = passed + 1; }
        else { failed = failed + 1; }
        i = i + 1;
    }
    let distance = 0.0;
    if total_weight > 0 { distance = total_gap / total_weight; }
    return map{
        format: "pblang.llm.objective_distance.v1",
        components: components,
        component_count: len(components),
        passed_components: passed,
        failed_components: failed,
        total_weight: total_weight,
        distance: distance,
        alignment_score: 1.0 / (1.0 + distance),
        passed: len(components) > 0 and failed == 0
    };
}

fn reinforcement_from_objective(previous, current, tolerance = 0.0001) {
    let delta = previous.distance - current.distance;
    let action = "neutral";
    if delta > tolerance { action = "reward"; }
    if delta < 0 - tolerance { action = "punish"; }
    return map{
        format: "pblang.llm.objective_reinforcement.v1",
        action: action,
        score: delta,
        reward: action == "reward",
        punish: action == "punish",
        neutral: action == "neutral",
        previous_distance: previous.distance,
        current_distance: current.distance,
        tolerance: tolerance,
        reason: "reward if objective distance decreases; punish if it increases; neutral inside tolerance"
    };
}

fn trial_candidate(name, previous_objective, current_objective, metadata = nil) {
    if metadata == nil { metadata = map{}; }
    let reinforcement = reinforcement_from_objective(previous_objective, current_objective, 0.0001);
    return map{
        format: "pblang.llm.trial_candidate.v1",
        name: name,
        previous_state: previous_objective,
        current_state: current_objective,
        previous_distance: previous_objective.distance,
        current_distance: current_objective.distance,
        delta: reinforcement.score,
        reinforcement: reinforcement,
        accepted: reinforcement.reward,
        metadata: metadata
    };
}

fn select_trial_elites(candidates, keep_n = 1) {
    if keep_n < 1 { keep_n = 1; }
    let pending = [];
    let i = 0;
    let rewarded = 0;
    let punished = 0;
    let neutral = 0;
    while i < len(candidates) {
        push(pending, candidates[i]);
        if candidates[i].reinforcement.reward { rewarded = rewarded + 1; }
        else if candidates[i].reinforcement.punish { punished = punished + 1; }
        else { neutral = neutral + 1; }
        i = i + 1;
    }
    let ranked = [];
    while len(pending) > 0 {
        let best_idx = 0;
        let j = 1;
        while j < len(pending) {
            let better = false;
            if pending[j].current_distance < pending[best_idx].current_distance { better = true; }
            if pending[j].current_distance == pending[best_idx].current_distance and pending[j].delta > pending[best_idx].delta { better = true; }
            if better { best_idx = j; }
            j = j + 1;
        }
        push(ranked, pending[best_idx]);
        let next = [];
        let k = 0;
        while k < len(pending) {
            if k != best_idx { push(next, pending[k]); }
            k = k + 1;
        }
        pending = next;
    }
    let kept = [];
    let rejected = [];
    let r = 0;
    while r < len(ranked) {
        if r < keep_n { push(kept, ranked[r]); }
        else { push(rejected, ranked[r]); }
        r = r + 1;
    }
    return map{
        format: "pblang.llm.trial_elite_selection.v1",
        candidates: ranked,
        kept: kept,
        rejected: rejected,
        keep_n: keep_n,
        rewarded: rewarded,
        punished: punished,
        neutral: neutral,
        best: if len(kept) > 0 { kept[0] } else { nil },
        policy: "rank by lowest current objective distance, then largest positive delta"
    };
}

fn regression_proxy(valid_loss, mode = "validation-only-quick-screen") {
    return map{
        format: "pblang.llm.regression_proxy.v1",
        mode: mode,
        purpose: "cheap screening proxy when full prompt generation/regression is intentionally skipped",
        cases: 0,
        passed: 0,
        failed: 0,
        pass_rate: 0.0,
        average_score: 0.0,
        valid_loss: valid_loss,
        generation_policy: "not-run-during-quick-screen",
        results: []
    };
}

fn selection_score(valid_loss, regression) {
    let pass_rate = try regression.pass_rate catch 0.0;
    let average_score = try regression.average_score catch 0.0;
    let failed = try regression.failed catch 0;
    let score = valid_loss - pass_rate * 0.20 - average_score * 0.10 + failed * 0.02;
    return map{
        format: "pblang.llm.selection_score.v1",
        mode: "validation-loss-plus-regression-quality",
        score: score,
        valid_loss: valid_loss,
        regression_pass_rate: pass_rate,
        regression_average_score: average_score,
        regression_failed: failed,
        weights: map{ pass_rate: -0.20, average_score: -0.10, failed: 0.02 }
    };
}

fn benchmark_generate(model, generate_fn, seed_ids, n, iterations) {
    let start = now_ms();
    let last = [];
    let i = 0;
    while i < iterations {
        last = generate_fn(model, seed_ids, n);
        i = i + 1;
    }
    let elapsed = now_ms() - start;
    let tokens = n * iterations;
    let tps = 0.0;
    if elapsed > 0 { tps = tokens / (elapsed / 1000.0); }
    return map{
        format: "pblang.llm.benchmark.generate.v1",
        iterations: iterations,
        tokens: tokens,
        elapsed_ms: elapsed,
        tokens_per_sec: tps,
        last: last
    };
}

// ── Pure, model-free metrics ────────────────────────────────────────────────────

fn _in_top_k(logits, target, k) {
    let tv = logits[target];
    let greater = 0;
    let i = 0;
    while i < len(logits) { if logits[i] > tv { greater = greater + 1; } i = i + 1; }
    return greater < k;
}

// top_k_accuracy(logits_list, targets, k) — fraction where the target index is
// among the k highest-scoring classes.
fn top_k_accuracy(logits_list, targets, k) {
    let n = len(logits_list);
    if n == 0 { return 0; }
    let c = 0;
    let i = 0;
    while i < n { if _in_top_k(logits_list[i], targets[i], k) { c = c + 1; } i = i + 1; }
    return c / n;
}

// exact_match(a, b) — true if two strings are identical (generation eval).
fn exact_match(a, b) { return a == b; }

fn _char_counts(s) {
    let m = map{};
    let i = 0;
    while i < len(s) {
        let c = str_slice(s, i, i + 1);
        if map_has(m, c) { m[c] = m[c] + 1; } else { m[c] = 1; }
        i = i + 1;
    }
    return m;
}

// char_overlap_f1(pred, ref) — character-level F1 (multiset overlap). 1.0 when
// both are empty, 0.0 when exactly one is empty.
fn char_overlap_f1(pred, ref) {
    if len(pred) == 0 and len(ref) == 0 { return 1; }
    if len(pred) == 0 or len(ref) == 0 { return 0; }
    let pc = _char_counts(pred);
    let rc = _char_counts(ref);
    let overlap = 0;
    let ks = map_keys(pc);
    let i = 0;
    while i < len(ks) {
        let c = ks[i];
        if map_has(rc, c) { let a = pc[c]; let bb = rc[c]; if bb < a { a = bb; } overlap = overlap + a; }
        i = i + 1;
    }
    let prec = overlap / len(pred);
    let rec = overlap / len(ref);
    if prec + rec == 0 { return 0; }
    return 2 * prec * rec / (prec + rec);
}

export evaluate, sequence_evaluate, regression_prompt, max_repetition_run, text_shape, generation_quality, choose_generation, teacher_record_quality, teacher_dataset_quality, objective_component, objective_distance, reinforcement_from_objective, trial_candidate, select_trial_elites, regression_proxy, selection_score, benchmark_generate;
export top_k_accuracy, exact_match, char_overlap_f1;
