// Effect-free Lazarus text LFM preview. Shares grammar, not Delphi identity.
let TextForms = import("stdlib:ui_form_delphi_dfm.sapp");

fn import_text(source, logical_name = "form.lfm") {
    return TextForms.import_lfm_text(source, logical_name);
}

fn sniff_text(source) { return TextForms.sniff_lfm_text(source); }

fn status() {
    return map{ok:true,format:"pblang.lazarus-lfm-import.status.v1",adapter:"lazarus-lfm",
        evidence:"preview",text_only:true,binary_supported:false,
        max_source_bytes:TextForms.MAX_SOURCE_BYTES,max_source_chars:TextForms.MAX_SOURCE_CHARS,
        max_lines:TextForms.MAX_LINES,max_objects:TextForms.MAX_OBJECTS,max_depth:TextForms.MAX_DEPTH,
        canonical_model:"pblang.ui-document.v1",filesystem:false,network:false,process:false,
        ffi:false,effects:false,embedded_code:false,handlers_executed:false,
        root_class_verified:false,source_semantics_preserved:false,production_ready:false};
}

export import_text, sniff_text, status;
