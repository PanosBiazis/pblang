// Bounded, one-variable observation review. No I/O, raw rows or subject IDs in output.
let Units=import("stdlib:units.sapp");
let Series=import("stdlib:sample_series.sapp");
let MAX_ROWS=256; let MAX_SUBJECTS=64;
fn _shape(value,fields) {
    if type(value)!="map" or len(value)!=len(fields) { throw "research: invalid record shape"; }
    for _field in fields { if not map_has(value,_field) { throw "research: invalid record shape"; } }
}
fn _number(value,minimum,maximum) {
    if type(value)!="number" or not (value>=minimum and value<=maximum) {
        throw "research: number outside finite bounds";
    }
}
fn manifest(spec) {
    _shape(spec,["value_unit","summary_unit","value_mode","time_unit","timebase"]);
    if spec.timebase!="relative" { throw "research: explicit relative timebase required"; }
    // Validate unit pairs and mode even for empty or entirely missing observations.
    Units.convert_many([],spec.value_unit,spec.summary_unit,spec.value_mode);
    if Units.describe_unit(spec.time_unit).category!="time" { throw "research: expected time unit"; }
    return map{format:"pblang.research-method.v1",method:"observed-row-summary-v1",
        value_unit:spec.value_unit,summary_unit:spec.summary_unit,value_mode:spec.value_mode,
        category:Units.describe_unit(spec.summary_unit).category,
        time_unit:spec.time_unit,normalized_time_unit:"s",timebase:"relative",
        missing_value:"nil",missing_policy:"exclude from value statistics; retain in row counts",
        weighting:"per-observed-row",order:"strictly increasing per subject after time conversion",
        subject_policy:"caller-assigned numeric slots 1..64; not identity verification",
        max_rows:MAX_ROWS,max_subjects:MAX_SUBJECTS,value_bound:1000000000,
        input_time_bound:1000000000,normalized_time_bound:1000000000000,
        unit_conversion:"units.convert_checked",mean_kernel:"sample_series.moving_mean/full-window",
        data_fingerprint_included:false,runtime_pin_verified:false,
        reproducibility_verified:false,scientific_validity_verified:false};
}
fn summarize(spec,rows) {
    let method=manifest(spec);
    if type(rows)!="array" or len(rows)>MAX_ROWS { throw "research: row limit or type"; }
    let last=map{};let values=[];let missing=0;let first_time=0;let last_time=0;let has_time=false;
    let minimum=nil;let maximum=nil;
    for row in rows {
        _shape(row,["subject","time","value"]);
        _number(row.subject,1,MAX_SUBJECTS);
        if row.subject!=num_floor(row.subject) { throw "research: subject slot must be integral"; }
        _number(row.time,0,1000000000);
        let time=Units.convert_checked(row.time,spec.time_unit,"s");
        _number(time,0,1000000000000);
        let key=str(row.subject);
        if map_has(last,key) and time<=last[key] { throw "research: subject times must increase"; }
        last[key]=time;
        if not has_time or time<first_time {first_time=time;}
        if not has_time or time>last_time {last_time=time;}
        has_time=true;
        if row.value==nil {missing=missing+1;}
        else {
            _number(row.value,-1000000000,1000000000);
            let value=Units.convert_checked(row.value,spec.value_unit,spec.summary_unit,spec.value_mode);
            _number(value,-1000000000,1000000000);array_push(values,value);
            if minimum==nil or value<minimum {minimum=value;}
            if maximum==nil or value>maximum {maximum=value;}
        }
    }
    let mean=if len(values)==0 {nil} else {Series.moving_mean(values,len(values)).values[0]};
    let fraction=if len(rows)==0 {nil} else {missing/len(rows)};
    let span=if len(rows)==0 {nil} else {last_time-first_time};
    return map{format:"pblang.research-observation-summary.v1",method:method,
        row_count:len(rows),subject_count:len(last),observed_count:len(values),missing_count:missing,
        missing_fraction:fraction,minimum:minimum,maximum:maximum,mean:mean,time_span_seconds:span,
        contains_rows:false,contains_subject_ids:false,contains_measurement_statistics:true,
        subject_identity_verified:false,missingness_mechanism_inferred:false,
        independence_verified:false,scientific_validity_verified:false,
        acquisition_performed:false,safe_to_log:false};
}
export MAX_ROWS,MAX_SUBJECTS,manifest,summarize;
