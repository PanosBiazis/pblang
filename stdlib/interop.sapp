// stdlib/interop.sapp — Language Interoperability Utilities for pblang
//
// High-level utilities for cross-language calls, data pipelining,
// serialization format conversion, and performance benchmarking.
//
// Usage:
//   let ip = import("stdlib:interop.sapp");
//   ip.call("python", "print('hello')", []);
//   ip.pipe("python", py_code, "javascript", js_code, data);
//   ip.benchmark_compare("python", code, args, 100);

// ── Imports ───────────────────────────────────────────────────────────────────

fn _get_registry() {
    return try import("stdlib:polyglot_registry.sapp") catch nil;
}

// ── Unified Cross-Language Call ───────────────────────────────────────────────

// call(lang, code_or_fn, args) — unified call to any language
// If args is empty/nil, runs code; otherwise wraps code as a function call
fn call(lang, code_or_fn, args) {
    let reg = _get_registry();
    if reg == nil { return map{ error: "registry not available" }; }

    if reg.is_available(lang) == false {
        return map{ error: lang + " not installed" };
    }

    // If we have args, wrap the code as a callable block
    let final_code = code_or_fn;
    if args != nil and len(args) > 0 {
        let arg_str = _serialize_args(lang, args);
        final_code = _wrap_function_call(lang, code_or_fn, arg_str);
    }

    return reg.run(lang, final_code);
}

// ── Data Pipeline ─────────────────────────────────────────────────────────────

// pipe(lang_a, code_a, lang_b, code_b, data) — pipe data through two languages
fn pipe(lang_a, code_a, lang_b, code_b, data) {
    let reg = _get_registry();
    if reg == nil { return map{ error: "registry not available" }; }

    // Step 1: Run language A with initial data
    let data_str = _serialize_to_json(data);
    let result_a = reg.json_bridge(lang_a, code_a, data_str);
    if result_a.ok == false {
        return map{ error: "pipe stage A failed: " + result_a.error_output, stage: "A" };
    }

    // Step 2: Pass result to language B
    let result_b = reg.json_bridge(lang_b, code_b, result_a.output);
    if result_b.ok == false {
        return map{ error: "pipe stage B failed: " + result_b.error_output, stage: "B" };
    }

    return map{
        ok: true,
        output_a: result_a.output,
        output_b: result_b.output,
        language_a: lang_a,
        language_b: lang_b,
    };
}

// ── Performance Benchmark ─────────────────────────────────────────────────────

// benchmark_compare(lang, code, args, iterations) — compare pblang vs other lang performance
fn benchmark_compare(lang, code, args, iterations) {
    let reg = _get_registry();
    if reg == nil { return map{ error: "registry not available" }; }

    if iterations <= 0 { iterations = 1; }

    // Benchmark the foreign language
    let lang_total_ns = 0;
    let lang_successes = 0;
    for i iterations {
        let start = _now_ns();
        let result = reg.run(lang, code);
        let elapsed = _now_ns() - start;
        if result.ok {
            lang_total_ns = lang_total_ns + elapsed;
            lang_successes = lang_successes + 1;
        }
    }

    let lang_avg_ns = 0;
    if lang_successes > 0 {
        lang_avg_ns = lang_total_ns / lang_successes;
    }

    // We can't easily run pblang native code from here,
    // but we can report the benchmark of the foreign language
    return map{
        ok: true,
        language: lang,
        iterations: iterations,
        successes: lang_successes,
        total_ns: lang_total_ns,
        average_ns: lang_avg_ns,
        average_ms: lang_avg_ns / 1000000.0,
        note: "Foreign language performance measurement",
    };
}

// ── Serialization Utilities ───────────────────────────────────────────────────

// serialize_to(lang, value) — serialize pblang value to language-native format
fn serialize_to(lang, value) {
    if lang == "python" or lang == "javascript" or lang == "typescript" or lang == "ruby" {
        return _serialize_to_json(value);
    }
    if lang == "php" {
        return _serialize_to_php(value);
    }
    if lang == "lua" {
        return _serialize_to_lua(value);
    }
    if lang == "r" {
        return _serialize_to_r(value);
    }
    // Default: JSON
    return _serialize_to_json(value);
}

// parse_from(lang, text) — parse language-native format to pblang
fn parse_from(lang, text) {
    // Most languages support JSON parsing natively
    // In pblang we can delegate to their runtime via the registry
    let reg = _get_registry();
    if reg == nil { return map{ error: "registry not available" }; }

    if lang == "python" {
        let code = "import json\nprint(json.dumps(" + text + "))\n";
        let result = reg.run("python", code);
        return map{ ok: result.ok, parsed: result.stdout };
    }
    if lang == "javascript" {
        let code = "console.log(JSON.stringify(" + text + "));\n";
        let result = reg.run("javascript", code);
        return map{ ok: result.ok, parsed: result.stdout };
    }

    // Default: return as-is
    return map{ ok: true, parsed: text, language: lang };
}

// ── Cross-Language Call ──────────────────────────────────────────────────────

// cross_call(lang_source, source_code, lang_target, target_fn, args) — call from one lang to another
fn cross_call(lang_source, source_code, lang_target, target_fn, args) {
    let reg = _get_registry();
    if reg == nil { return map{ error: "registry not available" }; }

    // Build bridge code based on the target language
    let bridge_code = _build_cross_bridge(lang_source, lang_target, target_fn, args);
    let result = reg.run(lang_source, source_code + "\n" + bridge_code);

    return result;
}

// ── Internal Helpers ─────────────────────────────────────────────────────────

fn _serialize_args(lang, args) {
    // Serialize to JSON for most languages
    let json_parts = [];
    for i len(args) {
        array_push(json_parts, _serialize_to_json(args[i]));
    }
    return "[" + str_join(json_parts, ", ") + "]";
}

fn _wrap_function_call(lang, code, arg_str) {
    if lang == "python" {
        return code + "\n\n__result__ = main(" + arg_str + ")";
    }
    if lang == "javascript" {
        return code + "\n\nconst __result__ = main(" + arg_str + ");";
    }
    if lang == "ruby" {
        return code + "\n\n__result__ = main(" + arg_str + ")";
    }
    return code;
}

fn _serialize_to_json(value) {
    if type(value) == "string" { return "\"" + str(value) + "\""; }
    if type(value) == "number" { return str(value); }
    if type(value) == "bool" {
        if value { return "true"; }
        return "false";
    }
    if type(value) == "array" {
        let parts = [];
        for i len(value) {
            array_push(parts, _serialize_to_json(value[i]));
        }
        return "[" + str_join(parts, ", ") + "]";
    }
    if type(value) == "map" {
        let parts = [];
        let keys = map_keys(value);
        for i len(keys) {
            let k = keys[i];
            array_push(parts, "\"" + k + "\": " + _serialize_to_json(value[k]));
        }
        return "{" + str_join(parts, ", ") + "}";
    }
    return str(value);
}

fn _serialize_to_php(value) {
    // PHP uses serialize() format — we approximate with JSON
    if type(value) == "array" {
        let parts = [];
        for i len(value) {
            array_push(parts, _serialize_to_json(value[i]));
        }
        return "[" + str_join(parts, ", ") + "]";
    }
    return _serialize_to_json(value);
}

fn _serialize_to_lua(value) {
    if type(value) == "map" {
        let parts = [];
        let keys = map_keys(value);
        for i len(keys) {
            let k = keys[i];
            array_push(parts, "[\"" + k + "\"] = " + _serialize_to_json(value[k]));
        }
        return "{" + str_join(parts, ", ") + "}";
    }
    return _serialize_to_json(value);
}

fn _serialize_to_r(value) {
    if type(value) == "array" {
        let parts = [];
        for i len(value) {
            array_push(parts, _serialize_to_json(value[i]));
        }
        return "c(" + str_join(parts, ", ") + ")";
    }
    return _serialize_to_json(value);
}

fn _build_cross_bridge(lang_source, lang_target, target_fn, args) {
    let arg_str = _serialize_args(lang_source, args);

    if lang_target == "python" {
        if lang_source == "python" {
            return "\n__result__ = " + target_fn + "(" + arg_str + ")";
        }
        return "\n# Cross-call to Python not supported inline";
    }

    if lang_target == "javascript" {
        if lang_source == "javascript" {
            return "\nconst __result__ = " + target_fn + "(" + arg_str + ");";
        }
        return "\n// Cross-call to JS not supported inline";
    }

    // Generic: just invoke target as a call
    return "\n__result__ = " + target_fn + "(" + arg_str + ")";
}

fn _now_ns() {
    // Approximate nanoseconds using platform time
    return clock() * 1000000000.0;
}

// formats() — languages with a dedicated serializer (others fall back to JSON).
fn formats() { return ["json", "php", "lua", "r"]; }

// to_json(value) — serialize a pblang value to a JSON string (interop default).
fn to_json(value) { return serialize_to("json", value); }

export call, pipe, benchmark_compare;
export serialize_to, parse_from;
export cross_call;
export formats, to_json;
