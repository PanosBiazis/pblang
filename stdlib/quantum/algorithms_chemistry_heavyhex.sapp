// stdlib/quantum/algorithms_chemistry_heavyhex.sapp — Canonical Quantum Algorithms
// (QFT, QPE, Shor Factoring, QAOA MaxCut, 2x2 HHL Linear Solver), Molecular Quantum
// Chemistry (STO-3G H2 Parity/BK VQE + Exact Parameter-Shift Gradients), and 156-Qubit
// IBM Heron r2 Heavy-Hex Calibration-Aware Router & EstimatorV2 Client (v3.0.0).

let QC = try import("stdlib:quantum_computing.sapp") catch import("../quantum_computing.sapp");

let _PI = 3.14159265358979323846;
let _TWO_PI = 6.28318530717958647692;
let _HALF_PI = 1.57079632679489661923;
let _QUARTER_PI = 0.78539816339744830962;
let _BOHR_ANGSTROM = 0.529177210903;

// ── Numeric & Bitwise Helpers ────────────────────────────────────────────────

fn _reduce_angle(x) {
    let k = num_floor((x + _PI) / _TWO_PI);
    let r = x - k * _TWO_PI;
    if r > _PI { r = r - _TWO_PI; }
    if r <= 0.0 - _PI { r = r + _TWO_PI; }
    return r;
}

fn _sin(x) {
    let r = _reduce_angle(x);
    let r2 = r * r;
    let term = r;
    let acc = r;
    let i = 1;
    while i <= 14 {
        term = (0.0 - term) * r2 / ((2 * i) * (2 * i + 1));
        acc = acc + term;
        i = i + 1;
    }
    return acc;
}

fn _cos(x) {
    let r = _reduce_angle(x);
    let r2 = r * r;
    let term = 1.0;
    let acc = 1.0;
    let i = 1;
    while i <= 14 {
        term = (0.0 - term) * r2 / ((2 * i - 1) * (2 * i));
        acc = acc + term;
        i = i + 1;
    }
    return acc;
}

fn _asin(x) {
    let clamped = num_max(0.0 - 1.0, num_min(1.0, x));
    return num_atan2(clamped, num_sqrt(num_max(0.0, 1.0 - clamped * clamped)));
}

fn _bitstring(idx, n_bits) {
    let s = "";
    let b = 0;
    while b < n_bits {
        let mask = bit_shl(1, n_bits - 1 - b);
        if bit_and(idx, mask) != 0 {
            s = s + "1";
        } else {
            s = s + "0";
        }
        b = b + 1;
    }
    return s;
}

fn _gcd(a, b) {
    let x = num_floor(num_abs(a));
    let y = num_floor(num_abs(b));
    while y != 0 {
        let rem = num_mod(x, y);
        x = y;
        y = rem;
    }
    return x;
}

fn _mod_pow(base_val, exp_val, mod_n) {
    if mod_n <= 1 { return 0; }
    let res = 1;
    let b = num_mod(num_floor(base_val), mod_n);
    let e = num_floor(exp_val);
    while e > 0 {
        if bit_and(e, 1) != 0 {
            res = num_mod(res * b, mod_n);
        }
        b = num_mod(b * b, mod_n);
        e = bit_shr(e, 1);
    }
    return res;
}

fn _clone_vec(v) {
    let out = [];
    let i = 0;
    while i < len(v) {
        push(out, v[i] * 1.0);
        i = i + 1;
    }
    return out;
}

fn _state_fidelity(sv_a, sv_b) {
    let dot_re = 0.0;
    let dot_im = 0.0;
    let i = 0;
    while i < len(sv_a) {
        let ar = sv_a[i][0];
        let ai = sv_a[i][1];
        let br = sv_b[i][0];
        let bi = sv_b[i][1];
        dot_re = dot_re + (ar * br + ai * bi);
        dot_im = dot_im + (ar * bi - ai * br);
        i = i + 1;
    }
    return dot_re * dot_re + dot_im * dot_im;
}

// Exact Controlled-Phase CP(theta) = diag(1, 1, 1, exp(i * theta)) up to global phase exp(-i * theta / 4)
fn cp(qc, ctrl, tgt, theta) {
    let half = theta * 0.5;
    QC.rz(qc, ctrl, half);
    QC.rz(qc, tgt, half);
    QC.cnot(qc, ctrl, tgt);
    QC.rz(qc, tgt, 0.0 - half);
    QC.cnot(qc, ctrl, tgt);
    return qc;
}

// ── 1A. Exact Quantum Fourier Transform (QFT & Inverse QFT) ──────────────────

fn apply_qft(qc, qubits, inverse = false) {
    let m = len(qubits);
    if m == 0 {
        return qc;
    }
    if not inverse {
        let j = 0;
        while j < m {
            let qj = qubits[j];
            QC.h(qc, qj);
            let d = 1;
            while j + d < m {
                let qctrl = qubits[j + d];
                let angle = _TWO_PI / (1.0 * bit_shl(1, d + 1));
                cp(qc, qctrl, qj, angle);
                d = d + 1;
            }
            j = j + 1;
        }
        let s_idx = 0;
        let half_m = num_floor(m / 2);
        while s_idx < half_m {
            QC.swap(qc, qubits[s_idx], qubits[m - 1 - s_idx]);
            s_idx = s_idx + 1;
        }
    } else {
        let s_idx = 0;
        let half_m = num_floor(m / 2);
        while s_idx < half_m {
            QC.swap(qc, qubits[s_idx], qubits[m - 1 - s_idx]);
            s_idx = s_idx + 1;
        }
        let j = m - 1;
        while j >= 0 {
            let qj = qubits[j];
            let d = m - 1 - j;
            while d >= 1 {
                let qctrl = qubits[j + d];
                let angle = (0.0 - _TWO_PI) / (1.0 * bit_shl(1, d + 1));
                cp(qc, qctrl, qj, angle);
                d = d - 1;
            }
            QC.h(qc, qj);
            j = j - 1;
        }
    }
    return qc;
}

fn qft_circuit(n_qubits, inverse = false) {
    if n_qubits < 1 or n_qubits > 20 {
        throw "qft_circuit: n_qubits must be in 1..20";
    }
    let qc = QC.new_circuit(n_qubits);
    let qs = [];
    let q = 0;
    while q < n_qubits {
        push(qs, q);
        q = q + 1;
    }
    apply_qft(qc, qs, inverse);
    return qc;
}

// ── 1B. Quantum Phase Estimation (QPE) ───────────────────────────────────────

fn quantum_phase_estimation(eigenphase_turns, n_counting_qubits = 4) {
    if n_counting_qubits < 1 or n_counting_qubits > 16 {
        throw "quantum_phase_estimation: n_counting_qubits must be in 1..16";
    }
    let total_q = n_counting_qubits + 1;
    let qc = QC.new_circuit(total_q);
    let eig_q = n_counting_qubits;

    // Prepare eigenstate |1> on target register
    QC.x(qc, eig_q);

    // Hadamard superposition on counting register 0 .. n_counting_qubits - 1
    let counting_qs = [];
    let q = 0;
    while q < n_counting_qubits {
        QC.h(qc, q);
        push(counting_qs, q);
        q = q + 1;
    }

    // Controlled-U^(2^k) powers: qubit q represents bit weight 2^(n_counting_qubits - 1 - q)
    q = 0;
    while q < n_counting_qubits {
        let power_k = n_counting_qubits - 1 - q;
        let angle = _TWO_PI * eigenphase_turns * (1.0 * bit_shl(1, power_k));
        cp(qc, q, eig_q, angle);
        q = q + 1;
    }

    // Inverse QFT on counting register
    apply_qft(qc, counting_qs, true);

    // Statevector readout & marginalize over counting register
    let sv = QC.run_statevector(qc).amplitudes;
    let dim_c = bit_shl(1, n_counting_qubits);
    let counting_probs = map{};
    let counting_vec = [];
    let best_idx = 0;
    let best_prob = -1.0;

    let c_idx = 0;
    while c_idx < dim_c {
        let idx0 = bit_shl(c_idx, 1);
        let idx1 = idx0 + 1;
        let p0 = sv[idx0][0] * sv[idx0][0] + sv[idx0][1] * sv[idx0][1];
        let p1 = sv[idx1][0] * sv[idx1][0] + sv[idx1][1] * sv[idx1][1];
        let p_tot = p0 + p1;
        let bstr = _bitstring(c_idx, n_counting_qubits);
        counting_probs[bstr] = p_tot;
        push(counting_vec, p_tot);
        if p_tot > best_prob {
            best_prob = p_tot;
            best_idx = c_idx;
        }
        c_idx = c_idx + 1;
    }

    let true_phi = eigenphase_turns - num_floor(eigenphase_turns);
    let est_phi = (1.0 * best_idx) / (1.0 * dim_c);
    let raw_diff = num_abs(est_phi - true_phi);
    let circ_err = num_min(raw_diff, 1.0 - raw_diff);

    return map{
        ok: circ_err <= (1.0 / (1.0 * dim_c)) + 0.000000001,
        n_counting_qubits: n_counting_qubits,
        total_qubits: total_q,
        true_phase: true_phi,
        estimated_phase: est_phi,
        phase_error: circ_err,
        best_index: best_idx,
        best_bitstring: _bitstring(best_idx, n_counting_qubits),
        peak_probability: best_prob,
        counting_probabilities: counting_probs,
        counting_vector: counting_vec,
        circuit: qc
    };
}

// ── 1C. Shor's Prime Factoring Algorithm (Quantum Order-Finding + Continued Fractions) ─

fn _continued_fraction_convergents(num_s, den_q, max_denom) {
    let convergents = [];
    if num_s <= 0 or den_q <= 0 {
        return convergents;
    }
    let a = num_floor(num_s);
    let b = num_floor(den_q);
    let p_prev2 = 0;
    let p_prev1 = 1;
    let q_prev2 = 1;
    let q_prev1 = 0;

    let steps = 0;
    while b != 0 and steps < 64 {
        let quot = num_floor(a / b);
        let rem = num_mod(a, b);
        let p_cur = quot * p_prev1 + p_prev2;
        let q_cur = quot * q_prev1 + q_prev2;
        if q_cur > max_denom {
            break;
        }
        if q_cur > 0 {
            push(convergents, [p_cur, q_cur]);
        }
        p_prev2 = p_prev1;
        p_prev1 = p_cur;
        q_prev2 = q_prev1;
        q_prev1 = q_cur;
        a = b;
        b = rem;
        steps = steps + 1;
    }
    return convergents;
}

// Reversible gate-level controlled transposition |1>_ctrl |u>_w <-> |1>_ctrl |v>_w
fn _emit_controlled_transposition(qc, ctrl_q, work_qs, u_val, v_val) {
    if u_val == v_val {
        return nil;
    }
    let nw = len(work_qs);
    let diff = bit_xor(u_val, v_val);

    // Find pivot bit position p_idx (0..nw-1) where u_val and v_val differ
    let p_idx = 0;
    let b = 0;
    while b < nw {
        let mask = bit_shl(1, nw - 1 - b);
        if bit_and(diff, mask) != 0 {
            p_idx = b;
            break;
        }
        b = b + 1;
    }

    let p_mask = bit_shl(1, nw - 1 - p_idx);
    // Ensure low_val has bit p_idx == 0 and high_val has bit p_idx == 1
    let low_val = if bit_and(u_val, p_mask) == 0 { u_val } else { v_val };
    let pivot_q = work_qs[p_idx];

    // 1. CNOT from pivot_q to every other differing bit position
    let cnot_targets = [];
    b = 0;
    while b < nw {
        if b != p_idx {
            let mask = bit_shl(1, nw - 1 - b);
            if bit_and(diff, mask) != 0 {
                push(cnot_targets, work_qs[b]);
                QC.cnot(qc, pivot_q, work_qs[b]);
            }
        }
        b = b + 1;
    }

    // 2. X on non-pivot bits where low_val has 0 so active pair becomes |1..1 0_p 1..1> <-> |1..1 1_p 1..1>
    let zero_x_qs = [];
    let mcx_ctrls = [ctrl_q];
    b = 0;
    while b < nw {
        if b != p_idx {
            let mask = bit_shl(1, nw - 1 - b);
            if bit_and(low_val, mask) == 0 {
                push(zero_x_qs, work_qs[b]);
                QC.x(qc, work_qs[b]);
            }
            push(mcx_ctrls, work_qs[b]);
        }
        b = b + 1;
    }

    // 3. Exact Multi-Controlled-X = H * MCZ * H on pivot_q
    QC.h(qc, pivot_q);
    QC.mcz(qc, mcx_ctrls, pivot_q);
    QC.h(qc, pivot_q);

    // 4. Uncompute X and CNOT conjugations in reverse order
    let zx = len(zero_x_qs) - 1;
    while zx >= 0 {
        QC.x(qc, zero_x_qs[zx]);
        zx = zx - 1;
    }
    let cx_i = len(cnot_targets) - 1;
    while cx_i >= 0 {
        QC.cnot(qc, pivot_q, cnot_targets[cx_i]);
        cx_i = cx_i - 1;
    }
    return nil;
}

// Controlled modular multiplication |c>|y> -> |c>|(mult^c * y) mod mod_n>
// Constructed purely from mult = a^(2^j) mod N (without knowing order r!)
fn _emit_controlled_mod_mul(qc, ctrl_q, work_qs, mult_val, mod_n) {
    let m = num_mod(mult_val, mod_n);
    if m == 1 or _gcd(m, mod_n) != 1 {
        return nil;
    }
    let visited = map{};
    let y = 1;
    while y < mod_n {
        let y_key = str(y);
        if not map_has(visited, y_key) {
            let cycle = [];
            let cur = y;
            while not map_has(visited, str(cur)) {
                visited[str(cur)] = true;
                push(cycle, cur);
                cur = num_mod(cur * m, mod_n);
            }
            if len(cycle) > 1 {
                // Apply (c_{L-2} <-> c_{L-1}), ..., (c_0 <-> c_1) so c_0 -> c_1 -> ... -> c_{L-1} -> c_0
                let k = len(cycle) - 1;
                while k >= 1 {
                    _emit_controlled_transposition(qc, ctrl_q, work_qs, cycle[k - 1], cycle[k]);
                    k = k - 1;
                }
            }
        }
        y = y + 1;
    }
    return nil;
}

fn _quantum_order_finding(base_a, mod_n) {
    // Work register width nw = ceil(log2(mod_n))
    let nw = 1;
    while bit_shl(1, nw) < mod_n {
        nw = nw + 1;
    }
    // Phase register width t chosen so 2^t gives sharp continued-fraction convergents
    // while keeping total_qubits = t + nw <= 13 for fast exact statevector simulation
    let t_qubits = if mod_n <= 24 {
        6
    } else {
        num_min(7, 20 - nw)
    };
    let total_q = t_qubits + nw;
    let qc = QC.new_circuit(total_q);

    let phase_qs = [];
    let q = 0;
    while q < t_qubits {
        QC.h(qc, q);
        push(phase_qs, q);
        q = q + 1;
    }

    let work_qs = [];
    let w = 0;
    while w < nw {
        push(work_qs, t_qubits + w);
        w = w + 1;
    }
    // Initialize work register to |0...01> = |1>
    QC.x(qc, work_qs[nw - 1]);

    // Entangle |x> with |a^x mod N> via repeated-squaring controlled modular multipliers
    let mult_pow = num_mod(base_a, mod_n);
    let bit_j = 0;
    while bit_j < t_qubits {
        let ctrl_q = t_qubits - 1 - bit_j;
        _emit_controlled_mod_mul(qc, ctrl_q, work_qs, mult_pow, mod_n);
        mult_pow = num_mod(mult_pow * mult_pow, mod_n);
        bit_j = bit_j + 1;
    }

    // Apply Inverse QFT to phase register
    apply_qft(qc, phase_qs, true);

    // Exact statevector simulation + marginal distribution on phase register
    let sv = QC.run_statevector(qc).amplitudes;
    let dim_t = bit_shl(1, t_qubits);
    let dim_w = bit_shl(1, nw);
    let phase_probs = [];
    let s_idx = 0;
    while s_idx < dim_t {
        let base_offset = s_idx * dim_w;
        let p_sum = 0.0;
        let w_idx = 0;
        while w_idx < dim_w {
            let amp = sv[base_offset + w_idx];
            p_sum = p_sum + amp[0] * amp[0] + amp[1] * amp[1];
            w_idx = w_idx + 1;
        }
        push(phase_probs, p_sum);
        s_idx = s_idx + 1;
    }

    // Rank top phase peaks (s > 0) by probability descending
    let top_peaks = [];
    let k = 0;
    while k < 12 and k < dim_t - 1 {
        let best_s = -1;
        let best_p = -1.0;
        let s = 1;
        while s < dim_t {
            let already = false;
            let m = 0;
            while m < len(top_peaks) {
                if top_peaks[m].s == s {
                    already = true;
                    break;
                }
                m = m + 1;
            }
            if (not already) and phase_probs[s] > best_p {
                best_p = phase_probs[s];
                best_s = s;
            }
            s = s + 1;
        }
        if best_s > 0 and best_p > 0.001 {
            push(top_peaks, map{
                s: best_s,
                bitstring: _bitstring(best_s, t_qubits),
                probability: best_p
            });
        }
        k = k + 1;
    }

    // Extract candidate order r via continued-fraction convergents of s / 2^t
    let found_r = 0;
    let winning_peak = nil;
    let winning_convergent = nil;
    let pk_i = 0;
    while pk_i < len(top_peaks) and found_r == 0 {
        let pk = top_peaks[pk_i];
        let convs = _continued_fraction_convergents(pk.s, dim_t, mod_n);
        let ci = 0;
        while ci < len(convs) and found_r == 0 {
            let q_denom = convs[ci][1];
            let mult_k = 1;
            while mult_k <= 4 and q_denom * mult_k < mod_n {
                let r_cand = q_denom * mult_k;
                if r_cand > 0 and _mod_pow(base_a, r_cand, mod_n) == 1 {
                    found_r = r_cand;
                    winning_peak = pk;
                    winning_convergent = convs[ci];
                    break;
                }
                mult_k = mult_k + 1;
            }
            ci = ci + 1;
        }
        pk_i = pk_i + 1;
    }

    return map{
        ok: found_r > 0,
        base_a: base_a,
        mod_n: mod_n,
        order_r: found_r,
        t_counting_qubits: t_qubits,
        n_work_qubits: nw,
        total_qubits: total_q,
        winning_peak: winning_peak,
        winning_convergent: winning_convergent,
        top_peaks: top_peaks,
        phase_probabilities: phase_probs,
        circuit: qc
    };
}

fn shor_factor(N, seed = 42) {
    let n_int = num_floor(N);
    if n_int < 4 {
        throw "shor_factor: N must be a composite integer >= 4";
    }
    if num_mod(n_int, 2) == 0 {
        let other = num_floor(n_int / 2);
        let f_lo = if 2 <= other { 2 } else { other };
        let f_hi = if 2 <= other { other } else { 2 };
        return map{
            ok: true,
            N: n_int,
            factors: [f_lo, f_hi],
            method: "even_parity",
            quantum_order_finding_used: false
        };
    }

    // Gather coprime bases a in [2 .. N-2] so composite odd numbers genuinely execute
    // quantum order-finding + QFT + continued-fraction extraction!
    let coprime_bases = [];
    let cand_a = 2;
    while cand_a <= n_int - 2 {
        if _gcd(cand_a, n_int) == 1 {
            push(coprime_bases, cand_a);
        }
        cand_a = cand_a + 1;
    }

    let n_cop = len(coprime_bases);
    let start_offset = if n_cop > 0 { num_mod(num_floor(num_abs(seed)), n_cop) } else { 0 };
    let attempts = [];

    let idx = 0;
    while idx < n_cop {
        let a_val = coprime_bases[num_mod(start_offset + idx, n_cop)];
        let qof = _quantum_order_finding(a_val, n_int);
        push(attempts, map{
            base_a: a_val,
            order_r: qof.order_r,
            winning_peak: qof.winning_peak
        });
        if qof.ok and qof.order_r > 0 and num_mod(qof.order_r, 2) == 0 {
            let half_r = num_floor(qof.order_r / 2);
            let x_half = _mod_pow(a_val, half_r, n_int);
            if x_half != 1 and x_half != n_int - 1 {
                let g1 = _gcd(x_half - 1, n_int);
                let g2 = _gcd(x_half + 1, n_int);
                let f1 = if g1 > 1 and g1 < n_int { g1 } else { num_floor(n_int / g2) };
                let f2 = num_floor(n_int / f1);
                if f1 > 1 and f2 > 1 and f1 * f2 == n_int {
                    let lo = if f1 <= f2 { f1 } else { f2 };
                    let hi = if f1 <= f2 { f2 } else { f1 };
                    return map{
                        ok: true,
                        N: n_int,
                        factors: [lo, hi],
                        base_a: a_val,
                        order_r: qof.order_r,
                        t_counting_qubits: qof.t_counting_qubits,
                        n_work_qubits: qof.n_work_qubits,
                        total_qubits: qof.total_qubits,
                        winning_peak: qof.winning_peak,
                        winning_convergent: qof.winning_convergent,
                        top_peaks: qof.top_peaks,
                        attempts: attempts,
                        method: "quantum_qft_continued_fractions",
                        quantum_order_finding_used: true,
                        circuit: qof.circuit
                    };
                }
            }
        }
        idx = idx + 1;
    }

    return map{
        ok: false,
        N: n_int,
        factors: [],
        attempts: attempts,
        method: "failed_to_factor",
        quantum_order_finding_used: true
    };
}

// ── 1D. QAOA MaxCut Combinatorial Optimizer ──────────────────────────────────

fn _normalize_weighted_edges(n_nodes, edges) {
    let norm = [];
    let i = 0;
    while i < len(edges) {
        let e = edges[i];
        let u = 0;
        let v = 0;
        let w = 1.0;
        if is_array(e) {
            u = e[0];
            v = e[1];
            if len(e) >= 3 { w = e[2] * 1.0; }
        } else if is_map(e) {
            u = e.u;
            v = e.v;
            if map_has(e, "weight") { w = e.weight * 1.0; }
            else if map_has(e, "w") { w = e.w * 1.0; }
        }
        if u < 0 or u >= n_nodes or v < 0 or v >= n_nodes or u == v {
            throw "qaoa_maxcut: invalid edge endpoints (" + str(u) + ", " + str(v) + ")";
        }
        push(norm, map{ u: u, v: v, w: w });
        i = i + 1;
    }
    return norm;
}

fn _build_qaoa_circuit(n_nodes, norm_edges, gammas, betas) {
    let p_layers = len(gammas);
    let qc = QC.new_circuit(n_nodes);
    let q = 0;
    while q < n_nodes {
        QC.h(qc, q);
        q = q + 1;
    }
    let l_idx = 0;
    while l_idx < p_layers {
        let gamma_val = gammas[l_idx];
        let beta_val = betas[l_idx];
        let ei = 0;
        while ei < len(norm_edges) {
            let ed = norm_edges[ei];
            QC.cnot(qc, ed.u, ed.v);
            QC.rz(qc, ed.v, gamma_val * ed.w);
            QC.cnot(qc, ed.u, ed.v);
            ei = ei + 1;
        }
        q = 0;
        while q < n_nodes {
            QC.rx(qc, q, 2.0 * beta_val);
            q = q + 1;
        }
        l_idx = l_idx + 1;
    }
    return qc;
}

fn qaoa_maxcut(n_nodes, edges, p_layers = 2, opts = nil) {
    if n_nodes < 2 or n_nodes > 14 {
        throw "qaoa_maxcut: n_nodes must be in 2..14";
    }
    if p_layers < 1 {
        throw "qaoa_maxcut: p_layers must be >= 1";
    }
    let norm_edges = _normalize_weighted_edges(n_nodes, edges);
    let dim = bit_shl(1, n_nodes);

    // Precompute exact classical cut value C(z) for all 2^n bitstrings
    let cut_table = [];
    let optimal_cut = 0.0;
    let idx = 0;
    while idx < dim {
        let c_val = 0.0;
        let ei = 0;
        while ei < len(norm_edges) {
            let ed = norm_edges[ei];
            let bu = if bit_and(idx, bit_shl(1, n_nodes - 1 - ed.u)) != 0 { 1 } else { 0 };
            let bv = if bit_and(idx, bit_shl(1, n_nodes - 1 - ed.v)) != 0 { 1 } else { 0 };
            if bu != bv {
                c_val = c_val + ed.w;
            }
            ei = ei + 1;
        }
        push(cut_table, c_val);
        if c_val > optimal_cut {
            optimal_cut = c_val;
        }
        idx = idx + 1;
    }

    let eval_qaoa = fn(param_vec) {
        let gs = [];
        let bs = [];
        let k = 0;
        while k < p_layers {
            push(gs, param_vec[k]);
            push(bs, param_vec[p_layers + k]);
            k = k + 1;
        }
        let qc = _build_qaoa_circuit(n_nodes, norm_edges, gs, bs);
        let sv = QC.run_statevector(qc).amplitudes;
        let exp_cut = 0.0;
        let z = 0;
        while z < dim {
            let prob = sv[z][0] * sv[z][0] + sv[z][1] * sv[z][1];
            exp_cut = exp_cut + prob * cut_table[z];
            z = z + 1;
        }
        return exp_cut;
    };

    // Multi-start seeds covering standard adiabatic QAOA ramps and sign quadrants
    let starts = [];
    let seed_profiles = [
        [0.0 - 0.45, 0.55],
        [0.45, 0.0 - 0.55],
        [0.0 - 0.72, 0.38],
        [0.72, 0.38]
    ];
    let sp_i = 0;
    while sp_i < len(seed_profiles) {
        let prof = seed_profiles[sp_i];
        let pvec = [];
        let k = 0;
        while k < p_layers {
            let frac_g = (k + 1.0) / (p_layers * 1.0);
            push(pvec, prof[0] * (0.65 + 0.55 * frac_g));
            k = k + 1;
        }
        k = 0;
        while k < p_layers {
            let frac_b = (p_layers - k) / (p_layers * 1.0);
            push(pvec, prof[1] * (0.55 + 0.55 * frac_b));
            k = k + 1;
        }
        push(starts, pvec);
        sp_i = sp_i + 1;
    }

    let n_params = 2 * p_layers;
    let global_best_val = -1.0;
    let global_best_vec = starts[0];

    let st_idx = 0;
    while st_idx < len(starts) {
        let cur_vec = _clone_vec(starts[st_idx]);
        let cur_val = eval_qaoa(cur_vec);
        let step_size = 0.28;
        let max_rounds = if is_map(opts) and map_has(opts, "max_rounds") { opts.max_rounds } else { 16 };
        let r_idx = 0;
        while r_idx < max_rounds and step_size >= 0.004 {
            let improved = false;
            let start_round_vec = _clone_vec(cur_vec);
            let d = 0;
            while d < n_params {
                let orig = cur_vec[d];
                cur_vec[d] = orig + step_size;
                let v_plus = eval_qaoa(cur_vec);
                if v_plus > cur_val + 0.0000001 {
                    cur_val = v_plus;
                    improved = true;
                } else {
                    cur_vec[d] = orig - step_size;
                    let v_minus = eval_qaoa(cur_vec);
                    if v_minus > cur_val + 0.0000001 {
                        cur_val = v_minus;
                        improved = true;
                    } else {
                        cur_vec[d] = orig;
                    }
                }
                d = d + 1;
            }
            // Powell conjugate pattern step along net displacement of the coordinate sweep
            if improved {
                let pat_vec = [];
                let k = 0;
                while k < n_params {
                    push(pat_vec, 2.0 * cur_vec[k] - start_round_vec[k]);
                    k = k + 1;
                }
                let v_pat = eval_qaoa(pat_vec);
                if v_pat > cur_val + 0.0000001 {
                    cur_vec = pat_vec;
                    cur_val = v_pat;
                }
            } else {
                step_size = step_size * 0.45;
            }
            r_idx = r_idx + 1;
        }
        if cur_val > global_best_val {
            global_best_val = cur_val;
            global_best_vec = cur_vec;
        }
        st_idx = st_idx + 1;
    }

    let opt_gammas = [];
    let opt_betas = [];
    let k = 0;
    while k < p_layers {
        push(opt_gammas, global_best_vec[k]);
        push(opt_betas, global_best_vec[p_layers + k]);
        k = k + 1;
    }

    let best_qc = _build_qaoa_circuit(n_nodes, norm_edges, opt_gammas, opt_betas);
    let probs = QC.probabilities(best_qc);
    let best_z = 0;
    let best_prob = -1.0;
    idx = 0;
    while idx < dim {
        if probs.vector[idx] > best_prob {
            best_prob = probs.vector[idx];
            best_z = idx;
        }
        idx = idx + 1;
    }

    let approx_ratio = if optimal_cut > 0.0 { global_best_val / optimal_cut } else { 1.0 };

    return map{
        ok: true,
        n_nodes: n_nodes,
        p_layers: p_layers,
        best_cut_bitstring: _bitstring(best_z, n_nodes),
        best_cut_value: cut_table[best_z],
        best_bitstring_probability: best_prob,
        expected_cut_value: global_best_val,
        optimal_cut_value: optimal_cut,
        approximation_ratio: approx_ratio,
        optimal_gammas: opt_gammas,
        optimal_betas: opt_betas,
        probabilities: probs.by_bitstring,
        circuit: best_qc
    };
}

// ── 1E. HHL Quantum Linear System Solver (2x2 Hermitian Positive-Definite) ───

// Exact Multi-Controlled Ry(theta) on target_q conditioned on clock_qs == pattern_val:
// Uses Z * Ry(-theta/2) * Z * Ry(theta/2) = Ry(theta) when MCZ triggers, and I otherwise!
fn _emit_mcry_on_pattern(qc, clock_qs, pattern_val, target_q, theta) {
    if num_abs(theta) < 0.0000000000001 {
        return nil;
    }
    let nc = len(clock_qs);
    let zero_qs = [];
    let b = 0;
    while b < nc {
        let mask = bit_shl(1, nc - 1 - b);
        if bit_and(pattern_val, mask) == 0 {
            push(zero_qs, clock_qs[b]);
            QC.x(qc, clock_qs[b]);
        }
        b = b + 1;
    }
    let half = theta * 0.5;
    QC.ry(qc, target_q, half);
    QC.mcz(qc, clock_qs, target_q);
    QC.ry(qc, target_q, 0.0 - half);
    QC.mcz(qc, clock_qs, target_q);

    let z = len(zero_qs) - 1;
    while z >= 0 {
        QC.x(qc, zero_qs[z]);
        z = z - 1;
    }
    return nil;
}

// Controlled diag(exp(i*phi0), exp(i*phi1)) on (ctrl_q, sys_q) up to pure global phase
fn _emit_controlled_diag_2x2(qc, ctrl_q, sys_q, phi0, phi1) {
    QC.rz(qc, ctrl_q, phi0);
    cp(qc, ctrl_q, sys_q, phi1 - phi0);
    return nil;
}

fn hhl_linear_solver_2x2(A_mat, b_vec) {
    if not is_array(A_mat) or len(A_mat) != 2 or len(A_mat[0]) != 2 or len(A_mat[1]) != 2 {
        throw "hhl_linear_solver_2x2: A_mat must be a 2x2 matrix";
    }
    if not is_array(b_vec) or len(b_vec) != 2 {
        throw "hhl_linear_solver_2x2: b_vec must be a length-2 vector";
    }
    let a00 = A_mat[0][0] * 1.0;
    let a01 = A_mat[0][1] * 1.0;
    let a10 = A_mat[1][0] * 1.0;
    let a11 = A_mat[1][1] * 1.0;
    if num_abs(a01 - a10) > 0.000000001 {
        throw "hhl_linear_solver_2x2: A_mat must be symmetric / Hermitian";
    }

    let b0 = b_vec[0] * 1.0;
    let b1 = b_vec[1] * 1.0;
    let b_norm = num_sqrt(b0 * b0 + b1 * b1);
    if b_norm < 0.000000000001 {
        throw "hhl_linear_solver_2x2: b_vec must be non-zero";
    }

    // Spectral decomposition A = Ry(alpha) * diag(lam0, lam1) * Ry(-alpha)
    let mu = 0.5 * (a00 + a11);
    let half_diff = 0.5 * (a00 - a11);
    let delta = num_sqrt(half_diff * half_diff + a01 * a01);
    let lam0 = mu - delta;
    let lam1 = mu + delta;
    if lam0 <= 0.0 {
        throw "hhl_linear_solver_2x2: A_mat must be strictly positive-definite (min eigenvalue=" + str(lam0) + ")";
    }
    let alpha = if delta < 0.0000000000001 {
        0.0
    } else {
        num_atan2(0.0 - a01, 0.0 - half_diff)
    };

    // Classical exact reference solution x = A^{-1} b
    let det_a = a00 * a11 - a01 * a10;
    let x_cl0 = (a11 * b0 - a01 * b1) / det_a;
    let x_cl1 = (0.0 - a10 * b0 + a00 * b1) / det_a;
    let x_cl_norm = num_sqrt(x_cl0 * x_cl0 + x_cl1 * x_cl1);
    let x_cl_unit = [x_cl0 / x_cl_norm, x_cl1 / x_cl_norm];

    // Qubit layout: q_anc = 0, clock_qs = [1 .. n_clock], q_sys = n_clock + 1
    // Choose n_clock = 7 (total 9 qubits, dim = 512) and evolution time t0 = 2*pi*(96/128)/lam1
    let n_clock = 7;
    let dim_clock = bit_shl(1, n_clock);
    let t0 = _TWO_PI * 0.75 / lam1;
    let q_anc = 0;
    let clock_qs = [];
    let c_i = 0;
    while c_i < n_clock {
        push(clock_qs, 1 + c_i);
        c_i = c_i + 1;
    }
    let q_sys = n_clock + 1;
    let qc = QC.new_circuit(n_clock + 2);

    // 1. Prepare |b> on q_sys
    let theta_b = 2.0 * num_atan2(b1 / b_norm, b0 / b_norm);
    QC.ry(qc, q_sys, theta_b);

    // 2. Forward QPE of U = exp(i * A * t0)
    c_i = 0;
    while c_i < n_clock {
        QC.h(qc, clock_qs[c_i]);
        c_i = c_i + 1;
    }
    // Conjugate q_sys into eigenbasis of A: Ry(-alpha)
    QC.ry(qc, q_sys, 0.0 - alpha);
    c_i = 0;
    while c_i < n_clock {
        let pow_k = n_clock - 1 - c_i;
        let scale = 1.0 * bit_shl(1, pow_k);
        _emit_controlled_diag_2x2(qc, clock_qs[c_i], q_sys, lam0 * t0 * scale, lam1 * t0 * scale);
        c_i = c_i + 1;
    }
    QC.ry(qc, q_sys, alpha);
    apply_qft(qc, clock_qs, true);

    // 3. Controlled ancilla eigenvalue inversion Ry(2 * arcsin(C / tilde_lambda_m))
    let min_grid_lam = _TWO_PI / (t0 * dim_clock);
    let c_scale = 0.92 * num_max(min_grid_lam, lam0 - min_grid_lam);
    let m_bin = 1;
    while m_bin < dim_clock {
        let lam_est = _TWO_PI * (1.0 * m_bin) / (t0 * dim_clock);
        if lam_est >= c_scale {
            let rot_angle = 2.0 * _asin(c_scale / lam_est);
            _emit_mcry_on_pattern(qc, clock_qs, m_bin, q_anc, rot_angle);
        }
        m_bin = m_bin + 1;
    }

    // 4. Inverse QPE (uncompute clock register back to |0...0>)
    apply_qft(qc, clock_qs, false);
    QC.ry(qc, q_sys, 0.0 - alpha);
    c_i = n_clock - 1;
    while c_i >= 0 {
        let pow_k = n_clock - 1 - c_i;
        let scale = 1.0 * bit_shl(1, pow_k);
        _emit_controlled_diag_2x2(qc, clock_qs[c_i], q_sys, 0.0 - lam0 * t0 * scale, 0.0 - lam1 * t0 * scale);
        c_i = c_i - 1;
    }
    QC.ry(qc, q_sys, alpha);
    c_i = 0;
    while c_i < n_clock {
        QC.h(qc, clock_qs[c_i]);
        c_i = c_i + 1;
    }

    // 5. Post-select ancilla == 1 and clock == 0...0:
    // Basis index with q_anc=1 (MSB), clock=0..0, q_sys in {0, 1}:
    let sv = QC.run_statevector(qc).amplitudes;
    let anc_mask = bit_shl(1, n_clock + 1);
    let amp0 = sv[anc_mask + 0];
    let amp1 = sv[anc_mask + 1];
    let post_prob = (amp0[0] * amp0[0] + amp0[1] * amp0[1]) + (amp1[0] * amp1[0] + amp1[1] * amp1[1]);
    let inv_post = if post_prob > 0.0 { 1.0 / num_sqrt(post_prob) } else { 0.0 };

    let q_state = [
        [amp0[0] * inv_post, amp0[1] * inv_post],
        [amp1[0] * inv_post, amp1[1] * inv_post]
    ];
    let cl_state = [
        [x_cl_unit[0], 0.0],
        [x_cl_unit[1], 0.0]
    ];
    let fid = _state_fidelity(cl_state, q_state);

    // Recover unnormalized vector estimate via C * ||b|| / sqrt(P_anc=1) with sign aligned to inner product
    let dot_sign = if (x_cl_unit[0] * q_state[0][0] + x_cl_unit[1] * q_state[1][0]) >= 0.0 { 1.0 } else { -1.0 };
    let est_norm = if c_scale > 0.0 { b_norm * num_sqrt(post_prob) / c_scale } else { 0.0 };
    let x_quantum_est = [
        dot_sign * q_state[0][0] * est_norm,
        dot_sign * q_state[1][0] * est_norm
    ];

    return map{
        ok: fid > 0.999,
        fidelity: fid,
        eigenvalues: [lam0, lam1],
        condition_number: lam1 / lam0,
        ancilla_success_probability: post_prob,
        c_scale: c_scale,
        n_clock_qubits: n_clock,
        total_qubits: n_clock + 2,
        classical_solution: [x_cl0, x_cl1],
        classical_normalized: x_cl_unit,
        quantum_normalized_amplitudes: q_state,
        quantum_solution_estimate: x_quantum_est,
        circuit: qc
    };
}

// ── 2. Molecular Quantum Chemistry (STO-3G H2 VQE + Parameter-Shift Gradients) ─

fn _pauli_term_expectation_on_sv(sv, n_qubits, ops) {
    let dim = len(sv);
    if len(ops) == 0 {
        let norm_s = 0.0;
        let idx = 0;
        while idx < dim {
            norm_s = norm_s + sv[idx][0] * sv[idx][0] + sv[idx][1] * sv[idx][1];
            idx = idx + 1;
        }
        return norm_s;
    }

    let acc_re = 0.0;
    let idx = 0;
    while idx < dim {
        let partner = idx;
        let ph_re = 1.0;
        let ph_im = 0.0;
        let k = 0;
        while k < len(ops) {
            let op_pair = ops[k];
            let p_sym = str_upper(str(op_pair[0]));
            let q = op_pair[1];
            let mask = bit_shl(1, n_qubits - 1 - q);
            if p_sym == "X" {
                partner = bit_xor(partner, mask);
            } else if p_sym == "Z" {
                if bit_and(partner, mask) != 0 {
                    ph_re = 0.0 - ph_re;
                    ph_im = 0.0 - ph_im;
                }
            } else if p_sym == "Y" {
                // Y|0> = +i|1>, Y|1> = -i|0>
                if bit_and(partner, mask) == 0 {
                    let nr = 0.0 - ph_im;
                    let ni = ph_re;
                    ph_re = nr;
                    ph_im = ni;
                } else {
                    let nr = ph_im;
                    let ni = 0.0 - ph_re;
                    ph_re = nr;
                    ph_im = ni;
                }
                partner = bit_xor(partner, mask);
            } else if p_sym != "I" {
                throw "pauli_expectation_exact: unsupported Pauli operator '" + p_sym + "'";
            }
            k = k + 1;
        }
        let a_re = sv[idx][0];
        let a_im = sv[idx][1];
        let pa_re = ph_re * a_re - ph_im * a_im;
        let pa_im = ph_re * a_im + ph_im * a_re;
        let b_re = sv[partner][0];
        let b_im = sv[partner][1];
        acc_re = acc_re + (b_re * pa_re + b_im * pa_im);
        idx = idx + 1;
    }
    return acc_re;
}

fn pauli_expectation_exact(circuit, pauli_terms) {
    let sv_res = if is_map(circuit) and map_has(circuit, "amplitudes") {
        circuit
    } else {
        QC.run_statevector(circuit)
    };
    let sv = sv_res.amplitudes;
    let n_qubits = sv_res.n_qubits;
    let energy = 0.0;
    let i = 0;
    while i < len(pauli_terms) {
        let term = pauli_terms[i];
        let coeff = term.coeff * 1.0;
        let ops = if map_has(term, "ops") { term.ops } else { [] };
        energy = energy + coeff * _pauli_term_expectation_on_sv(sv, n_qubits, ops);
        i = i + 1;
    }
    return energy;
}

fn parameter_shift_gradient(build_ansatz_fn, theta_vec, pauli_terms) {
    let n_p = len(theta_vec);
    let grads = [];
    let j = 0;
    while j < n_p {
        let th_plus = _clone_vec(theta_vec);
        let th_minus = _clone_vec(theta_vec);
        th_plus[j] = th_plus[j] + _HALF_PI;
        th_minus[j] = th_minus[j] - _HALF_PI;
        let e_plus = pauli_expectation_exact(build_ansatz_fn(th_plus), pauli_terms);
        let e_minus = pauli_expectation_exact(build_ansatz_fn(th_minus), pauli_terms);
        push(grads, 0.5 * (e_plus - e_minus));
        j = j + 1;
    }
    return grads;
}

fn central_difference_gradient(build_ansatz_fn, theta_vec, pauli_terms, eps = 0.00001) {
    let n_p = len(theta_vec);
    let grads = [];
    let j = 0;
    while j < n_p {
        let th_plus = _clone_vec(theta_vec);
        let th_minus = _clone_vec(theta_vec);
        th_plus[j] = th_plus[j] + eps;
        th_minus[j] = th_minus[j] - eps;
        let e_plus = pauli_expectation_exact(build_ansatz_fn(th_plus), pauli_terms);
        let e_minus = pauli_expectation_exact(build_ansatz_fn(th_minus), pauli_terms);
        push(grads, (e_plus - e_minus) / (2.0 * eps));
        j = j + 1;
    }
    return grads;
}

// Tabulated authentic STO-3G 2-qubit parity/BK H2 electronic Hamiltonian coefficients
// (O'Malley et al., PRX 6, 031007 / PySCF / Qiskit Nature STO-3G, zeta = 1.24):
//   H_elec(R) = g_ii * I + g_z0 * Z_0 + g_z1 * Z_1 + g_zz * Z_0 Z_1 + g_xx * X_0 X_1
//   H_mol(R)  = H_elec(R) + (1 / (R / 0.529177210903)) * I
let _H2_STO3G_TABLE = [
    map{ r: 0.350, g_ii: -0.8106535173, g_z0: 0.7474206411, g_zz: -0.0131039342, g_xx: 0.1625756461 },
    map{ r: 0.500, g_ii: -0.9477058572, g_z0: 0.5830812258, g_zz: -0.0125165825, g_xx: 0.1688716312 },
    map{ r: 0.735, g_ii: -1.0523732458, g_z0: 0.3979374248, g_zz: -0.0112801043, g_xx: 0.1809311998 },
    map{ r: 1.000, g_ii: -1.0692442218, g_z0: 0.2675287368, g_zz: -0.0090149828, g_xx: 0.1967913056 },
    map{ r: 1.500, g_ii: -1.0096454150, g_z0: 0.1291013051, g_zz: -0.0041889757, g_xx: 0.2295366525 },
    map{ r: 2.000, g_ii: -0.9285569263, g_z0: 0.0606279596, g_zz: -0.0014311039, g_xx: 0.2591392879 },
    map{ r: 2.500, g_ii: -0.8607229734, g_z0: 0.0271346301, g_zz: -0.0003774174, g_xx: 0.2822109442 }
];

fn _interp_cubic_hermite(xs, ys, x_query) {
    let n = len(xs);
    if x_query <= xs[0] { return ys[0]; }
    if x_query >= xs[n - 1] { return ys[n - 1]; }

    let i = 0;
    while i < n - 1 {
        if num_abs(x_query - xs[i]) < 0.000000000001 {
            return ys[i];
        }
        if x_query > xs[i] and x_query <= xs[i + 1] {
            if num_abs(x_query - xs[i + 1]) < 0.000000000001 {
                return ys[i + 1];
            }
            break;
        }
        i = i + 1;
    }

    // Secant slopes and finite-difference tangents m_i, m_{i+1}
    let h_seg = xs[i + 1] - xs[i];
    let sec_cur = (ys[i + 1] - ys[i]) / h_seg;
    let m0 = if i == 0 {
        sec_cur
    } else {
        let sec_prev = (ys[i] - ys[i - 1]) / (xs[i] - xs[i - 1]);
        0.5 * (sec_prev + sec_cur)
    };
    let m1 = if i + 1 == n - 1 {
        sec_cur
    } else {
        let sec_next = (ys[i + 2] - ys[i + 1]) / (xs[i + 2] - xs[i + 1]);
        0.5 * (sec_cur + sec_next)
    };

    let s = (x_query - xs[i]) / h_seg;
    let s2 = s * s;
    let s3 = s2 * s;
    let h00 = 2.0 * s3 - 3.0 * s2 + 1.0;
    let h10 = s3 - 2.0 * s2 + s;
    let h01 = -2.0 * s3 + 3.0 * s2;
    let h11 = s3 - s2;
    return h00 * ys[i] + h10 * h_seg * m0 + h01 * ys[i + 1] + h11 * h_seg * m1;
}

fn h2_hamiltonian_sto3g(bond_angstrom = 0.735) {
    if bond_angstrom <= 0.05 {
        throw "h2_hamiltonian_sto3g: bond_angstrom must be > 0.05";
    }
    let rs = [];
    let giis = [];
    let gz0s = [];
    let gzzs = [];
    let gxxs = [];
    let k = 0;
    while k < len(_H2_STO3G_TABLE) {
        let row = _H2_STO3G_TABLE[k];
        push(rs, row.r);
        push(giis, row.g_ii);
        push(gz0s, row.g_z0);
        push(gzzs, row.g_zz);
        push(gxxs, row.g_xx);
        k = k + 1;
    }

    let g_ii = _interp_cubic_hermite(rs, giis, bond_angstrom);
    let g_z0 = _interp_cubic_hermite(rs, gz0s, bond_angstrom);
    let g_z1 = 0.0 - g_z0;
    let g_zz = _interp_cubic_hermite(rs, gzzs, bond_angstrom);
    let g_xx = _interp_cubic_hermite(rs, gxxs, bond_angstrom);

    let r_bohr = bond_angstrom / _BOHR_ANGSTROM;
    let e_nuc = 1.0 / r_bohr;
    let total_id = g_ii + e_nuc;

    let pauli_terms = [
        map{ coeff: total_id, ops: [] },
        map{ coeff: g_z0, ops: [["Z", 0]] },
        map{ coeff: g_z1, ops: [["Z", 1]] },
        map{ coeff: g_zz, ops: [["Z", 0], ["Z", 1]] },
        map{ coeff: g_xx, ops: [["X", 0], ["X", 1]] }
    ];
    let electronic_terms = [
        map{ coeff: g_ii, ops: [] },
        map{ coeff: g_z0, ops: [["Z", 0]] },
        map{ coeff: g_z1, ops: [["Z", 1]] },
        map{ coeff: g_zz, ops: [["Z", 0], ["Z", 1]] },
        map{ coeff: g_xx, ops: [["X", 0], ["X", 1]] }
    ];

    // Exact eigenvalues across both parity blocks {|10>, |01>} and {|00>, |11>}
    let e_hf = total_id - 2.0 * g_z0 - g_zz;
    let mean_singlet = total_id - g_zz;
    let gap_singlet = num_sqrt((2.0 * g_z0) * (2.0 * g_z0) + g_xx * g_xx);
    let e_singlet_min = mean_singlet - gap_singlet;
    let e_triplet_min = (total_id + g_zz) - num_abs(g_xx);
    let e_fci = num_min(e_singlet_min, e_triplet_min);

    return map{
        ok: true,
        molecule: "H2",
        basis: "STO-3G",
        mapping: "parity_2qubit",
        n_qubits: 2,
        bond_angstrom: bond_angstrom * 1.0,
        bond_bohr: r_bohr,
        nuclear_repulsion: e_nuc,
        electronic_identity: g_ii,
        total_identity: total_id,
        coefficients: map{
            II: total_id,
            II_electronic: g_ii,
            ZI: g_z0,
            IZ: g_z1,
            ZZ: g_zz,
            XX: g_xx
        },
        pauli_terms: pauli_terms,
        electronic_pauli_terms: electronic_terms,
        hartree_fock_energy: e_hf,
        fci_energy: e_fci
    };
}

fn build_h2_uccsd_ansatz(theta_vec) {
    let qc = QC.new_circuit(2);
    QC.x(qc, 0);
    QC.ry(qc, 0, theta_vec[0]);
    QC.ry(qc, 1, theta_vec[1]);
    QC.cnot(qc, 0, 1);
    QC.ry(qc, 1, theta_vec[2]);
    return qc;
}

fn vqe_h2_molecule(bond_angstrom = 0.735, max_iters = 80) {
    let ham = h2_hamiltonian_sto3g(bond_angstrom);
    let terms = ham.pauli_terms;

    // Initialize near Hartree-Fock reference |10> ((0, pi, 0) gives exact |10>), slightly
    // perturbed so we observe genuine VQE correlation energy descent from HF -> FCI!
    let theta = [0.06, _PI - 0.04, 0.03];
    let cur_e = pauli_expectation_exact(build_h2_uccsd_ansatz(theta), terms);
    let initial_e = cur_e;
    let best_e = cur_e;
    let best_theta = _clone_vec(theta);
    let history = [cur_e];

    // Hybrid L-BFGS / Barzilai-Borwein + Adam with exact parameter_shift_gradient
    let m_adam = [0.0, 0.0, 0.0];
    let v_adam = [0.0, 0.0, 0.0];
    let beta1 = 0.85;
    let beta2 = 0.99;
    let lr_adam = 0.14;

    let prev_theta = nil;
    let prev_grad = nil;
    let final_grad = [0.0, 0.0, 0.0];
    let iters_done = 0;

    let iter_idx = 0;
    while iter_idx < max_iters {
        let grad = parameter_shift_gradient(build_h2_uccsd_ansatz, theta, terms);
        final_grad = grad;
        let g_norm2 = grad[0] * grad[0] + grad[1] * grad[1] + grad[2] * grad[2];
        if g_norm2 < 0.00000000000001 {
            break;
        }

        // Compute Barzilai-Borwein quasi-Newton step when previous gradient is available
        let used_bb = false;
        if prev_theta != nil and prev_grad != nil {
            let sy = 0.0;
            let yy = 0.0;
            let p = 0;
            while p < 3 {
                let ds = theta[p] - prev_theta[p];
                let dy = grad[p] - prev_grad[p];
                sy = sy + ds * dy;
                yy = yy + dy * dy;
                p = p + 1;
            }
            if sy > 0.000000000001 and yy > 0.000000000001 {
                let alpha_bb = num_min(1.2, num_max(0.02, sy / yy));
                let cand_bb = [
                    theta[0] - alpha_bb * grad[0],
                    theta[1] - alpha_bb * grad[1],
                    theta[2] - alpha_bb * grad[2]
                ];
                let e_bb = pauli_expectation_exact(build_h2_uccsd_ansatz(cand_bb), terms);
                if e_bb <= cur_e - 0.0001 * alpha_bb * g_norm2 {
                    prev_theta = _clone_vec(theta);
                    prev_grad = _clone_vec(grad);
                    theta = cand_bb;
                    cur_e = e_bb;
                    used_bb = true;
                }
            }
        }

        if not used_bb {
            prev_theta = _clone_vec(theta);
            prev_grad = _clone_vec(grad);
            let t_step = iter_idx + 1;
            let b1_corr = 1.0 - num_pow(beta1, t_step);
            let b2_corr = 1.0 - num_pow(beta2, t_step);
            let cand_adam = [0.0, 0.0, 0.0];
            let p = 0;
            while p < 3 {
                m_adam[p] = beta1 * m_adam[p] + (1.0 - beta1) * grad[p];
                v_adam[p] = beta2 * v_adam[p] + (1.0 - beta2) * grad[p] * grad[p];
                let m_hat = m_adam[p] / b1_corr;
                let v_hat = v_adam[p] / b2_corr;
                cand_adam[p] = theta[p] - lr_adam * m_hat / (num_sqrt(v_hat) + 0.00000001);
                p = p + 1;
            }
            let e_adam = pauli_expectation_exact(build_h2_uccsd_ansatz(cand_adam), terms);
            if e_adam < cur_e {
                theta = cand_adam;
                cur_e = e_adam;
            } else {
                // Backtracking gradient line search guarantee
                let step_ls = 0.25;
                let ls = 0;
                while ls < 6 {
                    let cand_ls = [
                        theta[0] - step_ls * grad[0],
                        theta[1] - step_ls * grad[1],
                        theta[2] - step_ls * grad[2]
                    ];
                    let e_ls = pauli_expectation_exact(build_h2_uccsd_ansatz(cand_ls), terms);
                    if e_ls < cur_e {
                        theta = cand_ls;
                        cur_e = e_ls;
                        break;
                    }
                    step_ls = step_ls * 0.4;
                    ls = ls + 1;
                }
            }
        }

        push(history, cur_e);
        if cur_e < best_e {
            best_e = cur_e;
            best_theta = _clone_vec(theta);
        }
        iters_done = iter_idx + 1;
        iter_idx = iter_idx + 1;
    }

    final_grad = parameter_shift_gradient(build_h2_uccsd_ansatz, best_theta, terms);
    let g_norm = num_sqrt(
        final_grad[0] * final_grad[0] +
        final_grad[1] * final_grad[1] +
        final_grad[2] * final_grad[2]
    );
    let err_ha = num_abs(best_e - ham.fci_energy);
    let chem_ok = err_ha < 0.0016;

    return map{
        ok: chem_ok,
        molecule: "H2",
        basis: "STO-3G",
        bond_angstrom: bond_angstrom * 1.0,
        nuclear_repulsion: ham.nuclear_repulsion,
        hartree_fock_energy: ham.hartree_fock_energy,
        initial_energy: initial_e,
        vqe_energy: best_e,
        ground_energy: best_e,
        fci_energy: ham.fci_energy,
        energy_error_hartree: err_ha,
        chemical_accuracy_achieved: chem_ok,
        optimal_params: best_theta,
        final_gradient: final_grad,
        gradient_norm: g_norm,
        iterations: iters_done,
        energy_history: history,
        pauli_terms: terms,
        circuit: build_h2_uccsd_ansatz(best_theta)
    };
}

// ── 3A. Canonical 156-Qubit IBM Heron r2 Heavy-Hex Coupling Graph ────────────

fn heron_r2_156q_heavy_hex_graph() {
    // Authentic IBM Heron r2 (ibm_fez / ibm_kingston / ibm_marrakesh) 156-qubit topology:
    //   8 horizontal rows of 16 qubits (8 * 16 = 128) interleaved with
    //   7 vertical bridge rows of 4 qubits (7 * 4 = 28) => 156 physical qubits (0..155).
    //   Even bridge rows (0, 2, 4, 6) bridge columns [3, 7, 11, 15] -> e.g. [3, 16], [16, 23].
    //   Odd bridge rows  (1, 3, 5)    bridge columns [1, 5, 9, 13]  -> e.g. [21, 36], [36, 41].
    let n_qubits = 156;
    let undirected_edges = [];
    let directed_edges = [];
    let adj = [];
    let coords = [];

    let q = 0;
    while q < n_qubits {
        push(adj, []);
        push(coords, map{ qubit: q, row: 0, col: 0, role: "chain" });
        q = q + 1;
    }

    let add_edge = fn(u, v) {
        let lo = if u < v { u } else { v };
        let hi = if u < v { v } else { u };
        push(undirected_edges, [lo, hi]);
        push(directed_edges, [lo, hi]);
        push(directed_edges, [hi, lo]);
        push(adj[lo], hi);
        push(adj[hi], lo);
    };

    let r = 0;
    while r < 8 {
        let row_base = 20 * r;
        let c = 0;
        while c < 16 {
            let pq = row_base + c;
            coords[pq] = map{ qubit: pq, row: 2 * r, col: c, role: "chain" };
            if c < 15 {
                add_edge(pq, pq + 1);
            }
            c = c + 1;
        }
        if r < 7 {
            let bridge_base = row_base + 16;
            let next_row_base = 20 * (r + 1);
            let cols = if num_mod(r, 2) == 0 { [3, 7, 11, 15] } else { [1, 5, 9, 13] };
            let b_idx = 0;
            while b_idx < 4 {
                let bq = bridge_base + b_idx;
                let col_k = cols[b_idx];
                coords[bq] = map{ qubit: bq, row: 2 * r + 1, col: col_k, role: "bridge" };
                add_edge(row_base + col_k, bq);
                add_edge(bq, next_row_base + col_k);
                b_idx = b_idx + 1;
            }
        }
        r = r + 1;
    }

    let deg_hist = map{ "1": 0, "2": 0, "3": 0 };
    let max_deg = 0;
    q = 0;
    while q < n_qubits {
        let d = len(adj[q]);
        if d > max_deg { max_deg = d; }
        let dk = str(d);
        if map_has(deg_hist, dk) {
            deg_hist[dk] = deg_hist[dk] + 1;
        } else {
            deg_hist[dk] = 1;
        }
        q = q + 1;
    }

    return map{
        ok: true,
        family: "Heron r2",
        backends: ["ibm_fez", "ibm_kingston", "ibm_marrakesh"],
        n_qubits: n_qubits,
        n_undirected_edges: len(undirected_edges),
        n_directed_edges: len(directed_edges),
        max_degree: max_deg,
        degree_histogram: deg_hist,
        edges: undirected_edges,
        coupling_map: directed_edges,
        adjacency: adj,
        coordinates: coords
    };
}

// ── 3B. Noise-Weighted Dijkstra Heavy-Hex Subgraph Selector & ISA Router ─────

fn _edge_key(u, v) {
    let lo = if u < v { u } else { v };
    let hi = if u < v { v } else { u };
    return str(lo) + "-" + str(hi);
}

fn _normalize_coupling_graph(coupling_map) {
    if coupling_map == nil {
        return heron_r2_156q_heavy_hex_graph();
    }
    if is_map(coupling_map) and map_has(coupling_map, "adjacency") and map_has(coupling_map, "edges") {
        return coupling_map;
    }
    let edge_list = if is_map(coupling_map) and map_has(coupling_map, "edges") {
        coupling_map.edges
    } else if is_map(coupling_map) and map_has(coupling_map, "coupling_map") {
        coupling_map.coupling_map
    } else if is_array(coupling_map) {
        coupling_map
    } else {
        throw "route_on_heavy_hex_156q: unsupported coupling_map format";
    };

    let max_q = 155;
    let i = 0;
    while i < len(edge_list) {
        let e = edge_list[i];
        if e[0] > max_q { max_q = e[0]; }
        if e[1] > max_q { max_q = e[1]; }
        i = i + 1;
    }
    let n_phys = max_q + 1;
    let adj = [];
    let q = 0;
    while q < n_phys {
        push(adj, []);
        q = q + 1;
    }
    let seen = map{};
    let undir = [];
    i = 0;
    while i < len(edge_list) {
        let u = edge_list[i][0];
        let v = edge_list[i][1];
        if u != v {
            let ek = _edge_key(u, v);
            if not map_has(seen, ek) {
                seen[ek] = true;
                let lo = if u < v { u } else { v };
                let hi = if u < v { v } else { u };
                push(undir, [lo, hi]);
                push(adj[lo], hi);
                push(adj[hi], lo);
            }
        }
        i = i + 1;
    }
    return map{
        ok: true,
        n_qubits: n_phys,
        edges: undir,
        adjacency: adj
    };
}

fn _build_cz_weight_lookup(graph_obj, cz_error_map) {
    let weights = map{};
    let default_err = if cz_error_map == nil { 0.0025 } else { 0.008 };
    let i = 0;
    while i < len(graph_obj.edges) {
        let e = graph_obj.edges[i];
        let u = e[0];
        let v = e[1];
        let ek_dash = _edge_key(u, v);
        let err_val = default_err;
        if is_map(cz_error_map) {
            let k1 = str(u) + "-" + str(v);
            let k2 = str(v) + "-" + str(u);
            let k3 = str(u) + "," + str(v);
            let k4 = str(v) + "," + str(u);
            let k5 = str(u) + "_" + str(v);
            let k6 = str(v) + "_" + str(u);
            if map_has(cz_error_map, k1) { err_val = cz_error_map[k1] * 1.0; }
            else if map_has(cz_error_map, k2) { err_val = cz_error_map[k2] * 1.0; }
            else if map_has(cz_error_map, k3) { err_val = cz_error_map[k3] * 1.0; }
            else if map_has(cz_error_map, k4) { err_val = cz_error_map[k4] * 1.0; }
            else if map_has(cz_error_map, k5) { err_val = cz_error_map[k5] * 1.0; }
            else if map_has(cz_error_map, k6) { err_val = cz_error_map[k6] * 1.0; }
        } else if is_array(cz_error_map) {
            let j = 0;
            while j < len(cz_error_map) {
                let item = cz_error_map[j];
                if is_array(item) and len(item) >= 3 {
                    if _edge_key(item[0], item[1]) == ek_dash {
                        err_val = item[2] * 1.0;
                    }
                } else if is_map(item) and map_has(item, "edge") and map_has(item, "error") {
                    if _edge_key(item.edge[0], item.edge[1]) == ek_dash {
                        err_val = item.error * 1.0;
                    }
                }
                j = j + 1;
            }
        }
        // Strictly positive noise cost for Dijkstra: swap costs ~3x single CZ error + tiny hop tie-breaker
        weights[ek_dash] = num_max(0.000001, err_val) + 0.00001;
        i = i + 1;
    }
    return weights;
}

// Noise-weighted Dijkstra shortest path inside an induced subgraph `sub_nodes` (size k)
fn _dijkstra_subgraph_path(sub_nodes, sub_adj, edge_weights, src_idx, dst_idx) {
    let k = len(sub_nodes);
    if src_idx == dst_idx {
        return map{ ok: true, path: [src_idx], cost: 0.0 };
    }
    let inf = 1000000000.0;
    let dist = [];
    let prev = [];
    let used = [];
    let i = 0;
    while i < k {
        push(dist, inf);
        push(prev, -1);
        push(used, false);
        i = i + 1;
    }
    dist[src_idx] = 0.0;

    let step = 0;
    while step < k {
        let u = -1;
        let best_d = inf;
        let v = 0;
        while v < k {
            if (not used[v]) and dist[v] < best_d {
                best_d = dist[v];
                u = v;
            }
            v = v + 1;
        }
        if u < 0 or u == dst_idx {
            break;
        }
        used[u] = true;
        let nbrs = sub_adj[u];
        let ni = 0;
        while ni < len(nbrs) {
            let nb = nbrs[ni];
            let w = edge_weights[_edge_key(sub_nodes[u], sub_nodes[nb])];
            if dist[u] + w < dist[nb] {
                dist[nb] = dist[u] + w;
                prev[nb] = u;
            }
            ni = ni + 1;
        }
        step = step + 1;
    }

    if dist[dst_idx] >= inf * 0.5 {
        return map{ ok: false, path: [], cost: inf };
    }
    let rev_path = [];
    let cur = dst_idx;
    while cur >= 0 {
        push(rev_path, cur);
        cur = prev[cur];
    }
    let path = [];
    let pi = len(rev_path) - 1;
    while pi >= 0 {
        push(path, rev_path[pi]);
        pi = pi - 1;
    }
    return map{ ok: true, path: path, cost: dist[dst_idx] };
}

fn _build_induced_sub_adj(sub_nodes, edge_weights) {
    let k = len(sub_nodes);
    let sub_adj = [];
    let i = 0;
    while i < k {
        push(sub_adj, []);
        i = i + 1;
    }
    i = 0;
    while i < k {
        let j = i + 1;
        while j < k {
            let ek = _edge_key(sub_nodes[i], sub_nodes[j]);
            if map_has(edge_weights, ek) {
                push(sub_adj[i], j);
                push(sub_adj[j], i);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return sub_adj;
}

// Expand 3+-qubit gates (ccx, mcz) to 1Q + 2Q gates prior to Heavy-Hex routing
fn _expand_multi_qubit_gates(gates) {
    let out = [];
    let emit_cp_local = fn(c, t, phi) {
        let half = phi * 0.5;
        push(out, map{ op: "rz", targets: [c], controls: [], params: [half] });
        push(out, map{ op: "rz", targets: [t], controls: [], params: [half] });
        push(out, map{ op: "cx", targets: [t], controls: [c], params: [] });
        push(out, map{ op: "rz", targets: [t], controls: [], params: [0.0 - half] });
        push(out, map{ op: "cx", targets: [t], controls: [c], params: [] });
    };

    let emit_ccx_local = fn(c1, c2, t) {
        push(out, map{ op: "h", targets: [t], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [t], controls: [c2], params: [] });
        push(out, map{ op: "tdg", targets: [t], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [t], controls: [c1], params: [] });
        push(out, map{ op: "t", targets: [t], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [t], controls: [c2], params: [] });
        push(out, map{ op: "tdg", targets: [t], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [t], controls: [c1], params: [] });
        push(out, map{ op: "t", targets: [c2], controls: [], params: [] });
        push(out, map{ op: "t", targets: [t], controls: [], params: [] });
        push(out, map{ op: "h", targets: [t], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [c2], controls: [c1], params: [] });
        push(out, map{ op: "t", targets: [c1], controls: [], params: [] });
        push(out, map{ op: "tdg", targets: [c2], controls: [], params: [] });
        push(out, map{ op: "cx", targets: [c2], controls: [c1], params: [] });
    };

    let emit_mcp_rec = nil;
    emit_mcp_rec = fn(ctrls, t, phi) {
        let k = len(ctrls);
        if k == 0 {
            push(out, map{ op: "rz", targets: [t], controls: [], params: [phi] });
            return nil;
        }
        if k == 1 {
            emit_cp_local(ctrls[0], t, phi);
            return nil;
        }
        let prefix = slice(ctrls, 0, k - 1);
        let last_c = ctrls[k - 1];
        let half = phi * 0.5;
        emit_mcp_rec(prefix, t, half);
        push(out, map{ op: "cx", targets: [t], controls: [last_c], params: [] });
        emit_mcp_rec(prefix, t, 0.0 - half);
        push(out, map{ op: "cx", targets: [t], controls: [last_c], params: [] });
        emit_mcp_rec(prefix, last_c, half);
        return nil;
    };

    let i = 0;
    while i < len(gates) {
        let g = gates[i];
        if g.op == "ccx" {
            emit_ccx_local(g.controls[0], g.controls[1], g.targets[0]);
        } else if g.op == "mcz" {
            let ctrls = g.controls;
            let tgt = g.targets[0];
            if len(ctrls) == 0 {
                push(out, map{ op: "z", targets: [tgt], controls: [], params: [] });
            } else if len(ctrls) == 1 {
                push(out, map{ op: "cz", targets: [tgt], controls: [ctrls[0]], params: [] });
            } else if len(ctrls) == 2 {
                push(out, map{ op: "h", targets: [tgt], controls: [], params: [] });
                emit_ccx_local(ctrls[0], ctrls[1], tgt);
                push(out, map{ op: "h", targets: [tgt], controls: [], params: [] });
            } else {
                emit_mcp_rec(ctrls, tgt, _PI);
            }
        } else {
            push(out, g);
        }
        i = i + 1;
    }
    return out;
}

fn _select_lowest_noise_subgraph(n_logical, graph_obj, edge_weights, expanded_gates) {
    let n_phys = graph_obj.n_qubits;
    if n_logical > n_phys {
        throw "route_on_heavy_hex_156q: circuit n_qubits (" + str(n_logical) + ") exceeds device qubits (" + str(n_phys) + ")";
    }
    if n_logical == 1 {
        // Pick qubit incident to the single lowest-error coupler
        let best_q = 0;
        let best_w = 1000000000.0;
        let i = 0;
        while i < len(graph_obj.edges) {
            let e = graph_obj.edges[i];
            let w = edge_weights[_edge_key(e[0], e[1])];
            if w < best_w {
                best_w = w;
                best_q = e[0];
            }
            i = i + 1;
        }
        return map{ physical_qubits: [best_q], subgraph_score: 0.0 };
    }

    // Collect logical 2-qubit interaction counts to reward topological match (e.g. T-junctions)
    let pair_counts = [];
    let pair_map = map{};
    let gi = 0;
    while gi < len(expanded_gates) {
        let g = expanded_gates[gi];
        if g.op == "cx" or g.op == "cz" or g.op == "swap" {
            let qa = if g.op == "swap" { g.targets[0] } else { g.controls[0] };
            let qb = if g.op == "swap" { g.targets[1] } else { g.targets[0] };
            let pk = _edge_key(qa, qb);
            if map_has(pair_map, pk) {
                pair_counts[pair_map[pk]].count = pair_counts[pair_map[pk]].count + 1;
            } else {
                pair_map[pk] = len(pair_counts);
                push(pair_counts, map{ a: qa, b: qb, count: 1 });
            }
        }
        gi = gi + 1;
    }

    // Evaluate Prim minimum-noise connected subgraphs across candidate seeds
    let stride = if n_logical <= 20 { 1 } else { 8 };
    let best_sub = nil;
    let best_score = 1000000000.0;

    let seed = 0;
    while seed < n_phys {
        if len(graph_obj.adjacency[seed]) > 0 {
            let chosen = [seed];
            let in_chosen = map{};
            in_chosen[str(seed)] = true;
            let tree_err = 0.0;

            while len(chosen) < n_logical {
                let best_next = -1;
                let best_edge_w = 1000000000.0;
                let ci = 0;
                while ci < len(chosen) {
                    let u = chosen[ci];
                    let nbrs = graph_obj.adjacency[u];
                    let ni = 0;
                    while ni < len(nbrs) {
                        let v = nbrs[ni];
                        if not map_has(in_chosen, str(v)) {
                            let w = edge_weights[_edge_key(u, v)];
                            if w < best_edge_w {
                                best_edge_w = w;
                                best_next = v;
                            }
                        }
                        ni = ni + 1;
                    }
                    ci = ci + 1;
                }
                if best_next < 0 {
                    break;
                }
                in_chosen[str(best_next)] = true;
                push(chosen, best_next);
                tree_err = tree_err + best_edge_w;
            }

            if len(chosen) == n_logical {
                // Score subgraph by tree coupler error + circuit-weighted routing cost (for n <= 20)
                let route_score = tree_err;
                if n_logical <= 20 and len(pair_counts) > 0 {
                    let sub_adj = _build_induced_sub_adj(chosen, edge_weights);
                    let pi = 0;
                    while pi < len(pair_counts) {
                        let pr = pair_counts[pi];
                        let sp = _dijkstra_subgraph_path(chosen, sub_adj, edge_weights, pr.a, pr.b);
                        let hops = len(sp.path) - 1;
                        // Direct edge = 1x weight; each SWAP hop adds 6x CZ weight
                        let gate_err = if hops <= 1 { sp.cost } else { sp.cost * (1.0 + 5.0 * (hops - 1)) };
                        route_score = route_score + pr.count * gate_err;
                        pi = pi + 1;
                    }
                }
                if route_score < best_score {
                    best_score = route_score;
                    best_sub = chosen;
                }
            }
        }
        seed = seed + stride;
    }

    if best_sub == nil {
        throw "route_on_heavy_hex_156q: could not find connected subgraph of size " + str(n_logical);
    }
    return map{ physical_qubits: best_sub, subgraph_score: best_score };
}

fn _emit_isa_1q(raw_isa, op, q, params) {
    if op == "x" {
        push(raw_isa, map{ op: "x", targets: [q], controls: [], params: [] });
    } else if op == "sx" {
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
    } else if op == "z" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_PI] });
    } else if op == "s" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_HALF_PI] });
    } else if op == "sdg" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [0.0 - _HALF_PI] });
    } else if op == "t" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_QUARTER_PI] });
    } else if op == "tdg" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [0.0 - _QUARTER_PI] });
    } else if op == "rz" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [params[0] * 1.0] });
    } else if op == "h" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_HALF_PI] });
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_HALF_PI] });
    } else if op == "y" {
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_PI] });
        push(raw_isa, map{ op: "x", targets: [q], controls: [], params: [] });
    } else if op == "rx" {
        let th = params[0] * 1.0;
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_HALF_PI] });
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [th + _PI] });
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [5.0 * _HALF_PI] });
    } else if op == "ry" {
        let th = params[0] * 1.0;
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [th + _PI] });
        push(raw_isa, map{ op: "sx", targets: [q], controls: [], params: [] });
        push(raw_isa, map{ op: "rz", targets: [q], controls: [], params: [_PI] });
    } else {
        throw "route_on_heavy_hex_156q: unsupported 1q gate '" + op + "'";
    }
}

fn _emit_isa_adj_cx(raw_isa, c, t) {
    _emit_isa_1q(raw_isa, "h", t, []);
    push(raw_isa, map{ op: "cz", targets: [t], controls: [c], params: [] });
    _emit_isa_1q(raw_isa, "h", t, []);
}

fn _emit_isa_adj_swap(raw_isa, a, b) {
    _emit_isa_adj_cx(raw_isa, a, b);
    _emit_isa_adj_cx(raw_isa, b, a);
    _emit_isa_adj_cx(raw_isa, a, b);
}

fn _merge_and_simplify_isa(n_qubits, raw_gates) {
    let merge_rz = fn(gates_in) {
        let pending = [];
        let q = 0;
        while q < n_qubits {
            push(pending, 0.0);
            q = q + 1;
        }
        let merged = [];
        let eps = 0.000000000001;
        let i = 0;
        while i < len(gates_in) {
            let g = gates_in[i];
            if g.op == "rz" {
                let tq = g.targets[0];
                pending[tq] = pending[tq] + g.params[0];
            } else if g.op == "sx" or g.op == "x" {
                let tq = g.targets[0];
                let ang = _reduce_angle(pending[tq]);
                pending[tq] = 0.0;
                if num_abs(ang) >= eps {
                    push(merged, map{ op: "rz", targets: [tq], controls: [], params: [ang] });
                }
                push(merged, g);
            } else if g.op == "cz" {
                let cq = g.controls[0];
                let tq = g.targets[0];
                let ac = _reduce_angle(pending[cq]);
                pending[cq] = 0.0;
                if num_abs(ac) >= eps {
                    push(merged, map{ op: "rz", targets: [cq], controls: [], params: [ac] });
                }
                let at = _reduce_angle(pending[tq]);
                pending[tq] = 0.0;
                if num_abs(at) >= eps {
                    push(merged, map{ op: "rz", targets: [tq], controls: [], params: [at] });
                }
                push(merged, g);
            }
            i = i + 1;
        }
        q = 0;
        while q < n_qubits {
            let ang = _reduce_angle(pending[q]);
            if num_abs(ang) >= eps {
                push(merged, map{ op: "rz", targets: [q], controls: [], params: [ang] });
            }
            q = q + 1;
        }
        return merged;
    };

    let simplify_cliff = fn(gates_in) {
        let last_idx = [];
        let q = 0;
        while q < n_qubits {
            push(last_idx, -1);
            q = q + 1;
        }
        let out = [];
        let alive = [];
        let i = 0;
        while i < len(gates_in) {
            let g = gates_in[i];
            if g.op == "sx" or g.op == "x" or g.op == "rz" {
                let tq = g.targets[0];
                let prev = last_idx[tq];
                if prev >= 0 and alive[prev] {
                    let pg = out[prev];
                    if g.op == "sx" and pg.op == "sx" {
                        out[prev] = map{ op: "x", targets: [tq], controls: [], params: [] };
                        i = i + 1;
                        continue;
                    }
                    if g.op == "x" and pg.op == "x" {
                        alive[prev] = false;
                        last_idx[tq] = -1;
                        i = i + 1;
                        continue;
                    }
                }
                let pos = len(out);
                push(out, g);
                push(alive, true);
                last_idx[tq] = pos;
            } else if g.op == "cz" {
                let cq = g.controls[0];
                let tq = g.targets[0];
                let pc = last_idx[cq];
                let pt = last_idx[tq];
                if pc >= 0 and pc == pt and alive[pc] and out[pc].op == "cz" {
                    let oc = out[pc].controls[0];
                    let ot = out[pc].targets[0];
                    if (oc == cq and ot == tq) or (oc == tq and ot == cq) {
                        alive[pc] = false;
                        last_idx[cq] = -1;
                        last_idx[tq] = -1;
                        i = i + 1;
                        continue;
                    }
                }
                let pos = len(out);
                push(out, g);
                push(alive, true);
                last_idx[cq] = pos;
                last_idx[tq] = pos;
            }
            i = i + 1;
        }
        let compact = [];
        let k = 0;
        while k < len(out) {
            if alive[k] {
                push(compact, out[k]);
            }
            k = k + 1;
        }
        return compact;
    };

    let s1 = merge_rz(raw_gates);
    let s2 = simplify_cliff(s1);
    let s3 = merge_rz(s2);
    let s4 = simplify_cliff(s3);
    return merge_rz(s4);
}

fn _format_heavy_hex_isa_qasm3(isa_circuit, include_measurements = true) {
    let n = isa_circuit.n_qubits;
    let phys = isa_circuit.physical_qubits;
    let lines = [
        "OPENQASM 3.0;",
        "include \"stdgates.inc\";"
    ];
    if include_measurements {
        push(lines, "bit[" + str(n) + "] c;");
    }
    let i = 0;
    while i < len(isa_circuit.gates) {
        let g = isa_circuit.gates[i];
        if g.op == "rz" {
            push(lines, "rz(" + str(g.params[0]) + ") $" + str(phys[g.targets[0]]) + ";");
        } else if g.op == "sx" or g.op == "x" {
            push(lines, g.op + " $" + str(phys[g.targets[0]]) + ";");
        } else if g.op == "cz" {
            push(lines, "cz $" + str(phys[g.controls[0]]) + ", $" + str(phys[g.targets[0]]) + ";");
        } else {
            throw "route_on_heavy_hex_156q: illegal non-ISA gate '" + g.op + "'";
        }
        i = i + 1;
    }
    if include_measurements {
        let q = 0;
        while q < n {
            push(lines, "c[" + str(q) + "] = measure $" + str(phys[q]) + ";");
            q = q + 1;
        }
    }
    return str_join(lines, "\n") + "\n";
}

fn route_on_heavy_hex_156q(circuit, coupling_map = nil, cz_error_map = nil) {
    let n = circuit.n_qubits;
    if n < 1 or n > 156 {
        throw "route_on_heavy_hex_156q: circuit.n_qubits must be in 1..156";
    }
    let graph_obj = _normalize_coupling_graph(coupling_map);
    let edge_weights = _build_cz_weight_lookup(graph_obj, cz_error_map);
    let expanded = _expand_multi_qubit_gates(circuit.gates);

    let selection = _select_lowest_noise_subgraph(n, graph_obj, edge_weights, expanded);
    let phys_qs = selection.physical_qubits;
    let sub_adj = _build_induced_sub_adj(phys_qs, edge_weights);

    let raw_isa = [];
    let swap_chains_inserted = 0;
    let swap_gates_inserted = 0;
    let routed_paths = [];

    let gi = 0;
    while gi < len(expanded) {
        let g = expanded[gi];
        let op = g.op;
        if op == "cx" or op == "cz" or op == "swap" {
            let qa = if op == "swap" { g.targets[0] } else { g.controls[0] };
            let qb = if op == "swap" { g.targets[1] } else { g.targets[0] };
            let sp = _dijkstra_subgraph_path(phys_qs, sub_adj, edge_weights, qa, qb);
            if not sp.ok {
                throw "route_on_heavy_hex_156q: disconnected physical subgraph between logical " + str(qa) + " and " + str(qb);
            }
            let path = sp.path;
            let plen = len(path);
            if plen == 2 {
                // Directly adjacent on Heavy-Hex!
                if op == "cz" {
                    push(raw_isa, map{ op: "cz", targets: [qb], controls: [qa], params: [] });
                } else if op == "cx" {
                    _emit_isa_adj_cx(raw_isa, qa, qb);
                } else {
                    _emit_isa_adj_swap(raw_isa, qa, qb);
                }
            } else {
                // Route via symmetric noise-weighted Dijkstra SWAP chain along Heavy-Hex couplers
                swap_chains_inserted = swap_chains_inserted + 1;
                let phys_chain = [];
                let pk = 0;
                while pk < plen {
                    push(phys_chain, phys_qs[path[pk]]);
                    pk = pk + 1;
                }
                push(routed_paths, phys_chain);

                let hop = 0;
                while hop <= plen - 3 {
                    _emit_isa_adj_swap(raw_isa, path[hop], path[hop + 1]);
                    swap_gates_inserted = swap_gates_inserted + 1;
                    hop = hop + 1;
                }
                let near_a = path[plen - 2];
                let near_b = path[plen - 1];
                if op == "cz" {
                    push(raw_isa, map{ op: "cz", targets: [near_b], controls: [near_a], params: [] });
                } else if op == "cx" {
                    _emit_isa_adj_cx(raw_isa, near_a, near_b);
                } else {
                    _emit_isa_adj_swap(raw_isa, near_a, near_b);
                }
                hop = plen - 3;
                while hop >= 0 {
                    _emit_isa_adj_swap(raw_isa, path[hop], path[hop + 1]);
                    swap_gates_inserted = swap_gates_inserted + 1;
                    hop = hop - 1;
                }
            }
        } else {
            _emit_isa_1q(raw_isa, op, g.targets[0], g.params);
        }
        gi = gi + 1;
    }

    let isa_gates = _merge_and_simplify_isa(n, raw_isa);

    // Verify 100% Heavy-Hex edge compliance and basis gate compliance
    let n_rz = 0;
    let n_sx = 0;
    let n_x = 0;
    let n_cz = 0;
    let basis_compliant = true;
    let edge_compliant = true;
    let est_cz_noise = 0.0;

    let k = 0;
    while k < len(isa_gates) {
        let ig = isa_gates[k];
        if ig.op == "rz" {
            n_rz = n_rz + 1;
        } else if ig.op == "sx" {
            n_sx = n_sx + 1;
        } else if ig.op == "x" {
            n_x = n_x + 1;
        } else if ig.op == "cz" {
            n_cz = n_cz + 1;
            let pu = phys_qs[ig.controls[0]];
            let pv = phys_qs[ig.targets[0]];
            let ek = _edge_key(pu, pv);
            if not map_has(edge_weights, ek) {
                edge_compliant = false;
            } else {
                est_cz_noise = est_cz_noise + (edge_weights[ek] - 0.00001);
            }
        } else {
            basis_compliant = false;
        }
        k = k + 1;
    }

    let isa_circuit = map{
        format: "pblang.quantum.circuit.v1",
        isa: "ibm_heron_r2",
        topology: "heavy_hex_156q",
        basis_gates: ["rz", "sx", "x", "cz"],
        n_qubits: n,
        physical_qubits: phys_qs,
        gates: isa_gates,
        gate_counts: map{
            rz: n_rz,
            sx: n_sx,
            x: n_x,
            cz: n_cz,
            total: len(isa_gates)
        }
    };

    // Exact unitary statevector equivalence verification when n <= 20
    let fidelity = 1.0;
    let sv_verified = false;
    if n <= 20 {
        let sv_orig = QC.run_statevector(circuit).amplitudes;
        let sv_isa = QC.run_statevector(isa_circuit).amplitudes;
        fidelity = _state_fidelity(sv_orig, sv_isa);
        sv_verified = true;
    }

    let all_ok = basis_compliant and edge_compliant and ((not sv_verified) or fidelity > 0.9999999999);
    if not all_ok {
        throw "route_on_heavy_hex_156q: verification failed (basis=" + str(basis_compliant) +
              ", edge=" + str(edge_compliant) + ", fidelity=" + str(fidelity) + ")";
    }

    return map{
        ok: all_ok,
        fidelity: fidelity,
        statevector_verified: sv_verified,
        basis_compliant: basis_compliant,
        heavy_hex_edge_compliant: edge_compliant,
        n_qubits: n,
        physical_qubits: phys_qs,
        swap_chains_inserted: swap_chains_inserted,
        swap_gates_inserted: swap_gates_inserted,
        routed_paths: routed_paths,
        estimated_cz_error_sum: est_cz_noise,
        gate_counts: isa_circuit.gate_counts,
        isa_circuit: isa_circuit,
        openqasm3_isa: _format_heavy_hex_isa_qasm3(isa_circuit, true),
        openqasm3_isa_estimator: _format_heavy_hex_isa_qasm3(isa_circuit, false)
    };
}

// ── 3C. IBM Quantum Runtime REST v1 EstimatorV2 Client ───────────────────────

fn _scrub_secrets(text, secrets) {
    let out = str(text);
    let i = 0;
    while i < len(secrets) {
        let s = secrets[i];
        if type(s) == "string" and len(s) >= 4 {
            out = str_replace_all(out, s, "[REDACTED]");
        }
        i = i + 1;
    }
    return out;
}

fn format_estimator_v2_observables(n_qubits, pauli_terms, physical_qubits = nil) {
    let logical_obs = map{};
    let physical_obs = map{};
    let i = 0;
    while i < len(pauli_terms) {
        let term = pauli_terms[i];
        let coeff = term.coeff * 1.0;
        let ops = if map_has(term, "ops") { term.ops } else { [] };

        let chars = [];
        let q = 0;
        while q < n_qubits {
            push(chars, "I");
            q = q + 1;
        }
        let k = 0;
        while k < len(ops) {
            let sym = str_upper(str(ops[k][0]));
            let tq = ops[k][1];
            if tq < 0 or tq >= n_qubits {
                throw "format_estimator_v2_observables: Pauli qubit " + str(tq) + " out of range 0.." + str(n_qubits - 1);
            }
            chars[tq] = sym;
            k = k + 1;
        }
        let p_key = str_join(chars, "");
        if map_has(logical_obs, p_key) {
            logical_obs[p_key] = logical_obs[p_key] + coeff;
        } else {
            logical_obs[p_key] = coeff;
        }

        if is_array(physical_qubits) and len(physical_qubits) == n_qubits {
            let phys_chars = [];
            let pq = 0;
            while pq < 156 {
                push(phys_chars, "I");
                pq = pq + 1;
            }
            q = 0;
            while q < n_qubits {
                phys_chars[physical_qubits[q]] = chars[q];
                q = q + 1;
            }
            let phys_key = str_join(phys_chars, "");
            if map_has(physical_obs, phys_key) {
                physical_obs[phys_key] = physical_obs[phys_key] + coeff;
            } else {
                physical_obs[phys_key] = coeff;
            }
        }
        i = i + 1;
    }
    return map{
        observables: logical_obs,
        physical_observables: physical_obs
    };
}

fn parse_estimator_v2_results(raw_or_map) {
    let parsed = if type(raw_or_map) == "string" {
        json_parse(raw_or_map)
    } else {
        raw_or_map
    };
    let ev_val = nil;
    let std_val = 0.0;
    if is_map(parsed) {
        let arr = if map_has(parsed, "results") and is_array(parsed.results) and len(parsed.results) > 0 {
            parsed.results
        } else if map_has(parsed, "pub_results") and is_array(parsed.pub_results) and len(parsed.pub_results) > 0 {
            parsed.pub_results
        } else {
            nil
        };
        if arr != nil and is_map(arr[0]) {
            let pub0 = arr[0];
            let d = if map_has(pub0, "data") and is_map(pub0.data) { pub0.data } else { pub0 };
            if map_has(d, "evs") {
                ev_val = if is_array(d.evs) and len(d.evs) > 0 { d.evs[0] * 1.0 } else { d.evs * 1.0 };
            }
            if map_has(d, "stds") {
                std_val = if is_array(d.stds) and len(d.stds) > 0 { d.stds[0] * 1.0 } else { d.stds * 1.0 };
            }
        }
    }
    return map{
        ok: ev_val != nil,
        expectation_value: ev_val,
        std_error: std_val
    };
}

fn run_ibm_estimator_v2(circuit, pauli_terms, backend_name = "ibm_fez", opts = nil) {
    let cmap = if is_map(opts) and map_has(opts, "coupling_map") { opts.coupling_map } else { nil };
    let emap = if is_map(opts) and map_has(opts, "cz_error_map") { opts.cz_error_map } else { nil };
    let routed = route_on_heavy_hex_156q(circuit, cmap, emap);
    let isa_qasm = routed.openqasm3_isa_estimator;

    let fmt_obs = format_estimator_v2_observables(circuit.n_qubits, pauli_terms, routed.physical_qubits);
    let obs_map = fmt_obs.observables;

    let precision = if is_map(opts) and map_has(opts, "default_precision") {
        opts.default_precision * 1.0
    } else {
        0.015625
    };
    let resilience_level = if is_map(opts) and map_has(opts, "resilience_level") {
        opts.resilience_level
    } else {
        1
    };

    let pubs = [[isa_qasm, obs_map]];
    let payload = map{
        program_id: "estimator",
        backend: backend_name,
        params: map{
            pubs: pubs,
            options: map{
                default_precision: precision,
                resilience_level: resilience_level
            },
            version: 2
        }
    };

    let want_live = is_map(opts) and map_has(opts, "live") and opts.live == true;
    let api_key = "";
    let crn_val = "";
    if want_live {
        if map_has(opts, "api_token") and type(opts.api_token) == "string" {
            api_key = str_trim(opts.api_token);
        } else if map_has(opts, "api_key") and type(opts.api_key) == "string" {
            api_key = str_trim(opts.api_key);
        } else {
            let env_tok = try env_get("IBM_QUANTUM_API_TOKEN") catch nil;
            if type(env_tok) == "string" and len(str_trim(env_tok)) > 0 {
                api_key = str_trim(env_tok);
            } else {
                let env_k = try env_get("IBM_QUANTUM_API_KEY") catch nil;
                if type(env_k) == "string" and len(str_trim(env_k)) > 0 {
                    api_key = str_trim(env_k);
                }
            }
        }
        if map_has(opts, "crn") and type(opts.crn) == "string" {
            crn_val = str_trim(opts.crn);
        } else {
            let env_c = try env_get("IBM_QUANTUM_CRN") catch nil;
            if type(env_c) == "string" and len(str_trim(env_c)) > 0 {
                crn_val = str_trim(env_c);
            }
        }
    }

    if (not want_live) or len(api_key) == 0 {
        let exact_ev = if circuit.n_qubits <= 20 {
            pauli_expectation_exact(circuit, pauli_terms)
        } else {
            nil
        };
        return map{
            ok: true,
            qpu_submitted: false,
            provider: "ibm_quantum",
            backend: backend_name,
            program_id: "estimator",
            version: 2,
            mode: "local_statevector_estimator_fallback",
            expectation_value: exact_ev,
            std_error: 0.0,
            observables: obs_map,
            physical_observables: fmt_obs.physical_observables,
            pubs: pubs,
            payload: payload,
            physical_qubits: routed.physical_qubits,
            isa_gate_counts: routed.gate_counts,
            openqasm3_isa: isa_qasm
        };
    }

    // Live IBM Quantum Runtime REST v1 EstimatorV2 job submission (OPSEC-scrubbed)
    let secrets_to_scrub = [api_key, crn_val];
    let bearer = try QC.exchange_ibm_iam_token(api_key) catch {
        throw "run_ibm_estimator_v2: IAM token exchange failed (credentials redacted)";
    };
    push(secrets_to_scrub, bearer);

    let endpoint = "https://quantum.cloud.ibm.com/api/v1/jobs";
    let headers = map{
        "Authorization": "Bearer " + bearer,
        "IBM-API-Version": "2025-05-01",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "pblang-quantum/3.0"
    };
    if len(crn_val) > 0 {
        headers["Service-CRN"] = crn_val;
    }

    let body_json = json_stringify(payload);
    let sentinel = "__PBLANG_EST_NO_HTTP__";
    let req_resp = try http_request("POST", endpoint, headers, body_json) catch sentinel;
    let raw_body = if type(req_resp) != "string" or req_resp != sentinel {
        if is_map(req_resp) and map_has(req_resp, "body") { str(req_resp.body) } else { str(req_resp) }
    } else {
        try http_post_auth(endpoint, headers, body_json) catch {
            throw "run_ibm_estimator_v2: POST failed for " + endpoint + " (credentials redacted)";
        }
    };

    let clean_body = _scrub_secrets(raw_body, secrets_to_scrub);
    let parsed_job = try json_parse(clean_body) catch map{ raw: clean_body };
    let job_id = if is_map(parsed_job) and map_has(parsed_job, "id") {
        _scrub_secrets(parsed_job.id, secrets_to_scrub)
    } else if is_map(parsed_job) and map_has(parsed_job, "job_id") {
        _scrub_secrets(parsed_job.job_id, secrets_to_scrub)
    } else {
        ""
    };

    return map{
        ok: len(job_id) > 0,
        qpu_submitted: len(job_id) > 0,
        provider: "ibm_quantum",
        backend: backend_name,
        program_id: "estimator",
        version: 2,
        mode: "ibm_qpu_rest_v1_estimator_v2",
        endpoint: endpoint,
        job_id: job_id,
        observables: obs_map,
        physical_observables: fmt_obs.physical_observables,
        pubs: pubs,
        payload: payload,
        physical_qubits: routed.physical_qubits,
        isa_gate_counts: routed.gate_counts,
        openqasm3_isa: isa_qasm,
        response: parsed_job
    };
}

export cp,
       apply_qft, qft_circuit,
       quantum_phase_estimation,
       shor_factor,
       qaoa_maxcut,
       hhl_linear_solver_2x2,
       pauli_expectation_exact,
       parameter_shift_gradient,
       central_difference_gradient,
       h2_hamiltonian_sto3g,
       build_h2_uccsd_ansatz,
       vqe_h2_molecule,
       heron_r2_156q_heavy_hex_graph,
       route_on_heavy_hex_156q,
       format_estimator_v2_observables,
       parse_estimator_v2_results,
       run_ibm_estimator_v2;
