//        default (blocked_by_cost_firewall: true, estimated_cost_eur: 0.0) unless
//        allow_paid_qpu == true AND max_budget_eur > 0.
//   2. Zero-Secret-Exposure Security Auditor: Checks permissions (0700/0600),
