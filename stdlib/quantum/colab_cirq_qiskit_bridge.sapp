let QC = import("stdlib:quantum_computing.sapp");
let MM = import("stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp");
let QEC = import("stdlib:quantum/qec_stabilizer_1000q.sapp");

let BRIDGE_VERSION = "4.0.0";
let BRIDGE_FORMAT = "pblang.quantum.colab_cirq_qiskit_bridge.v4";
let _PI = 3.14159265358979323846;
let _INV_SQRT2 = 0.70710678118654752440;

// ── Dynamic Environment & Zero-Leak Path Redaction Helpers ──────────────────

fn _home_dir() {
    let h = try env_get("HOME") catch nil;
    if type(h) == "string" and len(str_trim(h)) > 0 {
        return str_trim(h);
    }
    let up = try env_get("USERPROFILE") catch nil;
    if type(up) == "string" and len(str_trim(up)) > 0 {
        return str_trim(up);
    }
    return "";
}

fn redact_sensitive_text(text, redact_paths = true, extra_secrets = nil) {
    let out = str(text);
    if is_array(extra_secrets) {
        let i = 0;
        while i < len(extra_secrets) {
            let s = extra_secrets[i];
            if type(s) == "string" and len(s) >= 4 {
                out = str_replace_all(out, s, "[REDACTED]");
            }
            i = i + 1;
        }
    }
    if redact_paths {
        let home = _home_dir();
        if len(home) > 1 {
            out = str_replace_all(out, home, "$HOME");
        }
        let usr = try env_get("USER") catch nil;
        if type(usr) == "string" and len(str_trim(usr)) >= 3 {
            out = str_replace_all(out, str_trim(usr), "$USER");
        }
    }
    return out;
}

// Safe argv-only subprocess execution (ZERO shell interpolation / ZERO sh -c)
fn process_run(program, args = []) {
    if type(program) != "string" or len(str_trim(program)) == 0 {
        throw "colab_cirq_qiskit_bridge.process_run: program must be a non-empty string";
    }
    if not is_array(args) {
        throw "colab_cirq_qiskit_bridge.process_run: args must be an argv array";
    }
    let p_trim = str_trim(program);
    let banned_shells = ["sh", "/bin/sh", "bash", "/bin/bash", "zsh", "/bin/zsh", "cmd", "cmd.exe", "powershell"];
    let bi = 0;
    while bi < len(banned_shells) {
        if p_trim == banned_shells[bi] {
            throw "colab_cirq_qiskit_bridge.process_run: shell interpreter execution is forbidden";
        }
        bi = bi + 1;
    }
    if str_contains(p_trim, ";") or str_contains(p_trim, "|") or str_contains(p_trim, "&") or str_contains(p_trim, "`") {
        throw "colab_cirq_qiskit_bridge.process_run: shell metacharacters in program path are forbidden";
    }

    let safe_args = [];
    let i = 0;
    while i < len(args) {
        let a = str(args[i]);
        if is_tainted(args[i]) {
            throw "colab_cirq_qiskit_bridge.process_run: tainted secret value rejected at argv sink";
        }
        push(safe_args, a);
        i = i + 1;
    }

    let raw = try proc_spawn_wait(p_trim, safe_args) catch nil;
    if raw == nil {
        return map{
            ok: false,
            exit_code: -1,
            stdout: "",
            stderr: "proc_spawn_wait failed to launch binary"
        };
    }
    let ec = try raw.exit_code catch -1;
    return map{
        ok: ec == 0,
        exit_code: ec,
        stdout: try raw.stdout catch "",
        stderr: try raw.stderr catch ""
    };
}

fn resolve_quantum_colab_paths(redact_paths = false) {
    let home = _home_dir();
    let base = if len(home) > 0 { home } else { "$HOME" };
    let venv_dir = base + "/.local/share/pblang-quantum-colab-env";
    let sandbox_dir = base + "/.local/share/pblang-colab-sandbox";
    let sdk_dir = base + "/.local/share/google-cloud-sdk";
    let bin_dir = base + "/.local/bin";
    let vault_dir = base + "/.config/pblang";

    let raw_map = map{
        venv_dir: venv_dir,
        venv_python: venv_dir + "/bin/python3",
        venv_jupyter: venv_dir + "/bin/jupyter",
        colab_sandbox_dir: sandbox_dir,
        gcloud_sdk_dir: sdk_dir,
        gcloud_bin: bin_dir + "/gcloud",
        config_vault_dir: vault_dir,
        google_env_file: vault_dir + "/google_quantum.env",
        ibm_env_file: vault_dir + "/ibm_quantum.env",
        cli_quantum_doctor: bin_dir + "/pblang-quantum-doctor",
        cli_google_login: bin_dir + "/pblang-google-quantum-login",
        cli_colab_local: bin_dir + "/pblang-colab-local"
    };

    if not redact_paths {
        return raw_map;
    }

    let redacted = map{};
    let ks = map_keys(raw_map);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        redacted[k] = redact_sensitive_text(raw_map[k], true, nil);
        i = i + 1;
    }
    return redacted;
}

fn _stat_mode_octal(path) {
    if type(path) != "string" or len(path) == 0 { return ""; }
    let ex = try fs_exists(path) catch false;
    if not ex { return ""; }
    let stat_bin = if (try fs_exists("/usr/bin/stat") catch false) { "/usr/bin/stat" } else { "stat" };
    let res = process_run(stat_bin, ["-c", "%a", path]);
    if not res.ok { return ""; }
    return str_trim(res.stdout);
}

// ── 1. Zero-Leak Security & Environment Auditor ─────────────────────────────

fn audit_quantum_colab_security(opts = nil) {
    let redact_paths = if is_map(opts) and map_has(opts, "redact_paths") {
        opts.redact_paths == true
    } else {
        true
    };

    let live_paths = resolve_quantum_colab_paths(false);
    let view_paths = resolve_quantum_colab_paths(redact_paths);

    // 1. Audit Google Cloud CLI (gcloud) without network calls or secret reads
    let gcloud_exec = live_paths.gcloud_bin;
    if not (try fs_exists(gcloud_exec) catch false) {
        let fallback_gcloud = live_paths.gcloud_sdk_dir + "/bin/gcloud";
        if (try fs_exists(fallback_gcloud) catch false) {
            gcloud_exec = fallback_gcloud;
        }
    }
    let gcloud_present = try fs_exists(gcloud_exec) catch false;
    let gcloud_version = "";
    let gcloud_telemetry_disabled = false;
    if gcloud_present {
        let ver_res = process_run(gcloud_exec, ["--version"]);
        if ver_res.ok {
            let lines = str_split(ver_res.stdout, "\n");
            if len(lines) > 0 {
                gcloud_version = str_trim(lines[0]);
            }
        }
        let tel_res = process_run(gcloud_exec, ["config", "get-value", "core/disable_usage_reporting"]);
        let tel_val = str_lower(str_trim(tel_res.stdout));
        if tel_val == "true" {
            gcloud_telemetry_disabled = true;
        } else {
            let env_tel = try env_get("CLOUDSDK_CORE_DISABLE_USAGE_REPORTING") catch "";
            if str_lower(str_trim(str(env_tel))) == "true" {
                gcloud_telemetry_disabled = true;
            }
        }
    }

    // 2. Audit Isolated Cirq + Qiskit + Jupyter Python venv (chmod 700, zero stored secrets)
    let venv_present = try fs_exists(live_paths.venv_python) catch false;
    let venv_mode = _stat_mode_octal(live_paths.venv_dir);
    let venv_mode_ok = venv_mode == "700";
    let venv_versions = map{
        cirq: "",
        cirq_google: "",
        qiskit: "",
        qiskit_aer: "",
        notebook: "",
        jupyter_http_over_ws: ""
    };
    let venv_packages_ok = false;
    if venv_present {
        let py_probe = "import json, cirq, cirq_google, qiskit, qiskit_aer, notebook, jupyter_http_over_ws; " +
            "print(json.dumps({'cirq': cirq.__version__, 'cirq_google': cirq_google.__version__, " +
            "'qiskit': qiskit.__version__, 'qiskit_aer': qiskit_aer.__version__, " +
            "'notebook': notebook.__version__, 'jupyter_http_over_ws': getattr(jupyter_http_over_ws, '__version__', 'enabled')}))";
        let py_res = process_run(live_paths.venv_python, ["-c", py_probe]);
        if py_res.ok {
            let parsed = try json_parse(str_trim(py_res.stdout)) catch nil;
            if is_map(parsed) {
                venv_versions = parsed;
                venv_packages_ok = len(str(parsed.cirq)) > 0 and len(str(parsed.qiskit)) > 0 and len(str(parsed.qiskit_aer)) > 0;
            }
        }
    }
    let venv_entries = if (try fs_exists(live_paths.venv_dir) catch false) {
        try fs_listdir(live_paths.venv_dir) catch []
    } else {
        []
    };
    let venv_zero_secrets = true;
    let vi = 0;
    while vi < len(venv_entries) {
        let ename = str_lower(str(venv_entries[vi]));
        if str_ends_with(ename, ".env") or str_contains(ename, "secret") or str_contains(ename, "token") or str_contains(ename, "apikey") {
            venv_zero_secrets = false;
        }
        vi = vi + 1;
    }

    // 3. Audit Colab 127.0.0.1:8888 Local Runtime Sandbox Isolation (chmod 700)
    let sandbox_present = try fs_exists(live_paths.colab_sandbox_dir) catch false;
    let sandbox_mode = _stat_mode_octal(live_paths.colab_sandbox_dir);
    let sandbox_mode_ok = sandbox_mode == "700";
    let home_val = _home_dir();
    let docs_prefix = if len(home_val) > 0 { home_val + "/Documents" } else { "/Documents" };
    let sandbox_outside_docs = not str_starts_with(live_paths.colab_sandbox_dir, docs_prefix);
    let sandbox_has_git = try fs_exists(live_paths.colab_sandbox_dir + "/.git") catch false;
    let sandbox_isolated = sandbox_present and sandbox_mode_ok and sandbox_outside_docs and (not sandbox_has_git);

    // 4. Audit ~/.config/pblang Vault Permissions ONLY (NEVER read file contents!)
    let vault_present = try fs_exists(live_paths.config_vault_dir) catch false;
    let vault_mode = _stat_mode_octal(live_paths.config_vault_dir);
    let vault_mode_ok = vault_mode == "700";
    let google_env_present = try fs_exists(live_paths.google_env_file) catch false;
    let google_env_mode = if google_env_present { _stat_mode_octal(live_paths.google_env_file) } else { "absent" };
    let ibm_env_present = try fs_exists(live_paths.ibm_env_file) catch false;
    let ibm_env_mode = if ibm_env_present { _stat_mode_octal(live_paths.ibm_env_file) } else { "absent" };

    let vault_files_mode_ok = true;
    if google_env_present and google_env_mode != "600" { vault_files_mode_ok = false; }
    if ibm_env_present and ibm_env_mode != "600" { vault_files_mode_ok = false; }

    // 5. Verify Runtime VM TAINT_SECRET Enforcement
    let secret_probe = taint_secret("pblang_ephemeral_taint_verification_probe");
    let taint_active = is_tainted(secret_probe) == true;
    let taint_sink_blocked = false;
    let sink_check = try process_run("/bin/true", [secret_probe]) catch map{ blocked: true };
    if is_map(sink_check) and map_has(sink_check, "blocked") and sink_check.blocked == true {
        taint_sink_blocked = true;
    }

    // 6. CLI Helper Presence & Mode Check
    let doc_present = try fs_exists(live_paths.cli_quantum_doctor) catch false;
    let login_present = try fs_exists(live_paths.cli_google_login) catch false;
    let local_present = try fs_exists(live_paths.cli_colab_local) catch false;

    let overall_ok = gcloud_present and gcloud_telemetry_disabled and
        venv_present and venv_mode_ok and venv_packages_ok and venv_zero_secrets and
        sandbox_isolated and vault_present and vault_mode_ok and vault_files_mode_ok and
        taint_active and taint_sink_blocked;

    return map{
        ok: overall_ok,
        format: BRIDGE_FORMAT,
        bridge_version: BRIDGE_VERSION,
        zero_cost_guaranteed: true,
        estimated_cost_eur: 0.0,
        secrets_read_count: 0,
        redact_paths: redact_paths,
        gcloud: map{
            available: gcloud_present,
            version: gcloud_version,
            telemetry_disabled: gcloud_telemetry_disabled
        },
        python_quantum_venv: map{
            available: venv_present,
            mode_octal: venv_mode,
            mode_0700_ok: venv_mode_ok,
            packages_ok: venv_packages_ok,
            zero_stored_secrets: venv_zero_secrets,
            versions: venv_versions
        },
        colab_local_sandbox: map{
            available: sandbox_present,
            mode_octal: sandbox_mode,
            mode_0700_ok: sandbox_mode_ok,
            outside_documents: sandbox_outside_docs,
            zero_git_repos: not sandbox_has_git,
            isolated: sandbox_isolated,
            bind_host: "127.0.0.1",
            bind_port: 8888,
            allowed_origin: "https://colab.research.google.com"
        },
        config_vault: map{
            available: vault_present,
            mode_octal: vault_mode,
            mode_0700_ok: vault_mode_ok,
            vault_files_0600_ok: vault_files_mode_ok,
            google_quantum_env_present: google_env_present,
            google_quantum_env_mode: google_env_mode,
            ibm_quantum_env_present: ibm_env_present,
            ibm_quantum_env_mode: ibm_env_mode,
            secret_values_inspected: false
        },
        taint_protection: map{
            taint_secret_active: taint_active,
            argv_sink_guard_active: taint_sink_blocked
        },
        cli_helpers: map{
            quantum_doctor_installed: doc_present,
            google_quantum_login_installed: login_present,
            colab_local_installed: local_present
        },
        paths: view_paths
    };
}

// ── 2. Circuit Builders, 1..26q Dense Statevector & Cirq/OpenQASM Exporters ─

fn build_bell_circuit() {
    let c = QC.new_circuit(2);
    QC.h(c, 0);
    QC.cnot(c, 0, 1);
    return c;
}

fn build_ghz_circuit(n_qubits = 3) {
    let c = QC.new_circuit(n_qubits);
    QC.h(c, 0);
    let q = 0;
    while q < n_qubits - 1 {
        QC.cnot(c, q, q + 1);
        q = q + 1;
    }
    return c;
}

// Coherent 3-qubit Quantum Teleportation circuit (prepares Ry(theta)*Rz(phi)|0> on q0,
// Bell pair on (q1, q2), Bell-basis CNOT+H on (q0, q1), and coherent Pauli X/Z frame
// recovery CX(q1, q2) + CZ(q0, q2) transferring the exact quantum state onto q2).
fn build_teleportation_circuit(theta = 0.9, phi = 0.4) {
    let c = QC.new_circuit(3);
    QC.ry(c, 0, theta);
    QC.rz(c, 0, phi);
    QC.h(c, 1);
    QC.cnot(c, 1, 2);
    QC.cnot(c, 0, 1);
    QC.h(c, 0);
    QC.cnot(c, 1, 2);
    QC.cz(c, 0, 2);
    return c;
}

fn is_clifford_circuit(circuit) {
    if not is_map(circuit) or not map_has(circuit, "gates") {
        return false;
    }
    let i = 0;
    while i < len(circuit.gates) {
        let op = circuit.gates[i].op;
        if op != "h" and op != "x" and op != "y" and op != "z" and
           op != "s" and op != "sdg" and op != "sx" and
           op != "cx" and op != "cz" and op != "swap" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _circuit_to_stabilizer_ops(circuit) {
    let ops = [];
    let i = 0;
    while i < len(circuit.gates) {
        let g = circuit.gates[i];
        let op = g.op;
        if op == "cx" {
            push(ops, map{ op: "cnot", q0: g.controls[0], q1: g.targets[0] });
        } else if op == "cz" {
            push(ops, map{ op: "cz", q0: g.controls[0], q1: g.targets[0] });
        } else if op == "swap" {
            push(ops, map{ op: "swap", q0: g.targets[0], q1: g.targets[1] });
        } else {
            push(ops, map{ op: op, q: g.targets[0] });
        }
        i = i + 1;
    }
    let mq = 0;
    while mq < circuit.n_qubits {
        push(ops, map{ op: "measure", q: mq });
        mq = mq + 1;
    }
    return ops;
}

fn _normalize_circuit_spec(circuit_spec) {
    if type(circuit_spec) == "string" {
        let name = str_lower(str_trim(circuit_spec));
        if name == "bell" or name == "bell_2q" {
            return map{ kind: "circuit", circuit: build_bell_circuit(), n_qubits: 2 };
        }
        if name == "ghz" or name == "ghz_3q" {
            return map{ kind: "circuit", circuit: build_ghz_circuit(3), n_qubits: 3 };
        }
        if name == "teleportation" or name == "teleportation_3q" {
            return map{ kind: "circuit", circuit: build_teleportation_circuit(0.9, 0.4), n_qubits: 3 };
        }
        throw "colab_cirq_qiskit_bridge: unknown circuit preset '" + circuit_spec + "'";
    }
    if is_map(circuit_spec) {
        if map_has(circuit_spec, "gates") and map_has(circuit_spec, "n_qubits") {
            return map{ kind: "circuit", circuit: circuit_spec, n_qubits: circuit_spec.n_qubits };
        }
        if map_has(circuit_spec, "ops") and map_has(circuit_spec, "n_qubits") {
            return map{ kind: "stabilizer_ops", ops: circuit_spec.ops, n_qubits: circuit_spec.n_qubits };
        }
        if map_has(circuit_spec, "preset") {
            let p = str_lower(str_trim(str(circuit_spec.preset)));
            let nq = if map_has(circuit_spec, "n_qubits") { num_floor(circuit_spec.n_qubits) } else { 3 };
            if p == "ghz" {
                if nq <= 64 {
                    return map{ kind: "circuit", circuit: build_ghz_circuit(nq), n_qubits: nq };
                }
                return map{ kind: "ghz_stabilizer_fast", n_qubits: nq };
            }
            if p == "bell" {
                return map{ kind: "circuit", circuit: build_bell_circuit(), n_qubits: 2 };
            }
            if p == "teleportation" {
                let th = if map_has(circuit_spec, "theta") { circuit_spec.theta * 1.0 } else { 0.9 };
                let ph = if map_has(circuit_spec, "phi") { circuit_spec.phi * 1.0 } else { 0.4 };
                return map{ kind: "circuit", circuit: build_teleportation_circuit(th, ph), n_qubits: 3 };
            }
        }
    }
    throw "colab_cirq_qiskit_bridge: invalid circuit_spec (expected PBLang circuit map, stabilizer ops map, or preset)";
}

fn to_openqasm3(circuit) {
    return QC.to_openqasm3(circuit);
}

fn to_openqasm2(circuit) {
    let n = circuit.n_qubits;
    let lines = [
        "OPENQASM 2.0;",
        "include \"qelib1.inc\";",
        "qreg q[" + str(n) + "];",
        "creg c[" + str(n) + "];"
    ];
    let i = 0;
    while i < len(circuit.gates) {
        let g = circuit.gates[i];
        let op = g.op;
        if op == "h" or op == "x" or op == "sx" or op == "y" or op == "z" or op == "s" or op == "sdg" or op == "t" or op == "tdg" {
            push(lines, op + " q[" + str(g.targets[0]) + "];");
        } else if op == "rx" or op == "ry" or op == "rz" {
            push(lines, op + "(" + str(g.params[0]) + ") q[" + str(g.targets[0]) + "];");
        } else if op == "cx" or op == "cz" {
            push(lines, op + " q[" + str(g.controls[0]) + "], q[" + str(g.targets[0]) + "];");
        } else if op == "swap" {
            push(lines, "swap q[" + str(g.targets[0]) + "], q[" + str(g.targets[1]) + "];");
        } else if op == "ccx" {
            push(lines, "ccx q[" + str(g.controls[0]) + "], q[" + str(g.controls[1]) + "], q[" + str(g.targets[0]) + "];");
        } else {
            throw "colab_cirq_qiskit_bridge.to_openqasm2: unsupported gate '" + op + "'";
        }
        i = i + 1;
    }
    push(lines, "measure q -> c;");
    return str_join(lines, "\n") + "\n";
}

fn _willow_grid_qubit_for_wire(topo, wire_idx) {
    let gqs = topo.grid_qubits;
    if wire_idx >= 0 and wire_idx < len(gqs) {
        // Prefer central row 6 on Willow 105q (cols 0..14) for contiguous 1D chains when n <= 15
        if wire_idx <= 14 {
            let cid = "6_" + str(wire_idx);
            if map_has(topo.coord_to_id, cid) {
                let qobj = gqs[topo.coord_to_id[cid]];
                return map{ cirq_type: "GridQubit", row: qobj.row, col: qobj.col };
            }
        }
        return map{ cirq_type: "GridQubit", row: gqs[wire_idx].row, col: gqs[wire_idx].col };
    }
    return map{ cirq_type: "GridQubit", row: 0, col: wire_idx };
}

fn _cirq_gate_json_obj(op, params) {
    if op == "h" {
        return map{ cirq_type: "HPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "x" {
        return map{ cirq_type: "XPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "sx" {
        return map{ cirq_type: "XPowGate", exponent: 0.5, global_shift: 0.0 };
    }
    if op == "y" {
        return map{ cirq_type: "YPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "z" {
        return map{ cirq_type: "ZPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "s" {
        return map{ cirq_type: "ZPowGate", exponent: 0.5, global_shift: 0.0 };
    }
    if op == "sdg" {
        return map{ cirq_type: "ZPowGate", exponent: -0.5, global_shift: 0.0 };
    }
    if op == "t" {
        return map{ cirq_type: "ZPowGate", exponent: 0.25, global_shift: 0.0 };
    }
    if op == "tdg" {
        return map{ cirq_type: "ZPowGate", exponent: -0.25, global_shift: 0.0 };
    }
    if op == "rx" {
        return map{ cirq_type: "Rx", rads: params[0] * 1.0 };
    }
    if op == "ry" {
        return map{ cirq_type: "Ry", rads: params[0] * 1.0 };
    }
    if op == "rz" {
        return map{ cirq_type: "Rz", rads: params[0] * 1.0 };
    }
    if op == "cx" {
        return map{ cirq_type: "CXPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "cz" {
        return map{ cirq_type: "CZPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "swap" {
        return map{ cirq_type: "SwapPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    if op == "ccx" {
        return map{ cirq_type: "CCXPowGate", exponent: 1.0, global_shift: 0.0 };
    }
    throw "colab_cirq_qiskit_bridge: unsupported gate '" + op + "' for Cirq JSON export";
}

// Exports 100% genuine cirq.read_json(json_text=...)-compatible Circuit JSON
// placed directly on Google Willow 105q GridQubit(row, col) coordinates!
fn to_cirq_circuit_json(circuit, opts = nil) {
    let topo = MM.google_willow_topology();
    let n = circuit.n_qubits;
    let include_meas = if is_map(opts) and map_has(opts, "include_measurement") {
        opts.include_measurement == true
    } else {
        true
    };

    let q_map = [];
    let q = 0;
    while q < n {
        push(q_map, _willow_grid_qubit_for_wire(topo, q));
        q = q + 1;
    }

    let moments = [];
    let i = 0;
    while i < len(circuit.gates) {
        let g = circuit.gates[i];
        let op = g.op;
        let q_list = [];
        let ci = 0;
        while ci < len(g.controls) {
            push(q_list, q_map[g.controls[ci]]);
            ci = ci + 1;
        }
        let ti = 0;
        while ti < len(g.targets) {
            push(q_list, q_map[g.targets[ti]]);
            ti = ti + 1;
        }
        let gate_obj = _cirq_gate_json_obj(op, g.params);
        push(moments, map{
            cirq_type: "Moment",
            operations: [map{
                cirq_type: "GateOperation",
                gate: gate_obj,
                qubits: q_list
            }]
        });
        i = i + 1;
    }

    if include_meas {
        push(moments, map{
            cirq_type: "Moment",
            operations: [map{
                cirq_type: "GateOperation",
                gate: map{
                    cirq_type: "MeasurementGate",
                    num_qubits: n,
                    key: "m",
                    invert_mask: []
                },
                qubits: q_map
            }]
        });
    }

    return json_stringify(map{
        cirq_type: "Circuit",
        moments: moments
    });
}

fn to_google_willow_cirq_v2_json(circuit, grid_coords = nil) {
    return MM.to_google_willow_cirq_v2(circuit, grid_coords);
}

fn _normalize_distribution(probs_or_counts) {
    let out = map{};
    if not is_map(probs_or_counts) { return out; }
    let ks = map_keys(probs_or_counts);
    let total = 0.0;
    let i = 0;
    while i < len(ks) {
        let v = probs_or_counts[ks[i]] * 1.0;
        if v > 0.0 {
            total = total + v;
        }
        i = i + 1;
    }
    if total <= 0.0 { return out; }
    i = 0;
    while i < len(ks) {
        let k = ks[i];
        let v2 = probs_or_counts[k] * 1.0;
        if v2 > 0.0 {
            out[k] = v2 / total;
        }
        i = i + 1;
    }
    return out;
}

// Exact Classical Hellinger Fidelity: F_H(P, Q) = (sum_x sqrt(P(x) * Q(x)))^2
fn compute_hellinger_fidelity(dist_a, dist_b) {
    let pa = _normalize_distribution(dist_a);
    let pb = _normalize_distribution(dist_b);
    let seen = map{};
    let keys = [];

    let ka = map_keys(pa);
    let i = 0;
    while i < len(ka) {
        seen[ka[i]] = true;
        push(keys, ka[i]);
        i = i + 1;
    }
    let kb = map_keys(pb);
    i = 0;
    while i < len(kb) {
        if not map_has(seen, kb[i]) {
            seen[kb[i]] = true;
            push(keys, kb[i]);
        }
        i = i + 1;
    }

    let bc = 0.0;
    i = 0;
    while i < len(keys) {
        let k = keys[i];
        let va = if map_has(pa, k) { pa[k] } else { 0.0 };
        let vb = if map_has(pb, k) { pb[k] } else { 0.0 };
        if va > 0.0 and vb > 0.0 {
            bc = bc + num_sqrt(va * vb);
        }
        i = i + 1;
    }
    let fid = bc * bc;
    if fid > 1.0 and fid < 1.000000001 { fid = 1.0; }
    return fid;
}

// ── 3. 4-Tier Minimum-Cost / Maximum-Fidelity Quantum Policy & Executor ─────

fn _is_paid_target_name(target_str) {
    if len(target_str) == 0 { return false; }
    let t = str_lower(str_trim(target_str));
    if str_contains(t, "paid") or str_contains(t, "braket") or str_contains(t, "reservation") {
        return true;
    }
    if t == "google_quantum_engine_cloud" or t == "google_willow_cloud" or
       t == "ionq_aria_cloud" or t == "ionq_forte_cloud" or t == "ibm_premium_qpu" {
        return true;
    }
    return false;
}

fn cost_optimized_quantum_policy(opts = nil) {
    let allow_paid = if is_map(opts) and map_has(opts, "allow_paid_qpu") {
        opts.allow_paid_qpu == true
    } else {
        false
    };
    let max_budget = if is_map(opts) and map_has(opts, "max_budget_eur") and type(opts.max_budget_eur) == "number" {
        opts.max_budget_eur * 1.0
    } else {
        0.0
    };
    let target = if is_map(opts) and map_has(opts, "target") {
        str_trim(str(opts.target))
    } else {
        "auto_sovereign_zero_cost"
    };
    let req_tier = if is_map(opts) and map_has(opts, "tier") {
        str_lower(str_trim(str(opts.tier)))
    } else {
        "auto"
    };
    let cross_verify = if is_map(opts) and (map_has(opts, "cross_verify") or map_has(opts, "verify_cirq_qiskit")) {
        (map_has(opts, "cross_verify") and opts.cross_verify == true) or
        (map_has(opts, "verify_cirq_qiskit") and opts.verify_cirq_qiskit == true)
    } else {
        false
    };
    let explicit_consent = if is_map(opts) {
        (map_has(opts, "consent") and opts.consent == true) or
        (map_has(opts, "user_consent") and opts.user_consent == true) or
        (map_has(opts, "explicit_consent") and opts.explicit_consent == true)
    } else {
        false
    };

    let selected_tier = 0;
    let selected_tier_name = "tier0_native_pblang";
    if _is_paid_target_name(target) or req_tier == "3" or req_tier == "tier3" or req_tier == "paid_qpu" {
        selected_tier = 3;
        selected_tier_name = "tier3_paid_qpu_firewall";
    } else if req_tier == "2" or req_tier == "tier2" or req_tier == "free_cloud" or
              target == "colab_free_t4" or target == "ibm_open_plan_free" or target == "qutech_tuna17_free" {
        selected_tier = 2;
        selected_tier_name = "tier2_free_cloud";
    } else if cross_verify or req_tier == "1" or req_tier == "tier1" or req_tier == "local_oracle" or
              req_tier == "cross_verify" or target == "local_cirq_qiskit" or target == "cirq_qiskit_oracle" {
        selected_tier = 1;
        selected_tier_name = "tier1_local_cirq_qiskit_oracle";
    }

    let paid_authorized = allow_paid and (max_budget > 0.0);
    let blocked_by_firewall = (selected_tier == 3) and (not paid_authorized);

    return map{
        format: "pblang.quantum.cost_policy.v4",
        sovereign_default_cost_eur: 0.0,
        selected_tier: selected_tier,
        selected_tier_name: selected_tier_name,
        target: target,
        allow_paid_qpu: allow_paid,
        max_budget_eur: max_budget,
        paid_qpu_authorized: paid_authorized,
        blocked_by_cost_firewall: blocked_by_firewall,
        explicit_cloud_consent: explicit_consent,
        estimated_cost_eur: 0.0,
        thresholds: map{
            tier0_max_dense_qubits: 26,
            tier0_max_clifford_qubits: 1000,
            tier0_willow_qvm_qubits: 105,
            tier0_latency_target_ms: 5.0,
            tier1_min_hellinger_fidelity: 0.99
        },
        tiers: [
            map{
                tier: 0,
                id: "tier0_native_pblang",
                cost_eur: 0.0,
                latency_target_ms: 5.0,
                description: "Native PBLang Statevector (<= 26q), 1000q Aaronson-Gottesman Stabilizer, & Google Willow 105q QVM"
            },
            map{
                tier: 1,
                id: "tier1_local_cirq_qiskit_oracle",
                cost_eur: 0.0,
                min_hellinger_fidelity: 0.99,
                description: "Local Isolated Python Venv Cross-Verification Oracle: PBLang <-> Google Cirq <-> IBM Qiskit Aer"
            },
            map{
                tier: 2,
                id: "tier2_free_cloud",
                cost_eur: 0.0,
                requires_explicit_consent: true,
                description: "Free Cloud Tier: Google Colab Free T4 GPU / IBM Open Plan 10-min Free Quota / QuTech Tuna-17 Free Tier"
            },
            map{
                tier: 3,
                id: "tier3_paid_qpu_firewall",
                blocked_by_default: true,
                requires_allow_paid_qpu: true,
                requires_positive_max_budget_eur: true,
                description: "Hard Paid-Cost Firewall blocking Google Cloud Quantum Engine paid reservations, AWS Braket, & IonQ paid shots"
            }
        ]
    };
}

fn _execute_tier1_local_cirq_qiskit_oracle(circuit, shots, seed, policy, t0_ms) {
    let n = circuit.n_qubits;
    if n > 20 {
        throw "colab_cirq_qiskit_bridge: Tier 1 3-way dense statevector/shot oracle supports 1..20 qubits, got " + str(n);
    }

    // 1. Native PBLang execution + Willow 105q ISA verification
    let pb_probs = QC.probabilities(circuit).by_bitstring;
    let pb_sample = QC.sample_shots(circuit, shots, seed);
    let pb_counts = pb_sample.counts;
    let willow_circ = MM.transpile_to_google_willow(circuit);
    let willow_eq = MM.verify_google_willow_equivalence(circuit, willow_circ);
    let willow_cirq_v2_json = MM.to_google_willow_cirq_v2(willow_circ);

    // 2. Export genuine Cirq Circuit JSON (on Willow GridQubits) + OpenQASM 3.0 & 2.0
    let cirq_json_meas = to_cirq_circuit_json(circuit, map{ include_measurement: true });
    let cirq_json_nomeas = to_cirq_circuit_json(circuit, map{ include_measurement: false });
    let openqasm3_str = to_openqasm3(circuit);
    let openqasm2_str = to_openqasm2(circuit);

    // 3. Execute BOTH real Google Cirq Simulator & real IBM Qiskit AerSimulator
    //    inside $HOME/.local/share/pblang-quantum-colab-env via safe argv process_run!
    let live_paths = resolve_quantum_colab_paths(false);
    if not (try fs_exists(live_paths.venv_python) catch false) {
        throw "colab_cirq_qiskit_bridge: isolated quantum venv python not found at $HOME/.local/share/pblang-quantum-colab-env/bin/python3";
    }

    let req_payload = json_stringify(map{
        n_qubits: n,
        shots: shots,
        seed: seed,
        cirq_json_meas: cirq_json_meas,
        cirq_json_nomeas: cirq_json_nomeas,
        openqasm3: openqasm3_str,
        openqasm2: openqasm2_str
    });

    let py_oracle_script =
        "import sys, json, cirq, numpy as np\n" +
        "from qiskit import QuantumCircuit\n" +
        "from qiskit_aer import AerSimulator\n" +
        "req = json.loads(sys.argv[1])\n" +
        "n = int(req['n_qubits'])\n" +
        "shots = int(req['shots'])\n" +
        "seed = int(req['seed'])\n" +
        "c_meas = cirq.read_json(json_text=req['cirq_json_meas'])\n" +
        "c_nomeas = cirq.read_json(json_text=req['cirq_json_nomeas'])\n" +
        "csim = cirq.Simulator(seed=seed)\n" +
        "cres = csim.run(c_meas, repetitions=shots)\n" +
        "cirq_counts = {}\n" +
        "for row in cres.measurements['m']:\n" +
        "    bs = ''.join(str(int(b)) for b in row)\n" +
        "    cirq_counts[bs] = cirq_counts.get(bs, 0) + 1\n" +
        "qorder = [cirq.GridQubit(6, i) if i <= 14 else sorted(c_nomeas.all_qubits())[i] for i in range(n)]\n" +
        "sv_cirq = csim.simulate(c_nomeas, qubit_order=qorder).final_state_vector\n" +
        "cirq_probs = {}\n" +
        "for idx, amp in enumerate(sv_cirq):\n" +
        "    p = float((amp.real * amp.real) + (amp.imag * amp.imag))\n" +
        "    if p > 1e-15:\n" +
        "        cirq_probs[format(idx, '0' + str(n) + 'b')] = p\n" +
        "try:\n" +
        "    import qiskit.qasm3 as qasm3_mod\n" +
        "    qc_meas = qasm3_mod.loads(req['openqasm3'])\n" +
        "    qasm_used = 'openqasm3'\n" +
        "except Exception:\n" +
        "    qc_meas = QuantumCircuit.from_qasm_str(req['openqasm2'])\n" +
        "    qasm_used = 'openqasm2'\n" +
        "aer = AerSimulator(seed_simulator=seed + 7)\n" +
        "qres = aer.run(qc_meas, shots=shots).result().get_counts()\n" +
        "qiskit_counts = {}\n" +
        "for k, v in qres.items():\n" +
        "    bs = k.replace(' ', '')[::-1]\n" +
        "    qiskit_counts[bs] = qiskit_counts.get(bs, 0) + int(v)\n" +
        "qc_sv = qc_meas.remove_final_measurements(inplace=False)\n" +
        "qc_sv.save_statevector()\n" +
        "sv_q = np.asarray(AerSimulator(method='statevector').run(qc_sv).result().get_statevector(qc_sv))\n" +
        "qiskit_probs = {}\n" +
        "for idx, amp in enumerate(sv_q):\n" +
        "    p = float((amp.real * amp.real) + (amp.imag * amp.imag))\n" +
        "    if p > 1e-15:\n" +
        "        bs_le = format(idx, '0' + str(n) + 'b')[::-1]\n" +
        "        qiskit_probs[bs_le] = p\n" +
        "print(json.dumps({'ok': True, 'cirq_version': cirq.__version__, 'qasm_dialect': qasm_used, " +
        "'cirq_counts': cirq_counts, 'cirq_probs': cirq_probs, 'qiskit_counts': qiskit_counts, 'qiskit_probs': qiskit_probs}))\n";

    let proc_res = process_run(live_paths.venv_python, ["-c", py_oracle_script, req_payload]);
    if not proc_res.ok {
        let safe_err = redact_sensitive_text(proc_res.stderr, true, nil);
        throw "colab_cirq_qiskit_bridge: Tier 1 Cirq/Qiskit oracle failed: " + safe_err;
    }

    let oracle_out = json_parse(str_trim(proc_res.stdout));
    let cirq_counts = oracle_out.cirq_counts;
    let cirq_probs = oracle_out.cirq_probs;
    let qiskit_counts = oracle_out.qiskit_counts;
    let qiskit_probs = oracle_out.qiskit_probs;

    // 3-Way Shot-Sampled & Exact Statevector Hellinger Fidelities
    let fid_pb_cirq = compute_hellinger_fidelity(pb_probs, cirq_counts);
    let fid_pb_qiskit = compute_hellinger_fidelity(pb_probs, qiskit_counts);
    let fid_cirq_qiskit = compute_hellinger_fidelity(cirq_counts, qiskit_counts);

    let min_3way = fid_pb_cirq;
    if fid_pb_qiskit < min_3way { min_3way = fid_pb_qiskit; }
    if fid_cirq_qiskit < min_3way { min_3way = fid_cirq_qiskit; }

    let exact_pb_cirq = compute_hellinger_fidelity(pb_probs, cirq_probs);
    let exact_pb_qiskit = compute_hellinger_fidelity(pb_probs, qiskit_probs);
    let exact_cirq_qiskit = compute_hellinger_fidelity(cirq_probs, qiskit_probs);

    let elapsed_ms = now_ms() - t0_ms;

    if min_3way < 0.99 {
        throw "colab_cirq_qiskit_bridge: 3-way Hellinger fidelity below 0.99 threshold: " + str(min_3way);
    }

    return map{
        ok: true,
        tier: 1,
        tier_name: "tier1_local_cirq_qiskit_oracle",
        engine: "pblang_cirq_qiskit_3way_oracle",
        blocked_by_cost_firewall: false,
        estimated_cost_eur: 0.0,
        actual_cost_eur: 0.0,
        elapsed_ms: elapsed_ms,
        n_qubits: n,
        shots: shots,
        qasm_dialect_executed: oracle_out.qasm_dialect,
        willow_isa_unitary_fidelity: willow_eq.fidelity,
        willow_grid_qubits_used: willow_circ.grid_qubits_used,
        pblang_probabilities: pb_probs,
        pblang_counts: pb_counts,
        cirq_probabilities: cirq_probs,
        cirq_counts: cirq_counts,
        qiskit_probabilities: qiskit_probs,
        qiskit_counts: qiskit_counts,
        hellinger_fidelity_pblang_cirq: fid_pb_cirq,
        hellinger_fidelity_pblang_qiskit: fid_pb_qiskit,
        hellinger_fidelity_cirq_qiskit: fid_cirq_qiskit,
        min_3way_hellinger_fidelity: min_3way,
        hellinger_fidelity: min_3way,
        exact_statevector_fidelity_pblang_cirq: exact_pb_cirq,
        exact_statevector_fidelity_pblang_qiskit: exact_pb_qiskit,
        exact_statevector_fidelity_cirq_qiskit: exact_cirq_qiskit,
        exports: map{
            cirq_circuit_json: cirq_json_meas,
            willow_cirq_v2_json: willow_cirq_v2_json,
            openqasm3: openqasm3_str,
            openqasm2: openqasm2_str
        },
        policy: policy
    };
}

fn _run_dense_sv_21_to_26q(circuit) {
    let n = circuit.n_qubits;
    let dim = bit_shl(1, n);
    let sv = [];
    let i = 0;
    while i < dim {
        push(sv, [0.0, 0.0]);
        i = i + 1;
    }
    sv[0][0] = 1.0;
    let g = 0;
    while g < len(circuit.gates) {
        let gate = circuit.gates[g];
        let op = gate.op;
        if op == "cx" {
            let mc = bit_shl(1, n - 1 - gate.controls[0]);
            let mt = bit_shl(1, n - 1 - gate.targets[0]);
            let idx = 0;
            while idx < dim {
                if bit_and(idx, mc) != 0 and bit_and(idx, mt) == 0 {
                    let j = bit_or(idx, mt);
                    let tmp = sv[idx];
                    sv[idx] = sv[j];
                    sv[j] = tmp;
                }
                idx = idx + 1;
            }
        } else if op == "cz" {
            let both = bit_or(bit_shl(1, n - 1 - gate.controls[0]), bit_shl(1, n - 1 - gate.targets[0]));
            let idx2 = 0;
            while idx2 < dim {
                if bit_and(idx2, both) == both {
                    sv[idx2][0] = 0.0 - sv[idx2][0];
                    sv[idx2][1] = 0.0 - sv[idx2][1];
                }
                idx2 = idx2 + 1;
            }
        } else if op == "h" {
            let mask = bit_shl(1, n - 1 - gate.targets[0]);
            let idx3 = 0;
            while idx3 < dim {
                if bit_and(idx3, mask) == 0 {
                    let j3 = bit_or(idx3, mask);
                    let a0r = sv[idx3][0]; let a0i = sv[idx3][1];
                    let a1r = sv[j3][0]; let a1i = sv[j3][1];
                    sv[idx3][0] = (a0r + a1r) * _INV_SQRT2;
                    sv[idx3][1] = (a0i + a1i) * _INV_SQRT2;
                    sv[j3][0] = (a0r - a1r) * _INV_SQRT2;
                    sv[j3][1] = (a0i - a1i) * _INV_SQRT2;
                }
                idx3 = idx3 + 1;
            }
        } else {
            throw "colab_cirq_qiskit_bridge: 21..26q dense engine supports h/cx/cz; use stabilizer_1000q for >20q Clifford circuits";
        }
        g = g + 1;
    }
    return map{ ok: true, n_qubits: n, dimension: dim, amplitudes: sv };
}

fn smart_quantum_execute(circuit_spec, opts = nil) {
    let t0_ms = now_ms();
    let policy = cost_optimized_quantum_policy(opts);
    let shots = if is_map(opts) and map_has(opts, "shots") { num_floor(opts.shots) } else { 4096 };
    let seed = if is_map(opts) and map_has(opts, "seed") { num_floor(opts.seed) } else { 20261114 };

    // TIER 3: HARD PAID-COST FIREWALL (strictly blocks paid cloud QPUs by default!)
    if policy.selected_tier == 3 {
        if policy.blocked_by_cost_firewall {
            return map{
                ok: false,
                tier: 3,
                tier_name: "tier3_paid_qpu_firewall",
                target: policy.target,
                blocked_by_cost_firewall: true,
                allow_paid_qpu: policy.allow_paid_qpu,
                max_budget_eur: policy.max_budget_eur,
                estimated_cost_eur: 0.0,
                actual_cost_eur: 0.0,
                elapsed_ms: now_ms() - t0_ms,
                reason: "HARD PAID-COST FIREWALL: Paid cloud QPU target '" + policy.target +
                    "' is strictly blocked by default under the 0.00 EUR sovereign policy. " +
                    "Explicit allow_paid_qpu: true AND max_budget_eur > 0 are required.",
                policy: policy
            };
        }
        // Even if explicitly authorized with max_budget_eur > 0, enforce dry-run budget cap unless live QPU callback supplied
        let est_shot_cost_eur = 0.01 * shots;
        if est_shot_cost_eur > policy.max_budget_eur {
            return map{
                ok: false,
                tier: 3,
                tier_name: "tier3_paid_qpu_firewall",
                target: policy.target,
                blocked_by_cost_firewall: true,
                allow_paid_qpu: true,
                max_budget_eur: policy.max_budget_eur,
                estimated_cost_eur: 0.0,
                required_budget_eur: est_shot_cost_eur,
                actual_cost_eur: 0.0,
                reason: "HARD PAID-COST FIREWALL: Estimated QPU shot cost (" + str(est_shot_cost_eur) +
                    " EUR) exceeds max_budget_eur (" + str(policy.max_budget_eur) + " EUR); execution aborted at 0.00 EUR."
            };
        }
        return map{
            ok: false,
            tier: 3,
            tier_name: "tier3_paid_qpu_firewall",
            target: policy.target,
            blocked_by_cost_firewall: false,
            dry_run_guard: true,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            reason: "Paid QPU submission intentionally halted before network egress to preserve 0.00 EUR workstation guarantee."
        };
    }

    let norm = _normalize_circuit_spec(circuit_spec);

    // TIER 2: FREE CLOUD TIER (0.00 EUR, requires explicit user consent!)
    if policy.selected_tier == 2 {
        if not policy.explicit_cloud_consent {
            return map{
                ok: false,
                tier: 2,
                tier_name: "tier2_free_cloud",
                target: policy.target,
                blocked_by_cost_firewall: false,
                blocked_by_consent_gate: true,
                estimated_cost_eur: 0.0,
                actual_cost_eur: 0.0,
                reason: "Tier 2 Free Cloud execution requires explicit user consent (opts.consent: true).",
                policy: policy
            };
        }
        let c2 = norm.circuit;
        let pb_p2 = QC.probabilities(c2).by_bitstring;
        return map{
            ok: true,
            tier: 2,
            tier_name: "tier2_free_cloud",
            target: policy.target,
            blocked_by_cost_firewall: false,
            blocked_by_consent_gate: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: c2.n_qubits,
            free_cloud_bundle: map{
                colab_gpu_tier: "free_nvidia_t4",
                ibm_open_plan_quota: "10_min_monthly_free",
                qutech_quantum_inspire_tier: "tuna17_free_research",
                cirq_circuit_json: to_cirq_circuit_json(c2),
                willow_cirq_v2_json: to_google_willow_cirq_v2_json(c2),
                openqasm3: to_openqasm3(c2)
            },
            pblang_reference_probabilities: pb_p2,
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    // TIER 1: LOCAL CIRQ + QISKIT CROSS-VERIFICATION ORACLE (0.00 EUR)
    if policy.selected_tier == 1 {
        if norm.kind != "circuit" {
            throw "colab_cirq_qiskit_bridge: Tier 1 Cirq/Qiskit cross-verification requires a gate circuit";
        }
        return _execute_tier1_local_cirq_qiskit_oracle(norm.circuit, shots, seed, policy, t0_ms);
    }

    // TIER 0: NATIVE PBLANG (0.00 EUR, < 5 ms Default: Statevector <= 26q / 1000q Stabilizer / Willow 105q QVM)
    let engine_pref = if is_map(opts) and map_has(opts, "engine") {
        str_lower(str_trim(str(opts.engine)))
    } else {
        "auto"
    };

    if norm.kind == "ghz_stabilizer_fast" {
        if norm.n_qubits > 1000 {
            throw "colab_cirq_qiskit_bridge: Tier 0 Clifford Stabilizer policy cap is 1000 qubits, got " + str(norm.n_qubits);
        }
        let ghz_tab = QEC.benchmark_ghz_1000q(norm.n_qubits, nil, seed);
        return map{
            ok: ghz_tab.ok,
            tier: 0,
            tier_name: "tier0_native_pblang",
            engine: "pblang_stabilizer_1000q",
            blocked_by_cost_firewall: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: norm.n_qubits,
            words_per_row: ghz_tab.words_per_row,
            q0_outcome: ghz_tab.q0.outcome,
            q_last_outcome: ghz_tab.q_last.outcome,
            is_deterministic: false,
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    if norm.kind == "stabilizer_ops" {
        if norm.n_qubits > 1000 {
            throw "colab_cirq_qiskit_bridge: Tier 0 Clifford Stabilizer policy cap is 1000 qubits, got " + str(norm.n_qubits);
        }
        let stab_res = QEC.simulate_clifford_circuit(norm.n_qubits, norm.ops, shots, seed);
        return map{
            ok: true,
            tier: 0,
            tier_name: "tier0_native_pblang",
            engine: "pblang_stabilizer_1000q",
            blocked_by_cost_firewall: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: norm.n_qubits,
            shots: shots,
            counts: stab_res.counts,
            support_rank: stab_res.support_rank,
            is_deterministic: stab_res.support_rank == 0,
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    let circ = norm.circuit;
    let nq = circ.n_qubits;

    if engine_pref == "willow_qvm" or engine_pref == "google_qvm" {
        let qvm_res = MM.run_google_qvm(circ, "willow_105q", shots, opts);
        return map{
            ok: true,
            tier: 0,
            tier_name: "tier0_native_pblang",
            engine: "google_willow_105q_qvm",
            blocked_by_cost_firewall: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: nq,
            shots: shots,
            counts: qvm_res.qvm_counts,
            probabilities: qvm_res.qvm_probabilities,
            ideal_probabilities: qvm_res.ideal_probs,
            hellinger_fidelity: qvm_res.hellinger_fidelity,
            grid_qubits_used: qvm_res.grid_qubits_used,
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    if engine_pref == "stabilizer_1000q" or (nq > 20 and is_clifford_circuit(circ) and nq <= 1000) {
        let s_ops = _circuit_to_stabilizer_ops(circ);
        let s_res = QEC.simulate_clifford_circuit(nq, s_ops, shots, seed);
        return map{
            ok: true,
            tier: 0,
            tier_name: "tier0_native_pblang",
            engine: "pblang_stabilizer_1000q",
            blocked_by_cost_firewall: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: nq,
            shots: shots,
            counts: s_res.counts,
            support_rank: s_res.support_rank,
            is_deterministic: s_res.support_rank == 0,
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    if nq > 26 {
        throw "colab_cirq_qiskit_bridge: non-Clifford dense circuit with n_qubits=" + str(nq) + " exceeds Tier 0 26-qubit dense limit";
    }

    if nq <= 20 {
        let sv_res = QC.run_statevector(circ);
        let probs = QC.probabilities(sv_res).by_bitstring;
        let sampled = QC.sample_shots(circ, shots, seed);
        let fid0 = compute_hellinger_fidelity(probs, sampled.counts);
        return map{
            ok: true,
            tier: 0,
            tier_name: "tier0_native_pblang",
            engine: "pblang_dense_statevector",
            blocked_by_cost_firewall: false,
            estimated_cost_eur: 0.0,
            actual_cost_eur: 0.0,
            n_qubits: nq,
            shots: shots,
            probabilities: probs,
            counts: sampled.counts,
            hellinger_fidelity: fid0,
            exports: map{
                cirq_circuit_json: to_cirq_circuit_json(circ),
                openqasm3: to_openqasm3(circ)
            },
            elapsed_ms: now_ms() - t0_ms,
            policy: policy
        };
    }

    let sv_big = _run_dense_sv_21_to_26q(circ);
    return map{
        ok: true,
        tier: 0,
        tier_name: "tier0_native_pblang",
        engine: "pblang_dense_statevector_26q",
        blocked_by_cost_firewall: false,
        estimated_cost_eur: 0.0,
        actual_cost_eur: 0.0,
        n_qubits: nq,
        dimension: sv_big.dimension,
        elapsed_ms: now_ms() - t0_ms,
        policy: policy
    };
}

// ── 4. Pure-PBLang Pretty JSON Formatter & Colab GPU Notebook Generator ─────

fn _indent_spaces(depth) {
    let s = "";
    let i = 0;
    while i < depth {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

fn _sort_strings(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) {
        push(out, arr[i]);
        i = i + 1;
    }
    let a = 1;
    while a < len(out) {
        let key = out[a];
        let b = a - 1;
        while b >= 0 and out[b] > key {
            out[b + 1] = out[b];
            b = b - 1;
        }
        out[b + 1] = key;
        a = a + 1;
    }
    return out;
}

fn _json_pretty(val, depth = 0) {
    if val == nil { return "null"; }
    let t = type(val);
    if t == "bool" or t == "boolean" {
        return if val { "true" } else { "false" };
    }
    if t == "number" {
        return json_stringify(val);
    }
    if t == "string" {
        return json_stringify(val);
    }
    if is_array(val) {
        if len(val) == 0 { return "[]"; }
        let items = [];
        let i = 0;
        let child_pad = _indent_spaces(depth + 1);
        while i < len(val) {
            push(items, child_pad + _json_pretty(val[i], depth + 1));
            i = i + 1;
        }
        return "[\n" + str_join(items, ",\n") + "\n" + _indent_spaces(depth) + "]";
    }
    if is_map(val) {
        let ks = _sort_strings(map_keys(val));
        if len(ks) == 0 { return "{}"; }
        let pairs = [];
        let j = 0;
        let child_pad2 = _indent_spaces(depth + 1);
        while j < len(ks) {
            let k = ks[j];
            push(pairs, child_pad2 + json_stringify(k) + ": " + _json_pretty(val[k], depth + 1));
            j = j + 1;
        }
        return "{\n" + str_join(pairs, ",\n") + "\n" + _indent_spaces(depth) + "}";
    }
    return json_stringify(val);
}

fn _nb_lines(lines_arr) {
    let out = [];
    let n = len(lines_arr);
    let i = 0;
    while i < n {
        if i + 1 < n {
            push(out, lines_arr[i] + "\n");
        } else {
            push(out, lines_arr[i]);
        }
        i = i + 1;
    }
    return out;
}

fn _md_cell(cell_id, lines_arr) {
    return map{
        cell_type: "markdown",
        id: cell_id,
        metadata: map{},
        source: _nb_lines(lines_arr)
    };
}

fn _code_cell(cell_id, lines_arr) {
    return map{
        cell_type: "code",
        execution_count: nil,
        id: cell_id,
        metadata: map{},
        outputs: [],
        source: _nb_lines(lines_arr)
    };
}

// Pure-PBLang generator for examples/quantum_ai/pblang_v4_colab_gpu_cirq_qiskit.ipynb
fn generate_colab_gpu_notebook_json(opts = nil) {
    let cells = [
        _md_cell("pblang-v4-intro-md", [
            "# PBLang v4.0 — Sovereign Zero-Cost (`0.00 EUR`) Colab Free T4 GPU + Google `Cirq` (`Willow 105q`) + IBM `Qiskit` Bridge",
            "",
            "This notebook runs cleanly in **either**:",
            "1. **Google Colab Free Tier (`NVIDIA T4` CUDA GPU — `0.00 EUR`)**, or",
            "2. **Sovereign Local Loopback Sandbox (`pblang-colab-local` bound strictly to `127.0.0.1:8888` inside `$HOME/.local/share/pblang-colab-sandbox` with `0700` filesystem isolation)**.",
            "",
            "### Mandatory Security & Cost Invariants",
            "- **Cryptographic Release Integrity**: `PBLang` Linux `x86_64` binaries downloaded from `https://github.com/PanosBiazis/pblang/releases/latest` are **cryptographically verified against `SHA256SUMS.txt` BEFORE `chmod +x`**.",
            "- **Zero Hardcoded Secrets**: Optional cloud tokens are read **exclusively** via `from google.colab import userdata` and never printed or stored in notebook cells.",
            "- **Hard Paid-Cost Firewall (`0.00 EUR`)**: Paid QPU reservations are strictly blocked by default (`allow_paid_qpu: false`)."
        ]),

        _md_cell("pblang-v4-install-md", [
            "## 1. Download `PBLang` Linux `x86_64` Release + Mandatory `SHA256SUMS.txt` Verification"
        ]),

        _code_cell("pblang-v4-install-code", [
            "import hashlib",
            "import json",
            "import os",
            "import pathlib",
            "import shutil",
            "import subprocess",
            "import tarfile",
            "import urllib.request",
            "",
            "RELEASE_API_URL = 'https://api.github.com/repos/PanosBiazis/pblang/releases/latest'",
            "INSTALL_DIR = pathlib.Path.home() / '.local' / 'pblang-colab-runtime'",
            "INSTALL_DIR.mkdir(parents=True, exist_ok=True)",
            "",
            "def _https_download(url: str, dest: pathlib.Path) -> None:",
            "    if not url.startswith('https://'):",
            "        raise ValueError(f'Refusing non-HTTPS URL: {url}')",
            "    req = urllib.request.Request(url, headers={'User-Agent': 'PBLang-Colab-Verifier/4.0'})",
            "    with urllib.request.urlopen(req, timeout=60) as resp:",
            "        dest.write_bytes(resp.read())",
            "",
            "def install_or_locate_verified_pblang() -> pathlib.Path:",
            "    existing = shutil.which('pblang') or str(pathlib.Path.home() / '.local' / 'bin' / 'pblang')",
            "    if existing and pathlib.Path(existing).exists():",
            "        ver = subprocess.run([existing, '--version'], capture_output=True, text=True, check=True)",
            "        print('Using local verified PBLang binary:', ver.stdout.strip())",
            "        return pathlib.Path(existing)",
            "",
            "    req = urllib.request.Request(RELEASE_API_URL, headers={'User-Agent': 'PBLang-Colab-Verifier/4.0'})",
            "    with urllib.request.urlopen(req, timeout=30) as resp:",
            "        release = json.loads(resp.read().decode('utf-8'))",
            "",
            "    assets = {a['name']: a['browser_download_url'] for a in release.get('assets', [])}",
            "    sums_name = next((n for n in assets if n in ('SHA256SUMS.txt', 'SHA256SUMS')), None)",
            "    if not sums_name:",
            "        raise RuntimeError('Mandatory SHA256SUMS.txt asset missing from GitHub release — refusing unverified install!')",
            "",
            "    cand_names = [n for n in assets if ('linux' in n.lower() and ('x86_64' in n.lower() or 'amd64' in n.lower()))]",
            "    if not cand_names:",
            "        raise RuntimeError('No Linux x86_64 release asset found in latest GitHub release.')",
            "    asset_name = sorted(cand_names)[0]",
            "",
            "    sums_path = INSTALL_DIR / 'SHA256SUMS.txt'",
            "    artifact_path = INSTALL_DIR / asset_name",
            "    _https_download(assets[sums_name], sums_path)",
            "    _https_download(assets[asset_name], artifact_path)",
            "",
            "    expected_hashes = {}",
            "    for line in sums_path.read_text(encoding='utf-8').splitlines():",
            "        parts = line.strip().split()",
            "        if len(parts) >= 2:",
            "            expected_hashes[parts[1].lstrip('*')] = parts[0].lower()",
            "",
            "    if asset_name not in expected_hashes:",
            "        raise RuntimeError(f'{asset_name} not listed in SHA256SUMS.txt — aborting before chmod +x!')",
            "",
            "    actual_sha256 = hashlib.sha256(artifact_path.read_bytes()).hexdigest().lower()",
            "    if actual_sha256 != expected_hashes[asset_name]:",
            "        artifact_path.unlink(missing_ok=True)",
            "        raise RuntimeError(f'SHA-256 mismatch for {asset_name}: expected {expected_hashes[asset_name]}, got {actual_sha256}')",
            "",
            "    print(f'SHA-256 verified OK for {asset_name}: {actual_sha256}')",
            "    if asset_name.endswith(('.tar.gz', '.tgz')):",
            "        with tarfile.open(artifact_path, 'r:gz') as tf:",
            "            tf.extractall(INSTALL_DIR, filter='data')",
            "        found = list(INSTALL_DIR.rglob('pblang'))",
            "        if not found:",
            "            raise RuntimeError('Extracted archive did not contain pblang binary')",
            "        bin_path = found[0]",
            "    else:",
            "        bin_path = INSTALL_DIR / 'pblang'",
            "        shutil.move(str(artifact_path), str(bin_path))",
            "",
            "    # Mandatory security gate: chmod 0o755 happens ONLY after SHA-256 verification succeeded!",
            "    os.chmod(bin_path, 0o755)",
            "    ver = subprocess.run([str(bin_path), '--version'], capture_output=True, text=True, check=True)",
            "    print('Installed & verified:', ver.stdout.strip())",
            "    return bin_path",
            "",
            "PBLANG_BIN = install_or_locate_verified_pblang()"
        ]),

        _md_cell("pblang-v4-qlora-md", [
            "## 2. Native `PBLang` Transformer Autograd + `4-Bit NormalFloat (NF4) QLoRA` on Free NVIDIA T4 GPU (`0.00 EUR`)"
        ]),

        _code_cell("pblang-v4-qlora-code", [
            "import subprocess",
            "import tempfile",
            "import pathlib",
            "",
            "gpu_probe = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader'], capture_output=True, text=True)",
            "if gpu_probe.returncode == 0:",
            "    print('Detected Colab Free CUDA GPU:', gpu_probe.stdout.strip())",
            "else:",
            "    print('Running in CPU/OpenCL fallback mode (0.00 EUR).')",
            "",
            "qlora_sapp = '''",
            "let TRAINER = import(\"stdlib:ai_transformer_cuda_trainer.sapp\");",
            "let hw = TRAINER.probe_compute_backends();",
            "print \"Compute Backends: selected=\" + str(hw.recommended_backend) + \" cuda=\" + str(hw.cuda_available);",
            "",
            "let model = TRAINER.create_transformer_model(map{",
            "    vocab_size: 64,",
            "    d_model: 32,",
            "    n_heads: 4,",
            "    n_kv_heads: 2,",
            "    n_layers: 2,",
            "    d_ff: 64,",
            "    max_seq_len: 32,",
            "    seed: 2026",
            "});",
            "let qlora_info = TRAINER.attach_qlora_adapters(model, map{ rank: 4, alpha: 8.0, block_size: 32, seed: 2026 });",
            "let opt = TRAINER.adamw_new(TRAINER.model_trainable_params(model), map{ lr: 0.015 });",
            "let seq = [1, 5, 9, 13, 17, 21, 25, 29, 2, 6, 10, 14];",
            "let step0 = TRAINER.qlora_train_step(model, seq, opt, nil, 1.0);",
            "let step_last = step0;",
            "let s = 0;",
            "while s < 8 {",
            "    step_last = TRAINER.qlora_train_step(model, seq, opt, nil, 1.0);",
            "    s = s + 1;",
            "}",
            "let frozen_ok = TRAINER.verify_qlora_frozen_integrity(model);",
            "print \"NF4 QLoRA Training OK: loss_start=\" + str(step0.loss) + \" -> loss_end=\" + str(step_last.loss) + \" frozen_nf4_intact=\" + str(frozen_ok.ok);",
            "'''",
            "",
            "with tempfile.TemporaryDirectory() as tmpd:",
            "    sapp_file = pathlib.Path(tmpd) / 'colab_t4_qlora_demo.sapp'",
            "    sapp_file.write_text(qlora_sapp.strip() + '\\n', encoding='utf-8')",
            "    res = subprocess.run([str(PBLANG_BIN), str(sapp_file)], capture_output=True, text=True, check=True)",
            "    print(res.stdout)"
        ]),

        _md_cell("pblang-v4-quantum-md", [
            "## 3. Export `PBLang` Quantum Circuits to Google `Cirq` (`Willow 105q` Grid) & `Qiskit` (`OpenQASM 3.0`) at `0.00 EUR`"
        ]),

        _code_cell("pblang-v4-quantum-code", [
            "import json",
            "import subprocess",
            "import sys",
            "import tempfile",
            "import pathlib",
            "",
            "try:",
            "    import cirq, cirq_google, qiskit",
            "    from qiskit_aer import AerSimulator",
            "except ImportError:",
            "    subprocess.run([sys.executable, '-m', 'pip', 'install', '--quiet', 'cirq-core', 'cirq-google', 'qiskit', 'qiskit-aer', 'qiskit-qasm3-import'], check=True)",
            "    import cirq, cirq_google, qiskit",
            "    from qiskit_aer import AerSimulator",
            "",
            "quantum_export_sapp = '''",
            "let BRIDGE = import(\"stdlib:quantum/colab_cirq_qiskit_bridge.sapp\");",
            "let MM = import(\"stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp\");",
            "let ghz = BRIDGE.build_ghz_circuit(3);",
            "let willow = MM.transpile_to_google_willow(ghz);",
            "let payload = map{",
            "    pblang_tier0: BRIDGE.smart_quantum_execute(ghz),",
            "    cirq_circuit_json: BRIDGE.to_cirq_circuit_json(ghz),",
            "    willow_cirq_v2_json: BRIDGE.to_google_willow_cirq_v2_json(willow),",
            "    openqasm3: BRIDGE.to_openqasm3(ghz),",
            "    willow_grid_qubits: willow.grid_qubits_used",
            "};",
            "print json_stringify(payload);",
            "'''",
            "",
            "with tempfile.TemporaryDirectory() as tmpd:",
            "    q_file = pathlib.Path(tmpd) / 'export_willow_cirq_qiskit.sapp'",
            "    q_file.write_text(quantum_export_sapp.strip() + '\\n', encoding='utf-8')",
            "    q_out = subprocess.run([str(PBLANG_BIN), str(q_file)], capture_output=True, text=True, check=True)",
            "    bundle = json.loads(q_out.stdout.strip())",
            "",
            "# 1. Execute on Google Cirq Simulator (Willow 105q GridQubits)",
            "cirq_circuit = cirq.read_json(json_text=bundle['cirq_circuit_json'])",
            "cirq_res = cirq.Simulator(seed=2026).run(cirq_circuit, repetitions=4096)",
            "cirq_counts = {}",
            "for row in cirq_res.measurements['m']:",
            "    bs = ''.join(str(int(b)) for b in row)",
            "    cirq_counts[bs] = cirq_counts.get(bs, 0) + 1",
            "",
            "# 2. Execute on IBM Qiskit AerSimulator (OpenQASM 3.0)",
            "import qiskit.qasm3",
            "qc = qiskit.qasm3.loads(bundle['openqasm3'])",
            "qiskit_raw = AerSimulator(seed_simulator=2026).run(qc, shots=4096).result().get_counts()",
            "qiskit_counts = {k.replace(' ', '')[::-1]: v for k, v in qiskit_raw.items()}",
            "",
            "def hellinger_fidelity(p_map, q_map):",
            "    sa = sum(p_map.values())",
            "    sb = sum(q_map.values())",
            "    keys = set(p_map.keys()) | set(q_map.keys())",
            "    bc = sum(((p_map.get(k, 0.0) / sa) * (q_map.get(k, 0.0) / sb)) ** 0.5 for k in keys)",
            "    return bc * bc",
            "",
            "pb_probs = bundle['pblang_tier0']['probabilities']",
            "f_pb_cirq = hellinger_fidelity(pb_probs, cirq_counts)",
            "f_pb_qiskit = hellinger_fidelity(pb_probs, qiskit_counts)",
            "f_cirq_qiskit = hellinger_fidelity(cirq_counts, qiskit_counts)",
            "print('Willow 105q GridQubits used:', bundle['willow_grid_qubits'])",
            "print(f'3-Way Hellinger Fidelity (0.00 EUR): PBLang<->Cirq={f_pb_cirq:.6f}, PBLang<->Qiskit={f_pb_qiskit:.6f}, Cirq<->Qiskit={f_cirq_qiskit:.6f}')",
            "assert min(f_pb_cirq, f_pb_qiskit, f_cirq_qiskit) > 0.995"
        ]),

        _md_cell("pblang-v4-secrets-md", [
            "## 4. Zero-Leak Cloud Token Handling (`google.colab.userdata` ONLY) & Hard Paid-Cost Firewall"
        ]),

        _code_cell("pblang-v4-secrets-code", [
            "# Optional cloud credentials are retrieved EXCLUSIVELY from Colab Secrets (`userdata`).",
            "# Secret values are NEVER hardcoded in notebook cells and NEVER printed to stdout!",
            "try:",
            "    from google.colab import userdata",
            "    _HAS_COLAB_USERDATA = True",
            "except ImportError:",
            "    userdata = None",
            "    _HAS_COLAB_USERDATA = False",
            "",
            "def load_ephemeral_quantum_secret_presence() -> dict:",
            "    status = {'colab_userdata_available': _HAS_COLAB_USERDATA, 'google_project_configured': False, 'ibm_token_configured': False}",
            "    if _HAS_COLAB_USERDATA:",
            "        for secret_name, flag_key in [('GOOGLE_CLOUD_PROJECT', 'google_project_configured'), ('IBM_QUANTUM_API_KEY', 'ibm_token_configured')]:",
            "            try:",
            "                val = userdata.get(secret_name)",
            "                status[flag_key] = bool(val and len(val.strip()) > 0)",
            "            except Exception:",
            "                status[flag_key] = False",
            "    return status",
            "",
            "print('Redacted Secret Presence Audit (zero values printed):', load_ephemeral_quantum_secret_presence())"
        ])
    ];

    let notebook = map{
        cells: cells,
        metadata: map{
            accelerator: "GPU",
            colab: map{
                gpuType: "T4",
                name: "pblang_v4_colab_gpu_cirq_qiskit.ipynb",
                provenance: []
            },
            kernelspec: map{
                display_name: "Python 3",
                language: "python",
                name: "python3"
            },
            language_info: map{
                name: "python"
            }
        },
        nbformat: 4,
        nbformat_minor: 5
    };

    let json_text = _json_pretty(notebook, 0) + "\n";

    if is_map(opts) and map_has(opts, "output_path") and type(opts.output_path) == "string" {
        let out_p = str_trim(opts.output_path);
        if len(out_p) > 0 {
            let last_slash = -1;
            let idx = 0;
            while idx < len(out_p) {
                if str_slice(out_p, idx, idx + 1) == "/" {
                    last_slash = idx;
                }
                idx = idx + 1;
            }
            if last_slash > 0 {
                let parent_dir = str_slice(out_p, 0, last_slash);
                if not (try fs_exists(parent_dir) catch false) {
                    try fs_mkdirs(parent_dir) catch nil;
                }
            }
            fs_write(out_p, json_text);
        }
    }

    return json_text;
}

