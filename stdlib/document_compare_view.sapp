let Compare=import("stdlib:document_compare.sapp");let Pages=import("stdlib:text_pages.sapp");let UI=import("stdlib:modern_ui.sapp");
fn fragments(entry){return Pages.paginate(entry.block.text,24,6);}
fn _index(value,count){if type(value)!="number" or not(value>=0 and value<count) or value!=num_floor(value){throw "comparison view: invalid index";}}
fn create(left,right,index=0,group=0) {
    let report=Compare.compare(left,right);_index(index,len(report.entries));let entry=report.entries[index];let parts=fragments(entry);
    _index(group,num_ceil(len(parts)/8));let first=group*8;let children=[UI.heading("PBCompare"),UI.text("Entry "+str(index+1)+" / "+str(len(report.entries))+" | "+entry.kind+" "+entry.block.kind),
        UI.text("Left block: "+if entry.left==nil {"-"} else {str(entry.left+1)}),UI.text("Right block: "+if entry.right==nil {"-"} else {str(entry.right+1)}),
        UI.text("Part "+str(first+1)+" / "+str(len(parts)),map{name:"position"})];
    for i in range(0,6){array_push(children,UI.text(if i<len(parts[first]) {parts[first][i]} else {""},map{name:"line_"+str(i)}));}
    let buttons=[];
    for part in range(first,num_min(first+8,len(parts))) {
        let actions=[UI.action_set_text("position","Part "+str(part+1)+" / "+str(len(parts)))];
        for i in range(0,6){array_push(actions,UI.action_set_text("line_"+str(i),if i<len(parts[part]) {parts[part][i]} else {""}));}
        array_push(buttons,UI.button("Part "+str(part+1),UI.action_sequence(actions),map{name:"part_"+str(part)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Read-only comparison. Other entries and groups are separate exports."));return UI.screen(children);
}
export fragments,create;
