// Safe garbage-collection contract for PBLang code running on the retained host VM.
//
// The retained runtime registers arrays, maps, and modules in thread-local heaps.
// A nested import runs in a second VM on the same thread, so a collection from
// that VM cannot prove that it has marked every suspended caller root. Until
// execution moves to the PBLang-native owner-scoped VM, destructive collection
// is deliberately unavailable through the standard library.

let FORMAT = "pblang.runtime_gc.v1";

fn status() {
    return map{
        format: FORMAT,
        runtime: "retained-host-vm",
        heap_scope: "host-thread",
        owner_isolation: false,
        collection_allowed: false,
        untrusted_native_run_allowed: false,
        reason: "host GC cannot prove roots across same-thread nested VMs",
        safe_execution: "stdlib:compiler/vm.sapp"
    };
}

// Allocation counters are observational only and cover the host thread. They
// must not be interpreted as the current module or VM's private heap.
fn host_thread_stats_text() {
    return try gc_stats() catch "";
}

// Preserve a structured result instead of pretending that collection ran.
fn collect() {
    let s = status();
    return map{
        format: "pblang.runtime_gc.collection.v1",
        ok: false,
        allowed: false,
        performed: false,
        conclusive: false,
        heap_scope: s.heap_scope,
        owner_isolation: s.owner_isolation,
        arrays_cleared: 0,
        maps_cleared: 0,
        modules_cleared: 0,
        error: s.reason,
        safe_execution: s.safe_execution
    };
}

fn require_owner_isolation() {
    let s = status();
    if not s.owner_isolation { throw "runtime_gc: " + s.reason; }
    return s;
}

export FORMAT, status, host_thread_stats_text, collect, require_owner_isolation;
