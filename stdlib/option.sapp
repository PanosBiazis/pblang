// stdlib/option.sapp — Option/Maybe type for nullable values.
//
// An Option is a map:
//   { some: true,  value: <val> }  — has a value
//   { some: false }                — no value (None)
//
// Prefer this over nil-checks in APIs that may or may not return a value.

// Constructors
fn some(value) {
    return map{ some: true, value: value };
}

fn none() {
    return map{ some: false };
}

// Wrap a nullable value: nil → None, anything else → Some
fn of(value) {
    if value == nil { return none(); }
    return some(value);
}

// Predicates
fn is_some(opt) { return opt.some == true; }
fn is_none(opt) { return opt.some == false; }

// unwrap — return value or raise error
fn unwrap(opt) {
    if opt.some { return opt.value; }
    return error("Option::unwrap called on None");
}

// unwrap_or — return value or a default
fn unwrap_or(opt, default) {
    if opt.some { return opt.value; }
    return default;
}

// unwrap_or_else — return value or call fn() for a default
fn unwrap_or_else(opt, fn_val) {
    if opt.some { return opt.value; }
    return fn_val();
}

// map — apply fn to value if Some, return None otherwise
fn map_val(opt, fn_val) {
    if opt.some { return some(fn_val(opt.value)); }
    return none();
}

// and_then (flatMap) — fn receives value and must return Option
fn and_then(opt, fn_val) {
    if opt.some { return fn_val(opt.value); }
    return none();
}

// or_else — return opt if Some, or call fn() if None
fn or_else(opt, fn_val) {
    if opt.some { return opt; }
    return fn_val();
}

// filter — return Some(value) if predicate is true, otherwise None
fn filter(opt, pred) {
    if opt.some and pred(opt.value) { return opt; }
    return none();
}

// to_string — human-readable
fn to_string(opt) {
    if opt.some { return "Some(" + str(opt.value) + ")"; }
    return "None";
}

// contains(opt, val) — true if the option is Some(val).
fn contains(opt, val) { return opt.some == true and opt.value == val; }

// to_result(opt, err_val) — Some(v) -> Ok(v); None -> Err(err_val). Returns a
// result-shaped map (built directly to avoid an import cycle with result.sapp).
fn to_result(opt, err_val) {
    if opt.some { return map{ ok: true, value: opt.value }; }
    return map{ ok: false, error: err_val };
}

// zip(a, b) — Some([a, b]) if both are Some, else None.
fn zip(a, b) {
    if a.some == true and b.some == true { return map{ some: true, value: [a.value, b.value] }; }
    return map{ some: false };
}

// flatten(opt) — collapse Some(Some(x)) -> Some(x); leaves non-nested options as-is.
fn flatten(opt) {
    if opt.some == true and is_map(opt.value) and map_has(opt.value, "some") { return opt.value; }
    return opt;
}

export some, none, of, is_some, is_none, unwrap, unwrap_or, unwrap_or_else,
       map_val, and_then, or_else, filter, to_string, contains, to_result, zip, flatten;
