// Embedded static images for the existing Android class-file renderer.
// Pure PBLang: normalize bounded frames and reuse the existing RGBA PNG encoder.
let Pipeline=import("stdlib:image_pipeline.sapp");
let MAX_PIXELS=16384;
let MAX_TOTAL_PIXELS=65536;
let MAX_DIMENSION=1024;
let MAX_BUFFER_BYTES=262144;
let MAX_BASE64_BYTES=131072;
let CHUNK_SIZE=16000;
fn enabled(options) {
    let value=try options.android_images catch false;
    if type(value)!="bool" {throw "modern_ui_android: android_images must be boolean";}
    return value;
}
fn _integer(value,minimum,maximum) {
    return type(value)=="number" and value>=minimum and value<=maximum and value==num_floor(value);
}
fn _byte(value) {
    if not _integer(value,0,255) {throw "modern_ui_android: image channel must be an integer byte";}
    return value;
}
fn normalize(source_frame,remaining=65536) {
    let width=0;let height=0;let channels=0;let packed=type(source_frame)=="map";
    if packed {
        let format=try source_frame.format catch "";
        if format=="pblang.image.rgb8.v1" {channels=3;}
        elif format=="pblang.image.rgba8.v1" {channels=4;}
        else {throw "modern_ui_android: unsupported image format";}
        width=try source_frame.width catch nil;height=try source_frame.height catch nil;
    } elif type(source_frame)=="array" and len(source_frame)>0 and type(source_frame[0])=="array" {
        height=len(source_frame);width=len(source_frame[0]);
    } else {throw "modern_ui_android: expected planar or packed RGB/RGBA image";}
    if not _integer(width,1,MAX_DIMENSION) or not _integer(height,1,MAX_DIMENSION)
        or width*height>MAX_PIXELS or not _integer(remaining,0,MAX_TOTAL_PIXELS)
        or width*height>remaining {throw "modern_ui_android: embedded image pixel budget exceeded";}
    if packed {
        let bytes=try source_frame.bytes catch nil;let offset=try source_frame.offset catch nil;let stride=try source_frame.stride catch nil;
        if type(bytes)!="array" or len(bytes)>MAX_BUFFER_BYTES
            or not _integer(offset,0,MAX_BUFFER_BYTES) or not _integer(stride,width*channels,MAX_BUFFER_BYTES)
            or len(bytes)!=offset+height*stride {throw "modern_ui_android: invalid packed image buffer";}
    }
    let image=[];
    for y height {
        if not packed and (type(source_frame[y])!="array" or len(source_frame[y])!=width) {
            throw "modern_ui_android: image rows must have equal width";
        }
        let row=[];
        for x width {
            let pixel=[];
            if packed {
                let at=source_frame.offset+y*source_frame.stride+x*channels;
                pixel=[source_frame.bytes[at],source_frame.bytes[at+1],source_frame.bytes[at+2]];
                if channels==4 {array_push(pixel,source_frame.bytes[at+3]);}
            } else {pixel=source_frame[y][x];}
            if type(pixel)!="array" or (len(pixel)!=3 and len(pixel)!=4) {
                throw "modern_ui_android: image pixels must have three or four channels";
            }
            let alpha=255;if len(pixel)==4 {alpha=_byte(pixel[3]);}
            array_push(row,[_byte(pixel[0]),_byte(pixel[1]),_byte(pixel[2]),alpha]);
        }
        array_push(image,row);
    }
    return map{width:width,height:height,pixels:width*height,image:image};
}
fn prepare(source_frame,remaining=65536) {
    let normalized=normalize(source_frame,remaining);
    let encoded=base64_encode_bytes(Pipeline.encode_png(normalized.image));
    if len(encoded)>MAX_BASE64_BYTES {throw "modern_ui_android: encoded image budget exceeded";}
    let chunks=[];let at=0;
    while at<len(encoded) {array_push(chunks,str_slice(encoded,at,num_min(at+CHUNK_SIZE,len(encoded))));at=at+CHUNK_SIZE;}
    return map{width:normalized.width,height:normalized.height,pixels:normalized.pixels,chunks:chunks};
}
export MAX_PIXELS,MAX_TOTAL_PIXELS,MAX_DIMENSION,MAX_BUFFER_BYTES,CHUNK_SIZE,enabled,normalize,prepare;
