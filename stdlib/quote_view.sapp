// A whole page uses one text update so all admitted estimates fit the action budget.
let Q=import("stdlib:quote_document.sapp");let T=import("stdlib:text_document.sapp");
let Pages=import("stdlib:text_pages.sapp");let UI=import("stdlib:modern_ui.sapp");
fn create(doc) {
    let text=T.to_text(Q.to_document(doc));let pages=Pages.paginate(text,28,10);
    let children=[UI.heading("PBQuote"),UI.text("Estimate - taxes not calculated"),UI.text("Page 1 / "+str(len(pages)),map{name:"position"}),
        UI.area(str_join(pages[0],"\n"),map{name:"body",h:300,min_h:300,label:"Estimate page",readonly:true,enabled:false})];
    let buttons=[];
    for p in range(0,len(pages)) {
        let actions=[UI.action_set_text("position","Page "+str(p+1)+" / "+str(len(pages))),UI.action_set_text("body",str_join(pages[p],"\n"))];
        array_push(buttons,UI.button(str(p+1),UI.action_sequence(actions),map{name:"page_"+str(p)}));
    }
    array_push(children,UI.grid(buttons,map{columns:6}));return UI.screen(children);
}
export create;
