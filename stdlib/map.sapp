// stdlib/map.sapp — Map helpers

fn keys(m) { return map_keys(m); }
fn has(m, k) { return map_has(m, k); }
fn remove(m, k) { return map_remove(m, k); }

// size(m) → number of keys
fn size(m) { return len(map_keys(m)); }

// is_empty(m) → true if map has no keys
fn is_empty(m) { return len(map_keys(m)) == 0; }
fn get_or(m, k, default_val) {
    if map_has(m, k) { return m[k]; }
    return default_val;
}

// copy(m) → shallow copy
fn copy(m) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        result[ks[i]] = m[ks[i]];
        i = i + 1;
    }
    return result;
}

// values(m) → array of values (in map_keys order)
fn values(m) {
    let ks = map_keys(m);
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, m[ks[i]]);
        i = i + 1;
    }
    return result;
}

// merge(m1, m2) → new map with all keys from m1 and m2 (m2 wins on conflict)
fn merge(m1, m2) {
    let result = copy(m1);
    let k2 = map_keys(m2);
    let i = 0;
    while i < len(k2) { result[k2[i]] = m2[k2[i]]; i = i + 1; }
    return result;
}

// merge_all([m1, m2, ...]) → left-to-right merge, later maps win
fn merge_all(maps) {
    let result = map{};
    let i = 0;
    while i < len(maps) {
        let ks = map_keys(maps[i]);
        let j = 0;
        while j < len(ks) {
            result[ks[j]] = maps[i][ks[j]];
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// defaults(m, default_map) → copy of m with missing keys filled from default_map
fn defaults(m, default_map) {
    let result = copy(m);
    let ks = map_keys(default_map);
    let i = 0;
    while i < len(ks) {
        if map_has(result, ks[i]) == false { result[ks[i]] = default_map[ks[i]]; }
        i = i + 1;
    }
    return result;
}

// entries(m) → array of {key, value} maps
fn entries(m) {
    let ks = map_keys(m);
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, map{ key: ks[i], value: m[ks[i]] });
        i = i + 1;
    }
    return result;
}

// from_entries(pairs) → map built from array of {key, value} pairs
fn from_entries(pairs) {
    let result = map{};
    let i = 0;
    while i < len(pairs) {
        let p = pairs[i];
        if is_map(p) and map_has(p, "key") and map_has(p, "value") {
            result[p.key] = p.value;
        } else {
            if is_array(p) and len(p) >= 2 {
                result[str(p[0])] = p[1];
            }
        }
        i = i + 1;
    }
    return result;
}

// filter_keys(m, fn) → new map with only keys where fn(key) is truthy
fn filter_keys(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        if fn_val(ks[i]) { result[ks[i]] = m[ks[i]]; }
        i = i + 1;
    }
    return result;
}

// filter_values(m, fn) → new map with only entries where fn(value) is truthy
fn filter_values(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        if fn_val(m[ks[i]]) { result[ks[i]] = m[ks[i]]; }
        i = i + 1;
    }
    return result;
}

// map_values(m, fn) → new map with values transformed by fn
fn map_values(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        result[ks[i]] = fn_val(m[ks[i]]);
        i = i + 1;
    }
    return result;
}

// map_entries(m, fn) → transform entries; fn(key,value) returns {key,value} or [key,value]
fn map_entries(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let e = fn_val(ks[i], m[ks[i]]);
        if e != nil {
            if is_map(e) and map_has(e, "key") and map_has(e, "value") {
                result[e.key] = e.value;
            } else {
                if is_array(e) and len(e) >= 2 {
                    result[str(e[0])] = e[1];
                }
            }
        }
        i = i + 1;
    }
    return result;
}

// pick(m, keys_array) → new map with only the specified keys
fn pick(m, ks) {
    let result = map{};
    let i = 0;
    while i < len(ks) {
        if map_has(m, ks[i]) { result[ks[i]] = m[ks[i]]; }
        i = i + 1;
    }
    return result;
}

// omit(m, keys_array) → new map without the specified keys
fn omit(m, ks) {
    let result = map{};
    let deny = map{};
    let j = 0;
    while j < len(ks) {
        deny[str(ks[j])] = true;
        j = j + 1;
    }
    let all = map_keys(m);
    let i = 0;
    while i < len(all) {
        if map_has(deny, str(all[i])) == false { result[all[i]] = m[all[i]]; }
        i = i + 1;
    }
    return result;
}

fn has_all(m, ks) {
    let i = 0;
    while i < len(ks) {
        if map_has(m, ks[i]) == false { return false; }
        i = i + 1;
    }
    return true;
}

fn has_any(m, ks) {
    let i = 0;
    while i < len(ks) {
        if map_has(m, ks[i]) { return true; }
        i = i + 1;
    }
    return false;
}

fn contains_value(m, value) {
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        if m[ks[i]] == value { return true; }
        i = i + 1;
    }
    return false;
}

fn keys_sorted(m) { return array_sort(map_keys(m)); }

fn values_by_sorted_keys(m) {
    let ks = keys_sorted(m);
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, m[ks[i]]);
        i = i + 1;
    }
    return result;
}

// update(m, key, fn, default) → copy with key set to fn(current_or_default)
fn update(m, k, fn_val, default_val) {
    let result = copy(m);
    result[k] = fn_val(get_or(m, k, default_val));
    return result;
}

fn rename_key(m, old_key, new_key) {
    let result = copy(m);
    if map_has(result, old_key) {
        result[new_key] = result[old_key];
        map_remove(result, old_key);
    }
    return result;
}

// invert(m) → new map with keys and values swapped (values become keys)
fn invert(m) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        result[str(m[ks[i]])] = ks[i];
        i = i + 1;
    }
    return result;
}

// zip_map(keys_arr, values_arr) → map built from parallel arrays
fn zip_map(ks, vs) {
    let result = map{};
    let n = len(ks);
    if len(vs) < n { n = len(vs); }
    let i = 0;
    while i < n {
        result[str(ks[i])] = vs[i];
        i = i + 1;
    }
    return result;
}

// group_by(arr, key_fn) → map grouping array elements by key_fn(element)
fn group_by(arr, key_fn) {
    let result = map{};
    let i = 0;
    while i < len(arr) {
        let k = str(key_fn(arr[i]));
        if map_has(result, k) == false { result[k] = []; }
        array_push(result[k], arr[i]);
        i = i + 1;
    }
    return result;
}

// count_by(arr, key_fn) → map of counts per group
fn count_by(arr, key_fn) {
    let result = map{};
    let i = 0;
    while i < len(arr) {
        let k = str(key_fn(arr[i]));
        if map_has(result, k) == false { result[k] = 0; }
        result[k] = result[k] + 1;
        i = i + 1;
    }
    return result;
}

// merge_into(target, source) — mutating merge for hot loops where allocating a
// fresh copy for every update is unnecessary. Source values win on conflicts.
fn merge_into(target, source) {
    let ks = map_keys(source);
    let i = 0;
    while i < len(ks) {
        target[ks[i]] = source[ks[i]];
        i = i + 1;
    }
    return target;
}

// set_many(target, updates) is the explicit batch-mutation spelling.
fn set_many(target, updates) { return merge_into(target, updates); }

fn get_many(m, ks, default_val = nil) {
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, get_or(m, ks[i], default_val));
        i = i + 1;
    }
    return result;
}

// compute_if_absent mutates m only when k is missing.
fn compute_if_absent(m, k, factory) {
    if not map_has(m, k) { m[k] = factory(k); }
    return m[k];
}

// partition(m, fn) — [accepted, rejected], evaluating fn(key, value) once.
fn partition(m, fn_val) {
    let yes = map{};
    let no = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if fn_val(k, m[k]) { yes[k] = m[k]; }
        else { no[k] = m[k]; }
        i = i + 1;
    }
    return [yes, no];
}

export keys, has, remove, get_or, copy, values, merge, merge_all, defaults,
       entries, from_entries, filter_keys, filter_values, map_values,
       map_entries, size, is_empty, pick, omit, has_all, has_any,
       contains_value, keys_sorted, values_by_sorted_keys, update, rename_key,
       invert, zip_map, group_by, count_by, merge_into, set_many, get_many,
       compute_if_absent, partition;
