// stdlib/map.sapp — Map helpers

fn keys(m) { return map_keys(m); }
fn has(m, k) { return map_has(m, k); }
fn remove(m, k) { return map_remove(m, k); }

// get_or(m, key, default_val) → m[key] if present, else default_val
fn get_or(m, k, default_val) {
    if map_has(m, k) { return m[k]; }
    return default_val;
}

// values(m) → array of values (in map_keys order)
fn values(m) {
    let ks = map_keys(m);
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, m[ks[i]]);
        i = i + 1;
    }
    return result;
}

// merge(m1, m2) → new map with all keys from m1 and m2 (m2 wins on conflict)
fn merge(m1, m2) {
    let result = map{};
    let k1 = map_keys(m1);
    let i = 0;
    while i < len(k1) { result[k1[i]] = m1[k1[i]]; i = i + 1; }
    let k2 = map_keys(m2);
    let j = 0;
    while j < len(k2) { result[k2[j]] = m2[k2[j]]; j = j + 1; }
    return result;
}

// entries(m) → array of {key, value} maps
fn entries(m) {
    let ks = map_keys(m);
    let result = [];
    let i = 0;
    while i < len(ks) {
        array_push(result, map{ key: ks[i], value: m[ks[i]] });
        i = i + 1;
    }
    return result;
}

// from_entries(pairs) → map built from array of {key, value} pairs
fn from_entries(pairs) {
    let result = map{};
    let i = 0;
    while i < len(pairs) {
        result[pairs[i].key] = pairs[i].value;
        i = i + 1;
    }
    return result;
}

// filter_keys(m, fn) → new map with only keys where fn(key) is truthy
fn filter_keys(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        if fn_val(ks[i]) { result[ks[i]] = m[ks[i]]; }
        i = i + 1;
    }
    return result;
}

// map_values(m, fn) → new map with values transformed by fn
fn map_values(m, fn_val) {
    let result = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        result[ks[i]] = fn_val(m[ks[i]]);
        i = i + 1;
    }
    return result;
}

export keys, has, remove, get_or, values, merge, entries, from_entries,
       filter_keys, map_values;
