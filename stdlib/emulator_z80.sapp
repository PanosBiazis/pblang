// stdlib/emulator_z80.sapp -- bounded Z80 execution-model subset.
//
// This module models the documented arithmetic/control subset used by the
// PBLang CP/M conformance suite. It is intentionally not advertised as a full
// Z80 machine: memory, interrupts, ports, prefixes, and undocumented opcodes
// require separate checked models.

let FORMAT = "pblang.emulator.z80.v1";
let DEFAULT_BUDGET = 1000000;
let MAX_CODE_BYTES = 65536;
let Support = import("stdlib:emulator_support.sapp");

fn _zero(value) {
    if value == 0 { return 1; }
    return 0;
}

fn ld_a(value) { return [62, Support.byte(value)]; }
fn ld_b(value) { return [6, Support.byte(value)]; }
fn ld_c(value) { return [14, Support.byte(value)]; }
fn ld_a_b() { return [120]; }
fn add_b() { return [128]; }
fn add_c() { return [129]; }
fn add_imm(value) { return [198, Support.byte(value)]; }
fn sub_imm(value) { return [214, Support.byte(value)]; }
fn inc_a() { return [60]; }
fn inc_b() { return [4]; }
fn dec_a() { return [61]; }
fn dec_b() { return [5]; }
fn dec_c() { return [13]; }
fn compare_imm(value) { return [254, Support.byte(value)]; }
fn jump_relative(displacement) { return [24, Support.byte(displacement)]; }
fn jump_relative_nz(displacement) { return [32, Support.byte(displacement)]; }
fn jump_relative_z(displacement) { return [40, Support.byte(displacement)]; }
fn halt() { return [118]; }

fn program(instructions) {
    return Support.program(instructions, MAX_CODE_BYTES);
}

fn _failure(reason, pc, instructions) {
    return Support.failure(FORMAT, reason, pc, instructions);
}

fn _needs_immediate(opcode) {
    return opcode == 62 or opcode == 6 or opcode == 14 or opcode == 198 or
           opcode == 214 or opcode == 254 or opcode == 24 or opcode == 32 or opcode == 40;
}

fn run(code, options = nil) {
    let invalid = Support.validate_bytes(code, MAX_CODE_BYTES);
    if invalid != nil { return _failure(invalid, 0, 0); }

    let budget_result = Support.instruction_budget(options, DEFAULT_BUDGET);
    if not budget_result.ok { return _failure(budget_result.error, 0, 0); }
    let budget = budget_result.value;

    let a = 0; let b = 0; let c = 0; let d = 0; let e = 0;
    let zero = 0; let carry = 0; let pc = 0; let count = 0;
    while count < budget {
        if pc < 0 or pc >= len(code) { return _failure("program counter outside code", pc, count); }
        let opcode = code[pc];
        if _needs_immediate(opcode) and pc + 1 >= len(code) {
            return _failure("truncated immediate operand at offset " + str(pc), pc, count);
        }
        count = count + 1;
        if opcode == 62 { a = code[pc + 1]; pc = pc + 2; }
        elif opcode == 6 { b = code[pc + 1]; pc = pc + 2; }
        elif opcode == 14 { c = code[pc + 1]; pc = pc + 2; }
        elif opcode == 120 { a = b; pc = pc + 1; }
        elif opcode == 128 {
            let value = a + b; carry = if value > 255 { 1 } else { 0 };
            a = value % 256; zero = _zero(a); pc = pc + 1;
        }
        elif opcode == 129 {
            let value = a + c; carry = if value > 255 { 1 } else { 0 };
            a = value % 256; zero = _zero(a); pc = pc + 1;
        }
        elif opcode == 198 {
            let value = a + code[pc + 1]; carry = if value > 255 { 1 } else { 0 };
            a = value % 256; zero = _zero(a); pc = pc + 2;
        }
        elif opcode == 214 {
            let value = a - code[pc + 1]; carry = if value < 0 { 1 } else { 0 };
            a = value % 256; if a < 0 { a = a + 256; } zero = _zero(a); pc = pc + 2;
        }
        elif opcode == 60 { a = (a + 1) % 256; zero = _zero(a); pc = pc + 1; }
        elif opcode == 4 { b = (b + 1) % 256; zero = _zero(b); pc = pc + 1; }
        elif opcode == 61 { a = (a + 255) % 256; zero = _zero(a); pc = pc + 1; }
        elif opcode == 5 { b = (b + 255) % 256; zero = _zero(b); pc = pc + 1; }
        elif opcode == 13 { c = (c + 255) % 256; zero = _zero(c); pc = pc + 1; }
        elif opcode == 254 { zero = _zero((a - code[pc + 1] + 256) % 256); pc = pc + 2; }
        elif opcode == 24 { pc = pc + 2 + Support.signed_byte(code[pc + 1]); }
        elif opcode == 32 {
            let next = pc + 2; if zero == 0 { next = next + Support.signed_byte(code[pc + 1]); } pc = next;
        }
        elif opcode == 40 {
            let next = pc + 2; if zero == 1 { next = next + Support.signed_byte(code[pc + 1]); } pc = next;
        }
        elif opcode == 118 {
            return map{
                ok: true, format: FORMAT, halted: true, pc: pc,
                instructions: count, registers: map{ a: a, b: b, c: c, d: d, e: e },
                flags: map{ zero: zero, carry: carry }, value: a,
                boundary: "verified Z80 arithmetic/control subset; not a full machine"
            };
        }
        else { return _failure("unmodeled opcode " + str(opcode) + " at offset " + str(pc), pc, count); }
    }
    return _failure("instruction budget exceeded", pc, count);
}

export FORMAT, DEFAULT_BUDGET, MAX_CODE_BYTES;
export ld_a, ld_b, ld_c, ld_a_b, add_b, add_c, add_imm, sub_imm;
export inc_a, inc_b, dec_a, dec_b, dec_c, compare_imm;
export jump_relative, jump_relative_nz, jump_relative_z, halt, program, run;
