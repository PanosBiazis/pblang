// Presentation only: never use a process label as authority or executable identity.
// Linux comm is limited to 15 UTF-8 bytes. This is not an application-size limit.
fn plan(name) {
    if type(name)!="string" or len(name)==0 or len(name)>1024 or name!=str_trim(name) {
        return map{ok:false,error:"invalid-process-label"};
    }
    let bytes=str_to_bytes(name);
    for b in bytes {
        if b<32 or b==127 or b==47 or b==92 {
            return map{ok:false,error:"process-label-must-not-be-a-path-or-contain-controls"};
        }
    }
    let count=len(bytes);
    if count>15 {
        count=15;
        while count>0 and bytes[count]>=128 and bytes[count]<192 {count=count-1;}
    }
    let prefix=[];for i count {array_push(prefix,bytes[i]);}
    return map{ok:true,name:name,linux_name:bytes_to_str(prefix),
        truncated:count<len(bytes),identity_verified:false};
}

fn from_path(path) {
    if type(path)!="string" {return "";}
    let parts=str_split(str_replace_all(path,"\\","/"),"/");
    let base=parts[len(parts)-1];
    for suffix in [".pbck",".pbself",".sapp",".exe"] {
        if str_ends_with(str_lower(base),suffix) {return str_slice(base,0,len(base)-len(suffix));}
    }
    return base;
}

// Call once from an application's entrypoint. Denied filesystem access or an
// unsupported host is reported without increasing capabilities or using FFI.
fn apply(name, mode="auto") {
    if mode=="keep" {return map{ok:true,applied:false,reason:"kept",identity_verified:false};}
    if mode!="auto" {return map{ok:false,applied:false,error:"invalid-name-mode"};}
    let selected=plan(name);if not selected.ok {selected.applied=false;return selected;}
    if platform()!="linux" {
        return map{ok:false,applied:false,error:"process-label-platform-unsupported",identity_verified:false};
    }
    let previous=try fs_read("/proc/self/comm") catch nil;
    if previous==nil {return map{ok:false,applied:false,error:"process-label-read-unavailable"};}
    if previous==selected.linux_name+"\n" {
        selected.applied=false;selected.reason="already-set";return selected;
    }
    let wrote=try {fs_write("/proc/self/comm",selected.linux_name);true} catch false;
    let actual=try fs_read("/proc/self/comm") catch nil;
    selected.ok=wrote and actual==selected.linux_name+"\n";
    selected.applied=selected.ok;
    if not selected.ok {selected.error="process-label-write-unverified";}
    return selected;
}

export plan,from_path,apply;
