// Deterministic Unicode glossary translation for recognized speech text.

let Unicode=import("stdlib:unicode.sapp");
let FORMAT="pblang.speech-translation.v1";
let MAX_GLOSSARY=4096;
let MAX_TEXT_CHARS=65536;

fn _language(value){value=str(value);if not regex_match(value,"^[A-Za-z][A-Za-z0-9_-]{1,15}$"){
    throw "speech_translation: invalid language identifier";}return value;}
fn _word_character(ch){let kind=Unicode.classify_character(ch);
    return kind=="lowercase" or kind=="uppercase" or kind=="cased-letter"
        or kind=="digit" or kind=="unicode" or ch=="'" or ch=="-";}
fn _validate_glossary(glossary){if type(glossary)!="map" or len(map_keys(glossary))>MAX_GLOSSARY{
    throw "speech_translation: glossary must contain at most 4096 entries";}
    let out=map{};for key in map_keys(glossary){let source=str_trim(str(key));let target=str(glossary[key]);
        if source=="" or len(source)>128 or target=="" or len(target)>512
            or str_contains(source,str_from_char_code(0)) or str_contains(target,str_from_char_code(0)){
            throw "speech_translation: invalid glossary entry";}
        out[str_lower(source)]=target;}return out;}
fn translate(text,source_language,target_language,glossary,require_full_coverage=true){
    if type(text)!="string" or len(text)>MAX_TEXT_CHARS{throw "speech_translation: text exceeds limit";}
    source_language=_language(source_language);target_language=_language(target_language);
    let table=_validate_glossary(glossary);let output="";let token="";let translated=0;let unknown=[];
    fn flush(){if token==""{return;}let key=str_lower(token);
        if source_language==target_language{output=output+token;translated=translated+1;}
        elif map_has(table,key) {output=output+table[key];translated=translated+1;}
        else {output=output+token;array_push(unknown,token);}token="";}
    for i len(text){let ch=str_slice(text,i,i+1);if _word_character(ch){token=token+ch;}
        else {flush();output=output+ch;}}
    flush();let total=translated+len(unknown);let coverage=if total==0{1}else{translated/total};
    if require_full_coverage and len(unknown)>0{return map{ok:false,executed:true,format:FORMAT,
        error:"glossary does not cover every recognized word",unknown_words:unknown,
        unknown_count:len(unknown),coverage:coverage,source_language:source_language,
        target_language:target_language};}
    return map{ok:true,executed:true,format:FORMAT,translation:output,
        source_language:source_language,target_language:target_language,
        translated_word_count:translated,unknown_words:unknown,unknown_count:len(unknown),
        coverage:coverage,full_coverage:len(unknown)==0,method:"explicit-unicode-glossary"};
}

export FORMAT, MAX_GLOSSARY, MAX_TEXT_CHARS, translate;
