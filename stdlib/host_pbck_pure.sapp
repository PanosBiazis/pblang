// Deterministic, platform-independent builtins for the host PBCK-v1 VM.
// Side effects (filesystem, process, network, graphics, clocks and entropy)
// deliberately stay outside this module and require explicit capabilities.

let NAMES = [
    "array_flatten", "array_pop", "array_push", "array_sort", "push",
    "base64_decode", "base64_decode_bytes", "base64_encode",
    "base64_encode_bytes", "bigint", "bit_and", "bit_not", "bit_or",
    "bit_shl", "bit_shr", "bit_xor", "bytes_to_str", "constant_time_eq",
    "error",
    "hmac_sha256", "http_parse_request", "http_response",
    "http_response_ct", "http_response_json",
    "is_array", "is_fn", "is_map", "is_number", "is_string",
    "json_parse", "json_stringify", "len", "map_has", "map_keys",
    "map_remove", "num_abs", "num_floor", "num_max", "num_min", "num_mod",
    "num_sqrt", "num_to_le_bytes", "parse_number", "path_join", "range",
    "regex_match", "regex_replace_all", "sha256",
    "slice", "str", "str_contains", "str_ends_with",
    "str_from_char_code", "str_index_of", "str_join", "str_lower",
    "str_pad_left", "str_pad_right", "str_repeat", "str_replace_all",
    "str_slice", "str_split", "str_starts_with", "str_to_bytes",
    "str_trim", "str_upper", "strcharcodeat", "strfromcharcode", "type",
    "url_encode"
];

let _REGISTRY = map{};
let _registry_i = 0;
while _registry_i < len(NAMES) {
    _REGISTRY[NAMES[_registry_i]] = true;
    _registry_i = _registry_i + 1;
}

fn has(name) { return map_has(_REGISTRY, name); }

fn _fail(name, message) { throw "host PBCK builtin " + name + ": " + message; }

fn _arity(name, args, expected) {
    if len(args) != expected {
        _fail(name, "expected " + str(expected) + " arguments, got " + str(len(args)));
    }
}

fn _at_most(name, value, maximum, label) {
    if len(value) > maximum { _fail(name, label + " limit exceeded"); }
}

fn _bounded_count(name, count, maximum) {
    if not is_number(count) or count != num_floor(count) or count < 0 or count > maximum {
        _fail(name, "result size limit exceeded");
    }
}

fn _bounded_value(name, value, maximum) {
    if is_string(value) or is_array(value) or is_map(value) {
        _at_most(name, value, maximum, "value size");
    }
    return value;
}

fn _flatten_into(name, value, out, maximum, depth) {
    if depth > 64 { _fail(name, "nesting limit exceeded"); }
    if is_array(value) {
        let i = 0;
        while i < len(value) {
            _flatten_into(name, value[i], out, maximum, depth + 1);
            i = i + 1;
        }
        return;
    }
    if len(out) >= maximum { _fail(name, "result size limit exceeded"); }
    array_push(out, value);
}

fn _flatten(value, maximum) {
    let out = [];
    _flatten_into("array_flatten", value, out, maximum, 0);
    return out;
}

fn _range(args, maximum) {
    if len(args) < 1 or len(args) > 3 { _fail("range", "expected 1 to 3 arguments"); }
    let start = 0; let finish = args[0]; let step = 1;
    if len(args) >= 2 { start = args[0]; finish = args[1]; }
    if len(args) == 3 { step = args[2]; }
    if not is_number(start) or not is_number(finish) or not is_number(step)
        or start != num_floor(start) or finish != num_floor(finish)
        or step != num_floor(step) or step == 0 {
        _fail("range", "integer bounds and a non-zero integer step are required");
    }
    let distance = if step > 0 { finish - start } else { start - finish };
    let stride = num_abs(step);
    let count = 0;
    if distance > 0 { count = num_floor((distance + stride - 1) / stride); }
    _bounded_count("range", count, maximum);
    if len(args) == 1 { return range(args[0]); }
    if len(args) == 2 { return range(args[0], args[1]); }
    return range(args[0], args[1], args[2]);
}

fn _guard_expansion(name, input_size, multiplier, maximum) {
    if not is_number(multiplier) or multiplier < 0 { _fail(name, "invalid expansion size"); }
    if input_size > maximum or input_size * multiplier > maximum {
        _fail(name, "result size limit exceeded");
    }
}

fn call(name, args, maximum) {
    if not has(name) { _fail(name, "unavailable"); }
    if not is_array(args) { _fail(name, "argument vector must be an array"); }

    if name == "len" { _arity(name, args, 1); return len(args[0]); }
    if name == "str" { _arity(name, args, 1); return _bounded_value(name, str(args[0]), maximum); }
    if name == "type" { _arity(name, args, 1); return type(args[0]); }
    if name == "is_array" { _arity(name, args, 1); return is_array(args[0]); }
    if name == "is_fn" { _arity(name, args, 1); return is_fn(args[0]); }
    if name == "is_map" { _arity(name, args, 1); return is_map(args[0]); }
    if name == "is_number" { _arity(name, args, 1); return is_number(args[0]); }
    if name == "is_string" { _arity(name, args, 1); return is_string(args[0]); }

    if name == "array_push" or name == "push" {
        _arity(name, args, 2); _at_most(name, args[0], maximum - 1, "array size");
        return array_push(args[0], args[1]);
    }
    if name == "array_pop" { _arity(name, args, 1); return array_pop(args[0]); }
    if name == "array_sort" { _arity(name, args, 1); _at_most(name, args[0], maximum, "array size"); return array_sort(args[0]); }
    if name == "array_flatten" { _arity(name, args, 1); return _flatten(args[0], maximum); }
    if name == "map_has" { _arity(name, args, 2); return map_has(args[0], args[1]); }
    if name == "map_keys" { _arity(name, args, 1); _at_most(name, args[0], maximum, "map size"); return map_keys(args[0]); }
    if name == "map_remove" { _arity(name, args, 2); return map_remove(args[0], args[1]); }
    if name == "path_join" {
        _arity(name, args, 2);
        if not is_string(args[0]) or not is_string(args[1]) {
            _fail(name, "expected two strings");
        }
        _at_most(name, args[0], maximum, "input size");
        _at_most(name, args[1], maximum, "input size");
        return _bounded_value(name, path_join(args[0], args[1]), maximum);
    }
    if name == "range" { return _range(args, maximum); }
    if name == "slice" { _arity(name, args, 3); return _bounded_value(name, slice(args[0], args[1], args[2]), maximum); }

    if name == "num_abs" { _arity(name, args, 1); return num_abs(args[0]); }
    if name == "num_floor" { _arity(name, args, 1); return num_floor(args[0]); }
    if name == "num_max" { _arity(name, args, 2); return num_max(args[0], args[1]); }
    if name == "num_min" { _arity(name, args, 2); return num_min(args[0], args[1]); }
    if name == "num_mod" { _arity(name, args, 2); return num_mod(args[0], args[1]); }
    if name == "num_sqrt" { _arity(name, args, 1); return num_sqrt(args[0]); }
    if name == "parse_number" { _arity(name, args, 1); return parse_number(args[0]); }
    if name == "num_to_le_bytes" { _arity(name, args, 1); return num_to_le_bytes(args[0]); }
    if name == "bigint" {
        _arity(name, args, 1);
        if not is_number(args[0]) and not is_string(args[0]) {
            _fail(name, "expected a number or decimal string");
        }
        if is_string(args[0]) { _at_most(name, args[0], maximum, "input size"); }
        return bigint(args[0]);
    }
    if name == "bit_and" { _arity(name, args, 2); return bit_and(args[0], args[1]); }
    if name == "bit_not" {
        _arity(name, args, 1);
        if not is_number(args[0]) { _fail(name, "expected a number"); }
        return bit_not(args[0]);
    }
    if name == "bit_or" { _arity(name, args, 2); return bit_or(args[0], args[1]); }
    if name == "bit_xor" { _arity(name, args, 2); return bit_xor(args[0], args[1]); }
    if name == "bit_shl" { _arity(name, args, 2); return bit_shl(args[0], args[1]); }
    if name == "bit_shr" { _arity(name, args, 2); return bit_shr(args[0], args[1]); }

    if name == "str_contains" { _arity(name, args, 2); return str_contains(args[0], args[1]); }
    if name == "str_ends_with" { _arity(name, args, 2); return str_ends_with(args[0], args[1]); }
    if name == "str_starts_with" { _arity(name, args, 2); return str_starts_with(args[0], args[1]); }
    if name == "str_index_of" { _arity(name, args, 2); return str_index_of(args[0], args[1]); }
    if name == "str_lower" { _arity(name, args, 1); return _bounded_value(name, str_lower(args[0]), maximum); }
    if name == "str_upper" { _arity(name, args, 1); return _bounded_value(name, str_upper(args[0]), maximum); }
    if name == "str_trim" { _arity(name, args, 1); return _bounded_value(name, str_trim(args[0]), maximum); }
    if name == "str_slice" { _arity(name, args, 3); return _bounded_value(name, str_slice(args[0], args[1], args[2]), maximum); }
    if name == "str_split" { _arity(name, args, 2); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, str_split(args[0], args[1]), maximum); }
    if name == "str_join" { _arity(name, args, 2); _at_most(name, args[0], maximum, "array size"); return _bounded_value(name, str_join(args[0], args[1]), maximum); }
    if name == "strcharcodeat" { _arity(name, args, 2); return strcharcodeat(args[0], args[1]); }
    if name == "strfromcharcode" { _arity(name, args, 1); return strfromcharcode(args[0]); }
    if name == "str_from_char_code" { _arity(name, args, 1); return str_from_char_code(args[0]); }
    if name == "str_repeat" {
        _arity(name, args, 2); _guard_expansion(name, len(args[0]), args[1], maximum);
        return str_repeat(args[0], args[1]);
    }
    if name == "regex_match" {
        _arity(name, args, 2);
        _at_most(name, args[0], maximum, "input size");
        _at_most(name, args[1], num_min(maximum, 4096), "pattern size");
        return regex_match(args[0], args[1]);
    }
    if name == "str_replace_all" or name == "regex_replace_all" {
        _arity(name, args, 3);
        _guard_expansion(name, len(args[0]) + 1, num_max(1, len(args[2])) + 1, maximum);
        let replaced = if name == "str_replace_all" {
            str_replace_all(args[0], args[1], args[2])
        } else { regex_replace_all(args[0], args[1], args[2]) };
        return _bounded_value(name, replaced, maximum);
    }
    if name == "str_pad_left" or name == "str_pad_right" {
        _arity(name, args, 3); _bounded_count(name, args[1], maximum);
        if name == "str_pad_left" { return str_pad_left(args[0], args[1], args[2]); }
        return str_pad_right(args[0], args[1], args[2]);
    }
    if name == "str_to_bytes" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, str_to_bytes(args[0]), maximum); }
    if name == "bytes_to_str" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, bytes_to_str(args[0]), maximum); }

    if name == "base64_encode" { _arity(name, args, 1); _guard_expansion(name, len(args[0]), 2, maximum); return base64_encode(args[0]); }
    if name == "base64_decode" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, base64_decode(args[0]), maximum); }
    if name == "base64_encode_bytes" { _arity(name, args, 1); _guard_expansion(name, len(args[0]), 2, maximum); return base64_encode_bytes(args[0]); }
    if name == "base64_decode_bytes" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, base64_decode_bytes(args[0]), maximum); }
    if name == "url_encode" { _arity(name, args, 1); _guard_expansion(name, len(str_to_bytes(args[0])), 3, maximum); return url_encode(args[0]); }
    if name == "json_parse" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, json_parse(args[0]), maximum); }
    if name == "json_stringify" { _arity(name, args, 1); return _bounded_value(name, json_stringify(args[0]), maximum); }
    if name == "http_parse_request" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return _bounded_value(name, http_parse_request(args[0]), maximum); }
    if name == "http_response" { _arity(name, args, 2); return _bounded_value(name, http_response(args[0], args[1]), maximum); }
    if name == "http_response_ct" { _arity(name, args, 3); return _bounded_value(name, http_response_ct(args[0], args[1], args[2]), maximum); }
    if name == "http_response_json" { _arity(name, args, 2); return _bounded_value(name, http_response_json(args[0], args[1]), maximum); }
    if name == "sha256" { _arity(name, args, 1); _at_most(name, args[0], maximum, "input size"); return sha256(args[0]); }
    if name == "hmac_sha256" { _arity(name, args, 2); _at_most(name, args[0], maximum, "input size"); _at_most(name, args[1], maximum, "key size"); return hmac_sha256(args[0], args[1]); }
    if name == "constant_time_eq" { _arity(name, args, 2); _at_most(name, args[0], maximum, "input size"); _at_most(name, args[1], maximum, "input size"); return constant_time_eq(args[0], args[1]); }
    if name == "error" { _arity(name, args, 1); throw str(args[0]); }

    _fail(name, "dispatch is missing");
}

export NAMES, has, call;
