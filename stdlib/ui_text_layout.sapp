// Fixed-cell label layout shared by measurement and drawing. Like GUI editing,
// columns count Unicode scalars, not grapheme clusters or proportional glyphs.
fn metrics(pixel_scale, heading = false) {
    let ps=num_floor(pixel_scale);
    if heading { ps=num_ceil(ps*1.5); }
    ps=num_max(1,num_min(8,ps));
    return map{pixel_scale:ps,advance:6*ps,line_height:10*ps};
}

fn wrap(value, columns) {
    if type(columns)!="number" or not (columns>=1 and columns<=65536)
        or columns!=num_floor(columns) { throw "ui text columns must be an integer from 1 to 65536"; }
    let text=str(value);
    if len(text)>65536 { throw "ui text length exceeds 65536 scalars"; }
    text=str_join(str_split(text,"\r\n"),"\n");
    text=str_join(str_split(text,"\r"),"\n");
    text=str_join(str_split(text,"\t"),"    ");
    let lines=[];
    for paragraph in str_split(text,"\n") {
        let chars=str_split(paragraph,""); let start=0;
        if len(chars)==0 { array_push(lines,""); }
        while start<len(chars) {
            let end=num_min(start+columns,len(chars));
            let stop=end;
            if end<len(chars) and chars[end]!=" " {
                let i=start; let space=-1;
                while i<end { if chars[i]==" " { space=i; } i=i+1; }
                if space>start { stop=space; }
            }
            let parts=[]; let i=start;
            while i<stop { array_push(parts,chars[i]); i=i+1; }
            array_push(lines,str_join(parts,""));
            start=stop;
            // Spaces at a soft line break are separators, not indentation.
            while start<len(chars) and chars[start]==" " { start=start+1; }
        }
    }
    return lines;
}
export metrics,wrap;
