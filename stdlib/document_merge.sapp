// Compile once per document, then merge literal table rows; no I/O or evaluation.
let Text=import("stdlib:text_document.sapp");let Sheet=import("stdlib:sheet_document.sapp");let Fields=import("stdlib:template_fields.sapp");
let MAX_BATCH_BYTES=262144;
fn render(template,table) {
 Text.validate(template);let size=Sheet.validate(table);
 if size.rows<2 {throw "merge needs a header and at least one data row";}
 let headers=table.cells[0];let available=map{};
 for key in headers {if not Fields.valid_name(key) or map_has(available,key) {throw "merge headers must be unique field names";}available[key]=true;}
 let title=Fields.compile(template.title);let plans=[];let names=[];let seen=map{};
 array_push(plans,title);for block in template.blocks {array_push(plans,Fields.compile(block.text));}
 for plan in plans {for name in Fields.names(plan) {
  if not map_has(available,name) {throw "template field has no table column";}
  if not map_has(seen,name) {seen[name]=true;array_push(names,name);}
 }}
 let documents=[];let total=0;
 for row in range(1,size.rows) {
  let context=map{};for col in range(0,size.columns) {context[headers[col]]=table.cells[row][col];}
  let doc=Text.create(Fields.render_compiled(title,context,256));doc.blocks=[];
  for b in range(0,len(template.blocks)) {array_push(doc.blocks,map{kind:template.blocks[b].kind,text:Fields.render_compiled(plans[b+1],context,Text.MAX_BLOCK_BYTES)});}
  let stats=Text.validate(doc);total=total+stats.text_bytes;
  if total>MAX_BATCH_BYTES {throw "merge batch output limit";}
  array_push(documents,doc);
 }
 return map{format:"pblang.document-merge.v1",documents:documents,fields:names,count:len(documents),text_bytes:total,contains_source_text:true,safe_to_log:false};
}
export MAX_BATCH_BYTES,render;
