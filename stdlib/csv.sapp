// stdlib/csv.sapp — RFC 4180 CSV parsing and generation (G2)
//
// Provides comprehensive CSV utilities: parsing, stringifying,
// file I/O with header-aware column mapping.
//
// Usage:
//   let csv = import("stdlib:csv.sapp");
//   let rows = csv.parse(text, ",", true);           // parse with headers
//   let text = csv.stringify(data, ",", ["a","b"]);  // array of maps → CSV
//   let rows = csv.read_file("data.csv", ",", true); // read from file
//   csv.write_file("out.csv", data, ",");            // write to file

// ── Low-level line parser ────────────────────────────────────────────────

// parse_line(line, delimiter) — parse one CSV record into an array of fields.
// Handles: quoted fields, escaped quotes (""), embedded delimiters/newlines.
fn parse_line(line, delimiter = ",") {
    // Most machine-generated CSV has no quoted fields. Let the native splitter
    // handle that common case; quoted records retain the full RFC 4180 parser.
    if delimiter != "" and str_index_of(line, "\"") < 0 { return str_split(line, delimiter); }
    let result = [];
    let n = len(line);
    let i = 0;
    let field = "";
    while i < n {
        let ch = str_slice(line, i, i + 1);
        if ch == "\"" {
            i = i + 1;
            let in_q = true;
            while i < n and in_q == true {
                let c2 = str_slice(line, i, i + 1);
                if c2 == "\"" {
                    // Check for escaped quote ("")
                    let c3 = str_slice(line, i + 1, i + 2);
                    if c3 == "\"" {
                        field = field + "\"";
                        i = i + 2;
                    } else {
                        in_q = false;
                        i = i + 1;
                    }
                } else {
                    field = field + c2;
                    i = i + 1;
                }
            }
        } else if ch == delimiter {
            array_push(result, field);
            field = "";
            i = i + 1;
        } else {
            field = field + ch;
            i = i + 1;
        }
    }
    array_push(result, field);
    return result;
}

fn _strip_trailing_cr(line) {
    if len(line) > 0 and str_slice(line, len(line) - 1, len(line)) == "\r" {
        return str_slice(line, 0, len(line) - 1);
    }
    return line;
}

fn _record_is_blank(record) {
    return len(str_trim(_strip_trailing_cr(record))) == 0;
}

// split_records(text) — split CSV text into quote-aware records.
// Unlike str_split(text, "\n"), this preserves newlines inside quoted fields.
fn split_records(text) {
    // Without quotes, records cannot contain embedded newlines. This avoids a
    // character-by-character scan for the common case while preserving CRLF
    // cleanup and the original trailing-newline behavior.
    if str_index_of(text, "\"") < 0 {
        let lines = str_split(text, "\n");
        let records = [];
        let i = 0;
        while i < len(lines) {
            if i < len(lines) - 1 or lines[i] != "" {
                array_push(records, _strip_trailing_cr(lines[i]));
            }
            i = i + 1;
        }
        return records;
    }
    let records = [];
    let record = "";
    let in_q = false;
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        if ch == "\"" {
            record = record + ch;
            if in_q == true and str_slice(text, i + 1, i + 2) == "\"" {
                record = record + "\"";
                i = i + 2;
                continue;
            }
            in_q = not in_q;
            i = i + 1;
            continue;
        }
        if ch == "\n" and in_q == false {
            array_push(records, _strip_trailing_cr(record));
            record = "";
            i = i + 1;
            continue;
        }
        record = record + ch;
        i = i + 1;
    }
    if len(record) > 0 {
        array_push(records, _strip_trailing_cr(record));
    }
    return records;
}

// ── Main parse API ───────────────────────────────────────────────────────

// parse(text, delimiter, has_header) → array of maps (with headers) or array of arrays
//
// If has_header is true, the first row is treated as column names and each
// subsequent row becomes a map with those keys.
// If has_header is false or nil, each row is returned as an array of strings.
fn parse(text, delimiter = ",", has_header = false) {
    let records = split_records(text);
    let rows = [];

    // Skip empty trailing lines
    let record_count = 0;
    let i = 0;
    while i < len(records) {
        if _record_is_blank(records[i]) == false { record_count = record_count + 1; }
        i = i + 1;
    }

    if record_count == 0 { return []; }

    // Parse headers if requested
    let headers = [];
    let start_record = 0;
    if has_header == true and record_count > 0 {
        // Find first non-empty record as header
        let hi = 0;
        while hi < len(records) {
            if _record_is_blank(records[hi]) == false {
                headers = parse_line(records[hi], delimiter);
                start_record = hi + 1;
                break;
            }
            hi = hi + 1;
        }
    }

    // Parse data rows
    let actual = 0;
    while actual < len(records) {
        let record = records[actual];
        if actual >= start_record and _record_is_blank(record) == false {
            let fields = parse_line(record, delimiter);
            if has_header == true and len(headers) > 0 {
                let row_map = map{};
                let fi = 0;
                while fi < len(headers) {
                    let val = "";
                    if fi < len(fields) { val = fields[fi]; }
                    row_map[headers[fi]] = val;
                    fi = fi + 1;
                }
                array_push(rows, row_map);
            } else {
                array_push(rows, fields);
            }
        }
        actual = actual + 1;
    }
    return rows;
}

fn parse_records(text, delimiter = ",") {
    return parse(text, delimiter, false);
}

fn parse_maps(text, delimiter = ",") {
    return parse(text, delimiter, true);
}

fn headers(text, delimiter = ",") {
    let records = split_records(text);
    let i = 0;
    while i < len(records) {
        if _record_is_blank(records[i]) == false {
            return parse_line(records[i], delimiter);
        }
        i = i + 1;
    }
    return [];
}

fn to_maps(rows, headers) {
    let out = [];
    let ri = 0;
    while ri < len(rows) {
        let item = map{};
        let row = rows[ri];
        let hi = 0;
        while hi < len(headers) {
            let val = "";
            if hi < len(row) { val = row[hi]; }
            item[headers[hi]] = val;
            hi = hi + 1;
        }
        array_push(out, item);
        ri = ri + 1;
    }
    return out;
}

fn infer_headers(data) {
    let keys = [];
    let seen = map{};
    let ri = 0;
    while ri < len(data) {
        let row = data[ri];
        if type(row) == "map" {
            let row_keys = map_keys(row);
            let ki = 0;
            while ki < len(row_keys) {
                let key = row_keys[ki];
                if not map_has(seen, key) {
                    seen[key] = true;
                    array_push(keys, key);
                }
                ki = ki + 1;
            }
        }
        ri = ri + 1;
    }
    return keys;
}

// ── Stringify (map/array → CSV) ──────────────────────────────────────────

// _needs_quoting(s, delimiter) — check if a field needs quoting
fn _needs_quoting(s, delimiter = ",") {
    if str_index_of(s, delimiter) >= 0 { return true; }
    if str_index_of(s, "\"") >= 0 { return true; }
    if str_index_of(s, "\n") >= 0 { return true; }
    if str_index_of(s, "\r") >= 0 { return true; }
    // Non-empty whitespace-only fields must be quoted: unquoted they make the
    // whole line look blank, and parse() drops blank records.
    if s != "" and len(str_trim(s)) == 0 { return true; }
    return false;
}

// _quote_field(s) — escape a CSV field with RFC 4180 quoting
fn _quote_field(s) {
    return "\"" + str_join(str_split(s, "\""), "\"\"") + "\"";
}

// _encode_field(s, delimiter) — quote a field only when RFC 4180 requires it
// (field contains the delimiter, a double-quote, LF, or CR). Plain fields
// are emitted as-is so a parse → stringify round-trip is lossless.
fn _encode_field(s, delimiter) {
    if _needs_quoting(s, delimiter) { return _quote_field(s); }
    return s;
}

// sanitize_field(s) — neutralize CSV/formula injection. A field whose first
// character is one of = + - @ (or a leading tab/CR) is treated as a formula by
// Excel / Google Sheets / LibreOffice and can run code or exfiltrate data when
// the file is opened. Prefixing a single quote forces it to be read as text.
fn sanitize_field(s) {
    let v = str(s);
    if len(v) == 0 { return v; }
    let first = str_slice(v, 0, 1);
    if first == "=" or first == "+" or first == "-" or first == "@" or first == "\t" or first == "\r" {
        return "'" + v;
    }
    return v;
}

fn _maybe_sanitize(s, sanitize) {
    if sanitize { return sanitize_field(s); }
    return s;
}

// A row whose single field is empty would serialize to a blank line, which
// parse() skips — the row would vanish on round trip. Emit "" instead
// (same disambiguation Python's csv writer uses).
fn _nonblank_line(line, field_count) {
    if line == "" and field_count == 1 { return "\"\""; }
    return line;
}

// _stringify(data, delimiter, headers, sanitize) — shared serializer.
fn _stringify(data, delimiter, headers, sanitize) {
    if len(data) == 0 { return ""; }

    let output = "";

    // Detect format: if first element is a map, use headers
    let first = data[0];
    let is_map = (type(first) == "map");

    if is_map {
        if headers == nil { headers = infer_headers(data); }
        // Write header row
        let header_line = "";
        let hi = 0;
        while hi < len(headers) {
            if hi > 0 { header_line = header_line + delimiter; }
            header_line = header_line + _encode_field(_maybe_sanitize(headers[hi], sanitize), delimiter);
            hi = hi + 1;
        }
        output = output + header_line + "\n";

        // Write data rows
        let ri = 0;
        while ri < len(data) {
            let row = data[ri];
            let line = "";
            let fi = 0;
            while fi < len(headers) {
                if fi > 0 { line = line + delimiter; }
                let val = _maybe_sanitize(str(try row[headers[fi]] catch ""), sanitize);
                line = line + _encode_field(val, delimiter);
                fi = fi + 1;
            }
            output = output + _nonblank_line(line, len(headers)) + "\n";
            ri = ri + 1;
        }
    } else {
        // Array of arrays — no header row
        let ri = 0;
        while ri < len(data) {
            let row = data[ri];
            let line = "";
            let fi = 0;
            while fi < len(row) {
                if fi > 0 { line = line + delimiter; }
                let val = _maybe_sanitize(str(try row[fi] catch ""), sanitize);
                line = line + _encode_field(val, delimiter);
                fi = fi + 1;
            }
            output = output + _nonblank_line(line, len(row)) + "\n";
            ri = ri + 1;
        }
    }

    return output;
}

// stringify(data, delimiter, headers) → CSV string. Plain fields are emitted
// as-is so a parse → stringify round-trip is lossless. NOTE: this does NOT guard
// against formula injection — use stringify_safe() when the data is untrusted
// and the file may be opened in a spreadsheet.
fn stringify(data, delimiter = ",", headers = nil) {
    return _stringify(data, delimiter, headers, false);
}

// stringify_safe(data, delimiter, headers) → CSV string with formula-injection
// sanitization applied to every field (see sanitize_field).
fn stringify_safe(data, delimiter = ",", headers = nil) {
    return _stringify(data, delimiter, headers, true);
}

fn stringify_rows(rows, delimiter = ",") {
    return stringify(rows, delimiter, nil);
}

fn stringify_maps(rows, delimiter = ",", headers = nil) {
    return stringify(rows, delimiter, headers);
}

// ── Type inference ─────────────────────────────────────────────────────────

// coerce(v) — best-effort scalar typing of a CSV string: "true"/"false" → bool,
// numeric strings → number, everything else (including "") left as a string.
fn coerce(v) {
    if type(v) != "string" { return v; }
    if v == "" { return ""; }
    if v == "true" { return true; }
    if v == "false" { return false; }
    let n = try parse_number(v) catch nil;
    if n != nil { return n; }
    return v;
}

// parse_typed(text, delimiter, has_header) — like parse(), but each cell is run
// through coerce() so numbers and booleans come back as real values.
fn parse_typed(text, delimiter = ",", has_header = false) {
    let rows = parse(text, delimiter, has_header);
    let i = 0;
    while i < len(rows) {
        let row = rows[i];
        if type(row) == "map" {
            let ks = map_keys(row);
            let j = 0;
            while j < len(ks) { row[ks[j]] = coerce(row[ks[j]]); j = j + 1; }
        } else {
            let j = 0;
            while j < len(row) { row[j] = coerce(row[j]); j = j + 1; }
        }
        i = i + 1;
    }
    return rows;
}

// parse_options(text, options) — one-call configurable parser. Existing parse()
// remains the minimal fast path; this form adds optional typing and defensive
// input/shape limits for untrusted or bulk data.
fn parse_options(text, options = nil) {
    let delimiter = ",";
    let has_header = false;
    let typed = false;
    let max_chars = nil;
    let max_rows = nil;
    let max_columns = nil;
    if options != nil {
        delimiter = try options.delimiter catch delimiter;
        has_header = try options.header catch has_header;
        typed = try options.typed catch typed;
        max_chars = try options.max_chars catch max_chars;
        max_rows = try options.max_rows catch max_rows;
        max_columns = try options.max_columns catch max_columns;
    }
    if max_chars != nil and len(text) > max_chars {
        throw "csv.parse_options: input exceeds max_chars";
    }
    let rows = if typed {
        parse_typed(text, delimiter, has_header)
    } else {
        parse(text, delimiter, has_header)
    };
    if max_rows != nil and len(rows) > max_rows {
        throw "csv.parse_options: input exceeds max_rows";
    }
    if max_columns != nil {
        let i = 0;
        while i < len(rows) {
            let count = if type(rows[i]) == "map" { len(map_keys(rows[i])) } else { len(rows[i]) };
            if count > max_columns { throw "csv.parse_options: input exceeds max_columns"; }
            i = i + 1;
        }
    }
    return rows;
}

// stringify_options(data, options) — configurable serializer with optional
// spreadsheet-injection protection and a deterministic output-size cap.
fn stringify_options(data, options = nil) {
    let delimiter = ",";
    let headers = nil;
    let safe = false;
    let max_chars = nil;
    if options != nil {
        delimiter = try options.delimiter catch delimiter;
        headers = try options.headers catch headers;
        safe = try options.safe catch safe;
        max_chars = try options.max_chars catch max_chars;
    }
    let out = _stringify(data, delimiter, headers, safe);
    if max_chars != nil and len(out) > max_chars {
        throw "csv.stringify_options: output exceeds max_chars";
    }
    return out;
}

// ── TSV convenience (tab-separated) ─────────────────────────────────────────

fn parse_tsv(text, has_header = false) { return parse(text, "\t", has_header); }
fn stringify_tsv(data, headers = nil) { return stringify(data, "\t", headers); }

// ── Columnar transforms ─────────────────────────────────────────────────────

// to_columns(rows) — array-of-maps → map of column-name → array of values.
fn to_columns(rows) {
    let cols = infer_headers(rows);
    let out = map{};
    let c = 0;
    while c < len(cols) {
        let name = cols[c];
        let arr = [];
        let r = 0;
        while r < len(rows) { arr[len(arr)] = try rows[r][name] catch nil; r = r + 1; }
        out[name] = arr;
        c = c + 1;
    }
    return out;
}

// from_columns(cols_map) — map of column-name → array → array-of-maps. Row count
// follows the first column.
fn from_columns(cols_map) {
    let names = map_keys(cols_map);
    let n = 0;
    if len(names) > 0 { n = len(cols_map[names[0]]); }
    let out = [];
    let r = 0;
    while r < n {
        let row = map{};
        let c = 0;
        while c < len(names) { row[names[c]] = try cols_map[names[c]][r] catch nil; c = c + 1; }
        out[len(out)] = row;
        r = r + 1;
    }
    return out;
}

// ── File I/O ─────────────────────────────────────────────────────────────

// read_file(path, delimiter, has_header) — read CSV from a file
fn read_file(path, delimiter = ",", has_header = false) {
    let content = try fs_read(path) catch "";
    if content == "" { return []; }
    return parse(content, delimiter, has_header);
}

// write_file(path, data, delimiter, headers) — write array of maps as CSV
fn write_file(path, data, delimiter = ",", headers = nil) {
    let csv_text = stringify(data, delimiter, headers);
    return fs_write(path, csv_text);
}

export parse_line, split_records, parse, parse_records, parse_maps, headers, to_maps, infer_headers,
       stringify, stringify_rows, stringify_maps, stringify_safe, sanitize_field,
       coerce, parse_typed, parse_options, stringify_options,
       parse_tsv, stringify_tsv, to_columns, from_columns,
       read_file, write_file;
