// stdlib/csv.sapp — RFC 4180 CSV parsing (G1)

fn parse_line(line) {
    let result = [];
    let n = len(line);
    let i = 0;
    let field = "";
    while i < n {
        let ch = str_slice(line, i, i + 1);
        if ch == "\"" {
            i = i + 1;
            let in_q = true;
            while i < n and in_q == true {
                let c2 = str_slice(line, i, i + 1);
                if c2 == "\"" {
                    let c3 = str_slice(line, i + 1, i + 2);
                    if c3 == "\"" {
                        field = field + "\"";
                        i = i + 2;
                    } else {
                        in_q = false;
                        i = i + 1;
                    }
                } else {
                    field = field + c2;
                    i = i + 1;
                }
            }
        } else if ch == "," {
            array_push(result, field);
            field = "";
            i = i + 1;
        } else {
            field = field + ch;
            i = i + 1;
        }
    }
    array_push(result, field);
    return result;
}

fn parse(text) {
    let lines = str_split(text, "\n");
    let rows = [];
    for i len(lines) {
        let line = str_trim(lines[i]);
        if len(line) > 0 {
            array_push(rows, parse_line(line));
        }
    }
    return rows;
}

export parse_line, parse;
