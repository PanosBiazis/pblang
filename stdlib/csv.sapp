// stdlib/csv.sapp — RFC 4180 CSV parsing and generation (G2)
//
// Provides comprehensive CSV utilities: parsing, stringifying,
// file I/O with header-aware column mapping.
//
// Usage:
//   let csv = import("stdlib:csv.sapp");
//   let rows = csv.parse(text, ",", true);           // parse with headers
//   let text = csv.stringify(data, ",", ["a","b"]);  // array of maps → CSV
//   let rows = csv.read_file("data.csv", ",", true); // read from file
//   csv.write_file("out.csv", data, ",");            // write to file

// ── Low-level line parser ────────────────────────────────────────────────

// parse_line(line, delimiter) — parse one CSV line into an array of fields.
// Handles: quoted fields, escaped quotes (""), embedded delimiters.
fn parse_line(line, delimiter = ",") {
    let result = [];
    let n = len(line);
    let i = 0;
    let field = "";
    while i < n {
        let ch = str_slice(line, i, i + 1);
        if ch == "\"" {
            i = i + 1;
            let in_q = true;
            while i < n and in_q == true {
                let c2 = str_slice(line, i, i + 1);
                if c2 == "\"" {
                    // Check for escaped quote ("")
                    let c3 = str_slice(line, i + 1, i + 2);
                    if c3 == "\"" {
                        field = field + "\"";
                        i = i + 2;
                    } else {
                        in_q = false;
                        i = i + 1;
                    }
                } else {
                    field = field + c2;
                    i = i + 1;
                }
            }
        } else if ch == delimiter {
            array_push(result, field);
            field = "";
            i = i + 1;
        } else {
            field = field + ch;
            i = i + 1;
        }
    }
    array_push(result, field);
    return result;
}

// ── Main parse API ───────────────────────────────────────────────────────

// parse(text, delimiter, has_header) → array of maps (with headers) or array of arrays
//
// If has_header is true, the first row is treated as column names and each
// subsequent row becomes a map with those keys.
// If has_header is false or nil, each row is returned as an array of strings.
fn parse(text, delimiter = ",", has_header = false) {
    let lines = str_split(text, "\n");
    let rows = [];

    // Skip empty trailing lines
    let line_count = 0;
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if len(line) > 0 { line_count = line_count + 1; }
        i = i + 1;
    }

    if line_count == 0 { return []; }

    // Parse headers if requested
    let headers = [];
    let start_line = 0;
    if has_header == true and line_count > 0 {
        // Find first non-empty line as header
        let hi = 0;
        while hi < len(lines) {
            let hline = str_trim(lines[hi]);
            if len(hline) > 0 {
                headers = parse_line(hline, delimiter);
                start_line = hi + 1;
                break;
            }
            hi = hi + 1;
        }
    }

    // Parse data rows
    let actual = 0;
    while actual < len(lines) {
        let line = str_trim(lines[actual]);
        if actual >= start_line and len(line) > 0 {
            let fields = parse_line(line, delimiter);
            if has_header == true and len(headers) > 0 {
                let row_map = map{};
                let fi = 0;
                while fi < len(headers) and fi < len(fields) {
                    row_map[headers[fi]] = fields[fi];
                    fi = fi + 1;
                }
                array_push(rows, row_map);
            } else {
                array_push(rows, fields);
            }
        }
        actual = actual + 1;
    }
    return rows;
}

// ── Stringify (map/array → CSV) ──────────────────────────────────────────

// _needs_quoting(s, delimiter) — check if a field needs quoting
fn _needs_quoting(s, delimiter = ",") {
    if str_index_of(s, delimiter) >= 0 { return true; }
    if str_index_of(s, "\"") >= 0 { return true; }
    if str_index_of(s, "\n") >= 0 { return true; }
    return false;
}

// _quote_field(s) — escape a CSV field with RFC 4180 quoting
fn _quote_field(s) {
    // Escape double-quotes by doubling them
    let result = "";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if ch == "\"" {
            result = result + "\"\"";
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    return "\"" + result + "\"";
}

// _encode_field(s, delimiter) — quote a field only when RFC 4180 requires it
// (field contains the delimiter, a double-quote, or a newline). Plain fields
// are emitted as-is so a parse → stringify round-trip is lossless.
fn _encode_field(s, delimiter) {
    if _needs_quoting(s, delimiter) { return _quote_field(s); }
    return s;
}

// stringify(data, delimiter, headers) → CSV string
// data: array of maps (if headers provided) or array of arrays
// headers: optional ordered list of column names (used as map keys)
fn stringify(data, delimiter = ",", headers = nil) {
    if len(data) == 0 { return ""; }

    let output = "";

    // Detect format: if first element is a map, use headers
    let first = data[0];
    let is_map = (type(first) == "map");

    if is_map {
        if headers == nil { headers = map_keys(first); }
        // Write header row
        let hi = 0;
        while hi < len(headers) {
            if hi > 0 { output = output + delimiter; }
            output = output + _encode_field(headers[hi], delimiter);
            hi = hi + 1;
        }
        output = output + "\n";

        // Write data rows
        let ri = 0;
        while ri < len(data) {
            let row = data[ri];
            let fi = 0;
            while fi < len(headers) {
                if fi > 0 { output = output + delimiter; }
                let val = str(try row[headers[fi]] catch "");
                output = output + _encode_field(val, delimiter);
                fi = fi + 1;
            }
            output = output + "\n";
            ri = ri + 1;
        }
    } else {
        // Array of arrays — no header row
        let ri = 0;
        while ri < len(data) {
            let row = data[ri];
            let fi = 0;
            while fi < len(row) {
                if fi > 0 { output = output + delimiter; }
                let val = str(try row[fi] catch "");
                output = output + _encode_field(val, delimiter);
                fi = fi + 1;
            }
            output = output + "\n";
            ri = ri + 1;
        }
    }

    return output;
}

// ── File I/O ─────────────────────────────────────────────────────────────

// read_file(path, delimiter, has_header) — read CSV from a file
fn read_file(path, delimiter = ",", has_header = false) {
    let content = try fs_read(path) catch "";
    if content == "" { return []; }
    return parse(content, delimiter, has_header);
}

// write_file(path, data, delimiter, headers) — write array of maps as CSV
fn write_file(path, data, delimiter = ",", headers = nil) {
    let csv_text = stringify(data, delimiter, headers);
    return fs_write(path, csv_text);
}

export parse_line, parse, stringify, read_file, write_file;
