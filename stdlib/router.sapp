// stdlib/router.sapp — HTTP routing (W3)

fn route_map() { return []; }

fn add_route(routes, method, path, handler) {
    array_push(routes, map{ method: method, path: path, handler: handler });
    return routes;
}

fn _split_path(p) {
    let parts = str_split(p, "/");
    let out = [];
    for i len(parts) {
        if parts[i] != "" { array_push(out, parts[i]); }
    }
    return out;
}

fn _match_path(pattern, path) {
    let p = _split_path(pattern);
    let s = _split_path(path);
    if len(p) != len(s) { return nil; }
    let params = map{};
    for i len(p) {
        if str_starts_with(p[i], ":") {
            let kv = str_split(p[i], ":");
            let pname = try kv[1] catch p[i];
            params[pname] = s[i];
        } else {
            if p[i] != s[i] { return nil; }
        }
    }
    return params;
}

fn dispatch(routes, method, path, req) {
    for i len(routes) {
        let r = routes[i];
        if r["method"] == method {
            let params = _match_path(r["path"], path);
            if params != nil {
                req["params"] = params;
                return r["handler"](req);
            }
        }
    }
    return map{ "status": 404, "body": "not found" };
}

export route_map, add_route, dispatch;
