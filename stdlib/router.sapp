// stdlib/router.sapp — HTTP routing (W3)
//
// Patterns:
//   /users/:id        — `:name` captures one segment into params[name]
//   /static/*path     — `*name` (catch-all, must be last) captures the rest of
//                       the path (joined by "/") into params[name]
//   /users            — literal segments match exactly
//
// dispatch returns the handler's result, or:
//   404 not found            — no route's PATH matched
//   405 method not allowed   — a path matched but no registered method did
//                              (the response carries `allow`, the methods that do)
// A HEAD request also matches a GET route (HTTP semantics).

fn route_map() { return []; }

// add_route(routes, method, path, handler). `method` may be a single string
// ("GET") or a LIST of methods (["GET","POST"]) that all map to one handler.
fn add_route(routes, method, path, handler) {
    array_push(routes, map{ method: method, path: path, handler: handler });
    return routes;
}

// add_any(routes, methods, path, handler) — register one handler for several
// methods (a readable alias for add_route with a list).
fn add_any(routes, methods, path, handler) {
    return add_route(routes, methods, path, handler);
}

// mount(parent, prefix, subroutes) — append every route in `subroutes` to
// `parent` with `prefix` prepended to its path (route groups / sub-routers).
fn mount(parent, prefix, subroutes) {
    let i = 0;
    while i < len(subroutes) {
        let r = subroutes[i];
        array_push(parent, map{ method: r["method"], path: prefix + r["path"], handler: r["handler"] });
        i = i + 1;
    }
    return parent;
}

// A route's method(s) as a list (so single-string and list registrations are
// handled uniformly).
fn _route_methods(r) {
    let m = r["method"];
    if is_array(m) { return m; }
    return [m];
}

// Minimal query-string parser (decoded, last value wins on repeated keys).
fn _parse_query(qs) {
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        if pair != "" {
            let eq = str_index_of(pair, "=");
            if eq >= 0 {
                out[url_decode(str_slice(pair, 0, eq))] = url_decode(str_slice(pair, eq + 1, len(pair)));
            } else {
                out[url_decode(pair)] = "";
            }
        }
        i = i + 1;
    }
    return out;
}

fn _split_path(p) {
    let parts = str_split(p, "/");
    let out = [];
    let i = 0;
    while i < len(parts) {
        if parts[i] != "" { array_push(out, parts[i]); }
        i = i + 1;
    }
    return out;
}

// Match `path` against `pattern`. Returns a params map (possibly empty) or nil.
fn _match_path(pattern, path) {
    let p = _split_path(pattern);
    let s = _split_path(path);
    let params = map{};
    let i = 0;
    while i < len(p) {
        let seg = p[i];
        if str_starts_with(seg, "*") {
            // Catch-all: binds every remaining path segment (joined by "/"),
            // including none (empty string). Always the last meaningful segment.
            let name = str_slice(seg, 1, len(seg));
            if name == "" { name = "wildcard"; }
            let rest = [];
            let j = i;
            while j < len(s) { array_push(rest, s[j]); j = j + 1; }
            params[name] = str_join(rest, "/");
            return params;
        }
        if i >= len(s) { return nil; }   // pattern longer than the path
        if str_starts_with(seg, ":") {
            let kv = str_split(seg, ":");
            let pname = try kv[1] catch seg;
            params[pname] = s[i];
        } else {
            if seg != s[i] { return nil; }
        }
        i = i + 1;
    }
    // No wildcard consumed the tail: the lengths must match exactly.
    if len(s) != len(p) { return nil; }
    return params;
}

// A request method matches a route method if equal, or if a HEAD request hits a
// GET route (the server sends the same handler, dropping the body).
fn _method_matches(req_method, route_method) {
    if req_method == route_method { return true; }
    if req_method == "HEAD" and route_method == "GET" { return true; }
    return false;
}

fn _has(list, v) {
    let i = 0;
    while i < len(list) { if list[i] == v { return true; } i = i + 1; }
    return false;
}

fn dispatch(routes, method, raw_path, req) {
    if req == nil { req = map{}; }
    // Strip and parse the query string so it never leaks into path matching, and
    // expose it (plus the clean path) on the request.
    let qsplit = str_split(raw_path, "?");
    let path = qsplit[0];
    let qs = try qsplit[1] catch "";
    req["path"] = path;
    req["query"] = _parse_query(qs);

    let path_matched = false;
    let allow = [];
    let i = 0;
    while i < len(routes) {
        let r = routes[i];
        let params = _match_path(r["path"], path);
        if params != nil {
            path_matched = true;
            let methods = _route_methods(r);
            let mi = 0;
            while mi < len(methods) {
                let rm = methods[mi];
                if not _has(allow, rm) { array_push(allow, rm); }
                if _method_matches(method, rm) {
                    req["params"] = params;
                    return r["handler"](req);
                }
                mi = mi + 1;
            }
        }
        i = i + 1;
    }
    if path_matched {
        // Path exists but not for this method. Answer an OPTIONS preflight with the
        // allowed methods; otherwise 405 Method Not Allowed.
        if method == "OPTIONS" {
            return map{ status: 204, body: "", allow: allow };
        }
        return map{ status: 405, body: "method not allowed", allow: allow };
    }
    return map{ status: 404, body: "not found" };
}

// route_count(routes) — number of registered routes.
fn route_count(routes) { return len(routes); }

// paths(routes) — the registered path patterns (in registration order).
fn paths(routes) {
    let out = [];
    let i = 0;
    while i < len(routes) { array_push(out, routes[i].path); i = i + 1; }
    return out;
}

// has_route(routes, method, path) — is an exact method+path pattern registered?
fn has_route(routes, method, path) {
    let i = 0;
    while i < len(routes) {
        if routes[i].path == path and _method_matches(method, routes[i].method) { return true; }
        i = i + 1;
    }
    return false;
}

export route_map, add_route, add_any, mount, dispatch;
export route_count, paths, has_route;
