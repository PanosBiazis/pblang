// stdlib/router.sapp — HTTP routing (W3)
//
// Patterns:
//   /users/:id        — `:name` captures one segment into params[name]
//   /static/*path     — `*name` (catch-all, must be last) captures the rest of
//                       the path (joined by "/") into params[name]
//   /users            — literal segments match exactly
//
// dispatch returns the handler's result, or:
//   404 not found            — no route's PATH matched
//   405 method not allowed   — a path matched but no registered method did
//                              (the response carries `allow`, the methods that do)
// A HEAD request also matches a GET route (HTTP semantics).

fn route_map() { return []; }

fn add_route(routes, method, path, handler) {
    array_push(routes, map{ method: method, path: path, handler: handler });
    return routes;
}

fn _split_path(p) {
    let parts = str_split(p, "/");
    let out = [];
    let i = 0;
    while i < len(parts) {
        if parts[i] != "" { array_push(out, parts[i]); }
        i = i + 1;
    }
    return out;
}

// Match `path` against `pattern`. Returns a params map (possibly empty) or nil.
fn _match_path(pattern, path) {
    let p = _split_path(pattern);
    let s = _split_path(path);
    let params = map{};
    let i = 0;
    while i < len(p) {
        let seg = p[i];
        if str_starts_with(seg, "*") {
            // Catch-all: binds every remaining path segment (joined by "/"),
            // including none (empty string). Always the last meaningful segment.
            let name = str_slice(seg, 1, len(seg));
            if name == "" { name = "wildcard"; }
            let rest = [];
            let j = i;
            while j < len(s) { array_push(rest, s[j]); j = j + 1; }
            params[name] = str_join(rest, "/");
            return params;
        }
        if i >= len(s) { return nil; }   // pattern longer than the path
        if str_starts_with(seg, ":") {
            let kv = str_split(seg, ":");
            let pname = try kv[1] catch seg;
            params[pname] = s[i];
        } else {
            if seg != s[i] { return nil; }
        }
        i = i + 1;
    }
    // No wildcard consumed the tail: the lengths must match exactly.
    if len(s) != len(p) { return nil; }
    return params;
}

// A request method matches a route method if equal, or if a HEAD request hits a
// GET route (the server sends the same handler, dropping the body).
fn _method_matches(req_method, route_method) {
    if req_method == route_method { return true; }
    if req_method == "HEAD" and route_method == "GET" { return true; }
    return false;
}

fn _has(list, v) {
    let i = 0;
    while i < len(list) { if list[i] == v { return true; } i = i + 1; }
    return false;
}

fn dispatch(routes, method, path, req) {
    let path_matched = false;
    let allow = [];
    let i = 0;
    while i < len(routes) {
        let r = routes[i];
        let params = _match_path(r["path"], path);
        if params != nil {
            path_matched = true;
            if not _has(allow, r["method"]) { array_push(allow, r["method"]); }
            if _method_matches(method, r["method"]) {
                req["params"] = params;
                return r["handler"](req);
            }
        }
        i = i + 1;
    }
    if path_matched {
        // Path exists but not for this method -> 405 with the allowed methods.
        return map{ status: 405, body: "method not allowed", allow: allow };
    }
    return map{ status: 404, body: "not found" };
}

export route_map, add_route, dispatch;
