// stdlib/gpu2d_pipeline.sapp — the capstone facade for pblang's GPU 2D stack.
//
// One object to build a UI scene, bake it, and run it SAFELY. Rounded panels + text go
// through the instanced-quad path (gpu2d); strokes + gradients + arbitrary fills go through
// the tessellated-mesh path (gpu2d_tess); glyphs are packed by glyph_atlas and filled by
// glyph_raster; the shaders come from gpu2d_shader and the host from gpu2d_host. Crucially,
// nothing foreign runs except through polyglot_guard — generated or tampered host code that
// trips the safety scan is refused before it can execute.
//
//   let GP = import("stdlib/gpu2d_pipeline.sapp");
//   let sc = GP.new(w, h);
//   GP.rrect(sc, x, y, w, h, 8, panelColor);  GP.gradient(sc, ...);  GP.glyph(sc, ...);
//   let baked = GP.bake(sc);                    // {quad_buffer, mesh_buffer, draw_calls:2}
//   GP.guarded_run(sc, "python-moderngl", POLY.run);   // asserts safe, THEN runs
//
// A live GPU present still needs the emitted host to run on a machine with a GPU + toolchain
// (or an FFI); the same scene also renders today on all CPU cores via render_soft.

let Q = import("stdlib:gpu2d.sapp");
let TS = import("stdlib:gpu2d_tess.sapp");
let AT = import("stdlib:glyph_atlas.sapp");
let HOST = import("stdlib:gpu2d_host.sapp");
let PG = import("stdlib:polyglot_guard.sapp");

// new(w, h) — an empty scene with a quad list, a mesh list, and a glyph atlas.
fn new(w, h) {
    return map{ w: w, h: h, quads: Q.new(), mesh: TS.new(), atlas: AT.new(1024, 1024, 1) };
}

// ── quad path (chrome + text): axis-aligned, instanced ──────────────────────────────
fn rect(sc, x, y, w, h, col) { Q.rect(sc.quads, x, y, w, h, col); return sc; }
fn rrect(sc, x, y, w, h, rad, col) { Q.rrect(sc.quads, x, y, w, h, rad, col); return sc; }
fn glyph(sc, x, y, w, h, uv, col) { Q.glyph(sc.quads, x, y, w, h, uv, col); return sc; }

// ── mesh path (strokes, gradients, arbitrary fills): tessellated triangles ──────────
fn line(sc, x0, y0, x1, y1, width, col) { TS.line(sc.mesh, x0, y0, x1, y1, width, col); return sc; }
fn polyline(sc, points, width, col) { TS.polyline(sc.mesh, points, width, col); return sc; }
fn gradient(sc, x, y, w, h, c0, c1, vertical) { TS.gradient_rect(sc.mesh, x, y, w, h, c0, c1, vertical); return sc; }
fn fill(sc, points, col) { TS.fill_convex(sc.mesh, points, col); return sc; }

// ── bake: both GPU buffers in one struct ────────────────────────────────────────────
fn _bake_with(sc, quad_buf) {
    return map{
        quad_buffer: quad_buf,
        mesh_buffer: TS.to_vertex_f32(sc.mesh),
        quad_instances: Q.count(sc.quads),
        mesh_vertices: TS.vertices(sc.mesh),
        draw_calls: 2
    };
}
fn bake(sc) { return _bake_with(sc, Q.to_vertex_f32(sc.quads)); }
fn bake_par(sc) { return _bake_with(sc, Q.to_vertex_f32_par(sc.quads)); }   // multi-core bake

// ── polyglot host + the safety gate ─────────────────────────────────────────────────
fn targets() { return HOST.targets(); }
fn _lang(target) {
    if target == "rust-wgpu" { return "rust"; }
    if target == "c-opengl" { return "c"; }
    if target == "python-moderngl" { return "python"; }
    if target == "js-webgpu" { return "js"; }
    return "unknown";
}
fn emit_host(sc, target) { return HOST.emit(target); }

// program(sc, target) — the host source + its guard verdict, WITHOUT running anything.
fn program(sc, target) {
    let code = HOST.emit(target);
    let lang = _lang(target);
    let scan = PG.scan(code, lang);
    return map{ target: target, lang: lang, code: code, safe: scan.safe, findings: scan.findings };
}

// guarded_run(sc, target, runner) — assert the host is safe, THEN hand it to `runner`
// (e.g. stdlib/polyglot.run). Throws (never runs) if the host trips the safety scan.
fn guarded_run(sc, target, runner) {
    let code = HOST.emit(target);
    return PG.guarded(runner, _lang(target), code);
}

export new, rect, rrect, glyph, line, polyline, gradient, fill;
export bake, bake_par, targets, emit_host, program, guarded_run;
