// One complete Sheet row per export; all cells are selectable, no silent clipping.
let Sheet=import("stdlib:sheet_document.sapp");let Pages=import("stdlib:text_pages.sapp");let UI=import("stdlib:modern_ui.sapp");
fn create(doc,row=0,title="PBTally table reader"){if type(title)!="string" or len(title)<1 or len(str_to_bytes(title))>64 or str_contains(title,"\u0000"){throw "table cell view: invalid title";}let size=Sheet.validate(doc);if type(row)!="number" or not(row>=0 and row<size.rows) or row!=num_floor(row){throw "table cell view: invalid row";}
 let texts=[];let height=1;for cell in doc.cells[row]{let lines=Pages.wrap(cell,24);height=num_max(height,len(lines));array_push(texts,lines);}
 let children=[UI.heading(title),UI.text("Row "+str(row+1)+" / "+str(size.rows)+" | Columns: "+str(size.columns)),UI.text("Column 1",map{name:"selected_column"})];
 for i in range(0,height){array_push(children,UI.text(if i<len(texts[0]) {texts[0][i]} else {""},map{name:"cell_line_"+str(i)}));}
 let buttons=[];for c in range(0,size.columns){let actions=[UI.action_set_text("selected_column","Column "+str(c+1))];for i in range(0,height){array_push(actions,UI.action_set_text("cell_line_"+str(i),if i<len(texts[c]) {texts[c][i]} else {""}));}array_push(buttons,UI.button("Column "+str(c+1),UI.action_sequence(actions),map{name:"select_"+str(c)}));}
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("This exported row contains literal values. Other rows require separate exports."));return UI.screen(children);
}
export create;
