// stdlib/event_bus.sapp — Global event bus / pub-sub system.
//
// Provides decoupled communication between components.
//
// Usage:
//   let bus = import("stdlib:event_bus.sapp");
//   bus.on("user.created", fn(data) { print "New user: " + data.name; });
//   bus.emit("user.created", map{ name: "Alice" });

let _handlers = map{};
let _once_handlers = map{};

fn on(event, handler) {
    if map_has(_handlers, event) == false { _handlers[event] = []; }
    let arr = _handlers[event];
    arr[len(arr)] = handler;
    _handlers[event] = arr;
}

fn once(event, handler) {
    if map_has(_once_handlers, event) == false { _once_handlers[event] = []; }
    let arr = _once_handlers[event];
    arr[len(arr)] = handler;
    _once_handlers[event] = arr;
}

fn off(event, handler) {
    let arr = try _handlers[event] catch [];
    let new_arr = [];
    for i len(arr) {
        if arr[i] != handler { new_arr[len(new_arr)] = arr[i]; }
    }
    _handlers[event] = new_arr;
}

// _matches(pattern, event) — exact, global "*", or "prefix.*" pattern matching.
fn _matches(pattern, event) {
    if pattern == "*" { return true; }
    let pn = len(pattern);
    if pn >= 2 and str_slice(pattern, pn - 2, pn) == ".*" {
        let prefix = str_slice(pattern, 0, pn - 1);   // keep the trailing dot
        return len(event) >= len(prefix) and str_slice(event, 0, len(prefix)) == prefix;
    }
    return pattern == event;
}

// _fire(handlers, arg) — invoke each handler, ISOLATING errors so one failing
// subscriber can't stop the rest. Returns the number invoked.
fn _fire(handlers, arg) {
    let c = 0;
    let i = 0;
    while i < len(handlers) {
        let _ = try handlers[i](arg) catch nil;
        c = c + 1;
        i = i + 1;
    }
    return c;
}

// emit(event, data) — notify all matching handlers; returns the count invoked.
// Wildcard ("*") handlers receive map{event, data}; everything else gets `data`.
fn emit(event, data) {
    let count = 0;
    // Exact handlers
    count = count + _fire(try _handlers[event] catch [], data);
    // Pattern handlers (keys containing "*"), excluding the exact key
    let keys = map_keys(_handlers);
    let k = 0;
    while k < len(keys) {
        let pat = keys[k];
        if pat != event and str_contains(pat, "*") and _matches(pat, event) {
            if pat == "*" { count = count + _fire(_handlers[pat], map{ event: event, data: data }); }
            else { count = count + _fire(_handlers[pat], data); }
        }
        k = k + 1;
    }
    // Once handlers (exact), then clear them
    let once_h = try _once_handlers[event] catch [];
    count = count + _fire(once_h, data);
    if map_has(_once_handlers, event) { _once_handlers[event] = []; }
    return count;
}

fn clear(event) {
    if event == nil {
        // Clear all
        let keys = map_keys(_handlers);
        for i len(keys) { _handlers[keys[i]] = []; }
        let okeys = map_keys(_once_handlers);
        for i len(okeys) { _once_handlers[okeys[i]] = []; }
    } else {
        _handlers[event] = [];
        _once_handlers[event] = [];
    }
}

fn listeners(event) {
    let handlers = try _handlers[event] catch [];
    return len(handlers);
}

// events() — names of all events that currently have at least one handler.
fn events() {
    let out = [];
    let keys = map_keys(_handlers);
    let i = 0;
    while i < len(keys) {
        if len(_handlers[keys[i]]) > 0 { array_push(out, keys[i]); }
        i = i + 1;
    }
    return out;
}

// has_listeners(event) — true if any exact or matching-pattern handler exists.
fn has_listeners(event) {
    if len(try _handlers[event] catch []) > 0 { return true; }
    let keys = map_keys(_handlers);
    let i = 0;
    while i < len(keys) {
        let pat = keys[i];
        if str_contains(pat, "*") and _matches(pat, event) and len(_handlers[pat]) > 0 { return true; }
        i = i + 1;
    }
    return false;
}

export on, once, off, emit, clear, listeners, events, has_listeners;
