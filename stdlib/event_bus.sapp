// stdlib/event_bus.sapp — Global event bus / pub-sub system.
//
// Provides decoupled communication between components.
//
// Usage:
//   let bus = import("stdlib:event_bus.sapp");
//   bus.on("user.created", fn(data) { print "New user: " + data.name; });
//   bus.emit("user.created", map{ name: "Alice" });

let _handlers = map{};
let _once_handlers = map{};

fn on(event, handler) {
    if map_has(_handlers, event) == false { _handlers[event] = []; }
    let arr = _handlers[event];
    arr[len(arr)] = handler;
    _handlers[event] = arr;
}

fn once(event, handler) {
    if map_has(_once_handlers, event) == false { _once_handlers[event] = []; }
    let arr = _once_handlers[event];
    arr[len(arr)] = handler;
    _once_handlers[event] = arr;
}

fn off(event, handler) {
    let arr = try _handlers[event] catch [];
    let new_arr = [];
    for i len(arr) {
        if arr[i] != handler { new_arr[len(new_arr)] = arr[i]; }
    }
    _handlers[event] = new_arr;
}

fn emit(event, data) {
    let handlers = try _handlers[event] catch [];
    for i len(handlers) { handlers[i](data); }
    // Fire once handlers and remove them
    let once_h = try _once_handlers[event] catch [];
    for i len(once_h) { once_h[i](data); }
    _once_handlers[event] = [];
    // Wildcard handlers
    let wildcard = try _handlers["*"] catch [];
    for i len(wildcard) { wildcard[i](map{ event: event, data: data }); }
}

fn clear(event) {
    if event == nil {
        // Clear all
        let keys = map_keys(_handlers);
        for i len(keys) { _handlers[keys[i]] = []; }
        let okeys = map_keys(_once_handlers);
        for i len(okeys) { _once_handlers[okeys[i]] = []; }
    } else {
        _handlers[event] = [];
        _once_handlers[event] = [];
    }
}

fn listeners(event) {
    let handlers = try _handlers[event] catch [];
    return len(handlers);
}

export on, once, off, emit, clear, listeners;
