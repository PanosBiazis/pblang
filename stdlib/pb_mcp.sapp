// stdlib/pb_mcp.sapp - pblang-native pb-mcp bridge.
//
// This is the first conversion slice of the Rust pb-mcp-server into pblang:
// safe core-code tools that pbAI can call directly from .sapp code. The large
// Rust MCP daemon still handles protocol/gateway/local-power features; this
// module gives pblang and pbAI a native tool API now.

let FS = import("stdlib:fs.sapp");

let MAX_READ_CHARS = 20000;
let MAX_FILES = 400;
let MAX_GREP = 80;

fn _safe_path(path) {
    if path == nil or path == "" { return "."; }
    if type(path) != "string" { throw "pb_mcp: path must be a string"; }
    if str_starts_with(path, "/") or str_contains(path, "..") or str_contains(path, "\x00") {
        throw "pb_mcp: path outside workspace is not allowed: " + path;
    }
    return path;
}

fn _join(a, b) {
    if a == "." or a == "" { return b; }
    if str_ends_with(a, "/") { return a + b; }
    return a + "/" + b;
}

fn _is_dir(path) {
    let items = try FS.listdir(path) catch nil;
    return items != nil;
}

fn _is_file(path) {
    let text = try FS.read(path) catch nil;
    return type(text) == "string";
}

fn _truncate(s, max_chars) {
    if len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars) + "\n... truncated at " + str(max_chars) + " chars";
}

fn _push_recursive(out, dir, depth, max_depth, max_entries) {
    if len(out) >= max_entries { return out; }
    if depth > max_depth { return out; }
    let items = try FS.listdir(dir) catch [];
    for i len(items) {
        if len(out) >= max_entries { return out; }
        let name = items[i];
        if name != ".git" and name != "target" and name != ".mint-mcp" {
            let path = _join(dir, name);
            array_push(out, path);
            if _is_dir(path) {
                _push_recursive(out, path, depth + 1, max_depth, max_entries);
            }
        }
    }
    return out;
}

fn tool_catalog() {
    return [
        map{ name: "workspace_context", profile: "core-code", desc: "repo root, top-level files, native tool categories" },
        map{ name: "read_file", profile: "core-code", desc: "bounded read of a workspace file" },
        map{ name: "read_file_tail", profile: "core-code", desc: "read last N lines of a workspace file" },
        map{ name: "list_files", profile: "core-code", desc: "recursive bounded file listing" },
        map{ name: "project_tree", profile: "core-code", desc: "bounded tree-style listing" },
        map{ name: "grep_code", profile: "core-code", desc: "literal text search over workspace files (optional case-insensitive)" },
        map{ name: "find_files", profile: "core-code", desc: "find files whose name matches a fragment (case-insensitive)" },
        map{ name: "file_stats", profile: "core-code", desc: "read-only size metrics (bytes, chars, lines) for a file" },
    ];
}

fn workspace_context() {
    let root = try cwd() catch ".";
    let top = try FS.listdir(".") catch [];
    return map{
        root: root,
        profile: "pblang-core-code",
        native: true,
        converted_from: "editors/ide/tools/mcpservers/pb-mcp-server safe core",
        tools: tool_catalog(),
        top_level: top,
        limits: map{
            max_read_chars: MAX_READ_CHARS,
            max_files: MAX_FILES,
            max_grep_matches: MAX_GREP,
        },
    };
}

// file_stats(path) -> read-only size metrics. Cheap context for agents that want to
// decide how to read a file (e.g. whether to page it) without fetching its contents.
fn file_stats(path) {
    path = _safe_path(path);
    let raw = FS.read(path);
    let lines = str_split(raw, "\n");
    let non_empty = 0;
    for i len(lines) { if str_trim(lines[i]) != "" { non_empty = non_empty + 1; } }
    return map{
        path: path,
        bytes: len(str_to_bytes(raw)),
        chars: len(raw),
        lines: len(lines),
        non_empty_lines: non_empty,
    };
}

fn read_file(path, start_line = nil, end_line = nil) {
    path = _safe_path(path);
    let raw = FS.read(path);
    if start_line == nil and end_line == nil {
        return _truncate(raw, MAX_READ_CHARS);
    }
    let lines = str_split(raw, "\n");
    if start_line == nil { start_line = 1; }
    if end_line == nil or end_line > len(lines) { end_line = len(lines); }
    if start_line < 1 { start_line = 1; }
    let out = "";
    let i = start_line;
    while i <= end_line and i <= len(lines) {
        if out != "" { out = out + "\n"; }
        out = out + lines[i - 1];
        i = i + 1;
    }
    return _truncate(out, MAX_READ_CHARS);
}

fn read_file_tail(path, n = 40) {
    path = _safe_path(path);
    let raw = FS.read(path);
    let lines = str_split(raw, "\n");
    let start = len(lines) - n + 1;
    if start < 1 { start = 1; }
    return read_file(path, start, len(lines));
}

fn list_files(dir = ".", max_entries = nil) {
    if max_entries == nil { max_entries = MAX_FILES; }
    dir = _safe_path(dir);
    let out = [];
    _push_recursive(out, dir, 0, 8, max_entries);
    return out;
}

fn project_tree(dir = ".", max_depth = 3, max_entries = 120) {
    dir = _safe_path(dir);
    let paths = [];
    _push_recursive(paths, dir, 0, max_depth, max_entries);
    let out = "";
    for i len(paths) {
        if i > 0 { out = out + "\n"; }
        out = out + paths[i];
    }
    return out;
}

fn _basename(path) {
    let parts = str_split(path, "/");
    if len(parts) == 0 { return path; }
    return parts[len(parts) - 1];
}

// find_files(name, dir, max) -> paths whose filename contains `name` (case-insensitive).
fn find_files(name, dir = ".", max_results = nil) {
    if max_results == nil { max_results = MAX_FILES; }
    if name == nil { name = ""; }
    dir = _safe_path(dir);
    let needle = str_lower(name);
    let files = list_files(dir, MAX_FILES);
    let out = [];
    for i len(files) {
        if len(out) >= max_results { return out; }
        let path = files[i];
        if not _is_dir(path) {
            if needle == "" or str_contains(str_lower(_basename(path)), needle) {
                array_push(out, path);
            }
        }
    }
    return out;
}

fn grep_code(pattern, dir = ".", max_matches = nil, ignore_case = false) {
    if max_matches == nil { max_matches = MAX_GREP; }
    if pattern == nil or pattern == "" { return []; }
    dir = _safe_path(dir);
    let needle = pattern;
    if ignore_case { needle = str_lower(pattern); }
    let files = list_files(dir, MAX_FILES);
    let out = [];
    for i len(files) {
        if len(out) >= max_matches { return out; }
        let path = files[i];
        // Single read per file (was read twice: once via _is_file, once here). A
        // directory or unreadable path yields nil and is skipped.
        let raw = try FS.read(path) catch nil;
        if type(raw) == "string" {
            let lines = str_split(raw, "\n");
            for line_no len(lines) {
                if len(out) >= max_matches { return out; }
                let hay = lines[line_no];
                if ignore_case { hay = str_lower(hay); }
                if str_contains(hay, needle) {
                    array_push(out, map{ path: path, line: line_no + 1, text: lines[line_no] });
                }
            }
        }
    }
    return out;
}

fn call(tool, args = nil) {
    if args == nil { args = map{}; }
    if tool == "workspace_context" { return workspace_context(); }
    if tool == "tool_catalog" { return tool_catalog(); }
    if tool == "read_file" { return read_file(try args.path catch "", try args.start_line catch nil, try args.end_line catch nil); }
    if tool == "read_file_tail" { return read_file_tail(try args.path catch "", try args.n catch 40); }
    if tool == "list_files" { return list_files(try args.dir catch ".", try args.max_entries catch MAX_FILES); }
    if tool == "project_tree" { return project_tree(try args.dir catch ".", try args.max_depth catch 3, try args.max_entries catch 120); }
    if tool == "grep_code" { return grep_code(try args.pattern catch "", try args.dir catch ".", try args.max_matches catch MAX_GREP, try args.ignore_case catch false); }
    if tool == "find_files" { return find_files(try args.name catch "", try args.dir catch ".", try args.max_results catch MAX_FILES); }
    if tool == "file_stats" { return file_stats(try args.path catch ""); }
    throw "pb_mcp: unknown tool '" + str(tool) + "'";
}

export tool_catalog, workspace_context, read_file, read_file_tail, list_files, project_tree, grep_code, find_files, file_stats, call;
