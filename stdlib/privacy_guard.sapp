// Privacy boundary for model hooks, logs, exports, and support bundles.
// Public reports contain categories/counts only, never matched values/previews.

let Secrets=import("stdlib:secscan.sapp");
let FORMAT="pblang.privacy-guard.v1";
let MAX_TEXT_BYTES=262144;

fn _category_add(categories,name) { if not map_has(categories,name) { categories[name]=0; } categories[name]=categories[name]+1; }
fn _line_category(line,custom_terms) {
    let lower=str_lower(line);
    if str_contains(lower,"-----begin ") and str_contains(lower," private key") { return "private-key"; }
    if str_contains(lower,"authorization:") or str_contains(lower,"bearer ") { return "authorization"; }
    if str_contains(lower,"api_key") or str_contains(lower,"apikey") or str_contains(lower,"access_key") { return "api-key"; }
    if str_contains(lower,"password=") or str_contains(lower,"password:") or str_contains(lower,"passwd=") { return "password"; }
    if str_contains(lower,"secret=") or str_contains(lower,"secret:") or str_contains(lower,"token=") or str_contains(lower,"token:") { return "secret-assignment"; }
    if str_contains(line,"/home/") or str_contains(line,"/media/") or str_contains(line,"/Users/")
        or str_contains(lower,"c:\\users\\") or str_contains(line,"/storage/emulated/") or str_contains(line,"/sdcard/") {
        return "personal-path";
    }
    if str_contains(line,"@") {
        let tokens=str_split(str_replace_all(str_replace_all(line,"<"," "),">"," ")," ");
        for token in tokens { if str_contains(token,"@") and str_contains(token,".") { return "email-address"; } }
    }
    for term in custom_terms { if term!="" and str_contains(lower,str_lower(term)) { return "custom-sensitive-term"; } }
    return nil;
}
fn _options(options) {
    if options==nil { options=map{}; } if type(options)!="map" { return nil; }
    for key in map_keys(options) {
        if key!="mode" and key!="custom_sensitive_terms" { return nil; }
    }
    let mode=str_lower(str(try options.mode catch "block"));
    if mode!="block" and mode!="redact" and mode!="allow" { return nil; }
    let terms=try options.custom_sensitive_terms catch [];
    if type(terms)!="array" or len(terms)>64 { return nil; }
    let total=0; for term in terms {
        if type(term)!="string" or len(term)<2 or len(term)>128 { return nil; }
        total=total+len(term); if total>4096 { return nil; }
    }
    return map{mode:mode,custom_sensitive_terms:terms};
}
fn inspect(text,options=nil) {
    let normalized=_options(options);
    if normalized==nil or type(text)!="string" or len(str_to_bytes(text))>MAX_TEXT_BYTES {
        return map{ok:false,format:FORMAT,error:"invalid bounded privacy inspection request"};
    }
    let categories=map{}; let secret_matches=Secrets.detect_secrets(text);
    for finding in secret_matches { _category_add(categories,"credential-token"); }
    let lines=str_split(text,"\n"); for line in lines {
        let category=_line_category(line,normalized.custom_sensitive_terms);
        if category!=nil { _category_add(categories,category); }
    }
    let count=0; for key in map_keys(categories) { count=count+categories[key]; }
    return map{ok:true,format:FORMAT,sensitive:count>0,finding_count:count,
        categories:categories,mode:normalized.mode,values_exposed:false,previews_exposed:false};
}
fn sanitize(text,options=nil) {
    let normalized=_options(options); if normalized==nil { return map{ok:false,format:FORMAT,error:"invalid privacy options"}; }
    let report=inspect(text,normalized); if not report.ok { return report; }
    if report.sensitive and normalized.mode=="block" {
        return map{ok:false,format:FORMAT,error:"sensitive content blocked by privacy policy",
            finding_count:report.finding_count,categories:report.categories,values_exposed:false};
    }
    if not report.sensitive or normalized.mode=="allow" {
        return map{ok:true,format:FORMAT,text:text,redacted:false,allowed_sensitive:report.sensitive,
            finding_count:report.finding_count,categories:report.categories,values_exposed:false};
    }
    let lines=str_split(Secrets.redact(text),"\n"); let out=""; let redacted_lines=0; let i=0;
    while i<len(lines) {
        let category=_line_category(lines[i],normalized.custom_sensitive_terms);
        if category!=nil { out=out+"[REDACTED "+category+"]"; redacted_lines=redacted_lines+1; }
        else { out=out+lines[i]; }
        if i+1<len(lines) { out=out+"\n"; } i=i+1;
    }
    return map{ok:true,format:FORMAT,text:out,redacted:true,allowed_sensitive:false,
        redacted_lines:redacted_lines,finding_count:report.finding_count,
        categories:report.categories,values_exposed:false};
}

export FORMAT,MAX_TEXT_BYTES,inspect,sanitize;
