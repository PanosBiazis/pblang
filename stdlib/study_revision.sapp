// Explicit notes revision: exact prompt+answer matches retain review progress.
let Study=import("stdlib:study_cards.sapp");
fn _unique(deck) {
 let seen=map{};
 for card in deck.cards {
  // NUL is rejected by Study.validate, so this separator cannot collide.
  let key=card.prompt+"\u0000"+card.answer;
  if map_has(seen,key) {throw "revision requires unique question and answer pairs";}
  seen[key]=card;
 }
 return seen;
}
fn from_document(deck,document,date) {
 let old=Study.copy(deck);let fresh=Study.from_document(document,date);
 let lookup=_unique(old);_unique(fresh);let retained=map{};let preserved=0;
 for card in fresh.cards {
  let key=card.prompt+"\u0000"+card.answer;
  if map_has(lookup,key) {retained[str(lookup[key].id)]=true;preserved=preserved+1;}
 }
 let used=map{};for id in map_keys(retained) {used[id]=true;}
 let cards=[];let rows=[];
 for card in fresh.cards {
  let key=card.prompt+"\u0000"+card.answer;
  if map_has(lookup,key) {
   let previous=lookup[key];array_push(cards,previous);
   array_push(rows,map{status:"preserved",id:previous.id,position:len(cards)});
  } else {
   let id=1;while map_has(used,str(id)) {id=id+1;}
   if id>Study.MAX_CARDS {throw "revision card identity limit";}
   card.id=id;used[str(id)]=true;array_push(cards,card);
   array_push(rows,map{status:"new",id:id,position:len(cards)});
  }
 }
 let removed=[];for card in old.cards {if not map_has(retained,str(card.id)) {array_push(removed,card.id);}}
 let candidate=map{format:Study.FORMAT,title:fresh.title,cards:cards};Study.validate(candidate);
 return map{format:"pblang.study-revision.v1",deck:candidate,preserved:preserved,added:len(fresh.cards)-preserved,
  removed:len(removed),removed_ids:removed,rows:rows,title_changed:old.title!=fresh.title,
  changed:Study.encode(old)!=Study.encode(candidate),contains_source_text:true,safe_to_log:false};
}
fn summary(result) {
 return map{preserved:result.preserved,added:result.added,removed:result.removed,title_changed:result.title_changed,changed:result.changed};
}
fn describe(result) {
 return str(result.preserved)+" kept | "+str(result.added)+" new | "+str(result.removed)+" removed";
}
export from_document,summary,describe;
