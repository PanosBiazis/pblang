// Synchronous ownership of registered cleanup callbacks. No ambient resources
// are discovered, and a successful callback does not prove OS-level release.
// Callbacks return {ok:true,value:...} or {ok:false,error:...}; returned errors
// are retained separately from failures in cleanup. Host exceptions currently
// expose no original message to PBLang catch expressions.

fn _valid_result(value) {
    if not is_map(value) { return false; }
    if not map_has(value,"ok") or type(value.ok)!="bool" { return false; }
    if value.ok { return map_has(value,"value"); }
    return map_has(value,"error");
}

fn _snapshot(valid,ok,value,error) {
    if not valid {return nil;}
    if ok {return map{ok:true,value:value};}
    return map{ok:false,error:error};
}

fn with_scope(body_fn) {
    // Keep the ledger out of the public facade; callbacks are trusted, not sandboxed.
    let state=map{phase:"body",pending:[],threw:false};
    let scope=map{defer:fn(cleanup_fn){
        if state.phase!="body" {throw "resource_scope: registration is closed";}
        let id=len(state.pending);
        array_push(state.pending,cleanup_fn);
        return id;
    }};
    // Keep exception state separately: every returned value, including nil or
    // false, must still be validated rather than mistaken for an exception.
    let body=try body_fn(scope) catch {state.threw=true;};
    let status="returned";
    let valid=not state.threw and _valid_result(body);
    if state.threw {status="exception";}
    else {if not valid {status="invalid_result";}}
    let body_ok=valid and body.ok;
    let primary=nil;
    let value=nil;
    if valid {
        if body_ok {value=body.value;}
        else {primary=body.error;}
    }
    // Snapshot the result envelope before cleanup can mutate a shared map.
    let body_result=_snapshot(valid,body_ok,value,primary);
    state.phase="cleanup";
    let failures=[];
    let attempted=0;
    while len(state.pending)>0 {
        // Remove ownership before invoking user code: no implicit retry, even
        // if the callback fails or attempts to register more cleanup work.
        let id=len(state.pending)-1;
        let callback=array_pop(state.pending);
        state.threw=false;
        let closed=try callback() catch {state.threw=true;};
        attempted=attempted+1;
        if state.threw {
            array_push(failures,map{id:id,kind:"exception",result:nil});
        } else {
            if not _valid_result(closed) {
                array_push(failures,map{id:id,kind:"invalid_result",result:nil});
            } else {
                if not closed.ok {
                    array_push(failures,map{id:id,kind:"error_result",result:_snapshot(true,false,nil,closed.error)});
                }
            }
        }
    }
    state.phase="closed";
    let cleanup_ok=len(failures)==0;
    return map{ok:body_ok and cleanup_ok,value:value,error:primary,
        body_status:status,body_result:body_result,
        original_error_available:valid and not body_ok,
        cleanup_ok:cleanup_ok,cleanup_errors:failures,cleanups_attempted:attempted};
}

export with_scope;
