// stdlib/macro.sapp - source-level metaprogramming helpers.
//
// This is a library preprocessor layer, not native syntax macros. It gives
// pblang programs a deterministic way to define template macros, expand
// @name(args...) calls in source strings, and validate generated source through
// the self-hosted frontend.

fn registry() {
    return map{
        rules: map{},
        counter: 0,
    };
}

fn gensym(reg = nil, prefix = "__pb_tmp") {
    if reg == nil {
        reg = registry();
    }
    reg.counter = reg.counter + 1;
    return prefix + "_" + str(reg.counter);
}

fn define_template(reg, name, params, body) {
    if reg == nil {
        reg = registry();
    }
    if params == nil {
        params = [];
    }
    reg.rules[name] = map{
        kind: "template",
        name: name,
        params: params,
        body: body,
    };
    return reg;
}

fn has_macro(reg, name) {
    if reg == nil { return false; }
    let rule = try reg.rules[name] catch nil;
    return rule != nil;
}

fn macro_names(reg) {
    if reg == nil { return []; }
    return map_keys(reg.rules);
}

fn expand_template(body, ctx) {
    if ctx == nil {
        ctx = map{};
    }
    let out = body;
    let keys = map_keys(ctx);
    for i len(keys) {
        let key = keys[i];
        out = str_replace_all(out, "{{" + key + "}}", str(ctx[key]));
        out = str_replace_all(out, "{{ " + key + " }}", str(ctx[key]));
    }
    return out;
}

fn expand_call(reg, name, args) {
    if reg == nil {
        return error("macro.expand_call: registry is nil");
    }
    let rule = try reg.rules[name] catch nil;
    if rule == nil {
        return error("macro.expand_call: unknown macro '" + name + "'");
    }
    if args == nil {
        args = [];
    }

    let ctx = map{};
    for i len(rule.params) {
        let value = "";
        if i < len(args) {
            value = str_trim(args[i]);
        }
        ctx[rule.params[i]] = value;
    }
    ctx["gensym"] = gensym(reg, "__pb_macro");
    return expand_template(rule.body, ctx);
}

fn parse_args(s) {
    let args = [];
    let current = "";
    let depth = 0;
    let quote = "";
    let escape = false;
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);

        if escape {
            current = current + ch;
            escape = false;
        } elif ch == "\\" and quote != "" {
            current = current + ch;
            escape = true;
        } elif quote != "" {
            current = current + ch;
            if ch == quote {
                quote = "";
            }
        } elif ch == "\"" or ch == "'" {
            quote = ch;
            current = current + ch;
        } elif ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            current = current + ch;
        } elif ch == ")" or ch == "]" or ch == "}" {
            if depth > 0 {
                depth = depth - 1;
            }
            current = current + ch;
        } elif ch == "," and depth == 0 {
            array_push(args, str_trim(current));
            current = "";
        } else {
            current = current + ch;
        }
        i = i + 1;
    }

    if str_trim(current) != "" or len(s) > 0 {
        array_push(args, str_trim(current));
    }
    return args;
}

fn _find_from(s, needle, from) {
    let rest = str_slice(s, from, len(s));
    let pos = str_index_of(rest, needle);
    if pos < 0 { return -1; }
    return from + pos;
}

fn _is_ident_char(ch) {
    let code = strcharcodeat(ch, 0);
    return (code >= 97 and code <= 122) or (code >= 65 and code <= 90)
        or (code >= 48 and code <= 57) or code == 95;
}

fn _read_macro_call(line) {
    let trimmed = str_trim(line);
    if str_starts_with(trimmed, "@") == false {
        return nil;
    }

    let i = 1;
    while i < len(trimmed) and _is_ident_char(str_slice(trimmed, i, i + 1)) {
        i = i + 1;
    }
    if i <= 1 {
        return nil;
    }

    let name = str_slice(trimmed, 1, i);
    let after = str_trim(str_slice(trimmed, i, len(trimmed)));
    if str_starts_with(after, "(") == false {
        return nil;
    }

    let depth = 0;
    let quote = "";
    let escape = false;
    let end = -1;
    let j = 0;
    while j < len(after) {
        let ch = str_slice(after, j, j + 1);
        if escape {
            escape = false;
        } elif ch == "\\" and quote != "" {
            escape = true;
        } elif quote != "" {
            if ch == quote { quote = ""; }
        } elif ch == "\"" or ch == "'" {
            quote = ch;
        } elif ch == "(" {
            depth = depth + 1;
        } elif ch == ")" {
            depth = depth - 1;
            if depth == 0 {
                end = j;
                break;
            }
        }
        j = j + 1;
    }
    if end < 0 {
        return nil;
    }

    let arg_text = str_slice(after, 1, end);
    let tail = str_trim(str_slice(after, end + 1, len(after)));
    if tail == ";" {
        tail = "";
    }
    if tail != "" {
        return nil;
    }

    return map{
        name: name,
        args: parse_args(arg_text),
    };
}

fn expand_source(reg, source) {
    if source == nil or source == "" {
        return "";
    }

    let lines = str_split(source, "\n");
    let out = "";
    for i len(lines) {
        let line = lines[i];
        let call = _read_macro_call(line);
        if call != nil and has_macro(reg, call.name) {
            out = out + expand_call(reg, call.name, call.args);
        } else {
            out = out + line;
        }
        if i + 1 < len(lines) {
            out = out + "\n";
        }
    }
    return out;
}

fn analyze_generated(source) {
    let frontend = import("stdlib/compiler/selfhost_frontend.sapp");
    return frontend.frontend_parse_full(source);
}

export registry, gensym, define_template, has_macro, macro_names,
       expand_template, expand_call, parse_args, expand_source, analyze_generated;
