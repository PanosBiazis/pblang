// stdlib/text_layout.sapp — pblang-native text shaping/layout helpers.
//
// This is the layer above glyph rasterization. The native graphics backend can draw
// anti-aliased glyphs, but shaping decisions live here in pblang: combining marks,
// emoji clusters, simple RTL run ordering, and code-friendly ligature display.

let U = import("stdlib:unicode.sapp");

fn is_combining(cp) {
    return (cp >= 768 and cp <= 879)        // Combining Diacritical Marks
        or (cp >= 6832 and cp <= 6911)      // Combining Diacritical Marks Extended
        or (cp >= 7616 and cp <= 7679)      // Combining Diacritical Marks Supplement
        or (cp >= 8400 and cp <= 8447)      // Combining marks for symbols
        or (cp >= 65056 and cp <= 65071);   // Half marks
}

fn is_variation_selector(cp) {
    return (cp >= 65024 and cp <= 65039) or (cp >= 917760 and cp <= 917999);
}

fn is_zero_width_joiner(cp) { return cp == 8205; }

fn is_rtl(cp) {
    return (cp >= 1424 and cp <= 1535)      // Hebrew
        or (cp >= 1536 and cp <= 1791)      // Arabic
        or (cp >= 1792 and cp <= 1871)      // Syriac
        or (cp >= 1872 and cp <= 1919)      // Arabic supplement
        or (cp >= 2208 and cp <= 2303)      // Arabic extended
        or (cp >= 64336 and cp <= 65023);   // Hebrew/Arabic presentation forms
}

fn is_ltr(cp) {
    return (cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122) or (cp >= 48 and cp <= 57)
        or (cp >= 880 and cp <= 1023)       // Greek / Coptic
        or (cp >= 1024 and cp <= 1279);     // Cyrillic
}

fn _append_cp(s, cp) { return s + strfromcharcode(cp); }

fn _cluster_kind(cps, emoji, rtl) {
    if emoji { return "emoji"; }
    if rtl { return "rtl"; }
    let i = 0;
    while i < len(cps) {
        if U.is_math_symbol(cps[i]) { return "math"; }
        i = i + 1;
    }
    if len(cps) == 1 and U.is_ascii(cps[0]) { return "ascii"; }
    return "unicode";
}

fn clusters(s) {
    let text = str(s);
    let out = [];
    let i = 0;
    while i < len(text) {
        let cp = strcharcodeat(text, i);
        let ctext = strfromcharcode(cp);
        let cps = [cp];
        let emoji = U.is_emoji(cp);
        let rtl = is_rtl(cp);
        let combining = is_combining(cp);
        i = i + 1;

        // Attach combining marks, variation selectors, and ZWJ-linked emoji pieces
        // to the same visual cluster. That keeps "e + accent" and family/role emoji
        // sequences from being split across cells.
        let keep = true;
        while keep and i < len(text) {
            let n = strcharcodeat(text, i);
            if is_combining(n) or is_variation_selector(n) {
                ctext = _append_cp(ctext, n);
                push(cps, n);
                i = i + 1;
            } else if is_zero_width_joiner(n) and i + 1 < len(text) {
                ctext = _append_cp(ctext, n);
                push(cps, n);
                i = i + 1;
                let joined = strcharcodeat(text, i);
                ctext = _append_cp(ctext, joined);
                push(cps, joined);
                if U.is_emoji(joined) { emoji = true; }
                if is_rtl(joined) { rtl = true; }
                i = i + 1;
            } else {
                keep = false;
            }
        }

        let width = 1;
        if combining and len(cps) == 1 { width = 0; }
        push(out, map{
            format: "pblang.text.cluster.v1",
            text: ctext,
            cps: cps,
            width: width,
            emoji: emoji,
            rtl: rtl,
            kind: _cluster_kind(cps, emoji, rtl)
        });
    }
    return out;
}

fn base_direction(s) {
    let cs = clusters(s);
    let i = 0;
    while i < len(cs) {
        let cps = cs[i].cps;
        let j = 0;
        while j < len(cps) {
            if is_rtl(cps[j]) { return "rtl"; }
            if is_ltr(cps[j]) { return "ltr"; }
            j = j + 1;
        }
        i = i + 1;
    }
    return "ltr";
}

fn _flush_run(out, run, dir) {
    if dir == "rtl" {
        let i = len(run) - 1;
        while i >= 0 { push(out, run[i]); i = i - 1; }
    } else {
        let i = 0;
        while i < len(run) { push(out, run[i]); i = i + 1; }
    }
}

fn visual_clusters(s, dir = nil) {
    let cs = clusters(s);
    if dir == nil { dir = base_direction(s); }
    let out = [];
    let run = [];
    let run_dir = "";
    let i = 0;
    while i < len(cs) {
        let cd = if cs[i].rtl { "rtl" } else { "ltr"; }
        // Neutral punctuation follows the current run; at the start it follows base dir.
        if try cs[i].kind catch "" == "ascii" {
            let cp = try cs[i].cps[0] catch 0;
            if not is_ltr(cp) and not is_rtl(cp) {
                cd = if run_dir == "" { dir } else { run_dir };
            }
        }
        if run_dir == "" { run_dir = cd; }
        if cd != run_dir {
            _flush_run(out, run, run_dir);
            run = [];
            run_dir = cd;
        }
        push(run, cs[i]);
        i = i + 1;
    }
    _flush_run(out, run, run_dir);
    return out;
}

fn _join_clusters(cs) {
    let out = "";
    let i = 0;
    while i < len(cs) { out = out + cs[i].text; i = i + 1; }
    return out;
}

fn _r(s, from, to) { return str_replace_all(s, from, to); }

// Code/display ligatures are padded back to the original scalar count where needed.
// That keeps PBIDE's fixed-cell cursor/hit-testing math aligned with the source text.
fn apply_code_ligatures(s) {
    let out = str(s);
    out = _r(out, "<=>", "⇔  ");
    out = _r(out, "==>", "⟹  ");
    out = _r(out, "->", "→ ");
    out = _r(out, "=>", "⇒ ");
    out = _r(out, "<-", "← ");
    out = _r(out, "<=", "≤ ");
    out = _r(out, ">=", "≥ ");
    out = _r(out, "!=", "≠ ");
    out = _r(out, "==", "≡ ");
    out = _r(out, "::", "∷ ");
    out = _r(out, "...", "…  ");
    return out;
}

fn strip_emoji_variation(s) {
    let out = "";
    let i = 0;
    let text = str(s);
    while i < len(text) {
        let cp = strcharcodeat(text, i);
        if not is_variation_selector(cp) { out = out + strfromcharcode(cp); }
        i = i + 1;
    }
    return out;
}

fn visual_text(s, opts = nil) {
    let mode = "text";
    if opts != nil { mode = try opts.mode catch mode; }
    let dir = nil;
    if opts != nil { dir = try opts.direction catch nil; }
    let text = str(s);
    if mode == "code" { text = apply_code_ligatures(text); }
    text = strip_emoji_variation(text);
    return _join_clusters(visual_clusters(text, dir));
}

fn measure_cells(s) {
    let cs = clusters(s);
    let w = 0;
    let emoji = 0;
    let rtl = 0;
    let combining = 0;
    let i = 0;
    while i < len(cs) {
        w = w + cs[i].width;
        if cs[i].emoji { emoji = emoji + 1; }
        if cs[i].rtl { rtl = rtl + 1; }
        if len(cs[i].cps) > 1 { combining = combining + 1; }
        i = i + 1;
    }
    return map{
        format: "pblang.text.measure.v1",
        clusters: len(cs),
        cells: w,
        emoji_clusters: emoji,
        rtl_clusters: rtl,
        joined_clusters: combining
    };
}

fn shape(s, opts = nil) {
    let visual = visual_text(s, opts);
    let m = measure_cells(s);
    let dir = base_direction(s);
    return map{
        format: "pblang.text.shape.v1",
        source: str(s),
        visual: visual,
        direction: dir,
        measure: m,
        renderer_ready: true,
        note: "pblang-native shaping layer: clusters, simple bidi runs, code ligatures, emoji variation cleanup"
    };
}

export is_combining, is_variation_selector, is_zero_width_joiner, is_rtl, is_ltr;
export clusters, base_direction, visual_clusters, apply_code_ligatures, strip_emoji_variation;
export visual_text, measure_cells, shape;
