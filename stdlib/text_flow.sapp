// Bounded native text flow. Preserve the existing text_layout Unicode groups.
let Layout=import("stdlib:text_layout.sapp");
let Strings=import("stdlib:strings.sapp");
fn _emit(state,line,limit) {
    if len(line)>0 and str_slice(line,len(line)-1,len(line))==" " {line=str_slice(line,0,len(line)-1);}
    if len(state.lines)>=limit {state.stopped=true;state.truncated=true;return;}
    array_push(state.lines,line);
}
fn _ellipsis(text,columns) {
    let dots=str_repeat(".",num_min(3,columns));let prefix="";
    for group in Layout.clusters(text) {
        if len(prefix)+len(group.text)>columns-len(dots) {break;}
        prefix=prefix+group.text;
    }
    return prefix+dots;
}
fn wrap(text,columns,max_lines=64) {
    if type(text)!="string" or len(text)>65536 {throw "text_flow requires at most 65536 characters";}
    if type(columns)!="number" or not (columns>=0 and columns<=4096) or columns!=num_floor(columns) {
        throw "text_flow columns must be an integer from 0 to 4096";
    }
    if type(max_lines)!="number" or not (max_lines>=1 and max_lines<=64) or max_lines!=num_floor(max_lines) {
        throw "text_flow max_lines must be an integer from 1 to 64";
    }
    let state=map{lines:[],truncated:false,stopped:false};
    if columns==0 {state.truncated=len(text)>0;return state;}
    let normalized=Strings.replace_all(Strings.replace_all(text,"\r\n","\n"),"\r","\n");
    normalized=Strings.replace_all(normalized,"\t"," ");
    let line="";let space=-1;let newline=false;
    for group in Layout.clusters(normalized) {
        let token=group.text;newline=false;
        if token=="\n" {
            _emit(state,line,max_lines);line="";space=-1;newline=true;
            if state.stopped {break;} continue;
        }
        if token==" " {
            if line!="" and space!=len(line)-1 {space=len(line);line=line+" ";}
            continue;
        }
        if len(line)+len(token)>columns and line!="" {
            if space>=0 {
                _emit(state,str_slice(line,0,space),max_lines);
                line=str_slice(line,space+1,len(line));space=-1;
            } else {_emit(state,line,max_lines);line="";}
            if state.stopped {break;}
        }
        if len(line)+len(token)>columns and line!="" {
            _emit(state,line,max_lines);line="";space=-1;
            if state.stopped {break;}
        }
        if len(token)>columns {token=str_repeat(".",num_min(3,columns));state.truncated=true;}
        line=line+token;
    }
    if not state.stopped {
        if space==len(line)-1 and space>=0 {line=str_slice(line,0,space);}
        if line!="" or len(state.lines)==0 or newline {_emit(state,line,max_lines);}
    }
    if state.truncated and len(state.lines)>0 {
        let last=len(state.lines)-1;state.lines[last]=_ellipsis(state.lines[last],columns);
    }
    return state;
}
// Logical metrics are shared by measurement and drawing, before UI scaling.
fn metrics(options,heading=false) {
    let size=if heading {27} else {18};
    if map_has(options,"font_size") {size=options.font_size;}
    let ps=num_max(1,num_min(8,num_floor(size/9+0.5)));
    return map{size:size,advance:num_max(6*ps,num_ceil(size*2/3)),line_height:num_ceil(size*1.25),
        extra:if (try options.font_weight catch "normal")=="bold" {1} else {0}};
}
fn layout(text,width,options,heading=false,max_rows=64) {
    let m=metrics(options,heading);
    let columns=num_min(4096,num_max(0,num_floor((width-m.extra)/m.advance)));
    let limit=num_min(max_rows,try options.max_lines catch 64);
    if limit<1 {return map{lines:[],truncated:len(text)>0,metrics:m};}
    let result=wrap(text,columns,limit);result.metrics=m;return result;
}
export wrap,metrics,layout;
