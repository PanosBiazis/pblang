// Bounded typography operations shared by Designer controls and source generation.
let GUI=import("stdlib:gui.sapp");
let Type=import("stdlib:ui_typography.sapp");
let Flow=import("stdlib:text_flow.sapp");
fn options(widget) {
    let out=map{};
    for key in ["font_size","font_weight","text_align","wrap","max_lines"] {
        if map_has(widget,key) {out[key]=widget[key];}
    }
    Type.validate(out);return out;
}
fn source_fields(widget) {
    let opts=options(widget);let result="";
    for key in ["font_size","font_weight","text_align","wrap","max_lines"] {
        if map_has(opts,key) {result=result+", "+key+": "+json_stringify(opts[key]);}
    }
    return result;
}
fn native_source(widget) {
    for key in ["x","y","w","h"] {
        let value=try widget[key] catch nil;
        let limit=if key=="x" or key=="y" {100000} else {8192};
        if type(value)!="number" or not (value>=0 and value<=limit)
            or ((key=="w" or key=="h") and value!=num_floor(value)) {
            throw "Designer typography requires bounded numeric geometry";
        }
    }
    if type(widget.name)!="string" or type(widget.text)!="string" or len(widget.name)>128
        or len(widget.name)==0 or len(widget.text)>8192 {throw "Designer typography requires bounded text";}
    let fields=source_fields(widget);
    if fields!="" {fields=str_slice(fields,2,len(fields));}
    return "gui.styled_label("+json_stringify(widget.name)+", "+str(widget.x)+", "+str(widget.y)
        +", "+str(widget.w)+", "+str(widget.h)+", "+json_stringify(widget.text)
        +", map{ "+fields+" })";
}
fn cycle(widget,action) {
    if (try widget.kind catch "")!="label" {return false;}
    options(widget);
    if action=="wrap" {
        widget.wrap=not (try widget.wrap catch false);
        if widget.wrap {
            let flow=Flow.layout(widget.text,widget.w,widget);
            widget.h=num_max(widget.h,num_max(1,len(flow.lines))*flow.metrics.line_height);
        }
    }
    elif action=="align" {
        let current=try widget.text_align catch "left";
        let next="left";
        if current=="left" {next="center";} elif current=="center" {next="right";}
        widget.text_align=next;
    } elif action=="type" {
        let names=["body","subtitle","title","display","caption"];
        let current=try widget.typography_preset catch "";let next=0;let i=0;
        for name in names {if name==current {next=(i+1)%len(names);}i=i+1;}
        let opts=Type.preset(names[next],map{text_align:try widget.text_align catch "left"});
        for key in map_keys(opts) {widget[key]=opts[key];}
        widget.typography_preset=names[next];
        widget.h=num_max(widget.h,num_ceil(opts.font_size*1.25));
        widget.w=num_min(8192,num_max(widget.w,len(widget.text)*num_ceil(opts.font_size*2/3)+1));
    } else {return false;}
    widget.manual_size=true;return true;
}
fn draw_preview(win,widget,color) {
    let form=GUI.form("Typography preview",1,1);
    form.palette=GUI.custom_palette("dark",map{text:color});
    GUI.set_text_render(form,"auto");GUI.add(form,widget);
    let sink=map{};for key in map_keys(win) {sink[key]=win[key];}
    sink.clear=fn(unused_color){};GUI.draw(sink,form);
}
export options,source_fields,native_source,cycle,draw_preview;
