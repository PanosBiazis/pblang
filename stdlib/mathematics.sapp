// stdlib/mathematics.sapp — PBLang v2.3.0 Sovereign Universal Mathematical Engine
//
// Unified, lazy-loaded, bounded/DoS-safe, privacy-clean mathematical facade covering
// all 12 branches and 64 subcategories of pure and applied mathematics:
//   1. `exact`     -> `stdlib:math/exact_algebra.sapp`     (BigRat Q, Q[i], H, S_n, Intervals, Number Theory, Q[x]/F_p[x], Sturm, Aberth-Ehrlich, Pell, CRT)
//   2. `cas`       -> `stdlib:math/symbolic_cas.sapp`      (Natural/Unicode/LaTeX Parser, Smart Step-by-Step Equation & Inequality Transformer, Universal Solver, Sign Charts, SVG Plotter)
//   3. `calculus`  -> `stdlib:math/calculus_ode.sapp`      (Symbolic Diff, Gradient/Jacobian/Hessian, Symbolic Integration, G7-K15 & Tanh-Sinh Quadrature, Limits, Taylor/Pade, Series, Symbolic/Numerical ODE & PDE, Laplace, FFT/DCT)
//   4. `linalg`    -> `stdlib:math/linalg_geometry.sapp`   (Exact Q RREF/Bareiss Det/Inv/Nullspace, LU/QR/Cholesky/SVD/Eig/Pinv/Expm, N-D Tensors, Frenet-Serret & Gauss Curvature, Convex Hull, Delaunay, Vincenty WGS-84)
//   5. `stats_opt` -> `stdlib:math/stats_opt_applied.sapp` (11 Distributions, 9 Hypothesis Tests, Multivariate OLS/Logistic/PCA, Bayes, Markov, Simplex LP, MILP, BFGS, Levenberg-Marquardt, KKT, Quine-McCluskey, Graphs, Black-Scholes, SI Units, Uncertainty)
//
// Zero network I/O, zero filesystem telemetry, strict resource bounds throughout.

let VERSION = "2.3.0";

let _CACHE = map{
    exact: nil,
    cas: nil,
    calculus: nil,
    linalg: nil,
    stats_opt: nil,
    quantum: nil,
    algorithms: nil,
    symbols: nil
};

fn exact() {
    if _CACHE.exact == nil {
        _CACHE.exact = import("stdlib:math/exact_algebra.sapp");
    }
    return _CACHE.exact;
}

fn cas() {
    if _CACHE.cas == nil {
        _CACHE.cas = import("stdlib:math/symbolic_cas.sapp");
    }
    return _CACHE.cas;
}

fn calculus() {
    if _CACHE.calculus == nil {
        _CACHE.calculus = import("stdlib:math/calculus_ode.sapp");
    }
    return _CACHE.calculus;
}

