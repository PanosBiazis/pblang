// ── Calculus & Risch Convenience Top-Level Forwarders ───────────────────────

fn _expand_for_calculus(expr) {
    if type(expr) != "string" { return expr; }
    let c = cas();
    if len(c.list_functions()) == 0 and not str_contains(expr, "'(") {
        return expr;
    }
    let expanded = try c.to_ascii(c.expand_user_functions(c.parse_math(expr))) catch expr;
    return expanded;
}

fn diff(expr, var_name = "x", order = 1) {
    return calculus().diff(_expand_for_calculus(expr), var_name, order);
}

fn integrate(expr, var_name = "x", a = nil, b = nil) {
    let ex = _expand_for_calculus(expr);
    if a != nil and b != nil {
        return calculus().integrate_definite(ex, var_name, a, b);
    }
    return calculus().integrate_symbolic(ex, var_name);
}

fn risch_integrate(expr, var_name = "x") {
    return calculus().risch_integrate(_expand_for_calculus(expr), var_name);
}

fn limit(expr, var_name = "x", point = 0, dir = "both") {
    return calculus().limit(_expand_for_calculus(expr), var_name, point, dir);
}

fn taylor(expr, var_name = "x", center = 0, order = 5) {
    return calculus().taylor(_expand_for_calculus(expr), var_name, center, order);
}

fn solve_ode(ode_str, ic_map = nil) {
    return calculus().solve_ode_symbolic(ode_str, ic_map);
}

