                "islamic_golden_age_al_khwarizmi_khayyam_al_tusi_al_kashi",
                "ancient_mesopotamian_babylonian_and_egyptian_unit_fractions",
                "european_russian_polish_hungarian_banach_tikhonov_erdos_gallai"
            ]
        }
    ];

    let sub_total = 0;
    let i = 0;
    while i < len(categories) {
        sub_total = sub_total + len(categories[i].subcategories);
        i = i + 1;
    }
    let msc = world().msc2020_registry();
    let gov = governor();
    return map{
        ok: true,
        engine: "pblang_sovereign_mathematics_suite",
        version: VERSION,
        categories_count: len(categories),
        subcategories_count: sub_total,
        msc2020_divisions_count: msc.divisions_count,
        world_traditions_count: len(world().world_mathematical_canon_catalog().traditions),
        security_posture: map{
            network_io: false,
            filesystem_telemetry: false,
            bounded_dos_guards: true,
            adaptive_hardware_governor: true,
            active_governor_profile: gov.get_policy().profile,
            epistemic_filter: "strictly_peer_reviewed_proven_mathematics",
            svg_xss_escaped: true
        },
        categories: categories
    };
}

// ── Adaptive Governor & Indeterminacy Top-Level Helpers ─────────────────────

fn get_policy() { return governor().get_policy(); }
fn set_policy(opts) { return governor().set_policy(opts); }
fn reset_policy() { return governor().reset_policy(); }
fn with_budget(opts, fn_cb) { return governor().with_budget(opts, fn_cb); }
fn current_limits(opts = nil) { return governor().current_limits(opts); }
fn eval_guarded(op, a, b = nil, context = "analytic") { return governor().eval_guarded_op(op, a, b, context); }
fn analyze_indeterminacy(expr_str, env = nil) { return cas().analyze_indeterminacy(expr_str, env); }
fn solve_parametric(input, target_var = "x", params = nil) { return cas().solve_parametric(input, target_var, params); }
fn msc2020_registry() { return world().msc2020_registry(); }
fn classify_open_vs_proved(topic) { return world().classify_open_vs_proved(topic); }
fn world_canon() { return world().world_mathematical_canon_catalog(); }

// ── Top-Level Smart Rendering, Plotting & Algebraic Transformations ─────────

fn render(input) {
    let c = cas();
    let ast = c.parse_math(str(input));
    return map{
        ok: true,
        ascii: c.to_ascii(ast),
        unicode: c.to_unicode(ast),
        latex: c.to_latex(ast),
        free_vars: c.free_vars(ast)
    };
}

fn transform(input, goal = "auto", opts = nil) {
    return cas().transform(input, goal, opts);
}

fn simplify(input) {
    return cas().simplify(input);
}

fn expand(input) {
    return cas().expand(input);
}

fn factor(input) {
    return cas().factor(input);
}

fn complete_square(input, var_name = nil) {
    let o = if var_name != nil { map{ var: var_name } } else { nil };
    return cas().transform(input, "complete_square", o);
}

fn apart(input, var_name = nil) {
    let o = if var_name != nil { map{ var: var_name } } else { nil };
    return cas().transform(input, "apart", o);
}

fn isolate(input, target_var) {
    return cas().transform(input, "isolate", map{ var: str(target_var) });
}

fn plot_svg(expr_or_list, xmin = -10, xmax = 10, opts = nil) {
    return cas().plot_svg(expr_or_list, xmin, xmax, opts);
}

fn plot_svg_report(expr_or_list, xmin = -10, xmax = 10, opts = nil) {
    return cas().plot_svg_report(expr_or_list, xmin, xmax, opts);
}

// ── Calculus & Risch Convenience Top-Level Forwarders ───────────────────────

fn diff(expr, var_name = "x", order = 1) {
    return calculus().diff(expr, var_name, order);
}

fn integrate(expr, var_name = "x", a = nil, b = nil) {
    if a != nil and b != nil {
        return calculus().integrate_definite(expr, var_name, a, b);
    }
    return calculus().integrate_symbolic(expr, var_name);
}

fn risch_integrate(expr, var_name = "x") {
    return calculus().risch_integrate(expr, var_name);
}

fn limit(expr, var_name = "x", point = 0, dir = "both") {
    return calculus().limit(expr, var_name, point, dir);
}

fn taylor(expr, var_name = "x", center = 0, order = 5) {
    return calculus().taylor(expr, var_name, center, order);
}

fn solve_ode(ode_str, ic_map = nil) {
    return calculus().solve_ode_symbolic(ode_str, ic_map);
}

// ── Helper: Split Top-Level Comma Arguments Inside Call Syntax `name(a, b, c)` ─

fn _split_top_args(inside) {
    let out = [];
    let cur = "";
    let depth_p = 0;
    let depth_b = 0;
    let i = 0;
    let n = len(inside);
    while i < n {
        let ch = str_slice(inside, i, i + 1);
        if ch == "(" { depth_p = depth_p + 1; cur = cur + ch; }
        elif ch == ")" { if depth_p > 0 { depth_p = depth_p - 1; } cur = cur + ch; }
        elif ch == "[" { depth_b = depth_b + 1; cur = cur + ch; }
        elif ch == "]" { if depth_b > 0 { depth_b = depth_b - 1; } cur = cur + ch; }
        elif ch == "," and depth_p == 0 and depth_b == 0 {
            push(out, str_trim(cur));
            cur = "";
        } else {
            cur = cur + ch;
        }
        i = i + 1;
    }
    if str_trim(cur) != "" {
        push(out, str_trim(cur));
    }
    return out;
}

fn _parse_bound_arg(s) {
    let t = str_trim(s);
    let low = str_lower(t);
    if low == "inf" or low == "+inf" or low == "infinity" or low == "+infinity" or t == "∞" or t == "+∞" {
        return "+inf";
    }
    if low == "-inf" or low == "-infinity" or t == "-∞" {
        return "-inf";
    }
    if low == "pi" or t == "π" { return 3.14159265358979323846; }
    if low == "-pi" or t == "-π" { return -3.14159265358979323846; }
    let v = try parse_number(t) catch nil;
    if v != nil { return v; }
    let ev = try calculus().evaluate_expr(calculus().parse_expr(t), map{}) catch nil;
    if ev != nil { return ev; }
    return t;
}

fn _match_func_call(text, prefix_name) {
    let s = str_trim(text);
    let pre = prefix_name + "(";
    if str_starts_with(str_lower(s), str_lower(pre)) and str_ends_with(s, ")") {
        let inner = str_slice(s, len(pre), len(s) - 1);
        return _split_top_args(inner);
    }
    return nil;
}

// ── Universal Mathematical Problem Dispatcher (`solve` / `solve_any`) ───────

fn solve(problem, vars = nil, opts = nil) {
    // 1. Structured problem map dispatch
    if type(problem) == "map" {
        let kind = if map_has(problem, "kind") { str_lower(str(problem.kind)) } else { "equation" };
        if kind == "transform" {
            let g = if map_has(problem, "goal") { problem.goal } else { "auto" };
            return transform(problem.expr, g, opts);
        }
        if kind == "parametric" {
            let tv = if map_has(problem, "var") { problem.var } else { "x" };
            let prms = if map_has(problem, "params") { problem.params } else { nil };
            return cas().solve_parametric(problem.expr, tv, prms);
        }
        if kind == "indeterminacy" {
            let env = if map_has(problem, "env") { problem.env } else { nil };
            return cas().analyze_indeterminacy(problem.expr, env);
        }
        if kind == "pell" {
            return exact().solve_pell(problem.D);
        }
        if kind == "chakravala" {
            return world().chakravala_pell(problem.D);
        }
        if kind == "diophantine" {
            return exact().solve_diophantine_linear(problem.a, problem.b, problem.c);
        }
        if kind == "crt" {
            return exact().crt(problem.remainders, problem.moduli);
        }
        if kind == "factor_int" {
            return map{ ok: true, n: problem.n, factors: exact().prime_factorization(problem.n) };
        }
        if kind == "galois" {
            return pure().galois_analyze(problem.coeffs);
        }
        if kind == "groebner" {
            let ord = if map_has(problem, "order") { problem.order } else { "grevlex" };
            return pure().groebner_basis(problem.polys, problem.vars, ord);
        }
        if kind == "homology" {
            return pure().simplicial_homology(problem.simplices);
        }
        if kind == "riemannian" {
            return frontier().riemannian_geometry(problem.metric, problem.coords);
        }
        if kind == "euler_lagrange" {
            return frontier().euler_lagrange(problem.L, problem.q, problem.dq, if map_has(problem, "t") { problem.t } else { "t" });
        }
        if kind == "ito" {
            return frontier().ito_lemma(problem.f, problem.mu, problem.sigma, if map_has(problem, "t") { problem.t } else { "t" }, if map_has(problem, "x") { problem.x } else { "x" });
        }
        if kind == "nash" {
            return frontier().nash_equilibria_2p(problem.A, problem.B);
        }
        if kind == "diff" or kind == "derivative" {
            let v = if map_has(problem, "var") { problem.var } else { "x" };
            let ord = if map_has(problem, "order") { problem.order } else { 1 };
            return calculus().diff(problem.expr, v, ord);
        }
        if kind == "risch" {
            let v = if map_has(problem, "var") { problem.var } else { "x" };
            return calculus().risch_integrate(problem.expr, v);
        }
        if kind == "integral" or kind == "integrate" {
            let v = if map_has(problem, "var") { problem.var } else { "x" };
            if map_has(problem, "a") and map_has(problem, "b") {
                return calculus().integrate_definite(problem.expr, v, problem.a, problem.b);
            }
            return calculus().integrate_symbolic(problem.expr, v);
        }
        if kind == "limit" {
            let v = if map_has(problem, "var") { problem.var } else { "x" };
            let pt = if map_has(problem, "to") { problem.to } else { 0 };
            let dr = if map_has(problem, "dir") { problem.dir } else { "both" };
            return calculus().limit(problem.expr, v, pt, dr);
        }
        if kind == "taylor" {
            let v = if map_has(problem, "var") { problem.var } else { "x" };
            let c0 = if map_has(problem, "center") { problem.center } else { 0 };
            let ord = if map_has(problem, "order") { problem.order } else { 5 };
            return calculus().taylor(problem.expr, v, c0, ord);
        }
        if kind == "series" or kind == "sum" {
            let v = if map_has(problem, "var") { problem.var } else { "n" };
            return calculus().sum_series(problem.expr, v, problem.start, problem.end);
        }
        if kind == "ode" {
            let ic = if map_has(problem, "ic") { problem.ic } else { nil };
            return calculus().solve_ode_symbolic(problem.eq, ic);
        }
        if kind == "laplace" {
            return calculus().laplace(problem.expr, if map_has(problem, "t") { problem.t } else { "t" }, if map_has(problem, "s") { problem.s } else { "s" });
        }
        if kind == "inv_laplace" {
            return calculus().inv_laplace(problem.expr, if map_has(problem, "s") { problem.s } else { "s" }, if map_has(problem, "t") { problem.t } else { "t" });
        }
        if kind == "matrix_solve" or kind == "linear_system_exact" {
            return linalg().solve_exact(problem.A, problem.b);
        }
        if kind == "tikhonov" {
            let lg = if map_has(problem, "lambdas") { problem.lambdas } else { nil };
            return world().tikhonov_regularized_solve(problem.A, problem.b, lg);
        }
        if kind == "svd" {
            return linalg().svd(problem.A);
        }
        if kind == "eig" {
            return linalg().eig_general(problem.A);
        }
        if kind == "lp" or kind == "simplex" {
            let aeq = if map_has(problem, "A_eq") { problem.A_eq } else { nil };
            let beq = if map_has(problem, "b_eq") { problem.b_eq } else { nil };
            let mx = if map_has(problem, "maximize") { problem.maximize } else { true };
            return stats_opt().linprog_simplex(problem.c, problem.A_ub, problem.b_ub, aeq, beq, mx);
        }
        if kind == "milp" {
            let mx = if map_has(problem, "maximize") { problem.maximize } else { true };
            return stats_opt().milp_solve(problem.c, problem.A_ub, problem.b_ub, problem.int_vars, mx);
        }
        if kind == "boolean" {
            return stats_opt().boolean_analyze(problem.expr);
        }
        if kind == "black_scholes" {
            return stats_opt().black_scholes(problem.S, problem.K, problem.T, problem.r, problem.sigma, if map_has(problem, "type") { problem.type } else { "call" });
        }
        if map_has(problem, "expr") {
            return cas().solve(problem.expr, vars, opts);
        }
    }

    // 2. Array of equations/inequalities -> multivariate or simultaneous system
    if type(problem) == "array" {
        return cas().solve(problem, vars, opts);
    }

    // 3. String mathematical problem auto-classification
    let raw = str_trim(str(problem));
    if raw == "" {
        return map{ ok: false, error: "empty mathematical problem" };
    }

    // Check explicit functional command forms
    let a_diff = _match_func_call(raw, "diff");
    if a_diff != nil and len(a_diff) >= 1 {
        let v = if len(a_diff) >= 2 { a_diff[1] } else { "x" };
        let ord = if len(a_diff) >= 3 { num_round(parse_number(a_diff[2])) } else { 1 };
        let dr = calculus().diff(a_diff[0], v, ord);
        return map{ ok: true, domain: "calculus_differentiation", result: dr, ascii: dr.ascii, unicode: dr.unicode, latex: dr.latex, steps: dr.steps };
    }

    let a_risch = _match_func_call(raw, "risch");
    if a_risch == nil { a_risch = _match_func_call(raw, "risch_integrate"); }
    if a_risch != nil and len(a_risch) >= 1 {
        let v = if len(a_risch) >= 2 { a_risch[1] } else { "x" };
        return calculus().risch_integrate(a_risch[0], v);
    }

    let a_int = _match_func_call(raw, "integrate");
    if a_int == nil { a_int = _match_func_call(raw, "int"); }
    if a_int != nil and len(a_int) >= 1 {
        let v = if len(a_int) >= 2 { a_int[1] } else { "x" };
        if len(a_int) >= 4 {
            let lo = _parse_bound_arg(a_int[2]);
            let hi = _parse_bound_arg(a_int[3]);
            let qr = calculus().integrate_definite(a_int[0], v, lo, hi);
            return map{ ok: true, domain: "definite_integration", value: qr.value, error_estimate: qr.error_estimate, exact_symbolic_value: qr.exact_symbolic_value, method: qr.method };
        }
        let ir = calculus().integrate_symbolic(a_int[0], v);
        return map{
            ok: ir.ok,
            domain: "symbolic_integration",
            verified: ir.verified,
            is_elementary: try ir.is_elementary catch true,
            uses_special_functions: try ir.uses_special_functions catch false,
            liouville_obstruction: try ir.liouville_obstruction catch nil,
            ascii: try ir.ascii catch "",
            unicode: try ir.unicode catch "",
            latex: try ir.latex catch "",
            result: ir
        };
    }

    let a_lim = _match_func_call(raw, "limit");
    if a_lim != nil and len(a_lim) >= 3 {
        let dir = if len(a_lim) >= 4 { str_trim(a_lim[3]) } else { "both" };
        let lr = calculus().limit(a_lim[0], a_lim[1], _parse_bound_arg(a_lim[2]), dir);
        return map{
            ok: true,
            domain: "calculus_limit",
            exists: lr.exists,
            value: lr.value,
            indeterminate_form: try lr.indeterminate_form catch "none",
            exact_fraction: try lr.exact_fraction catch nil,
            symbolic_value: try lr.symbolic_value catch nil,
            oscillation_bounds: try lr.oscillation_bounds catch nil,
            method: lr.method,
            steps: lr.steps,
            result: lr
        };
    }

    let a_param = _match_func_call(raw, "solve_parametric");
    if a_param == nil { a_param = _match_func_call(raw, "parametric"); }
    if a_param != nil and len(a_param) >= 1 {
        let tv = if len(a_param) >= 2 { a_param[1] } else { "x" };
        return cas().solve_parametric(a_param[0], tv);
    }

    let a_indet = _match_func_call(raw, "indeterminacy");
    if a_indet == nil { a_indet = _match_func_call(raw, "analyze_indeterminacy"); }
    if a_indet != nil and len(a_indet) >= 1 {
        return cas().analyze_indeterminacy(a_indet[0], nil);
    }

    let a_tay = _match_func_call(raw, "taylor");
    if a_tay != nil and len(a_tay) >= 1 {
        let v = if len(a_tay) >= 2 { a_tay[1] } else { "x" };
        let c0 = if len(a_tay) >= 3 { _parse_bound_arg(a_tay[2]) } else { 0 };
        let ord = if len(a_tay) >= 4 { num_round(parse_number(a_tay[3])) } else { 5 };
        let tr = calculus().taylor(a_tay[0], v, c0, ord);
        return map{ ok: true, domain: "taylor_series", ascii: tr.ascii, unicode: tr.unicode, latex: tr.latex, coeffs: tr.coeffs, result: tr };
    }

    let a_sum = _match_func_call(raw, "sum");
    if a_sum != nil and len(a_sum) >= 4 {
        let sr = calculus().sum_series(a_sum[0], a_sum[1], _parse_bound_arg(a_sum[2]), _parse_bound_arg(a_sum[3]));
        return map{ ok: true, domain: "series_summation", value: sr.value, exact_str: try sr.exact_str catch nil, method: sr.method, result: sr };
    }

    let a_lap = _match_func_call(raw, "laplace");
    if a_lap != nil and len(a_lap) >= 1 {
        let tv = if len(a_lap) >= 2 { a_lap[1] } else { "t" };
        let sv = if len(a_lap) >= 3 { a_lap[2] } else { "s" };
        let lres = calculus().laplace(a_lap[0], tv, sv);
        return map{ ok: true, domain: "laplace_transform", ascii: lres.ascii, unicode: lres.unicode, latex: lres.latex, result: lres };
    }

    let a_ilap = _match_func_call(raw, "inv_laplace");
    if a_ilap != nil and len(a_ilap) >= 1 {
        let sv = if len(a_ilap) >= 2 { a_ilap[1] } else { "s" };
        let tv = if len(a_ilap) >= 3 { a_ilap[2] } else { "t" };
        let ilres = calculus().inv_laplace(a_ilap[0], sv, tv);
        return map{ ok: true, domain: "inverse_laplace_transform", ascii: ilres.ascii, unicode: ilres.unicode, latex: ilres.latex, result: ilres };
    }

    let a_pell = _match_func_call(raw, "pell");
    if a_pell != nil and len(a_pell) == 1 {
        let pr = exact().solve_pell(num_round(parse_number(a_pell[0])));
        return map{ ok: pr.solvable, domain: "number_theory_pell", D: pr.D, x1: str(pr.x1), y1: str(pr.y1), result: pr };
    }

    let a_dio = _match_func_call(raw, "diophantine");
    if a_dio != nil and len(a_dio) == 3 {
        let dr = exact().solve_diophantine_linear(num_round(parse_number(a_dio[0])), num_round(parse_number(a_dio[1])), num_round(parse_number(a_dio[2])));
        return map{ ok: dr.solvable, domain: "number_theory_diophantine", parametric_unicode: dr.parametric_unicode, parametric_latex: dr.parametric_latex, result: dr };
    }

    let a_bool = _match_func_call(raw, "boolean");
    if a_bool != nil and len(a_bool) == 1 {
        let br = stats_opt().boolean_analyze(a_bool[0]);
        return map{ ok: true, domain: "boolean_minimization_and_sat", method: try br.method catch "quine_mccluskey", minimal_sop: br.minimal_sop, is_tautology: br.is_tautology, is_contradiction: br.is_contradiction, result: br };
    }

    let a_zeta = _match_func_call(raw, "zeta");
    if a_zeta != nil and len(a_zeta) == 1 {
        let sv_z = parse_number(a_zeta[0]);
        let zv = frontier().zeta(sv_z);
        return map{ ok: true, domain: "analytic_number_theory_zeta", s: sv_z, value: zv };
    }

    for goal_cmd in ["simplify", "expand", "factor", "apart", "complete_square", "trig_simplify", "trig_expand", "log_expand", "log_combine", "rationalize"] {
        let g_args = _match_func_call(raw, goal_cmd);
        if g_args != nil and len(g_args) >= 1 {
            let g_opts = if len(g_args) >= 2 { map{ var: g_args[1] } } else { opts };
            return cas().transform(g_args[0], goal_cmd, g_opts);
        }
    }
    let iso_args = _match_func_call(raw, "isolate");
    if iso_args != nil and len(iso_args) >= 2 {
        return cas().transform(iso_args[0], "isolate", map{ var: iso_args[1] });
    }

    // 4. Differential equation detection: contains `y''` or `y'` and `=`
    if (str_contains(raw, "y''") or str_contains(raw, "y'")) and str_contains(raw, "=") {
        let parts = str_split(raw, ";");
        let ode_eq = str_trim(parts[0]);
        let ic = nil;
        if len(parts) > 1 {
            ic = map{ x0: 0.0, y0: 0.0 };
            let ic_items = str_split(parts[1], ",");
            let ii = 0;
            while ii < len(ic_items) {
                let it = str_replace_all(ic_items[ii], " ", "");
                if str_starts_with(it, "y'(") {
                    let p_close = str_index_of(it, ")");
                    let eq_p = str_index_of(it, "=");
                    if p_close > 3 and eq_p > p_close {
                        ic.x0 = parse_number(str_slice(it, 3, p_close));
                        ic.dy0 = parse_number(str_slice(it, eq_p + 1, len(it)));
                    }
                } elif str_starts_with(it, "y(") {
                    let p_close2 = str_index_of(it, ")");
                    let eq_p2 = str_index_of(it, "=");
                    if p_close2 > 2 and eq_p2 > p_close2 {
                        ic.x0 = parse_number(str_slice(it, 2, p_close2));
                        ic.y0 = parse_number(str_slice(it, eq_p2 + 1, len(it)));
                    }
                }
                ii = ii + 1;
            }
        }
        let ode_res = calculus().solve_ode_symbolic(ode_eq, ic);
        return map{
            ok: true,
            domain: "differential_equation",
            ascii: ode_res.ascii,
            unicode: ode_res.unicode,
            latex: ode_res.latex,
            steps: if map_has(ode_res, "steps") { ode_res.steps } else { [] },
            result: ode_res
        };
    }

    // 5. General CAS equation / inequality / system / expression solver
    let has_rel = str_contains(raw, "=") or str_contains(raw, "<") or str_contains(raw, ">") or str_contains(raw, "≤") or str_contains(raw, "≥") or str_contains(raw, "≠") or str_contains(raw, "\\le") or str_contains(raw, "\\ge");
    if not has_rel {
        // First check if pure ground arithmetic expression contains an algebraic indeterminacy (e.g. "0/0", "0^0")
        let c = cas();
        let ast = c.parse_math(raw);
        let fvs = c.free_vars(ast);
        if len(fvs) == 0 {
            let ind = try c.analyze_indeterminacy(raw, map{}) catch nil;
            if ind != nil and map_has(ind, "indeterminate") and ind.indeterminate {
                return map{
                    ok: true,
                    domain: "indeterminate_expression",
                    indeterminate: true,
                    form: ind.form,
                    meaning_el: ind.meaning_el,
                    meaning_en: ind.meaning_en,
                    indeterminacy: ind
                };
            }
            let simp_r = c.simplify(raw);
            let val = try c.eval_ast(simp_r.ast, map{}) catch nil;
            return map{
                ok: true,
                domain: "exact_expression_evaluation",
                value: val,
                ascii: simp_r.ascii,
                unicode: simp_r.unicode,
                latex: simp_r.latex,
                steps: simp_r.steps
            };
        }
        let tr_auto = c.transform(raw, "auto", opts);
        let zero_roots = try c.solve(raw + " = 0", vars, opts) catch nil;
        return map{
            ok: tr_auto.ok,
            domain: "symbolic_expression_analysis",
            free_vars: fvs,
            transformed: tr_auto,
            ascii: tr_auto.ascii,
            unicode: tr_auto.unicode,
            latex: tr_auto.latex,
            steps: tr_auto.steps,
            roots_if_zero: zero_roots
        };
    }

    return cas().solve(raw, vars, opts);
}

let solve_any = solve;

export VERSION, catalog, msc2020_registry, classify_open_vs_proved, world_canon,
       governor, exact, cas, calculus, linalg, stats_opt, pure, frontier, complex_riemann, world, interdisciplinary, quantum, algorithms, symbols,
       get_policy, set_policy, reset_policy, with_budget, current_limits, eval_guarded, analyze_indeterminacy, solve_parametric,
       render, transform, simplify, expand, factor, complete_square, apart, isolate,
       plot_svg, plot_svg_report,
       diff, integrate, risch_integrate, limit, taylor, solve_ode,
       solve, solve_any;
