// stdlib/browser.sapp — a minimal web browser ENGINE, written in pblang.
//
// The fetch-and-parse core of a browser, done entirely in pblang: it retrieves a page
// over HTTP and extracts its title, readable text, links, and forms by string-processing
// the HTML. The native IDE's Browser view uses this module directly, so the reader
// remains browser-free: no DOM, no JS engine, no HTML/CSS renderer.
//
//   let b = import("stdlib/browser.sapp");
//   let page = b.fetch_page("http://example.com");
//   print page.title;  print page.text;  print page.links;
//
// Rendering of sub-resources/scripts is the browser host's job; this module is the
// engine (fetch + parse). All pblang.

// fetch(url) — GET the raw page body, or nil on failure.
fn fetch(url) {
    return try http_get(url) catch nil;
}

// fetch_tor(url) — fetch THROUGH the Tor SOCKS5 proxy (127.0.0.1:9050) for anonymity.
// Opt-in only (never the default). The SOCKS5 protocol is ready (stdlib/socks5.sapp);
// the transport needs a plain `tcp_connect` builtin (the VM has tcp_listen/accept +
// only tcp_connect_tls) and TLS-inside-SOCKS for https — see docs/Protocols.md. Until
// those land this returns nil and the caller reports the requirement.
fn fetch_tor(url) {
    // let socks = import("stdlib/socks5.sapp");
    // let s = tcp_connect("127.0.0.1:9050");            // <-- needs the tcp_connect builtin
    // tcp_write(s, socks.greeting()); ... CONNECT host:port ... then speak HTTP over `s`.
    return nil;
}

// ── HTML entity decoding + whitespace collapsing (reader-view text quality) ───────────
fn _parse_hex(h) {
    let v = 0;
    let i = 0;
    while i < len(h) {
        let c = strcharcodeat(h, i);
        let d = 0 - 1;
        if c >= 48 and c <= 57 { d = c - 48; }
        else if c >= 97 and c <= 102 { d = c - 97 + 10; }
        else if c >= 65 and c <= 70 { d = c - 65 + 10; }
        if d < 0 { return nil; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

// _entity_char(ent) — `ent` is the text between '&' and ';' ("amp", "#917", "#x1F600").
fn _entity_char(ent) {
    if len(ent) == 0 { return nil; }
    if strcharcodeat(ent, 0) == 35 {                          // '#' → numeric reference
        let num = nil;
        if len(ent) > 1 and (strcharcodeat(ent, 1) == 120 or strcharcodeat(ent, 1) == 88) {
            num = _parse_hex(str_slice(ent, 2, len(ent)));   // &#x..; hex
        } else {
            num = parse_number(str_slice(ent, 1, len(ent))); // &#..; decimal
        }
        if num == nil { return nil; }
        return strfromcharcode(num);
    }
    if ent == "amp" { return "&"; }
    if ent == "lt" { return "<"; }
    if ent == "gt" { return ">"; }
    if ent == "quot" { return "\""; }
    if ent == "apos" { return "'"; }
    if ent == "nbsp" { return " "; }
    if ent == "copy" { return strfromcharcode(169); }
    if ent == "reg" { return "(r)"; }
    if ent == "trade" { return "(tm)"; }
    if ent == "mdash" { return strfromcharcode(8212); }
    if ent == "ndash" { return strfromcharcode(8211); }
    if ent == "hellip" { return strfromcharcode(8230); }
    return nil;
}

// _decode_entities(s) — turn &amp; &#917; &#x1F600; &nbsp; … into their characters.
fn _decode_entities(s) {
    if str_index_of(s, "&") < 0 { return s; }                // fast path: nothing to do
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 38 {                                          // '&'
            let semi = str_index_of(str_slice(s, i, n), ";");
            let handled = false;
            // Named entities are short, but numeric code points may be longer than the
            // old 11-char cap. Keep a bounded scan so broken pages cannot make huge slices.
            if semi > 1 and semi < 32 {
                let ch = _entity_char(str_slice(s, i + 1, i + semi));
                if ch != nil { out = out + ch; i = i + semi + 1; handled = true; }
            }
            if not handled { out = out + "&"; i = i + 1; }
        } else {
            out = out + strfromcharcode(c);
            i = i + 1;
        }
    }
    return out;
}

// _collapse_ws(s) — squeeze runs of spaces/tabs/newlines into a single space.
fn _collapse_ws(s) {
    let out = "";
    let prev_sp = false;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c == 32 or c == 9 or c == 10 or c == 13 {
            if not prev_sp { out = out + " "; }
            prev_sp = true;
        } else {
            out = out + strfromcharcode(c);
            prev_sp = false;
        }
        i = i + 1;
    }
    return out;
}

fn title(html) {
    let lo = str_lower(html);
    let a = str_index_of(lo, "<title>");
    if a < 0 { return ""; }
    let b = str_index_of(lo, "</title>");
    if b < 0 { return ""; }
    return str_trim(_decode_entities(str_slice(html, a + 7, b)));
}

// _remove_block(html, tag) — delete every <tag …>…</tag> region (e.g. script, style),
// so their contents don't leak into the reader text.
fn _remove_block(html, tag) {
    let open = "<" + tag;
    let close = "</" + tag + ">";
    let out = "";
    let rest = html;
    while true {
        let lo = str_lower(rest);
        let a = str_index_of(lo, open);
        if a < 0 { return out + rest; }
        out = out + str_slice(rest, 0, a);
        let c = str_index_of(lo, close);
        if c < 0 { return out; }
        rest = str_slice(rest, c + len(close), len(rest));
    }
}

// strip_tags(html) — readable text: drop script/style blocks, then everything between
// '<' and '>'. (A reader view; the native IDE draws this with its bitmap font.)
fn strip_tags(html) {
    html = _remove_block(_remove_block(html, "script"), "style");
    let parts = str_split(html, "<");
    let out = "";
    let i = 0;
    while i < len(parts) {
        if i == 0 {
            out = out + parts[i];
        } else {
            let gt = str_index_of(parts[i], ">");
            // A removed tag becomes a SPACE so adjacent words (e.g. "Google</a><a>Gmail")
            // don't fuse into "GoogleGmail". Collapsed back to single spaces below.
            if gt >= 0 { out = out + " " + str_slice(parts[i], gt + 1, len(parts[i])); }
        }
        i = i + 1;
    }
    return str_trim(_collapse_ws(_decode_entities(out)));
}

fn _tag_texts(html, tag, limit) {
    let out = [];
    let lo = str_lower(html);
    let open = "<" + tag;
    let close = "</" + tag + ">";
    let rest = html;
    let lrest = lo;
    while len(out) < limit {
        let a = str_index_of(lrest, open);
        if a < 0 { return out; }
        let gt = str_index_of(str_slice(lrest, a, len(lrest)), ">");
        if gt < 0 { return out; }
        let start = a + gt + 1;
        let b_rel = str_index_of(str_slice(lrest, start, len(lrest)), close);
        if b_rel < 0 { return out; }
        let raw = str_slice(rest, start, start + b_rel);
        let txt = strip_tags(raw);
        if txt != "" { array_push(out, txt); }
        rest = str_slice(rest, start + b_rel + len(close), len(rest));
        lrest = str_slice(lrest, start + b_rel + len(close), len(lrest));
    }
    return out;
}

fn images(page_url, html) {
    let out = [];
    let parts = str_split(html, "<img");
    let i = 1;
    while i < len(parts) and len(out) < 80 {
        let gt = str_index_of(parts[i], ">");
        if gt >= 0 {
            let tag = str_slice(parts[i], 0, gt);
            let src = _attr(tag, "src");
            let alt = _attr(tag, "alt");
            if src != nil {
                array_push(out, map{
                    src: resolve(page_url, src),
                    alt: if alt == nil { "" } else { alt },
                });
            }
        }
        i = i + 1;
    }
    return out;
}

fn _block_text_ok(text) {
    let t = str_trim(str(text));
    let lo = str_lower(t);
    if t == "" { return false; }
    if len(t) > 180 { return false; }
    if str_contains(t, "AAAAAA") or str_contains(t, "////") { return false; }
    if str_contains(lo, "cookie") or str_contains(lo, "privacy policy") { return false; }
    if str_contains(lo, "service login") or str_contains(lo, "passivetrue") { return false; }
    return true;
}

fn _push_block(out, kind, text) {
    if _block_text_ok(text) { array_push(out, map{ kind: kind, text: str_trim(text) }); }
    return 0;
}

// page_blocks(page) -> lightweight visual-page model for native pblang rendering.
// This is intentionally not a DOM/CSS engine; it extracts high-signal page structure.
fn page_blocks(page) {
    let html = try page.html catch "";
    let out = [];
    let ttl = try page.title catch "";
    if ttl != "" { _push_block(out, "title", ttl); }
    let h1 = _tag_texts(html, "h1", 8);
    let i = 0;
    while i < len(h1) { _push_block(out, "h1", h1[i]); i = i + 1; }
    let h2 = _tag_texts(html, "h2", 12);
    i = 0;
    while i < len(h2) { _push_block(out, "h2", h2[i]); i = i + 1; }
    let paras = _tag_texts(html, "p", 30);
    i = 0;
    while i < len(paras) { _push_block(out, "p", paras[i]); i = i + 1; }
    if len(out) < 3 {
        let reader = str_split(try page.text catch "", " ");
        let cur = "";
        i = 0;
        while i < len(reader) and len(out) < 7 {
            let w = str_trim(reader[i]);
            if w != "" {
                if len(cur) + len(w) + 1 > 110 {
                    _push_block(out, "p", cur);
                    cur = w;
                } else if cur == "" { cur = w; }
                else { cur = cur + " " + w; }
            }
            i = i + 1;
        }
        if cur != "" and len(out) < 7 { _push_block(out, "p", cur); }
    }
    let imgs = images(try page.url catch "", html);
    i = 0;
    while i < len(imgs) and i < 6 {
        let alt = try imgs[i].alt catch "";
        let src = try imgs[i].src catch "";
        if _block_text_ok(alt) and not str_starts_with(str_lower(src), "data:") {
            array_push(out, map{ kind: "img", text: alt, src: src });
        }
        i = i + 1;
    }
    let fs = try page.forms catch [];
    i = 0;
    while i < len(fs) and i < 4 {
        let f = fs[i];
        let fields = try f.fields catch [];
        let action = str(try f.action catch "");
        array_push(out, map{
            kind: "form",
            text: "Form " + str_upper(str(try f.method catch "get")) + " " + action + " (" + str(len(fields)) + " field(s))",
            action: action,
            form_index: i,
            fields: len(fields)
        });
        i = i + 1;
    }
    if len(out) == 0 {
        array_push(out, map{ kind: "p", text: try page.text catch "" });
    }
    return out;
}

fn _wrap_plain(text, width) {
    if width < 8 { width = 8; }
    let words = str_split(_collapse_ws(str(text)), " ");
    let out = [];
    let cur = "";
    let i = 0;
    while i < len(words) {
        let w = str_trim(words[i]);
        if w != "" {
            if len(w) > width {
                if cur != "" { push(out, cur); cur = ""; }
                let rest = w;
                while len(rest) > width {
                    push(out, str_slice(rest, 0, width));
                    rest = str_slice(rest, width, len(rest));
                }
                if rest != "" { cur = rest; }
            }
            else if cur == "" { cur = w; }
            else if len(cur) + len(w) + 1 > width { push(out, cur); cur = w; }
            else { cur = cur + " " + w; }
        }
        i = i + 1;
    }
    if cur != "" { push(out, cur); }
    return out;
}

fn _push_wrapped(out, prefix, text, width) {
    if width <= len(prefix) + 4 {
        push(out, str_slice(prefix + str(text), 0, width));
        return 0;
    }
    let lines = _wrap_plain(text, width - len(prefix));
    if len(lines) == 0 { push(out, prefix); return 0; }
    let i = 0;
    while i < len(lines) {
        let p = prefix;
        if i > 0 { p = str_repeat(" ", len(prefix)); }
        push(out, p + lines[i]);
        i = i + 1;
    }
    return 0;
}

fn _layout_min_h(kind) {
    if kind == "title" { return 4; }
    if kind == "h1" { return 4; }
    if kind == "h2" { return 3; }
    if kind == "img" { return 6; }
    if kind == "form" { return 4; }
    if kind == "link" { return 3; }
    return 3;
}

fn _layout_prefix(kind) {
    if kind == "img" { return "[image] "; }
    if kind == "form" { return "[form] "; }
    if kind == "link" { return "[link] "; }
    return "";
}

// page_layout(page, viewport_cols) — deterministic pblang-native flow layout.
// It is not CSS/DOM. It turns the high-signal page blocks into boxes with
// x/y/w/h geometry that PBIDE can draw, test, inspect, and scroll.
fn page_layout(page, viewport_cols = 96) {
    let cols = try parse_number(str(viewport_cols)) catch 96;
    if cols == nil { cols = 96; }
    cols = num_floor(cols);
    if cols < 32 { cols = 32; }
    if cols > 180 { cols = 180; }
    let blocks = page_blocks(page);
    let boxes = [];
    let y = 0;
    let i = 0;
    while i < len(blocks) and len(boxes) < 160 {
        let b = blocks[i];
        let kind = str(try b.kind catch "p");
        let prefix = _layout_prefix(kind);
        let text = str(try b.text catch "");
        if kind == "img" and text == "" { text = str(try b.src catch ""); }
        let content_w = cols - 4 - len(prefix);
        if content_w < 12 { content_w = 12; }
        let lines = _wrap_plain(text, content_w);
        let h = len(lines) + 2;
        let minh = _layout_min_h(kind);
        if h < minh { h = minh; }
        let box = map{
            format: "pblang.browser.layout_box.v1",
            index: len(boxes),
            kind: kind,
            text: text,
            src: str(try b.src catch ""),
            href: str(try b.href catch ""),
            action: str(try b.action catch ""),
            form_index: try b.form_index catch 0 - 1,
            x: 0,
            y: y,
            w: cols,
            h: h,
            lines: lines,
            line_count: len(lines)
        };
        array_push(boxes, box);
        y = y + h + 1;
        i = i + 1;
    }
    let lks = try page.links catch [];
    i = 0;
    while i < len(lks) and len(boxes) < 180 and i < 20 {
        let href = str(lks[i]);
        let prefix = _layout_prefix("link");
        let content_w = cols - 4 - len(prefix);
        if content_w < 12 { content_w = 12; }
        let lines = _wrap_plain(href, content_w);
        let h = len(lines) + 2;
        if h < _layout_min_h("link") { h = _layout_min_h("link"); }
        array_push(boxes, map{
            format: "pblang.browser.layout_box.v1",
            index: len(boxes),
            kind: "link",
            text: href,
            href: href,
            src: "",
            action: href,
            form_index: 0 - 1,
            x: 0,
            y: y,
            w: cols,
            h: h,
            lines: lines,
            line_count: len(lines)
        });
        y = y + h + 1;
        i = i + 1;
    }
    return map{
        format: "pblang.browser.layout.v1",
        renderer: "pblang-native-flow",
        width: cols,
        height: y,
        boxes: boxes,
        box_count: len(boxes),
        source_blocks: len(blocks),
        css: false,
        dom: false,
        js: false,
        note: "native flow layout for PBIDE Live mode; not a full CSS/DOM engine"
    };
}

fn page_layout_hit(layout, col, row) {
    if layout == nil { return nil; }
    let c = try parse_number(str(col)) catch 0;
    let r = try parse_number(str(row)) catch 0;
    if c == nil { c = 0; }
    if r == nil { r = 0; }
    c = num_floor(c);
    r = num_floor(r);
    let boxes = try layout.boxes catch [];
    let i = 0;
    while i < len(boxes) {
        let b = boxes[i];
        let x = try b.x catch 0;
        let y = try b.y catch 0;
        let w = try b.w catch 0;
        let h = try b.h catch 0;
        if c >= x and c < x + w and r >= y and r < y + h {
            b.hit_col = c;
            b.hit_row = r;
            return b;
        }
        i = i + 1;
    }
    return nil;
}

fn page_layout_lines(page, width = 96, limit = 80) {
    if limit == nil or limit < 1 { limit = 80; }
    let lay = page_layout(page, width);
    let out = [
        "pblang-native layout",
        "renderer: " + str(try lay.renderer catch "pblang-native-flow") +
            "  boxes: " + str(try lay.box_count catch 0) +
            "  size: " + str(try lay.width catch 0) + "x" + str(try lay.height catch 0),
        "css/dom/js: off/off/off"
    ];
    let boxes = try lay.boxes catch [];
    let i = 0;
    while i < len(boxes) and len(out) < limit {
        let b = boxes[i];
        let head = str(try b.index catch i) + ". " + str(try b.kind catch "?") +
            " @ " + str(try b.x catch 0) + "," + str(try b.y catch 0) +
            " " + str(try b.w catch 0) + "x" + str(try b.h catch 0);
        _push_wrapped(out, head + "  ", str(try b.text catch ""), width);
        i = i + 1;
    }
    return out;
}

// source_lines(page, width, limit) — developer/source view for the native browser.
fn source_lines(page, width = 120, limit = 600) {
    let html = try page.html catch "";
    if html == "" { return ["No source loaded. Load a page first."]; }
    let raw = str_split(str_replace_all(html, "\r\n", "\n"), "\n");
    let out = [];
    let i = 0;
    while i < len(raw) and i < limit {
        let n = str(i + 1);
        while len(n) < 4 { n = " " + n; }
        _push_wrapped(out, n + " | ", raw[i], width);
        i = i + 1;
    }
    if len(raw) > limit { push(out, "... source truncated at " + str(limit) + " line(s)"); }
    return out;
}

// inspector_lines(page, width) — compact F12-style facts for native pblang browser UI.
fn inspector_lines(page, width = 120) {
    if page == nil { return ["No page loaded."]; }
    let out = [];
    let html = try page.html catch "";
    let text = try page.text catch "";
    let lks = try page.links catch [];
    let imgs = try page.images catch [];
    let fs = try page.forms catch [];
    push(out, "pblang DevTools / Inspector");
    push(out, "URL: " + str(try page.url catch ""));
    push(out, "Status: " + str(try page.status catch "?") + "  OK: " + str(try page.ok catch false));
    _push_wrapped(out, "Title: ", str(try page.title catch ""), width);
    push(out, "HTML bytes/chars: " + str(len(html)) + "  text chars: " + str(len(text)));
    push(out, "Links: " + str(len(lks)) + "  Images: " + str(len(imgs)) + "  Forms: " + str(len(fs)));
    let pol = try page.policy catch nil;
    if pol != nil {
        push(out, "Policy: " + str(try pol.reason catch "checked") + "  host=" + str(try pol.host catch ""));
    }
    push(out, "");
    push(out, "Elements");
    let blocks = page_blocks(page);
    let i = 0;
    while i < len(blocks) and i < 30 {
        let b = blocks[i];
        _push_wrapped(out, "  " + str(i + 1) + ". <" + str(try b.kind catch "?") + "> ", str(try b.text catch ""), width);
        i = i + 1;
    }
    push(out, "");
    push(out, "Network / Links");
    i = 0;
    while i < len(lks) and i < 20 {
        _push_wrapped(out, "  " + str(i + 1) + ". ", lks[i], width);
        i = i + 1;
    }
    if len(lks) == 0 { push(out, "  none"); }
    push(out, "");
    push(out, "Images");
    i = 0;
    while i < len(imgs) and i < 20 {
        let img = imgs[i];
        _push_wrapped(out, "  " + str(i + 1) + ". ", str(try img.alt catch "") + " -> " + str(try img.src catch ""), width);
        i = i + 1;
    }
    if len(imgs) == 0 { push(out, "  none"); }
    push(out, "");
    push(out, "Forms");
    i = 0;
    while i < len(fs) and i < 20 {
        let f = fs[i];
        _push_wrapped(out, "  " + str(i + 1) + ". ", str_upper(str(try f.method catch "get")) + " " + str(try f.action catch ""), width);
        let fields = try f.fields catch [];
        let j = 0;
        while j < len(fields) and j < 12 {
            let fld = fields[j];
            push(out, "       field " + str(j + 1) + ": " + str(try fld.name catch "?") + " : " + str(try fld.type catch "text"));
            j = j + 1;
        }
        i = i + 1;
    }
    if len(fs) == 0 { push(out, "  none"); }
    return out;
}

fn page_reading_stats(page) {
    let text = str(try page.text catch "");
    let words = 0;
    let in_word = false;
    let i = 0;
    while i < len(text) {
        let c = strcharcodeat(text, i);
        let sep = c <= 32 or c == 44 or c == 46 or c == 59 or c == 58 or c == 33 or c == 63;
        if sep {
            in_word = false;
        } else if not in_word {
            words = words + 1;
            in_word = true;
        }
        i = i + 1;
    }
    let minutes = (words + 199) / 200;
    if minutes < 1 and words > 0 { minutes = 1; }
    return map{
        chars: len(text),
        words: words,
        read_minutes: minutes,
        links: len(try page.links catch []),
        images: len(try page.images catch []),
        forms: len(try page.forms catch [])
    };
}

fn page_stats_lines(page) {
    let st = page_reading_stats(page);
    return [
        "Page stats",
        "Title: " + str(try page.title catch ""),
        "URL: " + str(try page.url catch ""),
        "Words: " + str(try st.words catch 0),
        "Characters: " + str(try st.chars catch 0),
        "Read time: " + str(try st.read_minutes catch 0) + " min",
        "Links: " + str(try st.links catch 0),
        "Images: " + str(try st.images catch 0),
        "Forms: " + str(try st.forms catch 0)
    ];
}

fn page_find_lines(page, query, limit = 40) {
    let q = str_lower(str_trim(str(query)));
    let out = ["Find in page: " + str(query)];
    if q == "" {
        push(out, "Type a query to search visible page text.");
        return out;
    }
    if limit == nil or limit < 1 { limit = 40; }
    let lines = str_split(str(try page.text catch ""), "\n");
    let hits = 0;
    let i = 0;
    while i < len(lines) and hits < limit {
        let line = str_trim(str(lines[i]));
        if line != "" and str_contains(str_lower(line), q) {
            hits = hits + 1;
            let shown = line;
            if len(shown) > 140 { shown = str_slice(shown, 0, 140); }
            push(out, str(hits) + ". L" + str(i + 1) + "  " + shown);
        }
        i = i + 1;
    }
    if hits == 0 { push(out, "No matches."); }
    else { out[0] = "Find in page: " + str(query) + "  (" + str(hits) + " shown)"; }
    return out;
}

fn bookmark_record(page) {
    return map{
        title: str(try page.title catch try page.url catch ""),
        url: str(try page.url catch ""),
        added: try now_iso() catch "now"
    };
}

fn bookmark_push(bookmarks, page, limit = 80) {
    if limit == nil or limit < 1 { limit = 80; }
    let rec = bookmark_record(page);
    let url = str(try rec.url catch "");
    let out = [];
    if url == "" { return out; }
    push(out, rec);
    let i = 0;
    while bookmarks != nil and i < len(bookmarks) and len(out) < limit {
        let old = bookmarks[i];
        if str(try old.url catch "") != url { push(out, old); }
        i = i + 1;
    }
    return out;
}

fn bookmark_remove(bookmarks, index) {
    let idx = try parse_number(str(index)) catch 0;
    if idx == nil { idx = 0; }
    idx = num_floor(idx);
    let out = [];
    let i = 0;
    while bookmarks != nil and i < len(bookmarks) {
        if i != idx { push(out, bookmarks[i]); }
        i = i + 1;
    }
    return out;
}

fn bookmark_lines(bookmarks, limit = 40) {
    let out = ["Bookmarks"];
    if bookmarks == nil or len(bookmarks) == 0 {
        push(out, "No bookmarks yet. Press Ctrl+D in Browser to bookmark the current page.");
        return out;
    }
    if limit == nil or limit < 1 { limit = len(bookmarks); }
    let i = 0;
    while i < len(bookmarks) and i < limit {
        let b = bookmarks[i];
        push(out, str(i + 1) + ". " + str(try b.title catch "") + "  " + str(try b.url catch ""));
        i = i + 1;
    }
    return out;
}

fn download_plan(url, mode = "safe") {
    let pol = url_policy_mode(url, mode);
    let clean = str(try pol.url catch url);
    let name = clean;
    let q = str_index_of(name, "?");
    if q >= 0 { name = str_slice(name, 0, q); }
    let slash = 0 - 1;
    let i = 0;
    while i < len(name) {
        if strcharcodeat(name, i) == 47 { slash = i; }
        i = i + 1;
    }
    if slash >= 0 and slash < len(name) - 1 { name = str_slice(name, slash + 1, len(name)); }
    if name == "" or str_contains(name, "://") { name = "download.bin"; }
    return map{
        ok: try pol.ok catch false,
        url: clean,
        filename: name,
        mode: mode,
        blocked_reason: try pol.reason catch "",
        summary: if try pol.ok catch false { "download plan: " + name + " from " + clean } else { "download blocked: " + str(try pol.reason catch "policy") }
    };
}

// links(html) — every href target in true DOCUMENT order, for both " and '
// quoting. Splitting on `href=` (rather than per-quote-style) keeps the targets
// in the order they appear in the source — the previous version emitted all
// double-quoted hrefs before any single-quoted ones, scrambling the order.
fn links(html) {
    let parts = str_split(html, "href=");
    let out = [];
    let i = 1;
    while i < len(parts) {
        let seg = parts[i];
        if len(seg) > 0 {
            let qc = str_slice(seg, 0, 1);            // the quote char after `href=`
            if qc == "\"" or qc == "'" {
                let rest = str_slice(seg, 1, len(seg));
                let q = str_index_of(rest, qc);       // matching close quote
                if q > 0 { push(out, str_slice(rest, 0, q)); }
            }
        }
        i = i + 1;
    }
    return out;
}

// ── URL resolution (turn page-relative hrefs into absolute URLs) ──────────────────────
fn _last_slash(s) {
    let last = 0 - 1;
    let i = 0;
    while i < len(s) { if strcharcodeat(s, i) == 47 { last = i; } i = i + 1; }   // '/'=47
    return last;
}

// _split_url(url) -> map{ scheme, host, path }.
fn _split_url(url) {
    let scheme = "http";
    let rest = url;
    let si = str_index_of(url, "://");
    if si >= 0 { scheme = str_slice(url, 0, si); rest = str_slice(url, si + 3, len(url)); }
    let slash = str_index_of(rest, "/");
    if slash < 0 { return map{ scheme: scheme, host: rest, path: "/" }; }
    return map{ scheme: scheme, host: str_slice(rest, 0, slash), path: str_slice(rest, slash, len(rest)) };
}

fn _host_no_port(host) {
    let h = str_lower(str_trim(host));
    if str_starts_with(h, "[") { return h; }          // IPv6 literal; keep bracket form.
    let c = str_index_of(h, ":");
    if c >= 0 { return str_slice(h, 0, c); }
    return h;
}

fn _port_of_host(host) {
    let h = str_lower(str_trim(host));
    if str_starts_with(h, "[") { return nil; }
    let c = str_index_of(h, ":");
    if c < 0 { return nil; }
    let p = parse_number(str_slice(h, c + 1, len(h)));
    return p;
}

fn _has_control_or_space(s) {
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c <= 32 or c == 127 { return true; }
        i = i + 1;
    }
    return false;
}

fn _has_userinfo(host) {
    return str_index_of(host, "@") >= 0;
}

fn _is_dangerous_port(port) {
    if port == nil { return false; }
    return port == 21 or port == 22 or port == 23 or port == 25 or port == 53
        or port == 110 or port == 143 or port == 389 or port == 445 or port == 465
        or port == 587 or port == 993 or port == 995 or port == 1433 or port == 1521
        or port == 3306 or port == 5432 or port == 6379 or port == 9200 or port == 9300
        or port == 11211 or port == 27017;
}

fn _block_patterns() {
    return [
        map{ kind: "tracker", pattern: "google-analytics.com" },
        map{ kind: "tracker", pattern: "googletagmanager.com" },
        map{ kind: "tracker", pattern: "doubleclick.net" },
        map{ kind: "tracker", pattern: "facebook.net" },
        map{ kind: "tracker", pattern: "facebook.com/tr" },
        map{ kind: "tracker", pattern: "connect.facebook.net" },
        map{ kind: "tracker", pattern: "hotjar.com" },
        map{ kind: "tracker", pattern: "segment.io" },
        map{ kind: "tracker", pattern: "mixpanel.com" },
        map{ kind: "tracker", pattern: "amplitude.com" },
        map{ kind: "tracker", pattern: "scorecardresearch.com" },
        map{ kind: "tracker", pattern: "quantserve.com" },
        map{ kind: "ad", pattern: "/ads/" },
        map{ kind: "ad", pattern: "/adserver/" },
        map{ kind: "ad", pattern: "adservice.google." },
        map{ kind: "ad", pattern: "googlesyndication.com" },
        map{ kind: "ad", pattern: "adnxs.com" },
        map{ kind: "ad", pattern: "taboola.com" },
        map{ kind: "ad", pattern: "outbrain.com" },
        map{ kind: "malicious", pattern: "phishing" },
        map{ kind: "malicious", pattern: "malware" },
        map{ kind: "malicious", pattern: "cryptominer" },
        map{ kind: "malicious", pattern: "coinhive" },
    ];
}

fn classify_url_threat(url) {
    let lo = str_lower(str(url));
    let out = [];
    let ps = _block_patterns();
    let i = 0;
    while i < len(ps) {
        if str_contains(lo, ps[i].pattern) {
            push(out, ps[i]);
        }
        i = i + 1;
    }
    return out;
}

fn threat_policy(url, allow_ads = false, allow_trackers = false) {
    let hits = classify_url_threat(url);
    let i = 0;
    while i < len(hits) {
        let k = hits[i].kind;
        if k == "malicious" { return map{ ok: false, reason: "blocked malicious pattern: " + hits[i].pattern, threats: hits }; }
        if k == "ad" and not allow_ads { return map{ ok: false, reason: "blocked ad pattern: " + hits[i].pattern, threats: hits }; }
        if k == "tracker" and not allow_trackers { return map{ ok: false, reason: "blocked tracker pattern: " + hits[i].pattern, threats: hits }; }
        i = i + 1;
    }
    return map{ ok: true, reason: "no blocked threat patterns", threats: hits };
}

fn _is_private_host(host) {
    let h = _host_no_port(host);
    if h == "" { return true; }
    if h == "localhost" or h == "::1" or h == "[::1]" { return true; }
    if str_ends_with(h, ".local") { return true; }
    if str_starts_with(h, "127.") or str_starts_with(h, "10.") or str_starts_with(h, "0.") { return true; }
    if str_starts_with(h, "169.254.") or str_starts_with(h, "192.168.") { return true; }
    if str_starts_with(h, "172.") {
        let rest = str_slice(h, 4, len(h));
        let dot = str_index_of(rest, ".");
        if dot > 0 {
            let oct = parse_number(str_slice(rest, 0, dot));
            if oct != nil and oct >= 16 and oct <= 31 { return true; }
        }
    }
    return false;
}

// security_profile(mode) — named browser security modes used by the native IDE.
// safe: default no-private/no-trackers/no-ads/no-Tor.
// live: same network safety, but UI may enable link/form interaction.
// jsdom: explicit host-rendered JS/DOM opt-in, still blocks private hosts by default.
// trusted: explicit local/private opt-in for trusted development pages.
fn security_profile(mode) {
    let m = str_lower(str_trim(str(mode)));
    if m == "trusted" or m == "trusted-local" {
        return map{
            mode: "trusted",
            label: "Trusted",
            allow_private: true,
            allow_ads: false,
            allow_trackers: false,
            forms: true,
            links: true,
            host_render: true,
            tor: false,
            note: "trusted local/private browsing; still blocks malicious patterns and service ports"
        };
    }
    if m == "jsdom" or m == "js-dom" or m == "dom" or m == "javascript" {
        return map{
            mode: "jsdom",
            label: "JS/DOM",
            allow_private: false,
            allow_ads: false,
            allow_trackers: false,
            forms: true,
            links: true,
            host_render: true,
            js: true,
            dom: true,
            tor: false,
            note: "host-rendered JavaScript/DOM opt-in; no private hosts, ads, or trackers"
        };
    }
    if m == "live" or m == "interactive" {
        return map{
            mode: "live",
            label: "Live",
            allow_private: false,
            allow_ads: false,
            allow_trackers: false,
            forms: true,
            links: true,
            host_render: false,
            js: false,
            dom: false,
            tor: false,
            note: "interactive pblang browsing; forms/links allowed, no private hosts, no JS/DOM"
        };
    }
    if m == "tor" {
        return map{
            mode: "tor",
            label: "Tor",
            allow_private: false,
            allow_ads: false,
            allow_trackers: false,
            forms: false,
            links: true,
            host_render: false,
            js: false,
            dom: false,
            tor: true,
            note: "Tor route requested; needs tcp_connect SOCKS/TLS support before it can fetch"
        };
    }
    return map{
        mode: "safe",
        label: "Safe",
        allow_private: false,
        allow_ads: false,
        allow_trackers: false,
        forms: false,
        links: true,
        host_render: false,
        js: false,
        dom: false,
        tor: false,
        note: "maximum default safety; no private hosts, trackers, ads, JS, DOM, or form submits"
    };
}

fn next_security_mode(mode) {
    let m = str_lower(str_trim(str(mode)));
    if m == "safe" { return "live"; }
    if m == "live" or m == "interactive" { return "jsdom"; }
    if m == "jsdom" or m == "js-dom" or m == "dom" or m == "javascript" { return "trusted"; }
    if m == "trusted" or m == "trusted-local" { return "tor"; }
    return "safe";
}

fn _onoff(v) {
    if v { return "on"; }
    return "off";
}

fn security_summary(mode) {
    let p = security_profile(mode);
    let blockers = "ads:blocked trackers:blocked";
    if try p.allow_ads catch false { blockers = "ads:allowed trackers:blocked"; }
    if (try p.allow_ads catch false) and (try p.allow_trackers catch false) { blockers = "ads:allowed trackers:allowed"; }
    return "Security " + str(try p.label catch mode)
        + " | links:" + _onoff(try p.links catch false)
        + " forms:" + _onoff(try p.forms catch false)
        + " private:" + _onoff(try p.allow_private catch false)
        + " tor:" + _onoff(try p.tor catch false)
        + " | " + blockers
        + " | js/dom:" + _onoff((try p.js catch false) and (try p.dom catch false))
        + " | " + str(try p.note catch "");
}

fn native_interaction_summary(mode) {
    let p = security_profile(mode);
    let jsdom = (try p.js catch false) and (try p.dom catch false);
    let prefix = "Native interaction: links/forms/images";
    if not (try p.forms catch false) { prefix = "Native interaction: links/images; forms blocked"; }
    if jsdom {
        return prefix + " | JS/DOM uses explicit host-render opt-in; pblang-native browser still does not execute page JavaScript.";
    }
    return prefix + " | no full JavaScript/DOM execution yet.";
}

// url_policy(url, allow_private=false) — native Browser safety gate.
// It only permits explicit http(s) URLs. Local/private hosts are blocked by default so
// a pasted page/form cannot silently probe loopback, LAN devices, or file-like schemes.
fn url_policy(url, allow_private = false, allow_ads = false, allow_trackers = false) {
    let raw = str_trim(str(url));
    let lower = str_lower(raw);
    if raw == "" { return map{ ok: false, reason: "empty URL", scheme: "", host: "" }; }
    if _has_control_or_space(raw) or str_contains(lower, "%0d") or str_contains(lower, "%0a") {
        return map{ ok: false, reason: "blocked unsafe URL characters", scheme: "", host: "" };
    }
    if not (str_starts_with(lower, "http://") or str_starts_with(lower, "https://")) {
        return map{ ok: false, reason: "blocked scheme: only http:// and https:// are allowed", scheme: "", host: "" };
    }
    let u = _split_url(raw);
    let scheme = str_lower(u.scheme);
    if _has_userinfo(u.host) {
        return map{ ok: false, reason: "blocked URL credentials/userinfo", scheme: scheme, host: "" };
    }
    let host = _host_no_port(u.host);
    let port = _port_of_host(u.host);
    if host == "" { return map{ ok: false, reason: "missing host", scheme: scheme, host: host }; }
    if (scheme != "http" and scheme != "https") {
        return map{ ok: false, reason: "blocked scheme: " + scheme, scheme: scheme, host: host };
    }
    if _is_dangerous_port(port) {
        return map{ ok: false, reason: "blocked non-web service port: " + str(port), scheme: scheme, host: host, port: port };
    }
    if (not allow_private) and _is_private_host(host) {
        return map{ ok: false, reason: "blocked private/local host: " + host, scheme: scheme, host: host };
    }
    let threat = threat_policy(raw, allow_ads, allow_trackers);
    if not threat.ok {
        return map{ ok: false, reason: threat.reason, scheme: scheme, host: host, threats: threat.threats };
    }
    return map{ ok: true, reason: "allowed", scheme: scheme, host: host, threats: threat.threats };
}

fn url_policy_mode(url, mode) {
    let p = security_profile(mode);
    let pol = url_policy(url, try p.allow_private catch false, try p.allow_ads catch false, try p.allow_trackers catch false);
    pol.mode = p.mode;
    pol.profile = p;
    return pol;
}

// resolve(base, href) — absolutize an href against the page URL (RFC-3986 essentials:
// absolute, protocol-relative //, root-relative /path, and dotless relative paths).
fn resolve(base, href) {
    if href == "" { return base; }
    if str_starts_with(href, "http://") or str_starts_with(href, "https://") { return href; }
    if str_starts_with(href, "mailto:") or str_starts_with(href, "javascript:")
        or str_starts_with(href, "data:") or str_starts_with(href, "#") or str_starts_with(href, "tel:") { return href; }
    let b = _split_url(base);
    if str_starts_with(href, "//") { return b.scheme + ":" + href; }
    if str_starts_with(href, "/") { return b.scheme + "://" + b.host + href; }
    let dir = b.path;
    let li = _last_slash(dir);
    if li >= 0 { dir = str_slice(dir, 0, li + 1); } else { dir = "/"; }
    return b.scheme + "://" + b.host + dir + href;
}

// _page(url, body) — parse a fetched body into a structured page record (links
// absolutized + forms extracted). Shared by fetch_page (GET), submit (POST), and tests.
fn _page(url, body) {
    let raw = links(body);
    let abs = [];
    let i = 0;
    while i < len(raw) {
        let r = resolve(url, _decode_entities(raw[i]));    // &amp; in hrefs → &
        if str_starts_with(r, "http") { push(abs, r); }    // only navigable web links
        i = i + 1;
    }
    return map{
        url: url, ok: true, status: 200,
        title: title(body), text: strip_tags(body),
        links: abs, forms: forms(url, body), images: images(url, body), html: body
    };
}

// fetch_page_from_html(base_url, html) — test/dev hook used by native IDE parser tests.
fn fetch_page_from_html(base_url, html) {
    return _page(base_url, html);
}

// fetch_page(url, via_tor) — GET + parse into a page record. via_tor routes through Tor
// (opt-in; defaults to false = direct connection).
fn fetch_page(url, via_tor = false, allow_private = false, allow_ads = false, allow_trackers = false) {
    let pol = url_policy(url, allow_private, allow_ads, allow_trackers);
    if not pol.ok {
        return map{ url: url, ok: false, status: 0, error: "blocked by browser policy: " + pol.reason, tor: via_tor, policy: pol };
    }
    let body = nil;
    if via_tor { body = fetch_tor(url); } else { body = fetch(url); }
    if body == nil {
        let why = "could not fetch (network/DNS/blocked)";
        if via_tor { why = "Tor route needs a tcp_connect builtin + SOCKS5/TLS (docs/Protocols.md)"; }
        return map{ url: url, ok: false, status: 0, error: why, tor: via_tor };
    }
    let page = _page(url, body);
    page.tor = via_tor;
    page.policy = pol;
    return page;
}

fn fetch_page_mode(url, mode) {
    let prof = security_profile(mode);
    let page = fetch_page(url, try prof.tor catch false, try prof.allow_private catch false, try prof.allow_ads catch false, try prof.allow_trackers catch false);
    page.security_mode = prof.mode;
    page.security_profile = prof;
    return page;
}

// ── HTML attribute + form parsing ─────────────────────────────────────────────────────
fn _attr(tag, name) {
    let d = _attr_q(tag, name + "=\"", "\"");
    if d != nil { return d; }
    return _attr_q(tag, name + "='", "'");
}
fn _attr_q(tag, marker, quote) {
    let idx = str_index_of(tag, marker);
    if idx < 0 { return nil; }
    let rest = str_slice(tag, idx + len(marker), len(tag));
    let q = str_index_of(rest, quote);
    if q < 0 { return nil; }
    return _decode_entities(str_slice(rest, 0, q));
}

fn _has_attr(tag, name) {
    let t = " " + str_lower(str(tag)) + " ";
    let n = str_lower(str(name));
    return str_contains(t, " " + n + " ") or str_contains(t, " " + n + "=");
}

fn _option_records(body) {
    let out = [];
    let parts = str_split(body, "<option");
    let i = 1;
    while i < len(parts) {
        let gt = str_index_of(parts[i], ">");
        if gt >= 0 {
            let tag = str_slice(parts[i], 0, gt);
            let end = str_index_of(parts[i], "</option>");
            let text = "";
            if end >= 0 { text = strip_tags(str_slice(parts[i], gt + 1, end)); }
            let val = _attr(tag, "value");
            if val == nil { val = text; }
            push(out, map{ value: val, label: text, selected: _has_attr(tag, "selected") });
        }
        i = i + 1;
    }
    return out;
}

fn _select_default(opts) {
    let i = 0;
    while i < len(opts) {
        if try opts[i].selected catch false { return str(try opts[i].value catch ""); }
        i = i + 1;
    }
    if len(opts) > 0 { return str(try opts[0].value catch ""); }
    return "";
}

// _form_fields(body) — the named <input>/<textarea> controls inside a form.
fn _form_fields(body) {
    let out = [];
    let parts = str_split(body, "<input");
    let i = 1;
    while i < len(parts) {
        let gt = str_index_of(parts[i], ">");
        if gt >= 0 {
            let tag = str_slice(parts[i], 0, gt);
            let name = _attr(tag, "name");
            if name != nil {
                let typ = _attr(tag, "type"); if typ == nil { typ = "text"; }
                typ = str_lower(typ);
                let val = _attr(tag, "value"); if val == nil { val = ""; }
                if (typ == "checkbox" or typ == "radio") {
                    if val == "" { val = "on"; }
                    let checked = _has_attr(tag, "checked");
                    push(out, map{ name: name, type: typ, value: if checked { val } else { "" }, checked_value: val, checked: checked });
                } else {
                    push(out, map{ name: name, type: typ, value: val });
                }
            }
        }
        i = i + 1;
    }
    let tparts = str_split(body, "<textarea");
    i = 1;
    while i < len(tparts) {
        let gt = str_index_of(tparts[i], ">");
        if gt >= 0 {
            let tag = str_slice(tparts[i], 0, gt);
            let name = _attr(tag, "name");
            if name != nil { push(out, map{ name: name, type: "textarea", value: "" }); }
        }
        i = i + 1;
    }
    let sparts = str_split(body, "<select");
    i = 1;
    while i < len(sparts) {
        let gt = str_index_of(sparts[i], ">");
        if gt >= 0 {
            let tag = str_slice(sparts[i], 0, gt);
            let name = _attr(tag, "name");
            if name != nil {
                let end = str_index_of(sparts[i], "</select>");
                let sbody = "";
                if end >= 0 { sbody = str_slice(sparts[i], gt + 1, end); }
                let opts = _option_records(sbody);
                push(out, map{ name: name, type: "select", value: _select_default(opts), options: opts });
            }
        }
        i = i + 1;
    }
    return out;
}

// forms(page_url, html) — every <form> on the page: absolute action, method, fields.
fn forms(page_url, html) {
    let parts = str_split(html, "<form");
    let out = [];
    let i = 1;
    while i < len(parts) {
        let seg = parts[i];
        let gt = str_index_of(seg, ">");
        if gt >= 0 {
            let tag = str_slice(seg, 0, gt);
            let endf = str_index_of(seg, "</form>");
            let fbody = "";
            if endf >= 0 { fbody = str_slice(seg, gt + 1, endf); }
            let action = _attr(tag, "action"); if action == nil { action = ""; }
            let method = _attr(tag, "method"); if method == nil { method = "get"; }
            let act_url = page_url;
            if action != "" { act_url = resolve(page_url, action); }
            push(out, map{ action: act_url, method: str_lower(method), fields: _form_fields(fbody) });
        }
        i = i + 1;
    }
    return out;
}

fn form_values(form) {
    let vals = map{};
    let fields = try form.fields catch [];
    let i = 0;
    while i < len(fields) {
        let fld = fields[i];
        let name = str(try fld.name catch "");
        if name != "" {
            vals[name] = str(try fld.value catch "");
        }
        i = i + 1;
    }
    return vals;
}

fn form_update_value(values, name, value) {
    let out = map{};
    let ks = map_keys(values);
    let i = 0;
    while i < len(ks) {
        out[ks[i]] = values[ks[i]];
        i = i + 1;
    }
    out[str(name)] = str(value);
    return out;
}

fn _form_field(form, name) {
    let fields = try form.fields catch [];
    let i = 0;
    while i < len(fields) {
        if str(try fields[i].name catch "") == str(name) { return fields[i]; }
        i = i + 1;
    }
    return nil;
}

fn form_payload_values(form, values) {
    let out = map{};
    let fields = try form.fields catch [];
    let i = 0;
    while i < len(fields) {
        let fld = fields[i];
        let name = str(try fld.name catch "");
        if name != "" {
            let typ = str_lower(str(try fld.type catch "text"));
            let value = str(try values[name] catch try fld.value catch "");
            if (typ == "checkbox" or typ == "radio") {
                if value != "" { out[name] = value; }
            } else {
                out[name] = value;
            }
        }
        i = i + 1;
    }
    return out;
}

fn form_cycle_value(form, values, name, dir = 1) {
    let fld = _form_field(form, name);
    if fld == nil { return values; }
    let typ = str_lower(str(try fld.type catch "text"));
    let cur = str(try values[name] catch try fld.value catch "");
    if typ == "checkbox" or typ == "radio" {
        let on = str(try fld.checked_value catch "on");
        if cur == "" { return form_update_value(values, name, on); }
        return form_update_value(values, name, "");
    }
    if typ == "select" {
        let opts = try fld.options catch [];
        if len(opts) == 0 { return values; }
        let idx = 0;
        let i = 0;
        while i < len(opts) {
            if str(try opts[i].value catch "") == cur { idx = i; }
            i = i + 1;
        }
        idx = idx + dir;
        while idx < 0 { idx = idx + len(opts); }
        while idx >= len(opts) { idx = idx - len(opts); }
        return form_update_value(values, name, str(try opts[idx].value catch ""));
    }
    return values;
}

fn form_field_display(field, values, selected = false) {
    let fld = try field catch map{};
    let name = str(try fld.name catch "?");
    let typ = str_lower(str(try fld.type catch "text"));
    let value = str(try values[name] catch try fld.value catch "");
    let prefix = "   ";
    if selected { prefix = " * "; }
    if typ == "checkbox" {
        let mark = "[ ]";
        if value != "" { mark = "[x]"; }
        return prefix + mark + " " + name + "  checkbox  Space toggles  value=" + str(try fld.checked_value catch "on");
    }
    if typ == "radio" {
        let mark = "( )";
        if value != "" { mark = "(*)"; }
        return prefix + mark + " " + name + "  radio  Space selects  value=" + str(try fld.checked_value catch "on");
    }
    if typ == "select" {
        let opts = try fld.options catch [];
        return prefix + "<" + value + "> " + name + "  select  Space/Left/Right cycles " + str(len(opts)) + " option(s)";
    }
    if typ == "textarea" {
        return prefix + name + "  textarea  |" + value + "|  type edits, Backspace deletes";
    }
    return prefix + name + "  " + typ + "  |" + value + "|  type edits, Backspace deletes";
}

fn form_field_editor_state(form, values, selected) {
    let fields = try form.fields catch [];
    let idx = try parse_number(str(selected)) catch 0;
    if idx == nil { idx = 0; }
    idx = num_floor(idx);
    if idx < 0 { idx = 0; }
    if len(fields) == 0 {
        return map{ ok: false, index: 0, count: 0, line: "no fields", name: "", type: "", value: "", hint: "no editable fields" };
    }
    if idx >= len(fields) { idx = len(fields) - 1; }
    let fld = fields[idx];
    let name = str(try fld.name catch "");
    let typ = str_lower(str(try fld.type catch "text"));
    let value = str(try values[name] catch try fld.value catch "");
    let hint = "type edits, Backspace deletes";
    if typ == "checkbox" { hint = "Space toggles"; }
    else if typ == "radio" { hint = "Space selects"; }
    else if typ == "select" { hint = "Space/Left/Right cycles options"; }
    return map{
        ok: true,
        index: idx,
        count: len(fields),
        name: name,
        type: typ,
        value: value,
        hint: hint,
        line: form_field_display(fld, values, true)
    };
}

fn form_preview_url(form, values) {
    let action = str(try form.action catch "");
    let method = str_lower(str(try form.method catch "get"));
    let body = urlencode(form_payload_values(form, values));
    if method == "post" { return action + "  [POST " + body + "]"; }
    if body == "" { return action; }
    if str_contains(action, "?") { return action + "&" + body; }
    return action + "?" + body;
}

fn form_submit_mode(form, values, mode) {
    let prof = security_profile(mode);
    if not (try prof.forms catch false) {
        return map{
            ok: false,
            status: 0,
            url: str(try form.action catch ""),
            error: "form submit blocked by " + str(try prof.label catch mode) + " browser profile",
            security_profile: prof,
        };
    }
    let page = submit(
        str(try form.action catch ""),
        str(try form.method catch "get"),
        form_payload_values(form, values),
        try prof.tor catch false,
        try prof.allow_private catch false,
        try prof.allow_ads catch false,
        try prof.allow_trackers catch false
    );
    page.security_profile = prof;
    return page;
}

// ── form encoding (application/x-www-form-urlencoded) ─────────────────────────────────
let _UHEX = "0123456789ABCDEF";
fn _is_unreserved(c) {
    if c >= 65 and c <= 90 { return true; }
    if c >= 97 and c <= 122 { return true; }
    if c >= 48 and c <= 57 { return true; }
    return c == 45 or c == 95 or c == 46 or c == 126;        // - _ . ~
}
fn _pe_byte(v) {
    let hi = (v - num_mod(v, 16)) / 16;
    return "%" + strfromcharcode(strcharcodeat(_UHEX, hi)) + strfromcharcode(strcharcodeat(_UHEX, num_mod(v, 16)));
}
// UTF-8 encode a code point to a byte array (so non-ASCII form values encode correctly).
fn _utf8(cp) {
    let b = [];
    if cp < 128 { push(b, cp); }
    else if cp < 2048 {
        push(b, bit_or(192, (cp - num_mod(cp, 64)) / 64));
        push(b, bit_or(128, num_mod(cp, 64)));
    } else if cp < 65536 {
        push(b, bit_or(224, (cp - num_mod(cp, 4096)) / 4096));
        push(b, bit_or(128, num_mod((cp - num_mod(cp, 64)) / 64, 64)));
        push(b, bit_or(128, num_mod(cp, 64)));
    } else {
        push(b, bit_or(240, (cp - num_mod(cp, 262144)) / 262144));
        push(b, bit_or(128, num_mod((cp - num_mod(cp, 4096)) / 4096, 64)));
        push(b, bit_or(128, num_mod((cp - num_mod(cp, 64)) / 64, 64)));
        push(b, bit_or(128, num_mod(cp, 64)));
    }
    return b;
}
fn percent_encode(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if _is_unreserved(c) { out = out + strfromcharcode(c); }
        else if c == 32 { out = out + "+"; }                 // form space -> +
        else {
            let bytes = _utf8(c);
            let j = 0;
            while j < len(bytes) { out = out + _pe_byte(bytes[j]); j = j + 1; }
        }
        i = i + 1;
    }
    return out;
}
fn urlencode(fields) {
    let ks = map_keys(fields);
    let out = "";
    let i = 0;
    while i < len(ks) {
        if i > 0 { out = out + "&"; }
        out = out + percent_encode(ks[i]) + "=" + percent_encode(str(fields[ks[i]]));
        i = i + 1;
    }
    return out;
}

fn search_engine_records() {
    return [
        map{ id: "duckduckgo", label: "DuckDuckGo", url: "https://duckduckgo.com/?q=", privacy: "private-default" },
        map{ id: "brave", label: "Brave", url: "https://search.brave.com/search?q=", privacy: "private-default" },
        map{ id: "startpage", label: "Startpage", url: "https://www.startpage.com/sp/search?query=", privacy: "private-default" },
        map{ id: "google", label: "Google", url: "https://www.google.com/search?q=", privacy: "mainstream" },
        map{ id: "bing", label: "Bing", url: "https://www.bing.com/search?q=", privacy: "mainstream" }
    ];
}

fn search_engine_profile(engine) {
    let e = str_lower(str_trim(str(engine)));
    let records = search_engine_records();
    let i = 0;
    while i < len(records) {
        if str(try records[i].id catch "") == e { return records[i]; }
        i = i + 1;
    }
    return records[0];
}

fn next_search_engine(engine) {
    let cur = search_engine_profile(engine).id;
    let records = search_engine_records();
    let i = 0;
    while i < len(records) {
        if records[i].id == cur {
            let n = i + 1;
            if n >= len(records) { n = 0; }
            return records[n].id;
        }
        i = i + 1;
    }
    return records[0].id;
}

fn search_engine_url(query, engine = "duckduckgo") {
    let q = str_trim(str(query));
    let prof = search_engine_profile(engine);
    return str(try prof.url catch "https://duckduckgo.com/?q=") + percent_encode(q);
}

fn _looks_like_url_or_host(input) {
    let raw = str_trim(str(input));
    let lower = str_lower(raw);
    if str_starts_with(lower, "http://") or str_starts_with(lower, "https://") { return true; }
    if str_contains(raw, " ") or str_contains(raw, "\t") or str_contains(raw, "\n") or str_contains(raw, "\r") { return false; }
    if str_contains(raw, "://") { return true; }
    if str_contains(raw, ".") { return true; }
    let colon = str_index_of(raw, ":");
    if colon > 0 and colon < len(raw) - 1 {
        let port = str_slice(raw, colon + 1, len(raw));
        let all_digits = true;
        let i = 0;
        while i < len(port) {
            let c = strcharcodeat(port, i);
            if c < 48 or c > 57 { all_digits = false; }
            i = i + 1;
        }
        if all_digits { return true; }
    }
    return false;
}

fn browser_input_url(input, engine = "duckduckgo") {
    let raw = str_trim(str(input));
    let prof = search_engine_profile(engine);
    if raw == "" {
        return map{ ok: false, kind: "empty", input: raw, url: "", search_engine: prof.id, label: prof.label, query: "", reason: "empty input" };
    }
    if _looks_like_url_or_host(raw) {
        let url = raw;
        if str_contains(str_lower(url), "://") and not (str_starts_with(str_lower(url), "http://") or str_starts_with(str_lower(url), "https://")) {
            return map{ ok: true, kind: "url", input: raw, url: url, search_engine: prof.id, label: prof.label, query: "" };
        }
        if not (str_starts_with(str_lower(url), "http://") or str_starts_with(str_lower(url), "https://")) {
            url = "https://" + url;
        }
        return map{ ok: true, kind: "url", input: raw, url: url, search_engine: prof.id, label: prof.label, query: "" };
    }
    return map{
        ok: true,
        kind: "search",
        input: raw,
        query: raw,
        url: search_engine_url(raw, prof.id),
        search_engine: prof.id,
        label: prof.label
    };
}

// submit(action_url, method, fields) — submit a form. GET appends the encoded fields as
// a query string; POST sends them as an x-www-form-urlencoded body.
fn submit(action_url, method, fields, via_tor = false, allow_private = false, allow_ads = false, allow_trackers = false) {
    let pol = url_policy(action_url, allow_private, allow_ads, allow_trackers);
    if not pol.ok {
        return map{ url: action_url, ok: false, status: 0, error: "blocked by browser policy: " + pol.reason, tor: via_tor, policy: pol };
    }
    let body = urlencode(fields);
    if str_lower(method) == "post" {
        if via_tor { return map{ url: action_url, ok: false, status: 0, error: "Tor POST needs a tcp_connect builtin (docs/Protocols.md)", tor: true }; }
        let resp = try http_post(action_url, body, "application/x-www-form-urlencoded") catch nil;
        if resp == nil { return map{ url: action_url, ok: false, status: 0, error: "POST failed" }; }
        let page = _page(action_url, resp);
        page.tor = false;
        page.policy = pol;
        return page;
    }
    let geturl = action_url;
    if body != "" { geturl = action_url + "?" + body; }
    return fetch_page(geturl, via_tor, allow_private, allow_ads, allow_trackers);
}

export fetch, title, strip_tags, links, resolve, images, page_blocks, page_layout, page_layout_hit, page_layout_lines, source_lines, inspector_lines, page_reading_stats, page_stats_lines, page_find_lines, bookmark_record, bookmark_push, bookmark_remove, bookmark_lines, download_plan, classify_url_threat, threat_policy, security_profile, next_security_mode, security_summary, native_interaction_summary, search_engine_records, search_engine_profile, next_search_engine, search_engine_url, browser_input_url, url_policy, url_policy_mode, fetch_page, fetch_page_mode, fetch_page_from_html;
// word_count(html) — number of words in the visible text (script/style stripped).
fn word_count(html) {
    let txt = strip_tags(html);
    if txt == "" { return 0; }
    let parts = str_split(txt, " ");
    let n = 0;
    let i = 0;
    while i < len(parts) { if str_trim(parts[i]) != "" { n = n + 1; } i = i + 1; }
    return n;
}

// meta_description(html) — the <meta name="description" content="..."> value, or "".
fn meta_description(html) {
    let lo = str_lower(html);
    let idx = str_index_of(lo, "name=\"description\"");
    if idx < 0 { idx = str_index_of(lo, "name='description'"); }
    if idx < 0 { return ""; }
    let tail = str_slice(lo, idx, len(lo));
    let c = str_index_of(tail, "content=");
    if c < 0 { return ""; }
    let vstart = idx + c + 8;
    let qc = str_slice(html, vstart, vstart + 1);
    let rest = str_slice(html, vstart + 1, len(html));
    let e = str_index_of(rest, qc);
    if e < 0 { return ""; }
    return str_trim(str_slice(rest, 0, e));
}

// headings(html) — extract [{ level, text }] for plain <h1>..</h1> .. <h6> tags.
fn headings(html) {
    let lo = str_lower(html);
    let out = [];
    let lvl = 1;
    while lvl <= 6 {
        let open = "<h" + str(lvl) + ">";
        let close = "</h" + str(lvl) + ">";
        let from = 0;
        let go = true;
        while go {
            let a = str_index_of(str_slice(lo, from, len(lo)), open);
            if a < 0 { go = false; }
            else {
                let abs_a = from + a;
                let b = str_index_of(str_slice(lo, abs_a, len(lo)), close);
                if b < 0 { go = false; }
                else {
                    let abs_b = abs_a + b;
                    array_push(out, map{ level: lvl, text: str_trim(str_slice(html, abs_a + len(open), abs_b)) });
                    from = abs_b + len(close);
                }
            }
        }
        lvl = lvl + 1;
    }
    return out;
}

// ── wave 2: more HTML metadata extractors (pure) ─────────────────────────────────

// Read an attribute value beginning at vstart (the char after `attr=`): the next
// char is the opening quote; return the text up to the matching closing quote.
fn _quoted_value(html, vstart) {
    let qc = str_slice(html, vstart, vstart + 1);
    let rest = str_slice(html, vstart + 1, len(html));
    let e = str_index_of(rest, qc);
    if e < 0 { return ""; }
    return str_trim(str_slice(rest, 0, e));
}

// lang(html) — value of the <html lang="..."> attribute, or "".
fn lang(html) {
    let lo = str_lower(html);
    let idx = str_index_of(lo, "<html");
    if idx < 0 { return ""; }
    let tail_lo = str_slice(lo, idx, len(lo));
    let gt = str_index_of(tail_lo, ">");
    if gt < 0 { return ""; }
    let l = str_index_of(tail_lo, "lang=");
    if l < 0 or l > gt { return ""; }
    return _quoted_value(html, idx + l + 5);
}

// canonical(html) — href of <link rel="canonical">, attribute order independent.
fn canonical(html) {
    let lo = str_lower(html);
    let idx = str_index_of(lo, "rel=\"canonical\"");
    if idx < 0 { idx = str_index_of(lo, "rel='canonical'"); }
    if idx < 0 { return ""; }
    // back up to the start of the enclosing tag, then scan the whole tag for href=
    let tstart = idx;
    while tstart > 0 and str_slice(html, tstart, tstart + 1) != "<" { tstart = tstart - 1; }
    let tail_lo = str_slice(lo, tstart, len(lo));
    let gt = str_index_of(tail_lo, ">");
    if gt < 0 { return ""; }
    let tag_lo = str_slice(tail_lo, 0, gt);
    let h = str_index_of(tag_lo, "href=");
    if h < 0 { return ""; }
    return _quoted_value(html, tstart + h + 5);
}

// meta_property(html, prop) — the content of <meta property="prop" content="...">
// (OpenGraph/Twitter cards), or "".
fn meta_property(html, prop) {
    let lo = str_lower(html);
    let pl = str_lower(prop);
    let idx = str_index_of(lo, "property=\"" + pl + "\"");
    if idx < 0 { idx = str_index_of(lo, "property='" + pl + "'"); }
    if idx < 0 { return ""; }
    let tail = str_slice(lo, idx, len(lo));
    let c = str_index_of(tail, "content=");
    if c < 0 { return ""; }
    return _quoted_value(html, idx + c + 8);
}

// text_excerpt(html, n) — visible text, whitespace-collapsed, truncated to n chars.
fn text_excerpt(html, n) {
    let txt = str_trim(regex_replace_all(strip_tags(html), "[ \t\n\r]+", " "));
    if len(txt) <= n { return txt; }
    return str_slice(txt, 0, n);
}

export lang, canonical, meta_property, text_excerpt;
export word_count, meta_description, headings;
export forms, form_values, form_update_value, form_payload_values, form_cycle_value,
       form_field_display, form_field_editor_state,
       form_preview_url, form_submit_mode, percent_encode, urlencode, submit;
