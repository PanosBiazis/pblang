// stdlib/dist.sapp — cross-OS executable builder for pblang.
//
// Goal: let a programmer turn any pblang script/project into a native
// executable for EVERY desktop OS, without rebuilding the Rust toolchain.
//
// How: pblang already transpiles to a single self-contained C99 file
// (`pblang transpile`). C is the universal floor — every OS has a C compiler,
// and cross-compilers (zig cc, mingw, osxcross) target other OSes from one
// host. So the whole pipeline is:
//
//     pblang source  --(pblang transpile)-->  one .c file  --(C compiler)-->  native exe
//
// This module is the orchestration layer, written in pblang itself. Adding a
// new target or tweaking flags is a pblang change, not a Rust change — which is
// the point of a self-hosted language.
//
// Usage:
//   let dist = import("stdlib/dist.sapp");
//   dist.available_targets();              // what this host can build right now
//   dist.build(src, "windows-x64", out);   // one target
//   dist.build_all(src, "dist");           // every available target -> dist/
//   print dist.report_to_string(rep);

let CTRANSPILER = import("stdlib:compiler/ctranspile.sapp");
let PROCESS = import("stdlib:process.sapp");
let DIRFS = import("stdlib:linux_dirfs.sapp");
let PIDFD = import("stdlib:linux_pidfd.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let SELFHOST_BUNDLE = import("stdlib:selfhost_bundle.sapp");
let SELFHOST_PBCK = import("stdlib:selfhost_pbck.sapp");
let SELFHOST_TO_PBCK = import("stdlib:selfhost_to_pbck.sapp");
let SOURCE_INLINER = import("stdlib:source_inliner.sapp");
let RELEASE_CHANNEL = import("stdlib:release_channel.sapp");

// ─────────────────────────────────────────────────────────────────────────────
// Toolchain detection
// ─────────────────────────────────────────────────────────────────────────────

// Non-executing compatibility discovery. Build publication never trusts this
// PATH result; it selects only allowlisted absolute system executables.
fn have(cmd) {
    let w = try os_which(cmd) catch nil;
    if w != nil and w != "" { return true; }
    return false;
}

// ─────────────────────────────────────────────────────────────────────────────
// Target catalog
//
// Each target lists, in priority order, the "recipes" that can produce it. A
// recipe is { bin, pre } where `bin` is the compiler executable and `pre` are
// the args that come before the shared `<c> -O2 -o <out> [-lm]` tail. The first
// recipe whose `bin` exists on this host is used.
//
// `zig cc -target <triple>` is the universal cross-compiler: one install builds
// for all OSes/arches, so it's listed first for every target when present.
// ─────────────────────────────────────────────────────────────────────────────

fn _recipe(bin, pre) { return map{ bin: bin, pre: pre }; }

fn all_targets() {
    return [
        map{ name: "linux-x64", os: "linux", arch: "x86_64", ext: "", needs_lm: true,
             recipes: [ _recipe("zig", ["cc", "-target", "x86_64-linux-musl"]),
                        _recipe("cc", []), _recipe("gcc", []), _recipe("clang", []) ] },
        map{ name: "linux-arm64", os: "linux", arch: "aarch64", ext: "", needs_lm: true,
             recipes: [ _recipe("zig", ["cc", "-target", "aarch64-linux-musl"]),
                        _recipe("aarch64-linux-gnu-gcc", []) ] },
        map{ name: "windows-x64", os: "windows", arch: "x86_64", ext: ".exe", needs_lm: false,
             recipes: [ _recipe("zig", ["cc", "-target", "x86_64-windows-gnu"]),
                        _recipe("x86_64-w64-mingw32-gcc", []) ] },
        map{ name: "windows-x86", os: "windows", arch: "i686", ext: ".exe", needs_lm: false,
             recipes: [ _recipe("zig", ["cc", "-target", "x86-windows-gnu"]),
                        _recipe("i686-w64-mingw32-gcc", []) ] },
        map{ name: "macos-x64", os: "macos", arch: "x86_64", ext: "", needs_lm: true,
             recipes: [ _recipe("zig", ["cc", "-target", "x86_64-macos"]),
                        _recipe("o64-clang", []) ] },
        map{ name: "macos-arm64", os: "macos", arch: "aarch64", ext: "", needs_lm: true,
             recipes: [ _recipe("zig", ["cc", "-target", "aarch64-macos"]),
                        _recipe("oa64-clang", []) ] },
    ];
}

fn target_by_name(name) {
    for t in all_targets() {
        if t.name == name { return t; }
    }
    return nil;
}

// The first usable recipe for a target (or nil if no toolchain is installed).
fn _pick_recipe(target) {
    for r in target.recipes {
        if have(r.bin) { return r; }
    }
    return nil;
}

fn _fixed_compiler_path(name) {
    let roots = ["/usr/bin/", "/bin/", "/usr/local/bin/"];
    let i = 0;
    while i < len(roots) {
        let candidate = roots[i] + name;
        if try fs_exists(candidate) catch false { return candidate; }
        i = i + 1;
    }
    return "";
}

// Security-sensitive publication must not probe PATH before selecting a
// compiler. Return the recipe and its allowlisted absolute executable as one
// decision so callers cannot accidentally execute a PATH-controlled helper.
fn _pick_fixed_recipe(target) {
    for recipe in target.recipes {
        let program = _fixed_compiler_path(recipe.bin);
        if program != "" { return map{ recipe: recipe, program: program }; }
    }
    return nil;
}

// Every target this host can build right now, each annotated with the compiler
// that will be used. Targets with no installed toolchain are omitted.
fn available_targets() {
    let out = [];
    for t in all_targets() {
        let fixed = _pick_fixed_recipe(t);
        if fixed != nil {
            array_push(out, map{ name: t.name, os: t.os, arch: t.arch,
                                 ext: t.ext, compiler: fixed.program });
        }
    }
    return out;
}

// Human-readable note on which targets are NOT yet buildable and how to enable
// them (install zig for universal cross-compilation; mingw for Windows;
// osxcross for macOS).
fn missing_targets_help() {
    let lines = [];
    for t in all_targets() {
        if _pick_fixed_recipe(t) == nil {
            let bins = [];
            for r in t.recipes { array_push(bins, r.bin); }
            array_push(lines, "  " + t.name + " — install one of: " + str_join(bins, ", "));
        }
    }
    if len(lines) == 0 { return "All catalog targets are buildable on this host."; }
    return "Unavailable targets (install a toolchain to enable):\n" + str_join(lines, "\n")
        + "\nTip: `zig` alone (https://ziglang.org) cross-compiles ALL targets.";
}

// ─────────────────────────────────────────────────────────────────────────────
// Build pipeline
// ─────────────────────────────────────────────────────────────────────────────

// Resolve the runtime driving this build without consulting ambient PATH.
// PBLANG_BIN is accepted only as an explicit absolute operator override. Linux
// normally reuses the current process image through /proc/<pid>/exe. Do not
// return /proc/self/exe: when that path is passed to a child tool such as strip,
// "self" becomes the child and the wrong executable is copied. Unsupported
// hosts fail closed until they have an equivalent verified process-image path.
fn runtime_binary() {
    let configured = try env_get("PBLANG_BIN") catch nil;
    if type(configured) == "string" and str_starts_with(configured, "/") and len(configured) <= 4096
        and not str_contains(configured, "\n") and not str_contains(configured, "\r")
        and (try fs_exists(configured) catch false) {
        return map{ path: configured, source: "PBLANG_BIN" };
    }
    if platform() == "linux" {
        let identity = try PIDFD.current_pid() catch nil;
        if identity != nil and (try identity.ok catch false) {
            let process_image = "/proc/" + str(identity.pid) + "/exe";
            if fs_exists(process_image) {
                return map{ path: process_image, source: "current-process-image" };
            }
        }
    }
    return map{ path: "", source: "unresolved-fail-closed" };
}

fn _pblang_bin() { return runtime_binary().path; }

// ─────────────────────────────────────────────────────────────────────────────
// Build options — the knobs that make pblang's exe output best-in-class:
//   opt    : "speed" (-O2, default) | "max" (-O3) | "size" (-Os) | "debug" (-O0 -g)
//   strip  : drop symbol tables for a smaller binary (default true, off in debug)
//   static : fully static, copy-anywhere binary (no shared-lib deps)
//   lto    : link-time optimization (-flto) — smaller + faster
//   compress : run UPX if installed for the smallest possible on-disk size
// ─────────────────────────────────────────────────────────────────────────────
fn default_opts() {
    return map{ opt: "speed", strip: true, static: false, lto: false, compress: false };
}

// release(): the recommended "ship it" profile — small, stripped, fully static
// where the toolchain supports it. Produces the most portable single file.
fn release_opts() {
    return map{ opt: "size", strip: true, static: true, lto: true, compress: false };
}

fn _opt(opts, key, dflt) {
    if opts == nil { return dflt; }
    let v = try opts[key] catch nil;
    if v == nil { return dflt; }
    return v;
}

// Translate opts into the optimization/link flags appended after the source.
fn _opt_flags(target, opts) {
    let flags = [];
    let level = _opt(opts, "opt", "speed");
    if level == "max" { array_push(flags, "-O3"); }
    elif level == "size" { array_push(flags, "-Os"); }
    elif level == "debug" { array_push(flags, "-O0"); array_push(flags, "-g"); }
    else { array_push(flags, "-O2"); }

    if _opt(opts, "lto", false) and level != "debug" { array_push(flags, "-flto"); }
    // Strip symbols via the linker (-s); never strip a debug build.
    if _opt(opts, "strip", true) and level != "debug" { array_push(flags, "-s"); }
    if _opt(opts, "static", false) { array_push(flags, "-static"); }
    return flags;
}

// On-disk size in bytes (nil if unreadable). Uses fs_read_bytes since there is
// no fs_size builtin; binaries here are small enough that this is fine.
fn _file_size(path) {
    let b = try fs_read_bytes(path) catch nil;
    if b == nil { return nil; }
    return len(b);
}

fn c99_source_admission(source) {
    if type(source) != "string" {
        return map{ ok: false, bytes: 0, limit: 10485760,
            error: "linked source must be text" };
    }
    if len(source) > 10485760 {
        return map{ ok: false, bytes: nil, limit: 10485760,
            error: "linked source exceeds the 10 MiB immutable-input limit" };
    }
    let bytes = len(str_to_bytes(source));
    return map{ ok: bytes <= 10485760, bytes: bytes, limit: 10485760,
        error: if bytes <= 10485760 { "" } else {
            "linked source exceeds the 10 MiB immutable-input limit" } };
}

// pblang source -> portable C. Returns map{ ok, c_path, stderr }.
fn transpile(src, c_path) {
    let r = try proc_spawn_wait(_pblang_bin(), ["transpile", src, "-o", c_path]) catch nil;
    if r == nil {
        return map{ ok: false, c_path: c_path, stderr: "could not run pblang transpile" };
    }
    let code = try r.exit_code catch 1;
    let ok = code == 0 and fs_exists(c_path);
    return map{ ok: ok, c_path: c_path, stderr: try r.stderr catch "" };
}

// Compile an already-transpiled .c for one target with the given opts. Returns
// map{ ok, output, target, compiler, stderr, size, compressed }.
fn compile_c(c_path, target_name, out_path, opts = nil) {
    let t = target_by_name(target_name);
    if t == nil {
        return map{ ok: false, output: out_path, target: target_name,
                    compiler: nil, stderr: "unknown target: " + target_name };
    }
    let fixed = _pick_fixed_recipe(t);
    if fixed == nil {
        return map{ ok: false, output: out_path, target: target_name, compiler: nil,
                    stderr: "no C toolchain for " + target_name + ". " + missing_targets_help() };
    }
    let recipe = fixed.recipe;
    let program = fixed.program;
    let naming = RELEASE_CHANNEL.artifact_base(out_path, opts);
    if not naming.ok {
        return map{ ok:false, output:out_path, target:target_name, compiler:program,
            stderr:"invalid release identity: " + naming.error };
    }
    let out = naming.path + t.ext;
    let args = [];
    for a in recipe.pre { array_push(args, a); }
    array_push(args, c_path);
    for f in _opt_flags(t, opts) { array_push(args, f); }
    array_push(args, "-o");
    array_push(args, out);
    if t.needs_lm { array_push(args, "-lm"); }

    let r = try proc_spawn_wait(program, args) catch nil;
    if r == nil {
        return map{ ok: false, output: out, target: target_name, compiler: program,
                    stderr: "could not run fixed compiler" };
    }
    let code = try r.exit_code catch 1;
    let ok = code == 0 and fs_exists(out);

    // Optional UPX compression for the smallest on-disk binary, if available.
    let compressed = false;
    let upx = _fixed_compiler_path("upx");
    if ok and _opt(opts, "compress", false) and upx != "" {
        let u = try proc_spawn_wait(upx, ["--best", "--lzma", "-q", out]) catch nil;
        if u != nil and (try u.exit_code catch 1) == 0 { compressed = true; }
    }

    return map{ ok: ok, output: out, target: target_name, compiler: program,
                stderr: try r.stderr catch "", size: _file_size(out), compressed: compressed,
                release_channel:naming.release_channel,
                artifact_suffix:naming.artifact_suffix };
}

// Compile one already-linked PBLang source snapshot without reopening project
// source or materializing generated C. The compiler receives C from the
// bounded Linux process backend's private stdin descriptor.
fn _compile_source_c99_stage(source, target_name, out_path, opts = nil) {
    let admission = c99_source_admission(source);
    if not admission.ok {
        return map{ ok: false, output: out_path, target: target_name, compiler: nil,
            stderr: admission.error, source_bytes: admission.bytes,
            source_limit_bytes: admission.limit };
    }
    let target = target_by_name(target_name);
    if target == nil {
        return map{ ok: false, output: out_path, target: target_name, compiler: nil,
            stderr: "unknown target: " + target_name };
    }
    let fixed = _pick_fixed_recipe(target);
    if fixed == nil {
        return map{ ok: false, output: out_path, target: target_name, compiler: nil,
            stderr: "secure C99 publication found no target compiler in an allowlisted system directory" };
    }
    let recipe = fixed.recipe;
    let program = fixed.program;

    let c_source = try CTRANSPILER.transpile_program(source) catch nil;
    if type(c_source) != "string" {
        return map{ ok: false, output: out_path, target: target_name, compiler: program,
            stderr: "in-memory C99 transpilation failed" };
    }
    let stdin_bytes = str_to_bytes(c_source);
    if len(stdin_bytes) > 16777216 {
        return map{ ok: false, output: out_path, target: target_name, compiler: program,
            stderr: "generated C exceeds the 16 MiB immutable-stdin limit" };
    }

    let output = out_path + target.ext;
    let args = [];
    for a in recipe.pre { array_push(args, a); }
    array_push(args, "-x"); array_push(args, "c"); array_push(args, "-");
    for flag in _opt_flags(target, opts) { array_push(args, flag); }
    array_push(args, "-o"); array_push(args, output);
    if target.needs_lm { array_push(args, "-lm"); }

    let run = PROCESS.run_bounded(program, args, map{
        timeout_secs: _opt(opts, "timeout_secs", 600),
        startup_timeout_ms: 5000,
        max_output_bytes: 1048576,
        max_file_bytes: 67108864,
        max_memory_bytes: _opt(opts, "max_memory_bytes", 2147483648),
        max_cpu_seconds: _opt(opts, "max_cpu_seconds", 120),
        stdin_bytes: stdin_bytes,
        environment: map{
            PATH: "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            LANG: "C", LC_ALL: "C", TMPDIR: "/tmp"
        },
        inherit_environment: false
    });
    let ok = (try run.ok catch false) and (try run.command_ok catch false)
        and fs_exists(output);
    let diagnostic = try run.stderr catch "";
    if type(diagnostic) != "string" or diagnostic == "" {
        diagnostic = try run.error catch "";
    }
    if type(diagnostic) != "string" or diagnostic == "" {
        diagnostic = "bounded compiler failed";
    }
    return map{
        ok: ok, output: output, target: target_name, compiler: program,
        error: if ok { "" } else { diagnostic }, stderr: if ok { try run.stderr catch "" } else { diagnostic },
        size: if ok { _file_size(output) } else { nil }, compressed: false,
        source_transport: "private-stdin", generated_c_on_disk: false,
        bounded_process: try run.bounded catch false,
        execution_admitted: try run.bounded catch false,
        executed: try run.completed catch false,
        raw_fallback: try run.raw_fallback catch false,
        process_status: try run.process_status catch PROCESS.bounded_status(),
        process_group_terminated: try run.process_group_terminated catch false,
        output_truncated: try run.output_truncated catch false
    };
}

fn _private_c99_stage() {
    if platform() != "linux" {
        return map{ ok: false, error: "immutable C99 staging requires Linux directory handles" };
    }
    let token = str_slice(sha256(base64_encode_bytes(random_bytes(32)) + str(now_ms())), 0, 32);
    let root = "/tmp/pblang-dist-c99-" + token;
    let held = DIRFS.open_absolute(root, true, true);
    if not held.ok { return map{ ok: false, error: "private C99 stage cannot be created" }; }
    let descriptor = DIRFS.descriptor_path(held);
    if not descriptor.ok { DIRFS.close(held); return descriptor; }
    return map{ ok: true, root: root, fs: held, base: descriptor.path };
}

fn _close_c99_stage(stage, output_path) {
    if stage == nil or not (try stage.ok catch false) {
        return map{ ok: false, error: "invalid private C99 stage" };
    }
    let output_name = path_basename(output_path);
    let output_removed = try DIRFS.remove_file(stage.fs, output_name).ok catch false;
    let stage_closed = try DIRFS.close(stage.fs) catch false;
    let parent = DIRFS.open_absolute("/tmp", false, false);
    let directory_removed = false;
    if parent.ok {
        let result = try DIRFS.remove(parent, path_basename(stage.root)) catch map{ ok: false };
        directory_removed = result.ok;
        if not (try DIRFS.close(parent) catch false) { directory_removed = false; }
    }
    if not stage_closed or not directory_removed {
        return map{ ok: false, error: "private C99 stage teardown could not be verified",
            expected_output: output_name, output_removed: output_removed,
            stage_closed: stage_closed,
            directory_removed: directory_removed };
    }
    return map{ ok: true, entries_removed: if output_removed { 1 } else { 0 },
        expected_output: output_name,
        stage_closed: true, directory_removed: true };
}

fn _protect_published_executable(path) {
    if platform() != "linux" {
        return map{ ok: false, error: "published executable protection requires Linux" };
    }
    let parent = DIRFS.open_absolute(path_dirname(path), false, false);
    if not parent.ok { return parent; }
    let protected = DIRFS.protect_executable(parent, path_basename(path));
    DIRFS.close(parent);
    return protected;
}

fn _secure_publish_bytes(path, bytes, executable) {
    if type(bytes) != "array" or len(bytes) < 1 or len(bytes) > 67108864 {
        return map{ ok: false, error: "artifact bytes exceed the publication bound" };
    }
    let expected = sha256(base64_encode_bytes(bytes));
    if not (try SECURE.write_atomic(path, bytes, true, false).ok catch false) {
        return map{ ok: false, output: path, output_removed: false,
            cleanup_verified: false, error: "atomic artifact publication failed" };
    }
    if executable and not (try _protect_published_executable(path).ok catch false) {
        let cleanup = SECURE.remove_file(path, false);
        return map{ ok: false, error: "published executable permission failed",
            output: path, output_removed: try cleanup.namespace_absent catch false,
            cleanup_verified: try cleanup.namespace_absent catch false };
    }
    let loaded = SECURE.read_bytes(path, 67108864, false);
    if not loaded.ok or len(loaded.bytes) != len(bytes)
        or sha256(base64_encode_bytes(loaded.bytes)) != expected {
        let cleanup = SECURE.remove_file(path, false);
        return map{ ok: false, error: "published artifact digest verification failed",
            output: path, output_removed: try cleanup.namespace_absent catch false,
            cleanup_verified: try cleanup.namespace_absent catch false };
    }
    return map{ ok: true, output: path, bytes: len(bytes), digest: expected,
        digest_format: "sha256-base64-content-v1", atomic: true,
        symlink_target_followed: false };
}

// Compile an immutable source snapshot to bounded bytes. The compiler can only
// write inside a private descriptor-held stage and no caller pathname is opened.
fn compile_source_c99_blob(source, target_name, opts = nil) {
    let target = target_by_name(target_name);
    if target == nil {
        return map{ ok: false, target: target_name, compiler: nil,
            stderr: "unknown target: " + target_name };
    }
    let stage = _private_c99_stage();
    if not stage.ok {
        return map{ ok: false, target: target_name, compiler: nil,
            stderr: stage.error };
    }
    let compiled = _compile_source_c99_stage(source, target_name,
        stage.base + "/artifact", opts);
    if not compiled.ok {
        let cleanup = _close_c99_stage(stage, compiled.output);
        compiled.stage_cleanup_verified = cleanup.ok;
        compiled.stage_entries_removed = try cleanup.entries_removed catch 0;
        if not cleanup.ok {
            compiled.stderr = compiled.stderr + "; " + cleanup.error;
            compiled.error = compiled.stderr;
        }
        return compiled;
    }
    let loaded = DIRFS.read_bytes(stage.fs, path_basename(compiled.output), 67108864);
    let cleanup = _close_c99_stage(stage, compiled.output);
    if not cleanup.ok {
        return map{ ok: false, target: target_name, compiler: compiled.compiler,
            stderr: cleanup.error, stage_cleanup_verified: false };
    }
    if not loaded.ok {
        return map{ ok: false, target: target_name,
            compiler: compiled.compiler, stderr: "staged C99 artifact cannot be read safely" };
    }
    return map{
        ok: true, blob: loaded.bytes, target: target_name, compiler: compiled.compiler,
        stderr: compiled.stderr, size: len(loaded.bytes), compressed: false,
        source_transport: compiled.source_transport,
        generated_c_on_disk: false, bounded_process: compiled.bounded_process,
        execution_admitted: try compiled.execution_admitted catch false,
        executed: try compiled.executed catch false,
        raw_fallback: try compiled.raw_fallback catch false,
        process_status: try compiled.process_status catch PROCESS.bounded_status(),
        process_group_terminated: compiled.process_group_terminated,
        output_truncated: compiled.output_truncated,
        stage_cleanup_verified: true, stage_entries_removed: cleanup.entries_removed
    };
}

// Public snapshot compilation never lets the compiler open the caller's final
// pathname. It publishes only the exact bytes returned by the private blob API.
fn compile_source_c99(source, target_name, out_path, opts = nil) {
    let target = target_by_name(target_name);
    if target == nil {
        return map{ ok: false, output: out_path, target: target_name, compiler: nil,
            stderr: "unknown target: " + target_name };
    }
    let compiled = compile_source_c99_blob(source, target_name, opts);
    if not compiled.ok {
        compiled.output = out_path;
        return compiled;
    }
    let naming = RELEASE_CHANNEL.artifact_base(out_path, opts);
    if not naming.ok {
        return map{ ok:false, output:out_path, target:target_name,
            compiler:compiled.compiler, stderr:"invalid release identity: " + naming.error,
            stage_cleanup_verified:try compiled.stage_cleanup_verified catch false };
    }
    let output = naming.path + target.ext;
    let published = _secure_publish_bytes(output, compiled.blob, target.os != "windows");
    if not published.ok {
        return map{ ok: false, output: output, target: target_name,
            compiler: compiled.compiler, stderr: published.error,
            output_removed: try published.output_removed catch false,
            cleanup_verified: try published.cleanup_verified catch false,
            stage_cleanup_verified: try compiled.stage_cleanup_verified catch false };
    }
    return map{
        ok: true, output: output, target: target_name, compiler: compiled.compiler,
        stderr: compiled.stderr, size: published.bytes, compressed: false,
        source_transport: compiled.source_transport,
        generated_c_on_disk: false, bounded_process: compiled.bounded_process,
        execution_admitted: try compiled.execution_admitted catch false,
        executed: try compiled.executed catch false,
        raw_fallback: try compiled.raw_fallback catch false,
        process_status: try compiled.process_status catch nil,
        process_group_terminated: compiled.process_group_terminated,
        output_truncated: compiled.output_truncated,
        stage_cleanup_verified: compiled.stage_cleanup_verified,
        stage_entries_removed: compiled.stage_entries_removed,
        atomic_publication: true, symlink_target_followed: false,
        digest: published.digest, digest_format: published.digest_format,
        release_channel:naming.release_channel,
        artifact_suffix:naming.artifact_suffix
    };
}

// Full single-target build: transpile then compile. `out_base` is the output
// path WITHOUT extension (the target's ext, e.g. ".exe", is appended).
// Returns map{ ok, output, target, compiler, stderr, c_path }.
fn build(src, target_name, out_base, opts = nil) {
    let c_path = out_base + ".c";
    let tr = transpile(src, c_path);
    if not tr.ok {
        return map{ ok: false, output: nil, target: target_name, compiler: nil,
                    stderr: "transpile failed: " + str(tr.stderr), c_path: c_path };
    }
    let res = compile_c(c_path, target_name, out_base, opts);
    res.c_path = c_path;
    return res;
}

// release(): build the recommended "ship it" binary (small, stripped, static).
// `target` defaults to the host's first available target.
fn release(src, out_base, target = nil) {
    if target == nil {
        let av = available_targets();
        if len(av) == 0 { return map{ ok: false, stderr: "no C toolchain on host" }; }
        target = av[0].name;
    }
    return build(src, target, out_base, release_opts());
}

// Build for many targets at once. Transpiles ONCE (the C is host-independent),
// then compiles each requested target. `targets` is a list of names, or nil for
// "every available target". `out_dir` receives `<basename>-<target><ext>`.
// Returns map{ ok, c_path, results: [ per-target build maps ] }.
fn build_all(src, out_dir, targets = nil, opts = nil) {
    if targets == nil {
        targets = [];
        for t in available_targets() { array_push(targets, t.name); }
    }
    let base = _basename_noext(src);
    let c_path = out_dir + "/" + base + ".c";
    try fs_mkdirs(out_dir) catch nil;

    let tr = transpile(src, c_path);
    if not tr.ok {
        return map{ ok: false, c_path: c_path,
                    results: [ map{ ok: false, stderr: "transpile failed: " + str(tr.stderr) } ] };
    }

    let results = [];
    let all_ok = true;
    for name in targets {
        let out_base = out_dir + "/" + base + "-" + name;
        let res = compile_c(c_path, name, out_base, opts);
        array_push(results, res);
        if not res.ok { all_ok = false; }
    }
    return map{ ok: all_ok, c_path: c_path, results: results };
}

fn _basename_noext(path) {
    let parts = str_split(path, "/");
    let fname = parts[len(parts) - 1];
    let dot = str_split(fname, ".");
    if len(dot) <= 1 { return fname; }
    let out = dot[0];
    let i = 1;
    while i < len(dot) - 1 { out = out + "." + dot[i]; i = i + 1; }
    return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting
// ─────────────────────────────────────────────────────────────────────────────

fn _fmt_size(n) {
    if n == nil { return "?"; }
    if n < 1024 { return str(n) + "B"; }
    if n < 1048576 { return str(num_floor(n / 1024)) + "KB"; }
    return str(num_floor(n / 104857.6) / 10) + "MB";
}

fn report_to_string(rep) {
    let lines = [];
    for res in rep.results {
        let tag = "FAIL";
        if res.ok { tag = " ok "; }
        let line = "[" + tag + "] " + str(try res.target catch "?");
        if res.ok {
            line = line + " -> " + str(res.output)
                 + " (" + str(res.compiler) + ", " + _fmt_size(try res.size catch nil);
            if try res.compressed catch false { line = line + ", upx"; }
            line = line + ")";
        } else {
            line = line + " : " + str(try res.stderr catch "?");
        }
        array_push(lines, line);
    }
    return str_join(lines, "\n");
}

// ── portable bytecode artifact (self-hosted PBCS .pbck) ──────────────────────
// bundle_pbck(): link the project at `main_path` (resolving import()s from disk)
// into ONE self-contained, OPTIMIZED self-hosted .pbck written to
// `out_base + ".pbck"`. Unlike build()/release() (native exe via C transpile),
// this is a portable bytecode artifact: it runs anywhere a pblang runtime exists
// — `pblang run tools/pbrun.sapp --allow-all <art>.pbck` — with no Rust front-end
// re-parsing source, and it stays runnable after its source files are deleted.
//
// The bundled chunk is run through the sound optimizer (constant folding, dead
// code, jump simplification — recursively over function/try bodies) before
// serialization, so the shipped bytecode is smaller + faster than a raw bundle.
//
// Returns { ok, out, bytes, bytes_unopt, saved, modules, optimized } or
// { ok:false, reason } from the bundler (collision / builtin-shadow / cycle /
// unresolvable / nested-import).
fn bundle_pbck(main_path, out_base, opts = nil) {
    let b = SELFHOST_BUNDLE.bundle_file(main_path);
    if not b.ok { return b; }

    let do_opt = _opt(opts, "optimize", true);
    let raw_bytes = len(SELFHOST_PBCK.serialize_chunk(b.chunk));
    let chunk = b.chunk;
    if do_opt {
        chunk = SELFHOST_TO_PBCK.optimize_chunk(b.chunk);   // recursive optimize_safe
    }
    let blob = SELFHOST_PBCK.serialize_chunk(chunk);
    let out_path = out_base + ".pbck";
    let published = _secure_publish_bytes(out_path, blob, false);
    if not published.ok {
        return map{ ok: false, out: out_path,
            output_removed: try published.output_removed catch false,
            cleanup_verified: try published.cleanup_verified catch false,
            reason: try published.error catch "PBCK publication failed" };
    }
    return map{
        ok: true,
        out: out_path,
        bytes: len(blob),
        bytes_unopt: raw_bytes,
        saved: raw_bytes - len(blob),
        modules: b.modules,
        optimized: do_opt,
    };
}

// Build portable bytecode from a caller-owned immutable linked-source snapshot.
// A real import remaining in this source fails because no filesystem resolver
// is supplied; smart builds must pass the dependency analyzer's linked program.
fn bundle_pbck_blob(main_source, opts = nil) {
    if type(main_source) != "string" {
        return map{ ok: false, reason: "bundle_pbck_blob: source must be text" };
    }
    let source_bytes = len(str_to_bytes(main_source));
    if source_bytes > 16777216 {
        return map{ ok: false, reason: "bundle_pbck_blob: linked source exceeds 16 MiB" };
    }
    let bundled = SELFHOST_BUNDLE.bundle(main_source, fn(path) { return nil; });
    if not bundled.ok { return bundled; }
    let do_opt = _opt(opts, "optimize", true);
    let raw_bytes = len(SELFHOST_PBCK.serialize_chunk(bundled.chunk));
    let chunk = bundled.chunk;
    if do_opt {
        chunk = SELFHOST_TO_PBCK.optimize_chunk(chunk);
    }
    let blob = SELFHOST_PBCK.serialize_chunk(chunk);
    return map{
        ok: true, blob: blob, bytes: len(blob), bytes_unopt: raw_bytes,
        saved: raw_bytes - len(blob), modules: bundled.modules,
        optimized: do_opt, source_transport: "immutable-memory"
    };
}

fn bundle_pbck_source(main_source, out_base, opts = nil) {
    let result = bundle_pbck_blob(main_source, opts);
    if not result.ok { return result; }
    let out_path = out_base + ".pbck";
    let published = _secure_publish_bytes(out_path, result.blob, false);
    if not published.ok {
        return map{ ok: false, out: out_path,
            output_removed: try published.output_removed catch false,
            cleanup_verified: try published.cleanup_verified catch false,
            reason: try published.error catch "PBCK snapshot publication failed" };
    }
    map_remove(result, "blob");
    result.out = out_path;
    result.atomic_publication = true;
    result.symlink_target_followed = false;
    result.digest = published.digest;
    result.digest_format = published.digest_format;
    return result;
}

// self_extract(): emit a single self-extracting .pbself file — valid pblang
// source that embeds the OPTIMIZED PBCS bundle as a base64 line comment after a
// "//PBSELF1:" sentinel. Running it (`pblang run app.pbself --allow-all`) makes
// the baked-in launcher read its own source, decode the payload, and run it on
// the self-hosted VM. Pure pblang, no Rust/C; one portable file; self-contained
// (runs after its source modules are deleted). The MARKER must match
// selfhost_loader.extract_payload's reader.
// Returns { ok, out, bytes, payload_bytes, modules, optimized } or {ok:false}.
fn self_extract(main_path, out_path, opts = nil) {
    let b = SELFHOST_BUNDLE.bundle_file(main_path);
    if not b.ok { return b; }

    let do_opt = _opt(opts, "optimize", true);
    let chunk = b.chunk;
    if do_opt {
        chunk = SELFHOST_TO_PBCK.optimize_chunk(b.chunk);
    }
    let b64 = base64_encode_bytes(SELFHOST_PBCK.serialize_chunk(chunk));
    let launcher = "// pblang self-extracting bundle (PBSELF v1)\n"
        + "// Run: pblang run " + out_path + " --allow-all\n"
        + "let __pbself = import(\"stdlib/selfhost_loader.sapp\");\n"
        + "__pbself.exec_self();\n"
        + "//PBSELF1:" + b64 + "\n";
    let blob = str_to_bytes(launcher);
    fs_write_bytes(out_path, blob);
    return map{
        ok: true,
        out: out_path,
        bytes: len(blob),
        payload_bytes: len(base64_decode_bytes(b64)),
        modules: b.modules,
        optimized: do_opt,
    };
}

// native(): produce a TRUE standalone native executable (pblang -> C99 -> cc) —
// it runs with NO pblang runtime on the host. Defaults to release opts (static +
// stripped) and the host target. Multi-module programs are first linked into one
// self-contained source by the source inliner (stdlib/source_inliner.sapp) so
// they compile too. Returns the build report augmented with
// { native:true, standalone, inlined? } or { ok:false, reason, multi_module? }.
fn native(main_path, out_base, opts = nil, target = nil) {
    let src = try bytes_to_str(fs_read_bytes(main_path)) catch nil;
    if src == nil { return map{ ok: false, reason: "native: cannot read " + str(main_path) }; }

    let build_path = main_path;
    let inlined = false;
    // `str_index_of(src, "import(")` is a cheap pre-filter with no false negatives
    // (a real import always contains "import("), but it ALSO matches import() in a
    // comment/string. The source inliner is comment/string-aware, so trust ITS
    // count: only treat the program as multi-module (and build the inlined file)
    // when it actually linked real modules. Otherwise build the original source —
    // so a single-file program with import() only in a comment reports inlined:false
    // and writes no spurious .inlined.sapp.
    if str_index_of(src, "import(") >= 0 {
        let lk = SOURCE_INLINER.inline_file_prefixed(main_path);
        if not lk.ok {
            return map{ ok: false, multi_module: true,
                reason: "native: cannot link imports for a single binary: " + lk.reason
                      + " (alternative: dist.self_extract for a portable .pbself)" };
        }
        if lk.modules > 0 {
            build_path = out_base + ".inlined.sapp";
            fs_write_bytes(build_path, str_to_bytes(lk.source));
            inlined = true;
        }
    }

    let av = available_targets();
    if len(av) == 0 { return map{ ok: false, reason: "native: no C toolchain on host. " + missing_targets_help() }; }
    if target == nil { target = av[0].name; }
    if opts == nil { opts = release_opts(); }
    let r = build(build_path, target, out_base, opts);
    r.native = true;
    r.standalone = _opt(opts, "static", false);
    r.inlined = inlined;
    // native() promises a standalone BINARY, so its intermediates (<out>.c and the
    // inlined .sapp) are build debris — remove them on success. On FAILURE they are
    // kept for debugging (r.c_path says where). opts.keep_intermediates = true keeps
    // them always; build() itself is unchanged for callers who want the C.
    if r.ok and not _opt(opts, "keep_intermediates", false) {
        try fs_remove(out_base + ".c") catch nil;
        if inlined { try fs_remove(build_path) catch nil; }
    }
    return r;
}

fn native_source(source, out_base, opts = nil, target = nil) {
    if target == nil {
        let available = available_targets();
        if len(available) == 0 {
            return map{ ok: false, reason: "native_source: no C toolchain on host" };
        }
        target = available[0].name;
    }
    if opts == nil { opts = release_opts(); }
    let result = compile_source_c99(source, target, out_base, opts);
    result.native = true;
    result.standalone = _opt(opts, "static", false);
    result.inlined = true;
    if not result.ok { result.reason = result.stderr; }
    return result;
}

export have, all_targets, target_by_name, available_targets, missing_targets_help;
export default_opts, release_opts, transpile, compile_c, c99_source_admission;
export compile_source_c99_blob, compile_source_c99;
export build, build_all, release, report_to_string;
export bundle_pbck, bundle_pbck_blob, bundle_pbck_source, self_extract, native, native_source;
export runtime_binary;
