// Optional one-connection cleanup for trusted synchronous SQLite callbacks.
// Numeric handles remain public; this is not a sandbox or realm boundary.
let DB = import("./db.sapp");

fn _close(handle) { sqlite_close(handle); return true; }

// Private state: open_ok, body_ok, close_call_ok, value, error.
fn _with_sqlite_state(path, body_fn) {
    let conn = try DB.sqlite.open(path) catch nil;
    if conn == nil { return [false, false, true, nil, "db: SQLite open failed"]; }
    // Capture the original handle before callback code can replace map fields.
    let handle = conn.handle;
    let body = try [true, body_fn(conn)] catch [false, nil];
    let closed = try _close(handle) catch false;
    if not closed { return [true, body[0], false, nil, "db: SQLite close call failed"]; }
    if not body[0] { return [true, false, true, nil, "db: SQLite callback failed"]; }
    return [true, true, true, body[1], nil];
}

// close_call_ok means the builtin returned, not independently verified release.
// No resource acquired makes close_call_ok vacuously true.
fn with_sqlite_result(path, body_fn) {
    let state = _with_sqlite_state(path, body_fn);
    return map{ok:state[0] and state[1] and state[2], value:state[3], error:state[4],
        open_ok:state[0], body_ok:state[1], close_call_ok:state[2]};
}

fn with_sqlite(path, body_fn) {
    let state = _with_sqlite_state(path, body_fn);
    if not (state[0] and state[1] and state[2]) { throw state[4]; }
    return state[3];
}

export with_sqlite, with_sqlite_result;
