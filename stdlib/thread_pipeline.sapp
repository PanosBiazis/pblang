// Loaded only when thread.pipeline is requested. No background workers here.
let _POOL = nil;

// pipeline(stages) -> batch pipeline; stages are barriers, workers run in parallel.
// A nil stage result filters an item. Multiworker output order is unspecified.
fn create(stages) {
    if type(stages) != "array" { throw "thread.pipeline: stages must be an array"; }
    // Snapshot validated configuration before starting any task. Revalidating
    // only when a later stage starts could allow partial effects on bad input.
    let plan = [];
    for stage in stages {
        if type(stage) != "map" { throw "thread.pipeline: stage must be a map"; }
        let process_fn = try stage.process catch nil;
        let kind = type(process_fn);
        if kind != "closure" and kind != "function" and kind != "fn" and kind != "builtin" {
            throw "thread.pipeline: process must be callable";
        }
        let workers = if map_has(stage, "workers") { stage.workers } else { 1 };
        if not is_number(workers) { throw "thread.pipeline: workers must be numeric"; }
        if workers - workers != 0 or workers < 1 or workers != num_floor(workers) {
            throw "thread.pipeline: workers must be a positive finite integer";
        }
        array_push(plan, map{process:process_fn, workers:workers});
    }
    return map{
        run: fn(_self, input_data) {
            if type(input_data) != "array" { throw "thread.pipeline: input must be an array"; }
            let current = input_data;
            for stage in plan {
                if len(current) == 0 { return []; }
                // The existing pool joins every started worker, closes queues
                // and drains abandoned payloads before a task/transfer error.
                if _POOL == nil { _POOL = import("stdlib:thread_pool_worker.sapp"); }
                let count = stage.workers;
                if count > len(current) { count = len(current); }
                let values = _POOL.run(count, current, stage.process);
                let next = [];
                for value in values { if value != nil { array_push(next, value); } }
                current = next;
            }
            return current;
        }
    };
}

export create;
