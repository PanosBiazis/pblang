// stdlib/circuits.sapp — circuit building blocks in pblang (digital + analog + a qubit
// gate toy). Composable primitives for simulating/teaching circuits and for wiring
// circuit-inspired structures into networks.
//
//   * digital logic: and/or/not/xor/nand/nor/xnor, mux, half/full adder, ripple adder.
//   * analog electrical: series/parallel resistance, voltage divider, Ohm's law, RC, caps.
//   * quantum: a lightweight SINGLE-qubit real-amplitude gate toy (q_x/q_z/q_h/q_prob).
//     For full multi-qubit circuits (complex amplitudes, CNOT, QASM) use stdlib/quantum.sapp.

// ── digital logic gates (inputs/outputs are 0 / 1) ────────────────────────────────
fn gate_and(a, b) { if a != 0 and b != 0 { return 1; } return 0; }
fn gate_or(a, b) { if a != 0 or b != 0 { return 1; } return 0; }
fn gate_not(a) { if a != 0 { return 0; } return 1; }
fn gate_xor(a, b) { return gate_and(gate_or(a, b), gate_not(gate_and(a, b))); }
fn gate_nand(a, b) { return gate_not(gate_and(a, b)); }
fn gate_nor(a, b) { return gate_not(gate_or(a, b)); }
fn gate_xnor(a, b) { return gate_not(gate_xor(a, b)); }

// mux2(sel, a, b) — 2-to-1 multiplexer: a when sel=0, b when sel=1.
fn mux2(sel, a, b) { if sel == 0 { return a; } return b; }

// half_adder(a, b) — { sum, carry }. full_adder chains a carry-in.
fn half_adder(a, b) { return map{ sum: gate_xor(a, b), carry: gate_and(a, b) }; }
fn full_adder(a, b, cin) {
    let h1 = half_adder(a, b);
    let h2 = half_adder(h1.sum, cin);
    return map{ sum: h2.sum, carry: gate_or(h1.carry, h2.carry) };
}

// ripple_add(a, b) — n-bit ripple-carry adder over LSB-first bit lists; returns
// { bits (LSB-first), carry }. Shorter operand is zero-extended.
fn ripple_add(a, b) {
    let n = len(a);
    if len(b) > n { n = len(b); }
    let bits = [];
    let carry = 0;
    let i = 0;
    while i < n {
        let ai = 0; if i < len(a) { ai = a[i]; }
        let bi = 0; if i < len(b) { bi = b[i]; }
        let fa = full_adder(ai, bi, carry);
        push(bits, fa.sum);
        carry = fa.carry;
        i = i + 1;
    }
    return map{ bits: bits, carry: carry };
}

// ── analog electrical / electronic ────────────────────────────────────────────────
fn series_resistance(rs) { let s = 0; let i = 0; while i < len(rs) { s = s + rs[i]; i = i + 1; } return s; }
fn parallel_resistance(rs) {
    let s = 0;
    let i = 0;
    while i < len(rs) { if rs[i] != 0 { s = s + 1 / rs[i]; } i = i + 1; }
    if s == 0 { return 0; }
    return 1 / s;
}
// voltage_divider(vin, r1, r2) — voltage across r2 (the low-side resistor).
fn voltage_divider(vin, r1, r2) { if r1 + r2 == 0 { return 0; } return vin * r2 / (r1 + r2); }
// Ohm's law: V = I·R, I = V/R, P = V·I.
fn ohm_current(v, r) { if r == 0 { return 0; } return v / r; }
fn ohm_voltage(i, r) { return i * r; }
fn ohm_power(v, i) { return v * i; }
// RC time constant τ = R·C; capacitor energy E = ½·C·V².
fn rc_tau(r, c) { return r * c; }
fn cap_energy(c, v) { return 0.5 * c * v * v; }
// Capacitors: series add reciprocally (like parallel resistors); parallel add directly.
fn cap_series(cs) { return parallel_resistance(cs); }
fn cap_parallel(cs) { return series_resistance(cs); }

// ── single-qubit gate toy (REAL amplitudes [a, b] for |0>,|1>) ────────────────────
// Educational; for real multi-qubit circuits use stdlib/quantum.sapp.
fn qstate0() { return [1, 0]; }
fn qstate1() { return [0, 1]; }
fn q_x(s) { return [s[1], s[0]]; }              // bit flip (Pauli-X / NOT)
fn q_z(s) { return [s[0], 0 - s[1]]; }          // phase flip (Pauli-Z)
fn q_h(s) { let r = 1 / num_sqrt(2); return [(s[0] + s[1]) * r, (s[0] - s[1]) * r]; }   // Hadamard
fn q_prob(s) { return map{ p0: s[0] * s[0], p1: s[1] * s[1] }; }   // measurement probabilities

export gate_and, gate_or, gate_not, gate_xor, gate_nand, gate_nor, gate_xnor, mux2;
export half_adder, full_adder, ripple_add;
export series_resistance, parallel_resistance, voltage_divider;
export ohm_current, ohm_voltage, ohm_power, rc_tau, cap_energy, cap_series, cap_parallel;
export qstate0, qstate1, q_x, q_z, q_h, q_prob;
