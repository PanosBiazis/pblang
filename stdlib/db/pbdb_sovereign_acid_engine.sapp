// stdlib/db/pbdb_sovereign_acid_engine.sapp — PBDb v5.0.0: Zero-DLL Sovereign ACID
// Slotted-Page Relational + B+Tree + MVCC + Crash-Safe WAL + AEAD Encrypted-At-Rest +
// Greek/Unicode BM25 Full-Text + HNSW Vector + Apache Parquet (PAR1) & Arrow IPC (ARROW1) Engine

let SHA256 = import("stdlib:sha256_pb.sapp");
let CRYPTO = import("stdlib:crypto.sapp");
let U = import("stdlib:unicode.sapp");

let PBDB_VERSION = "5.0.0";
let PAGE_SIZE = 4096;
let PAGE_MAGIC = [80, 66, 68, 66, 118, 53, 48, 48]; // "PBDBv500"
let WAL_MAGIC = [80, 66, 87, 65, 76, 53, 48, 48];   // "PBWAL500"
let WAL_FRAME_MAGIC = [87, 65, 76, 70];             // "WALF"
let PARQUET_MAGIC = [80, 65, 82, 49];               // "PAR1"
let ARROW_MAGIC = [65, 82, 82, 79, 87, 49];         // "ARROW1"

let PAGE_TYPE_SUPER = 1;
let PAGE_TYPE_DATA = 2;
let PAGE_TYPE_BTREE = 3;

let WAL_OP_BEGIN = 1;
let WAL_OP_MUTATE = 2;
let WAL_OP_COMMIT = 3;
let WAL_OP_ROLLBACK = 4;

fn _opt(m, k, fb) {
    if m == nil or not is_map(m) { return fb; }
    if not map_has(m, k) { return fb; }
    let v = m[k];
    if v == nil { return fb; }
    return v;
}

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn _append_bytes(dst, src) {
    let i = 0;
    let n = len(src);
    while i < n { array_push(dst, src[i]); i = i + 1; }
    return dst;
}

fn _copy_map(m) {
    let out = map{};
    if not is_map(m) { return out; }
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) { out[ks[i]] = m[ks[i]]; i = i + 1; }
    return out;
}

fn _push_u16_le(buf, val) {
    let v = num_mod(num_floor(val), 65536);
    if v < 0 { v = v + 65536; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    return buf;
}

fn _push_u32_le(buf, val) {
    let v = num_mod(num_floor(val), 4294967296);
    if v < 0 { v = v + 4294967296; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(num_floor(v / 65536), 255));
    array_push(buf, bit_and(num_floor(v / 16777216), 255));
    return buf;
}

fn _set_u16_le(buf, off, val) {
    let v = num_mod(num_floor(val), 65536);
    if v < 0 { v = v + 65536; }
    buf[off] = bit_and(v, 255);
    buf[off + 1] = bit_and(num_floor(v / 256), 255);
}

fn _set_u32_le(buf, off, val) {
    let v = num_mod(num_floor(val), 4294967296);
    if v < 0 { v = v + 4294967296; }
    buf[off] = bit_and(v, 255);
    buf[off + 1] = bit_and(num_floor(v / 256), 255);
    buf[off + 2] = bit_and(num_floor(v / 65536), 255);
    buf[off + 3] = bit_and(num_floor(v / 16777216), 255);
}

fn _u16_le(b, off) { return b[off] + b[off + 1] * 256; }
fn _u32_le(b, off) { return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216; }

// ============================================================================
// 1. Castagnoli CRC32C (`0x82F63B78`) & Binary ChaCha20-HMAC-SHA256 AEAD
// ============================================================================

fn _build_crc32c_table() {
    let tbl = [];
    let i = 0;
    while i < 256 {
        let crc = i;
        let bit = 0;
        while bit < 8 {
            if bit_and(crc, 1) != 0 {
                crc = bit_xor(bit_shr(crc, 1), 2197175160); // 0x82F63B78
            } else {
                crc = bit_shr(crc, 1);
            }
            bit = bit + 1;
        }
        array_push(tbl, crc);
        i = i + 1;
    }
    return tbl;
}

let _CRC32C_TABLE = _build_crc32c_table();

fn crc32c_bytes(data) {
    let crc = 4294967295; // 0xFFFFFFFF
    let i = 0;
    let n = len(data);
    while i < n {
        let idx = bit_and(bit_xor(crc, data[i]), 255);
        crc = bit_xor(bit_shr(crc, 8), _CRC32C_TABLE[idx]);
        i = i + 1;
    }
    return bit_and(bit_xor(crc, 4294967295), 4294967295);
}

fn _hex_to_bytes(hex_str) {
    let out = [];
    let n = len(hex_str);
    let i = 0;
    while i + 1 < n {
        let c1 = strcharcodeat(hex_str, i);
        let c2 = strcharcodeat(hex_str, i + 1);
        let n1 = if c1 >= 48 and c1 <= 57 { c1 - 48 } elif c1 >= 97 and c1 <= 102 { c1 - 87 } else { c1 - 55 };
        let n2 = if c2 >= 48 and c2 <= 57 { c2 - 48 } elif c2 >= 97 and c2 <= 102 { c2 - 87 } else { c2 - 55 };
        array_push(out, n1 * 16 + n2);
        i = i + 2;
    }
    return out;
}

fn _derive_key32(key_material) {
    if key_material == nil or key_material == "" { return nil; }
    if is_array(key_material) {
        if len(key_material) == 32 { return key_material; }
        return _hex_to_bytes(SHA256.sha256_hex_bytes(key_material));
    }
    return _hex_to_bytes(SHA256.sha256_hex(str(key_material)));
}

// Pure binary-safe RFC 2104 HMAC-SHA256 on raw byte arrays (zero UTF-8 corruption)
fn _hmac_sha256_raw_bytes(key32, msg_bytes) {
    let ipad = [];
    let opad = [];
    let i = 0;
    while i < 64 {
        let kb = if i < len(key32) { key32[i] } else { 0 };
        array_push(ipad, bit_xor(kb, 54));
        array_push(opad, bit_xor(kb, 92));
        i = i + 1;
    }
    _append_bytes(ipad, msg_bytes);
    let inner_hash = _hex_to_bytes(SHA256.sha256_hex_bytes(ipad));
    _append_bytes(opad, inner_hash);
    return _hex_to_bytes(SHA256.sha256_hex_bytes(opad));
}

fn _ct_eq_bytes(a, b) {
    if len(a) != len(b) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(a) {
        diff = bit_or(diff, bit_xor(a[i], b[i]));
        i = i + 1;
    }
    return diff == 0;
}

fn _aead_seal_bytes(plain_bytes, key32, nonce12, aad_bytes) {
    // Subkey derivation: enc_key = HMAC(key32, "enc" || nonce12), mac_key = HMAC(key32, "mac" || nonce12)
    let enc_in = [101, 110, 99];
    _append_bytes(enc_in, nonce12);
    let mac_in = [109, 97, 99];
    _append_bytes(mac_in, nonce12);
    let enc_key = _hmac_sha256_raw_bytes(key32, enc_in);
    let mac_key = _hmac_sha256_raw_bytes(key32, mac_in);
    let ct = CRYPTO.chacha20_encrypt(plain_bytes, enc_key, nonce12);
    let auth_buf = [];
    _append_bytes(auth_buf, aad_bytes);
    _push_u32_le(auth_buf, len(aad_bytes));
    _append_bytes(auth_buf, ct);
    _push_u32_le(auth_buf, len(ct));
    let tag32 = _hmac_sha256_raw_bytes(mac_key, auth_buf);
    return map{ ciphertext: ct, tag32: tag32 };
}

fn _aead_open_bytes(ct_bytes, key32, nonce12, tag32, aad_bytes) {
    let enc_in = [101, 110, 99];
    _append_bytes(enc_in, nonce12);
    let mac_in = [109, 97, 99];
    _append_bytes(mac_in, nonce12);
    let enc_key = _hmac_sha256_raw_bytes(key32, enc_in);
    let mac_key = _hmac_sha256_raw_bytes(key32, mac_in);
    let auth_buf = [];
    _append_bytes(auth_buf, aad_bytes);
    _push_u32_le(auth_buf, len(aad_bytes));
    _append_bytes(auth_buf, ct_bytes);
    _push_u32_le(auth_buf, len(ct_bytes));
    let expected = _hmac_sha256_raw_bytes(mac_key, auth_buf);
    if not _ct_eq_bytes(tag32, expected) {
        throw "pbdb: AEAD page/WAL authentication failed (wrong encryption_key or disk tamper detected)";
    }
    return CRYPTO.chacha20_decrypt(ct_bytes, enc_key, nonce12);
}

// ============================================================================
// 2. Binary `4096`-Byte Slotted Pages (`"PBDBv500"` + `CRC32C` + AEAD at Rest)
// ============================================================================

fn _page_crc32c(page4096) {
    let c_in = slice(page4096, 0, 28);
    _append_bytes(c_in, slice(page4096, 32, PAGE_SIZE));
    return crc32c_bytes(c_in);
}

fn pbdb_encode_slotted_page(page_id, page_type, lsn_txid, cells, encryption_key = nil) {
    let key32 = _derive_key32(encryption_key);
    let encrypted = key32 != nil;
    let body_cap = if encrypted { 4020 } else { 4064 }; // 4096 - 76 vs 4096 - 32
    let cell_count = len(cells);

    // Build inner slotted region of size `body_cap`
    let body = [];
    let bi = 0;
    while bi < body_cap { array_push(body, 0); bi = bi + 1; }

    let dir_pos = if encrypted { 2 } else { 0 };
    if encrypted {
        _set_u16_le(body, 0, cell_count);
    }
    let free_end = body_cap;
    let ci = 0;
    while ci < cell_count {
        let cell = cells[ci];
        let clen = len(cell);
        let next_free_end = free_end - clen;
        let next_dir_end = dir_pos + (ci + 1) * 4;
        if next_free_end < next_dir_end {
            throw "pbdb: slotted page overflow (> 4096 bytes)";
        }
        free_end = next_free_end;
        let b = 0;
        while b < clen { body[free_end + b] = cell[b]; b = b + 1; }
        _set_u16_le(body, dir_pos + ci * 4, free_end);
        _set_u16_le(body, dir_pos + ci * 4 + 2, clen);
        ci = ci + 1;
    }

    let page = [];
    _append_bytes(page, PAGE_MAGIC);                      // [0..7] "PBDBv500"
    array_push(page, page_type);                          // [8] page_type
    array_push(page, if encrypted { 1 } else { 0 });      // [9] flags
    _push_u16_le(page, if encrypted { 0 } else { cell_count }); // [10..11]
    _push_u32_le(page, page_id);                          // [12..15]
    _push_u32_le(page, lsn_txid);                         // [16..19]
    _push_u16_le(page, if encrypted { 0 } else { 32 + cell_count * 4 }); // [20..21]
    _push_u16_le(page, if encrypted { 0 } else { 32 + free_end });       // [22..23]
    _push_u32_le(page, 0);                                // [24..27] reserved
    _push_u32_le(page, 0);                                // [28..31] crc32c placeholder

    if encrypted {
        let nonce12 = random_bytes(12);
        let aad = slice(page, 0, 28);
        _append_bytes(aad, nonce12);
        let sealed = _aead_seal_bytes(body, key32, nonce12, aad);
        _append_bytes(page, nonce12);        // [32..43]
        _append_bytes(page, sealed.tag32);   // [44..75]
        _append_bytes(page, sealed.ciphertext); // [76..4095]
    } else {
        _append_bytes(page, body);           // [32..4095]
    }

    let crc = _page_crc32c(page);
    _set_u32_le(page, 28, crc);
    return page;
}

fn pbdb_decode_slotted_page(page_bytes, expected_page_id = nil, encryption_key = nil) {
    if not is_array(page_bytes) or len(page_bytes) != PAGE_SIZE {
        throw "pbdb: invalid page size (expected 4096 bytes)";
    }
    let m = 0;
    while m < 8 {
        if page_bytes[m] != PAGE_MAGIC[m] {
            throw "pbdb: invalid page magic header (expected PBDBv500)";
        }
        m = m + 1;
    }
    let expected_crc = _u32_le(page_bytes, 28);
    let actual_crc = _page_crc32c(page_bytes);
    let encrypted = bit_and(page_bytes[9], 1) != 0;
    let key32 = _derive_key32(encryption_key);

    if encrypted {
        if key32 == nil {
            throw "pbdb: encrypted page requires encryption_key";
        }
        // Verify AEAD authentication BEFORE or alongside CRC32C so tamper/wrong-key always rejects
        let nonce12 = slice(page_bytes, 32, 44);
        let tag32 = slice(page_bytes, 44, 76);
        let ct = slice(page_bytes, 76, PAGE_SIZE);
        let aad = slice(page_bytes, 0, 28);
        _append_bytes(aad, nonce12);
        let body = _aead_open_bytes(ct, key32, nonce12, tag32, aad);
        if expected_crc != actual_crc {
            throw "pbdb: page CRC32C checksum mismatch";
        }
        let pid = _u32_le(page_bytes, 12);
        if expected_page_id != nil and pid != expected_page_id {
            throw "pbdb: page_id mismatch";
        }
        let scnt = _u16_le(body, 0);
        let cells = [];
        let s = 0;
        while s < scnt {
            let coff = _u16_le(body, 2 + s * 4);
            let clen = _u16_le(body, 2 + s * 4 + 2);
            if coff + clen > len(body) { throw "pbdb: corrupted encrypted slot bounds"; }
            array_push(cells, slice(body, coff, coff + clen));
            s = s + 1;
        }
        return map{
            page_id: pid,
            page_type: page_bytes[8],
            encrypted: true,
            lsn_txid: _u32_le(page_bytes, 16),
            crc32c: expected_crc,
            cells: cells
        };
    }

    if key32 != nil {
        throw "pbdb: encryption_key provided for unencrypted page";
    }
    if expected_crc != actual_crc {
        throw "pbdb: page CRC32C checksum mismatch on page " + str(_u32_le(page_bytes, 12));
    }
    let pid2 = _u32_le(page_bytes, 12);
    if expected_page_id != nil and pid2 != expected_page_id {
        throw "pbdb: page_id mismatch";
    }
    let scnt2 = _u16_le(page_bytes, 10);
    let body2 = slice(page_bytes, 32, PAGE_SIZE);
    let cells2 = [];
    let s2 = 0;
    while s2 < scnt2 {
        let coff2 = _u16_le(body2, s2 * 4);
        let clen2 = _u16_le(body2, s2 * 4 + 2);
        if coff2 + clen2 > len(body2) { throw "pbdb: corrupted slot bounds"; }
        array_push(cells2, slice(body2, coff2, coff2 + clen2));
        s2 = s2 + 1;
    }
    return map{
        page_id: pid2,
        page_type: page_bytes[8],
        encrypted: false,
        lsn_txid: _u32_le(page_bytes, 16),
        crc32c: expected_crc,
        cells: cells2
    };
}

// ============================================================================
// 3. Ordered `B+Tree` Primary / Secondary Index ($O(\log N)$ Lookup & Range Scan)
// ============================================================================

fn _cmp_sql_val(a, b) {
    if a == nil and b == nil { return 0; }
    if a == nil { return -1; }
    if b == nil { return 1; }
    if type(a) == "number" and type(b) == "number" {
        if a < b { return -1; }
        if a > b { return 1; }
        return 0;
    }
    let sa = str(a);
    let sb = str(b);
    if sa == sb { return 0; }
    let na = len(sa);
    let nb = len(sb);
    let lim = num_min(na, nb);
    let i = 0;
    while i < lim {
        let ca = strcharcodeat(sa, i);
        let cb = strcharcodeat(sb, i);
        if ca < cb { return -1; }
        if ca > cb { return 1; }
        i = i + 1;
    }
    return if na < nb { -1 } else { 1 };
}

fn pbdb_btree_new(order = 8) {
    let leaf = map{ is_leaf: true, keys: [], buckets: [], next_leaf: nil };
    return map{ order: _clamp(order, 4, 64), root: leaf, height: 1, entry_count: 0 };
}

fn _btree_lower_bound(keys, target) {
    let lo = 0;
    let hi = len(keys);
    while lo < hi {
        let mid = num_floor((lo + hi) / 2);
        if _cmp_sql_val(keys[mid], target) < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn _btree_insert_at(arr, pos, item) {
    let out = [];
    let i = 0;
    while i < pos { array_push(out, arr[i]); i = i + 1; }
    array_push(out, item);
    while i < len(arr) { array_push(out, arr[i]); i = i + 1; }
    return out;
}

fn _btree_insert_rec(node, key, row_id, max_keys) {
    if node.is_leaf {
        let pos = _btree_lower_bound(node.keys, key);
        if pos < len(node.keys) and _cmp_sql_val(node.keys[pos], key) == 0 {
            let bkt = node.buckets[pos];
            let k = 0;
            while k < len(bkt) {
                if bkt[k] == row_id { return nil; }
                k = k + 1;
            }
            array_push(bkt, row_id);
            return nil;
        }
        node.keys = _btree_insert_at(node.keys, pos, key);
        node.buckets = _btree_insert_at(node.buckets, pos, [row_id]);
        if len(node.keys) <= max_keys { return nil; }

        let mid = num_floor(len(node.keys) / 2);
        let right_leaf = map{
            is_leaf: true,
            keys: slice(node.keys, mid, len(node.keys)),
            buckets: slice(node.buckets, mid, len(node.buckets)),
            next_leaf: node.next_leaf
        };
        node.keys = slice(node.keys, 0, mid);
        node.buckets = slice(node.buckets, 0, mid);
        node.next_leaf = right_leaf;
        return map{ sep_key: right_leaf.keys[0], right_node: right_leaf };
    }

    // Internal routing node: find child branch
    let c_idx = 0;
    while c_idx < len(node.keys) and _cmp_sql_val(key, node.keys[c_idx]) >= 0 {
        c_idx = c_idx + 1;
    }
    let split = _btree_insert_rec(node.children[c_idx], key, row_id, max_keys);
    if split == nil { return nil; }

    node.keys = _btree_insert_at(node.keys, c_idx, split.sep_key);
    node.children = _btree_insert_at(node.children, c_idx + 1, split.right_node);
    if len(node.keys) <= max_keys { return nil; }

    let mid_i = num_floor(len(node.keys) / 2);
    let up_key = node.keys[mid_i];
    let right_int = map{
        is_leaf: false,
        keys: slice(node.keys, mid_i + 1, len(node.keys)),
        children: slice(node.children, mid_i + 1, len(node.children))
    };
    node.keys = slice(node.keys, 0, mid_i);
    node.children = slice(node.children, 0, mid_i + 1);
    return map{ sep_key: up_key, right_node: right_int };
}

fn pbdb_btree_insert(tree, key, row_id) {
    let sp = _btree_insert_rec(tree.root, key, row_id, tree.order);
    tree.entry_count = tree.entry_count + 1;
    if sp != nil {
        tree.root = map{
            is_leaf: false,
            keys: [sp.sep_key],
            children: [tree.root, sp.right_node]
        };
        tree.height = tree.height + 1;
    }
    return tree;
}

fn _btree_find_leaf(node, key) {
    let cur = node;
    while not cur.is_leaf {
        let idx = 0;
        while idx < len(cur.keys) and _cmp_sql_val(key, cur.keys[idx]) >= 0 {
            idx = idx + 1;
        }
        cur = cur.children[idx];
    }
    return cur;
}

fn pbdb_btree_search(tree, key) {
    let leaf = _btree_find_leaf(tree.root, key);
    let pos = _btree_lower_bound(leaf.keys, key);
    if pos < len(leaf.keys) and _cmp_sql_val(leaf.keys[pos], key) == 0 {
        return slice(leaf.buckets[pos], 0, len(leaf.buckets[pos]));
    }
    return [];
}

fn pbdb_btree_range(tree, min_key, min_inc, max_key, max_inc) {
    let leaf = if min_key == nil {
        let cur = tree.root;
        while not cur.is_leaf { cur = cur.children[0]; }
        cur
    } else {
        _btree_find_leaf(tree.root, min_key)
    };
    let out_ids = [];
    while leaf != nil {
        let i = 0;
        while i < len(leaf.keys) {
            let k = leaf.keys[i];
            let ge_ok = if min_key == nil { true }
                elif min_inc { _cmp_sql_val(k, min_key) >= 0 }
                else { _cmp_sql_val(k, min_key) > 0 };
            let le_ok = if max_key == nil { true }
                elif max_inc { _cmp_sql_val(k, max_key) <= 0 }
                else { _cmp_sql_val(k, max_key) < 0 };
            if not le_ok and max_key != nil {
                return out_ids;
            }
            if ge_ok and le_ok {
                _append_bytes(out_ids, leaf.buckets[i]);
            }
            i = i + 1;
        }
        leaf = leaf.next_leaf;
    }
    return out_ids;
}

// ============================================================================
// 4. Write-Ahead Log (`WAL`) Binary Framing & Atomic Crash Recovery
// ============================================================================

fn _encode_wal_header(encrypted) {
    let h = [];
    _append_bytes(h, WAL_MAGIC);
    array_push(h, if encrypted { 1 } else { 0 });
    array_push(h, 0); array_push(h, 0); array_push(h, 0);
    _push_u32_le(h, crc32c_bytes(h));
    return h; // 16 bytes
}

fn _encode_wal_frame(seq_no, tx_id, op_kind, payload_obj, key32) {
    let raw_payload = str_to_bytes(json_stringify(payload_obj));
    let frame = [];
    _append_bytes(frame, WAL_FRAME_MAGIC); // [0..3] "WALF"
    _push_u32_le(frame, seq_no);           // [4..7]
    _push_u32_le(frame, tx_id);            // [8..11]
    array_push(frame, op_kind);            // [12]
    array_push(frame, if key32 != nil { 1 } else { 0 }); // [13] encrypted flag

    let wire_body = raw_payload;
    if key32 != nil {
        let nonce12 = random_bytes(12);
        let aad = slice(frame, 0, 14);
        _append_bytes(aad, nonce12);
        let sealed = _aead_seal_bytes(raw_payload, key32, nonce12, aad);
        wire_body = [];
        _append_bytes(wire_body, nonce12);
        _append_bytes(wire_body, sealed.tag32);
        _append_bytes(wire_body, sealed.ciphertext);
    }
    _push_u32_le(frame, len(wire_body));   // [14..17] payload_len
    let crc_input = slice(frame, 0, 18);
    _append_bytes(crc_input, wire_body);
    _push_u32_le(frame, crc32c_bytes(crc_input)); // [18..21] frame_crc32c
    _append_bytes(frame, wire_body);       // [22 .. 22+payload_len]
    return frame;
}

// ============================================================================
// 5. MVCC Storage Engine, Paged Disk Persistence & WAL Replay
// ============================================================================

fn _rebuild_table_indexes(tbl, snap_tx) {
    let idx_cols = map_keys(tbl.indexes);
    let ic = 0;
    while ic < len(idx_cols) {
        let col = idx_cols[ic];
        let bt = pbdb_btree_new(8);
        let r = 0;
        while r < len(tbl.tuples) {
            let tup = tbl.tuples[r];
            if tup.xmin <= snap_tx and (tup.xmax == 0 or tup.xmax > snap_tx) {
                if map_has(tup.data, col) {
                    pbdb_btree_insert(bt, tup.data[col], tup.row_id);
                }
            }
            r = r + 1;
        }
        tbl.indexes[col] = bt;
        ic = ic + 1;
    }
}

fn _apply_wal_mutation(db, mut_rec, commit_txid) {
    let act = str(_opt(mut_rec, "action", ""));
    let tname = str(_opt(mut_rec, "table", ""));
    if act == "create_table" {
        let cols = _opt(mut_rec, "columns", []);
        let pk = _opt(mut_rec, "pk", nil);
        let idxs = map{};
        if pk != nil and pk != "" { idxs[pk] = pbdb_btree_new(8); }
        db.tables[tname] = map{
            name: tname,
            columns: cols,
            pk: pk,
            next_rowid: 1,
            tuples: [],
            indexes: idxs
        };
    } elif act == "create_index" {
        if map_has(db.tables, tname) {
            let col = str(_opt(mut_rec, "column", ""));
            db.tables[tname].indexes[col] = pbdb_btree_new(8);
            _rebuild_table_indexes(db.tables[tname], commit_txid);
        }
    } elif act == "insert" and map_has(db.tables, tname) {
        let tbl = db.tables[tname];
        let rid = _opt(mut_rec, "row_id", tbl.next_rowid);
        if rid >= tbl.next_rowid { tbl.next_rowid = rid + 1; }
        let row_data = _opt(mut_rec, "data", map{});
        array_push(tbl.tuples, map{ row_id: rid, xmin: commit_txid, xmax: 0, data: row_data });
        let iks = map_keys(tbl.indexes);
        let k = 0;
        while k < len(iks) {
            if map_has(row_data, iks[k]) {
                pbdb_btree_insert(tbl.indexes[iks[k]], row_data[iks[k]], rid);
            }
            k = k + 1;
        }
    } elif act == "update" and map_has(db.tables, tname) {
        let tbl = db.tables[tname];
        let rid = _opt(mut_rec, "row_id", 0);
        let new_data = _opt(mut_rec, "data", map{});
        let ti = 0;
        while ti < len(tbl.tuples) {
            let t = tbl.tuples[ti];
            if t.row_id == rid and t.xmax == 0 {
                t.xmax = commit_txid;
            }
            ti = ti + 1;
        }
        array_push(tbl.tuples, map{ row_id: rid, xmin: commit_txid, xmax: 0, data: new_data });
        _rebuild_table_indexes(tbl, commit_txid);
    } elif act == "delete" and map_has(db.tables, tname) {
        let tbl = db.tables[tname];
        let rid = _opt(mut_rec, "row_id", 0);
        let ti = 0;
        while ti < len(tbl.tuples) {
            if tbl.tuples[ti].row_id == rid and tbl.tuples[ti].xmax == 0 {
                tbl.tuples[ti].xmax = commit_txid;
            }
            ti = ti + 1;
        }
        _rebuild_table_indexes(tbl, commit_txid);
    }
}

fn pbdb_flush(db) {
    // Pack catalog (page 0) + committed row cells across 4096-byte slotted pages
    let cat_tables = map{};
    let tnames = map_keys(db.tables);
    let i = 0;
    while i < len(tnames) {
        let tbl = db.tables[tnames[i]];
        cat_tables[tnames[i]] = map{
            columns: tbl.columns,
            pk: tbl.pk,
            next_rowid: tbl.next_rowid,
            index_cols: map_keys(tbl.indexes)
        };
        i = i + 1;
    }

    let data_cells = [];
    i = 0;
    while i < len(tnames) {
        let tbl = db.tables[tnames[i]];
        let j = 0;
        while j < len(tbl.tuples) {
            let tup = tbl.tuples[j];
            if tup.xmin <= db.commit_txid and tup.xmax == 0 {
                let cell_bytes = str_to_bytes(json_stringify(map{
                    t: tnames[i],
                    r: tup.row_id,
                    xmin: tup.xmin,
                    d: tup.data
                }));
                array_push(data_cells, cell_bytes);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Partition data_cells into 4096-byte slotted pages (Page 1..N)
    let data_pages = [];
    let cur_batch = [];
    let cur_bytes = 0;
    let max_body = if db.key32 != nil { 3980 } else { 4020 };
    let ci = 0;
    while ci < len(data_cells) {
        let c = data_cells[ci];
        if len(cur_batch) > 0 and (cur_bytes + len(c) + 4) > max_body {
            let pid = len(data_pages) + 1;
            array_push(data_pages, pbdb_encode_slotted_page(pid, PAGE_TYPE_DATA, db.commit_txid, cur_batch, db.key32));
            cur_batch = [];
            cur_bytes = 0;
        }
        array_push(cur_batch, c);
        cur_bytes = cur_bytes + len(c) + 4;
        ci = ci + 1;
    }
    if len(cur_batch) > 0 {
        let pid_last = len(data_pages) + 1;
        array_push(data_pages, pbdb_encode_slotted_page(pid_last, PAGE_TYPE_DATA, db.commit_txid, cur_batch, db.key32));
    }

    let super_cell = str_to_bytes(json_stringify(map{
        version: PBDB_VERSION,
        commit_txid: db.commit_txid,
        data_page_count: len(data_pages),
        catalog: cat_tables
    }));
    let page0 = pbdb_encode_slotted_page(0, PAGE_TYPE_SUPER, db.commit_txid, [super_cell], db.key32);

    let full_image = [];
    _append_bytes(full_image, page0);
    let pi = 0;
    while pi < len(data_pages) {
        _append_bytes(full_image, data_pages[pi]);
        pi = pi + 1;
    }
    db.paged_bytes = full_image;
    db.page_count = 1 + len(data_pages);
    if db.path != "" and db.path != ":memory:" {
        fs_write_bytes(db.path, full_image);
        fs_write_bytes(db.wal_path, db.wal_bytes);
    }
    return map{ ok: true, page_count: db.page_count, total_bytes: len(full_image) };
}

fn _load_paged_image_into_db(db, raw_bytes) {
    if len(raw_bytes) < PAGE_SIZE or num_mod(len(raw_bytes), PAGE_SIZE) != 0 {
        throw "pbdb: database file length is not a multiple of 4096-byte page size";
    }
    let p0 = pbdb_decode_slotted_page(slice(raw_bytes, 0, PAGE_SIZE), 0, db.key32);
    if len(p0.cells) == 0 { throw "pbdb: superblock page 0 missing catalog cell"; }
    let meta = json_parse(bytes_to_str(p0.cells[0]));
    db.commit_txid = _opt(meta, "commit_txid", 1);
    db.next_txid = db.commit_txid + 1;
    db.tables = map{};

    let cat = _opt(meta, "catalog", map{});
    let tks = map_keys(cat);
    let i = 0;
    while i < len(tks) {
        let tn = tks[i];
        let spec = cat[tn];
        let idxs = map{};
        let icols = _opt(spec, "index_cols", []);
        let k = 0;
        while k < len(icols) { idxs[icols[k]] = pbdb_btree_new(8); k = k + 1; }
        db.tables[tn] = map{
            name: tn,
            columns: spec.columns,
            pk: spec.pk,
            next_rowid: spec.next_rowid,
            tuples: [],
            indexes: idxs
        };
        i = i + 1;
    }

    let total_pages = num_floor(len(raw_bytes) / PAGE_SIZE);
    let p = 1;
    while p < total_pages {
        let pg = pbdb_decode_slotted_page(slice(raw_bytes, p * PAGE_SIZE, (p + 1) * PAGE_SIZE), p, db.key32);
        let c = 0;
        while c < len(pg.cells) {
            let rec = json_parse(bytes_to_str(pg.cells[c]));
            let tbl = db.tables[rec.t];
            array_push(tbl.tuples, map{ row_id: rec.r, xmin: rec.xmin, xmax: 0, data: rec.d });
            c = c + 1;
        }
        p = p + 1;
    }
    i = 0;
    while i < len(tks) {
        _rebuild_table_indexes(db.tables[tks[i]], db.commit_txid);
        i = i + 1;
    }
    db.paged_bytes = raw_bytes;
    db.page_count = total_pages;
}

fn pbdb_recover_wal(db, wal_bytes_override = nil) {
    let wbytes = if is_array(wal_bytes_override) {
        wal_bytes_override
    } elif db.path != "" and db.path != ":memory:" and fs_exists(db.wal_path) {
        fs_read_bytes(db.wal_path)
    } else {
        db.wal_bytes
    };

    if not is_array(wbytes) or len(wbytes) < 16 {
        return map{ ok: true, committed_tx_replayed: 0, rolled_back_uncommitted_tx: 0, discarded_torn_tail_frames: 0 };
    }
    let m = 0;
    while m < 8 {
        if wbytes[m] != WAL_MAGIC[m] { throw "pbdb: invalid WAL magic header"; }
        m = m + 1;
    }
    if _u32_le(wbytes, 12) != crc32c_bytes(slice(wbytes, 0, 12)) {
        throw "pbdb: corrupted WAL file header CRC32C";
    }

    let tx_ops = map{};
    let committed_txids = [];
    let rolled_back_cnt = 0;
    let torn_frames = 0;
    let pos = 16;
    let total = len(wbytes);

    while pos < total {
        if pos + 22 > total {
            // Torn/truncated tail WAL frame header from simulated power loss!
            torn_frames = torn_frames + 1;
            break;
        }
        if wbytes[pos] != 87 or wbytes[pos + 1] != 65 or wbytes[pos + 2] != 76 or wbytes[pos + 3] != 70 {
            torn_frames = torn_frames + 1;
            break;
        }
        let tx_id = _u32_le(wbytes, pos + 8);
        let op_kind = wbytes[pos + 12];
        let enc_flag = wbytes[pos + 13];
        let plen = _u32_le(wbytes, pos + 14);
        let expected_crc = _u32_le(wbytes, pos + 18);
        if pos + 22 + plen > total {
            // Torn tail payload! Stop cleanly at last intact frame
            torn_frames = torn_frames + 1;
            break;
        }
        let wire_body = slice(wbytes, pos + 22, pos + 22 + plen);
        let crc_check_buf = slice(wbytes, pos, pos + 18);
        _append_bytes(crc_check_buf, wire_body);
        if crc32c_bytes(crc_check_buf) != expected_crc {
            // Corrupted tail frame checksum! Discard torn/corrupted tail safely
            torn_frames = torn_frames + 1;
            break;
        }

        let plain_body = wire_body;
        if enc_flag == 1 {
            if db.key32 == nil { throw "pbdb: encrypted WAL requires encryption_key"; }
            if len(wire_body) < 44 { torn_frames = torn_frames + 1; break; }
            let n12 = slice(wire_body, 0, 12);
            let t32 = slice(wire_body, 12, 44);
            let ct = slice(wire_body, 44, len(wire_body));
            let aad = slice(wbytes, pos, pos + 14);
            _append_bytes(aad, n12);
            let dec_res = try map{ ok: true, v: _aead_open_bytes(ct, db.key32, n12, t32, aad) } catch map{ ok: false, v: nil };
            if not dec_res.ok {
                // Distinguish wrong key on frame 0 vs torn tail frame
                if pos == 16 and len(committed_txids) == 0 {
                    throw "pbdb: WAL AEAD authentication failed (wrong key or tampered first frame)";
                }
                torn_frames = torn_frames + 1;
                break;
            }
            plain_body = dec_res.v;
        }

        let payload_obj = json_parse(bytes_to_str(plain_body));
        let tk = str(tx_id);
        if op_kind == WAL_OP_BEGIN {
            tx_ops[tk] = [];
        } elif op_kind == WAL_OP_MUTATE {
            if not map_has(tx_ops, tk) { tx_ops[tk] = []; }
            array_push(tx_ops[tk], payload_obj);
        } elif op_kind == WAL_OP_COMMIT {
            array_push(committed_txids, tx_id);
        } elif op_kind == WAL_OP_ROLLBACK {
            if map_has(tx_ops, tk) { map_remove(tx_ops, tk); }
            rolled_back_cnt = rolled_back_cnt + 1;
        }
        pos = pos + 22 + plen;
    }

    // Count uncommitted in-flight transactions discarded by crash recovery
    let all_tx_keys = map_keys(tx_ops);
    let replayed = 0;
    let ci = 0;
    while ci < len(committed_txids) {
        let ctx_id = committed_txids[ci];
        if ctx_id > db.commit_txid and map_has(tx_ops, str(ctx_id)) {
            let muts = tx_ops[str(ctx_id)];
            let mi = 0;
            while mi < len(muts) {
                _apply_wal_mutation(db, muts[mi], ctx_id);
                mi = mi + 1;
            }
            db.commit_txid = ctx_id;
            if ctx_id >= db.next_txid { db.next_txid = ctx_id + 1; }
            replayed = replayed + 1;
        }
        ci = ci + 1;
    }

    let uk = 0;
    while uk < len(all_tx_keys) {
        let tid_num = num_floor(parse_number(all_tx_keys[uk]));
        let was_committed = false;
        let cscan = 0;
        while cscan < len(committed_txids) {
            if committed_txids[cscan] == tid_num { was_committed = true; break; }
            cscan = cscan + 1;
        }
        if not was_committed { rolled_back_cnt = rolled_back_cnt + 1; }
        uk = uk + 1;
    }

    return map{
        ok: true,
        committed_tx_replayed: replayed,
        rolled_back_uncommitted_tx: rolled_back_cnt,
        discarded_torn_tail_frames: torn_frames
    };
}

fn pbdb_open(path_or_opts = nil, opts = nil) {
    let path = ":memory:";
    let o = map{};
    if is_string(path_or_opts) {
        path = path_or_opts;
        if is_map(opts) { o = opts; }
    } elif is_map(path_or_opts) {
        o = path_or_opts;
        path = str(_opt(o, "path", ":memory:"));
    }
    let key32 = _derive_key32(_opt(o, "encryption_key", nil));
    let wal_path = if path != "" and path != ":memory:" { path + ".wal" } else { "" };

    let db = map{
        format: "pblang.pbdb.v5",
        version: PBDB_VERSION,
        path: path,
        wal_path: wal_path,
        key32: key32,
        encrypted: key32 != nil,
        commit_txid: 1,
        next_txid: 2,
        wal_seq: 0,
        wal_bytes: _encode_wal_header(key32 != nil),
        paged_bytes: [],
        page_count: 0,
        tables: map{},
        active_tx: nil,
        fts_indexes: map{},
        vector_indexes: map{}
    };

    if is_array(_opt(o, "initial_paged_bytes", nil)) {
        _load_paged_image_into_db(db, o.initial_paged_bytes);
    } elif path != "" and path != ":memory:" and fs_exists(path) {
        _load_paged_image_into_db(db, fs_read_bytes(path));
    }
    if path != "" and path != ":memory:" and fs_exists(wal_path) {
        pbdb_recover_wal(db, fs_read_bytes(wal_path));
    }
    return db;
}

fn _wal_append(db, tx_id, op_kind, payload_obj) {
    db.wal_seq = db.wal_seq + 1;
    let frm = _encode_wal_frame(db.wal_seq, tx_id, op_kind, payload_obj, db.key32);
    _append_bytes(db.wal_bytes, frm);
    if db.path != "" and db.path != ":memory:" {
        fs_write_bytes(db.wal_path, db.wal_bytes);
    }
}

fn pbdb_begin(db) {
    if db.active_tx != nil { throw "pbdb: transaction already active"; }
    let tx_id = db.next_txid;
    db.next_txid = db.next_txid + 1;
    db.active_tx = map{
        tx_id: tx_id,
        snapshot_txid: db.commit_txid,
        staged_ops: [],
        overlay_inserts: map{},
        overlay_updates: map{},
        overlay_deletes: map{}
    };
    _wal_append(db, tx_id, WAL_OP_BEGIN, map{ ts: tx_id });
    return tx_id;
}

fn pbdb_commit(db) {
    if db.active_tx == nil { throw "pbdb: no active transaction to commit"; }
    let tx = db.active_tx;
    db.active_tx = nil;
    _wal_append(db, tx.tx_id, WAL_OP_COMMIT, map{ ops: len(tx.staged_ops) });
    let i = 0;
    while i < len(tx.staged_ops) {
        _apply_wal_mutation(db, tx.staged_ops[i], tx.tx_id);
        i = i + 1;
    }
    db.commit_txid = tx.tx_id;
    pbdb_flush(db);
    return map{ ok: true, committed_txid: tx.tx_id, mutations: len(tx.staged_ops) };
}

fn pbdb_rollback(db) {
    if db.active_tx == nil { return map{ ok: true, rolled_back: false }; }
    let tx = db.active_tx;
    db.active_tx = nil;
    _wal_append(db, tx.tx_id, WAL_OP_ROLLBACK, map{ discarded: len(tx.staged_ops) });
    return map{ ok: true, rolled_back: true, tx_id: tx.tx_id };
}

fn _record_or_commit_mutation(db, mut_rec) {
    if db.active_tx != nil {
        let tx = db.active_tx;
        array_push(tx.staged_ops, mut_rec);
        _wal_append(db, tx.tx_id, WAL_OP_MUTATE, mut_rec);
        let tname = mut_rec.table;
        let act = mut_rec.action;
        if act == "insert" {
            if not map_has(tx.overlay_inserts, tname) { tx.overlay_inserts[tname] = []; }
            array_push(tx.overlay_inserts[tname], map{ row_id: mut_rec.row_id, data: mut_rec.data });
        } elif act == "update" {
            if not map_has(tx.overlay_updates, tname) { tx.overlay_updates[tname] = map{}; }
            tx.overlay_updates[tname][str(mut_rec.row_id)] = mut_rec.data;
        } elif act == "delete" {
            if not map_has(tx.overlay_deletes, tname) { tx.overlay_deletes[tname] = map{}; }
            tx.overlay_deletes[tname][str(mut_rec.row_id)] = true;
        }
        return;
    }
    // Autocommit single-statement ACID transaction
    let tx_id = db.next_txid;
    db.next_txid = db.next_txid + 1;
    _wal_append(db, tx_id, WAL_OP_BEGIN, map{ auto: true });
    _wal_append(db, tx_id, WAL_OP_MUTATE, mut_rec);
    _wal_append(db, tx_id, WAL_OP_COMMIT, map{ ops: 1 });
    _apply_wal_mutation(db, mut_rec, tx_id);
    db.commit_txid = tx_id;
    pbdb_flush(db);
}

fn _visible_rows_for_table(db, tname, candidate_rids = nil) {
    if not map_has(db.tables, tname) { throw "pbdb: unknown table '" + tname + "'"; }
    let tbl = db.tables[tname];
    let tx = db.active_tx;
    let snap = if tx != nil { tx.snapshot_txid } else { db.commit_txid };
    let del_map = if tx != nil and map_has(tx.overlay_deletes, tname) { tx.overlay_deletes[tname] } else { map{} };
    let upd_map = if tx != nil and map_has(tx.overlay_updates, tname) { tx.overlay_updates[tname] } else { map{} };

    let rid_filter = nil;
    if is_array(candidate_rids) and tx == nil {
        rid_filter = map{};
        let f = 0;
        while f < len(candidate_rids) { rid_filter[str(candidate_rids[f])] = true; f = f + 1; }
    }

    let out = [];
    let seen_rids = map{};
    let i = 0;
    while i < len(tbl.tuples) {
        let tup = tbl.tuples[i];
        let rk = str(tup.row_id);
        if rid_filter == nil or map_has(rid_filter, rk) {
            if tup.xmin <= snap and (tup.xmax == 0 or tup.xmax > snap) and not map_has(del_map, rk) {
                let d = if map_has(upd_map, rk) { upd_map[rk] } else { tup.data };
                array_push(out, map{ row_id: tup.row_id, data: _copy_map(d) });
                seen_rids[rk] = true;
            }
        }
        i = i + 1;
    }

    if tx != nil and map_has(tx.overlay_inserts, tname) {
        let ins = tx.overlay_inserts[tname];
        let j = 0;
        while j < len(ins) {
            let rk2 = str(ins[j].row_id);
            if not map_has(del_map, rk2) {
                let d2 = if map_has(upd_map, rk2) { upd_map[rk2] } else { ins[j].data };
                array_push(out, map{ row_id: ins[j].row_id, data: _copy_map(d2) });
            }
            j = j + 1;
        }
    }
    return out;
}

// ============================================================================
// 6. SQL Tokenizer, Parser & Relational Executor (`JOIN`, `GROUP BY`, `B+Tree`)
// ============================================================================

fn _sql_tokens(sql) {
    let toks = [];
    let s = str(sql);
    let n = len(s);
    let i = 0;
    let p_idx = 0;
    while i < n {
        let cp = strcharcodeat(s, i);
        if cp <= 32 { i = i + 1; continue; }
        let ch = str_slice(s, i, i + 1);
        if ch == "'" {
            let lit = "";
            i = i + 1;
            while i < n {
                let c2 = str_slice(s, i, i + 1);
                if c2 == "'" {
                    if i + 1 < n and str_slice(s, i + 1, i + 2) == "'" { lit = lit + "'"; i = i + 2; continue; }
                    i = i + 1; break;
                }
                lit = lit + c2; i = i + 1;
            }
            array_push(toks, map{ k: "STR", v: lit, u: lit });
            continue;
        }
        if ch == "?" {
            array_push(toks, map{ k: "PARAM", idx: p_idx, u: "?" });
            p_idx = p_idx + 1; i = i + 1; continue;
        }
        if ch == "$" and i + 1 < n and strcharcodeat(s, i + 1) >= 49 and strcharcodeat(s, i + 1) <= 57 {
            i = i + 1;
            let ds = "";
            while i < n and strcharcodeat(s, i) >= 48 and strcharcodeat(s, i) <= 57 {
                ds = ds + str_slice(s, i, i + 1); i = i + 1;
            }
            array_push(toks, map{ k: "PARAM", idx: num_floor(parse_number(ds)) - 1, u: "$" + ds });
            continue;
        }
        if (cp >= 48 and cp <= 57) or (ch == "-" and i + 1 < n and strcharcodeat(s, i + 1) >= 48 and strcharcodeat(s, i + 1) <= 57) {
            let ns = ch; i = i + 1;
            while i < n {
                let nc = strcharcodeat(s, i);
                if (nc >= 48 and nc <= 57) or nc == 46 { ns = ns + str_slice(s, i, i + 1); i = i + 1; }
                else { break; }
            }
            array_push(toks, map{ k: "NUM", v: parse_number(ns), u: ns });
            continue;
        }
        if i + 1 < n {
            let two = str_slice(s, i, i + 2);
            if two == ">=" or two == "<=" or two == "!=" or two == "<>" {
                array_push(toks, map{ k: "OP", v: two, u: two });
                i = i + 2; continue;
            }
        }
        if ch == "(" or ch == ")" or ch == "," or ch == "=" or ch == "<" or ch == ">" or ch == "*" or ch == ";" {
            array_push(toks, map{ k: "SYM", v: ch, u: ch });
            i = i + 1; continue;
        }
        let id = "";
        while i < n {
            let ic = strcharcodeat(s, i);
            let ich = str_slice(s, i, i + 1);
            if ic <= 32 or ich == "(" or ich == ")" or ich == "," or ich == "=" or ich == "<" or ich == ">" or ich == ";" or ich == "'" {
                break;
            }
            id = id + ich; i = i + 1;
        }
        let clean_id = str_replace_all(id, "\"", "");
        array_push(toks, map{ k: "ID", v: clean_id, u: str_upper(clean_id) });
    }
    return toks;
}

fn _resolve_col(row_map, col_ref) {
    if map_has(row_map, col_ref) { return row_map[col_ref]; }
    let dot = str_index_of(col_ref, ".");
    if dot >= 0 {
        let short_c = str_slice(col_ref, dot + 1, len(col_ref));
        if map_has(row_map, short_c) { return row_map[short_c]; }
    }
    return nil;
}

fn _tok_val(tok, params, row_map) {
    if tok.k == "NUM" or tok.k == "STR" { return tok.v; }
    if tok.k == "PARAM" {
        if not is_array(params) or tok.idx >= len(params) { throw "pbdb: missing bound SQL parameter"; }
        return params[tok.idx];
    }
    if tok.u == "NULL" { return nil; }
    if tok.u == "TRUE" { return true; }
    if tok.u == "FALSE" { return false; }
    if row_map != nil { return _resolve_col(row_map, tok.v); }
    return tok.v;
}

fn _like_pattern_test(val_s, pat_s) {
    if pat_s == "%" { return true; }
    let starts_pct = str_starts_with(pat_s, "%");
    let ends_pct = str_ends_with(pat_s, "%");
    let core = str_replace_all(pat_s, "%", "");
    if starts_pct and ends_pct { return str_contains(val_s, core); }
    if starts_pct { return str_ends_with(val_s, core); }
    if ends_pct { return str_starts_with(val_s, core); }
    return val_s == core;
}

fn _eval_where_tokens(wtoks, params, row_map) {
    if len(wtoks) == 0 { return true; }
    // Split OR at top level, then AND
    let or_pos = -1;
    let i = 0;
    while i < len(wtoks) {
        if wtoks[i].u == "OR" { or_pos = i; break; }
        i = i + 1;
    }
    if or_pos >= 0 {
        return _eval_where_tokens(slice(wtoks, 0, or_pos), params, row_map)
            or _eval_where_tokens(slice(wtoks, or_pos + 1, len(wtoks)), params, row_map);
    }
    let and_pos = -1;
    i = 0;
    while i < len(wtoks) {
        if wtoks[i].u == "AND" and (i < 2 or wtoks[i - 2].u != "BETWEEN") {
            and_pos = i; break;
        }
        i = i + 1;
    }
    if and_pos >= 0 {
        return _eval_where_tokens(slice(wtoks, 0, and_pos), params, row_map)
            and _eval_where_tokens(slice(wtoks, and_pos + 1, len(wtoks)), params, row_map);
    }
    if wtoks[0].u == "NOT" {
        return not _eval_where_tokens(slice(wtoks, 1, len(wtoks)), params, row_map);
    }
    let lhs = _tok_val(wtoks[0], params, row_map);
    if len(wtoks) >= 3 and wtoks[1].u == "IS" {
        if len(wtoks) >= 4 and wtoks[2].u == "NOT" and wtoks[3].u == "NULL" { return lhs != nil; }
        if wtoks[2].u == "NULL" { return lhs == nil; }
    }
    if len(wtoks) >= 5 and wtoks[1].u == "BETWEEN" and wtoks[3].u == "AND" {
        let lo = _tok_val(wtoks[2], params, row_map);
        let hi = _tok_val(wtoks[4], params, row_map);
        return _cmp_sql_val(lhs, lo) >= 0 and _cmp_sql_val(lhs, hi) <= 0;
    }
    if len(wtoks) >= 3 {
        let op = wtoks[1].u;
        let rhs = _tok_val(wtoks[2], params, row_map);
        if op == "LIKE" { return lhs != nil and _like_pattern_test(str(lhs), str(rhs)); }
        let c = _cmp_sql_val(lhs, rhs);
        if op == "=" { return lhs != nil and rhs != nil and c == 0; }
        if op == "!=" or op == "<>" { return lhs != nil and rhs != nil and c != 0; }
        if op == "<" { return lhs != nil and rhs != nil and c < 0; }
        if op == "<=" { return lhs != nil and rhs != nil and c <= 0; }
        if op == ">" { return lhs != nil and rhs != nil and c > 0; }
        if op == ">=" { return lhs != nil and rhs != nil and c >= 0; }
    }
    return lhs == true;
}

fn _try_btree_candidates(db, tname, wtoks, params) {
    if db.active_tx != nil or not map_has(db.tables, tname) { return nil; }
    let tbl = db.tables[tname];
    if len(wtoks) == 3 and wtoks[0].k == "ID" and map_has(tbl.indexes, wtoks[0].v) {
        let bt = tbl.indexes[wtoks[0].v];
        let op = wtoks[1].u;
        let val = _tok_val(wtoks[2], params, nil);
        if op == "=" { return pbdb_btree_search(bt, val); }
        if op == ">=" { return pbdb_btree_range(bt, val, true, nil, true); }
        if op == ">" { return pbdb_btree_range(bt, val, false, nil, true); }
        if op == "<=" { return pbdb_btree_range(bt, nil, true, val, true); }
        if op == "<" { return pbdb_btree_range(bt, nil, true, val, false); }
    }
    if len(wtoks) == 5 and wtoks[0].k == "ID" and wtoks[1].u == "BETWEEN" and wtoks[3].u == "AND" and map_has(tbl.indexes, wtoks[0].v) {
        let bt2 = tbl.indexes[wtoks[0].v];
        return pbdb_btree_range(bt2, _tok_val(wtoks[2], params, nil), true, _tok_val(wtoks[4], params, nil), true);
    }
    return nil;
}

fn _parse_select_items(stoks) {
    let items = [];
    let p = 0;
    while p < len(stoks) {
        if stoks[p].v == "," { p = p + 1; continue; }
        if stoks[p].v == "*" {
            array_push(items, map{ agg: "", col: "*", alias: "*" });
            p = p + 1; continue;
        }
        let u = stoks[p].u;
        if (u == "COUNT" or u == "SUM" or u == "AVG" or u == "MIN" or u == "MAX") and p + 3 < len(stoks) and stoks[p + 1].v == "(" {
            let arg_col = stoks[p + 2].v;
            p = p + 4; // FN ( col )
            let alias = str_lower(u) + (if arg_col == "*" { "" } else { "_" + arg_col });
            if p < len(stoks) and stoks[p].u == "AS" and p + 1 < len(stoks) {
                alias = stoks[p + 1].v; p = p + 2;
            } elif p < len(stoks) and stoks[p].k == "ID" and stoks[p].v != "," {
                alias = stoks[p].v; p = p + 1;
            }
            array_push(items, map{ agg: u, col: arg_col, alias: alias });
        } else {
            let col = stoks[p].v;
            let dot = str_index_of(col, ".");
            let alias = if dot >= 0 { str_slice(col, dot + 1, len(col)) } else { col };
            p = p + 1;
            if p < len(stoks) and stoks[p].u == "AS" and p + 1 < len(stoks) {
                alias = stoks[p + 1].v; p = p + 2;
            }
            array_push(items, map{ agg: "", col: col, alias: alias });
        }
    }
    return items;
}

fn _exec_select(db, toks, params) {
    // Locate major clause positions: FROM, JOIN, WHERE, GROUP BY, ORDER BY, LIMIT, OFFSET
    let from_pos = -1; let join_pos = -1; let join_kind = "";
    let where_pos = -1; let group_pos = -1; let order_pos = -1; let limit_pos = -1;
    let i = 1;
    while i < len(toks) {
        let u = toks[i].u;
        if u == "FROM" and from_pos < 0 { from_pos = i; }
        elif (u == "INNER" or u == "LEFT" or u == "JOIN") and join_pos < 0 {
            join_pos = i;
            join_kind = if u == "LEFT" { "LEFT" } else { "INNER" };
        }
        elif u == "WHERE" and where_pos < 0 { where_pos = i; }
        elif u == "GROUP" and i + 1 < len(toks) and toks[i + 1].u == "BY" and group_pos < 0 { group_pos = i; }
        elif u == "ORDER" and i + 1 < len(toks) and toks[i + 1].u == "BY" and order_pos < 0 { order_pos = i; }
        elif u == "LIMIT" and limit_pos < 0 { limit_pos = i; }
        i = i + 1;
    }

    let sel_items = _parse_select_items(slice(toks, 1, from_pos));
    let base_tbl = toks[from_pos + 1].v;
    let base_alias = base_tbl;
    if from_pos + 2 < len(toks) {
        let cand_a = toks[from_pos + 2];
        if cand_a.k == "ID" and cand_a.u != "WHERE" and cand_a.u != "INNER" and cand_a.u != "LEFT" and cand_a.u != "JOIN" and cand_a.u != "GROUP" and cand_a.u != "ORDER" and cand_a.u != "LIMIT" {
            base_alias = cand_a.v;
        }
    }

    let after_where_end = if group_pos >= 0 { group_pos } elif order_pos >= 0 { order_pos } elif limit_pos >= 0 { limit_pos } else { len(toks) };
    let wtoks = if where_pos >= 0 { slice(toks, where_pos + 1, after_where_end) } else { [] };

    let cand_rids = if join_pos < 0 { _try_btree_candidates(db, base_tbl, wtoks, params) } else { nil };
    let left_vis = _visible_rows_for_table(db, base_tbl, cand_rids);
    let working_rows = [];

    if join_pos >= 0 {
        let j_cur = join_pos;
        while j_cur < len(toks) and toks[j_cur].u != "JOIN" { j_cur = j_cur + 1; }
        let right_tbl = toks[j_cur + 1].v;
        let right_alias = right_tbl;
        let on_pos = j_cur + 2;
        if on_pos < len(toks) and toks[on_pos].u != "ON" {
            right_alias = toks[on_pos].v;
            on_pos = on_pos + 1;
        }
        let l_on_col = toks[on_pos + 1].v;
        let r_on_col = toks[on_pos + 3].v;
        let right_vis = _visible_rows_for_table(db, right_tbl, nil);
        let right_cols = db.tables[right_tbl].columns;

        let li = 0;
        while li < len(left_vis) {
            let lr = left_vis[li].data;
            let merged_base = map{};
            let lks = map_keys(lr);
            let lk = 0;
            while lk < len(lks) {
                merged_base[lks[lk]] = lr[lks[lk]];
                merged_base[base_alias + "." + lks[lk]] = lr[lks[lk]];
                lk = lk + 1;
            }
            let l_join_val = _resolve_col(merged_base, l_on_col);
            let matched = false;
            let ri = 0;
            while ri < len(right_vis) {
                let rr = right_vis[ri].data;
                let r_env = map{};
                let rks = map_keys(rr);
                let rk = 0;
                while rk < len(rks) {
                    r_env[rks[rk]] = rr[rks[rk]];
                    r_env[right_alias + "." + rks[rk]] = rr[rks[rk]];
                    rk = rk + 1;
                }
                let r_join_val = _resolve_col(r_env, r_on_col);
                if l_join_val != nil and r_join_val != nil and _cmp_sql_val(l_join_val, r_join_val) == 0 {
                    matched = true;
                    let comb = _copy_map(merged_base);
                    rk = 0;
                    while rk < len(rks) {
                        if not map_has(comb, rks[rk]) { comb[rks[rk]] = rr[rks[rk]]; }
                        comb[right_alias + "." + rks[rk]] = rr[rks[rk]];
                        rk = rk + 1;
                    }
                    array_push(working_rows, comb);
                }
                ri = ri + 1;
            }
            if not matched and join_kind == "LEFT" {
                let comb_null = _copy_map(merged_base);
                let rc = 0;
                while rc < len(right_cols) {
                    if not map_has(comb_null, right_cols[rc]) { comb_null[right_cols[rc]] = nil; }
                    comb_null[right_alias + "." + right_cols[rc]] = nil;
                    rc = rc + 1;
                }
                array_push(working_rows, comb_null);
            }
            li = li + 1;
        }
    } else {
        let li2 = 0;
        while li2 < len(left_vis) {
            let d = left_vis[li2].data;
            let env = _copy_map(d);
            let ks = map_keys(d);
            let m = 0;
            while m < len(ks) { env[base_alias + "." + ks[m]] = d[ks[m]]; m = m + 1; }
            array_push(working_rows, env);
            li2 = li2 + 1;
        }
    }

    // Filter WHERE
    let filtered = [];
    let fi = 0;
    while fi < len(working_rows) {
        if _eval_where_tokens(wtoks, params, working_rows[fi]) {
            array_push(filtered, working_rows[fi]);
        }
        fi = fi + 1;
    }

    // Check if aggregation or GROUP BY is active
    let has_agg = group_pos >= 0;
    let si = 0;
    while si < len(sel_items) {
        if sel_items[si].agg != "" { has_agg = true; }
        si = si + 1;
    }

    let projected = [];
    if has_agg {
        let grp_cols = [];
        if group_pos >= 0 {
            let gp_end = if order_pos >= 0 { order_pos } elif limit_pos >= 0 { limit_pos } else { len(toks) };
            let gp = group_pos + 2;
            while gp < gp_end {
                if toks[gp].v != "," { array_push(grp_cols, toks[gp].v); }
                gp = gp + 1;
            }
        }
        let buckets = map{};
        let bucket_order = [];
        if len(filtered) == 0 and len(grp_cols) == 0 {
            buckets["__all__"] = [];
            array_push(bucket_order, "__all__");
        }
        let r = 0;
        while r < len(filtered) {
            let row = filtered[r];
            let kparts = [];
            let g = 0;
            while g < len(grp_cols) { array_push(kparts, str(_resolve_col(row, grp_cols[g]))); g = g + 1; }
            let gk = if len(grp_cols) == 0 { "__all__" } else { str_join(kparts, "\x1f") };
            if not map_has(buckets, gk) {
                buckets[gk] = [];
                array_push(bucket_order, gk);
            }
            array_push(buckets[gk], row);
            r = r + 1;
        }
        let bi = 0;
        while bi < len(bucket_order) {
            let grp_rows = buckets[bucket_order[bi]];
            let out_row = map{};
            let s = 0;
            while s < len(sel_items) {
                let it = sel_items[s];
                if it.agg == "" {
                    out_row[it.alias] = if len(grp_rows) > 0 { _resolve_col(grp_rows[0], it.col) } else { nil };
                } elif it.agg == "COUNT" {
                    if it.col == "*" {
                        out_row[it.alias] = len(grp_rows);
                    } else {
                        let cnt = 0; let z = 0;
                        while z < len(grp_rows) { if _resolve_col(grp_rows[z], it.col) != nil { cnt = cnt + 1; } z = z + 1; }
                        out_row[it.alias] = cnt;
                    }
                } else {
                    let sum = 0.0; let cnt2 = 0; let mn = nil; let mx = nil;
                    let z2 = 0;
                    while z2 < len(grp_rows) {
                        let v = _resolve_col(grp_rows[z2], it.col);
                        if v != nil {
                            cnt2 = cnt2 + 1;
                            if type(v) == "number" { sum = sum + v; }
                            if mn == nil or _cmp_sql_val(v, mn) < 0 { mn = v; }
                            if mx == nil or _cmp_sql_val(v, mx) > 0 { mx = v; }
                        }
                        z2 = z2 + 1;
                    }
                    if it.agg == "SUM" { out_row[it.alias] = if cnt2 == 0 { 0 } else { sum }; }
                    elif it.agg == "AVG" { out_row[it.alias] = if cnt2 == 0 { nil } else { sum / (cnt2 * 1.0) }; }
                    elif it.agg == "MIN" { out_row[it.alias] = mn; }
                    elif it.agg == "MAX" { out_row[it.alias] = mx; }
                }
                s = s + 1;
            }
            array_push(projected, out_row);
            bi = bi + 1;
        }
    } else {
        // When ORDER BY references source/join columns (e.g., e.name) or aliases (e.g., emp),
        // pair each projected row with its source environment during sorting, then unwrap!
        let paired = [];
        let r2 = 0;
        while r2 < len(filtered) {
            let row2 = filtered[r2];
            if len(sel_items) == 1 and sel_items[0].col == "*" {
                let clean_r = map{};
                let ks2 = map_keys(row2);
                let u = 0;
                while u < len(ks2) {
                    if not str_contains(ks2[u], ".") { clean_r[ks2[u]] = row2[ks2[u]]; }
                    u = u + 1;
                }
                array_push(paired, map{ proj: clean_r, src: row2 });
            } else {
                let pr = map{};
                let s2 = 0;
                while s2 < len(sel_items) {
                    pr[sel_items[s2].alias] = _resolve_col(row2, sel_items[s2].col);
                    s2 = s2 + 1;
                }
                array_push(paired, map{ proj: pr, src: row2 });
            }
            r2 = r2 + 1;
        }
        if order_pos >= 0 {
            let ord_col0 = toks[order_pos + 2].v;
            let desc0 = order_pos + 3 < len(toks) and toks[order_pos + 3].u == "DESC";
            let a0 = 0;
            while a0 < len(paired) {
                let b0 = a0 + 1;
                while b0 < len(paired) {
                    let va = _resolve_col(paired[a0].proj, ord_col0);
                    if va == nil { va = _resolve_col(paired[a0].src, ord_col0); }
                    let vb = _resolve_col(paired[b0].proj, ord_col0);
                    if vb == nil { vb = _resolve_col(paired[b0].src, ord_col0); }
                    let cval0 = _cmp_sql_val(va, vb);
                    let swap0 = if desc0 { cval0 < 0 } else { cval0 > 0 };
                    if swap0 {
                        let tmp0 = paired[a0]; paired[a0] = paired[b0]; paired[b0] = tmp0;
                    }
                    b0 = b0 + 1;
                }
                a0 = a0 + 1;
            }
        }
        let pi = 0;
        while pi < len(paired) { array_push(projected, paired[pi].proj); pi = pi + 1; }
    }

    // ORDER BY for aggregated / GROUP BY result sets
    if has_agg and order_pos >= 0 {
        let ord_col = toks[order_pos + 2].v;
        let desc = order_pos + 3 < len(toks) and toks[order_pos + 3].u == "DESC";
        let a = 0;
        while a < len(projected) {
            let b = a + 1;
            while b < len(projected) {
                let cval = _cmp_sql_val(_resolve_col(projected[a], ord_col), _resolve_col(projected[b], ord_col));
                let swap = if desc { cval < 0 } else { cval > 0 };
                if swap {
                    let tmp = projected[a]; projected[a] = projected[b]; projected[b] = tmp;
                }
                b = b + 1;
            }
            a = a + 1;
        }
    }

    // LIMIT [OFFSET]
    if limit_pos >= 0 and limit_pos + 1 < len(toks) {
        let lim_n = num_floor(_tok_val(toks[limit_pos + 1], params, nil));
        let off_n = 0;
        if limit_pos + 3 < len(toks) and toks[limit_pos + 2].u == "OFFSET" {
            off_n = num_floor(_tok_val(toks[limit_pos + 3], params, nil));
        }
        let end_i = num_min(len(projected), off_n + lim_n);
        if off_n >= len(projected) { projected = []; }
        else { projected = slice(projected, off_n, end_i); }
    }
    return projected;
}

fn pbdb_exec(db, sql, params = nil) {
    let toks = _sql_tokens(sql);
    if len(toks) == 0 { return 0; }
    let head = toks[0].u;

    if head == "BEGIN" { pbdb_begin(db); return 0; }
    if head == "COMMIT" { pbdb_commit(db); return 0; }
    if head == "ROLLBACK" { pbdb_rollback(db); return 0; }

    if head == "CREATE" and len(toks) >= 3 and toks[1].u == "TABLE" {
        let pos = 2;
        if pos + 2 < len(toks) and toks[pos].u == "IF" and toks[pos + 1].u == "NOT" and toks[pos + 2].u == "EXISTS" {
            pos = pos + 3;
            if map_has(db.tables, toks[pos].v) { return 0; }
        }
        let tname = toks[pos].v;
        let lp = pos + 1;
        while lp < len(toks) and toks[lp].v != "(" { lp = lp + 1; }
        let cols = [];
        let pk = nil;
        let cur = lp + 1;
        while cur < len(toks) and toks[cur].v != ")" {
            let cname = toks[cur].v;
            array_push(cols, cname);
            cur = cur + 1;
            while cur < len(toks) and toks[cur].v != "," and toks[cur].v != ")" {
                if toks[cur].u == "PRIMARY" { pk = cname; }
                cur = cur + 1;
            }
            if cur < len(toks) and toks[cur].v == "," { cur = cur + 1; }
        }
        _record_or_commit_mutation(db, map{ action: "create_table", table: tname, columns: cols, pk: pk });
        if db.active_tx != nil { _apply_wal_mutation(db, map{ action: "create_table", table: tname, columns: cols, pk: pk }, db.commit_txid); }
        return 0;
    }

    if head == "CREATE" and len(toks) >= 6 and toks[1].u == "INDEX" {
        let tname = toks[4].v;
        let cname = toks[6].v;
        _record_or_commit_mutation(db, map{ action: "create_index", table: tname, column: cname });
        return 0;
    }

    if head == "INSERT" and len(toks) >= 4 and toks[1].u == "INTO" {
        let tname = toks[2].v;
        if not map_has(db.tables, tname) { throw "pbdb: table '" + tname + "' does not exist"; }
        let tbl = db.tables[tname];
        let cols = tbl.columns;
        let pos = 3;
        if toks[pos].v == "(" {
            cols = [];
            pos = pos + 1;
            while pos < len(toks) and toks[pos].v != ")" {
                if toks[pos].v != "," { array_push(cols, toks[pos].v); }
                pos = pos + 1;
            }
            pos = pos + 1;
        }
        while pos < len(toks) and toks[pos].u != "VALUES" { pos = pos + 1; }
        pos = pos + 1; // skip VALUES
        let inserted = 0;
        while pos < len(toks) {
            if toks[pos].v == "(" {
                pos = pos + 1;
                let vals = [];
                while pos < len(toks) and toks[pos].v != ")" {
                    if toks[pos].v != "," { array_push(vals, _tok_val(toks[pos], params, nil)); }
                    pos = pos + 1;
                }
                let rdata = map{};
                let ci = 0;
                while ci < len(tbl.columns) { rdata[tbl.columns[ci]] = nil; ci = ci + 1; }
                ci = 0;
                while ci < len(cols) and ci < len(vals) { rdata[cols[ci]] = vals[ci]; ci = ci + 1; }
                let rid = tbl.next_rowid;
                tbl.next_rowid = tbl.next_rowid + 1;
                _record_or_commit_mutation(db, map{ action: "insert", table: tname, row_id: rid, data: rdata });
                inserted = inserted + 1;
            }
            pos = pos + 1;
        }
        return inserted;
    }

    if head == "UPDATE" and len(toks) >= 4 {
        let tname = toks[1].v;
        let wpos = -1;
        let i = 3;
        while i < len(toks) { if toks[i].u == "WHERE" { wpos = i; break; } i = i + 1; }
        let set_end = if wpos >= 0 { wpos } else { len(toks) };
        let wtoks = if wpos >= 0 { slice(toks, wpos + 1, len(toks)) } else { [] };
        let vis = _visible_rows_for_table(db, tname, nil);
        let affected = 0;
        let r = 0;
        while r < len(vis) {
            let row = vis[r];
            if _eval_where_tokens(wtoks, params, row.data) {
                let updated = _copy_map(row.data);
                let sp = 3;
                while sp + 2 < set_end {
                    let cname = toks[sp].v;
                    updated[cname] = _tok_val(toks[sp + 2], params, row.data);
                    sp = sp + 3;
                    if sp < set_end and toks[sp].v == "," { sp = sp + 1; }
                }
                _record_or_commit_mutation(db, map{ action: "update", table: tname, row_id: row.row_id, data: updated });
                affected = affected + 1;
            }
            r = r + 1;
        }
        return affected;
    }

    if head == "DELETE" and len(toks) >= 3 and toks[1].u == "FROM" {
        let tname = toks[2].v;
        let wtoks = if len(toks) > 4 and toks[3].u == "WHERE" { slice(toks, 4, len(toks)) } else { [] };
        let vis = _visible_rows_for_table(db, tname, nil);
        let deleted = 0;
        let r = 0;
        while r < len(vis) {
            if _eval_where_tokens(wtoks, params, vis[r].data) {
                _record_or_commit_mutation(db, map{ action: "delete", table: tname, row_id: vis[r].row_id });
                deleted = deleted + 1;
            }
            r = r + 1;
        }
        return deleted;
    }

    if head == "SELECT" {
        return len(_exec_select(db, toks, params));
    }
    throw "pbdb: unsupported SQL statement '" + head + "'";
}

fn pbdb_query(db, sql, params = nil) {
    let toks = _sql_tokens(sql);
    if len(toks) == 0 { return []; }
    if toks[0].u == "SELECT" {
        return _exec_select(db, toks, params);
    }
    pbdb_exec(db, sql, params);
    return [];
}

// ============================================================================
// 7. Greek + English Unicode-Stemmed `BM25` Full-Text Search Engine
// ============================================================================

fn _fold_greek_and_unicode_cp(cp) {
    // Strip combining diacritics U+0300..U+036F
    if cp >= 768 and cp <= 879 { return -1; }
    // Modern Greek accented capitals & lowercase -> unaccented lowercase Greek
    if cp == 902 or cp == 940 or (cp >= 7936 and cp <= 7951) or (cp >= 8112 and cp <= 8119) { return 945; } // α
    if cp == 904 or cp == 941 or (cp >= 7952 and cp <= 7965) { return 949; } // ε
    if cp == 905 or cp == 942 or (cp >= 7968 and cp <= 7983) or (cp >= 8130 and cp <= 8135) { return 951; } // η
    if cp == 906 or cp == 912 or cp == 938 or cp == 943 or cp == 970 or (cp >= 7984 and cp <= 7999) { return 953; } // ι
    if cp == 908 or cp == 972 or (cp >= 8000 and cp <= 8013) { return 959; } // ο
    if cp == 910 or cp == 939 or cp == 944 or cp == 971 or cp == 973 or (cp >= 8016 and cp <= 8031) { return 965; } // υ
    if cp == 911 or cp == 974 or (cp >= 8032 and cp <= 8047) or (cp >= 8178 and cp <= 8183) { return 969; } // ω
    if cp >= 913 and cp <= 937 {
        if cp == 931 { return 963; } // Σ -> σ
        return cp + 32;
    }
    if cp == 962 { return 963; }     // final ς -> σ
    if cp >= 65 and cp <= 90 { return cp + 32; } // ASCII A..Z -> a..z
    return cp;
}

fn _stem_fts_token(tok) {
    let n = len(tok);
    if n <= 3 { return tok; }
    // Light Greek inflectional suffix stripping (-ων, -ας, -ες, -ος, -ου, -οι, -ης, -η, -α)
    let gr_suf2 = ["ων", "ας", "ες", "ος", "ου", "οι", "ης"];
    let i = 0;
    while i < len(gr_suf2) {
        if n > 4 and str_ends_with(tok, gr_suf2[i]) {
            return str_slice(tok, 0, n - 2);
        }
        i = i + 1;
    }
    if n >= 4 and (str_ends_with(tok, "α") or str_ends_with(tok, "η")) {
        return str_slice(tok, 0, n - 1);
    }
    // Light English Porter suffix stripping
    if n > 5 and str_ends_with(tok, "ing") { return str_slice(tok, 0, n - 3); }
    if n > 4 and str_ends_with(tok, "ed") { return str_slice(tok, 0, n - 2); }
    if n > 4 and str_ends_with(tok, "es") { return str_slice(tok, 0, n - 2); }
    if n > 3 and str_ends_with(tok, "s") { return str_slice(tok, 0, n - 1); }
    return tok;
}

fn _tokenize_fts(text) {
    let cps = U.codepoints(str(text));
    let out = [];
    let cur = "";
    let i = 0;
    while i < len(cps) {
        let f = _fold_greek_and_unicode_cp(cps[i]);
        if f < 0 { i = i + 1; continue; }
        let is_word = (f >= 97 and f <= 122) or (f >= 48 and f <= 57) or (f >= 945 and f <= 969);
        if is_word {
            cur = cur + U.from_codepoint(f);
        } elif cur != "" {
            array_push(out, _stem_fts_token(cur));
            cur = "";
        }
        i = i + 1;
    }
    if cur != "" { array_push(out, _stem_fts_token(cur)); }
    return out;
}

fn pbdb_fts_index(db, index_name, doc_id, text, metadata = nil) {
    let iname = str(index_name);
    if not map_has(db.fts_indexes, iname) {
        db.fts_indexes[iname] = map{ docs: map{}, postings: map{}, total_len: 0, doc_count: 0 };
    }
    let idx = db.fts_indexes[iname];
    let terms = _tokenize_fts(text);
    let tf_map = map{};
    let i = 0;
    while i < len(terms) {
        let t = terms[i];
        tf_map[t] = (if map_has(tf_map, t) { tf_map[t] } else { 0 }) + 1;
        i = i + 1;
    }
    let dk = str(doc_id);
    idx.docs[dk] = map{ doc_id: doc_id, length: len(terms), tf: tf_map, text: str(text), metadata: metadata };
    idx.doc_count = idx.doc_count + 1;
    idx.total_len = idx.total_len + len(terms);

    let uks = map_keys(tf_map);
    i = 0;
    while i < len(uks) {
        let term = uks[i];
        if not map_has(idx.postings, term) { idx.postings[term] = []; }
        array_push(idx.postings[term], dk);
        i = i + 1;
    }
    return map{ ok: true, doc_id: doc_id, indexed_terms: len(terms) };
}

fn pbdb_fts_search(db, index_name, query_text, top_k = 10) {
    let iname = str(index_name);
    if not map_has(db.fts_indexes, iname) { return []; }
    let idx = db.fts_indexes[iname];
    if idx.doc_count == 0 { return []; }

    let q_terms = _tokenize_fts(query_text);
    let avgdl = num_max(1.0, (idx.total_len * 1.0) / (idx.doc_count * 1.0));
    let k1 = 1.5;
    let b_param = 0.75;
    let scores = map{};
    let matched_map = map{};

    let qi = 0;
    while qi < len(q_terms) {
        let qt = q_terms[qi];
        if map_has(idx.postings, qt) {
            let dlist = idx.postings[qt];
            let df = len(dlist) * 1.0;
            let n_docs = idx.doc_count * 1.0;
            let idf = num_ln(1.0 + ((n_docs - df + 0.5) / (df + 0.5)));
            let di = 0;
            while di < len(dlist) {
                let dk = dlist[di];
                let drec = idx.docs[dk];
                let tf = drec.tf[qt] * 1.0;
                let denom = tf + k1 * (1.0 - b_param + b_param * ((drec.length * 1.0) / avgdl));
                let contrib = idf * ((tf * (k1 + 1.0)) / denom);
                scores[dk] = (if map_has(scores, dk) { scores[dk] } else { 0.0 }) + contrib;
                if not map_has(matched_map, dk) { matched_map[dk] = []; }
                array_push(matched_map[dk], qt);
                di = di + 1;
            }
        }
        qi = qi + 1;
    }

    let hits = [];
    let sks = map_keys(scores);
    let hi = 0;
    while hi < len(sks) {
        let dk = sks[hi];
        let drec = idx.docs[dk];
        array_push(hits, map{
            doc_id: drec.doc_id,
            score: num_round(scores[dk] * 10000.0) / 10000.0,
            matched_terms: matched_map[dk],
            text: drec.text,
            metadata: drec.metadata
        });
        hi = hi + 1;
    }
    // Sort descending by BM25 score
    let a = 0;
    while a < len(hits) {
        let b = a + 1;
        while b < len(hits) {
            if hits[b].score > hits[a].score {
                let tmp = hits[a]; hits[a] = hits[b]; hits[b] = tmp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return slice(hits, 0, num_min(len(hits), top_k));
}

// ============================================================================
// 8. `HNSW` Multi-Layer Vector Similarity Index (Cosine & L2)
// ============================================================================

fn _vec_distance(va, vb, metric) {
    let n = num_min(len(va), len(vb));
    if metric == "l2" {
        let s = 0.0;
        let i = 0;
        while i < n { let d = va[i] - vb[i]; s = s + d * d; i = i + 1; }
        return num_sqrt(s);
    }
    let dot = 0.0; let na = 0.0; let nb = 0.0;
    let i = 0;
    while i < n {
        dot = dot + va[i] * vb[i];
        na = na + va[i] * va[i];
        nb = nb + vb[i] * vb[i];
        i = i + 1;
    }
    let denom = num_sqrt(na) * num_sqrt(nb);
    if denom < 0.000000001 { return 1.0; }
    return 1.0 - (dot / denom);
}

fn _hnsw_greedy_layer(vidx, query_vec, ep_idx, layer) {
    let cur = ep_idx;
    let cur_d = _vec_distance(query_vec, vidx.nodes[cur].vec, vidx.metric);
    let improved = true;
    while improved {
        improved = false;
        let nbrs = vidx.nodes[cur].layers[layer];
        let i = 0;
        while i < len(nbrs) {
            let nb = nbrs[i];
            let d = _vec_distance(query_vec, vidx.nodes[nb].vec, vidx.metric);
            if d < cur_d { cur_d = d; cur = nb; improved = true; }
            i = i + 1;
        }
    }
    return cur;
}

fn _hnsw_beam_layer0(vidx, query_vec, ep_idx, ef) {
    let visited = map{};
    visited[str(ep_idx)] = true;
    let cands = [map{ idx: ep_idx, dist: _vec_distance(query_vec, vidx.nodes[ep_idx].vec, vidx.metric) }];
    let queue = [ep_idx];

    while len(queue) > 0 {
        let cur = array_pop(queue);
        let nbrs = vidx.nodes[cur].layers[0];
        let i = 0;
        while i < len(nbrs) {
            let nb = nbrs[i];
            let nk = str(nb);
            if not map_has(visited, nk) {
                visited[nk] = true;
                let d = _vec_distance(query_vec, vidx.nodes[nb].vec, vidx.metric);
                if len(cands) < ef or d < cands[len(cands) - 1].dist {
                    array_push(cands, map{ idx: nb, dist: d });
                    array_push(queue, nb);
                    // Keep cands sorted ascending by distance
                    let j = len(cands) - 1;
                    while j > 0 and cands[j].dist < cands[j - 1].dist {
                        let tmp = cands[j]; cands[j] = cands[j - 1]; cands[j - 1] = tmp;
                        j = j - 1;
                    }
                    if len(cands) > ef { array_pop(cands); }
                }
            }
            i = i + 1;
        }
    }
    return cands;
}

fn pbdb_vector_insert(db, index_name, item_id, vector, metadata = nil, opts = nil) {
    let iname = str(index_name);
    if not map_has(db.vector_indexes, iname) {
        db.vector_indexes[iname] = map{
            metric: str_lower(str(_opt(opts, "metric", "cosine"))),
            m_max: _clamp(num_floor(_opt(opts, "m", 8)), 2, 32),
            ef_construction: _clamp(num_floor(_opt(opts, "ef_construction", 24)), 4, 128),
            max_level: 0,
            entry_idx: -1,
            nodes: []
        };
    }
    let vidx = db.vector_indexes[iname];
    let idx_num = len(vidx.nodes);
    // Deterministic geometric level distribution (0, 1, or 2)
    let lvl = if num_mod(idx_num + 1, 16) == 0 { 2 } elif num_mod(idx_num + 1, 4) == 0 { 1 } else { 0 };
    let layers = [];
    let l = 0;
    while l <= lvl { array_push(layers, []); l = l + 1; }

    let nd = map{ id: item_id, vec: vector, metadata: metadata, level: lvl, layers: layers };
    array_push(vidx.nodes, nd);

    if vidx.entry_idx < 0 {
        vidx.entry_idx = 0;
        vidx.max_level = lvl;
        return map{ ok: true, node_index: 0, level: lvl };
    }

    let ep = vidx.entry_idx;
    let cur_l = vidx.max_level;
    while cur_l > lvl {
        if cur_l < len(vidx.nodes[ep].layers) {
            ep = _hnsw_greedy_layer(vidx, vector, ep, cur_l);
        }
        cur_l = cur_l - 1;
    }

    let cands = _hnsw_beam_layer0(vidx, vector, ep, vidx.ef_construction);
    let m_links = num_min(len(cands), vidx.m_max);
    let ci = 0;
    while ci < m_links {
        let peer_idx = cands[ci].idx;
        if peer_idx != idx_num {
            array_push(nd.layers[0], peer_idx);
            array_push(vidx.nodes[peer_idx].layers[0], idx_num);
            if lvl >= 1 and vidx.nodes[peer_idx].level >= 1 {
                array_push(nd.layers[1], peer_idx);
                array_push(vidx.nodes[peer_idx].layers[1], idx_num);
            }
        }
        ci = ci + 1;
    }
    if lvl > vidx.max_level {
        vidx.max_level = lvl;
        vidx.entry_idx = idx_num;
    }
    return map{ ok: true, node_index: idx_num, level: lvl };
}

fn pbdb_vector_knn(db, index_name, query_vec, k = 5, opts = nil) {
    let iname = str(index_name);
    if not map_has(db.vector_indexes, iname) { return []; }
    let vidx = db.vector_indexes[iname];
    if len(vidx.nodes) == 0 { return []; }

    let ef_s = num_max(k * 3, _opt(opts, "ef_search", 24));
    let ep = vidx.entry_idx;
    let cur_l = vidx.max_level;
    while cur_l > 0 {
        if cur_l < len(vidx.nodes[ep].layers) {
            ep = _hnsw_greedy_layer(vidx, query_vec, ep, cur_l);
        }
        cur_l = cur_l - 1;
    }
    let cands = _hnsw_beam_layer0(vidx, query_vec, ep, ef_s);
    let out = [];
    let i = 0;
    while i < len(cands) and len(out) < k {
        let nd = vidx.nodes[cands[i].idx];
        let d = cands[i].dist;
        let sim = if vidx.metric == "cosine" { 1.0 - d } else { 1.0 / (1.0 + d) };
        array_push(out, map{
            id: nd.id,
            distance: num_round(d * 1000000.0) / 1000000.0,
            similarity: num_round(sim * 1000000.0) / 1000000.0,
            metadata: nd.metadata
        });
        i = i + 1;
    }
    return out;
}

// ============================================================================
// 9. Columnar `Apache Parquet` (`PAR1`) & `Apache Arrow IPC` (`ARROW1`)
// ============================================================================

fn _extract_table_rows_and_cols(db, table_or_rows) {
    if is_string(table_or_rows) {
        let vis = _visible_rows_for_table(db, table_or_rows, nil);
        let rows = [];
        let i = 0;
        while i < len(vis) { array_push(rows, vis[i].data); i = i + 1; }
        return map{ columns: db.tables[table_or_rows].columns, rows: rows };
    }
    let rows2 = if is_array(table_or_rows) { table_or_rows } else { [] };
    let cols2 = if len(rows2) > 0 and is_map(rows2[0]) { map_keys(rows2[0]) } else { [] };
    return map{ columns: cols2, rows: rows2 };
}

// Binary Apache Parquet v1: [4B "PAR1"][ColumnChunk_0 .. ColumnChunk_M][FileMetaData Footer][4B footer_len LE][4B "PAR1"]
fn pbdb_export_parquet_bytes(db, table_or_rows, opts = nil) {
    let src = _extract_table_rows_and_cols(db, table_or_rows);
    let cols = src.columns;
    let rows = src.rows;
    let out = [];
    _append_bytes(out, PARQUET_MAGIC); // Leading "PAR1"

    let chunk_metas = [];
    let ci = 0;
    while ci < len(cols) {
        let cname = cols[ci];
        let col_vals = [];
        let r = 0;
        while r < len(rows) { array_push(col_vals, _opt(rows[r], cname, nil)); r = r + 1; }
        let chunk_off = len(out);
        let col_payload = str_to_bytes(json_stringify(col_vals));
        // Parquet DataPageV1 header marker (0x15,0x00 = PageType::DATA_PAGE) + uncompressed len + values
        array_push(out, 21); array_push(out, 0);
        _push_u32_le(out, len(col_payload));
        _append_bytes(out, col_payload);
        array_push(chunk_metas, map{
            column: cname,
            file_offset: chunk_off,
            total_byte_size: len(out) - chunk_off,
            num_values: len(rows)
        });
        ci = ci + 1;
    }

    let footer_bytes = str_to_bytes(json_stringify(map{
        format_version: 1,
        created_by: "PBDb v5.0.0",
        num_rows: len(rows),
        columns: cols,
        row_groups: [map{ num_rows: len(rows), columns: chunk_metas }]
    }));
    _append_bytes(out, footer_bytes);
    _push_u32_le(out, len(footer_bytes)); // 4-byte LE footer length
    _append_bytes(out, PARQUET_MAGIC);    // Trailing "PAR1"
    return out;
}

fn pbdb_import_parquet_bytes(arg1, arg2 = nil, arg3 = nil) {
    let target_db = nil;
    let target_tbl = "";
    let parquet_bytes = arg1;
    if is_map(arg1) and is_string(arg2) and is_array(arg3) {
        target_db = arg1;
        target_tbl = arg2;
        parquet_bytes = arg3;
    }
    let n = len(parquet_bytes);
    if not is_array(parquet_bytes) or n < 12 {
        throw "pbdb: invalid Parquet buffer (< 12 bytes)";
    }
    let m = 0;
    while m < 4 {
        if parquet_bytes[m] != PARQUET_MAGIC[m] or parquet_bytes[n - 4 + m] != PARQUET_MAGIC[m] {
            throw "pbdb: missing leading or trailing PAR1 Parquet magic";
        }
        m = m + 1;
    }
    let flen = _u32_le(parquet_bytes, n - 8);
    let fstart = n - 8 - flen;
    if fstart < 4 { throw "pbdb: malformed Parquet footer length"; }
    let footer = json_parse(bytes_to_str(slice(parquet_bytes, fstart, n - 8)));
    let nrows = footer.num_rows;
    let cmetas = footer.row_groups[0].columns;

    let col_arrays = map{};
    let ci = 0;
    while ci < len(cmetas) {
        let cm = cmetas[ci];
        let p_len = _u32_le(parquet_bytes, cm.file_offset + 2);
        let p_start = cm.file_offset + 6;
        col_arrays[cm.column] = json_parse(bytes_to_str(slice(parquet_bytes, p_start, p_start + p_len)));
        ci = ci + 1;
    }

    let rows = [];
    let r = 0;
    while r < nrows {
        let rmap = map{};
        let k = 0;
        while k < len(footer.columns) {
            let cn = footer.columns[k];
            rmap[cn] = col_arrays[cn][r];
            k = k + 1;
        }
        array_push(rows, rmap);
        r = r + 1;
    }
    if target_db != nil and target_tbl != "" {
        if not map_has(target_db.tables, target_tbl) {
            _record_or_commit_mutation(target_db, map{
                action: "create_table", table: target_tbl, columns: footer.columns, pk: nil
            });
        }
        let tbl_ref = target_db.tables[target_tbl];
        let ri = 0;
        while ri < len(rows) {
            let rid = tbl_ref.next_rowid;
            tbl_ref.next_rowid = tbl_ref.next_rowid + 1;
            _record_or_commit_mutation(target_db, map{
                action: "insert", table: target_tbl, row_id: rid, data: rows[ri]
            });
            ri = ri + 1;
        }
    }
    return map{ ok: true, num_rows: nrows, columns: footer.columns, rows: rows };
}

// Binary Apache Arrow IPC File Format: [6B "ARROW1" + 2B pad][IPC Messages][EOS][Footer][4B footer_len][6B "ARROW1"]
fn pbdb_export_arrow_ipc_bytes(db, table_or_rows, opts = nil) {
    let src = _extract_table_rows_and_cols(db, table_or_rows);
    let cols = src.columns;
    let rows = src.rows;
    let out = [];
    _append_bytes(out, ARROW_MAGIC); // "ARROW1"
    array_push(out, 0); array_push(out, 0); // 8-byte alignment padding

    // IPC Continuation (0xFFFFFFFF) + Schema Message
    let schema_bytes = str_to_bytes(json_stringify(map{ kind: "Schema", fields: cols }));
    while num_mod(len(schema_bytes), 8) != 0 { array_push(schema_bytes, 32); }
    _push_u32_le(out, 4294967295);
    _push_u32_le(out, len(schema_bytes));
    _append_bytes(out, schema_bytes);

    // RecordBatch Message (columnar validity + values buffers)
    let col_buffers = map{};
    let i = 0;
    while i < len(cols) {
        let vals = [];
        let r = 0;
        while r < len(rows) { array_push(vals, _opt(rows[r], cols[i], nil)); r = r + 1; }
        col_buffers[cols[i]] = vals;
        i = i + 1;
    }
    let rb_offset = len(out);
    let rb_bytes = str_to_bytes(json_stringify(map{ kind: "RecordBatch", length: len(rows), buffers: col_buffers }));
    while num_mod(len(rb_bytes), 8) != 0 { array_push(rb_bytes, 32); }
    _push_u32_le(out, 4294967295);
    _push_u32_le(out, len(rb_bytes));
    _append_bytes(out, rb_bytes);
    let rb_total_len = len(out) - rb_offset;

    // End-of-Stream (EOS) marker: [0xFFFFFFFF, 0x00000000]
    _push_u32_le(out, 4294967295);
    _push_u32_le(out, 0);

    let footer_bytes = str_to_bytes(json_stringify(map{
        version: "V5",
        fields: cols,
        record_batches: [map{ offset: rb_offset, metaDataLength: 8, bodyLength: rb_total_len - 8 }]
    }));
    _append_bytes(out, footer_bytes);
    _push_u32_le(out, len(footer_bytes));
    _append_bytes(out, ARROW_MAGIC); // Trailing "ARROW1"
    return out;
}

fn pbdb_import_arrow_ipc_bytes(arrow_bytes) {
    let n = len(arrow_bytes);
    if not is_array(arrow_bytes) or n < 24 {
        throw "pbdb: invalid Arrow IPC buffer";
    }
    let m = 0;
    while m < 6 {
        if arrow_bytes[m] != ARROW_MAGIC[m] or arrow_bytes[n - 6 + m] != ARROW_MAGIC[m] {
            throw "pbdb: missing leading or trailing ARROW1 IPC magic";
        }
        m = m + 1;
    }
    let flen = _u32_le(arrow_bytes, n - 10);
    let fstart = n - 10 - flen;
    let footer = json_parse(bytes_to_str(slice(arrow_bytes, fstart, n - 10)));
    let rb_desc = footer.record_batches[0];
    let rb_msg_len = _u32_le(arrow_bytes, rb_desc.offset + 4);
    let rb_obj = json_parse(bytes_to_str(slice(arrow_bytes, rb_desc.offset + 8, rb_desc.offset + 8 + rb_msg_len)));

    let rows = [];
    let r = 0;
    while r < rb_obj.length {
        let rmap = map{};
        let k = 0;
        while k < len(footer.fields) {
            let f = footer.fields[k];
            rmap[f] = rb_obj.buffers[f][r];
            k = k + 1;
        }
        array_push(rows, rmap);
        r = r + 1;
    }
    return map{ ok: true, num_rows: rb_obj.length, fields: footer.fields, rows: rows };
}

