// stdlib/db/mysql_wire_driver.sapp — Pure-PBLang MySQL 8.0 / MariaDB Protocol v10 Driver
//
// Implements the MySQL / MariaDB Client/Server Binary Wire Protocol v10 directly
// over capability-gated TCP/TLS sockets without libmysqlclient or mysql CLI:
//   - 4-byte packet framing ([payload_len_le:u24][seq_id:u8]) with 16 MiB split/reassembly.
//   - HandshakeV10 + BOTH mysql_native_password (SHA-1 double-hash XOR) AND
//     caching_sha2_password (SHA-256 XOR scramble + fast-auth 0x01/0x03 + AuthSwitch 0xFE).
//   - True Binary Prepared Statements (COM_STMT_PREPARE = 0x16, COM_STMT_EXECUTE = 0x17,
//     COM_STMT_CLOSE = 0x19) with exact NULL-bitmap, new_params_bound_flag,
//     MYSQL_TYPE_LONGLONG / MYSQL_TYPE_DOUBLE / MYSQL_TYPE_VAR_STRING / MYSQL_TYPE_BLOB
//     encoding, Binary Resultset decoding (+2 NULL-bitmap offset), and COM_QUERY = 0x03.

let COM_QUIT = 1;                // 0x01
let COM_INIT_DB = 2;             // 0x02
let COM_QUERY = 3;               // 0x03
let COM_PING = 14;               // 0x0E
let COM_STMT_PREPARE = 22;       // 0x16
let COM_STMT_EXECUTE = 23;       // 0x17
let COM_STMT_CLOSE = 25;         // 0x19

// MySQL Column / Parameter Field Types
let MYSQL_TYPE_DECIMAL = 0;      // 0x00
let MYSQL_TYPE_TINY = 1;         // 0x01
let MYSQL_TYPE_SHORT = 2;        // 0x02
let MYSQL_TYPE_LONG = 3;         // 0x03
let MYSQL_TYPE_FLOAT = 4;        // 0x04
let MYSQL_TYPE_DOUBLE = 5;       // 0x05
let MYSQL_TYPE_NULL = 6;         // 0x06
let MYSQL_TYPE_LONGLONG = 8;     // 0x08
let MYSQL_TYPE_INT24 = 9;        // 0x09
let MYSQL_TYPE_VARCHAR = 15;     // 0x0F
let MYSQL_TYPE_JSON = 245;       // 0xF5
let MYSQL_TYPE_NEWDECIMAL = 246; // 0xF6
let MYSQL_TYPE_BLOB = 252;       // 0xFC
let MYSQL_TYPE_VAR_STRING = 253; // 0xFD
let MYSQL_TYPE_STRING = 254;     // 0xFE

let CHARSET_UTF8MB4 = 45;
let CHARSET_BINARY = 63;

let MAX_SINGLE_PACKET = 16777215; // 0xFFFFFF
let MAX_TOTAL_PACKET = 67108864;
let MAX_SAFE_INT = 9007199254740991;

fn _opt(opts, key, fallback) {
    if is_map(opts) and map_has(opts, key) and opts[key] != nil {
        return opts[key];
    }
    return fallback;
}

// ── Little-Endian & Length-Encoded Primitives ────────────────────────────────

fn _append_bytes(dst, src) {
    let i = 0;
    let n = len(src);
    while i < n {
        array_push(dst, src[i]);
        i = i + 1;
    }
    return dst;
}

fn _push_u16_le(buf, val) {
    let v = num_mod(num_floor(val), 65536);
    if v < 0 { v = v + 65536; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(bit_shr(v, 8), 255));
    return buf;
}

fn _push_u24_le(buf, val) {
    let v = num_mod(num_floor(val), 16777216);
    if v < 0 { v = v + 16777216; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(num_floor(v / 65536), 255));
    return buf;
}

fn _push_u32_le(buf, val) {
    let v = num_mod(num_floor(val), 4294967296);
    if v < 0 { v = v + 4294967296; }
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(num_floor(v / 256), 255));
    array_push(buf, bit_and(num_floor(v / 65536), 255));
    array_push(buf, bit_and(num_floor(v / 16777216), 255));
    return buf;
}

fn _push_i64_le(buf, val) {
    let v = num_floor(val);
    if v >= 0 {
        let hi = num_floor(v / 4294967296);
        let lo = v - hi * 4294967296;
        _push_u32_le(buf, lo);
        _push_u32_le(buf, hi);
    } else {
        let pos = 0 - v - 1;
        let hi_inv = num_floor(pos / 4294967296);
        let lo_inv = pos - hi_inv * 4294967296;
        _push_u32_le(buf, bit_xor(lo_inv, 4294967295));
        _push_u32_le(buf, bit_xor(hi_inv, 4294967295));
    }
    return buf;
}

fn _read_u16_le(b, pos) {
    return b[pos] + b[pos + 1] * 256;
}

fn _read_i16_le(b, pos) {
    let u = _read_u16_le(b, pos);
    if u >= 32768 { return u - 65536; }
    return u;
}

fn _read_u24_le(b, pos) {
    return b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536;
}

fn _read_i24_le(b, pos) {
    let u = _read_u24_le(b, pos);
    if u >= 8388608 { return u - 16777216; }
    return u;
}

fn _read_u32_le(b, pos) {
    return b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216;
}

fn _read_i32_le(b, pos) {
    let u = _read_u32_le(b, pos);
    if u >= 2147483648 { return u - 4294967296; }
    return u;
}

fn _read_u64_le(b, pos) {
    let lo = _read_u32_le(b, pos);
    let hi = _read_u32_le(b, pos + 4);
    return hi * 4294967296 + lo;
}

fn _read_i64_le(b, pos) {
    let lo = _read_u32_le(b, pos);
    let hi = _read_u32_le(b, pos + 4);
    if hi < 2147483648 {
        return hi * 4294967296 + lo;
    }
    let lo_inv = bit_xor(lo, 4294967295);
    let hi_inv = bit_xor(hi, 4294967295);
    return 0 - (hi_inv * 4294967296 + lo_inv + 1);
}

fn _push_cstring(buf, s) {
    let text = str(s);
    if str_contains(text, "\x00") {
        throw "mysql_wire_driver: NUL byte rejected in C-string";
    }
    _append_bytes(buf, str_to_bytes(text));
    array_push(buf, 0);
    return buf;
}

fn _read_cstring(b, pos) {
    let i = pos;
    let n = len(b);
    while i < n and b[i] != 0 { i = i + 1; }
    if i >= n {
        return map{ text: bytes_to_str(slice(b, pos, n)), next: n };
    }
    return map{ text: bytes_to_str(slice(b, pos, i)), next: i + 1 };
}

fn encode_lenenc_int(arg1, arg2 = nil) {
    let buf = [];
    let val = arg1;
    if arg2 != nil {
        buf = arg1;
        val = arg2;
    }
    let v = num_floor(val);
    if v < 251 {
        array_push(buf, v);
    } elif v < 65536 {
        array_push(buf, 252); // 0xFC
        _push_u16_le(buf, v);
    } elif v < 16777216 {
        array_push(buf, 253); // 0xFD
        _push_u24_le(buf, v);
    } else {
        array_push(buf, 254); // 0xFE
        _push_i64_le(buf, v);
    }
    return buf;
}

fn decode_lenenc_int(b, pos) {
    let first = b[pos];
    if first < 251 {
        return map{ is_null: false, value: first, next: pos + 1 };
    }
    if first == 251 {
        return map{ is_null: true, value: nil, next: pos + 1 };
    }
    if first == 252 {
        return map{ is_null: false, value: _read_u16_le(b, pos + 1), next: pos + 3 };
    }
    if first == 253 {
        return map{ is_null: false, value: _read_u24_le(b, pos + 1), next: pos + 4 };
    }
    return map{ is_null: false, value: _read_u64_le(b, pos + 1), next: pos + 9 };
}

fn encode_lenenc_bytes(arg1, arg2 = nil) {
    let buf = [];
    let raw_bytes = arg1;
    if arg2 != nil {
        buf = arg1;
        raw_bytes = arg2;
    }
    encode_lenenc_int(buf, len(raw_bytes));
    _append_bytes(buf, raw_bytes);
    return buf;
}

fn decode_lenenc_bytes(b, pos) {
    let li = decode_lenenc_int(b, pos);
    if li.is_null {
        return map{ is_null: true, bytes: nil, next: li.next };
    }
    let end = li.next + li.value;
    return map{ is_null: false, bytes: slice(b, li.next, end), next: end };
}

// ── 4-Byte MySQL Packet Framing ──────────────────────────────────────────────

fn build_mysql_frame(seq_id, payload) {
    let out = [];
    _push_u24_le(out, len(payload));
    array_push(out, bit_and(seq_id, 255));
    _append_bytes(out, payload);
    return out;
}

fn _read_exact_str(handle, count) {
    if count <= 0 { return ""; }
    let out = [];
    while len(out) < count {
        let chunk = tcp_read(handle, count - len(out));
        if chunk == nil or chunk == "" {
            throw "mysql_wire_driver: unexpected EOF reading MySQL packet";
        }
        let cb = str_to_bytes(chunk);
        if len(cb) == 0 {
            throw "mysql_wire_driver: unexpected EOF reading MySQL packet";
        }
        _append_bytes(out, cb);
    }
    return bytes_to_str(out);
}

fn write_mysql_packet(handle, seq_id, payload) {
    let total = len(payload);
    if total < MAX_SINGLE_PACKET {
        let frame = build_mysql_frame(seq_id, payload);
        tcp_write(handle, frame);
        return bit_and(seq_id + 1, 255);
    }
    let offset = 0;
    let cur_seq = seq_id;
    while true {
        let rem = total - offset;
        let take = if rem > MAX_SINGLE_PACKET { MAX_SINGLE_PACKET } else { rem };
        let chunk = slice(payload, offset, offset + take);
        tcp_write(handle, build_mysql_frame(cur_seq, chunk));
        cur_seq = bit_and(cur_seq + 1, 255);
        offset = offset + take;
        if take < MAX_SINGLE_PACKET { break; }
    }
    return cur_seq;
}

fn read_mysql_packet(handle) {
    let assembled = [];
    let last_seq = 0;
    while true {
        let hdr = str_to_bytes(_read_exact_str(handle, 4));
        let plen = _read_u24_le(hdr, 0);
        last_seq = hdr[3];
        if len(assembled) + plen > MAX_TOTAL_PACKET {
            throw "mysql_wire_driver: packet exceeds maximum allowed size";
        }
        if plen > 0 {
            _append_bytes(assembled, str_to_bytes(_read_exact_str(handle, plen)));
        }
        if plen < MAX_SINGLE_PACKET { break; }
    }
    return map{ seq_id: last_seq, payload: assembled };
}

// ── Authentication Plugins (mysql_native_password & caching_sha2_password) ───

fn _xor_bytes(a, b) {
    let out = [];
    let i = 0;
    while i < len(a) {
        array_push(out, bit_xor(a[i], b[i]));
        i = i + 1;
    }
    return out;
}

// mysql_native_password: SHA1(pw) XOR SHA1(seed || SHA1(SHA1(pw)))
fn scramble_mysql_native_password(password, seed_bytes) {
    let pw = str(password);
    if pw == "" { return []; }
    let s1 = str_to_bytes(hex_decode(sha1(pw)));
    let s2 = str_to_bytes(hex_decode(sha1(bytes_to_str(s1))));
    let seed20 = if len(seed_bytes) > 20 { slice(seed_bytes, 0, 20) } else { seed_bytes };
    let s3 = str_to_bytes(hex_decode(sha1(bytes_to_str(seed20) + bytes_to_str(s2))));
    return _xor_bytes(s1, s3);
}

// caching_sha2_password: XOR(SHA256(pw), SHA256(SHA256(SHA256(pw)) || seed))
fn scramble_caching_sha2_password(password, seed_bytes) {
    let pw = str(password);
    if pw == "" { return []; }
    let d1 = str_to_bytes(hex_decode(sha256(pw)));
    let d2 = str_to_bytes(hex_decode(sha256(bytes_to_str(d1))));
    let seed20 = if len(seed_bytes) > 20 { slice(seed_bytes, 0, 20) } else { seed_bytes };
    let d3 = str_to_bytes(hex_decode(sha256(bytes_to_str(d2) + bytes_to_str(seed20))));
    return _xor_bytes(d1, d3);
}

fn compute_auth_response(plugin_name, password, seed_bytes) {
    if plugin_name == "mysql_native_password" {
        return scramble_mysql_native_password(password, seed_bytes);
    }
    if plugin_name == "caching_sha2_password" {
        return scramble_caching_sha2_password(password, seed_bytes);
    }
    throw "mysql_wire_driver: unsupported authentication plugin " + str(plugin_name);
}

// ── HandshakeV10 & HandshakeResponse41 ───────────────────────────────────────

fn parse_handshake_v10(payload) {
    if len(payload) < 32 or payload[0] != 10 {
        throw "mysql_wire_driver: expected HandshakeV10 (0x0A)";
    }
    let ver_cs = _read_cstring(payload, 1);
    let pos = ver_cs.next;
    let conn_id = _read_u32_le(payload, pos);
    let seed_part1 = slice(payload, pos + 4, pos + 12);
    // filler byte at pos + 12
    let cap_lo = _read_u16_le(payload, pos + 13);
    let charset = payload[pos + 15];
    let status_flags = _read_u16_le(payload, pos + 16);
    let cap_hi = _read_u16_le(payload, pos + 18);
    let auth_len = payload[pos + 20];
    // 10 reserved bytes at pos + 21..pos + 31
    pos = pos + 31;

    let seed = [];
    _append_bytes(seed, seed_part1);
    let part2_len = 13;
    if auth_len > 21 { part2_len = auth_len - 8; }
    if pos + part2_len <= len(payload) {
        let part2 = slice(payload, pos, pos + part2_len);
        let k = 0;
        while k < len(part2) and len(seed) < 20 {
            if part2[k] != 0 or k < 12 {
                array_push(seed, part2[k]);
            }
            k = k + 1;
        }
        pos = pos + part2_len;
    }

    let plugin = "mysql_native_password";
    if pos < len(payload) {
        let pl_cs = _read_cstring(payload, pos);
        if pl_cs.text != "" { plugin = pl_cs.text; }
    }

    return map{
        protocol_version: 10,
        server_version: ver_cs.text,
        connection_id: conn_id,
        seed: seed,
        cap_lo: cap_lo,
        cap_hi: cap_hi,
        charset: charset,
        status_flags: status_flags,
        auth_plugin: plugin
    };
}

fn build_handshake_response_41(user, auth_resp, database, auth_plugin) {
    // CLIENT_LONG_PASSWORD(1) | CLIENT_FOUND_ROWS(2) | CLIENT_LONG_FLAG(4) |
    // CLIENT_PROTOCOL_41(512) | CLIENT_TRANSACTIONS(8192) | CLIENT_SECURE_CONNECTION(32768)
    let cap_lo = 41479;
    let has_db = database != nil and database != "";
    if has_db {
        cap_lo = bit_or(cap_lo, 8); // CLIENT_CONNECT_WITH_DB
    }
    // CLIENT_MULTI_RESULTS(2) | CLIENT_PS_MULTI_RESULTS(4) | CLIENT_PLUGIN_AUTH(8)
    let cap_hi = 14;

    let out = [];
    _push_u16_le(out, cap_lo);
    _push_u16_le(out, cap_hi);
    _push_u32_le(out, 16777216);
    array_push(out, CHARSET_UTF8MB4);
    let z = 0;
    while z < 23 { array_push(out, 0); z = z + 1; }
    _push_cstring(out, user);
    array_push(out, len(auth_resp));
    _append_bytes(out, auth_resp);
    if has_db {
        _push_cstring(out, database);
    }
    _push_cstring(out, auth_plugin);
    return out;
}

// ── OK / ERR / EOF / ColumnDefinition41 / Resultset Parsers ──────────────────

fn parse_ok_packet(payload) {
    let r1 = decode_lenenc_int(payload, 1);
    let r2 = decode_lenenc_int(payload, r1.next);
    let pos = r2.next;
    let status = 0;
    let warnings = 0;
    if pos + 3 < len(payload) {
        status = _read_u16_le(payload, pos);
        warnings = _read_u16_le(payload, pos + 2);
    }
    return map{
        ok: true,
        affected_rows: r1.value,
        last_insert_id: r2.value,
        status_flags: status,
        warnings: warnings
    };
}

fn parse_err_packet(payload) {
    let code = _read_u16_le(payload, 1);
    let pos = 3;
    let sqlstate = "HY000";
    if pos + 5 < len(payload) and payload[pos] == 35 { // '#'
        sqlstate = bytes_to_str(slice(payload, pos + 1, pos + 6));
        pos = pos + 6;
    }
    let msg = bytes_to_str(slice(payload, pos, len(payload)));
    return map{ error_code: code, sqlstate: sqlstate, message: msg };
}

fn _is_eof_packet(payload) {
    return len(payload) > 0 and payload[0] == 254 and len(payload) < 9;
}

fn parse_column_def_41(payload) {
    let p0 = decode_lenenc_bytes(payload, 0);       // catalog ("def")
    let p1 = decode_lenenc_bytes(payload, p0.next); // schema
    let p2 = decode_lenenc_bytes(payload, p1.next); // table
    let p3 = decode_lenenc_bytes(payload, p2.next); // org_table
    let p4 = decode_lenenc_bytes(payload, p3.next); // name
    let p5 = decode_lenenc_bytes(payload, p4.next); // org_name
    let fl = decode_lenenc_int(payload, p5.next);   // fixed fields length (0x0C)
    let pos = fl.next;
    let charset = _read_u16_le(payload, pos);
    let col_len = _read_u32_le(payload, pos + 2);
    let col_type = payload[pos + 6];
    let flags = _read_u16_le(payload, pos + 7);
    let decimals = payload[pos + 9];
    return map{
        name: bytes_to_str(p4.bytes),
        charset: charset,
        column_length: col_len,
        column_type: col_type,
        flags: flags,
        decimals: decimals,
        is_unsigned: bit_and(flags, 32) != 0
    };
}

fn _decode_f32_le(b, pos) {
    let bits = _read_u32_le(b, pos);
    let sign = if bit_and(bit_shr(bits, 31), 1) == 1 { -1.0 } else { 1.0 };
    let exp = bit_and(bit_shr(bits, 23), 255);
    let frac = bit_and(bits, 8388607);
    if exp == 0 and frac == 0 { return 0.0; }
    if exp == 255 { return 0.0; }
    if exp == 0 { return sign * (frac / 8388608.0) * num_pow(2.0, -126.0); }
    return sign * (1.0 + (frac / 8388608.0)) * num_pow(2.0, exp - 127.0);
}

fn _coerce_text_col(raw_bytes, col) {
    let t = col.column_type;
    if t == MYSQL_TYPE_BLOB and col.charset == CHARSET_BINARY {
        return raw_bytes;
    }
    let s = bytes_to_str(raw_bytes);
    if t == MYSQL_TYPE_TINY or t == MYSQL_TYPE_SHORT or t == MYSQL_TYPE_LONG or t == MYSQL_TYPE_INT24 or t == MYSQL_TYPE_LONGLONG or t == MYSQL_TYPE_FLOAT or t == MYSQL_TYPE_DOUBLE or t == MYSQL_TYPE_DECIMAL or t == MYSQL_TYPE_NEWDECIMAL {
        let n = try parse_number(s) catch nil;
        if n != nil and n >= (0 - MAX_SAFE_INT) and n <= MAX_SAFE_INT { return n; }
    }
    if t == MYSQL_TYPE_JSON {
        return try json_parse(s) catch s;
    }
    return s;
}

fn parse_text_row(payload, cols) {
    let row = map{};
    let pos = 0;
    let i = 0;
    while i < len(cols) {
        let cell = decode_lenenc_bytes(payload, pos);
        pos = cell.next;
        if cell.is_null {
            row[cols[i].name] = nil;
        } else {
            row[cols[i].name] = _coerce_text_col(cell.bytes, cols[i]);
        }
        i = i + 1;
    }
    return row;
}

fn parse_binary_row(payload, cols) {
    // Packet starts with 0x00, followed by NULL-bitmap with +2 bit offset!
    let col_count = len(cols);
    let bm_len = num_floor((col_count + 7 + 2) / 8);
    let bitmap = slice(payload, 1, 1 + bm_len);
    let pos = 1 + bm_len;
    let row = map{};
    let i = 0;
    while i < col_count {
        let bit_pos = i + 2;
        let byte_idx = num_floor(bit_pos / 8);
        let bit_idx = bit_pos % 8;
        let is_null = bit_and(bitmap[byte_idx], bit_shl(1, bit_idx)) != 0;
        let col = cols[i];
        if is_null or col.column_type == MYSQL_TYPE_NULL {
            row[col.name] = nil;
        } else {
            let ct = col.column_type;
            if ct == MYSQL_TYPE_TINY {
                let b0 = payload[pos];
                pos = pos + 1;
                if not col.is_unsigned and b0 >= 128 { b0 = b0 - 256; }
                row[col.name] = b0;
            } elif ct == MYSQL_TYPE_SHORT {
                row[col.name] = if col.is_unsigned { _read_u16_le(payload, pos) } else { _read_i16_le(payload, pos) };
                pos = pos + 2;
            } elif ct == MYSQL_TYPE_INT24 or ct == MYSQL_TYPE_LONG {
                row[col.name] = if col.is_unsigned { _read_u32_le(payload, pos) } else { _read_i32_le(payload, pos) };
                pos = pos + 4;
            } elif ct == MYSQL_TYPE_LONGLONG {
                row[col.name] = if col.is_unsigned { _read_u64_le(payload, pos) } else { _read_i64_le(payload, pos) };
                pos = pos + 8;
            } elif ct == MYSQL_TYPE_FLOAT {
                row[col.name] = _decode_f32_le(payload, pos);
                pos = pos + 4;
            } elif ct == MYSQL_TYPE_DOUBLE {
                row[col.name] = num_from_le_bytes(slice(payload, pos, pos + 8));
                pos = pos + 8;
            } else {
                // Length-encoded string / blob / json / decimal
                let lb = decode_lenenc_bytes(payload, pos);
                pos = lb.next;
                if ct == MYSQL_TYPE_BLOB and col.charset == CHARSET_BINARY {
                    row[col.name] = lb.bytes;
                } elif ct == MYSQL_TYPE_JSON {
                    let jt = bytes_to_str(lb.bytes);
                    row[col.name] = try json_parse(jt) catch jt;
                } elif ct == MYSQL_TYPE_DECIMAL or ct == MYSQL_TYPE_NEWDECIMAL {
                    let dt = bytes_to_str(lb.bytes);
                    let dn = try parse_number(dt) catch nil;
                    row[col.name] = if dn != nil { dn } else { dt };
                } else {
                    row[col.name] = bytes_to_str(lb.bytes);
                }
            }
        }
        i = i + 1;
    }
    return row;
}

// ── Prepared Statement Packet Builders (0x16, 0x17, 0x19) ────────────────────

fn bytes_param(raw_bytes) {
    return map{ __mysql_blob: true, bytes: raw_bytes };
}

fn build_stmt_prepare_payload(sql) {
    let out = [COM_STMT_PREPARE];
    _append_bytes(out, str_to_bytes(str(sql)));
    return out;
}

fn build_stmt_close_payload(stmt_id) {
    let out = [COM_STMT_CLOSE];
    _push_u32_le(out, stmt_id);
    return out;
}

fn build_stmt_execute_payload(stmt_id, params = nil) {
    if params == nil { params = []; }
    let out = [COM_STMT_EXECUTE];
    _push_u32_le(out, stmt_id);
    array_push(out, 0); // flags = CURSOR_TYPE_NO_CURSOR
    _push_u32_le(out, 1); // iteration_count = 1

    let pcount = len(params);
    if pcount == 0 { return out; }

    let bm_len = num_floor((pcount + 7) / 8);
    let bitmap = [];
    let b = 0;
    while b < bm_len { array_push(bitmap, 0); b = b + 1; }

    let types = [];
    let values = [];
    let i = 0;
    while i < pcount {
        let v = params[i];
        if v == nil {
            let byte_idx = num_floor(i / 8);
            let bit_idx = i % 8;
            bitmap[byte_idx] = bit_or(bitmap[byte_idx], bit_shl(1, bit_idx));
            array_push(types, MYSQL_TYPE_NULL);
            array_push(types, 0);
        } else {
            let kind = type(v);
            if kind == "bool" {
                array_push(types, MYSQL_TYPE_TINY);
                array_push(types, 0);
                array_push(values, if v { 1 } else { 0 });
            } elif kind == "number" {
                if v == num_floor(v) and v >= (0 - MAX_SAFE_INT) and v <= MAX_SAFE_INT {
                    array_push(types, MYSQL_TYPE_LONGLONG);
                    array_push(types, 0);
                    _push_i64_le(values, v);
                } else {
                    array_push(types, MYSQL_TYPE_DOUBLE);
                    array_push(types, 0);
                    _append_bytes(values, num_to_le_bytes(v));
                }
            } elif kind == "map" and ((try v.__mysql_blob catch false) == true or (try v.__bytes catch nil) != nil) {
                let raw = if (try v.__mysql_blob catch false) == true { v.bytes } else { v.__bytes };
                array_push(types, MYSQL_TYPE_BLOB);
                array_push(types, 0);
                encode_lenenc_bytes(values, raw);
            } elif kind == "map" or kind == "array" {
                array_push(types, MYSQL_TYPE_VAR_STRING);
                array_push(types, 0);
                encode_lenenc_bytes(values, str_to_bytes(json_stringify(v)));
            } else {
                array_push(types, MYSQL_TYPE_VAR_STRING);
                array_push(types, 0);
                encode_lenenc_bytes(values, str_to_bytes(str(v)));
            }
        }
        i = i + 1;
    }

    _append_bytes(out, bitmap);
    array_push(out, 1); // new_params_bound_flag = 1
    _append_bytes(out, types);
    _append_bytes(out, values);
    return out;
}

// ── Connection Execution & Handshake Lifecycle ───────────────────────────────

fn _read_resultset(handle, is_binary) {
    let first = read_mysql_packet(handle);
    let p = first.payload;
    if len(p) == 0 {
        throw "mysql_wire_driver: empty response packet";
    }
    if p[0] == 255 {
        let err = parse_err_packet(p);
        throw "mysql_wire_driver [" + str(err.error_code) + " " + err.sqlstate + "]: " + err.message;
    }
    if p[0] == 0 {
        let ok = parse_ok_packet(p);
        return map{
            rows: [],
            columns: [],
            affected_rows: ok.affected_rows,
            last_insert_id: ok.last_insert_id
        };
    }

    let cc = decode_lenenc_int(p, 0).value;
    let cols = [];
    let c = 0;
    while c < cc {
        let cpkt = read_mysql_packet(handle);
        array_push(cols, parse_column_def_41(cpkt.payload));
        c = c + 1;
    }

    // Consume optional column-definition EOF packet (when server doesn't deprecate EOF)
    let pkt = read_mysql_packet(handle);
    let rows = [];
    if not _is_eof_packet(pkt.payload) {
        if pkt.payload[0] == 255 {
            let err2 = parse_err_packet(pkt.payload);
            throw "mysql_wire_driver [" + str(err2.error_code) + "]: " + err2.message;
        }
        array_push(rows, if is_binary { parse_binary_row(pkt.payload, cols) } else { parse_text_row(pkt.payload, cols) });
    }

    while true {
        let rpkt = read_mysql_packet(handle);
        let rp = rpkt.payload;
        if _is_eof_packet(rp) { break; }
        if len(rp) > 0 and rp[0] == 255 {
            let err3 = parse_err_packet(rp);
            throw "mysql_wire_driver [" + str(err3.error_code) + "]: " + err3.message;
        }
        array_push(rows, if is_binary { parse_binary_row(rp, cols) } else { parse_text_row(rp, cols) });
    }

    return map{
        rows: rows,
        columns: cols,
        affected_rows: 0,
        last_insert_id: 0
    };
}

fn _com_query(conn, sql) {
    if not conn.open { throw "mysql_wire_driver: connection is closed"; }
    let body = [COM_QUERY];
    _append_bytes(body, str_to_bytes(str(sql)));
    write_mysql_packet(conn.handle, 0, body);
    conn.queries_run = conn.queries_run + 1;
    let res = _read_resultset(conn.handle, false);
    conn.last_insert_id = res.last_insert_id;
    return res;
}

fn _prepare_raw(conn, sql) {
    if not conn.open { throw "mysql_wire_driver: connection is closed"; }
    write_mysql_packet(conn.handle, 0, build_stmt_prepare_payload(sql));
    let pkt = read_mysql_packet(conn.handle);
    let p = pkt.payload;
    if len(p) > 0 and p[0] == 255 {
        let err = parse_err_packet(p);
        throw "mysql_wire_driver prepare [" + str(err.error_code) + "]: " + err.message;
    }
    if len(p) < 12 or p[0] != 0 {
        throw "mysql_wire_driver: invalid COM_STMT_PREPARE_OK packet";
    }
    let stmt_id = _read_u32_le(p, 1);
    let num_cols = _read_u16_le(p, 5);
    let num_params = _read_u16_le(p, 7);

    if num_params > 0 {
        let i = 0;
        while i < num_params {
            read_mysql_packet(conn.handle);
            i = i + 1;
        }
        // Read trailing EOF for parameter metadata
        read_mysql_packet(conn.handle);
    }
    if num_cols > 0 {
        let j = 0;
        while j < num_cols {
            read_mysql_packet(conn.handle);
            j = j + 1;
        }
        // Read trailing EOF for column metadata
        read_mysql_packet(conn.handle);
    }

    return map{ stmt_id: stmt_id, num_cols: num_cols, num_params: num_params, sql: sql };
}

fn _execute_prepared(conn, stmt_id, params) {
    if not conn.open { throw "mysql_wire_driver: connection is closed"; }
    let payload = build_stmt_execute_payload(stmt_id, params);
    write_mysql_packet(conn.handle, 0, payload);
    conn.queries_run = conn.queries_run + 1;
    let res = _read_resultset(conn.handle, true);
    conn.last_insert_id = res.last_insert_id;
    return res;
}

fn _close_prepared(conn, stmt_id) {
    if not conn.open { return false; }
    write_mysql_packet(conn.handle, 0, build_stmt_close_payload(stmt_id));
    return true;
}

fn _run_parameterized(conn, sql, params = nil) {
    if params == nil or len(params) == 0 {
        return _com_query(conn, sql);
    }
    let meta = _prepare_raw(conn, sql);
    let out = try map{ ok: true, res: _execute_prepared(conn, meta.stmt_id, params) } catch map{ ok: false, res: nil };
    try _close_prepared(conn, meta.stmt_id) catch nil;
    if not out.ok {
        throw "mysql_wire_driver: prepared statement execution failed";
    }
    return out.res;
}

fn _attach_methods(conn) {
    conn.exec = fn(sql, params = nil) {
        let res = _run_parameterized(conn, sql, params);
        return res.affected_rows;
    };

    conn.query = fn(sql, params = nil) {
        let res = _run_parameterized(conn, sql, params);
        return res.rows;
    };

    conn.query_full = fn(sql, params = nil) {
        return _run_parameterized(conn, sql, params);
    };

    conn.prepare = fn(sql) {
        let meta = _prepare_raw(conn, sql);
        let closed = map{ done: false };
        return map{
            stmt_id: meta.stmt_id,
            num_params: meta.num_params,
            num_cols: meta.num_cols,
            sql: sql,
            exec: fn(params = nil) {
                if closed.done { throw "mysql_wire_driver: prepared statement is closed"; }
                return _execute_prepared(conn, meta.stmt_id, params).affected_rows;
            },
            query: fn(params = nil) {
                if closed.done { throw "mysql_wire_driver: prepared statement is closed"; }
                return _execute_prepared(conn, meta.stmt_id, params).rows;
            },
            close: fn() {
                if closed.done { return false; }
                closed.done = true;
                return _close_prepared(conn, meta.stmt_id);
            }
        };
    };

    conn.last_insert_rowid = fn() {
        return conn.last_insert_id;
    };

    conn.transaction = fn(body_fn) {
        _com_query(conn, "START TRANSACTION");
        let out = try body_fn(conn) catch nil;
        if out == nil {
            try _com_query(conn, "ROLLBACK") catch nil;
            return nil;
        }
        _com_query(conn, "COMMIT");
        return out;
    };

    conn.tx = fn(body_fn) {
        _com_query(conn, "START TRANSACTION");
        let r = try map{ ok: true, value: body_fn(conn) } catch map{ ok: false };
        if r.ok {
            _com_query(conn, "COMMIT");
        } else {
            try _com_query(conn, "ROLLBACK") catch nil;
        }
        return r;
    };

    conn.savepoint = fn(name, body_fn) {
        let q = "`" + str_replace_all(str(name), "`", "``") + "`";
        _com_query(conn, "SAVEPOINT " + q);
        let r = try map{ ok: true, value: body_fn(conn) } catch map{ ok: false };
        if not r.ok {
            try _com_query(conn, "ROLLBACK TO SAVEPOINT " + q) catch nil;
        }
        _com_query(conn, "RELEASE SAVEPOINT " + q);
        return r;
    };

    conn.ping = fn() {
        return try {
            write_mysql_packet(conn.handle, 0, [COM_PING]);
            let p = read_mysql_packet(conn.handle);
            len(p.payload) > 0 and p.payload[0] == 0
        } catch false;
    };

    conn.close = fn() {
        if not conn.open { return false; }
        try write_mysql_packet(conn.handle, 0, [COM_QUIT]) catch nil;
        try tcp_close(conn.handle) catch nil;
        conn.open = false;
        return true;
    };

    return conn;
}

fn open(opts) {
    if not is_map(opts) { throw "mysql_wire_driver.open: options map required"; }
    let host = str(_opt(opts, "host", "127.0.0.1"));
    let port = _opt(opts, "port", 3306);
    let user = str(_opt(opts, "user", "root"));
    let password = str(_opt(opts, "password", ""));
    let database = str(_opt(opts, "database", ""));
    let use_tls = _opt(opts, "tls", false) == true;
    let allow_cleartext = _opt(opts, "allow_cleartext", false) == true;

    let handle = nil;
    if use_tls {
        handle = tcp_connect_tls(host, port);
    } else {
        let addr = if str_contains(host, ":") and not str_starts_with(host, "[") {
            "[" + host + "]:" + str(port)
        } else {
            host + ":" + str(port)
        };
        handle = tcp_connect(addr);
    }

    let greet_pkt = read_mysql_packet(handle);
    if len(greet_pkt.payload) > 0 and greet_pkt.payload[0] == 255 {
        let gerr = parse_err_packet(greet_pkt.payload);
        try tcp_close(handle) catch nil;
        throw "mysql_wire_driver greeting error: " + gerr.message;
    }
    let hs = parse_handshake_v10(greet_pkt.payload);
    let auth_resp = compute_auth_response(hs.auth_plugin, password, hs.seed);
    let resp41 = build_handshake_response_41(user, auth_resp, database, hs.auth_plugin);
    let next_seq = write_mysql_packet(handle, greet_pkt.seq_id + 1, resp41);

    let active_plugin = hs.auth_plugin;
    while true {
        let apkt = read_mysql_packet(handle);
        next_seq = apkt.seq_id + 1;
        let ap = apkt.payload;
        if len(ap) == 0 {
            try tcp_close(handle) catch nil;
            throw "mysql_wire_driver: empty authentication packet";
        }
        if ap[0] == 0 {
            // OK_Packet
            break;
        } elif ap[0] == 255 {
            let aerr = parse_err_packet(ap);
            try tcp_close(handle) catch nil;
            throw "mysql_wire_driver auth failed [" + str(aerr.error_code) + "]: " + aerr.message;
        } elif ap[0] == 1 {
            // AuthMoreData for caching_sha2_password
            if len(ap) >= 2 and ap[1] == 3 {
                // Fast auth succeeded; next packet is OK_Packet
                continue;
            } elif len(ap) >= 2 and ap[1] == 4 {
                if not use_tls and not allow_cleartext {
                    try tcp_close(handle) catch nil;
                    throw "mysql_wire_driver: caching_sha2_password full auth refused without TLS";
                }
                let full_pw = [];
                _push_cstring(full_pw, password);
                next_seq = write_mysql_packet(handle, next_seq, full_pw);
            } else {
                try tcp_close(handle) catch nil;
                throw "mysql_wire_driver: unsupported AuthMoreData status";
            }
        } elif ap[0] == 254 {
            // AuthSwitchRequest: [0xFE][plugin_name\0][new_seed...]
            let sw_cs = _read_cstring(ap, 1);
            active_plugin = sw_cs.text;
            let raw_seed = slice(ap, sw_cs.next, len(ap));
            if len(raw_seed) > 0 and raw_seed[len(raw_seed) - 1] == 0 {
                raw_seed = slice(raw_seed, 0, len(raw_seed) - 1);
            }
            let sw_resp = compute_auth_response(active_plugin, password, raw_seed);
            next_seq = write_mysql_packet(handle, next_seq, sw_resp);
        } else {
            try tcp_close(handle) catch nil;
            throw "mysql_wire_driver: unexpected packet during auth";
        }
    }

    let conn = map{
        format: "pblang.db.mysql.v10",
        kind: "mysql",
        handle: handle,
        open: true,
        tls: use_tls,
        host: host,
        port: port,
        user: user,
        database: database,
        server_version: hs.server_version,
        connection_id: hs.connection_id,
        auth_plugin: active_plugin,
        last_insert_id: 0,
        queries_run: 0
    };

    return _attach_methods(conn);
}

fn connect(opts) {
    return try map{ ok: true, conn: open(opts) } catch map{ ok: false, error: "MySQL connection failed" };
}

export COM_QUIT, COM_INIT_DB, COM_QUERY, COM_PING,
       COM_STMT_PREPARE, COM_STMT_EXECUTE, COM_STMT_CLOSE,
       MYSQL_TYPE_DECIMAL, MYSQL_TYPE_TINY, MYSQL_TYPE_SHORT, MYSQL_TYPE_LONG,
       MYSQL_TYPE_FLOAT, MYSQL_TYPE_DOUBLE, MYSQL_TYPE_NULL, MYSQL_TYPE_LONGLONG,
       MYSQL_TYPE_INT24, MYSQL_TYPE_VARCHAR, MYSQL_TYPE_JSON, MYSQL_TYPE_NEWDECIMAL,
       MYSQL_TYPE_BLOB, MYSQL_TYPE_VAR_STRING, MYSQL_TYPE_STRING,
       CHARSET_UTF8MB4, CHARSET_BINARY,
       open, connect, bytes_param,
       encode_lenenc_int, decode_lenenc_int, encode_lenenc_bytes, decode_lenenc_bytes,
       build_mysql_frame, write_mysql_packet, read_mysql_packet,
       scramble_mysql_native_password, scramble_caching_sha2_password, compute_auth_response,
       parse_handshake_v10, build_handshake_response_41,
       parse_ok_packet, parse_err_packet, parse_column_def_41,
       parse_text_row, parse_binary_row,
       build_stmt_prepare_payload, build_stmt_execute_payload, build_stmt_close_payload;
