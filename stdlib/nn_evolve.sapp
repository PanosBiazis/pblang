// stdlib/nn_evolve.sapp — an evolutionary, self-hardening trainer for nn.sapp MLPs that
// composes everything: it GROWS capacity (densify), FORKS clones, trains each variant
// differently (adversarial hardening + curiosity focus), keeps the winner via SAFE_MERGE,
// TRIMS redundancy (jenga_safe_pull), and CHECKPOINTS with nails — all under a
// never-destroy guarantee: the champion's clean loss is monotone non-increasing, so the
// returned net is never worse than the starting net.
//
//   let evo = import("stdlib:nn_evolve.sapp");
//   let r = evo.evolve(net, data, map{ generations: 5, pop: 4, epochs: 60, lr: 0.3,
//                                      epsilon: 0.15, tol: 0.02, grow: true });
//   // r.net is >= the input on clean loss, hardened against adversarial perturbation.

let nn = import("stdlib:nn.sapp");
let ADV = import("stdlib:nn_adversarial.sapp");
let CUR = import("stdlib:nn_curiosity.sapp");

let _BIG = 1000000000;

fn _opt(opts, key, default) {
    if opts == nil { return default; }
    if map_has(opts, key) { let v = opts[key]; if v == nil { return default; } return v; }
    return default;
}

// evolve(net, data, opts) — run the self-improvement loop. opts (all optional):
//   generations (3), pop (3 clones/gen), epochs (40), lr (0.5), epsilon (0.1 adversarial),
//   tol (0.01 trim tolerance), grow (true → densify each generation).
// Returns { net, generations, grew, merges, trims, loss, start_loss }.
fn evolve(net, data, opts) {
    let generations = _opt(opts, "generations", 3);
    let pop = _opt(opts, "pop", 3);
    let epochs = _opt(opts, "epochs", 40);
    let lr = _opt(opts, "lr", 0.5);
    let epsilon = _opt(opts, "epsilon", 0.1);
    let tol = _opt(opts, "tol", 0.01);
    let grow = _opt(opts, "grow", true);

    let champion = nn.clone(net);
    let best = nn.loss(champion, data);
    let start_nail = nn.nail(champion);
    let start_loss = best;

    let grew = 0;
    let merges = 0;
    let trims = 0;
    let g = 0;
    while g < generations {
        let checkpoint = nn.nail(champion);          // roll-back point for this generation

        // 1) GROW capacity (developmental) — function-preserving, so no regression
        let base = champion;
        if grow { base = nn.densify(champion, 1); grew = grew + 1; }

        // 2) FORK clones and train each variant differently (hardening + curiosity)
        let bestVar = nil;
        let bestVarLoss = _BIG;
        let p = 0;
        while p < pop {
            let v = nn.clone(base);
            if num_mod(p, 2) == 0 { ADV.adversarial_train(v, data, epochs, lr, epsilon); }
            else { CUR.curious_train(v, data, epochs, lr, 2); }
            let lv = nn.loss(v, data);
            if lv < bestVarLoss { bestVarLoss = lv; bestVar = v; }
            p = p + 1;
        }

        // 3) SAFE_MERGE the (grown) base with the best variant — same shape as the
        //    variants — kept only if it helps; then also consider the raw best variant.
        //    densify is function-preserving, so loss(base) == loss(champion) == best.
        let candidate = base;
        let candLoss = nn.loss(base, data);
        if bestVar != nil {
            let m = nn.safe_merge(base, bestVar, data, 0.5);
            if m.merged { merges = merges + 1; }
            candidate = m.net; candLoss = nn.loss(candidate, data);
            if bestVarLoss < candLoss { candidate = bestVar; candLoss = bestVarLoss; }
        }

        // 4) TRIM redundant capacity (only if loss stays within tolerance)
        let trimmed = nn.jenga_safe_pull(candidate, data, tol);
        if trimmed.pulled { trims = trims + 1; candidate = trimmed.net; candLoss = nn.loss(candidate, data); }

        // 5) ACCEPT only if it does not increase clean loss; else ROLL BACK to the nail.
        if candLoss <= best + 0.000001 { champion = candidate; best = candLoss; }
        else { champion = nn.restore(checkpoint); }

        g = g + 1;
    }

    // belt-and-suspenders: never return worse than the very start.
    if nn.loss(champion, data) > start_loss + 0.000001 { champion = nn.restore(start_nail); }

    return map{
        net: champion, generations: generations,
        grew: grew, merges: merges, trims: trims,
        loss: nn.loss(champion, data), start_loss: start_loss,
    };
}

export evolve;
