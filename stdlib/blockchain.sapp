//! blockchain.sapp — Blockchain primitives for pblang

fn sha256d(d) { return sha256(sha256(d)); }
fn merkle_root(hashes) {
    if len(hashes) == 0 { return ""; } if len(hashes) == 1 { return hashes[0]; }
    let nl = []; let i=0;
    while i < len(hashes) { if i+1 < len(hashes) { array_push(nl, sha256d(hashes[i]+hashes[i+1])); } else { array_push(nl, sha256d(hashes[i]+hashes[i])); } i=i+2; }
    return merkle_root(nl);
}
fn hash_block(idx, prev, data, nonce) { return sha256d(str(idx)+prev+data+str(nonce)); }
fn mine_block(prev, data, diff) {
    if diff == nil { diff = 4; } let nonce=0;
    while nonce < 1000000 { let h = hash_block(0,prev,data,nonce); let p=""; let d=0; while d<diff{p=p+h[d..(d+1)];d=d+1;} let t=""; let dd=0; while dd<diff{t=t+"0";dd=dd+1;} if p==t { return map{hash:h, nonce:nonce}; } nonce=nonce+1; }
    return map{hash:"", nonce:-1};
}
fn verify_block(b) { let h=hash_block(b["index"],b["prev_hash"],b["data"],b["nonce"]); let diff=b["difficulty"]; if diff==nil{diff=4;} let p="";let d=0;while d<diff{p=p+h[d..(d+1)];d=d+1;} let t=""; let dd=0; while dd<diff{t=t+"0";dd=dd+1;} return p==t; }
fn create_wallet() { let pk=""; let i=0; while i<32 { pk=pk+random_bytes(1); i=i+1; } let pub=sha256(pk); return map{private_key:pk, public_key:pub, address:sha256(pub)}; }
fn sign_data(pk, d) { return hmac_sha256(pk, d); }
fn verify_signature(pub, d, sig) { return hmac_sha256(pub, d) == sig; }
fn create_transaction(from, to, amt, pk) { return map{from:from, to:to, amount:amt, signature:sign_data(pk, from+to+str(amt))}; }
fn verify_chain(chain) { let i=1; while i < len(chain) { if chain[i]["prev_hash"] != chain[i-1]["hash"] { return false; } if not verify_block(chain[i]) { return false; } i=i+1; } return true; }

export sha256d; export merkle_root; export hash_block; export mine_block;
export verify_block; export create_wallet; export sign_data; export verify_signature;
export create_transaction; export verify_chain;
