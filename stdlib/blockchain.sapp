//! blockchain.sapp — Blockchain primitives for pblang

fn sha256d(d) { return sha256(sha256(d)); }
fn merkle_root(hashes) {
    if len(hashes) == 0 { return ""; } if len(hashes) == 1 { return hashes[0]; }
    let nl = []; let i=0;
    while i < len(hashes) { if i+1 < len(hashes) { array_push(nl, sha256d(hashes[i]+hashes[i+1])); } else { array_push(nl, sha256d(hashes[i]+hashes[i])); } i=i+2; }
    return merkle_root(nl);
}
fn hash_block(idx, prev, data, nonce) { return sha256d(str(idx)+prev+data+str(nonce)); }
fn mine_block(prev, data, diff = 4) {
    let nonce=0;
    while nonce < 1000000 {
        let h = hash_block(0, prev, data, nonce);
        let p = "";
        let d = 0;
        while d < diff {
            p = p + str_slice(h, d, d + 1);
            d = d + 1;
        }
        let t = "";
        let dd = 0;
        while dd < diff { t = t + "0"; dd = dd + 1; }
        if p == t { return map{hash:h, nonce:nonce}; }
        nonce = nonce + 1;
    }
    return map{hash:"", nonce:-1};
}
fn verify_block(b) {
    let h = hash_block(b["index"], b["prev_hash"], b["data"], b["nonce"]);
    let diff = b["difficulty"];
    if diff == nil { diff = 4; }
    let p = "";
    let d = 0;
    while d < diff {
        p = p + str_slice(h, d, d + 1);
        d = d + 1;
    }
    let t = "";
    let dd = 0;
    while dd < diff { t = t + "0"; dd = dd + 1; }
    return p == t;
}
// The former wallet API mislabeled unrelated HMAC values as public-key
// signatures. In particular, verify_signature used the public value as an
// HMAC secret, so every observer could forge an accepted result. Keep the
// exported compatibility surface fail-closed until a VM/runtime-owned,
// independently verified asymmetric signature capability is available.
fn authenticity_status() {
    return map{
        format: "pblang.blockchain-authenticity.v1",
        available: false,
        algorithm: "none",
        public_key_signatures_verified: false,
        publisher_authenticity_verified: false,
        legacy_hmac_signature_scheme_rejected: true,
        reason: "public-key signatures are unavailable; symmetric HMAC is not publisher identity"
    };
}
fn create_wallet() {
    return map{ok:false, available:false, private_key:nil, public_key:nil,
        address:nil, error:"public-key wallet generation is unavailable"};
}
fn sign_data(_private_key, _data) { return nil; }
fn verify_signature(_public_key, _data, _signature) { return false; }
fn create_transaction(from, to, amt, _private_key) {
    return map{ok:false, from:from, to:to, amount:amt, signature:nil,
        signed:false, error:"transaction signing is unavailable"};
}
fn verify_chain(chain) { let i=1; while i < len(chain) { if chain[i]["prev_hash"] != chain[i-1]["hash"] { return false; } if not verify_block(chain[i]) { return false; } i=i+1; } return true; }

export sha256d; export merkle_root; export hash_block; export mine_block;
export verify_block; export create_wallet; export sign_data; export verify_signature;
export create_transaction; export verify_chain; export authenticity_status;
