// stdlib/heap.sapp — binary heap (priority queue) with correct in-place
// mutation. A heap is map{ data: [], min: <bool> }; push/pop mutate `data`
// in place (arrays are reference values), so callers see the updates.
//
//   let heap = import("stdlib:heap.sapp");
//   let h = heap.new_min();
//   heap.push(h, 5); heap.push(h, 1); heap.push(h, 3);
//   heap.pop(h)   // 1
//   heap.pop(h)   // 3
//   heap.heapsort([5,3,8,1,9,2], true)   // [1,2,3,5,8,9]

fn new(is_min) { return map{ data: [], min: is_min }; }
fn new_min() { return new(true); }
fn new_max() { return new(false); }

fn size(h) { return len(h["data"]); }
fn is_empty(h) { return len(h["data"]) == 0; }
fn peek(h) { if len(h["data"]) == 0 { return nil; } return h["data"][0]; }

fn _idiv(a, b) { return num_floor(a / b); }
fn _swap(d, i, j) { let t = d[i]; d[i] = d[j]; d[j] = t; }

// Should element `a` rank above element `b` (toward the root)?
fn _higher(h, a, b) {
    if h["min"] { return a < b; }
    return a > b;
}

fn _sift_up(h, i) {
    let d = h["data"];
    while i > 0 {
        let p = _idiv(i - 1, 2);
        if _higher(h, d[i], d[p]) { _swap(d, i, p); i = p; }
        else { i = -1; }   // stop
    }
}

fn _sift_down(h, i) {
    let d = h["data"];
    let n = len(d);
    let going = true;
    while going {
        let l = 2 * i + 1;
        let r = 2 * i + 2;
        let best = i;
        if l < n and _higher(h, d[l], d[best]) { best = l; }
        if r < n and _higher(h, d[r], d[best]) { best = r; }
        if best == i { going = false; }
        else { _swap(d, i, best); i = best; }
    }
}

fn push(h, v) {
    let d = h["data"];
    array_push(d, v);
    _sift_up(h, len(d) - 1);
    return h;
}

// pop the root (min or max); returns nil if empty.
fn pop(h) {
    let d = h["data"];
    let n = len(d);
    if n == 0 { return nil; }
    let root = d[0];
    let last = array_pop(d);          // shrink by one
    if n > 1 { d[0] = last; _sift_down(h, 0); }
    return root;
}

fn from_array(arr, is_min) {
    let h = new(is_min);
    for v in arr { push(h, v); }
    return h;
}

// to_sorted_array(h) — destructively drain the heap into a sorted array.
fn to_sorted_array(h) {
    let out = [];
    while len(h["data"]) > 0 { array_push(out, pop(h)); }
    return out;
}

// heapsort(arr, ascending) — non-destructive sort of arr via a heap.
fn heapsort(arr, ascending) {
    let h = from_array(arr, ascending);
    return to_sorted_array(h);
}

export new, new_min, new_max, size, is_empty, peek, push, pop,
       from_array, to_sorted_array, heapsort;
