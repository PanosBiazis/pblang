// pblang build system module
// Provides native compilation and transpilation utilities

fn host_platform() {
    let osm = import("stdlib:os.sapp");
    return osm.platform();
}

/// Check if native compilation is supported on this system.
/// Returns true if a C compiler (cc/gcc/clang) is available.
fn is_native_supported() {
    let result = exec("cc --version 2>/dev/null || gcc --version 2>/dev/null || clang --version 2>/dev/null || echo NOTFOUND");
    return !str_contains(result, "NOTFOUND") and !str_contains(result, "pblang: error");
}

/// Get the host target triple (e.g. "x86_64-unknown-linux-gnu").
fn target_triple() {
    let p = host_platform();
    if p == "windows" {
        return "x86_64-pc-windows-msvc";
    }
    if p == "macos" {
        return "x86_64-apple-darwin";
    }
    return "x86_64-unknown-linux-gnu";
}

/// Compile a .sapp source file to a native executable.
/// Uses the pblang → C transpiler + system C compiler.
/// Returns a map with { success: bool, output: string, error: string }.
fn compile(source_path, output_path) {
    let result = map{
        success: false,
        output: output_path,
        error: ""
    };

    let src = fs_read(source_path);
    if src == nil {
        result.error = "cannot read source file: " + source_path;
        return result;
    }

    let c_path = output_path + ".c";
    let write_result = fs_write(c_path, src);
    if write_result != nil {
        result.error = "cannot write temp C file";
        return result;
    }

    let cc = "cc";
    let cc_check = exec("which cc 2>/dev/null || which gcc 2>/dev/null || which clang 2>/dev/null || echo NOTFOUND");
    if str_contains(cc_check, "gcc") {
        cc = "gcc";
    } else if str_contains(cc_check, "clang") {
        cc = "clang";
    } else if str_contains(cc_check, "NOTFOUND") {
        result.error = "no C compiler found (install gcc or clang)";
        return result;
    }

    let compile_cmd = cc + " -O2 -o " + output_path + " " + c_path + " -lm";
    let compile_output = exec(compile_cmd);

    if fs_exists(output_path) {
        result.success = true;
        fs_remove(c_path);
    } else {
        result.error = "compilation failed: " + compile_output;
    }

    return result;
}

/// Transpile a .sapp source to C99.
/// Returns a map with { success: bool, c_source: string, error: string }.
fn transpile(source_path, output_path) {
    let result = map{
        success: false,
        c_source: "",
        error: ""
    };

    let src = fs_read(source_path);
    if src == nil {
        result.error = "cannot read source file: " + source_path;
        return result;
    }

    let cmd = "pblang transpile " + source_path + " -o " + output_path;
    let output = exec(cmd);

    if fs_exists(output_path) {
        result.success = true;
        result.c_source = fs_read(output_path);
    } else {
        result.error = output;
    }

    return result;
}

/// Get information about the build environment.
fn info() {
    let result = map{
        os: "",
        arch: "",
        cc: "none",
        target: target_triple(),
        native_supported: false
    };

    let p = host_platform();
    if p == "windows" {
        result.os = "windows";
    } else if p == "macos" {
        result.os = "macos";
    } else {
        result.os = "linux";
    }

    result.native_supported = is_native_supported();

    if result.native_supported {
        let cc_check = exec("which cc 2>/dev/null || which gcc 2>/dev/null || which clang 2>/dev/null || echo none");
        if str_contains(cc_check, "gcc") {
            result.cc = "gcc";
        } else if str_contains(cc_check, "clang") {
            result.cc = "clang";
        } else if str_contains(cc_check, "cc") {
            result.cc = "cc";
        }
    }

    return result;
}

export is_native_supported, target_triple, compile, transpile, info;
