// stdlib/security.sapp — Security utilities for pblang.
//
// Password hashing, token generation, input sanitization,
// rate-limiting helpers, and cryptographic best practices.
//
// Usage:
//   let sec = import("stdlib:security.sapp");
//   let hash = sec.hash_password("mypassword");
//   let ok = sec.verify_password("mypassword", hash);

// ── Password hashing (bcrypt-like via sha256 + salt) ──────────────────────────
//
// NOTE: for NEW code prefer hash_password_pbkdf2 / verify_password_pbkdf2 (defined
// below). This salted single-SHA-256 scheme is fast to brute-force offline; PBKDF2
// applies a keyed HMAC over many iterations to slow attackers down substantially.
// These two functions are kept unchanged for backward compatibility.

fn hash_password(password) {
    let salt = random_hex(16);
    let salted = salt + password;
    let hash = sha256(salted);
    return salt + ":" + hash;
}

fn verify_password(password, stored) {
    let parts = str_split(stored, ":");
    if len(parts) != 2 { return false; }
    let salt = parts[0];
    let expected_hash = parts[1];
    let computed = sha256(salt + password);
    return constant_time_eq(computed, expected_hash);
}

// random_hex(n) — n random bytes as a hex string. (hex_encode() only accepts a
// STRING, so encoding the raw byte array directly threw — previously breaking
// hash_password; do the byte→hex conversion here.)
fn random_hex(n) {
    let bytes = random_bytes(n);
    let h = "0123456789abcdef";
    let out = "";
    let i = 0;
    while i < len(bytes) {
        let b = bytes[i];
        out = out + str_slice(h, num_floor(b / 16), num_floor(b / 16) + 1) + str_slice(h, b % 16, (b % 16) + 1);
        i = i + 1;
    }
    return out;
}

// ── Token generation ──────────────────────────────────────────────────────────

fn generate_token(length = nil) {
    if length == nil { length = 32; }
    let bytes = random_bytes(length);
    // random_bytes returns a byte array, so use the byte-array base64 builtin —
    // base64_encode() is the string variant and rejects raw bytes.
    return base64_encode_bytes(bytes);
}

fn generate_csrf_token() {
    return generate_token(32);
}

fn generate_api_key() {
    return "pbl_" + generate_token(24);
}

fn generate_session_id() {
    return generate_token(32);
}

// ── Input validation / sanitization ───────────────────────────────────────────

fn sanitize_html(text) {
    let result = "";
    for i in 0 to len(text) - 1 {
        let ch = text[i];
        if ch == "<" { result = result + "&lt;"; }
        else if ch == ">" { result = result + "&gt;"; }
        else if ch == "&" { result = result + "&amp;"; }
        else if ch == "\"" { result = result + "&quot;"; }
        else if ch == "'" { result = result + "&#39;"; }
        else { result = result + ch; }
    }
    return result;
}

fn sanitize_sql_identifier(name) {
    // Only allow alphanumeric + underscore
    let result = "";
    for i in 0 to len(name) - 1 {
        let ch = name[i];
        let code = strcharcodeat(ch, 0);
        if (code >= 48 and code <= 57) or (code >= 65 and code <= 90)
           or (code >= 97 and code <= 122) or code == 95 {
            result = result + ch;
        }
    }
    return result;
}

fn is_valid_email(email) {
    // Basic email validation
    if not str_contains(email, "@") { return false; }
    if not str_contains(email, ".") { return false; }
    let parts = str_split(email, "@");
    if len(parts) != 2 { return false; }
    if len(parts[0]) == 0 or len(parts[1]) == 0 { return false; }
    return true;
}

fn is_strong_password(password) {
    // At least 8 chars, has upper, lower, digit, special
    if len(password) < 8 { return false; }
    let has_upper = false;
    let has_lower = false;
    let has_digit = false;
    let has_special = false;
    for i in 0 to len(password) - 1 {
        let code = strcharcodeat(password[i], 0);
        if code >= 65 and code <= 90 { has_upper = true; }
        else if code >= 97 and code <= 122 { has_lower = true; }
        else if code >= 48 and code <= 57 { has_digit = true; }
        else { has_special = true; }
    }
    return has_upper and has_lower and has_digit and has_special;
}

// ── Rate limiting helpers ─────────────────────────────────────────────────────

fn rate_limiter(max_requests, window_seconds) {
    let hits = [];
    return map{
        max: max_requests,
        window: window_seconds,
        hits: hits,
    };
}

fn rate_limit_check(limiter) {
    let now = now_ms();
    let window_ms = limiter.window * 1000;
    // Remove old hits
    let new_hits = [];
    for h in limiter.hits {
        if now - h < window_ms {
            push(new_hits, h);
        }
    }
    limiter.hits = new_hits;
    if len(limiter.hits) >= limiter.max {
        return false;
    }
    push(limiter.hits, now);
    return true;
}

// ── JWT helpers ───────────────────────────────────────────────────────────────

// NOTE: stdlib:jwt.sapp is the canonical, RFC-7515 JWT (raw-byte base64url
// signatures, algorithm allowlist, exp/nbf/aud/iss). These helpers are a
// lightweight in-module variant; prefer jwt.sapp for interoperable tokens.
fn create_jwt(payload, secret) {
    let header = base64_encode(json_stringify(map{
        alg: "HS256",
        typ: "JWT",
    }));
    let body = base64_encode(json_stringify(payload));
    // HMAC is keyed by the SECRET over the (header.body) message — the builtin is
    // hmac_sha256(message, key); the args were previously swapped (secret as the
    // message, public data as the key), which is cryptographically unsound.
    let signature = hmac_sha256(header + "." + body, secret);
    let sig_b64 = base64_encode(signature);
    return header + "." + body + "." + sig_b64;
}

fn verify_jwt(token, secret) {
    let parts = str_split(token, ".");
    if len(parts) != 3 { return nil; }
    let expected_sig = hmac_sha256(parts[0] + "." + parts[1], secret);
    let expected_b64 = base64_encode(expected_sig);
    if not constant_time_eq(parts[2], expected_b64) { return nil; }
    let payload_json = base64_decode(parts[1]);
    return json_parse(payload_json);
}

// ── HMAC-based helpers ────────────────────────────────────────────────────────

fn secure_compare(a, b) {
    return constant_time_eq(a, b);
}

fn hash_file(path) {
    let content = fs_read(path);
    return sha256(content);
}

// mask_secret(s) — redact a secret for logs, revealing only the last 4 chars.
fn mask_secret(s) {
    let n = len(s);
    if n <= 4 {
        let out = ""; let i = 0;
        while i < n { out = out + "*"; i = i + 1; }
        return out;
    }
    let stars = ""; let i = 0;
    while i < n - 4 { stars = stars + "*"; i = i + 1; }
    return stars + str_slice(s, n - 4, n);
}

// password_strength_score(password) — 0..5: +1 each for length>=8, an uppercase,
// a lowercase, a digit, and a special character.
fn password_strength_score(password) {
    let score = 0;
    if len(password) >= 8 { score = score + 1; }
    let has_upper = false; let has_lower = false; let has_digit = false; let has_special = false;
    let i = 0;
    while i < len(password) {
        let code = strcharcodeat(password[i], 0);
        if code >= 65 and code <= 90 { has_upper = true; }
        else if code >= 97 and code <= 122 { has_lower = true; }
        else if code >= 48 and code <= 57 { has_digit = true; }
        else { has_special = true; }
        i = i + 1;
    }
    if has_upper { score = score + 1; }
    if has_lower { score = score + 1; }
    if has_digit { score = score + 1; }
    if has_special { score = score + 1; }
    return score;
}

// random_pin(n) — an n-digit numeric PIN (cryptographically random).
fn random_pin(n) {
    if type(n) != "number" or num_floor(n) != n or n < 1 or n > 128 {
        throw "security: PIN length must be an integer in 1..128";
    }
    let out = "";
    // Reject 250..255 so each decimal digit has exactly 25 preimages.
    // A direct byte % 10 introduces modulo bias.
    while len(out) < n {
        let bytes = random_bytes(n - len(out));
        let i = 0;
        while i < len(bytes) and len(out) < n {
            if bytes[i] < 250 { out = out + str(num_mod(bytes[i], 10)); }
            i = i + 1;
        }
    }
    return out;
}

// ── hex helpers (hmac_sha256/sha256 builtins return a HEX STRING) ─────────────────

// _hex_to_bytes(hex) — decode a hex string into a byte-value array. hmac_sha256()
// returns 64 hex chars = 32 raw bytes; HOTP dynamic truncation needs those bytes.
fn _hex_to_bytes(hex) {
    let h = str_lower(hex);
    let bytes = [];
    let i = 0;
    while i + 1 < len(h) {
        let hi = str_index_of("0123456789abcdef", str_slice(h, i, i + 1));
        let lo = str_index_of("0123456789abcdef", str_slice(h, i + 1, i + 2));
        bytes[len(bytes)] = hi * 16 + lo;
        i = i + 2;
    }
    return bytes;
}

// _ipow(base, n) — exact integer base^n via repeated multiplication (avoids f64
// rounding that num_pow would introduce for large exponents, e.g. 256^7 > 2^53).
fn _ipow(base, n) {
    let r = 1;
    let i = 0;
    while i < n { r = r * base; i = i + 1; }
    return r;
}

// _bytes_to_hex(bytes) — encode a byte-value array as a lowercase hex string.
fn _bytes_to_hex(bytes) {
    let h = "0123456789abcdef";
    let out = "";
    let i = 0;
    while i < len(bytes) {
        let b = bytes[i];
        out = out + str_slice(h, num_floor(b / 16), num_floor(b / 16) + 1) + str_slice(h, b % 16, (b % 16) + 1);
        i = i + 1;
    }
    return out;
}

// ── PBKDF2-HMAC-SHA256 (RFC 2898 / RFC 8018) ─────────────────────────────────────
//
// Recommended over the legacy hash_password/verify_password (salted single-SHA-256)
// for NEW code: PBKDF2 applies a keyed HMAC over many iterations, making offline
// password cracking far slower. Built ONLY on the hmac_sha256 builtin.
//
// BINARY-DOMAIN NOTE: hmac_sha256 takes a STRING and hashes its UTF-8 bytes, and
// bytes_to_str() rejects non-UTF-8, so raw HMAC digests cannot be safely fed back
// in as messages. This implementation therefore carries the moving factor and the
// U-chain in their HEX-STRING form (an ASCII, injective encoding of the bytes).
// The construction is exactly PBKDF2's F-function / U-cascade over HMAC-SHA256 with
// hex-encoded messages: deterministic, salted, iteration-hardened, and internally
// consistent. Codes/keys will not match a byte-message reference implementation.
//
// pbkdf2_sha256(password, salt, iterations, dklen) — salt is a raw string,
// iterations is the work factor, dklen is the derived-key length IN BYTES.
// Returns the derived key as a lowercase hex string (2*dklen chars).
fn pbkdf2_sha256(password, salt, iterations, dklen) {
    // hLen for HMAC-SHA256 is 32 bytes. Number of blocks to cover dklen.
    let hlen = 32;
    let n_blocks = num_floor((dklen + hlen - 1) / hlen);   // ceil(dklen / hlen)
    let derived = [];
    let block = 1;
    while block <= n_blocks {
        // INT(block): 4-byte big-endian block index, hex-appended to the salt for U1.
        let b0 = num_floor(block / 16777216) % 256;
        let b1 = num_floor(block / 65536) % 256;
        let b2 = num_floor(block / 256) % 256;
        let b3 = block % 256;
        let salt_block = salt + _bytes_to_hex([b0, b1, b2, b3]);
        // U1 = HMAC(password, salt || INT(block)); T = U1. Carry U as its hex string.
        let u_hex = hmac_sha256(salt_block, password);
        let u = _hex_to_bytes(u_hex);
        let t = [];
        let k = 0;
        while k < len(u) { t[len(t)] = u[k]; k = k + 1; }
        // U2..Uc: fold each subsequent HMAC into T by XOR (RFC 2898 F function).
        let it = 1;
        while it < iterations {
            // U_next = HMAC(password, U_prev): PRF keyed by the password over the
            // hex-encoded previous U (ASCII message; see BINARY-DOMAIN NOTE).
            u_hex = hmac_sha256(u_hex, password);
            u = _hex_to_bytes(u_hex);
            let j = 0;
            while j < len(t) { t[j] = bit_xor(t[j], u[j]); j = j + 1; }
            it = it + 1;
        }
        // Append this block's hLen bytes to the derived key.
        let m = 0;
        while m < len(t) { derived[len(derived)] = t[m]; m = m + 1; }
        block = block + 1;
    }
    // Truncate to dklen bytes and hex-encode.
    let out = [];
    let i = 0;
    while i < dklen and i < len(derived) { out[len(out)] = derived[i]; i = i + 1; }
    return _bytes_to_hex(out);
}

// hash_password_pbkdf2(password, iterations) — produce a self-describing hash
// string: "pbkdf2_sha256$<iters>$<salt_hex>$<dk_hex>". Preferred for new code.
// The salt is carried as hex text and used directly as the PBKDF2 salt string.
fn hash_password_pbkdf2(password, iterations = 100000) {
    let salt_hex = random_hex(16);           // 16-byte random salt (hex text)
    let dk = pbkdf2_sha256(password, salt_hex, iterations, 32);
    return "pbkdf2_sha256$" + str(iterations) + "$" + salt_hex + "$" + dk;
}

// verify_password_pbkdf2(password, stored) — parse a hash_password_pbkdf2 string
// and constant-time compare against a freshly derived key.
fn verify_password_pbkdf2(password, stored) {
    let parts = str_split(stored, "$");
    if len(parts) != 4 { return false; }
    if parts[0] != "pbkdf2_sha256" { return false; }
    let iterations = parse_number(parts[1]);
    let salt_hex = parts[2];
    let expected = parts[3];
    let dklen = num_floor(len(expected) / 2);
    let computed = pbkdf2_sha256(password, salt_hex, iterations, dklen);
    return constant_time_eq(computed, expected);
}

// ── Base32 (RFC 4648) — needed so authenticator-app secrets interoperate ─────────
//
// Self-contained here so 2FA works without a second import. For a full-featured
// codec (base32hex, validation) see stdlib/base32.sapp.
let _B32_ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";

// base32_decode(s) — RFC 4648 standard alphabet -> byte-value array. Uppercases,
// ignores "=" padding and whitespace. Throws on an out-of-alphabet character.
fn base32_decode(s) {
    let up = str_upper(s);
    let buffer = 0;
    let bits = 0;
    let out = [];
    let i = 0;
    while i < len(up) {
        let c = str_slice(up, i, i + 1);
        if c != "=" and c != " " and c != "\n" and c != "\r" and c != "\t" {
            let v = str_index_of(_B32_ALPHA, c);
            if v < 0 { throw "base32_decode: invalid character '" + c + "'"; }
            buffer = buffer * 32 + v;
            bits = bits + 5;
            if bits >= 8 {
                bits = bits - 8;
                let p = _ipow(2, bits);
                out[len(out)] = num_floor(buffer / p) % 256;
                buffer = buffer % p;
            }
        }
        i = i + 1;
    }
    return out;
}

// base32_encode(bytes) — RFC 4648 standard alphabet with "=" padding. Accepts a
// byte-value array.
fn base32_encode(bytes) {
    let out = "";
    let buffer = 0;
    let bits = 0;
    let i = 0;
    while i < len(bytes) {
        buffer = buffer * 256 + bytes[i];
        bits = bits + 8;
        while bits >= 5 {
            bits = bits - 5;
            let p = _ipow(2, bits);
            let idx = num_floor(buffer / p) % 32;
            out = out + str_slice(_B32_ALPHA, idx, idx + 1);
            buffer = buffer % p;
        }
        i = i + 1;
    }
    if bits > 0 {
        let idx = (buffer * _ipow(2, 5 - bits)) % 32;
        out = out + str_slice(_B32_ALPHA, idx, idx + 1);
    }
    while len(out) % 8 != 0 { out = out + "="; }
    return out;
}

// ── HOTP (RFC 4226) / TOTP (RFC 6238) ────────────────────────────────────────────
//
// NOTE ON HASH: classic HOTP/TOTP use HMAC-SHA1. Only hmac_sha256 is available as a
// builtin here, so this implements the HOTP construction over HMAC-SHA256. This is a
// valid, RFC-6238-sanctioned variant (RFC 6238 §1.2 explicitly allows SHA-256/512);
// codes will NOT match a SHA-1 authenticator. Dynamic truncation uses the low 4 bits
// of the LAST HMAC byte as the offset, exactly as RFC 4226 §5.3 specifies.
//
// BINARY-DOMAIN NOTE: as in PBKDF2 above, hmac_sha256 hashes a STRING's UTF-8 bytes
// and non-UTF-8 bytes cannot be reconstructed into a string, so the key and moving
// factor are passed in their HEX-STRING form (ASCII, injective). Deterministic and
// self-consistent; codes differ from a raw-byte-message reference implementation.

// _hotp_secret_hex(secret) — normalise the secret to a lowercase hex string,
// accepting either a raw byte-value array or an existing hex string.
fn _hotp_secret_hex(secret) {
    if is_array(secret) { return _bytes_to_hex(secret); }
    return str_lower(secret);
}

// hotp(secret, counter, digits) — RFC 4226 HOTP over HMAC-SHA256.
// secret: byte-value array OR hex string. counter: 8-byte big-endian moving factor.
// Returns a zero-padded decimal string of `digits` length.
fn hotp(secret, counter, digits = 6) {
    let key = _hotp_secret_hex(secret);
    // Encode counter as 8 big-endian byte values, then as a 16-char hex message.
    let cbytes = [];
    let shift = 7;
    while shift >= 0 {
        let byte = num_floor(counter / _ipow(256, shift)) % 256;
        cbytes[len(cbytes)] = byte;
        shift = shift - 1;
    }
    let msg = _bytes_to_hex(cbytes);
    // HMAC-SHA256 (hex) -> 32 raw bytes for dynamic truncation.
    let mac = _hex_to_bytes(hmac_sha256(msg, key));
    // Offset = low 4 bits of the LAST byte (RFC 4226 §5.3).
    let offset = bit_and(mac[len(mac) - 1], 15);
    // 31-bit dynamic binary code from 4 bytes at the offset.
    let bin = bit_and(mac[offset], 127) * 16777216
            + mac[offset + 1] * 65536
            + mac[offset + 2] * 256
            + mac[offset + 3];
    let modulo = _ipow(10, digits);
    let code = bin % modulo;
    // Zero-pad to `digits`.
    let out = str(code);
    while len(out) < digits { out = "0" + out; }
    return out;
}

// totp(secret, unix_time, step, digits) — RFC 6238 TOTP = HOTP over the time step.
// Pass unix_time explicitly (seconds since epoch). step defaults to 30s.
fn totp(secret, unix_time, step = 30, digits = 6) {
    let counter = num_floor(unix_time / step);
    return hotp(secret, counter, digits);
}

// totp_now(secret, step, digits) — convenience using the host clock. now_ms() is the
// only wall-clock builtin, so unix seconds = floor(now_ms()/1000).
fn totp_now(secret, step = 30, digits = 6) {
    let unix_time = num_floor(now_ms() / 1000);
    return totp(secret, unix_time, step, digits);
}

// totp_verify(secret, code, unix_time, step, digits, skew) — accept `code` if it
// matches the current window or any window within +/- skew steps. Constant-time
// compare each candidate to avoid leaking which window matched.
fn totp_verify(secret, code, unix_time, step = 30, digits = 6, skew = 1) {
    let counter = num_floor(unix_time / step);
    let w = 0 - skew;
    let matched = false;
    while w <= skew {
        let candidate = hotp(secret, counter + w, digits);
        if constant_time_eq(candidate, code) { matched = true; }
        w = w + 1;
    }
    return matched;
}

export mask_secret, password_strength_score, random_pin;
export pbkdf2_sha256, hash_password_pbkdf2, verify_password_pbkdf2;
export base32_decode, base32_encode;
export hotp, totp, totp_now, totp_verify;
export hash_password, verify_password, generate_token, generate_csrf_token;
export generate_api_key, generate_session_id;
export sanitize_html, sanitize_sql_identifier, is_valid_email, is_strong_password;
export rate_limiter, rate_limit_check;
export create_jwt, verify_jwt;
export secure_compare, hash_file;
