// stdlib/security.sapp — Security utilities for pblang.
//
// Password hashing, token generation, input sanitization,
// rate-limiting helpers, and cryptographic best practices.
//
// Usage:
//   let sec = import("stdlib:security.sapp");
//   let hash = sec.hash_password("mypassword");
//   let ok = sec.verify_password("mypassword", hash);

// ── Password hashing (bcrypt-like via sha256 + salt) ──────────────────────────

fn hash_password(password) {
    let salt = random_hex(16);
    let salted = salt + password;
    let hash = sha256(salted);
    return salt + ":" + hash;
}

fn verify_password(password, stored) {
    let parts = str_split(stored, ":");
    if len(parts) != 2 { return false; }
    let salt = parts[0];
    let expected_hash = parts[1];
    let computed = sha256(salt + password);
    return constant_time_eq(computed, expected_hash);
}

fn random_hex(n) {
    let bytes = random_bytes(n);
    return hex_encode(bytes);
}

// ── Token generation ──────────────────────────────────────────────────────────

fn generate_token(length = nil) {
    if length == nil { length = 32; }
    let bytes = random_bytes(length);
    // random_bytes returns a byte array, so use the byte-array base64 builtin —
    // base64_encode() is the string variant and rejects raw bytes.
    return base64_encode_bytes(bytes);
}

fn generate_csrf_token() {
    return generate_token(32);
}

fn generate_api_key() {
    return "pbl_" + generate_token(24);
}

fn generate_session_id() {
    return generate_token(32);
}

// ── Input validation / sanitization ───────────────────────────────────────────

fn sanitize_html(text) {
    let result = "";
    for i in 0 to len(text) - 1 {
        let ch = text[i];
        if ch == "<" { result = result + "&lt;"; }
        else if ch == ">" { result = result + "&gt;"; }
        else if ch == "&" { result = result + "&amp;"; }
        else if ch == "\"" { result = result + "&quot;"; }
        else if ch == "'" { result = result + "&#39;"; }
        else { result = result + ch; }
    }
    return result;
}

fn sanitize_sql_identifier(name) {
    // Only allow alphanumeric + underscore
    let result = "";
    for i in 0 to len(name) - 1 {
        let ch = name[i];
        let code = strcharcodeat(ch, 0);
        if (code >= 48 and code <= 57) or (code >= 65 and code <= 90)
           or (code >= 97 and code <= 122) or code == 95 {
            result = result + ch;
        }
    }
    return result;
}

fn is_valid_email(email) {
    // Basic email validation
    if not str_contains(email, "@") { return false; }
    if not str_contains(email, ".") { return false; }
    let parts = str_split(email, "@");
    if len(parts) != 2 { return false; }
    if len(parts[0]) == 0 or len(parts[1]) == 0 { return false; }
    return true;
}

fn is_strong_password(password) {
    // At least 8 chars, has upper, lower, digit, special
    if len(password) < 8 { return false; }
    let has_upper = false;
    let has_lower = false;
    let has_digit = false;
    let has_special = false;
    for i in 0 to len(password) - 1 {
        let code = strcharcodeat(password[i], 0);
        if code >= 65 and code <= 90 { has_upper = true; }
        else if code >= 97 and code <= 122 { has_lower = true; }
        else if code >= 48 and code <= 57 { has_digit = true; }
        else { has_special = true; }
    }
    return has_upper and has_lower and has_digit and has_special;
}

// ── Rate limiting helpers ─────────────────────────────────────────────────────

fn rate_limiter(max_requests, window_seconds) {
    let hits = [];
    return map{
        max: max_requests,
        window: window_seconds,
        hits: hits,
    };
}

fn rate_limit_check(limiter) {
    let now = now_ms();
    let window_ms = limiter.window * 1000;
    // Remove old hits
    let new_hits = [];
    for h in limiter.hits {
        if now - h < window_ms {
            push(new_hits, h);
        }
    }
    limiter.hits = new_hits;
    if len(limiter.hits) >= limiter.max {
        return false;
    }
    push(limiter.hits, now);
    return true;
}

// ── JWT helpers ───────────────────────────────────────────────────────────────

fn create_jwt(payload, secret) {
    let header = base64_encode(json_stringify(map{
        alg: "HS256",
        typ: "JWT",
    }));
    let body = base64_encode(json_stringify(payload));
    let signature = hmac_sha256(secret, header + "." + body);
    let sig_b64 = base64_encode(signature);
    return header + "." + body + "." + sig_b64;
}

fn verify_jwt(token, secret) {
    let parts = str_split(token, ".");
    if len(parts) != 3 { return nil; }
    let expected_sig = hmac_sha256(secret, parts[0] + "." + parts[1]);
    let expected_b64 = base64_encode(expected_sig);
    if not constant_time_eq(parts[2], expected_b64) { return nil; }
    let payload_json = base64_decode(parts[1]);
    return json_parse(payload_json);
}

// ── HMAC-based helpers ────────────────────────────────────────────────────────

fn secure_compare(a, b) {
    return constant_time_eq(a, b);
}

fn hash_file(path) {
    let content = fs_read(path);
    return sha256(content);
}

export hash_password, verify_password, generate_token, generate_csrf_token;
export generate_api_key, generate_session_id;
export sanitize_html, sanitize_sql_identifier, is_valid_email, is_strong_password;
export rate_limiter, rate_limit_check;
export create_jwt, verify_jwt;
export secure_compare, hash_file;
