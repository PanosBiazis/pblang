// stdlib/lcd.sapp — HD44780 character LCD ("LiquidCrystal") driver in pure pblang.
//
// Harvested from the Arduino LiquidCrystal backlog, layered the codegen way:
//
//   1. PURE op plans:  init_ops()/write_ops(text)/cursor_ops(row,col)/clear_ops()
//                      -> [{rs, byte}]   (rs=0 command, rs=1 data)
//   2. PURE lowering:  to_gpio_steps(ops, pins) -> [{pin, value}] — the 4-bit
//                      protocol: rs, high nibble on d4..d7, E pulse, low nibble,
//                      E pulse. 13 pin writes per byte.
//   3. executor:       run(gpio_handle, steps) — replays the steps over
//                      stdlib/gpio.sapp (real sysfs or injected fake).
//
//   let LCD = import("stdlib:lcd.sapp");
//   let pins = map{ rs: 25, e: 24, d4: 23, d5: 17, d6: 27, d7: 22 };
//   LCD.run(g, LCD.print_plan("Hello", pins));
//
// Honest boundary: sysfs writes are slow enough that the HD44780's >37us
// command time is naturally satisfied; the 1.5ms clear/home settle time may
// need a sleep between run() batches on fast paths.

let ROW_OFFSETS = [0, 64, 20, 84];

// write_ops(text) — one data op per character (ASCII/HD44780 ROM codes).
fn write_ops(text) {
    let out = [];
    let bytes = str_to_bytes(text);
    let i = 0;
    while i < len(bytes) { push(out, map{ rs: 1, byte: bytes[i] }); i = i + 1; }
    return out;
}

// init_ops() — the standard 4-bit init: function set (2 lines, 5x8),
// display on (no cursor), entry mode left-to-right, clear.
fn init_ops() {
    return [
        map{ rs: 0, byte: 51 },  // 0x33: wake + begin 4-bit handshake
        map{ rs: 0, byte: 50 },  // 0x32: finish switch to 4-bit
        map{ rs: 0, byte: 40 },  // 0x28: function set, 4-bit, 2 lines, 5x8
        map{ rs: 0, byte: 12 },  // 0x0C: display on, cursor off
        map{ rs: 0, byte: 6 },   // 0x06: entry mode, increment
        map{ rs: 0, byte: 1 },   // 0x01: clear
    ];
}

// cursor_ops(row, col) — DDRAM address command 0x80 | offset(row) + col.
fn cursor_ops(row, col) {
    if row < 0 or row >= len(ROW_OFFSETS) {
        throw "lcd: row must be 0.." + str(len(ROW_OFFSETS) - 1) + ", got " + str(row);
    }
    if col < 0 or col > 39 { throw "lcd: col must be 0..39, got " + str(col); }
    return [map{ rs: 0, byte: 128 + ROW_OFFSETS[row] + col }];
}

fn clear_ops() { return [map{ rs: 0, byte: 1 }]; }
fn home_ops() { return [map{ rs: 0, byte: 2 }]; }

fn _bit(n, p) { return num_floor(n / p) % 2; }

fn _nibble_steps(out, pins, nib) {
    push(out, map{ pin: pins.d4, value: _bit(nib, 1) });
    push(out, map{ pin: pins.d5, value: _bit(nib, 2) });
    push(out, map{ pin: pins.d6, value: _bit(nib, 4) });
    push(out, map{ pin: pins.d7, value: _bit(nib, 8) });
    push(out, map{ pin: pins.e, value: 1 });
    push(out, map{ pin: pins.e, value: 0 });
    return out;
}

// to_gpio_steps(ops, pins) — lower [{rs, byte}] ops to raw [{pin, value}]
// writes. pins: { rs, e, d4, d5, d6, d7 } (BCM numbers on a Pi).
fn to_gpio_steps(ops, pins) {
    let out = [];
    let i = 0;
    while i < len(ops) {
        let op = ops[i];
        push(out, map{ pin: pins.rs, value: op.rs });
        _nibble_steps(out, pins, num_floor(op.byte / 16));
        _nibble_steps(out, pins, op.byte % 16);
        i = i + 1;
    }
    return out;
}

// print_plan(text, pins) — full init + write steps for a one-call hello world.
fn print_plan(text, pins) {
    let ops = init_ops();
    let w = write_ops(text);
    let i = 0;
    while i < len(w) { push(ops, w[i]); i = i + 1; }
    return to_gpio_steps(ops, pins);
}

// setup_pins(g, pins) — export + set all six pins to output (hardware prep).
fn setup_pins(g, pins) {
    let GP = import("stdlib:gpio.sapp");
    let names = [pins.rs, pins.e, pins.d4, pins.d5, pins.d6, pins.d7];
    let i = 0;
    while i < len(names) {
        GP.export_pin(g, names[i]);
        GP.set_direction(g, names[i], "out");
        i = i + 1;
    }
    return nil;
}

// run(g, steps) — replay lowered steps over a stdlib/gpio.sapp handle.
fn run(g, steps) {
    let GP = import("stdlib:gpio.sapp");
    let i = 0;
    while i < len(steps) {
        GP.write_pin(g, steps[i].pin, steps[i].value);
        i = i + 1;
    }
    return nil;
}

export write_ops, init_ops, cursor_ops, clear_ops, home_ops, to_gpio_steps, print_plan, setup_pins, run;
