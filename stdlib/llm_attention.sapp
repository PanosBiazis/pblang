// stdlib/llm_attention.sapp -- stacked multi-head decoder attention for pbAI-Max work.
//
// This is an inference/runtime substrate: multi-head causal attention, decoder layers,
// stacked decoder models, logits, and generation. Training utilities live in
// llm_train.sapp so the forward path stays reusable.

let core = import("stdlib:llm_core.sapp");
let binary = import("stdlib:llm_binary.sapp");

fn config(vocab_size, context, d_model, d_ff, layers, heads, seed) {
    return map{
        format: "pblang.llm.stack.config.v1",
        vocab_size: vocab_size,
        context: context,
        d_model: d_model,
        d_ff: d_ff,
        layers: layers,
        heads: heads,
        kv_heads: heads,
        local_window: context,
        global_every: 1,
        attention_family: "full-causal",
        binary_bit_width: binary.bit_width(vocab_size),
        binary_scale: 0.05,
        growth_policy: map{
            format: "pblang.llm.live_growth_policy.v1",
            enabled: true,
            mode: "controlled",
            target_valid_loss: 3.5,
            target_accuracy: 0.25,
            overfit_gap: 1.0,
            max_growth_steps: 3,
            manual_override: true,
            allowed_signals: ["stronger_binary", "weaker_binary", "longer_context", "deeper"]
        },
        seed: seed
    };
}

fn gemma3_config(vocab_size, context, d_model, d_ff, layers, heads, kv_heads, local_window, global_every, seed) {
    let cfg = config(vocab_size, context, d_model, d_ff, layers, heads, seed);
    if kv_heads < 1 { kv_heads = 1; }
    if kv_heads > heads { kv_heads = heads; }
    if local_window < 1 { local_window = context; }
    if global_every < 1 { global_every = 1; }
    cfg.format = "pblang.llm.gemma3_style.config.v1";
    cfg.kv_heads = kv_heads;
    cfg.local_window = local_window;
    cfg.global_every = global_every;
    cfg.attention_family = "gemma3-style-local-global-gqa";
    cfg.notes = [
        "pblang implementation inspired by public Gemma 3 long-context architecture notes",
        "uses periodic global layers plus local-window layers to reduce KV/cache pressure",
        "grouped-query attention shares key/value head slices across query heads"
    ];
    return cfg;
}

fn ple_params(vocab_size, layers, ple_dim) {
    if ple_dim < 0 { ple_dim = 0; }
    return vocab_size * layers * ple_dim;
}

fn moe_plan(total_params, active_params, experts, active_experts) {
    if experts < 1 { experts = 1; }
    if active_experts < 1 { active_experts = 1; }
    if active_experts > experts { active_experts = experts; }
    let loaded_to_active = 0.0;
    if active_params > 0 { loaded_to_active = total_params / active_params; }
    return map{
        format: "pblang.llm.moe_plan.v1",
        total_params: total_params,
        active_params: active_params,
        experts: experts,
        active_experts: active_experts,
        loaded_to_active_ratio: loaded_to_active,
        routing: "load-all-route-few",
        note: "memory must hold total expert weights even when active params per token are lower"
    };
}

fn mtp_plan(draft_tokens = 4, accept_rate = 0.75) {
    if draft_tokens < 1 { draft_tokens = 1; }
    if accept_rate < 0 { accept_rate = 0.0; }
    if accept_rate > 1 { accept_rate = 1.0; }
    let expected_tokens = 1.0 + draft_tokens * accept_rate;
    return map{
        format: "pblang.llm.mtp_plan.v1",
        draft_tokens: draft_tokens,
        accept_rate: accept_rate,
        expected_tokens_per_verify: expected_tokens,
        mode: "draft-model-speculative-decoding"
    };
}

fn system_prompt_turn(system_prompt, user_prompt, thinking = false) {
    let think = "";
    if thinking { think = "<|think|>"; }
    return map{
        format: "pblang.llm.system_prompt_turn.v1",
        system_prompt: system_prompt,
        user_prompt: user_prompt,
        thinking: thinking,
        text: "<|turn>system\n" + system_prompt + "\n" + think + "<turn|>\n<|turn>user\n" + user_prompt + "<turn|>\n<|turn>model"
    };
}

fn multimodal_projection_plan(input_kind, input_dim, d_model, tokens) {
    if tokens < 1 { tokens = 1; }
    return map{
        format: "pblang.llm.multimodal_projection_plan.v1",
        input_kind: input_kind,
        input_dim: input_dim,
        d_model: d_model,
        tokens: tokens,
        projection_params: input_dim * d_model,
        output_shape: [tokens, d_model],
        mode: "direct-linear-projection-to-language-space"
    };
}

fn memory_requirement_bytes(params, bits = 16, overhead = 0.20) {
    let base = params * bits / 8;
    return base + base * overhead;
}

fn gemma4_config(name, vocab_size, context, d_model, d_ff, layers, heads, seed, opts = nil) {
    if opts == nil { opts = map{}; }
    let kv_heads = try opts.kv_heads catch heads;
    let local_window = try opts.local_window catch context;
    let global_every = try opts.global_every catch 4;
    let total_params = try opts.total_params catch 0;
    let active_params = try opts.active_params catch 0;
    let experts = try opts.experts catch 1;
    let active_experts = try opts.active_experts catch 1;
    let draft_tokens = try opts.draft_tokens catch 4;
    let accept_rate = try opts.accept_rate catch 0.75;
    let cfg = gemma3_config(vocab_size, context, d_model, d_ff, layers, heads, kv_heads, local_window, global_every, seed);
    cfg.format = "pblang.llm.gemma4_style.config.v1";
    cfg.name = name;
    cfg.attention_family = "gemma4-style-local-global-gqa";
    cfg.system_prompt_support = true;
    cfg.thinking_support = try opts.thinking catch true;
    cfg.modalities = try opts.modalities catch ["text"];
    cfg.ple_dim = try opts.ple_dim catch 0;
    cfg.ple_params = ple_params(vocab_size, layers, cfg.ple_dim);
    cfg.moe = moe_plan(total_params, active_params, experts, active_experts);
    cfg.mtp = mtp_plan(draft_tokens, accept_rate);
    cfg.memory = map{
        format: "pblang.llm.gemma4_memory.v1",
        bf16_bytes: memory_requirement_bytes(total_params, 16, 0.20),
        q4_bytes: memory_requirement_bytes(total_params, 4, 0.20),
        note: "base-weight estimate only; KV cache and runtime overhead need separate planning"
    };
    cfg.notes = [
        "pblang Gemma 4 style planning contract",
        "PLE, MoE, MTP, system-prompt, thinking, and multimodal projection are substrate metadata/planners unless a model explicitly uses them",
        "does not include Google weights or private kernels"
    ];
    return cfg;
}

fn attention_plan(cfg) {
    let layers = [];
    let i = 0;
    let ge = try cfg.global_every catch 1;
    let lw = try cfg.local_window catch cfg.context;
    let kvh = try cfg.kv_heads catch cfg.heads;
    while i < cfg.layers {
        let typ = "global";
        if ge > 1 and num_mod(i + 1, ge) != 0 {
            typ = "local";
        }
        push(layers, map{
            layer: i,
            attention: typ,
            local_window: lw,
            query_heads: cfg.heads,
            kv_heads: kvh
        });
        i = i + 1;
    }
    return map{
        format: "pblang.llm.attention_plan.v1",
        family: try cfg.attention_family catch "full-causal",
        layers: layers,
        local_window: try cfg.local_window catch cfg.context,
        global_every: try cfg.global_every catch 1,
        query_heads: cfg.heads,
        kv_heads: try cfg.kv_heads catch cfg.heads
    };
}

fn _layer_new(cfg, idx) {
    let d = cfg.d_model;
    let s = cfg.seed + idx * 100;
    let ge = try cfg.global_every catch 1;
    let attention_type = "global";
    if ge > 1 and num_mod(idx + 1, ge) != 0 {
        attention_type = "local";
    }
    return map{
        index: idx,
        attention_type: attention_type,
        Wq: core.randn_matrix(d, d, s + 1, 0.04),
        Wk: core.randn_matrix(d, d, s + 2, 0.04),
        Wv: core.randn_matrix(d, d, s + 3, 0.04),
        Wo: core.randn_matrix(d, d, s + 4, 0.04),
        W1: core.randn_matrix(d, cfg.d_ff, s + 5, 0.04),
        b1: core.zeros(cfg.d_ff),
        W2: core.randn_matrix(cfg.d_ff, d, s + 6, 0.04),
        b2: core.zeros(d)
    };
}

fn model_new(cfg) {
    let layers = [];
    let i = 0;
    while i < cfg.layers {
        push(layers, _layer_new(cfg, i));
        i = i + 1;
    }
    return map{
        format: "pblang.llm.stacked_decoder.v1",
        config: cfg,
        token_embedding: core.randn_matrix(cfg.vocab_size, cfg.d_model, cfg.seed + 1, 0.08),
        pos_embedding: core.randn_matrix(cfg.context, cfg.d_model, cfg.seed + 2, 0.02),
        binary_projection: core.randn_matrix(cfg.binary_bit_width, cfg.d_model, cfg.seed + 3, 0.02),
        layers: layers,
        lm_head: core.randn_matrix(cfg.d_model, cfg.vocab_size, cfg.seed + 999, 0.04),
        lm_bias: core.zeros(cfg.vocab_size)
    };
}

fn binary_embedding(model, token_id) {
    let width = try model.config.binary_bit_width catch binary.bit_width(model.config.vocab_size);
    let scale = try model.config.binary_scale catch 0.05;
    let bits = binary.id_to_bits(token_id, width);
    let proj = try model.binary_projection catch core.zeros2(width, model.config.d_model);
    return core.scale_vec(core.vecmat(bits, proj), scale);
}

fn embed(model, ids) {
    let out = [];
    let i = 0;
    while i < len(ids) {
        push(out, core.add_vec(model.token_embedding[ids[i]], model.pos_embedding[i]));
        i = i + 1;
    }
    return out;
}

fn _slice(v, start, end) {
    let out = [];
    let i = start;
    while i < end {
        push(out, v[i]);
        i = i + 1;
    }
    return out;
}

fn _write_slice(dst, start, values) {
    let i = 0;
    while i < len(values) {
        dst[start + i] = values[i];
        i = i + 1;
    }
    return dst;
}

fn _head_context(q, keys, values, head_dim) {
    let scores = [];
    let scale = 1.0 / num_sqrt(head_dim);
    let i = 0;
    while i < len(keys) {
        push(scores, core.dot(q, keys[i]) * scale);
        i = i + 1;
    }
    let probs = core.softmax(scores, 1.0);
    let ctx = core.zeros(head_dim);
    let j = 0;
    while j < len(probs) {
        ctx = core.add_vec(ctx, core.scale_vec(values[j], probs[j]));
        j = j + 1;
    }
    return ctx;
}

fn multi_head_attention_window(layer, x, heads, kv_heads, local_window) {
    let d = len(x[0]);
    let head_dim = d / heads;
    if kv_heads < 1 { kv_heads = heads; }
    if kv_heads > heads { kv_heads = heads; }
    let q = [];
    let k = [];
    let v = [];
    let i = 0;
    while i < len(x) {
        push(q, core.vecmat(x[i], layer.Wq));
        push(k, core.vecmat(x[i], layer.Wk));
        push(v, core.vecmat(x[i], layer.Wv));
        i = i + 1;
    }
    let out = [];
    let t = 0;
    while t < len(x) {
        let joined = core.zeros(d);
        let first_pos = 0;
        if local_window > 0 and local_window < t + 1 {
            first_pos = t - local_window + 1;
        }
        let h = 0;
        while h < heads {
            let start = h * head_dim;
            let end = start + head_dim;
            let kv_h = h;
            if kv_heads < heads {
                kv_h = num_floor(h * kv_heads / heads);
            }
            let kv_start = kv_h * head_dim;
            let kv_end = kv_start + head_dim;
            let qh = _slice(q[t], start, end);
            let kh = [];
            let vh = [];
            let p = first_pos;
            while p <= t {
                push(kh, _slice(k[p], kv_start, kv_end));
                push(vh, _slice(v[p], kv_start, kv_end));
                p = p + 1;
            }
            let ctx = _head_context(qh, kh, vh, head_dim);
            joined = _write_slice(joined, start, ctx);
            h = h + 1;
        }
        push(out, core.vecmat(joined, layer.Wo));
        t = t + 1;
    }
    return out;
}

fn multi_head_attention(layer, x, heads) {
    return multi_head_attention_window(layer, x, heads, heads, len(x));
}

fn feed_forward(layer, x) {
    let h = core.relu_vec(core.add_vec(core.vecmat(x, layer.W1), layer.b1));
    return core.add_vec(core.vecmat(h, layer.W2), layer.b2);
}

fn decoder_layer(model, layer, x) {
    let local_window = len(x);
    if (try layer.attention_type catch "global") == "local" {
        local_window = try model.config.local_window catch len(x);
    }
    let att = multi_head_attention_window(layer, x, model.config.heads, try model.config.kv_heads catch model.config.heads, local_window);
    let h = [];
    let i = 0;
    while i < len(x) {
        push(h, core.layer_norm_vec(core.add_vec(x[i], att[i]), 0.00001));
        i = i + 1;
    }
    let out = [];
    let j = 0;
    while j < len(h) {
        push(out, core.layer_norm_vec(core.add_vec(h[j], feed_forward(layer, h[j])), 0.00001));
        j = j + 1;
    }
    return out;
}

fn forward_hidden(model, ids) {
    let h = embed(model, ids);
    let i = 0;
    while i < len(model.layers) {
        h = decoder_layer(model, model.layers[i], h);
        i = i + 1;
    }
    return h;
}

// The head input includes the binary token residual in both training and inference.
fn head_hidden(model, ids) {
    let h = forward_hidden(model, ids);
    return core.add_vec(h[len(h) - 1], binary_embedding(model, ids[len(ids) - 1]));
}

fn adapter_hidden(model, ids) { return [head_hidden(model, ids)]; }

fn logits(model, ids) {
    return core.add_vec(core.vecmat(head_hidden(model, ids), model.lm_head), model.lm_bias);
}

fn loss(model, ids, target_id) {
    return core.cross_entropy_from_logits(logits(model, ids), target_id);
}

fn generate(model, seed_ids, n) {
    let ids = core.copy_vec(seed_ids);
    let step = 0;
    while step < n {
        let start = len(ids) - model.config.context;
        if start < 0 { start = 0; }
        let ctx = [];
        let i = start;
        while i < len(ids) {
            push(ctx, ids[i]);
            i = i + 1;
        }
        push(ids, core.argmax(logits(model, ctx)));
        step = step + 1;
    }
    return ids;
}

fn _copy_logits(v) {
    let out = [];
    let i = 0;
    while i < len(v) {
        push(out, v[i]);
        i = i + 1;
    }
    return out;
}

fn _recent_count(ids, token_id, window) {
    let count = 0;
    let start = len(ids) - window;
    if start < 0 { start = 0; }
    let i = start;
    while i < len(ids) {
        if ids[i] == token_id { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn _tail_run(ids) {
    if len(ids) == 0 { return map{ token: -1, run: 0 }; }
    let token = ids[len(ids) - 1];
    let run = 0;
    let i = len(ids) - 1;
    while i >= 0 and ids[i] == token {
        run = run + 1;
        i = i - 1;
    }
    return map{ token: token, run: run };
}

fn repetition_penalized_logits(raw_logits, ids, recent_window = 16, repetition_penalty = 0.35, max_repeat = 4) {
    let out = _copy_logits(raw_logits);
    let i = 0;
    while i < len(out) {
        let c = _recent_count(ids, i, recent_window);
        if c > 0 { out[i] = out[i] - repetition_penalty * c; }
        i = i + 1;
    }
    let tail = _tail_run(ids);
    if tail.token >= 0 and tail.token < len(out) and tail.run >= max_repeat {
        out[tail.token] = -1000000000.0;
    }
    return out;
}

fn generate_safe(model, seed_ids, n, recent_window = 16, repetition_penalty = 0.35, max_repeat = 4) {
    let ids = core.copy_vec(seed_ids);
    let step = 0;
    while step < n {
        let start = len(ids) - model.config.context;
        if start < 0 { start = 0; }
        let ctx = [];
        let i = start;
        while i < len(ids) {
            push(ctx, ids[i]);
            i = i + 1;
        }
        let raw = logits(model, ctx);
        let penalized = repetition_penalized_logits(raw, ids, recent_window, repetition_penalty, max_repeat);
        push(ids, core.argmax(penalized));
        step = step + 1;
    }
    return ids;
}

fn add_decoder_layer(model) {
    let idx = len(model.layers);
    push(model.layers, _layer_new(model.config, idx));
    model.config.layers = len(model.layers);
    return map{
        format: "pblang.llm.architecture_update.v1",
        action: "add_decoder_layer",
        layers: model.config.layers,
        d_model: model.config.d_model,
        d_ff: model.config.d_ff,
        heads: model.config.heads
    };
}

fn extend_context(model, new_context) {
    if new_context <= model.config.context {
        return map{
            format: "pblang.llm.architecture_update.v1",
            action: "extend_context",
            changed: false,
            context: model.config.context
        };
    }
    let i = len(model.pos_embedding);
    while i < new_context {
        push(model.pos_embedding, core.randn_vec(model.config.d_model, model.config.seed + 2000 + i, 0.02));
        i = i + 1;
    }
    model.config.context = new_context;
    return map{
        format: "pblang.llm.architecture_update.v1",
        action: "extend_context",
        changed: true,
        context: model.config.context
    };
}

fn set_binary_scale(model, scale) {
    if scale < 0.001 { scale = 0.001; }
    if scale > 1.0 { scale = 1.0; }
    model.config.binary_scale = scale;
    return map{
        format: "pblang.llm.architecture_update.v1",
        action: "set_binary_scale",
        binary_scale: model.config.binary_scale
    };
}

fn set_growth_policy(model, policy) {
    let old = try model.config.growth_policy catch map{};
    if not map_has(old, "format") { old = config(model.config.vocab_size, model.config.context, model.config.d_model, model.config.d_ff, model.config.layers, model.config.heads, model.config.seed).growth_policy; }
    if map_has(policy, "enabled") { old.enabled = policy.enabled; }
    if map_has(policy, "target_valid_loss") { old.target_valid_loss = policy.target_valid_loss; }
    if map_has(policy, "target_accuracy") { old.target_accuracy = policy.target_accuracy; }
    if map_has(policy, "overfit_gap") { old.overfit_gap = policy.overfit_gap; }
    if map_has(policy, "max_growth_steps") { old.max_growth_steps = policy.max_growth_steps; }
    if map_has(policy, "manual_override") { old.manual_override = policy.manual_override; }
    if map_has(policy, "allowed_signals") { old.allowed_signals = policy.allowed_signals; }
    model.config.growth_policy = old;
    return old;
}

fn _allowed(policy, signal) {
    let allowed = try policy.allowed_signals catch ["stronger_binary", "weaker_binary", "longer_context", "deeper"];
    let i = 0;
    while i < len(allowed) {
        if allowed[i] == signal { return true; }
        i = i + 1;
    }
    return false;
}

fn live_architecture_update(model, signal) {
    let policy = try model.config.growth_policy catch map{ enabled: true, manual_override: true, allowed_signals: ["stronger_binary", "weaker_binary", "longer_context", "deeper"] };
    if map_has(policy, "enabled") and not policy.enabled {
        return map{ format: "pblang.llm.architecture_update.v1", action: "blocked", reason: "live growth disabled", signal: signal };
    }
    if not _allowed(policy, signal) {
        return map{ format: "pblang.llm.architecture_update.v1", action: "blocked", reason: "signal not allowed by growth policy", signal: signal };
    }
    if signal == "deeper" { return add_decoder_layer(model); }
    if signal == "longer_context" { return extend_context(model, model.config.context * 2); }
    if signal == "stronger_binary" { return set_binary_scale(model, model.config.binary_scale * 1.25); }
    if signal == "weaker_binary" { return set_binary_scale(model, model.config.binary_scale * 0.8); }
    return map{
        format: "pblang.llm.architecture_update.v1",
        action: "noop",
        signal: signal,
        layers: model.config.layers,
        context: model.config.context,
        binary_scale: try model.config.binary_scale catch 0.05
    };
}

fn manipulate(model, directive) {
    let signal = try directive.signal catch "";
    let policy = try directive.policy catch nil;
    if policy != nil { set_growth_policy(model, policy); }
    if signal == "set_binary_scale" { return set_binary_scale(model, directive.value); }
    if signal != "" { return live_architecture_update(model, signal); }
    return map{
        format: "pblang.llm.architecture_update.v1",
        action: "noop",
        reason: "directive has no signal",
        policy: try model.config.growth_policy catch map{}
    };
}

fn summary(model) {
    return map{
        format: model.format,
        vocab_size: model.config.vocab_size,
        context: model.config.context,
        d_model: model.config.d_model,
        d_ff: model.config.d_ff,
        layers: model.config.layers,
        heads: model.config.heads,
        kv_heads: try model.config.kv_heads catch model.config.heads,
        attention_family: try model.config.attention_family catch "full-causal",
        system_prompt_support: try model.config.system_prompt_support catch false,
        thinking_support: try model.config.thinking_support catch false,
        modalities: try model.config.modalities catch ["text"],
        ple_params: try model.config.ple_params catch 0,
        moe: try model.config.moe catch nil,
        mtp: try model.config.mtp catch nil,
        attention_plan: attention_plan(model.config),
        binary_bit_width: try model.config.binary_bit_width catch binary.bit_width(model.config.vocab_size),
        binary_adapter: true,
        binary_scale: try model.config.binary_scale catch 0.05,
        live_mutable: true,
        live_updates: ["deeper", "longer_context", "stronger_binary", "weaker_binary"],
        growth_policy: try model.config.growth_policy catch map{}
    };
}

// causal_mask(n) — n×n additive attention mask: 0 where attention is allowed
// (j <= i), a large negative where it is masked (future positions j > i).
fn causal_mask(n) {
    let neg = 0 - (10 ** 30);
    let out = [];
    let i = 0;
    while i < n {
        let row = [];
        let j = 0;
        while j < n { if j <= i { push(row, 0); } else { push(row, neg); } j = j + 1; }
        push(out, row);
        i = i + 1;
    }
    return out;
}

// frequency_penalty_logits(logits, ids, penalty) — subtract penalty × (total
// occurrence count in ids) from each token's logit (OpenAI-style frequency
// penalty; complements the recency-based repetition_penalized_logits).
fn frequency_penalty_logits(logits, ids, penalty) {
    let counts = map{};
    let i = 0;
    while i < len(ids) {
        let k = str(ids[i]);
        if map_has(counts, k) { counts[k] = counts[k] + 1; } else { counts[k] = 1; }
        i = i + 1;
    }
    let out = _copy_logits(logits);
    i = 0;
    while i < len(out) {
        let k = str(i);
        if map_has(counts, k) { out[i] = out[i] - penalty * counts[k]; }
        i = i + 1;
    }
    return out;
}

