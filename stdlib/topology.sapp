// stdlib/topology.sapp — geometric & topological FORM generators (pblang-native).
//
// Pure shape/topology primitives for structured neural-net init, connection topologies,
// embeddings, layouts and data augmentation. Two families:
//   * geometric forms: diamond profile, mobius walk, klein-bottle grid, galaxy orbits/
//     spiral, trefoil knot, regular polygons (pentagon), tesseract/hypercube, illusions.
//   * network topologies: ring, line/bus, star, mesh (fully-connected), tree, grid, torus
//     as edge lists of index pairs — the wiring patterns for layers/agents/cores.
//
//   let topo = import("stdlib:topology.sapp");
//   for v in topo.pentagon(0, 0, 1) { ... }
//   for e in topo.ring_topology(8) { connect(e[0], e[1]); }

let MATH = import("stdlib:math.sapp");

// ── helpers ───────────────────────────────────────────────────────────────────────
fn _pow2(b) { let r = 1; let i = 0; while i < b { r = r * 2; i = i + 1; } return r; }
fn _wrap(v, n) { return num_mod(num_mod(v, n) + n, n); }   // non-negative modulo
fn _is_odd(v) { return _wrap(v, 2) == 1; }

// ── DIAMOND: symmetric expand → peak → contract width profile ─────────────────────
fn diamond_widths(min_w, max_w, step) {
    if step < 1 { step = 1; }
    let up = [];
    let w = min_w;
    while w < max_w { push(up, w); w = w + step; }
    push(up, max_w);
    let out = [];
    let i = 0;
    while i < len(up) { push(out, up[i]); i = i + 1; }
    let j = len(up) - 2;
    while j >= 0 { push(out, up[j]); j = j - 1; }
    return out;
}

// ── MOBIUS strip: 2 laps to return; orientation (side) flips each lap ──────────────
fn mobius_walk(n) {
    let out = [];
    let p = 0;
    while p < 2 * n {
        push(out, map{ cell: _wrap(p, n), side: _wrap(num_floor(p / n), 2) });
        p = p + 1;
    }
    return out;
}

// ── KLEIN BOTTLE grid: x is periodic; each x-wrap FLIPS y (non-orientable) ─────────
fn klein_wrap(x, y, w, h) {
    let xw = _wrap(x, w);
    let wraps = num_floor(x / w);
    let yy = y;
    if _is_odd(wraps) { yy = h - 1 - y; }
    return map{ x: xw, y: _wrap(yy, h) };
}

// ── GALAXY: orbital motion (rotate a star about a center) + spiral-arm star field ──
fn orbit_step(px, py, cx, cy, angle) {
    let dx = px - cx;
    let dy = py - cy;
    let c = MATH.cos(angle);
    let s = MATH.sin(angle);
    return map{ x: cx + dx * c - dy * s, y: cy + dx * s + dy * c };
}
fn galaxy_spiral(n, arms, turns, scale) {
    let out = [];
    let i = 0;
    while i < n {
        let frac = 0;
        if n > 1 { frac = i / (n - 1); }
        let t = frac * turns * 2 * MATH.PI;
        let ang = t + _wrap(i, arms) * (2 * MATH.PI / arms);
        let r = scale * t;
        push(out, map{ x: r * MATH.cos(ang), y: r * MATH.sin(ang) });
        i = i + 1;
    }
    return out;
}

// ── TREFOIL KNOT: the standard closed 3-crossing knot curve in 3D ─────────────────
fn trefoil_point(t) {
    return map{
        x: MATH.sin(t) + 2 * MATH.sin(2 * t),
        y: MATH.cos(t) - 2 * MATH.cos(2 * t),
        z: 0 - MATH.sin(3 * t),
    };
}
fn trefoil_curve(n) {
    let out = [];
    let i = 0;
    while i < n { push(out, trefoil_point(i / n * 2 * MATH.PI)); i = i + 1; }
    return out;
}

// ── PENTAGON / regular n-gon vertices (5-fold symmetry; pentagon ↔ golden ratio) ──
fn polygon_vertices(n, cx, cy, r, rot) {
    let out = [];
    let i = 0;
    while i < n {
        let ang = rot + i * (2 * MATH.PI / n);
        push(out, map{ x: cx + r * MATH.cos(ang), y: cy + r * MATH.sin(ang) });
        i = i + 1;
    }
    return out;
}
fn pentagon(cx, cy, r) { return polygon_vertices(5, cx, cy, r, 0); }
fn golden_ratio() { return MATH.PHI; }

// ── TESSERACT / d-dim HYPERCUBE: 2^d vertices, edges between 1-bit-apart vertices ──
fn hypercube_vertices(d) {
    let total = _pow2(d);
    let out = [];
    let i = 0;
    while i < total {
        let v = [];
        let b = 0;
        while b < d { push(v, _wrap(num_floor(i / _pow2(b)), 2)); b = b + 1; }
        push(out, v);
        i = i + 1;
    }
    return out;
}
fn _hamming(a, b) { let d = 0; let i = 0; while i < len(a) { if a[i] != b[i] { d = d + 1; } i = i + 1; } return d; }
fn hypercube_edges(d) {
    let vs = hypercube_vertices(d);
    let out = [];
    let i = 0;
    while i < len(vs) {
        let j = i + 1;
        while j < len(vs) { if _hamming(vs[i], vs[j]) == 1 { push(out, [i, j]); } j = j + 1; }
        i = i + 1;
    }
    return out;
}
fn tesseract_vertices() { return hypercube_vertices(4); }
fn tesseract_edges() { return hypercube_edges(4); }

// ── ILLUSIONS: bounded perceptual jitter + a bistable (ambiguous) toggle ──────────
fn illusion_jitter(vec, amount, seed) {
    let out = [];
    let i = 0;
    while i < len(vec) {
        let k = seed * 131 + i * 7 + 1;
        let frac = num_mod(k * 2654435761, 100000) / 100000;   // [0,1)
        push(out, vec[i] + (frac - 0.5) * 2 * amount);          // ±amount
        i = i + 1;
    }
    return out;
}
fn bistable(a, b, phase) { if _wrap(num_floor(phase), 2) == 0 { return a; } return b; }

// ── NETWORK TOPOLOGIES: edge lists ([i,j] index pairs) ────────────────────────────
fn ring_topology(n) {
    let out = [];
    let i = 0;
    while i < n { push(out, [i, _wrap(i + 1, n)]); i = i + 1; }
    return out;
}
fn line_topology(n) {                       // bus / path
    let out = [];
    let i = 0;
    while i < n - 1 { push(out, [i, i + 1]); i = i + 1; }
    return out;
}
fn star_topology(n) {                       // hub-and-spoke (node 0 is the hub)
    let out = [];
    let i = 1;
    while i < n { push(out, [0, i]); i = i + 1; }
    return out;
}
fn fully_connected(n) {                     // mesh / K_n
    let out = [];
    let i = 0;
    while i < n {
        let j = i + 1;
        while j < n { push(out, [i, j]); j = j + 1; }
        i = i + 1;
    }
    return out;
}
fn tree_topology(n) {                       // complete binary tree (parent = (i-1)/2)
    let out = [];
    let i = 1;
    while i < n { push(out, [num_floor((i - 1) / 2), i]); i = i + 1; }
    return out;
}
fn _grid_idx(x, y, w) { return y * w + x; }
fn grid_topology(w, h) {                     // 2D lattice (no wrap)
    let out = [];
    let y = 0;
    while y < h {
        let x = 0;
        while x < w {
            if x + 1 < w { push(out, [_grid_idx(x, y, w), _grid_idx(x + 1, y, w)]); }
            if y + 1 < h { push(out, [_grid_idx(x, y, w), _grid_idx(x, y + 1, w)]); }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}
fn torus_topology(w, h) {                    // grid with wraparound on both axes
    let out = [];
    let y = 0;
    while y < h {
        let x = 0;
        while x < w {
            push(out, [_grid_idx(x, y, w), _grid_idx(_wrap(x + 1, w), y, w)]);
            push(out, [_grid_idx(x, y, w), _grid_idx(x, _wrap(y + 1, h), w)]);
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

export diamond_widths, mobius_walk, klein_wrap, orbit_step, galaxy_spiral;
export trefoil_point, trefoil_curve, polygon_vertices, pentagon, golden_ratio;
export hypercube_vertices, hypercube_edges, tesseract_vertices, tesseract_edges;
export illusion_jitter, bistable;
export ring_topology, line_topology, star_topology, fully_connected, tree_topology, grid_topology, torus_topology;
