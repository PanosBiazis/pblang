// Detached, revision-checked records for local CRUD applications.
// Single-threaded: callers must serialize access. No persistence or account auth.
fn integer(value, minimum = 0, maximum = 2147483647) {
    if type(value) != "number" or value < minimum or value > maximum
        or num_floor(value) != value { throw "crud: invalid integer"; }
    return value;
}
fn decimal(value, minimum = 0) {
    if type(value) != "string" or len(value) < 1 or len(value) > 10 { throw "crud: invalid decimal"; }
    if len(value) > 1 and value[0] == "0" { throw "crud: noncanonical decimal"; }
    let result = 0;
    for ch in str_split(value, "") {
        let code = strcharcodeat(ch, 0);
        if code < 48 or code > 57 { throw "crud: invalid decimal"; }
        result = result * 10 + code - 48;
    }
    return integer(result, minimum);
}
fn text(value, maximum = 240) {
    if type(value) != "string" or len(value) > maximum { throw "crud: invalid text"; }
    if len(str_to_bytes(value)) > maximum or str_trim(value) == "" { throw "crud: invalid text"; }
    for ch in str_split(value, "") {
        let code = strcharcodeat(ch, 0);
        if code < 32 or code == 127 { throw "crud: control character"; }
    }
    return str_trim(value);
}
fn record(value) {
    if type(value) != "map" or len(map_keys(value)) != 4 { throw "crud: record fields required"; }
    return map{ id: integer(value.id, 1), name: text(value.name),
        country: text(value.country), time: text(value.time, 64) };
}
fn _copy(value) { return map{ id: value.id, name: value.name, country: value.country, time: value.time }; }
fn create(max_records = 10000) {
    integer(max_records, 1, 1000000);
    let state = map{ records: map{}, revision: 0, count: 0, closed: false };
    let check = fn() { if state.closed { throw "crud: store closed"; } };
    let revision = fn(expected) {
        check(); integer(expected);
        if state.revision != expected { throw "crud: stale revision"; }
        if state.revision >= 2147483647 { throw "crud: revision exhausted"; }
    };
    return map{
        info: fn() { check(); return map{ revision: state.revision, count: state.count, max_records: max_records }; },
        insert: fn(value, expected) {
            revision(expected); let item = record(value); let key = str(item.id);
            if map_has(state.records, key) { throw "crud: duplicate ID"; }
            if state.count >= max_records { throw "crud: capacity reached"; }
            state.records[key] = item; state.count = state.count + 1;
            state.revision = state.revision + 1; return _copy(item);
        },
        update: fn(value, expected) {
            revision(expected); let item = record(value); let key = str(item.id);
            if not map_has(state.records, key) { throw "crud: missing ID"; }
            state.records[key] = item; state.revision = state.revision + 1; return _copy(item);
        },
        remove: fn(id, expected) {
            revision(expected); let key = str(integer(id, 1));
            if not map_has(state.records, key) { throw "crud: missing ID"; }
            map_remove(state.records, key); state.count = state.count - 1;
            state.revision = state.revision + 1; return true;
        },
        clear: fn(expected, confirmation) {
            revision(expected);
            if confirmation != "DELETE ALL" { throw "crud: confirmation required"; }
            state.records = map{}; state.count = 0; state.revision = state.revision + 1; return true;
        },
        list: fn(offset = 0, limit = 25, query = "") {
            check(); integer(offset); integer(limit, 1, 100);
            if type(query) != "string" or len(str_to_bytes(query)) > 240 { throw "crud: invalid search"; }
            let ids = []; for key in map_keys(state.records) { push(ids, parse_number(key)); }
            ids = array_sort(ids); let rows = []; let matched = 0;
            let needle = str_lower(query);
            // Numeric ID order, detached pages; O(n log n), configured capacity.
            for id in ids {
                let key = str(id);
                let row = state.records[key];
                if query == "" or str_contains(str_lower(row.name), needle)
                    or str_contains(str_lower(row.country), needle) or key == query {
                    if matched >= offset and len(rows) < limit { push(rows, _copy(row)); }
                    matched = matched + 1;
                }
            }
            return map{ rows: rows, matched: matched, revision: state.revision };
        },
        close: fn() { state.records = map{}; state.count = 0; state.closed = true; return true; }
    };
}
export create, record, integer, decimal, text;
