// Strict Gregorian civil dates. No clock, timezone, locale or operating-system I/O.
fn leap(year) { return num_mod(year,4)==0 and (num_mod(year,100)!=0 or num_mod(year,400)==0); }
fn parse(text) {
    if type(text)!="string" or len(text)!=10 or str_slice(text,4,5)!="-"
        or str_slice(text,7,8)!="-" { throw "expected YYYY-MM-DD"; }
    for i in range(0,10) {
        if i!=4 and i!=7 and str_index_of("0123456789",str_slice(text,i,i+1))<0 {
            throw "expected YYYY-MM-DD";
        }
    }
    let y=parse_number(str_slice(text,0,4)); let m=parse_number(str_slice(text,5,7));
    let d=parse_number(str_slice(text,8,10));
    if y<1 or m<1 or m>12 { throw "invalid civil date"; }
    let months=[31,if leap(y) {29} else {28},31,30,31,30,31,31,30,31,30,31];
    if d<1 or d>months[m-1] { throw "invalid civil date"; }
    let previous=y-1;
    let ordinal=365*previous+num_floor(previous/4)-num_floor(previous/100)+num_floor(previous/400)+d-1;
    for i in range(0,m-1) { ordinal=ordinal+months[i]; }
    return map{year:y,month:m,day:d,ordinal:ordinal};
}
fn ordinal(text) { return parse(text).ordinal; }
fn _pad(value,width) { let text=str(value); return str_repeat("0",width-len(text))+text; }
fn from_ordinal(day) {
    if type(day)!="number" or not (day>=0 and day<=3652058) or day!=num_floor(day) {
        throw "civil day outside years 0001..9999";
    }
    // At most 14 binary-search iterations, independent of the distance from 1970.
    let low=1; let high=9999;
    while low<high {
        let mid=num_floor((low+high+1)/2); let y=mid-1;
        let first=365*y+num_floor(y/4)-num_floor(y/100)+num_floor(y/400);
        if first<=day { low=mid; } else { high=mid-1; }
    }
    let year=low; let y=year-1;
    let remaining=day-(365*y+num_floor(y/4)-num_floor(y/100)+num_floor(y/400));
    let months=[31,if leap(year) {29} else {28},31,30,31,30,31,31,30,31,30,31];
    let month=0;
    while remaining>=months[month] { remaining=remaining-months[month]; month=month+1; }
    return _pad(year,4)+"-"+_pad(month+1,2)+"-"+_pad(remaining+1,2);
}
fn add_days(text,days) {
    if type(days)!="number" or not (days>= -3652058 and days<=3652058) or days!=num_floor(days) {
        throw "invalid civil day offset";
    }
    return from_ordinal(ordinal(text)+days);
}
// Monday=0 through Sunday=6 in the proleptic Gregorian calendar.
fn weekday(text) { return num_mod(ordinal(text),7); }
export parse,ordinal,from_ordinal,add_days,weekday;
