// stdlib/sha3.sapp -- PBLang-native SHA3-256 (FIPS 202).
//
// Keccak lanes are represented as exact low/high 32-bit halves. This avoids
// storing 64-bit words in PBLang's numeric value type and keeps every bitwise
// operation deterministic on every backend.

let MASK32 = 4294967295;
let RATE = 136;

let PILN = [10,7,11,17,18,3,5,16,8,21,24,4,15,23,19,13,12,2,20,14,22,9,6,1];
let ROTC = [1,3,6,10,15,21,28,36,45,55,2,14,27,41,56,8,25,43,62,18,39,61,20,44];

// Round constants as [low32, high32].
let RC = [
    [1,0], [32898,0], [32906,2147483648], [2147516416,2147483648],
    [32907,0], [2147483649,0], [2147516545,2147483648], [32777,2147483648],
    [138,0], [136,0], [2147516425,0], [2147483658,0],
    [2147516555,0], [139,2147483648], [32905,2147483648], [32771,2147483648],
    [32770,2147483648], [128,2147483648], [32778,0], [2147483658,2147483648],
    [2147516545,2147483648], [32896,2147483648], [2147483649,0], [2147516424,2147483648]
];

fn _u32(x) { return bit_and(x, MASK32); }

// A direct shift of a 32-bit value by up to 31 can temporarily exceed the
// exact integer range of the numeric value type. Shift in 8-bit chunks and
// mask each chunk so no intermediate exceeds 2^40.
fn _shl32(value, amount) {
    let out = value; let remaining = amount;
    while remaining > 0 {
        let step = if remaining > 8 { 8 } else { remaining };
        out = _u32(bit_shl(out, step));
        remaining = remaining - step;
    }
    return out;
}

fn _rot(lo, hi, amount) {
    let n = amount % 64;
    if n == 0 { return [lo, hi]; }
    if n == 32 { return [hi, lo]; }
    if n < 32 {
        return [
            _u32(bit_or(_shl32(lo, n), bit_shr(hi, 32 - n))),
            _u32(bit_or(_shl32(hi, n), bit_shr(lo, 32 - n)))
        ];
    }
    n = n - 32;
    return [
        _u32(bit_or(_shl32(hi, n), bit_shr(lo, 32 - n))),
        _u32(bit_or(_shl32(lo, n), bit_shr(hi, 32 - n)))
    ];
}

fn _lane_xor(state, lane, lo, hi) {
    let p = lane * 2;
    state[p] = _u32(bit_xor(state[p], lo));
    state[p + 1] = _u32(bit_xor(state[p + 1], hi));
}

fn _permute(state) {
    let round = 0;
    while round < 24 {
        let c = [];
        let x = 0;
        while x < 5 {
            let lo = 0; let hi = 0; let y = 0;
            while y < 5 {
                let p = (x + 5 * y) * 2;
                lo = bit_xor(lo, state[p]); hi = bit_xor(hi, state[p + 1]);
                y = y + 1;
            }
            array_push(c, _u32(lo)); array_push(c, _u32(hi));
            x = x + 1;
        }

        x = 0;
        while x < 5 {
            let next = (x + 1) % 5;
            let prev = (x + 4) % 5;
            let rotated = _rot(c[next * 2], c[next * 2 + 1], 1);
            let dlo = bit_xor(c[prev * 2], rotated[0]);
            let dhi = bit_xor(c[prev * 2 + 1], rotated[1]);
            let y = 0;
            while y < 5 { _lane_xor(state, x + 5 * y, dlo, dhi); y = y + 1; }
            x = x + 1;
        }

        // Rho and Pi. The cycle visits every lane except (0,0) exactly once.
        let current_lo = state[2]; let current_hi = state[3];
        let t = 0;
        while t < 24 {
            let target = PILN[t] * 2;
            let saved_lo = state[target]; let saved_hi = state[target + 1];
            let rotated = _rot(current_lo, current_hi, ROTC[t]);
            state[target] = rotated[0]; state[target + 1] = rotated[1];
            current_lo = saved_lo; current_hi = saved_hi;
            t = t + 1;
        }

        let y = 0;
        while y < 5 {
            let row = [];
            x = 0;
            while x < 5 {
                let rp = (x + 5 * y) * 2;
                array_push(row, state[rp]); array_push(row, state[rp + 1]);
                x = x + 1;
            }
            x = 0;
            while x < 5 {
                let p = (x + 5 * y) * 2;
                let p1 = ((x + 1) % 5) * 2;
                let p2 = ((x + 2) % 5) * 2;
                let nlo = bit_xor(row[p1], MASK32);
                let nhi = bit_xor(row[p1 + 1], MASK32);
                state[p] = _u32(bit_xor(row[x * 2], bit_and(nlo, row[p2])));
                state[p + 1] = _u32(bit_xor(row[x * 2 + 1], bit_and(nhi, row[p2 + 1])));
                x = x + 1;
            }
            y = y + 1;
        }

        _lane_xor(state, 0, RC[round][0], RC[round][1]);
        round = round + 1;
    }
    return state;
}

fn _xor_byte(state, offset, value) {
    let lane = num_floor(offset / 8);
    let within = offset % 8;
    let half = if within < 4 { 0 } else { 1 };
    let shift = (within % 4) * 8;
    let p = lane * 2 + half;
    state[p] = _u32(bit_xor(state[p], bit_shl(value, shift)));
}

fn digest_bytes(input) {
    let data = input;
    if type(data) == "string" { data = str_to_bytes(data); }
    if type(data) != "array" { throw "sha3: expected string or byte array"; }

    let state = [];
    let i = 0; while i < 50 { array_push(state, 0); i = i + 1; }
    let offset = 0;
    while len(data) - offset >= RATE {
        i = 0;
        while i < RATE { _xor_byte(state, i, data[offset + i]); i = i + 1; }
        _permute(state); offset = offset + RATE;
    }

    let remaining = len(data) - offset;
    i = 0;
    while i < remaining { _xor_byte(state, i, data[offset + i]); i = i + 1; }
    _xor_byte(state, remaining, 6);
    _xor_byte(state, RATE - 1, 128);
    _permute(state);

    let out = [];
    i = 0;
    while i < 32 {
        let lane = num_floor(i / 8);
        let within = i % 8;
        let word = state[lane * 2 + (if within < 4 { 0 } else { 1 })];
        array_push(out, bit_and(bit_shr(word, (within % 4) * 8), 255));
        i = i + 1;
    }
    return out;
}

// Incremental SHA3-256 context. The buffer is always smaller than one rate
// block, so long-running protocol digests do not retain their complete input.
fn new() {
    let state = []; let i = 0; while i < 50 { array_push(state, 0); i = i + 1; }
    return map{ format: "pblang.sha3-256.context.v1", state: state, buffer: [], length: 0 };
}

fn _context(context) {
    if type(context) != "map" or (try context.format catch "") != "pblang.sha3-256.context.v1"
        or type(context.state) != "array" or len(context.state) != 50
        or type(context.buffer) != "array" or len(context.buffer) >= RATE {
        throw "sha3: invalid incremental context";
    }
}

fn update(context, input) {
    _context(context); let data = input;
    if type(data) == "string" { data = str_to_bytes(data); }
    if type(data) != "array" or context.length + len(data) > 67108864 {
        throw "sha3: invalid or oversized incremental input";
    }
    let i = 0;
    while i < len(data) {
        let value = data[i];
        if type(value) != "number" or num_floor(value) != value or value < 0 or value > 255 {
            throw "sha3: incremental input must contain bytes";
        }
        array_push(context.buffer, value); context.length = context.length + 1; i = i + 1;
        if len(context.buffer) == RATE {
            let j = 0; while j < RATE { _xor_byte(context.state, j, context.buffer[j]); j = j + 1; }
            _permute(context.state); context.buffer = [];
        }
    }
    return context;
}

fn clone(context) {
    _context(context);
    return map{ format: context.format, state: slice(context.state, 0, 50),
        buffer: slice(context.buffer, 0, len(context.buffer)), length: context.length };
}

fn final(context) {
    let copy = clone(context); let remaining = len(copy.buffer); let i = 0;
    while i < remaining { _xor_byte(copy.state, i, copy.buffer[i]); i = i + 1; }
    _xor_byte(copy.state, remaining, 6); _xor_byte(copy.state, RATE - 1, 128); _permute(copy.state);
    let out = []; i = 0;
    while i < 32 {
        let lane = num_floor(i / 8); let within = i % 8;
        let word = copy.state[lane * 2 + (if within < 4 { 0 } else { 1 })];
        array_push(out, bit_and(bit_shr(word, (within % 4) * 8), 255)); i = i + 1;
    }
    return out;
}

// SHAKE256 XOF (FIPS 202). SHAKE256 uses the same 1088-bit rate as SHA3-256,
// domain suffix 0x1f, and can squeeze an arbitrary bounded number of bytes.
fn shake256_bytes(input, output_length) {
    let data = input;
    if type(data) == "string" { data = str_to_bytes(data); }
    if type(data) != "array" { throw "sha3: expected string or byte array"; }
    if type(output_length) != "number" or num_floor(output_length) != output_length
        or output_length < 0 or output_length > 16777216 {
        throw "sha3: invalid SHAKE256 output length";
    }

    let state = [];
    let i = 0; while i < 50 { array_push(state, 0); i = i + 1; }
    let offset = 0;
    while len(data) - offset >= RATE {
        i = 0;
        while i < RATE { _xor_byte(state, i, data[offset + i]); i = i + 1; }
        _permute(state); offset = offset + RATE;
    }

    let remaining = len(data) - offset;
    i = 0;
    while i < remaining { _xor_byte(state, i, data[offset + i]); i = i + 1; }
    _xor_byte(state, remaining, 0x1f);
    _xor_byte(state, RATE - 1, 0x80);
    _permute(state);

    let out = []; let within_block = 0;
    while len(out) < output_length {
        if within_block == RATE { _permute(state); within_block = 0; }
        let lane = num_floor(within_block / 8);
        let within = within_block % 8;
        let word = state[lane * 2 + (if within < 4 { 0 } else { 1 })];
        array_push(out, bit_and(bit_shr(word, (within % 4) * 8), 255));
        within_block = within_block + 1;
    }
    return out;
}

fn _hex(bytes) {
    let alphabet = "0123456789abcdef"; let out = ""; let i = 0;
    while i < len(bytes) {
        let b = bytes[i];
        out = out + alphabet[num_floor(b / 16)] + alphabet[b % 16];
        i = i + 1;
    }
    return out;
}

fn digest_hex(input) { return _hex(digest_bytes(input)); }
fn shake256_hex(input, output_length) { return _hex(shake256_bytes(input, output_length)); }

export digest_bytes, digest_hex, new, update, clone, final, shake256_bytes, shake256_hex;
