// Bounded monthly sales scenarios. Integer cents; no demand prediction, tax or I/O.
let MAX_MONEY=1000000000; let MAX_UNITS=100000; let MAX_OFFERS=16;
fn _integer(value,maximum) {
    if type(value)!="number" or not (value>=0 and value<=maximum) or value!=num_floor(value) { throw "invalid nonnegative scenario integer"; }
}
fn _fields(value,names) {
    if type(value)!="map" or len(value)!=len(names) { throw "invalid scenario fields"; }
    for name in names { if not map_has(value,name) { throw "missing scenario field"; } }
}
fn parse_integer(text,maximum=1000000000) {
    _integer(maximum,MAX_MONEY);
    if type(text)!="string" or len(text)<1 or len(text)>10 { throw "expected bounded unsigned integer"; }
    let value=0;
    for i in range(0,len(text)) {
        let digit=str_index_of("0123456789",str_slice(text,i,i+1));
        if digit<0 { throw "expected unsigned decimal digits"; }
        value=value*10+digit; if value>maximum { throw "integer exceeds limit"; }
    }
    return value;
}
// Decimal text is read directly into cents: no floating conversion or rounding.
fn parse_amount(text) {
    if type(text)!="string" or len(text)<1 or len(text)>13 { throw "expected decimal amount"; }
    let parts=str_split(text,".");
    if len(parts)>2 { throw "expected decimal amount"; }
    let whole=parse_integer(parts[0],10000000); let cents=0;
    if len(parts)==2 {
        if len(parts[1])<1 or len(parts[1])>2 { throw "use at most two decimal places"; }
        cents=parse_integer(parts[1],99); if len(parts[1])==1 {cents=cents*10;}
    }
    let result=whole*100+cents; _integer(result,MAX_MONEY); return result;
}
fn _offer(offer) {
    _fields(offer,["id","price_cents","unit_cost_cents","fee_bps","fee_fixed_cents","units","minutes_per_sale"]);
    if type(offer.id)!="string" or len(offer.id)<1 or len(offer.id)>32 { throw "invalid offer id"; }
    for i in range(0,len(offer.id)) { if str_index_of("abcdefghijklmnopqrstuvwxyz0123456789-_",str_slice(offer.id,i,i+1))<0 { throw "invalid offer id"; } }
    for name in ["price_cents","unit_cost_cents","fee_fixed_cents"] { _integer(offer[name],100000000); }
    _integer(offer.fee_bps,10000); _integer(offer.units,MAX_UNITS); _integer(offer.minutes_per_sale,10000);
}
fn calculate(plan) {
    _fields(plan,["target_cents","fixed_cost_cents","fixed_minutes","available_minutes","offers"]);
    _integer(plan.target_cents,MAX_MONEY); _integer(plan.fixed_cost_cents,MAX_MONEY);
    _integer(plan.fixed_minutes,44640); _integer(plan.available_minutes,44640);
    if type(plan.offers)!="array" or len(plan.offers)<1 or len(plan.offers)>MAX_OFFERS { throw "expected one to sixteen offers"; }
    let rows=[]; let seen=map{}; let gross=0; let fees=0; let costs=0; let minutes=plan.fixed_minutes;
    let needed=plan.target_cents+plan.fixed_cost_cents;
    for offer in plan.offers {
        _offer(offer); if map_has(seen,offer.id) { throw "duplicate offer id"; } seen[offer.id]=true;
        // Round percentage fee UP per sale, then add its fixed fee. This is a
        // scenario assumption, not a payment-provider billing implementation.
        let fee=num_floor((offer.price_cents*offer.fee_bps+9999)/10000)+offer.fee_fixed_cents;
        let margin=offer.price_cents-fee-offer.unit_cost_cents;
        let required: any=nil; let required_status="nonpositive_contribution";
        if needed==0 {required=0;required_status="within_unit_limit";}
        elif margin>0 {
            let units=num_floor((needed+margin-1)/margin);
            if units<=MAX_UNITS {required=units;required_status="within_unit_limit";}
            else {required_status="exceeds_unit_limit";}
        }
        let required_minutes=if required==nil {nil} else {plan.fixed_minutes+required*offer.minutes_per_sale};
        gross=gross+offer.price_cents*offer.units; fees=fees+fee*offer.units;
        costs=costs+offer.unit_cost_cents*offer.units; minutes=minutes+offer.minutes_per_sale*offer.units;
        array_push(rows,map{id:offer.id,units:offer.units,fee_per_sale_cents:fee,contribution_per_sale_cents:margin,
            gross_cents:offer.price_cents*offer.units,contribution_cents:margin*offer.units,
            minutes:offer.minutes_per_sale*offer.units,solo_units_for_target:required,solo_target_status:required_status,
            solo_minutes_for_target:required_minutes,solo_fits_time:required!=nil and required_minutes<=plan.available_minutes});
    }
    let result=gross-fees-costs-plan.fixed_cost_cents;
    return map{format:"pblang.offer-plan.v1",offers:rows,gross_cents:gross,fees_cents:fees,
        variable_cost_cents:costs,fixed_cost_cents:plan.fixed_cost_cents,contribution_after_fixed_cents:result,
        target_cents:plan.target_cents,shortfall_cents:num_max(0,plan.target_cents-result),target_met:result>=plan.target_cents,
        workload_minutes:minutes,available_minutes:plan.available_minutes,time_fits:minutes<=plan.available_minutes,
        scenario_only:true,demand_verified:false,tax_included:false,owner_labor_cost_included:false,safe_to_log:false};
}
export MAX_MONEY,MAX_UNITS,MAX_OFFERS,parse_integer,parse_amount,calculate;
