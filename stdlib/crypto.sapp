// stdlib/crypto.sapp — classical cybersecurity primitives (hashing, random, constant-time compare, base64).
// Import: let crypto = import("stdlib:crypto.sapp");

fn hash(s) {
    return sha256(s);
}

fn constant_time_compare(a, b) {
    return constant_time_eq(a, b);
}

// ════════════════════════════════════════════════════════════════════════════════
// Ciphers — honest cryptography. NO invented algorithms.
//
//  ONE-TIME PAD: the ONLY information-theoretically unbreakable cipher (quantum
//  included) — but ONLY if the key is truly random, >= message length, used exactly
//  once, and shared secretly. Break any rule and it's trivially broken.
//
//  ChaCha20 (RFC 8439): a vetted modern stream cipher, verified here against the RFC
//  test vector. Computationally secure; NEVER reuse a (key, nonce) pair. (A full AEAD
//  would add Poly1305 authentication — out of scope.)
// ════════════════════════════════════════════════════════════════════════════════

fn _as_bytes(d) { if type(d) == "string" { return str_to_bytes(d); } return d; }

// ── One-Time Pad ──────────────────────────────────────────────────────────────
fn otp_keygen(n) { return random_bytes(n); }
fn otp_xor(data, key) {
    let d = _as_bytes(data);
    if len(key) < len(d) { throw "otp: key must be at least as long as the data (one-time pad rule)"; }
    let out = [];
    let i = 0;
    while i < len(d) { array_push(out, bit_xor(d[i], key[i])); i = i + 1; }
    return out;
}
fn otp_encrypt(plaintext, key) { return otp_xor(plaintext, key); }
fn otp_decrypt(ciphertext, key) { return otp_xor(ciphertext, key); }

// ── ChaCha20 (RFC 8439) ─────────────────────────────────────────────────────────
let _MASK32 = 4294967295;
let _MOD32 = 4294967296;

fn _add32(a, b) { return num_mod(a + b, _MOD32); }
fn _rotl32(x, n) { return bit_or(bit_and(bit_shl(x, n), _MASK32), bit_shr(x, 32 - n)); }
fn _le32(b, o) { return b[o] + bit_shl(b[o + 1], 8) + bit_shl(b[o + 2], 16) + bit_shl(b[o + 3], 24); }
fn _push_le32(out, w) {
    array_push(out, bit_and(w, 255));
    array_push(out, bit_and(bit_shr(w, 8), 255));
    array_push(out, bit_and(bit_shr(w, 16), 255));
    array_push(out, bit_and(bit_shr(w, 24), 255));
    return 0;
}
fn _qr(w, a, b, c, d) {
    w[a] = _add32(w[a], w[b]); w[d] = _rotl32(bit_xor(w[d], w[a]), 16);
    w[c] = _add32(w[c], w[d]); w[b] = _rotl32(bit_xor(w[b], w[c]), 12);
    w[a] = _add32(w[a], w[b]); w[d] = _rotl32(bit_xor(w[d], w[a]), 8);
    w[c] = _add32(w[c], w[d]); w[b] = _rotl32(bit_xor(w[b], w[c]), 7);
    return 0;
}

// 64-byte keystream block for (key[32], counter, nonce[12]).
fn chacha20_block(key, counter, nonce) {
    let s = [1634760805, 857760878, 2036477234, 1797285236];   // "expand 32-byte k"
    let k = 0;
    while k < 8 { array_push(s, _le32(key, k * 4)); k = k + 1; }
    array_push(s, num_mod(counter, _MOD32));
    array_push(s, _le32(nonce, 0));
    array_push(s, _le32(nonce, 4));
    array_push(s, _le32(nonce, 8));
    let w = [];
    let i = 0;
    while i < 16 { array_push(w, s[i]); i = i + 1; }
    let r = 0;
    while r < 10 {
        _qr(w, 0, 4, 8, 12); _qr(w, 1, 5, 9, 13); _qr(w, 2, 6, 10, 14); _qr(w, 3, 7, 11, 15);
        _qr(w, 0, 5, 10, 15); _qr(w, 1, 6, 11, 12); _qr(w, 2, 7, 8, 13); _qr(w, 3, 4, 9, 14);
        r = r + 1;
    }
    let out = [];
    i = 0;
    while i < 16 { _push_le32(out, _add32(w[i], s[i])); i = i + 1; }
    return out;
}

// XOR data with the ChaCha20 keystream (encrypt == decrypt). counter0 per RFC is 1.
fn chacha20_xor(data, key, nonce, counter0) {
    let d = _as_bytes(data);
    let out = [];
    let counter = counter0;
    let i = 0;
    while i < len(d) {
        let ks = chacha20_block(key, counter, nonce);
        let j = 0;
        while j < 64 and i < len(d) { array_push(out, bit_xor(d[i], ks[j])); i = i + 1; j = j + 1; }
        counter = counter + 1;
    }
    return out;
}
fn chacha20_encrypt(plaintext, key, nonce) { return chacha20_xor(plaintext, key, nonce, 1); }
fn chacha20_decrypt(ciphertext, key, nonce) { return chacha20_xor(ciphertext, key, nonce, 1); }

fn keygen256() { return random_bytes(32); }
fn nonce96() { return random_bytes(12); }

// NOTE: random_bytes, base64_encode, base64_decode are GLOBAL builtins — call them
// directly; they cannot be re-exported (doing so previously made this module fail to
// import, silently caught by callers' try/catch).
// ── HMAC / tokens / constant-time byte compare ─────────────────────────────────

// hmac(msg, key) — HMAC-SHA256 (hex). Use for message authentication / signing;
// NOT sha256(key+msg) which is length-extension vulnerable.
fn hmac(msg, key) { return hmac_sha256(msg, key); }

// verify_hmac(msg, key, tag) — recompute and constant-time compare against tag.
fn verify_hmac(msg, key, tag) { return constant_time_eq(hmac_sha256(msg, key), tag); }

fn _to_hex(bytes) {
    let h = "0123456789abcdef";
    let out = "";
    let i = 0;
    while i < len(bytes) {
        let b = bytes[i];
        out = out + str_slice(h, num_floor(b / 16), num_floor(b / 16) + 1) + str_slice(h, b % 16, (b % 16) + 1);
        i = i + 1;
    }
    return out;
}

// random_token(nbytes) — a cryptographically-random hex token (2*nbytes chars).
fn random_token(nbytes) { return _to_hex(random_bytes(nbytes)); }

// ct_equal_bytes(a, b) — constant-time equality for byte arrays (length first,
// then XOR-accumulate so the loop time doesn't depend on where they differ).
fn ct_equal_bytes(a, b) {
    if len(a) != len(b) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(a) { diff = bit_or(diff, bit_xor(a[i], b[i])); i = i + 1; }
    return diff == 0;
}

export hmac, verify_hmac, random_token, ct_equal_bytes;
export hash, constant_time_compare;
export otp_keygen, otp_xor, otp_encrypt, otp_decrypt;
export chacha20_block, chacha20_xor, chacha20_encrypt, chacha20_decrypt, keygen256, nonce96;
