// Masked, renderer-neutral timing reader. Analyze source once per view creation.
let Timing=import("stdlib:pipeline_timing.sapp");let UI=import("stdlib:modern_ui.sapp");
let PAGE_SIZE=8;
fn _lines(report,index) {
    let row=report.jobs[index];
    return ["Job "+str(index+1)+" / "+str(report.job_count)+if row.critical {" - critical"} else {" - has slack"},
        "Start: "+str(row.earliest_start_ms)+" ms",
        "Finish: "+str(row.earliest_finish_ms)+" ms",
        "Duration: "+str(row.duration_ms)+" ms",
        "Slack: "+str(row.slack_ms)+" ms"];
}
fn create(source,page=0) {
    let report=Timing.inspect_text(source,false);
    if not report.ok {throw "Invalid pipeline estimate.";}
    let pages=num_ceil(report.job_count/PAGE_SIZE);
    if type(page)!="number" or not (page>=0 and page<pages) or page!=num_floor(page) {throw "Invalid pipeline page.";}
    let start=page*PAGE_SIZE;let lines=_lines(report,start);
    let children=[UI.heading("PBIDE pipeline timing"),
        UI.text("Lower bound: "+str(report.lower_bound_ms)+" ms"),
        UI.text("Serial total: "+str(report.serial_duration_ms)+" ms"),
        UI.text("Critical jobs: "+str(report.critical_job_count)),
        UI.text("Page "+str(page+1)+" / "+str(pages))];
    for i in range(0,len(lines)) {array_push(children,UI.text(lines[i],map{name:"timing_detail_"+str(i)}));}
    let buttons=[];
    for index in range(start,num_min(start+PAGE_SIZE,report.job_count)) {
        let selected=_lines(report,index);let actions=[];
        for i in range(0,len(selected)) {array_push(actions,UI.action_set_text("timing_detail_"+str(i),selected[i]));}
        array_push(buttons,UI.button("Job "+str(index+1),UI.action_sequence(actions),map{name:"timing_job_"+str(index)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4}));
    for text in ["Estimates, not measured execution.","Unlimited workers; zero overhead.","Job numbers follow dependency order.","Select a job on this saved page.","No job is executed by this view."] {array_push(children,UI.text(text));}
    return UI.screen(children);
}
export PAGE_SIZE,create;
