// Flow-sensitive PBLang AST taint and control-flow security analysis.
//
// This pass complements literal pattern rules. It tracks values from bounded
// untrusted-source calls through assignments, collections, expressions and
// branch/loop control into security-sensitive sink arguments. It is deliberately
// conservative and reports its parser/coverage boundary explicitly.

let TOKENIZER = import("stdlib/compiler/tokenizer.sapp");
let PARSER = import("stdlib/compiler/parser.sapp");

let FORMAT = "pblang.security-taint.v1";
let MAX_FINDINGS = 256;
let MAX_AST_STEPS = 200000;
let MAX_CALL_EXPANSIONS = 20000;

fn _contains(values, wanted) {
    let i = 0;
    while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _linked_original(name) {
    if type(name) != "string" or not str_starts_with(name, "__pbi") { return ""; }
    let i = 5; let digits = 0;
    while i < len(name) {
        let code = strcharcodeat(name, i);
        if code < 48 or code > 57 { break; }
        digits = digits + 1; i = i + 1;
    }
    if digits == 0 or i >= len(name) or strcharcodeat(name, i) != 95 { return ""; }
    return str_slice(name, i + 1, len(name));
}

fn _is_sanitizer(config, name, full) {
    if _contains(config.sanitizers, name) or _contains(config.sanitizers, full) { return true; }
    let original = _linked_original(name);
    return original != "" and _contains(config.sanitizers, original);
}

fn _copy_map(value) {
    let out = map{};
    let keys = map_keys(value); let i = 0;
    while i < len(keys) { out[keys[i]] = value[keys[i]]; i = i + 1; }
    return out;
}

fn _merge_names(a, b) {
    let out = []; let i = 0;
    while i < len(a) { if not _contains(out, a[i]) { array_push(out, a[i]); } i = i + 1; }
    i = 0;
    while i < len(b) { if not _contains(out, b[i]) { array_push(out, b[i]); } i = i + 1; }
    return out;
}

fn _clean() {
    return map{ tainted: false, data: false, sources: [], control: false,
        fields: map{}, module_id: "", call_sink: "" };
}
fn _tainted(source, control = false) {
    return map{ tainted: true, sources: if source == "" { [] } else { [source] },
        data: not control, control: control, fields: map{}, module_id: "", call_sink: "" };
}

fn _module_id(node) {
    if node == nil or type(node) != "map" or (try node.kind catch "") != "call"
       or _callee_name(try node.func catch nil) != "import" or len(node.args) != 1
       or (try node.args[0].kind catch "") != "string" { return ""; }
    let value = str_lower(str_trim(str(node.args[0].value)));
    if value == "stdlib:interop.sapp" or value == "stdlib/interop.sapp" {
        return "stdlib:interop.sapp";
    }
    if value == "stdlib:polyglot_registry.sapp" or value == "stdlib/polyglot_registry.sapp" {
        return "stdlib:polyglot_registry.sapp";
    }
    return "";
}

fn _module_flow(module_id) {
    let out = _clean(); out.module_id = module_id; return out;
}

fn _sink_flow(sink) {
    let out = _clean(); out.call_sink = sink; return out;
}

fn _fields(flow) {
    let value = try flow.fields catch nil;
    if type(value) == "map" { return value; }
    return map{};
}

fn _merge_fields(a, b) {
    let left = _fields(a); let right = _fields(b);
    let names = _merge_names(map_keys(left), map_keys(right));
    let out = map{}; let i = 0;
    while i < len(names) {
        if map_has(left, names[i]) and map_has(right, names[i]) {
            out[names[i]] = _merge(left[names[i]], right[names[i]]);
        } elif map_has(left, names[i]) { out[names[i]] = left[names[i]]; }
        else { out[names[i]] = right[names[i]]; }
        i = i + 1;
    }
    return out;
}

fn _merge(a, b) {
    if a == nil { return b; }
    if b == nil { return a; }
    let module_a = try a.module_id catch "";
    let module_b = try b.module_id catch "";
    let module_id = module_a;
    if module_a == "" { module_id = module_b; }
    elif module_b != "" and module_a != module_b { module_id = ""; }
    let sink_a = try a.call_sink catch "";
    let sink_b = try b.call_sink catch "";
    let call_sink = sink_a;
    if sink_a == "" { call_sink = sink_b; }
    elif sink_b != "" and sink_a != sink_b { call_sink = ""; }
    return map{ tainted: a.tainted or b.tainted,
        data: (try a.data catch a.tainted) or (try b.data catch b.tainted),
        sources: _merge_names(a.sources, b.sources),
        control: a.control or b.control,
        fields: _merge_fields(a, b), module_id: module_id, call_sink: call_sink };
}

fn _active(flow) {
    return flow != nil and ((try flow.tainted catch false) or (try flow.control catch false));
}

fn _defaults() {
    return map{
        sources: ["os_args", "env_get", "fs_read", "fs_read_bytes", "http_get",
            "http_post", "tcp_read", "tcp_read_until", "read_line", "input"],
        sanitizers: ["safe_rel_path", "sanitize_path", "validate_url", "parse_number",
            "parse_bool", "constant_time_eq"],
        sinks: map{
            exec: map{ severity: "high", args: [0], class: "command-injection", control_flow: true },
            proc_spawn_wait: map{ severity: "high", args: [0, 1], class: "command-injection", control_flow: false },
            polyglot_exec: map{ severity: "high", args: [0, 1], class: "code-injection", control_flow: true },
            "stdlib:interop.sapp.run_filter": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:interop.sapp.call": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:interop.sapp.pipe": map{ severity: "high", args: [1, 3], class: "code-injection", control_flow: true },
            "stdlib:interop.sapp.benchmark_compare": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:interop.sapp.cross_call": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:polyglot_registry.sapp.run": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:polyglot_registry.sapp.run_with_input": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:polyglot_registry.sapp.compile": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            "stdlib:polyglot_registry.sapp.json_bridge": map{ severity: "high", args: [1], class: "code-injection", control_flow: true },
            ffi_load: map{ severity: "high", args: [0], class: "native-library-injection", control_flow: false },
            ffi_call: map{ severity: "high", args: [1], class: "native-symbol-injection", control_flow: false },
            ffi_call_typed: map{ severity: "high", args: [1], class: "native-symbol-injection", control_flow: false },
            fs_write: map{ severity: "high", args: [0], class: "path-traversal", control_flow: true },
            fs_write_bytes: map{ severity: "high", args: [0], class: "path-traversal", control_flow: true },
            fs_remove: map{ severity: "high", args: [0], class: "path-traversal", control_flow: true },
            fs_rename: map{ severity: "high", args: [0, 1], class: "path-traversal", control_flow: true },
            fs_copy: map{ severity: "high", args: [0, 1], class: "path-traversal", control_flow: true },
            sqlite_exec: map{ severity: "high", args: [1], class: "sql-injection" },
            sqlite_query: map{ severity: "high", args: [1], class: "sql-injection" },
            http_get: map{ severity: "medium", args: [0], class: "server-side-request" },
            http_post: map{ severity: "medium", args: [0], class: "server-side-request" },
            tcp_connect: map{ severity: "medium", args: [0], class: "network-target-injection" }
        }
    };
}

fn _configuration(options) {
    let base = _defaults();
    let sources = try options.taint_sources catch base.sources;
    let sanitizers = try options.taint_sanitizers catch base.sanitizers;
    let sinks = try options.taint_sinks catch base.sinks;
    if type(sources) != "array" or len(sources) > 128 { return map{ ok: false, error: "taint_sources must be a bounded array" }; }
    if type(sanitizers) != "array" or len(sanitizers) > 128 { return map{ ok: false, error: "taint_sanitizers must be a bounded array" }; }
    if type(sinks) != "map" or len(map_keys(sinks)) > 128 { return map{ ok: false, error: "taint_sinks must be a bounded map" }; }
    return map{ ok: true, sources: sources, sanitizers: sanitizers, sinks: sinks };
}

fn _last_name(name) {
    let parts = str_split(name, ".");
    if len(parts) == 0 { return name; }
    return parts[len(parts) - 1];
}

fn _callee_name(node) {
    if node == nil or type(node) != "map" { return ""; }
    if (try node.kind catch "") == "ident" { return str(node.name); }
    if (try node.kind catch "") == "member" or (try node.kind catch "") == "opt_member" {
        let prefix = _callee_name(node.obj);
        if prefix == "" { return str(node.name); }
        return prefix + "." + str(node.name);
    }
    return "";
}

fn _member_name(node) {
    if node == nil or type(node) != "map" { return ""; }
    let kind = try node.kind catch "";
    if kind == "member" or kind == "opt_member" { return str(node.name); }
    if (kind == "index" or kind == "opt_index")
       and (try node.index.kind catch "") == "string" { return str(node.index.value); }
    return "";
}

fn _sink_key(state, node, full, name, env, callable) {
    let indirect = try callable.call_sink catch "";
    if indirect != "" and map_has(state.config.sinks, indirect) { return indirect; }
    if map_has(state.config.sinks, full) { return full; }
    let root = _root_ident(try node.func catch nil);
    if root != "" and map_has(env, root) {
        let module_id = try env[root].module_id catch "";
        let canonical = "";
        if module_id != "" { canonical = module_id + "." + name; }
        if canonical != "" and map_has(state.config.sinks, canonical) { return canonical; }
    }
    if map_has(state.config.sinks, name) { return name; }
    return "";
}

fn _root_ident(node) {
    if node == nil or type(node) != "map" { return ""; }
    let kind = try node.kind catch "";
    if kind == "ident" { return str(node.name); }
    if kind == "member" or kind == "opt_member" or kind == "index" or kind == "opt_index" {
        return _root_ident(node.obj);
    }
    return "";
}

fn _line(node) { return try node.line catch 0; }

fn _step(state) {
    state.steps = state.steps + 1;
    if state.steps > state.max_steps { state.limit_exceeded = true; return false; }
    return true;
}

fn _finding(state, sink, spec, arg_index, flow, node, control_only) {
    let identity = str(spec.class) + "\x00" + sink + "\x00" + str(arg_index)
        + "\x00" + str(_line(node)) + "\x00" + json_stringify(flow.sources)
        + "\x00" + str(control_only or flow.control);
    if map_has(state.finding_keys, identity) { return; }
    // A duplicate already retained is not lost evidence. A new finding that
    // cannot fit makes the final decision incomplete and blocking.
    if len(state.findings) >= state.max_findings { state.truncated = true; return; }
    state.finding_keys[identity] = true;
    array_push(state.findings, map{
        format: "pblang.security-taint.finding.v1",
        id: "taint." + str(spec.class),
        severity: str(spec.severity), path: state.path, line: _line(node),
        sink: sink, argument: arg_index, sources: flow.sources,
        control_flow: control_only or flow.control,
        message: if control_only {
            "untrusted control flow reaches security-sensitive sink " + sink
        } else {
            "untrusted data reaches security-sensitive sink " + sink
        }
    });
}

fn _expr(node, env, state, control_flow) {
    if node == nil or type(node) != "map" { return _clean(); }
    if not _step(state) { return _clean(); }
    let kind = try node.kind catch "";
    if kind == "ident" {
        if map_has(env, node.name) { return env[node.name]; }
        return _clean();
    }
    if kind == "number" or kind == "string" or kind == "bool" or kind == "nil" { return _clean(); }
    if kind == "assign" {
        let value = _expr(node.value, env, state, control_flow);
        env[node.name] = value; return value;
    }
    if kind == "call" {
        let full = _callee_name(node.func); let name = _last_name(full);
        if name == "" { name = _member_name(node.func); }
        let callable = _expr(node.func, env, state, control_flow);
        let combined = _clean(); let values = []; let i = 0;
        while i < len(node.args) {
            let value = _expr(node.args[i], env, state, control_flow);
            array_push(values, value); combined = _merge(combined, value); i = i + 1;
        }
        let function_key = "";
        if map_has(state.functions, full) { function_key = full; }
        elif map_has(state.functions, name) { function_key = name; }
        let sanitizes = _is_sanitizer(state.config, name, full);
        if sanitizes {
            // Analyze a local sanitizer with tainted arguments so its side
            // effects remain visible, but terminate taint on its return value.
            if function_key != "" {
                let cache_key = "sanitizer:" + function_key;
                if not _active(combined) and not _active(control_flow)
                    and map_has(state.clean_summaries, cache_key) { return _clean(); }
                let control_call = not (try combined.data catch combined.tainted)
                    and _active(control_flow);
                if control_call and map_has(state.control_summaries, cache_key) { return _clean(); }
                if (try state.call_stack[function_key] catch false) {
                    state.recursion_skips = state.recursion_skips + 1;
                    return _clean();
                }
                if state.call_expansions >= state.max_call_expansions {
                    state.call_limit_exceeded = true; return _clean();
                }
                let target = state.functions[function_key]; let call_env = map{}; i = 0;
                while i < len(target.params) {
                    let parameter = if type(target.params[i]) == "map" { target.params[i].name }
                        else { str(target.params[i]) };
                    call_env[parameter] = if i < len(values) { values[i] } else { _clean() };
                    i = i + 1;
                }
                state.call_stack[function_key] = true;
                state.call_expansions = state.call_expansions + 1;
                _block(target.body, call_env, state, control_flow);
                state.call_stack[function_key] = false;
                state.analyzed_functions[function_key] = true;
                if not _active(combined) and not _active(control_flow) {
                    state.clean_summaries[cache_key] = _clean();
                }
                if control_call { state.control_summaries[cache_key] = _clean(); }
            }
            return _clean();
        }
        if function_key != "" {
            let flow_key = "flow:" + function_key + ":"
                + sha256(json_stringify(map{ values: values, control: control_flow }));
            if map_has(state.flow_summaries, flow_key) {
                return state.flow_summaries[flow_key];
            }
            let clean_call = not _active(combined) and not _active(control_flow);
            if clean_call and map_has(state.clean_summaries, function_key) {
                return state.clean_summaries[function_key];
            }
            let control_call = not (try combined.data catch combined.tainted)
                and _active(control_flow);
            if control_call and map_has(state.control_summaries, function_key) {
                return state.control_summaries[function_key];
            }
            if (try state.call_stack[function_key] catch false) {
                state.recursion_skips = state.recursion_skips + 1;
                // The active frame still walks every branch and sink. Returning
                // the incoming flow is a conservative recursive-call summary.
                return combined;
            }
            if state.call_expansions >= state.max_call_expansions {
                state.call_limit_exceeded = true; return combined;
            }
            let target = state.functions[function_key]; let call_env = map{}; i = 0;
            while i < len(target.params) {
                let parameter = if type(target.params[i]) == "map" { target.params[i].name }
                    else { str(target.params[i]) };
                call_env[parameter] = if i < len(values) { values[i] } else { _clean() };
                i = i + 1;
            }
            state.call_stack[function_key] = true;
            state.call_expansions = state.call_expansions + 1;
            let returned = _block(target.body, call_env, state, control_flow);
            state.call_stack[function_key] = false;
            state.analyzed_functions[function_key] = true;
            if clean_call { state.clean_summaries[function_key] = returned; }
            if control_call { state.control_summaries[function_key] = returned; }
            state.flow_summaries[flow_key] = returned;
            return returned;
        }
        let sink_key = _sink_key(state, node, full, name, env, callable);
        if sink_key != "" {
            let key = sink_key;
            let spec = state.config.sinks[key]; let indexes = try spec.args catch [];
            i = 0;
            while i < len(indexes) {
                let index = indexes[i];
                if index >= 0 and index < len(values)
                    and (try values[index].data catch values[index].tainted) {
                    _finding(state, full, spec, index, values[index], node, false);
                } elif control_flow.tainted and (try spec.control_flow catch false) {
                    _finding(state, full, spec, index, control_flow, node, true);
                }
                i = i + 1;
            }
        }
        if _contains(state.config.sources, name) or _contains(state.config.sources, full) {
            return _tainted(full);
        }
        if name == "push" or name == "array_push" {
            let root = "";
            if (try node.func.kind catch "") == "member" or (try node.func.kind catch "") == "opt_member" {
                root = _root_ident(node.func.obj);
            } elif len(node.args) > 0 {
                root = _root_ident(node.args[0]);
            }
            if root != "" {
                let prior = if map_has(env, root) { env[root] } else { _clean() };
                env[root] = _merge(prior, combined);
            }
        }
        return combined;
    }
    if kind == "binary" or kind == "coalesce" {
        return _merge(_expr(node.left, env, state, control_flow),
            _expr(node.right, env, state, control_flow));
    }
    if kind == "unary" { return _expr(node.operand, env, state, control_flow); }
    if kind == "index" or kind == "opt_index" {
        let object = _expr(node.obj, env, state, control_flow);
        let index = _expr(node.index, env, state, control_flow);
        let member_name = _member_name(node);
        let module_id = try object.module_id catch "";
        let canonical = "";
        if module_id != "" and member_name != "" {
            canonical = module_id + "." + member_name;
        }
        if canonical != "" and map_has(state.config.sinks, canonical) {
            return _sink_flow(canonical);
        }
        return _merge(object, index);
    }
    if kind == "member" or kind == "opt_member" {
        let object = _expr(node.obj, env, state, control_flow);
        let module_id = try object.module_id catch "";
        let canonical = "";
        if module_id != "" { canonical = module_id + "." + str(node.name); }
        if canonical != "" and map_has(state.config.sinks, canonical) {
            return _sink_flow(canonical);
        }
        let fields = _fields(object);
        if map_has(fields, node.name) { return fields[node.name]; }
        if len(map_keys(fields)) > 0 { return _clean(); }
        return object;
    }
    if kind == "array" {
        let out = _clean(); let i = 0;
        while i < len(node.items) { out = _merge(out, _expr(node.items[i], env, state, control_flow)); i = i + 1; }
        return out;
    }
    if kind == "map" {
        let out = _clean(); let i = 0;
        while i < len(node.entries) {
            let value = _expr(node.entries[i].value, env, state, control_flow);
            out = _merge(out, value);
            out.fields[str(node.entries[i].key)] = value;
            i = i + 1;
        }
        return out;
    }
    if kind == "if_expr" {
        let condition = _expr(node.cond, env, state, control_flow);
        let next_control = _merge(control_flow, condition);
        return _merge(_expr(node.then, _copy_map(env), state, next_control),
            _expr(node.else, _copy_map(env), state, next_control));
    }
    if kind == "try" {
        return _merge(_expr(node.body, _copy_map(env), state, control_flow),
            _expr(node.handler, _copy_map(env), state, control_flow));
    }
    if kind == "assign_to" {
        let target_flow = _expr(node.target, env, state, control_flow);
        let value_flow = _expr(node.value, env, state, control_flow);
        let root = _root_ident(node.target);
        if root != "" {
            let prior = if map_has(env, root) { env[root] } else { _clean() };
            let updated = _merge(prior, value_flow);
            let target_kind = try node.target.kind catch "";
            if target_kind == "member" or target_kind == "opt_member" {
                updated.fields[str(node.target.name)] = value_flow;
            }
            env[root] = updated;
        }
        return _merge(target_flow, value_flow);
    }
    return _clean();
}

fn _merge_env(target, left, right) {
    let keys = _merge_names(map_keys(left), map_keys(right)); let i = 0;
    while i < len(keys) {
        let a = if map_has(left, keys[i]) { left[keys[i]] } else { _clean() };
        let b = if map_has(right, keys[i]) { right[keys[i]] } else { _clean() };
        target[keys[i]] = _merge(a, b); i = i + 1;
    }
}

fn _block(block, env, state, control_flow) {
    if block == nil { return _clean(); }
    let statements = if (try block.kind catch "") == "block" { block.stmts } else { block };
    let returned = _clean(); let i = 0;
    while i < len(statements) and not state.limit_exceeded {
        returned = _merge(returned, _stmt(statements[i], env, state, control_flow)); i = i + 1;
    }
    return returned;
}

fn _stmt(node, env, state, control_flow) {
    if node == nil or type(node) != "map" { return _clean(); }
    if not _step(state) { return _clean(); }
    let kind = try node.kind catch "";
    if kind == "let" or kind == "const" {
        let module_id = _module_id(node.value);
        let value = _expr(node.value, env, state, control_flow);
        if module_id != "" { value = _module_flow(module_id); }
        if control_flow.tainted { value = _merge(value, map{ tainted: true,
            data: false, sources: control_flow.sources, control: true, fields: map{} }); }
        env[node.name] = value; return _clean();
    }
    if kind == "expr_stmt" { _expr(node.expr, env, state, control_flow); return _clean(); }
    if kind == "print" { _expr(node.value, env, state, control_flow); return _clean(); }
    if kind == "return" { return _expr(node.value, env, state, control_flow); }
    if kind == "throw" { return _expr(node.value, env, state, control_flow); }
    if kind == "block" { return _block(node, env, state, control_flow); }
    if kind == "if" {
        let condition = _expr(node.cond, env, state, control_flow);
        let branch_control = _merge(control_flow, condition);
        let left = _copy_map(env); let right = _copy_map(env);
        let returned = _block(node.then, left, state, branch_control);
        let ei = 0;
        while ei < len(node.elifs) {
            let ec = _expr(node.elifs[ei].cond, right, state, branch_control);
            returned = _merge(returned, _block(node.elifs[ei].body, right, state,
                _merge(branch_control, ec))); ei = ei + 1;
        }
        if node.else != nil { returned = _merge(returned, _block(node.else, right, state, branch_control)); }
        _merge_env(env, left, right); return returned;
    }
    if kind == "while" or kind == "loop" {
        let condition = if kind == "while" { _expr(node.cond, env, state, control_flow) } else { _clean() };
        let loop_env = _copy_map(env);
        let returned = _block(node.body, loop_env, state, _merge(control_flow, condition));
        _merge_env(env, env, loop_env); return returned;
    }
    if kind == "for" or kind == "for_in" or kind == "for_range" or kind == "for_map" {
        let iter = _clean();
        if kind == "for" { iter = _expr(node.end, env, state, control_flow); }
        elif kind == "for_in" { iter = _expr(node.iter, env, state, control_flow); }
        elif kind == "for_range" { iter = _merge(_expr(node.start, env, state, control_flow), _expr(node.end, env, state, control_flow)); }
        else { iter = _expr(node.iter, env, state, control_flow); }
        let loop_env = _copy_map(env);
        if map_has(node, "name") { loop_env[node.name] = iter; }
        if map_has(node, "key") { loop_env[node.key] = iter; }
        if map_has(node, "val") { loop_env[node.val] = iter; }
        let returned = _block(node.body, loop_env, state, _merge(control_flow, iter));
        _merge_env(env, env, loop_env); return returned;
    }
    return _clean();
}

fn _valid_limit(value, minimum, maximum) {
    if type(value) != "number" { return false; }
    if value != value or value - value != 0 { return false; }
    return value >= minimum and value <= maximum and value == num_floor(value);
}

// Shared admission for direct and dependency-wide callers. Only omitted keys
// select defaults; malformed explicit values must not silently change budgets.
fn limits(options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" {
        return map{ ok: false, error: "taint limits require map options" };
    }
    let specs = [
        map{ name: "max_taint_findings", minimum: 1, maximum: 2048, fallback: MAX_FINDINGS },
        map{ name: "max_taint_steps", minimum: 100, maximum: 2000000, fallback: MAX_AST_STEPS },
        map{ name: "max_call_expansions", minimum: 1, maximum: 200000, fallback: MAX_CALL_EXPANSIONS }
    ];
    let out = map{ ok: true };
    for spec in specs {
        let value = if map_has(options, spec.name) { options[spec.name] } else { spec.fallback };
        if not _valid_limit(value, spec.minimum, spec.maximum) {
            return map{ ok: false, error: spec.name + " must be a finite integer in "
                + str(spec.minimum) + ".." + str(spec.maximum) };
        }
        out[spec.name] = value;
    }
    return out;
}

fn analyze(source, path = "[source]", options = nil) {
    if options == nil { options = map{}; }
    if type(source) != "string" or type(options) != "map" {
        return map{ ok: false, passed: false, format: FORMAT,
            error: "taint analysis requires source text and map options" };
    }
    let config = _configuration(options);
    if not config.ok { return map{ ok: false, passed: false, format: FORMAT, error: config.error }; }
    let bounded = limits(options);
    if not bounded.ok { return map{ ok: false, passed: false, format: FORMAT, error: bounded.error }; }
    let max_findings = bounded.max_taint_findings;
    let max_steps = bounded.max_taint_steps;
    let max_call_expansions = bounded.max_call_expansions;
    let tokens = try TOKENIZER.tokenize(source) catch nil;
    if type(tokens) != "array" {
        return map{ ok: false, passed: false, format: FORMAT, path: path,
            parser_complete: false, error: "tokenization failed during taint analysis", parser_errors: [] };
    }
    for token in tokens {
        if (try token.unterminated catch false) == true {
            return map{ ok: false, passed: false, format: FORMAT, path: path,
                parser_complete: false, error: "unterminated source token",
                parser_errors: ["unterminated source token at line " + str(token.line)] };
        }
    }
    let parsed = try PARSER.parse(tokens) catch nil;
    if parsed == nil or type(try parsed.errors catch nil) != "array" {
        return map{ ok: false, passed: false, format: FORMAT, path: path,
            parser_complete: false, error: "self-hosted parser failed during taint analysis", parser_errors: [] };
    }
    if len(parsed.errors) > 0 {
        return map{ ok: false, passed: false, format: FORMAT, path: path,
            parser_complete: false, error: "source is not semantically analyzable", parser_errors: parsed.errors };
    }
    let functions = map{}; let function_names = []; let fi = 0;
    while fi < len(parsed.stmts) {
        if (try parsed.stmts[fi].kind catch "") == "fn" {
            functions[parsed.stmts[fi].name] = parsed.stmts[fi];
            array_push(function_names, parsed.stmts[fi].name);
        }
        fi = fi + 1;
    }
    let state = map{ path: path, config: config, findings: [], steps: 0,
        max_steps: max_steps, max_findings: max_findings, limit_exceeded: false,
        truncated: false, functions: functions, call_stack: map{}, call_expansions: 0,
        max_call_expansions: max_call_expansions, call_limit_exceeded: false,
        recursion_skips: 0, clean_summaries: map{}, control_summaries: map{},
        flow_summaries: map{}, finding_keys: map{},
        analyzed_functions: map{} };
    let top = map{}; let clean_control = _clean(); let i = 0;
    // Top-level initialization and every declared function get isolated flow
    // environments. Parameters are clean unless the source explicitly reaches
    // them through a configured source call; interprocedural summaries are a
    // separate report boundary rather than fabricated precision.
    while i < len(parsed.stmts) and not state.limit_exceeded {
        if (try parsed.stmts[i].kind catch "") != "fn" {
            _stmt(parsed.stmts[i], top, state, clean_control);
        }
        i = i + 1;
    }
    let entry_flow_option = try options.entry_flow_only catch false;
    let entry_flow_only = type(entry_flow_option) == "bool" and entry_flow_option;
    i = 0;
    while not entry_flow_only and i < len(function_names) and not state.limit_exceeded {
        let fn_node = functions[function_names[i]];
        if not map_has(state.analyzed_functions, function_names[i])
            and not map_has(state.clean_summaries, function_names[i])
            and not (try state.call_stack[function_names[i]] catch false) {
            let env = map{}; let pi = 0;
            while pi < len(fn_node.params) {
                let name = if type(fn_node.params[pi]) == "map" { fn_node.params[pi].name }
                    else { str(fn_node.params[pi]) };
                env[name] = _clean(); pi = pi + 1;
            }
            state.call_stack[function_names[i]] = true;
            let summary = _block(fn_node.body, env, state, clean_control);
            state.call_stack[function_names[i]] = false;
            state.analyzed_functions[function_names[i]] = true;
            if not map_has(state.clean_summaries, function_names[i]) {
                state.clean_summaries[function_names[i]] = summary;
            }
        }
        i = i + 1;
    }
    let blocking = 0; i = 0;
    while i < len(state.findings) {
        if state.findings[i].severity == "high" { blocking = blocking + 1; }
        i = i + 1;
    }
    if state.limit_exceeded { blocking = blocking + 1; }
    if state.call_limit_exceeded { blocking = blocking + 1; }
    if state.truncated { blocking = blocking + 1; }
    let interprocedural_complete = not state.call_limit_exceeded
        and not state.limit_exceeded and not state.truncated;
    return map{ ok: true, passed: blocking == 0, format: FORMAT, path: path,
        findings: state.findings, finding_count: len(state.findings), blocking: blocking,
        ast_steps: state.steps, parser_complete: true,
        limit_exceeded: state.limit_exceeded, truncated: state.truncated,
        function_count: len(function_names), call_expansions: state.call_expansions,
        call_limit_exceeded: state.call_limit_exceeded, recursion_skips: state.recursion_skips,
        recursion_summaries: state.recursion_skips,
        interprocedural_complete: interprocedural_complete,
        entry_flow_only: entry_flow_only,
        coverage: if entry_flow_only {
            "entry-reachable flow-sensitive interprocedural AST data/control flow with bounded call expansion"
        } else { "all-functions flow-sensitive interprocedural AST data/control flow with bounded call expansion" } };
}

export FORMAT, MAX_FINDINGS, MAX_AST_STEPS, MAX_CALL_EXPANSIONS, limits, analyze;
