// stdlib/design_engine.sapp — responsive 2D/3D layout primitives for IDE/design tools.
//
// This is intentionally UI-backend-neutral: it computes rectangles, responsive layout,
// snapping, hit-testing, and simple 3D-to-2D projection. Native IDE, gui.sapp, CAD-like
// tools, circuit editors, dashboard builders, and web exporters can share the same item
// model instead of hand-placing everything.

fn clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn rect(x, y, w, h) {
    return map{ x: num_floor(x), y: num_floor(y), w: num_floor(w), h: num_floor(h) };
}

fn viewport(w, h) {
    return rect(0, 0, w, h);
}

fn item2d(kind, name, x, y, w, h) {
    return map{
        space: "2d", kind: kind, name: name,
        x: x, y: y, w: w, h: h,
        min_w: 32, min_h: 18,
        anchor: "free", visible: true
    };
}

fn item3d(kind, name, x, y, z, w, h, d) {
    return map{
        space: "3d", kind: kind, name: name,
        x: x, y: y, z: z, w: w, h: h, d: d,
        min_w: 24, min_h: 24,
        anchor: "free", visible: true
    };
}

fn set_anchor(item, anchor) { item.anchor = anchor; return item; }
fn set_min(item, w, h) { item.min_w = w; item.min_h = h; return item; }

fn min_w(item) { return try item.min_w catch 24; }
fn min_h(item) { return try item.min_h catch 18; }
fn item_w(item) { return try item.w catch min_w(item); }
fn item_h(item) { return try item.h catch min_h(item); }

fn snap_value(v, grid) {
    if grid <= 1 { return num_floor(v); }
    return num_floor((v + grid / 2) / grid) * grid;
}

fn snap_rect(r, grid) {
    return rect(snap_value(r.x, grid), snap_value(r.y, grid), snap_value(r.w, grid), snap_value(r.h, grid));
}

fn bounds(item) {
    return rect(try item.x catch 0, try item.y catch 0, item_w(item), item_h(item));
}

fn apply_anchor(item, vp, margin) {
    let r = bounds(item);
    let a = try item.anchor catch "free";
    if a == "top-left" { r.x = margin; r.y = margin; }
    else if a == "top-right" { r.x = vp.w - r.w - margin; r.y = margin; }
    else if a == "bottom-left" { r.x = margin; r.y = vp.h - r.h - margin; }
    else if a == "bottom-right" { r.x = vp.w - r.w - margin; r.y = vp.h - r.h - margin; }
    else if a == "center" { r.x = (vp.w - r.w) / 2; r.y = (vp.h - r.h) / 2; }
    else if a == "fill" { r.x = margin; r.y = margin; r.w = vp.w - 2 * margin; r.h = vp.h - 2 * margin; }
    let mw = min_w(item);
    let mh = min_h(item);
    if r.w < mw { r.w = mw; }
    if r.h < mh { r.h = mh; }
    r.x = clamp(r.x, 0, vp.w - r.w);
    r.y = clamp(r.y, 0, vp.h - r.h);
    return rect(r.x, r.y, r.w, r.h);
}

fn grid_layout(items, vp, cols, gap, margin) {
    if cols < 1 { cols = 1; }
    let out = [];
    let cellw = (vp.w - margin * 2 - gap * (cols - 1)) / cols;
    if cellw < 1 { cellw = 1; }
    let i = 0;
    while i < len(items) {
        let it = items[i];
        let col = num_mod(i, cols);
        let row = num_floor(i / cols);
        let h = item_h(it);
        let mh = min_h(it);
        if h < mh { h = mh; }
        let x = margin + col * (cellw + gap);
        let y = margin + row * (h + gap);
        push(out, rect(x, y, cellw, h));
        i = i + 1;
    }
    return out;
}

fn stack_layout(items, vp, dir, gap, margin) {
    let out = [];
    let cursor = margin;
    let i = 0;
    while i < len(items) {
        let it = items[i];
        if dir == "horizontal" {
            let w = item_w(it);
            push(out, rect(cursor, margin, w, vp.h - margin * 2));
            cursor = cursor + w + gap;
        } else {
            let h = item_h(it);
            push(out, rect(margin, cursor, vp.w - margin * 2, h));
            cursor = cursor + h + gap;
        }
        i = i + 1;
    }
    return out;
}

fn responsive_cols(width) {
    if width < 520 { return 1; }
    if width < 900 { return 2; }
    if width < 1300 { return 3; }
    return 4;
}

fn layout(items, vp, mode) {
    let gap = 12;
    let margin = 16;
    let out = [];
    if mode == "grid" or mode == "responsive" {
        let cols = responsive_cols(vp.w);
        if mode == "grid" { cols = 3; }
        return grid_layout(items, vp, cols, gap, margin);
    }
    if mode == "stack-x" { return stack_layout(items, vp, "horizontal", gap, margin); }
    if mode == "stack-y" { return stack_layout(items, vp, "vertical", gap, margin); }
    let i = 0;
    while i < len(items) {
        push(out, apply_anchor(items[i], vp, margin));
        i = i + 1;
    }
    return out;
}

fn apply_layout(items, vp, mode) {
    let rs = layout(items, vp, mode);
    let i = 0;
    while i < len(items) and i < len(rs) {
        items[i].x = rs[i].x; items[i].y = rs[i].y; items[i].w = rs[i].w; items[i].h = rs[i].h;
        i = i + 1;
    }
    return items;
}

fn project_iso(p, origin_x, origin_y, scale) {
    let x = origin_x + (p.x - p.z) * scale;
    let y = origin_y + (p.x + p.z) * scale / 2 - p.y * scale;
    return map{ x: num_floor(x), y: num_floor(y) };
}

fn project_item(item, origin_x, origin_y, scale) {
    if (try item.space catch "2d") != "3d" { return bounds(item); }
    let p = project_iso(map{ x: item.x, y: item.y, z: item.z }, origin_x, origin_y, scale);
    return rect(p.x, p.y, item_w(item), item_h(item));
}

fn hit_test(items, x, y) {
    let i = len(items) - 1;
    while i >= 0 {
        let it = items[i];
        if (try it.visible catch true) {
            let r = bounds(it);
            if x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h { return i; }
        }
        i = i - 1;
    }
    return 0 - 1;
}

export clamp, rect, viewport, item2d, item3d, set_anchor, set_min;
export min_w, min_h, item_w, item_h;
export snap_value, snap_rect, bounds, apply_anchor, responsive_cols;
export grid_layout, stack_layout, layout, apply_layout;
// ── Rect geometry helpers ───────────────────────────────────────────────────────
fn rect_center(r) { return map{ x: r.x + r.w / 2, y: r.y + r.h / 2 }; }
fn rect_contains_point(r, px, py) {
    return px >= r.x and px < r.x + r.w and py >= r.y and py < r.y + r.h;
}
fn rect_intersect(a, b) {
    return a.x < b.x + b.w and a.x + a.w > b.x and a.y < b.y + b.h and a.y + a.h > b.y;
}
fn rect_union(a, b) {
    let x = a.x; if b.x < x { x = b.x; }
    let y = a.y; if b.y < y { y = b.y; }
    let r = a.x + a.w; if b.x + b.w > r { r = b.x + b.w; }
    let bot = a.y + a.h; if b.y + b.h > bot { bot = b.y + b.h; }
    return rect(x, y, r - x, bot - y);
}

export rect_center, rect_contains_point, rect_intersect, rect_union;
export project_iso, project_item, hit_test;
