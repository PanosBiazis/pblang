// stdlib/safety.sapp — Rust-inspired safety utilities for pblang.
//
// pblang's VM is written in Rust and inherits Rust's memory safety guarantees
// for the runtime itself. This module provides language-level safety primitives
// so that CODE WRITTEN IN pblang also has strong safety guarantees.
//
// ## What is provided
// - `assert(cond, msg)` — runtime assertions (like Rust's `assert!`)
// - `expect(val, msg)` — unwrap non-nil or panic (like Rust's `.expect()`)
// - `check_type(val, t)` — runtime type assertion (like TypeScript's type guards)
// - `is_nil(val)` — nil-check helper (functional form)
// - `non_null(val, name)` — enforce non-null invariant
// - `checked.*` — arithmetic with overflow/div-zero detection
// - `freeze(val)` — make a map immutable (like Rust's immutable references)
// - `frozen_copy(val)` — deep-copy and freeze (like Rust's `Cow::into_owned`)
// - `safe_div(a, b)` — division returning Result (no panics)
// - `bounds_check(arr, idx)` — bounds check before indexing
// - `invariant(cond, msg)` — named invariant (like Rust's debug_assert)
// - `unreachable(msg)` — mark code paths as unreachable (like Rust's `unreachable!`)
// - `todo(msg)` — mark unimplemented code (like Rust's `todo!()`)

// --- Assertions ---

// assert(cond) or assert(cond, msg) — runtime assertion.
// Identical to the builtin assert() but wrapped for uniform import.
fn checked_assert(cond, msg) {
    if msg == nil { msg = "assertion failed"; }
    assert(cond, msg);
}

// expect(val, msg) — return val if non-nil, else throw error.
// Like Rust's `.expect("msg")`.
fn expect(val, msg) {
    if val == nil {
        return error("ExpectError: " + str(msg));
    }
    return val;
}

// non_null(val, name) — assert val is not nil. Returns val on success.
fn non_null(val, name) {
    if val == nil {
        return error("NullError: '" + str(name) + "' must not be nil");
    }
    return val;
}

// invariant(cond, msg) — named invariant check (stronger than assert for contracts).
fn invariant(cond, msg) {
    if cond == false {
        return error("InvariantViolation: " + str(msg));
    }
    return true;
}

// unreachable(msg) — marks a code path as unreachable (like Rust's unreachable!()).
fn unreachable(msg) {
    return error("UnreachableError: reached code marked as unreachable" + (msg != nil ? (": " + str(msg)) : ""));
}

// todo(msg) — marks unimplemented code (like Rust's todo!()).
fn todo(msg) {
    return error("NotImplementedError: " + str(msg));
}

// --- Type Safety ---

// check_type(val, expected) — assert val has the expected type. Returns val on success.
// Equivalent to builtin require_type() but with clearer semantics.
fn check_type(val, expected) {
    return require_type(val, expected);
}

// is_some(val) — true if val is not nil.
fn is_some(val) { return val != nil; }

// coerce_number(val) — convert val to number or error.
fn coerce_number(val, name) {
    if type(val) == "number" { return val; }
    let n = parse_number(str(val));
    if n == nil {
        return error("TypeError: cannot coerce '" + str(name) + "' to number (got " + type(val) + ")");
    }
    return n;
}

// coerce_string(val) — convert val to string (always succeeds).
fn coerce_string(val) { return str(val); }

// --- Bounds Safety ---

// bounds_check(arr, idx) — return val or nil if idx out of bounds (safe access).
fn bounds_check(arr, idx) {
    if type(arr) != "array" { return nil; }
    if idx < 0 or idx >= len(arr) { return nil; }
    return arr[idx];
}

// first_safe(arr) — return arr[0] or nil if empty.
fn first_safe(arr) {
    if type(arr) != "array" or len(arr) == 0 { return nil; }
    return arr[0];
}

// last_safe(arr) — return arr[len-1] or nil if empty.
fn last_safe(arr) {
    let n = len(arr);
    if type(arr) != "array" or n == 0 { return nil; }
    return arr[n - 1];
}

// --- Arithmetic Safety ---

// safe_div(a, b) — division returning Result map; no div-by-zero panic.
fn safe_div(a, b) {
    return checked_div(a, b);
}

// safe_add(a, b) — addition returning Result map.
fn safe_add(a, b) { return checked_add(a, b); }

// safe_mul(a, b) — multiplication returning Result map.
fn safe_mul(a, b) { return checked_mul(a, b); }

// clamp(val, lo, hi) — clamp a value to [lo, hi] range (no overflow possible).
fn clamp(val, lo, hi) {
    if val < lo { return lo; }
    if val > hi { return hi; }
    return val;
}

// --- Immutability ---

// freeze_obj(map_val) — mark a map as frozen (immutable via runtime freeze guard).
// Alias for the builtin freeze() for clarity.
fn freeze_obj(m) { return freeze(m); }

// frozen_copy(val) — deep-copy an array or map and freeze it.
fn frozen_copy(val) {
    import "stdlib:json.sapp";
    // Deep copy via JSON round-trip
    let copy_str = json.stringify(val);
    let copy = json.parse(copy_str);
    if type(copy) == "map" { return freeze(copy); }
    return copy;
}

// --- Concurrency Safety ---

// safe_send(channel_sender, val) — send only if channel is not closed.
fn safe_send(sender, val) {
    if channel_is_closed(sender) {
        return map{ ok: false, error: "channel is closed" };
    }
    send(sender, val);
    return map{ ok: true };
}

// safe_recv(channel_receiver) — recv returning Result (nil from closed channel = Err).
fn safe_recv(receiver) {
    let v = recv(receiver);
    if v == nil { return map{ ok: false, error: "channel closed or empty" }; }
    return map{ ok: true, value: v };
}

export checked_assert, expect, non_null, invariant, unreachable, todo,
       check_type, is_some, coerce_number, coerce_string,
       bounds_check, first_safe, last_safe,
       safe_div, safe_add, safe_mul, clamp,
       freeze_obj, frozen_copy,
       safe_send, safe_recv;
