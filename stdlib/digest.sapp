// Pure-PBLang binary digest algorithms used by integrity-sensitive products.
// All arithmetic is reduced to exact 32-bit words so interpreter and C99
// backends produce identical output.

let SHA256 = import("stdlib:sha256_pb.sapp");
let MASK = 4294967295;
let HEX = "0123456789abcdef";

fn _bytes(input) {
    if type(input) != "array" { throw "digest: expected a byte array"; }
    for i len(input) {
        if type(input[i]) != "number" or input[i] != num_floor(input[i])
            or input[i] < 0 or input[i] > 255 { throw "digest: invalid byte"; }
    }
    return input;
}

fn _u32(value) { return bit_and(value, MASK); }
fn _add(a, b) { return _u32(a + b); }
fn _rotl(value, amount) {
    let right = bit_shr(value, 32 - amount);
    let low_mask = bit_shr(MASK, amount);
    return _u32(bit_or(bit_shl(bit_and(value, low_mask), amount), right));
}
fn _rotr(value, amount) { return _rotl(value, 32 - amount); }
fn _hex_word_be(value) {
    let out = "";
    for i 8 {
        let shift = (7 - i) * 4; let nibble = bit_and(bit_shr(value, shift), 15);
        out = out + str_slice(HEX, nibble, nibble + 1);
    }
    return out;
}
fn _hex_byte(value) {
    return str_slice(HEX, bit_shr(value, 4), bit_shr(value, 4) + 1)
        + str_slice(HEX, bit_and(value, 15), bit_and(value, 15) + 1);
}
fn _word_le(bytes, offset) {
    return _u32(bytes[offset] + bit_shl(bytes[offset + 1], 8)
        + bit_shl(bytes[offset + 2], 16) + bit_shl(bytes[offset + 3], 24));
}
fn _word_be(bytes, offset) {
    return _u32(bit_shl(bytes[offset], 24) + bit_shl(bytes[offset + 1], 16)
        + bit_shl(bytes[offset + 2], 8) + bytes[offset + 3]);
}
fn _word_le_bytes(out, value) {
    for i 4 { array_push(out, bit_and(bit_shr(value, i * 8), 255)); }
}
fn _hex_bytes(bytes) { let out = ""; for i len(bytes) { out = out + _hex_byte(bytes[i]); } return out; }

fn sha1_hex_bytes(input) {
    let bytes = _bytes(input); let data = slice(bytes, 0, len(bytes));
    let bits = len(bytes) * 8; array_push(data, 128);
    while len(data) % 64 != 56 { array_push(data, 0); }
    let hi = num_floor(bits / 4294967296); let lo = bits % 4294967296;
    for shift in [24,16,8,0] { array_push(data, bit_and(bit_shr(hi, shift), 255)); }
    for shift in [24,16,8,0] { array_push(data, bit_and(bit_shr(lo, shift), 255)); }
    let h0=0x67452301; let h1=0xefcdab89; let h2=0x98badcfe; let h3=0x10325476; let h4=0xc3d2e1f0;
    let offset=0;
    while offset < len(data) {
        let w=[]; for i 16 { array_push(w, _word_be(data, offset + i * 4)); }
        let i=16; while i<80 { array_push(w, _rotl(bit_xor(bit_xor(w[i-3],w[i-8]),bit_xor(w[i-14],w[i-16])),1)); i=i+1; }
        let a=h0; let b=h1; let c=h2; let d=h3; let e=h4; i=0;
        while i<80 {
            let f=0; let k=0;
            if i<20 { f=bit_or(bit_and(b,c),bit_and(bit_xor(b,MASK),d)); k=0x5a827999; }
            elif i<40 { f=bit_xor(bit_xor(b,c),d); k=0x6ed9eba1; }
            elif i<60 { f=bit_or(bit_or(bit_and(b,c),bit_and(b,d)),bit_and(c,d)); k=0x8f1bbcdc; }
            else { f=bit_xor(bit_xor(b,c),d); k=0xca62c1d6; }
            let temp=_add(_add(_add(_add(_rotl(a,5),f),e),k),w[i]);
            e=d; d=c; c=_rotl(b,30); b=a; a=temp; i=i+1;
        }
        h0=_add(h0,a); h1=_add(h1,b); h2=_add(h2,c); h3=_add(h3,d); h4=_add(h4,e); offset=offset+64;
    }
    return _hex_word_be(h0)+_hex_word_be(h1)+_hex_word_be(h2)+_hex_word_be(h3)+_hex_word_be(h4);
}

let MD5_S=[7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
    5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
    4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
    6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21];
let MD5_K=[0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
    0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
    0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
    0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
    0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
    0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
    0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
    0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391];

fn md5_hex_bytes(input) {
    let bytes=_bytes(input); let data=slice(bytes,0,len(bytes)); let bits=len(bytes)*8;
    array_push(data,128); while len(data)%64!=56 { array_push(data,0); }
    let lo=bits%4294967296; let hi=num_floor(bits/4294967296);
    for i 4 { array_push(data,bit_and(bit_shr(lo,i*8),255)); }
    for i 4 { array_push(data,bit_and(bit_shr(hi,i*8),255)); }
    let a0=0x67452301; let b0=0xefcdab89; let c0=0x98badcfe; let d0=0x10325476; let offset=0;
    while offset<len(data) {
        let m=[]; for i 16 { array_push(m,_word_le(data,offset+i*4)); }
        let a=a0; let b=b0; let c=c0; let d=d0; let i=0;
        while i<64 {
            let f=0; let g=0;
            if i<16 { f=bit_or(bit_and(b,c),bit_and(bit_xor(b,MASK),d)); g=i; }
            elif i<32 { f=bit_or(bit_and(d,b),bit_and(bit_xor(d,MASK),c)); g=(5*i+1)%16; }
            elif i<48 { f=bit_xor(bit_xor(b,c),d); g=(3*i+5)%16; }
            else { f=bit_xor(c,bit_or(b,bit_xor(d,MASK))); g=(7*i)%16; }
            let next=d; d=c; c=b; b=_add(b,_rotl(_add(_add(_add(a,f),MD5_K[i]),m[g]),MD5_S[i])); a=next; i=i+1;
        }
        a0=_add(a0,a); b0=_add(b0,b); c0=_add(c0,c); d0=_add(d0,d); offset=offset+64;
    }
    let out=[]; _word_le_bytes(out,a0); _word_le_bytes(out,b0); _word_le_bytes(out,c0); _word_le_bytes(out,d0);
    return _hex_bytes(out);
}

let B3_IV=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
let B3_PERM=[2,6,3,10,7,0,4,13,1,11,12,5,9,14,15,8];

fn _b3_g(v,a,b,c,d,x,y) {
    v[a]=_add(_add(v[a],v[b]),x); v[d]=_rotr(bit_xor(v[d],v[a]),16);
    v[c]=_add(v[c],v[d]); v[b]=_rotr(bit_xor(v[b],v[c]),12);
    v[a]=_add(_add(v[a],v[b]),y); v[d]=_rotr(bit_xor(v[d],v[a]),8);
    v[c]=_add(v[c],v[d]); v[b]=_rotr(bit_xor(v[b],v[c]),7);
}
fn _b3_compress(cv, words, counter, block_len, flags) {
    let v=[]; for i 8 { array_push(v,cv[i]); } for i 4 { array_push(v,B3_IV[i]); }
    array_push(v,counter%4294967296); array_push(v,num_floor(counter/4294967296));
    array_push(v,block_len); array_push(v,flags); let m=slice(words,0,16); let round=0;
    while round<7 {
        _b3_g(v,0,4,8,12,m[0],m[1]); _b3_g(v,1,5,9,13,m[2],m[3]);
        _b3_g(v,2,6,10,14,m[4],m[5]); _b3_g(v,3,7,11,15,m[6],m[7]);
        _b3_g(v,0,5,10,15,m[8],m[9]); _b3_g(v,1,6,11,12,m[10],m[11]);
        _b3_g(v,2,7,8,13,m[12],m[13]); _b3_g(v,3,4,9,14,m[14],m[15]);
        if round<6 { let next=[]; for i 16 { array_push(next,m[B3_PERM[i]]); } m=next; }
        round=round+1;
    }
    let out=[]; for i 8 { array_push(out,_u32(bit_xor(v[i],v[i+8]))); }
    for i 8 { array_push(out,_u32(bit_xor(v[i+8],cv[i]))); } return out;
}
fn _b3_block(bytes,start,length) {
    let padded=[]; for i 64 { array_push(padded,if i<length { bytes[start+i] } else { 0 }); }
    let words=[]; for i 16 { array_push(words,_word_le(padded,i*4)); } return words;
}
fn _b3_output(cv,words,counter,length,flags) { return map{cv:cv,words:words,counter:counter,length:length,flags:flags}; }
fn _b3_cv(output) { return slice(_b3_compress(output.cv,output.words,output.counter,output.length,output.flags),0,8); }
fn _b3_chunk(bytes,start,length,index) {
    let cv=slice(B3_IV,0,8); let consumed=0; let block=0;
    while length-consumed>64 {
        let flags=if block==0 { 1 } else { 0 };
        cv=slice(_b3_compress(cv,_b3_block(bytes,start+consumed,64),index,64,flags),0,8);
        consumed=consumed+64; block=block+1;
    }
    let flags=2+(if block==0 {1}else{0});
    return _b3_output(cv,_b3_block(bytes,start+consumed,length-consumed),index,length-consumed,flags);
}
fn _b3_parent(left,right) {
    let words=[]; for i 8 { array_push(words,left[i]); } for i 8 { array_push(words,right[i]); }
    return _b3_output(slice(B3_IV,0,8),words,0,64,4);
}
fn blake3_hex_bytes(input) {
    let bytes=_bytes(input); let chunks=[]; let count=if len(bytes)==0 {1}else{num_floor((len(bytes)+1023)/1024)};
    let index=0;
    while index+1<count {
        let cv=_b3_cv(_b3_chunk(bytes,index*1024,1024,index)); let total=index+1;
        while total%2==0 { let left=array_pop(chunks); cv=_b3_cv(_b3_parent(left,cv)); total=num_floor(total/2); }
        array_push(chunks,cv); index=index+1;
    }
    let last_start=(count-1)*1024; let last_len=len(bytes)-last_start;
    let output=_b3_chunk(bytes,last_start,last_len,count-1);
    while len(chunks)>0 { output=_b3_parent(array_pop(chunks),_b3_cv(output)); }
    let words=_b3_compress(output.cv,output.words,0,output.length,bit_or(output.flags,8));
    let out=[]; for i 8 { _word_le_bytes(out,words[i]); } return _hex_bytes(out);
}

fn hash_hex_bytes(algorithm, bytes) {
    let name=str_lower(str(algorithm));
    if name=="sha256" { return SHA256.sha256_hex_bytes(_bytes(bytes)); }
    if name=="sha1" { return sha1_hex_bytes(bytes); }
    if name=="md5" { return md5_hex_bytes(bytes); }
    if name=="blake3" { return blake3_hex_bytes(bytes); }
    throw "digest: unsupported algorithm";
}

export sha1_hex_bytes, md5_hex_bytes, blake3_hex_bytes, hash_hex_bytes;
