// stdlib/ip_rights_provenance.sapp — Sovereign Intellectual Property, Attribution,
// Licensing & Multi-Binary Provenance Engine for PBLang v4.0.0.
//
// 100% Pure PBLang (Zero C, Zero Python, Zero external tools).
// Creator & Principal Architect: Panagiotis (Panos) Biazis (@PanosBiazis)
// Official Repository: https://github.com/PanosBiazis/pblang
// Engine License: Apache-2.0
//
// Capabilities:
//   1. Canonical PBLang v4.0.0 Engine Attribution (`PBLANG_ENGINE_ATTRIBUTION`, `engine_ip_manifest()`)
//   2. Secure-by-Default Developer IP Policy Builder (`build_ip_policy`, `parse_toml_ip_section`,
//      `generate_license_text`) supporting 4 developer modes:
//        - "proprietary" (DEFAULT: All Rights Reserved, zero OS/path leakage)
//        - "free" / "open-source" (MIT, Apache-2.0, GPL-3.0-only, GPL-3.0-or-later,
//          LGPL-3.0-only, BSD-3-Clause, BSD-2-Clause, MPL-2.0, ISC, CC0-1.0, Unlicense)
//        - "free-attribution" (free to use/share, mandatory credit, anti-misappropriation)
//        - "stealth-private" (redacted identity, SOURCE_DATE_EPOCH = 0, cryptographic proof)
//   3. Built-In Privacy & Secret Leak Firewall (`scrub_and_audit_ip_metadata`)
//   4. Cryptographic Authorship Proof (Pure-PBLang FIPS 180-4 SHA-256 + RFC 2104 HMAC-SHA256 +
//      Zero-Knowledge Owner Commitment) & Multi-Binary Structural Sealing across:
//      ELF64/ELF32 (+ PBLZREXE), PE32+/PE32, W3C WebAssembly (Custom Section 0x00 ULEB128),
//      Mach-O, DEX, PBCK, 8/16-bit ROM (DOS16/CPM80/C64/AVR8), HTML5, and SVG.

let _SHA256 = import("stdlib:sha256_pb.sapp");
let _JSON = import("stdlib:json.sapp");

let DETERMINISTIC_EPOCH = 0;
let DETERMINISTIC_TIMESTAMP = "1970-01-01T00:00:00Z";
let WASM_CUSTOM_SECTION_NAME = "pblang.ip";
let SEAL_MAGIC_HEADER = "PBIPSEAL";
let SEAL_MAGIC_FOOTER = "PBIPEOF!";
let BUNDLE_EXE_MAGIC = "PBLZREXE";

let PBLANG_ENGINE_ATTRIBUTION = map{
    engine: "PBLang Sovereign Runtime & Compiler",
    engine_version: "5.0.0",
    creator: "Panagiotis (Panos) Biazis (@PanosBiazis)",
    repository: "https://github.com/PanosBiazis/pblang",
    engine_license: "Apache-2.0",
    attribution_required: true
};

let SUPPORTED_IP_MODES = [
    "proprietary",
    "free",
    "open-source",
    "free-attribution",
    "stealth-private"
];

let SUPPORTED_SPDX_LICENSES = [
    "MIT",
    "Apache-2.0",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "LGPL-3.0-only",
    "BSD-3-Clause",
    "BSD-2-Clause",
    "MPL-2.0",
    "ISC",
    "CC0-1.0",
    "Unlicense"
];

fn _err(msg) {
    throw "ip_rights_provenance: " + msg;
}

fn engine_ip_manifest() {
    return map{
        engine: PBLANG_ENGINE_ATTRIBUTION.engine,
        engine_version: PBLANG_ENGINE_ATTRIBUTION.engine_version,
        creator: PBLANG_ENGINE_ATTRIBUTION.creator,
        repository: PBLANG_ENGINE_ATTRIBUTION.repository,
        engine_license: PBLANG_ENGINE_ATTRIBUTION.engine_license,
        attribution_required: PBLANG_ENGINE_ATTRIBUTION.attribution_required
    };
}

// ── Byte, Hex, Constant-Time & Canonical JSON Helpers ─────────────────────────

fn _as_bytes(val) {
    if type(val) == "string" { return str_to_bytes(val); }
    if is_array(val) {
        let i = 0;
        while i < len(val) {
            let b = val[i];
            if type(b) != "number" or num_floor(b) != b or b < 0 or b > 255 {
                _err("invalid byte at index " + str(i));
            }
            i = i + 1;
        }
        return val;
    }
    _err("expected byte array or string");
    return [];
}

fn _clone_bytes(src) {
    let out = [];
    let i = 0;
    while i < len(src) {
        array_push(out, src[i]);
        i = i + 1;
    }
    return out;
}

fn _append_bytes(dst, extra) {
    let i = 0;
    while i < len(extra) {
        array_push(dst, extra[i]);
        i = i + 1;
    }
    return dst;
}

fn _concat_bytes(a, b) {
    let out = _clone_bytes(a);
    return _append_bytes(out, b);
}

fn _bytes_eq_slice(buf, offset, pat) {
    if offset < 0 or offset + len(pat) > len(buf) { return false; }
    let i = 0;
    while i < len(pat) {
        if buf[offset + i] != pat[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn _bytes_index_of(haystack, needle, start_pos) {
    if len(needle) == 0 { return start_pos; }
    if start_pos < 0 { start_pos = 0; }
    let limit = len(haystack) - len(needle);
    let idx = start_pos;
    while idx <= limit {
        if _bytes_eq_slice(haystack, idx, needle) { return idx; }
        idx = idx + 1;
    }
    return -1;
}

fn _ct_eq_str(a, b) {
    if type(a) != "string" or type(b) != "string" { return false; }
    let ba = str_to_bytes(a);
    let bb = str_to_bytes(b);
    if len(ba) != len(bb) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(ba) {
        diff = bit_or(diff, bit_xor(ba[i], bb[i]));
        i = i + 1;
    }
    return diff == 0;
}

fn _ct_eq_bytes(a, b) {
    if not is_array(a) or not is_array(b) { return false; }
    if len(a) != len(b) { return false; }
    let diff = 0;
    let i = 0;
    while i < len(a) {
        diff = bit_or(diff, bit_xor(a[i], b[i]));
        i = i + 1;
    }
    return diff == 0;
}

fn _hex_nibble(code) {
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 97 and code <= 102 { return code - 87; }
    if code >= 65 and code <= 70 { return code - 55; }
    return -1;
}

fn _hex_to_bytes(hex_str) {
    let out = [];
    let i = 0;
    while i + 1 < len(hex_str) {
        let hi = _hex_nibble(strcharcodeat(hex_str, i));
        let lo = _hex_nibble(strcharcodeat(hex_str, i + 1));
        if hi < 0 or lo < 0 { _err("invalid hex digest"); }
        array_push(out, hi * 16 + lo);
        i = i + 2;
    }
    return out;
}

// Pure-PBLang RFC 2104 HMAC-SHA256 over raw byte arrays or strings (zero C dependency).
fn hmac_sha256_bytes(msg_in, key_in) {
    let msg_bytes = _as_bytes(msg_in);
    let raw_key = _as_bytes(key_in);
    let key_block = [];
    if len(raw_key) > 64 {
        key_block = _hex_to_bytes(_SHA256.sha256_hex_bytes(raw_key));
    } else {
        key_block = _clone_bytes(raw_key);
    }
    while len(key_block) < 64 {
        array_push(key_block, 0);
    }
    let ipad = [];
    let opad = [];
    let i = 0;
    while i < 64 {
        array_push(ipad, bit_xor(key_block[i], 54));
        array_push(opad, bit_xor(key_block[i], 92));
        i = i + 1;
    }
    let inner_ctx = _SHA256.new();
    _SHA256.update(inner_ctx, ipad);
    _SHA256.update(inner_ctx, msg_bytes);
    let inner_hex = _SHA256.finish(inner_ctx);
    let inner_digest = _hex_to_bytes(inner_hex);

    let outer_ctx = _SHA256.new();
    _SHA256.update(outer_ctx, opad);
    _SHA256.update(outer_ctx, inner_digest);
    return _SHA256.finish(outer_ctx);
}

fn hmac_sha256_hex(msg, key) {
    return hmac_sha256_bytes(msg, key);
}

fn _sort_strings(items) {
    let arr = [];
    let i = 0;
    while i < len(items) {
        array_push(arr, items[i]);
        i = i + 1;
    }
    let n = len(arr);
    let a = 1;
    while a < n {
        let cur = arr[a];
        let b = a - 1;
        while b >= 0 and arr[b] > cur {
            arr[b + 1] = arr[b];
            b = b - 1;
        }
        arr[b + 1] = cur;
        a = a + 1;
    }
    return arr;
}

fn _json_escape_str(s) {
    let out = "\"";
    let i = 0;
    while i < len(s) {
        let code = strcharcodeat(s, i);
        let ch = str_slice(s, i, i + 1);
        if ch == "\"" { out = out + "\\\""; }
        elif ch == "\\" { out = out + "\\\\"; }
        elif code == 10 { out = out + "\\n"; }
        elif code == 13 { out = out + "\\r"; }
        elif code == 9 { out = out + "\\t"; }
        elif ch == ">" and i > 0 and str_slice(s, i - 1, i) == "-" {
            // Prevent "--" + ">" inside HTML/SVG comments from closing comment blocks early
            out = out + "\\u003e";
        }
        elif code < 32 {
            let hex = "0123456789abcdef";
            let hi = num_floor(code / 16);
            let lo = code % 16;
            out = out + "\\u00" + str_slice(hex, hi, hi + 1) + str_slice(hex, lo, lo + 1);
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out + "\"";
}

fn _canonical_json(val) {
    let kind = type(val);
    if val == nil { return "null"; }
    if kind == "bool" or kind == "boolean" {
        if val { return "true"; }
        return "false";
    }
    if kind == "number" {
        if num_floor(val) == val and val >= -9007199254740991 and val <= 9007199254740991 {
            // Render exact integer without trailing ".0"
            let raw_num = str(val);
            if str_ends_with(raw_num, ".0") {
                return str_slice(raw_num, 0, len(raw_num) - 2);
            }
            return raw_num;
        }
        return json_stringify(val);
    }
    if kind == "string" {
        return _json_escape_str(val);
    }
    if is_array(val) {
        let parts = [];
        let i = 0;
        while i < len(val) {
            array_push(parts, _canonical_json(val[i]));
            i = i + 1;
        }
        return "[" + _join_strs(parts, ",") + "]";
    }
    if is_map(val) {
        let keys = _sort_strings(map_keys(val));
        let kv_parts = [];
        let k = 0;
        while k < len(keys) {
            let key = keys[k];
            array_push(kv_parts, _json_escape_str(key) + ":" + _canonical_json(val[key]));
            k = k + 1;
        }
        return "{" + _join_strs(kv_parts, ",") + "}";
    }
    return _json_escape_str(str(val));
}

fn _join_strs(arr, sep) {
    let out = "";
    let i = 0;
    while i < len(arr) {
        if i > 0 { out = out + sep; }
        out = out + arr[i];
        i = i + 1;
    }
    return out;
}

fn _str_replace_all(s, pat, rep) {
    if len(pat) == 0 { return s; }
    return _join_strs(str_split(s, pat), rep);
}

// ── Privacy & Secret Leak Firewall ────────────────────────────────────────────

fn _unix_leak_prefixes() {
    let slash = "/";
    return [
        slash + "home" + slash,
        slash + "Users" + slash,
        slash + "media" + slash,
        slash + "mnt" + slash,
        slash + "root" + slash,
        slash + "private" + slash + "var" + slash
    ];
}

fn _win_leak_prefixes() {
    let bs = "\\";
    return [
        "C:" + bs + "Users",
        "c:" + bs + "users",
        "C:" + bs + "exe",
        "c:" + bs + "exe",
        "D:" + bs + "Users"
    ];
}

fn _secret_token_prefixes() {
    let gh = "gh";
    return [
        "sk" + "-",
        gh + "p_",
        gh + "o_",
        gh + "s_",
        gh + "u_",
        "github" + "_pat_",
        "AK" + "IA",
        "AI" + "za",
        "xoxb" + "-",
        "xoxp" + "-"
    ];
}

fn _has_windows_drive_path(tok) {
    let idx = 0;
    while idx + 2 < len(tok) {
        let c0 = strcharcodeat(tok, idx);
        let c1 = strcharcodeat(tok, idx + 1);
        let c2 = strcharcodeat(tok, idx + 2);
        let is_alpha = (c0 >= 65 and c0 <= 90) or (c0 >= 97 and c0 <= 122);
        if is_alpha and c1 == 58 and c2 == 92 {
            if idx == 0 { return true; }
            let prev = strcharcodeat(tok, idx - 1);
            if prev == 61 or prev == 34 or prev == 39 or prev == 47 { return true; }
        }
        idx = idx + 1;
    }
    return false;
}

fn _parse_octet(part) {
    if len(part) == 0 or len(part) > 3 { return -1; }
    let val = 0;
    let i = 0;
    while i < len(part) {
        let c = strcharcodeat(part, i);
        if c < 48 or c > 57 { return -1; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    if val > 255 { return -1; }
    return val;
}

fn _strip_punct_edges(tok) {
    let s = 0;
    let e = len(tok);
    while s < e {
        let c = strcharcodeat(tok, s);
        if c == 40 or c == 91 or c == 123 or c == 60 or c == 34 or c == 39 { s = s + 1; }
        else { break; }
    }
    while e > s {
        let c2 = strcharcodeat(tok, e - 1);
        if c2 == 41 or c2 == 93 or c2 == 125 or c2 == 62 or c2 == 44 or c2 == 46 or c2 == 59 or c2 == 58 or c2 == 34 or c2 == 39 {
            e = e - 1;
        } else { break; }
    }
    return map{ core: str_slice(tok, s, e), prefix: str_slice(tok, 0, s), suffix: str_slice(tok, e, len(tok)) };
}

fn _is_private_ipv4(core) {
    // Strip optional ":port" suffix
    let host = core;
    let colon_parts = str_split(core, ":");
    if len(colon_parts) == 2 { host = colon_parts[0]; }
    let parts = str_split(host, ".");
    if len(parts) != 4 { return false; }
    let o0 = _parse_octet(parts[0]);
    let o1 = _parse_octet(parts[1]);
    let o2 = _parse_octet(parts[2]);
    let o3 = _parse_octet(parts[3]);
    if o0 < 0 or o1 < 0 or o2 < 0 or o3 < 0 { return false; }
    if o0 == 10 { return true; }
    if o0 == 127 { return true; }
    if o0 == 192 and o1 == 168 { return true; }
    if o0 == 172 and o1 >= 16 and o1 <= 31 { return true; }
    if o0 == 169 and o1 == 254 { return true; }
    return false;
}

fn _is_email_token(core) {
    if not str_contains(core, "@") { return false; }
    if str_starts_with(core, "@") { return false; } // @GitHubHandle is public handle, not email
    if str_starts_with(core, "http://") or str_starts_with(core, "https://") { return false; }
    let parts = str_split(core, "@");
    if len(parts) != 2 { return false; }
    let local_part = parts[0];
    let domain_part = parts[1];
    if len(local_part) == 0 or len(domain_part) < 4 { return false; }
    if not str_contains(domain_part, ".") { return false; }
    if str_starts_with(domain_part, ".") or str_ends_with(domain_part, ".") { return false; }
    return true;
}

fn _is_token_delim(code) {
    // whitespace, quotes, angle brackets, parens, comma, semicolon
    return code == 32 or code == 9 or code == 10 or code == 13
        or code == 34 or code == 39 or code == 60 or code == 62
        or code == 40 or code == 41 or code == 44 or code == 59;
}

fn _add_unique_str(arr, item) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == item { return 0; }
        i = i + 1;
    }
    array_push(arr, item);
    return 1;
}

fn _classify_token_leak(tok, allow_public_contact) {
    let trimmed = _strip_punct_edges(tok);
    let core = trimmed.core;
    if len(core) == 0 { return nil; }

    let unix_p = _unix_leak_prefixes();
    let u = 0;
    while u < len(unix_p) {
        if str_contains(core, unix_p[u]) {
            return map{ category: "local_unix_path", replacement: trimmed.prefix + "[REDACTED-PATH]" + trimmed.suffix };
        }
        u = u + 1;
    }

    let win_p = _win_leak_prefixes();
    let w = 0;
    while w < len(win_p) {
        if str_contains(core, win_p[w]) {
            return map{ category: "local_windows_path", replacement: trimmed.prefix + "[REDACTED-PATH]" + trimmed.suffix };
        }
        w = w + 1;
    }
    if _has_windows_drive_path(core) {
        return map{ category: "local_windows_path", replacement: trimmed.prefix + "[REDACTED-PATH]" + trimmed.suffix };
    }

    let sec_p = _secret_token_prefixes();
    let s = 0;
    while s < len(sec_p) {
        let pref = sec_p[s];
        if str_starts_with(core, pref) and len(core) > len(pref) + 2 {
            return map{ category: "secret_api_token", replacement: trimmed.prefix + "[REDACTED-SECRET]" + trimmed.suffix };
        }
        if str_contains(core, "=" + pref) or str_contains(core, ":" + pref) {
            return map{ category: "secret_api_token", replacement: trimmed.prefix + "[REDACTED-SECRET]" + trimmed.suffix };
        }
        s = s + 1;
    }

    if _is_private_ipv4(core) {
        return map{ category: "private_ip_address", replacement: trimmed.prefix + "[REDACTED-IP]" + trimmed.suffix };
    }

    if not allow_public_contact and _is_email_token(core) {
        return map{ category: "email_address", replacement: trimmed.prefix + "[REDACTED-EMAIL]" + trimmed.suffix };
    }

    return nil;
}

fn _scrub_text_internal(text, allow_public_contact, findings, counter_box) {
    if type(text) != "string" or len(text) == 0 { return text; }
    let out = "";
    let n = len(text);
    let i = 0;
    while i < n {
        let c = strcharcodeat(text, i);
        if _is_token_delim(c) {
            out = out + str_slice(text, i, i + 1);
            i = i + 1;
        } else {
            let start_idx = i;
            while i < n and not _is_token_delim(strcharcodeat(text, i)) {
                i = i + 1;
            }
            let tok = str_slice(text, start_idx, i);
            let leak = _classify_token_leak(tok, allow_public_contact);
            if leak != nil {
                out = out + leak.replacement;
                _add_unique_str(findings, leak.category);
                counter_box.count = counter_box.count + 1;
            } else {
                out = out + tok;
            }
        }
    }
    return out;
}

fn _scrub_value_recursive(val, allow_public_contact, findings, counter_box) {
    if type(val) == "string" {
        return _scrub_text_internal(val, allow_public_contact, findings, counter_box);
    }
    if is_array(val) {
        let out_arr = [];
        let i = 0;
        while i < len(val) {
            array_push(out_arr, _scrub_value_recursive(val[i], allow_public_contact, findings, counter_box));
            i = i + 1;
        }
        return out_arr;
    }
    if is_map(val) {
        let out_map = map{};
        let keys = map_keys(val);
        let k = 0;
        while k < len(keys) {
            let key = keys[k];
            if key == "engine_attribution" {
                out_map[key] = engine_ip_manifest();
            } else {
                out_map[key] = _scrub_value_recursive(val[key], allow_public_contact, findings, counter_box);
            }
            k = k + 1;
        }
        return out_map;
    }
    return val;
}

// Scans strings or IP policy maps before embedding into any executable.
// Scrubs local Unix/macOS/Windows user directories, mounted media paths,
// cloud/VCS API secret tokens, private RFC-1918 IPv4 addresses, and emails
// (unless allow_public_contact == true), and enforces SOURCE_DATE_EPOCH = 0.
fn scrub_and_audit_ip_metadata(policy_or_str) {
    let findings = [];
    let counter_box = map{ count: 0 };

    if type(policy_or_str) == "string" {
        let scrubbed_s = _scrub_text_internal(policy_or_str, false, findings, counter_box);
        return map{
            ok: counter_box.count == 0,
            clean: counter_box.count == 0,
            blocked: counter_box.count > 0,
            scrubbed_count: counter_box.count,
            findings: findings,
            scrubbed_text: scrubbed_s,
            value: scrubbed_s,
            deterministic_timestamp: DETERMINISTIC_TIMESTAMP,
            source_date_epoch: DETERMINISTIC_EPOCH
        };
    }

    if is_map(policy_or_str) {
        let allow_contact = (try policy_or_str.allow_public_contact catch false) == true;
        let scrubbed_pol = _scrub_value_recursive(policy_or_str, allow_contact, findings, counter_box);
        scrubbed_pol["deterministic_timestamp"] = DETERMINISTIC_TIMESTAMP;
        scrubbed_pol["deterministic_epoch"] = DETERMINISTIC_EPOCH;
        scrubbed_pol["source_date_epoch"] = DETERMINISTIC_EPOCH;
        if (try policy_or_str.reject_on_leak catch false) == true and counter_box.count > 0 {
            _err("privacy firewall rejected metadata leaks: " + _join_strs(findings, ", "));
        }
        return map{
            ok: counter_box.count == 0,
            clean: counter_box.count == 0,
            blocked: counter_box.count > 0,
            scrubbed_count: counter_box.count,
            findings: findings,
            scrubbed_policy: scrubbed_pol,
            scrubbed_text: _canonical_json(scrubbed_pol),
            value: scrubbed_pol,
            deterministic_timestamp: DETERMINISTIC_TIMESTAMP,
            source_date_epoch: DETERMINISTIC_EPOCH
        };
    }

    _err("scrub_and_audit_ip_metadata expects a string or policy map");
    return nil;
}

// ── SPDX License Notice & Full Text Generator ────────────────────────────────

fn _normalize_spdx(raw_id) {
    if type(raw_id) != "string" { return ""; }
    let trimmed = str_trim(raw_id);
    let low = str_lower(trimmed);
    if low == "mit" { return "MIT"; }
    if low == "apache-2.0" or low == "apache2" or low == "apache 2.0" { return "Apache-2.0"; }
    if low == "gpl-3.0-only" or low == "gpl-3.0" or low == "gplv3" { return "GPL-3.0-only"; }
    if low == "gpl-3.0-or-later" or low == "gplv3+" { return "GPL-3.0-or-later"; }
    if low == "lgpl-3.0-only" or low == "lgpl-3.0" or low == "lgplv3" { return "LGPL-3.0-only"; }
    if low == "bsd-3-clause" or low == "bsd3" { return "BSD-3-Clause"; }
    if low == "bsd-2-clause" or low == "bsd2" { return "BSD-2-Clause"; }
    if low == "mpl-2.0" or low == "mpl2" { return "MPL-2.0"; }
    if low == "isc" { return "ISC"; }
    if low == "cc0-1.0" or low == "cc0" { return "CC0-1.0"; }
    if low == "unlicense" { return "Unlicense"; }
    if low == "licenseref-proprietary" or low == "proprietary" { return "LicenseRef-Proprietary"; }
    if low == "licenseref-free-attribution" or low == "free-attribution" { return "LicenseRef-Free-Attribution"; }
    if low == "licenseref-stealth-private" or low == "stealth-private" { return "LicenseRef-Stealth-Private"; }
    return trimmed;
}

fn _is_supported_free_spdx(spdx_id) {
    let i = 0;
    while i < len(SUPPORTED_SPDX_LICENSES) {
        if SUPPORTED_SPDX_LICENSES[i] == spdx_id { return true; }
        i = i + 1;
    }
    return false;
}

fn generate_license_text(spdx_id, holder = "Program Author", year = "2026") {
    let norm = _normalize_spdx(spdx_id);
    let safe_holder = scrub_and_audit_ip_metadata(str(holder)).scrubbed_text;
    let safe_year = scrub_and_audit_ip_metadata(str(year)).scrubbed_text;
    if len(str_trim(safe_holder)) == 0 { safe_holder = "Program Author"; }
    if len(str_trim(safe_year)) == 0 { safe_year = "2026"; }

    if norm == "MIT" {
        return "SPDX-License-Identifier: MIT\n"
            + "MIT License\n\n"
            + "Copyright (c) " + safe_year + " " + safe_holder + "\n\n"
            + "Permission is hereby granted, free of charge, to any person obtaining a copy "
            + "of this software and associated documentation files (the \"Software\"), to deal "
            + "in the Software without restriction, including without limitation the rights "
            + "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell "
            + "copies of the Software, and to permit persons to whom the Software is "
            + "furnished to do so, subject to the following conditions:\n\n"
            + "The above copyright notice and this permission notice shall be included in all "
            + "copies or substantial portions of the Software.\n\n"
            + "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR "
            + "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, "
            + "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.";
    }
    if norm == "Apache-2.0" {
        return "SPDX-License-Identifier: Apache-2.0\n"
            + "Copyright " + safe_year + " " + safe_holder + "\n\n"
            + "Licensed under the Apache License, Version 2.0 (the \"License\"); "
            + "you may not use this software except in compliance with the License. "
            + "You may obtain a copy of the License at\n\n"
            + "    http://www.apache.org/licenses/LICENSE-2.0\n\n"
            + "Unless required by applicable law or agreed to in writing, software "
            + "distributed under the License is distributed on an \"AS IS\" BASIS, "
            + "WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. "
            + "See the License for the specific language governing permissions and "
            + "limitations under the License.";
    }
    if norm == "GPL-3.0-only" {
        return "SPDX-License-Identifier: GPL-3.0-only\n"
            + "Copyright (C) " + safe_year + " " + safe_holder + "\n\n"
            + "This program is free software: you can redistribute it and/or modify "
            + "it under the terms of the GNU General Public License version 3 only as "
            + "published by the Free Software Foundation.\n\n"
            + "This program is distributed in the hope that it will be useful, "
            + "but WITHOUT ANY WARRANTY; without even the implied warranty of "
            + "MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the "
            + "GNU General Public License v3.0 (https://www.gnu.org/licenses/gpl-3.0.html) for more details.";
    }
    if norm == "GPL-3.0-or-later" {
        return "SPDX-License-Identifier: GPL-3.0-or-later\n"
            + "Copyright (C) " + safe_year + " " + safe_holder + "\n\n"
            + "This program is free software: you can redistribute it and/or modify "
            + "it under the terms of the GNU General Public License as published by "
            + "the Free Software Foundation, either version 3 of the License, or "
            + "(at your option) any later version (<https://www.gnu.org/licenses/>).";
    }
    if norm == "LGPL-3.0-only" {
        return "SPDX-License-Identifier: LGPL-3.0-only\n"
            + "Copyright (C) " + safe_year + " " + safe_holder + "\n\n"
            + "This library is free software; you can redistribute it and/or modify it "
            + "under the terms of the GNU Lesser General Public License version 3 only as "
            + "published by the Free Software Foundation (<https://www.gnu.org/licenses/lgpl-3.0.html>).";
    }
    if norm == "BSD-3-Clause" {
        return "SPDX-License-Identifier: BSD-3-Clause\n"
            + "Copyright (c) " + safe_year + ", " + safe_holder + ". All rights reserved.\n\n"
            + "Redistribution and use in source and binary forms, with or without modification, "
            + "are permitted provided that: (1) source redistributions retain this copyright notice, "
            + "(2) binary redistributions reproduce this notice in documentation/materials, and "
            + "(3) neither the name of the copyright holder nor contributors may be used to endorse "
            + "or promote derived products without specific prior written permission.";
    }
    if norm == "BSD-2-Clause" {
        return "SPDX-License-Identifier: BSD-2-Clause\n"
            + "Copyright (c) " + safe_year + ", " + safe_holder + ". All rights reserved.\n\n"
            + "Redistribution and use in source and binary forms, with or without modification, "
            + "are permitted provided that source and binary redistributions retain the above "
            + "copyright notice, this list of conditions, and the standard BSD disclaimer.";
    }
    if norm == "MPL-2.0" {
        return "SPDX-License-Identifier: MPL-2.0\n"
            + "Copyright (c) " + safe_year + " " + safe_holder + "\n\n"
            + "This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0. "
            + "If a copy of the MPL was not distributed with this file, You can obtain one at "
            + "https://mozilla.org/MPL/2.0/.";
    }
    if norm == "ISC" {
        return "SPDX-License-Identifier: ISC\n"
            + "Copyright (c) " + safe_year + " " + safe_holder + "\n\n"
            + "Permission to use, copy, modify, and/or distribute this software for any purpose "
            + "with or without fee is hereby granted, provided that the above copyright notice "
            + "and this permission notice appear in all copies.";
    }
    if norm == "CC0-1.0" {
        return "SPDX-License-Identifier: CC0-1.0\n"
            + "Statement of Purpose (" + safe_year + ", " + safe_holder + "): "
            + "To the extent possible under law, the author has waived all copyright and related "
            + "or neighboring rights to this work under Creative Commons Zero v1.0 Universal "
            + "(https://creativecommons.org/publicdomain/zero/1.0/).";
    }
    if norm == "Unlicense" {
        return "SPDX-License-Identifier: Unlicense\n"
            + "This is free and unencumbered software released into the public domain (" + safe_year + "). "
            + "Anyone is free to copy, modify, publish, use, compile, sell, or distribute this "
            + "software, either in source code form or as a compiled binary, for any purpose "
            + "(https://unlicense.org/).";
    }
    if norm == "LicenseRef-Free-Attribution" {
        return "SPDX-License-Identifier: LicenseRef-Free-Attribution\n"
            + "Copyright (c) " + safe_year + " " + safe_holder + ".\n"
            + "Permission is granted free of charge to use and share this software provided that "
            + "prominent author attribution to " + safe_holder + " is retained intact and ownership "
            + "is never misrepresented or misappropriated.";
    }
    if norm == "LicenseRef-Stealth-Private" {
        return "SPDX-License-Identifier: LicenseRef-Stealth-Private\n"
            + "Rights Reserved. Author identity intentionally redacted for deployment privacy.";
    }
    if norm == "LicenseRef-Proprietary" {
        return "SPDX-License-Identifier: LicenseRef-Proprietary\n"
            + "Copyright (c) " + safe_year + " " + safe_holder + ". All Rights Reserved.\n"
            + "Unauthorized copying, reverse-engineering, modification, or redistribution of this "
            + "software, via any medium, is strictly prohibited without prior written permission.";
    }
    _err("unsupported SPDX license identifier: " + str(spdx_id));
    return "";
}

// ── Developer Choice & Secure-by-Default IP Policy Builder ────────────────────

fn _opt_str(opts, k1, k2, fallback) {
    if opts != nil and is_map(opts) {
        if map_has(opts, k1) and opts[k1] != nil and len(str_trim(str(opts[k1]))) > 0 {
            return str_trim(str(opts[k1]));
        }
        if k2 != "" and map_has(opts, k2) and opts[k2] != nil and len(str_trim(str(opts[k2]))) > 0 {
            return str_trim(str(opts[k2]));
        }
    }
    return fallback;
}

fn _opt_bool(opts, k1, k2, fallback) {
    if opts != nil and is_map(opts) {
        if map_has(opts, k1) and type(opts[k1]) == "bool" { return opts[k1]; }
        if map_has(opts, k1) and type(opts[k1]) == "boolean" { return opts[k1]; }
        if k2 != "" and map_has(opts, k2) and (type(opts[k2]) == "bool" or type(opts[k2]) == "boolean") {
            return opts[k2];
        }
    }
    return fallback;
}

// Secure-by-default IP policy builder.
// NEVER reads $USER, $HOME, hostname, or local wall-clock time.
fn build_ip_policy(opts = nil) {
    if opts != nil and not is_map(opts) {
        _err("build_ip_policy expects nil or options map");
    }
    let raw_mode = str_lower(_opt_str(opts, "mode", "ip_mode", "proprietary"));
    let holder = _opt_str(opts, "holder", "copyright_holder", "Program Author");
    let year = _opt_str(opts, "year", "copyright_year", "2026");
    let artifact_name = _opt_str(opts, "artifact_name", "app_name", "");
    let public_url = _opt_str(opts, "url", "repository", "");
    let public_contact = _opt_str(opts, "contact", "public_contact", "");
    let allow_public_contact = _opt_bool(opts, "allow_public_contact", "", false);
    let reject_on_leak = _opt_bool(opts, "reject_on_leak", "", false);

    let mode = raw_mode;
    let rights_statement = "";
    let free_redistribution = false;
    let attribution_required = true;
    let derivatives_allowed = false;
    let spdx_license = "LicenseRef-Proprietary";
    let copyright_notice = "";
    let license_text = "";

    if mode == "proprietary" or mode == "default" {
        mode = "proprietary";
        rights_statement = "All Rights Reserved";
        free_redistribution = false;
        attribution_required = true;
        derivatives_allowed = false;
        spdx_license = "LicenseRef-Proprietary";
        copyright_notice = "Copyright (c) " + year + " " + holder + ". All Rights Reserved.";
        license_text = generate_license_text(spdx_license, holder, year);
    } elif mode == "free" or mode == "open-source" or mode == "opensource" {
        if mode == "opensource" { mode = "open-source"; }
        let req_spdx = _normalize_spdx(_opt_str(opts, "license", "spdx_license", "MIT"));
        if not _is_supported_free_spdx(req_spdx) {
            _err("unsupported free/open-source SPDX license: " + req_spdx);
        }
        spdx_license = req_spdx;
        free_redistribution = true;
        derivatives_allowed = true;
        attribution_required = not (spdx_license == "CC0-1.0" or spdx_license == "Unlicense");
        rights_statement = "Free and Open-Source Software (" + spdx_license + ")";
        copyright_notice = "Copyright (c) " + year + " " + holder + " (SPDX: " + spdx_license + ")";
        license_text = generate_license_text(spdx_license, holder, year);
    } elif mode == "free-attribution" {
        free_redistribution = true;
        attribution_required = true;
        derivatives_allowed = _opt_bool(opts, "derivatives", "derivatives_allowed", false);
        spdx_license = "LicenseRef-Free-Attribution";
        if derivatives_allowed {
            rights_statement = "Free to Use, Share & Adapt with Mandatory Author Attribution";
        } else {
            rights_statement = "Free to Use & Share Verbatim with Mandatory Author Attribution (No Ownership Misappropriation)";
        }
        copyright_notice = "Copyright (c) " + year + " " + holder + ". Free with Mandatory Attribution.";
        license_text = generate_license_text(spdx_license, holder, year);
    } elif mode == "stealth-private" {
        holder = "Redacted";
        public_contact = "";
        public_url = "";
        artifact_name = "";
        free_redistribution = _opt_bool(opts, "free_redistribution", "", false);
        attribution_required = false;
        derivatives_allowed = false;
        spdx_license = _opt_str(opts, "spdx_license", "license", "LicenseRef-Stealth-Private");
        rights_statement = "Rights Reserved (Redacted Provenance)";
        copyright_notice = "Rights Reserved (Redacted)";
        license_text = generate_license_text("LicenseRef-Stealth-Private", "Redacted", year);
    } else {
        _err("unsupported IP mode '" + raw_mode + "' (expected proprietary, free, open-source, free-attribution, or stealth-private)");
    }

    let draft = map{
        schema: "pblang.ip.policy.v4",
        mode: mode,
        copyright_holder: holder,
        year: year,
        spdx_license: spdx_license,
        rights_statement: rights_statement,
        copyright_notice: copyright_notice,
        free_redistribution: free_redistribution,
        attribution_required: attribution_required,
        derivatives_allowed: derivatives_allowed,
        no_ownership_misappropriation: true,
        artifact_name: artifact_name,
        public_url: public_url,
        public_contact: public_contact,
        allow_public_contact: allow_public_contact,
        reject_on_leak: reject_on_leak,
        deterministic_epoch: DETERMINISTIC_EPOCH,
        source_date_epoch: DETERMINISTIC_EPOCH,
        deterministic_timestamp: DETERMINISTIC_TIMESTAMP,
        license_text: license_text,
        engine_attribution: engine_ip_manifest()
    };

    let audit = scrub_and_audit_ip_metadata(draft);
    let clean_pol = audit.scrubbed_policy;
    clean_pol["privacy_clean"] = audit.clean;
    clean_pol["privacy_scrubbed_count"] = audit.scrubbed_count;
    clean_pol["privacy_findings"] = audit.findings;
    return clean_pol;
}

fn _strip_toml_comment(line) {
    let in_dq = false;
    let in_sq = false;
    let i = 0;
    while i < len(line) {
        let ch = str_slice(line, i, i + 1);
        if ch == "\"" and not in_sq {
            if i == 0 or str_slice(line, i - 1, i) != "\\" { in_dq = not in_dq; }
        } elif ch == "'" and not in_dq {
            in_sq = not in_sq;
        } elif ch == "#" and not in_dq and not in_sq {
            return str_slice(line, 0, i);
        }
        i = i + 1;
    }
    return line;
}

fn _parse_toml_scalar(raw_val) {
    let v = str_trim(raw_val);
    if len(v) >= 2 and str_starts_with(v, "\"") and str_ends_with(v, "\"") {
        let inner = str_slice(v, 1, len(v) - 1);
        inner = _str_replace_all(inner, "\\\"", "\"");
        inner = _str_replace_all(inner, "\\\\", "\\");
        return inner;
    }
    if len(v) >= 2 and str_starts_with(v, "'") and str_ends_with(v, "'") {
        return str_slice(v, 1, len(v) - 1);
    }
    if v == "true" { return true; }
    if v == "false" { return false; }
    let maybe_num = try parse_number(v) catch nil;
    if maybe_num != nil { return maybe_num; }
    return v;
}

// Parses `[ip_rights]` (or `[package.metadata.ip_rights]`) from `pblang.toml` text.
fn parse_toml_ip_section(toml_text) {
    if type(toml_text) != "string" { _err("parse_toml_ip_section expects TOML text string"); }
    let lines = str_split(toml_text, "\n");
    let in_ip = false;
    let opts = map{};
    let i = 0;
    while i < len(lines) {
        let cleaned = str_trim(_strip_toml_comment(lines[i]));
        if len(cleaned) > 0 {
            if str_starts_with(cleaned, "[") and str_ends_with(cleaned, "]") {
                let sec = str_trim(str_slice(cleaned, 1, len(cleaned) - 1));
                in_ip = (sec == "ip_rights" or sec == "package.metadata.ip_rights");
            } elif in_ip and str_contains(cleaned, "=") {
                let eq_pos = 0;
                while eq_pos < len(cleaned) and str_slice(cleaned, eq_pos, eq_pos + 1) != "=" {
                    eq_pos = eq_pos + 1;
                }
                let k = str_trim(str_slice(cleaned, 0, eq_pos));
                let v_raw = str_slice(cleaned, eq_pos + 1, len(cleaned));
                if len(k) > 0 {
                    opts[k] = _parse_toml_scalar(v_raw);
                }
            }
        }
        i = i + 1;
    }
    return build_ip_policy(opts);
}

// ── Binary Format Normalization, Encoding & Authorship Proofs ─────────────────

fn _normalize_format_kind(fmt_kind, raw_bytes) {
    let f = if fmt_kind == nil { "auto" } else { str_lower(str_trim(str(fmt_kind))) };
    if f == "auto" or f == "" {
        if len(raw_bytes) >= 8 and raw_bytes[0] == 0 and raw_bytes[1] == 97 and raw_bytes[2] == 115 and raw_bytes[3] == 109 {
            return "wasm";
        }
        if len(raw_bytes) >= 4 and raw_bytes[0] == 127 and raw_bytes[1] == 69 and raw_bytes[2] == 76 and raw_bytes[3] == 70 {
            return "elf";
        }
        if len(raw_bytes) >= 2 and raw_bytes[0] == 77 and raw_bytes[1] == 90 {
            return "pe";
        }
        if len(raw_bytes) >= 4 and (
            (raw_bytes[0] == 207 and raw_bytes[1] == 250 and raw_bytes[2] == 237 and raw_bytes[3] == 254) or
            (raw_bytes[0] == 254 and raw_bytes[1] == 237 and raw_bytes[2] == 250 and raw_bytes[3] == 207) or
            (raw_bytes[0] == 206 and raw_bytes[1] == 250 and raw_bytes[2] == 237 and raw_bytes[3] == 254) or
            (raw_bytes[0] == 202 and raw_bytes[1] == 254 and raw_bytes[2] == 186 and raw_bytes[3] == 190)
        ) {
            return "macho";
        }
        if len(raw_bytes) >= 4 and raw_bytes[0] == 100 and raw_bytes[1] == 101 and raw_bytes[2] == 120 and raw_bytes[3] == 10 {
            return "dex";
        }
        if len(raw_bytes) >= 4 and raw_bytes[0] == 80 and raw_bytes[1] == 66 and raw_bytes[2] == 67 and raw_bytes[3] == 75 {
            return "pbck";
        }
        let head_str = try str_lower(str_trim(bytes_to_str(slice(raw_bytes, 0, if len(raw_bytes) < 128 { len(raw_bytes) } else { 128 })))) catch "";
        if str_contains(head_str, "<svg") { return "svg"; }
        if str_contains(head_str, "<!doctype html") or str_contains(head_str, "<html") { return "html"; }
        return "rom16_8";
    }
    if f == "wasm" or f == "wasm32" or f == "wasm64" { return "wasm"; }
    if f == "elf" or f == "elf64" or f == "elf32" { return "elf"; }
    if f == "pe" or f == "pe32+" or f == "pe32" or f == "exe" or f == "dll" { return "pe"; }
    if f == "macho" or f == "mach-o" or f == "macho64" { return "macho"; }
    if f == "dex" { return "dex"; }
    if f == "pbck" { return "pbck"; }
    if f == "rom16_8" or f == "rom" or f == "8/16-bit rom" or f == "dos16" or f == "cpm80" or f == "c64" or f == "avr8" {
        return "rom16_8";
    }
    if f == "html" or f == "html5" { return "html"; }
    if f == "svg" { return "svg"; }
    _err("unsupported artifact format_kind: " + str(fmt_kind));
    return "";
}

fn _push_u32_le(dst, val) {
    let v = num_floor(val);
    array_push(dst, bit_and(v, 255));
    array_push(dst, bit_and(bit_shr(v, 8), 255));
    array_push(dst, bit_and(bit_shr(v, 16), 255));
    array_push(dst, bit_and(bit_shr(v, 24), 255));
    return dst;
}

fn _read_u32_le(buf, off) {
    return buf[off]
        + buf[off + 1] * 256
        + buf[off + 2] * 65536
        + buf[off + 3] * 16777216;
}

fn _read_u64_le_bounded(buf, off) {
    let lo = _read_u32_le(buf, off);
    let hi = _read_u32_le(buf, off + 4);
    if hi > 2097151 { return -1; }
    return lo + hi * 4294967296;
}

fn _encode_uleb128(val) {
    let out = [];
    let rem = num_floor(val);
    if rem < 0 { _err("negative ULEB128 value"); }
    if rem == 0 {
        array_push(out, 0);
        return out;
    }
    while rem > 0 {
        let byte_val = rem % 128;
        rem = num_floor(rem / 128);
        if rem > 0 { byte_val = byte_val + 128; }
        array_push(out, byte_val);
    }
    return out;
}

fn _decode_uleb128(buf, start_idx, end_idx) {
    let value = 0;
    let scale = 1;
    let cur = start_idx;
    let count = 0;
    while count < 5 {
        if cur >= end_idx { return map{ ok: false, error: "truncated ULEB128" }; }
        let b = buf[cur];
        cur = cur + 1;
        count = count + 1;
        value = value + (b % 128) * scale;
        if b < 128 {
            if value > 4294967295 { return map{ ok: false, error: "ULEB128 overflow" }; }
            return map{ ok: true, value: value, next: cur };
        }
        scale = scale * 128;
    }
    return map{ ok: false, error: "ULEB128 exceeds 5 bytes" };
}

fn _compute_owner_commitment(secret_str) {
    return _SHA256.sha256_hex("PBLANG-OWNER-V1:" + secret_str);
}

fn _compute_policy_digest(clean_policy) {
    let core_pol = map{
        mode: clean_policy.mode,
        copyright_holder: clean_policy.copyright_holder,
        year: clean_policy.year,
        spdx_license: clean_policy.spdx_license,
        rights_statement: clean_policy.rights_statement,
        free_redistribution: clean_policy.free_redistribution,
        attribution_required: clean_policy.attribution_required,
        derivatives_allowed: clean_policy.derivatives_allowed,
        deterministic_timestamp: clean_policy.deterministic_timestamp,
        engine_attribution: clean_policy.engine_attribution
    };
    return _SHA256.sha256_hex(_canonical_json(core_pol));
}

fn _compute_authorship_mac(fmt_kind, payload_sha256, owner_commitment, policy_digest, secret_str) {
    let msg = "PBLANG-IP-AUTH-V1|" + fmt_kind + "|" + payload_sha256 + "|" + owner_commitment + "|" + policy_digest;
    return hmac_sha256_hex(msg, secret_str);
}

fn _xml_attr_escape(s) {
    let r = _str_replace_all(s, "&", "&amp;");
    r = _str_replace_all(r, "<", "&lt;");
    r = _str_replace_all(r, ">", "&gt;");
    r = _str_replace_all(r, "\"", "&quot;");
    return r;
}

// Detect standalone `PBLZREXE` footer at the end of an ELF/PE binary:
// `[host_exe][pbck_bytes (starts with "PBCK")][8-byte LE pbck_len]["PBLZREXE"]`
fn _detect_pblzrexe_bundle(buf) {
    let total = len(buf);
    if total < 24 { return map{ bundled: false }; }
    let magic_bytes = str_to_bytes(BUNDLE_EXE_MAGIC);
    if not _bytes_eq_slice(buf, total - 8, magic_bytes) {
        return map{ bundled: false };
    }
    let pbck_len = _read_u64_le_bounded(buf, total - 16);
    if pbck_len < 5 or pbck_len > total - 20 {
        return map{ bundled: false };
    }
    let pbck_start = total - 16 - pbck_len;
    if not _bytes_eq_slice(buf, pbck_start, str_to_bytes("PBCK")) {
        return map{ bundled: false };
    }
    return map{
        bundled: true,
        split_offset: pbck_start,
        pbck_len: pbck_len
    };
}

fn _build_binary_envelope(prefix_len, seal_record, seal_json) {
    let pol = seal_record.policy;
    let ascii_summary = "@(#)PBLang-IP: " + pol.copyright_notice
        + " | SPDX: " + pol.spdx_license
        + " | Engine: PBLang " + PBLANG_ENGINE_ATTRIBUTION.engine_version + " (Apache-2.0)";
    let tag_bytes = _concat_bytes([0], _concat_bytes(str_to_bytes(ascii_summary), [0]));

    // Pad so "PBIPSEAL" begins on an 8-byte file offset boundary
    let pre_len = prefix_len + len(tag_bytes);
    let pad_needed = (8 - (pre_len % 8)) % 8;
    let env = _clone_bytes(tag_bytes);
    let p = 0;
    while p < pad_needed {
        array_push(env, 0);
        p = p + 1;
    }

    let seal_start_in_env = len(env);
    let json_bytes = str_to_bytes(seal_json);
    let sha_bytes = str_to_bytes(seal_record.payload_sha256);

    _append_bytes(env, str_to_bytes(SEAL_MAGIC_HEADER));
    _push_u32_le(env, len(json_bytes));
    _append_bytes(env, json_bytes);
    _append_bytes(env, sha_bytes);

    // Total bytes from "PBIPSEAL" through "PBIPEOF!" inclusive:
    // 8 (PBIPSEAL) + 4 (json_len) + len(json_bytes) + 64 (sha256) + 4 (seal_rel) + 4 (env_total) + 8 (PBIPEOF!)
    let seal_rel = 8 + 4 + len(json_bytes) + 64 + 4 + 4 + 8;
    let env_total = seal_start_in_env + seal_rel;
    _push_u32_le(env, seal_rel);
    _push_u32_le(env, env_total);
    _append_bytes(env, str_to_bytes(SEAL_MAGIC_FOOTER));
    return env;
}

fn _build_wasm_custom_section(seal_json) {
    let name_bytes = str_to_bytes(WASM_CUSTOM_SECTION_NAME);
    let name_len_uleb = _encode_uleb128(len(name_bytes));
    let json_bytes = str_to_bytes(seal_json);
    let section_payload_len = len(name_len_uleb) + len(name_bytes) + len(json_bytes);
    let section_len_uleb = _encode_uleb128(section_payload_len);

    let sec = [0]; // W3C Custom Section ID = 0x00
    _append_bytes(sec, section_len_uleb);
    _append_bytes(sec, name_len_uleb);
    _append_bytes(sec, name_bytes);
    _append_bytes(sec, json_bytes);
    return sec;
}

fn _build_markup_ip_block(fmt_kind, seal_record, seal_json) {
    let pol = seal_record.policy;
    let rights_esc = _xml_attr_escape(pol.copyright_notice + " [" + pol.spdx_license + "]");
    let engine_esc = _xml_attr_escape(PBLANG_ENGINE_ATTRIBUTION.engine + " " + PBLANG_ENGINE_ATTRIBUTION.engine_version + " (" + PBLANG_ENGINE_ATTRIBUTION.creator + ", Apache-2.0)");
    if fmt_kind == "svg" {
        return "<!--PBLANG-IP-BEGIN-->"
            + "<metadata id=\"pblang-ip-provenance\">"
            + "<rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">"
            + "<rdf:Description>"
            + "<dc:rights>" + rights_esc + "</dc:rights>"
            + "<dc:creator>" + _xml_attr_escape(pol.copyright_holder) + "</dc:creator>"
            + "<dc:publisher>" + engine_esc + "</dc:publisher>"
            + "</rdf:Description>"
            + "</rdf:RDF>"
            + "</metadata>"
            + "<!-- PBLANG-IP-PROVENANCE: " + seal_json + " -->"
            + "<!--PBLANG-IP-END-->";
    }
    return "<!--PBLANG-IP-BEGIN-->"
        + "<meta name=\"copyright\" content=\"" + rights_esc + "\" />"
        + "<meta name=\"license\" content=\"" + _xml_attr_escape(pol.spdx_license) + "\" />"
        + "<meta name=\"generator\" content=\"" + engine_esc + "\" />"
        + "<!-- PBLANG-IP-PROVENANCE: " + seal_json + " -->"
        + "<!--PBLANG-IP-END-->";
}

fn _embed_markup_bytes(raw_bytes, block_str, fmt_kind) {
    let block_bytes = str_to_bytes(block_str);
    let raw_str = try bytes_to_str(raw_bytes) catch nil;
    if raw_str != nil {
        let low = str_lower(raw_str);
        if fmt_kind == "html" {
            let close_head = _bytes_index_of(str_to_bytes(low), str_to_bytes("</head>"), 0);
            if close_head >= 0 {
                let pre = slice(raw_bytes, 0, close_head);
                let post = slice(raw_bytes, close_head, len(raw_bytes));
                return _concat_bytes(_concat_bytes(pre, block_bytes), post);
            }
        }
        if fmt_kind == "svg" {
            let close_svg = _bytes_index_of(str_to_bytes(low), str_to_bytes("</svg>"), 0);
            if close_svg >= 0 {
                let pre2 = slice(raw_bytes, 0, close_svg);
                let post2 = slice(raw_bytes, close_svg, len(raw_bytes));
                return _concat_bytes(_concat_bytes(pre2, block_bytes), post2);
            }
        }
    }
    return _concat_bytes(raw_bytes, block_bytes);
}

fn _validate_wasm_structure(buf) {
    if len(buf) < 8 { return false; }
    if buf[0] != 0 or buf[1] != 97 or buf[2] != 115 or buf[3] != 109 { return false; }
    if buf[4] != 1 or buf[5] != 0 or buf[6] != 0 or buf[7] != 0 { return false; }
    let cur = 8;
    while cur < len(buf) {
        let sec_id = buf[cur];
        if sec_id < 0 or sec_id > 13 { return false; }
        cur = cur + 1;
        let sz = _decode_uleb128(buf, cur, len(buf));
        if not sz.ok { return false; }
        cur = sz.next + sz.value;
        if cur > len(buf) { return false; }
    }
    return cur == len(buf);
}

// Seal raw executable/artifact bytes with tamper-evident SHA-256 + optional HMAC-SHA256
// and Zero-Knowledge Author Commitment across all PBLang targets.
fn seal_artifact_bytes(raw_input, format_kind = "auto", policy = nil, signing_secret_opt = nil) {
    let raw_bytes = _as_bytes(raw_input);
    if len(raw_bytes) == 0 { _err("cannot seal empty artifact payload"); }
    let fmt = _normalize_format_kind(format_kind, raw_bytes);

    if fmt == "wasm" and not _validate_wasm_structure(raw_bytes) {
        _err("invalid W3C WebAssembly module passed to seal_artifact_bytes");
    }
    if fmt == "elf" and (len(raw_bytes) < 16 or raw_bytes[0] != 127 or raw_bytes[1] != 69 or raw_bytes[2] != 76 or raw_bytes[3] != 70) {
        _err("invalid ELF magic header");
    }
    if fmt == "pe" and (len(raw_bytes) < 2 or raw_bytes[0] != 77 or raw_bytes[1] != 90) {
        _err("invalid PE MZ header");
    }

    let clean_pol = if policy == nil { build_ip_policy(nil) } else { scrub_and_audit_ip_metadata(policy).scrubbed_policy };
    if not map_has(clean_pol, "mode") or not map_has(clean_pol, "spdx_license") {
        clean_pol = build_ip_policy(clean_pol);
    }

    let payload_sha256 = _SHA256.sha256_hex_bytes(raw_bytes);
    let policy_digest = _compute_policy_digest(clean_pol);

    let has_secret = false;
    let secret_str = "";
    if signing_secret_opt != nil {
        if type(signing_secret_opt) == "string" and len(signing_secret_opt) > 0 {
            has_secret = true;
            secret_str = signing_secret_opt;
        } elif is_array(signing_secret_opt) and len(signing_secret_opt) > 0 {
            has_secret = true;
            secret_str = _SHA256.sha256_hex_bytes(signing_secret_opt);
        }
    }

    let owner_commitment = "";
    let authorship_mac = "";
    if has_secret {
        owner_commitment = _compute_owner_commitment(secret_str);
        authorship_mac = _compute_authorship_mac(fmt, payload_sha256, owner_commitment, policy_digest, secret_str);
    }

    // Exported policy subset stored inside binary (never includes signing secrets or internal flags)
    let embedded_policy = map{
        schema: "pblang.ip.policy.v4",
        mode: clean_pol.mode,
        copyright_holder: clean_pol.copyright_holder,
        year: clean_pol.year,
        spdx_license: clean_pol.spdx_license,
        rights_statement: clean_pol.rights_statement,
        copyright_notice: clean_pol.copyright_notice,
        free_redistribution: clean_pol.free_redistribution,
        attribution_required: clean_pol.attribution_required,
        derivatives_allowed: clean_pol.derivatives_allowed,
        deterministic_timestamp: DETERMINISTIC_TIMESTAMP,
        source_date_epoch: DETERMINISTIC_EPOCH,
        engine_attribution: engine_ip_manifest()
    };
    if map_has(clean_pol, "artifact_name") and len(str(clean_pol.artifact_name)) > 0 {
        embedded_policy["artifact_name"] = clean_pol.artifact_name;
    }
    if map_has(clean_pol, "public_url") and len(str(clean_pol.public_url)) > 0 {
        embedded_policy["public_url"] = clean_pol.public_url;
    }
    if clean_pol.allow_public_contact == true and len(str(clean_pol.public_contact)) > 0 {
        embedded_policy["public_contact"] = clean_pol.public_contact;
    }

    let seal_record = map{
        seal_version: "pblang.ipseal.v1",
        format_kind: fmt,
        payload_bytes: len(raw_bytes),
        payload_sha256: payload_sha256,
        policy_digest: policy_digest,
        signed: has_secret,
        owner_commitment: owner_commitment,
        authorship_mac: authorship_mac,
        deterministic_timestamp: DETERMINISTIC_TIMESTAMP,
        source_date_epoch: DETERMINISTIC_EPOCH,
        policy: embedded_policy,
        engine: engine_ip_manifest()
    };
    let seal_json = _canonical_json(seal_record);

    if fmt == "wasm" {
        let custom_sec = _build_wasm_custom_section(seal_json);
        return _concat_bytes(raw_bytes, custom_sec);
    }

    if fmt == "html" or fmt == "svg" {
        let block_str = _build_markup_ip_block(fmt, seal_record, seal_json);
        return _embed_markup_bytes(raw_bytes, block_str, fmt);
    }

    // Check if ELF/PE ends with a `PBLZREXE` standalone bytecode bundle trailer:
    // insert `PBIPSEAL` right before `[pbck_bytes][pbck_len]["PBLZREXE"]` so BOTH
    // the OS kernel loader AND `zr_check_embedded_pbck` execute 100% natively!
    let bundle_info = _detect_pblzrexe_bundle(raw_bytes);
    if bundle_info.bundled {
        let host_part = slice(raw_bytes, 0, bundle_info.split_offset);
        let bundle_tail = slice(raw_bytes, bundle_info.split_offset, len(raw_bytes));
        let env_b = _build_binary_envelope(len(host_part), seal_record, seal_json);
        return _concat_bytes(_concat_bytes(host_part, env_b), bundle_tail);
    }

    let env = _build_binary_envelope(len(raw_bytes), seal_record, seal_json);
    return _concat_bytes(raw_bytes, env);
}

// ── Extraction, Inspection, Tamper Verification & Ownership Proof ─────────────

fn _extract_pbipseal_at(buf, end_pos, trailing_bytes) {
    if end_pos < 96 { return nil; }
    if not _bytes_eq_slice(buf, end_pos - 8, str_to_bytes(SEAL_MAGIC_FOOTER)) {
        return nil;
    }
    let env_total = _read_u32_le(buf, end_pos - 12);
    let seal_rel = _read_u32_le(buf, end_pos - 16);
    if env_total < 96 or seal_rel < 92 or seal_rel > env_total or env_total > end_pos {
        return map{ found: true, corrupted: true, error: "corrupted PBIPSEAL length fields" };
    }
    let orig_end = end_pos - env_total;
    let seal_pos = end_pos - seal_rel;
    if not _bytes_eq_slice(buf, seal_pos, str_to_bytes(SEAL_MAGIC_HEADER)) {
        return map{ found: true, corrupted: true, error: "corrupted PBIPSEAL header magic" };
    }
    let json_len = _read_u32_le(buf, seal_pos + 8);
    if seal_pos + 12 + json_len + 64 + 16 != end_pos {
        return map{ found: true, corrupted: true, error: "PBIPSEAL JSON length mismatch" };
    }
    let json_str = try bytes_to_str(slice(buf, seal_pos + 12, seal_pos + 12 + json_len)) catch nil;
    let footer_sha = try bytes_to_str(slice(buf, seal_pos + 12 + json_len, seal_pos + 12 + json_len + 64)) catch nil;
    if json_str == nil or footer_sha == nil {
        return map{ found: true, corrupted: true, error: "PBIPSEAL invalid UTF-8 manifest" };
    }
    let parsed = try _JSON.parse(json_str) catch nil;
    if parsed == nil or not is_map(parsed) {
        return map{ found: true, corrupted: true, error: "PBIPSEAL malformed JSON manifest" };
    }
    let unsealed = _concat_bytes(slice(buf, 0, orig_end), trailing_bytes);
    let actual_env = slice(buf, orig_end, end_pos);
    let expected_env = try _build_binary_envelope(orig_end, parsed, _canonical_json(parsed)) catch [];
    let env_intact = _ct_eq_bytes(actual_env, expected_env) and _ct_eq_str(footer_sha, str(try parsed.payload_sha256 catch ""));
    return map{
        found: true,
        corrupted: not env_intact,
        container: if len(trailing_bytes) > 0 { "pbipseal+pblzrexe" } else { "pbipseal" },
        seal: parsed,
        seal_json: json_str,
        unsealed_bytes: unsealed,
        envelope_intact: env_intact
    };
}

fn _extract_wasm_seal(buf) {
    // 1. Standard forward W3C WASM section walk
    let wasm_valid = _validate_wasm_structure(buf);
    let name_bytes = str_to_bytes(WASM_CUSTOM_SECTION_NAME);
    if len(buf) >= 16 and buf[0] == 0 and buf[1] == 97 and buf[2] == 115 and buf[3] == 109 {
        let cur = 8;
        let has_found_sec = false;
        let found_sec = map{ sec_start: 0, sec_end: 0, json_bytes: [] };
        while cur < len(buf) {
            let sec_start = cur;
            let sec_id = buf[cur];
            cur = cur + 1;
            let sz = _decode_uleb128(buf, cur, len(buf));
            if not sz.ok or sz.next + sz.value > len(buf) { break; }
            let pay_start = sz.next;
            let pay_end = pay_start + sz.value;
            if sec_id == 0 {
                let nm_len = _decode_uleb128(buf, pay_start, pay_end);
                if nm_len.ok and nm_len.value == len(name_bytes) and _bytes_eq_slice(buf, nm_len.next, name_bytes) {
                    let j_start = nm_len.next + len(name_bytes);
                    has_found_sec = true;
                    found_sec = map{
                        sec_start: sec_start,
                        sec_end: pay_end,
                        json_bytes: slice(buf, j_start, pay_end)
                    };
                }
            }
            cur = pay_end;
        }
        if has_found_sec {
            let j_str = try bytes_to_str(found_sec.json_bytes) catch nil;
            let parsed = if j_str != nil { try _JSON.parse(j_str) catch nil } else { nil };
            if parsed == nil or not is_map(parsed) {
                return map{ found: true, corrupted: true, error: "corrupted WASM pblang.ip JSON" };
            }
            let unsealed = _concat_bytes(slice(buf, 0, found_sec.sec_start), slice(buf, found_sec.sec_end, len(buf)));
            let expected_sec = try _build_wasm_custom_section(_canonical_json(parsed)) catch [];
            let actual_sec = slice(buf, found_sec.sec_start, found_sec.sec_end);
            let sec_ok = wasm_valid and _validate_wasm_structure(unsealed) and _ct_eq_bytes(actual_sec, expected_sec);
            return map{
                found: true,
                corrupted: not sec_ok,
                container: "wasm-custom-section-0x00",
                wasm_custom_section_id: 0,
                wasm_custom_section_name: WASM_CUSTOM_SECTION_NAME,
                wasm_envelope_valid: wasm_valid,
                seal: parsed,
                seal_json: j_str,
                unsealed_bytes: unsealed,
                envelope_intact: sec_ok
            };
        }
    }

    // 2. Fallback tail scan for `[0x00, ULEB128, 0x09, "pblang.ip"]` in case an earlier byte
    // in the WASM header/section table was tampered with!
    let marker = _concat_bytes([len(name_bytes)], name_bytes);
    let pos = _bytes_index_of(buf, marker, 0);
    while pos >= 2 {
        let back = 1;
        while back <= 5 and pos - back >= 1 {
            let sec_start2 = pos - back - 1;
            if buf[sec_start2] == 0 {
                let sz2 = _decode_uleb128(buf, sec_start2 + 1, pos);
                if sz2.ok and sz2.next == pos and pos + sz2.value == len(buf) {
                    let j_bytes2 = slice(buf, pos + len(marker), len(buf));
                    let j_str2 = try bytes_to_str(j_bytes2) catch nil;
                    let parsed2 = if j_str2 != nil { try _JSON.parse(j_str2) catch nil } else { nil };
                    let unsealed2 = slice(buf, 0, sec_start2);
                    if parsed2 != nil and is_map(parsed2) {
                        return map{
                            found: true,
                            corrupted: true,
                            container: "wasm-custom-section-0x00",
                            wasm_custom_section_id: 0,
                            wasm_custom_section_name: WASM_CUSTOM_SECTION_NAME,
                            wasm_envelope_valid: false,
                            seal: parsed2,
                            seal_json: j_str2,
                            unsealed_bytes: unsealed2,
                            envelope_intact: false
                        };
                    }
                }
            }
            back = back + 1;
        }
        pos = _bytes_index_of(buf, marker, pos + 1);
    }
    return nil;
}

fn _extract_markup_seal(buf) {
    let begin_m = str_to_bytes("<!--PBLANG-IP-BEGIN-->");
    let end_m = str_to_bytes("<!--PBLANG-IP-END-->");
    let b_idx = _bytes_index_of(buf, begin_m, 0);
    if b_idx < 0 { return nil; }
    let e_idx = _bytes_index_of(buf, end_m, b_idx + len(begin_m));
    if e_idx < 0 {
        return map{ found: true, corrupted: true, error: "unterminated PBLANG-IP markup block" };
    }
    let block_end = e_idx + len(end_m);
    let block_bytes = slice(buf, b_idx, block_end);
    let block_str = try bytes_to_str(block_bytes) catch nil;
    if block_str == nil {
        return map{ found: true, corrupted: true, error: "invalid UTF-8 in PBLANG-IP markup block" };
    }
    let prov_prefix = "<!-- PBLANG-IP-PROVENANCE: ";
    let prov_suffix = " --><!--PBLANG-IP-END-->";
    let p_start = _bytes_index_of(block_bytes, str_to_bytes(prov_prefix), 0);
    let p_end = _bytes_index_of(block_bytes, str_to_bytes(prov_suffix), 0);
    if p_start < 0 or p_end < p_start + len(prov_prefix) {
        return map{ found: true, corrupted: true, error: "missing PBLANG-IP-PROVENANCE comment" };
    }
    let json_bytes = slice(block_bytes, p_start + len(prov_prefix), p_end);
    let json_str = try bytes_to_str(json_bytes) catch nil;
    let parsed = if json_str != nil { try _JSON.parse(json_str) catch nil } else { nil };
    if parsed == nil or not is_map(parsed) {
        return map{ found: true, corrupted: true, error: "malformed JSON in PBLANG-IP-PROVENANCE comment" };
    }
    let unsealed = _concat_bytes(slice(buf, 0, b_idx), slice(buf, block_end, len(buf)));
    let fmt = str(try parsed.format_kind catch "html");
    let expected_block = try _build_markup_ip_block(fmt, parsed, _canonical_json(parsed)) catch "";
    let block_ok = _ct_eq_str(block_str, expected_block);
    return map{
        found: true,
        corrupted: not block_ok,
        container: fmt + "-provenance-comment",
        seal: parsed,
        seal_json: json_str,
        unsealed_bytes: unsealed,
        envelope_intact: block_ok
    };
}

fn _extract_any_seal(sealed_input) {
    let buf = _as_bytes(sealed_input);
    if len(buf) == 0 { return map{ found: false }; }

    // 1. Direct `PBIPEOF!` trailer at EOF (ELF, PE, Mach-O, DEX, PBCK, ROM16_8)
    let direct_bin = _extract_pbipseal_at(buf, len(buf), []);
    if direct_bin != nil { return direct_bin; }

    // 2. Standalone `PBLZREXE` bundled executable (`[host][PBIPSEAL][pbck][len]["PBLZREXE"]`)
    let binfo = _detect_pblzrexe_bundle(buf);
    if binfo.bundled {
        let tail = slice(buf, binfo.split_offset, len(buf));
        let bundled_bin = _extract_pbipseal_at(buf, binfo.split_offset, tail);
        if bundled_bin != nil { return bundled_bin; }
    }

    // 3. W3C WebAssembly Custom Section (`0x00` `"pblang.ip"`)
    let wasm_res = _extract_wasm_seal(buf);
    if wasm_res != nil { return wasm_res; }

    // 4. HTML5 / SVG structured provenance block
    let markup_res = _extract_markup_seal(buf);
    if markup_res != nil { return markup_res; }

    return map{ found: false };
}

fn inspect_artifact_ip(sealed_input) {
    let ext = _extract_any_seal(sealed_input);
    if not ext.found {
        return map{
            ok: false,
            sealed: false,
            error: "no PBLang IP provenance seal found in artifact"
        };
    }
    if not map_has(ext, "seal") or ext.seal == nil {
        return map{
            ok: false,
            sealed: true,
            corrupted: true,
            error: try ext.error catch "corrupted PBLang IP provenance seal"
        };
    }
    let s = ext.seal;
    let pol = try s.policy catch map{};
    return map{
        ok: not ext.corrupted,
        sealed: true,
        corrupted: ext.corrupted,
        container: ext.container,
        seal_version: try s.seal_version catch "",
        format_kind: try s.format_kind catch "",
        payload_bytes: try s.payload_bytes catch 0,
        payload_sha256: try s.payload_sha256 catch "",
        policy_digest: try s.policy_digest catch "",
        signed: (try s.signed catch false) == true,
        owner_commitment: try s.owner_commitment catch "",
        authorship_mac: try s.authorship_mac catch "",
        deterministic_timestamp: try s.deterministic_timestamp catch DETERMINISTIC_TIMESTAMP,
        source_date_epoch: try s.source_date_epoch catch DETERMINISTIC_EPOCH,
        mode: try pol.mode catch "",
        copyright_holder: try pol.copyright_holder catch "",
        year: try pol.year catch "",
        spdx_license: try pol.spdx_license catch "",
        rights_statement: try pol.rights_statement catch "",
        copyright_notice: try pol.copyright_notice catch "",
        free_redistribution: (try pol.free_redistribution catch false) == true,
        attribution_required: (try pol.attribution_required catch true) == true,
        derivatives_allowed: (try pol.derivatives_allowed catch false) == true,
        policy: pol,
        engine: try s.engine catch engine_ip_manifest()
    };
}

fn verify_artifact_ip(sealed_input, verify_secret_opt = nil) {
    let ext = _extract_any_seal(sealed_input);
    if not ext.found {
        return map{
            ok: false,
            sealed: false,
            integrity_ok: false,
            tampered: true,
            reason: "missing_ip_seal"
        };
    }
    if not map_has(ext, "seal") or ext.seal == nil {
        return map{
            ok: false,
            sealed: true,
            integrity_ok: false,
            tampered: true,
            reason: try ext.error catch "corrupted_ip_seal"
        };
    }

    let s = ext.seal;
    let pol = try s.policy catch map{};
    let expected_sha = str(try s.payload_sha256 catch "");
    let actual_sha = _SHA256.sha256_hex_bytes(ext.unsealed_bytes);
    let sha_match = _ct_eq_str(actual_sha, expected_sha);
    let len_match = (len(ext.unsealed_bytes) == (try s.payload_bytes catch -1));
    let expected_pol_digest = try _compute_policy_digest(pol) catch "";
    let pol_match = _ct_eq_str(expected_pol_digest, str(try s.policy_digest catch ""));

    let integrity_ok = (not ext.corrupted) and ext.envelope_intact and sha_match and len_match and pol_match;
    let has_secret_verify = false;
    let mac_verified_bool = false;
    let secret_ok = true;

    if verify_secret_opt != nil {
        has_secret_verify = true;
        let sec_str = if type(verify_secret_opt) == "string" {
            verify_secret_opt
        } else {
            _SHA256.sha256_hex_bytes(_as_bytes(verify_secret_opt))
        };
        let exp_commit = _compute_owner_commitment(sec_str);
        let commit_ok = _ct_eq_str(exp_commit, str(try s.owner_commitment catch ""));
        let exp_mac = _compute_authorship_mac(
            str(try s.format_kind catch ""),
            expected_sha,
            exp_commit,
            expected_pol_digest,
            sec_str
        );
        let mac_ok = _ct_eq_str(exp_mac, str(try s.authorship_mac catch ""));
        mac_verified_bool = commit_ok and mac_ok;
        secret_ok = mac_verified_bool;
    }

    let reason = "verified";
    if not sha_match or not len_match { reason = "payload_sha256_mismatch"; }
    elif not pol_match { reason = "policy_digest_mismatch"; }
    elif ext.corrupted or not ext.envelope_intact { reason = "seal_envelope_tampered"; }
    elif not secret_ok { reason = "authorship_secret_mismatch"; }

    return map{
        ok: integrity_ok and secret_ok,
        sealed: true,
        integrity_ok: integrity_ok,
        tampered: not integrity_ok,
        reason: reason,
        container: ext.container,
        format_kind: str(try s.format_kind catch ""),
        expected_sha256: expected_sha,
        actual_sha256: actual_sha,
        payload_bytes: len(ext.unsealed_bytes),
        signed: (try s.signed catch false) == true,
        authorship_verified: if has_secret_verify { mac_verified_bool } else { nil },
        owner_commitment: str(try s.owner_commitment catch ""),
        copyright_holder: str(try pol.copyright_holder catch ""),
        spdx_license: str(try pol.spdx_license catch ""),
        free_redistribution: (try pol.free_redistribution catch false) == true,
        policy: pol,
        engine: try s.engine catch engine_ip_manifest()
    };
}

// Court-grade zero-knowledge authorship verification: proves the caller possesses
// the original signing secret that created `owner_commitment` & `authorship_mac`
// over the untampered binary without the secret ever having been stored in the binary.
fn verify_ownership_claim(sealed_input, candidate_secret) {
    if candidate_secret == nil or (type(candidate_secret) == "string" and len(candidate_secret) == 0) {
        return map{
            ok: false,
            proven_owner: false,
            integrity_ok: false,
            tampered: false,
            reason: "empty_candidate_secret"
        };
    }
    let v = verify_artifact_ip(sealed_input, candidate_secret);
    if not v.sealed {
        return map{
            ok: false,
            proven_owner: false,
            integrity_ok: false,
            tampered: true,
            reason: v.reason
        };
    }
    let is_signed = v.signed == true and len(v.owner_commitment) == 64;
    let proven = v.integrity_ok and is_signed and v.authorship_verified == true;
    return map{
        ok: proven,
        proven_owner: proven,
        integrity_ok: v.integrity_ok,
        tampered: v.tampered,
        signed: is_signed,
        authorship_verified: v.authorship_verified == true,
        owner_commitment: v.owner_commitment,
        payload_sha256: v.actual_sha256,
        copyright_holder: v.copyright_holder,
        spdx_license: v.spdx_license,
        reason: if not is_signed { "artifact_was_not_signed" } else { v.reason }
    };
}

fn strip_artifact_ip_seal(sealed_input) {
    let ext = _extract_any_seal(sealed_input);
    if not ext.found { return _as_bytes(sealed_input); }
    return ext.unsealed_bytes;
}

export PBLANG_ENGINE_ATTRIBUTION, SUPPORTED_IP_MODES, SUPPORTED_SPDX_LICENSES;
export DETERMINISTIC_EPOCH, DETERMINISTIC_TIMESTAMP;
export engine_ip_manifest, build_ip_policy, parse_toml_ip_section, generate_license_text;
export scrub_and_audit_ip_metadata, hmac_sha256_bytes, hmac_sha256_hex;
export seal_artifact_bytes, inspect_artifact_ip, verify_artifact_ip, verify_ownership_claim, strip_artifact_ip_seal;
