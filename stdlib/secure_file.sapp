// Race-resistant single-file operations for Linux and macOS, implemented in PBLang.
//
// The parent path is opened component-by-component through linux_dirfs and the
// final file is accessed relative to that held directory descriptor. Callers
// must not fall back to ordinary path I/O when one of these operations
// fails: failure can mean a symlink or namespace race was rejected.

let LinuxDirFS = import("stdlib:linux_dirfs.sapp");
let PosixDirFS = import("stdlib:posix_dirfs.sapp");
let WindowsDirFS = import("stdlib:windows_dirfs.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

let MAX_PATH = 4096;
let RAW_SHA256_ALGORITHM = "sha256(raw-bytes)";

fn _error(message) { return map{ ok: false, error: message }; }

fn _backend_name() {
    if platform() == "linux" { return "linux"; }
    if platform() == "macos" { return "macos"; }
    if platform() == "windows" { return "windows"; }
    return "unavailable";
}

fn _close(fs) {
    if platform() == "linux" { return LinuxDirFS.close(fs); }
    if platform() == "macos" { return PosixDirFS.close(fs); }
    if platform() == "windows" { return WindowsDirFS.close(fs); }
    return nil;
}

fn _read_backend(fs, name, max_bytes) {
    if platform() == "linux" { return LinuxDirFS.read_bytes(fs, name, max_bytes); }
    if platform() == "macos" { return PosixDirFS.read_bytes(fs, name, max_bytes); }
    if platform() == "windows" { return WindowsDirFS.read_bytes(fs, name, max_bytes); }
    return _error("secure file backend is unavailable");
}

fn _read_prefix_backend(fs, name, max_bytes) {
    if platform() == "linux" { return LinuxDirFS.read_prefix_bytes(fs, name, max_bytes); }
    if platform() == "macos" { return PosixDirFS.read_prefix_bytes(fs, name, max_bytes); }
    if platform() == "windows" { return WindowsDirFS.read_prefix_bytes(fs, name, max_bytes); }
    return _error("secure file backend is unavailable");
}

fn _list_backend(fs, path, max_entries) {
    if platform() == "linux" { return LinuxDirFS.list(fs, path, max_entries); }
    if platform() == "macos" { return PosixDirFS.list(fs, path, max_entries); }
    if platform() == "windows" { return WindowsDirFS.list(fs, path, max_entries); }
    return _error("secure file backend is unavailable");
}

fn _write_atomic_backend(fs, name, bytes) {
    if platform() == "linux" { return LinuxDirFS.write_atomic(fs, name, bytes, false); }
    if platform() == "macos" { return PosixDirFS.write_atomic(fs, name, bytes, false); }
    if platform() == "windows" { return WindowsDirFS.write_atomic(fs, name, bytes, false); }
    return _error("secure file backend is unavailable");
}

fn _write_new_backend(fs, name, bytes) {
    if platform() == "linux" { return LinuxDirFS.write_new_exclusive(fs, name, bytes, false); }
    if platform() == "macos" { return PosixDirFS.write_new_exclusive(fs, name, bytes, false); }
    if platform() == "windows" { return WindowsDirFS.write_new_exclusive(fs, name, bytes, false); }
    return _error("secure file backend is unavailable");
}

fn _remove_backend(fs, name) {
    if platform() == "linux" { return LinuxDirFS.remove_file(fs, name); }
    if platform() == "macos" { return PosixDirFS.remove_file(fs, name); }
    if platform() == "windows" { return WindowsDirFS.remove_file(fs, name); }
    return _error("secure file backend is unavailable");
}

fn available() {
    let backend_name = _backend_name();
    if backend_name == "unavailable" { return map{ ok: false, format: "pblang.secure-file.v1",
        backend: "unavailable", platform: platform() }; }
    let state = map{ ok: false };
    if backend_name == "linux" { state = LinuxDirFS.available(); }
    elif backend_name == "macos" { state = PosixDirFS.available(); }
    else { state = WindowsDirFS.available(); }
    let backend_label = "posix-dirfs";
    if backend_name == "linux" { backend_label = "linux-dirfs"; }
    elif backend_name == "windows" { backend_label = "windows-nt-dirfs"; }
    return map{ ok: state.ok, format: "pblang.secure-file.v1",
        backend: backend_label,
        platform: platform(),
        library_ready: try state.library_ready catch state.ok,
        operations_attemptable: try state.operations_attemptable catch state.ok,
        ffi_symbol_contract_verified: try state.ffi_symbol_contract_verified catch false,
        operationally_verified: try state.operationally_verified catch state.ok,
        private_root_verified: try state.private_root_verified catch false,
        reason: try state.reason catch if state.ok { "" } else { "backend-unavailable" } };
}

fn _parts(path) {
    if type(path) != "string" or path == "" or len(path) > MAX_PATH
        or str_contains(path, strfromcharcode(0)) or str_ends_with(path, "/") {
        return nil;
    }
    let name = "";
    try { name = path_basename(path); } catch { name = ""; }
    if name == "" or name == "." or name == ".." or str_contains(name, "/")
        or str_contains(name, "\\") {
        return nil;
    }
    let parent_path = "";
    try { parent_path = path_dirname(path); } catch { parent_path = ""; }
    if parent_path == "" { parent_path = "."; }
    return map{ parent: parent_path, name: name,
        absolute: str_starts_with(parent_path, "/") };
}

fn _open_parent(path, create, private_parent) {
    let parts = _parts(path);
    if parts == nil { return _error("invalid secure file path"); }
    if private_parent and platform() != "linux" {
        return _error("private parent ownership and permissions are not operationally verified on this platform");
    }
    if platform() == "windows" {
        if parts.absolute { return _error("absolute secure roots require an explicit WindowsDirFS root handle"); }
        let fs = WindowsDirFS.open(".", false);
        if not fs.ok { return _error("secure Windows root directory is unavailable"); }
        return map{ ok: true, fs: fs, name: str_replace_all(path, "/", "\\") };
    }
    if parts.absolute and platform() != "linux" {
        return _error("absolute secure roots are not supported by this platform backend");
    }
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if platform() == "linux" and private_parent {
        let private_fs = if parts.absolute {
            LinuxDirFS.open_absolute(parts.parent, false, false)
        } else { LinuxDirFS.open(parts.parent, false, false) };
        if not private_fs.ok and create {
            let created = create_private_directory_new(parts.parent);
            if not created.ok { return _error("private parent must exist or be exclusively creatable"); }
            private_fs = if parts.absolute {
                LinuxDirFS.open_absolute(parts.parent, false, false)
            } else { LinuxDirFS.open(parts.parent, false, false) };
        }
        if not private_fs.ok { return _error("private parent directory is unavailable"); }
        let policy = LinuxDirFS.private_root_status(private_fs);
        if not policy.ok {
            _close(private_fs);
            return _error("private parent must already be current-user-owned mode 0700");
        }
        return map{ ok: true, fs: private_fs, name: parts.name,
            private_parent_verified: true };
    }
    let fs = nil;
    if parts.absolute { fs = LinuxDirFS.open_absolute(parts.parent, create, false); }
    elif platform() == "linux" { fs = LinuxDirFS.open(parts.parent, create, false); }
    else { fs = PosixDirFS.open(parts.parent, create); }
    if not fs.ok {
        return _error("secure parent directory is unavailable: "
            + (try fs.error catch "descriptor backend rejected the root"));
    }
    return map{ ok: true, fs: fs, name: parts.name };
}

// List one directory through a held, no-follow root. This is intentionally a
// directory operation rather than "list parent + trust child": every component
// of the requested directory is resolved by the platform handle backend.
fn list_directory(path, max_entries = 512) {
    if type(path) != "string" or path == "" or len(path) > MAX_PATH
       or str_contains(path, strfromcharcode(0))
       or type(max_entries) != "number" or max_entries != num_floor(max_entries)
       or max_entries < 1 or max_entries > 4096 {
        return _error("invalid secure directory listing request");
    }
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }

    let fs = nil;
    if platform() == "linux" {
        fs = if str_starts_with(path, "/") { LinuxDirFS.open_absolute(path, false, false) }
            else { LinuxDirFS.open(path, false, false) };
    } elif platform() == "macos" {
        if str_starts_with(path, "/") {
            return _error("absolute secure directory roots are not supported on macOS");
        }
        fs = PosixDirFS.open(path, false);
    } else {
        fs = WindowsDirFS.open(path, false);
    }
    if fs == nil or not fs.ok { return _error("secure directory root is unavailable"); }
    let result = _list_backend(fs, "root", max_entries);
    _close(fs);
    return result;
}

fn read_bytes(path, max_bytes, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes) {
        return _error("invalid secure read limit");
    }
    let parent = _open_parent(path, false, private_parent); if not parent.ok { return parent; }
    let result = _read_backend(parent.fs, parent.name, max_bytes);
    _close(parent.fs); return result;
}

fn read_text(path, max_bytes, private_parent = false) {
    let result = read_bytes(path, max_bytes, private_parent); if not result.ok { return result; }
    let text = try bytes_to_str(result.bytes) catch nil;
    if text == nil { return _error("secure file is not valid UTF-8"); }
    return map{ ok: true, text: text, size: result.size };
}

fn _incomplete_utf8_suffix(bytes, start) {
    let remaining = len(bytes) - start;
    if remaining < 1 or remaining > 3 { return false; }
    let lead = bytes[start]; let expected = 0;
    if lead >= 194 and lead <= 223 { expected = 2; }
    elif lead >= 224 and lead <= 239 { expected = 3; }
    elif lead >= 240 and lead <= 244 { expected = 4; }
    else { return false; }
    if remaining >= expected { return false; }
    let i = start + 1;
    while i < len(bytes) {
        if bytes[i] < 128 or bytes[i] > 191 { return false; }
        i = i + 1;
    }
    if remaining >= 2 {
        let second = bytes[start + 1];
        if lead == 224 and second < 160 { return false; }
        if lead == 237 and second > 159 { return false; }
        if lead == 240 and second < 144 { return false; }
        if lead == 244 and second > 143 { return false; }
    }
    return true;
}

// Read at most max_bytes from one held regular-file descriptor. A UTF-8 code
// point can straddle the byte ceiling, so discard only a proven incomplete
// scalar suffix. Any malformed byte sequence still fails closed.
fn read_text_prefix(path, max_bytes, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes) {
        return _error("invalid secure prefix limit");
    }
    let parent = _open_parent(path, false, private_parent); if not parent.ok { return parent; }
    let result = _read_prefix_backend(parent.fs, parent.name, max_bytes);
    _close(parent.fs); if not result.ok { return result; }
    let bytes = result.bytes; let text = try bytes_to_str(bytes) catch nil; let trimmed = 0;
    if text == nil and result.truncated {
        let candidate_trim = 1;
        while candidate_trim <= 3 and candidate_trim <= len(bytes) and text == nil {
            let start = len(bytes) - candidate_trim;
            if _incomplete_utf8_suffix(bytes, start) {
                let candidate = slice(bytes, 0, start);
                let decoded = try bytes_to_str(candidate) catch nil;
                if decoded != nil { bytes = candidate; text = decoded; trimmed = candidate_trim; }
            }
            candidate_trim = candidate_trim + 1;
        }
    }
    if text == nil { return _error("secure file prefix is not valid UTF-8"); }
    return map{
        ok: true, text: text, size: result.source_size,
        source_size: result.source_size, returned_bytes: len(bytes),
        truncated: result.truncated or trimmed > 0,
        utf8_boundary_trimmed_bytes: trimmed,
        race_resistant: true
    };
}

fn read_optional_text(path, max_bytes, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes != num_floor(max_bytes) {
        return _error("invalid secure read limit");
    }
    let parent = _open_parent(path, false, private_parent); if not parent.ok { return parent; }
    if platform() == "windows" {
        let loaded = _read_backend(parent.fs, parent.name, max_bytes); _close(parent.fs);
        if not loaded.ok and (try loaded.missing catch false) { return map{ ok: true, missing: true }; }
        if not loaded.ok { return loaded; }
        let text = try bytes_to_str(loaded.bytes) catch nil;
        if text == nil { return _error("secure file is not valid UTF-8"); }
        return map{ ok: true, missing: false, text: text, size: loaded.size };
    }
    let listed = _list_backend(parent.fs, "root", 4096);
    if not listed.ok { _close(parent.fs); return _error("secure parent directory cannot be listed"); }
    let found = false; let i = 0;
    while i < len(listed.entries) { if listed.entries[i] == parent.name { found = true; } i = i + 1; }
    if not found { _close(parent.fs); return map{ ok: true, missing: true }; }
    let loaded = _read_backend(parent.fs, parent.name, max_bytes);
    _close(parent.fs);
    if not loaded.ok { return loaded; }
    let text = try bytes_to_str(loaded.bytes) catch nil;
    if text == nil { return _error("secure file is not valid UTF-8"); }
    return map{ ok: true, missing: false, text: text, size: loaded.size };
}

fn _immutable_reader_valid(reader) {
    return type(reader) == "map"
        and (try reader.format catch "") == "pblang.secure-file.immutable-reader.v1"
        and (try reader.ok catch false) and (try reader.active catch false)
        and type(try reader.fs catch nil) == "map"
        and type(try reader.snapshot catch nil) == "map"
        and (try reader.snapshot.active catch false)
        and (try reader.snapshot.immutable catch false);
}

// Open one bounded file once and freeze its bytes in a sealed kernel-backed
// snapshot. This high-level handle is intentionally Linux-only until the
// Windows and macOS backends can provide equivalent immutable snapshots.
fn open_immutable_reader(path, max_bytes, private_parent = false) {
    if platform() != "linux" {
        return _error("immutable secure readers currently require Linux");
    }
    if type(max_bytes) != "number" or max_bytes != num_floor(max_bytes)
       or max_bytes < 1 or max_bytes > 268435456 {
        return _error("invalid immutable reader byte limit");
    }
    let parent = _open_parent(path, false, private_parent); if not parent.ok { return parent; }
    let snapshot = LinuxDirFS.sealed_snapshot_file_descriptor(parent.fs,
        parent.name, max_bytes);
    if not snapshot.ok { _close(parent.fs); return snapshot; }
    return map{ok:true,format:"pblang.secure-file.immutable-reader.v1",
        active:true,fs:parent.fs,snapshot:snapshot,path:path,size:snapshot.size,
        backend:"linux-sealed-memfd",descriptor_bound:true,nofollow:true,
        immutable:true,bounded_memory:true,path_reopened:false};
}

fn immutable_reader_base64_sha256(reader, offset = 0, count = nil) {
    if not _immutable_reader_valid(reader) {
        return _error("immutable secure reader is invalid or closed");
    }
    return LinuxDirFS.held_base64_sha256(reader.fs, reader.snapshot, offset, count);
}

fn immutable_reader_range(reader, offset, count) {
    if not _immutable_reader_valid(reader) {
        return _error("immutable secure reader is invalid or closed");
    }
    return LinuxDirFS.read_held_range_bytes(reader.fs, reader.snapshot, offset, count);
}

fn immutable_reader_magic_offsets(reader, magic, max_matches = 128) {
    if not _immutable_reader_valid(reader) {
        return _error("immutable secure reader is invalid or closed");
    }
    return LinuxDirFS.held_magic_offsets(reader.fs, reader.snapshot,
        magic, max_matches);
}

fn publish_immutable_reader_range(reader, output, offset, count,
                                  private_parent = false, executable = false) {
    if not _immutable_reader_valid(reader) or type(output) != "string"
       or output == "" or len(output) > MAX_PATH or type(executable) != "bool" {
        return _error("invalid immutable reader publication request");
    }
    let destination = _open_parent(output, false, private_parent);
    if not destination.ok { return destination; }
    let result = LinuxDirFS.copy_held_range_new_atomic(reader.fs, reader.snapshot,
        destination.fs, destination.name, offset, count, false, executable);
    _close(destination.fs);
    return result;
}

fn publish_immutable_reader_range_private(reader, output, offset, count,
                                          executable = false) {
    if not _immutable_reader_valid(reader) or type(output) != "string"
       or output == "" or len(output) > MAX_PATH or type(executable) != "bool"
       or platform() != "linux" {
        return _error("invalid private immutable reader publication request");
    }
    let destination = _open_parent(output, false, false);
    if not destination.ok { return destination; }
    let policy = LinuxDirFS.private_root_status(destination.fs);
    if type(policy) != "map" or not policy.ok {
        _close(destination.fs);
        return _error("output parent must already be current-UID-owned mode 0700");
    }
    let result = LinuxDirFS.copy_held_range_new_atomic(reader.fs, reader.snapshot,
        destination.fs, destination.name, offset, count, false, executable);
    _close(destination.fs);
    if type(result) == "map" and result.ok {
        result.private_parent_verified = true;
        result.parent_owned_by_current_uid = true;
        result.parent_mode = "700";
    }
    return result;
}

fn publish_immutable_reader_range_private_temp(reader, output, offset, count,
                                               executable = false) {
    let parts = _parts(output);
    if parts == nil or not parts.absolute or
       path_dirname(parts.parent) != "/tmp" or path_basename(parts.parent) == "tmp" {
        return _error("temporary private output must be one dedicated child below /tmp");
    }
    let temporary_root = LinuxDirFS.open_absolute("/tmp", false, false);
    if not temporary_root.ok {
        return _error("temporary container cannot be opened securely");
    }
    let temporary_meta = LinuxDirFS.metadata(temporary_root, "root");
    let temporary_closed = LinuxDirFS.close(temporary_root);
    if type(temporary_meta) != "map" or not temporary_meta.ok or
       temporary_meta.kind != "directory" or bit_and(temporary_meta.mode, 512) == 0 or
       type(temporary_closed) != "bool" or not temporary_closed {
        return _error("temporary container must be a held sticky directory");
    }
    let result = publish_immutable_reader_range_private(reader, output,
        offset, count, executable);
    if type(result) == "map" and result.ok {
        result.sticky_temporary_container_verified = true;
        result.temporary_container = "/tmp";
        result.post_return_other_uid_replacement_blocked = true;
    }
    return result;
}

fn create_private_directory_new(path) {
    if platform() != "linux" or type(path) != "string" or path == ""
       or path == "." or path == "/" or len(path) > MAX_PATH
       or str_contains(path, strfromcharcode(0)) {
        return _error("invalid private directory path");
    }
    let parent = _open_parent(path, false, false);
    if not parent.ok { return _error("private directory parent is unavailable"); }
    let created = LinuxDirFS.mkdir_new(parent.fs, parent.name, false);
    _close(parent.fs);
    if type(created) != "map" or not created.ok {
        return _error("private directory must be newly created");
    }
    let fs = if str_starts_with(path, "/") {
        LinuxDirFS.open_absolute(path, false, false)
    } else { LinuxDirFS.open(path, false, false) };
    if not fs.ok { return _error("new private directory cannot be reopened securely"); }
    let policy = LinuxDirFS.private_root_status(fs);
    let closed = LinuxDirFS.close(fs);
    if type(policy) != "map" or not policy.ok or
       type(closed) != "bool" or not closed {
        return _error("private directory ownership or mode cannot be verified");
    }
    return map{ok:true,path:path,created:true,exclusive_create:true,
        descriptor_bound:true,owned_by_current_uid:true,mode:"700"};
}

fn private_directory_status(path) {
    if platform() != "linux" or type(path) != "string" or path == ""
       or path == "." or path == "/" or len(path) > MAX_PATH
       or not str_starts_with(path, "/") or str_contains(path, strfromcharcode(0)) {
        return map{ ok: false, ready: false, reason: "invalid-private-directory-path" };
    }
    let fs = LinuxDirFS.open_absolute(path, false, false);
    if not fs.ok {
        return map{ ok: false, ready: false, reason: "private-directory-unavailable" };
    }
    let policy = LinuxDirFS.private_root_status(fs);
    let closed = LinuxDirFS.close(fs);
    if not policy.ok or not closed {
        return map{ ok: false, ready: false,
            reason: "private-directory-ownership-or-mode-unverified" };
    }
    return map{ ok: true, ready: true, reason: "verified",
        owned_by_current_uid: true, mode: "700", path_exposed: false };
}

fn close_immutable_reader(reader) {
    if type(reader) != "map"
       or (try reader.format catch "") != "pblang.secure-file.immutable-reader.v1" {
        return _error("immutable secure reader is invalid");
    }
    if not (try reader.active catch false) {
        return map{ok:true,closed:true,already_closed:true};
    }
    let snapshot_closed = try LinuxDirFS.close_child_descriptor(reader.fs,
        reader.snapshot) catch false;
    let parent_closed = try LinuxDirFS.close(reader.fs) catch false;
    reader.active = false; reader.close_attempted = true;
    return map{ok:snapshot_closed and parent_closed,closed:true,
        ownership_consumed:true,retryable:false,
        snapshot_close_ok:snapshot_closed,parent_close_ok:parent_closed};
}

fn write_atomic(path, bytes, create_parent = true, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if type(bytes) != "array" { return _error("secure file bytes must be an array"); }
    let parent = _open_parent(path, create_parent, private_parent); if not parent.ok { return parent; }
    let result = _write_atomic_backend(parent.fs, parent.name, bytes);
    _close(parent.fs); return result;
}

fn write_text_atomic(path, text, create_parent = true, private_parent = false) {
    if type(text) != "string" { return _error("secure file text must be a string"); }
    return write_atomic(path, str_to_bytes(text), create_parent, private_parent);
}

fn write_new_exclusive(path, bytes, create_parent = true, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    if type(bytes) != "array" { return _error("secure file bytes must be an array"); }
    let parent = _open_parent(path, create_parent, private_parent); if not parent.ok { return parent; }
    let result = _write_new_backend(parent.fs, parent.name, bytes);
    _close(parent.fs); return result;
}

fn write_text_new_exclusive(path, text, create_parent = true, private_parent = false) {
    if type(text) != "string" { return _error("secure file text must be a string"); }
    return write_new_exclusive(path, str_to_bytes(text), create_parent, private_parent);
}

// Cooperating local writers append one complete UTF-8 record by holding a
// stable sibling flock, reading the old value within a byte ceiling, and
// atomically replacing the target. The private parent is mandatory: this API
// is for persistent application state, not shared/removable filesystems.
fn append_text_bounded_locked(path, text, max_bytes = 4194304, timeout_ms = 2000) {
    if platform() != "linux" { return _error("locked atomic append requires Linux"); }
    if type(text) != "string" or text == "" { return _error("append text must be non-empty UTF-8"); }
    if type(max_bytes) != "number" or max_bytes != num_floor(max_bytes)
       or max_bytes < 1 or max_bytes > 67108864 {
        return _error("invalid locked append byte limit");
    }
    if type(timeout_ms) != "number" or timeout_ms != num_floor(timeout_ms)
       or timeout_ms < 0 or timeout_ms > 300000 {
        return _error("invalid locked append timeout");
    }
    let parts = _parts(path);
    if parts == nil or not parts.absolute or len(parts.name) + len(".lock") > 255 {
        return _error("locked append requires a bounded absolute application-state path");
    }
    let addition = str_to_bytes(text);
    if len(addition) > max_bytes { return _error("append text exceeds the byte limit"); }

    let parent = _open_parent(path, true, true);
    if not parent.ok { return parent; }
    let lock = LinuxDirFS.acquire_lock(parent.fs, parent.name + ".lock", timeout_ms, 10, true);
    if not lock.ok {
        let closed_without_lock = _close(parent.fs);
        return map{ ok: false, error: try lock.error catch "exclusive lock unavailable",
            timeout: try lock.timeout catch false, published: false,
            retry_safe: closed_without_lock, target_unchanged: true };
    }

    let operation = LinuxDirFS.write_new_atomic(parent.fs, parent.name, addition, false);
    if operation.ok {
        operation.published = true;
        operation.retry_safe = false;
        operation.locked_atomic_replacement = true;
        operation.cooperative_local_lock = true;
        operation.final_bytes = len(addition);
    } elif try operation.published catch false {
        operation.retry_safe = false;
        operation.locked_atomic_replacement = true;
        operation.cooperative_local_lock = true;
        operation.final_bytes = len(addition);
    } else {
        let metadata = LinuxDirFS.metadata(parent.fs, parent.name);
        if not metadata.ok or metadata.kind != "file"
           or not metadata.owner_current_user or metadata.link_count != 1 {
            operation = map{ ok: false,
                error: "existing state must be an owned single-link regular file",
                published: false, retry_safe: true };
        } else {
            let loaded = _read_backend(parent.fs, parent.name, max_bytes);
            if not loaded.ok {
                operation = map{ ok: false,
                    error: try loaded.error catch "bounded state read failed",
                    published: false, retry_safe: true };
            } else {
                let decoded = try bytes_to_str(loaded.bytes) catch nil;
                if decoded == nil {
                    operation = map{ ok: false, error: "existing state is not valid UTF-8",
                        published: false, retry_safe: true };
                } else {
                    let old = str(decoded);
                let combined = str_to_bytes(old + text);
                if len(combined) > max_bytes {
                        operation = map{ ok: false,
                            error: "locked append would exceed the byte limit",
                            published: false, retry_safe: true };
                } else {
                    operation = _write_atomic_backend(parent.fs, parent.name, combined);
                    operation.published = operation.ok or (try operation.published catch false);
                    operation.retry_safe = not operation.published;
                    operation.locked_atomic_replacement = true;
                    operation.cooperative_local_lock = true;
                    operation.final_bytes = len(combined);
                }
                }
            }
        }
    }

    let released = LinuxDirFS.release_lock(parent.fs, lock);
    let closed = _close(parent.fs);
    if not released or not closed {
        let was_published = try operation.published catch false;
        return map{ ok: false, error: "locked append cleanup could not be verified",
            published: was_published, retry_safe: not was_published and closed,
            lock_released: released, root_closed: closed,
            final_bytes: try operation.final_bytes catch nil };
    }
    operation.lock_released = true;
    operation.root_closed = true;
    return operation;
}

fn _cas_expectation(value) {
    if type(value) != "map" or len(value) != 3
       or not map_has(value, "kind") or not map_has(value, "algorithm")
       or not map_has(value, "sha256") {
        return nil;
    }
    if value.kind == "missing" and value.algorithm == "none" and value.sha256 == "" {
        return value;
    }
    if value.kind == "present" and value.algorithm == RAW_SHA256_ALGORITHM
       and type(value.sha256) == "string"
       and regex_match(value.sha256, "^[0-9a-f]{64}$") {
        return value;
    }
    return nil;
}

fn _entry_exists(fs, name) {
    let listed = LinuxDirFS.list(fs, "root", 4096);
    if not listed.ok or listed.truncated { return nil; }
    for entry in listed.entries { if entry == name { return true; } }
    return false;
}

fn _valid_bytes(value) {
    if type(value) != "array" { return false; }
    for byte in value {
        if type(byte) != "number" or byte != num_floor(byte) or byte < 0 or byte > 255 {
            return false;
        }
    }
    return true;
}

fn _finish_locked(fs, lock, result) {
    let released = LinuxDirFS.release_lock(fs, lock);
    let closed = LinuxDirFS.close(fs);
    if not released or not closed {
        return map{ ok:false, error:"private transaction cleanup unverified",
            published:try result.published catch false,
            consumed:try result.consumed catch false,
            retry_safe:not (try result.published catch false)
                and not (try result.consumed catch false) and closed,
            lock_released:released, root_closed:closed };
    }
    result.lock_released = true; result.root_closed = true;
    return result;
}

// Cooperative CAS for current-UID-owned mode-0700 application state. This is
// not an adversarial shared-workspace primitive: every legitimate writer must
// honor the sibling flock. The digest is always over the exact raw bytes.
fn private_compare_and_swap(path, expectation, replacement,
                            max_bytes = 4194304, timeout_ms = 2000) {
    if platform() != "linux" or type(path) != "string" or not str_starts_with(path, "/")
       or not _valid_bytes(replacement)
       or type(max_bytes) != "number" or max_bytes != num_floor(max_bytes)
       or max_bytes < 1 or max_bytes > 67108864
       or type(timeout_ms) != "number" or timeout_ms != num_floor(timeout_ms)
       or timeout_ms < 0 or timeout_ms > 300000 {
        return _error("invalid private CAS request");
    }
    if len(replacement) > max_bytes { return _error("private CAS replacement exceeds byte limit"); }
    let expected = _cas_expectation(expectation);
    if expected == nil { return _error("invalid private CAS expectation"); }
    let parts = _parts(path);
    if parts == nil or len(parts.name) + len(".lock") > 255 {
        return _error("invalid private CAS path");
    }
    let parent = _open_parent(path, false, true);
    if not parent.ok { return _error("private CAS parent unavailable"); }
    let lock = LinuxDirFS.acquire_lock(parent.fs, parts.name + ".lock", timeout_ms, 10, true);
    if not lock.ok or not (try lock.private_mode_verified catch false) {
        if try lock.ok catch false { LinuxDirFS.release_lock(parent.fs, lock); }
        LinuxDirFS.close(parent.fs);
        return _error("private CAS lock unavailable or not mode-0600");
    }
    let exists = _entry_exists(parent.fs, parts.name);
    if exists == nil {
        return _finish_locked(parent.fs, lock,
            map{ok:false,error:"private CAS namespace cannot be enumerated",published:false,retry_safe:true});
    }
    if expected.kind == "missing" and exists {
        return _finish_locked(parent.fs, lock,
            map{ok:false,error:"private CAS expected missing target",published:false,retry_safe:true});
    }
    if expected.kind == "present" and not exists {
        return _finish_locked(parent.fs, lock,
            map{ok:false,error:"private CAS expected existing target",published:false,retry_safe:true});
    }
    if expected.kind == "present" {
        let metadata = LinuxDirFS.metadata(parent.fs, parts.name);
        if not metadata.ok or metadata.kind != "file"
           or not metadata.owner_current_user or metadata.link_count != 1 {
            return _finish_locked(parent.fs, lock,
                map{ok:false,error:"private CAS target is not an owned single-link regular file",published:false,retry_safe:true});
        }
        let loaded = LinuxDirFS.read_bytes(parent.fs, parts.name, max_bytes);
        if not loaded.ok {
            return _finish_locked(parent.fs, lock,
                map{ok:false,error:"private CAS bounded read failed",published:false,retry_safe:true});
        }
        let current = SHA256.sha256_hex_bytes(loaded.bytes);
        if current != expected.sha256 {
            return _finish_locked(parent.fs, lock,
                map{ok:false,error:"private CAS digest mismatch",published:false,retry_safe:true,
                    digest_algorithm:RAW_SHA256_ALGORITHM});
        }
    }
    let written = if expected.kind == "missing" {
        LinuxDirFS.write_new_atomic(parent.fs, parts.name, replacement, false)
    } else { LinuxDirFS.write_atomic(parent.fs, parts.name, replacement, false) };
    let published = (try written.ok catch false) or (try written.published catch false);
    if not published {
        return _finish_locked(parent.fs, lock,
            map{ok:false,error:"private CAS publication failed",published:false,retry_safe:true});
    }
    let verified = LinuxDirFS.read_bytes(parent.fs, parts.name, max_bytes);
    let replacement_metadata = LinuxDirFS.metadata(parent.fs, parts.name);
    let replacement_sha256 = SHA256.sha256_hex_bytes(replacement);
    let readback_ok = verified.ok and verified.size == len(replacement)
        and SHA256.sha256_hex_bytes(verified.bytes) == replacement_sha256
        and replacement_metadata.ok and replacement_metadata.kind == "file"
        and replacement_metadata.owner_current_user and replacement_metadata.link_count == 1
        and bit_and(replacement_metadata.mode, 511) == 384;
    let result = map{ok:written.ok and readback_ok,
        error:if readback_ok { try written.error catch "" } else { "private CAS readback verification failed" },
        published:true,retry_safe:false,cooperative_only:true,private_parent_verified:true,
        digest_algorithm:RAW_SHA256_ALGORITHM,replacement_sha256:replacement_sha256,
        readback_verified:readback_ok,durability_verified:try written.durability_verified catch false};
    return _finish_locked(parent.fs, lock, result);
}

// Durably consume one request nonce before any target effect. The nonce itself
// is never stored; its raw-text SHA-256 names a mode-0600 receipt below a held
// private root. Any uncertain post-publication result is treated as consumed.
fn consume_nonce_once(state_root, nonce, request_sha256, timeout_ms = 2000) {
    if platform() != "linux" or type(state_root) != "string"
       or not str_starts_with(state_root, "/") or state_root == "/"
       or type(nonce) != "string" or not regex_match(nonce, "^[0-9a-f]{64}$")
       or type(request_sha256) != "string"
       or not regex_match(request_sha256, "^[0-9a-f]{64}$")
       or type(timeout_ms) != "number" or timeout_ms != num_floor(timeout_ms)
       or timeout_ms < 0 or timeout_ms > 300000 {
        return _error("invalid nonce-consumption request");
    }
    let fs = LinuxDirFS.open_absolute(state_root, false, false);
    if not fs.ok { return _error("private nonce root unavailable"); }
    let policy = LinuxDirFS.private_root_status(fs);
    if not policy.ok { LinuxDirFS.close(fs); return _error("private nonce root policy unverified"); }
    let lock = LinuxDirFS.acquire_lock(fs, ".pbide-broker.lock", timeout_ms, 10, true);
    if not lock.ok or not (try lock.private_mode_verified catch false) {
        if try lock.ok catch false { LinuxDirFS.release_lock(fs, lock); }
        LinuxDirFS.close(fs);
        return _error("private nonce lock unavailable or not mode-0600");
    }
    let nonce_digest = SHA256.sha256_hex(nonce);
    let name = "nonce-" + nonce_digest + ".json";
    let exists = _entry_exists(fs, name);
    if exists == nil {
        return _finish_locked(fs, lock,
            map{ok:false,error:"nonce namespace cannot be enumerated",consumed:false,published:false,retry_safe:true});
    }
    let receipt = json_stringify(map{format:"pbide.nonce-receipt.v1",
        nonce_digest:nonce_digest,request_sha256:request_sha256,
        digest_algorithm:RAW_SHA256_ALGORITHM});
    if exists {
        let prior_metadata = LinuxDirFS.metadata(fs, name);
        let prior = LinuxDirFS.read_bytes(fs, name, len(str_to_bytes(receipt)));
        let prior_text = if prior.ok { try bytes_to_str(prior.bytes) catch nil } else { nil };
        let receipt_verified = prior_metadata.ok and prior_metadata.kind == "file"
            and prior_metadata.owner_current_user and prior_metadata.link_count == 1
            and bit_and(prior_metadata.mode, 511) == 384 and prior.ok
            and prior_text == receipt;
        if receipt_verified {
            return _finish_locked(fs, lock,
                map{ok:false,error:"nonce already consumed",consumed:true,published:true,
                    receipt_verified:true,evidence_indeterminate:false,retry_safe:false,
                    nonce_digest:nonce_digest,digest_algorithm:RAW_SHA256_ALGORITHM});
        }
        return _finish_locked(fs, lock,
            map{ok:false,error:"nonce namespace occupied by unverifiable receipt",
                consumed:false,published:false,receipt_verified:false,
                evidence_indeterminate:true,namespace_occupied:true,retry_safe:false,
                nonce_digest:nonce_digest,digest_algorithm:RAW_SHA256_ALGORITHM});
    }
    let written = LinuxDirFS.write_new_atomic(fs, name, str_to_bytes(receipt), false);
    let published = (try written.ok catch false) or (try written.published catch false);
    if not published {
        return _finish_locked(fs, lock,
            map{ok:false,error:"nonce receipt publication failed",consumed:false,published:false,retry_safe:true});
    }
    let metadata = LinuxDirFS.metadata(fs, name);
    let loaded = LinuxDirFS.read_bytes(fs, name, len(str_to_bytes(receipt)));
    let loaded_text = if loaded.ok { try bytes_to_str(loaded.bytes) catch nil } else { nil };
    let verified = metadata.ok and metadata.kind == "file" and metadata.owner_current_user
        and metadata.link_count == 1 and bit_and(metadata.mode, 511) == 384 and loaded.ok
        and loaded_text == receipt;
    let result = map{ok:written.ok and verified,
        error:if verified { try written.error catch "" } else { "nonce receipt verification failed" },
        consumed:true,published:true,retry_safe:false,at_most_once:true,
        nonce_burned_before_effect:true,receipt_verified:verified,
        durability_verified:try written.durability_verified catch false,
        nonce_digest:nonce_digest,digest_algorithm:RAW_SHA256_ALGORITHM};
    return _finish_locked(fs, lock, result);
}

fn remove(path, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    let opened_parent = _open_parent(path, false, private_parent);
    if not opened_parent.ok { return opened_parent; }
    let result = map{ ok: false, error: "secure file backend is unavailable" };
    if platform() == "linux" {
        result = LinuxDirFS.remove(opened_parent.fs, opened_parent.name);
    } elif platform() == "windows" {
        result = WindowsDirFS.remove(opened_parent.fs, opened_parent.name);
    } else {
        result = PosixDirFS.remove_file(opened_parent.fs, opened_parent.name);
    }
    _close(opened_parent.fs); return result;
}

fn remove_file(path, private_parent = false) {
    if _backend_name() == "unavailable" { return _error("secure file backend is unavailable"); }
    let parent = _open_parent(path, false, private_parent); if not parent.ok { return parent; }
    let result = _remove_backend(parent.fs, parent.name);
    _close(parent.fs);
    if result.ok {
        result.namespace_absent = true;
        result.absence_evidence = "descriptor-held file-only unlink";
    }
    return result;
}

fn status() {
    let backend_state = available();
    let linux_state = if platform() == "linux" { LinuxDirFS.available() }
        else { map{ ok: false, library_ready: false,
            ffi_library_authority: false, ffi_symbol_contract_verified: false,
            reason: "linux-required" } };
    let unavailable_reason = "";
    if not backend_state.ok {
        if platform() == "linux" {
            unavailable_reason = try linux_state.reason catch "backend-unavailable";
        } else {
            unavailable_reason = try backend_state.reason catch "backend-unavailable";
        }
    }
    return map{ format: "pblang.secure-file.status.v1", available: backend_state.ok,
                component_openat: true, nofollow: true, exclusive_stage: true,
                atomic_renameat: true, exclusive_no_replace_openat: true,
                path_fallback: false, path_fallback_on_linux: false,
                backend: backend_state.backend,
                linux_backend: platform() == "linux", macos_backend: platform() == "macos",
                windows_backend: platform() == "windows",
                private_parent_verification_supported: platform() == "linux",
                private_parent_verified: false,
                private_parent_macos_verified: false,
                private_parent_windows_verified: false,
                cross_platform_private_parent: false,
                immutable_reader_linux: platform() == "linux",
                immutable_reader_streaming_digest: platform() == "linux",
                immutable_reader_atomic_range_publication: platform() == "linux",
                immutable_reader_private_parent_publication: platform() == "linux",
                immutable_reader_private_sticky_temp_publication: platform() == "linux",
                locked_atomic_first_publication_linux_x86_64: platform() == "linux",
                locked_atomic_first_publication_requires_exec: platform() == "linux",
                private_cooperative_cas_supported_linux: platform() == "linux",
                durable_nonce_consumption_supported_linux: platform() == "linux",
                raw_byte_digest_algorithm: RAW_SHA256_ALGORITHM,
                operations_attemptable: if platform() == "linux" {
                        try linux_state.library_ready catch false
                    } else { false },
                ffi_library_authority: try linux_state.ffi_library_authority catch false,
                ffi_symbol_contract_verified: try linux_state.ffi_symbol_contract_verified catch false,
                unavailable_reason: unavailable_reason,
                global_handle_backends: ["linux", "macos", "windows"] };
}

export available, read_bytes, read_text, read_text_prefix, read_optional_text,
       open_immutable_reader, immutable_reader_base64_sha256,
       immutable_reader_range, immutable_reader_magic_offsets,
       publish_immutable_reader_range, publish_immutable_reader_range_private,
       publish_immutable_reader_range_private_temp,
       create_private_directory_new, private_directory_status, close_immutable_reader,
       write_atomic, write_text_atomic, write_new_exclusive, write_text_new_exclusive,
       append_text_bounded_locked, private_compare_and_swap, consume_nonce_once,
       list_directory, remove, remove_file, status;
export RAW_SHA256_ALGORITHM;
