// stdlib/mock.sapp — test doubles (spies, mocks, stubs) for the pblang QA stack.
//
// Complements stdlib:testing.sapp and stdlib:proptest.sapp.
//
//   let M = import("stdlib:mock.sapp");
//   let m = M.mock();
//   m.returns(42);
//   some_consumer(m.callable(1));      // pass a 1-arg callable into code under test
//   m.call_count();                    // 1
//   m.called_with([7]);                // deep-equality check on recorded args
//
// pblang has no variadic functions and an arity mismatch throws, so a mock
// exposes fixed-arity callables fn0..fn4 (all sharing ONE recording state).
// Every call is recorded as an array of its arguments, compared with pblang's
// deep `==`. Behavior precedence per call: throws() > returns_once queue >
// calls_fake impl > returns() default.

// ANY — wildcard sentinel for called_with_match().
let ANY = map{ __mock_any: true };

fn _is_any(v) {
    if type(v) != "map" { return false; }
    return map_has(v, "__mock_any");
}

// _apply(f, args) — call f with args unpacked (no variadic/apply builtin).
fn _apply(f, args) {
    let n = len(args);
    if n == 0 { return f(); }
    if n == 1 { return f(args[0]); }
    if n == 2 { return f(args[0], args[1]); }
    if n == 3 { return f(args[0], args[1], args[2]); }
    if n == 4 { return f(args[0], args[1], args[2], args[3]); }
    return error("mock: callables support up to 4 arguments");
}

// _tail(arr) — arr without its first element (for the returns_once FIFO).
fn _tail(arr) {
    let out = [];
    let i = 1;
    while i < len(arr) { array_push(out, arr[i]); i = i + 1; }
    return out;
}

// _invoke(st, args) — the shared body every callable runs: record, then
// resolve the programmed outcome.
fn _invoke(st, args) {
    array_push(st.calls, args);
    if st.throw_msg != nil {
        array_push(st.rets, nil);
        return error(st.throw_msg);
    }
    let out = nil;
    if len(st.once_queue) > 0 {
        out = st.once_queue[0];
        st.once_queue = _tail(st.once_queue);
    } else {
        if st.impl != nil {
            out = st.impl(args);
        } else {
            out = st.default_return;
        }
    }
    array_push(st.rets, out);
    return out;
}

// _new(impl) — construct a double around a shared state map. `impl` is the
// initial calls_fake body (nil for a plain mock, an adapter for a spy).
fn _new(impl) {
    let st = map{
        calls: [],
        rets: [],
        once_queue: [],
        default_return: nil,
        throw_msg: nil,
        impl: impl
    };

    let f0 = fn() { return _invoke(st, []); };
    let f1 = fn(a) { return _invoke(st, [a]); };
    let f2 = fn(a, b) { return _invoke(st, [a, b]); };
    let f3 = fn(a, b, c) { return _invoke(st, [a, b, c]); };
    let f4 = fn(a, b, c, d) { return _invoke(st, [a, b, c, d]); };

    return map{
        // callables
        fn0: f0, fn1: f1, fn2: f2, fn3: f3, fn4: f4,
        fn: f1,
        callable: fn(n) {
            if n == 0 { return f0; }
            if n == 1 { return f1; }
            if n == 2 { return f2; }
            if n == 3 { return f3; }
            if n == 4 { return f4; }
            return error("mock.callable: arity must be 0..4");
        },

        // behavior programming
        returns: fn(v) { st.default_return = v; st.impl = nil; },
        returns_once: fn(v) { array_push(st.once_queue, v); },
        throws: fn(msg) { st.throw_msg = msg; },
        calls_fake: fn(impl_) { st.impl = impl_; },

        // reset
        reset: fn() { st.calls = []; st.rets = []; },
        reset_all: fn() {
            st.calls = []; st.rets = []; st.once_queue = [];
            st.default_return = nil; st.throw_msg = nil; st.impl = nil;
        },

        // inspection
        call_count: fn() { return len(st.calls); },
        called: fn() { return len(st.calls) > 0; },
        called_once: fn() { return len(st.calls) == 1; },
        called_times: fn(n) { return len(st.calls) == n; },
        calls: fn() { return st.calls; },
        return_values: fn() { return st.rets; },
        nth_call: fn(i) {
            if i < 0 or i >= len(st.calls) { return error("mock.nth_call: index out of range"); }
            return st.calls[i];
        },
        last_call: fn() {
            if len(st.calls) == 0 { return error("mock.last_call: never called"); }
            return st.calls[len(st.calls) - 1];
        },
        called_with: fn(args) {
            let i = 0;
            while i < len(st.calls) {
                if st.calls[i] == args { return true; }
                i = i + 1;
            }
            return false;
        },
        called_with_match: fn(pattern) {
            let i = 0;
            while i < len(st.calls) {
                let c = st.calls[i];
                if len(c) == len(pattern) {
                    let ok = true;
                    let j = 0;
                    while j < len(pattern) {
                        if _is_any(pattern[j]) == false and c[j] != pattern[j] {
                            ok = false;
                            j = len(pattern);
                        } else {
                            j = j + 1;
                        }
                    }
                    if ok { return true; }
                }
                i = i + 1;
            }
            return false;
        }
    };
}

// mock() — a plain mock (returns nil until programmed).
fn mock() { return _new(nil); }

// spy(realfn, arity) — a double that passes calls through to `realfn` (of the
// given arity) while recording args and return values. Use the matching
// callable, e.g. spy(add, 2).callable(2).
fn spy(realfn, arity) {
    let d = _new(fn(args) { return _apply(realfn, args); });
    return d;
}

// stub(obj, method, replacement) — swap a map-object's method for
// `replacement`; returns a restore() closure that puts the original back.
fn stub(obj, method, replacement) {
    let original = obj[method];
    obj[method] = replacement;
    return fn() { obj[method] = original; };
}

export ANY, mock, spy, stub;
