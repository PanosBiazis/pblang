// percentile(times, p) — linearly interpolated percentile for p in 0..100.
// The input is never mutated. Empty samples return nil.
fn percentile(times, p) {
    let n = len(times);
    if n == 0 { return nil; }
    let sorted = array_sort(times);
    if p <= 0 { return sorted[0]; }
    if p >= 100 { return sorted[n - 1]; }
    let rank = (p / 100.0) * (n - 1);
    let lo = num_floor(rank); let hi = lo + 1;
    if hi >= n { return sorted[n - 1]; }
    let fraction = rank - lo;
    return sorted[lo] + fraction * (sorted[hi] - sorted[lo]);
}

fn _median_sorted(sorted) {
    let n = len(sorted);
    if n == 0 { return nil; }
    let mid = num_floor(n / 2);
    if num_mod(n, 2) == 1 { return sorted[mid]; }
    return (sorted[mid - 1] + sorted[mid]) / 2.0;
}

// stats(label, times) — robust summary statistics for timing samples (ms).
// Pure and deterministic. MAD/IQR/outlier count and CV-based stability make
// noisy benchmark evidence explicit instead of hiding it behind one average.
fn stats(label, times) {
    let sorted = array_sort(times);
    let n = len(sorted);
    if n == 0 {
        return map{ label: label, iterations: 0, total_ms: 0, avg_ms: 0, median_ms: 0,
                    min_ms: 0, max_ms: 0, stddev_ms: 0, p50_ms: 0, p90_ms: 0,
                    p95_ms: 0, p99_ms: 0, mad_ms: 0, iqr_ms: 0, cv_percent: 0,
                    outlier_count: 0, stability: "insufficient" };
    }
    let total = 0.0;
    let j = 0;
    while j < n { total = total + sorted[j]; j = j + 1; }
    let mean = total / n;
    let varsum = 0.0;
    let k = 0;
    while k < n { let d = sorted[k] - mean; varsum = varsum + d * d; k = k + 1; }
    let stddev = num_sqrt(varsum / n);
    let median = _median_sorted(sorted);
    let deviations = []; k = 0;
    while k < n { array_push(deviations, num_abs(sorted[k] - median)); k = k + 1; }
    let mad = _median_sorted(array_sort(deviations));
    let q1 = percentile(sorted, 25); let q3 = percentile(sorted, 75);
    let iqr = q3 - q1; let low = q1 - 1.5 * iqr; let high = q3 + 1.5 * iqr;
    let outliers = 0; k = 0;
    while k < n { if sorted[k] < low or sorted[k] > high { outliers = outliers + 1; } k = k + 1; }
    let cv = if mean == 0 { 0 } else { (stddev / mean) * 100.0 };
    let stability = "insufficient";
    if n >= 3 {
        if cv <= 5 { stability = "excellent"; }
        elif cv <= 10 { stability = "stable"; }
        elif cv <= 20 { stability = "noisy"; }
        else { stability = "unstable"; }
    }
    return map{
        label: label,
        iterations: n,
        total_ms: total,
        avg_ms: mean,
        median_ms: median,
        min_ms: sorted[0],
        max_ms: sorted[n - 1],
        stddev_ms: stddev,
        p50_ms: median,
        p90_ms: percentile(sorted, 90),
        p95_ms: percentile(sorted, 95),
        p99_ms: percentile(sorted, 99),
        mad_ms: mad,
        iqr_ms: iqr,
        cv_percent: cv,
        outlier_count: outliers,
        stability: stability,
    };
}

fn run(name, fn_to_bench, iterations = 10) {
    let times = [];
    let i = 0;
    while i < iterations {
        let start = now_ms();
        let _ = fn_to_bench();
        array_push(times, now_ms() - start);
        i = i + 1;
    }
    return stats(name, times);
}

// ops_per_sec(result) — throughput estimate from a stats/run result.
fn ops_per_sec(result) {
    let a = result.avg_ms;
    if a <= 0 { return 0; }
    return 1000.0 / a;
}

// fastest(results) — the result with the smallest avg_ms.
fn fastest(results) {
    if len(results) == 0 { return nil; }
    let best = results[0];
    let i = 1;
    while i < len(results) {
        if results[i].avg_ms < best.avg_ms { best = results[i]; }
        i = i + 1;
    }
    return best;
}

// format(result) — one-line human summary.
fn format(result) {
    let cv = try result.cv_percent catch nil;
    let stability = try result.stability catch nil;
    let quality = "";
    if cv != nil and stability != nil { quality = ", cv " + str(cv) + "%, " + str(stability); }
    return result.label + ": avg " + str(result.avg_ms) + "ms (min " + str(result.min_ms)
         + ", max " + str(result.max_ms) + ", p95 " + str(result.p95_ms)
         + quality
         + ", n=" + str(result.iterations) + ")";
}

fn time(fn_to_bench) {
    let start = now_ms();
    return map{
        result: fn_to_bench(),
        elapsed_ms: now_ms() - start
    };
}

fn warmup(fn_to_bench, count = 5) {
    let i = 0;
    while i < count {
        let _ = fn_to_bench();
        i = i + 1;
    }
}

fn compare(specs) {
    let results = [];
    let i = 0;
    while i < len(specs) {
        let spec = specs[i];
        array_push(results, run(spec["label"], spec["fn"], spec["iterations"]));
        i = i + 1;
    }
    return results;
}

export run;
export time;
export warmup;
export compare;
export percentile, stats, ops_per_sec, fastest, format;
