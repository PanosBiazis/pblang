// stats(label, times) — summary statistics for a list of timing samples (ms).
// Pure and deterministic. Used by run(); also useful directly for tests.
fn stats(label, times) {
    let sorted = array_sort(times);
    let n = len(sorted);
    if n == 0 {
        return map{ label: label, iterations: 0, total_ms: 0, avg_ms: 0, median_ms: 0,
                    min_ms: 0, max_ms: 0, stddev_ms: 0, p95_ms: 0 };
    }
    let total = 0.0;
    let j = 0;
    while j < n { total = total + sorted[j]; j = j + 1; }
    let mean = total / n;
    let varsum = 0.0;
    let k = 0;
    while k < n { let d = sorted[k] - mean; varsum = varsum + d * d; k = k + 1; }
    let stddev = num_sqrt(varsum / n);
    let p95idx = num_floor(0.95 * (n - 1));
    return map{
        label: label,
        iterations: n,
        total_ms: total,
        avg_ms: mean,
        median_ms: sorted[num_floor(n / 2)],   // integer index (was a float index)
        min_ms: sorted[0],
        max_ms: sorted[n - 1],
        stddev_ms: stddev,
        p95_ms: sorted[p95idx],
    };
}

fn run(name, fn_to_bench, iterations = 10) {
    let times = [];
    let i = 0;
    while i < iterations {
        let start = now_ms();
        let _ = fn_to_bench();
        array_push(times, now_ms() - start);
        i = i + 1;
    }
    return stats(name, times);
}

// ops_per_sec(result) — throughput estimate from a stats/run result.
fn ops_per_sec(result) {
    let a = result.avg_ms;
    if a <= 0 { return 0; }
    return 1000.0 / a;
}

// fastest(results) — the result with the smallest avg_ms.
fn fastest(results) {
    if len(results) == 0 { return nil; }
    let best = results[0];
    let i = 1;
    while i < len(results) {
        if results[i].avg_ms < best.avg_ms { best = results[i]; }
        i = i + 1;
    }
    return best;
}

// format(result) — one-line human summary.
fn format(result) {
    return result.label + ": avg " + str(result.avg_ms) + "ms (min " + str(result.min_ms)
         + ", max " + str(result.max_ms) + ", p95 " + str(result.p95_ms)
         + ", n=" + str(result.iterations) + ")";
}

fn time(fn_to_bench) {
    let start = now_ms();
    return map{
        result: fn_to_bench(),
        elapsed_ms: now_ms() - start
    };
}

fn warmup(fn_to_bench, count = 5) {
    let i = 0;
    while i < count {
        let _ = fn_to_bench();
        i = i + 1;
    }
}

fn compare(specs) {
    let results = [];
    let i = 0;
    while i < len(specs) {
        let spec = specs[i];
        array_push(results, run(spec["label"], spec["fn"], spec["iterations"]));
        i = i + 1;
    }
    return results;
}

export run;
export time;
export warmup;
export compare;
export stats, ops_per_sec, fastest, format;
