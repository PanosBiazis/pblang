fn run(name, fn_to_bench, iterations) {
    if iterations == nil { iterations = 10; }
    let times = [];
    let i = 0;
    while i < iterations {
        let start = now_ms();
        let _ = fn_to_bench();
        array_push(times, now_ms() - start);
        i = i + 1;
    }
    let sorted = array_sort(times);
    let total = 0.0;
    let j = 0;
    while j < len(sorted) {
        total = total + sorted[j];
        j = j + 1;
    }
    return map{
        label: name,
        iterations: iterations,
        total_ms: total,
        avg_ms: total / len(sorted),
        median_ms: sorted[len(sorted) / 2],
        min_ms: sorted[0],
        max_ms: sorted[len(sorted) - 1]
    };
}

fn time(fn_to_bench) {
    let start = now_ms();
    return map{
        result: fn_to_bench(),
        elapsed_ms: now_ms() - start
    };
}

fn warmup(fn_to_bench, count) {
    if count == nil { count = 5; }
    let i = 0;
    while i < count {
        let _ = fn_to_bench();
        i = i + 1;
    }
}

fn compare(specs) {
    let results = [];
    let i = 0;
    while i < len(specs) {
        let spec = specs[i];
        array_push(results, run(spec["label"], spec["fn"], spec["iterations"]));
        i = i + 1;
    }
    return results;
}

export run;
export time;
export warmup;
export compare;
