// stdlib/modern_ui.sapp - responsive, declarative application UI in pure PBLang.
//
// The same bounded view tree is independent from a renderer:
//
//   let ui = import("stdlib/modern_ui.sapp");
//   let view = ui.screen([
//       ui.heading("Account"),
//       ui.input("", map{ name: "email", bind: "email" }),
//       ui.button("Save", on_save)
//   ]);
//   ui.run("Account", view);
//
// Native desktop execution compiles to stdlib/gui.sapp. Android, iOS, Web and
// embedded targets receive the same validated, resolved contract through
// compile(); their runtime adapters can consume it without changing app code.

let GUI = import("stdlib/gui.sapp");
let _ANDROID_ADAPTER = nil;
let _WEB_ADAPTER = nil;

let MAX_NODES = 1024;
let MAX_DEPTH = 24;
let MAX_CHILDREN = 256;
let MAX_TEXT = 65536;
let MAX_ACTIONS = 128;
let MAX_ACTION_DEPTH = 8;

fn _android_adapter() {
    if _ANDROID_ADAPTER == nil {
        _ANDROID_ADAPTER = import("stdlib:modern_ui_android.sapp");
    }
    return _ANDROID_ADAPTER;
}

fn _web_adapter() {
    if _WEB_ADAPTER == nil {
        _WEB_ADAPTER = import("stdlib:modern_ui_web.sapp");
    }
    return _WEB_ADAPTER;
}

fn _copy(value) {
    let out = map{};
    if value == nil { return out; }
    if type(value) != "map" { throw "modern_ui options must be a map"; }
    for key in map_keys(value) { out[key] = value[key]; }
    return out;
}

fn _node(kind, options = nil) {
    let out = _copy(options);
    out.kind = kind;
    return out;
}

fn _with_text(kind, value, options = nil) {
    let out = _node(kind, options);
    out.text = str(value);
    return out;
}

fn screen(children, options = nil) {
    let out = _node("screen", options);
    out.children = children;
    return out;
}

fn column(children, options = nil) {
    let out = _node("column", options);
    out.children = children;
    return out;
}

fn row(children, options = nil) {
    let out = _node("row", options);
    out.children = children;
    return out;
}

fn grid(children, options = nil) {
    let out = _node("grid", options);
    out.children = children;
    return out;
}

fn card(children, options = nil) {
    let out = _node("card", options);
    out.children = children;
    return out;
}

fn heading(value, options = nil) { return _with_text("heading", value, options); }

fn text(value, options = nil) { return _with_text("text", value, options); }

fn button(value, onclick = nil, options = nil) {
    let out = _with_text("button", value, options);
    if type(onclick) == "map"
    and (try onclick.format catch "") == "pblang.modern-ui.action.v1" {
        out.action = onclick;
        out.onclick = nil;
    } else {
        out.onclick = onclick;
    }
    return out;
}

fn input(value = "", options = nil) {
    let out = _node("input", options);
    out.value = str(value);
    return out;
}

fn area(value = "", options = nil) {
    let out = _node("area", options);
    out.value = str(value);
    return out;
}

fn toggle(value, checked = false, onchange = nil, options = nil) {
    let out = _with_text("toggle", value, options);
    out.checked = checked;
    out.onchange = onchange;
    return out;
}

fn choice(options_list, selected = 0, onchange = nil, options = nil) {
    let out = _node("choice", options);
    out.options = options_list;
    out.selected = selected;
    out.onchange = onchange;
    return out;
}

fn slider(value = 0, min = 0, max = 100, onchange = nil, options = nil) {
    let out = _node("slider", options);
    out.value = value; out.min = min; out.max = max; out.onchange = onchange;
    return out;
}

fn progress(value = 0, options = nil) {
    let out = _node("progress", options);
    out.value = value;
    return out;
}

fn image(frame = nil, options = nil) {
    let out = _node("image", options);
    out.image = frame;
    return out;
}

fn separator(options = nil) { return _node("separator", options); }

fn spacer(size = 12, options = nil) {
    let out = _node("spacer", options);
    out.size = size;
    return out;
}

// Portable actions are intentionally small and deterministic. Native renderers
// may still use arbitrary PBLang callbacks, while Android and future adapters
// compile this action IR without hidden foreign-language source.

fn action_set_text(target, value) {
    return map{ format: "pblang.modern-ui.action.v1", kind: "set_text",
        target: str(target), value: str(value) };
}

fn action_message(value) {
    return map{ format: "pblang.modern-ui.action.v1", kind: "message",
        value: str(value) };
}

fn action_sequence(actions) {
    return map{ format: "pblang.modern-ui.action.v1", kind: "sequence",
        actions: actions };
}

fn _container(kind) {
    return kind == "screen" or kind == "column" or kind == "row"
    or kind == "grid" or kind == "card";
}

fn _leaf(kind) {
    return kind == "heading" or kind == "text" or kind == "button"
    or kind == "input" or kind == "area" or kind == "toggle"
    or kind == "choice" or kind == "slider" or kind == "progress"
    or kind == "image" or kind == "separator" or kind == "spacer";
}

fn _callable(value) {
    let kind = type(value);
    return value == nil or kind == "fn" or kind == "closure" or kind == "builtin";
}

fn _control_text(value) {
    let i = 0;
    while i < len(value) {
        let code = strcharcodeat(value, i);
        if code < 32 and code != 9 and code != 10 { return true; }
        if code == 127 { return true; }
        i = i + 1;
    }
    return false;
}

fn _validate_action(action, path, depth, state) {
    if depth > MAX_ACTION_DEPTH {
        array_push(state.errors, path + " exceeds maximum action depth");
        return 0;
    }
    state.actions = state.actions + 1;
    if state.actions > MAX_ACTIONS {
        if state.actions == MAX_ACTIONS + 1 {
            array_push(state.errors, "view action limit exceeded");
        }
        return 0;
    }
    if type(action) != "map"
    or (try action.format catch "") != "pblang.modern-ui.action.v1" {
        array_push(state.errors, path + " must be a modern UI action");
        return 0;
    }
    let kind = str(try action.kind catch "");
    if kind == "set_text" {
        let target = str(try action.target catch "");
        if target == "" or len(target) > 128 or _control_text(target) {
            array_push(state.errors, path + ".target is invalid");
        }
        let value = str(try action.value catch "");
        if len(value) > MAX_TEXT { array_push(state.errors, path + ".value is too long"); }
    } elif kind == "message" {
        let value = str(try action.value catch "");
        if len(value) > MAX_TEXT { array_push(state.errors, path + ".value is too long"); }
    } elif kind == "sequence" {
        let actions = try action.actions catch nil;
        if type(actions) != "array" or len(actions) > MAX_ACTIONS {
            array_push(state.errors, path + ".actions is invalid");
            return 0;
        }
        let i = 0;
        while i < len(actions) {
            _validate_action(actions[i], path + ".actions[" + str(i) + "]",
            depth + 1, state);
            i = i + 1;
        }
    } else {
        array_push(state.errors, path + " has unsupported action kind: " + kind);
    }
    return 1;
}

fn _validate_node(node, path, depth, state) {
    if depth > MAX_DEPTH {
        array_push(state.errors, path + " exceeds maximum nesting depth");
        return 0;
    }
    state.count = state.count + 1;
    if state.count > MAX_NODES {
        if state.count == MAX_NODES + 1 { array_push(state.errors, "view node limit exceeded"); }
        return 0;
    }
    if type(node) != "map" {
        array_push(state.errors, path + " must be a view node");
        return 0;
    }
    let kind = str(try node.kind catch "");
    if not _container(kind) and not _leaf(kind) {
        array_push(state.errors, path + " has unsupported kind: " + kind);
        return 0;
    }
    let name = str(try node.name catch "");
    if len(name) > 128 or _control_text(name) { array_push(state.errors, path + " has invalid name"); }
    for key in ["text", "value"] {
        let value = try node[key] catch nil;
        if value != nil and len(str(value)) > MAX_TEXT { array_push(state.errors, path + "." + key + " is too long"); }
    }
    if not _callable(try node.onclick catch nil) { array_push(state.errors, path + ".onclick must be callable"); }
    if not _callable(try node.onchange catch nil) { array_push(state.errors, path + ".onchange must be callable"); }
    let action = try node.action catch nil;
    if action != nil { _validate_action(action, path + ".action", 0, state); }
    for key in ["w", "h", "min_w", "min_h", "gap", "padding", "grow"] {
        let value = try node[key] catch nil;
        if value != nil and (not is_number(value) or value < 0 or value > 8192) {
            array_push(state.errors, path + "." + key + " is invalid");
        }
    }
    if kind == "choice" {
        let values = try node.options catch [];
        if type(values) != "array" or len(values) > 512 { array_push(state.errors, path + ".options is invalid"); }
    }
    if _container(kind) {
        let children = try node.children catch nil;
        if type(children) != "array" {
            array_push(state.errors, path + ".children must be an array");
            return 0;
        }
        if len(children) > MAX_CHILDREN {
            array_push(state.errors, path + " child limit exceeded");
            return 0;
        }
        let i = 0;
        while i < len(children) {
            _validate_node(children[i], path + ".children[" + str(i) + "]", depth + 1, state);
            i = i + 1;
        }
    }
    return 1;
}

fn validate(view) {
    let state = map{ count: 0, actions: 0, errors: [] };
    _validate_node(view, "view", 0, state);
    return map{ ok: len(state.errors) == 0, errors: state.errors,
        nodes: state.count, actions: state.actions };
}

fn targets() {
    return ["native", "desktop", "linux", "windows", "macos",
    "android", "ios", "web", "embedded"];
}

// Public surface modes are deliberately fewer than low-level compilation
// targets. Every mode consumes the same components and view tree.

fn modes() { return ["auto", "desktop", "web", "android"]; }

fn components() {
    return ["screen", "column", "row", "grid", "card", "heading", "text",
    "button", "input", "area", "toggle", "choice", "slider",
    "progress", "image", "separator", "spacer"];
}

fn _target(value) {
    let out = str_lower(str(value));
    if out == "" { return "native"; }
    for candidate in targets() { if out == candidate { return out; } }
    throw "modern_ui unsupported target: " + out;
}

fn _target_executable(target) {
    return target == "native" or target == "desktop" or target == "android"
    or target == "web";
}

fn _target_adapter(target) {
    if target == "android" { return "stdlib/modern_ui_android.sapp"; }
    if target == "web" { return "stdlib/modern_ui_web.sapp"; }
    if target == "native" or target == "desktop" { return "stdlib/gui.sapp"; }
    return target + "-adapter-contract";
}

fn _num(node, key, fallback) {
    let value = try node[key] catch nil;
    if value == nil { return fallback; }
    return num_floor(value);
}

fn _gap(node, profile) { return _num(node, "gap", profile.gap); }

fn _padding(node, profile) { return _num(node, "padding", profile.padding); }

fn _leaf_height(node) {
    let explicit = try node.h catch nil;
    if explicit != nil { return num_floor(explicit); }
    let kind = node.kind;
    if kind == "heading" { return 30; }
    if kind == "text" { return 22; }
    if kind == "button" { return 40; }
    if kind == "input" or kind == "choice" { return 38; }
    if kind == "area" { return 104; }
    if kind == "toggle" { return 28; }
    if kind == "slider" { return 30; }
    if kind == "progress" { return 14; }
    if kind == "image" { return 160; }
    if kind == "separator" { return 2; }
    if kind == "spacer" { return _num(node, "size", 12); }
    return 30;
}

fn _columns(node, profile) {
    let requested = _num(node, "columns", 2);
    if requested < 1 { requested = 1; }
    if requested > 12 { requested = 12; }
    if profile.compact { return 1; }
    if profile.width < 1280 and requested > 2 { return 2; }
    return requested;
}

fn _measure(node, width, profile) {
    if not _container(node.kind) { return _leaf_height(node); }
    let children = node.children;
    let pad = _padding(node, profile);
    let gap = _gap(node, profile);
    if len(children) == 0 { return pad * 2; }
    if node.kind == "row" and (not profile.compact or (try node.responsive catch true) == false) {
        let max_h = 0;
        let each_w = num_floor((width - pad * 2 - gap * (len(children) - 1)) / len(children));
        for child in children {
            let h = _measure(child, each_w, profile);
            if h > max_h { max_h = h; }
        }
        return max_h + pad * 2;
    }
    if node.kind == "grid" {
        let cols = _columns(node, profile);
        let cell_w = num_floor((width - pad * 2 - gap * (cols - 1)) / cols);
        let total = 0;
        let row_max = 0;
        let i = 0;
        while i < len(children) {
            let h = _measure(children[i], cell_w, profile);
            if h > row_max { row_max = h; }
            if i % cols == cols - 1 or i == len(children) - 1 {
                total = total + row_max;
                if i < len(children) - 1 { total = total + gap; }
                row_max = 0;
            }
            i = i + 1;
        }
        return total + pad * 2;
    }
    let total = pad * 2;
    let inner_w = width - pad * 2;
    let i = 0;
    while i < len(children) {
        total = total + _measure(children[i], inner_w, profile);
        if i + 1 < len(children) { total = total + gap; }
        i = i + 1;
    }
    return total;
}

fn _name(node, path) {
    let explicit = str(try node.name catch "");
    if explicit != "" { return explicit; }
    return node.kind + "_" + path;
}

fn _emit_leaf(node, rect, path, out) {
    array_push(out, map{
        kind: node.kind, name: _name(node, path),
        x: rect.x, y: rect.y, w: rect.w, h: rect.h,
        source: node
    });
}

fn _layout_column(node, rect, profile, out, path) {
    let pad = _padding(node, profile);
    let gap = _gap(node, profile);
    let y = rect.y + pad;
    let inner_w = rect.w - pad * 2;
    let i = 0;
    while i < len(node.children) {
        let child = node.children[i];
        let h = _measure(child, inner_w, profile);
        _layout(child, map{ x: rect.x + pad, y: y, w: inner_w, h: h }, profile, out, path + "_" + str(i));
        y = y + h + gap;
        i = i + 1;
    }
}

fn _layout_row(node, rect, profile, out, path) {
    if profile.compact and (try node.responsive catch true) != false {
        _layout_column(node, rect, profile, out, path);
        return 0;
    }
    let pad = _padding(node, profile);
    let gap = _gap(node, profile);
    let n = len(node.children);
    if n == 0 { return 0; }
    let inner_w = rect.w - pad * 2 - gap * (n - 1);
    let each = num_floor(inner_w / n);
    let x = rect.x + pad;
    let i = 0;
    while i < n {
        let width = each;
        if i == n - 1 { width = rect.x + rect.w - pad - x; }
        _layout(node.children[i], map{ x: x, y: rect.y + pad, w: width, h: rect.h - pad * 2 },
        profile, out, path + "_" + str(i));
        x = x + width + gap;
        i = i + 1;
    }
}

fn _layout_grid(node, rect, profile, out, path) {
    let pad = _padding(node, profile);
    let gap = _gap(node, profile);
    let cols = _columns(node, profile);
    let cell_w = num_floor((rect.w - pad * 2 - gap * (cols - 1)) / cols);
    let y = rect.y + pad;
    let i = 0;
    while i < len(node.children) {
        let row_end = i + cols;
        if row_end > len(node.children) { row_end = len(node.children); }
        let row_h = 0;
        let j = i;
        while j < row_end {
            let h = _measure(node.children[j], cell_w, profile);
            if h > row_h { row_h = h; }
            j = j + 1;
        }
        j = i;
        while j < row_end {
            let col = j - i;
            let x = rect.x + pad + col * (cell_w + gap);
            let width = cell_w;
            if col == cols - 1 { width = rect.x + rect.w - pad - x; }
            _layout(node.children[j], map{ x: x, y: y, w: width, h: row_h },
            profile, out, path + "_" + str(j));
            j = j + 1;
        }
        y = y + row_h + gap;
        i = row_end;
    }
}

fn _layout(node, rect, profile, out, path) {
    if not _container(node.kind) {
        _emit_leaf(node, rect, path, out);
        return 0;
    }
    if node.kind == "card" {
        array_push(out, map{ kind: "card", name: _name(node, path), x: rect.x, y: rect.y,
            w: rect.w, h: rect.h, source: node });
        _layout_column(node, rect, profile, out, path);
        return 0;
    }
    if node.kind == "row" { return _layout_row(node, rect, profile, out, path); }
    if node.kind == "grid" { return _layout_grid(node, rect, profile, out, path); }
    return _layout_column(node, rect, profile, out, path);
}

fn _records(view, profile) {
    let out = [];
    _layout(view, map{ x: 0, y: 0, w: profile.width, h: profile.height }, profile, out, "0");
    return out;
}

fn _duplicate_names(records) {
    let seen = map{};
    let errors = [];
    for record in records {
        if map_has(seen, record.name) { array_push(errors, "duplicate widget name: " + record.name); }
        else { seen[record.name] = true; }
    }
    return errors;
}

fn compile(view, options = nil) {
    let checked = validate(view);
    if not checked.ok { throw "invalid modern UI: " + str_join(checked.errors, "; "); }
    let opts = _copy(options);
    let target = _target(try opts.target catch "native");
    let width = try opts.width catch 720;
    let height = try opts.height catch 520;
    let profile = GUI.layout_profile(width, height, opts);
    let records = _records(view, profile);
    let duplicates = _duplicate_names(records);
    if len(duplicates) > 0 { throw "invalid modern UI: " + str_join(duplicates, "; "); }
    return map{
        format: "pblang.modern-ui.bundle.v1",
        target: target,
        executable: _target_executable(target),
        adapter: _target_adapter(target),
        profile: profile,
        view: view,
        records: records,
        source_nodes: checked.nodes,
        capabilities: ["responsive-layout", "theme", "data-binding", "events",
        "portable-actions", "keyboard-focus"],
        limitations: if _target_executable(target) {
            []
        } else { ["target runtime adapter is not linked in this build"] }
    };
}

fn plan(view, options = nil) {
    let bundle = compile(view, options);
    return map{
        format: "pblang.modern-ui.plan.v1",
        target: bundle.target,
        executable: bundle.executable,
        adapter: bundle.adapter,
        widgets: len(bundle.records),
        profile: bundle.profile,
        capabilities: bundle.capabilities,
        limitations: bundle.limitations
    };
}

fn _run_action(form, action) {
    let kind = action.kind;
    if kind == "set_text" {
        let widget = GUI.get(form, action.target);
        if widget == nil { throw "modern_ui action target does not exist: " + action.target; }
        if map_has(widget, "text") { widget.text = action.value; }
        elif map_has(widget, "value") { widget.value = action.value; }
        else { throw "modern_ui action target cannot accept text: " + action.target; }
        form.dirty = true;
    } elif kind == "message" {
        form.last_message = action.value;
        form.dirty = true;
    } else {
        for item in action.actions { _run_action(form, item); }
    }
    return 0;
}

fn _action_callback(action) {
    return fn(form) { _run_action(form, action); };
}

fn _widget(record) {
    let source = record.source;
    let kind = record.kind;
    let out = nil;
    if kind == "card" {
        out = GUI.panel(record.name, record.x, record.y, record.w, record.h, str(try source.title catch ""));
    } elif kind == "heading" or kind == "text" {
        out = GUI.label(record.name, record.x, record.y, str(try source.text catch ""));
    } elif kind == "button" {
        let callback = try source.onclick catch nil;
        let action = try source.action catch nil;
        if callback == nil and action != nil { callback = _action_callback(action); }
        out = GUI.button(record.name, record.x, record.y, record.w, record.h,
        str(try source.text catch record.name), callback);
    } elif kind == "input" {
        out = GUI.textbox(record.name, record.x, record.y, record.w, record.h, str(try source.value catch ""));
    } elif kind == "area" {
        out = GUI.textarea(record.name, record.x, record.y, record.w, record.h, str(try source.value catch ""));
    } elif kind == "toggle" {
        out = GUI.checkbox(record.name, record.x, record.y, str(try source.text catch record.name),
        try source.checked catch false, try source.onchange catch nil);
    } elif kind == "choice" {
        out = GUI.select(record.name, record.x, record.y, record.w, record.h,
        try source.options catch [], try source.selected catch 0, try source.onchange catch nil);
    } elif kind == "slider" {
        out = GUI.slider(record.name, record.x, record.y, record.w, record.h,
        try source.value catch 0, try source.min catch 0, try source.max catch 100,
        try source.onchange catch nil);
    } elif kind == "progress" {
        out = GUI.progress_bar(record.name, record.x, record.y, record.w, record.h, try source.value catch 0);
    } elif kind == "image" {
        out = GUI.image(record.name, record.x, record.y, record.w, record.h, try source.image catch nil);
    } elif kind == "separator" {
        out = GUI.divider(record.name, record.x, record.y, record.w);
    } else {
        out = GUI.spacer(record.name, record.x, record.y, record.w, record.h);
    }
    let binding = try source.bind catch nil;
    if binding != nil { GUI.bind(out, str(binding)); }
    if map_has(source, "enabled") { out.enabled = source.enabled; }
    if map_has(source, "readonly") { out.readonly = source.readonly; }
    if map_has(source, "max_chars") { out.max_chars = source.max_chars; }
    return out;
}

fn _apply_records(form, records) {
    for record in records {
        let widget = GUI.get(form, record.name);
        if widget != nil {
            widget.x = record.x; widget.y = record.y;
            widget.w = record.w; widget.h = record.h;
        }
    }
    form.layout_records = records;
    return form;
}

fn build(name, view, options = nil) {
    let opts = _copy(options);
    let target = _target(try opts.target catch "native");
    if target != "native" and target != "desktop" {
        throw "modern_ui build requires a linked " + target + " runtime adapter; use compile() for its portable contract";
    }
    let bundle = compile(view, opts);
    let form = GUI.form(str(name), bundle.profile.width, bundle.profile.height);
    GUI.set_model(form, try opts.model catch map{});
    let base_theme = str(try opts.theme catch "dark");
    let colors = try opts.palette catch nil;
    GUI.set_palette(form, GUI.custom_palette(base_theme, colors));
    for record in bundle.records { GUI.add(form, _widget(record)); }
    form.modern_ui = map{ view: view, options: opts, target: target };
    GUI.set_layout(form, fn(current, profile) {
        _apply_records(current, _records(view, profile));
    }, opts);
    GUI.relayout(form, form.w, form.h, opts);
    GUI.sync(form);
    return form;
}

fn run(name, view, options = nil) {
    let opts = _copy(options);
    let form = build(name, view, opts);
    if try opts.preview catch false {
        return map{
            kind: "modern-ui", name: str(name), preview: true,
            form: form, widgets: GUI.widget_count(form),
            plan: plan(view, opts)
        };
    }
    GUI.run(form);
    return map{ kind: "modern-ui", name: str(name), preview: false, form: form,
        widgets: GUI.widget_count(form), plan: plan(view, opts) };
}

fn build_android(name, view, options = nil) {
    let opts = _copy(options);
    opts.target = "android";
    let bundle = compile(view, opts);
    return _android_adapter().build(str(name), bundle, opts);
}

fn build_web(name, view, options = nil) {
    let opts = _copy(options);
    opts.target = "web";
    let bundle = compile(view, opts);
    return _web_adapter().build(str(name), bundle, opts);
}

fn preview_web(name, view, options = nil) {
    let opts = _copy(options);
    opts.target = "web";
    let bundle = compile(view, opts);
    return _web_adapter().preview(str(name), bundle, opts);
}

fn serve_web(name, view, options = nil) {
    let opts = _copy(options);
    opts.target = "web";
    let bundle = compile(view, opts);
    return _web_adapter().serve(str(name), bundle, opts);
}

fn export_web(name, view, output, options = nil) {
    let opts = _copy(options);
    opts.target = "web";
    let bundle = compile(view, opts);
    return _web_adapter().export_static(str(name), bundle, output, opts);
}

fn _mode(value) {
    let requested = str_lower(str(value));
    if requested == "gui" or requested == "native" { return "desktop"; }
    if requested == "browser" { return "web"; }
    if requested == "mobile" { return "android"; }
    for candidate in modes() { if requested == candidate { return requested; } }
    throw "modern_ui unsupported surface mode: " + requested;
}

fn _auto_mode(options) {
    let preferred = str_lower(str(try options.prefer catch ""));
    if preferred != "" and preferred != "auto" { return _mode(preferred); }
    let host = str_lower(str(platform()));
    if str_contains(host, "android") { return "android"; }
    if str_contains(host, "linux") or str_contains(host, "windows")
    or str_contains(host, "macos") or str_contains(host, "darwin") {
        return "desktop";
    }
    // Web is the most portable linked adapter when the host has no native
    // window target. This is explicit in the returned plan/result.
    return "web";
}

fn _surface_selection(opts) {
    let requested = _mode(try opts.mode catch "auto");
    let resolved = requested;
    if requested == "auto" { resolved = _auto_mode(opts); }
    let operation = str_lower(str(try opts.operation catch ""));
    if operation == "" {
        if resolved == "android" { operation = "build"; }
        elif try opts.preview catch false { operation = "preview"; }
        else { operation = "run"; }
    }
    let allowed = false;
    if resolved == "desktop" { allowed = operation == "preview" or operation == "run"; }
    elif resolved == "web" {
        allowed = operation == "preview" or operation == "run" or operation == "export";
    } elif resolved == "android" { allowed = operation == "build"; }
    if not allowed {
        throw "modern_ui operation " + operation + " is not valid for " + resolved + " mode";
    }
    let target = resolved;
    if target == "desktop" { target = "native"; }
    return map{
        requested_mode: requested, mode: resolved,
        operation: operation, target: target
    };
}

fn surface_plan(view, options = nil) {
    let opts = _copy(options);
    let selected = _surface_selection(opts);
    let compiled = compile(view, map{
        target: selected.target,
        width: try opts.width catch 720,
        height: try opts.height catch 520
    });
    return map{
        format: "pblang.modern-ui.surface-plan.v1",
        requested_mode: selected.requested_mode, mode: selected.mode,
        operation: selected.operation, target: selected.target,
        adapter: compiled.adapter, executable: compiled.executable,
        shared_components: components(), source_nodes: compiled.source_nodes
    };
}

fn surface(name, view, options = nil) {
    let opts = _copy(options);
    let selected = _surface_selection(opts);
    opts.mode = selected.mode;
    opts.target = selected.target;
    opts.operation = selected.operation;
    if selected.mode == "desktop" {
        opts.preview = selected.operation == "preview";
        return run(name, view, opts);
    }
    if selected.mode == "android" { return build_android(name, view, opts); }
    if selected.operation == "export" {
        let output = str(try opts.output catch "");
        if output == "" { throw "modern_ui web export requires options.output"; }
        return export_web(name, view, output, opts);
    }
    if selected.operation == "preview" { return preview_web(name, view, opts); }
    return serve_web(name, view, opts);
}

export screen, column, row, grid, card;
export heading, text, button, input, area, toggle, choice, slider, progress, image, separator, spacer;
export action_set_text, action_message, action_sequence;
export targets, modes, components, validate, compile, plan, build, run, build_android;
export build_web, preview_web, serve_web, export_web;
export surface_plan, surface;
