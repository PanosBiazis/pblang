// Detached task plans closed over prerequisites; no execution or I/O.
let D=import("stdlib:task_plan.sapp");let Ops=import("stdlib:devops_pipeline.sapp");
fn parse_ids(text) {
 if type(text)!="string" or len(str_to_bytes(text))>1600 {throw "invalid task selection";}
 let parts=str_split(text,",");if len(parts)<1 or len(parts)>32 {throw "invalid selection count";}
 let ids=[];let seen=map{};
 for part in parts {let id=str_trim(part);if len(id)<1 or len(id)>48 or map_has(seen,id) {throw "invalid or repeated task id";}
  for i in range(0,len(id)) {if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",str_slice(id,i,i+1))<0 {throw "invalid task id";}}
  seen[id]=true;array_push(ids,id);
 }return ids;
}
fn extract(doc,targets) {
 let copy=D.copy(doc);let jobs=[];for task in copy.tasks {array_push(jobs,map{id:task.id,needs:task.needs});}
 let selected=Ops.select_jobs(jobs,targets);let wanted=map{};for job in selected {wanted[job.id]=true;}
 let tasks=[];for task in copy.tasks {if map_has(wanted,task.id) {array_push(tasks,task);}}
 copy.tasks=tasks;D.validate(copy);return copy;
}
export parse_ids,extract;
