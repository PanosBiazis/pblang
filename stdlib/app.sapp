// stdlib/app.sapp - one declarative entry point for PBLang applications.
//
// A complete application may be launched in one source line:
//   import("stdlib/app.sapp").run(map{ kind: "cli", handler: fn(ctx) { return "hello"; } });
//
// `preview: true` builds and exercises the same real adapters without opening a
// window or socket. This makes the contract useful to PBIDE, tests, and agents.

let _GUI_MODULE = nil;
let _WEB_MODULE = nil;
let _SECURITY_MODULE = nil;
let _OS_MODULE = nil;
let _DOMAIN_MODULE = nil;
// Pure spec constructors are lightweight and safe to cache at module load.
// Unlike GUI/Web adapters they perform no I/O and are used by a hot helper.
let _APP_TEMPLATES = import("stdlib:app_templates.sapp");

fn _gui_module() {
    if _GUI_MODULE == nil { _GUI_MODULE = import("stdlib/gui.sapp"); }
    return _GUI_MODULE;
}
fn _web_module() {
    if _WEB_MODULE == nil { _WEB_MODULE = import("stdlib/web_framework.sapp"); }
    return _WEB_MODULE;
}
fn _security_module() {
    if _SECURITY_MODULE == nil { _SECURITY_MODULE = import("stdlib/web_security.sapp"); }
    return _SECURITY_MODULE;
}
fn _os_module() {
    if _OS_MODULE == nil { _OS_MODULE = import("stdlib/os.sapp"); }
    return _OS_MODULE;
}
fn _domain_module() {
    if _DOMAIN_MODULE == nil { _DOMAIN_MODULE = import("stdlib:app_domains.sapp"); }
    return _DOMAIN_MODULE;
}

let MAX_WIDGETS = 512;
let MAX_ROUTES = 256;

fn kinds() {
    return [
        "cli", "gui", "web", "rest", "desktop", "fullstack",
        "game", "multimedia", "database", "networking", "automation", "ai", "ml"
    ];
}

fn _is_domain_kind(kind) {
    return kind == "game" or kind == "multimedia" or kind == "database"
        or kind == "networking" or kind == "automation" or kind == "ai" or kind == "ml";
}

fn _valid_kind(kind) {
    return kind == "cli" or kind == "gui" or kind == "web" or kind == "rest"
        or kind == "desktop" or kind == "fullstack" or _is_domain_kind(kind);
}

fn _is_callable(value) {
    let kind = type(value);
    return kind == "fn" or kind == "closure" or kind == "builtin";
}

fn _get(m, key, fallback) {
    if m != nil and is_map(m) and map_has(m, key) { return m[key]; }
    return fallback;
}

fn _clean_text(value, fallback, max_len) {
    let out = fallback;
    if value != nil { out = str(value); }
    if len(out) > max_len { out = str_slice(out, 0, max_len); }
    return out;
}

fn _has_control(s) {
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 32 or c == 127 { return true; }
        i = i + 1;
    }
    return false;
}

fn _valid_route_path(path) {
    if not is_string(path) or len(path) == 0 or len(path) > 1024 { return false; }
    if str_slice(path, 0, 1) != "/" or _has_control(path) { return false; }
    return true;
}

fn _valid_widget_kind(kind) {
    return kind == "label" or kind == "button" or kind == "textbox" or kind == "textarea"
        or kind == "checkbox" or kind == "panel" or kind == "radio" or kind == "select"
        or kind == "slider" or kind == "progress" or kind == "divider" or kind == "spacer"
        or kind == "image" or kind == "cube3d" or kind == "sphere3d";
}

fn validate(spec) {
    let errors = [];
    if not is_map(spec) {
        array_push(errors, "application spec must be a map");
        return map{ ok: false, errors: errors };
    }
    let kind = _get(spec, "kind", "cli");
    if not _valid_kind(kind) {
        array_push(errors, "unsupported application kind: " + str(kind));
    }
    let name = _clean_text(_get(spec, "name", "pblang app"), "pblang app", 128);
    if _has_control(name) { array_push(errors, "name contains control characters"); }

    if kind == "cli" {
        let args = _get(spec, "args", nil);
        if args != nil and not is_array(args) { array_push(errors, "cli args must be an array"); }
        let commands = _get(spec, "commands", map{});
        if not is_map(commands) { array_push(errors, "cli commands must be a map"); }
    }

    if kind == "gui" {
        let width = _get(spec, "width", 640); let height = _get(spec, "height", 420);
        if not is_number(width) or width < 64 or width > 8192 { array_push(errors, "gui width must be 64..8192"); }
        if not is_number(height) or height < 64 or height > 8192 { array_push(errors, "gui height must be 64..8192"); }
        let widgets = _get(spec, "widgets", []);
        if not is_array(widgets) { array_push(errors, "gui widgets must be an array"); }
        elif len(widgets) > MAX_WIDGETS { array_push(errors, "gui widget limit exceeded"); }
        else {
            let wi = 0;
            while wi < len(widgets) {
                let widget = widgets[wi];
                if not is_map(widget) { array_push(errors, "widget " + str(wi) + " must be a map"); }
                else {
                    let widget_kind = _get(widget, "kind", "label");
                    if not _valid_widget_kind(widget_kind) { array_push(errors, "widget " + str(wi) + " has an invalid kind"); }
                    let ww = _get(widget, "w", 220); let wh = _get(widget, "h", 30);
                    if not is_number(ww) or ww < 0 or ww > 8192 { array_push(errors, "widget " + str(wi) + " width is invalid"); }
                    if not is_number(wh) or wh < 0 or wh > 8192 { array_push(errors, "widget " + str(wi) + " height is invalid"); }
                }
                wi = wi + 1;
            }
        }
    }
    if kind == "web" {
        let port = _get(spec, "port", 8080);
        if not is_number(port) or port < 1 or port > 65535 { array_push(errors, "web port must be 1..65535"); }
        let host = _clean_text(_get(spec, "host", "127.0.0.1"), "127.0.0.1", 255);
        if _has_control(host) { array_push(errors, "web host contains control characters"); }
        let local = host == "127.0.0.1" or host == "localhost" or host == "::1";
        if not local and not _get(spec, "allow_public", false) {
            array_push(errors, "public web bind requires allow_public: true");
        }
        let routes = _get(spec, "routes", []);
        if not is_array(routes) { array_push(errors, "web routes must be an array"); }
        elif len(routes) > MAX_ROUTES { array_push(errors, "web route limit exceeded"); }
        else {
            let i = 0;
            while i < len(routes) {
                let r = routes[i];
                if not is_map(r) { array_push(errors, "route " + str(i) + " must be a map"); }
                else {
                    let path = _get(r, "path", "/");
                    if not _valid_route_path(path) { array_push(errors, "route " + str(i) + " has an invalid path"); }
                    let method = str_upper(_clean_text(_get(r, "method", "GET"), "GET", 16));
                    if method != "GET" and method != "POST" and method != "PUT" and method != "PATCH"
                       and method != "DELETE" and method != "OPTIONS" and method != "HEAD" {
                        array_push(errors, "route " + str(i) + " has an invalid method");
                    }
                }
                i = i + 1;
            }
        }
    }
    if kind == "fullstack" {
        let present = 0;
        for component in ["cli", "gui", "web"] {
            let child = _get(spec, component, nil);
            if child != nil {
                present = present + 1;
                if not is_map(child) { array_push(errors, "fullstack " + component + " component must be a map"); }
                else {
                    let child_spec = _component_spec(spec, component, component, true);
                    let child_check = validate(child_spec);
                    let ci = 0;
                    while ci < len(child_check.errors) {
                        array_push(errors, component + ": " + child_check.errors[ci]);
                        ci = ci + 1;
                    }
                }
            }
        }
        if present == 0 { array_push(errors, "fullstack requires cli, gui, or web component"); }
        let start = _get(spec, "start", "cli");
        if start != "cli" and start != "gui" and start != "web" { array_push(errors, "fullstack start must be cli, gui, or web"); }
        if _get(spec, start, nil) == nil { array_push(errors, "fullstack start component is not configured: " + start); }
    }
    if kind == "rest" {
        let action = _get(spec, "action", _get(spec, "handler", nil));
        let routes = _get(spec, "routes", []);
        if not _is_callable(action) and (not is_array(routes) or len(routes) == 0) {
            array_push(errors, "rest requires an action function or explicit routes");
        } else {
            let rest_check = validate(_rest_spec(spec));
            let ri = 0;
            while ri < len(rest_check.errors) {
                array_push(errors, "rest: " + rest_check.errors[ri]);
                ri = ri + 1;
            }
        }
    }
    if kind == "desktop" {
        let desktop_check = validate(_desktop_spec(spec));
        let di = 0;
        while di < len(desktop_check.errors) {
            array_push(errors, "desktop: " + desktop_check.errors[di]);
            di = di + 1;
        }
    }
    if _is_domain_kind(kind) {
        let domain_check = _domain_module().validate(spec);
        let xi = 0;
        while xi < len(domain_check.errors) {
            array_push(errors, kind + ": " + domain_check.errors[xi]);
            xi = xi + 1;
        }
    }
    return map{ ok: len(errors) == 0, errors: errors, kind: kind, name: name };
}

fn plan(spec) {
    let kind = _get(spec, "kind", "cli");
    // Domain plans own their complete validation contract. Delegating before
    // generic validation avoids validating the same action twice on hot paths.
    if _is_domain_kind(kind) {
        let domain = _domain_module().plan(spec);
        return map{
            format: "pblang.app.plan.v1",
            ok: domain.ok, errors: domain.errors,
            kind: kind, name: domain.name,
            preview: domain.preview,
            blocking: domain.will_execute,
            capabilities: domain.capabilities,
            entry: "app.run",
            implementation: "pblang-only domain facade",
            domain: domain
        };
    }
    let checked = validate(spec);
    if kind == "rest" {
        let result = plan(_rest_spec(spec));
        result.ok = checked.ok and result.ok;
        if not checked.ok { result.errors = checked.errors; }
        result.kind = "rest";
        result.adapter = "web";
        return result;
    }
    if kind == "desktop" {
        let result = plan(_desktop_spec(spec));
        result.ok = checked.ok and result.ok;
        if not checked.ok { result.errors = checked.errors; }
        result.kind = "desktop";
        result.adapter = "gui";
        return result;
    }
    let caps = [];
    if kind == "gui" or (kind == "fullstack" and _get(spec, "gui", nil) != nil) { array_push(caps, "gfx"); }
    if kind == "web" or (kind == "fullstack" and _get(spec, "web", nil) != nil) { array_push(caps, "net"); array_push(caps, "http"); }
    let preview = _get(spec, "preview", false);
    let blocking = not preview and (kind == "gui" or kind == "web");
    if kind == "fullstack" {
        let start = _get(spec, "start", "cli");
        blocking = not preview and (start == "gui" or start == "web");
    }
    return map{
        format: "pblang.app.plan.v1",
        ok: checked.ok,
        errors: checked.errors,
        kind: kind,
        name: _clean_text(_get(spec, "name", "pblang app"), "pblang app", 128),
        preview: preview,
        blocking: blocking,
        capabilities: caps,
        entry: "app.run",
        implementation: "pblang-only facade"
    };
}

fn _copy_spec(spec) {
    let out = map{};
    if not is_map(spec) { return out; }
    let keys = map_keys(spec);
    let i = 0;
    while i < len(keys) { out[keys[i]] = spec[keys[i]]; i = i + 1; }
    return out;
}

fn _rest_spec(spec) {
    let out = _copy_spec(spec);
    out.kind = "web";
    let action = _get(spec, "action", _get(spec, "handler", nil));
    let routes = _get(spec, "routes", []);
    if is_array(routes) and len(routes) > 0 {
        out.routes = routes;
    } else if _is_callable(action) {
        let method = str_upper(_clean_text(_get(spec, "method", "GET"), "GET", 16));
        let path = _get(spec, "path", "/");
        out.routes = [map{
            method: method,
            path: path,
            handler: fn(ctx) { return ctx.json(action(ctx)); }
        }];
    }
    return out;
}

fn _desktop_spec(spec) {
    let out = _copy_spec(spec);
    out.kind = "gui";
    return out;
}

fn _component_spec(parent, key, kind, preview) {
    let child = _get(parent, key, map{});
    let out = map{};
    if is_map(child) {
        let keys = map_keys(child);
        let i = 0;
        while i < len(keys) { out[keys[i]] = child[keys[i]]; i = i + 1; }
    }
    out.kind = kind;
    out.preview = preview;
    if not map_has(out, "name") { out.name = _clean_text(_get(parent, "name", "pblang fullstack"), "pblang fullstack", 128) + " " + kind; }
    if kind == "web" {
        if not map_has(out, "host") { out.host = _get(parent, "host", "127.0.0.1"); }
        if not map_has(out, "port") { out.port = _get(parent, "port", 8080); }
        if not map_has(out, "allow_public") { out.allow_public = _get(parent, "allow_public", false); }
    }
    return out;
}

fn _cli_context(spec) {
    let argv = _get(spec, "args", nil);
    if argv == nil { argv = _os_module().script_args(); }
    return map{
        kind: "cli",
        name: _clean_text(_get(spec, "name", "pblang app"), "pblang app", 128),
        args: argv,
        command: if len(argv) > 0 { argv[0] } else { "" },
        has_flag: fn(name) {
            let target = "--" + name; let i = 0;
            while i < len(argv) { if argv[i] == target { return true; } i = i + 1; }
            return false;
        }
    };
}

fn run_cli(spec) {
    let ctx = _cli_context(spec);
    let handler = _get(spec, "handler", nil);
    let commands = _get(spec, "commands", map{});
    if is_map(commands) and ctx.command != "" and map_has(commands, ctx.command) {
        handler = commands[ctx.command];
    }
    if handler == nil { handler = fn(c) { return _get(spec, "message", c.name); }; }
    let value = handler(ctx);
    if not _get(spec, "quiet", false) and value != nil { print value; }
    return map{ kind: "cli", name: ctx.name, args: ctx.args, command: ctx.command, value: value };
}

fn _widget(spec, index, gui) {
    let kind = _get(spec, "kind", "label");
    let name = _clean_text(_get(spec, "name", kind + str(index)), kind + str(index), 128);
    let x = _get(spec, "x", 16);
    let y = _get(spec, "y", 16 + index * 38);
    let w = _get(spec, "w", 220);
    let h = _get(spec, "h", 30);
    let text = _clean_text(_get(spec, "text", name), name, 4096);
    if kind == "label" { return gui.label(name, x, y, text); }
    if kind == "button" { return gui.button(name, x, y, w, h, text, _get(spec, "onclick", nil)); }
    if kind == "textbox" { return gui.textbox(name, x, y, w, h, _clean_text(_get(spec, "value", ""), "", 65536)); }
    if kind == "textarea" { return gui.textarea(name, x, y, w, h, _clean_text(_get(spec, "value", ""), "", 65536)); }
    if kind == "checkbox" { return gui.checkbox(name, x, y, text, _get(spec, "checked", false), _get(spec, "onchange", nil)); }
    if kind == "panel" { return gui.panel(name, x, y, w, h, text); }
    if kind == "radio" { return gui.radio(name, x, y, text, _get(spec, "group", "default"), _get(spec, "selected", false), _get(spec, "onchange", nil)); }
    if kind == "select" { return gui.select(name, x, y, w, h, _get(spec, "options", []), _get(spec, "selected", 0), _get(spec, "onchange", nil)); }
    if kind == "slider" { return gui.slider(name, x, y, w, h, _get(spec, "value", 0), _get(spec, "min", 0), _get(spec, "max", 100), _get(spec, "onchange", nil)); }
    if kind == "progress" { return gui.progress_bar(name, x, y, w, h, _get(spec, "value", 0)); }
    if kind == "divider" { return gui.divider(name, x, y, w); }
    if kind == "spacer" { return gui.spacer(name, x, y, w, h); }
    if kind == "image" { return gui.image(name, x, y, w, h, _get(spec, "image", nil)); }
    if kind == "cube3d" { return gui.cube3d(name, x, y, w, h, text); }
    if kind == "sphere3d" { return gui.sphere3d(name, x, y, w, h, text); }
    throw "unsupported gui widget kind: " + kind;
}

fn build_gui(spec) {
    let gui = _gui_module();
    let existing = _get(spec, "form", nil);
    if existing != nil { return existing; }
    let title = _clean_text(_get(spec, "name", "pblang GUI"), "pblang GUI", 128);
    let form = gui.form(title, _get(spec, "width", 640), _get(spec, "height", 420));
    let model = _get(spec, "model", map{});
    gui.set_model(form, model);
    let widgets = _get(spec, "widgets", []);
    let i = 0;
    while i < len(widgets) {
        let item = _widget(widgets[i], i, gui);
        let field = _get(widgets[i], "bind", nil);
        if field != nil { gui.bind(item, field); }
        gui.add(form, item);
        i = i + 1;
    }
    if _get(spec, "fit", true) { gui.fit_form(form, form.w, form.h, 24); }
    gui.sync(form);
    return form;
}

fn run_gui(spec) {
    let gui = _gui_module();
    let form = build_gui(spec);
    if _get(spec, "preview", false) {
        return map{ kind: "gui", name: form.title, form: form, widgets: gui.widget_count(form), preview: true };
    }
    gui.run(form);
    return map{ kind: "gui", name: form.title, form: form, widgets: gui.widget_count(form), preview: false };
}

fn _route_handler(handler, security, sec) {
    return fn(ctx) { return sec.harden(handler(ctx), security); };
}

fn build_web(spec) {
    let web = _web_module();
    let sec = _security_module();
    let config = map{
        host: _get(spec, "host", "127.0.0.1"),
        port: _get(spec, "port", 8080),
        static_dir: _get(spec, "static_dir", nil),
        view_dir: _get(spec, "view_dir", "./views")
    };
    let app = web.create_app(config);
    let security = _get(spec, "security", sec.strict());
    let routes = _get(spec, "routes", []);
    if len(routes) == 0 {
        let default_handler = _get(spec, "handler", fn(ctx) { return ctx.text(_clean_text(_get(spec, "message", _get(spec, "name", "pblang web app")), "pblang web app", 65536)); });
        web.get(app, "/", _route_handler(default_handler, security, sec));
    } else {
        let i = 0;
        while i < len(routes) {
            let r = routes[i];
            let handler = _get(r, "handler", fn(ctx) { return ctx.status(501).text("route handler not configured"); });
            web.route(app, str_upper(_get(r, "method", "GET")), _get(r, "path", "/"), _route_handler(handler, security, sec));
            i = i + 1;
        }
    }
    let secure_handle = sec.secure(app, security);
    return map{ kind: "web", app: app, handle: secure_handle, security: security, config: config, routes: routes, web: web };
}

fn run_web(spec) {
    let built = build_web(spec);
    if _get(spec, "preview", false) {
        let req = _get(spec, "request", map{ method: "GET", path: "/", headers: map{ "user-agent": "Mozilla/5.0 pblang-preview" }, body: "" });
        return map{ kind: "web", name: _get(spec, "name", "pblang web app"), response: built.handle(req), app: built.app, preview: true };
    }
    if _get(spec, "once", false) { return map{ kind: "web", response: built.web.listen_once(built.app), app: built.app, preview: false }; }
    built.web.listen(built.app);
    return map{ kind: "web", app: built.app, preview: false };
}

fn run_fullstack(spec) {
    let preview = _get(spec, "preview", false);
    let start = _get(spec, "start", "cli");
    let result = map{
        kind: "fullstack",
        name: _clean_text(_get(spec, "name", "pblang fullstack"), "pblang fullstack", 128),
        preview: preview,
        start: start,
        cli: nil,
        gui: nil,
        web: nil
    };

    // Non-selected GUI/web components are built through their real preview
    // paths. The selected surface runs last because it may block.
    if _get(spec, "cli", nil) != nil and (preview or start != "cli") {
        let cli_spec = _component_spec(spec, "cli", "cli", true);
        cli_spec.quiet = true;
        result.cli = run_cli(cli_spec);
    }
    if _get(spec, "gui", nil) != nil and (preview or start != "gui") {
        result.gui = run_gui(_component_spec(spec, "gui", "gui", true));
    }
    if _get(spec, "web", nil) != nil and (preview or start != "web") {
        result.web = run_web(_component_spec(spec, "web", "web", true));
    }

    if not preview {
        if start == "cli" { result.cli = run_cli(_component_spec(spec, "cli", "cli", false)); }
        elif start == "gui" { result.gui = run_gui(_component_spec(spec, "gui", "gui", false)); }
        else { result.web = run_web(_component_spec(spec, "web", "web", false)); }
    }
    return result;
}

fn run(spec) {
    let requested_kind = _get(spec, "kind", "cli");
    // app_domains.run() validates the complete domain contract itself. Keep a
    // single validation pass for frequently dispatched game/automation loops.
    if _is_domain_kind(requested_kind) { return _domain_module().run(spec); }
    let checked = validate(spec);
    if not checked.ok { throw "invalid application: " + str_join(checked.errors, "; "); }
    if checked.kind == "cli" { return run_cli(spec); }
    if checked.kind == "gui" { return run_gui(spec); }
    if checked.kind == "web" { return run_web(spec); }
    if checked.kind == "rest" {
        let result = run_web(_rest_spec(spec));
        result.kind = "rest";
        result.adapter = "web";
        return result;
    }
    if checked.kind == "desktop" {
        let result = run_gui(_desktop_spec(spec));
        result.kind = "desktop";
        result.adapter = "gui";
        return result;
    }
    return run_fullstack(spec);
}

fn _merge_options(base, options) {
    if options == nil { return base; }
    if not is_map(options) { throw "application options must be a map"; }
    let keys = map_keys(options);
    let i = 0;
    while i < len(keys) { base[keys[i]] = options[keys[i]]; i = i + 1; }
    return base;
}

// Compact one-line launchers. These remain thin constructors over run(), so
// validation, public-bind policy, security headers, widget limits, and preview
// adapters cannot diverge from the full declarative API.
fn cli(message, options = nil) {
    return run(_merge_options(map{ kind: "cli", message: message }, options));
}

fn gui(name, widgets, options = nil) {
    return run(_merge_options(map{ kind: "gui", name: name, widgets: widgets }, options));
}

fn web(name, handler, options = nil) {
    return run(_merge_options(map{ kind: "web", name: name, handler: handler }, options));
}

fn fullstack(name, components, options = nil) {
    if not is_map(components) { throw "fullstack components must be a map"; }
    let spec = map{ kind: "fullstack", name: name };
    let keys = map_keys(components);
    let i = 0;
    while i < len(keys) { spec[keys[i]] = components[keys[i]]; i = i + 1; }
    return run(_merge_options(spec, options));
}

fn rest(name, action, options = nil) {
    return run(_merge_options(map{ kind: "rest", name: name, action: action }, options));
}

fn desktop(name, widgets, options = nil) {
    return run(_merge_options(map{ kind: "desktop", name: name, widgets: widgets }, options));
}

fn _domain(name, kind, action, options) {
    return run(_merge_options(map{ kind: kind, name: name, action: action }, options));
}

fn game(name, action, options = nil) { return _domain(name, "game", action, options); }
fn multimedia(name, action, options = nil) { return _domain(name, "multimedia", action, options); }
fn database(name, action, options = nil) { return _domain(name, "database", action, options); }
fn networking(name, action, options = nil) { return _domain(name, "networking", action, options); }
fn automation(name, action, options = nil) { return _domain(name, "automation", action, options); }
fn ai(name, action, options = nil) { return _domain(name, "ai", action, options); }
fn ml(name, action, options = nil) { return _domain(name, "ml", action, options); }

// A complete CLI + native GUI + hardened Web app from one business action.
// The blueprint lives in a separate pblang library to keep this runtime facade
// focused and to make additional templates independently testable.
fn universal(name, action, options = nil) {
    return run(_APP_TEMPLATES.universal_spec(name, action, options));
}

export kinds, validate, plan, run, run_cli, build_gui, run_gui, build_web, run_web, run_fullstack;
export cli, gui, web, rest, desktop, fullstack, universal;
export game, multimedia, database, networking, automation, ai, ml;
