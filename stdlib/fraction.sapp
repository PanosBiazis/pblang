// stdlib/fraction.sapp — exact fractions, an ergonomic wrapper over the
// arbitrary-precision `rational` type. Every result is an exact reduced
// fraction (an integer-valued fraction normalizes to a bigint).
//
//   let fr = import("stdlib:fraction.sapp");
//   fr.add(fr.of(1, 3), fr.of(1, 6))     // 1/2
//   fr.to_mixed(fr.of(7, 3))             // "2 1/3"
//   fr.approximate(3.14159265, 1000)     // 355/113

fn _r(x) { return rational(x); }

// of(n, d) -> n/d ; of("1/3") / of(0.5) -> coerce a single value.
fn of(n, d = nil) {
    if d == nil { return rational(n); }
    return rational(n, d);
}

fn numerator(r) {
    let parts = str_split(str(_r(r)), "/");
    return bigint(parts[0]);
}
fn denominator(r) {
    let parts = str_split(str(_r(r)), "/");
    if len(parts) > 1 { return bigint(parts[1]); }
    return bigint(1);
}

fn add(a, b) { return _r(a) + _r(b); }
fn sub(a, b) { return _r(a) - _r(b); }
fn mul(a, b) { return _r(a) * _r(b); }
fn div(a, b) { return _r(a) / _r(b); }
fn neg(r) { return rational(bigint(0) - numerator(r), denominator(r)); }
fn pow(r, exp) { return _r(r) ** exp; }   // integer exponent (negative allowed)

fn reciprocal(r) {
    let n = numerator(r);
    if n == bigint(0) { return error("fraction: reciprocal of zero"); }
    return rational(denominator(r), n);
}

fn eq(a, b) { return _r(a) == _r(b); }
fn lt(a, b) { return _r(a) < _r(b); }
fn gt(a, b) { return _r(a) > _r(b); }
fn is_integer(r) { return denominator(r) == bigint(1); }
fn is_zero(r) { return numerator(r) == bigint(0); }

// Mixed-number string: 7/3 -> "2 1/3", 6/3 -> "2", 1/3 -> "1/3", -7/3 -> "-2 1/3".
fn to_mixed(r) {
    let n = numerator(r);
    let d = denominator(r);
    let neg = false;
    if n < bigint(0) { neg = true; n = bigint(0) - n; }
    let whole = n / d;
    let rem = n % d;
    let s = "";
    if rem == bigint(0) { s = str(whole); }
    else if whole == bigint(0) { s = str(rem) + "/" + str(d); }
    else { s = str(whole) + " " + str(rem) + "/" + str(d); }
    if neg and s != "0" { s = "-" + s; }
    return s;
}

// Lossy conversion to a float, and exact-ish conversion to a decimal.
fn to_float(r) {
    return parse_number(str(numerator(r))) / parse_number(str(denominator(r)));
}
fn to_decimal(r) { return decimal(_r(r)); }

// Mediant: (n1+n2)/(d1+d2) — lies strictly between a and b (Farey / Stern-Brocot).
fn mediant(a, b) {
    return rational(numerator(a) + numerator(b), denominator(a) + denominator(b));
}

// Best rational approximation of a number with denominator <= max_denom, via
// continued fractions. e.g. approximate(3.14159265, 1000) -> 355/113.
fn approximate(x, max_denom) {
    if max_denom < 1 { max_denom = 1; }
    let neg = false;
    let val = x;
    if val < 0 { neg = true; val = 0 - val; }
    let h0 = 0; let h1 = 1; let k0 = 1; let k1 = 0;
    let iter = 0;
    while iter < 64 {
        let a = num_floor(val);
        let h2 = a * h1 + h0;
        let k2 = a * k1 + k0;
        if k2 > max_denom { break; }
        h0 = h1; h1 = h2; k0 = k1; k1 = k2;
        let frac = val - a;
        if frac <= 0.000000000001 { break; }
        val = 1.0 / frac;
        iter = iter + 1;
    }
    if k1 == 0 { k1 = 1; }
    let nn = h1;
    if neg { nn = 0 - nn; }
    return rational(nn, k1);
}

export of, numerator, denominator, add, sub, mul, div, neg, pow, reciprocal, eq, lt, gt, is_integer, is_zero, to_mixed, to_float, to_decimal, mediant, approximate;
