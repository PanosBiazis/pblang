// Browser renderer for stdlib/modern_ui.sapp, authored in PBLang.
//
// Applications provide only a validated modern_ui view tree. This adapter emits
// the browser artifacts required by the platform, serves them through the
// PBLang web stack, and can export the same deterministic files for static
// hosting. User data is never inserted into executable source.

let Web = import("stdlib:web_framework.sapp");
let Security = import("stdlib:web_security.sapp");
let GUI = import("stdlib/gui.sapp");
let RELEASE_CHANNEL = import("stdlib:release_channel.sapp");
let Validation = import("stdlib:modern_ui_validation.sapp");
let Style = import("stdlib:ui_style.sapp");

let MAX_WEB_NODES = 1024;
let MAX_WEB_ACTIONS = 128;
let MAX_OUTPUT_PATH = 1024;

fn _copy(value) {
    let out = map{};
    if value == nil { return out; }
    if type(value) != "map" { throw "modern_ui_web options must be a map"; }
    for key in map_keys(value) { out[key] = value[key]; }
    return out;
}

fn _escape(value) {
    let out = str(value);
    out = str_replace_all(out, "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    out = str_replace_all(out, "'", "&#39;");
    return out;
}

fn _name(node, path) {
    let explicit = str(try node.name catch "");
    if explicit != "" { return explicit; }
    return node.kind + "_" + path;
}

fn _container(kind) {
    return kind == "screen" or kind == "column" or kind == "row"
    or kind == "grid" or kind == "card";
}

fn _text_control(kind) {
    return kind == "heading" or kind == "text" or kind == "button"
    or kind == "input" or kind == "area" or kind == "toggle"
    or kind == "progress" or kind == "choice";
}

fn _num(value, fallback, minimum, maximum) {
    if value == nil or not is_number(value) { return fallback; }
    let out = num_floor(value);
    if out < minimum { return minimum; }
    if out > maximum { return maximum; }
    return out;
}

fn _decimal(value, fallback, minimum, maximum) {
    if value == nil or not is_number(value) { return fallback; }
    if value < minimum { return minimum; }
    if value > maximum { return maximum; }
    return value;
}

fn _channel(value) { return _num(value, 0, 0, 255); }

fn _color(value) {
    if type(value) == "array" and (len(value) == 3 or len(value) == 4) {
        let r = _channel(value[0]); let g = _channel(value[1]); let b = _channel(value[2]);
        if len(value) == 4 and _channel(value[3]) < 255 {
            return "rgba(" + str(r) + "," + str(g) + "," + str(b) + ","
            + str(_channel(value[3]) / 255.0) + ")";
        }
        return "rgb(" + str(r) + "," + str(g) + "," + str(b) + ")";
    }
    if is_number(value) {
        let packed = _num(value, 0, 0, 16777215);
        if packed <= 255 {
            return "rgb(" + str(packed) + "," + str(packed) + "," + str(packed) + ")";
        }
        let r = num_mod(num_floor(packed / 65536), 256);
        let g = num_mod(num_floor(packed / 256), 256);
        let b = num_mod(packed, 256);
        return "rgb(" + str(r) + "," + str(g) + "," + str(b) + ")";
    }
    throw "modern_ui_web expected an RGB/RGBA palette color";
}

fn _theme(options) {
    let name = str_lower(str(try options.theme catch "dark"));
    if name != "dark" and name != "light" { throw "modern_ui_web theme must be dark or light"; }
    let colors = GUI.custom_palette(name, try options.palette catch nil);
    return map{
        name: name,
        bg: _color(colors.bg), panel: _color(colors.panel),
        field: _color(colors.field), border: _color(colors.border),
        accent: _color(colors.accent), text: _color(colors.text),
        muted: _color(colors.muted)
    };
}

fn _safe_image_source(value) {
    let source = str(value);
    if source == "" { return ""; }
    if len(source) > 4096 or str_contains(source, "\x00") { return ""; }
    if str_starts_with(source, "/") or str_starts_with(source, "./")
    or str_starts_with(source, "../") or str_starts_with(source, "data:image/") {
        return source;
    }
    return "";
}

fn _input_type(value) {
    let kind = str_lower(str(value));
    for allowed in ["text", "email", "password", "search", "url", "tel", "number"] {
        if kind == allowed { return kind; }
    }
    return "text";
}

fn _enabled(node) {
    return try node.enabled catch true;
}

fn _disabled(node) {
    if _enabled(node) { return ""; }
    return " disabled aria-disabled=\"true\"";
}

fn _readonly(node) {
    if try node.readonly catch false { return " readonly"; }
    return "";
}

fn _label(node, fallback) {
    let value = str(try node.accessibility_label catch "");
    if value == "" { value = str(try node.placeholder catch fallback); }
    if value == "" { value = fallback; }
    return value;
}

// Omission/empty labels retain the visible text as the native HTML name.
fn _explicit_label(node) {
    let value=try node.accessibility_label catch "";
    if value=="" {return "";}
    return " aria-label=\""+_escape(value)+"\"";
}

fn _node_rule(node, class_name, state) {
    let rule = "." + class_name + "{";
    let gap = try node.gap catch nil;
    let padding = try node.padding catch nil;
    let grow = try node.grow catch nil;
    let min_w = try node.min_w catch nil;
    let min_h = try node.min_h catch nil;
    let max_w = try node.max_w catch nil;
    let max_h = try node.max_h catch nil;
    if gap != nil { rule = rule + "gap:" + str(_num(gap, 12, 0, 8192)) + "px;"; }
    if padding != nil { rule = rule + "padding:" + str(_num(padding, 0, 0, 8192)) + "px;"; }
    if grow != nil { rule = rule + "flex-grow:" + str(_num(grow, 0, 0, 64)) + ";"; }
    if min_w != nil { rule = rule + "min-width:" + str(_num(min_w, 0, 0, 8192)) + "px;"; }
    if min_h != nil { rule = rule + "min-height:" + str(_num(min_h, 0, 0, 8192)) + "px;"; }
    if max_w != nil { rule = rule + "max-width:" + str(_num(max_w, 8192, 1, 8192)) + "px;"; }
    if max_h != nil { rule = rule + "max-height:" + str(_num(max_h, 8192, 1, 8192)) + "px;"; }
    if node.kind == "grid" {
        let columns = _num(try node.columns catch 2, 2, 1, 12);
        rule = rule + "--pb-columns:" + str(columns)
            + ";grid-template-columns:repeat(var(--pb-columns),minmax(0,1fr));";
    }
    if node.kind == "spacer" {
        rule = rule + "height:" + str(_num(try node.size catch 12, 12, 0, 8192)) + "px;";
    }
    // Fixed semantic roles only; caller strings never become CSS identifiers.
    if node.kind == "button" and (state.custom_palette or map_has(node,"variant")
        or (try node.selected catch false)) {
        let bvar = try node.variant catch "primary";
        let style=Style.button(state.palette,bvar,
            try node.selected catch false,_enabled(node));
        if try state.preset_enhanced catch false {
            let fill_c = _color(style.fill);
            let brd_c = _color(style.border);
            let txt_c = _color(style.text);
            if bvar == "secondary" {
                rule=rule+"background:linear-gradient(180deg,color-mix(in srgb,"+fill_c+" 88%,white 10%) 0%,"+fill_c+" 100%);border-color:color-mix(in srgb,"+brd_c+" 82%,white 18%);color:"+txt_c+";box-shadow:0 4px 14px rgba(0,0,0,.38),inset 0 1px 0 rgba(255,255,255,.09);";
            } elif bvar == "danger" {
                rule=rule+"background:linear-gradient(180deg,color-mix(in srgb,"+fill_c+" 86%,white 14%) 0%,"+fill_c+" 100%);border-color:color-mix(in srgb,"+brd_c+" 78%,white 22%);color:#ffffff;box-shadow:0 8px 22px -4px color-mix(in srgb,"+fill_c+" 58%,rgba(0,0,0,.65)),inset 0 1px 0 rgba(255,255,255,.28);";
            } else {
                rule=rule+"background:linear-gradient(180deg,color-mix(in srgb,"+fill_c+" 88%,white 12%) 0%,"+fill_c+" 100%);border-color:color-mix(in srgb,"+brd_c+" 82%,white 18%);color:"+txt_c+";box-shadow:0 8px 22px -4px color-mix(in srgb,"+fill_c+" 52%,rgba(0,0,0,.58)),inset 0 1px 0 rgba(255,255,255,.26);";
            }
        } else {
            rule=rule+"background:"+_color(style.fill)+";border-color:"+_color(style.border)
                +";color:"+_color(style.text)+";";
        }
    }
    if (node.kind == "text" or node.kind == "heading") and map_has(node,"tone") {
        let fallback=if node.kind == "text" {state.palette.muted} else {state.palette.text};
        rule=rule+"color:"+_color(Style.tone(state.palette,node.tone,fallback))+";";
    }
    if node.kind=="heading" or node.kind=="text" or node.kind=="button" {
        if map_has(node,"font_family") {
            let family=node.font_family;
            if family=="system" {family="system-ui,sans-serif";} elif family=="sans" {family="sans-serif";}
            rule=rule+"font-family:"+family+";";
        }
        if map_has(node,"line_height") {rule=rule+"line-height:"+str(node.line_height)+";";}
        if map_has(node,"font_size") {rule=rule+"font-size:"+str(node.font_size)+"px;";}
        if map_has(node,"font_weight") {rule=rule+"font-weight:"+node.font_weight+";";}
        if map_has(node,"text_align") {rule=rule+"text-align:"+node.text_align+";";}
        if map_has(node,"wrap") {
            if node.wrap {
                rule=rule+"white-space:pre-line;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:"
                    +str(try node.max_lines catch 64)+";overflow:hidden;";
            } else {rule=rule+"white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;";}
        }
    }
    state.rules = state.rules + rule + "}\n";
    if node.kind=="card" {
        let card_rule="";let radius=Style.card_radius(node);
        if radius!=nil {card_rule=card_rule+"border-radius:"+str(radius)+"px;";}
        if map_has(node,"card_variant") {
            let style=Style.card(state.palette,node);
            if try state.preset_enhanced catch false {
                let cfill=_color(style.fill);
                let cbrd=_color(style.border);
                let cvar=str(try node.card_variant catch "surface");
                if cvar=="tonal" {
                    card_rule=card_rule+"background:linear-gradient(145deg,color-mix(in srgb,var(--pb-accent) 15%,var(--pb-panel)) 0%,color-mix(in srgb,var(--pb-panel) 94%,black 6%) 100%);border-color:color-mix(in srgb,var(--pb-accent) 44%,var(--pb-border));";
                } elif cvar=="outlined" {
                    card_rule=card_rule+"background:linear-gradient(165deg,color-mix(in srgb,var(--pb-panel) 88%,black 12%) 0%,color-mix(in srgb,var(--pb-bg) 92%,var(--pb-panel) 8%) 100%);border-color:color-mix(in srgb,"+cbrd+" 85%,white 15%);";
                } else {
                    card_rule=card_rule+"background:linear-gradient(165deg,color-mix(in srgb,"+cfill+" 94%,white 6%) 0%,"+cfill+" 100%);border-color:color-mix(in srgb,"+cbrd+" 84%,white 12%);";
                }
            } else {
                card_rule=card_rule+"background:"+_color(style.fill)+";border-color:"+_color(style.border)+";";
            }
        }
        let depth=try node.card_elevation catch nil;
        if depth!=nil {
            if depth==0 {card_rule=card_rule+"box-shadow:none;";}
            else {card_rule=card_rule+"box-shadow:0 "+str(depth*2)+"px "+str(depth*5)+"px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.08);";}
        }
        // Local choices outrank the later global .pb-card radius rule.
        if card_rule!="" {state.rules=state.rules+".pb-card."+class_name+"{"+card_rule+"}\n";}
    }
    if node.kind=="image" and map_has(node,"fit") {
        let fit=if node.fit=="stretch" {"fill"} else {node.fit};
        state.rules=state.rules+"img.pb-image."+class_name+"{object-fit:"+fit
            +";object-position:center;min-height:"+str(_num(try node.min_h catch 0,0,0,8192))
            +"px;height:"+str(_num(try node.h catch 160,160,0,8192))+"px;}\n";
    }
    if node.kind=="image" and map_has(node,"image_rendering") {
        state.rules=state.rules+"img.pb-image."+class_name+"{image-rendering:"+node.image_rendering+";}\n";
    }
    if state.custom_palette {
        state.rules=state.rules+"."+class_name+":focus-visible{outline-color:"
            +_color(state.palette.focus)+"}\n";
    }
}

fn _has_rich(action) {
    if type(action) != "map" { return false; }
    let k = str(try action.kind catch "");
    if k == "copy_from" or k == "http_request" { return true; }
    if k == "sequence" {
        for child in (try action.actions catch []) {
            if _has_rich(child) { return true; }
        }
    }
    return false;
}

fn _action_id(action, state) {
    let id = "a" + str(state.action_count);
    state.action_count = state.action_count + 1;
    if state.action_count > MAX_WEB_ACTIONS { throw "modern_ui_web action limit exceeded"; }
    if _has_rich(action) { state.rich_actions = true; }
    state.actions[id] = action;
    return id;
}

fn _children(node, path, state) {
    let out = "";
    let i = 0;
    while i < len(node.children) {
        out = out + _render(node.children[i], path + "_" + str(i), state);
        i = i + 1;
    }
    return out;
}

fn _render(node, path, state) {
    state.node_count = state.node_count + 1;
    if state.node_count > MAX_WEB_NODES { throw "modern_ui_web node limit exceeded"; }
    let index = state.node_count;
    let kind = node.kind;
    let name = _name(node, path);
    let local = "pb-n-" + str(index);
    let classes = "pb-" + kind + " " + local;
    if kind == "row" and (try node.responsive catch true) {
        classes = classes + " pb-responsive";
    }
    let anim = str(try node.animation catch "");
    if anim != "" and anim != "none" {
        classes = classes + " pb-anim-" + anim;
        state.has_animations = true;
    }
    _node_rule(node, local, state);

    if _container(kind) {
        let content = _children(node, path, state);
        if kind == "card" {
            let title = str(try node.title catch "");
            let header = "";
            if title != "" { header = "<h2 class=\"pb-card-title\">" + _escape(title) + "</h2>"; }
            return "<section class=\"" + classes + "\" data-pb-name=\"" + _escape(name)
            + "\">" + header + content + "</section>";
        }
        return "<div class=\"" + classes + "\" data-pb-name=\"" + _escape(name)
        + "\">" + content + "</div>";
    }

    let value = str(try node.value catch "");
    let text = str(try node.text catch "");
    let common = " class=\"" + classes + "\" data-pb-name=\"" + _escape(name) + "\"";
    if kind == "heading" {
        let tag = "h2";
        if state.heading_count == 0 { tag = "h1"; }
        state.heading_count = state.heading_count + 1;
        return "<" + tag + common + ">" + _escape(text) + "</" + tag + ">";
    }
    if kind == "text" { return "<p" + common + ">" + _escape(text) + "</p>"; }
    if kind == "button" {
        let action = try node.action catch nil;
        let action_attr = "";
        if action != nil {
            action_attr = " data-pb-action=\"" + _action_id(action, state) + "\"";
        }
        let selected_attr="";
        if type(try node.selected catch nil) == "bool" {
            selected_attr=" aria-pressed=\""+str(node.selected)+"\"";
        }
        return "<button type=\"button\"" + common + action_attr + selected_attr + _explicit_label(node) + _disabled(node)
        + "><span data-pb-value>" + _escape(text) + "</span></button>";
    }
    if kind == "input" {
        let max_chars = _num(try node.max_chars catch 65536, 65536, 1, 1048576);
        let itype = _input_type(try node.input_type catch "text");
        let sec_attrs = if state.preset_enhanced and itype == "password" { " autocomplete=\"off\" spellcheck=\"false\" autocapitalize=\"off\"" } else { "" };
        return "<input type=\"" + itype + "\""
        + common + " value=\"" + _escape(value) + "\" placeholder=\""
        + _escape(str(try node.placeholder catch "")) + "\" aria-label=\""
        + _escape(_label(node, name)) + "\" maxlength=\"" + str(max_chars) + "\""
        + sec_attrs + _readonly(node) + _disabled(node) + ">";
    }
    if kind == "area" {
        let max_chars = _num(try node.max_chars catch 65536, 65536, 1, 1048576);
        return "<textarea" + common + " placeholder=\""
        + _escape(str(try node.placeholder catch "")) + "\" aria-label=\""
        + _escape(_label(node, name)) + "\" maxlength=\"" + str(max_chars) + "\""
        + _readonly(node) + _disabled(node) + ">" + _escape(value) + "</textarea>";
    }
    if kind == "toggle" {
        let checked = "";
        if try node.checked catch false { checked = " checked"; }
        let action=try node.action catch nil;let action_attr="";
        if action!=nil{action_attr=" data-pb-action=\""+_action_id(action,state)+"\"";state.toggle_actions=true;}
        return "<label" + common + action_attr + "><input type=\"checkbox\"" + checked + _explicit_label(node) + _disabled(node)
        + "><span data-pb-value>" + _escape(text) + "</span></label>";
    }
    if kind == "choice" {
        let selected = _num(try node.selected catch 0, 0, 0, 511);
        let options = try node.options catch [];
        let body = "";
        let i = 0;
        while i < len(options) {
            let selected_attr = "";
            if i == selected { selected_attr = " selected"; }
            body = body + "<option value=\"" + str(i) + "\"" + selected_attr + ">"
            + _escape(str(options[i])) + "</option>";
            i = i + 1;
        }
        return "<select" + common + " aria-label=\"" + _escape(_label(node, name)) + "\""
        + _disabled(node) + ">" + body + "</select>";
    }
    if kind == "slider" {
        let minimum = _decimal(try node.min catch 0, 0, -1000000000, 1000000000);
        let maximum = _decimal(try node.max catch 100, 100, minimum, 1000000000);
        let current = _decimal(try node.value catch minimum, minimum, minimum, maximum);
        return "<input type=\"range\"" + common + " min=\"" + str(minimum)
        + "\" max=\"" + str(maximum) + "\" value=\"" + str(current)
        + "\" aria-label=\"" + _escape(_label(node, name)) + "\"" + _disabled(node) + ">";
    }
    if kind == "progress" {
        let raw_val = try node.value catch 0;
        if is_number(raw_val) and raw_val > 1 and raw_val <= 100 {
            raw_val = raw_val / 100.0;
        }
        let current = _decimal(raw_val, 0, 0, 1);
        return "<progress" + common + " max=\"1\" value=\"" + str(current)
        + "\" aria-label=\"" + _escape(_label(node, name)) + "\"></progress>";
    }
    if kind == "image" {
        let source = _safe_image_source(try node.src catch "");
        let alt = _label(node, "");
        if source != "" {
            return "<img" + common + " src=\"" + _escape(source) + "\" alt=\"" + _escape(alt) + "\">";
        }
        return "<div" + common + " role=\"img\" aria-label=\"" + _escape(alt)
        + "\"><span>" + _escape(if alt == "" { "Image" } else { alt }) + "</span></div>";
    }
    if kind == "separator" { return "<hr" + common + ">"; }
    return "<div" + common + " aria-hidden=\"true\"></div>";
}

fn _base_css(theme, rules, enhanced = false) {
    if not enhanced {
        return "*,*::before,*::after{box-sizing:border-box}\n"
        + ":root{color-scheme:" + theme.name + ";font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;"
        + "--pb-bg:" + theme.bg + ";--pb-panel:" + theme.panel + ";--pb-field:" + theme.field
        + ";--pb-border:" + theme.border + ";--pb-accent:" + theme.accent
        + ";--pb-text:" + theme.text + ";--pb-muted:" + theme.muted + "}\n"
        + "html,body{margin:0;min-width:0;min-height:100%;background:var(--pb-bg);color:var(--pb-text);-webkit-text-size-adjust:100%}\n"
        + "body{min-height:100vh;min-height:100dvh;overflow-x:hidden;line-height:1.5}button,input,textarea,select{font:inherit;color:inherit}\n"
        + ".pb-app{width:min(100%,1120px);min-width:0;min-height:100vh;min-height:100dvh;margin:0 auto;padding:clamp(16px,3vw,32px);display:flex;flex-direction:column;gap:16px;overflow-wrap:anywhere}\n"
        + ".pb-screen,.pb-column{display:flex;min-width:0;flex-direction:column;gap:12px}.pb-row{display:flex;min-width:0;align-items:stretch;gap:12px}.pb-grid{display:grid;min-width:0;gap:12px}\n"
        + ".pb-card{display:flex;min-width:0;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--pb-border);border-radius:8px;background:var(--pb-panel);box-shadow:0 10px 28px rgba(0,0,0,.12)}\n"
        + ".pb-card-title{margin:0;font-size:1rem}.pb-heading{margin:0;line-height:1.2;letter-spacing:0}.pb-text{margin:0;color:var(--pb-muted)}\n"
        + ".pb-button,.pb-input,.pb-area,.pb-choice{width:100%;min-width:0;min-height:48px;border:1px solid var(--pb-border);border-radius:7px;background:var(--pb-field);padding:9px 12px}\n"
        + ".pb-button{width:auto;min-width:96px;border-color:var(--pb-accent);background:var(--pb-accent);color:white;font-weight:650;cursor:pointer}\n"
        + ".pb-button:hover{filter:brightness(1.08)}.pb-button:active{transform:translateY(1px)}button:disabled,input:disabled,textarea:disabled,select:disabled{cursor:not-allowed;opacity:.55}\n"
        + ".pb-area{min-height:104px;resize:vertical}.pb-toggle{display:flex;min-height:48px;align-items:center;gap:10px}.pb-toggle input{width:20px;height:20px;accent-color:var(--pb-accent)}\n"
        + ".pb-slider{width:100%;min-height:48px;accent-color:var(--pb-accent)}.pb-progress{width:100%;height:14px;accent-color:var(--pb-accent)}\n"
        + ".pb-image{display:grid;min-height:160px;place-items:center;overflow:hidden;border:1px dashed var(--pb-border);border-radius:7px;background:var(--pb-field);color:var(--pb-muted)}.pb-image img,img.pb-image{width:100%;height:auto;object-fit:contain}\n"
        + ".pb-separator{width:100%;margin:4px 0;border:0;border-top:1px solid var(--pb-border)}\n"
        + ".pb-live{position:fixed;left:16px;bottom:16px;z-index:10;max-width:min(420px,calc(100vw - 32px));padding:10px 12px;border-radius:7px;background:var(--pb-text);color:var(--pb-bg);box-shadow:0 8px 24px rgba(0,0,0,.24)}.pb-live:empty{display:none}\n"
        + ":focus-visible{outline:3px solid var(--pb-accent);outline-offset:2px}\n"
        + "@supports(padding:max(0px)){.pb-app{padding-left:max(clamp(16px,3vw,32px),env(safe-area-inset-left));padding-right:max(clamp(16px,3vw,32px),env(safe-area-inset-right));padding-bottom:max(clamp(16px,3vw,32px),env(safe-area-inset-bottom))}}\n"
        + "@media(max-width:900px){.pb-grid[class]{grid-template-columns:repeat(min(var(--pb-columns),2),minmax(0,1fr))}}\n"
        + "@media(max-width:640px){.pb-app{padding-top:14px;gap:12px}.pb-row.pb-responsive{flex-direction:column}.pb-grid{grid-template-columns:minmax(0,1fr)!important}.pb-button{width:100%}.pb-card{padding:14px}}\n"
        + "@media(max-width:360px){.pb-app{padding-top:10px}.pb-card{padding:10px}.pb-row,.pb-grid,.pb-column,.pb-screen{gap:8px}}\n"
        + "@media(max-height:480px) and (orientation:landscape){.pb-app{padding-top:8px;padding-bottom:8px}.pb-card{padding-top:10px;padding-bottom:10px}}\n"
        + "@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}\n"
        + rules;
    }
    return "*,*::before,*::after{box-sizing:border-box}\n"
    + ":root{color-scheme:" + theme.name + ";font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;"
    + "--pb-bg:" + theme.bg + ";--pb-panel:" + theme.panel + ";--pb-field:" + theme.field
    + ";--pb-border:" + theme.border + ";--pb-accent:" + theme.accent
    + ";--pb-text:" + theme.text + ";--pb-muted:" + theme.muted + "}\n"
    + "html,body{margin:0;min-width:0;min-height:100%;background-color:var(--pb-bg);color:var(--pb-text);-webkit-text-size-adjust:100%;-webkit-font-smoothing:antialiased}\n"
    + "body{min-height:100vh;min-height:100dvh;overflow-x:hidden;line-height:1.55;background-image:radial-gradient(ellipse 90% 55% at 50% -18%,color-mix(in srgb,var(--pb-accent) 28%,transparent),transparent 74%),radial-gradient(ellipse 65% 45% at 92% 102%,color-mix(in srgb,var(--pb-accent) 18%,transparent),transparent 70%),linear-gradient(180deg,rgba(255,255,255,.025) 0%,transparent 100%);background-attachment:fixed}button,input,textarea,select{font:inherit;color:inherit}\n"
    + ".pb-app{width:min(100%,1440px);min-width:0;min-height:100vh;min-height:100dvh;margin:0 auto;padding:clamp(18px,2.5vw,34px);display:flex;flex-direction:column;gap:18px;overflow-wrap:anywhere}\n"
    + ".pb-screen,.pb-column{display:flex;min-width:0;flex-direction:column;gap:14px}.pb-row{display:flex;min-width:0;align-items:center;flex-wrap:wrap;gap:12px}[data-pb-name*=\"ribbon\"] .pb-row,[data-pb-name*=\"ribbon\"].pb-row{justify-content:center;align-items:center;text-align:center}[data-pb-name*=\"ribbon\"] .pb-card-title{justify-content:center;text-align:center}.pb-grid{display:grid;min-width:0;gap:16px;align-items:start}\n"
    + ".pb-card{position:relative;display:flex;min-width:0;flex-direction:column;gap:13px;padding:22px;border:1px solid color-mix(in srgb,var(--pb-border) 82%,white 12%);border-radius:14px;background:linear-gradient(165deg,color-mix(in srgb,var(--pb-panel) 94%,white 6%) 0%,var(--pb-panel) 100%);box-shadow:0 18px 42px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.09);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:transform .24s cubic-bezier(.22,1,.36,1),box-shadow .24s ease,border-color .22s ease}\n"
    + ".pb-card:hover{border-color:color-mix(in srgb,var(--pb-accent) 50%,var(--pb-border));box-shadow:0 22px 50px -12px rgba(0,0,0,.68),0 0 26px -6px color-mix(in srgb,var(--pb-accent) 26%,transparent),inset 0 1px 0 rgba(255,255,255,.15)}\n"
    + ".pb-card-title{display:flex;align-items:center;gap:10px;margin:0 0 4px 0;padding-bottom:10px;border-bottom:1px solid color-mix(in srgb,var(--pb-border) 62%,transparent);font-size:1.05rem;font-weight:740;letter-spacing:.012em;color:var(--pb-text)}\n"
    + ".pb-card-title::before{content:\"\";display:inline-block;width:4px;height:18px;border-radius:99px;background:linear-gradient(180deg,var(--pb-accent),color-mix(in srgb,var(--pb-accent) 55%,white));box-shadow:0 0 12px color-mix(in srgb,var(--pb-accent) 75%,transparent);flex-shrink:0}\n"
    + ".pb-heading{margin:0;line-height:1.22;letter-spacing:-.018em;font-weight:800}h1.pb-heading{font-size:clamp(1.4rem,2.2vw,1.85rem)}.pb-text{margin:0;color:var(--pb-muted);font-size:.93rem;transition:color .18s ease}\n"
    + ".pb-button,.pb-input,.pb-area,.pb-choice{width:100%;min-width:0;min-height:44px;border:1px solid color-mix(in srgb,var(--pb-border) 86%,white 8%);border-radius:10px;background:color-mix(in srgb,var(--pb-field) 92%,black 8%);padding:10px 14px;transition:transform .16s cubic-bezier(.22,1,.36,1),filter .16s ease,border-color .18s ease,box-shadow .18s ease}\n"
    + ".pb-input,.pb-area,.pb-choice{box-shadow:inset 0 2px 5px rgba(0,0,0,.36);font-size:.92rem}.pb-input:focus,.pb-area:focus,.pb-choice:focus{outline:none;border-color:var(--pb-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--pb-accent) 28%,transparent),inset 0 2px 4px rgba(0,0,0,.25)}\n"
    + ".pb-input[readonly],.pb-area[readonly]{background:color-mix(in srgb,var(--pb-field) 76%,black 24%);border-color:color-mix(in srgb,var(--pb-accent) 32%,var(--pb-border));font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.87rem}\n"
    + ".pb-button{width:auto;min-width:118px;border-color:color-mix(in srgb,var(--pb-accent) 85%,white 15%);background:linear-gradient(180deg,color-mix(in srgb,var(--pb-accent) 92%,white 8%) 0%,var(--pb-accent) 100%);color:white;font-size:.91rem;font-weight:700;letter-spacing:.012em;cursor:pointer;box-shadow:0 8px 20px -4px color-mix(in srgb,var(--pb-accent) 45%,rgba(0,0,0,.55)),inset 0 1px 0 rgba(255,255,255,.24)}\n"
    + ".pb-button:hover{filter:brightness(1.1);transform:translateY(-1.5px);box-shadow:0 12px 26px -4px color-mix(in srgb,var(--pb-accent) 62%,rgba(0,0,0,.65)),inset 0 1px 0 rgba(255,255,255,.32)}.pb-button:active{transform:translateY(1px)}button:disabled,input:disabled,textarea:disabled,select:disabled{cursor:not-allowed;opacity:.55}\n"
    + ".pb-button.pb-busy{opacity:.78;pointer-events:none;filter:saturate(1.25) brightness(1.08)}\n"
    + ".pb-area{min-height:148px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.86rem;line-height:1.58}.pb-toggle{display:flex;min-height:44px;align-items:center;gap:10px;padding:6px 12px;border-radius:10px;background:color-mix(in srgb,var(--pb-field) 55%,transparent);border:1px solid color-mix(in srgb,var(--pb-border) 50%,transparent);cursor:pointer}.pb-toggle input{width:18px;height:18px;accent-color:var(--pb-accent)}\n"
    + ".pb-slider{width:100%;min-height:44px;accent-color:var(--pb-accent)}.pb-progress{width:100%;height:10px;border-radius:99px;overflow:hidden;accent-color:var(--pb-accent);transition:all .35s ease}\n"
    + ".pb-image{display:grid;min-height:160px;place-items:center;overflow:hidden;border:1px dashed var(--pb-border);border-radius:10px;background:var(--pb-field);color:var(--pb-muted)}.pb-image img,img.pb-image{width:100%;height:auto;object-fit:contain}\n"
    + ".pb-separator{width:100%;margin:4px 0;border:0;border-top:1px solid color-mix(in srgb,var(--pb-border) 70%,transparent)}\n"
    + ".pb-live{position:fixed;right:22px;bottom:22px;z-index:50;max-width:min(460px,calc(100vw - 32px));padding:13px 18px;border-radius:12px;border:1px solid var(--pb-accent);background:color-mix(in srgb,var(--pb-panel) 96%,black);color:var(--pb-text);font-weight:680;font-size:.92rem;box-shadow:0 18px 42px rgba(0,0,0,.68),0 0 24px -4px color-mix(in srgb,var(--pb-accent) 52%,transparent);animation:pbSlideUp .26s cubic-bezier(.22,1,.36,1) both}.pb-live:empty{display:none}\n"
    + "@keyframes pbFadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n"
    + "@keyframes pbSlideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}\n"
    + "@keyframes pbScaleIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}\n"
    + "@keyframes pbPulseGlow{0%,100%{box-shadow:0 18px 42px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.09)}50%{box-shadow:0 22px 48px -8px rgba(0,0,0,.68),0 0 28px -4px color-mix(in srgb,var(--pb-accent) 36%,transparent),inset 0 1px 0 rgba(255,255,255,.18)}}\n"
    + "@keyframes pbFlashUpdate{0%{box-shadow:0 0 0 3px color-mix(in srgb,var(--pb-accent) 68%,transparent);filter:brightness(1.22)}100%{box-shadow:none;filter:none}}\n"
    + ".pb-anim-fade-in{animation:pbFadeIn .38s cubic-bezier(.22,1,.36,1) both}\n"
    + ".pb-anim-slide-up{animation:pbSlideUp .44s cubic-bezier(.22,1,.36,1) both}\n"
    + ".pb-anim-scale-in{animation:pbScaleIn .36s cubic-bezier(.22,1,.36,1) both}\n"
    + ".pb-anim-pulse-glow{animation:pbPulseGlow 3.2s ease-in-out infinite}\n"
    + ".pb-anim-smooth-lift:hover{transform:translateY(-2.5px)}\n"
    + ".pb-flash{animation:pbFlashUpdate .65s cubic-bezier(.22,1,.36,1)}\n"
    + ":focus-visible{outline:3px solid var(--pb-accent);outline-offset:2px}\n"
    + "@supports(padding:max(0px)){.pb-app{padding-left:max(clamp(16px,3vw,32px),env(safe-area-inset-left));padding-right:max(clamp(16px,3vw,32px),env(safe-area-inset-right));padding-bottom:max(clamp(16px,3vw,32px),env(safe-area-inset-bottom))}}\n"
    + "@media(max-width:1024px){.pb-grid[class]{grid-template-columns:repeat(min(var(--pb-columns),2),minmax(0,1fr))}}\n"
    + "@media(max-width:640px){.pb-app{padding-top:14px;gap:12px}.pb-row.pb-responsive{flex-direction:column;align-items:stretch}.pb-grid{grid-template-columns:minmax(0,1fr)!important}.pb-button{width:100%}.pb-card{padding:14px}}\n"
    + "@media(max-width:360px){.pb-app{padding-top:10px}.pb-card{padding:10px}.pb-row,.pb-grid,.pb-column,.pb-screen{gap:8px}}\n"
    + "@media(max-height:480px) and (orientation:landscape){.pb-app{padding-top:8px;padding-bottom:8px}.pb-card{padding-top:10px;padding-bottom:10px}}\n"
    + "@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}\n"
    + rules;
}

fn _runtime(actions, toggle_actions = false, rich_actions = false) {
    let encoded = json_stringify(actions);
    encoded = str_replace_all(encoded, "<", "\\u003c");
    encoded = str_replace_all(encoded, ">", "\\u003e");
    encoded = str_replace_all(encoded, "&", "\\u0026");
    let action_source = "\"use strict\";globalThis.PBLangUIActions=" + encoded + ";\n";
    // Keep legacy output for views without toggle or rich actions.
    let listeners="document.addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-pb-action]\");if(!b||b.disabled)return;apply(actions[b.getAttribute(\"data-pb-action\")]);});";
    if toggle_actions {
        listeners="document.addEventListener(\"click\",e=>{const b=e.target.closest(\"button[data-pb-action]\");if(!b||b.disabled)return;apply(actions[b.getAttribute(\"data-pb-action\")]);});"
        + "document.addEventListener(\"change\",e=>{const t=e.target;if(!t.matches(\"input[type=checkbox]\")||t.disabled)return;const b=t.closest(\"label[data-pb-action]\");if(b)apply(actions[b.getAttribute(\"data-pb-action\")]);});";
    }
    if not rich_actions {
        let legacy_runtime = "\"use strict\";\n"
        + "(()=>{const actions=globalThis.PBLangUIActions||{};const live=document.getElementById(\"pb-live\");"
        + "const named=n=>{for(const e of document.querySelectorAll(\"[data-pb-name]\")){if(e.getAttribute(\"data-pb-name\")===n)return e;}return null;};"
        + "const apply=(a,d=0)=>{if(!a||d>8)return;if(a.kind===\"set_text\"){const e=named(String(a.target));if(!e)return;"
        + "if(e.matches(\"input,textarea\"))e.value=String(a.value);else{const v=e.querySelector(\"[data-pb-value]\");(v||e).textContent=String(a.value);}}"
        + "else if(a.kind===\"message\"){live.textContent=String(a.value);}"
        + "else if(a.kind===\"sequence\"&&Array.isArray(a.actions)){for(const x of a.actions)apply(x,d+1);}};"
        + listeners + "})();\n";
        return map{ actions: action_source, runtime: legacy_runtime };
    }
    let rich_listeners="document.addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-pb-action]\");if(!b||b.disabled)return;apply(actions[b.getAttribute(\"data-pb-action\")],0,b);});";
    if toggle_actions {
        rich_listeners="document.addEventListener(\"click\",e=>{const b=e.target.closest(\"button[data-pb-action]\");if(!b||b.disabled)return;apply(actions[b.getAttribute(\"data-pb-action\")],0,b);});"
        + "document.addEventListener(\"change\",e=>{const t=e.target;if(!t.matches(\"input[type=checkbox]\")||t.disabled)return;const b=t.closest(\"label[data-pb-action]\");if(b)apply(actions[b.getAttribute(\"data-pb-action\")],0,b);});";
    }
    let runtime = "\"use strict\";\n"
    + "(()=>{if(globalThis.trustedTypes&&trustedTypes.createPolicy&&!trustedTypes.defaultPolicy){try{trustedTypes.createPolicy(\"default\",{createHTML:s=>s,createScriptURL:s=>s});}catch(_){}}"
    + "const actions=globalThis.PBLangUIActions||{};const live=document.getElementById(\"pb-live\");let liveTimer=null;"
    + "const showToast=msg=>{if(!live||!msg)return;live.textContent=String(msg);if(liveTimer)clearTimeout(liveTimer);liveTimer=setTimeout(()=>{live.textContent=\"\";},5500);};"
    + "const named=n=>{for(const e of document.querySelectorAll(\"[data-pb-name]\")){if(e.getAttribute(\"data-pb-name\")===n)return e;}return null;};"
    + "const flashEl=e=>{if(!e)return;e.classList.remove(\"pb-flash\");void e.offsetWidth;e.classList.add(\"pb-flash\");};"
    + "const writeEl=(e,val)=>{if(!e)return;if(e.tagName===\"PROGRESS\"){let n=parseFloat(val);if(!isNaN(n)){if(n>1&&n<=100)n=n/100;e.value=Math.max(0,Math.min(1,n));}}else if(e.matches(\"input,textarea\"))e.value=String(val);else{const v=e.querySelector(\"[data-pb-value]\");(v||e).textContent=String(val);}flashEl(e);};"
    + "const readEl=e=>{if(!e)return \"\";if(e.tagName===\"SELECT\")return e.options[e.selectedIndex]?e.options[e.selectedIndex].text:\"\";if(e.matches(\"input[type=checkbox]\"))return e.checked;const cb=e.querySelector(\"input[type=checkbox]\");if(cb)return cb.checked;if(e.matches(\"input,textarea\"))return e.value;const v=e.querySelector(\"[data-pb-value]\");return(v||e).textContent||\"\";};"
    + "let memTok=\"\";try{localStorage.removeItem(\"pb_access_token\");const sp=new URLSearchParams(location.search);const uTok=sp.get(\"token\")||sp.get(\"access_token\")||\"\";if(uTok){memTok=uTok;if(history&&history.replaceState){history.replaceState(null,\"\",location.pathname);}fetch(\"/v1/auth/session\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\",\"X-PB-Access-Token\":uTok},body:JSON.stringify({access_token:uTok}),credentials:\"same-origin\"}).catch(()=>{});}}catch(_){}"
    + "const apply=(a,d=0,btn=null)=>{if(!a||d>8)return;if(a.kind===\"set_text\"){writeEl(named(String(a.target)),a.value);}"
    + "else if(a.kind===\"copy_from\"){const e=named(String(a.target));const txt=String(readEl(e));if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).catch(()=>{});}showToast(a.value||\"Αντιγράφηκε στο πρόχειρο\");}"
    + "else if(a.kind===\"http_request\"){const m=String(a.method||\"POST\");if(m===\"NAVIGATE\"){if(!Array.isArray(a.fields)||a.fields.length===0){location.href=String(a.path);return;}const inp=named(String(a.target));const v=String(readEl(inp)||\"\").trim();if(!v){showToast(\"⛔ Εισάγετε έγκυρο Κλειδί Πρόσβασης\");return;}if(btn)btn.classList.add(\"pb-busy\");fetch(\"/v1/auth/session\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\",\"X-PB-Access-Token\":v},body:JSON.stringify({access_token:v}),credentials:\"same-origin\"}).then(r=>{if(btn)btn.classList.remove(\"pb-busy\");if(r.ok){if(inp&&inp.matches(\"input\"))inp.value=\"\";location.href=String(a.path);}else{showToast(\"⛔ Άκυρο Κλειδί Πρόσβασης — Η είσοδος απορρίφθηκε\");}}).catch(()=>{if(btn)btn.classList.remove(\"pb-busy\");showToast(\"Σφάλμα ασφαλούς σύνδεσης\");});return;}"
    + "const body={};if(Array.isArray(a.fields)){for(const f of a.fields){body[f]=readEl(named(String(f)));}}"
    + "let tok=String(readEl(named(\"access_token\"))||\"\").trim()||memTok;"
    + "const hdrs={\"Content-Type\":\"application/json\"};if(tok){hdrs[\"X-PB-Access-Token\"]=tok;}"
    + "const opts={method:m,headers:hdrs,credentials:\"same-origin\"};if(m!==\"GET\"&&m!==\"HEAD\")opts.body=JSON.stringify(body);"
    + "if(btn)btn.classList.add(\"pb-busy\");"
    + "fetch(String(a.path),opts).then(r=>r.text()).then(t=>{if(btn)btn.classList.remove(\"pb-busy\");let out=t;let toastMsg=a.value||\"\";try{const p=JSON.parse(t);if(p&&typeof p===\"object\"){if(p.ui_updates&&typeof p.ui_updates===\"object\"){for(const k of Object.keys(p.ui_updates)){writeEl(named(k),p.ui_updates[k]);}}if(typeof p.toast===\"string\"&&p.toast)toastMsg=p.toast;if(typeof p.redirect_url===\"string\"&&p.redirect_url){if(toastMsg)showToast(toastMsg);setTimeout(()=>{location.href=p.redirect_url;},120);return;}if(typeof p.human_report===\"string\"&&p.human_report){out=p.human_report;}else{out=JSON.stringify(p,null,2);}}}catch(_){}writeEl(named(String(a.target)),out);if(toastMsg)showToast(toastMsg);}).catch(err=>{if(btn)btn.classList.remove(\"pb-busy\");writeEl(named(String(a.target)),\"Σφάλμα επικοινωνίας: \"+String(err));showToast(\"Σφάλμα δικτύου\");});}"
    + "else if(a.kind===\"message\"){showToast(a.value);}"
    + "else if(a.kind===\"sequence\"&&Array.isArray(a.actions)){for(const x of a.actions)apply(x,d+1,btn);}};"
    + rich_listeners
    + "document.addEventListener(\"keydown\",e=>{if(e.key!==\"Enter\")return;const t=e.target;if(!t||!t.matches(\"input\"))return;const c=t.closest(\".pb-card,main\");if(!c)return;const b=c.querySelector(\"button[data-pb-action]\");if(b&&!b.disabled){e.preventDefault();apply(actions[b.getAttribute(\"data-pb-action\")],0,b);}});"
    + "})();\n";
    return map{ actions: action_source, runtime: runtime };
}

fn _lang_char(c) {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        or (c >= 48 and c <= 57) or c == 45;
}

fn _lang(value) {
    let lang = str(value);
    if lang == "" or len(lang) > 35 { return "en"; }
    let i = 0;
    while i < len(lang) {
        if not _lang_char(strcharcodeat(lang, i)) {
            return "en";
        }
        i = i + 1;
    }
    return lang;
}

fn _check_action(action, fields) {
    if (action.kind == "set_text" or action.kind == "copy_from" or action.kind == "http_request")
    and not map_has(fields, action.target) {
        throw "modern_ui_web action target is not text-capable: " + action.target;
    }
    if action.kind == "http_request" {
        let req_fields = try action.fields catch [];
        let fi = 0;
        while fi < len(req_fields) {
            if not map_has(fields, str(req_fields[fi])) {
                throw "modern_ui_web http_request field does not exist: " + str(req_fields[fi]);
            }
            fi = fi + 1;
        }
    }
    if action.kind == "sequence" {
        for child in action.actions { _check_action(child, fields); }
    }
}

fn _preflight(bundle) {
    if type(bundle) != "map"
    or (try bundle.format catch "") != "pblang.modern-ui.bundle.v1"
    or (try bundle.target catch "") != "web" {
        throw "modern_ui_web expected a Web modern UI bundle";
    }
    if len(bundle.records) > MAX_WEB_NODES { throw "modern_ui_web node limit exceeded"; }
    let fields = map{};
    for record in bundle.records {
        let source = record.source;
        let onclick = try source.onclick catch nil;
        let onchange = try source.onchange catch nil;
        if onclick != nil {
            throw "modern_ui_web native onclick callback on " + record.name
            + " is not portable; use a modern_ui action";
        }
        if onchange != nil {
            throw "modern_ui_web native onchange callback on " + record.name
            + " is not portable in the browser adapter";
        }
        if _text_control(record.kind) { fields[record.name] = record.kind; }
        if (try source.action catch nil) != nil
           and record.kind != "button" and record.kind != "toggle" {
            throw "modern_ui_web portable actions currently require a button or toggle trigger";
        }
    }
    for record in bundle.records {
        let action = try record.source.action catch nil;
        if action != nil { _check_action(action, fields); }
    }
}

fn generate(name, bundle, options = nil) {
    bundle = Validation.renderer_bundle(bundle, "web");
    _preflight(bundle);
    let opts = _copy(options);
    let release = RELEASE_CHANNEL.resolve(str(try opts.version catch "1.0.0"), opts);
    if not release.ok { throw "modern_ui_web: " + release.error; }
    let state = map{
        node_count: 0, action_count: 0, heading_count: 0,
        actions: map{}, rules: "", toggle_actions: false,
        has_animations: false, rich_actions: false,
        preset_enhanced: map_has(opts, "visual_preset"),
        palette:GUI.custom_palette(try opts.theme catch "dark",try opts.palette catch nil),
        custom_palette:(try opts.palette catch nil)!=nil
    };
    let title = str(name);
    if title == "" { title = "PBLang application"; }
    if len(title) > 256 { throw "modern_ui_web title is too long"; }
    let body = _render(bundle.view, "0", state);
    let theme = _theme(opts);
    let enhanced = state.has_animations or state.rich_actions or map_has(opts, "visual_preset");
    let css = _base_css(theme, state.rules, enhanced);
    let radius=Style.card_radius(opts);
    if radius!=nil { css=css+".pb-card{border-radius:"+str(radius)+"px}\n"; }
    let scripts = _runtime(state.actions, state.toggle_actions, state.rich_actions);
    let desc_tag = "";
    if map_has(opts, "description") and str(opts.description) != "" {
        desc_tag = "<meta name=\"description\" content=\"" + _escape(str(opts.description)) + "\">";
    }
    let asset_prefix = str(try opts.asset_prefix catch "./pblang-ui");
    if asset_prefix == "" { asset_prefix = "./pblang-ui"; }
    let ver_q = "";
    if enhanced {
        ver_q = "?v=" + str_slice(sha256(css + "\n" + scripts.actions + "\n" + scripts.runtime), 0, 10);
    }
    let html = "<!doctype html><html lang=\"" + _escape(_lang(try opts.lang catch "en"))
    + "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">"
    + "<meta name=\"color-scheme\" content=\"" + theme.name
    + "\"><meta name=\"application-version\" content=\"" + _escape(release.application_version)
    + "\">" + desc_tag + "<title>" + _escape(title)
    + "</title><link rel=\"stylesheet\" href=\"" + _escape(asset_prefix + ver_q) + ".css\"></head><body><main class=\"pb-app\">"
    + body + "</main><div id=\"pb-live\" class=\"pb-live\" role=\"status\" aria-live=\"polite\"></div>"
    + "<script defer src=\"" + _escape(asset_prefix + ver_q) + ".actions.js\"></script><script defer src=\"" + _escape(asset_prefix + ver_q) + ".js\"></script></body></html>";
    if enhanced {
        html = "<!doctype html><html lang=\"" + _escape(_lang(try opts.lang catch "en"))
        + "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">"
        + "<meta name=\"color-scheme\" content=\"" + theme.name
        + "\"><meta name=\"application-version\" content=\"" + _escape(release.application_version)
        + "\">" + desc_tag + "<title>" + _escape(title)
        + "</title><link rel=\"stylesheet\" href=\"" + _escape(asset_prefix) + ".css" + _escape(ver_q) + "\"></head><body><main class=\"pb-app\">"
        + body + "</main><div id=\"pb-live\" class=\"pb-live\" role=\"status\" aria-live=\"polite\"></div>"
        + "<script defer src=\"" + _escape(asset_prefix) + ".actions.js" + _escape(ver_q) + "\"></script><script defer src=\"" + _escape(asset_prefix) + ".js" + _escape(ver_q) + "\"></script></body></html>";
    }
    return map{
        format: "pblang.modern-ui.web.v1",
        name: title, html: html, css: css,
        version: release.base_version, display_version: release.application_version,
        release_channel: release.release_channel,
        actions_js: scripts.actions, runtime_js: scripts.runtime,
        nodes: state.node_count, actions: state.action_count,
        theme: theme.name,
        digest: sha256(html + "\n" + css + "\n" + scripts.actions + "\n" + scripts.runtime)
    };
}

fn _response(body, content_type, security, cache_control) {
    return Security.harden(map{
        status: 200, body: body, content_type: content_type,
        headers: map{ "Cache-Control": cache_control }
    }, security);
}

fn build(name, bundle, options = nil) {
    let opts = _copy(options);
    let generated = generate(name, bundle, opts);
    let security = try opts.security catch Security.strict();
    let app = Web.create_app(map{
        host: try opts.host catch "127.0.0.1",
        port: try opts.port catch 8080
    });
    Web.use(app, Security.shield(security));
    Web.use(app, Security.rate_guard(security));
    Web.get(app, "/", fn(_ctx) {
        return _response(generated.html, "text/html; charset=utf-8", security, "no-cache");
    });
    Web.get(app, "/pblang-ui.css", fn(_ctx) {
        return _response(generated.css, "text/css; charset=utf-8", security, "public, max-age=31536000, immutable");
    });
    Web.get(app, "/pblang-ui.actions.js", fn(_ctx) {
        return _response(generated.actions_js, "text/javascript; charset=utf-8", security, "public, max-age=31536000, immutable");
    });
    Web.get(app, "/pblang-ui.js", fn(_ctx) {
        return _response(generated.runtime_js, "text/javascript; charset=utf-8", security, "public, max-age=31536000, immutable");
    });
    let handle = fn(request) {
        return Security.harden(Web.handle(app, request), security);
    };
    return map{
        format: "pblang.modern-ui.web-app.v1",
        app: app, handle: handle, web_framework: "pblang", security: security,
        generated: generated,
        config: map{ host: app.config.host, port: app.config.port }
    };
}

fn _preview_request(path) {
    return map{
        method: "GET", path: path,
        headers: map{ "user-agent": "Mozilla/5.0 pblang-modern-ui-preview" },
        body: ""
    };
}

fn preview(name, bundle, options = nil) {
    let built = build(name, bundle, options);
    let response = built.handle(_preview_request("/"));
    return map{
        kind: "modern-ui-web", name: str(name), preview: true,
        response: response, app: built.app, handle: built.handle,
        generated: built.generated
    };
}

fn serve(name, bundle, options = nil) {
    let built = build(name, bundle, options);
    Web.listen(built.app);
    return map{
        kind: "modern-ui-web", name: str(name), preview: false,
        app: built.app, generated: built.generated
    };
}

fn _safe_output(path) {
    let value = str(path);
    if value == "" or len(value) > MAX_OUTPUT_PATH or str_starts_with(value, "/")
    or str_starts_with(value, "\\") or str_contains(value, "\\")
    or str_contains(value, ":") or str_contains(value, "\x00") {
        return false;
    }
    for part in str_split(value, "/") {
        if part == "" or part == "." or part == ".." { return false; }
    }
    return true;
}

fn export_static(name, bundle, output, options = nil) {
    let out = str(output);
    if not _safe_output(out) {
        throw "modern_ui_web output must be a safe relative directory";
    }
    let opts=_copy(options);let generated = generate(name, bundle, opts);
    fs_mkdirs(out);
    fs_write(out + "/index.html", generated.html);
    fs_write(out + "/pblang-ui.css", generated.css);
    fs_write(out + "/pblang-ui.actions.js", generated.actions_js);
    fs_write(out + "/pblang-ui.js", generated.runtime_js);
    let manifest = map{
        format: "pblang.modern-ui.web-export.v1",
        name: generated.name, version:generated.version,
        display_version:generated.display_version,
        release_channel:generated.release_channel, files: [
        "index.html", "pblang-ui.css", "pblang-ui.actions.js", "pblang-ui.js"
        ],
        nodes: generated.nodes, actions: generated.actions,
        digest: generated.digest
    };
    fs_write(out + "/pblang-ui.manifest.json", json_stringify(manifest));
    return map{
        ok: true, output: out, files: manifest.files,
        manifest: out + "/pblang-ui.manifest.json",
        digest: generated.digest, generated: generated
    };
}

export generate, build, preview, serve, export_static;
