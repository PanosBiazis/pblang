// Bounded requirement analysis for validated self-hosted PBCS/PBCK chunks.
// This module never executes bytecode. It summarizes nested chunks so target
// backends can reject unsupported programs before packaging or deployment.

let PBCK = import("stdlib:selfhost_pbck.sapp");

let OPCODE_NAMES = [
    "constant", "add", "sub", "mul", "div", "eq", "not_eq", "gt", "ge", "lt", "le",
    "pop", "print", "define_global", "get_global", "set_global", "get_local", "set_local",
    "call", "return", "jump", "jump_if_false", "jump_if_true", "not", "closure",
    "make_array", "make_map", "get_index", "set_index", "get_attr", "set_attr", "mod",
    "len", "jump_if_false_peek", "jump_if_true_peek", "try", "jump_if_nil_peek",
    "jump_if_not_nil_peek", "get_upvalue", "set_upvalue", "throw", "add_local_const",
    "add_local_local"
];

fn _inc(counts, key) {
    if map_has(counts, key) { counts[key] = counts[key] + 1; }
    else { counts[key] = 1; }
}

fn _max(current, value) { return if value > current { value } else { current }; }

fn _scan_value(value, stats, depth) {
    stats.constants = stats.constants + 1;
    let kind = type(value);
    if value == nil { kind = "nil"; }
    elif is_map(value) and map_has(value, "chunk") and map_has(value, "arity") { kind = "function"; }
    elif is_map(value) and map_has(value, "try_chunk") and map_has(value, "catch_chunk") { kind = "try"; }
    _inc(stats.constant_kinds, kind);
    if kind == "string" { stats.string_bytes = stats.string_bytes + len(str_to_bytes(value)); }
    elif kind == "function" {
        stats.functions = stats.functions + 1;
        stats.max_arity = _max(stats.max_arity, value.arity);
        let upvalues = try value.upvalues catch [];
        stats.max_upvalues = _max(stats.max_upvalues, len(upvalues));
        _scan_chunk(value.chunk, stats, depth + 1);
    }
    elif kind == "try" {
        stats.try_blocks = stats.try_blocks + 1;
        _scan_chunk(value.try_chunk, stats, depth + 1);
        _scan_chunk(value.catch_chunk, stats, depth + 1);
    }
}

fn _scan_chunk(chunk, stats, depth) {
    if depth > 256 { throw "pbck_analysis: nested chunk depth exceeds analysis limit"; }
    stats.chunks = stats.chunks + 1;
    stats.max_depth = _max(stats.max_depth, depth);
    stats.instructions = stats.instructions + len(chunk.instructions);
    let i = 0;
    while i < len(chunk.instructions) {
        let instruction = chunk.instructions[i];
        let op = instruction.op;
        if op < 0 or op >= len(OPCODE_NAMES) { throw "pbck_analysis: unknown opcode"; }
        _inc(stats.opcode_counts, str(op));
        let operand = instruction.operand;
        if (op == 16 or op == 17 or op == 38 or op == 39) and type(operand) == "number" {
            stats.max_slot = _max(stats.max_slot, operand);
        }
        elif op == 18 and type(operand) == "number" { stats.max_call_arity = _max(stats.max_call_arity, operand); }
        elif (op == 25 or op == 26) and type(operand) == "number" {
            stats.max_collection_items = _max(stats.max_collection_items, operand);
        }
        elif op == 41 and is_map(operand) { stats.max_slot = _max(stats.max_slot, operand.slot); }
        elif op == 42 and is_map(operand) {
            stats.max_slot = _max(stats.max_slot, _max(operand.slot, operand.rhs));
        }
        i = i + 1;
    }
    i = 0;
    while i < len(chunk.constants) { _scan_value(chunk.constants[i], stats, depth); i = i + 1; }
}

fn analyze(chunk) {
    PBCK.validate_chunk(chunk);
    let stats = map{
        format: "pblang.pbck.requirements.v1", chunks: 0, instructions: 0, constants: 0,
        functions: 0, try_blocks: 0, string_bytes: 0, max_depth: 0, max_arity: 0,
        max_upvalues: 0, max_slot: 0, max_call_arity: 0, max_collection_items: 0,
        opcode_counts: map{}, constant_kinds: map{}
    };
    _scan_chunk(chunk, stats, 0);
    let opcodes = []; let op = 0;
    while op < len(OPCODE_NAMES) {
        let key = str(op);
        if map_has(stats.opcode_counts, key) {
            array_push(opcodes, map{ opcode: op, name: OPCODE_NAMES[op], count: stats.opcode_counts[key] });
        }
        op = op + 1;
    }
    stats.opcodes = opcodes;
    return stats;
}

fn analyze_bytes(bytes) { return analyze(PBCK.deserialize_chunk(bytes)); }
fn analyze_file(path) { return analyze_bytes(fs_read_bytes(path)); }

export OPCODE_NAMES, analyze, analyze_bytes, analyze_file;
