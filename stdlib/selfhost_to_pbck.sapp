// stdlib/selfhost_to_pbck.sapp — translate a SELF-HOSTED compiler chunk-map into
// the RUST .pbck bytecode container, so `pblang run file.pbck` (the native Rust
// VM) executes bytecode produced by the pblang-written compiler.
//
// Two impedance mismatches are bridged here:
//   1. Opcode NUMBERING differs above 15 (self-hosted ir.sapp vs the Rust OpCode
//      enum). `_rust_op` is the fixed translation table.
//   2. The Rust .pbck encodes constants/operands in a specific byte layout
//      (matches crates/pblang-ir::pbck_deserialize): magic "PBCK", u8 version=1,
//      then chunk = u32 n_ins, per-op (tag byte + u32 operand where applicable),
//      u32 n_const + values, u32 n_spans + (u32,u32), u8 has_source_name.
//
// The self-hosted codegen shares the Rust VM's calling convention (callee pushed
// first, then args — see codegen.sapp), so calls/closures map directly. The
// translation pipeline is:
//   _lower(chunk)  -> a flat list of Rust "items" with jump targets as LABELS,
//                     constants merged into one pool, and the constructs that have
//                     no native opcode lowered to equivalents (see below).
//   resolve labels -> instruction indices, then emit the .pbck byte layout.
// A label-based IR is used (instead of fixed index arithmetic) so nesting —
// try-in-try, closures, loops — composes without manual offset bookkeeping.
//
// Constructs with no native opcode, lowered here:
//   - consuming branches and *_PEEK/nil branches -> explicit stack-compatible
//     native control flow (native conditional jumps always retain the condition)
//   - OP_LEN -> stash in a scratch local, OpGetGlobal "len", reload, OpCall 1
//   - OP_TRY (try/catch) -> inline OpTry/OpEndTry with the body & handler
//     sub-chunks lowered into the same frame (they share enclosing locals)
//
// Boundary: default-parameter calls (min_arity == arity, so a call must pass the
// exact arity) and OP_DEFER are not represented.

let RUST_VERSION = 1;
let OPTIMIZER = import("stdlib:compiler/optimizer.sapp");

// Self-hosted op number -> Rust OpCode tag. Identity for 0..15; remapped above.
// OP_CLOSURE (24), the *_PEEK jumps, OP_LEN (32) and OP_TRY (35) have no 1:1 tag
// and are lowered specially in `_lower_inst`.
fn _rust_op(op) {
    if op <= 15 { return op; }            // OP_CONSTANT..OP_SET_GLOBAL match exactly
    if op == 16 { return 25; }            // OP_GET_LOCAL  -> OpGetLocal
    if op == 17 { return 26; }            // OP_SET_LOCAL  -> OpSetLocal
    if op == 18 { return 31; }            // OP_CALL       -> OpCall
    if op == 19 { return 33; }            // OP_RETURN     -> OpReturn
    if op == 20 { return 35; }            // OP_JUMP       -> OpJump
    if op == 21 { return 36; }            // OP_JUMP_IF_FALSE -> OpJumpIfFalse
    if op == 22 { return 37; }            // OP_JUMP_IF_TRUE  -> OpJumpIfTrue
    if op == 23 { return 38; }            // OP_NOT        -> OpNot
    if op == 25 { return 19; }            // OP_MAKE_ARRAY -> OpMakeArray
    if op == 26 { return 20; }            // OP_MAKE_MAP   -> OpMakeMap
    if op == 27 { return 21; }            // OP_GET_INDEX  -> OpGetIndex
    if op == 28 { return 22; }            // OP_SET_INDEX  -> OpSetIndex
    if op == 29 { return 16; }            // OP_GET_ATTR   -> OpGetAttr
    if op == 30 { return 17; }            // OP_SET_ATTR   -> OpSetAttr
    if op == 31 { return 40; }            // OP_MOD        -> OpMod
    if op == 38 { return 28; }            // OP_GET_UPVALUE -> OpGetUpvalue
    if op == 39 { return 29; }            // OP_SET_UPVALUE -> OpSetUpvalue
    if op == 40 { return 47; }            // OP_THROW      -> OpThrow (uncaught raises)
    return (0 - 1);                       // handled specially or unmapped
}

// Rust ops that carry a single u32 operand in the .pbck layout.
fn _rust_op_has_operand(rop) {
    return rop == 0 or rop == 13 or rop == 14 or rop == 15 or rop == 16 or rop == 17
        or rop == 18 or rop == 19 or rop == 20 or rop == 23 or rop == 25 or rop == 26
        or rop == 28 or rop == 29 or rop == 31 or rop == 32 or rop == 35 or rop == 36
        or rop == 37 or rop == 42;
}

// Rust ops whose operand is a CONSTANT-POOL index (need offset when a sub-chunk's
// constants are merged into the shared pool).
fn _rust_op_is_const_operand(rop) {
    return rop == 0 or rop == 13 or rop == 14 or rop == 15 or rop == 16 or rop == 17;
}

// Self-hosted ops whose operand is a JUMP TARGET (an instruction index).
fn _sh_is_jump(op) {
    return op == 20 or op == 21 or op == 22 or op == 33 or op == 34 or op == 36 or op == 37;
}

// ── byte writers ────────────────────────────────────────────────────────────
fn _w_u8(out, b) { array_push(out, bit_and(b, 255)); }
fn _w_u32(out, v) {
    _w_u8(out, v); _w_u8(out, bit_shr(v, 8)); _w_u8(out, bit_shr(v, 16)); _w_u8(out, bit_shr(v, 24));
}
fn _w_str(out, s) {
    let b = str_to_bytes(s);
    _w_u32(out, len(b));
    let i = 0;
    while i < len(b) { array_push(out, b[i]); i = i + 1; }
}
fn _w_f64(out, n) {
    let b = num_to_le_bytes(n);
    let i = 0;
    while i < 8 { array_push(out, b[i]); i = i + 1; }
}

// A self-hosted function constant is a map carrying a compiled body chunk plus
// arity/capture metadata (codegen.sapp::codegen_fn / codegen_fnlit).
fn _is_function_const(v) {
    return type(v) == "map" and map_has(v, "chunk") and map_has(v, "arity");
}

fn _w_value(out, v) {
    if v == nil { _w_u8(out, 2); return; }
    // An OP_TRY descriptor {try_chunk, catch_chunk} is consumed (inlined) during
    // lowering, so its pool slot is dead — emit nil to keep indices stable.
    if type(v) == "map" and map_has(v, "try_chunk") and map_has(v, "catch_chunk") { _w_u8(out, 2); return; }
    if _is_function_const(v) { _w_u8(out, 7); _w_function(out, v); return; }
    let t = type(v);
    if t == "number" { _w_u8(out, 0); _w_f64(out, v); return; }
    if t == "bool" { _w_u8(out, 1); _w_u8(out, if v { 1 } else { 0 }); return; }
    if t == "string" { _w_u8(out, 3); _w_str(out, v); return; }
    throw "selfhost_to_pbck: unsupported constant kind " + t;
}

// Encode a self-hosted function constant as a Rust Function (pbck tag 7 body).
// A closure is its OWN frame, so its body is a separately-compiled chunk (NOT
// inlined). Default parameters: the fn constant records `min_arity` (required
// args); the Rust VM pads missing params with the `defaults` values BEFORE running
// the body, and the body's own fill code then replaces those nils with the real
// defaults — so we hand the VM `arity - min_arity` NIL defaults.
fn _w_function(out, fc) {
    let min_arity = try fc.min_arity catch fc.arity;
    _w_u8(out, 0);                   // name: None
    _w_u32(out, fc.arity);           // arity
    _w_u32(out, min_arity);          // min_arity
    let ndef = fc.arity - min_arity;
    _w_u32(out, ndef);               // defaults count
    let d = 0;
    while d < ndef { _w_u8(out, 2); d = d + 1; }   // each default = Nil (tag 2)
    _w_u8(out, 0);                   // is_vararg: false
    _w_u8(out, 0);                   // param_types: None
    _emit_chunk(out, fc.chunk, false, fc.arity);   // body chunk (ends in OP_RETURN)
}

// ── label IR ──────────────────────────────────────────────────────────────────
// `code` is a flat list of items, each a map:
//   { label: id }                    zero-width position marker
//   { op: tag }                      no-operand op
//   { op: tag, n: int }              op with a literal operand (const idx, slot, ...)
//   { op: tag, jmp: id }             jump op; operand resolved to label `id`'s index
//   { op: 27, fnc: idx, caps: [..] } OpClosure
// `ctx` holds a monotonic label counter shared across an entire frame (so labels
// in inlined try sub-chunks never collide).

fn _fresh(ctx) { ctx.n = ctx.n + 1; return ctx.n; }

// Native PBCK conditional jumps inspect the top value without consuming it.
// Self-hosted ordinary branches consume their condition, so both the taken and
// fallthrough paths need an explicit pop. `branch_op` is native 36/37.
fn _lower_consuming_branch(code, ctx, branch_op, target) {
    let taken = _fresh(ctx);
    let done = _fresh(ctx);
    array_push(code, map{ op: branch_op, jmp: taken });
    array_push(code, map{ op: 11 });                   // fallthrough: consume condition
    array_push(code, map{ op: 35, jmp: done });
    array_push(code, map{ label: taken });
    array_push(code, map{ op: 11 });                   // taken: consume condition
    array_push(code, map{ op: 35, jmp: target });
    array_push(code, map{ label: done });
}

// Nil-peek branches preserve the original value. OpIsNil consumes the duplicate
// and produces a boolean; remove only that boolean on both paths.
fn _lower_nil_peek_branch(code, ctx, branch_op, target) {
    let taken = _fresh(ctx);
    let done = _fresh(ctx);
    array_push(code, map{ op: 46 });                   // original, duplicate
    array_push(code, map{ op: 45 });                   // original, is_nil(duplicate)
    array_push(code, map{ op: branch_op, jmp: taken });
    array_push(code, map{ op: 11 });                   // discard predicate
    array_push(code, map{ op: 35, jmp: done });
    array_push(code, map{ label: taken });
    array_push(code, map{ op: 11 });                   // discard predicate
    array_push(code, map{ op: 35, jmp: target });
    array_push(code, map{ label: done });
}

// Highest local slot referenced anywhere in `ins` (incl. inlined OP_TRY
// sub-chunks, which share the enclosing frame's slots), or -1.
fn _max_local_slot(ins, consts) {
    let m = 0 - 1;
    let i = 0;
    while i < len(ins) {
        let op = ins[i].op;
        if op == 16 or op == 17 {
            let s = try ins[i].operand catch 0;
            if s > m { m = s; }
        }
        if op == 41 or op == 42 {
            let s = ins[i].operand.slot;
            if s > m { m = s; }
            if op == 42 and ins[i].operand.rhs > m { m = ins[i].operand.rhs; }
        }
        if op == 35 {                                  // OP_TRY -> recurse
            let tc = consts[ins[i].operand];
            let mb = _max_local_slot(tc.try_chunk.instructions, tc.try_chunk.constants);
            let mh = _max_local_slot(tc.catch_chunk.instructions, tc.catch_chunk.constants);
            if mb > m { m = mb; }
            if mh > m { m = mh; }
        }
        i = i + 1;
    }
    return m;
}

// Lower one self-hosted instruction into `code`. `coff` offsets this chunk's
// constant indices into the shared pool; `lbl_at` maps target indices -> labels.
fn _lower_inst(code, inst, ctx, pool, coff, lbl_at, scratch, len_idx) {
    let op = inst.op;

    // A tail-position call uses the native trampoline opcode. Keeping this as
    // instruction metadata avoids adding a second call opcode to the
    // self-hosted IR while allowing codegen and conformance probes to request
    // bounded frame reuse explicitly.
    if op == 18 and (try inst.tail catch false) {
        array_push(code, map{ op: 32, n: try inst.operand catch 0 });
        return;
    }

    // Optimizer-only superinstructions are expanded to the established native
    // VM sequence. This preserves .pbck compatibility without requiring a new
    // container version or native opcode.
    if op == 41 {                                      // ADD_LOCAL_CONST
        array_push(code, map{ op: 25, n: inst.operand.slot });
        array_push(code, map{ op: 0, n: coff + inst.operand.constant });
        array_push(code, map{ op: 1 });
        array_push(code, map{ op: 26, n: inst.operand.slot });
        return;
    }
    if op == 42 {                                      // ADD_LOCAL_LOCAL
        array_push(code, map{ op: 25, n: inst.operand.slot });
        array_push(code, map{ op: 25, n: inst.operand.rhs });
        array_push(code, map{ op: 1 });
        array_push(code, map{ op: 26, n: inst.operand.slot });
        return;
    }

    if op == 24 {                                      // OP_CLOSURE -> OpClosure
        let fc = pool[coff + inst.operand];
        array_push(code, map{ op: 27, fnc: coff + inst.operand, caps: try fc.upvalues catch [] });
        return;
    }
    if op == 32 {                                      // OP_LEN via a scratch local
        array_push(code, map{ op: 26, n: scratch });   // OpSetLocal scratch
        array_push(code, map{ op: 14, n: len_idx });   // OpGetGlobal "len"
        array_push(code, map{ op: 25, n: scratch });   // OpGetLocal scratch
        array_push(code, map{ op: 31, n: 1 });         // OpCall 1
        return;
    }
    if op == 21 {                                      // consuming JUMP_IF_FALSE
        _lower_consuming_branch(code, ctx, 36, lbl_at[str(inst.operand)]);
        return;
    }
    if op == 22 {                                      // consuming JUMP_IF_TRUE
        _lower_consuming_branch(code, ctx, 37, lbl_at[str(inst.operand)]);
        return;
    }
    if op == 33 {                                      // JUMP_IF_FALSE_PEEK
        array_push(code, map{ op: 36, jmp: lbl_at[str(inst.operand)] });
        return;
    }
    if op == 34 {                                      // JUMP_IF_TRUE_PEEK
        array_push(code, map{ op: 37, jmp: lbl_at[str(inst.operand)] });
        return;
    }
    if op == 36 {                                      // JUMP_IF_NIL_PEEK
        _lower_nil_peek_branch(code, ctx, 37, lbl_at[str(inst.operand)]);
        return;
    }
    if op == 37 {                                      // JUMP_IF_NOT_NIL_PEEK
        _lower_nil_peek_branch(code, ctx, 36, lbl_at[str(inst.operand)]);
        return;
    }
    if op == 35 {                                      // OP_TRY -> inline try/catch
        let tc = pool[coff + inst.operand];
        let catch_lbl = _fresh(ctx);
        let end_lbl = _fresh(ctx);
        array_push(code, map{ op: 23, jmp: catch_lbl });   // OpTry -> handler
        _lower(code, tc.try_chunk, ctx, pool, scratch, len_idx, true);
        array_push(code, map{ op: 24 });                   // OpEndTry (success)
        array_push(code, map{ op: 35, jmp: end_lbl });     // OpJump end
        array_push(code, map{ label: catch_lbl });
        array_push(code, map{ op: 11 });                   // OpPop (discard error str)
        _lower(code, tc.catch_chunk, ctx, pool, scratch, len_idx, true);
        array_push(code, map{ label: end_lbl });
        return;
    }

    let rop = _rust_op(op);
    if rop < 0 {
        throw "selfhost_to_pbck: opcode " + str(op) + " has no Rust-VM equivalent yet";
    }
    if _sh_is_jump(op) {
        array_push(code, map{ op: rop, jmp: lbl_at[str(inst.operand)] });
        return;
    }
    if _rust_op_has_operand(rop) {
        let operand = try inst.operand catch 0;
        if _rust_op_is_const_operand(rop) { operand = coff + operand; }
        array_push(code, map{ op: rop, n: operand });
        return;
    }
    array_push(code, map{ op: rop });
}

// Lower a whole chunk into `code`. Merges constants into `pool`. When
// `drop_last_ret` is true (try/catch sub-chunks), the trailing OP_RETURN is
// omitted so the sub-chunk's value is left on the stack instead of returning from
// the enclosing function.
fn _lower(code, chunk, ctx, pool, scratch, len_idx, drop_last_ret) {
    let ins = chunk.instructions;
    let coff = len(pool);
    let ci = 0;
    while ci < len(chunk.constants) { array_push(pool, chunk.constants[ci]); ci = ci + 1; }

    let n = len(ins);

    // Assign a label to every jump target index (and to the end index).
    let lbl_at = map{};
    let i = 0;
    while i < n {
        if _sh_is_jump(ins[i].op) {
            let t = ins[i].operand;
            if not map_has(lbl_at, str(t)) { lbl_at[str(t)] = _fresh(ctx); }
        }
        i = i + 1;
    }
    if not map_has(lbl_at, str(n)) { lbl_at[str(n)] = _fresh(ctx); }

    i = 0;
    while i < n {
        if map_has(lbl_at, str(i)) { array_push(code, map{ label: lbl_at[str(i)] }); }
        let skip = drop_last_ret and i == n - 1 and ins[i].op == 19;   // trailing OP_RETURN
        if not skip {
            _lower_inst(code, ins[i], ctx, pool, coff, lbl_at, scratch, len_idx);
        }
        i = i + 1;
    }
    array_push(code, map{ label: lbl_at[str(n)] });   // end-of-chunk position
}

// The op of the last real (non-label) item in `code`, or -1.
fn _last_real_op(code) {
    let i = len(code) - 1;
    while i >= 0 {
        if not map_has(code[i], "label") { return code[i].op; }
        i = i - 1;
    }
    return (0 - 1);
}

// Emit one resolved code item to the byte buffer.
fn _emit_item(out, it, pos) {
    if map_has(it, "jmp") {
        _w_u8(out, it.op);
        _w_u32(out, pos[str(it.jmp)]);
        return;
    }
    if it.op == 27 {                                   // OpClosure (inline captures)
        _w_u8(out, 27);
        _w_u32(out, it.fnc);
        _w_u32(out, len(it.caps));
        let u = 0;
        while u < len(it.caps) {
            _w_u8(out, if it.caps[u].is_local { 1 } else { 0 });
            _w_u32(out, it.caps[u].index);
            u = u + 1;
        }
        return;
    }
    _w_u8(out, it.op);
    if map_has(it, "n") { _w_u32(out, it.n); }
}

// Emit a chunk (instructions, constants, spans, source_name) in the .pbck layout.
//
// Local-model bridge: the self-hosted compiler treats a `let` declaration inside a
// function as `expr; OP_SET_LOCAL slot` against a growable locals array, while the
// Rust VM's locals are stack-relative slots that must already exist (its OpSetLocal
// POPS then overwrites slot `stack_base+1+slot`). So at entry we push one `nil` per
// non-parameter local slot (plus one scratch slot used by the OP_LEN emulation).
//
// `is_top` appends an implicit `OpConstant(nil); OpReturn` to satisfy the Rust VM's
// main-chunk exit convention when the chunk doesn't already end in a return.
fn _emit_chunk(out, chunk, is_top, arity) {
    // Shared constant pool, seeded with the two constants the lowering needs.
    let pool = ["len", nil];
    let len_idx = 0;
    let nil_idx = 1;

    let maxloc = _max_local_slot(chunk.instructions, chunk.constants);
    let pad = (maxloc + 1) - arity;
    if pad < 0 { pad = 0; }
    let scratch = arity + pad;          // dedicated OP_LEN scratch slot
    let pad_total = pad + 1;            // real local placeholders + the scratch slot

    // Lower the chunk to label IR (this also merges chunk constants into `pool`).
    let body = [];
    let ctx = map{ n: 0 };
    _lower(body, chunk, ctx, pool, scratch, len_idx, false);

    // Assemble: entry placeholders, then the lowered body, then (top) a return.
    let code = [];
    let p = 0;
    while p < pad_total { array_push(code, map{ op: 0, n: nil_idx }); p = p + 1; }
    let bi = 0;
    while bi < len(body) { array_push(code, body[bi]); bi = bi + 1; }
    if is_top and _last_real_op(code) != 33 {
        array_push(code, map{ op: 0, n: nil_idx });    // OpConstant nil
        array_push(code, map{ op: 33 });               // OpReturn
    }

    // Resolve labels -> instruction indices.
    let pos = map{};
    let idx = 0;
    let i = 0;
    while i < len(code) {
        if map_has(code[i], "label") { pos[str(code[i].label)] = idx; }
        else { idx = idx + 1; }
        i = i + 1;
    }
    let n_ins = idx;

    // Emit instruction bytes.
    let ibytes = [];
    i = 0;
    while i < len(code) {
        if not map_has(code[i], "label") { _emit_item(ibytes, code[i], pos); }
        i = i + 1;
    }

    // chunk: instructions
    _w_u32(out, n_ins);
    let b = 0;
    while b < len(ibytes) { array_push(out, ibytes[b]); b = b + 1; }
    // constants
    _w_u32(out, len(pool));
    let k = 0;
    while k < len(pool) { _w_value(out, pool[k]); k = k + 1; }
    // spans: one zero span per instruction (keeps spans.len == instructions.len)
    _w_u32(out, n_ins);
    let s = 0;
    while s < n_ins { _w_u32(out, 0); _w_u32(out, 0); s = s + 1; }
    // source_name: none
    _w_u8(out, 0);
}

// Emit the Rust .pbck bytes for a self-hosted chunk-map.
fn translate(chunk) {
    let out = [];
    _w_u8(out, 80); _w_u8(out, 66); _w_u8(out, 67); _w_u8(out, 75);   // "PBCK"
    _w_u8(out, RUST_VERSION);
    _emit_chunk(out, chunk, true, 0);
    return out;
}

fn write_file(path, chunk) { return fs_write_bytes(path, translate(chunk)); }

// ── optimized translation ─────────────────────────────────────────────────────
// Run the self-hosted optimizer (sound `optimize_safe`: constant folding, dead
// code, jump simplification — NO strength reduction, which is unsound under
// operator overloading) over the chunk AND, recursively, every nested function /
// try sub-chunk, then translate. optimize_safe now deep-copies constants and
// recursively handles nested chunks, so this compatibility wrapper is one pass.
fn _opt_chunk_rec(chunk) {
    return OPTIMIZER.optimize_safe(chunk).chunk;
}

fn optimize_chunk(chunk) {
    return _opt_chunk_rec(chunk);
}

fn translate_optimized(chunk) { return translate(optimize_chunk(chunk)); }
fn write_file_optimized(path, chunk) { return fs_write_bytes(path, translate_optimized(chunk)); }

export translate, write_file, optimize_chunk, translate_optimized, write_file_optimized;
