// stdlib/selfhost_to_pbck.sapp — translate a SELF-HOSTED compiler chunk-map into
// the RUST .pbck bytecode container, so `pblang run file.pbck` (the native Rust
// VM) executes bytecode produced by the pblang-written compiler.
//
// Two impedance mismatches are bridged here:
//   1. Opcode NUMBERING differs above 15 (self-hosted ir.sapp vs the Rust OpCode
//      enum). `_rust_op` is the fixed translation table.
//   2. The Rust .pbck encodes constants/operands in a specific byte layout
//      (matches crates/pblang-ir::pbck_deserialize): magic "PBCK", u8 version=1,
//      then chunk = u32 n_ins, per-op (tag byte + u32 operand where applicable),
//      u32 n_const + values, u32 n_spans + (u32,u32), u8 has_source_name.
//
// Functions and closures: the self-hosted codegen now shares the Rust VM's
// calling convention (callee pushed first, then args — see codegen.sapp), so a
// self-hosted OP_CLOSURE/OP_CALL/OP_GET_UPVALUE stream maps directly onto the
// native VM. A self-hosted function constant `{arity, chunk, upvalues}` becomes a
// Rust Function value (tag 7), and OP_CLOSURE's capture list (stored on the fn
// constant) is inlined into the Rust OpClosure instruction. Function chunks are
// translated recursively.
//
// Remaining boundary: opcodes with no Rust-VM equivalent (the short-circuit
// *_PEEK jumps, OP_TRY/OP_THROW) and default-parameter metadata (defaults are
// baked into the body, so calls must pass the exact arity) still throw / are not
// represented — the documented next step.

let RUST_VERSION = 1;

// Self-hosted op number -> Rust OpCode tag. Identity for 0..15; remapped above.
// OP_CLOSURE (24) is NOT here: it needs inline captures and is handled in
// `_emit_instruction` directly.
fn _rust_op(op) {
    if op <= 15 { return op; }            // OP_CONSTANT..OP_SET_GLOBAL match exactly
    if op == 16 { return 25; }            // OP_GET_LOCAL  -> OpGetLocal
    if op == 17 { return 26; }            // OP_SET_LOCAL  -> OpSetLocal
    if op == 18 { return 31; }            // OP_CALL       -> OpCall
    if op == 19 { return 33; }            // OP_RETURN     -> OpReturn
    if op == 20 { return 35; }            // OP_JUMP       -> OpJump
    if op == 21 { return 36; }            // OP_JUMP_IF_FALSE -> OpJumpIfFalse
    if op == 22 { return 37; }            // OP_JUMP_IF_TRUE  -> OpJumpIfTrue
    if op == 23 { return 38; }            // OP_NOT        -> OpNot
    if op == 25 { return 19; }            // OP_MAKE_ARRAY -> OpMakeArray
    if op == 26 { return 20; }            // OP_MAKE_MAP   -> OpMakeMap
    if op == 27 { return 21; }            // OP_GET_INDEX  -> OpGetIndex
    if op == 28 { return 22; }            // OP_SET_INDEX  -> OpSetIndex
    if op == 29 { return 16; }            // OP_GET_ATTR   -> OpGetAttr
    if op == 30 { return 17; }            // OP_SET_ATTR   -> OpSetAttr
    if op == 31 { return 40; }            // OP_MOD        -> OpMod
    if op == 38 { return 28; }            // OP_GET_UPVALUE -> OpGetUpvalue
    if op == 39 { return 29; }            // OP_SET_UPVALUE -> OpSetUpvalue
    if op == 40 { return 47; }            // OP_THROW      -> OpThrow (uncaught raises)
    return (0 - 1);                       // unmapped (OP_LEN, OP_TRY, peek jumps handled separately)
}

// Rust ops that carry a single u32 operand in the .pbck layout.
fn _rust_op_has_operand(rop) {
    return rop == 0 or rop == 13 or rop == 14 or rop == 15 or rop == 16 or rop == 17
        or rop == 18 or rop == 19 or rop == 20 or rop == 23 or rop == 25 or rop == 26
        or rop == 28 or rop == 29 or rop == 31 or rop == 32 or rop == 35 or rop == 36
        or rop == 37 or rop == 42;
}

// ── byte writers ────────────────────────────────────────────────────────────
fn _w_u8(out, b) { array_push(out, bit_and(b, 255)); }
fn _w_u32(out, v) {
    _w_u8(out, v); _w_u8(out, bit_shr(v, 8)); _w_u8(out, bit_shr(v, 16)); _w_u8(out, bit_shr(v, 24));
}
fn _w_str(out, s) {
    let b = str_to_bytes(s);
    _w_u32(out, len(b));
    let i = 0;
    while i < len(b) { array_push(out, b[i]); i = i + 1; }
}
fn _w_f64(out, n) {
    let b = num_to_le_bytes(n);
    let i = 0;
    while i < 8 { array_push(out, b[i]); i = i + 1; }
}

// A self-hosted function constant is a map carrying a compiled body chunk plus
// arity/capture metadata (codegen.sapp::codegen_fn / codegen_fnlit).
fn _is_function_const(v) {
    return type(v) == "map" and map_has(v, "chunk") and map_has(v, "arity");
}

fn _w_value(out, v) {
    if v == nil { _w_u8(out, 2); return; }
    if _is_function_const(v) { _w_u8(out, 7); _w_function(out, v); return; }
    let t = type(v);
    if t == "number" { _w_u8(out, 0); _w_f64(out, v); return; }
    if t == "bool" { _w_u8(out, 1); _w_u8(out, if v { 1 } else { 0 }); return; }
    if t == "string" { _w_u8(out, 3); _w_str(out, v); return; }
    throw "selfhost_to_pbck: unsupported constant kind " + t;
}

// Encode a self-hosted function constant as a Rust Function (pbck tag 7 body).
// Defaults are compiled into the body, so min_arity == arity and the defaults
// list is empty (callers must pass the exact argument count).
fn _w_function(out, fc) {
    _w_u8(out, 0);              // name: None
    _w_u32(out, fc.arity);     // arity
    _w_u32(out, fc.arity);     // min_arity = arity
    _w_u32(out, 0);            // defaults: none
    _w_u8(out, 0);             // is_vararg: false
    _w_u8(out, 0);             // param_types: None
    _emit_chunk(out, fc.chunk, false, fc.arity);  // body chunk (ends in OP_RETURN)
}

// Rust jump ops carry an ABSOLUTE target instruction index (not a byte offset).
fn _is_rust_jump(rop) { return rop == 35 or rop == 36 or rop == 37; }

// How many Rust instructions a self-hosted op expands to, or -1 if unmapped.
// Most ops are 1:1. The self-hosted short-circuit / nil-coalescing *_PEEK jumps
// have no native equivalent and are emulated with OpDup(+OpIsNil)+OpJumpIf*.
fn _emit_count(op) {
    if op == 33 or op == 34 { return 2; }          // PEEK false/true -> Dup; JumpIf*
    if op == 36 or op == 37 { return 3; }          // PEEK nil/not-nil -> Dup; IsNil; JumpIf*
    if op == 24 { return 1; }                      // OP_CLOSURE (captures are inline operands)
    if _rust_op(op) >= 0 { return 1; }
    return (0 - 1);
}

// Map a self-hosted target index to its Rust index via the precomputed table;
// a target one past the end (jump-to-end) resolves to `rend`.
fn _resolve_target(t, ridx, rend) {
    if t < len(ridx) { return ridx[t]; }
    return rend;
}

// Emit one self-hosted instruction (possibly several Rust ops); returns the Rust
// instruction count emitted. `ridx`/`rend` remap absolute jump targets.
fn _emit_instruction(out, inst, consts, ridx, rend) {
    let op = inst.op;
    if op == 24 {                          // OP_CLOSURE -> OpClosure (tag 27)
        let fn_idx = inst.operand;
        let fc = consts[fn_idx];
        let ups = try fc.upvalues catch [];
        _w_u8(out, 27);
        _w_u32(out, fn_idx);               // constant index — not a jump target
        _w_u32(out, len(ups));
        let u = 0;
        while u < len(ups) {
            _w_u8(out, if ups[u].is_local { 1 } else { 0 });
            _w_u32(out, ups[u].index);
            u = u + 1;
        }
        return 1;
    }
    if op == 33 {                          // JUMP_IF_FALSE_PEEK -> Dup; JumpIfFalse
        _w_u8(out, 46);
        _w_u8(out, 36); _w_u32(out, _resolve_target(inst.operand, ridx, rend));
        return 2;
    }
    if op == 34 {                          // JUMP_IF_TRUE_PEEK -> Dup; JumpIfTrue
        _w_u8(out, 46);
        _w_u8(out, 37); _w_u32(out, _resolve_target(inst.operand, ridx, rend));
        return 2;
    }
    if op == 36 {                          // JUMP_IF_NIL_PEEK -> Dup; IsNil; JumpIfTrue
        _w_u8(out, 46);
        _w_u8(out, 45);
        _w_u8(out, 37); _w_u32(out, _resolve_target(inst.operand, ridx, rend));
        return 3;
    }
    if op == 37 {                          // JUMP_IF_NOT_NIL_PEEK -> Dup; IsNil; JumpIfFalse
        _w_u8(out, 46);
        _w_u8(out, 45);
        _w_u8(out, 36); _w_u32(out, _resolve_target(inst.operand, ridx, rend));
        return 3;
    }
    let rop = _rust_op(op);
    if rop < 0 {
        throw "selfhost_to_pbck: opcode " + str(op) + " has no Rust-VM equivalent yet";
    }
    _w_u8(out, rop);
    if _rust_op_has_operand(rop) {
        let operand = try inst.operand catch 0;
        if _is_rust_jump(rop) { operand = _resolve_target(operand, ridx, rend); }
        _w_u32(out, operand);
    }
    return 1;
}

// Highest local slot referenced by OP_GET_LOCAL(16)/OP_SET_LOCAL(17), or -1.
fn _max_local_slot(ins) {
    let m = 0 - 1;
    let i = 0;
    while i < len(ins) {
        let op = ins[i].op;
        if op == 16 or op == 17 {
            let s = try ins[i].operand catch 0;
            if s > m { m = s; }
        }
        i = i + 1;
    }
    return m;
}

// Emit a chunk (instructions, constants, spans, source_name) in the .pbck layout.
//
// Local-model bridge: the self-hosted compiler treats a `let` DECLARATION inside
// a function as `expr; OP_SET_LOCAL slot` against a growable locals array, but the
// Rust VM's locals are stack-relative slots that must already exist (its OpSetLocal
// pops and overwrites slot `stack_base+1+slot`). So at function entry we push one
// `nil` per non-parameter local slot (arity..max_slot); now every OP_SET_LOCAL has
// a slot to write and slot NUMBERS are unchanged.
//
// Because the entry pad and the *_PEEK expansions change instruction indices, a
// first pass computes each self-hosted index's Rust index (`ridx`) so jump targets
// remap exactly; the second pass emits with remapped targets.
//
// `is_top` additionally appends an implicit `OpConstant(nil); OpReturn` to satisfy
// the Rust VM's main-chunk exit convention when the chunk doesn't end in a return.
fn _emit_chunk(out, chunk, is_top, arity) {
    let ins = chunk.instructions;
    let consts = chunk.constants;

    // Copy constants (we may append nil placeholders / a trailing-return nil).
    let out_consts = [];
    let ci = 0;
    while ci < len(consts) { array_push(out_consts, consts[ci]); ci = ci + 1; }

    // Placeholder local slots to pre-push at entry.
    let pad = (_max_local_slot(ins) + 1) - arity;
    if pad < 0 { pad = 0; }

    // Pass 1: Rust instruction index for each self-hosted instruction index.
    let ridx = [];
    let acc = pad;
    let i = 0;
    while i < len(ins) {
        array_push(ridx, acc);
        let c = _emit_count(ins[i].op);
        if c < 0 {
            throw "selfhost_to_pbck: opcode " + str(ins[i].op) + " has no Rust-VM equivalent yet";
        }
        acc = acc + c;
        i = i + 1;
    }
    let rend = acc;   // index one past the last body instruction (jump-to-end)

    let ibytes = [];
    let n_ins = 0;

    if pad > 0 {
        array_push(out_consts, nil);
        let nil_idx = len(out_consts) - 1;
        let p = 0;
        while p < pad {
            _w_u8(ibytes, 0); _w_u32(ibytes, nil_idx);   // OpConstant nil
            n_ins = n_ins + 1;
            p = p + 1;
        }
    }

    // Pass 2: body instructions with remapped jump targets.
    i = 0;
    while i < len(ins) {
        n_ins = n_ins + _emit_instruction(ibytes, ins[i], consts, ridx, rend);
        i = i + 1;
    }

    if is_top {
        let last_ret = len(ins) > 0 and _rust_op(ins[len(ins) - 1].op) == 33;
        if not last_ret {
            array_push(out_consts, nil);
            _w_u8(ibytes, 0); _w_u32(ibytes, len(out_consts) - 1);  // OpConstant nil
            _w_u8(ibytes, 33);                                       // OpReturn
            n_ins = n_ins + 2;
        }
    }

    // instructions
    _w_u32(out, n_ins);
    let b = 0;
    while b < len(ibytes) { array_push(out, ibytes[b]); b = b + 1; }
    // constants
    _w_u32(out, len(out_consts));
    let k = 0;
    while k < len(out_consts) { _w_value(out, out_consts[k]); k = k + 1; }
    // spans: one zero span per instruction (keeps spans.len == instructions.len)
    _w_u32(out, n_ins);
    let s = 0;
    while s < n_ins { _w_u32(out, 0); _w_u32(out, 0); s = s + 1; }
    // source_name: none
    _w_u8(out, 0);
}

// Emit the Rust .pbck bytes for a self-hosted chunk-map.
fn translate(chunk) {
    let out = [];
    _w_u8(out, 80); _w_u8(out, 66); _w_u8(out, 67); _w_u8(out, 75);   // "PBCK"
    _w_u8(out, RUST_VERSION);
    _emit_chunk(out, chunk, true, 0);
    return out;
}

fn write_file(path, chunk) { return fs_write_bytes(path, translate(chunk)); }

export translate, write_file;
