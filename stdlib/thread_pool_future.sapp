// Internal future subset for thread_pool. Keep independent of the full thread
// API. Accepts the unmodified go-future shape, owned by the creating VM; eager
// promises, cross-VM use and concurrent mutation are not supported here.
// Launch/transfer handling is shared with async and thread through this worker.
let WORKER = import("stdlib:async_worker.sapp");

fn go(task_fn) {
    let future = WORKER.launch(task_fn);
    return map{__go:true, __ch:future.channel, __handle:future.worker,
        __value:nil, __resolved:false};
}

fn settle(future, msg) {
    let joined = try {join(future.__handle); true} catch false;
    // An unbounded receive can hit the retained host's internal wait limit.
    // Recover the late terminal envelope after the worker actually finishes.
    if msg == nil and joined { msg = recv_timeout(future.__ch.receiver, 0); }
    future.__value = if joined and msg != nil and msg.ok == true {msg.value} else {nil};
    future.__resolved = true;
    channel_close(future.__ch.sender);
    return future.__value;
}

fn await(future) {
    if not future.__resolved {return settle(future, recv(future.__ch.receiver));}
    return future.__value;
}

// `ok` means terminal, including failed/nil tasks, exactly as in thread.await_timeout.
// The public pool facade validates the duration before reaching this backend.
fn await_timeout(future, ms) {
    if not future.__resolved {
        let msg = recv_timeout(future.__ch.receiver, ms);
        if msg == nil and not channel_is_closed(future.__ch.receiver) {
            return map{ok:false,value:nil};
        }
        settle(future, msg);
    }
    return map{ok:true,value:future.__value};
}
export go, await, await_timeout;
