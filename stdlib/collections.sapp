// stdlib/collections.sapp — Stack, Queue, Set helpers

// ---- Stack (LIFO): backed by a plain array ----
// stack IS the array — len(stack) and stack[i] work directly.

fn stack_new() { return []; }

fn stack_push(s, v) {
    array_push(s, v);
    return len(s);
}

fn stack_pop(s) {
    let n = len(s);
    if n == 0 { return nil; }
    let v = s[n - 1];
    array_pop(s);
    return v;
}

fn stack_peek(s) {
    let n = len(s);
    if n == 0 { return nil; }
    return s[n - 1];
}

fn stack_size(s) { return len(s); }
fn stack_is_empty(s) { return len(s) == 0; }

// ---- Queue (FIFO): backed by a plain array ----
// queue IS the array — len(queue) and queue[i] work directly.
// dequeue keeps the legacy array representation for source compatibility.
// For O(1) front operations use stdlib:deque.sapp.

fn queue_new() { return []; }

fn queue_enqueue(q, v) {
    array_push(q, v);
    return len(q);
}

fn queue_dequeue(q) {
    if len(q) == 0 { return nil; }
    let v = q[0];
    let i = 0;
    while i < len(q) - 1 { q[i] = q[i + 1]; i = i + 1; }
    array_pop(q);
    return v;
}

fn queue_peek(q) {
    if len(q) == 0 { return nil; }
    return q[0];
}

fn queue_size(q) { return len(q); }
fn queue_is_empty(q) { return len(q) == 0; }

// ---- Set: backed by a map (key = str(value), value = original) ----

fn set_new() { return map{}; }

fn set_add(st, v) {
    st[str(v)] = v;
    return st;
}

fn set_has(st, v) { return map_has(st, str(v)); }

fn set_remove(st, v) {
    map_remove(st, str(v));
    return st;
}

fn set_size(st) { return len(map_keys(st)); }

fn set_to_array(st) {
    let ks = map_keys(st);
    let r = [];
    for i len(ks) { array_push(r, st[ks[i]]); }
    return r;
}

fn set_union(s1, s2) {
    let result = set_new();
    let k1 = map_keys(s1);
    for i len(k1) { set_add(result, s1[k1[i]]); }
    let k2 = map_keys(s2);
    for i len(k2) { set_add(result, s2[k2[i]]); }
    return result;
}

fn set_intersect(s1, s2) {
    let result = set_new();
    let k1 = map_keys(s1);
    for i len(k1) {
        let v = s1[k1[i]];
        if set_has(s2, v) { set_add(result, v); }
    }
    return result;
}

export stack_new, stack_push, stack_pop, stack_peek, stack_size, stack_is_empty,
       queue_new, queue_enqueue, queue_dequeue, queue_peek, queue_size, queue_is_empty,
       set_new, set_add, set_has, set_remove, set_size, set_to_array,
       set_union, set_intersect;
