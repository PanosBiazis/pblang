// stdlib/collections.sapp — Stack, Queue, Set (G3-alpha)

fn stack_new() { return []; }
fn stack_push(s, v) { array_push(s, v); return len(s); }
fn stack_pop(s) {
    let n = len(s);
    if n == 0 { return nil; }
    let v = s[n - 1];
    array_pop(s);
    return v;
}
fn stack_peek(s) {
    let n = len(s);
    if n == 0 { return nil; }
    return s[n - 1];
}
fn stack_size(s) { return len(s); }
fn stack_is_empty(s) { return len(s) == 0; }

fn queue_new() { return map{ data: [], head: 0 }; }
fn queue_enqueue(q, v) {
    array_push(q.data, v);
    return len(q.data) - q.head;
}
fn queue_dequeue(q) {
    if q.head >= len(q.data) { return nil; }
    let v = q.data[q.head];
    q.head = q.head + 1;
    return v;
}
fn queue_peek(q) {
    if q.head >= len(q.data) { return nil; }
    return q.data[q.head];
}
fn queue_size(q) { return len(q.data) - q.head; }
fn queue_is_empty(q) { return q.head >= len(q.data); }

fn set_new() { return map{}; }
fn set_add(st, v) { st[str(v)] = v; return st; }
fn set_has(st, v) { return map_has(st, str(v)); }
fn set_remove(st, v) { map_remove(st, str(v)); return st; }
fn set_size(st) { return len(map_keys(st)); }
fn set_to_array(st) {
    let ks = map_keys(st);
    let r = [];
    for i len(ks) { array_push(r, st[ks[i]]); }
    return r;
}

export stack_new, stack_push, stack_pop, stack_peek, stack_size, stack_is_empty,
       queue_new, queue_enqueue, queue_dequeue, queue_peek, queue_size, queue_is_empty,
       set_new, set_add, set_has, set_remove, set_size, set_to_array;
