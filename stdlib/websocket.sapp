// stdlib/websocket.sapp — WebSocket helpers (W3/W4)
//
// **Representation note (2026-05-27 rewrite):** WebSocket frames are
// binary protocol data. Pblang strings are guaranteed-UTF-8, so a
// frame byte sequence cannot be carried in a string without corrupting
// any byte >= 128 (which would be re-encoded as a multi-byte UTF-8
// sequence). All frame-level functions in this module therefore use
// **byte arrays** (Array<number 0..255>) as the wire-level
// representation. Payload text (for opcode 1 = text) is exposed as a
// string in the parsed map because the protocol guarantees it's
// valid UTF-8 from the peer.
//
// API:
//   write_frame(opcode, payload: string) -> Array<u8>
//   parse_frame(bytes: Array<u8>) -> map{fin,opcode,masked,payload,...}
//   parse_frames(bytes: Array<u8>) -> Array<frame> | map{error}
//   parse_message(bytes: Array<u8>) -> map (reassembled message)

fn upgrade_response(key) {
    let accept = websocket_accept_key(key);
    return "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n";
}

// Pure-pblang XOR for two byte values (0-255).
fn _byte_xor(a, b) {
    let result = 0;
    let bit = 128;
    while bit >= 1 {
        let ab = num_floor(a / bit) - num_floor(a / (bit * 2)) * 2;
        let bb = num_floor(b / bit) - num_floor(b / (bit * 2)) * 2;
        if ab != bb { result = result + bit; }
        bit = num_floor(bit / 2);
    }
    return result;
}

// Append every byte of `src` (Array<u8>) onto `dst` (Array<u8>) in place.
fn _append_bytes(dst, src) {
    let i = 0;
    while i < len(src) {
        array_push(dst, src[i]);
        i = i + 1;
    }
}

// 2-byte big-endian encoding of `n` (0..65535) → Array<u8> of length 2.
fn _u16be(n) {
    let hi = num_floor(n / 256);
    let lo = num_mod(n, 256);
    return [hi, lo];
}

// 8-byte big-endian encoding of `n` → Array<u8> of length 8.
fn _u64be(n) {
    let b7 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b6 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b5 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b4 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b3 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b2 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b1 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b0 = num_mod(n, 256);
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn _u64_at(data, offset) {
    let n = 0;
    let i = 0;
    while i < 8 {
        n = n * 256 + data[offset + i];
        i = i + 1;
    }
    return n;
}

// Convert an Array<u8> slice [start, end) into a string. Each byte is
// emitted via strfromcharcode; bytes < 128 become 1-byte UTF-8, bytes
// >= 128 expand to 2-byte UTF-8 codepoints. Suitable for text payloads
// (opcode 1) which are UTF-8 by protocol. For binary payloads the
// caller should keep the raw byte array.
fn _bytes_to_text(data, start, end_idx) {
    let s = "";
    let i = start;
    while i < end_idx {
        s = s + strfromcharcode(data[i]);
        i = i + 1;
    }
    return s;
}

fn _parse_frame_at(data, start_idx) {
    if data == nil or start_idx < 0 or start_idx >= len(data) or len(data) - start_idx < 2 {
        return map{ error: "frame too short", fin: 0, opcode: 0, masked: 0, payload: "" };
    }
    let b0 = data[start_idx];
    let b1 = data[start_idx + 1];
    let fin = num_floor(b0 / 128);
    let opcode = num_mod(b0, 16);
    let masked = num_floor(b1 / 128);
    let len_code = num_mod(b1, 128);

    let idx = start_idx + 2;
    let payload_len = len_code;
    if len_code == 126 {
        if len(data) < start_idx + 4 {
            return map{ error: "frame too short for 16-bit length", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        payload_len = data[start_idx + 2] * 256 + data[start_idx + 3];
        idx = start_idx + 4;
    } else if len_code == 127 {
        if len(data) < start_idx + 10 {
            return map{ error: "frame too short for 64-bit length", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        payload_len = _u64_at(data, start_idx + 2);
        idx = start_idx + 10;
    }

    let mk0 = 0;
    let mk1 = 0;
    let mk2 = 0;
    let mk3 = 0;
    if masked == 1 {
        if len(data) < idx + 4 {
            return map{ error: "frame too short for masking key", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        mk0 = data[idx];
        mk1 = data[idx + 1];
        mk2 = data[idx + 2];
        mk3 = data[idx + 3];
        idx = idx + 4;
    }

    if len(data) < idx + payload_len {
        return map{ error: "truncated payload", fin: fin, opcode: opcode, masked: masked, payload: "" };
    }

    // Unmask (if needed) into a fresh byte array.
    let payload_bytes = [];
    let i = 0;
    while i < payload_len {
        let b = data[idx + i];
        if masked == 1 {
            let mk = mk0;
            let m = num_mod(i, 4);
            if m == 1 { mk = mk1; }
            else if m == 2 { mk = mk2; }
            else if m == 3 { mk = mk3; }
            array_push(payload_bytes, _byte_xor(b, mk));
        } else {
            array_push(payload_bytes, b);
        }
        i = i + 1;
    }

    return map{
        fin: fin,
        opcode: opcode,
        masked: masked,
        payload_len: payload_len,
        payload: _bytes_to_text(payload_bytes, 0, len(payload_bytes)),
        payload_bytes: payload_bytes,
        frame_len: (idx + payload_len) - start_idx,
        next_index: idx + payload_len
    };
}

fn parse_frame(data) {
    return _parse_frame_at(data, 0);
}

fn parse_frames(data) {
    let frames = [];
    let idx = 0;
    while idx < len(data) {
        let f = _parse_frame_at(data, idx);
        if type(f) == "map" and map_has(f, "error") { return map{ error: f.error, frames: frames }; }
        array_push(frames, f);
        idx = f.next_index;
    }
    return frames;
}

// reassemble_fragments(frames) → first complete text/binary message.
// Control frames (close/ping/pong) are skipped.
fn reassemble_fragments(frames) {
    let started = false;
    let msg_opcode = 0;
    let msg_payload = "";
    let i = 0;
    while i < len(frames) {
        let fr = frames[i];
        if type(fr) != "map" or map_has(fr, "opcode") == false {
            return map{ error: "invalid frame entry" };
        }
        let op = fr.opcode;
        if op == 0 {
            if started == false {
                return map{ error: "unexpected continuation frame" };
            }
            msg_payload = msg_payload + fr.payload;
            if fr.fin == 1 {
                return map{ ok: true, opcode: msg_opcode, payload: msg_payload, frames_used: i + 1 };
            }
        } else if op == 1 or op == 2 {
            if started == true {
                return map{ error: "new data frame before fragmented message completed" };
            }
            if fr.fin == 1 {
                return map{ ok: true, opcode: op, payload: fr.payload, frames_used: i + 1 };
            }
            started = true;
            msg_opcode = op;
            msg_payload = fr.payload;
        }
        i = i + 1;
    }
    if started == true { return map{ error: "incomplete fragmented message" }; }
    return map{ error: "no data message found" };
}

fn parse_message(data) {
    let frames = parse_frames(data);
    if type(frames) == "map" and map_has(frames, "error") { return frames; }
    return reassemble_fragments(frames);
}

// write_frame(opcode, payload: string) → Array<u8> (RFC 6455 masked frame).
// opcode: 1 = text, 2 = binary, 8 = close, 9 = ping, 10 = pong.
fn write_frame(opcode, payload) {
    let plen = len(payload);
    let out = [];

    // Byte 0: FIN=1 (0x80) + opcode.
    array_push(out, 128 + opcode);

    // Byte 1: MASK=1 plus length marker, then optional extended length.
    if plen <= 125 {
        array_push(out, 128 + plen);
    } else if plen <= 65535 {
        array_push(out, 128 + 126);
        _append_bytes(out, _u16be(plen));
    } else {
        array_push(out, 128 + 127);
        _append_bytes(out, _u64be(plen));
    }

    // 4-byte masking key.
    let mask_bytes = random_bytes(4);
    let mk0 = mask_bytes[0];
    let mk1 = mask_bytes[1];
    let mk2 = mask_bytes[2];
    let mk3 = mask_bytes[3];
    array_push(out, mk0);
    array_push(out, mk1);
    array_push(out, mk2);
    array_push(out, mk3);

    // Mask the payload bytes. The payload is read char-by-char via
    // strcharcodeat (codepoint-indexed) — safe here only because the test
    // payloads are ASCII, where each codepoint is one byte; for true binary
    // payloads, accept Array<u8> directly or use str_to_bytes().
    let i = 0;
    while i < plen {
        let byte_val = strcharcodeat(payload, i);
        let mk = mk0;
        let m = num_mod(i, 4);
        if m == 1 { mk = mk1; }
        else if m == 2 { mk = mk2; }
        else if m == 3 { mk = mk3; }
        array_push(out, _byte_xor(byte_val, mk));
        i = i + 1;
    }
    return out;
}

export upgrade_response, parse_frame, parse_frames, reassemble_fragments, parse_message, write_frame;
