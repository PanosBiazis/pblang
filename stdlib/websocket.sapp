// stdlib/websocket.sapp — WebSocket helpers (W3/W4)
//
// **Representation note (2026-05-27 rewrite):** WebSocket frames are
// binary protocol data. Pblang strings are guaranteed-UTF-8, so a
// frame byte sequence cannot be carried in a string without corrupting
// any byte >= 128 (which would be re-encoded as a multi-byte UTF-8
// sequence). All frame-level functions in this module therefore use
// **byte arrays** (Array<number 0..255>) as the wire-level
// representation. Payload text (for opcode 1 = text) is exposed as a
// string in the parsed map because the protocol guarantees it's
// valid UTF-8 from the peer.
//
// API:
//   write_frame(opcode, payload: string) -> Array<u8>
//   parse_frame(bytes: Array<u8>) -> map{fin,opcode,masked,payload,...}
//   parse_frames(bytes: Array<u8>) -> Array<frame> | map{error}
//   parse_message(bytes: Array<u8>) -> map (reassembled message)

// Frame-size limit (configurable): a frame whose declared payload exceeds this is
// rejected by the parser BEFORE allocating, so a malicious/oversized length cannot
// exhaust memory.
let _CFG = map{ max_payload: 16777216 };   // 16 MiB
fn set_max_payload(n) { _CFG.max_payload = n; return _CFG.max_payload; }
fn get_max_payload() { return _CFG.max_payload; }

fn upgrade_response(key) {
    let accept = websocket_accept_key(key);
    return "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n";
}

// request_key(request) — the client's Sec-WebSocket-Key from a raw GET upgrade
// request (case-insensitive header), or nil if absent. Feed it to
// upgrade_response / server_accept.
fn request_key(request) {
    return _header_value(request, "Sec-WebSocket-Key");
}

// is_upgrade_request(request) — true only for a well-formed RFC 6455 upgrade:
// an Upgrade: websocket header, a Connection header naming Upgrade, and a key.
// Tokens are matched case-insensitively (RFC 7230 §3.2).
fn is_upgrade_request(request) {
    let up = _header_value(request, "Upgrade");
    if up == nil or str_lower(up) != "websocket" { return false; }
    let conn = _header_value(request, "Connection");
    if conn == nil or not str_contains(str_lower(conn), "upgrade") { return false; }
    return request_key(request) != nil;
}

// server_accept(request) — the full 101 handshake response for a client
// request, with the Sec-WebSocket-Accept derived from its key. Returns nil if
// the request is not a valid websocket upgrade (the server should 400/close).
fn server_accept(request) {
    if not is_upgrade_request(request) { return nil; }
    return upgrade_response(request_key(request));
}

// ── Client-side opening handshake (RFC 6455 §4.1) ────────────────────────────

// client_key() — a fresh Sec-WebSocket-Key: 16 random bytes, base64-encoded.
// The nonce MUST be random per connection (a fixed key lets a cache/proxy
// replay an old 101 response), which is exactly what the old networking.sapp
// client got wrong with its hardcoded sample key.
fn client_key() {
    return base64_encode_bytes(random_bytes(16));
}

// client_accept_for(key) — the Sec-WebSocket-Accept the server MUST return for
// `key` (base64(SHA1(key + GUID))). The client compares this to the response.
fn client_accept_for(key) {
    return websocket_accept_key(key);
}

// client_handshake_request(host, path, key, extra_headers?) — the GET upgrade
// request a client sends. `extra_headers` is an optional map of name->value
// (e.g. Origin, Sec-WebSocket-Protocol). Header names/values are single-line;
// CR/LF in them is stripped to prevent request-splitting injection.
fn _sanitize_header(v) {
    let s = str(v);
    s = str_replace_all(s, "\r", "");
    s = str_replace_all(s, "\n", "");
    return s;
}
fn client_handshake_request(host, path, key, extra_headers = nil) {
    let p = str(path);
    if p == "" { p = "/"; }
    let req = "GET " + _sanitize_header(p) + " HTTP/1.1\r\n"
        + "Host: " + _sanitize_header(host) + "\r\n"
        + "Upgrade: websocket\r\n"
        + "Connection: Upgrade\r\n"
        + "Sec-WebSocket-Key: " + _sanitize_header(key) + "\r\n"
        + "Sec-WebSocket-Version: 13\r\n";
    if extra_headers != nil {
        let ks = map_keys(extra_headers);
        let i = 0;
        while i < len(ks) {
            req = req + _sanitize_header(ks[i]) + ": " + _sanitize_header(extra_headers[ks[i]]) + "\r\n";
            i = i + 1;
        }
    }
    return req + "\r\n";
}

// handshake_status(response) — the numeric HTTP status of a handshake response
// ("HTTP/1.1 101 Switching Protocols" -> 101), or 0 if unparseable.
fn handshake_status(response) {
    let line_end = str_index_of(response, "\r\n");
    let first = response;
    if line_end >= 0 { first = str_slice(response, 0, line_end); }
    let parts = str_split(first, " ");
    if len(parts) < 2 { return 0; }
    return try parse_number(parts[1]) catch 0;
}

// _header_value(response, name) — case-insensitive header lookup over the
// response head (up to the blank line), or nil if absent.
fn _header_value(response, name) {
    let target = str_lower(str(name));
    let head_end = str_index_of(response, "\r\n\r\n");
    let head = response;
    if head_end >= 0 { head = str_slice(response, 0, head_end); }
    let lines = str_split(head, "\r\n");
    let i = 1;   // skip the status line
    while i < len(lines) {
        let line = lines[i];
        let colon = str_index_of(line, ":");
        if colon > 0 {
            let k = str_lower(str_trim(str_slice(line, 0, colon)));
            if k == target {
                return str_trim(str_slice(line, colon + 1, len(line)));
            }
        }
        i = i + 1;
    }
    return nil;
}

// verify_handshake(response, key) — true only when the server returned 101 AND
// Sec-WebSocket-Accept exactly matches the value derived from our key. Anything
// else (wrong accept, non-101, missing header) is a rejected/hostile peer.
fn verify_handshake(response, key) {
    if handshake_status(response) != 101 { return false; }
    let accept = _header_value(response, "Sec-WebSocket-Accept");
    if accept == nil { return false; }
    return accept == client_accept_for(key);
}

// Append every byte of `src` (Array<u8>) onto `dst` (Array<u8>) in place.
fn _append_bytes(dst, src) {
    let i = 0;
    while i < len(src) {
        array_push(dst, src[i]);
        i = i + 1;
    }
}

// 2-byte big-endian encoding of `n` (0..65535) → Array<u8> of length 2.
fn _u16be(n) {
    let hi = num_floor(n / 256);
    let lo = num_mod(n, 256);
    return [hi, lo];
}

// 8-byte big-endian encoding of `n` → Array<u8> of length 8.
fn _u64be(n) {
    let b7 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b6 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b5 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b4 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b3 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b2 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b1 = num_mod(n, 256);
    n = num_floor(n / 256);
    let b0 = num_mod(n, 256);
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn _u64_at(data, offset) {
    let n = 0;
    let i = 0;
    while i < 8 {
        n = n * 256 + data[offset + i];
        i = i + 1;
    }
    return n;
}

fn _parse_frame_at(data, start_idx) {
    if data == nil or start_idx < 0 or start_idx >= len(data) or len(data) - start_idx < 2 {
        return map{ error: "frame too short", fin: 0, opcode: 0, masked: 0, payload: "" };
    }
    let b0 = data[start_idx];
    let b1 = data[start_idx + 1];
    let fin = num_floor(b0 / 128);
    let opcode = num_mod(b0, 16);
    let masked = num_floor(b1 / 128);
    let len_code = num_mod(b1, 128);

    let idx = start_idx + 2;
    let payload_len = len_code;
    if len_code == 126 {
        if len(data) < start_idx + 4 {
            return map{ error: "frame too short for 16-bit length", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        payload_len = data[start_idx + 2] * 256 + data[start_idx + 3];
        idx = start_idx + 4;
    } else if len_code == 127 {
        if len(data) < start_idx + 10 {
            return map{ error: "frame too short for 64-bit length", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        payload_len = _u64_at(data, start_idx + 2);
        idx = start_idx + 10;
    }

    let mk0 = 0;
    let mk1 = 0;
    let mk2 = 0;
    let mk3 = 0;
    if masked == 1 {
        if len(data) < idx + 4 {
            return map{ error: "frame too short for masking key", fin: fin, opcode: opcode, masked: masked, payload: "" };
        }
        mk0 = data[idx];
        mk1 = data[idx + 1];
        mk2 = data[idx + 2];
        mk3 = data[idx + 3];
        idx = idx + 4;
    }

    // Reject an oversized DECLARED payload before allocating (DoS guard).
    if payload_len > _CFG.max_payload {
        return map{ error: "payload too large", fin: fin, opcode: opcode, masked: masked, payload: "" };
    }

    if len(data) < idx + payload_len {
        return map{ error: "truncated payload", fin: fin, opcode: opcode, masked: masked, payload: "" };
    }

    // Unmask (if needed) into a fresh byte array, using the native bit_xor.
    let payload_bytes = [];
    let i = 0;
    while i < payload_len {
        let b = data[idx + i];
        if masked == 1 {
            let mk = mk0;
            let m = num_mod(i, 4);
            if m == 1 { mk = mk1; }
            else if m == 2 { mk = mk2; }
            else if m == 3 { mk = mk3; }
            array_push(payload_bytes, bit_xor(b, mk));
        } else {
            array_push(payload_bytes, b);
        }
        i = i + 1;
    }

    return map{
        fin: fin,
        opcode: opcode,
        masked: masked,
        payload_len: payload_len,
        // Text payloads (opcode 1) are UTF-8 by protocol -> decode with bytes_to_str;
        // for binary/invalid bytes this is meaningless (use payload_bytes), so guard
        // it so a non-UTF-8 payload can't crash the parser.
        payload: try bytes_to_str(payload_bytes) catch "",
        payload_bytes: payload_bytes,
        frame_len: (idx + payload_len) - start_idx,
        next_index: idx + payload_len
    };
}

fn parse_frame(data) {
    return _parse_frame_at(data, 0);
}

// parse_frame_at(data, idx) — public single-frame parse at a byte offset, for
// incremental stream parsing (a streaming client keeps a byte buffer and calls
// this at the running offset, stopping when it returns { error } = incomplete).
fn parse_frame_at(data, idx) {
    return _parse_frame_at(data, idx);
}

fn parse_frames(data) {
    let frames = [];
    let idx = 0;
    while idx < len(data) {
        let f = _parse_frame_at(data, idx);
        if type(f) == "map" and map_has(f, "error") { return map{ error: f.error, frames: frames }; }
        array_push(frames, f);
        idx = f.next_index;
    }
    return frames;
}

// reassemble_fragments(frames) → first complete text/binary message.
// Control frames (close/ping/pong) are skipped.
fn reassemble_fragments(frames) {
    let started = false;
    let msg_opcode = 0;
    let msg_payload = "";
    let i = 0;
    while i < len(frames) {
        let fr = frames[i];
        if type(fr) != "map" or map_has(fr, "opcode") == false {
            return map{ error: "invalid frame entry" };
        }
        let op = fr.opcode;
        if op == 0 {
            if started == false {
                return map{ error: "unexpected continuation frame" };
            }
            msg_payload = msg_payload + fr.payload;
            if fr.fin == 1 {
                return map{ ok: true, opcode: msg_opcode, payload: msg_payload, frames_used: i + 1 };
            }
        } else if op == 1 or op == 2 {
            if started == true {
                return map{ error: "new data frame before fragmented message completed" };
            }
            if fr.fin == 1 {
                return map{ ok: true, opcode: op, payload: fr.payload, frames_used: i + 1 };
            }
            started = true;
            msg_opcode = op;
            msg_payload = fr.payload;
        }
        i = i + 1;
    }
    if started == true { return map{ error: "incomplete fragmented message" }; }
    return map{ error: "no data message found" };
}

fn parse_message(data) {
    let frames = parse_frames(data);
    if type(frames) == "map" and map_has(frames, "error") { return frames; }
    return reassemble_fragments(frames);
}

// _write_frame_bytes(opcode, bytes: Array<u8>) → RFC 6455 masked frame (Array<u8>).
// The framing core: the length and masking operate on raw BYTES, so any payload
// (binary, or UTF-8 text via str_to_bytes) is framed correctly on the wire.
fn _write_frame_bytes(opcode, bytes) {
    let plen = len(bytes);
    let out = [];

    // Byte 0: FIN=1 (0x80) + opcode.
    array_push(out, 128 + opcode);

    // Byte 1: MASK=1 plus length marker, then optional extended length.
    if plen <= 125 {
        array_push(out, 128 + plen);
    } else if plen <= 65535 {
        array_push(out, 128 + 126);
        _append_bytes(out, _u16be(plen));
    } else {
        array_push(out, 128 + 127);
        _append_bytes(out, _u64be(plen));
    }

    // 4-byte masking key.
    let mask_bytes = random_bytes(4);
    let mk0 = mask_bytes[0]; let mk1 = mask_bytes[1];
    let mk2 = mask_bytes[2]; let mk3 = mask_bytes[3];
    array_push(out, mk0); array_push(out, mk1); array_push(out, mk2); array_push(out, mk3);

    let i = 0;
    while i < plen {
        let mk = mk0;
        let m = num_mod(i, 4);
        if m == 1 { mk = mk1; }
        else if m == 2 { mk = mk2; }
        else if m == 3 { mk = mk3; }
        array_push(out, bit_xor(bytes[i], mk));
        i = i + 1;
    }
    return out;
}

// write_frame(opcode, payload: string) → Array<u8> (RFC 6455 masked frame).
// opcode: 1 = text, 2 = binary, 8 = close, 9 = ping, 10 = pong. The text payload is
// encoded as UTF-8 (str_to_bytes), so non-ASCII frames are valid on the wire.
fn write_frame(opcode, payload) {
    return _write_frame_bytes(opcode, str_to_bytes(payload));
}

// write_text(s) / write_binary(bytes) — convenience for the two data opcodes.
fn write_text(s) { return _write_frame_bytes(1, str_to_bytes(s)); }
fn write_binary(bytes) { return _write_frame_bytes(2, bytes); }

// ping/pong with an optional (string) application payload.
fn ping(payload) { return _write_frame_bytes(9, str_to_bytes(try payload catch "")); }
fn pong(payload) { return _write_frame_bytes(10, str_to_bytes(try payload catch "")); }

// close(code, reason) → a close frame: 2-byte big-endian status code + UTF-8 reason.
fn close(code, reason) {
    let bytes = _u16be(code);
    _append_bytes(bytes, str_to_bytes(try reason catch ""));
    return _write_frame_bytes(8, bytes);
}

// ── Server-direction frames (RFC 6455 §5.1: server→client MUST NOT mask) ─────
// The masked write_* helpers above are for the CLIENT direction; a pblang
// WebSocket server sends these unmasked frames instead.
fn _frame_unmasked(opcode, bytes, fin) {
    let plen = len(bytes);
    let out = [];
    let b0 = opcode;
    if fin { b0 = 128 + opcode; }
    array_push(out, b0);
    if plen <= 125 {
        array_push(out, plen);                 // MASK bit clear
    } else if plen <= 65535 {
        array_push(out, 126);
        _append_bytes(out, _u16be(plen));
    } else {
        array_push(out, 127);
        _append_bytes(out, _u64be(plen));
    }
    _append_bytes(out, bytes);
    return out;
}

// server_frame(opcode, payload) → an unmasked, FIN=1 frame (Array<u8>).
fn server_frame(opcode, payload) { return _frame_unmasked(opcode, str_to_bytes(payload), true); }
// server_frame_frag(opcode, payload, fin) → unmasked frame with explicit FIN
// (for emitting fragmented server messages).
fn server_frame_frag(opcode, payload, fin) { return _frame_unmasked(opcode, str_to_bytes(payload), fin); }
// server_text/binary/ping/pong — unmasked convenience builders.
fn server_text(s) { return _frame_unmasked(1, str_to_bytes(s), true); }
fn server_binary(bytes) { return _frame_unmasked(2, bytes, true); }
fn server_ping(payload) { return _frame_unmasked(9, str_to_bytes(try payload catch ""), true); }
fn server_pong(payload) { return _frame_unmasked(10, str_to_bytes(try payload catch ""), true); }
// server_close(code, reason) → an unmasked close frame.
fn server_close(code, reason) {
    let bytes = _u16be(code);
    _append_bytes(bytes, str_to_bytes(try reason catch ""));
    return _frame_unmasked(8, bytes, true);
}

// ── Streaming decoder ────────────────────────────────────────────────────────
fn _decode_data(op, bytes) {
    if op == 2 {
        return map{ message: nil, binary: bytes, is_binary: true };
    }
    return map{ message: try bytes_to_str(bytes) catch "", binary: nil, is_binary: false };
}

// stream_decode(data) — pull one complete data message out of a byte buffer,
// reassembling fragments (FIN), collecting interleaved ping payloads to answer,
// and surfacing a close frame. Returns:
//   { message, binary, is_binary, close: {code,reason}|nil, pings: [..],
//     consumed: <bytes fully processed> }
// `consumed` lets a streaming client drop what was parsed and keep the trailing
// partial frame buffered until more bytes arrive.
fn stream_decode(data) {
    let started = false;
    let msg_opcode = 0;
    let msg_bytes = [];
    let pings = [];
    let consumed = 0;
    let i = 0;
    let n = len(data);
    while i < n {
        let f = _parse_frame_at(data, i);
        if type(f) == "map" and map_has(f, "error") { break; }   // incomplete — stop
        let op = f.opcode;
        let next = f.next_index;
        if op == 9 {                                  // ping
            array_push(pings, f.payload);
            consumed = next; i = next;
        } else if op == 10 {                          // pong — nothing to do
            consumed = next; i = next;
        } else if op == 8 {                           // close
            return map{ message: nil, binary: nil, is_binary: false,
                        close: decode_close(f.payload_bytes), pings: pings, consumed: next };
        } else if op == 1 or op == 2 {                // data (start)
            if f.fin == 1 {
                let out = _decode_data(op, f.payload_bytes);
                out.close = nil; out.pings = pings; out.consumed = next;
                return out;
            }
            started = true; msg_opcode = op; msg_bytes = f.payload_bytes;
            consumed = next; i = next;
        } else if op == 0 {                           // continuation
            if not started { break; }                 // stray continuation — stop
            _append_bytes(msg_bytes, f.payload_bytes);
            if f.fin == 1 {
                let out = _decode_data(msg_opcode, msg_bytes);
                out.close = nil; out.pings = pings; out.consumed = next;
                return out;
            }
            consumed = next; i = next;
        } else {
            consumed = next; i = next;                // unknown opcode — skip
        }
    }
    return map{ message: nil, binary: nil, is_binary: false, close: nil, pings: pings, consumed: consumed };
}

// decode_close(payload_bytes) → { code, reason } from a close-frame payload.
fn decode_close(payload_bytes) {
    if payload_bytes == nil or len(payload_bytes) < 2 {
        return map{ code: 1005, reason: "" };   // 1005 = no status code present
    }
    let code = payload_bytes[0] * 256 + payload_bytes[1];
    let rest = [];
    let i = 2;
    while i < len(payload_bytes) { array_push(rest, payload_bytes[i]); i = i + 1; }
    return map{ code: code, reason: try bytes_to_str(rest) catch "" };
}

export upgrade_response, parse_frame, parse_frames, reassemble_fragments, parse_message,
       write_frame, write_text, write_binary, ping, pong, close, decode_close,
       set_max_payload, get_max_payload;
export client_key, client_accept_for, client_handshake_request,
       handshake_status, verify_handshake;
export request_key, is_upgrade_request, server_accept;
export parse_frame_at, stream_decode;
export server_frame, server_frame_frag, server_text, server_binary,
       server_ping, server_pong, server_close;
