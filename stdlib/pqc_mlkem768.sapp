// stdlib/pqc_mlkem768.sapp — Real Post-Quantum Cryptography FIPS 203 ML-KEM-768
// & FIPS 202 Keccak-f[1600] (SHA3-256, SHA3-512, SHAKE128, SHAKE256) in Pure PBLang (v1.5.0).
// Parameters: k = 3, n = 256, q = 3329, eta1 = 2, eta2 = 2, du = 10, dv = 4.
// Sizes: ek = 1184 bytes, dk = 2400 bytes, ct = 1088 bytes, shared_secret = 32 bytes.

let MLKEM768_K = 3;
let MLKEM768_N = 256;
let MLKEM768_Q = 3329;
let MLKEM768_ETA1 = 2;
let MLKEM768_ETA2 = 2;
let MLKEM768_DU = 10;
let MLKEM768_DV = 4;
let MLKEM768_EK_BYTES = 1184;
let MLKEM768_DK_BYTES = 2400;
let MLKEM768_CT_BYTES = 1088;
let MLKEM768_SS_BYTES = 32;

// ── Exact 32-bit Limb Helpers (Float53-Safe, Strictly <= 32-bit Values) ─────
let _MASK32 = 4294967295;

fn _shl32(x, r) {
    if r <= 0 { return bit_and(x, _MASK32); }
    if r >= 32 { return 0; }
    let keep_mask = bit_shl(1, 32 - r) - 1;
    return bit_shl(bit_and(x, keep_mask), r);
}

fn _shr32(x, r) {
    if r <= 0 { return bit_and(x, _MASK32); }
    if r >= 32 { return 0; }
    return bit_shr(bit_and(x, _MASK32), r);
}

fn _rotl64(lane, r) {
    let lo = lane[0];
    let hi = lane[1];
    if r == 0 { return [lo, hi]; }
    if r == 32 { return [hi, lo]; }
    if r < 32 {
        let nlo = bit_or(_shl32(lo, r), _shr32(hi, 32 - r));
        let nhi = bit_or(_shl32(hi, r), _shr32(lo, 32 - r));
        return [nlo, nhi];
    }
    let s = r - 32;
    let nlo = bit_or(_shl32(hi, s), _shr32(lo, 32 - s));
    let nhi = bit_or(_shl32(lo, s), _shr32(hi, 32 - s));
    return [nlo, nhi];
}

fn _xor64(a, b) {
    return [bit_xor(a[0], b[0]), bit_xor(a[1], b[1])];
}

// ── FIPS 202 Keccak-f[1600] Round Constants (Generated via Exact FIPS 202 LFSR) ──
fn _build_keccak_rc() {
    let rc_table = [];
    let lfsr = 1;
    let ir = 0;
    while ir < 24 {
        let lo = 0;
        let hi = 0;
        let j = 0;
        while j < 7 {
            let bit_val = bit_and(lfsr, 1);
            // Update 8-bit LFSR: x^8 + x^6 + x^5 + x^4 + 1 (0x71 feedback)
            let msb = bit_and(bit_shr(lfsr, 7), 1);
            lfsr = bit_and(bit_shl(lfsr, 1), 255);
            if msb == 1 {
                lfsr = bit_xor(lfsr, 113);
            }
            if bit_val == 1 {
                let pos = bit_shl(1, j) - 1;
                if pos < 32 {
                    lo = bit_or(lo, _shl32(1, pos));
                } else {
                    hi = bit_or(hi, _shl32(1, pos - 32));
                }
            }
            j = j + 1;
        }
        push(rc_table, [lo, hi]);
        ir = ir + 1;
    }
    return rc_table;
}

let _KECCAK_RC = _build_keccak_rc();

fn _keccak_f1600(state) {
    let round = 0;
    while round < 24 {
        // Theta
        let C = [];
        let x = 0;
        while x < 5 {
            let c_lo = bit_xor(bit_xor(bit_xor(bit_xor(state[x][0], state[x + 5][0]), state[x + 10][0]), state[x + 15][0]), state[x + 20][0]);
            let c_hi = bit_xor(bit_xor(bit_xor(bit_xor(state[x][1], state[x + 5][1]), state[x + 10][1]), state[x + 15][1]), state[x + 20][1]);
            push(C, [c_lo, c_hi]);
            x = x + 1;
        }
        let D = [];
        x = 0;
        while x < 5 {
            let c_prev = C[num_mod(x + 4, 5)];
            let c_next_rot = _rotl64(C[num_mod(x + 1, 5)], 1);
            push(D, _xor64(c_prev, c_next_rot));
            x = x + 1;
        }
        x = 0;
        while x < 5 {
            let dx = D[x];
            let y = 0;
            while y < 5 {
                let idx = x + 5 * y;
                state[idx] = _xor64(state[idx], dx);
                y = y + 1;
            }
            x = x + 1;
        }

        // Rho & Pi
        let B = [];
        let k = 0;
        while k < 25 { push(B, [0, 0]); k = k + 1; }
        B[0] = [state[0][0], state[0][1]];
        let cx = 1;
        let cy = 0;
        let t = 0;
        while t < 24 {
            let r = num_mod(num_floor(((t + 1) * (t + 2)) / 2), 64);
            let nx = cy;
            let ny = num_mod(2 * cx + 3 * cy, 5);
            B[nx + 5 * ny] = _rotl64(state[cx + 5 * cy], r);
            cx = nx;
            cy = ny;
            t = t + 1;
        }

        // Chi
        let y = 0;
        while y < 5 {
            let base = 5 * y;
            x = 0;
            while x < 5 {
                let b0 = B[base + x];
                let b1 = B[base + num_mod(x + 1, 5)];
                let b2 = B[base + num_mod(x + 2, 5)];
                let lo = bit_xor(b0[0], bit_and(bit_xor(b1[0], _MASK32), b2[0]));
                let hi = bit_xor(b0[1], bit_and(bit_xor(b1[1], _MASK32), b2[1]));
                state[base + x] = [lo, hi];
                x = x + 1;
            }
            y = y + 1;
        }

        // Iota
        state[0] = _xor64(state[0], _KECCAK_RC[round]);
        round = round + 1;
    }
}

fn _absorb_block(state, block, rate_bytes) {
    let lanes = num_floor(rate_bytes / 8);
    let i = 0;
    while i < lanes {
        let off = 8 * i;
        let lo = bit_or(bit_or(block[off], _shl32(block[off + 1], 8)),
                        bit_or(_shl32(block[off + 2], 16), _shl32(block[off + 3], 24)));
        let hi = bit_or(bit_or(block[off + 4], _shl32(block[off + 5], 8)),
                        bit_or(_shl32(block[off + 6], 16), _shl32(block[off + 7], 24)));
        state[i] = [bit_xor(state[i][0], lo), bit_xor(state[i][1], hi)];
        i = i + 1;
    }
    _keccak_f1600(state);
}

fn _extract_rate_bytes(state, rate_bytes) {
    let out = [];
    let lanes = num_floor(rate_bytes / 8);
    let i = 0;
    while i < lanes {
        let lo = state[i][0];
        let hi = state[i][1];
        push(out, bit_and(lo, 255));
        push(out, bit_and(_shr32(lo, 8), 255));
        push(out, bit_and(_shr32(lo, 16), 255));
        push(out, bit_and(_shr32(lo, 24), 255));
        push(out, bit_and(hi, 255));
        push(out, bit_and(_shr32(hi, 8), 255));
        push(out, bit_and(_shr32(hi, 16), 255));
        push(out, bit_and(_shr32(hi, 24), 255));
        i = i + 1;
    }
    return out;
}

fn _to_byte_array(input) {
    if is_array(input) { return input; }
    if is_string(input) { return str_to_bytes(input); }
    throw "pqc_mlkem768: expected byte array or string";
}

fn _keccak_sponge_init(msg_bytes, rate_bytes, suffix) {
    let state = [];
    let i = 0;
    while i < 25 { push(state, [0, 0]); i = i + 1; }

    let n = len(msg_bytes);
    let offset = 0;
    while offset + rate_bytes <= n {
        let blk = slice(msg_bytes, offset, offset + rate_bytes);
        _absorb_block(state, blk, rate_bytes);
        offset = offset + rate_bytes;
    }

    let pad_blk = [];
    i = 0;
    while i < rate_bytes { push(pad_blk, 0); i = i + 1; }
    let rem = n - offset;
    i = 0;
    while i < rem {
        pad_blk[i] = bit_and(msg_bytes[offset + i], 255);
        i = i + 1;
    }
    pad_blk[rem] = bit_xor(pad_blk[rem], suffix);
    pad_blk[rate_bytes - 1] = bit_xor(pad_blk[rate_bytes - 1], 128);
    _absorb_block(state, pad_blk, rate_bytes);

    return map{
        state: state,
        rate: rate_bytes,
        buf: _extract_rate_bytes(state, rate_bytes),
        pos: 0
    };
}

fn _xof_squeeze(xof, out_len) {
    let out = [];
    let rem = out_len;
    while rem > 0 {
        if xof.pos >= len(xof.buf) {
            _keccak_f1600(xof.state);
            xof.buf = _extract_rate_bytes(xof.state, xof.rate);
            xof.pos = 0;
        }
        push(out, xof.buf[xof.pos]);
        xof.pos = xof.pos + 1;
        rem = rem - 1;
    }
    return out;
}

fn sha3_256(input) {
    let xof = _keccak_sponge_init(_to_byte_array(input), 136, 6);
    return _xof_squeeze(xof, 32);
}

fn sha3_512(input) {
    let xof = _keccak_sponge_init(_to_byte_array(input), 72, 6);
    return _xof_squeeze(xof, 64);
}

fn shake128(input, out_len) {
    let xof = _keccak_sponge_init(_to_byte_array(input), 168, 31);
    return _xof_squeeze(xof, out_len);
}

fn shake256(input, out_len) {
    let xof = _keccak_sponge_init(_to_byte_array(input), 136, 31);
    return _xof_squeeze(xof, out_len);
}

fn bytes_to_hex(bytes) {
    let digits = "0123456789abcdef";
    let out = "";
    let i = 0;
    while i < len(bytes) {
        let b = bit_and(bytes[i], 255);
        let hi = bit_shr(b, 4);
        let lo = bit_and(b, 15);
        out = out + str_slice(digits, hi, hi + 1) + str_slice(digits, lo, lo + 1);
        i = i + 1;
    }
    return out;
}

fn _concat_bytes(a, b) {
    let out = [];
    let i = 0;
    while i < len(a) { push(out, a[i]); i = i + 1; }
    i = 0;
    while i < len(b) { push(out, b[i]); i = i + 1; }
    return out;
}

// ── FIPS 203 ZETAS Table & Number-Theoretic Transform (q = 3329) ────────────
fn _bitrev7(x) {
    let r = 0;
    let v = x;
    let b = 0;
    while b < 7 {
        r = bit_or(bit_shl(r, 1), bit_and(v, 1));
        v = bit_shr(v, 1);
        b = b + 1;
    }
    return r;
}

fn _pow_mod_q(base, exp) {
    let res = 1;
    let b = num_mod(base, MLKEM768_Q);
    let e = exp;
    while e > 0 {
        if bit_and(e, 1) == 1 {
            res = num_mod(res * b, MLKEM768_Q);
        }
        b = num_mod(b * b, MLKEM768_Q);
        e = bit_shr(e, 1);
    }
    return res;
}

fn _build_zetas() {
    let z = [];
    let i = 0;
    while i < 128 {
        push(z, _pow_mod_q(17, _bitrev7(i)));
        i = i + 1;
    }
    return z;
}

let ZETAS = _build_zetas();

fn ntt(poly) {
    let f = [];
    let i = 0;
    while i < 256 { push(f, num_mod(poly[i], MLKEM768_Q)); i = i + 1; }

    let idx = 1;
    let len_s = 128;
    while len_s >= 2 {
        let start = 0;
        while start < 256 {
            let zeta = ZETAS[idx];
            idx = idx + 1;
            let j = start;
            while j < start + len_s {
                let t = num_mod(zeta * f[j + len_s], MLKEM768_Q);
                f[j + len_s] = num_mod(f[j] + MLKEM768_Q - t, MLKEM768_Q);
                f[j] = num_mod(f[j] + t, MLKEM768_Q);
                j = j + 1;
            }
            start = start + 2 * len_s;
        }
        len_s = num_floor(len_s / 2);
    }
    return f;
}

fn inv_ntt(poly_hat) {
    let f = [];
    let i = 0;
    while i < 256 { push(f, num_mod(poly_hat[i], MLKEM768_Q)); i = i + 1; }

    let idx = 127;
    let len_s = 2;
    while len_s <= 128 {
        let start = 0;
        while start < 256 {
            let zeta = ZETAS[idx];
            idx = idx - 1;
            let j = start;
            while j < start + len_s {
                let t = f[j];
                f[j] = num_mod(t + f[j + len_s], MLKEM768_Q);
                let diff = num_mod(f[j + len_s] + MLKEM768_Q - t, MLKEM768_Q);
                f[j + len_s] = num_mod(zeta * diff, MLKEM768_Q);
                j = j + 1;
            }
            start = start + 2 * len_s;
        }
        len_s = len_s * 2;
    }

    // Multiply by 128^-1 mod 3329 = 3303
    i = 0;
    while i < 256 {
        f[i] = num_mod(f[i] * 3303, MLKEM768_Q);
        i = i + 1;
    }
    return f;
}

fn basemul(a0, a1, b0, b1, gamma) {
    let c0 = num_mod(a0 * b0 + num_mod(a1 * b1, MLKEM768_Q) * gamma, MLKEM768_Q);
    let c1 = num_mod(a0 * b1 + a1 * b0, MLKEM768_Q);
    return [c0, c1];
}

fn ntt_mul(f_hat, g_hat) {
    let h = [];
    let i = 0;
    while i < 128 {
        let base_zeta = ZETAS[64 + bit_shr(i, 1)];
        let gamma = if bit_and(i, 1) == 0 { base_zeta } else { MLKEM768_Q - base_zeta };
        let pair = basemul(f_hat[2 * i], f_hat[2 * i + 1], g_hat[2 * i], g_hat[2 * i + 1], gamma);
        push(h, pair[0]);
        push(h, pair[1]);
        i = i + 1;
    }
    return h;
}

fn _poly_add(a, b) {
    let out = [];
    let i = 0;
    while i < 256 {
        push(out, num_mod(a[i] + b[i], MLKEM768_Q));
        i = i + 1;
    }
    return out;
}

fn _poly_sub(a, b) {
    let out = [];
    let i = 0;
    while i < 256 {
        push(out, num_mod(a[i] + MLKEM768_Q - b[i], MLKEM768_Q));
        i = i + 1;
    }
    return out;
}

// ── FIPS 203 Sampling (`SampleNTT` & `SamplePolyCBD_eta2`) ──────────────────
fn sample_ntt(rho, col_j, row_i) {
    let seed = _concat_bytes(rho, [col_j, row_i]);
    let xof = _keccak_sponge_init(seed, 168, 31);
    let a_hat = [];
    while len(a_hat) < 256 {
        let b = _xof_squeeze(xof, 3);
        let d1 = b[0] + 256 * bit_and(b[1], 15);
        let d2 = bit_shr(b[1], 4) + 16 * b[2];
        if d1 < MLKEM768_Q {
            push(a_hat, d1);
        }
        if d2 < MLKEM768_Q and len(a_hat) < 256 {
            push(a_hat, d2);
        }
    }
    return a_hat;
}

fn cbd_eta2(prf_bytes128) {
    let f = [];
    let i = 0;
    while i < 128 {
        let byte_val = prf_bytes128[i];
        let nib0 = bit_and(byte_val, 15);
        let x0 = bit_and(nib0, 1) + bit_and(bit_shr(nib0, 1), 1);
        let y0 = bit_and(bit_shr(nib0, 2), 1) + bit_and(bit_shr(nib0, 3), 1);
        push(f, num_mod(x0 + MLKEM768_Q - y0, MLKEM768_Q));

        let nib1 = bit_shr(byte_val, 4);
        let x1 = bit_and(nib1, 1) + bit_and(bit_shr(nib1, 1), 1);
        let y1 = bit_and(bit_shr(nib1, 2), 1) + bit_and(bit_shr(nib1, 3), 1);
        push(f, num_mod(x1 + MLKEM768_Q - y1, MLKEM768_Q));
        i = i + 1;
    }
    return f;
}

fn _prf_eta2(sigma, nonce) {
    return shake256(_concat_bytes(sigma, [nonce]), 128);
}

// ── FIPS 203 Compression, Decompression & Bit Packing ───────────────────────
fn compress_poly(poly, d) {
    let mask = bit_shl(1, d) - 1;
    let out = [];
    let i = 0;
    while i < 256 {
        let num = bit_shl(poly[i], d) + 1664;
        push(out, bit_and(num_floor(num / MLKEM768_Q), mask));
        i = i + 1;
    }
    return out;
}

fn decompress_poly(vals, d) {
    let half = if d > 0 { bit_shl(1, d - 1) } else { 0 };
    let denom = bit_shl(1, d);
    let out = [];
    let i = 0;
    while i < 256 {
        push(out, num_floor((MLKEM768_Q * vals[i] + half) / denom));
        i = i + 1;
    }
    return out;
}

fn byte_encode(vals, d) {
    let out = [];
    if d == 12 {
        // 2 coefficients (24 bits) -> 3 bytes
        let i = 0;
        while i < 128 {
            let a = vals[2 * i];
            let b = vals[2 * i + 1];
            push(out, bit_and(a, 255));
            push(out, bit_or(bit_shr(a, 8), bit_and(bit_shl(b, 4), 240)));
            push(out, bit_and(bit_shr(b, 4), 255));
            i = i + 1;
        }
        return out;
    }
    if d == 10 {
        // 4 coefficients (40 bits) -> 5 bytes
        let i = 0;
        while i < 64 {
            let t0 = vals[4 * i];
            let t1 = vals[4 * i + 1];
            let t2 = vals[4 * i + 2];
            let t3 = vals[4 * i + 3];
            push(out, bit_and(t0, 255));
            push(out, bit_or(bit_shr(t0, 8), bit_and(bit_shl(t1, 2), 252)));
            push(out, bit_or(bit_shr(t1, 6), bit_and(bit_shl(t2, 4), 240)));
            push(out, bit_or(bit_shr(t2, 4), bit_and(bit_shl(t3, 6), 192)));
            push(out, bit_and(bit_shr(t3, 2), 255));
            i = i + 1;
        }
        return out;
    }
    if d == 4 {
        // 2 coefficients (8 bits) -> 1 byte
        let i = 0;
        while i < 128 {
            push(out, bit_or(bit_and(vals[2 * i], 15), bit_shl(bit_and(vals[2 * i + 1], 15), 4)));
            i = i + 1;
        }
        return out;
    }
    if d == 1 {
        // 8 coefficients -> 1 byte
        let i = 0;
        while i < 32 {
            let b = 0;
            let j = 0;
            while j < 8 {
                if bit_and(vals[8 * i + j], 1) == 1 {
                    b = bit_or(b, bit_shl(1, j));
                }
                j = j + 1;
            }
            push(out, b);
            i = i + 1;
        }
        return out;
    }
    throw "byte_encode: unsupported bit width d=" + str(d);
}

fn byte_decode(bytes, d) {
    let out = [];
    if d == 12 {
        let i = 0;
        while i < 128 {
            let b0 = bytes[3 * i];
            let b1 = bytes[3 * i + 1];
            let b2 = bytes[3 * i + 2];
            let v0 = num_mod(b0 + bit_shl(bit_and(b1, 15), 8), MLKEM768_Q);
            let v1 = num_mod(bit_shr(b1, 4) + bit_shl(b2, 4), MLKEM768_Q);
            push(out, v0);
            push(out, v1);
            i = i + 1;
        }
        return out;
    }
    if d == 10 {
        let i = 0;
        while i < 64 {
            let b0 = bytes[5 * i];
            let b1 = bytes[5 * i + 1];
            let b2 = bytes[5 * i + 2];
            let b3 = bytes[5 * i + 3];
            let b4 = bytes[5 * i + 4];
            push(out, bit_or(b0, bit_shl(bit_and(b1, 3), 8)));
            push(out, bit_or(bit_shr(b1, 2), bit_shl(bit_and(b2, 15), 6)));
            push(out, bit_or(bit_shr(b2, 4), bit_shl(bit_and(b3, 63), 4)));
            push(out, bit_or(bit_shr(b3, 6), bit_shl(b4, 2)));
            i = i + 1;
        }
        return out;
    }
    if d == 4 {
        let i = 0;
        while i < 128 {
            let b = bytes[i];
            push(out, bit_and(b, 15));
            push(out, bit_shr(b, 4));
            i = i + 1;
        }
        return out;
    }
    if d == 1 {
        let i = 0;
        while i < 32 {
            let b = bytes[i];
            let j = 0;
            while j < 8 {
                push(out, bit_and(bit_shr(b, j), 1));
                j = j + 1;
            }
            i = i + 1;
        }
        return out;
    }
    throw "byte_decode: unsupported bit width d=" + str(d);
}

// ── Internal K-PKE KeyGen, Encrypt, Decrypt (FIPS 203 Algorithms 13..15) ────
fn _kpke_keygen(d32) {
    // (rho, sigma) = G(d || k) where k = 3 for ML-KEM-768
    let g_out = sha3_512(_concat_bytes(d32, [MLKEM768_K]));
    let rho = slice(g_out, 0, 32);
    let sigma = slice(g_out, 32, 64);

    let A_hat = [];
    let i = 0;
    while i < MLKEM768_K {
        let row = [];
        let j = 0;
        while j < MLKEM768_K {
            push(row, sample_ntt(rho, j, i));
            j = j + 1;
        }
        push(A_hat, row);
        i = i + 1;
    }

    let nonce = 0;
    let s_hat = [];
    i = 0;
    while i < MLKEM768_K {
        push(s_hat, ntt(cbd_eta2(_prf_eta2(sigma, nonce))));
        nonce = nonce + 1;
        i = i + 1;
    }
    let e_hat = [];
    i = 0;
    while i < MLKEM768_K {
        push(e_hat, ntt(cbd_eta2(_prf_eta2(sigma, nonce))));
        nonce = nonce + 1;
        i = i + 1;
    }

    // t_hat = A_hat * s_hat + e_hat
    let ek_pke = [];
    let dk_pke = [];
    i = 0;
    while i < MLKEM768_K {
        let acc = ntt_mul(A_hat[i][0], s_hat[0]);
        let j = 1;
        while j < MLKEM768_K {
            acc = _poly_add(acc, ntt_mul(A_hat[i][j], s_hat[j]));
            j = j + 1;
        }
        let t_i = _poly_add(acc, e_hat[i]);
        ek_pke = _concat_bytes(ek_pke, byte_encode(t_i, 12));
        dk_pke = _concat_bytes(dk_pke, byte_encode(s_hat[i], 12));
        i = i + 1;
    }
    ek_pke = _concat_bytes(ek_pke, rho);
    return map{ ek_pke: ek_pke, dk_pke: dk_pke };
}

fn _kpke_encrypt(ek_pke, m32, r32) {
    let t_hat = [];
    let i = 0;
    while i < MLKEM768_K {
        push(t_hat, byte_decode(slice(ek_pke, 384 * i, 384 * (i + 1)), 12));
        i = i + 1;
    }
    let rho = slice(ek_pke, 1152, 1184);

    let A_hat = [];
    i = 0;
    while i < MLKEM768_K {
        let row = [];
        let j = 0;
        while j < MLKEM768_K {
            push(row, sample_ntt(rho, j, i));
            j = j + 1;
        }
        push(A_hat, row);
        i = i + 1;
    }

    let nonce = 0;
    let y_hat = [];
    i = 0;
    while i < MLKEM768_K {
        push(y_hat, ntt(cbd_eta2(_prf_eta2(r32, nonce))));
        nonce = nonce + 1;
        i = i + 1;
    }
    let e1 = [];
    i = 0;
    while i < MLKEM768_K {
        push(e1, cbd_eta2(_prf_eta2(r32, nonce)));
        nonce = nonce + 1;
        i = i + 1;
    }
    let e2 = cbd_eta2(_prf_eta2(r32, nonce));

    // u = NTT^-1(A_hat^T * y_hat) + e1
    let c1 = [];
    i = 0;
    while i < MLKEM768_K {
        let acc = ntt_mul(A_hat[0][i], y_hat[0]);
        let j = 1;
        while j < MLKEM768_K {
            acc = _poly_add(acc, ntt_mul(A_hat[j][i], y_hat[j]));
            j = j + 1;
        }
        let u_i = _poly_add(inv_ntt(acc), e1[i]);
        c1 = _concat_bytes(c1, byte_encode(compress_poly(u_i, MLKEM768_DU), MLKEM768_DU));
        i = i + 1;
    }

    // mu = Decompress_1(ByteDecode_1(m))
    let mu = decompress_poly(byte_decode(m32, 1), 1);

    // v = NTT^-1(t_hat^T * y_hat) + e2 + mu
    let inner = ntt_mul(t_hat[0], y_hat[0]);
    i = 1;
    while i < MLKEM768_K {
        inner = _poly_add(inner, ntt_mul(t_hat[i], y_hat[i]));
        i = i + 1;
    }
    let v = _poly_add(_poly_add(inv_ntt(inner), e2), mu);
    let c2 = byte_encode(compress_poly(v, MLKEM768_DV), MLKEM768_DV);
    return _concat_bytes(c1, c2);
}

fn _kpke_decrypt(dk_pke, ct) {
    let u = [];
    let i = 0;
    while i < MLKEM768_K {
        let c1_i = slice(ct, 320 * i, 320 * (i + 1));
        push(u, decompress_poly(byte_decode(c1_i, MLKEM768_DU), MLKEM768_DU));
        i = i + 1;
    }
    let c2 = slice(ct, 960, 1088);
    let v = decompress_poly(byte_decode(c2, MLKEM768_DV), MLKEM768_DV);

    let s_hat = [];
    i = 0;
    while i < MLKEM768_K {
        push(s_hat, byte_decode(slice(dk_pke, 384 * i, 384 * (i + 1)), 12));
        i = i + 1;
    }

    let inner = ntt_mul(s_hat[0], ntt(u[0]));
    i = 1;
    while i < MLKEM768_K {
        inner = _poly_add(inner, ntt_mul(s_hat[i], ntt(u[i])));
        i = i + 1;
    }
    let w = _poly_sub(v, inv_ntt(inner));
    return byte_encode(compress_poly(w, 1), 1);
}

// ── Public FIPS 203 ML-KEM-768 KEM API (Algorithms 16..18) ──────────────────
fn mlkem768_keygen(seed64 = nil) {
    let seed = if seed64 == nil {
        str_to_bytes(random_bytes(64))
    } else {
        _to_byte_array(seed64)
    };
    if len(seed) != 64 {
        throw "mlkem768_keygen: seed must be exactly 64 bytes (d || z)";
    }
    let d = slice(seed, 0, 32);
    let z = slice(seed, 32, 64);
    let kp = _kpke_keygen(d);
    let h_ek = sha3_256(kp.ek_pke);
    let dk = _concat_bytes(_concat_bytes(_concat_bytes(kp.dk_pke, kp.ek_pke), h_ek), z);
    return map{
        ok: true,
        algorithm: "ML-KEM-768",
        ek: kp.ek_pke,
        dk: dk
    };
}

fn mlkem768_encaps(ek, coin32 = nil) {
    if len(ek) != MLKEM768_EK_BYTES {
        throw "mlkem768_encaps: encapsulation key must be 1184 bytes";
    }
    // FIPS 203 Section 7.2 encapsulation key modulus check
    let i = 0;
    while i < MLKEM768_K {
        let seg = slice(ek, 384 * i, 384 * (i + 1));
        let roundtrip = byte_encode(byte_decode(seg, 12), 12);
        let b = 0;
        while b < 384 {
            if seg[b] != roundtrip[b] {
                throw "mlkem768_encaps: invalid encapsulation key (coefficient >= q)";
            }
            b = b + 1;
        }
        i = i + 1;
    }

    let m = if coin32 == nil {
        str_to_bytes(random_bytes(32))
    } else {
        _to_byte_array(coin32)
    };
    if len(m) != 32 {
        throw "mlkem768_encaps: randomness coin must be 32 bytes";
    }

    let h_ek = sha3_256(ek);
    let kr = sha3_512(_concat_bytes(m, h_ek));
    let K = slice(kr, 0, 32);
    let r = slice(kr, 32, 64);
    let ct = _kpke_encrypt(ek, m, r);

    return map{
        ok: true,
        algorithm: "ML-KEM-768",
        ct: ct,
        shared_secret: K,
        ss: K
    };
}

fn mlkem768_decaps(dk, ct) {
    if len(dk) != MLKEM768_DK_BYTES {
        throw "mlkem768_decaps: decapsulation key must be 2400 bytes";
    }
    if len(ct) != MLKEM768_CT_BYTES {
        throw "mlkem768_decaps: ciphertext must be 1088 bytes";
    }

    let dk_pke = slice(dk, 0, 1152);
    let ek_pke = slice(dk, 1152, 2336);
    let h = slice(dk, 2336, 2368);
    let z = slice(dk, 2368, 2400);

    let m_prime = _kpke_decrypt(dk_pke, ct);
    let kr_prime = sha3_512(_concat_bytes(m_prime, h));
    let K_prime = slice(kr_prime, 0, 32);
    let r_prime = slice(kr_prime, 32, 64);

    // Implicit rejection key K_bar = J(z || ct) = SHAKE256(z || ct, 32)
    let K_bar = shake256(_concat_bytes(z, ct), 32);

    // Fujisaki-Okamoto re-encryption & constant-time comparison across all 1088 bytes
    let ct_prime = _kpke_encrypt(ek_pke, m_prime, r_prime);
    let diff = 0;
    let i = 0;
    while i < MLKEM768_CT_BYTES {
        diff = bit_or(diff, bit_xor(ct[i], ct_prime[i]));
        i = i + 1;
    }

    let sel_mask = if diff == 0 { 255 } else { 0 };
    let inv_mask = bit_xor(sel_mask, 255);
    let out_ss = [];
    i = 0;
    while i < 32 {
        let byte_val = bit_or(bit_and(K_prime[i], sel_mask), bit_and(K_bar[i], inv_mask));
        push(out_ss, byte_val);
        i = i + 1;
    }
    return out_ss;
}

export MLKEM768_K, MLKEM768_N, MLKEM768_Q, MLKEM768_ETA1, MLKEM768_ETA2,
       MLKEM768_DU, MLKEM768_DV, MLKEM768_EK_BYTES, MLKEM768_DK_BYTES,
       MLKEM768_CT_BYTES, MLKEM768_SS_BYTES, ZETAS,
       sha3_256, sha3_512, shake128, shake256, bytes_to_hex,
       ntt, inv_ntt, basemul, ntt_mul, sample_ntt, cbd_eta2,
       compress_poly, decompress_poly, byte_encode, byte_decode,
       mlkem768_keygen, mlkem768_encaps, mlkem768_decaps;
