// stdlib/selfhost_loader.sapp — the .pbck LOADER for the self-hosted toolchain.
//
// Closes the self-hosting loop. The pipeline already had a WRITER
// (selfhost_pbck.sapp serializes a self-hosted chunk-map to bytes / a file) and a
// self-hosted VM (stdlib/compiler/vm.sapp). This module supplies the missing
// first-class entry point: given a PATH to an emitted .pbck artifact, read it from
// disk, deserialize it, and EXECUTE it on the self-hosted VM — so a program
// compiled by pblang can be loaded and run by pblang, with no Rust front-end
// re-parsing the source.
//
//   load_pbck(path)            -> chunk            (read + deserialize, no run)
//   run_pbck(path)             -> { ok, output, locals, globals, chunk }
//   run_pbck_seeded(path, g)   -> { ok, ... }      (seed globals, e.g. import cache)
//
// run_pbck/run_pbck_seeded never throw on a bad path: a file that is missing or
// not a valid container yields { ok: false, error } so callers can branch.

let pbck = import("stdlib/selfhost_pbck.sapp");
let vm   = import("stdlib/compiler/vm.sapp");

// Read a serialized self-hosted chunk from disk and rebuild the chunk-map.
// Propagates the container's errors (bad magic / version / truncation).
fn load_pbck(path) {
    return pbck.read_file(path);
}

fn _run_chunk(chunk, globals) {
    let res = vm.run_seeded(chunk, globals);
    return map{
        ok: true,
        output: res.output,
        locals: res.locals,
        globals: res.globals,
        chunk: chunk,
    };
}

fn _run_loaded(path, globals) {
    // catch doesn't bind the error in pblang, so detect load failure via nil.
    let chunk = try load_pbck(path) catch nil;
    if chunk == nil {
        return map{ ok: false, error: "run_pbck: cannot load .pbck file: " + path, output: [] };
    }
    return _run_chunk(chunk, globals);
}

// Load a .pbck from disk and execute it on the self-hosted VM.
fn run_pbck(path) {
    return _run_loaded(path, map{});
}

// Like run_pbck, but starts from a caller-provided globals map (e.g. to inject
// __import_cache__ for programs that use import(...)).
fn run_pbck_seeded(path, globals) {
    if globals == nil { globals = map{}; }
    return _run_loaded(path, globals);
}

// Run a PBCS bundle straight from an in-memory byte array (no file). Used by the
// self-extracting launcher, which decodes its embedded payload to bytes.
// Returns {ok, output, ...} or {ok:false, error} on a bad/corrupt blob.
fn run_pbck_bytes(bytes) {
    let chunk = try pbck.deserialize_chunk(bytes) catch nil;
    if chunk == nil {
        return map{ ok: false, error: "run_pbck_bytes: invalid PBCS payload", output: [] };
    }
    return _run_chunk(chunk, map{});
}

// ── introspection (objdump-style; powers `pbrun --info`) ─────────────────────
// Walk a chunk, summing instruction / constant / function counts recursively over
// nested function and try sub-chunks. Pure structure — never executes anything.
fn _count_chunk(chunk, acc) {
    acc.instructions = acc.instructions + len(chunk.instructions);
    acc.constants = acc.constants + len(chunk.constants);
    let i = 0;
    while i < len(chunk.constants) {
        let c = chunk.constants[i];
        if type(c) == "map" and map_has(c, "chunk") and map_has(c, "arity") {
            acc.functions = acc.functions + 1;
            _count_chunk(c.chunk, acc);
        } else if type(c) == "map" and map_has(c, "try_chunk") and map_has(c, "catch_chunk") {
            _count_chunk(c.try_chunk, acc);
            _count_chunk(c.catch_chunk, acc);
        }
        i = i + 1;
    }
    return acc;
}

// inspect_pbck(path) -> { ok, bytes, instructions, constants, functions }
// Load + analyze an artifact WITHOUT running it. On a bad path: { ok:false, error }.
fn inspect_pbck(path) {
    let chunk = try load_pbck(path) catch nil;
    if chunk == nil {
        return map{ ok: false, error: "inspect_pbck: cannot load .pbck file: " + path };
    }
    let bytes = try len(fs_read_bytes(path)) catch 0;
    let acc = _count_chunk(chunk, map{ instructions: 0, constants: 0, functions: 0 });
    return map{
        ok: true,
        bytes: bytes,
        instructions: acc.instructions,
        constants: acc.constants,
        functions: acc.functions,
    };
}

// ── self-extracting artifact (PBSELF) ────────────────────────────────────────
// A .pbself file is valid pblang source: [tiny launcher] + a final line comment
// "//PBSELF1:<base64 of the PBCS bundle>". extract_payload finds that sentinel,
// takes the base64 on its line, and decodes it back to the bundle bytes. The
// MARKER must match dist.self_extract's writer.
let _PBSELF_MARKER = "//PBSELF1:";

fn extract_payload(src) {
    let idx = str_index_of(src, _PBSELF_MARKER);
    if idx < 0 { return nil; }
    let rest = str_slice(src, idx + len(_PBSELF_MARKER), len(src));
    let b64 = str_split(rest, "\n")[0];          // sentinel is on its own last line
    if str_ends_with(b64, "\r") { b64 = str_slice(b64, 0, len(b64) - 1); }
    return try base64_decode_bytes(b64) catch nil;
}

// Locate this running script's own path (the .pbself file). os_args() is
// ["run", <abs script path>, "--allow-*", <user args>], so take the first
// existing, non-flag arg after index 0.
fn _self_path() {
    let a = os_args();
    let i = 1;
    let found = nil;
    while i < len(a) {
        if found == nil and not str_starts_with(a[i], "--") and fs_exists(a[i]) { found = a[i]; }
        i = i + 1;
    }
    return found;
}

// The launcher entry point baked into every .pbself file: read own source, slice
// the embedded payload after the sentinel, decode + run it, and echo its output.
fn exec_self() {
    let path = _self_path();
    if path == nil { print "pbself: cannot locate self"; return map{ ok: false, error: "cannot locate self" }; }
    let src = try bytes_to_str(fs_read_bytes(path)) catch nil;
    if src == nil { print "pbself: cannot read self: " + path; return map{ ok: false, error: "cannot read self" }; }
    let payload = extract_payload(src);
    if payload == nil { print "pbself: no embedded bundle"; return map{ ok: false, error: "no embedded bundle" }; }
    let r = run_pbck_bytes(payload);
    let i = 0;
    while i < len(r.output) { print r.output[i]; i = i + 1; }
    if not r.ok { print "pbself: " + (try r.error catch "run error"); }
    return r;
}

// ── command-line adapter (behind tools/pbrun.sapp) ───────────────────────────
// Given a user-arg array, locate the .pbck path (first arg not starting with
// "--"), load + run it, and return { ok, exit_code, output, error }. Pure: does
// no printing or process exit, so the thin tool script owns those side effects
// and this stays directly testable.
fn _first_path(args) {
    let i = 0;
    let found = nil;
    while i < len(args) {
        if found == nil and not str_starts_with(args[i], "--") { found = args[i]; }
        i = i + 1;
    }
    return found;
}

fn cli_run(args) {
    let path = _first_path(args);
    if path == nil {
        return map{ ok: false, exit_code: 2, output: [],
                    error: "usage: pblang run tools/pbrun.sapp --allow-all <file.pbck>" };
    }
    let res = run_pbck(path);
    if not res.ok {
        return map{ ok: false, exit_code: 1, output: [], error: res.error };
    }
    return map{ ok: true, exit_code: 0, output: res.output,
                globals: res.globals, locals: res.locals };
}

export load_pbck, run_pbck, run_pbck_seeded, run_pbck_bytes, cli_run, inspect_pbck;
export extract_payload, exec_self;
