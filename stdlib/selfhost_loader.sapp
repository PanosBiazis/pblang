// stdlib/selfhost_loader.sapp — the .pbck LOADER for the self-hosted toolchain.
//
// Closes the self-hosting loop. The pipeline already had a WRITER
// (selfhost_pbck.sapp serializes a self-hosted chunk-map to bytes / a file) and a
// self-hosted VM (stdlib/compiler/vm.sapp). This module supplies the missing
// first-class entry point: given a PATH to an emitted .pbck artifact, read it from
// disk, deserialize it, and EXECUTE it on the self-hosted VM — so a program
// compiled by pblang can be loaded and run by pblang, with no Rust front-end
// re-parsing the source.
//
//   load_pbck(path)            -> chunk            (read + deserialize, no run)
//   run_pbck(path)             -> { ok, output, locals, globals, chunk }
//   run_pbck_seeded(path, g)   -> { ok, ... }      (seed globals, e.g. import cache)
//
// run_pbck/run_pbck_seeded never throw on a bad path: a file that is missing or
// not a valid container yields { ok: false, error } so callers can branch.

let pbck = import("stdlib/selfhost_pbck.sapp");
let vm   = import("stdlib/compiler/vm.sapp");

// Read a serialized self-hosted chunk from disk and rebuild the chunk-map.
// Propagates the container's errors (bad magic / version / truncation).
fn load_pbck(path) {
    return pbck.read_file(path);
}

fn _run_loaded(path, globals) {
    // catch doesn't bind the error in pblang, so detect load failure via nil.
    let chunk = try load_pbck(path) catch nil;
    if chunk == nil {
        return map{ ok: false, error: "run_pbck: cannot load .pbck file: " + path, output: [] };
    }
    let res = vm.run_seeded(chunk, globals);
    return map{
        ok: true,
        output: res.output,
        locals: res.locals,
        globals: res.globals,
        chunk: chunk,
    };
}

// Load a .pbck from disk and execute it on the self-hosted VM.
fn run_pbck(path) {
    return _run_loaded(path, map{});
}

// Like run_pbck, but starts from a caller-provided globals map (e.g. to inject
// __import_cache__ for programs that use import(...)).
fn run_pbck_seeded(path, globals) {
    if globals == nil { globals = map{}; }
    return _run_loaded(path, globals);
}

export load_pbck, run_pbck, run_pbck_seeded;
