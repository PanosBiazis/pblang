// stdlib/selfhost_bundle.sapp — a pure-pblang LINKER for the self-hosted compiler.
//
// `bundle(main_src, resolve)` links a program and the modules it `import(...)`s
// into ONE self-hosted chunk with NO remaining import() calls, so the result —
// after stdlib/selfhost_to_pbck.sapp::translate — is a self-contained .pbck that
// the native Rust VM runs WITHOUT resolving (or recompiling) any dependency at
// load time. That makes a bundled pblang program independent of the Rust import
// path: pblang compiled it, pblang linked it, the kernel just runs the bytes.
//
// Strategy (shared global namespace + collision rejection): each module's
// top-level code is concatenated (its globals run in the one shared namespace);
// after a module's init we synthesize `__bundle_N = map{ name: <global name>, ... }`
// from its defined globals, and every `import("path")` call site in main is
// rewritten in place to push `__bundle_N`. Correctness is guaranteed by REJECTING
// (ok:false) any program where this could alias: a name defined by two modules,
// a module global that shadows a builtin, an unresolvable path, a compile error,
// or a module that itself imports (nested). On ok:false the caller simply keeps
// using runtime-resolved import (still correct, just not self-contained).

let _fe  = import("stdlib/compiler/selfhost_frontend.sapp");
let _blt = import("stdlib/compiler/builtins_list.sapp");

// Self-hosted opcode numbers (mirror stdlib/compiler/ir.sapp / codegen.sapp).
let OP_CONSTANT = 0;
let OP_POP = 11;
let OP_DEFINE_GLOBAL = 13;
let OP_GET_GLOBAL = 14;
let OP_CALL = 18;
let OP_MAKE_ARRAY = 25;
let OP_MAKE_MAP = 26;

// ── source scan: import("PATH") paths, in source order, de-duplicated ─────────
fn _find_imports(src) {
    let out = [];
    let seen = map{};
    let marker = "import(\"";
    let n = len(src);
    let i = 0;
    while i < n {
        if i + len(marker) <= n and str_slice(src, i, i + len(marker)) == marker {
            let j = i + len(marker);
            let start = j;
            while j < n and str_slice(src, j, j + 1) != "\"" { j = j + 1; }
            let path = str_slice(src, start, j);
            if not map_has(seen, path) { seen[path] = true; array_push(out, path); }
            i = j + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

// Top-level globals a chunk DEFINEs (OP_DEFINE_GLOBAL name), minus __exports__.
fn _defined_globals(chunk) {
    let out = [];
    let i = 0;
    while i < len(chunk.instructions) {
        let ins = chunk.instructions[i];
        if ins.op == OP_DEFINE_GLOBAL {
            let name = chunk.constants[ins.operand];
            if name != "__exports__" { array_push(out, name); }
        }
        i = i + 1;
    }
    return out;
}

// The names a module EXPORTS, extracted statically from its `__exports__` build.
// `export a, b, c;` compiles to `CONST a; CONST b; CONST c; MAKE_ARRAY 3;
// DEFINE_GLOBAL __exports__`, so the exported names are the constants of the
// `count` CONST instructions immediately before the MAKE_ARRAY. Returns the name
// list, or nil if the module has NO export statement (caller then exposes ALL
// globals, matching the runtime `_resolve_module` "no __exports__" fallback).
fn _exported_names(chunk) {
    let ins = chunk.instructions;
    let i = 0;
    while i < len(ins) {
        if ins[i].op == OP_DEFINE_GLOBAL and chunk.constants[ins[i].operand] == "__exports__" {
            if i < 1 or ins[i - 1].op != OP_MAKE_ARRAY { return nil; }
            let count = ins[i - 1].operand;
            let start = i - 1 - count;
            if start < 0 { return nil; }
            let names = [];
            let j = start;
            while j < i - 1 {
                // The array elements must be plain CONST string literals (they are,
                // for `export`); anything else means we can't trust the static read,
                // so fall back to exposing all globals (nil).
                if ins[j].op != OP_CONSTANT { return nil; }
                array_push(names, chunk.constants[ins[j].operand]);
                j = j + 1;
            }
            return names;
        }
        i = i + 1;
    }
    return nil;
}

// The module's VISIBLE surface for the bundle's exports map: only the exported
// names if it declared `export`, otherwise all defined globals (runtime parity).
fn _visible_globals(chunk) {
    let exp = _exported_names(chunk);
    if exp == nil { return _defined_globals(chunk); }
    return exp;
}

// Is there an `import(...)` call (GET_GLOBAL "import") anywhere in these insns?
fn _scan_import_sites(insns, consts) {
    let i = 0;
    while i < len(insns) {
        if insns[i].op == OP_GET_GLOBAL and consts[insns[i].operand] == "import" { return true; }
        i = i + 1;
    }
    return false;
}

// True if any NESTED chunk (a function body or try/catch sub-chunk) contains an
// import() call. Only TOP-LEVEL imports can be linked in place; an import buried
// in a function would be left as a runtime call (not self-contained, and its
// module would init twice), so the bundler rejects these rather than mis-link.
fn _has_nested_import(chunk) {
    let i = 0;
    while i < len(chunk.constants) {
        let c = chunk.constants[i];
        if type(c) == "map" and map_has(c, "chunk") and map_has(c, "arity") {
            if _scan_import_sites(c.chunk.instructions, c.chunk.constants) { return true; }
            if _has_nested_import(c.chunk) { return true; }
        }
        if type(c) == "map" and map_has(c, "try_chunk") and map_has(c, "catch_chunk") {
            if _scan_import_sites(c.try_chunk.instructions, c.try_chunk.constants) { return true; }
            if _has_nested_import(c.try_chunk) { return true; }
            if _scan_import_sites(c.catch_chunk.instructions, c.catch_chunk.constants) { return true; }
            if _has_nested_import(c.catch_chunk) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// Which self-hosted ops carry a JUMP TARGET (instruction index) operand.
fn _is_jump(op) {
    return op == 20 or op == 21 or op == 22 or op == 33 or op == 34 or op == 36 or op == 37;
}
// Which carry a CONSTANT-POOL index operand.
fn _is_const_operand(op) {
    return op == 0 or op == 13 or op == 14 or op == 15 or op == 24 or op == 29 or op == 30 or op == 35;
}

// Append one constant to `merged.constants`, return its index.
fn _add_const(merged, v) {
    array_push(merged.constants, v);
    return len(merged.constants) - 1;
}

// Append `chunk`'s top-level into `merged`, offsetting constant indices and jump
// targets so the concatenation stays self-consistent. If `bundle_map` is non-nil
// (main only), rewrite each `import("path")` triple in place (3 insns -> 3 insns,
// preserving the linear index mapping) to push the bundle's exports map for that
// path. Returns true on success, false if an import path is not in bundle_map.
fn _append(merged, chunk, bundle_map, nil_idx) {
    let base_ins = len(merged.instructions);
    let base_const = len(merged.constants);

    // Copy constants verbatim (nested fn/try constants are self-relative).
    let c = 0;
    while c < len(chunk.constants) { array_push(merged.constants, chunk.constants[c]); c = c + 1; }

    let ins = chunk.instructions;
    let n = len(ins);
    let i = 0;
    while i < n {
        // import("path") rewrite: GET_GLOBAL "import"; CONST <string path>; CALL 1.
        if bundle_map != nil and ins[i].op == OP_GET_GLOBAL
           and chunk.constants[ins[i].operand] == "import"
           and i + 2 < n and ins[i + 1].op == OP_CONSTANT and ins[i + 2].op == OP_CALL
           and ins[i + 2].operand == 1 {
            let path = chunk.constants[ins[i + 1].operand];
            if type(path) == "string" and map_has(bundle_map, path) {
                let bn_idx = bundle_map[path];
                array_push(merged.instructions, map{ op: OP_CONSTANT, operand: nil_idx });   // push nil
                array_push(merged.instructions, map{ op: OP_POP, operand: 0 });               // drop nil
                array_push(merged.instructions, map{ op: OP_GET_GLOBAL, operand: bn_idx });   // push bundle map
                i = i + 3;
            } else {
                return false;   // dynamic / unresolved import path inside a bundle
            }
        } else {
            let op = ins[i].op;
            let operand = try ins[i].operand catch 0;
            if _is_jump(op) { operand = operand + base_ins; }
            else if _is_const_operand(op) { operand = operand + base_const; }
            array_push(merged.instructions, map{ op: op, operand: operand });
            i = i + 1;
        }
    }
    return true;
}

// After a module's init, synthesize `__bundle_<name> = map{ g: <global g>, ... }`.
fn _emit_export_map(merged, defined, bundle_name) {
    let i = 0;
    while i < len(defined) {
        let name = defined[i];
        let k = _add_const(merged, name);
        array_push(merged.instructions, map{ op: OP_CONSTANT, operand: k });        // key
        array_push(merged.instructions, map{ op: OP_GET_GLOBAL, operand: k });      // value (reuse const)
        i = i + 1;
    }
    array_push(merged.instructions, map{ op: OP_MAKE_MAP, operand: len(defined) });
    let bn = _add_const(merged, bundle_name);
    array_push(merged.instructions, map{ op: OP_DEFINE_GLOBAL, operand: bn });
    return bn;
}

fn _err(reason) { return map{ ok: false, reason: reason }; }

// Depth-first collect the TRANSITIVE module graph reachable from `path`, in
// deps-first (post-order) order so a module is appended after every module it
// imports. Cycles and resolve/compile errors are reported via `errbox.err`
// (pblang `catch` doesn't bind the error, so we thread errors through a box).
fn _collect(path, resolve, reg, visiting, order, errbox) {
    if errbox.err != nil { return; }
    if map_has(reg, path) { return; }
    if map_has(visiting, path) { errbox.err = "import cycle at " + str(path); return; }
    visiting[path] = true;
    let src = try resolve(path) catch nil;
    if src == nil { errbox.err = "cannot resolve import: " + str(path); return; }
    let cr = _fe.frontend_compile(src);
    if not cr.ok { errbox.err = "module failed to compile: " + str(path); return; }
    if _has_nested_import(cr.chunk) { errbox.err = "import inside a function/block not supported (use a top-level import) in " + str(path); return; }
    let deps = _find_imports(src);
    let i = 0;
    while i < len(deps) {
        _collect(deps[i], resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return; }
        i = i + 1;
    }
    // `defined` (ALL globals) drives shared-namespace collision detection;
    // `visible` (only exported names, or all if no `export`) is what the bundle's
    // import map exposes, so a module's private globals stay private — matching
    // runtime import semantics.
    reg[path] = map{ path: path, chunk: cr.chunk, defined: _defined_globals(cr.chunk), visible: _visible_globals(cr.chunk) };
    array_push(order, path);
    map_remove(visiting, path);
}

// Link `main_src` + its (transitive) imports into one self-hosted chunk.
// `resolve(path)` returns the module source for an import path, or nil if missing.
fn bundle(main_src, resolve) {
    let paths = _find_imports(main_src);
    if len(paths) == 0 {
        let only = _fe.frontend_compile(main_src);
        if not only.ok { return _err("main failed to compile"); }
        return map{ ok: true, chunk: only.chunk, modules: 0 };
    }

    // Resolve the whole dependency tree, deps-first.
    let reg = map{};
    let order = [];
    let visiting = map{};
    let errbox = map{ err: nil };
    let pi = 0;
    while pi < len(paths) {
        _collect(paths[pi], resolve, reg, visiting, order, errbox);
        if errbox.err != nil { return _err(errbox.err); }
        pi = pi + 1;
    }

    // Collision + builtin-shadow detection across every module (shared namespace).
    let all_defined = map{};
    let oi = 0;
    while oi < len(order) {
        let mod = reg[order[oi]];
        let di = 0;
        while di < len(mod.defined) {
            let nm = mod.defined[di];
            if _blt.is_builtin_name(nm) { return _err("module global shadows builtin '" + str(nm) + "' in " + str(mod.path)); }
            if map_has(all_defined, nm) { return _err("global name collision '" + str(nm) + "' (" + str(all_defined[nm]) + " and " + str(mod.path) + ")"); }
            all_defined[nm] = mod.path;
            di = di + 1;
        }
        oi = oi + 1;
    }

    // Compile main; its own top-level globals must not collide with module globals.
    let mc = _fe.frontend_compile(main_src);
    if not mc.ok { return _err("main failed to compile"); }
    if _has_nested_import(mc.chunk) { return _err("import inside a function/block not supported (use a top-level import) in main"); }
    let main_defined = _defined_globals(mc.chunk);
    let mdi = 0;
    while mdi < len(main_defined) {
        if map_has(all_defined, main_defined[mdi]) {
            return _err("main global collides with a module global '" + str(main_defined[mdi]) + "'");
        }
        mdi = mdi + 1;
    }

    // Merge in deps-first order. Each module's OWN import sites are rewritten using
    // bundle_map, which already holds its deps' bundle globals (built earlier).
    let merged = map{ instructions: [], constants: [] };
    let nil_idx = _add_const(merged, nil);
    let bundle_map = map{};
    let m = 0;
    while m < len(order) {
        let mod = reg[order[m]];
        if not _append(merged, mod.chunk, bundle_map, nil_idx) { return _err("unresolved import in module: " + str(mod.path)); }
        let bn = _emit_export_map(merged, mod.visible, "__bundle_" + str(m));
        bundle_map[mod.path] = bn;
        m = m + 1;
    }

    if not _append(merged, mc.chunk, bundle_map, nil_idx) {
        return _err("unresolved import call site in main");
    }

    return map{ ok: true, chunk: merged, modules: len(order) };
}

// ── convenience: filesystem-backed end-to-end API ────────────────────────────
fn _fs_resolve(p) { return try bytes_to_str(fs_read_bytes(p)) catch nil; }

// Bundle the program at `main_path`, resolving imports from the filesystem.
fn bundle_file(main_path) {
    let src = try bytes_to_str(fs_read_bytes(main_path)) catch nil;
    if src == nil { return _err("cannot read main: " + str(main_path)); }
    return bundle(src, _fs_resolve);
}

// Bundle `main_path` and write a self-contained Rust .pbck to `out_path`.
// Returns {ok:true, modules, out} or {ok:false, reason}.
fn write_bundle(main_path, out_path) {
    let b = bundle_file(main_path);
    if not b.ok { return b; }
    let xl = import("stdlib/selfhost_to_pbck.sapp");
    fs_write_bytes(out_path, xl.translate(b.chunk));
    return map{ ok: true, modules: b.modules, out: out_path };
}

// Bundle `main_path` and write a self-contained SELF-HOSTED (PBCS) .pbck to
// `out_path` — the symmetric sibling of write_bundle. Where write_bundle targets
// the Rust VM (translate), this targets the self-hosted VM: the artifact loads +
// runs via stdlib/selfhost_loader.sapp with no Rust front-end in the path.
// Returns {ok:true, modules, out, bytes} or {ok:false, reason}.
fn write_bundle_selfhost(main_path, out_path) {
    let b = bundle_file(main_path);
    if not b.ok { return b; }
    let pbck = import("stdlib/selfhost_pbck.sapp");
    let blob = pbck.serialize_chunk(b.chunk);
    fs_write_bytes(out_path, blob);
    return map{ ok: true, modules: b.modules, out: out_path, bytes: len(blob) };
}

export bundle, bundle_file, write_bundle, write_bundle_selfhost;
