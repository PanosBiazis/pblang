//! networking_advanced.sapp — Advanced networking for pblang

fn ping(host, timeout_ms) { if timeout_ms==nil{timeout_ms=3000;} let c=tcp_connect(host+":80"); if c!=nil{tcp_close(c);return true;} return false; }
fn dns_lookup(hostname) { return map{raw: exec("nslookup "+hostname+" 2>/dev/null || host "+hostname+" 2>/dev/null || echo ''")}; }
fn whois(domain) { return exec("whois "+domain+" 2>/dev/null || echo ''"); }
fn port_scan(host, start, end) { if start==nil{start=1;} if end==nil{end=1024;} let p=[]; let port=start; while port<=end { let c=tcp_connect(host+":"+str(port)); if c!=nil{tcp_close(c);array_push(p,port);} port=port+1; } return p; }
fn ssl_expiry(hostname, port) { if port==nil{port=443;} return exec("echo | openssl s_client -connect "+hostname+":"+str(port)+" 2>/dev/null | openssl x509 -enddate -noout 2>/dev/null || echo ''"); }
fn http_download(url, dest) { let r=exec("curl -s -o "+dest+" "+url+" 2>/dev/null || wget -q -O "+dest+" "+url+" 2>/dev/null"); return r==""; }
fn url_parse(url) {
    let scheme=""; let host=""; let port=""; let path="/"; let query="";
    if str_contains(url, "://") { let idx=0; while idx<len(url) and url[idx..(idx+1)]!=":"{scheme=scheme+url[idx..(idx+1)];idx=idx+1;} url=url[idx+3..]; }
    let j=0; let in_host=true;
    while j<len(url) {
        if in_host and url[j..(j+1)]=="/" { in_host=false; path=""; }
        if in_host { host=host+url[j..(j+1)]; } else { path=path+url[j..(j+1)]; }
        j=j+1;
    }
    if str_contains(path, "?") { let qi=0; while qi<len(path) and path[qi..(qi+1)]!="?"{qi=qi+1;} query=path[qi+1..]; }
    return map{scheme:scheme, host:host, port:port, path:path, query:query};
}
fn url_encode(t) { let r=""; let i=0; while i<len(t) { let ch=t[i..(i+1)]; if ch==" "{r=r+"%20";}else{if ch=="&"{r=r+"%26";}else{if ch=="="{r=r+"%3D";}else{r=r+ch;}}} i=i+1; } return r; }
fn url_decode(t) { let r=""; let i=0; while i<len(t) { if t[i..(i+1)]=="%" and i+2<len(t) { if t[i..(i+3)]=="%20"{r=r+" ";i=i+3;}else{if t[i..(i+3)]=="%26"{r=r+"&";i=i+3;}else{r=r+t[i..(i+1)];i=i+1;}} } else { r=r+t[i..(i+1)]; i=i+1; } } return r; }
fn is_ipv4(s) { let d=0; let i=0; while i<len(s) { if s[i..(i+1)]=="."{d=d+1;} i=i+1; } return d==3; }
fn is_ipv6(s) { return str_contains(s, ":"); }
fn cidr_to_range(cidr) { let parts=[]; let cur=""; let i=0; while i<len(cidr) { if cidr[i..(i+1)]=="/"{array_push(parts,cur);cur="";}else{cur=cur+cidr[i..(i+1)];} i=i+1; } array_push(parts,cur); return map{network:parts[0], prefix:parts[1]}; }

export ping; export dns_lookup; export whois; export port_scan; export ssl_expiry;
export http_download; export url_parse; export url_encode; export url_decode;
export is_ipv4; export is_ipv6; export cidr_to_range;
