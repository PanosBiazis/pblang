// stdlib/networking_advanced.sapp - advanced networking helpers.
//
// This module keeps pure parsing/planning helpers separate from optional shell or
// socket probes. Pure helpers are safe in tests and sandboxes; probe helpers are
// best-effort and return structured errors when the host denies networking/exec.

fn _is_digit(ch) { return str_contains("0123456789", ch); }

fn shell_quote(s) {
    return "'" + str_replace_all(s, "'", "'\\''") + "'";
}

fn split(s, sep) {
    let out = [];
    let cur = "";
    let i = 0;
    while i < len(s) {
        let ch = s[i..(i + 1)];
        if ch == sep { array_push(out, cur); cur = ""; }
        else { cur = cur + ch; }
        i = i + 1;
    }
    array_push(out, cur);
    return out;
}

fn join(parts, sep) {
    let out = "";
    let i = 0;
    while i < len(parts) {
        if i > 0 { out = out + sep; }
        out = out + str(parts[i]);
        i = i + 1;
    }
    return out;
}

fn parse_query(q) {
    let out = map{};
    if q == nil or q == "" { return out; }
    let pairs = split(q, "&");
    let i = 0;
    while i < len(pairs) {
        let p = pairs[i];
        let k = p;
        let v = "";
        let eq = 0 - 1;
        let j = 0;
        while j < len(p) {
            if eq < 0 and p[j..(j + 1)] == "=" { eq = j; }
            j = j + 1;
        }
        if eq >= 0 {
            k = p[0..eq];
            v = p[(eq + 1)..len(p)];
        }
        out[url_decode(k)] = url_decode(v);
        i = i + 1;
    }
    return out;
}

fn url_parse(input) {
    let rest = input;
    let scheme = "";
    let host = "";
    let port = nil;
    let path = "/";
    let query = "";
    let fragment = "";

    let i = 0;
    while i + 2 < len(rest) {
        if rest[i..(i + 3)] == "://" {
            scheme = rest[0..i];
            rest = rest[(i + 3)..len(rest)];
            i = len(rest);
        }
        i = i + 1;
    }

    let hash = 0 - 1;
    i = 0;
    while i < len(rest) {
        if hash < 0 and rest[i..(i + 1)] == "#" { hash = i; }
        i = i + 1;
    }
    if hash >= 0 {
        fragment = rest[(hash + 1)..len(rest)];
        rest = rest[0..hash];
    }

    let qmark = 0 - 1;
    i = 0;
    while i < len(rest) {
        if qmark < 0 and rest[i..(i + 1)] == "?" { qmark = i; }
        i = i + 1;
    }
    if qmark >= 0 {
        query = rest[(qmark + 1)..len(rest)];
        rest = rest[0..qmark];
    }

    let slash = 0 - 1;
    i = 0;
    while i < len(rest) {
        if slash < 0 and rest[i..(i + 1)] == "/" { slash = i; }
        i = i + 1;
    }
    let authority = rest;
    if slash >= 0 {
        authority = rest[0..slash];
        path = rest[slash..len(rest)];
    }

    // Split host[:port]. IPv6-aware ([::1]:port keeps brackets); a non-numeric or
    // absent port becomes nil instead of throwing.
    if str_starts_with(authority, "[") {
        let rb = 0 - 1;
        i = 0;
        while i < len(authority) { if rb < 0 and authority[i..(i + 1)] == "]" { rb = i; } i = i + 1; }
        if rb >= 0 {
            host = authority[0..(rb + 1)];   // keep the brackets
            let after = authority[(rb + 1)..len(authority)];
            if len(after) > 0 and after[0..1] == ":" {
                port = try parse_number(after[1..len(after)]) catch nil;
            }
        } else {
            host = authority;
        }
    } else {
        let colon = 0 - 1;
        i = 0;
        while i < len(authority) {
            if colon < 0 and authority[i..(i + 1)] == ":" { colon = i; }
            i = i + 1;
        }
        if colon >= 0 {
            host = authority[0..colon];
            port = try parse_number(authority[(colon + 1)..len(authority)]) catch nil;
        } else {
            host = authority;
            if scheme == "http" { port = 80; }
            if scheme == "https" { port = 443; }
        }
    }

    return map{
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query,
        query_params: parse_query(query),
        fragment: fragment,
        authority: authority,
    };
}

fn _hex2(n) {
    let digits = "0123456789ABCDEF";
    let hi = num_floor(n / 16);
    let lo = num_mod(n, 16);
    return digits[hi..(hi + 1)] + digits[lo..(lo + 1)];
}

// url_encode(t) — RFC 3986 percent-encoding: leave the unreserved set
// (A-Z a-z 0-9 - _ . ~) intact, percent-encode every other byte. Non-ASCII is
// encoded as its UTF-8 bytes (was a 6-char hard-coded table that left most
// characters — and all non-ASCII — unescaped).
fn url_encode(t) {
    let unreserved = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~";
    let bytes = str_to_bytes(t);
    let out = "";
    let i = 0;
    while i < len(bytes) {
        let b = bytes[i];
        let ch = strfromcharcode(b);
        if b < 128 and str_contains(unreserved, ch) { out = out + ch; }
        else { out = out + "%" + _hex2(b); }
        i = i + 1;
    }
    return out;
}

// _hex2int(h) — value of a 2-char hex string, or nil. (parse_number does NOT accept
// a "0x" prefix in this build, so percent-decoding parses the digits by hand.)
fn _hex2int(h) {
    let digits = "0123456789abcdef";
    let hi = str_index_of(digits, str_lower(h[0..1]));
    let lo = str_index_of(digits, str_lower(h[1..2]));
    if hi < 0 or lo < 0 { return nil; }
    return hi * 16 + lo;
}

fn _append_str_bytes(bytes, s) {
    let sb = str_to_bytes(s);
    let i = 0;
    while i < len(sb) { array_push(bytes, sb[i]); i = i + 1; }
}

// url_decode(t) — decode ANY %XX (parsed as hex) and "+" -> space. Decoded bytes are
// accumulated and the whole result is interpreted as UTF-8, so a multi-byte sequence
// ("%C3%A9" -> "é") round-trips correctly. (Was limited to a hard-coded handful, so
// e.g. "%41" stayed literal and non-ASCII was corrupted.)
fn url_decode(t) {
    let bytes = [];
    let i = 0;
    let n = len(t);
    while i < n {
        let ch = t[i..(i + 1)];
        if ch == "%" and i + 2 < n {
            let code = _hex2int(t[(i + 1)..(i + 3)]);
            if code != nil { array_push(bytes, code); i = i + 3; }
            else { _append_str_bytes(bytes, ch); i = i + 1; }
        } else if ch == "+" {
            array_push(bytes, 32);
            i = i + 1;
        } else {
            _append_str_bytes(bytes, ch);
            i = i + 1;
        }
    }
    return try bytes_to_str(bytes) catch "";
}

fn is_ipv4(s) {
    let parts = split(s, ".");
    if len(parts) != 4 { return false; }
    let i = 0;
    while i < 4 {
        if parts[i] == "" { return false; }
        let j = 0;
        while j < len(parts[i]) {
            if not _is_digit(parts[i][j..(j + 1)]) { return false; }
            j = j + 1;
        }
        let n = parse_number(parts[i]);
        if n < 0 or n > 255 { return false; }
        i = i + 1;
    }
    return true;
}

fn is_ipv6(s) { return str_contains(s, ":"); }

fn ipv4_to_int(ip) {
    if not is_ipv4(ip) { return nil; }
    let p = split(ip, ".");
    return parse_number(p[0]) * 16777216 + parse_number(p[1]) * 65536 + parse_number(p[2]) * 256 + parse_number(p[3]);
}

fn int_to_ipv4(n) {
    let a = num_floor(n / 16777216);
    n = n - a * 16777216;
    let b = num_floor(n / 65536);
    n = n - b * 65536;
    let c = num_floor(n / 256);
    let d = n - c * 256;
    return str(a) + "." + str(b) + "." + str(c) + "." + str(d);
}

fn pow2(n) {
    let out = 1;
    let i = 0;
    while i < n { out = out * 2; i = i + 1; }
    return out;
}

fn cidr_to_range(cidr) {
    let parts = split(cidr, "/");
    if len(parts) != 2 { return map{ ok: false, error: "expected a.b.c.d/prefix" }; }
    let base = ipv4_to_int(parts[0]);
    let prefix = parse_number(parts[1]);
    if base == nil or prefix < 0 or prefix > 32 { return map{ ok: false, error: "invalid cidr" }; }
    let size = pow2(32 - prefix);
    let start = num_floor(base / size) * size;
    let end = start + size - 1;
    return map{ ok: true, network: int_to_ipv4(start), first: int_to_ipv4(start), last: int_to_ipv4(end), prefix: prefix, size: size };
}

fn cidr_contains(cidr, ip) {
    let r = cidr_to_range(cidr);
    let n = ipv4_to_int(ip);
    if not r.ok or n == nil { return false; }
    return n >= ipv4_to_int(r.first) and n <= ipv4_to_int(r.last);
}

fn subnet_mask(prefix) {
    if prefix <= 0 { return "0.0.0.0"; }
    if prefix >= 32 { return "255.255.255.255"; }
    let mask = (pow2(32) - pow2(32 - prefix));
    return int_to_ipv4(mask);
}

// broadcast(cidr) — the broadcast (last) address of a CIDR block, or nil.
fn broadcast(cidr) {
    let r = cidr_to_range(cidr);
    if not r.ok { return nil; }
    return r.last;
}

// cidr_hosts(cidr) — number of USABLE host addresses: size-2 (excl. network +
// broadcast), but /31 -> 2 (RFC 3021 point-to-point) and /32 -> 1.
fn cidr_hosts(cidr) {
    let r = cidr_to_range(cidr);
    if not r.ok { return 0; }
    if r.prefix >= 31 { return r.size; }
    return r.size - 2;
}

// is_private_ip(ip) — true for RFC 1918 private ranges, loopback (127/8) and
// link-local (169.254/16). Useful as an SSRF guard before connecting to a
// user-supplied host's resolved address.
fn is_private_ip(ip) {
    if not is_ipv4(ip) { return false; }
    if cidr_contains("10.0.0.0/8", ip) { return true; }
    if cidr_contains("172.16.0.0/12", ip) { return true; }
    if cidr_contains("192.168.0.0/16", ip) { return true; }
    if cidr_contains("127.0.0.0/8", ip) { return true; }
    if cidr_contains("169.254.0.0/16", ip) { return true; }
    return false;
}

fn build_http_request(method, url, headers, body) {
    let u = url_parse(url);
    let path = u.path;
    if u.query != "" { path = path + "?" + u.query; }
    let out = method + " " + path + " HTTP/1.1\r\nHost: " + u.host + "\r\n";
    if headers != nil {
        let keys = map_keys(headers);
        let i = 0;
        while i < len(keys) {
            out = out + keys[i] + ": " + str(headers[keys[i]]) + "\r\n";
            i = i + 1;
        }
    }
    if body != nil and body != "" { out = out + "Content-Length: " + str(len(body)) + "\r\n"; }
    out = out + "\r\n";
    if body != nil { out = out + body; }
    return out;
}

fn parse_headers(text) {
    let out = map{};
    let lines = str_split(str_replace_all(text, "\r\n", "\n"), "\n");
    let i = 0;
    while i < len(lines) {
        let line = lines[i];
        let colon = 0 - 1;
        let j = 0;
        while j < len(line) {
            if colon < 0 and line[j..(j + 1)] == ":" { colon = j; }
            j = j + 1;
        }
        if colon > 0 {
            let k = str_lower(str_trim(line[0..colon]));
            let v = str_trim(line[(colon + 1)..len(line)]);
            out[k] = v;
        }
        i = i + 1;
    }
    return out;
}

fn parse_http_response(raw) {
    let normalized = str_replace_all(raw, "\r\n", "\n");
    let lines = str_split(normalized, "\n");
    let status = "";
    if len(lines) > 0 { status = lines[0]; }
    let code = nil;
    if len(status) >= 12 { code = parse_number(status[9..12]); }
    let header_text = "";
    let body = "";
    let in_body = false;
    let i = 1;
    while i < len(lines) {
        if in_body { body = body + lines[i]; if i + 1 < len(lines) { body = body + "\n"; } }
        else if lines[i] == "" { in_body = true; }
        else { header_text = header_text + lines[i] + "\n"; }
        i = i + 1;
    }
    return map{ status_line: status, status: code, headers: parse_headers(header_text), body: body };
}

fn parse_dns_records(text) {
    let records = [];
    let lines = str_split(text, "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if line != "" {
            let parts = str_split(line, " ");
            let clean = [];
            let j = 0;
            while j < len(parts) { if parts[j] != "" { array_push(clean, parts[j]); } j = j + 1; }
            if len(clean) >= 4 {
                array_push(records, map{ name: clean[0], ttl: clean[1], class: clean[2], type: clean[3], value: join(clean[4..len(clean)], " ") });
            }
        }
        i = i + 1;
    }
    return records;
}

fn decode_tcp_flags(n) {
    let flags = [];
    if num_mod(n, 2) >= 1 { array_push(flags, "FIN"); }
    if num_mod(num_floor(n / 2), 2) >= 1 { array_push(flags, "SYN"); }
    if num_mod(num_floor(n / 4), 2) >= 1 { array_push(flags, "RST"); }
    if num_mod(num_floor(n / 8), 2) >= 1 { array_push(flags, "PSH"); }
    if num_mod(num_floor(n / 16), 2) >= 1 { array_push(flags, "ACK"); }
    if num_mod(num_floor(n / 32), 2) >= 1 { array_push(flags, "URG"); }
    return flags;
}

fn ping(host, timeout_ms = nil) {
    if timeout_ms == nil { timeout_ms = 3000; }
    let c = try tcp_connect(host + ":80") catch nil;
    if c != nil { tcp_close(c); return map{ ok: true, host: host }; }
    return map{ ok: false, host: host, error: "connection failed or networking denied" };
}

fn dns_lookup(hostname) {
    let cmd = "nslookup " + shell_quote(hostname) + " 2>/dev/null || host " + shell_quote(hostname) + " 2>/dev/null || true";
    let raw = try exec(cmd) catch "";
    return map{ raw: raw, records: parse_dns_records(raw) };
}

fn whois(domain) {
    return try exec("whois " + shell_quote(domain) + " 2>/dev/null || true") catch "";
}

fn port_scan(host, start = nil, end = nil) {
    if start == nil { start = 1; }
    if end == nil { end = 1024; }
    let open = [];
    let port = start;
    while port <= end {
        let c = try tcp_connect(host + ":" + str(port)) catch nil;
        if c != nil { tcp_close(c); array_push(open, port); }
        port = port + 1;
    }
    return open;
}

fn ssl_expiry(hostname, port = nil) {
    if port == nil { port = 443; }
    let hp = shell_quote(hostname + ":" + str(port));
    return try exec("echo | openssl s_client -connect " + hp + " 2>/dev/null | openssl x509 -enddate -noout 2>/dev/null || true") catch "";
}

export shell_quote, split, join, parse_query, url_parse, url_encode, url_decode;
export is_ipv4, is_ipv6, ipv4_to_int, int_to_ipv4, cidr_to_range, cidr_contains, subnet_mask;
export broadcast, cidr_hosts, is_private_ip;
export build_http_request, parse_headers, parse_http_response, parse_dns_records, decode_tcp_flags;
export ping, dns_lookup, whois, port_scan, ssl_expiry;
