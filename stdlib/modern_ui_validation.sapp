// Shared validation leaf: no renderer imports, callbacks or I/O.
// validate retains the public Modern UI result and diagnostic contract.
let Style=import("stdlib:ui_style.sapp");
let Typography=import("stdlib:ui_typography.sapp");
let ImageFit=import("stdlib:image_fit.sapp");
let MAX_NODES = 1024;
let MAX_DEPTH = 24;
let MAX_CHILDREN = 256;
let MAX_TEXT = 65536;
let MAX_ACTIONS = 128;
let MAX_ACTION_DEPTH = 8;

fn _container(kind) {
    return kind == "screen" or kind == "column" or kind == "row"
    or kind == "grid" or kind == "card";
}

fn _leaf(kind) {
    return kind == "heading" or kind == "text" or kind == "button"
    or kind == "input" or kind == "area" or kind == "toggle"
    or kind == "choice" or kind == "slider" or kind == "progress"
    or kind == "image" or kind == "separator" or kind == "spacer";
}

fn _callable(value) {
    let kind = type(value);
    return value == nil or kind == "fn" or kind == "closure" or kind == "builtin";
}

fn _control_text(value) {
    let i = 0;
    while i < len(value) {
        let code = strcharcodeat(value, i);
        if code < 32 and code != 9 and code != 10 { return true; }
        if code == 127 { return true; }
        i = i + 1;
    }
    return false;
}

fn _valid_animation(value) {
    return value == "" or value == "none" or value == "fade-in"
    or value == "slide-up" or value == "pulse-glow"
    or value == "scale-in" or value == "smooth-lift";
}

fn _validate_action(action, path, depth, state) {
    if depth > MAX_ACTION_DEPTH {
        array_push(state.errors, path + " exceeds maximum action depth");
        return 0;
    }
    state.actions = state.actions + 1;
    if state.actions > MAX_ACTIONS {
        if state.actions == MAX_ACTIONS + 1 {
            array_push(state.errors, "view action limit exceeded");
        }
        return 0;
    }
    if type(action) != "map"
    or (try action.format catch "") != "pblang.modern-ui.action.v1" {
        array_push(state.errors, path + " must be a modern UI action");
        return 0;
    }
    let kind = str(try action.kind catch "");
    if kind == "set_text" or kind == "copy_from" {
        let target = str(try action.target catch "");
        if target == "" or len(target) > 128 or _control_text(target) {
            array_push(state.errors, path + ".target is invalid");
        }
        let value = str(try action.value catch "");
        if len(value) > MAX_TEXT { array_push(state.errors, path + ".value is too long"); }
    } elif kind == "http_request" {
        let http_method = str(try action["method"] catch "POST");
        if http_method != "GET" and http_method != "POST" and http_method != "NAVIGATE" {
            array_push(state.errors, path + ".method must be GET, POST, or NAVIGATE");
        }
        let req_path = str(try action.path catch "");
        if req_path == "" or len(req_path) > 512 or not str_starts_with(req_path, "/") or _control_text(req_path) {
            array_push(state.errors, path + ".path is invalid");
        }
        let target = str(try action.target catch "");
        if target == "" or len(target) > 128 or _control_text(target) {
            array_push(state.errors, path + ".target is invalid");
        }
        let fields = try action.fields catch [];
        if type(fields) != "array" or len(fields) > 64 {
            array_push(state.errors, path + ".fields is invalid");
        } else {
            let fi = 0;
            while fi < len(fields) {
                let fname = str(fields[fi]);
                if fname == "" or len(fname) > 128 or _control_text(fname) {
                    array_push(state.errors, path + ".fields[" + str(fi) + "] is invalid");
                }
                fi = fi + 1;
            }
        }
        let value = str(try action.value catch "");
        if len(value) > MAX_TEXT { array_push(state.errors, path + ".value is too long"); }
    } elif kind == "message" {
        let value = str(try action.value catch "");
        if len(value) > MAX_TEXT { array_push(state.errors, path + ".value is too long"); }
    } elif kind == "sequence" {
        let actions = try action.actions catch nil;
        if type(actions) != "array" or len(actions) > MAX_ACTIONS {
            array_push(state.errors, path + ".actions is invalid");
            return 0;
        }
        let i = 0;
        while i < len(actions) {
            _validate_action(actions[i], path + ".actions[" + str(i) + "]",
            depth + 1, state);
            i = i + 1;
        }
    } else {
        array_push(state.errors, path + " has unsupported action kind: " + kind);
    }
    return 1;
}

fn _validate_node(node, path, depth, state) {
    if depth > MAX_DEPTH {
        array_push(state.errors, path + " exceeds maximum nesting depth");
        return 0;
    }
    state.count = state.count + 1;
    if state.count > MAX_NODES {
        if state.count == MAX_NODES + 1 { array_push(state.errors, "view node limit exceeded"); }
        return 0;
    }
    if type(node) != "map" {
        array_push(state.errors, path + " must be a view node");
        return 0;
    }
    let kind = str(try node.kind catch "");
    if not _container(kind) and not _leaf(kind) {
        array_push(state.errors, path + " has unsupported kind: " + kind);
        return 0;
    }
    let name = str(try node.name catch "");
    if len(name) > 128 or _control_text(name) { array_push(state.errors, path + " has invalid name"); }
    if map_has(node,"accessibility_label") {
        let label=node.accessibility_label;
        if type(label)!="string" {
            array_push(state.errors,path+".accessibility_label must be a string");
        } elif len(label)>1024 or _control_text(label) {
            array_push(state.errors,path+".accessibility_label exceeds 1024 characters or contains control text");
        }
    }
    if map_has(node, "animation") {
        let anim = node.animation;
        if type(anim) != "string" or not _valid_animation(anim) {
            array_push(state.errors, path + ".animation is invalid");
        }
    }
    for key in ["text", "value", "placeholder"] {
        let value = try node[key] catch nil;
        if value != nil and len(str(value)) > MAX_TEXT { array_push(state.errors, path + "." + key + " is too long"); }
    }
    if not _callable(try node.onclick catch nil) { array_push(state.errors, path + ".onclick must be callable"); }
    if not _callable(try node.onchange catch nil) { array_push(state.errors, path + ".onchange must be callable"); }
    let action = try node.action catch nil;
    if action != nil { _validate_action(action, path + ".action", 0, state); }
    for key in ["w", "h", "min_w", "min_h", "gap", "padding", "grow"] {
        let value = try node[key] catch nil;
        if value != nil and (not is_number(value) or value < 0 or value > 8192) {
            array_push(state.errors, path + "." + key + " is invalid");
        }
    }
    if kind=="heading" or kind=="text" or kind=="button" {
        let _t = Typography;
        if _t != nil and not (try Typography.validate(node) catch false) {
            array_push(state.errors,path+" has invalid typography options");
        }
    }
    if kind=="card" {
        let _s = Style;
        if _s != nil and not (try Style.card_validate(node) catch false) {
            array_push(state.errors,path+" has invalid card presentation options");
        }
    }
    let _im = ImageFit;
    if _im != nil and kind == "image" and map_has(node,"fit") and (try ImageFit.mode(node.fit) catch nil)==nil {
        array_push(state.errors,path+".fit must be contain, cover or stretch");
    }
    if _im != nil and kind=="image" and map_has(node,"image_rendering") and (try ImageFit.rendering(node.image_rendering) catch nil)==nil {
        array_push(state.errors,path+".image_rendering must be auto or pixelated");
    }
    if kind == "choice" {
        let values = try node.options catch [];
        if type(values) != "array" or len(values) > 512 { array_push(state.errors, path + ".options is invalid"); }
    }
    if _container(kind) {
        let children = try node.children catch nil;
        if type(children) != "array" {
            array_push(state.errors, path + ".children must be an array");
            return 0;
        }
        if len(children) > MAX_CHILDREN {
            array_push(state.errors, path + " child limit exceeded");
            return 0;
        }
        let i = 0;
        while i < len(children) {
            _validate_node(children[i], path + ".children[" + str(i) + "]", depth + 1, state);
            i = i + 1;
        }
    }
    return 1;
}

fn validate(view) {
    let state = map{ count: 0, actions: 0, errors: [] };
    _validate_node(view, "view", 0, state);
    return map{ ok: len(state.errors) == 0, errors: state.errors,
        nodes: state.count, actions: state.actions };
}

// Non-geometric record order/names match modern_ui's layout traversal.
fn _collect(node,path,depth,state) {
    if depth>MAX_DEPTH or state.nodes>=MAX_NODES { throw "modern UI traversal limit exceeded"; }
    state.nodes=state.nodes+1;
    let container=_container(node.kind);
    let record=not container or node.kind=="card";
    if record or state.web_names {
        let name=str(try node.name catch "");
        if name=="" { name=node.kind+"_"+path; }
        if map_has(state.names,name) { throw "duplicate modern UI widget name"; }
        state.names[name]=true;
        if record { array_push(state.records,map{kind:node.kind,name:name,source:node}); }
    }
    if container {
        let children=node.children;
        if type(children)!="array" or len(children)>MAX_CHILDREN { throw "modern UI child limit exceeded"; }
        let i=0;
        while i<len(children) {
            _collect(children[i],path+"_"+str(i),depth+1,state); i=i+1;
        }
    }
    return true;
}
fn renderer_bundle(bundle,target) {
    if (target!="web" and target!="android") or type(bundle)!="map"
        or (try bundle.format catch "")!="pblang.modern-ui.bundle.v1"
        or (try bundle.target catch "")!=target {
        throw "invalid modern UI renderer bundle";
    }
    let view=try bundle.view catch nil;
    let checked=try validate(view) catch nil;
    if checked==nil or not checked.ok { throw "invalid current modern UI view"; }
    // Web's data-pb-name namespace includes layout containers, not just records.
    let state=map{nodes:0,names:map{},records:[],web_names:target=="web"};
    // Ignore incoming records, node counts, profiles and executable claims.
    if not (try _collect(view,"0",0,state) catch false) { throw "invalid current modern UI records"; }
    return map{format:"pblang.modern-ui.bundle.v1",target:target,view:view,
        records:state.records,source_nodes:state.nodes};
}
export MAX_NODES,validate,renderer_bundle;
