// stdlib/http_client.sapp — Full-featured HTTP client with retry, interceptors, and auth.
//
// Usage:
//   let client = import("stdlib:http_client.sapp");
//   let c = client.new("https://api.example.com", map{ "Accept": "application/json" });
//   let resp = c.get("/users", map{ page: 1 });
//   print resp.status;
//   print resp.body;

let http_mod = import("stdlib:http.sapp");

// parse_response(raw) — parse an HTTP response string
fn parse_response(raw) {
    if raw == nil or raw == "" {
        return map{ status: 0, headers: map{}, body: "", ok: false };
    }
    let parts = str_split(raw, "\r\n\r\n");
    let header_section = parts[0];
    let body = try parts[1] catch "";

    let header_lines = str_split(header_section, "\r\n");
    let status_line = try header_lines[0] catch "";

    // Parse status code from "HTTP/1.1 200 OK"
    let status_parts = str_split(status_line, " ");
    let status_code = try parse_number(status_parts[1]) catch 0;

    // Parse headers
    let headers = map{};
    for i len(header_lines) {
        if i == 0 { } // skip status line
        else {
            let line = header_lines[i];
            let colon_pos = str_index_of(line, ":");
            if colon_pos > 0 {
                let k = str_trim(str_slice(line, 0, colon_pos));
                let v = str_trim(str_slice(line, colon_pos + 1, len(line)));
                headers[k] = v;
            }
        }
    }

    return map{
        status: status_code,
        headers: headers,
        body: body,
        ok: status_code >= 200 and status_code < 300
    };
}

// retry(fn, max_attempts, delay_ms) — retry with exponential backoff
fn retry(fn_, max_attempts, delay_ms) {
    if max_attempts == nil { max_attempts = 3; }
    if delay_ms == nil { delay_ms = 100; }
    let attempt = 0;
    let last_error = nil;
    while attempt < max_attempts {
        let result = try fn_() catch nil;
        if result != nil { return result; }
        attempt = attempt + 1;
        if attempt < max_attempts {
            sleep_ms(delay_ms);
            delay_ms = delay_ms * 2;  // exponential backoff
        }
    }
    return error("http_client.retry: all " + str(max_attempts) + " attempts failed");
}

// build_query_string(params) — build URL query string from map
fn build_query_string(params) {
    if params == nil { return ""; }
    let keys = map_keys(params);
    if len(keys) == 0 { return ""; }
    let parts = [];
    for i len(keys) {
        let k = keys[i];
        let v = str(params[k]);
        parts[i] = k + "=" + v;
    }
    let result = "";
    for i len(parts) {
        if i > 0 { result = result + "&"; }
        result = result + parts[i];
    }
    return "?" + result;
}

// new(base_url, default_headers) — create a new HTTP client
fn new(base_url, default_headers) {
    if base_url == nil { base_url = ""; }
    if default_headers == nil { default_headers = map{}; }

    let client = map{
        _base_url: base_url,
        _headers: default_headers,
        _timeout_ms: 30000
    };

    // client.get(path, params)
    client.get = fn(path, params) {
        let qs = "";
        if params != nil { qs = build_query_string(params); }
        let url = client._base_url + path + qs;
        let raw = try http_get(url) catch nil;
        if raw == nil { return map{ status: 0, ok: false, body: nil, headers: map{} }; }
        return parse_response(raw);
    };

    // client.post(path, body_map)
    client.post = fn(path, body_map) {
        let url = client._base_url + path;
        let body_str = "";
        if body_map != nil { body_str = json_stringify(body_map); }
        let raw = try http_post(url, body_str) catch nil;
        if raw == nil { return map{ status: 0, ok: false, body: nil, headers: map{} }; }
        return parse_response(raw);
    };

    // client.with_auth(token) — return new client with Authorization header
    client.with_auth = fn(token) {
        let new_headers = map{};
        let hk = map_keys(client._headers);
        for i len(hk) { new_headers[hk[i]] = client._headers[hk[i]]; }
        new_headers.Authorization = "Bearer " + str(token);
        return new(client._base_url, new_headers);
    };

    // client.with_header(name, value) — add default header
    client.with_header = fn(name, value) {
        let new_headers = map{};
        let hk = map_keys(client._headers);
        for i len(hk) { new_headers[hk[i]] = client._headers[hk[i]]; }
        new_headers[name] = value;
        return new(client._base_url, new_headers);
    };

    // client.get_json(path, params) — GET and parse JSON response body
    client.get_json = fn(path, params) {
        let resp = client.get(path, params);
        if resp.ok == false { return nil; }
        return try json_parse(resp.body) catch nil;
    };

    // client.post_json(path, data) — POST JSON and parse JSON response
    client.post_json = fn(path, data) {
        let resp = client.post(path, data);
        if resp.ok == false { return nil; }
        return try json_parse(resp.body) catch nil;
    };

    return client;
}

// get(url) — simple GET request, returns response map
fn get(url) {
    let raw = try http_get(url) catch nil;
    if raw == nil { return map{ status: 0, ok: false, body: nil, headers: map{} }; }
    return parse_response(raw);
}

// post(url, body_map) — simple POST request with JSON body
fn post(url, body_map) {
    let body_str = "";
    if body_map != nil { body_str = json_stringify(body_map); }
    let raw = try http_post(url, body_str) catch nil;
    if raw == nil { return map{ status: 0, ok: false, body: nil, headers: map{} }; }
    return parse_response(raw);
}

// get_json(url) — GET and parse JSON
fn get_json(url) {
    let resp = get(url);
    if resp.ok == false { return nil; }
    return try json_parse(resp.body) catch nil;
}

export new, get, post, get_json, parse_response, retry, build_query_string;
