// Private immutable-by-convention schema; never returned by the public API.
// Reuse it without rebuilding sixteen maps on every filesystem call.
let DIRFS_SPECS = map{
        CloseHandle: map{ module: "kernel32.dll", arguments: 1 },
        CreateFileW: map{ module: "kernel32.dll", arguments: 7 },
        FlushFileBuffers: map{ module: "kernel32.dll", arguments: 1 },
        GetFileInformationByHandleEx: map{ module: "kernel32.dll", arguments: 4 },
        GetFileSizeEx: map{ module: "kernel32.dll", arguments: 2 },
        GetLastError: map{ module: "kernel32.dll", arguments: 0 },
        LockFileEx: map{ module: "kernel32.dll", arguments: 6 },
        MultiByteToWideChar: map{ module: "kernel32.dll", arguments: 6 },
        ReadFile: map{ module: "kernel32.dll", arguments: 5 },
        SetFileInformationByHandle: map{ module: "kernel32.dll", arguments: 4 },
        SetFilePointerEx: map{ module: "kernel32.dll", arguments: 4 },
        UnlockFileEx: map{ module: "kernel32.dll", arguments: 5 },
        WriteFile: map{ module: "kernel32.dll", arguments: 5 },
        NtCreateFile: map{ module: "ntdll.dll", arguments: 11 },
        NtQueryDirectoryFile: map{ module: "ntdll.dll", arguments: 11 },
        NtSetInformationFile: map{ module: "ntdll.dll", arguments: 5 },
};
fn _dirfs_specs() { return DIRFS_SPECS; }

// Resolve only the fixed filesystem surface. The module handles and function
// pointers remain private to this module and cannot be selected by callers.
fn open_dirfs_api(state) {
    if state == nil or type(state) != "map" or (try state.closed catch true) {
        return map{ ok: false, error: "Win64 ABI state is closed" };
    }
    if len(map_keys(try state.dirfs_api catch map{})) > 0 {
        return map{ ok: true, format: "pblang.windows-dirfs-api.v1" };
    }
    let specs = _dirfs_specs(); let modules = map{}; let api = map{};
    let names = map_keys(specs); let i = 0;
    while i < len(names) {
        let name = names[i]; let module_name = specs[name].module;
        if not map_has(modules, module_name) {
            modules[module_name] = _load_system_library(state, module_name);
        }
        let module = modules[module_name];
        if module == 0 {
            state.dirfs_api = map{};
            return map{ ok: false, error: "required Windows filesystem module is unavailable" };
        }
        let function_pointer = _symbol(state, module, name);
        if function_pointer == 0 {
            state.dirfs_api = map{};
            return map{ ok: false, error: "required Windows filesystem API is unavailable" };
        }
        api[name] = function_pointer; i = i + 1;
    }
    state.dirfs_api = api;
    return map{ ok: true, format: "pblang.windows-dirfs-api.v1",
        fixed_symbol_count: len(names), arbitrary_symbol_resolution: false };
}

fn call_dirfs(state, name, arguments) {
    let specs = _dirfs_specs();
    if type(name) != "string" or not map_has(specs, name) or type(arguments) != "array"
        or len(arguments) != specs[name].arguments {
        return map{ ok: false, error: "Windows filesystem call is outside the fixed ABI contract" };
    }
    let opened = open_dirfs_api(state); if not opened.ok { return opened; }
    let padded = []; let i = 0;
    while i < len(arguments) { array_push(padded, arguments[i]); i = i + 1; }
    while len(padded) < 11 { array_push(padded, 0); }
    return _call_u64x11(state, state.dirfs_api[name], padded);
}

// Fixed semantic-input gate. Callers provide only serialized Win64 INPUT
// records; module and symbol selection remain private and cannot become an
// arbitrary native call primitive.
fn send_input_records(state, records, count) {
    if state == nil or type(state) != "map" or (try state.closed catch true)
        or type(records) != "array" or not is_number(count)
        or count != num_floor(count) or count < 1 or count > 16384
        or len(records) != count * 40 or len(records) > 655360
        or not _valid_byte_values(records) {
        return map{ ok: false, error: "bounded Win64 INPUT records are invalid" };
    }
    let module = try ffi_call_typed(state.kernel, "LoadLibraryA", "string->ptr",
        ["user32.dll"]) catch 0;
    if not _valid_pointer(module) {
        return map{ ok: false, error: "Windows semantic input module is unavailable" };
    }
    array_push(state.modules, module);
    let send_input = _symbol(state, module, "SendInput");
    if not _valid_pointer(send_input) {
        return map{ ok: false, error: "Windows semantic input API is unavailable" };
    }
    let pointer = allocate(state, len(records));
    if pointer == 0 or not write_bytes(state, pointer, 0, records) {
        if pointer != 0 { free(state, pointer); }
        return map{ ok: false, error: "Windows semantic input buffer is unavailable" };
    }
    let arguments = [count, pointer, 40, 0, 0, 0, 0, 0, 0, 0, 0];
    let called = _call_u64x11(state, send_input, arguments);
    free(state, pointer);
    if not called.ok { return called; }
    return map{ ok: called.value == count, accepted: called.value,
        requested: count, partial_injection_fails_closed: true,
        fixed_system_api: "user32!SendInput" };
}
fn close(state) {
    if state == nil or type(state) != "map" or (try state.closed catch true) { return false; }
    let keys = map_keys(state.allocations); let i = 0;
    while i < len(keys) { let pointer = try parse_number(keys[i]) catch 0; if pointer > 0 { free(state, pointer); } i = i + 1; }
    i = 0; while i < len(state.modules) {
        try ffi_call_typed(state.kernel, "FreeLibrary", "ptr->bool", [state.modules[i]]) catch false; i = i + 1;
    }
    try ffi_close(state.kernel) catch nil; try ffi_close(state.bridge) catch nil;
    state.closed = true; state.allocations = map{}; state.modules = [];
    state.dirfs_api = map{}; return true;
}

fn capabilities() {
    return map{ format: "pblang.windows-native-abi.capabilities.v1",
        platform: "windows", architecture: "x86_64", source_language: "pblang",
        generated_pe_dll: true, external_compiler_required: false,
        integer_pointer_arguments: 11, floating_point_arguments: 0,
        memory_widths: [1, 2, 4, 8], bounded_cstring_copy: true,
        bounded_binary_hex_transfer: true, host_ffi_gate_required: true,
        fixed_dirfs_symbol_count: 16, arbitrary_symbol_resolution: false,
        arbitrary_function_pointer_calls: false, package_acl_required: true,
        raw_pointer_retention: false, runtime_staging_supported: false,
        fixed_semantic_input_api: true,
        temporary_executable_required_for_input: false };
}

