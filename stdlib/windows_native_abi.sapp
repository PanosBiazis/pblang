// stdlib/windows_native_abi.sapp -- generated Win64 ABI/native-memory bridge.
//
// The existing typed FFI remains intentionally small. This module emits a
// dependency-free PE32+ DLL that provides the missing Win64 substrate without
// adding Rust/C source:
//   * one integer/pointer call gate carrying exactly eleven ABI arguments;
//   * bounded byte/word/dword/qword native-memory reads and writes;
//   * bounded C-string copy and binary hex transfer.
//
// It does not grant FFI or memory authority. The host must still enable FFI,
// allowlist the generated DLL and its exact symbols, allocate every buffer, and
// protect the installed artifact with the platform package ACL. No raw pointer
// is retained by this module.

let PE = import("stdlib:windows_pe.sapp");

let DLL_NAME = "pblang-win64-abi.dll";
let EXPORT_NAMES = [
    "pb_call_win64_u64x11", "pb_mem_copy_cstr", "pb_mem_hex", "pb_mem_unhex",
    "pb_mem_read_u8", "pb_mem_read_u16", "pb_mem_read_u32", "pb_mem_read_u64",
    "pb_mem_write_u8", "pb_mem_write_u16", "pb_mem_write_u32", "pb_mem_write_u64",
];

fn _app(dst, src) { let i = 0; while i < len(src) { array_push(dst, src[i]); i = i + 1; } return dst; }
fn _le32(value) {
    if value < 0 { value = 4294967296 + value; }
    return [num_mod(value, 256), num_mod(num_floor(value / 256), 256),
        num_mod(num_floor(value / 65536), 256), num_mod(num_floor(value / 16777216), 256)];
}
fn _set32(bytes, offset, value) {
    let encoded = _le32(value); let i = 0;
    while i < 4 { bytes[offset + i] = encoded[i]; i = i + 1; }
}

fn _assembler() { return map{ bytes: [], labels: map{}, fixups: [] }; }
fn _emit(a, bytes) { _app(a.bytes, bytes); }
fn _label(a, name) {
    if map_has(a.labels, name) { throw "windows_native_abi: duplicate label"; }
    a.labels[name] = len(a.bytes);
}
fn _branch(a, opcode, name) {
    _emit(a, opcode); let pos = len(a.bytes); _emit(a, [0, 0, 0, 0]);
    array_push(a.fixups, map{ pos: pos, name: name });
}
fn _jmp(a, name) { _branch(a, [0xE9], name); }
fn _call(a, name) { _branch(a, [0xE8], name); }
fn _jcc(a, condition, name) { _branch(a, [0x0F, condition], name); }
fn _finish(a) {
    let out = a.bytes; let i = 0;
    while i < len(a.fixups) {
        let fixup = a.fixups[i];
        if not map_has(a.labels, fixup.name) { throw "windows_native_abi: unresolved label"; }
        _set32(out, fixup.pos, a.labels[fixup.name] - (fixup.pos + 4)); i = i + 1;
    }
    return out;
}

fn _begin_export(a, exports, name) { _label(a, name); exports[name] = len(a.bytes); }

fn _emit_call11(a, exports) {
    _begin_export(a, exports, "pb_call_win64_u64x11");
    _emit(a, [0x49,0x89,0xCB, 0x49,0x89,0xD2, 0x48,0x83,0xEC,0x58]);
    _emit(a, [0x49,0x8B,0x0A, 0x49,0x8B,0x52,0x08, 0x4D,0x8B,0x42,0x10, 0x4D,0x8B,0x4A,0x18]);
    let source = 0x20; let target = 0x20;
    while source <= 0x50 {
        _emit(a, [0x49,0x8B,0x42,source, 0x48,0x89,0x44,0x24,target]);
        source = source + 8; target = target + 8;
    }
    _emit(a, [0x41,0xFF,0xD3, 0x48,0x83,0xC4,0x58, 0xC3]);
}

fn _emit_memory_access(a, exports) {
    _begin_export(a, exports, "pb_mem_write_u8");  _emit(a, [0x44,0x88,0x04,0x11,0x31,0xC0,0xC3]);
    _begin_export(a, exports, "pb_mem_write_u16"); _emit(a, [0x66,0x44,0x89,0x04,0x11,0x31,0xC0,0xC3]);
    _begin_export(a, exports, "pb_mem_write_u32"); _emit(a, [0x44,0x89,0x04,0x11,0x31,0xC0,0xC3]);
    _begin_export(a, exports, "pb_mem_write_u64"); _emit(a, [0x4C,0x89,0x04,0x11,0x31,0xC0,0xC3]);
    _begin_export(a, exports, "pb_mem_read_u8");   _emit(a, [0x0F,0xB6,0x04,0x11,0xC3]);
    _begin_export(a, exports, "pb_mem_read_u16");  _emit(a, [0x0F,0xB7,0x04,0x11,0xC3]);
    _begin_export(a, exports, "pb_mem_read_u32");  _emit(a, [0x8B,0x04,0x11,0xC3]);
    _begin_export(a, exports, "pb_mem_read_u64");  _emit(a, [0x48,0x8B,0x04,0x11,0xC3]);
}

fn _emit_copy_cstr(a, exports) {
    _begin_export(a, exports, "pb_mem_copy_cstr");
    _emit(a, [0x4D,0x85,0xC0]); _jcc(a, 0x84, "copy_fail"); // cap == 0
    _emit(a, [0x31,0xC0]); _label(a, "copy_loop");
    _emit(a, [0x4C,0x39,0xC0]); _jcc(a, 0x83, "copy_fail"); // index >= cap
    _emit(a, [0x44,0x8A,0x0C,0x02, 0x44,0x88,0x0C,0x01, 0x45,0x84,0xC9]);
    _jcc(a, 0x84, "copy_done"); _emit(a, [0x48,0xFF,0xC0]); _jmp(a, "copy_loop");
    _label(a, "copy_done"); _emit(a, [0xC3]);
    _label(a, "copy_fail"); _emit(a, [0x48,0xC7,0xC0,0xFF,0xFF,0xFF,0xFF,0xC3]);
}

fn _emit_hex(a, exports) {
    _begin_export(a, exports, "pb_mem_hex");
    _emit(a, [0x49,0x89,0xD2, 0x49,0xD1,0xE2]); _jcc(a, 0x82, "hex_fail");
    _emit(a, [0x49,0xFF,0xC2, 0x4D,0x39,0xD1]); _jcc(a, 0x82, "hex_fail");
    _emit(a, [0x45,0x31,0xD2]); _label(a, "hex_loop");
    _emit(a, [0x49,0x39,0xD2]); _jcc(a, 0x83, "hex_done");
    _emit(a, [0x42,0x0F,0xB6,0x04,0x11, 0x41,0x89,0xC3, 0xC1,0xE8,0x04, 0x3C,0x09]);
    _jcc(a, 0x86, "hex_high_digit"); _emit(a, [0x04,0x37]); _jmp(a, "hex_high_store");
    _label(a, "hex_high_digit"); _emit(a, [0x04,0x30]);
    _label(a, "hex_high_store"); _emit(a, [0x43,0x88,0x04,0x50, 0x44,0x89,0xD8, 0x83,0xE0,0x0F, 0x3C,0x09]);
    _jcc(a, 0x86, "hex_low_digit"); _emit(a, [0x04,0x37]); _jmp(a, "hex_low_store");
    _label(a, "hex_low_digit"); _emit(a, [0x04,0x30]);
    _label(a, "hex_low_store"); _emit(a, [0x43,0x88,0x44,0x50,0x01, 0x49,0xFF,0xC2]);
    _jmp(a, "hex_loop");
    _label(a, "hex_done"); _emit(a, [0x41,0xC6,0x04,0x50,0x00, 0x4C,0x89,0xC0, 0xC3]);
    _label(a, "hex_fail"); _emit(a, [0x31,0xC0,0xC3]);
}

fn _emit_unhex(a, exports) {
    _begin_export(a, exports, "pb_mem_unhex"); _emit(a, [0x45,0x31,0xC9]);
    _label(a, "unhex_loop"); _emit(a, [0x42,0x0F,0xB6,0x04,0x49, 0x84,0xC0]);
    _jcc(a, 0x84, "unhex_done"); _emit(a, [0x4D,0x39,0xC1]); _jcc(a, 0x83, "unhex_fail");
    _call(a, "nibble"); _emit(a, [0x85,0xC0]); _jcc(a, 0x88, "unhex_fail");
    _emit(a, [0xC1,0xE0,0x04, 0x41,0x89,0xC2, 0x42,0x0F,0xB6,0x44,0x49,0x01, 0x84,0xC0]);
    _jcc(a, 0x84, "unhex_fail"); _call(a, "nibble"); _emit(a, [0x85,0xC0]);
    _jcc(a, 0x88, "unhex_fail"); _emit(a, [0x44,0x09,0xD0, 0x42,0x88,0x04,0x0A, 0x49,0xFF,0xC1]);
    _jmp(a, "unhex_loop");
    _label(a, "unhex_done"); _emit(a, [0x4C,0x89,0xC8,0xC3]);
    _label(a, "unhex_fail"); _emit(a, [0x48,0xC7,0xC0,0xFF,0xFF,0xFF,0xFF,0xC3]);
    _label(a, "nibble");
    _emit(a, [0x3C,0x30]); _jcc(a, 0x82, "nibble_invalid");
    _emit(a, [0x3C,0x39]); _jcc(a, 0x86, "nibble_digit");
    _emit(a, [0x0C,0x20, 0x3C,0x61]); _jcc(a, 0x82, "nibble_invalid");
    _emit(a, [0x3C,0x66]); _jcc(a, 0x87, "nibble_invalid");
    _emit(a, [0x2C,0x57, 0x0F,0xB6,0xC0, 0xC3]);
    _label(a, "nibble_digit"); _emit(a, [0x2C,0x30, 0x0F,0xB6,0xC0, 0xC3]);
    _label(a, "nibble_invalid"); _emit(a, [0xB8,0xFF,0xFF,0xFF,0xFF,0xC3]);
}

fn artifact() {
    let a = _assembler(); let exports = map{};
    _emit_call11(a, exports); _emit_memory_access(a, exports);
    _emit_copy_cstr(a, exports); _emit_hex(a, exports); _emit_unhex(a, exports);
    let code = _finish(a); let dll = PE.assemble_dll_x64(DLL_NAME, code, exports);
    dll.sha256 = sha256(base64_encode_bytes(dll.bytes)); dll.source_language = "pblang";
    dll.abi = "win64"; dll.max_call_arguments = 11;
    dll.native_memory_bounds_owned_by_caller = true; dll.no_foreign_source = true;
    return dll;
}

fn _host_arch() {
    let raw = try env_get("PROCESSOR_ARCHITEW6432") catch nil;
    if raw == nil or type(raw) != "string" { raw = ""; }
    let arch = str_lower(raw);
    if arch == "" {
        raw = try env_get("PROCESSOR_ARCHITECTURE") catch nil;
        if raw == nil or type(raw) != "string" { raw = ""; }
        arch = str_lower(raw);
    }
    if str_contains(arch, "amd64") or str_contains(arch, "x86_64") { return "x86_64"; }
    return arch;
}

fn expected_sha256() { return artifact().sha256; }

fn sanitize_path(path) {
    if type(path) != "string" or len(path) < 4 or len(path) > 4096
        or str_contains(path, strfromcharcode(0)) or str_contains(path, "/../")
        or str_contains(path, "\\..\\") or str_contains(str_lower(path), "\\temp\\") {
        throw "windows_native_abi: invalid packaged bridge path";
    }
    let drive_absolute = regex_match(path, "^[A-Za-z]:\\\\[^\\r\\n]+$");
    let unc_absolute = str_starts_with(path, "\\\\") and len(path) > 4;
    if not drive_absolute and not unc_absolute {
        throw "windows_native_abi: bridge path must be absolute";
    }
    return path;
}

// Build/install step only. Runtime code must load this artifact from an
// ACL-protected package directory; temporary-directory staging is rejected by
// policy because it would reintroduce an executable replacement race.
fn write_package_artifact(path) {
    if type(path) != "string" or path == "" { return map{ ok: false, error: "invalid bridge path" }; }
    let built = artifact();
    let wrote = try { fs_write_bytes(path, built.bytes); true } catch false;
    if not wrote { return map{ ok: false, error: "bridge artifact cannot be written" }; }
    let loaded = try fs_read_bytes(path) catch nil;
    if loaded == nil or len(loaded) != len(built.bytes)
        or sha256(base64_encode_bytes(loaded)) != built.sha256 {
        // Do not delete by pathname under a verification result derived from
        // file content. The caller can clean up through its held package root.
        return map{ ok: false, error: "bridge artifact verification failed",
            cleanup_required: true };
    }
    return map{ ok: true, format: built.format, path: path, sha256: built.sha256,
        bytes: len(built.bytes), package_acl_required: true, runtime_staging: false };
}

fn _valid_pointer(value) { return is_number(value) and value == num_floor(value) and value > 0; }
fn _valid_size(value, maximum) {
    return is_number(value) and value == num_floor(value) and value >= 0 and value <= maximum;
}
fn _hex_digit(value) { return if value < 10 { strfromcharcode(48 + value) } else { strfromcharcode(87 + value) }; }
fn _bytes_hex(bytes) {
    let out = ""; let i = 0;
    while i < len(bytes) {
        let value = bytes[i];
        if not _valid_size(value, 255) { throw "windows_native_abi: invalid byte"; }
        out = out + _hex_digit(num_floor(value / 16)) + _hex_digit(num_mod(value, 16)); i = i + 1;
    }
    return out;
}
fn _nibble(code) {
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 65 and code <= 70 { return code - 55; }
    if code >= 97 and code <= 102 { return code - 87; }
    return -1;
}
fn _hex_bytes(text) {
    if type(text) != "string" or num_mod(len(text), 2) != 0 { return nil; }
    let out = []; let i = 0;
    while i < len(text) {
        let high = _nibble(strcharcodeat(text, i)); let low = _nibble(strcharcodeat(text, i + 1));
        if high < 0 or low < 0 { return nil; }
        array_push(out, high * 16 + low); i = i + 2;
    }
    return out;
}

fn _call_bridge(state, symbol, signature, args, fallback = nil) {
    if state == nil or type(state) != "map" or (try state.closed catch true) { return fallback; }
    return try ffi_call_typed(state.bridge, symbol, signature, args) catch fallback;
}

fn load_packaged(path, expected = nil) {
    if platform() != "windows" {
        return map{ ok: false, error: "Win64 ABI bridge is unavailable on this host" };
    }
    // Forced-command and service environments may omit the processor variables
    // even though this x86-64 runtime is already executing. Reject a reported
    // incompatible architecture, but let the Windows loader prove compatibility
    // when architecture metadata is absent.
    let host_arch = _host_arch();
    if host_arch != "" and host_arch != "x86_64" {
        return map{ ok: false, error: "Win64 ABI bridge does not match the reported host architecture: " + host_arch };
    }
    path = try sanitize_path(path) catch nil;
    if path == nil { return map{ ok: false, error: "bridge must use an explicit ACL-protected absolute package path" }; }
    let built = artifact(); if expected == nil { expected = built.sha256; }
    if type(expected) != "string" or expected != built.sha256 {
        return map{ ok: false, error: "bridge digest does not match this PBLang release" };
    }
    let bytes = try fs_read_bytes(path) catch nil;
    if bytes == nil or len(bytes) != len(built.bytes)
        or sha256(base64_encode_bytes(bytes)) != expected {
        return map{ ok: false, error: "packaged bridge integrity check failed" };
    }
    let bridge = try ffi_load(path) catch nil;
    let kernel = try ffi_load("kernel32.dll") catch nil;
    if bridge == nil or kernel == nil {
        if bridge != nil { try ffi_close(bridge) catch nil; }
        if kernel != nil { try ffi_close(kernel) catch nil; }
        return map{ ok: false, error: "trusted Win64 bridge or kernel32 cannot be loaded" };
    }
    let heap = try ffi_call_typed(kernel, "GetProcessHeap", "->ptr", []) catch 0;
    if not _valid_pointer(heap) {
        try ffi_close(kernel) catch nil; try ffi_close(bridge) catch nil;
        return map{ ok: false, error: "process heap is unavailable" };
    }
    return map{ ok: true, format: "pblang.windows-native-abi.state.v1", bridge: bridge,
        kernel: kernel, heap: heap, digest: expected, path: path, closed: false,
        allocations: map{}, modules: [], dirfs_api: map{} };
}

fn allocate(state, size) {
    if not _valid_size(size, 67108864) or size < 1 { return 0; }
    let pointer = try ffi_call_typed(state.kernel, "HeapAlloc", "ptr,i32,i64->ptr",
        [state.heap, 8, size]) catch 0; // HEAP_ZERO_MEMORY
    if _valid_pointer(pointer) { state.allocations[str(pointer)] = size; return pointer; }
    return 0;
}
fn free(state, pointer) {
    if not _valid_pointer(pointer) or not map_has(state.allocations, str(pointer)) { return false; }
    // Win32 BOOL is an integer result. The retained typed FFI returns a number,
    // so comparing its successful value directly with PBLang true loses success.
    let code = try ffi_call_typed(state.kernel, "HeapFree", "ptr,i32,ptr->i32",
        [state.heap, 0, pointer]) catch 0;
    let ok = is_number(code) and code == num_floor(code) and code != 0
        and code >= -2147483648 and code <= 4294967295;
    if ok { map_remove(state.allocations, str(pointer)); }
    return ok == true;
}
fn _owned_range(state, pointer, offset, width) {
    if not _valid_pointer(pointer) or not _valid_size(offset, 67108864) or not _valid_size(width, 67108864)
        or not map_has(state.allocations, str(pointer)) { return false; }
    let size = state.allocations[str(pointer)];
    return offset <= size and width <= size - offset;
}
fn write_uint(state, pointer, offset, value, width) {
    if not _owned_range(state, pointer, offset, width)
        or (width != 1 and width != 2 and width != 4 and width != 8)
        or not is_number(value) or value != num_floor(value) { return false; }
    let limit = 4294967296;
    if width == 1 { limit = 256; }
    elif width == 2 { limit = 65536; }
    if width < 8 and (value < 0 or value >= limit) { return false; }
    // Values above 32 bits are passed as exact integers only when the caller
    // remains within the VM's exact-number range.
    if width == 8 and (not is_number(value) or value != num_floor(value)
        or value < -9007199254740991 or value > 9007199254740991) { return false; }
    let symbol = "pb_mem_write_u" + str(width * 8);
    return _call_bridge(state, symbol, "ptr,i64,i64->i64", [pointer, offset, value], -1) == 0;
}
// Width-specific entry points keep Windows callers below the legacy imported
// closure four-argument boundary while write_uint remains source-compatible.
fn write_u8(state, pointer, offset, value) {
    if not _owned_range(state, pointer, offset, 1) or not is_number(value)
        or value != num_floor(value) or value < 0 or value >= 256 { return false; }
    return _call_bridge(state, "pb_mem_write_u8", "ptr,i64,i64->i64",
        [pointer, offset, value], -1) == 0;
}
fn write_u16(state, pointer, offset, value) {
    if not _owned_range(state, pointer, offset, 2) or not is_number(value)
        or value != num_floor(value) or value < 0 or value >= 65536 { return false; }
    return _call_bridge(state, "pb_mem_write_u16", "ptr,i64,i64->i64",
        [pointer, offset, value], -1) == 0;
}
fn write_u32(state, pointer, offset, value) {
    if not _owned_range(state, pointer, offset, 4) or not is_number(value)
        or value != num_floor(value) or value < 0 or value >= 4294967296 { return false; }
    return _call_bridge(state, "pb_mem_write_u32", "ptr,i64,i64->i64",
        [pointer, offset, value], -1) == 0;
}
fn write_u64(state, pointer, offset, value) {
    if not _owned_range(state, pointer, offset, 8) or not is_number(value)
        or value != num_floor(value) or value < -9007199254740991
        or value > 9007199254740991 { return false; }
    return _call_bridge(state, "pb_mem_write_u64", "ptr,i64,i64->i64",
        [pointer, offset, value], -1) == 0;
}
fn read_uint(state, pointer, offset, width) {
    if not _owned_range(state, pointer, offset, width)
        or (width != 1 and width != 2 and width != 4 and width != 8) { return nil; }
    return _call_bridge(state, "pb_mem_read_u" + str(width * 8), "ptr,i64->i64",
        [pointer, offset], nil);
}
fn read_u8(state, pointer, offset) {
    if not _owned_range(state, pointer, offset, 1) { return nil; }
    return _call_bridge(state, "pb_mem_read_u8", "ptr,i64->i64",
        [pointer, offset], nil);
}
fn read_u16(state, pointer, offset) {
    if not _owned_range(state, pointer, offset, 2) { return nil; }
    return _call_bridge(state, "pb_mem_read_u16", "ptr,i64->i64",
        [pointer, offset], nil);
}
fn read_u32(state, pointer, offset) {
    if not _owned_range(state, pointer, offset, 4) { return nil; }
    return _call_bridge(state, "pb_mem_read_u32", "ptr,i64->i64",
        [pointer, offset], nil);
}
fn read_u64(state, pointer, offset) {
    if not _owned_range(state, pointer, offset, 8) { return nil; }
    return _call_bridge(state, "pb_mem_read_u64", "ptr,i64->i64",
        [pointer, offset], nil);
}
fn _valid_byte_values(bytes) {
    let i = 0; let count = len(bytes);
    while i < count {
        let value = bytes[i];
        if not is_number(value) or value != num_floor(value) or value < 0 or value > 255 { return false; }
        i = i + 1;
    }
    return true;
}

fn write_bytes(state, pointer, offset, bytes) {
    if type(bytes) != "array" or not _owned_range(state, pointer, offset, len(bytes))
        or not _valid_byte_values(bytes) { return false; }
    // Validate every source byte before the first native write. Checking only
    // the packed word admits invalid bytes whose arithmetic contributions cancel.
    // Pointer, offset and total width are validated once above and remain local.
    // Recheck mutable allocation ownership/size and bridge state on every write.
    // The packed word is already an exact uint32 after byte validation.
    let i = 0; let count = len(bytes); let key = str(pointer);
    while i + 4 <= count {
        let value = bytes[i] + bytes[i + 1] * 256 + bytes[i + 2] * 65536
            + bytes[i + 3] * 16777216;
        if not map_has(state.allocations, key) or not (offset + i + 4 <= state.allocations[key])
            or _call_bridge(state, "pb_mem_write_u32", "ptr,i64,i64->i64",
                [pointer, offset + i, value], -1) != 0 { return false; }
        i = i + 4;
    }
    while i < count {
        if not map_has(state.allocations, key) or not (offset + i + 1 <= state.allocations[key])
            or _call_bridge(state, "pb_mem_write_u8", "ptr,i64,i64->i64",
                [pointer, offset + i, bytes[i]], -1) != 0 { return false; }
        i = i + 1;
    }
    return true;
}
fn read_bytes(state, pointer, offset, count) {
    if not _owned_range(state, pointer, offset, count) { return nil; }
    let out = []; let i = 0;
    while i + 4 <= count {
        let value = read_u32(state, pointer, offset + i); if value == nil { return nil; }
        array_push(out, num_mod(value, 256));
        array_push(out, num_mod(num_floor(value / 256), 256));
        array_push(out, num_mod(num_floor(value / 65536), 256));
        array_push(out, num_mod(num_floor(value / 16777216), 256));
        i = i + 4;
    }
    while i < count {
        let value = read_u8(state, pointer, offset + i); if value == nil { return nil; }
        array_push(out, value); i = i + 1;
    }
    return out;
}
fn copy_cstr(state, pointer, offset, text, capacity) {
    if type(text) != "string" or str_contains(text, strfromcharcode(0))
        or not _owned_range(state, pointer, offset, capacity) { return -1; }
    return _call_bridge(state, "pb_mem_copy_cstr", "ptr,string,i64->i64",
        [pointer + offset, text, capacity], -1);
}
fn _call_u64x11(state, function_pointer, arguments) {
    if not _valid_pointer(function_pointer) or type(arguments) != "array" or len(arguments) != 11 {
        return map{ ok: false, error: "Win64 call requires one function pointer and exactly eleven arguments" };
    }
    let packed = allocate(state, 88); if packed == 0 { return map{ ok: false, error: "argument buffer allocation failed" }; }
    let i = 0; let ok = true;
    while i < 11 and ok {
        let value = arguments[i];
        ok = is_number(value) and value == num_floor(value)
            and value >= -9007199254740991 and value <= 9007199254740991
            and write_u64(state, packed, i * 8, value); i = i + 1;
    }
    if not ok { free(state, packed); return map{ ok: false, error: "argument is not an exact Win64 integer/pointer" }; }
    let result = _call_bridge(state, "pb_call_win64_u64x11", "ptr,ptr->i64",
        [function_pointer, packed], nil); free(state, packed);
    if result == nil { return map{ ok: false, error: "Win64 call gate failed" }; }
    return map{ ok: true, value: result };
}
fn _load_system_library(state, name) {
    if name != "ntdll.dll" and name != "kernel32.dll" { return 0; }
    let module = try ffi_call_typed(state.kernel, "LoadLibraryA", "string->ptr", [name]) catch 0;
    if _valid_pointer(module) { array_push(state.modules, module); return module; }
    return 0;
}
fn _symbol(state, module, name) {
    if not _valid_pointer(module) or type(name) != "string" or name == ""
        or len(name) > 128 or str_contains(name, strfromcharcode(0)) { return 0; }
    return try ffi_call_typed(state.kernel, "GetProcAddress", "ptr,string->ptr",
        [module, name]) catch 0;
