// stdlib/llm_core.sapp -- reusable LLM math/training/checkpoint utilities.
//
// This module is intentionally small and pure pblang. It complements tensor.sapp:
// tensor.sapp exposes native fast forward kernels; llm_core.sapp provides the
// deterministic helpers, losses, optimizers, checkpoint IO, and benchmark wrappers
// needed to build pblang-native language models.

let _NATIVE_VEC_THRESHOLD = 1024;
let _NATIVE_DOT_THRESHOLD = 256;
let _NATIVE_MATMUL_THRESHOLD = 4096;
let _NATIVE_SOFTMAX_THRESHOLD = 16;
let _NATIVE_ARGMAX_THRESHOLD = 16;

fn zeros(n) {
    let out = [];
    let i = 0;
    while i < n { push(out, 0.0); i = i + 1; }
    return out;
}

fn fill(n, value) {
    let out = [];
    let i = 0;
    while i < n { push(out, value); i = i + 1; }
    return out;
}

fn copy_vec(v) {
    let out = [];
    let i = 0;
    while i < len(v) { push(out, v[i]); i = i + 1; }
    return out;
}

fn zeros2(rows, cols) {
    let out = [];
    let r = 0;
    while r < rows { push(out, zeros(cols)); r = r + 1; }
    return out;
}

fn shape2(m) {
    if len(m) == 0 { return [0, 0]; }
    return [len(m), len(m[0])];
}

fn tensor1(v) {
    return map{ shape: [len(v)], data: v, dtype: "f32" };
}

fn tensor1_row(v) {
    return map{ shape: [1, len(v)], data: v, dtype: "f32" };
}

fn flatten2(m) {
    let out = [];
    let i = 0;
    while i < len(m) {
        let j = 0;
        while j < len(m[i]) {
            push(out, m[i][j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn tensor2(m) {
    let sh = shape2(m);
    return map{ shape: sh, data: flatten2(m), dtype: "f32" };
}

fn unflatten2(data, rows, cols) {
    let out = [];
    let i = 0;
    while i < rows {
        let row = [];
        let j = 0;
        while j < cols {
            push(row, data[i * cols + j]);
            j = j + 1;
        }
        push(out, row);
        i = i + 1;
    }
    return out;
}

fn native_dot(a, b) {
    return try tensor_dot(tensor1(a), tensor1(b)) catch nil;
}

fn native_add_vec(a, b) {
    let r = try tensor_add(tensor1(a), tensor1(b)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_sub_vec(a, b) {
    let r = try tensor_sub(tensor1(a), tensor1(b)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_scale_vec(v, k) {
    let r = try tensor_scale(tensor1(v), k) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_matmul(a, b) {
    if len(a) == 0 or len(b) == 0 { return []; }
    let r = try tensor_matmul(tensor2(a), tensor2(b)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return unflatten2(r.data, r.shape[0], r.shape[1]);
}

fn native_vecmat(v, m) {
    if len(m) == 0 { return []; }
    let r = try tensor_matmul(tensor1_row(v), tensor2(m)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_softmax(v) {
    let r = try tensor_softmax(tensor1(v)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_argmax(v) {
    return try tensor_argmax(tensor1(v)) catch nil;
}

fn native_relu_vec(v) {
    let r = try tensor_relu(tensor1(v)) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn native_layer_norm_vec(v, eps = 0.00001) {
    let r = try tensor_layer_norm(tensor1(v), eps) catch nil;
    if r == nil or map_has(r, "error") { return nil; }
    return r.data;
}

fn seed_float(seed, a, b, scale = 1.0) {
    let k = seed * 131 + a * 7919 + b * 104729 + 17;
    let frac = num_mod(k * 2654435761, 100000) / 100000;
    return (frac - 0.5) * scale;
}

fn randn_vec(n, seed, scale = 0.02) {
    let out = [];
    let i = 0;
    while i < n {
        push(out, seed_float(seed, i, 0, scale));
        i = i + 1;
    }
    return out;
}

fn randn_matrix(rows, cols, seed, scale = 0.02) {
    let out = [];
    let r = 0;
    while r < rows {
        let row = [];
        let c = 0;
        while c < cols {
            push(row, seed_float(seed, r, c, scale));
            c = c + 1;
        }
        push(out, row);
        r = r + 1;
    }
    return out;
}

fn dot(a, b) {
    if len(a) >= _NATIVE_DOT_THRESHOLD {
        let fast = native_dot(a, b);
        if fast != nil { return fast; }
    }
    let s = 0.0;
    let i = 0;
    while i < len(a) {
        s = s + a[i] * b[i];
        i = i + 1;
    }
    return s;
}

fn add_vec(a, b) {
    if len(a) >= _NATIVE_VEC_THRESHOLD {
        let fast = native_add_vec(a, b);
        if fast != nil { return fast; }
    }
    let out = [];
    let i = 0;
    while i < len(a) {
        push(out, a[i] + b[i]);
        i = i + 1;
    }
    return out;
}

fn sub_vec(a, b) {
    if len(a) >= _NATIVE_VEC_THRESHOLD {
        let fast = native_sub_vec(a, b);
        if fast != nil { return fast; }
    }
    let out = [];
    let i = 0;
    while i < len(a) {
        push(out, a[i] - b[i]);
        i = i + 1;
    }
    return out;
}

fn scale_vec(v, k) {
    if len(v) >= _NATIVE_VEC_THRESHOLD {
        let fast = native_scale_vec(v, k);
        if fast != nil { return fast; }
    }
    let out = [];
    let i = 0;
    while i < len(v) {
        push(out, v[i] * k);
        i = i + 1;
    }
    return out;
}

fn matmul(a, b) {
    if len(a) == 0 or len(b) == 0 { return []; }
    let m = len(a);
    let k = len(a[0]);
    let n = len(b[0]);
    if m * k * n >= _NATIVE_MATMUL_THRESHOLD {
        let fast = native_matmul(a, b);
        if fast != nil { return fast; }
    }
    let out = zeros2(m, n);
    let i = 0;
    while i < m {
        let j = 0;
        while j < n {
            let s = 0.0;
            let p = 0;
            while p < k {
                s = s + a[i][p] * b[p][j];
                p = p + 1;
            }
            out[i][j] = s;
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn matvec(m, v) {
    let out = [];
    let i = 0;
    while i < len(m) {
        push(out, dot(m[i], v));
        i = i + 1;
    }
    return out;
}

fn vecmat(v, m) {
    if len(m) == 0 { return []; }
    let work = len(v) * len(m[0]);
    if work >= _NATIVE_MATMUL_THRESHOLD {
        let fast = native_vecmat(v, m);
        if fast != nil { return fast; }
    }
    let out = [];
    let j = 0;
    while j < len(m[0]) {
        let s = 0.0;
        let i = 0;
        while i < len(v) {
            s = s + v[i] * m[i][j];
            i = i + 1;
        }
        push(out, s);
        j = j + 1;
    }
    return out;
}

fn transpose(m) {
    if len(m) == 0 { return []; }
    let out = zeros2(len(m[0]), len(m));
    let i = 0;
    while i < len(m) {
        let j = 0;
        while j < len(m[0]) {
            out[j][i] = m[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn mean(v) {
    if len(v) == 0 { return 0.0; }
    let s = 0.0;
    let i = 0;
    while i < len(v) { s = s + v[i]; i = i + 1; }
    return s / len(v);
}

fn variance(v) {
    if len(v) == 0 { return 0.0; }
    let mu = mean(v);
    let s = 0.0;
    let i = 0;
    while i < len(v) {
        let d = v[i] - mu;
        s = s + d * d;
        i = i + 1;
    }
    return s / len(v);
}

fn layer_norm_vec(v, eps = 0.00001) {
    if len(v) >= _NATIVE_VEC_THRESHOLD {
        let fast = native_layer_norm_vec(v, eps);
        if fast != nil { return fast; }
    }
    let mu = mean(v);
    let inv = 1.0 / num_sqrt(variance(v) + eps);
    let out = [];
    let i = 0;
    while i < len(v) {
        push(out, (v[i] - mu) * inv);
        i = i + 1;
    }
    return out;
}

fn relu_vec(v) {
    if len(v) >= _NATIVE_VEC_THRESHOLD {
        let fast = native_relu_vec(v);
        if fast != nil { return fast; }
    }
    let out = [];
    let i = 0;
    while i < len(v) {
        if v[i] > 0 { push(out, v[i]); } else { push(out, 0.0); }
        i = i + 1;
    }
    return out;
}

fn softmax(logits, temperature = 1.0) {
    if len(logits) == 0 { return []; }
    if temperature <= 0 { temperature = 1.0; }
    if temperature == 1.0 and len(logits) >= _NATIVE_SOFTMAX_THRESHOLD {
        let fast = native_softmax(logits);
        if fast != nil { return fast; }
    }
    let mx = logits[0] / temperature;
    let i = 1;
    while i < len(logits) {
        let z = logits[i] / temperature;
        if z > mx { mx = z; }
        i = i + 1;
    }
    let out = [];
    let total = 0.0;
    let j = 0;
    while j < len(logits) {
        let e = num_exp(logits[j] / temperature - mx);
        push(out, e);
        total = total + e;
        j = j + 1;
    }
    let k = 0;
    while k < len(out) {
        out[k] = out[k] / total;
        k = k + 1;
    }
    return out;
}

fn argmax(v) {
    if len(v) >= _NATIVE_ARGMAX_THRESHOLD {
        let fast = native_argmax(v);
        if fast != nil { return fast; }
    }
    let best_i = 0;
    let best = v[0];
    let i = 1;
    while i < len(v) {
        if v[i] > best { best = v[i]; best_i = i; }
        i = i + 1;
    }
    return best_i;
}

fn cross_entropy_from_logits(logits, target_id) {
    let p = softmax(logits, 1.0);
    return 0.0 - num_ln(p[target_id] + 0.000000001);
}

fn perplexity(loss) {
    return num_exp(loss);
}

fn sgd_step(params, grads, lr) {
    let out = [];
    let i = 0;
    while i < len(params) {
        push(out, params[i] - lr * grads[i]);
        i = i + 1;
    }
    return out;
}

fn adam_state(size) {
    return map{ t: 0, m: zeros(size), v: zeros(size) };
}

fn adam_step(params, grads, state, lr, beta1, beta2, eps) {
    state.t = state.t + 1;
    let out = [];
    let i = 0;
    while i < len(params) {
        state.m[i] = beta1 * state.m[i] + (1.0 - beta1) * grads[i];
        state.v[i] = beta2 * state.v[i] + (1.0 - beta2) * grads[i] * grads[i];
        let mh = state.m[i] / (1.0 - num_pow(beta1, state.t));
        let vh = state.v[i] / (1.0 - num_pow(beta2, state.t));
        push(out, params[i] - lr * mh / (num_sqrt(vh) + eps));
        i = i + 1;
    }
    return map{ params: out, state: state };
}

fn checkpoint(model, meta) {
    return map{
        format: "pblang.llm.checkpoint.v1",
        created_ms: now_ms(),
        meta: meta,
        model: model
    };
}

fn save_checkpoint(path, ckpt) {
    return fs_write(path, json_stringify(ckpt));
}

fn load_checkpoint(path) {
    return json_parse(fs_read(path));
}

fn benchmark(name, fn_to_run, iterations = 5) {
    let times = [];
    let i = 0;
    while i < iterations {
        let start = now_ms();
        let result = fn_to_run();
        push(times, now_ms() - start);
        i = i + 1;
    }
    let total = 0.0;
    let j = 0;
    while j < len(times) { total = total + times[j]; j = j + 1; }
    return map{ name: name, iterations: iterations, total_ms: total, avg_ms: total / iterations };
}

// ── Activation vectors + training utilities ────────────────────────────────────

fn _sigmoid(x) { return 1 / (1 + num_exp(0 - x)); }
fn _tanh(x) {
    if x > 20 { return 1; }
    if x < (0 - 20) { return 0 - 1; }
    let e = num_exp(2 * x);
    return (e - 1) / (e + 1);
}

fn sigmoid_vec(v) {
    let out = []; let i = 0;
    while i < len(v) { push(out, _sigmoid(v[i])); i = i + 1; }
    return out;
}
fn tanh_vec(v) {
    let out = []; let i = 0;
    while i < len(v) { push(out, _tanh(v[i])); i = i + 1; }
    return out;
}
// gelu_vec — tanh approximation: 0.5x(1 + tanh(√(2/π)(x + 0.044715 x³))).
fn gelu_vec(v) {
    let out = []; let i = 0;
    while i < len(v) {
        let x = v[i];
        let inner = 0.7978845608028654 * (x + 0.044715 * x * x * x);
        push(out, 0.5 * x * (1 + _tanh(inner)));
        i = i + 1;
    }
    return out;
}

// l2_norm(v) — Euclidean norm.
fn l2_norm(v) {
    let s = 0; let i = 0;
    while i < len(v) { s = s + v[i] * v[i]; i = i + 1; }
    return num_sqrt(s);
}

// clip_grad(v, max_norm) — scale v down so its L2 norm <= max_norm (gradient
// clipping for training stability); returned unchanged if already within bounds.
fn clip_grad(v, max_norm) {
    let n = l2_norm(v);
    if n <= max_norm or n == 0 { return v; }
    let scale = max_norm / n;
    let out = []; let i = 0;
    while i < len(v) { push(out, v[i] * scale); i = i + 1; }
    return out;
}

export sigmoid_vec, tanh_vec, gelu_vec, l2_norm, clip_grad;
export zeros, fill, copy_vec, zeros2, shape2, seed_float, randn_vec, randn_matrix;
export tensor1, tensor1_row, flatten2, tensor2, unflatten2;
export native_dot, native_add_vec, native_sub_vec, native_scale_vec, native_matmul, native_vecmat;
export native_softmax, native_argmax, native_relu_vec, native_layer_norm_vec;
export dot, add_vec, sub_vec, scale_vec, matmul, matvec, vecmat, transpose;
export mean, variance, layer_norm_vec, relu_vec, softmax, argmax;
export cross_entropy_from_logits, perplexity;
export sgd_step, adam_state, adam_step;
export checkpoint, save_checkpoint, load_checkpoint, benchmark;
