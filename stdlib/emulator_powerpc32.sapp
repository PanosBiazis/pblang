// stdlib/emulator_powerpc32.sapp -- bounded PowerPC32 execution-model subset.

let Support = import("stdlib:emulator_support.sapp");
let FORMAT = "pblang.emulator.powerpc32.v1";
let DEFAULT_BUDGET = 1000000;
let MAX_CODE_WORDS = 1048576;
let MAX_WORD = 4294967295;

fn _require(value, low, high, name) {
    if not Support.integer(value, low, high) {
        throw "emulator_powerpc32: " + name + " must be " + str(low) + ".." + str(high);
    }
    return value;
}
fn _register(value, name) { return _require(value, 0, 31, name); }
fn _signed16(value, name) { return _require(value, -32768, 32767, name); }
fn _encoded16(value) { let result = value % 65536; if result < 0 { result = result + 65536; } return result; }
fn _decoded16(value) { if value >= 32768 { return value - 65536; } return value; }
fn _u32(value) { let result = value % 4294967296; if result < 0 { result = result + 4294967296; } return result; }

fn add_immediate(destination, source, immediate) {
    _register(destination, "ADDI destination"); _register(source, "ADDI source"); _signed16(immediate, "ADDI immediate");
    return 14 * 67108864 + destination * 2097152 + source * 65536 + _encoded16(immediate);
}
fn add(destination, source_a, source_b) {
    _register(destination, "ADD destination"); _register(source_a, "ADD source A"); _register(source_b, "ADD source B");
    return 31 * 67108864 + destination * 2097152 + source_a * 65536 + source_b * 2048 + 266 * 2;
}
fn subtract_from(destination, source_a, source_b) {
    _register(destination, "SUBF destination"); _register(source_a, "SUBF source A"); _register(source_b, "SUBF source B");
    return 31 * 67108864 + destination * 2097152 + source_a * 65536 + source_b * 2048 + 40 * 2;
}
fn multiply_low_word(destination, source_a, source_b) {
    _register(destination, "MULLW destination"); _register(source_a, "MULLW source A"); _register(source_b, "MULLW source B");
    return 31 * 67108864 + destination * 2097152 + source_a * 65536 + source_b * 2048 + 235 * 2;
}
fn compare_word_immediate(source, immediate) {
    _register(source, "CMPWI source"); _signed16(immediate, "CMPWI immediate");
    return 11 * 67108864 + source * 65536 + _encoded16(immediate);
}
fn branch_not_equal(byte_displacement) {
    _require(byte_displacement, -32768, 32764, "BNE displacement");
    if byte_displacement % 4 != 0 { throw "emulator_powerpc32: BNE displacement must be word aligned"; }
    return 16 * 67108864 + 4 * 2097152 + 2 * 65536 + _encoded16(byte_displacement);
}
fn system_call() { return 17 * 67108864 + 2; }
fn exit_sequence() { return [add_immediate(0, 0, 1), system_call()]; }
fn program(instructions) { return Support.unit_program(instructions, MAX_CODE_WORDS, MAX_WORD, "word"); }
fn _failure(reason, pc, instructions) { return Support.failure(FORMAT, reason, pc, instructions); }

fn run(code, options = nil) {
    let invalid = Support.validate_units(code, MAX_CODE_WORDS, MAX_WORD, "word");
    if invalid != nil { return _failure(invalid, 0, 0); }
    let budget_result = Support.instruction_budget(options, DEFAULT_BUDGET);
    if not budget_result.ok { return _failure(budget_result.error, 0, 0); }
    let registers = []; let i = 0; while i < 32 { array_push(registers, 0); i = i + 1; }
    let cr0_equal = false; let pc = 0; let count = 0;
    while count < budget_result.value {
        if pc < 0 or pc >= len(code) { return _failure("program counter outside code", pc, count); }
        let word = code[pc]; let opcode = num_floor(word / 67108864) % 64;
        let destination = num_floor(word / 2097152) % 32;
        let source_a = num_floor(word / 65536) % 32;
        let source_b = num_floor(word / 2048) % 32;
        let next = pc + 1; count = count + 1;
        if opcode == 14 {
            let base = if source_a == 0 { 0 } else { registers[source_a] };
            registers[destination] = _u32(base + _decoded16(word % 65536));
        }
        elif opcode == 31 {
            let extended = num_floor(word / 2) % 1024;
            if extended == 266 { registers[destination] = _u32(registers[source_a] + registers[source_b]); }
            elif extended == 40 { registers[destination] = _u32(registers[source_b] - registers[source_a]); }
            elif extended == 235 { registers[destination] = _u32(registers[source_a] * registers[source_b]); }
            else { return _failure("unmodeled extended opcode " + str(extended), pc, count); }
        }
        elif opcode == 11 { cr0_equal = registers[source_a] == _decoded16(word % 65536); }
        elif opcode == 16 {
            let branch_options = num_floor(word / 2097152) % 32;
            let condition_bit = num_floor(word / 65536) % 32;
            if branch_options != 4 or condition_bit != 2 { return _failure("only canonical BNE is modeled", pc, count); }
            let displacement = _decoded16(word % 65536);
            if displacement % 4 != 0 { return _failure("unaligned branch displacement", pc, count); }
            if not cr0_equal { next = pc + num_floor(displacement / 4); }
        }
        elif opcode == 17 {
            if word != system_call() { return _failure("unmodeled system-call encoding", pc, count); }
            if registers[0] != 1 { return _failure("unmodeled syscall " + str(registers[0]), pc, count); }
            return map{
                ok: true, format: FORMAT, halted: true, pc: pc,
                instructions: count, registers: registers, value: registers[3] % 256,
                boundary: "verified PowerPC32 arithmetic/CR0-branch/Linux-exit subset; not a full machine"
            };
        }
        else { return _failure("unmodeled primary opcode " + str(opcode), pc, count); }
        pc = next;
    }
    return _failure("instruction budget exceeded", pc, count);
}

export FORMAT, DEFAULT_BUDGET, MAX_CODE_WORDS;
export add_immediate, add, subtract_from, multiply_low_word, compare_word_immediate;
export branch_not_equal, system_call, exit_sequence, program, run;
