// stdlib/doc_export.sapp — pblang-native document exporter backend.
//
// Turns the browser engine's semantic blocks (browser.page_blocks -> [{kind,text,src?}])
// into Markdown / plain text / HTML. This is the "native exporter backend" the IDE's
// "Save As → export text" path wants: a binary document/media preview can be exported to
// a readable text format entirely in pblang.
//
//   let dx = import("stdlib:doc_export.sapp");
//   let blocks = browser.page_blocks(page);
//   fs.write("page.md", dx.to_markdown(blocks));

let H = import("stdlib:html.sapp");

fn _t(b) { return str(try b.text catch ""); }

// to_markdown(blocks) — render blocks as Markdown.
fn to_markdown(blocks) {
    let out = "";
    let i = 0;
    while i < len(blocks) {
        let b = blocks[i];
        let k = try b.kind catch "p";
        if i > 0 { out = out + "\n\n"; }
        if k == "title" or k == "h1" { out = out + "# " + _t(b); }
        else if k == "h2" { out = out + "## " + _t(b); }
        else if k == "h3" { out = out + "### " + _t(b); }
        else if k == "img" { out = out + "![" + _t(b) + "](" + str(try b.src catch "") + ")"; }
        else if k == "hr" { out = out + "---"; }
        else if k == "li" { out = out + "- " + _t(b); }
        else { out = out + _t(b); }
        i = i + 1;
    }
    return out;
}

// to_text(blocks) — plain readable text (blocks separated by blank lines; img -> alt).
fn to_text(blocks) {
    let out = "";
    let i = 0;
    while i < len(blocks) {
        let b = blocks[i];
        let k = try b.kind catch "p";
        if i > 0 { out = out + "\n\n"; }
        if k == "hr" { out = out + "----------------------------------------"; }
        else { out = out + _t(b); }
        i = i + 1;
    }
    return out;
}

// to_html(blocks) — minimal HTML. Text content is run through H.escape (html.tag only
// escapes attributes, not body text) so page content can't inject markup; img src is
// scheme-sanitized by H.img's safe_url path.
fn to_html(blocks) {
    let out = "";
    let i = 0;
    while i < len(blocks) {
        let b = blocks[i];
        let k = try b.kind catch "p";
        let esc = H.escape(_t(b));
        if k == "title" or k == "h1" { out = out + H.heading(1, esc, nil); }
        else if k == "h2" { out = out + H.heading(2, esc, nil); }
        else if k == "h3" { out = out + H.heading(3, esc, nil); }
        else if k == "img" { out = out + H.img(str(try b.src catch ""), _t(b), nil); }
        else if k == "hr" { out = out + "<hr />"; }
        else if k == "li" { out = out + H.tag("li", esc, nil); }
        else { out = out + H.p(esc, nil); }
        out = out + "\n";
        i = i + 1;
    }
    return out;
}

export to_markdown, to_text, to_html;
