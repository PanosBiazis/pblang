// stdlib/nn_graph_dynamics.sapp — metaphor-driven transforms for nn_graph.sapp graphs.
// Each physical/visual idea maps to a concrete, composable graph rewrite:
//   black/white holes (absorb / emit nodes), states of matter (mutability temperature),
//   lockers & keys (gated bonds), knots/strings (cliques), push-pull fans (directional
//   weight scaling), colors/shapes/scales (typed grouping: atoms↔molecules↔particles),
//   dimensions (group + wire by coordinate), tornado (swirl biases), tsunami (multiplying
//   wave front), iceberg (hide the body, keep the visible tip).

let G = import("stdlib:nn_graph.sapp");

// ── states of matter → how mutable connections are (a learning-rate multiplier) ───
fn phase_rate(phase) {
    if phase == "solid" { return 0.1; }      // rigid / nearly frozen
    if phase == "liquid" { return 1; }       // normal flow
    if phase == "gas" { return 2; }          // diffuses faster
    if phase == "plasma" { return 4; }       // most volatile
    return 1;
}

// ── black hole: absorb the k strongest neighbors (kill them, accrue their mass into
//    the node's bias). Returns the (possibly shifted) node id after reindexing. ──────
fn black_hole(g, id, k) {
    let absorbed = 0;
    while absorbed < k and G.node_count(g) > 1 {
        let best = 0 - 1;
        let bestw = 0 - 1;
        let n = 0;
        while n < G.node_count(g) {
            if n != id {
                let w = G.bond_strength(g, n, id) + G.bond_strength(g, id, n);
                if w < 0 { w = 0 - w; }
                if w > bestw { bestw = w; best = n; }
            }
            n = n + 1;
        }
        if best < 0 { return id; }
        g.nodes[id].bias = g.nodes[id].bias + bestw;     // absorbed mass
        G.kill_node(g, best);
        if best < id { id = id - 1; }
        absorbed = absorbed + 1;
    }
    return id;
}

// ── white hole: emit k brand-new nodes, each wired OUTWARD from the source ─────────
fn white_hole(g, id, k, w) {
    let i = 0;
    while i < k {
        let nb = G.add_node(g, 0, "linear");
        G.add_bond(g, id, nb, w);
        i = i + 1;
    }
    return g;
}

// ── lockers & keys: a locked bond transmits nothing until unlocked with its key ───
fn lock_bond(g, idx, key) {
    let e = g.bonds[idx];
    e.saved = e.weight;
    e.weight = 0;
    e.locked = true;
    e.key = key;
    return g;
}
fn is_locked(g, idx) { return (try g.bonds[idx].locked catch false) == true; }
fn unlock_bond(g, idx, key) {
    let e = g.bonds[idx];
    if (try e.locked catch false) == true and (try e.key catch nil) == key {
        e.weight = try e.saved catch e.weight;
        e.locked = false;
    }
    return g;
}

// ── knots / strings: tie a subset of nodes into a mutually-bonded clique ───────────
fn knot(g, ids, w) {
    let i = 0;
    while i < len(ids) {
        let j = 0;
        while j < len(ids) { if ids[i] != ids[j] { G.add_bond(g, ids[i], ids[j], w); } j = j + 1; }
        i = i + 1;
    }
    return g;
}

// ── push / pull fans: scale a node's OUTgoing (blow out) or INcoming (suck in) bonds ─
fn push(g, id, s) {
    let i = 0;
    while i < G.bond_total(g) { let e = g.bonds[i]; if e.from == id { e.weight = e.weight * s; } i = i + 1; }
    return g;
}
fn pull(g, id, s) {
    let i = 0;
    while i < G.bond_total(g) { let e = g.bonds[i]; if e.to == id { e.weight = e.weight * s; } i = i + 1; }
    return g;
}

// ── typed node metadata: colors, shapes, scales (atoms↔molecules↔particles), dims ─
fn set_color(g, id, c) { g.nodes[id].color = c; return g; }
fn get_color(g, id) { return try g.nodes[id].color catch nil; }
fn set_shape(g, id, s) { g.nodes[id].shape = s; return g; }
fn get_shape(g, id) { return try g.nodes[id].shape catch nil; }
fn set_scale(g, id, s) { g.nodes[id].scale = s; return g; }
fn get_scale(g, id) { return try g.nodes[id].scale catch nil; }
fn set_dim(g, id, d) { g.nodes[id].dim = d; return g; }
fn get_dim(g, id) { return try g.nodes[id].dim catch nil; }

fn group_by_color(g, want) {
    let out = [];
    let i = 0;
    let n = len(g.nodes);
    while i < n { if (try g.nodes[i].color catch nil) == want { array_push(out, i); } i = i + 1; }
    return out;
}
fn group_by_shape(g, shp) {
    let out = [];
    let i = 0;
    while i < G.node_count(g) { if (try g.nodes[i].shape catch nil) == shp { array_push(out, i); } i = i + 1; }
    return out;
}
fn group_by_scale(g, scl) {
    let out = [];
    let i = 0;
    while i < G.node_count(g) { if (try g.nodes[i].scale catch nil) == scl { array_push(out, i); } i = i + 1; }
    return out;
}
fn _dim_ids(g, d) {
    let out = [];
    let i = 0;
    while i < G.node_count(g) { if (try g.nodes[i].dim catch nil) == d { array_push(out, i); } i = i + 1; }
    return out;
}
// connect all nodes sharing a dimension into a clique (wire a dimension together).
fn connect_dimension(g, d, w) { return knot(g, _dim_ids(g, d), w); }

// ── tornado: cyclically rotate the biases of a set of nodes (a swirl) ─────────────
fn tornado(g, ids) {
    if len(ids) < 2 { return g; }
    let last = g.nodes[ids[len(ids) - 1]].bias;
    let i = len(ids) - 1;
    while i > 0 { g.nodes[ids[i]].bias = g.nodes[ids[i - 1]].bias; i = i - 1; }
    g.nodes[ids[0]].bias = last;
    return g;
}

// ── tsunami: a multiplying wave — scale the source's outgoing bonds, then the bonds
//    leaving the nodes the wave reached (a two-front surge). ─────────────────────────
fn tsunami(g, source, factor) {
    let targets = [];
    let i = 0;
    while i < G.bond_total(g) {
        let e = g.bonds[i];
        if e.from == source { e.weight = e.weight * factor; array_push(targets, e.to); }
        i = i + 1;
    }
    let j = 0;
    while j < G.bond_total(g) {
        let e = g.bonds[j];
        let hit = false;
        let t = 0;
        while t < len(targets) { if e.from == targets[t] { hit = true; } t = t + 1; }
        if hit { e.weight = e.weight * factor; }
        j = j + 1;
    }
    return g;
}

// ── iceberg: keep only the visible tip — shrink a node's OUTgoing bonds to a fraction
//    while leaving its INcoming bonds (the hidden mass below the surface) intact. ────
fn iceberg(g, id, visible_frac) {
    let i = 0;
    while i < G.bond_total(g) { let e = g.bonds[i]; if e.from == id { e.weight = e.weight * visible_frac; } i = i + 1; }
    return g;
}

export phase_rate, black_hole, white_hole, lock_bond, is_locked, unlock_bond;
export knot, push, pull;
export set_color, get_color, set_shape, get_shape, set_scale, get_scale, set_dim, get_dim;
export group_by_color, group_by_shape, group_by_scale, connect_dimension;
export tornado, tsunami, iceberg;
