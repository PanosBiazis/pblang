// stdlib/polyglot_build.sapp — Polyglot Build System for pblang
//
// Implements build-time polyglot block compilation.
// Extracts @lang { ... } blocks from .sapp files, compiles them
// into native artifacts (dll/so/wasm), and exposes them as modules.
//
// Supported languages: rust, python, c, js, wasm
//
// Usage:
//   let pb = import("stdlib:polyglot_build.sapp");
//   let artifacts = pb.build_file("my_project/main.sapp");
//   // or scan entire project:
//   pb.build_project("my_project/");

// ── Block Extraction ──────────────────────────────────────────────────────────

// extract_blocks(source) — extract all @lang { ... } blocks from source
// Returns array of map{language, code, start_line, end_line}
fn extract_blocks(source) {
    let lines = str_split(source, "\n");
    let blocks = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "@") {
            // Parse @lang_name {
            let brace_pos = str_find(line, "{");
            if brace_pos > 1 {
                let lang = str_trim(str_slice(line, 1, brace_pos));
                let code_lines = [];
                let depth = 1;
                i = i + 1;
                while i < len(lines) && depth > 0 {
                    let cl = lines[i];
                    let j = 0;
                    while j < len(cl) {
                        let ch = str_slice(cl, j, j + 1);
                        if ch == "{" { depth = depth + 1; }
                        if ch == "}" { depth = depth - 1; }
                        j = j + 1;
                    }
                    if depth > 0 {
                        array_push(code_lines, cl);
                    }
                    i = i + 1;
                }
                array_push(blocks, map{
                    language: lang,
                    code: str_join(code_lines, "\n"),
                    line: i,
                });
            }
        }
        i = i + 1;
    }
    return blocks;
}

// ── Build Commands ────────────────────────────────────────────────────────────

// build_rust(block_name, code, out_dir) — compile a @rust block
fn build_rust(block_name, code, out_dir) {
    // Create a temp Rust project, compile to cdylib
    let proj_dir = out_dir + "/rust_" + block_name;
    fs_mkdir(proj_dir);
    fs_write(proj_dir + "/Cargo.toml",
        "[package]\nname = \"" + block_name + "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\npath = \"lib.rs\"\n");
    fs_write(proj_dir + "/lib.rs", code);

    let result = exec("cargo build --release --manifest-path " + proj_dir + "/Cargo.toml");
    if result.exit_code != 0 {
        return map{error: "rust build failed: " + result.stderr};
    }

    let ext = if os_is_windows() { ".dll" } else { ".so" };
    let lib_name = if os_is_windows() { block_name + ext } else { "lib" + block_name + ext };
    return map{
        ok: true,
        artifact: proj_dir + "/target/release/" + lib_name,
        language: "rust",
    };
}

// build_c(block_name, code, out_dir) — compile a @c block
fn build_c(block_name, code, out_dir) {
    let src_file = out_dir + "/" + block_name + ".c";
    fs_write(src_file, code);

    let ext = if os_is_windows() { ".dll" } else { ".so" };
    let out_file = out_dir + "/" + block_name + ext;

    let cc = if os_is_windows() { "gcc" } else { "cc" };
    let result = exec(cc + " -shared -fPIC -o " + out_file + " " + src_file);
    if result.exit_code != 0 {
        return map{error: "c build failed: " + result.stderr};
    }

    return map{
        ok: true,
        artifact: out_file,
        language: "c",
    };
}

// build_python(block_name, code, out_dir) — "compile" python (just save as .py)
fn build_python(block_name, code, out_dir) {
    let py_file = out_dir + "/" + block_name + ".py";
    fs_write(py_file, code);
    return map{
        ok: true,
        artifact: py_file,
        language: "python",
    };
}

// build_js(block_name, code, out_dir) — "compile" JavaScript (save as .js)
fn build_js(block_name, code, out_dir) {
    let js_file = out_dir + "/" + block_name + ".js";
    fs_write(js_file, code);
    return map{
        ok: true,
        artifact: js_file,
        language: "javascript",
    };
}

// build_cpp(block_name, code, out_dir) — compile a @cpp block to shared library
fn build_cpp(block_name, code, out_dir) {
    let src_file = out_dir + "/" + block_name + ".cpp";
    fs_write(src_file, code);

    let ext = if os_is_windows() { ".dll" } else { ".so" };
    let out_file = out_dir + "/" + block_name + ext;

    let cxx = if os_is_windows() { "g++" } else { "c++" };
    let result = exec(cxx + " -shared -fPIC -std=c++17 -o " + out_file + " " + src_file);
    if result.exit_code != 0 {
        return map{error: "cpp build failed: " + result.stderr};
    }

    return map{
        ok: true,
        artifact: out_file,
        language: "cpp",
    };
}

// build_go(block_name, code, out_dir) — compile a @go block to c-shared library
fn build_go(block_name, code, out_dir) {
    let proj_dir = out_dir + "/go_" + block_name;
    fs_mkdir(proj_dir);
    fs_write(proj_dir + "/main.go", code);
    fs_write(proj_dir + "/go.mod", "module " + block_name + "\n\ngo 1.21\n");

    let ext = if os_is_windows() { ".dll" } else { ".so" };
    let out_file = proj_dir + "/" + block_name + ext;

    let result = exec("go build -buildmode=c-shared -o " + out_file + " " + proj_dir + "/main.go");
    if result.exit_code != 0 {
        return map{error: "go build failed: " + result.stderr};
    }

    return map{
        ok: true,
        artifact: out_file,
        language: "go",
    };
}

// build_ruby(block_name, code, out_dir) — "compile" Ruby (save as .rb)
fn build_ruby(block_name, code, out_dir) {
    let rb_file = out_dir + "/" + block_name + ".rb";
    fs_write(rb_file, code);
    return map{
        ok: true,
        artifact: rb_file,
        language: "ruby",
    };
}

// build_wasm(block_name, code, out_dir) — compile a @wasm block (assumes WAT text)
fn build_wasm(block_name, code, out_dir) {
    let src_file = out_dir + "/" + block_name + ".wat";
    fs_write(src_file, code);

    let out_file = out_dir + "/" + block_name + ".wasm";
    let result = exec("wat2wasm " + src_file + " -o " + out_file);
    if result.exit_code != 0 {
        return map{error: "wasm build failed: " + result.stderr};
    }

    return map{
        ok: true,
        artifact: out_file,
        language: "wasm",
    };
}

// ── Project Builder ───────────────────────────────────────────────────────────

// build_file(filepath) — build all polyglot blocks in a file
fn build_file(filepath) {
    let source = fs_read(filepath);
    if source == nil { return map{error: "cannot read: " + filepath}; }

    let blocks = extract_blocks(source);
    let out_dir = path_dirname(filepath) + "/.pblang_polyglot";
    fs_mkdir(out_dir);

    let results = [];
    let i = 0;
    while i < len(blocks) {
        let block = blocks[i];
        let block_name = "block_" + i;

        let result = nil;
        if block.language == "rust" || block.language == "rs" {
            result = build_rust(block_name, block.code, out_dir);
        } else if block.language == "c" {
            result = build_c(block_name, block.code, out_dir);
        } else if block.language == "cpp" || block.language == "c++" || block.language == "cxx" {
            result = build_cpp(block_name, block.code, out_dir);
        } else if block.language == "go" {
            result = build_go(block_name, block.code, out_dir);
        } else if block.language == "ruby" || block.language == "rb" {
            result = build_ruby(block_name, block.code, out_dir);
        } else if block.language == "python" || block.language == "py" {
            result = build_python(block_name, block.code, out_dir);
        } else if block.language == "js" || block.language == "javascript" {
            result = build_js(block_name, block.code, out_dir);
        } else if block.language == "wasm" || block.language == "wat" {
            result = build_wasm(block_name, block.code, out_dir);
        } else {
            result = map{error: "unsupported language: " + block.language};
        }

        array_push(results, result);
        i = i + 1;
    }

    return map{
        ok: true,
        file: filepath,
        blocks: len(blocks),
        artifacts: results,
        output_dir: out_dir,
    };
}

// build_project(project_dir) — build all polyglot blocks in a project
fn build_project(project_dir) {
    let files = fs_list_dir_recursive(project_dir);
    if files == nil { return map{error: "cannot read directory: " + project_dir}; }

    let results = [];
    let i = 0;
    while i < len(files) {
        let file = files[i];
        if str_ends_with(file, ".sapp") || str_ends_with(file, ".sap") {
            let full_path = project_dir + "/" + file;
            let r = build_file(full_path);
            array_push(results, r);
        }
        i = i + 1;
    }

    return map{
        ok: true,
        project: project_dir,
        files_processed: len(results),
        results: results,
    };
}

// ── Artifact Loading ──────────────────────────────────────────────────────────

// load_artifact(artifact_path) — load a compiled artifact via FFI
fn load_artifact(artifact_path) {
    if str_ends_with(artifact_path, ".py") {
        // Execute python and get result
        return polyglot_exec("python", fs_read(artifact_path));
    }
    if str_ends_with(artifact_path, ".js") {
        return polyglot_exec("node", fs_read(artifact_path));
    }
    // Native library — use ffi
    return ffi_load(artifact_path);
}

// ── Helpers ───────────────────────────────────────────────────────────────────

fn path_dirname(filepath) {
    let parts = str_split(filepath, "/");
    if len(parts) <= 1 {
        parts = str_split(filepath, "\\");
    }
    if len(parts) <= 1 { return "."; }
    return str_join(str_slice_arr(parts, 0, len(parts) - 1), "/");
}

fn str_slice_arr(arr, start, end) {
    let result = [];
    let i = start;
    while i < end {
        array_push(result, arr[i]);
        i = i + 1;
    }
    return result;
}

fn os_is_windows() {
    let p = platform();
    return str_contains(str_lower(p), "windows");
}

export extract_blocks;
export build_rust, build_c, build_cpp, build_go, build_ruby, build_python, build_js, build_wasm;
export build_file, build_project;
export load_artifact;
