// ── Compile Language: Q# ────────────────────────────────────────────────────

fn build_qsharp(block_name, code, out_dir) {
    let qs_file = out_dir + "/" + block_name + ".qs";
    fs_write(qs_file, code);
    // Q# runs via the Python `qsharp` package. Reference the already-written .qs
    // FILE (like every other build_* function) instead of inlining `code` into the
    // shell command — that avoids both the quoting breakage that made this whole
    // module fail to parse and a command-injection hole.
    let result = try {
        let r = exec("python3 -c \"import qsharp; qsharp.eval(open('" + qs_file + "').read())\"");
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "qsharp execution failed" };
    if result.exit_code != 0 {
        return map{ ok: true, artifact: qs_file, language: "qsharp", warning: "qsharp via python3 failed, .qs file saved" };
    }
    return map{ ok: true, artifact: qs_file, language: "qsharp" };
}

// ── Compile Language: HTML ───────────────────────────────────────────────────

fn build_html(block_name, code, out_dir) {
    let html_file = out_dir + "/" + block_name + ".html";
    fs_write(html_file, "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>pblang</title></head><body>\n" + code + "\n</body></html>");
    return map{ ok: true, artifact: html_file, language: "html" };
}

