    let scss_file = out_dir + "/" + block_name + ".scss";
    fs_write(scss_file, code);
    let css_file = out_dir + "/" + block_name + ".css";
    let result = try {
        let r = exec("sass --stdin " + scss_file + " " + css_file);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "sass build failed" };
    if result.exit_code != 0 {
        return map{ ok: true, artifact: scss_file, language: "scss", warning: "sass unavailable, .scss file saved" };
    }
    return map{ ok: true, artifact: css_file, language: "scss" };
}

