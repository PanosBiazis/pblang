// ── Compile Language: SQL ────────────────────────────────────────────────────

// Compatibility helper for callers that already hold a non-executing parser
// result. Tool absence is never equivalent to successful validation.
fn sql_result_ok(result) {
    let code = try result.exit_code catch 0;
    if code == 0 { return true; }
    return false;
}

fn build_sql(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let sql_file = out_dir + "/" + block_name + ".sql";
    _write_text_secure(sql_file, code);
    // Build never executes caller SQL. A future backend may attach a bounded,
    // non-executing parser report; until then publication is explicitly
    // source-only and unvalidated.
    return _source_fallback("sql", sql_file,
        "SQL source saved without execution; non-executing parser unavailable");
}

