// ── Compile Language: TypeScript ─────────────────────────────────────────────

fn build_typescript(block_name, code, out_dir) {
    let ts_file = out_dir + "/" + block_name + ".ts";
    fs_write(ts_file, code);
    let result = try {
        let r = exec("npx tsc " + ts_file + " --outDir " + out_dir);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "tsc build failed" };
    if result.exit_code != 0 {
        return map{ ok: true, artifact: ts_file, language: "typescript", warning: "tsc unavailable, .ts file saved" };
    }
    let js_file = out_dir + "/" + block_name + ".js";
    return map{ ok: true, artifact: js_file, language: "typescript" };
}

