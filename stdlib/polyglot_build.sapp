// stdlib/polyglot_build.sapp — Enhanced Polyglot Build System for pblang
//
// Builds and compiles polyglot code blocks for 22+ languages.
// Extracts @lang { ... } blocks from .sapp files, compiles them
// into native artifacts (dll/so/dylib), and exposes them as modules.
//
// Supported languages: rust, c, cpp, go, python, javascript, typescript,
//   java, kotlin, swift, zig, nim, lua, ruby, php, r, dart, bash, perl,
//   haskell, crystal, d, wasm
//
// Usage:
//   let pb = import("stdlib:polyglot_build.sapp");
//   let artifacts = pb.build_file("my_project/main.sapp");

let SECURE_FILE = import("stdlib:secure_file.sapp");
let PROCESS = import("stdlib:process.sapp");
let FFI = import("stdlib:ffi_universal.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

let MAX_BLOCK_NAME_BYTES = 64;
let MAX_SOURCE_BYTES = 4194304;
let MAX_PATH_BYTES = 4096;
let MAX_BLOCKS = 256;
let MAX_BLOCK_DEPTH = 256;
let MAX_PROJECT_DEPTH = 32;
let MAX_PROJECT_FILES = 10000;
let _TOOL_CANDIDATE_CACHE = map{};

fn _valid_block_name(value) {
    if type(value) != "string" or len(value) < 1
       or len(str_to_bytes(value)) > MAX_BLOCK_NAME_BYTES { return false; }
    let i = 0;
    while i < len(value) {
        if not ((strcharcodeat(value, i) >= 65 and strcharcodeat(value, i) <= 90)
            or (strcharcodeat(value, i) >= 97 and strcharcodeat(value, i) <= 122)
            or (i > 0 and strcharcodeat(value, i) >= 48 and strcharcodeat(value, i) <= 57)
            or strcharcodeat(value, i) == 95) { return false; }
        i = i + 1;
    }
    return true;
}

fn _validate_build_input(block_name, code, out_dir) {
    if not _valid_block_name(block_name) {
        throw "polyglot_build: block name must be a bounded ASCII identifier";
    }
    if type(code) != "string" or len(str_to_bytes(code)) > MAX_SOURCE_BYTES {
        throw "polyglot_build: source exceeds 4 MiB";
    }
    if type(out_dir) != "string" or len(out_dir) < 1
       or len(str_to_bytes(out_dir)) > MAX_PATH_BYTES or str_contains(out_dir, strfromcharcode(0))
       or str_contains(out_dir, "\n") or str_contains(out_dir, "\r") {
        throw "polyglot_build: invalid output directory";
    }
    return true;
}

fn validate_build_request(block_name, code, out_dir) {
    let valid = try _validate_build_input(block_name, code, out_dir) catch false;
    return map{ ok: valid, format: "pblang.polyglot-build-request.v1",
        shell_evaluated: false, source_limit: MAX_SOURCE_BYTES,
        path_limit: MAX_PATH_BYTES };
}

fn _valid_tool_name(program) {
    if type(program) != "string" or len(program) < 1 or len(program) > 128 { return false; }
    let i = 0;
    while i < len(program) {
        if not ((strcharcodeat(program, i) >= 65 and strcharcodeat(program, i) <= 90)
            or (strcharcodeat(program, i) >= 97 and strcharcodeat(program, i) <= 122)
            or (strcharcodeat(program, i) >= 48 and strcharcodeat(program, i) <= 57)
            or strcharcodeat(program, i) == 43 or strcharcodeat(program, i) == 45
            or strcharcodeat(program, i) == 46 or strcharcodeat(program, i) == 95) { return false; }
        i = i + 1;
    }
    return true;
}

fn _contains_value(values, wanted) {
    let i = 0;
    while i < len(values) {
        if values[i] == wanted { return true; }
        i = i + 1;
    }
    return false;
}

fn _trusted_tool_candidates(program) {
    if not _valid_tool_name(program) { return []; }
    if map_has(_TOOL_CANDIDATE_CACHE, program) { return _TOOL_CANDIDATE_CACHE[program]; }
    let dirs = ["/usr/bin", "/bin", "/usr/sbin", "/sbin", "/usr/local/bin"];
    let candidates = [];
    for i len(dirs) {
        let candidate = dirs[i] + "/" + program;
        let path = try str_trim(PROCESS.run_fixed_bounded(
            ["/usr/bin/readlink", "/bin/readlink"], ["-f", "--", candidate], map{
                timeout_secs: 2, startup_timeout_ms: 1000, max_output_bytes: 8192,
                max_file_bytes: 1048576, max_memory_bytes: 67108864,
                environment: map{ PATH: "/usr/bin:/bin", HOME: "/nonexistent",
                    TMPDIR: "/tmp", LANG: "C", LC_ALL: "C" }
            }).stdout) catch "";
        let confined = false;
        if path != "" and not str_contains(path, strfromcharcode(0))
           and not str_contains(path, "\n") and not str_contains(path, "\r") {
            for j len(dirs) {
                if str_starts_with(path, dirs[j] + "/") { confined = true; }
            }
        }
        if confined and not _contains_value(candidates, path) { array_push(candidates, path); }
    }
    _TOOL_CANDIDATE_CACHE[program] = candidates;
    return candidates;
}

fn process_status() { return PROCESS.bounded_status(); }

fn verify_artifact(path, max_bytes = 67108864) {
    if type(path) != "string" or len(path) < 1 or len(str_to_bytes(path)) > MAX_PATH_BYTES
       or type(max_bytes) != "number" or max_bytes != num_floor(max_bytes)
       or max_bytes < 1 or max_bytes > 67108864 {
        return map{ ok: false, verified: false, error: "invalid artifact verification request" };
    }
    let loaded = SECURE_FILE.read_bytes(path, max_bytes);
    if not loaded.ok {
        return map{ ok: false, verified: false,
            error: try loaded.error catch "artifact is unavailable or exceeds the byte limit" };
    }
    return map{ ok: true, verified: true, size: loaded.size,
        sha256: SHA256.sha256_hex_bytes(loaded.bytes), bytes_retained: false };
}

// Return a detached copy so callers cannot mutate the executable-identity
// cache used by later build and execution requests.
fn tool_candidates(program) {
    let trusted = _trusted_tool_candidates(program);
    let copied = [];
    let i = 0;
    while i < len(trusted) {
        array_push(copied, trusted[i]);
        i = i + 1;
    }
    return copied;
}

fn _run_argv(program, args, failure) {
    let status = PROCESS.bounded_status();
    if not status.available {
        return map{ exit_code: -1, stdout: "", stderr: failure + ": " + status.reason,
            executed: false, completed: false, bounded: false,
            execution_admitted: false, process_status: status,
            unsupported: true, raw_fallback: false };
    }
    let candidates = _trusted_tool_candidates(program);
    if len(candidates) == 0 {
        return map{ exit_code: -1, stdout: "", stderr: failure + ": invalid compiler name",
            executed: false, completed: false, bounded: true,
            execution_admitted: false, process_status: status,
            unsupported: true, raw_fallback: false };
    }
    let result = PROCESS.run_fixed_bounded(candidates, args, map{
        timeout_secs: 120, startup_timeout_ms: 3000,
        max_output_bytes: 1048576, max_file_bytes: 67108864,
        max_memory_bytes: 2147483648,
        environment: map{
            PATH: "/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin",
            HOME: "/nonexistent", TMPDIR: "/tmp", LANG: "C.UTF-8", LC_ALL: "C.UTF-8"
        }
    });
    if not result.ok {
        return map{ exit_code: -1, stdout: try result.stdout catch "",
            stderr: failure + ": " + (try result.error catch "bounded process failed"),
            executed: try result.completed catch false,
            completed: try result.completed catch false,
            execution_admitted: try result.execution_admitted catch false,
            process_status: try result.process_status catch status,
            bounded: try result.bounded catch true, raw_fallback: false,
            process_group_terminated: try result.process_group_terminated catch false,
            executable_descriptor_held: try result.executable_descriptor_held catch false,
            executable_nofollow: try result.executable_nofollow catch false,
            check_then_exec_race: try result.check_then_exec_race catch false };
    }
    return map{ exit_code: result.exit_code, stdout: result.stdout, stderr: result.stderr,
        executed: try result.completed catch true,
        completed: try result.completed catch true,
        execution_admitted: try result.execution_admitted catch false,
        process_status: try result.process_status catch status,
        bounded: try result.bounded catch true,
        raw_fallback: false, output_truncated: result.output_truncated,
        process_group_terminated: result.process_group_terminated,
        executable_descriptor_held: try result.executable_descriptor_held catch false,
        executable_nofollow: try result.executable_nofollow catch false,
        check_then_exec_race: try result.check_then_exec_race catch false };
}

fn _write_text_secure(path, text) {
    if not SECURE_FILE.write_text_atomic(path, text, true, false).ok {
        throw "polyglot_build: secure source publication failed";
    }
    return true;
}

fn _require_private_output(result) {
    if not result.ok {
        throw "polyglot_build: private no-follow output root unavailable: "
            + (try result.error catch "secure publication rejected");
    }
    return result;
}

fn _private_build_output(parent, context) {
    if parent != "/tmp" and path_dirname(parent) != "/tmp" {
        throw "polyglot_build: output root must be /tmp or one verified private direct child below /tmp";
    }
    if parent != "/tmp" {
        let parent_status = SECURE_FILE.private_temporary_directory_status(parent);
        if not parent_status.ok {
            let parent_created = SECURE_FILE.create_private_temporary_directory_new(parent);
            if not parent_created.ok {
                throw "polyglot_build: approved temporary output root cannot be created safely";
            }
            parent_status = SECURE_FILE.private_temporary_directory_status(parent);
            if not parent_status.ok {
                throw "polyglot_build: temporary output namespace cannot be verified";
            }
        }
    }
    let token = str_slice(sha256(base64_encode_bytes(random_bytes(32))
        + str(now_ms()) + str(context)), 0, 32);
    let output = parent + "/build-" + token;
    let created = if parent == "/tmp" {
        SECURE_FILE.create_private_temporary_directory_new(output)
    } else { SECURE_FILE.create_private_directory_new(output) };
    _require_private_output(created);
    let marker = SECURE_FILE.write_text_new_exclusive(output + "/.session",
        "pblang.polyglot.output.v1\n", false, true);
    if not marker.ok {
        if try marker.cleanup_uncertain catch false {
            throw "polyglot_build: private session marker cleanup unconfirmed; output retained";
        }
        let cleaned = SECURE_FILE.remove(output, parent != "/tmp");
        if not cleaned.ok {
            throw "polyglot_build: private session marker and transactional cleanup both failed";
        }
        _require_private_output(marker);
    }
    return output;
}

fn _source_fallback(language, artifact, warning, process = nil) {
    return map{
        ok: true,
        build_ok: false,
        status: "fallback",
        artifact: artifact,
        artifact_kind: "source",
        language: language,
        compiled: false,
        executed: if process == nil { false } else { try process.executed catch false },
        toolchain_executed: if process == nil { false } else { try process.executed catch false },
        bounded: if process == nil { true } else { try process.bounded catch false },
        artifact_publication_bounded: true,
        warning: warning,
    };
}

fn _source_artifact(language, artifact) {
    return map{ ok: true, build_ok: true, status: "source",
        artifact: artifact, artifact_kind: "source", language: language,
        compiled: false, executed: false, toolchain_executed: false,
        bounded: true, artifact_publication_bounded: true };
}

fn _compile_error(language, message, process, cleanup_artifact = "") {
    return map{ ok: false, build_ok: false, status: "failed",
        language: language, compiled: false,
        executed: try process.executed catch false,
        toolchain_executed: try process.executed catch false,
        bounded: try process.bounded catch false,
        process_group_terminated: try process.process_group_terminated catch false,
        executable_descriptor_held: try process.executable_descriptor_held catch false,
        executable_nofollow: try process.executable_nofollow catch false,
        check_then_exec_race: try process.check_then_exec_race catch false,
        artifact: cleanup_artifact, cleanup_required: cleanup_artifact != "",
        error: message + ": " + (try process.stderr catch "toolchain failed") };
}

fn _compiled_artifact(language, artifact, process) {
    return map{ ok: true, build_ok: true, status: "compiled",
        artifact: artifact, artifact_kind: "binary", language: language,
        compiled: true, executed: try process.executed catch false,
        toolchain_executed: try process.executed catch false,
        execution_admitted: try process.execution_admitted catch false,
        process_status: try process.process_status catch nil,
        raw_fallback: try process.raw_fallback catch false,
        bounded: try process.bounded catch false,
        process_group_terminated: try process.process_group_terminated catch false,
        executable_descriptor_held: try process.executable_descriptor_held catch false,
        executable_nofollow: try process.executable_nofollow catch false,
        check_then_exec_race: try process.check_then_exec_race catch false };
}

// ── Block Extraction ──────────────────────────────────────────────────────────

fn extract_blocks(source) {
    if type(source) != "string" or len(str_to_bytes(source)) > MAX_SOURCE_BYTES {
        throw "polyglot_build: source must be UTF-8 text at most 4 MiB";
    }
    let lines = str_split(source, "\n");
    let blocks = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "@") {
            let brace_pos = str_index_of(line, "{");
            if brace_pos > 1 {
                if len(blocks) >= MAX_BLOCKS { throw "polyglot_build: block limit exceeded"; }
                let lang = str_trim(str_slice(line, 1, brace_pos));
                let code_lines = [];
                let depth = 1;
                i = i + 1;
                while i < len(lines) and depth > 0 {
                    let cl = lines[i];
                    let j = 0;
                    while j < len(cl) {
                        let ch = str_slice(cl, j, j + 1);
                        if ch == "{" { depth = depth + 1; }
                        if ch == "}" { depth = depth - 1; }
                        if depth > MAX_BLOCK_DEPTH { throw "polyglot_build: block nesting limit exceeded"; }
                        j = j + 1;
                    }
                    if depth > 0 {
                        array_push(code_lines, cl);
                    }
                    i = i + 1;
                }
                if depth != 0 { throw "polyglot_build: unterminated polyglot block"; }
                array_push(blocks, map{
                    language: lang,
                    code: str_join(code_lines, "\n"),
                    line: i,
                });
                // The inner loop already advanced to the line after the
                // closing brace. Do not skip an immediately adjacent block.
                continue;
            }
        }
        i = i + 1;
    }
    return blocks;
}

// ── Compile Language: Rust ────────────────────────────────────────────────────

fn build_rust(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let proj_dir = out_dir + "/rust_" + block_name;
    _write_text_secure(proj_dir + "/Cargo.toml",
        "[package]\nname = \"" + block_name + "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\npath = \"lib.rs\"\n");
    _write_text_secure(proj_dir + "/lib.rs", code);
    let result = _run_argv("cargo",
        ["build", "--release", "--manifest-path", proj_dir + "/Cargo.toml"],
        "cargo build failed");
    if result.exit_code != 0 {
        return _compile_error("rust", "rust build failed", result,
            proj_dir + "/lib.rs");
    }
    let ext = _shared_lib_ext();
    let lib_name = _lib_prefix() + block_name + ext;
    return _compiled_artifact("rust",
        proj_dir + "/target/release/" + lib_name, result);
}

// ── Compile Language: C ───────────────────────────────────────────────────────

fn build_c(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let src_file = out_dir + "/" + block_name + ".c";
    _write_text_secure(src_file, code);
    let ext = _shared_lib_ext();
    let out_file = out_dir + "/" + _lib_prefix() + block_name + ext;
    let result = _run_argv("cc", ["-shared", "-fPIC", "-o", out_file, src_file],
        "cc build failed");
    if result.exit_code != 0 {
        return _compile_error("c", "c build failed", result, src_file);
    }
    return _compiled_artifact("c", out_file, result);
}

// ── Compile Language: C++ ─────────────────────────────────────────────────────

fn build_cpp(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let src_file = out_dir + "/" + block_name + ".cpp";
    _write_text_secure(src_file, code);
    let ext = _shared_lib_ext();
    let out_file = out_dir + "/" + _lib_prefix() + block_name + ext;
    let result = _run_argv("c++", ["-shared", "-fPIC", "-std=c++17", "-o", out_file, src_file],
        "c++ build failed");
    if result.exit_code != 0 {
        return _compile_error("cpp", "cpp build failed", result, src_file);
    }
    return _compiled_artifact("cpp", out_file, result);
}

// ── Compile Language: Go ─────────────────────────────────────────────────────

fn build_go(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let proj_dir = out_dir + "/go_" + block_name;
    _write_text_secure(proj_dir + "/main.go", code);
    _write_text_secure(proj_dir + "/go.mod", "module " + block_name + "\n\ngo 1.21\n");
    let ext = _shared_lib_ext();
    let out_file = proj_dir + "/" + block_name + ext;
    let result = _run_argv("go",
        ["build", "-buildmode=c-shared", "-o", out_file, proj_dir + "/main.go"],
        "go build failed");
    if result.exit_code != 0 {
        return _compile_error("go", "go build failed", result, proj_dir + "/main.go");
    }
    return _compiled_artifact("go", out_file, result);
}

// ── Compile Language: Python ─────────────────────────────────────────────────

fn build_python(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let py_file = out_dir + "/" + block_name + ".py";
    _write_text_secure(py_file, code);
    return _source_artifact("python", py_file);
}

// ── Compile Language: JavaScript ─────────────────────────────────────────────

fn build_js(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let js_file = out_dir + "/" + block_name + ".js";
    _write_text_secure(js_file, code);
    return _source_artifact("javascript", js_file);
}

// ── Compile Language: TypeScript ─────────────────────────────────────────────

fn build_typescript(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let ts_file = out_dir + "/" + block_name + ".ts";
    _write_text_secure(ts_file, code);
    // Invoke the installed compiler directly. Package runners may resolve or
    // download mutable packages, which is outside this bounded build contract.
    let result = _run_argv("tsc", [ts_file, "--outDir", out_dir],
        "tsc build failed");
    if result.exit_code != 0 {
        return _source_fallback("typescript", ts_file,
            "tsc unavailable, .ts file saved", result);
    }
    let js_file = out_dir + "/" + block_name + ".js";
    return _compiled_artifact("typescript", js_file, result);
}

// ── Compile Language: Java ───────────────────────────────────────────────────

fn build_java(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let java_file = out_dir + "/" + block_name + ".java";
    _write_text_secure(java_file, code);
    let result = _run_argv("javac", [java_file], "javac build failed");
    if result.exit_code != 0 {
        return _compile_error("java", "java build failed", result, java_file);
    }
    return _compiled_artifact("java", out_dir + "/" + block_name + ".class", result);
}

// ── Compile Language: Kotlin ─────────────────────────────────────────────────

fn build_kotlin(block_name, code, out_dir) {
    _validate_build_input(block_name, code, out_dir);
    out_dir = _private_build_output(out_dir, block_name);
    let kt_file = out_dir + "/" + block_name + ".kt";
    _write_text_secure(kt_file, code);
    let jar_file = out_dir + "/" + block_name + ".jar";
    let result = _run_argv("kotlinc", [kt_file, "-include-runtime", "-d", jar_file],
        "kotlinc build failed");
    if result.exit_code != 0 {
        return _compile_error("kotlin", "kotlin build failed", result, kt_file);
    }
    return _compiled_artifact("kotlin", jar_file, result);
}

