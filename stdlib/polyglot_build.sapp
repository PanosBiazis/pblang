// ── Platform Helpers ──────────────────────────────────────────────────────────

fn _shared_lib_ext() {
    let p = platform();
    if p == "windows" { return ".dll"; }
    if p == "macos" { return ".dylib"; }
    return ".so";
}

fn _lib_prefix() {
    // On Unix, shared library names are typically prefixed with "lib"
    let p = platform();
    if p == "windows" { return ""; }
    return "lib";
}

// ── Project Builder ───────────────────────────────────────────────────────────

fn build_file(filepath) {
    let source = fs_read(filepath);
    if source == nil { return map{ error: "cannot read: " + filepath }; }

    let blocks = extract_blocks(source);
    let out_dir = path_dirname(filepath) + "/.pblang_polyglot";
    fs_mkdirs(out_dir);

    let results = [];
    for i len(blocks) {
        let block = blocks[i];
        let block_name = "block_" + str(i);

        let result = nil;
        if block.language == "rust" or block.language == "rs" {
            result = build_rust(block_name, block.code, out_dir);
        } else if block.language == "c" {
            result = build_c(block_name, block.code, out_dir);
        } else if block.language == "cpp" or block.language == "c++" or block.language == "cxx" {
            result = build_cpp(block_name, block.code, out_dir);
        } else if block.language == "go" {
            result = build_go(block_name, block.code, out_dir);
        } else if block.language == "python" or block.language == "py" {
            result = build_python(block_name, block.code, out_dir);
        } else if block.language == "js" or block.language == "javascript" {
            result = build_js(block_name, block.code, out_dir);
        } else if block.language == "typescript" or block.language == "ts" {
            result = build_typescript(block_name, block.code, out_dir);
        } else if block.language == "java" {
            result = build_java(block_name, block.code, out_dir);
        } else if block.language == "kotlin" or block.language == "kt" {
            result = build_kotlin(block_name, block.code, out_dir);
        } else if block.language == "swift" {
            result = build_swift(block_name, block.code, out_dir);
        } else if block.language == "zig" {
            result = build_zig(block_name, block.code, out_dir);
        } else if block.language == "nim" {
            result = build_nim(block_name, block.code, out_dir);
        } else if block.language == "lua" {
            result = build_lua(block_name, block.code, out_dir);
        } else if block.language == "ruby" or block.language == "rb" {
            result = build_ruby(block_name, block.code, out_dir);
        } else if block.language == "php" {
            result = build_php(block_name, block.code, out_dir);
        } else if block.language == "r" {
            result = build_r(block_name, block.code, out_dir);
        } else if block.language == "dart" {
            result = build_dart(block_name, block.code, out_dir);
        } else if block.language == "bash" or block.language == "sh" {
            result = build_bash(block_name, block.code, out_dir);
        } else if block.language == "perl" or block.language == "pl" {
            result = build_perl(block_name, block.code, out_dir);
        } else if block.language == "haskell" or block.language == "hs" {
            result = build_haskell(block_name, block.code, out_dir);
        } else if block.language == "crystal" or block.language == "cr" {
            result = build_crystal(block_name, block.code, out_dir);
        } else if block.language == "d" {
            result = build_d(block_name, block.code, out_dir);
        } else if block.language == "wasm" or block.language == "wat" {
            result = build_wasm(block_name, block.code, out_dir);
        } else if block.language == "qsharp" or block.language == "qs" or block.language == "q#" {
            result = build_qsharp(block_name, block.code, out_dir);
        } else if block.language == "html" {
            result = build_html(block_name, block.code, out_dir);
        } else if block.language == "css" {
            result = build_css(block_name, block.code, out_dir);
        } else if block.language == "scss" or block.language == "sass" {
            result = build_sass(block_name, block.code, out_dir);
        } else if block.language == "less" {
            result = build_less(block_name, block.code, out_dir);
        } else if block.language == "sql" or block.language == "sqlite" {
            result = build_sql(block_name, block.code, out_dir);
        } else if block.language == "matlab" or block.language == "octave" or block.language == "m" {
            result = build_matlab(block_name, block.code, out_dir);
        } else if block.language == "prolog" or block.language == "plg" {
            result = build_prolog(block_name, block.code, out_dir);
        } else if block.language == "forth" or block.language == "fth" {
            result = build_forth(block_name, block.code, out_dir);
        } else if block.language == "solidity" or block.language == "sol" {
            result = build_solidity(block_name, block.code, out_dir);
        } else if block.language == "odin" {
            result = build_odin(block_name, block.code, out_dir);
        } else if block.language == "carbon" {
            result = build_carbon(block_name, block.code, out_dir);
        } else if block.language == "mojo" {
            result = build_mojo(block_name, block.code, out_dir);
        } else if block.language == "chapel" or block.language == "chpl" {
            result = build_chapel(block_name, block.code, out_dir);
        } else if block.language == "factor" {
            result = build_factor(block_name, block.code, out_dir);
        } else if block.language == "purescript" or block.language == "purs" {
            result = build_purescript(block_name, block.code, out_dir);
        } else {
            result = map{ error: "unsupported language: " + block.language };
        }

        array_push(results, result);
    }

    return map{
        ok: true,
        file: filepath,
        blocks: len(blocks),
        artifacts: results,
        output_dir: out_dir,
    };
}

fn build_project(project_dir) {
    let files = fs_list_dir_recursive(project_dir);
    if files == nil { return map{ error: "cannot read directory: " + project_dir }; }

    let results = [];
    for i len(files) {
        let file = files[i];
        if str_ends_with(file, ".sapp") or str_ends_with(file, ".sap") {
            let full_path = project_dir + "/" + file;
            let r = build_file(full_path);
            array_push(results, r);
        }
    }

    return map{
        ok: true,
        project: project_dir,
        files_processed: len(results),
        results: results,
    };
}

// ── Artifact Loading ──────────────────────────────────────────────────────────

fn load_artifact(artifact_path) {
    if str_ends_with(artifact_path, ".py") {
        return polyglot_exec("python", fs_read(artifact_path));
    }
    if str_ends_with(artifact_path, ".js") {
        return polyglot_exec("node", fs_read(artifact_path));
    }
    return ffi_load(artifact_path);
}

// ── Helpers ───────────────────────────────────────────────────────────────────

fn path_dirname(filepath) {
    let parts = str_split(filepath, "/");
    if len(parts) <= 1 {
        parts = str_split(filepath, "\\");
    }
    if len(parts) <= 1 { return "."; }
    return str_join(str_slice_arr(parts, 0, len(parts) - 1), "/");
}

fn str_slice_arr(arr, start_idx, end_idx) {
    let result = [];
    let i = start_idx;
    while i < end_idx {
        array_push(result, arr[i]);
        i = i + 1;
    }
    return result;
}

