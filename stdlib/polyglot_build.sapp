// ── Platform Helpers ──────────────────────────────────────────────────────────

fn _shared_lib_ext() {
    let p = platform();
    if p == "windows" { return ".dll"; }
    if p == "macos" { return ".dylib"; }
    return ".so";
}

fn _lib_prefix() {
    // On Unix, shared library names are typically prefixed with "lib"
    let p = platform();
    if p == "windows" { return ""; }
    return "lib";
}

// ── Project Builder ───────────────────────────────────────────────────────────

// Canonical language dispatch used by both direct registry builds and
// extracted @language blocks. Keeping one dispatch table prevents security and
// correctness fixes from drifting between the two public entrypoints.
fn _unsafe_build_authorized(options, code) {
    return type(options) == "map" and type(code) == "string"
        and (try options.unsafe_polyglot catch false)
        and (try options.trusted_source catch false)
        and (try options.allow_toolchain_effects catch false)
        and type(try options.unsafe_polyglot_sha256 catch nil) == "string"
        and options.unsafe_polyglot_sha256 == SHA256.sha256_hex_bytes(str_to_bytes(code));
}

fn build_language(language, block_name, code, out_dir, options = nil) {
    if not _unsafe_build_authorized(options, code) {
        return map{ ok: false, build_ok: false, compiled: false, executed: false,
            bounded: true, unsafe_polyglot_required: true,
            unsafe_polyglot_acknowledged: false, unsafe_polyglot_hash_bound: false,
            error: "explicit hash-bound unsafe polyglot build authorization is required",
            language: str(language) };
    }
    let lang = str_lower(str_trim(str(language)));
    if lang == "rust" or lang == "rs" { return build_rust(block_name, code, out_dir); }
    if lang == "c" { return build_c(block_name, code, out_dir); }
    if lang == "cpp" or lang == "c++" or lang == "cxx" { return build_cpp(block_name, code, out_dir); }
    if lang == "go" { return build_go(block_name, code, out_dir); }
    if lang == "python" or lang == "py" { return build_python(block_name, code, out_dir); }
    if lang == "js" or lang == "javascript" { return build_js(block_name, code, out_dir); }
    if lang == "typescript" or lang == "ts" { return build_typescript(block_name, code, out_dir); }
    if lang == "java" { return build_java(block_name, code, out_dir); }
    if lang == "kotlin" or lang == "kt" { return build_kotlin(block_name, code, out_dir); }
    if lang == "swift" { return build_swift(block_name, code, out_dir); }
    if lang == "zig" { return build_zig(block_name, code, out_dir); }
    if lang == "nim" { return build_nim(block_name, code, out_dir); }
    if lang == "lua" { return build_lua(block_name, code, out_dir); }
    if lang == "ruby" or lang == "rb" { return build_ruby(block_name, code, out_dir); }
    if lang == "php" { return build_php(block_name, code, out_dir); }
    if lang == "r" { return build_r(block_name, code, out_dir); }
    if lang == "dart" { return build_dart(block_name, code, out_dir); }
    if lang == "bash" or lang == "sh" { return build_bash(block_name, code, out_dir); }
    if lang == "perl" or lang == "pl" { return build_perl(block_name, code, out_dir); }
    if lang == "haskell" or lang == "hs" { return build_haskell(block_name, code, out_dir); }
    if lang == "crystal" or lang == "cr" { return build_crystal(block_name, code, out_dir); }
    if lang == "d" { return build_d(block_name, code, out_dir); }
    if lang == "wasm" or lang == "wat" { return build_wasm(block_name, code, out_dir); }
    if lang == "qsharp" or lang == "qs" or lang == "q#" { return build_qsharp(block_name, code, out_dir); }
    if lang == "html" { return build_html(block_name, code, out_dir); }
    if lang == "css" { return build_css(block_name, code, out_dir); }
    if lang == "scss" or lang == "sass" { return build_sass(block_name, code, out_dir); }
    if lang == "less" { return build_less(block_name, code, out_dir); }
    if lang == "sql" or lang == "sqlite" { return build_sql(block_name, code, out_dir); }
    if lang == "matlab" or lang == "octave" or lang == "m" { return build_matlab(block_name, code, out_dir); }
    if lang == "prolog" or lang == "plg" { return build_prolog(block_name, code, out_dir); }
    if lang == "forth" or lang == "fth" { return build_forth(block_name, code, out_dir); }
    if lang == "solidity" or lang == "sol" { return build_solidity(block_name, code, out_dir); }
    if lang == "odin" { return build_odin(block_name, code, out_dir); }
    if lang == "carbon" { return build_carbon(block_name, code, out_dir); }
    if lang == "mojo" { return build_mojo(block_name, code, out_dir); }
    if lang == "chapel" or lang == "chpl" { return build_chapel(block_name, code, out_dir); }
    if lang == "factor" { return build_factor(block_name, code, out_dir); }
    if lang == "purescript" or lang == "purs" { return build_purescript(block_name, code, out_dir); }
    return map{ ok: false, build_ok: false, compiled: false, executed: false,
        error: "unsupported language: " + lang, language: lang };
}

fn build_file(filepath, options = nil) {
    if type(filepath) != "string" or len(filepath) < 1
       or len(str_to_bytes(filepath)) > MAX_PATH_BYTES
       or str_contains(filepath, strfromcharcode(0)) { return map{ error: "invalid source path" }; }
    let loaded = SECURE_FILE.read_text(filepath, MAX_SOURCE_BYTES);
    if not loaded.ok { return map{ error: "cannot securely read bounded source" }; }
    let source = loaded.text;

    let blocks = extract_blocks(source);
    let out_dir = path_dirname(filepath) + "/.pblang_polyglot";

    let results = [];
    let ready = 0; let fallbacks = 0; let failed = 0;
    for i len(blocks) {
        let block = blocks[i];
        let block_name = "block_" + str(i);

        let effective = if type(options) == "map" { options } else { map{} };
        effective.unsafe_polyglot_sha256 = SHA256.sha256_hex_bytes(str_to_bytes(block.code));
        let result = build_language(block.language, block_name, block.code, out_dir, effective);

        array_push(results, result);
        if try result.status catch "" == "fallback" { fallbacks = fallbacks + 1; }
        elif try result.ok catch false { ready = ready + 1; }
        else { failed = failed + 1; }
    }

    return map{
        ok: failed == 0,
        complete: failed == 0 and fallbacks == 0,
        ready: ready,
        fallbacks: fallbacks,
        failed: failed,
        file: filepath,
        blocks: len(blocks),
        artifacts: results,
        output_dir: out_dir,
    };
}

// Recursively list through held no-follow directory roots. A symbolic-link
// directory cannot be opened by list_directory and is treated as a non-directory;
// build_file then rejects a link masquerading as a source through secure read.
fn _collect_files(dir, out, depth) {
    if depth > MAX_PROJECT_DEPTH { throw "polyglot_build: project depth limit exceeded"; }
    let listed = SECURE_FILE.list_directory(dir, 4096);
    if not listed.ok { return false; }
    if listed.truncated { throw "polyglot_build: directory entry limit exceeded"; }
    let entries = listed.entries;
    let i = 0;
    while i < len(entries) {
        if len(out) >= MAX_PROJECT_FILES { throw "polyglot_build: project file limit exceeded"; }
        let full = path_join(dir, entries[i]);
        if not SECURE_FILE.list_directory(full, 4096).ok {
            array_push(out, full);
        } else {
            _collect_files(full, out, depth + 1);
        }
        i = i + 1;
    }
    return true;
}

fn fs_list_dir_recursive(dir) {
    let out = [];
    if not _collect_files(dir, out, 0) { return nil; }
    return out;
}

fn build_project(project_dir, options = nil) {
    let files = fs_list_dir_recursive(project_dir);
    if files == nil { return map{ error: "cannot read directory: " + project_dir }; }

    let results = []; let failed = 0;
    for i len(files) {
        let file = files[i];
        if str_ends_with(file, ".sapp") or str_ends_with(file, ".sap") {
            let r = build_file(file, options);
            array_push(results, r);
            if not (try r.ok catch false) { failed = failed + 1; }
        }
    }

    return map{
        ok: failed == 0,
        project: project_dir,
        files_processed: len(results),
        failed: failed,
        results: results,
    };
}

// ── Artifact Loading ──────────────────────────────────────────────────────────

fn _artifact_load_failure(message, artifact_path = "") {
    return map{ format: "pblang.polyglot-artifact-load.v2", ok: false,
        complete: false, executed: false, policy_required: true,
        raw_fallback: false, artifact: artifact_path, error: message };
}

// Loading a native library may execute constructors. It therefore requires an
// exact ffi_universal policy even before a symbol is called.
fn load_artifact_checked(policy, artifact_path) {
    if type(artifact_path) != "string" or len(artifact_path) < 1
       or len(str_to_bytes(artifact_path)) > MAX_PATH_BYTES
       or str_contains(artifact_path, strfromcharcode(0))
       or str_contains(artifact_path, "\n") or str_contains(artifact_path, "\r") {
        return _artifact_load_failure("invalid artifact path", str(artifact_path));
    }
    if str_ends_with(artifact_path, ".py") or str_ends_with(artifact_path, ".js") {
        return _artifact_load_failure(
            "executable script artifacts require the bounded polyglot execution API",
            artifact_path);
    }
    if not str_ends_with(artifact_path, ".so")
       and not str_ends_with(artifact_path, ".dylib")
       and not str_ends_with(artifact_path, ".dll") {
        return _artifact_load_failure("unsupported executable artifact type", artifact_path);
    }
    let loaded = FFI.load_checked(policy, artifact_path);
    if not (try loaded.ok catch false) {
        return map{ format: "pblang.polyglot-artifact-load.v2", ok: false,
            complete: false, executed: false, policy_required: true,
            raw_fallback: false, artifact: artifact_path,
            decision: try loaded.decision catch nil,
            error: try loaded.reason catch "artifact policy denied loading" };
    }
    return map{ format: "pblang.polyglot-artifact-load.v2", ok: true,
        complete: true, executed: true, policy_required: true,
        raw_fallback: false, artifact: artifact_path,
        library: loaded.library, decision: loaded.decision };
}

// Compatibility entrypoint: raw loading is intentionally disabled. Callers
// must migrate to load_artifact_checked with an exact library allowlist.
fn load_artifact(artifact_path) {
    return _artifact_load_failure("explicit FFI policy is required", str(artifact_path));
}

// ── Helpers ───────────────────────────────────────────────────────────────────

fn path_dirname(filepath) {
    let parts = str_split(filepath, "/");
    if len(parts) <= 1 {
        parts = str_split(filepath, "\\");
    }
    if len(parts) <= 1 { return "."; }
    return str_join(str_slice_arr(parts, 0, len(parts) - 1), "/");
}

fn str_slice_arr(arr, start_idx, end_idx) {
    let result = [];
    let i = start_idx;
    while i < end_idx {
        array_push(result, arr[i]);
        i = i + 1;
    }
    return result;
}

export extract_blocks;
export validate_build_request;
export process_status, tool_candidates, verify_artifact;
// Only the hash-bound generic dispatch is public. Language-specific and
// recursive helpers stay private so they cannot bypass unsafe authorization.
export build_language;
export sql_result_ok;
export load_artifact, load_artifact_checked;
