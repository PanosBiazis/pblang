// stdlib/polyglot_build.sapp — Enhanced Polyglot Build System for pblang
//
// Builds and compiles polyglot code blocks for 22+ languages.
// Extracts @lang { ... } blocks from .sapp files, compiles them
// into native artifacts (dll/so/dylib), and exposes them as modules.
//
// Supported languages: rust, c, cpp, go, python, javascript, typescript,
//   java, kotlin, swift, zig, nim, lua, ruby, php, r, dart, bash, perl,
//   haskell, crystal, d, wasm
//
// Usage:
//   let pb = import("stdlib:polyglot_build.sapp");
//   let artifacts = pb.build_file("my_project/main.sapp");

// ── Block Extraction ──────────────────────────────────────────────────────────

fn extract_blocks(source) {
    let lines = str_split(source, "\n");
    let blocks = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "@") {
            let brace_pos = str_index_of(line, "{");
            if brace_pos > 1 {
                let lang = str_trim(str_slice(line, 1, brace_pos));
                let code_lines = [];
                let depth = 1;
                i = i + 1;
                while i < len(lines) and depth > 0 {
                    let cl = lines[i];
                    let j = 0;
                    while j < len(cl) {
                        let ch = str_slice(cl, j, j + 1);
                        if ch == "{" { depth = depth + 1; }
                        if ch == "}" { depth = depth - 1; }
                        j = j + 1;
                    }
                    if depth > 0 {
                        array_push(code_lines, cl);
                    }
                    i = i + 1;
                }
                array_push(blocks, map{
                    language: lang,
                    code: str_join(code_lines, "\n"),
                    line: i,
                });
            }
        }
        i = i + 1;
    }
    return blocks;
}

// ── Compile Language: Rust ────────────────────────────────────────────────────

fn build_rust(block_name, code, out_dir) {
    let proj_dir = out_dir + "/rust_" + block_name;
    fs_mkdirs(proj_dir);
    fs_write(proj_dir + "/Cargo.toml",
        "[package]\nname = \"" + block_name + "\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\npath = \"lib.rs\"\n");
    fs_write(proj_dir + "/lib.rs", code);
    let result = try {
        let r = exec("cargo build --release --manifest-path " + proj_dir + "/Cargo.toml");
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "cargo build failed" };
    if result.exit_code != 0 {
        return map{ error: "rust build failed: " + result.stderr };
    }
    let ext = _shared_lib_ext();
    let lib_name = _lib_prefix() + block_name + ext;
    return map{
        ok: true,
        artifact: proj_dir + "/target/release/" + lib_name,
        language: "rust",
    };
}

// ── Compile Language: C ───────────────────────────────────────────────────────

fn build_c(block_name, code, out_dir) {
    let src_file = out_dir + "/" + block_name + ".c";
    fs_write(src_file, code);
    let ext = _shared_lib_ext();
    let out_file = out_dir + "/" + _lib_prefix() + block_name + ext;
    let result = try {
        let r = exec("cc -shared -fPIC -o " + out_file + " " + src_file);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "cc build failed" };
    if result.exit_code != 0 {
        return map{ error: "c build failed: " + result.stderr };
    }
    return map{ ok: true, artifact: out_file, language: "c" };
}

// ── Compile Language: C++ ─────────────────────────────────────────────────────

fn build_cpp(block_name, code, out_dir) {
    let src_file = out_dir + "/" + block_name + ".cpp";
    fs_write(src_file, code);
    let ext = _shared_lib_ext();
    let out_file = out_dir + "/" + _lib_prefix() + block_name + ext;
    let result = try {
        let r = exec("c++ -shared -fPIC -std=c++17 -o " + out_file + " " + src_file);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "c++ build failed" };
    if result.exit_code != 0 {
        return map{ error: "cpp build failed: " + result.stderr };
    }
    return map{ ok: true, artifact: out_file, language: "cpp" };
}

// ── Compile Language: Go ─────────────────────────────────────────────────────

fn build_go(block_name, code, out_dir) {
    let proj_dir = out_dir + "/go_" + block_name;
    fs_mkdirs(proj_dir);
    fs_write(proj_dir + "/main.go", code);
    fs_write(proj_dir + "/go.mod", "module " + block_name + "\n\ngo 1.21\n");
    let ext = _shared_lib_ext();
    let out_file = proj_dir + "/" + block_name + ext;
    let result = try {
        let r = exec("go build -buildmode=c-shared -o " + out_file + " " + proj_dir + "/main.go");
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "go build failed" };
    if result.exit_code != 0 {
        return map{ error: "go build failed: " + result.stderr };
    }
    return map{ ok: true, artifact: out_file, language: "go" };
}

// ── Compile Language: Python ─────────────────────────────────────────────────

fn build_python(block_name, code, out_dir) {
    let py_file = out_dir + "/" + block_name + ".py";
    fs_write(py_file, code);
    return map{ ok: true, artifact: py_file, language: "python" };
