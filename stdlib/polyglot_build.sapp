// ── Compile Language: SQL ────────────────────────────────────────────────────

fn build_sql(block_name, code, out_dir) {
    let sql_file = out_dir + "/" + block_name + ".sql";
    fs_write(sql_file, code);
    // Run against in-memory SQLite to validate syntax
    let result = try {
        let r = exec("sqlite3 :memory: \".read " + sql_file + "\"");
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "sqlite3 not found" };
    return map{ ok: true, artifact: sql_file, language: "sql" };
}

