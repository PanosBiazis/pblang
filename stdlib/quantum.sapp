// Minimal quantum stdlib (interop-first).
//
// Circuit representation:
//   c = map{ n_qubits: <num_qubits>, ops: [ ... ] }
// Each op is a map like:
//   map{ gate: "h", q: 0 }
//   map{ gate: "cx", c: 0, t: 1 }
//   map{ gate: "measure", q: 0, c: 0 }

fn circuit(n) {
    return map{ n_qubits: n, ops: [] };
}

fn _push_op(c, op) {
    // append to ops (array supports set at len() as push)
    c.ops[len(c.ops)] = op;
    return c;
}

fn _ensure_qubit(c, q) {
    if q < 0 or q >= c.n_qubits {
        error("quantum: qubit index out of range: " + str(q));
    }
}

fn h(c, q) {
    _ensure_qubit(c, q);
    return _push_op(c, map{ gate: "h", q: q });
}

fn cx(c, control, target) {
    _ensure_qubit(c, control);
    _ensure_qubit(c, target);
    return _push_op(c, map{ gate: "cx", c: control, t: target });
}

fn measure(c, q, classical) {
    _ensure_qubit(c, q);
    return _push_op(c, map{ gate: "measure", q: q, c: classical });
}

fn emit_qasm(c) {
    let s = "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n";
    s = s + "qreg q[" + str(c.n_qubits) + "];\n";
    s = s + "creg c[" + str(c.n_qubits) + "];\n";

    for i len(c.ops) {
        let op = c.ops[i];
        if op.gate == "h" {
            s = s + "h q[" + str(op.q) + "];\n";
        } else if op.gate == "x" {
            s = s + "x q[" + str(op.q) + "];\n";
        } else if op.gate == "y" {
            s = s + "y q[" + str(op.q) + "];\n";
        } else if op.gate == "z" {
            s = s + "z q[" + str(op.q) + "];\n";
        } else if op.gate == "cx" {
            s = s + "cx q[" + str(op.c) + "],q[" + str(op.t) + "];\n";
        } else if op.gate == "measure" {
            s = s + "measure q[" + str(op.q) + "] -> c[" + str(op.c) + "];\n";
        }
        // unknown op: keep going
    }

    return s;
}

// run(c) -> array of measurement outcomes
// Executes the circuit using the quantum simulator from stdlib/quantum_sim.sapp.
// Each "measure" op appends its outcome (0 or 1) to the returned array.
fn run(c) {
    let sim = import("stdlib:quantum_sim.sapp");
    let state = sim.zero_state(c.n_qubits);
    let measurements = [];
    let i = 0;
    while i < len(c.ops) {
        let op = c.ops[i];
        if op.gate == "h" {
            state = sim.h_gate(state, op.q);
        } else {
            if op.gate == "cx" {
                state = sim.cnot_gate(state, op.c, op.t);
            } else {
                if op.gate == "x" {
                    state = sim.x_gate(state, op.q);
                } else {
                    if op.gate == "y" {
                        state = sim.y_gate(state, op.q);
                    } else {
                        if op.gate == "z" {
                            state = sim.z_gate(state, op.q);
                        } else {
                            if op.gate == "measure" {
                                let m = sim.measure(state, op.q);
                                array_push(measurements, m);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return measurements;
}


// Aliases for backward-compat / test expectations
fn apply_h(c, q) { return h(c, q); }
fn apply_x(c, q) {
    _ensure_qubit(c, q);
    return _push_op(c, map{ gate: "x", q: q });
}
fn apply_y(c, q) {
    _ensure_qubit(c, q);
    return _push_op(c, map{ gate: "y", q: q });
}
fn apply_z(c, q) {
    _ensure_qubit(c, q);
    return _push_op(c, map{ gate: "z", q: q });
}
fn apply_cnot(c, ctrl, tgt) { return cx(c, ctrl, tgt); }
fn measure_qubit(c, q, classical) { return measure(c, q, classical); }
fn measure_all(c) {
    let i = 0;
    while i < c["n_qubits"] {
        c = measure(c, i, i);
        i = i + 1;
    }
    return c;
}

// to_qasm is an alias for emit_qasm
fn to_qasm(c) { return emit_qasm(c); }

// Convert measurements array to binary string ("010...")
fn measurements_to_string(meas) {
    let s = "";
    let i = 0;
    while i < len(meas) {
        s = s + str(meas[i]);
        i = i + 1;
    }
    return s;
}

// Convert measurements array to integer (big-endian binary)
fn measurements_to_int(meas) {
    let n = 0;
    let i = 0;
    while i < len(meas) {
        n = n * 2 + meas[i];
        i = i + 1;
    }
    return n;
}

// ── circuit construction & introspection helpers ────────────────────────────────

// bell(c, a, b) — entangle a and b into a Bell pair: H(a) then CX(a, b).
fn bell(c, a, b) {
    h(c, a);
    cx(c, a, b);
    return c;
}

// op_count(c) — number of operations queued on the circuit.
fn op_count(c) { return len(c.ops); }

// gate_counts(c) — map of gate name → how many times it appears.
fn gate_counts(c) {
    let m = map{};
    let i = 0;
    while i < len(c.ops) {
        let g = c.ops[i].gate;
        if map_has(m, g) { m[g] = m[g] + 1; } else { m[g] = 1; }
        i = i + 1;
    }
    return m;
}

// reset(c) — clear all operations (keeps the qubit count).
fn reset(c) { c.ops = []; return c; }

export circuit, h, cx, measure, emit_qasm, run,
       apply_h, apply_x, apply_y, apply_z, apply_cnot, measure_qubit, measure_all,
       to_qasm, measurements_to_string, measurements_to_int,
       bell, op_count, gate_counts, reset;
