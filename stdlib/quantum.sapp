// Minimal quantum stdlib (interop-first).
//
// Circuit representation:
//   c = map{ n: <num_qubits>, ops: [ ... ] }
// Each op is a map like:
//   map{ gate: "h", q: 0 }
//   map{ gate: "cx", c: 0, t: 1 }
//   map{ gate: "measure", q: 0, c: 0 }

fn circuit(n) {
    return map{ n: n, ops: [] };
}

fn _push_op(c, op) {
    // append to ops (array supports set at len() as push)
    c.ops[len(c.ops)] = op;
    return c;
}

fn h(c, q) {
    return _push_op(c, map{ gate: "h", q: q });
}

fn cx(c, control, target) {
    return _push_op(c, map{ gate: "cx", c: control, t: target });
}

fn measure(c, q, classical) {
    return _push_op(c, map{ gate: "measure", q: q, c: classical });
}

fn emit_qasm(c) {
    let s = "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n";
    s = s + "qreg q[" + str(c.n) + "];\n";
    s = s + "creg c[" + str(c.n) + "];\n";

    for i len(c.ops) {
        let op = c.ops[i];
        if op.gate == "h" {
            s = s + "h q[" + str(op.q) + "];\n";
        } else {
            if op.gate == "cx" {
                s = s + "cx q[" + str(op.c) + "],q[" + str(op.t) + "];\n";
            } else {
                if op.gate == "measure" {
                    s = s + "measure q[" + str(op.q) + "] -> c[" + str(op.c) + "];\n";
                } else {
                    // unknown op: keep going
                }
            }
        }
    }

    return s;
}

export circuit, h, cx, measure, emit_qasm;

