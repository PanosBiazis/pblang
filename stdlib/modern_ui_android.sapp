    }
    let min_sdk = num_floor(try options.min_sdk catch 21);
    let target_sdk = num_floor(try options.target_sdk catch 34);
    let platform_theme = if _dark_theme(options) {
        "@android:style/Theme.Material.NoActionBar"
    } else {
        "@android:style/Theme.Material.Light.NoActionBar"
    };
    if min_sdk < 21 or min_sdk > target_sdk or target_sdk < 34 or target_sdk > 999 {
        throw "modern_ui_android: invalid Android SDK range";
    }
    // pblang-security-ignore-next-line: network.plaintext-http reason=Android XML namespace identifier, not a network endpoint
    let android_xmlns = "http://schemas.android.com/apk/res/android";
    let release = _version_plan(options);
    return "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
        + "<manifest xmlns:android=\"" + android_xmlns + "\" package=\""
        + package_name + "\" android:versionCode=\""
        + str(num_floor(try options.version_code catch 1)) + "\" android:versionName=\""
        + _xml(release.application_version) + "\">\n"
        + "  <uses-sdk android:minSdkVersion=\"" + str(min_sdk)
        + "\" android:targetSdkVersion=\"" + str(target_sdk) + "\"/>\n"
        + "  <application android:allowBackup=\"false\" android:debuggable=\"true\" "
        + "android:hardwareAccelerated=\"true\" android:largeHeap=\"false\" android:label=\""
        + _xml(name) + "\" android:usesCleartextTraffic=\"false\" "
        + "android:theme=\"" + platform_theme + "\">\n"
        + "    <activity android:name=\".MainActivity\" android:exported=\"true\" "
        + "android:screenOrientation=\"unspecified\" android:windowSoftInputMode=\"adjustResize\">\n"
        + "      <intent-filter><action android:name=\"android.intent.action.MAIN\"/>"
        + "<category android:name=\"android.intent.category.LAUNCHER\"/></intent-filter>\n"
        + "    </activity>\n"
        + "  </application>\n"
        + "</manifest>\n";
}

fn generate(name, bundle, options = nil) {
    bundle = Validation.renderer_bundle(bundle, "android");
    if options == nil { options = map{}; }
    let package_name = str(try options.package catch "org.pblang.modernapp");
    let bytes = activity_class(bundle, options);
    let action_count=0;
    for record in bundle.records {
        if (record.kind=="button" or record.kind=="toggle")
           and (try record.source.action catch nil)!=nil {
            action_count=action_count+1;
        }
    }
    let breakpoint = _integer(
        try options.compact_breakpoint_dp catch DEFAULT_COMPACT_BREAKPOINT_DP,
        DEFAULT_COMPACT_BREAKPOINT_DP);
    breakpoint = _clamp(breakpoint, 320, 1200);
    let release = _version_plan(options);
    return map{ format: "pblang.modern-ui.android.v1", name: name,
        package: package_name, activity: package_name + ".MainActivity",
        class_name: _class_name(package_name), class_bytes: bytes,
        manifest: manifest(name, options), widgets: len(bundle.records),actions:action_count,
        version:release.base_version, display_version:release.application_version,
        release_channel:release.release_channel,
        version_code:num_floor(try options.version_code catch 1),
        min_sdk: num_floor(try options.min_sdk catch 21),
        target_sdk: num_floor(try options.target_sdk catch 34),
        responsive: map{
            format: "pblang.modern-ui.android-responsive.v1",
            runtime_screen_width_dp: true,
            compact_breakpoint_dp: breakpoint,
            orientation_recreates_layout: true,
            scroll_fallback: true,
            minimum_touch_target_dp: MIN_TOUCH_TARGET_DP,
            keyboard_adjust_resize: true
        } };
}

fn build(name, bundle, options = nil) {
    if options == nil { options = map{}; }
    let generated = generate(name, bundle, options);
    return Toolchain.build(generated, options);
}

export MAX_ANDROID_WIDGETS, MAX_ANDROID_BUTTONS, DEFAULT_COMPACT_BREAKPOINT_DP,
       MIN_TOUCH_TARGET_DP, activity_class, manifest, generate, build;
