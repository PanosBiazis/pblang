fn _xml(value) {
    let out = ""; let i = 0;
    while i < len(value) {
        let c = str_slice(value, i, i + 1);
        if c == "&" { out = out + "&amp;"; }
        elif c == "<" { out = out + "&lt;"; }
        elif c == ">" { out = out + "&gt;"; }
        elif c == "\"" { out = out + "&quot;"; }
        elif c == "'" { out = out + "&apos;"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

