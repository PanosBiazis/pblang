// Android renderer for stdlib/modern_ui.sapp, authored entirely in PBLang.
//
// The renderer emits JVM class bytes directly. Android SDK tools are used only
// to convert/package/sign the platform artifact; no Java or Kotlin source is
// generated.

let JVM = import("stdlib:jvm_classfile.sapp");
let Toolchain = import("stdlib:android_toolchain.sapp");
let Validation = import("stdlib:modern_ui_validation.sapp");
let GUI = import("stdlib:gui.sapp");
let Style = import("stdlib:ui_style.sapp");
let Images = import("stdlib:modern_ui_android_image.sapp");

let MAX_ANDROID_WIDGETS = 96;
let MAX_ANDROID_BUTTONS = 32;
let MAX_ANDROID_TEXT = 4096;
let DEFAULT_COMPACT_BREAKPOINT_DP = 600;
let MIN_TOUCH_TARGET_DP = 48;

fn _append(dst, src) {
    let i = 0;
    while i < len(src) { array_push(dst, src[i]); i = i + 1; }
}

fn _ref(code, opcode, index) { JVM.emit(code, JVM.insn_u2(opcode, index)); }

fn _ldc(code, index) {
    if index < 1 or index > 65535 {
        throw "modern_ui_android: invalid constant-pool index";
    }
    if index <= 255 { JVM.emit(code, [18, index]); }
    else { JVM.emit(code, JVM.insn_u2(19, index)); }
}

fn _push_int(code, builder, value) {
    if type(value) != "number" or num_floor(value) != value
        or value < -2147483648 or value > 2147483647 {
        throw "modern_ui_android: expected a signed 32-bit integer constant";
    }
    if value == -1 { JVM.emit(code, 2); return; }
    if value >= 0 and value <= 5 { JVM.emit(code, 3 + value); return; }
    if value >= -128 and value <= 127 {
        JVM.emit(code, [16, if value < 0 { 256 + value } else { value }]);
        return;
    }
    if value >= -32768 and value <= 32767 {
        let encoded = if value < 0 { 65536 + value } else { value };
        JVM.emit(code, [17, num_floor(encoded / 256), num_mod(encoded, 256)]);
        return;
    }
    let index = JVM.integer_ref(builder, value);
    _ldc(code, index);
}

fn _integer(value, fallback) {
    if type(value) != "number" { return fallback; }
    return num_floor(value);
}

fn _clamp(value, minimum, maximum) {
    if value < minimum { return minimum; }
    if value > maximum { return maximum; }
    return value;
}

fn _dark_theme(options) {
    return str_lower(str(try options.theme catch "dark")) != "light";
}

fn _ascii_identifier(value, dots) {
    if type(value) != "string" or len(value) < 1 or len(value) > 180 {
        return false;
    }
    let segment_start = true; let segments = 1; let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if dots and c == 46 {
            if segment_start { return false; }
            segment_start = true; segments = segments + 1;
        } else {
            if not (((c >= 97 and c <= 122) or (c >= 65 and c <= 90))
                or (not segment_start and c >= 48 and c <= 57)
                or (not segment_start and c == 95)) { return false; }
            segment_start = false;
        }
        i = i + 1;
    }
    return not segment_start and (not dots or segments >= 2);
}

fn _class_name(package_name) {
    let parts = str_split(package_name, ".");
    return str_join(parts, "/") + "/MainActivity";
}

fn _text(value) {
    let out = str(value);
    if len(out) > MAX_ANDROID_TEXT {
        throw "modern_ui_android: widget text exceeds Android adapter limit";
    }
    return out;
}

fn _resolved_name(node, path) {
    let explicit = str(try node.name catch "");
    if explicit != "" { return explicit; }
    return node.kind + "_" + path;
}

fn _container(kind) {
    return kind == "screen" or kind == "column" or kind == "row"
        or kind == "grid" or kind == "card";
}

fn _text_control(kind) {
    return kind == "heading" or kind == "text" or kind == "button"
        or kind == "input" or kind == "area" or kind == "toggle";
}

fn _descriptor(kind) {
    if kind == "button" { return "Landroid/widget/Button;"; }
    if kind == "input" or kind == "area" { return "Landroid/widget/EditText;"; }
    if kind == "toggle" { return "Landroid/widget/CheckBox;"; }
    return "Landroid/widget/TextView;";
}

fn _validate_action(action, fields) {
    if action.kind == "set_text" {
        if not map_has(fields, action.target) {
            throw "modern_ui_android: action target is not text-capable: " + action.target;
        }
    } elif action.kind == "sequence" {
        for item in action.actions { _validate_action(item, fields); }
    }
}

fn _preflight(bundle, class_name, options) {
    let images=map{};let remaining=Images.MAX_TOTAL_PIXELS;
    let embed=Images.enabled(options);
    if type(bundle) != "map"
        or (try bundle.format catch "") != "pblang.modern-ui.bundle.v1"
        or (try bundle.target catch "") != "android" {
        throw "modern_ui_android: expected an Android modern UI bundle";
    }
    if len(bundle.records) > MAX_ANDROID_WIDGETS {
        throw "modern_ui_android: Android widget limit exceeded";
    }
    let fields = map{}; let field_list = []; let buttons = []; let button_count = 0;
    for record in bundle.records {
        let source = record.source;
        if embed and record.kind=="image" and (try source.image catch nil)!=nil {
            let image=Images.prepare(source.image,remaining);
            remaining=remaining-image.pixels;images[record.name]=image;
        }
        if (try source.onclick catch nil) != nil {
            throw "modern_ui_android: native onclick callback on " + record.name
                + " is not portable; use action_set_text/action_message";
        }
        if (try source.onchange catch nil) != nil {
            throw "modern_ui_android: native onchange callback on " + record.name
                + " is not portable in this Android adapter";
        }
        if _text_control(record.kind) {
            let info = map{ name: record.name, field: "view" + str(len(field_list)),
                descriptor: _descriptor(record.kind), kind: record.kind };
            fields[record.name] = info;
            array_push(field_list, info);
        }
        if (record.kind == "button" or record.kind == "toggle")
           and (try source.action catch nil) != nil {
            button_count = button_count + 1;
            if button_count > MAX_ANDROID_BUTTONS {
                throw "modern_ui_android: interactive button limit exceeded";
            }
            array_push(buttons, map{ name: record.name, action: source.action });
        }
    }
    for button in buttons { _validate_action(button.action, fields); }
    return map{ class_name: class_name, fields: fields,
        field_list: field_list, buttons: buttons, images:images };
}

fn _refs(c, class_name) {
    return map{
        activity_init: JVM.method_ref(c, "android/app/Activity", "<init>", "()V"),
        activity_create: JVM.method_ref(c, "android/app/Activity", "onCreate",
            "(Landroid/os/Bundle;)V"),
        set_content: JVM.method_ref(c, "android/app/Activity", "setContentView",
            "(Landroid/view/View;)V"),
        resources: JVM.method_ref(c, "android/content/Context", "getResources",
            "()Landroid/content/res/Resources;"),
        configuration: JVM.method_ref(c, "android/content/res/Resources", "getConfiguration",
            "()Landroid/content/res/Configuration;"),
        screen_width_dp: JVM.field_ref(c, "android/content/res/Configuration",
            "screenWidthDp", "I"),
        metrics: JVM.method_ref(c, "android/content/res/Resources", "getDisplayMetrics",
            "()Landroid/util/DisplayMetrics;"),
        density: JVM.field_ref(c, "android/util/DisplayMetrics", "densityDpi", "I"),
        scroll_class: JVM.class_ref(c, "android/widget/ScrollView"),
        scroll_init: JVM.method_ref(c, "android/widget/ScrollView", "<init>",
            "(Landroid/content/Context;)V"),
        linear_class: JVM.class_ref(c, "android/widget/LinearLayout"),
        linear_init: JVM.method_ref(c, "android/widget/LinearLayout", "<init>",
            "(Landroid/content/Context;)V"),
        linear_orientation: JVM.method_ref(c, "android/widget/LinearLayout",
            "setOrientation", "(I)V"),
        grid_class: JVM.class_ref(c, "android/widget/GridLayout"),
        grid_init: JVM.method_ref(c, "android/widget/GridLayout", "<init>",
            "(Landroid/content/Context;)V"),
        grid_columns: JVM.method_ref(c, "android/widget/GridLayout", "setColumnCount", "(I)V"),
        layout_params_class: JVM.class_ref(c, "android/view/ViewGroup$LayoutParams"),
        layout_params_init: JVM.method_ref(c, "android/view/ViewGroup$LayoutParams", "<init>",
            "(II)V"),
        text_class: JVM.class_ref(c, "android/widget/TextView"),
        text_init: JVM.method_ref(c, "android/widget/TextView", "<init>",
            "(Landroid/content/Context;)V"),
        button_class: JVM.class_ref(c, "android/widget/Button"),
        button_init: JVM.method_ref(c, "android/widget/Button", "<init>",
            "(Landroid/content/Context;)V"),
        edit_class: JVM.class_ref(c, "android/widget/EditText"),
        edit_init: JVM.method_ref(c, "android/widget/EditText", "<init>",
            "(Landroid/content/Context;)V"),
        check_class: JVM.class_ref(c, "android/widget/CheckBox"),
        check_init: JVM.method_ref(c, "android/widget/CheckBox", "<init>",
            "(Landroid/content/Context;)V"),
        spinner_class: JVM.class_ref(c, "android/widget/Spinner"),
        spinner_init: JVM.method_ref(c, "android/widget/Spinner", "<init>",
            "(Landroid/content/Context;)V"),
        string_class: JVM.class_ref(c, "java/lang/String"),
        adapter_class: JVM.class_ref(c, "android/widget/ArrayAdapter"),
        adapter_init: JVM.method_ref(c, "android/widget/ArrayAdapter", "<init>",
            "(Landroid/content/Context;I[Ljava/lang/Object;)V"),
        adapter_dropdown: JVM.method_ref(c, "android/widget/ArrayAdapter",
            "setDropDownViewResource", "(I)V"),
        spinner_adapter: JVM.method_ref(c, "android/widget/Spinner", "setAdapter",
            "(Landroid/widget/SpinnerAdapter;)V"),
        spinner_selection: JVM.method_ref(c, "android/widget/AdapterView",
            "setSelection", "(I)V"),
        seek_class: JVM.class_ref(c, "android/widget/SeekBar"),
        seek_init: JVM.method_ref(c, "android/widget/SeekBar", "<init>",
            "(Landroid/content/Context;)V"),
        progress_class: JVM.class_ref(c, "android/widget/ProgressBar"),
        progress_init: JVM.method_ref(c, "android/widget/ProgressBar", "<init>",
            "(Landroid/content/Context;Landroid/util/AttributeSet;I)V"),
        image_class: JVM.class_ref(c, "android/widget/ImageView"),
        image_init: JVM.method_ref(c, "android/widget/ImageView", "<init>",
            "(Landroid/content/Context;)V"),
        view_class: JVM.class_ref(c, "android/view/View"),
        view_init: JVM.method_ref(c, "android/view/View", "<init>",
            "(Landroid/content/Context;)V"),
        space_class: JVM.class_ref(c, "android/widget/Space"),
        space_init: JVM.method_ref(c, "android/widget/Space", "<init>",
            "(Landroid/content/Context;)V"),
        add_view: JVM.method_ref(c, "android/view/ViewGroup", "addView",
            "(Landroid/view/View;)V"),
        set_text: JVM.method_ref(c, "android/widget/TextView", "setText",
            "(Ljava/lang/CharSequence;)V"),
        set_hint: JVM.method_ref(c, "android/widget/TextView", "setHint",
            "(Ljava/lang/CharSequence;)V"),
        set_text_color: JVM.method_ref(c, "android/widget/TextView", "setTextColor", "(I)V"),
        set_background: JVM.method_ref(c, "android/view/View", "setBackgroundColor", "(I)V"),
        color_state_value: JVM.method_ref(c, "android/content/res/ColorStateList", "valueOf",
            "(I)Landroid/content/res/ColorStateList;"),
        set_background_tint: JVM.method_ref(c, "android/view/View", "setBackgroundTintList",
            "(Landroid/content/res/ColorStateList;)V"),
        set_layout_params: JVM.method_ref(c, "android/view/View", "setLayoutParams",
            "(Landroid/view/ViewGroup$LayoutParams;)V"),
        set_padding: JVM.method_ref(c, "android/view/View", "setPadding", "(IIII)V"),
        set_min_height: JVM.method_ref(c, "android/view/View", "setMinimumHeight", "(I)V"),
        set_content_description: JVM.method_ref(c, "android/view/View",
            "setContentDescription", "(Ljava/lang/CharSequence;)V"),
        set_enabled: JVM.method_ref(c, "android/view/View", "setEnabled", "(Z)V"),
        set_single_line: JVM.method_ref(c, "android/widget/TextView", "setSingleLine", "(Z)V"),
        set_min_lines: JVM.method_ref(c, "android/widget/TextView", "setMinLines", "(I)V"),
        set_checked: JVM.method_ref(c, "android/widget/CompoundButton", "setChecked", "(Z)V"),
        set_max: JVM.method_ref(c, "android/widget/ProgressBar", "setMax", "(I)V"),
        set_progress: JVM.method_ref(c, "android/widget/ProgressBar", "setProgress", "(I)V"),
        set_listener: JVM.method_ref(c, "android/view/View", "setOnClickListener",
            "(Landroid/view/View$OnClickListener;)V"),
        toast_make: JVM.method_ref(c, "android/widget/Toast", "makeText",
            "(Landroid/content/Context;Ljava/lang/CharSequence;I)Landroid/widget/Toast;"),
        toast_show: JVM.method_ref(c, "android/widget/Toast", "show", "()V"),
        dp: JVM.method_ref(c, class_name, "dp", "(I)I")
    };
}

fn _new_context_view(code, state, class_ref, init_ref, slot) {
    _ref(code, 187, class_ref); JVM.emit(code, 89); JVM.emit_aload(code, 0);
    _ref(code, 183, init_ref); JVM.emit_astore(code, slot);
}

fn _dp(code, state, value) {
    JVM.emit_aload(code, 0); _push_int(code, state.class, value);
    _ref(code, 182, state.refs.dp);
}

fn _padding(code, state, slot, value) {
    JVM.emit_aload(code, slot);
    _dp(code, state, value); _dp(code, state, value);
    _dp(code, state, value); _dp(code, state, value);
    _ref(code, 182, state.refs.set_padding);
}

fn _minimum_height(code, state, slot, value) {
    if value < 1 { return; }
    if value > 8192 { value = 8192; }
    JVM.emit_aload(code, slot); _dp(code, state, value);
    _ref(code, 182, state.refs.set_min_height);
}

fn _responsive_int(code, state, compact_value, wide_value) {
    let index = state.responsive_branch;
    state.responsive_branch = index + 1;
    let wide = "responsive_wide_" + str(index);
    let done = "responsive_done_" + str(index);
    JVM.emit_aload(code, 0);
    _ref(code, 182, state.refs.resources);
    _ref(code, 182, state.refs.configuration);
    _ref(code, 180, state.refs.screen_width_dp);
    _push_int(code, state.class, state.compact_breakpoint_dp);
    JVM.branch(code, 162, wide);
    _push_int(code, state.class, compact_value);
    JVM.branch(code, 167, done);
    JVM.mark(code, wide);
    _push_int(code, state.class, wide_value);
    JVM.mark(code, done);
}

fn _attach(code, state, parent_slot, child_slot) {
    JVM.emit_aload(code, parent_slot); JVM.emit_aload(code, child_slot);
    _ref(code, 182, state.refs.add_view);
}

// Margins reuse the child's real parent-specific LayoutParams after attachment.
// No synthetic Views or fields are inserted, so action targets keep their identity.
fn _gap_margins(node,index,compact) {
    let gap=_integer(try node.gap catch 0,0);
    let left=0;let top=0;
    if node.kind=="grid" {
        let columns=_clamp(_integer(try node.columns catch 2,2),1,6);
        if compact {columns=1;}
        if num_mod(index,columns)>0 {left=gap;}
        if index>=columns {top=gap;}
    } elif index>0 {
        if node.kind=="row" and ((try node.responsive catch true)==false or not compact) {left=gap;}
        else {top=gap;}
    }
    return map{left:left,top:top};
}
fn _gap_dp(code,state,compact,wide) {
    if compact==wide {_dp(code,state,compact);return;}
    JVM.emit_aload(code,0);_responsive_int(code,state,compact,wide);
    _ref(code,182,state.refs.dp);
}
fn _child_gap(code,state,node,slot,index) {
    if _integer(try node.gap catch 0,0)<=0 or index==0 {return;}
    let compact=_gap_margins(node,index,true);let wide=_gap_margins(node,index,false);
    let c=state.class;let params=slot+1;
    JVM.emit_aload(code,slot);
    _ref(code,182,JVM.method_ref(c,"android/view/View","getLayoutParams","()Landroid/view/ViewGroup$LayoutParams;"));
    _ref(code,192,JVM.class_ref(c,"android/view/ViewGroup$MarginLayoutParams"));
    JVM.emit_astore(code,params);JVM.emit_aload(code,params);
    // Convert the runtime-selected logical gap to density pixels using the same dp helper.
    _gap_dp(code,state,compact.left,wide.left);
    _gap_dp(code,state,compact.top,wide.top);
    _push_int(code,c,0);_push_int(code,c,0);
    _ref(code,182,JVM.method_ref(c,"android/view/ViewGroup$MarginLayoutParams","setMargins","(IIII)V"));
    JVM.emit_aload(code,slot);JVM.emit_aload(code,params);
    _ref(code,182,state.refs.set_layout_params);
}

fn _fill_width(code, state, slot, node) {
    if not (try node.fill_width catch false) { return; }
    let params_slot = slot + 1;
    _ref(code, 187, state.refs.layout_params_class); JVM.emit(code, 89);
    _push_int(code, state.class, -1); _push_int(code, state.class, -2);
    _ref(code, 183, state.refs.layout_params_init); JVM.emit_astore(code, params_slot);
    JVM.emit_aload(code, slot); JVM.emit_aload(code, params_slot);
    _ref(code, 182, state.refs.set_layout_params);
}

fn _tone_color(state, tone, fallback) {
    if state.shared_palette != nil {
        let color=Style.tone(state.shared_palette,tone,nil);
        if color != nil { return _palette_argb(color); }
        return fallback;
    }
    let value = str_lower(str(tone));
    if value == "accent" or value == "primary" or value == "success" {
        return state.accent;
    }
    if value == "danger" { return state.danger; }
    if value == "warning" { return state.warning; }
    if value == "muted" { return state.muted; }
    return fallback;
}

fn _button_style(code, state, slot, node) {
    if state.shared_palette != nil {
        let style=Style.button(state.shared_palette,try node.variant catch "primary",
            try node.selected catch false,try node.enabled catch true);
        JVM.emit_aload(code,slot); _push_int(code,state.class,_palette_argb(style.fill));
        _ref(code,184,state.refs.color_state_value);
        _ref(code,182,state.refs.set_background_tint);
        return _palette_argb(style.text);
    }
    let variant = str_lower(str(try node.variant catch ""));
    if variant == "" { return state.foreground; }
    let tint = state.secondary;
    if variant == "primary" { tint = state.primary; }
    elif variant == "danger" { tint = state.danger; }
    elif variant == "warning" { tint = state.warning; }
    JVM.emit_aload(code, slot); _push_int(code, state.class, tint);
    _ref(code, 184, state.refs.color_state_value);
    _ref(code, 182, state.refs.set_background_tint);
    return state.on_action;
}

fn _put_field(code, state, node, path, slot) {
    let name = _resolved_name(node, path);
    if not map_has(state.model.fields, name) { return; }
    let info = state.model.fields[name];
    let field = JVM.field_ref(state.class, state.class_name, info.field, info.descriptor);
    JVM.emit_aload(code, 0); JVM.emit_aload(code, slot); _ref(code, 181, field);
}

fn _label(code, state, slot, value, color) {
    JVM.emit_aload(code, slot); _ldc(code, JVM.string_ref(state.class, _text(value)));
    _ref(code, 182, state.refs.set_text);
    JVM.emit_aload(code, slot); _push_int(code, state.class, color);
    _ref(code, 182, state.refs.set_text_color);
}

fn _accessibility(code, state, slot, node, fallback) {
    let label = str(try node.accessibility_label catch fallback);
    if label == "" { return; }
    JVM.emit_aload(code, slot); _ldc(code, JVM.string_ref(state.class, _text(label)));
    _ref(code, 182, state.refs.set_content_description);
}

