// Detached source-order selection; optional header is retained exactly once.
let Sheet=import("stdlib:sheet_document.sapp");
fn select(doc,indices,header=false) {
 let size=Sheet.validate(doc);
 if type(header)!="bool" or type(indices)!="array" or len(indices)<1 or len(indices)>size.rows {throw "invalid row selection";}
 let last=if header {0} else {-1};
 for index in indices {
  if type(index)!="number" or not(index>last and index<size.rows) or index!=num_floor(index) {throw "row indices must be increasing unique data rows";}
  last=index;
 }
 let cells=[];
 if header {let row=[];for value in doc.cells[0] {array_push(row,value);}array_push(cells,row);}
 for index in indices {let row=[];for value in doc.cells[index] {array_push(row,value);}array_push(cells,row);}
 return map{format:Sheet.FORMAT,cells:cells};
}
export select;
