// stdlib/ml.sapp — Machine Learning utilities for pblang.
//
// Provides: train/test split, metrics, cross-validation, feature scaling,
// confusion matrix analysis, model evaluation, and data preprocessing.
//
// Usage:
//   let ml = import("stdlib:ml.sapp");
//   let split = ml.train_test_split(data, 0.2);
//   let acc = ml.accuracy(y_true, y_pred);
//   let cm = ml.confusion_matrix(y_true, y_pred);


// ─── Data Splitting ────────────────────────────────────────────────────────

// train_test_split(data, test_ratio) — split array into train/test sets.
fn train_test_split(data, test_ratio = 0.2) {
    let n = len(data);
    if n == 0 { return map{ train: [], test: [] }; }
    let n_test = 1;
    let tmp = test_ratio * n;
    if tmp < 1 { n_test = 1; } else { n_test = tmp; }
    let shuffled = shuffle_data(data);
    let train = []; let test = [];
    for i len(shuffled) {
        if i < n_test { test[len(test)] = shuffled[i]; }
        else { train[len(train)] = shuffled[i]; }
    }
    return map{ train: train, test: test };
}

// shuffle_data(arr) — Fisher-Yates shuffle.
fn shuffle_data(arr) {
    let result = copy_array(arr);
    let n = len(result);
    let i = n;
    while i > 1 {
        // Simple PRNG shuffle using modulo
        let j = (i * 7) % i;
        let tmp = result[i - 1];
        result[i - 1] = result[j];
        result[j] = tmp;
        i = i - 1;
    }
    return result;
}

fn copy_array(arr) {
    let out = [];
    for i len(arr) { out[i] = arr[i]; }
    return out;
}

// ─── Classification Metrics ────────────────────────────────────────────────

// accuracy(y_true, y_pred) — fraction of correct predictions.
fn accuracy(y_true, y_pred) {
    if len(y_true) == 0 { return 1.0; }
    let correct = 0;
    for i len(y_true) {
        if y_true[i] == y_pred[i] { correct = correct + 1; }
    }
    return correct / len(y_true);
}

// precision(y_true, y_pred, positive_label) — TP / (TP + FP).
fn precision(y_true, y_pred, positive_label = 1) {
    let tp = 0; let fp = 0;
    for i len(y_true) {
        if y_pred[i] == positive_label {
            if y_true[i] == positive_label { tp = tp + 1; }
            else { fp = fp + 1; }
        }
    }
    let denom = tp + fp;
    if denom == 0 { return 0.0; }
    return tp / denom;
}

// recall(y_true, y_pred, positive_label) — TP / (TP + FN).
fn recall(y_true, y_pred, positive_label = 1) {
    let tp = 0; let fneg = 0;   // `fn` is a keyword — don't shadow it
    for i len(y_true) {
        if y_true[i] == positive_label {
            if y_pred[i] == positive_label { tp = tp + 1; }
            else { fneg = fneg + 1; }
        }
    }
    let denom = tp + fneg;
    if denom == 0 { return 0.0; }
    return tp / denom;
}

// f1_score(y_true, y_pred, positive_label) — harmonic mean of precision and recall.
fn f1_score(y_true, y_pred, positive_label) {
    let p = precision(y_true, y_pred, positive_label);
    let r = recall(y_true, y_pred, positive_label);
    if p + r == 0 { return 0.0; }
    return 2 * p * r / (p + r);
}

// ─── Confusion Matrix ──────────────────────────────────────────────────────

fn contains(arr, val) {
    for i len(arr) { if arr[i] == val { return true; } }
    return false;
}

// confusion_matrix(y_true, y_pred) — returns map of maps: cm[actual_label][pred_label] = count.
fn confusion_matrix(y_true, y_pred) {
    // Gather all unique labels
    let labels = [];
    for i len(y_true) {
        if not contains(labels, y_true[i]) { labels[len(labels)] = y_true[i]; }
        if not contains(labels, y_pred[i]) { labels[len(labels)] = y_pred[i]; }
    }
    // Initialize matrix
    let cm = map{};
    for i len(labels) {
        let row = map{};
        for j len(labels) { row[labels[j]] = 0; }
        cm[labels[i]] = row;
    }
    // Fill counts
    for k len(y_true) {
        let actual_lbl = y_true[k];
        let pred_label = y_pred[k];
        cm[actual_lbl][pred_label] = cm[actual_lbl][pred_label] + 1;
    }
    return map{ matrix: cm, labels: labels };
}

// confusion_matrix_report(y_true, y_pred) — full report with per-class metrics.
fn confusion_matrix_report(y_true, y_pred) {
    let cm_data = confusion_matrix(y_true, y_pred);
    let labels = cm_data.labels;
    let cm = cm_data.matrix;
    let report = map{};
    for i len(labels) {
        let lbl = labels[i];
        let tp = try cm[lbl][lbl] catch 0;
        let total_true = 0;
        let total_pred = 0;
        for j len(labels) {
            total_true = total_true + try cm[lbl][labels[j]] catch 0;
            total_pred = total_pred + try cm[labels[j]][lbl] catch 0;
        }
        let prec_val = 0.0;
        if total_pred > 0 { prec_val = tp / total_pred; }
        let rec_val = 0.0;
        if total_true > 0 { rec_val = tp / total_true; }
        let f1_val = 0.0;
        if prec_val + rec_val > 0 { f1_val = 2 * prec_val * rec_val / (prec_val + rec_val); }
        report[lbl] = map{
            precision: prec_val,
            recall: rec_val,
            f1: f1_val,
            support: total_true,
        };
    }
    return report;
}

// ─── Regression Metrics ────────────────────────────────────────────────────

// mse(y_true, y_pred) — mean squared error.
fn mse(y_true, y_pred) {
    if len(y_true) == 0 { return 0.0; }
    let sum = 0.0;
    for i len(y_true) {
        let d = y_true[i] - y_pred[i];
        sum = sum + d * d;
    }
    return sum / len(y_true);
}

// mae(y_true, y_pred) — mean absolute error.
fn mae(y_true, y_pred) {
    if len(y_true) == 0 { return 0.0; }
    let sum = 0.0;
    for i len(y_true) {
        let d = y_true[i] - y_pred[i];
        if d < 0 { d = 0 - d; }
        sum = sum + d;
    }
    return sum / len(y_true);
}

// rmse(y_true, y_pred) — root mean squared error.
fn rmse(y_true, y_pred) {
    return num_sqrt(mse(y_true, y_pred));
}

// r2_score(y_true, y_pred) — coefficient of determination.
fn r2_score(y_true, y_pred) {
    if len(y_true) == 0 { return 0.0; }
    let mean_y = 0.0;
    for i len(y_true) { mean_y = mean_y + y_true[i]; }
    mean_y = mean_y / len(y_true);
    let ss_res = 0.0; let ss_tot = 0.0;
    for i len(y_true) {
        let d1 = y_true[i] - y_pred[i];
        ss_res = ss_res + d1 * d1;
        let d2 = y_true[i] - mean_y;
        ss_tot = ss_tot + d2 * d2;
    }
    if ss_tot == 0 { return 0.0; }
    return 1.0 - ss_res / ss_tot;
}

// ─── Feature Scaling ───────────────────────────────────────────────────────

// standardize(values) — z-score standardization: (x - mean) / std.
fn standardize(values) {
    if len(values) == 0 { return []; }
    let sum = 0.0;
    for i len(values) { sum = sum + values[i]; }
    let mean_val = sum / len(values);
    let sq = 0.0;
    for i len(values) {
        let d = values[i] - mean_val;
        sq = sq + d * d;
    }
    let std_val = num_sqrt(sq / len(values));
    if std_val == 0 { return values; }
    let result = [];
    for i len(values) { result[i] = (values[i] - mean_val) / std_val; }
    return result;
}

// normalize(values) — min-max normalization to [0, 1].
fn normalize(values) {
    if len(values) == 0 { return []; }
    let mn = values[0]; let mx = values[0];
    for i len(values) {
        if values[i] < mn { mn = values[i]; }
        if values[i] > mx { mx = values[i]; }
    }
    if mn == mx { return values; }
    let result = [];
    for i len(values) { result[i] = (values[i] - mn) / (mx - mn); }
    return result;
}

// normalize_range(values, low, high) — normalize to custom range [low, high].
fn normalize_range(values, low = 0.0, high = 1.0) {
    let normed = normalize(values);
    let result = [];
    for i len(normed) { result[i] = low + normed[i] * (high - low); }
    return result;
}

// ─── K-Fold Cross-Validation ───────────────────────────────────────────────

// kfold_split(data, k) — split data into k folds, returns array of {train, test} splits.
fn kfold_split(data, k = 5) {
    let n = len(data);
    if n < k { k = n; }
    let shuffled = shuffle_data(data);
    let fold_size = n / k;
    let folds = [];
    for f k {
        let fold = [];
        let start = f * fold_size;
        let end = start + fold_size;
        if f == k - 1 { end = n; }
        for i end - start {
            fold[i] = shuffled[start + i];
        }
        folds[f] = fold;
    }
    let splits = [];
    for j k {
        let train = [];
        for t k {
            if t != j {
                for m len(folds[t]) {
                    train[len(train)] = folds[t][m];
                }
            }
        }
        splits[j] = map{ train: train, test: folds[j] };
    }
    return splits;
}

// cross_validate(X, y, model_fn, k) — K-fold CV returning array of metric maps.
fn cross_validate(X, y, model_fn, k = 5) {
    let n = len(X);
    if n == 0 { return []; }
    // Build list of {X, y} pairs
    let data = [];
    for pair_index n {
        data[pair_index] = map{ x: X[pair_index], y: y[pair_index] };
    }
    let folds = kfold_split(data, k);
    let scores = [];
    for f k {
        let train_data = folds[f].train;
        let test_data = folds[f].test;
        let train_X = []; let train_y = [];
        for train_index len(train_data) {
            train_X[train_index] = train_data[train_index].x;
            train_y[train_index] = train_data[train_index].y;
        }
        let test_X = []; let test_y = [];
        for test_index len(test_data) {
            test_X[test_index] = test_data[test_index].x;
            test_y[test_index] = test_data[test_index].y;
        }
        let model = model_fn(train_X, train_y);
        let preds = model(test_X);
        let acc = accuracy(test_y, preds);
        scores[f] = acc;
    }
    // Summarize
    let mean_score = 0.0;
    for f k { mean_score = mean_score + scores[f]; }
    mean_score = mean_score / k;
    return map{ scores: scores, mean: mean_score, k: k };
}

// ─── Additional Feature Engineering ───────────────────────────────────────

// one_hot_encode(values) — one-hot encode categorical labels.
fn one_hot_encode(values) {
    // Gather unique values
    let uniq = [];
    for i len(values) {
        if not contains(uniq, values[i]) { uniq[len(uniq)] = values[i]; }
    }
    let m = len(uniq);
    let encoding = map{};
    for u m {
        let vec = [];
        for v m { vec[v] = 0; }
        vec[u] = 1;
        encoding[uniq[u]] = vec;
    }
    return map{ encoding: encoding, categories: uniq };
}

// ─── Distance Metrics ──────────────────────────────────────────────────────

fn euclidean_distance(a, b) {
    let total = 0.0;
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i n {
        let d = a[i] - b[i];
        total = total + d * d;
    }
    return num_sqrt(total);
}

fn manhattan_distance(a, b) {
    let total = 0.0;
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i n {
        let d = a[i] - b[i];
        if d < 0 { d = 0 - d; }
        total = total + d;
    }
    return total;
}

fn cosine_similarity(a, b) {
    let dot = 0.0; let norm_a = 0.0; let norm_b = 0.0;
    let n = len(a);
    if len(b) < n { n = len(b); }
    for i n {
        dot = dot + a[i] * b[i];
        norm_a = norm_a + a[i] * a[i];
        norm_b = norm_b + b[i] * b[i];
    }
    if norm_a == 0 or norm_b == 0 { return 0.0; }
    return dot / (num_sqrt(norm_a) * num_sqrt(norm_b));
}

// ── Learners ────────────────────────────────────────────────────────────────────

// linreg_fit(xs, ys) → { slope, intercept } — ordinary least squares (1D).
fn linreg_fit(xs, ys) {
    let n = len(xs);
    let sx = 0; let sy = 0; let i = 0;
    while i < n { sx = sx + xs[i]; sy = sy + ys[i]; i = i + 1; }
    let mx = sx / n; let my = sy / n;
    let sxx = 0; let sxy = 0; i = 0;
    while i < n { let dx = xs[i] - mx; sxx = sxx + dx * dx; sxy = sxy + dx * (ys[i] - my); i = i + 1; }
    if sxx == 0 { return error("ml.linreg_fit: zero variance in x"); }
    let slope = sxy / sxx;
    return map{ slope: slope, intercept: my - slope * mx };
}
fn linreg_predict(model, x) { return model.slope * x + model.intercept; }

// knn_classify(train_X, train_y, query, k) — majority label of the k nearest
// (Euclidean) training points.
fn knn_classify(train_X, train_y, query, k) {
    let n = len(train_X);
    let dists = [];
    let i = 0;
    while i < n { array_push(dists, map{ d: euclidean_distance(train_X[i], query), label: train_y[i] }); i = i + 1; }
    let a = 1;
    while a < len(dists) {
        let key = dists[a];
        let b = a - 1;
        while b >= 0 and dists[b].d > key.d { dists[b + 1] = dists[b]; b = b - 1; }
        dists[b + 1] = key;
        a = a + 1;
    }
    let kk = k; if kk > n { kk = n; }
    let counts = map{};
    let best = nil; let bestc = 0;
    let j = 0;
    while j < kk {
        let l = str(dists[j].label);
        let c = 0; if map_has(counts, l) { c = counts[l]; }
        c = c + 1; counts[l] = c;
        if c > bestc { bestc = c; best = dists[j].label; }
        j = j + 1;
    }
    return best;
}

// kmeans(points, k, iters) → { centroids, assignments } — Lloyd's algorithm with
// deterministic spread-out initialization (evenly-spaced point indices).
fn kmeans(points, k, iters) {
    let n = len(points);
    let dim = len(points[0]);
    let centroids = [];
    let c = 0;
    while c < k { array_push(centroids, points[num_floor(c * n / k)]); c = c + 1; }
    let assign = [];
    let p = 0;
    while p < n { array_push(assign, 0); p = p + 1; }
    let it = 0;
    while it < iters {
        p = 0;
        while p < n {
            let best = 0; let bd = euclidean_distance(points[p], centroids[0]);
            c = 1;
            while c < k { let d = euclidean_distance(points[p], centroids[c]); if d < bd { bd = d; best = c; } c = c + 1; }
            assign[p] = best;
            p = p + 1;
        }
        c = 0;
        while c < k {
            let sum = []; let dd = 0;
            while dd < dim { array_push(sum, 0); dd = dd + 1; }
            let cnt = 0;
            p = 0;
            while p < n {
                if assign[p] == c { dd = 0; while dd < dim { sum[dd] = sum[dd] + points[p][dd]; dd = dd + 1; } cnt = cnt + 1; }
                p = p + 1;
            }
            if cnt > 0 { dd = 0; while dd < dim { sum[dd] = sum[dd] / cnt; dd = dd + 1; } centroids[c] = sum; }
            c = c + 1;
        }
        it = it + 1;
    }
    return map{ centroids: centroids, assignments: assign };
}

// ─── Bounded binary perceptron ──────────────────────────────────────────────

let PERCEPTRON_FORMAT = "pblang.ml.perceptron.v1";
let PERCEPTRON_MAX_FEATURES = 4096;
let PERCEPTRON_MAX_SAMPLES = 100000;
let PERCEPTRON_MAX_EPOCHS = 10000;
let PERCEPTRON_MAX_TRAIN_STEPS = 2000000;
let PERCEPTRON_MAX_DATA_VALUES = 2000000;
let PERCEPTRON_MAX_ABS_VALUE = 1000000000000;

fn _perceptron_fail(message) { throw "ml.perceptron: " + message; }

fn _perceptron_number(value, label) {
    let encoded = if type(value) == "number" { json_stringify(value) } else { "null" };
    if type(value) != "number" or encoded == "null" or encoded == ""
       or num_abs(value) > PERCEPTRON_MAX_ABS_VALUE {
        _perceptron_fail(label + " must be a finite bounded number");
    }
    return value;
}

fn _perceptron_vector(values, expected, label) {
    if type(values) != "array" or len(values) != expected {
        _perceptron_fail(label + " must contain exactly " + str(expected) + " values");
    }
    let out = [];
    let i = 0;
    while i < expected {
        array_push(out, _perceptron_number(values[i], label + "[" + str(i) + "]"));
        i = i + 1;
    }
    return out;
}

fn perceptron_create(weights, bias = 0.0, threshold = 0.0) {
    if type(weights) != "array" or len(weights) < 1
       or len(weights) > PERCEPTRON_MAX_FEATURES {
        _perceptron_fail("weights must contain 1.." + str(PERCEPTRON_MAX_FEATURES) + " values");
    }
    let copied = _perceptron_vector(weights, len(weights), "weights");
    return map{ format: PERCEPTRON_FORMAT, weights: copied,
                bias: _perceptron_number(bias, "bias"),
                threshold: _perceptron_number(threshold, "threshold"),
                feature_count: len(copied) };
}

fn _perceptron_model(model) {
    if type(model) != "map" or (try model.format catch "") != PERCEPTRON_FORMAT {
        _perceptron_fail("model has an unsupported format");
    }
    let weights = try model.weights catch nil;
    let bias = try model.bias catch nil;
    let threshold = try model.threshold catch nil;
    return perceptron_create(weights, bias, threshold);
}

fn _perceptron_score_checked(model, features) {
    let total = model.bias;
    let i = 0;
    while i < model.feature_count {
        total = total + model.weights[i] * features[i];
        _perceptron_number(total, "weighted score");
        i = i + 1;
    }
    return total;
}

fn perceptron_score(model, features) {
    let checked = _perceptron_model(model);
    let row = _perceptron_vector(features, checked.feature_count, "features");
    return _perceptron_score_checked(checked, row);
}

fn perceptron_predict(model, features) {
    let checked = _perceptron_model(model);
    let feature_count = checked.feature_count;
    let threshold = checked.threshold;
    let validated = _perceptron_vector(features, feature_count, "features");
    let score = _perceptron_score_checked(checked, validated);
    if score > threshold { return 1; }
    return 0;
}

fn _perceptron_dataset(samples, labels, feature_count) {
    if type(samples) != "array" or len(samples) < 1 or len(samples) > PERCEPTRON_MAX_SAMPLES {
        _perceptron_fail("samples must contain 1.." + str(PERCEPTRON_MAX_SAMPLES) + " rows");
    }
    if type(labels) != "array" or len(labels) != len(samples) {
        _perceptron_fail("labels must contain one value for every sample");
    }
    if len(samples) * feature_count > PERCEPTRON_MAX_DATA_VALUES {
        _perceptron_fail("sample and feature product exceeds the dataset bound");
    }
    let rows = []; let targets = []; let i = 0;
    while i < len(samples) {
        array_push(rows, _perceptron_vector(samples[i], feature_count, "sample " + str(i)));
        if labels[i] != 0 and labels[i] != 1 {
            _perceptron_fail("label " + str(i) + " must be 0 or 1");
        }
        array_push(targets, labels[i]);
        i = i + 1;
    }
    return map{ samples: rows, labels: targets };
}

fn _perceptron_options(options) {
    if options == nil { options = map{}; }
    if type(options) != "map" { _perceptron_fail("options must be a map"); }
    for key in map_keys(options) {
        if not contains(["learning_rate", "max_epochs", "early_stop"], key) {
            _perceptron_fail("unknown option: " + str(key));
        }
    }
    let learning_rate = try options.learning_rate catch 0.1;
    let max_epochs = try options.max_epochs catch 100;
    let early_stop = try options.early_stop catch true;
    _perceptron_number(learning_rate, "learning_rate");
    if learning_rate <= 0 or learning_rate > 10 {
        _perceptron_fail("learning_rate must be in 0..10");
    }
    if type(max_epochs) != "number" or max_epochs != num_floor(max_epochs)
       or max_epochs < 1 or max_epochs > PERCEPTRON_MAX_EPOCHS {
        _perceptron_fail("max_epochs must be an integer in 1.." + str(PERCEPTRON_MAX_EPOCHS));
    }
    if type(early_stop) != "bool" { _perceptron_fail("early_stop must be boolean"); }
    return map{ learning_rate: learning_rate, max_epochs: max_epochs, early_stop: early_stop };
}

fn perceptron_train(model, samples, labels, options = nil) {
    let current = _perceptron_model(model);
    let policy = _perceptron_options(options);
    if type(samples) == "array"
       and len(samples) * policy.max_epochs > PERCEPTRON_MAX_TRAIN_STEPS {
        _perceptron_fail("sample and epoch product exceeds the training-step bound");
    }
    let data = _perceptron_dataset(samples, labels, current.feature_count);
    let mistakes_by_epoch = []; let updates = 0; let epoch = 0; let converged = false;
    while epoch < policy.max_epochs {
        let mistakes = 0; let sample_index = 0;
        while sample_index < len(data.samples) {
            let row = data.samples[sample_index];
            let predicted = if _perceptron_score_checked(current, row) > current.threshold { 1 } else { 0 };
            let difference = data.labels[sample_index] - predicted;
            if difference != 0 {
                let feature_index = 0;
                while feature_index < current.feature_count {
                    current.weights[feature_index] = _perceptron_number(
                        current.weights[feature_index]
                            + policy.learning_rate * difference * row[feature_index],
                        "updated weight");
                    feature_index = feature_index + 1;
                }
                current.bias = _perceptron_number(
                    current.bias + policy.learning_rate * difference, "updated bias");
                mistakes = mistakes + 1; updates = updates + 1;
            }
            sample_index = sample_index + 1;
        }
        array_push(mistakes_by_epoch, mistakes);
        epoch = epoch + 1;
        if mistakes == 0 {
            converged = true;
            if policy.early_stop { break; }
        }
    }
    return map{ model: current, converged: converged, epochs_run: epoch,
                updates: updates, mistakes_by_epoch: mistakes_by_epoch,
                learning_rate: policy.learning_rate,
                training_steps: len(data.samples) * epoch,
                bounded: true, input_model_mutated: false };
}

fn perceptron_evaluate(model, samples, labels) {
    let checked = _perceptron_model(model);
    let data = _perceptron_dataset(samples, labels, checked.feature_count);
    let predictions = []; let mistakes = 0; let i = 0;
    while i < len(data.samples) {
        let predicted = if _perceptron_score_checked(checked, data.samples[i]) > checked.threshold { 1 } else { 0 };
        array_push(predictions, predicted);
        if predicted != data.labels[i] { mistakes = mistakes + 1; }
        i = i + 1;
    }
    return map{ predictions: predictions, accuracy: accuracy(data.labels, predictions),
                mistakes: mistakes, sample_count: len(data.samples) };
}

export train_test_split, shuffle_data, accuracy, precision, recall, f1_score,
       confusion_matrix, confusion_matrix_report,
       mse, mae, rmse, r2_score,
       standardize, normalize, normalize_range,
       kfold_split, cross_validate,
       one_hot_encode,
       euclidean_distance, manhattan_distance, cosine_similarity,
       linreg_fit, linreg_predict, knn_classify, kmeans,
       perceptron_create, perceptron_score, perceptron_predict,
       perceptron_train, perceptron_evaluate;
