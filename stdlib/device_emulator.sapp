// stdlib/device_emulator.sapp -- bounded device-class execution contracts.
//
// Device profiles compose platform_emulator's userspace/ABI machine with the
// portable input-event model and deterministic sensor/signal channels. They
// are conformance fixtures for PBLang code and code generators, not full
// hardware, driver, radio, kernel, or proprietary-framework emulators.

let Platform = import("stdlib:platform_emulator.sapp");
let Input = import("stdlib:input_events.sapp");

let PROFILE_FORMAT = "pblang.device.profile.v1";
let MACHINE_FORMAT = "pblang.device.machine.v1";

fn _row(kind, oses, input, sensors, accelerators, memory_bytes, width, height) {
    return map{ kind: kind, oses: oses, input: input, sensors: sensors,
                accelerators: accelerators, memory_bytes: memory_bytes,
                width: width, height: height };
}

fn catalog() {
    return [
        _row("desktop", ["linux", "windows", "macos", "freebsd", "openbsd", "netbsd", "solaris", "haiku", "chromeos", "fuchsia", "plan9", "amigaos", "os2", "dos"], true, [], ["cpu", "simd", "gpu", "npu"], 1048576, 1920, 1080),
        _row("server", ["linux", "windows", "freebsd", "openbsd", "netbsd", "solaris", "aix", "hpux", "irix", "plan9"], false, ["thermal", "power", "network"], ["cpu", "simd", "gpu", "npu"], 2097152, 1, 1),
        _row("smartphone", ["android", "ios", "fuchsia"], true, ["touch", "accelerometer", "gyroscope", "gps", "camera", "microphone"], ["cpu", "simd", "gpu", "npu", "dsp"], 1048576, 1080, 2400),
        _row("tablet", ["android", "ios", "chromeos", "fuchsia"], true, ["touch", "accelerometer", "gyroscope", "gps", "camera", "microphone"], ["cpu", "simd", "gpu", "npu"], 1048576, 1600, 2560),
        _row("smartwatch", ["android", "ios", "freertos", "zephyr", "nuttx"], true, ["touch", "accelerometer", "gyroscope", "heart-rate", "gps"], ["cpu", "dsp"], 262144, 454, 454),
        _row("smart-tv", ["linux", "android", "tizen", "webos"], true, ["remote", "microphone", "network"], ["cpu", "simd", "gpu", "video"], 1048576, 1920, 1080),
        _row("game-console", ["linux", "windows", "baremetal", "amigaos"], true, ["controller", "audio", "network"], ["cpu", "simd", "gpu", "audio"], 1048576, 1920, 1080),
        _row("router", ["linux", "freebsd", "openbsd", "netbsd", "freertos", "zephyr", "nuttx", "vxworks"], false, ["network", "thermal", "radio"], ["cpu", "crypto", "packet"], 524288, 1, 1),
        _row("microcontroller", ["freertos", "zephyr", "nuttx", "baremetal"], false, ["gpio", "adc", "timer", "i2c", "spi", "uart"], ["cpu", "dsp"], 65536, 1, 1),
        _row("sensor", ["freertos", "zephyr", "nuttx", "baremetal"], false, ["gpio", "adc", "temperature", "pressure", "motion"], ["cpu", "dsp"], 32768, 1, 1),
        _row("satellite", ["linux", "vxworks", "qnx", "zephyr", "baremetal"], false, ["telemetry", "attitude", "radiation", "thermal", "radio", "gps"], ["cpu", "dsp", "fpga"], 524288, 1, 1),
        _row("automotive", ["linux", "android", "qnx", "vxworks", "freertos", "zephyr", "nuttx"], true, ["can", "lin", "gps", "camera", "radar", "lidar", "speed"], ["cpu", "simd", "gpu", "npu", "dsp"], 1048576, 1280, 720),
        _row("appliance", ["linux", "freertos", "zephyr", "nuttx", "baremetal", "dos", "cpm"], true, ["gpio", "temperature", "timer", "buttons"], ["cpu"], 65536, 320, 240),
        _row("calculator", ["cpm", "dos", "freertos", "baremetal"], true, ["keypad", "battery"], ["cpu"], 32768, 320, 240),
        _row("browser", ["wasi", "linux", "windows", "macos", "android", "ios", "chromeos"], true, ["pointer", "keyboard", "network"], ["cpu", "simd", "gpu", "webgpu"], 1048576, 1280, 720),
        _row("quantum-controller", ["linux", "qnx", "baremetal"], false, ["pulse", "clock", "temperature", "measurement"], ["cpu", "dsp", "fpga", "qpu-control"], 524288, 1, 1)
    ];
}

fn _contains(values, wanted) {
    let i = 0; while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _map_or(values, key, fallback) {
    if values != nil and is_map(values) and map_has(values, key) { return values[key]; }
    return fallback;
}

fn _bounded_int(value, name, low, high) {
    if type(value) != "number" or num_floor(value) != value or value < low or value > high {
        throw "device_emulator: " + name + " must be " + str(low) + ".." + str(high);
    }
    return value;
}

fn _profile_error(kind, reason) {
    return map{ ok: false, format: PROFILE_FORMAT, kind: kind, error: reason };
}

fn resolve(kind_value, os, version, arch, options = nil) {
    let kind = str_lower(str(kind_value ?? "")); let rows = catalog(); let row = nil; let i = 0;
    while i < len(rows) { if rows[i].kind == kind { row = rows[i]; } i = i + 1; }
    if row == nil { return _profile_error(kind, "unsupported device class"); }
    let platform = Platform.resolve(os, version, arch, _map_or(options, "platform_options", nil));
    if not platform.ok { return _profile_error(kind, platform.error); }
    if not _contains(row.oses, platform.os) { return _profile_error(kind, "operating-system family is not valid for this device class"); }

    let memory_bytes = _bounded_int(_map_or(options, "memory_bytes", row.memory_bytes), "memory_bytes", 1, 16777216);
    let width = _bounded_int(_map_or(options, "width", row.width), "width", 1, 32768);
    let height = _bounded_int(_map_or(options, "height", row.height), "height", 1, 32768);
    let max_signals = _bounded_int(_map_or(options, "max_signals", 256), "max_signals", 1, 4096);
    return map{
        ok: true, format: PROFILE_FORMAT, kind: kind, platform: platform,
        input: row.input, sensors: row.sensors, accelerators: row.accelerators,
        memory_bytes: memory_bytes, width: width, height: height, max_signals: max_signals,
        isa: Platform.isa_model(platform),
        boundary: "bounded device contract; not full hardware, kernel, driver, radio, or proprietary framework emulation"
    };
}

fn custom_profile(spec, platform) {
    if spec == nil or not is_map(spec) or platform == nil or not platform.ok { return _profile_error("custom", "valid spec and platform are required"); }
    if not map_has(spec, "kind") or len(str(spec.kind)) == 0 { return _profile_error("custom", "custom device kind is required"); }
    let memory_bytes = _bounded_int(_map_or(spec, "memory_bytes", 65536), "memory_bytes", 1, 16777216);
    let width = _bounded_int(_map_or(spec, "width", 1), "width", 1, 32768);
    let height = _bounded_int(_map_or(spec, "height", 1), "height", 1, 32768);
    return map{
        ok: true, format: PROFILE_FORMAT, kind: str_lower(str(spec.kind)), platform: platform,
        input: _map_or(spec, "input", false), sensors: _map_or(spec, "sensors", []),
        accelerators: _map_or(spec, "accelerators", ["cpu"]), memory_bytes: memory_bytes,
        width: width, height: height, max_signals: _bounded_int(_map_or(spec, "max_signals", 256), "max_signals", 1, 4096),
        isa: Platform.isa_model(platform),
        boundary: "user-defined device contract; conformance remains unverified until tests are supplied"
    };
}

fn machine(profile, options = nil) {
    if profile == nil or not profile.ok { throw "device_emulator.machine: invalid profile"; }
    let platform_options = map{
        memory_bytes: profile.memory_bytes,
        max_files: _bounded_int(_map_or(options, "max_files", 128), "max_files", 1, 4096),
        max_output_bytes: _bounded_int(_map_or(options, "max_output_bytes", 1048576), "max_output_bytes", 1, 16777216)
    };
    let input = nil;
    if profile.input {
        input = Input.new_device(profile.width, profile.height, map{
            max_events: _bounded_int(_map_or(options, "max_input_events", 10000), "max_input_events", 1, 1000000),
            max_text: _bounded_int(_map_or(options, "max_input_text", 65536), "max_input_text", 1, 1048576)
        });
    }
    return map{
        format: MACHINE_FORMAT, profile: profile, platform: Platform.machine(profile.platform, platform_options),
        input: input, signals: map{}, signal_count: 0, signal_updates: 0, clock_ms: 0,
        limits: map{ max_signals: profile.max_signals, max_signal_updates: _bounded_int(_map_or(options, "max_signal_updates", 100000), "max_signal_updates", 1, 1000000) }
    };
}

fn input_apply(machine, event) {
    if machine == nil or (try machine.format catch "") != MACHINE_FORMAT { return map{ ok: false, error: "invalid device machine" }; }
    if machine.input == nil { return map{ ok: false, error: "device class has no input surface" }; }
    return Input.apply(machine.input, event);
}

fn signal_write(machine, name_value, value) {
    if machine == nil or (try machine.format catch "") != MACHINE_FORMAT { return map{ ok: false, error: "invalid device machine" }; }
    let name = str(name_value ?? "");
    if len(name) == 0 or len(name) > 64 or str_contains(name, "\x00") { return map{ ok: false, error: "signal name must contain 1..64 non-NUL characters" }; }
    let value_type = type(value);
    if value_type != "number" and value_type != "string" and value_type != "boolean" { return map{ ok: false, error: "signal value must be scalar" }; }
    if value_type == "number" {
        let numeric_text = str_lower(str(value));
        if numeric_text == "nan" or numeric_text == "+nan" or numeric_text == "-nan" or
           numeric_text == "inf" or numeric_text == "+inf" or numeric_text == "-inf" or
           numeric_text == "infinity" or numeric_text == "+infinity" or numeric_text == "-infinity" {
            return map{ ok: false, error: "signal number must be finite" };
        }
    }
    if value_type == "string" and len(value) > 4096 { return map{ ok: false, error: "signal string exceeds 4096 characters" }; }
    if machine.signal_updates >= machine.limits.max_signal_updates { return map{ ok: false, error: "signal update budget exceeded" }; }
    let is_new = not map_has(machine.signals, name);
    if is_new and machine.signal_count >= machine.limits.max_signals { return map{ ok: false, error: "signal channel limit exceeded" }; }
    machine.signals[name] = map{ value: value, updated_ms: machine.clock_ms };
    if is_new { machine.signal_count = machine.signal_count + 1; }
    machine.signal_updates = machine.signal_updates + 1;
    return map{ ok: true, name: name, updates: machine.signal_updates };
}

fn signal_read(machine, name_value) {
    if machine == nil or (try machine.format catch "") != MACHINE_FORMAT { return map{ ok: false, error: "invalid device machine" }; }
    let name = str(name_value ?? "");
    if not map_has(machine.signals, name) { return map{ ok: true, found: false, value: nil }; }
    return map{ ok: true, found: true, value: machine.signals[name].value, updated_ms: machine.signals[name].updated_ms };
}

fn tick(machine, milliseconds = 1) {
    if machine == nil or (try machine.format catch "") != MACHINE_FORMAT { throw "device_emulator.tick: invalid device machine"; }
    let step = _bounded_int(milliseconds, "milliseconds", 0, 86400000);
    machine.clock_ms = machine.clock_ms + step;
    Platform.syscall(machine.platform, "clock_ms", map{ advance: step });
    return machine.clock_ms;
}

fn stats(machine) {
    if machine == nil or (try machine.format catch "") != MACHINE_FORMAT { return map{ ok: false, error: "invalid device machine" }; }
    return map{
        ok: true, format: "pblang.device.machine.stats.v1", kind: machine.profile.kind,
        platform: Platform.machine_stats(machine.platform), signal_channels: machine.signal_count,
        signal_updates: machine.signal_updates, max_signals: machine.limits.max_signals,
        max_signal_updates: machine.limits.max_signal_updates, clock_ms: machine.clock_ms,
        input: if machine.input == nil { nil } else { Input.snapshot(machine.input) }
    };
}

export catalog, resolve, custom_profile, machine, input_apply, signal_write, signal_read, tick, stats;
