// stdlib/observable.sapp — Reactive values and streams for pblang.
//
// Provides: refs, computed values, watchers, event streams, stream operators,
// and a small batching layer.
//
// Usage:
//   let obs = import("stdlib:observable.sapp");
//   let count = obs.ref(0);
//   obs.watch(count, fn(old_val, new_val) { print "changed: " + str(new_val); });
//   obs.set(count, 1);  // triggers watcher

fn ref(initial) {
    return map{
        _value: initial,
        _watchers: [],
        _type: "observable",
        _batch_depth: 0,
        _pending: false,
        _old_pending: nil,
    };
}

fn get(observable) {
    return observable._value;
}

fn set(observable, new_value) {
    let old = observable._value;
    if old == new_value { return; }  // no change
    observable._value = new_value;

    if observable._batch_depth > 0 {
        if observable._pending == false {
            observable._old_pending = old;
        }
        observable._pending = true;
        return;
    }

    _notify(observable, old, new_value);
}

fn update(observable, f) {
    set(observable, f(get(observable)));
    return get(observable);
}

fn _notify(observable, old_value, new_value) {
    let watchers = observable._watchers;
    for i len(watchers) {
        try watchers[i](old_value, new_value) catch nil;
    }
}

fn watch(observable, handler) {
    observable._watchers[len(observable._watchers)] = handler;
    return fn() {
        // Unsubscribe function
        let new_watchers = [];
        for i len(observable._watchers) {
            if observable._watchers[i] != handler {
                new_watchers[len(new_watchers)] = observable._watchers[i];
            }
        }
        observable._watchers = new_watchers;
    };
}

fn watch_now(observable, handler) {
    handler(nil, observable._value);
    return watch(observable, handler);
}

fn computed(deps, compute_fn) {
    let result = ref(compute_fn());
    for i len(deps) {
        watch(deps[i], fn(old_v, new_v) {
            let new_result = compute_fn();
            set(result, new_result);
        });
    }
    return result;
}

fn batch(observables, updates_fn) {
    if is_fn(observables) {
        updates_fn = observables;
        observables = [];
    }
    for i len(observables) {
        observables[i]._batch_depth = observables[i]._batch_depth + 1;
    }
    updates_fn();
    for i len(observables) {
        let obs = observables[i];
        obs._batch_depth = obs._batch_depth - 1;
        if obs._batch_depth == 0 and obs._pending {
            let old_value = obs._old_pending;
            let new_value = obs._value;
            obs._pending = false;
            obs._old_pending = nil;
            if old_value != new_value {
                _notify(obs, old_value, new_value);
            }
        }
    }
}

fn stream() {
    return map{ _subs: [], _closed: false, _type: "stream" };
}

fn subject() {
    return stream();
}

fn subscribe(s, handler) {
    if s._closed { return fn() { return nil; }; }
    array_push(s._subs, handler);
    return fn() {
        let next = [];
        for i len(s._subs) {
            if s._subs[i] != handler {
                array_push(next, s._subs[i]);
            }
        }
        s._subs = next;
    };
}

fn emit(s, value) {
    if s._closed { return false; }
    let subs = s._subs;
    for i len(subs) {
        try subs[i](value) catch nil;
    }
    return true;
}

fn close(s) {
    s._closed = true;
    s._subs = [];
}

fn from_array(values) {
    let s = stream();
    s._source = values;
    return s;
}

fn drain(s) {
    let values = try s._source catch nil;
    if values == nil { return s; }
    for i len(values) {
        emit(s, values[i]);
    }
    return s;
}

fn map_stream(input, f) {
    let out = stream();
    subscribe(input, fn(value) { emit(out, f(value)); });
    return out;
}

fn filter_stream(input, pred) {
    let out = stream();
    subscribe(input, fn(value) {
        if pred(value) { emit(out, value); }
    });
    return out;
}

fn scan_stream(input, reducer, initial) {
    let acc = initial;
    let out = stream();
    subscribe(input, fn(value) {
        acc = reducer(acc, value);
        emit(out, acc);
    });
    return out;
}

fn take_stream(input, n) {
    let out = stream();
    let seen = 0;
    subscribe(input, fn(value) {
        if seen < n {
            seen = seen + 1;
            emit(out, value);
            if seen >= n { close(out); }
        }
    });
    return out;
}

fn merge(a, b) {
    let out = stream();
    subscribe(a, fn(value) { emit(out, value); });
    subscribe(b, fn(value) { emit(out, value); });
    return out;
}

fn combine_latest(a, b, combiner) {
    let out = stream();
    let have_a = false;
    let have_b = false;
    let last_a = nil;
    let last_b = nil;
    subscribe(a, fn(value) {
        last_a = value;
        have_a = true;
        if have_b { emit(out, combiner(last_a, last_b)); }
    });
    subscribe(b, fn(value) {
        last_b = value;
        have_b = true;
        if have_a { emit(out, combiner(last_a, last_b)); }
    });
    return out;
}

// collect(s) — subscribe and accumulate every emission into an array (which is
// returned and grows as the stream emits). Handy for tests and aggregation.
fn collect(s) {
    let acc = [];
    subscribe(s, fn(v) { array_push(acc, v); });
    return acc;
}

// distinct_stream(input) — emit only when the value differs from the previous one.
fn distinct_stream(input) {
    let out = stream();
    let has_last = false;
    let last = nil;
    subscribe(input, fn(v) {
        if not has_last or v != last { emit(out, v); last = v; has_last = true; }
    });
    return out;
}

// tap_stream(input, f) — run f(value) for its side effect, then pass value through.
fn tap_stream(input, f) {
    let out = stream();
    subscribe(input, fn(v) { f(v); emit(out, v); });
    return out;
}

// skip_stream(input, n) — drop the first n emissions.
fn skip_stream(input, n) {
    let out = stream();
    let seen = 0;
    subscribe(input, fn(v) { seen = seen + 1; if seen > n { emit(out, v); } });
    return out;
}

// take_while_stream(input, pred) — emit while pred(value) holds, then close.
fn take_while_stream(input, pred) {
    let out = stream();
    let active = true;
    subscribe(input, fn(v) {
        if active {
            if pred(v) { emit(out, v); } else { active = false; close(out); }
        }
    });
    return out;
}

// buffer_stream(input, size) — group emissions into arrays of `size` (only full
// chunks are emitted; a trailing partial chunk is held).
fn buffer_stream(input, size) {
    let out = stream();
    let buf = [];
    subscribe(input, fn(v) {
        array_push(buf, v);
        if len(buf) >= size { emit(out, buf); buf = []; }
    });
    return out;
}

export ref, get, set, update, watch, watch_now, computed, batch;
export stream, subject, subscribe, emit, close, from_array, drain, collect;
export map_stream, filter_stream, scan_stream, take_stream, merge, combine_latest,
       distinct_stream, tap_stream, skip_stream, take_while_stream, buffer_stream;
