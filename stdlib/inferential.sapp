// stdlib/inferential.sapp — Inferential statistics for pblang (pure pblang).
//
// Hypothesis tests and regression built on the distribution CDFs in prob.sapp:
// one-sample and Welch two-sample t-tests, chi-square goodness-of-fit, and
// ordinary least-squares linear regression. Each test returns its statistic,
// degrees of freedom, and a p-value, so you can act on real significance rather
// than eyeballing means. Complements stdlib:stat.sapp (descriptive) and
// stdlib:prob.sapp (distributions).
//
//   let inf = import("stdlib:inferential.sapp");
//   inf.t_test_one_sample(returns, 0.0);   // is the mean return non-zero?
//   inf.linear_regression(x, y);           // {slope, intercept, r2, n}

let prob = import("stdlib:prob.sapp");

fn _mean(a) {
    let s = 0;
    let i = 0;
    while i < len(a) { s = s + a[i]; i = i + 1; }
    return s / len(a);
}

// sample variance (Bessel's correction, n-1)
fn _var_sample(a) {
    let n = len(a);
    if n < 2 { return 0; }
    let m = _mean(a);
    let s = 0;
    let i = 0;
    while i < n { let d = a[i] - m; s = s + d * d; i = i + 1; }
    return s / (n - 1);
}

fn _abs(x) { if x < 0 { return 0 - x; } return x; }

// linear_regression(x, y) → ordinary least-squares fit {slope, intercept, r2, n}
fn linear_regression(x, y) {
    let n = len(x);
    let mx = _mean(x);
    let my = _mean(y);
    let sxy = 0;
    let sxx = 0;
    let syy = 0;
    let i = 0;
    while i < n {
        let dx = x[i] - mx;
        let dy = y[i] - my;
        sxy = sxy + dx * dy;
        sxx = sxx + dx * dx;
        syy = syy + dy * dy;
        i = i + 1;
    }
    let slope = sxy / sxx;
    let intercept = my - slope * mx;
    let r2 = 0;
    if sxx > 0 and syy > 0 {
        let r = sxy / num_sqrt(sxx * syy);
        r2 = r * r;
    }
    return map{ slope: slope, intercept: intercept, r2: r2, n: n };
}

// t_test_one_sample(data, mu0) → tests whether the mean differs from mu0.
// Returns the t statistic, df, two-tailed p-value, sample mean, and n.
fn t_test_one_sample(data, mu0) {
    let n = len(data);
    let m = _mean(data);
    let se = num_sqrt(_var_sample(data)) / num_sqrt(n);
    let t = (m - mu0) / se;
    let df = n - 1;
    let p = 2 * (1 - prob.t_cdf(_abs(t), df));
    return map{ t: t, df: df, p_value: p, mean: m, n: n };
}

// t_test_welch(a, b) → two-sample t-test that does NOT assume equal variances
// (Welch's), with Welch–Satterthwaite degrees of freedom. Two-tailed p-value.
fn t_test_welch(a, b) {
    let na = len(a);
    let nb = len(b);
    let sea = _var_sample(a) / na;
    let seb = _var_sample(b) / nb;
    let t = (_mean(a) - _mean(b)) / num_sqrt(sea + seb);
    let df = (sea + seb) * (sea + seb)
           / (sea * sea / (na - 1) + seb * seb / (nb - 1));
    let p = 2 * (1 - prob.t_cdf(_abs(t), df));
    return map{ t: t, df: df, p_value: p };
}

// chi_square_gof(observed, expected) → Pearson goodness-of-fit test.
// Returns the chi-square statistic, df = k-1, and the upper-tail p-value.
fn chi_square_gof(observed, expected) {
    let k = len(observed);
    let chi2 = 0;
    let i = 0;
    while i < k {
        if expected[i] > 0 {
            let d = observed[i] - expected[i];
            chi2 = chi2 + d * d / expected[i];
        }
        i = i + 1;
    }
    let df = k - 1;
    let p = 1 - prob.chi2_cdf(chi2, df);
    return map{ chi2: chi2, df: df, p_value: p };
}

// one_way_anova(groups) → tests whether several group means differ.
// groups is an array of numeric arrays. Returns the F statistic, between/within
// degrees of freedom, and the upper-tail p-value.
fn one_way_anova(groups) {
    let k = len(groups);
    // grand mean and total N
    let total = 0;
    let n_all = 0;
    let i = 0;
    while i < k {
        let g = groups[i];
        let j = 0;
        while j < len(g) { total = total + g[j]; j = j + 1; }
        n_all = n_all + len(g);
        i = i + 1;
    }
    let grand = total / n_all;
    // sum of squares between (SSB) and within (SSW)
    let ssb = 0;
    let ssw = 0;
    i = 0;
    while i < k {
        let g = groups[i];
        let gm = _mean(g);
        let dgrand = gm - grand;
        ssb = ssb + len(g) * dgrand * dgrand;
        let j = 0;
        while j < len(g) { let d = g[j] - gm; ssw = ssw + d * d; j = j + 1; }
        i = i + 1;
    }
    let df_between = k - 1;
    let df_within = n_all - k;
    let ms_between = ssb / df_between;
    let ms_within = ssw / df_within;
    let f = 0;
    if ms_within > 0 { f = ms_between / ms_within; }
    let p = 1 - prob.f_cdf(f, df_between, df_within);
    return map{ f: f, df_between: df_between, df_within: df_within, p_value: p };
}

// confidence_interval_mean(data, confidence) → a t-based CI for the population
// mean. Returns {mean, margin, lower, upper} for the given confidence (e.g. 0.95).
fn confidence_interval_mean(data, confidence) {
    let n = len(data);
    let m = _mean(data);
    let se = num_sqrt(_var_sample(data)) / num_sqrt(n);
    let df = n - 1;
    let tcrit = prob.t_ppf(1 - (1 - confidence) / 2, df);
    let margin = tcrit * se;
    return map{ mean: m, margin: margin, lower: m - margin, upper: m + margin };
}

export linear_regression, t_test_one_sample, t_test_welch, chi_square_gof,
       one_way_anova, confidence_interval_mean;
