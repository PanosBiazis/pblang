// Opt-in multi-category source analysis composed from the security and project
// audit engines. Build security remains a separate default-on gate.

let SECURITY = import("stdlib:security_analysis.sapp");
let AUDIT = import("stdlib:project_audit.sapp");
let FORMAT = "pblang.source-analysis.v1";
// Private, never mutated or exposed. Public catalogs are detached snapshots,
// not a registration API for changing which analyses run.
let _AVAILABLE = ["security", "quality", "performance", "completeness", "roadmap"];
let AVAILABLE = slice(_AVAILABLE, 0, len(_AVAILABLE));

fn _contains(values, wanted) {
    let i = 0; while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _selected(options) {
    let requested = try options.analyses catch ["security"];
    if type(requested) != "array" or len(requested) == 0 { requested = ["security"]; }
    let out = []; let i = 0;
    while i < len(requested) {
        let name = str_lower(str(requested[i]));
        if name == "all" { return slice(_AVAILABLE, 0, len(_AVAILABLE)); }
        if _contains(_AVAILABLE, name) and not _contains(out, name) { array_push(out, name); }
        i = i + 1;
    }
    return out;
}

fn _audit_category(kind) {
    if kind == "security" { return "security"; }
    if kind == "performance" { return "performance"; }
    if kind == "incomplete" { return "completeness"; }
    if kind == "roadmap" { return "roadmap"; }
    return "quality";
}

// Only an omitted key selects the default. Admit before ordered comparisons:
// the retained VM rejects NaN ordering rather than returning false.
fn limits(options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" {
        return map{ ok: false, error: "source analysis limits require map options" };
    }
    // The private default is already valid; only caller-provided values require
    // numeric admission. Return a fresh result on this fast path as well.
    if not map_has(options, "max_findings") { return map{ ok: true, max_findings: 256 }; }
    let value = options.max_findings;
    if type(value) != "number" or value != value or value - value != 0
        or value < 1 or value > 1024 or value != num_floor(value) {
        return map{ ok: false, error: "max_findings must be a finite integer in 1..1024" };
    }
    return map{ ok: true, max_findings: value };
}

fn analyze(source, path = "[source]", options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" or type(source) != "string" {
        return map{ ok: false, passed: false, format: FORMAT, error: "source analysis requires text and map options" };
    }
    let selected = _selected(options);
    if len(selected) == 0 {
        return map{ ok: false, passed: false, format: FORMAT, error: "no valid analysis category selected", available: slice(_AVAILABLE, 0, len(_AVAILABLE)) };
    }
    let bounded = limits(options);
    if not bounded.ok {
        return map{ ok: false, passed: false, format: FORMAT, error: bounded.error };
    }
    let max_findings = bounded.max_findings;
    let findings = [];
    let security_report = nil;
    if _contains(selected, "security") {
        security_report = try options.security_report catch nil;
        if security_report == nil {
            let security_options = try options.security catch map{};
            security_report = SECURITY.analyze(source, path, security_options);
        }
        if not security_report.ok { return map{ ok: false, passed: false, format: FORMAT,
            error: security_report.error, security: security_report, analyses: selected }; }
        let i = 0; while i < len(security_report.findings) and len(findings) < max_findings {
            let row = security_report.findings[i]; row.analysis = "security"; array_push(findings, row); i = i + 1;
        }
    }
    let project = AUDIT.scan_text_report(path, source, max_findings, map{
        allow_inline_suppressions: false,
        suppress_test_fixtures: (try options.suppress_test_fixtures catch false) == true
    });
    let i = 0;
    while i < len(project.findings) and len(findings) < max_findings {
        let row = project.findings[i]; let category = _audit_category(row.kind);
        if _contains(selected, category) and not (category == "security" and row.line != 0) {
            row.analysis = category; array_push(findings, row);
        }
        i = i + 1;
    }
    let fail_on_findings = (try options.fail_on_findings catch false) == true;
    let security_passed = security_report == nil or security_report.passed;
    let passed = security_passed and (not fail_on_findings or len(findings) == 0);
    return map{ ok: true, passed: passed, format: FORMAT, path: path,
        analyses: selected, available: slice(_AVAILABLE, 0, len(_AVAILABLE)), findings: findings,
        finding_count: len(findings), security: security_report,
        audit_suppressions: project.suppressed, truncated: len(findings) >= max_findings,
        fail_on_findings: fail_on_findings };
}

export FORMAT, AVAILABLE, limits, analyze;
