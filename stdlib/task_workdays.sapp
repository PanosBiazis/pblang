// Explicit what-if interpretation of plan durations as workdays. No source mutation.
let Plan=import("stdlib:task_plan.sapp");let Work=import("stdlib:work_calendar.sapp");let Date=import("stdlib:civil_date.sapp");let Text=import("stdlib:text_document.sapp");
fn schedule(plan,weekdays=nil,closed=nil){
 let source=Plan.copy(plan);let base=Plan.schedule(source);if weekdays==nil{weekdays=[0,1,2,3,4];}if closed==nil{closed=[];}
 let first=if Work.is_workday(source.start,weekdays,closed) {source.start} else {Work.add(source.start,1,weekdays,closed)};
 let week=[];for d in weekdays{array_push(week,d);}let closures=[];for d in closed{array_push(closures,d);}
 let tasks=map{};for t in source.tasks{tasks[t.id]=t;}let finishes=map{};let rows=[];let last=Date.ordinal(first);
 for original in base.tasks{let task=tasks[original.id];let begin=first;let parent_due=nil;
  for id in task.needs{let day=Date.ordinal(finishes[id]);if parent_due==nil or day>parent_due{parent_due=day;}}
  if parent_due!=nil{begin=Work.add(Date.from_ordinal(parent_due),1,week,closures);}
  let due=Work.add(begin,task.days-1,week,closures);finishes[task.id]=due;last=num_max(last,Date.ordinal(due));
  array_push(rows,map{id:task.id,label:task.label,workdays:task.days,start:begin,due:due,status:original.status});
 }
 return map{format:"pblang.task-workdays.v1",title:source.title,requested_start:source.start,start:first,due:Date.from_ordinal(last),workdays:base.days,calendar_days:last-Date.ordinal(first)+1,completed:base.completed,total:base.total,tasks:rows,weekdays:week,closed:closures,source_days_interpreted_as_workdays:true,assumptions:"explicit-workdays-unlimited-workers-fixed-durations",execution_performed:false};
}
fn writer(plan,weekdays=nil,closed=nil){let report=schedule(plan,weekdays,closed);let doc=Text.create(report.title);doc.blocks=[];
 for t in report.tasks{array_push(doc.blocks,map{kind:"heading",text:t.id+": "+t.label});array_push(doc.blocks,map{kind:"paragraph",text:"Estimated: "+t.start+" to "+t.due+"\nWorkdays: "+str(t.workdays)+" | Status: "+t.status});}
 // All caller-specified exclusions are retained. Reject if Writer budgets do not fit.
 doc.blocks[1].text=doc.blocks[1].text+"\nWhat-if: source durations interpreted as workdays. Unlimited workers; no reminders.\nWeekdays (Monday=0): "+json_stringify(report.weekdays)+"\nClosed dates: "+json_stringify(report.closed)+"\nRequested start: "+report.requested_start+" | First workday: "+report.start;
 Text.validate(doc);return doc;
}
export schedule,writer;
