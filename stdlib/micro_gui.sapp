// stdlib/micro_gui.sapp -- tiny, fast, renderer-agnostic GUI planning.
//
// This is intentionally smaller than gui.sapp. It does not open windows and does not
// draw pixels. It builds a compact render plan:
//   { commands: [...], hits: [...], signature: "..." }
// A native renderer, PBIDE panel, browser backend, or test can consume that plan.
// The goal is simple GUI apps first, then heavier IDE surfaces can reuse the same
// predictable layout/hit/dirty model instead of hand-writing every panel.

fn _s(v) { return str(v); }
fn _max(a, b) { if a > b { return a; } return b; }
fn _min(a, b) { if a < b { return a; } return b; }
fn _clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }
fn _rect(x, y, w, h) { return map{ x: x, y: y, w: w, h: h }; }

fn app(title, w, h) {
    return map{
        format: "pblang.micro_gui.app.v1",
        title: str(title),
        w: w,
        h: h,
        widgets: [],
        focus: "",
        dirty: true,
        last_action: "",
        theme: "dark"
    };
}

fn label(id, text) {
    return map{ kind: "label", id: str(id), text: str(text), x: 0, y: 0, w: 0, h: 0 };
}

fn button(id, text) {
    return map{ kind: "button", id: str(id), text: str(text), x: 0, y: 0, w: 0, h: 0 };
}

fn field(id, value, placeholder) {
    return map{ kind: "field", id: str(id), value: str(value), placeholder: str(placeholder), x: 0, y: 0, w: 0, h: 0 };
}

fn checkbox(id, text, checked) {
    return map{ kind: "checkbox", id: str(id), text: str(text), checked: checked == true, x: 0, y: 0, w: 0, h: 0 };
}

fn progress(id, value) {
    return map{ kind: "progress", id: str(id), value: _clamp(value, 0, 1), x: 0, y: 0, w: 0, h: 0 };
}

fn spacer(h) {
    return map{ kind: "spacer", id: "spacer", text: "", x: 0, y: 0, w: 0, h: h };
}

fn add(a, widget) {
    array_push(a.widgets, widget);
    a.dirty = true;
    return a;
}

fn _measure(widget, cw, ch, pad) {
    let k = str(try widget.kind catch "");
    if k == "spacer" { return _max(try widget.h catch pad, pad); }
    if k == "label" { return ch + pad; }
    if k == "button" { return ch + 3 * pad; }
    if k == "field" { return ch + 3 * pad; }
    if k == "checkbox" { return ch + 2 * pad; }
    if k == "progress" { return ch + pad; }
    return ch + 2 * pad;
}

fn layout_column(a, x, y, w, gap, cw, ch, pad) {
    let cy = y;
    let i = 0;
    while i < len(a.widgets) {
        let it = a.widgets[i];
        let h = _measure(it, cw, ch, pad);
        it.x = x;
        it.y = cy;
        it.w = w;
        it.h = h;
        cy = cy + h + gap;
        i = i + 1;
    }
    a.dirty = true;
    return a;
}

fn _cmd(op, id, rect, role, text) {
    return map{ op: op, id: id, x: rect.x, y: rect.y, w: rect.w, h: rect.h, role: role, text: text };
}

fn _hit(widget) {
    return map{
        id: str(try widget.id catch ""),
        kind: str(try widget.kind catch ""),
        x: try widget.x catch 0,
        y: try widget.y catch 0,
        w: try widget.w catch 0,
        h: try widget.h catch 0
    };
}

fn _render_widget(out, hits, widget, cw, ch, pad) {
    let k = str(try widget.kind catch "");
    let id = str(try widget.id catch "");
    let r = _rect(try widget.x catch 0, try widget.y catch 0, try widget.w catch 0, try widget.h catch 0);
    if k == "spacer" { return 0; }
    if k == "label" {
        array_push(out, _cmd("text", id, r, "text", str(try widget.text catch "")));
        return 0;
    }
    if k == "button" {
        array_push(out, _cmd("box", id, r, "button", ""));
        array_push(out, _cmd("text", id, _rect(r.x + pad, r.y + pad, r.w - 2 * pad, ch), "button_label", str(try widget.text catch "")));
        array_push(hits, _hit(widget));
        return 0;
    }
    if k == "field" {
        array_push(out, _cmd("box", id, r, "field", ""));
        let shown = str(try widget.value catch "");
        if shown == "" { shown = str(try widget.placeholder catch ""); }
        array_push(out, _cmd("text", id, _rect(r.x + pad, r.y + pad, r.w - 2 * pad, ch), "field_text", shown));
        array_push(hits, _hit(widget));
        return 0;
    }
    if k == "checkbox" {
        array_push(out, _cmd("box", id, _rect(r.x, r.y + pad, ch, ch), "checkbox", ""));
        if try widget.checked catch false { array_push(out, _cmd("text", id, _rect(r.x + pad, r.y + pad, ch, ch), "checkmark", "x")); }
        array_push(out, _cmd("text", id, _rect(r.x + ch + pad, r.y + pad, r.w - ch - pad, ch), "checkbox_label", str(try widget.text catch "")));
        array_push(hits, _hit(widget));
        return 0;
    }
    if k == "progress" {
        let f = _clamp(try widget.value catch 0, 0, 1);
        array_push(out, _cmd("box", id, r, "progress_track", ""));
        array_push(out, _cmd("box", id, _rect(r.x, r.y, num_floor(r.w * f), r.h), "progress_fill", ""));
        return 0;
    }
    array_push(out, _cmd("box", id, r, "unknown", k));
    return 0;
}

fn _signature(a) {
    let parts = [str(try a.title catch ""), str(try a.w catch 0), str(try a.h catch 0), str(try a.focus catch "")];
    let i = 0;
    while i < len(a.widgets) {
        let it = a.widgets[i];
        array_push(parts, str(try it.kind catch "") + ":" + str(try it.id catch "") + ":" + str(try it.x catch 0) + "," + str(try it.y catch 0) + "," + str(try it.w catch 0) + "," + str(try it.h catch 0) + ":" + str(try it.text catch "") + ":" + str(try it.value catch "") + ":" + str(try it.checked catch ""));
        i = i + 1;
    }
    return str_join(parts, "|");
}

fn plan(a, cw, ch, pad) {
    let commands = [];
    let hits = [];
    let i = 0;
    while i < len(a.widgets) {
        _render_widget(commands, hits, a.widgets[i], cw, ch, pad);
        i = i + 1;
    }
    return map{
        format: "pblang.micro_gui.plan.v1",
        commands: commands,
        hits: hits,
        command_count: len(commands),
        hit_count: len(hits),
        signature: _signature(a)
    };
}

fn hit_test(a, x, y) {
    let found = nil;
    let i = 0;
    while i < len(a.widgets) {
        let w = a.widgets[i];
        let k = str(try w.kind catch "");
        if k != "label" and k != "spacer" and k != "progress" {
            if x >= w.x and x < w.x + w.w and y >= w.y and y < w.y + w.h { found = w; }
        }
        i = i + 1;
    }
    return found;
}

fn handle_click(a, x, y) {
    let w = hit_test(a, x, y);
    a.last_action = "";
    if w == nil {
        a.focus = "";
        a.dirty = true;
        return nil;
    }
    let id = str(try w.id catch "");
    let k = str(try w.kind catch "");
    if k == "field" { a.focus = id; }
    else { a.focus = ""; }
    if k == "checkbox" { w.checked = not (try w.checked catch false); }
    a.last_action = id;
    a.dirty = true;
    return map{ type: "click", id: id, kind: k };
}

fn handle_key(a, key) {
    if (try a.focus catch "") == "" { return nil; }
    let i = 0;
    while i < len(a.widgets) {
        let w = a.widgets[i];
        if str(try w.id catch "") == a.focus and str(try w.kind catch "") == "field" {
            if key == "Backspace" {
                let v = str(try w.value catch "");
                if len(v) > 0 { w.value = str_slice(v, 0, len(v) - 1); }
            } else if len(str(key)) == 1 {
                w.value = str(try w.value catch "") + str(key);
            }
            a.dirty = true;
            return map{ type: "input", id: a.focus, key: key };
        }
        i = i + 1;
    }
    return nil;
}

fn should_replan(a, previous_signature) {
    return (try a.dirty catch true) or _signature(a) != previous_signature;
}

export app, label, button, field, checkbox, progress, spacer, add, layout_column, plan, hit_test, handle_click, handle_key, should_replan;
