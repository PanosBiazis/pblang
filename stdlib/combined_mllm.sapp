// stdlib/combined_mllm.sapp — wire BOTH pbAI brains + a live local model into ONE multi-LLM.
//
// This is the turnkey combined MLLM: the canonical stdlib classifier is the native model, the
// standalone stdlib/ai/pbai project brain joins as a weighted voter, and (when a daemon is up)
// a live ollama model votes too — all through the single shared engine (stdlib/pbai_ensemble),
// with confidence-weighted + adaptive + cached + parallel voting.
//
//   let mllm = import("stdlib/combined_mllm.sapp");
//   mllm.wire();                                   // native + project brain + ollama, adaptive+parallel
//   mllm.decide("find the bug in this function");  // {intent, confidence, escalate, ...}
//   mllm.record_outcome("bugs");                   // teach the ensemble which model was right
//
// The project brain is heavy to load; import once and reuse. Loading this module co-imports it.

let ENS     = import("stdlib:pbai_ensemble.sapp");           // the shared MLLM engine
let PRIMARY = import("stdlib/pbai.sapp");                    // canonical classifier -> native
let SECOND  = import("stdlib/ai/pbai/stdlib/pbai.sapp");     // project brain -> a voter

// wire(opts) — (re)configure the combined ensemble. opts (all optional):
//   project_weight (2), ollama_weight (2), use_ollama (true), adaptive (true), parallel (true),
//   ollama_model (nil = auto-pick a local model).
// Returns {native, models, ollama, adaptive, parallel}.
fn wire(opts = nil) {
    let o = opts;
    if o == nil { o = map{}; }
    let pw = 2;   if map_has(o, "project_weight") { pw = o.project_weight; }
    let ow = 2;   if map_has(o, "ollama_weight")  { ow = o.ollama_weight; }
    let want_oll = true; if map_has(o, "use_ollama") { want_oll = o.use_ollama; }
    let adaptive = true; if map_has(o, "adaptive")   { adaptive = o.adaptive; }
    let parallel = true; if map_has(o, "parallel")   { parallel = o.parallel; }
    let omodel = nil;    if map_has(o, "ollama_model") { omodel = o.ollama_model; }

    ENS.clear_voters();
    ENS.clear_native_cache();
    ENS.configure(PRIMARY.classify_scores, PRIMARY.intents());   // canonical brain = native model
    ENS.register_model("pbai-project", SECOND.classify_scores, pw);  // project brain = weighted voter

    let ollama = false;
    if want_oll == true { ollama = ENS.use_ollama(omodel, ow); }

    ENS.set_adaptive(adaptive);
    ENS.set_parallel(parallel);
    // answer synthesis: the ensemble decides, the canonical brain's grounded skill for
    // the decided intent writes the full text answer (imports may have left the last-
    // imported brain as responder — wire() pins it back to the canonical one).
    ENS.set_responder(PRIMARY.respond_as);
    return map{ native: "pbai-canonical", models: ENS.voters(), ollama: ollama,
        adaptive: adaptive, parallel: parallel };
}

// ── the combined decision surface (delegates to the wired shared engine) ─────────────────
fn classify(prompt)              { return ENS.ensemble(prompt); }
fn decide(prompt, threshold = 0.6) { return ENS.ensemble_decide(prompt, threshold); }
fn detail(prompt)                { return ENS.ensemble_detail(prompt); }
fn confidence(prompt)            { return ENS.ensemble_confidence(prompt); }
fn batch(prompts, threshold = 0.6) { return ENS.ensemble_batch(prompts, threshold); }
// feedback + learning
fn record_outcome(true_intent)   { return ENS.record_outcome(true_intent); }
fn evaluate(examples)            { return ENS.evaluate(examples); }
fn calibrate(examples)           { return ENS.calibrate(examples); }
fn calibration_report(examples, nbins = 5) { return ENS.calibration_report(examples, nbins); }
fn tune_weights(examples, opts = nil) { return ENS.tune_weights(examples, opts); }
fn set_routing(on)               { return ENS.set_routing(on); }
fn set_voter_weight(name, w)     { return ENS.set_voter_weight(name, w); }
fn reliability_for(name, intent) { return ENS.reliability_for(name, intent); }
fn reliability(name)             { return ENS.reliability(name); }
// full answers + self-selecting decision mode
fn answer(prompt, threshold = 0.6) { return ENS.answer(prompt, threshold); }
fn auto_configure(examples)      { return ENS.auto_configure(examples); }
fn set_responder(f)              { return ENS.set_responder(f); }
fn set_fusion(mode)              { return ENS.set_fusion(mode); }
fn explain_decision(prompt, threshold = 0.6) { return ENS.explain_decision(prompt, threshold); }
fn explain_line(prompt, threshold = 0.6) { return ENS.explain_line(prompt, threshold); }
fn uncertainty(prompt) { return ENS.uncertainty(prompt); }
fn decide_ex(prompt, ct = 0.6, ut = 0.7) { return ENS.decide_ex(prompt, ct, ut); }
fn save_stats(path)              { return ENS.save_stats(path); }
fn load_stats(path)              { return ENS.load_stats(path); }
// escape hatches: the raw engine + the two brains for advanced wiring
fn engine()  { return ENS; }
fn primary() { return PRIMARY; }
fn project() { return SECOND; }

export wire, classify, decide, detail, confidence, batch;
export record_outcome, reliability, save_stats, load_stats, evaluate, calibrate;
export tune_weights, set_routing, set_voter_weight, reliability_for, calibration_report;
export answer, auto_configure, set_responder, set_fusion, explain_decision, explain_line, uncertainty, decide_ex;
export engine, primary, project;
