fn create_theme(name_or_spec) {
    if is_string(name_or_spec) {
        if map_has(THEMES, name_or_spec) {
            return THEMES[name_or_spec];
        }
        return THEMES.dark_obsidian;
    }
    if is_map(name_or_spec) {
        let base_name = _get(name_or_spec, "base", "dark_obsidian");
        let base_t = _get(THEMES, base_name, THEMES.dark_obsidian);
        let merged_cols = map{};
        let bks = map_keys(base_t.colors);
        let i = 0;
        while i < len(bks) {
            let k = bks[i];
            merged_cols[k] = base_t.colors[k];
            i = i + 1;
        }
        let custom_cols = _get(name_or_spec, "colors", map{});
        let cks = map_keys(custom_cols);
        let j = 0;
        while j < len(cks) {
            let ck = cks[j];
            merged_cols[ck] = custom_cols[ck];
            j = j + 1;
        }
        return _finalize_theme(map{
            name: _get(name_or_spec, "name", "custom_enterprise"),
            is_dark: _get(name_or_spec, "is_dark", base_t.is_dark),
            colors: merged_cols,
            radius_px: _get(name_or_spec, "radius_px", base_t.radius_px)
        });
    }
    return THEMES.dark_obsidian;
}

// ============================================================================
// 2. Animation & Layout Physics (`spring_animate`, `cubic_bezier_eval`, `compute_flex_dock_layout`)
// ============================================================================

// Analytical Damped Harmonic Oscillator: m*x'' + c*x' + k*(x - target) = 0
fn spring_animate(x0, target_val, v0 = 0.0, mass = 1.0, stiffness = 180.0, damping = 18.0, dt = 0.016667) {
    let m = max(0.0001, mass);
    let k = max(0.0001, stiffness);
    let c = max(0.0, damping);
    let disp0 = x0 - target_val;
    let omega0 = sqrt(k / m);
    let zeta = c / (2.0 * sqrt(k * m));

    let disp = 0.0;
    let vel = 0.0;

    if zeta < 0.9999 {
        // Underdamped
        let omega_d = omega0 * sqrt(1.0 - zeta * zeta);
        let env = num_exp(-zeta * omega0 * dt);
        let coeff_b = (v0 + zeta * omega0 * disp0) / omega_d;
        let cos_wt = cos(omega_d * dt);
        let sin_wt = sin(omega_d * dt);
        disp = env * (disp0 * cos_wt + coeff_b * sin_wt);
        vel = env * (
            (coeff_b * omega_d - disp0 * zeta * omega0) * cos_wt -
            (disp0 * omega_d + coeff_b * zeta * omega0) * sin_wt
        );
    } elif zeta <= 1.0001 {
        // Critically damped
        let env_c = num_exp(-omega0 * dt);
        let c1 = disp0;
        let c2 = v0 + omega0 * disp0;
        disp = (c1 + c2 * dt) * env_c;
        vel = (c2 - omega0 * (c1 + c2 * dt)) * env_c;
    } else {
        // Overdamped
        let rad = sqrt(zeta * zeta - 1.0);
        let r1 = -omega0 * (zeta - rad);
        let r2 = -omega0 * (zeta + rad);
        let c2_o = (v0 - r1 * disp0) / (r2 - r1);
        let c1_o = disp0 - c2_o;
        let e1 = num_exp(r1 * dt);
        let e2 = num_exp(r2 * dt);
        disp = c1_o * e1 + c2_o * e2;
        vel = c1_o * r1 * e1 + c2_o * r2 * e2;
    }

    let pos = target_val + disp;
    let settled = abs(disp) < 0.0005 and abs(vel) < 0.005;
    if settled {
        pos = target_val;
        vel = 0.0;
    }
    return map{
        position: pos,
        velocity: vel,
        settled: settled,
        zeta: zeta,
        omega0: omega0
    };
}

fn _bezier_coord(t, p1, p2) {
    let u = 1.0 - t;
    return 3.0 * u * u * t * p1 + 3.0 * u * t * t * p2 + t * t * t;
}

fn _bezier_deriv(t, p1, p2) {
    let u = 1.0 - t;
    return 3.0 * u * u * p1 + 6.0 * u * t * (p2 - p1) + 3.0 * t * t * (1.0 - p2);
}

// Exact CSS cubic-bezier(x1, y1, x2, y2) curve evaluator via Newton-Raphson + bisection
fn cubic_bezier_eval(x1, y1, x2, y2, progress) {
    let x = _clamp(progress, 0.0, 1.0);
    if x <= 0.0 { return 0.0; }
    if x >= 1.0 { return 1.0; }

    let t = x;
    let iter = 0;
    while iter < 8 {
        let err = _bezier_coord(t, x1, x2) - x;
        if abs(err) < 1e-7 { break; }
        let dx = _bezier_deriv(t, x1, x2);
        if abs(dx) < 1e-6 { break; }
        t = _clamp(t - err / dx, 0.0, 1.0);
        iter = iter + 1;
    }

    // Bisection polish if needed
    if abs(_bezier_coord(t, x1, x2) - x) > 1e-5 {
        let lo = 0.0;
        let hi = 1.0;
        t = x;
        let bi = 0;
        while bi < 14 {
            let cur = _bezier_coord(t, x1, x2);
            if abs(cur - x) < 1e-7 { break; }
            if x > cur { lo = t; } else { hi = t; }
            t = 0.5 * (lo + hi);
            bi = bi + 1;
        }
    }

    return _bezier_coord(t, y1, y2);
}

// Pixel-exact Flexbox & Dock Layout Solver (`{ x, y, w, h }` on every UI node)
fn _layout_subtree(nd, rx, ry, rw, rh, scale) {
    let props = _get(nd, "props", map{});
    let pad = _get(props, "padding", 8) * scale;
    nd.layout = map{
        x: round(rx),
        y: round(ry),
        w: max(0, round(rw)),
        h: max(0, round(rh))
    };

    let kids = _get(nd, "children", []);
    let n = len(kids);
    if n == 0 { return nd; }

    let mode = _get(props, "layout_mode", "");
    if mode == "" {
        if nd.kind == "AppShell" or nd.kind == "DockSplitPane" { mode = "dock"; }
        elif nd.kind == "RibbonToolbar" or nd.kind == "Menubar" or nd.kind == "TabBar" or nd.kind == "Breadcrumb" or nd.kind == "Pagination" or nd.kind == "StatusBar" { mode = "row"; }
        else { mode = _get(props, "direction", "column"); }
    }

    let ix = rx + pad;
    let iy = ry + pad;
    let iw = max(0.0, rw - 2.0 * pad);
    let ih = max(0.0, rh - 2.0 * pad);
    let gap = _get(props, "gap", 8) * scale;

    if mode == "dock" {
        let cx = ix;
        let cy = iy;
        let cw = iw;
        let ch = ih;
        let i = 0;
        while i < n {
            let child = kids[i];
            let cp = _get(child, "props", map{});
            let dock_pos = _get(cp, "dock", "fill");
            let req_w = _get(cp, "width", 220) * scale;
            let req_h = _get(cp, "height", 44) * scale;
            if dock_pos == "top" {
                let hh = min(ch, req_h);
                _layout_subtree(child, cx, cy, cw, hh, scale);
                cy = cy + hh + gap;
                ch = max(0.0, ch - hh - gap);
            } elif dock_pos == "bottom" {
                let hh2 = min(ch, req_h);
                _layout_subtree(child, cx, cy + ch - hh2, cw, hh2, scale);
                ch = max(0.0, ch - hh2 - gap);
            } elif dock_pos == "left" {
                let ww = min(cw, req_w);
                _layout_subtree(child, cx, cy, ww, ch, scale);
                cx = cx + ww + gap;
                cw = max(0.0, cw - ww - gap);
            } elif dock_pos == "right" {
                let ww2 = min(cw, req_w);
                _layout_subtree(child, cx + cw - ww2, cy, ww2, ch, scale);
                cw = max(0.0, cw - ww2 - gap);
            } else {
                _layout_subtree(child, cx, cy, cw, ch, scale);
            }
            i = i + 1;
        }
        return nd;
    }

    let is_row = (mode == "row");
    let total_gap = gap * max(0, n - 1);
    let fixed_sum = 0.0;
    let flex_sum = 0.0;

    let i = 0;
    while i < n {
        let cp = _get(kids[i], "props", map{});
        let flx = _get(cp, "flex", 0.0);
        if flx > 0.0 {
            flex_sum = flex_sum + flx;
        } else {
            if is_row {
                fixed_sum = fixed_sum + _get(cp, "width", 120) * scale;
            } else {
                fixed_sum = fixed_sum + _get(cp, "height", 40) * scale;
            }
        }
        i = i + 1;
    }

    let main_avail = ih;
    if is_row { main_avail = iw; }
    let rem = max(0.0, main_avail - fixed_sum - total_gap);
    let cursor = iy;
    if is_row { cursor = ix; }

    let j = 0;
    while j < n {
        let child = kids[j];
        let cp = _get(child, "props", map{});
        let flx = _get(cp, "flex", 0.0);
        if is_row {
            let cw = _get(cp, "width", 120) * scale;
            if flx > 0.0 and flex_sum > 0.0 {
                cw = rem * (flx / flex_sum);
            } elif flex_sum == 0.0 and not map_has(cp, "width") {
                cw = max(40.0, (iw - total_gap) / n);
            }
            let ch = _get(cp, "height", ih);
            if map_has(cp, "height") { ch = min(ih, cp.height * scale); }
            _layout_subtree(child, cursor, iy, cw, ch, scale);
            cursor = cursor + cw + gap;
        } else {
            let ch2 = _get(cp, "height", 40) * scale;
            if flx > 0.0 and flex_sum > 0.0 {
                ch2 = rem * (flx / flex_sum);
            }
            let cw2 = iw;
            if map_has(cp, "width") { cw2 = min(iw, cp.width * scale); }
            _layout_subtree(child, ix, cursor, cw2, ch2, scale);
            cursor = cursor + ch2 + gap;
        }
        j = j + 1;
    }
    return nd;
}

fn compute_flex_dock_layout(root_node, viewport_w = 1280, viewport_h = 800, dpi_scale = 1.0) {
    return _layout_subtree(root_node, 0.0, 0.0, viewport_w * dpi_scale, viewport_h * dpi_scale, dpi_scale);
}

// ============================================================================
// 3. 68-Component Enterprise Catalog (`COMPONENT_CATALOG`, `ui_node`, Builders)
// ============================================================================

fn _cat(category, role_str, interactive, default_h) {
    return map{
        category: category,
        aria_role: role_str,
        interactive: interactive,
        default_height: default_h
    };
}

