    RibbonToolbar:    _cat("nav", "toolbar", true, 56),
    CommandPalette:   _cat("nav", "dialog", true, 280),
    Menubar:          _cat("nav", "menubar", true, 36),
    ContextMenu:      _cat("nav", "menu", true, 160),
    SidebarNav:       _cat("nav", "navigation", true, 480),
    Breadcrumb:       _cat("nav", "navigation", false, 32),
    Pagination:       _cat("nav", "navigation", true, 38),
    Stepper:          _cat("nav", "list", true, 52),
    StatusBar:        _cat("nav", "status", false, 28),

    // Overlays, Feedback & Display Primitives (15)
    ModalDialog:      _cat("overlay", "dialog", true, 260),
    Drawer:           _cat("overlay", "dialog", true, 400),
    Popover:          _cat("overlay", "dialog", true, 140),
    Tooltip:          _cat("overlay", "tooltip", false, 30),
    ToastStack:       _cat("feedback", "status", false, 72),
    AlertBanner:      _cat("feedback", "alert", false, 52),
    Badge:            _cat("display", "status", false, 24),
    Chip:             _cat("display", "button", true, 28),
    Avatar:           _cat("display", "img", false, 40),
    ProgressBar:      _cat("feedback", "progressbar", false, 24),
    CircularSpinner:  _cat("feedback", "progressbar", false, 36),
    Skeleton:         _cat("feedback", "status", false, 48),
    Timeline:         _cat("display", "list", false, 180),
    EmptyState:       _cat("display", "region", false, 160),
    VirtualList:      _cat("data", "listbox", true, 240)
};

let _UID_SEQ = [0];

fn _next_uid(prefix) {
    _UID_SEQ[0] = _UID_SEQ[0] + 1;
    return prefix + "_" + str(_UID_SEQ[0]);
}

fn ui_node(kind, props = nil, children = nil) {
    props = _opts(props);
    if children == nil { children = []; }
    let meta = _get(COMPONENT_CATALOG, kind, _cat("custom", "region", false, 40));
    let id_str = _get(props, "id", _next_uid(str_lower(kind)));
    let role_str = _get(props, "role", meta.aria_role);
    let interactive = _get(props, "interactive", meta.interactive);
    let disabled = _get(props, "disabled", false);

    let tab_idx = _get(props, "tabindex", -1);
    if interactive and not disabled and not map_has(props, "tabindex") {
        tab_idx = 0;
    }

    if not map_has(props, "height") {
        props.height = meta.default_height;
    }

    let aria_lbl = _get(props, "aria_label", _get(props, "title", _get(props, "text", kind + " " + id_str)));

    return map{
        format: "pblang.enterprise_ui.node.v4",
        id: id_str,
        kind: kind,
        category: meta.category,
        role: role_str,
        interactive: interactive,
        disabled: disabled,
        tabindex: tab_idx,
        aria_label: str(aria_lbl),
        props: props,
        children: children,
        layout: map{ x: 0, y: 0, w: 0, h: meta.default_height }
    };
}

// ============================================================================
// Virtualized 1,000,000-Row Enterprise DataGrid (`create_virtual_datagrid`)
// ============================================================================

fn _compare_vals(va, vb, dir_str) {
    let res = 0;
    if is_number(va) and is_number(vb) {
        if va < vb { res = -1; }
        elif va > vb { res = 1; }
    } else {
        let sa = str(va);
        let sb = str(vb);
        if sa < sb { res = -1; }
        elif sa > sb { res = 1; }
    }
    if str_lower(str(dir_str)) == "desc" {
        return -res;
    }
    return res;
}

fn _sort_row_slice(rows, sort_specs) {
    if sort_specs == nil or len(sort_specs) == 0 { return rows; }
    let out = [];
    let i = 0;
    while i < len(rows) {
        array_push(out, rows[i]);
        i = i + 1;
    }
    let n = len(out);
    let a = 1;
    while a < n {
        let key_row = out[a];
        let b = a - 1;
        while b >= 0 {
            let cmp = 0;
            let si = 0;
            while si < len(sort_specs) and cmp == 0 {
                let sp = sort_specs[si];
                let col_k = sp.field;
                let dir_s = _get(sp, "dir", "asc");
                cmp = _compare_vals(_get(out[b], col_k, ""), _get(key_row, col_k, ""), dir_s);
                si = si + 1;
            }
            if cmp > 0 {
                out[b + 1] = out[b];
                b = b - 1;
            } else {
                break;
            }
        }
        out[b + 1] = key_row;
        a = a + 1;
    }
    return out;
}

// O(visible_rows) Virtualized DataGrid supporting 1,000,000+ rows in < 5 ms!
fn create_virtual_datagrid(total_rows, row_fn_or_data, columns, viewport_state = nil) {
    viewport_state = _opts(viewport_state);
    let scroll_top = max(0.0, _get(viewport_state, "scroll_top", 0.0));
    let viewport_h = max(64.0, _get(viewport_state, "viewport_height", 480.0));
    let row_h = max(18.0, _get(viewport_state, "row_height", 32.0));
    let overscan = max(0, floor(_get(viewport_state, "overscan", 4)));

    let first_vis = floor(scroll_top / row_h);
    let vis_count = ceil(viewport_h / row_h);
    let start_row = max(0, first_vis - overscan);
    let end_row = min(total_rows, first_vis + vis_count + overscan);

    let filter_fn = _get(viewport_state, "filter_fn", nil);
    let sort_specs = _get(viewport_state, "sort_specs", []);
    let selected_rows = _get(viewport_state, "selected_rows", []);
    let summary_footer = _get(viewport_state, "summary_footer", nil);

    let sel_set = map{};
    let si = 0;
    while si < len(selected_rows) {
        sel_set[str(selected_rows[si])] = true;
        si = si + 1;
    }

    // Evaluate ONLY [start_row, end_row) window (~25-30 rows even for total_rows == 1,000,000!)
    let visible_rows = [];
    let is_gen = is_fn(row_fn_or_data);
    let r = start_row;
    while r < end_row {
        let row_obj = nil;
        if is_gen {
            row_obj = row_fn_or_data(r);
        } elif is_array(row_fn_or_data) and r < len(row_fn_or_data) {
            row_obj = row_fn_or_data[r];
        } else {
            row_obj = map{ _row_index: r };
        }
        row_obj._virtual_index = r;
        row_obj._selected = _get(sel_set, str(r), false);
        if filter_fn == nil or filter_fn(row_obj) {
            array_push(visible_rows, row_obj);
        }
        r = r + 1;
    }

    if len(sort_specs) > 0 {
        visible_rows = _sort_row_slice(visible_rows, sort_specs);
    }

    let top_spacer_px = start_row * row_h;
    let bottom_spacer_px = max(0.0, (total_rows - end_row) * row_h);

    return ui_node("VirtualDataGrid", map{
        id: _get(viewport_state, "id", _next_uid("vgrid")),
        aria_label: _get(viewport_state, "aria_label", "Enterprise Virtualized DataGrid"),
        total_rows: total_rows,
        columns: columns,
        row_source: row_fn_or_data,
        row_height: row_h,
        viewport_height: viewport_h,
        scroll_top: scroll_top,
        overscan: overscan,
        start_row: start_row,
        end_row: end_row,
        rendered_row_count: len(visible_rows),
        visible_rows: visible_rows,
        top_spacer_px: top_spacer_px,
        bottom_spacer_px: bottom_spacer_px,
        sort_specs: sort_specs,
        selected_rows: selected_rows,
        summary_footer: summary_footer,
        aria_rowcount: total_rows,
        aria_colcount: len(columns),
        height: viewport_h,
        flex: _get(viewport_state, "flex", 1.0)
    }, []);
}

fn _csv_cell(v) {
    let s = str(v);
    if str_contains(s, ",") or str_contains(s, "\"") or str_contains(s, "\n") {
        return "\"" + str_replace_all(s, "\"", "\"\"") + "\"";
    }
    return s;
}

fn export_datagrid_csv(grid_node, max_export_rows = 100) {
    let p = grid_node.props;
    let cols = p.columns;
    let hdr = [];
    let ci = 0;
    while ci < len(cols) {
        array_push(hdr, _csv_cell(_get(cols[ci], "header", cols[ci].field)));
        ci = ci + 1;
    }
    let lines = [str_join(hdr, ",")];
    let limit_n = min(p.total_rows, max_export_rows);
    let src = p.row_source;
    let is_gen = is_fn(src);
    let r = 0;
    while r < limit_n {
        let row_d = map{};
        if is_gen { row_d = src(r); }
        elif is_array(src) and r < len(src) { row_d = src[r]; }
        let cells = [];
        let k = 0;
        while k < len(cols) {
            let f = cols[k].field;
            array_push(cells, _csv_cell(_get(row_d, f, "")));
            k = k + 1;
        }
        array_push(lines, str_join(cells, ","));
        r = r + 1;
    }
    return str_join(lines, "\n") + "\n";
}

// Ergonomic Component Constructors
fn ui_app_shell(title_str, children, opts = nil) {
    opts = _opts(opts);
    opts.title = title_str;
    opts.aria_label = _get(opts, "aria_label", title_str);
    return ui_node("AppShell", opts, children);
}

fn ui_flex(direction_str, children, opts = nil) {
    opts = _opts(opts);
    opts.direction = direction_str;
    opts.layout_mode = direction_str;
    return ui_node("FlexBox", opts, children);
}

fn ui_button(text_str, opts = nil) {
    opts = _opts(opts);
    opts.text = text_str;
    opts.aria_label = _get(opts, "aria_label", text_str);
    return ui_node("Button", opts, []);
}

fn ui_kpi_card(title_str, value_str, delta_str = "", opts = nil) {
    opts = _opts(opts);
    opts.title = title_str;
    opts.value = value_str;
    opts.delta = delta_str;
    opts.aria_label = _get(opts, "aria_label", title_str + ": " + value_str);
    return ui_node("KPIStatCard", opts, []);
}

fn list_registered_components() {
    return array_sort(map_keys(COMPONENT_CATALOG));
}

// ============================================================================
// 4. Dual-Target Renderers: WAI-ARIA 1.2 Web HTML5 & Native Desktop (`gfx*`)
// ============================================================================

fn _render_svg_series_chart(kind, p, theme) {
    let series = _get(p, "series", [12, 28, 22, 45, 38, 64, 58, 82]);
    let n = len(series);
    if n == 0 { series = [0, 1]; n = 2; }
    let w = 360.0;
    let h = 130.0;
    if kind == "Sparkline" { w = 140.0; h = 32.0; }

    let vmin = series[0];
    let vmax = series[0];
    let i = 1;
    while i < n {
        if series[i] < vmin { vmin = series[i]; }
        if series[i] > vmax { vmax = series[i]; }
        i = i + 1;
    }
    let span = max(vmax - vmin, 0.0001);
    let acc = theme.colors.accent;
    let suc = theme.colors.success;
    let dng = theme.colors.danger;

    if kind == "BarChart" {
        let bars = [];
        let bw = (w - 24.0) / max(1, n);
        let k = 0;
        while k < n {
            let bh = ((series[k] - vmin) / span) * (h - 28.0) + 6.0;
            let bx = 12.0 + k * bw + 2.0;
            let by = h - 10.0 - bh;
            array_push(bars, "<rect x=\"" + str(round(bx)) + "\" y=\"" + str(round(by)) + "\" width=\"" + str(max(2, round(bw - 4.0))) + "\" height=\"" + str(round(bh)) + "\" rx=\"3\" fill=\"" + acc + "\"/>");
            k = k + 1;
        }
        return "<svg viewBox=\"0 0 360 130\" width=\"100%\" height=\"130\" aria-hidden=\"true\">" + str_join(bars, "") + "</svg>";
    }

    if kind == "PieDonutChart" {
        let total = 0.0;
        let k = 0;
        while k < n { total = total + abs(series[k]); k = k + 1; }
        if total <= 0.0 { total = 1.0; }
        let pct0 = round((abs(series[0]) / total) * 100.0);
        return "<svg viewBox=\"0 0 140 130\" width=\"140\" height=\"130\" aria-hidden=\"true\"><circle cx=\"70\" cy=\"65\" r=\"46\" fill=\"none\" stroke=\"" + theme.colors.surface_alt + "\" stroke-width=\"16\"/><circle cx=\"70\" cy=\"65\" r=\"46\" fill=\"none\" stroke=\"" + acc + "\" stroke-width=\"16\" stroke-dasharray=\"" + str(round(pct0 * 2.89)) + " 290\" transform=\"rotate(-90 70 65)\"/><text x=\"70\" y=\"70\" text-anchor=\"middle\" fill=\"" + theme.colors.text_primary + "\" font-size=\"14\" font-weight=\"700\">" + str(pct0) + "%</text></svg>";
    }

    if kind == "CandlestickChart" {
        let candles = _get(p, "candles", [
            map{ o: 100, h: 112, l: 96, c: 108 },
            map{ o: 108, h: 115, l: 101, c: 103 },
            map{ o: 103, h: 118, l: 102, c: 116 },
            map{ o: 116, h: 124, l: 110, c: 121 }
        ]);
        let cn = max(1, len(candles));
        let cw = (w - 24.0) / cn;
        let els = [];
        let ci = 0;
        while ci < len(candles) {
            let cd = candles[ci];
            let bull = cd.c >= cd.o;
            let col = dng;
            if bull { col = suc; }
            let cx = 12.0 + ci * cw + cw * 0.5;
            let y_hi = h - 14.0 - ((cd.h - 90.0) / 40.0) * (h - 28.0);
            let y_lo = h - 14.0 - ((cd.l - 90.0) / 40.0) * (h - 28.0);
            let y_o = h - 14.0 - ((cd.o - 90.0) / 40.0) * (h - 28.0);
            let y_c = h - 14.0 - ((cd.c - 90.0) / 40.0) * (h - 28.0);
            let btop = min(y_o, y_c);
            let bht = max(3.0, abs(y_c - y_o));
            array_push(els, "<line x1=\"" + str(round(cx)) + "\" y1=\"" + str(round(y_hi)) + "\" x2=\"" + str(round(cx)) + "\" y2=\"" + str(round(y_lo)) + "\" stroke=\"" + col + "\" stroke-width=\"2\"/>");
            array_push(els, "<rect x=\"" + str(round(cx - cw * 0.25)) + "\" y=\"" + str(round(btop)) + "\" width=\"" + str(max(4, round(cw * 0.5))) + "\" height=\"" + str(round(bht)) + "\" fill=\"" + col + "\"/>");
            ci = ci + 1;
        }
        return "<svg viewBox=\"0 0 360 130\" width=\"100%\" height=\"130\" aria-hidden=\"true\">" + str_join(els, "") + "</svg>";
    }

    if kind == "Heatmap" {
        let cells = [];
        let r = 0;
        while r < 4 {
            let c = 0;
            while c < 8 {
                let v = ((r * 8 + c) % 7) / 6.0;
                let op = 0.2 + 0.8 * v;
                array_push(cells, "<rect x=\"" + str(10 + c * 42) + "\" y=\"" + str(10 + r * 28) + "\" width=\"38\" height=\"24\" rx=\"3\" fill=\"" + acc + "\" fill-opacity=\"" + str(round(op * 100.0) / 100.0) + "\"/>");
                c = c + 1;
            }
            r = r + 1;
        }
        return "<svg viewBox=\"0 0 360 130\" width=\"100%\" height=\"130\" aria-hidden=\"true\">" + str_join(cells, "") + "</svg>";
    }

    if kind == "Gauge" {
        let gval = _clamp(_get(p, "value", 76), 0, 100);
        return "<svg viewBox=\"0 0 160 100\" width=\"160\" height=\"100\" aria-hidden=\"true\"><path d=\"M20,85 A60,60 0 0,1 140,85\" fill=\"none\" stroke=\"" + theme.colors.surface_alt + "\" stroke-width=\"12\" stroke-linecap=\"round\"/><path d=\"M20,85 A60,60 0 0,1 140,85\" fill=\"none\" stroke=\"" + acc + "\" stroke-width=\"12\" stroke-linecap=\"round\" stroke-dasharray=\"" + str(round(gval * 1.88)) + " 200\"/><text x=\"80\" y=\"78\" text-anchor=\"middle\" fill=\"" + theme.colors.text_primary + "\" font-size=\"18\" font-weight=\"700\">" + str(gval) + "%</text></svg>";
    }

    // LineChart, AreaChart, Sparkline
    let pts = [];
    let k = 0;
    while k < n {
        let px = 8.0 + (k / max(1, n - 1)) * (w - 16.0);
        let py = h - 8.0 - ((series[k] - vmin) / span) * (h - 16.0);
        array_push(pts, str(round(px * 10.0) / 10.0) + "," + str(round(py * 10.0) / 10.0));
        k = k + 1;
    }
    let poly = str_join(pts, " ");
    let area_el = "";
    if kind == "AreaChart" {
        area_el = "<polygon points=\"8," + str(round(h - 8.0)) + " " + poly + " " + str(round(w - 8.0)) + "," + str(round(h - 8.0)) + "\" fill=\"" + acc + "\" fill-opacity=\"0.22\"/>";
    }
    return "<svg viewBox=\"0 0 " + str(round(w)) + " " + str(round(h)) + "\" width=\"100%\" height=\"" + str(round(h)) + "\" aria-hidden=\"true\">" + area_el + "<polyline fill=\"none\" stroke=\"" + acc + "\" stroke-width=\"2.2\" points=\"" + poly + "\"/></svg>";
}

fn _render_datagrid_html(nd, theme) {
    let p = nd.props;
    let cols = p.columns;
    let rows = p.visible_rows;
    let id_esc = html_escape(nd.id);
    let lbl_esc = html_escape(nd.aria_label);

    let ths = [];
    let ci = 0;
    while ci < len(cols) {
        let col = cols[ci];
        let pin_cls = "";
        if _get(col, "pinned", "") == "left" { pin_cls = " class=\"pinned-col\""; }
        let aria_sort = _get(col, "aria_sort", "none");
        array_push(ths, "<th role=\"columnheader\" scope=\"col\" aria-colindex=\"" + str(ci + 1) + "\" aria-sort=\"" + html_escape(aria_sort) + "\"" + pin_cls + ">" + html_escape(_get(col, "header", col.field)) + "</th>");
        ci = ci + 1;
    }

    let trs = [];
    if p.top_spacer_px > 0 {
        array_push(trs, "<tr aria-hidden=\"true\" style=\"height:" + str(round(p.top_spacer_px)) + "px\"><td colspan=\"" + str(len(cols)) + "\"></td></tr>");
    }

    let ri = 0;
    while ri < len(rows) {
        let r_obj = rows[ri];
        let v_idx = _get(r_obj, "_virtual_index", p.start_row + ri);
        let sel_attr = "false";
        if _get(r_obj, "_selected", false) { sel_attr = "true"; }
        let tds = [];
        let cj = 0;
        while cj < len(cols) {
            let col2 = cols[cj];
            let val_s = html_escape(_get(r_obj, col2.field, ""));
            let pcls = "";
            if _get(col2, "pinned", "") == "left" { pcls = " class=\"pinned-col\""; }
            array_push(tds, "<td role=\"gridcell\" aria-colindex=\"" + str(cj + 1) + "\"" + pcls + ">" + val_s + "</td>");
            cj = cj + 1;
        }
        array_push(trs, "<tr role=\"row\" aria-rowindex=\"" + str(v_idx + 1) + "\" aria-selected=\"" + sel_attr + "\" tabindex=\"-1\" style=\"height:" + str(round(p.row_height)) + "px\">" + str_join(tds, "") + "</tr>");
        ri = ri + 1;
    }

    if p.bottom_spacer_px > 0 {
        array_push(trs, "<tr aria-hidden=\"true\" style=\"height:" + str(round(p.bottom_spacer_px)) + "px\"><td colspan=\"" + str(len(cols)) + "\"></td></tr>");
    }

    let tfoot_html = "";
    if p.summary_footer != nil {
        let fcells = [];
        let fk = 0;
        while fk < len(cols) {
            let cf = cols[fk].field;
            array_push(fcells, "<td role=\"gridcell\"><b>" + html_escape(_get(p.summary_footer, cf, "")) + "</b></td>");
            fk = fk + 1;
        }
        tfoot_html = "<tfoot><tr role=\"row\" aria-rowindex=\"" + str(p.total_rows + 1) + "\">" + str_join(fcells, "") + "</tr></tfoot>";
    }

    return str_join([
        "<div id=\"" + id_esc + "\" class=\"pbu-vgrid-wrap\" role=\"grid\" tabindex=\"0\" aria-label=\"" + lbl_esc + "\" aria-rowcount=\"" + str(p.total_rows) + "\" aria-colcount=\"" + str(len(cols)) + "\" style=\"max-height:" + str(round(p.viewport_height)) + "px;overflow:auto\">",
        "<div class=\"pbu-vgrid-meta\">Virtualized Window: rows <b>" + str(p.start_row) + ".." + str(p.end_row) + "</b> of <b>" + str(p.total_rows) + "</b> (" + str(p.rendered_row_count) + " DOM rows materialized)</div>",
        "<table class=\"pbu-vgrid-table\"><thead><tr role=\"row\">" + str_join(ths, "") + "</tr></thead><tbody>" + str_join(trs, "") + "</tbody>" + tfoot_html + "</table>",
        "</div>"
    ], "");
}

fn _render_node_html(nd, theme) {
    let k = nd.kind;
    let p = nd.props;
    let id_attr = " id=\"" + html_escape(nd.id) + "\"";
    let role_attr = " role=\"" + html_escape(nd.role) + "\"";
    let aria_attr = " aria-label=\"" + html_escape(nd.aria_label) + "\"";
    let tab_attr = "";
    if nd.tabindex >= 0 {
        tab_attr = " tabindex=\"" + str(nd.tabindex) + "\"";
    }
    let common_attrs = id_attr + role_attr + aria_attr + tab_attr + " data-component=\"" + html_escape(k) + "\"";

    if k == "VirtualDataGrid" {
        return _render_datagrid_html(nd, theme);
    }

    let child_html_parts = [];
    let ci = 0;
    while ci < len(nd.children) {
        array_push(child_html_parts, _render_node_html(nd.children[ci], theme));
        ci = ci + 1;
    }
    let inner_kids = str_join(child_html_parts, "");

    if k == "AppShell" or k == "FlexBox" or k == "DockSplitPane" {
        let dir_cls = "pbu-col";
        if _get(p, "direction", "") == "row" or _get(p, "layout_mode", "") == "row" { dir_cls = "pbu-row"; }
        return "<section" + common_attrs + " class=\"pbu-box " + dir_cls + "\">" + inner_kids + "</section>";
    }

    if k == "Button" or k == "IconButton" or k == "SplitButton" or k == "Chip" {
        let txt = html_escape(_get(p, "text", nd.aria_label));
        let cls = "pbu-btn";
        if _get(p, "variant", "primary") == "secondary" or k == "Chip" { cls = "pbu-btn pbu-btn-sec"; }
        return "<button type=\"button\"" + common_attrs + " class=\"" + cls + "\">" + txt + "</button>";
    }

    if k == "Input" or k == "PasswordInput" or k == "NumericUnitInput" or k == "DatePicker" or k == "TimePicker" or k == "Autocomplete" {
        let inp_type = "text";
        if k == "PasswordInput" { inp_type = "password"; }
        elif k == "NumericUnitInput" { inp_type = "number"; }
        elif k == "DatePicker" { inp_type = "date"; }
        elif k == "TimePicker" { inp_type = "time"; }
        let val_s = html_escape(_get(p, "value", ""));
        let ph_s = html_escape(_get(p, "placeholder", nd.aria_label));
        let unit_badge = "";
        if k == "NumericUnitInput" {
            unit_badge = "<span class=\"pbu-badge\">" + html_escape(_get(p, "unit", "ms")) + "</span>";
        }
        return "<div class=\"pbu-field\"><input type=\"" + inp_type + "\"" + common_attrs + " class=\"pbu-input\" value=\"" + val_s + "\" placeholder=\"" + ph_s + "\"/>" + unit_badge + "</div>";
    }

    if k == "Select" or k == "MultiSelectTags" {
        let opts_arr = _get(p, "options", ["Option A", "Option B"]);
        let opt_tags = [];
        let oi = 0;
        while oi < len(opts_arr) {
            let ov = html_escape(opts_arr[oi]);
            array_push(opt_tags, "<option value=\"" + ov + "\">" + ov + "</option>");
            oi = oi + 1;
        }
        return "<select" + common_attrs + " class=\"pbu-input\">" + str_join(opt_tags, "") + "</select>";
    }

    if k == "Checkbox" or k == "Switch" {
        let chk = "";
        if _get(p, "checked", false) { chk = " aria-checked=\"true\""; } else { chk = " aria-checked=\"false\""; }
        return "<div" + common_attrs + chk + " class=\"pbu-toggle\"><span>" + html_escape(_get(p, "text", nd.aria_label)) + "</span></div>";
    }

    if k == "Slider" or k == "RangeSlider" or k == "ProgressBar" {
        let val_n = _clamp(_get(p, "value", 50), 0, 100);
        return "<div" + common_attrs + " aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"" + str(val_n) + "\" class=\"pbu-progress\"><div class=\"pbu-progress-fill\" style=\"width:" + str(val_n) + "%\"></div></div>";
    }

    if k == "LineChart" or k == "BarChart" or k == "AreaChart" or k == "PieDonutChart" or k == "CandlestickChart" or k == "Heatmap" or k == "Sparkline" or k == "Gauge" {
        return "<figure" + common_attrs + " class=\"pbu-card\"><figcaption class=\"pbu-card-title\">" + html_escape(_get(p, "title", nd.aria_label)) + "</figcaption>" + _render_svg_series_chart(k, p, theme) + "</figure>";
    }

    if k == "KPIStatCard" {
        return "<article" + common_attrs + " class=\"pbu-card\"><div class=\"pbu-muted\">" + html_escape(_get(p, "title", "Metric")) + "</div><div class=\"pbu-kpi-val\">" + html_escape(_get(p, "value", "0")) + "</div><div class=\"pbu-accent\">" + html_escape(_get(p, "delta", "")) + "</div></article>";
    }

    if k == "TabBar" {
        let tabs = _get(p, "tabs", ["Overview", "Analytics", "Settings"]);
        let active_i = _get(p, "active_index", 0);
        let btns = [];
        let ti = 0;
        while ti < len(tabs) {
            let sel_s = "false";
            if ti == active_i { sel_s = "true"; }
            array_push(btns, "<button type=\"button\" role=\"tab\" aria-selected=\"" + sel_s + "\" tabindex=\"0\" class=\"pbu-tab\">" + html_escape(tabs[ti]) + "</button>");
            ti = ti + 1;
        }
        return "<div" + common_attrs + " class=\"pbu-tabbar\">" + str_join(btns, "") + "</div>";
    }

    if k == "ModalDialog" or k == "Drawer" or k == "CommandPalette" or k == "Popover" {
        return "<div" + common_attrs + " aria-modal=\"true\" class=\"pbu-card pbu-dialog\"><h3>" + html_escape(_get(p, "title", nd.aria_label)) + "</h3>" + inner_kids + "</div>";
    }

    if k == "ToastStack" or k == "AlertBanner" or k == "StatusBar" {
        return "<div" + common_attrs + " aria-live=\"polite\" class=\"pbu-card pbu-live\">" + html_escape(_get(p, "text", nd.aria_label)) + inner_kids + "</div>";
    }

    if k == "TreeGrid" {
        let rc = _get(p, "aria_rowcount", 10);
        let cc = _get(p, "aria_colcount", 3);
        return "<div" + common_attrs + " aria-rowcount=\"" + str(rc) + "\" aria-colcount=\"" + str(cc) + "\" class=\"pbu-card\"><div class=\"pbu-card-title\">" + html_escape(_get(p, "title", nd.aria_label)) + "</div>" + inner_kids + "</div>";
    }

    // Universal semantic rendering for all remaining catalog components (PivotTable, TreeView, PropertyGrid, KanbanBoard, RichTextEditor, CodeEditor, DiffViewer, MarkdownViewer, Accordion, RibbonToolbar, Menubar, ContextMenu, SidebarNav, Breadcrumb, Pagination, Stepper, Tooltip, Badge, Avatar, CircularSpinner, Skeleton, Timeline, EmptyState, VirtualList, RadioGroup, ColorPicker, FileDropzone, OTPInput, FormGroup)
    let body_txt = html_escape(_get(p, "text", _get(p, "title", nd.aria_label)));
    return "<div" + common_attrs + " class=\"pbu-card pbu-comp\"><span class=\"pbu-comp-label\">" + body_txt + "</span>" + inner_kids + "</div>";
}

fn render_to_web_html(app_tree, theme = nil) {
    if theme == nil { theme = THEMES.dark_obsidian; }
    let c = theme.colors;
    let doc_title = html_escape(_get(app_tree.props, "title", app_tree.aria_label));
    let body_html = _render_node_html(app_tree, theme);

    let css = str_join([
        ":root{--bg:" + c.bg + ";--surface:" + c.surface + ";--surface-alt:" + c.surface_alt + ";--border:" + c.border + ";--fg:" + c.text_primary + ";--fg-sec:" + c.text_secondary + ";--fg-muted:" + c.text_muted + ";--accent:" + c.accent + ";--btn-bg:" + c.btn_primary_bg + ";--btn-fg:" + c.btn_primary_fg + ";--radius:" + str(theme.radius_px) + "px}",
        "*{box-sizing:border-box}body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:" + theme.font_family + ";line-height:1.45}",
        ":focus-visible{outline:2px solid var(--accent);outline-offset:2px}",
        ".pbu-box{display:flex;gap:12px}.pbu-col{flex-direction:column}.pbu-row{flex-direction:row;flex-wrap:wrap;align-items:center}",
        ".pbu-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px}",
        ".pbu-card-title{font-weight:600;color:var(--fg-sec);margin-bottom:8px}.pbu-muted{color:var(--fg-muted);font-size:0.85rem}",
        ".pbu-kpi-val{font-size:1.6rem;font-weight:700;margin:4px 0}.pbu-accent{color:var(--accent);font-size:0.85rem}",
        ".pbu-btn{background:var(--btn-bg);color:var(--btn-fg);border:1px solid transparent;border-radius:var(--radius);padding:8px 14px;font-weight:600;cursor:pointer}",
        ".pbu-btn-sec{background:var(--surface-alt);color:var(--fg);border-color:var(--border)}",
        ".pbu-input{background:var(--surface-alt);color:var(--fg);border:1px solid var(--border);border-radius:var(--radius);padding:8px 10px;min-width:160px}",
        ".pbu-field{display:inline-flex;align-items:center;gap:6px}.pbu-badge{background:var(--surface-alt);color:var(--fg-sec);padding:3px 8px;border-radius:999px;font-size:0.8rem}",
        ".pbu-progress{height:10px;background:var(--surface-alt);border-radius:999px;overflow:hidden}.pbu-progress-fill{height:100%;background:var(--accent)}",
        ".pbu-tabbar{display:flex;gap:6px;border-bottom:1px solid var(--border);padding-bottom:6px}.pbu-tab{background:var(--surface-alt);color:var(--fg);border:1px solid var(--border);border-radius:var(--radius);padding:6px 12px;cursor:pointer}",
        ".pbu-vgrid-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)}.pbu-vgrid-meta{padding:8px 12px;font-size:0.82rem;color:var(--fg-muted);border-bottom:1px solid var(--border)}",
        ".pbu-vgrid-table{width:100%;border-collapse:collapse;font-size:0.88rem}.pbu-vgrid-table th,.pbu-vgrid-table td{padding:6px 10px;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap}",
        ".pbu-vgrid-table thead th{position:sticky;top:0;background:var(--surface-alt);z-index:2}.pinned-col{position:sticky;left:0;background:var(--surface);z-index:1}"
    ], "\n");

    let js = str_join([
        "document.addEventListener('keydown', function(ev) {",
        "  if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'k') {",
        "    const pal = document.querySelector('[data-component=\"CommandPalette\"]');",
        "    if (pal) { ev.preventDefault(); pal.focus(); }",
        "  }",
        "  if (ev.key === 'Escape') {",
        "    const dlg = document.querySelector('[aria-modal=\"true\"]');",
        "    if (dlg) { dlg.setAttribute('data-dismissed', 'true'); }",
        "  }",
        "  if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') {",
        "    const act = document.activeElement;",
        "    if (act && act.getAttribute('role') === 'tab') {",
        "      const tabs = Array.from(act.parentElement.querySelectorAll('[role=\"tab\"]'));",
        "      const idx = tabs.indexOf(act);",
        "      if (idx >= 0) { const nx = tabs[(idx + (ev.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; nx.focus(); }",
        "    }",
        "  }",
        "});"
    ], "\n");

    return str_join([
        "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"" + html_escape(theme.name) + "\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n<title>" + doc_title + "</title>\n<style>\n" + css + "\n</style>\n</head>\n<body>\n",
        body_html,
        "\n<script>\n" + js + "\n</script>\n</body>\n</html>\n"
    ], "");
}

// Native Desktop (`gfx*`) HiDPI Draw Command Compiler & Runner
fn _emit_desktop_node(nd, theme, cmds, gfx_rects) {
    let box = nd.layout;
    let x = box.x;
    let y = box.y;
    let w = box.w;
    let h = box.h;
    if w <= 0 or h <= 0 { return; }

    let k = nd.kind;
    let p = nd.props;
    let rgb = theme.rgb;

    let fill_col = rgb.surface;
    let fg_col = rgb.text_primary;
    if k == "AppShell" {
        fill_col = rgb.bg;
    } elif k == "Button" or k == "IconButton" or k == "SplitButton" {
        fill_col = rgb.btn_primary_bg;
        fg_col = rgb.btn_primary_fg;
    } elif k == "Input" or k == "PasswordInput" or k == "NumericUnitInput" or k == "Select" {
        fill_col = rgb.surface_alt;
    }

    array_push(cmds, map{ op: "clip", x: x, y: y, w: w, h: h });
    array_push(cmds, map{
        op: "rounded_rect",
        id: nd.id,
        kind: k,
        x: x, y: y, w: w, h: h,
        radius: theme.radius_px,
        color: fill_col,
        border_color: rgb.border
    });
    array_push(gfx_rects, map{ x: x, y: y, w: w, h: h, color: fill_col });

    // Border top/bottom subtle hairlines
    array_push(cmds, map{ op: "line", x1: x, y1: y, x2: x + w, y2: y, color: rgb.border });

    if k == "VirtualDataGrid" {
        // Emit header + visible materialized rows ONLY (O(visible_rows)!)
        let hdr_h = 28;
        array_push(gfx_rects, map{ x: x, y: y, w: w, h: hdr_h, color: rgb.surface_alt });
        array_push(cmds, map{
            op: "text",
            x: x + 8, y: y + 6,
            text: nd.aria_label + " [" + str(p.start_row) + ".." + str(p.end_row) + " / " + str(p.total_rows) + "]",
            color: rgb.text_secondary,
            px: 13
        });
        let rows = p.visible_rows;
        let cols = p.columns;
        let col_w = max(60, floor(w / max(1, len(cols))));
        let ri = 0;
        while ri < len(rows) {
            let ry = y + hdr_h + ri * p.row_height;
            if ry + p.row_height > y + h { break; }
            if (ri % 2) == 1 {
                array_push(gfx_rects, map{ x: x + 1, y: ry, w: max(1, w - 2), h: p.row_height, color: rgb.surface_alt });
            }
            let ci = 0;
            while ci < len(cols) {
                let cell_s = str(_get(rows[ri], cols[ci].field, ""));
                array_push(cmds, map{
                    op: "text",
                    x: x + 8 + ci * col_w,
                    y: ry + 6,
                    text: cell_s,
                    color: rgb.text_primary,
                    px: 12
                });
                ci = ci + 1;
            }
            ri = ri + 1;
        }
    } else {
        let cap = str(_get(p, "text", _get(p, "title", nd.aria_label)));
        array_push(cmds, map{
            op: "text",
            x: x + 10,
            y: y + 8,
            text: cap,
            color: fg_col,
            px: 14
        });
    }

    let ki = 0;
    while ki < len(nd.children) {
        _emit_desktop_node(nd.children[ki], theme, cmds, gfx_rects);
        ki = ki + 1;
    }
}

fn render_to_desktop_commands(app_tree, theme = nil, width = 1280, height = 800, dpi_scale = 1.0) {
    if theme == nil { theme = THEMES.dark_obsidian; }
    compute_flex_dock_layout(app_tree, width, height, dpi_scale);
    let cmds = [];
    let gfx_rects = [];
    _emit_desktop_node(app_tree, theme, cmds, gfx_rects);
    return map{
        ok: true,
        viewport_w: round(width * dpi_scale),
        viewport_h: round(height * dpi_scale),
        dpi_scale: dpi_scale,
        command_count: len(cmds),
        rect_batch_count: len(gfx_rects),
        commands: cmds,
        gfx_rects: gfx_rects
    };
}

fn run_desktop_window(app_tree, theme = nil, opts = nil) {
    opts = _opts(opts);
    if theme == nil { theme = THEMES.dark_obsidian; }
    let w = _get(opts, "width", 1280);
    let h = _get(opts, "height", 800);
    let dpi = _get(opts, "dpi_scale", 1.0);
    let frame_plan = render_to_desktop_commands(app_tree, theme, w, h, dpi);

    if _get(opts, "headless", true) {
        return map{
            ok: true,
            mode: "headless_command_buffer",
            command_count: frame_plan.command_count,
            rect_batch_count: frame_plan.rect_batch_count,
            frame_plan: frame_plan
        };
    }

    let win = nil;
    try {
        win = gfxcreatewindow(w, h, _get(opts, "title", "PBLang Enterprise UI Window"));
    } catch _e {
        return map{
            ok: true,
            mode: "fallback_headless_no_display",
            command_count: frame_plan.command_count,
            frame_plan: frame_plan
        };
    }

    let max_frames = _get(opts, "max_frames", 2);
    let f = 0;
    while f < max_frames and gfxisopen(win) {
        gfxclear(win, theme.rgb.bg);
        gfxdrawrects(win, frame_plan.gfx_rects, theme.rgb.surface);
        let ci = 0;
        while ci < len(frame_plan.commands) {
            let cmd = frame_plan.commands[ci];
            if cmd.op == "line" {
                gfxdrawline(win, cmd.x1, cmd.y1, cmd.x2, cmd.y2, cmd.color);
            } elif cmd.op == "text" {
                try {
                    gfxdrawtextaa(win, cmd.x, cmd.y, cmd.text, cmd.color, cmd.px, "", 0);
                } catch _te {}
            }
            ci = ci + 1;
        }
        gfxpresent(win);
        let _evs = gfxpollevents(win);
        f = f + 1;
    }
    try { gfxclose(win); } catch _ce {}
    return map{
        ok: true,
        mode: "native_gfx_window",
        frames_rendered: f,
        command_count: frame_plan.command_count
    };
}

// ============================================================================
// 5. WAI-ARIA 1.2 & WCAG 2.1 Accessibility Tree Auditor (`audit_accessibility_wcag`)
// ============================================================================

fn _audit_walk(nd, theme, stats) {
    stats.total_nodes = stats.total_nodes + 1;
    let p = nd.props;

    // 1. Valid ARIA role check
    if str_trim(str(nd.role)) == "" {
        array_push(stats.violations, map{
            node_id: nd.id,
            kind: nd.kind,
            rule: "aria-role-required",
            detail: "Missing WAI-ARIA 1.2 role"
        });
    }

    // 2. Interactive accessibility label & keyboard focusability
    if nd.interactive {
        stats.interactive_nodes = stats.interactive_nodes + 1;
        if str_trim(str(nd.aria_label)) == "" {
            array_push(stats.violations, map{
                node_id: nd.id,
                kind: nd.kind,
                rule: "accessible-name-required",
                detail: "Interactive widget lacks accessible aria_label"
            });
        }
        if not nd.disabled and nd.tabindex < 0 {
            array_push(stats.violations, map{
                node_id: nd.id,
                kind: nd.kind,
                rule: "keyboard-focusable-required",
                detail: "Interactive enabled widget has negative tabindex"
            });
        }
    }

    // 3. DataGrid / TreeGrid WAI-ARIA row/col counts
    if nd.kind == "VirtualDataGrid" or nd.kind == "TreeGrid" {
        let rc = _get(p, "aria_rowcount", _get(p, "total_rows", -1));
        let cc = _get(p, "aria_colcount", -1);
        if rc < 0 or cc <= 0 {
            array_push(stats.violations, map{
                node_id: nd.id,
                kind: nd.kind,
                rule: "aria-grid-dimensions",
                detail: "Grid requires explicit aria_rowcount and aria_colcount"
            });
        }
    }

    // 4. Foreground / Background WCAG 2.1 Contrast Verification
    let fg_hex = _get(p, "fg_hex", "");
    let bg_hex = _get(p, "bg_hex", "");
    if fg_hex == "" or bg_hex == "" {
        if nd.kind == "Button" or nd.kind == "IconButton" or nd.kind == "SplitButton" {
            fg_hex = theme.colors.btn_primary_fg;
            bg_hex = theme.colors.btn_primary_bg;
        } else {
            fg_hex = theme.colors.text_primary;
            bg_hex = theme.colors.surface;
        }
    }
    let cr = contrast_ratio_hex(fg_hex, bg_hex);
    if cr < stats.min_contrast {
        stats.min_contrast = cr;
    }
    if cr < 4.5 {
        array_push(stats.violations, map{
            node_id: nd.id,
            kind: nd.kind,
            rule: "wcag-contrast-aa",
            detail: "Contrast ratio " + str(round(cr * 100.0) / 100.0) + ":1 is below 4.5:1 AA minimum"
        });
    }

    let i = 0;
    while i < len(nd.children) {
        _audit_walk(nd.children[i], theme, stats);
        i = i + 1;
    }
}

fn audit_accessibility_wcag(app_tree, theme = nil) {
    if theme == nil { theme = THEMES.dark_obsidian; }
    let stats = map{
        total_nodes: 0,
        interactive_nodes: 0,
        min_contrast: 21.0,
        violations: []
    };
    _audit_walk(app_tree, theme, stats);

    // Also incorporate theme secondary/muted text token guarantees
    let theme_min = min(stats.min_contrast, theme.min_contrast);
    let v_count = len(stats.violations);
    let lvl = "FAIL";
    if v_count == 0 and theme_min >= 7.0 { lvl = "AAA"; }
    elif v_count == 0 and theme_min >= 4.5 { lvl = "AA"; }

    let score = 100.0;
    if stats.total_nodes > 0 and v_count > 0 {
        score = max(0.0, 100.0 - (v_count * 100.0 / stats.total_nodes));
    }

    return map{
        ok: v_count == 0,
        wcag_level: lvl,
        total_nodes: stats.total_nodes,
        interactive_nodes: stats.interactive_nodes,
        min_contrast_ratio: round(theme_min * 100.0) / 100.0,
        violations: stats.violations,
        score_pct: round(score * 100.0) / 100.0
    };
}

export UI_FRAMEWORK_VERSION, THEMES, COMPONENT_CATALOG,
       html_escape, hex_to_rgb, rgb_to_hex,
       relative_luminance_rgb, contrast_ratio_rgb, contrast_ratio_hex, create_theme,
       spring_animate, cubic_bezier_eval, compute_flex_dock_layout,
       ui_node, create_virtual_datagrid, export_datagrid_csv,
       ui_app_shell, ui_flex, ui_button, ui_kpi_card, list_registered_components,
       render_to_web_html, render_to_desktop_commands, run_desktop_window,
       audit_accessibility_wcag;
