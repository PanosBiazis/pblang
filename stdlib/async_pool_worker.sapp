// Internal pool boundary. The public async facade validates/clamps size before
// calling. No imports here: each spawn snapshots this module's globals.
fn run_pool(size, items, mapper, call_tasks) {
    let n = len(items);
    let work = channel_buffered(n);
    let results = channel_buffered(n);
    for i n { send(work.sender, i); }
    channel_close(work.sender);
    let workers = [];
    let started = true;
    for w size {
        let worker = try spawn(fn() {
            while true {
                let idx = recv(work.receiver);
                if idx == nil { return nil; }
                // Keep task failure-as-nil compatibility; infrastructure failure
                // is checked separately by the owning parent.
                let value = nil;
                if call_tasks { value = try items[idx]() catch nil; }
                else { value = try mapper(items[idx]) catch nil; }
                send(results.sender, map{idx: idx, value: value});
            }
        }) catch nil;
        if worker == nil { started = false; break; }
        array_push(workers, worker);
    }
    // Exactly n messages fit, so joining cannot deadlock on our result queue.
    // On partial launch failure, existing workers finish the queued jobs before
    // the error escapes. This is ownership cleanup, not task cancellation.
    let joined = true;
    for worker in workers {
        let done = try { join(worker); true } catch false;
        if not done { joined = false; }
    }
    channel_close(results.sender);
    if not started or not joined {
        // The retained host keeps channel registry entries after close. Drain
        // abandoned values only after all owned workers have been joined.
        while recv_timeout(work.receiver, 0) != nil {}
        while recv_timeout(results.receiver, 0) != nil {}
        if not started { throw "async.pool: worker could not start"; }
        throw "async.pool: worker failed";
    }
    let out = [];
    for i n { out[i] = nil; }
    for i n {
        let result = recv_timeout(results.receiver, 0);
        if result == nil { throw "async.pool: missing worker result"; }
        out[result.idx] = result.value;
    }
    return out;
}
export run_pool;
