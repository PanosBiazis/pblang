// Trusted caller-selected file inspection. Not an authorization or sandbox boundary.
let Secure=import("stdlib:secure_file.sapp");
let Inspect=import("stdlib:devops_inspection.sapp");

fn _token(value) {
    if type(value)!="string" or len(value)<1 or len(value)>4096
        or len(str_to_bytes(value))>4096 { return false; }
    for char in str_split(value,"") {
        let cp=strcharcodeat(char,0);
        if cp<=31 or (cp>=127 and cp<=159) or cp==1564 or cp==8206 or cp==8207
            or (cp>=8232 and cp<=8238) or (cp>=8294 and cp<=8303) or cp==65279 {
            return false;
        }
    }
    return true;
}
fn _path(value) {
    if not _token(value) or str_ends_with(value,"/") or str_ends_with(value,"\\") { return false; }
    let base=try path_basename(value) catch "";
    return base!="" and base!="." and base!="..";
}
// Exact retained-runtime invocation; no environment or alternative flag channel.
fn parse_argv(argv) {
    let bad=map{ok:false,path:nil};
    if type(argv)!="array" or len(argv)!=5 { return bad; }
    for token in argv { if not _token(token) { return bad; } }
    if argv[0]!="run" or (argv[1]!="tools/pbopscheck.sapp"
        and not str_ends_with(argv[1],"/tools/pbopscheck.sapp"))
        or argv[2]!="--allow-all" or argv[3]!="--" or not _path(argv[4]) { return bad; }
    return map{ok:true,path:argv[4]};
}
fn _copy_targets(targets) {
    if type(targets)!="array" or len(targets)<1 or len(targets)>32 { return nil; }
    let copy=[]; let seen=map{};
    for target in targets {
        if type(target)!="string" or len(target)<1 or len(target)>48 { return nil; }
        for char in str_split(target,"") {
            if not str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",char) { return nil; }
        }
        if map_has(seen,target) { return nil; }
        seen[target]=true; array_push(copy,target);
    }
    return copy;
}
// Separate command identity preserves the original full-check grammar.
fn parse_target_argv(argv) {
    let bad=map{ok:false,path:nil,targets:nil};
    if type(argv)!="array" or len(argv)<6 or len(argv)>37 { return bad; }
    for token in argv { if not _token(token) { return bad; } }
    if argv[0]!="run" or (argv[1]!="tools/pbopstargetcheck.sapp"
        and not str_ends_with(argv[1],"/tools/pbopstargetcheck.sapp"))
        or argv[2]!="--allow-all" or argv[3]!="--" or not _path(argv[4]) { return bad; }
    let targets=[];
    for index in range(5,len(argv)) { array_push(targets,argv[index]); }
    let copy=_copy_targets(targets);
    if copy==nil { return bad; }
    return map{ok:true,path:argv[4],targets:copy};
}
fn _keys(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } }
    return true;
}
fn _integer(value,lo,hi) {
    return type(value)=="number" and value==num_floor(value) and value>=lo and value<=hi;
}
fn _loaded_valid(value) {
    return _keys(value,["ok","text","size"]) and type(value.ok)=="bool" and value.ok==true
        and type(value.text)=="string" and len(value.text)<=65536
        and _integer(value.size,0,65536) and len(str_to_bytes(value.text))==value.size;
}
fn _masked_report(value) {
    if not _keys(value,["format","ok","error","job_count","dependency_count","stage_count",
        "max_stage_width","stages","contains_job_ids","execution_performed","production_ready"])
        or value.format!="pblang.devops-inspection.v1" or type(value.ok)!="bool"
        or type(value.contains_job_ids)!="bool" or value.contains_job_ids!=false
        or type(value.execution_performed)!="bool" or value.execution_performed!=false
        or type(value.production_ready)!="bool" or value.production_ready!=false
        or not _integer(value.job_count,0,32) or not _integer(value.dependency_count,0,512)
        or not _integer(value.stage_count,0,32) or not _integer(value.max_stage_width,0,32)
        or type(value.stages)!="array" or len(value.stages)!=value.stage_count { return false; }
    let total=0; let width=0; let index=0;
    for row in value.stages {
        if not _keys(row,["index","job_count","job_ids"]) or not _integer(row.index,0,31)
            or row.index!=index or not _integer(row.job_count,1,32)
            or type(row.job_ids)!="array" or len(row.job_ids)!=0 { return false; }
        total=total+row.job_count; width=num_max(width,row.job_count); index=index+1;
    }
    if total!=value.job_count or width!=value.max_stage_width { return false; }
    if value.ok { return value.error==nil and total>0; }
    let known=false;
    for code in ["invalid-options","invalid-source","input-limit","invalid-json",
        "invalid-document","invalid-pipeline","inspection-failed"] {
        if value.error==code { known=true; }
    }
    return known and total==0 and value.stage_count==0 and value.dependency_count==0;
}
fn _masked_target_report(value,target_count) {
    if not _keys(value,["format","ok","selection_mode","total_job_count","selected_job_count",
        "target_count","all_jobs_selected","report","execution_performed","production_ready"])
        or value.format!="pblang.devops-target-inspection.v1" or value.selection_mode!="target-closure"
        or type(value.ok)!="bool" or type(value.all_jobs_selected)!="bool"
        or type(value.execution_performed)!="bool" or value.execution_performed!=false
        or type(value.production_ready)!="bool" or value.production_ready!=false
        or not _integer(value.total_job_count,0,32) or not _integer(value.selected_job_count,0,32)
        or not _integer(value.target_count,0,32) or not _masked_report(value.report)
        or value.ok!=value.report.ok or value.selected_job_count!=value.report.job_count { return false; }
    if value.ok {
        return value.target_count==target_count and value.target_count>=1
            and value.target_count<=value.selected_job_count and value.selected_job_count<=value.total_job_count
            and value.all_jobs_selected==(value.selected_job_count==value.total_job_count);
    }
    return value.total_job_count==0 and value.selected_job_count==0 and value.target_count==0
        and value.all_jobs_selected==false;
}
fn _result(status,report=nil,targeted=false) {
    let exit_code=2;
    if status=="accepted" { exit_code=0; }
    elif status=="rejected" { exit_code=1; }
    return map{format:if targeted {"pblang.devops-target-file-check.v1"} else {"pblang.devops-file-check.v1"},
        ok:status=="accepted",status:status,
        exit_code:exit_code,read_attempted:status!="invalid_arguments",
        file_read_claimed:report!=nil,report:report,path_scope_confined:false,
        contains_path:false,contains_source:false,execution_performed:false,
        production_ready:false,hard_heap_enforced:false,hard_timeout_enforced:false};
}
fn _check(path,targets=nil,targeted=false) {
    // One production read, no injected reader, prefix, fallback or retry.
    let loaded=try Secure.read_text(path,65536,false) catch nil;
    if not _loaded_valid(loaded) { return _result("unavailable",nil,targeted); }
    let report=nil; let valid=false;
    if targeted {
        report=try Inspect.inspect_targets(loaded.text,targets,false) catch nil;
        valid=_masked_target_report(report,len(targets));
    } else {
        report=try Inspect.inspect_text(loaded.text,false) catch nil;
        valid=_masked_report(report);
    }
    if not valid { return _result("unavailable",nil,targeted); }
    return _result(if report.ok {"accepted"} else {"rejected"},report,targeted);
}
// This call itself authorizes a read under the host's existing filesystem authority.
// Do not expose it to untrusted UI, web, Android or MCP requests without a broker.
fn check_file(path) {
    if not (try _path(path) catch false) { return _result("invalid_arguments"); }
    return try _check(path) catch _result("unavailable");
}
fn check_file_targets(path,targets) {
    if not (try _path(path) catch false) { return _result("invalid_arguments",nil,true); }
    let copy=try _copy_targets(targets) catch nil;
    if copy==nil { return _result("invalid_arguments",nil,true); }
    return try _check(path,copy,true) catch _result("unavailable",nil,true);
}
export parse_argv,check_file,parse_target_argv,check_file_targets;
