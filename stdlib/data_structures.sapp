//! data_structures.sapp — Advanced data structures for pblang.
//!
//! Stacks, queues, priority queues, linked lists, tries, LRU caches, union-find,
//! plus sets and counters. All mutating ops change the structure in place
//! (arrays/maps are reference types); pop/dequeue/extract actually shrink the
//! structure (a long-standing bug where they discarded a rebuilt local).

// ── Stack (LIFO) ────────────────────────────────────────────────────────────────
fn stack_new() { return []; }
fn stack_push(s, v) { array_push(s, v); }
fn stack_pop(s) { if len(s) == 0 { return nil; } return array_pop(s); }
fn stack_peek(s) { if len(s) == 0 { return nil; } return s[len(s) - 1]; }
fn stack_is_empty(s) { return len(s) == 0; }
fn stack_size(s) { return len(s); }

// ── Queue (FIFO) ────────────────────────────────────────────────────────────────
fn queue_new() { return []; }
fn queue_enqueue(q, v) { array_push(q, v); }
fn queue_dequeue(q) {
    if len(q) == 0 { return nil; }
    let v = q[0];
    let i = 0;
    while i < len(q) - 1 { q[i] = q[i + 1]; i = i + 1; }   // shift left, in place
    array_pop(q);                                          // drop the now-duplicate tail
    return v;
}
fn queue_front(q) { if len(q) == 0 { return nil; } return q[0]; }
fn queue_is_empty(q) { return len(q) == 0; }
fn queue_size(q) { return len(q); }
fn queue_clear(q) { while len(q) > 0 { array_pop(q); } }

// ── Min priority queue (binary heap) ────────────────────────────────────────────
fn pq_new() { return []; }
fn pq_insert(pq, val, prio) {
    array_push(pq, map{ val: val, prio: prio });
    let i = len(pq) - 1;
    while i > 0 {
        let p = num_floor((i - 1) / 2);
        if pq[i]["prio"] < pq[p]["prio"] {
            let tmp = pq[i]; pq[i] = pq[p]; pq[p] = tmp; i = p;
        } else { break; }
    }
}
fn pq_extract_min(pq) {
    if len(pq) == 0 { return nil; }
    let min = pq[0];
    let last = array_pop(pq);          // shrink first
    if len(pq) > 0 {
        pq[0] = last;                  // move old tail to the root, then sift down
        let j = 0;
        while true {
            let l = 2 * j + 1;
            let r = 2 * j + 2;
            let sm = j;
            if l < len(pq) and pq[l]["prio"] < pq[sm]["prio"] { sm = l; }
            if r < len(pq) and pq[r]["prio"] < pq[sm]["prio"] { sm = r; }
            if sm != j { let tmp = pq[j]; pq[j] = pq[sm]; pq[sm] = tmp; j = sm; }
            else { break; }
        }
    }
    return min;
}
fn pq_peek(pq) { if len(pq) == 0 { return nil; } return pq[0]; }
fn pq_size(pq) { return len(pq); }
fn pq_is_empty(pq) { return len(pq) == 0; }

// ── Singly linked list ──────────────────────────────────────────────────────────
fn ll_new() { return map{ head: nil, tail: nil, size: 0 }; }
fn ll_append(ll, v) {
    let n = map{ val: v, next: nil };
    if ll["head"] == nil { ll["head"] = n; ll["tail"] = n; }
    else { ll["tail"]["next"] = n; ll["tail"] = n; }
    ll["size"] = ll["size"] + 1;
}
fn ll_prepend(ll, v) {
    let n = map{ val: v, next: ll["head"] };
    ll["head"] = n;
    if ll["tail"] == nil { ll["tail"] = n; }
    ll["size"] = ll["size"] + 1;
}
fn ll_to_array(ll) { let a = []; let c = ll["head"]; while c != nil { array_push(a, c["val"]); c = c["next"]; } return a; }
fn ll_find(ll, v) { let c = ll["head"]; while c != nil { if c["val"] == v { return true; } c = c["next"]; } return false; }
fn ll_size(ll) { return ll["size"]; }

// ── Trie (prefix tree) ──────────────────────────────────────────────────────────
fn trie_new() { return map{ children: map{}, is_end: false }; }
fn trie_insert(t, w) {
    let n = t;
    let i = 0;
    while i < len(w) {
        let ch = w[i..(i + 1)];
        if not map_has(n["children"], ch) { n["children"][ch] = trie_new(); }
        n = n["children"][ch];
        i = i + 1;
    }
    n["is_end"] = true;
}
fn trie_search(t, w) {
    let n = t;
    let i = 0;
    while i < len(w) {
        let ch = w[i..(i + 1)];
        if not map_has(n["children"], ch) { return false; }
        n = n["children"][ch];
        i = i + 1;
    }
    return n["is_end"];
}
fn trie_starts_with(t, p) {
    let n = t;
    let i = 0;
    while i < len(p) {
        let ch = p[i..(i + 1)];
        if not map_has(n["children"], ch) { return false; }
        n = n["children"][ch];
        i = i + 1;
    }
    return true;
}

// ── LRU cache (hash map + doubly-linked keys, O(1) get/put/evict) ───────────────
fn lru_new(cap) {
    let capacity = num_floor(cap);
    if capacity < 0 { capacity = 0; }
    return map{ cap: capacity, items: map{}, nodes: map{}, head: nil, tail: nil, count: 0 };
}
fn lru_has(c, k) { return map_has(c["items"], k); }
fn lru_size(c) { return c["count"]; }
fn _lru_detach(c, k) {
    let node = c["nodes"][k];
    let prev = node["prev"];
    let next = node["next"];
    if prev == nil { c["head"] = next; } else { c["nodes"][prev]["next"] = next; }
    if next == nil { c["tail"] = prev; } else { c["nodes"][next]["prev"] = prev; }
}
fn _lru_append(c, k) {
    c["nodes"][k] = map{ prev: c["tail"], next: nil };
    if c["tail"] == nil { c["head"] = k; }
    else { c["nodes"][c["tail"]]["next"] = k; }
    c["tail"] = k;
}
fn _lru_touch(c, k) {
    if c["tail"] == k { return; }
    _lru_detach(c, k);
    _lru_append(c, k);
}
fn lru_get(c, k) {
    if not map_has(c["items"], k) { return nil; }
    _lru_touch(c, k);
    return c["items"][k];
}
fn lru_put(c, k, v) {
    if map_has(c["items"], k) { c["items"][k] = v; _lru_touch(c, k); return; }
    if c["cap"] <= 0 { return; }
    if c["count"] >= c["cap"] {
        let evict = c["head"];
        _lru_detach(c, evict);
        map_remove(c["items"], evict);
        map_remove(c["nodes"], evict);
        c["count"] = c["count"] - 1;
    }
    c["items"][k] = v;
    _lru_append(c, k);
    c["count"] = c["count"] + 1;
}
fn lru_remove(c, k) {
    if not map_has(c["items"], k) { return false; }
    _lru_detach(c, k);
    map_remove(c["items"], k);
    map_remove(c["nodes"], k);
    c["count"] = c["count"] - 1;
    return true;
}
fn lru_clear(c) {
    c["items"] = map{}; c["nodes"] = map{};
    c["head"] = nil; c["tail"] = nil; c["count"] = 0;
    return c;
}

// ── Union-Find (disjoint set) ───────────────────────────────────────────────────
fn ds_new(n) {
    let p = []; let r = []; let i = 0;
    while i < n { array_push(p, i); array_push(r, 0); i = i + 1; }
    return map{ parent: p, rank: r };
}
fn ds_find(ds, x) {
    if ds["parent"][x] != x { ds["parent"][x] = ds_find(ds, ds["parent"][x]); }
    return ds["parent"][x];
}
fn ds_union(ds, x, y) {
    let rx = ds_find(ds, x);
    let ry = ds_find(ds, y);
    if rx == ry { return; }
    if ds["rank"][rx] < ds["rank"][ry] { ds["parent"][rx] = ry; }
    else {
        if ds["rank"][rx] > ds["rank"][ry] { ds["parent"][ry] = rx; }
        else { ds["parent"][ry] = rx; ds["rank"][rx] = ds["rank"][rx] + 1; }
    }
}

// ── Set (hash set; keys stringified) ────────────────────────────────────────────
fn set_new() { return map{}; }
fn set_add(s, v) { s[str(v)] = true; }
fn set_has(s, v) { return map_has(s, str(v)); }
fn set_remove(s, v) { if map_has(s, str(v)) { map_remove(s, str(v)); } }
fn set_size(s) { return len(map_keys(s)); }
fn set_values(s) { return map_keys(s); }

// ── Counter (multiset) ──────────────────────────────────────────────────────────
fn counter_new() { return map{}; }
fn counter_add(c, v) {
    let k = str(v);
    let cur = 0;
    if map_has(c, k) { cur = c[k]; }
    c[k] = cur + 1;
}
fn counter_get(c, v) { let k = str(v); if map_has(c, k) { return c[k]; } return 0; }

export stack_new; export stack_push; export stack_pop; export stack_peek; export stack_is_empty; export stack_size;
export queue_new; export queue_enqueue; export queue_dequeue; export queue_front; export queue_is_empty; export queue_size; export queue_clear;
export pq_new; export pq_insert; export pq_extract_min; export pq_peek; export pq_size; export pq_is_empty;
export ll_new; export ll_append; export ll_prepend; export ll_to_array; export ll_find; export ll_size;
export trie_new; export trie_insert; export trie_search; export trie_starts_with;
export lru_new; export lru_has; export lru_get; export lru_put; export lru_size; export lru_remove; export lru_clear;
export ds_new; export ds_find; export ds_union;
export set_new; export set_add; export set_has; export set_remove; export set_size; export set_values;
export counter_new; export counter_add; export counter_get;
