//! data_structures.sapp — Advanced data structures for pblang

fn stack_new() { return []; }
fn stack_push(s, v) { array_push(s, v); }
fn stack_pop(s) { if len(s)==0{return nil;} let v=s[len(s)-1]; let ns=[]; let i=0; while i<len(s)-1{array_push(ns,s[i]);i=i+1;} return v; }
fn stack_peek(s) { if len(s)==0{return nil;} return s[len(s)-1]; }
fn stack_is_empty(s) { return len(s)==0; }
fn stack_size(s) { return len(s); }

fn queue_new() { return []; }
fn queue_enqueue(q, v) { array_push(q, v); }
fn queue_dequeue(q) { if len(q)==0{return nil;} let v=q[0]; let ns=[]; let i=1; while i<len(q){array_push(ns,q[i]);i=i+1;} return v; }
fn queue_front(q) { if len(q)==0{return nil;} return q[0]; }
fn queue_is_empty(q) { return len(q)==0; }
fn queue_size(q) { return len(q); }

fn pq_new() { return []; }
fn pq_insert(pq, val, prio) { array_push(pq, map{val:val,prio:prio}); let i=len(pq)-1; while i>0 { let p=(i-1)/2; if pq[i]["prio"]<pq[p]["prio"]{let tmp=pq[i];pq[i]=pq[p];pq[p]=tmp;i=p;}else{break;} } }
fn pq_extract_min(pq) { if len(pq)==0{return nil;} let min=pq[0]; if len(pq)==1{pq=[];return min;} pq[0]=pq[len(pq)-1]; let ns=[]; let i=0; while i<len(pq)-1{array_push(ns,pq[i]);i=i+1;} pq=ns; let j=0; while true{let l=2*j+1;let r=2*j+2;let s=j; if l<len(pq)and pq[l]["prio"]<pq[s]["prio"]{s=l;} if r<len(pq)and pq[r]["prio"]<pq[s]["prio"]{s=r;} if s!=j{let tmp=pq[j];pq[j]=pq[s];pq[s]=tmp;j=s;}else{break;}} return min; }
fn pq_is_empty(pq) { return len(pq)==0; }

fn ll_new() { return map{head:nil, tail:nil, size:0}; }
fn ll_append(ll, v) { let n=map{val:v, next:nil}; if ll["head"]==nil{ll["head"]=n;ll["tail"]=n;}else{ll["tail"]["next"]=n;ll["tail"]=n;} ll["size"]=ll["size"]+1; }
fn ll_prepend(ll, v) { let n=map{val:v, next:ll["head"]}; ll["head"]=n; if ll["tail"]==nil{ll["tail"]=n;} ll["size"]=ll["size"]+1; }
fn ll_to_array(ll) { let a=[]; let c=ll["head"]; while c!=nil{array_push(a,c["val"]);c=c["next"];} return a; }
fn ll_find(ll, v) { let c=ll["head"]; while c!=nil{if c["val"]==v{return true;}c=c["next"];} return false; }
fn ll_size(ll) { return ll["size"]; }

fn trie_new() { return map{children:{}, is_end:false}; }
fn trie_insert(t, w) { let n=t; let i=0; while i<len(w) { let ch=w[i..(i+1)]; if n["children"][ch]==nil{n["children"][ch]=trie_new();} n=n["children"][ch]; i=i+1; } n["is_end"]=true; }
fn trie_search(t, w) { let n=t; let i=0; while i<len(w) { let ch=w[i..(i+1)]; if n["children"][ch]==nil{return false;} n=n["children"][ch]; i=i+1; } return n["is_end"]; }
fn trie_starts_with(t, p) { let n=t; let i=0; while i<len(p) { let ch=p[i..(i+1)]; if n["children"][ch]==nil{return false;} n=n["children"][ch]; i=i+1; } return true; }

fn lru_new(cap) { return map{cap:cap, items:{}, order:[]}; }
fn lru_get(c, k) { if c["items"][k]==nil{return nil;} let no=[]; let i=0; while i<len(c["order"]){if c["order"][i]!=k{array_push(no,c["order"][i]);}i=i+1;} array_push(no,k);c["order"]=no;return c["items"][k]; }
fn lru_put(c, k, v) { if c["items"][k]!=nil{c["items"][k]=v; let _=lru_get(c,k); return;} if len(c["order"])>=c["cap"]{ c["items"][c["order"][0]]=nil; let no=[]; let i=1; while i<len(c["order"]){array_push(no,c["order"][i]);i=i+1;}c["order"]=no;}c["items"][k]=v;array_push(c["order"],k); }

fn ds_new(n) { let p=[]; let r=[]; let i=0; while i<n{array_push(p,i);array_push(r,0);i=i+1;} return map{parent:p, rank:r}; }
fn ds_find(ds, x) { if ds["parent"][x]!=x{ds["parent"][x]=ds_find(ds,ds["parent"][x]);} return ds["parent"][x]; }
fn ds_union(ds, x, y) { let rx=ds_find(ds,x); let ry=ds_find(ds,y); if rx==ry{return;} if ds["rank"][rx]<ds["rank"][ry]{ds["parent"][rx]=ry;}else{if ds["rank"][rx]>ds["rank"][ry]{ds["parent"][ry]=rx;}else{ds["parent"][ry]=rx;ds["rank"][rx]=ds["rank"][rx]+1;}} }

export stack_new; export stack_push; export stack_pop; export stack_peek; export stack_is_empty; export stack_size;
export queue_new; export queue_enqueue; export queue_dequeue; export queue_front; export queue_is_empty; export queue_size;
export pq_new; export pq_insert; export pq_extract_min; export pq_is_empty;
export ll_new; export ll_append; export ll_prepend; export ll_to_array; export ll_find; export ll_size;
export trie_new; export trie_insert; export trie_search; export trie_starts_with;
export lru_new; export lru_get; export lru_put;
export ds_new; export ds_find; export ds_union;
